// stdlib/lsp_server.sapp — PBLang v3.0.0 JSON-RPC 2.0 Language Server Protocol (LSP 3.17)
//
// Features:
//   - Byte-accurate LSP 3.17 framing (`Content-Length: <N>\r\n\r\n<json>` using UTF-8 byte count)
//   - Real-time 4-pass diagnostics (`textDocument/publishDiagnostics`) powered by `static_checker.sapp`:
//       * Undefined symbols with Levenshtein/idiom quick-fix suggestions
//       * Arity, `const` immutability, unreachable code, non-exhaustive `enum` `match`, strict types
//       * Zero-cost compile-time 9D SI & Currency dimensional checking (`num[m/s]`, `num[EUR]`)
//       * Mathematical contract verification (`requires`/`ensures` & division-by-zero) via Tarski CAD & Presburger
//   - Rich Markdown `textDocument/hover` cards (Type + 9D SI Dimension + CAD/Presburger Proof Status + Docstring)
//   - Context-aware `textDocument/completion` (SI/currency units, builtins, stdlib modules, scoped symbols)
//   - `textDocument/definition`, `textDocument/documentSymbol`, `textDocument/codeAction` (quick-fixes),
//     and `textDocument/formatting` (via `stdlib:compiler/formatter.sapp` + v3.0.0 token preservation).
//
// Compatible with PBLang 2.7.0 and 3.0.0 runtimes.

let SC = import("stdlib:static_checker.sapp");
let FMT = import("stdlib:compiler/formatter.sapp");
let BUILTINS_MOD = import("stdlib:compiler/builtins_list.sapp");

let LSP_SERVER_VERSION = "3.0.0";

// ── String & UTF-8 Framing Utilities ──────────────────────────────────────────

fn _lsp_char_at(s, idx) {
    if s == nil or idx < 0 or idx >= len(s) { return ""; }
    return str_slice(s, idx, idx + 1);
}

fn _lsp_is_ident_char(ch) {
    if ch == "" { return false; }
    if ch == "_" { return true; }
    let c = strcharcodeat(ch, 0);
    if (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) {
        return true;
    }
    return c >= 160;
}

fn _lsp_clone_map(m) {
    let out = map{};
    if m == nil { return out; }
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        out[k] = m[k];
        i = i + 1;
    }
    return out;
}

fn _lsp_uri_to_path(uri) {
    if uri == nil { return "<memory>"; }
    let s = str(uri);
    if str_starts_with(s, "file://") {
        return str_slice(s, 7, len(s));
    }
    return s;
}

// Polish v3.0.0 multi-char tokens (`->`, `=>`, `::`) and `num[...]` unit annotations
// after running `stdlib:compiler/formatter.sapp` (outside string literals & comments).
fn _polish_v3_line(line) {
    let n = len(line);
    let out = "";
    let i = 0;
    let in_str = false;
    let str_q = "";
    let in_unit_brk = 0;

    while i < n {
        let ch = _lsp_char_at(line, i);
        if in_str {
            out = out + ch;
            if ch == "\\" and i + 1 < n {
                out = out + _lsp_char_at(line, i + 1);
                i = i + 2;
            } else {
                if ch == str_q { in_str = false; }
                i = i + 1;
            }
        } else {
            if ch == "//" or (ch == "/" and _lsp_char_at(line, i + 1) == "/") {
                out = out + str_slice(line, i, n);
                return out;
            }
            if ch == "\"" or ch == "'" {
                in_str = true;
                str_q = ch;
                out = out + ch;
                i = i + 1;
            } elif str_slice(line, i, i + 3) == "- >" {
                out = out + "->";
                i = i + 3;
            } elif str_slice(line, i, i + 3) == "= >" {
                out = out + "=>";
                i = i + 3;
            } elif str_slice(line, i, i + 3) == ": :" {
                out = out + "::";
                i = i + 3;
            } elif (str_slice(line, i, i + 4) == "num[" or str_slice(line, i, i + 4) == "int[") {
                in_unit_brk = 1;
                out = out + str_slice(line, i, i + 4);
                i = i + 4;
            } elif in_unit_brk > 0 {
                if ch == "[" {
                    in_unit_brk = in_unit_brk + 1;
                    out = out + ch;
                } elif ch == "]" {
                    in_unit_brk = in_unit_brk - 1;
                    out = out + ch;
                } elif ch != " " {
                    out = out + ch;
                }
                i = i + 1;
            } else {
                out = out + ch;
                i = i + 1;
            }
        }
    }
    return out;
}

fn _format_v3_document(src, max_line_length = nil) {
    let base_fmt = FMT.format_source(src, max_line_length);
    let raw_lines = str_split(base_fmt, "\n");
    let out_lines = [];
    let i = 0;
    while i < len(raw_lines) {
        push(out_lines, _polish_v3_line(raw_lines[i]));
        i = i + 1;
    }
    return str_join(out_lines, "\n");
}

// Encode a JSON-RPC map as an exact LSP 3.17 frame (`Content-Length: <UTF-8 byte length>\r\n\r\n<body>`).
fn encode_lsp_frame(msg_map) {
    let body = json_stringify(msg_map);
    let byte_buf = str_to_bytes(body);
    let byte_len = len(byte_buf);
    return "Content-Length: " + str(byte_len) + "\r\n\r\n" + body;
}

fn _parse_nonneg_int(s) {
    let t = str_trim(s);
    if t == "" { return -1; }
    let v = 0;
    let i = 0;
    while i < len(t) {
        let c = strcharcodeat(_lsp_char_at(t, i), 0);
        if c < 48 or c > 57 { return -1; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

fn _find_header_sep_bytes(buf, start_off) {
    let n = len(buf);
    let i = start_off;
    while i + 3 < n {
        if buf[i] == 13 and buf[i + 1] == 10 and buf[i + 2] == 13 and buf[i + 3] == 10 {
            return map{ idx: i, sep_len: 4 };
        }
        if buf[i] == 10 and buf[i + 1] == 10 {
            return map{ idx: i, sep_len: 2 };
        }
        i = i + 1;
    }
    if i + 1 < n and buf[i] == 10 and buf[i + 1] == 10 {
        return map{ idx: i, sep_len: 2 };
    }
    return nil;
}

// Decode 0 or more complete LSP frames from a UTF-8 string or byte array.
// Returns `map{ messages: [...], remainder_str: "...", remainder_bytes: [...] }`.
fn decode_lsp_frames(raw_input) {
    let buf = if type(raw_input) == "array" { raw_input } else { str_to_bytes(str(raw_input)) };
    let total = len(buf);
    let pos = 0;
    let messages = [];

    while pos < total {
        let sep = _find_header_sep_bytes(buf, pos);
        if sep == nil { break; }
        let hdr_bytes = slice(buf, pos, sep["idx"]);
        let hdr_str = bytes_to_str(hdr_bytes);
        let hdr_lines = str_split(hdr_str, "\n");
        let content_len = -1;
        let hi = 0;
        while hi < len(hdr_lines) {
            let hl = str_trim(hdr_lines[hi]);
            let low = str_lower(hl);
            if str_starts_with(low, "content-length:") {
                content_len = _parse_nonneg_int(str_slice(hl, 15, len(hl)));
            }
            hi = hi + 1;
        }
        if content_len < 0 {
            // Malformed frame header; advance past separator to avoid infinite loop
            pos = sep["idx"] + sep["sep_len"];
        } else {
            let body_start = sep["idx"] + sep["sep_len"];
            let body_end = body_start + content_len;
            if body_end > total {
                // Incomplete body — wait for more bytes
                break;
            }
            let body_bytes = slice(buf, body_start, body_end);
            let body_str = bytes_to_str(body_bytes);
            let parsed = try json_parse(body_str) catch nil;
            if parsed != nil and type(parsed) == "map" {
                push(messages, parsed);
            }
            pos = body_end;
        }
    }

    let rem_b = slice(buf, pos, total);
    return map{
        messages: messages,
        remainder_bytes: rem_b,
        remainder_str: bytes_to_str(rem_b)
    };
}

