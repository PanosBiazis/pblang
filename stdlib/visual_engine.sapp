// stdlib/visual_engine.sapp — portable pblang visual/media scene engine.
//
// This is the high-level contract above graphics.sapp/browser.sapp/watch.sapp:
// it models scenes, draw nodes, images, audio, video, web page blocks, animation
// keys, and safe local/network asset references. Backends can render the compiled
// plan to the native IDE, a web canvas, a future GPU renderer, or a remote display.
//
// It is intentionally not a decoder or browser DOM engine. It is the safe graph
// layer that lets pblang describe and validate what should be shown/played.

let B = import("stdlib:browser.sapp");

fn _opts(opts) {
    if opts == nil { return map{}; }
    return opts;
}

fn _get(m, k, fallback) {
    if m == nil { return fallback; }
    return try m[k] catch fallback;
}

fn _clamp(v, lo, hi) {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn source_kind(src) {
    let s = str_trim(str(src));
    let lo = str_lower(s);
    if str_starts_with(lo, "http://") or str_starts_with(lo, "https://") { return "network"; }
    if str_starts_with(lo, "data:") { return "inline-data"; }
    if str_starts_with(lo, "file:") { return "blocked-file-url"; }
    if str_starts_with(lo, "javascript:") { return "blocked-script-url"; }
    if s == "" { return "empty"; }
    return "local";
}

fn validate_source(src, allow_private = false) {
    let kind = source_kind(src);
    if kind == "network" { return B.url_policy(src, allow_private); }
    if kind == "local" { return map{ ok: true, reason: "local path reference", source_kind: kind }; }
    if kind == "empty" { return map{ ok: false, reason: "empty source", source_kind: kind }; }
    return map{ ok: false, reason: "blocked source kind: " + kind, source_kind: kind };
}

fn capabilities() {
    return map{
        format: "pblang.visual_engine.v1",
        graph: true,
        native_graphics: true,
        web_scene: true,
        custom_components: true,
        imported_components: true,
        scanner_assets: true,
        nd_items: true,
        game_engine_scene: true,
        ecs: true,
        camera_light_material: true,
        physics_particles_terrain: true,
        ellipse_arc_nodes: true,
        backend_targets: ["native", "web-canvas", "opengl", "vulkan", "godot", "unity", "unreal", "remote-display"],
        images: "asset references + local pixel arrays; decoding delegated to img_load/watch/backends",
        audio: "asset references + timeline nodes; playback delegated to host backend",
        video: "asset references + timeline nodes; decode/playback delegated to host backend",
        network_policy: "http/https only; private/local hosts blocked unless allow_private=true",
        dom_css_js: "metadata/host-render component descriptors only; no script executes in pblang",
    };
}

fn scene(w = 800, h = 600, opts = nil) {
    opts = _opts(opts);
    return map{
        format: "pblang.visual.scene.v1",
        title: _get(opts, "title", "pblang visual scene"),
        viewport: map{ w: w, h: h, scale: _get(opts, "scale", 1) },
        bg: _get(opts, "bg", [12, 16, 24, 255]),
        assets: [],
        layers: [map{ id: "main", nodes: [] }],
        timeline: [],
        render: map{ backend: _get(opts, "backend", "native"), pipeline: _get(opts, "pipeline", "forward-2d3d"), quality: _get(opts, "quality", "balanced") },
        systems: [],
        safety: map{ allow_private: _get(opts, "allow_private", false) },
    };
}

fn asset(kind, src, opts = nil) {
    opts = _opts(opts);
    let allow_private = _get(opts, "allow_private", false);
    let pol = validate_source(src, allow_private);
    return map{
        format: "pblang.visual.asset.v1",
        kind: kind,
        src: src,
        source_kind: source_kind(src),
        ok: pol.ok,
        policy: pol,
        mime: _get(opts, "mime", ""),
        alt: _get(opts, "alt", ""),
        meta: _get(opts, "meta", map{}),
    };
}

fn _push_asset(sc, a) {
    let i = 0;
    while i < len(sc.assets) {
        if sc.assets[i].src == a.src and sc.assets[i].kind == a.kind { return i; }
        i = i + 1;
    }
    array_push(sc.assets, a);
    return len(sc.assets) - 1;
}

fn layer(sc, id) {
    let i = 0;
    while i < len(sc.layers) {
        if sc.layers[i].id == id { return sc.layers[i]; }
        i = i + 1;
    }
    let l = map{ id: id, nodes: [] };
    array_push(sc.layers, l);
    return l;
}

fn node(kind, props = nil) {
    props = _opts(props);
    props.kind = kind;
    props.format = "pblang.visual.node.v1";
    props.visible = _get(props, "visible", true);
    props.opacity = _clamp(_get(props, "opacity", 1), 0, 1);
    return props;
}

fn rect(id, x, y, w, h, color) {
    return node("rect", map{ id: id, x: x, y: y, w: w, h: h, color: color });
}

fn text(id, x, y, value, color = nil, size = 16) {
    if color == nil { color = [230, 236, 245, 255]; }
    return node("text", map{ id: id, x: x, y: y, text: value, color: color, size: size });
}

fn image(id, asset_ref, x, y, w, h) {
    return node("image", map{ id: id, asset: asset_ref, x: x, y: y, w: w, h: h });
}

fn audio(id, asset_ref, start = 0, volume = 1) {
    return node("audio", map{ id: id, asset: asset_ref, start: start, volume: _clamp(volume, 0, 1) });
}

fn video(id, asset_ref, x, y, w, h, start = 0, volume = 1) {
    return node("video", map{ id: id, asset: asset_ref, x: x, y: y, w: w, h: h, start: start, volume: _clamp(volume, 0, 1) });
}

fn line2d(id, x1, y1, x2, y2, color = nil, width = 1) {
    if color == nil { color = [230, 236, 245, 255]; }
    return node("line2d", map{ id: id, x1: x1, y1: y1, x2: x2, y2: y2, color: color, width: width });
}

fn circle2d(id, x, y, r, color = nil, fill = true) {
    if color == nil { color = [108, 92, 231, 255]; }
    return node("circle2d", map{ id: id, x: x, y: y, r: r, color: color, fill: fill });
}

fn _finite_number(value) {
    if type(value) != "number" { return false; }
    let text = str_lower(str(value));
    return text != "nan" and text != "+nan" and text != "-nan"
        and not str_contains(text, "inf");
}

fn _positive_extent(value, label) {
    if not _finite_number(value) or value <= 0 or value > 1000000000 {
        throw label + " must be a finite positive number at most 1000000000";
    }
    return value;
}

fn _bounded_angle(value, label) {
    if not _finite_number(value) or value < -1000000 or value > 1000000 {
        throw label + " must be a finite angle in -1000000..1000000 radians";
    }
    return value;
}

fn ellipse2d(id, x, y, rx, ry, color = nil, fill = true) {
    let radius_x = _positive_extent(rx, "ellipse radius_x");
    let radius_y = _positive_extent(ry, "ellipse radius_y");
    if color == nil { color = [108, 92, 231, 255]; }
    return node("ellipse2d", map{
        id: id, x: x, y: y, rx: radius_x, ry: radius_y,
        color: color, fill: fill
    });
}

fn arc2d(id, x, y, rx, ry, start_radians, end_radians,
         color = nil, width = 1) {
    let radius_x = _positive_extent(rx, "arc radius_x");
    let radius_y = _positive_extent(ry, "arc radius_y");
    let start = _bounded_angle(start_radians, "arc start");
    let finish = _bounded_angle(end_radians, "arc end");
    let stroke = _positive_extent(width, "arc width");
    if start == finish { throw "arc start and end must describe a non-zero span"; }
    if color == nil { color = [230, 236, 245, 255]; }
    return node("arc2d", map{
        id: id, x: x, y: y, rx: radius_x, ry: radius_y,
        start_radians: start, end_radians: finish,
        color: color, width: stroke, fill: false
    });
}

fn polygon2d(id, points, color = nil, fill = false) {
    if color == nil { color = [46, 224, 189, 255]; }
    return node("polygon2d", map{ id: id, points: points, color: color, fill: fill });
}

fn mesh2d(id, vertices, edges = nil, faces = nil, color = nil) {
    if edges == nil { edges = []; }
    if faces == nil { faces = []; }
    if color == nil { color = [120, 180, 255, 255]; }
    return node("mesh2d", map{ id: id, vertices: vertices, edges: edges, faces: faces, color: color });
}

fn path2d(id, commands, color = nil, fill = false) {
    if color == nil { color = [46, 224, 189, 255]; }
    return node("path2d", map{ id: id, commands: commands, color: color, fill: fill });
}

fn group2d(id, children, opts = nil) {
    opts = _opts(opts);
    return node("group2d", map{ id: id, children: children, x: _get(opts, "x", 0), y: _get(opts, "y", 0) });
}

fn point3d(id, x, y, z, color = nil, size = 3) {
    if color == nil { color = [255, 204, 102, 255]; }
    return node("point3d", map{ id: id, x: x, y: y, z: z, color: color, size: size });
}

fn mesh3d(id, vertices, edges = nil, faces = nil, color = nil) {
    if edges == nil { edges = []; }
    if faces == nil { faces = []; }
    if color == nil { color = [108, 92, 231, 255]; }
    return node("mesh3d", map{ id: id, vertices: vertices, edges: edges, faces: faces, color: color });
}

fn cube3d(id, x, y, z, size, color = nil) {
    if color == nil { color = [108, 92, 231, 255]; }
    let s = size / 2;
    let v = [
        [x - s, y - s, z - s], [x + s, y - s, z - s], [x + s, y + s, z - s], [x - s, y + s, z - s],
        [x - s, y - s, z + s], [x + s, y - s, z + s], [x + s, y + s, z + s], [x - s, y + s, z + s],
    ];
    let e = [[0,1],[1,2],[2,3],[3,0],[4,5],[5,6],[6,7],[7,4],[0,4],[1,5],[2,6],[3,7]];
    let f = [[0,1,2,3],[4,5,6,7],[0,1,5,4],[2,3,7,6],[1,2,6,5],[0,3,7,4]];
    return mesh3d(id, v, e, f, color);
}

fn sphere3d(id, x, y, z, r, color = nil, segments = 16) {
    if color == nil { color = [46, 224, 189, 255]; }
    return node("sphere3d", map{ id: id, x: x, y: y, z: z, r: r, segments: segments, color: color });
}

fn surface3d(id, grid, color = nil) {
    if color == nil { color = [120, 180, 255, 255]; }
    return node("surface3d", map{ id: id, grid: grid, color: color });
}

fn transform3d(x = 0, y = 0, z = 0, rx = 0, ry = 0, rz = 0, sx = 1, sy = 1, sz = 1) {
    return map{
        position: [x, y, z],
        rotation: [rx, ry, rz],
        scale: [sx, sy, sz],
    };
}

fn camera3d(id, x, y, z, target = nil, opts = nil) {
    opts = _opts(opts);
    if target == nil { target = [0, 0, 0]; }
    return node("camera3d", map{
        id: id,
        transform: transform3d(x, y, z),
        target: target,
        fov: _get(opts, "fov", 60),
        near: _get(opts, "near", 0.1),
        far: _get(opts, "far", 1000),
        projection: _get(opts, "projection", "perspective"),
    });
}

fn light3d(id, light_type, x, y, z, color = nil, intensity = 1) {
    if color == nil { color = [255, 244, 214, 255]; }
    return node("light3d", map{ id: id, light_type: light_type, transform: transform3d(x, y, z), color: color, intensity: intensity });
}

fn material(id, shader = "pbr-lite", color = nil, opts = nil) {
    opts = _opts(opts);
    if color == nil { color = [108, 92, 231, 255]; }
    return node("material", map{
        id: id,
        shader: shader,
        color: color,
        metallic: _clamp(_get(opts, "metallic", 0), 0, 1),
        roughness: _clamp(_get(opts, "roughness", 0.5), 0, 1),
        texture: _get(opts, "texture", nil),
        executable: false,
    });
}

fn shader_program(id, language, vertex_src = "", fragment_src = "", opts = nil) {
    opts = _opts(opts);
    return node("shader_program", map{
        id: id,
        language: str_lower(language),
        vertex_src: vertex_src,
        fragment_src: fragment_src,
        target: _get(opts, "target", "metadata-only"),
        executable: false,
        safe_note: "shader source is metadata until compiled by an explicit trusted backend",
    });
}

fn physics_body(id, body_type = "static", shape = "box", mass = 1, opts = nil) {
    opts = _opts(opts);
    return node("physics_body", map{
        id: id,
        body_type: body_type,
        shape: shape,
        mass: mass,
        gravity: _get(opts, "gravity", true),
        friction: _get(opts, "friction", 0.5),
        restitution: _get(opts, "restitution", 0.1),
    });
}

fn terrain(id, width, depth, heights = nil, opts = nil) {
    opts = _opts(opts);
    if heights == nil { heights = []; }
    return node("terrain", map{
        id: id,
        width: width,
        depth: depth,
        heights: heights,
        material: _get(opts, "material", ""),
        lod: _get(opts, "lod", "auto"),
    });
}

fn particle_system(id, x, y, z, count = 128, opts = nil) {
    opts = _opts(opts);
    return node("particle_system", map{
        id: id,
        transform: transform3d(x, y, z),
        count: count,
        rate: _get(opts, "rate", 16),
        lifetime: _get(opts, "lifetime", 2),
        emitter: _get(opts, "emitter", "point"),
        color: _get(opts, "color", [255, 204, 102, 255]),
    });
}

fn skybox(id, asset_ref = nil, color = nil) {
    if color == nil { color = [13, 17, 23, 255]; }
    return node("skybox", map{ id: id, asset: asset_ref, color: color });
}

fn entity(id, name, transform = nil, components = nil) {
    if transform == nil { transform = transform3d(); }
    if components == nil { components = []; }
    return node("entity", map{ id: id, name: name, transform: transform, components: components });
}

fn component_ref(kind, ref_id, props = nil) {
    props = _opts(props);
    return map{ kind: kind, ref: ref_id, props: props };
}

fn attach_component(ent, c) {
    if (try ent.components catch nil) == nil { ent.components = []; }
    push(ent.components, c);
    return ent;
}

fn prefab(id, name, nodes, opts = nil) {
    opts = _opts(opts);
    return node("prefab", map{
        id: id,
        name: name,
        nodes: nodes,
        source: _get(opts, "source", "designer"),
        engine_hint: _get(opts, "engine_hint", "generic"),
    });
}

fn render_backend(id, backend, opts = nil) {
    opts = _opts(opts);
    return node("render_backend", map{
        id: id,
        backend: str_lower(backend),
        api: _get(opts, "api", str_lower(backend)),
        target: _get(opts, "target", "plan-only"),
        quality: _get(opts, "quality", "balanced"),
        executable: false,
    });
}

fn point_nd(id, values, color = nil, size = 3) {
    if color == nil { color = [255, 204, 102, 255]; }
    return node("point_nd", map{ id: id, dims: len(values), values: values, color: color, size: size });
}

fn cloud_nd(id, points, color = nil) {
    if color == nil { color = [46, 224, 189, 255]; }
    let dims = 0;
    if len(points) > 0 { dims = len(points[0]); }
    return node("cloud_nd", map{ id: id, dims: dims, points: points, color: color });
}

fn tensor_item(id, shape, values = nil, opts = nil) {
    opts = _opts(opts);
    return node("tensor_nd", map{
        id: id, shape: shape, values: values,
        projection: _get(opts, "projection", "pca-preview"),
        color: _get(opts, "color", [210, 168, 255, 255]),
    });
}

fn item_nd(id, values, projection = "pca-preview", opts = nil) {
    opts = _opts(opts);
    return node("item_nd", map{
        id: id,
        dims: len(values),
        values: values,
        projection: projection,
        label: _get(opts, "label", id),
        color: _get(opts, "color", [255, 204, 102, 255]),
    });
}

fn component(id, component_kind, x, y, w, h, props = nil) {
    props = _opts(props);
    return node("component", map{
        id: id,
        component_kind: component_kind,
        x: x, y: y, w: w, h: h,
        props: props,
        executable: false,
    });
}

fn custom_component(id, name, x, y, w, h, props = nil) {
    props = _opts(props);
    return node("custom_component", map{
        id: id, name: name,
        x: x, y: y, w: w, h: h,
        props: props,
        source: _get(props, "source", "designer"),
        executable: false,
    });
}

fn foreign_component(id, language, source, x, y, w, h, opts = nil) {
    opts = _opts(opts);
    return node("foreign_component", map{
        id: id,
        language: str_lower(language),
        source: source,
        x: x, y: y, w: w, h: h,
        mode: _get(opts, "mode", "metadata-only"),
        origin: _get(opts, "origin", "external-ide-or-designer"),
        executable: false,
        safe_note: "stored as metadata; pblang does not execute foreign code here",
    });
}

fn web_component(id, html, css = "", js = "", x = 0, y = 0, w = 320, h = 180, opts = nil) {
    opts = _opts(opts);
    return node("web_component", map{
        id: id,
        html: html,
        css: css,
        js: js,
        x: x, y: y, w: w, h: h,
        mode: _get(opts, "mode", "host-render-only"),
        executable: false,
        safe_note: "DOM/CSS/JS rendering requires an explicit host renderer; no JS runs inside pblang",
    });
}

fn scanned_component(id, scanner_kind, src, x, y, w, h, opts = nil) {
    opts = _opts(opts);
    let pol = validate_source(src, _get(opts, "allow_private", false));
    return node("scanned_component", map{
        id: id,
        scanner_kind: scanner_kind,
        src: src,
        x: x, y: y, w: w, h: h,
        source_kind: source_kind(src),
        ok: pol.ok,
        policy: pol,
        format_hint: _get(opts, "format_hint", ""),
        units: _get(opts, "units", ""),
        metadata: _get(opts, "metadata", map{}),
        executable: false,
    });
}

fn chart(id, chart_type, series, opts = nil) {
    opts = _opts(opts);
    return node("chart", map{
        id: id,
        chart_type: chart_type,
        series: series,
        title: _get(opts, "title", ""),
        x_label: _get(opts, "x_label", ""),
        y_label: _get(opts, "y_label", ""),
        color: _get(opts, "color", [46, 224, 189, 255]),
        stacked: _get(opts, "stacked", false),
        projection: _get(opts, "projection", "2d"),
    });
}

fn line_chart(id, points, opts = nil) { return chart(id, "line", points, opts); }
fn bar_chart(id, values, opts = nil) { return chart(id, "bar", values, opts); }
fn scatter2d(id, points, opts = nil) { return chart(id, "scatter2d", points, opts); }
fn scatter3d(id, points, opts = nil) { opts = _opts(opts); opts.projection = "3d"; return chart(id, "scatter3d", points, opts); }
fn heatmap(id, matrix, opts = nil) { return chart(id, "heatmap", matrix, opts); }

fn add(sc, n, layer_id = "main") {
    let l = layer(sc, layer_id);
    if (n.kind == "image" or n.kind == "audio" or n.kind == "video")
       and type(n.asset) == "map" {
        n.asset_index = _push_asset(sc, n.asset);
    }
    array_push(l.nodes, n);
    return sc;
}

fn key(node_id, t, props) {
    return map{ node: node_id, t: t, props: props };
}

fn add_key(sc, node_id, t, props) {
    array_push(sc.timeline, key(node_id, t, props));
    return sc;
}

fn compile(sc) {
    let draw = [];
    let audio_nodes = [];
    let video_nodes = [];
    let li = 0;
    while li < len(sc.layers) {
        let l = sc.layers[li];
        let ni = 0;
        while ni < len(l.nodes) {
            let n = l.nodes[ni];
            n.layer = l.id;
            if n.kind == "audio" { array_push(audio_nodes, n); }
            else if n.kind == "video" { array_push(video_nodes, n); array_push(draw, n); }
            else { array_push(draw, n); }
            ni = ni + 1;
        }
        li = li + 1;
    }
    return map{
        format: "pblang.visual.plan.v1",
        viewport: sc.viewport,
        bg: sc.bg,
        assets: sc.assets,
        render: try sc.render catch map{ backend: "native", pipeline: "forward-2d3d" },
        systems: try sc.systems catch [],
        draw: draw,
        audio: audio_nodes,
        video: video_nodes,
        timeline: sc.timeline,
    };
}

fn summarize(sc) {
    let p = compile(sc);
    return map{
        title: sc.title,
        assets: len(p.assets),
        draw_nodes: len(p.draw),
        audio_nodes: len(p.audio),
        video_nodes: len(p.video),
        timeline_keys: len(p.timeline),
    };
}

fn scene_from_page(page, w = 800, h = 600) {
    let sc = scene(w, h, map{ title: try page.title catch "page" });
    add(sc, rect("page-bg", 0, 0, w, h, [18, 24, 38, 255]));
    let y = 24;
    let blocks = B.page_blocks(page);
    let i = 0;
    while i < len(blocks) and i < 32 {
        let b = blocks[i];
        let k = try b.kind catch "p";
        let tx = str(try b.text catch "");
        if k == "img" {
            let a = asset("image", try b.src catch "", map{ alt: tx });
            add(sc, image("img-" + str(i), a, 24, y, w - 48, 120));
            y = y + 136;
        } else {
            let size = 14;
            if k == "title" or k == "h1" { size = 22; }
            else if k == "h2" { size = 18; }
            add(sc, text("txt-" + str(i), 24, y, tx, [230, 236, 245, 255], size));
            y = y + size + 12;
        }
        i = i + 1;
    }
    return sc;
}

export capabilities, source_kind, validate_source, scene, asset, layer, node;
export rect, text, image, audio, video, line2d, circle2d, ellipse2d, arc2d, polygon2d, mesh2d, path2d, group2d;
export point3d, mesh3d, cube3d, sphere3d, surface3d, transform3d, camera3d, light3d, material, shader_program;
export physics_body, terrain, particle_system, skybox, entity, component_ref, attach_component, prefab, render_backend;
export point_nd, cloud_nd, tensor_item, item_nd;
export component, custom_component, foreign_component, web_component, scanned_component;
export chart, line_chart, bar_chart, scatter2d, scatter3d, heatmap;
// node_count(sc) — total draw nodes across all layers.
fn node_count(sc) {
    let total = 0;
    let i = 0;
    while i < len(sc.layers) { total = total + len(sc.layers[i].nodes); i = i + 1; }
    return total;
}

fn _node_keys(sc, node_id, prop) {
    let ks = [];
    let i = 0;
    while i < len(sc.timeline) {
        let k = sc.timeline[i];
        if k.node == node_id and map_has(k.props, prop) { array_push(ks, map{ t: k.t, v: k.props[prop] }); }
        i = i + 1;
    }
    let a = 1;
    while a < len(ks) {
        let key_k = ks[a];
        let b = a - 1;
        while b >= 0 and ks[b].t > key_k.t { ks[b + 1] = ks[b]; b = b - 1; }
        ks[b + 1] = key_k;
        a = a + 1;
    }
    return ks;
}

// interpolate_at(sc, node_id, prop, t) — linear-interpolate a numeric property
// from its keyframes at time t (clamped to the first/last keyframe; nil if none).
fn interpolate_at(sc, node_id, prop, t) {
    let ks = _node_keys(sc, node_id, prop);
    if len(ks) == 0 { return nil; }
    if t <= ks[0].t { return ks[0].v; }
    let last = ks[len(ks) - 1];
    if t >= last.t { return last.v; }
    let i = 0;
    while i < len(ks) - 1 {
        if t >= ks[i].t and t <= ks[i + 1].t {
            let span = ks[i + 1].t - ks[i].t;
            if span == 0 { return ks[i].v; }
            let f = (t - ks[i].t) / span;
            return ks[i].v + (ks[i + 1].v - ks[i].v) * f;
        }
        i = i + 1;
    }
    return last.v;
}

// ── wave 2: timeline introspection + whole-node sampling ─────────────────────────

// key_count(sc) — total number of keyframes on the timeline.
fn key_count(sc) { return len(sc.timeline); }

// timeline_duration(sc) — the largest keyframe time (0 if the timeline is empty).
fn timeline_duration(sc) {
    let mx = 0;
    let i = 0;
    while i < len(sc.timeline) {
        if sc.timeline[i].t > mx { mx = sc.timeline[i].t; }
        i = i + 1;
    }
    return mx;
}

// node_props_at(sc, node_id, t) — map of every animated property of a node,
// each linear-interpolated at time t. Empty map if the node has no keyframes.
fn node_props_at(sc, node_id, t) {
    let names = [];
    let i = 0;
    while i < len(sc.timeline) {
        let k = sc.timeline[i];
        if k.node == node_id {
            let pk = map_keys(k.props);
            let j = 0;
            while j < len(pk) {
                let already = false;
                let m = 0;
                while m < len(names) { if names[m] == pk[j] { already = true; break; } m = m + 1; }
                if not already { array_push(names, pk[j]); }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    let out = map{};
    let n = 0;
    while n < len(names) {
        out[names[n]] = interpolate_at(sc, node_id, names[n], t);
        n = n + 1;
    }
    return out;
}

export add, key, add_key, compile, summarize, scene_from_page;
export node_count, interpolate_at, key_count, timeline_duration, node_props_at;
