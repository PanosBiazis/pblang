// Passive SVG plus an accessible data table; no script, external asset or event.
let HTML=import("stdlib:html.sapp");
fn _label(value) {
    if type(value)!="string" or len(value)>4096 {throw "ui_scatter_plot: invalid label";}
    return HTML.escape(value);
}
fn _number(value) {
    if type(value)!="number" or not (value>=-1000000000000 and value<=1000000000000) {throw "ui_scatter_plot: invalid coordinate";}
    return value;
}
fn _has(items,value) {for item in items {if item==value {return true;}}return false;}
fn _domain(value,low,high) {
    if value==nil {return [low,high];}
    if type(value)!="array" or len(value)!=2 {throw "ui_scatter_plot: invalid domain";}
    let first=_number(value[0]);let last=_number(value[1]);
    if first>=last or first>low or last<high {throw "ui_scatter_plot: domain must contain every point";}
    return [first,last];
}
fn render(points,title="Projection",x_label="X",y_label="Y",options=nil) {
    let caption=_label(title);let x_name=_label(x_label);let y_name=_label(y_label);
    if type(points)!="array" or len(points)<1 or len(points)>256 {throw "ui_scatter_plot: point budget exceeded";}
    let checked=[];
    for point in points {
        if type(point)!="array" or len(point)!=2 {throw "ui_scatter_plot: expected 2D points";}
        push(checked,[_number(point[0]),_number(point[1])]);
    }
    let left=checked[0][0];let right=left;let bottom=checked[0][1];let top=bottom;
    for point in checked {
        if point[0]<left {left=point[0];} if point[0]>right {right=point[0];}
        if point[1]<bottom {bottom=point[1];} if point[1]>top {top=point[1];}
    }
    if options==nil {options=map{};}
    if type(options)!="map" or len(map_keys(options))>5 {throw "ui_scatter_plot: invalid options";}
    for key in map_keys(options) {
        if not _has(["x_domain","y_domain","point_labels","description","table_open"],key) {throw "ui_scatter_plot: unsupported option";}
    }
    let labels=try options.point_labels catch nil;
    if labels!=nil {
        if type(labels)!="array" or len(labels)!=len(checked) {throw "ui_scatter_plot: invalid point labels";}
        let bytes=0;
        for label in labels {
            if type(label)!="string" or len(label)<1 or len(label)>256 {throw "ui_scatter_plot: invalid point label";}
            bytes=bytes+len(str_to_bytes(label));
            if bytes>4096 {throw "ui_scatter_plot: point label budget exceeded";}
        }
    }
    let description=try options.description catch "";
    _label(description);
    let table_open=try options.table_open catch false;
    if type(table_open)!="bool" {throw "ui_scatter_plot: invalid table state";}
    let xd=_domain(try options.x_domain catch nil,left,right);
    let yd=_domain(try options.y_domain catch nil,bottom,top);
    left=xd[0];right=xd[1];bottom=yd[0];top=yd[1];
    let parts=["<figure class=\"pb-scatter\"><figcaption>"+caption+"</figcaption><svg viewBox=\"0 0 640 360\" role=\"img\" aria-label=\""+caption+"\"><title>"+caption+"</title><path d=\"M48 24V312H612\" fill=\"none\" stroke=\"currentColor\"/>"];
    let table=[];let index=0;
    for point in checked {
        let x=if right==left {330} else {48+(point[0]-left)/(right-left)*564};
        let y=if top==bottom {168} else {312-(point[1]-bottom)/(top-bottom)*288};
        let label=str(index+1);
        if labels!=nil {label=labels[index];}
        index=index+1;
        push(parts,"<circle cx=\""+str(x)+"\" cy=\""+str(y)+"\" r=\"4\" fill=\"currentColor\"><title>"+HTML.escape(label)+": "+str(point[0])+", "+str(point[1])+"</title></circle>");
        push(table,[label,point[0],point[1]]);
    }
    push(parts,"<text x=\"330\" y=\"348\" text-anchor=\"middle\" fill=\"currentColor\">"+x_name+"</text><text x=\"48\" y=\"16\" fill=\"currentColor\">"+y_name+"</text></svg>");
    if len(map_keys(options))>0 {
        if description!="" {push(parts,"<p>"+HTML.escape(description)+"</p>");}
        push(parts,"<p class=\"pb-scatter-scale\">"+str(len(checked))+" points. "+x_name+": "+str(left)+" to "+str(right)+"; "+y_name+": "+str(bottom)+" to "+str(top)+".</p>");
    }
    let open=if table_open {" open"} else {""};
    push(parts,"<details"+open+"><summary>Point values</summary>");
    push(parts,HTML.table(["Point",x_label,y_label],table));push(parts,"</details></figure>");
    let result=str_join(parts,"");
    if len(str_to_bytes(result))>262144 {throw "ui_scatter_plot: output budget exceeded";}
    return result;
}
export render;
