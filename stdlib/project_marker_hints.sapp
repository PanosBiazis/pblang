// Pure basename hints, not filesystem evidence or an admission decision.
// This schema is deliberately separate from project_inventory's v1 catalog.

fn _counts() {
    return map{pblang:0,cargo:0,javascript_package:0,python_packaging:0,
        go_module:0,maven:0,gradle:0,cmake:0,dart_pub:0,swift_package:0,
        godot:0,composer:0,bundler:0,make:0,dotnet_project:0,msbuild_cpp:0,
        visual_studio_solution:0,delphi_project:0,lazarus_project:0,unreal_project:0};
}

fn _report(ok,error,input_count,unique_count,recognized,counts) {
    return map{format:"pblang.project-marker-hints.v1",ok:ok,error:error,
        input_count:input_count,unique_name_count:unique_count,
        recognized_marker_count:recognized,family_counts:counts,
        metadata_only:true,contains_names:false,contains_paths:false,
        contains_digests:false,content_read:false,execution_performed:false,
        existence_verified:false,kind_verified:false,repository_verified:false,
        language_verified:false,toolchain_verified:false,license_verified:false,
        authenticity_verified:false,idea_admission_eligible:false,
        implementation_allowed:false,training_allowed:false,
        external_effects_allowed:false,safe_to_log:false,production_ready:false};
}

fn _valid_name(name) {
    if type(name)!="string" or len(name)==0 or len(name)>255
        or len(str_to_bytes(name))>255 or name=="." or name==".."
        or str_contains(name,"/") or str_contains(name,"\\")
        or str_contains(name,":") { return false; }
    let i=0;
    while i<len(name) {
        let c=strcharcodeat(name,i);
        // C0/C1, soft hyphen, Arabic/bidi/zero-width/display controls and BOM.
        if c<32 or (c>=127 and c<=159) or c==173 or c==1564 or c==6158
            or (c>=8203 and c<=8207) or (c>=8232 and c<=8238)
            or (c>=8288 and c<=8303) or c==65279
            or (c>=65529 and c<=65531) { return false; }
        i=i+1;
    }
    return true;
}

fn _suffix(name,suffix) {
    return len(name)>len(suffix) and str_ends_with(name,suffix);
}

fn _family(name) {
    if name=="pblang.toml" { return "pblang"; }
    if name=="Cargo.toml" { return "cargo"; }
    if name=="package.json" { return "javascript_package"; }
    if name=="pyproject.toml" or name=="setup.py" { return "python_packaging"; }
    if name=="go.mod" { return "go_module"; }
    if name=="pom.xml" { return "maven"; }
    if name=="build.gradle" or name=="build.gradle.kts" { return "gradle"; }
    if name=="CMakeLists.txt" { return "cmake"; }
    if name=="pubspec.yaml" { return "dart_pub"; }
    if name=="Package.swift" { return "swift_package"; }
    if name=="project.godot" { return "godot"; }
    if name=="composer.json" { return "composer"; }
    if name=="Gemfile" { return "bundler"; }
    if name=="Makefile" { return "make"; }
    if _suffix(name,".csproj") or _suffix(name,".fsproj")
        or _suffix(name,".vbproj") { return "dotnet_project"; }
    if _suffix(name,".vcxproj") { return "msbuild_cpp"; }
    if _suffix(name,".sln") or _suffix(name,".slnx") { return "visual_studio_solution"; }
    if _suffix(name,".dproj") or _suffix(name,".groupproj") { return "delphi_project"; }
    if _suffix(name,".lpi") { return "lazarus_project"; }
    if _suffix(name,".uproject") { return "unreal_project"; }
    return "";
}

fn _summarize(names) {
    if type(names)!="array" or len(names)>256 { throw "invalid-input"; }
    // Budget every supplied name before deduplication; duplicates are not free.
    let bytes=0;
    for name in names {
        if not _valid_name(name) { throw "invalid-input"; }
        bytes=bytes+len(str_to_bytes(name));
        if bytes>32768 { throw "invalid-input"; }
    }
    let seen=map{}; let counts=_counts(); let recognized=0;
    for name in names {
        if not map_has(seen,name) {
            seen[name]=true;
            let family=_family(name);
            if family!="" { counts[family]=counts[family]+1; recognized=recognized+1; }
        }
    }
    return _report(true,"",len(names),len(map_keys(seen)),recognized,counts);
}

fn summarize(names) {
    return try _summarize(names) catch _report(false,"invalid-input",0,0,0,_counts());
}

fn _scan_report(ok,error,source,state,depth,available,partial,report) {
    return map{format:"pblang.project-marker-scan.v1",ok:ok,error:error,
        source:source,state:state,depth:depth,
        observation_status:if ok { "caller-claimed" } else { "none" },
        hints_available:available,partial:partial,report:report,
        coverage_verified:false,live_existence_verified:false,
        index_freshness_verified:false,absence_verified:false,
        metadata_only:true,contains_names:false,contains_paths:false,
        contains_digests:false,content_read:false,execution_performed:false,
        idea_admission_eligible:false,implementation_allowed:false,
        training_allowed:false,external_effects_allowed:false,
        safe_to_log:false,production_ready:false};
}

fn _describe_scan(names,observation) {
    if type(observation)!="map" or len(observation)!=3
        or not map_has(observation,"source") or not map_has(observation,"state")
        or not map_has(observation,"depth") { throw "invalid-input"; }
    let source=observation.source; let state=observation.state; let depth=observation.depth;
    if type(source)!="string" or (source!="direct" and source!="index")
        or type(state)!="string" or type(depth)!="number"
        or depth!=num_floor(depth) or not (depth>=0 and depth<=8)
        or (source=="index" and depth!=0) { throw "invalid-input"; }
    let available=state=="completed" or state=="truncated" or state=="timeout";
    if not available and state!="unavailable" and state!="excluded" and state!="error" {
        throw "invalid-input";
    }
    // Unavailable/error/excluded observations cannot smuggle a hint batch.
    if not available and (type(names)!="array" or len(names)!=0) { throw "invalid-input"; }
    let report=_summarize(names);
    return _scan_report(true,"",source,state,depth,available,
        state=="truncated" or state=="timeout",report);
}

// Describe caller claims, never attest a scan or infer absence from no matches.
fn describe_scan(names,observation) {
    return try _describe_scan(names,observation) catch
        _scan_report(false,"invalid-input","unknown","invalid",0,false,false,summarize(nil));
}

export summarize, describe_scan;
