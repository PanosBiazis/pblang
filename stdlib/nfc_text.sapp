// Bounded single-record NDEF RTD Text, UTF-8 only. No hardware or URI dispatch.
fn _bytes(value){
    if type(value)!="array" or len(value)>4096 {throw "nfc_text: invalid byte message";}
    for b in value {if type(b)!="number" or not(b>=0 and b<=255) or b!=num_floor(b){throw "nfc_text: invalid byte";}}
}
fn _language(value){
    if type(value)!="string" or len(value)<1 or len(value)>15 {throw "nfc_text: invalid language";}
    let alphabet="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-";
    for i len(value){if not str_contains(alphabet,str_slice(value,i,i+1)){throw "nfc_text: invalid language";}}
    if str_starts_with(value,"-") or str_ends_with(value,"-") or str_contains(value,"--"){throw "nfc_text: invalid language";}
    return value;
}
fn encode(text,language="en"){
    if type(text)!="string" or len(text)>4000 {throw "nfc_text: invalid text";}
    let content=str_to_bytes(text);if len(content)>4000 {throw "nfc_text: text byte limit";}
    let lang=str_to_bytes(_language(language));let n=1+len(lang)+len(content);let out=[];
    if n<=255 {out=[209,1,n,84];}
    if n>255 {out=[193,1,0,0,num_floor(n/256),n%256,84];}
    out[len(out)]=len(lang);for b in lang{out[len(out)]=b;}for b in content{out[len(out)]=b;}
    return out;
}
fn inspect(bytes,include_text=false){
    _bytes(bytes);if type(include_text)!="bool"{throw "nfc_text: invalid preview policy";}
    if len(bytes)<5 {throw "nfc_text: truncated message";}
    // Exact headers require MB/ME, TNF1, no chunks, no ID, a single record.
    let short=bytes[0]==209;if not short and bytes[0]!=193 {throw "nfc_text: unsupported record header";}
    if bytes[1]!=1 {throw "nfc_text: invalid record type length";}
    let offset=4;let n=bytes[2];
    if not short {
        if len(bytes)<8 {throw "nfc_text: truncated long header";}
        n=bytes[2]*16777216+bytes[3]*65536+bytes[4]*256+bytes[5];offset=7;
    }
    if bytes[offset-1]!=84 or n<2 or offset+n!=len(bytes) {throw "nfc_text: malformed record";}
    let language_size=bytes[offset];
    // UTF-16/reserved status bits and unsupported language lengths fail closed.
    if language_size<1 or language_size>15 or language_size+1>n {throw "nfc_text: unsupported text status";}
    let lang=[];for i language_size{lang[len(lang)]=bytes[offset+1+i];}
    let language=_language(bytes_to_str(lang));
    let content=[];for i (n-1-language_size){content[len(content)]=bytes[offset+1+language_size+i];}
    let text=bytes_to_str(content);let roundtrip=str_to_bytes(text);
    if len(roundtrip)!=len(content){throw "nfc_text: invalid UTF-8";}
    for i len(content){if roundtrip[i]!=content[i]{throw "nfc_text: invalid UTF-8";}}
    let out=map{format:"ndef-rtd-text",encoding:"UTF-8",records:1,language:language,text_bytes:len(content),
        text_included:include_text,device_accessed:false,tag_written:false,content_executed:false};
    if include_text {out.text=text;}
    return out;
}
export encode,inspect;
