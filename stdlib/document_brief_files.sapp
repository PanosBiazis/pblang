let D=import("stdlib:text_document_files.sapp");let B=import("stdlib:document_brief.sapp");
fn compose(paths,title,selections=nil) {
 if type(paths)!="array" or len(paths)<2 or len(paths)>B.MAX_SOURCES {return map{ok:false,error:"Choose 2-4 Writer sources."};}
 let documents=[];
 for path in paths {let loaded=D.open_document(path);if not loaded.ok {return map{ok:false,error:"Could not open a Writer source; previous preview retained."};}array_push(documents,loaded.document);}
 let doc=try B.create(documents,title,selections) catch nil;
 if doc==nil {return map{ok:false,error:"Invalid title, selection or combined Writer limits (64 blocks, 32768 text bytes)."};}
 return map{ok:true,document:doc,snapshot:true};
}
fn save_copy(path,doc) {return D.save_copy(path,doc);}
fn compose_copy(paths,title,output,selections=nil) {
 let result=compose(paths,title,selections);if not result.ok {return result;}
 let saved=save_copy(output,result.document);if saved.ok {saved.snapshot=true;}return saved;
}
export compose,save_copy,compose_copy;
