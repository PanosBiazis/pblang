// stdlib/socks5.sapp — the SOCKS5 client protocol, in pblang (for Tor routing).
//
// Tor exposes a SOCKS5 proxy (default 127.0.0.1:9050). To browse via Tor, a client opens
// a plain TCP socket to that proxy, performs the SOCKS5 no-auth greeting, sends a CONNECT
// request for the target host:port, then speaks HTTP over the established tunnel. This
// module builds/parses those SOCKS5 messages — the protocol is pure pblang and tested in
// the VM. Bytes are carried as code points in a string (each 0..255).
//
// HONEST GAP (docs/Protocols.md): the *transport* needs a plain `tcp_connect` builtin
// (the VM ships tcp_listen/accept + only tcp_connect_tls), and HTTPS targets additionally
// need TLS *inside* the SOCKS tunnel. The protocol below is ready for when those land.

fn _byte(v) { return strfromcharcode(v); }

// greeting() — client hello offering the "no authentication" method (0x00).
//   [ ver=0x05, n_methods=0x01, method=0x00 ]
fn greeting() { return _byte(5) + _byte(1) + _byte(0); }

// connect_request(host, port) — a SOCKS5 CONNECT to a domain target.
//   [ ver=0x05, cmd=0x01(CONNECT), rsv=0x00, atyp=0x03(domain), len, host…, port_hi, port_lo ]
fn connect_request(host, port) {
    let n = len(host);
    let hi = (port - num_mod(port, 256)) / 256;
    let lo = num_mod(port, 256);
    return _byte(5) + _byte(1) + _byte(0) + _byte(3) + _byte(n) + host + _byte(hi) + _byte(lo);
}

// parse_method_reply(bytes) — server's chosen method: [ ver, method ]. method 0x00 = ok.
fn parse_method_reply(bytes) {
    if len(bytes) < 2 { return nil; }
    return map{ ver: strcharcodeat(bytes, 0), method: strcharcodeat(bytes, 1) };
}
fn method_ok(reply) { return reply != nil and reply.ver == 5 and reply.method == 0; }

// parse_connect_reply(bytes) — CONNECT result: [ ver, rep, rsv, atyp, … ]. rep 0x00 = ok.
fn parse_connect_reply(bytes) {
    if len(bytes) < 2 { return nil; }
    return map{ ver: strcharcodeat(bytes, 0), rep: strcharcodeat(bytes, 1) };
}
fn connect_ok(reply) { return reply != nil and reply.rep == 0; }

// rep_text(rep) — human-readable SOCKS5 reply code.
fn rep_text(rep) {
    if rep == 0 { return "succeeded"; }
    if rep == 1 { return "general failure"; }
    if rep == 2 { return "connection not allowed"; }
    if rep == 3 { return "network unreachable"; }
    if rep == 4 { return "host unreachable"; }
    if rep == 5 { return "connection refused"; }
    return "error " + str(rep);
}

export greeting, connect_request, parse_method_reply, method_ok;
export parse_connect_reply, connect_ok, rep_text;
