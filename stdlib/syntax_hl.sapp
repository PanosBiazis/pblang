// stdlib/syntax_hl.sapp — pblang syntax highlighting, in pblang.
//
// Reuses the SELF-HOSTED tokenizer (stdlib/compiler/tokenizer.sapp) to colour pblang
// source — the same lexer the compiler uses, so highlighting matches the language
// exactly. `tokens` returns {kind, text, line, col} tokens; `kind_color` maps a kind to
// an [r,g,b] colour. The pblang-native IDE draws each token at its (line,col) in its
// colour. (Tokenizing can throw on mid-edit input — callers wrap in try/catch.)

let _T = import("stdlib/compiler/tokenizer.sapp");

fn tokens(source) { return _T.tokenize(source); }

fn _dark_kind_color(kind) {
    if kind == "keyword" { return [201, 132, 252]; }   // purple
    if kind == "string"  { return [162, 242, 211]; }   // green
    if kind == "number"  { return [255, 184, 107]; }   // orange
    if kind == "comment" { return [107, 122, 153]; }   // gray
    if kind == "punct"   { return [255, 121, 198]; }   // pink
    if kind == "bool"    { return [246, 193, 119]; }   // amber
    return [220, 228, 240];                            // default (identifiers/text)
}

fn _light_kind_color(kind) {
    if kind == "keyword" { return [110, 64, 180]; }    // purple
    if kind == "string"  { return [28, 116, 78]; }     // green
    if kind == "number"  { return [160, 92, 24]; }     // orange
    if kind == "comment" { return [92, 105, 125]; }    // gray
    if kind == "punct"   { return [170, 54, 112]; }    // pink
    if kind == "bool"    { return [154, 92, 18]; }     // amber
    return [25, 33, 46];                               // default (identifiers/text)
}

// kind_color(kind) -> [r, g, b] for a token kind (dark theme default).
fn kind_color(kind) {
    return _dark_kind_color(kind);
}

// kind_color_theme(kind, theme) -> [r, g, b] tuned for the active IDE theme.
fn kind_color_theme(kind, theme) {
    let t = str(theme);
    if t == "light" or t == "Light" or t == "LIGHT" { return _light_kind_color(kind); }
    return _dark_kind_color(kind);
}

// themes() — the available highlight theme names.
fn themes() { return ["dark", "light"]; }

// highlight(source, theme) — tokenize and attach a color to each token:
// [{ text, kind, color:[r,g,b], line, col }, ...].
fn highlight(source, theme) {
    let toks = tokens(source);
    let out = [];
    let i = 0;
    while i < len(toks) {
        let t = toks[i];
        array_push(out, map{
            text: t.text, kind: t.kind, color: kind_color_theme(t.kind, theme),
            line: t.line, col: t.col
        });
        i = i + 1;
    }
    return out;
}

// ── wave 2: HTML rendering + color legend ────────────────────────────────────────

let _H = import("stdlib/html.sapp");

fn _rgb_css(c) { return "rgb(" + str(c[0]) + "," + str(c[1]) + "," + str(c[2]) + ")"; }

// to_html(source, theme) — render highlighted source as an HTML <pre> block, each
// token an escaped <span> coloured by kind and positioned by its (line, col).
fn to_html(source, theme) {
    let toks = highlight(source, theme);
    let by_line = map{};
    let maxline = 1;
    let i = 0;
    while i < len(toks) {
        let t = toks[i];
        let key = str(t.line);
        if not map_has(by_line, key) { by_line[key] = []; }
        array_push(by_line[key], t);
        if t.line > maxline { maxline = t.line; }
        i = i + 1;
    }
    let out = "<pre class=\"pblang-code\">";
    let ln = 1;
    while ln <= maxline {
        let key = str(ln);
        if map_has(by_line, key) {
            let row = by_line[key];
            let col = 1;
            let j = 0;
            while j < len(row) {
                let t = row[j];
                while col < t.col { out = out + " "; col = col + 1; }
                out = out + "<span style=\"color:" + _rgb_css(t.color) + "\">" + _H.escape(t.text) + "</span>";
                col = col + len(t.text);
                j = j + 1;
            }
        }
        out = out + "\n";
        ln = ln + 1;
    }
    return out + "</pre>";
}

// legend(theme) — color key for the highlighted token kinds: [{kind, color, css}].
fn legend(theme) {
    let kinds = ["keyword", "string", "number", "comment", "punct", "bool", "identifier"];
    let out = [];
    let i = 0;
    while i < len(kinds) {
        let c = kind_color_theme(kinds[i], theme);
        array_push(out, map{ kind: kinds[i], color: c, css: _rgb_css(c) });
        i = i + 1;
    }
    return out;
}

export tokens, kind_color, kind_color_theme, themes, highlight, to_html, legend;
