// stdlib/pipe.sapp — Functional pipeline and composition helpers
//
// Usage:
//   let pipe = import("stdlib:pipe.sapp");
//   let result = pipe.chain(5, [add1, double, str]);
//   let add5 = pipe.partial(add, 5);
//   let composed = pipe.compose(square, add1);  // composed(x) = square(add1(x))

// chain(val, fns_array) — thread val through each function in order
// Equivalent to: fns[n-1](...fns[1](fns[0](val)))
fn chain(val, fns) {
    let result = val;
    let i = 0;
    while i < len(fns) {
        result = fns[i](result);
        i = i + 1;
    }
    return result;
}

// compose(f, g) — returns fn(x) = f(g(x))  (right-to-left)
fn compose(f, g) {
    return fn(x) { return f(g(x)); };
}

// pipe(fns_array) — returns fn(x) that pipes x through all fns (left-to-right)
fn pipe_fns(fns) {
    return fn(x) { return chain(x, fns); };
}

// partial(f, arg1) — partial application: returns fn(x) = f(arg1, x)
fn partial(f, arg1) {
    return fn(x) { return f(arg1, x); };
}

// partial2(f, arg1, arg2) — two-arg partial: returns fn(x) = f(arg1, arg2, x)
fn partial2(f, arg1, arg2) {
    return fn(x) { return f(arg1, arg2, x); };
}

// memoize(f) — returns a memoized version of f (caches by str(arg))
fn memoize(f) {
    let cache = map{};
    return fn(x) {
        let k = str(x);
        if map_has(cache, k) { return cache[k]; }
        let v = f(x);
        cache[k] = v;
        return v;
    };
}

// identity(x) → x
fn identity(x) { return x; }

// const_fn(v) — returns fn(_) = v (constant function)
fn const_fn(v) { return fn(_) { return v; }; }

// flip(f) — returns fn(a, b) = f(b, a)
fn flip(f) { return fn(a, b) { return f(b, a); }; }

// once(f) — returns a version of f that only runs once; subsequent calls return first result
fn once(f) {
    let ran = false;
    let result = nil;
    return fn(x) {
        if ran { return result; }
        result = f(x);
        ran = true;
        return result;
    };
}

// tap(f) — returns fn(x) that calls f(x) for side effects then returns x unchanged
fn tap(f) {
    return fn(x) {
        f(x);
        return x;
    };
}

// map_fn(f, arr) — map f over an array
fn map_fn(f, arr) {
    let result = [];
    let i = 0;
    while i < len(arr) {
        array_push(result, f(arr[i]));
        i = i + 1;
    }
    return result;
}

// filter_fn(pred, arr) — filter array by predicate
fn filter_fn(pred, arr) {
    let result = [];
    let i = 0;
    while i < len(arr) {
        if pred(arr[i]) { array_push(result, arr[i]); }
        i = i + 1;
    }
    return result;
}

// reduce_fn(f, init, arr) — left fold
fn reduce_fn(f, init, arr) {
    let acc = init;
    let i = 0;
    while i < len(arr) {
        acc = f(acc, arr[i]);
        i = i + 1;
    }
    return acc;
}

// compose_all(fns) — compose a list right-to-left: compose_all([f,g,h])(x) = f(g(h(x))).
fn compose_all(fns) {
    return fn(x) {
        let result = x;
        let i = len(fns) - 1;
        while i >= 0 { result = fns[i](result); i = i - 1; }
        return result;
    };
}

// juxt(fns) — returns fn(x) = [f0(x), f1(x), ...] (apply many fns to one input).
fn juxt(fns) {
    return fn(x) {
        let out = [];
        let i = 0;
        while i < len(fns) { array_push(out, fns[i](x)); i = i + 1; }
        return out;
    };
}

// when(pred, f) — returns fn(x) = f(x) if pred(x) else x.
fn when(pred, f) { return fn(x) { if pred(x) { return f(x); } return x; }; }

// unless(pred, f) — returns fn(x) = f(x) if NOT pred(x) else x.
fn unless(pred, f) { return fn(x) { if not pred(x) { return f(x); } return x; }; }

// complement(pred) — returns fn(x) = not pred(x).
fn complement(pred) { return fn(x) { return not pred(x); }; }

// partial_right(f, last) — returns fn(x) = f(x, last) (binds the trailing arg).
fn partial_right(f, last) { return fn(x) { return f(x, last); }; }

export chain, compose, compose_all, pipe_fns, partial, partial2, partial_right, memoize,
       identity, const_fn, flip, once, tap, juxt, when, unless, complement,
       map_fn, filter_fn, reduce_fn;
