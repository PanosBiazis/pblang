// Enhanced Thread Pool Module for pblang
// Provides bounded worker groups, task priorities, deterministic collection, and
// parallel helpers. Tasks are distributed in stable round-robin chunks; this
// module does not claim dynamic work stealing until a shared concurrent deque is
// available to the isolated worker VMs.
// Uses a minimal future backend; the full thread API is not a dependency.

let DEFAULT_THREADS = 4;
let MAX_THREADS = 64;
let MAX_TASKS = 100000;

// Reuse the dependency within this VM. A new VM/import gets its own binding.
let _THREAD = nil;
fn _thread_backend() {
    if _THREAD == nil { _THREAD = import("stdlib:thread_pool_future.sapp"); }
    return _THREAD;
}

fn _callable(v) {
    let t = type(v);
    return t == "closure" or t == "function" or t == "builtin";
}

fn _thread_count(value) {
    let n = value;
    if n == nil { n = DEFAULT_THREADS; }
    if not is_number(n) or n - n != 0 or n != num_floor(n) or n < 1 or n > MAX_THREADS {
        throw "thread_pool: worker count must be an integer in 1.." + str(MAX_THREADS);
    }
    return n;
}

fn _ensure_running(pool) {
    if pool == nil or not is_map(pool) { throw "thread_pool: invalid pool"; }
    if pool.running != true { throw "thread_pool: pool is shut down"; }
}

fn _submit(pool, task_fn, priority) {
    _ensure_running(pool);
    if not _callable(task_fn) { throw "thread_pool: task must be callable"; }
    if not is_number(priority) { throw "thread_pool: priority must be numeric"; }
    if len(pool.tasks) >= MAX_TASKS { throw "thread_pool: task limit exceeded"; }
    let task_id = pool.next_task_id;
    pool.next_task_id = pool.next_task_id + 1;
    array_push(pool.tasks, map{
        id: task_id,
        fn: task_fn,
        priority: priority,
        status: "pending",
        result: nil,
        error: nil,
    });
    return task_id;
}

/// Thread pool with stable chunk assignment and explicit sizing.
/// Usage:
///   let tp = import("stdlib:thread_pool.sapp");
///   let pool = tp.new();
///   let result = tp.submit(pool, fn() { return heavy_work(); });
///   tp.shutdown(pool);

fn new_thread_pool(nthreads) {
    nthreads = _thread_count(nthreads);
    return map{
        format: "pblang.thread_pool.v2",
        size: nthreads,
        tasks: [],
        results: [],
        running: true,
        next_task_id: 1,
        tasks_completed: 0,
        tasks_failed: 0,
    };
}

// new() — documented zero-argument convenience constructor.
fn new() { return new_thread_pool(nil); }

/// Submit a task to the thread pool.
/// Returns a task ID that can be used to retrieve results.
fn submit(pool, task_fn) {
    return _submit(pool, task_fn, 0);
}

/// Submit a task with priority (higher = more urgent).
fn submit_priority(pool, task_fn, priority) {
    return _submit(pool, task_fn, priority);
}

// Merge a validated numeric run of pending indices. Only the index vector changes;
// task records and callbacks stay in submission order and are never compared.
fn _merge_priority_run(tasks, idxs, scratch, start, finish) {
    let width = 1;
    while width < finish - start {
        let lo = start;
        while lo < finish {
            let mid = num_min(lo + width, finish);
            let hi = num_min(mid + width, finish);
            // Already ordered neighboring runs need no copying or merging.
            if mid < hi and tasks[idxs[mid - 1]].priority < tasks[idxs[mid]].priority {
                let k = lo;
                while k < hi { scratch[k] = idxs[k]; k = k + 1; }
                let left = lo; let right = mid; k = lo;
                while k < hi {
                    if left < mid and (right >= hi or
                        tasks[scratch[left]].priority >= tasks[scratch[right]].priority) {
                        idxs[k] = scratch[left]; left = left + 1;
                    } else {
                        idxs[k] = scratch[right]; right = right + 1;
                    }
                    k = k + 1;
                }
            }
            lo = hi;
        }
        width = width * 2;
    }
}

/// _pending_order(tasks) — indices of pending tasks, highest priority first
/// (stable: equal priorities keep submission order).
fn _pending_order(tasks) {
    let idxs = [];
    let i = 0;
    while i < len(tasks) {
        if tasks[i].status == "pending" { array_push(idxs, i); }
        i = i + 1;
    }
    let count = len(idxs);
    if count > 32 {
        let ordered = true;
        let at = 1;
        while at < count {
            // Use the legacy numeric comparison even when order is already
            // known: NaN must still fail before any task is executed.
            if tasks[idxs[at - 1]].priority < tasks[idxs[at]].priority {
                ordered = false;
            }
            at = at + 1;
        }
        if not ordered {
            let scratch = slice(idxs, 0, count);
            _merge_priority_run(tasks, idxs, scratch, 0, count);
        }
        return idxs;
    }
    // Small queues retain the low-overhead insertion path.
    let a = 1;
    while a < len(idxs) {
        let key = idxs[a];
        let kp = tasks[key].priority;
        let b = a - 1;
        while b >= 0 and tasks[idxs[b]].priority < kp { idxs[b + 1] = idxs[b]; b = b - 1; }
        idxs[b + 1] = key;
        a = a + 1;
    }
    return idxs;
}

/// Execute all pending tasks in the pool (on the current thread), highest
/// priority first. Returns a map with { completed: N, failed: N, results: [...] }
fn run_all(pool) {
    _ensure_running(pool);
    let completed = 0;
    let failed = 0;
    let results = [];

    let order = _pending_order(pool.tasks);
    let oi = 0;
    while oi < len(order) {
        let task = pool.tasks[order[oi]];
        let result = try_catch(fn() {
            return task.fn();
        });
        if result.ok {
            task.status = "done";
            task.result = result.value;
            array_push(results, result.value);
            completed = completed + 1;
            pool.tasks_completed = pool.tasks_completed + 1;
        } else {
            task.status = "failed";
            task.error = result.error;
            failed = failed + 1;
            pool.tasks_failed = pool.tasks_failed + 1;
        }
        array_push(pool.results, task.result);
        oi = oi + 1;
    }

    return map{
        completed: completed,
        failed: failed,
        results: results,
    };
}

/// Try to catch errors in a function.
/// Returns map{ ok: bool, value: any, error: string }
fn try_catch(fn_to_run) {
    let result = map{ ok: false, value: nil, error: "" };
    try {
        result.value = fn_to_run();
        result.ok = true;
    } catch {
        result.error = "task execution failed";
    }
    return result;
}

// Spawn factories close their arguments before crossing the VM-thread wire.
// Creating these closures directly inside a scheduling loop leaves open
// upvalues, which the runtime correctly rejects as non-transferable.
fn _make_chunk_worker(chunk) {
    return fn() {
        let local_results = [];
        let j = 0;
        while j < len(chunk) {
            let task = chunk[j];
            let result = try map{ ok: true, value: task.fn(), error: "" }
                catch map{ ok: false, value: nil, error: "task execution failed" };
            array_push(local_results, map{
                id: task.id, index: task.index, ok: result.ok,
                value: result.value, error: result.error,
            });
            j = j + 1;
        }
        return local_results;
    };
}

fn _make_map_worker(slice, map_fn) {
    return fn() {
        let results = [];
        let k = 0;
        while k < len(slice) { array_push(results, map_fn(slice[k])); k = k + 1; }
        return results;
    };
}

fn _make_for_worker(chunk_start, chunk_end, step, body_fn) {
    return fn() {
        let idx = chunk_start;
        while idx < chunk_end { body_fn(idx); idx = idx + step; }
        return nil;
    };
}

// If a later launch fails, settle every previously started future before the
// error escapes. This waits for effects; it does not cancel or roll them back.
fn _launch_owned(thread_lib, task_fn, handles) {
    let handle = try thread_lib.go(task_fn) catch nil;
    if handle == nil {
        for previous in handles { try thread_lib.await(previous) catch nil; }
        throw "thread_pool: worker could not start";
    }
    array_push(handles, handle);
}

fn _range_integer(value, label) {
    if not is_number(value) or value - value != 0 or value != num_floor(value)
        or value < -9007199254740991 or value > 9007199254740991 {
        throw "thread_pool.parallel_for: " + label + " must be an exact finite integer";
    }
}

fn _make_race_worker(task_fn) {
    return fn() {
        return try map{ ok: true, value: task_fn() }
            catch map{ ok: false, value: nil };
    };
}

/// Execute tasks in parallel using spawn/join.
/// Returns combined results.
fn run_parallel(pool) {
    _ensure_running(pool);
    let order = _pending_order(pool.tasks);
    if len(order) == 0 {
        return map{ completed: 0, failed: 0, results: [] };
    }

    let thread_lib = _thread_backend();
    let pending = [];
    let oi = 0;
    while oi < len(order) {
        let task = pool.tasks[order[oi]];
        array_push(pending, map{ index: order[oi], id: task.id, fn: task.fn });
        oi = oi + 1;
    }
    let chunks = split_tasks(pending, pool.size);

    let handles = [];
    let launch_failed = false;
    let i = 0;
    while i < len(chunks) {
        let chunk = chunks[i];
        let h = try thread_lib.go(_make_chunk_worker(chunk)) catch nil;
        if h == nil { launch_failed = true; break; }
        array_push(handles, h);
        i = i + 1;
    }

    // Worker VMs do not share mutable task maps with the parent. Collect immutable
    // outcomes first, then update every task exactly once in the parent VM.
    let outcomes = map{};
    let k = 0;
    while k < len(handles) {
        let chunk_results = try thread_lib.await(handles[k]) catch nil;
        if chunk_results != nil {
            let m = 0;
            while m < len(chunk_results) {
                outcomes[str(chunk_results[m].id)] = chunk_results[m];
                m = m + 1;
            }
        } else {
            let m = 0;
            while m < len(chunks[k]) {
                let task = chunks[k][m];
                outcomes[str(task.id)] = map{
                    id: task.id, index: task.index, ok: false, value: nil,
                    error: "worker execution failed",
                };
                m = m + 1;
            }
        }
        k = k + 1;
    }

    let all_results = [];
    let completed = 0;
    let failed = 0;
    oi = 0;
    while oi < len(order) {
        let task = pool.tasks[order[oi]];
        let key = str(task.id);
        let outcome = nil;
        if map_has(outcomes, key) { outcome = outcomes[key]; }
        if outcome != nil and outcome.ok {
            task.status = "done";
            task.result = outcome.value;
            task.error = nil;
            array_push(all_results, outcome.value);
            completed = completed + 1;
        } else {
            task.status = "failed";
            task.result = nil;
            if outcome == nil {
                task.error = "missing worker outcome";
                if launch_failed { task.error = "worker could not start"; }
            } else { task.error = outcome.error; }
            failed = failed + 1;
        }
        array_push(pool.results, task.result);
        oi = oi + 1;
    }

    pool.tasks_completed = pool.tasks_completed + completed;
    pool.tasks_failed = pool.tasks_failed + failed;

    return map{
        completed: completed,
        failed: failed,
        results: all_results,
    };
}

/// Split tasks into N chunks for parallel processing.
fn split_tasks(tasks, nchunks) {
    nchunks = _thread_count(nchunks);
    if len(tasks) == 0 { return []; }
    if nchunks > len(tasks) { nchunks = len(tasks); }
    let chunks = [];
    let i = 0;
    while i < nchunks {
        array_push(chunks, []);
        i = i + 1;
    }

    let j = 0;
    while j < len(tasks) {
        let chunk_idx = j % nchunks;
        array_push(chunks[chunk_idx], tasks[j]);
        j = j + 1;
    }

    return chunks;
}

/// Dynamic thread pool sizing based on workload.
/// Adjusts pool.size based on pending task count.
fn auto_size(pool) {
    let pending = 0;
    let i = 0;
    while i < len(pool.tasks) {
        if pool.tasks[i].status == "pending" {
            pending = pending + 1;
        }
        i = i + 1;
    }

    // Scale up with workload, bounded by the module hard limit.
    let optimal = num_ceil(pending / 2);
    if optimal < 1 { optimal = 1; }
    if optimal > MAX_THREADS { optimal = MAX_THREADS; }
    pool.size = optimal;

    return pool.size;
}

/// Shutdown the thread pool (mark as not running).
fn shutdown(pool) {
    pool.running = false;
    return pool;
}

/// Get pool statistics.
fn stats(pool) {
    let pending = 0;
    let done = 0;
    let failed = 0;
    let i = 0;
    while i < len(pool.tasks) {
        if pool.tasks[i].status == "pending" {
            pending = pending + 1;
        } else if pool.tasks[i].status == "done" {
            done = done + 1;
        } else if pool.tasks[i].status == "failed" {
            failed = failed + 1;
        }
        i = i + 1;
    }
    return map{
        size: pool.size,
        pending: pending,
        done: done,
        failed: failed,
        total: len(pool.tasks),
        running: pool.running,
    };
}

// ── Parallel Helpers ──────────────────────────────────────────────────────────

/// Parallel map: apply fn to each element of arr using thread pool.
fn parallel_map(arr, map_fn, nthreads = 4) {
    if not is_array(arr) { throw "thread_pool: map input must be an array"; }
    if not _callable(map_fn) { throw "thread_pool: map function must be callable"; }
    nthreads = _thread_count(nthreads);
    let n = len(arr);
    if n == 0 { return []; }
    if nthreads > n { nthreads = n; }

    let thread_lib = _thread_backend();
    let chunk_size = num_ceil(n / nthreads);

    let handles = [];
    let i = 0;
    while i < nthreads {
        let start = i * chunk_size;
        if start >= n { break; }
        let end_val = start + chunk_size;
        if end_val > n { end_val = n; }

        let slice = [];
        let j = start;
        while j < end_val {
            array_push(slice, arr[j]);
            j = j + 1;
        }

        _launch_owned(thread_lib, _make_map_worker(slice, map_fn), handles);
        i = i + 1;
    }

    let all_results = [];
    let m = 0;
    while m < len(handles) {
        let chunk_results = thread_lib.await(handles[m]);
        if chunk_results != nil {
            let p = 0;
            while p < len(chunk_results) {
                array_push(all_results, chunk_results[p]);
                p = p + 1;
            }
        }
        m = m + 1;
    }

    return all_results;
}

/// Parallel for-each over array range.
fn parallel_for(start, end, step, body_fn, nthreads = 4) {
    _range_integer(start, "start");
    _range_integer(end, "end");
    if step == nil { step = 1; }
    _range_integer(step, "step");
    if step <= 0 { step = 1; }
    if not _callable(body_fn) { throw "thread_pool: body function must be callable"; }
    nthreads = _thread_count(nthreads);
    if end <= start { return nil; }
    if end - start > 9007199254740991 { throw "thread_pool.parallel_for: range is too wide"; }

    let thread_lib = _thread_backend();
    let total = num_ceil((end - start) / step);
    if nthreads > total { nthreads = total; }

    let handles = [];
    let chunk_size = num_ceil(total / nthreads);

    let i = 0;
    while i < nthreads {
        let chunk_start = start + i * chunk_size * step;
        if chunk_start >= end { break; }
        let chunk_end = chunk_start + chunk_size * step;
        if chunk_end > end { chunk_end = end; }

        _launch_owned(thread_lib, _make_for_worker(chunk_start, chunk_end, step, body_fn), handles);
        i = i + 1;
    }

    // Wait for all
    let j = 0;
    while j < len(handles) {
        thread_lib.await(handles[j]);
        j = j + 1;
    }
}

/// Pipeline processing: pass data through N stages, each in parallel.
/// stages is an array of functions: [stage1, stage2, ...]
fn pipeline(data, stages, nthreads = 4) {
    let current = data;
    let i = 0;
    while i < len(stages) {
        current = parallel_map(current, stages[i], nthreads);
        i = i + 1;
    }
    return current;
}

// All tasks/configuration are checked before the first external effect.
fn _race_validate(task_fns, timeout_ms) {
    if not is_array(task_fns) { throw "thread_pool: race tasks must be an array"; }
    if len(task_fns) > MAX_THREADS { throw "thread_pool: race exceeds 64 workers"; }
    if timeout_ms != nil {
        if not is_number(timeout_ms) or timeout_ms - timeout_ms != 0
            or timeout_ms < 0 or timeout_ms > 2147483647
            or timeout_ms != num_floor(timeout_ms) {
            throw "thread_pool: race timeout must be an integer in 0..2147483647";
        }
    }
    for task_fn in task_fns {
        if not _callable(task_fn) { throw "thread_pool: race task must be callable"; }
    }
}

fn _race_select(thread_lib, handles, timeout_ms) {
    let finished = [];
    for i len(handles) { array_push(finished, false); }
    let result = map{ready:false, value:nil, index:nil, status:"empty", handles:handles};
    if len(handles) == 0 { return result; }
    let completed = 0;
    let start = now_ms();
    while true {
        for j len(handles) {
            if not finished[j] {
                // Poll every candidate without serial per-candidate waits.
                let ready = thread_lib.await_timeout(handles[j], 0);
                if ready.ok {
                    finished[j] = true;
                    completed = completed + 1;
                    if ready.value != nil and ready.value.ok {
                        result.ready = true;
                        result.value = ready.value.value;
                        result.index = j;
                        result.status = "ready";
                        return result;
                    }
                }
            }
        }
        if completed == len(handles) { result.status = "failed"; return result; }
        if timeout_ms != nil and now_ms() - start >= timeout_ms {
            result.status = "timeout"; return result;
        }
        sleep_ms(1);
    }
}

// Early return explicitly transfers ownership of every future to the caller.
// Selection is first observed success; failures do not win this legacy race.
fn race_owned(task_fns, timeout_ms = nil) {
    _race_validate(task_fns, timeout_ms);
    let thread_lib = _thread_backend();
    let handles = [];
    for task_fn in task_fns {
        _launch_owned(thread_lib, _make_race_worker(task_fn), handles);
    }
    let result = try _race_select(thread_lib, handles, timeout_ms) catch nil;
    if result == nil {
        for handle in handles { try thread_lib.await(handle) catch nil; }
        throw "thread_pool: race selection failed";
    }
    return result;
}

// Complete owned effects before discarding the result, including after timeout.
// Repeated settlement is safe for valid, unmodified results in the owning VM.
fn settle_race(result) {
    let thread_lib = _thread_backend();
    for handle in result.handles { thread_lib.await(handle); }
    return result;
}

// Value-only convenience waits for loser cleanup, including on timeout. Use
// race_owned for early return and eventually settle_race its returned handle set.
fn race(task_fns, timeout_ms) {
    let result = race_owned(task_fns, timeout_ms);
    settle_race(result);
    return result.value;
}

/// submit_all(pool, fns) — submit many tasks; returns an array of task ids.
fn submit_all(pool, fns) {
    let ids = [];
    let i = 0;
    while i < len(fns) { array_push(ids, submit(pool, fns[i])); i = i + 1; }
    return ids;
}

/// _find_task(pool, id) — the task with the given id, or nil.
fn _find_task(pool, id) {
    let i = 0;
    while i < len(pool.tasks) {
        if pool.tasks[i].id == id { return pool.tasks[i]; }
        i = i + 1;
    }
    return nil;
}

/// get_result(pool, id) — the result of a completed task (nil if absent/unfinished).
fn get_result(pool, id) {
    let t = _find_task(pool, id);
    if t == nil { return nil; }
    return t.result;
}

/// get_status(pool, id) — "pending" | "done" | "failed" (nil if no such task).
fn get_status(pool, id) {
    let t = _find_task(pool, id);
    if t == nil { return nil; }
    return t.status;
}

export new, new_thread_pool, submit, submit_priority, submit_all, run_all, run_parallel,
       auto_size, shutdown, stats, get_result, get_status,
       parallel_map, parallel_for, pipeline, race, race_owned, settle_race, try_catch, split_tasks;
