// Shared Modern UI projection: inspect links through portable actions only.
// Native navigation is explicitly bound by the owning application/session.
let D=import("stdlib:browser_document.sapp");
let UI=import("stdlib:modern_ui.sapp");
fn create(document) {
    let doc=D.inspect(document);let children=[
        UI.text("Offline document • Links inspect destinations; no network access",map{name:"notice"}),
        UI.heading(doc.title,map{name:"page_title",wrap:true,max_lines:2})];
    let index=0;
    for block in doc.blocks {
        let name="block"+str(index);
        if block.tag=="a" {
            push(children,UI.button("Inspect: "+block.text,UI.action_set_text("destination",block.href),map{name:name,accessibility_label:"Inspect local destination: "+block.text}));
        } elif block.tag=="h2" {push(children,UI.heading(block.text,map{name:name,font_size:20,wrap:true,max_lines:4}));}
        else {push(children,UI.text(block.text,map{name:name,wrap:true,max_lines:6}));}
        index=index+1;
    }
    push(children,UI.text("No destination selected",map{name:"destination",wrap:true,max_lines:3}));
    return UI.screen(children);
}
fn plan(document,target="web",width=390,height=844) {
    let bundle=UI.compile(create(document),map{target:target,width:width,height:height});
    return map{bundle:bundle,linked:bundle.executable,target:bundle.target,
        navigation:false,portable_action:"inspect-local-destination",network:false,
        native_permissions:[],fallback:"explicit offline HTML export",device_execution_verified:false};
}
export create,plan;
