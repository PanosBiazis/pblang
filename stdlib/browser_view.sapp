// Shared Modern UI projection: inspect links through portable actions only.
// Native navigation is explicitly bound by the owning application/session.
let D=import("stdlib:browser_document.sapp");
let UI=import("stdlib:modern_ui.sapp");
let Typography=import("stdlib:ui_typography.sapp");
fn appearance(options=nil) {
    let out=map{font_family:"sans",body_size:16,title_size:28,caption_size:12,button_size:15,
        font_scale:1,line_height:1.45,density:"comfortable"};
    if options!=nil {
        if type(options)!="map" {throw "browser appearance requires a map";}
        for key in map_keys(options) {
            if not map_has(out,key) {throw "unknown browser appearance option";}
            out[key]=options[key];
        }
    }
    if out.density!="compact" and out.density!="comfortable" {throw "invalid browser density";}
    if type(out.font_scale)!="number" or not (out.font_scale>=0.75 and out.font_scale<=1.5) {throw "font_scale must be from 0.75 to 1.5";}
    for key in ["body_size","title_size","caption_size","button_size"] {
        let value=out[key];
        if type(value)!="number" or not (value>=12 and value<=40) or value!=num_floor(value) {throw "browser font size must be an integer from 12 to 40";}
    }
    Typography.validate(map{font_family:out.font_family,line_height:out.line_height});
    return out;
}
fn _size(style,key) {return num_floor(style[key]*style.font_scale+0.5);}
fn create(document,options=nil) {
    let style=appearance(options);
    let doc=D.inspect(document);let children=[
        UI.text("Offline document • Links inspect destinations; no network access",map{name:"notice",font_size:_size(style,"caption_size"),tone:"muted",wrap:true,max_lines:2}),
        UI.heading(doc.title,map{name:"page_title",font_size:_size(style,"title_size"),font_weight:"bold",wrap:true,max_lines:3})];
    let index=0;
    for block in doc.blocks {
        let name="block"+str(index);
        if block.tag=="a" {
            push(children,UI.button("Inspect: "+block.text,UI.action_set_text("destination",block.href),map{name:name,font_size:_size(style,"button_size"),variant:"secondary",accessibility_label:"Inspect local destination: "+block.text}));
        } elif block.tag=="h2" {push(children,UI.heading(block.text,map{name:name,font_size:_size(style,"body_size")+4,wrap:true,max_lines:4}));}
        else {push(children,UI.text(block.text,map{name:name,font_size:_size(style,"body_size"),tone:"text",wrap:true,max_lines:8}));}
        index=index+1;
    }
    push(children,UI.text("No destination selected",map{name:"destination",font_size:_size(style,"caption_size"),tone:"muted",wrap:true,max_lines:3}));
    return Typography.apply(UI.screen(children,map{padding:if style.density=="compact" {12} else {24},gap:if style.density=="compact" {8} else {14}}),
        map{font_family:style.font_family,text_spacing:"natural",line_height:style.line_height});
}
fn plan(document,target="web",width=390,height=844) {
    let bundle=UI.compile(create(document),map{target:target,width:width,height:height});
    return map{bundle:bundle,linked:bundle.executable,target:bundle.target,
        navigation:false,portable_action:"inspect-local-destination",network:false,
        native_permissions:[],fallback:"explicit offline HTML export",device_execution_verified:false};
}
export appearance,create,plan;
