// Capability-free admission contract for metadata-derived project ideas.
// It never reads content, paths, devices, credentials, or training data.

let FORMAT="pblang.knowledge-intake.v1";
let ADMISSION_FORMAT="pblang.knowledge-intake.admission.v1";

fn _exact(row,fields) {
    if type(row)!="map" or len(row)!=len(fields) { return false; }
    for field in fields { if not map_has(row,field) { return false; } }
    return true;
}

fn _token(value) {
    return type(value)=="string" and len(value)>=1 and len(value)<=64
        and regex_match(value,"^[a-z0-9][a-z0-9._-]{0,63}$");
}

fn _tokens(values,maximum) {
    if type(values)!="array" or len(values)<1 or len(values)>maximum { return false; }
    let seen=map{};
    for value in values {
        if not _token(value) or map_has(seen,value) { return false; }
        seen[value]=true;
    }
    return true;
}

fn _framed(values) {
    let out=[];
    for value in values {
        let text=str(value); array_push(out,str(len(str_to_bytes(text)))+":"+text);
    }
    return str_join(out,"|");
}

fn _fields() { return ["format","source_id","metadata_sha256","claim_digest_algorithm",
    "claim_sha256","ownership_basis","license_class","consent_confirmed",
    "contains_private_metadata","redaction_verified","metadata_only","categories","destinations"]; }

fn _bounded_claim_shape(row) {
    if not _exact(row,_fields()) or row.format!=FORMAT or not _token(row.source_id) { return false; }
    if type(row.metadata_sha256)!="string" or not regex_match(row.metadata_sha256,"^[0-9a-f]{64}$")
       or row.claim_digest_algorithm!="sha256-length-framed-knowledge-claims-v1"
       or type(row.claim_sha256)!="string" or len(row.claim_sha256)>64 { return false; }
    if row.ownership_basis!="operator-owned" and row.ownership_basis!="explicitly-authorized"
       and row.ownership_basis!="public-metadata" { return false; }
    if row.license_class!="private-reference" and row.license_class!="permissive"
       and row.license_class!="public-domain" and row.license_class!="review-required" { return false; }
    if type(row.consent_confirmed)!="bool" or type(row.contains_private_metadata)!="bool"
       or type(row.redaction_verified)!="bool" or type(row.metadata_only)!="bool" { return false; }
    return _tokens(row.categories,16) and _tokens(row.destinations,16);
}

fn claim_digest(row) {
    if not _bounded_claim_shape(row) { return ""; }
    return sha256(_framed(["knowledge-intake-claims-v1",try row.source_id catch "",
        try row.metadata_sha256 catch "",try row.claim_digest_algorithm catch "",
        try row.ownership_basis catch "",
        try row.license_class catch "",try row.consent_confirmed catch false,
        try row.contains_private_metadata catch false,try row.redaction_verified catch false,
        try row.metadata_only catch false,_framed(try row.categories catch []),
        _framed(try row.destinations catch [])]));
}

fn validate(row) {
    if not _exact(row,_fields()) { return map{ok:false,error:"exact-schema-required"}; }
    if row.format!=FORMAT { return map{ok:false,error:"format-mismatch"}; }
    if not _token(row.source_id) { return map{ok:false,error:"invalid-source-id"}; }
    if type(row.metadata_sha256)!="string" or not regex_match(row.metadata_sha256,"^[0-9a-f]{64}$") {
        return map{ok:false,error:"invalid-metadata-digest"};
    }
    if row.ownership_basis!="operator-owned" and row.ownership_basis!="explicitly-authorized"
       and row.ownership_basis!="public-metadata" {
        return map{ok:false,error:"unsupported-ownership-basis"};
    }
    if row.license_class!="private-reference" and row.license_class!="permissive"
       and row.license_class!="public-domain" and row.license_class!="review-required" {
        return map{ok:false,error:"unsupported-license-class"};
    }
    if type(row.consent_confirmed)!="bool" or type(row.contains_private_metadata)!="bool"
       or type(row.redaction_verified)!="bool" or type(row.metadata_only)!="bool" {
        return map{ok:false,error:"invalid-policy-boolean"};
    }
    if not _tokens(row.categories,16) or not _tokens(row.destinations,16) {
        return map{ok:false,error:"invalid-categories-or-destinations"};
    }
    if row.claim_digest_algorithm!="sha256-length-framed-knowledge-claims-v1"
       or type(row.claim_sha256)!="string" or not regex_match(row.claim_sha256,"^[0-9a-f]{64}$")
       or row.claim_sha256!=claim_digest(row) {
        return map{ok:false,error:"claim-digest-mismatch"};
    }
    return map{ok:true};
}

fn admit(row) {
    let checked=validate(row);
    if not checked.ok { return map{ok:false,format:ADMISSION_FORMAT,error:checked.error,
        content_ingest_allowed:false,training_allowed:false,repository_creation_allowed:false,
        safe_to_log:false,caller_metadata_returned:false}; }
    let allowed=row.consent_confirmed and row.metadata_only
        and (not row.contains_private_metadata or row.redaction_verified)
        and row.license_class!="review-required";
    if not allowed { return map{ok:false,format:ADMISSION_FORMAT,error:"provenance-or-privacy-review-required",
        content_ingest_allowed:false,training_allowed:false,repository_creation_allowed:false,
        safe_to_log:false,caller_metadata_returned:false}; }
    return map{ok:true,format:ADMISSION_FORMAT,
        schema_eligible_for_review:true,idea_routing_allowed:false,
        content_ingest_allowed:false,training_allowed:false,
        repository_creation_allowed:false,caller_metadata_returned:false,safe_to_log:false,
        independent_provenance_verified:false,
        policy:"claim digest binds caller assertions, but independent provenance review is still required before routing, content use, training, or repository creation"};
}

export FORMAT, ADMISSION_FORMAT, claim_digest, validate, admit;
