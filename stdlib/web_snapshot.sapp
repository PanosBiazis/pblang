// Script-free native web snapshots from the bounded PBLang browser page model.

let BROWSER = import("stdlib:browser.sapp");
let RASTER = import("stdlib:raster_png.sapp");

fn _integer(value, fallback, minimum, maximum, name) {
    if value == nil { return fallback; }
    if type(value) != "number" or value != num_floor(value) or value < minimum or value > maximum {
        throw "web_snapshot: " + name + " must be an integer in " + str(minimum) + ".." + str(maximum);
    }
    return value;
}

fn _accent(kind) {
    if kind == "title" or kind == "h1" { return [32,113,189]; }
    if kind == "h2" { return [18,145,111]; }
    if kind == "link" { return [109,78,180]; }
    if kind == "form" { return [183,105,31]; }
    if kind == "img" { return [177,62,98]; }
    return [120,132,148];
}

fn render_html(url, html, options = nil) {
    if options == nil { options = map{}; }
    if type(url) != "string" or len(url) < 1 or len(url) > 4096 { throw "web_snapshot: bounded URL is required"; }
    if type(html) != "string" or len(str_to_bytes(html)) > 1048576 { throw "web_snapshot: HTML exceeds one MiB"; }
    let width = _integer(try options.width catch nil, 960, 320, 1600, "width");
    let height = _integer(try options.height catch nil, 600, 200, 1200, "height");
    if width * height > RASTER.MAX_PIXELS { throw "web_snapshot: pixel count exceeds the raster bound"; }
    let scale = if width < 600 { 1 } else { 2 };
    let content_width = width - 32; let char_px = 6 * scale;
    let columns = num_floor((content_width - 24) / char_px);
    let page = BROWSER.fetch_page_from_html(url, html);
    let layout = BROWSER.page_layout(page, columns);
    let surface = RASTER.create(width, height, [245,247,250]);
    RASTER.fill_rect(surface, 0, 0, width, 48, [24,32,45]);
    RASTER.draw_text(surface, 16, 10, "PBLANG WEB SNAPSHOT", [241,245,249], 2);
    let displayed_url = url; if len(displayed_url) > columns { displayed_url = str_slice(displayed_url, 0, columns); }
    RASTER.draw_text(surface, 16, 34, displayed_url, [174,188,205], 1);
    let line_height = 9 * scale; let boxes = layout.boxes; let rendered = 0;
    for i len(boxes) {
        let box = boxes[i]; let y = 58 + box.y * line_height;
        let box_height = box.h * line_height;
        if y >= height - 8 { break; }
        let visible_height = if y + box_height > height - 8 { height - 8 - y } else { box_height };
        RASTER.fill_rect(surface, 16, y, content_width, visible_height, [255,255,255]);
        RASTER.fill_rect(surface, 16, y, 4, visible_height, _accent(box.kind));
        RASTER.stroke_rect(surface, 16, y, content_width, visible_height, [220,225,232], 1);
        let ty = y + 6; let lines = box.lines;
        for li len(lines) {
            if ty + 7 * scale > y + visible_height { break; }
            let line = lines[li];
            RASTER.draw_text(surface, 28, ty, line, [36,45,59], scale);
            ty = ty + line_height;
        }
        rendered = rendered + 1;
    }
    let png = RASTER.encode(surface);
    return map{ ok: true, format: "pblang.web-snapshot.v1", png: png,
        width: width, height: height, artifact_bytes: len(png),
        renderer: "pblang-native-flow-png", rendered_boxes: rendered,
        source_boxes: layout.box_count, source_bytes: len(str_to_bytes(html)),
        scripts_executed: false, subresources_fetched: false, css_dom_pixel_parity: false };
}

export render_html;
