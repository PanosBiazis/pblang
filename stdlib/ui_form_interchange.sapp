// UI/Form Interchange registry shared by PBLang, PBIDE and UI-bearing AAP
// products. Recognizing a format never upgrades its evidence status.

let FORMAT = "pblang.ui-form-interchange.v1";
let MAX_SOURCE_CHARS = 1048576;

fn _has(values, expected) {
    if type(values) != "array" { return false; }
    for value in values { if value == expected { return true; } }
    return false;
}

fn _bounded(value, name, maximum) {
    if type(value) != "string" or value == "" or len(value) > maximum {
        throw "ui_form_interchange: " + name + " must contain 1.." + str(maximum) + " characters";
    }
    return value;
}

fn _status(value) {
    let selected = str(value);
    if not _has(["contract", "preview", "implemented", "tested", "release"], selected) {
        throw "ui_form_interchange: invalid adapter status";
    }
    return selected;
}

fn _rank(status) {
    let levels = map{contract:0, preview:1, implemented:2, tested:3, release:4};
    return try levels[status] catch 0;
}

fn _copy_texts(values, name, maximum) {
    if type(values) != "array" or len(values) > maximum { throw "ui_form_interchange: invalid " + name; }
    let out = [];
    for value in values {
        let text = _bounded(value, name + " item", 96);
        if not _has(out, text) { array_push(out, text); }
    }
    return out;
}

fn adapter(id, family, syntax, extensions, importer, exporter, previewer, options = nil) {
    if options == nil { options = map{}; }
    if type(options) != "map" { throw "ui_form_interchange: adapter options must be a map"; }
    let import_status = _status(importer);
    let export_status = _status(exporter);
    let preview_status = _status(previewer);
    return map{
        format:"pblang.ui-form-adapter.v1", id:_bounded(id, "adapter id", 64),
        family:_bounded(family, "adapter family", 64), syntax:_bounded(syntax, "adapter syntax", 64),
        extensions:_copy_texts(extensions, "extensions", 16), import_status:import_status,
        export_status:export_status, preview_status:preview_status,
        project_scope:try options.project_scope catch "form",
        requires_external_sdk:try options.requires_external_sdk catch false,
        preserves_unknown_properties:try options.preserves_unknown_properties catch false,
        allows_embedded_code:false, direct_effects:false, canonical_model:"pblang.ui-document.v1",
        evidence:_copy_texts(try options.evidence catch [], "evidence", 32),
        roundtrip_tested:_rank(import_status) >= 3 and _rank(export_status) >= 3
    };
}

fn catalog() {
    return [
        adapter("pblang-gui", "pblang", "pblang-source", [".sapp", ".sap"], "tested", "tested", "tested", map{evidence:["gui-parse-strict-tests", "pbide-designer-codegen-tests"]}),
        adapter("pblang-modern-ui", "pblang", "pblang-source", [".sapp", ".sap"], "preview", "preview", "preview", map{evidence:["renderer-neutral-compile-tests"]}),
        adapter("delphi-dfm", "delphi", "dfm-text-or-binary", [".dfm"], "contract", "contract", "contract"),
        adapter("delphi-fmx", "delphi", "fmx", [".fmx"], "contract", "contract", "contract"),
        adapter("generic-xml", "xml", "xml", [".xml"], "contract", "contract", "contract"),
        adapter("android-xml", "android", "xml", [".xml"], "contract", "contract", "contract", map{requires_external_sdk:true}),
        adapter("kotlin-compose", "android", "kotlin", [".kt", ".kts"], "contract", "contract", "contract", map{requires_external_sdk:true}),
        adapter("android-java", "android", "java", [".java"], "contract", "contract", "contract", map{requires_external_sdk:true}),
        adapter("qt-ui", "qt", "xml", [".ui"], "contract", "contract", "contract", map{requires_external_sdk:true}),
        adapter("qt-qml", "qt", "qml", [".qml"], "contract", "contract", "contract", map{requires_external_sdk:true}),
        adapter("unreal-umg", "unreal-engine", "engine-asset", [".uasset"], "contract", "contract", "contract", map{project_scope:"engine-project",requires_external_sdk:true}),
        adapter("godot-scene", "godot", "tscn", [".tscn", ".scn"], "contract", "contract", "contract", map{project_scope:"engine-project",requires_external_sdk:true}),
        adapter("unity-ui-toolkit", "unity", "uxml-uss", [".uxml", ".uss"], "contract", "contract", "contract", map{project_scope:"engine-project",requires_external_sdk:true}),
        adapter("swiftui", "apple", "swift", [".swift"], "contract", "contract", "contract", map{requires_external_sdk:true}),
        adapter("apple-storyboard", "apple", "xml", [".storyboard"], "contract", "contract", "contract", map{requires_external_sdk:true}),
        adapter("apple-xib", "apple", "xml", [".xib"], "contract", "contract", "contract", map{requires_external_sdk:true}),
        adapter("web-form", "web", "html-css-js", [".html", ".htm", ".css", ".js", ".ts"], "contract", "contract", "contract"),
        adapter("web-template", "web", "template", [".hbs", ".mustache", ".njk", ".twig", ".liquid"], "contract", "contract", "contract"),
        adapter("xaml", "dotnet", "xml", [".xaml"], "contract", "contract", "contract", map{requires_external_sdk:true}),
        adapter("flutter-widget", "flutter", "dart", [".dart"], "contract", "contract", "contract", map{requires_external_sdk:true})
    ];
}

fn get(id) {
    let selected = str_lower(str(id));
    for item in catalog() { if item.id == selected { return item; } }
    return nil;
}

fn _ends_with(text, suffix) {
    if len(suffix) > len(text) { return false; }
    return str_slice(text, len(text) - len(suffix), len(text)) == suffix;
}

fn detect(path, source = "") {
    if type(path) != "string" or len(path) > 4096 { return map{ok:false,error:"invalid path"}; }
    if type(source) != "string" or len(source) > MAX_SOURCE_CHARS { return map{ok:false,error:"source exceeds limit"}; }
    let lower = str_lower(path); let matches = [];
    for item in catalog() {
        for extension in item.extensions {
            if _ends_with(lower, extension) and not _has(matches, item.id) { array_push(matches, item.id); }
        }
    }
    let sample_end = len(source); if sample_end > 8192 { sample_end = 8192; }
    let sample = str_lower(str_slice(source, 0, sample_end));
    if _ends_with(lower, ".xml") {
        if str_contains(sample, "xmlns:android") or str_contains(sample, "android:")
            or str_contains(sample, "<androidx.") { matches = ["android-xml"]; }
        else { matches = ["generic-xml"]; }
    }
    if _ends_with(lower, ".sapp") or _ends_with(lower, ".sap") {
        if str_contains(sample, "modern_ui") or str_contains(sample, "ui.screen") { matches = ["pblang-modern-ui"]; }
        else if str_contains(sample, "gui.form") or str_contains(sample, "gui.button") { matches = ["pblang-gui"]; }
    }
    return map{ok:len(matches) > 0,format:FORMAT,path:path,candidates:matches,
        selected:if len(matches) == 1 { matches[0] } else { nil }};
}

fn conversion_plan(from_id, to_id) {
    let source = get(from_id); let target = get(to_id);
    if source == nil or target == nil { return map{ok:false,error:"unknown UI form adapter"}; }
    let import_ready = _rank(source.import_status) >= 2;
    let export_ready = _rank(target.export_status) >= 2;
    let executable = import_ready and export_ready;
    let blockers = [];
    if not import_ready { array_push(blockers, source.id + ": importer status=" + source.import_status); }
    if not export_ready { array_push(blockers, target.id + ": exporter status=" + target.export_status); }
    if source.project_scope == "engine-project" or target.project_scope == "engine-project" {
        array_push(blockers, "engine project conversion requires an isolated SDK adapter and project-level evidence");
        executable = false;
    }
    return map{ok:true,format:"pblang.ui-form-conversion-plan.v1",from:source.id,to:target.id,
        canonical_model:"pblang.ui-document.v1",executable:executable,blockers:blockers,
        embedded_code:false,effects:false,preserves_source:true,atomic_destination:true};
}

fn status() {
    let rows = catalog(); let tested = 0; let preview = 0; let contract_only = 0;
    for item in rows {
        if item.roundtrip_tested { tested = tested + 1; }
        else if _rank(item.import_status) >= 1 or _rank(item.export_status) >= 1 { preview = preview + 1; }
        else { contract_only = contract_only + 1; }
    }
    return map{ok:true,format:FORMAT,adapters:rows,adapter_count:len(rows),roundtrip_tested:tested,
        preview:preview,contract_only:contract_only,canonical_model:"pblang.ui-document.v1",
        production_ready:contract_only == 0};
}

export FORMAT, MAX_SOURCE_CHARS;
export adapter, catalog, get, detect, conversion_plan, status;
