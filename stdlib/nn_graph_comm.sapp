// stdlib/nn_graph_comm.sapp — communication channels between nn_graph nodes.
// Nodes can talk three ways:
//   * WIRED   — a signal travels along their bonds, scaled by combined bond strength.
//   * WIRELESS— a node broadcasts on a channel; every node tuned to that channel hears it,
//               with no bond required (radio-style).
//   * QUANTUM — two nodes are entangled; measuring (collapsing) one instantly fixes the
//               other's value (correlated "same" or anticorrelated "anti").
//
//   let c = import("stdlib:nn_graph_comm.sapp");
//   c.transmit(g, 0, 1, sig);                 // wired
//   c.tune(g, 1, "A"); c.broadcast(g, 0, v);  // wireless (0 must also be tuned "A")
//   c.entangle(g, 0, 3, "same"); c.collapse(g, 0, 1);  // quantum

// ── WIRED ─────────────────────────────────────────────────────────────────────────
// transmit(g, from, to, value) — the signal arriving at `to` = value × Σ(parallel bond
// weights from→to). Zero when no bond connects them.
fn transmit(g, from, to, value) {
    let s = 0;
    let i = 0;
    while i < len(g.bonds) { if g.bonds[i].from == from and g.bonds[i].to == to { s = s + g.bonds[i].weight; } i = i + 1; }
    return value * s;
}

// ── WIRELESS ────────────────────────────────────────────────────────────────────────
fn tune(g, id, channel) { g.nodes[id].channel = channel; return g; }
fn channel_of(g, id) { return try g.nodes[id].channel catch nil; }

// broadcast(g, src, value) — src emits on its channel; every OTHER node on the same
// channel accumulates `value` in its inbox. Returns the list of receiver ids.
fn broadcast(g, src, value) {
    let ch = try g.nodes[src].channel catch nil;
    let receivers = [];
    if ch == nil { return receivers; }
    let i = 0;
    while i < len(g.nodes) {
        if i != src and (try g.nodes[i].channel catch nil) == ch {
            g.nodes[i].recv = (try g.nodes[i].recv catch 0) + value;
            array_push(receivers, i);
        }
        i = i + 1;
    }
    return receivers;
}
fn received(g, id) { return try g.nodes[id].recv catch 0; }
fn clear_received(g, id) { g.nodes[id].recv = 0; return g; }

// ── QUANTUM ─────────────────────────────────────────────────────────────────────────
// entangle(g, a, b, mode) — link two nodes. mode "same" (correlated) or "anti".
fn entangle(g, a, b, mode) {
    if not map_has(g, "entanglements") { g.entanglements = []; }
    array_push(g.entanglements, map{ a: a, b: b, mode: mode });
    return g;
}
// entangled_with(g, id) — the partners of `id` as [{id, mode}].
fn entangled_with(g, id) {
    let out = [];
    if not map_has(g, "entanglements") { return out; }
    let i = 0;
    while i < len(g.entanglements) {
        let e = g.entanglements[i];
        if e.a == id { array_push(out, map{ id: e.b, mode: e.mode }); }
        if e.b == id { array_push(out, map{ id: e.a, mode: e.mode }); }
        i = i + 1;
    }
    return out;
}
// collapse(g, id, value) — measure node `id` to `value`; entangled partners snap to the
// correlated value instantly (same→value, anti→−value). Returns the affected partner ids.
fn collapse(g, id, value) {
    g.nodes[id].value = value;
    let partners = entangled_with(g, id);
    let out = [];
    let i = 0;
    while i < len(partners) {
        let p = partners[i];
        let v = value;
        if p.mode == "anti" { v = 0 - value; }
        g.nodes[p.id].value = v;
        array_push(out, p.id);
        i = i + 1;
    }
    return out;
}
fn node_value(g, id) { return try g.nodes[id].value catch 0; }

export transmit, tune, channel_of, broadcast, received, clear_received;
export entangle, entangled_with, collapse, node_value;
