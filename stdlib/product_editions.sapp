// Versioned, PBLang-only product-edition contracts shared by every AAP product.
// This module describes evidence; it never invents an implementation or performs
// network, filesystem, process, signing, publication, or platform effects.

let FORMAT = "pblang.product-editions.v1";
let Forms = import("stdlib:ui_form_interchange.sapp");
let MAX_SURFACES = 32;
let MAX_CAPABILITIES = 256;

fn _has(xs, value) {
    if type(xs) != "array" { return false; }
    for item in xs { if str(item) == str(value) { return true; } }
    return false;
}

fn _bounded_text(value, name, limit) {
    if type(value) != "string" or value == "" or len(value) > limit {
        throw "product_editions: " + name + " must contain 1.." + str(limit) + " characters";
    }
    return value;
}

fn _status(value) {
    let status = str(value);
    if not _has(["contract", "preview", "implemented", "tested", "release"], status) {
        throw "product_editions: status must be contract/preview/implemented/tested/release";
    }
    return status;
}

fn _copy_texts(values, name, limit) {
    if type(values) != "array" or len(values) > limit {
        throw "product_editions: invalid " + name;
    }
    let out = [];
    for value in values {
        let text = _bounded_text(value, name + " item", 128);
        if not _has(out, text) { array_push(out, text); }
    }
    return out;
}

fn _boolean_option(options, name, fallback = false) {
    let value = try options[name] catch fallback;
    if type(value) != "bool" { throw "product_editions: " + name + " must be boolean"; }
    return value;
}

fn surface(name, source_language, targets, status, capabilities, options = nil) {
    if options == nil { options = map{}; }
    if type(options) != "map" { throw "product_editions: surface options must be a map"; }
    let level = _status(status);
    let evidence = try options.evidence catch [];
    let digest_bound = _boolean_option(options, "artifact_digest_bound");
    let signed = _boolean_option(options, "signed_artifact");
    let physical = _boolean_option(options, "physical_platform_evidence");
    return map{
        format:"pblang.product-surface.v1",
        name:_bounded_text(name, "surface name", 64),
        source_language:_bounded_text(source_language, "source language", 64),
        targets:_copy_texts(targets, "targets", 32),
        status:level,
        capabilities:_copy_texts(capabilities, "capabilities", MAX_CAPABILITIES),
        evidence:_copy_texts(evidence, "evidence", 64),
        artifact_digest_bound:digest_bound, signed_artifact:signed,
        physical_platform_evidence:physical,
        production_ready:level == "release" and digest_bound and signed and physical
    };
}

fn contract(product, version, release_channel, built_with_pblang, surfaces) {
    if type(surfaces) != "array" or len(surfaces) == 0 or len(surfaces) > MAX_SURFACES {
        throw "product_editions: surfaces must contain 1.." + str(MAX_SURFACES) + " entries";
    }
    let names = map{};
    for item in surfaces {
        if (try item.format catch "") != "pblang.product-surface.v1" {
            throw "product_editions: invalid surface record";
        }
        if map_has(names, item.name) { throw "product_editions: duplicate surface " + item.name; }
        names[item.name] = true;
    }
    return map{
        ok:true, format:FORMAT,
        product:_bounded_text(product, "product", 128),
        application_version:_bounded_text(version, "application version", 64),
        release_channel:_bounded_text(release_channel, "release channel", 48),
        built_with_pblang:_bounded_text(built_with_pblang, "built_with_pblang", 64),
        version_is_independent:true,
        canonical_language:"pblang",
        surfaces:surfaces,
        surface_count:len(surfaces)
    };
}

fn polyglot_edition(name, status = "contract") {
    let catalog = map{
        delphi:["object-pascal", "vcl-fmx", "windows", "macos", "android", "ios"],
        qt:["cpp-qml", "qt", "linux", "windows", "macos", "android", "ios"],
        web:["html-css-javascript", "web-standards", "browser", "pwa"],
        react:["typescript", "react", "browser", "pwa"],
        vue:["typescript", "vue", "browser", "pwa"],
        svelte:["typescript", "svelte", "browser", "pwa"],
        angular:["typescript", "angular", "browser", "pwa"],
        electron:["typescript", "electron", "linux", "windows", "macos"],
        maui:["csharp-xaml", "dotnet-maui", "windows", "macos", "android", "ios"],
        flutter:["dart", "flutter", "linux", "windows", "macos", "android", "ios", "web"]
    };
    let key = str_lower(str(name));
    if not map_has(catalog, key) { return map{ok:false, error:"unknown polyglot edition"}; }
    let row = catalog[key];
    let targets = []; let i = 2;
    while i < len(row) { array_push(targets, row[i]); i = i + 1; }
    let form_ids = polyglot_form_formats(key);
    return map{
        ok:true, format:"pblang.polyglot-edition.v1", name:key,
        language:row[0], toolkit:row[1], targets:targets, status:_status(status),
        canonical_business_logic:"pblang", separate_artifact:true,
        direct_storage:false, raw_secrets:false, unrestricted_ffi:false,
        requires_contract_tests:true, requires_own_lock:true, requires_sbom:true,
        ui_form_formats:form_ids, ui_form_interchange:"pblang.ui-document.v1",
        production_ready:false
    };
}

fn polyglot_form_formats(name) {
    let formats = map{
        delphi:["delphi-dfm", "delphi-fmx"],
        qt:["qt-ui", "qt-qml"],
        web:["web-form", "web-template"],
        react:["web-form", "web-template"], vue:["web-form", "web-template"],
        svelte:["web-form", "web-template"], angular:["web-form", "web-template"],
        electron:["web-form", "web-template"], maui:["xaml"], flutter:["flutter-widget"]
    };
    let selected = try formats[str_lower(str(name))] catch [];
    let out = [];
    for id in selected {
        if Forms.get(id) != nil { array_push(out, id); }
    }
    return out;
}

fn polyglot_catalog(statuses = nil) {
    if statuses == nil { statuses = map{}; }
    if type(statuses) != "map" { throw "product_editions: polyglot statuses must be a map"; }
    let out = [];
    for name in ["delphi", "qt", "web", "react", "vue", "svelte", "angular", "electron", "maui", "flutter"] {
        array_push(out, polyglot_edition(name, try statuses[name] catch "contract"));
    }
    return out;
}

fn parity_subset(product_contract, surface_names, required_capabilities) {
    if (try product_contract.format catch "") != FORMAT {
        throw "product_editions: invalid product contract";
    }
    let required = _copy_texts(required_capabilities, "required capabilities", MAX_CAPABILITIES);
    let rows = []; let complete = true;
    let selected = _copy_texts(surface_names, "surface names", MAX_SURFACES);
    let matched = 0;
    for item in product_contract.surfaces {
        if len(selected) > 0 and not _has(selected, item.name) { continue; }
        matched = matched + 1;
        let missing = [];
        for capability in required {
            if not _has(item.capabilities, capability) { array_push(missing, capability); }
        }
        let active = item.status != "contract";
        let implemented = item.status == "implemented" or item.status == "tested" or item.status == "release";
        if active and len(missing) > 0 { complete = false; }
        array_push(rows, map{surface:item.name, status:item.status, active:active, implemented:implemented,
            missing:missing, parity:active and len(missing) == 0});
    }
    if len(selected) > 0 and matched != len(selected) { complete = false; }
    return map{ok:true, format:"pblang.product-parity.v1", product:product_contract.product,
        required:required, requested_surfaces:selected, matched_surfaces:matched,
        rows:rows, complete:complete};
}

fn parity(product_contract, required_capabilities) {
    return parity_subset(product_contract, [], required_capabilities);
}

fn release_gate(product_contract) {
    let blockers = [];
    for item in product_contract.surfaces {
        if item.status == "release" and not item.production_ready {
            array_push(blockers, item.name + ": release label lacks digest, signing, or physical evidence");
        }
        if item.status != "release" { array_push(blockers, item.name + ": status=" + item.status); }
    }
    return map{ok:len(blockers) == 0, format:"pblang.product-editions.release-gate.v1",
        product:product_contract.product, blockers:blockers, production_ready:len(blockers) == 0};
}

export FORMAT, MAX_SURFACES, MAX_CAPABILITIES;
export surface, contract, polyglot_edition, polyglot_catalog, polyglot_form_formats;
export parity, parity_subset, release_gate;
