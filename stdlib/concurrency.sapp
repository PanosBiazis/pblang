// Concurrency Builtins for pblang
// Enhanced thread-safe primitives similar to Go, Rust, and Kotlin

// Thread pool operations
pub fn thread_pool_create(size) -> number {
    let vm = get_vm();
    let pool = ThreadPool::new(size)
        .map_err(|e| runtime_error("thread_pool_create", e));

    if pool.is_ok() {
        vm.thread_pool = Some(pool.unwrap());
        1 // Success
    } else {
        0 // Failure
    }
}

pub fn thread_pool_execute(task) -> number {
    let vm = get_vm();
    if let Some(pool) = &vm.thread_pool {
        pool.execute(move || {
            // Execute the task function
        })
        .map_err(|e| runtime_error("thread_pool_execute", e))
        .map(|_| Value::Number(1))
    } else {
        runtime_error("thread_pool_execute", "No thread pool available")
    }
}

pub fn thread_pool_shutdown() -> number {
    let vm = get_vm();
    if let Some(pool) = &vm.thread_pool {
        pool.shutdown()
            .map_err(|e| runtime_error("thread_pool_shutdown", e))
            .map(|_| Value::Number(1))
    } else {
        runtime_error("thread_pool_shutdown", "No thread pool available")
    }
}

// Shared value operations
pub fn shared_create(value) -> number {
    let vm = get_vm();
    let shared = SharedValue::new(value);
    let id = vm.next_shared_id;
    vm.next_shared_id += 1;
    vm.shared_values.insert(id, shared);
    id as number
}

pub fn shared_get(handle) -> value {
    let vm = get_vm();
    if let Some(shared) = vm.shared_values.get(&(handle as usize)) {
        shared.read().map_err(|e| runtime_error("shared_get", e))
    } else {
        runtime_error("shared_get", "Invalid shared handle")
    }
}

pub fn shared_set(handle, new_value) -> number {
    let vm = get_vm();
    if let Some(shared) = vm.shared_values.get(&(handle as usize)) {
        shared.write(new_value).map_err(|e| runtime_error("shared_set", e))
    } else {
        runtime_error("shared_set", "Invalid shared handle")
    }
}

pub fn shared_clone(handle) -> number {
    let vm = get_vm();
    if let Some(shared) = vm.shared_values.get(&(handle as usize)) {
        let cloned = shared.clone_ref();
        let new_id = vm.next_shared_id;
        vm.next_shared_id += 1;
        vm.shared_values.insert(new_id, cloned);
        new_id as number
    } else {
        runtime_error("shared_clone", "Invalid shared handle")
    }
}

// Channel operations
pub fn channel_create(capacity) -> number {
    let vm = get_vm();
    let channel = SafeChannel::new(if capacity > 0 { Some(capacity) } else { None });
    let id = vm.next_channel_id;
    vm.next_channel_id += 1;
    vm.channels.insert(id, channel);
    id as number
}

pub fn channel_unbounded() -> number {
    let vm = get_vm();
    let channel = SafeChannel::new(None);
    let id = vm.next_channel_id_id;
    vm.next_channel_id_id += 1;
    vm.channels.insert(id, channel);
    id as number
}

pub fn channel_send(handle, value, timeout_ms) -> number {
    let vm = get_vm();
    if let Some(channel) = vm.channels.get(&(handle as usize)) {
        let timeout = if timeout_ms >= 0 {
            Some(Duration::from_millis(timeout_ms as u64))
        } else {
            None
        };

        channel.send(value, timeout)
            .map_err(|e| runtime_error("channel_send", e))
            .map(|_| Value::Number(1))
    } else {
        runtime_error("channel_send", "Invalid channel handle")
    }
}

pub fn channel_recv(handle, timeout_ms) -> value {
    let vm = get_vm();
    if let Some(channel) = vm.channels.get(&(handle as usize)) {
        let timeout = if timeout_ms >= 0 {
            Some(Duration::from_millis(timeout_ms as u64))
        } else {
            None
        };

        channel.recv(timeout)
            .map_err(|e| runtime_error("channel_recv", e))
    } else {
        runtime_error("channel_recv", "Invalid channel handle")
    }
}

pub fn channel_try_send(handle, value) -> number {
    let vm = get_vm();
    if let Some(channel) = vm.channels.get(&(handle as usize)) {
        channel.try_send(value)
            .map_err(|e| runtime_error("channel_try_send", e))
            .map(|_| Value::Number(1))
    } else {
        runtime_error("channel_try_send", "Invalid channel handle")
    }
}

pub fn channel_try_recv(handle) -> value {
    let vm = get_vm();
    if let Some(channel) = vm.channels.get(&(handle as usize)) {
        channel.try_recv()
            .map_err(|e| runtime_error("channel_try_recv", e))
    } else {
        runtime_error("channel_try_recv", "Invalid channel handle")
    }
}

pub fn channel_close(handle) -> number {
    let vm = get_vm();
    if let Some(channel) = vm.channels.get(&(handle as usize)) {
        channel.close()
            .map_err(|e| runtime_error("channel_close", e))
            .map(|_| Value::Number(1))
    } else {
        runtime_error("channel_close", "Invalid channel handle")
    }
}

pub fn channel_is_closed(handle) -> bool {
    let vm = get_vm();
    if let Some(channel) = vm.channels.get(&(handle as usize)) {
        channel.is_closed()
    } else {
        true
    }
}

pub fn channel_len(handle) -> number {
    let vm = get_vm();
    if let Some(channel) = vm.channels.get(&(handle as usize)) {
        len(channel).map_err(|e| runtime_error("channel_len", e))
            .map(|_| Value::Number(len as f64))
    } else {
        runtime_error("channel_len", "Invalid channel handle")
    }
}

// Mutex operations
pub fn mutex_create(initial_value, timeout_ms) -> number {
    let vm = get_vm();
    let timeout = Duration::from_millis(timeout_ms as u64);
    let mutex = SafeMutex::new(initial_value, timeout);
    let id = vm.next_mutex_id;
    vm.next_mutex_id += 1;
    vm.mutexes.insert(id, mutex);
    id as number
}

pub fn mutex_lock(handle, timeout_ms) -> number {
    let vm = get_vm();
    if let Some(mutex) = vm.mutexes.get(&(handle as usize)) {
        let timeout = Duration::from_millis(timeout_ms as u64);
        mutex.lock()
            .map_err(|e| runtime_error("mutex_lock", e))
            .map(|_| Value::Number(1))
    } else {
        runtime_error("mutex_lock", "Invalid mutex handle")
    }
}

pub fn mutex_try_lock(handle) -> number {
    let vm = get_vm();
    if let Some(mutex) = vm.mutexes.get(&(handle as usize)) {
        mutex.try_lock()
            .map_err(|e| runtime_error("mutex_try_lock", e))
            .map(|_| Value::Number(1))
    } else {
        runtime_error("mutex_try_lock", "Invalid mutex handle")
    }
}

pub fn mutex_unlock(handle) -> number {
    let vm = get_vm();
    // Mutex lock is automatically released when guard goes out of scope
    Value::Number(1)
}

// Read-write lock operations
pub fn rwlock_create(initial_value, timeout_ms) -> number {
    let vm = get_vm();
    let timeout = Duration::from_millis(timeout_ms as u64);
    let rwlock = SafeRwLock::new(initial_value, timeout);
    let id = vm.next_rwlock_id;
    vm.next_rwlock_id += 1;
    vm.rwlocks.insert(id, rwlock);
    id as number
}

pub fn rwlock_read_lock(handle, timeout_ms) -> number {
    let vm = get_vm();
    if let Some(rwlock) = vm.rwlocks.get(&(handle as usize)) {
        let timeout = Duration::from_millis(timeout_ms as u64);
        rwlock.read()
            .map_err(|e| runtime_error("rwlock_read_lock", e))
            .map(|_| Value::Number(1))
    } else {
        runtime_error("rwlock_read_lock", "Invalid rwlock handle")
    }
}

pub fn rwlock_write_lock(handle, timeout_ms) -> number {
    let vm = get_vm();
    if let Some(rwlock) = vm.rwlocks.get(&(handle as usize)) {
        let timeout = Duration::from_millis(timeout_ms as u64);
        rwlock.write()
            .map_err(|e| runtime_error("rwlock_write_lock", e))
            .map(|_| Value::Number(1))
    } else {
        runtime_error("rwlock_write_lock", "Invalid rwlock handle")
    }
}

pub fn rwlock_unlock(handle) -> number {
    let vm = get_vm();
    // RWLock is automatically released when guard goes out of scope
    Value::Number(1)
}

// Atomic operations
pub fn atomic_create(initial_value) -> number {
    let vm = get_vm();
    let atomic = Atomic::new(initial_value);
    let id = vm.next_atomic_id;
    vm.next_atomic_id += 1;
    vm.atomics.insert(id, atomic);
    id as number
}

pub fn atomic_load(handle) -> number {
    let vm = get_vm();
    if let Some(atomic) = vm.atomics.get(&(handle as usize)) {
        atomic.load(Ordering::SeqCst) as i64
    } else {
        0
    }
}

pub fn atomic_store(handle, new_value) -> number {
    let vm = get_vm();
    if let Some(atomic) = vm.atomics.get(&(handle as usize)) {
        atomic.store(new_value, Ordering::SeqCst);
        1
    } else {
        runtime_error("atomic_store", "Invalid atomic handle")
    }
}

pub fn atomic_add(handle, delta) -> number {
    let vm = get_vm();
    if let Some(atomic) = vm.atomics.get(&(handle as usize)) {
        atomic.fetch_add(delta, Ordering::SeqCst) as i64
    } else {
        runtime_error("atomic_add", "Invalid atomic handle")
    }
}

pub fn atomic_compare_swap(handle, expected, new_value) -> number {
    let vm = get_vm();
    if let Some(atomic) = vm.atomics.get(&(handle as usize)) {
        atomic.compare_exchange(expected, new_value, Ordering::SeqCst) as i64
    } else {
        runtime_error("atomic_compare_swap", "Invalid atomic handle")
    }
}

// Barrier operations
pub fn barrier_create(count) -> number {
    let vm = get_vm();
    let barrier = Barrier::new(count);
    let id = vm.next_barrier_id;
    vm.next_barrier_id += 1;
    vm.barriers.insert(id, barrier);
    id as number
}

pub fn barrier_wait(handle) -> number {
    let vm = get_vm();
    if let Some(barrier) = vm.barriers.get(&(handle as usize)) {
        // Returns 1 if this thread is the "leader" (last to arrive), 0 otherwise
        barrier.wait()
            .map_err(|e| runtime_error("barrier_wait", e))
            .map(|is_leader| Value::Number(if is_leader { 1 } else { 0 }))
    } else {
        runtime_error("barrier_wait", "Invalid barrier handle")
    }
}

// Once operations
pub fn once_create() -> number {
    let vm = get_vm();
    let once = Once::new();
    let id = vm.next_once_id;
    vm.next_once_id += 1;
    vm.once_flags.insert(id, once);
    id as number
}

pub fn once_call(handle, func_name, timeout_ms) -> value {
    let vm = get_vm();
    if let Some(once) = vm.once_flags.get(&(handle as usize)) {
        // Check if already called
        if once.get() {
            return Value::Nil
        }

        // Try to acquire the once lock
        let mut guard = once.cv.lock().map_err(|_| runtime_error("once_call", "Failed to acquire once lock"));
        if guard.is_ok() {
            // Call the function (simplified version)
            let result = Value::String(format!("once_init_{}", func_name));
            once.done.store(true, Ordering::SeqCst);
            drop(guard);
            result
        } else {
            runtime_error("once_call", "Failed to acquire once lock")
        }
    } else {
        runtime_error("once_call", "Invalid once handle")
    }
}

pub fn once_is_called(handle) -> bool {
    let vm = get_vm();
    if let Some(once) = vm.once_flags.get(&(handle as usize)) {
        once.get()
    } else {
        false
    }
}

// Timer operations
pub fn timer_create(duration_ms) -> number {
    let vm = get_vm();
    let timer = Timer::new(Duration::from_millis(duration_ms as u64));
    let id = vm.next_timer_id;
    vm.next_timer_id += 1;
    vm.timers.insert(id, timer);
    id as number
}

pub fn timer_wait(handle) -> number {
    let vm = get_vm();
    if let Some(timer) = vm.timers.get(&(handle as usize)) {
        timer.wait()
            .map_err(|e| runtime_error("timer_wait", e))
            .map(|_| Value::Number(1))
    } else {
        runtime_error("timer_wait", "Invalid timer handle")
    }
}

pub fn timer_is_expired(handle) -> bool {
    let vm = get_vm();
    if let Some(timer) = vm.timers.get(&(handle as usize)) {
        timer.is_expired()
    } else {
        true
    }
}

pub fn timer_remaining_ms(handle) -> number {
    let vm = get_vm();
    if let Some(timer) = vm.timers.get(&(handle as usize)) {
        timer.remaining().as_millis() as f64
    } else {
        0.0
    }
}

pub fn timer_cancel(handle) -> number {
    let vm = get_vm();
    if let Some(timer) = vm.timers.get(&(handle as usize)) {
        timer.cancel();
        1
    } else {
        runtime_error("timer_cancel", "Invalid timer handle")
    }
}

// Concurrency statistics
pub fn concurrency_stats() -> map {
    let vm = get_vm();
    let stats = ConcurrencyStats::new();
    let mut result = HashMap::new();
    result.insert("active_threads".to_string(), Value::Number(stats.active_threads as f64));
    result.insert("pending_tasks".to_string(), Value::Number(stats.pending_tasks as f64));
    result.insert("active_channels".to_string(), Value::Number(vm.len(channels) as f64));
    result.insert("active_mutexes".to_string(), Value::Number(vm.len(mutexes) as f64));
    result.insert("active_rwlocks".to_string(), Value::Number(vm.len(rwlocks) as f64));
    result.insert("active_atomics".to_string(), Value::Number(vm.len(atomics) as f64));
    result.insert("active_barriers".to_string(), Value::Number(vm.len(barriers) as f64));
    result.insert("active_once_flags".to_string(), Value::Number(vm.len(once_flags) as f64));
    result.insert("active_timers".to_string(), Value::Number(vm.len(timers) as f64));
    result.insert("total_operations".to_string(), Value::Number(stats.total_operations as f64));
    alloc_map(result)
}

// Helper function to get the current VM instance
fn get_vm() -> &'static mut VM {
    // This would typically be implemented to get the current VM instance
    // For now, we'll use a placeholder that would be replaced by the actual VM instance
    unsafe {
        std::mem::transmute(0usize)
    }
}
