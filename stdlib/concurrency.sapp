// concurrency.sapp — compatibility alias for stdlib/thread.sapp
//
// This module previously held Rust-style pseudocode (`pub fn ... -> number`,
// `ThreadPool::new`, `move ||`, `.unwrap()`) that did not parse as pblang. The
// real, working concurrency primitives — thread spawn/join, channels, select,
// timers, mutex/rwlock, wait groups, barriers, once, atomics, semaphores, thread
// pools, pipelines, fan-out/in, actors, promises, rate limiters, structured
// `scope`, supervisors, `parallel_map`, `race`, and circuit breakers — all live
// in `stdlib/thread.sapp`. This file simply re-exports them so existing
// `import("stdlib:concurrency.sapp")` references keep working.

let _t = import("stdlib/thread.sapp");

// Core spawn/join
let thread_spawn = _t.thread_spawn;
let thread_join = _t.thread_join;
let thread_join_all = _t.thread_join_all;
let thread_spawn_n = _t.thread_spawn_n;
// Channels
let channel_new = _t.channel_new;
let channel_new_buffered = _t.channel_new_buffered;
let send_value = _t.send_value;
let recv_value = _t.recv_value;
let recv_or_timeout = _t.recv_or_timeout;
let channel_close_sender = _t.channel_close_sender;
let channel_is_done = _t.channel_is_done;
let channel_len = _t.channel_len;
let drain = _t.drain;
// Select
let select_ready = _t.select_ready;
let select_timeout = _t.select_timeout;
let select_nonblocking = _t.select_nonblocking;
// Timers
let after = _t.after;
let tick = _t.tick;
let sleep = _t.sleep;
// Mutex
let mutex = _t.mutex;
let with_mutex = _t.with_mutex;
let try_with_mutex = _t.try_with_mutex;
// RwLock
let rwlock = _t.rwlock;
let with_read = _t.with_read;
let with_write = _t.with_write;
// WaitGroup
let wait_group = _t.wait_group;
let wg_done = _t.wg_done;
let wg_wait = _t.wg_wait;
let wg_wait_timeout = _t.wg_wait_timeout;
// Barrier
let barrier = _t.barrier;
let barrier_arrive = _t.barrier_arrive;
// Once
let once = _t.once;
let once_do_lazy = _t.once_do_lazy;
// Atomics
let atomic = _t.atomic;
let atomic_inc = _t.atomic_inc;
let atomic_dec = _t.atomic_dec;
let atomic_get = _t.atomic_get;
let atomic_set = _t.atomic_set;
let atomic_add = _t.atomic_add;
let atomic_cas = _t.atomic_cas;
// Semaphore
let semaphore = _t.semaphore;
let sem_acquire = _t.sem_acquire;
let sem_try_acquire = _t.sem_try_acquire;
let sem_release = _t.sem_release;
let with_semaphore = _t.with_semaphore;
// Thread pool
let thread_pool = _t.thread_pool;
// Pipeline (channel-based)
let pipeline_source = _t.pipeline_source;
let pipeline_stage = _t.pipeline_stage;
let pipeline_collect = _t.pipeline_collect;
// Fan-out/in
let fan_out = _t.fan_out;
let fan_in = _t.fan_in;
// Actor model
let actor = _t.actor;
let actor_send = _t.actor_send;
let actor_stop = _t.actor_stop;
let actor_get_result = _t.actor_get_result;
// Promise/Future
let promise = _t.promise;
let go = _t.go;
let await = _t.await;
let await_timeout = _t.await_timeout;
let try_await = _t.try_await;
let is_ready = _t.is_ready;
// Rate limiter
let rate_limiter = _t.rate_limiter;
// Structured concurrency
let scope = _t.scope;
// Supervisor
let supervisor = _t.supervisor;
// Parallel map
let parallel_map = _t.parallel_map;
// Pipeline (staged)
let pipeline = _t.pipeline;
// Race
let race = _t.race;
// Circuit breaker
let circuit_breaker = _t.circuit_breaker;

export
    thread_spawn, thread_join, thread_join_all, thread_spawn_n,
    channel_new, channel_new_buffered, send_value, recv_value, recv_or_timeout,
    channel_close_sender, channel_is_done, channel_len, drain,
    select_ready, select_timeout, select_nonblocking,
    after, tick, sleep,
    mutex, with_mutex, try_with_mutex,
    rwlock, with_read, with_write,
    wait_group, wg_done, wg_wait, wg_wait_timeout,
    barrier, barrier_arrive,
    once, once_do_lazy,
    atomic, atomic_inc, atomic_dec, atomic_get, atomic_set, atomic_add, atomic_cas,
    semaphore, sem_acquire, sem_try_acquire, sem_release, with_semaphore,
    thread_pool,
    pipeline_source, pipeline_stage, pipeline_collect,
    fan_out, fan_in,
    actor, actor_send, actor_stop, actor_get_result,
    promise, go, await, await_timeout, try_await, is_ready,
    rate_limiter,
    scope,
    supervisor,
    parallel_map,
    pipeline,
    race,
    circuit_breaker;
