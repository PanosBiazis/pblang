// Pure half-open interval analysis. Caller order and source objects are preserved.
let MAX_INTERVALS=512; let MAX_TIME_MS=359999999;
fn _integer(value) {
    return type(value)=="number" and value>=0 and value<=MAX_TIME_MS and value==num_floor(value);
}
fn validate(intervals) {
    if type(intervals)!="array" or len(intervals)>MAX_INTERVALS { throw "intervals: list limit"; }
    for item in intervals {
        if type(item)!="map" or len(item)!=2 or not map_has(item,"start_ms") or not map_has(item,"end_ms")
            or not _integer(item.start_ms) or not _integer(item.end_ms) or item.start_ms>=item.end_ms {
            throw "intervals: expected positive integer-millisecond duration";
        }
    }
    return true;
}
// First index whose value is >= needle, or > needle when inclusive is true.
fn _bound(values,needle,inclusive) {
    let low=0; let high=len(values);
    while low<high {
        let mid=num_floor((low+high)/2);
        if values[mid]<needle or (inclusive and values[mid]==needle) { low=mid+1; } else { high=mid; }
    }
    return low;
}
fn analyze(intervals) {
    validate(intervals); let starts=[]; let ends=[]; let duration=0;
    for item in intervals { array_push(starts,item.start_ms); array_push(ends,item.end_ms); duration=duration+item.end_ms-item.start_ms; }
    starts=array_sort(starts); ends=array_sort(ends);
    let n=len(starts); let per_item=[];
    for item in intervals {
        array_push(per_item,_bound(starts,item.end_ms,false)-_bound(ends,item.start_ms,true)-1);
    }
    let si=0; let ei=0; let active=0; let peak=0; let pairs=0; let occupied=0; let overlap=0; let gaps=[];
    let first=if n==0 {0} else {starts[0]}; let last=if n==0 {0} else {ends[n-1]}; let previous=first;
    while si<n or ei<n {
        // Ends win ties: [a,b) and [b,c) never overlap.
        let is_start=si<n and (ei>=n or starts[si]<ends[ei]);
        let time=if is_start {starts[si]} else {ends[ei]}; let elapsed=time-previous;
        if active>0 { occupied=occupied+elapsed; }
        elif elapsed>0 { array_push(gaps,map{start_ms:previous,end_ms:time}); }
        if active>1 { overlap=overlap+elapsed; }
        if is_start { pairs=pairs+active; active=active+1; peak=num_max(peak,active); si=si+1; }
        else { active=active-1; ei=ei+1; }
        previous=time;
    }
    return map{interval_count:n,start_ms:first,end_ms:last,span_ms:last-first,duration_sum_ms:duration,
        occupied_ms:occupied,overlap_ms:overlap,gap_ms:last-first-occupied,peak_concurrency:peak,
        overlap_pairs:pairs,overlaps_by_index:per_item,gaps:gaps};
}
export MAX_INTERVALS,MAX_TIME_MS,validate,analyze;
