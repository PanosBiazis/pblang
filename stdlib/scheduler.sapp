// stdlib/scheduler.sapp — Task scheduling (cron-like intervals, delayed execution).
//
// Usage:
//   let sched = import("stdlib:scheduler.sapp");
//   sched.set_interval(fn() { print "tick"; }, 1000);
//   sched.set_timeout(fn() { print "delayed"; }, 5000);
//   sched.run_loop();  // blocks, executing scheduled tasks

let _timers = [];
let _running = false;

// set_timeout(fn, delay_ms) — execute fn once after delay_ms.
fn set_timeout(fn_, delay_ms) {
    let id = len(_timers);
    _timers[id] = map{
        fn: fn_,
        interval: 0,
        next_run: clock() * 1000.0 + delay_ms,
        repeat: false,
        cancelled: false
    };
    return id;
}

// set_interval(fn, interval_ms) — execute fn repeatedly every interval_ms.
fn set_interval(fn_, interval_ms) {
    let id = len(_timers);
    _timers[id] = map{
        fn: fn_,
        interval: interval_ms,
        next_run: clock() * 1000.0 + interval_ms,
        repeat: true,
        cancelled: false
    };
    return id;
}

// clear_timer(id) — cancel a timer.
fn clear_timer(id) {
    if id < len(_timers) {
        _timers[id].cancelled = true;
    }
}

// set_immediate(fn) — run fn on the next pending pass (a zero-delay timeout).
fn set_immediate(fn_) { return set_timeout(fn_, 0); }

// run_once() — check and execute any ready timers (non-blocking). Returns the
// number of timers fired.
fn run_once() { return run_pending(); }

// run_pending() — fire every ready timer once; returns the count fired.
fn run_pending() {
    let now = clock() * 1000.0;
    let fired = 0;
    for i len(_timers) {
        let t = _timers[i];
        if t.cancelled == true { } // skip
        else if now >= t.next_run {
            try t.fn() catch nil;
            fired = fired + 1;
            if t.repeat {
                t.next_run = now + t.interval;
            } else {
                t.cancelled = true;
            }
        }
    }
    return fired;
}

// run_loop(duration_ms) — run the scheduler for duration_ms (0 = forever).
fn run_loop(duration_ms = 0) {
    let start = clock() * 1000.0;
    _running = true;
    while _running {
        run_once();
        sleep_ms(10);  // 10ms resolution
        if duration_ms > 0 {
            if (clock() * 1000.0 - start) > duration_ms { break; }
        }
    }
}

// stop() — stop the run loop.
fn stop() { _running = false; }

// active_timers() — count of non-cancelled timers.
fn active_timers() {
    let count = 0;
    for i len(_timers) {
        if _timers[i].cancelled == false { count = count + 1; }
    }
    return count;
}

// is_active(id) — true if the timer exists and has not been cancelled.
fn is_active(id) {
    if id < 0 or id >= len(_timers) { return false; }
    return _timers[id].cancelled == false;
}

// clear_all() — cancel every timer.
fn clear_all() {
    for i len(_timers) { _timers[i].cancelled = true; }
}

export set_timeout, set_interval, set_immediate, clear_timer, clear_all,
       run_once, run_pending, run_loop, stop, active_timers, is_active;
