// stdlib/polyglot_policy.sapp — execution MODES for the polyglot boundary.
//
// A policy layer over stdlib/polyglot_guard: choose how much to trust foreign code before
// stdlib/polyglot runs it. The module itself NEVER executes anything — it scans, decides,
// and delegates to a runner YOU pass in (e.g. polyglot.run or a container runner), so the
// dangerous modes are always explicit and caller-controlled.
//
//   secure       (default) scan; run ONLY if safe AND through an explicitly
//                supplied sandbox runner. The raw runner is never used.
//   sandbox      scan; run EVERYTHING, but through a caller-supplied isolated runner
//                (no network / scratch FS — the isolation is the runner's job).
//   audit        run EVERYTHING, attach the findings so the risk is logged, not hidden.
//   unrestricted run EVERYTHING with NO scan. Fast and DANGEROUS — safe and unsafe alike.
//   report       never run; return the scan only (dry-run analysis of any code/library).
//
//   let X = import("stdlib/polyglot_policy.sapp");
//   X.execute(X.with_sandbox(X.new("secure", POLY.run), CONTAINER), "python", code);
//   X.execute(X.with_sandbox(X.new("sandbox", POLY.run), CONTAINER), l, c); // isolate it
//   X.execute(X.new("unrestricted", POLY.run), l, c);                     // run anything

let PG = import("stdlib:polyglot_guard.sapp");
let _POLICIES = map{};
let MAX_POLICIES = 1024;
let MAX_ALLOWED_LANGUAGES = 64;
let MAX_LANGUAGE_BYTES = 64;
let DEFAULT_IDLE_TIMEOUT_MS = 600000;
let MAX_IDLE_TIMEOUT_MS = 86400000;

fn modes() { return ["secure", "sandbox", "audit", "unrestricted", "report"]; }
fn is_mode(m) {
    return m == "secure" or m == "sandbox" or m == "audit"
        or m == "unrestricted" or m == "report";
}

fn _callable(v) {
    let t = type(v);
    return t == "closure" or t == "function" or t == "builtin";
}

fn _copy_languages(values) {
    if values == nil { return nil; }
    if type(values) != "array" or len(values) > MAX_ALLOWED_LANGUAGES {
        throw "polyglot_policy: allowed_languages must contain at most "
            + str(MAX_ALLOWED_LANGUAGES) + " entries";
    }
    let copied = [];
    let seen = map{};
    let i = 0;
    while i < len(values) {
        if type(values[i]) != "string" {
            throw "polyglot_policy: allowed language names must be strings";
        }
        let value = str_lower(str_trim(values[i]));
        if value == "" or len(str_to_bytes(value)) > MAX_LANGUAGE_BYTES {
            throw "polyglot_policy: allowed language name is invalid";
        }
        if map_has(seen, value) {
            throw "polyglot_policy: allowed language names must be unique";
        }
        seen[value] = true;
        array_push(copied, value);
        i = i + 1;
    }
    return copied;
}

fn _reap_expired(now) {
    let ids = map_keys(_POLICIES);
    let i = 0;
    while i < len(ids) {
        let state = _POLICIES[ids[i]];
        if now - state.last_used_ms > state.idle_timeout_ms {
            map_remove(_POLICIES, ids[i]);
        }
        i = i + 1;
    }
}

fn _policy_token() {
    _reap_expired(now_ms());
    if len(map_keys(_POLICIES)) >= MAX_POLICIES {
        throw "polyglot_policy: policy registry capacity reached; close unused policies";
    }
    let attempt = 0;
    while attempt < 8 {
        let token = sha256(base64_encode_bytes(random_bytes(32)) + str(now_ms()) + str(attempt));
        if not map_has(_POLICIES, token) { return token; }
        attempt = attempt + 1;
    }
    throw "polyglot_policy: policy identity allocation failed";
}

fn _state(cfg) {
    if type(cfg) != "map" or (try cfg.format catch "") != "pblang.polyglot.policy.v3"
       or type(try cfg.id catch nil) != "string" or not map_has(_POLICIES, cfg.id) {
        throw "polyglot_policy: invalid or closed policy handle";
    }
    let state = _POLICIES[cfg.id];
    let now = now_ms();
    if now - state.last_used_ms > state.idle_timeout_ms {
        map_remove(_POLICIES, cfg.id);
        throw "polyglot_policy: expired policy handle";
    }
    state.last_used_ms = now;
    return state;
}

fn _limit(options, key, fallback, hard_max) {
    let n = fallback;
    if options != nil and map_has(options, key) { n = options[key]; }
    if not is_number(n) or n != num_floor(n) or n < 1 or n > hard_max {
        throw "polyglot_policy: " + key + " must be an integer in 1.." + str(hard_max);
    }
    return n;
}

fn _language_allowed(cfg, lang) {
    if cfg.allowed_languages == nil { return true; }
    let wanted = str_lower(str_trim(str(lang)));
    let i = 0;
    while i < len(cfg.allowed_languages) {
        if str_lower(str_trim(str(cfg.allowed_languages[i]))) == wanted { return true; }
        i = i + 1;
    }
    return false;
}

// new(mode, runner, options) — runner(lang, code) does the actual execution.
// max_code_bytes is enforced even in unrestricted mode; allowed_languages is
// an optional exact allowlist. These resource/capability limits cannot be
// disabled by choosing a less restrictive scan mode.
fn new(mode, runner, options = nil) {
    if not is_mode(mode) { throw "polyglot_policy: unknown mode '" + str(mode) + "'"; }
    if options != nil and not is_map(options) { throw "polyglot_policy: options must be a map"; }
    if mode != "report" and not _callable(runner) { throw "polyglot_policy: execution mode requires a callable runner"; }
    let allowed_values = nil;
    if options != nil and map_has(options, "allowed_languages") {
        allowed_values = options.allowed_languages;
    }
    let allowed = _copy_languages(allowed_values);
    let token = _policy_token();
    let now = now_ms();
    _POLICIES[token] = map{ mode: mode, runner: runner, sandbox: nil,
        allowed_languages: allowed,
        max_code_bytes: _limit(options, "max_code_bytes", 1048576, 16777216),
        idle_timeout_ms: _limit(options, "idle_timeout_ms",
            DEFAULT_IDLE_TIMEOUT_MS, MAX_IDLE_TIMEOUT_MS),
        last_used_ms: now };
    return map{ format: "pblang.polyglot.policy.v3", id: token };
}
fn with_sandbox(cfg, sandbox_runner) {
    if not _callable(sandbox_runner) { throw "polyglot_policy: sandbox runner must be callable"; }
    let state = _state(cfg);
    state.sandbox = sandbox_runner;
    return cfg;
}

fn close(cfg) {
    let state = _state(cfg);
    map_remove(_POLICIES, cfg.id);
    return map{ ok: true, closed: true, mode: state.mode };
}

fn describe(cfg) {
    let state = _state(cfg);
    return map{ format: "pblang.polyglot.policy-description.v1", mode: state.mode,
        allowed_languages: _copy_languages(state.allowed_languages),
        max_code_bytes: state.max_code_bytes,
        idle_timeout_ms: state.idle_timeout_ms,
        sandbox_runner_registered: state.sandbox != nil,
        sandbox_verified: false, effects_confined: false };
}

fn _result(mode, ran, blocked, safe, findings, result, sandbox_runner_used, reason) {
    return map{ mode: mode, ran: ran, blocked: blocked, safe: safe,
        findings: findings, result: result,
        sandbox_runner_used: sandbox_runner_used,
        sandbox_verified: false, sandboxed: false, effects_confined: false,
        reason: reason };
}

// execute(cfg, lang, code) -> result map {mode, ran, blocked, safe, findings, result, sandboxed}.
fn execute(cfg, lang, code) {
    let state = _state(cfg);
    let mode = state.mode;
    if code != nil and type(code) != "string" {
        return _result(mode, false, true, false, [], nil, false, "invalid_code");
    }
    let source = if code == nil { "" } else { code };
    if len(str_to_bytes(source)) > state.max_code_bytes {
        return _result(mode, false, true, false, [], nil, false, "code_limit_exceeded");
    }
    if not _language_allowed(state, lang) {
        return _result(mode, false, true, false, [], nil, false, "language_not_allowed");
    }
    // unrestricted: run with no scan at all.
    if mode == "unrestricted" {
        return _result(mode, true, false, nil, [], state.runner(lang, source), false, "unrestricted_explicit");
    }
    let scan = PG.scan(source, lang);
    if mode == "report" {
        return _result(mode, false, false, scan.safe, scan.findings, nil, false, "report_only");
    }
    if mode == "secure" {
        if not scan.safe {
            return _result(mode, false, true, false, scan.findings, nil, false, "blocked_by_scan");
        }
        if state.sandbox == nil {
            return _result(mode, false, true, true, scan.findings, nil, false, "sandbox_required");
        }
        return _result(mode, true, false, true, scan.findings,
            state.sandbox(lang, source), true, "safe_delegated_unverified");
    }
    if mode == "audit" {
        return _result(mode, true, false, scan.safe, scan.findings, state.runner(lang, source), false, "audit_explicit");
    }
    if mode == "sandbox" {
        if state.sandbox == nil { throw "polyglot_policy: sandbox mode requires with_sandbox(runner)"; }
        return _result(mode, true, false, scan.safe, scan.findings,
            state.sandbox(lang, source), true, "sandbox_delegated_unverified");
    }
    throw "polyglot_policy: unhandled mode '" + str(mode) + "'";
}

// convenience one-shots
fn _close_quiet(cfg) { try close(cfg) catch nil; }
fn _execute_and_close(cfg, lang, code) {
    let result = nil;
    try { result = execute(cfg, lang, code); }
    catch {
        _close_quiet(cfg);
        throw "polyglot_policy: delegated execution failed";
    }
    _close_quiet(cfg);
    return result;
}
fn secure(sandbox_runner, lang, code) {
    let cfg = with_sandbox(new("secure", sandbox_runner), sandbox_runner);
    return _execute_and_close(cfg, lang, code);
}
fn _one_shot(mode, runner, lang, code) {
    let cfg = new(mode, runner);
    return _execute_and_close(cfg, lang, code);
}
fn unrestricted(runner, lang, code) { return _one_shot("unrestricted", runner, lang, code); }
fn audit(runner, lang, code) { return _one_shot("audit", runner, lang, code); }
fn report(lang, code) { return _one_shot("report", nil, lang, code); }

export modes, is_mode, new, with_sandbox, close, describe, execute;
export secure, unrestricted, audit, report;
