// stdlib/polyglot_policy.sapp — execution MODES for the polyglot boundary.
//
// A policy layer over stdlib/polyglot_guard: choose how much to trust foreign code before
// stdlib/polyglot runs it. The module itself NEVER executes anything — it scans, decides,
// and delegates to a runner YOU pass in (e.g. polyglot.run or a container runner), so the
// dangerous modes are always explicit and caller-controlled.
//
//   secure       (default) scan; run ONLY if safe, else block. Malicious-code-proof.
//   sandbox      scan; run EVERYTHING, but through a caller-supplied isolated runner
//                (no network / scratch FS — the isolation is the runner's job).
//   audit        run EVERYTHING, attach the findings so the risk is logged, not hidden.
//   unrestricted run EVERYTHING with NO scan. Fast and DANGEROUS — safe and unsafe alike.
//   report       never run; return the scan only (dry-run analysis of any code/library).
//
//   let X = import("stdlib/polyglot_policy.sapp");
//   X.execute(X.new("secure", POLY.run), "python", code);                 // blocks malware
//   X.execute(X.with_sandbox(X.new("sandbox", POLY.run), CONTAINER), l, c); // isolate it
//   X.execute(X.new("unrestricted", POLY.run), l, c);                     // run anything

let PG = import("stdlib:polyglot_guard.sapp");

fn modes() { return ["secure", "sandbox", "audit", "unrestricted", "report"]; }
fn is_mode(m) {
    let all = modes();
    let i = 0;
    while i < len(all) { if all[i] == m { return true; } i = i + 1; }
    return false;
}

// new(mode, runner) — a policy config. runner(lang, code) does the actual execution.
fn new(mode, runner) {
    if not is_mode(mode) { throw "polyglot_policy: unknown mode '" + str(mode) + "'"; }
    return map{ mode: mode, runner: runner, sandbox: nil };
}
fn with_sandbox(cfg, sandbox_runner) { cfg.sandbox = sandbox_runner; return cfg; }

fn _result(mode, ran, blocked, safe, findings, result, sandboxed) {
    return map{ mode: mode, ran: ran, blocked: blocked, safe: safe,
        findings: findings, result: result, sandboxed: sandboxed };
}

// execute(cfg, lang, code) -> result map {mode, ran, blocked, safe, findings, result, sandboxed}.
fn execute(cfg, lang, code) {
    let mode = cfg.mode;
    // unrestricted: run with no scan at all.
    if mode == "unrestricted" {
        return _result(mode, true, false, nil, [], cfg.runner(lang, code), false);
    }
    let scan = PG.scan(code, lang);
    if mode == "report" {
        return _result(mode, false, false, scan.safe, scan.findings, nil, false);
    }
    if mode == "secure" {
        if not scan.safe {
            return _result(mode, false, true, false, scan.findings, nil, false);
        }
        return _result(mode, true, false, true, scan.findings, cfg.runner(lang, code), false);
    }
    if mode == "audit" {
        return _result(mode, true, false, scan.safe, scan.findings, cfg.runner(lang, code), false);
    }
    if mode == "sandbox" {
        if cfg.sandbox == nil { throw "polyglot_policy: sandbox mode requires with_sandbox(runner)"; }
        return _result(mode, true, false, scan.safe, scan.findings, cfg.sandbox(lang, code), true);
    }
    throw "polyglot_policy: unhandled mode '" + str(mode) + "'";
}

// convenience one-shots
fn secure(runner, lang, code) { return execute(new("secure", runner), lang, code); }
fn unrestricted(runner, lang, code) { return execute(new("unrestricted", runner), lang, code); }
fn audit(runner, lang, code) { return execute(new("audit", runner), lang, code); }
fn report(lang, code) { return execute(new("report", nil), lang, code); }

export modes, is_mode, new, with_sandbox, execute, secure, unrestricted, audit, report;
