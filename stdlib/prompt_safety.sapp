// stdlib/prompt_safety.sapp — defensive prompt-harm triage (a content moderation gate).
//
// Harvested from the G0DM0D3 "classify" module: tag an incoming prompt with a harm CATEGORY
// and a risk score so an assistant can escalate to a human or refuse. This DETECTS intent —
// it never emits harmful content, and the banks are triage keywords (routing signals), not
// how-tos. It canonicalizes with stdlib/deobfuscate first, so leetspeak / homoglyph evasion
// ("r4ns0mw4re") is caught. Pairs with pbai (assess_prompt) and polyglot_guard/deobfuscate.
//
//   let PS = import("stdlib/prompt_safety.sapp");
//   let v = PS.classify(userPrompt);   // {category, score, matched, safe}
//   if not v.safe { escalate_or_refuse(v.category); }
//
// Honest boundary: a keyword classifier is a coarse first-pass filter — it has false
// positives/negatives. Use it to ROUTE (to a human, a stronger model, or a refusal), never
// as the sole arbiter.

let DEOB = import("stdlib:deobfuscate.sapp");

// Category -> triage keywords. Dual-use cyber is the most concrete to detect; the other
// categories carry only coarse routing signals (a real system escalates these to a model).
let _BANKS = nil;
fn _banks() {
    if _BANKS != nil { return _BANKS; }
    _BANKS = map{
        cyber_malware: ["keylogger", "ransomware", "botnet", "ddos", "sql injection",
            "reverse shell", "credential stealer", "steal passwords", "phishing page",
            "exploit kit", "backdoor", "rootkit", "spyware", "brute force login"],
        illegal: ["launder money", "counterfeit money", "fake passport", "buy illegal",
            "untraceable", "black market"],
        self_harm: ["kill myself", "end my life", "how to suicide", "self harm"],
        violence: ["build a bomb", "make a weapon", "how to kill", "mass shooting"],
        hate: ["ethnic cleansing", "genocide", "racial slur"]
    };
    return _BANKS;
}

fn categories() { return ["cyber_malware", "illegal", "self_harm", "violence", "hate", "safe"]; }

// report(text) -> per-category hit counts over the canonicalized prompt.
fn report(text) {
    let canon = DEOB.canonicalize(text);
    let banks = _banks();
    let names = ["cyber_malware", "illegal", "self_harm", "violence", "hate"];
    let out = map{};
    let ni = 0;
    while ni < len(names) {
        let name = names[ni];
        let words = banks[name];
        let score = 0;
        let wi = 0;
        while wi < len(words) { if str_contains(canon, words[wi]) { score = score + 1; } wi = wi + 1; }
        out[name] = score;
        ni = ni + 1;
    }
    return out;
}

// classify(text) -> { category, score, matched:[...], safe }.
fn classify(text) {
    let canon = DEOB.canonicalize(text);
    let banks = _banks();
    let names = ["cyber_malware", "illegal", "self_harm", "violence", "hate"];
    let best = "safe";
    let bestScore = 0;
    let matched = [];
    let ni = 0;
    while ni < len(names) {
        let name = names[ni];
        let words = banks[name];
        let score = 0;
        let hits = [];
        let wi = 0;
        while wi < len(words) {
            if str_contains(canon, words[wi]) { score = score + 1; array_push(hits, words[wi]); }
            wi = wi + 1;
        }
        if score > bestScore { bestScore = score; best = name; matched = hits; }
        ni = ni + 1;
    }
    return map{ category: best, score: bestScore, matched: matched, safe: bestScore == 0 };
}

fn is_safe(text) { return classify(text).safe; }

export categories, report, classify, is_safe;
