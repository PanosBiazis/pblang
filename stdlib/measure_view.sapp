let Measure=import("stdlib:measure_document.sapp");let UI=import("stdlib:modern_ui.sapp");let Pages=import("stdlib:text_pages.sapp");
fn _lines(doc,values,index) {
    let row=doc.rows[index];let wrapped=Pages.wrap(row.label,32);if len(wrapped)>4 {throw "measure view: label overflow";}
    let lines=["Conversion "+str(index+1)+" / "+str(len(doc.rows))];
    for i in range(0,4) {array_push(lines,if i<len(wrapped) {wrapped[i]} else {""});}
    array_push(lines,"Input: "+str(row.value)+" "+row.from);array_push(lines,"Result: "+str(values[index])+" "+row.to);array_push(lines,"Mode: "+row.mode);return lines;
}
fn create(doc,page=0) {
    let values=Measure.results(doc);let pages=num_ceil(len(doc.rows)/8);
    if type(page)!="number" or not (page>=0 and page<pages) or page!=num_floor(page) {throw "measure view: invalid page";}
    let children=[UI.heading("PBMeasure")];for line in Pages.wrap(doc.title,32) {array_push(children,UI.text(line));}
    array_push(children,UI.text("Saved results - page "+str(page+1)+" / "+str(pages)));let first=_lines(doc,values,page*8);
    for i in range(0,len(first)) {array_push(children,UI.text(first[i],map{name:"detail_"+str(i)}));}
    let buttons=[];
    for index in range(page*8,num_min(page*8+8,len(doc.rows))) {
        let lines=_lines(doc,values,index);let actions=[];
        for i in range(0,len(lines)) {array_push(actions,UI.action_set_text("detail_"+str(i),lines[i]));}
        array_push(buttons,UI.button("Row "+str(index+1),UI.action_sequence(actions),map{name:"select_"+str(index)}));
    }
    array_push(children,UI.grid(buttons,map{columns:4}));array_push(children,UI.text("Select a row. Editing, saving and exports use the native application."));return UI.screen(children);
}
export create;
