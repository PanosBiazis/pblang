// Bounded text-to-speech adapter owned by PBLang.
// Text enters a fixed eSpeak-family executable only through private stdin and
// WAV leaves through bounded stdout. No caller path reaches the child process.

let PROCESS=import("stdlib:linux_process.sapp");
let PCM=import("stdlib:audio_pcm.sapp");
let FORMAT="pblang.speech-tts.v1";
let MAX_TEXT_BYTES=32768;
let MAX_WAV_BYTES=16777216;

fn _integer(value,minimum,maximum){return type(value)=="number" and value==num_floor(value)
    and value>=minimum and value<=maximum;}
fn _voice(value){value=str(value);if value=="default"{return "en";}
    if not regex_match(value,"^[A-Za-z0-9_+!/-]{1,64}$") or str_contains(value,".."){
        throw "speech_tts: invalid voice identifier";}return value;}
fn _text(value){if type(value)!="string"{throw "speech_tts: text must be a string";}
    let bytes=str_to_bytes(value);if len(bytes)<1 or len(bytes)>MAX_TEXT_BYTES
        or str_contains(value,str_from_char_code(0)){throw "speech_tts: text exceeds the bounded UTF-8 policy";}
    return bytes;}
fn validate_ssml(value){let bytes=_text(value);let lower=str_lower(value);
    if not str_starts_with(str_trim(lower),"<speak") or not str_ends_with(str_trim(lower),"</speak>")
        or str_contains(lower,"<!doctype") or str_contains(lower,"<!entity")
        or str_contains(lower,"<?xml") or str_contains(lower,"xinclude"){
        throw "speech_tts: SSML must be one bounded speak document without declarations";
    }return bytes;}
fn native_backend(){return map{run:fn(argv,stdin_bytes){return PROCESS.run_fixed([
    "/usr/bin/espeak-ng","/usr/local/bin/espeak-ng","/usr/bin/espeak","/usr/local/bin/espeak"
],argv,map{timeout_secs:60,startup_timeout_ms:5000,max_output_bytes:MAX_WAV_BYTES,
    max_memory_bytes:268435456,inherit_environment:false,environment:map{LC_ALL:"C.UTF-8",HOME:"/nonexistent"},
    stdin_bytes:stdin_bytes});}};}

fn synthesize_with_backend(text,voice,rate,pitch,ssml,backend){
    if not _integer(rate,80,450){throw "speech_tts: rate must be 80..450 words per minute";}
    if not _integer(pitch,0,99){throw "speech_tts: pitch must be 0..99";}
    voice=_voice(voice);let input=if ssml{validate_ssml(text)}else{_text(text)};
    let argv=["--stdout","--stdin","-v",voice,"-s",str(rate),"-p",str(pitch)];
    if ssml{array_push(argv,"-m");}
    let run=backend.run(argv,input);
    if not (try run.ok catch false) or not (try run.command_ok catch false){
        return map{ok:false,executed:try run.completed catch false,format:FORMAT,
            tool_available:(try run.fixed_candidate catch "")!="",
            error:try run.error catch "TTS engine failed",timed_out:try run.timed_out catch false};
    }
    if try run.output_truncated catch false{return map{ok:false,executed:true,format:FORMAT,
        error:"TTS WAV exceeded the 16 MiB output ceiling"};}
    let audio=try PCM.decode_wav(run.stdout_bytes) catch nil;
    if audio==nil{return map{ok:false,executed:true,format:FORMAT,error:"TTS engine returned invalid PCM16 WAV"};}
    let info=PCM.validate(audio);
    return map{ok:true,executed:true,format:FORMAT,wav_bytes:run.stdout_bytes,
        output_bytes:len(run.stdout_bytes),sample_rate:audio.sample_rate,channels:audio.channels,
        frames:info.frames,duration_secs:info.duration_secs,voice:voice,rate:rate,pitch:pitch,
        ssml:ssml,descriptor_bound_executable:try run.executable_descriptor_held catch false,
        process_group_terminated:try run.process_group_terminated catch false,
        memory_limit_enforced:try run.memory_limit_enforced catch false,
        caller_text_in_argv:false,caller_path_in_argv:false,shell_used:false};
}
fn synthesize(text,voice="default",rate=175,pitch=50,ssml=false){
    if platform()!="linux"{return map{ok:false,executed:false,error:"Linux TTS process backend unavailable"};}
    return synthesize_with_backend(text,voice,rate,pitch,ssml,native_backend());
}

export FORMAT, MAX_TEXT_BYTES, MAX_WAV_BYTES, validate_ssml, native_backend,
       synthesize_with_backend, synthesize;
