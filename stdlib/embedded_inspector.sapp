// Portable board/pin manual plus privacy-safe wired-device resolution.

let Targets = import("stdlib:embedded_targets.sapp");
let Linux = import("stdlib:embedded_linux.sapp");
let FORMAT = "pblang.embedded-inspector.v1";

fn platform_backends() {
    return [
        map{platform:"linux",discovery:"implemented",serial:"implemented"},
        map{platform:"windows",discovery:"incomplete",serial:"incomplete"},
        map{platform:"macos",discovery:"incomplete",serial:"incomplete"},
        map{platform:"android",discovery:"incomplete",serial:"incomplete"},
        map{platform:"bsd",discovery:"incomplete",serial:"incomplete"}
    ];
}

fn _candidate_ids(device) {
    let seen = map{};
    for i len(device.candidates) { seen[device.candidates[i].board] = true; }
    return array_sort(map_keys(seen));
}

fn _candidate_manuals(ids) {
    let manuals = [];
    for i len(ids) { array_push(manuals, Targets.technical_manual(ids[i])); }
    return manuals;
}

fn inspect(request = nil) {
    let board_id = str(try request.board catch "");
    let port = str(try request.port catch "");
    let pin_alias = str(try request.pin catch "");
    if board_id != "" and pin_alias != "" { return Targets.inspect_pin(board_id, pin_alias); }
    if board_id != "" and port == "" { return Targets.technical_manual(board_id); }
    if platform() != "linux" {
        return map{ok:false,format:FORMAT,error:"wired discovery backend is incomplete on this platform",
            platform:platform(),backends:platform_backends()};
    }
    if port != "" and board_id != "" {
        let mapping = Linux.resolve_mapping(board_id, port);
        if not mapping.ok { return mapping; }
        return map{ok:true,format:FORMAT,mapping:mapping,
            manual:Targets.technical_manual(board_id),serial_redacted:true};
    }
    if port != "" {
        let device = Linux.inspect_port(port, false);
        if not device.ok { return device; }
        let ids = _candidate_ids(device);
        if len(ids) != 1 {
            return map{ok:false,format:FORMAT,error:"transport identity is ambiguous; select a board",
                port:device.port,candidate_boards:ids,candidate_manuals:_candidate_manuals(ids),
                serial_redacted:true};
        }
        return map{ok:true,format:FORMAT,transport:device,
            manual:Targets.technical_manual(ids[0]),serial_redacted:true};
    }
    let inventory = Linux.devices(map{include_serial:false});
    if not inventory.ok { return inventory; }
    if inventory.count != 1 {
        return map{ok:false,format:FORMAT,error:"automatic inspection requires exactly one wired device",
            device_count:inventory.count,devices:inventory.devices,serial_redacted:true};
    }
    let ids = _candidate_ids(inventory.devices[0]);
    if len(ids) != 1 {
        return map{ok:false,format:FORMAT,error:"single transport has ambiguous board identity",
            candidate_boards:ids,candidate_manuals:_candidate_manuals(ids),serial_redacted:true};
    }
    return map{ok:true,format:FORMAT,transport:inventory.devices[0],
        manual:Targets.technical_manual(ids[0]),serial_redacted:true};
}

export FORMAT, platform_backends, inspect;
