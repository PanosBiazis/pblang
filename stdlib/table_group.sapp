// Exact literal grouping, stable first appearance; no coercion or formulas.
let Sheet=import("stdlib:sheet_document.sapp");
fn _column(column,width){if type(column)!="number" or not(column>=0 and column<width) or column!=num_floor(column){throw "table group: invalid column";}}
fn _validate(doc,column,header){let size=Sheet.validate(doc);_column(column,size.columns);if type(header)!="bool"{throw "table group: explicit header boolean required";}return size;}
fn _axis(doc,column,header){let labels=[];let lookup=map{};let groups=[];let membership=[];
 for row in range(if header {1} else {0},len(doc.cells)){let key=doc.cells[row][column];let index=0;
  if map_has(lookup,key){index=lookup[key];} else {index=len(labels);lookup[key]=index;array_push(labels,key);array_push(groups,[]);}
  array_push(groups[index],row);array_push(membership,index);
 }return map{labels:labels,rows:groups,membership:membership};
}
fn group_rows(doc,column,header=false){_validate(doc,column,header);return _axis(doc,column,header);}
fn counts(doc,column,header=false){_validate(doc,column,header);let axis=_axis(doc,column,header);let cells=[["Group","Count"]];
 if len(axis.labels)>31{throw "table group: count output exceeds 32 rows including header";}
 for i in range(0,len(axis.labels)){array_push(cells,[axis.labels[i],str(len(axis.rows[i]))]);}let result=map{format:Sheet.FORMAT,cells:cells};Sheet.validate(result);return result;
}
fn cross(doc,row_column,column_column,header=false){let size=_validate(doc,row_column,header);_column(column_column,size.columns);let rows=_axis(doc,row_column,header);let columns=if row_column==column_column {rows} else {_axis(doc,column_column,header)};
 if len(rows.labels)>31 or len(columns.labels)>7{throw "table group: cross-tab exceeds 31 row categories or 7 column categories";}
 let values=[];for r in range(0,len(rows.labels)){let cells=[];for c in range(0,len(columns.labels)){array_push(cells,0);}array_push(values,cells);}
 for i in range(0,len(rows.membership)){let r=rows.membership[i];let c=columns.membership[i];values[r][c]=values[r][c]+1;}
 let headings=["Row / Column"];for label in columns.labels{array_push(headings,label);}let cells=[headings];
 for r in range(0,len(rows.labels)){let line=[rows.labels[r]];for count in values[r]{array_push(line,str(count));}array_push(cells,line);}
 let result=map{format:Sheet.FORMAT,cells:cells};Sheet.validate(result);return result;
}
export group_rows,counts,cross;
