// stdlib/render_backend.sapp — pick the UI render path from the honest gfx backend profile.
//
// pblang UI apps (PBIDE) can render three ways, all consuming the SAME draw commands:
//   cpu-minifb        — pure CPU framebuffer (default; no GPU at all)
//   cpu-sdl2-present  — CPU-rasterized UI, presented through a GPU texture (SDL2 build)
//   gpu2d-export      — emit a GPU host via the gpu2d stack (Rust/C/Python/JS), run guarded
//
// This is the pure decision that maps stdlib/graphics.backend_profile() to a path + honest
// capability flags. It takes the profile as data, so it is testable without a window and
// never lies about GPU rasterization (which pblang does NOT do at runtime — see gpu2d).

fn paths() { return ["cpu-minifb", "cpu-sdl2-present", "gpu2d-export"]; }

// select(profile) -> { path, gpu, cpu_raster, can_export_gpu2d, note }.
fn select(profile) {
    let gpu = try profile.gpu_present catch false;
    let backend = try profile.backend catch "minifb";
    let cpu_raster = try profile.cpu_raster_ui catch true;
    let path = "cpu-minifb";
    let note = "pure CPU framebuffer present";
    if gpu == true {
        path = "cpu-sdl2-present";
        note = "UI rasterized on CPU, presented through a GPU texture (present overhead reduced, UI is not GPU-rasterized)";
    }
    return map{
        path: path, gpu: gpu, cpu_raster: cpu_raster,
        can_export_gpu2d: true,   // codegen is always available regardless of the live backend
        backend: backend, note: note
    };
}

// describe(profile) -> a human one-liner.
fn describe(profile) {
    let s = select(profile);
    let g = "cpu";
    if s.gpu == true { g = "gpu-present"; }
    return "render: " + str(s.backend) + " / " + s.path + " (" + g + "; ui-raster=cpu; gpu2d-export=yes)";
}

// recommend(profile) -> the next upgrade toward less CPU / real GPU, given where you are.
fn recommend(profile) {
    let s = select(profile);
    if s.gpu != true {
        return "build with --features pblang-graphics/sdl2 + PBLANG_GFX=sdl2 for gpu-texture-present, or use the gpu2d-export path for a real GPU host";
    }
    return "already gpu-presenting; for true GPU UI rasterization use the gpu2d-export path (emits a wgpu/OpenGL host, run guarded)";
}

export paths, select, describe, recommend;
