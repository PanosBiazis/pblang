// A detached, source-ordered selection remains a standard Writer document.
let D=import("stdlib:text_document.sapp");
fn select(doc,indices) {
 D.validate(doc);if type(indices)!="array" or len(indices)==0 or len(indices)>D.MAX_BLOCKS {throw "excerpt needs 1-64 selected blocks";}
 let last=-1;for index in indices {if type(index)!="number" or not(index>=0 and index<len(doc.blocks)) or index!=num_floor(index) or index<=last {throw "excerpt indices must be unique, increasing and in bounds";}last=index;}
 let blocks=[];for index in indices {let b=doc.blocks[index];array_push(blocks,map{kind:b.kind,text:b.text});}
 let result=map{format:D.FORMAT,title:doc.title,blocks:blocks};D.validate(result);return result;
}
fn parse_indices(text) {
 if type(text)!="string" or len(text)==0 or len(text)>192 {throw "use comma-separated block numbers";}let indices=[];
 for part in str_split(text,",") {if len(part)==0 or len(part)>2 {throw "block number must be 1-64";}let digit=0;while digit<len(part) {if not str_contains("0123456789",str_slice(part,digit,digit+1)) {throw "invalid block number";}digit=digit+1;}let value=parse_number(part);if value<1 or value>64 {throw "block number must be 1-64";}array_push(indices,value-1);}
 return indices;
}
export select,parse_indices;
