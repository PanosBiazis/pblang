// stdlib/indicators.sapp — Technical / financial indicators for pblang.
//
// The classic charting indicators, composed on stdlib:timeseries.sapp's tested
// smoothers: RSI (momentum), MACD (trend), and Bollinger Bands (volatility).
// Pure pblang; pairs with the probability/risk/time-series stack.
//
//   let ind = import("stdlib:indicators.sapp");
//   ind.rsi(closes, 14);
//   ind.bollinger_bands(closes, 20, 2);
//   ind.macd(closes, 12, 26, 9);

let ts = import("stdlib:timeseries.sapp");

// rsi(prices, period) → Relative Strength Index series, each in [0,100].
// RSI = 100 - 100/(1+RS) with RS = average gain / average loss over `period`
// (simple-average form). All gains -> 100; all losses -> 0.
fn rsi(prices, period) {
    let out = [];
    let d = ts.diff(prices);
    let n = len(d);
    if period <= 0 or period > n { return out; }
    let i = 0;
    while i + period <= n {
        let gain = 0;
        let loss = 0;
        let j = 0;
        while j < period {
            let ch = d[i + j];
            if ch > 0 { gain = gain + ch; } else { loss = loss - ch; }
            j = j + 1;
        }
        let avg_gain = gain / period;
        let avg_loss = loss / period;
        let r = 100;
        if avg_loss > 0 {
            let rs = avg_gain / avg_loss;
            r = 100 - 100 / (1 + rs);
        }
        push(out, r);
        i = i + 1;
    }
    return out;
}

// bollinger_bands(prices, period, num_std) → {middle, upper, lower}, where
// middle = SMA(period), and the bands are num_std rolling sample-std away.
fn bollinger_bands(prices, period, num_std) {
    let mid = ts.sma(prices, period);
    let sd = ts.rolling_std(prices, period);
    let upper = [];
    let lower = [];
    let i = 0;
    while i < len(mid) {
        push(upper, mid[i] + num_std * sd[i]);
        push(lower, mid[i] - num_std * sd[i]);
        i = i + 1;
    }
    return map{ middle: mid, upper: upper, lower: lower };
}

// macd(prices, fast, slow, signal) → {macd_line, signal_line, histogram}.
// macd_line = EMA(fast) - EMA(slow); signal_line = EMA(macd_line, signal);
// histogram = macd_line - signal_line. EMA alpha = 2/(period+1).
fn macd(prices, fast, slow, signal) {
    let ef = ts.ema(prices, 2 / (fast + 1));
    let es = ts.ema(prices, 2 / (slow + 1));
    let macd_line = [];
    let i = 0;
    while i < len(prices) { push(macd_line, ef[i] - es[i]); i = i + 1; }
    let sig = ts.ema(macd_line, 2 / (signal + 1));
    let hist = [];
    i = 0;
    while i < len(macd_line) { push(hist, macd_line[i] - sig[i]); i = i + 1; }
    return map{ macd_line: macd_line, signal_line: sig, histogram: hist };
}

// ── wave 2 (2026-07-04, harvested from the ibkr trading project) ──────────────

fn _abs(x) { if x < 0 { return 0 - x; } return x; }

// sma(prices, period) — convenience re-export of the timeseries rolling mean,
// so a strategy can import ONE module for its whole indicator stack.
fn sma(prices, period) { return ts.sma(prices, period); }

// ema_period(prices, period) — the standard charting EMA: seeded with the SMA
// of the first `period` values, k = 2/(period+1). Emits len-period+1 values
// (ts.ema is the alpha-form, full-length, first-value-seeded variant).
fn ema_period(prices, period) {
    let out = [];
    if period <= 0 or len(prices) < period { return out; }
    let k = 2.0 / (period + 1);
    let seed = 0.0;
    let i = 0;
    while i < period { seed = seed + prices[i]; i = i + 1; }
    let e = seed / period;
    push(out, e);
    while i < len(prices) {
        e = prices[i] * k + e * (1.0 - k);
        push(out, e);
        i = i + 1;
    }
    return out;
}

fn _rsi_value(avg_gain, avg_loss) {
    if avg_loss == 0 { return 100.0; }
    let rs = avg_gain / avg_loss;
    return 100.0 - 100.0 / (1.0 + rs);
}

// rsi_wilder(prices, period) — RSI with Wilder's recursive smoothing (the form
// most charting platforms display; `rsi` above is the simple-average form).
// Emits len-period values.
fn rsi_wilder(prices, period) {
    let out = [];
    if period <= 0 or len(prices) < period + 1 { return out; }
    let avg_gain = 0.0;
    let avg_loss = 0.0;
    let i = 1;
    while i <= period {
        let ch = prices[i] - prices[i - 1];
        if ch > 0 { avg_gain = avg_gain + ch; } else { avg_loss = avg_loss - ch; }
        i = i + 1;
    }
    avg_gain = avg_gain / period;
    avg_loss = avg_loss / period;
    push(out, _rsi_value(avg_gain, avg_loss));
    while i < len(prices) {
        let ch = prices[i] - prices[i - 1];
        let g = 0.0;
        let l = 0.0;
        if ch > 0 { g = ch; } else { l = 0 - ch; }
        avg_gain = (avg_gain * (period - 1) + g) / period;
        avg_loss = (avg_loss * (period - 1) + l) / period;
        push(out, _rsi_value(avg_gain, avg_loss));
        i = i + 1;
    }
    return out;
}

// atr(bars, period) — average true range over [{h,l,c}] bars, Wilder smoothing.
// TR of the first bar is h-l (no previous close). Emits len-period+1 values.
fn atr(bars, period) {
    let out = [];
    if period <= 0 or len(bars) < period { return out; }
    let trs = [];
    let i = 0;
    while i < len(bars) {
        let tr = bars[i].h - bars[i].l;
        if i > 0 {
            let pc = bars[i - 1].c;
            let a = _abs(bars[i].h - pc);
            let b = _abs(bars[i].l - pc);
            if a > tr { tr = a; }
            if b > tr { tr = b; }
        }
        push(trs, tr);
        i = i + 1;
    }
    let seed = 0.0;
    i = 0;
    while i < period { seed = seed + trs[i]; i = i + 1; }
    let cur = seed / period;
    push(out, cur);
    while i < len(trs) {
        cur = (cur * (period - 1) + trs[i]) / period;
        push(out, cur);
        i = i + 1;
    }
    return out;
}

// cross_over(a, b) — indexes i where a moves from <= b to > b (golden cross).
fn cross_over(a, b) {
    let out = [];
    let n = len(a);
    if len(b) < n { n = len(b); }
    let i = 1;
    while i < n {
        if a[i - 1] <= b[i - 1] and a[i] > b[i] { push(out, i); }
        i = i + 1;
    }
    return out;
}

// cross_under(a, b) — indexes i where a moves from >= b to < b (death cross).
fn cross_under(a, b) {
    let out = [];
    let n = len(a);
    if len(b) < n { n = len(b); }
    let i = 1;
    while i < n {
        if a[i - 1] >= b[i - 1] and a[i] < b[i] { push(out, i); }
        i = i + 1;
    }
    return out;
}

export rsi, bollinger_bands, macd;
export sma, ema_period, rsi_wilder, atr, cross_over, cross_under;
