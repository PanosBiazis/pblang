// Exact, bounded price estimates. No taxes, invoicing, payments or external I/O.
let S=import("stdlib:serialization.sapp"); let Money=import("stdlib:money.sapp");
let Text=import("stdlib:text_document.sapp"); let CSV=import("stdlib:sheet_csv.sapp");
let Plan=import("stdlib:offer_plan.sapp");
let FORMAT="pblang.quote-document.v1"; let MAX_FILE_BYTES=65536;
fn _fields(value,names) {
    if type(value)!="map" or len(value)!=len(names) {throw "invalid quote fields";}
    for name in names {if not map_has(value,name) {throw "missing quote field";}}
}
fn _text(value,limit,required=false,multiline=false) {
    if type(value)!="string" or len(value)>limit or len(str_to_bytes(value))>limit or str_contains(value,"\u0000") {throw "invalid quote text";}
    if required and str_trim(value)=="" {throw "quote text must not be blank";}
    let lines=1;
    for i in range(0,len(value)) {
        let cp=strcharcodeat(value,i);
        if cp==10 and multiline {lines=lines+1;}
        elif cp<32 or cp==127 {throw "unsupported quote control character";}
    }
    if lines>64 {throw "quote notes line limit exceeded";}
}
fn _integer(value,low,high) {
    if type(value)!="number" or not (value>=low and value<=high) or value!=num_floor(value) {throw "invalid quote integer";}
}
fn validate(doc) {
    _fields(doc,["format","title","currency","notes","items"]);
    if doc.format!=FORMAT or type(doc.currency)!="string" or (doc.currency!="EUR" and doc.currency!="USD" and doc.currency!="GBP") {throw "unsupported quote format or currency";}
    _text(doc.title,256,true);_text(doc.notes,2048,false,true);
    if type(doc.items)!="array" or len(doc.items)<1 or len(doc.items)>16 {throw "quote needs one to sixteen items";}
    let total=0;let bytes=len(str_to_bytes(doc.title))+len(str_to_bytes(doc.notes));
    for item in doc.items {
        _fields(item,["description","quantity","unit_cents"]);_text(item.description,256,true);
        _integer(item.quantity,1,100000);_integer(item.unit_cents,0,100000000);
        bytes=bytes+len(str_to_bytes(item.description)); total=total+item.quantity*item.unit_cents;
    }
    if bytes>8192 {throw "quote text limit exceeded";}
    return map{items:len(doc.items),total_cents:total,text_bytes:bytes};
}
fn copy(doc) {
    validate(doc);let items=[];
    for item in doc.items {array_push(items,map{description:item.description,quantity:item.quantity,unit_cents:item.unit_cents});}
    return map{format:FORMAT,title:doc.title,currency:doc.currency,notes:doc.notes,items:items};
}
fn create(title="Price estimate",currency="EUR") {
    return copy(map{format:FORMAT,title:title,currency:currency,notes:"",items:[map{description:"Service package",quantity:1,unit_cents:0}]});
}
fn _limits() {return map{max_input_bytes:MAX_FILE_BYTES,max_output_bytes:MAX_FILE_BYTES,max_line_bytes:MAX_FILE_BYTES,max_depth:5,max_items:256,strict:true,reject_duplicate_keys:true};}
fn encode(doc) {let out=S.stringify_safe(copy(doc),"json",_limits());if not out.ok {throw "quote encoding failed";}return out.value;}
fn decode(text) {let out=S.parse_safe(text,"json",_limits());if not out.ok or out.duplicate_keys_checked!=true {throw "invalid quote file";}return copy(out.value);}
fn amount(cents,currency) {return Money.format(Money.from_cents(cents),currency);}
// CSV has exactly three data columns and no header: description, quantity, unit price.
fn from_csv(text,title="Price estimate",currency="EUR",notes="") {
    let sheet=CSV.decode(text);let items=[];
    if len(sheet.cells)>16 or len(sheet.cells[0])!=3 {throw "expected up to sixteen three-column item rows";}
    for row in sheet.cells {array_push(items,map{description:row[0],quantity:Plan.parse_integer(row[1],100000),unit_cents:Plan.parse_amount(row[2])});}
    return copy(map{format:FORMAT,title:title,currency:currency,notes:notes,items:items});
}
fn to_csv(doc) {
    validate(doc);let rows=[];
    for item in doc.items {array_push(rows,[item.description,str(item.quantity),str(Money.from_cents(item.unit_cents))]);}
    return CSV.encode(map{format:"pblang.sheet-document.v1",cells:rows});
}
fn to_document(doc) {
    let stats=validate(doc);let blocks=[map{kind:"heading",text:doc.title},map{kind:"paragraph",text:"Price estimate. Taxes are not calculated. Not an invoice or payment request."}];
    for item in doc.items {
        array_push(blocks,map{kind:"bullet",text:item.description+" | "+str(item.quantity)+" x "+amount(item.unit_cents,doc.currency)+" = "+amount(item.quantity*item.unit_cents,doc.currency)});
    }
    array_push(blocks,map{kind:"heading",text:"Subtotal: "+amount(stats.total_cents,doc.currency)});
    // Native notes can be 2048 bytes; split by characters while retaining exact text.
    if doc.notes!="" {
        array_push(blocks,map{kind:"heading",text:"Notes"});let part="";let size=0;
        for i in range(0,len(doc.notes)) {
            let ch=str_slice(doc.notes,i,i+1);let bytes=len(str_to_bytes(ch));
            if size+bytes>1024 {array_push(blocks,map{kind:"paragraph",text:part});part="";size=0;}
            part=part+ch;size=size+bytes;
        }
        if part!="" {array_push(blocks,map{kind:"paragraph",text:part});}
    }
    return Text.copy(map{format:Text.FORMAT,title:doc.title,blocks:blocks});
}
// An offer becomes ONE ordered unit. Forecast units/costs/fees are never copied.
fn from_offer(plan,index=0,title="Price estimate",description="Service package") {
    Plan.calculate(plan);_integer(index,0,len(plan.offers)-1);
    let doc=create(title);doc.items=[map{description:description,quantity:1,unit_cents:plan.offers[index].price_cents}];return copy(doc);
}
export FORMAT,MAX_FILE_BYTES,validate,copy,create,encode,decode,amount,from_csv,to_csv,to_document,from_offer;
