// Trusted synchronous use of one private-file checkpoint. Imports are selected
// at application setup, never from the later caller's working directory.
let IO=import("stdlib:pbai_student_checkpoint_io.sapp");
let R=import("stdlib:resource_scope.sapp");
// A direct capture is deliberate: an inherited second-level capture is not
// retained correctly by the tested bootstrap runtime. Keep this helper separate.
fn _release(closer) {
    return fn() {
        let closed=closer();
        if type(closed)!="bool" {return map{ok:false,error:"invalid checkpoint close result"};}
        return map{ok:true,value:closed};
    };
}
fn with_file(path,body) {
    let kind=type(body);
    if kind!="fn" and kind!="closure" {throw "checkpoint scope requires a callable body";}
    // Load errors keep their existing public contract and never invoke the body.
    let loaded=IO.load_file(path);
    return R.with_scope(fn(scope) {
        // Capture the bundled close before application code can replace a field.
        // false is the bundled handle's valid already-closed result.
        scope.defer(_release(loaded.close));
        return body(loaded);
    });
}
export with_file;

// Validate the complete bounded request before loading its first file. Strings
// are copied into a private list, so the supplied list is never used as a ledger.
fn _paths(paths) {
    if type(paths)!="array" or len(paths)<1 or len(paths)>8 {throw "checkpoint batch requires one to eight paths";}
    let selected=[];
    for path in paths {
        if type(path)!="string" or len(path)<1 or len(path)>4096
            or str_contains(path,strfromcharcode(0)) {throw "invalid checkpoint batch path";}
        push(selected,path);
    }
    return selected;
}
fn with_files(paths,body) {
    let kind=type(body);
    if kind!="fn" and kind!="closure" {throw "checkpoint batch requires a callable body";}
    let selected=_paths(paths);let state=map{stage:"acquire",acquired_count:0,acquisition_error:nil};
    // Enter ownership before any acquisition: a later load failure must release
    // all earlier handles. The single-file acquisition contract stays unchanged.
    let result=R.with_scope(fn(scope) {
        let handles=[];
        for path in selected {
            let acquired=IO.load_file_result(path);
            if not acquired.ok {
                // Return the known adapter cause so resource_scope snapshots it
                // before cleanup. No path, checkpoint text or backend object escapes.
                state.acquisition_error=map{index:state.acquired_count,error:acquired.error};
                return map{ok:false,error:acquired.error};
            }
            let loaded=acquired.value;
            scope.defer(_release(loaded.close));
            state.acquired_count=state.acquired_count+1;
            push(handles,loaded);
        }
        state.stage="body";
        return body(handles);
    });
    result.stage=state.stage;result.acquired_count=state.acquired_count;
    result.acquisition_error=state.acquisition_error;
    return result;
}
export with_files;
