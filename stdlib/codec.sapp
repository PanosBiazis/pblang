// stdlib/codec.sapp — pluggable, self-describing compression codec.
//
// Backends: pbz (pure pblang, dependency-free default), gzip, zstd, xz (system tools,
// used when present). Output is self-describing: a 1-byte tag selects the backend, so
// decompress() needs no hint and storage stays backend-agnostic. Native backends pipe
// through temp files (binary-safe via fs_read_bytes/fs_write_bytes) — there's no
// shell-redirect, and capturing a subprocess's binary stdout as a string would corrupt it.
//
//   let C = import("stdlib:codec.sapp");
//   C.available();                      // { pbz, gzip, zstd, xz }
//   let blob = C.compress(bytes, "zstd"); // falls back to pbz if zstd missing/fails
//   let back = C.decompress(blob);        // reads the tag, picks the backend

let Z = import("stdlib:pbz.sapp");
let _FL = import("stdlib:flate.sapp");

let _seq = map{ n: 0 };
let _pure = map{ on: false };

// set_pure(on) — force the pure-pblang flate codec for the gzip backend (the
// same fallback used automatically when the gzip binary is missing or fails).
fn set_pure(on) { _pure.on = on == true; return nil; }

fn _ec(r) { if r == nil { return 1; } let e = try r.exit_code catch 1; return e; }

fn _has(name) {
    let r = try proc_spawn_wait("which", [name]) catch nil;
    return r != nil and _ec(r) == 0;
}

// gzip is always available: pure-pblang flate backs it when the binary is absent.
fn available() {
    return map{ pbz: true, gzip: true, gzip_binary: _has("gzip"),
                zstd: _has("zstd"), xz: _has("xz") };
}

// Best by ratio among present native tools, else pbz. (xz/zstd beat gzip on size.)
fn best_backend() {
    if _has("xz") { return "xz"; }
    if _has("zstd") { return "zstd"; }
    if _has("gzip") { return "gzip"; }
    return "pbz";
}

fn _tmp(suffix) {
    _seq.n = _seq.n + 1;
    return "/tmp/pbcodec_" + str(now_ms()) + "_" + str(_seq.n) + suffix;
}

fn _run_file_codec(prog, args, in_bytes, in_path, out_path) {
    if (try fs_write_bytes(in_path, in_bytes) catch false) == false { return nil; }
    let r = try proc_spawn_wait(prog, args) catch nil;
    let out = nil;
    if r != nil and _ec(r) == 0 { out = try fs_read_bytes(out_path) catch nil; }
    try fs_remove(in_path) catch nil;
    try fs_remove(out_path) catch nil;
    return out;
}

// ── native backends (compress / decompress) ──────────────────────────────────
fn _gzip_c(b) {
    if _pure.on or not _has("gzip") { return _FL.gzip_encode(b); }
    let ip = _tmp("");
    let op = ip + ".gz";
    let r = _run_file_codec("gzip", ["-k", "-f", "-n", "-9", ip], b, ip, op);
    if r == nil { return _FL.gzip_encode(b); }
    return r;
}
fn _gzip_d(b) {
    if _pure.on or not _has("gzip") { return _FL.gzip_decode(b); }
    let ip = _tmp(".gz");
    let op = str_slice(ip, 0, len(ip) - 3);
    let r = _run_file_codec("gunzip", ["-k", "-f", ip], b, ip, op);
    if r == nil { return _FL.gzip_decode(b); }
    return r;
}
fn _zstd_c(b) {
    let ip = _tmp("");
    let op = ip + ".zst";
    return _run_file_codec("zstd", ["-q", "-f", "-19", "-o", op, ip], b, ip, op);
}
fn _zstd_d(b) {
    let ip = _tmp(".zst");
    let op = ip + ".out";
    return _run_file_codec("zstd", ["-d", "-q", "-f", "-o", op, ip], b, ip, op);
}
fn _xz_c(b) {
    let ip = _tmp("");
    let op = ip + ".xz";
    return _run_file_codec("xz", ["-k", "-f", "-9", ip], b, ip, op);
}
fn _xz_d(b) {
    let ip = _tmp(".xz");
    let op = str_slice(ip, 0, len(ip) - 3);
    return _run_file_codec("unxz", ["-k", "-f", ip], b, ip, op);
}

fn _tag(t, payload) {
    let out = [t];
    let i = 0;
    while i < len(payload) { array_push(out, payload[i]); i = i + 1; }
    return out;
}

fn _as_bytes(data) { if type(data) == "string" { return str_to_bytes(data); } return data; }

// compress(data, backend?) -> tagged blob. Unknown/missing backend falls back to pbz, so
// this never fails to produce a decodable blob.
fn compress(data, backend) {
    let b = _as_bytes(data);
    if backend == nil { backend = "pbz"; }
    if backend == "gzip" { let p = _gzip_c(b); if p != nil { return _tag(1, p); } }
    if backend == "zstd" and _has("zstd") { let p = _zstd_c(b); if p != nil { return _tag(2, p); } }
    if backend == "xz" and _has("xz") { let p = _xz_c(b); if p != nil { return _tag(3, p); } }
    return _tag(0, Z.compress(b));
}

fn decompress(blob) {
    let tag = blob[0];
    let payload = [];
    let i = 1;
    while i < len(blob) { array_push(payload, blob[i]); i = i + 1; }
    if tag == 1 { return _gzip_d(payload); }
    if tag == 2 { return _zstd_d(payload); }
    if tag == 3 { return _xz_d(payload); }
    return Z.decompress(payload);
}

fn backend_name(blob) {
    let t = blob[0];
    if t == 1 { return "gzip"; }
    if t == 2 { return "zstd"; }
    if t == 3 { return "xz"; }
    return "pbz";
}

// compress_best(data) — compress with the best available backend by ratio.
fn compress_best(data) { return compress(data, best_backend()); }

// decompress_str(blob) — decompress and interpret the bytes as a UTF-8 string.
fn decompress_str(blob) { return bytes_to_str(decompress(blob)); }

// ratio(original_bytes, blob) — compressed size / original size (smaller is
// better; > 1 means the blob grew, e.g. tiny/incompressible inputs).
fn ratio(original_bytes, blob) {
    let o = len(_as_bytes(original_bytes));
    if o == 0 { return 0; }
    return len(blob) / o;
}

export available, set_pure, best_backend, compress, decompress, backend_name,
       compress_best, decompress_str, ratio;
