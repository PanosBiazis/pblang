// Module identities for supplied analyses, preserving canonical virtual paths.
// This is an analysis aid, not compiler validation or filesystem discovery.
// No source is read or executed. Missing targets remain explicitly unresolved.
let LINK = import("stdlib:source_inliner.sapp");
let KG = import("stdlib:knowledge_graph.sapp");

fn _safe_graph_id(path) {
    if path == nil or str_trim(path) != path { return false; }
    // Matches code_graph's current lexical path vocabulary. Broader names
    // need an encoded graph representation, not raw Markdown interpolation.
    return regex_match(path, "^[A-Za-z0-9_/:.\u002d]+$");
}

fn _empty_result() {
    return map{ ok: false, corpus: map{}, resolutions: [], unresolved: [],
        ambiguous: [], invalid: [], basis: "supplied-imports", complete: false };
}

// analyses: map of virtual path -> {imports: [raw import strings]}.
// ok means structurally valid and unambiguous; complete also requires no missing
// target. Neither flag proves lexical accuracy or successful compilation.
fn module_resolution(analyses) {
    let out = _empty_result();
    if not is_map(analyses) {
        push(out.invalid, map{ reason: "analyses must be a map" });
        return out;
    }
    let originals = map_keys(analyses);
    let index = map{};
    let aliases = map{};
    let paths = [];
    for original in originals {
        let path = LINK.resolve_module_identity(original, "", map{});
        if not _safe_graph_id(path) {
            push(out.invalid, map{ reason: "invalid or graph-unsafe module identity" });
        } else {
            if map_has(index, path) {
                push(aliases[path], original);
            } else {
                index[path] = analyses[original];
                aliases[path] = [original];
                push(paths, path);
            }
        }
    }
    for path in paths {
        if len(aliases[path]) > 1 {
            push(out.ambiguous, map{ target: path, candidates: aliases[path],
                reason: "multiple supplied keys have the same canonical identity" });
        }
        let analysis = index[path];
        if not is_map(analysis) or not map_has(analysis, "imports") {
            push(out.invalid, map{ importer: path, reason: "analysis must contain imports" });
        } elif not is_array(analysis.imports) {
            push(out.invalid, map{ importer: path, reason: "imports must be an array" });
        }
    }
    // Never select the first member of a canonical collision or expose a
    // partial authoritative graph for malformed supplied analyses.
    if len(out.invalid) > 0 or len(out.ambiguous) > 0 { return out; }
    let bodies = map{};
    for path in paths {
        let links = [];
        for raw in index[path].imports {
            let target = LINK.resolve_module_identity(raw, path, index);
            if not _safe_graph_id(target) {
                let bad = map{ importer: path, status: "invalid",
                    reason: "invalid or graph-unsafe import identity" };
                push(out.invalid, bad); push(out.resolutions, bad);
            } else {
                let found = map_has(index, target);
                let record = map{ importer: path, raw: raw, target: target,
                    status: if found { "resolved" } else { "unresolved" } };
                push(out.resolutions, record);
                if not found { push(out.unresolved, record); }
                push(links, "[[" + target + "]]");
            }
        }
        bodies[path] = str_join(links, " ");
    }
    if len(out.invalid) > 0 { return out; }
    out.corpus = bodies;
    out.ok = true;
    out.complete = len(out.unresolved) == 0;
    return out;
}

// Returns a structured result, with graph=nil on malformed/ambiguous input.
// A valid graph may include explicitly unresolved external nodes.
fn module_graph_paths(analyses) {
    let out = module_resolution(analyses);
    out.graph = nil;
    if out.ok { out.graph = KG.build(out.corpus); }
    return out;
}

export module_resolution, module_graph_paths;
