// stdlib/frame_gate.sapp — repaint policy for a CPU-rasterized UI loop.
//
// PBIDE (and any pblang GUI) rasterizes its whole frame on the CPU and then presents it;
// repainting when nothing changed wastes CPU on both the draw and the GPU texture upload.
// This is the pure decision of WHETHER to repaint a given tick, factored out so it can be
// tested in isolation. The rule:
//
//   * an input event this tick  -> always repaint (never regress interactivity)
//   * otherwise                 -> repaint only when the idle cadence has elapsed AND the
//                                  visual-state SIGNATURE changed since the last paint
//
// so an idle window (no events, unchanged signature) does zero work, while event-less
// changes that DO alter the signature (a live window resize, a density/probe update) still
// get painted at the idle cadence. Signature construction is the caller's job (it knows
// which state is visible); this module only owns the timing/threshold logic.
//
//   let G = import("stdlib/frame_gate.sapp");
//   let d = G.decide(s.redraw, now, idle_ms, s.last_present_ms, sig, s.last_sig);
//   if d.draw { paint(); s.last_present_ms = now; s.last_sig = sig; s.redraw = false; }

// due(now_ms, idle_ms, last_present_ms) — has the idle repaint cadence elapsed?
// A zero/unknown clock (now == 0) or a never-painted surface (last == 0) counts as due.
fn due(now_ms, idle_ms, last_present_ms) {
    if idle_ms <= 0 { return false; }
    if last_present_ms == 0 { return true; }
    if now_ms == 0 { return true; }
    return now_ms - last_present_ms >= idle_ms;
}

// decide(...) -> { draw }. See module header for the rule.
fn decide(redraw, now_ms, idle_ms, last_present_ms, sig, last_sig) {
    if redraw == true { return map{ draw: true }; }
    if not due(now_ms, idle_ms, last_present_ms) { return map{ draw: false }; }
    if sig != last_sig { return map{ draw: true }; }
    return map{ draw: false };
}

export due, decide;
