// stdlib/ollama.sapp — real local-ollama integration (no Rust, no FFI: pure pblang over the
// http builtins). Talks to the ollama daemon's native REST API:
//   GET  {host}/api/tags               -> installed models
//   POST {host}/api/generate           -> {model, prompt, stream:false} => {response, ...}
// The HTTP transport is injectable everywhere so the parsing/abstain logic is unit-testable
// offline; the defaults use the real http_get/http_post builtins.
//
//   let oll = import("stdlib/ollama.sapp");
//   if oll.available() { print oll.generate(oll.default_model(), "say hi"); }

let json = import("stdlib/json.sapp");
let PR = import("stdlib/provider_registry.sapp");

let _HOST = "http://localhost:11434";
fn host() { return _HOST; }
fn set_host(h) { _HOST = h; return _HOST; }

fn _post_default(u, b) { return http_post(u, b); }
fn _get_default(u) { return http_get(u); }

// _is_error(text) — the http builtins signal failure by returning "error: ..." (no throw).
fn _is_error(text) { return (not is_string(text)) or str_starts_with(str_trim(text), "error"); }

// generate(model, prompt, post_fn) — single-turn completion. Returns the trimmed response
// text, or nil on ANY failure (transport error, unparseable body, missing field).
fn generate(model, prompt, post_fn = nil) {
    if post_fn == nil { post_fn = _post_default; }
    let body = json.stringify(map{ model: model, prompt: prompt, stream: false });
    let raw = try post_fn(_HOST + "/api/generate", body) catch nil;
    if _is_error(raw) { return nil; }
    let obj = try json.parse(raw) catch nil;
    if not is_map(obj) { return nil; }
    if not map_has(obj, "response") { return nil; }
    let t = obj.response;
    if not is_string(t) { return nil; }
    return str_trim(t);
}

// voter_caller(model, post_fn) — a fn(message)->text, exactly the shape pbai.llm_voter wants
// as its injectable `caller`. Abstains (nil) on failure.
fn voter_caller(model, post_fn = nil) {
    return fn(message) { return generate(model, message, post_fn); };
}

// models(get_fn) — list of installed model names ([] if the daemon is unreachable).
fn models(get_fn = nil) {
    if get_fn == nil { get_fn = _get_default; }
    let raw = try get_fn(_HOST + "/api/tags") catch nil;
    if _is_error(raw) { return []; }
    let obj = try json.parse(raw) catch nil;
    if not is_map(obj) or not map_has(obj, "models") { return []; }
    let arr = obj.models;
    let out = [];
    let i = 0;
    while i < len(arr) {
        let m = arr[i];
        if is_map(m) and map_has(m, "name") { array_push(out, m.name); }
        i = i + 1;
    }
    return out;
}

// available(get_fn) — is a reachable ollama daemon serving the tags endpoint?
fn available(get_fn = nil) {
    if get_fn == nil { get_fn = _get_default; }
    let raw = try get_fn(_HOST + "/api/tags") catch nil;
    if _is_error(raw) { return false; }
    let obj = try json.parse(raw) catch nil;
    return is_map(obj) and map_has(obj, "models");
}

// default_model(get_fn) — a sensible model to use: the first LOCAL (non ":cloud") model, else
// the first model, else nil. Cloud models need ollama.com auth so we don't pick them blindly.
fn default_model(get_fn = nil) {
    let ms = models(get_fn);
    if len(ms) == 0 { return nil; }
    let i = 0;
    while i < len(ms) { if not str_contains(ms[i], ":cloud") { return ms[i]; } i = i + 1; }
    return ms[0];
}

// register(name) — register ollama's OpenAI-compatible endpoint into the provider_registry so
// it participates in routing/discovery. (call_provider posts the OpenAI chat shape, which the
// /v1/chat/completions endpoint accepts.) The voter path above uses the native /api/generate.
fn register(name = "ollama") {
    return PR.register(name, _HOST + "/v1/chat/completions", "");
}

export host, set_host, generate, voter_caller, models, available, default_model, register;
