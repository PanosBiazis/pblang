// Pure literal reshaping. Complete output budgets are validated before return.
let Sheet=import("stdlib:sheet_document.sapp");
fn transpose(doc) {
    let size=Sheet.validate(doc);
    if size.rows>Sheet.MAX_COLUMNS { throw "transpose would exceed eight columns"; }
    let output=Sheet.create(size.columns,size.rows);
    for r in range(0,size.rows) { for c in range(0,size.columns) { output.cells[c][r]=doc.cells[r][c]; } }
    return output;
}
// Header required. Unselected columns are identifiers in source order.
// Selected columns expand in caller order for each source data row.
fn unpivot(doc,columns) {
    let size=Sheet.validate(doc);
    if type(columns)!="array" or len(columns)<1 or len(columns)>=size.columns { throw "select measure columns and retain at least one identifier"; }
    let selected=map{};
    for c in columns {
        if type(c)!="number" or not(c>=0 and c<size.columns) or c!=num_floor(c) or map_has(selected,str(c)) { throw "invalid measure columns"; }
        selected[str(c)]=true;
    }
    let names=map{};
    for name in doc.cells[0] {
        if str_trim(name)=="" or map_has(names,name) { throw "unpivot needs unique nonblank headers"; }
        names[name]=true;
    }
    let ids=[];let header=[];
    for c in range(0,size.columns) {
        if not map_has(selected,str(c)) {
            if doc.cells[0][c]=="Variable" or doc.cells[0][c]=="Value" { throw "identifier header conflicts with Variable or Value"; }
            array_push(ids,c);array_push(header,doc.cells[0][c]);
        }
    }
    if len(ids)+2>Sheet.MAX_COLUMNS or 1+(size.rows-1)*len(columns)>Sheet.MAX_ROWS { throw "unpivot output dimensions exceed Sheet limits"; }
    array_push(header,"Variable");array_push(header,"Value");let cells=[header];
    // Preflight repeated identifier/header bytes before creating expanded rows.
    let bytes=0;for value in header { bytes=bytes+len(str_to_bytes(value)); }
    for r in range(1,size.rows) {
        let id_bytes=0;for c in ids { id_bytes=id_bytes+len(str_to_bytes(doc.cells[r][c])); }
        for c in columns {
            bytes=bytes+id_bytes+len(str_to_bytes(doc.cells[0][c]))+len(str_to_bytes(doc.cells[r][c]));
            if bytes>Sheet.MAX_TOTAL_BYTES { throw "unpivot output text exceeds Sheet limits"; }
        }
    }
    for r in range(1,size.rows) { for c in columns {
        let row=[];for id in ids {array_push(row,doc.cells[r][id]);}
        array_push(row,doc.cells[0][c]);array_push(row,doc.cells[r][c]);array_push(cells,row);
    } }
    let result=map{format:Sheet.FORMAT,cells:cells};Sheet.validate(result);return result;
}
fn apply(doc,action,columns=nil) {
    if columns==nil {columns=[];}
    if action=="transpose" {
        if type(columns)!="array" or len(columns)!=0 {throw "transpose takes no measure columns";}
        return transpose(doc);
    }
    if action=="unpivot" {return unpivot(doc,columns);}
    throw "unsupported reshape action";
}
export transpose,unpivot,apply;
