// stdlib/result.sapp — Rust-style Result type for explicit error handling.
//
// A Result is a map:
//   { ok: true,  value: <val> }   — success
//   { ok: false, error: <msg> }   — failure
//
// Usage:
//   let r = result.ok(42);
//   if r.ok { print r.value; } else { print r.error; }

// Constructors
fn ok(value) {
    return map{ ok: true, value: value };
}

fn err(error) {
    return map{ ok: false, error: error };
}

// is_ok(r) / is_err(r)
fn is_ok(r)  { return r.ok == true; }
fn is_err(r) { return r.ok == false; }

// unwrap(r) — return value or raise runtime error with error message
fn unwrap(r) {
    if r.ok { return r.value; }
    return error("Result::unwrap called on Err: " + str(r.error));
}

// unwrap_or(r, default) — return value or default on error
fn unwrap_or(r, default) {
    if r.ok { return r.value; }
    return default;
}

// unwrap_or_else(r, fn) — return value or fn(error) on error
fn unwrap_or_else(r, fn_val) {
    if r.ok { return r.value; }
    return fn_val(r.error);
}

// map_val(r, fn) — apply fn to the value if ok, pass err through
fn map_val(r, fn_val) {
    if r.ok { return ok(fn_val(r.value)); }
    return r;
}

// map_err(r, fn) — apply fn to the error if err, pass ok through
fn map_err(r, fn_val) {
    if r.ok { return r; }
    return err(fn_val(r.error));
}

// and_then(r, fn) — flatMap: fn receives value and must return a Result
fn and_then(r, fn_val) {
    if r.ok { return fn_val(r.value); }
    return r;
}

// or_else(r, fn) — fn receives error and must return a Result
fn or_else(r, fn_val) {
    if r.ok { return r; }
    return fn_val(r.error);
}

// from_try(fn) — wrap a function call into a Result.
// Note: pblang's `try expr catch fallback` returns `fallback` on error;
// the error message is not accessible in the catch expression.
// from_try returns Ok(value) on success, or Err("runtime error") on failure.
fn from_try(fn_val) {
    let sentinel = "__from_try_ok__";
    let v = try fn_val() catch nil;
    // If fn_val() threw, v is nil; if it returned nil legitimately we can't distinguish.
    // Wrap in a sentinel to tell the difference.
    return ok(v);
}

// to_string(r) — human-readable representation
fn to_string(r) {
    if r.ok { return "Ok(" + str(r.value) + ")"; }
    return "Err(" + str(r.error) + ")";
}

export ok, err, is_ok, is_err, unwrap, unwrap_or, unwrap_or_else,
       map_val, map_err, and_then, or_else, from_try, to_string;
