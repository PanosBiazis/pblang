fn byte(x) { let v = x % 256; if v < 0 { v = v + 256; } return v; }
fn pack_u16_le(x) { let lo = byte(x); let hi = byte((x - lo) / 256); return [lo, hi]; }
fn unpack_u16_le(b) { if len(b) < 2 { return 0; } return b[0] + b[1] * 256; }

fn buffer_new(n) { let buf = []; let i = 0; while i < n { array_push(buf, 0); i = i + 1; } return buf; }
fn buffer_from_string(s) { let buf = []; let i = 0; while i < len(s) { array_push(buf, strcharcodeat(s, i)); i = i + 1; } return buf; }
fn buffer_to_string(buf) { let s = ""; let i = 0; while i < len(buf) { s = s + strfromcharcode(buf[i]); i = i + 1; } return s; }

fn buffer_to_hex(buf) {
    let s = ""; let i = 0;
    while i < len(buf) {
        let b = buf[i];
        let hi = (b - (b % 16)) / 16;
        let lo = b % 16;
        let hi_ch = "0";
        let lo_ch = "0";
        if hi < 10 { hi_ch = strfromcharcode(48 + hi); }
        if hi >= 10 and hi < 16 { hi_ch = strfromcharcode(87 + hi); }
        if lo < 10 { lo_ch = strfromcharcode(48 + lo); }
        if lo >= 10 and lo < 16 { lo_ch = strfromcharcode(87 + lo); }
        s = s + hi_ch + lo_ch;
        i = i + 1;
    }
    return s;
}

fn buffer_from_hex(hex) {
    let buf = []; let i = 0;
    while i + 1 < len(hex) {
        let hic = strcharcodeat(hex, i); let loc = strcharcodeat(hex, i + 1); let val = 0;
        if hic >= 48 and hic <= 57 { val = (hic - 48) * 16; }
        if hic >= 97 and hic <= 102 { val = (hic - 87) * 16; }
        if hic >= 65 and hic <= 70 { val = (hic - 55) * 16; }
        if loc >= 48 and loc <= 57 { val = val + (loc - 48); }
        if loc >= 97 and loc <= 102 { val = val + (loc - 87); }
        if loc >= 65 and loc <= 70 { val = val + (loc - 55); }
        array_push(buf, val); i = i + 2;
    }
    return buf;
}

fn platform() { return "linux"; }
fn hostname() { return "localhost"; }

fn asm_hlt() { return map{desc: "asm hlt"}; }
fn asm_nop() { return map{desc: "asm nop"}; }
fn asm_cli() { return map{desc: "asm cli"}; }
fn asm_sti() { return map{desc: "asm sti"}; }
fn port_out_byte(p, v) { return map{p: p, v: v}; }
fn port_in_byte(p) { return map{p: p}; }
fn mmio_read32(a) { return map{a: a}; }
fn mmio_write32(a, v) { return map{a: a, v: v}; }
fn ptr_null() { return 0; }
fn ptr_is_null(p) { return p == 0; }
fn interrupt_disable() { return asm_cli(); }
fn interrupt_enable() { return asm_sti(); }
fn page_table_entry(a, f) { return map{a: a, f: f}; }
fn gdt_kernel_code() { return map{desc: "kernel code ring 0"}; }
fn gdt_kernel_data() { return map{desc: "kernel data ring 0"}; }
fn multiboot_header() { return map{magic: 464367618}; }
fn detect_cpu_features() { return map{desc: "CPUID"}; }
fn detect_memory_map() { return map{desc: "multiboot mmap"}; }

// ── 32-bit little-endian pack/unpack + buffer ops ────────────────────────────────
fn pack_u32_le(x) {
    let b0 = byte(x);
    let b1 = byte((x - b0) / 256);
    let b2 = byte((x - b0 - b1 * 256) / 65536);
    let b3 = byte((x - b0 - b1 * 256 - b2 * 65536) / 16777216);
    return [b0, b1, b2, b3];
}
fn unpack_u32_le(b) {
    if len(b) < 4 { return 0; }
    return b[0] + b[1] * 256 + b[2] * 65536 + b[3] * 16777216;
}

// buffer_concat(a, b) — a new buffer with b's bytes appended to a's.
fn buffer_concat(a, b) {
    let out = [];
    let i = 0;
    while i < len(a) { array_push(out, a[i]); i = i + 1; }
    let j = 0;
    while j < len(b) { array_push(out, b[j]); j = j + 1; }
    return out;
}

// buffer_slice(buf, start, end) — bytes [start, end).
fn buffer_slice(buf, start, end) {
    let out = [];
    let i = start;
    while i < end and i < len(buf) { array_push(out, buf[i]); i = i + 1; }
    return out;
}

export byte; export pack_u16_le; export unpack_u16_le;
export pack_u32_le; export unpack_u32_le; export buffer_concat; export buffer_slice;
export buffer_new; export buffer_from_string; export buffer_to_string;
export buffer_to_hex; export buffer_from_hex;
export platform; export hostname;
export asm_hlt; export asm_nop; export asm_cli; export asm_sti;
export port_out_byte; export port_in_byte;
export mmio_read32; export mmio_write32;
export ptr_null; export ptr_is_null;
export interrupt_disable; export interrupt_enable;
export page_table_entry;
export gdt_kernel_code; export gdt_kernel_data;
export multiboot_header;
export detect_cpu_features; export detect_memory_map;
