// Clip half-open intervals [start,end); preserve original text and cue order.
let Subs=import("stdlib:subtitles.sapp");
fn extract(doc,start_ms,end_ms,zero=true) {
 Subs.validate(doc);
 for value in [start_ms,end_ms] {if type(value)!="number" or not(value>=0 and value<=Subs.MAX_TIME_MS) or value!=num_floor(value) {throw "invalid clip boundary";}}
 if end_ms<=start_ms or type(zero)!="bool" {throw "invalid clip window or time mode";}
 let cues=[];let offset=if zero {start_ms} else {0};
 for cue in doc.cues {
  if cue.start_ms>=end_ms {break;}
  if cue.end_ms<=start_ms {continue;}
  array_push(cues,map{start_ms:num_max(cue.start_ms,start_ms)-offset,end_ms:num_min(cue.end_ms,end_ms)-offset,text:cue.text});
 }
 if len(cues)==0 {throw "no cues intersect the clip window";}
 let result=map{format:Subs.FORMAT,cues:cues};Subs.validate(result);return result;
}
export extract;
