// stdlib/async.sapp — Async/concurrent task primitives for pblang.
//
// Provides Go-style goroutines, Promise-style futures, and task pools.
// Built on top of the VM's spawn/channel/join builtins.
//
// Usage:
//   let async = import("stdlib:async.sapp");
//   let future = async.go(fn() { return expensive_computation(); });
//   let result = async.await(future);

let _WORKER = import("stdlib:async_worker.sapp");
let _POOL = nil;
let _MAP_POOL = nil;
// Load once in the owning VM. Repeated imports would revalidate dependencies.
fn _pool_backend() {
    if _POOL == nil { _POOL = import("stdlib:async_pool_worker.sapp"); }
    return _POOL;
}

// Futures belong to the creating VM. Serialize access in that VM; these maps
// are not cross-thread synchronization objects.
fn _whole_number(value, minimum, label) {
    if not is_number(value) { throw label + ": expected a number"; }
    if value - value != 0 or value < minimum or value != num_floor(value) {
        throw label + ": expected a finite whole number >= " + str(minimum);
    }
}

// Wrap success outside the user value: nil, false and sentinel-shaped maps
// remain ordinary results. A task exception has a separate terminal state.
fn go(task_fn) { return _WORKER.launch(task_fn); }

fn _settle(future, msg) {
    let joined = try { join(future.worker); true } catch false;
    // recv has a host-level wait limit. For an ordinary unbounded await,
    // join may finish later; recover the queued result only after completion.
    if msg == nil and joined { msg = recv_timeout(future.channel.receiver, 0); }
    future._ok = msg != nil and msg.ok == true and joined;
    future._value = if future._ok { msg.value } else { nil };
    future.resolved = true;
    channel_close(future.channel.sender);
    return nil;
}

fn _result(future) {
    if not future._ok { throw "async.await: task threw"; }
    return future._value;
}

fn _wait(future) {
    if future.resolved { return nil; }
    let msg = recv(future.channel.receiver);
    return _settle(future, msg);
}

// Awaiting an already settled success/failure never consumes the channel twice.
fn await(future) {
    _wait(future);
    return _result(future);
}

// Caller retains the future when a deadline expires, and can await it later.
// Timeout limits waiting, not worker execution. No preemptive cancellation.
fn await_timeout(future, ms) {
    _whole_number(ms, 0, "async.await_timeout");
    if not future.resolved {
        let msg = recv_timeout(future.channel.receiver, ms);
        if msg == nil and not channel_is_closed(future.channel.receiver) {
            return map{ ready: false, ok: false, value: nil };
        }
        _settle(future, msg);
    }
    return map{ ready: true, ok: future._ok, value: future._value };
}

fn all_settled(futures) {
    let out = [];
    for i len(futures) {
        let future = futures[i];
        _wait(future);
        out[i] = map{ ok: future._ok, value: future._value };
    }
    return out;
}

// gather(fns) — spawn every zero-arg fn with go() and await all results in order.
fn gather(fns) {
    let futures = [];
    for i len(fns) {
        let future = try go(fns[i]) catch nil;
        if future == nil {
            for future in futures { _wait(future); }
            throw "async.gather: worker could not start";
        }
        futures[i] = future;
    }
    // await_all owns settlement of the complete set, including task failures.
    return await_all(futures);
}

// await_all(futures) — settle every future before returning ordered results
// or raising a task error. A failure never abandons later siblings.
fn await_all(futures) {
    for future in futures { _wait(future); }
    let results = [];
    for i len(futures) {
        results[i] = _result(futures[i]);
    }
    return results;
}

// Race waits only for the selected worker. The caller still owns the other
// futures and must await/all_settled them. Cached winners are reusable.
fn await_race(futures) {
    if len(futures) == 0 { return nil; }
    let channels = [];
    for i len(futures) {
        if futures[i].resolved { return _result(futures[i]); }
        channels[i] = futures[i].channel.receiver;
    }
    while true {
        let sel = select(channels);
        if sel != nil {
            let winner = futures[sel.index];
            _settle(winner, sel.value);
            return _result(winner);
        }
        // Retained select also returns nil at its internal ten-second limit.
        // Only a terminal channel means completion; otherwise keep waiting.
        for future in futures {
            if channel_is_closed(future.channel.receiver) {
                _settle(future, nil);
                return _result(future);
            }
        }
    }
}

// A deadline limits selection, not task execution or winner teardown. Pending
// and empty races have no index. The caller retains every supplied future.
fn await_race_timeout(futures, ms) {
    _whole_number(ms, 0, "async.await_race_timeout");
    if ms > 2147483647 { throw "async.await_race_timeout: duration exceeds 2147483647 ms"; }
    if not is_array(futures) { throw "async.await_race_timeout: expected an array"; }
    let channels = [];
    for i len(futures) {
        let future = futures[i];
        if future.resolved {
            return map{ready:true, ok:future._ok, value:future._value, index:i};
        }
        channels[i] = future.channel.receiver;
    }
    if len(channels) == 0 { return map{ready:false, ok:false, value:nil, index:nil}; }
    let sel = select_with_timeout(channels, ms);
    if sel != nil and not sel.timed_out {
        let winner = futures[sel.index];
        _settle(winner, sel.value);
        return map{ready:true, ok:winner._ok, value:winner._value, index:sel.index};
    }
    // A closed channel with no envelope is failure, not a missed deadline.
    for i len(futures) {
        let future = futures[i];
        if channel_is_closed(future.channel.receiver) {
            _settle(future, nil);
            return map{ready:true, ok:future._ok, value:future._value, index:i};
        }
    }
    return map{ready:false, ok:false, value:nil, index:nil};
}

fn sleep(ms) { sleep_ms(ms); }

// timeout(ms, fn) -> {ready, ok, value, future}.
// Correctness migration: the former value-or-nil contract could either wait
// beyond the deadline or lose ownership of a live worker. Always return the
// future, including on a deadline miss. Caller eventually awaits/settles it.
fn timeout(ms, task_fn) {
    _whole_number(ms, 0, "async.timeout");
    let future = go(task_fn);
    let result = await_timeout(future, ms);
    result.future = future;
    return result;
}

// pool(size, tasks) — run tasks in a worker pool of `size` goroutines.
// tasks: array of zero-arg functions. Returns array of results in order.
// Tasks should be self-contained or use supported closed, transferable captures.
// Caller globals are not automatically imported. For mapping over data, prefer
// map_parallel (which passes items as data to a single shared mapper).
fn pool(size, tasks) {
    _whole_number(size, 1, "async.pool size");
    let n = len(tasks);
    if n == 0 { return []; }
    if size > n { size = n; }

    let worker = _pool_backend();
    return worker.run_pool(size, tasks, nil, true);
}

// map_parallel(items, fn, pool_size) — apply `fn` to each item across a worker
// pool. Small/scalar inputs use captured items and queued indices. Larger data
// inputs can use queued values, avoiding a whole-input snapshot per worker.
//
// Closed transferable captures are copied, not shared with the parent VM.
// Arbitrary caller globals and OS resources are not transferred by this API.
// Default concurrency is at most eight workers; input/result counts are not capped.
fn map_parallel(items, fn_, pool_size = nil) {
    if pool_size != nil { _whole_number(pool_size, 1, "async.map_parallel size"); }
    let n = len(items);
    if n == 0 { return []; }
    let size = pool_size;
    // Match thread.parallel_map's conservative default. Explicit sizes remain
    // available for workloads with known memory and concurrency requirements.
    if size == nil { size = 8; }
    if size > n { size = n; }
    // Large data maps avoid copying the complete input into every child VM.
    // Small/single-worker maps keep the existing low-startup path. Functions,
    // modules and other capture-only values retain the capture-based backend.
    if n >= 64 and size > 1 {
        // Cheap shape heuristic, not a full traversal or a speed guarantee.
        // Scalar lists cost less to snapshot than to envelope per element.
        let shape = type(items[0]);
        if shape == "array" or shape == "map" or (shape == "string" and len(items[0]) >= 256) {
            if _MAP_POOL == nil { _MAP_POOL = import("stdlib:async_map_worker.sapp"); }
            let mapped = _MAP_POOL.run(size, items, fn_);
            if mapped.supported { return mapped.values; }
        }
    }
    let worker = _pool_backend();
    return worker.run_pool(size, items, fn_, false);
}

// debounce(fn, delay_ms) — returns a debounced version of fn.
// The returned fn can be called multiple times; only the last call within
// delay_ms will actually execute fn.
fn debounce(fn_, delay_ms) {
    let last_call = 0;
    return fn() {
        let now = clock() * 1000.0;
        last_call = now;
        sleep_ms(delay_ms);
        if (clock() * 1000.0 - last_call) >= delay_ms - 1 {
            return fn_();
        }
        return nil;
    };
}

// throttle(fn, interval_ms) — returns a throttled fn (max 1 call per interval_ms).
fn throttle(fn_, interval_ms) {
    let last_exec = 0;
    return fn() {
        let now = clock() * 1000.0;
        if now - last_exec >= interval_ms {
            last_exec = now;
            return fn_();
        }
        return nil;
    };
}

export go, await, await_timeout, await_all, await_race, await_race_timeout, all_settled, gather, sleep, timeout,
       pool, map_parallel, debounce, throttle;
