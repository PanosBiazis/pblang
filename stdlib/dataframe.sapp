// stdlib/dataframe.sapp — Data science DataFrame operations for pblang.
//
// Provides: columnar data storage, filtering, sorting, groupby, aggregation,
// joins, CSV I/O, statistical operations, and transformations.
//
// Usage:
//   let df = import("stdlib:dataframe.sapp");
//   let data = df.from_csv("data.csv");
//   let filtered = df.filter(data, fn(row) { return row.age > 18; });
//   let sorted = df.sort_by(data, "name", "asc");
//   let grouped = df.group_by(data, "city", "count");

let csv_mod = import("stdlib:csv.sapp");

fn _contains(arr, item) {
    for i len(arr) {
        if arr[i] == item { return true; }
    }
    return false;
}

fn _infer_columns(rows) {
    let columns = [];
    for i len(rows) {
        if type(rows[i]) == "map" {
            let keys = map_keys(rows[i]);
            for k len(keys) {
                if _contains(columns, keys[k]) == false {
                    columns[len(columns)] = keys[k];
                }
            }
        }
    }
    return columns;
}

fn _index_columns(columns) {
    let col_index = map{};
    for i len(columns) { col_index[columns[i]] = i; }
    return col_index;
}

fn _coerce_value(v) {
    if type(v) != "string" { return v; }
    let num = try parse_number(v) catch nil;
    if num != nil { return num; }
    return v;
}

fn _normalize_rows(rows, columns) {
    let out = [];
    for i len(rows) {
        let row = rows[i];
        let new_row = map{};
        for c len(columns) {
            new_row[columns[c]] = try row[columns[c]] catch nil;
        }
        out[i] = new_row;
    }
    return out;
}

// from_rows(rows) — create a DataFrame from an array of maps.
fn from_rows(rows) {
    if type(rows) != "array" or len(rows) == 0 {
        return map{ columns: [], rows: [], _col_index: map{} };
    }
    let columns = _infer_columns(rows);
    return map{ columns: columns, rows: _normalize_rows(rows, columns), _col_index: _index_columns(columns) };
}

// from_csv_string(csv_str) — parse CSV text into a DataFrame.
fn from_csv_string(csv_str) {
    let parsed = csv_mod.parse_maps(csv_str, ",");
    let rows = [];
    for i len(parsed) {
        let row = map{};
        let keys = map_keys(parsed[i]);
        for k len(keys) {
            row[keys[k]] = _coerce_value(parsed[i][keys[k]]);
        }
        rows[i] = row;
    }
    return from_rows(rows);
}

// from_csv(path) — read a CSV file and create DataFrame.
fn from_csv(path) {
    let raw = try fs_read(path) catch nil;
    if raw == nil { return error("dataframe.from_csv: cannot read " + path); }
    return from_csv_string(raw);
}

// to_csv(df) — convert DataFrame to CSV string.
fn to_csv(df) {
    return csv_mod.stringify_maps(df.rows, ",", df.columns);
}

// nrows(df), ncols(df) — dimensions
fn nrows(df) { return len(df.rows); }
fn ncols(df) { return len(df.columns); }

// head(df, n) — first n rows
fn head(df, n = 5) {
    let result = [];
    let limit = n;
    if limit < 0 { limit = 0; }
    if limit > len(df.rows) { limit = len(df.rows); }
    for i limit { result[i] = df.rows[i]; }
    return from_rows(result);
}

// tail(df, n) — last n rows
fn tail(df, n = 5) {
    if n < 0 { n = 0; }
    let total = len(df.rows);
    let start = total - n;
    if start < 0 { start = 0; }
    let result = [];
    for i total - start {
        result[i] = df.rows[start + i];
    }
    return from_rows(result);
}

// slice(df, start, end) — select a clamped row range.
fn slice(df, start = 0, end = nil) {
    let total = len(df.rows);
    if end == nil { end = total; }
    if start < 0 { start = 0; }
    if end < 0 { end = 0; }
    if start > total { start = total; }
    if end > total { end = total; }
    if end < start { end = start; }
    let result = [];
    for i end - start {
        result[i] = df.rows[start + i];
    }
    return from_rows(result);
}

// select_columns(df, cols) — select specific columns
fn select_columns(df, cols) {
    let result = [];
    for i len(df.rows) {
        let row = map{};
        for j len(cols) {
            row[cols[j]] = try df.rows[i][cols[j]] catch nil;
        }
        result[i] = row;
    }
    return from_rows(result);
}

// drop_columns(df, cols) — remove columns by name.
fn drop_columns(df, cols) {
    let result = [];
    for i len(df.rows) {
        let row = map{};
        for c len(df.columns) {
            let name = df.columns[c];
            if _contains(cols, name) == false {
                row[name] = try df.rows[i][name] catch nil;
            }
        }
        result[i] = row;
    }
    return from_rows(result);
}

// rename_column(df, old_name, new_name) — rename one column.
fn rename_column(df, old_name, new_name) {
    let result = [];
    for i len(df.rows) {
        let row = map{};
        for c len(df.columns) {
            let name = df.columns[c];
            if name == old_name {
                row[new_name] = try df.rows[i][name] catch nil;
            } else {
                row[name] = try df.rows[i][name] catch nil;
            }
        }
        result[i] = row;
    }
    return from_rows(result);
}

// fill_missing(df, defaults) — replace nil/missing values using a map or scalar.
fn fill_missing(df, defaults) {
    let result = [];
    for i len(df.rows) {
        let row = map{};
        for c len(df.columns) {
            let name = df.columns[c];
            let val = try df.rows[i][name] catch nil;
            if val == nil {
                if type(defaults) == "map" {
                    val = try defaults[name] catch nil;
                } else {
                    val = defaults;
                }
            }
            row[name] = val;
        }
        result[i] = row;
    }
    return from_rows(result);
}

// filter(df, predicate_fn) — filter rows by predicate.
fn filter(df, predicate) {
    let result = [];
    for i len(df.rows) {
        if predicate(df.rows[i]) == true {
            result[len(result)] = df.rows[i];
        }
    }
    return from_rows(result);
}

// map_rows(df, transform_fn) — transform each row.
fn map_rows(df, transform) {
    let result = [];
    for i len(df.rows) {
        result[i] = transform(df.rows[i]);
    }
    return from_rows(result);
}

// sort_by(df, column, direction) — sort rows by a column.
// direction: "asc" or "desc"
fn sort_by(df, column, direction = "asc") {
    // Copy rows
    let rows = [];
    for i len(df.rows) { rows[i] = df.rows[i]; }
    // Insertion sort
    for i len(rows) {
        for j i {
            let a = try rows[j][column] catch 0;
            let b = try rows[i][column] catch 0;
            let should_swap = false;
            if direction == "asc" and a > b { should_swap = true; }
            if direction == "desc" and a < b { should_swap = true; }
            if should_swap {
                let tmp = rows[i];
                rows[i] = rows[j];
                rows[j] = tmp;
            }
        }
    }
    return from_rows(rows);
}

// column(df, name) — extract a single column as array.
fn column(df, name) {
    let result = [];
    for i len(df.rows) {
        result[i] = try df.rows[i][name] catch nil;
    }
    return result;
}

// add_column(df, name, fn_or_values) — add a computed column.
fn add_column(df, name, fn_or_values) {
    let result = [];
    for i len(df.rows) {
        let row = df.rows[i];
        let new_row = map{};
        let keys = map_keys(row);
        for k len(keys) { new_row[keys[k]] = row[keys[k]]; }
        if type(fn_or_values) == "function" {
            new_row[name] = fn_or_values(row);
        } else if type(fn_or_values) == "array" {
            new_row[name] = try fn_or_values[i] catch nil;
        } else {
            new_row[name] = fn_or_values;
        }
        result[i] = new_row;
    }
    return from_rows(result);
}

// group_by(df, column, agg) — group rows by column, apply aggregation.
// agg: "count", "sum", "avg", "min", "max" (applied to numeric columns)
fn group_by(df, group_col, agg) {
    let groups = map{};
    for i len(df.rows) {
        let key = str(try df.rows[i][group_col] catch "nil");
        if map_has(groups, key) == false { groups[key] = []; }
        let arr = groups[key];
        arr[len(arr)] = df.rows[i];
        groups[key] = arr;
    }
    let result = [];
    let group_keys = map_keys(groups);
    for i len(group_keys) {
        let k = group_keys[i];
        let group_rows = groups[k];
        let row = map{};
        row[group_col] = k;
        if agg == "count" {
            row.count = len(group_rows);
        } else {
            // Apply agg to all numeric columns
            let cols = df.columns;
            for c len(cols) {
                if cols[c] == group_col { } // skip group col
                else {
                    let vals = [];
                    for r len(group_rows) {
                        let v = try group_rows[r][cols[c]] catch nil;
                        if type(v) == "number" { vals[len(vals)] = v; }
                    }
                    if len(vals) > 0 {
                        if agg == "sum" {
                            let s = 0; for v len(vals) { s = s + vals[v]; } row[cols[c]] = s;
                        } else if agg == "avg" {
                            let s = 0; for v len(vals) { s = s + vals[v]; } row[cols[c]] = s / len(vals);
                        } else if agg == "min" {
                            let m = vals[0]; for v len(vals) { if vals[v] < m { m = vals[v]; } } row[cols[c]] = m;
                        } else if agg == "max" {
                            let m = vals[0]; for v len(vals) { if vals[v] > m { m = vals[v]; } } row[cols[c]] = m;
                        }
                    }
                }
            }
        }
        result[len(result)] = row;
    }
    return from_rows(result);
}

// describe(df) — descriptive statistics for all numeric columns.
fn describe(df) {
    let stats = map{};
    for c len(df.columns) {
        let col_name = df.columns[c];
        let vals = [];
        for r len(df.rows) {
            let v = try df.rows[r][col_name] catch nil;
            if type(v) == "number" { vals[len(vals)] = v; }
        }
        if len(vals) > 0 {
            let sum_val = 0; let min_val = vals[0]; let max_val = vals[0];
            for v len(vals) {
                sum_val = sum_val + vals[v];
                if vals[v] < min_val { min_val = vals[v]; }
                if vals[v] > max_val { max_val = vals[v]; }
            }
            let mean_val = sum_val / len(vals);
            // Variance
            let var_sum = 0;
            for v len(vals) {
                let d = vals[v] - mean_val;
                var_sum = var_sum + d * d;
            }
            let std_val = num_sqrt(var_sum / len(vals));
            stats[col_name] = map{
                count: len(vals), mean: mean_val, std: std_val,
                min: min_val, max: max_val
            };
        }
    }
    return stats;
}

// join(df_left, df_right, on_column) — inner join on a shared column.
fn join(df_left, df_right, on_column) {
    let result = [];
    for i len(df_left.rows) {
        let left_row = df_left.rows[i];
        let left_key = str(try left_row[on_column] catch nil);
        for j len(df_right.rows) {
            let right_row = df_right.rows[j];
            let right_key = str(try right_row[on_column] catch nil);
            if left_key == right_key {
                // Merge rows
                let merged = map{};
                let lk = map_keys(left_row);
                for k len(lk) { merged[lk[k]] = left_row[lk[k]]; }
                let rk = map_keys(right_row);
                for k len(rk) {
                    if rk[k] != on_column { merged[rk[k]] = right_row[rk[k]]; }
                }
                result[len(result)] = merged;
            }
        }
    }
    return from_rows(result);
}

// unique(df, column) — unique values in a column.
fn unique(df, col_name) {
    let seen = map{};
    let result = [];
    for i len(df.rows) {
        let v = str(try df.rows[i][col_name] catch nil);
        if map_has(seen, v) == false {
            seen[v] = true;
            result[len(result)] = df.rows[i][col_name];
        }
    }
    return result;
}

// value_counts(df, column) — frequency count for column values.
fn value_counts(df, col_name) {
    let counts = map{};
    for i len(df.rows) {
        let v = str(try df.rows[i][col_name] catch "nil");
        let cur = try counts[v] catch 0;
        counts[v] = cur + 1;
    }
    return counts;
}

// schema(df) — summarize column types and missing values.
fn schema(df) {
    let out = map{};
    for c len(df.columns) {
        let name = df.columns[c];
        let info = map{ number: 0, string: 0, bool: 0, nil: 0, other: 0 };
        for r len(df.rows) {
            let val = try df.rows[r][name] catch nil;
            let t = type(val);
            if val == nil { info.nil = info.nil + 1; }
            else if t == "number" { info.number = info.number + 1; }
            else if t == "string" { info.string = info.string + 1; }
            else if t == "bool" { info.bool = info.bool + 1; }
            else { info.other = info.other + 1; }
        }
        out[name] = info;
    }
    return out;
}

// validate(df) — structural validation for DataFrame shape.
fn validate(df) {
    let errors = [];
    if type(df) != "map" {
        return map{ ok: false, errors: ["dataframe must be a map"], rows: 0, columns: 0 };
    }
    if type(try df.columns catch nil) != "array" {
        errors[len(errors)] = "columns must be an array";
    }
    if type(try df.rows catch nil) != "array" {
        errors[len(errors)] = "rows must be an array";
        return map{ ok: len(errors) == 0, errors: errors, rows: 0, columns: 0 };
    }
    let seen = map{};
    for c len(df.columns) {
        let name = df.columns[c];
        if map_has(seen, name) { errors[len(errors)] = "duplicate column: " + str(name); }
        seen[name] = true;
    }
    for r len(df.rows) {
        if type(df.rows[r]) != "map" {
            errors[len(errors)] = "row " + str(r) + " must be a map";
        }
    }
    return map{ ok: len(errors) == 0, errors: errors, rows: len(df.rows), columns: len(df.columns) };
}

export from_rows, from_csv_string, from_csv, to_csv, nrows, ncols,
       head, tail, slice, select_columns, drop_columns, rename_column, fill_missing,
       filter, map_rows, sort_by, column, add_column, group_by, describe, join,
       unique, value_counts, schema, validate;
