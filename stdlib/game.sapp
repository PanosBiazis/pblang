// stdlib/game.sapp — Game development utilities for pblang.
//
// 2D/3D vector math, collision detection, sprites, game loop utilities,
// input handling, and ECS helpers. Built on top of stdlib/ecs.sapp and
// stdlib/graphics.sapp.
//
// Usage:
//   let game = import("stdlib:game.sapp");
//   let v = game.vec2(3, 4);
//   let mag = game.vec2_mag(v);

// ── 2D Vector ─────────────────────────────────────────────────────────────────

fn vec2(x, y) { return map{ x: x, y: y }; }

fn vec2_add(a, b) { return vec2(a.x + b.x, a.y + b.y); }
fn vec2_sub(a, b) { return vec2(a.x - b.x, a.y - b.y); }
fn vec2_scale(v, s) { return vec2(v.x * s, v.y * s); }
fn vec2_dot(a, b) { return a.x * b.x + a.y * b.y; }
fn vec2_cross(a, b) { return a.x * b.y - a.y * b.x; }
fn vec2_mag(v) { return num_sqrt(v.x * v.x + v.y * v.y); }
fn vec2_mag2(v) { return v.x * v.x + v.y * v.y; }
fn vec2_norm(v) {
    let m = vec2_mag(v);
    if m == 0 { return vec2(0, 0); }
    return vec2(v.x / m, v.y / m);
}
fn vec2_dist(a, b) { return vec2_mag(vec2_sub(a, b)); }
fn vec2_lerp(a, b, t) { return vec2(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t); }
fn vec2_angle(v) { return num_atan2(v.y, v.x); }
fn vec2_from_angle(angle, mag = nil) {
    if mag == nil { mag = 1; }
    return vec2(math.cos(angle) * mag, math.sin(angle) * mag);
}
fn vec2_rotate(v, angle) {
    let c = math.cos(angle);
    let s = math.sin(angle);
    return vec2(v.x * c - v.y * s, v.x * s + v.y * c);
}
fn vec2_reflect(v, normal) {
    let d = vec2_dot(v, normal);
    return vec2(v.x - 2 * d * normal.x, v.y - 2 * d * normal.y);
}

// ── 3D Vector ─────────────────────────────────────────────────────────────────

fn vec3(x, y, z) { return map{ x: x, y: y, z: z }; }

fn vec3_add(a, b) { return vec3(a.x + b.x, a.y + b.y, a.z + b.z); }
fn vec3_sub(a, b) { return vec3(a.x - b.x, a.y - b.y, a.z - b.z); }
fn vec3_scale(v, s) { return vec3(v.x * s, v.y * s, v.z * s); }
fn vec3_dot(a, b) { return a.x * b.x + a.y * b.y + a.z * b.z; }
fn vec3_cross(a, b) {
    return vec3(
        a.y * b.z - a.z * b.y,
        a.z * b.x - a.x * b.z,
        a.x * b.y - a.y * b.x
    );
}
fn vec3_mag(v) { return num_sqrt(v.x * v.x + v.y * v.y + v.z * v.z); }
fn vec3_norm(v) {
    let m = vec3_mag(v);
    if m == 0 { return vec3(0, 0, 0); }
    return vec3(v.x / m, v.y / m, v.z / m);
}
fn vec3_dist(a, b) { return vec3_mag(vec3_sub(a, b)); }
fn vec3_lerp(a, b, t) { return vec3(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t); }

// ── Rectangles (AABB) ─────────────────────────────────────────────────────────

fn rect(x, y, w, h) { return map{ x: x, y: y, w: w, h: h }; }

fn rect_contains_point(r, p) {
    return p.x >= r.x and p.x <= r.x + r.w
       and p.y >= r.y and p.y <= r.y + r.h;
}

fn rect_overlaps(a, b) {
    return a.x < b.x + b.w and a.x + a.w > b.x
       and a.y < b.y + b.h and a.y + a.h > b.y;
}

fn rect_center(r) {
    return vec2(r.x + r.w / 2, r.y + r.h / 2);
}

fn rect_from_center(cx, cy, w, h) {
    return rect(cx - w / 2, cy - h / 2, w, h);
}

// ── Circle ────────────────────────────────────────────────────────────────────

fn circle(cx, cy, r) { return map{ x: cx, y: cy, r: r }; }

fn circle_contains_point(c, p) {
    return vec2_dist(vec2(c.x, c.y), p) <= c.r;
}

fn circle_overlaps(a, b) {
    return vec2_dist(vec2(a.x, a.y), vec2(b.x, b.y)) <= a.r + b.r;
}

// ── Collision detection ───────────────────────────────────────────────────────

fn aabb_vs_aabb(a, b) { return rect_overlaps(a, b); }

fn circle_vs_circle(a, b) { return circle_overlaps(a, b); }

fn circle_vs_aabb(circle, rect) {
    // Find closest point on AABB to circle center
    let closest_x = circle.x;
    if closest_x < rect.x { closest_x = rect.x; }
    if closest_x > rect.x + rect.w { closest_x = rect.x + rect.w; }

    let closest_y = circle.y;
    if closest_y < rect.y { closest_y = rect.y; }
    if closest_y > rect.y + rect.h { closest_y = rect.y + rect.h; }

    let dist = vec2_dist(vec2(circle.x, circle.y), vec2(closest_x, closest_y));
    return dist <= circle.r;
}

fn point_vs_rect(p, r) { return rect_contains_point(r, p); }
fn point_vs_circle(p, c) { return circle_contains_point(c, p); }

fn line_vs_line(a1, a2, b1, b2) {
    // Check if line segments AB and CD intersect
    let d1 = vec2_cross(
        vec2_sub(b2, b1),
        vec2_sub(a1, b1)
    );
    let d2 = vec2_cross(
        vec2_sub(b2, b1),
        vec2_sub(a2, b1)
    );
    let d3 = vec2_cross(
        vec2_sub(a2, a1),
        vec2_sub(b1, a1)
    );
    let d4 = vec2_cross(
        vec2_sub(a2, a1),
        vec2_sub(b2, a1)
    );
    return (d1 * d2 < 0) and (d3 * d4 < 0);
}

// ── Sprite / Animation helpers ────────────────────────────────────────────────

fn sprite_frame(frame_w, frame_h, col, row) {
    return map{
        x: col * frame_w,
        y: row * frame_h,
        w: frame_w,
        h: frame_h,
    };
}

fn animate_frame(frame_count, fps, elapsed_ms) {
    let total_time = (frame_count * 1000) / fps;
    let t = num_mod(elapsed_ms, total_time);
    return num_floor(t / (1000 / fps));
}

// ── Game loop timing ──────────────────────────────────────────────────────────

fn game_loop_init() {
    return map{
        last_time: now_ms(),
        dt: 0,
        accumulator: 0,
        fixed_dt: 16.67, // ~60 FPS
    };
}

fn game_loop_update(loop_state) {
    let now = now_ms();
    loop_state.dt = now - loop_state.last_time;
    loop_state.last_time = now;
    loop_state.accumulator = loop_state.accumulator + loop_state.dt;
    return loop_state.dt;
}

fn game_loop_should_fixed_update(loop_state) {
    if loop_state.accumulator >= loop_state.fixed_dt {
        loop_state.accumulator = loop_state.accumulator - loop_state.fixed_dt;
        return true;
    }
    return false;
}

// ── Simple physics ────────────────────────────────────────────────────────────

fn apply_velocity(pos, vel, dt_seconds) {
    return vec2(
        pos.x + vel.x * dt_seconds,
        pos.y + vel.y * dt_seconds
    );
}

fn apply_acceleration(vel, acc, dt_seconds) {
    return vec2(
        vel.x + acc.x * dt_seconds,
        vel.y + acc.y * dt_seconds
    );
}

fn apply_friction(vel, friction, dt_seconds) {
    let mag = vec2_mag(vel);
    if mag == 0 { return vel; }
    let new_mag = mag - friction * dt_seconds;
    if new_mag < 0 { new_mag = 0; }
    let ratio = new_mag / mag;
    return vec2(vel.x * ratio, vel.y * ratio);
}

fn apply_gravity(vel, gravity, dt_seconds) {
    return vec2(vel.x, vel.y + gravity * dt_seconds);
}

// ── Random utilities ──────────────────────────────────────────────────────────

fn random_range(min, max) {
    return min + random_float() * (max - min);
}

fn random_vec2(min_x, max_x, min_y, max_y) {
    return vec2(random_range(min_x, max_x), random_range(min_y, max_y));
}

fn random_color() {
    return map{
        r: num_floor(random_float() * 255),
        g: num_floor(random_float() * 255),
        b: num_floor(random_float() * 255),
    };
}

// ── Camera / viewport ────────────────────────────────────────────────────────

fn camera2d(x, y, zoom, w, h) {
    if zoom == nil { zoom = 1; }
    return map{ x: x, y: y, zoom: zoom, w: w, h: h };
}

fn world_to_screen(cam, p) {
    return vec2((p.x - cam.x) * cam.zoom + cam.w / 2, (p.y - cam.y) * cam.zoom + cam.h / 2);
}

fn screen_to_world(cam, p) {
    return vec2((p.x - cam.w / 2) / cam.zoom + cam.x, (p.y - cam.h / 2) / cam.zoom + cam.y);
}

fn camera_follow(cam, target, smoothing = nil) {
    if smoothing == nil { smoothing = 1; }
    cam.x = cam.x + (target.x - cam.x) * smoothing;
    cam.y = cam.y + (target.y - cam.y) * smoothing;
    return cam;
}

// ── Tilemaps ─────────────────────────────────────────────────────────────────

fn tilemap(tile_w, tile_h, rows, solid_ids = nil) {
    if solid_ids == nil { solid_ids = [1]; }
    return map{ tile_w: tile_w, tile_h: tile_h, rows: rows, solid_ids: solid_ids };
}

fn tile_at(tm, tx, ty) {
    if ty < 0 or ty >= len(tm.rows) { return nil; }
    if tx < 0 or tx >= len(tm.rows[ty]) { return nil; }
    return tm.rows[ty][tx];
}

fn is_solid_tile(tm, id) {
    let i = 0;
    while i < len(tm.solid_ids) {
        if tm.solid_ids[i] == id { return true; }
        i = i + 1;
    }
    return false;
}

fn tile_rect(tm, tx, ty) {
    return rect(tx * tm.tile_w, ty * tm.tile_h, tm.tile_w, tm.tile_h);
}

fn tilemap_collisions(tm, bounds) {
    let hits = [];
    let minx = num_floor(bounds.x / tm.tile_w);
    let miny = num_floor(bounds.y / tm.tile_h);
    let maxx = num_floor((bounds.x + bounds.w) / tm.tile_w);
    let maxy = num_floor((bounds.y + bounds.h) / tm.tile_h);
    let ty = miny;
    while ty <= maxy {
        let tx = minx;
        while tx <= maxx {
            let id = tile_at(tm, tx, ty);
            if id != nil and is_solid_tile(tm, id) {
                let tr = tile_rect(tm, tx, ty);
                if rect_overlaps(bounds, tr) { array_push(hits, map{ id: id, tx: tx, ty: ty, rect: tr }); }
            }
            tx = tx + 1;
        }
        ty = ty + 1;
    }
    return hits;
}

fn resolve_aabb_static(moving, solid) {
    if not rect_overlaps(moving, solid) { return map{ rect: moving, normal: vec2(0, 0), depth: 0 }; }
    let ac = rect_center(moving);
    let bc = rect_center(solid);
    let dx = ac.x - bc.x;
    let dy = ac.y - bc.y;
    let px = (moving.w + solid.w) / 2 - _abs(dx);
    let py = (moving.h + solid.h) / 2 - _abs(dy);
    if px < py {
        if dx < 0 { moving.x = moving.x - px; return map{ rect: moving, normal: vec2(-1, 0), depth: px }; }
        moving.x = moving.x + px; return map{ rect: moving, normal: vec2(1, 0), depth: px };
    }
    if dy < 0 { moving.y = moving.y - py; return map{ rect: moving, normal: vec2(0, -1), depth: py }; }
    moving.y = moving.y + py; return map{ rect: moving, normal: vec2(0, 1), depth: py };
}

fn _abs(v) { if v < 0 { return 0 - v; } return v; }

// ── Spatial hash broadphase ──────────────────────────────────────────────────

fn spatial_hash(cell_size) { return map{ cell_size: cell_size, cells: map{} }; }

fn _cell_key(x, y) { return str(x) + "," + str(y); }

fn spatial_clear(grid) { grid.cells = map{}; }

fn spatial_insert(grid, id, bounds) {
    let minx = num_floor(bounds.x / grid.cell_size);
    let miny = num_floor(bounds.y / grid.cell_size);
    let maxx = num_floor((bounds.x + bounds.w) / grid.cell_size);
    let maxy = num_floor((bounds.y + bounds.h) / grid.cell_size);
    let y = miny;
    while y <= maxy {
        let x = minx;
        while x <= maxx {
            let k = _cell_key(x, y);
            let bucket0 = try grid.cells[k] catch nil;
            if bucket0 == nil { grid.cells[k] = []; }
            array_push(grid.cells[k], id);
            x = x + 1;
        }
        y = y + 1;
    }
}

fn spatial_query(grid, bounds) {
    let seen = map{};
    let out = [];
    let minx = num_floor(bounds.x / grid.cell_size);
    let miny = num_floor(bounds.y / grid.cell_size);
    let maxx = num_floor((bounds.x + bounds.w) / grid.cell_size);
    let maxy = num_floor((bounds.y + bounds.h) / grid.cell_size);
    let y = miny;
    while y <= maxy {
        let x = minx;
        while x <= maxx {
            let k = _cell_key(x, y);
            let bucket = try grid.cells[k] catch nil;
            if bucket != nil {
                let i = 0;
                while i < len(bucket) {
                    let id = bucket[i];
                    let was_seen = try seen[id] catch nil;
                    if was_seen == nil { seen[id] = true; array_push(out, id); }
                    i = i + 1;
                }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return out;
}

// ── Input, scenes, particles ─────────────────────────────────────────────────

fn input_state() { return map{ down: map{}, pressed: map{}, released: map{} }; }

fn input_begin_frame(input) {
    input.pressed = map{};
    input.released = map{};
}

fn input_set(input, key, is_down) {
    let was = (try input.down[key] catch false) == true;
    input.down[key] = is_down;
    if is_down and not was { input.pressed[key] = true; }
    if not is_down and was { input.released[key] = true; }
}

fn input_down(input, key) { return (try input.down[key] catch false) == true; }
fn input_pressed(input, key) { return (try input.pressed[key] catch false) == true; }
fn input_released(input, key) { return (try input.released[key] catch false) == true; }

fn scene(name) { return map{ name: name, entities: [], systems: [] }; }
fn scene_add(scene_, entity) { array_push(scene_.entities, entity); return entity; }
fn scene_system(scene_, fn_) { array_push(scene_.systems, fn_); return fn_; }
fn scene_update(scene_, dt) {
    let i = 0;
    while i < len(scene_.systems) { scene_.systems[i](scene_, dt); i = i + 1; }
}

fn particle(pos, vel, life, color) {
    return map{ pos: pos, vel: vel, life: life, max_life: life, color: color };
}

fn particle_emitter(x, y, rate, life) {
    return map{ pos: vec2(x, y), rate: rate, life: life, particles: [], carry: 0 };
}

fn particle_update(emitter, dt_seconds) {
    emitter.carry = emitter.carry + emitter.rate * dt_seconds;
    while emitter.carry >= 1 {
        emitter.carry = emitter.carry - 1;
        array_push(emitter.particles, particle(emitter.pos, random_vec2(-40, 40, -80, 0), emitter.life, random_color()));
    }
    let alive = [];
    let i = 0;
    while i < len(emitter.particles) {
        let p = emitter.particles[i];
        p.life = p.life - dt_seconds;
        p.pos = apply_velocity(p.pos, p.vel, dt_seconds);
        if p.life > 0 { array_push(alive, p); }
        i = i + 1;
    }
    emitter.particles = alive;
    return emitter.particles;
}

export vec2, vec2_add, vec2_sub, vec2_scale, vec2_dot, vec2_cross;
export vec2_mag, vec2_mag2, vec2_norm, vec2_dist, vec2_lerp;
export vec2_angle, vec2_from_angle, vec2_rotate, vec2_reflect;
export vec3, vec3_add, vec3_sub, vec3_scale, vec3_dot, vec3_cross;
export vec3_mag, vec3_norm, vec3_dist, vec3_lerp;
export rect, rect_contains_point, rect_overlaps, rect_center, rect_from_center;
export circle, circle_contains_point, circle_overlaps;
export aabb_vs_aabb, circle_vs_circle, circle_vs_aabb;
export point_vs_rect, point_vs_circle, line_vs_line;
export sprite_frame, animate_frame;
export game_loop_init, game_loop_update, game_loop_should_fixed_update;
export apply_velocity, apply_acceleration, apply_friction, apply_gravity;
export random_range, random_vec2, random_color;
export camera2d, world_to_screen, screen_to_world, camera_follow;
export tilemap, tile_at, is_solid_tile, tile_rect, tilemap_collisions, resolve_aabb_static;
export spatial_hash, spatial_clear, spatial_insert, spatial_query;
export input_state, input_begin_frame, input_set, input_down, input_pressed, input_released;
export scene, scene_add, scene_system, scene_update;
export particle, particle_emitter, particle_update;
