let Doc=import("stdlib:text_document.sapp");let Diff=import("stdlib:sequence_diff.sapp");let Serialization=import("stdlib:serialization.sapp");
let FORMAT="pblang.document-comparison.v1";
fn _keys(doc) {let keys=[];for block in doc.blocks {array_push(keys,block.kind+"\u0000"+block.text);}return keys;}
fn compare(left,right) {
    Doc.validate(left);Doc.validate(right);let diff=Diff.compare(_keys(left),_keys(right));let entries=[];
    if left.title!=right.title {array_push(entries,map{kind:"title",left:nil,right:nil,block:map{kind:"title",text:"Before:\n"+left.title+"\nAfter:\n"+right.title}});}
    for op in diff.operations {
        let block=if op.kind=="insert" {right.blocks[op.right]} else {left.blocks[op.left]};
        array_push(entries,map{kind:op.kind,left:op.left,right:op.right,block:map{kind:block.kind,text:block.text}});
    }
    return map{format:FORMAT,left_title:left.title,right_title:right.title,title_changed:left.title!=right.title,
        equal:diff.equal,inserted:diff.inserted,deleted:diff.deleted,identical:left.title==right.title and diff.inserted==0 and diff.deleted==0,entries:entries};
}
fn summary(report) {
    return str(report.equal)+" unchanged | "+str(report.inserted)+" inserted | "+str(report.deleted)+" removed | Title "+if report.title_changed {"changed"} else {"unchanged"};
}
// Regenerate from validated documents, never trust a caller-supplied report.
fn encode(left,right) {
    let result=Serialization.stringify_safe(compare(left,right),"json",map{max_output_bytes:524288,max_depth:8,max_items:4096,strict:true});
    if not result.ok {throw "document compare: report serialization failed";}return result.value;
}
export FORMAT,compare,summary,encode;
