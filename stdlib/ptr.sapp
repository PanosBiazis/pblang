// Pointer-like refs (no VM architecture changes).
//
// A "ptr" is just a box: map{ v: <value> }.
// A "ref" is a closure-based accessor for map/array slots.

fn new(v) { return map{ v: v }; }
fn get(p) { return p.v; }
fn set(p, v) { p.v = v; return v; }
fn swap(a, b) { let t = a.v; a.v = b.v; b.v = t; return nil; }

fn ref_map(m, key) {
    return map{
        get: fn() { return m[key]; },
        set: fn(v) { m[key] = v; return v; }
    };
}

fn ref_array(a, idx) {
    return map{
        get: fn() { return a[idx]; },
        set: fn(v) { a[idx] = v; return v; }
    };
}

// update(p, fn) — apply fn to the boxed value in place; returns the new value.
fn update(p, fn_) { p.v = fn_(p.v); return p.v; }

// is_ptr(x) — true if x looks like a ptr box (a map with a `v` slot).
fn is_ptr(x) { if not is_map(x) { return false; } return map_has(x, "v"); }

// clone(p) — a new, independent box holding the same value.
fn clone(p) { return map{ v: p.v }; }

// map_ptr(p, fn) — a NEW ptr holding fn(p.v); the original is left unchanged.
fn map_ptr(p, fn_) { return map{ v: fn_(p.v) }; }

// take(p) — return the boxed value and reset the box to nil (move-out).
fn take(p) { let v = p.v; p.v = nil; return v; }

export new, get, set, swap, ref_map, ref_array, update, is_ptr, clone, map_ptr, take;

