// Identifier-minimized physical-device claim schema shared by PBLang/PBRemote/PBSpotIt.
// This contract grants no device, network, input, sensor, or remote authority.

let FORMAT="pblang.device-evidence.v1";
let ADMISSION_FORMAT="pblang.device-evidence.admission.v1";

fn _exact(row,fields) {
    if type(row)!="map" or len(row)!=len(fields) { return false; }
    for field in fields { if not map_has(row,field) { return false; } }
    return true;
}

fn _token(value) {
    return type(value)=="string" and len(value)>=1 and len(value)<=64
        and regex_match(value,"^[a-z0-9][a-z0-9._-]{0,63}$");
}

fn _tokens(values,maximum) {
    if type(values)!="array" or len(values)<1 or len(values)>maximum { return false; }
    let seen=map{};
    for value in values {
        if not _token(value) or map_has(seen,value) { return false; }
        seen[value]=true;
    }
    return true;
}

fn validate(row) {
    let fields=["format","evidence_id","artifact_sha256","device_class",
        "platform","api_level","capabilities","product_scopes","physical",
        "attended","consent_confirmed","observed_ms","expires_ms"];
    if not _exact(row,fields) { return map{ok:false,error:"exact-schema-required"}; }
    if row.format!=FORMAT { return map{ok:false,error:"format-mismatch"}; }
    if not _token(row.evidence_id) { return map{ok:false,error:"invalid-evidence-id"}; }
    if type(row.artifact_sha256)!="string" or not regex_match(row.artifact_sha256,"^[0-9a-f]{64}$") {
        return map{ok:false,error:"invalid-artifact-digest"};
    }
    if row.device_class!="android-phone" and row.device_class!="linux-laptop"
       and row.device_class!="windows-laptop" and row.device_class!="macos-computer" {
        return map{ok:false,error:"unsupported-device-class"};
    }
    if row.platform!="android" and row.platform!="linux" and row.platform!="windows"
       and row.platform!="macos" { return map{ok:false,error:"unsupported-platform"}; }
    if (row.device_class=="android-phone" and row.platform!="android")
       or (row.device_class=="linux-laptop" and row.platform!="linux")
       or (row.device_class=="windows-laptop" and row.platform!="windows")
       or (row.device_class=="macos-computer" and row.platform!="macos") {
        return map{ok:false,error:"device-platform-mismatch"};
    }
    if type(row.api_level)!="number" or row.api_level!=num_floor(row.api_level)
       or row.api_level<0 or row.api_level>1000 { return map{ok:false,error:"invalid-api-level"}; }
    if not _tokens(row.capabilities,64) or not _tokens(row.product_scopes,8) {
        return map{ok:false,error:"invalid-capabilities-or-product-scopes"};
    }
    if type(row.physical)!="bool" or type(row.attended)!="bool"
       or type(row.consent_confirmed)!="bool" { return map{ok:false,error:"invalid-policy-boolean"}; }
    if type(row.observed_ms)!="number" or row.observed_ms!=num_floor(row.observed_ms)
       or row.observed_ms<0 or type(row.expires_ms)!="number"
       or row.expires_ms!=num_floor(row.expires_ms) or row.expires_ms<=row.observed_ms
       or row.expires_ms-row.observed_ms>604800000 {
        return map{ok:false,error:"invalid-evidence-window"};
    }
    return map{ok:true};
}

fn admit(row, current_ms) {
    let checked=validate(row);
    if not checked.ok { return map{ok:false,format:ADMISSION_FORMAT,error:checked.error,
        evidence_usable:false,authority_granted:false,safe_to_log:false,
        caller_metadata_returned:false}; }
    if type(current_ms)!="number" or current_ms!=num_floor(current_ms)
       or current_ms<row.observed_ms or current_ms>=row.expires_ms {
        return map{ok:false,format:ADMISSION_FORMAT,error:"evidence-expired-or-clock-invalid",
            evidence_usable:false,authority_granted:false,safe_to_log:false,
            caller_metadata_returned:false};
    }
    if not row.physical or not row.attended or not row.consent_confirmed {
        return map{ok:false,format:ADMISSION_FORMAT,error:"physical-attended-consent-required",
            evidence_usable:false,authority_granted:false,safe_to_log:false,
            caller_metadata_returned:false};
    }
    return map{ok:true,format:ADMISSION_FORMAT,schema_eligible_for_review:true,
        evidence_usable:false,physical_verified:false,attended_verified:false,
        consent_verified:false,freshness_verified:false,trusted_clock_used:false,
        explicit_serial_or_network_fields_absent:true,
        semantic_identifier_verification:false,identifier_free_verified:false,
        serial_recorded:false,network_address_recorded:false,
        authority_granted:false,remote_control_allowed:false,safe_to_log:false,
        caller_metadata_returned:false,
        policy:"caller claims are schema-eligible only; independent verifier identity, signature and trusted time are required before product evidence can be usable"};
}

export FORMAT, ADMISSION_FORMAT, validate, admit;
