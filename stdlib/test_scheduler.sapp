// Memory-aware test worker planning implemented in PBLang.
//
// Large product suites load independent compiler/runtime graphs per worker.
// CPU count alone is therefore not a safe parallelism limit. The planner keeps
// a host reserve, applies a workload-specific worker estimate and remains fully
// deterministic when available_mb/cpu_count are supplied by tests or CI.

let OS = import("stdlib:os.sapp");

fn _option(options, key, fallback) {
    if options == nil or type(options) != "map" or not map_has(options, key) { return fallback; }
    let value = options[key]; return if value == nil { fallback } else { value };
}

fn _positive(value, fallback, maximum, label) {
    if type(value) != "number" or num_floor(value) != value or value < 1 or value > maximum {
        if fallback == nil { throw "test_scheduler: invalid " + label; }
        return fallback;
    }
    return value;
}

fn _smaller(a, b) { return if a < b { a } else { b }; }

fn _number(options, key, fallback) {
    let value = _option(options, key, fallback);
    if type(value) != "number" { return fallback; }
    return value;
}

fn _bool(options, key, fallback) {
    let value = _option(options, key, fallback);
    return if type(value) == "bool" { value } else { fallback };
}

fn linux_available_mb() {
    if OS.platform() != "linux" { return nil; }
    let text = try fs_read("/proc/meminfo") catch nil;
    if type(text) != "string" or len(text) > 65536 { return nil; }
    let lines = str_split(text, "\n"); let i = 0;
    while i < len(lines) {
        if str_starts_with(lines[i], "MemAvailable:") {
            let fields = str_split(str_trim(lines[i]), " "); let j = 0; let compact = [];
            while j < len(fields) {
                if fields[j] != "" { array_push(compact, fields[j]); }
                j = j + 1;
            }
            if len(compact) >= 2 {
                let kib = try parse_number(compact[1]) catch nil;
                if kib != nil and kib >= 1024 { return num_floor(kib / 1024); }
            }
            return nil;
        }
        i = i + 1;
    }
    return nil;
}

fn plan(options = nil) {
    let profile = str_lower(str(_option(options, "profile", "standard")));
    if profile != "standard" and profile != "large-product"
        and profile != "physical-device" and profile != "sustained-soak" {
        throw "test_scheduler: unknown workload profile";
    }
    let cpus = _positive(_option(options, "cpu_count", OS.cpu_count()), 1, 1024, "CPU count");
    let serialized = profile == "physical-device" or profile == "sustained-soak";
    let default_max_jobs = if serialized { 1 } else { cpus };
    let max_jobs = _positive(
        _option(options, "max_jobs", default_max_jobs), default_max_jobs, 1024, "maximum jobs");
    let default_worker = 512;
    if profile == "large-product" { default_worker = 1536; }
    elif profile == "physical-device" { default_worker = 256; }
    elif profile == "sustained-soak" { default_worker = 384; }
    let worker_mb = _positive(_option(options, "worker_mb", default_worker), nil, 1048576, "worker memory");
    let reserve_mb = _positive(_option(options, "reserve_mb", 1024), nil, 1048576, "memory reserve");
    let available = _option(options, "available_mb", linux_available_mb());
    let memory_jobs = 1; let memory_limited = false;
    if type(available) == "number" and num_floor(available) == available and available >= 1 {
        let usable = available - reserve_mb;
        memory_jobs = if usable < worker_mb { 1 } else { num_floor(usable / worker_mb) };
        if memory_jobs < 1 { memory_jobs = 1; }
        memory_limited = memory_jobs < cpus;
    } else {
        // Unknown memory must not silently expand a large suite to every CPU.
        memory_jobs = if profile == "large-product" { 2 }
            else { if serialized { 1 } else { cpus } };
        memory_limited = profile == "large-product" or serialized;
    }
    let jobs = _smaller(_smaller(cpus, max_jobs), memory_jobs);
    if jobs < 1 { jobs = 1; }
    let target_cpu_percent = 90;
    if profile == "large-product" { target_cpu_percent = 75; }
    elif profile == "physical-device" { target_cpu_percent = 40; }
    elif profile == "sustained-soak" { target_cpu_percent = 30; }
    return map{ format: "pblang.test-scheduler.plan.v2", profile: profile,
        jobs: jobs, cpu_count: cpus, available_mb: available,
        reserve_mb: reserve_mb, worker_mb: worker_mb,
        memory_cap: memory_jobs, memory_limited: memory_limited,
        target_cpu_percent: target_cpu_percent,
        device_lane_serialized: serialized,
        recommendation: if serialized {
            "serialize access to each physical device; parallelize only independent host-only tests"
        } else { "run independent files in isolated workers and reuse unchanged passing results" } };
}

// Convert a live device sample into deterministic pacing and admission limits.
// Product verifiers pass their own sampled values, so this remains portable and
// testable without probing private device state from the language runtime.
fn device_policy(sample = nil, options = nil) {
    let value = if type(sample) == "map" { sample } else { map{} };
    let maximum_temperature_c = _number(options, "maximum_temperature_c", 45);
    let warning_temperature_c = _number(options, "warning_temperature_c", 40);
    let minimum_battery_percent = _number(options, "minimum_battery_percent", 10);
    let maximum_pss_kib = _number(options, "maximum_pss_kib", 131072);
    if maximum_temperature_c <= warning_temperature_c
        or warning_temperature_c < -20 or maximum_temperature_c > 100
        or minimum_battery_percent < 0 or minimum_battery_percent > 100
        or maximum_pss_kib < 1024 {
        throw "test_scheduler: invalid physical-device safety limits";
    }

    let temperature_c = _number(value, "temperature_c", nil);
    let battery_percent = _number(value, "battery_percent", nil);
    let pss_kib = _number(value, "pss_kib", nil);
    let powered = _bool(value, "powered", false);
    let power_save = _bool(value, "power_save", false);
    let allowed = true; let reason = "within-budget"; let pressure = "normal";
    if temperature_c != nil and temperature_c >= maximum_temperature_c {
        allowed = false; pressure = "critical"; reason = "temperature-limit";
    } elif pss_kib != nil and pss_kib > maximum_pss_kib {
        allowed = false; pressure = "critical"; reason = "memory-limit";
    } elif battery_percent != nil and battery_percent <= minimum_battery_percent and not powered {
        allowed = false; pressure = "critical"; reason = "battery-limit";
    } elif (temperature_c != nil and temperature_c >= warning_temperature_c)
        or (pss_kib != nil and pss_kib * 100 >= maximum_pss_kib * 85)
        or power_save {
        pressure = "elevated"; reason = "adaptive-throttle";
    }

    let loop_pause_ms = if pressure == "elevated" { 20 } else { 5 };
    let health_probe_interval_ms = if pressure == "elevated" { 5000 } else { 2000 };
    let host_poll_batch = if pressure == "elevated" { 8 } else { 32 };
    return map{ format: "pblang.test-scheduler.device-policy.v1",
        allowed: allowed, reason: reason, pressure: pressure,
        loop_pause_ms: loop_pause_ms,
        health_probe_interval_ms: health_probe_interval_ms,
        host_poll_batch: host_poll_batch,
        device_jobs: 1, device_lane_serialized: true,
        maximum_temperature_c: maximum_temperature_c,
        warning_temperature_c: warning_temperature_c,
        minimum_battery_percent: minimum_battery_percent,
        maximum_pss_kib: maximum_pss_kib };
}

export linux_available_mb, plan, device_policy;
