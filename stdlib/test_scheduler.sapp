// Memory-aware test worker planning implemented in PBLang.
//
// Large product suites load independent compiler/runtime graphs per worker.
// CPU count alone is therefore not a safe parallelism limit. The planner keeps
// a host reserve, applies a workload-specific worker estimate and remains fully
// deterministic when available_mb/cpu_count are supplied by tests or CI.

let OS = import("stdlib:os.sapp");

fn _option(options, key, fallback) {
    if options == nil or type(options) != "map" or not map_has(options, key) { return fallback; }
    let value = options[key]; return if value == nil { fallback } else { value };
}

fn _positive(value, fallback, maximum, label) {
    if type(value) != "number" or num_floor(value) != value or value < 1 or value > maximum {
        if fallback == nil { throw "test_scheduler: invalid " + label; }
        return fallback;
    }
    return value;
}

fn _smaller(a, b) { return if a < b { a } else { b }; }

fn linux_available_mb() {
    if OS.platform() != "linux" { return nil; }
    let text = try fs_read("/proc/meminfo") catch nil;
    if type(text) != "string" or len(text) > 65536 { return nil; }
    let lines = str_split(text, "\n"); let i = 0;
    while i < len(lines) {
        if str_starts_with(lines[i], "MemAvailable:") {
            let fields = str_split(str_trim(lines[i]), " "); let j = 0; let compact = [];
            while j < len(fields) {
                if fields[j] != "" { array_push(compact, fields[j]); }
                j = j + 1;
            }
            if len(compact) >= 2 {
                let kib = try parse_number(compact[1]) catch nil;
                if kib != nil and kib >= 1024 { return num_floor(kib / 1024); }
            }
            return nil;
        }
        i = i + 1;
    }
    return nil;
}

fn plan(options = nil) {
    let profile = str_lower(str(_option(options, "profile", "standard")));
    if profile != "standard" and profile != "large-product" {
        throw "test_scheduler: unknown workload profile";
    }
    let cpus = _positive(_option(options, "cpu_count", OS.cpu_count()), 1, 1024, "CPU count");
    let max_jobs = _positive(_option(options, "max_jobs", cpus), cpus, 1024, "maximum jobs");
    let default_worker = if profile == "large-product" { 1536 } else { 512 };
    let worker_mb = _positive(_option(options, "worker_mb", default_worker), nil, 1048576, "worker memory");
    let reserve_mb = _positive(_option(options, "reserve_mb", 1024), nil, 1048576, "memory reserve");
    let available = _option(options, "available_mb", linux_available_mb());
    let memory_jobs = 1; let memory_limited = false;
    if type(available) == "number" and num_floor(available) == available and available >= 1 {
        let usable = available - reserve_mb;
        memory_jobs = if usable < worker_mb { 1 } else { num_floor(usable / worker_mb) };
        if memory_jobs < 1 { memory_jobs = 1; }
        memory_limited = memory_jobs < cpus;
    } else {
        // Unknown memory must not silently expand a large suite to every CPU.
        memory_jobs = if profile == "large-product" { 2 } else { cpus };
        memory_limited = profile == "large-product";
    }
    let jobs = _smaller(_smaller(cpus, max_jobs), memory_jobs);
    if jobs < 1 { jobs = 1; }
    return map{ format: "pblang.test-scheduler.plan.v1", profile: profile,
        jobs: jobs, cpu_count: cpus, available_mb: available,
        reserve_mb: reserve_mb, worker_mb: worker_mb,
        memory_cap: memory_jobs, memory_limited: memory_limited };
}

export linux_available_mb, plan;
