// Internal worker boundary: no imports or application globals. Results remain
// in completion order, and task exceptions fail the owning pool after cleanup.
fn _queue(sender, tasks) {
    for value in tasks { send(sender, map{value:value}); }
    return true;
}

fn run(size, tasks, mapper) {
    let n = len(tasks);
    if not is_number(size) { throw "thread.thread_pool: invalid internal size"; }
    if size - size != 0 or size < 1 or size > n or size != num_floor(size) {
        throw "thread.thread_pool: invalid internal size";
    }
    let jobs = channel_buffered(n);
    // Validate transfer before starting any worker. Nil and marker-shaped maps
    // are wrapped as ordinary data; no shutdown sentinel can collide with them.
    let queued = try _queue(jobs.sender, tasks) catch false;
    channel_close(jobs.sender);
    if not queued {
        while recv_timeout(jobs.receiver, 0) != nil {}
        throw "thread.thread_pool: task transfer failed";
    }
    let results = try channel_buffered(n) catch nil;
    if results == nil {
        while recv_timeout(jobs.receiver, 0) != nil {}
        throw "thread.thread_pool: result channel unavailable";
    }
    let workers = [];
    let started = true;
    for i size {
        let worker = try spawn(fn() {
            while true {
                let job = recv(jobs.receiver);
                if job == nil { return nil; }
                send(results.sender, map{value:mapper(job.value)});
            }
        }) catch nil;
        if worker == nil { started = false; break; }
        array_push(workers, worker);
    }
    // At most n results fit without a parent receive, including partial launch.
    // Continue joining after failure; cleanup is not cancellation or rollback.
    let joined = true;
    for worker in workers {
        let done = try {join(worker); true} catch false;
        if not done { joined = false; }
    }
    channel_close(results.sender);
    if not started or not joined {
        while recv_timeout(jobs.receiver, 0) != nil {}
        while recv_timeout(results.receiver, 0) != nil {}
        if not started { throw "thread.thread_pool: worker could not start"; }
        throw "thread.thread_pool: worker failed";
    }
    let out = [];
    for i n {
        let result = recv_timeout(results.receiver, 0);
        if result == nil { throw "thread.thread_pool: missing result"; }
        array_push(out, result.value);
    }
    return out;
}
export run;
