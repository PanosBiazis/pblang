let T=import("stdlib:timeline_document.sapp");let Slots=import("stdlib:timeline_slots.sapp");let Files=import("stdlib:timeline_files.sapp");let UI=import("stdlib:modern_ui.sapp");let G=import("stdlib:gui.sapp");
fn sample(){let d=T.create("Synthetic workshop");d=T.set_entry(d,0,"Setup",60000,120000);d=T.append(d,"Session",180000,240000);return T.append(d,"Discussion",210000,300000);}
fn _index(index,count){if type(index)!="number" or not(index>=0 and index<num_max(1,count)) or index!=num_floor(index){throw "slot view: invalid selection";}}
fn _text(report,index){_index(index,len(report.slots));if len(report.slots)==0{return "No matching free slot.";}let s=report.slots[index];return "Slot "+str(index+1)+"\nStart: "+str(s.start_ms)+" ms\nEnd: "+str(s.end_ms)+" ms\nDuration: "+str(s.duration_ms)+" ms";}
fn view(doc,start_ms,end_ms,minimum_ms=1,index=0){let report=Slots.find(doc,start_ms,end_ms,minimum_ms);_index(index,len(report.slots));let texts=["No matching free slot.","",""];
    if len(report.slots)>0{let slot=report.slots[index];texts=["Start: "+str(slot.start_ms)+" ms","End: "+str(slot.end_ms)+" ms","Duration: "+str(slot.duration_ms)+" ms"];}
    let show=[];let hide=[];let children=[UI.heading("PBSlotFinder"),UI.text("Window ["+str(start_ms)+", "+str(end_ms)+") ms"),UI.text("Minimum: "+str(minimum_ms)+" ms"),UI.text("Matches: "+str(len(report.slots))+" | Selection: "+str(if len(report.slots)==0 {0} else {index+1}))];
    for i in range(0,3){let name="slot_"+str(i);array_push(children,UI.text(texts[i],map{name:name}));array_push(show,UI.action_set_text(name,texts[i]));array_push(hide,UI.action_set_text(name,if i==0 {"Slot hidden."} else {""}));}
    array_push(children,UI.row([UI.button("Show slot",UI.action_sequence(show)),UI.button("Hide slot",UI.action_sequence(hide))]));array_push(children,UI.text("Timing snapshot. No resources or reservations checked."));return UI.screen(children);
}
fn _message(form,text){let w=G.get(form,"status");w.text=text;form.dirty=true;}
fn _settings(form){return json_stringify([G.get(form,"window_start").value,G.get(form,"window_end").value,G.get(form,"minimum").value]);}
fn _parameters(form){return [parse_number(G.get(form,"window_start").value),parse_number(G.get(form,"window_end").value),parse_number(G.get(form,"minimum").value)];}
fn _show(form,state){let report=state.report;let count=G.get(form,"summary");count.text="Matches: "+str(len(report.slots))+" | Minimum: "+str(report.minimum_ms)+" ms | Total free: "+str(report.free_ms)+" ms";let window=G.get(form,"window");window.text="Computed window ["+str(report.start_ms)+", "+str(report.end_ms)+") ms | Matching time: "+str(report.matching_ms)+" ms";let area=G.get(form,"result");area.value=_text(report,state.index);form.dirty=true;}
fn _calculate(form,doc){let params=_parameters(form);return Slots.find(doc,params[0],params[1],params[2]);}
fn _accept(form,state,doc,report){state.doc=doc;state.report=report;state.index=0;state.settings=_settings(form);_show(form,state);}
fn act(form,state,action){
    if action=="open"{let loaded=Files.open(G.get(form,"input").value);if not loaded.ok{_message(form,loaded.error);return;}let report=try _calculate(form,loaded.document) catch nil;if report==nil{_message(form,"Invalid window or minimum duration. Previous source/result retained.");return;}_accept(form,state,loaded.document,report);_message(form,"Opened and searched. Source unchanged.");return;}
    if action=="calculate"{let report=try _calculate(form,state.doc) catch nil;if report==nil{_message(form,"Invalid window or minimum duration. Previous result retained.");return;}_accept(form,state,state.doc,report);_message(form,"Searched the loaded timeline. No reservation made.");return;}
    if action=="previous"{state.index=num_max(0,state.index-1);_show(form,state);return;}
    if action=="next"{state.index=num_min(num_max(0,len(state.report.slots)-1),state.index+1);_show(form,state);return;}
    if action=="save_all" or action=="save_one"{
        if state.settings!=_settings(form){_message(form,"Search the changed window/minimum before exporting.");return;}
        let r=state.report;let index=if action=="save_one" {state.index} else {nil};let candidate=try Slots.to_timeline(state.doc,r.start_ms,r.end_ms,r.minimum_ms,index) catch nil;
        if candidate==nil{_message(form,"No slot to export, or more than 64 slots. Select one when there are 65.");return;}
        let saved=Files.save(G.get(form,"output").value,candidate);if saved.ok {_message(form,"New free-slot timeline saved. Source unchanged; no reservation made.");} else {_message(form,saved.error);}
    }
}
fn _button(state,label,action){return UI.button(label,fn(form){act(form,state,action);},map{name:action});}
fn build(){let doc=sample();let state=map{doc:doc,report:Slots.find(doc,0,600000,60000),index:0,settings:""};
    let tree=UI.screen([UI.heading("PBSlotFinder"),UI.text("Find free time inside an explicit window. Every source activity is treated as busy."),UI.input("",map{name:"input",placeholder:"Input .pbtimeline path",max_chars:4096}),_button(state,"Open and search","open"),UI.text("Window start, end and minimum slot duration, in integer milliseconds"),UI.row([UI.input("0",map{name:"window_start",max_chars:12}),UI.input("600000",map{name:"window_end",max_chars:12}),UI.input("60000",map{name:"minimum",max_chars:12})]),_button(state,"Search loaded timeline","calculate"),UI.text("",map{name:"window"}),UI.text("",map{name:"summary"}),UI.area("",map{name:"result",readonly:true,h:140,max_chars:512}),UI.row([_button(state,"Previous slot","previous"),_button(state,"Next slot","next")]),UI.input("",map{name:"output",placeholder:"New free-slot .pbtimeline path",max_chars:4096}),UI.row([_button(state,"Save selected slot","save_one"),_button(state,"Save all matches","save_all")]),UI.text("",map{name:"status"})]);
    let form=UI.build("PBSlotFinder",tree,map{width:1100,height:1000,theme:"dark"});state.settings=_settings(form);_show(form,state);_message(form,"Synthetic example. Times only; source labels are omitted from exports.");return map{form:form,state:state};
}
fn run(){let e=build();G.run(e.form);}
export sample,view,build,act,run;
