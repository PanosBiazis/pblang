// Portable read-only diagnostic pages. Groups are separate exports; no file I/O.
let Check=import("stdlib:document_merge_check.sapp");let Pages=import("stdlib:text_pages.sapp");let UI=import("stdlib:modern_ui.sapp");
fn create(template,table,group=0) {
 let result=Check.inspect(template,table);let parts=[];
 for i in range(0,len(result.issues)) {
  for lines in Pages.paginate(Check.describe(result.issues[i]),24,8) {array_push(parts,map{label:"Issue "+str(i+1)+" / "+str(len(result.issues)),lines:lines});}
 }
 if len(parts)==0 {array_push(parts,map{label:"No issues found",lines:["Run merge to create", "a document preview."]});}
 let groups=num_ceil(len(parts)/8);
 if type(group)!="number" or not (group>=0 and group<groups) or group!=num_floor(group) {throw "invalid check view group";}
 let first=group*8;let children=[UI.heading("PBMerge input check"),UI.text(if result.ready {"Ready to merge"} else {"Needs correction"}),
  UI.text(str(result.records)+" records | "+str(result.errors)+" errors"),UI.text(str(result.warnings)+" warnings | "+str(result.omitted)+" issues omitted"),
  UI.text("Group "+str(group+1)+" / "+str(groups)),UI.text(parts[first].label,map{name:"position"})];
 for line in range(0,8) {array_push(children,UI.text(if line<len(parts[first].lines) {parts[first].lines[line]} else {""},map{name:"line_"+str(line)}));}
 let buttons=[];
 for i in range(first,num_min(first+8,len(parts))) {
  let actions=[UI.action_set_text("position",parts[i].label)];
  for line in range(0,8) {array_push(actions,UI.action_set_text("line_"+str(line),if line<len(parts[i].lines) {parts[i].lines[line]} else {""}));}
  array_push(buttons,UI.button(str(i+1),UI.action_sequence(actions),map{name:"part_"+str(i)}));
 }
 array_push(children,UI.grid(buttons,map{columns:4}));array_push(children,UI.text("Saved input-check snapshot."));array_push(children,UI.text("Recheck after changing files."));
 return UI.screen(children);
}
export create;
