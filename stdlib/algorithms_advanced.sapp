//! Advanced, deterministic algorithms implemented entirely in pblang.

let _priority_queue = import("stdlib/min_priority_queue.sapp");

fn binary_search(arr, target) {
    let lo = 0;
    let hi = len(arr) - 1;
    while lo <= hi {
        let mid = num_floor((lo + hi) / 2);
        if arr[mid] == target { return mid; }
        if arr[mid] < target { lo = mid + 1; }
        else { hi = mid - 1; }
    }
    return -1;
}

// A middle pivot avoids the sorted-input recursion cliff. Three-way
// partitioning keeps duplicate-heavy input linear at each recursion level.
fn quick_sort(arr) {
    if len(arr) <= 1 { return arr; }
    let pivot = arr[num_floor(len(arr) / 2)];
    let less = [];
    let equal = [];
    let greater = [];
    let i = 0;
    while i < len(arr) {
        if arr[i] < pivot { array_push(less, arr[i]); }
        else if arr[i] > pivot { array_push(greater, arr[i]); }
        else { array_push(equal, arr[i]); }
        i = i + 1;
    }
    let left = quick_sort(less);
    let right = quick_sort(greater);
    let out = [];
    i = 0;
    while i < len(left) { array_push(out, left[i]); i = i + 1; }
    i = 0;
    while i < len(equal) { array_push(out, equal[i]); i = i + 1; }
    i = 0;
    while i < len(right) { array_push(out, right[i]); i = i + 1; }
    return out;
}

fn merge(left, right) {
    let out = [];
    let li = 0;
    let ri = 0;
    while li < len(left) and ri < len(right) {
        if left[li] <= right[ri] {
            array_push(out, left[li]);
            li = li + 1;
        } else {
            array_push(out, right[ri]);
            ri = ri + 1;
        }
    }
    while li < len(left) { array_push(out, left[li]); li = li + 1; }
    while ri < len(right) { array_push(out, right[ri]); ri = ri + 1; }
    return out;
}

fn merge_sort(arr) {
    if len(arr) <= 1 { return arr; }
    let mid = num_floor(len(arr) / 2);
    let left = [];
    let right = [];
    let i = 0;
    while i < mid { array_push(left, arr[i]); i = i + 1; }
    while i < len(arr) { array_push(right, arr[i]); i = i + 1; }
    return merge(merge_sort(left), merge_sort(right));
}

// O(n*m) time and O(min(n,m)) memory.
fn levenshtein(a, b) {
    if len(a) < len(b) { let tmp = a; a = b; b = tmp; }
    let rows = len(a);
    let cols = len(b);
    if cols == 0 { return rows; }

    let previous = [];
    let j = 0;
    while j <= cols { array_push(previous, j); j = j + 1; }
    let i = 1;
    while i <= rows {
        let current = [i];
        j = 1;
        while j <= cols {
            let cost = if a[i - 1] == b[j - 1] { 0 } else { 1 };
            let insert_cost = current[j - 1] + 1;
            let delete_cost = previous[j] + 1;
            let replace_cost = previous[j - 1] + cost;
            let best = insert_cost;
            if delete_cost < best { best = delete_cost; }
            if replace_cost < best { best = replace_cost; }
            array_push(current, best);
            j = j + 1;
        }
        previous = current;
        i = i + 1;
    }
    return previous[cols];
}

fn lcs(a, b) {
    let rows = len(a);
    let cols = len(b);
    let table = [];
    let i = 0;
    while i <= rows {
        let row = [];
        let j = 0;
        while j <= cols { array_push(row, 0); j = j + 1; }
        array_push(table, row);
        i = i + 1;
    }
    i = 1;
    while i <= rows {
        let j = 1;
        while j <= cols {
            if a[i - 1] == b[j - 1] {
                table[i][j] = table[i - 1][j - 1] + 1;
            } else {
                table[i][j] = table[i - 1][j];
                if table[i][j - 1] > table[i][j] { table[i][j] = table[i][j - 1]; }
            }
            j = j + 1;
        }
        i = i + 1;
    }

    let reversed = [];
    let x = rows;
    let y = cols;
    while x > 0 and y > 0 {
        if a[x - 1] == b[y - 1] {
            array_push(reversed, a[x - 1]);
            x = x - 1;
            y = y - 1;
        } else if table[x - 1][y] > table[x][y - 1] {
            x = x - 1;
        } else {
            y = y - 1;
        }
    }
    let out = [];
    i = len(reversed) - 1;
    while i >= 0 { array_push(out, reversed[i]); i = i - 1; }
    return out;
}

// O(V+E): a head index avoids copying the remaining queue on every dequeue.
fn bfs(graph, start) {
    let visited = map{};
    let queue = [start];
    let head = 0;
    let order = [];
    visited[start] = true;
    while head < len(queue) {
        let node = queue[head];
        head = head + 1;
        array_push(order, node);
        let neighbors = try graph[node] catch [];
        let i = 0;
        while i < len(neighbors) {
            let next = neighbors[i];
            if not map_has(visited, next) {
                visited[next] = true;
                array_push(queue, next);
            }
            i = i + 1;
        }
    }
    return order;
}

// Iterative DFS avoids host recursion limits. Reversed pushes preserve the
// same preorder as recursive traversal over the neighbor array.
fn dfs(graph, start) {
    let visited = map{};
    let stack = [start];
    let order = [];
    while len(stack) > 0 {
        let node = array_pop(stack);
        if not map_has(visited, node) {
            visited[node] = true;
            array_push(order, node);
            let neighbors = try graph[node] catch [];
            let i = len(neighbors) - 1;
            while i >= 0 {
                if not map_has(visited, neighbors[i]) { array_push(stack, neighbors[i]); }
                i = i - 1;
            }
        }
    }
    return order;
}

fn fibonacci_dp(n) {
    if n < 0 { throw "algorithms_advanced.fibonacci_dp: n must be non-negative"; }
    if n <= 1 { return n; }
    let a = 0;
    let b = 1;
    let i = 2;
    while i <= n { let next = a + b; a = b; b = next; i = i + 1; }
    return b;
}

// One descending row preserves 0/1 semantics with O(capacity) memory.
fn knapsack_01(weights, values, capacity) {
    if len(weights) != len(values) { throw "algorithms_advanced.knapsack_01: length mismatch"; }
    if not is_number(capacity) or num_floor(capacity) != capacity or capacity < 0 {
        throw "algorithms_advanced.knapsack_01: invalid capacity";
    }
    let dp = [];
    let c = 0;
    while c <= capacity { array_push(dp, 0); c = c + 1; }
    let i = 0;
    while i < len(weights) {
        let weight = weights[i];
        if not is_number(weight) or num_floor(weight) != weight or weight < 0 {
            throw "algorithms_advanced.knapsack_01: invalid weight";
        }
        c = capacity;
        while c >= weight {
            let candidate = values[i] + dp[c - weight];
            if candidate > dp[c] { dp[c] = candidate; }
            c = c - 1;
        }
        i = i + 1;
    }
    return dp[capacity];
}

// O((V+E) log E) Dijkstra with stale-entry suppression. Adjacency values are
// arrays of map{to, weight}; missing adjacency means a leaf node.
fn dijkstra(graph, start) {
    let distances = map{};
    let settled = map{};
    let heap = _priority_queue.new();
    distances[start] = 0;
    _priority_queue.push(heap, start, 0);
    while not _priority_queue.is_empty(heap) {
        let item = _priority_queue.pop(heap);
        let node = item.value;
        if not map_has(settled, node) {
            settled[node] = true;
            let edges = try graph[node] catch [];
            let i = 0;
            while i < len(edges) {
                let edge = edges[i];
                let next = try edge["to"] catch nil;
                let weight = try edge["weight"] catch nil;
                if next == nil or not is_number(weight) {
                    throw "algorithms_advanced.dijkstra: edge requires to and numeric weight";
                }
                if weight < 0 { throw "algorithms_advanced.dijkstra: negative edge weight"; }
                if not map_has(settled, next) {
                    let candidate = item.priority + weight;
                    if not map_has(distances, next) or candidate < distances[next] {
                        distances[next] = candidate;
                        _priority_queue.push(heap, next, candidate);
                    }
                }
                i = i + 1;
            }
        }
    }
    return distances;
}

export binary_search;
export quick_sort;
export merge_sort;
export levenshtein;
export lcs;
export bfs;
export dfs;
export fibonacci_dp;
export knapsack_01;
export dijkstra;
