//! algorithms_advanced.sapp — Advanced algorithms for pblang

fn binary_search(arr, t) { let lo=0; let hi=len(arr)-1; while lo<=hi { let mid=(lo+hi)/2; if arr[mid]==t{return mid;} if arr[mid]<t{lo=mid+1;}else{hi=mid-1;} } return -1; }
fn quick_sort(arr) { if len(arr)<=1{return arr;} let pivot=arr[0]; let less=[];let greater=[]; let i=1; while i<len(arr) { if arr[i]<pivot{array_push(less,arr[i]);}else{array_push(greater,arr[i]);} i=i+1; } let sl=quick_sort(less); let sg=quick_sort(greater); let r=[]; let j=0; while j<len(sl){array_push(r,sl[j]);j=j+1;} array_push(r,pivot); let k=0; while k<len(sg){array_push(r,sg[k]);k=k+1;} return r; }
fn merge_sort(arr) { if len(arr)<=1{return arr;} let mid=len(arr)/2; let left=[];let i=0;while i<mid{array_push(left,arr[i]);i=i+1;} let right=[];let j=mid;while j<len(arr){array_push(right,arr[j]);j=j+1;} return merge(merge_sort(left),merge_sort(right)); }
fn merge(a,b) { let r=[];let i=0;let j=0; while i<len(a)and j<len(b){if a[i]<=b[j]{array_push(r,a[i]);i=i+1;}else{array_push(r,b[j]);j=j+1;}} while i<len(a){array_push(r,a[i]);i=i+1;} while j<len(b){array_push(r,b[j]);j=j+1;} return r; }
fn levenshtein(a,b) { let n=len(a);let m=len(b);if n==0{return m;}if m==0{return n;} let prev=[];let i=0;while i<=m{array_push(prev,i);i=i+1;} let i2=1; while i2<=n{let curr=[i2];let j=1;while j<=m{let cost=1;if a[i2-1..i2]==b[j-1..j]{cost=0;} let ins=curr[j-1]+1;let del=prev[j]+1;let sub=prev[j-1]+cost;let mn=ins;if del<mn{mn=del;}if sub<mn{mn=sub;}array_push(curr,mn);j=j+1;}prev=curr;i2=i2+1;} return prev[m]; }
fn lcs(a,b) { let n=len(a);let m=len(b);let dp=[];let i=0;while i<=n{let row=[];let j=0;while j<=m{array_push(row,0);j=j+1;}array_push(dp,row);i=i+1;} let i2=1;while i2<=n{let j=1;while j<=m{if a[i2-1]==b[j-1]{dp[i2][j]=dp[i2-1][j-1]+1;}else{let v=dp[i2-1][j];if dp[i2][j-1]>v{v=dp[i2][j-1];}dp[i2][j]=v;}j=j+1;}i2=i2+1;} let result=[];let x=n;let y=m; while x>0and y>0{if a[x-1]==b[y-1]{array_push(result,a[x-1]);x=x-1;y=y-1;}else{if dp[x-1][y]>dp[x][y-1]{x=x-1;}else{y=y-1;}}} let rev=[];let r=len(result)-1;while r>=0{array_push(rev,result[r]);r=r-1;} return rev; }
fn bfs(graph, start) { let visited={}; let queue=[start]; let order=[]; visited[start]=true; while len(queue)>0 { let node=queue[0]; let ns=[]; let i=1; while i<len(queue){array_push(ns,queue[i]);i=i+1;} queue=ns; array_push(order,node); let nb=graph[node]; if nb!=nil{ let n=0; while n<len(nb) { if visited[nb[n]]==nil{visited[nb[n]]=true;array_push(queue,nb[n]);} n=n+1; } } } return order; }
fn dfs(graph, start) { let visited={}; let order=[]; dfs_recurse(graph,start,visited,order); return order; }
fn dfs_recurse(graph, node, visited, order) { visited[node]=true; array_push(order,node); let nb=graph[node]; if nb!=nil{ let i=0; while i<len(nb) { if visited[nb[i]]==nil{ dfs_recurse(graph,nb[i],visited,order); } i=i+1; } } }
fn fibonacci_dp(n) { if n<=1{return n;} let a=0;let b=1;let i=2;while i<=n{let tmp=a+b;a=b;b=tmp;i=i+1;} return b; }
fn knapsack_01(wt, val, cap) { let n=len(wt); let dp=[]; let i=0; while i<=n{ let row=[]; let j=0; while j<=cap{array_push(row,0);j=j+1;} array_push(dp,row);i=i+1; } let i2=1; while i2<=n{ let w=0; while w<=cap{ if wt[i2-1]<=w{ let inc=val[i2-1]+dp[i2-1][w-wt[i2-1]]; let exc=dp[i2-1][w]; dp[i2][w]=inc; if exc>inc{dp[i2][w]=exc;} }else{dp[i2][w]=dp[i2-1][w];} w=w+1; } i2=i2+1; } return dp[n][cap]; }
fn dijkstra(graph, start) { let dist={};dist[start]=0; let visited={};visited[start]=true; let nodes=[start]; let i=0; while i<len(nodes) { let u=nodes[i]; let nb=graph[u]; if nb!=nil{ let j=0; while j<len(nb){ let v=nb[j]["to"]; let w=nb[j]["weight"]; let nd=dist[u]+w; if dist[v]==nil or nd<dist[v]{dist[v]=nd; if visited[v]==nil{array_push(nodes,v);visited[v]=true;}} j=j+1; } } i=i+1; } return dist; }

export binary_search; export quick_sort; export merge_sort; export levenshtein; export lcs;
export bfs; export dfs; export fibonacci_dp; export knapsack_01; export dijkstra;
