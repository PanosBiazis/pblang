// Explicit minute allocation; no automatic weighting or changes to lesson progress.
let Lesson=import("stdlib:lesson_bundle.sapp");let Allocation=import("stdlib:allocation_table.sapp");
fn create(bundle,minutes,weights){let slides=Lesson.slides(bundle);let labels=[];for slide in slides.slides{array_push(labels,slide.title);}return Allocation.create(labels,weights,minutes,"Minutes");}
export create;
