// Pure ideal acquisition arithmetic. No device access, probing, or allocations of sample buffers.
let Circuit=import("stdlib:circuits.sapp");
fn _finite(value,low,high) {return type(value)=="number" and value==value and value-value==0 and value>=low and value<=high;}
fn _integer(value,low,high) {return _finite(value,low,high) and num_floor(value)==value;}
// Ideal voltage source, unloaded divider, shunt capacitor at its output.
fn frontend(supply_volts,upper_ohms,lower_ohms,capacitance_farads) {
 if not _finite(supply_volts,-1000,1000) or not _finite(upper_ohms,1,1000000) or not _finite(lower_ohms,1,1000000) or not _finite(capacitance_farads,0,1) {throw "acquisition: invalid frontend parameters";}
 let resistance=Circuit.parallel_resistance([upper_ohms,lower_ohms]);
 let tau=Circuit.rc_tau(resistance,capacitance_farads);
 if capacitance_farads>0 and tau<=0 {throw "acquisition: time constant outside supported range";}
 let cutoff=if tau>0 {1/(2*3.141592653589793*tau)} else {nil};
 if cutoff!=nil and not _finite(cutoff,0,1000000000000000) {throw "acquisition: cutoff outside supported range";}
 return map{format:"pblang.acquisition-frontend.v1",steady_volts:Circuit.voltage_divider(supply_volts,upper_ohms,lower_ohms),thevenin_ohms:resistance,tau_seconds:tau,cutoff_hz:cutoff,physical_verified:false};
}
// Endpoint-inclusive ideal quantizer: nearest code, half-step ties upward.
// This explicit convention is not a vendor ADC transfer-function specification.
fn quantize(volts,reference_volts,bits) {
 if not _finite(reference_volts,0.000001,1000) or not _finite(volts,0,reference_volts) or not _integer(bits,1,24) {throw "acquisition: invalid quantizer parameters";}
 let levels=1;for i in range(0,bits) {levels=levels*2;}
 let maximum=levels-1;let step=reference_volts/maximum;
 let code=num_floor(volts/step+0.5);if code>maximum {code=maximum;}
 let reconstructed=code*step;
 return map{format:"pblang.acquisition-quantizer.v1",code:code,max_code:maximum,step_volts:step,reconstructed_volts:reconstructed,error_volts:reconstructed-volts,physical_verified:false};
}
// One frame contains all channels. Packed frames start on byte boundaries.
// Upper bounds keep every byte-count multiplication below 2^53.
fn stream(sample_rate_hz,channels,bits,duration_seconds) {
 if not _integer(sample_rate_hz,1,1000000) or not _integer(channels,1,256) or not _integer(bits,1,32) or not _integer(duration_seconds,1,86400) {throw "acquisition: invalid stream parameters";}
 let frames=sample_rate_hz*duration_seconds;
 let packed_frame=num_ceil(channels*bits/8);let aligned_frame=channels*num_ceil(bits/8);
 return map{format:"pblang.acquisition-stream.v1",frames:frames,samples:frames*channels,packed_frame_bytes:packed_frame,aligned_frame_bytes:aligned_frame,packed_bytes_per_second:packed_frame*sample_rate_hz,aligned_bytes_per_second:aligned_frame*sample_rate_hz,packed_total_bytes:packed_frame*frames,aligned_total_bytes:aligned_frame*frames,transport_overhead_included:false,physical_verified:false};
}
export frontend,quantize,stream;
