// Bounded decoder for native-runtime PBCK-v1 artifacts.
// Unlike host_pbck_inspect this module retains executable chunks, but it never
// executes them. Every allocation is covered by a per-artifact budget.

let Inspect = import("stdlib:host_pbck_inspect.sapp");

let MAX_ARTIFACT_BYTES = Inspect.MAX_ARTIFACT_BYTES;
let MAX_DEPTH = 64;
let MAX_INSTRUCTIONS = 4000000;
let MAX_CONSTANTS = 1000000;
let MAX_STRING_BYTES = 33554432;
let MAX_CAPTURES = 65535;
let MAX_PARAMETERS = 65535;

fn _need(r, n, label) {
    if n < 0 or r.pos + n > len(r.bytes) { throw "host_pbck_decode: truncated " + label; }
}

fn _u8(r) { _need(r, 1, "u8"); let v = r.bytes[r.pos]; r.pos = r.pos + 1; return v; }

fn _u32(r) {
    _need(r, 4, "u32");
    let p = r.pos; let b = r.bytes;
    let v = b[p] + b[p + 1] * 256 + b[p + 2] * 65536 + b[p + 3] * 16777216;
    r.pos = p + 4;
    return v;
}

fn _string(r) {
    let n = _u32(r);
    _need(r, n, "string");
    r.string_bytes = r.string_bytes + n;
    if r.string_bytes > MAX_STRING_BYTES { throw "host_pbck_decode: string budget exceeded"; }
    let bytes = [];
    let i = 0;
    while i < n { array_push(bytes, r.bytes[r.pos + i]); i = i + 1; }
    r.pos = r.pos + n;
    return try bytes_to_str(bytes) catch { throw "host_pbck_decode: invalid UTF-8"; };
}

fn _number(r) {
    _need(r, 8, "f64");
    let bytes = [];
    let i = 0;
    while i < 8 { array_push(bytes, r.bytes[r.pos + i]); i = i + 1; }
    r.pos = r.pos + 8;
    return num_from_le_bytes(bytes);
}

fn _has_operand(op) {
    return op == 0 or (op >= 13 and op <= 20) or op == 23 or op == 25 or op == 26
        or op == 28 or op == 29 or op == 31 or op == 32 or (op >= 35 and op <= 37)
        or op == 42;
}

fn _instruction(r) {
    let op = _u8(r);
    if op < 0 or op >= len(Inspect.OPCODE_NAMES) {
        throw "host_pbck_decode: unknown opcode " + str(op);
    }
    if op == 27 {
        let fn_const = _u32(r);
        let count = _u32(r);
        if count > MAX_CAPTURES or count * 5 > len(r.bytes) - r.pos {
            throw "host_pbck_decode: invalid capture count";
        }
        let captures = [];
        let i = 0;
        while i < count {
            let local = _u8(r);
            if local != 0 and local != 1 { throw "host_pbck_decode: invalid capture flag"; }
            array_push(captures, map{ is_local: local == 1, index: _u32(r) });
            i = i + 1;
        }
        return map{ op: op, fn_const: fn_const, captures: captures };
    }
    if _has_operand(op) { return map{ op: op, operand: _u32(r) }; }
    return map{ op: op };
}

fn _value(r, depth) {
    let tag = _u8(r);
    if tag == 0 { return _number(r); }
    if tag == 1 {
        let v = _u8(r);
        if v != 0 and v != 1 { throw "host_pbck_decode: invalid bool"; }
        return v == 1;
    }
    if tag == 2 { return nil; }
    if tag == 3 { return _string(r); }
    if tag == 4 { return map{ __pbck_numeric: "bigint", text: _string(r) }; }
    if tag == 5 { return map{ __pbck_numeric: "rational", text: _string(r) }; }
    if tag == 6 { throw "host_pbck_decode: decimal constants are unsupported in PBCK-v1"; }
    if tag != 7 { throw "host_pbck_decode: unknown value tag " + str(tag); }

    let named = _u8(r);
    if named != 0 and named != 1 { throw "host_pbck_decode: invalid function-name flag"; }
    let name = nil;
    if named == 1 { name = _string(r); }
    let arity = _u32(r);
    let min_arity = _u32(r);
    if arity > MAX_PARAMETERS or min_arity > arity {
        throw "host_pbck_decode: invalid function arity";
    }
    let default_count = _u32(r);
    if default_count > arity { throw "host_pbck_decode: invalid default count"; }
    let defaults = [];
    let i = 0;
    while i < default_count { array_push(defaults, _value(r, depth + 1)); i = i + 1; }
    let vararg = _u8(r);
    if vararg != 0 and vararg != 1 { throw "host_pbck_decode: invalid vararg flag"; }
    let typed = _u8(r);
    if typed != 0 and typed != 1 { throw "host_pbck_decode: invalid parameter-type flag"; }
    let parameter_types = [];
    if typed == 1 {
        let count = _u32(r);
        if count > MAX_PARAMETERS { throw "host_pbck_decode: parameter-type limit exceeded"; }
        parameter_types = [];
        i = 0;
        while i < count {
            let kind = _u8(r);
            if kind > 2 { throw "host_pbck_decode: invalid parameter type"; }
            array_push(parameter_types, kind);
            i = i + 1;
        }
    }
    return map{
        __pbck_function: true, name: name, arity: arity, min_arity: min_arity,
        defaults: defaults, is_vararg: vararg == 1,
        parameter_types_present: typed == 1, parameter_types: parameter_types,
        chunk: _chunk(r, depth + 1)
    };
}

fn _constant_operand(op) {
    return op == 0 or (op >= 13 and op <= 18) or op == 42;
}

fn _validate_chunk(chunk) {
    let compact = map_has(chunk, "compact") and chunk.compact;
    let n = if compact { len(chunk.opcodes) } else { len(chunk.instructions) };
    let nc = len(chunk.constants);
    let i = 0;
    while i < n {
        let op = if compact { chunk.opcodes[i] } else { chunk.instructions[i].op };
        let operand = if compact { chunk.operands[i] }
            else { try chunk.instructions[i].operand catch (0 - 1) };
        let fn_const = operand;
        if not compact and op == 27 { fn_const = chunk.instructions[i].fn_const; }
        if op == 27 {
            if fn_const < 0 or fn_const >= nc or not is_map(chunk.constants[fn_const])
                or not map_has(chunk.constants[fn_const], "__pbck_function") {
                throw "host_pbck_decode: closure function constant out of range";
            }
        } elif _constant_operand(op) {
            if operand < 0 or operand >= nc { throw "host_pbck_decode: constant index out of range"; }
        } elif op == 23 or (op >= 35 and op <= 37) {
            if operand < 0 or operand > n { throw "host_pbck_decode: jump target out of range"; }
        }
        i = i + 1;
    }
}

fn _compact_instructions(r, count) {
    let opcodes = []; let operands = []; let closures = map{};
    let i = 0;
    while i < count {
        let op = _u8(r);
        if op < 0 or op >= len(Inspect.OPCODE_NAMES) {
            throw "host_pbck_decode: unknown opcode " + str(op);
        }
        let operand = 0 - 1;
        if op == 27 {
            operand = _u32(r);
            let capture_count = _u32(r);
            if capture_count > MAX_CAPTURES or capture_count * 5 > len(r.bytes) - r.pos {
                throw "host_pbck_decode: invalid capture count";
            }
            let captures = []; let c = 0;
            while c < capture_count {
                let local = _u8(r);
                if local != 0 and local != 1 { throw "host_pbck_decode: invalid capture flag"; }
                array_push(captures, map{ is_local: local == 1, index: _u32(r) });
                c = c + 1;
            }
            closures[str(i)] = captures;
        } elif _has_operand(op) { operand = _u32(r); }
        array_push(opcodes, op); array_push(operands, operand);
        i = i + 1;
    }
    return map{ opcodes: opcodes, operands: operands, closures: closures };
}

fn _chunk(r, depth) {
    if depth > MAX_DEPTH { throw "host_pbck_decode: nesting limit exceeded"; }
    let instruction_count = _u32(r);
    r.instructions = r.instructions + instruction_count;
    if r.instructions > MAX_INSTRUCTIONS or instruction_count > len(r.bytes) - r.pos {
        throw "host_pbck_decode: instruction budget exceeded";
    }
    let instructions = [];
    let compact_instructions = map{ opcodes: [], operands: [], closures: map{} };
    let i = 0;
    if r.compact { compact_instructions = _compact_instructions(r, instruction_count); }
    else { while i < instruction_count { array_push(instructions, _instruction(r)); i = i + 1; } }

    let constant_count = _u32(r);
    r.constants = r.constants + constant_count;
    if r.constants > MAX_CONSTANTS or constant_count > len(r.bytes) - r.pos {
        throw "host_pbck_decode: constant budget exceeded";
    }
    let constants = [];
    i = 0;
    while i < constant_count { array_push(constants, _value(r, depth)); i = i + 1; }

    let span_count = _u32(r);
    if span_count != instruction_count or span_count * 8 > len(r.bytes) - r.pos {
        throw "host_pbck_decode: invalid source span table";
    }
    r.pos = r.pos + span_count * 8;
    let has_source = _u8(r);
    if has_source != 0 and has_source != 1 { throw "host_pbck_decode: invalid source-name flag"; }
    let source_name = nil;
    if has_source == 1 { source_name = _string(r); }
    let chunk = map{ instructions: instructions, constants: constants, source_name: source_name };
    if r.compact {
        chunk = map{
            compact: true, opcodes: compact_instructions.opcodes,
            operands: compact_instructions.operands, closures: compact_instructions.closures,
            constants: constants, source_name: source_name
        };
    }
    _validate_chunk(chunk);
    return chunk;
}

fn decode_bytes_with_options(bytes, options = nil) {
    if not is_array(bytes) or len(bytes) < 9 or len(bytes) > MAX_ARTIFACT_BYTES {
        throw "host_pbck_decode: invalid artifact size";
    }
    if bytes[0] != 80 or bytes[1] != 66 or bytes[2] != 67 or bytes[3] != 75 or bytes[4] != 1 {
        throw "host_pbck_decode: bad magic or unsupported version";
    }
    let compact = false;
    if options != nil {
        if not is_map(options) { throw "host_pbck_decode: options must be a map"; }
        if map_has(options, "compact") { compact = options.compact; }
    }
    let r = map{ bytes: bytes, pos: 5, instructions: 0, constants: 0,
        string_bytes: 0, compact: compact };
    let chunk = _chunk(r, 0);
    if r.pos != len(bytes) { throw "host_pbck_decode: trailing bytes"; }
    return map{
        format: "host-pbck-v1", version: 1, chunk: chunk,
        artifact_bytes: len(bytes), instructions: r.instructions,
        constants: r.constants, string_bytes: r.string_bytes
    };
}

fn decode_bytes(bytes) { return decode_bytes_with_options(bytes, map{ compact: false }); }
fn decode_bytes_compact(bytes) { return decode_bytes_with_options(bytes, map{ compact: true }); }

fn decode_file(path) { return decode_bytes(fs_read_bytes(path)); }
fn decode_file_compact(path) { return decode_bytes_compact(fs_read_bytes(path)); }

export decode_bytes, decode_bytes_compact, decode_bytes_with_options;
export decode_file, decode_file_compact;
export MAX_ARTIFACT_BYTES, MAX_DEPTH, MAX_INSTRUCTIONS, MAX_CONSTANTS, MAX_STRING_BYTES;
