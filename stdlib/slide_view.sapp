// Same deterministic slide-selection actions compile for native, Web and Android.
let Slides=import("stdlib:slide_document.sapp"); let Pages=import("stdlib:text_pages.sapp"); let UI=import("stdlib:modern_ui.sapp");
fn _rows(slide) {
    let title=Pages.wrap(slide.title,40); let rows=[];
    for i in range(0,2) { array_push(rows,if i<len(title) {title[i]} else {""}); }
    let body=[]; for line in slide.lines { for part in Pages.wrap(line,40) { array_push(body,part); } }
    for i in range(0,10) { array_push(rows,if i<len(body) {body[i]} else {""}); }
    if len(title)>2 or len(body)>10 { throw "slides: display limit"; } return rows;
}
fn create(deck) {
    let doc=Slides.copy(deck); let first=_rows(doc.slides[0]);
    let children=[UI.heading("PBLang Presentations"),UI.text("Select a slide. Speaker notes are not included in this view."),UI.text("Slide 1 / "+str(len(doc.slides)),map{name:"slide_position"})];
    for i in range(0,12) { array_push(children,UI.text(first[i],map{name:"slide_line_"+str(i)})); }
    let buttons=[];
    for s in range(0,len(doc.slides)) {
        let rows=_rows(doc.slides[s]); let actions=[UI.action_set_text("slide_position","Slide "+str(s+1)+" / "+str(len(doc.slides)))];
        for i in range(0,12) { array_push(actions,UI.action_set_text("slide_line_"+str(i),rows[i])); }
        array_push(buttons,UI.button("Slide "+str(s+1),UI.action_sequence(actions),map{name:"select_slide_"+str(s)}));
    }
    array_push(children,UI.grid(buttons,map{columns:4})); return UI.screen(children);
}
export create;
