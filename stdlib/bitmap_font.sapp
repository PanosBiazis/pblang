// stdlib/bitmap_font.sapp — a 5x7 bitmap font + text renderer, in pblang.
//
// The pblang-native IDE draws its own text: there is no text-rendering builtin, only
// pixels (gfxdrawpoint/gfxdrawrect). Each glyph is 7 rows of 5 bits (MSB = leftmost
// column). `draw_text` emits pixels through a `setpx(x, y, color)` callback, so it can
// drive a real graphics window OR a recording surface (which is how it's tested without
// a display). Lowercase maps to the uppercase glyph (v1). All pblang.
//
//   let F = import("stdlib/bitmap_font.sapp");
//   F.draw_text(fn(x, y, c) { win.point(x, y, c); }, 4, 4, "FN MAIN", color);

// glyph(code) -> array of 7 row bitmasks (0..31), or nil if unknown.
let _F = map{};
fn _g(code, r) { _F[str(code)] = r; }
fn _init() {
    if len(map_keys(_F)) > 0 { return; }
    _g(48, [14,17,19,21,25,17,14]); _g(49, [4,12,4,4,4,4,14]);
    _g(50, [14,17,1,2,4,8,31]);     _g(51, [31,2,4,2,1,17,14]);
    _g(52, [2,6,10,18,31,2,2]);     _g(53, [31,16,30,1,1,17,14]);
    _g(54, [6,8,16,30,17,17,14]);   _g(55, [31,1,2,4,8,8,8]);
    _g(56, [14,17,17,14,17,17,14]); _g(57, [14,17,17,15,1,2,12]);
    _g(65, [4,10,17,17,31,17,17]);  _g(66, [30,17,17,30,17,17,30]);
    _g(67, [14,17,16,16,16,17,14]); _g(68, [28,18,17,17,17,18,28]);
    _g(69, [31,16,16,30,16,16,31]); _g(70, [31,16,16,30,16,16,16]);
    _g(71, [14,17,16,16,19,17,15]); _g(72, [17,17,17,31,17,17,17]);
    _g(73, [14,4,4,4,4,4,14]);      _g(74, [7,2,2,2,2,18,12]);
    _g(75, [17,18,20,24,20,18,17]); _g(76, [16,16,16,16,16,16,31]);
    _g(77, [17,27,21,21,17,17,17]); _g(78, [17,17,25,21,19,17,17]);
    _g(79, [14,17,17,17,17,17,14]); _g(80, [30,17,17,30,16,16,16]);
    _g(81, [14,17,17,17,21,18,13]); _g(82, [30,17,17,30,20,18,17]);
    _g(83, [15,16,16,14,1,1,30]);   _g(84, [31,4,4,4,4,4,4]);
    _g(85, [17,17,17,17,17,17,14]); _g(86, [17,17,17,17,17,10,4]);
    _g(87, [17,17,17,21,21,21,10]); _g(88, [17,17,10,4,10,17,17]);
    _g(89, [17,17,10,4,4,4,4]);     _g(90, [31,1,2,4,8,16,31]);
    // symbols
    _g(40, [2,4,8,8,8,4,2]);   _g(41, [8,4,2,2,2,4,8]);
    _g(123,[6,8,8,16,8,8,6]);  _g(125,[12,2,2,1,2,2,12]);
    _g(91, [14,8,8,8,8,8,14]); _g(93, [14,2,2,2,2,2,14]);
    _g(59, [0,4,0,0,4,4,8]);   _g(58, [0,4,0,0,4,0,0]);
    _g(46, [0,0,0,0,0,12,12]); _g(44, [0,0,0,0,4,4,8]);
    _g(61, [0,0,31,0,31,0,0]); _g(43, [0,4,4,31,4,4,0]);
    _g(45, [0,0,0,31,0,0,0]);  _g(42, [0,4,21,14,21,4,0]);
    _g(47, [1,2,4,8,16,0,0]);  _g(34, [10,10,0,0,0,0,0]);
    _g(39, [4,4,0,0,0,0,0]);   _g(33, [4,4,4,4,4,0,4]);
    _g(60, [2,4,8,16,8,4,2]);  _g(62, [8,4,2,1,2,4,8]);
    _g(95, [0,0,0,0,0,0,31]);
    // more code symbols (real source shows these)
    _g(124,[4,4,4,4,4,4,4]);   _g(63, [14,17,1,2,4,0,4]);
    _g(35, [10,31,10,10,31,10,0]); _g(64, [14,17,19,21,22,16,14]);
    _g(38, [12,18,20,8,21,18,13]); _g(37, [0,17,2,4,8,17,0]);
    _g(94, [4,10,17,0,0,0,0]);  _g(92, [16,8,4,2,1,0,0]);
    _g(96, [8,4,0,0,0,0,0]);    _g(126,[0,0,13,22,0,0,0]);
    // lowercase a-z — baseline-aligned 5x7 (descenders on g/j/p/q/y faked into the box)
    _g(97, [0,0,14,1,15,17,15]);   _g(98, [16,16,30,17,17,17,30]);
    _g(99, [0,0,14,16,16,17,14]);  _g(100,[1,1,15,17,17,17,15]);
    _g(101,[0,0,14,17,31,16,14]);  _g(102,[6,9,8,28,8,8,8]);
    _g(103,[0,0,15,17,15,1,14]);   _g(104,[16,16,30,17,17,17,17]);
    _g(105,[4,0,12,4,4,4,14]);     _g(106,[2,0,6,2,2,18,12]);
    _g(107,[16,16,18,20,24,20,18]); _g(108,[12,4,4,4,4,4,14]);
    _g(109,[0,0,26,21,21,17,17]);  _g(110,[0,0,30,17,17,17,17]);
    _g(111,[0,0,14,17,17,17,14]);  _g(112,[0,0,30,17,30,16,16]);
    _g(113,[0,0,15,17,15,1,1]);    _g(114,[0,0,22,25,16,16,16]);
    _g(115,[0,0,15,16,14,1,30]);   _g(116,[8,8,28,8,8,9,6]);
    _g(117,[0,0,17,17,17,19,13]);  _g(118,[0,0,17,17,17,10,4]);
    _g(119,[0,0,17,17,21,21,10]);  _g(120,[0,0,17,10,4,10,17]);
    _g(121,[0,0,17,17,15,1,14]);   _g(122,[0,0,31,2,4,8,31]);
    // compact Unicode/math/Greek glyphs used by the native IDE and math shortcuts.
    // These are 5x7 approximations, not full font shaping, but they keep symbols visible.
    _g(960, [0,0,31,10,10,10,18]);      // π
    _g(928, [31,17,17,17,17,17,17]);    // Π
    _g(964, [0,0,31,4,4,4,3]);          // τ
    _g(966, [4,14,21,21,14,4,4]);       // φ
    _g(934, [4,14,21,21,14,4,4]);       // Φ
    _g(945, [0,0,14,17,31,17,17]);      // α
    _g(946, [14,17,30,17,17,30,16]);    // β
    _g(947, [17,17,10,4,4,4,4]);        // γ
    _g(948, [14,1,14,17,17,17,14]);     // δ
    _g(949, [0,0,14,16,30,16,14]);      // ε
    _g(955, [8,8,4,4,10,10,17]);        // λ
    _g(956, [0,0,17,17,17,30,16]);      // μ
    _g(963, [0,0,15,18,18,18,12]);      // σ
    _g(969, [0,0,17,17,21,21,10]);      // ω
    _g(916, [4,10,10,17,17,31,0]);      // Δ
    _g(937, [14,17,17,17,10,27,0]);     // Ω
    _g(8730,[1,1,2,18,20,8,0]);         // √
    _g(215, [0,17,10,4,10,17,0]);       // ×
    _g(247, [0,4,0,31,0,4,0]);          // ÷
    _g(8722,[0,0,0,31,0,0,0]);          // −
    _g(8804,[2,4,8,16,8,4,31]);         // ≤
    _g(8805,[8,4,2,1,2,4,31]);          // ≥
    _g(8800,[2,31,4,8,31,16,0]);        // ≠
    _g(8801,[0,31,0,31,0,31,0]);        // ≡
    _g(8776,[0,13,22,0,13,22,0]);       // ≈
    _g(8734,[0,0,10,21,21,10,0]);       // ∞
    _g(8719,[31,17,17,17,17,17,17]);     // ∏
    _g(8721,[31,16,8,4,8,16,31]);       // ∑
    _g(8747,[6,8,8,28,8,8,12]);         // ∫
    _g(8743,[0,4,10,17,17,0,0]);        // ∧
    _g(8744,[0,17,17,10,4,0,0]);        // ∨
    _g(172, [0,0,31,1,1,0,0]);          // ¬
    _g(176, [6,9,9,6,0,0,0]);           // °
    _g(8592,[0,4,8,31,8,4,0]);          // ←
    _g(8593,[4,14,21,4,4,4,0]);         // ↑
    _g(8594,[0,4,2,31,2,4,0]);          // →
    _g(8595,[4,4,4,21,14,4,0]);         // ↓
    _g(10084,[0,10,31,31,14,4,0]);      // ♥ / ❤
    _g(128512,[14,17,21,17,21,17,14]);  // 😀
    _g(128578,[14,17,21,17,17,10,4]);   // 🙂
    _g(128640,[4,14,31,21,31,10,17]);   // 🚀
}

fn glyph(code) {
    _init();
    if map_has(_F, str(code)) { return _F[str(code)]; }
    // fallback: an uncovered lowercase letter borrows its uppercase glyph
    if code >= 97 and code <= 122 and map_has(_F, str(code - 32)) { return _F[str(code - 32)]; }
    return nil;
}

// draw_char(setpx, x, y, code, color) -> the x advance (6 px). Unknown glyphs render a
// small box so missing characters are visible rather than blank.
fn draw_char(setpx, x, y, code, color) {
    let g = glyph(code);
    if g == nil { g = [31,17,17,17,17,17,31]; }
    let r = 0;
    while r < 7 {
        let row = g[r];
        let c = 0;
        while c < 5 {
            if bit_and(bit_shr(row, 4 - c), 1) == 1 { setpx(x + c, y + r, color); }
            c = c + 1;
        }
        r = r + 1;
    }
    return 6;
}

// draw_text(setpx, x, y, text, color) -> the ending x. Spaces advance without drawing.
fn draw_text(setpx, x, y, text, color) {
    let cx = x;
    let i = 0;
    while i < len(text) {
        let code = strcharcodeat(text, i);
        if code != 32 { draw_char(setpx, cx, y, code, color); }
        cx = cx + 6;
        i = i + 1;
    }
    return cx;
}

fn char_width() { return 6; }
fn char_height() { return 8; }

export glyph, draw_char, draw_text, char_width, char_height;
