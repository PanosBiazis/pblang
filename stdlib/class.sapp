// stdlib/class.sapp — OOP system for pblang.
//
// Design: methods are stored as unbound functions and called with explicit self.
// The instance stores all methods as raw functions; call via class.call(inst, "method", args).
//
// Usage:
//   let c = import("stdlib:class.sapp");
//   let Animal = c.define("Animal", ["name", "sound"], map{
//       speak: fn(self) { return self.name + " says " + self.sound; }
//   });
//   let a = c.new(Animal, map{ name: "Cat", sound: "meow" });
//   print c.call(a, "speak");   // Cat says meow
//   print c.instanceof(a, Animal);      // true
//
// For method calls that work like a.method(), see c.bind() below.

// define(name, fields, methods) — create a class definition.
fn define(name, fields = nil, methods = nil) {
    // Use type()-based nil checks (string compare, always native): the `methods`
    // map may legitimately carry operator dunders (__eq__, __lt__, ...) as keys,
    // and `methods == nil` would otherwise dispatch that __eq__ on the map itself.
    if type(methods) == "nil" { methods = map{}; }
    if type(fields) == "nil" { fields = []; }
    return map{
        __class_name: name,
        __fields: fields,
        __methods: methods,
        __parent: nil,
        __is_class_def: true
    };
}

// new(class_def, init_map) — create an instance.
fn new(class_def, init_map = nil) {
    // type()-based nil checks: init_map is user data that may carry dunders, and
    // class_def could too if malformed — avoid dispatching a stray __eq__.
    if type(class_def) == "nil" { return error("class.new: class_def is nil"); }
    if type(init_map) == "nil" { init_map = map{}; }

    // Validate required fields
    let fields = try class_def.__fields catch [];
    for i len(fields) {
        if map_has(init_map, fields[i]) == false {
            return error("class.new: missing field '" + fields[i] + "' for " + str(class_def.__class_name));
        }
    }

    // Build instance: copy fields from init_map
    let instance = map{ __class_name: class_def.__class_name, __is_instance: true, __class_def: class_def };
    let ikeys = map_keys(init_map);
    for i len(ikeys) { instance[ikeys[i]] = init_map[ikeys[i]]; }

    // Copy parent methods first (child methods will override)
    let parent = try class_def.__parent catch nil;
    if parent != nil {
        let pm = try parent.__methods catch map{};
        let pk = map_keys(pm);
        for i len(pk) { instance["__m_" + pk[i]] = pm[pk[i]]; }
    }

    // Copy this class's methods (using __m_ prefix to avoid name collisions with fields)
    let methods = try class_def.__methods catch map{};
    let mk = map_keys(methods);
    for i len(mk) { instance["__m_" + mk[i]] = methods[mk[i]]; }

    // Operator-overloading bridge: also expose dunder methods (__add__, __eq__,
    // __lt__, ...) under their PLAIN names so the VM's native operator overloading
    // (a + b, a < b, a == b) dispatches on class.sapp instances exactly as it does
    // on hand-built maps. `extend` already merges parent methods into __methods, so
    // inherited operators are bridged too.
    let dunders = operator_dunders();
    for i len(mk) {
        if map_has(dunders, mk[i]) { instance[mk[i]] = methods[mk[i]]; }
    }

    return instance;
}

// operator_dunders() — the set of method names the VM recognises as operator
// overloads. Used by `new` to bridge them onto instances.
fn operator_dunders() {
    return map{
        __add__: true, __sub__: true, __mul__: true, __div__: true,
        __mod__: true, __pow__: true,
        __radd__: true, __rsub__: true, __rmul__: true, __rdiv__: true,
        __rmod__: true, __rpow__: true,
        __neg__: true,
        __eq__: true, __ne__: true,
        __lt__: true, __le__: true, __gt__: true, __ge__: true
    };
}

// call(instance, method_name, ...args) — call a method on an instance.
// Since we can't easily pass varargs, use call1, call2, call3 for different arities.
fn call(instance, method_name) {
    let m = try instance["__m_" + method_name] catch nil;
    if m == nil { return error("class.call: no method '" + method_name + "' on " + str(try instance.__class_name catch "unknown")); }
    return m(instance);
}

fn call1(instance, method_name, arg1) {
    let m = try instance["__m_" + method_name] catch nil;
    if m == nil { return error("class.call1: no method '" + method_name + "'"); }
    return m(instance, arg1);
}

fn call2(instance, method_name, arg1, arg2) {
    let m = try instance["__m_" + method_name] catch nil;
    if m == nil { return error("class.call2: no method '" + method_name + "'"); }
    return m(instance, arg1, arg2);
}

// instanceof(obj, class_def) — true if obj was created from class_def.
// Walks the full inheritance chain stored in __class_def.
fn instanceof(obj, class_def) {
    if type(obj) != "map" { return false; }
    let is_inst = try obj.__is_instance catch false;
    if is_inst == false { return false; }
    let expected_name = try class_def.__class_name catch nil;
    // Walk the class definition chain stored on the instance
    let cur_def = try obj.__class_def catch nil;
    while cur_def != nil {
        let cur_name = try cur_def.__class_name catch nil;
        if cur_name == expected_name { return true; }
        cur_def = try cur_def.__parent catch nil;
    }
    return false;
}

// extend(parent, name, extra_fields, extra_methods) — single inheritance.
fn extend(parent, name, extra_fields = nil, extra_methods = nil) {
    // type()-based nil checks: extra_methods may carry operator dunders as keys.
    if type(extra_fields) == "nil" { extra_fields = []; }
    if type(extra_methods) == "nil" { extra_methods = map{}; }

    // Merge fields
    let parent_fields = try parent.__fields catch [];
    let all_fields = [];
    for i len(parent_fields) { all_fields[len(all_fields)] = parent_fields[i]; }
    for i len(extra_fields) { all_fields[len(all_fields)] = extra_fields[i]; }

    // Merge methods (child overrides parent)
    let parent_methods = try parent.__methods catch map{};
    let all_methods = map{};
    let pk = map_keys(parent_methods);
    for i len(pk) { all_methods[pk[i]] = parent_methods[pk[i]]; }
    let ck = map_keys(extra_methods);
    for i len(ck) { all_methods[ck[i]] = extra_methods[ck[i]]; }

    return map{
        __class_name: name,
        __fields: all_fields,
        __methods: all_methods,
        __parent: parent,
        __is_class_def: true
    };
}

// class_name(obj) — get class name of instance.
fn class_name(obj) {
    return try obj.__class_name catch nil;
}

// is_class(obj) — true if obj is a class definition.
fn is_class(obj) {
    return type(obj) == "map" and (try obj.__is_class_def catch false) == true;
}

// has_method(instance, method_name) — check if instance has a method.
fn has_method(instance, method_name) {
    return map_has(instance, "__m_" + method_name);
}

// get_method(instance, method_name) — get the raw method function.
fn get_method(instance, method_name) {
    return try instance["__m_" + method_name] catch nil;
}

// call3 / call4 — dispatch with 3 / 4 explicit args (pblang lacks spread-calls,
// so arities are provided as fixed overloads alongside call / call1 / call2).
fn call3(instance, method_name, a1, a2, a3) {
    let m = try instance["__m_" + method_name] catch nil;
    if m == nil { return error("class.call3: no method '" + method_name + "'"); }
    return m(instance, a1, a2, a3);
}

fn call4(instance, method_name, a1, a2, a3, a4) {
    let m = try instance["__m_" + method_name] catch nil;
    if m == nil { return error("class.call4: no method '" + method_name + "'"); }
    return m(instance, a1, a2, a3, a4);
}

// --- super: call the parent class's version of a (possibly overridden) method ---
// Omitted owner preserves the legacy parent-of-dynamic-class lookup.
// Pass the declaring class explicitly inside inheritable overrides; otherwise
// a deeper instance can resolve the same override again. No instance mutation.
fn super_method(instance, method_name, owner = nil) {
    let cdef = try instance.__class_def catch nil;
    if cdef == nil { return error("class.super: '" + str(method_name) + "' — not a class instance"); }
    if type(owner) != "nil" {
        if not is_class(owner) { return error("class.super: owner must be a class definition"); }
        cdef = owner;
    }
    let parent = try cdef.__parent catch nil;
    if parent == nil { return error("class.super: no parent class for " + str(try cdef.__class_name catch "?")); }
    let pm = try parent.__methods catch map{};
    let m = try pm[method_name] catch nil;
    if m == nil { return error("class.super: parent has no method '" + method_name + "'"); }
    return m;
}

fn super_call(instance, method_name, owner = nil) {
    return super_method(instance, method_name, owner)(instance);
}
fn super1(instance, method_name, a1, owner = nil) {
    return super_method(instance, method_name, owner)(instance, a1);
}
fn super2(instance, method_name, a1, a2, owner = nil) {
    return super_method(instance, method_name, owner)(instance, a1, a2);
}

// --- bound methods: return a callable that already carries `instance` ---
// (pblang lacks spread, so bind0 / bind1 / bind2 cover common arities.)
fn bind0(instance, method_name) {
    let m = try instance["__m_" + method_name] catch nil;
    if m == nil { return error("class.bind0: no method '" + method_name + "'"); }
    return fn() { return m(instance); };
}
fn bind1(instance, method_name) {
    let m = try instance["__m_" + method_name] catch nil;
    if m == nil { return error("class.bind1: no method '" + method_name + "'"); }
    return fn(a1) { return m(instance, a1); };
}
fn bind2(instance, method_name) {
    let m = try instance["__m_" + method_name] catch nil;
    if m == nil { return error("class.bind2: no method '" + method_name + "'"); }
    return fn(a1, a2) { return m(instance, a1, a2); };
}

// --- mixin: compose extra methods into a class definition (trait-style reuse) ---
// Returns a NEW class def with `methods_map` merged over the existing methods.
// Compose several mixins by chaining: mixin(mixin(Base, Walks), Swims).
fn mixin(class_def, methods_map) {
    let merged = map{};
    let existing = try class_def.__methods catch map{};
    let ek = map_keys(existing);
    for i len(ek) { merged[ek[i]] = existing[ek[i]]; }
    let nk = map_keys(methods_map);
    for i len(nk) { merged[nk[i]] = methods_map[nk[i]]; }
    return map{
        __class_name: try class_def.__class_name catch "Mixed",
        __fields: try class_def.__fields catch [],
        __methods: merged,
        __parent: try class_def.__parent catch nil,
        __statics: try class_def.__statics catch map{},
        __is_class_def: true
    };
}

// --- static (class-level) methods: stored on the class def, called on the class ---
fn define_static(class_def, name, fn_val) {
    let statics = try class_def.__statics catch map{};
    statics[name] = fn_val;
    class_def.__statics = statics;
    return class_def;
}
fn call_static(class_def, name) {
    let s = try class_def.__statics catch map{};
    let f = try s[name] catch nil;
    if f == nil { return error("class.call_static: no static method '" + name + "'"); }
    return f();
}
fn call_static1(class_def, name, a1) {
    let s = try class_def.__statics catch map{};
    let f = try s[name] catch nil;
    if f == nil { return error("class.call_static1: no static method '" + name + "'"); }
    return f(a1);
}

// --- introspection ---
fn field_names(class_def) { return try class_def.__fields catch []; }
fn method_names(class_def) { return map_keys(try class_def.__methods catch map{}); }
fn parent_of(class_def) { return try class_def.__parent catch nil; }

export define, new, call, call1, call2, call3, call4, instanceof, extend,
       class_name, is_class, has_method, get_method, operator_dunders,
       super_method, super_call, super1, super2,
       bind0, bind1, bind2, mixin,
       define_static, call_static, call_static1,
       field_names, method_names, parent_of;
