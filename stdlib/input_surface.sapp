// Device-independent touch/pen/interactive-board data. Never opens or injects input.
fn _fields(value, names) {
    if type(value)!="map" { throw "input_surface: expected object"; }
    for key in map_keys(value) {
        let found=false; for name in names { if key==name { found=true; } }
        if not found { throw "input_surface: unknown field"; }
    }
}
fn _number(value, low, high) {
    if type(value)!="number" or not (value>=low and value<=high) {
        throw "input_surface: number outside range";
    }
    return value;
}
fn _integer(value, low, high) {
    _number(value,low,high);
    if value!=num_floor(value) { throw "input_surface: integer required"; }
    return value;
}
fn _surface(value) {
    _fields(value,["width","height","rotation","mirror_x","mirror_y"]);
    let width=_number(try value.width catch nil,1,1048576);
    let height=_number(try value.height catch nil,1,1048576);
    let rotation=_integer(try value.rotation catch 0,0,270);
    if rotation!=0 and rotation!=90 and rotation!=180 and rotation!=270 { throw "input_surface: invalid rotation"; }
    let mx=try value.mirror_x catch false; let my=try value.mirror_y catch false;
    if type(mx)!="bool" or type(my)!="bool" { throw "input_surface: invalid reflection"; }
    return map{width:width,height:height,rotation:rotation,mirror_x:mx,mirror_y:my};
}
fn transform(surface, points) {
    let s=_surface(surface);
    if type(points)!="array" or len(points)>256 { throw "input_surface: point count exceeded"; }
    let out=[];
    for point in points {
        _fields(point,["x","y"]);
        let x=_number(try point.x catch nil,0,s.width)/s.width;
        let y=_number(try point.y catch nil,0,s.height)/s.height;
        if s.mirror_x { x=1-x; } if s.mirror_y { y=1-y; }
        let nx=x; let ny=y;
        if s.rotation==90 { nx=1-y; ny=x; }
        if s.rotation==180 { nx=1-x; ny=1-y; }
        if s.rotation==270 { nx=y; ny=1-x; }
        out[len(out)]=map{x:nx,y:ny};
    }
    return map{points:out,coordinate_space:"normalized-0-to-1",rotation:s.rotation,
        reflection_before_rotation:true,device_accessed:false,calibration_applied_to_device:false};
}
fn analyze(events) {
    if type(events)!="array" or len(events)>256 { throw "input_surface: event count exceeded"; }
    let active=map{}; let current=0; let peak=0; let started=0; let ended=0; let cancelled=0;
    let pens=0; let touches=0; let mice=0; let previous=0; let first=0;
    let pressure_sum=0; let pressure_count=0; let peak_pressure=0; let max_tilt=0;
    for i len(events) {
        let event=events[i];
        _fields(event,["contact_id","kind","phase","time_ms","x","y","pressure","tilt_x","tilt_y"]);
        let id=str(_integer(try event.contact_id catch nil,0,31));
        let kind=try event.kind catch nil; let phase=try event.phase catch nil;
        if kind!="touch" and kind!="pen" and kind!="mouse" { throw "input_surface: invalid pointer kind"; }
        if phase!="start" and phase!="move" and phase!="end" and phase!="cancel" { throw "input_surface: invalid phase"; }
        let time=_number(try event.time_ms catch nil,0,86400000);
        if i==0 { first=time; }
        if time<previous { throw "input_surface: non-monotonic time"; } previous=time;
        _number(try event.x catch nil,0,1); _number(try event.y catch nil,0,1);
        let is_active=map_has(active,id) and active[id]!=nil;
        if phase=="start" {
            if is_active { throw "input_surface: duplicate contact start"; }
            active[id]=kind; current=current+1; started=started+1;
            if current>peak { peak=current; }
        }
        if phase!="start" {
            if not is_active or active[id]!=kind { throw "input_surface: contact state mismatch"; }
        }
        if kind!="pen" and (map_has(event,"pressure") or map_has(event,"tilt_x") or map_has(event,"tilt_y")) {
            throw "input_surface: pen fields on other pointer";
        }
        if map_has(event,"pressure") {
            let p=_number(event.pressure,0,1); pressure_sum=pressure_sum+p; pressure_count=pressure_count+1;
            if p>peak_pressure { peak_pressure=p; }
        }
        for key in ["tilt_x","tilt_y"] {
            if map_has(event,key) { let t=_number(event[key],-90,90); if t<0 {t=0-t;} if t>max_tilt {max_tilt=t;} }
        }
        if kind=="pen" { pens=pens+1; } if kind=="touch" { touches=touches+1; } if kind=="mouse" { mice=mice+1; }
        if phase=="end" { ended=ended+1; active[id]=nil; current=current-1; }
        if phase=="cancel" { cancelled=cancelled+1; active[id]=nil; current=current-1; }
    }
    return map{event_count:len(events),contacts_started:started,contacts_ended:ended,contacts_cancelled:cancelled,
        active_contacts:current,peak_contacts:peak,complete:current==0,duration_ms:previous-first,
        pen_events:pens,touch_events:touches,mouse_events:mice,pressure_samples:pressure_count,
        mean_pressure:if pressure_count==0{nil}else{pressure_sum/pressure_count},peak_pressure:peak_pressure,
        max_absolute_tilt:max_tilt,coordinates_included:false,contact_ids_included:false,
        device_accessed:false,input_injected:false,hard_realtime:false};
}
export transform,analyze;
