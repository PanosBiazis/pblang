// stdlib/env.sapp — Environment / configuration management.
//
// Loads .env files, validates required vars, and provides a typed config layer.
//
// Usage:
//   let env = import("stdlib:env.sapp");
//   env.load(".env");         // Load .env file
//   let port = env.int("PORT", 8080);
//   let debug = env.bool("DEBUG", false);
//   let dsn = env.required("DATABASE_URL");

// _local_overrides — module-level map for env overrides (since env_set is disabled for thread safety)
let _local_overrides = map{};

// load(path) — parse and set environment variables from a .env file.
// Supports: KEY=value, KEY="value with spaces", # comments, blank lines.
fn load(path) {
    let raw = try fs_read(path) catch nil;
    if raw == nil { return map{ ok: false, error: "cannot read " + path }; }
    let lines = str_split(raw, "\n");
    let loaded = 0;
    for i len(lines) {
        let line = str_trim(lines[i]);
        if line == "" or str_starts_with(line, "#") { } // skip
        else {
            let eq = str_index_of(line, "=");
            if eq > 0 {
                let key = str_trim(str_slice(line, 0, eq));
                let val = str_trim(str_slice(line, eq + 1, len(line)));
                // Strip surrounding quotes
                if str_starts_with(val, "\"") and str_ends_with(val, "\"") {
                    val = str_slice(val, 1, len(val) - 1);
                } else if str_starts_with(val, "'") and str_ends_with(val, "'") {
                    val = str_slice(val, 1, len(val) - 1);
                }
                // Remove inline comments (# after value)
                let comment_pos = str_index_of(val, " #");
                if comment_pos >= 0 {
                    val = str_trim(str_slice(val, 0, comment_pos));
                }
                env_set(key, val);
                loaded = loaded + 1;
            }
        }
    }
    return map{ ok: true, loaded: loaded };
}

// get(key) — get env var or nil (checks local overrides first)
fn get(key) {
    let local = try _local_overrides[key] catch nil;
    if local != nil { return local; }
    return env_get(key);
}

// get_default(key, default_val) — get env var with default
fn get_default(key, default_val) {
    let v = get(key);
    if v == nil { return default_val; }
    return v;
}

// required(key) — get env var or throw error
fn required(key) {
    let v = get(key);
    if v == nil {
        return error("env: required variable '" + key + "' is not set");
    }
    return v;
}

// int(key, default_val) — get env var as integer
fn int(key, default_val) {
    let v = get(key);
    if v == nil { return default_val; }
    let n = parse_number(v);
    if n == nil { return default_val; }
    return num_floor(n);
}

// float(key, default_val) — get env var as float
fn float(key, default_val) {
    let v = get(key);
    if v == nil { return default_val; }
    let n = parse_number(v);
    if n == nil { return default_val; }
    return n;
}

// bool(key, default_val) — get env var as boolean
// "true", "1", "yes", "on" → true. "false", "0", "no", "off" → false.
fn bool(key, default_val) {
    let v = get(key);
    if v == nil { return default_val; }
    let lower = str_lower(v);
    if lower == "true" or lower == "1" or lower == "yes" or lower == "on" { return true; }
    if lower == "false" or lower == "0" or lower == "no" or lower == "off" { return false; }
    return default_val;
}

// list(key, sep, default_val) — get env var as array (split by sep)
fn list(key, sep, default_val) {
    let v = get(key);
    if v == nil { return default_val; }
    if sep == nil { sep = ","; }
    let parts = str_split(v, sep);
    let out = [];
    for i len(parts) {
        let p = str_trim(parts[i]);
        if p != "" { out[len(out)] = p; }
    }
    return out;
}

// set(key, value) — set a local env override (visible within this module only)
fn set(key, value) {
    _local_overrides[key] = str(value);
    return true;
}

// all() — map of the env values this module tracks (local overrides + loaded .env).
// A full OS environment dump needs native support; this returns what is enumerable.
fn all() {
    let out = map{};
    let ks = map_keys(_local_overrides);
    let i = 0;
    while i < len(ks) { out[ks[i]] = _local_overrides[ks[i]]; i = i + 1; }
    return out;
}

// has(key) — true if the variable resolves to a value (override or OS env).
fn has(key) { return get(key) != nil; }

// keys() — the names of the env values this module can enumerate (see all()).
fn keys() { return map_keys(_local_overrides); }

// expand(s) — substitute $VAR and ${VAR} using get() (override-aware); unknown -> "".
fn expand(s) {
    let out = "";
    let i = 0;
    let n = len(s);
    while i < n {
        if str_slice(s, i, i + 1) == "$" {
            if i + 1 < n and str_slice(s, i + 1, i + 2) == "{" {
                let j = i + 2;
                let name = "";
                while j < n and str_slice(s, j, j + 1) != "}" { name = name + str_slice(s, j, j + 1); j = j + 1; }
                let v = get(name);
                if v == nil { v = ""; }
                out = out + v;
                i = j + 1;
            } else {
                let j = i + 1;
                let name = "";
                let go = true;
                while j < n and go {
                    let c = strcharcodeat(s, j);
                    if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 95 {
                        name = name + str_slice(s, j, j + 1);
                        j = j + 1;
                    } else { go = false; }
                }
                if name == "" { out = out + "$"; i = i + 1; }
                else {
                    let v = get(name);
                    if v == nil { v = ""; }
                    out = out + v;
                    i = j;
                }
            }
        } else {
            out = out + str_slice(s, i, i + 1);
            i = i + 1;
        }
    }
    return out;
}

// validate(schema) — validate that all required env vars are present and typed.
// schema: map{ KEY: { required: bool, type: "string"|"int"|"float"|"bool", default: ... } }
fn validate(schema) {
    let errors = [];
    let keys = map_keys(schema);
    for i len(keys) {
        let key = keys[i];
        let spec = schema[key];
        let v = get(key);
        let is_required = try spec.required catch false;
        if v == nil {
            if is_required {
                errors[len(errors)] = "required env var '" + key + "' is not set";
            }
        } else {
            let expected_type = try spec.type catch "string";
            if expected_type == "int" or expected_type == "float" {
                if parse_number(v) == nil {
                    errors[len(errors)] = "env var '" + key + "' must be a number, got '" + v + "'";
                }
            } else if expected_type == "bool" {
                let lower = str_lower(v);
                if lower != "true" and lower != "false" and lower != "1" and lower != "0" and lower != "yes" and lower != "no" and lower != "on" and lower != "off" {
                    errors[len(errors)] = "env var '" + key + "' must be a boolean, got '" + v + "'";
                }
            }
        }
    }
    if len(errors) > 0 {
        return map{ ok: false, errors: errors };
    }
    return map{ ok: true, errors: [] };
}

// prefix(ns) — map of tracked vars whose name starts with `ns`, with `ns` stripped
// from the keys (namespaced config, e.g. prefix("APP_") -> { DB: ..., PORT: ... }).
fn prefix(ns) {
    let out = map{};
    let ks = keys();
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        if str_starts_with(k, ns) {
            out[str_slice(k, len(ns), len(k))] = get(k);
        }
        i = i + 1;
    }
    return out;
}

// load_or(path) — load a .env file if present; returns how many vars were loaded
// (0 if the file is missing or unreadable). Never errors.
fn load_or(path) {
    let r = try load(path) catch nil;
    if r == nil { return 0; }
    let ok = try r.ok catch false;
    if not ok { return 0; }
    return try r.loaded catch 0;
}

export load, get, get_default, required, int, float, bool, list, set, all, validate,
       has, keys, expand, prefix, load_or;
