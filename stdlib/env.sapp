// stdlib/env.sapp — Environment / configuration management.
//
// Loads .env files, validates required vars, and provides a typed config layer.
//
// Usage:
//   let env = import("stdlib:env.sapp");
//   env.load(".env");         // Load .env file
//   let port = env.int("PORT", 8080);
//   let debug = env.bool("DEBUG", false);
//   let dsn = env.required("DATABASE_URL");

// Process-wide env_set is deliberately disabled. Overrides live in bounded
// PBLang maps, so reads and writes never mutate the host process environment.
let MAX_KEY_BYTES = 128;
let MAX_VALUE_BYTES = 4096;
let MAX_ENTRIES = 256;
let MAX_TOTAL_BYTES = 65536;
let MAX_FILE_BYTES = 1048576;

let _local_overrides = map{};

fn _fault(message) { throw "env: " + message; }

fn _valid_key_byte(byte, first) {
    if (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95 {
        return true;
    }
    return not first and ((byte >= 48 and byte <= 57) or byte == 46 or byte == 45);
}

fn _key(key) {
    if not is_string(key) or key == "" or str_contains(key, "\x00") {
        _fault("key must be a non-empty portable string");
    }
    let bytes = str_to_bytes(key);
    if len(bytes) > MAX_KEY_BYTES { _fault("key exceeds byte limit"); }
    let i = 0;
    while i < len(bytes) {
        if not _valid_key_byte(bytes[i], i == 0) {
            _fault("key must match [A-Za-z_][A-Za-z0-9_.-]*");
        }
        i = i + 1;
    }
    return key;
}

fn _value(value) {
    if not is_string(value) or str_contains(value, "\x00")
        or len(str_to_bytes(value)) > MAX_VALUE_BYTES {
        _fault("value must be a bounded NUL-free UTF-8 string");
    }
    return value;
}

fn validate_key(key) { return _key(key); }
fn validate_value(value) { return _value(value); }

fn _copy(values) {
    let out = map{}; let names = map_keys(values); let i = 0;
    while i < len(names) { out[names[i]] = values[names[i]]; i = i + 1; }
    return out;
}

fn _usage(values) {
    let names = map_keys(values); let total = 0; let i = 0;
    while i < len(names) {
        total = total + len(str_to_bytes(names[i])) + len(str_to_bytes(values[names[i]]));
        i = i + 1;
    }
    return map{ entries: len(names), bytes: total };
}

fn _checked_set(values, key, value) {
    key = _key(key); value = _value(value);
    let candidate = _copy(values); candidate[key] = value;
    let usage = _usage(candidate);
    if usage.entries > MAX_ENTRIES { _fault("entry limit exceeded"); }
    if usage.bytes > MAX_TOTAL_BYTES { _fault("aggregate byte limit exceeded"); }
    return candidate;
}

// load(path) — parse and set environment variables from a .env file.
// Supports: KEY=value, KEY="value with spaces", # comments, blank lines.
fn load(path) {
    let raw = try fs_read(path) catch nil;
    if raw == nil { return map{ ok: false, error: "cannot read " + path }; }
    if not is_string(raw) or len(str_to_bytes(raw)) > MAX_FILE_BYTES {
        return map{ ok: false, error: "environment file exceeds byte limit" };
    }
    let lines = str_split(raw, "\n");
    let candidate = _copy(_local_overrides); let loaded = 0;
    for i len(lines) {
        let line = str_trim(lines[i]);
        if line == "" or str_starts_with(line, "#") { } // skip
        else {
            let eq = str_index_of(line, "=");
            if eq > 0 {
                let key = str_trim(str_slice(line, 0, eq));
                let val = str_trim(str_slice(line, eq + 1, len(line)));
                // Strip surrounding quotes
                if str_starts_with(val, "\"") and str_ends_with(val, "\"") {
                    val = str_slice(val, 1, len(val) - 1);
                } else if str_starts_with(val, "'") and str_ends_with(val, "'") {
                    val = str_slice(val, 1, len(val) - 1);
                }
                // Remove inline comments (# after value)
                let comment_pos = str_index_of(val, " #");
                if comment_pos >= 0 {
                    val = str_trim(str_slice(val, 0, comment_pos));
                }
                candidate = try _checked_set(candidate, key, val) catch nil;
                if candidate == nil {
                    return map{ ok: false, error: "invalid environment entry on line " + str(i + 1) };
                }
                loaded = loaded + 1;
            }
        }
    }
    _local_overrides = candidate;
    return map{ ok: true, loaded: loaded };
}

// get(key) — get env var or nil (checks local overrides first)
fn get(key) {
    key = _key(key);
    if map_has(_local_overrides, key) { return _local_overrides[key]; }
    return env_get(key);
}

// get_default(key, default_val) — get env var with default
fn get_default(key, default_val) {
    let v = get(key);
    if v == nil { return default_val; }
    return v;
}

// required(key) — get env var or throw error
fn required(key) {
    let v = get(key);
    if v == nil {
        return error("env: required variable '" + key + "' is not set");
    }
    return v;
}

// int(key, default_val) — get env var as integer
fn int(key, default_val) {
    let v = get(key);
    if v == nil { return default_val; }
    let n = parse_number(v);
    if n == nil { return default_val; }
    return num_floor(n);
}

// float(key, default_val) — get env var as float
fn float(key, default_val) {
    let v = get(key);
    if v == nil { return default_val; }
    let n = parse_number(v);
    if n == nil { return default_val; }
    return n;
}

// bool(key, default_val) — get env var as boolean
// "true", "1", "yes", "on" → true. "false", "0", "no", "off" → false.
fn bool(key, default_val) {
    let v = get(key);
    if v == nil { return default_val; }
    let lower = str_lower(v);
    if lower == "true" or lower == "1" or lower == "yes" or lower == "on" { return true; }
    if lower == "false" or lower == "0" or lower == "no" or lower == "off" { return false; }
    return default_val;
}

// list(key, sep, default_val) — get env var as array (split by sep)
fn list(key, sep, default_val) {
    let v = get(key);
    if v == nil { return default_val; }
    if sep == nil { sep = ","; }
    let parts = str_split(v, sep);
    let out = [];
    for i len(parts) {
        let p = str_trim(parts[i]);
        if p != "" { out[len(out)] = p; }
    }
    return out;
}

// set(key, value) — set a local env override (visible within this module only)
fn set(key, value) {
    _local_overrides = _checked_set(_local_overrides, key, str(value));
    return true;
}

// unset(key) removes only the PBLang-local override. It never changes the host.
fn unset(key) {
    key = _key(key);
    if map_has(_local_overrides, key) { map_remove(_local_overrides, key); return true; }
    return false;
}

// all() — map of the env values this module tracks (local overrides + loaded .env).
// A full OS environment dump needs native support; this returns what is enumerable.
fn all() {
    return _copy(_local_overrides);
}

// has(key) — true if the variable resolves to a value (override or OS env).
fn has(key) { return get(key) != nil; }

// keys() — the names of the env values this module can enumerate (see all()).
fn keys() { return array_sort(map_keys(_local_overrides)); }

// virtual(initial) creates an isolated environment suitable for embedded,
// concurrent and sandboxed runtimes. It never falls back to host env_get.
fn virtual(initial = nil) {
    if initial != nil and not is_map(initial) { _fault("initial values must be a map"); }
    let values = map{};
    if initial != nil {
        let names = array_sort(map_keys(initial)); let i = 0;
        while i < len(names) {
            values = _checked_set(values, names[i], str(initial[names[i]]));
            i = i + 1;
        }
    }
    return map{
        format: "pblang.virtual-environment.v1", values: values,
        limits: map{ max_key_bytes: MAX_KEY_BYTES, max_value_bytes: MAX_VALUE_BYTES,
            max_entries: MAX_ENTRIES, max_total_bytes: MAX_TOTAL_BYTES },
        host_environment_access: false, process_environment_mutation: false
    };
}

fn _require_virtual(environment) {
    if not is_map(environment) { _fault("invalid virtual environment"); }
    let format = try environment.format catch nil;
    if format != "pblang.virtual-environment.v1" or not map_has(environment, "values")
        or not is_map(environment.values) {
        _fault("invalid virtual environment");
    }
}

fn virtual_get(environment, key) {
    _require_virtual(environment);
    key = _key(key);
    return if map_has(environment.values, key) { environment.values[key] } else { nil };
}

fn virtual_set(environment, key, value) {
    _require_virtual(environment);
    environment.values = _checked_set(environment.values, key, str(value)); return nil;
}

fn virtual_unset(environment, key) {
    key = _key(key);
    if virtual_get(environment, key) != nil {
        map_remove(environment.values, key); return true;
    }
    return false;
}

fn virtual_has(environment, key) { return virtual_get(environment, key) != nil; }
fn virtual_all(environment) {
    virtual_get(environment, "__pblang_validation_probe__");
    return _copy(environment.values);
}
fn virtual_keys(environment) { return array_sort(map_keys(virtual_all(environment))); }
fn virtual_usage(environment) { return _usage(virtual_all(environment)); }

// expand(s) — substitute $VAR and ${VAR} using get() (override-aware); unknown -> "".
fn expand(s) {
    let out = "";
    let i = 0;
    let n = len(s);
    while i < n {
        if str_slice(s, i, i + 1) == "$" {
            if i + 1 < n and str_slice(s, i + 1, i + 2) == "{" {
                let j = i + 2;
                let name = "";
                while j < n and str_slice(s, j, j + 1) != "}" { name = name + str_slice(s, j, j + 1); j = j + 1; }
                let v = get(name);
                if v == nil { v = ""; }
                out = out + v;
                i = j + 1;
            } else {
                let j = i + 1;
                let name = "";
                let go = true;
                while j < n and go {
                    let c = strcharcodeat(s, j);
                    if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 95 {
                        name = name + str_slice(s, j, j + 1);
                        j = j + 1;
                    } else { go = false; }
                }
                if name == "" { out = out + "$"; i = i + 1; }
                else {
                    let v = get(name);
                    if v == nil { v = ""; }
                    out = out + v;
                    i = j;
                }
            }
        } else {
            out = out + str_slice(s, i, i + 1);
            i = i + 1;
        }
    }
    return out;
}

// validate(schema) — validate that all required env vars are present and typed.
// schema: map{ KEY: { required: bool, type: "string"|"int"|"float"|"bool", default: ... } }
fn validate(schema) {
    let errors = [];
    let keys = map_keys(schema);
    for i len(keys) {
        let key = keys[i];
        let spec = schema[key];
        let v = get(key);
        let is_required = try spec.required catch false;
        if v == nil {
            if is_required {
                errors[len(errors)] = "required env var '" + key + "' is not set";
            }
        } else {
            let expected_type = try spec.type catch "string";
            if expected_type == "int" or expected_type == "float" {
                if parse_number(v) == nil {
                    errors[len(errors)] = "env var '" + key + "' must be a number, got '" + v + "'";
                }
            } else if expected_type == "bool" {
                let lower = str_lower(v);
                if lower != "true" and lower != "false" and lower != "1" and lower != "0" and lower != "yes" and lower != "no" and lower != "on" and lower != "off" {
                    errors[len(errors)] = "env var '" + key + "' must be a boolean, got '" + v + "'";
                }
            }
        }
    }
    if len(errors) > 0 {
        return map{ ok: false, errors: errors };
    }
    return map{ ok: true, errors: [] };
}

// prefix(ns) — map of tracked vars whose name starts with `ns`, with `ns` stripped
// from the keys (namespaced config, e.g. prefix("APP_") -> { DB: ..., PORT: ... }).
fn prefix(ns) {
    let out = map{};
    let ks = keys();
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        if str_starts_with(k, ns) {
            out[str_slice(k, len(ns), len(k))] = get(k);
        }
        i = i + 1;
    }
    return out;
}

// load_or(path) — load a .env file if present; returns how many vars were loaded
// (0 if the file is missing or unreadable). Never errors.
fn load_or(path) {
    let r = try load(path) catch nil;
    if r == nil { return 0; }
    let ok = try r.ok catch false;
    if not ok { return 0; }
    return try r.loaded catch 0;
}

export MAX_KEY_BYTES, MAX_VALUE_BYTES, MAX_ENTRIES, MAX_TOTAL_BYTES, MAX_FILE_BYTES,
       validate_key, validate_value,
       load, get, get_default, required, int, float, bool, list, set, unset, all,
       validate, has, keys, virtual, virtual_get, virtual_set, virtual_unset,
       virtual_has, virtual_all, virtual_keys, virtual_usage, expand, prefix, load_or;
