let StudyFiles=import("stdlib:study_files.sapp");let Lesson=import("stdlib:lesson_bundle.sapp");
let File=import("stdlib:secure_file.sapp");let Writer=import("stdlib:text_document_files.sapp");
let Worksheet=import("stdlib:study_worksheet.sapp");
fn open(path) {
    if type(path)!="string" or len(path)>4096 or len(str_to_bytes(path))>4096 {return map{ok:false,error:"Choose a .pbdeck or .pblesson source."};}
    if str_ends_with(str_lower(path),".pbdeck") {return StudyFiles.open_deck(path);}
    if len(path)<=9 or not str_ends_with(str_lower(path),".pblesson") {return map{ok:false,error:"Choose a .pbdeck or .pblesson source."};}
    let read=try File.read_text(path,Lesson.MAX_FILE_BYTES,false) catch nil;
    if read==nil or not read.ok {return map{ok:false,error:"Could not read lesson."};}
    let deck=try Lesson.cards(Lesson.decode(read.text)) catch nil;
    if deck==nil {return map{ok:false,error:"Invalid lesson."};}
    return map{ok:true,deck:deck};
}
fn save(path,deck,kind,first,count) {
    let doc=try Worksheet.create(deck,kind,first,count) catch nil;
    if doc==nil {return map{ok:false,error:"Invalid card range or Writer limits exceeded. Select fewer cards."};}
    return Writer.save_copy(path,doc);
}
export open,save;
