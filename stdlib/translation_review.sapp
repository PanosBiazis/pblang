// Compare explicit message records using the existing literal {{name}} grammar.
// Reports retain caller IDs and field names, but never message text. No translation or I/O.
let F=import("stdlib:template_fields.sapp");
let MAX_MESSAGES=128;let MAX_TOTAL_BYTES=131072;
fn _catalog(records) {
 if type(records)!="array" or len(records)>MAX_MESSAGES {throw "translation: message limit";}
 let out=map{};let total=0;
 for record in records {
  if type(record)!="map" or len(record)!=2 or not F.valid_name(try record.id catch nil) or type(try record.text catch nil)!="string" {throw "translation: invalid message";}
  if map_has(out,record.id) {throw "translation: duplicate message id";}
  total=total+len(str_to_bytes(record.text));if total>MAX_TOTAL_BYTES {throw "translation: text budget";}
  let plan=F.compile(record.text);let counts=map{};
  for token in plan.tokens {if token.kind=="field" {counts[token.value]=(try counts[token.value] catch 0)+1;}}
  out[record.id]=map{names:F.names(plan),counts:counts,empty:len(str_trim(record.text))==0};
 }
 return out;
}
fn review(source,translated) {
 let base=_catalog(source);let target=_catalog(translated);let missing=[];let extra=[];let messages=[];let mismatches=0;let empty=0;
 for record in source {
  if not map_has(target,record.id) {array_push(missing,record.id);}
  else {
   let a=base[record.id];let b=target[record.id];let absent=[];let added=[];let changed=[];
   for name in a.names {
    if not map_has(b.counts,name) {array_push(absent,name);}
    elif a.counts[name]!=b.counts[name] {array_push(changed,map{name:name,source_count:a.counts[name],translated_count:b.counts[name]});}
   }
   for name in b.names {if not map_has(a.counts,name) {array_push(added,name);}}
   let same=len(absent)==0 and len(added)==0 and len(changed)==0;
   if not same {mismatches=mismatches+1;}
   if b.empty {empty=empty+1;}
   array_push(messages,map{id:record.id,missing_fields:absent,extra_fields:added,changed_counts:changed,empty_translation:b.empty,fields_match:same});
  }
 }
 for record in translated {if not map_has(base,record.id) {array_push(extra,record.id);}}
 return map{format:"pblang.translation-review.v1",ok:len(missing)==0 and len(extra)==0 and mismatches==0 and empty==0,missing_ids:missing,extra_ids:extra,messages:messages,mismatched_messages:mismatches,empty_translations:empty,contains_input_identifiers:true};
}
export MAX_MESSAGES,MAX_TOTAL_BYTES,review;
