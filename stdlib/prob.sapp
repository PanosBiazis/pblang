// stdlib/prob.sapp — Probability layer for pblang (pure pblang, no Rust).
//
// Combinatorics (exact for small n), the gamma & error functions, and the five
// workhorse distributions — normal, binomial, Poisson, uniform, exponential —
// each with pmf/pdf and cdf, plus Shannon entropy. Built for stats, risk, and
// Monte-Carlo work. Pair with stdlib:random.sapp for sampling.
//
//   let prob = import("stdlib:prob.sapp");
//   prob.comb(10, 3);                  // 120
//   prob.normal_cdf(1.96, 0, 1);       // ~0.975
//   prob.poisson_pmf(2, 2.0);          // ~0.2707

let _PI  = 3.141592653589793;
let _SQ2 = 1.4142135623730951;     // sqrt(2)
let _S2PI = 2.5066282746310002;    // sqrt(2*pi)
let _LN2 = 0.6931471805599453;

// ── small transcendental helpers (keep this module dependency-free) ───────────
fn _sin(x) {
    let x = num_mod(x, 2 * _PI);
    let result = x;
    let term = x;
    for i in 1 to 12 {
        term = term * (0 - x * x) / ((2 * i) * (2 * i + 1));
        result = result + term;
    }
    return result;
}

// ── Combinatorics ─────────────────────────────────────────────────────────────
// factorial(n) → n!  (exact up to 170!, then overflows to inf as f64 does)
fn factorial(n) {
    let r = 1;
    let i = 2;
    while i <= n { r = r * i; i = i + 1; }
    return r;
}

// perm(n, k) → number of ordered arrangements n!/(n-k)!
fn perm(n, k) {
    if k < 0 or k > n { return 0; }
    let r = 1;
    let i = 0;
    while i < k { r = r * (n - i); i = i + 1; }
    return r;
}

// comb(n, k) → binomial coefficient "n choose k" (multiplicative, stays integral)
fn comb(n, k) {
    if k < 0 or k > n { return 0; }
    if k > n - k { k = n - k; }
    let r = 1;
    let i = 0;
    while i < k {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

// ── Gamma (Lanczos g=7) and the error function (Abramowitz–Stegun 7.1.26) ─────
fn gamma(z) {
    // reflection for the left half-plane: Γ(z)Γ(1-z) = π / sin(πz)
    if z < 0.5 {
        return _PI / (_sin(_PI * z) * gamma(1 - z));
    }
    let g = 7;
    let c = [0.99999999999980993, 676.5203681218851, -1259.1392167224028,
             771.32342877765313, -176.61502916214059, 12.507343278686905,
             -0.13857109526572012, 0.0000099843695780195716,
             0.00000015056327351493116];
    let zz = z - 1;
    let x = c[0];
    let i = 1;
    while i <= g + 1 {
        x = x + c[i] / (zz + i);
        i = i + 1;
    }
    let t = zz + g + 0.5;
    return _S2PI * num_pow(t, zz + 0.5) * num_exp(0 - t) * x;
}

fn erf(x) {
    let sign = 1;
    let ax = x;
    if x < 0 { sign = 0 - 1; ax = 0 - x; }
    let p = 0.3275911;
    let t = 1 / (1 + p * ax);
    let y = 1 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t
                  - 0.284496736) * t + 0.254829592) * t * num_exp(0 - ax * ax);
    return sign * y;
}

// ── Normal / Gaussian ─────────────────────────────────────────────────────────
fn normal_pdf(x, mu, sigma) {
    let z = (x - mu) / sigma;
    return num_exp(0 - 0.5 * z * z) / (sigma * _S2PI);
}
fn normal_cdf(x, mu, sigma) {
    return 0.5 * (1 + erf((x - mu) / (sigma * _SQ2)));
}

// ── Binomial ──────────────────────────────────────────────────────────────────
fn binomial_pmf(k, n, p) {
    if k < 0 or k > n { return 0; }
    return comb(n, k) * num_pow(p, k) * num_pow(1 - p, n - k);
}
fn binomial_cdf(k, n, p) {
    let acc = 0;
    let i = 0;
    while i <= k { acc = acc + binomial_pmf(i, n, p); i = i + 1; }
    return acc;
}

// ── Poisson ───────────────────────────────────────────────────────────────────
fn poisson_pmf(k, lambda) {
    if k < 0 { return 0; }
    return num_exp(0 - lambda) * num_pow(lambda, k) / factorial(k);
}
fn poisson_cdf(k, lambda) {
    let acc = 0;
    let i = 0;
    while i <= k { acc = acc + poisson_pmf(i, lambda); i = i + 1; }
    return acc;
}

// ── Uniform (continuous) ──────────────────────────────────────────────────────
fn uniform_pdf(x, a, b) {
    if x < a or x > b { return 0; }
    return 1 / (b - a);
}
fn uniform_cdf(x, a, b) {
    if x < a { return 0; }
    if x > b { return 1; }
    return (x - a) / (b - a);
}

// ── Exponential ───────────────────────────────────────────────────────────────
fn exp_pdf(x, rate) {
    if x < 0 { return 0; }
    return rate * num_exp(0 - rate * x);
}
fn exp_cdf(x, rate) {
    if x < 0 { return 0; }
    return 1 - num_exp(0 - rate * x);
}

// ── Shannon entropy (in bits) of a probability vector ─────────────────────────
fn entropy(probs) {
    let h = 0;
    let i = 0;
    while i < len(probs) {
        let p = probs[i];
        if p > 0 { h = h - p * (num_ln(p) / _LN2); }
        i = i + 1;
    }
    return h;
}

export factorial, perm, comb, gamma, erf,
       normal_pdf, normal_cdf, binomial_pmf, binomial_cdf,
       poisson_pmf, poisson_cdf, uniform_pdf, uniform_cdf,
       exp_pdf, exp_cdf, entropy;
