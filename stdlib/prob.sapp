// stdlib/prob.sapp — Probability layer for pblang (pure pblang, no Rust).
//
// Combinatorics (exact for small n), the gamma & error functions, and the five
// workhorse distributions — normal, binomial, Poisson, uniform, exponential —
// each with pmf/pdf and cdf, plus Shannon entropy. Built for stats, risk, and
// Monte-Carlo work. Pair with stdlib:random.sapp for sampling.
//
//   let prob = import("stdlib:prob.sapp");
//   prob.comb(10, 3);                  // 120
//   prob.normal_cdf(1.96, 0, 1);       // ~0.975
//   prob.poisson_pmf(2, 2.0);          // ~0.2707

let _PI  = 3.141592653589793;
let _SQ2 = 1.4142135623730951;     // sqrt(2)
let _S2PI = 2.5066282746310002;    // sqrt(2*pi)
let _LN2 = 0.6931471805599453;

// ── small transcendental helpers (keep this module dependency-free) ───────────
fn _sin(x) {
    let x = num_mod(x, 2 * _PI);
    let result = x;
    let term = x;
    for i in 1 to 12 {
        term = term * (0 - x * x) / ((2 * i) * (2 * i + 1));
        result = result + term;
    }
    return result;
}

// ── Combinatorics ─────────────────────────────────────────────────────────────
// factorial(n) → n!  (exact up to 170!, then overflows to inf as f64 does)
fn factorial(n) {
    let r = 1;
    let i = 2;
    while i <= n { r = r * i; i = i + 1; }
    return r;
}

// perm(n, k) → number of ordered arrangements n!/(n-k)!
fn perm(n, k) {
    if k < 0 or k > n { return 0; }
    let r = 1;
    let i = 0;
    while i < k { r = r * (n - i); i = i + 1; }
    return r;
}

// comb(n, k) → binomial coefficient "n choose k" (multiplicative, stays integral)
fn comb(n, k) {
    if k < 0 or k > n { return 0; }
    if k > n - k { k = n - k; }
    let r = 1;
    let i = 0;
    while i < k {
        r = r * (n - i) / (i + 1);
        i = i + 1;
    }
    return r;
}

// ── Gamma (Lanczos g=7) and the error function (Abramowitz–Stegun 7.1.26) ─────
fn gamma(z) {
    // reflection for the left half-plane: Γ(z)Γ(1-z) = π / sin(πz)
    if z < 0.5 {
        return _PI / (_sin(_PI * z) * gamma(1 - z));
    }
    let g = 7;
    let c = [0.99999999999980993, 676.5203681218851, -1259.1392167224028,
             771.32342877765313, -176.61502916214059, 12.507343278686905,
             -0.13857109526572012, 0.0000099843695780195716,
             0.00000015056327351493116];
    let zz = z - 1;
    let x = c[0];
    let i = 1;
    while i <= g + 1 {
        x = x + c[i] / (zz + i);
        i = i + 1;
    }
    let t = zz + g + 0.5;
    return _S2PI * num_pow(t, zz + 0.5) * num_exp(0 - t) * x;
}

fn erf(x) {
    let sign = 1;
    let ax = x;
    if x < 0 { sign = 0 - 1; ax = 0 - x; }
    let p = 0.3275911;
    let t = 1 / (1 + p * ax);
    let y = 1 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t
                  - 0.284496736) * t + 0.254829592) * t * num_exp(0 - ax * ax);
    return sign * y;
}

// ── Normal / Gaussian ─────────────────────────────────────────────────────────
fn normal_pdf(x, mu, sigma) {
    let z = (x - mu) / sigma;
    return num_exp(0 - 0.5 * z * z) / (sigma * _S2PI);
}
fn normal_cdf(x, mu, sigma) {
    return 0.5 * (1 + erf((x - mu) / (sigma * _SQ2)));
}

// ── Binomial ──────────────────────────────────────────────────────────────────
fn binomial_pmf(k, n, p) {
    if k < 0 or k > n { return 0; }
    return comb(n, k) * num_pow(p, k) * num_pow(1 - p, n - k);
}
fn binomial_cdf(k, n, p) {
    let acc = 0;
    let i = 0;
    while i <= k { acc = acc + binomial_pmf(i, n, p); i = i + 1; }
    return acc;
}

// ── Poisson ───────────────────────────────────────────────────────────────────
fn poisson_pmf(k, lambda) {
    if k < 0 { return 0; }
    return num_exp(0 - lambda) * num_pow(lambda, k) / factorial(k);
}
fn poisson_cdf(k, lambda) {
    let acc = 0;
    let i = 0;
    while i <= k { acc = acc + poisson_pmf(i, lambda); i = i + 1; }
    return acc;
}

// ── Uniform (continuous) ──────────────────────────────────────────────────────
fn uniform_pdf(x, a, b) {
    if x < a or x > b { return 0; }
    return 1 / (b - a);
}
fn uniform_cdf(x, a, b) {
    if x < a { return 0; }
    if x > b { return 1; }
    return (x - a) / (b - a);
}

// ── Exponential ───────────────────────────────────────────────────────────────
fn exp_pdf(x, rate) {
    if x < 0 { return 0; }
    return rate * num_exp(0 - rate * x);
}
fn exp_cdf(x, rate) {
    if x < 0 { return 0; }
    return 1 - num_exp(0 - rate * x);
}

// ── Quantiles (inverse CDF / percent-point function) ──────────────────────────
// normal_ppf: inverse standard-normal CDF via Acklam's rational approximation
// (relative error < 1.15e-9), then shifted/scaled to N(mu, sigma).
fn _norm_ppf_std(p) {
    if p <= 0 { return 0 - 1 / 0; }   // -inf
    if p >= 1 { return 1 / 0; }       // +inf
    let a1 = -39.69683028665376;  let a2 = 220.9460984245205;
    let a3 = -275.9285104469687;  let a4 = 138.3577518672690;
    let a5 = -30.66479806614716;  let a6 = 2.506628277459239;
    let b1 = -54.47609879822406;  let b2 = 161.5858368580409;
    let b3 = -155.6989798598866;  let b4 = 66.80131188771972;
    let b5 = -13.28068155288572;
    let c1 = -0.007784894002430293; let c2 = -0.3223964580411365;
    let c3 = -2.400758277161838;    let c4 = -2.549732539343734;
    let c5 = 4.374664141464968;     let c6 = 2.938163982698783;
    let d1 = 0.007784695709041462;  let d2 = 0.3224671290700398;
    let d3 = 2.445134137142996;     let d4 = 3.754408661907416;
    let p_low = 0.02425;
    let p_high = 1 - p_low;
    if p < p_low {
        let q = num_sqrt(0 - 2 * num_ln(p));
        return (((((c1 * q + c2) * q + c3) * q + c4) * q + c5) * q + c6)
             / ((((d1 * q + d2) * q + d3) * q + d4) * q + 1);
    }
    if p <= p_high {
        let q = p - 0.5;
        let r = q * q;
        return (((((a1 * r + a2) * r + a3) * r + a4) * r + a5) * r + a6) * q
             / (((((b1 * r + b2) * r + b3) * r + b4) * r + b5) * r + 1);
    }
    let q = num_sqrt(0 - 2 * num_ln(1 - p));
    return 0 - (((((c1 * q + c2) * q + c3) * q + c4) * q + c5) * q + c6)
             / ((((d1 * q + d2) * q + d3) * q + d4) * q + 1);
}
fn normal_ppf(p, mu, sigma) { return mu + sigma * _norm_ppf_std(p); }

// exp_ppf: inverse exponential CDF
fn exp_ppf(p, rate) { return (0 - num_ln(1 - p)) / rate; }

// uniform_ppf: inverse continuous-uniform CDF
fn uniform_ppf(p, a, b) { return a + p * (b - a); }

// ── Risk metrics (parametric, assuming normal returns) ────────────────────────
// value_at_risk: the loss threshold not exceeded with probability `confidence`.
// For returns R ~ N(mu, sigma): VaR = -(mu + sigma * Φ⁻¹(1-confidence)).
fn value_at_risk(mu, sigma, confidence) {
    return 0 - (mu + sigma * _norm_ppf_std(1 - confidence));
}

// conditional_value_at_risk: expected shortfall — the mean loss GIVEN the loss
// exceeds VaR. For normal returns: CVaR = -mu + sigma * φ(Φ⁻¹(c)) / (1-c).
fn conditional_value_at_risk(mu, sigma, confidence) {
    let z = _norm_ppf_std(confidence);
    let phi = num_exp(0 - 0.5 * z * z) / _S2PI;
    return 0 - mu + sigma * phi / (1 - confidence);
}

// ── Special functions: incomplete gamma & beta (Numerical Recipes) ────────────
// log-gamma (Lanczos log form, valid for x > 0) — avoids gamma() overflow.
fn _gammln(xx) {
    let cof = [76.18009172947146, -86.50532032941677, 24.01409824083091,
               -1.231739572450155, 0.001208650973866179, -0.000005395239384953];
    let x = xx;
    let y = xx;
    let tmp = x + 5.5;
    tmp = tmp - (x + 0.5) * num_ln(tmp);
    let ser = 1.000000000190015;
    let j = 0;
    while j < 6 { y = y + 1; ser = ser + cof[j] / y; j = j + 1; }
    return 0 - tmp + num_ln(2.5066282746310005 * ser / x);
}

// series form of P(s,x), accurate for x < s+1
fn _gser(s, x) {
    if x <= 0 { return 0; }
    let ap = s;
    let sum = 1 / s;
    let del = sum;
    let n = 1;
    while n <= 300 {
        ap = ap + 1;
        del = del * x / ap;
        sum = sum + del;
        let ad = del; if ad < 0 { ad = 0 - ad; }
        let asum = sum; if asum < 0 { asum = 0 - asum; }
        if ad < asum * 0.0000000001 { n = 301; } else { n = n + 1; }
    }
    return sum * num_exp(0 - x + s * num_ln(x) - _gammln(s));
}

// continued-fraction form of Q(s,x)=1-P(s,x), accurate for x >= s+1 (Lentz)
fn _gcf(s, x) {
    let fpmin = 0.0000000000000000000000000000001;
    let b = x + 1 - s;
    let c = 1 / fpmin;
    let d = 1 / b;
    let h = d;
    let i = 1;
    while i <= 300 {
        let an = 0 - i * (i - s);
        b = b + 2;
        d = an * d + b; let ad = d; if ad < 0 { ad = 0 - ad; }
        if ad < fpmin { d = fpmin; }
        c = b + an / c; let ac = c; if ac < 0 { ac = 0 - ac; }
        if ac < fpmin { c = fpmin; }
        d = 1 / d;
        let del = d * c;
        h = h * del;
        let dm = del - 1; if dm < 0 { dm = 0 - dm; }
        if dm < 0.0000000001 { i = 301; } else { i = i + 1; }
    }
    return num_exp(0 - x + s * num_ln(x) - _gammln(s)) * h;
}

// regularized lower incomplete gamma P(s,x)
fn gamma_inc_p(s, x) {
    if x <= 0 { return 0; }
    if x < s + 1 { return _gser(s, x); }
    return 1 - _gcf(s, x);
}

// chi-square CDF with k degrees of freedom
fn chi2_cdf(x, k) {
    if x <= 0 { return 0; }
    return gamma_inc_p(k / 2, x / 2);
}

// continued fraction for the incomplete beta (Lentz)
fn _betacf(a, b, x) {
    let fpmin = 0.0000000000000000000000000000001;
    let qab = a + b;
    let qap = a + 1;
    let qam = a - 1;
    let c = 1;
    let d = 1 - qab * x / qap;
    let ad = d; if ad < 0 { ad = 0 - ad; }
    if ad < fpmin { d = fpmin; }
    d = 1 / d;
    let h = d;
    let m = 1;
    while m <= 300 {
        let m2 = 2 * m;
        let aa = m * (b - m) * x / ((qam + m2) * (a + m2));
        d = 1 + aa * d; let a1 = d; if a1 < 0 { a1 = 0 - a1; } if a1 < fpmin { d = fpmin; }
        c = 1 + aa / c; let a2 = c; if a2 < 0 { a2 = 0 - a2; } if a2 < fpmin { c = fpmin; }
        d = 1 / d;
        h = h * d * c;
        aa = 0 - (a + m) * (qab + m) * x / ((a + m2) * (qap + m2));
        d = 1 + aa * d; let a3 = d; if a3 < 0 { a3 = 0 - a3; } if a3 < fpmin { d = fpmin; }
        c = 1 + aa / c; let a4 = c; if a4 < 0 { a4 = 0 - a4; } if a4 < fpmin { c = fpmin; }
        d = 1 / d;
        let del = d * c;
        h = h * del;
        let dm = del - 1; if dm < 0 { dm = 0 - dm; }
        if dm < 0.0000000001 { m = 301; } else { m = m + 1; }
    }
    return h;
}

// regularized incomplete beta I_x(a,b)
fn beta_inc(x, a, b) {
    if x <= 0 { return 0; }
    if x >= 1 { return 1; }
    let bt = num_exp(_gammln(a + b) - _gammln(a) - _gammln(b)
                     + a * num_ln(x) + b * num_ln(1 - x));
    if x < (a + 1) / (a + b + 2) {
        return bt * _betacf(a, b, x) / a;
    }
    return 1 - bt * _betacf(b, a, 1 - x) / b;
}

// Student's t CDF with df degrees of freedom
fn t_cdf(t, df) {
    let x = df / (df + t * t);
    let ib = beta_inc(x, df / 2, 0.5);
    if t >= 0 { return 1 - 0.5 * ib; }
    return 0.5 * ib;
}

// ── Shannon entropy (in bits) of a probability vector ─────────────────────────
fn entropy(probs) {
    let h = 0;
    let i = 0;
    while i < len(probs) {
        let p = probs[i];
        if p > 0 { h = h - p * (num_ln(p) / _LN2); }
        i = i + 1;
    }
    return h;
}

export factorial, perm, comb, gamma, erf,
       normal_pdf, normal_cdf, binomial_pmf, binomial_cdf,
       poisson_pmf, poisson_cdf, uniform_pdf, uniform_cdf,
       exp_pdf, exp_cdf, normal_ppf, exp_ppf, uniform_ppf,
       value_at_risk, conditional_value_at_risk,
       gamma_inc_p, chi2_cdf, beta_inc, t_cdf, entropy;
