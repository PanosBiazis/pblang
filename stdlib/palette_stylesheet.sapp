// Deterministic opaque-color tokens. User labels/title never become CSS syntax.
let P=import("stdlib:palette_document.sapp");let C=import("stdlib:colors.sapp");
let MAX_CSS_BYTES=1024;
fn tokens(doc) {
 P.validate(doc);
 let out=[map{name:"--pb-background",value:doc.background},map{name:"--pb-on-background",value:C.best_text_checked(C.hex_checked(doc.background)).hex}];
 for i in range(0,len(doc.swatches)) {
  let hex=doc.swatches[i].hex;let suffix=str(i+1);
  array_push(out,map{name:"--pb-color-"+suffix,value:hex});
  array_push(out,map{name:"--pb-on-color-"+suffix,value:C.best_text_checked(C.hex_checked(hex)).hex});
 }
 return out;
}
fn encode(doc) {
 let lines=[":root {"];
 for item in tokens(doc) {array_push(lines,"  "+item.name+": "+item.value+";");}
 array_push(lines,"}");let css=str_join(lines,"\n")+"\n";
 if len(str_to_bytes(css))>MAX_CSS_BYTES {throw "palette stylesheet limit exceeded";}
 return css;
}
export MAX_CSS_BYTES,tokens,encode;
