// stdlib/docgen_cli.sapp — PBLang v3.0.0 Markdown Documentation Generator & Code Formatter CLI
//
// Features:
//   - `generate_markdown_docs(src_or_path, opts = nil)`:
//       Extracts module headers, `///` & `//` doc comments, function signatures,
//       9D `: num[SI]` / `: num[EUR]` dimensional types, `struct`/`class`/`enum` definitions,
//       and `requires`/`ensures` mathematical contracts (including live Tarski CAD /
//       Cooper-Presburger compile-time proof certificates!) into clean Markdown documentation.
//   - `format_source(src, max_line_length = nil)`:
//       Canonical PBLang v3.0.0 formatter built on `stdlib:compiler/formatter.sapp` with
//       token preservation for `->`, `=>`, `::`, and compact `num[SI]` unit brackets.
//   - `cli_fmt_entry(args)` & `cli_doc_entry(args)` CLI entrypoints.
//
// Compatible with PBLang 2.7.0 and 3.0.0 runtimes.

let SC = import("stdlib:static_checker.sapp");
let FMT = import("stdlib:compiler/formatter.sapp");

let DOCGEN_VERSION = "3.0.0";

// ── Formatter Integration (`pblang fmt`) ──────────────────────────────────────

fn _dg_char_at(s, idx) {
    if s == nil or idx < 0 or idx >= len(s) { return ""; }
    return str_slice(s, idx, idx + 1);
}

fn _polish_formatted_v3_line(line) {
    let n = len(line);
    let out = "";
    let i = 0;
    let in_str = false;
    let q = "";
    let unit_brk = 0;

    while i < n {
        let ch = _dg_char_at(line, i);
        if in_str {
            out = out + ch;
            if ch == "\\" and i + 1 < n {
                out = out + _dg_char_at(line, i + 1);
                i = i + 2;
            } else {
                if ch == q { in_str = false; }
                i = i + 1;
            }
        } else {
            if ch == "/" and _dg_char_at(line, i + 1) == "/" {
                out = out + str_slice(line, i, n);
                return out;
            }
            if ch == "\"" or ch == "'" {
                in_str = true;
                q = ch;
                out = out + ch;
                i = i + 1;
            } elif str_slice(line, i, i + 3) == "- >" {
                out = out + "->";
                i = i + 3;
            } elif str_slice(line, i, i + 3) == "= >" {
                out = out + "=>";
                i = i + 3;
            } elif str_slice(line, i, i + 3) == ": :" {
                out = out + "::";
                i = i + 3;
            } elif str_slice(line, i, i + 4) == "num[" or str_slice(line, i, i + 4) == "int[" {
                unit_brk = 1;
                out = out + str_slice(line, i, i + 4);
                i = i + 4;
            } elif unit_brk > 0 {
                if ch == "[" {
                    unit_brk = unit_brk + 1;
                    out = out + ch;
                } elif ch == "]" {
                    unit_brk = unit_brk - 1;
                    out = out + ch;
                } elif ch != " " {
                    out = out + ch;
                }
                i = i + 1;
            } else {
                out = out + ch;
                i = i + 1;
            }
        }
    }
    return out;
}

fn format_source(src, max_line_length = nil) {
    if src == nil { return ""; }
    let base = FMT.format_source(src, max_line_length);
    let raw_lines = str_split(base, "\n");
    let polished = [];
    let i = 0;
    while i < len(raw_lines) {
        push(polished, _polish_formatted_v3_line(raw_lines[i]));
        i = i + 1;
    }
    return str_join(polished, "\n");
}

// ── AST Pretty-Printing Helpers for Signatures & Contracts ────────────────────

fn _annot_to_doc_str(annot) {
    if annot == nil { return ""; }
    let raw = annot["raw"];
    if annot["unit_raw"] != "" {
        return raw + "[" + annot["unit_raw"] + "]";
    }
    if annot["args"] != nil and len(annot["args"]) > 0 {
        let parts = [];
        let i = 0;
        while i < len(annot["args"]) {
            push(parts, _annot_to_doc_str(annot["args"][i]));
            i = i + 1;
        }
        return raw + "<" + str_join(parts, ", ") + ">";
    }
    return raw;
}

fn _expr_to_doc_str(node) {
    if node == nil { return ""; }
    let k = node["kind"];
    if k == "num" { return node["val"]; }
    if k == "str" { return "\"" + node["val"] + "\""; }
    if k == "bool" { return if node["val"] { "true" } else { "false" }; }
    if k == "nil" { return "nil"; }
    if k == "ident" { return node["name"]; }
    if k == "unary" {
        if node["op"] == "not" { return "not " + _expr_to_doc_str(node["arg"]); }
        return node["op"] + _expr_to_doc_str(node["arg"]);
    }
    if k == "binary" {
        return _expr_to_doc_str(node["left"]) + " " + node["op"] + " " + _expr_to_doc_str(node["right"]);
    }
    if k == "call" {
        let args = [];
        let i = 0;
        while i < len(node["args"]) {
            push(args, _expr_to_doc_str(node["args"][i]));
            i = i + 1;
        }
        return _expr_to_doc_str(node["callee"]) + "(" + str_join(args, ", ") + ")";
    }
    if k == "array_lit" {
        let items = [];
        let i = 0;
        while i < len(node["items"]) {
            push(items, _expr_to_doc_str(node["items"][i]));
            i = i + 1;
        }
        return "[" + str_join(items, ", ") + "]";
    }
    if k == "member" {
        return _expr_to_doc_str(node["obj"]) + "." + node["field"];
    }
    if k == "index" {
        return _expr_to_doc_str(node["obj"]) + "[" + _expr_to_doc_str(node["index"]) + "]";
    }
    return "...";
}

fn _extract_module_header_doc(src_lines) {
    let header = [];
    let i = 0;
    while i < len(src_lines) {
        let ln = str_trim(src_lines[i]);
        if ln == "" {
            if len(header) > 0 { break; }
            i = i + 1;
            continue;
        }
        if str_starts_with(ln, "//!") {
            push(header, str_trim(str_slice(ln, 3, len(ln))));
        } elif str_starts_with(ln, "///") {
            // Only treat top `///` as module doc if followed by a blank line before declarations
            let next_ln = if i + 1 < len(src_lines) { str_trim(src_lines[i + 1]) } else { "" };
            if next_ln == "" or str_starts_with(next_ln, "///") {
                push(header, str_trim(str_slice(ln, 3, len(ln))));
                if next_ln == "" { break; }
            } else {
                break;
            }
        } elif str_starts_with(ln, "//") {
            push(header, str_trim(str_slice(ln, 2, len(ln))));
        } else {
            break;
        }
        i = i + 1;
    }
    return str_join(header, "\n");
}

fn _find_fn_contracts(contracts, fn_name) {
    let out = [];
    let i = 0;
    while i < len(contracts) {
        if contracts[i]["fn_name"] == fn_name {
            push(out, contracts[i]);
        }
        i = i + 1;
    }
    return out;
}

fn _find_symbol_info(symbols, name) {
    let i = 0;
    while i < len(symbols) {
        if symbols[i]["name"] == name { return symbols[i]; }
        i = i + 1;
    }
    return nil;
}

// ── Markdown Documentation Generator (`generate_markdown_docs`) ───────────────

fn generate_markdown_docs(src_or_path, opts = nil) {
    let raw_in = if src_or_path != nil { str(src_or_path) } else { "" };
    let title = "PBLang Module Reference";
    let src_code = raw_in;

    if not str_contains(raw_in, "\n") and raw_in != "" and fs_exists(raw_in) {
        title = path_basename(raw_in);
        src_code = fs_read(raw_in);
    } elif opts != nil and type(opts) == "map" and map_has(opts, "title") {
        title = str(opts["title"]);
    }

    let rep = SC.check_source(src_code, map{ strict: false });
    let src_lines = str_split(src_code, "\n");
    let mod_doc = _extract_module_header_doc(src_lines);

    let ast = rep["ast"];
    let stmts = if ast != nil { ast["stmts"] } else { [] };

    let fn_nodes = [];
    let type_nodes = [];
    let var_nodes = [];

    let i = 0;
    while i < len(stmts) {
        let s = stmts[i];
        let sk = s["kind"];
        if sk == "fn_decl" { push(fn_nodes, s); }
        elif sk == "struct_decl" or sk == "class_decl" or sk == "enum_decl" { push(type_nodes, s); }
        elif sk == "var_decl" {
            // Document exported or annotated or const top-level bindings (skip private `_` helpers)
            if not str_starts_with(s["name"], "_") {
                push(var_nodes, s);
            }
        }
        i = i + 1;
    }

    let md = [];
    push(md, "# " + title);
    push(md, "");
    if mod_doc != "" {
        push(md, mod_doc);
        push(md, "");
    }

    // Exported symbols badge line
    if len(rep["exports"]) > 0 {
        push(md, "**Exports:** `" + str_join(rep["exports"], "`, `") + "`");
        push(md, "");
    }

    // Table of Contents
    push(md, "## Contents");
    push(md, "");
    if len(fn_nodes) > 0 { push(md, "- [Functions](#functions) (" + str(len(fn_nodes)) + ")"); }
    if len(type_nodes) > 0 { push(md, "- [Types, Structs & Enums](#types-structs--enums) (" + str(len(type_nodes)) + ")"); }
    if len(var_nodes) > 0 { push(md, "- [Constants & Unit Bindings](#constants--unit-bindings) (" + str(len(var_nodes)) + ")"); }
    push(md, "");

    // 1. Functions Section
    if len(fn_nodes) > 0 {
        push(md, "## Functions");
        push(md, "");
        let fi = 0;
        while fi < len(fn_nodes) {
            let fn_d = fn_nodes[fi];
            let fn_nm = fn_d["name"];
            let p_strs = [];
            let unit_rows = [];

            let pi = 0;
            while pi < len(fn_d["params"]) {
                let p = fn_d["params"][pi];
                let ps = (if p["is_rest"] { "..." } else { "" }) + p["name"];
                if p["annot"] != nil {
                    let astr = _annot_to_doc_str(p["annot"]);
                    ps = ps + ": " + astr;
                    if p["annot"]["unit_raw"] != "" {
                        push(unit_rows, "- Parameter `" + p["name"] + "`: `" + astr + "`");
                    }
                }
                if p["default_expr"] != nil {
                    ps = ps + " = " + _expr_to_doc_str(p["default_expr"]);
                }
                push(p_strs, ps);
                pi = pi + 1;
            }

            let ret_s = "";
            if fn_d["ret_annot"] != nil {
                let r_astr = _annot_to_doc_str(fn_d["ret_annot"]);
                ret_s = " -> " + r_astr;
                if fn_d["ret_annot"]["unit_raw"] != "" {
                    let sym_fn = _find_symbol_info(rep["symbols"], fn_nm);
                    let dim_extra = "";
                    if sym_fn != nil and map_has(sym_fn, "has_unit") and sym_fn["has_unit"] == true {
                        dim_extra = " (`" + sym_fn["dim_unicode"] + "` — " + str(sym_fn["named_quantity"]) + ")";
                    }
                    push(unit_rows, "- Return quantity: `" + r_astr + "`" + dim_extra);
                }
            }

            push(md, "### `" + fn_nm + "`");
            push(md, "");
            push(md, "```pblang");
            let sig_line = "fn " + fn_nm + "(" + str_join(p_strs, ", ") + ")" + ret_s;
            push(md, sig_line);
            let ri = 0;
            while ri < len(fn_d["requires_list"]) {
                push(md, "  requires " + _expr_to_doc_str(fn_d["requires_list"][ri]["expr"]));
                ri = ri + 1;
            }
            let ei = 0;
            while ei < len(fn_d["ensures_list"]) {
                push(md, "  ensures " + _expr_to_doc_str(fn_d["ensures_list"][ei]["expr"]));
                ei = ei + 1;
            }
            push(md, "```");
            push(md, "");

            if fn_d["doc"] != nil and str_trim(fn_d["doc"]) != "" {
                push(md, str_trim(fn_d["doc"]));
                push(md, "");
            }

            if len(unit_rows) > 0 {
                push(md, "**SI / Currency Dimensional Signature:**");
                let ui = 0;
                while ui < len(unit_rows) {
                    push(md, unit_rows[ui]);
                    ui = ui + 1;
                }
                push(md, "");
            }

            let f_contracts = _find_fn_contracts(rep["contracts"], fn_nm);
            if len(f_contracts) > 0 {
                push(md, "**Mathematical Contract Verification:**");
                let ci = 0;
                while ci < len(f_contracts) {
                    let c = f_contracts[ci];
                    if c["proved"] {
                        push(md, "- `✓ " + c["status"] + "` via **" + c["engine"] + "** (`" + c["kind"] + "`: `" + c["formula"] + "`)");
                    } else {
                        let w = if c["witness_summary"] != "" { " — counterexample: `" + c["witness_summary"] + "`" } else { "" };
                        push(md, "- `✗ " + c["status"] + "` via **" + c["engine"] + "** (`" + c["kind"] + "`)" + w);
                    }
                    ci = ci + 1;
                }
                push(md, "");
            }

            fi = fi + 1;
        }
    }

    // 2. Types, Structs & Enums Section
    if len(type_nodes) > 0 {
        push(md, "## Types, Structs & Enums");
        push(md, "");
        let ti = 0;
        while ti < len(type_nodes) {
            let td = type_nodes[ti];
            let tk = td["kind"];
            push(md, "### `" + td["name"] + "`");
            push(md, "");
            if td["doc"] != nil and str_trim(td["doc"]) != "" {
                push(md, str_trim(td["doc"]));
                push(md, "");
            }
            if tk == "struct_decl" {
                push(md, "**Struct Fields:**");
                let fli = 0;
                while fli < len(td["fields"]) {
                    let f = td["fields"][fli];
                    let ft_s = if f["annot"] != nil { ": `" + _annot_to_doc_str(f["annot"]) + "`" } else { "" };
                    push(md, "- `" + f["name"] + "`" + ft_s);
                    fli = fli + 1;
                }
                push(md, "");
            } elif tk == "enum_decl" {
                push(md, "**Enum Variants:** `" + str_join(td["variants"], "`, `") + "`");
                push(md, "");
            }
            ti = ti + 1;
        }
    }

    // 3. Constants & Unit Bindings Section
    if len(var_nodes) > 0 {
        push(md, "## Constants & Unit Bindings");
        push(md, "");
        push(md, "| Symbol | Mutability | Inferred Type / SI Unit | Dimension | Description |");
        push(md, "| :--- | :--- | :--- | :--- | :--- |");
        let vi = 0;
        while vi < len(var_nodes) {
            let vd = var_nodes[vi];
            let vnm = vd["name"];
            let sym_v = _find_symbol_info(rep["symbols"], vnm);
            let mut_s = if vd["is_const"] { "`const`" } else { "`let`" };
            let t_s = if sym_v != nil { "`" + sym_v["type_str"] + "`" } else { "`any`" };
            let dim_s = "—";
            if map_has(rep["units_inferred"], vnm) {
                let ui = rep["units_inferred"][vnm];
                dim_s = "`" + ui["dim_unicode"] + "`";
            }
            let d_s = if vd["doc"] != nil and str_trim(vd["doc"]) != "" {
                str_replace_all(str_trim(vd["doc"]), "\n", " ")
            } else {
                "—"
            };
            push(md, "| `" + vnm + "` | " + mut_s + " | " + t_s + " | " + dim_s + " | " + d_s + " |");
            vi = vi + 1;
        }
        push(md, "");
    }

    return str_join(md, "\n");
}

// ── CLI Entrypoints (`pblang fmt` & `pblang doc`) ─────────────────────────────

fn cli_fmt_entry(cli_args = nil) {
    let raw_args = if cli_args != nil { cli_args } else { os_args() };
    let check_only = false;
    let write_inplace = false;
    let max_len = nil;
    let no_exit = false;
    let files = [];

    let i = 0;
    while i < len(raw_args) {
        let a = raw_args[i];
        if a == "--check" { check_only = true; }
        elif a == "--write" or a == "-w" { write_inplace = true; }
        elif a == "--no-exit" { no_exit = true; }
        elif a == "--max-line-length" and i + 1 < len(raw_args) {
            max_len = parse_number(raw_args[i + 1]);
            i = i + 2;
            continue;
        } elif a != "fmt" and a != "--fmt" and not str_ends_with(a, "docgen_cli.sapp") and not str_ends_with(a, "pblang") {
            push(files, a);
        }
        i = i + 1;
    }

    let unformatted = [];
    let fi = 0;
    while fi < len(files) {
        let p = files[fi];
        let orig = fs_read(p);
        let formatted = format_source(orig, max_len);
        if check_only {
            if formatted != orig {
                push(unformatted, p);
                println("Needs formatting: " + p);
            }
        } elif write_inplace {
            if formatted != orig {
                fs_write(p, formatted);
            }
        } else {
            print formatted;
        }
        fi = fi + 1;
    }

    if check_only and len(unformatted) > 0 and not no_exit {
        os_exit(1);
    }
    return map{
        ok: len(unformatted) == 0,
        unformatted: unformatted
    };
}

fn cli_doc_entry(cli_args = nil) {
    let raw_args = if cli_args != nil { cli_args } else { os_args() };
    let out_file = "";
    let files = [];

    let i = 0;
    while i < len(raw_args) {
        let a = raw_args[i];
        if (a == "-o" or a == "--output") and i + 1 < len(raw_args) {
            out_file = raw_args[i + 1];
            i = i + 2;
            continue;
        } elif a != "doc" and a != "--doc" and not str_ends_with(a, "docgen_cli.sapp") and not str_ends_with(a, "pblang") {
            push(files, a);
        }
        i = i + 1;
    }

    let docs = [];
    let fi = 0;
    while fi < len(files) {
        push(docs, generate_markdown_docs(files[fi]));
        fi = fi + 1;
    }
    let full_md = str_join(docs, "\n\n---\n\n");
    if out_file != "" {
        fs_write(out_file, full_md);
        println("Generated Markdown documentation: " + out_file);
    } else {
        println(full_md);
    }
    return map{ ok: true, markdown: full_md };
}

export DOCGEN_VERSION,
       format_source,
       generate_markdown_docs,
       cli_fmt_entry,
       cli_doc_entry;
