// Explicit one-based UI/CLI columns, converted to the shared zero-based model.
// One digit per column, optional surrounding ASCII/Unicode whitespace; no ranges.
fn parse(text) {
    if type(text)!="string" or len(text)<1 or len(text)>64 or len(str_to_bytes(text))>64 {
        throw "choose 1-8 comma-separated column numbers";
    }
    let items=str_split(text,",");
    if len(items)<1 or len(items)>8 { throw "choose 1-8 columns"; }
    let columns=[]; let seen=map{};
    for item in items {
        let token=str_trim(item);
        if len(token)!=1 or not str_contains("12345678",token) or map_has(seen,token) {
            throw "columns must be distinct numbers from 1 to 8";
        }
        seen[token]=true; array_push(columns,parse_number(token)-1);
    }
    return columns;
}
export parse;
