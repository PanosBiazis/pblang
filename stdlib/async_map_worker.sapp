// Internal data-only mapping boundary: workers capture the mapper and channels,
// never the complete input. Keep this module free of imports/application globals.
fn _queue(sender, items) {
    for i len(items) {
        let value = items[i];
        // Channels use JSON, unlike spawn captures. Non-finite numbers become
        // nil and exact numerics become strings. Fall back before mapper effects
        // if this route would change any input value. The native round trip is
        // depth-bounded and rejects functions/cycles before recursive equality.
        if json_parse(json_stringify(value)) != value { return false; }
        send(sender, map{idx:i, value:value});
    }
    return true;
}

fn _launch(work, results, mapper) {
    return spawn(fn() {
        while true {
            let job = recv(work.receiver);
            if job == nil { return nil; }
            let value = try mapper(job.value) catch nil;
            send(results.sender, map{idx:job.idx, value:value});
        }
    });
}

fn run(size, items, mapper) {
    let n = len(items);
    if not is_number(size) { throw "async.map_parallel: invalid internal size"; }
    if size - size != 0 or size < 1 or size > n or size != num_floor(size) {
        throw "async.map_parallel: invalid internal size";
    }
    let work = channel_buffered(n);
    let queued = try _queue(work.sender, items) catch false;
    channel_close(work.sender);
    if not queued {
        // No mapper has run. Spawn supports more capture types than channels;
        // drain before the caller tries its compatible capture-based backend.
        while recv_timeout(work.receiver, 0) != nil {}
        return map{supported:false};
    }
    let results = try channel_buffered(n) catch nil;
    if results == nil {
        while recv_timeout(work.receiver, 0) != nil {}
        throw "async.map_parallel: result channel unavailable";
    }
    let workers = [];
    let started = true;
    for i size {
        let worker = try _launch(work, results, mapper) catch nil;
        if worker == nil { started = false; break; }
        array_push(workers, worker);
    }
    let joined = true;
    for worker in workers {
        let done = try {join(worker); true} catch false;
        if not done { joined = false; }
    }
    channel_close(results.sender);
    if not started or not joined {
        while recv_timeout(work.receiver, 0) != nil {}
        while recv_timeout(results.receiver, 0) != nil {}
        if not started { throw "async.map_parallel: worker could not start"; }
        throw "async.map_parallel: worker failed";
    }
    let out = [];
    for i n { out[i] = nil; }
    for i n {
        let result = recv_timeout(results.receiver, 0);
        if result == nil { throw "async.map_parallel: missing worker result"; }
        out[result.idx] = result.value;
    }
    return map{supported:true, values:out};
}
export run;
