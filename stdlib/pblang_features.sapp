// stdlib/pblang_features.sapp — pblang's self-describing capability matrix.
//
// A factual catalog of what pblang can do, grouped by category, with a per-feature status
// ("yes" / "partial" / "roadmap") and the module that provides it. Plus a scorecard, a
// comparison framing against how mainstream languages typically work, and — importantly —
// HONEST caveats about where pblang is NOT ahead. This is data for judgement, not a boast:
// "best language" is earned with users over time; this just makes the capabilities legible.
//
//   let f = import("stdlib/pblang_features.sapp");
//   f.categories();  f.features("Native codegen");  f.scorecard();  f.compare();  f.caveats();

fn _f(name, status, module) { return map{ name: name, status: status, module: module }; }

let _MATRIX = map{
    "Native codegen": [
        _f("x86-64 machine code + ELF (runs)", "yes", "codegen_x64"),
        _f("i386 / older x86 + ELF32 (runs)", "yes", "codegen_x86"),
        _f("arm64 / AArch64 machine code", "yes", "codegen_arm64"),
        _f("arithmetic, loops, conditionals", "yes", "codegen_*"),
        _f("functions, recursion (call/ret)", "yes", "codegen_x64/x86/arm64"),
        _f("raw syscalls (device/ioctl/mmap)", "yes", "codegen syscall op"),
        _f("cross-OS containers ELF/Mach-O/PE", "yes", "codegen_cross"),
        _f("runnable Windows PE w/ imports", "yes", "codegen_cross.pe64_print"),
        _f("portable C + OpenQASM backends", "yes", "codegen_ir/codegen_qasm"),
        _f("expression front end -> native", "partial", "native_lang"),
        _f("variables / spill-to-stack", "roadmap", "native_lang")
    ],
    "Memory & safety": [
        _f("ownership / borrow / lifetimes", "yes", "memory_safety"),
        _f("validated codegen (reject bad IR)", "yes", "codegen_ir.validate"),
        _f("secret scrub / constant-time eq", "yes", "harden"),
        _f("bounds / assertions / freeze", "yes", "safety"),
        _f("GC runtime (no manual free)", "yes", "VM")
    ],
    "Concurrency": [
        _f("spawn / par_map multi-core", "yes", "parallel"),
        _f("async / await", "yes", "async_await"),
        _f("channels / waitgroup / signals", "yes", "channel/event/signal"),
        _f("heterogeneous scheduler", "yes", "compute")
    ],
    "AI / ML": [
        _f("neural nets + training", "yes", "nn"),
        _f("transformers / attention", "yes", "llm_transformer/llm_attention"),
        _f("graph NN, evolution, curiosity", "yes", "nn_graph/nn_evolve"),
        _f("native AI assistant (pbAI)", "yes", "pbai"),
        _f("GPU tensor matmul (opt-in)", "yes", "vm gpu / PBLANG_GPU")
    ],
    "Quantum": [
        _f("state-vector simulator", "yes", "quantum_sim"),
        _f("gate IR -> OpenQASM", "yes", "codegen_qasm"),
        _f("protocols (BB84) / viz", "yes", "quantum_protocol/quantum_viz")
    ],
    "Devices / HAL": [
        _f("devfs/sysfs access (Linux drivers)", "yes", "device"),
        _f("HAL: device catalog + verbs", "yes", "hal"),
        _f("ioctl/mmap via generated syscalls", "yes", "codegen + hal"),
        _f("hardware detection (CPU/GPU/NPU)", "yes", "watch")
    ],
    "Observability": [
        _f("watchers (cpu/gpu/heap/hardware)", "yes", "watch"),
        _f("native process metrics + trace", "yes", "native_studio"),
        _f("profiler / benchmark", "yes", "profiler/benchmark"),
        _f("smart diagnostics + autofix", "yes", "diagnostics")
    ],
    "Graphics / UI": [
        _f("software renderer (all cores)", "yes", "render_soft"),
        _f("dirty-rect + frame governor", "yes", "render_cache"),
        _f("native window (minifb/sdl2)", "yes", "graphics"),
        _f("ui kit / theme / layout", "yes", "ui_kit/theme/layout"),
        _f("one declarative CLI / GUI / web / full-stack entry", "yes", "app")
    ],
    "Language core": [
        _f("maps, closures, match, enum", "yes", "VM"),
        _f("struct / class / OOP", "yes", "VM"),
        _f("operator overloading (dunder)", "yes", "VM"),
        _f("typeclasses / traits", "yes", "typeclass"),
        _f("logic / datalog, reactive streams", "yes", "logic/observable"),
        _f("bigint / rational / decimal", "yes", "VM")
    ],
    "Self-hosting & build": [
        _f("self-hosted compiler (.sapp)", "yes", "compiler/*"),
        _f("pblang -> C transpiler", "yes", "compiler/ctranspile"),
        _f("Cranelift JIT (opt-in)", "yes", "PBLANG_JIT"),
        _f("cross-OS distribution", "partial", "dist")
    ],
    "Crypto / Security": [
        _f("sha256/hmac/chacha20 AEAD", "yes", "crypto/securelayer"),
        _f("jwt / tls helpers", "yes", "security/jwt"),
        _f("tamper detection / integrity", "yes", "harden")
    ],
    "Tooling": [
        _f("native IDE", "yes", "editors/ide/pbide"),
        _f("MCP bridge / agent tools", "yes", "pb_mcp"),
        _f("package manifest / registry", "partial", "registry")
    ]
};

fn categories() { return map_keys(_MATRIX); }
fn features(cat) { if not map_has(_MATRIX, cat) { throw "pblang_features: unknown category '" + cat + "'"; } return _MATRIX[cat]; }

// scorecard() — totals across the matrix.
fn scorecard() {
    let cats = map_keys(_MATRIX);
    let total = 0; let yes = 0; let partial = 0; let roadmap = 0;
    let per = [];
    let i = 0;
    while i < len(cats) {
        let fs = _MATRIX[cats[i]];
        let cy = 0;
        let j = 0;
        while j < len(fs) {
            total = total + 1;
            if fs[j].status == "yes" { yes = yes + 1; cy = cy + 1; }
            else if fs[j].status == "partial" { partial = partial + 1; }
            else { roadmap = roadmap + 1; }
            j = j + 1;
        }
        array_push(per, map{ category: cats[i], count: len(fs), implemented: cy });
        i = i + 1;
    }
    return map{ categories: len(cats), total_features: total, implemented: yes, partial: partial, roadmap: roadmap, per_category: per };
}

// compare() — how pblang's approach differs from mainstream languages (factual framing).
fn compare() {
    return [
        map{ axis: "Native codegen written IN the language itself", pblang: "yes — codegen_x64/x86/arm64 emit machine code with no Rust/LLVM in the path", typical: "most languages depend on LLVM/GCC C/C++/Rust toolchains" },
        map{ axis: "One language: bytecode VM AND native AND transpile-to-C", pblang: "yes — run on the VM, JIT, emit native, or lower to C", typical: "usually pick one: interpreted OR compiled" },
        map{ axis: "Batteries: AI/NN + quantum + HAL + graphics in stdlib", pblang: "yes — first-class stdlib modules", typical: "external libraries / SDKs" },
        map{ axis: "Memory safety", pblang: "GC + runtime ownership module + validated codegen", typical: "Rust enforces at compile time; C/C++ manual; GC langs runtime" },
        map{ axis: "Cross-platform output ELF/Mach-O/PE from one host", pblang: "yes — codegen_cross", typical: "needs per-OS toolchains / cross-compilers" },
        map{ axis: "Self-describing capabilities + observability", pblang: "yes — this matrix + watchers + native metrics", typical: "rare as a built-in" }
    ];
}

// caveats() — HONEST: where pblang is NOT ahead today. Truth matters more than a boast.
fn caveats() {
    return [
        "Ecosystem & package registry are tiny vs npm/pip/crates — fewer ready libraries.",
        "The optimizing compiler is shallow (constant-fold + peephole); LLVM/GCC produce far faster code.",
        "Native codegen covers an integer IR; floats, full types, and a complete front end are WIP.",
        "macOS/Windows binaries are format-verified, not executed here (codesign / full runtime needed).",
        "GPU/NPU EXECUTION still needs native device kernels/FFI — not pure pblang.",
        "Maturity, tooling depth, and community are years behind mainstream languages."
    ];
}

export categories, features, scorecard, compare, caveats;
