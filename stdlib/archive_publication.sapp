// Explicit ZIP publication. The pure secure_archive facade retains zero effects.
let Archive = import("stdlib:secure_archive.sapp");
let Dir = import("stdlib:linux_dirfs.sapp");

fn rejected(code, message, format = "pblang.archive-publication.v1") {
    return map{ok:false, format:format, code:code, error:message,
        written:false, publication_attempted:false, publication_confirmed:false,
        output_may_exist:false, partial_output_possible:false, durability_verified:false,
        wrapper_handles_closed:true, metadata_only:true, safe_to_log:false};
}
fn _root(parent) {
    if str_starts_with(parent,"/") { return Dir.open_absolute(parent,false,false); }
    return Dir.open(parent,false,false);
}
fn save(path, bytes, options = nil) {
    if type(path)!="string" or len(path)<1 or len(path)>4096
        or len(str_to_bytes(path))>4096 or str_contains(path,strfromcharcode(0))
        or str_contains(path,"\\") or not str_ends_with(str_lower(path),".zip") {
        return rejected("invalid_output","Choose a new .zip path in an existing folder.");
    }
    if type(bytes)!="array" or len(bytes)>4194304 {
        return rejected("invalid_archive","Archive bytes exceed the supported ZIP contract.");
    }
    // Own a byte snapshot; verify every member before acquiring filesystem handles.
    let snapshot = slice(bytes,0,len(bytes));
    let verified = try Archive.inspect(snapshot,options) catch nil;
    if verified==nil {
        return rejected("invalid_archive","Archive bytes or limits failed ZIP verification.");
    }
    return _publish(path,snapshot,"pblang.archive-publication.v1");
}
// Archive names are selectors only. The caller chooses a separate literal path.
fn extract_member(path, bytes, name, options = nil) {
    let format="pblang.archive-extraction.v1";
    if type(path)!="string" or len(path)<1 or len(path)>4096
        or len(str_to_bytes(path))>4096 or str_contains(path,strfromcharcode(0))
        or str_contains(path,"\\") or str_ends_with(path,"/") {
        return rejected("invalid_output","Choose a new file path in an existing folder.",format);
    }
    if type(bytes)!="array" or len(bytes)>4194304 {
        return rejected("invalid_archive","Archive bytes exceed the supported ZIP contract.",format);
    }
    let snapshot=slice(bytes,0,len(bytes));
    let selected=try Archive.read_member(snapshot,name,options) catch nil;
    if selected==nil {
        return rejected("invalid_selection","Archive, limits or exact member selection failed verification.",format);
    }
    if selected.directory or (selected.size==0 and selected.method!=0) {
        return rejected("unsupported_member","Select a regular file; empty members require ZIP STORE and directories are not supported.",format);
    }
    return _publish(path,selected.data,format);
}
// Private common effect boundary: only fully verified owned bytes reach here.
fn _publish(path, snapshot, format) {
    if platform()!="linux" {
        return rejected("publication_unavailable","File publication requires Linux and a supported filesystem.",format);
    }
    let parent=path_dirname(path); if parent=="" { parent="."; }
    let fs = try _root(parent) catch nil;
    if fs==nil or not fs.ok {
        let result=rejected("parent_unavailable","Output folder could not be opened securely.",format);
        // No acquired root was returned; do not certify hidden backend cleanup.
        result.wrapper_handles_closed=false;
        return result;
    }
    let held = try Dir.sealed_child_bytes(fs,"archive-publication",snapshot) catch nil;
    let result=rejected("snapshot_unavailable","Verified file snapshot could not be prepared.",format);
    if held!=nil and held.ok {
        let published = try Dir.copy_held_range_new_atomic(fs,held,fs,path_basename(path),
            0,len(snapshot),false,false,len(snapshot)==0) catch nil;
        let confirmed=published!=nil and ((try published.ok catch false)
            or (try published.published catch false));
        result=map{ok:published!=nil and (try published.ok catch false),
            format:format, publication_attempted:true,
            publication_confirmed:confirmed, output_may_exist:true,
            partial_output_possible:false, durability_verified:confirmed and
                (try published.durability_verified catch false),
            wrapper_handles_closed:false, metadata_only:true, safe_to_log:false};
        if confirmed { result.written=true; result.atomic_visibility=true; }
        if not result.ok {
            result.code="publication_unconfirmed";
            result.error="Publication not confirmed. Check the destination before retrying; an existing file was not replaced.";
        }
    }
    // Consume the root and registered child once; never retry an ambiguous fd close.
    result.wrapper_handles_closed=try Dir.close(fs) catch false;
    if not result.wrapper_handles_closed {
        result.ok=false; result.cleanup_error="Publication handle closure was not confirmed.";
        if not map_has(result,"error") {
            result.code="cleanup_unconfirmed";
            result.error="File published, but cleanup was not confirmed. Do not repeat the write.";
        }
    }
    return result;
}
export save, extract_member;
