// stdlib/pblang_health.sapp -- cheap product-health snapshot for the pblang runtime.

let JIT = import("stdlib:jit.sapp");
let PRODUCT_HEALTH = import("stdlib:product_health.sapp");
let PRODUCT_PERFORMANCE = import("stdlib:product_performance.sapp");
let RESOURCE_BUDGET = import("stdlib:resource_budget.sapp");
let RESILIENCE = import("stdlib:resilience.sapp");

fn snapshot(performance = nil) {
    let mode = JIT.runtime_mode();
    let jit_status = "degraded";
    if JIT.is_available() { jit_status = "ready"; }
    let platform_name = try platform() catch "unknown";
    let platform_status = "ready";
    if platform_name == "" or platform_name == "unknown" { platform_status = "degraded"; }
    let admission = RESOURCE_BUDGET.evaluate(RESOURCE_BUDGET.profile("untrusted"), RESOURCE_BUDGET.usage(map{ elapsed_ms: 1, workers: 1 }));
    let resilience_policy = RESILIENCE.policy("health-probe", map{ max_attempts: 2, timeout_ms: 1000 });
    let resilience_decision = RESILIENCE.decision(resilience_policy, RESILIENCE.initial(resilience_policy, 0), 0);
    let performance_result = PRODUCT_PERFORMANCE.resolve("pblang", performance);
    return PRODUCT_HEALTH.report("pblang", "current", [
        PRODUCT_HEALTH.check("interpreter", "ready",
            "portable VM/interpreter route is active",
            map{ required: true, category: "runtime" }),
        PRODUCT_HEALTH.check("jit", jit_status,
            "runtime mode=" + str(mode) + "; JIT is optional and the interpreter remains the fallback",
            map{ required: false, category: "performance" }),
        PRODUCT_HEALTH.check("platform", platform_status,
            "host platform=" + str(platform_name),
            map{ required: false, category: "portability" }),
        PRODUCT_HEALTH.check("capability_sandbox", "ready",
            "filesystem, process, network, FFI, polyglot, and device authority remain capability-gated",
            map{ required: true, category: "security", security_sensitive: true }),
        PRODUCT_HEALTH.check("deterministic_fallback", "ready",
            "optional native, JIT, GPU, and polyglot routes preserve a portable baseline",
            map{ required: true, category: "compatibility" }),
        PRODUCT_HEALTH.check("resource_admission", if admission.allowed { "ready" } else { "blocked" },
            "bounded workload admission and adaptive backpressure are available in pure pblang",
            map{ required: true, category: "reliability" }),
        PRODUCT_HEALTH.check("resilience_policy", if resilience_decision.allowed { "ready" } else { "blocked" },
            "bounded retries, deadlines, cancellation, and circuit recovery share a deterministic pblang contract",
            map{ required: true, category: "reliability" }),
        PRODUCT_PERFORMANCE.health_check("performance_budget", performance_result, performance != nil)
    ], map{
        minimum_score: 80,
        capabilities: ["interpreter", "optional-jit", "capability-sandbox", "portable-fallback", "resource-admission", "resilience-policy", "performance-budget"],
        dependencies: []
    });
}

export snapshot;
