// stdlib/performance_budget.sapp -- fail-closed benchmark regression gates.
// A budget compares numeric baseline/candidate fields. It can protect latency,
// peak memory, artifact size, throughput, or any other measured metric.

fn _direction(spec) {
    if map_has(spec, "lower_is_better") { return spec.lower_is_better; }
    return true;
}

fn compare_metric(before, after, lower_is_better = true) {
    if not is_number(before) or not is_number(after) {
        return map{ ok: false, status: "invalid-metric", before: before, after: after };
    }
    let delta = after - before;
    let delta_percent = nil; let ratio = nil;
    if before != 0 { delta_percent = (delta / before) * 100.0; ratio = after / before; }
    let improvement_percent = nil;
    if delta_percent != nil { improvement_percent = if lower_is_better { 0 - delta_percent } else { delta_percent }; }
    return map{
        ok: true, status: "ok", before: before, after: after, delta: delta,
        delta_percent: delta_percent, ratio: ratio,
        improvement_percent: improvement_percent, lower_is_better: lower_is_better
    };
}

// evaluate(baseline, candidate, budgets)
// budget: { metric, max_regression_percent, lower_is_better? }
// Missing/non-numeric metrics and a zero baseline that changes are failures.
fn evaluate(baseline, candidate, budgets) {
    if not is_map(baseline) or not is_map(candidate) or not is_array(budgets) {
        return map{ ok: false, status: "invalid-input", checks: [], failures: ["invalid-input"] };
    }
    let checks = []; let failures = []; let i = 0;
    while i < len(budgets) {
        let spec = budgets[i]; let metric = if is_map(spec) and map_has(spec, "metric") { str(spec.metric) } else { "" };
        let limit = if is_map(spec) and map_has(spec, "max_regression_percent") { spec.max_regression_percent } else { nil };
        if metric == "" or not is_number(limit) or limit < 0 {
            array_push(failures, "invalid-budget:" + metric);
            array_push(checks, map{ metric: metric, ok: false, status: "invalid-budget" });
        } elif not map_has(baseline, metric) or not map_has(candidate, metric) {
            array_push(failures, "missing-metric:" + metric);
            array_push(checks, map{ metric: metric, ok: false, status: "missing-metric" });
        } else {
            let lower = _direction(spec);
            let cmp = compare_metric(baseline[metric], candidate[metric], lower);
            let regression = nil; let passed = false; let status = cmp.status;
            if cmp.ok {
                if cmp.before == 0 {
                    regression = if cmp.after == 0 { 0 } else { nil };
                    passed = cmp.after == 0; status = if passed { "ok" } else { "zero-baseline-changed" };
                } else {
                    regression = if lower { cmp.delta_percent } else { 0 - cmp.delta_percent };
                    passed = regression <= limit; status = if passed { "ok" } else { "regression" };
                }
            }
            let check = map{
                metric: metric, ok: passed, status: status, before: cmp.before, after: cmp.after,
                regression_percent: regression, max_regression_percent: limit,
                lower_is_better: lower
            };
            array_push(checks, check);
            if not passed { array_push(failures, status + ":" + metric); }
        }
        i = i + 1;
    }
    return map{ ok: len(failures) == 0, status: if len(failures) == 0 { "ok" } else { "failed" }, checks: checks, failures: failures };
}

fn assert_within(baseline, candidate, budgets) {
    let result = evaluate(baseline, candidate, budgets);
    if not result.ok { throw "performance budget failed: " + str(result.failures); }
    return result;
}

export compare_metric, evaluate, assert_within;
