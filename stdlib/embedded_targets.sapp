// First-class embedded target descriptions and compile-time hardware safety.
//
// The hierarchy is architecture -> MCU -> board -> capabilities/pins. A board
// reuses one MCU definition; applications resolve logical aliases only during
// lowering. Descriptors never imply that a native backend exists.

let FORMAT = "pblang.embedded-target.v1";
let MAX_OPERATIONS = 1024;

fn _capabilities(names) {
    let out = map{};
    for i len(names) { out[names[i]] = true; }
    return out;
}

fn _copy_map(source) {
    let out = map{};
    if source == nil or not is_map(source) { return out; }
    let keys = map_keys(source);
    for i len(keys) { out[keys[i]] = source[keys[i]]; }
    return out;
}

fn architectures() {
    return [
        map{ id:"avr8", family:"avr", isa:"avr5", word_bits:8, pointer_bits:16,
             endianness:"little", backend:"native-avr8", backend_status:"implemented" },
        map{ id:"xtensa-lx6", family:"xtensa", isa:"xtensa-lx6", word_bits:32,
             pointer_bits:32, endianness:"little", backend:"native-xtensa-lx6",
             backend_status:"incomplete" },
        map{ id:"riscv32-embedded", family:"riscv", isa:"rv32imc", word_bits:32,
             pointer_bits:32, endianness:"little", backend:"native-riscv32-embedded",
             backend_status:"incomplete" },
        map{ id:"armv7m", family:"arm", isa:"armv7e-m", word_bits:32,
             pointer_bits:32, endianness:"little", backend:"native-armv7m",
             backend_status:"incomplete" },
        map{ id:"renesas-ra", family:"arm", isa:"armv7e-m", word_bits:32,
             pointer_bits:32, endianness:"little", backend:"native-renesas-ra",
             backend_status:"incomplete" },
        map{ id:"rp2040-arm", family:"arm", isa:"armv6-m", word_bits:32,
             pointer_bits:32, endianness:"little", backend:"native-rp2040",
             backend_status:"incomplete" },
        map{ id:"rp2350-arm", family:"arm", isa:"armv8-m", word_bits:32,
             pointer_bits:32, endianness:"little", backend:"native-rp2350-arm",
             backend_status:"incomplete" },
        map{ id:"rp2350-riscv", family:"riscv", isa:"hazard3-rv32imac", word_bits:32,
             pointer_bits:32, endianness:"little", backend:"native-rp2350-riscv",
             backend_status:"incomplete" },
        map{ id:"msp430", family:"msp430", isa:"msp430", word_bits:16,
             pointer_bits:16, endianness:"little", backend:"native-msp430",
             backend_status:"incomplete" },
        map{ id:"mcs51", family:"8051", isa:"mcs51", word_bits:8,
             pointer_bits:16, endianness:"little", backend:"native-mcs51",
             backend_status:"incomplete" },
        map{ id:"pic", family:"pic", isa:"pic-family", word_bits:8,
             pointer_bits:16, endianness:"little", backend:"native-pic",
             backend_status:"incomplete" }
    ];
}

fn _atmega328p() {
    return map{
        id:"atmega328p", vendor:"microchip", architecture:"avr8", cpu:"avr5",
        abi:"pblang-avr-baremetal-v1", clock_hz:16000000, flash_bytes:32768,
        sram_bytes:2048, persistent_bytes:1024, interrupt_vectors:26,
        capabilities:_capabilities(["gpio","time","interrupts","timers","pwm","adc",
            "uart","i2c","spi","watchdog","eeprom"]),
        registers:map{
            "B":map{ pin:3, direction:4, output:5 },
            "C":map{ pin:6, direction:7, output:8 },
            "D":map{ pin:9, direction:10, output:11 }
        },
        native_backend:"native-avr8", native_backend_status:"implemented"
    };
}

fn _esp32() {
    return map{
        id:"esp32", vendor:"espressif", architecture:"xtensa-lx6", cpu:"dual-xtensa-lx6",
        abi:"esp32-rom-baremetal", clock_hz:240000000, flash_bytes:4194304,
        sram_bytes:532480, persistent_bytes:0, interrupt_vectors:32,
        capabilities:_capabilities(["gpio","time","interrupts","timers","pwm","adc","dac",
            "uart","i2c","spi","watchdog","flash","wifi","bluetooth","touch","hall"]),
        native_backend:"native-xtensa-lx6", native_backend_status:"experimental-ram"
    };
}

fn _ra4m1() {
    return map{
        id:"ra4m1", vendor:"renesas", architecture:"renesas-ra", cpu:"cortex-m4",
        abi:"arm-eabi-baremetal", clock_hz:48000000, flash_bytes:262144,
        sram_bytes:32768, persistent_bytes:8192, interrupt_vectors:96,
        capabilities:_capabilities(["gpio","time","interrupts","timers","pwm","adc","dac",
            "uart","i2c","spi","watchdog","flash","usb","can"]),
        native_backend:"native-renesas-ra", native_backend_status:"incomplete"
    };
}

fn _rp2040() {
    return map{
        id:"rp2040", vendor:"raspberry-pi", architecture:"rp2040-arm",
        cpu:"dual-cortex-m0-plus", abi:"arm-eabi-baremetal", clock_hz:133000000,
        flash_bytes:2097152, sram_bytes:270336, persistent_bytes:0, interrupt_vectors:32,
        capabilities:_capabilities(["gpio","time","interrupts","timers","pwm","adc","uart",
            "i2c","spi","watchdog","flash","usb","pio"]),
        native_backend:"native-rp2040", native_backend_status:"incomplete"
    };
}

fn _rp2350() {
    return map{
        id:"rp2350", vendor:"raspberry-pi", architecture:"rp2350-arm",
        alternate_architecture:"rp2350-riscv", cpu:"dual-cortex-m33-or-dual-hazard3",
        abi:"arm-or-riscv-baremetal", clock_hz:150000000, flash_bytes:4194304,
        sram_bytes:532480, persistent_bytes:0, interrupt_vectors:64,
        capabilities:_capabilities(["gpio","time","interrupts","timers","pwm","adc","uart",
            "i2c","spi","watchdog","flash","usb","pio","security"]),
        native_backend:"native-rp2350-arm", native_backend_status:"incomplete"
    };
}

fn mcus() { return [_atmega328p(), _esp32(), _ra4m1(), _rp2040(), _rp2350()]; }

fn _pin(alias, gpio, port, bit, capabilities, warnings = nil, reserved = false,
         input_only = false) {
    if warnings == nil { warnings = []; }
    return map{ alias:alias, gpio:gpio, port:port, bit:bit,
        capabilities:_capabilities(capabilities), warnings:warnings,
        reserved:reserved, input_only:input_only };
}

fn _uno_pins() {
    let pins = map{};
    for n 8 {
        let name = "D" + str(n);
        let warnings = if n < 2 { ["pin shares the hardware UART used by the bootloader/monitor"] } else { [] };
        let caps = ["gpio","digital-in","digital-out"];
        if n == 3 or n == 5 or n == 6 { array_push(caps, "pwm"); }
        if n == 0 { array_push(caps, "uart-rx"); }
        if n == 1 { array_push(caps, "uart-tx"); }
        if n == 2 or n == 3 { array_push(caps, "external-interrupt"); }
        pins[name] = _pin(name, n, "D", n, caps, warnings);
    }
    for n 6 {
        let number = n + 8; let name = "D" + str(number);
        let caps = ["gpio","digital-in","digital-out"];
        if number == 9 or number == 10 or number == 11 or number == 3 or number == 5 or number == 6 {
            array_push(caps, "pwm");
        }
        if number == 10 { array_push(caps, "spi-ss"); }
        if number == 11 { array_push(caps, "spi-mosi"); }
        if number == 12 { array_push(caps, "spi-miso"); }
        if number == 13 { array_push(caps, "spi-sck"); array_push(caps, "onboard-led"); }
        pins[name] = _pin(name, number, "B", n, caps);
    }
    for n 6 {
        let name = "A" + str(n);
        let caps = ["gpio","digital-in","digital-out","adc"];
        if n == 4 { array_push(caps, "i2c-sda"); }
        if n == 5 { array_push(caps, "i2c-scl"); }
        pins[name] = _pin(name, n + 14, "C", n, caps);
        pins["D" + str(n + 14)] = pins[name];
    }
    pins["status-led-test"] = pins["D7"];
    return pins;
}

fn _esp32_pins() {
    let pins = map{};
    let valid = [0,1,2,3,4,5,12,13,14,15,16,17,18,19,21,22,23,25,26,27,32,33,34,35,36,39];
    for i len(valid) {
        let n = valid[i]; let name = "GPIO" + str(n); let warnings = [];
        if n == 0 or n == 2 or n == 5 or n == 12 or n == 15 {
            array_push(warnings, "boot-strapping pin; external levels can prevent startup");
        }
        if n == 1 or n == 3 { array_push(warnings, "pin shares the default UART"); }
        let input_only = n == 34 or n == 35 or n == 36 or n == 39;
        let caps = ["gpio","digital-in"];
        if not input_only { array_push(caps, "digital-out"); array_push(caps, "pwm"); }
        array_push(caps, "external-interrupt");
        if n == 25 or n == 26 { array_push(caps, "dac"); }
        let adc1 = n >= 32 and n <= 39;
        let adc2 = n == 0 or n == 2 or n == 4 or (n >= 12 and n <= 15)
            or (n >= 25 and n <= 27);
        if adc1 or adc2 { array_push(caps, "adc"); }
        if adc2 { array_push(warnings, "ADC2 conversion conflicts with active Wi-Fi on classic ESP32"); }
        if n == 0 or n == 2 or n == 4 or (n >= 12 and n <= 15)
           or n == 27 or n == 32 or n == 33 { array_push(caps, "touch"); }
        if input_only { array_push(warnings, "input-only pin has no software pull-up or pull-down"); }
        if n == 1 { array_push(caps, "uart0-tx"); }
        if n == 3 { array_push(caps, "uart0-rx"); }
        if n == 21 { array_push(caps, "i2c-sda-default"); }
        if n == 22 { array_push(caps, "i2c-scl-default"); }
        if n == 5 { array_push(caps, "vspi-ss-default"); }
        if n == 18 { array_push(caps, "vspi-sck-default"); }
        if n == 19 { array_push(caps, "vspi-miso-default"); }
        if n == 23 { array_push(caps, "vspi-mosi-default"); }
        pins[name] = _pin(name, n, "GPIO", n, caps, warnings, false, input_only);
    }
    for n 6 {
        let gpio = n + 6; let name = "GPIO" + str(gpio);
        pins[name] = _pin(name, gpio, "GPIO", gpio, [],
            ["reserved for connected SPI flash; driving it can crash or corrupt execution"], true, false);
    }
    pins["status-led-test"] = pins["GPIO23"];
    return pins;
}

fn _uno_board() {
    return map{
        id:"arduino-uno", aliases:["uno","uno-r3","arduino-uno-r3"],
        name:"Arduino UNO / compatible ATmega328P board", mcu:"atmega328p",
        logic_voltage:5.0, supply_voltage:5.0, clock_hz:16000000,
        pins:_uno_pins(), programmer:"stk500v1", upload_baud:115200,
        usb_matches:[map{ vid:"1a86", pid:"7523", confidence:"transport-compatible" },
                     map{ vid:"2341", pid:"0043", confidence:"board-specific" },
                     map{ vid:"2a03", pid:"0043", confidence:"board-specific" }],
        firmware_format:"ihex", flash_offset:0,
        hardware_status:"signature-verified-2026-08-17"
    };
}

fn _esp32_board() {
    return map{
        id:"esp32-devkitc-v4", aliases:["esp32","esp32-wroom-32d","devkitc-v4"],
        name:"ESP32 DevKitC V4 / ESP32-WROOM-32D", mcu:"esp32",
        logic_voltage:3.3, supply_voltage:5.0, clock_hz:240000000,
        pins:_esp32_pins(), programmer:"esp-rom-serial", upload_baud:460800,
        usb_matches:[map{ vid:"10c4", pid:"ea60", confidence:"transport-compatible" },
                     map{ vid:"1a86", pid:"7523", confidence:"transport-compatible" }],
        firmware_format:"esp-image", flash_offset:4096,
        hardware_status:"gpio23-ram-blink-and-uart-timing-verified-2026-08-17"
    };
}

fn _uno_r4_board() {
    return map{
        id:"arduino-uno-r4-wifi", aliases:["uno-r4","uno-r4-wifi"],
        name:"Arduino UNO R4 WiFi", mcu:"ra4m1", logic_voltage:5.0,
        supply_voltage:5.0, clock_hz:48000000, pins:map{},
        programmer:"renesas-rom", upload_baud:115200, usb_matches:[],
        firmware_format:"bin", flash_offset:0, hardware_status:"planned"
    };
}

fn _pico_pins(default_pin) {
    let pins = map{};
    for n 29 {
        let name = "GPIO" + str(n); let caps = ["gpio","digital-in","digital-out","pwm"];
        array_push(caps, "external-interrupt");
        if n >= 26 { array_push(caps, "adc"); }
        if n == 0 { array_push(caps, "uart0-tx"); array_push(caps, "i2c0-sda"); }
        if n == 1 { array_push(caps, "uart0-rx"); array_push(caps, "i2c0-scl"); }
        if n == 4 { array_push(caps, "uart1-tx"); array_push(caps, "i2c0-sda"); }
        if n == 5 { array_push(caps, "uart1-rx"); array_push(caps, "i2c0-scl"); }
        pins[name] = _pin(name, n, "GPIO", n, caps);
    }
    pins["status-led-test"] = pins["GPIO" + str(default_pin)];
    return pins;
}

fn _pico_board(id, name, mcu_id, default_pin, wireless) {
    let caps_note = if wireless { "wireless module is separate from the RP MCU backend" } else { "no onboard radio" };
    return map{
        id:id, aliases:[], name:name, mcu:mcu_id, logic_voltage:3.3,
        supply_voltage:5.0, clock_hz:if mcu_id == "rp2040" { 133000000 } else { 150000000 },
        pins:_pico_pins(default_pin), programmer:"uf2-rom", upload_baud:115200,
        usb_matches:[], firmware_format:"uf2", flash_offset:268435456,
        hardware_status:"planned-no-connected-board", note:caps_note
    };
}

fn boards() {
    return [_uno_board(), _esp32_board(), _uno_r4_board(),
        _pico_board("raspberry-pi-pico", "Raspberry Pi Pico", "rp2040", 15, false),
        _pico_board("raspberry-pi-pico-w", "Raspberry Pi Pico W", "rp2040", 15, true),
        _pico_board("raspberry-pi-pico-2", "Raspberry Pi Pico 2", "rp2350", 15, false),
        _pico_board("raspberry-pi-pico-2-w", "Raspberry Pi Pico 2 W", "rp2350", 15, true)];
}

fn family_roadmap() {
    return [
        map{ family:"AVR/megaAVR", architecture_ids:["avr8"], status:"first-native-slice" },
        map{ family:"Espressif Xtensa", architecture_ids:["xtensa-lx6"], status:"incomplete" },
        map{ family:"Espressif RISC-V", architecture_ids:["riscv32-embedded"], status:"incomplete" },
        map{ family:"ARM Cortex-M/SAM/SAMD/STM32/nRF", architecture_ids:["armv7m"], status:"incomplete" },
        map{ family:"Renesas RA", architecture_ids:["renesas-ra"], status:"incomplete" },
        map{ family:"Raspberry Pi RP2040/RP2350", architecture_ids:["rp2040-arm","rp2350-arm","rp2350-riscv"], status:"incomplete" },
        map{ family:"MSP430", architecture_ids:["msp430"], status:"incomplete" },
        map{ family:"8051", architecture_ids:["mcs51"], status:"incomplete" },
        map{ family:"PIC", architecture_ids:["pic"], status:"incomplete" }
    ];
}

fn _find(rows, id_value) {
    let wanted = str_lower(str(id_value));
    for i len(rows) {
        if rows[i].id == wanted { return rows[i]; }
        let aliases = try rows[i].aliases catch [];
        for j len(aliases) { if aliases[j] == wanted { return rows[i]; } }
    }
    return nil;
}

fn architecture(id) { return _find(architectures(), id); }
fn mcu(id) { return _find(mcus(), id); }

fn board(id) {
    let found = _find(boards(), id);
    if found == nil { return nil; }
    let out = _copy_map(found); out.mcu_info = mcu(found.mcu);
    out.architecture_info = architecture(out.mcu_info.architecture);
    return out;
}

fn pin(board_value, alias_value) {
    if board_value == nil or not is_map(board_value) { return nil; }
    let alias = str(alias_value); let normalized = str_upper(alias);
    if map_has(board_value.pins, alias) { return board_value.pins[alias]; }
    if map_has(board_value.pins, normalized) { return board_value.pins[normalized]; }
    return nil;
}

fn has_capability(value, name) {
    if value == nil or not is_map(value) or not map_has(value.capabilities, name) { return false; }
    return value.capabilities[name];
}

fn _issue(a, b, c, d = nil) {
    return map{ severity:a, code:b, message:c, operation:if d == nil { 0 - 1 } else { d } };
}

fn validate_program(program, board_value) {
    let errors = []; let warnings = [];
    if board_value == nil or not is_map(board_value) {
        array_push(errors, _issue("error", "unknown-board", "embedded board is not supported"));
        return map{ ok:false, format:FORMAT, errors:errors, warnings:warnings };
    }
    if program == nil or not is_map(program) or type(try program.operations catch nil) != "array" {
        array_push(errors, _issue("error", "invalid-program", "embedded program requires an operations array"));
        return map{ ok:false, format:FORMAT, board:board_value.id, errors:errors, warnings:warnings };
    }
    if len(program.operations) > MAX_OPERATIONS {
        array_push(errors, _issue("error", "operation-limit", "embedded program exceeds 1024 operations"));
        return map{ ok:false, format:FORMAT, board:board_value.id, errors:errors, warnings:warnings };
    }
    let used = map{};
    for i len(program.operations) {
        let op = program.operations[i]; let kind = str(try op.kind catch "");
        if kind == "pin-mode" or kind == "digital-write" or kind == "digital-read"
           or kind == "analog-read" or kind == "analog-write" or kind == "pwm-write" {
            if not has_capability(board_value.mcu_info, "gpio") {
                array_push(errors, _issue("error", "missing-gpio", "target MCU has no GPIO capability", i));
            } else {
                let selected = pin(board_value, try op.pin catch "");
                if selected == nil {
                    array_push(errors, _issue("error", "unknown-pin", "unknown board pin alias '" + str(try op.pin catch "") + "'", i));
                } else {
                    if selected.reserved {
                        array_push(errors, _issue("error", "reserved-pin", "pin " + selected.alias + " is reserved by the board/MCU", i));
                    }
                    if (kind == "digital-write" or (kind == "pin-mode" and (try op.mode catch "") == "output")) and selected.input_only {
                        array_push(errors, _issue("error", "input-only-pin", "pin " + selected.alias + " cannot drive output", i));
                    }
                    let required = "";
                    if kind == "digital-read" { required = "digital-in"; }
                    elif kind == "digital-write" { required = "digital-out"; }
                    elif kind == "analog-read" { required = "adc"; }
                    elif kind == "analog-write" { required = "dac"; }
                    elif kind == "pwm-write" { required = "pwm"; }
                    elif kind == "pin-mode" and (try op.mode catch "") == "output" { required = "digital-out"; }
                    elif kind == "pin-mode" { required = "digital-in"; }
                    if required != "" and not has_capability(selected, required) {
                        array_push(errors, _issue("error", "missing-pin-capability",
                            "pin " + selected.alias + " does not support " + required, i));
                    }
                    if kind == "analog-write" or kind == "pwm-write" {
                        let value = try op.value catch -1;
                        if type(value) != "number" or value != num_floor(value) or value < 0 or value > 255 {
                            array_push(errors, _issue("error", "invalid-output-value",
                                "analog/PWM output must be a whole 0..255", i));
                        }
                    }
                    for w len(selected.warnings) {
                        array_push(warnings, _issue("warning", "pin-hazard", selected.alias + ": " + selected.warnings[w], i));
                    }
                    let physical = selected.port + ":" + str(selected.bit);
                    if map_has(used, physical) and used[physical] != str(try op.pin catch "") {
                        array_push(warnings, _issue("warning", "pin-alias", "multiple aliases select " + physical, i));
                    }
                    used[physical] = str(try op.pin catch "");
                }
            }
        } elif kind == "delay-ms" {
            let amount = try op.value catch 0;
            if type(amount) != "number" or amount != num_floor(amount) or amount < 1 or amount > 60000 {
                array_push(errors, _issue("error", "invalid-delay", "delay must be a whole 1..60000 milliseconds", i));
            }
        } elif kind != "loop-begin" and kind != "loop-end" {
            array_push(errors, _issue("error", "unsupported-operation", "unsupported embedded operation '" + kind + "'", i));
        }
    }
    return map{ ok:len(errors)==0, format:FORMAT, board:board_value.id,
        architecture:board_value.mcu_info.architecture, mcu:board_value.mcu,
        errors:errors, warnings:warnings, operation_count:len(program.operations) };
}

fn backend_status(board_value) {
    let selected = if is_map(board_value) { board_value } else { board(board_value) };
    if selected == nil { return map{ ok:false, error:"unknown board" }; }
    let arch = selected.architecture_info;
    return map{ ok:arch.backend_status=="implemented", board:selected.id,
        architecture:arch.id, backend:arch.backend, status:arch.backend_status,
        native_only:true, c_fallback:false };
}

fn _backend_operation(selected, selected_pin, operation) {
    let physical = false;
    if operation == "digital-read" { physical = has_capability(selected_pin, "digital-in"); }
    elif operation == "digital-write" { physical = has_capability(selected_pin, "digital-out"); }
    elif operation == "analog-read" { physical = has_capability(selected_pin, "adc"); }
    elif operation == "analog-write" { physical = has_capability(selected_pin, "dac"); }
    elif operation == "pwm-write" { physical = has_capability(selected_pin, "pwm"); }
    elif operation == "interrupt" { physical = has_capability(selected_pin, "external-interrupt"); }
    if not physical {
        return map{ physical:false, compiler_status:"not-available-on-pin", native:false };
    }
    if selected.mcu == "atmega328p" and operation == "digital-write" {
        return map{ physical:true, compiler_status:"implemented", native:true };
    }
    if selected.mcu == "esp32" and selected_pin.gpio == 23 and operation == "digital-write" {
        return map{ physical:true, compiler_status:"experimental-ram-blink-only", native:true };
    }
    return map{ physical:true, compiler_status:"incomplete", native:false };
}

fn _pin_row(selected, alias, selected_pin) {
    let operations = map{};
    let names = ["digital-read","digital-write","analog-read","analog-write","pwm-write","interrupt"];
    for i len(names) { operations[names[i]] = _backend_operation(selected, selected_pin, names[i]); }
    return map{ alias:alias, canonical_alias:selected_pin.alias, gpio:selected_pin.gpio,
        port:selected_pin.port, bit:selected_pin.bit,
        capabilities:array_sort(map_keys(selected_pin.capabilities)),
        reserved:selected_pin.reserved, input_only:selected_pin.input_only,
        safety_notes:selected_pin.warnings, operations:operations };
}

fn inspect_pin(board_id, pin_alias = nil) {
    let selected = board(board_id);
    if selected == nil { return map{ ok:false, format:FORMAT, error:"unknown board" }; }
    if pin_alias != nil and str(pin_alias) != "" {
        let selected_pin = pin(selected, pin_alias);
        if selected_pin == nil { return map{ ok:false, format:FORMAT, board:selected.id,
            error:"unknown board pin alias", requested_alias:str(pin_alias) }; }
        let row = _pin_row(selected, str(pin_alias), selected_pin);
        return map{ ok:true, format:FORMAT, board:selected.id, mcu:selected.mcu,
            architecture:selected.mcu_info.architecture, logic_voltage:selected.logic_voltage,
            pin:row, hardware_capability_is_not_codegen_support:true };
    }
    let aliases = array_sort(map_keys(selected.pins)); let rows = []; let physical = map{};
    for i len(aliases) {
        if aliases[i] != "status-led-test" {
            let selected_pin = selected.pins[aliases[i]];
            array_push(rows, _pin_row(selected, aliases[i], selected_pin));
            physical[selected_pin.port + ":" + str(selected_pin.bit)] = true;
        }
    }
    return map{ ok:true, format:FORMAT, board:selected.id, mcu:selected.mcu,
        architecture:selected.mcu_info.architecture, logic_voltage:selected.logic_voltage,
        pins:rows, pin_alias_count:len(rows), physical_pin_count:len(map_keys(physical)),
        portable_roles:map{status_led_test:"status-led-test"},
        hardware_capability_is_not_codegen_support:true };
}

fn technical_manual(board_id) {
    let selected = board(board_id);
    if selected == nil { return map{ ok:false, format:FORMAT, error:"unknown board" }; }
    let status = backend_status(selected); let inspected = inspect_pin(selected.id);
    return map{ ok:true, format:"pblang.embedded-technical-manual.v1",
        board:map{ id:selected.id, name:selected.name, aliases:selected.aliases,
            logic_voltage:selected.logic_voltage, supply_voltage:selected.supply_voltage,
            clock_hz:selected.clock_hz, pin_alias_count:inspected.pin_alias_count,
            physical_pin_count:inspected.physical_pin_count,
            hardware_status:selected.hardware_status },
        mcu:map{ id:selected.mcu_info.id, vendor:selected.mcu_info.vendor,
            cpu:selected.mcu_info.cpu, abi:selected.mcu_info.abi,
            clock_hz:selected.mcu_info.clock_hz, flash_bytes:selected.mcu_info.flash_bytes,
            sram_bytes:selected.mcu_info.sram_bytes,
            persistent_bytes:selected.mcu_info.persistent_bytes,
            interrupt_vectors:selected.mcu_info.interrupt_vectors,
            capabilities:array_sort(map_keys(selected.mcu_info.capabilities)) },
        architecture:selected.architecture_info,
        upload:map{ programmer:selected.programmer, baud:selected.upload_baud,
            firmware_format:selected.firmware_format, flash_offset:selected.flash_offset },
        compiler:status, pins:inspected.pins,
        safety:["verify board and voltage before wiring or flashing",
            "reserved and input-only pins fail closed during validation",
            "USB VID/PID identifies a transport and may not identify the exact board",
            "hardware capabilities and implemented compiler operations are reported separately"],
        source_language:"pblang", c_fallback:false };
}

fn coverage() {
    let rows = boards(); let implemented = []; let incomplete = [];
    for i len(rows) {
        let status = backend_status(board(rows[i].id));
        if status.ok { array_push(implemented, rows[i].id); }
        else { array_push(incomplete, rows[i].id); }
    }
    return map{ format:FORMAT, boards:len(rows), implemented:implemented,
        incomplete:incomplete, native_only:true, silent_fallback:false };
}

export FORMAT, MAX_OPERATIONS, architectures, mcus, boards, family_roadmap, architecture, mcu, board, pin;
export has_capability, validate_program, backend_status, coverage, inspect_pin, technical_manual;
