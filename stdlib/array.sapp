// stdlib/array.sapp — Array helpers

fn push(a, v) { return array_push(a, v); }
fn pop(a) { return array_pop(a); }

// map(a, fn) → new array with fn applied to each element
fn map(a, fn_val) {
    let result = [];
    let i = 0;
    while i < len(a) {
        array_push(result, fn_val(a[i]));
        i = i + 1;
    }
    return result;
}

// filter(a, fn) → new array of elements where fn returns truthy
fn filter(a, fn_val) {
    let result = [];
    let i = 0;
    while i < len(a) {
        if fn_val(a[i]) {
            array_push(result, a[i]);
        }
        i = i + 1;
    }
    return result;
}

// reduce(a, fn, initial) → accumulated value (fn receives acc, element)
fn reduce(a, fn_val, initial) {
    let acc = initial;
    let i = 0;
    while i < len(a) {
        acc = fn_val(acc, a[i]);
        i = i + 1;
    }
    return acc;
}

// contains(a, v) → true if v is in a
fn contains(a, v) {
    let i = 0;
    while i < len(a) {
        if a[i] == v { return true; }
        i = i + 1;
    }
    return false;
}

// index_of(a, v) → first index of v, or -1
fn index_of(a, v) {
    let i = 0;
    while i < len(a) {
        if a[i] == v { return i; }
        i = i + 1;
    }
    return -1;
}

// first(a) → first element, or nil
fn first(a) {
    if len(a) == 0 { return nil; }
    return a[0];
}

// last(a) → last element, or nil
fn last(a) {
    let n = len(a);
    if n == 0 { return nil; }
    return a[n - 1];
}

// slice(a, start, end) → new array a[start..end) (exclusive end)
fn slice(a, start, end_idx) {
    let result = [];
    let i = start;
    while i < end_idx and i < len(a) {
        array_push(result, a[i]);
        i = i + 1;
    }
    return result;
}

// reverse(a) → new array with elements in reverse order
fn reverse(a) {
    let result = [];
    let i = len(a) - 1;
    while i >= 0 {
        array_push(result, a[i]);
        i = i - 1;
    }
    return result;
}

// flat_map(a, fn) → map then flatten one level
fn flat_map(a, fn_val) {
    let result = [];
    let i = 0;
    while i < len(a) {
        let sub = fn_val(a[i]);
        let j = 0;
        while j < len(sub) {
            array_push(result, sub[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

// sum(a) → sum of numeric elements
fn sum(a) {
    let s = 0;
    let i = 0;
    while i < len(a) { s = s + a[i]; i = i + 1; }
    return s;
}

// any(a, fn) → true if fn returns truthy for any element
fn any(a, fn_val) {
    let i = 0;
    while i < len(a) {
        if fn_val(a[i]) { return true; }
        i = i + 1;
    }
    return false;
}

// all(a, fn) → true if fn returns truthy for all elements
fn all(a, fn_val) {
    let i = 0;
    while i < len(a) {
        if fn_val(a[i]) == false { return false; }
        i = i + 1;
    }
    return true;
}


// sort(a) → new sorted array (numbers: ascending; strings: lexicographic)
fn sort(a) { return array_sort(a); }

export push, pop, map, filter, reduce, contains, index_of, first, last,
       slice, reverse, flat_map, sum, any, all, sort;
