// stdlib/array.sapp — Array helpers
let _collection_keys = import("stdlib:collection_keys.sapp");
let _windowing = import("stdlib:array_windowing.sapp");

fn push(a, v) { return array_push(a, v); }
fn pop(a) { return array_pop(a); }

// map(a, fn) → new array with fn applied to each element
fn map(a, fn_val) {
    let result = [];
    let i = 0;
    while i < len(a) {
        array_push(result, fn_val(a[i]));
        i = i + 1;
    }
    return result;
}

// filter(a, fn) → new array of elements where fn returns truthy
fn filter(a, fn_val) {
    let result = [];
    let i = 0;
    while i < len(a) {
        if fn_val(a[i]) {
            array_push(result, a[i]);
        }
        i = i + 1;
    }
    return result;
}

// reduce(a, fn, initial) → accumulated value (fn receives acc, element)
fn reduce(a, fn_val, initial) {
    let acc = initial;
    let i = 0;
    while i < len(a) {
        acc = fn_val(acc, a[i]);
        i = i + 1;
    }
    return acc;
}

// contains(a, v) → true if v is in a
fn contains(a, v) {
    let i = 0;
    while i < len(a) {
        if a[i] == v { return true; }
        i = i + 1;
    }
    return false;
}

// index_of(a, v) → first index of v, or -1
fn index_of(a, v) {
    let i = 0;
    while i < len(a) {
        if a[i] == v { return i; }
        i = i + 1;
    }
    return -1;
}

// first(a) → first element, or nil
fn first(a) {
    if len(a) == 0 { return nil; }
    return a[0];
}

// last(a) → last element, or nil
fn last(a) {
    let n = len(a);
    if n == 0 { return nil; }
    return a[n - 1];
}

// slice(a, start, end) → new array a[start..end) (exclusive end)
fn slice(a, start, end_idx) {
    let n = len(a);
    if start < 0 { start = 0; }
    if end_idx < 0 { end_idx = 0; }
    if start > n { start = n; }
    if end_idx > n { end_idx = n; }
    if end_idx < start { return []; }
    let result = [];
    let i = start;
    while i < end_idx {
        array_push(result, a[i]);
        i = i + 1;
    }
    return result;
}

// reverse(a) → new array with elements in reverse order
fn reverse(a) {
    let result = [];
    let i = len(a) - 1;
    while i >= 0 {
        array_push(result, a[i]);
        i = i - 1;
    }
    return result;
}

// flat_map(a, fn) → map then flatten one level
fn flat_map(a, fn_val) {
    let result = [];
    let i = 0;
    while i < len(a) {
        let sub = fn_val(a[i]);
        let j = 0;
        while j < len(sub) {
            array_push(result, sub[j]);
            j = j + 1;
        }
        i = i + 1;
    }
    return result;
}

// flatten(a) → flatten one level of nested arrays
fn flatten(a) { return array_flatten(a); }

// unique(a) → bounded scalar deduplication, preserving first occurrence order.
// For objects project a scalar key with distinct_by; raw array_unique is legacy.
fn unique(a) { return _collection_keys.distinct_by(a,fn(x) { return x; }); }

// zip(a, b) → [[a0,b0], ...], stopping at the shorter array
fn zip(a, b) { return array_zip(a, b); }

// PBLang chunking: no raw array_chunk size conversion. See ARRAY_WINDOWING.md.
fn chunk(a, size) {return _windowing.chunk(a,size);}

// take/drop clamp negative counts to zero for friendlier slicing-style behavior.
fn take(a, n) {
    if n < 0 { n = 0; }
    return array_take(a, n);
}

fn drop(a, n) {
    if n < 0 { n = 0; }
    return array_drop(a, n);
}

// sum(a) → sum of numeric elements
fn sum(a) {
    let s = 0;
    let i = 0;
    while i < len(a) { s = s + a[i]; i = i + 1; }
    return s;
}

fn min(a) { return min_of(a); }
fn max(a) { return max_of(a); }

// any(a, fn) → true if fn returns truthy for any element
fn any(a, fn_val) {
    let i = 0;
    while i < len(a) {
        if fn_val(a[i]) { return true; }
        i = i + 1;
    }
    return false;
}

// all(a, fn) → true if fn returns truthy for all elements
fn all(a, fn_val) {
    let i = 0;
    while i < len(a) {
        if fn_val(a[i]) == false { return false; }
        i = i + 1;
    }
    return true;
}

fn none(a, fn_val) {
    return any(a, fn_val) == false;
}

fn find(a, fn_val) {
    let i = 0;
    while i < len(a) {
        if fn_val(a[i]) { return a[i]; }
        i = i + 1;
    }
    return nil;
}

fn find_index(a, fn_val) {
    let i = 0;
    while i < len(a) {
        if fn_val(a[i]) { return i; }
        i = i + 1;
    }
    return -1;
}

fn count(a, fn_val) {
    let c = 0;
    let i = 0;
    while i < len(a) {
        if fn_val(a[i]) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

fn partition(a, fn_val) {
    let yes = [];
    let no = [];
    let i = 0;
    while i < len(a) {
        if fn_val(a[i]) {
            array_push(yes, a[i]);
        } else {
            array_push(no, a[i]);
        }
        i = i + 1;
    }
    return [yes, no];
}

// filter_map(a, fn) — transform and filter in one pass. A nil result is
// omitted; all other values are retained.
fn filter_map(a, fn_val) {
    let result = [];
    let i = 0;
    while i < len(a) {
        let value = fn_val(a[i]);
        if value != nil { array_push(result, value); }
        i = i + 1;
    }
    return result;
}

// scan(a, fn, initial) — running reductions after each input element.
fn scan(a, fn_val, initial) {
    let result = [];
    let acc = initial;
    let i = 0;
    while i < len(a) {
        acc = fn_val(acc, a[i]);
        array_push(result, acc);
        i = i + 1;
    }
    return result;
}

// distinct_by(a, key_fn) — bounded scalar-key deduplication; first occurrence wins.
fn distinct_by(a, key_fn) {
    return _collection_keys.distinct_by(a,key_fn);
}

// index_by(a, key_fn) — map keyed by key_fn(item); later items win.
fn index_by(a, key_fn) {
    let result = map{};
    let i = 0;
    while i < len(a) {
        result[str(key_fn(a[i]))] = a[i];
        i = i + 1;
    }
    return result;
}

// windows(a, size, step) — full sliding windows; incomplete tails are omitted.
fn windows(a, size, step = 1) {
    return _windowing.windows(a,size,step);
}

// sort(a) → new sorted array (numbers: ascending; strings: lexicographic)
fn sort(a) { return array_sort(a); }

export push, pop, map, filter, reduce, contains, index_of, first, last,
       slice, reverse, flat_map, flatten, unique, zip, chunk, take, drop,
       sum, min, max, any, all, none, find, find_index, count, partition,
       filter_map, scan, distinct_by, index_by, windows, sort;
