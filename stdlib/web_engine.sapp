// stdlib/web_engine.sapp — a small, complete web engine in pblang.
//
// Composes the pblang browser stack into one pipeline: fetch → parse → LAYOUT → PAINT.
//   browser.sapp  : fetch a page + extract title/text/blocks/links/images
//   layout.sapp   : flow the blocks into positioned, word-wrapped boxes (+ hit testing)
//   canvas.sapp   : a renderer-agnostic draw-command buffer a backend replays
//   theme.sapp    : the colors (role-based, dark/light)
//
//   let web = import("stdlib:web_engine.sapp");
//   let page = web.load("http://example.com");          // or page_from_html(url, html)
//   let doc  = web.render(page, map{ width: 800 });      // {title, boxes, links, width, height}
//   let cv   = web.paint(page, theme.dark(), map{ width: 800 });  // canvas of draw commands
//   for c in web.commands(cv) { /* draw c with your backend */ }
//   let box  = web.hit_test(doc, mouse_x, mouse_y);      // box under the cursor (for links)

let B = import("stdlib:browser.sapp");
let LAY = import("stdlib:layout.sapp");
let CV = import("stdlib:canvas.sapp");
let TH = import("stdlib:theme.sapp");

// load(url) — fetch + parse a page over HTTP (browser policy applies).
fn load(url) { return B.fetch_page(url); }

// page_from_html(url, html) — build a page from raw HTML (no network; for tests/offline).
fn page_from_html(url, html) {
    return map{ url: url, html: html, title: B.title(html), text: B.strip_tags(html) };
}

// render(page, opts) — lay the page out. opts: { width=640, pad, gap }.
// Returns { title, boxes, links:[{href}], width, height }.
fn render(page, opts) {
    let html = try page.html catch "";
    let doc = LAY.flow(B.page_blocks(page), opts);
    let raw = try B.links(html) catch [];
    let links = [];
    let i = 0;
    while i < len(raw) { array_push(links, map{ href: raw[i] }); i = i + 1; }
    return map{ title: try page.title catch "", boxes: doc.boxes, links: links, width: doc.width, height: doc.height };
}

// paint(page, theme, opts) — render then emit a themed canvas of draw commands.
fn paint(page, theme, opts) {
    let doc = render(page, opts);
    let cv = CV.new(doc.width, doc.height);
    CV.fill_rect(cv, 0, 0, doc.width, doc.height, TH.role(theme, "bg"));
    let i = 0;
    while i < len(doc.boxes) {
        let bx = doc.boxes[i];
        let kind = try bx.kind catch "p";
        if kind == "img" {
            CV.rect(cv, bx.x, bx.y, bx.w, bx.h, TH.role(theme, "border"));
            CV.text(cv, bx.x + 4, bx.y + 14, "[img] " + str(try bx.text catch ""), TH.role(theme, "muted"));
        } else {
            let color = TH.role(theme, "fg");
            if kind == "title" or kind == "h1" or kind == "h2" { color = TH.role(theme, "accent"); }
            let lines = try bx.lines catch [];
            let lh = try bx.line_h catch 12;
            let j = 0;
            while j < len(lines) {
                CV.text(cv, bx.x, bx.y + (j + 1) * lh, lines[j], color);
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return cv;
}

// hit_test(doc, x, y) — the rendered box under a point (for click→link), or nil.
fn hit_test(doc, x, y) { return LAY.hit_test(doc.boxes, x, y); }

// commands(cv) / command_count(cv) — the paint buffer for a backend to replay.
fn commands(cv) { return CV.commands(cv); }
fn command_count(cv) { return CV.count(cv); }

export load, page_from_html, render, paint, hit_test, commands, command_count;
