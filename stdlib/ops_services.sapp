// Optional read-only SaaS API recipes. Authentication and transport are supplied
// by trusted caller code, not http_client's presently inert header/timeout fields.
let Serialization=import("stdlib:serialization.sapp");
fn _keys(value,keys) {
    if type(value)!="map" or len(map_keys(value))!=len(keys) { return false; }
    for key in keys { if not map_has(value,key) { return false; } }
    return true;
}
fn _tailnet(value) {
    if type(value)!="string" or len(value)<1 or len(value)>128 or value=="." or value==".." { return false; }
    for i in range(0,len(value)) {
        if str_index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.@",str_slice(value,i,i+1))<0 { return false; }
    }
    return true;
}
fn request(service,params=nil) {
    if params==nil { params=map{}; }
    let url=""; let headers=map{"Accept":"application/json"};
    if service=="ngrok" and _keys(params,[]) {
        url="https://api.ngrok.com/endpoints"; headers["Ngrok-Version"]="2";
    } elif service=="netlify" and _keys(params,[]) {
        url="https://api.netlify.com/api/v1/sites?page=1&per_page=100";
    } elif service=="tailscale" and _keys(params,["tailnet"]) and _tailnet(params.tailnet) {
        url="https://api.tailscale.com/api/v2/tailnet/"+url_encode(params.tailnet)+"/devices";
    } else { throw "ops_services: unsupported service or parameters"; }
    return map{format:"pblang.ops-service-request.v1",service:service,method:"GET",url:url,
        headers:headers,body:"",timeout_ms:5000,max_response_bytes:65536,
        follow_redirects:false,automatic_retries:0,authentication:"adapter-owned",
        safe_to_log:false};
}
fn _failure(reason) {
    return map{ok:false,reason:reason,data:nil,complete_inventory:false,
        transport_verified:false,hard_timeout_enforced:false,safe_to_log:false};
}
// One caller-owned callback, exact {status:number,body:string} response.
// Limits below check returned data, not allocations/effects within the callback.
fn fetch(service,params,transport,allow_transport=false) {
    let plan=request(service,params);
    if allow_transport!=true { return _failure("transport-opt-in-required"); }
    if type(transport)!="fn" and type(transport)!="closure" { return _failure("invalid-transport"); }
    let response=try transport(plan) catch nil;
    if not _keys(response,["status","body"]) or type(response.status)!="number"
        or response.status<100 or response.status>599 or response.status!=num_floor(response.status)
        or type(response.body)!="string" or len(response.body)>65536
        or len(str_to_bytes(response.body))>65536 { return _failure("invalid-response"); }
    if response.status<200 or response.status>=300 { return _failure("http-failure"); }
    let parsed=Serialization.parse_safe(response.body,"json",map{strict:true,reject_duplicate_keys:true,
        max_input_bytes:65536,max_depth:12,max_items:4096,max_line_bytes:65536});
    if not parsed.ok or parsed.duplicate_keys_checked!=true { return _failure("invalid-json"); }
    // One bounded page is never evidence that an account/device inventory is complete.
    return map{ok:true,reason:"response-parsed",data:parsed.value,complete_inventory:false,
        transport_verified:false,hard_timeout_enforced:false,safe_to_log:false};
}
export request,fetch;
