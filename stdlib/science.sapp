// stdlib/science.sapp — practical science helpers for pblang.
//
// Scope: constants, units, vector math, physics, chemistry, signal helpers,
// geometry, and experiment tables. This is a portable foundation layer; heavier
// solvers/simulators can build on these contracts.

let C = 299792458;                       // speed of light, m/s
let G = 6.67430 * (10 ** (0 - 11));      // gravitational constant
let H = 6.62607015 * (10 ** (0 - 34));   // Planck constant
let HBAR = 1.054571817 * (10 ** (0 - 34)); // reduced Planck constant
let K_B = 1.380649 * (10 ** (0 - 23));   // Boltzmann constant
let E_CHARGE = 1.602176634 * (10 ** (0 - 19)); // elementary charge
let N_A = 6.02214076 * (10 ** 23);       // Avogadro constant
let R = 8.31446261815324;                // gas constant
let EPS0 = 8.8541878128 * (10 ** (0 - 12)); // vacuum permittivity
let MU0 = 1.25663706212 * (10 ** (0 - 6)); // vacuum permeability
let G0 = 9.80665;                        // standard gravity

let UNITS = map{
    m: 1, km: 1000, cm: 0.01, mm: 0.001, um: 0.000001, nm: 0.000000001,
    s: 1, ms: 0.001, us: 0.000001, min: 60, h: 3600,
    kg: 1, g: 0.001, mg: 0.000001,
    N: 1, J: 1, W: 1, Pa: 1,
    eV: 1.602176634 * (10 ** (0 - 19)),
    rad: 1, deg: 0.017453292519943295,
    L: 0.001, mL: 0.000001,
};

fn unit_factor(unit) {
    let f = try UNITS[unit] catch nil;
    if f == nil { return map{ ok: false, error: "unknown unit: " + str(unit) }; }
    return map{ ok: true, factor: f };
}

fn convert(value, from_unit, to_unit) {
    let a = unit_factor(from_unit);
    let b = unit_factor(to_unit);
    if not a.ok { return a; }
    if not b.ok { return b; }
    return map{ ok: true, value: value * a.factor / b.factor, from: from_unit, to: to_unit };
}

fn quantity(value, unit) { return map{ value: value, unit: unit }; }

fn q_convert(q, to_unit) {
    let r = convert(q.value, q.unit, to_unit);
    if not r.ok { return r; }
    return quantity(r.value, to_unit);
}

fn vec_add(a, b) {
    let out = [];
    let n = len(a); if len(b) < n { n = len(b); }
    let i = 0; while i < n { array_push(out, a[i] + b[i]); i = i + 1; }
    return out;
}

fn vec_sub(a, b) {
    let out = [];
    let n = len(a); if len(b) < n { n = len(b); }
    let i = 0; while i < n { array_push(out, a[i] - b[i]); i = i + 1; }
    return out;
}

fn vec_scale(a, s) {
    let out = [];
    let i = 0; while i < len(a) { array_push(out, a[i] * s); i = i + 1; }
    return out;
}

fn dot(a, b) {
    let n = len(a); if len(b) < n { n = len(b); }
    let s = 0;
    let i = 0; while i < n { s = s + a[i] * b[i]; i = i + 1; }
    return s;
}

fn norm(a) { return num_sqrt(dot(a, a)); }

fn distance(a, b) { return norm(vec_sub(a, b)); }

fn normalize(a) {
    let n = norm(a);
    if n == 0 { return a; }
    return vec_scale(a, 1 / n);
}

fn linear_motion(x0, v0, a, t) {
    return map{ x: x0 + v0 * t + 0.5 * a * t * t, v: v0 + a * t };
}

fn force(m, a) { return m * a; }
fn kinetic_energy(m, v) { return 0.5 * m * v * v; }
fn potential_energy(m, h, g = nil) {
    if g == nil { g = G0; }
    return m * g * h;
}
fn momentum(m, v) { return m * v; }
fn wavelength(freq) { return C / freq; }
fn frequency(lambda) { return C / lambda; }
fn photon_energy(freq) { return H * freq; }
fn ideal_gas_pressure(n_moles, temp_k, volume_m3) { return n_moles * R * temp_k / volume_m3; }

fn orbital_speed(mass, radius) { return num_sqrt(G * mass / radius); }
fn schwarzschild_radius(mass) { return 2 * G * mass / (C * C); }

fn moles_from_mass(mass_g, molar_mass_g_mol) { return mass_g / molar_mass_g_mol; }
fn mass_from_moles(moles, molar_mass_g_mol) { return moles * molar_mass_g_mol; }
fn concentration_molar(moles, volume_l) { return moles / volume_l; }
fn ph_from_h(h_concentration) { return 0 - (num_ln(h_concentration) / num_ln(10)); }
fn h_from_ph(ph) { return 10 ** (0 - ph); }

fn centroid(points) {
    if len(points) == 0 { return []; }
    let dims = len(points[0]);
    let out = [];
    let d = 0; while d < dims { array_push(out, 0); d = d + 1; }
    let i = 0;
    while i < len(points) {
        d = 0; while d < dims { out[d] = out[d] + points[i][d]; d = d + 1; }
        i = i + 1;
    }
    d = 0; while d < dims { out[d] = out[d] / len(points); d = d + 1; }
    return out;
}

fn bounding_box(points) {
    if len(points) == 0 { return map{ min: [], max: [] }; }
    let mn = [];
    let mx = [];
    let d = 0;
    while d < len(points[0]) { array_push(mn, points[0][d]); array_push(mx, points[0][d]); d = d + 1; }
    let i = 1;
    while i < len(points) {
        d = 0;
        while d < len(points[i]) {
            if points[i][d] < mn[d] { mn[d] = points[i][d]; }
            if points[i][d] > mx[d] { mx[d] = points[i][d]; }
            d = d + 1;
        }
        i = i + 1;
    }
    return map{ min: mn, max: mx };
}

fn moving_average(xs, window) {
    if window < 1 { window = 1; }
    let out = [];
    let i = 0;
    while i < len(xs) {
        let start = i - window + 1;
        if start < 0 { start = 0; }
        let s = 0;
        let n = 0;
        let j = start;
        while j <= i { s = s + xs[j]; n = n + 1; j = j + 1; }
        array_push(out, s / n);
        i = i + 1;
    }
    return out;
}

fn derivative(samples, dt = 1) {
    let out = [];
    let i = 1;
    while i < len(samples) { array_push(out, (samples[i] - samples[i - 1]) / dt); i = i + 1; }
    return out;
}

fn integrate_trapezoid(samples, dt = 1) {
    if len(samples) < 2 { return 0; }
    let area = 0;
    let i = 1;
    while i < len(samples) {
        area = area + 0.5 * (samples[i - 1] + samples[i]) * dt;
        i = i + 1;
    }
    return area;
}

fn experiment(name, columns, rows, meta = nil) {
    if meta == nil { meta = map{}; }
    return map{ format: "pblang.science.experiment.v1", name: name, columns: columns, rows: rows, meta: meta };
}

fn column(exp, name) {
    let idx = 0 - 1;
    let i = 0;
    while i < len(exp.columns) { if exp.columns[i] == name { idx = i; } i = i + 1; }
    if idx < 0 { return []; }
    let out = [];
    i = 0;
    while i < len(exp.rows) { array_push(out, exp.rows[i][idx]); i = i + 1; }
    return out;
}

let constants = map{ c: C, G: G, h: H, hbar: HBAR, k_B: K_B, e: E_CHARGE, N_A: N_A, R: R, eps0: EPS0, mu0: MU0, g0: G0 };
let units = map{ factor: unit_factor, convert: convert, quantity: quantity, q_convert: q_convert };
let vector = map{ add: vec_add, sub: vec_sub, scale: vec_scale, dot: dot, norm: norm, distance: distance, normalize: normalize };
let physics = map{ linear_motion: linear_motion, force: force, kinetic_energy: kinetic_energy, potential_energy: potential_energy, momentum: momentum, wavelength: wavelength, frequency: frequency, photon_energy: photon_energy, ideal_gas_pressure: ideal_gas_pressure, orbital_speed: orbital_speed, schwarzschild_radius: schwarzschild_radius };
let chemistry = map{ moles_from_mass: moles_from_mass, mass_from_moles: mass_from_moles, concentration_molar: concentration_molar, ph_from_h: ph_from_h, h_from_ph: h_from_ph };
let geometry = map{ centroid: centroid, bounding_box: bounding_box };
let signal = map{ moving_average: moving_average, derivative: derivative, integrate_trapezoid: integrate_trapezoid };

export C, G, H, HBAR, K_B, E_CHARGE, N_A, R, EPS0, MU0, G0, constants;
export UNITS, units, unit_factor, convert, quantity, q_convert;
export vector, vec_add, vec_sub, vec_scale, dot, norm, distance, normalize;
export physics, linear_motion, force, kinetic_energy, potential_energy, momentum;
export wavelength, frequency, photon_energy, ideal_gas_pressure, orbital_speed, schwarzschild_radius;
export chemistry, moles_from_mass, mass_from_moles, concentration_molar, ph_from_h, h_from_ph;
export geometry, centroid, bounding_box, signal, moving_average, derivative, integrate_trapezoid;
export experiment, column;
