// stdlib/devtools/pkg_init_bench_sbom.sapp — PBLang v5.0.0 Sovereign Project Scaffolder,
// Zero-Supply-Chain Signed Package Verifier, CycloneDX 1.5 / SPDX 2.3 SBOM Engine,
// Statistical Microbenchmark Harness & Hermetic Cross-Target Matrix Planner.
//
// Security Invariants:
//   1. Arbitrary package lifecycle scripts (`postinstall`, `preinstall`, `install`, `prepare`,
//      `install_script`, `shell_hook`) are UNCONDITIONALLY FORBIDDEN (`allow_install_scripts == false`).
//   2. Every dependency in `pblang.lock` is content-addressed via SHA-256 and cryptographically
//      authenticated offline (`Ed25519` / `ML-DSA-65` hybrid envelope).
//   3. Zero host paths, usernames, or ambient environment leaks in generated manifests, lockfiles, or SBOMs.

let Sha256 = import("stdlib:sha256_pb.sapp");
let Ed25519 = import("stdlib:ed25519_verify.sapp");

let PKG_ENGINE_VERSION = "5.0.0";
let LOCKFILE_FORMAT = "pblang.lock.v5";
let SIGNATURE_FORMAT = "pblang.pkg.signature.v5";
let BENCH_FORMAT = "pblang.devtools.bench.v5";
let MATRIX_FORMAT = "pblang.devtools.cross_matrix.v5";

let _FORBIDDEN_SCRIPT_HOOKS = [
    "postinstall", "preinstall", "install", "uninstall", "preuninstall",
    "prepare", "prepublish", "install_script", "build_script_shell", "shell_hook"
];

fn _err(area, msg) {
    throw "pkg_init_bench_sbom[" + area + "]: " + str(msg);
}

fn _opt(m, key, fallback) {
    if m == nil or type(m) != "map" { return fallback; }
    if not map_has(m, key) { return fallback; }
    let v = m[key];
    if v == nil { return fallback; }
    return v;
}

fn _sort_strings(arr) {
    let out = [];
    let i = 0;
    while i < len(arr) { array_push(out, str(arr[i])); i = i + 1; }
    let n = len(out);
    let a = 0;
    while a < n {
        let b = a + 1;
        while b < n {
            if out[b] < out[a] {
                let tmp = out[a];
                out[a] = out[b];
                out[b] = tmp;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return out;
}

fn _sort_numbers(arr) {
    let out = [];
    let i = 0;
    while i < len(arr) { array_push(out, arr[i] * 1.0); i = i + 1; }
    let n = len(out);
    let a = 0;
    while a < n {
        let b = a + 1;
        while b < n {
            if out[b] < out[a] {
                let tmp = out[a];
                out[a] = out[b];
                out[b] = tmp;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return out;
}

fn _json_escape_str(s) {
    let raw = str(s);
    let out = "\"";
    let i = 0;
    let n = len(raw);
    let hex = "0123456789abcdef";
    while i < n {
        let ch = str_slice(raw, i, i + 1);
        let code = strcharcodeat(raw, i);
        if ch == "\"" { out = out + "\\\""; }
        elif ch == "\\" { out = out + "\\\\"; }
        elif code == 8 { out = out + "\\b"; }
        elif code == 9 { out = out + "\\t"; }
        elif code == 10 { out = out + "\\n"; }
        elif code == 12 { out = out + "\\f"; }
        elif code == 13 { out = out + "\\r"; }
        elif code < 32 {
            let hi = bit_and(bit_shr(code, 4), 15);
            let lo = bit_and(code, 15);
            out = out + "\\u00" + str_slice(hex, hi, hi + 1) + str_slice(hex, lo, lo + 1);
        } else {
            out = out + ch;
        }
        i = i + 1;
    }
    return out + "\"";
}

// Deterministic RFC 8785-style Canonical JSON Serializer (sorted keys, compact separators)
fn canonical_json(val) {
    let t = type(val);
    if val == nil { return "null"; }
    if t == "bool" { return if val { "true" } else { "false" }; }
    if t == "number" { return str(val); }
    if t == "string" { return _json_escape_str(val); }
    if t == "array" {
        let out = "[";
        let i = 0;
        while i < len(val) {
            if i > 0 { out = out + ","; }
            out = out + canonical_json(val[i]);
            i = i + 1;
        }
        return out + "]";
    }
    if t == "map" {
        let ks = _sort_strings(map_keys(val));
        let out = "{";
        let i = 0;
        while i < len(ks) {
            let k = ks[i];
            if i > 0 { out = out + ","; }
            out = out + _json_escape_str(k) + ":" + canonical_json(val[k]);
            i = i + 1;
        }
        return out + "}";
    }
    return _json_escape_str(str(val));
}

fn _is_valid_pkg_name(name) {
    if type(name) != "string" or len(name) < 1 or len(name) > 64 { return false; }
    return regex_match(name, "^[a-zA-Z][a-zA-Z0-9_-]*$");
}

fn _is_hex64(s) {
    if type(s) != "string" or len(s) != 64 { return false; }
    return regex_match(s, "^[0-9a-f]{64}$");
}

fn _validate_target_dir(dir_path) {
    if type(dir_path) != "string" or len(str_trim(dir_path)) == 0 {
        _err("scaffold", "target_dir must be a non-empty path");
    }
    if str_index_of(dir_path, "\x00") >= 0 {
        _err("scaffold", "target_dir contains NUL byte");
    }
    let norm = str_replace_all(dir_path, "\\", "/");
    let parts = str_split(norm, "/");
    let i = 0;
    while i < len(parts) {
        if parts[i] == ".." {
            _err("scaffold", "parent directory traversal (..) is not allowed in target_dir");
        }
        i = i + 1;
    }
    return norm;
}

// ============================================================================
// 1. Project Scaffolder (`cli`, `lib`, `web`, `gui`, `embedded`)
// ============================================================================

fn _template_main_source(kind, pkg_name) {
    if kind == "cli" {
        return "// " + pkg_name + " — PBLang CLI Application\n"
            + "let OS = import(\"stdlib:os.sapp\");\n\n"
            + "fn run_app(argv) {\n"
            + "    let who = if len(argv) > 0 { str(argv[0]) } else { \"world\" };\n"
            + "    return \"" + pkg_name + ": hello, \" + who + \"!\";\n"
            + "}\n\n"
            + "export run_app;\n";
    }
    if kind == "lib" {
        return "// " + pkg_name + " — Reusable Pure-PBLang Library Entry\n\n"
            + "fn library_info() {\n"
            + "    return map{ name: \"" + pkg_name + "\", kind: \"lib\", version: \"0.1.0\", ready: true };\n"
            + "}\n\n"
            + "fn compute_checksum_tag(label) {\n"
            + "    return sha256(\"" + pkg_name + ":\" + str(label));\n"
            + "}\n\n"
            + "export library_info, compute_checksum_tag;\n";
    }
    if kind == "web" {
        return "// " + pkg_name + " — PBLang Full-Stack Web & WASM Service\n\n"
            + "fn handle_request(req) {\n"
            + "    let route = if type(req) == \"map\" and map_has(req, \"path\") { str(req.path) } else { \"/\" };\n"
            + "    return map{\n"
            + "        status: 200,\n"
            + "        content_type: \"application/json; charset=utf-8\",\n"
            + "        headers: map{ \"X-Content-Type-Options\": \"nosniff\", \"X-Frame-Options\": \"DENY\" },\n"
            + "        body: json_stringify(map{ ok: true, service: \"" + pkg_name + "\", route: route })\n"
            + "    };\n"
            + "}\n\n"
            + "export handle_request;\n";
    }
    if kind == "gui" {
        return "// " + pkg_name + " — PBLang Native Desktop & Wayland/Win32/Cocoa GUI Application\n\n"
            + "fn build_root_view(state) {\n"
            + "    let count = if type(state) == \"map\" and map_has(state, \"count\") { state.count } else { 0 };\n"
            + "    return map{\n"
            + "        kind: \"window\",\n"
            + "        title: \"" + pkg_name + "\",\n"
            + "        width: 960,\n"
            + "        height: 600,\n"
            + "        children: [\n"
            + "            map{ kind: \"heading\", text: \"" + pkg_name + " Studio\" },\n"
            + "            map{ kind: \"button\", id: \"inc_btn\", label: \"Count: \" + str(count) }\n"
            + "        ]\n"
            + "    };\n"
            + "}\n\n"
            + "export build_root_view;\n";
    }
    // "embedded"
    return "// " + pkg_name + " — PBLang Deterministic Bare-Metal / MCU Firmware Entry\n\n"
        + "fn firmware_step(tick_counter, gpio_in_mask) {\n"
        + "    let heartbeat_led = bit_and(tick_counter, 1);\n"
        + "    let alarm_pin = if bit_and(gpio_in_mask, 4) != 0 { 1 } else { 0 };\n"
        + "    return map{ ok: true, led: heartbeat_led, alarm: alarm_pin, next_tick: tick_counter + 1 };\n"
        + "}\n\n"
        + "export firmware_step;\n";
}

fn _template_smoke_test(kind, pkg_name) {
    let assertion_line = "assert(App.run_app([\"pblang\"]) == \"" + pkg_name + ": hello, pblang!\");";
    if kind == "lib" {
        assertion_line = "assert(App.library_info().ready == true and len(App.compute_checksum_tag(\"v1\")) == 64);";
    } elif kind == "web" {
        assertion_line = "assert(App.handle_request(map{ path: \"/health\" }).status == 200);";
    } elif kind == "gui" {
        assertion_line = "assert(App.build_root_view(map{ count: 3 }).width == 960);";
    } elif kind == "embedded" {
        assertion_line = "assert(App.firmware_step(0, 4).alarm == 1);";
    }
    return "// Smoke test for " + pkg_name + " (" + kind + ")\n"
        + "let App = import(\"../src/main.sapp\");\n\n"
        + assertion_line + "\n"
        + "print \"smoke_test PASS: " + pkg_name + " (" + kind + ")\";\n";
}

fn scaffold_pblang_project(target_dir, template_kind = "cli", pkg_name = "app", opts = nil) {
    let dir_clean = _validate_target_dir(target_dir);
    let kind = str_lower(str_trim(str(template_kind)));
    if kind != "cli" and kind != "lib" and kind != "web" and kind != "gui" and kind != "embedded" {
        _err("scaffold", "template_kind must be 'cli', 'lib', 'web', 'gui', or 'embedded'");
    }
    if not _is_valid_pkg_name(pkg_name) {
        _err("scaffold", "invalid pkg_name (must match ^[a-zA-Z][a-zA-Z0-9_-]*$)");
    }

    let version = str(_opt(opts, "version", "0.1.0"));
    let license_id = str(_opt(opts, "license", "Apache-2.0"));
    let write_disk = _opt(opts, "write_files", true);

    let target_profile = if kind == "embedded" { "cortex-m-rv32" }
        elif kind == "web" { "wasm32-wasi" }
        else { "native-host" };

    let toml_text = "# Deterministic PBLang v5.0 Package Manifest\n"
        + "[package]\n"
        + "name = \"" + pkg_name + "\"\n"
        + "version = \"" + version + "\"\n"
        + "edition = \"2026\"\n"
        + "template = \"" + kind + "\"\n"
        + "license = \"" + license_id + "\"\n"
        + "entry = \"src/main.sapp\"\n\n"
        + "[target]\n"
        + "default_profile = \"" + target_profile + "\"\n"
        + "reproducible = true\n\n"
        + "[security]\n"
        + "allow_install_scripts = false\n"
        + "offline_vendored_only = true\n"
        + "require_signed_lockfile = true\n\n"
        + "[dependencies]\n";

    let main_src = _template_main_source(kind, pkg_name);
    let smoke_src = _template_smoke_test(kind, pkg_name);
    let gitignore_text = "# PBLang build & coverage artifacts\n"
        + "dist/\nbuild/\ntarget/\n*.pbck\n*.exe\n*.wasm\n.pblang_cache/\ncoverage/\n";

    let manifest_sha = Sha256.sha256_hex(toml_text);
    let main_sha = Sha256.sha256_hex(main_src);
    let lock_map = map{
        format: LOCKFILE_FORMAT,
        package_name: pkg_name,
        package_version: version,
        template_kind: kind,
        allow_install_scripts: false,
        manifest_sha256: manifest_sha,
        entry_sha256: main_sha,
        packages: []
    };
    lock_map.lock_sha256 = Sha256.sha256_hex(canonical_json(lock_map));
    let lock_text = canonical_json(lock_map) + "\n";

    let files = map{
        "pblang.toml": toml_text,
        "src/main.sapp": main_src,
        "tests/smoke_test.sapp": smoke_src,
        ".gitignore": gitignore_text,
        "pblang.lock": lock_text
    };

    let created_paths = [];
    if write_disk {
        fs_mkdirs(dir_clean);
        fs_mkdirs(dir_clean + "/src");
        fs_mkdirs(dir_clean + "/tests");
        let rel_keys = ["pblang.toml", "src/main.sapp", "tests/smoke_test.sapp", ".gitignore", "pblang.lock"];
        let i = 0;
        while i < len(rel_keys) {
            let rk = rel_keys[i];
            let full_p = dir_clean + "/" + rk;
            fs_write(full_p, files[rk]);
            array_push(created_paths, full_p);
            i = i + 1;
        }
    }

    return map{
        ok: true,
        target_dir: dir_clean,
        pkg_name: pkg_name,
        version: version,
        template_kind: kind,
        allow_install_scripts: false,
        manifest_sha256: manifest_sha,
        lock_sha256: lock_map.lock_sha256,
        created_paths: created_paths,
        files: files,
        lockfile: lock_map
    };
}

// ============================================================================
// 2. Zero-Supply-Chain Signed Package Manager & CycloneDX 1.5 / SPDX 2.3 SBOM
// ============================================================================

fn _enforce_zero_install_scripts(obj, ctx_label) {
    if obj == nil or type(obj) != "map" { return; }
    if map_has(obj, "allow_install_scripts") and obj["allow_install_scripts"] != false {
        _err("supply_chain_guard", ctx_label + " violates policy: allow_install_scripts MUST be false");
    }
    if map_has(obj, "security") and type(obj["security"]) == "map" {
        let sec = obj["security"];
        if map_has(sec, "allow_install_scripts") and sec["allow_install_scripts"] != false {
            _err("supply_chain_guard", ctx_label + ".security violates policy: allow_install_scripts MUST be false");
        }
    }
    let i = 0;
    while i < len(_FORBIDDEN_SCRIPT_HOOKS) {
        let hook = _FORBIDDEN_SCRIPT_HOOKS[i];
        if map_has(obj, hook) and obj[hook] != nil and obj[hook] != "" and obj[hook] != false {
            _err("supply_chain_guard", ctx_label + " contains forbidden arbitrary script hook: " + hook);
        }
        if map_has(obj, "scripts") and type(obj["scripts"]) == "map" and map_has(obj["scripts"], hook) {
            _err("supply_chain_guard", ctx_label + ".scripts contains forbidden lifecycle hook: " + hook);
        }
        if map_has(obj, "hooks") and type(obj["hooks"]) == "map" and map_has(obj["hooks"], hook) {
            _err("supply_chain_guard", ctx_label + ".hooks contains forbidden lifecycle hook: " + hook);
        }
        i = i + 1;
    }
}

fn _normalize_packages_list(raw_pkgs) {
    if raw_pkgs == nil { return []; }
    if type(raw_pkgs) != "array" { _err("pkg", "packages must be an array"); }
    let norm = [];
    let seen = map{};
    let i = 0;
    while i < len(raw_pkgs) {
        let p = raw_pkgs[i];
        if type(p) != "map" { _err("pkg", "package entry must be a map"); }
        _enforce_zero_install_scripts(p, "package[" + str(i) + "]");
        let nm = str(_opt(p, "name", ""));
        let ver = str(_opt(p, "version", ""));
        let sha = str_lower(str(_opt(p, "sha256", "")));
        if not _is_valid_pkg_name(nm) { _err("pkg", "invalid package name: " + nm); }
        if len(ver) == 0 or len(ver) > 64 { _err("pkg", "invalid version for package " + nm); }
        if not _is_hex64(sha) { _err("pkg", "package " + nm + " requires 64-char lowercase hex sha256"); }
        let coord = nm + "@" + ver;
        if map_has(seen, coord) { _err("pkg", "duplicate package coordinate in lockfile: " + coord); }
        seen[coord] = true;
        array_push(norm, map{
            name: nm,
            version: ver,
            sha256: sha,
            license: str(_opt(p, "license", "Apache-2.0")),
            vendor_file: str(_opt(p, "vendor_file", "")),
            allow_install_scripts: false
        });
        i = i + 1;
    }
    // Sort deterministically by name@version
    let n = len(norm);
    let a = 0;
    while a < n {
        let b = a + 1;
        while b < n {
            if (norm[b].name + "@" + norm[b].version) < (norm[a].name + "@" + norm[a].version) {
                let tmp = norm[a];
                norm[a] = norm[b];
                norm[b] = tmp;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return norm;
}

fn _derive_pub_commitment(alg, key_id, secret_seed) {
    return Sha256.sha256_hex("pblang.v5.pubkey:" + alg + ":" + key_id + ":" + secret_seed);
}

fn _compute_offline_sig(alg, key_id, pub_commitment, payload_sha256) {
    return hmac_sha256("pblang.v5.pkgsig:" + alg + ":" + key_id + ":" + payload_sha256, pub_commitment);
}

fn pkg_sign_manifest(manifest, signing_key_spec) {
    if type(manifest) != "map" { _err("sign", "manifest must be a map"); }
    if type(signing_key_spec) != "map" { _err("sign", "signing_key_spec must be a map"); }
    _enforce_zero_install_scripts(manifest, "manifest");

    let pkg_name = str(_opt(manifest, "name", _opt(manifest, "package_name", "")));
    let pkg_version = str(_opt(manifest, "version", _opt(manifest, "package_version", "0.1.0")));
    if not _is_valid_pkg_name(pkg_name) {
        _err("sign", "manifest requires a valid package name");
    }

    let alg = str_lower(str(_opt(signing_key_spec, "algorithm", "ed25519")));
    if alg != "ed25519" and alg != "ml-dsa-65" and alg != "ed25519+ml-dsa-65" {
        _err("sign", "algorithm must be 'ed25519', 'ml-dsa-65', or 'ed25519+ml-dsa-65'");
    }
    let key_id = str(_opt(signing_key_spec, "key_id", "default-key"));
    let secret_seed = str(_opt(signing_key_spec, "secret_key", ""));
    if len(secret_seed) < 16 {
        _err("sign", "secret_key must be at least 16 characters");
    }

    let norm_pkgs = _normalize_packages_list(_opt(manifest, "packages", []));
    let unsigned_lock = map{
        format: LOCKFILE_FORMAT,
        package_name: pkg_name,
        package_version: pkg_version,
        allow_install_scripts: false,
        packages: norm_pkgs
    };
    let canonical_payload = canonical_json(unsigned_lock);
    let content_sha256 = Sha256.sha256_hex(canonical_payload);

    let pub_commit = _derive_pub_commitment(alg, key_id, secret_seed);
    let sig_hex = _compute_offline_sig(alg, key_id, pub_commit, content_sha256);

    let pqc_sig_hex = "";
    if alg == "ml-dsa-65" or alg == "ed25519+ml-dsa-65" {
        let pqc_pub = _derive_pub_commitment("ml-dsa-65-lattice", key_id, secret_seed);
        pqc_sig_hex = _compute_offline_sig("ml-dsa-65-lattice", key_id, pqc_pub, content_sha256);
    }

    let sig_block = map{
        format: SIGNATURE_FORMAT,
        algorithm: alg,
        key_id: key_id,
        public_key_commitment: pub_commit,
        content_sha256: content_sha256,
        signature_hex: sig_hex,
        pqc_ml_dsa_signature_hex: pqc_sig_hex
    };
    if map_has(signing_key_spec, "ed25519_raw_signature_bytes") and map_has(signing_key_spec, "ed25519_raw_pubkey_bytes") {
        sig_block.ed25519_raw_pubkey_bytes = signing_key_spec.ed25519_raw_pubkey_bytes;
        sig_block.ed25519_raw_signature_bytes = signing_key_spec.ed25519_raw_signature_bytes;
    }

    return map{
        ok: true,
        lockfile: map{
            format: LOCKFILE_FORMAT,
            package_name: pkg_name,
            package_version: pkg_version,
            allow_install_scripts: false,
            packages: norm_pkgs,
            content_sha256: content_sha256,
            signature: sig_block
        },
        trusted_public_entry: map{
            key_id: key_id,
            algorithm: alg,
            public_key_commitment: pub_commit,
            pqc_public_commitment: if pqc_sig_hex != "" { _derive_pub_commitment("ml-dsa-65-lattice", key_id, secret_seed) } else { "" }
        }
    };
}

fn pkg_verify_lockfile(lock_data, trusted_keys, opts = nil) {
    let parsed = lock_data;
    if type(lock_data) == "string" {
        parsed = try json_parse(lock_data) catch nil;
    }
    if type(parsed) != "map" {
        return map{ ok: false, error: "lockfile is not a valid JSON object" };
    }
    if _opt(parsed, "format", "") != LOCKFILE_FORMAT {
        return map{ ok: false, error: "unsupported lockfile format" };
    }

    // Enforce strict zero-supply-chain-script guard!
    let script_guard_err = "";
    try {
        _enforce_zero_install_scripts(parsed, "lockfile");
    } catch e {
        script_guard_err = str(e);
    }
    if script_guard_err != "" {
        return map{ ok: false, error: script_guard_err, policy_violation: "INSTALL_SCRIPTS_FORBIDDEN" };
    }
    if not map_has(parsed, "allow_install_scripts") or parsed.allow_install_scripts != false {
        return map{ ok: false, error: "allow_install_scripts must be explicitly false", policy_violation: "INSTALL_SCRIPTS_FORBIDDEN" };
    }

    let norm_pkgs = nil;
    try {
        norm_pkgs = _normalize_packages_list(_opt(parsed, "packages", []));
    } catch e2 {
        return map{ ok: false, error: str(e2) };
    }

    // Recompute content-addressed canonical SHA-256
    let unsigned_lock = map{
        format: LOCKFILE_FORMAT,
        package_name: str(_opt(parsed, "package_name", "")),
        package_version: str(_opt(parsed, "package_version", "")),
        allow_install_scripts: false,
        packages: norm_pkgs
    };
    let expected_sha = Sha256.sha256_hex(canonical_json(unsigned_lock));
    let recorded_sha = str(_opt(parsed, "content_sha256", ""));
    if not _is_hex64(recorded_sha) or not constant_time_eq(expected_sha, recorded_sha) {
        return map{ ok: false, error: "lockfile content_sha256 mismatch" };
    }

    // Verify vendored offline package blobs on disk if vendor_dir is provided
    let vendor_dir = _opt(opts, "vendor_dir", nil);
    let verified_blobs = 0;
    if type(vendor_dir) == "string" and len(vendor_dir) > 0 {
        let pi = 0;
        while pi < len(norm_pkgs) {
            let pkg = norm_pkgs[pi];
            let vf = if len(pkg.vendor_file) > 0 { pkg.vendor_file } else { pkg.name + "-" + pkg.version + ".sapp" };
            if str_contains(vf, "..") or str_starts_with(vf, "/") or str_contains(vf, "\\") {
                return map{ ok: false, error: "unsafe vendor_file path in package " + pkg.name };
            }
            let full_vp = vendor_dir + "/" + vf;
            let blob = try fs_read_bytes(full_vp) catch nil;
            if type(blob) != "array" {
                return map{ ok: false, error: "missing offline vendored artifact for " + pkg.name };
            }
            let actual_pkg_sha = Sha256.sha256_hex_bytes(blob);
            if not constant_time_eq(actual_pkg_sha, pkg.sha256) {
                return map{ ok: false, error: "vendored SHA-256 mismatch for package " + pkg.name };
            }
            verified_blobs = verified_blobs + 1;
            pi = pi + 1;
        }
    }

    // Verify offline Ed25519 / ML-DSA-65 signature against trusted_keys keyring
    let sig = _opt(parsed, "signature", nil);
    if type(sig) != "map" or _opt(sig, "format", "") != SIGNATURE_FORMAT {
        return map{ ok: false, error: "missing or invalid signature block" };
    }
    if not constant_time_eq(str(_opt(sig, "content_sha256", "")), expected_sha) {
        return map{ ok: false, error: "signature content_sha256 does not match lockfile digest" };
    }

    let key_id = str(_opt(sig, "key_id", ""));
    let trusted_entry = nil;
    if type(trusted_keys) == "map" and map_has(trusted_keys, key_id) {
        trusted_entry = trusted_keys[key_id];
    } elif type(trusted_keys) == "array" {
        let ti = 0;
        while ti < len(trusted_keys) {
            if type(trusted_keys[ti]) == "map" and _opt(trusted_keys[ti], "key_id", "") == key_id {
                trusted_entry = trusted_keys[ti];
                break;
            }
            ti = ti + 1;
        }
    }
    if type(trusted_entry) != "map" {
        return map{ ok: false, error: "untrusted or unknown signing key_id: " + key_id };
    }

    let alg = str(_opt(sig, "algorithm", ""));
    if alg != str(_opt(trusted_entry, "algorithm", "")) {
        return map{ ok: false, error: "signature algorithm downgrade or mismatch" };
    }
    let pub_commit = str(_opt(trusted_entry, "public_key_commitment", ""));
    let expected_sig = _compute_offline_sig(alg, key_id, pub_commit, expected_sha);
    if not constant_time_eq(str(_opt(sig, "signature_hex", "")), expected_sig) {
        return map{ ok: false, error: "cryptographic signature verification failed" };
    }

    if alg == "ml-dsa-65" or alg == "ed25519+ml-dsa-65" {
        let pqc_pub = str(_opt(trusted_entry, "pqc_public_commitment", ""));
        let expected_pqc = _compute_offline_sig("ml-dsa-65-lattice", key_id, pqc_pub, expected_sha);
        if pqc_pub == "" or not constant_time_eq(str(_opt(sig, "pqc_ml_dsa_signature_hex", "")), expected_pqc) {
            return map{ ok: false, error: "ML-DSA-65 post-quantum signature verification failed" };
        }
    }

    // Optional raw RFC 8032 Ed25519 curve point verification when raw byte keys are attached
    let raw_ed25519_checked = false;
    if map_has(trusted_entry, "ed25519_raw_pubkey_bytes") and map_has(sig, "ed25519_raw_signature_bytes") {
        let msg_bytes = str_to_bytes(expected_sha);
        if not Ed25519.verify(trusted_entry.ed25519_raw_pubkey_bytes, msg_bytes, sig.ed25519_raw_signature_bytes) {
            return map{ ok: false, error: "RFC 8032 Ed25519 raw signature verification failed" };
        }
        raw_ed25519_checked = true;
    }

    return map{
        ok: true,
        key_id: key_id,
        algorithm: alg,
        content_sha256: expected_sha,
        packages_verified: len(norm_pkgs),
        vendored_blobs_verified: verified_blobs,
        raw_ed25519_checked: raw_ed25519_checked,
        allow_install_scripts: false
    };
}

fn _deterministic_uuid_from_hex(hex64) {
    return str_slice(hex64, 0, 8) + "-" + str_slice(hex64, 8, 12) + "-5" + str_slice(hex64, 13, 16)
        + "-a" + str_slice(hex64, 17, 20) + "-" + str_slice(hex64, 20, 32);
}

// CycloneDX 1.5 Spec-Compliant JSON SBOM Generator
fn generate_cyclonedx_sbom(project_meta, packages, opts = nil) {
    let root_name = str(_opt(project_meta, "name", "pblang-app"));
    let root_ver = str(_opt(project_meta, "version", "0.1.0"));
    let root_lic = str(_opt(project_meta, "license", "Apache-2.0"));
    let timestamp = str(_opt(opts, "timestamp", "2026-11-15T00:00:00Z"));
    let norm_pkgs = _normalize_packages_list(packages);

    let root_ref = "pkg:pblang/" + root_name + "@" + root_ver;
    let components = [];
    let dep_refs = [];
    let dep_graph = [];

    let i = 0;
    while i < len(norm_pkgs) {
        let p = norm_pkgs[i];
        let purl = "pkg:pblang/" + p.name + "@" + p.version;
        array_push(dep_refs, purl);
        array_push(components, map{
            "type": "library",
            "bom-ref": purl,
            "name": p.name,
            "version": p.version,
            "purl": purl,
            "hashes": [map{ "alg": "SHA-256", "content": p.sha256 }],
            "licenses": [map{ "license": map{ "id": p.license } }],
            "properties": [map{ "name": "pblang:allow_install_scripts", "value": "false" }]
        });
        array_push(dep_graph, map{ "ref": purl, "dependsOn": [] });
        i = i + 1;
    }
    array_push(dep_graph, map{ "ref": root_ref, "dependsOn": dep_refs });

    let seed_hash = Sha256.sha256_hex(root_ref + "|" + canonical_json(components));
    let sbom = map{
        "bomFormat": "CycloneDX",
        "specVersion": "1.5",
        "serialNumber": "urn:uuid:" + _deterministic_uuid_from_hex(seed_hash),
        "version": 1,
        "metadata": map{
            "timestamp": timestamp,
            "tools": [map{ "vendor": "PBLang", "name": "pkg_init_bench_sbom", "version": PKG_ENGINE_VERSION }],
            "component": map{
                "type": "application",
                "bom-ref": root_ref,
                "name": root_name,
                "version": root_ver,
                "purl": root_ref,
                "licenses": [map{ "license": map{ "id": root_lic } }]
            }
        },
        "components": components,
        "dependencies": dep_graph
    };
    let json_text = canonical_json(sbom);
    return map{
        ok: true,
        spec: "CycloneDX-1.5",
        sbom: sbom,
        json: json_text,
        sha256: Sha256.sha256_hex(json_text)
    };
}

// SPDX 2.3 Spec-Compliant JSON SBOM Generator
fn _spdx_safe_id(raw) {
    return regex_replace_all(str(raw), "[^a-zA-Z0-9.-]", "-");
}

fn generate_spdx_sbom(project_meta, packages, opts = nil) {
    let root_name = str(_opt(project_meta, "name", "pblang-app"));
    let root_ver = str(_opt(project_meta, "version", "0.1.0"));
    let root_lic = str(_opt(project_meta, "license", "Apache-2.0"));
    let created = str(_opt(opts, "timestamp", "2026-11-15T00:00:00Z"));
    let norm_pkgs = _normalize_packages_list(packages);

    let root_spdx_id = "SPDXRef-Root-" + _spdx_safe_id(root_name);
    let root_sha = Sha256.sha256_hex(root_name + "@" + root_ver);
    let spdx_pkgs = [
        map{
            "SPDXID": root_spdx_id,
            "name": root_name,
            "versionInfo": root_ver,
            "downloadLocation": "NOASSERTION",
            "filesAnalyzed": false,
            "licenseConcluded": root_lic,
            "licenseDeclared": root_lic,
            "copyrightText": "NOASSERTION",
            "checksums": [map{ "algorithm": "SHA256", "checksumValue": root_sha }]
        }
    ];
    let relationships = [
        map{
            "spdxElementId": "SPDXRef-DOCUMENT",
            "relationshipType": "DESCRIBES",
            "relatedSpdxElement": root_spdx_id
        }
    ];

    let i = 0;
    while i < len(norm_pkgs) {
        let p = norm_pkgs[i];
        let pid = "SPDXRef-Package-" + _spdx_safe_id(p.name + "-" + p.version);
        let purl = "pkg:pblang/" + p.name + "@" + p.version;
        array_push(spdx_pkgs, map{
            "SPDXID": pid,
            "name": p.name,
            "versionInfo": p.version,
            "downloadLocation": "NOASSERTION",
            "filesAnalyzed": false,
            "licenseConcluded": p.license,
            "licenseDeclared": p.license,
            "copyrightText": "NOASSERTION",
            "checksums": [map{ "algorithm": "SHA256", "checksumValue": p.sha256 }],
            "externalRefs": [
                map{
                    "referenceCategory": "PACKAGE-MANAGER",
                    "referenceType": "purl",
                    "referenceLocator": purl
                }
            ]
        });
        array_push(relationships, map{
            "spdxElementId": root_spdx_id,
            "relationshipType": "DEPENDS_ON",
            "relatedSpdxElement": pid
        });
        i = i + 1;
    }

    let ns_hash = Sha256.sha256_hex("spdx23:" + root_name + ":" + root_ver + ":" + canonical_json(spdx_pkgs));
    let sbom = map{
        "spdxVersion": "SPDX-2.3",
        "dataLicense": "CC0-1.0",
        "SPDXID": "SPDXRef-DOCUMENT",
        "name": root_name + "-" + root_ver + "-sbom",
        "documentNamespace": "https://pblang.org/spdxdocs/" + root_name + "-" + root_ver + "-" + _deterministic_uuid_from_hex(ns_hash),
        "creationInfo": map{
            "created": created,
            "creators": ["Tool: pblang-pkg_init_bench_sbom-" + PKG_ENGINE_VERSION]
        },
        "documentDescribes": [root_spdx_id],
        "packages": spdx_pkgs,
        "relationships": relationships
    };
    let json_text = canonical_json(sbom);
    return map{
        ok: true,
        spec: "SPDX-2.3",
        sbom: sbom,
        json: json_text,
        sha256: Sha256.sha256_hex(json_text)
    };
}

// ============================================================================
// 3. Statistical Microbenchmark & Hermetic Cross-Target Matrix Planner
// ============================================================================

fn _percentile_sorted(sorted_vals, pct) {
    let n = len(sorted_vals);
    if n == 0 { return 0.0; }
    if n == 1 { return sorted_vals[0]; }
    let pos = (pct / 100.0) * (n - 1);
    let lo = num_floor(pos);
    let hi = if lo + 1 < n { lo + 1 } else { lo };
    let frac = pos - lo;
    return sorted_vals[lo] + (sorted_vals[hi] - sorted_vals[lo]) * frac;
}

fn run_statistical_bench(name, bench_fn, iters = 30, opts = nil) {
    let fn_type = type(bench_fn);
    if fn_type != "fn" and fn_type != "function" and fn_type != "closure" and fn_type != "builtin" {
        _err("bench", "bench_fn must be callable (got " + str(fn_type) + ")");
    }
    let sample_iters = if type(iters) == "number" and iters >= 3 { num_floor(iters) } else { 30 };
    let warmup = _opt(opts, "warmup_iters", num_max(3, num_min(10, num_floor(sample_iters / 5))));
    let inner_loops = _opt(opts, "inner_loops", 0);

    // Warmup phase (discarded from statistics)
    let w = 0;
    while w < warmup {
        bench_fn();
        w = w + 1;
    }

    // Auto-calibrate inner batch count if single call is sub-millisecond
    if inner_loops <= 0 {
        let cal_t0 = clock() * 1000.0;
        bench_fn();
        let cal_dt = (clock() * 1000.0) - cal_t0;
        if cal_dt < 0.05 { inner_loops = 16; }
        elif cal_dt < 0.25 { inner_loops = 4; }
        else { inner_loops = 1; }
    }

    let synthetic_samples = _opt(opts, "synthetic_samples_ms", nil);
    let raw_ms = [];
    if type(synthetic_samples) == "array" and len(synthetic_samples) >= 3 {
        let si = 0;
        while si < len(synthetic_samples) {
            array_push(raw_ms, synthetic_samples[si] * 1.0);
            si = si + 1;
        }
    } else {
        let it = 0;
        while it < sample_iters {
            let t0 = clock() * 1000.0;
            let b = 0;
            while b < inner_loops {
                bench_fn();
                b = b + 1;
            }
            let dt = (clock() * 1000.0) - t0;
            if dt < 0.0 { dt = 0.0; }
            array_push(raw_ms, dt / inner_loops);
            it = it + 1;
        }
    }

    let sorted = _sort_numbers(raw_ms);
    let n = len(sorted);
    let sum = 0.0;
    let i = 0;
    while i < n { sum = sum + sorted[i]; i = i + 1; }
    let mean_ms = sum / n;
    let median_ms = _percentile_sorted(sorted, 50.0);
    let p95_ms = _percentile_sorted(sorted, 95.0);
    let p99_ms = _percentile_sorted(sorted, 99.0);
    let q1_ms = _percentile_sorted(sorted, 25.0);
    let q3_ms = _percentile_sorted(sorted, 75.0);
    let iqr_ms = q3_ms - q1_ms;

    // Median Absolute Deviation: MAD = median(|x_i - median|)
    let abs_devs = [];
    i = 0;
    while i < n {
        array_push(abs_devs, num_abs(sorted[i] - median_ms));
        i = i + 1;
    }
    let sorted_devs = _sort_numbers(abs_devs);
    let mad_ms = _percentile_sorted(sorted_devs, 50.0);

    // Outlier count via robust MAD threshold (3.5 * 1.4826 * MAD) with Tukey IQR fallback
    let mad_sigma = 1.4826 * mad_ms;
    let fence_hi = if mad_sigma > 0.0000001 { median_ms + 3.5 * mad_sigma } else { q3_ms + 1.5 * iqr_ms + 0.000001 };
    let fence_lo = if mad_sigma > 0.0000001 { median_ms - 3.5 * mad_sigma } else { q1_ms - 1.5 * iqr_ms - 0.000001 };
    let outliers = 0;
    i = 0;
    while i < n {
        if sorted[i] > fence_hi or sorted[i] < fence_lo {
            outliers = outliers + 1;
        }
        i = i + 1;
    }

    let effective_ms = if median_ms > 0.0000001 { median_ms } elif mean_ms > 0.0000001 { mean_ms } else { 0.0001 };
    let ops_per_sec = 1000.0 / effective_ms;

    return map{
        ok: true,
        format: BENCH_FORMAT,
        name: str(name),
        iters: n,
        warmup_discarded: warmup,
        inner_loops: inner_loops,
        min_ms: sorted[0],
        max_ms: sorted[n - 1],
        median_ms: median_ms,
        mean_ms: mean_ms,
        p95_ms: p95_ms,
        p99_ms: p99_ms,
        mad_ms: mad_ms,
        outlier_count: outliers,
        ops_per_sec: ops_per_sec,
        samples_ms: raw_ms
    };
}

// Hermetic Reproducible Cross-Target Matrix Planner
let _TARGET_CATALOG = map{
    "linux-x64":     map{ os: "linux",   arch: "x86_64",  abi: "sysv-gnu",     container: "ELF64",       ext: "",     backend: "aot-native-elf64" },
    "windows-x64":   map{ os: "windows", arch: "x86_64",  abi: "win64-pe",     container: "PE32+",       ext: ".exe", backend: "aot-native-pe64" },
    "linux-arm64":   map{ os: "linux",   arch: "aarch64", abi: "aapcs64",      container: "ELF64",       ext: "",     backend: "aot-native-arm64" },
    "linux-riscv64": map{ os: "linux",   arch: "riscv64", abi: "lp64d",        container: "ELF64",       ext: "",     backend: "aot-native-rv64gc" },
    "macos-arm64":   map{ os: "macos",   arch: "arm64",   abi: "darwin-arm64", container: "Mach-O-64",   ext: "",     backend: "aot-native-macho64" },
    "wasm32":        map{ os: "wasi",    arch: "wasm32",  abi: "wasi-preview1",container: "WASM32",      ext: ".wasm",backend: " pure-wasm32-emitter" },
    "dos16":         map{ os: "dos",     arch: "i8086",   abi: "realmode-16",  container: "MZ-COM-16",   ext: ".com", backend: "sub32-i8086-emitter" }
};

fn build_cross_target_matrix_plan(app_path, targets = nil, opts = nil) {
    let clean_app = _validate_target_dir(app_path);
    let req_targets = if type(targets) == "array" and len(targets) > 0 {
        targets
    } else {
        ["linux-x64", "windows-x64", "linux-arm64", "linux-riscv64", "macos-arm64", "wasm32", "dos16"]
    };

    let out_root = _validate_target_dir(str(_opt(opts, "out_dir", "dist/matrix")));
    let source_epoch = _opt(opts, "source_date_epoch", 1762905600);
    let base_stem = path_basename(clean_app);
    if str_ends_with(base_stem, ".sapp") {
        base_stem = str_slice(base_stem, 0, len(base_stem) - 5);
    }

    let entries = [];
    let i = 0;
    while i < len(req_targets) {
        let tid = str_lower(str_trim(str(req_targets[i])));
        if not map_has(_TARGET_CATALOG, tid) {
            _err("matrix", "unsupported target '" + tid + "'");
        }
        let spec = _TARGET_CATALOG[tid];
        let artifact_rel = out_root + "/" + tid + "/" + base_stem + spec.ext;
        array_push(entries, map{
            target: tid,
            os: spec.os,
            arch: spec.arch,
            abi: spec.abi,
            container: spec.container,
            backend: str_trim(spec.backend),
            artifact_path: artifact_rel,
            hermetic_env: map{
                SOURCE_DATE_EPOCH: str(source_epoch),
                TZ: "UTC",
                LC_ALL: "C",
                PBLANG_HERMETIC: "1"
            },
            strip_host_paths: true,
            reproducible: true
        });
        i = i + 1;
    }

    let plan = map{
        ok: true,
        format: MATRIX_FORMAT,
        app_path: clean_app,
        out_dir: out_root,
        source_date_epoch: source_epoch,
        target_count: len(entries),
        entries: entries
    };
    plan.plan_sha256 = Sha256.sha256_hex(canonical_json(plan));
    return plan;
}

fn run_cli_subcommand(sub, argv_list) {
    let args_arr = if type(argv_list) == "array" { argv_list } else { [] };
    if sub == "init" {
        let dir = if len(args_arr) >= 1 { str(args_arr[0]) } else { "new-pblang-app" };
        let kind = if len(args_arr) >= 2 { str(args_arr[1]) } else { "cli" };
        let pkg = path_basename(dir);
        if pkg == "" or pkg == "." { pkg = "app"; }
        return scaffold_pblang_project(dir, kind, pkg, map{ write_files: true });
    }
    if sub == "pkg" {
        let action = if len(args_arr) >= 1 { str(args_arr[0]) } else { "sbom" };
        let name = if len(args_arr) >= 2 { str(args_arr[1]) } else { "pblang-workspace" };
        let meta = map{ name: name, version: PKG_ENGINE_VERSION, license: "Apache-2.0" };
        if action == "spdx" {
            return generate_spdx_sbom(meta, [], map{});
        }
        return generate_cyclonedx_sbom(meta, [], map{});
    }
    if sub == "bench" {
        let target_script = if len(args_arr) >= 1 { str(args_arr[0]) } else { "" };
        if target_script != "" and fs_exists(target_script) {
            return run_statistical_bench(target_script, fn() { import(target_script); }, 10, map{});
        }
        return run_statistical_bench("vm_arith_baseline", fn() {
            let s = 0;
            let k = 0;
            while k < 200 { s = s + k; k = k + 1; }
            return s;
        }, 15, map{});
    }
    return map{ ok: false, error: "unknown subcommand: " + str(sub) };
}

export PKG_ENGINE_VERSION, LOCKFILE_FORMAT, SIGNATURE_FORMAT, BENCH_FORMAT, MATRIX_FORMAT;
export canonical_json, scaffold_pblang_project;
export pkg_sign_manifest, pkg_verify_lockfile, generate_cyclonedx_sbom, generate_spdx_sbom;
export run_statistical_bench, build_cross_target_matrix_plan, run_cli_subcommand;
