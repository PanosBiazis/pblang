// stdlib/devtools/cli_router.sapp — 100% Pure-PBLang v5.1.0 CLI Subcommand Router
//
// Dispatches `dap`, `init`, `pkg`, `bench`, and `cross-bundle` exclusively in pure `.sapp`.

fn dispatch_cli(sub: string, cli_args: any) {
    if sub == "dap" {
        let D = import("stdlib:devtools/debugger_timetravel_dap.sapp");
        return D.dap_run_stdio_loop();
    }
    if sub == "init" or sub == "pkg" or sub == "bench" {
        let T = import("stdlib:devtools/pkg_init_bench_sbom.sapp");
        let out = T.run_cli_subcommand(sub, cli_args);
        println(json_stringify(out));
        return out;
    }
    if sub == "cross-bundle" {
        let B = import("stdlib:compiler/hermetic_cross_bundler.sapp");
        if len(cli_args) < 2 {
            eprintln("Usage: pblang cross-bundle <input.sapp|input.pbck> <target> [output_file]");
            os_exit(1);
        }
        let raw = fs_read_bytes(cli_args[0]);
        let r = B.cross_bundle_executable(raw, cli_args[1], map{});
        if len(cli_args) >= 3 and r["ok"] {
            fs_write_bytes(cli_args[2], r["bytes"]);
        }
        println(json_stringify(map{
            ok: r["ok"],
            target: r["target"],
            format: r["format"],
            byte_len: r["byte_len"],
            payload_sha256: r["payload_sha256"]
        }));
        return r;
    }
    eprintln("Unknown pure-PBLang CLI subcommand: " + sub);
    os_exit(1);
}

export dispatch_cli;
