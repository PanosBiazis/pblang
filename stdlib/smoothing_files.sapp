let Tables=import("stdlib:table_files.sapp");let Smooth=import("stdlib:smoothing_table.sapp");
fn open(path,count,delimiter=","){let loaded=Tables.open(path,delimiter);if not loaded.ok{return loaded;}let report=try Smooth.from_sheet(loaded.document,count) catch nil;if report==nil{return map{ok:false,error:"Invalid samples, window or output limits. Expected Label,Value with finite numeric samples."};}return map{ok:true,report:report};}
fn save(path,report,delimiter=","){if type(path)!="string" {return map{ok:false,error:"Choose a new output filename."};}let doc=try report.document catch nil;return Tables.save(path,doc,if str_ends_with(str_lower(path),".pbsheet") {"sheet"} else {"csv"},delimiter);}
fn run(input,output,count,delimiter=","){let loaded=open(input,count,delimiter);if not loaded.ok{return loaded;}let saved=save(output,loaded.report,delimiter);if not saved.ok{return saved;}return map{ok:true,window:count,samples:loaded.report.samples,rows:loaded.report.rows,atomic_visibility:false};}
export open,save,run;
