// Fixed-day agenda projection: explicit local clock, no calendar or timezone.
let T=import("stdlib:timeline_document.sapp");let D=import("stdlib:text_document.sapp");
fn clock_ms(clock) {
 if type(clock)!="string" or len(clock)!=5 or len(str_to_bytes(clock))!=5 or str_slice(clock,2,3)!=":" {throw "agenda clock: use HH:MM";}
 for i in [0,1,3,4] {let c=strcharcodeat(clock,i);if c<48 or c>57 {throw "agenda clock: ASCII digits required";}}
 let hours=(strcharcodeat(clock,0)-48)*10+strcharcodeat(clock,1)-48;
 let minutes=(strcharcodeat(clock,3)-48)*10+strcharcodeat(clock,4)-48;
 if hours>23 or minutes>59 {throw "agenda clock: outside 00:00-23:59";}
 return (hours*60+minutes)*60000;
}
fn _pad(value,width) {let out=str(value);while len(out)<width {out="0"+out;}return out;}
fn _stamp(ms) {
 let day=num_floor(ms/86400000);let rest=ms-day*86400000;
 let hour=num_floor(rest/3600000);rest=rest-hour*3600000;
 let minute=num_floor(rest/60000);rest=rest-minute*60000;
 let second=num_floor(rest/1000);let milli=rest-second*1000;
 return "D+"+str(day)+" "+_pad(hour,2)+":"+_pad(minute,2)+":"+_pad(second,2)+"."+_pad(milli,3);
}
fn project(doc,clock) {
 T.validate(doc);let origin=clock_ms(clock);let analysis=T.analyze(doc);let entries=[];
 for i in range(0,len(doc.entries)) {
  let e=doc.entries[i];array_push(entries,map{source_index:i,label:e.label,start:_stamp(origin+e.start_ms),end:_stamp(origin+e.end_ms),duration_ms:e.end_ms-e.start_ms,overlaps:analysis.overlaps_by_index[i]});
 }
 return map{title:doc.title,clock:clock,entries:entries,overlap_pairs:analysis.overlap_pairs,gap_ms:analysis.gap_ms,order:"source",fixed_day_ms:86400000};
}
fn to_document(doc,clock) {
 let report=project(doc,clock);let out=D.create(doc.title);out.blocks=[];
 let note="Clock origin: "+clock+". D+0 is the start day; fixed 24-hour days, no dates/timezones/DST. Source order retained. Overlap pairs: "+str(report.overlap_pairs)+"; internal gaps: "+str(report.gap_ms)+" ms.\n";
 for e in report.entries {
  let text=str(e.source_index+1)+". "+e.label+"\n["+e.start+", "+e.end+") | Duration: "+str(e.duration_ms)+" ms | Overlaps: "+str(e.overlaps);
  if e.source_index==0 {text=note+text;}
  array_push(out.blocks,map{kind:"paragraph",text:text});
 }
 D.validate(out);return out;
}
export clock_ms,project,to_document;
