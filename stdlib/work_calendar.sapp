// Explicit workweek and caller-supplied closed dates; no locale or holiday feed.
let Date=import("stdlib:civil_date.sapp");
fn _prepare(weekdays,closed) {
    if weekdays==nil {weekdays=[0,1,2,3,4];}if closed==nil {closed=[];}
    if type(weekdays)!="array" or len(weekdays)<1 or len(weekdays)>7
        or type(closed)!="array" or len(closed)>366 {throw "invalid work calendar";}
    let week=map{};let holidays=map{};
    for day in weekdays {
        if type(day)!="number" or not (day>=0 and day<=6) or day!=num_floor(day) or map_has(week,str(day)) {throw "invalid or repeated weekday";}
        week[str(day)]=true;
    }
    for date in closed {let ordinal=Date.ordinal(date);if map_has(holidays,str(ordinal)) {throw "duplicate closed date";}holidays[str(ordinal)]=true;}
    return map{week:week,closed:holidays};
}
fn _open(day,calendar) {return map_has(calendar.week,str(num_mod(day,7))) and not map_has(calendar.closed,str(day));}
fn is_workday(date,weekdays=nil,closed=nil) {return _open(Date.ordinal(date),_prepare(weekdays,closed));}
// Zero returns start unchanged. Nonzero excludes start, counts in either direction.
fn add(date,days,weekdays=nil,closed=nil) {
    let calendar=_prepare(weekdays,closed);let current=Date.ordinal(date);
    if type(days)!="number" or not (days>= -366 and days<=366) or days!=num_floor(days) {throw "workday offset limit";}
    let direction=if days<0 {-1}else {1};let remaining=if days<0 {-days}else {days};let visited=0;
    while remaining>0 {
        current=current+direction;visited=visited+1;
        if current<0 or current>3652058 or visited>6000 {throw "workday date range exceeded";}
        if _open(current,calendar) {remaining=remaining-1;}
    }
    return Date.from_ordinal(current);
}
// Inclusive date interval; bounded independently of the number of working days.
fn between(start,end,weekdays=nil,closed=nil) {
    let calendar=_prepare(weekdays,closed);let first=Date.ordinal(start);let last=Date.ordinal(end);
    if last<first or last-first>3660 {throw "workday interval limit";}
    let dates=[];
    for day in range(first,last+1) {if _open(day,calendar) {array_push(dates,Date.from_ordinal(day));}}
    return map{format:"pblang.work-calendar.v1",dates:dates,count:len(dates),inclusive:true};
}
export is_workday,add,between;
