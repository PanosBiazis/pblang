// stdlib/async_await.sapp — Async/await-like primitives for pblang.
//
// Future-based async composition over the channel/thread builtins, with map/then
// chaining, await_all/any, timeouts, and error recovery.
//
// NOTE on error handling: pblang's `catch` does NOT bind the thrown value — the
// form is `try <expr> catch <fallback-expr>`. So we detect "did it throw?" with a
// per-call sentinel rather than a named catch binding. (A previous version used
// `try { ... } catch e { err = e; }`, which mis-parsed: the `{ ... }` ran
// unconditionally and read an undefined global `e`, killing the worker before it
// sent its result. This version fixes that failure mode.)
//
//   let aa = import("stdlib:async_await.sapp");
//   let f = aa.async_spawn(fn() { return work(); });
//   let v = aa.await(f);
//   let g = aa.map(f, fn(x) { return x * 2; });
//   let r = aa.all_settled([f, g]);     // never raises

// A Future is map{ __ch, __handle, __resolved, __value, __error, __tag }.
// The worker sends map{ ok, value } (ok=false means the task threw).

fn async_spawn(task_fn) {
    let ch = channel();
    let sentinel = map{ __threw: true };
    let handle = spawn(fn() {
        let val = try task_fn() catch sentinel;
        let threw = (val == sentinel);
        let v = val;
        if threw { v = nil; }
        send(ch.sender, map{ ok: not threw, value: v });
    });
    return map{ __ch: ch, __handle: handle, __resolved: false, __value: nil, __error: nil, __tag: "async_spawn" };
}

// await(future) → value — block until resolved; raise if the task threw.
fn await(future) {
    if future.__resolved == true {
        if future.__error != nil { return error("async_await.await: " + str(future.__error)); }
        return future.__value;
    }
    let msg = recv(future.__ch.receiver);
    try join(future.__handle) catch nil;
    future.__resolved = true;
    if msg == nil {
        future.__error = "channel closed without result";
        return error("async_await.await: channel closed without result");
    }
    if msg.ok == false {
        future.__error = "task threw";
        return error("async_await.await: computation failed");
    }
    future.__value = msg.value;
    return msg.value;
}

// settle(future) → {ok, value} | {ok:false, error} — block but NEVER raise.
fn settle(future) {
    if future.__resolved == true {
        if future.__error != nil { return map{ ok: false, error: str(future.__error) }; }
        return map{ ok: true, value: future.__value };
    }
    let msg = recv(future.__ch.receiver);
    try join(future.__handle) catch nil;
    future.__resolved = true;
    if msg == nil { future.__error = "channel closed without result"; return map{ ok: false, error: "channel closed without result" }; }
    if msg.ok == false { future.__error = "task threw"; return map{ ok: false, error: "task threw" }; }
    future.__value = msg.value;
    return map{ ok: true, value: msg.value };
}

// await_all(futures) → [values] — raises on the first failure.
fn await_all(futures) {
    let results = [];
    let i = 0;
    while i < len(futures) { array_push(results, await(futures[i])); i = i + 1; }
    return results;
}

// all_settled(futures) → [{ok, value|error}, ...] — never raises.
fn all_settled(futures) {
    let out = [];
    let i = 0;
    while i < len(futures) { array_push(out, settle(futures[i])); i = i + 1; }
    return out;
}

// await_any(futures) → {index, value} — first to resolve (raises if it failed).
fn await_any(futures) {
    let n = len(futures);
    if n == 0 { return error("async_await.await_any: empty futures array"); }
    let receivers = [];
    let i = 0;
    while i < n {
        if futures[i].__resolved == true {
            if futures[i].__error != nil { return error("async_await.await_any: future " + str(i) + " failed"); }
            return map{ index: i, value: futures[i].__value };
        }
        array_push(receivers, futures[i].__ch.receiver);
        i = i + 1;
    }
    let sel = select(receivers);
    if sel == nil { return error("async_await.await_any: select returned nil"); }
    let idx = sel.index;
    let msg = sel.value;
    futures[idx].__resolved = true;
    if msg != nil {
        if msg.ok == false { futures[idx].__error = "task threw"; }
        else { futures[idx].__value = msg.value; }
    }
    if msg == nil { return map{ index: idx, value: nil }; }
    if msg.ok == false { return error("async_await.await_any: future " + str(idx) + " failed"); }
    return map{ index: idx, value: msg.value };
}

// map(future, fn) → Future — transform the resolved value with fn (errors propagate).
fn map(future, transform_fn) {
    let ch = channel();
    let sentinel = map{ __threw: true };
    let handle = spawn(fn() {
        let msg = recv(future.__ch.receiver);
        try join(future.__handle) catch nil;
        if msg == nil { send(ch.sender, map{ ok: false, value: nil }); }
        else if msg.ok == false { send(ch.sender, map{ ok: false, value: nil }); }
        else {
            let mapped = try transform_fn(msg.value) catch sentinel;
            let threw = (mapped == sentinel);
            let v = mapped;
            if threw { v = nil; }
            send(ch.sender, map{ ok: not threw, value: v });
        }
    });
    return map{ __ch: ch, __handle: handle, __resolved: false, __value: nil, __error: nil, __tag: "map" };
}

// then(future, fn) → Future — fn(value) returns a new Future; result flattens it.
fn then(future, chain_fn) {
    let ch = channel();
    let sentinel = map{ __threw: true };
    let handle = spawn(fn() {
        let msg = recv(future.__ch.receiver);
        try join(future.__handle) catch nil;
        if msg == nil { send(ch.sender, map{ ok: false, value: nil }); }
        else if msg.ok == false { send(ch.sender, map{ ok: false, value: nil }); }
        else {
            let next_future = try chain_fn(msg.value) catch sentinel;
            if next_future == sentinel { send(ch.sender, map{ ok: false, value: nil }); }
            else {
                let inner = recv(next_future.__ch.receiver);
                try join(next_future.__handle) catch nil;
                if inner == nil { send(ch.sender, map{ ok: false, value: nil }); }
                else if inner.ok == false { send(ch.sender, map{ ok: false, value: nil }); }
                else { send(ch.sender, map{ ok: true, value: inner.value }); }
            }
        }
    });
    return map{ __ch: ch, __handle: handle, __resolved: false, __value: nil, __error: nil, __tag: "then" };
}

// catch_error(future, handler) → Future — on failure, resolve to handler(reason);
// on success, pass the value through. (handler runs in a worker; keep it self-contained.)
fn catch_error(future, handler) {
    let ch = channel();
    let sentinel = map{ __threw: true };
    let handle = spawn(fn() {
        let msg = recv(future.__ch.receiver);
        try join(future.__handle) catch nil;
        let failed = (msg == nil) or (msg.ok == false);
        if failed {
            let r = try handler("task failed") catch sentinel;
            let threw = (r == sentinel);
            let v = r;
            if threw { v = nil; }
            send(ch.sender, map{ ok: not threw, value: v });
        } else {
            send(ch.sender, map{ ok: true, value: msg.value });
        }
    });
    return map{ __ch: ch, __handle: handle, __resolved: false, __value: nil, __error: nil, __tag: "catch_error" };
}

// is_resolved(future) → bool (non-blocking).
fn is_resolved(future) { return future.__resolved == true; }

// await_timeout(future, ms) → {ok, value} | {ok:false, error}.
fn await_timeout(future, ms) {
    if future.__resolved == true {
        if future.__error != nil { return map{ ok: false, error: str(future.__error) }; }
        return map{ ok: true, value: future.__value };
    }
    let msg = recv_timeout(future.__ch.receiver, ms);
    if msg == nil { return map{ ok: false, error: "timeout" }; }
    try join(future.__handle) catch nil;
    future.__resolved = true;
    if msg.ok == false { future.__error = "task threw"; return map{ ok: false, error: "task threw" }; }
    future.__value = msg.value;
    return map{ ok: true, value: msg.value };
}

// await_all_timeout(futures, ms) → {ok, values} | {ok:false, error}.
fn await_all_timeout(futures, ms) {
    let n = len(futures);
    let per_future_ms = ms;
    if n > 0 { per_future_ms = ms / n; }
    if per_future_ms < 100 { per_future_ms = 100; }
    let results = [];
    let i = 0;
    while i < n {
        let r = await_timeout(futures[i], per_future_ms);
        if r.ok == false { return map{ ok: false, error: r.error }; }
        array_push(results, r.value);
        i = i + 1;
    }
    return map{ ok: true, values: results };
}

// race_with_timeout(futures, ms) → {ok, index, value} | {ok:false, error}.
fn race_with_timeout(futures, ms) {
    let n = len(futures);
    if n == 0 { return map{ ok: false, error: "empty futures array" }; }
    let receivers = [];
    let i = 0;
    while i < n {
        if futures[i].__resolved == true {
            if futures[i].__error != nil { return map{ ok: false, error: str(futures[i].__error) }; }
            return map{ ok: true, index: i, value: futures[i].__value };
        }
        array_push(receivers, futures[i].__ch.receiver);
        i = i + 1;
    }
    let sel = select_with_timeout(receivers, ms);
    if sel == nil { return map{ ok: false, error: "timeout" }; }
    let idx = sel.index;
    let msg = sel.value;
    futures[idx].__resolved = true;
    if msg != nil {
        if msg.ok == false { futures[idx].__error = "task threw"; return map{ ok: false, error: "task threw" }; }
        futures[idx].__value = msg.value;
    }
    if msg == nil { return map{ ok: true, index: idx, value: nil }; }
    return map{ ok: true, index: idx, value: msg.value };
}

// from_value(value) → Future — already-resolved Future wrapping a static value.
fn from_value(value) {
    return map{ __ch: nil, __handle: nil, __resolved: true, __value: value, __error: nil, __tag: "from_value" };
}

// from_error(err_msg) → Future — already-failed Future.
fn from_error(err_msg) {
    return map{ __ch: nil, __handle: nil, __resolved: true, __value: nil, __error: err_msg, __tag: "from_error" };
}

// never() → Future — intentionally never resolves; useful as a race sentinel.
fn never() {
    return map{ __ch: channel(), __handle: nil, __resolved: false, __value: nil, __error: nil, __tag: "never" };
}

// first_ok(futures) → {index, value} | nil — first SUCCESSFUL result, skip failures.
fn first_ok(futures) {
    let n = len(futures);
    if n == 0 { return nil; }
    let i = 0;
    while i < n {
        let r = settle(futures[i]);
        if r.ok == true { return map{ index: i, value: r.value }; }
        i = i + 1;
    }
    return nil;
}

export
    async_spawn, await, settle, await_all, all_settled, await_any,
    map, then, catch_error,
    is_resolved, await_timeout, await_all_timeout, race_with_timeout,
    from_value, from_error, never, first_ok;
