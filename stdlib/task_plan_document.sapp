// Plain Writer delivery document; dependency estimates, not a commitment or invoice.
let Plan=import("stdlib:task_plan.sapp");let Text=import("stdlib:text_document.sapp");
fn create(plan) {
 let scheduled=Plan.schedule(plan);let doc=Text.create(plan.title);doc.blocks=[];let tasks=map{};
 for task in plan.tasks {tasks[task.id]=task;}
 for task in scheduled.tasks {
  let needs=tasks[task.id].needs;
  array_push(doc.blocks,map{kind:"heading",text:task.id+": "+task.label});
  array_push(doc.blocks,map{kind:"paragraph",text:"Estimated: "+task.start+" to "+task.due+"\nCalendar days: "+str(task.days)+" | Status: "+task.status+
   "\nPrerequisites: "+if len(needs)==0 {"none"} else {str_join(needs,", ")}});
 }
 // Put the assumptions inside the exported document, including a 32-task plan.
 doc.blocks[1].text=doc.blocks[1].text+"\nEstimates: calendar days, unlimited workers, fixed durations.";
 Text.validate(doc);return doc;
}
export create;
