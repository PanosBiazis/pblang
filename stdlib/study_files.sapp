let Publication=import("stdlib:study_publication.sapp");
let File=import("stdlib:secure_file.sapp");let Study=import("stdlib:study_cards.sapp");
fn _path(path,extension) {
    return type(path)=="string" and len(path)>len(extension) and len(path)<=4096
        and len(str_to_bytes(path))<=4096 and str_ends_with(str_lower(path),extension);
}
fn open_deck(path) {
    if not _path(path,".pbdeck") { return map{ok:false,error:"Choose a .pbdeck path."}; }
    let read=try File.read_text(path,Study.MAX_FILE_BYTES,false) catch nil;
    if read==nil or not read.ok { return map{ok:false,error:"Could not read study deck."}; }
    let deck=try Study.decode(read.text) catch nil;
    if deck==nil { return map{ok:false,error:"Invalid study deck."}; }
    return map{ok:true,deck:deck};
}
fn save_copy(path,deck) {
    if not _path(path,".pbdeck") { return map{ok:false,error:"Choose a new .pbdeck path.",written:false,publication_attempted:false,partial_output_possible:false}; }
    let text=try Study.encode(deck) catch nil;
    if text==nil { return map{ok:false,error:"Invalid study deck; nothing written.",written:false,publication_attempted:false,partial_output_possible:false}; }
    return Publication.save(path,text);
}
export open_deck,save_copy;
