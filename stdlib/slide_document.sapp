// Portable text slides. Eight slides fit the shared portable-action budget.
let Text=import("stdlib:text_document.sapp");
let Pages=import("stdlib:text_pages.sapp");
let Serialization=import("stdlib:serialization.sapp");
let FORMAT="pblang.slide-deck.v1"; let MAX_SLIDES=8; let MAX_FILE_BYTES=131072;
fn _keys(value,keys) {
    if type(value)!="map" or len(value)!=len(keys) { return false; }
    for key in keys { if not map_has(value,key) { return false; } } return true;
}
fn _text(value,chars,bytes,multiline=false) {
    if type(value)!="string" or len(value)>chars or len(str_to_bytes(value))>bytes { throw "slides: text limit"; }
    for i in range(0,len(value)) {
        let c=strcharcodeat(value,i);
        if (c<32 and not (multiline and c==10)) or c==127 { throw "slides: unsupported control character"; }
    }
}
fn _index(index,max) { if type(index)!="number" or not (index>=0 and index<=max) or index!=num_floor(index) { throw "slides: invalid index"; } }
fn validate(deck) {
    if not _keys(deck,["format","title","slides"]) or deck.format!=FORMAT or type(deck.slides)!="array"
        or len(deck.slides)<1 or len(deck.slides)>MAX_SLIDES { throw "slides: invalid deck"; }
    _text(deck.title,256,256); let total=len(str_to_bytes(deck.title));
    for slide in deck.slides {
        if not _keys(slide,["title","lines","notes"]) or type(slide.lines)!="array" or len(slide.lines)>5 { throw "slides: invalid slide"; }
        _text(slide.title,80,256); _text(slide.notes,1024,1024,true);
        if str_trim(slide.title)=="" { throw "slides: title required"; }
        total=total+len(str_to_bytes(slide.title))+len(str_to_bytes(slide.notes));
        for line in slide.lines { _text(line,80,256); total=total+len(str_to_bytes(line)); }
    }
    if total>16384 { throw "slides: total text limit"; } return true;
}
fn copy(deck) {
    validate(deck); let slides=[];
    for s in deck.slides { let lines=[]; for line in s.lines { array_push(lines,line); } array_push(slides,map{title:s.title,lines:lines,notes:s.notes}); }
    return map{format:FORMAT,title:deck.title,slides:slides};
}
fn create(title="Untitled presentation") { let d=map{format:FORMAT,title:title,slides:[map{title:"New slide",lines:[],notes:""}]}; validate(d); return d; }
fn set_slide(deck,index,title,lines,notes="") {
    let out=copy(deck); _index(index,len(out.slides)-1); let detached=[];
    if type(lines)!="array" or len(lines)>5 { throw "slides: line limit"; }
    for line in lines { array_push(detached,line); }
    out.slides[index]=map{title:title,lines:detached,notes:notes}; validate(out); return out;
}
fn insert(deck,index) {
    let out=copy(deck); _index(index,len(out.slides)); if len(out.slides)>=MAX_SLIDES { throw "slides: slide limit"; }
    let slides=[];
    for i in range(0,len(out.slides)+1) { if i==index { array_push(slides,map{title:"New slide",lines:[],notes:""}); } if i<len(out.slides) { array_push(slides,out.slides[i]); } }
    out.slides=slides; return out;
}
fn remove(deck,index) {
    let out=copy(deck); _index(index,len(out.slides)-1); if len(out.slides)==1 { throw "slides: one slide required"; }
    let slides=[]; for i in range(0,len(out.slides)) { if i!=index { array_push(slides,out.slides[i]); } } out.slides=slides; return out;
}
fn move(deck,from,to) {
    let out=copy(deck); _index(from,len(out.slides)-1); _index(to,len(out.slides)-1);
    let selected=out.slides[from]; let others=[]; for i in range(0,len(out.slides)) { if i!=from { array_push(others,out.slides[i]); } }
    let slides=[]; let j=0;
    for i in range(0,len(out.slides)) { if i==to { array_push(slides,selected); } else { array_push(slides,others[j]); j=j+1; } }
    out.slides=slides; return out;
}
fn from_document(doc) {
    Text.validate(doc); let slides=[]; let current=map{}; let active=false;
    for block in doc.blocks {
        if block.kind=="heading" {
            if active { array_push(slides,current); }
            current=map{title:block.text,lines:[],notes:""}; active=true;
        } elif not active {
            if str_trim(block.text)!="" { throw "slides: notes must begin with a heading"; }
        } else {
            _text(block.text,1024,1024,true);
            let text=if block.kind=="bullet" {"• "+block.text} else {block.text};
            for line in Pages.wrap(text,80) { array_push(current.lines,line); }
            if len(current.lines)>5 { throw "slides: section needs more than five lines"; }
        }
    }
    if active { array_push(slides,current); }
    let deck=map{format:FORMAT,title:doc.title,slides:slides}; validate(deck); return deck;
}
fn _limits() { return map{max_input_bytes:MAX_FILE_BYTES,max_output_bytes:MAX_FILE_BYTES,max_line_bytes:MAX_FILE_BYTES,max_depth:5,max_items:256,strict:true,reject_duplicate_keys:true}; }
fn encode(deck) { let r=Serialization.stringify_safe(copy(deck),"json",_limits()); if not r.ok { throw "slides: encoding failed"; } return r.value; }
fn decode(text) { let r=Serialization.parse_safe(text,"json",_limits()); if not r.ok or not r.duplicate_keys_checked { throw "slides: invalid file"; } return copy(r.value); }
export FORMAT,MAX_SLIDES,MAX_FILE_BYTES,validate,copy,create,set_slide,insert,remove,move,from_document,encode,decode;
