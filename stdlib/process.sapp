// stdlib/process.sapp — Process execution helpers (G2)

fn spawn_wait(cmd, args) {
    let result = try exec(cmd, args) catch nil;
    if result == nil {
        return map{ exit_code: 1, stdout: "", stderr: "exec failed" };
    }
    if type(result) == "map" {
        return result;
    }
    return map{ exit_code: 0, stdout: str(result), stderr: "" };
}

export spawn_wait;
