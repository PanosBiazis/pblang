// stdlib/process.sapp — Process execution helpers (over the proc_spawn_wait builtin).
// proc_spawn_wait(cmd, args) returns map{ exit_code, stdout, stderr }. All wrappers
// require --allow-exec.

let _LINUX_PROCESS = import("stdlib:linux_process.sapp");
let BOUNDED_HANDLE_FORMAT = "pblang.process.bounded-handle.v1";
let MAX_BOUNDED_HANDLES = 128;
let _BOUNDED_HANDLES = map{};
let BOUNDED_RECOVERY_GRACE_MS = 5000;
let BOUNDED_TERMINAL_RETENTION_MS = 60000;
let MAX_BOUNDED_TERMINAL_BYTES = 16777216;
let BOUNDED_TERMINAL_METADATA_BYTES = 65536;
let BOUNDED_TERMINAL_ENVELOPE_BYTES = 512;

fn _bounded_token() {
    for attempt 8 {
        let id = sha256(base64_encode_bytes(random_bytes(32)) + ":"
            + str(now_ms()) + ":" + str(attempt));
        if not map_has(_BOUNDED_HANDLES, id) { return id; }
    }
    throw "process: bounded lifecycle identity allocation failed";
}

fn _bounded_integer(value, fallback, minimum, maximum, label) {
    let selected = if value == nil { fallback } else { value };
    if type(selected) != "number" or selected != num_floor(selected)
       or selected < minimum or selected > maximum {
        throw "process: " + label + " must be an integer in "
            + str(minimum) + ".." + str(maximum);
    }
    return selected;
}

fn _base64_bound(bytes) { return num_floor((bytes + 2) / 3) * 4; }

fn _terminal_reservation(output_bytes) {
    return _base64_bound(output_bytes) + BOUNDED_TERMINAL_METADATA_BYTES
        + BOUNDED_TERMINAL_ENVELOPE_BYTES;
}

fn _terminal_budget_usage(current) {
    let payload_bytes = 0; let entries = 0; let cached = 0; let expired = 0;
    let ids = map_keys(_BOUNDED_HANDLES);
    for i len(ids) {
        let id = ids[i];
        if map_has(_BOUNDED_HANDLES, id) {
            let state = _BOUNDED_HANDLES[id];
            if (try state.phase catch "") == "terminal_cached"
               and current >= (try state.terminal_expires_ms catch 0) {
                state.phase = "claimed"; state.terminal_compact = nil;
                map_remove(_BOUNDED_HANDLES, id); expired = expired + 1;
            } else {
                entries = entries + 1;
                if (try state.phase catch "") == "terminal_cached" {
                    payload_bytes = payload_bytes + (try state.terminal_bytes catch 0);
                    cached = cached + 1;
                } else {
                    payload_bytes = payload_bytes
                        + (try state.terminal_reservation_bytes catch 0);
                }
            }
        }
    }
    return map{ payload_bytes: payload_bytes, entries: entries,
        cached: cached, expired: expired };
}

fn _reserve_bounded(reservation_bytes, retention_ms) {
    let usage = _terminal_budget_usage(num_floor(now_ms()));
    if len(map_keys(_BOUNDED_HANDLES)) >= MAX_BOUNDED_HANDLES {
        throw "process: bounded lifecycle capacity reached";
    }
    if reservation_bytes > MAX_BOUNDED_TERMINAL_BYTES
       or usage.payload_bytes + reservation_bytes > MAX_BOUNDED_TERMINAL_BYTES {
        throw "process: bounded terminal-result budget reached";
    }
    let id = _bounded_token(); let current = num_floor(now_ms());
    _BOUNDED_HANDLES[id] = map{ raw: nil, created_ms: current,
        last_used_ms: current, launching: true, cancel_requested: false,
        recovery_after_ms: current + BOUNDED_RECOVERY_GRACE_MS,
        terminal_reservation_bytes: reservation_bytes,
        terminal_retention_ms: retention_ms,
        race_resistant_identity: false, phase: "reserved" };
    return id;
}

fn _bounded_state(handle) {
    if type(handle) != "map"
       or (try handle.format catch "") != BOUNDED_HANDLE_FORMAT
       or type(try handle.id catch nil) != "string"
       or len(handle.id) != 64
       or not regex_match(handle.id, "^[a-f0-9]{64}$")
       or not map_has(_BOUNDED_HANDLES, handle.id) {
        throw "process: invalid or closed bounded lifecycle handle";
    }
    let state = _BOUNDED_HANDLES[handle.id];
    let current = num_floor(now_ms());
    if (try state.phase catch "") == "terminal_cached"
       and current >= (try state.terminal_expires_ms catch 0) {
        state.phase = "claimed"; state.terminal_compact = nil;
        map_remove(_BOUNDED_HANDLES, handle.id);
        throw "process: expired bounded lifecycle handle";
    }
    state.last_used_ms = current; return state;
}

fn _bounded_poll_view(status) {
    return map{ format: "pblang.process.bounded-poll.v1",
        ok: try status.ok catch false,
        complete: try status.complete catch false,
        active: try status.active catch false,
        terminated: try status.terminated catch false,
        startup_pending: try status.startup_pending catch false,
        startup_failed: try status.startup_failed catch false,
        cancel_requested: try status.cancel_requested catch false,
        term_sent: try status.term_sent catch false,
        kill_sent: try status.kill_sent catch false,
        liveness: try status.liveness catch "not-probed",
        elapsed_ms: try status.elapsed_ms catch 0,
        race_resistant_identity: try status.race_resistant_identity catch false,
        raw_state_exposed: false };
}

fn _bounded_terminal_result(result) {
    if result == nil { return false; }
    return (try result.process_group_terminated catch false)
        or ((try result.terminated catch false)
            and not (try result.cleanup_deferred catch false));
}

fn _terminal_failure_result(message) {
    return map{ ok: false, completed: true, command_ok: false,
        exit_code: -1, signal: 0, signaled: false, core_dumped: false,
        timed_out: false, stdout: "", stderr: "", stdout_bytes: [],
        stderr_bytes: [], stdout_utf8: true, stderr_utf8: true,
        output_truncated: true, returned_output_bytes: 0,
        process_group_terminated: true, terminated: true,
        terminal_normalization_failed: true, error: message };
}

fn _compact_terminal_result(result) {
    if type(result) != "map" { throw "terminal result must be a map"; }
    let stdout_bytes = try result.stdout_bytes catch nil;
    let stderr_bytes = try result.stderr_bytes catch nil;
    if type(stdout_bytes) != "array" {
        stdout_bytes = try str_to_bytes(result.stdout) catch [];
    }
    if type(stderr_bytes) != "array" {
        stderr_bytes = try str_to_bytes(result.stderr) catch [];
    }
    let metadata = map{}; let keys = map_keys(result);
    for i len(keys) {
        let key = keys[i];
        if key != "stdout" and key != "stderr" and key != "stdout_bytes"
           and key != "stderr_bytes" and key != "process_group_id" {
            metadata[key] = result[key];
        }
    }
    let metadata_json = json_stringify(metadata);
    let stdout_b64 = base64_encode_bytes(stdout_bytes);
    let stderr_b64 = base64_encode_bytes(stderr_bytes);
    return map{ format: "pblang.process.terminal-compact.v1",
        metadata_json: metadata_json, stdout_b64: stdout_b64,
        stderr_b64: stderr_b64,
        payload_bytes: len(str_to_bytes(metadata_json))
            + len(str_to_bytes(stdout_b64)) + len(str_to_bytes(stderr_b64))
            + BOUNDED_TERMINAL_ENVELOPE_BYTES };
}

fn _failure_compact(message) {
    return _compact_terminal_result(_terminal_failure_result(message));
}

fn _expand_terminal_result(compact) {
    if type(compact) != "map"
       or (try compact.format catch "") != "pblang.process.terminal-compact.v1" {
        throw "invalid compact terminal result";
    }
    let result = json_parse(compact.metadata_json);
    if type(result) != "map" { throw "invalid terminal metadata"; }
    let stdout_bytes = base64_decode_bytes(compact.stdout_b64);
    let stderr_bytes = base64_decode_bytes(compact.stderr_b64);
    result.stdout_bytes = stdout_bytes; result.stderr_bytes = stderr_bytes;
    result.stdout = if (try result.stdout_utf8 catch false) {
        try bytes_to_str(stdout_bytes) catch ""
    } else { "" };
    result.stderr = if (try result.stderr_utf8 catch false) {
        try bytes_to_str(stderr_bytes) catch ""
    } else { "" };
    try map_remove(result, "process_group_id") catch nil;
    return result;
}

fn _cache_terminal(state, result, current) {
    let compact = try _compact_terminal_result(result) catch nil;
    if compact == nil
       or (try compact.payload_bytes catch MAX_BOUNDED_TERMINAL_BYTES + 1)
            > state.terminal_reservation_bytes {
        compact = _failure_compact("terminal result normalization exceeded its reserved budget");
    }
    state.raw = nil; state.terminal_compact = compact;
    state.terminal_bytes = compact.payload_bytes;
    state.terminal_cached_ms = current;
    state.terminal_expires_ms = current + state.terminal_retention_ms;
    state.launching = false; state.cancel_requested = false;
    state.phase = "terminal_cached";
    return compact.payload_bytes;
}

fn maintain_bounded() {
    let examined = 0; let closed = 0; let recovery_required = 0;
    let results_cached = 0;
    let current = num_floor(now_ms());
    let usage = _terminal_budget_usage(current);
    let payload_bytes = usage.payload_bytes;
    let ids = map_keys(_BOUNDED_HANDLES);
    for i len(ids) {
        let id = ids[i];
        if map_has(_BOUNDED_HANDLES, id) {
            let state = _BOUNDED_HANDLES[id]; examined = examined + 1;
            if (try state.phase catch "") == "terminal_cached" {
                continue;
            }
            if not (try state.launching catch false) and state.raw != nil {
                let observed = try _LINUX_PROCESS.poll(state.raw) catch nil;
                if observed != nil and (try observed.complete catch false) {
                    let result = try _LINUX_PROCESS.finish(state.raw, 0) catch nil;
                    if _bounded_terminal_result(result) {
                        payload_bytes = payload_bytes - state.terminal_reservation_bytes
                            + _cache_terminal(state, result, current);
                        closed = closed + 1; results_cached = results_cached + 1;
                    }
                }
                if state.raw != nil and current >= state.recovery_after_ms {
                    if not (try state.cancel_requested catch false) {
                        let requested = try _LINUX_PROCESS.request_cancel(state.raw, 250) catch nil;
                        state.cancel_requested = requested != nil;
                    }
                    let result = try _LINUX_PROCESS.finish(state.raw, 0) catch nil;
                    if _bounded_terminal_result(result) {
                        payload_bytes = payload_bytes - state.terminal_reservation_bytes
                            + _cache_terminal(state, result, current);
                        closed = closed + 1; results_cached = results_cached + 1;
                    } else { recovery_required = recovery_required + 1; }
                }
            }
        }
    }
    return map{ format: "pblang.process.bounded-maintenance.v1",
        examined: examined, closed: closed,
        active: len(map_keys(_BOUNDED_HANDLES)),
        terminal_cached: usage.cached + results_cached,
        terminal_expired: usage.expired,
        terminal_reserved_payload_bytes: payload_bytes,
        terminal_cache_limit_bytes: MAX_BOUNDED_TERMINAL_BYTES,
        results_cached: results_cached,
        recovery_required: recovery_required,
        raw_state_exposed: false };
}

fn spawn_wait(cmd, args) {
    return proc_spawn_wait(cmd, args);
}

// run(cmd, args) — structured result: { ok, exit_code, stdout, stderr }. Never throws;
// a failed spawn yields ok:false with exit_code -1.
fn run(cmd, args) {
    let r = try proc_spawn_wait(cmd, args) catch nil;
    if r == nil {
        return map{ ok: false, exit_code: 0 - 1, stdout: "", stderr: "failed to spawn `" + str(cmd) + "`" };
    }
    let ec = try r.exit_code catch 1;
    return map{ ok: ec == 0, exit_code: ec, stdout: try r.stdout catch "", stderr: try r.stderr catch "" };
}

// output(cmd, args) — trimmed stdout (empty string on failure).
fn output(cmd, args) { return str_trim(run(cmd, args).stdout); }

// success(cmd, args) — true iff the command exits 0.
fn success(cmd, args) { return run(cmd, args).ok; }

// check_output(cmd, args) — trimmed stdout, or throws on a non-zero exit.
fn check_output(cmd, args) {
    let r = run(cmd, args);
    if not r.ok { error("command failed (exit " + str(r.exit_code) + "): " + str(cmd)); }
    return str_trim(r.stdout);
}

// which(cmd) — absolute path of an executable on PATH, or nil if not found.
fn which(cmd) {
    let r = try proc_spawn_wait("which", [cmd]) catch nil;
    if r == nil { return nil; }
    let ec = try r.exit_code catch 1;
    if ec != 0 { return nil; }
    let out = str_trim(try r.stdout catch "");
    if out == "" { return nil; }
    return out;
}

// Portable facade for process implementations that provide actual lifecycle
// and resource bounds. Unsupported platforms fail closed and never fall back to
// proc_spawn_wait implicitly.
fn bounded_status() {
    if platform() != "linux" {
        return map{ format: "pblang.process.bounded-status.v1", available: false,
            platform: platform(), backend: "unsupported", raw_fallback: false,
            reason: "no bounded process backend is available for this platform" };
    }
    let status = try _LINUX_PROCESS.status() catch nil;
    if status == nil or not (try status.available catch false) {
        return map{ format: "pblang.process.bounded-status.v1", available: false,
            platform: platform(), backend: "unavailable", raw_fallback: false,
            reason: "the platform process backend is not ready", detail: status };
    }
    return map{ format: "pblang.process.bounded-status.v1", available: true,
        platform: platform(), backend: "linux-process", raw_fallback: false,
        capabilities: status,
        lifecycle: map{ format: "pblang.process.bounded-lifecycle-status.v1",
            max_handles: MAX_BOUNDED_HANDLES,
            terminal_payload_budget_bytes: MAX_BOUNDED_TERMINAL_BYTES,
            default_terminal_retention_ms: BOUNDED_TERMINAL_RETENTION_MS,
            atomic_terminal_reservation: true,
            canonical_terminal_cache: true,
            immutable_terminal_expiry: true,
            raw_state_exposed: false } };
}

// Status maps are mutable language values. Crossing the public/private lifecycle
// boundary therefore requires a structural copy, not a second reference.
fn _detached_status_snapshot(status) {
    let snapshot = try json_parse(json_stringify(status)) catch nil;
    if type(snapshot) != "map"
       or (try snapshot.format catch "") != "pblang.process.bounded-status.v1"
       or type(try snapshot.available catch nil) != "bool"
       or (try snapshot.raw_fallback catch true) {
        throw "process: canonical admission snapshot cannot be detached";
    }
    return snapshot;
}

fn _bounded_unavailable(status = nil) {
    if status == nil { status = bounded_status(); }
    return map{ ok: false, command_ok: false, exit_code: -1, stdout: "", stderr: "",
        error: status.reason, unsupported: true, bounded: false,
        execution_admitted: false, executed: false,
        raw_fallback: false, process_status: status };
}

fn run_bounded(program, args, options) {
    if type(program) != "string" or type(args) != "array" or type(options) != "map" {
        throw "process.run_bounded requires a program, argv array, and options map";
    }
    let admission = bounded_status();
    if not admission.available { return _bounded_unavailable(admission); }
    let result = _LINUX_PROCESS.run(program, args, options);
    result.bounded = true;
    result.execution_admitted = true;
    result.process_status = admission;
    result.raw_fallback = false;
    result.process_backend = "linux-process";
    return result;
}

fn run_fixed_bounded(candidates, args, options) {
    if type(candidates) != "array" or type(args) != "array" or type(options) != "map" {
        throw "process.run_fixed_bounded requires candidates, argv, and options";
    }
    let admission = bounded_status();
    if not admission.available { return _bounded_unavailable(admission); }
    let result = _LINUX_PROCESS.run_fixed(candidates, args, options);
    result.bounded = true;
    result.execution_admitted = true;
    result.process_status = admission;
    result.raw_fallback = false;
    result.process_backend = "linux-process";
    return result;
}

fn start_fixed_bounded(candidates, args, options) {
    if type(candidates) != "array" or type(args) != "array" or type(options) != "map" {
        throw "process.start_fixed_bounded requires candidates, argv, and options";
    }
    let admission = bounded_status();
    if not admission.available { return _bounded_unavailable(admission); }
    maintain_bounded();
    let output_limit = try _bounded_integer(try options.max_output_bytes catch nil,
        1048576, 1, 67108864, "max_output_bytes") catch nil;
    let retention_ms = try _bounded_integer(
        try options._terminal_retention_ms catch nil,
        BOUNDED_TERMINAL_RETENTION_MS, 50,
        BOUNDED_TERMINAL_RETENTION_MS, "_terminal_retention_ms") catch nil;
    if output_limit == nil or retention_ms == nil {
        return map{ format: "pblang.process.bounded-start.v1", ok: false,
            started: false, bounded: true, raw_fallback: false,
            raw_state_exposed: false, error: "invalid bounded lifecycle options" };
    }
    let reservation_bytes = _terminal_reservation(output_limit);
    if reservation_bytes > MAX_BOUNDED_TERMINAL_BYTES {
        return map{ format: "pblang.process.bounded-start.v1", ok: false,
            started: false, bounded: true, raw_fallback: false,
            raw_state_exposed: false,
            error: "terminal result reservation exceeds the global payload budget" };
    }
    let id = try _reserve_bounded(reservation_bytes, retention_ms) catch nil;
    if id == nil {
        return map{ format: "pblang.process.bounded-start.v1", ok: false,
            started: false, bounded: true, raw_fallback: false,
            raw_state_exposed: false,
            error: "bounded lifecycle capacity or terminal-result budget reached" };
    }
    let private_admission = try _detached_status_snapshot(admission) catch nil;
    if private_admission == nil {
        map_remove(_BOUNDED_HANDLES, id);
        return map{ format: "pblang.process.bounded-start.v1", ok: false,
            started: false, bounded: true, raw_fallback: false,
            raw_state_exposed: false,
            error: "canonical admission snapshot cannot be retained privately" };
    }
    _BOUNDED_HANDLES[id].process_status = private_admission;
    let launch_options = map{};
    for key in map_keys(options) {
        if key != "_terminal_retention_ms" { launch_options[key] = options[key]; }
    }
    launch_options._require_pidfd = true;
    let raw = try _LINUX_PROCESS.start_fixed(candidates, args, launch_options) catch nil;
    if raw == nil {
        map_remove(_BOUNDED_HANDLES, id);
        return map{ format: "pblang.process.bounded-start.v1", ok: false,
            started: false, bounded: true, raw_fallback: false,
            raw_state_exposed: false, error: "bounded process start failed" };
    }
    if not (try raw.ok catch false) {
        if (try raw.requires_recovery catch false) or (try raw.active catch false) {
            let current = num_floor(now_ms());
            let state = _BOUNDED_HANDLES[id]; state.raw = raw;
            state.last_used_ms = current; state.launching = false;
            state.cancel_requested = false;
            state.recovery_after_ms = current + BOUNDED_RECOVERY_GRACE_MS;
            state.race_resistant_identity = try raw.race_resistant_identity catch false;
            state.phase = "recovery";
            return map{ format: BOUNDED_HANDLE_FORMAT, id: id, ok: false,
                started: true, bounded: true, raw_fallback: false,
                requires_recovery: true, raw_state_exposed: false,
                error: try raw.error catch "bounded process ownership requires recovery" };
        }
        map_remove(_BOUNDED_HANDLES, id);
        return map{ format: "pblang.process.bounded-start.v1", ok: false,
            started: false, bounded: true, raw_fallback: false,
            raw_state_exposed: false,
            error: try raw.error catch "bounded process start failed" };
    }
    let current = num_floor(now_ms());
    let state = _BOUNDED_HANDLES[id]; state.raw = raw;
    state.last_used_ms = current; state.launching = false;
    state.cancel_requested = false;
    state.recovery_after_ms = current + raw.timeout_secs * 1000
        + BOUNDED_RECOVERY_GRACE_MS;
    state.race_resistant_identity = try raw.race_resistant_identity catch false;
    state.phase = "running";
    return map{ format: BOUNDED_HANDLE_FORMAT, id: id, ok: true,
        started: true, bounded: true, raw_fallback: false,
        execution_admitted: true,
        process_status: _detached_status_snapshot(private_admission),
        raw_state_exposed: false };
}

fn poll_bounded(handle) {
    let state = _bounded_state(handle);
    if (try state.phase catch "") == "terminal_cached" {
        return map{ format: "pblang.process.bounded-poll.v1", ok: true,
            complete: true, active: false, terminated: true,
            startup_pending: false, startup_failed: false,
            cancel_requested: false, term_sent: false, kill_sent: false,
            liveness: "absent", elapsed_ms: 0,
            race_resistant_identity: state.race_resistant_identity,
            terminal_cached: true,
            raw_state_exposed: false };
    }
    let view = _bounded_poll_view(_LINUX_PROCESS.poll(state.raw));
    view.race_resistant_identity = try state.raw.race_resistant_identity catch false;
    return view;
}

fn request_cancel_bounded(handle, grace_ms = 500) {
    let state = _bounded_state(handle);
    if (try state.phase catch "") == "terminal_cached" {
        return map{ format: "pblang.process.bounded-cancel.v1",
            ok: true, requested: false, terminated: true,
            term_sent: false, kill_sent: false, liveness: "absent",
            race_resistant_identity: state.race_resistant_identity,
            terminal_cached: true,
            raw_state_exposed: false };
    }
    let result = _LINUX_PROCESS.request_cancel(state.raw, grace_ms);
    state.cancel_requested = true;
    return map{ format: "pblang.process.bounded-cancel.v1",
        ok: try result.ok catch false, requested: try result.requested catch false,
        terminated: try result.terminated catch false,
        term_sent: try result.term_sent catch false,
        kill_sent: try result.kill_sent catch false,
        liveness: try result.liveness catch "indeterminate",
        race_resistant_identity: try state.raw.race_resistant_identity catch false,
        raw_state_exposed: false };
}

fn finish_bounded(handle, wait_ms = nil) {
    let state = _bounded_state(handle);
    let result = map{}; let result_was_cached = false;
    if (try state.phase catch "") == "terminal_cached" {
        result = try _expand_terminal_result(state.terminal_compact) catch nil;
        if result == nil {
            result = _terminal_failure_result("cached terminal result validation failed");
        }
        result_was_cached = true;
    } else {
        result = _LINUX_PROCESS.finish(state.raw, wait_ms);
    }
    if type(result) != "map" {
        result = map{ ok: false, completed: false, command_ok: false,
            process_group_terminated: false, cleanup_deferred: true,
            error: "bounded process result is unavailable" };
    }
    let terminal = _bounded_terminal_result(result);
    if terminal and not result_was_cached {
        let compact = try _compact_terminal_result(result) catch nil;
        if compact == nil or compact.payload_bytes > state.terminal_reservation_bytes {
            result = _terminal_failure_result(
                "terminal result normalization exceeded its reserved budget");
        } else {
            result = try _expand_terminal_result(compact) catch nil;
            if result == nil {
                result = _terminal_failure_result("terminal result validation failed");
            }
        }
    }
    try map_remove(result, "process_group_id") catch nil;
    result.format = "pblang.process.bounded-result.v1";
    result.bounded = true; result.raw_fallback = false;
    result.execution_admitted = true;
    result.process_status = _detached_status_snapshot(state.process_status);
    result.race_resistant_identity = state.race_resistant_identity;
    result.raw_state_exposed = false; result.handle_closed = terminal;
    result.requires_recovery = not terminal;
    result.result_was_cached = result_was_cached;
    result.lifecycle_phase = if terminal { "claimed" } else { state.phase };
    if terminal {
        state.phase = "claimed"; state.terminal_compact = nil;
        map_remove(_BOUNDED_HANDLES, handle.id);
    }
    return result;
}

fn close_bounded(handle, grace_ms = 250, wait_ms = 1500) {
    request_cancel_bounded(handle, grace_ms);
    return finish_bounded(handle, wait_ms);
}

export spawn_wait, run, output, success, check_output, which;
export BOUNDED_HANDLE_FORMAT, bounded_status, run_bounded, run_fixed_bounded,
       start_fixed_bounded, poll_bounded, request_cancel_bounded,
       finish_bounded, close_bounded, maintain_bounded;
