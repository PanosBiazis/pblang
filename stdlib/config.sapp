// stdlib/config.sapp — Application configuration management
//
// Layered config: defaults → environment variables → explicit overrides.
// All values are stored as strings; typed accessors coerce on read.
//
// Usage:
//   let config = import("stdlib:config.sapp");
//   let cfg = config.new();
//   config.set(cfg, "port", "8080");
//   config.set_default(cfg, "host", "localhost");
//   config.load_env(cfg, "APP_");  // loads APP_PORT, APP_HOST etc.
//   let port = config.get_int(cfg, "port", 3000);

let validate_mod = import("stdlib:validate.sapp");

// new() → config map
fn new() {
    return map{
        _data:     map{},
        _defaults: map{},
        _prefix:   ""
    };
}

fn from_map(values = nil, defaults = nil) {
    let cfg = new();
    if type(defaults) == "map" { set_defaults(cfg, defaults); }
    if type(values) == "map" { merge(cfg, values); }
    return cfg;
}

// set(cfg, key, value) — set a value (overrides defaults and env)
fn set(cfg, key, value) {
    cfg._data[key] = str(value);
    return cfg;
}

// set_default(cfg, key, value) — set a default (lower priority than set/env)
fn set_default(cfg, key, value) {
    cfg._defaults[key] = str(value);
    return cfg;
}

fn set_many(cfg, values) {
    return merge(cfg, values);
}

fn set_defaults(cfg, values) {
    let keys = map_keys(values);
    for i len(keys) {
        set_default(cfg, keys[i], values[keys[i]]);
    }
    return cfg;
}

fn unset(cfg, key) {
    if map_has(cfg._data, key) { map_remove(cfg._data, key); }
    return cfg;
}

fn has(cfg, key) {
    return get(cfg, key, nil) != nil;
}

fn keys(cfg) {
    let seen = map{};
    let out = [];
    let dk = map_keys(cfg._defaults);
    for i len(dk) {
        seen[dk[i]] = true;
        array_push(out, dk[i]);
    }
    let kk = map_keys(cfg._data);
    for i len(kk) {
        if map_has(seen, kk[i]) == false {
            seen[kk[i]] = true;
            array_push(out, kk[i]);
        }
    }
    return out;
}

fn _env_name(key) {
    let out = "";
    let i = 0;
    while i < len(key) {
        let code = strcharcodeat(key, i);
        let ch = str_slice(key, i, i + 1);
        if code >= 97 and code <= 122 {
            out = out + str(strfromcharcode(code - 32));
        } else if (code >= 65 and code <= 90) or (code >= 48 and code <= 57) {
            out = out + ch;
        } else {
            out = out + "_";
        }
        i = i + 1;
    }
    return out;
}

// get(cfg, key, fallback) → string | fallback
// Priority: _data → env → _defaults → fallback
fn get(cfg, key, fallback) {
    // Check explicit data
    if map_has(cfg._data, key) { return cfg._data[key]; }

    // Check environment (prefix + uppercase key)
    let env_key = cfg._prefix + key;
    let env_val = try env_get(env_key) catch nil;
    if env_val != nil { return env_val; }

    // Check uppercase env
    let upper_key = cfg._prefix + str_upper(key);
    let upper_val = try env_get(upper_key) catch nil;
    if upper_val != nil { return upper_val; }

    // Check normalized env name (database.url -> DATABASE_URL)
    let norm_key = cfg._prefix + _env_name(key);
    let norm_val = try env_get(norm_key) catch nil;
    if norm_val != nil { return norm_val; }

    // Check defaults
    if map_has(cfg._defaults, key) { return cfg._defaults[key]; }

    return fallback;
}

// get_int(cfg, key, fallback) → number
fn get_int(cfg, key, fallback) {
    let v = get(cfg, key, nil);
    if v == nil { return fallback; }
    let n = try parse_number(v) catch nil;
    if n == nil { return fallback; }
    if num_floor(n) != n { return fallback; }
    return n;
}

fn get_number(cfg, key, fallback) {
    let v = get(cfg, key, nil);
    if v == nil { return fallback; }
    let n = try parse_number(v) catch nil;
    if n == nil { return fallback; }
    return n;
}

// get_bool(cfg, key, fallback) → bool
fn get_bool(cfg, key, fallback) {
    let v = get(cfg, key, nil);
    if v == nil { return fallback; }
    if v == "true" or v == "1" or v == "yes" or v == "on" { return true; }
    if v == "false" or v == "0" or v == "no" or v == "off" { return false; }
    return fallback;
}

// get_float(cfg, key, fallback) → number
fn get_float(cfg, key, fallback) { return get_number(cfg, key, fallback); }

// get_list(cfg, key, sep, fallback) → array<string>
// Splits value by separator; returns fallback array if not set.
fn get_list(cfg, key, sep, fallback) {
    let v = get(cfg, key, nil);
    if v == nil { return fallback; }
    let parts = str_split(v, sep);
    let out = [];
    for i len(parts) {
        array_push(out, str_trim(parts[i]));
    }
    return out;
}

// set_prefix(cfg, prefix) — set env var prefix for load_env
fn set_prefix(cfg, prefix) {
    cfg._prefix = prefix;
    return cfg;
}

// load_env(cfg, prefix) — load all env vars with given prefix (strips prefix from key)
// Example: load_env(cfg, "APP_") maps APP_PORT → port
fn load_env(cfg, prefix) {
    cfg._prefix = prefix;
    // Note: we can only read individual env vars; there's no "list all env vars" builtin.
    // This sets the prefix so get() will check env vars automatically.
    return cfg;
}

// require(cfg, key) — get a value or throw if missing
fn require(cfg, key) {
    let v = get(cfg, key, nil);
    if v == nil {
        throw "config: required key '" + key + "' is not set";
    }
    return v;
}

fn require_int(cfg, key) {
    let v = require(cfg, key);
    let n = try parse_number(v) catch nil;
    if n == nil or num_floor(n) != n {
        throw "config: required key '" + key + "' must be an integer";
    }
    return n;
}

fn require_bool(cfg, key) {
    require(cfg, key);   // throws when the key is missing
    let b = get_bool(cfg, key, nil);
    if b == nil {
        throw "config: required key '" + key + "' must be a bool";
    }
    return b;
}

// merge(cfg, other_map) — merge a map of key=value pairs into cfg
fn merge(cfg, other_map) {
    let keys = map_keys(other_map);
    let i = 0;
    while i < len(keys) {
        cfg._data[keys[i]] = str(other_map[keys[i]]);
        i = i + 1;
    }
    return cfg;
}

// to_map(cfg) → map of all resolved key-value pairs (data + defaults)
fn to_map(cfg) {
    let result = map{};
    // Add defaults first (lowest priority)
    let dk = map_keys(cfg._defaults);
    let i = 0;
    while i < len(dk) {
        result[dk[i]] = cfg._defaults[dk[i]];
        i = i + 1;
    }
    // Override with data
    let ddk = map_keys(cfg._data);
    let j = 0;
    while j < len(ddk) {
        result[ddk[j]] = cfg._data[ddk[j]];
        j = j + 1;
    }
    return result;
}

fn typed_map(cfg, schema_def = nil) {
    let out = map{};
    let names = keys(cfg);
    for i len(names) {
        let name = names[i];
        let val = get(cfg, name, nil);
        if schema_def != nil and type(schema_def) == "map" and (try schema_def.__schema catch false) == true {
            let fdef = try schema_def.fields[name] catch nil;
            if fdef != nil {
                let t = try fdef.type catch "string";
                if t == "number" { val = get_number(cfg, name, val); }
                else if t == "bool" { val = get_bool(cfg, name, val); }
                else if t == "array" { val = get_list(cfg, name, ",", []); }
            }
        }
        out[name] = val;
    }
    return out;
}

fn validate(cfg, schema_def) {
    return validate_mod.check(schema_def, typed_map(cfg, schema_def));
}

fn validate_with_defaults(cfg, schema_def) {
    let typed = typed_map(cfg, schema_def);
    return validate_mod.check_with_defaults(schema_def, typed);
}

// ── .env (dotenv) support ──────────────────────────────────────────────────────

// Unescape the sequences dump_dotenv emits inside double-quoted values
// (\\, \", \n, \r). Unknown escapes are kept verbatim — standard dotenv
// semantics, and what makes dump -> parse a true round trip.
fn _dotenv_unescape(s) {
    let out = "";
    let i = 0;
    let n = len(s);
    while i < n {
        let ch = str_slice(s, i, i + 1);
        if ch == "\\" and i + 1 < n {
            let nx = str_slice(s, i + 1, i + 2);
            if nx == "n" { out = out + "\n"; i = i + 2; }
            else if nx == "r" { out = out + "\r"; i = i + 2; }
            else if nx == "\"" { out = out + "\""; i = i + 2; }
            else if nx == "\\" { out = out + "\\"; i = i + 2; }
            else { out = out + ch; i = i + 1; }
        } else {
            out = out + ch;
            i = i + 1;
        }
    }
    return out;
}

// parse_dotenv(text) → map. Parses KEY=VALUE lines: skips blanks and #-comments,
// tolerates an "export " prefix, and strips one layer of surrounding quotes.
// Double-quoted values get escape processing (\\, \", \n, \r); single-quoted
// values are literal — the usual dotenv convention.
fn parse_dotenv(text) {
    let out = map{};
    let lines = str_split(text, "\n");
    let i = 0;
    while i < len(lines) {
        let line = str_trim(lines[i]);
        i = i + 1;
        if line == "" or str_slice(line, 0, 1) == "#" { continue; }
        if len(line) > 7 and str_slice(line, 0, 7) == "export " { line = str_trim(str_slice(line, 7, len(line))); }
        let eq = str_index_of(line, "=");
        if eq < 0 { continue; }
        let k = str_trim(str_slice(line, 0, eq));
        let v = str_trim(str_slice(line, eq + 1, len(line)));
        if len(v) >= 2 {
            let f = str_slice(v, 0, 1);
            let l = str_slice(v, len(v) - 1, len(v));
            if f == "\"" and l == "\"" { v = _dotenv_unescape(str_slice(v, 1, len(v) - 1)); }
            else if f == "'" and l == "'" { v = str_slice(v, 1, len(v) - 1); }
        }
        out[k] = v;
    }
    return out;
}

// load_dotenv(cfg, path) — read a .env file and merge it (no-op if unreadable).
fn load_dotenv(cfg, path) {
    let txt = try fs_read(path) catch nil;
    if txt == nil { return cfg; }
    return merge(cfg, parse_dotenv(txt));
}

// A value must be double-quoted when the unquoted form would not survive
// parse_dotenv: whitespace/# content, quote or backslash characters, line
// breaks, or edge whitespace that the parser's trim would eat.
fn _dotenv_quote(v) {
    let needs = str_contains(v, " ") or str_contains(v, "\t") or str_contains(v, "#")
        or str_contains(v, "\"") or str_contains(v, "'") or str_contains(v, "\\")
        or str_contains(v, "\n") or str_contains(v, "\r")
        or (v != "" and str_trim(v) != v);
    if needs == false { return v; }
    let e = str_replace_all(v, "\\", "\\\\");
    e = str_replace_all(e, "\"", "\\\"");
    e = str_replace_all(e, "\n", "\\n");
    e = str_replace_all(e, "\r", "\\r");
    return "\"" + e + "\"";
}

// dump_dotenv(cfg) — serialize the resolved config to .env text. Values that
// would not re-parse verbatim are double-quoted with escaping, so
// parse_dotenv(dump_dotenv(cfg)) always returns the original values.
fn dump_dotenv(cfg) {
    let m = to_map(cfg);
    let ks = map_keys(m);
    let out = "";
    let i = 0;
    while i < len(ks) {
        out = out + ks[i] + "=" + _dotenv_quote(str(m[ks[i]])) + "\n";
        i = i + 1;
    }
    return out;
}

// get_json(cfg, key, fallback) — parse the value as JSON, or return fallback.
fn get_json(cfg, key, fallback) {
    let v = get(cfg, key, nil);
    if v == nil { return fallback; }
    return try json_parse(v) catch fallback;
}

fn str_upper(s) {
    // Simple ASCII uppercasing
    let result = "";
    let i = 0;
    while i < len(s) {
        let c = str_slice(s, i, i + 1);
        let code = strcharcodeat(s, i);
        if code >= 97 and code <= 122 {
            result = result + str(strfromcharcode(code - 32));
        } else {
            result = result + c;
        }
        i = i + 1;
    }
    return result;
}

export new, from_map, set, set_many, set_default, set_defaults, unset, has, keys,
       get, get_int, get_number, get_bool, get_float, get_list,
       set_prefix, load_env, require, require_int, require_bool, merge, to_map,
       typed_map, validate, validate_with_defaults,
       parse_dotenv, load_dotenv, dump_dotenv, get_json;
