let Writer=import("stdlib:text_document_files.sapp");let Document=import("stdlib:task_plan_document.sapp");
let Doc=import("stdlib:task_plan.sapp");let File=import("stdlib:secure_file.sapp");
fn _path(path) {return type(path)=="string" and len(path)>7 and len(path)<=4096 and len(str_to_bytes(path))<=4096 and not str_contains(path,"\u0000") and str_ends_with(str_lower(path),".pbplan");}
fn open(path) {if not _path(path) {return map{ok:false,error:"Choose a .pbplan file."};}let r=try File.read_text(path,Doc.MAX_FILE_BYTES,false) catch nil;if r==nil or not r.ok {return map{ok:false,error:"Could not read the plan."};}let doc=try Doc.decode(r.text) catch nil;if doc==nil {return map{ok:false,error:"Invalid or unsupported plan."};}return map{ok:true,document:doc};}
fn save(path,doc) {if not _path(path) {return map{ok:false,error:"Choose a new .pbplan filename."};}let text=try Doc.encode(doc) catch nil;if text==nil {return map{ok:false,error:"Invalid plan; nothing written."};}let r=try File.write_text_new_exclusive(path,text,false,false) catch nil;if r==nil or not r.ok {return map{ok:false,error:"Copy not confirmed. Use a new filename; a failed copy may be incomplete."};}return map{ok:true,atomic_visibility:false};}
fn export_writer(path,doc) {
 let document=try Document.create(doc) catch nil;
 if document==nil {return map{ok:false,error:"Plan does not fit a supported Writer document; nothing written."};}
 return Writer.save_copy(path,document);
}
export open,save,export_writer;
