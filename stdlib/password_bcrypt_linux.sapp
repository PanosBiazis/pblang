// Linux libxcrypt boundary. Serialized calls only: crypt uses static native storage.
// No polyglot source; the password KDF remains a trusted system-library dependency.
let ALPHABET = "./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
fn valid_hash(value) {
    if type(value) != "string" or len(value) != 60 or not str_starts_with(value, "$2b$12$") { return false; }
    for ch in str_split(str_slice(value, 7, 60), "") { if not str_contains(ALPHABET, ch) { return false; } }
    return str_contains(".Oeu", value[28]) and str_contains(".CGKOSWaeimquy26", value[59]);
}

fn _password(value, minimum) {
    if type(value) != "string" or len(value) > 72 { throw "password: invalid length"; }
    let size = len(str_to_bytes(value));
    if size < minimum or size > 72 or str_contains(value, strfromcharcode(0)) { throw "password: invalid byte length or NUL"; }
}

fn _salt() {
    let bytes = random_bytes(16); let out = ""; let i = 0;
    while i < 16 {
        let a = bytes[i]; i = i + 1;
        out = out + ALPHABET[bit_shr(a, 2)];
        let b = bit_shl(bit_and(a, 3), 4);
        if i == 16 { out = out + ALPHABET[b]; break; }
        let c = bytes[i]; i = i + 1;
        out = out + ALPHABET[bit_or(b, bit_shr(c, 4))];
        b = bit_shl(bit_and(c, 15), 2);
        if i == 16 { out = out + ALPHABET[b]; break; }
        c = bytes[i]; i = i + 1;
        out = out + ALPHABET[bit_or(b, bit_shr(c, 6))] + ALPHABET[bit_and(c, 63)];
    }
    return "$2b$12$" + out;
}

fn _crypt(state, password, setting) {
    if state.closed or state.busy { throw "password: closed or reentrant provider"; }
    state.busy = true;
    let result = try ffi_call_typed(state.library, "crypt", "string,string->string", [password, setting]) catch nil;
    state.busy = false;
    if not valid_hash(result) { throw "password: bcrypt unavailable or failed"; }
    return result;
}

fn open() {
    if platform() != "linux" { throw "password: Linux libxcrypt required"; }
    let library = nil;
    // Fixed system paths, no working-directory or environment library search.
    for path in ["/lib/x86_64-linux-gnu/libcrypt.so.1", "/usr/lib/x86_64-linux-gnu/libcrypt.so.1"] {
        if library == nil { library = try ffi_load(path) catch nil; }
    }
    if library == nil { throw "password: supported Linux x86-64 libxcrypt unavailable"; }
    let state = map{library:library, closed:false, busy:false};
    return map{
        hash:fn(password){ _password(password, 15); return _crypt(state, password, _salt()); },
        verify:fn(password, encoded){
            _password(password, 1);
            if not valid_hash(encoded) { throw "password: unsupported hash or cost"; }
            return constant_time_eq(_crypt(state, password, encoded), encoded);
        },
        close:fn(){ if not state.closed { state.closed=true; ffi_close(state.library); } return true; }
    };
}
export open, valid_hash;
