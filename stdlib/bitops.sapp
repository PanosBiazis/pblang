//! bitops.sapp — Bit-level operations for pblang
//! Provides bitwise AND, OR, XOR, NOT, shift operations.
//! These are essential for systems programming, crypto, and performance.

// ── Core Bit Operations ────────────────────────────────────────────────

/// Bitwise AND: a & b
fn bit_and(a, b) {
    if a < 0 or b < 0 {
        return error("bit_and: negative numbers not supported for bitwise ops");
    }
    let result = 0;
    let bit = 1;
    while a > 0 and b > 0 {
        if (a % 2 == 1) and (b % 2 == 1) {
            result = result + bit;
        }
        a = (a - (a % 2)) / 2;
        b = (b - (b % 2)) / 2;
        bit = bit * 2;
    }
    return result;
}

/// Bitwise OR: a | b
fn bit_or(a, b) {
    if a < 0 or b < 0 {
        return error("bit_or: negative numbers not supported");
    }
    let result = 0;
    let bit = 1;
    while a > 0 or b > 0 {
        if (a % 2 == 1) or (b % 2 == 1) {
            result = result + bit;
        }
        a = (a - (a % 2)) / 2;
        b = (b - (b % 2)) / 2;
        bit = bit * 2;
    }
    return result;
}

/// Bitwise XOR: a ^ b
fn bit_xor(a, b) {
    if a < 0 or b < 0 {
        return error("bit_xor: negative numbers not supported");
    }
    let result = 0;
    let bit = 1;
    while a > 0 or b > 0 {
        let a_bit = a % 2;
        let b_bit = b % 2;
        if a_bit != b_bit {
            result = result + bit;
        }
        a = (a - a_bit) / 2;
        b = (b - b_bit) / 2;
        bit = bit * 2;
    }
    return result;
}

/// Bitwise NOT (one's complement) of n within given bit width
fn bit_not(n, bit_width) {
    if n < 0 {
        return error("bit_not: negative numbers not supported");
    }
    let mask = 0;
    let tmp = 1;
    let i = 0;
    while i < bit_width {
        mask = mask + tmp;
        tmp = tmp * 2;
        i = i + 1;
    }
    return mask - n;
}

/// Left shift: n << bits
fn bit_shl(n, bits) {
    if bits < 0 {
        return error("bit_shl: negative shift count");
    }
    let result = n;
    let i = 0;
    while i < bits {
        result = result * 2;
        i = i + 1;
    }
    return result;
}

/// Right shift: n >> bits
fn bit_shr(n, bits) {
    if bits < 0 {
        return error("bit_shr: negative shift count");
    }
    let result = n;
    let i = 0;
    while i < bits {
        result = (result - (result % 2)) / 2;
        i = i + 1;
    }
    return result;
}

// ── Bit Testing ────────────────────────────────────────────────────────

fn bit_test(n, k) {
    if n < 0 or k < 0 { return false; }
    let shifted = bit_shr(n, k);
    return shifted % 2 == 1;
}

fn bit_set(n, k) {
    let mask = bit_shl(1, k);
    return bit_or(n, mask);
}

fn bit_clear(n, k) {
    if bit_test(n, k) {
        let mask = bit_shl(1, k);
        return n - mask;
    }
    return n;
}

fn bit_toggle(n, k) {
    let mask = bit_shl(1, k);
    return bit_xor(n, mask);
}

// ── Population Count ───────────────────────────────────────────────────

fn popcount(n) {
    if n < 0 { return 0; }
    let count = 0;
    while n > 0 {
        if n % 2 == 1 { count = count + 1; }
        n = (n - (n % 2)) / 2;
    }
    return count;
}

fn clz(n) {
    if n <= 0 { return 64; }
    let count = 0;
    let bit = 1;
    let i = 0;
    while i < 63 { bit = bit * 2; i = i + 1; }
    while bit > 0 and bit > n {
        count = count + 1;
        bit = (bit - (bit % 2)) / 2;
    }
    return count;
}

fn ctz(n) {
    if n <= 0 { return 64; }
    let count = 0;
    let tmp = n;
    while tmp % 2 == 0 and tmp > 0 {
        count = count + 1;
        tmp = (tmp - (tmp % 2)) / 2;
    }
    return count;
}

// ── Bit Manipulation ───────────────────────────────────────────────────

fn bit_lowest(n) {
    if n <= 0 { return 0; }
    return n - bit_and(n, n - 1);
}

fn bit_clear_lowest(n) { return bit_and(n, n - 1); }

fn is_power_of_two(n) {
    if n <= 0 { return false; }
    return bit_and(n, n - 1) == 0;
}

fn next_power_of_two(n) {
    if n <= 1 { return 1; }
    let result = 1;
    while result < n { result = result * 2; }
    return result;
}

// ── Bit Range ──────────────────────────────────────────────────────────

fn bit_range(n, high, low) {
    if low < 0 or high < low { return 0; }
    let shifted = bit_shr(n, low);
    let mask_count = high - low + 1;
    let mask = 0;
    let tmp = 1;
    let i = 0;
    while i < mask_count { mask = mask + tmp; tmp = tmp * 2; i = i + 1; }
    return bit_and(shifted, mask);
}

fn rotl(n, bits, width) {
    let mask = 0;
    let tmp = 1;
    let i = 0;
    while i < width { mask = mask + tmp; tmp = tmp * 2; i = i + 1; }
    let masked = bit_and(n, mask);
    let left = bit_and(bit_shl(masked, bits), mask);
    let right = bit_shr(masked, width - bits);
    return bit_or(left, right);
}

fn rotr(n, bits, width) { return rotl(n, width - bits, width); }

// ── Endianness ─────────────────────────────────────────────────────────

fn bswap32(n) {
    let b0 = bit_range(n, 7, 0);
    let b1 = bit_range(n, 15, 8);
    let b2 = bit_range(n, 23, 16);
    let b3 = bit_range(n, 31, 24);
    return bit_or(bit_or(bit_shl(b0, 24), bit_shl(b1, 16)), bit_or(bit_shl(b2, 8), b3));
}

fn to_binary_string(n, min_width) {
    if n < 0 { return "negative"; }
    if n == 0 {
        let result = "0";
        let i = len(result);
        while i < min_width { result = "0" + result; i = i + 1; }
        return result;
    }
    let result = "";
    let tmp = n;
    while tmp > 0 {
        if tmp % 2 == 1 { result = "1" + result; } else { result = "0" + result; }
        tmp = (tmp - (tmp % 2)) / 2;
    }
    let i = len(result);
    while i < min_width { result = "0" + result; i = i + 1; }
    return result;
}

fn from_binary_string(s) {
    let result = 0;
    let i = 0;
    let len = len(s);
    while i < len {
        result = result * 2;
        let ch = s[i..(i+1)];
        if ch == "1" { result = result + 1; } else { if ch != "0" { return error("invalid char"); } }
        i = i + 1;
    }
    return result;
}

fn to_hex_string(n, min_width) {
    const HEX = "0123456789abcdef";
    if n == 0 {
        let result = "0";
        let i = len(result);
        while i < min_width { result = "0" + result; i = i + 1; }
        return result;
    }
    let result = "";
    let tmp = n;
    while tmp > 0 {
        let digit = tmp % 16;
        result = HEX[digit..(digit+1)] + result;
        tmp = (tmp - digit) / 16;
    }
    let i = len(result);
    while i < min_width { result = "0" + result; i = i + 1; }
    return result;
}

// ── Exports ────────────────────────────────────────────────────────────
export bit_and;
export bit_or;
export bit_xor;
export bit_not;
export bit_shl;
export bit_shr;
export bit_test;
export bit_set;
export bit_clear;
export bit_toggle;
export popcount;
export clz;
export ctz;
export bit_lowest;
export bit_clear_lowest;
export is_power_of_two;
export next_power_of_two;
export bit_range;
export rotl;
export rotr;
export bswap32;
export to_binary_string;
export from_binary_string;
export to_hex_string;
