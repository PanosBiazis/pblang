let Stats=import("stdlib:table_group_stats.sapp");
let Files=import("stdlib:table_files.sapp");
let Sheet=import("stdlib:sheet_document.sapp");
let CSV=import("stdlib:sheet_csv.sapp");
let Pages=import("stdlib:text_pages.sapp");
let Cell=import("stdlib:table_cell_view.sapp");
let UI=import("stdlib:modern_ui.sapp");
let G=import("stdlib:gui.sapp");
fn sample(){return CSV.decode("Team,Hours\nDesign,0.1\nBuild,2.5\nDesign,0.2\nBuild,-0.5\n");}
fn view(doc,row=1){return Cell.create(doc,row,"PBGroupStats");}
fn _message(form,text){let w=G.get(form,"status");w.text=text;form.dirty=true;}
fn _delimiter(form){let n=G.get(form,"delimiter").selected;if type(n)!="number" or n!=num_floor(n) or n<0 or n>2{throw "table stats: invalid delimiter";}return [",",";","\t"][n];}
fn _settings(form){return json_stringify([G.get(form,"category").selected,G.get(form,"value").selected]);}
fn _derive(form,doc,header){return Stats.summarize(doc,G.get(form,"category").selected,G.get(form,"value").selected,header);}
fn _show(form,state){let lines=[];for i in range(state.screen*12,num_min((state.screen+1)*12,len(state.lines))){array_push(lines,state.lines[i]);}let area=G.get(form,"result");area.value=str_join(lines,"\n");let label=G.get(form,"summary");label.text=str(len(state.result.cells)-1)+" categories | Text screen "+str(state.screen+1)+" / "+str(num_max(1,num_ceil(len(state.lines)/12)));form.dirty=true;}
fn refresh(form,state){let lines=[];for row in state.result.cells{for line in Pages.wrap(CSV.encode(map{format:Sheet.FORMAT,cells:[row]}),72){array_push(lines,line);}}state.lines=lines;state.screen=0;_show(form,state);}
fn act(form,state,action){
    if action=="open"{let delimiter=try _delimiter(form) catch nil;let header=G.get(form,"header").selected;
        if delimiter==nil or (header!=0 and header!=1){_message(form,"Choose delimiter and header mode.");return;}
        let loaded=Files.open(G.get(form,"input").value,delimiter);
        if not loaded.ok{_message(form,loaded.error);return;}
        let result=try _derive(form,loaded.document,header==1) catch nil;
        if result==nil{_message(form,"Invalid columns, numeric values or output limits. Previous result retained.");return;}
        state.doc=loaded.document;state.header=header==1;state.result=result;state.settings=_settings(form);refresh(form,state);_message(form,"Loaded and calculated. Source unchanged.");return;
    }
    if action=="calculate"{let result=try _derive(form,state.doc,state.header) catch nil;
        if result==nil{_message(form,"Invalid columns, numeric values or output limits. Previous result retained.");return;}
        state.result=result;state.settings=_settings(form);refresh(form,state);_message(form,"Calculated from the loaded table.");return;
    }
    if action=="previous"{state.screen=num_max(0,state.screen-1);_show(form,state);return;}
    if action=="next"{state.screen=num_min(num_max(0,num_ceil(len(state.lines)/12)-1),state.screen+1);_show(form,state);return;}
    if action=="csv" or action=="sheet"{
        if state.settings!=_settings(form){_message(form,"Calculate selected columns before exporting.");return;}
        let delimiter=try _delimiter(form) catch nil;if delimiter==nil{_message(form,"Choose an output delimiter.");return;}
        let saved=Files.save(G.get(form,"output").value,state.result,action,delimiter);
        if saved.ok {_message(form,"New summary saved. Loaded source unchanged.");} else {_message(form,saved.error);}
    }
}
fn _button(state,label,action){return UI.button(label,fn(form){act(form,state,action);},map{name:action});}
fn build(){let doc=sample();let state=map{doc:doc,header:true,result:Stats.summarize(doc,0,1,true),settings:"",screen:0,lines:[]};let columns=["Column 1","Column 2","Column 3","Column 4","Column 5","Column 6","Column 7","Column 8"];
    let children=[UI.heading("PBGroupStats"),UI.text("Count, sum, minimum and maximum by exact category."),UI.input("",map{name:"input",placeholder:"Input .csv, .tsv or .pbsheet",max_chars:4096}),UI.row([UI.choice(["Comma","Semicolon","Tab"],0,nil,map{name:"delimiter"}),UI.choice(["Every row is data","First row is header"],1,nil,map{name:"header"}),_button(state,"Open and calculate","open")]),UI.text("Header applies on Open. Calculations use the loaded table."),UI.row([UI.choice(columns,0,nil,map{name:"category"}),UI.choice(columns,1,nil,map{name:"value"}),_button(state,"Calculate","calculate")]),UI.text("First selector: category. Second: decimal value. Blank/non-numeric values reject."),UI.text("",map{name:"summary"}),UI.area("",map{name:"result",readonly:true,h:240,max_chars:8192}),UI.row([_button(state,"Previous text screen","previous"),_button(state,"Next text screen","next")]),UI.input("",map{name:"output",placeholder:"New summary .csv, .tsv or .pbsheet",max_chars:4096}),UI.row([_button(state,"Export delimited summary","csv"),_button(state,"Save for Sheets","sheet")]),UI.text("",map{name:"status"})];
    let form=UI.build("PBGroupStats",UI.screen(children),map{width:1100,height:1000,theme:"dark"});state.settings=_settings(form);refresh(form,state);_message(form,"Synthetic team-hours example. No rounding or automatic unit conversion.");return map{form:form,state:state};
}
fn run(){let e=build();G.run(e.form);}
export sample,view,build,act,refresh,run;
