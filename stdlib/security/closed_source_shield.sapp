// stdlib/security/closed_source_shield.sapp — Unified Cross-Edition Anti-REA,
// Anti-LLM, Anti-Scraping, Confidential Visual Vault & Split-Execution Engine (PBLang v4.1.0).
//
// 100% Pure PBLang (Zero C, Zero Python, Zero external toolchains).
// Covers Web HTML5/Canvas, WASM32 PWA, Native Desktop GUI, CLI/AOT Binaries,
// Android Dalvik DEX/APK, Apple iOS ARM64 Mach-O, and Hybrid Client/Server Vaults.

let _SHA256 = import("stdlib:sha256_pb.sapp");
let _BUILTINS = import("stdlib:compiler/builtins_list.sapp");

let SHIELD_VERSION = "4.1.0";
let _MASK32 = 4294967295; // 0xFFFFFFFF
let CANARY_MAGIC = "PBCN";

// Win32 / Android / iOS / X11 OS Hardware Capture Affinity Constants
let WIN32_WDA_NONE = 0;
let WIN32_WDA_MONITOR = 1;
let WIN32_WDA_EXCLUDEFROMCAPTURE = 17; // 0x00000011 (Windows 10 2004+ / Windows 11 hardware DRM veil)
let ANDROID_FLAG_SECURE = 8192;        // 0x00002000 (WindowManager.LayoutParams.FLAG_SECURE)

fn _err(msg) {
    throw "closed_source_shield: " + str(msg);
}

fn _is_map_val(v) {
    return v != nil and is_map(v);
}

fn _opt(m, k, fb) {
    if m == nil or not is_map(m) { return fb; }
    if not map_has(m, k) { return fb; }
    let v = m[k];
    if v == nil { return fb; }
    return v;
}

fn _clamp_num(x, lo, hi) {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

// ── 32-Bit Precision-Safe Bitwise & Cryptographic Primitives ─────────────────

fn _rotl32(x, n) {
    let xm = bit_and(x, _MASK32);
    if n <= 0 { return xm; }
    let keep = bit_shr(_MASK32, n);
    let lo = bit_and(xm, keep);
    return bit_or(bit_shl(lo, n), bit_shr(xm, 32 - n));
}

fn _add32(a, b) {
    return bit_and(a + b, _MASK32);
}

fn _bytes_to_hex(bytes) {
    let digits = "0123456789abcdef";
    let parts = [];
    let i = 0;
    while i < len(bytes) {
        let b = bit_and(bytes[i], 255);
        let hi = bit_and(bit_shr(b, 4), 15);
        let lo = bit_and(b, 15);
        array_push(parts, str_slice(digits, hi, hi + 1) + str_slice(digits, lo, lo + 1));
        i = i + 1;
    }
    return str_join(parts, "");
}

fn _hex_nibble(code) {
    if code >= 48 and code <= 57 { return code - 48; }
    if code >= 97 and code <= 102 { return code - 87; }
    if code >= 65 and code <= 70 { return code - 55; }
    return 0;
}

fn _hex_to_bytes(hex_str) {
    let out = [];
    let i = 0;
    while i + 1 < len(hex_str) {
        let hi = _hex_nibble(strcharcodeat(hex_str, i));
        let lo = _hex_nibble(strcharcodeat(hex_str, i + 1));
        array_push(out, hi * 16 + lo);
        i = i + 2;
    }
    return out;
}

fn _sha256_bytes_raw(bytes) {
    return _hex_to_bytes(_SHA256.sha256_hex_bytes(bytes));
}

fn _sha256_str_bytes(s) {
    return _hex_to_bytes(_SHA256.sha256_hex(str(s)));
}

// Pure-PBLang RFC 2104 HMAC-SHA256 returning 32-byte array
fn hmac_sha256_raw(msg_bytes, key_in) {
    let key_bytes = if is_array(key_in) { key_in } else { str_to_bytes(str(key_in)) };
    let kblk = [];
    if len(key_bytes) > 64 {
        kblk = _sha256_bytes_raw(key_bytes);
    } else {
        let i = 0;
        while i < len(key_bytes) {
            array_push(kblk, bit_and(key_bytes[i], 255));
            i = i + 1;
        }
    }
    while len(kblk) < 64 { array_push(kblk, 0); }

    let ipad = [];
    let opad = [];
    let j = 0;
    while j < 64 {
        array_push(ipad, bit_xor(kblk[j], 54));
        array_push(opad, bit_xor(kblk[j], 92));
        j = j + 1;
    }

    let c1 = _SHA256.new();
    _SHA256.update(c1, ipad);
    _SHA256.update(c1, msg_bytes);
    let inner = _hex_to_bytes(_SHA256.finish(c1));

    let c2 = _SHA256.new();
    _SHA256.update(c2, opad);
    _SHA256.update(c2, inner);
    return _hex_to_bytes(_SHA256.finish(c2));
}

// CRC-16/CCITT-FALSE (poly 0x1021, init 0xFFFF)
fn crc16_ccitt(bytes) {
    let crc = 65535;
    let i = 0;
    while i < len(bytes) {
        crc = bit_xor(crc, bit_shl(bit_and(bytes[i], 255), 8));
        let b = 0;
        while b < 8 {
            if bit_and(crc, 32768) != 0 {
                crc = bit_and(bit_xor(bit_shl(bit_and(crc, 32767), 1), 4129), 65535);
            } else {
                crc = bit_and(bit_shl(crc, 1), 65535);
            }
            b = b + 1;
        }
        i = i + 1;
    }
    return crc;
}

fn _read_u32_le(b, off) {
    return bit_and(
        bit_or(
            bit_or(b[off], bit_shl(b[off + 1], 8)),
            bit_or(bit_shl(b[off + 2], 16), bit_shl(b[off + 3], 24))
        ),
        _MASK32
    );
}

// Pure-PBLang RFC 8439 ChaCha20 20-Round Stream Cipher
fn _chacha_qr(st, ia, ib, ic, id) {
    st[ia] = _add32(st[ia], st[ib]); st[id] = _rotl32(bit_xor(st[id], st[ia]), 16);
    st[ic] = _add32(st[ic], st[id]); st[ib] = _rotl32(bit_xor(st[ib], st[ic]), 12);
    st[ia] = _add32(st[ia], st[ib]); st[id] = _rotl32(bit_xor(st[id], st[ia]), 8);
    st[ic] = _add32(st[ic], st[id]); st[ib] = _rotl32(bit_xor(st[ib], st[ic]), 7);
}

fn chacha20_block_bytes(key32, counter, nonce12) {
    let state = [
        1634760805, 857760878, 2036477234, 1797285236, // "expand 32-byte k"
        _read_u32_le(key32, 0),  _read_u32_le(key32, 4),
        _read_u32_le(key32, 8),  _read_u32_le(key32, 12),
        _read_u32_le(key32, 16), _read_u32_le(key32, 20),
        _read_u32_le(key32, 24), _read_u32_le(key32, 28),
        bit_and(counter, _MASK32),
        _read_u32_le(nonce12, 0), _read_u32_le(nonce12, 4), _read_u32_le(nonce12, 8)
    ];

    let work = [];
    let i = 0;
    while i < 16 {
        array_push(work, state[i]);
        i = i + 1;
    }

    let r = 0;
    while r < 10 {
        // Column rounds
        _chacha_qr(work, 0, 4, 8, 12);
        _chacha_qr(work, 1, 5, 9, 13);
        _chacha_qr(work, 2, 6, 10, 14);
        _chacha_qr(work, 3, 7, 11, 15);
        // Diagonal rounds
        _chacha_qr(work, 0, 5, 10, 15);
        _chacha_qr(work, 1, 6, 11, 12);
        _chacha_qr(work, 2, 7, 8, 13);
        _chacha_qr(work, 3, 4, 9, 14);
        r = r + 1;
    }

    let out = [];
    i = 0;
    while i < 16 {
        let w = _add32(work[i], state[i]);
        array_push(out, bit_and(w, 255));
        array_push(out, bit_and(bit_shr(w, 8), 255));
        array_push(out, bit_and(bit_shr(w, 16), 255));
        array_push(out, bit_and(bit_shr(w, 24), 255));
        i = i + 1;
    }
    return out;
}

fn chacha20_xor_bytes(input_bytes, key32, nonce12, initial_counter = 1) {
    if len(key32) != 32 { _err("ChaCha20 requires a 32-byte key"); }
    if len(nonce12) != 12 { _err("ChaCha20 requires a 12-byte nonce"); }
    let out = [];
    let pos = 0;
    let blk_no = initial_counter;
    let total = len(input_bytes);
    while pos < total {
        let ks = chacha20_block_bytes(key32, blk_no, nonce12);
        let k = 0;
        while k < 64 and pos < total {
            array_push(out, bit_xor(bit_and(input_bytes[pos], 255), ks[k]));
            pos = pos + 1;
            k = k + 1;
        }
        blk_no = blk_no + 1;
    }
    return out;
}

// ═════════════════════════════════════════════════════════════════════════════
// 1. Granular Developer Policy Builder (`create_protection_policy`)
// ═════════════════════════════════════════════════════════════════════════════

fn create_protection_policy(opts = nil) {
    let o = if _is_map_val(opts) { opts } else { map{} };
    let open_src = _opt(o, "open_source", false) == true;
    let raw_mode = str_lower(str(_opt(o, "mode", if open_src { "free" } else { "proprietary" })));
    let is_free = (raw_mode == "free" or raw_mode == "open-source" or raw_mode == "open_source" or open_src);

    let mode_norm = if is_free { "free" } else { raw_mode };
    let def_shield = not is_free;

    let cam_raw = _opt(o, "anti_camera_and_llm_vision", false);
    let cam_active = (cam_raw == true or cam_raw == "report_vault" or cam_raw == "strict");

    let prevent_ss = _opt(o, "prevent_screenshots", def_shield) == true;
    let temporal_weave = _opt(o, "temporal_subframe_weave", _opt(o, "temporal_weave", cam_active));
    let guilloche_bg = _opt(o, "guilloche_background", cam_active);
    let stego_canary = _opt(o, "stego_canary", def_shield);
    let kerning_jitter = _opt(o, "subpixel_kerning_jitter_px", if cam_active { 0.3 } else { 0.0 });

    let obfuscate_bin = _opt(o, "obfuscate_binary", def_shield);
    let strip_sym = _opt(o, "strip_symbols", def_shield);
    let anti_dbg = _opt(o, "anti_debug", false);
    let block_ps = _opt(o, "block_print_save", prevent_ss);
    let blur_unfocus = _opt(o, "blur_on_screenshot_or_unfocus", prevent_ss);
    let os_hw_cap = _opt(o, "os_hardware_capture_affinity", prevent_ss);
    let anti_bot = _opt(o, "anti_scraper_bot", _opt(o, "scraper_honeypot", def_shield));
    let weave_amp = _clamp_num(_opt(o, "temporal_weave_delta_rgb", _opt(o, "temporal_amplitude", 2)), 1, 3);
    let rights_stmt = str(if is_free {
        _opt(o, "rights_statement", _opt(o, "license_notice", "Permissive Open Distribution"))
    } else {
        _opt(o, "rights_statement", _opt(o, "license_notice", "All Rights Reserved"))
    });

    return map{
        schema: "pblang.protection_policy.v4.1",
        version: SHIELD_VERSION,
        mode: mode_norm,
        open_source: is_free,
        rights_statement: rights_stmt,
        license_notice: rights_stmt,
        prevent_screenshots: prevent_ss,
        obfuscate_binary: obfuscate_bin == true,
        strip_symbols: strip_sym == true,
        anti_debug: anti_dbg == true,
        block_print_save: block_ps == true,
        blur_on_screenshot_or_unfocus: blur_unfocus == true,
        blur_radius_px: _opt(o, "blur_radius_px", 32),
        blur_SLA_ms: 4,
        os_hardware_capture_affinity: os_hw_cap == true,
        anti_scraper_bot: anti_bot == true,
        scraper_honeypot: anti_bot == true,
        anti_camera_and_llm_vision: cam_raw,
        anti_camera_active: cam_active,
        temporal_subframe_weave: temporal_weave == true,
        temporal_weave: temporal_weave == true,
        temporal_weave_delta_rgb: weave_amp,
        temporal_amplitude: weave_amp,
        guilloche_background: guilloche_bg == true,
        subpixel_kerning_jitter_px: kerning_jitter,
        stego_canary: stego_canary == true,
        canary_secret: str(_opt(o, "canary_secret", "pblang-v41-sovereign-canary-key")),
        vault_secret: str(_opt(o, "vault_secret", "pblang-v41-confidential-vault-stream")),
        os_affinity_targets: map{
            win32_display_affinity: if os_hw_cap { WIN32_WDA_EXCLUDEFROMCAPTURE } else { WIN32_WDA_NONE },
            android_window_flags: if os_hw_cap { ANDROID_FLAG_SECURE } else { 0 },
            ios_secure_layer: os_hw_cap == true,
            x11_focus_veil: blur_unfocus == true
        }
    };
}

// ═════════════════════════════════════════════════════════════════════════════
// 2. Invisible Lossless-Look Steganographic Leak Canary & Temporal Weave Math
// ═════════════════════════════════════════════════════════════════════════════

fn compute_rgba_psnr_metrics(orig_rgba, mod_rgba) {
    if not is_array(orig_rgba) or not is_array(mod_rgba) or len(orig_rgba) != len(mod_rgba) {
        _err("compute_rgba_psnr_metrics requires equal-length RGBA byte arrays");
    }
    let n = len(orig_rgba);
    if n == 0 or (n % 4) != 0 {
        _err("RGBA buffer length must be a positive multiple of 4");
    }
    let sum_sq = 0.0;
    let max_delta = 0;
    let changed_channels = 0;
    let alpha_changed = 0;
    let i = 0;
    while i < n {
        let d = num_abs(orig_rgba[i] - mod_rgba[i]);
        if (i % 4) == 3 {
            if d > 0 { alpha_changed = alpha_changed + 1; }
        } else {
            if d > 0 { changed_channels = changed_channels + 1; }
            if d > max_delta { max_delta = d; }
            sum_sq = sum_sq + (d * d);
        }
        i = i + 1;
    }
    let rgb_count = (n / 4) * 3.0;
    let mse = sum_sq / rgb_count;
    let psnr = 99.0;
    if mse > 0.0 {
        psnr = 10.0 * (num_ln((255.0 * 255.0) / mse) / num_ln(10.0));
    }
    return map{
        mse: mse,
        psnr_db: psnr,
        max_channel_delta: max_delta,
        changed_rgb_channels: changed_channels,
        alpha_channels_modified: alpha_changed
    };
}

fn _prng_init(secret_key, rgb_slots) {
    return map{
        key_str: str(secret_key),
        rgb_slots: rgb_slots,
        block_idx: 0,
        words: [],
        word_pos: 0,
        used: map{}
    };
}

fn _prng_next_u32(st) {
    if st.word_pos >= len(st.words) {
        let digest = _sha256_str_bytes(st.key_str + "|PBCN_PRNG_V41|" + str(st.block_idx));
        st.block_idx = st.block_idx + 1;
        let ws = [];
        let k = 0;
        while k < 32 {
            array_push(ws, _read_u32_le(digest, k));
            k = k + 4;
        }
        st.words = ws;
        st.word_pos = 0;
    }
    let w = st.words[st.word_pos];
    st.word_pos = st.word_pos + 1;
    return w;
}

fn _prng_next_rgba_index(st) {
    let raw_w = _prng_next_u32(st);
    let slot = raw_w % st.rgb_slots;
    while map_has(st.used, str(slot)) {
        slot = (slot + 1) % st.rgb_slots;
    }
    st.used[str(slot)] = true;
    let pix = num_floor(slot / 3);
    let chan = slot % 3;
    return pix * 4 + chan;
}

fn _canary_frame_bytes(canary_payload, secret_key) {
    let pbytes = str_to_bytes(str(canary_payload));
    let plen = len(pbytes);
    if plen > 4096 {
        _err("canary_payload exceeds 4096-byte frame limit");
    }
    let hdr_and_body = [80, 66, 67, 78, bit_and(bit_shr(plen, 8), 255), bit_and(plen, 255)];
    let i = 0;
    while i < plen {
        array_push(hdr_and_body, bit_and(pbytes[i], 255));
        i = i + 1;
    }
    let crc = crc16_ccitt(hdr_and_body);
    let mac = hmac_sha256_raw(hdr_and_body, str(secret_key));

    let frame = [];
    i = 0;
    while i < len(hdr_and_body) {
        array_push(frame, hdr_and_body[i]);
        i = i + 1;
    }
    array_push(frame, bit_and(bit_shr(crc, 8), 255));
    array_push(frame, bit_and(crc, 255));
    array_push(frame, mac[0]);
    array_push(frame, mac[1]);
    array_push(frame, mac[2]);
    array_push(frame, mac[3]);
    return frame;
}

// Embeds framed `PBCN` + len + UTF-8 payload + CRC16 + HMAC-32 across keyed pseudo-random RGB LSBs.
// Guarantees `max_channel_delta <= 1`, `alpha_channels_modified == 0`, and `PSNR > 51 dB`.
fn embed_invisible_canary_rgba(rgba_bytes, width, height, canary_payload, secret_key) {
    if not is_array(rgba_bytes) { _err("rgba_bytes must be a byte array"); }
    let expected_len = width * height * 4;
    if width <= 0 or height <= 0 or len(rgba_bytes) != expected_len {
        _err("rgba_bytes length (" + str(len(rgba_bytes)) + ") does not match width*height*4 (" + str(expected_len) + ")");
    }
    let frame = _canary_frame_bytes(canary_payload, secret_key);
    let total_bits = len(frame) * 8;
    let rgb_slots = width * height * 3;
    if total_bits > rgb_slots {
        _err("image capacity (" + str(rgb_slots) + " RGB channels) insufficient for " + str(total_bits) + " canary bits");
    }

    let out = [];
    let i = 0;
    while i < expected_len {
        array_push(out, bit_and(rgba_bytes[i], 255));
        i = i + 1;
    }

    let prng = _prng_init(secret_key, rgb_slots);
    let fi = 0;
    while fi < len(frame) {
        let fbyte = frame[fi];
        let bi = 7;
        while bi >= 0 {
            let target_bit = bit_and(bit_shr(fbyte, bi), 1);
            let idx = _prng_next_rgba_index(prng);
            let cur_v = out[idx];
            if bit_and(cur_v, 1) != target_bit {
                out[idx] = bit_xor(cur_v, 1); // Exact +/-1 LSB flip in 0..255!
            }
            bi = bi - 1;
        }
        fi = fi + 1;
    }

    let metrics = compute_rgba_psnr_metrics(rgba_bytes, out);
    return map{
        ok: true,
        rgba_bytes: out,
        width: width,
        height: height,
        payload_bytes: len(str_to_bytes(str(canary_payload))),
        frame_bytes: len(frame),
        bits_embedded: total_bits,
        max_channel_delta: metrics.max_channel_delta,
        mse: metrics.mse,
        psnr_db: metrics.psnr_db,
        alpha_channels_modified: metrics.alpha_channels_modified
    };
}

// Extracts and cryptographically verifies the invisible `PBCN` leak canary from RGBA pixels.
fn extract_invisible_canary_rgba(rgba_or_bundle, width, height, secret_key) {
    let rgba_bytes = if _is_map_val(rgba_or_bundle) and map_has(rgba_or_bundle, "rgba_bytes") {
        rgba_or_bundle.rgba_bytes
    } else {
        rgba_or_bundle
    };
    let expected_len = width * height * 4;
    if not is_array(rgba_bytes) or len(rgba_bytes) != expected_len {
        return map{ ok: false, error: "invalid RGBA buffer dimensions" };
    }
    let rgb_slots = width * height * 3;
    if rgb_slots < 96 {
        return map{ ok: false, error: "image too small to hold canary header" };
    }

    let prng = _prng_init(secret_key, rgb_slots);

    // Step 1: Extract 6-byte header (`"PBCN"` + u16 BE length)
    let hdr = [];
    let hi = 0;
    while hi < 6 {
        let acc = 0;
        let bi = 0;
        while bi < 8 {
            let idx = _prng_next_rgba_index(prng);
            acc = bit_or(bit_shl(acc, 1), bit_and(rgba_bytes[idx], 1));
            bi = bi + 1;
        }
        array_push(hdr, acc);
        hi = hi + 1;
    }

    if hdr[0] != 80 or hdr[1] != 66 or hdr[2] != 67 or hdr[3] != 78 {
        return map{ ok: false, valid_magic: false, error: "PBCN canary magic not found or wrong secret_key" };
    }

    let plen = bit_or(bit_shl(hdr[4], 8), hdr[5]);
    let rem_bytes = plen + 6; // payload + 2B CRC16 + 4B HMAC-32
    if (6 + rem_bytes) * 8 > rgb_slots or plen > 4096 {
        return map{ ok: false, valid_magic: true, error: "corrupted canary length field" };
    }

    let tail = [];
    let ti = 0;
    while ti < rem_bytes {
        let acc2 = 0;
        let bi2 = 0;
        while bi2 < 8 {
            let idx2 = _prng_next_rgba_index(prng);
            acc2 = bit_or(bit_shl(acc2, 1), bit_and(rgba_bytes[idx2], 1));
            bi2 = bi2 + 1;
        }
        array_push(tail, acc2);
        ti = ti + 1;
    }

    let payload_bytes = slice(tail, 0, plen);
    let stored_crc = bit_or(bit_shl(tail[plen], 8), tail[plen + 1]);
    let stored_mac0 = tail[plen + 2];
    let stored_mac1 = tail[plen + 3];
    let stored_mac2 = tail[plen + 4];
    let stored_mac3 = tail[plen + 5];

    let signed_part = [hdr[0], hdr[1], hdr[2], hdr[3], hdr[4], hdr[5]];
    let pi = 0;
    while pi < plen {
        array_push(signed_part, payload_bytes[pi]);
        pi = pi + 1;
    }

    let calc_crc = crc16_ccitt(signed_part);
    let calc_mac = hmac_sha256_raw(signed_part, str(secret_key));
    let diff = bit_or(
        bit_xor(stored_crc, calc_crc),
        bit_or(
            bit_or(bit_xor(stored_mac0, calc_mac[0]), bit_xor(stored_mac1, calc_mac[1])),
            bit_or(bit_xor(stored_mac2, calc_mac[2]), bit_xor(stored_mac3, calc_mac[3]))
        )
    );
    if diff != 0 {
        return map{ ok: false, valid_magic: true, hmac_verified: false, error: "canary CRC16/HMAC-32 integrity check failed" };
    }

    return map{
        ok: true,
        valid_magic: true,
        hmac_verified: true,
        payload_length: plen,
        canary_payload: bytes_to_str(payload_bytes)
    };
}

// Generates complementary 60/120 Hz sub-frame pair `(even_rgba, odd_rgba)`:
// Exact Talbot-Plateau human persistence-of-vision invariant: `(even[i] + odd[i]) / 2 == orig[i]` (0.0 net error!),
// while high-shutter CMOS cameras (`1/120s..1/1000s`) capture spatial checkerboard phase interference.
fn generate_temporal_subframe_pair(rgba_bytes, width, height, amplitude = 2) {
    let amp = _clamp_num(num_floor(amplitude), 1, 4);
    let even_rgba = [];
    let odd_rgba = [];
    let y = 0;
    while y < height {
        let x = 0;
        while x < width {
            let off = (y * width + x) * 4;
            let sign = if ((x + y) % 2) == 0 { 1 } else { -1 };
            let c = 0;
            while c < 3 {
                let v = bit_and(rgba_bytes[off + c], 255);
                let eff = amp;
                if v < eff { eff = v; }
                if (255 - v) < eff { eff = 255 - v; }
                array_push(even_rgba, v + sign * eff);
                array_push(odd_rgba, v - sign * eff);
                c = c + 1;
            }
            let a = bit_and(rgba_bytes[off + 3], 255);
            array_push(even_rgba, a);
            array_push(odd_rgba, a);
            x = x + 1;
        }
        y = y + 1;
    }
    return map{
        even_rgba: even_rgba,
        odd_rgba: odd_rgba,
        amplitude: amp,
        width: width,
        height: height
    };
}

// ═════════════════════════════════════════════════════════════════════════════
// 3. Encrypted Zero-DOM Confidential Report Vault (`render_protected_report_html`)
// ═════════════════════════════════════════════════════════════════════════════

fn _html_esc(s) {
    let r = str(s);
    r = str_replace_all(r, "&", "&amp;");
    r = str_replace_all(r, "<", "&lt;");
    r = str_replace_all(r, ">", "&gt;");
    r = str_replace_all(r, "\"", "&quot;");
    return r;
}

fn _normalize_report_payload(report_spec) {
    let spec = if _is_map_val(report_spec) { report_spec } else { map{} };
    let raw_cols = _opt(spec, "columns", []);
    let norm_cols = [];
    let col_fields = [];
    let ci = 0;
    while ci < len(raw_cols) {
        let rc = raw_cols[ci];
        if _is_map_val(rc) {
            let lbl = str(_opt(rc, "header", _opt(rc, "label", _opt(rc, "field", "Col"))));
            let fld = str(_opt(rc, "field", lbl));
            array_push(norm_cols, lbl);
            array_push(col_fields, fld);
        } else {
            array_push(norm_cols, str(rc));
            array_push(col_fields, str(rc));
        }
        ci = ci + 1;
    }

    let raw_rows = _opt(spec, "rows", []);
    let norm_rows = [];
    let ri = 0;
    while ri < len(raw_rows) {
        let rr = raw_rows[ri];
        let row_cells = [];
        if is_array(rr) {
            let k = 0;
            while k < len(rr) {
                array_push(row_cells, str(rr[k]));
                k = k + 1;
            }
        } elif _is_map_val(rr) {
            let k2 = 0;
            while k2 < len(col_fields) {
                array_push(row_cells, str(_opt(rr, col_fields[k2], "")));
                k2 = k2 + 1;
            }
        }
        array_push(norm_rows, row_cells);
        ri = ri + 1;
    }

    let raw_kpis = _opt(spec, "summary_kpis", []);
    let norm_kpis = [];
    let ki = 0;
    while ki < len(raw_kpis) {
        let kp = raw_kpis[ki];
        if _is_map_val(kp) {
            array_push(norm_kpis, map{
                label: str(_opt(kp, "label", _opt(kp, "title", "KPI"))),
                value: str(_opt(kp, "value", "")),
                delta: str(_opt(kp, "delta", ""))
            });
        } else {
            array_push(norm_kpis, map{ label: "Summary", value: str(kp), delta: "" });
        }
        ki = ki + 1;
    }

    return map{
        title: str(_opt(spec, "title", "Confidential Executive Statement")),
        subtitle: str(_opt(spec, "subtitle", "Restricted Zero-DOM Visual Vault")),
        viewer_id: str(_opt(spec, "viewer_id", "authorized_viewer")),
        columns: norm_cols,
        rows: norm_rows,
        summary_kpis: norm_kpis
    };
}

// Encrypts report JSON with RFC 8439 ChaCha20 + HMAC-SHA256 tag + micro-PoW key mask
fn encrypt_vault_payload(payload_map, policy) {
    let pol = if _is_map_val(policy) { policy } else { create_protection_policy(nil) };
    let plain_json = json_stringify(payload_map);
    let plain_bytes = str_to_bytes(plain_json);

    let seed_str = pol.vault_secret + "|" + str(_opt(payload_map, "viewer_id", "v")) + "|PBLANG_VAULT_V41";
    let key32 = _sha256_str_bytes(seed_str + "|CHACHA20_KEY");
    let nonce_full = _sha256_str_bytes(seed_str + "|CHACHA20_NONCE");
    let nonce12 = slice(nonce_full, 0, 12);

    let cipher_bytes = chacha20_xor_bytes(plain_bytes, key32, nonce12, 1);
    let mac_hex = _bytes_to_hex(hmac_sha256_raw(cipher_bytes, key32));

    // Mask key32 with a lightweight client micro-PoW byte (`pow_byte` in 1..64) so static scrapers
    // reading JS constants don't even have the unmasked key without running the attestation gate!
    let pow_secret = (key32[0] % 47) + 11;
    let masked_key = [];
    let pow_chk = 0;
    let i = 0;
    while i < 32 {
        let mask_b = bit_and(pow_secret * 37 + i * 13 + 91, 255);
        array_push(masked_key, bit_xor(key32[i], mask_b));
        pow_chk = bit_and(pow_chk * 31 + key32[i], 65535);
        i = i + 1;
    }

    return map{
        cipher_b64: base64_encode_bytes(cipher_bytes),
        cipher_byte_len: len(cipher_bytes),
        masked_key_bytes: masked_key,
        nonce12_bytes: nonce12,
        pow_check_u16: pow_chk,
        hmac_sha256_hex: mac_hex
    };
}

// CSS shield block reusable across `render_protected_report_html`, `enterprise_ui_framework`, and `wasm_web_pwa`
fn build_web_shield_css(policy = nil) {
    let pol = if _is_map_val(policy) { policy } else { create_protection_policy(nil) };
    if pol.open_source and not pol.block_print_save and not pol.blur_on_screenshot_or_unfocus {
        return "";
    }
    let blur_px = str(pol.blur_radius_px);
    let parts = [
        "html, body, .pb-protected-surface { -webkit-user-select: none !important; user-select: none !important; -webkit-touch-callout: none !important; }",
        "#pb-privacy-veil { position: fixed; inset: 0; z-index: 2147483646; display: none; align-items: center; justify-content: center; background: rgba(6, 10, 18, 0.86); backdrop-filter: blur(" + blur_px + "px); -webkit-backdrop-filter: blur(" + blur_px + "px); color: #f8fafc; font: 600 16px/1.5 system-ui, sans-serif; letter-spacing: 0.04em; text-align: center; transition: none !important; pointer-events: all; }",
        "#pb-privacy-veil.pb-veil-active { display: flex !important; }",
        ".pb-scraper-honeypot { position: fixed !important; left: -99999px !important; top: -99999px !important; width: 1px !important; height: 1px !important; overflow: hidden !important; opacity: 0 !important; pointer-events: none !important; }"
    ];
    if pol.block_print_save {
        array_push(parts, "@media print { html, body, body * { display: none !important; visibility: hidden !important; opacity: 0 !important; } body::after { content: \"PRINTING & PDF EXPORT DISABLED — ALL RIGHTS RESERVED\"; display: block !important; visibility: visible !important; opacity: 1 !important; color: #111; font: 700 18pt sans-serif; padding: 48pt; text-align: center; } }");
    }
    return str_join(parts, "\n");
}

// Self-contained off-screen scraper honeypot DOM fragment containing synthetic canary tokens
fn build_scraper_honeypot_html(canary_seed) {
    let trap_hash = str_slice(_SHA256.sha256_hex("PB_TRAP|" + str(canary_seed)), 0, 16);
    let tok1 = "PB_SCRAPER_TRAP_CANARY_" + str_upper(trap_hash);
    let tok2 = "PB_HONEYPOT_DECOY_ROW_" + str_upper(str_slice(trap_hash, 8, 16));
    return "<div aria-hidden=\"true\" tabindex=\"-1\" class=\"pb-scraper-honeypot\" data-honeypot=\"pb-scraper-trap\">"
        + "<span>" + tok1 + "</span>"
        + "<span>" + tok2 + "</span>"
        + "<span>SYNTHETIC_DECOY_ONLY_UNAUTHORIZED_SCRAPE_LOGGED</span>"
        + "</div>";
}

// Reusable JS runtime shield for print/save/copy/DevTools/PrintScreen/unfocus `<4ms` veil
fn build_web_shield_runtime_js(policy = nil, canvas_selector = "canvas") {
    let pol = if _is_map_val(policy) { policy } else { create_protection_policy(nil) };
    let block_ps = if pol.block_print_save { "true" } else { "false" };
    let blur_unf = if pol.blur_on_screenshot_or_unfocus { "true" } else { "false" };
    let anti_bot = if pol.anti_scraper_bot { "true" } else { "false" };
    return str_join([
        "(function(){",
        "  'use strict';",
        "  const BLOCK_PS = " + block_ps + ", BLUR_UNFOCUS = " + blur_unf + ", ANTI_BOT = " + anti_bot + ";",
        "  function ensureVeil() {",
        "    let v = document.getElementById('pb-privacy-veil');",
        "    if (!v && document.body) {",
        "      v = document.createElement('div');",
        "      v.id = 'pb-privacy-veil';",
        "      v.setAttribute('aria-hidden', 'true');",
        "      v.textContent = 'CONFIDENTIAL VIEWPORT LOCKED — RETURN FOCUS TO RESUME';",
        "      document.body.appendChild(v);",
        "    }",
        "    return v;",
        "  }",
        "  function setVeil(active) {",
        "    if (!BLUR_UNFOCUS) return;",
        "    const v = ensureVeil();",
        "    if (v) { if (active) v.classList.add('pb-veil-active'); else v.classList.remove('pb-veil-active'); }",
        "    const cvs = document.querySelectorAll('" + canvas_selector + "');",
        "    for (let i = 0; i < cvs.length; i++) {",
        "      cvs[i].style.visibility = active ? 'hidden' : 'visible';",
        "    }",
        "    if (typeof window.__pbOnShieldState === 'function') window.__pbOnShieldState(active);",
        "  }",
        "  if (ANTI_BOT) {",
        "    const botDetected = !!(navigator.webdriver || window.__playwright || window._phantom || window.__nightmare || window.callPhantom || document.__webdriver_evaluate);",
        "    window.__pbHeadlessBlocked = botDetected;",
        "    if (botDetected) { setVeil(true); }",
        "    if (navigator.mediaDevices && typeof navigator.mediaDevices.getDisplayMedia === 'function') {",
        "      navigator.mediaDevices.getDisplayMedia = function() { setVeil(true); return Promise.reject(new Error('Display capture prohibited by policy')); };",
        "    }",
        "  }",
        "  if (BLOCK_PS) {",
        "    window.print = function() { setVeil(true); return false; };",
        "    const blockEv = function(e) { e.preventDefault(); e.stopPropagation(); return false; };",
        "    document.addEventListener('contextmenu', blockEv, true);",
        "    document.addEventListener('selectstart', blockEv, true);",
        "    document.addEventListener('copy', blockEv, true);",
        "    document.addEventListener('cut', blockEv, true);",
        "    document.addEventListener('dragstart', blockEv, true);",
        "  }",
        "  window.addEventListener('keydown', function(ev) {",
        "    const k = (ev.key || '').toLowerCase();",
        "    const mod = ev.ctrlKey || ev.metaKey;",
        "    if (ev.key === 'PrintScreen' || ev.keyCode === 44 || (ev.metaKey && ev.shiftKey && (k === '3' || k === '4' || k === '5' || k === 's'))) {",
        "      setVeil(true); ev.preventDefault(); ev.stopPropagation(); return false;",
        "    }",
        "    if (BLOCK_PS && ((mod && (k === 'p' || k === 's' || k === 'u' || k === 'c')) || ev.key === 'F12' || (mod && ev.shiftKey && (k === 'i' || k === 'j' || k === 'c')))) {",
        "      ev.preventDefault(); ev.stopPropagation(); return false;",
        "    }",
        "  }, true);",
        "  window.addEventListener('keyup', function(ev) {",
        "    if (ev.key === 'PrintScreen' || ev.keyCode === 44) { setVeil(true); ev.preventDefault(); }",
        "  }, true);",
        "  if (BLUR_UNFOCUS) {",
        "    window.addEventListener('blur', function() { setVeil(true); }, true);",
        "    window.addEventListener('focus', function() { if (!window.__pbHeadlessBlocked) setVeil(false); }, true);",
        "    document.addEventListener('visibilitychange', function() { setVeil(document.hidden); }, true);",
        "    document.documentElement.addEventListener('mouseleave', function() { setVeil(true); }, true);",
        "    document.documentElement.addEventListener('mouseenter', function() { if (document.hasFocus() && !window.__pbHeadlessBlocked) setVeil(false); }, true);",
        "    window.addEventListener('beforeprint', function() { setVeil(true); }, true);",
        "  }",
        "})();"
    ], "\n");
}

// Embeddable Zero-DOM `<canvas>` Confidential Vault Widget HTML+JS (used both standalone & inside Enterprise UI)
fn render_protected_report_widget(vault_id, report_spec, policy = nil) {
    let pol = if _is_map_val(policy) { policy } else { create_protection_policy(map{ anti_camera_and_llm_vision: "report_vault" }) };
    let norm = _normalize_report_payload(report_spec);
    let enc = encrypt_vault_payload(norm, pol);

    let cid = _html_esc(vault_id);
    let canary_tag = "viewer=" + norm.viewer_id + "|vault=" + vault_id;
    let canary_hash = str_slice(_SHA256.sha256_hex(pol.canary_secret + "|" + canary_tag), 0, 16);
    let weave_js = if pol.temporal_subframe_weave { "true" } else { "false" };
    let weave_amp = str(pol.temporal_weave_delta_rgb);
    let guilloche_js = if pol.guilloche_background { "true" } else { "false" };
    let jitter_js = str(pol.subpixel_kerning_jitter_px);
    let stego_js = if pol.stego_canary { "true" } else { "false" };

    let mk_strs = [];
    let i = 0;
    while i < len(enc.masked_key_bytes) {
        array_push(mk_strs, str(enc.masked_key_bytes[i]));
        i = i + 1;
    }
    let nc_strs = [];
    i = 0;
    while i < len(enc.nonce12_bytes) {
        array_push(nc_strs, str(enc.nonce12_bytes[i]));
        i = i + 1;
    }

    let honeypot = if pol.anti_scraper_bot { build_scraper_honeypot_html(vault_id + "|" + canary_hash) } else { "" };

    let widget_js = str_join([
        "(function(){",
        "  'use strict';",
        "  if (navigator.webdriver || window.__playwright || window._phantom || window.__nightmare || document.__webdriver_evaluate) return;",
        "  const cv = document.getElementById('" + cid + "-canvas');",
        "  if (!cv) return;",
        "  const ctx = cv.getContext('2d', { willReadFrequently: true });",
        "  if (!ctx) return;",
        "  const MASKED_K = [" + str_join(mk_strs, ",") + "];",
        "  const NONCE_B = [" + str_join(nc_strs, ",") + "];",
        "  const POW_TARGET = " + str(enc.pow_check_u16) + ";",
        "  const CIPHER_B64 = \"" + enc.cipher_b64 + "\";",
        "  const WEAVE_ON = " + weave_js + ", WEAVE_AMP = " + weave_amp + ", GUILLOCHE_ON = " + guilloche_js + ", JITTER_PX = " + jitter_js + ", STEGO_ON = " + stego_js + ";",
        "  const CANARY_BITS = \"" + canary_hash + "\";",
        "  // Micro-PoW key unsealing inside closure",
        "  let keyBytes = null;",
        "  for (let cand = 1; cand < 128; cand++) {",
        "    let chk = 0; const tmp = new Uint8Array(32);",
        "    for (let i = 0; i < 32; i++) {",
        "      const b = MASKED_K[i] ^ ((cand * 37 + i * 13 + 91) & 255);",
        "      tmp[i] = b; chk = (chk * 31 + b) & 65535;",
        "    }",
        "    if (chk === POW_TARGET) { keyBytes = tmp; break; }",
        "  }",
        "  if (!keyBytes) return;",
        "  function u32le(b, o) { return ((b[o]) | (b[o+1]<<8) | (b[o+2]<<16) | (b[o+3]<<24)) >>> 0; }",
        "  function rotl(v, c) { return ((v << c) | (v >>> (32 - c))) >>> 0; }",
        "  function qr(x, a, b, c, d) {",
        "    x[a]=(x[a]+x[b])>>>0; x[d]=rotl(x[d]^x[a],16);",
        "    x[c]=(x[c]+x[d])>>>0; x[b]=rotl(x[b]^x[c],12);",
        "    x[a]=(x[a]+x[b])>>>0; x[d]=rotl(x[d]^x[a],8);",
        "    x[c]=(x[c]+x[d])>>>0; x[b]=rotl(x[b]^x[c],7);",
        "  }",
        "  function chachaDecrypt(cbytes, kb, nb) {",
        "    const out = new Uint8Array(cbytes.length);",
        "    let pos = 0, ctr = 1;",
        "    while (pos < cbytes.length) {",
        "      const st = new Uint32Array([0x61707865,0x3320646e,0x79622d32,0x6b206574,u32le(kb,0),u32le(kb,4),u32le(kb,8),u32le(kb,12),u32le(kb,16),u32le(kb,20),u32le(kb,24),u32le(kb,28),ctr,u32le(nb,0),u32le(nb,4),u32le(nb,8)]);",
        "      const wk = new Uint32Array(st);",
        "      for (let r = 0; r < 10; r++) { qr(wk,0,4,8,12); qr(wk,1,5,9,13); qr(wk,2,6,10,14); qr(wk,3,7,11,15); qr(wk,0,5,10,15); qr(wk,1,6,11,12); qr(wk,2,7,8,13); qr(wk,3,4,9,14); }",
        "      for (let i = 0; i < 16 && pos < cbytes.length; i++) {",
        "        const w = (wk[i] + st[i]) >>> 0;",
        "        for (let sb = 0; sb < 4 && pos < cbytes.length; sb++) { out[pos] = cbytes[pos] ^ ((w >>> (sb * 8)) & 255); pos++; }",
        "      }",
        "      ctr++;",
        "    }",
        "    return out;",
        "  }",
        "  const rawBin = atob(CIPHER_B64);",
        "  const cBuf = new Uint8Array(rawBin.length);",
        "  for (let i = 0; i < rawBin.length; i++) cBuf[i] = rawBin.charCodeAt(i);",
        "  const pBuf = chachaDecrypt(cBuf, keyBytes, NONCE_B);",
        "  keyBytes.fill(0); cBuf.fill(0);",
        "  const decText = new TextDecoder('utf-8').decode(pBuf);",
        "  pBuf.fill(0);",
        "  const model = JSON.parse(decText);",
        "  const dpr = Math.max(1, Math.min(3, window.devicePixelRatio || 1));",
        "  const cssW = 920, rowH = 34;",
        "  const cssH = Math.max(320, 170 + ((model.rows ? model.rows.length : 0) + 1) * rowH);",
        "  cv.width = Math.floor(cssW * dpr); cv.height = Math.floor(cssH * dpr);",
        "  cv.style.width = cssW + 'px'; cv.style.height = cssH + 'px';",
        "  ctx.scale(dpr, dpr);",
        "  function drawCrispGlyphRun(txt, x, y, seed) {",
        "    const s = String(txt || '');",
        "    if (JITTER_PX <= 0) { ctx.fillText(s, x, y); return; }",
        "    let cx = x;",
        "    for (let i = 0; i < s.length; i++) {",
        "      const ch = s[i];",
        "      const jx = (((seed * 31 + i * 17) % 7) - 3) * (JITTER_PX / 3.0);",
        "      const jy = (((seed * 13 + i * 29) % 5) - 2) * (JITTER_PX / 3.0);",
        "      ctx.fillText(ch, cx + jx, y + jy);",
        "      cx += ctx.measureText(ch).width;",
        "    }",
        "  }",
        "  function paintVaultSurface() {",
        "    ctx.fillStyle = '#0c1322'; ctx.fillRect(0, 0, cssW, cssH);",
        "    if (GUILLOCHE_ON) {",
        "      ctx.save(); ctx.strokeStyle = 'rgba(56, 189, 248, 0.065)'; ctx.lineWidth = 0.8;",
        "      for (let wv = 0; wv < 9; wv++) {",
        "        ctx.beginPath();",
        "        for (let gx = 0; gx <= cssW; gx += 8) {",
        "          const gy = 60 + wv * 34 + Math.sin(gx * 0.022 + wv * 0.8) * 14 + Math.cos(gx * 0.051 - wv) * 6;",
        "          if (gx === 0) ctx.moveTo(gx, gy); else ctx.lineTo(gx, gy);",
        "        }",
        "        ctx.stroke();",
        "      }",
        "      ctx.restore();",
        "    }",
        "    ctx.fillStyle = '#f1f5f9'; ctx.font = '700 18px system-ui, sans-serif';",
        "    drawCrispGlyphRun(model.title, 24, 34, 1);",
        "    ctx.fillStyle = '#94a3b8'; ctx.font = '400 12.5px system-ui, sans-serif';",
        "    drawCrispGlyphRun(model.subtitle, 24, 54, 2);",
        "    const kpis = model.summary_kpis || [];",
        "    for (let k = 0; k < kpis.length; k++) {",
        "      const kx = 24 + k * 218, ky = 68;",
        "      ctx.fillStyle = '#131e33'; ctx.fillRect(kx, ky, 204, 54);",
        "      ctx.strokeStyle = '#243554'; ctx.strokeRect(kx, ky, 204, 54);",
        "      ctx.fillStyle = '#94a3b8'; ctx.font = '500 11px system-ui, sans-serif';",
        "      drawCrispGlyphRun(kpis[k].label, kx + 10, ky + 18, 10 + k);",
        "      ctx.fillStyle = '#38bdf8'; ctx.font = '700 15px ui-monospace, monospace';",
        "      drawCrispGlyphRun(kpis[k].value, kx + 10, ky + 40, 20 + k);",
        "    }",
        "    const cols = model.columns || [], rows = model.rows || [];",
        "    const colW = Math.floor((cssW - 48) / Math.max(1, cols.length));",
        "    const tableTop = kpis.length > 0 ? 138 : 76;",
        "    ctx.fillStyle = '#17253e'; ctx.fillRect(24, tableTop, cssW - 48, rowH);",
        "    ctx.fillStyle = '#cbd5e1'; ctx.font = '600 12.5px system-ui, sans-serif';",
        "    for (let c = 0; c < cols.length; c++) drawCrispGlyphRun(cols[c], 34 + c * colW, tableTop + 22, 30 + c);",
        "    ctx.font = '500 13px ui-monospace, monospace';",
        "    for (let r = 0; r < rows.length; r++) {",
        "      const ry = tableTop + (r + 1) * rowH;",
        "      ctx.fillStyle = (r % 2 === 1) ? 'rgba(23, 37, 62, 0.45)' : 'rgba(12, 19, 34, 0.25)';",
        "      ctx.fillRect(24, ry, cssW - 48, rowH);",
        "      ctx.fillStyle = '#f8fafc';",
        "      const cells = rows[r] || [];",
        "      for (let c = 0; c < cells.length; c++) drawCrispGlyphRun(cells[c], 34 + c * colW, ry + 22, 100 + r * 17 + c);",
        "    }",
        "  }",
        "  paintVaultSurface();",
        "  const baseImg = ctx.getImageData(0, 0, cv.width, cv.height);",
        "  if (STEGO_ON) {",
        "    const d = baseImg.data;",
        "    for (let bi = 0; bi < CANARY_BITS.length; bi++) {",
        "      const code = CANARY_BITS.charCodeAt(bi);",
        "      for (let bit = 0; bit < 8; bit++) {",
        "        const off = ((bi * 8 + bit) * 29) * 4;",
        "        if (off + 2 < d.length) d[off] = (d[off] & 254) | ((code >>> (7 - bit)) & 1);",
        "      }",
        "    }",
        "    ctx.putImageData(baseImg, 0, 0);",
        "  }",
        "  let shieldBlanked = false, tickParity = 0;",
        "  window.__pbOnShieldState = function(locked) {",
        "    shieldBlanked = !!locked;",
        "    if (shieldBlanked) { ctx.clearRect(0, 0, cv.width, cv.height); }",
        "    else { ctx.putImageData(baseImg, 0, 0); }",
        "  };",
        "  if (WEAVE_ON) {",
        "    const evenImg = new ImageData(new Uint8ClampedArray(baseImg.data), cv.width, cv.height);",
        "    const oddImg = new ImageData(new Uint8ClampedArray(baseImg.data), cv.width, cv.height);",
        "    const src = baseImg.data, ed = evenImg.data, od = oddImg.data, W = cv.width, H = cv.height;",
        "    for (let y = 0; y < H; y++) {",
        "      for (let x = 0; x < W; x++) {",
        "        const o = (y * W + x) * 4, sgn = ((x + y) & 1) === 0 ? 1 : -1;",
        "        for (let c = 0; c < 3; c++) {",
        "          const v = src[o + c], eff = Math.min(WEAVE_AMP, v, 255 - v);",
        "          ed[o + c] = v + sgn * eff; od[o + c] = v - sgn * eff;",
        "        }",
        "      }",
        "    }",
        "    function temporalSubframeWeaveLoop() {",
        "      if (!shieldBlanked) {",
        "        ctx.putImageData((tickParity & 1) === 0 ? evenImg : oddImg, 0, 0);",
        "        tickParity = (tickParity + 1) & 1;",
        "      }",
        "      requestAnimationFrame(temporalSubframeWeaveLoop);",
        "    }",
        "    requestAnimationFrame(temporalSubframeWeaveLoop);",
        "  }",
        "})();"
    ], "\n");

    return "<div id=\"" + cid + "\" class=\"pb-protected-surface pb-confidential-vault\" role=\"region\" aria-label=\"Protected Confidential Canvas Vault\" data-component=\"ConfidentialReportVault\">"
        + honeypot
        + "<canvas id=\"" + cid + "-canvas\" width=\"920\" height=\"360\"></canvas>"
        + "<script>" + widget_js + "</script>"
        + "</div>";
}

// Standalone Zero-DOM Confidential Report HTML5 Document Generator
fn render_protected_report_html(report_spec, policy = nil) {
    let pol = if _is_map_val(policy) {
        policy
    } else {
        create_protection_policy(map{ anti_camera_and_llm_vision: "report_vault" })
    };
    let vault_id = str(_opt(report_spec, "id", "pb-vault-report"));
    let css = build_web_shield_css(pol);
    let shield_js = build_web_shield_runtime_js(pol, "#" + vault_id + "-canvas, canvas");
    let widget = render_protected_report_widget(vault_id, report_spec, pol);

    return str_join([
        "<!DOCTYPE html>",
        "<html lang=\"en\" data-pb-vault=\"proprietary\">",
        "<head>",
        "<meta charset=\"utf-8\"/>",
        "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/>",
        "<meta name=\"robots\" content=\"noindex,nofollow,noarchive,nosnippet,noimageindex\"/>",
        "<title>Protected Confidential Vault — All Rights Reserved</title>",
        "<style>",
        "body { margin: 0; padding: 24px; background: #070b14; color: #e2e8f0; font-family: system-ui, sans-serif; display: flex; flex-direction: column; align-items: center; }",
        "canvas { border: 1px solid #1e293b; border-radius: 8px; box-shadow: 0 16px 40px rgba(0,0,0,0.6); max-width: 100%; }",
        css,
        "</style>",
        "</head>",
        "<body class=\"pb-protected-surface\">",
        "<div id=\"pb-privacy-veil\" aria-hidden=\"true\">CONFIDENTIAL VIEWPORT LOCKED — RETURN FOCUS TO RESUME</div>",
        "<script>",
        shield_js,
        "</script>",
        widget,
        "</body>",
        "</html>"
    ], "\n");
}

// ═════════════════════════════════════════════════════════════════════════════
// 4. Source-Level Identifier Minifier & String Encryptor (`obfuscate_sapp_source`)
// ═════════════════════════════════════════════════════════════════════════════

let _KEYWORDS = map{
    "let": true, "const": true, "fn": true, "return": true,
    "if": true, "elif": true, "else": true, "while": true,
    "for": true, "in": true, "to": true, "loop": true,
    "break": true, "continue": true, "match": true,
    "try": true, "catch": true, "throw": true, "defer": true,
    "export": true, "import": true, "and": true, "or": true, "not": true,
    "true": true, "false": true, "nil": true, "print": true, "println": true,
    "struct": true, "any": true, "int": true, "i64": true, "int64": true,
    "u64": true, "i32": true, "u32": true, "u8": true, "byte": true,
    "f64": true, "num": true, "number": true, "float": true, "double": true,
    "bool": true, "str": true, "string": true, "void": true
};

let _EXTRA_BUILTINS = map{
    "println": true, "sin": true, "cos": true, "tan": true, "asin": true, "acos": true, "atan": true,
    "sqrt": true, "abs": true, "floor": true, "ceil": true, "round": true, "min": true, "max": true,
    "pow": true, "exp": true, "log": true, "keys": true, "values": true, "time_ms": true,
    "struct_schema": true, "struct_buf_new": true, "struct_buf_len": true, "struct_buf_stride": true,
    "struct_get_i64": true, "struct_set_i64": true, "struct_get_f64": true, "struct_set_f64": true,
    "struct_sort_by": true, "struct_reduce_f64": true, "graph_bfs_shortest_path": true,
    "graph_dijkstra_f64": true, "gfx3d_raster_triangles": true, "sha256_bytes": true, "args": true
};

fn _is_protected_ident(nm) {
    if map_has(_KEYWORDS, nm) { return true; }
    if map_has(_EXTRA_BUILTINS, nm) { return true; }
    if _BUILTINS.is_builtin_name(nm) { return true; }
    return false;
}

fn _is_ident_start_code(c) {
    return c == 95 or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c >= 160;
}

fn _is_ident_cont_code(c) {
    return _is_ident_start_code(c) or (c >= 48 and c <= 57);
}

fn _is_digit_code(c) {
    return c >= 48 and c <= 57;
}

// Lexical scanner producing exact non-comment tokens with byte spans `[start, end)`
fn _lex_sapp_tokens(src) {
    let toks = [];
    let n = len(src);
    let p = 0;
    while p < n {
        let c = strcharcodeat(src, p);
        // Whitespace
        if c == 32 or c == 9 or c == 10 or c == 13 {
            p = p + 1;
        } elif c == 47 and p + 1 < n and strcharcodeat(src, p + 1) == 47 {
            // Line comment //
            p = p + 2;
            while p < n and strcharcodeat(src, p) != 10 { p = p + 1; }
        } elif c == 47 and p + 1 < n and strcharcodeat(src, p + 1) == 42 {
            // Block comment /* ... */
            p = p + 2;
            while p + 1 < n and not (strcharcodeat(src, p) == 42 and strcharcodeat(src, p + 1) == 47) {
                p = p + 1;
            }
            p = p + 2;
        } elif c == 64 and p + 1 < n and _is_ident_start_code(strcharcodeat(src, p + 1)) {
            // Annotation `@nogc`, `@packed`, `@server_only`
            let s0 = p;
            p = p + 1;
            while p < n and _is_ident_cont_code(strcharcodeat(src, p)) { p = p + 1; }
            array_push(toks, map{ kind: "annot", val: str_slice(src, s0, p), start: s0, end: p });
        } elif c == 102 and p + 1 < n and strcharcodeat(src, p + 1) == 34 {
            // f-string `f"..."`
            let s0 = p;
            p = p + 2;
            while p < n {
                let sc = strcharcodeat(src, p);
                if sc == 92 { p = p + 2; }
                elif sc == 34 { p = p + 1; break; }
                else { p = p + 1; }
            }
            array_push(toks, map{ kind: "fstr", val: str_slice(src, s0, p), start: s0, end: p });
        } elif c == 34 {
            // Double-quoted string literal `"..."`
            let s0 = p;
            p = p + 1;
            let unesc = [];
            while p < n {
                let sc = strcharcodeat(src, p);
                if sc == 92 and p + 1 < n {
                    let nx = strcharcodeat(src, p + 1);
                    if nx == 110 { array_push(unesc, "\n"); }
                    elif nx == 114 { array_push(unesc, "\r"); }
                    elif nx == 116 { array_push(unesc, "\t"); }
                    elif nx == 34 { array_push(unesc, "\""); }
                    elif nx == 92 { array_push(unesc, "\\"); }
                    elif nx == 48 { array_push(unesc, str_from_char_code(0)); }
                    else { array_push(unesc, str_slice(src, p + 1, p + 2)); }
                    p = p + 2;
                } elif sc == 34 {
                    p = p + 1;
                    break;
                } else {
                    array_push(unesc, str_slice(src, p, p + 1));
                    p = p + 1;
                }
            }
            array_push(toks, map{
                kind: "str",
                val: str_slice(src, s0, p),
                decoded: str_join(unesc, ""),
                start: s0,
                end: p
            });
        } elif _is_digit_code(c) {
            let s0 = p;
            if c == 48 and p + 1 < n and (strcharcodeat(src, p + 1) == 120 or strcharcodeat(src, p + 1) == 88) {
                p = p + 2;
                while p < n {
                    let hc = strcharcodeat(src, p);
                    if (hc >= 48 and hc <= 57) or (hc >= 65 and hc <= 70) or (hc >= 97 and hc <= 102) { p = p + 1; }
                    else { break; }
                }
            } else {
                while p < n and _is_digit_code(strcharcodeat(src, p)) { p = p + 1; }
                if p + 1 < n and strcharcodeat(src, p) == 46 and _is_digit_code(strcharcodeat(src, p + 1)) {
                    p = p + 1;
                    while p < n and _is_digit_code(strcharcodeat(src, p)) { p = p + 1; }
                }
                if p < n and (strcharcodeat(src, p) == 101 or strcharcodeat(src, p) == 69) {
                    p = p + 1;
                    if p < n and (strcharcodeat(src, p) == 43 or strcharcodeat(src, p) == 45) { p = p + 1; }
                    while p < n and _is_digit_code(strcharcodeat(src, p)) { p = p + 1; }
                }
            }
            array_push(toks, map{ kind: "num", val: str_slice(src, s0, p), start: s0, end: p });
        } elif _is_ident_start_code(c) {
            let s0 = p;
            p = p + 1;
            while p < n and _is_ident_cont_code(strcharcodeat(src, p)) { p = p + 1; }
            array_push(toks, map{ kind: "ident", val: str_slice(src, s0, p), start: s0, end: p });
        } else {
            let two = if p + 1 < n { str_slice(src, p, p + 2) } else { "" };
            if two == "==" or two == "!=" or two == "<=" or two == ">=" or two == "->" or two == "=>" or two == "&&" or two == "||" or two == ".." {
                array_push(toks, map{ kind: "punct", val: two, start: p, end: p + 2 });
                p = p + 2;
            } else {
                array_push(toks, map{ kind: "punct", val: str_slice(src, p, p + 1), start: p, end: p + 1 });
                p = p + 1;
            }
        }
    }
    return toks;
}

fn _hex_ident(idx) {
    let digits = "0123456789abcdef";
    let v = idx + 26; // Starts at 0x1a -> _0x1a, _0x1b, ...
    let out = "";
    while v > 0 {
        let nib = v % 16;
        out = str_slice(digits, nib, nib + 1) + out;
        v = num_floor(v / 16);
    }
    return "_0x" + out;
}

fn _needs_space(a, b) {
    if a == "" or b == "" { return false; }
    let ca = strcharcodeat(a, len(a) - 1);
    let cb = strcharcodeat(b, 0);
    if _is_ident_cont_code(ca) and (_is_ident_cont_code(cb) or cb == 64) { return true; }
    if (a == "=" or a == "!" or a == "<" or a == ">") and cb == 61 { return true; }
    if a == "-" and (cb == 62 or _is_digit_code(cb)) { return true; }
    return false;
}

// Pure-PBLang lexical/AST identifier minifier & string literal rolling-XOR encryptor
fn obfuscate_sapp_source(sapp_src, opts = nil) {
    let o = if _is_map_val(opts) { opts } else { map{} };
    let obf_exports = _opt(o, "obfuscate_exports", false) == true;
    let enc_strings = _opt(o, "encrypt_strings", true) == true;
    let preserve_list = _opt(o, "preserve_names", []);

    let preserve_set = map{};
    let pi = 0;
    while pi < len(preserve_list) {
        preserve_set[str(preserve_list[pi])] = true;
        pi = pi + 1;
    }

    let toks = _lex_sapp_tokens(str(sapp_src));
    let n = len(toks);

    // Pass 1: Collect `export ...;` names & all user-declared identifiers (`fn`, params, `let`, `const`, `for`, `catch`)
    let exported_set = map{};
    let decl_order = [];
    let decl_seen = map{};
    let param_token_indices = map{};

    let i = 0;
    while i < n {
        let tk = toks[i];
        if tk.kind == "ident" and tk.val == "export" {
            let j = i + 1;
            if j < n and toks[j].kind == "ident" and toks[j].val == "fn" and j + 1 < n and toks[j + 1].kind == "ident" {
                exported_set[toks[j + 1].val] = true;
            } else {
                while j < n and toks[j].val != ";" {
                    if toks[j].kind == "ident" {
                        exported_set[toks[j].val] = true;
                    }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }

    i = 0;
    while i < n {
        let tk = toks[i];
        let prev_val = if i > 0 { toks[i - 1].val } else { "" };

        if tk.kind == "ident" and (tk.val == "let" or tk.val == "const") and prev_val != "." {
            if i + 1 < n and toks[i + 1].kind == "ident" {
                let vnm = toks[i + 1].val;
                if not map_has(decl_seen, vnm) {
                    decl_seen[vnm] = true;
                    array_push(decl_order, vnm);
                }
                param_token_indices[str(i + 1)] = true;
            }
        } elif tk.kind == "ident" and tk.val == "fn" and prev_val != "." {
            let p_open = i + 1;
            if p_open < n and toks[p_open].kind == "ident" {
                let fnm = toks[p_open].val;
                if not map_has(decl_seen, fnm) {
                    decl_seen[fnm] = true;
                    array_push(decl_order, fnm);
                }
                param_token_indices[str(p_open)] = true;
                p_open = p_open + 1;
            }
            if p_open < n and toks[p_open].val == "(" {
                let depth = 1;
                let k = p_open + 1;
                let expect_param = true;
                while k < n and depth > 0 {
                    let kv = toks[k].val;
                    if kv == "(" or kv == "[" or kv == "{" {
                        depth = depth + 1;
                    } elif kv == ")" or kv == "]" or kv == "}" {
                        depth = depth - 1;
                    } elif depth == 1 and kv == "," {
                        expect_param = true;
                    } elif depth == 1 and expect_param and toks[k].kind == "ident" {
                        let pnm = toks[k].val;
                        if not map_has(decl_seen, pnm) {
                            decl_seen[pnm] = true;
                            array_push(decl_order, pnm);
                        }
                        param_token_indices[str(k)] = true;
                        expect_param = false;
                    } elif depth == 1 {
                        expect_param = false;
                    }
                    k = k + 1;
                }
            }
        } elif tk.kind == "ident" and tk.val == "for" and prev_val != "." {
            let fk = i + 1;
            while fk < n and toks[fk].val != "in" and toks[fk].val != "=" and toks[fk].val != "{" {
                if toks[fk].kind == "ident" {
                    let lnm = toks[fk].val;
                    if not map_has(decl_seen, lnm) {
                        decl_seen[lnm] = true;
                        array_push(decl_order, lnm);
                    }
                    param_token_indices[str(fk)] = true;
                }
                fk = fk + 1;
            }
        } elif tk.kind == "ident" and tk.val == "catch" and prev_val != "." {
            if i + 1 < n and toks[i + 1].kind == "ident" and i + 2 < n and toks[i + 2].val == "{" {
                let cnm = toks[i + 1].val;
                if not map_has(decl_seen, cnm) {
                    decl_seen[cnm] = true;
                    array_push(decl_order, cnm);
                }
                param_token_indices[str(i + 1)] = true;
            }
        }
        i = i + 1;
    }

    let rename_map = map{};
    let next_id = 0;
    i = 0;
    while i < len(decl_order) {
        let cand = decl_order[i];
        let keep = _is_protected_ident(cand) or map_has(preserve_set, cand) or (not obf_exports and map_has(exported_set, cand));
        if not keep {
            rename_map[cand] = _hex_ident(next_id);
            next_id = next_id + 1;
        }
        i = i + 1;
    }

    // Pass 2: Rewrite identifiers and optionally encrypt string literals
    let out_toks = [];
    let encrypted_string_count = 0;
    i = 0;
    while i < n {
        let tk = toks[i];
        let prev_v = if i > 0 { toks[i - 1].val } else { "" };
        let next_v = if i + 1 < n { toks[i + 1].val } else { "" };

        if tk.kind == "ident" and map_has(rename_map, tk.val) {
            let is_member = (prev_v == ".");
            let is_type_pos = (prev_v == "->" or (prev_v == ":" and i >= 2 and map_has(param_token_indices, str(i - 2))));
            // Distinguish `map{ key: val }` unquoted key from `let x: i64` / `fn(x: i64)`
            let is_map_key = (next_v == ":" and not map_has(param_token_indices, str(i)));
            if not is_member and not is_type_pos and not is_map_key {
                array_push(out_toks, rename_map[tk.val]);
            } else {
                array_push(out_toks, tk.val);
            }
        } elif tk.kind == "str" and enc_strings {
            // Preserve `import("...")` paths and `"key":` map keys as static string literals
            let is_import_lit = (prev_v == "import") or (prev_v == "(" and i >= 2 and toks[i - 2].val == "import");
            let is_str_key = (next_v == ":");
            let raw_bytes = str_to_bytes(tk.decoded);
            if is_import_lit or is_str_key or len(raw_bytes) == 0 {
                array_push(out_toks, tk.val);
            } else {
                let kseed = ((encrypted_string_count * 67 + 137) % 251) + 1;
                encrypted_string_count = encrypted_string_count + 1;
                let enc_nums = [];
                let bi = 0;
                while bi < len(raw_bytes) {
                    let mask = bit_and(kseed + bi * 73 + 19, 255);
                    array_push(enc_nums, str(bit_xor(bit_and(raw_bytes[bi], 255), mask)));
                    bi = bi + 1;
                }
                array_push(out_toks, "_0x0([" + str_join(enc_nums, ",") + "]," + str(kseed) + ")");
            }
        } else {
            array_push(out_toks, tk.val);
        }
        i = i + 1;
    }

    let assembled = [];
    if encrypted_string_count > 0 {
        // Pure-PBLang runtime rolling-XOR string unsealer `_0x0`
        array_push(assembled, "fn _0x0(_a,_k){let _b=[];let _i=0;while _i<len(_a){array_push(_b,bit_xor(_a[_i],bit_and(_k+_i*73+19,255)));_i=_i+1;}return bytes_to_str(_b);}\n");
    }

    let prev_emitted = "";
    i = 0;
    while i < len(out_toks) {
        let cur = out_toks[i];
        if _needs_space(prev_emitted, cur) {
            array_push(assembled, " ");
        }
        array_push(assembled, cur);
        if cur == ";" or cur == "}" {
            array_push(assembled, "\n");
            prev_emitted = "";
        } else {
            prev_emitted = cur;
        }
        i = i + 1;
    }

    let obf_code = str_join(assembled, "");
    return map{
        ok: true,
        code: obf_code,
        renamed_count: next_id,
        encrypted_strings: encrypted_string_count,
        symbol_map: rename_map,
        original_bytes: len(str(sapp_src)),
        obfuscated_bytes: len(obf_code)
    };
}

// ═════════════════════════════════════════════════════════════════════════════
// 5. Hybrid Page + Executable Split-Execution Compiler (`compile_split_application`)
// ═════════════════════════════════════════════════════════════════════════════

// Scans `.sapp` source for `@server_only fn ...` (or `opts.server_functions`) and physically splits:
//   - `server_vault_code`: holds 100% of proprietary `@server_only` formulas + HMAC-SHA256 + anti-replay RPC dispatcher
//   - `client_stub_code`: 0 bytes of secret formula on client; replaces `@server_only` bodies with signed HMAC-SHA256 RPC stubs
fn compile_split_application(sapp_src, opts = nil) {
    let o = if _is_map_val(opts) { opts } else { map{} };
    let explicit_list = _opt(o, "server_functions", []);
    let explicit_set = map{};
    let ei = 0;
    while ei < len(explicit_list) {
        explicit_set[str(explicit_list[ei])] = true;
        ei = ei + 1;
    }

    let src = str(sapp_src);
    let toks = _lex_sapp_tokens(src);
    let n = len(toks);

    let server_fns = [];
    let excise_spans = [];

    let i = 0;
    while i < n {
        let is_annotated = (toks[i].kind == "annot" and toks[i].val == "@server_only");
        let fn_tok_idx = -1;
        let span_start = toks[i].start;
        let had_export_kw = false;

        if is_annotated {
            let k = i + 1;
            if k < n and toks[k].kind == "ident" and toks[k].val == "export" {
                had_export_kw = true;
                k = k + 1;
            }
            if k < n and toks[k].kind == "ident" and toks[k].val == "fn" {
                fn_tok_idx = k;
            }
        } elif toks[i].kind == "ident" and toks[i].val == "fn" and (i == 0 or toks[i - 1].kind != "annot") {
            if i + 1 < n and toks[i + 1].kind == "ident" and map_has(explicit_set, toks[i + 1].val) {
                fn_tok_idx = i;
                if i > 0 and toks[i - 1].kind == "ident" and toks[i - 1].val == "export" {
                    span_start = toks[i - 1].start;
                    had_export_kw = true;
                } else {
                    span_start = toks[i].start;
                }
            }
        }

        if fn_tok_idx >= 0 and fn_tok_idx + 2 < n and toks[fn_tok_idx + 1].kind == "ident" {
            let fn_name = toks[fn_tok_idx + 1].val;
            let p_open = fn_tok_idx + 2;
            if toks[p_open].val == "(" {
                // Parse parameter names inside `(...)`
                let params = [];
                let pdepth = 1;
                let pk = p_open + 1;
                let expect_p = true;
                while pk < n and pdepth > 0 {
                    let pv = toks[pk].val;
                    if pv == "(" or pv == "[" or pv == "{" { pdepth = pdepth + 1; }
                    elif pv == ")" or pv == "]" or pv == "}" { pdepth = pdepth - 1; }
                    elif pdepth == 1 and pv == "," { expect_p = true; }
                    elif pdepth == 1 and expect_p and toks[pk].kind == "ident" {
                        array_push(params, pv);
                        expect_p = false;
                    } elif pdepth == 1 {
                        expect_p = false;
                    }
                    pk = pk + 1;
                }
                // Locate opening `{` of function body
                let b_open = pk;
                while b_open < n and toks[b_open].val != "{" { b_open = b_open + 1; }
                if b_open < n and toks[b_open].val == "{" {
                    let bdepth = 1;
                    let bk = b_open + 1;
                    while bk < n and bdepth > 0 {
                        if toks[bk].val == "{" { bdepth = bdepth + 1; }
                        elif toks[bk].val == "}" { bdepth = bdepth - 1; }
                        bk = bk + 1;
                    }
                    let span_end = toks[bk - 1].end;
                    let clean_fn_src = str_slice(src, toks[fn_tok_idx].start, span_end);
                    array_push(server_fns, map{
                        name: fn_name,
                        params: params,
                        had_export: had_export_kw,
                        fn_source: clean_fn_src
                    });
                    array_push(excise_spans, map{
                        start: span_start,
                        end: span_end,
                        fn_name: fn_name,
                        params: params,
                        had_export: had_export_kw
                    });
                    i = bk;
                    continue;
                }
            }
        }
        i = i + 1;
    }

    if len(server_fns) == 0 {
        _err("compile_split_application found no @server_only functions (or opts.server_functions)");
    }

    // 1. Assemble `server_vault_code` (Pure PBLang, contains secret formulas + HMAC-SHA256 + anti-replay gate)
    let sv_lines = [
        "// Generated by PBLang v4.1.0 Split-Execution Server Vault Compiler",
        "// CONFIDENTIAL SERVER-ONLY EXECUTION UNIT — DO NOT DISTRIBUTE TO CLIENT",
        "let _VAULT_SEEN_NONCES = map{};",
        "fn reset_vault_replay_cache() { _VAULT_SEEN_NONCES = map{}; return true; }",
        "fn _vault_sig_payload(fn_name, args_arr, nonce_s, ts_val) {",
        "    return str(fn_name) + \"|\" + json_stringify(args_arr) + \"|\" + str(nonce_s) + \"|\" + str(ts_val);",
        "}"
    ];

    let sfi = 0;
    let sf_names = [];
    while sfi < len(server_fns) {
        array_push(sv_lines, server_fns[sfi].fn_source);
        array_push(sf_names, server_fns[sfi].name);
        sfi = sfi + 1;
    }

    array_push(sv_lines, "fn handle_vault_rpc(req_json, shared_secret) {");
    array_push(sv_lines, "    if shared_secret == nil or len(str(shared_secret)) == 0 {");
    array_push(sv_lines, "        return json_stringify(map{ ok: false, error: \"missing_shared_secret\", code: 500 });");
    array_push(sv_lines, "    }");
    array_push(sv_lines, "    let req = try json_parse(str(req_json)) catch nil;");
    array_push(sv_lines, "    if req == nil or not is_map(req) {");
    array_push(sv_lines, "        return json_stringify(map{ ok: false, error: \"malformed_rpc_json\", code: 400 });");
    array_push(sv_lines, "    }");
    array_push(sv_lines, "    if not map_has(req, \"fn_name\") or not map_has(req, \"args\") or not map_has(req, \"nonce\") or not map_has(req, \"ts\") or not map_has(req, \"hmac\") {");
    array_push(sv_lines, "        return json_stringify(map{ ok: false, error: \"missing_auth_envelope_fields\", code: 400 });");
    array_push(sv_lines, "    }");
    array_push(sv_lines, "    let nonce_s = str(req.nonce);");
    array_push(sv_lines, "    if len(nonce_s) == 0 or map_has(_VAULT_SEEN_NONCES, nonce_s) {");
    array_push(sv_lines, "        return json_stringify(map{ ok: false, error: \"replay_detected\", code: 403 });");
    array_push(sv_lines, "    }");
    array_push(sv_lines, "    let sig_in = _vault_sig_payload(req.fn_name, req.args, nonce_s, req.ts);");
    array_push(sv_lines, "    let expected_mac = hmac_sha256(sig_in, str(shared_secret));");
    array_push(sv_lines, "    if not constant_time_eq(expected_mac, str(req.hmac)) {");
    array_push(sv_lines, "        return json_stringify(map{ ok: false, error: \"invalid_hmac_signature\", code: 401 });");
    array_push(sv_lines, "    }");
    array_push(sv_lines, "    _VAULT_SEEN_NONCES[nonce_s] = req.ts;");
    array_push(sv_lines, "    let a = req.args;");

    sfi = 0;
    while sfi < len(server_fns) {
        let sf = server_fns[sfi];
        let call_args = [];
        let pi = 0;
        while pi < len(sf.params) {
            array_push(call_args, "a[" + str(pi) + "]");
            pi = pi + 1;
        }
        array_push(sv_lines, "    if req.fn_name == \"" + sf.name + "\" {");
        array_push(sv_lines, "        if not is_array(a) or len(a) != " + str(len(sf.params)) + " { return json_stringify(map{ ok: false, error: \"arity_mismatch\", code: 400 }); }");
        array_push(sv_lines, "        let val = " + sf.name + "(" + str_join(call_args, ", ") + ");");
        array_push(sv_lines, "        return json_stringify(map{ ok: true, result: val });");
        array_push(sv_lines, "    }");
        sfi = sfi + 1;
    }

    array_push(sv_lines, "    return json_stringify(map{ ok: false, error: \"unknown_vault_function\", code: 404 });");
    array_push(sv_lines, "}");
    array_push(sv_lines, "export handle_vault_rpc, reset_vault_replay_cache;");
    let server_vault_code = str_join(sv_lines, "\n") + "\n";

    // 2. Assemble `client_stub_code` (physically excising 100% of `@server_only` bodies!)
    let client_header = str_join([
        "// Generated by PBLang v4.1.0 Split-Execution Client Stub Compiler",
        "// ZERO SERVER FORMULA BYTES PRESENT — AUTHENTICATED HMAC-SHA256 RPC STUBS ONLY",
        "let _CLIENT_VAULT_CFG = map{ transport: nil, secret: \"\", seq: 0 };",
        "fn configure_vault_rpc(transport_fn, shared_secret) {",
        "    _CLIENT_VAULT_CFG.transport = transport_fn;",
        "    _CLIENT_VAULT_CFG.secret = str(shared_secret);",
        "    return true;",
        "}",
        "fn build_signed_vault_request(fn_name, args_arr, shared_secret, nonce_s, ts_val) {",
        "    let sig_in = str(fn_name) + \"|\" + json_stringify(args_arr) + \"|\" + str(nonce_s) + \"|\" + str(ts_val);",
        "    let mac = hmac_sha256(sig_in, str(shared_secret));",
        "    return json_stringify(map{ fn_name: fn_name, args: args_arr, nonce: str(nonce_s), ts: ts_val, hmac: mac });",
        "}",
        "fn _invoke_vault_rpc(fn_name, args_arr) {",
        "    if _CLIENT_VAULT_CFG.transport == nil { throw \"vault_rpc: transport not configured\"; }",
        "    _CLIENT_VAULT_CFG.seq = _CLIENT_VAULT_CFG.seq + 1;",
        "    let ts_now = num_floor(now_ms());",
        "    let nonce_s = \"n_\" + str(ts_now) + \"_\" + str(_CLIENT_VAULT_CFG.seq);",
        "    let req_json = build_signed_vault_request(fn_name, args_arr, _CLIENT_VAULT_CFG.secret, nonce_s, ts_now);",
        "    let raw_resp = _CLIENT_VAULT_CFG.transport(req_json);",
        "    let resp = json_parse(str(raw_resp));",
        "    if not resp.ok { throw \"vault_rpc_rejected: \" + str(resp.error); }",
        "    return resp.result;",
        "}"
    ], "\n") + "\n";

    let client_chunks = [client_header];
    let cursor = 0;
    let xi = 0;
    while xi < len(excise_spans) {
        let sp = excise_spans[xi];
        if sp.start > cursor {
            array_push(client_chunks, str_slice(src, cursor, sp.start));
        }
        let p_list = str_join(sp.params, ", ");
        let exp_kw = if sp.had_export { "export " } else { "" };
        let stub_fn = exp_kw + "fn " + sp.fn_name + "(" + p_list + ") {\n    return _invoke_vault_rpc(\"" + sp.fn_name + "\", [" + p_list + "]);\n}";
        array_push(client_chunks, stub_fn);
        cursor = sp.end;
        xi = xi + 1;
    }
    if cursor < len(src) {
        array_push(client_chunks, str_slice(src, cursor, len(src)));
    }
    array_push(client_chunks, "\nexport configure_vault_rpc, build_signed_vault_request;\n");
    let client_stub_code = str_join(client_chunks, "");

    return map{
        ok: true,
        server_functions: sf_names,
        server_function_count: len(server_fns),
        server_vault_code: server_vault_code,
        client_stub_code: client_stub_code
    };
}

export SHIELD_VERSION, CANARY_MAGIC, WIN32_WDA_EXCLUDEFROMCAPTURE, ANDROID_FLAG_SECURE;
export chacha20_block_bytes, chacha20_xor_bytes, hmac_sha256_raw, crc16_ccitt;
export create_protection_policy;
export compute_rgba_psnr_metrics, embed_invisible_canary_rgba, extract_invisible_canary_rgba, generate_temporal_subframe_pair;
export encrypt_vault_payload, build_web_shield_css, build_scraper_honeypot_html, build_web_shield_runtime_js;
export render_protected_report_widget, render_protected_report_html;
export obfuscate_sapp_source, compile_split_application;
