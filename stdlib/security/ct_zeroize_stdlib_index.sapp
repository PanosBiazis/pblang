// stdlib/security/ct_zeroize_stdlib_index.sapp — Formal @constant_time & @zeroize
// Side-Channel Verifier + Sub-Millisecond Binary "PBIDXv01" Stdlib Indexer (PBLang v5.0.0).
// 100% Pure PBLang (Zero C, Zero Python, Zero external toolchains).

let VERIFIER_VERSION = "5.0.0";
let PBIDX_MAGIC = "PBIDXv01";
let _MASK32 = 4294967295;
let _FNV_OFFSET_32 = 2166136261;
let _FNV_PRIME_32 = 16777619;

// ── 1. Constant-Time Bitwise & Deterministic Zeroization Primitives ──────────

// Branchless 64-bit two's-complement mask: returns -1 (all 1-bits) if x != 0, else 0.
fn ct_nonzero_mask_i64(x) {
    let ix = num_floor(x);
    return bit_shr(bit_or(ix, 0 - ix), 63);
}

// Constant-time branchless u64/i64 multiplexer: returns `a` when `mask != 0`, else `b`.
fn ct_select_u64(mask, a, b) {
    let m = ct_nonzero_mask_i64(mask);
    let ia = num_floor(a);
    let ib = num_floor(b);
    return bit_xor(ib, bit_and(m, bit_xor(ia, ib)));
}

// Constant-time branchless equality returning 1 when a == b, else 0.
fn ct_eq_u64(a, b) {
    let diff = bit_xor(num_floor(a), num_floor(b));
    let nz = ct_nonzero_mask_i64(diff);
    return bit_and(bit_xor(nz, -1), 1);
}

// Constant-time byte-array / string comparison immune to early-exit timing side-channels.
fn ct_eq_bytes(a, b) {
    let ba = if is_array(a) { a } else { str_to_bytes(str(a)) };
    let bb = if is_array(b) { b } else { str_to_bytes(str(b)) };
    let na = len(ba);
    let nb = len(bb);
    let acc = bit_xor(na, nb);
    let lim = num_max(na, nb);
    let i = 0;
    while i < lim {
        let va = if i < na { bit_and(ba[i], 255) } else { 0 };
        let vb = if i < nb { bit_and(bb[i], 255) } else { 0 };
        acc = bit_or(acc, bit_xor(va, vb));
        i = i + 1;
    }
    return ct_eq_u64(acc, 0) == 1;
}

// Deterministic in-place secret buffer wipe returning volatile zero barrier.
fn zeroize_buf(buf) {
    if is_array(buf) {
        let barrier = 0;
        let i = 0;
        while i < len(buf) {
            buf[i] = 0;
            barrier = bit_or(barrier, buf[i]);
            i = i + 1;
        }
        return barrier;
    }
    if is_map(buf) {
        let ks = map_keys(buf);
        let j = 0;
        while j < len(ks) {
            let k = ks[j];
            if is_array(buf[k]) { zeroize_buf(buf[k]); } else { buf[k] = 0; }
            j = j + 1;
        }
        return 0;
    }
    return 0;
}

fn taint_secret(val) {
    return val;
}

// ── 2. Compile-Time @constant_time & @zeroize Static Taint/CFG Verifier ──────

fn _is_alpha(c) {
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
}

fn _is_alnum(c) {
    return _is_alpha(c) or (c >= 48 and c <= 57);
}

fn _tokenize_ct_source(src) {
    let s = str(src);
    let n = len(s);
    let toks = [];
    let i = 0;
    let line = 1;
    while i < n {
        let c = strcharcodeat(s, i);
        if c == 10 {
            line = line + 1;
            i = i + 1;
        } elif c == 32 or c == 9 or c == 13 {
            i = i + 1;
        } elif c == 47 and i + 1 < n and strcharcodeat(s, i + 1) == 47 {
            while i < n and strcharcodeat(s, i) != 10 { i = i + 1; }
        } elif c == 34 {
            let st = i;
            i = i + 1;
            while i < n and strcharcodeat(s, i) != 34 {
                if strcharcodeat(s, i) == 92 { i = i + 1; }
                if i < n and strcharcodeat(s, i) == 10 { line = line + 1; }
                i = i + 1;
            }
            if i < n { i = i + 1; }
            array_push(toks, map{ kind: "str", text: str_slice(s, st, i), line: line, pos: st, end_pos: i });
        } elif _is_alpha(c) {
            let st = i;
            while i < n and _is_alnum(strcharcodeat(s, i)) { i = i + 1; }
            array_push(toks, map{ kind: "id", text: str_slice(s, st, i), line: line, pos: st, end_pos: i });
        } elif c >= 48 and c <= 57 {
            let st = i;
            while i < n and ((strcharcodeat(s, i) >= 48 and strcharcodeat(s, i) <= 57) or strcharcodeat(s, i) == 46) {
                i = i + 1;
            }
            array_push(toks, map{ kind: "num", text: str_slice(s, st, i), line: line, pos: st, end_pos: i });
        } else {
            let st = i;
            let two = if i + 1 < n { str_slice(s, i, i + 2) } else { "" };
            if two == "==" or two == "!=" or two == "<=" or two == ">=" or two == "&&" or two == "||" or two == "->" {
                array_push(toks, map{ kind: "sym", text: two, line: line, pos: st, end_pos: i + 2 });
                i = i + 2;
            } else {
                array_push(toks, map{ kind: "sym", text: str_slice(s, i, i + 1), line: line, pos: st, end_pos: i + 1 });
                i = i + 1;
            }
        }
    }
    array_push(toks, map{ kind: "eof", text: "", line: line, pos: n, end_pos: n });
    return toks;
}

fn _is_buf_type_name(ty_str) {
    let t = str_lower(str(ty_str));
    return str_contains(t, "buf") or str_contains(t, "bytes") or str_contains(t, "array") or
           str_contains(t, "slice") or str_contains(t, "vec") or str_contains(t, "[") or str_contains(t, "map");
}

fn _is_scalar_type_name(ty_str) {
    let t = str_lower(str(ty_str));
    return t == "u64" or t == "u32" or t == "u16" or t == "u8" or
           t == "i64" or t == "i32" or t == "i16" or t == "i8" or
           t == "int" or t == "number" or t == "bool" or t == "f32" or t == "f64";
}

fn _looks_like_buf_ident(name) {
    let nm = str_lower(str(name));
    return str_contains(nm, "buf") or str_contains(nm, "bytes") or str_contains(nm, "arr") or
           str_contains(nm, "block") or str_contains(nm, "state") or str_contains(nm, "subkey") or
           str_contains(nm, "pad");
}

fn _clone_bool_map(m) {
    let c = map{};
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        c[k] = m[k];
        i = i + 1;
    }
    return c;
}

fn audit_constant_time_and_zeroize(source_code) {
    let toks = _tokenize_ct_source(source_code);
    let st = map{ pos: 0, toks: toks };
    let peek = fn() { return st.toks[st.pos]; };
    let adv = fn() {
        let cur = st.toks[st.pos];
        if st.pos + 1 < len(st.toks) { st.pos = st.pos + 1; }
        return cur;
    };
    let eat = fn(txt) {
        if peek().text == txt { adv(); return true; }
        return false;
    };

    let violations = [];
    let audited_fns = [];

    let add_violation = fn(fn_name, rule_code, category, line_no, detail) {
        array_push(violations, map{
            function_name: fn_name,
            code: rule_code,
            category: category,
            line: line_no,
            message: detail
        });
    };

    let parse_type_str = fn() {
        let parts = [];
        if peek().text == "@" {
            array_push(parts, adv().text);
            array_push(parts, adv().text);
        }
        if peek().text == "[" {
            array_push(parts, adv().text);
            while peek().kind != "eof" and peek().text != "]" { array_push(parts, adv().text); }
            if peek().text == "]" { array_push(parts, adv().text); }
            return str_join(parts, "");
        }
        if peek().kind == "id" {
            array_push(parts, adv().text);
            if peek().text == "<" {
                array_push(parts, adv().text);
                while peek().kind != "eof" and peek().text != ">" { array_push(parts, adv().text); }
                if peek().text == ">" { array_push(parts, adv().text); }
            }
        }
        return str_join(parts, "");
    };

    while peek().kind != "eof" {
        let is_ct = false;
        let has_auto_zeroize = false;
        while peek().text == "@" {
            adv();
            let attr_nm = adv().text;
            if eat("(") {
                while peek().kind != "eof" and peek().text != ")" { adv(); }
                eat(")");
            }
            if attr_nm == "constant_time" { is_ct = true; }
            if attr_nm == "zeroize" { has_auto_zeroize = true; }
        }

        if peek().text == "export" or peek().text == "pub" {
            if st.pos + 1 < len(toks) and toks[st.pos + 1].text == "fn" { adv(); }
        }

        if peek().text == "fn" {
            let fn_line = adv().line;
            let fn_name = adv().text;
            eat("(");

            let tainted_vars = map{};
            let secret_bufs = map{};
            let zeroized = map{};

            while peek().kind != "eof" and peek().text != ")" {
                let p_sec = false;
                if eat("@") {
                    let pa = adv().text;
                    if pa == "secret" { p_sec = true; }
                }
                let pname = adv().text;
                let ptype = "";
                if eat(":") {
                    ptype = parse_type_str();
                    if str_contains(ptype, "@secret") or str_starts_with(str_lower(ptype), "secret<") {
                        p_sec = true;
                    }
                }
                if eat("=") {
                    while peek().kind != "eof" and peek().text != "," and peek().text != ")" { adv(); }
                }
                if p_sec {
                    tainted_vars[pname] = true;
                    if _is_buf_type_name(ptype) or (not _is_scalar_type_name(ptype) and _looks_like_buf_ident(pname)) {
                        secret_bufs[pname] = true;
                        zeroized[pname] = false;
                    }
                }
                eat(",");
            }
            eat(")");
            if eat(":") or eat("->") { parse_type_str(); }

            if peek().text == "{" {
                let analyze_expr = nil;
                let analyze_primary = fn() {
                    let tk = peek();
                    if tk.kind == "num" or tk.kind == "str" {
                        adv();
                        return map{ tainted: false, is_buf: false, text: tk.text, line: tk.line };
                    }
                    if tk.text == "[" {
                        let ln = adv().line;
                        let elem_taint = false;
                        while peek().kind != "eof" and peek().text != "]" {
                            let ev = analyze_expr();
                            if ev.tainted { elem_taint = true; }
                            eat(",");
                        }
                        eat("]");
                        return map{ tainted: elem_taint, is_buf: true, text: "[...]", line: ln };
                    }
                    if tk.text == "map" and st.pos + 1 < len(toks) and toks[st.pos + 1].text == "{" {
                        let ln = adv().line;
                        adv();
                        let mtaint = false;
                        while peek().kind != "eof" and peek().text != "}" {
                            adv();
                            if eat(":") {
                                let mv = analyze_expr();
                                if mv.tainted { mtaint = true; }
                            }
                            eat(",");
                        }
                        eat("}");
                        return map{ tainted: mtaint, is_buf: true, text: "map{...}", line: ln };
                    }
                    if tk.text == "(" {
                        adv();
                        let inner = analyze_expr();
                        eat(")");
                        return inner;
                    }
                    if tk.kind == "id" {
                        let id_tok = adv();
                        let nm = id_tok.text;
                        if nm == "true" or nm == "false" or nm == "nil" {
                            return map{ tainted: false, is_buf: false, text: nm, line: id_tok.line };
                        }
                        if eat("(") {
                            let args = [];
                            let arg_names = [];
                            while peek().kind != "eof" and peek().text != ")" {
                                let maybe_id = if peek().kind == "id" { peek().text } else { "" };
                                let av = analyze_expr();
                                array_push(args, av);
                                array_push(arg_names, maybe_id);
                                eat(",");
                            }
                            eat(")");
                            if nm == "zeroize_buf" or nm == "zeroize" {
                                if len(arg_names) > 0 and arg_names[0] != "" {
                                    zeroized[arg_names[0]] = true;
                                }
                                return map{ tainted: false, is_buf: false, text: nm + "(...)", line: id_tok.line };
                            }
                            if nm == "taint_secret" {
                                if len(arg_names) > 0 and arg_names[0] != "" {
                                    tainted_vars[arg_names[0]] = true;
                                }
                                let sub_buf = len(args) > 0 and args[0].is_buf;
                                return map{ tainted: true, is_buf: sub_buf, text: "taint_secret(...)", line: id_tok.line };
                            }
                            if nm == "len" {
                                if len(arg_names) > 0 and map_has(tainted_vars, arg_names[0]) {
                                    if not map_has(secret_bufs, arg_names[0]) {
                                        secret_bufs[arg_names[0]] = true;
                                        zeroized[arg_names[0]] = false;
                                    }
                                }
                                return map{ tainted: false, is_buf: false, text: "len(...)", line: id_tok.line };
                            }
                            let any_t = false;
                            let ai = 0;
                            while ai < len(args) {
                                if args[ai].tainted { any_t = true; }
                                ai = ai + 1;
                            }
                            if is_ct and (nm == "checked_div" or nm == "num_mod") and any_t {
                                add_violation(fn_name, "CT_VARIABLE_TIME_DIV", "variable_time_division", id_tok.line,
                                    "Variable-time division/modulo intrinsic '" + nm + "' on @secret value leaks operand magnitude via CPU divider cycles");
                            }
                            let makes_buf = nm == "random_bytes" or nm == "str_to_bytes" or nm == "hex_decode" or
                                            nm == "base64_decode_bytes" or nm == "allocate" or nm == "memory_alloc" or nm == "slice";
                            return map{ tainted: any_t, is_buf: makes_buf, text: nm + "(...)", line: id_tok.line };
                        }
                        let cur_t = map_has(tainted_vars, nm);
                        while eat("[") {
                            let idx_v = analyze_expr();
                            eat("]");
                            if map_has(tainted_vars, nm) and not map_has(secret_bufs, nm) {
                                secret_bufs[nm] = true;
                                zeroized[nm] = false;
                            }
                            if is_ct and idx_v.tainted {
                                add_violation(fn_name, "CT_SECRET_MEMORY_INDEX", "secret_memory_index", id_tok.line,
                                    "Secret-dependent array/table index '" + nm + "[" + idx_v.text + "]' leaks secret via L1 data-cache timing");
                            }
                            cur_t = cur_t or idx_v.tainted;
                        }
                        while eat(".") {
                            if peek().kind == "id" { adv(); }
                        }
                        return map{ tainted: cur_t, is_buf: map_has(secret_bufs, nm), text: nm, line: id_tok.line };
                    }
                    let unk = adv();
                    return map{ tainted: false, is_buf: false, text: unk.text, line: unk.line };
                };

                let analyze_unary = nil;
                analyze_unary = fn() {
                    if peek().text == "-" or peek().text == "!" or peek().text == "not" {
                        let u = adv();
                        let sub = analyze_unary();
                        return map{ tainted: sub.tainted, is_buf: false, text: u.text + sub.text, line: u.line };
                    }
                    return analyze_primary();
                };

                let analyze_mul = fn() {
                    let lhs = analyze_unary();
                    while peek().text == "*" or peek().text == "/" or peek().text == "%" {
                        let op_t = adv();
                        let rhs = analyze_unary();
                        if is_ct and (op_t.text == "/" or op_t.text == "%") and (lhs.tainted or rhs.tainted) {
                            add_violation(fn_name, "CT_VARIABLE_TIME_DIV", "variable_time_division", op_t.line,
                                "Variable-time '" + op_t.text + "' on @secret operand leaks timing via hardware divider early termination");
                        }
                        lhs = map{ tainted: lhs.tainted or rhs.tainted, is_buf: false, text: lhs.text + op_t.text + rhs.text, line: op_t.line };
                    }
                    return lhs;
                };

                let analyze_add = fn() {
                    let lhs = analyze_mul();
                    while peek().text == "+" or peek().text == "-" or peek().text == "&" or peek().text == "|" or peek().text == "^" {
                        let op_t = adv();
                        let rhs = analyze_mul();
                        lhs = map{ tainted: lhs.tainted or rhs.tainted, is_buf: false, text: lhs.text + op_t.text + rhs.text, line: op_t.line };
                    }
                    return lhs;
                };

                let analyze_cmp = fn() {
                    let lhs = analyze_add();
                    while peek().text == "==" or peek().text == "!=" or peek().text == "<" or peek().text == "<=" or peek().text == ">" or peek().text == ">=" {
                        let op_t = adv();
                        let rhs = analyze_add();
                        lhs = map{ tainted: lhs.tainted or rhs.tainted, is_buf: false, text: lhs.text + op_t.text + rhs.text, line: op_t.line };
                    }
                    return lhs;
                };

                analyze_expr = fn() {
                    let lhs = analyze_cmp();
                    while peek().text == "&&" or peek().text == "||" or peek().text == "and" or peek().text == "or" {
                        let op_t = adv();
                        let rhs = analyze_cmp();
                        if is_ct and (lhs.tainted or rhs.tainted) {
                            add_violation(fn_name, "CT_SECRET_SHORT_CIRCUIT", "secret_control_flow", op_t.line,
                                "Short-circuit operator '" + op_t.text + "' on @secret value creates secret-dependent branch timing");
                        }
                        lhs = map{ tainted: lhs.tainted or rhs.tainted, is_buf: false, text: lhs.text + " " + op_t.text + " " + rhs.text, line: op_t.line };
                    }
                    if peek().text == "?" {
                        let q_t = adv();
                        let tv = analyze_expr();
                        eat(":");
                        let fv = analyze_expr();
                        if is_ct and lhs.tainted {
                            add_violation(fn_name, "CT_SECRET_TERNARY", "secret_control_flow", q_t.line,
                                "Ternary '?:' conditioned on @secret expression '" + lhs.text + "' leaks branch timing");
                        }
                        return map{ tainted: lhs.tainted or tv.tainted or fv.tainted, is_buf: tv.is_buf or fv.is_buf, text: lhs.text + "?...", line: q_t.line };
                    }
                    return lhs;
                };

                let check_unzeroized_at = fn(line_no, ctx_label) {
                    if has_auto_zeroize { return nil; }
                    let bks = map_keys(secret_bufs);
                    let bi = 0;
                    while bi < len(bks) {
                        let bname = bks[bi];
                        if zeroized[bname] != true {
                            add_violation(fn_name, "MISSING_SECRET_ZEROIZE", "missing_zeroize", line_no,
                                "Secret buffer '" + bname + "' is not wiped with zeroize_buf() before " + ctx_label + " (and function lacks @zeroize)");
                        }
                        bi = bi + 1;
                    }
                };

                let analyze_block = nil;
                analyze_block = fn() {
                    eat("{");
                    let definitely_returned = false;
                    while peek().kind != "eof" and peek().text != "}" {
                        let sec_var = false;
                        if peek().text == "@" {
                            adv();
                            if adv().text == "secret" { sec_var = true; }
                        }
                        let tk = peek();
                        if tk.text == "let" or tk.text == "const" or tk.text == "var" {
                            adv();
                            if eat("@") {
                                if adv().text == "secret" { sec_var = true; }
                            }
                            let vname = adv().text;
                            let vtype = "";
                            if eat(":") {
                                vtype = parse_type_str();
                                if str_contains(vtype, "@secret") or str_starts_with(str_lower(vtype), "secret<") {
                                    sec_var = true;
                                }
                            }
                            let rhs = map{ tainted: false, is_buf: false };
                            if eat("=") { rhs = analyze_expr(); }
                            eat(";");
                            if sec_var or rhs.tainted {
                                tainted_vars[vname] = true;
                                if rhs.is_buf or _is_buf_type_name(vtype) or (sec_var and not _is_scalar_type_name(vtype) and _looks_like_buf_ident(vname)) {
                                    secret_bufs[vname] = true;
                                    zeroized[vname] = false;
                                }
                            }
                        } elif tk.text == "if" {
                            let if_ln = adv().line;
                            let cond = analyze_expr();
                            if is_ct and cond.tainted {
                                add_violation(fn_name, "CT_SECRET_BRANCH", "secret_control_flow", if_ln,
                                    "Secret-dependent 'if (" + cond.text + ")' branch leaks execution timing & branch-predictor state");
                            }
                            let pre_z = _clone_bool_map(zeroized);
                            let then_ret = analyze_block();
                            let then_z = _clone_bool_map(zeroized);
                            let all_elif_ret = true;
                            while peek().text == "elif" {
                                let el_ln = adv().line;
                                let ec = analyze_expr();
                                if is_ct and ec.tainted {
                                    add_violation(fn_name, "CT_SECRET_BRANCH", "secret_control_flow", el_ln,
                                        "Secret-dependent 'elif (" + ec.text + ")' branch leaks execution timing");
                                }
                                zeroized = _clone_bool_map(pre_z);
                                let er = analyze_block();
                                if not er { all_elif_ret = false; }
                                let ks = map_keys(then_z);
                                let ki = 0;
                                while ki < len(ks) {
                                    let kk = ks[ki];
                                    then_z[kk] = (then_z[kk] == true) and (zeroized[kk] == true);
                                    ki = ki + 1;
                                }
                            }
                            if eat("else") {
                                zeroized = _clone_bool_map(pre_z);
                                let else_ret = analyze_block();
                                let ks2 = map_keys(then_z);
                                let k2 = 0;
                                while k2 < len(ks2) {
                                    let kk2 = ks2[k2];
                                    zeroized[kk2] = (then_z[kk2] == true) and (zeroized[kk2] == true);
                                    k2 = k2 + 1;
                                }
                                if then_ret and all_elif_ret and else_ret { definitely_returned = true; }
                            } else {
                                zeroized = pre_z;
                            }
                        } elif tk.text == "while" {
                            let w_ln = adv().line;
                            let wcond = analyze_expr();
                            if is_ct and wcond.tainted {
                                add_violation(fn_name, "CT_SECRET_LOOP_BOUND", "secret_control_flow", w_ln,
                                    "Secret-dependent 'while (" + wcond.text + ")' iteration count leaks timing side-channel");
                            }
                            analyze_block();
                        } elif tk.text == "for" {
                            let f_ln = adv().line;
                            let iter_var = adv().text;
                            eat("in");
                            let iter_e = analyze_expr();
                            if is_ct and iter_e.tainted {
                                add_violation(fn_name, "CT_SECRET_LOOP_BOUND", "secret_control_flow", f_ln,
                                    "Secret-dependent 'for' range '" + iter_e.text + "' leaks iteration count");
                            }
                            if iter_e.tainted { tainted_vars[iter_var] = true; }
                            analyze_block();
                        } elif tk.text == "return" {
                            let r_ln = adv().line;
                            if peek().text != ";" and peek().text != "}" {
                                analyze_expr();
                            }
                            eat(";");
                            check_unzeroized_at(r_ln, "return");
                            definitely_returned = true;
                        } elif tk.text == "{" {
                            analyze_block();
                        } else {
                            let lhs_id = if peek().kind == "id" { peek().text } else { "" };
                            let e_lhs = analyze_expr();
                            if eat("=") {
                                let rhs_v = analyze_expr();
                                if lhs_id != "" and rhs_v.tainted {
                                    tainted_vars[lhs_id] = true;
                                    if map_has(secret_bufs, lhs_id) { zeroized[lhs_id] = false; }
                                }
                            }
                            eat(";");
                        }
                    }
                    let end_ln = peek().line;
                    eat("}");
                    return definitely_returned;
                };

                let all_paths_ret = analyze_block();
                if not all_paths_ret and len(map_keys(secret_bufs)) > 0 {
                    check_unzeroized_at(fn_line, "function scope exit");
                }
                array_push(audited_fns, map{
                    name: fn_name,
                    constant_time: is_ct,
                    auto_zeroize: has_auto_zeroize,
                    tainted_identifiers: map_keys(tainted_vars),
                    secret_buffers: map_keys(secret_bufs)
                });
            }
        } else {
            adv();
        }
    }

    return map{
        ok: len(violations) == 0,
        version: VERIFIER_VERSION,
        audited_function_count: len(audited_fns),
        audited_functions: audited_fns,
        violation_count: len(violations),
        violations: violations
    };
}

// Rewrites @zeroize functions by deterministically injecting zeroize_buf(...) before
// every `return` and at function scope exit, producing clean executable PBLang code.
fn inject_auto_zeroize_Instrumentation(source_code) {
    let audit = audit_constant_time_and_zeroize(source_code);
    let lines = str_split(str(source_code), "\n");
    let fn_buf_map = map{};
    let fi = 0;
    while fi < len(audit.audited_functions) {
        let f = audit.audited_functions[fi];
        if f.auto_zeroize and len(f.secret_buffers) > 0 {
            fn_buf_map[f.name] = f.secret_buffers;
        }
        fi = fi + 1;
    }

    let out_lines = [];
    let active_bufs = [];
    let brace_depth = 0;
    let in_instrumented_fn = false;
    let ret_seq = 0;

    let make_wipe_stmt = fn(bufs) {
        let wipes = [];
        let k = 0;
        while k < len(bufs) {
            array_push(wipes, "zeroize_buf(" + bufs[k] + ");");
            k = k + 1;
        }
        return str_join(wipes, " ");
    };

    let li = 0;
    while li < len(lines) {
        let raw_ln = lines[li];
        let clean_ln = str_replace_all(raw_ln, "@constant_time", "");
        clean_ln = str_replace_all(clean_ln, "@zeroize", "");
        clean_ln = str_replace_all(clean_ln, "@secret ", "");
        clean_ln = str_replace_all(clean_ln, "@secret", "");
        let trimmed = str_trim(clean_ln);

        if not in_instrumented_fn and (str_starts_with(trimmed, "fn ") or str_starts_with(trimmed, "export fn ") or str_starts_with(trimmed, "pub fn ")) {
            let fn_pos = str_index_of(trimmed, "fn ");
            let p_open = str_index_of(trimmed, "(");
            if fn_pos >= 0 and p_open > fn_pos + 3 {
                let fname = str_trim(str_slice(trimmed, fn_pos + 3, p_open));
                if map_has(fn_buf_map, fname) {
                    active_bufs = fn_buf_map[fname];
                    in_instrumented_fn = true;
                    brace_depth = 0;
                }
            }
        }

        if in_instrumented_fn {
            let open_cnt = len(str_split(clean_ln, "{")) - 1;
            let close_cnt = len(str_split(clean_ln, "}")) - 1;
            if str_starts_with(trimmed, "return ") or trimmed == "return;" {
                let wipe_code = make_wipe_stmt(active_bufs);
                if trimmed == "return;" {
                    array_push(out_lines, "    " + wipe_code + " return;");
                } else {
                    let expr_part = str_trim(str_slice(trimmed, 7, len(trimmed)));
                    if str_ends_with(expr_part, ";") {
                        expr_part = str_slice(expr_part, 0, len(expr_part) - 1);
                    }
                    ret_seq = ret_seq + 1;
                    let tmp_v = "__pb_zret_" + str(ret_seq);
                    array_push(out_lines, "    let " + tmp_v + " = " + expr_part + "; " + wipe_code + " return " + tmp_v + ";");
                }
            } elif brace_depth + open_cnt - close_cnt == 0 and close_cnt > 0 {
                array_push(out_lines, "    " + make_wipe_stmt(active_bufs));
                array_push(out_lines, clean_ln);
                in_instrumented_fn = false;
                active_bufs = [];
            } else {
                if trimmed != "" { array_push(out_lines, clean_ln); }
            }
            brace_depth = brace_depth + open_cnt - close_cnt;
        } else {
            if trimmed != "" or str_trim(raw_ln) == "" {
                array_push(out_lines, clean_ln);
            }
        }
        li = li + 1;
    }
    return str_join(out_lines, "\n");
}

fn inject_auto_zeroize_instrumentation(source_code) {
    return inject_auto_zeroize_Instrumentation(source_code);
}

// ── 3. Binary "PBIDXv01" Stdlib Module & Symbol Indexer (< 1 ms Lookup) ──────

fn _u32_le(v) {
    return bit_and(num_floor(v), _MASK32);
}

fn _push_u16_le(buf, val) {
    let v = bit_and(num_floor(val), 65535);
    array_push(buf, bit_and(v, 255));
    array_push(buf, bit_and(bit_shr(v, 8), 255));
}

fn _push_u32_le(buf, val) {
    let v = _u32_le(val);
    array_push(buf, bit_and(v, 255));
    array_push(buf, bit_and(bit_shr(v, 8), 255));
    array_push(buf, bit_and(bit_shr(v, 16), 255));
    array_push(buf, bit_and(bit_shr(v, 24), 255));
}

fn _read_u16_le(buf, off) {
    return bit_or(bit_and(buf[off], 255), bit_shl(bit_and(buf[off + 1], 255), 8));
}

fn _read_u32_le(buf, off) {
    return _u32_le(bit_or(
        bit_or(bit_and(buf[off], 255), bit_shl(bit_and(buf[off + 1], 255), 8)),
        bit_or(bit_shl(bit_and(buf[off + 2], 255), 16), bit_shl(bit_and(buf[off + 3], 255), 24))
    ));
}

// 32-bit FNV-1a hash (16-bit split multiply to avoid float53 overflow)
fn _fnv1a_str32(s) {
    let h = _FNV_OFFSET_32;
    let n = len(s);
    let i = 0;
    while i < n {
        h = bit_xor(h, bit_and(strcharcodeat(s, i), 255));
        let h_lo = bit_and(h, 65535);
        let h_hi = bit_and(bit_shr(h, 16), 65535);
        // 16777619 = (256 << 16) + 403
        let prod_lo = h_lo * 403;
        let prod_mid = bit_and(h_hi * 403 + h_lo * 256, 65535);
        h = _u32_le(prod_lo + bit_shl(prod_mid, 16));
        i = i + 1;
    }
    return h;
}

// SipHash-inspired 32-bit keyed verification tag for near-zero false bucket hits
fn _sip_tag32(s) {
    let v0 = 19349663;
    let v1 = 83492791;
    let i = 0;
    while i < len(s) {
        let c = strcharcodeat(s, i);
        v0 = _u32_le(bit_xor(v0 + c * 2654435761, bit_shr(v1, 13)));
        v1 = _u32_le(bit_xor(v1 + v0, bit_shl(bit_and(v0, 32767), 17)));
        i = i + 1;
    }
    return _u32_le(bit_xor(v0, v1));
}

// 10-bit (0..1023) prefix bucket from first 2 lowercase ASCII characters
fn _prefix2_bucket(s) {
    if len(s) == 0 { return 0; }
    let ls = str_lower(str_slice(s, 0, num_min(2, len(s))));
    let c0 = bit_and(strcharcodeat(ls, 0), 31);
    let c1 = if len(ls) > 1 { bit_and(strcharcodeat(ls, 1), 31) } else { 0 };
    return bit_and(bit_or(bit_shl(c0, 5), c1), 1023);
}

fn classify_stdlib_module(rel_path, source_text = "") {
    let p = str_lower(str(rel_path));
    if str_starts_with(p, "compiler/") or str_starts_with(p, "security/") or str_starts_with(p, "crypto/") or
       str_starts_with(p, "ai/") or str_starts_with(p, "quantum/") or str_starts_with(p, "math/") or
       str_starts_with(p, "native/") or str_starts_with(p, "kernel/") or str_starts_with(p, "net/") or
       str_starts_with(p, "db/") or str_starts_with(p, "ui/") or str_starts_with(p, "sys/") or
       str_starts_with(p, "devtools/") or str_starts_with(p, "desktop_media/") {
        if str_contains(p, "wave") {
            return map{ tier: "domain_wave_module", backward_compatible: true };
        }
        return map{ tier: "flagship_production", backward_compatible: true };
    }
    if str_contains(p, "wave") or str_contains(p, "backlog_") or str_contains(p, "handoff_") or
       str_contains(p, "closure_") or str_contains(p, "profession_app") or str_contains(p, "aap_") or
       str_contains(p, "app_domains") or str_contains(p, "_files.sapp") or str_contains(p, "_view.sapp") or
       str_contains(p, "_sheet.sapp") or str_contains(p, "lesson_") or str_contains(p, "study_") or
       str_contains(p, "subtitle_") or str_contains(p, "allocation_") or str_contains(p, "smoothing_") or
       str_contains(p, "interpolation_") or str_contains(p, "palette_") or str_contains(p, "timeline_") or
       str_contains(p, "table_") or str_contains(p, "astronomy") or str_contains(p, "bioinformatics") or
       str_contains(p, "barcode") or str_contains(p, "nmea") or str_contains(p, "circuits_") or
       str_contains(str(source_text), "wave") {
        return map{ tier: "domain_wave_module", backward_compatible: true };
    }
    return map{ tier: "flagship_production", backward_compatible: true };
}

fn _collect_sapp_files(root_dir, rel_prefix, acc) {
    let dir_full = if rel_prefix == "" { root_dir } else { root_dir + "/" + rel_prefix };
    let entries = try fs_listdir(dir_full) catch nil;
    if not is_array(entries) { return nil; }
    let sorted = array_sort(entries);
    let i = 0;
    while i < len(sorted) {
        let name = sorted[i];
        if not str_starts_with(name, ".") {
            let rel = if rel_prefix == "" { name } else { rel_prefix + "/" + name };
            let child_full = root_dir + "/" + rel;
            if str_ends_with(name, ".sapp") {
                array_push(acc, rel);
            } else {
                let sub_check = try fs_listdir(child_full) catch nil;
                if is_array(sub_check) {
                    _collect_sapp_files(root_dir, rel, acc);
                }
            }
        }
        i = i + 1;
    }
}

fn _extract_module_symbols(src) {
    let lines = str_split(src, "\n");
    let decls = map{};
    let decl_order = [];
    let exp_names = [];

    let i = 0;
    while i < len(lines) {
        let ln = str_trim(lines[i]);
        if ln != "" and not str_starts_with(ln, "//") {
            let had_exp = false;
            let work = ln;
            if str_starts_with(work, "export fn ") or str_starts_with(work, "export class ") or str_starts_with(work, "export struct ") {
                had_exp = true;
                work = str_trim(str_slice(work, 7, len(work)));
            } elif str_starts_with(work, "export ") {
                let rest = str_trim(str_slice(work, 7, len(work)));
                while not str_contains(rest, ";") and i + 1 < len(lines) {
                    i = i + 1;
                    let nxt = str_trim(lines[i]);
                    if str_starts_with(nxt, "//") { break; }
                    rest = rest + " " + nxt;
                }
                if str_ends_with(rest, ";") { rest = str_slice(rest, 0, len(rest) - 1); }
                let parts = str_split(rest, ",");
                let pj = 0;
                while pj < len(parts) {
                    let sym_s = str_trim(parts[pj]);
                    if sym_s != "" {
                        if str_starts_with(sym_s, "export ") { sym_s = str_trim(str_slice(sym_s, 7, len(sym_s))); }
                        let semi_p = str_index_of(sym_s, ";");
                        if semi_p > 0 { sym_s = str_trim(str_slice(sym_s, 0, semi_p)); }
                        if sym_s != "" { array_push(exp_names, sym_s); }
                    }
                    pj = pj + 1;
                }
                work = "";
            }

            if str_starts_with(work, "pub fn ") { work = str_slice(work, 4, len(work)); }
            if str_starts_with(work, "async fn ") { work = str_slice(work, 6, len(work)); }

            if str_starts_with(work, "fn ") {
                let p_idx = str_index_of(work, "(");
                if p_idx > 3 {
                    let fname = str_trim(str_slice(work, 3, p_idx));
                    let close_p = str_index_of(work, ")");
                    let sig = if close_p > p_idx { str_slice(work, 0, close_p + 1) } else { "fn " + fname + "(...)" };
                    if not map_has(decls, fname) {
                        decls[fname] = map{ name: fname, kind: "fn", sig: sig };
                        array_push(decl_order, fname);
                    }
                    if had_exp { array_push(exp_names, fname); }
                }
            } elif str_starts_with(work, "class ") or str_starts_with(work, "struct ") {
                let kw_len = if str_starts_with(work, "class ") { 6 } else { 7 };
                let knd = if kw_len == 6 { "class" } else { "struct" };
                let b_idx = str_index_of(work, "{");
                let cname = str_trim(if b_idx > kw_len { str_slice(work, kw_len, b_idx) } else { str_slice(work, kw_len, len(work)) });
                if cname != "" and not map_has(decls, cname) {
                    decls[cname] = map{ name: cname, kind: knd, sig: knd + " " + cname };
                    array_push(decl_order, cname);
                }
                if had_exp and cname != "" { array_push(exp_names, cname); }
            } elif str_starts_with(work, "let ") or str_starts_with(work, "const ") {
                let eq_i = str_index_of(work, "=");
                let off_k = if str_starts_with(work, "let ") { 4 } else { 6 };
                if eq_i > off_k {
                    let vnm = str_trim(str_slice(work, off_k, eq_i));
                    if vnm != "" and not str_starts_with(vnm, "_") and not map_has(decls, vnm) {
                        decls[vnm] = map{ name: vnm, kind: "const", sig: "const " + vnm };
                    }
                }
            }
        }
        i = i + 1;
    }

    let out_syms = [];
    let seen = map{};
    if len(exp_names) > 0 {
        let ei = 0;
        while ei < len(exp_names) {
            let en = exp_names[ei];
            if not map_has(seen, en) {
                seen[en] = true;
                if map_has(decls, en) {
                    array_push(out_syms, decls[en]);
                } else {
                    array_push(out_syms, map{ name: en, kind: "fn", sig: "export " + en });
                }
            }
            ei = ei + 1;
        }
    } else {
        let di = 0;
        while di < len(decl_order) {
            let dn = decl_order[di];
            if not str_starts_with(dn, "_") and not map_has(seen, dn) {
                seen[dn] = true;
                array_push(out_syms, decls[dn]);
            }
            di = di + 1;
        }
    }
    return out_syms;
}

fn build_stdlib_pbidx(stdlib_dir) {
    let rel_files = [];
    _collect_sapp_files(str(stdlib_dir), "", rel_files);

    let bucket_count = 4096;
    let prefix_count = 1024;
    let hash_heads = [];
    let bi = 0;
    while bi < bucket_count { array_push(hash_heads, 0); bi = bi + 1; }
    let pref_heads = [];
    let pi = 0;
    while pi < prefix_count { array_push(pref_heads, 0); pi = pi + 1; }

    let str_pool_parts = [];
    let intern_map = map{};
    let add_str = fn(raw_s) {
        if map_has(intern_map, raw_s) { return intern_map[raw_s]; }
        let bs = str_to_bytes(raw_s);
        let clean_bs = [];
        let ci = 0;
        while ci < len(bs) {
            let b = bit_and(bs[ci], 255);
            let safe_b = if b == 10 or b == 13 { 32 } elif b < 128 { b } else { 63 };
            array_push(clean_bs, safe_b);
            ci = ci + 1;
        }
        let s = bytes_to_str(clean_bs);
        let sid = len(str_pool_parts);
        let rec = map{ off: sid, len: num_min(len(clean_bs), 65535) };
        array_push(str_pool_parts, s);
        intern_map[raw_s] = rec;
        return rec;
    };

    let modules = [];
    let symbols = [];
    let flagship_cnt = 0;
    let wave_cnt = 0;

    let mi = 0;
    while mi < len(rel_files) {
        let rel = rel_files[mi];
        let src = try fs_read(str(stdlib_dir) + "/" + rel) catch "";
        if src == nil { src = ""; }
        let cls = classify_stdlib_module(rel, str_slice(src, 0, num_min(320, len(src))));
        let tier_code = if cls.tier == "flagship_production" { 1 } else { 2 };
        if tier_code == 1 { flagship_cnt = flagship_cnt + 1; } else { wave_cnt = wave_cnt + 1; }

        let syms = _extract_module_symbols(src);
        let p_rec = add_str(rel);
        array_push(modules, map{
            path: rel,
            path_off: p_rec.off,
            path_len: p_rec.len,
            tier_code: tier_code,
            tier: cls.tier,
            export_count: len(syms)
        });

        let si = 0;
        while si < len(syms) {
            let sym = syms[si];
            let sym_idx = len(symbols);
            let h = _fnv1a_str32(sym.name);
            let b_slot = bit_and(h, bucket_count - 1);
            let p_slot = _prefix2_bucket(sym.name);
            let n_rec = add_str(sym.name);
            let s_rec = add_str(sym.sig);
            let k_code = if sym.kind == "fn" { 1 } elif sym.kind == "class" { 2 } elif sym.kind == "struct" { 3 } else { 4 };
            array_push(symbols, map{
                name_off: n_rec.off,
                name_len: n_rec.len,
                kind_code: k_code,
                tier_code: tier_code,
                sig_off: s_rec.off,
                sig_len: s_rec.len,
                mod_id: mi,
                sip_tag: _sip_tag32(sym.name),
                next_hash_plus1: hash_heads[b_slot],
                next_pref_plus1: pref_heads[p_slot]
            });
            hash_heads[b_slot] = sym_idx + 1;
            pref_heads[p_slot] = sym_idx + 1;
            si = si + 1;
        }
        mi = mi + 1;
    }

    // Binary Layout ("PBIDXv01"):
    // [0..48) Header (48 bytes):
    //   0..8   : "PBIDXv01"
    //   8..12  : version (1)
    //   12..16 : module_count
    //   16..20 : symbol_count
    //   20..24 : bucket_count (4096)
    //   24..28 : prefix_count (1024)
    //   28..32 : buckets_offset
    //   32..36 : prefixes_offset
    //   36..40 : modules_offset
    //   40..44 : symbols_offset
    //   44..48 : strings_offset
    let hdr_size = 48;
    let buckets_off = hdr_size;
    let prefixes_off = buckets_off + bucket_count * 4;
    let modules_off = prefixes_off + prefix_count * 4;
    let symbols_off = modules_off + len(modules) * 12;
    let strings_off = symbols_off + len(symbols) * 28;

    let raw = [];
    let mg = str_to_bytes(PBIDX_MAGIC);
    let mgi = 0;
    while mgi < 8 { array_push(raw, mg[mgi]); mgi = mgi + 1; }
    _push_u32_le(raw, 1);
    _push_u32_le(raw, len(modules));
    _push_u32_le(raw, len(symbols));
    _push_u32_le(raw, bucket_count);
    _push_u32_le(raw, prefix_count);
    _push_u32_le(raw, buckets_off);
    _push_u32_le(raw, prefixes_off);
    _push_u32_le(raw, modules_off);
    _push_u32_le(raw, symbols_off);
    _push_u32_le(raw, strings_off);

    let hi = 0;
    while hi < bucket_count { _push_u32_le(raw, hash_heads[hi]); hi = hi + 1; }
    let pri = 0;
    while pri < prefix_count { _push_u32_le(raw, pref_heads[pri]); pri = pri + 1; }

    let m_it = 0;
    while m_it < len(modules) {
        let md = modules[m_it];
        _push_u32_le(raw, md.path_off);
        _push_u16_le(raw, md.path_len);
        array_push(raw, md.tier_code);
        array_push(raw, 1); // 100% backward import compatibility flag
        _push_u32_le(raw, md.export_count);
        m_it = m_it + 1;
    }

    let s_it = 0;
    while s_it < len(symbols) {
        let sy = symbols[s_it];
        _push_u32_le(raw, sy.name_off);
        _push_u16_le(raw, sy.name_len);
        array_push(raw, sy.kind_code);
        array_push(raw, sy.tier_code);
        _push_u32_le(raw, sy.sig_off);
        _push_u16_le(raw, sy.sig_len);
        _push_u16_le(raw, sy.mod_id);
        _push_u32_le(raw, sy.sip_tag);
        _push_u32_le(raw, sy.next_hash_plus1);
        _push_u32_le(raw, sy.next_pref_plus1);
        s_it = s_it + 1;
    }

    let pool_str = str_join(str_pool_parts, "\n");
    let pool_bytes = str_to_bytes(pool_str);
    let pbi = 0;
    while pbi < len(pool_bytes) {
        array_push(raw, bit_and(pool_bytes[pbi], 255));
        pbi = pbi + 1;
    }

    // 4-byte FNV-1a trailer over header metadata
    let hdr_chk = _fnv1a_str32(PBIDX_MAGIC + ":" + str(len(modules)) + ":" + str(len(symbols)));
    _push_u32_le(raw, hdr_chk);

    let loaded = load_stdlib_pbidx_bytes(raw);
    return map{
        ok: true,
        magic: PBIDX_MAGIC,
        module_count: len(modules),
        flagship_production_count: flagship_cnt,
        domain_wave_module_count: wave_cnt,
        symbol_count: len(symbols),
        byte_size: len(raw),
        raw_bytes: raw,
        index: loaded
    };
}

fn load_stdlib_pbidx_bytes(raw_bytes) {
    if not is_array(raw_bytes) or len(raw_bytes) < 52 {
        throw "pbidx: invalid or truncated PBIDXv01 binary buffer";
    }
    let mg_slice = slice(raw_bytes, 0, 8);
    let mg_str = bytes_to_str(mg_slice);
    if mg_str != PBIDX_MAGIC {
        throw "pbidx: magic mismatch, expected PBIDXv01 but got '" + mg_str + "'";
    }
    let ver = _read_u32_le(raw_bytes, 8);
    let mod_cnt = _read_u32_le(raw_bytes, 12);
    let sym_cnt = _read_u32_le(raw_bytes, 16);
    let bkt_cnt = _read_u32_le(raw_bytes, 20);
    let prf_cnt = _read_u32_le(raw_bytes, 24);
    let bkt_off = _read_u32_le(raw_bytes, 28);
    let prf_off = _read_u32_le(raw_bytes, 32);
    let mod_off = _read_u32_le(raw_bytes, 36);
    let sym_off = _read_u32_le(raw_bytes, 40);
    let str_off = _read_u32_le(raw_bytes, 44);
    let trl_chk = _read_u32_le(raw_bytes, len(raw_bytes) - 4);
    let exp_chk = _fnv1a_str32(PBIDX_MAGIC + ":" + str(mod_cnt) + ":" + str(sym_cnt));
    if trl_chk != exp_chk {
        throw "pbidx: binary trailer FNV-1a integrity mismatch";
    }

    let pool_s = bytes_to_str(slice(raw_bytes, str_off, len(raw_bytes) - 4));
    let strings_arr = str_split(pool_s, "\n");
    return map{
        magic: mg_str,
        version: ver,
        module_count: mod_cnt,
        symbol_count: sym_cnt,
        bucket_count: bkt_cnt,
        prefix_count: prf_cnt,
        buckets_off: bkt_off,
        prefixes_off: prf_off,
        modules_off: mod_off,
        symbols_off: sym_off,
        strings_off: str_off,
        strings_arr: strings_arr,
        raw_bytes: raw_bytes
    };
}

fn _decode_pbidx_symbol(idx, sym_id) {
    let raw = idx.raw_bytes;
    let s_arr = idx.strings_arr;
    let base = idx.symbols_off + sym_id * 28;
    let n_id = _read_u32_le(raw, base);
    let k_code = raw[base + 6];
    let t_code = raw[base + 7];
    let s_id = _read_u32_le(raw, base + 8);
    let mod_id = _read_u16_le(raw, base + 14);

    let m_base = idx.modules_off + mod_id * 12;
    let p_id = _read_u32_le(raw, m_base);
    let compat = raw[m_base + 7] == 1;

    let sym_name = s_arr[n_id];
    let sig_str = s_arr[s_id];
    let mod_path = s_arr[p_id];
    let kind_s = if k_code == 1 { "fn" } elif k_code == 2 { "class" } elif k_code == 3 { "struct" } else { "const" };
    let tier_s = if t_code == 1 { "flagship_production" } else { "domain_wave_module" };

    return map{
        symbol: sym_name,
        kind: kind_s,
        signature: sig_str,
        module_path: mod_path,
        import_spec: "stdlib:" + mod_path,
        tier: tier_s,
        backward_compatible: compat
    };
}

// Sub-millisecond (< 1 ms) binary FNV-1a + SipHash + Prefix2 lookup over all 835+ modules.
fn query_stdlib_symbol(idx_or_bundle, query_str) {
    let t0 = now_ms();
    let idx = if map_has(idx_or_bundle, "index") { idx_or_bundle.index } else { idx_or_bundle };
    let q = str_trim(str(query_str));
    if q == "" {
        return map{ query: q, count: 0, matches: [], elapsed_ms: now_ms() - t0 };
    }

    let raw = idx.raw_bytes;
    let s_arr = idx.strings_arr;
    let hits = [];
    let seen_sym = map{};

    // Phase 1: O(1) FNV-1a hash bucket + 32-bit SipHash tag exact lookup
    let h = _fnv1a_str32(q);
    let q_tag = _sip_tag32(q);
    let b_slot = bit_and(h, idx.bucket_count - 1);
    let cur_plus1 = _read_u32_le(raw, idx.buckets_off + b_slot * 4);
    while cur_plus1 > 0 and len(hits) < 24 {
        let sid = cur_plus1 - 1;
        let s_base = idx.symbols_off + sid * 28;
        let tag = _read_u32_le(raw, s_base + 16);
        let nxt = _read_u32_le(raw, s_base + 20);
        if tag == q_tag {
            let rec = _decode_pbidx_symbol(idx, sid);
            if rec.symbol == q {
                seen_sym[str(sid)] = true;
                array_push(hits, rec);
            }
        }
        cur_plus1 = nxt;
    }

    // Phase 2: O(1) 2-character prefix bucket completion scan when exact match didn't already saturate
    if len(q) >= 2 and len(hits) < 8 {
        let q_low = str_lower(q);
        let p_slot = _prefix2_bucket(q_low);
        let p_cur = _read_u32_le(raw, idx.prefixes_off + p_slot * 4);
        let scanned = 0;
        let scan_cap = if len(hits) > 0 { 24 } else { 64 };
        while p_cur > 0 and len(hits) < 12 and scanned < scan_cap {
            let sid = p_cur - 1;
            let s_base = idx.symbols_off + sid * 28;
            let p_nxt = _read_u32_le(raw, s_base + 24);
            if not map_has(seen_sym, str(sid)) {
                let n_id = _read_u32_le(raw, s_base);
                let n_len = _read_u16_le(raw, s_base + 4);
                if n_len >= len(q) {
                    let cand = s_arr[n_id];
                    if str_starts_with(str_lower(cand), q_low) {
                        seen_sym[str(sid)] = true;
                        array_push(hits, _decode_pbidx_symbol(idx, sid));
                    }
                }
            }
            scanned = scanned + 1;
            p_cur = p_nxt;
        }
    }

    let dt = now_ms() - t0;
    return map{
        query: q,
        count: len(hits),
        matches: hits,
        elapsed_ms: dt
    };
}

export VERIFIER_VERSION, PBIDX_MAGIC;
