export audit_constant_time_and_zeroize, inject_auto_zeroize_Instrumentation, inject_auto_zeroize_instrumentation;
export classify_stdlib_module, build_stdlib_pbidx, load_stdlib_pbidx_bytes, query_stdlib_symbol;
