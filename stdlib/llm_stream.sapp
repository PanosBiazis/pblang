// stdlib/llm_stream.sapp -- bounded streaming corpus readers for large local data.

let data = import("stdlib:llm_data.sapp");

fn from_records(records, chunk_chars, stride) {
    return map{
        format: "pblang.llm.stream.v1",
        records: records,
        record_idx: 0,
        offset: 0,
        chunk_chars: chunk_chars,
        stride: stride,
        emitted: 0,
        skipped: 0
    };
}

fn from_paths(paths, max_chars_per_file, chunk_chars, stride) {
    let records = [];
    let skipped = 0;
    let i = 0;
    while i < len(paths) {
        if data.secret_name(paths[i]) or not data.text_like(paths[i]) {
            skipped = skipped + 1;
        } else {
            let text = data.read_text_file(paths[i], max_chars_per_file);
            if text != "" { push(records, data.corpus_record(paths[i], text, "text")); }
            else { skipped = skipped + 1; }
        }
        i = i + 1;
    }
    let st = from_records(records, chunk_chars, stride);
    st.skipped = skipped;
    return st;
}

fn next_chunk(st) {
    while st.record_idx < len(st.records) {
        let r = st.records[st.record_idx];
        if st.offset >= len(r.text) {
            st.record_idx = st.record_idx + 1;
            st.offset = 0;
        } else {
            let end = st.offset + st.chunk_chars;
            if end > len(r.text) { end = len(r.text); }
            let text = str_slice(r.text, st.offset, end);
            let start = st.offset;
            st.offset = st.offset + st.stride;
            st.emitted = st.emitted + 1;
            return map{ done: false, path: r.path, offset: start, text: text, state: st };
        }
    }
    return map{ done: true, state: st };
}

fn next_token_batch(st, tokenizer, encode_fn, batch_size, context) {
    let out = [];
    while len(out) < batch_size {
        let ch = next_chunk(st);
        if ch.done { return map{ done: true, examples: out, state: st }; }
        let ids = encode_fn(tokenizer, ch.text, false, false);
        let ex = data.lm_examples(ids, context);
        let i = 0;
        while i < len(ex) and len(out) < batch_size {
            push(out, ex[i]);
            i = i + 1;
        }
    }
    return map{ done: false, examples: out, state: st };
}

fn stats(st) {
    return map{
        format: st.format,
        records: len(st.records),
        record_idx: st.record_idx,
        emitted: st.emitted,
        skipped: st.skipped
    };
}

export from_records, from_paths, next_chunk, next_token_batch, stats;
