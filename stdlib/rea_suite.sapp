// stdlib/rea_suite.sapp -- Pure offline Reverse Engineering & Architecture (REA) suite.
// Provides bounded static binary/compiler/mitigation/crypto/EVM/WASM/PE/ELF/Mach-O inspection,
// JavaScript/Electron/Multi-language application graph & clean-room spec reconstruction,
// HTTP/REST & binary wire protocol reconstruction, and facet-aware Evidence & Readiness ledgers.
// Zero target execution, zero shell invocation, zero network access, and explicit prompt-injection guard.

let SHA256 = import("stdlib:sha256_pb.sapp");

let FORMAT_BINARY = "pblang.rea.binary-audit.v1";
let FORMAT_APP_GRAPH = "pblang.rea.application-graph.v1";
let FORMAT_PROTOCOL = "pblang.rea.protocol-reconstruct.v1";
let FORMAT_LEDGER = "pblang.rea.evidence-ledger.v1";
let HEX_DIGITS = "0123456789abcdef";

fn _has(items, target) {
    for item in items {
        if item == target { return true; }
    }
    return false;
}

fn _is_true(value) {
    if value { return true; }
    return false;
}

fn _keys(value, allowed, ctx) {
    if type(value) != "map" { throw ctx + ": expected map"; }
    let matched = 0;
    for field in allowed {
        if map_has(value, field) { matched = matched + 1; }
    }
    if matched != len(value) { throw ctx + ": unsupported property"; }
}

fn _hex_nibble(code) {
    if code >= 48 and code <= 57 { return code - 48; }
    if code >= 65 and code <= 70 { return code - 55; }
    if code >= 97 and code <= 102 { return code - 87; }
    return -1;
}

fn _hex_byte(b) {
    let hi = num_floor(b / 16) % 16;
    let lo = b % 16;
    return str_slice(HEX_DIGITS, hi, hi + 1) + str_slice(HEX_DIGITS, lo, lo + 1);
}

fn _bytes_from_hex(hex_str, max_bytes) {
    if type(hex_str) != "string" { throw "rea_suite: hex must be a string"; }
    let clean = str_trim(hex_str);
    if str_starts_with(clean, "0x") or str_starts_with(clean, "0X") {
        clean = str_slice(clean, 2, len(clean));
    }
    clean = str_replace_all(clean, " ", "");
    if len(clean) % 2 != 0 { throw "rea_suite: hex string must have an even length"; }
    let byte_count = num_floor(len(clean) / 2);
    if byte_count > max_bytes { throw "rea_suite: hex byte budget exceeded"; }
    let out = [];
    let i = 0;
    while i < len(clean) {
        let hi = _hex_nibble(strcharcodeat(clean, i));
        let lo = _hex_nibble(strcharcodeat(clean, i + 1));
        if hi < 0 or lo < 0 { throw "rea_suite: invalid hexadecimal digit"; }
        push(out, hi * 16 + lo);
        i = i + 2;
    }
    return out;
}

fn _validate_bytes(raw, max_bytes) {
    if type(raw) != "array" or len(raw) > max_bytes {
        throw "rea_suite: byte array budget exceeded";
    }
    let out = [];
    for b in raw {
        if type(b) != "number" or b != num_floor(b) or b < 0 or b > 255 {
            throw "rea_suite: byte values must be integers in 0..255";
        }
        push(out, b);
    }
    return out;
}

fn _u16(bytes, offset, little) {
    if offset < 0 or offset + 2 > len(bytes) { return 0; }
    if _is_true(little) { return bytes[offset] + bytes[offset + 1] * 256; }
    return bytes[offset] * 256 + bytes[offset + 1];
}

fn _u32(bytes, offset, little) {
    if offset < 0 or offset + 4 > len(bytes) { return 0; }
    if _is_true(little) {
        return bytes[offset] + bytes[offset + 1] * 256 + bytes[offset + 2] * 65536 + bytes[offset + 3] * 16777216;
    }
    return bytes[offset] * 16777216 + bytes[offset + 1] * 65536 + bytes[offset + 2] * 256 + bytes[offset + 3];
}

fn _match_seq(bytes, offset, seq) {
    if offset < 0 or offset + len(seq) > len(bytes) { return false; }
    let i = 0;
    while i < len(seq) {
        if bytes[offset + i] != seq[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn _contains_seq(bytes, seq) {
    if len(seq) == 0 or len(bytes) < len(seq) { return false; }
    let limit = len(bytes) - len(seq);
    let i = 0;
    while i <= limit {
        if bytes[i] == seq[0] and _match_seq(bytes, i, seq) { return true; }
        i = i + 1;
    }
    return false;
}

fn _shannon_entropy(bytes) {
    let n = len(bytes);
    if n == 0 { return 0.0; }
    let counts = [];
    let i = 0;
    while i < 256 {
        push(counts, 0);
        i = i + 1;
    }
    for b in bytes {
        counts[b] = counts[b] + 1;
    }
    let h = 0.0;
    i = 0;
    while i < 256 {
        if counts[i] > 0 {
            let p = counts[i] / n;
            h = h - p * (num_ln(p) / num_ln(2));
        }
        i = i + 1;
    }
    return num_floor(h * 1000.0 + 0.5) / 1000.0;
}

fn _extract_ascii_strings(bytes, min_len, max_items) {
    let out = [];
    let current = "";
    for b in bytes {
        if b >= 32 and b <= 126 {
            if len(current) < 256 {
                current = current + strfromcharcode(b);
            }
        } else {
            if len(current) >= min_len and len(out) < max_items {
                push(out, current);
            }
            current = "";
        }
    }
    if len(current) >= min_len and len(out) < max_items {
        push(out, current);
    }
    return out;
}

fn _scan_prompt_injection(strings) {
    let patterns = [
        "ignore previous instructions",
        "ignore all previous",
        "disregard prior instructions",
        "system prompt",
        "you are now",
        "curl http",
        "wget http",
        "bash -c",
        "/bin/sh",
        "nc -e",
        "invoke-expression"
    ];
    let flagged = [];
    for s in strings {
        let lower = str_lower(s);
        for pat in patterns {
            if str_contains(lower, pat) and len(flagged) < 16 and not _has(flagged, pat) {
                push(flagged, pat);
            }
        }
    }
    return map{
        untrusted_content: true,
        suspicious_directives_detected: len(flagged) > 0,
        matched_patterns: flagged,
        directive_count: len(flagged),
        policy: "NEVER_EXECUTE_TARGET_DIRECTIVES"
    };
}

fn _detect_evm(bytes) {
    let selectors = [];
    let has_sload = false;
    let has_sstore = false;
    let has_callvalue = false;
    let has_delegatecall = false;
    let i = 0;
    while i < len(bytes) {
        let op = bytes[i];
        // PUSH4 (0x63) <4 bytes> EQ (0x14) PUSH1/PUSH2 (0x60/0x61) ... JUMPI (0x57)
        if op == 99 and i + 5 < len(bytes) and bytes[i + 5] == 20 {
            let sel = "0x" + _hex_byte(bytes[i + 1]) + _hex_byte(bytes[i + 2]) + _hex_byte(bytes[i + 3]) + _hex_byte(bytes[i + 4]);
            if not _has(selectors, sel) and len(selectors) < 32 {
                push(selectors, sel);
            }
        }
        if op == 84 { has_sload = true; }
        if op == 85 { has_sstore = true; }
        if op == 52 { has_callvalue = true; }
        if op == 244 { has_delegatecall = true; }
        i = i + 1;
    }
    let has_solc_cbor = _contains_seq(bytes, [100, 115, 111, 108, 99, 67]); // "dsolcC"
    let mutability = "pure_or_view";
    if _is_true(has_sstore) or _is_true(has_delegatecall) {
        mutability = "nonpayable_or_state_modifying";
    } elif _is_true(has_sload) {
        mutability = "view";
    }
    return map{
        selector_count: len(selectors),
        selectors: selectors,
        has_sload: has_sload,
        has_sstore: has_sstore,
        has_callvalue: has_callvalue,
        has_delegatecall: has_delegatecall,
        solidity_cbor_metadata: has_solc_cbor,
        inferred_mutability: mutability
    };
}

// 1. Binary, Compiler Provenance, Mitigations, Crypto/Packer & Multi-Format Audit
fn inspect_binary_artifact(spec) {
    _keys(spec, ["name", "bytes", "hex", "strings", "symbols", "sections", "imports"], "inspect_binary_artifact");
    let name = "artifact.bin";
    if map_has(spec, "name") {
        if type(spec.name) != "string" or len(spec.name) < 1 or len(spec.name) > 128 {
            throw "inspect_binary_artifact: invalid name";
        }
        name = spec.name;
    }
    let bytes = [];
    if map_has(spec, "bytes") and map_has(spec, "hex") {
        throw "inspect_binary_artifact: provide either bytes or hex, not both";
    }
    if map_has(spec, "bytes") {
        bytes = _validate_bytes(spec.bytes, 16384);
    } elif map_has(spec, "hex") {
        bytes = _bytes_from_hex(spec.hex, 16384);
    } else {
        throw "inspect_binary_artifact: bytes or hex required";
    }
    if len(bytes) < 4 {
        throw "inspect_binary_artifact: requires at least 4 bytes";
    }

    let extra_strings = [];
    if map_has(spec, "strings") {
        if type(spec.strings) != "array" or len(spec.strings) > 128 { throw "inspect_binary_artifact: invalid strings"; }
        for s in spec.strings {
            if type(s) != "string" or len(s) > 256 { throw "inspect_binary_artifact: invalid string item"; }
            push(extra_strings, s);
        }
    }
    let symbols = [];
    if map_has(spec, "symbols") {
        if type(spec.symbols) != "array" or len(spec.symbols) > 128 { throw "inspect_binary_artifact: invalid symbols"; }
        for sym in spec.symbols {
            if type(sym) != "string" or len(sym) > 128 { throw "inspect_binary_artifact: invalid symbol"; }
            push(symbols, sym);
        }
    }
    let sections = [];
    if map_has(spec, "sections") {
        if type(spec.sections) != "array" or len(spec.sections) > 64 { throw "inspect_binary_artifact: invalid sections"; }
        for sec_name in spec.sections {
            if type(sec_name) != "string" or len(sec_name) > 64 { throw "inspect_binary_artifact: invalid section"; }
            push(sections, sec_name);
        }
    }
    let imports = [];
    if map_has(spec, "imports") {
        if type(spec.imports) != "array" or len(spec.imports) > 128 { throw "inspect_binary_artifact: invalid imports"; }
        for imp in spec.imports {
            if type(imp) != "string" or len(imp) > 128 { throw "inspect_binary_artifact: invalid import"; }
            push(imports, imp);
        }
    }

    let ascii_strings = _extract_ascii_strings(bytes, 4, 64);
    let all_strings = [];
    for s in ascii_strings { push(all_strings, s); }
    for s in extra_strings { if not _has(all_strings, s) { push(all_strings, s); } }
    for s in symbols { if not _has(all_strings, s) { push(all_strings, s); } }

    let format = "raw_or_unknown";
    let arch = "unknown";
    let word_bits = 0;
    let endian = "unknown";
    let is_pie_header = false;
    let is_dotnet_cil = _contains_seq(bytes, [66, 83, 74, 66]); // "BSJB"

    if _match_seq(bytes, 0, [127, 69, 76, 70]) {
        format = "elf";
        if len(bytes) >= 20 {
            word_bits = if bytes[4] == 2 { 64 } else { 32 };
            endian = if bytes[5] == 1 { "little" } else { "big" };
            let little = bytes[5] == 1;
            let elf_type = _u16(bytes, 16, little);
            let machine = _u16(bytes, 18, little);
            is_pie_header = (elf_type == 3);
            if machine == 62 { arch = "x86_64"; }
            elif machine == 3 { arch = "x86"; }
            elif machine == 183 { arch = "aarch64"; }
            elif machine == 40 { arch = "arm"; }
            elif machine == 243 { arch = "riscv"; }
            elif machine == 8 { arch = "mips"; }
            elif machine == 20 or machine == 21 { arch = "powerpc"; }
        }
    } elif _match_seq(bytes, 0, [77, 90]) {
        format = if _is_true(is_dotnet_cil) { "pe_dotnet_cil" } else { "pe" };
        endian = "little";
        word_bits = 64;
        arch = "x86_64";
        if len(bytes) >= 64 {
            let pe_off = _u32(bytes, 60, true);
            if pe_off >= 0 and pe_off + 6 <= len(bytes) and _match_seq(bytes, pe_off, [80, 69, 0, 0]) {
                let machine = _u16(bytes, pe_off + 4, true);
                if machine == 332 { arch = "x86"; word_bits = 32; }
                elif machine == 34404 { arch = "x86_64"; word_bits = 64; }
                elif machine == 43620 { arch = "aarch64"; word_bits = 64; }
            }
        }
    } elif _match_seq(bytes, 0, [207, 250, 237, 254]) or _match_seq(bytes, 0, [206, 250, 237, 254]) {
        format = "mach-o";
        endian = "little";
        word_bits = if bytes[0] == 207 { 64 } else { 32 };
        if len(bytes) >= 8 {
            let cpu = _u32(bytes, 4, true) % 16777216;
            if cpu == 7 { arch = if word_bits == 64 { "x86_64" } else { "x86" }; }
            elif cpu == 12 { arch = if word_bits == 64 { "aarch64" } else { "arm" }; }
        }
    } elif _match_seq(bytes, 0, [202, 254, 186, 190]) {
        format = "mach-o-universal";
        endian = "big";
        word_bits = 64;
    } elif _match_seq(bytes, 0, [0, 97, 115, 109]) {
        format = "wasm";
        endian = "little";
        word_bits = 32;
        arch = "wasm32";
    } elif _match_seq(bytes, 0, [100, 101, 120, 10]) {
        format = "android_dex";
        endian = "little";
        word_bits = 32;
        arch = "dalvik_dex";
    } elif _match_seq(bytes, 0, [83, 81, 76, 105]) {
        format = "sqlite3";
        endian = "big";
        word_bits = 64;
        arch = "sqlite_btree";
    }

    let evm = _detect_evm(bytes);
    if format == "raw_or_unknown" and (evm.selector_count > 0 or _is_true(evm.solidity_cbor_metadata)) {
        format = "evm_bytecode";
        arch = "evm256";
        word_bits = 256;
        endian = "big";
    }

    // Compiler & Ecosystem Provenance (Go / Rust / .NET / Flutter / C/C++)
    let is_go = _contains_seq(bytes, [255, 32, 71, 111, 32, 98, 117, 105, 108, 100, 105, 110, 102, 58]);
    let is_rust = false;
    let is_flutter = false;
    let go_version = "";
    let rust_crates = [];
    for s in all_strings {
        if str_starts_with(s, "go1.") {
            is_go = true;
            go_version = s;
        }
        if str_contains(s, "rustc ") or str_contains(s, "cargo-auditable") or str_contains(s, ".dep-v0") {
            is_rust = true;
        }
        if str_contains(s, "crate:") and len(rust_crates) < 16 {
            push(rust_crates, s);
            is_rust = true;
        }
        if str_contains(s, "libapp.so") or str_contains(s, "kDartVmSnapshotData") {
            is_flutter = true;
        }
    }
    for sec_name in sections {
        if sec_name == ".gopclntab" or sec_name == ".go.buildinfo" { is_go = true; }
        if sec_name == ".dep-v0" { is_rust = true; }
    }

    let compiler_family = "native_c_cpp_or_unknown";
    if _is_true(is_go) { compiler_family = "golang"; }
    elif _is_true(is_rust) { compiler_family = "rust"; }
    elif _is_true(is_dotnet_cil) { compiler_family = "dotnet_cil"; }
    elif _is_true(is_flutter) { compiler_family = "flutter_dart_aot"; }
    elif format == "wasm" { compiler_family = "webassembly"; }
    elif format == "evm_bytecode" { compiler_family = "solidity_or_vyper_evm"; }

    // Static Security Mitigations Audit
    let has_canary = _has(symbols, "__stack_chk_fail") or _has(symbols, "__security_check_cookie") or _has(imports, "__stack_chk_fail");
    let has_fortify = false;
    for sym in symbols {
        if str_ends_with(sym, "_chk") { has_fortify = true; }
    }
    let has_relro = _has(sections, ".gnu.relro") or _has(sections, ".got.plt") or _has(sections, ".dynamic");
    let has_nx = format == "elf" or format == "pe" or format == "pe_dotnet_cil" or format == "mach-o" or format == "wasm";
    let has_cfi = _contains_seq(bytes, [243, 15, 30, 250]); // endbr64 (f3 0f 1e fa)
    let score = 20;
    if _is_true(is_pie_header) or format == "wasm" or format == "pe_dotnet_cil" { score = score + 20; }
    if _is_true(has_canary) { score = score + 20; }
    if _is_true(has_relro) { score = score + 15; }
    if _is_true(has_nx) { score = score + 15; }
    if _is_true(has_fortify) or _is_true(has_cfi) { score = score + 10; }
    if score > 100 { score = 100; }

    // Crypto Constants & Packer Heuristics
    let has_aes_sbox = _contains_seq(bytes, [99, 124, 119, 123, 242, 107, 111, 197]);
    let has_sha256_iv = _contains_seq(bytes, [103, 230, 9, 106]) or _contains_seq(bytes, [106, 9, 230, 103]);
    let has_chacha20 = _contains_seq(bytes, [101, 120, 112, 97, 110, 100, 32, 51, 50, 45, 98, 121, 116, 101, 32, 107]);
    let has_upx = _contains_seq(bytes, [85, 80, 88, 33]) or _has(sections, "UPX0") or _has(sections, "UPX1");
    let entropy = _shannon_entropy(bytes);
    let entropy_class = "normal_structured";
    if entropy >= 7.2 { entropy_class = "high_packed_or_encrypted"; }
    elif entropy < 2.5 { entropy_class = "low_sparse_or_padding"; }

    let crypto_signals = [];
    if _is_true(has_aes_sbox) { push(crypto_signals, "AES_SBOX"); }
    if _is_true(has_sha256_iv) { push(crypto_signals, "SHA256_IV"); }
    if _is_true(has_chacha20) { push(crypto_signals, "CHACHA20_SIGMA"); }

    let packer_signals = [];
    if _is_true(has_upx) { push(packer_signals, "UPX_PACKER"); }
    if entropy >= 7.2 { push(packer_signals, "HIGH_ENTROPY_PACKED_SECTION"); }

    let sha_hex = SHA256.sha256_hex_bytes(bytes);
    let prompt_guard = _scan_prompt_injection(all_strings);

    return map{
        ok: true,
        format: FORMAT_BINARY,
        evidence_id: "ev_" + sha_hex,
        artifact_name: name,
        byte_length: len(bytes),
        sha256: sha_hex,
        binary_format: format,
        architecture: arch,
        word_bits: word_bits,
        endian: endian,
        compiler_provenance: map{
            compiler_family: compiler_family,
            is_go_binary: is_go,
            go_version: go_version,
            is_rust_binary: is_rust,
            rust_crates: rust_crates,
            is_dotnet_cil: is_dotnet_cil,
            is_flutter_aot: is_flutter
        },
        mitigations: map{
            pie_or_aslr: _is_true(is_pie_header) or format == "pe" or format == "pe_dotnet_cil",
            nx_dep_enabled: has_nx,
            relro_present: has_relro,
            stack_canary: has_canary,
            fortify_source: has_fortify,
            cet_endbr64: has_cfi,
            hardening_score: score
        },
        crypto_and_packer_signals: map{
            shannon_entropy: entropy,
            entropy_classification: entropy_class,
            crypto_constants: crypto_signals,
            packer_indicators: packer_signals
        },
        evm_inspection: evm,
        extracted_string_count: len(all_strings),
        extracted_strings: all_strings,
        prompt_injection_guard: prompt_guard,
        _meta: map{
            provenance: map{
                untrusted_content: true,
                source: "analysis_target"
            }
        },
        target_executed: false,
        shell_used: false,
        network_used: false
    };
}

// 2. JavaScript / Electron / Multi-Language Application Graph, Feature Tracer & Clean-Room Spec
fn analyze_application_surface(spec) {
    _keys(spec, ["app_name", "modules", "feature_seed", "electron_config"], "analyze_application_surface");
    let app_name = "target-app";
    if map_has(spec, "app_name") {
        if type(spec.app_name) != "string" or len(spec.app_name) < 1 or len(spec.app_name) > 128 {
            throw "analyze_application_surface: invalid app_name";
        }
        app_name = spec.app_name;
    }
    if not map_has(spec, "modules") or type(spec.modules) != "array" or len(spec.modules) < 1 or len(spec.modules) > 32 {
        throw "analyze_application_surface: modules must contain 1..32 module descriptors";
    }
    let seed = "";
    if map_has(spec, "feature_seed") {
        if type(spec.feature_seed) != "string" or len(spec.feature_seed) > 64 {
            throw "analyze_application_surface: invalid feature_seed";
        }
        seed = str_lower(str_trim(spec.feature_seed));
    }

    let module_nodes = [];
    let ipc_channels = [];
    let http_routes = [];
    let native_bridges = [];
    let storage_entities = [];
    let matched_modules = [];
    let all_sources = [];

    for mod_item in spec.modules {
        _keys(mod_item, ["path", "source", "kind"], "analyze_application_surface.module");
        let path = try mod_item.path catch "";
        let src = try mod_item.source catch "";
        let kind = try mod_item.kind catch "javascript";
        if type(path) != "string" or len(path) < 1 or len(path) > 128 {
            throw "analyze_application_surface: invalid module path";
        }
        if type(src) != "string" or len(src) > 16384 {
            throw "analyze_application_surface: invalid module source";
        }
        if type(kind) != "string" or len(kind) > 32 {
            throw "analyze_application_surface: invalid module kind";
        }
        push(all_sources, src);

        let lines = str_split(src, "\n");
        let mod_imports = [];
        let mod_exports = [];
        let mod_ipc = [];
        let mod_routes = [];

        for line in lines {
            let trimmed = str_trim(line);
            if (str_contains(trimmed, "import ") or str_contains(trimmed, "require(")) and len(mod_imports) < 32 {
                push(mod_imports, trimmed);
            }
            if (str_starts_with(trimmed, "export ") or str_contains(trimmed, "module.exports") or str_starts_with(trimmed, "fn ") or str_starts_with(trimmed, "public ")) and len(mod_exports) < 32 {
                push(mod_exports, trimmed);
            }
            if str_contains(trimmed, "ipcMain.handle(") or str_contains(trimmed, "ipcMain.on(")
               or str_contains(trimmed, "ipcRenderer.invoke(") or str_contains(trimmed, "ipcRenderer.send(")
               or str_contains(trimmed, "contextBridge.exposeInMainWorld(") {
                push(mod_ipc, trimmed);
                if not _has(ipc_channels, trimmed) and len(ipc_channels) < 64 {
                    push(ipc_channels, trimmed);
                }
            }
            if str_contains(trimmed, "/api/") or str_contains(trimmed, "/v1/")
               or str_contains(trimmed, "fetch(") or str_contains(trimmed, "app.get(")
               or str_contains(trimmed, "app.post(") {
                push(mod_routes, trimmed);
                if not _has(http_routes, trimmed) and len(http_routes) < 64 {
                    push(http_routes, trimmed);
                }
            }
            if (str_contains(trimmed, ".node") or str_contains(trimmed, "DllImport")
               or str_contains(trimmed, "ffi.") or str_contains(trimmed, "WebAssembly."))
               and not _has(native_bridges, path + ": " + trimmed) and len(native_bridges) < 32 {
                push(native_bridges, path + ": " + trimmed);
            }
            if (str_contains(trimmed, "CREATE TABLE") or str_contains(trimmed, "SELECT ")
               or str_contains(trimmed, "localStorage.") or str_contains(trimmed, "indexedDB"))
               and not _has(storage_entities, trimmed) and len(storage_entities) < 32 {
                push(storage_entities, trimmed);
            }
        }

        let matches_seed = false;
        if seed != "" and (str_contains(str_lower(path), seed) or str_contains(str_lower(src), seed)) {
            matches_seed = true;
            push(matched_modules, path);
        }

        push(module_nodes, map{
            path: path,
            kind: kind,
            line_count: len(lines),
            import_count: len(mod_imports),
            export_count: len(mod_exports),
            ipc_count: len(mod_ipc),
            route_count: len(mod_routes),
            matches_feature_seed: matches_seed,
            imports: mod_imports,
            exports: mod_exports
        });
    }

    let node_integration = false;
    let context_isolation = true;
    let sandbox_enabled = true;
    let web_security = true;
    if map_has(spec, "electron_config") {
        let ecfg = spec.electron_config;
        _keys(ecfg, ["node_integration", "context_isolation", "sandbox", "web_security"], "analyze_application_surface.electron_config");
        if map_has(ecfg, "node_integration") { node_integration = _is_true(ecfg.node_integration); }
        if map_has(ecfg, "context_isolation") { context_isolation = _is_true(ecfg.context_isolation); }
        if map_has(ecfg, "sandbox") { sandbox_enabled = _is_true(ecfg.sandbox); }
        if map_has(ecfg, "web_security") { web_security = _is_true(ecfg.web_security); }
    }
    let electron_score = 100;
    let electron_risks = [];
    if _is_true(node_integration) {
        electron_score = electron_score - 40;
        push(electron_risks, "NODE_INTEGRATION_ENABLED_IN_RENDERER");
    }
    if not _is_true(context_isolation) {
        electron_score = electron_score - 35;
        push(electron_risks, "CONTEXT_ISOLATION_DISABLED");
    }
    if not _is_true(sandbox_enabled) {
        electron_score = electron_score - 15;
        push(electron_risks, "RENDERER_SANDBOX_DISABLED");
    }
    if not _is_true(web_security) {
        electron_score = electron_score - 10;
        push(electron_risks, "WEB_SECURITY_DISABLED");
    }

    let digest = SHA256.sha256_hex(app_name + "|" + seed + "|" + str(len(module_nodes)) + "|" + str(len(ipc_channels)) + "|" + str(len(http_routes)));
    let prompt_guard = _scan_prompt_injection(all_sources);

    return map{
        ok: true,
        format: FORMAT_APP_GRAPH,
        evidence_id: "ev_" + digest,
        app_name: app_name,
        module_count: len(module_nodes),
        modules: module_nodes,
        ipc_channel_count: len(ipc_channels),
        ipc_channels: ipc_channels,
        http_route_count: len(http_routes),
        http_routes: http_routes,
        native_bridge_count: len(native_bridges),
        native_bridges: native_bridges,
        storage_entity_count: len(storage_entities),
        storage_entities: storage_entities,
        feature_trace: map{
            seed: seed,
            matched_module_count: len(matched_modules),
            matched_modules: matched_modules,
            trace_complete: true
        },
        electron_security_posture: map{
            node_integration: node_integration,
            context_isolation: context_isolation,
            sandbox: sandbox_enabled,
            web_security: web_security,
            security_score: electron_score,
            risks: electron_risks
        },
        cleanroom_blueprint: map{
            specification_mode: "COPYRIGHT_SAFE_FUNCTIONAL_RECONSTRUCTION",
            observed_entrypoints: len(ipc_channels) + len(http_routes),
            storage_contracts: len(storage_entities),
            recommended_targets: ["pblang", "csharp_dotnet10", "typescript"]
        },
        prompt_injection_guard: prompt_guard,
        _meta: map{
            provenance: map{
                untrusted_content: true,
                source: "analysis_target"
            }
        },
        target_executed: false
    };
}

fn _is_digits_only(seg) {
    if len(seg) < 1 { return false; }
    let i = 0;
    while i < len(seg) {
        let c = strcharcodeat(seg, i);
        if c < 48 or c > 57 { return false; }
        i = i + 1;
    }
    return true;
}

fn _template_path(raw_path) {
    let clean = raw_path;
    let qpos = str_index_of(clean, "?");
    if qpos >= 0 {
        clean = str_slice(clean, 0, qpos);
    }
    let parts = str_split(clean, "/");
    let out = [];
    let templated = false;
    for part in parts {
        if part == "" {
            push(out, "");
        } elif _is_digits_only(part) {
            push(out, "{id}");
            templated = true;
        } elif len(part) == 36 and str_contains(part, "-") {
            push(out, "{uuid}");
            templated = true;
        } else {
            push(out, part);
        }
    }
    let joined = str_join(out, "/");
    if joined == "" { joined = "/"; }
    return map{
        template: joined,
        templated: templated
    };
}

// 3. Network HAR / API Surface & Binary Wire Protocol Reconstructor
fn reconstruct_protocol_surface(spec) {
    _keys(spec, ["exchanges", "wire_frames"], "reconstruct_protocol_surface");
    let exchanges = [];
    if map_has(spec, "exchanges") {
        if type(spec.exchanges) != "array" or len(spec.exchanges) > 64 {
            throw "reconstruct_protocol_surface: invalid exchanges";
        }
        exchanges = spec.exchanges;
    }
    let wire_frames = [];
    if map_has(spec, "wire_frames") {
        if type(spec.wire_frames) != "array" or len(spec.wire_frames) > 64 {
            throw "reconstruct_protocol_surface: invalid wire_frames";
        }
        wire_frames = spec.wire_frames;
    }
    if len(exchanges) == 0 and len(wire_frames) == 0 {
        throw "reconstruct_protocol_surface: requires exchanges or wire_frames";
    }

    let endpoint_groups = map{};
    let endpoint_keys = [];
    let any_templated = false;

    for ex in exchanges {
        _keys(ex, ["method", "path", "status", "auth_scheme", "request_fields", "response_fields"], "reconstruct_protocol_surface.exchange");
        let method = str_upper(str_trim(str(try ex.method catch "GET")));
        let path = str(try ex.path catch "/");
        let status = try ex.status catch 200;
        let auth = str(try ex.auth_scheme catch "none");
        if type(status) != "number" or status < 100 or status > 599 {
            throw "reconstruct_protocol_surface: invalid HTTP status";
        }
        let tpl = _template_path(path);
        if _is_true(tpl.templated) { any_templated = true; }
        let key = method + " " + tpl.template;
        if not map_has(endpoint_groups, key) {
            push(endpoint_keys, key);
            endpoint_groups[key] = map{
                method: method,
                path_template: tpl.template,
                templated: tpl.templated,
                observation_count: 0,
                statuses: [],
                auth_schemes: [],
                request_fields: [],
                response_fields: []
            };
        }
        let grp = endpoint_groups[key];
        grp.observation_count = grp.observation_count + 1;
        if not _has(grp.statuses, status) { push(grp.statuses, status); }
        if auth != "none" and not _has(grp.auth_schemes, auth) { push(grp.auth_schemes, auth); }
        if map_has(ex, "request_fields") and type(ex.request_fields) == "array" {
            for rf in ex.request_fields {
                if type(rf) == "string" and not _has(grp.request_fields, rf) { push(grp.request_fields, rf); }
            }
        }
        if map_has(ex, "response_fields") and type(ex.response_fields) == "array" {
            for rsf in ex.response_fields {
                if type(rsf) == "string" and not _has(grp.response_fields, rsf) { push(grp.response_fields, rsf); }
            }
        }
        endpoint_groups[key] = grp;
    }

    let endpoints = [];
    for k in endpoint_keys {
        push(endpoints, endpoint_groups[k]);
    }

    // Binary Wire Frame Reconstruction
    let parsed_frames = [];
    let min_frame_len = 999999;
    let max_frame_len = 0;
    for wf in wire_frames {
        let fbytes = _bytes_from_hex(wf, 4096);
        if len(fbytes) < min_frame_len { min_frame_len = len(fbytes); }
        if len(fbytes) > max_frame_len { max_frame_len = len(fbytes); }
        push(parsed_frames, fbytes);
    }

    let common_prefix_hex = "";
    let length_field_candidate = "none";
    if len(parsed_frames) > 0 {
        let first = parsed_frames[0];
        let prefix_len = 0;
        let check_max = if len(first) < 8 { len(first) } else { 8 };
        let pos = 0;
        while pos < check_max {
            let bval = first[pos];
            let all_match = true;
            for pf in parsed_frames {
                if pos >= len(pf) or pf[pos] != bval { all_match = false; }
            }
            if _is_true(all_match) and pos == prefix_len {
                common_prefix_hex = common_prefix_hex + _hex_byte(bval);
                prefix_len = prefix_len + 1;
            }
            pos = pos + 1;
        }
        // Check if byte at offset 2..4 encodes payload length or total length
        if len(first) >= 4 {
            let total_n = len(first);
            let rem_after_4 = total_n - 4;
            if _u16(first, 2, false) == total_n or _u16(first, 2, false) == rem_after_4 {
                length_field_candidate = "u16be@offset_2";
            } elif _u16(first, 2, true) == total_n or _u16(first, 2, true) == rem_after_4 {
                length_field_candidate = "u16le@offset_2";
            } elif first[1] == total_n or first[1] == total_n - 2 {
                length_field_candidate = "u8@offset_1";
            }
        }
    } else {
        min_frame_len = 0;
    }

    let digest = SHA256.sha256_hex(str(len(endpoints)) + "|" + str(len(parsed_frames)) + "|" + common_prefix_hex + "|" + length_field_candidate);

    return map{
        ok: true,
        format: FORMAT_PROTOCOL,
        evidence_id: "ev_" + digest,
        api_surface: map{
            endpoint_count: len(endpoints),
            derivation_kind: if _is_true(any_templated) { "inferred_templated" } else { "derived_exact" },
            endpoints: endpoints
        },
        wire_protocol: map{
            frame_count: len(parsed_frames),
            fixed_length: len(parsed_frames) > 0 and min_frame_len == max_frame_len,
            min_frame_bytes: min_frame_len,
            max_frame_bytes: max_frame_len,
            common_magic_prefix_hex: common_prefix_hex,
            length_field_candidate: length_field_candidate
        },
        _meta: map{
            provenance: map{
                untrusted_content: true,
                source: "analysis_target"
            }
        }
    };
}

// 4. Facet-Aware Function/Artifact Comparison, Unknowns Ledger & Reconstruction Readiness Gate
fn evaluate_evidence_ledger(spec) {
    _keys(spec, ["target_name", "left_dossier", "right_dossier", "observations", "unknowns", "obligations"], "evaluate_evidence_ledger");
    let target_name = "reconstruction-target";
    if map_has(spec, "target_name") {
        if type(spec.target_name) != "string" or len(spec.target_name) < 1 or len(spec.target_name) > 128 {
            throw "evaluate_evidence_ledger: invalid target_name";
        }
        target_name = spec.target_name;
    }

    let supported_facets = ["pseudocode", "assembly", "comments", "callers", "callees", "references", "strings_names", "cfg"];
    let facet_comparison = map{};
    let equal_facets = 0;
    let different_facets = 0;
    let unknown_facets = 0;

    if map_has(spec, "left_dossier") or map_has(spec, "right_dossier") {
        if not map_has(spec, "left_dossier") or not map_has(spec, "right_dossier") {
            throw "evaluate_evidence_ledger: both left_dossier and right_dossier are required for comparison";
        }
        let left = spec.left_dossier;
        let right = spec.right_dossier;
        if type(left) != "map" or type(right) != "map" {
            throw "evaluate_evidence_ledger: dossiers must be maps";
        }
        for facet in supported_facets {
            let l_avail = false;
            let r_avail = false;
            let l_val = "";
            let r_val = "";
            if map_has(left, facet) and type(left[facet]) == "map" {
                l_avail = _is_true(try left[facet].available catch false);
                l_val = str(try left[facet].digest catch try left[facet].value catch "");
            }
            if map_has(right, facet) and type(right[facet]) == "map" {
                r_avail = _is_true(try right[facet].available catch false);
                r_val = str(try right[facet].digest catch try right[facet].value catch "");
            }
            if not _is_true(l_avail) or not _is_true(r_avail) {
                facet_comparison[facet] = "unknown";
                unknown_facets = unknown_facets + 1;
            } elif l_val == r_val {
                facet_comparison[facet] = "equal";
                equal_facets = equal_facets + 1;
            } else {
                facet_comparison[facet] = "different";
                different_facets = different_facets + 1;
            }
        }
    }

    let observations = [];
    if map_has(spec, "observations") {
        if type(spec.observations) != "array" or len(spec.observations) > 64 {
            throw "evaluate_evidence_ledger: invalid observations";
        }
        observations = spec.observations;
    }

    let unknowns = [];
    let open_unknowns = 0;
    let blocking_unknowns = 0;
    if map_has(spec, "unknowns") {
        if type(spec.unknowns) != "array" or len(spec.unknowns) > 64 {
            throw "evaluate_evidence_ledger: invalid unknowns";
        }
        for u in spec.unknowns {
            _keys(u, ["id", "question", "status", "blocking"], "evaluate_evidence_ledger.unknown");
            let st = str(try u.status catch "open");
            let blk = _is_true(try u.blocking catch false);
            if st == "open" {
                open_unknowns = open_unknowns + 1;
                if _is_true(blk) { blocking_unknowns = blocking_unknowns + 1; }
            }
            push(unknowns, u);
        }
    }

    let obligations = [];
    let verified_obligations = 0;
    if map_has(spec, "obligations") {
        if type(spec.obligations) != "array" or len(spec.obligations) > 64 {
            throw "evaluate_evidence_ledger: invalid obligations";
        }
        for ob in spec.obligations {
            _keys(ob, ["id", "requirement", "verified"], "evaluate_evidence_ledger.obligation");
            if _is_true(try ob.verified catch false) {
                verified_obligations = verified_obligations + 1;
            }
            push(obligations, ob);
        }
    }

    let total_obligations = len(obligations);
    let obligation_pct = 100;
    if total_obligations > 0 {
        obligation_pct = num_floor((verified_obligations * 100) / total_obligations);
    }

    let readiness_status = "READY_FOR_CLEANROOM_BUILD";
    if blocking_unknowns > 0 {
        readiness_status = "BLOCKED_BY_OPEN_UNKNOWNS";
    } elif open_unknowns > 0 or verified_obligations < total_obligations {
        readiness_status = "PARTIAL_NEEDS_RESOLUTION";
    }

    let digest = SHA256.sha256_hex(target_name + "|" + readiness_status + "|" + str(equal_facets) + "|" + str(different_facets) + "|" + str(unknown_facets) + "|" + str(open_unknowns) + "|" + str(verified_obligations));

    return map{
        ok: true,
        format: FORMAT_LEDGER,
        evidence_id: "ev_" + digest,
        target_name: target_name,
        dossier_comparison: map{
            equal_facet_count: equal_facets,
            different_facet_count: different_facets,
            unknown_facet_count: unknown_facets,
            facets: facet_comparison
        },
        ledger_summary: map{
            observation_count: len(observations),
            total_unknowns: len(unknowns),
            open_unknown_count: open_unknowns,
            blocking_unknown_count: blocking_unknowns,
            total_obligations: total_obligations,
            verified_obligation_count: verified_obligations,
            obligation_coverage_pct: obligation_pct,
            readiness_status: readiness_status
        }
    };
}

export FORMAT_BINARY, FORMAT_APP_GRAPH, FORMAT_PROTOCOL, FORMAT_LEDGER,
       inspect_binary_artifact, analyze_application_surface,
       reconstruct_protocol_surface, evaluate_evidence_ledger;
