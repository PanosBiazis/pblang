// stdlib/rea_suite.sapp -- Pure offline Reverse Engineering & Architecture (REA) suite.
// Provides bounded static binary/compiler/mitigation/crypto/EVM/WASM/PE/ELF/Mach-O inspection,
// JavaScript/Electron/Multi-language application graph & clean-room spec reconstruction,
// HTTP/REST & binary wire protocol reconstruction, and facet-aware Evidence & Readiness ledgers.
// Zero target execution, zero shell invocation, zero network access, and explicit prompt-injection guard.

let SHA256 = import("stdlib:sha256_pb.sapp");

let FORMAT_BINARY = "pblang.rea.binary-audit.v1";
let FORMAT_APP_GRAPH = "pblang.rea.application-graph.v1";
let FORMAT_PROTOCOL = "pblang.rea.protocol-reconstruct.v1";
let FORMAT_LEDGER = "pblang.rea.evidence-ledger.v1";
let FORMAT_DECOMPILE = "pblang.rea.decompile-cfg.v1";
let FORMAT_DOM_SCRAPE = "pblang.rea.dom-scrape-extract.v1";
let HEX_DIGITS = "0123456789abcdef";

fn _has(items, target) {
    for item in items {
        if item == target { return true; }
    }
    return false;
}

fn _is_true(value) {
    if value { return true; }
    return false;
}

fn _keys(value, allowed, ctx) {
    if type(value) != "map" { throw ctx + ": expected map"; }
    let matched = 0;
    for field in allowed {
        if map_has(value, field) { matched = matched + 1; }
    }
    if matched != len(value) { throw ctx + ": unsupported property"; }
}

fn _hex_nibble(code) {
    if code >= 48 and code <= 57 { return code - 48; }
    if code >= 65 and code <= 70 { return code - 55; }
    if code >= 97 and code <= 102 { return code - 87; }
    return -1;
}

fn _hex_byte(b) {
    let hi = num_floor(b / 16) % 16;
    let lo = b % 16;
    return str_slice(HEX_DIGITS, hi, hi + 1) + str_slice(HEX_DIGITS, lo, lo + 1);
}

fn _bytes_from_hex(hex_str, max_bytes) {
    if type(hex_str) != "string" { throw "rea_suite: hex must be a string"; }
    let clean = str_trim(hex_str);
    if str_starts_with(clean, "0x") or str_starts_with(clean, "0X") {
        clean = str_slice(clean, 2, len(clean));
    }
    clean = str_replace_all(clean, " ", "");
    if len(clean) % 2 != 0 { throw "rea_suite: hex string must have an even length"; }
    let byte_count = num_floor(len(clean) / 2);
    if byte_count > max_bytes { throw "rea_suite: hex byte budget exceeded"; }
    let out = [];
    let i = 0;
    while i < len(clean) {
        let hi = _hex_nibble(strcharcodeat(clean, i));
        let lo = _hex_nibble(strcharcodeat(clean, i + 1));
        if hi < 0 or lo < 0 { throw "rea_suite: invalid hexadecimal digit"; }
        push(out, hi * 16 + lo);
        i = i + 2;
    }
    return out;
}

fn _validate_bytes(raw, max_bytes) {
    if type(raw) != "array" or len(raw) > max_bytes {
        throw "rea_suite: byte array budget exceeded";
    }
    let out = [];
    for b in raw {
        if type(b) != "number" or b != num_floor(b) or b < 0 or b > 255 {
            throw "rea_suite: byte values must be integers in 0..255";
        }
        push(out, b);
    }
    return out;
}

fn _u16(bytes, offset, little) {
    if offset < 0 or offset + 2 > len(bytes) { return 0; }
    if _is_true(little) { return bytes[offset] + bytes[offset + 1] * 256; }
    return bytes[offset] * 256 + bytes[offset + 1];
}

fn _u32(bytes, offset, little) {
    if offset < 0 or offset + 4 > len(bytes) { return 0; }
    if _is_true(little) {
        return bytes[offset] + bytes[offset + 1] * 256 + bytes[offset + 2] * 65536 + bytes[offset + 3] * 16777216;
    }
    return bytes[offset] * 16777216 + bytes[offset + 1] * 65536 + bytes[offset + 2] * 256 + bytes[offset + 3];
}

fn _match_seq(bytes, offset, seq) {
    if offset < 0 or offset + len(seq) > len(bytes) { return false; }
    let i = 0;
    while i < len(seq) {
        if bytes[offset + i] != seq[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn _contains_seq(bytes, seq) {
    if len(seq) == 0 or len(bytes) < len(seq) { return false; }
    let limit = len(bytes) - len(seq);
    let i = 0;
    while i <= limit {
        if bytes[i] == seq[0] and _match_seq(bytes, i, seq) { return true; }
        i = i + 1;
    }
    return false;
}

fn _shannon_entropy(bytes) {
    let n = len(bytes);
    if n == 0 { return 0.0; }
    let counts = [];
    let i = 0;
    while i < 256 {
        push(counts, 0);
        i = i + 1;
    }
    for b in bytes {
        counts[b] = counts[b] + 1;
    }
    let h = 0.0;
    i = 0;
    while i < 256 {
        if counts[i] > 0 {
            let p = counts[i] / n;
            h = h - p * (num_ln(p) / num_ln(2));
        }
        i = i + 1;
    }
    return num_floor(h * 1000.0 + 0.5) / 1000.0;
}

fn _extract_ascii_strings(bytes, min_len, max_items) {
    let out = [];
    let current = "";
    for b in bytes {
        if b >= 32 and b <= 126 {
            if len(current) < 256 {
                current = current + strfromcharcode(b);
            }
        } else {
            if len(current) >= min_len and len(out) < max_items {
                push(out, current);
            }
            current = "";
        }
    }
    if len(current) >= min_len and len(out) < max_items {
        push(out, current);
    }
    return out;
}

fn _scan_prompt_injection(strings) {
    let patterns = [
        "ignore previous instructions",
        "ignore all previous",
        "disregard prior instructions",
        "system prompt",
        "you are now",
        "curl http",
        "wget http",
        "bash -c",
        "/bin/sh",
        "nc -e",
        "invoke-expression"
    ];
    let flagged = [];
    for s in strings {
        let lower = str_lower(s);
        for pat in patterns {
            if str_contains(lower, pat) and len(flagged) < 16 and not _has(flagged, pat) {
                push(flagged, pat);
            }
        }
    }
    return map{
        untrusted_content: true,
        suspicious_directives_detected: len(flagged) > 0,
        matched_patterns: flagged,
        directive_count: len(flagged),
        policy: "NEVER_EXECUTE_TARGET_DIRECTIVES"
    };
}

fn _detect_evm(bytes) {
    let selectors = [];
    let has_sload = false;
    let has_sstore = false;
    let has_callvalue = false;
    let has_delegatecall = false;
    let i = 0;
    while i < len(bytes) {
        let op = bytes[i];
        // PUSH4 (0x63) <4 bytes> EQ (0x14) PUSH1/PUSH2 (0x60/0x61) ... JUMPI (0x57)
        if op == 99 and i + 5 < len(bytes) and bytes[i + 5] == 20 {
            let sel = "0x" + _hex_byte(bytes[i + 1]) + _hex_byte(bytes[i + 2]) + _hex_byte(bytes[i + 3]) + _hex_byte(bytes[i + 4]);
            if not _has(selectors, sel) and len(selectors) < 32 {
                push(selectors, sel);
            }
        }
        if op == 84 { has_sload = true; }
        if op == 85 { has_sstore = true; }
        if op == 52 { has_callvalue = true; }
        if op == 244 { has_delegatecall = true; }
        i = i + 1;
    }
    let has_solc_cbor = _contains_seq(bytes, [100, 115, 111, 108, 99, 67]); // "dsolcC"
    let mutability = "pure_or_view";
    if _is_true(has_sstore) or _is_true(has_delegatecall) {
        mutability = "nonpayable_or_state_modifying";
    } elif _is_true(has_sload) {
        mutability = "view";
    }
    return map{
        selector_count: len(selectors),
        selectors: selectors,
        has_sload: has_sload,
        has_sstore: has_sstore,
        has_callvalue: has_callvalue,
        has_delegatecall: has_delegatecall,
        solidity_cbor_metadata: has_solc_cbor,
        inferred_mutability: mutability
    };
}

// 1. Binary, Compiler Provenance, Mitigations, Crypto/Packer & Multi-Format Audit
fn inspect_binary_artifact(spec) {
    _keys(spec, ["name", "bytes", "hex", "strings", "symbols", "sections", "imports"], "inspect_binary_artifact");
    let name = "artifact.bin";
    if map_has(spec, "name") {
        if type(spec.name) != "string" or len(spec.name) < 1 or len(spec.name) > 128 {
            throw "inspect_binary_artifact: invalid name";
        }
        name = spec.name;
    }
    let bytes = [];
    if map_has(spec, "bytes") and map_has(spec, "hex") {
        throw "inspect_binary_artifact: provide either bytes or hex, not both";
    }
    if map_has(spec, "bytes") {
        bytes = _validate_bytes(spec.bytes, 16384);
    } elif map_has(spec, "hex") {
        bytes = _bytes_from_hex(spec.hex, 16384);
    } else {
        throw "inspect_binary_artifact: bytes or hex required";
    }
    if len(bytes) < 4 {
        throw "inspect_binary_artifact: requires at least 4 bytes";
    }

    let extra_strings = [];
    if map_has(spec, "strings") {
        if type(spec.strings) != "array" or len(spec.strings) > 128 { throw "inspect_binary_artifact: invalid strings"; }
        for s in spec.strings {
            if type(s) != "string" or len(s) > 256 { throw "inspect_binary_artifact: invalid string item"; }
            push(extra_strings, s);
        }
    }
    let symbols = [];
    if map_has(spec, "symbols") {
        if type(spec.symbols) != "array" or len(spec.symbols) > 128 { throw "inspect_binary_artifact: invalid symbols"; }
        for sym in spec.symbols {
            if type(sym) != "string" or len(sym) > 128 { throw "inspect_binary_artifact: invalid symbol"; }
            push(symbols, sym);
        }
    }
    let sections = [];
    if map_has(spec, "sections") {
        if type(spec.sections) != "array" or len(spec.sections) > 64 { throw "inspect_binary_artifact: invalid sections"; }
        for sec_name in spec.sections {
            if type(sec_name) != "string" or len(sec_name) > 64 { throw "inspect_binary_artifact: invalid section"; }
            push(sections, sec_name);
        }
    }
    let imports = [];
    if map_has(spec, "imports") {
        if type(spec.imports) != "array" or len(spec.imports) > 128 { throw "inspect_binary_artifact: invalid imports"; }
        for imp in spec.imports {
            if type(imp) != "string" or len(imp) > 128 { throw "inspect_binary_artifact: invalid import"; }
            push(imports, imp);
        }
    }

    let ascii_strings = _extract_ascii_strings(bytes, 4, 64);
    let all_strings = [];
    for s in ascii_strings { push(all_strings, s); }
    for s in extra_strings { if not _has(all_strings, s) { push(all_strings, s); } }
    for s in symbols { if not _has(all_strings, s) { push(all_strings, s); } }

    let format = "raw_or_unknown";
    let arch = "unknown";
    let word_bits = 0;
    let endian = "unknown";
    let is_pie_header = false;
    let is_dotnet_cil = _contains_seq(bytes, [66, 83, 74, 66]); // "BSJB"

    if _match_seq(bytes, 0, [127, 69, 76, 70]) {
        format = "elf";
        if len(bytes) >= 20 {
            word_bits = if bytes[4] == 2 { 64 } else { 32 };
            endian = if bytes[5] == 1 { "little" } else { "big" };
            let little = bytes[5] == 1;
            let elf_type = _u16(bytes, 16, little);
            let machine = _u16(bytes, 18, little);
            is_pie_header = (elf_type == 3);
            if machine == 62 { arch = "x86_64"; }
            elif machine == 3 { arch = "x86"; }
            elif machine == 183 { arch = "aarch64"; }
            elif machine == 40 { arch = "arm"; }
            elif machine == 243 { arch = "riscv"; }
            elif machine == 8 { arch = "mips"; }
            elif machine == 20 or machine == 21 { arch = "powerpc"; }
        }
    } elif _match_seq(bytes, 0, [77, 90]) {
        format = if _is_true(is_dotnet_cil) { "pe_dotnet_cil" } else { "pe" };
        endian = "little";
        word_bits = 64;
        arch = "x86_64";
        if len(bytes) >= 64 {
            let pe_off = _u32(bytes, 60, true);
            if pe_off >= 0 and pe_off + 6 <= len(bytes) and _match_seq(bytes, pe_off, [80, 69, 0, 0]) {
                let machine = _u16(bytes, pe_off + 4, true);
                if machine == 332 { arch = "x86"; word_bits = 32; }
                elif machine == 34404 { arch = "x86_64"; word_bits = 64; }
                elif machine == 43620 { arch = "aarch64"; word_bits = 64; }
            }
        }
    } elif _match_seq(bytes, 0, [207, 250, 237, 254]) or _match_seq(bytes, 0, [206, 250, 237, 254]) {
        format = "mach-o";
        endian = "little";
        word_bits = if bytes[0] == 207 { 64 } else { 32 };
        if len(bytes) >= 8 {
            let cpu = _u32(bytes, 4, true) % 16777216;
            if cpu == 7 { arch = if word_bits == 64 { "x86_64" } else { "x86" }; }
            elif cpu == 12 { arch = if word_bits == 64 { "aarch64" } else { "arm" }; }
        }
    } elif _match_seq(bytes, 0, [202, 254, 186, 190]) {
        format = "mach-o-universal";
        endian = "big";
        word_bits = 64;
    } elif _match_seq(bytes, 0, [0, 97, 115, 109]) {
        format = "wasm";
        endian = "little";
        word_bits = 32;
        arch = "wasm32";
    } elif _match_seq(bytes, 0, [100, 101, 120, 10]) {
        format = "android_dex";
        endian = "little";
        word_bits = 32;
        arch = "dalvik_dex";
    } elif _match_seq(bytes, 0, [83, 81, 76, 105]) {
        format = "sqlite3";
        endian = "big";
        word_bits = 64;
        arch = "sqlite_btree";
    }

    let evm = _detect_evm(bytes);
    if format == "raw_or_unknown" and (evm.selector_count > 0 or _is_true(evm.solidity_cbor_metadata)) {
        format = "evm_bytecode";
        arch = "evm256";
        word_bits = 256;
        endian = "big";
    }

    // Compiler & Ecosystem Provenance (Go / Rust / .NET / Flutter / C/C++)
    let is_go = _contains_seq(bytes, [255, 32, 71, 111, 32, 98, 117, 105, 108, 100, 105, 110, 102, 58]);
    let is_rust = false;
    let is_flutter = false;
    let go_version = "";
    let rust_crates = [];
    for s in all_strings {
        if str_starts_with(s, "go1.") {
            is_go = true;
            go_version = s;
        }
        if str_contains(s, "rustc ") or str_contains(s, "cargo-auditable") or str_contains(s, ".dep-v0") {
            is_rust = true;
        }
        if str_contains(s, "crate:") and len(rust_crates) < 16 {
            push(rust_crates, s);
            is_rust = true;
        }
        if str_contains(s, "libapp.so") or str_contains(s, "kDartVmSnapshotData") {
            is_flutter = true;
        }
    }
    for sec_name in sections {
        if sec_name == ".gopclntab" or sec_name == ".go.buildinfo" { is_go = true; }
        if sec_name == ".dep-v0" { is_rust = true; }
    }

    let compiler_family = "native_c_cpp_or_unknown";
    if _is_true(is_go) { compiler_family = "golang"; }
    elif _is_true(is_rust) { compiler_family = "rust"; }
    elif _is_true(is_dotnet_cil) { compiler_family = "dotnet_cil"; }
    elif _is_true(is_flutter) { compiler_family = "flutter_dart_aot"; }
    elif format == "wasm" { compiler_family = "webassembly"; }
    elif format == "evm_bytecode" { compiler_family = "solidity_or_vyper_evm"; }

    // Static Security Mitigations Audit
    let has_canary = _has(symbols, "__stack_chk_fail") or _has(symbols, "__security_check_cookie") or _has(imports, "__stack_chk_fail");
    let has_fortify = false;
    for sym in symbols {
        if str_ends_with(sym, "_chk") { has_fortify = true; }
    }
    let has_relro = _has(sections, ".gnu.relro") or _has(sections, ".got.plt") or _has(sections, ".dynamic");
    let has_nx = format == "elf" or format == "pe" or format == "pe_dotnet_cil" or format == "mach-o" or format == "wasm";
    let has_cfi = _contains_seq(bytes, [243, 15, 30, 250]); // endbr64 (f3 0f 1e fa)
    let score = 20;
    if _is_true(is_pie_header) or format == "wasm" or format == "pe_dotnet_cil" { score = score + 20; }
    if _is_true(has_canary) { score = score + 20; }
    if _is_true(has_relro) { score = score + 15; }
    if _is_true(has_nx) { score = score + 15; }
    if _is_true(has_fortify) or _is_true(has_cfi) { score = score + 10; }
    if score > 100 { score = 100; }

    // Crypto Constants & Packer Heuristics
    let has_aes_sbox = _contains_seq(bytes, [99, 124, 119, 123, 242, 107, 111, 197]);
    let has_sha256_iv = _contains_seq(bytes, [103, 230, 9, 106]) or _contains_seq(bytes, [106, 9, 230, 103]);
    let has_chacha20 = _contains_seq(bytes, [101, 120, 112, 97, 110, 100, 32, 51, 50, 45, 98, 121, 116, 101, 32, 107]);
    let has_upx = _contains_seq(bytes, [85, 80, 88, 33]) or _has(sections, "UPX0") or _has(sections, "UPX1");
    let entropy = _shannon_entropy(bytes);
    let entropy_class = "normal_structured";
    if entropy >= 7.2 { entropy_class = "high_packed_or_encrypted"; }
    elif entropy < 2.5 { entropy_class = "low_sparse_or_padding"; }

    let crypto_signals = [];
    if _is_true(has_aes_sbox) { push(crypto_signals, "AES_SBOX"); }
    if _is_true(has_sha256_iv) { push(crypto_signals, "SHA256_IV"); }
    if _is_true(has_chacha20) { push(crypto_signals, "CHACHA20_SIGMA"); }

    let packer_signals = [];
    if _is_true(has_upx) { push(packer_signals, "UPX_PACKER"); }
    if entropy >= 7.2 { push(packer_signals, "HIGH_ENTROPY_PACKED_SECTION"); }

    let sha_hex = SHA256.sha256_hex_bytes(bytes);
    let prompt_guard = _scan_prompt_injection(all_strings);

    return map{
        ok: true,
        format: FORMAT_BINARY,
        evidence_id: "ev_" + sha_hex,
        artifact_name: name,
        byte_length: len(bytes),
        sha256: sha_hex,
        binary_format: format,
        architecture: arch,
        word_bits: word_bits,
        endian: endian,
        compiler_provenance: map{
            compiler_family: compiler_family,
            is_go_binary: is_go,
            go_version: go_version,
            is_rust_binary: is_rust,
            rust_crates: rust_crates,
            is_dotnet_cil: is_dotnet_cil,
            is_flutter_aot: is_flutter
        },
        mitigations: map{
            pie_or_aslr: _is_true(is_pie_header) or format == "pe" or format == "pe_dotnet_cil",
            nx_dep_enabled: has_nx,
            relro_present: has_relro,
            stack_canary: has_canary,
            fortify_source: has_fortify,
            cet_endbr64: has_cfi,
            hardening_score: score
        },
        crypto_and_packer_signals: map{
            shannon_entropy: entropy,
            entropy_classification: entropy_class,
            crypto_constants: crypto_signals,
            packer_indicators: packer_signals
        },
        evm_inspection: evm,
        extracted_string_count: len(all_strings),
        extracted_strings: all_strings,
        prompt_injection_guard: prompt_guard,
        _meta: map{
            provenance: map{
                untrusted_content: true,
                source: "analysis_target"
            }
        },
        target_executed: false,
        shell_used: false,
        network_used: false
    };
}

// 2. JavaScript / Electron / Multi-Language Application Graph, Feature Tracer & Clean-Room Spec
fn analyze_application_surface(spec) {
    _keys(spec, ["app_name", "modules", "feature_seed", "electron_config"], "analyze_application_surface");
    let app_name = "target-app";
    if map_has(spec, "app_name") {
        if type(spec.app_name) != "string" or len(spec.app_name) < 1 or len(spec.app_name) > 128 {
            throw "analyze_application_surface: invalid app_name";
        }
        app_name = spec.app_name;
    }
    if not map_has(spec, "modules") or type(spec.modules) != "array" or len(spec.modules) < 1 or len(spec.modules) > 32 {
        throw "analyze_application_surface: modules must contain 1..32 module descriptors";
    }
    let seed = "";
    if map_has(spec, "feature_seed") {
        if type(spec.feature_seed) != "string" or len(spec.feature_seed) > 64 {
            throw "analyze_application_surface: invalid feature_seed";
        }
        seed = str_lower(str_trim(spec.feature_seed));
    }

    let module_nodes = [];
    let ipc_channels = [];
    let http_routes = [];
    let native_bridges = [];
    let storage_entities = [];
    let matched_modules = [];
    let all_sources = [];

    for mod_item in spec.modules {
        _keys(mod_item, ["path", "source", "kind"], "analyze_application_surface.module");
        let path = try mod_item.path catch "";
        let src = try mod_item.source catch "";
        let kind = try mod_item.kind catch "javascript";
        if type(path) != "string" or len(path) < 1 or len(path) > 128 {
            throw "analyze_application_surface: invalid module path";
        }
        if type(src) != "string" or len(src) > 16384 {
            throw "analyze_application_surface: invalid module source";
        }
        if type(kind) != "string" or len(kind) > 32 {
            throw "analyze_application_surface: invalid module kind";
        }
        push(all_sources, src);

        let lines = str_split(src, "\n");
        let mod_imports = [];
        let mod_exports = [];
        let mod_ipc = [];
        let mod_routes = [];

        for line in lines {
            let trimmed = str_trim(line);
            if (str_contains(trimmed, "import ") or str_contains(trimmed, "require(")) and len(mod_imports) < 32 {
                push(mod_imports, trimmed);
            }
            if (str_starts_with(trimmed, "export ") or str_contains(trimmed, "module.exports") or str_starts_with(trimmed, "fn ") or str_starts_with(trimmed, "public ")) and len(mod_exports) < 32 {
                push(mod_exports, trimmed);
            }
            if str_contains(trimmed, "ipcMain.handle(") or str_contains(trimmed, "ipcMain.on(")
               or str_contains(trimmed, "ipcRenderer.invoke(") or str_contains(trimmed, "ipcRenderer.send(")
               or str_contains(trimmed, "contextBridge.exposeInMainWorld(") {
                push(mod_ipc, trimmed);
                if not _has(ipc_channels, trimmed) and len(ipc_channels) < 64 {
                    push(ipc_channels, trimmed);
                }
            }
            if str_contains(trimmed, "/api/") or str_contains(trimmed, "/v1/")
               or str_contains(trimmed, "fetch(") or str_contains(trimmed, "app.get(")
               or str_contains(trimmed, "app.post(") {
                push(mod_routes, trimmed);
                if not _has(http_routes, trimmed) and len(http_routes) < 64 {
                    push(http_routes, trimmed);
                }
            }
            if (str_contains(trimmed, ".node") or str_contains(trimmed, "DllImport")
               or str_contains(trimmed, "ffi.") or str_contains(trimmed, "WebAssembly."))
               and not _has(native_bridges, path + ": " + trimmed) and len(native_bridges) < 32 {
                push(native_bridges, path + ": " + trimmed);
            }
            if (str_contains(trimmed, "CREATE TABLE") or str_contains(trimmed, "SELECT ")
               or str_contains(trimmed, "localStorage.") or str_contains(trimmed, "indexedDB"))
               and not _has(storage_entities, trimmed) and len(storage_entities) < 32 {
                push(storage_entities, trimmed);
            }
        }

        let matches_seed = false;
        if seed != "" and (str_contains(str_lower(path), seed) or str_contains(str_lower(src), seed)) {
            matches_seed = true;
            push(matched_modules, path);
        }

        push(module_nodes, map{
            path: path,
            kind: kind,
            line_count: len(lines),
            import_count: len(mod_imports),
            export_count: len(mod_exports),
            ipc_count: len(mod_ipc),
            route_count: len(mod_routes),
            matches_feature_seed: matches_seed,
            imports: mod_imports,
            exports: mod_exports
        });
    }

    let node_integration = false;
    let context_isolation = true;
    let sandbox_enabled = true;
    let web_security = true;
    if map_has(spec, "electron_config") {
        let ecfg = spec.electron_config;
        _keys(ecfg, ["node_integration", "context_isolation", "sandbox", "web_security"], "analyze_application_surface.electron_config");
        if map_has(ecfg, "node_integration") { node_integration = _is_true(ecfg.node_integration); }
        if map_has(ecfg, "context_isolation") { context_isolation = _is_true(ecfg.context_isolation); }
        if map_has(ecfg, "sandbox") { sandbox_enabled = _is_true(ecfg.sandbox); }
        if map_has(ecfg, "web_security") { web_security = _is_true(ecfg.web_security); }
    }
    let electron_score = 100;
    let electron_risks = [];
    if _is_true(node_integration) {
        electron_score = electron_score - 40;
        push(electron_risks, "NODE_INTEGRATION_ENABLED_IN_RENDERER");
    }
    if not _is_true(context_isolation) {
        electron_score = electron_score - 35;
        push(electron_risks, "CONTEXT_ISOLATION_DISABLED");
    }
    if not _is_true(sandbox_enabled) {
        electron_score = electron_score - 15;
        push(electron_risks, "RENDERER_SANDBOX_DISABLED");
    }
    if not _is_true(web_security) {
        electron_score = electron_score - 10;
        push(electron_risks, "WEB_SECURITY_DISABLED");
    }

    let digest = SHA256.sha256_hex(app_name + "|" + seed + "|" + str(len(module_nodes)) + "|" + str(len(ipc_channels)) + "|" + str(len(http_routes)));
    let prompt_guard = _scan_prompt_injection(all_sources);

    return map{
        ok: true,
        format: FORMAT_APP_GRAPH,
        evidence_id: "ev_" + digest,
        app_name: app_name,
        module_count: len(module_nodes),
        modules: module_nodes,
        ipc_channel_count: len(ipc_channels),
        ipc_channels: ipc_channels,
        http_route_count: len(http_routes),
        http_routes: http_routes,
        native_bridge_count: len(native_bridges),
        native_bridges: native_bridges,
        storage_entity_count: len(storage_entities),
        storage_entities: storage_entities,
        feature_trace: map{
            seed: seed,
            matched_module_count: len(matched_modules),
            matched_modules: matched_modules,
            trace_complete: true
        },
        electron_security_posture: map{
            node_integration: node_integration,
            context_isolation: context_isolation,
            sandbox: sandbox_enabled,
            web_security: web_security,
            security_score: electron_score,
            risks: electron_risks
        },
        cleanroom_blueprint: map{
            specification_mode: "COPYRIGHT_SAFE_FUNCTIONAL_RECONSTRUCTION",
            observed_entrypoints: len(ipc_channels) + len(http_routes),
            storage_contracts: len(storage_entities),
            recommended_targets: ["pblang", "csharp_dotnet10", "typescript"]
        },
        prompt_injection_guard: prompt_guard,
        _meta: map{
            provenance: map{
                untrusted_content: true,
                source: "analysis_target"
            }
        },
        target_executed: false
    };
}

fn _is_digits_only(seg) {
    if len(seg) < 1 { return false; }
    let i = 0;
    while i < len(seg) {
        let c = strcharcodeat(seg, i);
        if c < 48 or c > 57 { return false; }
        i = i + 1;
    }
    return true;
}

fn _template_path(raw_path) {
    let clean = raw_path;
    let qpos = str_index_of(clean, "?");
    if qpos >= 0 {
        clean = str_slice(clean, 0, qpos);
    }
    let parts = str_split(clean, "/");
    let out = [];
    let templated = false;
    for part in parts {
        if part == "" {
            push(out, "");
        } elif _is_digits_only(part) {
            push(out, "{id}");
            templated = true;
        } elif len(part) == 36 and str_contains(part, "-") {
            push(out, "{uuid}");
            templated = true;
        } else {
            push(out, part);
        }
    }
    let joined = str_join(out, "/");
    if joined == "" { joined = "/"; }
    return map{
        template: joined,
        templated: templated
    };
}

// 3. Network HAR / API Surface & Binary Wire Protocol Reconstructor
fn reconstruct_protocol_surface(spec) {
    _keys(spec, ["exchanges", "wire_frames"], "reconstruct_protocol_surface");
    let exchanges = [];
    if map_has(spec, "exchanges") {
        if type(spec.exchanges) != "array" or len(spec.exchanges) > 64 {
            throw "reconstruct_protocol_surface: invalid exchanges";
        }
        exchanges = spec.exchanges;
    }
    let wire_frames = [];
    if map_has(spec, "wire_frames") {
        if type(spec.wire_frames) != "array" or len(spec.wire_frames) > 64 {
            throw "reconstruct_protocol_surface: invalid wire_frames";
        }
        wire_frames = spec.wire_frames;
    }
    if len(exchanges) == 0 and len(wire_frames) == 0 {
        throw "reconstruct_protocol_surface: requires exchanges or wire_frames";
    }

    let endpoint_groups = map{};
    let endpoint_keys = [];
    let any_templated = false;

    for ex in exchanges {
        _keys(ex, ["method", "path", "status", "auth_scheme", "request_fields", "response_fields"], "reconstruct_protocol_surface.exchange");
        let method = str_upper(str_trim(str(try ex.method catch "GET")));
        let path = str(try ex.path catch "/");
        let status = try ex.status catch 200;
        let auth = str(try ex.auth_scheme catch "none");
        if type(status) != "number" or status < 100 or status > 599 {
            throw "reconstruct_protocol_surface: invalid HTTP status";
        }
        let tpl = _template_path(path);
        if _is_true(tpl.templated) { any_templated = true; }
        let key = method + " " + tpl.template;
        if not map_has(endpoint_groups, key) {
            push(endpoint_keys, key);
            endpoint_groups[key] = map{
                method: method,
                path_template: tpl.template,
                templated: tpl.templated,
                observation_count: 0,
                statuses: [],
                auth_schemes: [],
                request_fields: [],
                response_fields: []
            };
        }
        let grp = endpoint_groups[key];
        grp.observation_count = grp.observation_count + 1;
        if not _has(grp.statuses, status) { push(grp.statuses, status); }
        if auth != "none" and not _has(grp.auth_schemes, auth) { push(grp.auth_schemes, auth); }
        if map_has(ex, "request_fields") and type(ex.request_fields) == "array" {
            for rf in ex.request_fields {
                if type(rf) == "string" and not _has(grp.request_fields, rf) { push(grp.request_fields, rf); }
            }
        }
        if map_has(ex, "response_fields") and type(ex.response_fields) == "array" {
            for rsf in ex.response_fields {
                if type(rsf) == "string" and not _has(grp.response_fields, rsf) { push(grp.response_fields, rsf); }
            }
        }
        endpoint_groups[key] = grp;
    }

    let endpoints = [];
    for k in endpoint_keys {
        push(endpoints, endpoint_groups[k]);
    }

    // Binary Wire Frame Reconstruction
    let parsed_frames = [];
    let min_frame_len = 999999;
    let max_frame_len = 0;
    for wf in wire_frames {
        let fbytes = _bytes_from_hex(wf, 4096);
        if len(fbytes) < min_frame_len { min_frame_len = len(fbytes); }
        if len(fbytes) > max_frame_len { max_frame_len = len(fbytes); }
        push(parsed_frames, fbytes);
    }

    let common_prefix_hex = "";
    let length_field_candidate = "none";
    if len(parsed_frames) > 0 {
        let first = parsed_frames[0];
        let prefix_len = 0;
        let check_max = if len(first) < 8 { len(first) } else { 8 };
        let pos = 0;
        while pos < check_max {
            let bval = first[pos];
            let all_match = true;
            for pf in parsed_frames {
                if pos >= len(pf) or pf[pos] != bval { all_match = false; }
            }
            if _is_true(all_match) and pos == prefix_len {
                common_prefix_hex = common_prefix_hex + _hex_byte(bval);
                prefix_len = prefix_len + 1;
            }
            pos = pos + 1;
        }
        // Check if byte at offset 2..4 encodes payload length or total length
        if len(first) >= 4 {
            let total_n = len(first);
            let rem_after_4 = total_n - 4;
            if _u16(first, 2, false) == total_n or _u16(first, 2, false) == rem_after_4 {
                length_field_candidate = "u16be@offset_2";
            } elif _u16(first, 2, true) == total_n or _u16(first, 2, true) == rem_after_4 {
                length_field_candidate = "u16le@offset_2";
            } elif first[1] == total_n or first[1] == total_n - 2 {
                length_field_candidate = "u8@offset_1";
            }
        }
    } else {
        min_frame_len = 0;
    }

    let digest = SHA256.sha256_hex(str(len(endpoints)) + "|" + str(len(parsed_frames)) + "|" + common_prefix_hex + "|" + length_field_candidate);

    return map{
        ok: true,
        format: FORMAT_PROTOCOL,
        evidence_id: "ev_" + digest,
        api_surface: map{
            endpoint_count: len(endpoints),
            derivation_kind: if _is_true(any_templated) { "inferred_templated" } else { "derived_exact" },
            endpoints: endpoints
        },
        wire_protocol: map{
            frame_count: len(parsed_frames),
            fixed_length: len(parsed_frames) > 0 and min_frame_len == max_frame_len,
            min_frame_bytes: min_frame_len,
            max_frame_bytes: max_frame_len,
            common_magic_prefix_hex: common_prefix_hex,
            length_field_candidate: length_field_candidate
        },
        _meta: map{
            provenance: map{
                untrusted_content: true,
                source: "analysis_target"
            }
        }
    };
}

// 4. Facet-Aware Function/Artifact Comparison, Unknowns Ledger & Reconstruction Readiness Gate
fn evaluate_evidence_ledger(spec) {
    _keys(spec, ["target_name", "left_dossier", "right_dossier", "observations", "unknowns", "obligations"], "evaluate_evidence_ledger");
    let target_name = "reconstruction-target";
    if map_has(spec, "target_name") {
        if type(spec.target_name) != "string" or len(spec.target_name) < 1 or len(spec.target_name) > 128 {
            throw "evaluate_evidence_ledger: invalid target_name";
        }
        target_name = spec.target_name;
    }

    let supported_facets = ["pseudocode", "assembly", "comments", "callers", "callees", "references", "strings_names", "cfg"];
    let facet_comparison = map{};
    let equal_facets = 0;
    let different_facets = 0;
    let unknown_facets = 0;

    if map_has(spec, "left_dossier") or map_has(spec, "right_dossier") {
        if not map_has(spec, "left_dossier") or not map_has(spec, "right_dossier") {
            throw "evaluate_evidence_ledger: both left_dossier and right_dossier are required for comparison";
        }
        let left = spec.left_dossier;
        let right = spec.right_dossier;
        if type(left) != "map" or type(right) != "map" {
            throw "evaluate_evidence_ledger: dossiers must be maps";
        }
        for facet in supported_facets {
            let l_avail = false;
            let r_avail = false;
            let l_val = "";
            let r_val = "";
            if map_has(left, facet) and type(left[facet]) == "map" {
                l_avail = _is_true(try left[facet].available catch false);
                l_val = str(try left[facet].digest catch try left[facet].value catch "");
            }
            if map_has(right, facet) and type(right[facet]) == "map" {
                r_avail = _is_true(try right[facet].available catch false);
                r_val = str(try right[facet].digest catch try right[facet].value catch "");
            }
            if not _is_true(l_avail) or not _is_true(r_avail) {
                facet_comparison[facet] = "unknown";
                unknown_facets = unknown_facets + 1;
            } elif l_val == r_val {
                facet_comparison[facet] = "equal";
                equal_facets = equal_facets + 1;
            } else {
                facet_comparison[facet] = "different";
                different_facets = different_facets + 1;
            }
        }
    }

    let observations = [];
    if map_has(spec, "observations") {
        if type(spec.observations) != "array" or len(spec.observations) > 64 {
            throw "evaluate_evidence_ledger: invalid observations";
        }
        observations = spec.observations;
    }

    let unknowns = [];
    let open_unknowns = 0;
    let blocking_unknowns = 0;
    if map_has(spec, "unknowns") {
        if type(spec.unknowns) != "array" or len(spec.unknowns) > 64 {
            throw "evaluate_evidence_ledger: invalid unknowns";
        }
        for u in spec.unknowns {
            _keys(u, ["id", "question", "status", "blocking"], "evaluate_evidence_ledger.unknown");
            let st = str(try u.status catch "open");
            let blk = _is_true(try u.blocking catch false);
            if st == "open" {
                open_unknowns = open_unknowns + 1;
                if _is_true(blk) { blocking_unknowns = blocking_unknowns + 1; }
            }
            push(unknowns, u);
        }
    }

    let obligations = [];
    let verified_obligations = 0;
    if map_has(spec, "obligations") {
        if type(spec.obligations) != "array" or len(spec.obligations) > 64 {
            throw "evaluate_evidence_ledger: invalid obligations";
        }
        for ob in spec.obligations {
            _keys(ob, ["id", "requirement", "verified"], "evaluate_evidence_ledger.obligation");
            if _is_true(try ob.verified catch false) {
                verified_obligations = verified_obligations + 1;
            }
            push(obligations, ob);
        }
    }

    let total_obligations = len(obligations);
    let obligation_pct = 100;
    if total_obligations > 0 {
        obligation_pct = num_floor((verified_obligations * 100) / total_obligations);
    }

    let readiness_status = "READY_FOR_CLEANROOM_BUILD";
    if blocking_unknowns > 0 {
        readiness_status = "BLOCKED_BY_OPEN_UNKNOWNS";
    } elif open_unknowns > 0 or verified_obligations < total_obligations {
        readiness_status = "PARTIAL_NEEDS_RESOLUTION";
    }

    let digest = SHA256.sha256_hex(target_name + "|" + readiness_status + "|" + str(equal_facets) + "|" + str(different_facets) + "|" + str(unknown_facets) + "|" + str(open_unknowns) + "|" + str(verified_obligations));

    return map{
        ok: true,
        format: FORMAT_LEDGER,
        evidence_id: "ev_" + digest,
        target_name: target_name,
        dossier_comparison: map{
            equal_facet_count: equal_facets,
            different_facet_count: different_facets,
            unknown_facet_count: unknown_facets,
            facets: facet_comparison
        },
        ledger_summary: map{
            observation_count: len(observations),
            total_unknowns: len(unknowns),
            open_unknown_count: open_unknowns,
            blocking_unknown_count: blocking_unknowns,
            total_obligations: total_obligations,
            verified_obligation_count: verified_obligations,
            obligation_coverage_pct: obligation_pct,
            readiness_status: readiness_status
        }
    };
}

fn _s8(b) {
    if b >= 128 { return b - 256; }
    return b;
}

fn _s16(bytes, offset) {
    let u = _u16(bytes, offset, true);
    if u >= 32768 { return u - 65536; }
    return u;
}

fn _s32(bytes, offset) {
    let u = _u32(bytes, offset, true);
    if u >= 2147483648 { return u - 4294967296; }
    return u;
}

fn _bits(word, hi, lo) {
    let width = hi - lo + 1;
    let mask = bit_shl(1, width) - 1;
    return bit_and(bit_shr(word, lo), mask);
}

fn _sext(val, width) {
    let sign_bit = bit_shl(1, width - 1);
    if val >= sign_bit {
        return val - bit_shl(1, width);
    }
    return val;
}

fn _slice_hex(bytes, start_idx, count) {
    let out = "";
    let i = 0;
    while i < count and start_idx + i < len(bytes) {
        out = out + _hex_byte(bytes[start_idx + i]);
        i = i + 1;
    }
    return out;
}

fn _coerce_code_bytes(bytes_or_hex) {
    if type(bytes_or_hex) == "string" {
        return _bytes_from_hex(bytes_or_hex, 65536);
    }
    if type(bytes_or_hex) == "array" {
        return _validate_bytes(bytes_or_hex, 65536);
    }
    throw "rea_suite: expected byte array or hex string";
}

// ══════════════════════════════════════════════════════════════════════════════
// 5A. Genuine x86-64 Instruction Decoder (REX, 0x66, ModR/M, SIB, RIP-rel, ALU, Jcc)
// ══════════════════════════════════════════════════════════════════════════════

let _X64_GPR64 = ["rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"];
let _X64_GPR32 = ["eax", "ecx", "edx", "ebx", "esp", "ebp", "esi", "edi", "r8d", "r9d", "r10d", "r11d", "r12d", "r13d", "r14d", "r15d"];
let _X64_GPR16 = ["ax", "cx", "dx", "bx", "sp", "bp", "si", "di", "r8w", "r9w", "r10w", "r11w", "r12w", "r13w", "r14w", "r15w"];
let _X64_GPR8_NOREX = ["al", "cl", "dl", "bl", "ah", "ch", "dh", "bh"];
let _X64_GPR8_REX = ["al", "cl", "dl", "bl", "spl", "bpl", "sil", "dil", "r8b", "r9b", "r10b", "r11b", "r12b", "r13b", "r14b", "r15b"];
let _X64_ALU_OPS = ["add", "or", "adc", "sbb", "and", "sub", "xor", "cmp"];
let _X64_SHIFT_OPS = ["rol", "ror", "rcl", "rcr", "shl", "shr", "sal", "sar"];
let _X64_CC_NAMES = ["o", "no", "b", "ae", "e", "ne", "be", "a", "s", "ns", "p", "np", "l", "ge", "le", "g"];

fn _x64_reg_name(idx, bits, has_rex) {
    let r = bit_and(idx, 15);
    if bits == 64 { return _X64_GPR64[r]; }
    if bits == 32 { return _X64_GPR32[r]; }
    if bits == 16 { return _X64_GPR16[r]; }
    if _is_true(has_rex) { return _X64_GPR8_REX[r]; }
    return _X64_GPR8_NOREX[bit_and(r, 7)];
}

fn _x64_ptr_prefix(bits) {
    if bits == 64 { return "qword ptr "; }
    if bits == 32 { return "dword ptr "; }
    if bits == 16 { return "word ptr "; }
    if bits == 8 { return "byte ptr "; }
    return "";
}

fn _x64_fmt_disp(disp, has_base) {
    if not _is_true(has_base) {
        return str(disp);
    }
    if disp == 0 { return ""; }
    if disp > 0 { return " + " + str(disp); }
    return " - " + str(0 - disp);
}

fn _x64_decode_modrm(bytes, pos, op_bits, has_rex, rex_r, rex_x, rex_b, with_ptr) {
    if pos >= len(bytes) {
        return map{ ok: false, next_pos: pos, reg_idx: 0, reg_str: "eax", rm_str: "?", is_mem: false };
    }
    let modrm = bytes[pos];
    let mod_bits = _bits(modrm, 7, 6);
    let reg_low = _bits(modrm, 5, 3);
    let rm_low = _bits(modrm, 2, 0);
    let reg_idx = reg_low + (if _is_true(rex_r) { 8 } else { 0 });
    let rm_idx = rm_low + (if _is_true(rex_b) { 8 } else { 0 });
    let reg_str = _x64_reg_name(reg_idx, op_bits, has_rex);
    let p = pos + 1;

    if mod_bits == 3 {
        let rm_reg = _x64_reg_name(rm_idx, op_bits, has_rex);
        return map{
            ok: true,
            next_pos: p,
            mod_bits: 3,
            reg_low: reg_low,
            reg_idx: reg_idx,
            rm_idx: rm_idx,
            reg_str: reg_str,
            rm_str: rm_reg,
            is_mem: false
        };
    }

    let pfx = if _is_true(with_ptr) { _x64_ptr_prefix(op_bits) } else { "" };
    let expr = "";
    if mod_bits == 0 and rm_low == 5 {
        if p + 4 > len(bytes) {
            return map{ ok: false, next_pos: len(bytes), reg_idx: reg_idx, reg_str: reg_str, rm_str: "?", is_mem: true };
        }
        let disp_rip = _s32(bytes, p);
        p = p + 4;
        expr = "rip" + _x64_fmt_disp(disp_rip, true);
    } elif rm_low == 4 {
        if p >= len(bytes) {
            return map{ ok: false, next_pos: len(bytes), reg_idx: reg_idx, reg_str: reg_str, rm_str: "?", is_mem: true };
        }
        let sib = bytes[p];
        p = p + 1;
        let scale_pow = _bits(sib, 7, 6);
        let scale = bit_shl(1, scale_pow);
        let idx_low = _bits(sib, 5, 3);
        let base_low = _bits(sib, 2, 0);
        let idx_reg = idx_low + (if _is_true(rex_x) { 8 } else { 0 });
        let base_reg = base_low + (if _is_true(rex_b) { 8 } else { 0 });

        let has_base = not (mod_bits == 0 and base_low == 5);
        let has_index = not (idx_low == 4 and not _is_true(rex_x));
        let disp_val = 0;
        if mod_bits == 0 and base_low == 5 {
            if p + 4 > len(bytes) { return map{ ok: false, next_pos: len(bytes), reg_idx: reg_idx, reg_str: reg_str, rm_str: "?", is_mem: true }; }
            disp_val = _s32(bytes, p);
            p = p + 4;
        } elif mod_bits == 1 {
            if p + 1 > len(bytes) { return map{ ok: false, next_pos: len(bytes), reg_idx: reg_idx, reg_str: reg_str, rm_str: "?", is_mem: true }; }
            disp_val = _s8(bytes[p]);
            p = p + 1;
        } elif mod_bits == 2 {
            if p + 4 > len(bytes) { return map{ ok: false, next_pos: len(bytes), reg_idx: reg_idx, reg_str: reg_str, rm_str: "?", is_mem: true }; }
            disp_val = _s32(bytes, p);
            p = p + 4;
        }

        let terms = [];
        if _is_true(has_base) { push(terms, _X64_GPR64[base_reg]); }
        if _is_true(has_index) {
            let idx_term = _X64_GPR64[idx_reg];
            if scale > 1 { idx_term = idx_term + "*" + str(scale); }
            push(terms, idx_term);
        }
        if len(terms) == 0 {
            expr = str(disp_val);
        } else {
            expr = str_join(terms, " + ") + _x64_fmt_disp(disp_val, true);
        }
    } else {
        let disp2 = 0;
        if mod_bits == 1 {
            if p + 1 > len(bytes) { return map{ ok: false, next_pos: len(bytes), reg_idx: reg_idx, reg_str: reg_str, rm_str: "?", is_mem: true }; }
            disp2 = _s8(bytes[p]);
            p = p + 1;
        } elif mod_bits == 2 {
            if p + 4 > len(bytes) { return map{ ok: false, next_pos: len(bytes), reg_idx: reg_idx, reg_str: reg_str, rm_str: "?", is_mem: true }; }
            disp2 = _s32(bytes, p);
            p = p + 4;
        }
        expr = _X64_GPR64[rm_idx] + _x64_fmt_disp(disp2, true);
    }

    return map{
        ok: true,
        next_pos: p,
        mod_bits: mod_bits,
        reg_low: reg_low,
        reg_idx: reg_idx,
        rm_idx: rm_idx,
        reg_str: reg_str,
        rm_str: pfx + "[" + expr + "]",
        raw_mem_str: "[" + expr + "]",
        is_mem: true
    };
}

fn decode_one_x86_64(bytes, pc, base_addr = 0) {
    let addr = base_addr + pc;
    let n = len(bytes);
    if pc < 0 or pc >= n {
        throw "decode_one_x86_64: pc out of bounds";
    }

    // Fast path for CET ENDBR64 (F3 0F 1E FA)
    if _match_seq(bytes, pc, [243, 15, 30, 250]) {
        return map{
            offset: pc, address: addr, size: 4, bytes_hex: "f30f1efa",
            mnemonic: "endbr64", operands: "", text: "endbr64",
            flow: "sequential", target_offset: -1, target_address: -1,
            is_prologue: true, stack_alloc: 0
        };
    }

    let p = pc;
    let has_66 = false;
    let has_f2 = false;
    let has_f3 = false;
    let scanning_legacy = true;
    while p < n and _is_true(scanning_legacy) {
        let pb = bytes[p];
        if pb == 102 { has_66 = true; p = p + 1; }
        elif pb == 242 { has_f2 = true; p = p + 1; }
        elif pb == 243 { has_f3 = true; p = p + 1; }
        else { scanning_legacy = false; }
    }

    let has_rex = false;
    let rex_w = false;
    let rex_r = false;
    let rex_x = false;
    let rex_b = false;
    if p < n and bytes[p] >= 64 and bytes[p] <= 79 {
        let rex = bytes[p];
        has_rex = true;
        rex_w = _bits(rex, 3, 3) == 1;
        rex_r = _bits(rex, 2, 2) == 1;
        rex_x = _bits(rex, 1, 1) == 1;
        rex_b = _bits(rex, 0, 0) == 1;
        p = p + 1;
    }

    if p >= n {
        let raw_b = bytes[pc];
        return map{
            offset: pc, address: addr, size: 1, bytes_hex: _hex_byte(raw_b),
            mnemonic: "db", operands: "0x" + _hex_byte(raw_b), text: "db 0x" + _hex_byte(raw_b),
            flow: "sequential", target_offset: -1, target_address: -1,
            is_prologue: false, stack_alloc: 0
        };
    }

    let op_bits = if _is_true(rex_w) { 64 } elif _is_true(has_66) { 16 } else { 32 };
    let op = bytes[p];
    p = p + 1;

    let mnem = "db";
    let ops = "0x" + _hex_byte(bytes[pc]);
    let flow = "sequential";
    let target_off = -1;
    let is_prologue = false;
    let stack_alloc = 0;
    let decoded = false;

    // 1. Two-byte 0x0F opcode map
    if op == 15 and p < n {
        let op2 = bytes[p];
        p = p + 1;
        if op2 == 5 {
            mnem = "syscall"; ops = ""; flow = "syscall"; decoded = true;
        } elif op2 == 11 {
            mnem = "ud2"; ops = ""; flow = "trap"; decoded = true;
        } elif op2 == 31 {
            let m_nop = _x64_decode_modrm(bytes, p, op_bits, has_rex, rex_r, rex_x, rex_b, true);
            if _is_true(m_nop.ok) { p = m_nop.next_pos; mnem = "nop"; ops = m_nop.rm_str; decoded = true; }
        } elif op2 >= 128 and op2 <= 143 and p + 4 <= n {
            let rel32_cc = _s32(bytes, p);
            p = p + 4;
            target_off = (p - pc) + pc + rel32_cc;
            mnem = "j" + _X64_CC_NAMES[op2 - 128];
            ops = "loc_" + str(base_addr + target_off);
            flow = "cond_jump";
            decoded = true;
        } elif op2 >= 144 and op2 <= 159 {
            let m_set = _x64_decode_modrm(bytes, p, 8, has_rex, rex_r, rex_x, rex_b, true);
            if _is_true(m_set.ok) {
                p = m_set.next_pos;
                mnem = "set" + _X64_CC_NAMES[op2 - 144];
                ops = m_set.rm_str;
                decoded = true;
            }
        } elif op2 >= 64 and op2 <= 79 {
            let m_cmov = _x64_decode_modrm(bytes, p, op_bits, has_rex, rex_r, rex_x, rex_b, true);
            if _is_true(m_cmov.ok) {
                p = m_cmov.next_pos;
                mnem = "cmov" + _X64_CC_NAMES[op2 - 64];
                ops = m_cmov.reg_str + ", " + m_cmov.rm_str;
                decoded = true;
            }
        } elif op2 == 175 {
            let m_imul = _x64_decode_modrm(bytes, p, op_bits, has_rex, rex_r, rex_x, rex_b, true);
            if _is_true(m_imul.ok) {
                p = m_imul.next_pos;
                mnem = "imul";
                ops = m_imul.reg_str + ", " + m_imul.rm_str;
                decoded = true;
            }
        } elif op2 == 182 or op2 == 190 {
            let m_zx8 = _x64_decode_modrm(bytes, p, 8, has_rex, rex_r, rex_x, rex_b, true);
            if _is_true(m_zx8.ok) {
                p = m_zx8.next_pos;
                mnem = if op2 == 182 { "movzx" } else { "movsx" };
                ops = _x64_reg_name(m_zx8.reg_idx, op_bits, has_rex) + ", " + m_zx8.rm_str;
                decoded = true;
            }
        } elif op2 == 183 or op2 == 191 {
            let m_zx16 = _x64_decode_modrm(bytes, p, 16, has_rex, rex_r, rex_x, rex_b, true);
            if _is_true(m_zx16.ok) {
                p = m_zx16.next_pos;
                mnem = if op2 == 183 { "movzx" } else { "movsx" };
                ops = _x64_reg_name(m_zx16.reg_idx, op_bits, has_rex) + ", " + m_zx16.rm_str;
                decoded = true;
            }
        }
    }
    // 2. Standard ALU Matrix 0x00..0x3D (add, or, adc, sbb, and, sub, xor, cmp)
    elif op < 64 and bit_and(op, 7) < 6 {
        let alu_mnem = _X64_ALU_OPS[bit_shr(op, 3)];
        let sub_kind = bit_and(op, 7);
        if sub_kind == 0 {
            let m0 = _x64_decode_modrm(bytes, p, 8, has_rex, rex_r, rex_x, rex_b, true);
            if _is_true(m0.ok) { p = m0.next_pos; mnem = alu_mnem; ops = m0.rm_str + ", " + m0.reg_str; decoded = true; }
        } elif sub_kind == 1 {
            let m1 = _x64_decode_modrm(bytes, p, op_bits, has_rex, rex_r, rex_x, rex_b, true);
            if _is_true(m1.ok) { p = m1.next_pos; mnem = alu_mnem; ops = m1.rm_str + ", " + m1.reg_str; decoded = true; }
        } elif sub_kind == 2 {
            let m2 = _x64_decode_modrm(bytes, p, 8, has_rex, rex_r, rex_x, rex_b, true);
            if _is_true(m2.ok) { p = m2.next_pos; mnem = alu_mnem; ops = m2.reg_str + ", " + m2.rm_str; decoded = true; }
        } elif sub_kind == 3 {
            let m3 = _x64_decode_modrm(bytes, p, op_bits, has_rex, rex_r, rex_x, rex_b, true);
            if _is_true(m3.ok) { p = m3.next_pos; mnem = alu_mnem; ops = m3.reg_str + ", " + m3.rm_str; decoded = true; }
        } elif sub_kind == 4 and p + 1 <= n {
            let imm8_a = bytes[p];
            p = p + 1;
            mnem = alu_mnem;
            ops = "al, " + str(imm8_a);
            decoded = true;
        } elif sub_kind == 5 {
            if op_bits == 16 and p + 2 <= n {
                let imm16_a = _s16(bytes, p);
                p = p + 2;
                mnem = alu_mnem; ops = "ax, " + str(imm16_a); decoded = true;
            } elif op_bits != 16 and p + 4 <= n {
                let imm32_a = _s32(bytes, p);
                p = p + 4;
                mnem = alu_mnem;
                ops = _x64_reg_name(0, op_bits, has_rex) + ", " + str(imm32_a);
                decoded = true;
            }
        }
    }
    // 3. PUSH / POP r64 (0x50..0x5F)
    elif op >= 80 and op <= 87 {
        let preg = (op - 80) + (if _is_true(rex_b) { 8 } else { 0 });
        let pbits = if _is_true(has_66) and not _is_true(rex_w) { 16 } else { 64 };
        mnem = "push";
        ops = _x64_reg_name(preg, pbits, has_rex);
        if preg == 5 and pbits == 64 { is_prologue = true; }
        decoded = true;
    } elif op >= 88 and op <= 95 {
        let popreg = (op - 88) + (if _is_true(rex_b) { 8 } else { 0 });
        let popbits = if _is_true(has_66) and not _is_true(rex_w) { 16 } else { 64 };
        mnem = "pop";
        ops = _x64_reg_name(popreg, popbits, has_rex);
        decoded = true;
    }
    // 4. MOVSXD (0x63), PUSH imm (0x68, 0x6A), IMUL imm (0x69, 0x6B)
    elif op == 99 {
        let m_sxd = _x64_decode_modrm(bytes, p, 32, has_rex, rex_r, rex_x, rex_b, true);
        if _is_true(m_sxd.ok) {
            p = m_sxd.next_pos;
            mnem = "movsxd";
            ops = _x64_reg_name(m_sxd.reg_idx, op_bits, has_rex) + ", " + m_sxd.rm_str;
            decoded = true;
        }
    } elif op == 104 and p + 4 <= n {
        let pimm32 = _s32(bytes, p);
        p = p + 4;
        mnem = "push"; ops = str(pimm32); decoded = true;
    } elif op == 106 and p + 1 <= n {
        let pimm8 = _s8(bytes[p]);
        p = p + 1;
        mnem = "push"; ops = str(pimm8); decoded = true;
    } elif op == 105 {
        let m_im32 = _x64_decode_modrm(bytes, p, op_bits, has_rex, rex_r, rex_x, rex_b, true);
        if _is_true(m_im32.ok) and m_im32.next_pos + 4 <= n {
            let imv32 = _s32(bytes, m_im32.next_pos);
            p = m_im32.next_pos + 4;
            mnem = "imul"; ops = m_im32.reg_str + ", " + m_im32.rm_str + ", " + str(imv32); decoded = true;
        }
    } elif op == 107 {
        let m_im8 = _x64_decode_modrm(bytes, p, op_bits, has_rex, rex_r, rex_x, rex_b, true);
        if _is_true(m_im8.ok) and m_im8.next_pos + 1 <= n {
            let imv8 = _s8(bytes[m_im8.next_pos]);
            p = m_im8.next_pos + 1;
            mnem = "imul"; ops = m_im8.reg_str + ", " + m_im8.rm_str + ", " + str(imv8); decoded = true;
        }
    }
    // 5. Short conditional jumps 0x70..0x7F
    elif op >= 112 and op <= 127 and p + 1 <= n {
        let rel8_cc = _s8(bytes[p]);
        p = p + 1;
        target_off = p + rel8_cc;
        mnem = "j" + _X64_CC_NAMES[op - 112];
        ops = "loc_" + str(base_addr + target_off);
        flow = "cond_jump";
        decoded = true;
    }
    // 6. Immediate ALU Group 1 (0x80, 0x81, 0x83)
    elif op == 128 or op == 129 or op == 131 {
        let g1_bits = if op == 128 { 8 } else { op_bits };
        let m_g1 = _x64_decode_modrm(bytes, p, g1_bits, has_rex, rex_r, rex_x, rex_b, true);
        if _is_true(m_g1.ok) {
            let g1_op = _X64_ALU_OPS[m_g1.reg_low];
            if op == 128 and m_g1.next_pos + 1 <= n {
                let imm_g8 = bytes[m_g1.next_pos];
                p = m_g1.next_pos + 1;
                mnem = g1_op; ops = m_g1.rm_str + ", " + str(imm_g8); decoded = true;
            } elif op == 131 and m_g1.next_pos + 1 <= n {
                let imm_s8 = _s8(bytes[m_g1.next_pos]);
                p = m_g1.next_pos + 1;
                mnem = g1_op; ops = m_g1.rm_str + ", " + str(imm_s8); decoded = true;
                if g1_op == "sub" and m_g1.mod_bits == 3 and m_g1.rm_idx == 4 and imm_s8 > 0 {
                    stack_alloc = imm_s8;
                }
            } elif op == 129 {
                if g1_bits == 16 and m_g1.next_pos + 2 <= n {
                    let imm_g16 = _s16(bytes, m_g1.next_pos);
                    p = m_g1.next_pos + 2;
                    mnem = g1_op; ops = m_g1.rm_str + ", " + str(imm_g16); decoded = true;
                } elif g1_bits != 16 and m_g1.next_pos + 4 <= n {
                    let imm_g32 = _s32(bytes, m_g1.next_pos);
                    p = m_g1.next_pos + 4;
                    mnem = g1_op; ops = m_g1.rm_str + ", " + str(imm_g32); decoded = true;
                    if g1_op == "sub" and m_g1.mod_bits == 3 and m_g1.rm_idx == 4 and imm_g32 > 0 {
                        stack_alloc = imm_g32;
                    }
                }
            }
        }
    }
    // 7. TEST (0x84, 0x85), XCHG (0x86, 0x87), MOV (0x88..0x8B), LEA (0x8D)
    elif op == 132 or op == 133 {
        let tbits = if op == 132 { 8 } else { op_bits };
        let m_tst = _x64_decode_modrm(bytes, p, tbits, has_rex, rex_r, rex_x, rex_b, true);
        if _is_true(m_tst.ok) {
            p = m_tst.next_pos;
            mnem = "test"; ops = m_tst.rm_str + ", " + m_tst.reg_str; decoded = true;
        }
    } elif op == 134 or op == 135 {
        let xbits = if op == 134 { 8 } else { op_bits };
        let m_xch = _x64_decode_modrm(bytes, p, xbits, has_rex, rex_r, rex_x, rex_b, true);
        if _is_true(m_xch.ok) {
            p = m_xch.next_pos;
            mnem = "xchg"; ops = m_xch.rm_str + ", " + m_xch.reg_str; decoded = true;
        }
    } elif op >= 136 and op <= 139 {
        let mvbits = if op == 136 or op == 138 { 8 } else { op_bits };
        let m_mv = _x64_decode_modrm(bytes, p, mvbits, has_rex, rex_r, rex_x, rex_b, true);
        if _is_true(m_mv.ok) {
            p = m_mv.next_pos;
            mnem = "mov";
            if op == 136 or op == 137 {
                ops = m_mv.rm_str + ", " + m_mv.reg_str;
                if op == 137 and _is_true(rex_w) and m_mv.mod_bits == 3 and m_mv.rm_idx == 5 and m_mv.reg_idx == 4 {
                    is_prologue = true;
                }
            } else {
                ops = m_mv.reg_str + ", " + m_mv.rm_str;
            }
            decoded = true;
        }
    } elif op == 141 {
        let m_lea = _x64_decode_modrm(bytes, p, op_bits, has_rex, rex_r, rex_x, rex_b, false);
        if _is_true(m_lea.ok) {
            p = m_lea.next_pos;
            mnem = "lea"; ops = m_lea.reg_str + ", " + m_lea.rm_str; decoded = true;
        }
    }
    // 8. NOP (0x90), CDQ/CQO (0x99), TEST imm (0xA8, 0xA9)
    elif op == 144 {
        if _is_true(rex_b) {
            mnem = "xchg";
            ops = _x64_reg_name(0, op_bits, has_rex) + ", " + _x64_reg_name(8, op_bits, has_rex);
        } else {
            mnem = "nop"; ops = "";
        }
        decoded = true;
    } elif op == 153 {
        mnem = if _is_true(rex_w) { "cqo" } else { "cdq" };
        ops = ""; decoded = true;
    } elif op == 168 and p + 1 <= n {
        mnem = "test"; ops = "al, " + str(bytes[p]); p = p + 1; decoded = true;
    } elif op == 169 and p + 4 <= n {
        mnem = "test"; ops = _x64_reg_name(0, op_bits, has_rex) + ", " + str(_s32(bytes, p)); p = p + 4; decoded = true;
    }
    // 9. MOV reg, imm (0xB0..0xBF) & MOV r/m, imm (0xC6, 0xC7)
    elif op >= 176 and op <= 183 and p + 1 <= n {
        let r8_i = (op - 176) + (if _is_true(rex_b) { 8 } else { 0 });
        mnem = "mov"; ops = _x64_reg_name(r8_i, 8, has_rex) + ", " + str(bytes[p]);
        p = p + 1; decoded = true;
    } elif op >= 184 and op <= 191 {
        let r_i = (op - 184) + (if _is_true(rex_b) { 8 } else { 0 });
        if _is_true(rex_w) and p + 8 <= n {
            let lo32 = _u32(bytes, p, true);
            let hi32 = _u32(bytes, p + 4, true);
            p = p + 8;
            mnem = "movabs";
            if hi32 == 0 {
                ops = _X64_GPR64[r_i] + ", " + str(lo32);
            } else {
                ops = _X64_GPR64[r_i] + ", 0x" + _slice_hex([
                    bit_and(bit_shr(hi32, 24), 255), bit_and(bit_shr(hi32, 16), 255),
                    bit_and(bit_shr(hi32, 8), 255), bit_and(hi32, 255),
                    bit_and(bit_shr(lo32, 24), 255), bit_and(bit_shr(lo32, 16), 255),
                    bit_and(bit_shr(lo32, 8), 255), bit_and(lo32, 255)
                ], 0, 8);
            }
            decoded = true;
        } elif op_bits == 16 and p + 2 <= n {
            mnem = "mov"; ops = _X64_GPR16[r_i] + ", " + str(_u16(bytes, p, true));
            p = p + 2; decoded = true;
        } elif op_bits == 32 and p + 4 <= n {
            mnem = "mov"; ops = _X64_GPR32[r_i] + ", " + str(_u32(bytes, p, true));
            p = p + 4; decoded = true;
        }
    } elif op == 198 or op == 199 {
        let cbits = if op == 198 { 8 } else { op_bits };
        let m_c = _x64_decode_modrm(bytes, p, cbits, has_rex, rex_r, rex_x, rex_b, true);
        if _is_true(m_c.ok) and m_c.reg_low == 0 {
            if op == 198 and m_c.next_pos + 1 <= n {
                mnem = "mov"; ops = m_c.rm_str + ", " + str(bytes[m_c.next_pos]);
                p = m_c.next_pos + 1; decoded = true;
            } elif op == 199 and cbits == 16 and m_c.next_pos + 2 <= n {
                mnem = "mov"; ops = m_c.rm_str + ", " + str(_s16(bytes, m_c.next_pos));
                p = m_c.next_pos + 2; decoded = true;
            } elif op == 199 and cbits != 16 and m_c.next_pos + 4 <= n {
                mnem = "mov"; ops = m_c.rm_str + ", " + str(_s32(bytes, m_c.next_pos));
                p = m_c.next_pos + 4; decoded = true;
            }
        }
    }
    // 10. Shifts Group 2 (0xC0, 0xC1, 0xD0, 0xD1, 0xD2, 0xD3)
    elif op == 192 or op == 193 or (op >= 208 and op <= 211) {
        let sbits = if op == 192 or op == 208 or op == 210 { 8 } else { op_bits };
        let m_sh = _x64_decode_modrm(bytes, p, sbits, has_rex, rex_r, rex_x, rex_b, true);
        if _is_true(m_sh.ok) {
            let sh_mnem = _X64_SHIFT_OPS[m_sh.reg_low];
            if (op == 192 or op == 193) and m_sh.next_pos + 1 <= n {
                mnem = sh_mnem; ops = m_sh.rm_str + ", " + str(bytes[m_sh.next_pos]);
                p = m_sh.next_pos + 1; decoded = true;
            } elif op == 208 or op == 209 {
                mnem = sh_mnem; ops = m_sh.rm_str + ", 1";
                p = m_sh.next_pos; decoded = true;
            } elif op == 210 or op == 211 {
                mnem = sh_mnem; ops = m_sh.rm_str + ", cl";
                p = m_sh.next_pos; decoded = true;
            }
        }
    }
    // 11. RET / LEAVE / CALL / JMP
    elif op == 194 and p + 2 <= n {
        mnem = "ret"; ops = str(_u16(bytes, p, true)); p = p + 2; flow = "return"; decoded = true;
    } elif op == 195 {
        mnem = "ret"; ops = ""; flow = "return"; decoded = true;
    } elif op == 201 {
        mnem = "leave"; ops = ""; decoded = true;
    } elif op == 232 and p + 4 <= n {
        let rel_call = _s32(bytes, p);
        p = p + 4;
        target_off = p + rel_call;
        mnem = "call"; ops = "sub_" + str(base_addr + target_off); flow = "call"; decoded = true;
    } elif op == 233 and p + 4 <= n {
        let rel_jmp = _s32(bytes, p);
        p = p + 4;
        target_off = p + rel_jmp;
        mnem = "jmp"; ops = "loc_" + str(base_addr + target_off); flow = "jump"; decoded = true;
    } elif op == 235 and p + 1 <= n {
        let rel_j8 = _s8(bytes[p]);
        p = p + 1;
        target_off = p + rel_j8;
        mnem = "jmp"; ops = "loc_" + str(base_addr + target_off); flow = "jump"; decoded = true;
    }
    // 12. Unary Group 3 (0xF6, 0xF7: test/not/neg/mul/imul/div/idiv) & Group 4/5 (0xFE, 0xFF)
    elif op == 246 or op == 247 {
        let g3bits = if op == 246 { 8 } else { op_bits };
        let m_g3 = _x64_decode_modrm(bytes, p, g3bits, has_rex, rex_r, rex_x, rex_b, true);
        if _is_true(m_g3.ok) {
            let g3_sub = m_g3.reg_low;
            if g3_sub == 0 or g3_sub == 1 {
                if op == 246 and m_g3.next_pos + 1 <= n {
                    mnem = "test"; ops = m_g3.rm_str + ", " + str(bytes[m_g3.next_pos]);
                    p = m_g3.next_pos + 1; decoded = true;
                } elif op == 247 and g3bits == 16 and m_g3.next_pos + 2 <= n {
                    mnem = "test"; ops = m_g3.rm_str + ", " + str(_s16(bytes, m_g3.next_pos));
                    p = m_g3.next_pos + 2; decoded = true;
                } elif op == 247 and g3bits != 16 and m_g3.next_pos + 4 <= n {
                    mnem = "test"; ops = m_g3.rm_str + ", " + str(_s32(bytes, m_g3.next_pos));
                    p = m_g3.next_pos + 4; decoded = true;
                }
            } else {
                let g3_names = ["test", "test", "not", "neg", "mul", "imul", "div", "idiv"];
                mnem = g3_names[g3_sub];
                ops = m_g3.rm_str;
                p = m_g3.next_pos;
                decoded = true;
            }
        }
    } elif op == 254 or op == 255 {
        let g5bits = if op == 254 { 8 } else { op_bits };
        let m_g5 = _x64_decode_modrm(bytes, p, g5bits, has_rex, rex_r, rex_x, rex_b, true);
        if _is_true(m_g5.ok) {
            let g5_sub = m_g5.reg_low;
            if g5_sub == 0 {
                mnem = "inc"; ops = m_g5.rm_str; p = m_g5.next_pos; decoded = true;
            } elif g5_sub == 1 {
                mnem = "dec"; ops = m_g5.rm_str; p = m_g5.next_pos; decoded = true;
            } elif op == 255 and g5_sub == 2 {
                let m_indc = _x64_decode_modrm(bytes, p, 64, has_rex, rex_r, rex_x, rex_b, true);
                mnem = "call"; ops = m_indc.rm_str; p = m_indc.next_pos; flow = "call"; decoded = true;
            } elif op == 255 and g5_sub == 4 {
                let m_indj = _x64_decode_modrm(bytes, p, 64, has_rex, rex_r, rex_x, rex_b, true);
                mnem = "jmp"; ops = m_indj.rm_str; p = m_indj.next_pos; flow = "jump"; decoded = true;
            } elif op == 255 and g5_sub == 6 {
                let m_indp = _x64_decode_modrm(bytes, p, 64, has_rex, rex_r, rex_x, rex_b, true);
                mnem = "push"; ops = m_indp.rm_str; p = m_indp.next_pos; decoded = true;
            }
        }
    }

    if not _is_true(decoded) {
        p = pc + 1;
        mnem = "db";
        ops = "0x" + _hex_byte(bytes[pc]);
    }

    let sz = p - pc;
    let tgt_addr = if target_off >= 0 { base_addr + target_off } else { -1 };
    let text_str = if ops == "" { mnem } else { mnem + " " + ops };
    return map{
        offset: pc,
        address: addr,
        size: sz,
        bytes_hex: _slice_hex(bytes, pc, sz),
        mnemonic: mnem,
        operands: ops,
        text: text_str,
        flow: flow,
        target_offset: target_off,
        target_address: tgt_addr,
        is_prologue: is_prologue,
        stack_alloc: stack_alloc
    };
}

fn disassemble_x86_64(bytes_or_hex, base_addr = 0) {
    let bytes = _coerce_code_bytes(bytes_or_hex);
    let out = [];
    let pc = 0;
    while pc < len(bytes) and len(out) < 2048 {
        let ins = decode_one_x86_64(bytes, pc, base_addr);
        push(out, ins);
        pc = pc + ins.size;
    }
    return out;
}

// ══════════════════════════════════════════════════════════════════════════════
// 5B. Genuine ARM64 / A64 32-Bit Little-Endian Instruction Decoder
// ══════════════════════════════════════════════════════════════════════════════

let _A64_COND_NAMES = ["eq", "ne", "cs", "cc", "mi", "pl", "vs", "vc", "hi", "ls", "ge", "lt", "gt", "le", "al", "nv"];
let _A64_SHIFT_NAMES = ["lsl", "lsr", "asr", "ror"];

fn _a64_reg(idx, sf, allow_sp) {
    let r = bit_and(idx, 31);
    if r == 31 {
        if _is_true(allow_sp) {
            return if sf == 1 { "sp" } else { "wsp" };
        }
        return if sf == 1 { "xzr" } else { "wzr" };
    }
    return (if sf == 1 { "x" } else { "w" }) + str(r);
}

fn decode_one_arm64(bytes, pc, base_addr = 0) {
    let addr = base_addr + pc;
    if pc + 4 > len(bytes) {
        let b0 = bytes[pc];
        return map{
            offset: pc, address: addr, size: 1, bytes_hex: _hex_byte(b0),
            mnemonic: "db", operands: "0x" + _hex_byte(b0), text: "db 0x" + _hex_byte(b0),
            flow: "sequential", target_offset: -1, target_address: -1,
            is_prologue: false, stack_alloc: 0
        };
    }

    let w = _u32(bytes, pc, true);
    let mnem = ".word";
    let ops = "0x" + _slice_hex(bytes, pc, 4);
    let flow = "sequential";
    let target_off = -1;
    let is_prologue = false;
    let stack_alloc = 0;

    // 1. NOP, RET, BLR, BR, SVC
    if w == 3573751839 { // 0xD503201F
        mnem = "nop"; ops = "";
    } elif bit_and(w, 4294966303) == 3596550144 { // (w & 0xFFFFFC1F) == 0xD65F0000
        let rn_ret = _bits(w, 9, 5);
        mnem = "ret";
        ops = "x" + str(rn_ret);
        flow = "return";
    } elif bit_and(w, 4294966303) == 3594452992 { // 0xD63F0000 BLR
        let rn_blr = _bits(w, 9, 5);
        mnem = "blr"; ops = "x" + str(rn_blr); flow = "call";
    } elif bit_and(w, 4294966303) == 3592355840 { // 0xD61F0000 BR
        let rn_br = _bits(w, 9, 5);
        mnem = "br"; ops = "x" + str(rn_br); flow = "jump";
    } elif bit_and(w, 4292870175) == 3556769793 { // (w & 0xFFE0001F) == 0xD4000001 SVC
        let svc_imm = _bits(w, 20, 5);
        mnem = "svc"; ops = "#" + str(svc_imm); flow = "syscall";
    }
    // 2. B / BL (bits[30:26] == 0b00101 == 5)
    elif _bits(w, 30, 26) == 5 {
        let is_bl = _bits(w, 31, 31) == 1;
        let imm26 = _sext(_bits(w, 25, 0), 26) * 4;
        target_off = pc + imm26;
        if _is_true(is_bl) {
            mnem = "bl"; ops = "sub_" + str(base_addr + target_off); flow = "call";
        } else {
            mnem = "b"; ops = "loc_" + str(base_addr + target_off); flow = "jump";
        }
    }
    // 3. B.cond (bits[31:24] == 0x54 == 84, bit[4] == 0)
    elif _bits(w, 31, 24) == 84 and _bits(w, 4, 4) == 0 {
        let cond_c = _bits(w, 3, 0);
        let imm19_b = _sext(_bits(w, 23, 5), 19) * 4;
        target_off = pc + imm19_b;
        mnem = "b." + _A64_COND_NAMES[cond_c];
        ops = "loc_" + str(base_addr + target_off);
        flow = "cond_jump";
    }
    // 4. CBZ / CBNZ (bits[30:25] == 0b011010 == 26)
    elif _bits(w, 30, 25) == 26 {
        let sf_cb = _bits(w, 31, 31);
        let op_cb = _bits(w, 24, 24);
        let imm19_cb = _sext(_bits(w, 23, 5), 19) * 4;
        let rt_cb = _bits(w, 4, 0);
        target_off = pc + imm19_cb;
        mnem = if op_cb == 0 { "cbz" } else { "cbnz" };
        ops = _a64_reg(rt_cb, sf_cb, false) + ", loc_" + str(base_addr + target_off);
        flow = "cond_jump";
    }
    // 5. MOVN / MOVZ / MOVK (bits[28:23] == 0b100101 == 37)
    elif _bits(w, 28, 23) == 37 {
        let sf_mw = _bits(w, 31, 31);
        let opc_mw = _bits(w, 30, 29);
        let hw_mw = _bits(w, 22, 21);
        let imm16_mw = _bits(w, 20, 5);
        let rd_mw = _bits(w, 4, 0);
        if opc_mw == 0 { mnem = "movn"; }
        elif opc_mw == 2 { mnem = "movz"; }
        elif opc_mw == 3 { mnem = "movk"; }
        if mnem != ".word" {
            let sh_amt = hw_mw * 16;
            ops = _a64_reg(rd_mw, sf_mw, false) + ", #" + str(imm16_mw);
            if sh_amt > 0 { ops = ops + ", lsl #" + str(sh_amt); }
        }
    }
    // 6. ADR / ADRP (bits[28:24] == 0b10000 == 16)
    elif _bits(w, 28, 24) == 16 {
        let is_adrp = _bits(w, 31, 31) == 1;
        let immlo = _bits(w, 30, 29);
        let immhi = _bits(w, 23, 5);
        let imm21 = _sext(bit_shl(immhi, 2) + immlo, 21);
        let rd_adr = _bits(w, 4, 0);
        mnem = if _is_true(is_adrp) { "adrp" } else { "adr" };
        let scale_adr = if _is_true(is_adrp) { imm21 * 4096 } else { imm21 };
        ops = _a64_reg(rd_adr, 1, false) + ", #" + str(scale_adr);
    }
    // 7. ADD / ADDS / SUB / SUBS / CMP (Immediate: bits[28:23] == 0b100010 == 34)
    elif _bits(w, 28, 23) == 34 {
        let sf_ai = _bits(w, 31, 31);
        let op_ai = _bits(w, 30, 30);
        let s_ai = _bits(w, 29, 29);
        let sh_ai = _bits(w, 22, 22);
        let imm12_ai = _bits(w, 21, 10);
        let rn_ai = _bits(w, 9, 5);
        let rd_ai = _bits(w, 4, 0);
        let val_ai = if sh_ai == 1 { imm12_ai * 4096 } else { imm12_ai };
        if op_ai == 1 and s_ai == 1 and rd_ai == 31 {
            mnem = "cmp";
            ops = _a64_reg(rn_ai, sf_ai, true) + ", #" + str(val_ai);
        } elif op_ai == 0 and s_ai == 1 and rd_ai == 31 {
            mnem = "cmn";
            ops = _a64_reg(rn_ai, sf_ai, true) + ", #" + str(val_ai);
        } else {
            let ai_names = ["add", "adds", "sub", "subs"];
            mnem = ai_names[op_ai * 2 + s_ai];
            let rd_allow_sp = (s_ai == 0);
            ops = _a64_reg(rd_ai, sf_ai, rd_allow_sp) + ", " + _a64_reg(rn_ai, sf_ai, true) + ", #" + str(val_ai);
            if mnem == "sub" and sf_ai == 1 and rd_ai == 31 and rn_ai == 31 and val_ai > 0 {
                stack_alloc = val_ai;
                is_prologue = true;
            }
        }
    }
    // 8. ADD / ADDS / SUB / SUBS / CMP (Shifted Register: bits[28:24] == 11, bit[21] == 0)
    elif _bits(w, 28, 24) == 11 and _bits(w, 21, 21) == 0 {
        let sf_ar = _bits(w, 31, 31);
        let op_ar = _bits(w, 30, 30);
        let s_ar = _bits(w, 29, 29);
        let sh_type = _bits(w, 23, 22);
        let rm_ar = _bits(w, 20, 16);
        let imm6_ar = _bits(w, 15, 10);
        let rn_ar = _bits(w, 9, 5);
        let rd_ar = _bits(w, 4, 0);
        let sh_suffix = if imm6_ar > 0 { ", " + _A64_SHIFT_NAMES[sh_type] + " #" + str(imm6_ar) } else { "" };
        if op_ar == 1 and s_ar == 1 and rd_ar == 31 {
            mnem = "cmp";
            ops = _a64_reg(rn_ar, sf_ar, false) + ", " + _a64_reg(rm_ar, sf_ar, false) + sh_suffix;
        } else {
            let ar_names = ["add", "adds", "sub", "subs"];
            mnem = ar_names[op_ar * 2 + s_ar];
            ops = _a64_reg(rd_ar, sf_ar, false) + ", " + _a64_reg(rn_ar, sf_ar, false) + ", " + _a64_reg(rm_ar, sf_ar, false) + sh_suffix;
        }
    }
    // 9. Logical Shifted Register (AND / ORR / MOV / EOR / ANDS / TST: bits[28:24] == 10)
    elif _bits(w, 28, 24) == 10 {
        let sf_lg = _bits(w, 31, 31);
        let opc_lg = _bits(w, 30, 29);
        let n_lg = _bits(w, 21, 21);
        let rm_lg = _bits(w, 20, 16);
        let imm6_lg = _bits(w, 15, 10);
        let rn_lg = _bits(w, 9, 5);
        let rd_lg = _bits(w, 4, 0);
        if opc_lg == 1 and n_lg == 0 and rn_lg == 31 and imm6_lg == 0 {
            mnem = "mov";
            ops = _a64_reg(rd_lg, sf_lg, false) + ", " + _a64_reg(rm_lg, sf_lg, false);
        } elif opc_lg == 3 and n_lg == 0 and rd_lg == 31 and imm6_lg == 0 {
            mnem = "tst";
            ops = _a64_reg(rn_lg, sf_lg, false) + ", " + _a64_reg(rm_lg, sf_lg, false);
        } else {
            let lg_names = ["and", "orr", "eor", "ands"];
            mnem = lg_names[opc_lg];
            ops = _a64_reg(rd_lg, sf_lg, false) + ", " + _a64_reg(rn_lg, sf_lg, false) + ", " + _a64_reg(rm_lg, sf_lg, false);
        }
    }
    // 10. MADD / MSUB / MUL (bits[28:21] == 0b11011000 == 216)
    elif _bits(w, 28, 21) == 216 {
        let sf_m = _bits(w, 31, 31);
        let rm_m = _bits(w, 20, 16);
        let o0_m = _bits(w, 15, 15);
        let ra_m = _bits(w, 14, 10);
        let rn_m = _bits(w, 9, 5);
        let rd_m = _bits(w, 4, 0);
        if o0_m == 0 and ra_m == 31 {
            mnem = "mul";
            ops = _a64_reg(rd_m, sf_m, false) + ", " + _a64_reg(rn_m, sf_m, false) + ", " + _a64_reg(rm_m, sf_m, false);
        } else {
            mnem = if o0_m == 0 { "madd" } else { "msub" };
            ops = _a64_reg(rd_m, sf_m, false) + ", " + _a64_reg(rn_m, sf_m, false) + ", " + _a64_reg(rm_m, sf_m, false) + ", " + _a64_reg(ra_m, sf_m, false);
        }
    }
    // 11. STP / LDP (bits[29:27] == 5, bit[26] == 0)
    elif _bits(w, 29, 27) == 5 and _bits(w, 26, 26) == 0 {
        let opc_p = _bits(w, 31, 30);
        let mode_p = _bits(w, 25, 23);
        let l_p = _bits(w, 22, 22);
        let imm7_p = _sext(_bits(w, 21, 15), 7);
        let rt2_p = _bits(w, 14, 10);
        let rn_p = _bits(w, 9, 5);
        let rt1_p = _bits(w, 4, 0);
        let sf_p = if opc_p >= 2 { 1 } else { 0 };
        let scale_p = if sf_p == 1 { 8 } else { 4 };
        let disp_p = imm7_p * scale_p;
        mnem = if l_p == 0 { "stp" } else { "ldp" };
        let r1s = _a64_reg(rt1_p, sf_p, false);
        let r2s = _a64_reg(rt2_p, sf_p, false);
        let bs = _a64_reg(rn_p, 1, true);
        if mode_p == 3 {
            ops = r1s + ", " + r2s + ", [" + bs + ", #" + str(disp_p) + "]!";
            if l_p == 0 and rn_p == 31 and disp_p < 0 {
                is_prologue = true;
                stack_alloc = 0 - disp_p;
            }
        } elif mode_p == 1 {
            ops = r1s + ", " + r2s + ", [" + bs + "], #" + str(disp_p);
        } else {
            if disp_p == 0 {
                ops = r1s + ", " + r2s + ", [" + bs + "]";
            } else {
                ops = r1s + ", " + r2s + ", [" + bs + ", #" + str(disp_p) + "]";
            }
        }
    }
    // 12. LDR / STR / LDRB / STRB / LDRH / STRH (bits[29:27] == 7, bit[26] == 0)
    elif _bits(w, 29, 27) == 7 and _bits(w, 26, 26) == 0 {
        let sz_ls = _bits(w, 31, 30);
        let mode_ls = _bits(w, 25, 24);
        let opc_ls = _bits(w, 23, 22);
        let rn_ls = _bits(w, 9, 5);
        let rt_ls = _bits(w, 4, 0);
        let sf_ls = if sz_ls == 3 { 1 } else { 0 };
        let ls_mnem = "";
        if opc_ls == 0 {
            if sz_ls == 0 { ls_mnem = "strb"; }
            elif sz_ls == 1 { ls_mnem = "strh"; }
            else { ls_mnem = "str"; }
        } elif opc_ls == 1 {
            if sz_ls == 0 { ls_mnem = "ldrb"; }
            elif sz_ls == 1 { ls_mnem = "ldrh"; }
            else { ls_mnem = "ldr"; }
        }
        if ls_mnem != "" {
            let base_ls = _a64_reg(rn_ls, 1, true);
            let reg_ls = _a64_reg(rt_ls, sf_ls, false);
            if mode_ls == 1 {
                let imm12_ls = _bits(w, 21, 10) * bit_shl(1, sz_ls);
                mnem = ls_mnem;
                if imm12_ls == 0 {
                    ops = reg_ls + ", [" + base_ls + "]";
                } else {
                    ops = reg_ls + ", [" + base_ls + ", #" + str(imm12_ls) + "]";
                }
            } elif mode_ls == 0 and _bits(w, 21, 21) == 0 {
                let imm9_ls = _sext(_bits(w, 20, 12), 9);
                let idx_ls = _bits(w, 11, 10);
                mnem = ls_mnem;
                if idx_ls == 3 {
                    ops = reg_ls + ", [" + base_ls + ", #" + str(imm9_ls) + "]!";
                } elif idx_ls == 1 {
                    ops = reg_ls + ", [" + base_ls + "], #" + str(imm9_ls);
                } else {
                    if mnem == "ldr" and imm9_ls < 0 { mnem = "ldur"; }
                    elif mnem == "str" and imm9_ls < 0 { mnem = "stur"; }
                    ops = reg_ls + ", [" + base_ls + ", #" + str(imm9_ls) + "]";
                }
            }
        }
    }

    let tgt_addr = if target_off >= 0 { base_addr + target_off } else { -1 };
    let text_str = if ops == "" { mnem } else { mnem + " " + ops };
    return map{
        offset: pc,
        address: addr,
        size: 4,
        bytes_hex: _slice_hex(bytes, pc, 4),
        mnemonic: mnem,
        operands: ops,
        text: text_str,
        flow: flow,
        target_offset: target_off,
        target_address: tgt_addr,
        is_prologue: is_prologue,
        stack_alloc: stack_alloc
    };
}

fn disassemble_arm64(bytes_or_hex, base_addr = 0) {
    let bytes = _coerce_code_bytes(bytes_or_hex);
    let out = [];
    let pc = 0;
    while pc < len(bytes) and len(out) < 2048 {
        let ins = decode_one_arm64(bytes, pc, base_addr);
        push(out, ins);
        pc = pc + ins.size;
    }
    return out;
}

// ══════════════════════════════════════════════════════════════════════════════
// 5C. Genuine RISC-V RV32IM 32-Bit Little-Endian Instruction Decoder
// ══════════════════════════════════════════════════════════════════════════════

let _RV_ABI_REGS = [
    "zero", "ra", "sp", "gp", "tp", "t0", "t1", "t2",
    "s0", "s1", "a0", "a1", "a2", "a3", "a4", "a5",
    "a6", "a7", "s2", "s3", "s4", "s5", "s6", "s7",
    "s8", "s9", "s10", "s11", "t3", "t4", "t5", "t6"
];

fn decode_one_rv32im(bytes, pc, base_addr = 0) {
    let addr = base_addr + pc;
    if pc + 4 > len(bytes) {
        let b0 = bytes[pc];
        return map{
            offset: pc, address: addr, size: 1, bytes_hex: _hex_byte(b0),
            mnemonic: "db", operands: "0x" + _hex_byte(b0), text: "db 0x" + _hex_byte(b0),
            flow: "sequential", target_offset: -1, target_address: -1,
            is_prologue: false, stack_alloc: 0
        };
    }

    let w = _u32(bytes, pc, true);
    let opcode = bit_and(w, 127);
    let rd = _bits(w, 11, 7);
    let funct3 = _bits(w, 14, 12);
    let rs1 = _bits(w, 19, 15);
    let rs2 = _bits(w, 24, 20);
    let funct7 = _bits(w, 31, 25);

    let mnem = ".word";
    let ops = "0x" + _slice_hex(bytes, pc, 4);
    let flow = "sequential";
    let target_off = -1;
    let is_prologue = false;
    let stack_alloc = 0;

    if opcode == 55 { // 0x37 LUI
        let u_imm = _bits(w, 31, 12);
        mnem = "lui";
        ops = _RV_ABI_REGS[rd] + ", " + str(u_imm);
    } elif opcode == 23 { // 0x17 AUIPC
        let u_imm2 = _bits(w, 31, 12);
        mnem = "auipc";
        ops = _RV_ABI_REGS[rd] + ", " + str(u_imm2);
    } elif opcode == 111 { // 0x6F JAL
        let j20 = _bits(w, 31, 31);
        let j10_1 = _bits(w, 30, 21);
        let j11 = _bits(w, 20, 20);
        let j19_12 = _bits(w, 19, 12);
        let j_raw = bit_shl(j20, 20) + bit_shl(j19_12, 12) + bit_shl(j11, 11) + bit_shl(j10_1, 1);
        let j_imm = _sext(j_raw, 21);
        target_off = pc + j_imm;
        mnem = "jal";
        if rd == 0 {
            ops = "zero, loc_" + str(base_addr + target_off);
            flow = "jump";
        } else {
            ops = _RV_ABI_REGS[rd] + ", sub_" + str(base_addr + target_off);
            flow = "call";
        }
    } elif opcode == 103 and funct3 == 0 { // 0x67 JALR
        let i_imm_jr = _sext(_bits(w, 31, 20), 12);
        mnem = "jalr";
        ops = _RV_ABI_REGS[rd] + ", " + str(i_imm_jr) + "(" + _RV_ABI_REGS[rs1] + ")";
        if rd == 0 and rs1 == 1 and i_imm_jr == 0 {
            flow = "return";
        } elif rd == 0 {
            flow = "jump";
        } else {
            flow = "call";
        }
    } elif opcode == 99 { // 0x63 B-type (beq, bne, blt, bge, bltu, bgeu)
        let b12 = _bits(w, 31, 31);
        let b10_5 = _bits(w, 30, 25);
        let b4_1 = _bits(w, 11, 8);
        let b11 = _bits(w, 7, 7);
        let b_raw = bit_shl(b12, 12) + bit_shl(b11, 11) + bit_shl(b10_5, 5) + bit_shl(b4_1, 1);
        let b_imm = _sext(b_raw, 13);
        let br_mnem = "";
        if funct3 == 0 { br_mnem = "beq"; }
        elif funct3 == 1 { br_mnem = "bne"; }
        elif funct3 == 4 { br_mnem = "blt"; }
        elif funct3 == 5 { br_mnem = "bge"; }
        elif funct3 == 6 { br_mnem = "bltu"; }
        elif funct3 == 7 { br_mnem = "bgeu"; }
        if br_mnem != "" {
            target_off = pc + b_imm;
            mnem = br_mnem;
            ops = _RV_ABI_REGS[rs1] + ", " + _RV_ABI_REGS[rs2] + ", loc_" + str(base_addr + target_off);
            flow = "cond_jump";
        }
    } elif opcode == 3 { // 0x03 Loads
        let l_imm = _sext(_bits(w, 31, 20), 12);
        if funct3 == 0 { mnem = "lb"; }
        elif funct3 == 1 { mnem = "lh"; }
        elif funct3 == 2 { mnem = "lw"; }
        elif funct3 == 4 { mnem = "lbu"; }
        elif funct3 == 5 { mnem = "lhu"; }
        if mnem != ".word" {
            ops = _RV_ABI_REGS[rd] + ", " + str(l_imm) + "(" + _RV_ABI_REGS[rs1] + ")";
        }
    } elif opcode == 35 { // 0x23 Stores
        let s_raw = bit_shl(funct7, 5) + rd;
        let s_imm = _sext(s_raw, 12);
        if funct3 == 0 { mnem = "sb"; }
        elif funct3 == 1 { mnem = "sh"; }
        elif funct3 == 2 { mnem = "sw"; }
        if mnem != ".word" {
            ops = _RV_ABI_REGS[rs2] + ", " + str(s_imm) + "(" + _RV_ABI_REGS[rs1] + ")";
            if mnem == "sw" and rs1 == 2 and rs2 == 1 {
                is_prologue = true;
            }
        }
    } elif opcode == 19 { // 0x13 OP-IMM
        let imm_i = _sext(_bits(w, 31, 20), 12);
        if funct3 == 0 {
            mnem = "addi";
            ops = _RV_ABI_REGS[rd] + ", " + _RV_ABI_REGS[rs1] + ", " + str(imm_i);
            if rd == 2 and rs1 == 2 and imm_i < 0 {
                stack_alloc = 0 - imm_i;
                is_prologue = true;
            }
        } elif funct3 == 2 { mnem = "slti"; ops = _RV_ABI_REGS[rd] + ", " + _RV_ABI_REGS[rs1] + ", " + str(imm_i); }
        elif funct3 == 3 { mnem = "sltiu"; ops = _RV_ABI_REGS[rd] + ", " + _RV_ABI_REGS[rs1] + ", " + str(imm_i); }
        elif funct3 == 4 { mnem = "xori"; ops = _RV_ABI_REGS[rd] + ", " + _RV_ABI_REGS[rs1] + ", " + str(imm_i); }
        elif funct3 == 6 { mnem = "ori"; ops = _RV_ABI_REGS[rd] + ", " + _RV_ABI_REGS[rs1] + ", " + str(imm_i); }
        elif funct3 == 7 { mnem = "andi"; ops = _RV_ABI_REGS[rd] + ", " + _RV_ABI_REGS[rs1] + ", " + str(imm_i); }
        elif funct3 == 1 and funct7 == 0 { mnem = "slli"; ops = _RV_ABI_REGS[rd] + ", " + _RV_ABI_REGS[rs1] + ", " + str(rs2); }
        elif funct3 == 5 and (funct7 == 0 or funct7 == 32) {
            mnem = if funct7 == 32 { "srai" } else { "srli" };
            ops = _RV_ABI_REGS[rd] + ", " + _RV_ABI_REGS[rs1] + ", " + str(rs2);
        }
    } elif opcode == 51 { // 0x33 OP (R-type + M-extension RV32M)
        if funct7 == 1 {
            let m_names = ["mul", "mulh", "mulhsu", "mulhu", "div", "divu", "rem", "remu"];
            mnem = m_names[funct3];
            ops = _RV_ABI_REGS[rd] + ", " + _RV_ABI_REGS[rs1] + ", " + _RV_ABI_REGS[rs2];
        } elif funct7 == 0 or funct7 == 32 {
            if funct3 == 0 { mnem = if funct7 == 32 { "sub" } else { "add" }; }
            elif funct3 == 1 and funct7 == 0 { mnem = "sll"; }
            elif funct3 == 2 and funct7 == 0 { mnem = "slt"; }
            elif funct3 == 3 and funct7 == 0 { mnem = "sltu"; }
            elif funct3 == 4 and funct7 == 0 { mnem = "xor"; }
            elif funct3 == 5 { mnem = if funct7 == 32 { "sra" } else { "srl" }; }
            elif funct3 == 6 and funct7 == 0 { mnem = "or"; }
            elif funct3 == 7 and funct7 == 0 { mnem = "and"; }
            if mnem != ".word" {
                ops = _RV_ABI_REGS[rd] + ", " + _RV_ABI_REGS[rs1] + ", " + _RV_ABI_REGS[rs2];
            }
        }
    } elif opcode == 115 and funct3 == 0 and rd == 0 and rs1 == 0 { // 0x73 SYSTEM
        let sys_imm = _bits(w, 31, 20);
        if sys_imm == 0 { mnem = "ecall"; ops = ""; flow = "syscall"; }
        elif sys_imm == 1 { mnem = "ebreak"; ops = ""; flow = "trap"; }
    }

    let tgt_addr = if target_off >= 0 { base_addr + target_off } else { -1 };
    let text_str = if ops == "" { mnem } else { mnem + " " + ops };
    return map{
        offset: pc,
        address: addr,
        size: 4,
        bytes_hex: _slice_hex(bytes, pc, 4),
        mnemonic: mnem,
        operands: ops,
        text: text_str,
        flow: flow,
        target_offset: target_off,
        target_address: tgt_addr,
        is_prologue: is_prologue,
        stack_alloc: stack_alloc
    };
}

fn disassemble_rv32im(bytes_or_hex, base_addr = 0) {
    let bytes = _coerce_code_bytes(bytes_or_hex);
    let out = [];
    let pc = 0;
    while pc < len(bytes) and len(out) < 2048 {
        let ins = decode_one_rv32im(bytes, pc, base_addr);
        push(out, ins);
        pc = pc + ins.size;
    }
    return out;
}

fn _normalize_rea_arch(raw_arch) {
    let a = str_lower(str_trim(raw_arch));
    if a == "x86_64" or a == "x86-64" or a == "amd64" { return "x86_64"; }
    if a == "aarch64" or a == "arm64" { return "aarch64"; }
    if a == "rv32im" or a == "riscv32" or a == "riscv" { return "rv32im"; }
    if a == "evm" { return "evm"; }
    if a == "wasm" { return "wasm"; }
    return "";
}

fn disassemble_stream(bytes_or_hex, arch = "x86_64", base_addr = 0) {
    let norm = _normalize_rea_arch(arch);
    if norm == "x86_64" { return disassemble_x86_64(bytes_or_hex, base_addr); }
    if norm == "aarch64" { return disassemble_arm64(bytes_or_hex, base_addr); }
    if norm == "rv32im" { return disassemble_rv32im(bytes_or_hex, base_addr); }
    throw "disassemble_stream: unsupported architecture: " + str(arch);
}

// ══════════════════════════════════════════════════════════════════════════════
// 5D. Cooper-Harvey-Kennedy CFG Dominator Tree & Natural Loop Back-Edge Analyzer
// ══════════════════════════════════════════════════════════════════════════════

fn _sort_ints_asc(vals) {
    let arr = [];
    for v in vals { push(arr, v); }
    let i = 1;
    while i < len(arr) {
        let key = arr[i];
        let j = i - 1;
        while j >= 0 and arr[j] > key {
            arr[j + 1] = arr[j];
            j = j - 1;
        }
        arr[j + 1] = key;
        i = i + 1;
    }
    return arr;
}

fn _rpo_dfs_visit(u, succ_idx_list, visited, post_order) {
    visited[u] = true;
    let succs = succ_idx_list[u];
    let i = 0;
    while i < len(succs) {
        let v = succs[i];
        if not _is_true(visited[v]) {
            _rpo_dfs_visit(v, succ_idx_list, visited, post_order);
        }
        i = i + 1;
    }
    push(post_order, u);
}

fn _dom_intersect(b1, b2, idom, rpo_num) {
    let f1 = b1;
    let f2 = b2;
    while f1 != f2 {
        while rpo_num[f1] > rpo_num[f2] {
            f1 = idom[f1];
        }
        while rpo_num[f2] > rpo_num[f1] {
            f2 = idom[f2];
        }
    }
    return f1;
}

fn build_real_cfg(insns) {
    if type(insns) != "array" or len(insns) == 0 {
        return map{
            basic_block_count: 0,
            edge_count: 0,
            cyclomatic_complexity: 1,
            has_standard_prologue: false,
            stack_frame_bytes: 0,
            basic_blocks: [],
            idom: map{},
            dominators: map{},
            dominance_frontier: map{},
            back_edges: [],
            natural_loops: [],
            loop_count: 0
        };
    }

    let first_ins = insns[0];
    let last_ins = insns[len(insns) - 1];
    let base_addr = first_ins.address - first_ins.offset;
    let start_stream_off = first_ins.offset;
    let end_stream_off = last_ins.offset + last_ins.size;

    let leaders_raw = [start_stream_off];
    let has_prologue = false;
    let stack_frame_bytes = 0;

    for inst in insns {
        if map_has(inst, "is_prologue") and _is_true(inst.is_prologue) {
            has_prologue = true;
        }
        if map_has(inst, "stack_alloc") and inst.stack_alloc > 0 and stack_frame_bytes == 0 {
            stack_frame_bytes = inst.stack_alloc;
        }
        let fl = inst.flow;
        let next_off = inst.offset + inst.size;
        if fl == "jump" or fl == "cond_jump" {
            if inst.target_offset >= start_stream_off and inst.target_offset < end_stream_off {
                if not _has(leaders_raw, inst.target_offset) {
                    push(leaders_raw, inst.target_offset);
                }
            }
            if next_off < end_stream_off and not _has(leaders_raw, next_off) {
                push(leaders_raw, next_off);
            }
        } elif fl == "return" or fl == "trap" {
            if next_off < end_stream_off and not _has(leaders_raw, next_off) {
                push(leaders_raw, next_off);
            }
        }
    }

    let leaders = _sort_ints_asc(leaders_raw);
    let n_blocks = len(leaders);

    // Map instruction/leader address -> containing block index
    let addr_to_bb = map{};
    let bi = 0;
    while bi < n_blocks {
        let s_off = leaders[bi];
        let e_off = if bi + 1 < n_blocks { leaders[bi + 1] } else { end_stream_off };
        addr_to_bb[str(base_addr + s_off)] = bi;
        for inst in insns {
            if inst.offset >= s_off and inst.offset < e_off {
                addr_to_bb[str(inst.address)] = bi;
            }
        }
        bi = bi + 1;
    }

    let basic_blocks = [];
    let succ_idx_list = [];
    let pred_idx_list = [];
    bi = 0;
    while bi < n_blocks {
        push(succ_idx_list, []);
        push(pred_idx_list, []);
        bi = bi + 1;
    }

    let edge_count = 0;
    bi = 0;
    while bi < n_blocks {
        let start_off = leaders[bi];
        let next_off = if bi + 1 < n_blocks { leaders[bi + 1] } else { end_stream_off };
        let bb_insts = [];
        let term_flow = "fallthrough";
        let last_bb_inst = nil;

        for inst in insns {
            if inst.offset >= start_off and inst.offset < next_off {
                push(bb_insts, inst);
                term_flow = inst.flow;
                last_bb_inst = inst;
            }
        }

        let out_edges = [];
        if last_bb_inst != nil {
            if term_flow == "cond_jump" {
                if last_bb_inst.target_offset >= 0 {
                    push(out_edges, base_addr + last_bb_inst.target_offset);
                }
                if next_off < end_stream_off {
                    push(out_edges, base_addr + next_off);
                }
            } elif term_flow == "jump" {
                if last_bb_inst.target_offset >= 0 {
                    push(out_edges, base_addr + last_bb_inst.target_offset);
                }
            } elif term_flow != "return" and term_flow != "trap" {
                if next_off < end_stream_off {
                    push(out_edges, base_addr + next_off);
                }
            }
        }

        for edge_addr in out_edges {
            let k_addr = str(edge_addr);
            if map_has(addr_to_bb, k_addr) {
                let dst_bi = addr_to_bb[k_addr];
                if not _has(succ_idx_list[bi], dst_bi) {
                    push(succ_idx_list[bi], dst_bi);
                }
                if not _has(pred_idx_list[dst_bi], bi) {
                    push(pred_idx_list[dst_bi], bi);
                }
            }
        }

        edge_count = edge_count + len(out_edges);
        push(basic_blocks, map{
            block_id: "bb_" + str(bi),
            index: bi,
            start_address: base_addr + start_off,
            end_address: base_addr + next_off,
            instruction_count: len(bb_insts),
            instructions: bb_insts,
            terminator: term_flow,
            out_edges: out_edges,
            preds: [],
            succs: [],
            idom: nil,
            loop_depth: 0
        });
        bi = bi + 1;
    }

    // Populate human-readable preds/succs IDs
    bi = 0;
    while bi < n_blocks {
        let p_ids = [];
        for pi in pred_idx_list[bi] { push(p_ids, "bb_" + str(pi)); }
        let s_ids = [];
        for si in succ_idx_list[bi] { push(s_ids, "bb_" + str(si)); }
        basic_blocks[bi].preds = p_ids;
        basic_blocks[bi].succs = s_ids;
        bi = bi + 1;
    }

    // Reverse Post-Order traversal from entry block 0
    let visited = [];
    let rpo_num = [];
    let idom = [];
    bi = 0;
    while bi < n_blocks {
        push(visited, false);
        push(rpo_num, 999999);
        push(idom, -1);
        bi = bi + 1;
    }

    let post_order = [];
    _rpo_dfs_visit(0, succ_idx_list, visited, post_order);
    let rpo_order = [];
    let poi = len(post_order) - 1;
    while poi >= 0 {
        let node_i = post_order[poi];
        rpo_num[node_i] = len(rpo_order);
        push(rpo_order, node_i);
        poi = poi - 1;
    }

    // Cooper-Harvey-Kennedy Iterative Dominator Solver
    idom[0] = 0;
    let changed = true;
    while _is_true(changed) {
        changed = false;
        let ri = 1;
        while ri < len(rpo_order) {
            let b_node = rpo_order[ri];
            let preds_b = pred_idx_list[b_node];
            let new_idom = -1;
            for p_cand in preds_b {
                if idom[p_cand] != -1 {
                    if new_idom == -1 {
                        new_idom = p_cand;
                    } else {
                        new_idom = _dom_intersect(p_cand, new_idom, idom, rpo_num);
                    }
                }
            }
            if new_idom != -1 and idom[b_node] != new_idom {
                idom[b_node] = new_idom;
                changed = true;
            }
            ri = ri + 1;
        }
    }

    // Build full Dominator sets & Dominance Frontiers
    let dom_sets_idx = [];
    let dom_frontier_idx = [];
    bi = 0;
    while bi < n_blocks {
        let dset = [];
        if idom[bi] != -1 {
            let cur = bi;
            let guard = 0;
            while guard <= n_blocks {
                if not _has(dset, cur) { push(dset, cur); }
                if cur == idom[cur] { guard = n_blocks + 1; }
                else { cur = idom[cur]; guard = guard + 1; }
            }
            dset = _sort_ints_asc(dset);
        }
        push(dom_sets_idx, dset);
        push(dom_frontier_idx, []);
        bi = bi + 1;
    }

    bi = 0;
    while bi < n_blocks {
        let preds_df = pred_idx_list[bi];
        if idom[bi] != -1 and len(preds_df) >= 2 {
            for p_df in preds_df {
                if idom[p_df] != -1 {
                    let runner = p_df;
                    let guard_df = 0;
                    while runner != idom[bi] and guard_df <= n_blocks {
                        if not _has(dom_frontier_idx[runner], bi) {
                            push(dom_frontier_idx[runner], bi);
                        }
                        runner = idom[runner];
                        guard_df = guard_df + 1;
                    }
                }
            }
        }
        bi = bi + 1;
    }

    // Detect Back-Edges (u -> h where h dominates u) & Natural Loop Bodies
    let back_edges = [];
    let natural_loops = [];
    let u_bi = 0;
    while u_bi < n_blocks {
        if idom[u_bi] != -1 {
            for h_bi in succ_idx_list[u_bi] {
                if _has(dom_sets_idx[u_bi], h_bi) {
                    push(back_edges, map{
                        from_block: "bb_" + str(u_bi),
                        to_block: "bb_" + str(h_bi),
                        from_address: basic_blocks[u_bi].start_address,
                        to_address: basic_blocks[h_bi].start_address
                    });

                    // Worklist natural loop body recovery
                    let body_idx = [h_bi];
                    let work = [];
                    if u_bi != h_bi {
                        push(body_idx, u_bi);
                        push(work, u_bi);
                    }
                    while len(work) > 0 {
                        let top_w = work[len(work) - 1];
                        work = slice(work, 0, len(work) - 1);
                        for pred_w in pred_idx_list[top_w] {
                            if idom[pred_w] != -1 and not _has(body_idx, pred_w) {
                                push(body_idx, pred_w);
                                push(work, pred_w);
                            }
                        }
                    }
                    body_idx = _sort_ints_asc(body_idx);
                    let body_ids = [];
                    for lnode in body_idx {
                        push(body_ids, "bb_" + str(lnode));
                        basic_blocks[lnode].loop_depth = basic_blocks[lnode].loop_depth + 1;
                    }
                    push(natural_loops, map{
                        header: "bb_" + str(h_bi),
                        latch: "bb_" + str(u_bi),
                        header_address: basic_blocks[h_bi].start_address,
                        latch_address: basic_blocks[u_bi].start_address,
                        body_blocks: body_ids,
                        block_count: len(body_ids)
                    });
                }
            }
        }
        u_bi = u_bi + 1;
    }

    let idom_map = map{};
    let dom_map = map{};
    let df_map = map{};
    bi = 0;
    while bi < n_blocks {
        let bid = "bb_" + str(bi);
        if idom[bi] != -1 {
            let idom_str = "bb_" + str(idom[bi]);
            idom_map[bid] = idom_str;
            basic_blocks[bi].idom = idom_str;
        } else {
            idom_map[bid] = nil;
        }
        let d_ids = [];
        for di in dom_sets_idx[bi] { push(d_ids, "bb_" + str(di)); }
        dom_map[bid] = d_ids;

        let df_ids = [];
        for dfi in _sort_ints_asc(dom_frontier_idx[bi]) { push(df_ids, "bb_" + str(dfi)); }
        df_map[bid] = df_ids;
        bi = bi + 1;
    }

    let cyclomatic = edge_count - n_blocks + 2;
    if cyclomatic < 1 { cyclomatic = 1; }

    return map{
        basic_block_count: n_blocks,
        edge_count: edge_count,
        cyclomatic_complexity: cyclomatic,
        has_standard_prologue: has_prologue,
        stack_frame_bytes: stack_frame_bytes,
        basic_blocks: basic_blocks,
        idom: idom_map,
        dominators: dom_map,
        dominance_frontier: df_map,
        back_edges: back_edges,
        natural_loops: natural_loops,
        loop_count: len(natural_loops)
    };
}

// 5. Sovereign Ghidra / IDA Pro Replacement: Native Multi-Arch Disassembler, CFG, Xrefs & Decompiler
fn decompile_and_cfg_artifact(spec) {
    _keys(spec, ["function_name", "arch", "base_address", "bytes", "hex"], "decompile_and_cfg_artifact");
    let fn_name = "sub_1000";
    if map_has(spec, "function_name") {
        if type(spec.function_name) != "string" or len(spec.function_name) < 1 or len(spec.function_name) > 128 {
            throw "decompile_and_cfg_artifact: invalid function_name";
        }
        fn_name = spec.function_name;
    }
    let raw_arch = "x86_64";
    if map_has(spec, "arch") {
        if type(spec.arch) != "string" { throw "decompile_and_cfg_artifact: invalid arch"; }
        raw_arch = str_lower(str_trim(spec.arch));
    }
    let norm_arch = _normalize_rea_arch(raw_arch);
    if norm_arch == "" {
        throw "decompile_and_cfg_artifact: unsupported arch";
    }
    let base_addr = 4096;
    if map_has(spec, "base_address") {
        if type(spec.base_address) != "number" or spec.base_address < 0 or spec.base_address != num_floor(spec.base_address) {
            throw "decompile_and_cfg_artifact: invalid base_address";
        }
        base_addr = spec.base_address;
    }
    let bytes = [];
    if map_has(spec, "bytes") and map_has(spec, "hex") {
        throw "decompile_and_cfg_artifact: provide either bytes or hex, not both";
    }
    if map_has(spec, "bytes") {
        bytes = _validate_bytes(spec.bytes, 4096);
    } elif map_has(spec, "hex") {
        bytes = _bytes_from_hex(spec.hex, 4096);
    } else {
        throw "decompile_and_cfg_artifact: bytes or hex required";
    }
    if len(bytes) < 1 {
        throw "decompile_and_cfg_artifact: empty instruction stream";
    }

    let instructions = [];
    let xrefs = [];
    let pseudocode_lines = [];
    push(pseudocode_lines, "// Sovereign PBLang Decompiler (replaces Ghidra / IDA / Capstone)");
    push(pseudocode_lines, "fn " + fn_name + "(arg0, arg1) {");

    if norm_arch == "x86_64" or norm_arch == "aarch64" or norm_arch == "rv32im" {
        instructions = disassemble_stream(bytes, norm_arch, base_addr);
        let label_addrs = map{};
        for ins0 in instructions {
            if (ins0.flow == "jump" or ins0.flow == "cond_jump") and ins0.target_address >= base_addr {
                label_addrs[str(ins0.target_address)] = true;
            }
        }
        for inst in instructions {
            if map_has(label_addrs, str(inst.address)) {
                push(pseudocode_lines, "  loc_" + str(inst.address) + ":");
            }
            if map_has(inst, "stack_alloc") and inst.stack_alloc > 0 {
                push(pseudocode_lines, "    let stack_frame = reserve_bytes(" + str(inst.stack_alloc) + ");");
            } elif inst.mnemonic == "xor" and inst.operands == "eax, eax" {
                push(pseudocode_lines, "    let ret_val = 0;");
            } elif inst.mnemonic == "test" {
                push(pseudocode_lines, "    let cond_zero = (" + inst.operands + ") == 0;");
            } elif inst.mnemonic == "cmp" {
                push(pseudocode_lines, "    let cmp_flags = compare(" + inst.operands + ");");
            } elif inst.flow == "call" {
                let to_call = if inst.target_address >= 0 { inst.target_address } else { 0 };
                push(xrefs, map{from_address: inst.address, to_address: to_call, kind: "call"});
                if inst.target_address >= 0 {
                    push(pseudocode_lines, "    let call_res = sub_" + str(inst.target_address) + "(arg0);");
                } else {
                    push(pseudocode_lines, "    let call_res = indirect_call(" + inst.operands + ");");
                }
            } elif inst.flow == "cond_jump" {
                let to_cj = if inst.target_address >= 0 { inst.target_address } else { 0 };
                push(xrefs, map{from_address: inst.address, to_address: to_cj, kind: "cond_jump"});
                push(pseudocode_lines, "    if (" + inst.mnemonic + "_cond) { goto loc_" + str(to_cj) + "; }");
            } elif inst.flow == "jump" {
                let to_j = if inst.target_address >= 0 { inst.target_address } else { 0 };
                push(xrefs, map{from_address: inst.address, to_address: to_j, kind: "jump"});
                if inst.target_address >= 0 {
                    push(pseudocode_lines, "    goto loc_" + str(to_j) + ";");
                } else {
                    push(pseudocode_lines, "    goto_indirect(" + inst.operands + ");");
                }
            } elif inst.flow == "syscall" {
                push(xrefs, map{from_address: inst.address, to_address: 0, kind: "syscall"});
                push(pseudocode_lines, "    syscall_invoke();");
            } elif inst.flow == "return" {
                push(pseudocode_lines, "    return ret_val;");
            } elif not _is_true(inst.is_prologue) and inst.mnemonic != "leave" and inst.mnemonic != "nop" {
                push(pseudocode_lines, "    // " + inst.text);
            }
        }
    } else {
        // EVM & WASM bytecode streams
        let pc = 0;
        while pc < len(bytes) and len(instructions) < 512 {
            let addr = base_addr + pc;
            let b0 = bytes[pc];
            let mnem = "db";
            let ops = "0x" + _hex_byte(b0);
            let size = 1;
            let flow = "sequential";
            let target_off = -1;
            if norm_arch == "evm" {
                if b0 >= 96 and b0 <= 127 {
                    let push_n = b0 - 95;
                    mnem = "PUSH" + str(push_n);
                    let imm = "0x";
                    let k = 1;
                    while k <= push_n and pc + k < len(bytes) {
                        imm = imm + _hex_byte(bytes[pc + k]);
                        k = k + 1;
                    }
                    ops = imm;
                    size = 1 + push_n;
                } elif b0 == 84 {
                    mnem = "SLOAD"; ops = ""; size = 1;
                    push(pseudocode_lines, "    let word = storage_load(top);");
                } elif b0 == 85 {
                    mnem = "SSTORE"; ops = ""; size = 1;
                    push(pseudocode_lines, "    storage_store(slot, val);");
                } elif b0 == 87 {
                    mnem = "JUMPI"; ops = ""; size = 1; flow = "cond_jump";
                    push(pseudocode_lines, "    if (cond) { goto jumpi_target; }");
                } elif b0 == 91 {
                    mnem = "JUMPDEST"; ops = ""; size = 1;
                } elif b0 == 243 or b0 == 253 or b0 == 0 {
                    if b0 == 243 { mnem = "RETURN"; }
                    elif b0 == 253 { mnem = "REVERT"; }
                    else { mnem = "STOP"; }
                    ops = ""; size = 1; flow = "return";
                    push(pseudocode_lines, "    evm_" + str_lower(mnem) + "();");
                }
            }
            push(instructions, map{
                offset: pc, address: addr, size: size,
                mnemonic: mnem, operands: ops, flow: flow,
                target_offset: target_off, target_address: -1,
                is_prologue: false, stack_alloc: 0
            });
            pc = pc + size;
        }
    }
    push(pseudocode_lines, "}");

    let cfg = build_real_cfg(instructions);
    let pseudocode_text = str_join(pseudocode_lines, "\n");
    let sha_hex = SHA256.sha256_hex_bytes(bytes);

    return map{
        ok: true,
        format: FORMAT_DECOMPILE,
        evidence_id: "ev_" + sha_hex,
        function_name: fn_name,
        architecture: norm_arch,
        base_address: base_addr,
        byte_length: len(bytes),
        instruction_count: len(instructions),
        instructions: instructions,
        cfg: cfg,
        xref_count: len(xrefs),
        xrefs: xrefs,
        decompiled_pseudocode: pseudocode_text,
        replaces_external_tools: ["ghidra", "ida_pro", "capstone", "objdump", "rizin"],
        _meta: map{
            provenance: map{
                untrusted_content: true,
                source: "analysis_target"
            }
        },
        target_executed: false
    };
}

fn _strip_tags(html_fragment) {
    let out = "";
    let in_tag = false;
    let i = 0;
    while i < len(html_fragment) {
        let ch = str_slice(html_fragment, i, i + 1);
        if ch == "<" {
            in_tag = true;
        } elif ch == ">" {
            in_tag = false;
            out = out + " ";
        } elif not _is_true(in_tag) {
            out = out + ch;
        }
        i = i + 1;
    }
    let words = str_split(str_trim(out), " ");
    let clean_words = [];
    for w in words {
        let tw = str_trim(w);
        if tw != "" { push(clean_words, tw); }
    }
    return str_join(clean_words, " ");
}

fn _extract_between_ci(text, open_marker, close_marker) {
    let lower = str_lower(text);
    let results = [];
    let pos = 0;
    let open_l = str_lower(open_marker);
    let close_l = str_lower(close_marker);
    while pos < len(lower) and len(results) < 64 {
        let rem = str_slice(lower, pos, len(lower));
        let idx = str_index_of(rem, open_l);
        if idx < 0 {
            pos = len(lower);
        } else {
            let start = pos + idx;
            let after_open = str_slice(lower, start + len(open_l), len(lower));
            let gt_idx = str_index_of(after_open, ">");
            if gt_idx < 0 {
                pos = len(lower);
            } else {
                let body_start = start + len(open_l) + gt_idx + 1;
                let header_raw = str_slice(text, start + len(open_l), start + len(open_l) + gt_idx);
                let after_body = str_slice(lower, body_start, len(lower));
                let end_idx = str_index_of(after_body, close_l);
                if end_idx < 0 {
                    pos = body_start;
                } else {
                    let inner_raw = str_slice(text, body_start, body_start + end_idx);
                    push(results, map{
                        attrs_raw: str_trim(header_raw),
                        inner_html: inner_raw,
                        text: _strip_tags(inner_raw)
                    });
                    pos = body_start + end_idx + len(close_l);
                }
            }
        }
    }
    return results;
}

fn _extract_attr(attrs_raw, attr_name) {
    let lower = str_lower(attrs_raw);
    let needle_dq = str_lower(attr_name) + "=\"";
    let idx = str_index_of(lower, needle_dq);
    if idx >= 0 {
        let val_start = idx + len(needle_dq);
        let rest = str_slice(attrs_raw, val_start, len(attrs_raw));
        let end_q = str_index_of(rest, "\"");
        if end_q >= 0 { return str_slice(rest, 0, end_q); }
    }
    let needle_sq = str_lower(attr_name) + "='";
    let idx2 = str_index_of(lower, needle_sq);
    if idx2 >= 0 {
        let val_start2 = idx2 + len(needle_sq);
        let rest2 = str_slice(attrs_raw, val_start2, len(attrs_raw));
        let end_q2 = str_index_of(rest2, "'");
        if end_q2 >= 0 { return str_slice(rest2, 0, end_q2); }
    }
    return "";
}

fn _normalize_url(base_url, href) {
    let trimmed = str_trim(href);
    if trimmed == "" or str_starts_with(trimmed, "#") or str_starts_with(str_lower(trimmed), "javascript:") {
        return "";
    }
    if str_starts_with(trimmed, "http://") or str_starts_with(trimmed, "https://") {
        return trimmed;
    }
    let clean_base = str_trim(base_url);
    if str_ends_with(clean_base, "/") {
        clean_base = str_slice(clean_base, 0, len(clean_base) - 1);
    }
    if str_starts_with(trimmed, "/") {
        return clean_base + trimmed;
    }
    return clean_base + "/" + trimmed;
}

// 6. Sovereign BeautifulSoup + Scrapy Replacement: Pure PBLang DOM Query, Table/JSON-LD Extractor & Crawl Frontier
fn extract_structured_dom(spec) {
    _keys(spec, ["html", "base_url", "selectors", "crawl_rules", "item_schema"], "extract_structured_dom");
    if not map_has(spec, "html") or type(spec.html) != "string" or len(spec.html) < 1 or len(spec.html) > 131072 {
        throw "extract_structured_dom: html must be a non-empty string up to 131072 bytes";
    }
    let html = spec.html;
    let base_url = "https://example.local";
    if map_has(spec, "base_url") {
        if type(spec.base_url) != "string" or len(spec.base_url) < 1 or len(spec.base_url) > 256 {
            throw "extract_structured_dom: invalid base_url";
        }
        base_url = spec.base_url;
    }

    // 1. Document Title & Headings
    let titles = _extract_between_ci(html, "<title", "</title>");
    let page_title = "";
    if len(titles) > 0 { page_title = titles[0].text; }
    let h1_list = [];
    for h in _extract_between_ci(html, "<h1", "</h1>") { push(h1_list, h.text); }
    let h2_list = [];
    for h in _extract_between_ci(html, "<h2", "</h2>") { push(h2_list, h.text); }

    // 2. JSON-LD Structured Data Extraction
    let scripts = _extract_between_ci(html, "<script", "</script>");
    let json_ld_blocks = [];
    for sc in scripts {
        if str_contains(str_lower(sc.attrs_raw), "application/ld+json") {
            push(json_ld_blocks, str_trim(sc.inner_html));
        }
    }

    // 3. Links & Scrapy-style Crawl Frontier
    let allow_patterns = [];
    let deny_patterns = [];
    if map_has(spec, "crawl_rules") {
        let cr = spec.crawl_rules;
        _keys(cr, ["allow_patterns", "deny_patterns"], "extract_structured_dom.crawl_rules");
        if map_has(cr, "allow_patterns") and type(cr.allow_patterns) == "array" {
            allow_patterns = cr.allow_patterns;
        }
        if map_has(cr, "deny_patterns") and type(cr.deny_patterns) == "array" {
            deny_patterns = cr.deny_patterns;
        }
    }

    let raw_anchors = _extract_between_ci(html, "<a", "</a>");
    let links = [];
    let frontier_urls = [];
    for a in raw_anchors {
        let href = _extract_attr(a.attrs_raw, "href");
        let norm = _normalize_url(base_url, href);
        if norm != "" {
            let same_origin = str_starts_with(norm, base_url);
            push(links, map{
                href: href,
                url: norm,
                text: a.text,
                rel: _extract_attr(a.attrs_raw, "rel"),
                same_origin: same_origin
            });
            let allowed = true;
            if len(allow_patterns) > 0 {
                allowed = false;
                for ap in allow_patterns {
                    if type(ap) == "string" and str_contains(norm, ap) { allowed = true; }
                }
            }
            for dp in deny_patterns {
                if type(dp) == "string" and str_contains(norm, dp) { allowed = false; }
            }
            if _is_true(allowed) and not _has(frontier_urls, norm) {
                push(frontier_urls, norm);
            }
        }
    }

    // 4. Structured HTML Tables Extraction
    let raw_tables = _extract_between_ci(html, "<table", "</table>");
    let tables = [];
    for tbl in raw_tables {
        let headers = [];
        for th in _extract_between_ci(tbl.inner_html, "<th", "</th>") {
            push(headers, th.text);
        }
        let rows = [];
        for tr in _extract_between_ci(tbl.inner_html, "<tr", "</tr>") {
            let cells = [];
            for td in _extract_between_ci(tr.inner_html, "<td", "</td>") {
                push(cells, td.text);
            }
            if len(cells) > 0 { push(rows, cells); }
        }
        push(tables, map{
            id: _extract_attr(tbl.attrs_raw, "id"),
            headers: headers,
            row_count: len(rows),
            rows: rows
        });
    }

    // 5. Forms Extraction
    let raw_forms = _extract_between_ci(html, "<form", "</form>");
    let forms = [];
    for fm in raw_forms {
        let action = _extract_attr(fm.attrs_raw, "action");
        if action == "" { action = "/"; }
        let method = str_upper(_extract_attr(fm.attrs_raw, "method"));
        if method == "" { method = "GET"; }
        push(forms, map{
            action: _normalize_url(base_url, action),
            method: method,
            id: _extract_attr(fm.attrs_raw, "id")
        });
    }

    // 6. BeautifulSoup-class CSS/Tag/ID/Class Selector Query Engine
    let candidate_tags = ["div", "span", "p", "a", "h1", "h2", "h3", "li", "td", "th", "article", "section", "button"];
    let dom_elements = [];
    for tname in candidate_tags {
        for el in _extract_between_ci(html, "<" + tname, "</" + tname + ">") {
            if len(dom_elements) < 256 {
                push(dom_elements, map{
                    tag: tname,
                    id: _extract_attr(el.attrs_raw, "id"),
                    class_name: _extract_attr(el.attrs_raw, "class"),
                    href: _extract_attr(el.attrs_raw, "href"),
                    data_field: _extract_attr(el.attrs_raw, "data-field"),
                    text: el.text
                });
            }
        }
    }

    let selector_results = map{};
    if map_has(spec, "selectors") {
        if type(spec.selectors) != "array" or len(spec.selectors) > 32 {
            throw "extract_structured_dom: invalid selectors";
        }
        for sel in spec.selectors {
            if type(sel) != "string" or len(sel) < 1 or len(sel) > 64 {
                throw "extract_structured_dom: invalid selector string";
            }
            let matches = [];
            for el in dom_elements {
                let matched = false;
                if str_starts_with(sel, "#") {
                    matched = (el.id == str_slice(sel, 1, len(sel)));
                } elif str_starts_with(sel, ".") {
                    let wanted_cls = str_slice(sel, 1, len(sel));
                    matched = _has(str_split(el.class_name, " "), wanted_cls);
                } else {
                    matched = (el.tag == str_lower(sel));
                }
                if _is_true(matched) {
                    push(matches, el);
                }
            }
            selector_results[sel] = matches;
        }
    }

    // 7. Scrapy-class Declarative Item Schema Extraction
    let extracted_item = map{};
    if map_has(spec, "item_schema") {
        if type(spec.item_schema) != "map" or len(spec.item_schema) > 32 {
            throw "extract_structured_dom: invalid item_schema";
        }
        for field_name in map_keys(spec.item_schema) {
            let field_sel = str(spec.item_schema[field_name]);
            let field_vals = [];
            for el in dom_elements {
                let hit = false;
                if str_starts_with(field_sel, "#") {
                    hit = (el.id == str_slice(field_sel, 1, len(field_sel)));
                } elif str_starts_with(field_sel, ".") {
                    hit = _has(str_split(el.class_name, " "), str_slice(field_sel, 1, len(field_sel)));
                } else {
                    hit = (el.tag == str_lower(field_sel));
                }
                if _is_true(hit) {
                    push(field_vals, el.text);
                }
            }
            extracted_item[field_name] = field_vals;
        }
    }

    let prompt_guard = _scan_prompt_injection([html]);
    let digest = SHA256.sha256_hex(base_url + "|" + page_title + "|" + str(len(links)) + "|" + str(len(tables)) + "|" + str(len(frontier_urls)));

    return map{
        ok: true,
        format: FORMAT_DOM_SCRAPE,
        evidence_id: "ev_" + digest,
        base_url: base_url,
        title: page_title,
        headings: map{h1: h1_list, h2: h2_list},
        json_ld_count: len(json_ld_blocks),
        json_ld_blocks: json_ld_blocks,
        link_count: len(links),
        links: links,
        table_count: len(tables),
        tables: tables,
        form_count: len(forms),
        forms: forms,
        selector_results: selector_results,
        extracted_item: extracted_item,
        crawl_frontier: map{
            queued_count: len(frontier_urls),
            queued_urls: frontier_urls
        },
        replaces_external_tools: ["beautifulsoup4", "scrapy", "lxml", "cheerio", "parsel"],
        prompt_injection_guard: prompt_guard,
        _meta: map{
            provenance: map{
                untrusted_content: true,
                source: "analysis_target"
            }
        }
    };
}

export FORMAT_BINARY, FORMAT_APP_GRAPH, FORMAT_PROTOCOL, FORMAT_LEDGER,
       FORMAT_DECOMPILE, FORMAT_DOM_SCRAPE,
       inspect_binary_artifact, analyze_application_surface,
       reconstruct_protocol_surface, evaluate_evidence_ledger,
       decompile_and_cfg_artifact, extract_structured_dom,
       decode_one_x86_64, disassemble_x86_64,
       decode_one_arm64, disassemble_arm64,
       decode_one_rv32im, disassemble_rv32im,
       disassemble_stream, build_real_cfg;

