// stdlib/set.sapp — a hash Set of values, backed by a map keyed on str(v).
// Stores the original value alongside its key, so to_array() returns the real
// values (numbers, strings, bools) rather than their string keys.
//
//   let set = import("stdlib:set.sapp");
//   let a = set.from_array([1, 2, 2, 3]);   // {1, 2, 3}
//   set.size(a)                              // 3
//   set.to_array(set.union(a, set.of(3, 4)))  // [1,2,3,4]

fn new() { return map{ items: map{} }; }

fn of(a, b) {
    // Convenience: a set from up to two values (nil-tolerant for the 2nd).
    let s = new();
    add(s, a);
    if b != nil { add(s, b); }
    return s;
}

fn from_array(arr) {
    let s = new();
    return add_all(s, arr);
}

// add(s, v) -> s (mutates in place); duplicates are ignored.
fn add(s, v) {
    s["items"][str(v)] = v;
    return s;
}

// remove(s, v) -> s; removing an absent value is a no-op.
fn remove(s, v) {
    map_remove(s["items"], str(v));
    return s;
}

// Batch mutation APIs avoid repeated application-side loops.
fn add_all(s, values) {
    for v in values { s["items"][str(v)] = v; }
    return s;
}

fn remove_all(s, values) {
    for v in values { map_remove(s["items"], str(v)); }
    return s;
}

fn has(s, v) { return map_has(s["items"], str(v)); }
fn size(s) { return len(map_keys(s["items"])); }
fn is_empty(s) { return size(s) == 0; }

fn clear(s) { s["items"] = map{}; return s; }

// to_array(s) -> the stored values (insertion order of the backing map).
fn to_array(s) {
    let out = [];
    let keys = map_keys(s["items"]);
    for k in keys { array_push(out, s["items"][k]); }
    return out;
}
fn values(s) { return to_array(s); }

fn clone(s) {
    let r = new();
    let keys = map_keys(s["items"]);
    for k in keys { r["items"][k] = s["items"][k]; }
    return r;
}

// union(a, b) -> new set with every element of a and b.
fn union(a, b) {
    let r = clone(a);
    let keys = map_keys(b["items"]);
    for k in keys { r["items"][k] = b["items"][k]; }
    return r;
}

// intersection(a, b) -> new set of elements present in both.
fn intersection(a, b) {
    let r = new();
    let source = a;
    let other = b;
    if size(b) < size(a) { source = b; other = a; }
    let keys = map_keys(source["items"]);
    for k in keys {
        if map_has(other["items"], k) { r["items"][k] = source["items"][k]; }
    }
    return r;
}

// difference(a, b) -> new set of elements in a but not in b.
fn difference(a, b) {
    let r = new();
    let keys = map_keys(a["items"]);
    for k in keys {
        if not map_has(b["items"], k) { r["items"][k] = a["items"][k]; }
    }
    return r;
}

// symmetric_difference(a, b) -> elements in exactly one of a, b.
fn symmetric_difference(a, b) {
    let r = new();
    let akeys = map_keys(a["items"]);
    for k in akeys {
        if not map_has(b["items"], k) { r["items"][k] = a["items"][k]; }
    }
    let bkeys = map_keys(b["items"]);
    for k in bkeys {
        if not map_has(a["items"], k) { r["items"][k] = b["items"][k]; }
    }
    return r;
}

fn is_subset(a, b) {
    let keys = map_keys(a["items"]);
    for k in keys { if not map_has(b["items"], k) { return false; } }
    return true;
}
fn is_superset(a, b) { return is_subset(b, a); }

fn is_disjoint(a, b) {
    let source = a;
    let other = b;
    if size(b) < size(a) { source = b; other = a; }
    let keys = map_keys(source["items"]);
    for k in keys { if map_has(other["items"], k) { return false; } }
    return true;
}

fn equals(a, b) {
    if size(a) != size(b) { return false; }
    return is_subset(a, b);
}

// map(s, fn) -> new set of fn(v) for each v.
fn map(s, fn_val) {
    let r = new();
    let keys = map_keys(s["items"]);
    for k in keys { add(r, fn_val(s["items"][k])); }
    return r;
}

// filter(s, fn) -> new set of elements where fn(v) is truthy.
fn filter(s, fn_val) {
    let r = new();
    let keys = map_keys(s["items"]);
    for k in keys {
        let v = s["items"][k];
        if fn_val(v) { r["items"][k] = v; }
    }
    return r;
}

fn each(s, fn_val) {
    let keys = map_keys(s["items"]);
    for k in keys { fn_val(s["items"][k]); }
    return s;
}

// retain(s, fn) mutates in place, keeping only values accepted by fn.
fn retain(s, fn_val) {
    let keys = map_keys(s["items"]);
    for k in keys {
        if not fn_val(s["items"][k]) { map_remove(s["items"], k); }
    }
    return s;
}

fn to_string(s) {
    let parts = [];
    let keys = map_keys(s["items"]);
    for k in keys { array_push(parts, str(s["items"][k])); }
    return "{" + str_join(parts, ", ") + "}";
}

export new, of, from_array, add, add_all, remove, remove_all, has, size, is_empty, clear,
       to_array, values, clone, union, intersection, difference,
       symmetric_difference, is_subset, is_superset, is_disjoint, equals,
       map, filter, each, retain, to_string;
