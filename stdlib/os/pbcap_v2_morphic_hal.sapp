// stdlib/os/pbcap_v2_morphic_hal.sapp
// PBLang v5.3.0 — Pillar 5: Universal Sealed Capsule Format (.pbcap v2: PBSH-v1 + @reversible RQIR
// + 3-Family Hybrid Signature + Non-Delegable Constitutional Ceiling + Zero-Cost Lazy Registry)
// and 5-Channel Morphic HAL + Typed Morphic Pipes (|>) with --strict-taint Enforcement.

let PhysCrypto = import("stdlib:crypto/physics_bound_3family_its.sapp");

let PBCAP_HAL_VERSION = "5.3.0";
let PBCAP_V2_MAGIC = "PBCAP2";

let FORBIDDEN_CEILING_CAPS = [
    "ring0",
    "tpm_export",
    "chronovault_erase",
    "cross_capsule_mem"
];

let ALLOWED_CAP_DOMAINS = [
    "fs",
    "net",
    "gpu",
    "qpu",
    "ipc"
];

let PRIVILEGED_TAINT_ACTIONS = [
    "net:send",
    "fs:delete",
    "hw:write"
];

// ============================================================================
// 1. Capability & Non-Delegable Constitutional Ceiling Helpers
// ============================================================================

fn _str_starts_with(s, prefix) {
    let ls = len(s);
    let lp = len(prefix);
    if ls < lp { return false; }
    return str_slice(s, 0, lp) == prefix;
}

fn _cap_root_domain(cap_str) {
    let s = str(cap_str);
    let n = len(s);
    let i = 0;
    while i < n {
        if str_slice(s, i, i + 1) == ":" {
            return str_slice(s, 0, i);
        }
        i = i + 1;
    }
    return s;
}

fn _array_contains_str(arr, target) {
    let i = 0;
    while i < len(arr) {
        if str(arr[i]) == str(target) { return true; }
        i = i + 1;
    }
    return false;
}

fn pbcap_check_constitutional_ceiling(capabilities) {
    let caps = if is_array(capabilities) { capabilities } else { [] };
    let violations = [];
    let unknown_domains = [];
    let i = 0;
    while i < len(caps) {
        let cap = str(caps[i]);
        let dom = _cap_root_domain(cap);
        let j = 0;
        let is_forbidden = false;
        while j < len(FORBIDDEN_CEILING_CAPS) {
            let f = FORBIDDEN_CEILING_CAPS[j];
            if cap == f or dom == f or _str_starts_with(cap, f + ":") {
                is_forbidden = true;
                push(violations, cap);
                break;
            }
            j = j + 1;
        }
        if not is_forbidden and not _array_contains_str(ALLOWED_CAP_DOMAINS, dom) {
            push(unknown_domains, cap);
        }
        i = i + 1;
    }
    let ok = len(violations) == 0 and len(unknown_domains) == 0;
    return map{
        ok: ok,
        violations: violations,
        unknown_domains: unknown_domains,
        ceiling_enforced: true
    };
}

fn _canonical_caps_str(caps) {
    if not is_array(caps) { return ""; }
    let out = "";
    let i = 0;
    while i < len(caps) {
        if i > 0 { out = out + ","; }
        out = out + str(caps[i]);
        i = i + 1;
    }
    return out;
}

fn _pbcap_canonical_body(manifest, pbsh_payload, rqir_payload) {
    let app_id = if map_has(manifest, "app_id") { str(manifest.app_id) } else { "" };
    let app_ver = if map_has(manifest, "app_version") { str(manifest.app_version) } else { "0.0.0" };
    let caps = if map_has(manifest, "capabilities") { manifest.capabilities } else { [] };
    let rev_flag = if map_has(manifest, "reversible_rqir") { str(manifest.reversible_rqir) } else { "true" };
    let pbsh_s = str(pbsh_payload);
    let rqir_s = str(rqir_payload);
    return PBCAP_V2_MAGIC + "|" + PBCAP_HAL_VERSION + "|" +
        "APP=" + app_id + "|" +
        "VER=" + app_ver + "|" +
        "CAPS=" + _canonical_caps_str(caps) + "|" +
        "REV=" + rev_flag + "|" +
        "PBSH-v1=" + str(len(pbsh_s)) + ":" + pbsh_s + "|" +
        "RQIR=" + str(len(rqir_s)) + ":" + rqir_s;
}

// ============================================================================
// 2. Universal Sealed Capsule Format (.pbcap v2)
// ============================================================================

fn pbcap_v2_pack(manifest, pbsh_payload, rqir_payload, signer_kp) {
    if not is_map(manifest) or not map_has(manifest, "app_id") {
        return map{
            ok: false,
            error: "INVALID_MANIFEST_MISSING_APP_ID"
        };
    }
    let caps = if map_has(manifest, "capabilities") { manifest.capabilities } else { [] };
    let ceiling = pbcap_check_constitutional_ceiling(caps);
    if not ceiling.ok {
        let err_code = if len(ceiling.violations) > 0 {
            "CONSTITUTIONAL_CEILING_VIOLATION"
        } else {
            "UNDECLARED_CAPABILITY_DOMAIN"
        };
        return map{
            ok: false,
            error: err_code,
            violations: ceiling.violations,
            unknown_domains: ceiling.unknown_domains
        };
    }

    let canonical = _pbcap_canonical_body(manifest, pbsh_payload, rqir_payload);
    let content_sha512 = PhysCrypto.sha512_hex(canonical);
    let sig3 = PhysCrypto.hybrid3_sign(signer_kp, canonical);

    let app_ver = if map_has(manifest, "app_version") { str(manifest.app_version) } else { "1.0.0" };
    let rev_rqir = if map_has(manifest, "reversible_rqir") { manifest.reversible_rqir } else { true };

    return map{
        ok: true,
        magic: PBCAP_V2_MAGIC,
        format_version: PBCAP_HAL_VERSION,
        header: map{
            app_id: str(manifest.app_id),
            app_version: app_ver,
            capabilities: caps,
            pbsh_format: "PBSH-v1",
            rqir_reversible: rev_rqir,
            constitutional_ceiling: "NON_DELEGABLE_ENFORCED"
        },
        manifest: manifest,
        pbsh_payload: str(pbsh_payload),
        rqir_payload: str(rqir_payload),
        content_sha512: content_sha512,
        signature_3family: sig3
    };
}

fn pbcap_v2_verify_and_unpack(capsule, pub_key) {
    if not is_map(capsule) {
        return map{ ok: false, error: "INVALID_CAPSULE_OBJECT", pbsh_payload: nil, rqir_payload: nil };
    }
    if not map_has(capsule, "magic") or capsule.magic != PBCAP_V2_MAGIC {
        return map{ ok: false, error: "INVALID_CAPSULE_MAGIC", pbsh_payload: nil, rqir_payload: nil };
    }
    if not map_has(capsule, "manifest") or not is_map(capsule.manifest) {
        return map{ ok: false, error: "MISSING_MANIFEST", pbsh_payload: nil, rqir_payload: nil };
    }

    let caps = if map_has(capsule.manifest, "capabilities") { capsule.manifest.capabilities } else { [] };
    let ceiling = pbcap_check_constitutional_ceiling(caps);
    if not ceiling.ok {
        return map{
            ok: false,
            error: "CONSTITUTIONAL_CEILING_VIOLATION",
            violations: ceiling.violations,
            unknown_domains: ceiling.unknown_domains,
            pbsh_payload: nil,
            rqir_payload: nil
        };
    }

    let canonical = _pbcap_canonical_body(capsule.manifest, capsule.pbsh_payload, capsule.rqir_payload);
    let expected_sha512 = PhysCrypto.sha512_hex(canonical);
    if not PhysCrypto.ct_hex_eq(capsule.content_sha512, expected_sha512) {
        return map{
            ok: false,
            error: "SHA512_DIGEST_MISMATCH",
            pbsh_payload: nil,
            rqir_payload: nil
        };
    }

    let sig_check = PhysCrypto.hybrid3_verify(pub_key, canonical, capsule.signature_3family);
    if not sig_check.all_3_valid {
        return map{
            ok: false,
            error: "HYBRID3_SIGNATURE_INVALID",
            signature_check: sig_check,
            pbsh_payload: nil,
            rqir_payload: nil
        };
    }

    return map{
        ok: true,
        magic: capsule.magic,
        format_version: capsule.format_version,
        app_id: str(capsule.manifest.app_id),
        capabilities: caps,
        pbsh_format: "PBSH-v1",
        rqir_reversible: capsule.header.rqir_reversible,
        pbsh_payload: capsule.pbsh_payload,
        rqir_payload: capsule.rqir_payload,
        content_sha512: expected_sha512,
        signature_check: sig_check
    };
}

// ============================================================================
// 3. Zero-Cost Lazy Capsule Registry (0 Loaded / 0 Idle RAM Until Invocation)
// ============================================================================

fn pbcap_lazy_registry_new() {
    return map{
        version: PBCAP_HAL_VERSION,
        entries: map{},
        loaded: map{},
        registered_count: 0,
        loaded_count: 0,
        idle_ram_bytes: 0,
        active_ram_bytes: 0
    };
}

fn pbcap_lazy_register(reg, capsule, pub_key) {
    if not is_map(reg) or not is_map(capsule) or not map_has(capsule, "manifest") {
        return map{ ok: false, error: "INVALID_REGISTER_ARGS" };
    }
    if capsule.magic != PBCAP_V2_MAGIC {
        return map{ ok: false, error: "INVALID_CAPSULE_MAGIC" };
    }
    let caps = if map_has(capsule.manifest, "capabilities") { capsule.manifest.capabilities } else { [] };
    let ceiling = pbcap_check_constitutional_ceiling(caps);
    if not ceiling.ok {
        return map{
            ok: false,
            error: "CONSTITUTIONAL_CEILING_VIOLATION",
            violations: ceiling.violations
        };
    }

    let app_id = str(capsule.manifest.app_id);
    let is_new = not map_has(reg.entries, app_id);
    reg.entries[app_id] = map{
        app_id: app_id,
        capsule: capsule,
        pub_key: pub_key,
        hydrated: false
    };
    if is_new {
        reg.registered_count = reg.registered_count + 1;
    }

    return map{
        ok: true,
        app_id: app_id,
        registered_count: reg.registered_count,
        loaded_count: reg.loaded_count,
        idle_ram_bytes: reg.idle_ram_bytes,
        active_ram_bytes: reg.active_ram_bytes
    };
}

fn pbcap_lazy_load(reg, app_id) {
    let aid = str(app_id);
    if not is_map(reg) or not map_has(reg.entries, aid) {
        return map{ ok: false, error: "CAPSULE_NOT_REGISTERED", app_id: aid };
    }
    if map_has(reg.loaded, aid) {
        let cached = reg.loaded[aid];
        return map{
            ok: true,
            app_id: aid,
            first_load: false,
            loaded_count: reg.loaded_count,
            idle_ram_bytes: reg.idle_ram_bytes,
            active_ram_bytes: reg.active_ram_bytes,
            pbsh_payload: cached.pbsh_payload,
            rqir_payload: cached.rqir_payload,
            capabilities: cached.capabilities
        };
    }

    let desc = reg.entries[aid];
    let unpacked = pbcap_v2_verify_and_unpack(desc.capsule, desc.pub_key);
    if not unpacked.ok {
        return map{
            ok: false,
            error: unpacked.error,
            app_id: aid,
            loaded_count: reg.loaded_count,
            idle_ram_bytes: reg.idle_ram_bytes
        };
    }

    let payload_bytes = len(str_to_bytes(unpacked.pbsh_payload)) + len(str_to_bytes(unpacked.rqir_payload));
    reg.loaded[aid] = unpacked;
    desc.hydrated = true;
    reg.loaded_count = reg.loaded_count + 1;
    reg.active_ram_bytes = reg.active_ram_bytes + payload_bytes;

    return map{
        ok: true,
        app_id: aid,
        first_load: true,
        loaded_count: reg.loaded_count,
        idle_ram_bytes: reg.idle_ram_bytes,
        active_ram_bytes: reg.active_ram_bytes,
        pbsh_payload: unpacked.pbsh_payload,
        rqir_payload: unpacked.rqir_payload,
        capabilities: unpacked.capabilities,
        signature_check: unpacked.signature_check
    };
}

// ============================================================================
// 4. 5-Channel Morphic HAL & Typed Morphic Pipes (|>) with --strict-taint
// ============================================================================

fn _transport_for_q_regime(q_regime) {
    let qr = str(q_regime);
    if qr == "Q0" or qr == "Q1" { return "zero_copy_shared"; }
    if qr == "Q2" or qr == "Q3" { return "coherent_quantum_register"; }
    return "";
}

fn morphic_hal_create(mode, q_regime) {
    let m = str(mode);
    if m != "hosted" and m != "baremetal" {
        return map{ ok: false, error: "INVALID_HAL_MODE" };
    }
    let qr = str(q_regime);
    let transport = _transport_for_q_regime(qr);
    if transport == "" {
        return map{ ok: false, error: "INVALID_Q_REGIME" };
    }

    let compute_backend = if qr == "Q0" { "classical-simd" }
        elif qr == "Q1" { "hybrid-gpu-qpu-offload" }
        elif qr == "Q2" { "coherent-nisq-qpu" }
        else { "fault-tolerant-logical-qpu" };

    let channels = map{
        compute: map{
            channel: "compute",
            mode: m,
            q_regime: qr,
            backend: compute_backend,
            reversible_rqir_ready: true
        },
        memory_vault: map{
            channel: "memory_vault",
            mode: m,
            isolation: "capability-sealed-per-capsule",
            chronovault_append_only: true,
            zero_cost_lazy_paging: true
        },
        ipc_mesh: map{
            channel: "ipc_mesh",
            mode: m,
            pipe_operator: "|>",
            transport: transport,
            typed_schema_enforced: true
        },
        security: map{
            channel: "security",
            mode: m,
            strict_taint: true,
            crypto_suite: "3-family-hybrid+sha512+its-qkd",
            constitutional_ceiling: FORBIDDEN_CEILING_CAPS
        },
        surface_ui: map{
            channel: "surface_ui",
            mode: m,
            compositor: if m == "baremetal" { "direct-framebuffer-gpu" } else { "hosted-window-surface" },
            adaptive_viewport: true
        }
    };

    return map{
        ok: true,
        version: PBCAP_HAL_VERSION,
        mode: m,
        q_regime: qr,
        transport: transport,
        strict_taint: true,
        channel_count: 5,
        channel_names: ["compute", "memory_vault", "ipc_mesh", "security", "surface_ui"],
        channels: channels
    };
}

fn morphic_pipe_send(src_cap, dst_cap, typed_obj, q_regime) {
    let qr = str(q_regime);
    let transport = _transport_for_q_regime(qr);
    if transport == "" {
        return map{ ok: false, blocked: true, error: "INVALID_Q_REGIME" };
    }
    if not is_map(src_cap) or not is_map(dst_cap) or not is_map(typed_obj) {
        return map{ ok: false, blocked: true, error: "INVALID_PIPE_ARGUMENTS" };
    }

    // 1. Typed schema validation
    let obj_schema = if map_has(typed_obj, "schema") { str(typed_obj.schema) } else { "" };
    let exp_schema = if map_has(dst_cap, "expected_schema") { str(dst_cap.expected_schema) } else { "" };
    if exp_schema != "" and obj_schema != exp_schema {
        return map{
            ok: false,
            blocked: true,
            error: "SCHEMA_MISMATCH",
            expected_schema: exp_schema,
            actual_schema: obj_schema,
            transport: transport,
            q_regime: qr
        };
    }

    // 2. --strict-taint propagation across pipe hops
    let src_tainted = map_has(src_cap, "tainted") and src_cap.tainted == true;
    let obj_tainted = map_has(typed_obj, "tainted") and typed_obj.tainted == true;
    let out_tainted = src_tainted or obj_tainted;
    let human_approved = map_has(typed_obj, "human_gate_approved") and typed_obj.human_gate_approved == true;

    let src_id = if map_has(src_cap, "id") { str(src_cap.id) } else { "src" };
    let dst_id = if map_has(dst_cap, "id") { str(dst_cap.id) } else { "dst" };
    let dst_action = if map_has(dst_cap, "action") { str(dst_cap.action) } else { "ipc:deliver" };

    let prev_chain = if map_has(typed_obj, "taint_chain") and is_array(typed_obj.taint_chain) {
        typed_obj.taint_chain
    } else {
        []
    };
    let new_chain = [];
    let i = 0;
    while i < len(prev_chain) { push(new_chain, prev_chain[i]); i = i + 1; }
    push(new_chain, src_id + "|>" + dst_id + "(" + dst_action + ")");

    // 3. Privileged action gate when tainted without explicit human approval
    let is_privileged = _array_contains_str(PRIVILEGED_TAINT_ACTIONS, dst_action);
    if is_privileged and out_tainted and not human_approved {
        return map{
            ok: false,
            blocked: true,
            error: "STRICT_TAINT_PRIVILEGED_ACTION_BLOCKED",
            action: dst_action,
            tainted: true,
            human_gate_approved: false,
            transport: transport,
            q_regime: qr,
            taint_chain: new_chain
        };
    }

    let delivered = map{
        schema: obj_schema,
        payload: typed_obj.payload,
        tainted: out_tainted,
        human_gate_approved: human_approved,
        taint_chain: new_chain
    };

    let pipe_digest = PhysCrypto.sha512_hex(
        "MORPHIC-PIPE|" + qr + "|" + transport + "|" + src_id + "|" + dst_id + "|" +
        obj_schema + "|" + str(out_tainted) + "|" + str(typed_obj.payload)
    );

    return map{
        ok: true,
        blocked: false,
        transport: transport,
        q_regime: qr,
        action: dst_action,
        tainted: out_tainted,
        human_gate_approved: human_approved,
        delivered_obj: delivered,
        pipe_digest_sha512: pipe_digest
    };
}

export PBCAP_HAL_VERSION, PBCAP_V2_MAGIC;
export FORBIDDEN_CEILING_CAPS, ALLOWED_CAP_DOMAINS, PRIVILEGED_TAINT_ACTIONS;
export pbcap_check_constitutional_ceiling;
export pbcap_v2_pack, pbcap_v2_verify_and_unpack;
export pbcap_lazy_registry_new, pbcap_lazy_register, pbcap_lazy_load;
export morphic_hal_create, morphic_pipe_send;
