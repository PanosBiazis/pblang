let PhysCrypto = import("stdlib:crypto/physics_bound_3family_its.sapp");

let GLASS_ELASTIC_VERSION = "5.4.0";

let SHUTTER_SUPPORTED_DEVICES = ["camera", "microphone"];
let PRIVILEGED_TAINT_SINKS = ["net:send", "fs:delete", "hw:write"];
let SENSITIVE_TAINT_CLASSES = [
    "confidential_pii",
    "medical_hipaa",
    "financial_mydata",
    "secret_key"
];
let ELASTIC_TRUST_ZONES = [
    "T0_SOVEREIGN_LOCAL",
    "T1_ATTESTED_PRIVATE_MESH",
    "T2_CONFIDENTIAL_TEE_CLOUD",
    "T3_UNTRUSTED_COMPUTE"
];
let ELASTIC_SUBSTRATES = [
    "CPU",
    "GPU",
    "TPU",
    "NPU",
    "QPU",
    "PHOTONIC",
    "NEUROMORPHIC",
    "EDGE_MCU"
];

// ============================================================================
// Internal Utility Helpers (Pure PBLang)
// ============================================================================

fn _arr_has_str(arr, target) {
    let t = str(target);
    let i = 0;
    while i < len(arr) {
        if str(arr[i]) == t { return true; }
        i = i + 1;
    }
    return false;
}

fn _map_get(m, key, default_val) {
    if is_map(m) and map_has(m, key) {
        return m[key];
    }
    return default_val;
}

fn _is_digit_byte(b) {
    return b >= 48 and b <= 57;
}

fn _is_upper_byte(b) {
    return b >= 65 and b <= 90;
}

fn _is_lower_byte(b) {
    return b >= 97 and b <= 122;
}

fn _is_alpha_byte(b) {
    return _is_upper_byte(b) or _is_lower_byte(b);
}

fn _is_alnum_byte(b) {
    return _is_alpha_byte(b) or _is_digit_byte(b);
}

fn _is_email_local_byte(b) {
    // a-z A-Z 0-9 . _ % + -
    return _is_alnum_byte(b) or b == 46 or b == 95 or b == 37 or b == 43 or b == 45;
}

fn _is_email_domain_byte(b) {
    // a-z A-Z 0-9 . -
    return _is_alnum_byte(b) or b == 46 or b == 45;
}

fn _is_ws_byte(b) {
    return b == 32 or b == 9 or b == 10 or b == 13;
}

fn _starts_with_at(s, idx, needle) {
    let ln = len(needle);
    if idx + ln > len(s) { return false; }
    return str_slice(s, idx, idx + ln) == needle;
}

fn _find_substr_from(s, needle, start_idx) {
    let ls = len(s);
    let ln = len(needle);
    if ln == 0 { return start_idx; }
    let i = start_idx;
    while i + ln <= ls {
        if str_slice(s, i, i + ln) == needle {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn _pow2_int(exp) {
    if exp <= 0 { return 1; }
    let capped = if exp > 30 { 30 } else { exp };
    let v = 1;
    let i = 0;
    while i < capped {
        v = v * 2;
        i = i + 1;
    }
    return v;
}

// ============================================================================
// 1. 240Hz Sovereign Morphic Glass Compositor, Trusted Path & Privacy Shutter
//    (Invariants #13, #15, #21)
// ============================================================================

fn morphic_glass_compositor_new(width, height, refresh_hz = 240) {
    let w = if width > 0 { width } else { 1920 };
    let h = if height > 0 { height } else { 1080 };
    let hz = if refresh_hz > 0 { refresh_hz } else { 240 };
    let budget_ms = 1000.0 / hz;
    return map{
        version: GLASS_ELASTIC_VERSION,
        width: w,
        height: h,
        refresh_hz: hz,
        frame_budget_ms: budget_ms,
        surfaces: [],
        anti_capture_active: false,
        frame_count: 0
    };
}

fn _sort_surfaces_by_z(surfaces) {
    let ordered = [];
    let i = 0;
    while i < len(surfaces) {
        let s = surfaces[i];
        let z = _map_get(s, "z_index", i);
        let item = map{
            surface: s,
            z: z,
            order: i
        };
        push(ordered, item);
        let j = len(ordered) - 1;
        while j > 0 and ordered[j - 1].z > ordered[j].z {
            let tmp = ordered[j - 1];
            ordered[j - 1] = ordered[j];
            ordered[j] = tmp;
            j = j - 1;
        }
        i = i + 1;
    }
    let out = [];
    let k = 0;
    while k < len(ordered) {
        push(out, ordered[k].surface);
        k = k + 1;
    }
    return out;
}

fn morphic_glass_compose_frame(comp, surfaces, capture_requester = nil) {
    let raw_surfaces = if is_array(surfaces) { surfaces } else { [] };
    let ordered = _sort_surfaces_by_z(raw_surfaces);
    let is_capture = capture_requester != nil and str(capture_requester) != "";

    let display_buffer = [];
    let captured_buffer = if is_capture { [] } else { nil };
    let redacted_ids = [];
    let any_anti_capture = false;
    let total_render_ms = 0.25;

    let i = 0;
    while i < len(ordered) {
        let s = ordered[i];
        let sid = str(_map_get(s, "id", "surface_" + str(i)));
        let sx = _map_get(s, "x", 0);
        let sy = _map_get(s, "y", 0);
        let sw = _map_get(s, "w", comp.width);
        let sh = _map_get(s, "h", comp.height);
        let sz = _map_get(s, "z_index", i);
        let ac = _map_get(s, "anti_capture", false) == true;
        let pixels = _map_get(s, "pixels", [255, 255, 255, 255]);
        let content = _map_get(s, "content", "");
        let surf_ms = _map_get(s, "render_ms", 0.15);
        total_render_ms = total_render_ms + surf_ms;

        if ac {
            any_anti_capture = true;
        }

        // Physical display always renders the surface normally
        push(display_buffer, map{
            id: sid,
            z_index: sz,
            x: sx,
            y: sy,
            w: sw,
            h: sh,
            anti_capture: ac,
            redacted: false,
            pixels: pixels,
            content: content
        });

        // Capture requester receives redacted black pixels for Anti-Capture Vault surfaces
        if is_capture {
            if ac {
                push(redacted_ids, sid);
                push(captured_buffer, map{
                    id: sid,
                    z_index: sz,
                    x: sx,
                    y: sy,
                    w: sw,
                    h: sh,
                    anti_capture: true,
                    redacted: true,
                    pixels: [0, 0, 0, 255],
                    content: "[ANTI_CAPTURE_VAULT_REDACTED_BLACK]"
                });
            } else {
                push(captured_buffer, map{
                    id: sid,
                    z_index: sz,
                    x: sx,
                    y: sy,
                    w: sw,
                    h: sh,
                    anti_capture: false,
                    redacted: false,
                    pixels: pixels,
                    content: content
                });
            }
        }
        i = i + 1;
    }

    comp.surfaces = ordered;
    comp.anti_capture_active = any_anti_capture;
    comp.frame_count = comp.frame_count + 1;

    let budget_ms = comp.frame_budget_ms;
    let within_budget = total_render_ms <= budget_ms;

    return map{
        ok: true,
        frame_id: comp.frame_count,
        refresh_hz: comp.refresh_hz,
        frame_budget_ms: budget_ms,
        frame_time_ms: total_render_ms,
        headroom_ms: budget_ms - total_render_ms,
        within_budget: within_budget,
        surface_count: len(ordered),
        anti_capture_active: any_anti_capture,
        capture_requested: is_capture,
        capture_requester: capture_requester,
        redacted_surface_ids: redacted_ids,
        redacted_count: len(redacted_ids),
        display_buffer: display_buffer,
        captured_buffer: captured_buffer
    };
}

fn trusted_path_create(user_secret_sigil) {
    let sigil_str = str(user_secret_sigil);
    let sigil_hash = PhysCrypto.sha512_hex("MORPHIC_TRUSTED_PATH_SIGIL|" + sigil_str);
    return map{
        version: GLASS_ELASTIC_VERSION,
        sigil_hash: sigil_hash,
        sigil_initialized: len(sigil_str) > 0,
        auth_count: 0,
        blocked_count: 0,
        audit_log: []
    };
}

fn trusted_path_authorize(tp, action, presented_sigil, is_foreground) {
    let act = str(action);
    if not is_map(tp) or _map_get(tp, "sigil_initialized", false) != true {
        return map{
            ok: false,
            authorized: false,
            spoofing_blocked: true,
            reason: "TRUSTED_PATH_NOT_INITIALIZED",
            action: act,
            is_foreground: is_foreground == true
        };
    }

    if is_foreground != true {
        tp.blocked_count = tp.blocked_count + 1;
        push(tp.audit_log, map{
            action: act,
            authorized: false,
            spoofing_blocked: true,
            reason: "BACKGROUND_CLICKJACKING_BLOCKED"
        });
        return map{
            ok: false,
            authorized: false,
            spoofing_blocked: true,
            reason: "BACKGROUND_CLICKJACKING_BLOCKED",
            action: act,
            is_foreground: false
        };
    }

    let presented_str = if presented_sigil == nil { "" } else { str(presented_sigil) };
    let presented_hash = PhysCrypto.sha512_hex("MORPHIC_TRUSTED_PATH_SIGIL|" + presented_str);
    let sigil_matches = len(presented_str) > 0 and PhysCrypto.ct_hex_eq(tp.sigil_hash, presented_hash);

    if not sigil_matches {
        tp.blocked_count = tp.blocked_count + 1;
        push(tp.audit_log, map{
            action: act,
            authorized: false,
            spoofing_blocked: true,
            reason: "SPOOFED_SIGIL_REJECTED"
        });
        return map{
            ok: false,
            authorized: false,
            spoofing_blocked: true,
            reason: "SPOOFED_SIGIL_REJECTED",
            action: act,
            is_foreground: true
        };
    }

    tp.auth_count = tp.auth_count + 1;
    let auth_token = str_slice(
        PhysCrypto.sha512_hex("TP_GATE_OK|" + act + "|" + str(tp.auth_count) + "|" + tp.sigil_hash),
        0,
        32
    );
    push(tp.audit_log, map{
        action: act,
        authorized: true,
        spoofing_blocked: false,
        auth_token: auth_token
    });
    return map{
        ok: true,
        authorized: true,
        spoofing_blocked: false,
        reason: "TRUSTED_PATH_HUMAN_GATE_APPROVED",
        action: act,
        is_foreground: true,
        auth_token: auth_token
    };
}

fn privacy_shutter_new() {
    return map{
        version: GLASS_ELASTIC_VERSION,
        leases: map{},
        supported_devices: ["camera", "microphone"],
        auto_revoke_count: 0,
        audit_log: []
    };
}

fn _shutter_key(app_id, device_kind) {
    return str(app_id) + "::" + str(device_kind);
}

fn privacy_shutter_set_live(shutter, app_id, device_kind, trusted_path_approved, is_foreground) {
    let app = str(app_id);
    let dev = str(device_kind);
    if not _arr_has_str(SHUTTER_SUPPORTED_DEVICES, dev) {
        return map{
            ok: false,
            live: false,
            mode: "VIRTUAL_SHUTTER_DUMMY",
            error: "UNSUPPORTED_SHUTTER_DEVICE",
            app_id: app,
            device_kind: dev
        };
    }

    let key = _shutter_key(app, dev);
    let can_live = trusted_path_approved == true and is_foreground == true;

    if can_live {
        shutter.leases[key] = map{
            app_id: app,
            device_kind: dev,
            live: true,
            foreground_only: true
        };
        push(shutter.audit_log, map{
            event: "SET_LIVE_GRANTED",
            app_id: app,
            device_kind: dev
        });
        return map{
            ok: true,
            live: true,
            mode: "PHYSICAL_LIVE",
            app_id: app,
            device_kind: dev
        };
    }

    shutter.leases[key] = map{
        app_id: app,
        device_kind: dev,
        live: false,
        foreground_only: true
    };
    let reason = if trusted_path_approved != true {
        "TRUSTED_PATH_APPROVAL_REQUIRED"
    } else {
        "FOREGROUND_REQUIRED_FOR_LIVE_LEASE"
    };
    push(shutter.audit_log, map{
        event: "SET_LIVE_DENIED",
        app_id: app,
        device_kind: dev,
        reason: reason
    });
    return map{
        ok: false,
        live: false,
        mode: "VIRTUAL_SHUTTER_DUMMY",
        reason: reason,
        app_id: app,
        device_kind: dev
    };
}

fn privacy_shutter_read(shutter, app_id, device_kind, is_foreground) {
    let app = str(app_id);
    let dev = str(device_kind);
    if not _arr_has_str(SHUTTER_SUPPORTED_DEVICES, dev) {
        return map{
            ok: false,
            mode: "VIRTUAL_SHUTTER_DUMMY",
            app_crashed: false,
            error: "UNSUPPORTED_SHUTTER_DEVICE",
            data_bytes: [0, 0, 0, 0, 0, 0, 0, 0]
        };
    }

    let key = _shutter_key(app, dev);
    let has_lease = map_has(shutter.leases, key);
    let is_live = false;
    let auto_revoked = false;

    if has_lease {
        let lease = shutter.leases[key];
        if _map_get(lease, "live", false) == true {
            if is_foreground == true {
                is_live = true;
            } else {
                // Foreground-only lease auto-revoked when app moves to background
                lease.live = false;
                shutter.leases[key] = lease;
                shutter.auto_revoke_count = shutter.auto_revoke_count + 1;
                auto_revoked = true;
                push(shutter.audit_log, map{
                    event: "FOREGROUND_LEASE_AUTO_REVOKED",
                    app_id: app,
                    device_kind: dev
                });
            }
        }
    }

    if is_live {
        let live_bytes = if dev == "camera" {
            [36, 128, 204, 255, 48, 144, 216, 255]
        } else {
            [14, 42, 19, 85, 9, 61, 27, 94]
        };
        return map{
            ok: true,
            mode: "PHYSICAL_LIVE",
            app_crashed: false,
            auto_revoked: false,
            app_id: app,
            device_kind: dev,
            data_bytes: live_bytes,
            payload_kind: if dev == "camera" { "PHYSICAL_CAMERA_FRAME" } else { "PHYSICAL_MIC_PCM" }
        };
    }

    return map{
        ok: true,
        mode: "VIRTUAL_SHUTTER_DUMMY",
        app_crashed: false,
        auto_revoked: auto_revoked,
        app_id: app,
        device_kind: dev,
        data_bytes: [0, 0, 0, 0, 0, 0, 0, 0],
        payload_kind: if dev == "camera" { "VALID_BLACK_FRAME" } else { "VALID_SILENT_PCM" }
    };
}

// ============================================================================
// 2. Runtime --strict-taint Propagation Engine, PII Redaction & Quotas
//    (Invariants #3, #7, #20)
// ============================================================================

fn _taint_class_rank(cls) {
    let c = str(cls);
    if c == "public" { return 0; }
    if c == "internal" { return 1; }
    if c == "untrusted_external" or c == "network" or c == "user_input" { return 2; }
    if c == "confidential_pii" { return 3; }
    if c == "financial_mydata" { return 4; }
    if c == "medical_hipaa" { return 5; }
    if c == "secret_key" or c == "top_secret" { return 6; }
    return 2;
}

fn taint_wrap(value, origin, classification) {
    let orig = str(origin);
    let cls = str(classification);
    let tainted = orig != "trusted_local";
    return map{
        __taint__: true,
        value: value,
        tainted: tainted,
        origin: orig,
        classification: cls
    };
}

fn _unwrap_taint_meta(x) {
    if is_map(x) and _map_get(x, "__taint__", false) == true {
        return x;
    }
    return map{
        __taint__: true,
        value: x,
        tainted: false,
        origin: "trusted_local",
        classification: "public"
    };
}

fn taint_combine(a, b, combined_value) {
    let ta = _unwrap_taint_meta(a);
    let tb = _unwrap_taint_meta(b);
    let tainted = (ta.tainted == true) or (tb.tainted == true);
    let ra = _taint_class_rank(ta.classification);
    let rb = _taint_class_rank(tb.classification);
    let strictest_cls = if rb > ra { tb.classification } else { ta.classification };

    let orig = ta.origin;
    if ta.origin == tb.origin {
        orig = ta.origin;
    } else if ta.origin == "trusted_local" {
        orig = tb.origin;
    } else if tb.origin == "trusted_local" {
        orig = ta.origin;
    } else {
        orig = ta.origin + "+" + tb.origin;
    }

    return map{
        __taint__: true,
        value: combined_value,
        tainted: tainted,
        origin: orig,
        classification: strictest_cls
    };
}

fn _match_email_end(bytes, start) {
    let n = len(bytes);
    let i = start;
    while i < n and _is_email_local_byte(bytes[i]) {
        i = i + 1;
    }
    if i == start or i >= n or bytes[i] != 64 {
        return -1;
    }
    // Past '@'
    let dom_start = i + 1;
    let j = dom_start;
    let dot_pos = -1;
    while j < n and _is_email_domain_byte(bytes[j]) {
        if bytes[j] == 46 { dot_pos = j; }
        j = j + 1;
    }
    if dot_pos <= dom_start or dot_pos >= j - 2 {
        return -1;
    }
    // Check TLD has letters
    let t = dot_pos + 1;
    while t < j {
        if not _is_alpha_byte(bytes[t]) { return -1; }
        t = t + 1;
    }
    // Ensure preceding char isn't email-local (avoid partial match)
    if start > 0 and _is_email_local_byte(bytes[start - 1]) {
        return -1;
    }
    return j;
}

fn _match_iban_end(bytes, start) {
    let n = len(bytes);
    // Boundary check
    if start > 0 and _is_alnum_byte(bytes[start - 1]) {
        return -1;
    }
    if start + 15 > n {
        return -1;
    }
    // 2 uppercase country letters + 2 check digits
    if not _is_upper_byte(bytes[start]) or not _is_upper_byte(bytes[start + 1]) {
        return -1;
    }
    if not _is_digit_byte(bytes[start + 2]) or not _is_digit_byte(bytes[start + 3]) {
        return -1;
    }
    let j = start + 4;
    let digit_count = 2;
    while j < n and (_is_upper_byte(bytes[j]) or _is_digit_byte(bytes[j])) and (j - start) < 34 {
        if _is_digit_byte(bytes[j]) { digit_count = digit_count + 1; }
        j = j + 1;
    }
    let total_len = j - start;
    if total_len < 15 or total_len > 34 or digit_count < 10 {
        return -1;
    }
    if j < n and _is_alnum_byte(bytes[j]) {
        return -1;
    }
    return j;
}

fn taint_redact_pii(text) {
    let s = str(text);
    let bytes = str_to_bytes(s);
    let n = len(bytes);
    let out = "";
    let count = 0;
    let kinds = [];
    let i = 0;

    while i < n {
        // 1. Private key blocks: BEGIN ... PRIVATE KEY
        if _starts_with_at(s, i, "-----BEGIN ") {
            let pk_pos = _find_substr_from(s, "PRIVATE KEY-----", i);
            if pk_pos >= 0 and pk_pos - i <= 48 {
                let end_marker = _find_substr_from(s, "PRIVATE KEY-----", pk_pos + 16);
                let stop_idx = if end_marker >= 0 {
                    end_marker + 16
                } else {
                    n
                };
                out = out + "[REDACTED_PRIVATE_KEY]";
                count = count + 1;
                push(kinds, "private_key");
                i = stop_idx;
                continue;
            }
        }
        if _starts_with_at(s, i, "BEGIN PRIVATE KEY") {
            let stop_idx = i + 17;
            while stop_idx < n and bytes[stop_idx] != 10 {
                stop_idx = stop_idx + 1;
            }
            out = out + "[REDACTED_PRIVATE_KEY]";
            count = count + 1;
            push(kinds, "private_key");
            i = stop_idx;
            continue;
        }

        // 2. API_KEY=<token>
        if _starts_with_at(s, i, "API_KEY=") {
            let j = i + 8;
            while j < n and not _is_ws_byte(bytes[j]) and bytes[j] != 44 and bytes[j] != 59 and bytes[j] != 34 and bytes[j] != 39 {
                j = j + 1;
            }
            out = out + "API_KEY=[REDACTED_API_KEY]";
            count = count + 1;
            push(kinds, "api_key");
            i = j;
            continue;
        }

        // 3. Email address
        let email_end = _match_email_end(bytes, i);
        if email_end > i {
            out = out + "[REDACTED_EMAIL]";
            count = count + 1;
            push(kinds, "email");
            i = email_end;
            continue;
        }

        // 4. IBAN
        let iban_end = _match_iban_end(bytes, i);
        if iban_end > i {
            out = out + "[REDACTED_IBAN]";
            count = count + 1;
            push(kinds, "iban");
            i = iban_end;
            continue;
        }

        // 5. Standalone 11-digit AMKA or 9-digit AFM sequences
        if _is_digit_byte(bytes[i]) and (i == 0 or not _is_alnum_byte(bytes[i - 1])) {
            let j = i;
            while j < n and _is_digit_byte(bytes[j]) {
                j = j + 1;
            }
            let dlen = j - i;
            let right_ok = (j == n) or (not _is_alnum_byte(bytes[j]));
            if right_ok and dlen == 11 {
                out = out + "[REDACTED_AMKA]";
                count = count + 1;
                push(kinds, "amka_11digit");
                i = j;
                continue;
            }
            if right_ok and dlen == 9 {
                out = out + "[REDACTED_AFM]";
                count = count + 1;
                push(kinds, "afm_9digit");
                i = j;
                continue;
            }
        }

        out = out + str_slice(s, i, i + 1);
        i = i + 1;
    }

    return map{
        ok: true,
        redacted_text: out,
        redactions_count: count,
        redacted_kinds: kinds
    };
}

fn taint_enforce_sink(tval, sink_action, human_gate_approved) {
    let meta = _unwrap_taint_meta(tval);
    let sink = str(sink_action);
    let approved = human_gate_approved == true;
    let is_priv = _arr_has_str(PRIVILEGED_TAINT_SINKS, sink);
    let is_sens = _arr_has_str(SENSITIVE_TAINT_CLASSES, meta.classification);

    if is_priv and meta.tainted == true and not approved {
        return map{
            ok: false,
            allowed: false,
            blocked_by_strict_taint: true,
            blocked_by_classification: is_sens,
            requires_human_gate: true,
            reason: "STRICT_TAINT_BLOCKED_PRIVILEGED_SINK",
            sink_action: sink,
            origin: meta.origin,
            classification: meta.classification
        };
    }

    if is_sens and not approved {
        let pii_scan = if is_string(meta.value) {
            taint_redact_pii(meta.value)
        } else {
            map{ redacted_text: "", redactions_count: 0 }
        };
        return map{
            ok: false,
            allowed: false,
            blocked_by_strict_taint: meta.tainted == true,
            blocked_by_classification: true,
            requires_redaction_or_gate: true,
            pii_detected_count: pii_scan.redactions_count,
            suggested_redacted_text: pii_scan.redacted_text,
            reason: "SENSITIVE_CLASSIFICATION_REQUIRES_REDACTION_OR_GATE",
            sink_action: sink,
            origin: meta.origin,
            classification: meta.classification
        };
    }

    return map{
        ok: true,
        allowed: true,
        blocked_by_strict_taint: false,
        blocked_by_classification: false,
        sink_action: sink,
        origin: meta.origin,
        classification: meta.classification,
        human_gate_approved: approved
    };
}

fn quota_guard_eval(capsule_quota, req_iops, req_storage_bytes, crashes_last_sec) {
    let max_iops = _map_get(capsule_quota, "max_iops", 1000);
    let max_storage = _map_get(capsule_quota, "max_storage_bytes", 104857600);
    let used_storage = _map_get(capsule_quota, "used_storage_bytes", 0);

    let projected_storage = used_storage + req_storage_bytes;
    let iops_exceeded = req_iops > max_iops;
    let storage_exceeded = projected_storage > max_storage;

    let quarantined = crashes_last_sec >= 5;
    let backoff_ms = if quarantined {
        1000 * _pow2_int(crashes_last_sec - 5)
    } else {
        0
    };

    let allowed = (not iops_exceeded) and (not storage_exceeded) and (not quarantined);
    let reason = "QUOTA_OK";
    if quarantined {
        reason = "EXPONENTIAL_BACKOFF_QUARANTINE";
    } else if iops_exceeded {
        reason = "IOPS_CEILING_EXCEEDED_DOS_BLOCKED";
    } else if storage_exceeded {
        reason = "STORAGE_CEILING_EXCEEDED_SNAPSHOT_FLOOD_BLOCKED";
    }

    return map{
        ok: allowed,
        allowed: allowed,
        reason: reason,
        iops_exceeded: iops_exceeded,
        storage_exceeded: storage_exceeded,
        snapshot_flood_dos_blocked: iops_exceeded or storage_exceeded,
        quarantined: quarantined,
        backoff_ms: backoff_ms,
        crashes_last_sec: crashes_last_sec,
        req_iops: req_iops,
        max_iops: max_iops,
        projected_storage_bytes: projected_storage,
        max_storage_bytes: max_storage
    };
}

// ============================================================================
// 3. Morphic Sovereign Elastic Fabric — Zero-Trust Attested Scale Up/Down/Out/In
//    (Invariants #17 & #18)
// ============================================================================

fn elastic_fabric_new(policy) {
    let min_cap = _map_get(policy, "min_capacity", 1);
    let max_cost = _map_get(policy, "max_cost_eur", 100.0);
    let max_watts = _map_get(policy, "max_watts", 500.0);
    let min_q = _map_get(policy, "min_q_regime", 1);

    let norm_policy = map{
        min_capacity: min_cap,
        max_cost_eur: max_cost,
        max_watts: max_watts,
        min_q_regime: min_q
    };

    return map{
        version: GLASS_ELASTIC_VERSION,
        policy: norm_policy,
        min_capacity: min_cap,
        max_cost_eur: max_cost,
        max_watts: max_watts,
        min_q_regime: min_q,
        nodes: map{},
        quarantined_nodes: map{},
        shred_audit_log: [],
        key_seq: 0
    };
}

fn _classify_trust_zone(node_spec) {
    let explicit_tz = _map_get(node_spec, "trust_zone", "");
    if _arr_has_str(ELASTIC_TRUST_ZONES, explicit_tz) {
        return str(explicit_tz);
    }
    let locality = str(_map_get(node_spec, "locality", "cloud"));
    let has_tee = _map_get(node_spec, "has_tee", false) == true;
    if locality == "local" or locality == "sovereign_local" {
        return "T0_SOVEREIGN_LOCAL";
    }
    if locality == "private_mesh" or locality == "mesh" {
        return "T1_ATTESTED_PRIVATE_MESH";
    }
    if has_tee {
        return "T2_CONFIDENTIAL_TEE_CLOUD";
    }
    return "T3_UNTRUSTED_COMPUTE";
}

fn elastic_admit_node(fabric, node_spec) {
    let nid = str(_map_get(node_spec, "node_id", ""));
    if len(nid) == 0 {
        return map{
            ok: false,
            admitted: false,
            rejected_reason: "MISSING_NODE_ID",
            bytes_sent: 0
        };
    }

    // Immediate zero-byte rejections before 1 byte is transmitted
    if map_has(fabric.quarantined_nodes, nid) {
        return map{
            ok: false,
            admitted: false,
            node_id: nid,
            rejected_reason: "NODE_PERMANENTLY_QUARANTINED",
            bytes_sent: 0
        };
    }
    if _map_get(node_spec, "infected", false) == true {
        return map{
            ok: false,
            admitted: false,
            node_id: nid,
            rejected_reason: "NODE_INFECTED_REJECTED_BEFORE_TRANSMIT",
            bytes_sent: 0
        };
    }
    if _map_get(node_spec, "unpatched_exposed", false) == true {
        return map{
            ok: false,
            admitted: false,
            node_id: nid,
            rejected_reason: "NODE_UNPATCHED_EXPOSED_REJECTED",
            bytes_sent: 0
        };
    }
    if _map_get(node_spec, "attestation_valid", false) != true {
        return map{
            ok: false,
            admitted: false,
            node_id: nid,
            rejected_reason: "ROGUE_OR_SYBIL_ATTESTATION_FAILED",
            bytes_sent: 0
        };
    }
    if _map_get(node_spec, "sig_3family_valid", false) != true {
        return map{
            ok: false,
            admitted: false,
            node_id: nid,
            rejected_reason: "HYBRID_3FAMILY_SIGNATURE_INVALID",
            bytes_sent: 0
        };
    }

    let substrate = str(_map_get(node_spec, "substrate", "CPU"));
    if not _arr_has_str(ELASTIC_SUBSTRATES, substrate) {
        return map{
            ok: false,
            admitted: false,
            node_id: nid,
            rejected_reason: "UNSUPPORTED_SUBSTRATE_" + substrate,
            bytes_sent: 0
        };
    }

    let tz = _classify_trust_zone(node_spec);
    fabric.key_seq = fabric.key_seq + 1;
    let key_hash = PhysCrypto.sha512_hex(
        "ELASTIC_EPH_KEY|" + nid + "|" + tz + "|" + substrate + "|" + str(fabric.key_seq)
    );
    let eph_key_id = "EPH-" + str(fabric.key_seq) + "-" + str_slice(key_hash, 0, 24);

    let cap = _map_get(node_spec, "capacity", 1);
    let cost = _map_get(node_spec, "cost_eur", 0.0);
    let watts = _map_get(node_spec, "watts", 50.0);
    let q_reg = _map_get(node_spec, "q_regime", 1);

    let record = map{
        node_id: nid,
        trust_zone: tz,
        substrate: substrate,
        capacity: cap,
        cost_eur: cost,
        watts: watts,
        q_regime: q_reg,
        ephemeral_key_id: eph_key_id,
        ephemeral_key_active: true,
        status: "ACTIVE",
        admitted: true
    };
    fabric.nodes[nid] = record;

    return map{
        ok: true,
        admitted: true,
        node_id: nid,
        trust_zone: tz,
        substrate: substrate,
        ephemeral_key_id: eph_key_id,
        bytes_sent: 0
    };
}

fn _elastic_fleet_totals(fabric, exclude_node_id) {
    let keys = map_keys(fabric.nodes);
    let total_cap = 0;
    let total_cost = 0.0;
    let total_watts = 0.0;
    let max_q = 0;
    let active_count = 0;
    let i = 0;
    while i < len(keys) {
        let k = keys[i];
        let node = fabric.nodes[k];
        if k != exclude_node_id and _map_get(node, "status", "") == "ACTIVE" {
            total_cap = total_cap + _map_get(node, "capacity", 0);
            total_cost = total_cost + _map_get(node, "cost_eur", 0.0);
            total_watts = total_watts + _map_get(node, "watts", 0.0);
            let q = _map_get(node, "q_regime", 0);
            if q > max_q { max_q = q; }
            active_count = active_count + 1;
        }
        i = i + 1;
    }
    return map{
        capacity: total_cap,
        cost_eur: total_cost,
        watts: total_watts,
        max_q_regime: max_q,
        active_count: active_count
    };
}

fn elastic_scale_request(fabric, req) {
    let action = str(_map_get(req, "action", _map_get(req, "direction", "")));
    let valid_actions = ["scale_up", "scale_out", "scale_down", "scale_in"];
    if not _arr_has_str(valid_actions, action) {
        return map{
            ok: false,
            allowed: false,
            error: "INVALID_SCALE_ACTION",
            action: action
        };
    }

    let policy = fabric.policy;
    let target_id = str(_map_get(req, "target_node_id", ""));
    let cur = _elastic_fleet_totals(fabric, "");

    if action == "scale_up" or action == "scale_out" {
        let delta_cost = _map_get(req, "delta_cost_eur", _map_get(req, "cost_eur", 0.0));
        let delta_watts = _map_get(req, "delta_watts", _map_get(req, "watts", 0.0));
        let projected_cost = _map_get(req, "projected_cost_eur", cur.cost_eur + delta_cost);
        let projected_watts = _map_get(req, "projected_watts", cur.watts + delta_watts);
        let human_approved = _map_get(req, "human_gate_approved", false) == true;

        // 1. Anti-Bill-Shock / Anti-Economic-DoS
        if (projected_cost > policy.max_cost_eur or projected_watts > policy.max_watts) and not human_approved {
            let reason = if projected_cost > policy.max_cost_eur {
                "BILL_SHOCK_MAX_COST_EXCEEDED"
            } else {
                "POWER_BUDGET_MAX_WATTS_EXCEEDED"
            };
            return map{
                ok: false,
                allowed: false,
                action: action,
                blocked_bill_shock: true,
                requires_human_gate: true,
                reason: reason,
                projected_cost_eur: projected_cost,
                max_cost_eur: policy.max_cost_eur,
                projected_watts: projected_watts,
                max_watts: policy.max_watts
            };
        }

        // 2. Verifiable Blind Offloading for T2/T3 zones
        let tz = str(_map_get(req, "target_trust_zone", ""));
        if len(tz) == 0 and len(target_id) > 0 and map_has(fabric.nodes, target_id) {
            tz = fabric.nodes[target_id].trust_zone;
        }
        let is_untrusted_tier = tz == "T2_CONFIDENTIAL_TEE_CLOUD" or tz == "T3_UNTRUSTED_COMPUTE";
        let contains_raw_secrets = _map_get(req, "contains_raw_secrets", false) == true;
        let blind_mode = str(_map_get(req, "blind_mode", ""));
        let has_valid_blind = blind_mode == "TEE" or blind_mode == "UBQC";

        if is_untrusted_tier {
            if contains_raw_secrets and not has_valid_blind {
                return map{
                    ok: false,
                    allowed: false,
                    action: action,
                    raw_secret_offload_blocked: true,
                    reason: "RAW_SECRETS_FORBIDDEN_ON_T2_T3_WITHOUT_BLIND_MODE",
                    target_trust_zone: tz
                };
            }
            if has_valid_blind {
                let spot_ok = _map_get(req, "spot_check_verified", false) == true;
                if not spot_ok {
                    return map{
                        ok: false,
                        allowed: false,
                        action: action,
                        poisoned_result_rejected: true,
                        spot_check_verified: false,
                        reason: "BLIND_OFFLOAD_SPOT_CHECK_FAILED_POISONED_RESULT_REJECTED",
                        blind_mode: blind_mode,
                        target_trust_zone: tz
                    };
                }
            }
        }

        // Apply optional capacity update on existing node
        if len(target_id) > 0 and map_has(fabric.nodes, target_id) {
            let delta_cap = _map_get(req, "delta_capacity", 0);
            if delta_cap > 0 {
                let node = fabric.nodes[target_id];
                node.capacity = node.capacity + delta_cap;
                node.cost_eur = node.cost_eur + delta_cost;
                node.watts = node.watts + delta_watts;
                fabric.nodes[target_id] = node;
            }
        }

        return map{
            ok: true,
            allowed: true,
            action: action,
            blocked_bill_shock: false,
            raw_secret_offload_blocked: false,
            poisoned_result_rejected: false,
            blind_mode: blind_mode,
            spot_check_verified: _map_get(req, "spot_check_verified", false) == true,
            target_trust_zone: tz,
            projected_cost_eur: projected_cost,
            projected_watts: projected_watts
        };
    }

    // scale_down / scale_in: Anti-Forced-Scale-Down / Starvation protection
    let after = if len(target_id) > 0 and map_has(fabric.nodes, target_id) {
        _elastic_fleet_totals(fabric, target_id)
    } else {
        let dcap = _map_get(req, "delta_capacity", 1);
        map{
            capacity: cur.capacity - dcap,
            max_q_regime: cur.max_q_regime
        }
    };
    let projected_cap = _map_get(req, "projected_capacity", after.capacity);
    let projected_q = _map_get(req, "projected_q_regime", after.max_q_regime);

    if projected_cap < policy.min_capacity or projected_q < policy.min_q_regime {
        let reason = if projected_cap < policy.min_capacity {
            "FORCED_SCALE_DOWN_BELOW_MIN_CAPACITY_BLOCKED"
        } else {
            "FORCED_SCALE_DOWN_VIOLATES_MIN_Q_REGIME_BLOCKED"
        };
        return map{
            ok: false,
            allowed: false,
            action: action,
            fail_closed_starvation_blocked: true,
            reason: reason,
            projected_capacity: projected_cap,
            min_capacity: policy.min_capacity,
            projected_q_regime: projected_q,
            min_q_regime: policy.min_q_regime
        };
    }

    return map{
        ok: true,
        allowed: true,
        action: action,
        fail_closed_starvation_blocked: false,
        projected_capacity: projected_cap,
        projected_q_regime: projected_q
    };
}

fn _find_healthy_sovereign_target(fabric, exclude_id) {
    let keys = map_keys(fabric.nodes);
    let t1_fallback = "";
    let i = 0;
    while i < len(keys) {
        let k = keys[i];
        if k != exclude_id {
            let n = fabric.nodes[k];
            if _map_get(n, "status", "") == "ACTIVE" {
                if n.trust_zone == "T0_SOVEREIGN_LOCAL" {
                    return map{ node_id: k, trust_zone: "T0_SOVEREIGN_LOCAL" };
                }
                if n.trust_zone == "T1_ATTESTED_PRIVATE_MESH" and len(t1_fallback) == 0 {
                    t1_fallback = k;
                }
            }
        }
        i = i + 1;
    }
    if len(t1_fallback) > 0 {
        return map{ node_id: t1_fallback, trust_zone: "T1_ATTESTED_PRIVATE_MESH" };
    }
    return map{ node_id: "", trust_zone: "" };
}

fn elastic_quarantine_infected_node(fabric, node_id, reason) {
    let nid = str(node_id);
    if not map_has(fabric.nodes, nid) {
        return map{
            ok: false,
            error: "NODE_NOT_FOUND",
            node_id: nid
        };
    }

    let node = fabric.nodes[nid];
    let revoked_key = _map_get(node, "ephemeral_key_id", "");
    node.ephemeral_key_active = false;
    node.ephemeral_key_id = "";
    node.status = "QUARANTINED";
    fabric.nodes[nid] = node;

    let target = _find_healthy_sovereign_target(fabric, nid);
    let migrated = len(target.node_id) > 0;

    let q_record = map{
        node_id: nid,
        reason: str(reason),
        revoked_key_id: revoked_key,
        one_way_quarantine: true,
        migrated_from_chronovault: migrated,
        migration_target_node_id: target.node_id,
        migration_target_zone: target.trust_zone,
        infected_state_absorbed_back: false
    };
    fabric.quarantined_nodes[nid] = q_record;

    push(fabric.shred_audit_log, map{
        event: "ONE_WAY_QUARANTINE_KEY_REVOKED",
        node_id: nid,
        revoked_key_id: revoked_key,
        migrated_from_chronovault: migrated,
        migration_target_node_id: target.node_id,
        infected_state_absorbed_back: false,
        reason: str(reason)
    });

    return map{
        ok: true,
        node_id: nid,
        quarantined: true,
        one_way_quarantine: true,
        ephemeral_key_revoked: true,
        revoked_key_id: revoked_key,
        migrated_from_chronovault: migrated,
        migration_target_node_id: target.node_id,
        migration_target_zone: target.trust_zone,
        infected_state_absorbed_back: false,
        reason: str(reason)
    };
}

fn elastic_scale_down_crypto_shred(fabric, node_id) {
    let nid = str(node_id);
    if not map_has(fabric.nodes, nid) {
        return map{
            ok: false,
            error: "NODE_NOT_FOUND",
            node_id: nid
        };
    }

    let node = fabric.nodes[nid];
    let destroyed_key = _map_get(node, "ephemeral_key_id", "");
    node.ephemeral_key_id = "";
    node.ephemeral_key_active = false;
    node.status = "CRYPTO_SHREDDED";
    fabric.nodes[nid] = node;

    let seq = len(fabric.shred_audit_log);
    let proof_hash = PhysCrypto.sha512_hex(
        "CRYPTO_SHRED|" + nid + "|" + destroyed_key + "|" + str(seq)
    );

    let audit_entry = map{
        event: "SCALE_DOWN_CRYPTO_SHRED",
        node_id: nid,
        destroyed_key_id: destroyed_key,
        ephemeral_key_destroyed: true,
        ram_zeroized: true,
        vram_zeroized: true,
        disk_zeroized: true,
        residual_recoverable_bytes: 0,
        shred_proof_hash: proof_hash
    };
    push(fabric.shred_audit_log, audit_entry);

    return map{
        ok: true,
        node_id: nid,
        status: "CRYPTO_SHREDDED",
        ephemeral_key_destroyed: true,
        destroyed_key_id: destroyed_key,
        ram_zeroized: true,
        vram_zeroized: true,
        disk_zeroized: true,
        residual_recoverable_bytes: 0,
        shred_proof_hash: proof_hash,
        audit_log_index: seq
    };
}

