// stdlib/release_channel.sapp
//
// Optional, build-time release identity for PBLang and applications built with
// PBLang.  The numeric package version remains independent so existing
// manifests, registries and versionCode values keep their original meaning.

let MAX_CHANNEL_BYTES = 48;

fn _option(options, key, fallback) {
    if options == nil { return fallback; }
    let value = try options[key] catch nil;
    if value == nil { return fallback; }
    return value;
}

fn _boolean(options, key, fallback) {
    let value = _option(options, key, fallback);
    if type(value) != "bool" {
        return map{ ok:false, error:key + " must be a boolean" };
    }
    return map{ ok:true, value:value };
}

fn _ascii_lower(value) {
    let out = ""; let i = 0;
    while i < len(value) {
        let c = strcharcodeat(value, i);
        if c >= 65 and c <= 90 { c = c + 32; }
        out = out + strfromcharcode(c);
        i = i + 1;
    }
    return out;
}

fn _valid_identifier(value) {
    if type(value) != "string" or value == "" or len(value) > MAX_CHANNEL_BYTES {
        return false;
    }
    let previous_dot = false; let i = 0;
    while i < len(value) {
        let c = strcharcodeat(value, i);
        if not ((c >= 48 and c <= 57) or (c >= 65 and c <= 90)
            or (c >= 97 and c <= 122)) and c != 45 and c != 46 { return false; }
        if c == 46 {
            if i == 0 or i == len(value) - 1 or previous_dot { return false; }
            previous_dot = true;
        } else {
            previous_dot = false;
        }
        i = i + 1;
    }
    return true;
}

fn _known_base(channel) {
    let first = str_split(channel, ".")[0];
    let known = ["stable", "release", "lts", "alpha", "alpha-beta", "alphabeta",
        "beta", "rc", "preview", "debug", "nightly", "dev", "canary", "edge"];
    for item in known { if first == item { return true; } }
    return false;
}

fn _stability(channel) {
    let first = str_split(channel, ".")[0];
    if first == "stable" or first == "release" or first == "lts" { return "stable"; }
    if first == "debug" or first == "dev" or first == "nightly" or first == "canary"
        or first == "edge" { return "development"; }
    return "prerelease";
}

fn resolve(base_version, options = nil) {
    let base = str(base_version ?? "");
    if base == "" or len(base) > 64 {
        return map{ ok:false, error:"base version must contain 1 to 64 bytes" };
    }
    let raw = _option(options, "release_channel", "");
    if type(raw) != "string" {
        return map{ ok:false, error:"release_channel must be a string" };
    }
    let channel = _ascii_lower(str_trim(raw));
    if channel != "" and not _valid_identifier(channel) {
        return map{ ok:false, error:"release_channel must use 1 to 48 ASCII letters, digits, dots, or hyphens" };
    }
    let show = _boolean(options, "show_release_channel", false);
    if not show.ok { return show; }
    let artifact = _boolean(options, "release_channel_in_artifact", false);
    if not artifact.ok { return artifact; }

    let qualified = base;
    if channel != "" { qualified = base + "-" + channel; }
    return map{
        ok:true, base_version:base, release_channel:channel,
        qualified_version:qualified,
        application_version:if channel != "" and show.value { qualified } else { base },
        artifact_suffix:if channel != "" and artifact.value { "-" + channel } else { "" },
        show_release_channel:show.value,
        release_channel_in_artifact:artifact.value,
        known_channel:channel == "" or _known_base(channel),
        custom_channel:channel != "" and not _known_base(channel),
        stability:if channel == "" { "unspecified" } else { _stability(channel) },
        runtime_overhead:false
    };
}

fn artifact_base(path, options = nil) {
    // A neutral version is sufficient because artifact naming consumes only
    // the validated channel and its explicit filename opt-in.
    let plan = resolve("0.0.0", options);
    if not plan.ok { return plan; }
    plan.path = str(path) + plan.artifact_suffix;
    return plan;
}

export MAX_CHANNEL_BYTES, resolve, artifact_base;
