// stdlib/blocks.sapp -- pblang-native block programming model.
//
// Blocks are plain maps so native IDEs, web designers, saved project files, and
// code generators can share one portable shape. The module is intentionally
// backend-neutral: it does not draw Blockly-style UI itself; it converts block
// graphs to pblang code and can mix generated blocks with handwritten code.

fn workspace() { return map{ kind: "workspace", code: "", blocks: [] }; }

fn set_code(ws, code) { ws.code = str(code ?? ""); return ws; }
fn add(ws, blk) { push(ws.blocks, blk); return ws; }

fn block(kind, args, children) {
    return map{ kind: kind, args: args ?? map{}, children: children ?? [] };
}

fn raw(code) { return block("raw", map{ code: str(code ?? "") }, []); }
fn from_code(code) { return raw(code); }

fn num(n) { return block("num", map{ value: n }, []); }
fn text(s) { return block("string", map{ value: str(s ?? "") }, []); }
fn bool(v) { return block("bool", map{ value: v == true }, []); }
fn nil() { return block("nil", map{}, []); }
fn var(name) { return block("var", map{ name: str(name) }, []); }
fn binop(op, left, right) { return block("binop", map{ op: str(op), left: left, right: right }, []); }
fn call(name, args) { return block("call", map{ name: str(name), args: args ?? [] }, []); }
fn index_expr(target, idx) { return block("index", map{ target: target, index: idx }, []); }
fn member_expr(target, name) { return block("member", map{ target: target, name: str(name) }, []); }
fn array_expr(items) { return block("array", map{ items: items ?? [] }, []); }
fn map_entry(key, value) { return map{ key: str(key), value: value }; }
fn map_expr(entries) { return block("map", map{ entries: entries ?? [] }, []); }

fn let_stmt(name, expr) { return block("let", map{ name: str(name), expr: expr }, []); }
fn set_stmt(name, expr) { return block("set", map{ name: str(name), expr: expr }, []); }
fn print_stmt(expr) { return block("print", map{ expr: expr }, []); }
fn return_stmt(expr) { return block("return", map{ expr: expr }, []); }
fn expr_stmt(expr) { return block("expr_stmt", map{ expr: expr }, []); }
fn if_stmt(cond, then_blocks, else_blocks) {
    return block("if", map{ cond: cond }, [then_blocks ?? [], else_blocks ?? []]);
}
fn while_stmt(cond, body) { return block("while", map{ cond: cond }, [body ?? []]); }
fn for_count(var_name, count_expr, body) {
    return block("for_count", map{ var: str(var_name), count: count_expr }, [body ?? []]);
}
fn for_in(var_name, iter_expr, body) {
    return block("for_in", map{ var: str(var_name), iter: iter_expr }, [body ?? []]);
}
fn fn_block(name, params, body) {
    return block("fn", map{ name: str(name), params: params ?? [] }, [body ?? []]);
}

fn compose(code, blocks) {
    let ws = workspace();
    ws.code = str(code ?? "");
    ws.blocks = blocks ?? [];
    return to_code(ws);
}

fn to_code(x) {
    if x == nil { return ""; }
    let k = try x.kind catch "";
    if k == "workspace" {
        let out = str(try x.code catch "");
        if out != "" and not str_ends_with(out, "\n") { out = out + "\n"; }
        return out + _render_block_list(try x.blocks catch [], 0);
    }
    if k == "raw" or _is_stmt_kind(k) { return _render_stmt(x, 0); }
    return _render_expr(x);
}

fn validate(x) {
    let diags = [];
    _validate_any(x, diags, "root");
    return map{ ok: len(diags) == 0, diagnostics: diags, count: len(diags) };
}

fn _is_stmt_kind(k) {
    return k == "let" or k == "set" or k == "print" or k == "return"
        or k == "expr_stmt" or k == "if" or k == "while" or k == "for_count"
        or k == "for_in" or k == "fn" or k == "raw";
}

fn _render_block_list(blocks, level) {
    let out = "";
    let i = 0;
    while i < len(blocks) {
        out = out + _render_stmt(blocks[i], level);
        i = i + 1;
    }
    return out;
}

fn _render_stmt(b, level) {
    let k = try b.kind catch "";
    let a = try b.args catch map{};
    let ind = _indent(level);
    if k == "raw" { return _indent_raw(str(try a.code catch ""), level); }
    if k == "let" { return ind + "let " + _name(a.name) + " = " + _render_expr(a.expr) + ";\n"; }
    if k == "set" { return ind + _name(a.name) + " = " + _render_expr(a.expr) + ";\n"; }
    if k == "print" { return ind + "print " + _render_expr(a.expr) + ";\n"; }
    if k == "return" { return ind + "return " + _render_expr(a.expr) + ";\n"; }
    if k == "expr_stmt" { return ind + _render_expr(a.expr) + ";\n"; }
    if k == "if" {
        let children = try b.children catch [[], []];
        let then_blocks = [];
        let else_blocks = [];
        if len(children) > 0 { then_blocks = children[0]; }
        if len(children) > 1 { else_blocks = children[1]; }
        let out = ind + "if " + _render_expr(a.cond) + " {\n";
        out = out + _render_block_list(then_blocks, level + 1) + ind + "}";
        if len(else_blocks) > 0 {
            out = out + " else {\n" + _render_block_list(else_blocks, level + 1) + ind + "}";
        }
        return out + "\n";
    }
    if k == "while" {
        let body = _child_list(b, 0);
        return ind + "while " + _render_expr(a.cond) + " {\n" + _render_block_list(body, level + 1) + ind + "}\n";
    }
    if k == "for_count" {
        let body = _child_list(b, 0);
        return ind + "for " + _name(a.var) + " " + _render_expr(a.count) + " {\n" + _render_block_list(body, level + 1) + ind + "}\n";
    }
    if k == "for_in" {
        let body = _child_list(b, 0);
        return ind + "for " + _name(a.var) + " in " + _render_expr(a.iter) + " {\n" + _render_block_list(body, level + 1) + ind + "}\n";
    }
    if k == "fn" {
        let body = _child_list(b, 0);
        return ind + "fn " + _name(a.name) + "(" + _join_names(a.params) + ") {\n" + _render_block_list(body, level + 1) + ind + "}\n";
    }
    return ind + "// unknown block: " + str(k) + "\n";
}

fn _render_expr(b) {
    if b == nil { return "nil"; }
    let k = try b.kind catch "";
    let a = try b.args catch map{};
    if k == "num" { return str(a.value); }
    if k == "string" { return _quote(a.value); }
    if k == "bool" { if a.value == true { return "true"; } return "false"; }
    if k == "nil" { return "nil"; }
    if k == "var" { return _name(a.name); }
    if k == "binop" { return "(" + _render_expr(a.left) + " " + str(a.op) + " " + _render_expr(a.right) + ")"; }
    if k == "call" { return _name(a.name) + "(" + _render_expr_list(a.args) + ")"; }
    if k == "index" { return _render_expr(a.target) + "[" + _render_expr(a.index) + "]"; }
    if k == "member" { return _render_expr(a.target) + "." + _name(a.name); }
    if k == "array" { return "[" + _render_expr_list(a.items) + "]"; }
    if k == "map" {
        let out = "map{";
        let entries = try a.entries catch [];
        let i = 0;
        while i < len(entries) {
            if i > 0 { out = out + ", "; }
            out = out + _name(entries[i].key) + ": " + _render_expr(entries[i].value);
            i = i + 1;
        }
        return out + "}";
    }
    if is_string(b) { return _quote(b); }
    if is_number(b) { return str(b); }
    if is_bool(b) { if b { return "true"; } return "false"; }
    return "nil";
}

fn _child_list(b, idx) {
    let children = try b.children catch [];
    if idx >= 0 and idx < len(children) { return children[idx]; }
    return [];
}

fn _render_expr_list(items) {
    let out = "";
    let i = 0;
    while i < len(items) {
        if i > 0 { out = out + ", "; }
        out = out + _render_expr(items[i]);
        i = i + 1;
    }
    return out;
}

fn _join_names(items) {
    let out = "";
    let i = 0;
    while i < len(items) {
        if i > 0 { out = out + ", "; }
        out = out + _name(items[i]);
        i = i + 1;
    }
    return out;
}

fn _indent(level) {
    let out = "";
    let i = 0;
    while i < level { out = out + "    "; i = i + 1; }
    return out;
}

fn _indent_raw(code, level) {
    let lines = str_split(code, "\n");
    let out = "";
    let i = 0;
    while i < len(lines) {
        if lines[i] != "" { out = out + _indent(level) + lines[i]; }
        out = out + "\n";
        i = i + 1;
    }
    return out;
}

fn _quote(s) {
    let t = str(s ?? "");
    let out = "\"";
    let i = 0;
    while i < len(t) {
        let ch = str_slice(t, i, i + 1);
        if ch == "\\" { out = out + "\\\\"; }
        else if ch == "\"" { out = out + "\\\""; }
        else if ch == "\n" { out = out + "\\n"; }
        else if ch == "\t" { out = out + "\\t"; }
        else if ch == "\r" { out = out + "\\r"; }
        else { out = out + ch; }
        i = i + 1;
    }
    return out + "\"";
}

fn _name(s) {
    let n = str(s ?? "_");
    if n == "" { return "_"; }
    return n;
}

fn _validate_any(x, diags, path) {
    if x == nil {
        push(diags, map{ path: path, message: "nil block" });
        return;
    }
    let k = try x.kind catch "";
    if k == "" {
        push(diags, map{ path: path, message: "missing kind" });
        return;
    }
    if k == "workspace" {
        let bs = try x.blocks catch [];
        let i = 0;
        while i < len(bs) { _validate_any(bs[i], diags, path + ".blocks[" + str(i) + "]"); i = i + 1; }
        return;
    }
    if not _is_stmt_kind(k)
        and k != "num" and k != "string" and k != "bool" and k != "nil"
        and k != "var" and k != "binop" and k != "call" and k != "index"
        and k != "member" and k != "array" and k != "map" {
        push(diags, map{ path: path, message: "unknown block kind '" + k + "'" });
    }
    let ch = try x.children catch [];
    let ci = 0;
    while ci < len(ch) {
        let group = ch[ci];
        let gi = 0;
        while gi < len(group) {
            _validate_any(group[gi], diags, path + ".children[" + str(ci) + "][" + str(gi) + "]");
            gi = gi + 1;
        }
        ci = ci + 1;
    }
}

export workspace, set_code, add, block, raw, from_code, compose, to_code, validate;
export num, text, bool, nil, var, binop, call, index_expr, member_expr, array_expr, map_entry, map_expr;
export let_stmt, set_stmt, print_stmt, return_stmt, expr_stmt, if_stmt, while_stmt, for_count, for_in, fn_block;
