// Bounded study publication using existing sealed bytes and anonymous no-replace I/O.
// Never delete a caller pathname after a failed attempt, or downgrade to direct writes.
let Dir=import("stdlib:linux_dirfs.sapp");
let MAX_BYTES=262144;
fn rejected(code,message) {
 return map{ok:false,format:"pblang.study-publication.v1",code:code,error:message,
  written:false,publication_confirmed:false,publication_attempted:false,
  output_may_exist:false,partial_output_possible:false,durability_verified:false,
  owned_handles_closed:true,metadata_only:true,safe_to_log:false};
}
fn _root(parent) {
 if str_starts_with(parent,"/") {return Dir.open_absolute(parent,false,false);}
 return Dir.open(parent,false,false);
}
fn save(path,text) {
 if type(path)!="string" or len(path)>4096 or len(str_to_bytes(path))>4096
  or str_contains(path,strfromcharcode(0)) or str_contains(path,"\\")
  or not str_ends_with(str_lower(path),".pbdeck") {
  return rejected("invalid_output","Choose a new .pbdeck path.");
 }
 if type(text)!="string" {return rejected("invalid_content","Study content must be bounded UTF-8 text.");}
 let bytes=str_to_bytes(text);
 if len(bytes)<1 or len(bytes)>MAX_BYTES {return rejected("invalid_content","Study content exceeds the publication limit.");}
 if platform()!="linux" {return rejected("publication_unavailable","Anonymous study publication currently requires Linux and a supported filesystem.");}
 let parent=path_dirname(path);if parent=="" {parent=".";}
 let name=path_basename(path);
 let fs=try _root(parent) catch nil;
 if fs==nil or not fs.ok {return rejected("parent_unavailable","Output folder cannot be opened securely.");}
 let held=try Dir.sealed_child_bytes(fs,"study-publication",bytes) catch nil;
 let result=rejected("snapshot_unavailable","Study snapshot could not be prepared; no destination was published.");
 if held!=nil and held.ok {
  // From this point even a failed helper may have published; do not infer absence.
  let published=try Dir.copy_held_range_new_atomic(fs,held,fs,name,0,len(bytes),false,false) catch nil;
  let confirmed=published!=nil and ((try published.ok catch false) or (try published.published catch false));
  let durable=confirmed and (try published.durability_verified catch false);
  result=map{ok:published!=nil and (try published.ok catch false),format:"pblang.study-publication.v1",
   publication_confirmed:confirmed,publication_attempted:true,output_may_exist:true,
   partial_output_possible:false,durability_verified:durable,
   owned_handles_closed:false,metadata_only:true,safe_to_log:false};
  if confirmed {result.written=true;result.atomic_visibility=true;}
  if not result.ok {result.code="publication_unconfirmed";result.error="Publication not confirmed. Check the destination before retrying; an existing file was not replaced.";}
 }
 // One close operation consumes the root and every registered child exactly once.
 // Never retry a numeric descriptor after an ambiguous close result.
 result.owned_handles_closed=try Dir.close(fs) catch false;
 if not result.owned_handles_closed {
  result.ok=false;result.cleanup_error="Owned publication handles did not confirm closure.";
  if not map_has(result,"error") {result.code="cleanup_unconfirmed";result.error="The deck was published, but handle cleanup was not confirmed. Do not repeat the write.";}
 }
 return result;
}
export save;
