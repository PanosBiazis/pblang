// Public embedded facade: portable IR, board-aware validation, native-only build.

let Targets = import("stdlib:embedded_targets.sapp");
let IR = import("stdlib:embedded_ir.sapp");
let AVR = import("stdlib:codegen_avr_embedded.sapp");
let Circuit = import("stdlib:embedded_circuit.sapp");
let Protocol = import("stdlib:embedded_protocol.sapp");
let Controller = import("stdlib:embedded_controller.sapp");
let WireAVR = import("stdlib:embedded_protocol_avr.sapp");
let Inspector = import("stdlib:embedded_inspector.sapp");
let FORMAT = "pblang.embedded.v1";

fn blink(pin = "status-led-test", interval_ms = 500) { return IR.blink(pin, interval_ms); }
fn new_circuit(options = nil) { return Circuit.new(options); }
fn board_info(board_id) { return Targets.board(board_id); }
fn boards() { return Targets.boards(); }
fn inspect_pin(board_id, pin_alias = nil) { return Targets.inspect_pin(board_id, pin_alias); }
fn technical_manual(board_id) { return Targets.technical_manual(board_id); }
fn inspect(request = nil) { return Inspector.inspect(request); }
fn connect_controller(circuit, device_id, options = nil) {
    return Controller.connect(circuit, device_id, options);
}
fn protocol_info() {
    return map{format:Protocol.FORMAT, version:Protocol.VERSION,
        frame_bytes:Protocol.FRAME_BYTES, direct_serial_only:true,
        authenticated_network_transport:false};
}
fn build_controller(board_id) {
    let board = Targets.board(board_id);
    if board == nil { return map{ok:false, format:FORMAT, error:"unknown embedded board"}; }
    if board.id == "arduino-uno" { return WireAVR.compile(); }
    return map{ok:false, format:FORMAT, board:board.id,
        error:"persistent wired controller firmware is incomplete for this board",
        c_fallback:false};
}

fn build(program, board_id) {
    let board = Targets.board(board_id);
    if board == nil { return map{ ok:false, format:FORMAT, error:"unknown embedded board", board:str(board_id) }; }
    let checked = IR.validate(program, board);
    if not checked.ok { return map{ ok:false, format:FORMAT, error:"embedded safety validation failed",
        board:board.id, diagnostics:checked }; }
    let status = Targets.backend_status(board);
    if not status.ok {
        return map{ ok:false, format:FORMAT, error:"native backend is incomplete",
            board:board.id, mcu:board.mcu, architecture:status.architecture,
            backend:status.backend, status:status.status, c_fallback:false,
            portable_program_valid:true, warnings:checked.warnings };
    }
    let lowered = IR.lower(program, board);
    if status.backend == "native-avr8" {
        let artifact = AVR.compile(lowered); artifact.validation = checked; return artifact;
    }
    return map{ ok:false, format:FORMAT, error:"implemented backend has no dispatcher",
        board:board.id, backend:status.backend, c_fallback:false };
}

fn simulate(program, board_id, options = nil) {
    let artifact = build(program, board_id);
    if not artifact.ok { return artifact; }
    if artifact.backend == "native-avr8" {
        let board = Targets.board(board_id); let selected = Targets.pin(board, "status-led-test");
        let address = board.mcu_info.registers[selected.port].output;
        let events = try options.events catch 3; let budget = try options.instruction_budget catch 1000000;
        return AVR.verify_io(artifact, address, events, budget);
    }
    return map{ ok:false, format:FORMAT, error:"no execution model for backend", backend:artifact.backend };
}

fn capabilities() {
    let coverage = Targets.coverage();
    return map{ format:FORMAT, native_only:true, c_fallback:false,
        architecture_model:true, capability_compilation:true, pin_safety:true,
        portable_ir:true, native_avr8:true, intel_hex:true,
        bounded_wired_protocol:true, persistent_uno_controller:true,
        xtensa_lx6:false, rp2040:false, rp2350:false, renesas_ra:false,
        board_count:coverage.boards, implemented_boards:coverage.implemented,
        incomplete_boards:coverage.incomplete };
}

export FORMAT, blink, board_info, boards, inspect_pin, technical_manual, inspect, build, simulate, capabilities;
export connect_controller, protocol_info;
export build_controller;
export new_circuit;
export Targets, IR, AVR;
export Circuit;
export Protocol, Controller;
export Inspector;
