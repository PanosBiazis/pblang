// Persistent ATmega328P wired LED controller firmware emitted entirely by
// PBLang. The generated bytes implement embedded_protocol.sapp directly.

let AVR = import("stdlib:emulator_avr.sapp");
let Codegen = import("stdlib:codegen_avr_embedded.sapp");
let Protocol = import("stdlib:embedded_protocol.sapp");

let FORMAT = "pblang.embedded-wire-avr.v1";
let MCU = "atmega328p";
let CLOCK_HZ = 16000000;
let BAUD = 115200;

let UCSR0A = 192; let UCSR0B = 193; let UCSR0C = 194;
let UBRR0L = 196; let UBRR0H = 197; let UDR0 = 198;
let TIFR1 = 54; let TCCR1A = 128; let TCCR1B = 129;
let TCNT1L = 132; let TCNT1H = 133; let OCR1AL = 136; let OCR1AH = 137;
let DDRD_IO = 10; let PORTD_IO = 11; let LED_BIT = 7;

let RAM_STAGE = 256; let RAM_CHECKSUM = 257; let RAM_SEQUENCE = 258;
let RAM_OPCODE = 259; let RAM_VALUE = 260; let RAM_INTERVAL_L = 261;
let RAM_INTERVAL_H = 262; let RAM_DURATION_L = 263; let RAM_DURATION_H = 264;
let RAM_STATE = 265; let RAM_LAST_SEQUENCE = 266; let RAM_EXPECTED = 267;
let RAM_PHASE_L = 268; let RAM_PHASE_H = 269;
let RAM_REMAINING_L = 270; let RAM_REMAINING_H = 271;
let RAM_RESPONSE_STATUS = 272;

fn _append(target, bytes) { for i len(bytes) { array_push(target, bytes[i]); } }
fn _words(code) { return num_floor(len(code) / 2); }
fn _asm() { return map{code:[], labels:map{}, fixups:[], unique:0}; }
fn _emit(state, bytes) { _append(state.code, bytes); }
fn _label(state, name) {
    if map_has(state.labels, name) { throw "embedded_protocol_avr: duplicate label"; }
    state.labels[name] = _words(state.code);
}
fn _jump(state, label) {
    array_push(state.fixups, map{at:_words(state.code), label:label});
    _emit(state, AVR.jump_relative(0));
}
fn _if_equal(state, label) { _emit(state, AVR.branch_not_equal(1)); _jump(state, label); }
fn _if_not_equal(state, label) { _emit(state, AVR.branch_equal(1)); _jump(state, label); }
fn _if_carry(state, label) { _emit(state, AVR.branch_carry_clear(1)); _jump(state, label); }
fn _if_no_carry(state, label) { _emit(state, AVR.branch_carry_set(1)); _jump(state, label); }
fn _unique(state, prefix) { state.unique = state.unique + 1; return prefix + str(state.unique); }
fn _finish(state) {
    for i len(state.fixups) {
        let fix = state.fixups[i];
        if not map_has(state.labels, fix.label) { throw "embedded_protocol_avr: unknown label " + fix.label; }
        let offset = state.labels[fix.label] - (fix.at + 1);
        let encoded = AVR.jump_relative(offset);
        state.code[fix.at * 2] = encoded[0]; state.code[fix.at * 2 + 1] = encoded[1];
    }
    return state.code;
}

fn _load(state, register, address) { _emit(state, AVR.load_direct(register, address)); }
fn _store(state, address, register) { _emit(state, AVR.store_direct(address, register)); }
fn _store_value(state, address, value) {
    _emit(state, AVR.load_immediate(16, value)); _store(state, address, 16);
}
fn _clear_ram(state, address) { _store_value(state, address, 0); }
fn _set_stage(state, value) { _store_value(state, RAM_STAGE, value); _jump(state, "main"); }
fn _add_checksum(state, register) {
    _load(state, 18, RAM_CHECKSUM); _emit(state, AVR.add(18, register));
    _store(state, RAM_CHECKSUM, 18);
}
fn _set_state_bits(state, set_mask, clear_mask) {
    _load(state, 16, RAM_STATE);
    if clear_mask > 0 { _emit(state, AVR.and_immediate(16, 255 - clear_mask)); }
    if set_mask > 0 { _emit(state, AVR.or_immediate(16, set_mask)); }
    _store(state, RAM_STATE, 16);
}
fn _led_on(state) { _emit(state, AVR.set_io_bit(PORTD_IO, LED_BIT)); _set_state_bits(state, 1, 0); }
fn _led_off(state) { _emit(state, AVR.clear_io_bit(PORTD_IO, LED_BIT)); _set_state_bits(state, 0, 1); }
fn _stop_blink(state) {
    _set_state_bits(state, 0, 2); _clear_ram(state, RAM_REMAINING_L);
    _clear_ram(state, RAM_REMAINING_H); _led_off(state);
}

fn _initialize(state) {
    _emit(state, AVR.clear_interrupts());
    _emit(state, AVR.set_io_bit(DDRD_IO, LED_BIT));
    _emit(state, AVR.clear_io_bit(PORTD_IO, LED_BIT));
    _store_value(state, UCSR0A, 2); // U2X0
    _store_value(state, UBRR0H, 0); _store_value(state, UBRR0L, 16);
    _store_value(state, UCSR0B, 24); _store_value(state, UCSR0C, 6);
    _store_value(state, TCCR1A, 0); _store_value(state, TCCR1B, 0);
    _store_value(state, TCNT1H, 0); _store_value(state, TCNT1L, 0);
    _store_value(state, OCR1AH, 0); _store_value(state, OCR1AL, 249);
    _store_value(state, TIFR1, 2); _store_value(state, TCCR1B, 11);
    let address = RAM_STAGE;
    while address <= RAM_RESPONSE_STATUS { _clear_ram(state, address); address = address + 1; }
    _store_value(state, RAM_INTERVAL_L, 244); _store_value(state, RAM_INTERVAL_H, 1);
    _store_value(state, RAM_PHASE_L, 244); _store_value(state, RAM_PHASE_H, 1);
}

fn _timer_service(state) {
    _load(state, 16, TIFR1); _emit(state, AVR.and_immediate(16, 2));
    _emit(state, AVR.compare_immediate(16, 0)); _if_equal(state, "uart_poll");
    _store_value(state, TIFR1, 2);
    _load(state, 16, RAM_STATE); _emit(state, AVR.and_immediate(16, 2));
    _emit(state, AVR.compare_immediate(16, 0)); _if_equal(state, "uart_poll");

    _load(state, 16, RAM_PHASE_L); _load(state, 17, RAM_PHASE_H);
    _emit(state, AVR.subtract_immediate(16, 1));
    _emit(state, AVR.subtract_immediate_carry(17, 0));
    _store(state, RAM_PHASE_L, 16); _store(state, RAM_PHASE_H, 17);
    _emit(state, AVR.compare_immediate(16, 0));
    let phase_nonzero = _unique(state, "phase_nonzero_");
    _if_not_equal(state, phase_nonzero);
    _emit(state, AVR.compare_immediate(17, 0)); _if_not_equal(state, phase_nonzero);
    _load(state, 16, RAM_INTERVAL_L); _store(state, RAM_PHASE_L, 16);
    _load(state, 16, RAM_INTERVAL_H); _store(state, RAM_PHASE_H, 16);
    _load(state, 16, RAM_STATE); _emit(state, AVR.and_immediate(16, 1));
    _emit(state, AVR.compare_immediate(16, 0));
    let turn_on = _unique(state, "turn_on_"); let toggled = _unique(state, "toggled_");
    _if_equal(state, turn_on); _led_off(state); _jump(state, toggled);
    _label(state, turn_on); _led_on(state); _label(state, toggled);
    _label(state, phase_nonzero);

    _load(state, 16, RAM_REMAINING_L); _load(state, 17, RAM_REMAINING_H);
    _emit(state, AVR.compare_immediate(16, 0));
    let finite = _unique(state, "finite_"); _if_not_equal(state, finite);
    _emit(state, AVR.compare_immediate(17, 0)); _if_equal(state, "uart_poll");
    _label(state, finite);
    _emit(state, AVR.subtract_immediate(16, 1));
    _emit(state, AVR.subtract_immediate_carry(17, 0));
    _store(state, RAM_REMAINING_L, 16); _store(state, RAM_REMAINING_H, 17);
    _emit(state, AVR.compare_immediate(16, 0)); _if_not_equal(state, "uart_poll");
    _emit(state, AVR.compare_immediate(17, 0)); _if_not_equal(state, "uart_poll");
    _stop_blink(state); _jump(state, "uart_poll");
}

fn _parser_stage(state, stage, address, next_stage) {
    _label(state, "stage" + str(stage)); _store(state, address, 16);
    _add_checksum(state, 16); _set_stage(state, next_stage);
}

fn _parser(state) {
    _label(state, "uart_poll");
    _load(state, 16, UCSR0A); _emit(state, AVR.and_immediate(16, 128));
    _emit(state, AVR.compare_immediate(16, 0)); _if_equal(state, "main");
    _load(state, 16, UDR0); _load(state, 17, RAM_STAGE);
    let stage = 0;
    while stage <= 11 {
        _emit(state, AVR.compare_immediate(17, stage)); _if_equal(state, "stage" + str(stage));
        stage = stage + 1;
    }
    _jump(state, "reset_parser");

    _label(state, "stage0"); _emit(state, AVR.compare_immediate(16, 80));
    _if_not_equal(state, "reset_parser"); _store(state, RAM_CHECKSUM, 16);
    _store_value(state, RAM_STAGE, 1); _jump(state, "main");
    _label(state, "stage1"); _emit(state, AVR.compare_immediate(16, 66));
    _if_not_equal(state, "reset_parser"); _add_checksum(state, 16); _set_stage(state, 2);
    _label(state, "stage2"); _emit(state, AVR.compare_immediate(16, Protocol.VERSION));
    _if_not_equal(state, "reset_parser"); _add_checksum(state, 16); _set_stage(state, 3);
    _label(state, "stage3"); _emit(state, AVR.compare_immediate(16, 0));
    _if_equal(state, "reset_parser"); _store(state, RAM_SEQUENCE, 16);
    _add_checksum(state, 16); _set_stage(state, 4);
    _label(state, "stage4"); _emit(state, AVR.compare_immediate(16, 1));
    _if_carry(state, "reset_parser"); _emit(state, AVR.compare_immediate(16, 6));
    _if_no_carry(state, "reset_parser"); _store(state, RAM_OPCODE, 16);
    _add_checksum(state, 16); _set_stage(state, 5);
    _label(state, "stage5"); _emit(state, AVR.compare_immediate(16, 2));
    _if_no_carry(state, "reset_parser"); _store(state, RAM_VALUE, 16);
    _add_checksum(state, 16); _set_stage(state, 6);
    _parser_stage(state, 6, RAM_INTERVAL_L, 7); _parser_stage(state, 7, RAM_INTERVAL_H, 8);
    _parser_stage(state, 8, RAM_DURATION_L, 9); _parser_stage(state, 9, RAM_DURATION_H, 10);
    _label(state, "stage10"); _emit(state, AVR.compare_immediate(16, 0));
    _if_not_equal(state, "reset_parser"); _add_checksum(state, 16); _set_stage(state, 11);
    _label(state, "stage11"); _load(state, 18, RAM_CHECKSUM);
    _emit(state, AVR.compare(16, 18)); _if_not_equal(state, "reset_parser");
    _jump(state, "execute");
    _label(state, "reset_parser"); _clear_ram(state, RAM_STAGE); _jump(state, "main");
}

fn _set_expected(state) {
    _load(state, 16, RAM_SEQUENCE); _store(state, RAM_LAST_SEQUENCE, 16);
    _emit(state, AVR.increment(16)); _emit(state, AVR.compare_immediate(16, 0));
    let nonzero = _unique(state, "sequence_nonzero_"); _if_not_equal(state, nonzero);
    _emit(state, AVR.load_immediate(16, 1)); _label(state, nonzero);
    _store(state, RAM_EXPECTED, 16);
}

fn _validate_blink_interval(state) {
    _load(state, 16, RAM_INTERVAL_H); _emit(state, AVR.compare_immediate(16, 0));
    let above_min = _unique(state, "above_min_"); _if_not_equal(state, above_min);
    _load(state, 16, RAM_INTERVAL_L); _emit(state, AVR.compare_immediate(16, 10));
    _if_carry(state, "invalid_command"); _label(state, above_min);
    _load(state, 16, RAM_INTERVAL_H); _emit(state, AVR.compare_immediate(16, 234));
    _if_carry(state, "blink_range_ok"); _if_not_equal(state, "invalid_command");
    _load(state, 16, RAM_INTERVAL_L); _emit(state, AVR.compare_immediate(16, 97));
    _if_no_carry(state, "invalid_command");
    _label(state, "blink_range_ok");
}

fn _execute(state) {
    _label(state, "execute"); _load(state, 16, RAM_OPCODE);
    _emit(state, AVR.compare_immediate(16, Protocol.OP_STATUS)); _if_equal(state, "do_status");
    _load(state, 17, RAM_EXPECTED); _emit(state, AVR.compare_immediate(17, 0));
    _if_equal(state, "not_synchronized");
    _load(state, 18, RAM_SEQUENCE); _emit(state, AVR.compare(18, 17));
    _if_equal(state, "ordered_command");
    _load(state, 17, RAM_LAST_SEQUENCE); _emit(state, AVR.compare(18, 17));
    _if_equal(state, "duplicate_command"); _jump(state, "out_of_order");

    _label(state, "ordered_command"); _load(state, 16, RAM_OPCODE);
    _emit(state, AVR.compare_immediate(16, Protocol.OP_SET)); _if_equal(state, "do_set");
    _emit(state, AVR.compare_immediate(16, Protocol.OP_TOGGLE)); _if_equal(state, "do_toggle");
    _emit(state, AVR.compare_immediate(16, Protocol.OP_BLINK)); _if_equal(state, "do_blink");
    _emit(state, AVR.compare_immediate(16, Protocol.OP_STOP)); _if_equal(state, "do_stop");
    _jump(state, "invalid_command");

    _label(state, "do_status"); _set_expected(state); _store_value(state, RAM_RESPONSE_STATUS, Protocol.STATUS_OK);
    _jump(state, "respond");
    _label(state, "do_set"); _set_state_bits(state, 0, 2);
    _clear_ram(state, RAM_REMAINING_L); _clear_ram(state, RAM_REMAINING_H);
    _load(state, 16, RAM_VALUE); _emit(state, AVR.compare_immediate(16, 0));
    let set_off = _unique(state, "set_off_"); let set_done = _unique(state, "set_done_");
    _if_equal(state, set_off); _led_on(state); _jump(state, set_done);
    _label(state, set_off); _led_off(state); _label(state, set_done); _jump(state, "command_ok");
    _label(state, "do_toggle"); _set_state_bits(state, 0, 2);
    _clear_ram(state, RAM_REMAINING_L); _clear_ram(state, RAM_REMAINING_H);
    _load(state, 16, RAM_STATE); _emit(state, AVR.and_immediate(16, 1));
    _emit(state, AVR.compare_immediate(16, 0));
    let toggle_on = _unique(state, "toggle_on_"); let toggle_done = _unique(state, "toggle_done_");
    _if_equal(state, toggle_on); _led_off(state); _jump(state, toggle_done);
    _label(state, toggle_on); _led_on(state); _label(state, toggle_done); _jump(state, "command_ok");
    _label(state, "do_blink"); _validate_blink_interval(state);
    _load(state, 16, RAM_INTERVAL_L); _store(state, RAM_PHASE_L, 16);
    _load(state, 16, RAM_INTERVAL_H); _store(state, RAM_PHASE_H, 16);
    _load(state, 16, RAM_DURATION_L); _store(state, RAM_REMAINING_L, 16);
    _load(state, 16, RAM_DURATION_H); _store(state, RAM_REMAINING_H, 16);
    _set_state_bits(state, 2, 0); _led_on(state); _jump(state, "command_ok");
    _label(state, "do_stop"); _stop_blink(state); _jump(state, "command_ok");
    _label(state, "command_ok"); _set_expected(state);
    _store_value(state, RAM_RESPONSE_STATUS, Protocol.STATUS_OK); _jump(state, "respond");
    _label(state, "invalid_command"); _store_value(state, RAM_RESPONSE_STATUS, Protocol.STATUS_INVALID); _jump(state, "respond");
    _label(state, "duplicate_command"); _store_value(state, RAM_RESPONSE_STATUS, Protocol.STATUS_DUPLICATE); _jump(state, "respond");
    _label(state, "not_synchronized"); _store_value(state, RAM_RESPONSE_STATUS, Protocol.STATUS_NOT_SYNCHRONIZED); _jump(state, "respond");
    _label(state, "out_of_order"); _store_value(state, RAM_RESPONSE_STATUS, Protocol.STATUS_OUT_OF_ORDER); _jump(state, "respond");
}

fn _send_register(state, register, checksum) {
    let wait = _unique(state, "tx_wait_"); _label(state, wait);
    _load(state, 17, UCSR0A); _emit(state, AVR.and_immediate(17, 32));
    _emit(state, AVR.compare_immediate(17, 32)); _if_not_equal(state, wait);
    if checksum { _load(state, 18, RAM_CHECKSUM); _emit(state, AVR.add(18, register)); _store(state, RAM_CHECKSUM, 18); }
    _store(state, UDR0, register);
}
fn _send_value(state, value, checksum) {
    _emit(state, AVR.load_immediate(16, value)); _send_register(state, 16, checksum);
}
fn _send_memory(state, address, checksum) {
    _load(state, 16, address); _send_register(state, 16, checksum);
}

fn _respond(state) {
    _label(state, "respond"); _clear_ram(state, RAM_CHECKSUM);
    _send_value(state, 80, true); _send_value(state, 82, true);
    _send_value(state, Protocol.VERSION, true); _send_memory(state, RAM_SEQUENCE, true);
    _send_memory(state, RAM_RESPONSE_STATUS, true); _send_memory(state, RAM_STATE, true);
    _send_memory(state, RAM_INTERVAL_L, true); _send_memory(state, RAM_INTERVAL_H, true);
    _send_memory(state, RAM_REMAINING_L, true); _send_memory(state, RAM_REMAINING_H, true);
    _send_value(state, 0, true); _send_memory(state, RAM_CHECKSUM, false);
    _clear_ram(state, RAM_STAGE); _jump(state, "main");
}

fn compile() {
    let state = _asm(); _initialize(state); _label(state, "main");
    _timer_service(state); _parser(state); _execute(state); _respond(state);
    let code = _finish(state);
    if len(code) > 32768 { throw "embedded_protocol_avr: firmware exceeds ATmega328P flash"; }
    let hex = Codegen.intel_hex(code);
    if Codegen.parse_intel_hex(hex) != code { throw "embedded_protocol_avr: Intel HEX roundtrip mismatch"; }
    return map{ok:true, format:FORMAT, board:"arduino-uno", mcu:MCU,
        architecture:"avr8", backend:"native-avr8", firmware_format:"ihex",
        binary:code, bytes:len(code), intel_hex:hex, intel_hex_bytes:str_to_bytes(hex),
        sha256:sha256(base64_encode_bytes(code)), baud:BAUD, clock_hz:CLOCK_HZ,
        protocol:Protocol.FORMAT, protocol_version:Protocol.VERSION,
        persistent_command_loop:true, c_fallback:false, assembler_dependency:false,
        compiler_dependency:false, native_source_language:"pblang"};
}

fn verify(commands, options = nil) {
    if type(commands) != "array" or len(commands) < 1 or len(commands) > 32 {
        return map{ok:false, format:FORMAT, error:"verification requires 1..32 commands"};
    }
    let input = [];
    for i len(commands) { _append(input, Protocol.encode_command(commands[i])); }
    let artifact = compile(); let expected = len(commands) * Protocol.FRAME_BYTES;
    let result = AVR.run(artifact.binary, map{instruction_budget:try options.instruction_budget catch 1000000,
        uart_rx_bytes:input, stop_after_uart_bytes:expected,
        timer1_tick_every_cycles:try options.timer1_tick_every_cycles catch 0,
        trace_io_addresses:[PORTD_IO]});
    if not result.ok { return result; }
    let decoder = Protocol.new_decoder("response"); let decoded = Protocol.feed(decoder, result.uart_tx);
    return map{ok:decoded.ok and len(decoded.frames)==len(commands), format:FORMAT,
        artifact_sha256:artifact.sha256, artifact_bytes:artifact.bytes,
        responses:decoded.frames, uart_tx:result.uart_tx, io_events:result.io_events,
        instructions:result.instructions, cycles:result.cycles,
        execution_model:"verified AVR UART/timer/GPIO subset", physical_hardware:false};
}

export FORMAT, MCU, CLOCK_HZ, BAUD, compile, verify;
