// stdlib/gpu2d_tess.sapp — the mesh/tessellation path of the GPU 2D stack (lyon-style).
//
// gpu2d.sapp draws axis-aligned rect/rrect/glyph as instanced quads — fast for chrome and
// text, but it can't do arbitrary-angle strokes or gradients. This module tessellates those
// into a flat TRIANGLE vertex buffer of 6 floats each — [x, y, r, g, b, a] — drawn by the
// mesh pipeline (gpu2d_shader.mesh_wgsl / mesh_glsl_*). Gradients fall out of per-vertex
// colour interpolation. Pure + deterministic; points can be pre-transformed via transform2d.
//
//   let TS = import("stdlib/gpu2d_tess.sapp");
//   let m = TS.new();
//   TS.line(m, x0, y0, x1, y1, 2, col);            // a thick, rotated stroke
//   TS.gradient_rect(m, x, y, w, h, top, bot, true);
//   let buf = TS.to_vertex_f32(m);                 // upload; draw TS.vertices(m) verts

fn new() { return map{ verts: [] }; }

fn _col(c) {
    let a = 255;
    if map_has(c, "a") { a = c.a; }
    return map{ r: c.r / 255.0, g: c.g / 255.0, b: c.b / 255.0, a: a / 255.0 };
}
fn _vert(m, x, y, cn) {
    array_push(m.verts, x * 1.0);
    array_push(m.verts, y * 1.0);
    array_push(m.verts, cn.r);
    array_push(m.verts, cn.g);
    array_push(m.verts, cn.b);
    array_push(m.verts, cn.a);
}
// a triangle with a shared colour, and one with per-vertex colours (for gradients).
fn tri(m, x0, y0, x1, y1, x2, y2, col) {
    let cn = _col(col);
    _vert(m, x0, y0, cn); _vert(m, x1, y1, cn); _vert(m, x2, y2, cn);
}
fn _tri_c(m, x0, y0, c0, x1, y1, c1, x2, y2, c2) {
    _vert(m, x0, y0, c0); _vert(m, x1, y1, c1); _vert(m, x2, y2, c2);
}

// quad(m, p0..p3, col) — CCW/CW quad as two triangles (p0,p1,p2)+(p0,p2,p3).
fn quad(m, x0, y0, x1, y1, x2, y2, x3, y3, col) {
    tri(m, x0, y0, x1, y1, x2, y2, col);
    tri(m, x0, y0, x2, y2, x3, y3, col);
}
// rect(m, x, y, w, h, col) — filled axis-aligned rectangle.
fn rect(m, x, y, w, h, col) {
    quad(m, x, y, x + w, y, x + w, y + h, x, y + h, col);
}

// line(m, x0,y0, x1,y1, width, col) — a thick segment at ANY angle, as a rotated quad.
fn line(m, x0, y0, x1, y1, width, col) {
    let dx = x1 - x0;
    let dy = y1 - y0;
    let ln = num_sqrt(dx * dx + dy * dy);
    if ln == 0 { return m; }
    let hw = width / 2.0;
    let nx = 0.0 - dy / ln * hw;   // perpendicular, scaled to half-width
    let ny = dx / ln * hw;
    quad(m, x0 + nx, y0 + ny, x0 - nx, y0 - ny, x1 - nx, y1 - ny, x1 + nx, y1 + ny, col);
    return m;
}

// polyline(m, points, width, col) — a stroke through [{x,y}...]; one quad per segment.
fn polyline(m, points, width, col) {
    let i = 0;
    while i + 1 < len(points) {
        line(m, points[i].x, points[i].y, points[i + 1].x, points[i + 1].y, width, col);
        i = i + 1;
    }
    return m;
}

// fill_convex(m, points, col) — a convex polygon as a triangle fan from points[0].
fn fill_convex(m, points, col) {
    let i = 1;
    while i + 1 < len(points) {
        tri(m, points[0].x, points[0].y, points[i].x, points[i].y, points[i + 1].x, points[i + 1].y, col);
        i = i + 1;
    }
    return m;
}

// gradient_rect(m, x, y, w, h, c0, c1, vertical) — a linear gradient via per-vertex colour.
fn gradient_rect(m, x, y, w, h, c0, c1, vertical) {
    let a = _col(c0);
    let b = _col(c1);
    let tl = a;
    let tr = a;
    let br = b;
    let bl = b;
    if vertical != true { tr = b; bl = a; }   // horizontal: left=c0, right=c1
    let x1 = x + w;
    let y1 = y + h;
    _tri_c(m, x, y, tl, x1, y, tr, x1, y1, br);
    _tri_c(m, x, y, tl, x1, y1, br, x, y1, bl);
    return m;
}

fn vertices(m) { return len(m.verts) / 6; }
fn triangles(m) { return len(m.verts) / 18; }
fn to_vertex_f32(m) { return m.verts; }
fn clear(m) { m.verts = []; return m; }
fn stats(m) {
    return map{ vertices: len(m.verts) / 6, triangles: len(m.verts) / 18, floats: len(m.verts), draw_calls: 1 };
}

export new, tri, quad, rect, line, polyline, fill_convex, gradient_rect;
export vertices, triangles, to_vertex_f32, clear, stats;
