// Optional text presentation shared by native GUI, Web and Android.
fn validate(options) {
    if type(options)!="map" {throw "ui_typography expects an options map";}
    if map_has(options,"font_size") {
        let size=options.font_size;
        if type(size)!="number" or not (size>=8 and size<=64) or size!=num_floor(size) {
            throw "font_size must be an integer from 8 to 64";
        }
    }
    if map_has(options,"font_weight") and options.font_weight!="normal" and options.font_weight!="bold" {
        throw "font_weight must be normal or bold";
    }
    if map_has(options,"text_align") and options.text_align!="left" and options.text_align!="center" and options.text_align!="right" {
        throw "text_align must be left, center or right";
    }
    if map_has(options,"wrap") and type(options.wrap)!="bool" {throw "wrap must be a boolean";}
    if map_has(options,"max_lines") {
        let count=options.max_lines;
        if type(count)!="number" or not (count>=1 and count<=64) or count!=num_floor(count) {
            throw "max_lines must be an integer from 1 to 64";
        }
    }
    if map_has(options,"font_family") and options.font_family!="system" and options.font_family!="sans"
        and options.font_family!="serif" and options.font_family!="monospace" {throw "font_family must be system, sans, serif or monospace";}
    if map_has(options,"text_spacing") and options.text_spacing!="fixed" and options.text_spacing!="natural" {
        throw "text_spacing must be fixed or natural";
    }
    if map_has(options,"line_height") {
        let value=options.line_height;
        if type(value)!="number" or not (value>=1 and value<=2.5) {throw "line_height must be from 1 to 2.5";}
    }
    return true;
}
fn active(options) {
    return map_has(options,"font_family") or map_has(options,"text_spacing") or map_has(options,"line_height") or map_has(options,"wrap") or map_has(options,"max_lines") or map_has(options,"font_size") or map_has(options,"font_weight") or map_has(options,"text_align");
}
fn preset(name="body",overrides=nil) {
    let size=16;let weight="normal";
    if name=="display" {size=40;weight="bold";}
    elif name=="title" {size=28;weight="bold";}
    elif name=="subtitle" {size=20;weight="bold";}
    elif name=="caption" {size=12;}
    elif name!="body" {throw "unknown ui_typography preset";}
    let out=map{font_size:size,font_weight:weight,text_align:"left"};
    if overrides!=nil {
        if type(overrides)!="map" {throw "ui_typography overrides must be a map";}
        for key in map_keys(overrides) {out[key]=overrides[key];}
    }
    validate(out);return out;
}
fn _apply(node,defaults,depth,state) {
    state.count=state.count+1;
    if depth>24 or state.count>1024 or type(node)!="map" {throw "typography tree exceeds limits";}
    let out=map{};for key in map_keys(node) {out[key]=node[key];}
    let kind=try node.kind catch "";
    if kind=="text" or kind=="heading" or kind=="button" {
        for key in map_keys(defaults) {if not map_has(out,key) {out[key]=defaults[key];}}
        validate(out);
    }
    if map_has(node,"children") {
        if type(node.children)!="array" or len(node.children)>256 {throw "invalid typography children";}
        out.children=[];for child in node.children {push(out.children,_apply(child,defaults,depth+1,state));}
    }
    return out;
}
// A detached view with inherited presentation; controls with a caret stay unchanged.
fn apply(view,defaults) {
    validate(defaults);
    for key in map_keys(defaults) {
        if key!="font_size" and key!="font_weight" and key!="text_align" and key!="font_family"
            and key!="text_spacing" and key!="line_height" {throw "unsupported typography default";}
    }
    return _apply(view,defaults,0,map{count:0});
}
export validate,active,preset,apply;
