// stdlib/polyglot_guard.sapp — a safety gate for the polyglot execution boundary.
//
// stdlib/polyglot can run C/C++/Python/JS/etc. That is powerful and DANGEROUS: foreign
// code can shell out, exfiltrate over the network, delete files, or pull a malicious /
// typosquatted library. This module is the checkpoint you run BEFORE polyglot.run: it
// scans code for dangerous constructs and vets declared dependencies against an allowlist.
// It canonicalizes with stdlib/deobfuscate first, so zero-width / homoglyph / leetspeak
// tricks can't smuggle an `eval` past the scanner. Pure + deterministic.
//
//   let PG = import("stdlib/polyglot_guard.sapp");
//   PG.assert_safe(code, "python");            // throws if dangerous
//   PG.guarded(POLY.run, "python", code);      // assert, THEN run
//
// Honest boundary: a denylist scan is defense-in-depth, not proof of safety. Prefer running
// untrusted polyglot code in a sandbox with no network and a scratch FS; this catches the
// obvious and the obfuscated, and forces a human to look at anything that trips it.

let DEOB = import("stdlib:deobfuscate.sapp");

// HIGH: direct code execution, shell-out, network exfil, destructive filesystem.
// Tables are built once and memoized — scan() is the hot path (may run per snippet).
let _HIGH = nil;
let _MED = nil;
let _KNOWN = nil;
fn _high() {
    if _HIGH != nil { return _HIGH; }
    _HIGH = ["os.system", "subprocess", "system(", "popen", "exec(", "eval(",
        "runtime.getruntime", "child_process", "process::command", "/bin/sh", "cmd.exe", "shell=true",
        "rm -rf", "shutil.rmtree", "os.remove", "unlink(", "fs::remove", "deletefile", "rmdir /",
        "requests.", "urllib", "urlopen", "socket.", "reqwest", "http.client", "fetch(", "curl ", "wget "];
    return _HIGH;
}
// MEDIUM: dynamic evaluation / decoding often used to hide a payload.
fn _medium() {
    if _MED != nil { return _MED; }
    _MED = ["base64", "b64decode", "__import__", "compile(", "marshal.loads", "pickle.loads",
        "codecs.decode", "fromcharcode", "atob(", "vm.runin"];
    return _MED;
}

// scan(code, lang) -> { lang, score, findings:[{pattern,severity}], safe }.
// safe = no HIGH-severity finding AND overall score below the block threshold.
fn scan(code, lang) {
    let canon = str_lower(DEOB.canonicalize(code));   // undo obfuscation, then case-fold
    let findings = [];
    let score = 0.0;
    let highs = _high();
    let i = 0;
    while i < len(highs) {
        if str_contains(canon, highs[i]) {
            array_push(findings, map{ pattern: highs[i], severity: "high" });
            score = score + 0.5;
        }
        i = i + 1;
    }
    let meds = _medium();
    i = 0;
    while i < len(meds) {
        if str_contains(canon, meds[i]) {
            array_push(findings, map{ pattern: meds[i], severity: "medium" });
            score = score + 0.3;
        }
        i = i + 1;
    }
    if score > 1.0 { score = 1.0; }
    let hasHigh = false;
    i = 0;
    while i < len(findings) { if findings[i].severity == "high" { hasHigh = true; } i = i + 1; }
    return map{ lang: lang, score: score, findings: findings, safe: (not hasHigh) and (score < 0.5) };
}

fn is_safe(code, lang) { return scan(code, lang).safe; }

// assert_safe(code, lang) — throws unless the code passes the scan.
fn assert_safe(code, lang) {
    let r = scan(code, lang);
    if not r.safe {
        throw "polyglot_guard: refused unsafe " + str(lang) + " code (" + str(len(r.findings)) + " findings)";
    }
    return true;
}

// guarded(runner, lang, code) — assert_safe, THEN hand off to a runner (e.g. POLY.run).
// Kept decoupled from stdlib/polyglot so this module never itself executes anything.
fn guarded(runner, lang, code) {
    assert_safe(code, lang);
    return runner(lang, code);
}

// ── dependency vetting ──────────────────────────────────────────────────────────────
// known_libs() — the allowlist for the GPU 2D stack + common safe helpers.
fn known_libs() {
    if _KNOWN != nil { return _KNOWN; }
    _KNOWN = ["moderngl", "numpy", "pyopengl", "glfw", "pysdl2", "pygame", "pyglet",
        "wgpu", "glew", "glad", "sdl2", "vulkan", "opengl", "webgpu", "raylib", "skia",
        "struct", "sys", "ctypes", "array", "math"];
    return _KNOWN;
}
fn _in(d, allow) {
    let i = 0;
    while i < len(allow) { if str_lower(allow[i]) == d { return true; } i = i + 1; }
    return false;
}
// check_deps(deps, allow) -> { ok:[...], unknown:[...], ok_all } — flags deps not on the
// allowlist (unknown or typosquatted packages a human must approve before install/run).
fn check_deps(deps, allow) {
    let ok = [];
    let unknown = [];
    let i = 0;
    while i < len(deps) {
        if _in(str_lower(deps[i]), allow) { array_push(ok, deps[i]); }
        else { array_push(unknown, deps[i]); }
        i = i + 1;
    }
    return map{ ok: ok, unknown: unknown, ok_all: len(unknown) == 0 };
}

export scan, is_safe, assert_safe, guarded, known_libs, check_deps;
