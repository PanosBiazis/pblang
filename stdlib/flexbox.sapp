// stdlib/flexbox.sapp — a tiny flexbox-style layout engine (pure pblang).
//
// Lay items out along a main axis (row = horizontal, column = vertical) and return
// positioned boxes. Items are plain maps with intrinsic size and an optional `grow`
// weight: map{ w, h, grow? }. No widget framework required — perfect for arranging an
// IDE's toolbars, status bars, and split panes.
//
//   let flex = import("stdlib:flexbox.sapp");
//   let boxes = flex.row([map{w:80,h:24}, map{w:0,h:24,grow:1}, map{w:80,h:24}],
//                        map{ width: 800, height: 24, gap: 8, justify: "start", align: "center" });
//   // -> [{x,y,w,h}, ...] ; the grow:1 middle item soaks up the leftover width.
//
// opts: { x=0, y=0, width, height, gap=0, pad=0,
//         justify: "start"|"center"|"end"|"space-between"|"space-around",
//         align:   "start"|"center"|"end"|"stretch" }

fn _opt(o, k, d) {
    if o == nil { return d; }
    if not map_has(o, k) { return d; }
    return o[k];
}

fn _flex(items, opts, horiz) {
    let n = len(items);
    let x0 = _opt(opts, "x", 0);
    let y0 = _opt(opts, "y", 0);
    let pad = _opt(opts, "pad", 0);
    let gap = _opt(opts, "gap", 0);
    let justify = _opt(opts, "justify", "start");
    let align = _opt(opts, "align", "start");
    let main_size = if horiz { _opt(opts, "width", 0) } else { _opt(opts, "height", 0) };
    let cross_size = if horiz { _opt(opts, "height", 0) } else { _opt(opts, "width", 0) };

    let mains = [];
    let crosses = [];
    let grows = [];
    let intrinsic = 0;
    let grow_total = 0;
    let i = 0;
    while i < n {
        let it = items[i];
        let m = if horiz { try it.w catch 0 } else { try it.h catch 0 };
        let cr = if horiz { try it.h catch 0 } else { try it.w catch 0 };
        let gw = try it.grow catch 0;
        array_push(mains, m);
        array_push(crosses, cr);
        array_push(grows, gw);
        intrinsic = intrinsic + m;
        grow_total = grow_total + gw;
        i = i + 1;
    }

    let total_gap = 0;
    if n > 1 { total_gap = gap * (n - 1); }
    let avail = main_size - 2 * pad;
    let leftover = avail - intrinsic - total_gap;

    // distribute leftover space to grow items first (then justify has nothing to spread)
    if grow_total > 0 and leftover > 0 {
        i = 0;
        while i < n {
            if grows[i] > 0 { mains[i] = mains[i] + num_floor(leftover * grows[i] / grow_total); }
            i = i + 1;
        }
        leftover = 0;
    }

    let offset = pad;
    let extra = 0;
    if leftover > 0 {
        if justify == "end" { offset = pad + leftover; }
        else if justify == "center" { offset = pad + num_floor(leftover / 2); }
        else if justify == "space-between" and n > 1 { extra = num_floor(leftover / (n - 1)); }
        else if justify == "space-around" and n > 0 { extra = num_floor(leftover / n); offset = pad + num_floor(extra / 2); }
    }

    let out = [];
    let cavail = cross_size - 2 * pad;
    let cur = offset;
    i = 0;
    while i < n {
        let m = mains[i];
        let cr = crosses[i];
        let cpos = pad;
        if align == "center" {
            cpos = pad + num_floor((cavail - cr) / 2);
            if cpos < pad { cpos = pad; }
        } else if align == "end" {
            cpos = pad + (cavail - cr);
        } else if align == "stretch" {
            cr = cavail;
            cpos = pad;
        }
        let bx = 0;
        let by = 0;
        let bw = 0;
        let bh = 0;
        if horiz { bx = x0 + cur; by = y0 + cpos; bw = m; bh = cr; }
        else { bx = x0 + cpos; by = y0 + cur; bw = cr; bh = m; }
        array_push(out, map{ x: bx, y: by, w: bw, h: bh });
        cur = cur + m + gap + extra;
        i = i + 1;
    }
    return out;
}

// row(items, opts) — lay items left-to-right.
fn row(items, opts) { return _flex(items, opts, true); }

// column(items, opts) — lay items top-to-bottom.
fn column(items, opts) { return _flex(items, opts, false); }

export row, column;
