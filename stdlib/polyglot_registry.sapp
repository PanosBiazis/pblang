fn _copy_array(value) {
    if value == nil { return nil; }
    let copied = [];
    let i = 0;
    while i < len(value) { array_push(copied, value[i]); i = i + 1; }
    return copied;
}

fn _copy_entry(entry) {
    return map{
        name: entry.name, category: entry.category, ext: entry.ext,
        run_cmd: entry.run_cmd, run_args_template: _copy_array(entry.run_args_template),
        compile_cmd: entry.compile_cmd,
        compile_args_template: _copy_array(entry.compile_args_template),
        bridge: entry.bridge, description: entry.description,
        use_cases: _copy_array(entry.use_cases)
    };
}

// Public compatibility snapshot. Returning detached entries prevents callers
// from poisoning command names, templates, or bridge classifications.
fn _lang_db() {
    let snapshot = map{};
    let keys = map_keys(_LANG_DB);
    let i = 0;
    while i < len(keys) {
        snapshot[keys[i]] = _copy_entry(_LANG_DB[keys[i]]);
        i = i + 1;
    }
    return snapshot;
}

// ── Availability Detection ────────────────────────────────────────────────────

// _which_cached(cmd) — check if command is available with caching
fn _which_cache() {
    return _registry_which_cache_val;
}

fn _which_cached(cmd) {
    let cache = _which_cache();
    if cache == nil { cache = map{}; }
    if type(cmd) != "string" or len(cmd) < 1 { return false; }
    if map_has(cache, cmd) { return cache[cmd]; }
    let candidates = try POLYGLOT_BUILD.tool_candidates(cmd) catch [];
    let available = len(candidates) > 0;
    cache[cmd] = available;
    _registry_which_cache_val = cache;
    return available;
}

// is_available(lang) — check if a language runtime is installed
fn is_available(lang) {
    let db = _LANG_DB;
    let entry = db[lang];
    if entry == nil { return false; }
    return _which_cached(entry.run_cmd);
}

// detect_all() — detect all installed languages from the 22 supported
fn detect_all() {
    let db = _LANG_DB;
    let keys = map_keys(db);
    let detected = [];
    for i len(keys) {
        let lang = keys[i];
        let available = is_available(lang);
        if available {
            array_push(detected, lang);
        }
    }
    return detected;
}

// _all_lang_keys() — sorted list of all language keys
fn _all_lang_keys() {
    return ["bash", "c", "carbon", "cassandra", "chapel", "clickhouse",
            "cpp", "crystal", "css", "d", "dart", "duckdb", "factor",
            "forth", "go", "haskell", "html", "java", "javascript",
            "kotlin", "less", "lisp", "lua", "matlab", "mojo", "mongodb",
            "mysql", "neo4j", "nim", "odin", "perl", "php", "postgresql",
            "prolog", "purescript", "python", "qsharp", "r", "redis",
            "ruby", "rust", "scss", "solidity", "sql", "swift",
            "typescript", "zig"];
}

// list_languages() — list all 22 supported languages with metadata
fn list_languages() {
    let db = _LANG_DB;
    let all_keys = _all_lang_keys();
    let result = [];
    for i len(all_keys) {
        let lang = all_keys[i];
        let entry = db[lang];
        if entry != nil {
            let avail = is_available(lang);
            array_push(result, map{
                key: lang,
                name: entry.name,
                category: entry.category,
                extension: entry.ext,
                bridge: entry.bridge,
                description: entry.description,
                available: avail,
            });
        }
    }
    return result;
}

// ── Code Execution ────────────────────────────────────────────────────────────

// Legacy compatibility helper. Registry execution no longer publishes shared
// temporary files; callers must not construct their own execution paths.
fn _tmp_path(lang) {
    return nil;
}

let MAX_RUN_CODE_BYTES = 3584;
let MAX_RUN_INPUT_BYTES = 1048576;
let MAX_RUN_OUTPUT_BYTES = 1048576;

fn _bounded_bytes(value, max_bytes) {
    if type(value) != "array" or len(value) > max_bytes { return false; }
    let i = 0;
    while i < len(value) {
        let byte = value[i];
        if type(byte) != "number" or byte != num_floor(byte) or byte < 0 or byte > 255 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn _trusted_source(options) {
    return type(options) == "map" and map_has(options, "trusted_source")
        and type(options.trusted_source) == "bool" and options.trusted_source;
}

// Foreign code is outside PBLang's memory-safety contract. A caller must
// acknowledge that boundary explicitly and bind the acknowledgement to the
// exact source bytes, so a stale approval cannot authorize changed code.
fn _unsafe_polyglot(options, code) {
    return type(options) == "map" and type(code) == "string"
        and map_has(options, "unsafe_polyglot")
        and type(options.unsafe_polyglot) == "bool" and options.unsafe_polyglot
        and map_has(options, "unsafe_polyglot_sha256")
        and type(options.unsafe_polyglot_sha256) == "string"
        and options.unsafe_polyglot_sha256 == sha256(code);
}

fn _toolchain_effects(options) {
    return type(options) == "map" and map_has(options, "allow_toolchain_effects")
        and type(options.allow_toolchain_effects) == "bool" and options.allow_toolchain_effects;
}

fn _run_failure(message, lang = "", acknowledged = false, unsafe_acknowledged = false) {
    return map{ format: "pblang.polyglot-run.v2", ok: false, complete: false,
        executed: false, bounded: false, sandboxed: false, raw_fallback: false,
        trusted_source_required: true, trusted_source_acknowledged: acknowledged,
        unsafe_polyglot_required: true,
        unsafe_polyglot_acknowledged: unsafe_acknowledged,
        unsafe_polyglot_hash_bound: unsafe_acknowledged,
        trusted_source_authorized: false, trust_is_acknowledgement: true,
        authority_scope: "vm_capability", multi_principal_safe: false,
        principal_isolation_required: true,
        execution_capability_required: true, execution_capability_observed: false,
        language: lang, stdout: "", stderr: message,
        error: message, exit_code: -1, timed_out: false, output_truncated: false,
        executable_descriptor_held: false, executable_nofollow: false,
        check_then_exec_race: false };
}

fn _run_argv(lang, code) {
    if lang == "python" { return ["-I", "-S", "-c", code]; }
    if lang == "javascript" { return ["-e", code]; }
    if lang == "ruby" { return ["--disable-gems", "-e", code]; }
    if lang == "bash" { return ["--noprofile", "--norc", "-c", code]; }
    if lang == "perl" { return ["-T", "-e", code]; }
    if lang == "lua" { return ["-e", code]; }
    if lang == "php" { return ["-n", "-r", code]; }
    if lang == "r" { return ["--vanilla", "--slave", "-e", code]; }
    return nil;
}

// Foreign source is executable authority. Callers must opt in explicitly; the
// fixed backend bounds resources but is not an OS filesystem/network sandbox.
fn run(lang, code, options = nil) {
    let key = alias(str_lower(str_trim(str(lang))));
    if not _unsafe_polyglot(options, code) {
        return _run_failure("explicit unsafe_polyglot=true with the exact unsafe_polyglot_sha256 is required",
            key, _trusted_source(options), false);
    }
    if not _trusted_source(options) {
        return _run_failure("explicit trusted_source=true is required", key, false, true);
    }
    if not map_has(_LANG_DB, key) {
        return _run_failure("unsupported language: " + key, key, true, true);
    }
    if type(code) != "string" or len(str_to_bytes(code)) > MAX_RUN_CODE_BYTES
       or str_contains(code, strfromcharcode(0)) {
        return _run_failure("trusted source must be a NUL-free string within 3584 bytes", key, true, true);
    }
    let timeout_secs = if map_has(options, "timeout_secs") { options.timeout_secs } else { 10 };
    if type(timeout_secs) != "number" or timeout_secs != num_floor(timeout_secs)
       or timeout_secs < 1 or timeout_secs > 30 {
        return _run_failure("timeout_secs must be an integer from 1 to 30", key, true, true);
    }
    let stdin_bytes = nil;
    if map_has(options, "stdin_bytes") {
        stdin_bytes = options.stdin_bytes;
        if not _bounded_bytes(stdin_bytes, MAX_RUN_INPUT_BYTES) {
            return _run_failure("stdin_bytes must contain at most 1048576 bytes", key, true, true);
        }
    }
    let argv = _run_argv(key, code);
    if argv == nil {
        return _run_failure("language has no bounded direct-execution adapter", key, true, true);
    }
    let entry = _LANG_DB[key];
    let candidates = POLYGLOT_BUILD.tool_candidates(entry.run_cmd);
    if len(candidates) == 0 {
        return _run_failure(key + " runtime is unavailable or bounded executable resolution was denied", key, true, true);
    }
    let process_options = map{
        timeout_secs: timeout_secs, startup_timeout_ms: 3000,
        max_output_bytes: MAX_RUN_OUTPUT_BYTES, max_file_bytes: MAX_RUN_OUTPUT_BYTES,
        max_memory_bytes: 536870912, inherit_environment: false,
        environment: map{ PATH: "/usr/bin:/bin", HOME: "/nonexistent",
            TMPDIR: "/tmp", LANG: "C.UTF-8", LC_ALL: "C.UTF-8" }
    };
    if stdin_bytes != nil { process_options.stdin_bytes = stdin_bytes; }
    let result = PROCESS.run_fixed_bounded(candidates, argv, process_options);
    let command_ok = try result.command_ok catch false;
    let bounded = try result.bounded catch false;
    let timed_out = try result.timed_out catch false;
    let truncated = try result.output_truncated catch false;
    let error_message = try result.error catch (try result.stderr catch "bounded execution failed");
    if command_ok and bounded and not timed_out and not truncated { error_message = ""; }
    elif error_message == "" {
        if timed_out { error_message = "bounded foreign execution timed out"; }
        elif truncated { error_message = "bounded foreign execution exceeded its output limit"; }
        else { error_message = "bounded foreign execution failed"; }
    }
    return map{ format: "pblang.polyglot-run.v2",
        ok: command_ok and bounded and not timed_out and not truncated,
        complete: command_ok and bounded and not timed_out and not truncated,
        executed: try result.completed catch (try result.ok catch false),
        bounded: bounded, sandboxed: false, effects_confined: false,
        raw_fallback: false, trusted_source_required: true,
        trusted_source_acknowledged: true, trusted_source_authorized: false,
        unsafe_polyglot_required: true, unsafe_polyglot_acknowledged: true,
        unsafe_polyglot_hash_bound: true,
        trust_is_acknowledgement: true, execution_capability_required: true,
        authority_scope: "vm_capability", multi_principal_safe: false,
        principal_isolation_required: true,
        execution_capability_observed: try result.completed catch (try result.ok catch false),
        language: key,
        stdin_bounded: stdin_bytes != nil,
        input_bytes: if stdin_bytes == nil { 0 } else { len(stdin_bytes) },
        stdout: try result.stdout catch "", stderr: try result.stderr catch "",
        error: error_message, exit_code: try result.exit_code catch -1,
        timed_out: timed_out, output_truncated: truncated,
        memory_limit_enforced: try result.memory_limit_enforced catch false,
        process_group_terminated: try result.process_group_terminated catch false,
        executable_descriptor_held: try result.executable_descriptor_held catch false,
        executable_nofollow: try result.executable_nofollow catch false,
        check_then_exec_race: try result.check_then_exec_race catch false,
        fixed_candidate: try result.fixed_candidate catch "" };
}

// Text-filter compatibility path. Input remains data on a private bounded
// descriptor and is never interpolated into foreign source or argv.
fn run_with_input(lang, code, input, options = nil) {
    let key = alias(str_lower(str_trim(str(lang))));
    if not _trusted_source(options) {
        return _run_failure("explicit trusted_source=true is required", key,
            false, _unsafe_polyglot(options, code));
    }
    if type(input) != "string" {
        return _run_failure("input must be a UTF-8 string", key, true,
            _unsafe_polyglot(options, code));
    }
    let bytes = str_to_bytes(input);
    if len(bytes) > MAX_RUN_INPUT_BYTES {
        return _run_failure("input exceeds the 1048576-byte limit", key, true,
            _unsafe_polyglot(options, code));
    }
    let effective = map{};
    if options != nil and map_has(options, "trusted_source") {
        effective.trusted_source = options.trusted_source;
    }
    if options != nil and map_has(options, "timeout_secs") {
        effective.timeout_secs = options.timeout_secs;
    }
    if options != nil and map_has(options, "unsafe_polyglot") {
        effective.unsafe_polyglot = options.unsafe_polyglot;
    }
    if options != nil and map_has(options, "unsafe_polyglot_sha256") {
        effective.unsafe_polyglot_sha256 = options.unsafe_polyglot_sha256;
    }
    effective.stdin_bytes = bytes;
    return run(key, code, effective);
}

// ── Compilation ───────────────────────────────────────────────────────────────

fn _compile_failure(message, lang = "", source_acknowledged = false,
    effects_acknowledged = false, unsafe_acknowledged = false) {
    return map{ format: "pblang.polyglot-compile.v2", ok: false,
        complete: false, compiled: false, executed: false, bounded: false,
        sandboxed: false, raw_fallback: false, artifact_verified: false,
        cleanup_complete: true, language: lang, artifact: "", error: message,
        trusted_source_required: true, trusted_source_acknowledged: source_acknowledged,
        unsafe_polyglot_required: true,
        unsafe_polyglot_acknowledged: unsafe_acknowledged,
        unsafe_polyglot_hash_bound: unsafe_acknowledged,
        trusted_source_authorized: false, trust_is_acknowledgement: true,
        authority_scope: "vm_capability", multi_principal_safe: false,
        principal_isolation_required: true,
        toolchain_effects_required: true,
        toolchain_effects_acknowledged: effects_acknowledged,
        toolchain_effects_authorized: false, execution_capability_required: true };
}

// `output` is now an approved output root. The concrete artifact remains under
// an exclusive private session created by polyglot_build.
fn compile(lang, code, output, options = nil) {
    let key = alias(str_lower(str_trim(str(lang))));
    let source_acknowledged = _trusted_source(options);
    let effects_acknowledged = _toolchain_effects(options);
    let unsafe_acknowledged = _unsafe_polyglot(options, code);
    if not source_acknowledged or not effects_acknowledged or not unsafe_acknowledged {
        return _compile_failure(
            "explicit unsafe_polyglot=true, exact unsafe_polyglot_sha256, trusted_source=true and allow_toolchain_effects=true are required", key,
            source_acknowledged, effects_acknowledged, unsafe_acknowledged);
    }
    if not map_has(_LANG_DB, key) {
        return _compile_failure("unsupported language: " + key, key, true, true, true);
    }
    if not POLYGLOT_BUILD.validate_build_request("registry_build", code, output).ok {
        return _compile_failure("invalid bounded build request", key, true, true, true);
    }
    let built = try POLYGLOT_BUILD.build_language(key, "registry_build", code, output, options)
        catch nil;
    if built == nil { return _compile_failure("bounded build dispatch failed", key, true, true, true); }
    let toolchain_executed = try built.toolchain_executed catch false;
    let operation_bounded = try built.bounded catch false;
    let artifact_kind = try built.artifact_kind catch "unknown";
    if not (try built.ok catch false) or (try built.status catch "") == "fallback" {
        return map{ format: "pblang.polyglot-compile.v2", ok: false,
            complete: false, compiled: false, published: map_has(built, "artifact"),
            executed: toolchain_executed, toolchain_executed: toolchain_executed,
            bounded: operation_bounded, sandboxed: false,
            raw_fallback: false, artifact_verified: false, cleanup_complete: false,
            cleanup_required: (try built.cleanup_required catch false)
                or map_has(built, "artifact"), language: key,
            artifact: try built.artifact catch "", detail: built,
            error: try built.error catch (try built.warning catch "toolchain did not produce a compiled artifact"),
            trusted_source_required: true, trusted_source_acknowledged: true,
            unsafe_polyglot_required: true, unsafe_polyglot_acknowledged: true,
            unsafe_polyglot_hash_bound: true,
            trusted_source_authorized: false, trust_is_acknowledgement: true,
            authority_scope: "vm_capability", multi_principal_safe: false,
            principal_isolation_required: true,
            toolchain_effects_required: true, toolchain_effects_acknowledged: true,
            toolchain_effects_authorized: false, execution_capability_required: true,
            execution_capability_observed: toolchain_executed };
    }
    let artifact = try built.artifact catch "";
    let verified = if artifact != "" { POLYGLOT_BUILD.verify_artifact(artifact) }
        else { map{ ok: false } };
    if not (try verified.ok catch false) {
        return map{ format: "pblang.polyglot-compile.v2", ok: false,
            complete: false, compiled: false, published: artifact != "",
            executed: toolchain_executed, toolchain_executed: toolchain_executed,
            bounded: operation_bounded, sandboxed: false,
            raw_fallback: false, artifact_verified: false, cleanup_complete: false,
            cleanup_required: artifact != "", language: key, artifact: artifact,
            detail: built, error: "compiler result is not one bounded verified file artifact",
            trusted_source_required: true, trusted_source_acknowledged: true,
            unsafe_polyglot_required: true, unsafe_polyglot_acknowledged: true,
            unsafe_polyglot_hash_bound: true,
            trusted_source_authorized: false, trust_is_acknowledgement: true,
            authority_scope: "vm_capability", multi_principal_safe: false,
            principal_isolation_required: true,
            toolchain_effects_required: true, toolchain_effects_acknowledged: true,
            toolchain_effects_authorized: false, execution_capability_required: true,
            execution_capability_observed: toolchain_executed };
    }
    let compiled = try built.compiled catch false;
    return map{ format: "pblang.polyglot-compile.v2", ok: true,
        complete: true, compiled: compiled, published: true,
        executed: toolchain_executed, toolchain_executed: toolchain_executed,
        bounded: operation_bounded, sandboxed: false,
        effects_confined: false, raw_fallback: false, artifact_verified: true,
        artifact_kind: artifact_kind,
        artifact_size: verified.size, artifact_sha256: verified.sha256,
        cleanup_complete: false, cleanup_required: true, output_is_root: true,
        language: key, artifact: artifact, bridge: _LANG_DB[key].bridge,
        trusted_source_required: true, trusted_source_acknowledged: true,
        unsafe_polyglot_required: true, unsafe_polyglot_acknowledged: true,
        unsafe_polyglot_hash_bound: true,
        trusted_source_authorized: false, trust_is_acknowledgement: true,
        authority_scope: "vm_capability", multi_principal_safe: false,
        principal_isolation_required: true,
        toolchain_effects_required: true, toolchain_effects_acknowledged: true,
        toolchain_effects_authorized: false, execution_capability_required: true,
        execution_capability_observed: toolchain_executed };
}

// ── Bridging ──────────────────────────────────────────────────────────────────

// Generic in-process FFI cannot enforce descriptor-held library identity,
// constructor isolation, ABI safety, or crash containment. Keep this legacy
// entrypoint fail-closed until a brokered typed FFI process exists.
fn ffi_bridge(lang, lib_path, fn_name, args) {
    return map{ format: "pblang.polyglot-ffi.v2", ok: false,
        complete: false, executed: false, bounded: false, sandboxed: false,
        raw_fallback: false, policy_required: true, broker_required: true,
        language: str(lang), result: nil,
        error: "generic in-process FFI is disabled; use a brokered typed FFI capability" };
}

let MAX_JSON_BRIDGE_CODE_BYTES = 3584;
let MAX_JSON_BRIDGE_WRAPPER_BYTES = 4096;
let MAX_JSON_BRIDGE_INPUT_BYTES = 1048576;

fn _json_bridge_language(lang) {
    let value = str_lower(str_trim(str(lang)));
    if value == "python" or value == "python3" { return "python"; }
    if value == "javascript" or value == "js" or value == "node" { return "javascript"; }
    if value == "ruby" { return "ruby"; }
    return "";
}

fn _parse_bridge_json(input_json) {
    return SERIALIZATION.parse_safe(input_json, "json", map{
        max_input_bytes: MAX_JSON_BRIDGE_INPUT_BYTES,
        max_output_bytes: MAX_JSON_BRIDGE_INPUT_BYTES,
        max_depth: 64, max_items: 100000, strict: true
    });
}

fn _public_bridge_plan(plan) {
    if not plan.ok { return plan; }
    return map{ ok: true, format: plan.format, language: plan.language,
        wrapper: plan.wrapper, input_bytes: plan.input_bytes,
        max_input_bytes: plan.max_input_bytes,
        input_embedded_in_source: false, transport: plan.transport,
        executed: false, bounded_parse: true };
}

// Prepare a fixed wrapper while keeping caller JSON on stdin. The validated
// input is measured but never interpolated into executable foreign source.
fn _prepare_json_bridge(lang, code, input_json) {
    let language = _json_bridge_language(lang);
    if language == "" {
        return map{ ok: false, error: "json bridge supports python, javascript, and ruby only",
            language: str(lang), executed: false };
    }
    if type(code) != "string" or len(str_to_bytes(code)) > MAX_JSON_BRIDGE_CODE_BYTES {
        return map{ ok: false, error: "json bridge code limit exceeded",
            language: language, executed: false };
    }
    if type(input_json) != "string" or len(str_to_bytes(input_json)) > MAX_JSON_BRIDGE_INPUT_BYTES {
        return map{ ok: false, error: "json bridge input limit exceeded",
            language: language, executed: false };
    }
    let parsed = _parse_bridge_json(input_json);
    if not parsed.ok {
        return map{ ok: false, error: "json bridge input is not valid JSON",
            language: language, executed: false, bounded_parse: true,
            diagnostics: parsed.diagnostics };
    }

    let wrapper = "";
    if language == "python" {
        wrapper = "import json, sys\ninput_data = json.load(sys.stdin)\n" + code + "\n"
            + "if '__result__' in globals():\n    print(json.dumps(__result__))\n";
    } elif language == "javascript" {
        wrapper = "const fs = require('fs');\nconst input_data = JSON.parse(fs.readFileSync(0, 'utf8'));\n"
            + code + "\nprocess.stdout.write(JSON.stringify(__result__));\n";
    } else {
        wrapper = "require 'json'\ninput_data = JSON.parse(STDIN.read)\n" + code
            + "\nputs __result__.to_json\n";
    }
    if len(str_to_bytes(wrapper)) > MAX_JSON_BRIDGE_WRAPPER_BYTES {
        return map{ ok: false, error: "json bridge wrapper limit exceeded",
            language: language, executed: false };
    }
    return map{ ok: true, format: "pblang.polyglot-json-bridge.v2",
        language: language, wrapper: wrapper, input_bytes: len(str_to_bytes(input_json)),
        max_input_bytes: MAX_JSON_BRIDGE_INPUT_BYTES, input_embedded_in_source: false,
        transport: "stdin", executed: false, bounded_parse: true,
        input_value: parsed.value };
}

fn prepare_json_bridge(lang, code, input_json) {
    return _public_bridge_plan(_prepare_json_bridge(lang, code, input_json));
}

// json_bridge(lang, code, input_json, options) — JSON is data on stdin and can never
// terminate a generated source literal.
fn json_bridge(lang, code, input_json, options = nil) {
    if not _unsafe_polyglot(options, code) {
        return _run_failure("explicit unsafe_polyglot=true with the exact unsafe_polyglot_sha256 is required",
            _json_bridge_language(lang), _trusted_source(options), false);
    }
    if not _trusted_source(options) {
        return _run_failure("explicit trusted_source=true is required",
            _json_bridge_language(lang), false, true);
    }
    let plan = _prepare_json_bridge(lang, code, input_json);
    if not plan.ok {
        plan.trusted_source_required = true;
        plan.trusted_source_acknowledged = true;
        plan.trusted_source_authorized = false;
        plan.trust_is_acknowledgement = true;
        plan.execution_capability_required = true;
        return plan;
    }
    let bounded = BOUNDED_INTEROP.run_filter(plan.language, code, plan.input_value, 10,
        map{ trusted_source: true, unsafe_polyglot: true,
            unsafe_polyglot_sha256: sha256(code) });
    let result = map{
        ok: bounded.ok, output: bounded.stdout,
        error_output: if bounded.stderr != "" { bounded.stderr } else { bounded.error },
        exit_code: bounded.exit_code, language: plan.language,
        executed: bounded.executed, bounded: bounded.bounded,
        timed_out: bounded.timed_out, output_truncated: bounded.output_truncated,
        transport: "private-stdin", input_embedded_in_source: false,
        raw_fallback: false, bounded_parse: true, trusted_source_required: true,
        trusted_source_acknowledged: true, trusted_source_authorized: false,
        unsafe_polyglot_required: true, unsafe_polyglot_acknowledged: true,
        unsafe_polyglot_hash_bound: true,
        trust_is_acknowledgement: true, execution_capability_required: true,
        execution_capability_observed: bounded.executed
    };
    result.input_bytes = plan.input_bytes;
    return result;
}

// ── Language Recommendation ───────────────────────────────────────────────────

// best_for(task) — recommend the best language for a given task
fn best_for(task) {
    let t = str_lower(task);

    if str_contains(t, "web") or str_contains(t, "server") or str_contains(t, "api") {
        return map{ recommended: "go", reason: "Go excels at web servers and APIs" };
    }
    if str_contains(t, "ai") or str_contains(t, "ml") or str_contains(t, "machine learning") or str_contains(t, "data science") {
        return map{ recommended: "python", reason: "Python dominates AI/ML with vast ecosystem" };
    }
    if str_contains(t, "system") or str_contains(t, "embedded") or str_contains(t, "kernel") or str_contains(t, "driver") {
        return map{ recommended: "rust", reason: "Rust provides memory safety for systems programming" };
    }
    if str_contains(t, "mobile") or str_contains(t, "android") {
        return map{ recommended: "kotlin", reason: "Kotlin is the preferred language for Android development" };
    }
    if str_contains(t, "ios") or str_contains(t, "apple") or str_contains(t, "macos") {
        return map{ recommended: "swift", reason: "Swift is Apple's recommended language for their platforms" };
    }
    if str_contains(t, "frontend") or str_contains(t, "ui") or str_contains(t, "browser") {
        return map{ recommended: "typescript", reason: "TypeScript adds type safety to frontend development" };
    }
    if str_contains(t, "script") or str_contains(t, "automation") or str_contains(t, "glue") {
        return map{ recommended: "python", reason: "Python excels at scripting and automation" };
    }
    if str_contains(t, "statistic") or str_contains(t, "research") or str_contains(t, "visualization") {
        return map{ recommended: "r", reason: "R is purpose-built for statistical computing" };
    }
    if str_contains(t, "text") or str_contains(t, "regex") or str_contains(t, "parsing") {
        return map{ recommended: "perl", reason: "Perl has first-class regex and text processing" };
    }
    if str_contains(t, "game") {
        return map{ recommended: "cpp", reason: "C++ is the industry standard for game development" };
    }
    if str_contains(t, "cross") or str_contains(t, "compile") {
        return map{ recommended: "zig", reason: "Zig excels at cross-compilation" };
    }
    if str_contains(t, "functional") or str_contains(t, "math") or str_contains(t, "formal") {
        return map{ recommended: "haskell", reason: "Haskell is the gold standard for functional programming" };
    }
    if str_contains(t, "devops") or str_contains(t, "ci") or str_contains(t, "deploy") {
        return map{ recommended: "bash", reason: "Bash is the universal glue for DevOps pipelines" };
    }

    return map{ recommended: "python", reason: "Python is a versatile general-purpose language" };
}

// _ext_for_lang(lang) — file extension for a language
fn _ext_for_lang(lang) {
    if map_has(_LANG_DB, lang) { return _LANG_DB[lang].ext; }
    return "txt";
}

// ── pure lookups (no exec, unlike is_available which probes the toolchain) ─────────

// is_supported(lang) — true if the registry knows this language (toolchain may still
// be absent — use is_available for that). map_has guard: missing-key read throws.
fn is_supported(lang) { return map_has(_LANG_DB, lang); }

fn _extension_index() {
    if not _registry_ext_cache_ready {
        let db = _LANG_DB;
        let ks = map_keys(db);
        let i = 0;
        while i < len(ks) {
            let lang = ks[i];
            let ext = db[lang].ext;
            if not map_has(_registry_ext_cache_val, ext) {
                _registry_ext_cache_val[ext] = lang;
            }
            i = i + 1;
        }
        _registry_ext_cache_ready = true;
    }
    return _registry_ext_cache_val;
}

// lang_for_ext(ext) — the language key whose source extension is ext, or nil.
fn lang_for_ext(ext) {
    let index = _extension_index();
    if map_has(index, ext) { return index[ext]; }
    return nil;
}

// category_of(lang) — "compiled"/"interpreted"/... or nil if unknown.
fn category_of(lang) {
    if not map_has(_LANG_DB, lang) { return nil; }
    return _LANG_DB[lang].category;
}

// alias(name) — canonicalize a common language alias (js->javascript, py->python …).
// Returns the input unchanged if it is not a known alias.
fn alias(name) {
    if map_has(_ALIASES, name) { return _ALIASES[name]; }
    return name;
}

// extensions() — the distinct source extensions known to the registry.
fn extensions() {
    return map_keys(_extension_index());
}

export run, run_with_input, compile, is_available, detect_all;
export ffi_bridge, prepare_json_bridge, json_bridge;
export list_languages, best_for;
export _lang_db, _ext_for_lang, _tmp_path;
export is_supported, lang_for_ext, category_of;
export alias, extensions;
