// stdlib/polyglot_registry.sapp — Language Registry for pblang Polyglot System
//
// A registry that knows how to run, compile, and bridge 22+ programming
// languages from within pblang. Auto-detects installed languages and
// provides unified APIs for execution, compilation, and FFI bridging.
//
// Usage:
//   let reg = import("stdlib:polyglot_registry.sapp");
//   let langs = reg.detect_all();
//   reg.run("python", "print('hello')");

let BOUNDED_INTEROP = import("stdlib:interop.sapp");
let PROCESS = import("stdlib:process.sapp");
let POLYGLOT_BUILD = import("stdlib:polyglot_build.sapp");
let SERIALIZATION = import("stdlib:serialization.sapp");

// Module-level state for caching
let _registry_which_cache_val = map{};
let _registry_ext_cache_val = map{};
let _registry_ext_cache_ready = false;

let _ALIASES = map{
    js: "javascript", node: "javascript", ts: "typescript",
    py: "python", py3: "python", python3: "python", rb: "ruby", rs: "rust",
    golang: "go", cxx: "cpp", cs: "csharp", kt: "kotlin",
    pl: "perl", sh: "bash", shell: "bash",
    "c++": "cpp", "c#": "csharp",
};

