// ── Availability Detection ────────────────────────────────────────────────────

// _which_cached(cmd) — check if command is available with caching
fn _which_cache() {
    return _registry_which_cache_val;
}

fn _which_cached(cmd) {
    let cache = _which_cache();
    if cache == nil { cache = map{}; }
    if map_has(cache, cmd) { return cache[cmd]; }
    let result = try exec("which " + cmd + " > /dev/null 2>&1 && echo yes || echo no") catch "no";
    let available = str_contains(result, "yes");
    cache[cmd] = available;
    _registry_which_cache_val = cache;
    return available;
}

// is_available(lang) — check if a language runtime is installed
fn is_available(lang) {
    let db = _lang_db();
    let entry = db[lang];
    if entry == nil { return false; }
    return _which_cached(entry.run_cmd);
}

// detect_all() — detect all installed languages from the 22 supported
fn detect_all() {
    let db = _lang_db();
    let keys = map_keys(db);
    let detected = [];
    for i len(keys) {
        let lang = keys[i];
        let available = is_available(lang);
        if available {
            array_push(detected, lang);
        }
    }
    return detected;
}

// _all_lang_keys() — sorted list of all language keys
fn _all_lang_keys() {
    return ["bash", "c", "carbon", "cassandra", "chapel", "clickhouse",
            "cpp", "crystal", "css", "d", "dart", "duckdb", "factor",
            "forth", "go", "haskell", "html", "java", "javascript",
            "kotlin", "less", "lisp", "lua", "matlab", "mojo", "mongodb",
            "mysql", "neo4j", "nim", "odin", "perl", "php", "postgresql",
            "prolog", "purescript", "python", "qsharp", "r", "redis",
            "ruby", "rust", "scss", "solidity", "sql", "swift",
            "typescript", "zig"];
            "go", "haskell", "html", "java", "javascript", "kotlin",
            "less", "lua", "matlab", "mongodb", "mysql", "nim", "perl",
            "php", "postgresql", "prolog", "python", "qsharp", "r",
            "redis", "ruby", "rust", "scss", "solidity", "sql",
            "swift", "typescript", "zig"];
            "java", "javascript", "kotlin", "lua", "nim", "perl", "php",
            "python", "r", "ruby", "rust", "swift", "typescript", "zig"];
}

// list_languages() — list all 22 supported languages with metadata
fn list_languages() {
    let db = _lang_db();
    let all_keys = _all_lang_keys();
    let result = [];
    for i len(all_keys) {
        let lang = all_keys[i];
        let entry = db[lang];
        if entry != nil {
            let avail = is_available(lang);
            array_push(result, map{
                key: lang,
                name: entry.name,
                category: entry.category,
                extension: entry.ext,
                bridge: entry.bridge,
                description: entry.description,
                available: avail,
            });
        }
    }
    return result;
}

// ── Code Execution ────────────────────────────────────────────────────────────

// _tmp_path(lang) — generate a temp file path for a language
fn _tmp_path(lang) {
    let db = _lang_db();
    let entry = db[lang];
    let ext = "txt";
    if entry != nil { ext = entry.ext; }
    return "/tmp/pblang_poly_" + lang + "_" + str(random_float()) + "." + ext;
}

// run(lang, code) — execute code in any language
fn run(lang, code) {
    let db = _lang_db();
    let entry = db[lang];
    if entry == nil {
        return map{ ok: false, stdout: "", stderr: "unsupported language: " + lang, exit_code: -1 };
    }

    // Check availability
    if is_available(lang) == false {
        return map{ ok: false, stdout: "", stderr: lang + " runtime not installed", exit_code: -1 };
    }

    // Write code to temp file
    let tmp_path = _tmp_path(lang);
    let wrote = try fs_write(tmp_path, code) catch false;
    if wrote == false {
        return map{ ok: false, stdout: "", stderr: "failed to write temp file", exit_code: -1 };
    }

    // Build args: append temp file path
    let args = [];
    let template = entry.run_args_template;
    if template != nil {
        for i len(template) {
            array_push(args, template[i]);
        }
    }
    array_push(args, tmp_path);

    // Execute
    let result = try {
        let r = proc_spawn_wait(entry.run_cmd, args);
        r
    } catch map{ exit_code: -1, stdout: "", stderr: "subprocess failed" };

    // Cleanup and return
    try fs_remove(tmp_path) catch nil;

    return map{
        ok: result.exit_code == 0,
        stdout: result.stdout,
        stderr: result.stderr,
        exit_code: result.exit_code,
        language: lang,
    };
}

// ── Compilation ───────────────────────────────────────────────────────────────

// compile(lang, code, output) — compile code to shared library in any language
fn compile(lang, code, output) {
    let db = _lang_db();
    let entry = db[lang];
    if entry == nil {
        return map{ error: "unsupported language: " + lang };
    }
    if entry.compile_cmd == nil {
        return map{ error: lang + " does not support compilation" };
    }
    if is_available(lang) == false {
        return map{ error: lang + " not installed" };
    }

    // Handle compiled languages that need a temp file first
    let src_file = _tmp_path(lang);
    let wrote = try fs_write(src_file, code) catch false;
    if wrote == false {
        return map{ error: "failed to write source file" };
    }

    // Build compile command
    let platform_ext = ".so";
    let p = platform();
    if p == "windows" { platform_ext = ".dll"; }
    if p == "macos" { platform_ext = ".dylib"; }
    let out_file = output;
    if str_ends_with(out_file, platform_ext) == false {
        out_file = out_file + platform_ext;
    }

    // Lang-specific compile logic
    if lang == "rust" {
        // Special: cargo needs a project structure
        try fs_remove(src_file) catch nil;
        let proj_dir = output + "_rust_proj";
        fs_mkdirs(proj_dir);
        fs_write(proj_dir + "/Cargo.toml",
            "[package]\nname = \"pblang_polyglot\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[lib]\ncrate-type = [\"cdylib\"]\npath = \"lib.rs\"\n");
        fs_write(proj_dir + "/lib.rs", code);
        let result = try {
            let r = proc_spawn_wait("cargo", ["build", "--release", "--manifest-path", proj_dir + "/Cargo.toml"]);
            r
        } catch map{ exit_code: -1, stdout: "", stderr: "cargo build failed" };
        if result.exit_code != 0 {
            return map{ error: "rust build failed: " + result.stderr };
        }
        let lib_name = if p == "windows" { "pblang_polyglot.dll" } else { "libpblang_polyglot.so" };
        return map{
            ok: true,
            language: lang,
            artifact: proj_dir + "/target/release/" + lib_name,
            bridge: "ffi",
        };
    }

    if lang == "go" {
        try fs_remove(src_file) catch nil;
        let src_dir = output + "_go_proj";
        fs_mkdirs(src_dir);
        fs_write(src_dir + "/main.go", code);
        fs_write(src_dir + "/go.mod", "module pblang_polyglot\n\ngo 1.21\n");
        let result = try {
            let r = proc_spawn_wait("go", ["build", "-buildmode=c-shared", "-o", out_file, src_dir + "/main.go"]);
            r
        } catch map{ exit_code: -1, stdout: "", stderr: "go build failed" };
        if result.exit_code != 0 {
            return map{ error: "go build failed: " + result.stderr };
        }
        return map{
            ok: true,
            language: lang,
            artifact: out_file,
            bridge: "ffi",
        };
    }

    if lang == "c" or lang == "cpp" {
        let cxx = "cc";
        if lang == "cpp" { cxx = "c++"; }
        let std_flag = "";
        if lang == "cpp" { std_flag = "-std=c++17"; }
        let result = try {
            let r = proc_spawn_wait(cxx, ["-shared", "-fPIC", std_flag, "-o", out_file, src_file]);
            r
        } catch map{ exit_code: -1, stdout: "", stderr: "compile failed" };
        try fs_remove(src_file) catch nil;
        if result.exit_code != 0 {
            return map{ error: lang + " build failed: " + result.stderr };
        }
        return map{
            ok: true,
            language: lang,
            artifact: out_file,
            bridge: "ffi",
        };
    }

    // Generic: use compile_cmd + compile_args_template + output + src
    let cmd_args = [];
    let template = entry.compile_args_template;
    if template != nil {
        for i len(template) {
            array_push(cmd_args, template[i]);
        }
    }
    array_push(cmd_args, out_file);
    array_push(cmd_args, src_file);

    let result = try {
        let r = proc_spawn_wait(entry.compile_cmd, cmd_args);
        r
    } catch map{ exit_code: -1, stdout: "", stderr: "compile failed" };
    try fs_remove(src_file) catch nil;

    if result.exit_code != 0 {
        return map{ error: lang + " build failed: " + result.stderr };
    }

    return map{
        ok: true,
        language: lang,
        artifact: out_file,
        bridge: entry.bridge,
    };
}

// ── Bridging ──────────────────────────────────────────────────────────────────

// ffi_bridge(lang, lib_path, fn_name, args) — call a foreign function via FFI
fn ffi_bridge(lang, lib_path, fn_name, args) {
    let db = _lang_db();
    let entry = db[lang];
    if entry == nil {
        return map{ error: "unsupported language: " + lang };
    }
    if entry.bridge != "ffi" {
        return map{ error: lang + " uses " + entry.bridge + " bridge, not ffi" };
    }
    let lib = try ffi_load(lib_path) catch nil;
    if lib == nil {
        return map{ error: "failed to load library: " + lib_path };
    }
    let result = try {
        let r = ffi_call(lib, fn_name, args);
        ffi_close(lib);
        r
    } catch 0.0;
    return map{
        ok: true,
        result: result,
        language: lang,
    };
}

// json_bridge(lang, code, input_json) — call a language via JSON protocol
fn json_bridge(lang, code, input_json) {
    let db = _lang_db();
    let entry = db[lang];
    if entry == nil {
        return map{ error: "unsupported language: " + lang };
    }
    if is_available(lang) == false {
        return map{ error: lang + " not installed" };
    }

    // Write code to temp file
    let tmp_path = _tmp_path(lang);
    let wrapper_code = "";
    if lang == "python" or lang == "python3" {
        wrapper_code =
            "import json, sys\n" +
            "input_data = json.loads('''" + input_json + "''')\n" +
            code + "\n";
        // Append a JSON serialization wrapper
        if str_contains(code, "__result__") {
            wrapper_code = wrapper_code +
                "print(json.dumps(__result__))\n";
        }
    } else if lang == "javascript" {
        wrapper_code =
            "const input = JSON.parse('" + input_json + "');\n" +
            code + "\n" +
            "process.stdout.write(JSON.stringify(__result__));\n";
    } else if lang == "ruby" {
        wrapper_code =
            "require 'json'\n" +
            "input_data = JSON.parse('" + input_json + "')\n" +
            code + "\n" +
            "puts __result__.to_json\n";
    } else {
        // Generic: just append input as last line argument
        wrapper_code = code;
    }

    let wrote = try fs_write(tmp_path, wrapper_code) catch false;
    if wrote == false {
        return map{ error: "failed to write temp file" };
    }

    let args = [];
    let template = entry.run_args_template;
    if template != nil {
        for i len(template) {
            array_push(args, template[i]);
        }
    }
    array_push(args, tmp_path);

    let result = try {
        let r = proc_spawn_wait(entry.run_cmd, args);
        r
    } catch map{ exit_code: -1, stdout: "", stderr: "subprocess failed" };

    try fs_remove(tmp_path) catch nil;

    return map{
        ok: result.exit_code == 0,
        output: result.stdout,
        error_output: result.stderr,
        language: lang,
    };
}

// ── Language Recommendation ───────────────────────────────────────────────────

// best_for(task) — recommend the best language for a given task
fn best_for(task) {
    let t = str_lower(task);

    if str_contains(t, "web") or str_contains(t, "server") or str_contains(t, "api") {
        return map{ recommended: "go", reason: "Go excels at web servers and APIs" };
    }
    if str_contains(t, "ai") or str_contains(t, "ml") or str_contains(t, "machine learning") or str_contains(t, "data science") {
        return map{ recommended: "python", reason: "Python dominates AI/ML with vast ecosystem" };
    }
    if str_contains(t, "system") or str_contains(t, "embedded") or str_contains(t, "kernel") or str_contains(t, "driver") {
        return map{ recommended: "rust", reason: "Rust provides memory safety for systems programming" };
    }
    if str_contains(t, "mobile") or str_contains(t, "android") {
        return map{ recommended: "kotlin", reason: "Kotlin is the preferred language for Android development" };
    }
    if str_contains(t, "ios") or str_contains(t, "apple") or str_contains(t, "macos") {
        return map{ recommended: "swift", reason: "Swift is Apple's recommended language for their platforms" };
    }
    if str_contains(t, "frontend") or str_contains(t, "ui") or str_contains(t, "browser") {
        return map{ recommended: "typescript", reason: "TypeScript adds type safety to frontend development" };
    }
    if str_contains(t, "script") or str_contains(t, "automation") or str_contains(t, "glue") {
        return map{ recommended: "python", reason: "Python excels at scripting and automation" };
    }
    if str_contains(t, "statistic") or str_contains(t, "research") or str_contains(t, "visualization") {
        return map{ recommended: "r", reason: "R is purpose-built for statistical computing" };
    }
    if str_contains(t, "text") or str_contains(t, "regex") or str_contains(t, "parsing") {
        return map{ recommended: "perl", reason: "Perl has first-class regex and text processing" };
    }
    if str_contains(t, "game") {
        return map{ recommended: "cpp", reason: "C++ is the industry standard for game development" };
    }
    if str_contains(t, "cross") or str_contains(t, "compile") {
        return map{ recommended: "zig", reason: "Zig excels at cross-compilation" };
    }
    if str_contains(t, "functional") or str_contains(t, "math") or str_contains(t, "formal") {
        return map{ recommended: "haskell", reason: "Haskell is the gold standard for functional programming" };
    }
    if str_contains(t, "devops") or str_contains(t, "ci") or str_contains(t, "deploy") {
        return map{ recommended: "bash", reason: "Bash is the universal glue for DevOps pipelines" };
    }

    return map{ recommended: "python", reason: "Python is a versatile general-purpose language" };
}

// _ext_for_lang(lang) — file extension for a language
fn _ext_for_lang(lang) {
    let db = _lang_db();
    let entry = db[lang];
    if entry != nil { return entry.ext; }
    return "txt";
}

export run, compile, is_available, detect_all;
export ffi_bridge, json_bridge;
export list_languages, best_for;
export _lang_db, _ext_for_lang, _tmp_path;
