// stdlib/polyglot_registry.sapp — Language Registry for pblang Polyglot System
//
// A registry that knows how to run, compile, and bridge 22+ programming
// languages from within pblang. Auto-detects installed languages and
// provides unified APIs for execution, compilation, and FFI bridging.
//
// Usage:
//   let reg = import("stdlib:polyglot_registry.sapp");
//   let langs = reg.detect_all();
//   reg.run("python", "print('hello')");

// Module-level state for caching
let _registry_which_cache_val = map{};

