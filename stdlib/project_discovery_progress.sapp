// Pure aggregation of caller claims. Slots are not durable root identities.
let Hints=import("stdlib:project_marker_hints.sapp");

fn _empty(ok) {
    return map{format:"pblang.project-discovery-progress.v1",ok:ok,
        error:if ok {""} else {"invalid-input"},
        observation_status:if ok {"caller-claimed"} else {"none"},
        root_count:0,roots:[],
        state_counts:map{completed:0,truncated:0,timeout:0,unavailable:0,excluded:0,error:0},
        source_counts:map{direct:0,index:0},input_count:0,unique_name_count_sum:0,
        recognized_marker_count:0,family_counts:Hints.summarize([]).family_counts,
        metadata_only:true,contains_names:false,contains_paths:false,contains_digests:false,
        content_read:false,execution_performed:false,coverage_verified:false,
        live_existence_verified:false,index_freshness_verified:false,absence_verified:false,
        root_identity_verified:false,idea_admission_eligible:false,implementation_allowed:false,
        training_allowed:false,external_effects_allowed:false,safe_to_log:false,production_ready:false};
}

fn _describe(entries) {
    if type(entries)!="array" or len(entries)>32 { throw "invalid-input"; }
    let supplied=0; let bytes=0;
    // Charge every supplied name before classification/deduplication.
    for entry in entries {
        if type(entry)!="map" or len(entry)!=2 or not map_has(entry,"names")
            or not map_has(entry,"observation") or type(entry.names)!="array"
            or len(entry.names)>256 or len(entry.names)>1024-supplied { throw "invalid-input"; }
        supplied=supplied+len(entry.names);
        for name in entry.names {
            if type(name)!="string" or len(name)==0 or len(name)>255 { throw "invalid-input"; }
            let size=len(str_to_bytes(name));
            if size>255 or size>32768-bytes { throw "invalid-input"; }
            bytes=bytes+size;
        }
    }
    let scans=[]; let invalid=false;
    for entry in entries {
        let scan=Hints.describe_scan(entry.names,entry.observation);
        if not scan.ok { invalid=true; }
        array_push(scans,scan);
    }
    if invalid { throw "invalid-input"; }
    // Do not aggregate until every canonical observation is accepted.
    let result=_empty(true); let slot=0;
    for scan in scans {
        array_push(result.roots,map{slot:slot,scan:scan}); slot=slot+1;
        result.state_counts[scan.state]=result.state_counts[scan.state]+1;
        result.source_counts[scan.source]=result.source_counts[scan.source]+1;
        result.input_count=result.input_count+scan.report.input_count;
        result.unique_name_count_sum=result.unique_name_count_sum+scan.report.unique_name_count;
        result.recognized_marker_count=result.recognized_marker_count+scan.report.recognized_marker_count;
        for family in map_keys(result.family_counts) {
            result.family_counts[family]=result.family_counts[family]+scan.report.family_counts[family];
        }
    }
    result.root_count=slot; return result;
}

fn describe(entries) { return try _describe(entries) catch _empty(false); }
export describe;
