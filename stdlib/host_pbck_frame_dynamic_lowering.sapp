// Canonical whole-program lowering image for PBFP/PBCK-v1.
//
// Unlike the exact-i32 call-graph image, this format retains every dynamic
// constant kind, function signature, instruction, capture and slot required by
// the complete 48-opcode VM. Integrity is bound to a canonical PBFP encoding.

let Binary = import("stdlib:host_pbck_frame_binary.sapp");
let FrameVM = import("stdlib:host_pbck_frame_vm.sapp");
let Plan = import("stdlib:host_pbck_frame_plan.sapp");

let FORMAT = "pblang.host-pbck.frame-lowering-dynamic.v1";
let VERSION = 1;

fn _fault(message) { throw "host_pbck_frame_dynamic_lowering: " + message; }

fn _integer(value) {
    return is_number(value) and value == num_floor(value);
}

fn _copy(values) {
    if not is_array(values) { _fault("array required"); }
    let out = []; let i = 0;
    while i < len(values) { array_push(out, values[i]); i = i + 1; }
    return out;
}

fn _required_array(image, name) {
    if not map_has(image, name) or not is_array(image[name]) {
        _fault("missing array " + name);
    }
    return image[name];
}

fn _canonical_digest(plan) {
    return sha256(base64_encode_bytes(Binary.encode_plan(plan)));
}

fn _function_arrays(plan) {
    let names = []; let arity = []; let min_arity = []; let is_vararg = [];
    let max_local = []; let max_upvalue = []; let instruction_start = [];
    let instruction_count = []; let constant_start = []; let constant_count = [];
    let default_start = []; let default_count = []; let parameter_start = [];
    let parameter_count = []; let i = 0;
    while i < len(plan.functions) {
        let f = plan.functions[i];
        array_push(names, if f.name == nil { "" } else { f.name });
        array_push(arity, f.arity); array_push(min_arity, f.min_arity);
        array_push(is_vararg, f.is_vararg); array_push(max_local, f.max_local);
        array_push(max_upvalue, f.max_upvalue);
        array_push(instruction_start, f.instruction_start);
        array_push(instruction_count, f.instruction_count);
        array_push(constant_start, f.constant_start);
        array_push(constant_count, f.constant_count);
        array_push(default_start, f.default_start);
        array_push(default_count, f.default_count);
        array_push(parameter_start, f.parameter_start);
        array_push(parameter_count, f.parameter_count);
        i = i + 1;
    }
    return map{
        names: names, arity: arity, min_arity: min_arity,
        is_vararg: is_vararg, max_local: max_local, max_upvalue: max_upvalue,
        instruction_start: instruction_start, instruction_count: instruction_count,
        constant_start: constant_start, constant_count: constant_count,
        default_start: default_start, default_count: default_count,
        parameter_start: parameter_start, parameter_count: parameter_count
    };
}

fn _plan(image) {
    let functions = []; let i = 0;
    while i < image.function_count {
        let name = image.function_names[i];
        array_push(functions, map{
            id: i, name: if name == "" { nil } else { name },
            arity: image.function_arity[i], min_arity: image.function_min_arity[i],
            is_vararg: image.function_is_vararg[i],
            max_local: image.function_max_local[i],
            max_upvalue: image.function_max_upvalue[i],
            instruction_start: image.function_instruction_start[i],
            instruction_count: image.function_instruction_count[i],
            constant_start: image.function_constant_start[i],
            constant_count: image.function_constant_count[i],
            default_start: image.function_default_start[i],
            default_count: image.function_default_count[i],
            parameter_start: image.function_parameter_start[i],
            parameter_count: image.function_parameter_count[i]
        });
        i = i + 1;
    }
    return map{
        format: Plan.FORMAT, version: 1, root_function: image.root_function,
        functions: functions, opcodes: _copy(image.opcodes),
        operands: _copy(image.operands),
        instruction_capture_starts: _copy(image.instruction_capture_starts),
        instruction_capture_counts: _copy(image.instruction_capture_counts),
        capture_is_local: _copy(image.capture_is_local),
        capture_indices: _copy(image.capture_indices),
        constant_kinds: _copy(image.constant_kinds),
        constant_numbers: _copy(image.constant_numbers),
        constant_texts: _copy(image.constant_texts),
        constant_functions: _copy(image.constant_functions),
        constant_slots: _copy(image.constant_slots),
        default_slots: _copy(image.default_slots),
        parameter_types: _copy(image.parameter_types),
        max_depth: image.max_depth, artifact_bytes: image.artifact_bytes
    };
}

fn validate(image) {
    if not is_map(image) or not map_has(image, "format") or image.format != FORMAT
        or not map_has(image, "version") or image.version != VERSION {
        _fault("invalid lowering image header");
    }
    let scalar_names = ["root_function", "function_count", "instruction_count",
        "capture_count", "constant_count", "constant_slot_count",
        "default_slot_count", "parameter_count", "max_depth", "artifact_bytes"];
    let i = 0;
    while i < len(scalar_names) {
        let name = scalar_names[i];
        if not map_has(image, name) or not _integer(image[name]) or image[name] < 0 {
            _fault("invalid scalar " + name);
        }
        i = i + 1;
    }
    if image.function_count < 1 or image.root_function < 0
        or image.root_function >= image.function_count {
        _fault("invalid root function");
    }

    let function_arrays = ["function_names", "function_arity", "function_min_arity",
        "function_is_vararg", "function_max_local", "function_max_upvalue",
        "function_instruction_start", "function_instruction_count",
        "function_constant_start", "function_constant_count",
        "function_default_start", "function_default_count",
        "function_parameter_start", "function_parameter_count"];
    i = 0;
    while i < len(function_arrays) {
        if len(_required_array(image, function_arrays[i])) != image.function_count {
            _fault("function table length mismatch");
        }
        i = i + 1;
    }
    let instruction_arrays = ["opcodes", "operands", "instruction_capture_starts",
        "instruction_capture_counts"];
    i = 0;
    while i < len(instruction_arrays) {
        if len(_required_array(image, instruction_arrays[i])) != image.instruction_count {
            _fault("instruction table length mismatch");
        }
        i = i + 1;
    }
    let constant_arrays = ["constant_kinds", "constant_numbers", "constant_texts",
        "constant_functions"];
    i = 0;
    while i < len(constant_arrays) {
        if len(_required_array(image, constant_arrays[i])) != image.constant_count {
            _fault("constant table length mismatch");
        }
        i = i + 1;
    }
    if len(_required_array(image, "capture_is_local")) != image.capture_count
        or len(_required_array(image, "capture_indices")) != image.capture_count
        or len(_required_array(image, "constant_slots")) != image.constant_slot_count
        or len(_required_array(image, "default_slots")) != image.default_slot_count
        or len(_required_array(image, "parameter_types")) != image.parameter_count {
        _fault("lowering table length mismatch");
    }

    i = 0;
    while i < image.function_count {
        if not is_string(image.function_names[i])
            or not is_bool(image.function_is_vararg[i]) {
            _fault("invalid function metadata");
        }
        i = i + 1;
    }
    i = 0;
    while i < image.constant_count {
        if not _integer(image.constant_kinds[i])
            or not is_number(image.constant_numbers[i])
            or not is_string(image.constant_texts[i])
            or not _integer(image.constant_functions[i]) {
            _fault("invalid dynamic constant table");
        }
        i = i + 1;
    }
    i = 0;
    while i < image.capture_count {
        if not is_bool(image.capture_is_local[i])
            or not _integer(image.capture_indices[i]) {
            _fault("invalid capture table");
        }
        i = i + 1;
    }

    let plan = _plan(image);
    if not Plan.validate(plan).ok { _fault("lowering image is not a valid frame plan"); }
    let digest = _canonical_digest(plan);
    if not map_has(image, "sha256") or not is_string(image.sha256)
        or len(image.sha256) != 64 or image.sha256 != digest {
        _fault("lowering integrity mismatch");
    }
    return map{
        ok: true, format: FORMAT, version: VERSION, sha256: digest,
        functions: image.function_count, instructions: image.instruction_count,
        constants: image.constant_count, captures: image.capture_count,
        root_function: image.root_function, max_depth: image.max_depth,
        dynamic_values: true, exceptions: true, canonical_opcodes: 48
    };
}

fn build(plan) {
    if not Plan.validate(plan).ok { _fault("validated frame plan required"); }
    let f = _function_arrays(plan);
    let image = map{
        format: FORMAT, version: VERSION, root_function: plan.root_function,
        function_count: len(plan.functions), instruction_count: len(plan.opcodes),
        capture_count: len(plan.capture_indices),
        constant_count: len(plan.constant_kinds),
        constant_slot_count: len(plan.constant_slots),
        default_slot_count: len(plan.default_slots),
        parameter_count: len(plan.parameter_types), max_depth: plan.max_depth,
        artifact_bytes: plan.artifact_bytes,
        function_names: f.names, function_arity: f.arity,
        function_min_arity: f.min_arity, function_is_vararg: f.is_vararg,
        function_max_local: f.max_local, function_max_upvalue: f.max_upvalue,
        function_instruction_start: f.instruction_start,
        function_instruction_count: f.instruction_count,
        function_constant_start: f.constant_start,
        function_constant_count: f.constant_count,
        function_default_start: f.default_start,
        function_default_count: f.default_count,
        function_parameter_start: f.parameter_start,
        function_parameter_count: f.parameter_count,
        opcodes: _copy(plan.opcodes), operands: _copy(plan.operands),
        instruction_capture_starts: _copy(plan.instruction_capture_starts),
        instruction_capture_counts: _copy(plan.instruction_capture_counts),
        capture_is_local: _copy(plan.capture_is_local),
        capture_indices: _copy(plan.capture_indices),
        constant_kinds: _copy(plan.constant_kinds),
        constant_numbers: _copy(plan.constant_numbers),
        constant_texts: _copy(plan.constant_texts),
        constant_functions: _copy(plan.constant_functions),
        constant_slots: _copy(plan.constant_slots),
        default_slots: _copy(plan.default_slots),
        parameter_types: _copy(plan.parameter_types)
    };
    image.sha256 = _canonical_digest(plan);
    validate(image);
    return freeze(image);
}

fn build_bytes(bytes, options = nil) {
    return build(Binary.decode(bytes, options));
}

fn to_plan(image) {
    validate(image);
    return _plan(image);
}

fn run(image, options = nil, globals = nil) {
    return FrameVM.run(to_plan(image), options, globals);
}

export FORMAT, VERSION, validate, build, build_bytes, to_plan, run;
