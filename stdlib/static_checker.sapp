// stdlib/static_checker.sapp — PBLang v3.0.0 Static Symbol/Arity/Type Checker,
// Zero-Cost Compile-Time 9D SI/Currency Dimensional Type System &
// Tarski-CAD / Cooper-Presburger Proof-Carrying Contract Verifier.
//
// Compatible with PBLang 2.7.0 and 3.0.0 runtimes. Zero external dependencies.

let UCC = import("stdlib:math/universal_concept_cards.sapp");
let DF = import("stdlib:math/decidable_frontier.sapp");
let BUILTINS_MOD = import("stdlib:compiler/builtins_list.sapp");

let STATIC_CHECKER_VERSION = "3.0.0";

// ── String, Character & Collection Helpers ────────────────────────────────────

fn _sc_char_at(s, idx) {
    if s == nil or idx < 0 or idx >= len(s) { return ""; }
    return str_slice(s, idx, idx + 1);
}

fn _sc_is_ws(ch) {
    return ch == " " or ch == "\t" or ch == "\r" or ch == "\n";
}

fn _sc_is_digit(ch) {
    if ch == "" { return false; }
    let code = strcharcodeat(ch, 0);
    return code >= 48 and code <= 57;
}

fn _sc_is_hex(ch) {
    if ch == "" { return false; }
    let code = strcharcodeat(ch, 0);
    return (code >= 48 and code <= 57)
        or (code >= 65 and code <= 70)
        or (code >= 97 and code <= 102);
}

fn _sc_is_ident_start(ch) {
    if ch == "" { return false; }
    if ch == "_" { return true; }
    let code = strcharcodeat(ch, 0);
    if (code >= 65 and code <= 90) or (code >= 97 and code <= 122) { return true; }
    // Allow Unicode Greek/extended letters (code >= 128) except math punctuation
    if code >= 160 { return true; }
    return false;
}

fn _sc_is_ident_cont(ch) {
    return _sc_is_ident_start(ch) or _sc_is_digit(ch);
}

fn _sc_arr_contains(arr, item) {
    let i = 0;
    while i < len(arr) {
        if arr[i] == item { return true; }
        i = i + 1;
    }
    return false;
}

fn _sc_arr_push_unique(arr, item) {
    if not _sc_arr_contains(arr, item) {
        push(arr, item);
    }
}

fn _sc_clone_map(m) {
    let out = map{};
    if m == nil { return out; }
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        out[k] = m[k];
        i = i + 1;
    }
    return out;
}

// ── Levenshtein Edit Distance & Smart Symbol Suggestion ───────────────────────

let _COMMON_IDIOMS = map{
    "to_string": "str",
    "tostring": "str",
    "toString": "str",
    "typeof": "type",
    "type_of": "type",
    "length": "len",
    "size": "len",
    "substr": "str_slice",
    "substring": "str_slice",
    "indexOf": "str_index_of",
    "contains": "str_contains",
    "startsWith": "str_starts_with",
    "endsWith": "str_ends_with",
    "replace": "str_replace_all",
    "split": "str_split",
    "trim": "str_trim",
    "upper": "str_upper",
    "lower": "str_lower",
    "append": "push",
    "push_back": "push",
    "parseInt": "parse_number",
    "parse_int": "parse_number",
    "parseFloat": "parse_number",
    "parse_float": "parse_number",
    "readFile": "fs_read",
    "read_file": "fs_read",
    "writeFile": "fs_write",
    "write_file": "fs_write",
    "jsonEncode": "json_stringify",
    "json_encode": "json_stringify",
    "jsonDecode": "json_parse",
    "json_decode": "json_parse"
};

fn levenshtein_distance(a, b) {
    if a == b { return 0; }
    let la = len(a);
    let lb = len(b);
    if la == 0 { return lb; }
    if lb == 0 { return la; }
    if la > 96 or lb > 96 { return 99; }

    let prev = [];
    let j = 0;
    while j <= lb {
        push(prev, j);
        j = j + 1;
    }
    let i = 1;
    while i <= la {
        let cur = [i];
        let ca = _sc_char_at(a, i - 1);
        j = 1;
        while j <= lb {
            let cb = _sc_char_at(b, j - 1);
            let cost = if ca == cb { 0 } else { 1 };
            let del_c = prev[j] + 1;
            let ins_c = cur[j - 1] + 1;
            let sub_c = prev[j - 1] + cost;
            let best = del_c;
            if ins_c < best { best = ins_c; }
            if sub_c < best { best = sub_c; }
            push(cur, best);
            j = j + 1;
        }
        prev = cur;
        i = i + 1;
    }
    return prev[lb];
}

fn suggest_symbol(name, candidates) {
    if name == nil or name == "" { return nil; }
    if map_has(_COMMON_IDIOMS, name) {
        let target = _COMMON_IDIOMS[name];
        if _sc_arr_contains(candidates, target) {
            return target;
        }
    }
    let lower_nm = str_lower(name);
    let max_dist = 2;
    if len(name) >= 5 { max_dist = 3; }
    if len(name) <= 2 { max_dist = 1; }

    let best = nil;
    let best_d = max_dist + 1;
    let i = 0;
    while i < len(candidates) {
        let cand = candidates[i];
        if cand != name and cand != "" {
            if str_lower(cand) == lower_nm {
                return cand;
            }
            if num_abs(len(cand) - len(name)) <= max_dist {
                let d = levenshtein_distance(name, cand);
                if d > 0 and d <= max_dist {
                    if best == nil or d < best_d or (d == best_d and cand < best) {
                        best = cand;
                        best_d = d;
                    }
                }
            }
        }
        i = i + 1;
    }
    return best;
}

// ── Type & 9D SI + Currency Representation ────────────────────────────────────

let _ISO_CURRENCIES = map{
    "EUR": true, "€": true,
    "USD": true, "$": true,
    "GBP": true, "CHF": true, "JPY": true, "CAD": true, "AUD": true,
    "SEK": true, "NOK": true, "DKK": true, "PLN": true, "CNY": true
};

fn _canon_ccy_code(sym) {
    if sym == "€" or sym == "EUR_cent" or sym == "kEUR" or sym == "MEUR" { return "EUR"; }
    if sym == "$" or sym == "USD_cent" or sym == "kUSD" or sym == "MUSD" { return "USD"; }
    if map_has(_ISO_CURRENCIES, sym) { return sym; }
    return nil;
}

fn _ccy_clean(cm) {
    let out = map{};
    if cm == nil { return out; }
    let ks = array_sort(map_keys(cm));
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        let r = cm[k];
        if r != nil and r[0] != 0 {
            out[k] = UCC.rat_make(r[0], r[1]);
        }
        i = i + 1;
    }
    return out;
}

fn _ccy_is_empty(cm) {
    if cm == nil { return true; }
    return len(map_keys(_ccy_clean(cm))) == 0;
}

fn _ccy_mul(a, b) {
    let out = _sc_clone_map(a);
    if b != nil {
        let ks = map_keys(b);
        let i = 0;
        while i < len(ks) {
            let k = ks[i];
            let cur = if map_has(out, k) { out[k] } else { [0, 1] };
            out[k] = UCC.rat_add(cur, b[k]);
            i = i + 1;
        }
    }
    return _ccy_clean(out);
}

fn _ccy_div(a, b) {
    let out = _sc_clone_map(a);
    if b != nil {
        let ks = map_keys(b);
        let i = 0;
        while i < len(ks) {
            let k = ks[i];
            let cur = if map_has(out, k) { out[k] } else { [0, 1] };
            out[k] = UCC.rat_sub(cur, b[k]);
            i = i + 1;
        }
    }
    return _ccy_clean(out);
}

fn _ccy_pow(a, p, q) {
    let out = map{};
    if a == nil { return out; }
    let factor = UCC.rat_make(p, q);
    let ks = map_keys(a);
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        out[k] = UCC.rat_mul(a[k], factor);
        i = i + 1;
    }
    return _ccy_clean(out);
}

fn _ccy_eq(a, b) {
    let ca = _ccy_clean(a);
    let cb = _ccy_clean(b);
    let ka = array_sort(map_keys(ca));
    let kb = array_sort(map_keys(cb));
    if len(ka) != len(kb) { return false; }
    let i = 0;
    while i < len(ka) {
        if ka[i] != kb[i] { return false; }
        if not UCC.rat_eq(ca[ka[i]], cb[kb[i]]) { return false; }
        i = i + 1;
    }
    return true;
}

fn _ccy_to_unit_str(cm) {
    let c = _ccy_clean(cm);
    let ks = array_sort(map_keys(c));
    if len(ks) == 0 { return ""; }
    let num_p = [];
    let den_p = [];
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        let r = c[k];
        if r[0] > 0 {
            if r[0] == 1 and r[1] == 1 { push(num_p, k); }
            else { push(num_p, k + "^" + UCC.rat_to_ascii(r)); }
        } elif r[0] < 0 {
            let pr = [0 - r[0], r[1]];
            if pr[0] == 1 and pr[1] == 1 { push(den_p, k); }
            else { push(den_p, k + "^" + UCC.rat_to_ascii(pr)); }
        }
        i = i + 1;
    }
    let ns = if len(num_p) == 0 { "1" } else { str_join(num_p, "*") };
    if len(den_p) == 0 { return ns; }
    if len(den_p) == 1 { return ns + "/" + den_p[0]; }
    return ns + "/(" + str_join(den_p, "*") + ")";
}

// Extract currency exponents while normalizing foreign ISO currencies to EUR for UCC's 9D SI parser
fn _extract_ccy_and_ucc_unit(unit_raw) {
    let s = str_trim(unit_raw);
    if s == "" or s == "1" or s == "dimensionless" {
        let pu0 = UCC.parse_unit("1");
        return map{ ok: true, unit_str: "1", dim: pu0["dim"], ccy: map{}, pu: pu0, error: nil };
    }

    // Scan unit tokens to record explicit currency symbols (EUR, USD, GBP, CHF, ...)
    let ccy = map{};
    let rewritten = "";
    let n = len(s);
    let i = 0;
    let cur_sign = 1; // +1 numerator, -1 after '/'
    let group_stack = [];

    while i < n {
        let ch = _sc_char_at(s, i);
        if ch == "(" {
            push(group_stack, cur_sign);
            rewritten = rewritten + ch;
            i = i + 1;
        } elif ch == ")" {
            if len(group_stack) > 0 {
                cur_sign = pop(group_stack);
            } else {
                cur_sign = 1;
            }
            rewritten = rewritten + ch;
            i = i + 1;
        } elif ch == "/" {
            let base_sg = if len(group_stack) > 0 { group_stack[len(group_stack) - 1] } else { 1 };
            cur_sign = 0 - base_sg;
            rewritten = rewritten + ch;
            i = i + 1;
        } elif ch == "*" {
            let base_sg2 = if len(group_stack) > 0 { group_stack[len(group_stack) - 1] } else { 1 };
            cur_sign = base_sg2;
            rewritten = rewritten + ch;
            i = i + 1;
        } elif _sc_is_ident_start(ch) or ch == "€" or ch == "$" {
            let j = i + 1;
            if ch != "€" and ch != "$" {
                while j < n and _sc_is_ident_cont(_sc_char_at(s, j)) {
                    j = j + 1;
                }
            }
            let sym = str_slice(s, i, j);
            // Check optional ^exp after symbol
            let k = j;
            while k < n and (_sc_char_at(s, k) == " " or _sc_char_at(s, k) == "\t") { k = k + 1; }
            let exp_num = 1;
            if k < n and _sc_char_at(s, k) == "^" {
                let m = k + 1;
                let esg = 1;
                if m < n and _sc_char_at(s, m) == "-" { esg = -1; m = m + 1; }
                elif m < n and _sc_char_at(s, m) == "+" { m = m + 1; }
                let d_start = m;
                while m < n and _sc_is_digit(_sc_char_at(s, m)) { m = m + 1; }
                if m > d_start {
                    exp_num = num_floor(parse_number(str_slice(s, d_start, m))) * esg;
                }
            }
            let cc = _canon_ccy_code(sym);
            if cc != nil {
                let prev_r = if map_has(ccy, cc) { ccy[cc] } else { [0, 1] };
                ccy[cc] = UCC.rat_add(prev_r, [cur_sign * exp_num, 1]);
                rewritten = rewritten + "EUR";
            } else {
                rewritten = rewritten + sym;
            }
            i = j;
        } else {
            rewritten = rewritten + ch;
            i = i + 1;
        }
    }

    let pu = UCC.parse_unit(rewritten);
    if not pu["ok"] {
        return map{ ok: false, unit_str: s, dim: UCC.dim_zero(), ccy: map{}, pu: pu, error: pu["error"] };
    }
    return map{
        ok: true,
        unit_str: s,
        dim: pu["dim"],
        ccy: _ccy_clean(ccy),
        pu: pu,
        error: nil
    };
}

fn _dim_unicode_rich(dim, ccy) {
    if dim == nil { return "[invalid]"; }
    let cc = _ccy_clean(ccy);
    if UCC.dim_is_dimensionless(dim) and _ccy_is_empty(cc) {
        return "[1]";
    }
    // Check single base dimension with exponent 1 -> show explicit superscript ¹ alongside canonical
    let non_zero_cnt = 0;
    let single_sym = "";
    let i = 0;
    let syms = ["L", "M", "T", "I", "Θ", "N", "J", "EUR", "BIT"];
    while i < 9 {
        if dim[i][0] != 0 {
            non_zero_cnt = non_zero_cnt + 1;
            if dim[i][0] == 1 and dim[i][1] == 1 {
                single_sym = syms[i];
            }
        }
        i = i + 1;
    }
    if not _ccy_is_empty(cc) and UCC.dim_is_dimensionless(dim) {
        return "[" + _ccy_to_unit_str(cc) + "]";
    }
    if non_zero_cnt == 1 and single_sym != "" {
        if single_sym == "EUR" and not _ccy_is_empty(cc) {
            return "[" + _ccy_to_unit_str(cc) + "¹]";
        }
        return "[" + single_sym + "¹]";
    }
    let u_str = UCC.dim_to_unicode(dim);
    if not _ccy_is_empty(cc) {
        let cu = _ccy_to_unit_str(cc);
        if cu != "EUR" {
            u_str = str_replace_all(u_str, "EUR", cu);
        }
    }
    return u_str;
}

fn _canonical_unit_label(dim, ccy) {
    let cc = _ccy_clean(ccy);
    if UCC.dim_is_dimensionless(dim) {
        if _ccy_is_empty(cc) { return "1"; }
        return _ccy_to_unit_str(cc);
    }
    let base_u = UCC.dim_canonical_si_unit(dim);
    if not _ccy_is_empty(cc) {
        let cu = _ccy_to_unit_str(cc);
        if cu != "" and cu != "EUR" {
            base_u = str_replace_all(base_u, "EUR", cu);
        }
    }
    return base_u;
}

fn _make_type(base_name) {
    return map{
        base: base_name,
        has_unit: false,
        is_zero_lit: false,
        const_val: nil,
        unit_str: "",
        dim: UCC.dim_zero(),
        ccy: map{},
        elem_type: nil,
        ok_type: nil,
        err_type: nil,
        params: nil,
        ret_type: nil,
        type_name: "",
        is_quantum_circuit: false,
        quantum_n_qubits: nil
    };
}

fn _make_unit_type(base_num, dim, ccy, preferred_unit_str = "") {
    let clean_c = _ccy_clean(ccy);
    let canon = _canonical_unit_label(dim, clean_c);
    let u_label = if preferred_unit_str != "" { preferred_unit_str } else { canon };
    let is_dimless = UCC.dim_is_dimensionless(dim) and _ccy_is_empty(clean_c);
    let t = _make_type(base_num);
    t["has_unit"] = not is_dimless;
    t["unit_str"] = if is_dimless { "" } else { u_label };
    t["dim"] = dim;
    t["ccy"] = clean_c;
    return t;
}

fn _type_to_str(t) {
    if t == nil { return "any"; }
    let b = t["base"];
    if (b == "num" or b == "int") and t["has_unit"] {
        let u = _canonical_unit_label(t["dim"], t["ccy"]);
        return b + "[" + u + "]";
    }
    if b == "Option" {
        let inner = if t["elem_type"] != nil { _type_to_str(t["elem_type"]) } else { "any" };
        return "Option<" + inner + ">";
    }
    if b == "Result" {
        let ok_s = if t["ok_type"] != nil { _type_to_str(t["ok_type"]) } else { "any" };
        let err_s = if t["err_type"] != nil { _type_to_str(t["err_type"]) } else { "string" };
        return "Result<" + ok_s + ", " + err_s + ">";
    }
    if b == "fn" {
        let ps = [];
        if t["params"] != nil {
            let i = 0;
            while i < len(t["params"]) {
                push(ps, _type_to_str(t["params"][i]));
                i = i + 1;
            }
        }
        let rs = if t["ret_type"] != nil { _type_to_str(t["ret_type"]) } else { "any" };
        return "fn(" + str_join(ps, ", ") + ") -> " + rs;
    }
    if (b == "enum" or b == "struct" or b == "class") and t["type_name"] != "" {
        return t["type_name"];
    }
    return b;
}

fn _is_numeric_type(t) {
    if t == nil { return false; }
    return t["base"] == "num" or t["base"] == "int";
}

fn _units_compatible(t1, t2) {
    let d1 = if t1 != nil and t1["dim"] != nil { t1["dim"] } else { UCC.dim_zero() };
    let d2 = if t2 != nil and t2["dim"] != nil { t2["dim"] } else { UCC.dim_zero() };
    let c1 = if t1 != nil { t1["ccy"] } else { map{} };
    let c2 = if t2 != nil { t2["ccy"] } else { map{} };
    return UCC.dim_eq(d1, d2) and _ccy_eq(c1, c2);
}

// ── Lexer (`tokenize_sapp`) ───────────────────────────────────────────────────

let _KEYWORDS = map{
    "let": true, "const": true, "fn": true, "async": true, "await": true,
    "return": true, "if": true, "elif": true, "else": true,
    "while": true, "loop": true, "for": true, "in": true, "to": true,
    "break": true, "continue": true, "match": true, "switch": true, "case": true, "default": true,
    "try": true, "catch": true, "throw": true, "defer": true,
    "struct": true, "class": true, "extends": true, "interface": true, "enum": true,
    "import": true, "export": true, "map": true, "print": true,
    "and": true, "or": true, "not": true, "true": true, "false": true, "nil": true,
    "requires": true, "ensures": true, "comptime": true, "pub": true
};

fn tokenize_sapp(src_code) {
    let src = if src_code == nil { "" } else { str(src_code) };
    let n = len(src);
    let toks = [];
    let lex_errors = [];
    let i = 0;
    let line = 1;
    let col = 1;
    let pending_docs = [];

    // Strip line-1 shebang
    if n >= 2 and str_slice(src, 0, 2) == "#!" {
        while i < n and _sc_char_at(src, i) != "\n" {
            i = i + 1;
            col = col + 1;
        }
    }

    while i < n {
        let ch = _sc_char_at(src, i);
        let nx = _sc_char_at(src, i + 1);

        if ch == "\n" {
            line = line + 1;
            col = 1;
            i = i + 1;
            continue;
        }
        if ch == " " or ch == "\t" or ch == "\r" {
            if ch != "\r" { col = col + 1; }
            i = i + 1;
            continue;
        }

        // Line comments (including /// and //! doc comments)
        if ch == "/" and nx == "/" {
            let c_start = i;
            let c_line = line;
            while i < n and _sc_char_at(src, i) != "\n" {
                i = i + 1;
            }
            let raw_c = str_slice(src, c_start, i);
            if str_starts_with(raw_c, "///") or str_starts_with(raw_c, "//!") {
                push(pending_docs, map{ line: c_line, text: str_trim(str_slice(raw_c, 3, len(raw_c))), is_triple: true });
            } else {
                push(pending_docs, map{ line: c_line, text: str_trim(str_slice(raw_c, 2, len(raw_c))), is_triple: false });
            }
            continue;
        }

        // Nested block comments /* ... */
        if ch == "/" and nx == "*" {
            let bdepth = 1;
            i = i + 2;
            col = col + 2;
            while i < n and bdepth > 0 {
                let bc = _sc_char_at(src, i);
                let bn = _sc_char_at(src, i + 1);
                if bc == "\n" {
                    line = line + 1;
                    col = 1;
                    i = i + 1;
                } elif bc == "/" and bn == "*" {
                    bdepth = bdepth + 1;
                    i = i + 2;
                    col = col + 2;
                } elif bc == "*" and bn == "/" {
                    bdepth = bdepth - 1;
                    i = i + 2;
                    col = col + 2;
                } else {
                    i = i + 1;
                    col = col + 1;
                }
            }
            continue;
        }

        let t_line = line;
        let t_col = col;

        // @lang polyglot blocks: @python(...) { ... }
        if ch == "@" and _sc_is_ident_start(nx) {
            let j = i + 1;
            while j < n and _sc_is_ident_cont(_sc_char_at(src, j)) { j = j + 1; }
            col = col + (j - i);
            i = j;
            while i < n and _sc_is_ws(_sc_char_at(src, i)) {
                if _sc_char_at(src, i) == "\n" { line = line + 1; col = 1; } else { col = col + 1; }
                i = i + 1;
            }
            if _sc_char_at(src, i) == "(" {
                let pdepth = 1;
                i = i + 1; col = col + 1;
                while i < n and pdepth > 0 {
                    let pc = _sc_char_at(src, i);
                    if pc == "\n" { line = line + 1; col = 1; }
                    else {
                        col = col + 1;
                        if pc == "(" { pdepth = pdepth + 1; }
                        elif pc == ")" { pdepth = pdepth - 1; }
                    }
                    i = i + 1;
                }
            }
            while i < n and _sc_is_ws(_sc_char_at(src, i)) {
                if _sc_char_at(src, i) == "\n" { line = line + 1; col = 1; } else { col = col + 1; }
                i = i + 1;
            }
            if _sc_char_at(src, i) == "{" {
                let cdepth = 1;
                i = i + 1; col = col + 1;
                while i < n and cdepth > 0 {
                    let cc = _sc_char_at(src, i);
                    if cc == "\n" { line = line + 1; col = 1; }
                    else {
                        col = col + 1;
                        if cc == "{" { cdepth = cdepth + 1; }
                        elif cc == "}" { cdepth = cdepth - 1; }
                    }
                    i = i + 1;
                }
            }
            push(toks, map{ kind: "POLYGLOT", val: "@polyglot", line: t_line, col: t_col, end_col: col, doc: "" });
            pending_docs = [];
            continue;
        }

        // String literals (including f"..." interpolated strings)
        if ch == "\"" or ch == "'" or (ch == "f" and (nx == "\"" or nx == "'")) {
            let is_f = ch == "f";
            let q = if is_f { nx } else { ch };
            i = i + (if is_f { 2 } else { 1 });
            col = col + (if is_f { 2 } else { 1 });
            let buf = "";
            let interp_exprs = [];
            while i < n {
                let sc = _sc_char_at(src, i);
                if sc == "\\" and i + 1 < n {
                    let esc = _sc_char_at(src, i + 1);
                    buf = buf + esc;
                    if esc == "\n" { line = line + 1; col = 1; } else { col = col + 2; }
                    i = i + 2;
                    continue;
                }
                if is_f and sc == "{" {
                    let expr_line = line;
                    let expr_col = col + 1;
                    i = i + 1;
                    col = col + 1;
                    let edepth = 1;
                    let ebuf = "";
                    while i < n and edepth > 0 {
                        let ec = _sc_char_at(src, i);
                        if ec == "{" { edepth = edepth + 1; ebuf = ebuf + ec; col = col + 1; i = i + 1; }
                        elif ec == "}" {
                            edepth = edepth - 1;
                            if edepth > 0 { ebuf = ebuf + ec; }
                            col = col + 1;
                            i = i + 1;
                        } else {
                            if ec == "\n" { line = line + 1; col = 1; } else { col = col + 1; }
                            ebuf = ebuf + ec;
                            i = i + 1;
                        }
                    }
                    push(interp_exprs, map{ code: ebuf, line: expr_line, col: expr_col });
                    continue;
                }
                if sc == q {
                    i = i + 1;
                    col = col + 1;
                    break;
                }
                if sc == "\n" { line = line + 1; col = 1; } else { col = col + 1; }
                buf = buf + sc;
                i = i + 1;
            }
            push(toks, map{
                kind: if is_f { "FSTR" } else { "STR" },
                val: buf,
                interps: interp_exprs,
                line: t_line,
                col: t_col,
                end_col: col,
                doc: ""
            });
            pending_docs = [];
            continue;
        }

        // Numbers (dec, hex, bin, oct, scientific)
        if _sc_is_digit(ch) {
            let j = i;
            if ch == "0" and (nx == "x" or nx == "X") {
                j = j + 2;
                while j < n and (_sc_is_hex(_sc_char_at(src, j)) or _sc_char_at(src, j) == "_") { j = j + 1; }
            } elif ch == "0" and (nx == "b" or nx == "B" or nx == "o" or nx == "O") {
                j = j + 2;
                while j < n and (_sc_is_digit(_sc_char_at(src, j)) or _sc_char_at(src, j) == "_") { j = j + 1; }
            } else {
                while j < n and (_sc_is_digit(_sc_char_at(src, j)) or _sc_char_at(src, j) == "_") { j = j + 1; }
                if j < n and _sc_char_at(src, j) == "." and _sc_char_at(src, j + 1) != "." and _sc_is_digit(_sc_char_at(src, j + 1)) {
                    j = j + 1;
                    while j < n and (_sc_is_digit(_sc_char_at(src, j)) or _sc_char_at(src, j) == "_") { j = j + 1; }
                }
                if j < n and (_sc_char_at(src, j) == "e" or _sc_char_at(src, j) == "E") {
                    let ej = j + 1;
                    if _sc_char_at(src, ej) == "+" or _sc_char_at(src, ej) == "-" { ej = ej + 1; }
                    if _sc_is_digit(_sc_char_at(src, ej)) {
                        j = ej;
                        while j < n and (_sc_is_digit(_sc_char_at(src, j)) or _sc_char_at(src, j) == "_") { j = j + 1; }
                    }
                }
            }
            let raw_num = str_replace_all(str_slice(src, i, j), "_", "");
            col = col + (j - i);
            i = j;
            push(toks, map{ kind: "NUM", val: raw_num, line: t_line, col: t_col, end_col: col, doc: "" });
            pending_docs = [];
            continue;
        }

        // Identifiers & Keywords (with attached doc comments!)
        if _sc_is_ident_start(ch) or ch == "€" or ch == "$" {
            let j = i + 1;
            if ch != "€" and ch != "$" {
                while j < n and _sc_is_ident_cont(_sc_char_at(src, j)) { j = j + 1; }
            }
            let word = str_slice(src, i, j);
            col = col + (j - i);
            i = j;

            // Attach contiguous preceding doc comments
            let doc_txt = "";
            if len(pending_docs) > 0 {
                let last_doc_line = pending_docs[len(pending_docs) - 1]["line"];
                if t_line - last_doc_line <= 2 {
                    let dparts = [];
                    let di = 0;
                    while di < len(pending_docs) {
                        if pending_docs[di]["text"] != "" {
                            push(dparts, pending_docs[di]["text"]);
                        }
                        di = di + 1;
                    }
                    doc_txt = str_join(dparts, "\n");
                }
            }
            let tk_kind = if map_has(_KEYWORDS, word) { "KW" } else { "ID" };
            push(toks, map{ kind: tk_kind, val: word, line: t_line, col: t_col, end_col: col, doc: doc_txt });
            if word != "pub" and word != "export" and word != "async" {
                pending_docs = [];
            }
            continue;
        }

        // 3-char operators
        let c3 = if i + 3 <= n { str_slice(src, i, i + 3) } else { "" };
        if c3 == "..." or c3 == "**=" {
            push(toks, map{ kind: "OP", val: c3, line: t_line, col: t_col, end_col: t_col + 3, doc: "" });
            i = i + 3;
            col = col + 3;
            pending_docs = [];
            continue;
        }

        // 2-char operators
        let c2 = if i + 2 <= n { str_slice(src, i, i + 2) } else { "" };
        if c2 == "==" or c2 == "!=" or c2 == "<=" or c2 == ">=" or c2 == "->" or c2 == "=>"
           or c2 == "+=" or c2 == "-=" or c2 == "*=" or c2 == "/=" or c2 == "%=" or c2 == "**"
           or c2 == ".." or c2 == "?." or c2 == "?[" or c2 == "??" or c2 == "|>" or c2 == "<<"
           or c2 == ">>" or c2 == "&&" or c2 == "||" or c2 == "::" {
            push(toks, map{ kind: "OP", val: c2, line: t_line, col: t_col, end_col: t_col + 2, doc: "" });
            i = i + 2;
            col = col + 2;
            pending_docs = [];
            continue;
        }

        // 1-char punctuation & operators
        if str_index_of("()[]{},;:.+-*/%^~&|<>=!?", ch) >= 0 {
            let pk = if str_index_of("()[]{},;:.", ch) >= 0 { "PUNC" } else { "OP" };
            push(toks, map{ kind: pk, val: ch, line: t_line, col: t_col, end_col: t_col + 1, doc: "" });
            i = i + 1;
            col = col + 1;
            pending_docs = [];
            continue;
        }

        push(lex_errors, map{ line: t_line, col: t_col, message: "Unexpected character '" + ch + "'" });
        i = i + 1;
        col = col + 1;
    }

    push(toks, map{ kind: "EOF", val: "", line: line, col: col, end_col: col, doc: "" });
    return map{ tokens: toks, errors: lex_errors };
}

// ── Recursive-Descent AST Parser (`parse_sapp_ast`) ──────────────────────────

fn _p_cur(st) {
    let pos = st["pos"];
    let toks = st["tokens"];
    if pos >= len(toks) { return toks[len(toks) - 1]; }
    return toks[pos];
}

fn _p_peek(st, offset) {
    let idx = st["pos"] + offset;
    let toks = st["tokens"];
    if idx < 0 or idx >= len(toks) { return toks[len(toks) - 1]; }
    return toks[idx];
}

fn _p_adv(st) {
    let t = _p_cur(st);
    if t["kind"] != "EOF" {
        st["pos"] = st["pos"] + 1;
    }
    return t;
}

fn _p_is(st, kind, val) {
    let t = _p_cur(st);
    return t["kind"] == kind and (val == nil or t["val"] == val);
}

fn _p_eat(st, kind, val) {
    if _p_is(st, kind, val) {
        _p_adv(st);
        return true;
    }
    return false;
}

fn _p_err(st, msg, tok) {
    let tk = if tok != nil { tok } else { _p_cur(st) };
    push(st["errors"], map{
        severity: "error",
        code: "SYNTAX_ERROR",
        message: msg,
        message_el: "Συντακτικό σφάλμα: " + msg,
        line: tk["line"],
        col: tk["col"],
        end_line: tk["line"],
        end_col: tk["end_col"],
        suggestion: nil
    });
}

fn _p_expect(st, kind, val, desc) {
    if _p_is(st, kind, val) {
        return _p_adv(st);
    }
    let cur = _p_cur(st);
    _p_err(st, "Expected " + desc + ", got '" + cur["val"] + "'", cur);
    return cur;
}

// Reconstruct unit string inside `[...]` of `: num[m/s]`
fn _parse_unit_brackets(st) {
    let open_t = _p_expect(st, "PUNC", "[", "'['");
    let parts = [];
    let depth = 1;
    while not _p_is(st, "EOF", nil) and depth > 0 {
        let t = _p_adv(st);
        if t["kind"] == "PUNC" and t["val"] == "[" {
            depth = depth + 1;
            push(parts, "[");
        } elif t["kind"] == "PUNC" and t["val"] == "]" {
            depth = depth - 1;
            if depth > 0 { push(parts, "]"); }
        } else {
            push(parts, t["val"]);
        }
    }
    return map{ unit_raw: str_join(parts, ""), line: open_t["line"], col: open_t["col"] };
}

fn _parse_type_annot(st) {
    let t = _p_cur(st);
    if t["kind"] == "KW" and t["val"] == "fn" {
        _p_adv(st);
        let ptypes = [];
        if _p_eat(st, "PUNC", "(") {
            while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", ")") {
                // Allow optional `name: Type` or just `Type`
                if (_p_cur(st)["kind"] == "ID" or _p_cur(st)["kind"] == "KW") and _p_peek(st, 1)["val"] == ":" {
                    _p_adv(st);
                    _p_adv(st);
                }
                push(ptypes, _parse_type_annot(st));
                if not _p_eat(st, "PUNC", ",") { break; }
            }
            _p_expect(st, "PUNC", ")", "')'");
        }
        let rtype = map{ raw: "any", unit_raw: "", params: nil, ret: nil, args: [], line: t["line"], col: t["col"] };
        if _p_eat(st, "OP", "->") {
            rtype = _parse_type_annot(st);
        }
        return map{ raw: "fn", unit_raw: "", params: ptypes, ret: rtype, args: [], line: t["line"], col: t["col"] };
    }

    if t["kind"] == "ID" or t["kind"] == "KW" {
        let base_t = _p_adv(st);
        let bname = base_t["val"];
        let unit_raw = "";
        let unit_loc = nil;
        let gen_args = [];

        if _p_is(st, "PUNC", "[") {
            let ub = _parse_unit_brackets(st);
            unit_raw = ub["unit_raw"];
            unit_loc = ub;
        } elif _p_is(st, "OP", "<") {
            _p_adv(st);
            while not _p_is(st, "EOF", nil) and not _p_is(st, "OP", ">") {
                push(gen_args, _parse_type_annot(st));
                if not _p_eat(st, "PUNC", ",") { break; }
            }
            _p_eat(st, "OP", ">");
        }
        return map{
            raw: bname,
            unit_raw: unit_raw,
            unit_loc: unit_loc,
            params: nil,
            ret: nil,
            args: gen_args,
            line: base_t["line"],
            col: base_t["col"]
        };
    }

    _p_err(st, "Expected type annotation", t);
    return map{ raw: "any", unit_raw: "", params: nil, ret: nil, args: [], line: t["line"], col: t["col"] };
}

fn _parse_ident_like(st, desc) {
    let t = _p_cur(st);
    if t["kind"] == "ID" or t["kind"] == "KW" {
        return _p_adv(st);
    }
    return _p_expect(st, "ID", nil, desc);
}

// Forward declarations via mutual functions in PBLang (top-level fns are hoisted!)

fn _parse_primary(st) {
    let t = _p_cur(st);

    if t["kind"] == "NUM" {
        _p_adv(st);
        return map{ kind: "num", val: t["val"], line: t["line"], col: t["col"], end_col: t["end_col"] };
    }
    if t["kind"] == "STR" or t["kind"] == "FSTR" {
        _p_adv(st);
        let sub_asts = [];
        if t["kind"] == "FSTR" and t["interps"] != nil {
            let ii = 0;
            while ii < len(t["interps"]) {
                let ip = t["interps"][ii];
                let sub_p = parse_sapp_ast(ip["code"] + ";");
                push(sub_asts, sub_p["ast"]);
                ii = ii + 1;
            }
        }
        return map{ kind: "str", val: t["val"], is_fstr: t["kind"] == "FSTR", interps: sub_asts, line: t["line"], col: t["col"], end_col: t["end_col"] };
    }
    if t["kind"] == "POLYGLOT" {
        _p_adv(st);
        return map{ kind: "polyglot", line: t["line"], col: t["col"], end_col: t["end_col"] };
    }
    if t["kind"] == "KW" {
        let kv = t["val"];
        if kv == "true" or kv == "false" {
            _p_adv(st);
            return map{ kind: "bool", val: kv == "true", line: t["line"], col: t["col"], end_col: t["end_col"] };
        }
        if kv == "nil" {
            _p_adv(st);
            return map{ kind: "nil", line: t["line"], col: t["col"], end_col: t["end_col"] };
        }
        if kv == "import" {
            _p_adv(st);
            _p_expect(st, "PUNC", "(", "'(' after import");
            let arg_e = _parse_expr(st);
            _p_expect(st, "PUNC", ")", "')' after import path");
            return map{ kind: "import_expr", arg: arg_e, line: t["line"], col: t["col"], end_col: _p_cur(st)["col"] };
        }
        if kv == "comptime" {
            _p_adv(st);
            if _p_eat(st, "PUNC", "(") {
                let ce = _parse_expr(st);
                _p_expect(st, "PUNC", ")", "')' after comptime");
                return map{ kind: "comptime_expr", expr: ce, block: nil, line: t["line"], col: t["col"] };
            }
            let cb = _parse_block(st);
            return map{ kind: "comptime_expr", expr: nil, block: cb, line: t["line"], col: t["col"] };
        }
        if kv == "map" and _p_peek(st, 1)["val"] == "{" {
            _p_adv(st);
            _p_adv(st);
            let entries = [];
            while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", "}") {
                let kt = _p_cur(st);
                let key_expr = nil;
                if (kt["kind"] == "ID" or kt["kind"] == "KW" or kt["kind"] == "STR") and _p_peek(st, 1)["val"] == ":" {
                    _p_adv(st);
                    _p_adv(st);
                    key_expr = map{ kind: "str", val: kt["val"], is_fstr: false, interps: [], line: kt["line"], col: kt["col"], end_col: kt["end_col"] };
                } elif _p_eat(st, "PUNC", "[") {
                    key_expr = _parse_expr(st);
                    _p_expect(st, "PUNC", "]", "']'");
                    _p_expect(st, "PUNC", ":", "':'");
                } else {
                    key_expr = _parse_expr(st);
                    _p_expect(st, "PUNC", ":", "':' in map literal");
                }
                let val_expr = _parse_expr(st);
                push(entries, map{ key: key_expr, val: val_expr });
                if not _p_eat(st, "PUNC", ",") { break; }
            }
            _p_expect(st, "PUNC", "}", "'}'");
            return map{ kind: "map_lit", entries: entries, line: t["line"], col: t["col"] };
        }
        if kv == "fn" or (kv == "async" and _p_peek(st, 1)["val"] == "fn") {
            let is_as = false;
            if kv == "async" { _p_adv(st); is_as = true; }
            return _parse_fn_expr_or_decl(st, false, is_as, "");
        }
        if kv == "if" {
            return _parse_if_expr(st);
        }
        if kv == "match" {
            return _parse_match_node(st);
        }
        if kv == "try" {
            _p_adv(st);
            if _p_is(st, "PUNC", "{") {
                let tb = _parse_block(st);
                let cname = "";
                let cb = nil;
                if _p_eat(st, "KW", "catch") {
                    if _p_cur(st)["kind"] == "ID" and _p_peek(st, 1)["val"] == "{" {
                        cname = _p_adv(st)["val"];
                    }
                    cb = _parse_block(st);
                }
                return map{ kind: "try_block_expr", try_block: tb, catch_var: cname, catch_block: cb, line: t["line"], col: t["col"] };
            }
            let te = _parse_expr(st);
            let fe = nil;
            let cv = "";
            if _p_eat(st, "KW", "catch") {
                fe = _parse_expr(st);
            }
            return map{ kind: "try_expr", expr: te, catch_var: cv, fallback: fe, line: t["line"], col: t["col"] };
        }
        if kv == "await" {
            _p_adv(st);
            return map{ kind: "unary", op: "await", arg: _parse_unary(st), line: t["line"], col: t["col"] };
        }
        // Note: `map` can also be used as a variable/module name when not followed by `{`
        if kv == "map" {
            _p_adv(st);
            return map{ kind: "ident", name: "map", line: t["line"], col: t["col"], end_col: t["end_col"] };
        }
    }

    if t["kind"] == "ID" {
        _p_adv(st);
        return map{ kind: "ident", name: t["val"], line: t["line"], col: t["col"], end_col: t["end_col"] };
    }

    if t["kind"] == "PUNC" and t["val"] == "(" {
        _p_adv(st);
        let inner = _parse_expr(st);
        _p_expect(st, "PUNC", ")", "')'");
        return inner;
    }

    if t["kind"] == "PUNC" and t["val"] == "[" {
        _p_adv(st);
        let items = [];
        while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", "]") {
            if _p_eat(st, "OP", "...") {
                push(items, map{ kind: "spread", arg: _parse_expr(st), line: _p_cur(st)["line"], col: _p_cur(st)["col"] });
            } else {
                push(items, _parse_expr(st));
            }
            if not _p_eat(st, "PUNC", ",") { break; }
        }
        _p_expect(st, "PUNC", "]", "']'");
        return map{ kind: "array_lit", items: items, line: t["line"], col: t["col"] };
    }

    _p_err(st, "Unexpected token '" + t["val"] + "' in expression", t);
    _p_adv(st);
    return map{ kind: "nil", line: t["line"], col: t["col"], end_col: t["end_col"] };
}

fn _parse_postfix(st) {
    let expr = _parse_primary(st);
    while not _p_is(st, "EOF", nil) {
        let t = _p_cur(st);
        if t["kind"] == "PUNC" and t["val"] == "(" {
            _p_adv(st);
            let cargs = [];
            while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", ")") {
                if _p_eat(st, "OP", "...") {
                    push(cargs, map{ kind: "spread", arg: _parse_expr(st), line: _p_cur(st)["line"], col: _p_cur(st)["col"] });
                } else {
                    push(cargs, _parse_expr(st));
                }
                if not _p_eat(st, "PUNC", ",") { break; }
            }
            _p_expect(st, "PUNC", ")", "')'");
            expr = map{ kind: "call", callee: expr, args: cargs, line: expr["line"], col: expr["col"] };
        } elif (t["kind"] == "PUNC" and t["val"] == ".") or (t["kind"] == "OP" and (t["val"] == "?." or t["val"] == "::")) {
            let acc_op = _p_adv(st)["val"];
            let mtok = _parse_ident_like(st, "member name");
            expr = map{ kind: "member", obj: expr, field: mtok["val"], op: acc_op, line: mtok["line"], col: mtok["col"], end_col: mtok["end_col"] };
        } elif t["kind"] == "PUNC" and t["val"] == ":" and _p_peek(st, 1)["kind"] == "ID" and _p_peek(st, 2)["val"] == "(" {
            // Colon method call `obj:method(args...)`
            _p_adv(st);
            let mtok2 = _p_adv(st);
            _p_adv(st); // '('
            let margs = [];
            while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", ")") {
                push(margs, _parse_expr(st));
                if not _p_eat(st, "PUNC", ",") { break; }
            }
            _p_expect(st, "PUNC", ")", "')'");
            expr = map{ kind: "method_call", obj: expr, method: mtok2["val"], args: margs, line: mtok2["line"], col: mtok2["col"] };
        } elif (t["kind"] == "PUNC" and t["val"] == "[") or (t["kind"] == "OP" and t["val"] == "?[") {
            _p_adv(st);
            let idx_e = nil;
            if not _p_is(st, "OP", "..") {
                idx_e = _parse_expr(st);
            }
            if _p_eat(st, "OP", "..") {
                let end_e = nil;
                if not _p_is(st, "PUNC", "]") {
                    end_e = _parse_expr(st);
                }
                _p_expect(st, "PUNC", "]", "']'");
                expr = map{ kind: "slice_expr", obj: expr, start: idx_e, stop: end_e, line: t["line"], col: t["col"] };
            } else {
                _p_expect(st, "PUNC", "]", "']'");
                expr = map{ kind: "index", obj: expr, index: idx_e, line: t["line"], col: t["col"] };
            }
        } elif t["kind"] == "OP" and t["val"] == "?" and _p_peek(st, 1)["val"] == ";" {
            _p_adv(st);
            expr = map{ kind: "try_prop", arg: expr, line: t["line"], col: t["col"] };
        } else {
            break;
        }
    }
    return expr;
}

fn _parse_power(st) {
    let base = _parse_postfix(st);
    let t = _p_cur(st);
    if t["kind"] == "OP" and (t["val"] == "**" or t["val"] == "^") {
        let op = _p_adv(st)["val"];
        let rhs = _parse_unary(st);
        return map{ kind: "binary", op: op, left: base, right: rhs, line: t["line"], col: t["col"] };
    }
    return base;
}

fn _parse_unary(st) {
    let t = _p_cur(st);
    if (t["kind"] == "OP" and (t["val"] == "-" or t["val"] == "+" or t["val"] == "!" or t["val"] == "~"))
       or (t["kind"] == "KW" and t["val"] == "not") {
        let op = _p_adv(st)["val"];
        return map{ kind: "unary", op: op, arg: _parse_unary(st), line: t["line"], col: t["col"] };
    }
    return _parse_power(st);
}

fn _parse_mul(st) {
    let left = _parse_unary(st);
    while _p_cur(st)["kind"] == "OP" and (_p_cur(st)["val"] == "*" or _p_cur(st)["val"] == "/" or _p_cur(st)["val"] == "%") {
        let op_t = _p_adv(st);
        let right = _parse_unary(st);
        left = map{ kind: "binary", op: op_t["val"], left: left, right: right, line: op_t["line"], col: op_t["col"] };
    }
    return left;
}

fn _parse_add(st) {
    let left = _parse_mul(st);
    while _p_cur(st)["kind"] == "OP" and (_p_cur(st)["val"] == "+" or _p_cur(st)["val"] == "-") {
        let op_t = _p_adv(st);
        let right = _parse_mul(st);
        left = map{ kind: "binary", op: op_t["val"], left: left, right: right, line: op_t["line"], col: op_t["col"] };
    }
    return left;
}

fn _parse_shift_bit(st) {
    let left = _parse_add(st);
    while _p_cur(st)["kind"] == "OP" and (_p_cur(st)["val"] == "<<" or _p_cur(st)["val"] == ">>" or _p_cur(st)["val"] == "&" or _p_cur(st)["val"] == "|") {
        let op_t = _p_adv(st);
        let right = _parse_add(st);
        left = map{ kind: "binary", op: op_t["val"], left: left, right: right, line: op_t["line"], col: op_t["col"] };
    }
    return left;
}

fn _parse_cmp(st) {
    let left = _parse_shift_bit(st);
    while _p_cur(st)["kind"] == "OP" and (_p_cur(st)["val"] == "<" or _p_cur(st)["val"] == "<=" or _p_cur(st)["val"] == ">" or _p_cur(st)["val"] == ">=") {
        let op_t = _p_adv(st);
        let right = _parse_shift_bit(st);
        left = map{ kind: "binary", op: op_t["val"], left: left, right: right, line: op_t["line"], col: op_t["col"] };
    }
    return left;
}

fn _parse_eq(st) {
    let left = _parse_cmp(st);
    while _p_cur(st)["kind"] == "OP" and (_p_cur(st)["val"] == "==" or _p_cur(st)["val"] == "!=") {
        let op_t = _p_adv(st);
        let right = _parse_cmp(st);
        left = map{ kind: "binary", op: op_t["val"], left: left, right: right, line: op_t["line"], col: op_t["col"] };
    }
    return left;
}

fn _parse_and(st) {
    let left = _parse_eq(st);
    while (_p_cur(st)["kind"] == "KW" and _p_cur(st)["val"] == "and") or (_p_cur(st)["kind"] == "OP" and _p_cur(st)["val"] == "&&") {
        let op_t = _p_adv(st);
        let right = _parse_eq(st);
        left = map{ kind: "binary", op: "and", left: left, right: right, line: op_t["line"], col: op_t["col"] };
    }
    return left;
}

fn _parse_or(st) {
    let left = _parse_and(st);
    while (_p_cur(st)["kind"] == "KW" and _p_cur(st)["val"] == "or") or (_p_cur(st)["kind"] == "OP" and _p_cur(st)["val"] == "||") {
        let op_t = _p_adv(st);
        let right = _parse_and(st);
        left = map{ kind: "binary", op: "or", left: left, right: right, line: op_t["line"], col: op_t["col"] };
    }
    return left;
}

fn _parse_nullish_pipe(st) {
    let left = _parse_or(st);
    while _p_cur(st)["kind"] == "OP" and (_p_cur(st)["val"] == "??" or _p_cur(st)["val"] == "|>") {
        let op_t = _p_adv(st);
        let right = _parse_or(st);
        left = map{ kind: "binary", op: op_t["val"], left: left, right: right, line: op_t["line"], col: op_t["col"] };
    }
    // Ternary `cond ? a : b`
    if _p_is(st, "OP", "?") and _p_peek(st, 1)["val"] != ";" {
        let qt = _p_adv(st);
        let t_branch = _parse_expr(st);
        _p_expect(st, "PUNC", ":", "':' in ternary expression");
        let f_branch = _parse_expr(st);
        return map{ kind: "if_expr", cond: left, then_expr: t_branch, else_expr: f_branch, line: qt["line"], col: qt["col"] };
    }
    return left;
}

fn _parse_expr(st) {
    return _parse_nullish_pipe(st);
}

fn _parse_block_expr_or_stmts(st) {
    let bt = _p_expect(st, "PUNC", "{", "'{'");
    let stmts = [];
    let tail_expr = nil;
    while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", "}") {
        // Check if this could be a trailing expression without semicolon before `}`
        let cur = _p_cur(st);
        let is_stmt_kw = cur["kind"] == "KW" and (
            cur["val"] == "let" or cur["val"] == "const" or cur["val"] == "return"
            or cur["val"] == "while" or cur["val"] == "loop" or cur["val"] == "for"
            or cur["val"] == "break" or cur["val"] == "continue" or cur["val"] == "throw"
            or cur["val"] == "defer" or cur["val"] == "struct" or cur["val"] == "class"
            or cur["val"] == "enum" or cur["val"] == "export" or cur["val"] == "print"
        );
        if is_stmt_kw or (cur["kind"] == "KW" and cur["val"] == "fn" and _p_peek(st, 1)["kind"] == "ID") {
            push(stmts, _parse_stmt(st));
        } else {
            let s_or_e = _parse_stmt_or_tail_expr(st);
            if s_or_e["is_tail_expr"] == true and _p_is(st, "PUNC", "}") {
                tail_expr = s_or_e["node"];
            } else {
                push(stmts, s_or_e["node"]);
            }
        }
    }
    let end_t = _p_expect(st, "PUNC", "}", "'}'");
    return map{ kind: "block", stmts: stmts, tail_expr: tail_expr, line: bt["line"], col: bt["col"], end_line: end_t["line"], end_col: end_t["end_col"] };
}

fn _parse_block(st) {
    return _parse_block_expr_or_stmts(st);
}

fn _parse_if_expr(st) {
    let it = _p_expect(st, "KW", "if", "'if'");
    let cond = _parse_expr(st);
    let then_b = _parse_block_expr_or_stmts(st);
    let else_b = nil;
    if _p_eat(st, "KW", "elif") {
        // Rewind 1 token and treat `elif` like `if`
        let elif_t = st["tokens"][st["pos"] - 1];
        let sub_cond = _parse_expr(st);
        let sub_then = _parse_block_expr_or_stmts(st);
        let sub_else = nil;
        while _p_eat(st, "KW", "elif") {
            // handled recursively below if chained
            let c2 = _parse_expr(st);
            let t2 = _parse_block_expr_or_stmts(st);
            sub_else = map{ kind: "if_stmt", cond: c2, then_block: t2, else_block: nil, line: elif_t["line"], col: elif_t["col"] };
        }
        if _p_eat(st, "KW", "else") {
            if _p_is(st, "KW", "if") {
                let nested = _parse_if_expr(st);
                if sub_else == nil { sub_else = nested; } else { sub_else["else_block"] = nested; }
            } else {
                let eb = _parse_block_expr_or_stmts(st);
                if sub_else == nil { sub_else = eb; } else { sub_else["else_block"] = eb; }
            }
        }
        else_b = map{ kind: "if_stmt", cond: sub_cond, then_block: sub_then, else_block: sub_else, line: elif_t["line"], col: elif_t["col"] };
    } elif _p_eat(st, "KW", "else") {
        if _p_is(st, "KW", "if") {
            else_b = _parse_if_expr(st);
        } else {
            else_b = _parse_block_expr_or_stmts(st);
        }
    }
    return map{ kind: "if_stmt", cond: cond, then_block: then_b, else_block: else_b, line: it["line"], col: it["col"] };
}

fn _parse_match_pattern(st) {
    let t = _p_cur(st);
    if t["kind"] == "KW" and t["val"] == "else" {
        _p_adv(st);
        return map{ kind: "wildcard", line: t["line"], col: t["col"] };
    }
    if t["kind"] == "ID" and t["val"] == "_" {
        _p_adv(st);
        return map{ kind: "wildcard", line: t["line"], col: t["col"] };
    }
    if t["kind"] == "ID" {
        let id1 = _p_adv(st);
        if _p_eat(st, "PUNC", ".") or _p_eat(st, "OP", "::") {
            let vtok = _parse_ident_like(st, "enum variant");
            let pbinds = [];
            if _p_eat(st, "PUNC", "(") {
                while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", ")") {
                    let bt = _parse_ident_like(st, "pattern binding");
                    push(pbinds, bt["val"]);
                    if not _p_eat(st, "PUNC", ",") { break; }
                }
                _p_expect(st, "PUNC", ")", "')'");
            }
            return map{ kind: "enum_pat", enum_name: id1["val"], variant: vtok["val"], bindings: pbinds, line: id1["line"], col: id1["col"] };
        }
        if _p_eat(st, "PUNC", "(") {
            let pbinds2 = [];
            while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", ")") {
                let bt2 = _parse_ident_like(st, "pattern binding");
                push(pbinds2, bt2["val"]);
                if not _p_eat(st, "PUNC", ",") { break; }
            }
            _p_expect(st, "PUNC", ")", "')'");
            return map{ kind: "ctor_pat", ctor: id1["val"], bindings: pbinds2, line: id1["line"], col: id1["col"] };
        }
        return map{ kind: "ident_pat", name: id1["val"], line: id1["line"], col: id1["col"] };
    }
    // Literal or general pattern expression
    let pe = _parse_add(st);
    return map{ kind: "lit_pat", expr: pe, line: t["line"], col: t["col"] };
}

fn _parse_match_node(st) {
    let mt = _p_expect(st, "KW", "match", "'match'");
    let target = _parse_expr(st);
    _p_expect(st, "PUNC", "{", "'{' after match target");
    let arms = [];
    while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", "}") {
        let pats = [_parse_match_pattern(st)];
        while _p_eat(st, "OP", "|") {
            push(pats, _parse_match_pattern(st));
        }
        let guard_e = nil;
        if _p_eat(st, "KW", "if") {
            guard_e = _parse_expr(st);
        }
        if not _p_eat(st, "OP", "=>") {
            _p_eat(st, "PUNC", ":");
        }
        let arm_body = nil;
        if _p_is(st, "PUNC", "{") {
            arm_body = _parse_block_expr_or_stmts(st);
        } else {
            arm_body = _parse_expr(st);
        }
        _p_eat(st, "PUNC", ",");
        _p_eat(st, "PUNC", ";");
        push(arms, map{ patterns: pats, guard: guard_e, body: arm_body });
    }
    _p_expect(st, "PUNC", "}", "'}'");
    return map{ kind: "match_stmt", target: target, arms: arms, line: mt["line"], col: mt["col"] };
}

fn _parse_fn_expr_or_decl(st, require_name, is_async, outer_doc) {
    let ft = _p_expect(st, "KW", "fn", "'fn'");
    let doc_str = if outer_doc != "" { outer_doc } else { ft["doc"] };
    let fn_name = "";
    let name_line = ft["line"];
    let name_col = ft["col"];
    let name_end_col = ft["end_col"];

    if _p_cur(st)["kind"] == "ID" or (require_name and _p_cur(st)["kind"] == "KW") {
        let nt = _p_adv(st);
        fn_name = nt["val"];
        name_line = nt["line"];
        name_col = nt["col"];
        name_end_col = nt["end_col"];
    } elif require_name {
        _p_err(st, "Expected function name after 'fn'", _p_cur(st));
    }

    _p_expect(st, "PUNC", "(", "'(' in function signature");
    let params = [];
    let has_rest = false;
    while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", ")") {
        let is_rest_p = _p_eat(st, "OP", "...");
        if is_rest_p { has_rest = true; }
        let pt = _parse_ident_like(st, "parameter name");
        let p_annot = nil;
        if _p_eat(st, "PUNC", ":") {
            p_annot = _parse_type_annot(st);
        }
        let p_def = nil;
        if _p_eat(st, "OP", "=") {
            p_def = _parse_expr(st);
        }
        push(params, map{
            name: pt["val"],
            annot: p_annot,
            default_expr: p_def,
            is_rest: is_rest_p,
            line: pt["line"],
            col: pt["col"],
            end_col: pt["end_col"]
        });
        if not _p_eat(st, "PUNC", ",") { break; }
    }
    _p_expect(st, "PUNC", ")", "')'");

    let ret_annot = nil;
    if _p_eat(st, "OP", "->") {
        ret_annot = _parse_type_annot(st);
    }

    let req_clauses = [];
    let ens_clauses = [];
    while _p_is(st, "KW", "requires") or _p_is(st, "KW", "ensures") {
        let ct = _p_adv(st);
        let ce = _parse_expr(st);
        if ct["val"] == "requires" {
            push(req_clauses, map{ expr: ce, line: ct["line"], col: ct["col"] });
        } else {
            push(ens_clauses, map{ expr: ce, line: ct["line"], col: ct["col"] });
        }
    }

    let body = _parse_block(st);
    return map{
        kind: if fn_name != "" and require_name { "fn_decl" } else { "fn_expr" },
        name: fn_name,
        is_async: is_async,
        params: params,
        has_rest: has_rest,
        ret_annot: ret_annot,
        requires_list: req_clauses,
        ensures_list: ens_clauses,
        body: body,
        doc: doc_str,
        line: name_line,
        col: name_col,
        end_col: name_end_col,
        end_line: body["end_line"]
    };
}

fn _parse_var_decl(st, is_const_decl, outer_doc) {
    let kt = _p_adv(st); // 'let' or 'const'
    let doc_str = if outer_doc != "" { outer_doc } else { kt["doc"] };

    // Support array `[a, b] = ...` or map `{a, b} = ...` destructuring
    if _p_is(st, "PUNC", "[") or _p_is(st, "PUNC", "{") {
        let open_ch = _p_adv(st)["val"];
        let close_ch = if open_ch == "[" { "]" } else { "}" };
        let names = [];
        while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", close_ch) {
            _p_eat(st, "OP", "...");
            let bt = _parse_ident_like(st, "destructuring binding");
            if _p_eat(st, "PUNC", ":") {
                let alias_t = _parse_ident_like(st, "destructuring target");
                push(names, alias_t);
            } else {
                push(names, bt);
            }
            if not _p_eat(st, "PUNC", ",") { break; }
        }
        _p_expect(st, "PUNC", close_ch, "'" + close_ch + "'");
        let init_e = nil;
        if _p_eat(st, "OP", "=") {
            init_e = _parse_expr(st);
        }
        _p_eat(st, "PUNC", ";");
        return map{ kind: "destruct_decl", is_const: is_const_decl, names: names, init: init_e, line: kt["line"], col: kt["col"] };
    }

    let nt = _parse_ident_like(st, "variable name");
    let annot = nil;
    if _p_eat(st, "PUNC", ":") {
        annot = _parse_type_annot(st);
    }
    let init_expr = nil;
    if _p_eat(st, "OP", "=") {
        init_expr = _parse_expr(st);
    }
    _p_eat(st, "PUNC", ";");
    return map{
        kind: "var_decl",
        is_const: is_const_decl,
        name: nt["val"],
        annot: annot,
        init: init_expr,
        doc: doc_str,
        line: nt["line"],
        col: nt["col"],
        end_col: nt["end_col"]
    };
}

fn _parse_stmt_or_tail_expr(st) {
    let e = _parse_expr(st);
    let nxt = _p_cur(st);
    if nxt["kind"] == "OP" and (nxt["val"] == "=" or nxt["val"] == "+=" or nxt["val"] == "-=" or nxt["val"] == "*=" or nxt["val"] == "/=" or nxt["val"] == "%=" or nxt["val"] == "**=") {
        let op_t = _p_adv(st);
        let rhs = _parse_expr(st);
        _p_eat(st, "PUNC", ";");
        return map{ is_tail_expr: false, node: map{ kind: "assign", op: op_t["val"], target: e, val: rhs, line: e["line"], col: e["col"] } };
    }
    let had_semi = _p_eat(st, "PUNC", ";");
    if not had_semi and (e["kind"] == "if_stmt" or e["kind"] == "match_stmt" or e["kind"] == "try_block_expr") {
        return map{ is_tail_expr: _p_is(st, "PUNC", "}"), node: e };
    }
    if not had_semi and _p_is(st, "PUNC", "}") {
        return map{ is_tail_expr: true, node: e };
    }
    return map{ is_tail_expr: false, node: map{ kind: "expr_stmt", expr: e, line: e["line"], col: e["col"] } };
}

fn _parse_stmt(st) {
    let t = _p_cur(st);
    let doc_str = t["doc"];

    if _p_eat(st, "PUNC", ";") {
        return map{ kind: "empty", line: t["line"], col: t["col"] };
    }
    if _p_is(st, "PUNC", "{") {
        return _parse_block(st);
    }

    // Handle `pub` or `export` prefixes on declarations
    let is_exported = false;
    if t["kind"] == "KW" and t["val"] == "pub" {
        _p_adv(st);
        is_exported = true;
        t = _p_cur(st);
        if doc_str == "" { doc_str = t["doc"]; }
    }
    if t["kind"] == "KW" and t["val"] == "export" {
        let exp_t = _p_adv(st);
        if doc_str == "" { doc_str = exp_t["doc"]; }
        let nxt = _p_cur(st);
        if nxt["kind"] == "KW" and (nxt["val"] == "fn" or nxt["val"] == "async" or nxt["val"] == "let" or nxt["val"] == "const" or nxt["val"] == "struct" or nxt["val"] == "class" or nxt["val"] == "enum") {
            is_exported = true;
            t = nxt;
        } else {
            let names = [];
            while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", ";") {
                let id_t = _parse_ident_like(st, "exported identifier");
                push(names, id_t);
                if not _p_eat(st, "PUNC", ",") { break; }
            }
            _p_eat(st, "PUNC", ";");
            return map{ kind: "export_stmt", names: names, line: exp_t["line"], col: exp_t["col"] };
        }
    }

    if t["kind"] == "KW" {
        let kv = t["val"];
        if kv == "let" {
            let vd = _parse_var_decl(st, false, doc_str);
            vd["exported"] = is_exported;
            return vd;
        }
        if kv == "const" {
            let cd = _parse_var_decl(st, true, doc_str);
            cd["exported"] = is_exported;
            return cd;
        }
        if kv == "fn" or (kv == "async" and _p_peek(st, 1)["val"] == "fn") {
            let is_as = false;
            if kv == "async" { _p_adv(st); is_as = true; }
            if _p_peek(st, 1)["kind"] == "ID" or _p_peek(st, 1)["kind"] == "KW" {
                let fd = _parse_fn_expr_or_decl(st, true, is_as, doc_str);
                fd["exported"] = is_exported;
                return fd;
            }
        }
        if kv == "return" {
            let rt = _p_adv(st);
            let rv = nil;
            if not _p_is(st, "PUNC", ";") and not _p_is(st, "PUNC", "}") and not _p_is(st, "EOF", nil) {
                rv = _parse_expr(st);
            }
            _p_eat(st, "PUNC", ";");
            return map{ kind: "return_stmt", val: rv, line: rt["line"], col: rt["col"] };
        }
        if kv == "throw" {
            let tht = _p_adv(st);
            let tv = _parse_expr(st);
            _p_eat(st, "PUNC", ";");
            return map{ kind: "throw_stmt", val: tv, line: tht["line"], col: tht["col"] };
        }
        if kv == "break" or kv == "continue" {
            let bct = _p_adv(st);
            _p_eat(st, "PUNC", ";");
            return map{ kind: bct["val"] + "_stmt", line: bct["line"], col: bct["col"] };
        }
        if kv == "print" {
            let pt = _p_adv(st);
            if _p_is(st, "PUNC", "(") {
                // Could be `print(x)` call or `print (x)` statement — parse args cleanly
                _p_adv(st);
                let pargs = [];
                while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", ")") {
                    push(pargs, _parse_expr(st));
                    if not _p_eat(st, "PUNC", ",") { break; }
                }
                _p_expect(st, "PUNC", ")", "')'");
                _p_eat(st, "PUNC", ";");
                return map{ kind: "print_stmt", args: pargs, line: pt["line"], col: pt["col"] };
            }
            let pv = _parse_expr(st);
            _p_eat(st, "PUNC", ";");
            return map{ kind: "print_stmt", args: [pv], line: pt["line"], col: pt["col"] };
        }
        if kv == "if" {
            return _parse_if_expr(st);
        }
        if kv == "while" {
            let wt = _p_adv(st);
            let wc = _parse_expr(st);
            let wb = _parse_block(st);
            return map{ kind: "while_stmt", cond: wc, body: wb, line: wt["line"], col: wt["col"] };
        }
        if kv == "loop" {
            let lt = _p_adv(st);
            let lb = _parse_block(st);
            return map{ kind: "loop_stmt", body: lb, line: lt["line"], col: lt["col"] };
        }
        if kv == "for" {
            let fort = _p_adv(st);
            let v1 = _parse_ident_like(st, "loop variable");
            let v2 = nil;
            if _p_eat(st, "PUNC", ",") {
                v2 = _parse_ident_like(st, "second loop variable");
            }
            let iter_e = nil;
            let end_e = nil;
            if _p_eat(st, "KW", "in") {
                iter_e = _parse_expr(st);
                if _p_eat(st, "KW", "to") {
                    end_e = _parse_expr(st);
                }
            } else {
                iter_e = _parse_expr(st);
            }
            let fb = _parse_block(st);
            return map{ kind: "for_stmt", var1: v1, var2: v2, iter: iter_e, range_end: end_e, body: fb, line: fort["line"], col: fort["col"] };
        }
        if kv == "defer" {
            let dt = _p_adv(st);
            let db = if _p_is(st, "PUNC", "{") { _parse_block(st) } else { _parse_stmt(st) };
            return map{ kind: "defer_stmt", body: db, line: dt["line"], col: dt["col"] };
        }
        if kv == "try" and _p_peek(st, 1)["val"] == "{" {
            return _parse_primary(st);
        }
        if kv == "match" {
            return _parse_match_node(st);
        }
        if kv == "switch" {
            let swt = _p_adv(st);
            let target_e = _parse_expr(st);
            _p_expect(st, "PUNC", "{", "'{' after switch");
            let cases = [];
            while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", "}") {
                if _p_eat(st, "KW", "case") {
                    let ce = _parse_expr(st);
                    _p_eat(st, "PUNC", ":");
                    let cstmts = [];
                    while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", "}") and not _p_is(st, "KW", "case") and not _p_is(st, "KW", "default") {
                        push(cstmts, _parse_stmt(st));
                    }
                    push(cases, map{ val: ce, stmts: cstmts });
                } elif _p_eat(st, "KW", "default") {
                    _p_eat(st, "PUNC", ":");
                    let dstmts = [];
                    while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", "}") and not _p_is(st, "KW", "case") {
                        push(dstmts, _parse_stmt(st));
                    }
                    push(cases, map{ val: nil, stmts: dstmts });
                } else {
                    _p_adv(st);
                }
            }
            _p_expect(st, "PUNC", "}", "'}'");
            return map{ kind: "switch_stmt", target: target_e, cases: cases, line: swt["line"], col: swt["col"] };
        }
        if kv == "enum" {
            let et = _p_adv(st);
            let nt = _parse_ident_like(st, "enum name");
            _p_expect(st, "PUNC", "{", "'{' in enum declaration");
            let variants = [];
            while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", "}") {
                let vt = _parse_ident_like(st, "enum variant");
                if _p_eat(st, "PUNC", "(") {
                    while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", ")") { _p_adv(st); }
                    _p_eat(st, "PUNC", ")");
                }
                if _p_eat(st, "OP", "=") {
                    _parse_expr(st);
                }
                push(variants, vt["val"]);
                if not _p_eat(st, "PUNC", ",") { _p_eat(st, "PUNC", ";"); }
            }
            let end_e = _p_expect(st, "PUNC", "}", "'}'");
            return map{ kind: "enum_decl", name: nt["val"], variants: variants, exported: is_exported, doc: doc_str, line: nt["line"], col: nt["col"], end_col: nt["end_col"], end_line: end_e["line"] };
        }
        if kv == "struct" {
            let st_t = _p_adv(st);
            let nt = _parse_ident_like(st, "struct name");
            _p_expect(st, "PUNC", "{", "'{' in struct declaration");
            let fields = [];
            while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", "}") {
                let ft = _parse_ident_like(st, "field name");
                let fa = nil;
                if _p_eat(st, "PUNC", ":") { fa = _parse_type_annot(st); }
                if _p_eat(st, "OP", "=") { _parse_expr(st); }
                push(fields, map{ name: ft["val"], annot: fa, line: ft["line"], col: ft["col"] });
                if not _p_eat(st, "PUNC", ",") { _p_eat(st, "PUNC", ";"); }
            }
            let end_s = _p_expect(st, "PUNC", "}", "'}'");
            return map{ kind: "struct_decl", name: nt["val"], fields: fields, exported: is_exported, doc: doc_str, line: nt["line"], col: nt["col"], end_col: nt["end_col"], end_line: end_s["line"] };
        }
        if kv == "class" or kv == "interface" {
            let cl_t = _p_adv(st);
            let nt = _parse_ident_like(st, "class name");
            let base_nm = "";
            if _p_eat(st, "KW", "extends") {
                base_nm = _parse_ident_like(st, "base class")["val"];
            }
            _p_expect(st, "PUNC", "{", "'{' in class declaration");
            let methods = [];
            while not _p_is(st, "EOF", nil) and not _p_is(st, "PUNC", "}") {
                if _p_is(st, "KW", "fn") or (_p_is(st, "KW", "async") and _p_peek(st, 1)["val"] == "fn") {
                    let is_as2 = _p_eat(st, "KW", "async");
                    push(methods, _parse_fn_expr_or_decl(st, true, is_as2, ""));
                } else {
                    push(methods, _parse_stmt(st));
                }
            }
            let end_c = _p_expect(st, "PUNC", "}", "'}'");
            return map{ kind: "class_decl", name: nt["val"], base_name: base_nm, members: methods, exported: is_exported, doc: doc_str, line: nt["line"], col: nt["col"], end_col: nt["end_col"], end_line: end_c["line"] };
        }
    }

    let r = _parse_stmt_or_tail_expr(st);
    return r["node"];
}

fn parse_sapp_ast(src_code) {
    let lex = tokenize_sapp(src_code);
    let st = map{
        tokens: lex["tokens"],
        pos: 0,
        errors: []
    };
    let li = 0;
    while li < len(lex["errors"]) {
        let le = lex["errors"][li];
        push(st["errors"], map{
            severity: "error",
            code: "LEX_ERROR",
            message: le["message"],
            message_el: "Λεκτικό σφάλμα: " + le["message"],
            line: le["line"],
            col: le["col"],
            end_line: le["line"],
            end_col: le["col"] + 1,
            suggestion: nil
        });
        li = li + 1;
    }

    let stmts = [];
    while not _p_is(st, "EOF", nil) {
        let before = st["pos"];
        push(stmts, _parse_stmt(st));
        if st["pos"] == before and not _p_is(st, "EOF", nil) {
            _p_adv(st);
        }
    }
    return map{
        ast: map{ kind: "program", stmts: stmts },
        errors: st["errors"],
        tokens: lex["tokens"]
    };
}

// ── Builtin Symbol Catalog (Arities, Return Types & Transcendental Flags) ─────

let _BUILTIN_SPECS = nil;

fn _b_spec(min_a, max_a, ret_base, is_trans = false) {
    return map{ min_args: min_a, max_args: max_a, has_rest: max_a < 0, ret_base: ret_base, is_transcendental: is_trans };
}

fn _get_builtin_specs() {
    if _BUILTIN_SPECS != nil { return _BUILTIN_SPECS; }
    let m = map{};
    let base_map = BUILTINS_MOD.builtin_set();
    let bks = map_keys(base_map);
    let i = 0;
    while i < len(bks) {
        m[bks[i]] = _b_spec(0, -1, "any", false);
        i = i + 1;
    }

    // Core & Console
    m["print"] = _b_spec(0, -1, "nil");
    m["println"] = _b_spec(0, -1, "nil");
    m["eprint"] = _b_spec(0, -1, "nil");
    m["eprintln"] = _b_spec(0, -1, "nil");
