// ── Module Export Resolution Cache ────────────────────────────────────────────

let _MOD_EXPORT_CACHE = map{};

fn _resolve_import_path(imp_str, base_dir) {
    if str_starts_with(imp_str, "stdlib:") {
        let rel = str_slice(imp_str, 7, len(imp_str));
        let p1 = path_join("stdlib", rel);
        if fs_exists(p1) { return p1; }
        if base_dir != "" {
            let p2 = path_join(base_dir, rel);
            if fs_exists(p2) { return p2; }
        }
        return p1;
    }
    if base_dir != "" and not str_starts_with(imp_str, "/") {
        let p3 = path_join(base_dir, imp_str);
        if fs_exists(p3) { return p3; }
    }
    return imp_str;
}

fn _inspect_module_exports(imp_str, base_dir) {
    let resolved = _resolve_import_path(imp_str, base_dir);
    if map_has(_MOD_EXPORT_CACHE, resolved) {
        return _MOD_EXPORT_CACHE[resolved];
    }
    // Guard against cyclic imports
    let placeholder = map{ ok: false, path: resolved, exports: map{} };
    _MOD_EXPORT_CACHE[resolved] = placeholder;

    if not fs_exists(resolved) {
        return placeholder;
    }
    let src = try fs_read(resolved) catch nil;
    if src == nil { return placeholder; }

    if len(src) > 20000 {
        let fast_exports = map{};
        let raw_lns = str_split(src, "\n");
        let in_exp_list = false;
        let li = 0;
        while li < len(raw_lns) {
            let tln = str_trim(raw_lns[li]);
            if in_exp_list {
                let cleaned = str_replace_all(tln, ";", "");
                let parts = str_split(cleaned, ",");
                let pi = 0;
                while pi < len(parts) {
                    let nm = str_trim(parts[pi]);
                    if nm != "" and not str_starts_with(nm, "//") {
                        fast_exports[nm] = map{ kind: "any", min_args: 0, max_args: -1, has_rest: true, line: li + 1, col: 1, doc: "" };
                    }
                    pi = pi + 1;
                }
                if str_contains(tln, ";") { in_exp_list = false; }
            } elif str_starts_with(tln, "export fn ") or str_starts_with(tln, "pub fn ") {
                let after = if str_starts_with(tln, "export fn ") { str_slice(tln, 10, len(tln)) } else { str_slice(tln, 7, len(tln)) };
                let p_idx = str_index_of(after, "(");
                if p_idx > 0 {
                    let fnm = str_trim(str_slice(after, 0, p_idx));
                    fast_exports[fnm] = map{ kind: "fn", min_args: 0, max_args: -1, has_rest: true, line: li + 1, col: 1, doc: "" };
                }
            } elif str_starts_with(tln, "export ") {
                let body = str_slice(tln, 7, len(tln));
                let cleaned2 = str_replace_all(body, ";", "");
                let parts2 = str_split(cleaned2, ",");
                let pj = 0;
                while pj < len(parts2) {
                    let nm2 = str_trim(parts2[pj]);
                    if nm2 != "" and not str_starts_with(nm2, "//") {
                        fast_exports[nm2] = map{ kind: "any", min_args: 0, max_args: -1, has_rest: true, line: li + 1, col: 1, doc: "" };
                    }
                    pj = pj + 1;
                }
                if not str_contains(tln, ";") { in_exp_list = true; }
            }
            li = li + 1;
        }
        let fast_res = map{ ok: true, path: resolved, exports: fast_exports };
        _MOD_EXPORT_CACHE[resolved] = fast_res;
        return fast_res;
    }

    // Lightweight fast scan of top-level fn declarations and export lists
    let parsed = parse_sapp_ast(src);
    let stmts = parsed["ast"]["stmts"];
    let decls = map{};
    let exports_map = map{};

    let i = 0;
    while i < len(stmts) {
        let s = stmts[i];
        let sk = s["kind"];
        if sk == "fn_decl" {
            let req_c = 0;
            let pi = 0;
            while pi < len(s["params"]) {
                if s["params"][pi]["default_expr"] == nil and not s["params"][pi]["is_rest"] {
                    req_c = req_c + 1;
                }
                pi = pi + 1;
            }
            let info = map{
                kind: "fn",
                min_args: req_c,
                max_args: if s["has_rest"] { -1 } else { len(s["params"]) },
                has_rest: s["has_rest"],
                line: s["line"],
                col: s["col"],
                doc: s["doc"]
            };
            decls[s["name"]] = info;
            if s["exported"] == true {
                exports_map[s["name"]] = info;
            }
        } elif sk == "var_decl" {
            let vinfo = map{ kind: "var", min_args: 0, max_args: -1, has_rest: true, line: s["line"], col: s["col"], doc: s["doc"] };
            decls[s["name"]] = vinfo;
            if s["exported"] == true {
                exports_map[s["name"]] = vinfo;
            }
        } elif sk == "export_stmt" {
            let j = 0;
            while j < len(s["names"]) {
                let enm = s["names"][j]["val"];
                if map_has(decls, enm) {
                    exports_map[enm] = decls[enm];
                } else {
                    exports_map[enm] = map{ kind: "any", min_args: 0, max_args: -1, has_rest: true, line: s["line"], col: s["col"], doc: "" };
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }

    let res = map{ ok: true, path: resolved, exports: exports_map };
    _MOD_EXPORT_CACHE[resolved] = res;
    return res;
}

// ── Pass 4 Helpers: AST -> First-Order Formula & Symbolic Path Extractor ──────

fn _ast_expr_to_fol(node, subst_map, is_int_mode) {
    if node == nil { return "0"; }
    let k = node["kind"];
    if k == "num" { return node["val"]; }
    if k == "bool" { return if node["val"] { "true" } else { "false" }; }
    if k == "ident" {
        let nm = node["name"];
        if subst_map != nil and map_has(subst_map, nm) {
            return "(" + subst_map[nm] + ")";
        }
        return nm;
    }
    if k == "unary" {
        let op = node["op"];
        let sub = _ast_expr_to_fol(node["arg"], subst_map, is_int_mode);
        if op == "not" or op == "!" { return "(not (" + sub + "))"; }
        if op == "-" { return "(-(" + sub + "))"; }
        if op == "+" { return sub; }
        return sub;
    }
    if k == "call" {
        if node["callee"]["kind"] == "ident" {
            let fnm = node["callee"]["name"];
            if (fnm == "divides" or fnm == "ndivides") and len(node["args"]) == 2 {
                return fnm + "(" + _ast_expr_to_fol(node["args"][0], subst_map, is_int_mode)
                    + ", " + _ast_expr_to_fol(node["args"][1], subst_map, is_int_mode) + ")";
            }
            if (fnm == "pow" or fnm == "num_pow") and len(node["args"]) == 2 {
                return "((" + _ast_expr_to_fol(node["args"][0], subst_map, is_int_mode) + ") ^ "
                    + _ast_expr_to_fol(node["args"][1], subst_map, is_int_mode) + ")";
            }
        }
    }
    if k == "binary" {
        let bop = node["op"];
        // Translate `E % m == r` or `E % m != r` into Presburger `divides(m, E - r)`!
        if is_int_mode and (bop == "==" or bop == "!=") {
            if node["left"]["kind"] == "binary" and node["left"]["op"] == "%" {
                let mod_m = _ast_expr_to_fol(node["left"]["right"], subst_map, is_int_mode);
                let dividend = _ast_expr_to_fol(node["left"]["left"], subst_map, is_int_mode);
                let rem_s = _ast_expr_to_fol(node["right"], subst_map, is_int_mode);
                let pred = if bop == "==" { "divides" } else { "ndivides" };
                return pred + "(" + mod_m + ", (" + dividend + ") - (" + rem_s + "))";
            }
        }
        let l_s = _ast_expr_to_fol(node["left"], subst_map, is_int_mode);
        let r_s = _ast_expr_to_fol(node["right"], subst_map, is_int_mode);
        if bop == "**" { bop = "^"; }
        if bop == "&&" { bop = "and"; }
        if bop == "||" { bop = "or"; }
        return "((" + l_s + ") " + bop + " (" + r_s + "))";
    }
    return "0";
}

// Collect non-constant division denominators `A / B` in an expression
fn _collect_expr_divisions(node, subst_map, is_int_mode, out_divs) {
    if node == nil { return; }
    let k = node["kind"];
    if k == "unary" {
        _collect_expr_divisions(node["arg"], subst_map, is_int_mode, out_divs);
        return;
    }
    if k == "binary" {
        _collect_expr_divisions(node["left"], subst_map, is_int_mode, out_divs);
        _collect_expr_divisions(node["right"], subst_map, is_int_mode, out_divs);
        if node["op"] == "/" {
            let rk = node["right"]["kind"];
            if rk == "num" {
                let nv = parse_number(node["right"]["val"]);
                if nv != nil and nv != 0 { return; }
            }
            push(out_divs, map{
                num_fol: _ast_expr_to_fol(node["left"], subst_map, is_int_mode),
                den_fol: _ast_expr_to_fol(node["right"], subst_map, is_int_mode),
                line: node["line"],
                col: node["col"]
            });
        }
        return;
    }
    if k == "call" {
        let i = 0;
        while i < len(node["args"]) {
            _collect_expr_divisions(node["args"][i], subst_map, is_int_mode, out_divs);
            i = i + 1;
        }
    }
}

// Extract symbolic return paths & division obligations from function body
fn _extract_symbolic_paths(stmts, idx, cur_subst, path_conds, is_int_mode, out_returns, out_divs) {
    let env = _sc_clone_map(cur_subst);
    let i = idx;
    while i < len(stmts) {
        let s = stmts[i];
        let sk = s["kind"];
        if sk == "var_decl" {
            if s["init"] != nil {
                _collect_expr_divisions(s["init"], env, is_int_mode, out_divs);
                env[s["name"]] = _ast_expr_to_fol(s["init"], env, is_int_mode);
            }
        } elif sk == "assign" and s["op"] == "=" and s["target"]["kind"] == "ident" {
            _collect_expr_divisions(s["val"], env, is_int_mode, out_divs);
            env[s["target"]["name"]] = _ast_expr_to_fol(s["val"], env, is_int_mode);
        } elif sk == "return_stmt" {
            if s["val"] != nil {
                _collect_expr_divisions(s["val"], env, is_int_mode, out_divs);
                push(out_returns, map{
                    conds: path_conds,
                    ret_node: s["val"],
                    ret_fol: _ast_expr_to_fol(s["val"], env, is_int_mode),
                    subst: _sc_clone_map(env),
                    line: s["line"],
                    col: s["col"]
                });
            }
            return;
        } elif sk == "if_stmt" {
            _collect_expr_divisions(s["cond"], env, is_int_mode, out_divs);
            let c_fol = _ast_expr_to_fol(s["cond"], env, is_int_mode);
            let p_then = [];
            let pi = 0;
            while pi < len(path_conds) { push(p_then, path_conds[pi]); pi = pi + 1; }
            push(p_then, c_fol);

            let p_else = [];
            pi = 0;
            while pi < len(path_conds) { push(p_else, path_conds[pi]); pi = pi + 1; }
            push(p_else, "(not (" + c_fol + "))");

            let then_stmts = [];
            let k1 = 0;
            while k1 < len(s["then_block"]["stmts"]) { push(then_stmts, s["then_block"]["stmts"][k1]); k1 = k1 + 1; }
            if s["then_block"]["tail_expr"] != nil {
                push(then_stmts, map{ kind: "return_stmt", val: s["then_block"]["tail_expr"], line: s["line"], col: s["col"] });
            }
            let rem_idx = i + 1;
            while rem_idx < len(stmts) { push(then_stmts, stmts[rem_idx]); rem_idx = rem_idx + 1; }
            _extract_symbolic_paths(then_stmts, 0, env, p_then, is_int_mode, out_returns, out_divs);

            let else_stmts = [];
            if s["else_block"] != nil {
                if s["else_block"]["kind"] == "block" {
                    let k2 = 0;
                    while k2 < len(s["else_block"]["stmts"]) { push(else_stmts, s["else_block"]["stmts"][k2]); k2 = k2 + 1; }
                    if s["else_block"]["tail_expr"] != nil {
                        push(else_stmts, map{ kind: "return_stmt", val: s["else_block"]["tail_expr"], line: s["line"], col: s["col"] });
                    }
                } else {
                    push(else_stmts, s["else_block"]);
                }
            }
            rem_idx = i + 1;
            while rem_idx < len(stmts) { push(else_stmts, stmts[rem_idx]); rem_idx = rem_idx + 1; }
            _extract_symbolic_paths(else_stmts, 0, env, p_else, is_int_mode, out_returns, out_divs);
            return;
        } elif sk == "expr_stmt" {
            _collect_expr_divisions(s["expr"], env, is_int_mode, out_divs);
        }
        i = i + 1;
    }
}

fn _format_witness_summary(wit_obj) {
    if wit_obj == nil or type(wit_obj) != "map" { return ""; }
    let vals = if map_has(wit_obj, "values") and type(wit_obj["values"]) == "map" { wit_obj["values"] } else { wit_obj };
    let ks = array_sort(map_keys(vals));
    let parts = [];
    let i = 0;
    while i < len(ks) {
        let k = ks[i];
        if k != "kind" and k != "values" and k != "exact" {
            push(parts, k + " = " + str(vals[k]));
        }
        i = i + 1;
    }
    return str_join(parts, ", ");
}

fn prove_formula_auto(formula_str, use_presburger = false) {
    if use_presburger {
        let pr = try DF.presburger_decide(formula_str) catch nil;
        if pr != nil and pr["truth"] != nil {
            let tv = pr["truth"] == true;
            let cex = if tv { nil } else { pr["witness_or_counterexample"] };
            return map{
                ok: true,
                engine: "Presburger",
                formula: formula_str,
                truth_value: tv,
                proved: tv,
                status: if tv { "PROVED_MATHEMATICALLY" } else { "REFUTED_COUNTEREXAMPLE" },
                counterexample: cex,
                witness_summary: _format_witness_summary(cex),
                certificate: pr["proof_certificate_en"],
                certificate_el: pr["proof_certificate_el"]
            };
        }
    }
    let cr = try DF.cad_decide(formula_str) catch nil;
    if cr != nil and cr["truth"] != nil {
        let tv2 = cr["truth"] == true;
        let cex2 = if tv2 { nil } else { cr["witness_or_counterexample"] };
        return map{
            ok: true,
            engine: "CAD",
            formula: formula_str,
            truth_value: tv2,
            proved: tv2,
            status: if tv2 { "PROVED_MATHEMATICALLY" } else { "REFUTED_COUNTEREXAMPLE" },
            counterexample: cex2,
            witness_summary: _format_witness_summary(cex2),
            certificate: cr["proof_certificate_en"],
            certificate_el: cr["proof_certificate_el"]
        };
    }
    return map{
        ok: false,
        engine: if use_presburger { "Presburger" } else { "CAD" },
        formula: formula_str,
        truth_value: nil,
        proved: false,
        status: "UNDECIDED",
        counterexample: nil,
        witness_summary: "",
        certificate: "Formula outside decidable polynomial/linear fragment",
        certificate_el: "Ο τύπος εκφεύγει από το αποφασίσιμο πολυωνυμικό/γραμμικό τμήμα"
    };
}

// ── Main 4-Pass Static Analyzer (`check_source`) ──────────────────────────────

fn _new_scope(parent_scope) {
    return map{
        parent: parent_scope,
        vars: map{}
    };
}

fn _scope_lookup(scope, name) {
    let cur = scope;
    while cur != nil {
        if map_has(cur["vars"], name) {
            return cur["vars"][name];
        }
        cur = cur["parent"];
    }
    return nil;
}

fn _scope_all_names(scope, builtins_map) {
    let out = [];
    let cur = scope;
    while cur != nil {
        let ks = map_keys(cur["vars"]);
        let i = 0;
        while i < len(ks) {
            _sc_arr_push_unique(out, ks[i]);
            i = i + 1;
        }
        cur = cur["parent"];
    }
    let bks = map_keys(builtins_map);
    let j = 0;
    while j < len(bks) {
        _sc_arr_push_unique(out, bks[j]);
        j = j + 1;
    }
    return out;
}

fn _resolve_annot_to_type(ctx, annot) {
    if annot == nil { return _make_type("any"); }
    let raw = annot["raw"];
    let base = raw;
    if raw == "number" or raw == "float" or raw == "f64" { base = "num"; }
    elif raw == "integer" or raw == "i64" or raw == "i32" { base = "int"; }
    elif raw == "str" { base = "string"; }
    elif raw == "boolean" { base = "bool"; }

    if annot["unit_raw"] != "" {
        let ures = _extract_ccy_and_ucc_unit(annot["unit_raw"]);
        if not ures["ok"] {
            let loc = if annot["unit_loc"] != nil { annot["unit_loc"] } else { annot };
            _emit_diag(ctx, "error", "INVALID_UNIT",
                "Unknown or malformed SI/currency unit '" + annot["unit_raw"] + "': " + str(ures["error"]),
                "Άγνωστη ή μη έγκυρη μονάδα SI/νομίσματος '" + annot["unit_raw"] + "'",
                loc["line"], loc["col"], loc["col"] + len(annot["unit_raw"]) + 2, nil);
            return _make_type(if base == "int" { "int" } else { "num" });
        }
        let num_b = if base == "int" { "int" } else { "num" };
        return _make_unit_type(num_b, ures["dim"], ures["ccy"], annot["unit_raw"]);
    }

    if base == "Option" {
        let t = _make_type("Option");
        if len(annot["args"]) >= 1 {
            t["elem_type"] = _resolve_annot_to_type(ctx, annot["args"][0]);
        }
        return t;
    }
    if base == "Result" {
        let t2 = _make_type("Result");
        if len(annot["args"]) >= 1 {
            t2["ok_type"] = _resolve_annot_to_type(ctx, annot["args"][0]);
        }
        if len(annot["args"]) >= 2 {
            t2["err_type"] = _resolve_annot_to_type(ctx, annot["args"][1]);
        }
        return t2;
    }
    if base == "fn" {
        let tf = _make_type("fn");
        let pts = [];
        if annot["params"] != nil {
            let i = 0;
            while i < len(annot["params"]) {
                push(pts, _resolve_annot_to_type(ctx, annot["params"][i]));
                i = i + 1;
            }
        }
        tf["params"] = pts;
        tf["ret_type"] = if annot["ret"] != nil { _resolve_annot_to_type(ctx, annot["ret"]) } else { _make_type("any") };
        return tf;
    }
    if map_has(ctx["enums"], base) {
        let te = _make_type("enum");
        te["type_name"] = base;
        return te;
    }
    if map_has(ctx["structs"], base) {
        let ts = _make_type("struct");
        ts["type_name"] = base;
        return ts;
    }
    if map_has(ctx["classes"], base) {
        let tc = _make_type("class");
        tc["type_name"] = base;
        return tc;
    }
    if base == "num" or base == "int" or base == "string" or base == "bool" or base == "nil" or base == "array" or base == "map" or base == "bytes" or base == "f64buf" or base == "any" {
        return _make_type(base);
    }
    return _make_type("any");
}

fn _emit_diag(ctx, sev, code, msg_en, msg_el, line, col, end_col, sugg) {
    let ec = if end_col != nil and end_col > col { end_col } else { col + 1 };
    push(ctx["diagnostics"], map{
        severity: sev,
        code: code,
        message: msg_en,
        message_el: msg_el,
        line: line,
        col: col,
        end_line: line,
        end_col: ec,
        suggestion: sugg
    });
}

fn _record_hover_span(ctx, name, line, col, end_col, sym_entry) {
    if sym_entry == nil { return; }
    let t = sym_entry["type"];
    let unit_inf = nil;
    if t != nil and t["has_unit"] {
        unit_inf = map{
            unit_str: _canonical_unit_label(t["dim"], t["ccy"]),
            dim_unicode: _dim_unicode_rich(t["dim"], t["ccy"]),
            dim_ascii: UCC.dim_to_ascii(t["dim"]),
            named_quantity: UCC.dim_named_quantity(t["dim"])
        };
    }
    push(ctx["hover_spans"], map{
        name: name,
        kind: sym_entry["kind"],
        line: line,
        col: col,
        end_col: if end_col != nil and end_col > col { end_col } else { col + len(name) },
        type_str: _type_to_str(t),
        unit_info: unit_inf,
        doc: if map_has(sym_entry, "doc") { sym_entry["doc"] } else { "" },
        def_line: sym_entry["line"],
        def_col: sym_entry["col"],
        sym_ref: sym_entry
    });
}

fn _types_compatible_assign(expected_t, actual_t, strict_mode) {
    if expected_t == nil or actual_t == nil { return true; }
    let eb = expected_t["base"];
    let ab = actual_t["base"];
    if eb == "any" { return true; }
    if ab == "any" {
        // In gradual mode, `any` flows cleanly; in strict mode concrete return/var expects typed value unless nil-allowed
        return true;
    }
    if eb == "Option" {
        if ab == "nil" or ab == "Option" { return true; }
        if expected_t["elem_type"] != nil {
            return _types_compatible_assign(expected_t["elem_type"], actual_t, strict_mode);
        }
        return true;
    }
    if eb == "Result" and (ab == "Result" or ab == "map") { return true; }
    if (eb == "num" and ab == "int") or (eb == "int" and ab == "int") or (eb == "num" and ab == "num") {
        return true;
    }
    if strict_mode and eb == "int" and ab == "num" and actual_t["const_val"] == nil {
        return false;
    }
    return eb == ab;
}

fn _check_unit_match_pair(ctx, lt, rt, op_str, line, col) {
    // Allow comparison or addition with literal 0 (`0`, `0.0`) as additive identity of any dimensional vector space
    if lt["is_zero_lit"] == true and (rt["has_unit"] or not lt["has_unit"]) {
        return rt;
    }
    if rt["is_zero_lit"] == true and (lt["has_unit"] or not rt["has_unit"]) {
        return lt;
    }
    if not lt["has_unit"] and not rt["has_unit"] {
        return lt;
    }
    if not _units_compatible(lt, rt) {
        let u1 = if lt["has_unit"] { _canonical_unit_label(lt["dim"], lt["ccy"]) } else { "1 (dimensionless)" };
        let u2 = if rt["has_unit"] { _canonical_unit_label(rt["dim"], rt["ccy"]) } else { "1 (dimensionless)" };
        let d1 = _dim_unicode_rich(lt["dim"], lt["ccy"]);
        let d2 = _dim_unicode_rich(rt["dim"], rt["ccy"]);

        let ccy_hint_en = "";
        let ccy_hint_el = "";
        if UCC.dim_eq(lt["dim"], rt["dim"]) and not _ccy_eq(lt["ccy"], rt["ccy"]) {
            ccy_hint_en = " — explicit currency mismatch (" + u1 + " vs " + u2 + "); multiply by an explicit exchange rate num[" + u1 + "/" + u2 + "] first!";
            ccy_hint_el = " — ασυμβατότητα νομισμάτων (" + u1 + " έναντι " + u2 + ")· πολλαπλασιάστε πρώτα με ρητή ισοτιμία num[" + u1 + "/" + u2 + "]!";
        }
        let msg_en = "DIMENSIONAL_MISMATCH in '" + op_str + "': cannot combine " + _type_to_str(lt) + " " + d1 + " with " + _type_to_str(rt) + " " + d2 + ccy_hint_en
            + " | Ασυμβατότητα διαστάσεων SI/νομίσματος: αδύνατος ο συνδυασμός " + u1 + " " + d1 + " με " + u2 + " " + d2 + ccy_hint_el;
        let msg_el = "Ασυμβατότητα διαστάσεων SI/νομίσματος στον τελεστή '" + op_str + "': " + u1 + " " + d1 + " έναντι " + u2 + " " + d2 + ccy_hint_el;
        _emit_diag(ctx, "error", "DIMENSIONAL_MISMATCH", msg_en, msg_el, line, col, col + len(op_str), nil);
        return lt;
    }
    return lt;
}

fn _eval_const_rational_exp(node) {
    if node == nil { return nil; }
    if node["kind"] == "num" {
        let nv = parse_number(node["val"]);
        if nv == nil { return nil; }
        let fl = num_floor(nv);
        if nv == fl { return [fl, 1]; }
        if num_abs(nv - 0.5) < 1e-12 { return [1, 2]; }
        if num_abs(nv + 0.5) < 1e-12 { return [-1, 2]; }
        return nil;
    }
    if node["kind"] == "unary" and node["op"] == "-" {
        let sub = _eval_const_rational_exp(node["arg"]);
        if sub == nil { return nil; }
        return [0 - sub[0], sub[1]];
    }
    if node["kind"] == "binary" and node["op"] == "/" {
        let a = _eval_const_rational_exp(node["left"]);
        let b = _eval_const_rational_exp(node["right"]);
        if a != nil and b != nil and a[1] == 1 and b[1] == 1 and b[0] != 0 {
            return UCC.rat_make(a[0], b[0]);
        }
    }
    return nil;
}

// ── Pass 5: Compile-Time Quantum Wire / No-Cloning & Register Bounds Verification ──

fn _collect_mutated_idents_expr(node, out_map) {
    if node == nil { return; }
    let k = node["kind"];
    if k == "try_block_expr" {
        if node["try_block"] != nil { _collect_mutated_idents_stmts(node["try_block"]["stmts"], out_map); }
        if node["catch_block"] != nil { _collect_mutated_idents_stmts(node["catch_block"]["stmts"], out_map); }
        return;
    }
    if k == "if_stmt" {
        _collect_mutated_idents_expr(node["cond"], out_map);
        if node["then_block"] != nil { _collect_mutated_idents_stmts(node["then_block"]["stmts"], out_map); }
        if node["else_block"] != nil {
            if node["else_block"]["kind"] == "block" {
                _collect_mutated_idents_stmts(node["else_block"]["stmts"], out_map);
            } else {
                _collect_mutated_idents_expr(node["else_block"], out_map);
            }
        }
        return;
    }
    if k == "match_stmt" {
        _collect_mutated_idents_expr(node["target"], out_map);
        let i = 0;
        while i < len(node["arms"]) {
            let arm = node["arms"][i];
            if arm["body"] != nil and arm["body"]["kind"] == "block" {
                _collect_mutated_idents_stmts(arm["body"]["stmts"], out_map);
            } else {
                _collect_mutated_idents_expr(arm["body"], out_map);
            }
            i = i + 1;
        }
        return;
    }
    if k == "comptime_expr" {
        if node["expr"] != nil { _collect_mutated_idents_expr(node["expr"], out_map); }
        if node["block"] != nil { _collect_mutated_idents_stmts(node["block"]["stmts"], out_map); }
        return;
    }
    if k == "str" and node["is_fstr"] and node["interps"] != nil {
        let i = 0;
        while i < len(node["interps"]) {
            _collect_mutated_idents_stmts(node["interps"][i]["stmts"], out_map);
            i = i + 1;
        }
    }
}

fn _collect_mutated_idents_stmts(stmts, out_map) {
    if stmts == nil { return; }
    let i = 0;
    while i < len(stmts) {
        let s = stmts[i];
        let sk = s["kind"];
        if sk == "assign" {
            let tgt = s["target"];
            if tgt != nil and tgt["kind"] == "ident" {
                out_map[tgt["name"]] = true;
            }
            _collect_mutated_idents_expr(s["val"], out_map);
        } elif sk == "var_decl" or sk == "destruct_decl" {
            if s["init"] != nil { _collect_mutated_idents_expr(s["init"], out_map); }
        } elif sk == "if_stmt" or sk == "match_stmt" or sk == "try_block_expr" {
            _collect_mutated_idents_expr(s, out_map);
        } elif sk == "while_stmt" {
            _collect_mutated_idents_expr(s["cond"], out_map);
            if s["body"] != nil { _collect_mutated_idents_stmts(s["body"]["stmts"], out_map); }
        } elif sk == "loop_stmt" {
            if s["body"] != nil { _collect_mutated_idents_stmts(s["body"]["stmts"], out_map); }
        } elif sk == "for_stmt" {
            if s["var1"] != nil { out_map[s["var1"]["val"]] = true; }
            if s["var2"] != nil { out_map[s["var2"]["val"]] = true; }
            if s["body"] != nil { _collect_mutated_idents_stmts(s["body"]["stmts"], out_map); }
        } elif sk == "switch_stmt" {
            let ci = 0;
            while ci < len(s["cases"]) {
                _collect_mutated_idents_stmts(s["cases"][ci]["stmts"], out_map);
                ci = ci + 1;
            }
        } elif sk == "defer_stmt" {
            if s["body"] != nil {
                if s["body"]["kind"] == "block" {
                    _collect_mutated_idents_stmts(s["body"]["stmts"], out_map);
                } else {
                    _collect_mutated_idents_stmts([s["body"]], out_map);
                }
            }
        } elif sk == "block" {
            _collect_mutated_idents_stmts(s["stmts"], out_map);
        } elif sk == "expr_stmt" {
            _collect_mutated_idents_expr(s["expr"], out_map);
        } elif sk == "return_stmt" or sk == "throw_stmt" {
            if s["val"] != nil { _collect_mutated_idents_expr(s["val"], out_map); }
        }
        i = i + 1;
    }
}

fn _is_ident_ssa_immutable(scope, nm, sym) {
    if sym == nil { return false; }
    if sym["is_const"] == true { return true; }
    if sym["kind"] == "param" { return false; }
    let cur = scope;
    while cur != nil {
        if map_has(cur, "mutated_vars") and cur["mutated_vars"] != nil {
            return not map_has(cur["mutated_vars"], nm);
        }
        cur = cur["parent"];
    }
    return false;
}

fn _eval_quantum_const_num(scope, node) {
    if node == nil { return map{ known: false, val: 0, is_int: false }; }
    let k = node["kind"];
    if k == "num" {
        let nv = parse_number(node["val"]);
        if nv == nil { return map{ known: false, val: 0, is_int: false }; }
        let is_i = str_index_of(node["val"], ".") < 0 and str_index_of(node["val"], "e") < 0 and str_index_of(node["val"], "E") < 0 and nv == num_floor(nv);
        return map{ known: true, val: nv, is_int: is_i };
    }
    if k == "ident" {
        let nm = node["name"];
        let sym = _scope_lookup(scope, nm);
        if sym != nil and sym["type"] != nil and sym["type"]["const_val"] != nil and _is_ident_ssa_immutable(scope, nm, sym) {
            let cv = sym["type"]["const_val"];
            let is_i2 = sym["type"]["base"] == "int" and cv == num_floor(cv);
            return map{ known: true, val: cv, is_int: is_i2 };
        }
        return map{ known: false, val: 0, is_int: false };
    }
    if k == "unary" and (node["op"] == "-" or node["op"] == "+") {
        let sub = _eval_quantum_const_num(scope, node["arg"]);
        if not sub["known"] { return sub; }
        let v = if node["op"] == "-" { 0 - sub["val"] } else { sub["val"] };
        return map{ known: true, val: v, is_int: sub["is_int"] };
    }
    if k == "binary" and (node["op"] == "+" or node["op"] == "-" or node["op"] == "*") {
        let lv = _eval_quantum_const_num(scope, node["left"]);
        let rv = _eval_quantum_const_num(scope, node["right"]);
        if lv["known"] and rv["known"] {
            let bop = node["op"];
            let out_v = if bop == "+" { lv["val"] + rv["val"] } elif bop == "-" { lv["val"] - rv["val"] } else { lv["val"] * rv["val"] };
            return map{ known: true, val: out_v, is_int: lv["is_int"] and rv["is_int"] };
        }
    }
    return map{ known: false, val: 0, is_int: false };
}

fn _quantum_wire_key(scope, node) {
    if node == nil { return ""; }
    let cinfo = _eval_quantum_const_num(scope, node);
    if cinfo["known"] and cinfo["is_int"] {
        return "const:" + str(num_floor(cinfo["val"]));
    }
    let k = node["kind"];
    if k == "ident" {
        return "id:" + node["name"];
    }
    if k == "unary" and (node["op"] == "-" or node["op"] == "+") {
        let sk = _quantum_wire_key(scope, node["arg"]);
        if sk == "" { return ""; }
        return if node["op"] == "+" { sk } else { "un:-(" + sk + ")" };
    }
    if k == "binary" and (node["op"] == "+" or node["op"] == "-" or node["op"] == "*" or node["op"] == "/" or node["op"] == "%") {
        let lk = _quantum_wire_key(scope, node["left"]);
        let rk = _quantum_wire_key(scope, node["right"]);
        if lk == "" or rk == "" { return ""; }
        let bop = node["op"];
        if (bop == "+" or bop == "*") and rk < lk {
            return "bin:" + bop + "(" + rk + "," + lk + ")";
        }
        return "bin:" + bop + "(" + lk + "," + rk + ")";
    }
    if k == "member" {
        let ok = _quantum_wire_key(scope, node["obj"]);
        if ok == "" { return ""; }
        return "mem:" + ok + "." + node["field"];
    }
    if k == "index" {
        let ok2 = _quantum_wire_key(scope, node["obj"]);
        let ik = _quantum_wire_key(scope, node["index"]);
        if ok2 == "" or ik == "" { return ""; }
        return "idx:" + ok2 + "[" + ik + "]";
    }
    return "";
}

fn _quantum_wire_display(node) {
    if node == nil { return "?"; }
    let k = node["kind"];
    if k == "num" { return node["val"]; }
    if k == "ident" { return node["name"]; }
    if k == "unary" { return node["op"] + _quantum_wire_display(node["arg"]); }
    if k == "binary" { return _quantum_wire_display(node["left"]) + " " + node["op"] + " " + _quantum_wire_display(node["right"]); }
    if k == "member" { return _quantum_wire_display(node["obj"]) + "." + node["field"]; }
    if k == "index" { return _quantum_wire_display(node["obj"]) + "[" + _quantum_wire_display(node["index"]) + "]"; }
    return "<expr>";
}

fn _quantum_gate_wire_mode(fn_name) {
    if fn_name == "h" or fn_name == "x" or fn_name == "sx" or fn_name == "y" or fn_name == "z"
        or fn_name == "s" or fn_name == "sdg" or fn_name == "t" or fn_name == "tdg"
        or fn_name == "rx" or fn_name == "ry" or fn_name == "rz"
        or fn_name == "u1" or fn_name == "u2" or fn_name == "u3" or fn_name == "p" or fn_name == "phase"
        or fn_name == "gpi" or fn_name == "gpi2" or fn_name == "phased_xz" or fn_name == "measure_qubit" {
        return "1q";
    }
    if fn_name == "cnot" or fn_name == "cx" or fn_name == "cz" or fn_name == "swap" or fn_name == "iswap"
        or fn_name == "cp" or fn_name == "cphase" or fn_name == "crx" or fn_name == "cry" or fn_name == "crz"
        or fn_name == "rxx" or fn_name == "ryy" or fn_name == "rzz" or fn_name == "ms" {
        return "2q";
    }
    if fn_name == "toffoli" or fn_name == "ccx" or fn_name == "cswap" or fn_name == "fredkin" or fn_name == "ccz" {
        return "3q";
    }
    if fn_name == "mcz" or fn_name == "mcx" or fn_name == "mcp" {
        return "mc";
    }
    return "";
}

fn _check_quantum_call_pass5(ctx, scope, call_node, callee_node, callee_t, recv_type_override, raw_args, arg_types) {
    let fn_name = "";
    let is_q_mod = false;
    let full_raw = raw_args;
    let full_types = arg_types;

    if recv_type_override != nil {
        fn_name = call_node["method"];
        full_raw = [call_node["obj"]];
        let mi = 0;
        while mi < len(raw_args) { push(full_raw, raw_args[mi]); mi = mi + 1; }
        full_types = [recv_type_override];
        let ti = 0;
        while ti < len(arg_types) { push(full_types, arg_types[ti]); ti = ti + 1; }
    } elif callee_node != nil {
        if callee_node["kind"] == "ident" {
            fn_name = callee_node["name"];
        } elif callee_node["kind"] == "member" {
            fn_name = callee_node["field"];
            if callee_t != nil and map_has(callee_t, "owner_module_name") and callee_t["owner_module_name"] != nil {
                if str_contains(str_lower(callee_t["owner_module_name"]), "quantum") {
                    is_q_mod = true;
                }
            }
        }
    }

    if fn_name == "" { return nil; }

    // 1. Quantum circuit allocation: `new_circuit(N)` or `*.new_circuit(N)`
    if fn_name == "new_circuit" and len(full_raw) >= 1 {
        let n_arg = full_raw[0];
        let n_info = _eval_quantum_const_num(scope, n_arg);
        let valid_n = nil;
        if n_info["known"] {
            if (not n_info["is_int"]) or n_info["val"] < 1 or n_info["val"] > 156 {
                let n_lbl = str(n_info["val"]);
                _emit_diag(ctx, "error", "QUANTUM_INVALID_REGISTER_SIZE",
                    "QUANTUM_INVALID_REGISTER_SIZE: new_circuit(" + n_lbl + ") requires an integer qubit register size N in 1..156",
                    "Μη έγκυρο μέγεθος κβαντικού καταχωρητή στη new_circuit(" + n_lbl + "): απαιτείται ακέραιος αριθμός qubits N στο διάστημα 1..156",
                    n_arg["line"], n_arg["col"], n_arg["col"] + len(n_lbl), nil);
            } else {
                valid_n = num_floor(n_info["val"]);
            }
        }
        let qt = _make_type("map");
        qt["is_quantum_circuit"] = true;
        qt["quantum_n_qubits"] = valid_n;
        if map_has(ctx, "quantum_registers") {
            push(ctx["quantum_registers"], map{ line: call_node["line"], col: call_node["col"], n_qubits: valid_n });
        }
        return qt;
    }

    // 2. Quantum gate operations on a tracked circuit or quantum module
    let gmode = _quantum_gate_wire_mode(fn_name);
    if gmode == "" or len(full_types) < 2 {
        return nil;
    }
    let circ_t = full_types[0];
    let is_q_circ = circ_t != nil and map_has(circ_t, "is_quantum_circuit") and circ_t["is_quantum_circuit"] == true;
    if (not is_q_circ) and (not is_q_mod) {
        return nil;
    }

    let reg_n = if is_q_circ { circ_t["quantum_n_qubits"] } else { nil };
    let wire_nodes = [];
    if gmode == "1q" and len(full_raw) >= 2 {
        push(wire_nodes, full_raw[1]);
    } elif gmode == "2q" and len(full_raw) >= 3 {
        push(wire_nodes, full_raw[1]);
        push(wire_nodes, full_raw[2]);
    } elif gmode == "3q" and len(full_raw) >= 4 {
        push(wire_nodes, full_raw[1]);
        push(wire_nodes, full_raw[2]);
        push(wire_nodes, full_raw[3]);
    } elif gmode == "mc" and len(full_raw) >= 3 {
        let ctrl_arg = full_raw[1];
        if ctrl_arg["kind"] == "array_lit" {
            let ci = 0;
            while ci < len(ctrl_arg["items"]) {
                let it = ctrl_arg["items"][ci];
                if it["kind"] != "spread" {
                    push(wire_nodes, it);
                }
                ci = ci + 1;
            }
        }
        push(wire_nodes, full_raw[2]);
    }

    // 2a. Register wire bounds verification (`0 <= wire < N`)
    let wi = 0;
    while wi < len(wire_nodes) {
        let wn = wire_nodes[wi];
        if wn["kind"] != "spread" {
            let cval = _eval_quantum_const_num(scope, wn);
            if cval["known"] {
                let v = cval["val"];
                let bad_bounds = (not cval["is_int"]) or v < 0 or (reg_n != nil and v >= reg_n);
                if bad_bounds {
                    let w_lbl = str(v);
                    let rng_msg = if reg_n != nil {
                        " is out of bounds for " + str(reg_n) + "-qubit register (valid wires: 0.." + str(reg_n - 1) + ")"
                    } else {
                        " is invalid (qubit wire index must be a non-negative integer)"
                    };
                    let rng_el = if reg_n != nil {
                        " είναι εκτός ορίων για καταχωρητή " + str(reg_n) + " qubits (έγκυρα σύρματα: 0.." + str(reg_n - 1) + ")"
                    } else {
                        " δεν είναι έγκυρος μη-αρνητικός ακέραιος δείκτης qubit"
                    };
                    _emit_diag(ctx, "error", "QUANTUM_WIRE_OUT_OF_BOUNDS",
                        "QUANTUM_WIRE_OUT_OF_BOUNDS: gate '" + fn_name + "' wire index " + w_lbl + rng_msg,
                        "Εκτός ορίων κβαντικού καταχωρητή στην πύλη '" + fn_name + "': το σύρμα " + w_lbl + rng_el,
                        wn["line"], wn["col"], wn["col"] + len(w_lbl), nil);
                }
            }
        }
        wi = wi + 1;
    }

    // 2b. Linearity / No-Cloning Theorem verification (all multi-qubit gate wires must be distinct!)
    if gmode != "1q" and len(wire_nodes) >= 2 {
        let seen_wires = map{};
        let di = 0;
        while di < len(wire_nodes) {
            let dn = wire_nodes[di];
            if dn["kind"] != "spread" {
                let wkey = _quantum_wire_key(scope, dn);
                if wkey != "" {
                    let disp = _quantum_wire_display(dn);
                    if map_has(seen_wires, wkey) {
                        _emit_diag(ctx, "error", "QUANTUM_NO_CLONING_DUPLICATE_WIRE",
                            "QUANTUM_NO_CLONING_DUPLICATE_WIRE: multi-qubit gate '" + fn_name + "' uses duplicate quantum wire '" + disp + "' (violates quantum linearity / No-Cloning theorem)",
                            "Παραβίαση κβαντικής γραμμικότητας / θεωρήματος Μη-Κλωνοποίησης (No-Cloning): η πύλη '" + fn_name + "' χρησιμοποιεί διπλότυπο σύρμα qubit '" + disp + "'",
                            dn["line"], dn["col"], dn["col"] + len(disp), nil);
                    } else {
                        seen_wires[wkey] = disp;
                    }
                }
            }
            di = di + 1;
        }
    }

    if is_q_circ {
        return circ_t;
    }
    let q_ret = _make_type("map");
    q_ret["is_quantum_circuit"] = true;
    q_ret["quantum_n_qubits"] = reg_n;
    return q_ret;
}

fn _analyze_expr(ctx, scope, node) {
    if node == nil { return _make_type("nil"); }
    let k = node["kind"];

    if k == "num" {
        let nv = parse_number(node["val"]);
        let is_int_lit = str_index_of(node["val"], ".") < 0 and str_index_of(node["val"], "e") < 0 and str_index_of(node["val"], "E") < 0;
        let t = _make_type(if is_int_lit { "int" } else { "num" });
        t["const_val"] = nv;
        t["is_zero_lit"] = nv != nil and nv == 0;
        return t;
    }
    if k == "str" {
        if node["is_fstr"] and node["interps"] != nil {
            let i = 0;
            while i < len(node["interps"]) {
                _analyze_block_stmts(ctx, scope, node["interps"][i]["stmts"], nil);
                i = i + 1;
            }
        }
        return _make_type("string");
    }
    if k == "bool" { return _make_type("bool"); }
    if k == "nil" { return _make_type("nil"); }
    if k == "polyglot" { return _make_type("any"); }

    if k == "ident" {
        let nm = node["name"];
        let sym = _scope_lookup(scope, nm);
        if sym != nil {
            _record_hover_span(ctx, nm, node["line"], node["col"], node["end_col"], sym);
            return sym["type"];
        }
        let bspecs = _get_builtin_specs();
        if map_has(bspecs, nm) {
            let bs = bspecs[nm];
            let bt = _make_type("fn");
            bt["ret_type"] = _make_type(bs["ret_base"]);
            return bt;
        }
        let cands = _scope_all_names(scope, bspecs);
        let sugg = suggest_symbol(nm, cands);
        let msg_en = if sugg != nil {
            "Undefined symbol '" + nm + "' — did you mean '" + sugg + "'?"
        } else {
            "Undefined symbol '" + nm + "'"
        };
        let msg_el = if sugg != nil {
            "Μη ορισμένο σύμβολο '" + nm + "' — μήπως εννοούσατε '" + sugg + "';"
        } else {
            "Μη ορισμένο σύμβολο '" + nm + "'"
        };
        _emit_diag(ctx, "error", "UNDEFINED_SYMBOL", msg_en, msg_el, node["line"], node["col"], node["end_col"], sugg);
        return _make_type("any");
    }

    if k == "import_expr" {
        let arg_t = _analyze_expr(ctx, scope, node["arg"]);
        if node["arg"]["kind"] == "str" {
            let mod_info = _inspect_module_exports(node["arg"]["val"], ctx["base_dir"]);
            let mt = _make_type("module");
            mt["module_info"] = mod_info;
            mt["type_name"] = node["arg"]["val"];
            return mt;
        }
        return _make_type("module");
    }

    if k == "comptime_expr" {
        if node["expr"] != nil { return _analyze_expr(ctx, scope, node["expr"]); }
        if node["block"] != nil { return _analyze_block(ctx, scope, node["block"], nil); }
        return _make_type("any");
    }

    if k == "array_lit" {
        let elem_t = nil;
        let i = 0;
        while i < len(node["items"]) {
            let it = node["items"][i];
            let sub_t = if it["kind"] == "spread" { _analyze_expr(ctx, scope, it["arg"]) } else { _analyze_expr(ctx, scope, it) };
            if elem_t == nil { elem_t = sub_t; }
            i = i + 1;
        }
        let at = _make_type("array");
        at["elem_type"] = elem_t;
        return at;
    }

    if k == "map_lit" {
        let i = 0;
        while i < len(node["entries"]) {
            _analyze_expr(ctx, scope, node["entries"][i]["key"]);
            _analyze_expr(ctx, scope, node["entries"][i]["val"]);
            i = i + 1;
        }
        return _make_type("map");
    }

    if k == "member" {
        let obj_t = _analyze_expr(ctx, scope, node["obj"]);
        let fld = node["field"];
        if obj_t["base"] == "enum" and map_has(ctx["enums"], obj_t["type_name"]) {
            let vars = ctx["enums"][obj_t["type_name"]];
            if not _sc_arr_contains(vars, fld) {
                let vsugg = suggest_symbol(fld, vars);
                _emit_diag(ctx, "error", "UNKNOWN_ENUM_VARIANT",
                    "Enum '" + obj_t["type_name"] + "' has no variant '" + fld + "'" + (if vsugg != nil { " — did you mean '" + vsugg + "'?" } else { "" }),
                    "Το enum '" + obj_t["type_name"] + "' δεν διαθέτει παραλλαγή '" + fld + "'",
                    node["line"], node["col"], node["end_col"], vsugg);
            }
            return obj_t;
        }
        if obj_t["base"] == "module" and map_has(obj_t, "module_info") and obj_t["module_info"] != nil and obj_t["module_info"]["ok"] {
            let exps = obj_t["module_info"]["exports"];
            if len(map_keys(exps)) > 0 and not map_has(exps, fld) {
                let msugg = suggest_symbol(fld, map_keys(exps));
                _emit_diag(ctx, "error", "UNKNOWN_MODULE_EXPORT",
                    "Module '" + obj_t["type_name"] + "' does not export '" + fld + "'" + (if msugg != nil { " — did you mean '" + msugg + "'?" } else { "" }),
                    "Η μονάδα '" + obj_t["type_name"] + "' δεν εξάγει το '" + fld + "'",
                    node["line"], node["col"], node["end_col"], msugg);
                return _make_type("any");
            }
            if map_has(exps, fld) {
                let ei = exps[fld];
                if ei["kind"] == "fn" {
                    let ft = _make_type("fn");
                    ft["min_args"] = ei["min_args"];
                    ft["max_args"] = ei["max_args"];
                    ft["has_rest"] = ei["has_rest"];
                    ft["ret_type"] = _make_type("any");
                    ft["owner_module_name"] = obj_t["type_name"];
                    return ft;
                }
            }
        }
        if obj_t["base"] == "module" {
            let m_any = _make_type("any");
            m_any["owner_module_name"] = obj_t["type_name"];
            return m_any;
        }
        return _make_type("any");
    }

    if k == "index" {
        let obj_t = _analyze_expr(ctx, scope, node["obj"]);
        let idx_t = _analyze_expr(ctx, scope, node["index"]);
        if obj_t["base"] == "array" and obj_t["elem_type"] != nil {
            return obj_t["elem_type"];
        }
        if obj_t["base"] == "string" { return _make_type("string"); }
        if obj_t["base"] == "f64buf" { return _make_type("num"); }
        if obj_t["base"] == "bytes" { return _make_type("int"); }
        return _make_type("any");
    }

    if k == "slice_expr" {
        let obj_t = _analyze_expr(ctx, scope, node["obj"]);
        if node["start"] != nil { _analyze_expr(ctx, scope, node["start"]); }
        if node["stop"] != nil { _analyze_expr(ctx, scope, node["stop"]); }
        return obj_t;
    }

    if k == "method_call" {
        let recv_t = _analyze_expr(ctx, scope, node["obj"]);
        let m_arg_types = [];
        let i = 0;
        while i < len(node["args"]) {
            push(m_arg_types, _analyze_expr(ctx, scope, node["args"][i]));
            i = i + 1;
        }
        let q_mret = _check_quantum_call_pass5(ctx, scope, node, nil, nil, recv_t, node["args"], m_arg_types);
        if q_mret != nil { return q_mret; }
        return _make_type("any");
    }

    if k == "call" {
        let callee_node = node["callee"];
        let callee_t = _analyze_expr(ctx, scope, callee_node);
        let arg_types = [];
        let has_spread_arg = false;
        let i = 0;
        while i < len(node["args"]) {
            let an = node["args"][i];
            if an["kind"] == "spread" {
                has_spread_arg = true;
                push(arg_types, _analyze_expr(ctx, scope, an["arg"]));
            } else {
                push(arg_types, _analyze_expr(ctx, scope, an));
            }
            i = i + 1;
        }
        let argc = len(arg_types);

        // Pass 2: Check calling a concrete non-function value!
        let cb = callee_t["base"];
        if cb != "fn" and cb != "any" and cb != "class" and cb != "struct" and cb != "module" {
            _emit_diag(ctx, "error", "NOT_CALLABLE",
                "Cannot call value of non-function type '" + _type_to_str(callee_t) + "'",
                "Αδύνατη η κλήση τιμής μη-συναρτησιακού τύπου '" + _type_to_str(callee_t) + "'",
                node["line"], node["col"], node["col"] + 1, nil);
            return _make_type("any");
        }

        // Check builtin arity + transcendental SI unit rules!
        if callee_node["kind"] == "ident" {
            let fnm = callee_node["name"];
            let bspecs = _get_builtin_specs();
            if _scope_lookup(scope, fnm) == nil and map_has(bspecs, fnm) {
                let bs = bspecs[fnm];
                if not has_spread_arg {
                    if argc < bs["min_args"] or (not bs["has_rest"] and bs["max_args"] >= 0 and argc > bs["max_args"]) {
                        _emit_diag(ctx, "error", "ARITY_MISMATCH",
                            "Builtin '" + fnm + "' expects " + str(bs["min_args"]) + (if bs["max_args"] > bs["min_args"] { ".." + str(bs["max_args"]) } else { "" }) + " argument(s), got " + str(argc),
                            "Η ενσωματωμένη συνάρτηση '" + fnm + "' αναμένει " + str(bs["min_args"]) + " όρισμα(τα), δόθηκαν " + str(argc),
                            node["line"], node["col"], node["col"] + len(fnm), nil);
                    }
                }
                // Pass 3: Transcendental dimensionless guard (`sin(t)`, `exp(t)`, `ln(x)`)!
                if bs["is_transcendental"] and argc >= 1 and arg_types[0]["has_unit"] {
                    let at0 = arg_types[0];
                    let u_str = _canonical_unit_label(at0["dim"], at0["ccy"]);
                    let d_str = _dim_unicode_rich(at0["dim"], at0["ccy"]);
                    _emit_diag(ctx, "error", "TRANSCENDENTAL_NON_DIMENSIONLESS",
                        "TRANSCENDENTAL_NON_DIMENSIONLESS: '" + fnm + "(...)' requires a dimensionless argument [1], but got " + _type_to_str(at0) + " " + d_str
                            + " | Η υπερβατική συνάρτηση '" + fnm + "' απαιτεί αδιάστατο όρισμα [1], αλλά δόθηκε μέγεθος με μονάδα " + u_str + " " + d_str,
                        "Η υπερβατική συνάρτηση '" + fnm + "' απαιτεί αδιάστατο όρισμα [1], αλλά δόθηκε " + u_str + " " + d_str,
                        node["line"], node["col"], node["col"] + len(fnm), nil);
                }
                // Unit propagation through `sqrt`, `abs`, `pow`, `min`, `max`, `clamp`, `Some`, `Ok`, `Err`
                if (fnm == "sqrt" or fnm == "num_sqrt") and argc == 1 and arg_types[0]["has_unit"] {
                    return _make_unit_type("num", UCC.dim_pow(arg_types[0]["dim"], 1, 2), _ccy_pow(arg_types[0]["ccy"], 1, 2), "");
                }
                if (fnm == "abs" or fnm == "num_abs") and argc == 1 and arg_types[0]["has_unit"] {
                    return arg_types[0];
                }
                if (fnm == "min" or fnm == "num_min" or fnm == "max" or fnm == "num_max") and argc == 2 {
                    return _check_unit_match_pair(ctx, arg_types[0], arg_types[1], fnm, node["line"], node["col"]);
                }
                if (fnm == "pow" or fnm == "num_pow") and argc == 2 {
                    if arg_types[1]["has_unit"] {
                        _emit_diag(ctx, "error", "TRANSCENDENTAL_NON_DIMENSIONLESS",
                            "Exponent in '" + fnm + "' must be dimensionless [1], got " + _type_to_str(arg_types[1]),
                            "Ο εκθέτης στη '" + fnm + "' πρέπει να είναι αδιάστατος [1]",
                            node["line"], node["col"], node["col"] + len(fnm), nil);
                    }
                    if arg_types[0]["has_unit"] {
                        let rexp = _eval_const_rational_exp(node["args"][1]);
                        if rexp != nil {
                            return _make_unit_type("num", UCC.dim_pow(arg_types[0]["dim"], rexp[0], rexp[1]), _ccy_pow(arg_types[0]["ccy"], rexp[0], rexp[1]), "");
                        }
                    }
                }
                if fnm == "Some" and argc == 1 {
                    let ot = _make_type("Option");
                    ot["elem_type"] = arg_types[0];
                    return ot;
                }
                if fnm == "Ok" and argc == 1 {
                    let rt_ok = _make_type("Result");
                    rt_ok["ok_type"] = arg_types[0];
                    return rt_ok;
                }
                if fnm == "Err" and argc == 1 {
                    let rt_err = _make_type("Result");
                    rt_err["err_type"] = arg_types[0];
                    return rt_err;
                }
                return _make_type(bs["ret_base"]);
            }
        }

        // User-defined or imported function arity & parameter type/unit checking
        if cb == "fn" {
            let min_a = if map_has(callee_t, "min_args") and callee_t["min_args"] != nil { callee_t["min_args"] } else {
                if callee_t["params"] != nil { len(callee_t["params"]) } else { 0 }
            };
            let max_a = if map_has(callee_t, "max_args") and callee_t["max_args"] != nil { callee_t["max_args"] } else {
                if callee_t["params"] != nil { len(callee_t["params"]) } else { -1 }
            };
            let h_rest = if map_has(callee_t, "has_rest") and callee_t["has_rest"] == true { true } else { max_a < 0 };
            if not has_spread_arg {
                if argc < min_a or (not h_rest and max_a >= 0 and argc > max_a) {
                    let cname = if callee_node["kind"] == "ident" { callee_node["name"] } else { "function" };
                    _emit_diag(ctx, "error", "ARITY_MISMATCH",
                        "Function '" + cname + "' expects " + str(min_a) + (if max_a > min_a { ".." + str(max_a) } else { "" }) + " argument(s), got " + str(argc),
                        "Η συνάρτηση '" + cname + "' αναμένει " + str(min_a) + " όρισμα(τα), δόθηκαν " + str(argc),
                        node["line"], node["col"], node["col"] + 1, nil);
                }
            }
            if callee_t["params"] != nil {
                let pi = 0;
                while pi < argc and pi < len(callee_t["params"]) {
                    let p_exp = callee_t["params"][pi];
                    let p_act = arg_types[pi];
                    if not _types_compatible_assign(p_exp, p_act, ctx["strict"]) {
                        _emit_diag(ctx, "error", "TYPE_MISMATCH",
                            "Argument " + str(pi + 1) + " type mismatch: expected " + _type_to_str(p_exp) + ", got " + _type_to_str(p_act),
                            "Ασυμφωνία τύπου στο όρισμα " + str(pi + 1) + ": αναμενόταν " + _type_to_str(p_exp) + ", δόθηκε " + _type_to_str(p_act),
                            node["args"][pi]["line"], node["args"][pi]["col"], node["args"][pi]["col"] + 1, nil);
                    } elif _is_numeric_type(p_exp) and _is_numeric_type(p_act) and (p_exp["has_unit"] or p_act["has_unit"]) {
                        if not (p_act["is_zero_lit"] == true and p_exp["has_unit"]) and not _units_compatible(p_exp, p_act) {
                            _check_unit_match_pair(ctx, p_exp, p_act, "call arg " + str(pi + 1), node["args"][pi]["line"], node["args"][pi]["col"]);
                        }
                    }
                    pi = pi + 1;
                }
            }
        }

        // Pass 5: Compile-Time Quantum Wire / No-Cloning & Register Bounds Verification!
        let q_ret = _check_quantum_call_pass5(ctx, scope, node, callee_node, callee_t, nil, node["args"], arg_types);
        if q_ret != nil { return q_ret; }

        if cb == "fn" and callee_t["ret_type"] != nil { return callee_t["ret_type"]; }
        return _make_type("any");
    }

    if k == "unary" {
        let op = node["op"];
        let at = _analyze_expr(ctx, scope, node["arg"]);
        if op == "-" or op == "+" {
            if at["base"] != "any" and not _is_numeric_type(at) {
                _emit_diag(ctx, "error", "TYPE_MISMATCH",
                    "Unary operator '" + op + "' requires numeric operand, got '" + _type_to_str(at) + "'",
                    "Ο μοναδιαίος τελεστής '" + op + "' απαιτεί αριθμητικό τελεστέο, δόθηκε '" + _type_to_str(at) + "'",
                    node["line"], node["col"], node["col"] + 1, nil);
                return _make_type("num");
            }
            if op == "-" and at["const_val"] != nil {
                let nt = _sc_clone_map(at);
                nt["const_val"] = 0 - at["const_val"];
                return nt;
            }
            return at;
        }
        if op == "not" or op == "!" {
            return _make_type("bool");
        }
        return at;
    }

    if k == "binary" {
        let op = node["op"];
        let lt = _analyze_expr(ctx, scope, node["left"]);
        let rt = _analyze_expr(ctx, scope, node["right"]);
        let lb = lt["base"];
        let rb = rt["base"];

        if op == "and" or op == "or" {
            return _make_type("bool");
        }
        if op == "??" {
            return if lb != "nil" { lt } else { rt };
        }
        if op == "|>" {
            return _make_type("any");
        }

        // Relational & equality operators
        if op == "<" or op == "<=" or op == ">" or op == ">=" or op == "==" or op == "!=" {
            if op != "==" and op != "!=" {
                if lb != "any" and rb != "any" and not (_is_numeric_type(lt) and _is_numeric_type(rt)) and not (lb == "string" and rb == "string") {
                    _emit_diag(ctx, "error", "TYPE_MISMATCH",
                        "Cannot compare '" + _type_to_str(lt) + "' and '" + _type_to_str(rt) + "' with '" + op + "'",
                        "Αδύνατη η σύγκριση '" + _type_to_str(lt) + "' με '" + _type_to_str(rt) + "'",
                        node["line"], node["col"], node["col"] + len(op), nil);
                }
            }
            if _is_numeric_type(lt) and _is_numeric_type(rt) and (lt["has_unit"] or rt["has_unit"]) {
                _check_unit_match_pair(ctx, lt, rt, op, node["line"], node["col"]);
            }
            return _make_type("bool");
        }

        // Addition `+`
        if op == "+" {
            if lb == "string" or rb == "string" {
                if ctx["strict"] and lb != rb and lb != "any" and rb != "any" {
                    _emit_diag(ctx, "error", "TYPE_MISMATCH",
                        "Strict mode: implicit string concatenation '" + _type_to_str(lt) + " + " + _type_to_str(rt) + "' — wrap non-string in str(...)",
                        "Αυστηρή λειτουργία: έμμεση συνένωση συμβολοσειράς — χρησιμοποιήστε str(...)",
                        node["line"], node["col"], node["col"] + 1, "str");
                }
                return _make_type("string");
            }
            if lb == "any" or rb == "any" { return _make_type("any"); }
            if not _is_numeric_type(lt) or not _is_numeric_type(rt) {
                _emit_diag(ctx, "error", "TYPE_MISMATCH",
                    "Invalid operand types for '+': '" + _type_to_str(lt) + "' and '" + _type_to_str(rt) + "'",
                    "Μη έγκυροι τύποι τελεστέων για '+': '" + _type_to_str(lt) + "' και '" + _type_to_str(rt) + "'",
                    node["line"], node["col"], node["col"] + 1, nil);
                return _make_type("num");
            }
            let res_u = _check_unit_match_pair(ctx, lt, rt, "+", node["line"], node["col"]);
            let res_b = if lb == "int" and rb == "int" { "int" } else { "num" };
            if res_u["has_unit"] {
                return _make_unit_type(res_b, res_u["dim"], res_u["ccy"], res_u["unit_str"]);
            }
            return _make_type(res_b);
        }

        // Subtraction `-`
        if op == "-" {
            if lb == "any" or rb == "any" { return _make_type("num"); }
            if not _is_numeric_type(lt) or not _is_numeric_type(rt) {
                _emit_diag(ctx, "error", "TYPE_MISMATCH",
                    "Invalid operand types for '-': '" + _type_to_str(lt) + "' and '" + _type_to_str(rt) + "'",
                    "Μη έγκυροι τύποι τελεστέων για '-': '" + _type_to_str(lt) + "' και '" + _type_to_str(rt) + "'",
                    node["line"], node["col"], node["col"] + 1, nil);
                return _make_type("num");
            }
            let res_u2 = _check_unit_match_pair(ctx, lt, rt, "-", node["line"], node["col"]);
            let res_b2 = if lb == "int" and rb == "int" { "int" } else { "num" };
            if res_u2["has_unit"] {
                return _make_unit_type(res_b2, res_u2["dim"], res_u2["ccy"], res_u2["unit_str"]);
            }
            return _make_type(res_b2);
        }

        // Multiplication `*` & Division `/` & Modulo `%`
        if op == "*" or op == "/" or op == "%" {
            if lb != "any" and not _is_numeric_type(lt) {
                _emit_diag(ctx, "error", "TYPE_MISMATCH",
                    "Invalid left operand for '" + op + "': expected numeric type, got '" + _type_to_str(lt) + "'",
                    "Μη έγκυρος αριστερός τελεστέος για '" + op + "': δόθηκε '" + _type_to_str(lt) + "'",
                    node["line"], node["col"], node["col"] + 1, nil);
                return _make_type("num");
            }
            if rb != "any" and not _is_numeric_type(rt) {
                _emit_diag(ctx, "error", "TYPE_MISMATCH",
                    "Invalid right operand for '" + op + "': expected numeric type, got '" + _type_to_str(rt) + "'",
                    "Μη έγκυρος δεξιός τελεστέος για '" + op + "': δόθηκε '" + _type_to_str(rt) + "'",
                    node["line"], node["col"], node["col"] + 1, nil);
                return _make_type("num");
            }
            if op == "/" and rt["is_zero_lit"] == true {
                _emit_diag(ctx, "error", "DIVISION_BY_ZERO_REFUTED",
                    "Compile-time division by literal zero",
                    "Διαίρεση με το μηδέν κατά τη μεταγλώττιση",
                    node["line"], node["col"], node["col"] + 1, nil);
            }
            let res_b3 = if op != "/" and lb == "int" and rb == "int" { "int" } else { "num" };
            if lt["has_unit"] or rt["has_unit"] {
                if op == "*" {
                    let dm = UCC.dim_mul(lt["dim"], rt["dim"]);
                    let cm = _ccy_mul(lt["ccy"], rt["ccy"]);
                    return _make_unit_type(res_b3, dm, cm, "");
                }
                if op == "/" {
                    let dd = UCC.dim_div(lt["dim"], rt["dim"]);
                    let cd = _ccy_div(lt["ccy"], rt["ccy"]);
                    return _make_unit_type("num", dd, cd, "");
                }
                if op == "%" {
                    return lt;
                }
            }
            if lb == "any" or rb == "any" { return _make_type("num"); }
            return _make_type(res_b3);
        }

        // Power `**` or `^`
        if op == "**" or op == "^" {
            if (lb != "any" and not _is_numeric_type(lt)) or (rb != "any" and not _is_numeric_type(rt)) {
                _emit_diag(ctx, "error", "TYPE_MISMATCH",
                    "Invalid operand types for '" + op + "': '" + _type_to_str(lt) + "' and '" + _type_to_str(rt) + "'",
                    "Μη έγκυροι τύποι τελεστέων για '" + op + "'",
                    node["line"], node["col"], node["col"] + len(op), nil);
                return _make_type("num");
            }
            if rt["has_unit"] {
                _emit_diag(ctx, "error", "TRANSCENDENTAL_NON_DIMENSIONLESS",
                    "TRANSCENDENTAL_NON_DIMENSIONLESS: exponent in '" + op + "' must be dimensionless [1], got " + _type_to_str(rt),
                    "Ο εκθέτης στον τελεστή '" + op + "' πρέπει να είναι αδιάστατος [1]",
                    node["line"], node["col"], node["col"] + len(op), nil);
                return _make_type("num");
            }
            if lt["has_unit"] {
                let rexp = _eval_const_rational_exp(node["right"]);
                if rexp == nil {
                    _emit_diag(ctx, "error", "DIMENSIONAL_MISMATCH",
                        "Dimensional quantity " + _type_to_str(lt) + " can only be raised to a compile-time rational constant exponent",
                        "Διαστατικό μέγεθος " + _type_to_str(lt) + " απαιτεί σταθερό ρητό εκθέτη κατά τη μεταγλώττιση",
                        node["line"], node["col"], node["col"] + len(op), nil);
                    return _make_type("num");
                }
                let dp = UCC.dim_pow(lt["dim"], rexp[0], rexp[1]);
                let cp = _ccy_pow(lt["ccy"], rexp[0], rexp[1]);
                return _make_unit_type("num", dp, cp, "");
            }
            let res_b4 = if lb == "int" and rb == "int" and op == "^" { "int" } else { "num" };
            return _make_type(res_b4);
        }

        return _make_type("num");
    }

    if k == "fn_expr" {
        return _analyze_fn_node(ctx, scope, node);
    }

    if k == "if_expr" {
        _analyze_expr(ctx, scope, node["cond"]);
        let tt = _analyze_expr(ctx, scope, node["then_expr"]);
        let et = _analyze_expr(ctx, scope, node["else_expr"]);
        if _is_numeric_type(tt) and _is_numeric_type(et) and (tt["has_unit"] or et["has_unit"]) {
            return _check_unit_match_pair(ctx, tt, et, "if/else", node["line"], node["col"]);
        }
        return tt;
    }

    if k == "if_stmt" {
        return _analyze_if_stmt(ctx, scope, node, nil)["expr_type"];
    }

    if k == "match_stmt" {
        return _analyze_match(ctx, scope, node, nil)["expr_type"];
    }

    if k == "try_expr" {
        let tt2 = _analyze_expr(ctx, scope, node["expr"]);
        if node["fallback"] != nil { _analyze_expr(ctx, scope, node["fallback"]); }
        return tt2;
    }

    if k == "try_block_expr" {
        let tr_t = _analyze_block(ctx, scope, node["try_block"], nil);
        if node["catch_block"] != nil {
            let cscope = _new_scope(scope);
            if node["catch_var"] != "" {
                cscope["vars"][node["catch_var"]] = map{ name: node["catch_var"], kind: "var", is_const: false, type: _make_type("string"), line: node["line"], col: node["col"], doc: "" };
            }
            _analyze_block(ctx, cscope, node["catch_block"], nil);
        }
        return tr_t;
    }

    if k == "try_prop" {
        return _analyze_expr(ctx, scope, node["arg"]);
    }

    return _make_type("any");
}

fn _analyze_if_stmt(ctx, scope, node, expected_ret) {
    _analyze_expr(ctx, scope, node["cond"]);
    let tb_info = _analyze_block_full(ctx, scope, node["then_block"], expected_ret);
    let eb_term = false;
    let eb_type = _make_type("nil");
    if node["else_block"] != nil {
        if node["else_block"]["kind"] == "block" {
            let eb_info = _analyze_block_full(ctx, scope, node["else_block"], expected_ret);
            eb_term = eb_info["terminates"];
            eb_type = eb_info["expr_type"];
        } else {
            let sub_if = _analyze_if_stmt(ctx, scope, node["else_block"], expected_ret);
            eb_term = sub_if["terminates"];
            eb_type = sub_if["expr_type"];
        }
    }
    return map{
        terminates: tb_info["terminates"] and eb_term,
        expr_type: tb_info["expr_type"]
    };
}

fn _analyze_match(ctx, scope, node, expected_ret) {
    let target_t = _analyze_expr(ctx, scope, node["target"]);
    let has_wildcard = false;
    let covered_variants = [];
    let inferred_enum = if target_t["base"] == "enum" { target_t["type_name"] } else { "" };

    let all_term = len(node["arms"]) > 0;
    let first_arm_t = _make_type("any");

    let i = 0;
    while i < len(node["arms"]) {
        let arm = node["arms"][i];
        let ascope = _new_scope(scope);
        let pi = 0;
        while pi < len(arm["patterns"]) {
            let pat = arm["patterns"][pi];
            let pk = pat["kind"];
            if pk == "wildcard" {
                if arm["guard"] == nil { has_wildcard = true; }
            } elif pk == "enum_pat" {
                if inferred_enum == "" and map_has(ctx["enums"], pat["enum_name"]) {
                    inferred_enum = pat["enum_name"];
                }
                if arm["guard"] == nil {
                    _sc_arr_push_unique(covered_variants, pat["variant"]);
                }
                let bi = 0;
                while bi < len(pat["bindings"]) {
                    let bnm = pat["bindings"][bi];
                    ascope["vars"][bnm] = map{ name: bnm, kind: "var", is_const: false, type: _make_type("any"), line: pat["line"], col: pat["col"], doc: "" };
                    bi = bi + 1;
                }
            } elif pk == "ctor_pat" {
                let bi2 = 0;
                while bi2 < len(pat["bindings"]) {
                    let bnm2 = pat["bindings"][bi2];
                    ascope["vars"][bnm2] = map{ name: bnm2, kind: "var", is_const: false, type: _make_type("any"), line: pat["line"], col: pat["col"], doc: "" };
                    bi2 = bi2 + 1;
                }
            } elif pk == "ident_pat" {
                let nm = pat["name"];
                if inferred_enum != "" and map_has(ctx["enums"], inferred_enum) and _sc_arr_contains(ctx["enums"][inferred_enum], nm) {
                    if arm["guard"] == nil { _sc_arr_push_unique(covered_variants, nm); }
                } else {
                    if arm["guard"] == nil { has_wildcard = true; }
                    ascope["vars"][nm] = map{ name: nm, kind: "var", is_const: false, type: target_t, line: pat["line"], col: pat["col"], doc: "" };
                }
            } elif pk == "lit_pat" {
                _analyze_expr(ctx, ascope, pat["expr"]);
            }
            pi = pi + 1;
        }
        if arm["guard"] != nil {
            _analyze_expr(ctx, ascope, arm["guard"]);
        }
        let arm_t = nil;
        let arm_term = false;
        if arm["body"]["kind"] == "block" {
            let b_inf = _analyze_block_full(ctx, ascope, arm["body"], expected_ret);
            arm_t = b_inf["expr_type"];
            arm_term = b_inf["terminates"];
        } else {
            arm_t = _analyze_expr(ctx, ascope, arm["body"]);
        }
        if i == 0 and arm_t != nil { first_arm_t = arm_t; }
        if not arm_term { all_term = false; }
        i = i + 1;
    }

    // Pass 1: Non-exhaustive enum match check!
    if inferred_enum != "" and map_has(ctx["enums"], inferred_enum) and not has_wildcard {
        let all_vars = ctx["enums"][inferred_enum];
        let missing = [];
        let vi = 0;
        while vi < len(all_vars) {
            if not _sc_arr_contains(covered_variants, all_vars[vi]) {
                push(missing, all_vars[vi]);
            }
            vi = vi + 1;
        }
        if len(missing) > 0 {
            _emit_diag(ctx, "error", "NON_EXHAUSTIVE_MATCH",
                "Non-exhaustive match on enum '" + inferred_enum + "': missing variant(s) " + str_join(missing, ", ") + " (or '_' / 'else' arm)",
                "Μη εξαντλητικό match στο enum '" + inferred_enum + "': λείπουν οι παραλλαγές " + str_join(missing, ", "),
                node["line"], node["col"], node["col"] + 5, "_");
        }
    }

    return map{ terminates: all_term and has_wildcard, expr_type: first_arm_t };
}

fn _predeclare_block_hoisted(ctx, scope, stmts, is_top) {
    let i = 0;
    while i < len(stmts) {
        let s = stmts[i];
        let sk = s["kind"];
        if sk == "enum_decl" {
            ctx["enums"][s["name"]] = s["variants"];
            let et = _make_type("enum");
            et["type_name"] = s["name"];
            let entry = map{
                name: s["name"], kind: "enum", is_const: true, type: et,
                variants: s["variants"], line: s["line"], col: s["col"], end_line: s["end_line"], doc: s["doc"]
            };
            scope["vars"][s["name"]] = entry;
            if is_top { push(ctx["symbols"], entry); ctx["symbol_map"][s["name"]] = entry; }
        } elif sk == "struct_decl" {
            ctx["structs"][s["name"]] = s["fields"];
            let st_t = _make_type("struct");
            st_t["type_name"] = s["name"];
            let entry2 = map{
                name: s["name"], kind: "struct", is_const: true, type: st_t,
                line: s["line"], col: s["col"], end_line: s["end_line"], doc: s["doc"]
            };
            scope["vars"][s["name"]] = entry2;
            if is_top { push(ctx["symbols"], entry2); ctx["symbol_map"][s["name"]] = entry2; }
        } elif sk == "class_decl" {
            ctx["classes"][s["name"]] = s["members"];
            let cl_t = _make_type("class");
            cl_t["type_name"] = s["name"];
            let entry3 = map{
                name: s["name"], kind: "class", is_const: true, type: cl_t,
                line: s["line"], col: s["col"], end_line: s["end_line"], doc: s["doc"]
            };
            scope["vars"][s["name"]] = entry3;
            if is_top { push(ctx["symbols"], entry3); ctx["symbol_map"][s["name"]] = entry3; }
        }
        i = i + 1;
    }

    // Second pass in same block: predeclare `fn` signatures (after enums/structs are registered!)
    i = 0;
    while i < len(stmts) {
        let s = stmts[i];
        if s["kind"] == "fn_decl" {
            let ptypes = [];
            let req_cnt = 0;
            let pi = 0;
            while pi < len(s["params"]) {
                let p = s["params"][pi];
                push(ptypes, _resolve_annot_to_type(ctx, p["annot"]));
                if p["default_expr"] == nil and not p["is_rest"] {
                    req_cnt = req_cnt + 1;
                }
                pi = pi + 1;
            }
            let rt = if s["ret_annot"] != nil { _resolve_annot_to_type(ctx, s["ret_annot"]) } else { _make_type("any") };
            let ft = _make_type("fn");
            ft["params"] = ptypes;
            ft["ret_type"] = rt;
            ft["min_args"] = req_cnt;
            ft["max_args"] = if s["has_rest"] { -1 } else { len(s["params"]) };
            ft["has_rest"] = s["has_rest"];

            let fentry = map{
                name: s["name"],
                kind: "fn",
                is_const: true,
                type: ft,
                params: s["params"],
                min_args: req_cnt,
                max_args: ft["max_args"],
                has_rest: s["has_rest"],
                line: s["line"],
                col: s["col"],
                end_col: s["end_col"],
                end_line: s["end_line"],
                doc: s["doc"],
                contract_status: "NONE",
                contract_proofs: []
            };
            scope["vars"][s["name"]] = fentry;
            if is_top {
                push(ctx["symbols"], fentry);
                ctx["symbol_map"][s["name"]] = fentry;
            }
        }
        i = i + 1;
    }
}

fn _verify_fn_contracts_and_divisions(ctx, fn_node, fentry, ptypes, ret_t) {
    let has_contracts = len(fn_node["requires_list"]) > 0 or len(fn_node["ensures_list"]) > 0;
    // Also check division-by-zero inside numeric-annotated functions!
    let all_params_annotated_num = len(ptypes) > 0;
    let all_int = len(ptypes) > 0 and (ret_t["base"] == "int" or ret_t["base"] == "any");
    let param_names = [];
    let pi = 0;
    while pi < len(fn_node["params"]) {
        let p = fn_node["params"][pi];
        push(param_names, p["name"]);
        if not _is_numeric_type(ptypes[pi]) {
            all_params_annotated_num = false;
            all_int = false;
        } elif ptypes[pi]["base"] != "int" {
            all_int = false;
        }
        pi = pi + 1;
    }
    if not has_contracts and not all_params_annotated_num {
        return;
    }

    // Build combined precondition FOL string
    let pre_parts = [];
    let ri = 0;
    while ri < len(fn_node["requires_list"]) {
        push(pre_parts, _ast_expr_to_fol(fn_node["requires_list"][ri]["expr"], nil, all_int));
        ri = ri + 1;
    }
    let pre_fol = if len(pre_parts) == 0 { "true" } else { "(" + str_join(pre_parts, " and ") + ")" };

    // Extract symbolic return paths & division denominators from body
    let body_stmts = [];
    let bi = 0;
    while bi < len(fn_node["body"]["stmts"]) {
        push(body_stmts, fn_node["body"]["stmts"][bi]);
        bi = bi + 1;
    }
    if fn_node["body"]["tail_expr"] != nil {
        push(body_stmts, map{ kind: "return_stmt", val: fn_node["body"]["tail_expr"], line: fn_node["line"], col: fn_node["col"] });
    }

    let ret_paths = [];
    let divs = [];
    _extract_symbolic_paths(body_stmts, 0, map{}, [], all_int, ret_paths, divs);

    let q_prefix = if len(param_names) > 0 { "forall " + str_join(param_names, ", ") + ": " } else { "" };
    let proofs_for_fn = [];
    let any_refuted = false;
    let any_proved = false;

    // 1. Verify division-by-zero safety obligations (`pre -> den != 0`)
    let di = 0;
    while di < len(divs) {
        let dv = divs[di];
        let div_formula = q_prefix + "(" + pre_fol + " -> ((" + dv["den_fol"] + ") != 0))";
        let prf_d = prove_formula_auto(div_formula, all_int);
        prf_d["fn_name"] = fn_node["name"];
        prf_d["kind"] = "division_safety";
        prf_d["line"] = dv["line"];
        prf_d["col"] = dv["col"];
        push(ctx["contracts"], prf_d);
        push(proofs_for_fn, prf_d);

        if prf_d["status"] == "REFUTED_COUNTEREXAMPLE" {
            any_refuted = true;
            let wsum = prf_d["witness_summary"];
            _emit_diag(ctx, "error", "DIVISION_BY_ZERO_REFUTED",
                "Compile-time division-by-zero safety refuted by " + prf_d["engine"] + " in '" + fn_node["name"] + "': denominator (" + dv["den_fol"] + ") can be 0"
                    + (if wsum != "" { " [counterexample: " + wsum + "]" } else { "" }),
                "Η ασφάλεια διαίρεσης με το μηδέν διαψεύστηκε από το " + prf_d["engine"] + " στη '" + fn_node["name"] + "'"
                    + (if wsum != "" { " [αντιπαράδειγμα: " + wsum + "]" } else { "" }),
                dv["line"], dv["col"], dv["col"] + 1, nil);
        } elif prf_d["status"] == "PROVED_MATHEMATICALLY" {
            any_proved = true;
        }
        di = di + 1;
    }

    // 2. Verify `ensures <post>` obligations across all extracted return paths
    if len(fn_node["ensures_list"]) > 0 and len(ret_paths) > 0 {
        let ei = 0;
        while ei < len(fn_node["ensures_list"]) {
            let ens = fn_node["ensures_list"][ei];
            let path_obligations = [];
            let extra_res_vars = [];
            let rpi = 0;
            while rpi < len(ret_paths) {
                let rp = ret_paths[rpi];
                let hyp = pre_fol;
                if len(rp["conds"]) > 0 {
                    hyp = "(" + pre_fol + " and " + str_join(rp["conds"], " and ") + ")";
                }

                // Check if return expression is a variable-denominator quotient `A / B`
                if rp["ret_node"]["kind"] == "binary" and rp["ret_node"]["op"] == "/" and rp["ret_node"]["right"]["kind"] != "num" {
                    let res_var = "__res_" + str(rpi);
                    push(extra_res_vars, res_var);
                    let num_f = _ast_expr_to_fol(rp["ret_node"]["left"], rp["subst"], false);
                    let den_f = _ast_expr_to_fol(rp["ret_node"]["right"], rp["subst"], false);
                    let sm = map{ "result": res_var };
                    let post_f = _ast_expr_to_fol(ens["expr"], sm, false);
                    push(path_obligations, "((" + hyp + " and ((" + den_f + ") != 0) and ((" + res_var + " * (" + den_f + ")) == (" + num_f + "))) -> (" + post_f + "))");
                } else {
                    let sm2 = map{ "result": rp["ret_fol"] };
                    let post_f2 = _ast_expr_to_fol(ens["expr"], sm2, all_int);
                    push(path_obligations, "(" + hyp + " -> (" + post_f2 + "))");
                }
                rpi = rpi + 1;
            }

            let all_qvars = [];
            let qi = 0;
            while qi < len(param_names) { push(all_qvars, param_names[qi]); qi = qi + 1; }
            qi = 0;
            while qi < len(extra_res_vars) { push(all_qvars, extra_res_vars[qi]); qi = qi + 1; }
            let full_q = if len(all_qvars) > 0 { "forall " + str_join(all_qvars, ", ") + ": " } else { "" };
            let full_formula = full_q + "(" + str_join(path_obligations, " and ") + ")";

            let use_pres = all_int and len(extra_res_vars) == 0;
            let prf = prove_formula_auto(full_formula, use_pres);
            prf["fn_name"] = fn_node["name"];
            prf["kind"] = "ensures";
            prf["line"] = ens["line"];
            prf["col"] = ens["col"];
            push(ctx["contracts"], prf);
            push(proofs_for_fn, prf);

            if prf["status"] == "REFUTED_COUNTEREXAMPLE" {
                any_refuted = true;
                let wsum2 = prf["witness_summary"];
                _emit_diag(ctx, "error", "CONTRACT_REFUTED",
                    "Contract 'ensures' in '" + fn_node["name"] + "' REFUTED mathematically by " + prf["engine"]
                        + (if wsum2 != "" { " — counterexample: " + wsum2 } else { "" }),
                    "Το συμβόλαιο 'ensures' στη '" + fn_node["name"] + "' διαψεύστηκε μαθηματικά από το " + prf["engine"]
                        + (if wsum2 != "" { " — αντιπαράδειγμα: " + wsum2 } else { "" }),
                    ens["line"], ens["col"], ens["col"] + 7, nil);
            } elif prf["status"] == "PROVED_MATHEMATICALLY" {
                any_proved = true;
            }
            ei = ei + 1;
        }
    }

    if fentry != nil {
        fentry["contract_proofs"] = proofs_for_fn;
        if any_refuted {
            fentry["contract_status"] = "REFUTED_COUNTEREXAMPLE";
        } elif any_proved {
            fentry["contract_status"] = "PROVED_MATHEMATICALLY";
        }
    }
}

fn _analyze_fn_node(ctx, parent_scope, fn_node) {
    let fscope = _new_scope(parent_scope);
    let fmut = map{};
    if fn_node["body"] != nil and fn_node["body"]["kind"] == "block" {
        _collect_mutated_idents_stmts(fn_node["body"]["stmts"], fmut);
    }
    fscope["mutated_vars"] = fmut;
    let ptypes = [];
    let req_cnt = 0;
    let pi = 0;
    while pi < len(fn_node["params"]) {
        let p = fn_node["params"][pi];
        let pt = _resolve_annot_to_type(ctx, p["annot"]);
        if p["default_expr"] != nil {
            let dt = _analyze_expr(ctx, fscope, p["default_expr"]);
            if p["annot"] == nil { pt = dt; }
        } else {
            if not p["is_rest"] { req_cnt = req_cnt + 1; }
        }
        if p["is_rest"] { pt = _make_type("array"); }
        push(ptypes, pt);
        let p_sym = map{
            name: p["name"], kind: "param", is_const: false, type: pt,
            line: p["line"], col: p["col"], end_col: p["end_col"], doc: ""
        };
        fscope["vars"][p["name"]] = p_sym;
        _record_hover_span(ctx, p["name"], p["line"], p["col"], p["end_col"], p_sym);
        if pt["has_unit"] {
            ctx["units_inferred"][fn_node["name"] + "." + p["name"]] = map{
                type_str: _type_to_str(pt),
                unit_str: _canonical_unit_label(pt["dim"], pt["ccy"]),
                dim: pt["dim"],
                dim_ascii: UCC.dim_to_ascii(pt["dim"]),
                dim_unicode: _dim_unicode_rich(pt["dim"], pt["ccy"]),
                canonical_si_unit: UCC.dim_canonical_si_unit(pt["dim"]),
                named_quantity: UCC.dim_named_quantity(pt["dim"]),
                currency_map: pt["ccy"]
            };
        }
        pi = pi + 1;
    }

    let ret_t = if fn_node["ret_annot"] != nil { _resolve_annot_to_type(ctx, fn_node["ret_annot"]) } else { _make_type("any") };

    // Analyze `requires` and `ensures` expressions for symbol/type/unit validity!
    let ri = 0;
    while ri < len(fn_node["requires_list"]) {
        let req_t = _analyze_expr(ctx, fscope, fn_node["requires_list"][ri]["expr"]);
        if req_t["base"] != "bool" and req_t["base"] != "any" {
            _emit_diag(ctx, "error", "TYPE_MISMATCH",
                "'requires' clause must evaluate to bool, got " + _type_to_str(req_t),
                "Η συνθήκη 'requires' πρέπει να αποτιμάται σε bool",
                fn_node["requires_list"][ri]["line"], fn_node["requires_list"][ri]["col"], fn_node["requires_list"][ri]["col"] + 8, nil);
        }
        ri = ri + 1;
    }

    if len(fn_node["ensures_list"]) > 0 {
        let ens_scope = _new_scope(fscope);
        ens_scope["vars"]["result"] = map{ name: "result", kind: "var", is_const: true, type: ret_t, line: fn_node["line"], col: fn_node["col"], doc: "Function return value" };
        let ei = 0;
        while ei < len(fn_node["ensures_list"]) {
            let ens_t = _analyze_expr(ctx, ens_scope, fn_node["ensures_list"][ei]["expr"]);
            if ens_t["base"] != "bool" and ens_t["base"] != "any" {
                _emit_diag(ctx, "error", "TYPE_MISMATCH",
                    "'ensures' clause must evaluate to bool, got " + _type_to_str(ens_t),
                    "Η συνθήκη 'ensures' πρέπει να αποτιμάται σε bool",
                    fn_node["ensures_list"][ei]["line"], fn_node["ensures_list"][ei]["col"], fn_node["ensures_list"][ei]["col"] + 7, nil);
            }
            ei = ei + 1;
        }
    }

    // Analyze function body with expected return type `ret_t`
    _analyze_block_full(ctx, fscope, fn_node["body"], ret_t);

    let fentry = if fn_node["name"] != "" { _scope_lookup(parent_scope, fn_node["name"]) } else { nil };
    if fentry != nil {
        _record_hover_span(ctx, fn_node["name"], fn_node["line"], fn_node["col"], fn_node["end_col"], fentry);
    }

    // Pass 4: Tarski CAD & Cooper Presburger Proof-Carrying Contract Verification!
    if fn_node["name"] != "" {
        _verify_fn_contracts_and_divisions(ctx, fn_node, fentry, ptypes, ret_t);
        if ret_t["has_unit"] {
            ctx["units_inferred"][fn_node["name"]] = map{
                type_str: _type_to_str(ret_t),
                unit_str: _canonical_unit_label(ret_t["dim"], ret_t["ccy"]),
                dim: ret_t["dim"],
                dim_ascii: UCC.dim_to_ascii(ret_t["dim"]),
                dim_unicode: _dim_unicode_rich(ret_t["dim"], ret_t["ccy"]),
                canonical_si_unit: UCC.dim_canonical_si_unit(ret_t["dim"]),
                named_quantity: UCC.dim_named_quantity(ret_t["dim"]),
                currency_map: ret_t["ccy"]
            };
        }
    }

    let ft = _make_type("fn");
    ft["params"] = ptypes;
    ft["ret_type"] = ret_t;
    ft["min_args"] = req_cnt;
    ft["max_args"] = if fn_node["has_rest"] { -1 } else { len(fn_node["params"]) };
    ft["has_rest"] = fn_node["has_rest"];
    return ft;
}

fn _check_return_value(ctx, val_t, expected_ret, line, col) {
    if expected_ret == nil or expected_ret["base"] == "any" { return; }
    if not _types_compatible_assign(expected_ret, val_t, ctx["strict"]) {
        _emit_diag(ctx, "error", "RETURN_TYPE_MISMATCH",
            "Return type mismatch: function returns '" + _type_to_str(expected_ret) + "', but got '" + _type_to_str(val_t) + "'",
            "Ασυμφωνία τύπου επιστροφής: αναμενόταν '" + _type_to_str(expected_ret) + "', αλλά επιστράφηκε '" + _type_to_str(val_t) + "'",
            line, col, col + 6, nil);
        return;
    }
    if _is_numeric_type(expected_ret) and _is_numeric_type(val_t) and (expected_ret["has_unit"] or val_t["has_unit"]) {
        if not (val_t["is_zero_lit"] == true and expected_ret["has_unit"]) {
            _check_unit_match_pair(ctx, expected_ret, val_t, "return", line, col);
        }
    }
}

fn _is_pure_scalar_literal(node) {
    if node == nil { return false; }
    let k = node["kind"];
    if k == "num" { return true; }
    if k == "unary" and (node["op"] == "-" or node["op"] == "+") {
        return _is_pure_scalar_literal(node["arg"]);
    }
    if k == "binary" and (node["op"] == "+" or node["op"] == "-" or node["op"] == "*" or node["op"] == "/" or node["op"] == "**" or node["op"] == "^") {
        return _is_pure_scalar_literal(node["left"]) and _is_pure_scalar_literal(node["right"]);
    }
    return false;
}

fn _analyze_block_stmts(ctx, bscope, stmts, expected_ret) {
    let terminated = false;
    let warned_unreachable = false;

    let i = 0;
    while i < len(stmts) {
        let s = stmts[i];
        let sk = s["kind"];

        // Pass 1: Unreachable code detection after return/throw/break/continue!
        if terminated and not warned_unreachable and sk != "empty" and sk != "fn_decl" and sk != "enum_decl" and sk != "struct_decl" and sk != "class_decl" {
            warned_unreachable = true;
            _emit_diag(ctx, "error", "UNREACHABLE_CODE",
                "Unreachable statement after control-flow transfer (return/throw/break/continue)",
                "Μη προσβάσιμη εντολή μετά από τερματισμό ροής (return/throw/break/continue)",
                s["line"], s["col"], s["col"] + 6, nil);
        }

        if sk == "var_decl" {
            let init_t = if s["init"] != nil { _analyze_expr(ctx, bscope, s["init"]) } else { _make_type("nil") };
            let decl_t = init_t;
            if s["annot"] != nil {
                let ann_t = _resolve_annot_to_type(ctx, s["annot"]);
                if s["init"] != nil {
                    if not _types_compatible_assign(ann_t, init_t, ctx["strict"]) {
                        _emit_diag(ctx, "error", "TYPE_MISMATCH",
                            "Cannot initialize '" + s["name"] + ": " + _type_to_str(ann_t) + "' with value of type '" + _type_to_str(init_t) + "'",
                            "Ασυμφωνία τύπου κατά την αρχικοποίηση του '" + s["name"] + "'",
                            s["line"], s["col"], s["end_col"], nil);
                    } elif _is_numeric_type(ann_t) and _is_numeric_type(init_t) and (ann_t["has_unit"] or init_t["has_unit"]) {
                        let is_unit_ctor = ann_t["has_unit"] and (not init_t["has_unit"]) and _is_pure_scalar_literal(s["init"]);
                        if not is_unit_ctor and not (init_t["is_zero_lit"] == true and ann_t["has_unit"]) {
                            _check_unit_match_pair(ctx, ann_t, init_t, "=", s["line"], s["col"]);
                        }
                    }
                }
                decl_t = ann_t;
                if init_t != nil and map_has(init_t, "is_quantum_circuit") and init_t["is_quantum_circuit"] == true {
                    decl_t = _sc_clone_map(decl_t);
                    decl_t["is_quantum_circuit"] = true;
                    decl_t["quantum_n_qubits"] = init_t["quantum_n_qubits"];
                }
            }
            if s["annot"] == nil and (not s["is_const"]) and (not ctx["strict"]) and decl_t["base"] == "nil" {
                decl_t = _make_type("any");
            }
            // Strip zero-literal polymorphism once stored into a mutable `let` variable (keep for `const 0`!)
            if not s["is_const"] and decl_t["is_zero_lit"] == true {
                decl_t = _sc_clone_map(decl_t);
                decl_t["is_zero_lit"] = false;
            }
            let ventry = map{
                name: s["name"],
                kind: if s["is_const"] { "const" } else { "var" },
                is_const: s["is_const"],
                explicit_annot: (s["annot"] != nil),
                type: decl_t,
                line: s["line"],
                col: s["col"],
                end_col: s["end_col"],
                doc: s["doc"]
            };
            bscope["vars"][s["name"]] = ventry;
            if bscope["parent"] == nil {
                push(ctx["symbols"], ventry);
                ctx["symbol_map"][s["name"]] = ventry;
            }
            _record_hover_span(ctx, s["name"], s["line"], s["col"], s["end_col"], ventry);
            if decl_t["has_unit"] {
                ctx["units_inferred"][s["name"]] = map{
                    type_str: _type_to_str(decl_t),
                    unit_str: _canonical_unit_label(decl_t["dim"], decl_t["ccy"]),
                    dim: decl_t["dim"],
                    dim_ascii: UCC.dim_to_ascii(decl_t["dim"]),
                    dim_unicode: _dim_unicode_rich(decl_t["dim"], decl_t["ccy"]),
                    canonical_si_unit: UCC.dim_canonical_si_unit(decl_t["dim"]),
                    named_quantity: UCC.dim_named_quantity(decl_t["dim"]),
                    currency_map: decl_t["ccy"]
                };
            }
        } elif sk == "destruct_decl" {
            if s["init"] != nil { _analyze_expr(ctx, bscope, s["init"]); }
            let di = 0;
            while di < len(s["names"]) {
                let nt = s["names"][di];
                bscope["vars"][nt["val"]] = map{
                    name: nt["val"], kind: if s["is_const"] { "const" } else { "var" },
                    is_const: s["is_const"], explicit_annot: false, type: _make_type("any"), line: nt["line"], col: nt["col"], doc: ""
                };
                di = di + 1;
            }
        } elif sk == "assign" {
            let tgt = s["target"];
            let val_t = _analyze_expr(ctx, bscope, s["val"]);
            if tgt["kind"] == "ident" {
                let sym = _scope_lookup(bscope, tgt["name"]);
                if sym == nil {
                    let cands = _scope_all_names(bscope, _get_builtin_specs());
                    let sugg = suggest_symbol(tgt["name"], cands);
                    let msg_en = if sugg != nil {
                        "Undefined symbol '" + tgt["name"] + "' — did you mean '" + sugg + "'?"
                    } else {
                        "Undefined symbol '" + tgt["name"] + "'"
                    };
                    _emit_diag(ctx, "error", "UNDEFINED_SYMBOL", msg_en, "Μη ορισμένο σύμβολο '" + tgt["name"] + "'", tgt["line"], tgt["col"], tgt["end_col"], sugg);
                } else {
                    _record_hover_span(ctx, tgt["name"], tgt["line"], tgt["col"], tgt["end_col"], sym);
                    // Pass 1: Assignment to `const`!
                    if sym["is_const"] {
                        _emit_diag(ctx, "error", "CONST_REASSIGNMENT",
                            "Cannot reassign immutable constant '" + tgt["name"] + "'",
                            "Αδύνατη η επανεκχώρηση στη σταθερά (const) '" + tgt["name"] + "'",
                            s["line"], s["col"], tgt["end_col"], nil);
                    }
                    let cur_t = sym["type"];
                    let has_exp = map_has(sym, "explicit_annot") and sym["explicit_annot"] == true;
                    let enforce_assign_type = has_exp or ctx["strict"] or (cur_t != nil and cur_t["has_unit"]) or (val_t != nil and val_t["has_unit"]);
                    if cur_t != nil and cur_t["base"] != "any" and cur_t["base"] != "nil" {
                        if not _types_compatible_assign(cur_t, val_t, ctx["strict"]) {
                            if enforce_assign_type {
                                _emit_diag(ctx, "error", "TYPE_MISMATCH",
                                    "Cannot assign '" + _type_to_str(val_t) + "' to variable '" + tgt["name"] + "' of type '" + _type_to_str(cur_t) + "'",
                                    "Ασυμφωνία τύπου στην εκχώρηση του '" + tgt["name"] + "'",
                                    s["line"], s["col"], tgt["end_col"], nil);
                            } else {
                                sym["type"] = if _is_numeric_type(cur_t) and _is_numeric_type(val_t) { _make_type("num") } else { _make_type("any") };
                            }
                        } elif _is_numeric_type(cur_t) and _is_numeric_type(val_t) and (cur_t["has_unit"] or val_t["has_unit"]) {
                            if s["op"] == "=" or s["op"] == "+=" or s["op"] == "-=" {
                                if not (val_t["is_zero_lit"] == true and cur_t["has_unit"]) {
                                    _check_unit_match_pair(ctx, cur_t, val_t, s["op"], s["line"], s["col"]);
                                }
                            }
                        }
                        if s["op"] == "=" and val_t != nil and map_has(val_t, "is_quantum_circuit") and val_t["is_quantum_circuit"] == true {
                            let updated_qt = _sc_clone_map(sym["type"]);
                            updated_qt["is_quantum_circuit"] = true;
                            updated_qt["quantum_n_qubits"] = val_t["quantum_n_qubits"];
                            sym["type"] = updated_qt;
                        }
                    } else {
                        if (not has_exp) and (not ctx["strict"]) and cur_t != nil and cur_t["base"] == "any" and (val_t == nil or not (map_has(val_t, "is_quantum_circuit") and val_t["is_quantum_circuit"] == true)) {
                            sym["type"] = _make_type("any");
                        } else {
                            sym["type"] = val_t;
                        }
                    }
                }
            } else {
                _analyze_expr(ctx, bscope, tgt);
            }
        } elif sk == "fn_decl" {
            _analyze_fn_node(ctx, bscope, s);
        } elif sk == "return_stmt" {
            let rv_t = if s["val"] != nil { _analyze_expr(ctx, bscope, s["val"]) } else { _make_type("nil") };
            _check_return_value(ctx, rv_t, expected_ret, s["line"], s["col"]);
            terminated = true;
        } elif sk == "throw_stmt" {
            _analyze_expr(ctx, bscope, s["val"]);
            terminated = true;
        } elif sk == "break_stmt" or sk == "continue_stmt" {
            terminated = true;
        } elif sk == "print_stmt" {
            let pi = 0;
            while pi < len(s["args"]) {
                _analyze_expr(ctx, bscope, s["args"][pi]);
                pi = pi + 1;
            }
        } elif sk == "if_stmt" {
            let if_inf = _analyze_if_stmt(ctx, bscope, s, expected_ret);
            if if_inf["terminates"] { terminated = true; }
        } elif sk == "while_stmt" {
            _analyze_expr(ctx, bscope, s["cond"]);
            _analyze_block_full(ctx, bscope, s["body"], expected_ret);
        } elif sk == "loop_stmt" {
            _analyze_block_full(ctx, bscope, s["body"], expected_ret);
        } elif sk == "for_stmt" {
            let fscope = _new_scope(bscope);
            let it_t = _analyze_expr(ctx, bscope, s["iter"]);
            if s["range_end"] != nil { _analyze_expr(ctx, bscope, s["range_end"]); }
            let v1_t = if s["range_end"] != nil { _make_type("int") } elif it_t["base"] == "array" and it_t["elem_type"] != nil { it_t["elem_type"] } else { _make_type("any") };
            fscope["vars"][s["var1"]["val"]] = map{ name: s["var1"]["val"], kind: "var", is_const: false, type: v1_t, line: s["var1"]["line"], col: s["var1"]["col"], doc: "" };
            if s["var2"] != nil {
                fscope["vars"][s["var2"]["val"]] = map{ name: s["var2"]["val"], kind: "var", is_const: false, type: _make_type("any"), line: s["var2"]["line"], col: s["var2"]["col"], doc: "" };
            }
            _analyze_block_full(ctx, fscope, s["body"], expected_ret);
        } elif sk == "match_stmt" {
            let m_inf = _analyze_match(ctx, bscope, s, expected_ret);
            if m_inf["terminates"] { terminated = true; }
        } elif sk == "switch_stmt" {
            _analyze_expr(ctx, bscope, s["target"]);
            let ci = 0;
            while ci < len(s["cases"]) {
                let cs = s["cases"][ci];
                if cs["val"] != nil { _analyze_expr(ctx, bscope, cs["val"]); }
                let cscope = _new_scope(bscope);
                _analyze_block_stmts(ctx, cscope, cs["stmts"], expected_ret);
                ci = ci + 1;
            }
        } elif sk == "try_block_expr" {
            _analyze_expr(ctx, bscope, s);
        } elif sk == "defer_stmt" {
            if s["body"]["kind"] == "block" {
                _analyze_block_full(ctx, bscope, s["body"], nil);
            } else {
                _analyze_block_stmts(ctx, bscope, [s["body"]], nil);
            }
        } elif sk == "block" {
            let sub_inf = _analyze_block_full(ctx, bscope, s, expected_ret);
            if sub_inf["terminates"] { terminated = true; }
        } elif sk == "export_stmt" {
            let ei = 0;
            while ei < len(s["names"]) {
                let etok = s["names"][ei];
                let esym = _scope_lookup(bscope, etok["val"]);
                if esym == nil {
                    let sugg = suggest_symbol(etok["val"], _scope_all_names(bscope, _get_builtin_specs()));
                    _emit_diag(ctx, "error", "UNDEFINED_SYMBOL",
                        "Cannot export undefined symbol '" + etok["val"] + "'" + (if sugg != nil { " — did you mean '" + sugg + "'?" } else { "" }),
                        "Αδύνατη η εξαγωγή μη ορισμένου συμβόλου '" + etok["val"] + "'",
                        etok["line"], etok["col"], etok["end_col"], sugg);
                } else {
                    _sc_arr_push_unique(ctx["exports"], etok["val"]);
                }
                ei = ei + 1;
            }
        } elif sk == "class_decl" {
            let cscope = _new_scope(bscope);
            cscope["vars"]["self"] = map{ name: "self", kind: "var", is_const: true, type: _make_type("class"), line: s["line"], col: s["col"], doc: "" };
            _predeclare_block_hoisted(ctx, cscope, s["members"], false);
            _analyze_block_stmts(ctx, cscope, s["members"], nil);
        } elif sk == "expr_stmt" {
            _analyze_expr(ctx, bscope, s["expr"]);
        }
        if map_has(s, "exported") and s["exported"] == true and map_has(s, "name") and s["name"] != "" {
            _sc_arr_push_unique(ctx["exports"], s["name"]);
        }
        i = i + 1;
    }
    return terminated;
}

fn _analyze_block_full(ctx, parent_scope, block_node, expected_ret) {
    let bscope = _new_scope(parent_scope);
    _predeclare_block_hoisted(ctx, bscope, block_node["stmts"], false);
    let term = _analyze_block_stmts(ctx, bscope, block_node["stmts"], expected_ret);
    let tail_t = _make_type("nil");
    if block_node["tail_expr"] != nil {
        tail_t = _analyze_expr(ctx, bscope, block_node["tail_expr"]);
        if expected_ret != nil {
            _check_return_value(ctx, tail_t, expected_ret, block_node["tail_expr"]["line"], block_node["tail_expr"]["col"]);
        }
    }
    return map{ terminates: term, expr_type: tail_t };
}

fn _analyze_block(ctx, parent_scope, block_node, expected_ret) {
    return _analyze_block_full(ctx, parent_scope, block_node, expected_ret)["expr_type"];
}

// ── Public Entrypoints: `check_source`, `check_file`, `infer_expr_unit`, `cli_check_entry` ──

fn check_source(src_code, opts = nil) {
    let o = if opts != nil and type(opts) == "map" { opts } else { map{} };
    let is_strict = if map_has(o, "strict") { o["strict"] == true } else { false };
    let file_lbl = if map_has(o, "file") and o["file"] != nil { str(o["file"]) } else { "<memory>" };
    let base_d = if map_has(o, "base_dir") and o["base_dir"] != nil { str(o["base_dir"]) } else { "" };

    let parsed = parse_sapp_ast(src_code);
    let ctx = map{
        strict: is_strict,
        file: file_lbl,
        base_dir: base_d,
        diagnostics: [],
        symbols: [],
        symbol_map: map{},
        hover_spans: [],
        contracts: [],
        units_inferred: map{},
        exports: [],
        enums: map{},
        structs: map{},
        classes: map{},
        quantum_registers: []
    };

    let pi = 0;
    while pi < len(parsed["errors"]) {
        push(ctx["diagnostics"], parsed["errors"][pi]);
        pi = pi + 1;
    }

    let root_scope = _new_scope(nil);
    // Optional pre-populated environment symbols (used by interactive REPL!)
    if map_has(o, "predefined_vars") and type(o["predefined_vars"]) == "map" {
        let pks = map_keys(o["predefined_vars"]);
        let k = 0;
        while k < len(pks) {
            let vnm = pks[k];
            let vspec = o["predefined_vars"][vnm];
            let vt = if type(vspec) == "map" and map_has(vspec, "type") { vspec["type"] } else { _make_type("any") };
            root_scope["vars"][vnm] = map{ name: vnm, kind: "var", is_const: false, type: vt, line: 0, col: 0, doc: "" };
            k = k + 1;
        }
    }

    let prog_stmts = parsed["ast"]["stmts"];
    let rmut = map{};
    _collect_mutated_idents_stmts(prog_stmts, rmut);
    root_scope["mutated_vars"] = rmut;
    _predeclare_block_hoisted(ctx, root_scope, prog_stmts, true);
    _analyze_block_stmts(ctx, root_scope, prog_stmts, nil);

    let err_cnt = 0;
    let warn_cnt = 0;
    let di = 0;
    while di < len(ctx["diagnostics"]) {
        if ctx["diagnostics"][di]["severity"] == "error" { err_cnt = err_cnt + 1; }
        else { warn_cnt = warn_cnt + 1; }
        di = di + 1;
    }

    // Enrich symbol records with stringified types & SI unit summaries
    let si = 0;
    let symbols_summary = [];
    while si < len(ctx["symbols"]) {
        let sym = ctx["symbols"][si];
        let stype = sym["type"];
        push(symbols_summary, map{
            name: sym["name"],
            kind: sym["kind"],
            type_str: _type_to_str(stype),
            has_unit: stype["has_unit"],
            unit_str: if stype["has_unit"] { _canonical_unit_label(stype["dim"], stype["ccy"]) } else { "" },
            dim_unicode: if stype["has_unit"] { _dim_unicode_rich(stype["dim"], stype["ccy"]) } else { "" },
            canonical_si: if stype["has_unit"] { UCC.dim_canonical_si_unit(stype["dim"]) } else { "" },
            named_quantity: if stype["has_unit"] { UCC.dim_named_quantity(stype["dim"]) } else { "" },
            line: sym["line"],
            col: sym["col"],
            end_line: if map_has(sym, "end_line") { sym["end_line"] } else { sym["line"] },
            doc: sym["doc"],
            contract_status: if map_has(sym, "contract_status") { sym["contract_status"] } else { "NONE" },
            contract_proofs: if map_has(sym, "contract_proofs") { sym["contract_proofs"] } else { [] }
        });
        si = si + 1;
    }

    return map{
        ok: err_cnt == 0,
        version: STATIC_CHECKER_VERSION,
        file: file_lbl,
        strict: is_strict,
        error_count: err_cnt,
        warning_count: warn_cnt,
        diagnostics: ctx["diagnostics"],
        symbols: symbols_summary,
        hover_spans: ctx["hover_spans"],
        contracts: ctx["contracts"],
        units_inferred: ctx["units_inferred"],
        exports: ctx["exports"],
        ast: parsed["ast"]
    };
}

fn check_file(path, opts = nil) {
    let o = if opts != nil and type(opts) == "map" { _sc_clone_map(opts) } else { map{} };
    o["file"] = path;
    o["base_dir"] = path_dirname(path);
    let src = try fs_read(path) catch nil;
    if src == nil {
        return map{
            ok: false,
            version: STATIC_CHECKER_VERSION,
            file: path,
            strict: map_has(o, "strict") and o["strict"] == true,
            error_count: 1,
            warning_count: 0,
            diagnostics: [map{
                severity: "error",
                code: "FILE_READ_ERROR",
                message: "Cannot read source file '" + path + "'",
                message_el: "Αδυναμία ανάγνωσης αρχείου '" + path + "'",
                line: 1, col: 1, end_line: 1, end_col: 2, suggestion: nil
            }],
            symbols: [],
            hover_spans: [],
            contracts: [],
            units_inferred: map{},
            exports: [],
            ast: nil
        };
    }
    return check_source(src, o);
}

fn infer_expr_unit(expr_str, env_units = nil) {
    let preamble = [];
    if env_units != nil and type(env_units) == "map" {
        let ks = map_keys(env_units);
        let i = 0;
        while i < len(ks) {
            let k = ks[i];
            let u = env_units[k];
            if u != "" and u != "1" {
                push(preamble, "let " + k + ": num[" + u + "] = 1.0;");
            } else {
                push(preamble, "let " + k + ": num = 1.0;");
            }
            i = i + 1;
        }
    }
    push(preamble, "let __probe = " + expr_str + ";");
    let rep = check_source(str_join(preamble, "\n"));
    let ui = if map_has(rep["units_inferred"], "__probe") { rep["units_inferred"]["__probe"] } else { nil };
    let probe_sym = nil;
    let si = 0;
    while si < len(rep["symbols"]) {
        if rep["symbols"][si]["name"] == "__probe" { probe_sym = rep["symbols"][si]; }
        si = si + 1;
    }
    return map{
        ok: rep["ok"],
        type_str: if probe_sym != nil { probe_sym["type_str"] } else { "any" },
        unit_info: ui,
        diagnostics: rep["diagnostics"]
    };
}

fn format_diagnostics_text(report) {
    let lines = [];
    let f = report["file"];
    let diags = report["diagnostics"];
    let i = 0;
    while i < len(diags) {
        let d = diags[i];
        push(lines, f + ":" + str(d["line"]) + ":" + str(d["col"]) + ": " + d["severity"] + "[" + d["code"] + "]: " + d["message"]);
        i = i + 1;
    }
    let ci = 0;
    let contracts = report["contracts"];
    while ci < len(contracts) {
        let c = contracts[ci];
        let mark = if c["proved"] { "✓ PROVED" } else { "✗ REFUTED" };
        push(lines, "  contract[" + c["engine"] + "] " + c["fn_name"] + " (" + c["kind"] + "): " + mark + " (" + c["status"] + ")");
        ci = ci + 1;
    }
    push(lines, "summary: " + str(report["error_count"]) + " error(s), " + str(report["warning_count"]) + " warning(s), " + str(len(contracts)) + " contract obligation(s)");
    return str_join(lines, "\n");
}

fn cli_check_entry(cli_args = nil) {
    let raw_args = if cli_args != nil { cli_args } else { os_args() };
    let strict_flag = false;
    let json_flag = false;
    let no_exit = false;
    let files = [];

    let i = 0;
    while i < len(raw_args) {
        let a = raw_args[i];
        if a == "--strict" { strict_flag = true; }
        elif a == "--json" { json_flag = true; }
        elif a == "--no-exit" { no_exit = true; }
        elif a == "--" or a == "check" or a == "--check" or str_ends_with(a, "static_checker.sapp") or str_ends_with(a, "pblang") {
            // skip driver tokens
        } else {
            push(files, a);
        }
        i = i + 1;
    }

    let total_errors = 0;
    let reports = [];
    let fi = 0;
    while fi < len(files) {
        let rep = check_file(files[fi], map{ strict: strict_flag });
        total_errors = total_errors + rep["error_count"];
        push(reports, rep);
        if not json_flag {
            println(format_diagnostics_text(rep));
        }
        fi = fi + 1;
    }

    if json_flag {
        println(json_stringify(map{
            ok: total_errors == 0,
            total_errors: total_errors,
            reports: reports
        }));
    }

    if total_errors > 0 and not no_exit {
        os_exit(1);
    }
    return map{ ok: total_errors == 0, total_errors: total_errors, reports: reports };
}

export STATIC_CHECKER_VERSION,
       levenshtein_distance, suggest_symbol,
       tokenize_sapp, parse_sapp_ast,
       prove_formula_auto, infer_expr_unit,
       check_source, check_file, format_diagnostics_text, cli_check_entry;
