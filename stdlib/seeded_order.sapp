// Local reproducible ordering, not cryptography or an unbiased sampling claim.
let R=import("stdlib:random.sapp");
fn permutation(count,seed){
 if type(count)!="number" or count!=num_floor(count) or not(count>=1 and count<=4096) {throw "order count must be 1..4096";}
 if type(seed)!="number" or seed!=num_floor(seed) or not(seed>=0 and seed<=4294967295) {throw "order seed must be a uint32 integer";}
 let indices=[];for i in range(0,count){array_push(indices,i);}return R.shuffle(R.seed(seed),indices);
}
export permutation;
