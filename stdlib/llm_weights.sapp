// stdlib/llm_weights.sapp -- pblang-native checkpoint/weight shard format.

fn manifest(model, tokenizer_summary, name, tier) {
    return map{
        format: "pblang.llm.weights.manifest.v1",
        name: name,
        tier: tier,
        created_ms: now_ms(),
        model_format: model.format,
        model_config: model.config,
        tokenizer: tokenizer_summary,
        shards: [
            map{ name: "embeddings", file: "embeddings.json" },
            map{ name: "layers", file: "layers.json" },
            map{ name: "head", file: "head.json" }
        ]
    };
}

fn split_model(model) {
    return map{
        embeddings: map{ token_embedding: model.token_embedding, pos_embedding: model.pos_embedding, binary_projection: try model.binary_projection catch [] },
        layers: model.layers,
        head: map{ lm_head: model.lm_head, lm_bias: model.lm_bias }
    };
}

fn join_model(man, shards) {
    return map{
        format: man.model_format,
        config: man.model_config,
        token_embedding: shards.embeddings.token_embedding,
        pos_embedding: shards.embeddings.pos_embedding,
        binary_projection: try shards.embeddings.binary_projection catch [],
        layers: shards.layers,
        lm_head: shards.head.lm_head,
        lm_bias: shards.head.lm_bias
    };
}

fn save_sharded(dir, model, tokenizer_summary, name, tier) {
    let man = manifest(model, tokenizer_summary, name, tier);
    let shards = split_model(model);
    fs_mkdirs(dir);
    fs_write(dir + "/manifest.json", json_stringify(man));
    fs_write(dir + "/embeddings.json", json_stringify(shards.embeddings));
    fs_write(dir + "/layers.json", json_stringify(shards.layers));
    fs_write(dir + "/head.json", json_stringify(shards.head));
    return man;
}

fn load_sharded(dir) {
    let man = json_parse(fs_read(dir + "/manifest.json"));
    let shards = map{
        embeddings: json_parse(fs_read(dir + "/embeddings.json")),
        layers: json_parse(fs_read(dir + "/layers.json")),
        head: json_parse(fs_read(dir + "/head.json"))
    };
    return map{ manifest: man, model: join_model(man, shards) };
}

fn estimate_params(model) {
    let total = len(model.token_embedding) * len(model.token_embedding[0])
        + len(model.pos_embedding) * len(model.pos_embedding[0])
        + len(model.lm_head) * len(model.lm_head[0])
        + len(model.lm_bias);
    let bp = try model.binary_projection catch [];
    if len(bp) > 0 { total = total + len(bp) * len(bp[0]); }
    let i = 0;
    while i < len(model.layers) {
        let l = model.layers[i];
        total = total
            + len(l.Wq) * len(l.Wq[0]) + len(l.Wk) * len(l.Wk[0])
            + len(l.Wv) * len(l.Wv[0]) + len(l.Wo) * len(l.Wo[0])
            + len(l.W1) * len(l.W1[0]) + len(l.W2) * len(l.W2[0])
            + len(l.b1) + len(l.b2);
        i = i + 1;
    }
    return total;
}

export manifest, split_model, join_model, save_sharded, load_sharded, estimate_params;
