// Explicit, in-memory specialist training. No corpus reads, cache writes or activation.
// Fixed tiny decoder: this is an experimental token specialist, not a pretrained LLM.
let ATT = import("stdlib:llm_attention.sapp");
let AD = import("stdlib:llm_adapters.sapp");
let CORE = import("stdlib:llm_core.sapp");
// Decoders retain this selected module origin even when called from a foreign cwd.
let SER = import("stdlib:serialization.sapp");
let FORMAT = "pbai.neural.token-adapter.v1";
let PROFILE = "tiny-token-8-context-4-seed-77-q6-v1";

fn _number(x, lo, hi, integer = false) {
    if type(x) != "number" { return false; }
    if x != x { return false; }
    if x < lo or x > hi { return false; }
    return not integer or x == num_floor(x);
}
fn _keys(x, keys) {
    if type(x) != "map" or len(x) != len(keys) { return false; }
    for key in keys { if not map_has(x,key) { return false; } }
    return true;
}
fn _ids(ids) {
    if type(ids) != "array" or len(ids) < 1 or len(ids) > 4 { return false; }
    for id in ids { if not _number(id,0,7,true) { return false; } }
    return true;
}
// Token identity is numerical: +0 and -0 address the same embedding row.
fn _context_key(ids) {
    let canonical=[];for id in ids {push(canonical,if id==0 {0} else {id});}
    return json_stringify(canonical);
}
fn _examples(examples) {
    if type(examples) != "array" or len(examples) < 1 or len(examples) > 32 { throw "expected 1..32 examples"; }
    let seen=map{};
    for ex in examples {
        if not _keys(ex,["x","y"]) or not _ids(ex.x) or not _number(ex.y,0,7,true) { throw "invalid token example"; }
        let key=_context_key(ex.x);
        if map_has(seen,key) { throw "duplicate input context"; }
        seen[key]=true;
    }
    return seen;
}
fn _model() { return ATT.model_new(ATT.config(8,4,8,16,1,1,77)); }
fn _matrix(m, rows, cols, limit = 10000, integer = false) {
    if type(m) != "array" or len(m) != rows { return false; }
    for row in m {
        if type(row) != "array" or len(row) != cols { return false; }
        for value in row { if not _number(value,0-limit,limit,integer) { return false; } }
    }
    return true;
}
fn _identity(base_digest,a,b,steps) { return sha256(json_stringify([FORMAT,PROFILE,base_digest,a,b,steps])); }
// Fixed-point integers make the artifact digest stable across JSON roundtrips.
fn _quantize(matrix) {
    let out=[];for row in matrix {let values=[];for v in row {push(values,num_floor(v*1000000+0.5));}push(out,values);}return out;
}
fn _dequantize(matrix) {
    let out=[];for row in matrix {let values=[];for v in row {push(values,v/1000000);}push(out,values);}return out;
}
fn _artifact(ad, base_digest) {
    let a=_quantize(ad.a_matrix);let b=_quantize(ad.b_matrix);
    return map{format:FORMAT,profile:PROFILE,base_digest:base_digest,a:a,b:b,steps:ad.steps,digest:_identity(base_digest,a,b,ad.steps)};
}
fn valid_artifact(value) {
    if not _keys(value,["format","profile","base_digest","a","b","steps","digest"]) { return false; }
    if value.format != FORMAT or value.profile != PROFILE { return false; }
    if type(value.base_digest) != "string" or len(value.base_digest) != 64 { return false; }
    if not _number(value.steps,0,4096,true) or not _matrix(value.a,8,2,10000000000,true) or not _matrix(value.b,2,8,10000000000,true) { return false; }
    if type(value.digest) != "string" or len(value.digest) != 64 { return false; }
    return value.base_digest == sha256(json_stringify(_model()))
        and value.digest == _identity(value.base_digest,value.a,value.b,value.steps);
}
fn _adapter(model, artifact) {
    let ad=AD.lm_head_adapter(model,2,4.0,1901);
    return AD.from_state(ad,_dequantize(artifact.a),_dequantize(artifact.b),0.0,artifact.steps,artifact.steps);
}
fn predict(artifact, ids) {
    if not valid_artifact(artifact) { throw "invalid neural adapter artifact"; }
    if not _ids(ids) { throw "invalid neural input"; }
    let model=_model(); let ad=_adapter(model,artifact);
    let raw=AD.logits(model,ATT.head_hidden(model,ids),ad);
    return map{format:"pbai.neural.prediction.v1",token:CORE.argmax(raw),logits:raw,
        artifact_digest:artifact.digest,stages:["explicit-candidate","neural-specialist"],
        globally_activated:false,authorizes_action:false,artifact_authenticated:false,authorizes_activation:false};
}
fn train(train_examples, validation_examples, options = nil) {
    let seen=_examples(train_examples); _examples(validation_examples);
    for ex in validation_examples { if map_has(seen,_context_key(ex.x)) { throw "training/validation input overlap"; } }
    if options == nil { options=map{epochs:64,lr:0.1}; }
    if not _keys(options,["epochs","lr"]) or not _number(options.epochs,1,128,true)
        or not _number(options.lr,0.000001,0.25) { throw "invalid neural training options"; }
    let model=_model(); let base_digest=sha256(json_stringify(model)); let initial=AD.lm_head_adapter(model,2,4.0,1901);
    let ad=initial;
    let before=AD.evaluate(model,initial,ATT.adapter_hidden,validation_examples);
    let train_before=AD.evaluate(model,initial,ATT.adapter_hidden,train_examples);
    // Frozen features are computed once. Only the 32 low-rank parameters train.
    let hidden=[]; for ex in train_examples { push(hidden,ATT.head_hidden(model,ex.x)); }
    let total=0.0;
    for _epoch options.epochs { for i len(train_examples) {
        let step=AD.train_step(model,ad,hidden[i],train_examples[i].y,options.lr);
        ad=AD.from_state(ad,step.updated_a_matrix,step.updated_b_matrix,step.loss,step.next_steps,step.next_examples);
        if not _matrix(ad.a_matrix,8,2) or not _matrix(ad.b_matrix,2,8) { throw "nonfinite or oversized training update"; }
        total=total+step.loss;
    } }
    let artifact=_artifact(ad,base_digest);
    let initial_artifact=_artifact(initial,base_digest);
    let saved=_adapter(model,artifact);
    let after=AD.evaluate(model,saved,ATT.adapter_hidden,validation_examples);
    let train_after=AD.evaluate(model,saved,ATT.adapter_hidden,train_examples);
    return map{format:"pbai.neural.training.v1",artifact:artifact,
        initial_artifact:initial_artifact,train_before:train_before,train_after:train_after,
        validation_before:before,validation_after:after,steps:ad.steps,online_loss:total/ad.steps,
        candidate_improved:after.loss < before.loss and after.accuracy >= before.accuracy,
        trainable_parameters:32,base_weights_frozen:true,neural_weights_changed:json_stringify([artifact.a,artifact.b])!=json_stringify([initial_artifact.a,initial_artifact.b]),
        persists_weights:false,globally_activated:false,accepted_for_merge:false,
        artifact_authenticated:false,training_data_authenticated:false,authorizes_activation:false,
        training_digest:sha256(json_stringify(train_examples)),validation_digest:sha256(json_stringify(validation_examples)),
        options_digest:sha256(json_stringify([options.epochs,options.lr])),
        data_scope:"explicit-caller-token-examples",evaluation_scope:"distinct-input-validation-not-independent-test",
        agi_status:"not-demonstrated",asi_status:"not-demonstrated"};
}
export train, predict, valid_artifact;

fn _copy_examples(examples) {
    let out=[];
    for ex in examples { let ids=[]; for id in ex.x { push(ids,id); } push(out,map{x:ids,y:ex.y}); }
    return out;
}
fn _metric_copy(metric) {
    return map{examples:metric.examples,loss:metric.loss,correct:metric.correct,accuracy:metric.accuracy};
}
fn _finite_metric(metric) {
    return _number(metric.loss,0,1000000000000) and _number(metric.accuracy,0,1)
        and _number(metric.examples,1,32,true) and _number(metric.correct,0,metric.examples,true);
}
fn _correct_regressions(model, before_ad, after_ad, examples) {
    let count=0;
    for ex in examples {
        let hidden=ATT.head_hidden(model,ex.x);
        let old_token=CORE.argmax(AD.logits(model,hidden,before_ad));
        let new_token=CORE.argmax(AD.logits(model,hidden,after_ad));
        if old_token == ex.y and new_token != ex.y { count=count+1; }
    }
    return count;
}
fn _session_require_open(state) {
    if state.phase=="closed" {throw "neural session is closed";}
}
fn _session_status(state) {
    _session_require_open(state);
    return map{format:"pbai.neural.session.status.v1",phase:state.phase,revision:state.revision,
        active_digest:state.active.digest,evaluation_consumed:state.phase != "candidate",
        session_adapter_active:state.phase == "promoted",persists_weights:false,globally_activated:false,
        training_data_authenticated:false,independent_provenance_verified:false,
        global_session_budget_enforced:false,authorizes_activation:false,authorizes_action:false};
}
// A single training candidate, one evaluation, one promotion and one rollback.
// Handles are for single-threaded local use; no registry or external effects.
fn session(train_examples, validation_examples, options = nil) {
    _examples(train_examples); _examples(validation_examples);
    let private_train=_copy_examples(train_examples); let private_valid=_copy_examples(validation_examples);
    let trained=train(private_train,private_valid,options);
    let seen=_examples(private_train);
    for ex in private_valid { seen[_context_key(ex.x)]=true; }
    let training_gate=_finite_metric(trained.train_before) and _finite_metric(trained.train_after)
        and _finite_metric(trained.validation_before) and _finite_metric(trained.validation_after)
        and trained.train_after.loss <= trained.train_before.loss
        and trained.train_after.accuracy >= trained.train_before.accuracy
        and trained.validation_after.loss < trained.validation_before.loss
        and trained.validation_after.accuracy >= trained.validation_before.accuracy;
    // train() created these artifacts here; neither has escaped to the caller.
    let state=map{phase:"candidate",revision:0,active:trained.initial_artifact,
        baseline:trained.initial_artifact,candidate:trained.artifact,
        training:private_train,validation:private_valid,seen:seen,training_gate:training_gate};
    return _session_handle(state);
}
// Returned methods capture only this owned state, not the training call frame.
fn _session_handle(state) {
    return map{
        status:fn() { return _session_status(state); },
        predict:fn(ids) {
            _session_require_open(state);
            let result=predict(state.active,ids);
            result.stages=["session-active-artifact","neural-specialist"];
            result.session_phase=state.phase; result.session_revision=state.revision;
            return result;
        },
        evaluate:fn(test_examples) {
            _session_require_open(state);
            if state.phase != "candidate" { throw "session evaluation already consumed"; }
            _examples(test_examples);
            for ex in test_examples {
                if map_has(state.seen,_context_key(ex.x)) { throw "session test input overlaps training or validation"; }
            }
            let private_test=_copy_examples(test_examples);
            // A valid test set consumes the allowance even if quality fails.
            state.phase="rejected"; state.revision=1;
            let model=_model(); let before_ad=_adapter(model,state.baseline); let after_ad=_adapter(model,state.candidate);
            let paired=AD.evaluate_pair(model,before_ad,after_ad,ATT.adapter_hidden,private_test);
            let before=paired.baseline; let after=paired.candidate;
            let regressions=paired.baseline_correct_regressions;
            let train_regressions=_correct_regressions(model,before_ad,after_ad,state.training);
            let valid_regressions=_correct_regressions(model,before_ad,after_ad,state.validation);
            let retained_training=state.training_gate and train_regressions==0 and valid_regressions==0;
            let passed=retained_training and _finite_metric(before) and _finite_metric(after)
                and after.loss < before.loss and after.accuracy >= before.accuracy and regressions == 0;
            if passed { state.phase="evaluated"; }
            return map{format:"pbai.neural.session.evaluation.v1",passed:passed,
                baseline:_metric_copy(before),candidate:_metric_copy(after),baseline_correct_regressions:regressions,
                test_digest:sha256(json_stringify(private_test)),baseline_digest:state.baseline.digest,
                candidate_digest:state.candidate.digest,exact_input_disjointness_checked:true,
                independent_provenance_verified:false,training_gate_passed:retained_training,
                training_correct_regressions:train_regressions,validation_correct_regressions:valid_regressions,
                authorizes_activation:false,globally_activated:false,revision:state.revision};
        },
        promote:fn() {
            _session_require_open(state);
            if state.phase != "evaluated" { throw "session candidate did not pass evaluation"; }
            state.active=state.candidate; state.phase="promoted"; state.revision=2;
            return _session_status(state);
        },
        rollback:fn() {
            _session_require_open(state);
            if state.phase != "promoted" { throw "session has no promoted candidate to roll back"; }
            state.active=state.baseline; state.candidate=nil; state.phase="rolled-back"; state.revision=3;
            return _session_status(state);
        },
        close:fn() {
            if state.phase=="closed" {return false;}
            state.phase="closed";
            state.active=nil;state.baseline=nil;state.candidate=nil;
            state.training=nil;state.validation=nil;state.seen=nil;state.training_gate=nil;
            return true;
        }
    };
}
export session;

// Diagnostic distillation: a rank-1 student learns a caller-selected rank-2 teacher.
// Handles retain private in-memory weights; checkpoints export only on explicit calls.
fn _distill_metrics(model, teacher, initial, student, examples) {
    let teacher_loss=0.0;let initial_loss=0.0;let student_loss=0.0;
    let teacher_correct=0;let initial_correct=0;let student_correct=0;
    let agreement=0;let initial_agreement=0;let regressions=0;let kl=0.0;let initial_kl=0.0;
    let corrections=0;let both_wrong=0;let initial_regressions=0;
    for ex in examples {
        let h=ATT.head_hidden(model,ex.x);let t=AD.logits(model,h,teacher);
        let b=AD.logits(model,h,initial);let s=AD.logits(model,h,student);
        let target=CORE.argmax(t);let old=CORE.argmax(b);let predicted=CORE.argmax(s);
        teacher_loss=teacher_loss+CORE.cross_entropy_from_logits(t,ex.y);
        initial_loss=initial_loss+CORE.cross_entropy_from_logits(b,ex.y);
        student_loss=student_loss+CORE.cross_entropy_from_logits(s,ex.y);
        if target==ex.y {teacher_correct=teacher_correct+1;if predicted!=ex.y {regressions=regressions+1;}}
        if old==ex.y {initial_correct=initial_correct+1;if predicted!=ex.y {initial_regressions=initial_regressions+1;}}
        if target!=ex.y and predicted==ex.y {corrections=corrections+1;}
        if target!=ex.y and predicted!=ex.y {both_wrong=both_wrong+1;}
        if predicted==ex.y {student_correct=student_correct+1;}
        if predicted==target {agreement=agreement+1;}
        if old==target {initial_agreement=initial_agreement+1;}
        let q=CORE.softmax(t,1.0);let entropy=AD.soft_target_loss(t,q);
        let delta=AD.soft_target_loss(s,q)-entropy;let before_delta=AD.soft_target_loss(b,q)-entropy;
        if delta>0 {kl=kl+delta;}if before_delta>0 {initial_kl=initial_kl+before_delta;}
    }
    let n=len(examples);
    return map{format:"pbai.neural.distillation.evaluation.v1",examples:n,
        teacher:map{loss:teacher_loss/n,correct:teacher_correct,accuracy:teacher_correct/n},
        initial_student:map{loss:initial_loss/n,correct:initial_correct,accuracy:initial_correct/n},
        student:map{loss:student_loss/n,correct:student_correct,accuracy:student_correct/n},
        teacher_agreement:agreement/n,initial_teacher_agreement:initial_agreement/n,
        teacher_correct_student_wrong:regressions,teacher_wrong_student_correct:corrections,
        teacher_and_student_wrong:both_wrong,initial_student_correct_regressions:initial_regressions,teacher_student_kl:kl/n,initial_teacher_student_kl:initial_kl/n,
        exact_student_input_disjointness_checked:true,teacher_training_overlap_checked:false,
        independent_provenance_verified:false,authorizes_activation:false,globally_activated:false};
}
fn distill(teacher_artifact, contexts, validation, options=nil) {
    if not valid_artifact(teacher_artifact) {throw "invalid distillation teacher artifact";}
    if type(contexts)!="array" or len(contexts)<1 or len(contexts)>32 {throw "expected 1..32 distillation contexts";}
    let training=[];
    for ids in contexts {if not _ids(ids) {throw "invalid distillation context";}push(training,map{x:ids,y:0});}
    return _distill(teacher_artifact,training,validation,options,false);
}
// Explicit labels are supplied by the caller, not certified as ground truth.
fn distill_supervised(teacher_artifact, training, validation, options=nil) {
    if not valid_artifact(teacher_artifact) {throw "invalid distillation teacher artifact";}
    return _distill(teacher_artifact,training,validation,options,true);
}
fn _distill(teacher_artifact, training, validation, options, supervised) {
    let seen=_examples(training);_examples(validation);
    for ex in validation {if map_has(seen,_context_key(ex.x)) {throw "distillation validation overlaps training";}}
    if supervised {
        if options==nil {options=map{epochs:64,lr:0.1,temperature:2.0,hard_weight:0.5,max_grad_norm:1.0};}
        if not _keys(options,["epochs","lr","temperature","hard_weight","max_grad_norm"])
            or not _number(options.hard_weight,0,1) or not _number(options.max_grad_norm,0.000001,1000) {throw "invalid supervised distillation options";}
    } else {
        if options==nil {options=map{epochs:64,lr:0.1,temperature:2.0};}
        if not _keys(options,["epochs","lr","temperature"]) {throw "invalid distillation options";}
    }
    if not _number(options.epochs,1,128,true) or not _number(options.lr,0.000001,0.25)
        or not _number(options.temperature,0.25,8) {throw "invalid distillation options";}
    let model=_model();let teacher=_adapter(model,teacher_artifact);
    let initial=AD.lm_head_adapter(model,1,2.0,1901);let student=initial;
    let hidden=[];let targets=[];
    for ex in training {
        let h=ATT.head_hidden(model,ex.x);push(hidden,h);
        push(targets,CORE.softmax(AD.logits(model,h,teacher),options.temperature));
    }
    let total=0.0;let soft_total=0.0;let hard_total=0.0;let clipped_steps=0;let largest_norm=0.0;
    for _epoch options.epochs {for i len(training) {
        let step=nil;
        if supervised {
            step=AD.train_supervised_step_clipped(model,student,hidden[i],targets[i],training[i].y,
                options.lr,options.temperature,options.hard_weight,options.max_grad_norm);
            soft_total=soft_total+step.soft_loss;hard_total=hard_total+step.hard_loss;
            if step.gradient_clipped {clipped_steps=clipped_steps+1;}
            if step.gradient_norm>largest_norm {largest_norm=step.gradient_norm;}
        } else {step=AD.train_soft_step(model,student,hidden[i],targets[i],options.lr,options.temperature);}
        student=AD.from_state(student,step.updated_a_matrix,step.updated_b_matrix,step.loss,step.next_steps,step.next_examples);
        if not _matrix(student.a_matrix,8,1) or not _matrix(student.b_matrix,1,8) {throw "nonfinite or oversized student update";}
        total=total+step.loss;
    }}
    let private_valid=_copy_examples(validation);
    let evaluation=_distill_metrics(model,teacher,initial,student,private_valid);
    for ex in private_valid {seen[_context_key(ex.x)]=true;}
    let report=map{format:"pbai.neural.distillation.v1",training_examples:len(training),steps:student.steps,
        teacher_trainable_parameters:32,student_trainable_parameters:16,adapter_parameter_ratio:0.5,
        compression_scope:"adapter-only-shared-frozen-base",base_weights_frozen:true,
        online_soft_loss:total/student.steps,temperature:options.temperature,validation:evaluation,
        teacher_digest:teacher_artifact.digest,student_digest:sha256(json_stringify([student.a_matrix,student.b_matrix])),
        teacher_training_overlap_checked:false,persists_weights:false,globally_activated:false,
        authorizes_activation:false,accepted_for_merge:false,agi_status:"not-demonstrated",asi_status:"not-demonstrated"};
    if supervised {
        report.format="pbai.neural.supervised-distillation.v1";
        report.online_soft_loss=soft_total/student.steps;report.online_hard_loss=hard_total/student.steps;
        report.online_combined_loss=total/student.steps;report.hard_weight=options.hard_weight;
        report.max_grad_norm=options.max_grad_norm;report.clipped_steps=clipped_steps;
        report.maximum_unclipped_gradient_norm=largest_norm;report.training_labels_authenticated=false;
        report.data_scope="explicit-caller-token-examples-and-teacher-probabilities";
    }
    // Capture only owned state, not the training frame or caller input aliases.
    return _distillation_handle(map{closed:false,model:model,teacher:teacher,
        initial:initial,student:student,seen:seen,report:report});
}
fn _distillation_require_open(state) {
    if state.closed {throw "student distillation is closed";}
}
fn _distillation_handle(state) {
    return map{report:state.report,
        checkpoint:fn() {
            _distillation_require_open(state);
            return _student_artifact(state.student,sha256(json_stringify(state.model)));
        },
        predict:fn(ids) {
            _distillation_require_open(state);
            if not _ids(ids) {throw "invalid student input";}
            let raw=AD.logits(state.model,ATT.head_hidden(state.model,ids),state.student);
            return map{format:"pbai.neural.distillation.prediction.v1",token:CORE.argmax(raw),logits:raw,
                trainable_parameters:16,globally_activated:false,authorizes_action:false};
        },
        evaluate:fn(examples) {
            _distillation_require_open(state);_examples(examples);
            for ex in examples {if map_has(state.seen,_context_key(ex.x)) {throw "distillation test overlaps training or validation";}}
            return _distill_metrics(state.model,state.teacher,state.initial,state.student,_copy_examples(examples));
        },
        close:fn() {
            if state.closed {return false;}
            state.closed=true;
            state.model=nil;state.teacher=nil;state.initial=nil;state.student=nil;
            state.seen=nil;state.report=nil;
            return true;
        }
    };
}
export distill, distill_supervised;

// Rank-1 fixed-point checkpoints have a distinct format from rank-2 teachers.
let STUDENT_FORMAT="pbai.neural.student-checkpoint.v1";
let STUDENT_PROFILE="tiny-token-8-context-4-seed-77-rank-1-alpha-2-q6-v1";
fn _student_identity(base_digest,a,b,steps) {
    return sha256(json_stringify([STUDENT_FORMAT,STUDENT_PROFILE,base_digest,a,b,steps]));
}
fn _student_artifact(ad, base_digest) {
    let a=_quantize(ad.a_matrix);let b=_quantize(ad.b_matrix);
    return map{format:STUDENT_FORMAT,profile:STUDENT_PROFILE,base_digest:base_digest,
        a:a,b:b,steps:ad.steps,digest:_student_identity(base_digest,a,b,ad.steps)};
}
fn valid_student_artifact(value) {
    if not _keys(value,["format","profile","base_digest","a","b","steps","digest"]) {return false;}
    if value.format!=STUDENT_FORMAT or value.profile!=STUDENT_PROFILE {return false;}
    if type(value.base_digest)!="string" or len(value.base_digest)!=64
        or type(value.digest)!="string" or len(value.digest)!=64 {return false;}
    if not _number(value.steps,0,4096,true) or not _matrix(value.a,8,1,10000000000,true)
        or not _matrix(value.b,1,8,10000000000,true) {return false;}
    return value.base_digest==sha256(json_stringify(_model()))
        and value.digest==_student_identity(value.base_digest,value.a,value.b,value.steps);
}
fn student_encode(artifact) {
    if not valid_student_artifact(artifact) {throw "invalid student checkpoint";}
    // Validation proves a fixed, acyclic shape before serialization.
    return json_stringify(artifact);
}
// Fixed validation failures can cross cleanup scopes without losing their cause.
// Unexpected host failures still throw; no raw parser payload is exposed.
fn student_decode_result(text) {
    if type(text)!="string" or len(text)>4096 {return map{ok:false,error:"invalid student checkpoint encoding"};}
    let parsed=SER.parse_safe(text,"json",map{max_input_bytes:4096,max_depth:4,max_items:64,
        max_lines:128,max_line_bytes:4096,strict:true,reject_duplicate_keys:true});
    if not parsed.ok {return map{ok:false,error:"invalid student checkpoint encoding"};}
    if not valid_student_artifact(parsed.value) {return map{ok:false,error:"invalid student checkpoint"};}
    return map{ok:true,value:parsed.value};
}
fn student_decode(text) {
    let result=student_decode_result(text);
    if not result.ok {throw result.error;}
    return result.value;
}
export student_decode_result;
fn _student_prediction(model, student, digest, ids) {
    if not _ids(ids) {throw "invalid student input";}
    let raw=AD.logits(model,ATT.head_hidden(model,ids),student);
    return map{format:"pbai.neural.student-checkpoint.prediction.v1",token:CORE.argmax(raw),
        logits:raw,artifact_digest:digest,trainable_parameters:16,
        artifact_authenticated:false,globally_activated:false,authorizes_action:false};
}
fn student_load(artifact) {
    if not valid_student_artifact(artifact) {throw "invalid student checkpoint";}
    let model=_model();let initial=AD.lm_head_adapter(model,1,2.0,1901);
    let student=AD.from_state(initial,_dequantize(artifact.a),_dequantize(artifact.b),0,artifact.steps,artifact.steps);
    let digest=artifact.digest;let base_digest=artifact.base_digest;
    // The returned closures capture only this state, never caller artifact aliases.
    return _student_handle(map{closed:false,model:model,initial:initial,student:student,
        digest:digest,base_digest:base_digest,steps:artifact.steps});
}
fn _student_require_open(state) {
    if state.closed {throw "student checkpoint is closed";}
}
// Read-only candidate admission against the actual loaded fixed-point baseline.
// This is a bounded caller-declared check, never an activation authority.
fn _student_compare(state,candidate,examples) {
    _student_require_open(state);
    if not valid_student_artifact(candidate) {throw "invalid student checkpoint";}
    _examples(examples);
    let after=AD.from_state(state.initial,_dequantize(candidate.a),_dequantize(candidate.b),0,candidate.steps,candidate.steps);
    let pair=_review_pair(state.model,state.student,after,_copy_examples(examples));
    let non_vacuous=pair.baseline.correct>0;
    let preserved=_review_preserved(pair);
    return map{format:"pbai.neural.student-comparison.v1",passed:preserved and non_vacuous,
        non_regression_passed:preserved,non_vacuous:non_vacuous,
        baseline:pair.baseline,candidate:pair.candidate,
        baseline_correct_regressions:pair.baseline_correct_regressions,
        baseline_digest:state.digest,candidate_digest:candidate.digest,
        evaluation_weights:"loaded-fixed-point-checkpoints",evaluation_scope:"caller-declared-examples",
        prior_training_overlap_checked:false,independent_test:false,labels_authenticated:false,
        artifact_authenticated:false,repeat_attempts_globally_limited:false,
        persists_weights:false,globally_activated:false,authorizes_activation:false,authorizes_action:false};
}
fn _student_handle(state) {
    return map{
        report:map{format:"pbai.neural.student-load.v1",artifact_digest:state.digest,
            trainable_parameters:16,steps:state.steps,fixed_point_scale:1000000,
            artifact_authenticated:false,training_data_authenticated:false,
            exact_student_input_disjointness_checked:false,independent_provenance_verified:false,
            persists_weights:false,globally_activated:false,authorizes_activation:false},
        checkpoint:fn() {
            _student_require_open(state);
            return _student_artifact(state.student,state.base_digest);
        },
        predict:fn(ids) {
            _student_require_open(state);
            return _student_prediction(state.model,state.student,state.digest,ids);
        },
        evaluate:fn(examples) {
            _student_require_open(state);_examples(examples);
            let pair=AD.evaluate_pair(state.model,state.initial,state.student,ATT.adapter_hidden,examples);
            return map{format:"pbai.neural.student-checkpoint.evaluation.v1",examples:len(examples),
                initial_student:_metric_copy(pair.baseline),student:_metric_copy(pair.candidate),
                initial_student_correct_regressions:pair.baseline_correct_regressions,
                exact_student_input_disjointness_checked:false,teacher_training_overlap_checked:false,
                independent_provenance_verified:false,artifact_authenticated:false,
                authorizes_activation:false,globally_activated:false};
        },
        compare:fn(candidate,examples) {return _student_compare(state,candidate,examples);},
        close:fn() {
            if state.closed {return false;}
            state.closed=true;
            state.model=nil;state.initial=nil;state.student=nil;
            state.digest=nil;state.base_digest=nil;state.steps=nil;
            return true;
        }
    };
}
export valid_student_artifact, student_encode, student_decode, student_load;

// Caller-supplied label updates from an existing fixed-point student. The parent
// is a read-only baseline; this operation neither writes files nor activates it.
fn _continuation_metrics(model, baseline, candidate, examples) {
    let pair=AD.evaluate_pair(model,baseline,candidate,ATT.adapter_hidden,examples);
    return map{format:"pbai.neural.student-continuation.evaluation.v1",examples:len(examples),
        baseline:_metric_copy(pair.baseline),candidate:_metric_copy(pair.candidate),
        baseline_correct_regressions:pair.baseline_correct_regressions,
        current_run_input_disjointness_checked:true,prior_training_overlap_checked:false,
        independent_provenance_verified:false,authorizes_activation:false,globally_activated:false};
}
fn student_continue(artifact, training, validation, options=nil) {
    if not valid_student_artifact(artifact) {throw "invalid student checkpoint";}
    let seen=_examples(training);_examples(validation);
    for ex in validation {if map_has(seen,_context_key(ex.x)) {throw "continuation validation overlaps training";}}
    if options==nil {options=map{epochs:16,lr:0.05,max_grad_norm:1};}
    if not _keys(options,["epochs","lr","max_grad_norm"]) or not _number(options.epochs,1,128,true)
        or not _number(options.lr,0.000001,0.25) or not _number(options.max_grad_norm,0.000001,1000) {
        throw "invalid student continuation options";
    }
    let added_steps=options.epochs*len(training);
    if artifact.steps+added_steps>4096 {throw "student checkpoint cumulative step limit exceeded";}
    let private_train=_copy_examples(training);let private_valid=_copy_examples(validation);
    let model=_model();let source=AD.lm_head_adapter(model,1,2.0,1901);
    let baseline=AD.from_state(source,_dequantize(artifact.a),_dequantize(artifact.b),0,artifact.steps,artifact.steps);
    let candidate=baseline;let hidden=[];let labels=[];
    for ex in private_train {
        push(hidden,ATT.head_hidden(model,ex.x));
        let onehot=[];for i 8 {push(onehot,if i==ex.y {1} else {0});}push(labels,onehot);
    }
    let total=0.0;let clipped_steps=0;let largest_norm=0.0;
    for _epoch options.epochs {for i len(private_train) {
        // The hard-only endpoint reuses the verified joint factor-gradient clip.
        let step=AD.train_supervised_step_clipped(model,candidate,hidden[i],labels[i],private_train[i].y,
            options.lr,1,1,options.max_grad_norm);
        candidate=AD.from_state(candidate,step.updated_a_matrix,step.updated_b_matrix,step.loss,step.next_steps,step.next_examples);
        if not _matrix(candidate.a_matrix,8,1) or not _matrix(candidate.b_matrix,1,8) {throw "nonfinite or oversized continuation update";}
        total=total+step.loss;
        if step.gradient_clipped {clipped_steps=clipped_steps+1;}
        if step.gradient_norm>largest_norm {largest_norm=step.gradient_norm;}
    }}
    let training_result=_continuation_metrics(model,baseline,candidate,private_train);
    let validation_result=_continuation_metrics(model,baseline,candidate,private_valid);
    // These are diagnostics on supplied training/validation, not held-out tests.
    training_result.current_run_input_disjointness_checked=false;
    for ex in private_valid {seen[_context_key(ex.x)]=true;}
    let parent_digest=artifact.digest;let base_digest=artifact.base_digest;
    let serialized_candidate=_student_artifact(candidate,base_digest);
    let report=map{format:"pbai.neural.student-continuation.v1",parent_digest:parent_digest,
        prior_steps:artifact.steps,added_steps:added_steps,total_steps:candidate.steps,
        epochs:options.epochs,lr:options.lr,max_grad_norm:options.max_grad_norm,
        online_hard_loss:total/added_steps,clipped_steps:clipped_steps,maximum_unclipped_gradient_norm:largest_norm,
        training:training_result,validation:validation_result,trainable_parameters:16,base_weights_frozen:true,
        weights_changed:json_stringify([candidate.a_matrix,candidate.b_matrix])!=json_stringify([baseline.a_matrix,baseline.b_matrix]),
        student_digest:sha256(json_stringify([candidate.a_matrix,candidate.b_matrix])),
        checkpoint_digest:serialized_candidate.digest,
        checkpoint_weights_changed:json_stringify([serialized_candidate.a,serialized_candidate.b])!=json_stringify([artifact.a,artifact.b]),
        step_budget_scope:"checkpoint-declared-cumulative-steps",global_training_budget_enforced:false,
        checkpoint_history_authenticated:false,training_data_authenticated:false,prior_training_overlap_checked:false,
        persists_weights:false,globally_activated:false,authorizes_activation:false,accepted_for_merge:false};
    // Method closures receive only the owned state, not training-frame aliases.
    return _continuation_handle(map{closed:false,model:model,baseline:baseline,
        candidate:candidate,base_digest:base_digest,seen:seen,report:report});
}
fn _continuation_require_open(state) {
    if state.closed {throw "student continuation is closed";}
}
fn _continuation_handle(state) {
    return map{report:state.report,
        checkpoint:fn() {
            _continuation_require_open(state);
            return _student_artifact(state.candidate,state.base_digest);
        },
        predict:fn(ids) {
            _continuation_require_open(state);
            if not _ids(ids) {throw "invalid student input";}
            let raw=AD.logits(state.model,ATT.head_hidden(state.model,ids),state.candidate);
            return map{format:"pbai.neural.student-continuation.prediction.v1",token:CORE.argmax(raw),logits:raw,
                trainable_parameters:16,globally_activated:false,authorizes_action:false};
        },
        evaluate:fn(examples) {
            _continuation_require_open(state);_examples(examples);
            for ex in examples {if map_has(state.seen,_context_key(ex.x)) {throw "continuation test overlaps current training or validation";}}
            return _continuation_metrics(state.model,state.baseline,state.candidate,_copy_examples(examples));
        },
        close:fn() {
            if state.closed {return false;}
            state.closed=true;
            state.model=nil;state.baseline=nil;state.candidate=nil;
            state.base_digest=nil;state.seen=nil;state.report=nil;
            return true;
        }
    };
}
export student_continue;

// Optional declared history and one-shot local acceptance of a continuation.
// Digests bind content to a checkpoint; they do not authenticate its history.
let HISTORY_FORMAT="pbai.neural.student-history.v1";
fn _history_examples(examples) {
    if type(examples)!="array" or len(examples)<1 or len(examples)>128 {throw "expected 1..128 history examples";}
    let seen=map{};
    for ex in examples {
        if not _keys(ex,["x","y"]) or not _ids(ex.x) or not _number(ex.y,0,7,true) {throw "invalid history example";}
        let key=_context_key(ex.x);
        if map_has(seen,key) {throw "duplicate history context";}
        seen[key]=true;
    }
    return seen;
}
fn _canonical_examples(examples) {
    let out=[];
    for ex in examples {
        let ids=[];for id in ex.x {let token=id;if token==0 {token=0;}push(ids,token);}
        let label=ex.y;if label==0 {label=0;}
        push(out,map{x:ids,y:label});
    }
    return out;
}
fn _history_record(artifact, training, holdout, generation) {
    let train=_canonical_examples(training);let valid=_canonical_examples(holdout);
    return map{format:HISTORY_FORMAT,checkpoint_digest:artifact.digest,generation:generation,
        training:train,holdout:valid,
        digest:sha256(json_stringify([HISTORY_FORMAT,artifact.digest,generation,train,valid]))};
}
fn _checked_history(artifact, history) {
    if not valid_student_artifact(artifact) {throw "invalid student checkpoint";}
    if not _keys(history,["format","checkpoint_digest","generation","training","holdout","digest"])
        or history.format!=HISTORY_FORMAT or type(history.checkpoint_digest)!="string"
        or history.checkpoint_digest!=artifact.digest or not _number(history.generation,0,8,true)
        or type(history.digest)!="string" or len(history.digest)!=64 {throw "invalid student history";}
    let seen=_history_examples(history.training);_history_examples(history.holdout);
    for ex in history.holdout {if map_has(seen,_context_key(ex.x)) {throw "history split overlap";}}
    let normalized=_history_record(artifact,history.training,history.holdout,history.generation);
    if normalized.digest!=history.digest {throw "student history digest mismatch";}
    return normalized;
}
// The legacy checkpoint has no history: this seed is explicitly a caller claim.
fn student_history(artifact, training, holdout) {
    if not valid_student_artifact(artifact) {throw "invalid student checkpoint";}
    let seen=_history_examples(training);_history_examples(holdout);
    for ex in holdout {if map_has(seen,_context_key(ex.x)) {throw "history split overlap";}}
    return _history_record(artifact,training,holdout,0);
}
fn student_history_encode(artifact, history) {return json_stringify(_checked_history(artifact,history));}
fn student_history_decode(artifact, text) {
    if type(text)!="string" or len(text)>32768 {throw "invalid student history encoding";}
    let parsed=SER.parse_safe(text,"json",map{max_input_bytes:32768,max_depth:5,max_items:4096,
        max_lines:1024,max_line_bytes:32768,strict:true,reject_duplicate_keys:true});
    if not parsed.ok {throw "invalid student history encoding";}
    return _checked_history(artifact,parsed.value);
}
fn _review_pair(model, before, after, examples) {
    let pair=AD.evaluate_pair(model,before,after,ATT.adapter_hidden,examples);
    return map{baseline:_metric_copy(pair.baseline),candidate:_metric_copy(pair.candidate),
        baseline_correct_regressions:pair.baseline_correct_regressions};
}
fn _review_metric_valid(metric) {
    return _number(metric.loss,0,1000000000000) and _number(metric.accuracy,0,1)
        and _number(metric.examples,1,128,true) and _number(metric.correct,0,metric.examples,true);
}
fn _review_preserved(pair) {
    return _review_metric_valid(pair.baseline) and _review_metric_valid(pair.candidate)
        and pair.candidate.loss<=pair.baseline.loss and pair.candidate.correct>=pair.baseline.correct
        and pair.baseline_correct_regressions==0;
}
fn _review_status(state) {
    return map{format:"pbai.neural.student-review.status.v1",phase:state.phase,
        active_checkpoint_digest:if state.phase=="closed" {nil} else {state.active.digest},
        active_history_digest:if state.phase=="closed" {nil} else {state.history.digest},
        session_candidate_active:state.phase=="accepted",globally_activated:false,
        persists_weights:false,authorizes_activation:false,authorizes_action:false};
}
// A closed, single-threaded transaction: review -> explicit accept -> rollback.
// All evaluation sets are fixed before training; gate the exported q6 weights.
fn student_continue_reviewed(artifact, history, training, validation, options=nil) {
    let prior=_checked_history(artifact,history);
    if prior.generation>=8 {throw "student history generation limit exceeded";}
    let seen=_history_examples(prior.training);
    for ex in prior.holdout {seen[_context_key(ex.x)]=true;}
    _examples(training);_examples(validation);
    if len(prior.training)+len(training)>128 or len(prior.holdout)+len(validation)>128 {
        throw "student history capacity exceeded";
    }
    // Fresh-only admission covers both declared history and this candidate.
    for examples in [training,validation] {for ex in examples {
        let key=_context_key(ex.x);
        if map_has(seen,key) {throw "reviewed continuation reuses an observed context";}
        seen[key]=true;
    }}
    let private_train=_canonical_examples(training);let private_valid=_canonical_examples(validation);
    let parent=student_decode(student_encode(artifact));
    let trained=student_continue(parent,private_train,private_valid,options);
    // This intermediate handle belongs to the review constructor. Retire it on
    // either export outcome before any later reconstruction or review can fail.
    let release=trained.close;
    let candidate=try trained.checkpoint() catch nil;
    // Attempt once: cleanup must not replace the known checkpoint export cause.
    // Both booleans respect the bundled idempotent close contract; other values
    // and catchable exceptions cannot qualify successful intermediate cleanup.
    let closed=try release() catch nil;
    if candidate==nil {throw "student continuation checkpoint export failed";}
    if type(closed)!="bool" {throw "student continuation cleanup failed";}
    let model=_model();let seed=AD.lm_head_adapter(model,1,2.0,1901);
    let before=AD.from_state(seed,_dequantize(parent.a),_dequantize(parent.b),0,parent.steps,parent.steps);
    let after=AD.from_state(seed,_dequantize(candidate.a),_dequantize(candidate.b),0,candidate.steps,candidate.steps);
    let train_pair=_review_pair(model,before,after,private_train);
    let valid_pair=_review_pair(model,before,after,private_valid);
    // Evaluate every declared historical holdout, never a post-training subset.
    let retention=_review_pair(model,before,after,prior.holdout);
    let training_passed=_review_preserved(train_pair);
    let validation_passed=_review_preserved(valid_pair) and valid_pair.candidate.loss<valid_pair.baseline.loss;
    let retention_passed=_review_preserved(retention) and retention.baseline.correct>0;
    let passed=training_passed and validation_passed and retention_passed;
    let all_train=_canonical_examples(prior.training);for ex in private_train {push(all_train,ex);}
    let all_holdout=_canonical_examples(prior.holdout);for ex in private_valid {push(all_holdout,ex);}
    let next_history=_history_record(candidate,all_train,all_holdout,prior.generation+1);
    let report=map{format:"pbai.neural.student-review.v1",passed:passed,
        training_passed:training_passed,validation_passed:validation_passed,retention_passed:retention_passed,
        training:train_pair,validation:valid_pair,retention:retention,
        parent_digest:parent.digest,candidate_digest:candidate.digest,history_digest:prior.digest,
        candidate_history_digest:next_history.digest,prior_steps:parent.steps,total_steps:candidate.steps,
        declared_training_examples:len(prior.training),declared_holdout_examples:len(prior.holdout),
        history_generation:prior.generation,declared_history_disjointness_checked:true,
        history_prefix_scope:"caller-declared-unverified",history_complete_verified:false,
        independent_provenance_verified:false,history_authenticated:false,labels_authenticated:false,
        evaluation_weights:"exported-fixed-point-checkpoint",retention_scope:"all-declared-prior-holdouts",
        independent_test:false,repeat_attempts_globally_limited:false,
        base_weights_frozen:true,persists_weights:false,globally_activated:false,authorizes_activation:false};
    // Construct closures in a state-only scope, without captured training aliases.
    return _review_handle(map{phase:if passed {"reviewed"} else {"rejected"},
        active:parent,history:prior,adapter:before,model:model,
        parent:parent,candidate:candidate,prior:prior,next_history:next_history,
        before:before,after:after,report_text:json_stringify(report)});
}

fn _review_require_open(state) {
    if state.phase=="closed" {throw "student review is closed";}
}
// Only this state reaches the method closures. Close clears its private owners;
// caller exports and detached aggregate reports retain their own lifetimes.
fn _review_handle(state) {
    return map{
        report:fn() {return json_parse(state.report_text);},
        status:fn() {return _review_status(state);},
        predict:fn(ids) {
            _review_require_open(state);
            return _student_prediction(state.model,state.adapter,state.active.digest,ids);
        },
        checkpoint:fn() {_review_require_open(state);return student_decode(student_encode(state.active));},
        history:fn() {_review_require_open(state);return _checked_history(state.active,state.history);},
        accept:fn() {
            _review_require_open(state);
            if state.phase!="reviewed" {throw "student continuation did not pass review";}
            state.active=state.candidate;state.history=state.next_history;
            state.adapter=state.after;state.phase="accepted";
            return _review_status(state);
        },
        rollback:fn() {
            _review_require_open(state);
            if state.phase!="accepted" {throw "no accepted student continuation to roll back";}
            state.active=state.parent;state.history=state.prior;
            state.adapter=state.before;state.phase="rolled-back";
            return _review_status(state);
        },
        close:fn() {
            if state.phase=="closed" {return false;}
            state.phase="closed";
            state.active=nil;state.history=nil;state.adapter=nil;state.model=nil;
            state.parent=nil;state.candidate=nil;state.prior=nil;state.next_history=nil;
            state.before=nil;state.after=nil;
            return true;
        }
    };
}
export student_history, student_history_encode, student_history_decode, student_continue_reviewed;

// Small in-process protocol for tool adapters. External transports enforce their
// own byte/concurrency/auth limits; this entry point accepts bounded data only.
fn _student_tool_error(code) {
    return map{format:"pbai.neural.student-tool.v1",status:"error",result:nil,error:code};
}
fn _student_tool_result(result) {
    return map{format:"pbai.neural.student-tool.v1",status:"result",result:result,error:nil};
}
// A private batch borrows one loaded handle; its caller owns terminal cleanup.
fn _student_tool_predict_loaded(loaded,request) {
    let predictions=[];
    for i len(request.contexts) {
        let prediction=loaded.predict(request.contexts[i]);
        for value in prediction.logits {if not _number(value,-1000000000000,1000000000000) {return _student_tool_error("computation_failed");}}
        let row=map{index:i,token:prediction.token};
        if request.include_logits {row.logits=prediction.logits;}
        push(predictions,row);
    }
    return _student_tool_result(map{checkpoint_digest:loaded.report.artifact_digest,predictions:predictions,
        artifact_authenticated:false,authorizes_activation:false,authorizes_action:false,
        globally_activated:false,persists_weights:false});
}
fn _student_tool(request) {
    if type(request)!="map" or not map_has(request,"op") or type(request.op)!="string" or len(request.op)>32 {
        return _student_tool_error("invalid_request");
    }
    if request.op=="capabilities" {
        if not _keys(request,["op"]) {return _student_tool_error("invalid_request");}
        return _student_tool_result(map{operations:["capabilities","predict_batch","compare"],
            transport:"in-process-map",model_scope:"fixed-tiny-token-specialist",checkpoint_format:STUDENT_FORMAT,
            checkpoint_profile:STUDENT_PROFILE,max_contexts:32,max_context_tokens:4,vocabulary_size:8,max_examples:32,
            required_fields:map{capabilities:["op"],predict_batch:["op","checkpoint","contexts","include_logits"],
                compare:["op","baseline","candidate","examples"]},
            training:false,activation:false,persistence:false,network:false,acceptance:false,
            artifact_authenticated:false,independent_provenance_verified:false,
            agi_status:"not-demonstrated",asi_status:"not-demonstrated"});
    }
    if request.op=="predict_batch" {
        if not _keys(request,["op","checkpoint","contexts","include_logits"])
            or type(request.include_logits)!="bool" or type(request.contexts)!="array"
            or len(request.contexts)<1 or len(request.contexts)>32 {return _student_tool_error("invalid_request");}
        // Complete admission before any forward pass or returned partial result.
        for ids in request.contexts {if not _ids(ids) {return _student_tool_error("invalid_request");}}
        if not valid_student_artifact(request.checkpoint) {return _student_tool_error("invalid_checkpoint");}
        let loaded=student_load(request.checkpoint);let release=loaded.close;
        let result=try _student_tool_predict_loaded(loaded,request) catch _student_tool_error("computation_failed");
        // Preserve a known prediction failure even when the one close attempt
        // also fails. A cleanup-only failure cannot return a successful batch.
        let closed=try release() catch nil;
        if result.status=="error" {return result;}
        if type(closed)!="bool" {return _student_tool_error("cleanup_failed");}
        return result;
    }
    if request.op=="compare" {
        if not _keys(request,["op","baseline","candidate","examples"]) {return _student_tool_error("invalid_request");}
        let valid_examples=try {_examples(request.examples);true} catch false;
        if not valid_examples {return _student_tool_error("invalid_request");}
        if not valid_student_artifact(request.baseline) or not valid_student_artifact(request.candidate) {
            return _student_tool_error("invalid_checkpoint");
        }
        let model=_model();let seed=AD.lm_head_adapter(model,1,2.0,1901);
        let before=AD.from_state(seed,_dequantize(request.baseline.a),_dequantize(request.baseline.b),0,request.baseline.steps,request.baseline.steps);
        let after=AD.from_state(seed,_dequantize(request.candidate.a),_dequantize(request.candidate.b),0,request.candidate.steps,request.candidate.steps);
        let pair=_review_pair(model,before,after,request.examples);
        if not _review_metric_valid(pair.baseline) or not _review_metric_valid(pair.candidate) {return _student_tool_error("computation_failed");}
        return _student_tool_result(map{baseline_digest:request.baseline.digest,candidate_digest:request.candidate.digest,
            metrics:pair,evaluation_weights:"exported-fixed-point-checkpoints",evaluation_scope:"explicit-caller-examples",
            independent_test:false,history_overlap_checked:false,artifact_authenticated:false,
            authorizes_activation:false,authorizes_action:false,globally_activated:false,persists_weights:false});
    }
    return _student_tool_error("unsupported_operation");
}
fn student_tool(request) {return try {_student_tool(request)} catch _student_tool_error("computation_failed");}
export student_tool;
