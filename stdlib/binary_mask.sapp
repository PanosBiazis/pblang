// Bounded rectangular Boolean masks; square morphology, outside pixels are false.
let MAX_SIDE=4096; let MAX_PIXELS=4194304; let MAX_RADIUS=32;
fn _integer(value,low,high) { return type(value)=="number" and value>=low and value<=high and value==num_floor(value); }
fn validate(mask) {
    if type(mask)!="array" or len(mask)<1 or len(mask)>MAX_SIDE or type(mask[0])!="array" or len(mask[0])<1 or len(mask[0])>MAX_SIDE { throw "invalid mask dimensions"; }
    let width=len(mask[0]);let height=len(mask);
    if width*height>MAX_PIXELS { throw "mask pixel limit exceeded"; }
    for row in mask { if type(row)!="array" or len(row)!=width { throw "mask must be rectangular"; } for cell in row {if type(cell)!="bool" {throw "mask pixels must be Boolean";}} }
    return map{width:width,height:height};
}
fn create(width,height,value=false) {
    if not _integer(width,1,MAX_SIDE) or not _integer(height,1,MAX_SIDE) or width*height>MAX_PIXELS or type(value)!="bool" {throw "invalid mask dimensions or value";}
    let result=[];for y in range(0,height) {let row=[];for x in range(0,width) {array_push(row,value);}array_push(result,row);}return result;
}
fn copy(mask) {validate(mask);let out=[];for row in mask {let next=[];for cell in row {array_push(next,cell);}array_push(out,next);}return out;}
fn rectangles(width,height,regions) {
    let result=create(width,height);
    if type(regions)!="array" or len(regions)>64 {throw "invalid mask rectangles";}
    for r in regions {
        if type(r)!="map" or len(r)!=4 or not map_has(r,"x") or not map_has(r,"y") or not map_has(r,"width") or not map_has(r,"height")
            or not _integer(r.x,0,width-1) or not _integer(r.y,0,height-1) or not _integer(r.width,1,width) or not _integer(r.height,1,height)
            or r.x+r.width>width or r.y+r.height>height {throw "mask rectangle outside canvas";}
        for y in range(r.y,r.y+r.height) {for x in range(r.x,r.x+r.width) {result[y][x]=true;}}
    }
    return result;
}
fn _morph(mask,radius,erosion) {
    let size=validate(mask);
    if not _integer(radius,0,MAX_RADIUS) {throw "invalid mask radius";}
    if radius==0 {return copy(mask);}
    let width=size.width;let height=size.height;let span=2*radius+1;let horizontal=[];
    for y in range(0,height) {
        let count=0;for x in range(0,num_min(width,radius+1)) {if mask[y][x] {count=count+1;}}
        let row=[];
        for x in range(0,width) {
            array_push(row,if erosion {count==span} else {count>0});
            if x-radius>=0 and mask[y][x-radius] {count=count-1;}
            if x+radius+1<width and mask[y][x+radius+1] {count=count+1;}
        }
        array_push(horizontal,row);
    }
    let counts=[];for x in range(0,width) {let count=0;for y in range(0,num_min(height,radius+1)) {if horizontal[y][x] {count=count+1;}}array_push(counts,count);}
    let out=[];
    for y in range(0,height) {
        let row=[];
        for x in range(0,width) {
            array_push(row,if erosion {counts[x]==span} else {counts[x]>0});
            if y-radius>=0 and horizontal[y-radius][x] {counts[x]=counts[x]-1;}
            if y+radius+1<height and horizontal[y+radius+1][x] {counts[x]=counts[x]+1;}
        }
        array_push(out,row);
    }
    return out;
}
fn dilate(mask,radius=1) {return _morph(mask,radius,false);}
fn erode(mask,radius=1) {return _morph(mask,radius,true);}
fn outline(mask,radius=1) {let inner=erode(mask,radius);let out=copy(mask);for y in range(0,len(mask)) {for x in range(0,len(mask[y])) {out[y][x]=mask[y][x] and not inner[y][x];}}return out;}
fn stats(mask) {
    let size=validate(mask);let count=0;let left=size.width;let top=size.height;let right=-1;let bottom=-1;
    for y in range(0,size.height) {for x in range(0,size.width) {if mask[y][x] {count=count+1;left=num_min(left,x);top=num_min(top,y);right=num_max(right,x);bottom=num_max(bottom,y);}}}
    let bounds=if count==0 {nil} else {map{x:left,y:top,width:right-left+1,height:bottom-top+1}};
    return map{width:size.width,height:size.height,selected:count,fraction:count/(size.width*size.height),bounds:bounds};
}
fn rgba(mask) {validate(mask);let out=[];for row in mask {let pixels=[];for cell in row {let v=if cell {255} else {0};array_push(pixels,[v,v,v,255]);}array_push(out,pixels);}return out;}
export MAX_SIDE,MAX_PIXELS,MAX_RADIUS,validate,create,copy,rectangles,dilate,erode,outline,stats,rgba;

// Two opaque display colors; the Boolean selection and legacy RGBA stay unchanged.
fn rgba_colors(mask,foreground,background) {
    let Colors=import("stdlib:colors.sapp");validate(mask);let a=Colors.rgb_checked(foreground);let b=Colors.rgb_checked(background);let out=[];
    for row in mask {let pixels=[];for selected in row {let c=if selected {a} else {b};array_push(pixels,[c.r,c.g,c.b,255]);}array_push(out,pixels);}return out;
}
export rgba_colors;
