// Educational resistor networks with prescribed node voltages; no hardware effects.
let Matrix=import("stdlib:matrix.sapp");
let Serialization=import("stdlib:serialization.sapp");
let FORMAT="pblang.circuits-dc.v1";
fn _keys(value,keys) {
    if type(value)!="map" or len(value)!=len(keys) { return false; }
    for key in keys { if not map_has(value,key) { return false; } } return true;
}
fn _id(id) {
    if type(id)!="string" or len(id)<1 or len(id)>32 { return false; }
    for i in range(0,len(id)) { if str_index_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-",str_slice(id,i,i+1))<0 { return false; } } return true;
}
fn validate(model) {
    if not _keys(model,["format","nodes","fixed","resistors"]) or model.format!=FORMAT
        or type(model.nodes)!="array" or len(model.nodes)<2 or len(model.nodes)>16
        or type(model.fixed)!="map" or len(model.fixed)<1 or len(model.fixed)>len(model.nodes)
        or type(model.resistors)!="array" or len(model.resistors)<1 or len(model.resistors)>32 { throw "circuits: invalid network"; }
    let nodes=map{};
    for id in model.nodes { if not _id(id) or map_has(nodes,id) { throw "circuits: invalid node"; } nodes[id]=true; }
    let anchored=map{};
    for id in map_keys(model.fixed) {
        let v=model.fixed[id];
        if not map_has(nodes,id) or type(v)!="number" or not (v>= -1000 and v<=1000) { throw "circuits: invalid prescribed voltage"; }
        anchored[id]=true;
    }
    let seen=map{};
    for r in model.resistors {
        if not _keys(r,["id","a","b","ohms"]) or not _id(r.id) or map_has(seen,r.id)
            or type(r.a)!="string" or type(r.b)!="string" or not map_has(nodes,r.a) or not map_has(nodes,r.b) or r.a==r.b
            or type(r.ohms)!="number" or not (r.ohms>=1 and r.ohms<=1000000) { throw "circuits: invalid resistor"; }
        seen[r.id]=true;
    }
    // Every component must touch at least one prescribed voltage.
    for pass in range(0,len(model.nodes)) {
        for r in model.resistors {
            if map_has(anchored,r.a) { anchored[r.b]=true; }
            if map_has(anchored,r.b) { anchored[r.a]=true; }
        }
    }
    if len(anchored)!=len(nodes) { throw "circuits: floating component"; }
    return true;
}
fn decode(text) {
    let parsed=Serialization.parse_safe(text,"json",map{max_input_bytes:32768,max_depth:5,max_items:1024,strict:true,reject_duplicate_keys:true});
    if not parsed.ok or not parsed.duplicate_keys_checked { throw "circuits: invalid file"; }
    validate(parsed.value); return parsed.value;
}
fn solve(model) {
    validate(model); let unknown=[]; let index=map{}; let volts=map{};
    for id in model.nodes {
        if map_has(model.fixed,id) { volts[id]=model.fixed[id]; }
        else { index[id]=len(unknown); array_push(unknown,id); }
    }
    if len(unknown)>0 {
        let a=Matrix.zeros(len(unknown),len(unknown)); let b=[];
        for id in unknown { array_push(b,0); }
        for r in model.resistors {
            let g=1/r.ohms;
            for ends in [[r.a,r.b],[r.b,r.a]] {
                if map_has(index,ends[0]) {
                    let i=index[ends[0]]; a[i][i]=a[i][i]+g;
                    if map_has(index,ends[1]) { let j=index[ends[1]]; a[i][j]=a[i][j]-g; }
                    else { b[i]=b[i]+g*volts[ends[1]]; }
                }
            }
        }
        let x=Matrix.solve(a,b);
        for i in range(0,len(unknown)) {
            if not (x[i]>= -1000.000001 and x[i]<=1000.000001) { throw "circuits: numerical failure"; }
            volts[unknown[i]]=x[i];
        }
    }
    let currents=[]; let balance=map{}; let magnitude=map{}; let power=0; let residual=0;
    for id in model.nodes { balance[id]=0; magnitude[id]=0; }
    for r in model.resistors {
        let drop=volts[r.a]-volts[r.b]; let current=drop/r.ohms; let watts=drop*current;
        array_push(currents,map{id:r.id,from:r.a,to:r.b,voltage_drop:drop,current_amperes:current,power_watts:watts});
        balance[r.a]=balance[r.a]+current; balance[r.b]=balance[r.b]-current;
        magnitude[r.a]=magnitude[r.a]+num_abs(current); magnitude[r.b]=magnitude[r.b]+num_abs(current); power=power+watts;
    }
    for id in unknown {
        residual=num_max(residual,num_abs(balance[id]));
        if num_abs(balance[id])>0.00000001*num_max(1,magnitude[id]) { throw "circuits: current balance failed"; }
    }
    return map{format:"pblang.circuits-dc-result.v1",node_volts:volts,resistors:currents,total_power_watts:power,
        maximum_kcl_residual_amperes:residual,educational_only:true,hardware_access:false};
}
fn divider(vin=5,top=1000,bottom=1000) {
    let model=map{format:FORMAT,nodes:["ground","supply","output"],fixed:map{ground:0,supply:vin},
        resistors:[map{id:"R1",a:"supply",b:"output",ohms:top},map{id:"R2",a:"output",b:"ground",ohms:bottom}]};
    validate(model); return model;
}
export FORMAT,validate,decode,solve,divider;
