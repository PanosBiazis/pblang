let I=import("stdlib:interpolation_table.sapp");let UI=import("stdlib:modern_ui.sapp");
fn line(r,index){if index>=r.rows{return "End of results";}let row=r.document.cells[index+1];return "Query "+row[0]+" = "+row[1];}
fn create(samples,queries){let r=I.create(samples,queries);let pages=num_ceil(r.rows/4);let children=[UI.heading("PBInterpolate"),UI.text("Samples: "+str(r.samples)+" | Queries: "+str(r.rows)),UI.text("Piecewise linear values within the sample range."),UI.text("Page 1 / "+str(pages),map{name:"page_label"})];
 for slot in range(0,4){array_push(children,UI.text(line(r,slot),map{name:"result_"+str(slot)}));}
 let buttons=[];for page in range(0,pages){let actions=[UI.action_set_text("page_label","Page "+str(page+1)+" / "+str(pages))];for slot in range(0,4){array_push(actions,UI.action_set_text("result_"+str(slot),line(r,page*4+slot)));}array_push(buttons,UI.button("Page "+str(page+1),UI.action_sequence(actions)));}
 array_push(children,UI.grid(buttons,map{columns:4}));array_push(children,UI.text("Query order and duplicates retained. No extrapolation."));array_push(children,UI.text("Read-only snapshot. No sensor, time inference or unit conversion."));return UI.screen(children);
}
export create;
