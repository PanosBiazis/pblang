// stdlib/desktop_media/index.sapp — Unified Desktop, Wayland GPU Compositor,
// Cross-OS Native Integration & Real-Time Audio/Camera Namespace (PBLang v4.2.0)

let Compositor = import("stdlib:desktop_media/wayland_gpu_compositor.sapp");
let NativeOS = import("stdlib:desktop_media/os_native_integration.sapp");
let Media = import("stdlib:desktop_media/realtime_audio_camera.sapp");

let DESKTOP_MEDIA_VERSION = "4.2.0";
let PERMISSION_DENIED_MIC = Media.PERMISSION_DENIED_MIC;
let PERMISSION_DENIED_CAMERA = Media.PERMISSION_DENIED_CAMERA;

fn desktop_media_status() {
    return map{
        ok: true,
        version: DESKTOP_MEDIA_VERSION,
        gpu_compositor: Compositor.probe_display_gpu_stack(),
        os_integration: NativeOS.probe_os_desktop_capabilities(),
        audio_backends: Media.probe_audio_backends(),
        camera_backends: Media.probe_camera_backends()
    };
}

// Re-export Compositor APIs
fn probe_display_gpu_stack() { return Compositor.probe_display_gpu_stack(); }
fn create_gpu_surface(opts = nil) { return Compositor.create_gpu_surface(opts); }
fn composite_layers_rgba(surface, layers, opts = nil) { return Compositor.composite_layers_rgba(surface, layers, opts); }
fn mark_surface_dirty_rect(surface, x, y, width, height) { return Compositor.mark_surface_dirty_rect(surface, x, y, width, height); }
fn compute_fractional_hidpi_metrics(w, h, scale_120ths) { return Compositor.compute_fractional_hidpi_metrics(w, h, scale_120ths); }
fn configure_surface_capture_shield(surface, opts = nil) { return Compositor.configure_surface_capture_shield(surface, opts); }
fn handle_surface_security_event(surface, ev) { return Compositor.handle_surface_security_event(surface, ev); }

// Re-export Cross-OS Native Desktop APIs
fn create_virtual_desktop_bus() { return NativeOS.create_virtual_desktop_bus(); }
fn open_file_dialog(opts = nil) { return NativeOS.open_file_dialog(opts); }
fn save_file_dialog(opts = nil) { return NativeOS.save_file_dialog(opts); }
fn select_folder_dialog(opts = nil) { return NativeOS.select_folder_dialog(opts); }
fn clipboard_get_text(opts = nil) { return NativeOS.clipboard_get_text(opts); }
fn clipboard_set_text(text, opts = nil) { return NativeOS.clipboard_set_text(text, opts); }
fn clipboard_set_sensitive(text, ttl_ms = 15000, opts = nil) { return NativeOS.clipboard_set_sensitive(text, ttl_ms, opts); }
fn clipboard_clear(opts = nil) { return NativeOS.clipboard_clear(opts); }
fn parse_uri_list_drop(payload, opts = nil) { return NativeOS.parse_uri_list_drop(payload, opts); }
fn register_drop_zone(win, callback, opts = nil) { return NativeOS.register_drop_zone(win, callback, opts); }
fn dispatch_drop_event(win, payload, x = 0, y = 0, opts = nil) { return NativeOS.dispatch_drop_event(win, payload, x, y, opts); }
fn create_tray_icon(spec, opts = nil) { return NativeOS.create_tray_icon(spec, opts); }
fn send_desktop_notification(title, body, opts = nil) { return NativeOS.send_desktop_notification(title, body, opts); }

// Re-export Real-Time Audio & Camera APIs
fn issue_media_consent_token(kind, session_id, ttl_ms = 60000, now_ms_val = nil) {
    return Media.issue_media_consent_token(kind, session_id, ttl_ms, now_ms_val);
}
fn revoke_media_consent_token(tok) { return Media.revoke_media_consent_token(tok); }
fn probe_audio_backends() { return Media.probe_audio_backends(); }
fn open_audio_capture_stream(opts = nil) { return Media.open_audio_capture_stream(opts); }
fn capture_audio_frames(stream, frames = 512, opts = nil) { return Media.capture_audio_frames(stream, frames, opts); }
fn compute_audio_level_meter(audio) { return Media.compute_audio_level_meter(audio); }
fn compute_audio_spectrum_bands(audio, sr = 48000, bands = 8) { return Media.compute_audio_spectrum_bands(audio, sr, bands); }
fn apply_noise_and_echo_gate(audio, opts = nil) { return Media.apply_noise_and_echo_gate(audio, opts); }
fn export_audio_wav_bytes(audio) { return Media.export_audio_wav_bytes(audio); }
fn decode_audio_wav_bytes(bytes) { return Media.decode_audio_wav_bytes(bytes); }
fn probe_camera_backends() { return Media.probe_camera_backends(); }
fn convert_yuyv422_to_rgba(yuyv, w, h) { return Media.convert_yuyv422_to_rgba(yuyv, w, h); }
fn convert_nv12_to_rgba(nv12, w, h) { return Media.convert_nv12_to_rgba(nv12, w, h); }
fn open_camera_stream(opts = nil) { return Media.open_camera_stream(opts); }
fn capture_camera_frame(stream, opts = nil) { return Media.capture_camera_frame(stream, opts); }

export DESKTOP_MEDIA_VERSION, PERMISSION_DENIED_MIC, PERMISSION_DENIED_CAMERA;
export Compositor, NativeOS, Media, desktop_media_status;
export probe_display_gpu_stack, create_gpu_surface, composite_layers_rgba, mark_surface_dirty_rect;
export compute_fractional_hidpi_metrics, configure_surface_capture_shield, handle_surface_security_event;
export create_virtual_desktop_bus, open_file_dialog, save_file_dialog, select_folder_dialog;
export clipboard_get_text, clipboard_set_text, clipboard_set_sensitive, clipboard_clear;
export parse_uri_list_drop, register_drop_zone, dispatch_drop_event;
export create_tray_icon, send_desktop_notification;
export issue_media_consent_token, revoke_media_consent_token;
export probe_audio_backends, open_audio_capture_stream, capture_audio_frames;
export compute_audio_level_meter, compute_audio_spectrum_bands, apply_noise_and_echo_gate;
export export_audio_wav_bytes, decode_audio_wav_bytes;
export probe_camera_backends, convert_yuyv422_to_rgba, convert_nv12_to_rgba;
export open_camera_stream, capture_camera_frame;
