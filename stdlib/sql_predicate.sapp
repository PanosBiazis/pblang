// Pure SQLite/current-ORM filter construction. No execution or authorization.
// Terms are a nonempty flat array of [column, lowercase operator, value].
// Callers accepting untrusted collections must enforce their own resource policy.
// Private: compile_all checks the string type before comparing or quoting.
fn _quote_string_column(value) {
    let size = len(value);
    if size == 0 or size > 64 { throw "sql predicate: invalid column"; }
    let i = 0;
    while i < size {
        let c = strcharcodeat(value, i);
        let alpha = (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
        let digit = c >= 48 and c <= 57;
        if not alpha and (i == 0 or not digit) { throw "sql predicate: invalid column"; }
        i = i + 1;
    }
    return "[" + value + "]";
}

fn _operator(value) {
    if type(value) != "string" { throw "sql predicate: invalid operator"; }
    if value == "eq" { return "="; }
    if value == "ne" { return "<>"; }
    if value == "lt" { return "<"; }
    if value == "le" { return "<="; }
    if value == "gt" { return ">"; }
    if value == "ge" { return ">="; }
    if value == "like" { return "LIKE"; }
    if value == "in" { return "IN"; }
    if value == "not_in" { return "NOT IN"; }
    throw "sql predicate: invalid operator";
}

fn compile_all(terms) {
    if type(terms) != "array" { throw "sql predicate: invalid terms"; }
    if len(terms) == 0 { throw "sql predicate: invalid terms"; }
    let pieces = [];
    let params = [];
    let previous = nil;
    let column = "";
    for term in terms {
        if type(term) != "array" { throw "sql predicate: invalid term"; }
        if len(term) != 3 { throw "sql predicate: invalid term"; }
        let name = term[0];
        // Type-gate before equality: map operators may execute caller code.
        // Keep just one validated name for this call, never parameters or rows.
        if type(name) != "string" { throw "sql predicate: invalid column"; }
        if name != previous {
            column = _quote_string_column(name);
            previous = name;
        }
        let op = _operator(term[1]);
        let value = term[2];
        let kind = type(value);
        if op == "IN" or op == "NOT IN" {
            if kind != "array" { throw "sql predicate: invalid value"; }
            let markers = [];
            for member in value {
                let member_kind = type(member);
                if member_kind != "nil" and member_kind != "number" and member_kind != "string" and member_kind != "bool" { throw "sql predicate: invalid value"; }
                if member_kind == "number" {
                    let delta = member - member;
                    if delta != 0 { throw "sql predicate: invalid value"; }
                }
                array_push(markers, "?");
                array_push(params, member);
            }
            // Keep column resolution and SQL empty-set semantics, including NULL.
            let rhs = "SELECT 1 WHERE 0";
            if len(markers) != 0 { rhs = str_join(markers, ", "); }
            array_push(pieces, "(" + column + " " + op + " (" + rhs + "))");
        } else if kind == "nil" {
            if op == "=" { array_push(pieces, "(" + column + " IS NULL)"); }
            else {
                if op != "<>" { throw "sql predicate: invalid value"; }
                array_push(pieces, "(" + column + " IS NOT NULL)");
            }
        } else {
            if kind != "number" and kind != "string" and kind != "bool" { throw "sql predicate: invalid value"; }
            if kind == "number" {
                let delta = value - value;
                if delta != 0 { throw "sql predicate: invalid value"; }
            }
            if op == "LIKE" and kind != "string" { throw "sql predicate: invalid value"; }
            array_push(pieces, "(" + column + " " + op + " ?)");
            array_push(params, value);
        }
    }
    return map{sql: str_join(pieces, " AND "), params: params};
}

export compile_all;
