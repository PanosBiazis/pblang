// stdlib/platform_emulator.sapp -- bounded cross-platform process/ABI model.
//
// This is an executable userspace contract for code generators and tests. It
// models target metadata, paths, memory, files, environment, deterministic
// clock/random services, and a small portable syscall surface. It deliberately
// does not claim to emulate a complete proprietary or open-source kernel.

let MACHINE_FORMAT = "pblang.platform.machine.v1";
let PROFILE_FORMAT = "pblang.platform.profile.v1";

fn _finite_number(value) {
    let text = str_lower(str_trim(str(value)));
    if text == "nan" or text == "+nan" or text == "-nan" or
       text == "inf" or text == "+inf" or text == "-inf" or
       text == "infinity" or text == "+infinity" or text == "-infinity" { return nil; }
    let n = try parse_number(text) catch nil;
    if n == nil or not is_number(n) { return nil; }
    return n;
}

fn _bounded_option(value, name, low, high) {
    let n = _finite_number(value);
    if n == nil or num_floor(n) != n or n < low or n > high {
        throw "platform_emulator.machine: " + name + " must be " + str(low) + ".." + str(high);
    }
    return n;
}

fn _row(os, min_version, arches, abi, executable, syscall_model, path_separator, line_ending, mobile, sandboxed) {
    return map{
        os: os, min_version: min_version, arches: arches, abi: abi,
        executable: executable, syscall_model: syscall_model,
        path_separator: path_separator, line_ending: line_ending,
        mobile: mobile, sandboxed: sandboxed
    };
}

fn _build_catalog() {
    return [
        _row("linux", "2.6", ["x86", "x86_64", "armv7", "arm64", "mips32", "powerpc32", "powerpc64", "riscv32", "riscv64", "sparc-v8"], "sysv", "elf", "linux", "/", "\n", false, false),
        _row("windows", "5.1", ["x86", "x86_64", "arm64"], "windows", "pe", "nt", "\\", "\r\n", false, false),
        _row("macos", "10.6", ["x86_64", "arm64"], "darwin", "mach-o", "darwin", "/", "\n", false, false),
        _row("android", "21", ["armv7", "arm64", "x86", "x86_64"], "bionic", "elf", "linux-android", "/", "\n", true, true),
        _row("ios", "11", ["arm64", "x86_64", "arm64-simulator"], "darwin-mobile", "mach-o", "darwin-ios", "/", "\n", true, true),
        _row("freebsd", "12", ["x86_64", "arm64", "riscv64"], "freebsd", "elf", "freebsd", "/", "\n", false, false),
        _row("openbsd", "7", ["x86_64", "arm64", "riscv64"], "openbsd", "elf", "openbsd", "/", "\n", false, false),
        _row("netbsd", "9", ["x86", "x86_64", "armv7", "arm64", "mips32", "powerpc32", "sparc-v8"], "netbsd", "elf", "netbsd", "/", "\n", false, false),
        _row("solaris", "11", ["x86_64", "sparc-v8"], "sysv-solaris", "elf", "solaris", "/", "\n", false, false),
        _row("haiku", "1", ["x86", "x86_64"], "haiku", "elf", "haiku", "/", "\n", false, false),
        _row("wasi", "1", ["wasm32"], "wasi", "wasm", "wasi-preview1", "/", "\n", false, true),
        _row("dos", "2", ["x86"], "dos", "mz", "dos-int21", "\\", "\r\n", false, false),
        _row("cpm", "2.2", ["z80"], "cpm", "com", "bdos", "\\", "\r\n", false, false),
        _row("amigaos", "1", ["m68k", "powerpc32"], "amiga", "hunk", "exec", "/", "\n", false, false),
        _row("os2", "2", ["x86"], "os2", "lx", "os2", "\\", "\r\n", false, false),
        _row("plan9", "4", ["x86", "x86_64", "armv7", "arm64"], "plan9", "plan9-aout", "plan9", "/", "\n", false, false),
        _row("qnx", "6.5", ["x86", "x86_64", "armv7", "arm64"], "qnx-nto", "elf", "qnx", "/", "\n", false, false),
        _row("freertos", "8", ["avr", "msp430", "armv7", "riscv32"], "freestanding", "firmware", "freertos", "/", "\n", false, true),
        _row("zephyr", "2", ["x86", "x86_64", "armv7", "arm64", "riscv32", "riscv64"], "freestanding", "elf", "zephyr", "/", "\n", false, true),
        _row("nuttx", "10", ["armv7", "arm64", "riscv32", "riscv64", "x86"], "posix-rtos", "elf", "nuttx", "/", "\n", false, true),
        _row("vxworks", "6", ["x86", "x86_64", "armv7", "arm64", "mips32", "powerpc32", "sparc-v8"], "vxworks", "elf", "vxworks", "/", "\n", false, true),
        _row("baremetal", "1", ["6502", "z80", "avr", "msp430", "x86", "armv7", "arm64", "m68k", "mips32", "powerpc32", "riscv32", "riscv64", "sparc-v8"], "freestanding", "firmware", "none", "/", "\n", false, true),
        _row("aix", "7", ["powerpc32", "powerpc64"], "aix", "xcoff", "aix", "/", "\n", false, false),
        _row("hpux", "11", ["hppa64", "ia64"], "hpux", "elf", "hpux", "/", "\n", false, false),
        _row("irix", "6.5", ["mips32"], "irix", "elf", "irix", "/", "\n", false, false),
        _row("chromeos", "1", ["x86_64", "arm64"], "linux-chromeos", "elf", "linux", "/", "\n", false, true),
        _row("fuchsia", "1", ["x86_64", "arm64"], "zircon", "elf", "zircon", "/", "\n", false, true),
        _row("tizen", "2", ["x86", "x86_64", "armv7", "arm64"], "linux-tizen", "elf", "linux", "/", "\n", true, true),
        _row("webos", "3", ["x86_64", "armv7", "arm64"], "linux-webos", "elf", "linux", "/", "\n", true, true)
    ];
}

let _CATALOG = _build_catalog();
let _CATALOG_BY_OS = map{};
let _catalog_index = 0;
while _catalog_index < len(_CATALOG) {
    _CATALOG_BY_OS[_CATALOG[_catalog_index].os] = _CATALOG[_catalog_index];
    _catalog_index = _catalog_index + 1;
}

fn catalog() { return _CATALOG; }

fn _canonical_os(value) {
    let os = str_lower(str(value ?? ""));
    if os == "win" or os == "win32" or os == "win64" or os == "windows-nt" { return "windows"; }
    if os == "darwin" or os == "osx" or os == "mac" { return "macos"; }
    if os == "iphoneos" or os == "ipados" { return "ios"; }
    if os == "illumos" or os == "sunos" { return "solaris"; }
    if os == "web" or os == "webassembly" or os == "wasm" { return "wasi"; }
    if os == "msdos" or os == "pcdos" { return "dos"; }
    if os == "cp/m" or os == "cp-m" { return "cpm"; }
    if os == "amiga" or os == "aros" { return "amigaos"; }
    if os == "os/2" { return "os2"; }
    if os == "free-rtos" { return "freertos"; }
    if os == "chrome-os" or os == "chromiumos" { return "chromeos"; }
    if os == "web-os" or os == "lg-webos" { return "webos"; }
    return os;
}

fn _canonical_arch(value) {
    let arch = str_lower(str(value ?? ""));
    if arch == "amd64" or arch == "x64" { return "x86_64"; }
    if arch == "i386" or arch == "i486" or arch == "i586" or arch == "i686" { return "x86"; }
    if arch == "aarch64" { return "arm64"; }
    if arch == "arm" or arch == "armeabi-v7a" { return "armv7"; }
    if arch == "rv64" or arch == "risc-v64" { return "riscv64"; }
    if arch == "rv32" or arch == "risc-v32" { return "riscv32"; }
    if arch == "mips" { return "mips32"; }
    if arch == "ppc" or arch == "powerpc" { return "powerpc32"; }
    if arch == "ppc64" or arch == "powerpc-64" { return "powerpc64"; }
    if arch == "sparc" { return "sparc-v8"; }
    if arch == "wasm" { return "wasm32"; }
    if arch == "mos6502" { return "6502"; }
    if arch == "atmega" or arch == "atmega328p" { return "avr"; }
    if arch == "68000" or arch == "motorola68k" { return "m68k"; }
    if arch == "hppa" or arch == "pa-risc" { return "hppa64"; }
    return arch;
}

fn _version_parts(value) {
    let raw = str(value ?? "0");
    let cut = str_index_of(raw, "-");
    if cut >= 0 { raw = str_slice(raw, 0, cut); }
    let pieces = str_split(raw, ".");
    let out = [];
    let i = 0;
    while i < 4 {
        let n = 0;
        if i < len(pieces) { n = try parse_number(pieces[i]) catch 0; }
        if not is_number(n) or n < 0 { n = 0; }
        array_push(out, num_floor(n));
        i = i + 1;
    }
    return out;
}

fn compare_versions(a, b) {
    let av = _version_parts(a); let bv = _version_parts(b); let i = 0;
    while i < 4 {
        if av[i] < bv[i] { return -1; }
        if av[i] > bv[i] { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _contains(values, wanted) {
    let i = 0; while i < len(values) { if values[i] == wanted { return true; } i = i + 1; }
    return false;
}

fn _pointer_bits(arch) {
    if arch == "6502" or arch == "z80" or arch == "avr" or arch == "msp430" { return 16; }
    if arch == "x86" or arch == "armv7" or arch == "m68k" or arch == "mips32" or arch == "powerpc32" or arch == "riscv32" or arch == "sparc-v8" or arch == "wasm32" { return 32; }
    return 64;
}

fn _endian(arch) {
    if arch == "m68k" or arch == "powerpc32" or arch == "powerpc64" or arch == "sparc-v8" or arch == "hppa64" { return "big"; }
    return "little";
}

fn _realtime(os) {
    return os == "qnx" or os == "freertos" or os == "zephyr" or os == "nuttx" or os == "vxworks" or os == "baremetal";
}

fn _device_classes(os) {
    if os == "android" or os == "ios" { return ["smartphone", "tablet", "wearable", "automotive"]; }
    if os == "freertos" or os == "zephyr" or os == "nuttx" or os == "baremetal" { return ["microcontroller", "sensor", "appliance", "router", "satellite", "automotive"]; }
    if os == "vxworks" or os == "qnx" { return ["embedded", "router", "satellite", "automotive", "industrial"]; }
    if os == "wasi" { return ["browser", "edge", "server", "embedded"]; }
    if os == "dos" or os == "cpm" or os == "amigaos" or os == "os2" { return ["retro-computer", "calculator", "appliance"]; }
    if os == "chromeos" { return ["desktop", "laptop", "tablet"]; }
    if os == "fuchsia" { return ["embedded", "smartphone", "desktop"]; }
    if os == "tizen" or os == "webos" { return ["smart-tv", "wearable", "appliance"]; }
    return ["desktop", "laptop", "server", "workstation"];
}

fn _profile_error(os, version, arch, reason) {
    return map{ ok: false, format: PROFILE_FORMAT, os: os, version: version, arch: arch, error: reason };
}

fn resolve(os_value, version_value, arch_value, options = nil) {
    let os = _canonical_os(os_value); let arch = _canonical_arch(arch_value);
    let version = str(version_value ?? "0");
    let row = nil;
    if map_has(_CATALOG_BY_OS, os) { row = _CATALOG_BY_OS[os]; }
    if row == nil { return _profile_error(os, version, arch, "unsupported operating-system family"); }
    if compare_versions(version, row.min_version) < 0 {
        return _profile_error(os, version, arch, "version predates the verified compatibility floor " + row.min_version);
    }
    if not _contains(row.arches, arch) { return _profile_error(os, version, arch, "architecture is not valid for this OS family"); }

    // Historical architecture availability gates prevent impossible profiles.
    if os == "windows" and arch == "arm64" and compare_versions(version, "10") < 0 {
        return _profile_error(os, version, arch, "Windows arm64 requires version 10 or newer");
    }
    if os == "macos" and arch == "arm64" and compare_versions(version, "11") < 0 {
        return _profile_error(os, version, arch, "macOS arm64 requires version 11 or newer");
    }
    if os == "ios" and arch == "x86_64" and compare_versions(version, "17") >= 0 {
        return _profile_error(os, version, arch, "iOS 17+ simulators require arm64-simulator");
    }
    if os == "linux" and arch == "arm64" and compare_versions(version, "3.7") < 0 {
        return _profile_error(os, version, arch, "Linux arm64 requires kernel 3.7 or newer");
    }
    if os == "linux" and (arch == "riscv32" or arch == "riscv64") and compare_versions(version, "4.15") < 0 {
        return _profile_error(os, version, arch, "Linux RISC-V requires kernel 4.15 or newer");
    }

    let libc = "none";
    if os == "linux" { libc = "glibc"; }
    if os == "android" { libc = "bionic"; }
    if os == "macos" or os == "ios" { libc = "libSystem"; }
    if os == "windows" { libc = "ucrt"; }
    if os == "freebsd" { libc = "freebsd-libc"; }
    if os == "openbsd" { libc = "openbsd-libc"; }
    if os == "netbsd" { libc = "netbsd-libc"; }
    if os == "solaris" { libc = "solaris-libc"; }
    if os == "haiku" { libc = "haiku-libroot"; }
    if os == "qnx" { libc = "qnx-libc"; }
    if os == "nuttx" or os == "zephyr" { libc = "newlib"; }
    if os == "aix" { libc = "aix-libc"; }
    if os == "hpux" { libc = "hpux-libc"; }
    if os == "irix" { libc = "irix-libc"; }
    if os == "chromeos" { libc = "glibc"; }
    if os == "tizen" or os == "webos" { libc = "glibc"; }
    if options != nil and is_map(options) and map_has(options, "libc") { libc = str(options.libc); }
    if os == "linux" and libc != "glibc" and libc != "musl" and libc != "none" {
        return _profile_error(os, version, arch, "Linux libc must be glibc, musl, or none");
    }

    let root = "/";
    if os == "windows" or os == "dos" or os == "os2" { root = "C:\\"; }
    if os == "cpm" { root = "A:\\"; }
    if os == "android" { root = "/data/user/0/pblang"; }
    if os == "ios" { root = "/sandbox/pblang"; }
    if os == "wasi" { root = "/sandbox"; }
    return map{
        ok: true, format: PROFILE_FORMAT, os: os, version: version, arch: arch,
        pointer_bits: _pointer_bits(arch), endian: _endian(arch), abi: row.abi,
        libc: libc, executable_format: row.executable, syscall_model: row.syscall_model,
        path_separator: row.path_separator, line_ending: row.line_ending,
        mobile: row.mobile, sandboxed: row.sandboxed, root: root,
        realtime: _realtime(os), device_classes: _device_classes(os),
        min_version: row.min_version, compatibility: "same-family backward userspace contract",
        boundary: "bounded userspace/ABI model; not a complete kernel or proprietary framework emulator"
    };
}

fn _map_or(values, key, fallback) {
    if map_has(values, key) { return values[key]; }
    return fallback;
}

fn _utf8_bytes(value) { return len(str_to_bytes(str(value ?? ""))); }

fn custom_profile(spec) {
    if spec == nil or not is_map(spec) { return _profile_error("", "", "", "custom profile must be a map"); }
    let required = ["os", "version", "arch", "abi", "executable_format", "syscall_model"];
    let i = 0;
    while i < len(required) {
        let field = required[i];
        if not map_has(spec, field) or len(str(spec[field])) == 0 {
            return _profile_error(str(_map_or(spec, "os", "")), str(_map_or(spec, "version", "")), str(_map_or(spec, "arch", "")), "missing custom profile field: " + field);
        }
        i = i + 1;
    }
    let arch = _canonical_arch(spec.arch); let separator = "/"; let ending = "\n";
    if map_has(spec, "path_separator") { separator = str(spec.path_separator); }
    if map_has(spec, "line_ending") { ending = str(spec.line_ending); }
    if separator != "/" and separator != "\\" {
        return _profile_error(str(spec.os), str(spec.version), arch, "path separator must be slash or backslash");
    }
    let default_root = if separator == "\\" { "C:\\" } else { "/" };
    return map{
        ok: true, format: PROFILE_FORMAT, os: _canonical_os(spec.os), version: str(spec.version), arch: arch,
        pointer_bits: _pointer_bits(arch), endian: _endian(arch), abi: str(spec.abi), libc: str(_map_or(spec, "libc", "none")),
        executable_format: str(spec.executable_format), syscall_model: str(spec.syscall_model),
        path_separator: separator, line_ending: ending, mobile: _map_or(spec, "mobile", false),
        sandboxed: _map_or(spec, "sandboxed", true), root: str(_map_or(spec, "root", default_root)), realtime: _map_or(spec, "realtime", false),
        device_classes: _map_or(spec, "device_classes", ["custom"]), min_version: str(spec.version),
        compatibility: "explicit user-defined contract only",
        boundary: "unverified custom userspace contract; add conformance tests before backend claims"
    };
}

fn compatible(host, target) {
    if host == nil or target == nil or not host.ok or not target.ok { return false; }
    if host.os != target.os { return false; }
    if compare_versions(host.version, target.version) < 0 { return false; }
    if host.arch == target.arch { return true; }
    if host.arch == "x86_64" and target.arch == "x86" and (host.os == "linux" or host.os == "windows") { return true; }
    if host.arch == "arm64" and target.arch == "x86_64" and host.os == "macos" { return true; }
    if host.arch == "arm64-simulator" and target.arch == "x86_64" and host.os == "ios" { return true; }
    return false;
}

fn isa_model(profile) {
    if profile == nil or not profile.ok { return map{ verified: false, model: "", module: "", test: "" }; }
    let arch = profile.arch;
    if arch == "6502" { return map{ verified: true, model: "6502", module: "stdlib:emulator_6502.sapp", test: "tests/semantics/emu_6502_test.sapp" }; }
    if arch == "z80" { return map{ verified: true, model: "z80", module: "stdlib:emulator_z80.sapp", test: "tests/semantics/emu_z80_test.sapp" }; }
    if arch == "avr" { return map{ verified: true, model: "avr", module: "stdlib:emulator_avr.sapp", test: "tests/semantics/emu_avr_test.sapp" }; }
    if arch == "msp430" { return map{ verified: true, model: "msp430", module: "stdlib:emulator_msp430.sapp", test: "tests/semantics/emu_msp430_test.sapp" }; }
    if arch == "mips32" { return map{ verified: true, model: "mips32", module: "stdlib:emulator_mips32.sapp", test: "tests/semantics/emu_mips_test.sapp" }; }
    if arch == "powerpc32" { return map{ verified: true, model: "powerpc32", module: "stdlib:emulator_powerpc32.sapp", test: "tests/semantics/emu_powerpc_test.sapp" }; }
    if arch == "riscv64" { return map{ verified: true, model: "riscv64", module: "stdlib:emulator_riscv64.sapp", test: "tests/semantics/emu_riscv_test.sapp" }; }
    if arch == "sparc-v8" { return map{ verified: true, model: "sparc-v8", module: "stdlib:emulator_sparc32.sapp", test: "tests/semantics/emu_sparc_test.sapp" }; }
    if arch == "wasm32" { return map{ verified: true, model: "wasm", module: "stdlib:emulator_wasm.sapp", test: "tests/semantics/emu_wasm_test.sapp" }; }
    if arch == "x86" or arch == "x86_64" or arch == "arm64" {
        return map{ verified: true, model: arch + "-codegen", module: "stdlib:codegen_ir.sapp", test: "tests/semantics/codegen_func_crossarch_test.sapp" };
    }
    return map{ verified: false, model: arch, module: "", test: "", boundary: "add a checked encoder/interpreter before claiming ISA verification" };
}

fn _sha256_text(value) {
    let text = str_lower(str(value ?? ""));
    if len(text) != 64 { return false; }
    let i = 0;
    while i < 64 {
        let c = str_slice(text, i, i + 1);
        if not str_contains("0123456789abcdef", c) { return false; }
        i = i + 1;
    }
    return true;
}

// A family profile is useful for deterministic userspace tests, but it is not
// exact evidence for every historical release. Callers may attach a report
// produced on the exact OS/version/architecture; incomplete evidence fails
// closed and never upgrades the claim to kernel or device emulation.
fn release_conformance(profile, evidence = nil) {
    if profile == nil or not is_map(profile) or not map_has(profile, "ok") or not profile.ok {
        return map{ ok: false, exact_release_verified: false, error: "valid platform profile required" };
    }
    let base = map{
        ok: true, format: "pblang.platform.release-conformance.v1",
        os: profile.os, version: profile.version, arch: profile.arch,
        family_contract_verified: true, exact_release_verified: false,
        full_kernel_verified: false, proprietary_frameworks_verified: false,
        publishable: false,
        boundary: "family userspace/ABI contract only; exact release evidence has not been supplied"
    };
    if evidence == nil { return base; }
    if not is_map(evidence) { return map{ ok: false, exact_release_verified: false, error: "release evidence must be a map" }; }
    let required = ["format", "os", "version", "arch", "backend", "runner", "artifact_sha256", "test_report_sha256", "duration_ms", "checks"];
    let i = 0;
    while i < len(required) {
        if not map_has(evidence, required[i]) {
            return map{ ok: false, exact_release_verified: false, error: "missing release evidence field: " + required[i] };
        }
        i = i + 1;
    }
    if evidence.format != "pblang.platform.release-evidence.v1" {
        return map{ ok: false, exact_release_verified: false, error: "unsupported release evidence format" };
    }
    if _canonical_os(evidence.os) != profile.os or str(evidence.version) != profile.version or _canonical_arch(evidence.arch) != profile.arch {
        return map{ ok: false, exact_release_verified: false, error: "release evidence target does not exactly match profile" };
    }
    if len(str_trim(str(evidence.backend))) == 0 or len(str_trim(str(evidence.runner))) == 0 {
        return map{ ok: false, exact_release_verified: false, error: "backend and runner identities are required" };
    }
    if not _sha256_text(evidence.artifact_sha256) or not _sha256_text(evidence.test_report_sha256) {
        return map{ ok: false, exact_release_verified: false, error: "release evidence digests must be lowercase or uppercase SHA-256 hex" };
    }
    let duration = _finite_number(evidence.duration_ms);
    if duration == nil or num_floor(duration) != duration or duration < 1 or duration > 604800000 {
        return map{ ok: false, exact_release_verified: false, error: "release evidence duration must be 1..604800000 ms" };
    }
    if not is_map(evidence.checks) {
        return map{ ok: false, exact_release_verified: false, error: "release evidence checks must be a map" };
    }
    let checks = ["loader", "abi", "memory", "filesystem", "process", "error_paths", "quotas", "cleanup"];
    i = 0;
    while i < len(checks) {
        let check = checks[i];
        if not map_has(evidence.checks, check) or evidence.checks[check] != true {
            return map{ ok: false, exact_release_verified: false, error: "release evidence check did not pass: " + check };
        }
        i = i + 1;
    }
    return map{
        ok: true, format: "pblang.platform.release-conformance.v1",
        os: profile.os, version: profile.version, arch: profile.arch,
        family_contract_verified: true, exact_release_verified: true,
        full_kernel_verified: false, proprietary_frameworks_verified: false,
        publishable: true, backend: str(evidence.backend), runner: str(evidence.runner),
        artifact_sha256: str_lower(str(evidence.artifact_sha256)),
        test_report_sha256: str_lower(str(evidence.test_report_sha256)), duration_ms: duration,
        boundary: "exact userspace/ABI conformance evidence; not full kernel, driver, firmware, or proprietary framework emulation"
    };
}

fn normalize_path(profile, value) {
    if profile == nil or not profile.ok { return map{ ok: false, error: "invalid profile" }; }
    let path = str(value ?? "");
    if len(path) == 0 { return map{ ok: false, error: "empty path" }; }
    let drive_paths = profile.os == "windows" or profile.os == "dos" or profile.os == "os2" or profile.os == "cpm";
    if drive_paths { path = str_replace_all(path, "\\", "/"); }
    let absolute = str_starts_with(path, "/");
    let drive = "";
    if drive_paths and len(path) >= 2 and str_slice(path, 1, 2) == ":" {
        drive = str_upper(str_slice(path, 0, 1)) + ":";
        path = str_slice(path, 2, len(path)); absolute = true;
    }
    let parts = str_split(path, "/"); let stack = []; let i = 0;
    while i < len(parts) {
        let part = parts[i];
        if part == "" or part == "." { }
        else if part == ".." {
            if len(stack) == 0 { return map{ ok: false, error: "path escapes virtual root" }; }
            array_pop(stack);
        } else {
            if str_contains(part, "\u0000") { return map{ ok: false, error: "NUL in path" }; }
            array_push(stack, part);
        }
        i = i + 1;
    }
    let joined = ""; i = 0;
    while i < len(stack) { if i > 0 { joined = joined + "/"; } joined = joined + stack[i]; i = i + 1; }
    let out = joined;
    if absolute { out = "/" + out; }
    if drive != "" { out = drive + out; }
    if profile.sandboxed {
        let root = str_replace_all(profile.root, "\\", "/");
        if not str_starts_with(out, root + "/") and out != root { out = root + "/" + joined; }
    }
    if drive_paths { out = str_replace_all(out, "/", "\\"); }
    return map{ ok: true, path: out };
}

fn machine(profile, options = nil) {
    if profile == nil or not profile.ok { throw "platform_emulator.machine: invalid profile"; }
    let memory_bytes = 65536; let max_files = 128; let max_output_bytes = 1048576; let memory_layout = "auto";
    if options != nil and is_map(options) {
        if map_has(options, "memory_bytes") { memory_bytes = _bounded_option(options.memory_bytes, "memory_bytes", 1, 16777216); }
        if map_has(options, "max_files") { max_files = _bounded_option(options.max_files, "max_files", 1, 4096); }
        if map_has(options, "max_output_bytes") { max_output_bytes = _bounded_option(options.max_output_bytes, "max_output_bytes", 1, 16777216); }
        if map_has(options, "memory_layout") { memory_layout = str_lower(str(options.memory_layout)); }
    }
    let max_storage_bytes = memory_bytes * 4;
    if options != nil and is_map(options) and map_has(options, "max_storage_bytes") {
        max_storage_bytes = _bounded_option(options.max_storage_bytes, "max_storage_bytes", 1, 67108864);
    }
    if memory_layout != "auto" and memory_layout != "contiguous" and memory_layout != "sparse" { throw "platform_emulator.machine: memory_layout must be auto/contiguous/sparse"; }
    if memory_layout == "auto" { memory_layout = if memory_bytes > 65536 { "sparse" } else { "contiguous" }; }
    let mem = if memory_layout == "sparse" { map{} } else { [] };
    if memory_layout == "contiguous" { let i = 0; while i < memory_bytes { array_push(mem, 0); i = i + 1; } }
    return map{
        format: MACHINE_FORMAT, profile: profile, memory: mem, memory_bytes: memory_bytes, memory_layout: memory_layout,
        files: map{}, env: map{}, stdout: "", stderr: "", exited: false, exit_code: 0,
        clock_ms: 0, random_state: 2463534242, syscall_count: 0,
        resident_cells: if memory_layout == "contiguous" { memory_bytes } else { 0 },
        file_count: 0, file_bytes: 0, env_count: 0, env_bytes: 0,
        output_bytes: 0,
        limits: map{
            max_files: max_files, max_output_bytes: max_output_bytes,
            max_storage_bytes: max_storage_bytes, max_env_bytes: memory_bytes,
            max_syscalls: 1000000
        }
    };
}

fn _range_ok(m, address, count) {
    let a = _finite_number(address); let n = _finite_number(count);
    return a != nil and n != nil and a >= 0 and n >= 0
        and num_floor(a) == a and num_floor(n) == n
        and a <= m.memory_bytes and n <= m.memory_bytes - a;
}

fn memory_write(m, address, bytes) {
    if not is_array(bytes) or not _range_ok(m, address, len(bytes)) { return map{ ok: false, error: "memory write out of bounds" }; }
    // Validate the entire transaction before mutating a single cell.
    let i = 0;
    while i < len(bytes) {
        let value = bytes[i];
        if not is_number(value) or value < 0 or value > 255 or num_floor(value) != value { return map{ ok: false, error: "memory byte outside 0..255" }; }
        i = i + 1;
    }
    i = 0;
    while i < len(bytes) {
        let value = bytes[i];
        if m.memory_layout == "sparse" {
            let key = str(address + i);
            let existed = map_has(m.memory, key);
            if value == 0 {
                if existed { map_remove(m.memory, key); m.resident_cells = m.resident_cells - 1; }
            } else {
                if not existed { m.resident_cells = m.resident_cells + 1; }
                m.memory[key] = value;
            }
        } else { m.memory[address + i] = value; }
        i = i + 1;
    }
    return map{ ok: true, count: len(bytes) };
}

fn memory_read(m, address, count) {
    if not _range_ok(m, address, count) { return map{ ok: false, error: "memory read out of bounds", bytes: [] }; }
    let out = []; let i = 0;
    while i < count {
        let value = 0;
        if m.memory_layout == "sparse" { let key = str(address + i); if map_has(m.memory, key) { value = m.memory[key]; } }
        else { value = m.memory[address + i]; }
        array_push(out, value); i = i + 1;
    }
    return map{ ok: true, bytes: out, count: count };
}

fn memory_stats(m) {
    if m == nil or m.format != MACHINE_FORMAT { return map{ ok: false, error: "invalid machine" }; }
    return map{ ok: true, layout: m.memory_layout, logical_bytes: m.memory_bytes, resident_cells: m.resident_cells, zero_fill: true };
}

fn machine_stats(m) {
    if m == nil or m.format != MACHINE_FORMAT { return map{ ok: false, error: "invalid machine" }; }
    return map{
        ok: true, format: "pblang.platform.machine.stats.v1",
        memory: memory_stats(m), files: m.file_count, file_bytes: m.file_bytes,
        max_files: m.limits.max_files, max_storage_bytes: m.limits.max_storage_bytes,
        environment: m.env_count, env_bytes: m.env_bytes,
        max_env_bytes: m.limits.max_env_bytes, output_bytes: m.output_bytes,
        max_output_bytes: m.limits.max_output_bytes, syscalls: m.syscall_count,
        max_syscalls: m.limits.max_syscalls
    };
}

fn _append_output(m, stream, text) {
    let value = str(text ?? "");
    let current = if stream == "stderr" { m.stderr } else { m.stdout };
    let added_bytes = _utf8_bytes(value);
    if m.output_bytes > m.limits.max_output_bytes - added_bytes {
        return map{ ok: false, error: "output limit exceeded" };
    }
    if stream == "stderr" { m.stderr = current + value; } else { m.stdout = current + value; }
    m.output_bytes = m.output_bytes + added_bytes;
    return map{ ok: true, count: added_bytes };
}

fn syscall(m, name_value, args = nil) {
    if m == nil or m.format != MACHINE_FORMAT { return map{ ok: false, error: "invalid machine" }; }
    if m.exited { return map{ ok: false, error: "process already exited" }; }
    m.syscall_count = m.syscall_count + 1;
    if m.syscall_count > m.limits.max_syscalls { return map{ ok: false, error: "syscall budget exceeded" }; }
    let name = str_lower(str(name_value ?? ""));
    if args == nil { args = map{}; }
    if name == "platform" { return map{ ok: true, value: m.profile }; }
    if name == "page_size" { return map{ ok: true, value: 4096 }; }
    if name == "clock_ms" {
        let step = 1; if is_map(args) and map_has(args, "advance") { step = args.advance; }
        if not is_number(step) or num_floor(step) != step or step < 0 or step > 86400000 {
            return map{ ok: false, error: "clock advance must be an integer number in 0..86400000" };
        }
        m.clock_ms = m.clock_ms + step; return map{ ok: true, value: m.clock_ms };
    }
    if name == "random_u32" {
        // xorshift32 represented with bounded arithmetic available on every backend.
        let x = m.random_state;
        x = bit_xor(x, bit_shl(x, 13)); x = bit_xor(x, bit_shr(x, 17)); x = bit_xor(x, bit_shl(x, 5));
        x = x % 4294967296; if x < 0 { x = x + 4294967296; }
        m.random_state = x; return map{ ok: true, value: x };
    }
    if name == "write" {
        let stream = "stdout"; let text = "";
        if is_map(args) { if map_has(args, "stream") { stream = str(args.stream); } if map_has(args, "text") { text = args.text; } }
        if stream != "stdout" and stream != "stderr" { return map{ ok: false, error: "invalid output stream" }; }
        return _append_output(m, stream, text);
    }
    if name == "setenv" {
        if not is_map(args) or not map_has(args, "key") or not map_has(args, "value") { return map{ ok: false, error: "setenv requires key/value" }; }
        let key = str(args.key); if len(key) == 0 or _utf8_bytes(key) > 256
            or str_contains(key, "=") or str_contains(key, "\x00") {
            return map{ ok: false, error: "invalid environment key" };
        }
        let is_new = not map_has(m.env, key);
        if m.env_count >= 256 and is_new { return map{ ok: false, error: "environment limit exceeded" }; }
        let value = str(args.value); if str_contains(value, "\x00") {
            return map{ ok: false, error: "NUL in environment value" };
        }
        let old_bytes = 0;
        if not is_new { old_bytes = _utf8_bytes(m.env[key]); }
        let next_bytes = m.env_bytes - old_bytes + _utf8_bytes(value);
        if next_bytes > m.limits.max_env_bytes { return map{ ok: false, error: "environment byte limit exceeded" }; }
        m.env[key] = value; m.env_bytes = next_bytes;
        if is_new { m.env_count = m.env_count + 1; }
        return map{ ok: true };
    }
    if name == "getenv" {
        let key = if is_map(args) and map_has(args, "key") { str(args.key) } else { "" };
        if map_has(m.env, key) { return map{ ok: true, found: true, value: m.env[key] }; }
        return map{ ok: true, found: false, value: nil };
    }
    if name == "unsetenv" {
        let key = if is_map(args) and map_has(args, "key") { str(args.key) } else { "" };
        if not map_has(m.env, key) { return map{ ok: true, found: false }; }
        m.env_bytes = m.env_bytes - _utf8_bytes(m.env[key]); m.env_count = m.env_count - 1;
        map_remove(m.env, key); return map{ ok: true, found: true };
    }
    if name == "listenv" { return map{ ok: true, keys: map_keys(m.env), count: m.env_count }; }
    if name == "write_file" {
        if not is_map(args) or not map_has(args, "path") or not map_has(args, "data") { return map{ ok: false, error: "write_file requires path/data" }; }
        let path = normalize_path(m.profile, args.path); if not path.ok { return path; }
        let is_new = not map_has(m.files, path.path);
        if m.file_count >= m.limits.max_files and is_new { return map{ ok: false, error: "file limit exceeded" }; }
        let data = str(args.data); let data_bytes = _utf8_bytes(data);
        if data_bytes > m.memory_bytes { return map{ ok: false, error: "file exceeds per-file limit" }; }
        let old_bytes = 0; if not is_new { old_bytes = _utf8_bytes(m.files[path.path]); }
        let next_bytes = m.file_bytes - old_bytes + data_bytes;
        if next_bytes > m.limits.max_storage_bytes { return map{ ok: false, error: "virtual storage limit exceeded" }; }
        m.files[path.path] = data; m.file_bytes = next_bytes;
        if is_new { m.file_count = m.file_count + 1; }
        return map{ ok: true, path: path.path, count: data_bytes };
    }
    if name == "read_file" {
        let raw = if is_map(args) and map_has(args, "path") { args.path } else { "" };
        let path = normalize_path(m.profile, raw); if not path.ok { return path; }
        if not map_has(m.files, path.path) { return map{ ok: false, error: "file not found", path: path.path }; }
        return map{ ok: true, path: path.path, data: m.files[path.path],
            count: _utf8_bytes(m.files[path.path]) };
    }
    if name == "delete_file" {
        let raw = if is_map(args) and map_has(args, "path") { args.path } else { "" };
        let path = normalize_path(m.profile, raw); if not path.ok { return path; }
        if not map_has(m.files, path.path) { return map{ ok: true, found: false, path: path.path }; }
        m.file_bytes = m.file_bytes - _utf8_bytes(m.files[path.path]); m.file_count = m.file_count - 1;
        map_remove(m.files, path.path); return map{ ok: true, found: true, path: path.path };
    }
    if name == "list_files" { return map{ ok: true, paths: map_keys(m.files), count: m.file_count, bytes: m.file_bytes }; }
    if name == "exit" {
        let code = 0; if is_map(args) and map_has(args, "code") { code = num_floor(args.code); }
        if code < 0 or code > 255 { return map{ ok: false, error: "exit code outside 0..255" }; }
        m.exited = true; m.exit_code = code; return map{ ok: true, code: code };
    }
    return map{ ok: false, error: "unsupported portable syscall: " + name };
}

export catalog, resolve, custom_profile, compare_versions, compatible, isa_model, release_conformance, normalize_path;
export machine, memory_write, memory_read, memory_stats, machine_stats, syscall;
