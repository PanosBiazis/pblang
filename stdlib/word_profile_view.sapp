let Profile=import("stdlib:word_profile.sapp");let UI=import("stdlib:modern_ui.sapp");let Pages=import("stdlib:text_pages.sapp");
fn entry_lines(item){let out=Pages.wrap(item.token,24);array_push(out,"Count: "+str(item.count));let blocks=[];for b in item.blocks{array_push(blocks,str(b+1));}for line in Pages.wrap("Blocks: "+str_join(blocks,", "),24){array_push(out,line);}return out;}
fn create(doc,index=0){let page=Profile.page(doc,index);let children=[UI.heading("PBWords"),UI.text("Exact forms; case and punctuation retained."),UI.text("Tokens: "+str(page.total)+" | Unique: "+str(page.unique)+" | Page "+str(index+1)+" / "+str(page.pages))];
 if len(page.entries)==0{array_push(children,UI.text("No tokens in document body."));return UI.screen(children);}
 let height=0;for item in page.entries{height=num_max(height,len(entry_lines(item)));}let first=entry_lines(page.entries[0]);while len(first)<height{array_push(first,"");}for i in range(0,len(first)){array_push(children,UI.text(first[i],map{name:"detail_"+str(i)}));}
 let buttons=[];for i in range(0,len(page.entries)){let lines=entry_lines(page.entries[i]);while len(lines)<height{array_push(lines,"");}let actions=[];for j in range(0,len(lines)){array_push(actions,UI.action_set_text("detail_"+str(j),lines[j]));}array_push(buttons,UI.button("Entry "+str(index*Profile.PAGE_SIZE+i+1),UI.action_sequence(actions),map{name:"select_"+str(i)}));}
 array_push(children,UI.grid(buttons,map{columns:4}));array_push(children,UI.text("Snapshot of this eight-entry page. Export other pages separately."));return UI.screen(children);
}
export entry_lines,create;
