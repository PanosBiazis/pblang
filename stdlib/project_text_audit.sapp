// stdlib/project_text_audit.sapp -- bounded safe-text project audit.
//
// This module is the explicit content-reading layer above project_inventory.
// It only reads small, text-like files from caller-approved roots, skips
// sensitive/cache/build/local assistant paths, and feeds records into
// stdlib:project_audit.sapp.

let INV = import("stdlib:project_inventory.sapp");
let AUDIT = import("stdlib:project_audit.sapp");
let PATH = import("stdlib:path.sapp");
let SECURE = import("stdlib:secure_file.sapp");

fn _str(x) { return str(x ?? ""); }
fn _lower(x) { return str_lower(_str(x)); }

fn _base(path) {
    let parts = str_split(_str(path), "/");
    if len(parts) == 0 { return ""; }
    let b = parts[len(parts) - 1];
    if b == "" and len(parts) > 1 { b = parts[len(parts) - 2]; }
    return b;
}

fn _ext(path) {
    let name = _lower(_base(path));
    let i = len(name) - 1;
    while i >= 0 {
        if str_slice(name, i, i + 1) == "." { return str_slice(name, i, len(name)); }
        i = i - 1;
    }
    return "";
}

fn text_like_path(path) {
    let name = _lower(_base(path));
    let ext = _ext(path);
    if ext == ".sapp" or ext == ".sap" or ext == ".bpx" { return true; }
    if ext == ".md" or ext == ".txt" or ext == ".rst" or ext == ".adoc" { return true; }
    if ext == ".toml" or ext == ".json" or ext == ".yaml" or ext == ".yml" { return true; }
    if ext == ".rs" or ext == ".c" or ext == ".h" or ext == ".cpp" or ext == ".hpp"
        or ext == ".m" or ext == ".mm" { return true; }
    if ext == ".java" or ext == ".kt" or ext == ".kts" or ext == ".go" or ext == ".cs" { return true; }
    if ext == ".swift" or ext == ".zig" or ext == ".dart" or ext == ".scala" { return true; }
    if ext == ".lua" or ext == ".rb" or ext == ".php" or ext == ".pl" or ext == ".r"
        or ext == ".jl" { return true; }
    if ext == ".clj" or ext == ".cljs" or ext == ".ex" or ext == ".exs" { return true; }
    if ext == ".erl" or ext == ".hrl" or ext == ".fs" or ext == ".fsx" or ext == ".vb" { return true; }
    if ext == ".hs" or ext == ".ml" or ext == ".mli" or ext == ".lisp" or ext == ".scm" { return true; }
    if ext == ".f" or ext == ".f90" or ext == ".f95" or ext == ".pas" { return true; }
    if ext == ".adb" or ext == ".ads" or ext == ".cob" or ext == ".sol" { return true; }
    if ext == ".asm" or ext == ".s" or ext == ".wat" or ext == ".qasm" or ext == ".proto" { return true; }
    if ext == ".js" or ext == ".mjs" or ext == ".cjs" or ext == ".ts"
        or ext == ".jsx" or ext == ".tsx" { return true; }
    if ext == ".html" or ext == ".css" or ext == ".scss" or ext == ".sass"
        or ext == ".less" or ext == ".vue" or ext == ".svelte" { return true; }
    if ext == ".py" or ext == ".sh" or ext == ".bat" or ext == ".ps1" { return true; }
    if ext == ".sql" or ext == ".graphql" or ext == ".gql" { return true; }
    if ext == ".xml" or ext == ".gradle" or ext == ".properties" or ext == ".cmake" { return true; }
    if ext == ".ini" or ext == ".cfg" or ext == ".conf" or ext == ".env.example" { return true; }
    if ext == ".csv" or ext == ".tsv" or ext == ".lock" { return true; }
    if str_ends_with(name, ".env.example") { return true; }
    if name == "readme" or name == "license" or name == "changelog"
        or name == "makefile" or name == "dockerfile" or name == "procfile"
        or name == "cmakelists.txt" { return true; }
    return false;
}

fn audit_policy() {
    return map{
        format: "pblang.project_text_audit.policy.v1",
        read_scope: "caller-approved roots only",
        write_scope: "none; audit never writes files",
        external_disk_policy: "external disks and Ventoy-style boot media are read-only idea sources unless an operator explicitly scopes a write task",
        content_policy: "small text-like files only; sensitive/cache/build/generated-output/local assistant paths skipped; module reports retain fingerprints instead of source contents"
    };
}

// Bump whenever detector semantics, retained report fields, or completeness
// rules change. The CLI includes this revision in its checkpoint identity so
// reports produced by a different analyzer can never be resumed as current.
fn module_audit_engine_revision() { return "pblang.module-audit.engine.v5"; }

fn _safe_record_path(path) {
    if INV.should_skip_path(path) { return false; }
    if not text_like_path(path) { return false; }
    return true;
}

fn _historical_snapshot_doc(path, text) {
    let ext = _ext(path);
    if ext != ".md" and ext != ".txt" and ext != ".rst" and ext != ".adoc" { return false; }
    let t = _lower(text);
    if str_contains(t, "> historical snapshot.") { return true; }
    if str_contains(t, "**superseded / historical") { return true; }
    if str_contains(t, "superseded / historical") and str_contains(t, "canonical current status") { return true; }
    return false;
}

fn _ascii_preserving(bytes, start, stride) {
    let out = []; let controls = 0; let inspected = 0; let i = start;
    while i < len(bytes) {
        let b = bytes[i]; inspected = inspected + 1;
        if b == 9 or b == 10 or b == 13 or (b >= 32 and b < 127) {
            array_push(out, b);
        } elif b >= 128 {
            // Security rules and language control tokens are ASCII. Replacing a
            // legacy non-ASCII code unit with one space preserves byte order,
            // token boundaries and line numbers without inventing Unicode text.
            array_push(out, 32);
        } else {
            controls = controls + 1; array_push(out, 32);
        }
        i = i + stride;
    }
    let maximum_controls = num_floor(inspected / 100);
    if maximum_controls < 2 { maximum_controls = 2; }
    if controls > maximum_controls {
        return map{ ok: false, error: "text-like file contains excessive binary control bytes" };
    }
    let text = try bytes_to_str(out) catch nil;
    if text == nil { return map{ ok: false, error: "ASCII-preserving decode failed" }; }
    return map{ ok: true, text: text };
}

fn _decode_audit_text(bytes) {
    let text = try bytes_to_str(bytes) catch nil;
    if text != nil {
        if len(bytes) >= 3 and bytes[0] == 239 and bytes[1] == 187 and bytes[2] == 191 {
            return map{ ok: true, text: str_slice(text, 1, len(text)), encoding: "utf-8-bom", degraded: false };
        }
        return map{ ok: true, text: text, encoding: "utf-8", degraded: false };
    }
    if len(bytes) >= 2 and bytes[0] == 255 and bytes[1] == 254 {
        let decoded = _ascii_preserving(bytes, 2, 2);
        if not decoded.ok { return decoded; }
        return map{ ok: true, text: decoded.text, encoding: "utf-16le-ascii-preserving", degraded: true };
    }
    if len(bytes) >= 2 and bytes[0] == 254 and bytes[1] == 255 {
        let decoded = _ascii_preserving(bytes, 3, 2);
        if not decoded.ok { return decoded; }
        return map{ ok: true, text: decoded.text, encoding: "utf-16be-ascii-preserving", degraded: true };
    }
    let decoded = _ascii_preserving(bytes, 0, 1);
    if not decoded.ok { return decoded; }
    return map{ ok: true, text: decoded.text, encoding: "legacy-single-byte-ascii-preserving", degraded: true };
}

fn _read_text_bounded(path, maximum) {
    let loaded = map{};
    if platform() == "linux" {
        loaded = SECURE.read_bytes(path, maximum, false);
        if not loaded.ok { return map{ ok: false, error: str(try loaded.error catch "secure read failed") }; }
    } else {
        let bytes = try fs_read_bytes(path) catch nil;
        if type(bytes) != "array" { return map{ ok: false, error: "unreadable text file" }; }
        if len(bytes) > maximum { return map{ ok: false, error: "file exceeds max_file_bytes" }; }
        loaded = map{ ok: true, bytes: bytes, size: len(bytes) };
    }
    let decoded = _decode_audit_text(loaded.bytes);
    if not decoded.ok { return decoded; }
    return map{ ok: true, text: decoded.text, size: loaded.size,
        encoding: decoded.encoding, encoding_degraded: decoded.degraded,
        raw_sha256: sha256(base64_encode_bytes(loaded.bytes)) };
}

fn collect_text_records(roots, options = nil) {
    if options == nil { options = map{}; }
    let max_files = try options.max_files catch 120;
    let max_bytes = try options.max_file_bytes catch 20000;
    let max_depth = try options.max_depth catch 4;
    let max_entries = try options.max_entries catch 1000;
    let max_children = try options.max_children_per_dir catch 160;
    let max_runtime_ms = try options.max_runtime_ms catch 30000;
    let skip_historical = try options.skip_historical_snapshots catch true;
    if max_files == nil or max_files < 1 { max_files = 120; }
    if max_bytes == nil or max_bytes < 1000 { max_bytes = 1000; }
    if max_runtime_ms == nil or max_runtime_ms < 10 { max_runtime_ms = 30000; }
    if max_runtime_ms > 300000 { max_runtime_ms = 300000; }
    let started_ms = now_ms(); let deadline_ms = started_ms + max_runtime_ms;
    let inventory_runtime_ms = num_floor(max_runtime_ms * 0.6);
    if inventory_runtime_ms < 10 { inventory_runtime_ms = 10; }

    let inv = INV.inventory_roots(roots, map{
        max_depth: max_depth,
        max_entries: max_entries,
        max_children_per_dir: max_children,
        include_files: true,
        include_dirs: true,
        max_runtime_ms: inventory_runtime_ms
    });
    let records = [];
    let skipped = [];
    let rows = try inv.records catch [];
    let i = 0;
    while i < len(rows) and len(records) < max_files and now_ms() < deadline_ms {
        let rec = rows[i];
        let path = _str(try rec.path catch "");
        let kind = _str(try rec.kind catch "");
        if kind != "file" {
            i = i + 1;
            continue;
        }
        if not _safe_record_path(path) {
            array_push(skipped, map{ path: path, reason: "not safe text-like path" });
            i = i + 1;
            continue;
        }
        let loaded = _read_text_bounded(path, max_bytes);
        if not loaded.ok {
            array_push(skipped, map{ path: path, reason: loaded.error });
            i = i + 1;
            continue;
        }
        let text = loaded.text;
        if skip_historical and _historical_snapshot_doc(path, text) {
            array_push(skipped, map{ path: path, reason: "historical snapshot doc excluded from active audit" });
            i = i + 1;
            continue;
        }
        array_push(records, map{ path: path, text: text, encoding: loaded.encoding,
            encoding_degraded: loaded.encoding_degraded, raw_sha256: loaded.raw_sha256 });
        i = i + 1;
    }
    let truncated = false;
    if i < len(rows) { truncated = true; }
    let timed_out = (try inv.timed_out catch false) or now_ms() >= deadline_ms;
    if timed_out { truncated = true; }
    return map{
        format: "pblang.project_text_audit.records.v1",
        inventory: inv,
        records: records,
        record_count: len(records),
        skipped: skipped,
        skipped_count: len(skipped),
        timed_out: timed_out,
        duration_ms: now_ms() - started_ms,
        max_runtime_ms: max_runtime_ms,
        truncated: truncated,
        policy: "deadline-bounded text-like file audit; read-only caller-approved roots; sensitive/cache/build/generated-output/local assistant paths skipped; file contents are not printed by line summaries",
        policy_contract: audit_policy()
    };
}

fn audit_roots(project, roots, options = nil) {
    if options == nil { options = map{}; }
    let collected = collect_text_records(roots, options);
    let max_findings = try options.max_findings catch 200;
    let suppress_fixtures = try options.suppress_test_fixtures catch true;
    let audit = AUDIT.audit_project(project, collected.records, max_findings, map{
        suppress_test_fixtures: suppress_fixtures
    });
    let gate = AUDIT.quality_gate(audit.report, map{
        max_high: try options.max_high catch 0,
        max_medium: try options.max_medium catch 8,
        max_total: try options.max_total catch 80,
        max_source_high: try options.max_source_high catch 0,
        max_source_medium: try options.max_source_medium catch 4,
        max_source_total: try options.max_source_total catch 40,
        source_only_blockers: try options.source_only_blockers catch true,
        allow_roadmap: try options.allow_roadmap catch true
    });
    let coverage_error = "";
    if collected.record_count == 0 { coverage_error = "no eligible files were audited"; }
    else if collected.timed_out { coverage_error = "audit collection timed out"; }
    else if collected.truncated { coverage_error = "audit collection was truncated"; }
    let complete = coverage_error == "";
    if not complete {
        gate.passed = false;
        gate.status = "blocked";
        array_push(gate.blockers, coverage_error);
    }
    let backlog = AUDIT.backlog(audit.report, try options.backlog_limit catch 10);
    return map{
        format: "pblang.project_text_audit.report.v1",
        project: project,
        collected: collected,
        audit: audit,
        quality_gate: gate,
        backlog: backlog,
        status: gate.status,
        complete: complete,
        coverage_error: coverage_error,
        policy: collected.policy,
        policy_contract: collected.policy_contract
    };
}

fn _count_add(target, source) {
    let keys = map_keys(source); let i = 0;
    while i < len(keys) {
        target[keys[i]] = (try target[keys[i]] catch 0) + (try source[keys[i]] catch 0);
        i = i + 1;
    }
}

fn _append_index(index, rows, maximum, state) {
    let i = 0;
    while i < len(rows) {
        if len(index) < maximum { array_push(index, rows[i]); }
        else { state.truncated = true; }
        i = i + 1;
    }
}

fn _redacted_finding(row) {
    let path = str(try row.path catch "[input]");
    let line = try row.line catch 0;
    let kind = str(try row.kind catch "unknown");
    let severity = str(try row.severity catch "info");
    let role = str(try row.role catch "unknown");
    let text = str(try row.text catch "");
    return map{ format: str(try row.format catch "pblang.project_audit.finding.v1"),
        path: path, line: line, kind: kind, severity: severity, role: role,
        score: try row.score catch 0,
        recommendation: str(try row.recommendation catch "review and classify"),
        reason: str(try row.reason catch ""),
        fingerprint: sha256(path + "\x00" + str(line) + "\x00" + kind + "\x00" + severity + "\x00" + text) };
}

fn _excluded(path, options) {
    let excluded = try options.excluded_paths catch [];
    if type(excluded) != "array" or len(excluded) > 32 { return false; }
    let absolute = PATH.normalize(PATH.absolute(path)); let i = 0;
    while i < len(excluded) {
        if type(excluded[i]) == "string" and excluded[i] != ""
            and absolute == PATH.normalize(PATH.absolute(excluded[i])) { return true; }
        i = i + 1;
    }
    return false;
}

fn combine_module_reports(project, modules, options = nil) {
    if options == nil { options = map{}; }
    if type(modules) != "array" or len(modules) > 256 {
        return map{ ok: false, complete: false, format: "pblang.module_audit.v1",
            error: "modules must be a bounded array" };
    }
    let max_index = try options.max_finding_index catch 20000;
    if type(max_index) != "number" or max_index < 1 or max_index > 100000 {
        return map{ ok: false, complete: false, format: "pblang.module_audit.v1",
            error: "invalid aggregate finding index bound" };
    }
    let requested_roots = try options.requested_roots catch [];
    if type(requested_roots) != "array" or len(requested_roots) > 256 {
        return map{ ok: false, complete: false, format: "pblang.module_audit.v1",
            error: "requested_roots must be a bounded array" };
    }
    let finding_index = []; let index_state = map{ truncated: false };
    let counts_kind = map{}; let counts_severity = map{}; let counts_role = map{};
    let counts_role_severity = map{}; let counts_role_kind_severity = map{};
    let roots = []; let total_files = 0; let total_findings = 0;
    let total_suppressed = 0; let total_encoding_degraded = 0;
    let complete = len(requested_roots) == 0 or len(modules) == len(requested_roots);
    let i = 0;
    while i < len(modules) {
        let module = modules[i];
        if type(module) != "map" or (try module.format catch "") != "pblang.module_audit.module.v1" {
            return map{ ok: false, complete: false, format: "pblang.module_audit.v1",
                error: "invalid module report at index " + str(i) };
        }
        array_push(roots, module.root);
        if not (try module.complete catch false) { complete = false; }
        total_files = total_files + (try module.files_scanned catch 0);
        total_findings = total_findings + (try module.finding_count catch 0);
        total_suppressed = total_suppressed + (try module.suppressed_count catch 0);
        total_encoding_degraded = total_encoding_degraded + (try module.encoding_degraded_files catch 0);
        _count_add(counts_kind, try module.counts_kind catch map{});
        _count_add(counts_severity, try module.counts_severity catch map{});
        _count_add(counts_role, try module.counts_role catch map{});
        _count_add(counts_role_severity, try module.counts_role_severity catch map{});
        _count_add(counts_role_kind_severity, try module.counts_role_kind_severity catch map{});
        _append_index(finding_index, try module.findings catch [], max_index, index_state);
        if try module.finding_index_truncated catch false { index_state.truncated = true; }
        i = i + 1;
    }
    let aggregate = map{ format: "pblang.project_audit.report.v1", records: total_files,
        findings: finding_index, finding_count: total_findings, counts_kind: counts_kind,
        counts_severity: counts_severity, counts_role: counts_role,
        counts_role_severity: counts_role_severity,
        counts_role_kind_severity: counts_role_kind_severity,
        suppressed: [], suppressed_count: total_suppressed,
        truncated: not complete, passed: total_findings == 0 };
    let gate = AUDIT.quality_gate(aggregate, map{
        max_high: try options.max_high catch 0, max_medium: try options.max_medium catch 8,
        max_total: try options.max_total catch 80, max_source_high: try options.max_source_high catch 0,
        max_source_medium: try options.max_source_medium catch 4,
        max_source_total: try options.max_source_total catch 40,
        source_only_blockers: try options.source_only_blockers catch true,
        allow_roadmap: try options.allow_roadmap catch true });
    return map{ ok: true, format: "pblang.module_audit.v1", project: project,
        audit_id: str(try options.audit_id catch ""),
        engine_revision: str(try options.engine_revision catch module_audit_engine_revision()),
        requested_roots: if len(requested_roots) > 0 { requested_roots } else { roots },
        complete: complete, status: if not complete { "incomplete" } else { gate.status },
        modules: modules, module_count: len(modules), files_scanned: total_files,
        finding_count: total_findings, suppressed_count: total_suppressed,
        encoding_degraded_files: total_encoding_degraded,
        finding_index: finding_index, finding_index_count: len(finding_index),
        finding_index_truncated: index_state.truncated, aggregate: aggregate,
        quality_gate: gate,
        policy: "module-by-module independent no-follow bounded byte scans; UTF-8 is exact and legacy encodings retain ASCII security/control tokens with explicit degraded-encoding counts; redacted bounded indexes never stop traversal" };
}

fn verify_module_snapshot(module, options = nil) {
    if options == nil { options = map{}; }
    if type(module) != "map" or (try module.format catch "") != "pblang.module_audit.module.v1"
        or type(try module.snapshot_sha256 catch nil) != "string" {
        return map{ ok: false, stable: false, error: "invalid module snapshot" };
    }
    let max_files = try options.max_files_per_module catch 10000;
    let max_file_bytes = try options.max_file_bytes catch 1048576;
    let max_depth = try options.max_depth catch 32;
    let max_entries = try options.max_entries_per_module catch 50000;
    let max_children = try options.max_children_per_dir catch 10000;
    let runtime = try options.max_runtime_ms_per_module catch 300000;
    let inv = INV.inventory_roots([module.root], map{ max_depth: max_depth,
        max_entries: max_entries, max_children_per_dir: max_children,
        include_files: true, include_dirs: false, max_runtime_ms: runtime });
    if (try inv.truncated catch true) or (try inv.timed_out catch true) {
        return map{ ok: true, stable: false, error: "snapshot inventory incomplete" };
    }
    let identity = [str(module.root)]; let rows = try inv.records catch [];
    let seen = 0; let i = 0;
    while i < len(rows) {
        let path = _str(try rows[i].path catch "");
        if (try rows[i].kind catch "") == "file" and _safe_record_path(path)
            and not _excluded(path, options) {
            seen = seen + 1;
            if seen > max_files { return map{ ok: true, stable: false, error: "snapshot file limit exceeded" }; }
            let loaded = _read_text_bounded(path, max_file_bytes);
            if not loaded.ok { return map{ ok: true, stable: false, error: loaded.error, path: path }; }
            array_push(identity, PATH.normalize(PATH.absolute(path)) + "\x00" + loaded.raw_sha256);
        }
        i = i + 1;
    }
    let digest = sha256(str_join(identity, "\n"));
    return map{ ok: true, stable: digest == module.snapshot_sha256,
        format: "pblang.module_audit.snapshot.v1", root: module.root,
        files_checked: seen, expected: module.snapshot_sha256, actual: digest };
}

// Scan every eligible file independently and retain findings under its module.
// Filling the bounded top-level index never stops module traversal.
fn audit_modules(project, roots, options = nil) {
    if options == nil { options = map{}; }
    if type(roots) != "array" or len(roots) == 0 or len(roots) > 256 {
        return map{ ok: false, complete: false, format: "pblang.module_audit.v1", error: "roots must contain 1..256 modules" };
    }
    let max_files = try options.max_files_per_module catch 10000;
    let max_file_bytes = try options.max_file_bytes catch 1048576;
    let max_findings_per_file = try options.max_findings_per_file catch 256;
    let max_index = try options.max_finding_index catch 20000;
    let max_module_index = try options.max_findings_per_module_index catch 20000;
    let max_suppressed_index = try options.max_suppressed_per_module_index catch 1000;
    let max_depth = try options.max_depth catch 32;
    let max_entries = try options.max_entries_per_module catch 50000;
    let max_children = try options.max_children_per_dir catch 10000;
    let runtime = try options.max_runtime_ms_per_module catch 300000;
    if max_files < 1 or max_files > 100000 or max_file_bytes < 1000 or max_file_bytes > 16777216
        or max_findings_per_file < 1 or max_findings_per_file > 4096
        or max_index < 1 or max_index > 100000
        or max_module_index < 1 or max_module_index > 100000
        or max_suppressed_index < 1 or max_suppressed_index > 10000 {
        return map{ ok: false, complete: false, format: "pblang.module_audit.v1", error: "invalid module audit bounds" };
    }
    let modules = []; let finding_index = []; let index_state = map{ truncated: false };
    let counts_kind = map{}; let counts_severity = map{}; let counts_role = map{};
    let counts_role_severity = map{}; let counts_role_kind_severity = map{};
    let total_files = 0; let total_findings = 0; let total_suppressed = 0;
    let total_encoding_degraded = 0;
    let complete = true; let started = now_ms(); let ri = 0;
    while ri < len(roots) {
        let root = str(roots[ri]);
        let module_started = now_ms(); let module_deadline = module_started + runtime;
        let inv = INV.inventory_roots([root], map{ max_depth: max_depth,
            max_entries: max_entries, max_children_per_dir: max_children,
            include_files: true, include_dirs: false, max_runtime_ms: runtime });
        let rows = try inv.records catch []; let files = []; let skipped = [];
        let module_findings = []; let module_suppressed = []; let module_incomplete = [];
        let module_finding_count = 0; let module_suppressed_count = 0;
        let module_finding_index_truncated = false; let module_suppressed_index_truncated = false;
        let module_counts_kind = map{}; let module_counts_severity = map{};
        let module_counts_role = map{}; let module_counts_role_severity = map{};
        let module_counts_role_kind_severity = map{};
        let module_identity = [root];
        let seen_files = 0; let bounded_files = 0; let encoding_degraded_files = 0; let j = 0;
        if len(rows) == 0 and (try inv.skipped_count catch 0) > 0 {
            array_push(module_incomplete, map{ path: root, reason: "module root was excluded by audit policy" });
        }
        while j < len(rows) and now_ms() < module_deadline {
            let path = _str(try rows[j].path catch "");
            if (try rows[j].kind catch "") == "file" and _safe_record_path(path) {
                seen_files = seen_files + 1;
                if _excluded(path, options) {
                    array_push(skipped, map{ path: path, reason: "explicit audit output exclusion" });
                } else {
                    bounded_files = bounded_files + 1;
                    if bounded_files > max_files {
                    array_push(module_incomplete, map{ path: path, reason: "module file limit exceeded" });
                    } else {
                    let loaded = _read_text_bounded(path, max_file_bytes);
                    if not loaded.ok {
                        array_push(module_incomplete, map{ path: path, reason: loaded.error });
                    } else {
                        let text = loaded.text;
                        array_push(module_identity,
                            PATH.normalize(PATH.absolute(path)) + "\x00" + loaded.raw_sha256);
                        if loaded.encoding_degraded { encoding_degraded_files = encoding_degraded_files + 1; }
                        if (try options.skip_historical_snapshots catch true) and _historical_snapshot_doc(path, text) {
                        array_push(skipped, map{ path: path, reason: "historical snapshot doc excluded" });
                        } else {
                        let one = AUDIT.scan_records([map{ path: path, text: text }], max_findings_per_file,
                            map{ suppress_test_fixtures: try options.suppress_test_fixtures catch true,
                                deadline_ms: module_deadline });
                        array_push(files, map{ path: path, finding_count: one.finding_count,
                            suppressed_count: one.suppressed_count, truncated: one.truncated,
                            encoding: loaded.encoding, encoding_degraded: loaded.encoding_degraded,
                            raw_sha256: loaded.raw_sha256 });
                        module_finding_count = module_finding_count + one.finding_count;
                        module_suppressed_count = module_suppressed_count + one.suppressed_count;
                        let fi = 0;
                        while fi < len(one.findings) {
                            if len(module_findings) < max_module_index {
                                array_push(module_findings, _redacted_finding(one.findings[fi]));
                            } else { module_finding_index_truncated = true; }
                            fi = fi + 1;
                        }
                        let si = 0;
                        while si < len(one.suppressed) {
                            if len(module_suppressed) < max_suppressed_index {
                                array_push(module_suppressed, _redacted_finding(one.suppressed[si]));
                            } else { module_suppressed_index_truncated = true; }
                            si = si + 1;
                        }
                        if one.truncated {
                            array_push(module_incomplete, map{ path: path,
                                reason: if now_ms() >= module_deadline { "per-file analysis deadline exceeded" }
                                    else { "per-file finding limit reached" } });
                        }
                        _count_add(counts_kind, one.counts_kind); _count_add(counts_severity, one.counts_severity);
                        _count_add(counts_role, one.counts_role); _count_add(counts_role_severity, one.counts_role_severity);
                        _count_add(counts_role_kind_severity, one.counts_role_kind_severity);
                        _count_add(module_counts_kind, one.counts_kind);
                        _count_add(module_counts_severity, one.counts_severity);
                        _count_add(module_counts_role, one.counts_role);
                        _count_add(module_counts_role_severity, one.counts_role_severity);
                        _count_add(module_counts_role_kind_severity, one.counts_role_kind_severity);
                        }
                    }
                    }
                }
            }
            j = j + 1;
        }
        if j < len(rows) {
            array_push(module_incomplete, map{ path: root, reason: "module analysis deadline exceeded" });
        }
        if (try inv.truncated catch true) { array_push(module_incomplete, map{ path: root, reason: "inventory truncated" }); }
        if (try inv.timed_out catch true) { array_push(module_incomplete, map{ path: root, reason: "inventory timed out" }); }
        if seen_files == 0 { array_push(module_incomplete, map{ path: root, reason: "no eligible files were audited" }); }
        let module_complete = len(module_incomplete) == 0;
        if not module_complete { complete = false; }
        _append_index(finding_index, module_findings, max_index, index_state);
        total_files = total_files + len(files); total_findings = total_findings + module_finding_count;
        total_suppressed = total_suppressed + module_suppressed_count;
        total_encoding_degraded = total_encoding_degraded + encoding_degraded_files;
        array_push(modules, map{ format: "pblang.module_audit.module.v1", root: root,
            complete: module_complete, files_scanned: len(files), eligible_files: seen_files,
            finding_count: module_finding_count, suppressed_count: module_suppressed_count,
            encoding_degraded_files: encoding_degraded_files,
            findings: module_findings, suppressed: module_suppressed, files: files,
            finding_index_truncated: module_finding_index_truncated,
            suppressed_index_truncated: module_suppressed_index_truncated,
            counts_kind: module_counts_kind, counts_severity: module_counts_severity,
            counts_role: module_counts_role, counts_role_severity: module_counts_role_severity,
            counts_role_kind_severity: module_counts_role_kind_severity,
            snapshot_sha256: sha256(str_join(module_identity, "\n")),
            skipped: skipped, incomplete_reasons: module_incomplete,
            inventory_records: try inv.record_count catch len(rows),
            duration_ms: now_ms() - module_started });
        ri = ri + 1;
    }
    let aggregate = map{ format: "pblang.project_audit.report.v1", records: total_files,
        findings: finding_index, finding_count: total_findings, counts_kind: counts_kind,
        counts_severity: counts_severity, counts_role: counts_role,
        counts_role_severity: counts_role_severity,
        counts_role_kind_severity: counts_role_kind_severity,
        suppressed: [], suppressed_count: total_suppressed,
        truncated: not complete, passed: total_findings == 0 };
    let gate = AUDIT.quality_gate(aggregate, map{
        max_high: try options.max_high catch 0, max_medium: try options.max_medium catch 8,
        max_total: try options.max_total catch 80, max_source_high: try options.max_source_high catch 0,
        max_source_medium: try options.max_source_medium catch 4,
        max_source_total: try options.max_source_total catch 40,
        source_only_blockers: try options.source_only_blockers catch true,
        allow_roadmap: try options.allow_roadmap catch true });
    return map{ ok: true, format: "pblang.module_audit.v1", project: project,
        complete: complete, status: if not complete { "incomplete" } else { gate.status },
        modules: modules, module_count: len(modules), files_scanned: total_files,
        finding_count: total_findings, suppressed_count: total_suppressed,
        encoding_degraded_files: total_encoding_degraded,
        finding_index: finding_index, finding_index_count: len(finding_index),
        finding_index_truncated: index_state.truncated, aggregate: aggregate,
        quality_gate: gate, duration_ms: now_ms() - started,
        policy: "module-by-module independent no-follow bounded byte scans; UTF-8 is exact and legacy encodings retain ASCII security/control tokens with explicit degraded-encoding counts; redacted finding indexes; no global finding cap stops traversal" };
}

fn module_audit_lines(report, limit = 24) {
    let lines = ["Module audit: " + str(try report.project catch "project") + " · " + str(try report.status catch "unknown"),
        "modules=" + str(try report.module_count catch 0) + " files=" + str(try report.files_scanned catch 0)
            + " findings=" + str(try report.finding_count catch 0) + " complete=" + str(try report.complete catch false)
            + " degraded_encodings=" + str(try report.encoding_degraded_files catch 0),
        "finding_index=" + str(try report.finding_index_count catch 0) + " index_truncated=" + str(try report.finding_index_truncated catch false),
        "policy: " + str(try report.policy catch "module audit")];
    let modules = try report.modules catch []; let i = 0;
    while i < len(modules) and len(lines) < limit {
        array_push(lines, "- " + modules[i].root + " files=" + str(modules[i].files_scanned)
            + " findings=" + str(modules[i].finding_count) + " complete=" + str(modules[i].complete));
        i = i + 1;
    }
    return lines;
}

fn audit_lines(report, limit = 16) {
    if limit == nil or limit < 1 { limit = 16; }
    let r = try report catch map{};
    let collected = try r.collected catch map{};
    let audit = try r.audit catch map{};
    let rep = try audit.report catch map{};
    let gate = try r.quality_gate catch map{};
    let lines = [
        "Project text audit: " + str(try r.project catch "project") + " · " + str(try r.status catch "unknown"),
        "records=" + str(try collected.record_count catch 0) + " findings=" + str(try rep.finding_count catch 0) + " skipped=" + str(try collected.skipped_count catch 0) + " truncated=" + str(try collected.truncated catch false) + " timed_out=" + str(try collected.timed_out catch false),
        "roles: source=" + str(try rep.counts_role.source catch 0) + " docs=" + str(try rep.counts_role.docs catch 0) + " test=" + str(try rep.counts_role.test catch 0) + " config=" + str(try rep.counts_role.config catch 0),
        "gate: " + str(try gate.status catch "unknown") + " · policy: " + str(try r.policy catch "bounded text")
    ];
    let recs = try audit.recommendations catch [];
    let i = 0;
    while i < len(recs) and len(lines) < limit {
        array_push(lines, "- " + str(recs[i]));
        i = i + 1;
    }
    let tasks = try r.backlog.tasks catch [];
    let j = 0;
    while j < len(tasks) and len(lines) < limit {
        let t = tasks[j];
        array_push(lines, "! " + str(try t.severity catch "?") + " " + str(try t.role catch "?") + "/" + str(try t.kind catch "?") + " " + str(try t.path catch "") + ":" + str(try t.line catch 0));
        j = j + 1;
    }
    return lines;
}

export text_like_path, audit_policy, collect_text_records, audit_roots, audit_lines;
export audit_modules, combine_module_reports, verify_module_snapshot, module_audit_lines;
export module_audit_engine_revision;
