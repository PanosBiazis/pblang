// stdlib/transform2d.sapp — 2D affine transforms + matrix stack + clip-rect stack.
//
// The retained coordinate state a 2D renderer keeps (canvas / nanovg / the gpu2d stack):
// translate/scale/rotate points through an affine matrix, push/pop nested coordinate
// frames, and intersect clip rectangles. Pure math + deterministic. Points are transformed
// on the CPU before they reach gpu2d's batcher or gpu2d_tess's tessellator.
//
// Matrix is {a,b,c,d,e,f} (SVG/canvas 2x3):  x' = a*x + c*y + e,  y' = b*x + d*y + f.

let M = import("stdlib:math.sapp");   // sin/cos/deg_to_rad

fn _max(x, y) { if x > y { return x; } return y; }
fn _min(x, y) { if x < y { return x; } return y; }

fn identity() { return map{ a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: 0.0, f: 0.0 }; }
fn translate(tx, ty) { return map{ a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: tx * 1.0, f: ty * 1.0 }; }
fn scale(sx, sy) { return map{ a: sx * 1.0, b: 0.0, c: 0.0, d: sy * 1.0, e: 0.0, f: 0.0 }; }
fn rotate(rad) {
    let cs = M.cos(rad);
    let sn = M.sin(rad);
    return map{ a: cs, b: sn, c: 0.0 - sn, d: cs, e: 0.0, f: 0.0 };
}
fn deg(d) { return d * M.PI / 180.0; }

// multiply(A, B) = A*B — the transform that applies B first, then A.
fn multiply(A, B) {
    return map{
        a: A.a * B.a + A.c * B.b,
        b: A.b * B.a + A.d * B.b,
        c: A.a * B.c + A.c * B.d,
        d: A.b * B.c + A.d * B.d,
        e: A.a * B.e + A.c * B.f + A.e,
        f: A.b * B.e + A.d * B.f + A.f
    };
}
// apply(m, x, y) -> {x, y}.
fn apply(m, x, y) {
    return map{ x: m.a * x + m.c * y + m.e, y: m.b * x + m.d * y + m.f };
}

// ── matrix stack ─────────────────────────────────────────────────────────────────
fn stack_new() { return map{ frames: [identity()] }; }
fn current(st) { return st.frames[len(st.frames) - 1]; }
fn _set_top(st, m) { st.frames[len(st.frames) - 1] = m; return st; }
fn push(st) { array_push(st.frames, current(st)); return st; }   // duplicate top
fn pop(st) {
    if len(st.frames) > 1 {
        let out = [];
        let i = 0;
        while i < len(st.frames) - 1 { array_push(out, st.frames[i]); i = i + 1; }
        st.frames = out;
    }
    return st;
}
// concatenate a transform in LOCAL coordinates: top = top * m.
fn stack_mul(st, m) { return _set_top(st, multiply(current(st), m)); }
fn stack_translate(st, tx, ty) { return stack_mul(st, translate(tx, ty)); }
fn stack_scale(st, sx, sy) { return stack_mul(st, scale(sx, sy)); }
fn stack_rotate(st, rad) { return stack_mul(st, rotate(rad)); }
fn stack_apply(st, x, y) { return apply(current(st), x, y); }

// ── clip-rect stack (intersection) ─────────────────────────────────────────────────
fn rect_intersect(a, b) {
    let x = _max(a.x, b.x);
    let y = _max(a.y, b.y);
    let w = _min(a.x + a.w, b.x + b.w) - x;
    let h = _min(a.y + a.h, b.y + b.h) - y;
    if w < 0 { w = 0; }
    if h < 0 { h = 0; }
    return map{ x: x, y: y, w: w, h: h };
}
fn clip_new(x, y, w, h) { return map{ rects: [map{ x: x, y: y, w: w, h: h }] }; }
fn clip_current(cs) { return cs.rects[len(cs.rects) - 1]; }
fn clip_push(cs, r) { array_push(cs.rects, rect_intersect(clip_current(cs), r)); return cs; }
fn clip_pop(cs) {
    if len(cs.rects) > 1 {
        let out = [];
        let i = 0;
        while i < len(cs.rects) - 1 { array_push(out, cs.rects[i]); i = i + 1; }
        cs.rects = out;
    }
    return cs;
}
fn clip_contains(cs, x, y) {
    let r = clip_current(cs);
    return x >= r.x and x < r.x + r.w and y >= r.y and y < r.y + r.h;
}

export identity, translate, scale, rotate, deg, multiply, apply;
export stack_new, current, push, pop, stack_mul, stack_translate, stack_scale, stack_rotate, stack_apply;
export rect_intersect, clip_new, clip_current, clip_push, clip_pop, clip_contains;
