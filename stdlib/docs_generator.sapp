// stdlib/docs_generator.sapp — Documentation generator for pblang
//
// Generates HTML API documentation from .sapp source files.
// Extracts doc comments (//! and ///), function signatures, exports,
// and type annotations to produce comprehensive reference docs.
//
// Usage:
//   let docs = import("stdlib:docs_generator.sapp");
//   let html = docs.generate_file("stdlib/http.sapp");
//   docs.generate_dir("stdlib/", "doc_out/");

// ── Doc Comment Extraction ───────────────────────────────────────────────────

// extract_doc_comments(source) — extract all /// doc comments from source
fn extract_doc_comments(source) {
    let lines = str_split(source, "\n");
    let comments = [];
    let current_comment = [];
    let i = 0;
    while i < len(lines) {
        let line = str_trim(lines[i]);
        if str_starts_with(line, "///") {
            let text = str_trim(str_slice(line, 3, len(line)));
            array_push(current_comment, text);
        } else if str_starts_with(line, "//!") {
            let text = str_trim(str_slice(line, 3, len(line)));
            array_push(current_comment, text);
        } else {
            if len(current_comment) > 0 {
                array_push(comments, str_join(current_comment, " "));
                current_comment = [];
            }
        }
        i = i + 1;
    }
    if len(current_comment) > 0 {
        array_push(comments, str_join(current_comment, " "));
    }
    return comments;
}

// ── Function Signature Extraction ─────────────────────────────────────────────

// extract_functions(source) — extract function signatures
fn extract_functions(source) {
    let lines = str_split(source, "\n");
    let functions = [];
    let i = 0;
    while i < len(lines) {
        let line = str_trim(lines[i]);
        if str_starts_with(line, "fn ") or str_starts_with(line, "pub fn ") {
            // Collect the full signature (multi-line)
            let sig = line;
            while !str_contains(sig, "{") and i + 1 < len(lines) {
                i = i + 1;
                sig = sig + " " + str_trim(lines[i]);
            }
            // Extract function name
            let name_start = 3;
            if str_starts_with(sig, "pub fn ") { name_start = 7; }
            let name_end = str_index_of(sig, "(");
            if name_end > name_start {
                let name = str_trim(str_slice(sig, name_start, name_end));
                array_push(functions, map{
                    name: name,
                    signature: str_trim(sig),
                });
            }
        }
        i = i + 1;
    }
    return functions;
}

// extract_exports(source) — extract export statements
fn extract_exports(source) {
    let lines = str_split(source, "\n");
    let exports = [];
    let i = 0;
    while i < len(lines) {
        let line = str_trim(lines[i]);
        if str_starts_with(line, "export ") {
            let items = str_trim(str_slice(line, 7, len(line)));
            if str_ends_with(items, ";") {
                items = str_slice(items, 0, len(items) - 1);
            }
            let parts = str_split(items, ",");
            let j = 0;
            while j < len(parts) {
                array_push(exports, str_trim(parts[j]));
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return exports;
}

// ── HTML Generation ───────────────────────────────────────────────────────────

// generate_html(module_name, functions, exports, comments) — produce HTML docs
fn generate_html(module_name, functions, exports, comments) {
    let html = "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n";
    html = html + "<meta charset=\"UTF-8\">\n";
    html = html + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n";
    html = html + "<title>pblang: " + module_name + "</title>\n";
    html = html + "<style>\n";
    html = html + "body { font-family: system-ui, sans-serif; max-width: 960px; margin: 0 auto; padding: 2rem; background: #0d1117; color: #c9d1d9; }\n";
    html = html + "h1 { color: #58a6ff; border-bottom: 1px solid #30363d; padding-bottom: 0.5rem; }\n";
    html = html + "h2 { color: #f0883e; margin-top: 2rem; }\n";
    html = html + ".fn-sig { background: #161b22; border: 1px solid #30363d; border-radius: 6px; padding: 0.75rem; margin: 0.5rem 0; font-family: monospace; color: #7ee787; }\n";
    html = html + ".fn-name { color: #d2a8ff; font-weight: bold; }\n";
    html = html + ".doc-comment { color: #8b949e; font-style: italic; margin: 0.5rem 0; padding-left: 1rem; border-left: 3px solid #30363d; }\n";
    html = html + ".exports { display: flex; flex-wrap: wrap; gap: 0.5rem; }\n";
    html = html + ".export-tag { background: #1f6feb22; border: 1px solid #1f6feb; border-radius: 20px; padding: 0.25rem 0.75rem; font-size: 0.85rem; color: #58a6ff; }\n";
    html = html + ".meta { color: #8b949e; font-size: 0.9rem; margin-top: 2rem; }\n";
    html = html + "</style>\n</head>\n<body>\n";

    html = html + "<h1>📦 " + html_escape(module_name) + "</h1>\n";

    // Exports section
    if len(exports) > 0 {
        html = html + "<h2>📤 Exports</h2>\n";
        html = html + "<div class=\"exports\">\n";
        let j = 0;
        while j < len(exports) {
            html = html + "<span class=\"export-tag\">" + html_escape(exports[j]) + "</span>\n";
            j = j + 1;
        }
        html = html + "</div>\n";
    }

    // Functions section
    html = html + "<h2>🔧 Functions (" + str(len(functions)) + ")</h2>\n";
    let i = 0;
    while i < len(functions) {
        let fn_info = functions[i];
        html = html + "<div class=\"fn-sig\">";
        html = html + "<span class=\"fn-name\">fn " + html_escape(fn_info.name) + "</span>";
        html = html + html_escape(str_slice(fn_info.signature, 2 + len(fn_info.name), len(fn_info.signature)));
        html = html + "</div>\n";
        if i < len(comments) {
            html = html + "<div class=\"doc-comment\">" + html_escape(comments[i]) + "</div>\n";
        }
        i = i + 1;
    }

    // Meta
    html = html + "<div class=\"meta\">Generated by pblang docs generator • " + now_iso() + "</div>\n";
    html = html + "</body>\n</html>";
    return html;
}

// ── File/Directory Processing ─────────────────────────────────────────────────

// generate_file(filepath) — generate HTML docs for a single file
fn generate_file(filepath) {
    let source = fs_read(filepath);
    if source == nil { return map{error: "cannot read file: " + filepath}; }

    let module_name = path_basename(filepath);
    let comments = extract_doc_comments(source);
    let functions = extract_functions(source);
    let exports = extract_exports(source);

    return generate_html(module_name, functions, exports, comments);
}

// generate_dir(dirpath, out_dir) — generate docs for all .sapp files in a directory
fn generate_dir(dirpath, out_dir) {
    let files = fs_listdir(dirpath);
    if files == nil { return map{error: "cannot read directory: " + dirpath}; }

    let results = [];
    let i = 0;
    while i < len(files) {
        let file = files[i];
        if str_ends_with(file, ".sapp") or str_ends_with(file, ".sap") {
            let full_path = dirpath + "/" + file;
            let html = generate_file(full_path);
            if !map_has(html, "error") {
                let out_name = file + ".html";
                if str_ends_with(out_name, ".sapp.html") {
                    out_name = str_replace_all(out_name, ".sapp.html", ".html");
                }
                if str_ends_with(out_name, ".sap.html") {
                    out_name = str_replace_all(out_name, ".sap.html", ".html");
                }
                fs_write(out_dir + "/" + out_name, html);
                array_push(results, file + " → " + out_name);
            } else {
                array_push(results, file + " ✗ " + html.error);
            }
        }
        i = i + 1;
    }

    // Generate index
    let index_html = "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>pblang Standard Library</title>\n";
    index_html = index_html + "<style>body{font-family:system-ui,sans-serif;max-width:960px;margin:0 auto;padding:2rem;background:#0d1117;color:#c9d1d9;}h1{color:#58a6ff;}a{color:#58a6ff;text-decoration:none;}a:hover{text-decoration:underline;}li{margin:0.5rem 0;}</style>\n</head>\n<body>\n";
    index_html = index_html + "<h1>📚 pblang Standard Library</h1>\n<ul>\n";
    let k = 0;
    while k < len(results) {
        let r = results[k];
        let parts = str_split(r, " → ");
        index_html = index_html + "<li><a href=\"" + html_escape(parts[1]) + "\">" + html_escape(parts[0]) + "</a></li>\n";
        k = k + 1;
    }
    index_html = index_html + "</ul>\n<p>" + str(len(results)) + " modules documented.</p>\n</body>\n</html>";
    fs_write(out_dir + "/index.html", index_html);

    return map{
        ok: true,
        modules: len(results),
        output_dir: out_dir,
    };
}

// ── Helpers ───────────────────────────────────────────────────────────────────

fn html_escape(text) {
    text = str_replace_all(text, "&", "&amp;");
    text = str_replace_all(text, "<", "&lt;");
    text = str_replace_all(text, ">", "&gt;");
    text = str_replace_all(text, "\"", "&quot;");
    return text;
}

fn path_basename(filepath) {
    let parts = str_split(filepath, "/");
    if len(parts) == 0 {
        parts = str_split(filepath, "\\");
    }
    return parts[len(parts) - 1];
}

export extract_doc_comments, extract_functions, extract_exports;
export generate_html, generate_file, generate_dir;
