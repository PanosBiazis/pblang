// Pure temporal partitioning of validated research observations. No acquisition.
let Research=import("stdlib:research_observations.sapp");
let Units=import("stdlib:units.sapp");
let MAX_WINDOWS=32;
fn _number(value,minimum,maximum) {
    if type(value)!="number" or not (value>=minimum and value<=maximum) {
        throw "research windows: number outside finite bounds";
    }
}
fn _edges(spec,grid) {
    if type(grid)!="map" or len(grid)!=3 or not map_has(grid,"start")
        or not map_has(grid,"duration") or not map_has(grid,"count") {
        throw "research windows: invalid grid shape";
    }
    _number(grid.start,0,1000000000);_number(grid.duration,0,1000000000);
    _number(grid.count,1,MAX_WINDOWS);
    if grid.duration==0 or grid.count!=num_floor(grid.count) {
        throw "research windows: positive duration and integral count required";
    }
    let start=Units.convert_checked(grid.start,spec.time_unit,"s");
    let duration=Units.convert_checked(grid.duration,spec.time_unit,"s");
    _number(start,0,1000000000000);_number(duration,0,1000000000000);
    let edges=[start];let previous=start;
    for i in range(1,grid.count+1) {
        let edge=start+i*duration;_number(edge,0,1000000000000);
        if edge<=previous {throw "research windows: edges must advance at numeric precision";}
        array_push(edges,edge);previous=edge;
    }
    return map{edges:edges,duration_seconds:duration};
}
fn _metrics(report) {
    return map{row_count:report.row_count,subject_count:report.subject_count,
        observed_count:report.observed_count,missing_count:report.missing_count,
        missing_fraction:report.missing_fraction,minimum:report.minimum,maximum:report.maximum,
        mean:report.mean,time_span_seconds:report.time_span_seconds};
}
fn review(spec,rows,grid) {
    // Validate every row first, including rows outside the requested windows.
    let overall=Research.summarize(spec,rows);let prepared=_edges(spec,grid);
    let edges=prepared.edges;let buckets=[];
    for _i in range(0,grid.count) {array_push(buckets,[]);}
    let before=0;let after=0;let included=0;
    for row in rows {
        let time=Units.convert_checked(row.time,spec.time_unit,"s");
        if time<edges[0] {before=before+1;}
        elif time>=edges[grid.count] {after=after+1;}
        else {
            for i in range(0,grid.count) {
                if time>=edges[i] and time<edges[i+1] {
                    array_push(buckets[i],row);included=included+1;break;
                }
            }
        }
    }
    let windows=[];let states=map{empty:0,all_missing:0,partial:0,observed:0};
    for i in range(0,grid.count) {
        let summary=Research.summarize(spec,buckets[i]);
        let state="observed";
        if summary.row_count==0 {state="empty";}
        elif summary.observed_count==0 {state="all_missing";}
        elif summary.missing_count>0 {state="partial";}
        states[state]=states[state]+1;
        array_push(windows,map{slot:i,start_seconds:edges[i],end_seconds:edges[i+1],
            state:state,metrics:_metrics(summary)});
    }
    return map{format:"pblang.research-window-review.v1",overall:overall,windows:windows,
        grid:map{start_seconds:edges[0],duration_seconds:prepared.duration_seconds,count:grid.count,
            bounds:"left-inclusive-right-exclusive",edge_method:"normalized-start-plus-index-times-normalized-duration"},
        included_rows:included,before_rows:before,after_rows:after,state_counts:states,
        contains_rows:false,contains_subject_ids:false,contains_observation_times:false,
        contains_measurement_statistics:true,expected_cadence_verified:false,
        coverage_verified:false,scientific_validity_verified:false,
        acquisition_performed:false,monitoring_started:false,safe_to_log:false};
}
export MAX_WINDOWS,review;
