let P=import("stdlib:palette_document.sapp");let UI=import("stdlib:modern_ui.sapp");let Pages=import("stdlib:text_pages.sapp");
fn lines(item,background){let label=Pages.wrap(item.label,24);let out=[];for i in range(0,4){array_push(out,if i<len(label){label[i]} else {""});}array_push(out,"Color: "+item.hex);array_push(out,"Background: "+background);array_push(out,"Contrast approx: "+str(num_floor(item.contrast.ratio*100)/100)+":1");array_push(out,"AA normal: "+str(item.contrast.aa_normal));array_push(out,"AA large: "+str(item.contrast.aa_large));array_push(out,"AAA normal: "+str(item.contrast.aaa_normal));array_push(out,"Black/white text: "+item.best_text.hex);return out;}
fn create(doc){let items=P.analyze(doc);let first=lines(items[0],doc.background);let children=[UI.heading("PBPalette")];for line in Pages.wrap(doc.title,24){array_push(children,UI.text(line));}for i in range(0,len(first)){array_push(children,UI.text(first[i],map{name:"detail_"+str(i)}));}let buttons=[];
 for index in range(0,len(items)){let text=lines(items[index],doc.background);let actions=[];for i in range(0,len(text)){array_push(actions,UI.action_set_text("detail_"+str(i),text[i]));}array_push(buttons,UI.button("Color "+str(index+1),UI.action_sequence(actions),map{name:"select_"+str(index)}));}
 array_push(children,UI.grid(buttons,map{columns:4}));array_push(children,UI.text("Opaque sRGB pair metrics. This is not an accessibility audit of an application."));return UI.screen(children);
}
export lines,create;
