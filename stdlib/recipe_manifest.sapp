// Declarative recipe contracts. No evaluation of code, capability grants or I/O.
let Fields=import("stdlib:template_fields.sapp");
let FORMAT="pblang.recipe-manifest.v1";let MAX_RECIPES=32;
let PLATFORMS=["linux","windows","macos","android","ios","web"];
fn _contains(items,value) {for item in items {if item==value {return true;}}return false;}
fn _names(items,limit,platforms=false) {
 if type(items)!="array" or len(items)>limit {throw "recipe: list limit";}
 let seen=map{};let out=[];
 for name in items {
  if not Fields.valid_name(name) or (platforms and not _contains(PLATFORMS,name)) {throw "recipe: invalid identifier";}
  if map_has(seen,name) {throw "recipe: duplicate identifier";}
  seen[name]=true;array_push(out,name);
 }
 return out;
}
fn _values(values) {
 if type(values)!="map" or len(values)>16 {throw "recipe: expected bounded scalar record";}
 let out=map{};
 for key in map_keys(values) {
  if not Fields.valid_name(key) {throw "recipe: invalid field name";}
  let value=values[key];let valid=value==nil or type(value)==type(true);
  if type(value)=="number" {valid=value>=-1000000000000 and value<=1000000000000;}
  elif type(value)=="string" {valid=len(value)<=256 and len(str_to_bytes(value))<=256 and not str_contains(value,"\u0000");}
  if not valid {throw "recipe: invalid scalar value";}
  out[key]=value;
 }
 return out;
}
fn validate(manifest) {
 if type(manifest)!="map" or len(manifest)!=2 or (try manifest.format catch nil)!=FORMAT or type(try manifest.recipes catch nil)!="array" or len(manifest.recipes)>MAX_RECIPES {throw "recipe: invalid manifest";}
 let ids=map{};
 for recipe in manifest.recipes {
  if type(recipe)!="map" or len(recipe)!=5 or not Fields.valid_name(try recipe.id catch nil) or not map_has(recipe,"platforms") or not map_has(recipe,"requires") or not map_has(recipe,"inputs") or not map_has(recipe,"expected") {throw "recipe: invalid recipe";}
  if map_has(ids,recipe.id) {throw "recipe: duplicate recipe";}ids[recipe.id]=true;
  _names(recipe.platforms,6,true);if len(recipe.platforms)==0 {throw "recipe: empty platform list";}
  _names(recipe.requires,16);_values(recipe.inputs);_values(recipe.expected);
 }
 return true;
}
fn plan(manifest,platform,available) {
 validate(manifest);if not _contains(PLATFORMS,platform) {throw "recipe: unknown platform";}
 let capabilities=_names(available,64);let rows=[];
 for recipe in manifest.recipes {
  let missing=[];for name in recipe.requires {if not _contains(capabilities,name) {array_push(missing,name);}}
  let supported=_contains(recipe.platforms,platform);let status=if supported and len(missing)==0 {"ready"} else {"unsupported"};
  array_push(rows,map{id:recipe.id,status:status,platform_supported:supported,missing_capabilities:missing,inputs:_values(recipe.inputs),expected:_values(recipe.expected)});
 }
 return map{format:"pblang.recipe-plan.v1",platform:platform,recipes:rows,capability_claims_verified:false,execution_performed:false};
}
fn _equal(expected,actual) {
 if len(expected)!=len(actual) {return false;}
 for key in map_keys(expected) {if not map_has(actual,key) or type(expected[key])!=type(actual[key]) or expected[key]!=actual[key] {return false;}}
 return true;
}
fn assess(manifest,platform,available,observations) {
 let prepared=plan(manifest,platform,available);
 if type(observations)!="array" or len(observations)>MAX_RECIPES {throw "recipe: observation limit";}
 let known=map{};for recipe in prepared.recipes {known[recipe.id]=recipe.status;}
 let observed=map{};
 for observation in observations {
  if type(observation)!="map" or len(observation)!=2 or not Fields.valid_name(try observation.id catch nil) or not map_has(observation,"actual") {throw "recipe: invalid observation";}
  if not map_has(known,observation.id) or map_has(observed,observation.id) {throw "recipe: unknown or duplicate observation";}
  if known[observation.id]!="ready" {throw "recipe: observation for unsupported recipe";}
  observed[observation.id]=_values(observation.actual);
 }
 let rows=[];let counts=map{matched:0,mismatch:0,not_run:0,unsupported:0};
 for recipe in prepared.recipes {
  let status=recipe.status;
  if status=="ready" {
   status="not_run";
   if map_has(observed,recipe.id) {status=if _equal(recipe.expected,observed[recipe.id]) {"matched"} else {"mismatch"};}
  }
  counts[status]=counts[status]+1;
  array_push(rows,map{id:recipe.id,status:status,platform_supported:recipe.platform_supported,missing_capabilities:recipe.missing_capabilities});
 }
 return map{format:"pblang.recipe-assessment.v1",platform:platform,recipes:rows,counts:counts,observations_are_caller_supplied:true,execution_verified:false,raw_values_included:false};
}
export FORMAT,MAX_RECIPES,validate,plan,assess;
