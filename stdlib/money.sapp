// stdlib/money.sapp — currency/money handling with EXACT arbitrary-precision
// arithmetic, built on the `decimal` type. No floating-point cents-drift:
// add(0.10, 0.20) is exactly 0.30, and `split` allocates with no lost cents.
//
// Amounts may be passed as a number, a string ("19.99"), or a decimal; all
// operations return exact `decimal` values.

let _ZERO = decimal("0");
let _HUNDRED = decimal("100");

fn _d(x) { return decimal(x); }

// Round a decimal `d` to `places` fractional digits (round-half-up on
// magnitude), exactly — carrying across digit boundaries via bigint.
// e.g. round(decimal("3.336"), 2) -> 3.34, round(decimal("9.99"), 1) -> 10.
fn round(d, places) {
    let s = str(_d(d));
    let neg = false;
    if len(s) > 0 and s[0] == "-" { neg = true; s = slice(s, 1, len(s)); }
    let parts = str_split(s, ".");
    let int_part = parts[0];
    let frac = "";
    if len(parts) > 1 { frac = parts[1]; }
    while len(frac) < places + 1 { frac = frac + "0"; }       // ensure a rounding digit
    let kept = slice(frac, 0, places);
    let round_digit = frac[places];
    let scaled = bigint(int_part + kept);                     // value * 10^places (truncated)
    if parse_number(round_digit) >= 5 { scaled = scaled + bigint(1); }
    let ds = str(scaled);
    while len(ds) < places + 1 { ds = "0" + ds; }             // left-pad before inserting point
    let cut = len(ds) - places;
    let out = slice(ds, 0, cut);
    if places > 0 { out = out + "." + slice(ds, cut, len(ds)); }
    if neg and scaled != bigint(0) { out = "-" + out; }
    return decimal(out);
}

// Integer cents of an amount (rounded to the nearest cent), as a number.
fn cents(amount) { return parse_number(str(round(_d(amount) * _HUNDRED, 0))); }
fn from_cents(c) { return _d(c) / _HUNDRED; }

fn add(a, b) { return _d(a) + _d(b); }
fn subtract(a, b) { return _d(a) - _d(b); }
fn multiply(amount, factor) { return _d(amount) * _d(factor); }
fn divide(amount, divisor) {
    if _d(divisor) == _ZERO { return error("money: division by zero"); }
    return round(_d(amount) / _d(divisor), 2);
}

// Format with exactly `decimals` places, e.g. format(1) -> "1.00 USD".
fn format(amount, currency = "USD", decimals = 2) {
    let s = str(round(_d(amount), decimals));
    let neg = false;
    if len(s) > 0 and s[0] == "-" { neg = true; s = slice(s, 1, len(s)); }
    let parts = str_split(s, ".");
    let ip = parts[0];
    let fp = "";
    if len(parts) > 1 { fp = parts[1]; }
    while len(fp) < decimals { fp = fp + "0"; }
    let sign = ""; if neg { sign = "-"; }
    if decimals > 0 { return sign + ip + "." + fp + " " + currency; }
    return sign + ip + " " + currency;
}

fn percent(amount, pct) { return multiply(amount, _d(pct) / _HUNDRED); }
fn tax(amount, rate) { return add(amount, percent(amount, rate)); }
fn discount(amount, pct) { return subtract(amount, percent(amount, pct)); }

// Allocate `amount` into `n` equal parts with no lost cents (largest-remainder).
// Works in integer cents via bigint, so the parts sum back to the original.
fn split(amount, n) {
    let total = bigint(str(round(_d(amount) * _HUNDRED, 0)));  // total cents (integer)
    let nn = bigint(n);
    let base = total / nn;                                     // floor toward zero
    let rem = total - base * nn;                               // leftover cents
    let parts = [];
    let i = 0;
    while i < n {
        let c = base;
        if bigint(i) < rem { c = c + bigint(1); }              // first `rem` parts get +1 cent
        array_push(parts, _d(str(c)) / _HUNDRED);
        i = i + 1;
    }
    return parts;
}

export cents, from_cents, add, subtract, multiply, divide, round, format, percent, tax, discount, split;
