// stdlib/money.sapp — Currency/money handling with precision arithmetic.
fn cents(amount) { return num_floor(amount * 100 + 0.5); }
fn from_cents(c) { return c / 100.0; }
fn add(a, b) { return from_cents(cents(a) + cents(b)); }
fn subtract(a, b) { return from_cents(cents(a) - cents(b)); }
fn multiply(amount, factor) { return from_cents(num_floor(cents(amount) * factor + 0.5)); }
fn divide(amount, divisor) { if divisor == 0 { return error("money: division by zero"); } return from_cents(num_floor(cents(amount) / divisor + 0.5)); }
fn format(amount, currency = "USD", decimals = 2) {
    let abs_val = amount; if abs_val < 0 { abs_val = 0 - abs_val; }
    let int_part = num_floor(abs_val);
    let frac_part = num_floor((abs_val - int_part) * num_pow(10, decimals) + 0.5);
    let frac_str = str(frac_part);
    while len(frac_str) < decimals { frac_str = "0" + frac_str; }
    let sign = ""; if amount < 0 { sign = "-"; }
    return sign + str(int_part) + "." + frac_str + " " + currency;
}
fn percent(amount, pct) { return multiply(amount, pct / 100.0); }
fn tax(amount, rate) { return add(amount, percent(amount, rate)); }
fn discount(amount, pct) { return subtract(amount, percent(amount, pct)); }
export cents, from_cents, add, subtract, multiply, divide, format, percent, tax, discount;
