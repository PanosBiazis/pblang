// stdlib/template.sapp — Simple string templating engine.
//
// Supports: {{ variable }}, {% if cond %} ... {% endif %}, {% for x in arr %} ... {% endfor %},
// {% include "file" %}, {# comment #}, custom filters.
//
// Usage:
//   let tmpl = import("stdlib:template.sapp");
//   let out = tmpl.render("Hello, {{ name }}!", map{ name: "World" });
//   let html = tmpl.render_file("views/index.html", map{ title: "My Page" });

// render(template_str, context_map) — render a template string with context values.
fn render(template_str, ctx = nil) {
    if ctx == nil { ctx = map{}; }
    let result = template_str;

    // 1. Remove {# comments #}
    result = _strip_comments(result);

    // 2. Process {% if cond %}...{% endif %} blocks
    result = _process_if_blocks(result, ctx);

    // 3. Process {% for item in list %}...{% endfor %} blocks
    result = _process_for_blocks(result, ctx);

    // 4. Substitute {{ variable }} and {{ expr | filter }} placeholders
    result = _substitute_vars(result, ctx);

    return result;
}

fn _copy_map(m) {
    let out = map{};
    let keys = map_keys(m);
    for i len(keys) {
        out[keys[i]] = m[keys[i]];
    }
    return out;
}

fn _truthy(v) {
    return v != nil and v != false and v != 0 and v != "";
}

fn _unquote(s) {
    let t = str_trim(s);
    if len(t) >= 2 {
        let a = str_slice(t, 0, 1);
        let b = str_slice(t, len(t) - 1, len(t));
        if (a == "\"" and b == "\"") or (a == "'" and b == "'") {
            return str_slice(t, 1, len(t) - 1);
        }
    }
    return t;
}

// _strip_comments(s) — remove {# ... #} comments
fn _strip_comments(s) {
    let out = "";
    let i = 0;
    let n = len(s);
    while i < n {
        if i + 1 < n and str_slice(s, i, i + 2) == "{#" {
            // find #}
            let end = i + 2;
            while end + 1 < n and str_slice(s, end, end + 2) != "#}" {
                end = end + 1;
            }
            i = end + 2;
        } else {
            out = out + str_slice(s, i, i + 1);
            i = i + 1;
        }
    }
    return out;
}

// _resolve_var(expr, ctx) — resolve a variable expression in context.
// Supports dotted access: "user.name" → ctx.user.name
fn _resolve_var(expr, ctx) {
    let trimmed = str_trim(expr);
    // Handle chained filters: "variable | trim | upper"
    if str_contains(trimmed, "|") {
        let parts = str_split(trimmed, "|");
        let var_name = str_trim(parts[0]);
        let val = _resolve_simple(var_name, ctx);
        for i len(parts) {
            if i > 0 {
                val = _apply_filter(val, str_trim(parts[i]));
            }
        }
        return val;
    }
    return _resolve_simple(trimmed, ctx);
}

fn _resolve_simple(name, ctx) {
    let n = str_trim(name);
    if n == "true" { return true; }
    if n == "false" { return false; }
    if n == "nil" or n == "null" { return nil; }
    if len(n) >= 2 {
        let first = str_slice(n, 0, 1);
        let last = str_slice(n, len(n) - 1, len(n));
        if (first == "\"" and last == "\"") or (first == "'" and last == "'") {
            return str_slice(n, 1, len(n) - 1);
        }
    }
    // Dotted access: "obj.field"
    if str_contains(n, ".") {
        let parts = str_split(n, ".");
        let val = try ctx[parts[0]] catch nil;
        for i len(parts) {
            if i == 0 { } // already got parts[0]
            else {
                if type(val) == "map" {
                    val = try val[parts[i]] catch nil;
                } else {
                    return nil;
                }
            }
        }
        return val;
    }
    return try ctx[n] catch nil;
}

fn _apply_filter(val, filter_spec) {
    let f = str_trim(filter_spec);
    let arg = nil;
    let colon = _str_find(f, ":");
    if colon >= 0 {
        arg = _unquote(str_slice(f, colon + 1, len(f)));
        f = str_trim(str_slice(f, 0, colon));
    }
    if f == "default" {
        if val == nil or val == "" { return arg; }
        return val;
    }
    if f == "upper" { return str_upper(str(val)); }
    if f == "lower" { return str_lower(str(val)); }
    if f == "trim"  { return str_trim(str(val)); }
    if f == "len"   { return str(len(val)); }
    if f == "json"  { return json_stringify(val); }
    if f == "html_escape" or f == "escape" { return escape_html(val); }
    if f == "join" and type(val) == "array" {
        let sep = ", ";
        if arg != nil { sep = arg; }
        let out = "";
        for i len(val) {
            if i > 0 { out = out + sep; }
            out = out + str(val[i]);
        }
        return out;
    }
    return str(val);
}

// _substitute_vars(s, ctx) — replace {{ expr }} with resolved values
fn _substitute_vars(s, ctx) {
    let out = "";
    let i = 0;
    let n = len(s);
    while i < n {
        if i + 1 < n and str_slice(s, i, i + 2) == "{{" {
            // Find }}
            let end = i + 2;
            while end + 1 < n and str_slice(s, end, end + 2) != "}}" {
                end = end + 1;
            }
            let expr = str_slice(s, i + 2, end);
            let val = _resolve_var(expr, ctx);
            if val == nil { val = ""; }
            out = out + str(val);
            i = end + 2;
        } else {
            out = out + str_slice(s, i, i + 1);
            i = i + 1;
        }
    }
    return out;
}

// _process_if_blocks — handle {% if cond %}...{% else %}...{% endif %}
fn _process_if_blocks(s, ctx) {
    // Simple single-level if/else/endif processing
    let if_tag = "{% if ";
    let else_tag = "{% else %}";
    let endif_tag = "{% endif %}";

    let out = "";
    let remaining = s;

    while str_contains(remaining, if_tag) {
        let if_start = _str_find(remaining, if_tag);
        out = out + str_slice(remaining, 0, if_start);

        // Extract condition
        let cond_start = if_start + len(if_tag);
        let cond_end = _str_find_from(remaining, " %}", cond_start);
        let cond_var = str_trim(str_slice(remaining, cond_start, cond_end));

        // Find endif
        let body_start = cond_end + 3;  // skip " %}"
        let endif_pos = _str_find_from(remaining, endif_tag, body_start);
        if endif_pos < 0 { break; }
        let body = str_slice(remaining, body_start, endif_pos);

        // Check for else
        let else_pos = _str_find(body, else_tag);
        let then_body = body;
        let else_body = "";
        if else_pos >= 0 {
            then_body = str_slice(body, 0, else_pos);
            else_body = str_slice(body, else_pos + len(else_tag), len(body));
        }

        // Evaluate condition
        let is_truthy = _eval_condition(cond_var, ctx);

        if is_truthy {
            out = out + then_body;
        } else {
            out = out + else_body;
        }

        remaining = str_slice(remaining, endif_pos + len(endif_tag), len(remaining));
    }

    return out + remaining;
}

fn _eval_condition(expr, ctx) {
    let cond = str_trim(expr);
    if str_slice(cond, 0, 4) == "not " {
        return not _truthy(_resolve_simple(str_trim(str_slice(cond, 4, len(cond))), ctx));
    }
    let neq = _str_find(cond, "!=");
    if neq >= 0 {
        let left = _resolve_simple(str_trim(str_slice(cond, 0, neq)), ctx);
        let right = _resolve_simple(str_trim(str_slice(cond, neq + 2, len(cond))), ctx);
        return str(left) != str(right);
    }
    let eq = _str_find(cond, "==");
    if eq >= 0 {
        let left = _resolve_simple(str_trim(str_slice(cond, 0, eq)), ctx);
        let right = _resolve_simple(str_trim(str_slice(cond, eq + 2, len(cond))), ctx);
        return str(left) == str(right);
    }
    return _truthy(_resolve_simple(cond, ctx));
}

// _process_for_blocks — handle {% for item in list %}...{% endfor %}
fn _process_for_blocks(s, ctx) {
    let for_tag = "{% for ";
    let endfor_tag = "{% endfor %}";

    let out = "";
    let remaining = s;

    while str_contains(remaining, for_tag) {
        let for_start = _str_find(remaining, for_tag);
        out = out + str_slice(remaining, 0, for_start);

        // Extract "item in list_var"
        let spec_start = for_start + len(for_tag);
        let spec_end = _str_find_from(remaining, " %}", spec_start);
        let spec = str_trim(str_slice(remaining, spec_start, spec_end));

        // Find endfor
        let body_start = spec_end + 3;
        let endfor_pos = _str_find_from(remaining, endfor_tag, body_start);
        if endfor_pos < 0 { break; }
        let body = str_slice(remaining, body_start, endfor_pos);

        // Parse "item in list_var"
        let in_parts = str_split(spec, " in ");
        if len(in_parts) == 2 {
            let item_var = str_trim(in_parts[0]);
            let list_var = str_trim(in_parts[1]);
            let list_val = _resolve_simple(list_var, ctx);

            if type(list_val) == "array" {
                for i len(list_val) {
                    let item_ctx = _copy_map(ctx);
                    item_ctx[item_var] = list_val[i];
                    item_ctx["loop_index"] = i;
                    item_ctx["loop_number"] = i + 1;
                    item_ctx["loop_first"] = i == 0;
                    item_ctx["loop_last"] = i == len(list_val) - 1;
                    out = out + render(body, item_ctx);
                }
            } else if type(list_val) == "map" {
                let keys = map_keys(list_val);
                for i len(keys) {
                    let item_ctx = _copy_map(ctx);
                    item_ctx[item_var] = keys[i];
                    item_ctx[item_var + "_value"] = list_val[keys[i]];
                    item_ctx["loop_index"] = i;
                    item_ctx["loop_number"] = i + 1;
                    item_ctx["loop_first"] = i == 0;
                    item_ctx["loop_last"] = i == len(keys) - 1;
                    out = out + render(body, item_ctx);
                }
            }
        }

        remaining = str_slice(remaining, endfor_pos + len(endfor_tag), len(remaining));
    }

    return out + remaining;
}

// _str_find(s, needle) — find first occurrence of needle in s, return index or -1
fn _str_find(s, needle) {
    if str_contains(s, needle) == false { return -1; }
    let n = len(s);
    let nl = len(needle);
    for i n {
        if i + nl <= n {
            if str_slice(s, i, i + nl) == needle { return i; }
        }
    }
    return -1;
}

// _str_find_from(s, needle, from) — find needle starting at position from
fn _str_find_from(s, needle, from) {
    let rest = str_slice(s, from, len(s));
    let pos = _str_find(rest, needle);
    if pos < 0 { return -1; }
    return from + pos;
}

// render_file(path, ctx) — read template from file and render
fn render_file(path, ctx) {
    let src = try fs_read(path) catch nil;
    if src == nil {
        return error("template.render_file: cannot read '" + path + "'");
    }
    return render(src, ctx);
}

fn missing_vars(template_str, ctx = nil) {
    if ctx == nil { ctx = map{}; }
    let missing = [];
    let seen = map{};
    let i = 0;
    let n = len(template_str);
    while i < n {
        if i + 1 < n and str_slice(template_str, i, i + 2) == "{{" {
            let end = i + 2;
            while end + 1 < n and str_slice(template_str, end, end + 2) != "}}" {
                end = end + 1;
            }
            let expr = str_trim(str_slice(template_str, i + 2, end));
            if str_contains(expr, "|") {
                expr = str_trim(str_split(expr, "|")[0]);
            }
            if _resolve_simple(expr, ctx) == nil and not map_has(seen, expr) {
                seen[expr] = true;
                array_push(missing, expr);
            }
            i = end + 2;
        } else {
            i = i + 1;
        }
    }
    return missing;
}

fn render_strict(template_str, ctx = nil) {
    let missing = missing_vars(template_str, ctx);
    if len(missing) > 0 {
        return error("template.render_strict: missing variable '" + missing[0] + "'");
    }
    return render(template_str, ctx);
}

// escape_html(s) — HTML-escape a string
fn escape_html(s) {
    s = str_replace_all(str(s), "&", "&amp;");
    s = str_replace_all(s, "<", "&lt;");
    s = str_replace_all(s, ">", "&gt;");
    s = str_replace_all(s, "\"", "&quot;");
    s = str_replace_all(s, "'", "&#x27;");
    return s;
}

export render, render_file, render_strict, missing_vars, escape_html;
