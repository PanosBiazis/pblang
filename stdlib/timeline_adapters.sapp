// Explicit conversions; source documents remain untouched.
let Timeline=import("stdlib:timeline_document.sapp");let Slides=import("stdlib:slide_document.sapp");let Subs=import("stdlib:subtitles.sapp");let Intervals=import("stdlib:interval_analysis.sapp");
fn from_slides(deck,duration_ms) {
    Slides.validate(deck);Intervals.validate([map{start_ms:0,end_ms:duration_ms}]);let entries=[];let time=0;
    for slide in deck.slides {array_push(entries,map{label:slide.title,start_ms:time,end_ms:time+duration_ms});time=time+duration_ms;}
    let out=map{format:Timeline.FORMAT,title:deck.title,entries:entries};Timeline.validate(out);return out;
}
fn from_subtitles(doc,title="Subtitle timing") {
    Subs.validate(doc);let entries=[];
    if len(doc.cues)>Timeline.MAX_ENTRIES {throw "timeline adapter: too many cues";}
    for i in range(0,len(doc.cues)) {let c=doc.cues[i];array_push(entries,map{label:"Cue "+str(i+1),start_ms:c.start_ms,end_ms:c.end_ms});}
    let out=map{format:Timeline.FORMAT,title:title,entries:entries};Timeline.validate(out);return out;
}
export from_slides,from_subtitles;
