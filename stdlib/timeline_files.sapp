let Agenda=import("stdlib:timeline_agenda.sapp");let Writer=import("stdlib:text_document_files.sapp");
let Adapters=import("stdlib:timeline_adapters.sapp"); let Slides=import("stdlib:slide_document.sapp"); let Subs=import("stdlib:subtitles.sapp");
let File=import("stdlib:secure_file.sapp"); let Timeline=import("stdlib:timeline_document.sapp");
fn _path(path) { return type(path)=="string" and len(path)>11 and len(path)<=4096 and len(str_to_bytes(path))<=4096 and str_ends_with(str_lower(path),".pbtimeline"); }
fn open(path) {
    if not _path(path) { return map{ok:false,error:"Choose a .pbtimeline path."}; }
    let read=try File.read_text(path,Timeline.MAX_FILE_BYTES,false) catch nil;
    if read==nil or not read.ok { return map{ok:false,error:"Could not read timeline."}; }
    let doc=try Timeline.decode(read.text) catch nil;
    if doc==nil { return map{ok:false,error:"Invalid timeline or supported limits exceeded."}; }
    return map{ok:true,document:doc};
}
fn save(path,doc) {
    if not _path(path) { return map{ok:false,error:"Choose a new .pbtimeline path."}; }
    let text=try Timeline.encode(doc) catch nil;
    if text==nil { return map{ok:false,error:"Invalid timeline; nothing written."}; }
    let result=try File.write_text_new_exclusive(path,text,false,false) catch nil;
    if result==nil or not result.ok { return map{ok:false,error:"Copy not confirmed. Use a new filename; a failed copy may be incomplete."}; }
    return map{ok:true,atomic_visibility:false};
}

fn import_document(path,kind,duration_ms=60000) {
    let extension=if kind=="slides" {".pbslides"} else {".srt"};
    if (kind!="slides" and kind!="subtitles") or type(path)!="string" or len(path)<=len(extension)
        or len(path)>4096 or len(str_to_bytes(path))>4096 or not str_ends_with(str_lower(path),extension) {return map{ok:false,error:"Choose an input path matching slides or subtitles."};}
    let maximum=if kind=="slides" {Slides.MAX_FILE_BYTES} else {Subs.MAX_INPUT_BYTES};
    let read=try File.read_text(path,maximum,false) catch nil;
    if read==nil or not read.ok {return map{ok:false,error:"Could not read input document."};}
    let doc=try (if kind=="slides" {Adapters.from_slides(Slides.decode(read.text),duration_ms)} else {Adapters.from_subtitles(Subs.parse_srt(read.text))}) catch nil;
    if doc==nil {return map{ok:false,error:"Unsupported input, title, duration or timeline limit. Source retained."};}
    return map{ok:true,document:doc};
}
fn export_agenda(path,doc,clock) {
 let agenda=try Agenda.to_document(doc,clock) catch nil;
 if agenda==nil {return map{ok:false,error:"Invalid timeline or clock. Use HH:MM (00:00-23:59); nothing written."};}
 return Writer.save_copy(path,agenda);
}
export open,save,import_document,export_agenda;
