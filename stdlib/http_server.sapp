// Minimal HTTP server stdlib (interop-first, single-threaded).
//
// Usage:
//   import "stdlib:http_server.sapp";
//   fn handler(req) { return "hello"; }
//   let addr = http_server.serve_once("127.0.0.1:0", handler);  // returns actual bound addr
//
// Handler can return:
// - string body (status=200)
// - map{ status: 200, body: "ok" }


// --- Security & Utility Helpers ---

// url_decode(s) — percent-decode a URL-encoded string (e.g. %20 -> space, %3D -> =)
fn url_decode(s) {
    let out = "";
    let i = 0;
    let n = len(s);
    while i < n {
        let ch = str_slice(s, i, i + 1);
        if ch == "%" and (i + 2) < n {
            let hex = str_slice(s, i + 1, i + 3);
            let code = try parse_number("0x" + hex) catch nil;
            if code != nil {
                out = out + str_from_char_code(code);
                i = i + 3;
            } else {
                out = out + ch;
                i = i + 1;
            }
        } else if ch == "+" {
            out = out + " ";
            i = i + 1;
        } else {
            out = out + ch;
            i = i + 1;
        }
    }
    return out;
}

// _path_safe(root, req_path) — sanitize req_path so it cannot escape root.
// Returns the resolved path string, or nil if the path would escape root.
fn _path_safe(root, req_path) {
    // Strip leading slash
    let clean = req_path;
    if str_starts_with(clean, "/") {
        clean = str_slice(clean, 1, len(clean));
    }
    // URL-decode so that %2F, %2e%2e etc. are decoded before the traversal check
    clean = url_decode(clean);
    // Reject any path segment that is ".."
    let segs = str_split(clean, "/");
    let safe_segs = [];
    for i len(segs) {
        let seg = segs[i];
        // Drop empty segments, current-dir ".", and parent ".."
        if seg == "" or seg == "." { } // skip
        else if seg == ".." { return nil; }  // traversal attempt
        else { safe_segs[len(safe_segs)] = seg; }
    }
    // Rebuild path
    let result = root;
    for i len(safe_segs) {
        result = result + "/" + safe_segs[i];
    }
    return result;
}

fn _status_text(code) {
    if code == 200 { return "OK"; }
    if code == 201 { return "Created"; }
    if code == 302 { return "Found"; }
    if code == 400 { return "Bad Request"; }
    if code == 401 { return "Unauthorized"; }
    if code == 403 { return "Forbidden"; }
    if code == 404 { return "Not Found"; }
    if code == 413 { return "Request Entity Too Large"; }
    if code == 429 { return "Too Many Requests"; }
    if code == 500 { return "Internal Server Error"; }
    return "OK";
}

fn _header_name_safe(name) {
    let s = str(name);
    if s == "" { return false; }
    if str_contains(s, "\r") or str_contains(s, "\n") or str_contains(s, ":") { return false; }
    let allowed = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-";
    let i = 0;
    while i < len(s) {
        let ch = str_slice(s, i, i + 1);
        if not str_contains(allowed, ch) { return false; }
        i = i + 1;
    }
    return true;
}

fn _header_value_safe(value) {
    let s = str(value);
    return not str_contains(s, "\r") and not str_contains(s, "\n");
}

fn _safe_content_type(ct) {
    if ct == nil { return nil; }
    if _header_value_safe(ct) { return ct; }
    return "text/plain";
}

fn _build_response(status, ct, body, extra_headers) {
    let resp = "HTTP/1.1 " + str(status) + " " + _status_text(status) + "\r\n";
    resp = resp + "Content-Length: " + str(len(body)) + "\r\n";
    let safe_ct = _safe_content_type(ct);
    if safe_ct != nil {
        resp = resp + "Content-Type: " + safe_ct + "\r\n";
    }
    if extra_headers != nil {
        let ks = map_keys(extra_headers);
        for i len(ks) {
            if _header_name_safe(ks[i]) and _header_value_safe(extra_headers[ks[i]]) {
                resp = resp + ks[i] + ": " + str(extra_headers[ks[i]]) + "\r\n";
            }
        }
    }
    resp = resp + "\r\n" + body;
    return resp;
}

fn _resp_from_handler(out) {
    if type(out) == "map" {
        let status = try out.status catch 200;
        let jv = try out.json catch nil;
        if jv != nil {
            return http_response_json(status, jv);
        }

        let body = try out.body catch "";
        let ct = try out.content_type catch "text/plain";
        let extra_headers = try out.headers catch nil;

        if extra_headers != nil {
            return _build_response(status, ct, body, extra_headers);
        }

        if ct == "text/plain" or ct == nil {
            return http_response(status, body);
        }
        return http_response_ct(status, ct, body);
    }
    return http_response(200, out);
}

fn to_http_response(out) {
    return _resp_from_handler(out);
}

fn _path_only(p) {
    // strip query string
    let parts = str_split(p, "?");
    return parts[0];
}

fn _query_string(p) {
    let parts = str_split(p, "?");
    return try parts[1] catch "";
}

fn _parse_query(qs) {
    // qs: "a=1&b=2%20hi" -> map{ a: "1", b: "2 hi" }
    // URL-decodes both keys and values so encoded characters are correctly handled.
    let out = map{};
    if qs == "" { return out; }
    let pairs = str_split(qs, "&");
    for i len(pairs) {
        let kv = str_split(pairs[i], "=");
        let k = str_trim(url_decode(kv[0]));
        if k == "" {
            // skip empty keys
        } else {
            let v = str_trim(url_decode(try kv[1] catch ""));
            out[k] = v;
        }
    }
    return out;
}

fn _split_path(p) {
    // "/a/b/" -> ["a","b"]
    let parts = str_split(p, "/");
    let out = [];
    for i len(parts) {
        let s = parts[i];
        if s != "" { out[len(out)] = s; }
    }
    return out;
}

fn _param_name(seg) {
    // ":id" -> "id"
    let sp = str_split(seg, ":");
    return try sp[1] catch seg;
}

fn _match_path(pattern, path) {
    // returns params map, or nil if no match
    let p = _split_path(pattern);
    let s = _split_path(path);
    if len(p) != len(s) { return nil; }

    let params = map{};
    for i len(p) {
        let ps = p[i];
        let ss = s[i];
        if str_starts_with(ps, ":") {
            params[_param_name(ps)] = ss;
        } else {
            if ps != ss { return nil; }
        }
    }
    return params;
}

fn app_new() {
    // middleware: functions fn(req) { return res_map_or_nil; }
    return map{ routes: [], middleware: [] };
}

fn app_use(app, mw) {
    // mw signature (απλοποιημένο): fn(req) { return res_map_or_nil; }
    // - return map{ status: ..., body: ..., content_type: ... } για block
    // - return nil για "συνέχισε στο επόμενο"
    app.middleware[len(app.middleware)] = mw;
    return app;
}

fn app_get(app, path, handler) {
    app.routes[len(app.routes)] = map{ method: "GET", path: path, handler: handler, middleware: [] };
    return app;
}

fn app_post(app, path, handler) {
    app.routes[len(app.routes)] = map{ method: "POST", path: path, handler: handler, middleware: [] };
    return app;
}

fn app_get_mw(app, path, mws, handler) {
    app.routes[len(app.routes)] = map{ method: "GET", path: path, handler: handler, middleware: mws };
    return app;
}

fn app_post_mw(app, path, mws, handler) {
    app.routes[len(app.routes)] = map{ method: "POST", path: path, handler: handler, middleware: mws };
    return app;
}

fn app_handle(app, req) {
    let method = req.method;

    // enrich request: raw_path, path, query, params (params filled on match)
    let raw_path = req.path;
    let path = _path_only(raw_path);
    let qs = _query_string(raw_path);
    req.raw_path = raw_path;
    req.path = path;
    req.query = _parse_query(qs);

    // Global middleware (can short‑circuit)
    for i len(app.middleware) {
        let mw = app.middleware[i];
        let mw_res = mw(req);
        if mw_res != nil {
            return mw_res;
        }
    }

    // Route matching + optional route-level middleware
    for i len(app.routes) {
        let r = app.routes[i];
        if r.method == method {
            let params = _match_path(r.path, path);
            if params != nil {
                req.params = params;

                // Route-level middleware (ίδιο συμβόλαιο με global)
                let rmw = try r.middleware catch [];
                for j len(rmw) {
                    let mw = rmw[j];
                    let mw_res = mw(req);
                    if mw_res != nil {
                        return mw_res;
                    }
                }

                let handler = r.handler;
                return handler(req);
            }
        }
    }
    return map{ status: 404, body: "not found", content_type: "text/plain" };
}

// ---------------- Convenience helpers ----------------

fn res_json(status, value) { return map{ status: status, json: value }; }
fn res_text(status, body) { return map{ status: status, body: body, content_type: "text/plain" }; }

let res = map{
    json: fn(status, value) { return res_json(status, value); },
    text: fn(status, body) { return res_text(status, body); },
    ok_json: fn(value) { return res_json(200, value); },
    ok_text: fn(body) { return res_text(200, body); },
    redirect: fn(url) { return map{ status: 302, body: "", headers: map{ "Location": url } }; }
};

fn mw_log() {
    // Logging-only middleware: ποτέ δεν μπλοκάρει, πάντα συνεχίζει.
    return fn(req) {
        print req.method + " " + req.path;
        return nil;
    };
}

fn mw_require_header(name, expected) {
    // Middleware που μπορεί να μπλοκάρει το request.
    return fn(req) {
        let v = try req.headers[name] catch nil;
        if v == nil { return res_text(401, "unauthorized"); }
        if v != expected { return res_text(403, "forbidden"); }
        return nil;
    };
}

// _content_length(req) — the request's Content-Length (0 if absent / unparseable).
fn _content_length(req) {
    let h = try req.headers["Content-Length"] catch nil;
    if h == nil { h = try req.headers["content-length"] catch nil; }
    if h == nil { return 0; }
    let n = try parse_number(str_trim(str(h))) catch nil;
    if n == nil { return 0; }
    return n;
}

// _recv_request(s) — read a full HTTP request: the header block (via tcp_read_until),
// then the body bytes indicated by Content-Length. tcp_read_until drains only up to
// the "\r\n\r\n" terminator and leaves any already-buffered body in the stream, and
// tcp_read serves that buffer before reading more — so POST/PUT bodies arrive intact
// (the header-only read previously dropped request bodies).
fn _recv_request(s) {
    let raw = tcp_read_until(s, "\r\n\r\n", 65536);
    let req = http_parse_request(raw);
    let have = len(try req.body catch "");
    let total = _content_length(req);
    if total > have {
        let extra = tcp_read(s, total - have);
        req.body = (try req.body catch "") + extra;
    }
    return req;
}

fn serve_once_app(addr, app) {
    return serve_once(addr, fn(req) { return app_handle(app, req); });
}

fn serve_forever_app(addr, app) {
    return serve_forever(addr, fn(req) { return app_handle(app, req); });
}

fn serve_once(addr, handler) {
    let l = tcp_listen(addr);
    let actual = tcp_local_addr(l);
    let s = tcp_accept(l);

    // read headers (and potentially some body). Keep it simple for now.
    let req = _recv_request(s);

    let out = handler(req);
    let resp = _resp_from_handler(out);
    tcp_write(s, resp);

    tcp_close(s);
    tcp_close(l);
    return actual;
}

fn serve_forever(addr, handler) {
    let l = tcp_listen(addr);
    let actual = tcp_local_addr(l);
    print actual;
    while true {
        let s = tcp_accept(l);
        let req = _recv_request(s);
        let out = handler(req);
        let resp = _resp_from_handler(out);
        tcp_write(s, resp);
        tcp_close(s);
    }
}

// ---- Added: cookies, cookie_get, static_file_response, mw_rate_limit, serve_once_timeout ----

fn cookies(req) {
    let cookie_header = try req.headers.Cookie catch "";
    if cookie_header == "" { return map{}; }
    let pairs = str_split(cookie_header, ";");
    let result = map{};
    for i len(pairs) {
        let pair = str_trim(pairs[i]);
        let eq_pos = str_index_of(pair, "=");
        if eq_pos >= 0 {
            let k = str_trim(str_slice(pair, 0, eq_pos));
            let v = str_trim(str_slice(pair, eq_pos + 1, len(pair)));
            result[k] = v;
        }
    }
    return result;
}

fn cookie_get(req, name, default_val) {
    let cs = cookies(req);
    let v = try cs[name] catch nil;
    if v == nil { return default_val; }
    return v;
}

fn _mime_type(filename) {
    if str_ends_with(filename, ".html") { return "text/html; charset=utf-8"; }
    if str_ends_with(filename, ".htm")  { return "text/html; charset=utf-8"; }
    if str_ends_with(filename, ".css")  { return "text/css; charset=utf-8"; }
    if str_ends_with(filename, ".js")   { return "application/javascript; charset=utf-8"; }
    if str_ends_with(filename, ".mjs")  { return "application/javascript; charset=utf-8"; }
    if str_ends_with(filename, ".ts")   { return "application/typescript; charset=utf-8"; }
    if str_ends_with(filename, ".json") { return "application/json; charset=utf-8"; }
    if str_ends_with(filename, ".xml")  { return "application/xml; charset=utf-8"; }
    if str_ends_with(filename, ".svg")  { return "image/svg+xml"; }
    if str_ends_with(filename, ".png")  { return "image/png"; }
    if str_ends_with(filename, ".jpg")  { return "image/jpeg"; }
    if str_ends_with(filename, ".jpeg") { return "image/jpeg"; }
    if str_ends_with(filename, ".gif")  { return "image/gif"; }
    if str_ends_with(filename, ".webp") { return "image/webp"; }
    if str_ends_with(filename, ".ico")  { return "image/x-icon"; }
    if str_ends_with(filename, ".wasm") { return "application/wasm"; }
    if str_ends_with(filename, ".pdf")  { return "application/pdf"; }
    if str_ends_with(filename, ".zip")  { return "application/zip"; }
    if str_ends_with(filename, ".gz")   { return "application/gzip"; }
    if str_ends_with(filename, ".tar")  { return "application/x-tar"; }
    if str_ends_with(filename, ".mp4")  { return "video/mp4"; }
    if str_ends_with(filename, ".webm") { return "video/webm"; }
    if str_ends_with(filename, ".mp3")  { return "audio/mpeg"; }
    if str_ends_with(filename, ".ogg")  { return "audio/ogg"; }
    if str_ends_with(filename, ".wav")  { return "audio/wav"; }
    if str_ends_with(filename, ".ttf")  { return "font/ttf"; }
    if str_ends_with(filename, ".woff") { return "font/woff"; }
    if str_ends_with(filename, ".woff2"){ return "font/woff2"; }
    if str_ends_with(filename, ".txt")  { return "text/plain; charset=utf-8"; }
    if str_ends_with(filename, ".md")   { return "text/markdown; charset=utf-8"; }
    if str_ends_with(filename, ".csv")  { return "text/csv; charset=utf-8"; }
    return "application/octet-stream";
}

fn static_file_response(root, req_path) {
    // SECURITY: _path_safe() strips leading slash, URL-decodes, and rejects any
    // ".." segments to prevent path traversal attacks (e.g. /../../../etc/passwd).
    let full_path = _path_safe(root, req_path);
    if full_path == nil {
        return map{ status: 403, body: "Forbidden", content_type: "text/plain" };
    }
    let exists = try fs_exists(full_path) catch false;
    if exists == false {
        return map{ status: 404, body: "Not Found", content_type: "text/plain" };
    }
    let content = try fs_read(full_path) catch nil;
    if content == nil {
        return map{ status: 404, body: "Not Found", content_type: "text/plain" };
    }
    return map{ status: 200, body: content, content_type: _mime_type(full_path) };
}

fn mw_rate_limit(max_req, window_ms) {
    let count = 0;
    let start_time = clock();
    return fn(req) {
        let now = clock();
        if (now - start_time) * 1000.0 > window_ms {
            count = 0;
            start_time = now;
        }
        count = count + 1;
        if count > max_req {
            return map{ status: 429, body: "Too Many Requests", content_type: "text/plain" };
        }
        return nil;
    };
}

fn serve_once_timeout(addr, handler, timeout_ms) {
    if timeout_ms != nil and timeout_ms > 0 {
        throw "serve_once_timeout: per-call TCP timeout is not exposed in pblang yet; set the VM io_timeout_ms host limit or pass 0";
    }
    let l = tcp_listen(addr);
    let actual = tcp_local_addr(l);
    let s = tcp_accept(l);
    // Apply per-connection read timeout so slow clients cannot stall the server
    let req = _recv_request(s);
    let out = handler(req);
    let resp = _resp_from_handler(out);
    tcp_write(s, resp);
    tcp_close(s);
    tcp_close(l);
    return actual;
}

fn serve_forever_timeout(addr, handler, timeout_ms) {
    if timeout_ms != nil and timeout_ms > 0 {
        throw "serve_forever_timeout: per-call TCP timeout is not exposed in pblang yet; set the VM io_timeout_ms host limit or pass 0";
    }
    let l = tcp_listen(addr);
    let actual = tcp_local_addr(l);
    print actual;
    while true {
        let s = tcp_accept(l);
        let req = _recv_request(s);
        let out = handler(req);
        let resp = _resp_from_handler(out);
        tcp_write(s, resp);
        tcp_close(s);
    }
}

// Server-Sent Events helpers
// sse_event(event_name, data) → SSE formatted string
fn sse_event(event_name, data) {
    return "event: " + event_name + "\ndata: " + data + "\n\n";
}

// res_sse_headers() → response map with SSE content-type and headers
fn res_sse_headers() {
    return map{
        content_type: "text/event-stream",
        headers: map{
            "Cache-Control": "no-cache",
            "Connection": "keep-alive",
            "Access-Control-Allow-Origin": "*"
        }
    };
}

export app_new, app_use, app_get, app_post, app_get_mw, app_post_mw, app_handle, res, res_json, res_text, to_http_response, mw_log, mw_require_header, serve_once, serve_forever, serve_once_app, serve_forever_app, cookies, cookie_get, static_file_response, mw_rate_limit, serve_once_timeout, serve_forever_timeout, sse_event, res_sse_headers, url_decode, _path_safe;
