// Minimal HTTP server stdlib (interop-first, single-threaded).
//
// Usage:
//   import "stdlib:http_server.sapp";
//   fn handler(req) { return "hello"; }
//   let addr = http_server.serve_once("127.0.0.1:0", handler);  // returns actual bound addr
//
// Handler can return:
// - string body (status=200)
// - map{ status: 200, body: "ok" }
// - map{ status: 200, json: value, headers: map{ "Cache-Control": "no-store" } }


// --- Security & Utility Helpers ---

let SecureFile = import("stdlib:secure_file.sapp");
let NativeTcp = import("stdlib:native_tcp.sapp");
let MAX_STATIC_FILE_BYTES = 16777216;

// url_decode(s) — percent-decode a URL-encoded string (e.g. %20 -> space, %3D -> =)
fn url_decode(s) {
    let out = "";
    let i = 0;
    let n = len(s);
    while i < n {
        let ch = str_slice(s, i, i + 1);
        if ch == "%" and (i + 2) < n {
            let hex = str_slice(s, i + 1, i + 3);
            let code = try parse_number("0x" + hex) catch nil;
            if code != nil {
                out = out + str_from_char_code(code);
                i = i + 3;
            } else {
                out = out + ch;
                i = i + 1;
            }
        } else if ch == "+" {
            out = out + " ";
            i = i + 1;
        } else {
            out = out + ch;
            i = i + 1;
        }
    }
    return out;
}

// _path_safe(root, req_path) — sanitize req_path so it cannot escape root.
// Returns the resolved path string, or nil if the path would escape root.
fn _relative_path_safe(req_path) {
    if type(req_path) != "string" or len(req_path) > 4096
        or str_contains(req_path, strfromcharcode(0)) or str_contains(req_path, "\r")
        or str_contains(req_path, "\n") or str_contains(req_path, "\\") {
        return nil;
    }
    // Strip leading slash
    let clean = req_path;
    if str_starts_with(clean, "/") {
        clean = str_slice(clean, 1, len(clean));
    }
    // URL-decode so that %2F, %2e%2e etc. are decoded before the traversal check
    clean = url_decode(clean);
    if str_contains(clean, strfromcharcode(0)) or str_contains(clean, "\\")
        or str_contains(clean, ":") { return nil; }
    // Reject any path segment that is ".."
    let segs = str_split(clean, "/");
    let safe_segs = [];
    for i len(segs) {
        let seg = segs[i];
        // Drop empty segments, current-dir ".", and parent ".."
        if seg == "" or seg == "." { } // skip
        else if seg == ".." { return nil; }  // traversal attempt
        else { safe_segs[len(safe_segs)] = seg; }
    }
    return str_join(safe_segs, "/");
}

fn _path_safe(root, req_path) {
    if type(root) != "string" or root == "" or len(root) > 4096
        or str_contains(root, strfromcharcode(0)) or str_contains(root, "\r")
        or str_contains(root, "\n") { return nil; }
    let relative = _relative_path_safe(req_path);
    if relative == nil { return nil; }
    // Rebuild path
    let result = root;
    if relative != "" { result = result + "/" + relative; }
    return result;
}

fn _status_text(code) {
    if code == 200 { return "OK"; }
    if code == 201 { return "Created"; }
    if code == 202 { return "Accepted"; }
    if code == 203 { return "Non-Authoritative Information"; }
    if code == 204 { return "No Content"; }
    if code == 206 { return "Partial Content"; }
    if code == 300 { return "Multiple Choices"; }
    if code == 301 { return "Moved Permanently"; }
    if code == 302 { return "Found"; }
    if code == 304 { return "Not Modified"; }
    if code == 400 { return "Bad Request"; }
    if code == 401 { return "Unauthorized"; }
    if code == 403 { return "Forbidden"; }
    if code == 404 { return "Not Found"; }
    if code == 405 { return "Method Not Allowed"; }
    if code == 408 { return "Request Timeout"; }
    if code == 410 { return "Gone"; }
    if code == 413 { return "Request Entity Too Large"; }
    if code == 415 { return "Unsupported Media Type"; }
    if code == 406 { return "Not Acceptable"; }
    if code == 429 { return "Too Many Requests"; }
    if code == 431 { return "Request Header Fields Too Large"; }
    if code == 500 { return "Internal Server Error"; }
    if code == 501 { return "Not Implemented"; }
    if code == 502 { return "Bad Gateway"; }
    if code == 503 { return "Service Unavailable"; }
    if code == 504 { return "Gateway Timeout"; }
    return "OK";
}

fn _header_name_safe(name) {
    let s = str(name);
    if s == "" { return false; }
    if str_contains(s, "\r") or str_contains(s, "\n") or str_contains(s, ":") { return false; }
    let allowed = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-";
    let i = 0;
    while i < len(s) {
        let ch = str_slice(s, i, i + 1);
        if not str_contains(allowed, ch) { return false; }
        i = i + 1;
    }
    return true;
}

fn _header_value_safe(value) {
    let s = str(value);
    return not str_contains(s, "\r") and not str_contains(s, "\n");
}

fn _safe_content_type(ct) {
    if ct == nil { return nil; }
    if _header_value_safe(ct) { return ct; }
    return "text/plain";
}

fn _build_response(status, ct, body, extra_headers) {
    let resp = "HTTP/1.1 " + str(status) + " " + _status_text(status) + "\r\n";
    // HTTP Content-Length counts bytes, not Unicode code points.
    resp = resp + "Content-Length: " + str(len(str_to_bytes(body))) + "\r\n";
    let safe_ct = _safe_content_type(ct);
    if safe_ct != nil {
        resp = resp + "Content-Type: " + safe_ct + "\r\n";
    }
    if extra_headers != nil {
        let ks = map_keys(extra_headers);
        for i len(ks) {
            if _header_name_safe(ks[i]) and _header_value_safe(extra_headers[ks[i]]) {
                resp = resp + ks[i] + ": " + str(extra_headers[ks[i]]) + "\r\n";
            }
        }
    }
    resp = resp + "\r\n" + body;
    return resp;
}

fn _resp_from_handler(out) {
    if type(out) == "map" {
        let status = try out.status catch 200;
        let jv = try out.json catch nil;
        if jv != nil {
            let json_headers = try out.headers catch nil;
            if json_headers != nil {
                return _build_response(status, "application/json", json_stringify(jv), json_headers);
            }
            return http_response_json(status, jv);
        }

        let body = try out.body catch "";
        let ct = try out.content_type catch "text/plain";
        let extra_headers = try out.headers catch nil;

        if extra_headers != nil {
            return _build_response(status, ct, body, extra_headers);
        }

        if ct == "text/plain" or ct == nil {
            return http_response(status, body);
        }
        return http_response_ct(status, ct, body);
    }
    return http_response(200, out);
}

fn to_http_response(out) {
    return _resp_from_handler(out);
}

fn _path_only(p) {
    // strip query string
    let parts = str_split(p, "?");
    return parts[0];
}

fn _query_string(p) {
    let parts = str_split(p, "?");
    return try parts[1] catch "";
}

fn _parse_query(qs) {
    // qs: "a=1&b=2%20hi" -> map{ a: "1", b: "2 hi" }
    // URL-decodes both keys and values. Splits each pair on the FIRST "=" only, so
    // a value that itself contains "=" (e.g. base64 / "token=a=b=c") is preserved.
    let out = map{};
    if qs == "" { return out; }
    let pairs = str_split(qs, "&");
    let i = 0;
    while i < len(pairs) {
        let pair = pairs[i];
        let eq = str_index_of(pair, "=");
        let k = "";
        let v = "";
        if eq >= 0 {
            k = str_trim(url_decode(str_slice(pair, 0, eq)));
            v = str_trim(url_decode(str_slice(pair, eq + 1, len(pair))));
        } else {
            k = str_trim(url_decode(pair));
        }
        if k != "" { out[k] = v; }
        i = i + 1;
    }
    return out;
}

fn _split_path(p) {
    // "/a/b/" -> ["a","b"]
    let parts = str_split(p, "/");
    let out = [];
    for i len(parts) {
        let s = parts[i];
        if s != "" { out[len(out)] = s; }
    }
    return out;
}

fn _param_name(seg) {
    // ":id" -> "id"
    let sp = str_split(seg, ":");
    return try sp[1] catch seg;
}

fn _match_path(pattern, path) {
    // returns params map, or nil if no match. `:name` captures one segment;
    // `*name` (catch-all, must be last) captures the rest of the path (joined by
    // "/", possibly empty).
    let p = _split_path(pattern);
    let s = _split_path(path);

    let params = map{};
    let i = 0;
    while i < len(p) {
        let ps = p[i];
        if str_starts_with(ps, "*") {
            let name = str_slice(ps, 1, len(ps));
            if name == "" { name = "wildcard"; }
            let rest = [];
            let j = i;
            while j < len(s) { array_push(rest, s[j]); j = j + 1; }
            params[name] = str_join(rest, "/");
            return params;
        }
        if i >= len(s) { return nil; }
        let ss = s[i];
        if str_starts_with(ps, ":") {
            params[_param_name(ps)] = ss;
        } else {
            if ps != ss { return nil; }
        }
        i = i + 1;
    }
    if len(s) != len(p) { return nil; }
    return params;
}

fn app_new() {
    // middleware: functions fn(req) { return res_map_or_nil; }
    return map{ routes: [], middleware: [] };
}

fn app_use(app, mw) {
    // mw signature (απλοποιημένο): fn(req) { return res_map_or_nil; }
    // - return map{ status: ..., body: ..., content_type: ... } για block
    // - return nil για "συνέχισε στο επόμενο"
    app.middleware[len(app.middleware)] = mw;
    return app;
}

// Generic route registration — any HTTP method, with optional route-level mws.
fn app_route(app, method, path, handler) {
    app.routes[len(app.routes)] = map{ method: method, path: path, handler: handler, middleware: [] };
    return app;
}

fn app_route_mw(app, method, path, mws, handler) {
    app.routes[len(app.routes)] = map{ method: method, path: path, handler: handler, middleware: mws };
    return app;
}

fn app_get(app, path, handler) { return app_route(app, "GET", path, handler); }
fn app_post(app, path, handler) { return app_route(app, "POST", path, handler); }
fn app_put(app, path, handler) { return app_route(app, "PUT", path, handler); }
fn app_delete(app, path, handler) { return app_route(app, "DELETE", path, handler); }
fn app_patch(app, path, handler) { return app_route(app, "PATCH", path, handler); }

fn app_get_mw(app, path, mws, handler) {
    app.routes[len(app.routes)] = map{ method: "GET", path: path, handler: handler, middleware: mws };
    return app;
}

fn app_post_mw(app, path, mws, handler) {
    app.routes[len(app.routes)] = map{ method: "POST", path: path, handler: handler, middleware: mws };
    return app;
}

fn app_handle(app, req) {
    let method = req.method;

    // enrich request: raw_path, path, query, params (params filled on match)
    let raw_path = req.path;
    let path = _path_only(raw_path);
    let qs = _query_string(raw_path);
    req.raw_path = raw_path;
    req.path = path;
    req.query = _parse_query(qs);

    // Global middleware (can short‑circuit)
    for i len(app.middleware) {
        let mw = app.middleware[i];
        let mw_res = mw(req);
        if mw_res != nil {
            return mw_res;
        }
    }

    // Route matching + optional route-level middleware. Track whether the PATH
    // matched any route so we can answer 405 (not 404) for a wrong method, and
    // let a HEAD request fall back to a GET route (HTTP semantics).
    let path_matched = false;
    let allow = [];
    for i len(app.routes) {
        let r = app.routes[i];
        let params = _match_path(r.path, path);
        if params != nil {
            path_matched = true;
            let am = 0;
            let already = false;
            while am < len(allow) { if allow[am] == r.method { already = true; } am = am + 1; }
            if not already { allow[len(allow)] = r.method; }

            let method_ok = r.method == method or (method == "HEAD" and r.method == "GET");
            if method_ok {
                req.params = params;

                // Route-level middleware (ίδιο συμβόλαιο με global)
                let rmw = try r.middleware catch [];
                for j len(rmw) {
                    let mw = rmw[j];
                    let mw_res = mw(req);
                    if mw_res != nil {
                        return mw_res;
                    }
                }

                let handler = r.handler;
                return handler(req);
            }
        }
    }
    if path_matched {
        return map{ status: 405, body: "method not allowed", content_type: "text/plain", headers: map{ "Allow": str_join(allow, ", ") } };
    }
    return map{ status: 404, body: "not found", content_type: "text/plain" };
}

// ---------------- Convenience helpers ----------------

fn res_json(status, value) { return map{ status: status, json: value }; }
fn res_text(status, body) { return map{ status: status, body: body, content_type: "text/plain" }; }
fn res_html(status, body) { return map{ status: status, body: body, content_type: "text/html; charset=utf-8" }; }

// res_redirect(location, status?) — a redirect response. Default 302 (Found);
// pass 301/307/308 for permanent/method-preserving redirects.
fn res_redirect(location, status = 302) {
    return map{ status: status, body: "", headers: map{ "Location": str(location) } };
}

let res = map{
    json: fn(status, value) { return res_json(status, value); },
    text: fn(status, body) { return res_text(status, body); },
    html: fn(status, body) { return res_html(status, body); },
    ok_json: fn(value) { return res_json(200, value); },
    ok_text: fn(body) { return res_text(200, body); },
    ok_html: fn(body) { return res_html(200, body); },
    redirect: fn(url) { return res_redirect(url, 302); },
    redirect_status: fn(url, status) { return res_redirect(url, status); }
};

fn mw_log() {
    // Logging-only middleware: ποτέ δεν μπλοκάρει, πάντα συνεχίζει.
    return fn(req) {
        print req.method + " " + req.path;
        return nil;
    };
}

fn mw_require_header(name, expected) {
    // Middleware που μπορεί να μπλοκάρει το request. Header lookup is
    // case-insensitive (a client may send the name lowercased) — a direct
    // req.headers[name] read used to 401 legitimately-cased requests.
    return fn(req) {
        let v = req_header(req, name);
        if v == nil { return res_text(401, "unauthorized"); }
        if v != expected { return res_text(403, "forbidden"); }
        return nil;
    };
}

// Server limits (configurable). max_body caps how many request-body bytes the
// server will read, so an attacker-controlled Content-Length cannot force an
// unbounded read (memory-exhaustion DoS).
let _CFG = map{ max_body: 10485760 };   // 10 MiB default
fn set_max_body(n) { _CFG.max_body = n; return _CFG.max_body; }
fn get_max_body() { return _CFG.max_body; }

// _content_length(req) — the request's Content-Length (0 if absent / unparseable).
fn _content_length(req) {
    let h = req_header(req, "Content-Length");
    if h == nil { return 0; }
    let n = try parse_number(str_trim(str(h))) catch nil;
    if n == nil { return 0; }
    return n;
}

// body_read_plan(content_length, have) → { read, too_large }: how many MORE body
// bytes to read given `have` already buffered, BOUNDED by max_body. If the
// declared length exceeds the cap, `read` is clamped to the cap and `too_large`
// is set so the server can answer 413 instead of reading gigabytes.
fn body_read_plan(content_length, have) {
    let max = _CFG.max_body;
    let too_large = content_length > max;
    let target = content_length;
    if target > max { target = max; }
    let read = target - have;
    if read < 0 { read = 0; }
    return map{ read: read, too_large: too_large };
}

fn _bounded_integer(value, minimum, maximum, label) {
    if type(value) != "number" or num_floor(value) != value
        or value < minimum or value > maximum {
        throw "http bounded server: " + label + " must be an integer in "
            + str(minimum) + ".." + str(maximum);
    }
    return value;
}

// Normalize the secure native-server policy before binding. The entire request
// must fit NativeTcp's bounded text contract; unsupported platforms fail here.
fn bounded_server_policy(options = nil) {
    let support = NativeTcp.available();
    if not support.ok {
        throw "http bounded server unavailable: " + str(try support.error catch "unsupported platform");
    }
    let input = map{};
    if options == nil { }
    elif type(options) == "map" { input = options; }
    else { input = map{ request_timeout_ms: options }; }
    let allowed = ["request_timeout_ms", "write_timeout_ms", "accept_poll_ms",
        "max_inflight", "max_header_bytes", "max_body_bytes",
        "max_response_bytes", "max_connections", "preflight", "executor"];
    for key in map_keys(input) {
        let known = false;
        for name in allowed { if key == name { known = true; } }
        if not known { throw "http bounded server: unknown option " + str(key); }
    }
    let request_timeout = _bounded_integer(
        try input.request_timeout_ms catch 2000, 10, 60000, "request_timeout_ms");
    let write_timeout = _bounded_integer(
        try input.write_timeout_ms catch 1000, 10, 60000, "write_timeout_ms");
    let accept_poll = _bounded_integer(
        try input.accept_poll_ms catch 5, 1, 1000, "accept_poll_ms");
    let max_inflight = _bounded_integer(
        try input.max_inflight catch 16, 1, 64, "max_inflight");
    let max_header = _bounded_integer(
        try input.max_header_bytes catch 65536, 1024, 65536, "max_header_bytes");
    let body_default = _CFG.max_body;
    if body_default > NativeTcp.MAX_TEXT_BYTES - max_header {
        body_default = NativeTcp.MAX_TEXT_BYTES - max_header;
    }
    let max_body = _bounded_integer(
        try input.max_body_bytes catch body_default, 0,
        NativeTcp.MAX_TEXT_BYTES - max_header, "max_body_bytes");
    let max_response = _bounded_integer(
        try input.max_response_bytes catch NativeTcp.MAX_TEXT_BYTES,
        1024, NativeTcp.MAX_TEXT_BYTES, "max_response_bytes");
    let max_connections = try input.max_connections catch nil;
    _validate_connection_limit(max_connections, "bounded server");
    let preflight = try input.preflight catch nil;
    if preflight != nil and not is_fn(preflight) {
        throw "http bounded server: preflight must be callable";
    }
    let executor = try input.executor catch nil;
    if executor != nil {
        if type(executor) != "map" or not is_fn(try executor.start catch nil)
           or not is_fn(try executor.poll catch nil)
           or not is_fn(try executor.cancel catch nil)
           or not is_fn(try executor.finish catch nil) {
            throw "http bounded server: executor must provide start, poll, cancel and finish";
        }
    }
    return map{
        request_timeout_ms: request_timeout, write_timeout_ms: write_timeout,
        accept_poll_ms: accept_poll, max_inflight: max_inflight,
        max_header_bytes: max_header, max_body_bytes: max_body,
        max_response_bytes: max_response, max_connections: max_connections,
        preflight: preflight, executor: executor,
        absolute_request_deadline: true, bounded_inflight: true,
        cancellable_handler_execution: executor != nil,
        chunked_requests: "fail-closed-not-implemented",
    };
}

fn _find_bytes(haystack, needle) {
    if len(needle) == 0 { return 0; }
    let i = 0;
    while i + len(needle) <= len(haystack) {
        let j = 0; let matched = true;
        while j < len(needle) and matched {
            if haystack[i + j] != needle[j] { matched = false; }
            j = j + 1;
        }
        if matched { return i; }
        i = i + 1;
    }
    return -1;
}

fn _append_bytes(target, source) {
    let i = 0;
    while i < len(source) { array_push(target, source[i]); i = i + 1; }
}

fn _strict_content_length(req) {
    let raw = req_header(req, "Content-Length");
    if raw == nil { return map{ ok: true, value: 0 }; }
    let text = str_trim(str(raw));
    if text == "" or len(text) > 12 { return map{ ok: false }; }
    let i = 0;
    while i < len(text) {
        let ch = str_slice(text, i, i + 1);
        if not str_contains("0123456789", ch) { return map{ ok: false }; }
        i = i + 1;
    }
    let value = try parse_number(text) catch nil;
    if value == nil or num_floor(value) != value or value < 0 {
        return map{ ok: false };
    }
    return map{ ok: true, value: value };
}

fn _header_text_safe(value) {
    let i = 0;
    while i < len(value) {
        let code = strcharcodeat(value, i);
        if code < 32 or code == 127 { return false; }
        i = i + 1;
    }
    return true;
}

// Parse security-sensitive bounded requests without relying on the permissive
// compatibility parser. Duplicate names are rejected case-insensitively.
fn _strict_header_request(header_text) {
    if type(header_text) != "string" or len(header_text) < 8
        or not str_ends_with(header_text, "\r\n\r\n") {
        return map{ ok: false, error: "incomplete header block" };
    }
    let wire = str_slice(header_text, 0, len(header_text) - 4);
    let lines = str_split(wire, "\r\n");
    if len(lines) < 1 or len(lines) > 129 {
        return map{ ok: false, error: "invalid header count" };
    }
    let request_parts = str_split(lines[0], " ");
    if len(request_parts) != 3 {
        return map{ ok: false, error: "malformed request line" };
    }
    let method = request_parts[0]; let path = request_parts[1];
    let version = request_parts[2];
    if method == "" or len(method) > 32 or str_upper(method) != method
        or not _header_name_safe(method) {
        return map{ ok: false, error: "invalid request method" };
    }
    if path == "" or len(path) > 4096 or not _header_text_safe(path)
        or (not str_starts_with(path, "/") and path != "*") {
        return map{ ok: false, error: "invalid request target" };
    }
    if version != "HTTP/1.0" and version != "HTTP/1.1" {
        return map{ ok: false, error: "unsupported HTTP version" };
    }
    let headers = map{}; let i = 1;
    while i < len(lines) {
        let line = lines[i];
        if line == "" or str_starts_with(line, " ") or str_starts_with(line, "\t") {
            return map{ ok: false, error: "invalid folded or empty header" };
        }
        let colon = str_index_of(line, ":");
        if colon < 1 {
            return map{ ok: false, error: "malformed header" };
        }
        let name = str_lower(str_slice(line, 0, colon));
        let value = str_trim(str_slice(line, colon + 1, len(line)));
        if not _header_name_safe(name) or not _header_text_safe(value)
            or map_has(headers, name) {
            return map{ ok: false, error: "invalid or duplicate header" };
        }
        headers[name] = value; i = i + 1;
    }
    return map{ ok: true, request: map{
        method: method, path: path, version: version, headers: headers, body: ""
    } };
}

fn _bounded_output(state, output, fallback_status, policy) {
    let status = fallback_status;
    if type(output) == "map" {
        let supplied = try output.status catch fallback_status;
        if type(supplied) == "number" and num_floor(supplied) == supplied
            and supplied >= 100 and supplied <= 599 { status = supplied; }
    }
    let response = try _resp_from_handler(output) catch _resp_from_handler(map{
        status: 500, body: "Internal Server Error", content_type: "text/plain"
    });
    if len(str_to_bytes(response)) > policy.max_response_bytes {
        status = 500;
        response = _resp_from_handler(map{
            status: 500, body: "Response exceeded configured bound",
            content_type: "text/plain", headers: map{
                "Connection": "close", "Cache-Control": "no-store"
            }
        });
    }
    let written = try NativeTcp.write_text(state.socket, response,
        policy.write_timeout_ms) catch map{ ok: false };
    NativeTcp.close(state.socket); state.done = true;
    state.response_sent = true;
    state.status = if written.ok { status } else { 500 };
}

// Send the client-visible timeout/error while retaining the connection state
// until the external executor proves that its worker has terminated and its
// private resources have been reaped.
fn _bounded_output_pending_cleanup(state, output, fallback_status, policy) {
    let status = fallback_status;
    if type(output) == "map" {
        let supplied = try output.status catch fallback_status;
        if type(supplied) == "number" and num_floor(supplied) == supplied
            and supplied >= 100 and supplied <= 599 { status = supplied; }
    }
    let response = try _resp_from_handler(output) catch _resp_from_handler(map{
        status: 500, body: "Internal Server Error", content_type: "text/plain"
    });
    if len(str_to_bytes(response)) > policy.max_response_bytes {
        status = 500;
        response = _resp_from_handler(map{ status: 500,
            body: "Response exceeded configured bound", content_type: "text/plain",
            headers: map{ "Connection": "close", "Cache-Control": "no-store" } });
    }
    let written = try NativeTcp.write_text(state.socket, response,
        policy.write_timeout_ms) catch map{ ok: false };
    NativeTcp.close(state.socket); state.response_sent = true;
    state.status = if written.ok { status } else { 500 };
}

fn _bounded_reply(state, status, message, policy) {
    _bounded_output(state, map{
        status: status, body: message, content_type: "text/plain",
        headers: map{ "Connection": "close", "Cache-Control": "no-store" }
    }, status, policy);
}

fn _bounded_cancel_executor(state, policy) {
    if try state.cancel_requested catch false { return; }
    state.cancel_requested = true;
    let requested = try policy.executor.cancel(state.executor_job) catch nil;
    if type(requested) != "map" or not (try requested.ok catch false) {
        state.executor_cancel_failed = true;
    }
}

fn _bounded_poll_executor(state, policy) {
    let observed = try policy.executor.poll(state.executor_job) catch nil;
    if type(observed) != "map" or not (try observed.ok catch false) {
        if not (try state.response_sent catch false) {
            _bounded_output_pending_cleanup(state, map{ status: 500,
                body: "Handler executor failed closed", content_type: "text/plain" }, 500, policy);
        }
        _bounded_cancel_executor(state, policy); return;
    }
    let terminal = (try observed.complete catch false) or
        (try observed.terminated catch false);
    if not terminal { return; }
    let finished = try policy.executor.finish(state.executor_job) catch nil;
    state.executor_job = nil;
    if try state.response_sent catch false {
        state.done = true; return;
    }
    if type(finished) != "map" or not (try finished.ok catch false)
       or not map_has(finished, "output") {
        _bounded_reply(state, 500, "Handler executor result failed closed", policy); return;
    }
    _bounded_output(state, finished.output, 200, policy);
}

fn _bounded_complete(state, handler, policy) {
    if try state.executor_job catch nil != nil {
        _bounded_poll_executor(state, policy); return;
    }
    let body_count = len(state.bytes) - state.header_end;
    if body_count < state.content_length { return; }
    if body_count > state.content_length {
        _bounded_reply(state, 400, "Unexpected bytes after request body", policy); return;
    }
    let body_bytes = slice(state.bytes, state.header_end, len(state.bytes));
    let body = try bytes_to_str(body_bytes) catch nil;
    if type(body) != "string" {
        _bounded_reply(state, 400, "Request body must be valid UTF-8", policy); return;
    }
    state.request.body = body;
    if policy.executor != nil {
        // Executor contracts use canonical integer epoch milliseconds. The
        // runtime clock may be fractional, so normalize without extending the
        // caller's deadline.
        let executor_deadline_ms = num_floor(state.accepted_ms + policy.request_timeout_ms);
        let launched = try policy.executor.start(state.request,
            executor_deadline_ms) catch nil;
        if type(launched) != "map" or not (try launched.ok catch false)
           or not map_has(launched, "job") {
            _bounded_reply(state, 503, "Handler executor unavailable", policy); return;
        }
        state.executor_job = launched.job; state.executing = true;
        state.bytes = [];
        _bounded_poll_executor(state, policy); return;
    }
    let output = try handler(state.request) catch map{
        status: 500, body: "Internal Server Error", content_type: "text/plain"
    };
    _bounded_output(state, output, 200, policy);
}

fn _bounded_parse_header(state, handler, policy) {
    let marker = [13, 10, 13, 10];
    let position = _find_bytes(state.bytes, marker);
    if position < 0 {
        if len(state.bytes) >= policy.max_header_bytes {
            _bounded_reply(state, 431, "Request headers exceeded configured bound", policy);
        }
        return;
    }
    state.header_end = position + 4;
    if state.header_end > policy.max_header_bytes {
        _bounded_reply(state, 431, "Request headers exceeded configured bound", policy); return;
    }
    let header_text = try bytes_to_str(slice(state.bytes, 0, state.header_end)) catch nil;
    if type(header_text) != "string" {
        _bounded_reply(state, 400, "Request headers must be valid UTF-8", policy); return;
    }
    let parsed = _strict_header_request(header_text);
    if not parsed.ok {
        _bounded_reply(state, 400, "Malformed HTTP request", policy); return;
    }
    let request = parsed.request;
    let transfer = req_header(request, "Transfer-Encoding");
    if transfer != nil and str_trim(str(transfer)) != "" {
        _bounded_reply(state, 501, "Chunked requests are not enabled on the bounded server", policy); return;
    }
    let length = _strict_content_length(request);
    if not length.ok {
        _bounded_reply(state, 400, "Invalid Content-Length", policy); return;
    }
    if length.value > policy.max_body_bytes {
        _bounded_reply(state, 413, "Request Entity Too Large", policy); return;
    }
    state.request = request; state.content_length = length.value;
    if policy.preflight != nil {
        let decision = try policy.preflight(request) catch nil;
        if type(decision) != "map" or type(try decision.allowed catch nil) != "bool" {
            _bounded_reply(state, 500, "Request preflight failed closed", policy); return;
        }
        if not decision.allowed {
            let denied = try decision.response catch nil;
            if type(denied) != "map" {
                _bounded_reply(state, 500, "Request preflight failed closed", policy); return;
            }
            _bounded_output(state, denied, 403, policy); return;
        }
    }
    _bounded_complete(state, handler, policy);
}

fn _bounded_step(state, handler, policy) {
    if state.done { return; }
    if try state.executor_job catch nil != nil {
        if now_ms() - state.accepted_ms >= policy.request_timeout_ms {
            if not (try state.response_sent catch false) {
                _bounded_output_pending_cleanup(state, map{ status: 504,
                    body: "Handler deadline exceeded; the operation may have completed",
                    content_type: "text/plain", headers: map{
                        "Connection": "close", "Cache-Control": "no-store",
                        "Retry-After": "0" } }, 504, policy);
            }
            _bounded_cancel_executor(state, policy);
        }
        _bounded_poll_executor(state, policy); return;
    }
    let elapsed = now_ms() - state.accepted_ms;
    if elapsed >= policy.request_timeout_ms {
        NativeTcp.close(state.socket); state.done = true; state.status = 408; return;
    }
    if state.header_end == nil {
        let header = NativeTcp.read_until_bytes(state.socket, [13, 10, 13, 10],
            policy.max_header_bytes, 1);
        if header.ok {
            state.bytes = header.bytes;
            _bounded_parse_header(state, handler, policy);
            return;
        }
        if try header.timeout catch false { return; }
        if len(try state.socket.pending_bytes catch []) >= policy.max_header_bytes {
            _bounded_reply(state, 431, "Request headers exceeded configured bound", policy);
        } else {
            NativeTcp.close(state.socket); state.done = true; state.status = 400;
        }
        return;
    }
    let body_count = len(state.bytes) - state.header_end;
    let maximum = state.content_length - body_count;
    if maximum < 1 { _bounded_complete(state, handler, policy); return; }
    if maximum > 4096 { maximum = 4096; }
    let read = NativeTcp.read_available_bytes(state.socket, maximum, 1, 1);
    if not read.ok {
        NativeTcp.close(state.socket); state.done = true; state.status = 400; return;
    }
    if read.count == 0 and not read.timed_out {
        NativeTcp.close(state.socket); state.done = true; state.status = 400; return;
    }
    if read.count > 0 { _append_bytes(state.bytes, read.bytes); }
    _bounded_complete(state, handler, policy);
}

fn _compact_bounded(states) {
    let active = []; let completed = 0; let i = 0;
    while i < len(states) {
        if states[i].done { completed = completed + 1; }
        else { array_push(active, states[i]); }
        i = i + 1;
    }
    return map{ active: active, completed: completed };
}

// Run the secure connection manager over an already-bound NativeTcp listener.
// The caller owns the listener and may set max_connections for deterministic tests.
fn serve_bounded_listener(listener, handler, options = nil) {
    let policy = bounded_server_policy(options);
    let states = []; let accepted_total = 0; let completed_total = 0;
    while policy.max_connections == nil or completed_total < policy.max_connections {
        let can_accept = policy.max_connections == nil or accepted_total < policy.max_connections;
        if can_accept {
            let accepted = NativeTcp.accept_bounded(listener, policy.accept_poll_ms);
            if accepted.ok {
                accepted_total = accepted_total + 1;
                if len(states) >= policy.max_inflight {
                    let overflow = map{ socket: accepted, done: false };
                    _bounded_reply(overflow, 503, "Server is at connection capacity", policy);
                    completed_total = completed_total + 1;
                } else {
                    array_push(states, map{
                        socket: accepted, accepted_ms: now_ms(), bytes: [],
                        header_end: nil, content_length: nil, request: nil,
                        done: false, response_sent: false, executor_job: nil,
                        cancel_requested: false, status: nil,
                    });
                }
            } else if not (try accepted.timeout catch false) {
                throw "http bounded server accept failed: " + str(try accepted.error catch "unknown error");
            }
        }
        let i = 0;
        while i < len(states) { _bounded_step(states[i], handler, policy); i = i + 1; }
        let compacted = _compact_bounded(states);
        states = compacted.active; completed_total = completed_total + compacted.completed;
        if not can_accept and len(states) == 0 { break; }
    }
    let executor_closed = nil;
    if policy.executor != nil and is_fn(try policy.executor.close catch nil) {
        executor_closed = try policy.executor.close() catch map{ ok: false };
    }
    return map{ accepted: accepted_total, completed: completed_total, policy: policy,
        executor_closed: executor_closed };
}

fn _native_addr(addr) {
    let parts = str_split(str(addr), ":");
    if len(parts) != 2 { throw "http bounded server currently requires an IPv4 host:port"; }
    let port = try parse_number(parts[1]) catch nil;
    if port == nil or num_floor(port) != port or port < 0 or port > 65535 {
        throw "http bounded server received an invalid port";
    }
    return map{ host: parts[0], port: port };
}

// _recv_request(s) — read a full HTTP request: the header block (via tcp_read_until),
// then the body bytes indicated by Content-Length. tcp_read_until drains only up to
// the "\r\n\r\n" terminator and leaves any already-buffered body in the stream, and
// tcp_read serves that buffer before reading more — so POST/PUT bodies arrive intact
// (the header-only read previously dropped request bodies).
fn _recv_request(s) {
    let raw = tcp_read_until(s, "\r\n\r\n", 65536);
    let req = http_parse_request(raw);

    // Chunked bodies carry no Content-Length: read up to the terminator chunk
    // (bounded by max_body) and decode. The header read leaves any buffered
    // chunk bytes in `req.body`, so prepend them before decoding.
    if is_chunked(req) {
        let rest = try tcp_read_until(s, "0\r\n\r\n", _CFG.max_body) catch "";
        req.body = decode_chunked((try req.body catch "") + rest);
        return req;
    }

    let have = len(try req.body catch "");
    let total = _content_length(req);
    // Bound the body read by max_body so a malicious Content-Length can't force an
    // unbounded read; flag oversized requests so the server answers 413.
    let plan = body_read_plan(total, have);
    if plan.read > 0 {
        let extra = tcp_read(s, plan.read);
        req.body = (try req.body catch "") + extra;
    }
    if plan.too_large { req.too_large = true; }
    return req;
}

// Produce the response string for a received request: 413 if the body exceeded
// max_body, otherwise the handler's response. Centralizes the limit check so every
// serve_* entry point enforces it.
fn _serve_response(handler, req) {
    if (try req.too_large catch false) == true {
        return _resp_from_handler(map{ status: 413, body: "Request Entity Too Large", content_type: "text/plain" });
    }
    return _resp_from_handler(handler(req));
}

// Public low-level pair for bounded connection managers. Applications that
// need cancellation-aware keep-alive can own accept/close while reusing the
// same body limits and response normalization as the standard server loops.
fn receive_request(socket) { return _recv_request(socket); }
fn serve_response(handler, request) { return _serve_response(handler, request); }

fn serve_once_app(addr, app) {
    return serve_once(addr, fn(req) { return app_handle(app, req); });
}

fn serve_forever_app(addr, app) {
    return serve_forever(addr, fn(req) { return app_handle(app, req); });
}

fn _validate_connection_limit(max_connections, caller) {
    if max_connections != nil and
       (type(max_connections) != "number" or num_floor(max_connections) != max_connections
        or max_connections < 1 or max_connections > 1000000000) {
        throw caller + ": max_connections must be a positive integer";
    }
}

// Serve an already-bound listener. Binding separately lets applications report
// startup errors before opening their UI. Stateful applications can use a
// channel-backed handler so the I/O worker never owns a copied state graph.
// The caller owns and closes the listener.
fn serve_listener(listener, handler, max_connections = nil) {
    _validate_connection_limit(max_connections, "serve_listener");
    let served = 0;
    while max_connections == nil or served < max_connections {
        let socket = try tcp_accept(listener) catch nil;
        if socket == nil { return served; }
        let req = try _recv_request(socket) catch nil;
        let response = "";
        if req == nil {
            response = _resp_from_handler(map{
                status: 400, body: "Bad Request", content_type: "text/plain"
            });
        } else {
            response = try _serve_response(handler, req)
                catch _resp_from_handler(map{
                    status: 500, body: "Internal Server Error",
                    content_type: "text/plain"
                });
        }
        try tcp_write(socket, response) catch nil;
        try tcp_close(socket) catch nil;
        served = served + 1;
    }
    return served;
}

// Router convenience wrapper for stateless or worker-owned applications.
fn serve_listener_app(listener, app, max_connections = nil) {
    _validate_connection_limit(max_connections, "serve_listener_app");
    return serve_listener(listener,
        fn(value) { return app_handle(app, value); }, max_connections);
}

fn serve_once(addr, handler) {
    let l = tcp_listen(addr);
    let actual = tcp_local_addr(l);
    let s = tcp_accept(l);

    // read headers (and potentially some body). Keep it simple for now.
    let req = _recv_request(s);

    let resp = _serve_response(handler, req);
    tcp_write(s, resp);

    tcp_close(s);
    tcp_close(l);
    return actual;
}

fn serve_forever(addr, handler) {
    let l = tcp_listen(addr);
    let actual = tcp_local_addr(l);
    print actual;
    while true {
        let s = tcp_accept(l);
        let req = _recv_request(s);
        let resp = _serve_response(handler, req);
        tcp_write(s, resp);
        tcp_close(s);
    }
}

// ---- Added: cookies, cookie_get, static_file_response, mw_rate_limit, serve_once_timeout ----

// req_header(req, name) — case-insensitive header lookup. http_parse_request
// preserves the wire casing of header names (e.g. a client may send `cookie:`
// or `Cookie:`), so every header read MUST be case-insensitive or it silently
// misses legally-cased headers.
fn req_header(req, name) {
    let hs = try req.headers catch nil;
    if hs == nil { return nil; }
    let target = str_lower(str(name));
    let ks = map_keys(hs);
    let i = 0;
    while i < len(ks) {
        if str_lower(ks[i]) == target { return hs[ks[i]]; }
        i = i + 1;
    }
    return nil;
}

// content_type(req) — the request's Content-Type header (case-insensitive), "".
fn content_type(req) {
    let ct = req_header(req, "Content-Type");
    if ct == nil { return ""; }
    return str(ct);
}

fn cookies(req) {
    let cookie_header = req_header(req, "Cookie");
    if cookie_header == nil { cookie_header = ""; }
    if cookie_header == "" { return map{}; }
    let pairs = str_split(cookie_header, ";");
    let result = map{};
    for i len(pairs) {
        let pair = str_trim(pairs[i]);
        let eq_pos = str_index_of(pair, "=");
        if eq_pos >= 0 {
            let k = str_trim(str_slice(pair, 0, eq_pos));
            let v = str_trim(str_slice(pair, eq_pos + 1, len(pair)));
            result[k] = v;
        }
    }
    return result;
}

fn cookie_get(req, name, default_val) {
    let cs = cookies(req);
    let v = try cs[name] catch nil;
    if v == nil { return default_val; }
    return v;
}

// body_json(req) — parse the request body as JSON, or nil on empty/invalid (safe:
// json.parse throws on garbage, so it is wrapped).
fn body_json(req) {
    let b = try req.body catch "";
    if b == nil or b == "" { return nil; }
    return try json_parse(b) catch nil;
}

// form_data(req) — parse an application/x-www-form-urlencoded request body into a
// map (percent-decoded, first-"=" split — same rules as the query parser).
fn form_data(req) {
    let b = try req.body catch "";
    if b == nil { return map{}; }
    return _parse_query(b);
}

// ── multipart/form-data (file uploads) ───────────────────────────────────────

// multipart_boundary(content_type) — the boundary token from a
// "multipart/form-data; boundary=..." header, unquoting a quoted value, or nil.
fn multipart_boundary(content_type) {
    let ct = str(content_type);
    let at = str_index_of(str_lower(ct), "boundary=");
    if at < 0 { return nil; }
    let b = str_trim(str_slice(ct, at + 9, len(ct)));
    // a boundary ends at the next ';' parameter if any
    let semi = str_index_of(b, ";");
    if semi >= 0 { b = str_trim(str_slice(b, 0, semi)); }
    if str_starts_with(b, "\"") and str_ends_with(b, "\"") and len(b) >= 2 {
        b = str_slice(b, 1, len(b) - 1);
    }
    if b == "" { return nil; }
    return b;
}

// _cd_param(disposition, key) — the value of a `key="..."` parameter in a
// Content-Disposition header (name, filename), or nil.
fn _cd_param(disposition, key) {
    let needle = key + "=\"";
    let at = str_index_of(disposition, needle);
    if at < 0 { return nil; }
    let start = at + len(needle);
    let end = str_index_of(str_slice(disposition, start, len(disposition)), "\"");
    if end < 0 { return nil; }
    return str_slice(disposition, start, start + end);
}

// multipart_parse(body, boundary) → array of parts:
//   { name, filename?, content_type?, data }
// A part with a filename is a file upload; without one it is a plain field.
// Data preserves its internal CRLFs (only the framing CRLFs are stripped).
fn multipart_parse(body, boundary) {
    let delim = "--" + boundary;
    let segments = str_split(str(body), delim);
    let parts = [];
    let i = 1;   // segments[0] is the (usually empty) preamble
    while i < len(segments) {
        let seg = segments[i];
        i = i + 1;
        if str_starts_with(seg, "--") { break; }        // closing delimiter "--boundary--"
        if str_starts_with(seg, "\r\n") { seg = str_slice(seg, 2, len(seg)); }
        if str_ends_with(seg, "\r\n") { seg = str_slice(seg, 0, len(seg) - 2); }
        let hdr_end = str_index_of(seg, "\r\n\r\n");
        if hdr_end < 0 { continue; }
        let header_block = str_slice(seg, 0, hdr_end);
        let data = str_slice(seg, hdr_end + 4, len(seg));

        let disposition = "";
        let ctype = "";
        let lines = str_split(header_block, "\r\n");
        let li = 0;
        while li < len(lines) {
            let line = lines[li];
            li = li + 1;
            let colon = str_index_of(line, ":");
            if colon < 0 { continue; }
            let hn = str_lower(str_trim(str_slice(line, 0, colon)));
            let hv = str_trim(str_slice(line, colon + 1, len(line)));
            if hn == "content-disposition" { disposition = hv; }
            else if hn == "content-type" { ctype = hv; }
        }

        let part = map{ name: try _cd_param(disposition, "name") catch nil, data: data };
        let fname = _cd_param(disposition, "filename");
        if fname != nil { part.filename = fname; }
        if ctype != "" { part.content_type = ctype; }
        array_push(parts, part);
    }
    return parts;
}

// multipart_form(req) → { fields: map<name,value>, files: [ {name, filename,
// content_type, data} ] } for a multipart/form-data request. Empty when the
// request is not multipart.
fn multipart_form(req) {
    let boundary = multipart_boundary(content_type(req));
    if boundary == nil { return map{ fields: map{}, files: [] }; }
    let parts = multipart_parse(try req.body catch "", boundary);
    let fields = map{};
    let files = [];
    let i = 0;
    while i < len(parts) {
        let p = parts[i];
        i = i + 1;
        if map_has(p, "filename") {
            array_push(files, p);
        } else if p.name != nil {
            fields[p.name] = p.data;
        }
    }
    return map{ fields: fields, files: files };
}

// ── chunked Transfer-Encoding ────────────────────────────────────────────────

// _hex_to_num(s) — parse a hex string (chunk size), or 0.
fn _hex_to_num(s) {
    let t = str_trim(str(s));
    // a chunk-size line may carry ";ext" chunk extensions — ignore them
    let semi = str_index_of(t, ";");
    if semi >= 0 { t = str_trim(str_slice(t, 0, semi)); }
    let n = 0;
    let i = 0;
    while i < len(t) {
        let c = str_lower(str_slice(t, i, i + 1));
        let d = str_index_of("0123456789abcdef", c);
        if d < 0 { return n; }
        n = n * 16 + d;
        i = i + 1;
    }
    return n;
}

// is_chunked(req) — true if the request declares Transfer-Encoding: chunked
// (case-insensitive; a comma list like "gzip, chunked" also counts).
fn is_chunked(req) {
    let te = req_header(req, "Transfer-Encoding");
    if te == nil { return false; }
    return str_contains(str_lower(str(te)), "chunked");
}

// decode_chunked(body) — decode an HTTP/1.1 chunked Transfer-Encoding body into
// the assembled payload. Stops at the zero-length terminator chunk.
fn decode_chunked(body) {
    let s = str(body);
    let out = "";
    let pos = 0;
    let n = len(s);
    while pos < n {
        let line_end = str_index_of(str_slice(s, pos, n), "\r\n");
        if line_end < 0 { break; }
        let size_line = str_slice(s, pos, pos + line_end);
        let size = _hex_to_num(size_line);
        pos = pos + line_end + 2;         // past the size line's CRLF
        if size == 0 { break; }           // terminator
        if pos + size > n { break; }      // truncated
        out = out + str_slice(s, pos, pos + size);
        pos = pos + size + 2;             // past the chunk data + its trailing CRLF
    }
    return out;
}

fn _mime_type(filename) {
    if str_ends_with(filename, ".html") { return "text/html; charset=utf-8"; }
    if str_ends_with(filename, ".htm")  { return "text/html; charset=utf-8"; }
    if str_ends_with(filename, ".css")  { return "text/css; charset=utf-8"; }
    if str_ends_with(filename, ".js")   { return "application/javascript; charset=utf-8"; }
    if str_ends_with(filename, ".mjs")  { return "application/javascript; charset=utf-8"; }
    if str_ends_with(filename, ".ts")   { return "application/typescript; charset=utf-8"; }
    if str_ends_with(filename, ".json") { return "application/json; charset=utf-8"; }
    if str_ends_with(filename, ".xml")  { return "application/xml; charset=utf-8"; }
    if str_ends_with(filename, ".svg")  { return "image/svg+xml"; }
    if str_ends_with(filename, ".png")  { return "image/png"; }
    if str_ends_with(filename, ".jpg")  { return "image/jpeg"; }
    if str_ends_with(filename, ".jpeg") { return "image/jpeg"; }
    if str_ends_with(filename, ".gif")  { return "image/gif"; }
    if str_ends_with(filename, ".webp") { return "image/webp"; }
    if str_ends_with(filename, ".ico")  { return "image/x-icon"; }
    if str_ends_with(filename, ".wasm") { return "application/wasm"; }
    if str_ends_with(filename, ".pdf")  { return "application/pdf"; }
    if str_ends_with(filename, ".zip")  { return "application/zip"; }
    if str_ends_with(filename, ".gz")   { return "application/gzip"; }
    if str_ends_with(filename, ".tar")  { return "application/x-tar"; }
    if str_ends_with(filename, ".mp4")  { return "video/mp4"; }
    if str_ends_with(filename, ".webm") { return "video/webm"; }
    if str_ends_with(filename, ".mp3")  { return "audio/mpeg"; }
    if str_ends_with(filename, ".ogg")  { return "audio/ogg"; }
    if str_ends_with(filename, ".wav")  { return "audio/wav"; }
    if str_ends_with(filename, ".ttf")  { return "font/ttf"; }
    if str_ends_with(filename, ".woff") { return "font/woff"; }
    if str_ends_with(filename, ".woff2"){ return "font/woff2"; }
    if str_ends_with(filename, ".txt")  { return "text/plain; charset=utf-8"; }
    if str_ends_with(filename, ".md")   { return "text/markdown; charset=utf-8"; }
    if str_ends_with(filename, ".csv")  { return "text/csv; charset=utf-8"; }
    return "application/octet-stream";
}

fn static_file_response(root, req_path, max_bytes = 16777216) {
    // SECURITY: _path_safe() strips leading slash, URL-decodes, and rejects any
    // ".." segments to prevent path traversal attacks (e.g. /../../../etc/passwd).
    let full_path = _path_safe(root, req_path);
    if full_path == nil {
        return map{ status: 403, body: "Forbidden", content_type: "text/plain" };
    }
    if type(max_bytes) != "number" or max_bytes < 0 or max_bytes > MAX_STATIC_FILE_BYTES
        or max_bytes != num_floor(max_bytes) {
        return map{ status: 400, body: "Invalid static file limit", content_type: "text/plain" };
    }
    let content = "";
    let loaded_ok = false;
    if platform() == "linux" {
        let loaded = SecureFile.read_text(full_path, max_bytes, false);
        if loaded.ok { content = loaded.text; loaded_ok = true; }
    } else {
        // One path read avoids an exists/read check-use window. Platforms that
        // need hostile-root symlink confinement require a native directory-handle adapter.
        let raw = try fs_read(full_path) catch nil;
        if type(raw) == "string" and len(raw) <= max_bytes { content = str(raw); loaded_ok = true; }
    }
    if not loaded_ok {
        return map{ status: 404, body: "Not Found", content_type: "text/plain" };
    }
    return map{ status: 200, body: content, content_type: _mime_type(full_path) };
}

fn mw_rate_limit(max_req, window_ms) {
    let count = 0;
    let start_time = clock();
    return fn(req) {
        let now = clock();
        if (now - start_time) * 1000.0 > window_ms {
            count = 0;
            start_time = now;
        }
        count = count + 1;
        if count > max_req {
            return map{ status: 429, body: "Too Many Requests", content_type: "text/plain" };
        }
        return nil;
    };
}

fn serve_once_timeout(addr, handler, timeout_ms) {
    let policy_input = if type(timeout_ms) == "map" { timeout_ms }
        else { map{ request_timeout_ms: timeout_ms, max_connections: 1 } };
    policy_input.max_connections = 1;
    let policy = bounded_server_policy(policy_input);
    let target = _native_addr(addr);
    let listener = NativeTcp.listen_ipv4(target.host, target.port, policy.max_inflight * 2);
    if not listener.ok { throw "serve_once_timeout: " + str(try listener.error catch "bind failed"); }
    let actual = target.host + ":" + str(listener.port);
    try serve_bounded_listener(listener, handler, policy_input)
        catch { NativeTcp.close(listener); throw "serve_once_timeout failed"; };
    NativeTcp.close(listener);
    return actual;
}

fn serve_forever_timeout(addr, handler, timeout_ms) {
    let policy = bounded_server_policy(timeout_ms);
    let target = _native_addr(addr);
    let listener = NativeTcp.listen_ipv4(target.host, target.port, policy.max_inflight * 2);
    if not listener.ok { throw "serve_forever_timeout: " + str(try listener.error catch "bind failed"); }
    print target.host + ":" + str(listener.port);
    try serve_bounded_listener(listener, handler, timeout_ms)
        catch { NativeTcp.close(listener); throw "serve_forever_timeout failed"; };
    NativeTcp.close(listener);
}

// Server-Sent Events helpers
// sse_event(event_name, data) → SSE formatted string
fn sse_event(event_name, data) {
    return "event: " + event_name + "\ndata: " + data + "\n\n";
}

// res_sse_headers() → response map with SSE content-type and headers
fn res_sse_headers() {
    return map{
        content_type: "text/event-stream",
        headers: map{
            "Cache-Control": "no-cache",
            "Connection": "keep-alive",
            "Access-Control-Allow-Origin": "*"
        }
    };
}

