// Linux x86-64 exact-inode linkat helper generated entirely by PBLang.
//
// An unprivileged process cannot generally use linkat(AT_EMPTY_PATH). Instead,
// this helper links through the kernel's /proc/self/fd projection of an
// inherited O_TMPFILE descriptor. That projection is bound to the held inode;
// there is no mutable source filename that another principal can substitute.

let X = import("stdlib:codegen_x64.sapp");

let LOAD_BASE = 0x400000;
let ELF_HEADER_BYTES = 120;
let SYS_LINKAT_X86_64 = 265;
let AT_FDCWD = -100;
let AT_SYMLINK_FOLLOW = 1024;

fn _append(dst, src) {
    for i len(src) { dst[len(dst)] = src[i]; }
    return dst;
}

fn _component(value, label) {
    if type(value) != "string" or len(value) < 1 or len(value) > 255
       or value == "." or value == ".." or str_contains(value, "/")
       or str_contains(value, strfromcharcode(0)) {
        throw "linux_linkat_held: invalid " + label;
    }
    let out = str_to_bytes(value); out[len(out)] = 0; return out;
}

fn _fd(value, label) {
    if type(value) != "number" or value != num_floor(value)
       or value < 0 or value > 4194304 {
        throw "linux_linkat_held: invalid " + label;
    }
    return value;
}

fn _set_rel32(code, position, target) {
    let delta = target - (position + 4);
    if delta < -2147483648 or delta > 2147483647 {
        throw "linux_linkat_held: branch exceeds rel32";
    }
    if delta < 0 { delta = 4294967296 + delta; }
    let bytes = X.le32(delta);
    for i 4 { code[position + i] = bytes[i]; }
}

fn _emit(source_address, dest_fd, dest_address) {
    let code = [];
    _append(code, X.mov_imm32("rax", SYS_LINKAT_X86_64));
    _append(code, X.mov_imm32("rdi", AT_FDCWD));
    _append(code, X.movabs_imm64("rsi", source_address));
    _append(code, X.mov_imm32("rdx", dest_fd));
    // linkat's fourth and fifth arguments use r10 and r8.
    _append(code, [0x49, 0xBA]); _append(code, X.le64(dest_address));
    _append(code, [0x41, 0xB8]); _append(code, X.le32(AT_SYMLINK_FOLLOW));
    _append(code, X.syscall());
    _append(code, [0x48, 0x85, 0xC0]);
    _append(code, [0x0F, 0x88]); let failure_branch = len(code);
    _append(code, [0, 0, 0, 0]);
    _append(code, X.mov_imm32("rax", 60));
    _append(code, X.mov_imm32("rdi", 0));
    _append(code, X.syscall());
    let failure = len(code);
    _append(code, X.mov_imm32("rax", 60));
    _append(code, X.mov_imm32("rdi", 1));
    _append(code, X.syscall());
    _set_rel32(code, failure_branch, failure);
    return code;
}

fn build(source_fd, dest_fd, dest_name) {
    source_fd = _fd(source_fd, "source descriptor");
    dest_fd = _fd(dest_fd, "destination descriptor");
    let source_bytes = str_to_bytes("/proc/self/fd/" + str(source_fd));
    source_bytes[len(source_bytes)] = 0;
    let dest_bytes = _component(dest_name, "destination name");
    let probe = _emit(0, dest_fd, 0);
    let source_address = LOAD_BASE + ELF_HEADER_BYTES + len(probe);
    let dest_address = source_address + len(source_bytes);
    let code = _emit(source_address, dest_fd, dest_address);
    let data = []; _append(data, source_bytes); _append(data, dest_bytes);
    return X.elf64_exec_rx(code, data);
}

fn info() {
    return map{
        format: "pblang.linux-linkat-held.v1",
        platform: "linux", architecture: "x86_64",
        syscall: "linkat", flag: "AT_SYMLINK_FOLLOW",
        source: "inherited /proc/self/fd descriptor projection",
        exact_held_inode: true, no_replace: true,
        no_shell: true, external_compiler: false, static_elf: true
    };
}

export build, info;
