// stdlib/event.sapp — EventEmitter pattern.
//
// Create event buses, subscribe with handlers, emit events.
//
// Usage:
//   let bus = event.new();
//   event.on(bus, "click", fn(data) { print data; });
//   event.emit(bus, "click", map{ x: 10, y: 20 });

// new() — create a new event emitter (a map of event→[handlers])
fn new() {
    return map{ __handlers: map{} };
}

// on(emitter, event_name, handler_fn) — subscribe to an event
fn on(emitter, event_name, handler_fn) {
    let handlers = emitter.__handlers;
    if map_has(handlers, event_name) == false {
        handlers[event_name] = [];
    }
    array_push(handlers[event_name], handler_fn);
    return emitter;
}

// once(emitter, event_name, handler_fn) — subscribe once, auto-remove after first call
fn once(emitter, event_name, handler_fn) {
    let called = false;
    let wrapper = fn(data) {
        if called == false {
            called = true;
            handler_fn(data);
        }
    };
    return on(emitter, event_name, wrapper);
}

// off(emitter, event_name, handler) — remove a specific handler, or ALL handlers
// for the event when `handler` is omitted.
fn off(emitter, event_name, handler = nil) {
    let handlers = emitter.__handlers;
    if map_has(handlers, event_name) == false { return emitter; }
    if handler == nil { map_remove(handlers, event_name); return emitter; }
    let hs = handlers[event_name];
    let kept = [];
    let i = 0;
    while i < len(hs) { if hs[i] != handler { array_push(kept, hs[i]); } i = i + 1; }
    handlers[event_name] = kept;
    return emitter;
}

// emit(emitter, event_name, data) — call all handlers for event, ISOLATING errors
// (one throwing listener can't stop the rest). Returns the number invoked.
fn emit(emitter, event_name, data) {
    let handlers = emitter.__handlers;
    if map_has(handlers, event_name) == false { return 0; }
    let hs = handlers[event_name];
    let count = 0;
    let i = 0;
    while i < len(hs) {
        let _ig = try hs[i](data) catch nil;
        count = count + 1;
        i = i + 1;
    }
    return count;
}

// remove_all(emitter) — drop every handler for every event.
fn remove_all(emitter) { emitter.__handlers = map{}; return emitter; }

// has_listeners(emitter, event_name) — true if the event has any handler.
fn has_listeners(emitter, event_name) { return listener_count(emitter, event_name) > 0; }

// listener_count(emitter, event_name) — number of listeners
fn listener_count(emitter, event_name) {
    let handlers = emitter.__handlers;
    if map_has(handlers, event_name) == false { return 0; }
    return len(handlers[event_name]);
}

// event_names(emitter) — all registered event names
fn event_names(emitter) {
    return map_keys(emitter.__handlers);
}

// listeners(emitter, event_name) — a copy of the handler list for an event ([] if none).
fn listeners(emitter, event_name) {
    let handlers = emitter.__handlers;
    if map_has(handlers, event_name) == false { return []; }
    let hs = handlers[event_name];
    let out = [];
    let i = 0;
    while i < len(hs) { array_push(out, hs[i]); i = i + 1; }
    return out;
}

// forward(src, event_name, dst) — re-emit src's `event_name` onto the dst emitter.
fn forward(src, event_name, dst) {
    return on(src, event_name, fn(data) { emit(dst, event_name, data); });
}

// prepend(emitter, event_name, handler_fn) — subscribe a handler that runs BEFORE
// all existing handlers for the event.
fn prepend(emitter, event_name, handler_fn) {
    let handlers = emitter.__handlers;
    let existing = [];
    if map_has(handlers, event_name) { existing = handlers[event_name]; }
    let out = [handler_fn];
    let i = 0;
    while i < len(existing) { array_push(out, existing[i]); i = i + 1; }
    handlers[event_name] = out;
    return emitter;
}

export new, on, once, off, emit, listener_count, event_names, remove_all, has_listeners;
export listeners, forward, prepend;
