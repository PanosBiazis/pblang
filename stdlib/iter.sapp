// stdlib/iter.sapp — Lazy-style iterator utilities.
//
// Iterators are maps: { __iter: true, next: fn(_self) → value | nil }
// Call next via METHOD CALL syntax: it:next()
// This passes `it` as the first argument (_self) automatically.
// Exhausted when next() returns nil.
//
// Usage:
//   let it = iter.from_array([1, 2, 3]);
//   let doubled = iter.map_iter(it, fn(x) { return x * 2; });
//   print iter.collect(doubled);  // [2, 4, 6]

// _next(it) — helper to call next on an iterator (handles method dispatch)
fn _next(it) { return it:next(); }

// from_array(a) — create an iterator over an array
fn from_array(a) {
    let idx = 0;
    return map{
        __iter: true,
        next: fn(_self) {
            if idx >= len(a) { return nil; }
            let v = a[idx];
            idx = idx + 1;
            return v;
        }
    };
}

// from_range(start, end_excl, step) — integer range iterator [start, end_excl) step
fn from_range(start, end_excl, step) {
    if step == nil { step = 1; }
    let cur = start;
    return map{
        __iter: true,
        next: fn(_self) {
            if step > 0 and cur >= end_excl { return nil; }
            if step < 0 and cur <= end_excl { return nil; }
            let v = cur;
            cur = cur + step;
            return v;
        }
    };
}

// map_iter(iter, fn) — transform each element
fn map_iter(it, fn_val) {
    return map{
        __iter: true,
        next: fn(_self) {
            let v = _next(it);
            if v == nil { return nil; }
            return fn_val(v);
        }
    };
}

// filter_iter(iter, pred) — keep only elements where pred returns true
fn filter_iter(it, pred) {
    return map{
        __iter: true,
        next: fn(_self) {
            while true {
                let v = _next(it);
                if v == nil { return nil; }
                if pred(v) { return v; }
            }
            return nil;
        }
    };
}

// take(iter, n) — take at most n elements
fn take(it, n) {
    let count = 0;
    return map{
        __iter: true,
        next: fn(_self) {
            if count >= n { return nil; }
            let v = _next(it);
            if v == nil { return nil; }
            count = count + 1;
            return v;
        }
    };
}

// skip(iter, n) — skip the first n elements
fn skip(it, n) {
    let skipped = false;
    return map{
        __iter: true,
        next: fn(_self) {
            if skipped == false {
                let i = 0;
                while i < n {
                    let _ = _next(it);
                    i = i + 1;
                }
                skipped = true;
            }
            return _next(it);
        }
    };
}

// zip(iter_a, iter_b) — pair up elements as [a, b]
fn zip(a_it, b_it) {
    return map{
        __iter: true,
        next: fn(_self) {
            let va = _next(a_it);
            let vb = _next(b_it);
            if va == nil or vb == nil { return nil; }
            return [va, vb];
        }
    };
}

// chain(iter_a, iter_b) — append iter_b after iter_a is exhausted
fn chain(a_it, b_it) {
    let a_done = false;
    return map{
        __iter: true,
        next: fn(_self) {
            if a_done == false {
                let v = _next(a_it);
                if v != nil { return v; }
                a_done = true;
            }
            return _next(b_it);
        }
    };
}

// enumerate(iter) — pair each element with its index as [index, value]
fn enumerate(it) {
    let idx = 0;
    return map{
        __iter: true,
        next: fn(_self) {
            let v = _next(it);
            if v == nil { return nil; }
            let pair = [idx, v];
            idx = idx + 1;
            return pair;
        }
    };
}

// collect(iter) — materialize all elements into an array
fn collect(it) {
    let result = [];
    while true {
        let v = _next(it);
        if v == nil { return result; }
        array_push(result, v);
    }
    return result;
}

// reduce_iter(iter, fn, initial) — fold over elements
fn reduce_iter(it, fn_val, initial) {
    let acc = initial;
    while true {
        let v = _next(it);
        if v == nil { return acc; }
        acc = fn_val(acc, v);
    }
    return acc;
}

// for_each(iter, fn) — call fn for each element (side effects)
fn for_each(it, fn_val) {
    while true {
        let v = _next(it);
        if v == nil { return nil; }
        fn_val(v);
    }
}

// count_iter(iter) — count total elements
fn count_iter(it) {
    let n = 0;
    while true {
        let v = _next(it);
        if v == nil { return n; }
        n = n + 1;
    }
    return n;
}

// first_iter(iter) — return first element or nil
fn first_iter(it) { return _next(it); }

// any_iter(iter, pred) — true if any element matches pred
fn any_iter(it, pred) {
    while true {
        let v = _next(it);
        if v == nil { return false; }
        if pred(v) { return true; }
    }
    return false;
}

// all_iter(iter, pred) — true if all elements match pred
fn all_iter(it, pred) {
    while true {
        let v = _next(it);
        if v == nil { return true; }
        if pred(v) == false { return false; }
    }
    return true;
}

// flat_map_iter(iter, fn) — map then flatten one level
fn flat_map_iter(it, fn_val) {
    let inner = nil;
    return map{
        __iter: true,
        next: fn(_self) {
            while true {
                if inner != nil {
                    let v = _next(inner);
                    if v != nil { return v; }
                    inner = nil;
                }
                let outer_v = _next(it);
                if outer_v == nil { return nil; }
                inner = from_array(fn_val(outer_v));
            }
            return nil;
        }
    };
}

export from_array, from_range, map_iter, filter_iter, take, skip,
       zip, chain, enumerate, collect, reduce_iter, for_each,
       count_iter, first_iter, any_iter, all_iter, flat_map_iter;
