// stdlib/protocol.sapp — structured message schemas with JSON serialization.
//
// A schema is define_message(name, fields); each field is a map:
//   { name, type, required?, default?, repeated?, enum?, message? }
//   type      — "number"|"string"|"bool"|"array"|"map"|"any" (aliases: int/float ->
//               number, str/text -> string, boolean -> bool, list -> array,
//               object/dict -> map)
//   repeated  — value must be an ARRAY whose elements all match `type`
//   enum      — value must be one of the listed values
//   message   — a nested message schema; the value is validated against it
//   default   — value filled in by encode/decode when the field is absent

fn define_message(name, fields) { return map{ __proto_name: name, __fields: fields }; }

// ── type helpers ─────────────────────────────────────────────────────────────────
fn _norm_type(t) {
    let s = str_lower(str(t));
    if s == "int" or s == "integer" or s == "float" or s == "double" or s == "number" { return "number"; }
    if s == "str" or s == "string" or s == "text" { return "string"; }
    if s == "bool" or s == "boolean" { return "bool"; }
    if s == "list" or s == "array" { return "array"; }
    if s == "object" or s == "map" or s == "dict" { return "map"; }
    return s;
}
fn _type_matches(ftype, val) {
    let want = _norm_type(ftype);
    if want == "any" { return true; }
    return type(val) == want;
}
fn _in_list(list, v) {
    let i = 0;
    while i < len(list) { if list[i] == v { return true; } i = i + 1; }
    return false;
}

// _fill_defaults(fields, out) — copy each absent field's `default` into out (in place).
fn _fill_defaults(fields, out) {
    let i = 0;
    while i < len(fields) {
        let f = fields[i];
        let name = try f.name catch nil;
        if name != nil and not map_has(out, name) {
            let d = try f.default catch nil;
            if d != nil { out[name] = d; }
        }
        i = i + 1;
    }
    return out;
}

fn encode(msg_def, data) {
    let fields = msg_def.__fields;
    let out = map{};
    let i = 0;
    while i < len(fields) {
        let f = fields[i];
        let name = try f.name catch nil;
        let val = try data[name] catch nil;
        if val != nil { out[name] = val; }
        else {
            let d = try f.default catch nil;
            if d != nil { out[name] = d; }
            else if try f.required catch false { return error("protocol.encode: missing field '" + str(name) + "'"); }
        }
        i = i + 1;
    }
    return json_stringify(out);
}

fn decode(msg_def, json_str) {
    let data = try json_parse(json_str) catch nil;
    if data == nil { return error("protocol.decode: invalid JSON"); }
    let fields = msg_def.__fields;
    let i = 0;
    while i < len(fields) {
        let f = fields[i];
        let name = try f.name catch nil;
        if (try f.required catch false) and map_has(data, name) == false {
            return error("protocol.decode: missing required field '" + str(name) + "'");
        }
        i = i + 1;
    }
    _fill_defaults(fields, data);
    return data;
}

fn validate(msg_def, data) {
    let fields = msg_def.__fields;
    let errors = [];
    let i = 0;
    while i < len(fields) {
        let f = fields[i];
        let name = try f.name catch nil;
        let required = try f.required catch false;
        let val = try data[name] catch nil;
        if val == nil {
            if required { array_push(errors, "missing: " + str(name)); }
        } else {
            let ftype = try f.type catch "any";
            if (try f.repeated catch false) {
                if not is_array(val) {
                    array_push(errors, str(name) + ": expected an array (repeated)");
                } else {
                    let j = 0;
                    while j < len(val) {
                        if not _type_matches(ftype, val[j]) {
                            array_push(errors, str(name) + "[" + str(j) + "]: expected " + str(ftype));
                        }
                        j = j + 1;
                    }
                }
            } else {
                if not _type_matches(ftype, val) {
                    array_push(errors, str(name) + ": expected " + str(ftype) + ", got " + type(val));
                }
                let en = try f.enum catch nil;
                if en != nil and not _in_list(en, val) {
                    array_push(errors, str(name) + ": '" + str(val) + "' not in enum");
                }
                let nested = try f.message catch nil;
                if nested != nil and is_map(val) {
                    let sub = validate(nested, val);
                    if not sub.valid {
                        let k = 0;
                        while k < len(sub.errors) { array_push(errors, str(name) + "." + sub.errors[k]); k = k + 1; }
                    }
                }
            }
        }
        i = i + 1;
    }
    if len(errors) > 0 { return map{ valid: false, errors: errors }; }
    return map{ valid: true, errors: [] };
}

// encode_strict(msg_def, data) — validate first; on failure raise an error listing
// every problem, otherwise encode.
fn encode_strict(msg_def, data) {
    let v = validate(msg_def, data);
    if not v.valid { return error("protocol.encode_strict: " + str_join(v.errors, "; ")); }
    return encode(msg_def, data);
}

export define_message, encode, decode, validate, encode_strict;
