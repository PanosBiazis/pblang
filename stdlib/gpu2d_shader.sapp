// stdlib/gpu2d_shader.sapp — pblang EMITS the GPU shader program for the 2D UI pipeline.
//
// The GPU half of the rasterizer, written by pblang. `wgsl()` returns a complete WGSL
// module (wgpu / WebGPU); `glsl_vertex()`/`glsl_fragment()` return GLSL 330 (OpenGL). Both
// consume gpu2d's instanced buffer via `vertex_layout()` — the byte-offset contract that
// binds the 14-float instance record to the shader's attributes. One instanced draw paints
// the whole UI: kind 0 = solid rect, 1 = SDF-antialiased rounded rect, 2 = atlas glyph.
//
// This is codegen, not execution — exactly like codegen_qasm emits OpenQASM. The emitted
// source is real; a wgpu/OpenGL host (see gpu2d_host.sapp) compiles and runs it.

// vertex_layout() — how gpu2d's f32 buffer maps to shader attributes. gpu2d bakes
// [x,y,w,h, rad, r,g,b,a, u0,v0,u1,v1, kind] = 14 f32 = 56 bytes, step mode = per-instance.
fn vertex_layout() {
    return map{ stride: 56, step: "instance", attributes: [
        map{ location: 0, offset: 0,  floats: 4, name: "rect",  format: "float32x4" },
        map{ location: 1, offset: 16, floats: 1, name: "rad",   format: "float32"   },
        map{ location: 2, offset: 20, floats: 4, name: "color", format: "float32x4" },
        map{ location: 3, offset: 36, floats: 4, name: "uv",    format: "float32x4" },
        map{ location: 4, offset: 52, floats: 1, name: "kind",  format: "float32"   }
    ]};
}

let _WGSL = nil;
fn wgsl() {
    if _WGSL != nil { return _WGSL; }
    let L = [
        "// gpu2d WGSL — instanced 2D UI (rect / SDF rounded-rect / atlas glyph).",
        "struct Viewport { size: vec2<f32>, pad: vec2<f32> };",
        "@group(0) @binding(0) var<uniform> viewport: Viewport;",
        "@group(0) @binding(1) var atlas_tex: texture_2d<f32>;",
        "@group(0) @binding(2) var atlas_smp: sampler;",
        "",
        "struct VSOut {",
        "  @builtin(position) pos: vec4<f32>,",
        "  @location(0) color: vec4<f32>,",
        "  @location(1) local: vec2<f32>,",
        "  @location(2) half_size: vec2<f32>,",
        "  @location(3) radius: f32,",
        "  @location(4) uv: vec2<f32>,",
        "  @location(5) kind: f32,",
        "};",
        "",
        "fn sd_round_box(p: vec2<f32>, b: vec2<f32>, r: f32) -> f32 {",
        "  let q = abs(p) - b + vec2<f32>(r, r);",
        "  return min(max(q.x, q.y), 0.0) + length(max(q, vec2<f32>(0.0, 0.0))) - r;",
        "}",
        "",
        "@vertex",
        "fn vs_main(@builtin(vertex_index) vid: u32,",
        "           @location(0) i_rect: vec4<f32>, @location(1) i_rad: f32,",
        "           @location(2) i_color: vec4<f32>, @location(3) i_uv: vec4<f32>,",
        "           @location(4) i_kind: f32) -> VSOut {",
        "  var corners = array<vec2<f32>, 6>(",
        "    vec2<f32>(0.0,0.0), vec2<f32>(1.0,0.0), vec2<f32>(0.0,1.0),",
        "    vec2<f32>(0.0,1.0), vec2<f32>(1.0,0.0), vec2<f32>(1.0,1.0));",
        "  let c = corners[vid];",
        "  let world = i_rect.xy + c * i_rect.zw;",
        "  let ndc = vec2<f32>(world.x / viewport.size.x * 2.0 - 1.0,",
        "                      1.0 - world.y / viewport.size.y * 2.0);",
        "  var o: VSOut;",
        "  o.pos = vec4<f32>(ndc, 0.0, 1.0);",
        "  o.color = i_color;",
        "  o.half_size = i_rect.zw * 0.5;",
        "  o.local = (c - vec2<f32>(0.5, 0.5)) * i_rect.zw;",
        "  o.radius = i_rad;",
        "  o.uv = mix(i_uv.xy, i_uv.zw, c);",
        "  o.kind = i_kind;",
        "  return o;",
        "}",
        "",
        "@fragment",
        "fn fs_main(in: VSOut) -> @location(0) vec4<f32> {",
        "  var alpha = in.color.a;",
        "  if (in.kind > 0.5 && in.kind < 1.5) {",
        "    let d = sd_round_box(in.local, in.half_size, in.radius);",
        "    alpha = in.color.a * (1.0 - smoothstep(-1.0, 1.0, d));",
        "  } else if (in.kind > 1.5) {",
        "    let cov = textureSample(atlas_tex, atlas_smp, in.uv).r;",
        "    alpha = in.color.a * cov;",
        "  }",
        "  return vec4<f32>(in.color.rgb, alpha);",
        "}"
    ];
    _WGSL = str_join(L, "\n");
    return _WGSL;
}

fn glsl_vertex() {
    let L = [
        "#version 330 core",
        "layout(location=0) in vec4 i_rect;",
        "layout(location=1) in float i_rad;",
        "layout(location=2) in vec4 i_color;",
        "layout(location=3) in vec4 i_uv;",
        "layout(location=4) in float i_kind;",
        "uniform vec2 u_viewport;",
        "out vec4 v_color; out vec2 v_local; out vec2 v_half;",
        "out float v_radius; out vec2 v_uv; out float v_kind;",
        "const vec2 CORNERS[6] = vec2[6](vec2(0,0),vec2(1,0),vec2(0,1),vec2(0,1),vec2(1,0),vec2(1,1));",
        "void main() {",
        "  vec2 c = CORNERS[gl_VertexID];",
        "  vec2 world = i_rect.xy + c * i_rect.zw;",
        "  vec2 ndc = vec2(world.x/u_viewport.x*2.0-1.0, 1.0 - world.y/u_viewport.y*2.0);",
        "  gl_Position = vec4(ndc, 0.0, 1.0);",
        "  v_color = i_color; v_half = i_rect.zw*0.5; v_local = (c-vec2(0.5))*i_rect.zw;",
        "  v_radius = i_rad; v_uv = mix(i_uv.xy, i_uv.zw, c); v_kind = i_kind;",
        "}"
    ];
    return str_join(L, "\n");
}

fn glsl_fragment() {
    let L = [
        "#version 330 core",
        "in vec4 v_color; in vec2 v_local; in vec2 v_half; in float v_radius; in vec2 v_uv; in float v_kind;",
        "uniform sampler2D u_atlas;",
        "out vec4 fragColor;",
        "float sd_round_box(vec2 p, vec2 b, float r){",
        "  vec2 q = abs(p) - b + vec2(r);",
        "  return min(max(q.x,q.y),0.0) + length(max(q, vec2(0.0))) - r;",
        "}",
        "void main() {",
        "  float alpha = v_color.a;",
        "  if (v_kind > 0.5 && v_kind < 1.5) {",
        "    float d = sd_round_box(v_local, v_half, v_radius);",
        "    alpha = v_color.a * (1.0 - smoothstep(-1.0, 1.0, d));",
        "  } else if (v_kind > 1.5) {",
        "    float cov = texture(u_atlas, v_uv).r;",
        "    alpha = v_color.a * cov;",
        "  }",
        "  fragColor = vec4(v_color.rgb, alpha);",
        "}"
    ];
    return str_join(L, "\n");
}

// ── mesh pipeline: for gpu2d_tess triangle buffers ([x,y,r,g,b,a] = 6 f32 = 24 bytes) ──
fn mesh_vertex_layout() {
    return map{ stride: 24, step: "vertex", attributes: [
        map{ location: 0, offset: 0, floats: 2, name: "pos",   format: "float32x2" },
        map{ location: 1, offset: 8, floats: 4, name: "color", format: "float32x4" }
    ]};
}
let _MWGSL = nil;
fn mesh_wgsl() {
    if _MWGSL != nil { return _MWGSL; }
    let L = [
        "// gpu2d mesh WGSL — tessellated triangles with per-vertex colour (gradients).",
        "struct MViewport { size: vec2<f32>, pad: vec2<f32> };",
        "@group(0) @binding(0) var<uniform> viewport: MViewport;",
        "struct MOut { @builtin(position) pos: vec4<f32>, @location(0) color: vec4<f32> };",
        "@vertex",
        "fn vs_main(@location(0) p: vec2<f32>, @location(1) col: vec4<f32>) -> MOut {",
        "  let ndc = vec2<f32>(p.x / viewport.size.x * 2.0 - 1.0, 1.0 - p.y / viewport.size.y * 2.0);",
        "  var o: MOut; o.pos = vec4<f32>(ndc, 0.0, 1.0); o.color = col; return o;",
        "}",
        "@fragment",
        "fn fs_main(in: MOut) -> @location(0) vec4<f32> { return in.color; }"
    ];
    _MWGSL = str_join(L, "\n");
    return _MWGSL;
}
fn mesh_glsl_vertex() {
    let L = [
        "#version 330 core",
        "layout(location=0) in vec2 i_pos;",
        "layout(location=1) in vec4 i_color;",
        "uniform vec2 u_viewport;",
        "out vec4 v_color;",
        "void main() {",
        "  vec2 ndc = vec2(i_pos.x/u_viewport.x*2.0-1.0, 1.0 - i_pos.y/u_viewport.y*2.0);",
        "  gl_Position = vec4(ndc, 0.0, 1.0); v_color = i_color;",
        "}"
    ];
    return str_join(L, "\n");
}
fn mesh_glsl_fragment() {
    return str_join(["#version 330 core", "in vec4 v_color; out vec4 fragColor;",
        "void main() { fragColor = v_color; }"], "\n");
}

export vertex_layout, wgsl, glsl_vertex, glsl_fragment;
export mesh_vertex_layout, mesh_wgsl, mesh_glsl_vertex, mesh_glsl_fragment;
