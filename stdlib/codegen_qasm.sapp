// stdlib/codegen_qasm.sapp — pblang's QUANTUM backend: a gate IR -> OpenQASM 2.0.
//
// Quantum computing is a different model from arithmetic/loops, so "quantum machine code"
// honestly means OpenQASM — the assembly that real quantum devices (IBM, etc.) and
// simulators consume. pblang GENERATES the quantum program; running it is the QPU's/
// simulator's job (stdlib/quantum_sim.sapp can execute it locally). Same contract as the
// classical backends: pblang emits, the device runs.
//
//   Gate IR (list): ["h"|"x"|"y"|"z"|"s"|"t", q]   ["cx"|"cz", control, target]   ["measure"]
//
//   let q = import("stdlib/codegen_qasm.sapp");
//   q.qasm([["h",0],["cx",0,1],["measure"]], 2);   // -> OpenQASM 2.0 source

fn _vq(q, nq) { if q < 0 or q >= nq { throw "codegen_qasm: qubit out of range 0.." + str(nq - 1) + ": " + str(q); } return q; }

fn _one(name, q, nq) { return name + " q[" + str(_vq(q, nq)) + "];\n"; }
fn _two(name, c, t, nq) { return name + " q[" + str(_vq(c, nq)) + "],q[" + str(_vq(t, nq)) + "];\n"; }

// qasm(gates, nqubits) — render the gate IR to an OpenQASM 2.0 program with nqubits qubits
// and nqubits classical bits.
fn qasm(gates, nqubits) {
    let s = "OPENQASM 2.0;\n";
    s = s + "include \"qelib1.inc\";\n";
    s = s + "qreg q[" + str(nqubits) + "];\n";
    s = s + "creg c[" + str(nqubits) + "];\n";
    let i = 0;
    while i < len(gates) {
        let g = gates[i];
        let op = g[0];
        if op == "h" or op == "x" or op == "y" or op == "z" or op == "s" or op == "t" {
            s = s + _one(op, g[1], nqubits);
        }
        else if op == "cx" or op == "cz" {
            s = s + _two(op, g[1], g[2], nqubits);
        }
        else if op == "measure" {
            s = s + "measure q -> c;\n";
        }
        else { throw "codegen_qasm: unknown gate: " + str(op); }
        i = i + 1;
    }
    return s;
}

// gate_count(gates) — number of gate/measurement ops in the program.
fn gate_count(gates) { return len(gates); }

// qubits_used(gates) — highest qubit index referenced + 1 (handy to size the register).
fn qubits_used(gates) {
    let mx = 0 - 1;
    let i = 0;
    while i < len(gates) {
        let g = gates[i];
        if g[0] != "measure" {
            if g[1] > mx { mx = g[1]; }
            if len(g) > 2 { if g[2] > mx { mx = g[2]; } }
        }
        i = i + 1;
    }
    return mx + 1;
}

export qasm, gate_count, qubits_used;
