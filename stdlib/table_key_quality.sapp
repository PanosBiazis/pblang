// Advisory exact single-column key review. No source text in diagnostics.
let S=import("stdlib:sheet_document.sapp");let Select=import("stdlib:table_row_selection.sapp");
fn inspect(doc,column,header=false) {
 let size=S.validate(doc);
 if type(header)!="bool" or type(column)!="number" or not(column>=0 and column<size.columns) or column!=num_floor(column) {throw "invalid key column or header mode";}
 let start=if header {1} else {0};let seen=map{};let included=map{};let rows=[];let missing=0;let duplicates=0;
 for r in range(start,size.rows) {
  let value=doc.cells[r][column];let blank=str_trim(value)=="";let first=nil;
  if blank {missing=missing+1;included[str(r)]=true;}
  else {
   if map_has(seen,value) {first=seen[value];duplicates=duplicates+1;included[str(first)]=true;included[str(r)]=true;}
   else {seen[value]=r;}
  }
  if blank or first!=nil {array_push(rows,map{row:r,missing_key:blank,duplicate_of:first});}
 }
 let indices=[];for r in range(start,size.rows) {if map_has(included,str(r)) {array_push(indices,r);}}
 return map{format:"pblang.table-key-quality.v1",header:header,key_column:column,rows_checked:size.rows-start,
  flagged_rows:len(rows),missing_keys:missing,duplicate_keys:duplicates,rows:rows,review_indices:indices,review_rows:len(indices),
  contains_cell_text:false,contains_headers:false,safe_to_log:false};
}
fn select_review(doc,column,header=false) {
 let report=inspect(doc,column,header);
 if len(report.review_indices)==0 {throw "no keys flagged for review";}
 return Select.select(doc,report.review_indices,header);
}
fn describe_row(row) {
 if row.missing_key {return "Source row "+str(row.row+1)+" | blank key";}
 return "Source row "+str(row.row+1)+" | same key as row "+str(row.duplicate_of+1);
}
export inspect,select_review,describe_row;
