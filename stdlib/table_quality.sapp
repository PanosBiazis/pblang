// Advisory literal data checks. No inference, correction, numeric coercion or I/O.
let Sheet=import("stdlib:sheet_document.sapp");
let Selection=import("stdlib:table_row_selection.sapp");
fn inspect(doc,header=false) {
 let size=Sheet.validate(doc);if type(header)!="bool" {throw "header must be boolean";}
 let rows=[];let seen=map{};let blank=0;let padded=0;let duplicates=0;
 let start=if header {1} else {0};
 for r in range(start,size.rows) {
  let blanks=[];let padding=[];
  for c in range(0,size.columns) {
   let text=doc.cells[r][c];let trimmed=str_trim(text);
   if trimmed=="" {array_push(blanks,c);blank=blank+1;}
   if trimmed!=text {array_push(padding,c);padded=padded+1;}
  }
  let key=json_stringify(doc.cells[r]);let duplicate=nil;
  if map_has(seen,key) {duplicate=seen[key];duplicates=duplicates+1;} else {seen[key]=r;}
  if len(blanks)>0 or len(padding)>0 or duplicate!=nil {
   array_push(rows,map{row:r,blank_columns:blanks,padded_columns:padding,duplicate_of:duplicate});
  }
 }
 return map{format:"pblang.table-quality.v1",header:header,rows_checked:size.rows-start,columns:size.columns,
  flagged_rows:len(rows),blank_cells:blank,padded_cells:padded,duplicate_rows:duplicates,rows:rows,
  contains_cell_text:false,contains_headers:false,safe_to_log:false};
}
fn select_flagged(doc,header=false) {
 let report=inspect(doc,header);let indices=[];for row in report.rows {array_push(indices,row.row);}
 if len(indices)==0 {throw "no rows flagged for review";}
 return Selection.select(doc,indices,header);
}
fn _positions(indices) {let out=[];for i in indices {array_push(out,str(i+1));}return str_join(out,",");}
fn describe_row(row) {
 let parts=["Source row "+str(row.row+1)];
 if len(row.blank_columns)>0 {array_push(parts,"blank columns "+_positions(row.blank_columns));}
 if len(row.padded_columns)>0 {array_push(parts,"padded columns "+_positions(row.padded_columns));}
 if row.duplicate_of!=nil {array_push(parts,"duplicate of row "+str(row.duplicate_of+1));}
 return str_join(parts," | ");
}
export inspect,select_flagged,describe_row;
