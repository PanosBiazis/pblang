// stdlib/emulator_msp430.sapp -- bounded MSP430 execution-model subset.

let Support = import("stdlib:emulator_support.sapp");
let FORMAT = "pblang.emulator.msp430.v1";
let DEFAULT_BUDGET = 1000000;
let MAX_CODE_WORDS = 65536;

fn _require(value, low, high, name) {
    if not Support.integer(value, low, high) {
        throw "emulator_msp430: " + name + " must be " + str(low) + ".." + str(high);
    }
    return value;
}
fn _u16(value) { let result = value % 65536; if result < 0 { result = result + 65536; } return result; }
fn _offset10(value) { let result = value % 1024; if result < 0 { result = result + 1024; } return result; }
fn _register(value, name) { return _require(value, 0, 15, name); }

fn move_immediate(value, destination) {
    _require(value, 0, 65535, "MOV immediate"); _register(destination, "MOV destination");
    return [16432 + destination, value];
}
fn move_register(source, destination) {
    _register(source, "MOV source"); _register(destination, "MOV destination");
    return [16384 + source * 256 + destination];
}
fn add_immediate(value, destination) {
    _require(value, 0, 65535, "ADD immediate"); _register(destination, "ADD destination");
    return [20528 + destination, value];
}
fn add_register(source, destination) {
    _register(source, "ADD source"); _register(destination, "ADD destination");
    return [20480 + source * 256 + destination];
}
fn subtract_immediate(value, destination) {
    _require(value, 0, 65535, "SUB immediate"); _register(destination, "SUB destination");
    return [32816 + destination, value];
}
fn subtract_register(source, destination) {
    _register(source, "SUB source"); _register(destination, "SUB destination");
    return [32768 + source * 256 + destination];
}
fn compare_immediate(value, destination) {
    _require(value, 0, 65535, "CMP immediate"); _register(destination, "CMP destination");
    return [36912 + destination, value];
}
fn jump(offset) { return [15360 + _offset10(_require(offset, -512, 511, "JMP offset"))]; }
fn jump_not_zero(offset) { return [8192 + _offset10(_require(offset, -512, 511, "JNZ offset"))]; }
fn jump_zero(offset) { return [9216 + _offset10(_require(offset, -512, 511, "JZ offset"))]; }
fn halt() { return [53298, 16]; }
fn program(instructions) { return Support.unit_program(instructions, MAX_CODE_WORDS, 65535, "word"); }

fn _failure(reason, pc, instructions) { return Support.failure(FORMAT, reason, pc, instructions); }

fn run(code, options = nil) {
    let invalid = Support.validate_units(code, MAX_CODE_WORDS, 65535, "word");
    if invalid != nil { return _failure(invalid, 0, 0); }
    let budget_result = Support.instruction_budget(options, DEFAULT_BUDGET);
    if not budget_result.ok { return _failure(budget_result.error, 0, 0); }
    let registers = []; let i = 0; while i < 16 { array_push(registers, 0); i = i + 1; }
    let zero = 0; let negative = 0; let carry = 0; let pc = 0; let count = 0;
    while count < budget_result.value {
        if pc < 0 or pc >= len(code) { return _failure("program counter outside code", pc, count); }
        let word = code[pc]; let top3 = num_floor(word / 8192); count = count + 1;
        if top3 == 1 {
            let condition = num_floor(word / 1024) % 8;
            let offset = word % 1024; if offset >= 512 { offset = offset - 1024; }
            let take = false;
            if condition == 7 { take = true; }
            elif condition == 0 { take = zero == 0; }
            elif condition == 1 { take = zero == 1; }
            else { return _failure("unmodeled jump condition " + str(condition), pc, count); }
            pc = pc + 1; if take { pc = pc + offset; }
        } else {
            let opcode = num_floor(word / 4096);
            let source = num_floor(word / 256) % 16;
            let addressing = num_floor(word / 16) % 4;
            let destination = word % 16; let value = 0;
            if addressing == 0 { value = registers[source]; pc = pc + 1; }
            elif addressing == 3 and source == 0 {
                if pc + 1 >= len(code) { return _failure("truncated immediate word at pc " + str(pc), pc, count); }
                value = code[pc + 1]; pc = pc + 2;
            } else {
                return _failure("unmodeled addressing mode " + str(addressing) + " source " + str(source), pc, count);
            }
            if opcode == 4 { registers[destination] = value; }
            elif opcode == 5 {
                let result = registers[destination] + value;
                carry = if result > 65535 { 1 } else { 0 }; registers[destination] = _u16(result);
                zero = if registers[destination] == 0 { 1 } else { 0 };
                negative = if registers[destination] >= 32768 { 1 } else { 0 };
            }
            elif opcode == 8 or opcode == 9 {
                let result = registers[destination] - value;
                carry = if result < 0 { 0 } else { 1 }; let normalized = _u16(result);
                if opcode == 8 { registers[destination] = normalized; }
                zero = if normalized == 0 { 1 } else { 0 };
                negative = if normalized >= 32768 { 1 } else { 0 };
            }
            elif opcode == 13 {
                registers[destination] = bit_or(registers[destination], value);
                if destination == 2 and bit_and(registers[2], 16) == 16 {
                    return map{
                        ok: true, format: FORMAT, halted: true, pc: pc,
                        instructions: count, registers: registers,
                        flags: map{ zero: zero, negative: negative, carry: carry },
                        value: registers[15],
                        boundary: "verified MSP430 register/immediate arithmetic and control subset; not a full MCU"
                    };
                }
            }
            else { return _failure("unmodeled opcode " + str(opcode), pc, count); }
        }
    }
    return _failure("instruction budget exceeded", pc, count);
}

export FORMAT, DEFAULT_BUDGET, MAX_CODE_WORDS;
export move_immediate, move_register, add_immediate, add_register;
export subtract_immediate, subtract_register, compare_immediate;
export jump, jump_not_zero, jump_zero, halt, program, run;
