// Bounded Xtensa LX6 base-instruction encoder used by PBLang embedded
// backends. It emits machine bytes directly and has no assembler dependency.

let FORMAT = "pblang.xtensa-lx6.v1";
let MAX_CODE_BYTES = 65536;

fn _integer(value, minimum, maximum) {
    return type(value) == "number" and value == num_floor(value)
        and value >= minimum and value <= maximum;
}
fn _register(value) {
    if not _integer(value, 0, 15) { throw "xtensa-lx6: register must be a0..a15"; }
    return value;
}
fn _append(target, bytes) { for i len(bytes) { array_push(target, bytes[i]); } }
fn _signed(value, bits) {
    let limit = 2 ** bits;
    if value < 0 { return value + limit; }
    return value;
}

fn l32r(register, instruction_offset, literal_offset) {
    let r = _register(register);
    if not _integer(instruction_offset, 0, 1048575)
       or not _integer(literal_offset, 0, 1048575) {
        throw "xtensa-lx6: invalid l32r offset";
    }
    let aligned = num_floor((instruction_offset + 3) / 4) * 4;
    let delta = literal_offset - aligned;
    if num_mod(delta, 4) != 0 { throw "xtensa-lx6: unaligned l32r literal"; }
    let immediate = delta / 4;
    if immediate < -32768 or immediate > 32767 { throw "xtensa-lx6: l32r literal is out of range"; }
    let encoded = _signed(immediate, 16);
    return [r * 16 + 1, num_mod(encoded, 256), num_floor(encoded / 256)];
}
fn l32i_n(destination, base, offset) {
    let d = _register(destination); let b = _register(base);
    if not _integer(offset, 0, 60) or num_mod(offset, 4) != 0 {
        throw "xtensa-lx6: compact word-load offset must be 0..60 and aligned";
    }
    return [d * 16 + 8, num_floor(offset / 4) * 16 + b];
}
fn s32i_n(source, base, offset) {
    let s = _register(source); let b = _register(base);
    if not _integer(offset, 0, 60) or num_mod(offset, 4) != 0 {
        throw "xtensa-lx6: compact word-store offset must be 0..60 and aligned";
    }
    return [s * 16 + 9, num_floor(offset / 4) * 16 + b];
}
fn l32i(destination, base, offset) {
    let d = _register(destination); let b = _register(base);
    if not _integer(offset, 0, 1020) or num_mod(offset, 4) != 0 {
        throw "xtensa-lx6: word-load offset must be 0..1020 and aligned";
    }
    return [d * 16 + 2, 0x20 + b, num_floor(offset / 4)];
}
fn s32i(source, base, offset) {
    let s = _register(source); let b = _register(base);
    if not _integer(offset, 0, 1020) or num_mod(offset, 4) != 0 {
        throw "xtensa-lx6: word-store offset must be 0..1020 and aligned";
    }
    return [s * 16 + 2, 0x60 + b, num_floor(offset / 4)];
}
fn l8ui(destination, base, offset) {
    let d = _register(destination); let b = _register(base);
    if not _integer(offset, 0, 255) { throw "xtensa-lx6: byte-load offset must be 0..255"; }
    return [d * 16 + 2, b, offset];
}
fn s8i(source, base, offset) {
    let s = _register(source); let b = _register(base);
    if not _integer(offset, 0, 255) { throw "xtensa-lx6: byte-store offset must be 0..255"; }
    return [s * 16 + 2, 0x40 + b, offset];
}
fn movi(register, value) {
    let r = _register(register);
    if not _integer(value, -32, 255) { throw "xtensa-lx6: bounded immediate must be -32..255"; }
    if value <= 95 {
        let encoded = _signed(value, 7);
        return [num_floor(encoded / 16) * 16 + 0x0c, num_mod(encoded, 16) * 16 + r];
    }
    return [r * 16 + 2, 0xa0, value];
}
fn addi_n(register, value) {
    let r = _register(register);
    if not _integer(value, -1, 1) or value == 0 {
        throw "xtensa-lx6: compact add immediate supports -1 or 1 in this backend";
    }
    return [if value == -1 {0x0b}else{0x1b}, r * 17];
}
fn _rrr(destination, left, right, opcode) {
    let d = _register(destination); let l = _register(left); let r = _register(right);
    return [r * 16, d * 16 + l, opcode];
}
fn add_regs(destination, left, right) { return _rrr(destination, left, right, 0x80); }
fn sub_regs(destination, left, right) { return _rrr(destination, left, right, 0xc0); }
fn xor_regs(destination, left, right) { return _rrr(destination, left, right, 0x30); }
fn or_regs(destination, left, right) { return _rrr(destination, left, right, 0x20); }
fn and_regs(destination, left, right) { return _rrr(destination, left, right, 0x10); }
fn move(destination, source) { return or_regs(destination, source, source); }
fn extui(destination, source, shift, width) {
    let d = _register(destination); let s = _register(source);
    if not _integer(shift, 0, 31) or not _integer(width, 1, 16)
       or shift + width > 32 {
        throw "xtensa-lx6: invalid extui field";
    }
    return [s * 16, d * 16 + num_mod(shift, 16),
        (width - 1) * 16 + 4 + num_floor(shift / 16)];
}
fn memw() { return [0xc0, 0x20, 0x00]; }

fn assembler() { return map{format:FORMAT, code:[], labels:map{}, fixups:[], unique:0}; }
fn emit(state, bytes) {
    if type(state) != "map" or (try state.format catch "") != FORMAT
       or type(bytes) != "array" or len(state.code) + len(bytes) > MAX_CODE_BYTES {
        throw "xtensa-lx6: invalid or oversized assembler emission";
    }
    let cursor=0;while cursor<len(bytes){
        if not _integer(bytes[cursor],0,255){throw "xtensa-lx6: emitted value is not a byte";}
        cursor=cursor+1;
    }
    _append(state.code, bytes); return state;
}
fn label(state, name) {
    let key = str(name);
    if key == "" or map_has(state.labels, key) { throw "xtensa-lx6: duplicate or empty label"; }
    state.labels[key] = len(state.code); return state;
}
fn unique(state, prefix) { state.unique = state.unique + 1; return str(prefix) + str(state.unique); }
fn branch_nonzero(state, register, target) {
    let r = _register(register); let at = len(state.code);
    emit(state, [0x56, r, 0]);
    array_push(state.fixups, map{kind:"bnez", at:at, register:r, target:str(target)});
    return state;
}
fn jump(state, target) {
    let at = len(state.code); emit(state, [0x06, 0, 0]);
    array_push(state.fixups, map{kind:"jump", at:at, target:str(target)}); return state;
}
fn finish(state) {
    if type(state) != "map" or (try state.format catch "") != FORMAT {
        throw "xtensa-lx6: invalid assembler state";
    }
    for i len(state.fixups) {
        let fix = state.fixups[i];
        if not map_has(state.labels, fix.target) { throw "xtensa-lx6: unresolved label " + fix.target; }
        let delta = state.labels[fix.target] - (fix.at + 4);
        if fix.kind == "bnez" {
            if delta < -2048 or delta > 2047 { throw "xtensa-lx6: conditional branch is out of range"; }
            let encoded = _signed(delta, 12);
            state.code[fix.at] = 0x56;
            state.code[fix.at + 1] = num_mod(encoded, 16) * 16 + fix.register;
            state.code[fix.at + 2] = num_floor(encoded / 16);
        } elif fix.kind == "jump" {
            if delta < -131072 or delta > 131071 { throw "xtensa-lx6: jump is out of range"; }
            let encoded = _signed(delta, 18);
            state.code[fix.at] = 0x06 + num_mod(encoded, 4) * 64;
            state.code[fix.at + 1] = num_mod(num_floor(encoded / 4), 256);
            state.code[fix.at + 2] = num_floor(encoded / 1024);
        } else { throw "xtensa-lx6: unknown fixup"; }
    }
    let out = []; _append(out, state.code); return out;
}

export FORMAT, MAX_CODE_BYTES;
export l32r, l32i_n, s32i_n, l32i, s32i, l8ui, s8i, movi, addi_n;
export add_regs, sub_regs, xor_regs, or_regs, and_regs, move, extui, memw;
export assembler, emit, label, unique, branch_nonzero, jump, finish;
