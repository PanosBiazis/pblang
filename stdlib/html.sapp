// stdlib/html.sapp — HTML generation and escaping helpers
//
// Usage:
//   let html = import("stdlib:html.sapp");
//   print html.tag("h1", "Hello World");
//   print html.escape("<script>alert('xss')</script>");
//   print html.page("My Site", body_content);

// escape(text) → HTML-safe text (escapes <>&"')
fn escape(text) {
    let s = str(text);
    s = regex_replace_all(s, "&", "&amp;");
    s = regex_replace_all(s, "<", "&lt;");
    s = regex_replace_all(s, ">", "&gt;");
    s = regex_replace_all(s, "\"", "&quot;");
    s = regex_replace_all(s, "'", "&#39;");
    return s;
}

// unescape(text) → decode HTML entities
fn unescape(text) {
    let s = str(text);
    s = regex_replace_all(s, "&amp;",  "&");
    s = regex_replace_all(s, "&lt;",   "<");
    s = regex_replace_all(s, "&gt;",   ">");
    s = regex_replace_all(s, "&quot;", "\"");
    s = regex_replace_all(s, "&#39;",  "'");
    return s;
}

// attrs(map) → attribute string ' key="value"...'
fn attrs(a) {
    if a == nil { return ""; }
    let result = "";
    let ks = map_keys(a);
    let i = 0;
    while i < len(ks) {
        result = result + " " + ks[i] + "=\"" + escape(str(a[ks[i]])) + "\"";
        i = i + 1;
    }
    return result;
}

// tag(name, content, attributes) → <name attr>content</name>
fn tag(name, content, attributes) {
    return "<" + name + attrs(attributes) + ">" + str(content ?? "") + "</" + name + ">";
}

// self_closing(name, attributes) → <name attr />
fn self_closing(name, attributes) {
    return "<" + name + attrs(attributes) + " />";
}

// a(href, text, attrs_map) → anchor tag
fn a(href, text, attrs_map) {
    let a_map = attrs_map ?? map{};
    a_map["href"] = href;
    return tag("a", text, a_map);
}

// img(src, alt, attrs_map) → img tag
fn img(src, alt, attrs_map) {
    let i_map = attrs_map ?? map{};
    i_map["src"] = src;
    i_map["alt"] = alt ?? "";
    return self_closing("img", i_map);
}

// ul(items) → unordered list
fn ul(items) {
    let result = "<ul>";
    let i = 0;
    while i < len(items) {
        result = result + "<li>" + str(items[i]) + "</li>";
        i = i + 1;
    }
    return result + "</ul>";
}

// ol(items) → ordered list
fn ol(items) {
    let result = "<ol>";
    let i = 0;
    while i < len(items) {
        result = result + "<li>" + str(items[i]) + "</li>";
        i = i + 1;
    }
    return result + "</ol>";
}

// table(headers, rows) → HTML table
fn table(headers, rows) {
    let result = "<table>";
    // Header
    if headers != nil and len(headers) > 0 {
        result = result + "<thead><tr>";
        let i = 0;
        while i < len(headers) {
            result = result + "<th>" + escape(str(headers[i])) + "</th>";
            i = i + 1;
        }
        result = result + "</tr></thead>";
    }
    // Body
    result = result + "<tbody>";
    let r = 0;
    while r < len(rows) {
        result = result + "<tr>";
        let c = 0;
        while c < len(rows[r]) {
            result = result + "<td>" + escape(str(rows[r][c])) + "</td>";
            c = c + 1;
        }
        result = result + "</tr>";
        r = r + 1;
    }
    result = result + "</tbody></table>";
    return result;
}

// page(title, body, head_extra) → full HTML page
fn page(title, body, head_extra) {
    let extra = head_extra ?? "";
    return "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>" + escape(title) + "</title>\n" + extra + "</head>\n<body>\n" + body + "\n</body>\n</html>";
}

// form(action, method, fields) → HTML form
fn form(action, method, fields) {
    let m = method ?? "POST";
    let result = "<form action=\"" + escape(action) + "\" method=\"" + m + "\">\n";
    let i = 0;
    while i < len(fields) {
        let f = fields[i];
        let ftype = f["type"] ?? "text";
        let fname = f["name"] ?? "";
        let fval = f["value"] ?? "";
        let flabel = f["label"] ?? fname;
        result = result + "  <label>" + escape(flabel) + ": ";
        result = result + "<input type=\"" + escape(ftype) + "\" name=\"" + escape(fname) + "\" value=\"" + escape(str(fval)) + "\"></label>\n";
        i = i + 1;
    }
    result = result + "  <button type=\"submit\">Submit</button>\n</form>";
    return result;
}

export escape, unescape, attrs, tag, self_closing, a, img, ul, ol, table, page, form;
