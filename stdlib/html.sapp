// stdlib/html.sapp — HTML generation and escaping helpers
//
// Usage:
//   let html = import("stdlib:html.sapp");
//   print html.tag("h1", "Hello World");
//   print html.escape("<script>alert('xss')</script>");
//   print html.page("My Site", body_content);

// escape(text) → HTML-safe text (escapes <>&"')
fn _replace_literal(text, needle, replacement) {
    return str_join(str_split(text, needle), replacement);
}

fn escape(text) {
    let s = str(text);
    s = _replace_literal(s, "&", "&amp;");
    s = _replace_literal(s, "<", "&lt;");
    s = _replace_literal(s, ">", "&gt;");
    s = _replace_literal(s, "\"", "&quot;");
    s = _replace_literal(s, "'", "&#39;");
    return s;
}

// unescape(text) → decode HTML entities. &amp; MUST be decoded LAST so a literal
// entity like "&amp;lt;" round-trips to "&lt;" instead of double-decoding to "<".
fn unescape(text) {
    let s = str(text);
    s = _replace_literal(s, "&lt;",   "<");
    s = _replace_literal(s, "&gt;",   ">");
    s = _replace_literal(s, "&quot;", "\"");
    s = _replace_literal(s, "&#39;",  "'");
    s = _replace_literal(s, "&amp;",  "&");
    return s;
}

// strip_tags(text) → remove all HTML tags (leaves the text content).
fn strip_tags(text) { return regex_replace_all(str(text), "<[^>]*>", ""); }

// attrs(map) → attribute string ' key="value"...'
fn attrs(a) {
    if a == nil { return ""; }
    let result = [];
    let ks = map_keys(a);
    let i = 0;
    while i < len(ks) {
        array_push(result, " ");
        array_push(result, ks[i]);
        array_push(result, "=\"");
        array_push(result, escape(str(a[ks[i]])));
        array_push(result, "\"");
        i = i + 1;
    }
    return str_join(result, "");
}

// tag(name, content, attributes) → <name attr>content</name>
fn tag(name, content, attributes) {
    return str_join(["<", name, attrs(attributes), ">", str(content ?? ""), "</", name, ">"], "");
}

// self_closing(name, attributes) → <name attr />
fn self_closing(name, attributes) {
    return str_join(["<", name, attrs(attributes), " />"], "");
}

// SECURITY: dangerous URL schemes that execute script when a link/image is used.
let _BAD_SCHEMES = ["javascript", "data", "vbscript"];

// safe_url(url) → the URL if its scheme is safe, else "#". Escaping alone does NOT
// neutralize a "javascript:" href (it is valid HTML), so URLs in link/image
// attributes must be scheme-checked. Inner whitespace/control chars are skipped
// while reading the scheme to defeat "java\tscript:" style obfuscation.
fn safe_url(url) {
    let t = str_trim(str(url));
    let low = str_lower(t);
    let scheme = "";
    let i = 0;
    let n = len(low);
    let found_colon = false;
    let done = false;
    while i < n and not done {
        let code = strcharcodeat(low, i);
        if code <= 32 {
            // skip whitespace / control characters inside the scheme
        } else if low[i] == ":" {
            found_colon = true;
            done = true;
        } else if (code >= 97 and code <= 122) or (code >= 48 and code <= 57)
                  or low[i] == "+" or low[i] == "-" or low[i] == "." {
            scheme = scheme + low[i];
        } else {
            // a path/query/fragment char before any ':' → relative URL → safe
            done = true;
        }
        i = i + 1;
    }
    if found_colon {
        let j = 0;
        while j < len(_BAD_SCHEMES) {
            if scheme == _BAD_SCHEMES[j] { return "#"; }
            j = j + 1;
        }
    }
    return t;
}

// a(href, text, attrs_map) → anchor tag (href is scheme-sanitized against XSS).
fn a(href, text, attrs_map) {
    let a_map = attrs_map ?? map{};
    a_map["href"] = safe_url(href);
    return tag("a", text, a_map);
}

// img(src, alt, attrs_map) → img tag
fn img(src, alt, attrs_map) {
    let i_map = attrs_map ?? map{};
    i_map["src"] = safe_url(src);
    i_map["alt"] = alt ?? "";
    return self_closing("img", i_map);
}

// ul(items) → unordered list
fn ul(items) {
    let result = ["<ul>"];
    let i = 0;
    while i < len(items) {
        array_push(result, "<li>");
        array_push(result, str(items[i]));
        array_push(result, "</li>");
        i = i + 1;
    }
    array_push(result, "</ul>");
    return str_join(result, "");
}

// ol(items) → ordered list
fn ol(items) {
    let result = ["<ol>"];
    let i = 0;
    while i < len(items) {
        array_push(result, "<li>");
        array_push(result, str(items[i]));
        array_push(result, "</li>");
        i = i + 1;
    }
    array_push(result, "</ol>");
    return str_join(result, "");
}

// table(headers, rows) → HTML table
fn table(headers, rows) {
    let result = ["<table>"];
    // Header
    if headers != nil and len(headers) > 0 {
        array_push(result, "<thead><tr>");
        let i = 0;
        while i < len(headers) {
            array_push(result, "<th>");
            array_push(result, escape(str(headers[i])));
            array_push(result, "</th>");
            i = i + 1;
        }
        array_push(result, "</tr></thead>");
    }
    // Body
    array_push(result, "<tbody>");
    let r = 0;
    while r < len(rows) {
        array_push(result, "<tr>");
        let c = 0;
        while c < len(rows[r]) {
            array_push(result, "<td>");
            array_push(result, escape(str(rows[r][c])));
            array_push(result, "</td>");
            c = c + 1;
        }
        array_push(result, "</tr>");
        r = r + 1;
    }
    array_push(result, "</tbody></table>");
    return str_join(result, "");
}

// page(title, body, head_extra) → full HTML page
fn page(title, body, head_extra) {
    let extra = head_extra ?? "";
    return str_join(["<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>", escape(title), "</title>\n", extra, "</head>\n<body>\n", str(body), "\n</body>\n</html>"], "");
}

// form(action, method, fields) → HTML form
fn form(action, method, fields) {
    let m = method ?? "POST";
    let result = ["<form action=\"", escape(action), "\" method=\"", escape(m), "\">\n"];
    let i = 0;
    while i < len(fields) {
        let f = fields[i];
        let ftype = f["type"] ?? "text";
        let fname = f["name"] ?? "";
        let fval = f["value"] ?? "";
        let flabel = f["label"] ?? fname;
        array_push(result, "  <label>");
        array_push(result, escape(flabel));
        array_push(result, ": <input type=\"");
        array_push(result, escape(ftype));
        array_push(result, "\" name=\"");
        array_push(result, escape(fname));
        array_push(result, "\" value=\"");
        array_push(result, escape(str(fval)));
        array_push(result, "\"></label>\n");
        i = i + 1;
    }
    array_push(result, "  <button type=\"submit\">Submit</button>\n</form>");
    return str_join(result, "");
}

// Convenience element builders.
fn div(content, attributes) { return tag("div", content, attributes); }
fn span(content, attributes) { return tag("span", content, attributes); }
fn p(content, attributes) { return tag("p", content, attributes); }
fn br() { return "<br />"; }

// ── wave 2: text/structure builders ──────────────────────────────────────────────

// nl2br(text) → escaped text with newlines turned into <br /> elements.
fn nl2br(text) { return regex_replace_all(escape(text), "\n", "<br />"); }

// heading(level, content, attrs) → <hN>…</hN> with the level clamped to 1..6.
fn heading(level, content, attributes) {
    let lv = num_floor(level);
    if lv < 1 { lv = 1; }
    if lv > 6 { lv = 6; }
    return tag("h" + str(lv), content, attributes);
}

// option(value, label, selected) → a single <option> (selected adds the attribute).
fn option(value, label, selected) {
    let sel = "";
    if selected { sel = " selected"; }
    return "<option value=\"" + escape(str(value)) + "\"" + sel + ">" + escape(str(label)) + "</option>";
}

// select(name, options) → a <select>; options is an array of maps with value/label
// and an optional `selected` flag.
fn select(name, options) {
    let r = ["<select name=\"", escape(str(name)), "\">"];
    let i = 0;
    while i < len(options) {
        let o = options[i];
        let v = o["value"] ?? "";
        let lbl = o["label"] ?? v;
        let s = false;
        if map_has(o, "selected") { s = o["selected"]; }
        array_push(r, option(v, lbl, s));
        i = i + 1;
    }
    array_push(r, "</select>");
    return str_join(r, "");
}

export escape, unescape, strip_tags, attrs, tag, self_closing, a, img, ul, ol, table, page, form,
       div, span, p, br, safe_url, nl2br, heading, option, select;
