// stdlib/llm_quant.sapp -- efficient inference helpers and quantized matvec.

fn quantize_vec(v, bits) {
    let max_abs = 0.0;
    let i = 0;
    while i < len(v) {
        let a = v[i];
        if a < 0 { a = 0.0 - a; }
        if a > max_abs { max_abs = a; }
        i = i + 1;
    }
    if max_abs == 0 { max_abs = 1.0; }
    let qmax = 127.0;
    if bits == 4 { qmax = 7.0; }
    let scale = max_abs / qmax;
    let q = [];
    let j = 0;
    while j < len(v) {
        push(q, num_floor(v[j] / scale));
        j = j + 1;
    }
    return map{ format: "pblang.llm.qvec.v1", bits: bits, scale: scale, values: q };
}

fn dequantize_vec(qv) {
    let out = [];
    let i = 0;
    while i < len(qv.values) {
        push(out, qv.values[i] * qv.scale);
        i = i + 1;
    }
    return out;
}

fn quantize_matrix_rows(m, bits) {
    let rows = [];
    let i = 0;
    while i < len(m) {
        push(rows, quantize_vec(m[i], bits));
        i = i + 1;
    }
    return map{ format: "pblang.llm.qmatrix.rows.v1", bits: bits, rows: rows, shape: [len(m), len(m[0])] };
}

fn qmat_vecmat(v, qm) {
    let cols = qm.shape[1];
    let out = [];
    let c = 0;
    while c < cols {
        let s = 0.0;
        let r = 0;
        while r < len(v) {
            s = s + v[r] * qm.rows[r].values[c] * qm.rows[r].scale;
            r = r + 1;
        }
        push(out, s);
        c = c + 1;
    }
    return out;
}

fn quantize_lm_head(model, bits) {
    return map{
        format: "pblang.llm.quantized_lm_head.v1",
        bits: bits,
        lm_head: quantize_matrix_rows(model.lm_head, bits),
        lm_bias: model.lm_bias
    };
}

fn logits_q(hidden, qhead) {
    let out = qmat_vecmat(hidden, qhead.lm_head);
    let i = 0;
    while i < len(out) {
        out[i] = out[i] + qhead.lm_bias[i];
        i = i + 1;
    }
    return out;
}

export quantize_vec, dequantize_vec, quantize_matrix_rows, qmat_vecmat;
export quantize_lm_head, logits_q;
