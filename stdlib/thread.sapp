// stdlib/thread.sapp — Enhanced thread, channel, and sync utilities.
//
// Wraps and extends VM builtins:
//   spawn, join, join_all, spawn_n
//   channel, channel_buffered, channel_size
//   send, recv, recv_timeout
//   channel_close, channel_is_closed
//   select, select_with_timeout
//   ticker, timeout_channel
//   mutex_new/lock/try_lock/unlock
//   rwlock_new/read/write/unlock
//   barrier_new/wait
//   once_new/is_done
//   atomic_new/get/set/add/sub/cas/swap
//
// Inspired by: Go (goroutines, channels, sync), Kotlin (coroutines patterns),
//              Rust (Arc<Mutex<T>>, RwLock, Barrier, Once, AtomicUsize),
//              Java (CompletableFuture, CyclicBarrier, AtomicInteger),
//              Erlang (actor model), Haskell (STM concepts).

// ─────────────────────────────────────────────────────────────────────────────
// 1. CORE SPAWN/JOIN
// ─────────────────────────────────────────────────────────────────────────────

// Structured-concurrency cleanup helpers: no imports or background workers.
fn _scope_body(body, scope_obj) {
    body(scope_obj);
    return true;
}

fn _scope_settle_remaining(handles) {
    // Discard results one at a time on failure instead of retaining an array
    // whose values can never be returned to the caller.
    if type(handles) == "array" {
        for handle in handles { try join(handle) catch nil; }
    }
}

fn _scope_join_failed(handles, message) {
    // Native join_all can abort on an invalid/already-consumed handle.
    // Retry every handle independently so later workers are not abandoned.
    _scope_settle_remaining(handles);
    throw message;
}

fn _scope_join_owned(handles) {
    // Preserve ordered values/error maps without a success-envelope allocation.
    return try join_all(handles) catch _scope_join_failed(handles, "thread.join_all: join failed");
}

fn _scope_run(body) {
    let state = map{open:true, handles:[]};
    let scope_obj = map{
        launch:fn(_self, worker) {
            if not state.open { throw "thread.scope: scope is closed"; }
            let handle = spawn(worker);
            array_push(state.handles, handle);
            return handle;
        }
    };
    // Catch binds no error value in this host. Report a stable body error after
    // cleanup; do not use defer, which does not run on a throw here.
    let completed = try _scope_body(body, scope_obj) catch false;
    state.open = false;
    if not completed {
        _scope_settle_remaining(state.handles);
        state.handles = [];
        throw "thread.scope: body failed";
    }
    // Transfer ownership to this stack frame before joining. An escaped launch
    // closure is already closed and must not retain handles on either outcome.
    let handles = state.handles;
    state.handles = [];
    return try join_all(handles) catch _scope_join_failed(handles, "thread.scope: join failed");
}


// spawn(fn) → handle — spawn a thread running fn().
fn thread_spawn(fn_val) { return spawn(fn_val); }

// join(handle) → value — wait for a thread to finish, return its return value.
fn thread_join(handle) { return join(handle); }

// join_all(handles_array) → [values] — join all handles, collect results in order.
// Like Go's WaitGroup.Wait() + result collection, or Java's CompletableFuture.allOf().
fn thread_join_all(handles) {
    return _scope_join_owned(handles);
}

// spawn_n(n, fn) → [handles] — spawn n identical threads.
// Like Go's `for i := 0; i < n; i++ { go fn() }`.
fn thread_spawn_n(n, fn_val) { return spawn_n(n, fn_val); }

// ─────────────────────────────────────────────────────────────────────────────
// 2. CHANNELS — unbounded, buffered, timeout
// ─────────────────────────────────────────────────────────────────────────────

// channel_new() → {sender, receiver} — unbounded channel (Go `make(chan T)` with large buffer).
fn channel_new() { return channel(); }

// channel_new_buffered(cap) → {sender, receiver, capacity} — buffered channel (Go `make(chan T, n)`).
fn channel_new_buffered(cap) { return channel_buffered(cap); }

// send_value(sender, val) — send a value.
fn send_value(sender, val) { return send(sender, val); }

// recv_value(receiver) → value | nil — blocking recv (nil = channel closed).
fn recv_value(receiver) { return recv(receiver); }

// recv_or_timeout(receiver, ms) → value | nil — recv with timeout. nil = closed or timed out.
fn recv_or_timeout(receiver, ms) { return recv_timeout(receiver, ms); }

fn _resolve_sender(ch_or_sender) {
    if type(ch_or_sender) == "map" {
        let has_sender = try map_has(ch_or_sender, "sender") catch false;
        if has_sender { return ch_or_sender.sender; }
    }
    return ch_or_sender;
}

// channel_close_sender(ch) — close the sender end; waiting recvs return nil.
fn channel_close_sender(ch) { return channel_close(_resolve_sender(ch)); }

// channel_is_done(ch) — true if the channel's sender was closed.
fn channel_is_done(ch) { return channel_is_closed(_resolve_sender(ch)); }

// channel_len(ch) — number of items currently buffered.
fn channel_len(ch) { return channel_size(ch.receiver); }

// drain(ch) → [values] — read all available values without blocking.
fn drain(ch) {
    let result = [];
    while true {
        let v = recv_timeout(ch.receiver, 0);
        if v == nil { return result; }
        array_push(result, v);
    }
    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. SELECT — non-blocking, timeout, Go-style
// ─────────────────────────────────────────────────────────────────────────────

// select_ready(receivers_array) → {index, value} | nil — block until one is ready.
fn select_ready(receivers) { return select(receivers); }

// select_timeout(receivers_array, ms) → {index, value, timed_out} | nil.
// timed_out==true means no channel was ready within ms milliseconds.
fn select_timeout(receivers, ms) { return select_with_timeout(receivers, ms); }

// select_nonblocking(receivers_array) → {index, value} | nil — returns nil immediately if none ready.
// The underlying `select_with_timeout(receivers, 0)` builtin returns
// `map{timed_out: true}` on timeout; we normalize that to `nil` so
// callers can branch on `res == nil` per the docstring contract.
fn select_nonblocking(receivers) {
    let r = select_with_timeout(receivers, 0);
    if type(r) == "map" and map_has(r, "timed_out") and r.timed_out == true {
        return nil;
    }
    return r;
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. TIMERS AND TICKERS
// ─────────────────────────────────────────────────────────────────────────────

// after(ms) → channel — fires once after ms milliseconds (like Go's time.After).
fn after(ms) { return timeout_channel(ms); }

// tick(interval_ms) → channel — fires every interval_ms (like Go's time.Tick).
// Stop by closing the channel: channel_close(t.sender).
fn tick(interval_ms) { return ticker(interval_ms); }

// sleep_ms wrapper
fn sleep(ms) { sleep_ms(ms); }

// ─────────────────────────────────────────────────────────────────────────────
// 5. MUTEX — mutual exclusion (Go sync.Mutex / Rust Mutex<T>)
// ─────────────────────────────────────────────────────────────────────────────

// mutex() → handle — create a mutex.
fn mutex() { return mutex_new(); }

// with_mutex(m, fn) → fn() result — lock, run fn, unlock (RAII pattern).
// Like Rust's MutexGuard or Go's defer mu.Unlock().
fn with_mutex(m, fn_val) {
    mutex_lock(m);
    // Capture success/failure as a value (pblang's `catch` does not bind the error and
    // `defer` does not run on throw, so this is how we guarantee the unlock runs while
    // still not swallowing the failure).
    let outcome = try { map{ ok: true, value: fn_val() } } catch map{ ok: false };
    mutex_unlock(m);   // always release, success or failure
    if not outcome.ok {
        // Don't silently return nil on failure; surface it. Callers that need the
        // specific error should use try_with_mutex, which returns {ok, error}.
        throw "with_mutex: error in critical section (use try_with_mutex to inspect)";
    }
    return outcome.value;
}

// try_with_mutex(m, fn) → {ok, value} | {ok:false,error} — non-blocking version.
fn try_with_mutex(m, fn_val) {
    if mutex_try_lock(m) == false {
        return map{ ok: false, error: "mutex busy" };
    }
    let outcome = try { map{ ok: true, value: fn_val() } } catch map{ ok: false };
    mutex_unlock(m);   // always release the lock we acquired
    if not outcome.ok {
        return map{ ok: false, error: "error in critical section" };
    }
    return map{ ok: true, value: outcome.value };
}

// ─────────────────────────────────────────────────────────────────────────────
// 6. RWLOCK — read-write lock (Go sync.RWMutex / Rust RwLock<T>)
// ─────────────────────────────────────────────────────────────────────────────

// rwlock() → handle — create a read-write lock.
fn rwlock() { return rwlock_new(); }

// with_read(rw, fn) → result — acquire read lock, run fn, release.
fn with_read(rw, fn_val) {
    rwlock_read(rw);
    // pblang's catch binds no name — `catch err_val { ... }` mis-parses and
    // used to let the throw ESCAPE with the lock still held. Swallow to nil
    // and unlock on every path.
    let result = try fn_val() catch nil;
    rwlock_unlock(rw);
    return result;
}

// with_write(rw, fn) → result — acquire write lock, run fn, release.
fn with_write(rw, fn_val) {
    rwlock_write(rw);
    let result = try fn_val() catch nil;   // see with_read: unlock on every path
    rwlock_unlock(rw);
    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// 7. WAIT GROUP (Go sync.WaitGroup pattern)
// ─────────────────────────────────────────────────────────────────────────────

// wait_group(n) → WaitGroup map — synchronize n goroutines.
// Usage:
//   let wg = thread.wait_group(3);
//   spawn(fn() { ...; thread.wg_done(wg); });
//   spawn(fn() { ...; thread.wg_done(wg); });
//   spawn(fn() { ...; thread.wg_done(wg); });
//   thread.wg_wait(wg);
fn wait_group(n) {
    let counter = atomic_new(n);
    let done_ch = channel_new_buffered(1); // fires when counter hits 0
    return map{
        __counter: counter,
        __done_ch: done_ch,
        __total: n
    };
}

// wg_done(wg) — decrement counter; signal when all are done.
fn wg_done(wg) {
    let remaining = atomic_sub(wg.__counter, 1);
    if remaining <= 0 {
        // Signal completion (non-blocking, buffered channel of 1)
        let is_closed = channel_is_closed(wg.__done_ch.sender);
        if is_closed == false {
            send(wg.__done_ch.sender, true);
            channel_close(wg.__done_ch.sender);
        }
    }
}

// wg_wait(wg) — block until all workers have called wg_done.
fn wg_wait(wg) {
    let current = atomic_get(wg.__counter);
    if current <= 0 { return; }
    recv(wg.__done_ch.receiver);
}

// wg_wait_timeout(wg, ms) → bool — true if all done, false if timed out.
fn wg_wait_timeout(wg, ms) {
    let current = atomic_get(wg.__counter);
    if current <= 0 { return true; }
    let v = recv_timeout(wg.__done_ch.receiver, ms);
    return v != nil;
}

// ─────────────────────────────────────────────────────────────────────────────
// 8. BARRIER — rendezvous point for N threads
// ─────────────────────────────────────────────────────────────────────────────

// barrier(n) → handle — create a CyclicBarrier for n threads.
fn barrier(n) { return barrier_new(n); }

// barrier_arrive(b) → bool — arrive at barrier; blocks until all n threads arrive.
// Returns true for the thread that triggered the release; false for the others.
fn barrier_arrive(b) { return barrier_wait(b); }

// ─────────────────────────────────────────────────────────────────────────────
// 9. ONCE — execute exactly once (Go sync.Once / Kotlin lazy / Rust Once)
// ─────────────────────────────────────────────────────────────────────────────

// once() → handle — create a Once. The init function runs at most once.
fn once() { return once_new(); }

// once_do(handle, fn, args_ch) — run fn() exactly once, even if called from multiple threads.
// Uses an atomic + barrier pattern:
//   - first caller: executes fn, signals done
//   - later callers: wait until done, then return
// NOTE: fn return value is sent on args_ch; pass a buffered(1) channel for it.
// Simplified version that works for single-threaded "lazy init" use case:
fn once_do_lazy(init_fn) {
    // Returns a closure that memoizes the result of init_fn() (lazy init pattern)
    let done = false;
    let result = nil;
    return fn() {
        if done == false {
            result = init_fn();
            done = true;
        }
        return result;
    };
}

// ─────────────────────────────────────────────────────────────────────────────
// 10. ATOMICS — lock-free counters (Rust AtomicUsize / Java AtomicInteger / Go atomic)
// ─────────────────────────────────────────────────────────────────────────────

// atomic(init) → handle — create an atomic integer.
fn atomic(init = nil) {
    if init == nil { init = 0; }
    return atomic_new(init);
}

// atomic_inc(a) → new_val — increment by 1.
fn atomic_inc(a) { return atomic_add(a, 1); }

// atomic_dec(a) → new_val — decrement by 1.
fn atomic_dec(a) { return atomic_sub(a, 1); }

// Capture the builtins before defining same-named wrappers (the `let` binds the
// builtin; the later `fn` shadows the name without recursing).
let _builtin_atomic_get = atomic_get;
let _builtin_atomic_set = atomic_set;
let _builtin_atomic_cas = atomic_cas;
let _builtin_atomic_add = atomic_add;

// atomic_get(a) → value — read the current value.
fn atomic_get(a) { return _builtin_atomic_get(a); }
// atomic_set(a, v) — store a new value.
fn atomic_set(a, v) { return _builtin_atomic_set(a, v); }
// atomic_add(a, n) → new_val — atomically add n (n may be negative).
fn atomic_add(a, n) { return _builtin_atomic_add(a, n); }
// atomic_cas(a, expected, new_val) → bool — compare-and-swap; true if it swapped.
fn atomic_cas(a, expected, new_val) { return _builtin_atomic_cas(a, expected, new_val); }

// ─────────────────────────────────────────────────────────────────────────────
// 11. SEMAPHORE — Go's semaphore / Java Semaphore pattern
// ─────────────────────────────────────────────────────────────────────────────

// semaphore(n) → Semaphore — counting semaphore allowing n concurrent holders.
// Like Go's semaphore.Weighted(n) or Java's Semaphore(n).
fn semaphore(n) {
    let ch = channel_new_buffered(n);
    // Fill with n tokens
    let i = 0;
    while i < n {
        send(ch.sender, true);
        i = i + 1;
    }
    return map{ __ch: ch, __capacity: n };
}

// sem_acquire(s) — acquire one permit (blocks if none available).
fn sem_acquire(s) {
    recv(s.__ch.receiver); // takes one token
}

// sem_try_acquire(s) → bool — non-blocking acquire.
fn sem_try_acquire(s) {
    let v = recv_timeout(s.__ch.receiver, 0);
    return v != nil;
}

// sem_release(s) — release one permit.
fn sem_release(s) {
    send(s.__ch.sender, true);
}

// with_semaphore(s, fn) → result — RAII acquire+run+release.
fn with_semaphore(s, fn_val) {
    sem_acquire(s);
    let result = try fn_val() catch nil;   // see with_read: release on every path
    sem_release(s);
    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// 12. THREAD POOL
// ─────────────────────────────────────────────────────────────────────────────

// Keep worker globals small; load only for nonempty pools.
let _POOL_WORKER = nil;

// Results remain in completion order. Nil/zero/negative worker counts retain
// the legacy one-worker fallback; fractional/non-finite counts are rejected.
fn thread_pool(n_workers, tasks_array, worker_fn) {
    if n_workers == nil { n_workers = 1; }
    if not is_number(n_workers) { throw "thread.thread_pool: expected numeric worker count"; }
    if n_workers - n_workers != 0 { throw "thread.thread_pool: worker count must be finite"; }
    if n_workers <= 0 { n_workers = 1; }
    if n_workers != num_floor(n_workers) { throw "thread.thread_pool: worker count must be whole"; }
    let n = len(tasks_array);
    if n == 0 { return []; }
    if n_workers > n { n_workers = n; }
    if _POOL_WORKER == nil { _POOL_WORKER = import("stdlib:thread_pool_worker.sapp"); }
    return _POOL_WORKER.run(n_workers, tasks_array, worker_fn);
}

// ─────────────────────────────────────────────────────────────────────────────
// 13. PIPELINE — lazy functional pipelines (synchronous)
//
// NOTE: pblang cannot serialize closures across thread boundaries, so pipelines
// are evaluated lazily/synchronously when pipeline_collect() is called.
// Each stage records its transform; collection applies them in sequence.
// ─────────────────────────────────────────────────────────────────────────────

// pipeline_source(items_array) → pipeline — start a pipeline from an array.
fn pipeline_source(items) {
    return map{ __data: items, __transforms: [] };
}

// pipeline_stage(pipe, transform_fn) → new_pipe — add a transform stage.
// transform_fn(x) → new_x | nil (nil filters out the element).
fn pipeline_stage(pipe, transform_fn) {
    let transforms = [];
    if map_has(pipe, "__transforms") {
        let i = 0;
        while i < len(pipe.__transforms) {
            array_push(transforms, pipe.__transforms[i]);
            i = i + 1;
        }
    }
    array_push(transforms, transform_fn);
    return map{ __data: pipe.__data, __transforms: transforms };
}

// pipeline_collect(pipe) → [values] — apply all stages and return results.
fn pipeline_collect(pipe) {
    let result = pipe.__data;
    let i = 0;
    while i < len(pipe.__transforms) {
        let tf = pipe.__transforms[i];
        let new_result = [];
        let j = 0;
        while j < len(result) {
            let v = tf(result[j]);
            if v != nil { array_push(new_result, v); }
            j = j + 1;
        }
        result = new_result;
        i = i + 1;
    }
    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// 14. FAN-OUT / FAN-IN
// ─────────────────────────────────────────────────────────────────────────────

// fan_out(source_ch, n) → [channels] — distribute source items to n output channels round-robin.
fn fan_out(source_ch, n) {
    let outs = [];
    let i = 0;
    while i < n { array_push(outs, channel_new()); i = i + 1; }
    let out_senders = [];
    let j = 0;
    while j < n { array_push(out_senders, outs[j].sender); j = j + 1; }

    let fo_worker = fn() {
        let idx = 0;
        let v = recv(source_ch.receiver);
        while v != nil {
            send(out_senders[idx], v);
            idx = (idx + 1) - num_floor((idx + 1) / n) * n; // idx = (idx+1) % n
            v = recv(source_ch.receiver);
        }
        let k = 0;
        while k < n { channel_close(out_senders[k]); k = k + 1; }
    };
    spawn(fo_worker);
    return outs;
}

// fan_in(channels_array) → merged_channel — merge N channels into one.
fn fan_in(channels) {
    let out = channel_new();
    let active = atomic_new(len(channels));

    let i = 0;
    while i < len(channels) {
        let ch_i = channels[i];
        let out_s = out.sender;
        let active_ref = active;
        let reader = fn() {
            let v = recv(ch_i.receiver);
            while v != nil {
                send(out_s, v);
                v = recv(ch_i.receiver);
            }
            let remaining = atomic_sub(active_ref, 1);
            if remaining <= 0 { channel_close(out_s); }
        };
        spawn(reader);
        i = i + 1;
    }
    return out;
}

// ─────────────────────────────────────────────────────────────────────────────
// 15. ACTOR MODEL (Erlang-style)
// ─────────────────────────────────────────────────────────────────────────────

// actor(initial_state, handler_fn) → actor_ref map.
//   handler_fn(state, message) → new_state
//   Messages are processed synchronously (inline) when send() is called.
//   This is the safe approach in pblang since closures can't cross thread boundaries.
//   For concurrent actors, use spawn() + channels + factory patterns manually.
//
// actor_ref: { send: fn(msg), stop: fn(), get_result: fn() }
fn actor(initial_state, handler_fn) {
    let state = initial_state;
    let stopped = false;
    return map{
        send: fn(msg) {
            if stopped { return nil; }
            state = handler_fn(state, msg);
        },
        stop: fn() {
            stopped = true;
        },
        get_result: fn() {
            return state;
        }
    };
}

// actor_send(actor_ref, msg) — send a message to an actor.
fn actor_send(actor_ref, msg) { actor_ref.send(msg); }

// actor_stop(actor_ref) — stop the actor loop.
fn actor_stop(actor_ref) { actor_ref.stop(); }

// actor_get_result(actor_ref) — wait for actor to stop and return final state.
fn actor_get_result(actor_ref) { return actor_ref.get_result(); }

// ─────────────────────────────────────────────────────────────────────────────
// 16. PROMISE / FUTURE (Kotlin Deferred / Java CompletableFuture)
//
// promise() stays eager in the current VM. go() uses the same minimal worker
// boundary as async.go, with copied supported captures and terminal envelopes.
// Futures are owned by their creating VM; do not consume their internal channel.
// ─────────────────────────────────────────────────────────────────────────────

// promise(fn) → Promise — eagerly evaluate fn() and wrap the result.
fn promise(fn_val) {
    let val = fn_val();   // evaluate NOW in the current thread
    return map{ __value: val, __done: true };
}

// Load only when go is used, so channel/pool-only callers do not import it.
// Its worker does not snapshot all globals/closures in this thread module.
let _GO_WORKER = nil;

// go(fn) → Future — run a self-contained task with supported copied captures.
// Keep the thread API's failure-as-nil contract; use async for distinct errors.
fn go(fn_val) {
    if _GO_WORKER == nil { _GO_WORKER = import("stdlib:async_worker.sapp"); }
    let future = _GO_WORKER.launch(fn_val);
    return map{ __go: true, __ch: future.channel, __handle: future.worker,
                __value: nil, __resolved: false };
}

fn _is_go(p) { return (try p.__go catch false) == true; }

fn _go_settle(p, msg) {
    let joined = try { join(p.__handle); true } catch false;
    // recv has a host wait limit; recover a late result after joining.
    if msg == nil and joined { msg = recv_timeout(p.__ch.receiver, 0); }
    p.__value = if joined and msg != nil and msg.ok == true { msg.value } else { nil };
    p.__resolved = true;
    channel_close(p.__ch.sender);
    return p.__value;
}

// await(future) → value — cached after completion, including nil and failure.
fn await(p) {
    if _is_go(p) and not p.__resolved {
        return _go_settle(p, recv(p.__ch.receiver));
    }
    return p.__value;
}

// await_timeout(future, ms) → {ok, value}. Here ok means completed, not
// successful: task failures still resolve to nil for backward compatibility.
// A timeout does not cancel the worker; the caller retains and settles it.
fn await_timeout(p, ms) {
    if _is_go(p) and not p.__resolved {
        let msg = recv_timeout(p.__ch.receiver, ms);
        if msg == nil and not channel_is_closed(p.__ch.receiver) {
            return map{ ok: false, value: nil };
        }
        _go_settle(p, msg);
    }
    return map{ ok: true, value: p.__value };
}

// try_await remains ambiguous for nil; use is_ready to distinguish completion.
fn try_await(p) {
    if _is_go(p) and not p.__resolved {
        let msg = recv_timeout(p.__ch.receiver, 0);
        if msg == nil and not channel_is_closed(p.__ch.receiver) { return nil; }
        _go_settle(p, msg);
    }
    return p.__value;
}

// is_ready may harvest one terminal result and join its worker. It never
// discards a legitimate nil result. Join can include runtime teardown time.
fn is_ready(p) {
    if _is_go(p) {
        if not p.__resolved { try_await(p); }
        return p.__resolved;
    }
    return p.__done;
}

// ─────────────────────────────────────────────────────────────────────────────
// 17. RATE LIMITER (token bucket pattern)
// ─────────────────────────────────────────────────────────────────────────────

// rate_limiter(n_per_second) → RateLimiter.
// Internally uses a ticker channel to replenish tokens.
fn rate_limiter(n_per_second) {
    let interval_ms = num_floor(1000 / n_per_second);
    let tokens = semaphore(n_per_second);
    let tk = tick(interval_ms);

    // Refill worker: one token per tick
    let refill = fn() {
        while true {
            let t = recv(tk.receiver);
            if t == nil { return nil; }
            let sz = channel_len(tokens.__ch);
            if sz < tokens.__capacity {
                sem_release(tokens);
            }
        }
    };
    spawn(refill);

    return map{
        __tokens: tokens,
        __ticker: tk,
        acquire: fn() { sem_acquire(tokens); },
        try_acquire: fn() { return sem_try_acquire(tokens); },
        stop: fn() { channel_close(tk.sender); }
    };
}

// ─────────────────────────────────────────────────────────────────────────────
// 18. STRUCTURED CONCURRENCY — scope-based (like Kotlin's coroutineScope)
// ─────────────────────────────────────────────────────────────────────────────

// scope(fn) → results_map — run fn(scope) where scope.launch(worker_fn) spawns tracked tasks.
// All launched tasks are joined before scope() returns.
// Like Kotlin's coroutineScope {} or Java's StructuredTaskScope.
fn scope(fn_val) {
    return _scope_run(fn_val);
}

// Explicit receiver dispatch also works in nested retained-host try blocks.
fn scope_launch(scope_obj, worker) {
    return scope_obj.launch(scope_obj, worker);
}

// ─────────────────────────────────────────────────────────────────────────────
// 19. CIRCUIT BREAKER (resilience pattern)
// ─────────────────────────────────────────────────────────────────────────────

// circuit_breaker(threshold, reset_ms) → CircuitBreaker.
// CLOSED (normal) → OPEN (failures >= threshold) → HALF-OPEN (after reset_ms) → CLOSED.
fn circuit_breaker(threshold, reset_ms) {
    const STATE_CLOSED = "closed";
    const STATE_OPEN   = "open";
    const STATE_HALF   = "half-open";

    let state = STATE_CLOSED;
    let failures = atomic_new(0);
    let opened_at = atomic_new(0);
    let m = mutex_new();

    return map{
        call: fn(fn_val) {
            mutex_lock(m);
            let current_state = state;
            if current_state == STATE_OPEN {
                let elapsed = now_ms() - atomic_get(opened_at);
                if elapsed >= reset_ms {
                    state = STATE_HALF;
                    current_state = STATE_HALF;
                } else {
                    mutex_unlock(m);
                    return map{ ok: false, error: "circuit open" };
                }
            }
            mutex_unlock(m);

            // catch binds no name, so use the ok/value sentinel — the old
            // `catch err_val` shape let errors ESCAPE uncounted, meaning the
            // breaker could never open on real failures.
            let outcome = try map{ ok: true, value: fn_val() }
                          catch map{ ok: false, value: "task failed" };
            let success = outcome.ok;
            let result = outcome.value;

            mutex_lock(m);
            if success {
                atomic_set(failures, 0);
                state = STATE_CLOSED;
            } else {
                let fc = atomic_add(failures, 1);
                if fc >= threshold {
                    state = STATE_OPEN;
                    atomic_set(opened_at, now_ms());
                }
            }
            mutex_unlock(m);

            if success { return map{ ok: true, value: result }; }
            return map{ ok: false, error: str(result) };
        },
        is_open: fn() {
            mutex_lock(m);
            let s = state;
            mutex_unlock(m);
            return s == STATE_OPEN;
        },
        reset: fn() {
            mutex_lock(m);
            state = STATE_CLOSED;
            atomic_set(failures, 0);
            mutex_unlock(m);
        }
    };
}

// ─────────────────────────────────────────────────────────────────────────────
// 20. THREAD SUPERVISOR — bounded observation + cooperative cancellation
// ─────────────────────────────────────────────────────────────────────────────

let SUPERVISOR_DEFAULT_TIMEOUT_MS = 30000;
let SUPERVISOR_MAX_TIMEOUT_MS = 3600000;
let SUPERVISOR_MAX_TRACKED = 1024;
let SUPERVISOR_MAX_REASON_BYTES = 256;

fn _supervisor_callable(value) {
    let kind = type(value);
    return kind == "closure" or kind == "function" or kind == "fn" or kind == "builtin";
}

fn _supervisor_timeout(value) {
    if value == nil { return SUPERVISOR_DEFAULT_TIMEOUT_MS; }
    let text = str_lower(str_trim(str(value)));
    if text == "nan" or text == "+nan" or text == "-nan" or
       text == "inf" or text == "+inf" or text == "-inf" or
       text == "infinity" or text == "+infinity" or text == "-infinity" {
        throw "thread.supervisor: timeout must be finite";
    }
    let timeout = try parse_number(text) catch nil;
    if timeout == nil or timeout != num_floor(timeout) or timeout < 1 {
        throw "thread.supervisor: timeout must be a positive integer in milliseconds";
    }
    if timeout > SUPERVISOR_MAX_TIMEOUT_MS { return SUPERVISOR_MAX_TIMEOUT_MS; }
    return timeout;
}

fn _supervisor_find(records, id) {
    let i = 0;
    while i < len(records) {
        if records[i].id == id { return records[i]; }
        i = i + 1;
    }
    return nil;
}

fn _supervisor_active_status(status) {
    return status == "running" or status == "cancel-requested";
}

fn _supervisor_reason(value) {
    let reason = str(value);
    if len(reason) > SUPERVISOR_MAX_REASON_BYTES {
        return str_slice(reason, 0, SUPERVISOR_MAX_REASON_BYTES);
    }
    return reason;
}

// Cooperative workers should poll this at safe interruption points. The
// cancellation channel crosses the VM boundary and the child-local latch keeps
// the result stable after the single buffered signal has been consumed.
fn cancellation_requested(token) {
    if token == nil or (try token.format catch "") != "pblang.thread.cancellation.v1" { return true; }
    if (try token.cancelled catch true) { return true; }
    let receiver = try token.receiver catch nil;
    let signal = try recv_timeout(receiver, 0) catch true;
    if signal != nil {
        token.cancelled = true;
        return true;
    }
    let deadline = try token.deadline_ms catch 0;
    if deadline <= 0 {
        token.cancelled = true;
        return true;
    }
    if now_ms() >= deadline {
        token.cancelled = true;
        return true;
    }
    return false;
}

fn cancellation_remaining_ms(token) {
    if cancellation_requested(token) { return 0; }
    let remaining = token.deadline_ms - now_ms();
    if remaining < 0 { return 0; }
    return remaining;
}

fn _supervisor_snapshot(record) {
    if record == nil {
        return map{ format: "pblang.thread.supervisor.status.v1", found: false, active: false, status: "unknown" };
    }
    return map{
        format: "pblang.thread.supervisor.status.v1",
        found: true,
        id: record.id,
        status: record.status,
        active: _supervisor_active_status(record.status),
        cooperative: record.cooperative,
        timeout_ms: record.timeout_ms,
        started_ms: record.started_ms,
        deadline_ms: record.deadline_ms,
        finished_ms: record.finished_ms,
        cancel_reason: record.cancel_reason,
        reaped: record.reaped,
        error: record.error
    };
}

fn _supervisor_request_cancel(record, stats_map, reason, at_ms) {
    if record == nil or not _supervisor_active_status(record.status) { return false; }
    if record.status != "cancel-requested" {
        try send(record.cancel_sender, true) catch nil;
        record.status = "cancel-requested";
        record.cancel_reason = _supervisor_reason(reason);
        record.cancel_requested_ms = at_ms;
        stats_map.cancel_requested = stats_map.cancel_requested + 1;
    }
    return true;
}

// Harvest exactly one completion signal. Worker VMs never mutate parent maps;
// all counters and terminal states are updated here in the supervisor VM.
fn _supervisor_refresh_record(record, stats_map, at_ms, wait_ms = 0) {
    if record == nil or record.reaped { return false; }
    let now = at_ms;
    if now < record.last_poll_ms { now = record.last_poll_ms; }
    record.last_poll_ms = now;
    let signal = try recv_timeout(record.done_receiver, wait_ms) catch nil;
    if signal != nil {
        let joined = try map{ ok: true, value: join(record.handle) }
                     catch map{ ok: false, value: nil };
        let finished = try signal.finished_ms catch now;
        if finished < record.started_ms { finished = now; }
        record.finished_ms = finished;
        record.reaped = true;
        if record.status == "timed-out" {
            stats_map.late_completed = stats_map.late_completed + 1;
            return true;
        }
        if stats_map.active > 0 { stats_map.active = stats_map.active - 1; }
        if finished >= record.deadline_ms {
            record.status = "timed-out";
            record.error = "deadline exceeded";
            stats_map.timed_out = stats_map.timed_out + 1;
        } elif record.status == "cancel-requested" {
            let succeeded = (try signal.ok catch false) and joined.ok and (try joined.value.ok catch false);
            let observed = try signal.cancel_observed catch false;
            if succeeded and observed {
                record.status = "cancelled";
                stats_map.cancelled = stats_map.cancelled + 1;
            } elif succeeded {
                record.status = "completed";
                stats_map.completed = stats_map.completed + 1;
                stats_map.cancel_not_observed = stats_map.cancel_not_observed + 1;
            } else {
                record.status = "failed";
                record.error = "supervised task failed after cancellation request";
                stats_map.failed = stats_map.failed + 1;
            }
        } elif (try signal.ok catch false) and joined.ok and (try joined.value.ok catch false) {
            record.status = "completed";
            stats_map.completed = stats_map.completed + 1;
        } else {
            record.status = "failed";
            record.error = "supervised task failed";
            stats_map.failed = stats_map.failed + 1;
        }
        return true;
    }
    if _supervisor_active_status(record.status) and now >= record.deadline_ms {
        if record.status != "cancel-requested" {
            try send(record.cancel_sender, true) catch nil;
            stats_map.cancel_requested = stats_map.cancel_requested + 1;
        }
        record.status = "timed-out";
        record.cancel_reason = "deadline";
        record.error = "deadline exceeded; worker may continue until it cooperates";
        record.finished_ms = now;
        stats_map.timed_out = stats_map.timed_out + 1;
        if stats_map.active > 0 { stats_map.active = stats_map.active - 1; }
        return true;
    }
    return false;
}

fn _supervisor_refresh_all(records, stats_map, at_ms) {
    let i = 0;
    while i < len(records) {
        _supervisor_refresh_record(records[i], stats_map, at_ms, 0);
        i = i + 1;
    }
}

fn _supervisor_compact(records) {
    let keep = [];
    let i = 0;
    while i < len(records) {
        if not records[i].reaped { array_push(keep, records[i]); }
        i = i + 1;
    }
    return keep;
}

fn _supervisor_launch(records, stats_map, next_id, fn_val, args, mode, timeout_value) {
    if not _supervisor_callable(fn_val) { throw "thread.supervisor: task must be callable"; }
    if len(records) >= SUPERVISOR_MAX_TRACKED { throw "thread.supervisor: tracked-task limit exceeded"; }
    let timeout_ms = _supervisor_timeout(timeout_value);
    let id = atomic_add(next_id, 1);
    let started = now_ms();
    let cancel = channel_buffered(1);
    let done = channel_buffered(1);
    let done_sender = done.sender;
    let token = map{
        format: "pblang.thread.cancellation.v1",
        id: id,
        receiver: cancel.receiver,
        cancelled: false,
        started_ms: started,
        deadline_ms: started + timeout_ms,
        requested: cancellation_requested,
        remaining_ms: cancellation_remaining_ms
    };
    let wrapped = fn() {
        let outcome = map{ ok: false, value: nil };
        if mode == "args" {
            outcome = try map{ ok: true, value: fn_val(args) } catch map{ ok: false, value: nil };
        } elif mode == "cooperative_args" {
            outcome = try map{ ok: true, value: fn_val(token, args) } catch map{ ok: false, value: nil };
        } elif mode == "cooperative" {
            outcome = try map{ ok: true, value: fn_val(token) } catch map{ ok: false, value: nil };
        } else {
            outcome = try map{ ok: true, value: fn_val() } catch map{ ok: false, value: nil };
        }
        try send(done_sender, map{
            ok: outcome.ok,
            finished_ms: now_ms(),
            cancel_observed: try token.cancelled catch false
        }) catch nil;
        try channel_close(done_sender) catch nil;
        return outcome;
    };
    let handle = try spawn(wrapped) catch nil;
    if handle == nil {
        try channel_close(done_sender) catch nil;
        throw "thread.supervisor: failed to spawn task";
    }
    array_push(records, map{
        format: "pblang.thread.supervisor.record.v1",
        id: id,
        handle: handle,
        done_receiver: done.receiver,
        cancel_sender: cancel.sender,
        cooperative: mode == "cooperative" or mode == "cooperative_args",
        status: "running",
        timeout_ms: timeout_ms,
        started_ms: started,
        deadline_ms: started + timeout_ms,
        last_poll_ms: started,
        cancel_requested_ms: nil,
        cancel_reason: "",
        finished_ms: nil,
        reaped: false,
        error: ""
    });
    stats_map.spawned = stats_map.spawned + 1;
    stats_map.active = stats_map.active + 1;
    return id;
}

// supervisor() -> bounded supervisor. VM threads cannot be force-killed safely;
// timeouts stop accounting immediately and signal cooperative workers, while an
// uncooperative worker remains detached until it exits. `kill_all` is retained
// as a compatibility name but issues cancellation requests, never fake kills.
fn supervisor() {
    let records = [];
    let stats_map = map{
        spawned: 0, completed: 0, failed: 0, timed_out: 0,
        cancel_requested: 0, cancelled: 0, cancel_not_observed: 0,
        late_completed: 0,
        killed: 0, active: 0
    };
    let m = mutex_new();
    let next_id = atomic_new(0);

    return map{
        spawn: fn(_self, fn_val = nil, timeout_ms = nil) {
            if _supervisor_callable(_self) {
                timeout_ms = fn_val;
                fn_val = _self;
            }
            mutex_lock(m);
            _supervisor_refresh_all(records, stats_map, now_ms());
            if len(records) >= SUPERVISOR_MAX_TRACKED { records = _supervisor_compact(records); }
            let outcome = try map{ ok: true, id: _supervisor_launch(records, stats_map, next_id, fn_val, nil, "plain", timeout_ms) }
                          catch map{ ok: false, id: nil };
            mutex_unlock(m);
            if not outcome.ok { throw "thread.supervisor: spawn rejected"; }
            return outcome.id;
        },

        spawn_with_args: fn(_self, fn_val = nil, args = nil, timeout_ms = nil) {
            if _supervisor_callable(_self) {
                timeout_ms = args;
                args = fn_val;
                fn_val = _self;
            }
            mutex_lock(m);
            _supervisor_refresh_all(records, stats_map, now_ms());
            if len(records) >= SUPERVISOR_MAX_TRACKED { records = _supervisor_compact(records); }
            let outcome = try map{ ok: true, id: _supervisor_launch(records, stats_map, next_id, fn_val, args, "args", timeout_ms) }
                          catch map{ ok: false, id: nil };
            mutex_unlock(m);
            if not outcome.ok { throw "thread.supervisor: spawn_with_args rejected"; }
            return outcome.id;
        },

        spawn_cooperative: fn(_self, fn_val = nil, timeout_ms = nil) {
            if _supervisor_callable(_self) {
                timeout_ms = fn_val;
                fn_val = _self;
            }
            mutex_lock(m);
            _supervisor_refresh_all(records, stats_map, now_ms());
            if len(records) >= SUPERVISOR_MAX_TRACKED { records = _supervisor_compact(records); }
            let outcome = try map{ ok: true, id: _supervisor_launch(records, stats_map, next_id, fn_val, nil, "cooperative", timeout_ms) }
                          catch map{ ok: false, id: nil };
            mutex_unlock(m);
            if not outcome.ok { throw "thread.supervisor: cooperative spawn rejected"; }
            return outcome.id;
        },

        spawn_cooperative_with_args: fn(_self, fn_val = nil, args = nil, timeout_ms = nil) {
            if _supervisor_callable(_self) {
                timeout_ms = args;
                args = fn_val;
                fn_val = _self;
            }
            mutex_lock(m);
            _supervisor_refresh_all(records, stats_map, now_ms());
            if len(records) >= SUPERVISOR_MAX_TRACKED { records = _supervisor_compact(records); }
            let outcome = try map{ ok: true, id: _supervisor_launch(records, stats_map, next_id, fn_val, args, "cooperative_args", timeout_ms) }
                          catch map{ ok: false, id: nil };
            mutex_unlock(m);
            if not outcome.ok { throw "thread.supervisor: cooperative argument spawn rejected"; }
            return outcome.id;
        },

        check: fn(_self, id = nil) {
            if id == nil { id = _self; }
            mutex_lock(m);
            let record = _supervisor_find(records, id);
            _supervisor_refresh_record(record, stats_map, now_ms(), 0);
            let alive = record != nil and _supervisor_active_status(record.status);
            mutex_unlock(m);
            return alive;
        },

        check_all: fn(_self = nil) {
            mutex_lock(m);
            _supervisor_refresh_all(records, stats_map, now_ms());
            let active = stats_map.active;
            mutex_unlock(m);
            return active;
        },

        status: fn(_self, id = nil) {
            if id == nil { id = _self; }
            mutex_lock(m);
            let record = _supervisor_find(records, id);
            _supervisor_refresh_record(record, stats_map, now_ms(), 0);
            let snapshot = _supervisor_snapshot(record);
            mutex_unlock(m);
            return snapshot;
        },

        wait: fn(_self, id = nil, wait_ms = nil) {
            if type(_self) != "map" {
                wait_ms = id;
                id = _self;
            }
            mutex_lock(m);
            let record = _supervisor_find(records, id);
            if record == nil {
                mutex_unlock(m);
                return _supervisor_snapshot(nil);
            }
            let wait = 0;
            if wait_ms != nil { wait = _supervisor_timeout(wait_ms); }
            else {
                wait = record.deadline_ms - now_ms();
                if wait < 0 { wait = 0; }
            }
            if wait > record.timeout_ms { wait = record.timeout_ms; }
            _supervisor_refresh_record(record, stats_map, now_ms(), wait);
            _supervisor_refresh_record(record, stats_map, now_ms(), 0);
            let snapshot = _supervisor_snapshot(record);
            mutex_unlock(m);
            return snapshot;
        },

        cancel: fn(_self, id = nil, reason = "cancelled") {
            if type(_self) != "map" {
                reason = if id == nil { "cancelled" } else { id };
                id = _self;
            }
            mutex_lock(m);
            let record = _supervisor_find(records, id);
            _supervisor_refresh_record(record, stats_map, now_ms(), 0);
            let requested = _supervisor_request_cancel(record, stats_map, reason, now_ms());
            mutex_unlock(m);
            return requested;
        },

        kill_all: fn(_self = nil) {
            mutex_lock(m);
            _supervisor_refresh_all(records, stats_map, now_ms());
            let requested = 0;
            let i = 0;
            while i < len(records) {
                if _supervisor_request_cancel(records[i], stats_map, "supervisor-stop", now_ms()) {
                    requested = requested + 1;
                }
                i = i + 1;
            }
            mutex_unlock(m);
            return map{ requested: requested, preemptive: false, reason: "cooperative cancellation requested" };
        },

        reap: fn(_self = nil) {
            mutex_lock(m);
            _supervisor_refresh_all(records, stats_map, now_ms());
            let before = len(records);
            records = _supervisor_compact(records);
            let removed = before - len(records);
            mutex_unlock(m);
            return removed;
        },

        stats: fn(_self = nil) {
            mutex_lock(m);
            _supervisor_refresh_all(records, stats_map, now_ms());
            let unreaped = 0;
            let detached = 0;
            let i = 0;
            while i < len(records) {
                if not records[i].reaped { unreaped = unreaped + 1; }
                if records[i].status == "timed-out" and not records[i].reaped {
                    detached = detached + 1;
                }
                i = i + 1;
            }
            let snapshot = map{
                format: "pblang.thread.supervisor.stats.v1",
                spawned: stats_map.spawned,
                completed: stats_map.completed,
                failed: stats_map.failed,
                timed_out: stats_map.timed_out,
                cancel_requested: stats_map.cancel_requested,
                cancelled: stats_map.cancelled,
                cancel_not_observed: stats_map.cancel_not_observed,
                late_completed: stats_map.late_completed,
                killed: 0,
                active: stats_map.active,
                tracked: len(records),
                unreaped: unreaped,
                detached: detached,
                max_tracked: SUPERVISOR_MAX_TRACKED,
                preemptive_kill: false
            };
            mutex_unlock(m);
            return snapshot;
        },

        active_count: fn(_self = nil) {
            mutex_lock(m);
            _supervisor_refresh_all(records, stats_map, now_ms());
            let count = stats_map.active;
            mutex_unlock(m);
            return count;
        }
    };
}

// ─────────────────────────────────────────────────────────────────────────────
// 21. PARALLEL MAP — map over an array using multiple threads
// ─────────────────────────────────────────────────────────────────────────────

// parallel_map(arr, fn) → [results] — apply fn to each element in parallel.
// Uses thread_pool internally with one worker per element (up to 8).
fn parallel_map(arr, fn_val) {
    let n = len(arr);
    if n == 0 { return []; }
    let workers = n;
    if workers > 8 { workers = 8; }
    return thread_pool(workers, arr, fn_val);
}

// ─────────────────────────────────────────────────────────────────────────────
// 22. PIPELINE — complete batches with owned parallel workers per stage
// ─────────────────────────────────────────────────────────────────────────────

// Load the pipeline implementation only for callers that construct one.
let _PIPELINE = nil;
fn pipeline(stages) {
    if _PIPELINE == nil { _PIPELINE = import("stdlib:thread_pipeline.sapp"); }
    return _PIPELINE.create(stages);
}

// Explicit receiver dispatch avoids the retained VM's nested colon-call catch
// issue. Prefer this entry point when a pipeline failure is caught in a loop.
fn pipeline_run(pipeline_value, input_data) {
    return pipeline_value.run(pipeline_value, input_data);
}

// ─────────────────────────────────────────────────────────────────────────────
// 23. RACE — race multiple promises, return first to complete
// ─────────────────────────────────────────────────────────────────────────────

// race(promises_array) → value — spawn multiple tasks, return the first result.
// Other tasks continue running (best-effort cancellation not supported yet).
fn race(promises) {
    let n = len(promises);
    if n == 0 { return nil; }

    let result_ch = channel_new();

    let i = 0;
    while i < n {
        let p = promises[i];
        let sender = result_ch.sender;
        let runner = fn() {
            let val = p();
            send(sender, val);
        };
        spawn(runner);
        i = i + 1;
    }

    let winner = recv(result_ch.receiver);
    return winner;
}

export
    // Core spawn/join
    thread_spawn, thread_join, thread_join_all, thread_spawn_n,
    // Channels
    channel_new, channel_new_buffered, send_value, recv_value, recv_or_timeout,
    channel_close_sender, channel_is_done, channel_len, drain,
    // Select
    select_ready, select_timeout, select_nonblocking,
    // Timers
    after, tick, sleep,
    // Mutex
    mutex, with_mutex, try_with_mutex,
    // RwLock
    rwlock, with_read, with_write,
    // WaitGroup
    wait_group, wg_done, wg_wait, wg_wait_timeout,
    // Barrier
    barrier, barrier_arrive,
    // Once
    once, once_do_lazy,
    // Atomics
    atomic, atomic_inc, atomic_dec, atomic_get, atomic_set, atomic_add, atomic_cas,
    // Semaphore
    semaphore, sem_acquire, sem_try_acquire, sem_release, with_semaphore,
    // Thread pool
    thread_pool,
    // Pipeline
    pipeline_source, pipeline_stage, pipeline_collect,
    // Fan-out/in
    fan_out, fan_in,
    // Actor model
    actor, actor_send, actor_stop, actor_get_result,
    // Promise/Future
    promise, go, await, await_timeout, try_await, is_ready,
    // Rate limiter
    rate_limiter,
    // Structured concurrency
    scope, scope_launch,
    // Thread supervisor
    // Supervisor
    supervisor, cancellation_requested, cancellation_remaining_ms,
    // Parallel map
    parallel_map,
    // Pipeline (staged)
    pipeline, pipeline_run,
    // Race
    race,
    // Circuit breaker
    circuit_breaker;
