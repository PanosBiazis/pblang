// stdlib/thread.sapp — Enhanced thread, channel, and sync utilities.
//
// Wraps and extends VM builtins:
//   spawn, join, join_all, spawn_n
//   channel, channel_buffered, channel_size
//   send, recv, recv_timeout
//   channel_close, channel_is_closed
//   select, select_with_timeout
//   ticker, timeout_channel
//   mutex_new/lock/try_lock/unlock
//   rwlock_new/read/write/unlock
//   barrier_new/wait
//   once_new/is_done
//   atomic_new/get/set/add/sub/cas/swap
//
// Inspired by: Go (goroutines, channels, sync), Kotlin (coroutines patterns),
//              Rust (Arc<Mutex<T>>, RwLock, Barrier, Once, AtomicUsize),
//              Java (CompletableFuture, CyclicBarrier, AtomicInteger),
//              Erlang (actor model), Haskell (STM concepts).

// ─────────────────────────────────────────────────────────────────────────────
// 1. CORE SPAWN/JOIN
// ─────────────────────────────────────────────────────────────────────────────

// spawn(fn) → handle — spawn a thread running fn().
fn thread_spawn(fn_val) { return spawn(fn_val); }

// join(handle) → value — wait for a thread to finish, return its return value.
fn thread_join(handle) { return join(handle); }

// join_all(handles_array) → [values] — join all handles, collect results in order.
// Like Go's WaitGroup.Wait() + result collection, or Java's CompletableFuture.allOf().
fn thread_join_all(handles) { return join_all(handles); }

// spawn_n(n, fn) → [handles] — spawn n identical threads.
// Like Go's `for i := 0; i < n; i++ { go fn() }`.
fn thread_spawn_n(n, fn_val) { return spawn_n(n, fn_val); }

// ─────────────────────────────────────────────────────────────────────────────
// 2. CHANNELS — unbounded, buffered, timeout
// ─────────────────────────────────────────────────────────────────────────────

// channel_new() → {sender, receiver} — unbounded channel (Go `make(chan T)` with large buffer).
fn channel_new() { return channel(); }

// channel_new_buffered(cap) → {sender, receiver, capacity} — buffered channel (Go `make(chan T, n)`).
fn channel_new_buffered(cap) { return channel_buffered(cap); }

// send_value(sender, val) — send a value.
fn send_value(sender, val) { return send(sender, val); }

// recv_value(receiver) → value | nil — blocking recv (nil = channel closed).
fn recv_value(receiver) { return recv(receiver); }

// recv_or_timeout(receiver, ms) → value | nil — recv with timeout. nil = closed or timed out.
fn recv_or_timeout(receiver, ms) { return recv_timeout(receiver, ms); }

// channel_close_sender(ch) — close the sender end; waiting recvs return nil.
fn channel_close_sender(ch) { return channel_close(ch.sender); }

// channel_is_done(ch) — true if the channel's sender was closed.
fn channel_is_done(ch) { return channel_is_closed(ch.sender); }

// channel_len(ch) — number of items currently buffered.
fn channel_len(ch) { return channel_size(ch.receiver); }

// drain(ch) → [values] — read all available values without blocking.
fn drain(ch) {
    let result = [];
    while true {
        let v = recv_timeout(ch.receiver, 0);
        if v == nil { return result; }
        array_push(result, v);
    }
    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. SELECT — non-blocking, timeout, Go-style
// ─────────────────────────────────────────────────────────────────────────────

// select_ready(receivers_array) → {index, value} | nil — block until one is ready.
fn select_ready(receivers) { return select(receivers); }

// select_timeout(receivers_array, ms) → {index, value, timed_out} | nil.
// timed_out==true means no channel was ready within ms milliseconds.
fn select_timeout(receivers, ms) { return select_with_timeout(receivers, ms); }

// select_nonblocking(receivers_array) → {index, value} | nil — returns nil immediately if none ready.
fn select_nonblocking(receivers) { return select_with_timeout(receivers, 0); }

// ─────────────────────────────────────────────────────────────────────────────
// 4. TIMERS AND TICKERS
// ─────────────────────────────────────────────────────────────────────────────

// after(ms) → channel — fires once after ms milliseconds (like Go's time.After).
fn after(ms) { return timeout_channel(ms); }

// tick(interval_ms) → channel — fires every interval_ms (like Go's time.Tick).
// Stop by closing the channel: channel_close(t.sender).
fn tick(interval_ms) { return ticker(interval_ms); }

// sleep_ms wrapper
fn sleep(ms) { sleep_ms(ms); }

// ─────────────────────────────────────────────────────────────────────────────
// 5. MUTEX — mutual exclusion (Go sync.Mutex / Rust Mutex<T>)
// ─────────────────────────────────────────────────────────────────────────────

// mutex() → handle — create a mutex.
fn mutex() { return mutex_new(); }

// with_mutex(m, fn) → fn() result — lock, run fn, unlock (RAII pattern).
// Like Rust's MutexGuard or Go's defer mu.Unlock().
fn with_mutex(m, fn_val) {
    mutex_lock(m);
    let result = nil;
    try {
        result = fn_val();
    } catch err_val {
        mutex_unlock(m);
        return result; // result stays nil; error was thrown
    }
    mutex_unlock(m);
    return result;
}

// try_with_mutex(m, fn) → {ok, value} | {ok:false,error} — non-blocking version.
fn try_with_mutex(m, fn_val) {
    if mutex_try_lock(m) == false {
        return map{ ok: false, error: "mutex busy" };
    }
    let result = nil;
    try {
        result = fn_val();
    } catch err_val {
        mutex_unlock(m);
        return map{ ok: false, error: str(err_val) };
    }
    mutex_unlock(m);
    return map{ ok: true, value: result };
}

// ─────────────────────────────────────────────────────────────────────────────
// 6. RWLOCK — read-write lock (Go sync.RWMutex / Rust RwLock<T>)
// ─────────────────────────────────────────────────────────────────────────────

// rwlock() → handle — create a read-write lock.
fn rwlock() { return rwlock_new(); }

// with_read(rw, fn) → result — acquire read lock, run fn, release.
fn with_read(rw, fn_val) {
    rwlock_read(rw);
    let result = nil;
    try {
        result = fn_val();
    } catch err_val {
        rwlock_unlock(rw);
        return result;
    }
    rwlock_unlock(rw);
    return result;
}

// with_write(rw, fn) → result — acquire write lock, run fn, release.
fn with_write(rw, fn_val) {
    rwlock_write(rw);
    let result = nil;
    try {
        result = fn_val();
    } catch err_val {
        rwlock_unlock(rw);
        return result;
    }
    rwlock_unlock(rw);
    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// 7. WAIT GROUP (Go sync.WaitGroup pattern)
// ─────────────────────────────────────────────────────────────────────────────

// wait_group(n) → WaitGroup map — synchronize n goroutines.
// Usage:
//   let wg = thread.wait_group(3);
//   spawn(fn() { ...; thread.wg_done(wg); });
//   spawn(fn() { ...; thread.wg_done(wg); });
//   spawn(fn() { ...; thread.wg_done(wg); });
//   thread.wg_wait(wg);
fn wait_group(n) {
    let counter = atomic_new(n);
    let done_ch = channel_new_buffered(1); // fires when counter hits 0
    return map{
        __counter: counter,
        __done_ch: done_ch,
        __total: n
    };
}

// wg_done(wg) — decrement counter; signal when all are done.
fn wg_done(wg) {
    let remaining = atomic_sub(wg.__counter, 1);
    if remaining <= 0 {
        // Signal completion (non-blocking, buffered channel of 1)
        let is_closed = channel_is_closed(wg.__done_ch.sender);
        if is_closed == false {
            send(wg.__done_ch.sender, true);
            channel_close(wg.__done_ch.sender);
        }
    }
}

// wg_wait(wg) — block until all workers have called wg_done.
fn wg_wait(wg) {
    let current = atomic_get(wg.__counter);
    if current <= 0 { return; }
    recv(wg.__done_ch.receiver);
}

// wg_wait_timeout(wg, ms) → bool — true if all done, false if timed out.
fn wg_wait_timeout(wg, ms) {
    let current = atomic_get(wg.__counter);
    if current <= 0 { return true; }
    let v = recv_timeout(wg.__done_ch.receiver, ms);
    return v != nil;
}

// ─────────────────────────────────────────────────────────────────────────────
// 8. BARRIER — rendezvous point for N threads
// ─────────────────────────────────────────────────────────────────────────────

// barrier(n) → handle — create a CyclicBarrier for n threads.
fn barrier(n) { return barrier_new(n); }

// barrier_arrive(b) → bool — arrive at barrier; blocks until all n threads arrive.
// Returns true for the thread that triggered the release; false for the others.
fn barrier_arrive(b) { return barrier_wait(b); }

// ─────────────────────────────────────────────────────────────────────────────
// 9. ONCE — execute exactly once (Go sync.Once / Kotlin lazy / Rust Once)
// ─────────────────────────────────────────────────────────────────────────────

// once() → handle — create a Once. The init function runs at most once.
fn once() { return once_new(); }

// once_do(handle, fn, args_ch) — run fn() exactly once, even if called from multiple threads.
// Uses an atomic + barrier pattern:
//   - first caller: executes fn, signals done
//   - later callers: wait until done, then return
// NOTE: fn return value is sent on args_ch; pass a buffered(1) channel for it.
// Simplified version that works for single-threaded "lazy init" use case:
fn once_do_lazy(init_fn) {
    // Returns a closure that memoizes the result of init_fn() (lazy init pattern)
    let done = false;
    let result = nil;
    return fn() {
        if done == false {
            result = init_fn();
            done = true;
        }
        return result;
    };
}

// ─────────────────────────────────────────────────────────────────────────────
// 10. ATOMICS — lock-free counters (Rust AtomicUsize / Java AtomicInteger / Go atomic)
// ─────────────────────────────────────────────────────────────────────────────

// atomic(init) → handle — create an atomic integer.
fn atomic(init) {
    if init == nil { init = 0; }
    return atomic_new(init);
}

// atomic_inc(a) → new_val — increment by 1.
fn atomic_inc(a) { return atomic_add(a, 1); }

// atomic_dec(a) → new_val — decrement by 1.
fn atomic_dec(a) { return atomic_sub(a, 1); }

// ─────────────────────────────────────────────────────────────────────────────
// 11. SEMAPHORE — Go's semaphore / Java Semaphore pattern
// ─────────────────────────────────────────────────────────────────────────────

// semaphore(n) → Semaphore — counting semaphore allowing n concurrent holders.
// Like Go's semaphore.Weighted(n) or Java's Semaphore(n).
fn semaphore(n) {
    let ch = channel_new_buffered(n);
    // Fill with n tokens
    let i = 0;
    while i < n {
        send(ch.sender, true);
        i = i + 1;
    }
    return map{ __ch: ch, __capacity: n };
}

// sem_acquire(s) — acquire one permit (blocks if none available).
fn sem_acquire(s) {
    recv(s.__ch.receiver); // takes one token
}

// sem_try_acquire(s) → bool — non-blocking acquire.
fn sem_try_acquire(s) {
    let v = recv_timeout(s.__ch.receiver, 0);
    return v != nil;
}

// sem_release(s) — release one permit.
fn sem_release(s) {
    send(s.__ch.sender, true);
}

// with_semaphore(s, fn) → result — RAII acquire+run+release.
fn with_semaphore(s, fn_val) {
    sem_acquire(s);
    let result = nil;
    try {
        result = fn_val();
    } catch err_val {
        sem_release(s);
        return result;
    }
    sem_release(s);
    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// 12. THREAD POOL
// ─────────────────────────────────────────────────────────────────────────────

// _make_pool_worker — factory for worker closures (must be top-level for closed upvalues).
fn _make_pool_worker(jr, rs, wf) {
    return fn() {
        let job = recv(jr);
        while job != nil {
            let result = wf(job);
            send(rs, result);
            job = recv(jr);
        }
    };
}

// thread_pool(n_workers, tasks, worker_fn) → [results] — parallel fan-out/fan-in.
// Like Java ExecutorService.invokeAll() or Go's worker pool pattern.
fn thread_pool(n_workers, tasks_array, worker_fn) {
    let jobs = channel_new();
    let results = channel_new();
    let n_tasks = len(tasks_array);

    // Spawn workers
    let workers = [];
    let w = 0;
    while w < n_workers {
        let closure = _make_pool_worker(jobs.receiver, results.sender, worker_fn);
        array_push(workers, spawn(closure));
        w = w + 1;
    }

    // Send tasks
    let t = 0;
    while t < n_tasks {
        send(jobs.sender, tasks_array[t]);
        t = t + 1;
    }
    // Send shutdown sentinels (one per worker)
    let sw = 0;
    while sw < n_workers {
        send(jobs.sender, nil);
        sw = sw + 1;
    }

    // Collect results
    let results_list = [];
    let r = 0;
    while r < n_tasks {
        array_push(results_list, recv(results.receiver));
        r = r + 1;
    }

    // Join workers
    let jw = 0;
    while jw < n_workers { join(workers[jw]); jw = jw + 1; }

    return results_list;
}

// ─────────────────────────────────────────────────────────────────────────────
// 13. PIPELINE — lazy functional pipelines (synchronous)
//
// NOTE: pblang cannot serialize closures across thread boundaries, so pipelines
// are evaluated lazily/synchronously when pipeline_collect() is called.
// Each stage records its transform; collection applies them in sequence.
// ─────────────────────────────────────────────────────────────────────────────

// pipeline_source(items_array) → pipeline — start a pipeline from an array.
fn pipeline_source(items) {
    return map{ __data: items, __transforms: [] };
}

// pipeline_stage(pipe, transform_fn) → new_pipe — add a transform stage.
// transform_fn(x) → new_x | nil (nil filters out the element).
fn pipeline_stage(pipe, transform_fn) {
    let transforms = [];
    if map_has(pipe, "__transforms") {
        let i = 0;
        while i < len(pipe.__transforms) {
            array_push(transforms, pipe.__transforms[i]);
            i = i + 1;
        }
    }
    array_push(transforms, transform_fn);
    return map{ __data: pipe.__data, __transforms: transforms };
}

// pipeline_collect(pipe) → [values] — apply all stages and return results.
fn pipeline_collect(pipe) {
    let result = pipe.__data;
    let i = 0;
    while i < len(pipe.__transforms) {
        let tf = pipe.__transforms[i];
        let new_result = [];
        let j = 0;
        while j < len(result) {
            let v = tf(result[j]);
            if v != nil { array_push(new_result, v); }
            j = j + 1;
        }
        result = new_result;
        i = i + 1;
    }
    return result;
}

// ─────────────────────────────────────────────────────────────────────────────
// 14. FAN-OUT / FAN-IN
// ─────────────────────────────────────────────────────────────────────────────

// fan_out(source_ch, n) → [channels] — distribute source items to n output channels round-robin.
fn fan_out(source_ch, n) {
    let outs = [];
    let i = 0;
    while i < n { array_push(outs, channel_new()); i = i + 1; }
    let out_senders = [];
    let j = 0;
    while j < n { array_push(out_senders, outs[j].sender); j = j + 1; }

    let fo_worker = fn() {
        let idx = 0;
        let v = recv(source_ch.receiver);
        while v != nil {
            send(out_senders[idx], v);
            idx = (idx + 1) - num_floor((idx + 1) / n) * n; // idx = (idx+1) % n
            v = recv(source_ch.receiver);
        }
        let k = 0;
        while k < n { channel_close(out_senders[k]); k = k + 1; }
    };
    spawn(fo_worker);
    return outs;
}

// fan_in(channels_array) → merged_channel — merge N channels into one.
fn fan_in(channels) {
    let out = channel_new();
    let active = atomic_new(len(channels));

    let i = 0;
    while i < len(channels) {
        let ch_i = channels[i];
        let out_s = out.sender;
        let active_ref = active;
        let reader = fn() {
            let v = recv(ch_i.receiver);
            while v != nil {
                send(out_s, v);
                v = recv(ch_i.receiver);
            }
            let remaining = atomic_sub(active_ref, 1);
            if remaining <= 0 { channel_close(out_s); }
        };
        spawn(reader);
        i = i + 1;
    }
    return out;
}

// ─────────────────────────────────────────────────────────────────────────────
// 15. ACTOR MODEL (Erlang-style)
// ─────────────────────────────────────────────────────────────────────────────

// actor(initial_state, handler_fn) → actor_ref map.
//   handler_fn(state, message) → new_state
//   Messages are processed synchronously (inline) when send() is called.
//   This is the safe approach in pblang since closures can't cross thread boundaries.
//   For concurrent actors, use spawn() + channels + factory patterns manually.
//
// actor_ref: { send: fn(msg), stop: fn(), get_result: fn() }
fn actor(initial_state, handler_fn) {
    let state = initial_state;
    let stopped = false;
    return map{
        send: fn(msg) {
            if stopped { return nil; }
            state = handler_fn(state, msg);
        },
        stop: fn() {
            stopped = true;
        },
        get_result: fn() {
            return state;
        }
    };
}

// actor_send(actor_ref, msg) — send a message to an actor.
fn actor_send(actor_ref, msg) { actor_ref.send(msg); }

// actor_stop(actor_ref) — stop the actor loop.
fn actor_stop(actor_ref) { actor_ref.stop(); }

// actor_get_result(actor_ref) — wait for actor to stop and return final state.
fn actor_get_result(actor_ref) { return actor_ref.get_result(); }

// ─────────────────────────────────────────────────────────────────────────────
// 16. PROMISE / FUTURE (Kotlin Deferred / Java CompletableFuture)
//
// NOTE: pblang closures cannot be serialized across thread boundaries.
// promise() evaluates fn() eagerly (immediately) in the CURRENT thread and
// wraps the result. await() and await_timeout() simply return the cached result.
// For truly async computation, use spawn() + channel() + factory patterns.
// ─────────────────────────────────────────────────────────────────────────────

// promise(fn) → Promise — eagerly evaluate fn() and wrap the result.
fn promise(fn_val) {
    let val = fn_val();   // evaluate NOW in the current thread
    return map{ __value: val, __done: true };
}

// await(promise_ref) → value — return the resolved value.
fn await(p) { return p.__value; }

// await_timeout(promise_ref, ms) → {ok, value} — always succeeds (already resolved).
fn await_timeout(p, ms) { return map{ ok: true, value: p.__value }; }

// is_ready(promise_ref) → bool — always true (eager evaluation).
fn is_ready(p) { return p.__done; }

// ─────────────────────────────────────────────────────────────────────────────
// 17. RATE LIMITER (token bucket pattern)
// ─────────────────────────────────────────────────────────────────────────────

// rate_limiter(n_per_second) → RateLimiter.
// Internally uses a ticker channel to replenish tokens.
fn rate_limiter(n_per_second) {
    let interval_ms = num_floor(1000 / n_per_second);
    let tokens = semaphore(n_per_second);
    let tk = tick(interval_ms);

    // Refill worker: one token per tick
    let refill = fn() {
        while true {
            let t = recv(tk.receiver);
            if t == nil { return nil; }
            let sz = channel_len(tokens.__ch);
            if sz < tokens.__capacity {
                sem_release(tokens);
            }
        }
    };
    spawn(refill);

    return map{
        __tokens: tokens,
        __ticker: tk,
        acquire: fn() { sem_acquire(tokens); },
        try_acquire: fn() { return sem_try_acquire(tokens); },
        stop: fn() { channel_close(tk.sender); }
    };
}

// ─────────────────────────────────────────────────────────────────────────────
// 18. STRUCTURED CONCURRENCY — scope-based (like Kotlin's coroutineScope)
// ─────────────────────────────────────────────────────────────────────────────

// scope(fn) → results_map — run fn(scope) where scope.launch(worker_fn) spawns tracked tasks.
// All launched tasks are joined before scope() returns.
// Like Kotlin's coroutineScope {} or Java's StructuredTaskScope.
fn scope(fn_val) {
    let handles = [];
    let scope_obj = map{
        // `_self` receives `scope_obj` when called via `sc:launch(fn)` method syntax
        launch: fn(_self, worker) {
            let h = spawn(worker);
            array_push(handles, h);
            return h;
        }
    };

    fn_val(scope_obj);  // Run the user's scope body

    // Join all launched tasks
    return join_all(handles);
}

// ─────────────────────────────────────────────────────────────────────────────
// 19. CIRCUIT BREAKER (resilience pattern)
// ─────────────────────────────────────────────────────────────────────────────

// circuit_breaker(threshold, reset_ms) → CircuitBreaker.
// CLOSED (normal) → OPEN (failures >= threshold) → HALF-OPEN (after reset_ms) → CLOSED.
fn circuit_breaker(threshold, reset_ms) {
    const STATE_CLOSED = "closed";
    const STATE_OPEN   = "open";
    const STATE_HALF   = "half-open";

    let state = STATE_CLOSED;
    let failures = atomic_new(0);
    let opened_at = atomic_new(0);
    let m = mutex_new();

    return map{
        call: fn(fn_val) {
            mutex_lock(m);
            let current_state = state;
            if current_state == STATE_OPEN {
                let elapsed = now_ms() - atomic_get(opened_at);
                if elapsed >= reset_ms {
                    state = STATE_HALF;
                    current_state = STATE_HALF;
                } else {
                    mutex_unlock(m);
                    return map{ ok: false, error: "circuit open" };
                }
            }
            mutex_unlock(m);

            let result = nil;
            let success = true;
            try {
                result = fn_val();
            } catch err_val {
                success = false;
                result = err_val;
            }

            mutex_lock(m);
            if success {
                atomic_set(failures, 0);
                state = STATE_CLOSED;
            } else {
                let fc = atomic_add(failures, 1);
                if fc >= threshold {
                    state = STATE_OPEN;
                    atomic_set(opened_at, now_ms());
                }
            }
            mutex_unlock(m);

            if success { return map{ ok: true, value: result }; }
            return map{ ok: false, error: str(result) };
        },
        is_open: fn() {
            mutex_lock(m);
            let s = state;
            mutex_unlock(m);
            return s == STATE_OPEN;
        },
        reset: fn() {
            mutex_lock(m);
            state = STATE_CLOSED;
            atomic_set(failures, 0);
            mutex_unlock(m);
        }
    };
}

