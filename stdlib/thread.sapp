// stdlib/thread.sapp — Thread and channel helpers (T5-alpha + T5-beta)
// Wraps VM builtins: spawn, join, channel, send, recv, channel_close, channel_is_closed, select

// Capture builtins before any redefinition
let _spawn = spawn;
let _join = join;

// Spawn a new VM-per-thread worker running fn_val (no arguments).
fn spawn(fn_val) {
    return _spawn(fn_val);
}

// Wait for a spawned thread to finish.
fn join(handle) {
    return _join(handle);
}

// Create a new channel. Returns map{ sender, receiver }.
fn channel_new() {
    return channel();
}

// Send a value on the sender end.
fn send_value(sender, value) {
    return send(sender, value);
}

// Receive a value from the receiver end. Blocks until a value is available.
fn recv_value(receiver) {
    return recv(receiver);
}

// Close the sender end of a channel (signals producers are done).
fn channel_close_wrapper(ch) {
    return channel_close(ch);
}

// Check if a channel's sender has been closed.
fn channel_is_closed_wrapper(ch) {
    return channel_is_closed(ch);
}

// Select the first ready channel from channels_array.
// Returns the index of the ready channel.
fn select_ready(channels_array) {
    return select(channels_array);
}

// T5-beta: Thread pool helper.
// Spawns n_workers, distributes items from tasks_array via a channel,
// calls worker_fn(item) for each, collects results in completion order.
// Uses nil sentinel for graceful worker shutdown.
fn thread_pool(n_workers, tasks_array, worker_fn) {
    let jobs = channel_new();
    let results = channel_new();
    let n_tasks = len(tasks_array);

    // Spawn workers
    let workers = [];
    let w = 0;
    while w < n_workers {
        let jobs_recv = jobs.receiver;
        let res_send = results.sender;
        let wfn = worker_fn;
        let h = spawn(fn() {
            let job = recv_value(jobs_recv);
            while job != nil {
                let result = wfn(job);
                send_value(res_send, result);
                job = recv_value(jobs_recv);
            }
        });
        array_push(workers, h);
        w = w + 1;
    }

    // Send tasks
    let t = 0;
    while t < n_tasks {
        send_value(jobs.sender, tasks_array[t]);
        t = t + 1;
    }

    // Send shutdown sentinels (one per worker)
    let sw = 0;
    while sw < n_workers {
        send_value(jobs.sender, nil);
        sw = sw + 1;
    }

    // Collect results
    let results_list = [];
    let r = 0;
    while r < n_tasks {
        let res = recv_value(results.receiver);
        array_push(results_list, res);
        r = r + 1;
    }

    // Join all workers
    let jw = 0;
    while jw < n_workers {
        join(workers[jw]);
        jw = jw + 1;
    }

    return results_list;
}

export spawn, join, channel_new, send_value, recv_value, channel_close_wrapper, channel_is_closed_wrapper, select_ready, thread_pool;
