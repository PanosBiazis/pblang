// stdlib/knowledge_base.sapp — a growing non-parametric MEMORY (knowledge capacity that
// scales with experience). Store (x → y) exemplars and recall the nearest ones; a simple
// retrieval/episodic memory that complements a parametric net (stdlib/nn.sapp): the net
// generalizes, the knowledge base remembers specifics. Knowledge "density" = #exemplars.
//
//   let kb = import("stdlib:knowledge_base.sapp");
//   let m = kb.kb_new(); kb.kb_learn(m, x, y);
//   kb.kb_predict(m, query);          // nearest-memory answer
//   kb.kb_recall(m, query, 3);        // 3 nearest experiences

fn kb_new() { return map{ items: [] }; }

// kb_learn(kb, x, y) — remember one experience (grows knowledge density). Mutates + returns kb.
fn kb_learn(kb, x, y) { push(kb.items, map{ x: x, y: y }); return kb; }

// kb_density(kb) — how much the model knows (number of stored exemplars).
fn kb_density(kb) { return len(kb.items); }

fn _dist(a, b) {
    let s = 0;
    let i = 0;
    let n = len(a);
    if len(b) < n { n = len(b); }
    while i < n { let d = a[i] - b[i]; s = s + d * d; i = i + 1; }
    return num_sqrt(s);
}

// kb_recall(kb, x, k) — the k nearest stored experiences to x (closest first).
fn kb_recall(kb, x, k) {
    let scored = [];
    let i = 0;
    while i < len(kb.items) { push(scored, map{ item: kb.items[i], d: _dist(kb.items[i].x, x) }); i = i + 1; }
    let a = 1;                                   // insertion sort ascending by distance
    while a < len(scored) {
        let key = scored[a];
        let b = a - 1;
        while b >= 0 and scored[b].d > key.d { scored[b + 1] = scored[b]; b = b - 1; }
        scored[b + 1] = key;
        a = a + 1;
    }
    let out = [];
    let j = 0;
    while j < k and j < len(scored) { push(out, scored[j].item); j = j + 1; }
    return out;
}

// kb_predict(kb, x) — the y of the single nearest experience (1-NN), or nil if empty.
fn kb_predict(kb, x) {
    if len(kb.items) == 0 { return nil; }
    let r = kb_recall(kb, x, 1);
    return r[0].y;
}

// kb_merge(a, b) — a NEW knowledge base combining both (pool experiences → more density).
fn kb_merge(a, b) {
    let kb = kb_new();
    let i = 0;
    while i < len(a.items) { push(kb.items, a.items[i]); i = i + 1; }
    let j = 0;
    while j < len(b.items) { push(kb.items, b.items[j]); j = j + 1; }
    return kb;
}

export kb_new, kb_learn, kb_density, kb_recall, kb_predict, kb_merge;
