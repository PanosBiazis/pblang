// Bounded rectangular drawing clip. No framebuffer, files or native calls.
// Coordinates are physical pixels. Fractional fills shrink to whole pixels.
fn _number(value) {
    if type(value)!="number" or not (value>=-1000000 and value<=1000000) {
        throw "invalid clip coordinate";
    }
    return value;
}
fn region(value) {
    if type(value)!="map" or len(map_keys(value))!=4 { throw "invalid clip region"; }
    for key in ["x","y","w","h"] {
        if not map_has(value,key) { throw "invalid clip region"; }
        let item=_number(value[key]);
        if item!=num_floor(item) { throw "clip region requires integer pixels"; }
    }
    if value.w<0 or value.h<0 { throw "invalid clip extent"; }
    return map{x:value.x,y:value.y,w:value.w,h:value.h};
}
fn contains(value,x,y) {
    let r=region(value);
    if type(x)!="number" or type(y)!="number" { return false; }
    return x>=r.x and x<r.x+r.w and y>=r.y and y<r.y+r.h;
}
fn _pixel(value,low,high) {
    return num_max(low,num_min(high,num_floor(value+0.5)));
}
fn _diagonal(win,r,x1,y1,x2,y2,color) {
    // Canonical left-to-right order also makes reversed inputs use identical
    // floating-point operations. No loop proportional to segment length.
    if x1>x2 {
        let old_x=x1; let old_y=y1;
        x1=x2; y1=y2; x2=old_x; y2=old_y;
    }
    let dx=x2-x1; let dy=y2-y1;
    let enter=0; let leave=1;
    // Intersect the line parameter interval with the included pixel-center
    // bounds of each axis. The caller already excludes zero-area regions.
    for axis in [[x1,dx,r.x,r.x+r.w-1],[y1,dy,r.y,r.y+r.h-1]] {
        let first=(axis[2]-axis[0])/axis[1];
        let last=(axis[3]-axis[0])/axis[1];
        enter=num_max(enter,num_min(first,last));
        leave=num_min(leave,num_max(first,last));
        if enter>leave { return; }
    }
    win.line(_pixel(x1+enter*dx,r.x,r.x+r.w-1),_pixel(y1+enter*dy,r.y,r.y+r.h-1),
        _pixel(x1+leave*dx,r.x,r.x+r.w-1),_pixel(y1+leave*dy,r.y,r.y+r.h-1),color);
}
fn canvas(win,value) {
    let r=region(value); // Copy once: later edits to the caller's map do not change this canvas.
    let rect=fn(x,y,w,h,color) {
        _number(x); _number(y); _number(w); _number(h);
        if w<=0 or h<=0 { return; }
        let left=num_ceil(num_max(x,r.x)); let top=num_ceil(num_max(y,r.y));
        let right=num_floor(num_min(x+w,r.x+r.w)); let bottom=num_floor(num_min(y+h,r.y+r.h));
        if right>left and bottom>top { win.rect(left,top,right-left,bottom-top,color); }
    };
    let line=fn(x1,y1,x2,y2,color){
        _number(x1); _number(y1); _number(x2); _number(y2);
        if r.w==0 or r.h==0 { return; }
        if x1!=x2 and y1!=y2 { return _diagonal(win,r,x1,y1,x2,y2,color); }
        if y1==y2 {
            let y=num_floor(y1);
            let left=num_max(num_ceil(num_min(x1,x2)),r.x);
            let right=num_min(num_floor(num_max(x1,x2)),r.x+r.w-1);
            if y>=r.y and y<r.y+r.h and left<=right { win.line(left,y,right,y,color); }
        } else {
            let x=num_floor(x1);
            let top=num_max(num_ceil(num_min(y1,y2)),r.y);
            let bottom=num_min(num_floor(num_max(y1,y2)),r.y+r.h-1);
            if x>=r.x and x<r.x+r.w and top<=bottom { win.line(x,top,x,bottom,color); }
        }
    };
    return map{
        rect:rect,
        clear:fn(color){rect(r.x,r.y,r.w,r.h,color);},
        point:fn(x,y,color){rect(num_floor(_number(x)),num_floor(_number(y)),1,1,color);},
        line:line,
        circle:fn(x,y,radius,color){
            _number(x); _number(y); _number(radius);
            if radius<0 { throw "invalid clip radius"; }
            // Validate the entire outline before the first sink effect.
            _number(x-radius); _number(x+radius);
            _number(y-radius); _number(y+radius);
            if r.w==0 or r.h==0 { return; }
            if radius==0 { return line(num_floor(x),num_floor(y),num_floor(x),num_floor(y),color); }
            // Match graphics.Window's sixteen-vertex outline geometry. Keep
            // this leaf adapter independent of native graphics imports.
            let xs=[1,0.924,0.707,0.383,0,-0.383,-0.707,-0.924,-1,-0.924,-0.707,-0.383,0,0.383,0.707,0.924];
            let ys=[0,0.383,0.707,0.924,1,0.924,0.707,0.383,0,-0.383,-0.707,-0.924,-1,-0.924,-0.707,-0.383];
            let i=0;
            while i<16 {
                let j=i+1; if j==16 { j=0; }
                line(x+radius*xs[i],y+radius*ys[i],x+radius*xs[j],y+radius*ys[j],color);
                i=i+1;
            }
        }
    };
}
export region,contains,canvas;
