// String / character utilities.
//
// Builtins available:
// - str_contains(s, sub)
// - str_starts_with(s, pre)
// - str_trim(s)
// - str_split(s, delim)  (delim "" splits to characters)

fn chars(s) {
    return str_split(s, "");
}

fn join(parts, delim) {
    let out = "";
    for i len(parts) {
        if i == 0 { out = str(parts[i]); }
        else { out = out + delim + str(parts[i]); }
    }
    return out;
}

fn repeat(s, n) {
    let out = "";
    for i n { out = out + s; }
    return out;
}

fn replace_all(s, needle, repl) {
    let parts = str_split(s, needle);
    return join(parts, repl);
}

fn starts_with(s, pre) { return str_starts_with(s, pre); }
fn contains(s, sub) { return str_contains(s, sub); }
fn trim(s) { return str_trim(s); }

fn ends_with(s, suf) {
    // No slicing yet; approximate via split if suf isn't empty.
    if suf == "" { return true; }
    let parts = str_split(s, suf);
    if len(parts) == 0 { return false; }
    // If it ends with suf, last part is "".
    return parts[len(parts) - 1] == "";
}

fn lines(s) {
    return str_split(s, "\n");
}

fn words(s) {
    // simple whitespace split
    let p = str_split(s, " ");
    let out = [];
    for i len(p) {
        let w = str_trim(p[i]);
        if w != "" { out[len(out)] = w; }
    }
    return out;
}

export chars, join, repeat, replace_all, starts_with, ends_with, contains, trim, lines, words;

