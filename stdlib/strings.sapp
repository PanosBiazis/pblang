// stdlib/strings.sapp — String / character utilities.
//
// Builtins available:
//   str_contains(s, sub), str_starts_with(s, pre), str_trim(s),
//   str_split(s, delim), str_upper(s), str_lower(s), str_slice(s, lo, hi)

fn chars(s) { return str_split(s, ""); }

fn join(parts, delim) {
    let out = "";
    for i len(parts) {
        if i == 0 { out = str(parts[i]); }
        else       { out = out + delim + str(parts[i]); }
    }
    return out;
}

fn repeat(s, n) {
    let out = "";
    for i n { out = out + s; }
    return out;
}

fn replace_all(s, needle, repl) {
    return join(str_split(s, needle), repl);
}

fn replace_first(s, needle, repl) {
    let parts = str_split(s, needle);
    if len(parts) <= 1 { return s; }
    let result = parts[0] + repl;
    let i = 1;
    while i < len(parts) {
        if i > 1 { result = result + needle; }
        result = result + parts[i];
        i = i + 1;
    }
    return result;
}

fn starts_with(s, pre) { return str_starts_with(s, pre); }
fn ends_with(s, suf) {
    if suf == "" { return true; }
    let sl = len(s);
    let suflen = len(suf);
    if suflen > sl { return false; }
    return str_slice(s, sl - suflen, sl) == suf;
}
fn contains(s, sub) { return str_contains(s, sub); }
fn trim(s) { return str_trim(s); }
fn upper(s) { return str_upper(s); }
fn lower(s) { return str_lower(s); }

fn lines(s) { return str_split(s, "\n"); }
fn split(s, delim) { return str_split(s, delim); }

fn words(s) {
    let p = str_split(s, " ");
    let out = [];
    for i len(p) {
        let w = str_trim(p[i]);
        if w != "" { array_push(out, w); }
    }
    return out;
}

fn pad_left(s, width, pad_char) {
    let n = len(s);
    if n >= width { return s; }
    let result = s;
    let i = n;
    while i < width { result = pad_char + result; i = i + 1; }
    return result;
}

fn pad_right(s, width, pad_char) {
    let n = len(s);
    if n >= width { return s; }
    let result = s;
    let i = n;
    while i < width { result = result + pad_char; i = i + 1; }
    return result;
}

fn to_upper_first(s) {
    if len(s) == 0 { return s; }
    return str_upper(str_slice(s, 0, 1)) + str_slice(s, 1, len(s));
}

fn to_lower_first(s) {
    if len(s) == 0 { return s; }
    return str_lower(str_slice(s, 0, 1)) + str_slice(s, 1, len(s));
}

fn count(s, sub) {
    return len(str_split(s, sub)) - 1;
}

fn is_empty(s) { return len(str_trim(s)) == 0; }

fn truncate(s, max_len, suffix) {
    if len(s) <= max_len { return s; }
    return str_slice(s, 0, max_len) + suffix;
}

// reverse(s) — reverse a string character by character
fn reverse(s) {
    let chs = str_split(s, "");
    let result = "";
    let i = len(chs) - 1;
    while i >= 0 {
        result = result + chs[i];
        i = i - 1;
    }
    return result;
}

// to_camel_case("hello_world") → "helloWorld"
fn to_camel_case(s) {
    let parts = str_split(s, "_");
    if len(parts) == 0 { return s; }
    let result = parts[0];
    let i = 1;
    while i < len(parts) {
        result = result + to_upper_first(parts[i]);
        i = i + 1;
    }
    return result;
}

// to_snake_case("helloWorld") → "hello_world"  (simple: insert _ before uppercase)
fn to_snake_case(s) {
    let chs = str_split(s, "");
    let out = "";
    for i len(chs) {
        let c = chs[i];
        let code = strcharcodeat(s, i);          // ordering must use codes, not strings
        let is_up = code >= 65 and code <= 90;   // 'A'..'Z'
        if is_up and i > 0 {
            out = out + "_" + str_lower(c);
        } else {
            out = out + c;
        }
    }
    return out;
}

// format(template, args_map) — replace {key} with args_map[key]
// e.g. format("Hello, {name}!", map{ name: "Alice" }) → "Hello, Alice!"
fn format(template, args_map) {
    let result = template;
    let keys = map_keys(args_map);
    for i len(keys) {
        let k = keys[i];
        result = replace_all(result, "{" + k + "}", str(args_map[k]));
    }
    return result;
}

// lstrip(s) — strip leading whitespace only
fn lstrip(s) {
    let i = 0;
    let chs = str_split(s, "");
    while i < len(chs) {
        let c = chs[i];
        if c == " " or c == "\t" or c == "\n" or c == "\r" {
            i = i + 1;
        } else {
            return str_slice(s, i, len(s));
        }
    }
    return "";
}

// rstrip(s) — strip trailing whitespace only
fn rstrip(s) {
    let n = len(s);
    let chs = str_split(s, "");
    let i = n - 1;
    while i >= 0 {
        let c = chs[i];
        if c == " " or c == "\t" or c == "\n" or c == "\r" {
            i = i - 1;
        } else {
            return str_slice(s, 0, i + 1);
        }
    }
    return "";
}

// index_of(s, sub) — first index of sub in s, or -1
fn index_of(s, sub) {
    let parts = str_split(s, sub);
    if len(parts) <= 1 { return -1; }
    return len(parts[0]);
}

// char_at(s, i) — return single character at index i (0-based)
fn char_at(s, i) { return str_slice(s, i, i + 1); }

// is_numeric(s) — true if s parses as a number
fn is_numeric(s) {
    let t = str_trim(s);
    if t == "" { return false; }
    let n = parse_number(t);
    return n != nil;
}

// is_alpha(s) — true if all chars are alphabetic (a-z, A-Z)
fn is_alpha(s) {
    if len(s) == 0 { return false; }
    for i in 0 to len(s) - 1 {
        let code = strcharcodeat(str_lower(s[i]), 0);
        if code < 97 or code > 122 { return false; }   // 'a'..'z'
    }
    return true;
}

// ---------------------------------------------------------------------------
// Extended utilities
// ---------------------------------------------------------------------------

fn _is_ws_char(c) { return c == " " or c == "\t" or c == "\n" or c == "\r"; }

// ord(ch) — Unicode code point of the first character; chr(n) — inverse.
fn ord(ch) { return strcharcodeat(ch, 0); }
fn chr(n) { return str_from_char_code(n); }

// Character-class predicates (operate on the whole string, non-empty).
fn is_digit(s) {
    if len(s) == 0 { return false; }
    for i in 0 to len(s) - 1 {
        let code = strcharcodeat(s, i);
        if code < 48 or code > 57 { return false; }   // '0'..'9'
    }
    return true;
}
fn is_alnum(s) {
    if len(s) == 0 { return false; }
    for i in 0 to len(s) - 1 {
        let code = strcharcodeat(s, i);
        let is_d = code >= 48 and code <= 57;    // '0'..'9'
        let is_u = code >= 65 and code <= 90;    // 'A'..'Z'
        let is_l = code >= 97 and code <= 122;   // 'a'..'z'
        if not (is_d or is_u or is_l) { return false; }
    }
    return true;
}
fn is_space(s) {
    if len(s) == 0 { return false; }
    for i in 0 to len(s) - 1 { if not _is_ws_char(s[i]) { return false; } }
    return true;
}
fn is_upper(s) { return str_upper(s) == s and str_lower(s) != s; }
fn is_lower(s) { return str_lower(s) == s and str_upper(s) != s; }

// swapcase("Hello") → "hELLO"
fn swapcase(s) {
    let out = "";
    for i in 0 to len(s) - 1 {
        let c = s[i];
        let up = str_upper(c);
        let lo = str_lower(c);
        if up == c and lo != c { out = out + lo; }
        else if lo == c and up != c { out = out + up; }
        else { out = out + c; }
    }
    return out;
}

// title_case("hello world") → "Hello World"
fn title_case(s) {
    let parts = str_split(s, " ");
    let out = [];
    for i in 0 to len(parts) - 1 { array_push(out, to_upper_first(str_lower(parts[i]))); }
    return join(out, " ");
}

// to_pascal_case("hello_world" / "hello-world") → "HelloWorld"
fn to_pascal_case(s) {
    let parts = str_split(replace_all(s, "-", "_"), "_");
    let out = "";
    for i in 0 to len(parts) - 1 { out = out + to_upper_first(parts[i]); }
    return out;
}

// to_kebab_case("helloWorld") → "hello-world"
fn to_kebab_case(s) { return replace_all(to_snake_case(s), "_", "-"); }

// last_index_of(s, sub) — last index of sub in s, or -1.
fn last_index_of(s, sub) {
    if sub == "" { return len(s); }
    let n = len(s); let m = len(sub);
    if m > n { return -1; }
    let i = n - m;
    while i >= 0 { if str_slice(s, i, i + m) == sub { return i; } i = i - 1; }
    return -1;
}

// common_prefix("foobar", "foobaz") → "fooba"
fn common_prefix(a, b) {
    let n = len(a); if len(b) < n { n = len(b); }
    let i = 0;
    while i < n and a[i] == b[i] { i = i + 1; }
    return str_slice(a, 0, i);
}
fn common_suffix(a, b) {
    let la = len(a); let lb = len(b);
    let n = la; if lb < n { n = lb; }
    let i = 0;
    while i < n and a[la - 1 - i] == b[lb - 1 - i] { i = i + 1; }
    return str_slice(a, la - i, la);
}

fn remove_prefix(s, p) { if starts_with(s, p) { return str_slice(s, len(p), len(s)); } return s; }
fn remove_suffix(s, suf) { if ends_with(s, suf) { return str_slice(s, 0, len(s) - len(suf)); } return s; }

// center(s, width, pad_char) — pad on both sides to width.
fn center(s, width, pad_char) {
    let n = len(s);
    if n >= width { return s; }
    let total = width - n;
    let left = num_floor(total / 2);
    let right = total - left;
    return repeat(pad_char, left) + s + repeat(pad_char, right);
}

// zfill("-7", 4) → "-007"   (sign-aware left-pad with "0")
fn zfill(s, width) {
    if len(s) == 0 { return pad_left(s, width, "0"); }
    let c = s[0];
    if c == "-" or c == "+" {
        return c + pad_left(str_slice(s, 1, len(s)), width - 1, "0");
    }
    return pad_left(s, width, "0");
}

// partition(s, sep) → [before, sep, after]; not found → [s, "", ""].
fn partition(s, sep) {
    let idx = index_of(s, sep);
    if idx < 0 { return [s, "", ""]; }
    return [str_slice(s, 0, idx), sep, str_slice(s, idx + len(sep), len(s))];
}
// rpartition — split on the last occurrence; not found → ["", "", s].
fn rpartition(s, sep) {
    let idx = last_index_of(s, sep);
    if idx < 0 { return ["", "", s]; }
    return [str_slice(s, 0, idx), sep, str_slice(s, idx + len(sep), len(s))];
}

// splitn(s, sep, n) — split into at most n parts; the last keeps the remainder.
fn splitn(s, sep, n) {
    if n <= 1 { return [s]; }
    let out = [];
    let rest = s;
    let count = 1;
    while count < n {
        let idx = index_of(rest, sep);
        if idx < 0 { count = n; }
        else {
            array_push(out, str_slice(rest, 0, idx));
            rest = str_slice(rest, idx + len(sep), len(rest));
            count = count + 1;
        }
    }
    array_push(out, rest);
    return out;
}

// levenshtein(a, b) — edit distance (insert/delete/substitute cost 1).
fn levenshtein(a, b) {
    let la = len(a); let lb = len(b);
    if la == 0 { return lb; }
    if lb == 0 { return la; }
    let prev = [];
    for j in 0 to lb { array_push(prev, j); }
    let i = 1;
    while i <= la {
        let curr = [i];
        let j = 1;
        while j <= lb {
            let cost = 1;
            if a[i - 1] == b[j - 1] { cost = 0; }
            let del = prev[j] + 1;
            let ins = curr[j - 1] + 1;
            let subst = prev[j - 1] + cost;
            let m = del;
            if ins < m { m = ins; }
            if subst < m { m = subst; }
            array_push(curr, m);
            j = j + 1;
        }
        prev = curr;
        i = i + 1;
    }
    return prev[lb];
}

// slugify("Hello, World!") → "hello-world"
fn slugify(s) {
    let lower = str_lower(str_trim(s));
    let out = "";
    let prev_dash = false;
    for i in 0 to len(lower) - 1 {
        let c = lower[i];
        let code = strcharcodeat(lower, i);
        let is_a = code >= 97 and code <= 122;   // 'a'..'z'
        let is_d = code >= 48 and code <= 57;    // '0'..'9'
        if is_a or is_d { out = out + c; prev_dash = false; }
        else if not prev_dash and out != "" { out = out + "-"; prev_dash = true; }
    }
    if len(out) > 0 and out[len(out) - 1] == "-" { out = str_slice(out, 0, len(out) - 1); }
    return out;
}

// dedent(s) — remove the common leading whitespace from every line.
fn dedent(s) {
    let ls = str_split(s, "\n");
    let min_indent = -1;
    for i in 0 to len(ls) - 1 {
        let line = ls[i];
        if str_trim(line) != "" {
            let k = 0;
            while k < len(line) and (line[k] == " " or line[k] == "\t") { k = k + 1; }
            if min_indent < 0 or k < min_indent { min_indent = k; }
        }
    }
    if min_indent <= 0 { return s; }
    let out = [];
    for i in 0 to len(ls) - 1 {
        let line = ls[i];
        if len(line) >= min_indent { array_push(out, str_slice(line, min_indent, len(line))); }
        else { array_push(out, line); }
    }
    return join(out, "\n");
}

// wrap(s, width) — greedy word wrap into an array of lines.
fn wrap(s, width) {
    let ws = words(s);
    let result = [];
    let current = "";
    for i in 0 to len(ws) - 1 {
        let w = ws[i];
        if current == "" { current = w; }
        else if len(current) + 1 + len(w) <= width { current = current + " " + w; }
        else { array_push(result, current); current = w; }
    }
    if current != "" { array_push(result, current); }
    return result;
}

fn expand_tabs(s, n) { return replace_all(s, "\t", repeat(" ", n)); }

export chars, join, repeat, replace_all, replace_first,
       starts_with, ends_with, contains, trim, upper, lower,
       lines, split, words, pad_left, pad_right, to_upper_first, to_lower_first,
       count, is_empty, truncate, reverse, to_camel_case, to_snake_case,
       format, lstrip, rstrip, index_of, char_at, is_numeric, is_alpha,
       ord, chr, is_digit, is_alnum, is_space, is_upper, is_lower, swapcase,
       title_case, to_pascal_case, to_kebab_case, last_index_of,
       common_prefix, common_suffix, remove_prefix, remove_suffix,
       center, zfill, partition, rpartition, splitn, levenshtein,
       slugify, dedent, wrap, expand_tabs;
