// Ideal loaded divider; reuse the supported nodal solver, no hardware effects.
let DC=import("stdlib:circuits_dc.sapp");
fn _resistance(value) {if type(value)!="number" or not(value>=1 and value<=1000000) {throw "load resistance must be 1..1000000 ohms";}}
fn analyze(vin,top,bottom,load) {
 let model=DC.divider(vin,top,bottom);_resistance(load);
 array_push(model.resistors,map{id:"RL",a:"output",b:"ground",ohms:load});let solved=DC.solve(model);let output=solved.node_volts.output;
 let ratio=bottom/(top+bottom);let loaded_ratio=1/(1+top/bottom+top/load);
 return map{load_ohms:load,unloaded_vout:vin*ratio,loaded_vout:output,voltage_ratio:loaded_ratio,
  reduction_percent:100*(1-loaded_ratio/ratio),source_current_amperes:solved.resistors[0].current_amperes,
  load_current_amperes:solved.resistors[2].current_amperes,load_power_watts:solved.resistors[2].power_watts,
  total_power_watts:solved.total_power_watts,maximum_kcl_residual_amperes:solved.maximum_kcl_residual_amperes};
}
fn linear_loads(low,high,count) {
 _resistance(low);_resistance(high);
 if high<low or type(count)!="number" or not(count>=2 and count<=32) or count!=num_floor(count) {throw "invalid linear load range";}
 let loads=[];for i in range(0,count) {array_push(loads,if i==count-1 {high} else {low+(high-low)*i/(count-1)});}return loads;
}
fn sweep(vin,top,bottom,loads) {
 DC.divider(vin,top,bottom);
 if type(loads)!="array" or len(loads)<1 or len(loads)>32 {throw "sweep needs 1..32 loads";}
 for load in loads {_resistance(load);}
 let rows=[];for load in loads {array_push(rows,analyze(vin,top,bottom,load));}
 return map{format:"pblang.divider-load.v1",vin:vin,top_ohms:top,bottom_ohms:bottom,rows:rows,educational_only:true,hardware_access:false};
}
fn to_csv(vin,top,bottom,loads) {
 let report=sweep(vin,top,bottom,loads);let lines=["load_ohms,unloaded_vout,loaded_vout,voltage_ratio,reduction_percent,source_current_amperes,load_current_amperes,load_power_watts,total_power_watts"];
 for row in report.rows {let values=[];for key in ["load_ohms","unloaded_vout","loaded_vout","voltage_ratio","reduction_percent","source_current_amperes","load_current_amperes","load_power_watts","total_power_watts"] {array_push(values,str(row[key]));}array_push(lines,str_join(values,","));}return str_join(lines,"\n")+"\n";
}
export analyze,linear_loads,sweep,to_csv;
