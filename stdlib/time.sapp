// stdlib/time.sapp — Time utilities.
//
// Builtins: clock() (seconds), now_ms() (unix ms), now_iso() (ISO-8601 string)

let clock   = clock;
let now_ms  = now_ms;
let now_iso = now_iso;

// sleep(ms) — sleep for ms milliseconds
fn sleep(ms) { sleep_ms(ms); }

// duration constants (in milliseconds)
let MS  = 1;
let SEC = 1000;
let MIN = 60000;
let HOUR = 3600000;
let DAY  = 86400000;

// since(start_ms) → elapsed ms since a timestamp
fn since(start_ms) { return now_ms() - start_ms; }

// elapsed_sec(start_ms) → elapsed seconds (float)
fn elapsed_sec(start_ms) { return (now_ms() - start_ms) / 1000; }

// format_duration_ms(ms) → human-readable duration string
fn format_duration_ms(ms) {
    if ms < 1000 {
        return str(ms) + "ms";
    }
    if ms < 60000 {
        let s = ms / 1000;
        return str(num_floor(s)) + "s";
    }
    if ms < 3600000 {
        let m = ms / 60000;
        let s = (ms - num_floor(m) * 60000) / 1000;
        return str(num_floor(m)) + "m " + str(num_floor(s)) + "s";
    }
    let h = ms / 3600000;
    let rem = ms - num_floor(h) * 3600000;
    let m = rem / 60000;
    return str(num_floor(h)) + "h " + str(num_floor(m)) + "m";
}

// stopwatch() → { start_ms, elapsed_ms(), lap() }
fn stopwatch() {
    let start = now_ms();
    let last_lap = start;
    return map{
        start_ms: start,
        elapsed_ms: fn() { return now_ms() - start; },
        lap: fn() {
            let now = now_ms();
            let t = now - last_lap;
            last_lap = now;
            return t;
        },
        reset: fn() {
            start = now_ms();
            last_lap = start;
        }
    };
}

// timeout(ms, fn) — run fn, return its value, or nil if not done in time
// Note: this is approximate; pblang is single-threaded so fn must be fast
fn timeout_check(ms, fn_val) {
    let start = now_ms();
    let result = fn_val();
    let elapsed = now_ms() - start;
    if elapsed > ms {
        return map{ ok: false, error: "timeout after " + str(elapsed) + "ms" };
    }
    return map{ ok: true, value: result };
}

export clock, now_ms, now_iso, sleep,
       MS, SEC, MIN, HOUR, DAY,
       since, elapsed_sec, format_duration_ms, stopwatch, timeout_check;
