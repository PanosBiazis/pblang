// stdlib/backtest.sapp — a minimal, honest strategy backtester (Finance/Quant).
//
// run(prices, signals) replays a long/flat signal series against a price
// series and reports the equity curve plus the metrics a strategy is judged
// by: total return, max drawdown, sharpe, trades and win rate.
//
//   let BT = import("stdlib:backtest.sapp");
//   let r = BT.run(closes, my_signals);   // signals[i]: 1 = long over bar i->i+1, else flat
//   print r.total_return; print r.max_drawdown; print r.sharpe;
//
// Semantics: signals[i] applies over the price move prices[i] -> prices[i+1].
// A round trip opens on the first long bar and closes when the signal drops
// (or at the end of data); it wins if the exit price beats the entry price.
// Honest boundary: no commissions, slippage, or position sizing — this ranks
// strategies, it does not promise live results. Pair with stdlib:risk_gate.sapp
// for the execution-side rules.

fn _sqrt(x) { if x <= 0 { return 0.0; } return num_sqrt(x); }

// run(prices, signals) -> { equity, returns, total_return, max_drawdown,
//                           sharpe, trades, wins, win_rate }
fn run(prices, signals) {
    let equity = [];
    let rets = [];
    let eq = 1.0;
    let peak = 1.0;
    let maxdd = 0.0;
    let trades = 0;
    let wins = 0;
    let in_pos = false;
    let entry = 0.0;
    let i = 0;
    while i < len(prices) - 1 {
        let sig = 0;
        if i < len(signals) { sig = signals[i]; }
        let r = 0.0;
        if sig == 1 { r = (prices[i + 1] - prices[i]) / prices[i]; }
        if sig == 1 and not in_pos { in_pos = true; entry = prices[i]; }
        if sig != 1 and in_pos {
            in_pos = false;
            trades = trades + 1;
            if prices[i] > entry { wins = wins + 1; }
        }
        eq = eq * (1.0 + r);
        push(rets, r);
        push(equity, eq);
        if eq > peak { peak = eq; }
        let dd = (peak - eq) / peak;
        if dd > maxdd { maxdd = dd; }
        i = i + 1;
    }
    if in_pos {
        trades = trades + 1;
        if prices[len(prices) - 1] > entry { wins = wins + 1; }
    }
    let win_rate = 0.0;
    if trades > 0 { win_rate = wins / trades; }
    return map{
        equity: equity,
        returns: rets,
        total_return: eq - 1.0,
        max_drawdown: maxdd,
        sharpe: sharpe(rets),
        trades: trades,
        wins: wins,
        win_rate: win_rate,
    };
}

// sharpe(returns) — mean/std of per-step returns (0 for degenerate series).
// Unannualized on purpose: multiply by sqrt(steps-per-year) for your bar size.
fn sharpe(rets) {
    let n = len(rets);
    if n < 2 { return 0.0; }
    let mean = 0.0;
    let i = 0;
    while i < n { mean = mean + rets[i]; i = i + 1; }
    mean = mean / n;
    let varsum = 0.0;
    i = 0;
    while i < n { let d = rets[i] - mean; varsum = varsum + d * d; i = i + 1; }
    let sd = _sqrt(varsum / n);
    if sd == 0 { return 0.0; }
    return mean / sd;
}

// max_drawdown(equity) — worst peak-to-trough fraction of an equity curve.
fn max_drawdown(equity) {
    let peak = 0.0;
    let maxdd = 0.0;
    let i = 0;
    while i < len(equity) {
        if equity[i] > peak { peak = equity[i]; }
        if peak > 0 {
            let dd = (peak - equity[i]) / peak;
            if dd > maxdd { maxdd = dd; }
        }
        i = i + 1;
    }
    return maxdd;
}

export run, sharpe, max_drawdown;
