// stdlib/browser_render.sapp — host browser snapshot bridge for native pblang.
//
// stdlib/browser.sapp is the safe pblang reader/page engine. This module is the
// optional "exact visual snapshot" path: it asks an installed Chromium/Chrome/Firefox-like
// headless browser to render the real DOM/CSS/JS page into a PNG. Callers need
// --allow-exec, and URL policy is still enforced before any process starts.

let B = import("stdlib:browser.sapp");

fn _ec(r) { if r == nil { return 1; } let e = try r.exit_code catch 1; return e; }

fn candidates() {
    return ["chromium", "chromium-browser", "google-chrome", "google-chrome-stable", "brave-browser", "microsoft-edge", "msedge", "firefox"];
}

fn _which(cmd) {
    let r = try proc_spawn_wait("which", [cmd]) catch nil;
    if r == nil or _ec(r) != 0 { return nil; }
    return str_trim(try r.stdout catch "");
}

fn find_renderer() {
    let cs = candidates();
    let i = 0;
    while i < len(cs) {
        let path = _which(cs[i]);
        if path != nil and path != "" {
            let family = "chromium";
            if cs[i] == "firefox" { family = "firefox"; }
            return map{ ok: true, cmd: cs[i], path: path, family: family };
        }
        i = i + 1;
    }
    return map{ ok: false, error: "no supported headless browser found; install chromium/google-chrome/brave/firefox" };
}

fn render_args(url, output_path, width = 1280, height = 800, family = "chromium") {
    if family == "firefox" {
        return [
            "--headless",
            "--screenshot",
            output_path,
            "--window-size",
            str(width) + "," + str(height),
            url,
        ];
    }
    return [
        "--headless=new",
        "--disable-gpu",
        "--hide-scrollbars",
        "--no-first-run",
        "--disable-extensions",
        "--window-size=" + str(width) + "," + str(height),
        "--screenshot=" + output_path,
        url,
    ];
}

fn render_plan(url, output_path, width = 1280, height = 800, allow_private = false) {
    let pol = B.url_policy(url, allow_private);
    if not pol.ok { return map{ ok: false, error: "blocked by browser policy: " + pol.reason, policy: pol }; }
    let r = find_renderer();
    if not r.ok { return r; }
    return map{ ok: true, cmd: r.cmd, path: r.path, family: r.family, args: render_args(url, output_path, width, height, r.family), output: output_path, policy: pol };
}

fn render_snapshot(url, output_path, width = 1280, height = 800, allow_private = false) {
    let plan = render_plan(url, output_path, width, height, allow_private);
    if not plan.ok { return plan; }
    let r = try proc_spawn_wait(plan.cmd, plan.args) catch nil;
    if r == nil { return map{ ok: false, error: "headless renderer failed to start", plan: plan }; }
    if _ec(r) != 0 {
        return map{ ok: false, error: "headless renderer failed", exit_code: _ec(r), stderr: try r.stderr catch "", plan: plan };
    }
    return map{ ok: true, output: output_path, cmd: plan.cmd, family: try plan.family catch "chromium", args: plan.args, stdout: try r.stdout catch "", stderr: try r.stderr catch "" };
}

export candidates, find_renderer, render_args, render_plan, render_snapshot;
