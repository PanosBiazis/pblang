// Pure admission for canonical module-audit counters and retained categories.
// Successful validation is not provenance or a reusable authorization token.

fn _integer(value) {
    return type(value) == "number" and value == value and value - value == 0
        and value >= 0 and value <= 9007199254740991 and value == num_floor(value);
}

// Fixed work: inspect only consumed numeric options, never caller-sized keys.
// Snapshot verification deliberately ignores scan-only finding/index budgets.
fn bounds_error(options = nil, snapshot = false) {
    if options == nil { options = map{}; }
    if type(options) != "map" or type(snapshot) != "bool" { return "invalid module audit bounds"; }
    let fields = [
        ["max_files_per_module", 10000, 1, 100000],
        ["max_file_bytes", 1048576, 1000, 16777216],
        ["max_depth", 32, 0, 32],
        ["max_entries_per_module", 50000, 1, 50000],
        ["max_children_per_dir", 4096, 1, 4096],
        ["max_runtime_ms_per_module", 300000, 10, 300000]];
    if not snapshot {
        for field in [["max_findings_per_file", 256, 1, 4096],
            ["max_finding_index", 20000, 1, 100000],
            ["max_findings_per_module_index", 20000, 1, 100000],
            ["max_suppressed_per_module_index", 1000, 1, 10000]] { array_push(fields, field); }
    }
    for field in fields {
        let value = try options[field[0]] catch field[1];
        if not _integer(value) or value < field[2] or value > field[3] { return "invalid module audit bounds"; }
    }
    return "";
}

fn _root(root) {
    return type(root) == "string" and len(root) >= 1 and len(root) <= 4096
        and not str_contains(root, "\x00");
}

// Exact labels only: callers normalize paths before admission when needed.
// Empty lists retain the optional requested-coverage convention.
fn roots_error(roots) {
    if type(roots) != "array" or len(roots) > 256 { return "roots must be a bounded array"; }
    let seen = map{};
    for root in roots {
        if not _root(root) { return "invalid module root"; }
        if map_has(seen, root) { return "duplicate module root"; }
        seen[root] = true;
    }
    return "";
}

// Validates only root identity; counter admission remains a separate check.
fn coverage_error(modules, requested_roots) {
    let error = roots_error(requested_roots);
    if error != "" { return error; }
    if type(modules) != "array" or len(modules) > 256 { return "modules must be a bounded array"; }
    let requested = map{}; let seen = map{};
    for root in requested_roots { requested[root] = true; }
    for module in modules {
        if type(module) != "map" or not _root(try module.root catch nil) { return "invalid module root"; }
        let root = module.root;
        if map_has(seen, root) { return "duplicate module root"; }
        if len(requested_roots) > 0 and not map_has(requested, root) { return "module root was not requested"; }
        seen[root] = true;
    }
    return "";
}

fn _member(value, choices) {
    if type(value) != "string" { return false; }
    for choice in choices { if value == choice { return true; } }
    return false;
}

fn _severity(value) { return _member(value, ["high", "medium", "low", "info"]); }
fn _kind(value) { return _member(value, ["security", "reliability", "performance", "incomplete", "roadmap"]); }
fn _role(value) { return _member(value, ["source", "docs", "test", "config", "unknown"]); }

fn _key(key, field) {
    if type(key) != "string" or len(key) > 64 { return false; }
    if field == "counts_severity" { return _severity(key); }
    if field == "counts_kind" { return _kind(key); }
    if field == "counts_role" { return _role(key); }
    let parts = str_split(key, ":");
    if field == "counts_role_severity" {
        return len(parts) == 2 and _role(parts[0]) and _severity(parts[1]);
    }
    return len(parts) == 3 and _role(parts[0]) and _kind(parts[1]) and _severity(parts[2]);
}

fn _fields() { return ["counts_kind", "counts_severity", "counts_role", "counts_role_severity", "counts_role_kind_severity"]; }
fn _scalars() { return ["files_scanned", "finding_count", "suppressed_count", "encoding_degraded_files"]; }
fn _cap(field) {
    if field == "counts_severity" { return 4; }
    if field == "counts_kind" or field == "counts_role" { return 5; }
    if field == "counts_role_severity" { return 20; }
    return 100;
}

fn _count(counts, key) { return try counts[key] catch 0; }

fn _counts_ok(counts, field, total) {
    // map_keys allocates; reject excessive width before asking for its keys.
    if type(counts) != "map" or len(counts) > _cap(field) { return false; }
    let sum = 0;
    for key in map_keys(counts) {
        let value = counts[key];
        if not _key(key, field) or not _integer(value) or value > 9007199254740991 - sum { return false; }
        sum = sum + value;
    }
    return sum == total;
}

fn _increment(counts, key, value) { counts[key] = _count(counts, key) + value; }

fn _matches(actual, expected) {
    // Both maps have admitted finite domains; absent and explicit zero agree.
    for key in map_keys(actual) { if actual[key] != _count(expected, key) { return false; } }
    for key in map_keys(expected) { if expected[key] != _count(actual, key) { return false; } }
    return true;
}

fn module_error(module) {
    if type(module) != "map" or (try module.format catch nil) != "pblang.module_audit.module.v1" {
        return "invalid module report";
    }
    let root = try module.root catch nil;
    if not _root(root) {
        return "invalid module report";
    }
    if type(try module.complete catch nil) != "bool"
        or type(try module.finding_index_truncated catch nil) != "bool" { return "invalid module report"; }
    for field in _scalars() {
        if not _integer(try module[field] catch nil) { return "invalid module report"; }
    }
    if module.encoding_degraded_files > module.files_scanned { return "invalid module report"; }
    let rows = try module.findings catch nil;
    if type(rows) != "array" or len(rows) > 100000 or len(rows) > module.finding_count {
        return "invalid module report";
    }
    if not module.finding_index_truncated and len(rows) != module.finding_count { return "invalid module report"; }
    for field in _fields() {
        if not _counts_ok(try module[field] catch nil, field, module.finding_count) { return "invalid module report"; }
    }

    // The joint counts must project to the four marginal maps exactly.
    // Each nonnegative projection is a subset of the already admitted total.
    let kinds = map{}; let severities = map{}; let roles = map{}; let role_severities = map{};
    for key in map_keys(module.counts_role_kind_severity) {
        let parts = str_split(key, ":"); let n = module.counts_role_kind_severity[key];
        _increment(roles, parts[0], n); _increment(kinds, parts[1], n);
        _increment(severities, parts[2], n); _increment(role_severities, parts[0] + ":" + parts[2], n);
    }
    if not _matches(module.counts_kind, kinds) or not _matches(module.counts_severity, severities)
        or not _matches(module.counts_role, roles) or not _matches(module.counts_role_severity, role_severities) {
        return "invalid module report";
    }

    // A truncated index is a lower bound, never a substitute for full counts.
    let retained = map{};
    for row in rows {
        if type(row) != "map" or not _kind(try row.kind catch nil)
            or not _severity(try row.severity catch nil) or not _role(try row.role catch nil) {
            return "invalid module report";
        }
        let key = row.role + ":" + row.kind + ":" + row.severity;
        let next = _count(retained, key) + 1;
        if next > _count(module.counts_role_kind_severity, key) { return "invalid module report"; }
        retained[key] = next;
    }
    return "";
}

fn modules_error(modules) {
    if type(modules) != "array" or len(modules) > 256 { return "modules must be a bounded array"; }
    // Admit the complete batch before doing any cross-module arithmetic.
    let i = 0;
    while i < len(modules) {
        if module_error(modules[i]) != "" { return "invalid module report at index " + str(i); }
        i = i + 1;
    }
    let root_error = coverage_error(modules, []);
    if root_error != "" { return root_error; }
    let totals = map{}; let groups = map{};
    for field in _fields() { groups[field] = map{}; }
    for module in modules {
        for field in _scalars() {
            let previous = _count(totals, field); let n = module[field];
            if n > 9007199254740991 - previous { return "module audit aggregate counter overflow"; }
            totals[field] = previous + n;
        }
        for field in _fields() {
            let target = groups[field]; let source = module[field];
            for key in map_keys(source) {
                let previous = _count(target, key); let n = source[key];
                if n > 9007199254740991 - previous { return "module audit aggregate counter overflow"; }
                target[key] = previous + n;
            }
        }
    }
    return "";
}

export module_error, modules_error, roots_error, coverage_error, bounds_error;
