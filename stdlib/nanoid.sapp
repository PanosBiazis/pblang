// stdlib/nanoid.sapp — NanoID: compact, URL-safe, random unique IDs.
//
// Smaller and URL-safe vs UUID (default 21 chars from a 64-symbol alphabet). Good for
// short links, object keys, and anywhere a collision-resistant token is needed.
//
//   let nano = import("stdlib:nanoid.sapp");
//   nano.new();                       // "V1StGXR8_Z5jdHi6B-myT"
//   nano.new(10);                     // shorter
//   nano.custom("0123456789", 6);     // numeric-only 6-digit code

// Default URL-safe alphabet (A-Za-z0-9 plus _ and -), 64 symbols.
let _ALPHA = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_-";

// custom(alphabet, size) — id of `size` chars drawn uniformly-ish from `alphabet`.
fn custom(alphabet, size) {
    let n = len(alphabet);
    if n == 0 or size <= 0 { return ""; }
    let rb = random_bytes(size);
    let out = "";
    let i = 0;
    while i < size {
        let idx = num_mod(rb[i], n);
        out = out + str_slice(alphabet, idx, idx + 1);
        i = i + 1;
    }
    return out;
}

// new(size) — a NanoID of `size` chars (default 21) from the URL-safe alphabet.
fn new(size = 21) { return custom(_ALPHA, size); }

// alphabet() — the default alphabet.
fn alphabet() { return _ALPHA; }

// is_valid(s) — every char is in the default alphabet (non-empty).
fn is_valid(s) {
    if type(s) != "string" or len(s) == 0 { return false; }
    let i = 0;
    while i < len(s) {
        if str_index_of(_ALPHA, str_slice(s, i, i + 1)) < 0 { return false; }
        i = i + 1;
    }
    return true;
}

export new, custom, alphabet, is_valid;
