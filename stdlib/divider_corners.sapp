// Fixed ideal supply, independent bounded resistor intervals, exactly eight corners.
let Load=import("stdlib:divider_load.sapp");let Decimal=import("stdlib:measure_table.sapp");
fn _ends(value,percent){
 if type(value)!="number" or not(value>=1 and value<=1000000) {throw "resistance must be 1..1000000 ohms";}
 if type(percent)!="number" or not(percent>=0 and percent<=20) {throw "tolerance must be 0..20 percent";}
 let low=value*(1-percent/100);let high=value*(1+percent/100);
 if low<1 or high>1000000 {throw "all resistance corners must remain within solver limits";}return [low,high];
}
fn analyze(vin,top,bottom,load,top_percent=0,bottom_percent=0,load_percent=0){
 let ts=_ends(top,top_percent);let bs=_ends(bottom,bottom_percent);let ls=_ends(load,load_percent);
 let nominal=Load.analyze(vin,top,bottom,load);let rows=[];let minimum=1001;let maximum= -1001;let min_index=0;let max_index=0;
 for t in range(0,2){for b in range(0,2){for l in range(0,2){
  let result=Load.analyze(vin,ts[t],bs[b],ls[l]);let index=len(rows);
  array_push(rows,map{corner:[t,b,l],top_ohms:ts[t],bottom_ohms:bs[b],load_ohms:ls[l],result:result});
  if result.loaded_vout<minimum {minimum=result.loaded_vout;min_index=index;}
  if result.loaded_vout>maximum {maximum=result.loaded_vout;max_index=index;}
 }}}
 return map{format:"pblang.divider-corners.v1",vin:vin,resistances_ohms:[top,bottom,load],tolerances_percent:[top_percent,bottom_percent,load_percent],
  nominal:nominal,minimum_vout:minimum,maximum_vout:maximum,minimum_corner:min_index,maximum_corner:max_index,rows:rows,educational_only:true,hardware_access:false};
}
fn from_tokens(tokens){if type(tokens)!="array" or len(tokens)!=7 {throw "seven numeric values required";}let v=[];for text in tokens {array_push(v,Decimal.parse_value(text));}return analyze(v[0],v[1],v[2],v[3],v[4],v[5],v[6]);}
export analyze,from_tokens;
