// Literal ASCII-whitespace groups; no normalization or linguistic segmentation.
let MAX_BYTES=65536;
fn _chars(text) {
 if type(text)!="string" or len(text)>MAX_BYTES or len(str_to_bytes(text))>MAX_BYTES {throw "text metrics: byte limit";}
 return str_split(text,"");
}
fn _space(c){return c==" " or c=="\t" or c=="\n" or c=="\r";}
fn count(text){let chars=_chars(text);let words=0;let nonspace=0;let inside=false;
 for c in chars {let space=_space(c);if not space {nonspace=nonspace+1;if not inside {words=words+1;}}inside=not space;}
 return map{characters:len(chars),nonspace_characters:nonspace,words:words};
}
fn tokens(text){let chars=_chars(text);let out=[];let current=[];
 for c in chars {if _space(c){if len(current)>0{array_push(out,str_join(current,""));current=[];}continue;}array_push(current,c);}
 if len(current)>0{array_push(out,str_join(current,""));}return out;
}
export MAX_BYTES,count,tokens;
