// stdlib/app_templates.sapp -- secure pblang-only application blueprints.
//
// These constructors turn one action into CLI, native GUI, and hardened web
// surfaces. Application authors write no HTML/CSS/JavaScript and keep one
// business function shared across every surface.

fn _get(m, key, fallback) {
    if is_map(m) and map_has(m, key) { return m[key]; }
    return fallback;
}

fn _text(value, fallback, limit) {
    let out = str(value);
    if out == "" { out = fallback; }
    if len(out) > limit { out = str_slice(out, 0, limit); }
    return out;
}

fn _html(value) {
    let out = str_replace_all(str(value), "&", "&amp;");
    out = str_replace_all(out, "<", "&lt;");
    out = str_replace_all(out, ">", "&gt;");
    out = str_replace_all(out, "\"", "&quot;");
    return out;
}

fn _invoke(action, surface, payload, context) {
    return action(map{ surface: surface, payload: payload, context: context });
}

// universal_spec(name, action, options) builds a complete multi-surface app.
// app.universal() executes this spec, so the user-facing program remains one
// line while the generated surfaces retain normal app validation/security.
fn universal_spec(name, action, options = nil) {
    if action == nil { throw "app_templates.universal_spec: action is required"; }
    if options == nil { options = map{}; }
    if not is_map(options) { throw "app_templates.universal_spec: options must be a map"; }
    let title = _text(name, "pblang universal app", 128);
    let description = _text(_get(options, "description", "One pblang action, available as CLI, native GUI, and secure Web API."), "Universal pblang app", 512);
    let preview = _get(options, "preview", false);
    let start = str_lower(str(_get(options, "start", "cli")));
    let args = _get(options, "args", []);
    let model = map{ input: _text(_get(options, "input", ""), "", 65536), status: "ready", output: "" };

    let cli_handler = fn(ctx) { return _invoke(action, "cli", ctx.args, ctx); };
    let gui_handler = fn(event) { return _invoke(action, "gui", event, event); };
    let api_handler = fn(ctx) {
        let value = _invoke(action, "web", try ctx.request catch ctx, ctx);
        return ctx.json(map{ ok: true, value: value });
    };
    let home_handler = fn(ctx) {
        return ctx.html("<!doctype html><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
            + "<title>" + _html(title) + "</title><main><h1>" + _html(title) + "</h1><p>" + _html(description)
            + "</p><p>API: <code>POST /api/run</code> · Health: <code>GET /health</code></p></main>");
    };

    return map{
        kind: "fullstack", name: title, preview: preview, start: start,
        cli: map{
            args: args, quiet: _get(options, "quiet", false), handler: cli_handler,
            commands: map{ run: cli_handler, status: fn(ctx) { return "ready"; } }
        },
        gui: map{
            width: _get(options, "width", 760), height: _get(options, "height", 500), model: model,
            widgets: [
                map{ kind: "label", name: "title", text: title, x: 24, y: 24, w: 680, h: 32 },
                map{ kind: "label", name: "description", text: description, x: 24, y: 68, w: 680, h: 48 },
                map{ kind: "textbox", name: "input", bind: "input", x: 24, y: 132, w: 520, h: 36 },
                map{ kind: "button", name: "run", text: "Run", onclick: gui_handler, x: 560, y: 132, w: 140, h: 36 },
                map{ kind: "divider", name: "divider", x: 24, y: 188, w: 676 },
                map{ kind: "textarea", name: "output", bind: "output", x: 24, y: 208, w: 676, h: 188 },
                map{ kind: "progress", name: "progress", value: 100, x: 24, y: 416, w: 676, h: 18 },
                map{ kind: "label", name: "status", bind: "status", x: 24, y: 452, w: 676, h: 24 }
            ]
        },
        web: map{
            host: _get(options, "host", "127.0.0.1"), port: _get(options, "port", 8080),
            allow_public: _get(options, "allow_public", false), request: _get(options, "request", map{ method: "GET", path: "/", headers: map{ "user-agent": "Mozilla/5.0 pblang-app" }, body: "" }),
            routes: [
                map{ method: "GET", path: "/", handler: home_handler },
                map{ method: "GET", path: "/health", handler: fn(ctx) { return ctx.json(map{ status: "ready", app: title }); } },
                map{ method: "POST", path: "/api/run", handler: api_handler }
            ]
        }
    };
}

export universal_spec;
