{
    "git.ignoreLimitWarning": false,
    "files.exclude": {
        "**/target": true,
        "**/target-native": true,
        "**/target-gpu": true,
        "**/target-win": true,
        "**/node_modules": true,
        "doc_out": true,
        "graphify-out": true,
        ".pblang-posix-dirfs-*": true,
        ".pblang-debug*": true
    },
    "search.exclude": {
        "**/target": true,
        "**/target-native": true,
        "**/target-gpu": true,
        "**/target-win": true,
        "**/node_modules": true,
        "doc_out": true,
        "graphify-out": true
    },
    "files.watcherExclude": {
        "**/target/**": true,
        "**/target-native/**": true,
        "**/target-gpu/**": true,
        "**/target-win/**": true,
        "**/node_modules/**": true
    }
}
