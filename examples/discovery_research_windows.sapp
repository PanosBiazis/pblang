let W=import("stdlib:research_windows.sapp");
let spec=map{value_unit:"degF",summary_unit:"degC",value_mode:"absolute",time_unit:"min",timebase:"relative"};
let rows=[map{subject:1,time:0,value:68},map{subject:1,time:1,value:nil},
    map{subject:1,time:3,value:77},map{subject:2,time:3,value:nil},map{subject:1,time:4,value:86}];
let result=W.review(spec,rows,map{start:0,duration:1,count:4});
assert(result.included_rows==4 and result.after_rows==1,"final boundary is outside");
assert(result.state_counts.observed==1 and result.state_counts.all_missing==1
    and result.state_counts.empty==1 and result.state_counts.partial==1,"four meaningful quality states");
assert(result.windows[0].metrics.mean==20 and result.windows[3].metrics.mean==25,"existing temperature conversion");
print json_stringify(map{synthetic:true,description:"Supplied environmental observations, not a live sensor monitor",review:result});
