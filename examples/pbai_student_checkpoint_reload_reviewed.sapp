// Two commands in a fresh private directory: prepare, then recover.
// Synthetic labels demonstrate a bounded application policy, not AI capability.
let AI=import("stdlib/pbai.sapp");let N=import("stdlib:pbai_neural_adapter.sapp");
let IO=import("stdlib:pbai_student_checkpoint_io.sapp");let S=import("stdlib:pbai_checkpoint_scope.sapp");
let R=import("stdlib:resource_scope.sapp");let specialist=AI.neural_specialist_bind(N);
let storage=AI.neural_specialist_checkpoint_bind(IO);let scope=AI.neural_specialist_checkpoint_scope_bind(S);
let directory=env_get("PBAI_CHECKPOINT_TEST_DIR");let phase=env_get("PBAI_RELOAD_PHASE");
assert(type(directory)=="string" and directory!="","explicit fresh private checkpoint directory required");
fn final_close(state){return fn(){let closed=state.close();return map{ok:true,value:closed};};}
fn blocked(predict){return try {predict([6,0]);false} catch true;}
if phase=="prepare" {
 let teacher=specialist.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
 for spec in [map{name:"student.json",label:5,epochs:64},map{name:"better.json",label:5,epochs:128},map{name:"worse.json",label:6,epochs:64}] {
  let trained=specialist.distill_supervised(teacher.artifact,[map{x:[0],y:spec.label}],[map{x:[7,0],y:spec.label}],
   map{epochs:spec.epochs,lr:0.1,temperature:2,hard_weight:1,max_grad_norm:1});
  let receipt=storage.save_new(path_join(directory,spec.name),trained.checkpoint());assert(receipt.ok,"explicit exclusive checkpoint setup");
 }
 print json_stringify(map{format:"pbai.reviewed-reload.setup.v1",created:3,globally_activated:false});
} elif phase=="recover" or phase=="review-error" {
 let loaded=storage.load_file(path_join(directory,"student.json"));
 let state=map{active:loaded,close:loaded.close,initial_predict:loaded.predict,last_predict:loaded.predict};
 let result=R.with_scope(fn(resources){
  resources.defer(final_close(state));let steps=[];
  let names=if phase=="recover" {["missing.json","worse.json","better.json","better.json"]} else {["better.json"]};
  for name in names {
   let current=state.active;let before=current.checkpoint().digest;let heldout=if phase=="review-error" {nil} else {[map{x:[6,0],y:5}]};
   let saved=map{};
   let inspected=try scope.with_file(path_join(directory,name),fn(candidate){
    saved.close=candidate.close;saved.predict=candidate.predict;
    let checkpoint=candidate.checkpoint();let review=current.compare(checkpoint,heldout);
    return map{ok:true,value:map{review:review,checkpoint:if review.passed {checkpoint} else {nil}}};
   }) catch nil;
   let candidate_closed=false;
   if map_has(saved,"close") {candidate_closed=not saved.close() and blocked(saved.predict);assert(candidate_closed,"review candidate always closes");}
   let decision="load_failed";let retired_closed=false;let retired_prediction_blocked=false;let review=map{};
   if inspected!=nil {
    decision="review_failed";
    if inspected.ok {
     review=inspected.value.review;decision="rejected";
     if review.passed {
      decision="unchanged";
      if review.candidate_digest!=before {
       // Rebuild from the exact reviewed detached artifact, never reread its path.
       let next=try specialist.student_load(inspected.value.checkpoint) catch nil;decision="replacement_load_failed";
       if next!=nil {
        let retired_close=state.close;let retired_predict=current.predict;
        state.active=next;state.close=next.close;state.last_predict=next.predict;
        retired_closed=retired_close();retired_prediction_blocked=blocked(retired_predict);decision="replaced";
        assert(retired_closed and retired_prediction_blocked,"retired model is terminal after replacement");
       }
      }
     }
    }
   }
   let previous_prediction_available=not blocked(current.predict);
   assert(previous_prediction_available==(decision!="replaced"),"actual previous prediction alias survives every failed or rejected reload");
   let after=state.active.checkpoint().digest;
   if decision!="replaced" {assert(after==before,"failure/rejection/no-op keeps active checkpoint");}
   push(steps,map{decision:decision,active_token:state.active.predict([6,0]).token,active_digest:after,
    previous_prediction_available:previous_prediction_available,candidate_acquired:map_has(saved,"close"),candidate_closed:candidate_closed,retired_closed:retired_closed,retired_prediction_blocked:retired_prediction_blocked,review:review});
  }
  return map{ok:true,value:steps};
 });
 assert(result.ok and result.cleanup_ok and result.cleanups_attempted==1 and blocked(state.last_predict),"final active handle closes");
 print json_stringify(map{format:"pbai.reviewed-reload.example.v1",steps:result.value,final_active_closed:true,
  initial_prediction_blocked:blocked(state.initial_predict),globally_activated:false});
} else {throw "select prepare, recover or review-error";}
