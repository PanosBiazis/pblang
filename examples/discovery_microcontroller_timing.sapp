let Clock=import("stdlib:sample_clock.sapp");let Samples=import("stdlib:sample_series.sapp");
// Synthetic millisecond counters, not a live UNO/ESP32 acquisition.
let ticks=[4294967280,4,24,44];let values=[1,2,3,4];let timeline=Clock.timeline(ticks,32,100);
let estimates=Samples.interpolate(timeline.elapsed_ticks,values,[10,30,50]);
assert(estimates==[1.5,2.5,3.5],"interpolation remains chronological across rollover");
let review=Clock.period_review(ticks,32,100,20);assert(review.rms_error_ticks==0,"regular synthetic acquisition");
let jitter=Clock.period_review([250,4,15,24],8,30,10);assert(jitter.errors_ticks==[0,1,-1],"early and late intervals");
assert((try Clock.timeline([10,9],32,100) catch nil)==nil,"large backwards step rejected");
print json_stringify(map{timeline:timeline,interpolated_values:estimates,period:review,jitter:jitter,synthetic:true,device_access:false});
