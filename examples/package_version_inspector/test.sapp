let App = import("examples/package_version_inspector/inspector_app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Security = import("stdlib:security_analysis.sapp");
let Comparison = import("examples/package_version_inspector/comparison.sapp");
let GUI = import("stdlib:gui.sapp");

fn require(value, message) {
    if not value { throw "package_version_inspector test failed: " + message; }
}

fn record(bundle, name) {
    for item in bundle.records { if item.name == name { return item; } }
    return nil;
}

let data = App.model();
require(data.manifest.ok and data.manifest.dependency_count == 2,
    "sample manifest must validate without dependency-name disclosure");
require(len(data.manifest.dependency_names) == 0,
    "dependency names must remain private by default");
require(data.packages[0].status == "update-available"
    and data.packages[1].status == "current"
    and data.packages[2].status == "missing",
    "sample package statuses must be deterministic");
for package in data.packages {
    require(not package.executed and not package.dynamic_import_used and package.bounded,
        "package inspection must remain inert and bounded");
}

let view = App.view(data);
let stable = Comparison.model();
let prerelease = Comparison.model("include-prerelease");
require(stable.selection.latest_compatible == "1.3.0"
    and prerelease.selection.latest_compatible == "2.0.0-rc.1",
    "prerelease opt-in must change the compatible candidate");
require(Comparison.model("include-prerelease", "~1.3.0").selection.latest_compatible == "1.3.0",
    "prerelease opt-in must not bypass version requirements");
let missing = Comparison.model("stable", ">=3.0.0");
require(missing.selection.latest_compatible == nil
    and str_contains(Comparison.selection_text(missing), "No compatible release"),
    "empty compatible set must have an explicit explanation");
require((try Comparison.model("unknown") catch nil) == nil,
    "unknown channel selection must fail");
require((try Comparison.model("stable", "nonsense") catch nil) == nil,
    "invalid requirement must fail");
require(stable.releases[0].evidence.structurally_complete
    and not stable.releases[1].evidence.structurally_complete,
    "consistent and incomplete synthetic declarations must stay distinct");
for release in prerelease.releases {
    require(release.identity.ok and not release.identity.contradictory_stability,
        "release identity must agree with semantic version");
    require(not release.evidence.trust_verified and not release.evidence.production_ready
        and str_contains(release.verification_label, "insufficient evidence"),
        "even complete synthetic declarations must not become verified artifacts");
}
require(not stable.executed and not prerelease.installation_authorized,
    "comparison must not authorize execution or installation");
require(UI.validate(view).ok, "shared UI tree must validate");
let web = UI.compile(view, map{ target: "web", width: 320, height: 640 });
let native = UI.compile(view, map{ target: "native", width: 1440, height: 900 });
let android = UI.compile(view, map{ target: "android", width: 360, height: 720 });
for bundle in [web, native, android] {
    require(record(bundle, "brand") != nil, "brand must render on every target");
    require(record(bundle, "inspect_graphics-kit") != nil, "update action must render");
    require(record(bundle, "inspect_data-core") != nil, "current action must render");
    require(record(bundle, "inspect_ui-shell") != nil, "missing action must render");
    require(record(bundle, "inspection_status") != nil, "accessible status must render");
    require(record(bundle, "execution_boundary") != nil, "execution boundary must remain visible");
    require(record(bundle, "channel_stable") != nil and record(bundle, "channel_prerelease") != nil,
        "both channel choices must compile for every target");
    require(record(bundle, "release_0_verification") != nil
        and record(bundle, "release_1_verification") != nil,
        "both evidence boundaries must compile for every target");
}

let native_preview = UI.run("Package comparison", view, map{preview:true, width:1440, height:1400});
for mode in ["include-prerelease", "stable", "include-prerelease", "stable"] {
    let button = if mode == "stable" { "channel_stable" } else { "channel_prerelease" };
    GUI.get(native_preview.form, button).onclick(native_preview.form);
    require(GUI.get(native_preview.form, "comparison_selection").text
        == Comparison.selection_text(Comparison.model(mode)),
        "native action must change channel and candidate repeatedly");
    require(str_contains(GUI.get(native_preview.form, "release_0_verification").text,
        "insufficient evidence"), "channel changes must preserve evidence boundary");
}

let preview = UI.preview_web("Package Version Inspector", view, App.web_options());
require(preview.response.status == 200, "generated Web preview must return HTTP 200");
require(str_contains(preview.generated.html, "viewport-fit=cover"),
    "Web preview must support compact viewports");
require(str_contains(preview.generated.css, "@media(max-width:640px)"),
    "Web preview must include responsive rules");
require(not str_contains(preview.generated.html, "http://")
    and not str_contains(preview.generated.html, "https://"),
    "Web preview must have no remote runtime dependency");
require(App.source_sha256() ==
    "bd9a8a41cdd89325386449d4a7dc1e5b57edddc11c74ecf6b09c7fa6aa27c240",
    "source provenance digest must remain stable");

for source_path in [
    "stdlib/package_inspector.sapp",
    "examples/package_version_inspector/benchmark.sapp",
    "examples/package_version_inspector/inspector_app.sapp",
    "examples/package_version_inspector/comparison.sapp",
    "examples/package_version_inspector/main.sapp",
    "examples/package_version_inspector/test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
        "bounded security analysis must pass for " + source_path);
}

print "package_version_inspector_pass";
