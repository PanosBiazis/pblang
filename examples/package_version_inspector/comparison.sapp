// Synthetic metadata only. A consistent declaration is not verified software.
let Inspector = import("stdlib:package_inspector.sapp");
let Channels = import("stdlib:release_channel.sapp");
let Evidence = import("stdlib:product_release_evidence.sapp");

fn sample_evidence(version, channel, complete) {
    let digest = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    let artifact_digest = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
    let source = Evidence.source("graphics-kit", version, channel, "0.6.0",
        digest, digest, digest, "0123456789abcdef0123456789abcdef01234567",
        map{clean_tree:true, reproducible_inputs:true});
    let artifact = Evidence.artifact(source, "demo-linux", artifact_digest, 4096,
        digest, version, channel, ["linux:x86_64"], map{
            signed_artifact:complete, signature_sha256:if complete { digest } else { "" },
            sbom_sha256:if complete { digest } else { "" },
            attestation_sha256:if complete { digest } else { "" },
            install_verified:complete, upgrade_verified:complete,
            rollback_verified:complete, uninstall_verified:complete
        });
    let report = Evidence.test_report(source, artifact, "demo-suite", digest,
        digest, artifact_digest, 1, 0, 0, ["linux:x86_64"],
        map{complete_suite:true, process_isolated:true});
    let targets = [Evidence.target_requirement("demo-linux", "linux", "x86_64", ["start"])];
    let policy = Evidence.policy("synthetic-comparison", 1, ["demo-linux"], ["demo-suite"], targets);
    let platforms = [];
    if complete {
        array_push(platforms, Evidence.platform_evidence(source, artifact, "linux", "x86_64",
            "synthetic-runner", digest, artifact_digest, ["start"], map{physical:true}));
    }
    return Evidence.evaluate(source, policy, [artifact], [report], platforms);
}

fn model(mode = "stable", requirement = ">=1.0.0") {
    if mode != "stable" and mode != "include-prerelease" {
        throw "package comparison: unsupported channel selection";
    }
    let catalog = [
        map{name:"graphics-kit", version:"1.3.0", source_kind:"local"},
        map{name:"graphics-kit", version:"2.0.0-rc.1", source_kind:"local"}
    ];
    let selection = Inspector.evaluate("graphics-kit", "1.0.0", requirement, catalog,
        map{include_prerelease:mode == "include-prerelease"});
    let releases = [];
    for entry in catalog {
        let stable = entry.version == "1.3.0";
        let channel = if stable { "stable" } else { "rc.1" };
        let identity = Channels.resolve(entry.version,
            map{release_channel:channel, show_release_channel:true});
        let gate = sample_evidence(entry.version, channel, stable);
        let single = Inspector.evaluate(entry.name, "1.0.0", requirement, [entry],
            map{include_prerelease:true});
        array_push(releases, map{
            version:entry.version, identity:identity, compatible:single.available_count == 1,
            evidence:gate, synthetic:true,
            evidence_label:if gate.structurally_complete {
                "Declared evidence: consistent synthetic records"
            } else { "Declared evidence: incomplete synthetic records" },
            verification_label:"Verified artifact / installed code: none; insufficient evidence"
        });
    }
    return map{mode:mode, requirement:requirement, installed:"1.0.0", releases:releases,
        selection:selection, synthetic:true, executed:false, installation_authorized:false};
}

fn selection_text(data) {
    let mode = if data.mode == "stable" { "Stable only" } else { "Include prerelease" };
    let latest = if data.selection.latest_compatible == nil {
        "No compatible release"
    } else { "Latest compatible: " + data.selection.latest_compatible };
    return mode + " | " + latest + " | Metadata only; not an installation recommendation";
}

// Presentation of this example's already-evaluated synthetic release records.
// Do not reinterpret the blockers or turn a complete declaration into trust.
fn evidence_text(release) {
    let text = "Declared evidence for " + release.identity.qualified_version + ".\n";
    if len(release.evidence.blockers) == 0 {
        text = text + "No missing declaration checks under the synthetic comparison policy.\n"
            + "This does not prove that the artifact, signature or installation was checked.";
    } else {
        text = text + "Missing declaration checks (" + str(len(release.evidence.blockers)) + "):\n";
        for blocker in release.evidence.blockers { text = text + "- " + blocker + "\n"; }
    }
    return text + "\n" + release.verification_label;
}

export sample_evidence, model, selection_text, evidence_text;
