let Inspector = import("stdlib:package_inspector.sapp");

let catalog = [];
let i = 0;
while i < 1024 {
    array_push(catalog, map{
        name: "package-" + str(num_mod(i, 128)),
        version: str(num_floor(i / 128) + 1) + "." + str(num_mod(i, 8)) + ".0",
        source_kind: if num_mod(i, 2) == 0 { "local" } else { "registry" }
    });
    i = i + 1;
}
let queries = [];
i = 0;
while i < 128 {
    array_push(queries, map{
        name: "package-" + str(i), installed: "1.0.0", requirement: "*"
    });
    i = i + 1;
}
let reports = Inspector.inspect_many(queries, catalog);
if len(reports) != 128 or reports[0].latest_compatible == nil
   or reports[0].executed or reports[0].dynamic_import_used {
    throw "bounded package inspector benchmark failed";
}
print json_stringify(map{
    format: "pblang.example.package-inspector-benchmark.v1",
    catalog_entries: len(catalog), queries: len(reports),
    process_execution: false, dynamic_import: false, verified: true
});
