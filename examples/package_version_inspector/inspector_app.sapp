let Inspector = import("stdlib:package_inspector.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Comparison = import("examples/package_version_inspector/comparison.sapp");

fn sample_catalog() {
    return [
        map{ name: "graphics-kit", version: "1.0.0", source_kind: "local" },
        map{ name: "graphics-kit", version: "1.3.0", source_kind: "registry" },
        map{ name: "graphics-kit", version: "2.0.0-rc.1", source_kind: "registry" },
        map{ name: "data-core", version: "2.1.0", source_kind: "path" },
        map{ name: "data-core", version: "2.2.1", source_kind: "registry" },
        map{ name: "ui-shell", version: "0.9.0", source_kind: "git" }
    ];
}

fn sample_queries() {
    return [
        map{ name: "graphics-kit", installed: "1.0.0", requirement: "^1.0.0" },
        map{ name: "data-core", installed: "2.2.1", requirement: "~2.2.0" },
        map{ name: "ui-shell", installed: nil, requirement: "*" }
    ];
}

fn sample_manifest() {
    return "[package]\nname = \"version-dashboard\"\nversion = \"1.0.0\"\n"
        + "entry = \"main.sapp\"\n\n[dependencies]\n"
        + "graphics-kit = \"^1.0.0\"\ndata-core = \"~2.2.0\"\n";
}

fn model() {
    return map{
        manifest: Inspector.inspect_manifest_text(sample_manifest()),
        packages: Inspector.inspect_many(sample_queries(), sample_catalog()),
        capabilities: Inspector.capabilities(),
        comparison: Comparison.model()
    };
}

fn _select(package) {
    return UI.action_set_text("inspection_status",
        package.name + ": " + package.status + " (latest " + str(package.latest_compatible) + ")");
}

fn view(data) {
    let cards = [];
    for package in data.packages {
        array_push(cards, UI.card([
            UI.heading(package.name, map{ name: "package_" + package.name + "_title" }),
            UI.text("Declared installed version: " + str(package.installed), map{
                name: "package_" + package.name + "_installed"
            }),
            UI.text("Status: " + package.status, map{
                name: "package_" + package.name + "_status"
            }),
            UI.button("Inspect", _select(package), map{
                name: "inspect_" + package.name,
                accessibility_label: "Inspect " + package.name
            })
        ], map{ name: "package_" + package.name }));
    }
    return UI.screen([
        UI.heading("Package Version Inspector", map{
            name: "brand", accessibility_label: "Package Version Inspector"
        }),
        UI.text("Safe metadata checks without loading package code", map{ name: "subtitle" }),
        UI.text("Choose a package", map{
            name: "inspection_status", accessibility_label: "Current inspection status"
        }),
        UI.grid(cards, map{ name: "package_grid", columns: 3, gap: 12 }),
        comparison_view(data.comparison),
        UI.card([
            UI.heading("Manifest", map{ name: "manifest_title" }),
            UI.text(data.manifest.package.name + " " + data.manifest.package.version,
                map{ name: "manifest_identity" }),
            UI.text(str(data.manifest.dependency_count) + " dependencies; names hidden",
                map{ name: "manifest_privacy" })
        ], map{ name: "manifest_card" }),
        UI.text("No package module, executable or version command was run.", map{
            name: "execution_boundary"
        })
    ], map{ name: "package_inspector_root", gap: 16 });
}

fn comparison_action(mode, requirement = ">=1.0.0") {
    return UI.action_set_text("comparison_selection",
        Comparison.selection_text(Comparison.model(mode, requirement)));
}

fn evidence_action(release) {
    return UI.action_sequence([
        UI.action_set_text("evidence_details_title", "Evidence details: " + release.version),
        UI.action_set_text("evidence_details_text", Comparison.evidence_text(release))
    ]);
}

fn clear_evidence_action() {
    return UI.action_sequence([
        UI.action_set_text("evidence_details_title", "Evidence details"),
        UI.action_set_text("evidence_details_text", "Choose Review evidence on either release.")
    ]);
}

fn comparison_view(data) {
    let cards = [];
    let i = 0;
    for release in data.releases {
        let prefix = "release_" + str(i);
        array_push(cards, UI.card([
            UI.heading(release.identity.qualified_version, map{name:prefix + "_version"}),
            UI.text("Channel: " + release.identity.stability, map{name:prefix + "_channel"}),
            UI.text("Compatible with requirement: " + str(release.compatible),
                map{name:prefix + "_compatible"}),
            UI.text(release.evidence_label, map{name:prefix + "_evidence", wrap:true}),
            UI.text("Missing declaration checks: " + str(len(release.evidence.blockers)),
                map{name:prefix + "_blockers"}),
            UI.text(release.verification_label, map{name:prefix + "_verification", wrap:true}),
            UI.button("Review evidence", evidence_action(release), map{
                name:prefix + "_review", accessibility_label:"Review declared evidence for " + release.version
            })
        ], map{name:prefix}));
        i = i + 1;
    }
    return UI.card([
        UI.heading("Compare releases", map{name:"comparison_title"}),
        UI.text("Synthetic graphics-kit example | Declared current: " + data.installed
            + " | Requirement: " + data.requirement, map{name:"comparison_context", wrap:true}),
        UI.text("Both releases stay visible for comparison. Channel choice changes the latest compatible candidate.",
            map{name:"comparison_help", wrap:true}),
        UI.grid([
            UI.button("Stable only", comparison_action("stable", data.requirement),
                map{name:"channel_stable", accessibility_label:"Compare stable releases only"}),
            UI.button("Include prerelease", comparison_action("include-prerelease", data.requirement),
                map{name:"channel_prerelease", accessibility_label:"Compare including prerelease versions"})
        ], map{name:"channel_controls", columns:2, gap:12}),
        UI.text(Comparison.selection_text(data), map{name:"comparison_selection", wrap:true,
            accessibility_label:"Selected release channel and compatible candidate"}),
        UI.grid(cards, map{name:"release_comparison_grid", columns:2, gap:12}),
        UI.card([
            UI.heading("Evidence details", map{name:"evidence_details_title"}),
            UI.text("Choose Review evidence on either release.", map{
                name:"evidence_details_text", wrap:true
            }),
            UI.text("Reviewing or clearing details does not change the selected release channel or candidate.",
                map{name:"evidence_details_help", wrap:true}),
            UI.button("Clear details", clear_evidence_action(), map{
                name:"evidence_details_clear", accessibility_label:"Clear reviewed evidence details"
            })
        ], map{name:"evidence_details_panel", gap:12}),
        UI.text("All hashes and test/device claims are synthetic. No artifact, signature or installation was verified.",
            map{name:"comparison_boundary", wrap:true})
    ], map{name:"comparison_card", gap:12});
}

fn web_options() {
    return map{
        theme: "light", lang: "en", host: "127.0.0.1", port: 8080,
        width: 1180, height: 820,
        palette: map{
            accent: [0, 126, 112], selected: [204, 91, 48], focus: [0, 95, 204]
        },
        source_sha256: "bd9a8a41cdd89325386449d4a7dc1e5b57edddc11c74ecf6b09c7fa6aa27c240"
    };
}

fn source_sha256() {
    return "bd9a8a41cdd89325386449d4a7dc1e5b57edddc11c74ecf6b09c7fa6aa27c240";
}

export sample_catalog, sample_queries, sample_manifest, model, view, web_options, source_sha256;
export comparison_action, comparison_view, evidence_action, clear_evidence_action;
