let App = import("examples/package_version_inspector/inspector_app.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn main() {
    let data = App.model();
    let compiled = UI.compile(App.view(data), map{ target: "native", width: 1280, height: 800 });
    let updates = 0;
    for package in data.packages { if package.status == "update-available" { updates = updates + 1; } }
    let result = map{
        format: "pblang.example.package-version-inspector.v1",
        packages: len(data.packages), updates: updates,
        manifest_ok: data.manifest.ok, ui_records: len(compiled.records),
        executed: false,
        verified: data.manifest.ok and len(data.packages) == 3 and len(compiled.records) > 0
    };
    print json_stringify(result);
    return result.verified;
}

main();
