// pblang:target=kernel
// pblang:extern heap_init gc_new gc_set_auto gc_alloc gc_set_child gc_add_root gc_remove_root gc_live gc_collections kernel_gc_collect
// QEMU-only: prepend heap.sapp + gc.sapp. Raw count writes are test injection.
fn verify(ok) {if not ok {outb(244,1);while 1>0 {hlt();}}}
fn kmain() {
    let h=kmalloc(8);let region=kmalloc(32768);heap_init(h,region,32768);
    let g=gc_new(h);verify(g!=0);gc_set_auto(g,0);
    let parent=gc_alloc(g,3);let bridge=gc_alloc(g,1);
    let a=gc_alloc(g,0);let b=gc_alloc(g,0);let garbage=gc_alloc(g,0);
    verify(parent!=0 and bridge!=0 and a!=0 and b!=0 and garbage!=0);
    verify(gc_set_child(parent,0,a)==1 and gc_set_child(parent,1,bridge)==1);
    verify(gc_set_child(parent,2,parent)==1 and gc_set_child(bridge,0,b)==1);
    verify(gc_set_child(a,0,b)==0);
    verify(gc_add_root(g,a)==1 and gc_add_root(g,a)==1 and gc_add_root(g,parent)==1);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==4);
    let i=0;while i<1000 {verify(kernel_gc_collect(g)==0 and gc_live(g)==4);i=i+1;}
    verify(gc_remove_root(g,a)==2);verify(kernel_gc_collect(g)==0 and gc_live(g)==4);
    gc_set_child(parent,1,0);verify(kernel_gc_collect(g)==0 and gc_live(g)==2);
    verify(gc_remove_root(g,parent)==1);verify(kernel_gc_collect(g)==0 and gc_live(g)==0);
    // Leaves must count even when they occupy no queue entries. A failed root
    // admission must not sweep or count a successful collection.
    let x=gc_alloc(g,0);let y=gc_alloc(g,0);verify(x!=0 and y!=0);
    verify(gc_add_root(g,x)==1 and gc_add_root(g,y)==1);
    let rounds=gc_collections(g);poke32(g+16,1);
    verify(kernel_gc_collect(g)==0-1);poke32(g+16,2);
    verify(gc_collections(g)==rounds);verify(kernel_gc_collect(g)==0 and gc_live(g)==2);
    poke32(g+44,2147483647);verify(kernel_gc_collect(g)==0 and gc_live(g)==2);
    verify(gc_remove_root(g,x)==1 and gc_remove_root(g,y)==1);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==0);
    // Several queued roots: finishing a null/self edge must still visit later
    // roots, including a chain that ends in a shared branching object.
    x=gc_alloc(g,1);y=gc_alloc(g,1);bridge=gc_alloc(g,1);
    let fork=gc_alloc(g,2);a=gc_alloc(g,0);b=gc_alloc(g,1);
    verify(x!=0 and y!=0 and bridge!=0 and fork!=0 and a!=0 and b!=0);
    verify(gc_set_child(y,0,y)==1 and gc_set_child(bridge,0,fork)==1);
    verify(gc_set_child(fork,0,a)==1 and gc_set_child(fork,1,b)==1 and gc_set_child(b,0,a)==1);
    verify(gc_add_root(g,x)==1 and gc_add_root(g,y)==1);
    verify(gc_add_root(g,bridge)==1 and gc_add_root(g,fork)==1);
    verify(gc_alloc(g,0)!=0);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==6);
    verify(peek32(y+8)==y and peek32(bridge+8)==fork and peek32(b+8)==a);
    verify(gc_remove_root(g,x)==1 and gc_remove_root(g,y)==1);
    verify(gc_remove_root(g,bridge)==1 and gc_remove_root(g,fork)==1);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==0);
    outb(244,42);while 1>0 {hlt();}
}
