let S=import("stdlib:llm_tiered_store.sapp");
let root=env_get("PBAI_STATE_ROOT");
assert(type(root)=="string" and root!="","set a private PBAI_STATE_ROOT for the example");
let dir=path_join(root,"streaming-example");fs_mkdirs(dir);
let mirror_dir=path_join(root,"streaming-mirror");fs_mkdirs(mirror_dir);
let bytes=[1,2,3,4];fs_write_bytes(path_join(dir,"root"),bytes);fs_write_bytes(path_join(mirror_dir,"root"),bytes);
let parts=[S.model_part("expert","root",4,sha256(base64_encode_bytes(bytes)),"expert",0,0,"int4")];
let invalid_options=map{ram_budget_bytes:8,expected_precision:"int4",mirrors:"invalid"};
let invalid=S.create(dir,parts,S.config(8,invalid_options));
assert(not invalid.ok and invalid.code=="config","invalid mirror plan rejected before session creation");
let options=map{ram_budget_bytes:8,expected_precision:"int4",mirrors:[S.mirror(mirror_dir)]};
let session=S.create(dir,parts,S.config(options.ram_budget_bytes,options));assert(session.ok,"session opened");
let preferred=S.weighted_root_for(session,"expert");fs_write_bytes(path_join(preferred,"root"),[9,8,7,6]);
let before=S.status(session);let result=S.load(session,"expert");
assert(result.ok and result.bytes==bytes,"verified shard loaded");
assert(S.status(session).stats.mirror_failovers==1 and result.source_root!=preferred,"corrupted preferred shard falls back to verified mirror");
let retained=S.load(session,"expert");result.bytes[0]=99;push(result.bytes,255);
let fresh=S.load(session,"expert");
assert(retained.bytes==bytes and fresh.bytes==bytes and fresh.size==4 and fresh.verified,"caller edits cannot poison cached bytes or sibling results");
let active=S.status(session);assert(before.stats.loads==0 and active.stats.loads==3,"earlier snapshot preserved");
active.stats.loads=999;assert(S.status(session).stats.loads==3,"snapshot edits remain local");
assert(S.close(session),"session closed");
let refused=S.record_routes(session,0,[0]);
assert(not refused.ok and refused.code=="closed","closed session rejects reuse");
let closed=S.status(session);assert(not closed.ok and closed.resident_bytes==0,"closed status available");
assert(closed.cleanup.attempted and closed.cleanup.confirmed_handles==2 and closed.cleanup.unconfirmed_handles==0 and closed.cleanup.first_error==nil,"actual directory handle close confirmed");
assert(retained.bytes==bytes and fresh.bytes==bytes,"caller retains successful outputs");
print json_stringify(map{format:"pbai.streaming.lifecycle-example.v1",snapshot_isolated:true,byte_results_isolated:true,cleanup_confirmed:true,initialization_preflight:true,mirror_failover:true,literal_shard_path:true,
 closed_reuse_refused:true,prior_output_preserved:true,resident_bytes:closed.resident_bytes});
