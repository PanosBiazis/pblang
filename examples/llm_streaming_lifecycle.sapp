let S=import("stdlib:llm_tiered_store.sapp");
let root=env_get("PBAI_STATE_ROOT");
assert(type(root)=="string" and root!="","set a private PBAI_STATE_ROOT for the example");
let dir=path_join(root,"streaming-example");fs_mkdirs(dir);
let bytes=[1,2,3,4];fs_write_bytes(path_join(dir,"expert.bin"),bytes);
let parts=[S.model_part("expert","expert.bin",4,sha256(base64_encode_bytes(bytes)),"expert",0,0,"int4")];
let options=map{ram_budget_bytes:8,expected_precision:"int4"};
let session=S.create(dir,parts,S.config(options.ram_budget_bytes,options));assert(session.ok,"session opened");
let before=S.status(session);let result=S.load(session,"expert");
assert(result.ok and result.bytes==bytes,"verified shard loaded");
let active=S.status(session);assert(before.stats.loads==0 and active.stats.loads==1,"earlier snapshot preserved");
active.stats.loads=999;assert(S.status(session).stats.loads==1,"snapshot edits remain local");
assert(S.close(session),"session closed");
let refused=S.record_routes(session,0,[0]);
assert(not refused.ok and refused.code=="closed","closed session rejects reuse");
let closed=S.status(session);assert(not closed.ok and closed.resident_bytes==0,"closed status available");
assert(result.bytes==bytes,"caller retains successful output");
print json_stringify(map{format:"pbai.streaming.lifecycle-example.v1",snapshot_isolated:true,
 closed_reuse_refused:true,prior_output_preserved:true,resident_bytes:closed.resident_bytes});
