// The native product and PBLang example share one implementation.
let CRUD = import("stdlib:crud_preview.sapp");
let args = try env_get("PBLANG_SCRIPT_ARGS") catch "";
if args == "--serve" { CRUD.serve(); }
elif args == "--serve-account" { CRUD.serve_account_demo(); }
elif args == "--init-saved-accounts" or args == "--serve-saved-accounts" {
    let catalog=try env_get("PBLANG_CRUD_ACCOUNTS_FILE") catch nil;
    if catalog==nil or catalog=="" {throw "PBLANG_CRUD_ACCOUNTS_FILE is required";}
    if args=="--init-saved-accounts" {CRUD.initialize_saved_account_demo(catalog);}
    else {
        let records=try env_get("PBLANG_CRUD_FILE") catch nil;
        if records==nil or records=="" {throw "PBLANG_CRUD_FILE is required";}
        CRUD.serve_saved_accounts(records,catalog);
    }
}
elif args == "--init-persistent" or args == "--serve-persistent" or args == "--serve-persistent-account" {
    let path = try env_get("PBLANG_CRUD_FILE") catch nil;
    if args == "--init-persistent" {
        let Persistent = import("stdlib:crud_persistent.sapp");
        Persistent.initialize(path); print "Private snapshot initialized.";
    } elif args == "--serve-persistent-account" {
        if path == nil or path == "" { throw "PBLANG_CRUD_FILE is required"; }
        CRUD.serve_account_demo(path);
    } else { CRUD.serve_persistent(path); }
}
elif args == "" or args == nil { print CRUD.demo(); }
else { throw "usage: main.sapp [--serve | --serve-account | --serve-persistent-account | --init-persistent | --serve-persistent | --init-saved-accounts | --serve-saved-accounts]"; }
