let A = import("stdlib:async.sapp");
// Task exceptions keep the documented nil-result behavior.
let values = A.pool(2, [fn(){return 7;}, fn(){throw "example task failure";}]);
assert(values == [7,nil], "ordinary task failure remains a result");
// A function cannot travel through the result channel. The owning pool throws
// only after joining its workers and draining abandoned queue values.
let rejected = try {
    A.pool(2, [fn(){return fn(){return 1;};}, fn(){return 2;}]);
    false
} catch true;
assert(rejected, "non-transferable result rejected");
assert(A.pool(1,[fn(){return 9;}]) == [9], "next pool remains usable");
print "Pool failure cleaned up; next pool returned 9.";
