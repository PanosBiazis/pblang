// pblang:target=kernel
// pblang:extern heap_init heap_alloc heap_free _guarded_heap_free_from _kernel_memory_enter _kernel_memory_leave gc_new gc_set_auto gc_alloc gc_add_root gc_remove_root gc_set_child kernel_gc_collect gc_live
// QEMU-only fixture. Prepend kernel/heap.sapp and kernel/gc.sapp.
fn verify(ok) { if not ok {outb(244,1);while 1>0 {hlt();}} }
fn kmain() {
    let h=kmalloc(8);let arena=kmalloc(3072);let values=kmalloc(384);
    let round=0;
    while round<3 {
        heap_init(h,arena,3072);let i=0;
        while i<96 {
            let p=heap_alloc(h,16);verify(p==arena+i*24+8);
            poke32(values+i*4,p);poke32(p,1000+i);i=i+1;
        }
        let flags=_kernel_memory_enter();let cursor=0;i=0;
        while i<96 {
            // Ascending, descending and permuted orders cover cursor reuse,
            // head restart, forward/backward merging and both-neighbor merging.
            let index=i;
            if round==1 {index=95-i;}
            if round==2 {index=(i*37)%96;}
            let p=peek32(values+index*4);verify(peek32(p)==1000+index);
            cursor=_guarded_heap_free_from(h,p,cursor);
            verify(cursor>=arena and cursor<=p-8);
            i=i+1;
        }
        verify(peek32(h)==arena and peek32(arena)==3072 and peek32(arena+4)==0);
        _kernel_memory_leave(flags);
        let full=heap_alloc(h,3064);verify(full==arena+8);heap_free(h,full);
        verify(peek32(h)==arena and peek32(arena)==3072);
        round=round+1;
    }
    let gh=kmalloc(8);let region=kmalloc(32768);heap_init(gh,region,32768);
    let g=gc_new(gh);verify(g!=0);gc_set_auto(g,0);let i=0;
    while i<64 {
        let p=gc_alloc(g,1);verify(p!=0);gc_set_child(p,0,p);poke32(values+i*4,p);
        if i%3==0 {verify(gc_add_root(g,p)==1);}i=i+1;
    }
    // Reorder valid owned entries to reproduce allocation-address disorder.
    // Direct metadata writes are a test operation, not an application API.
    let objects=peek32(g+20);i=0;
    while i<64 {poke32(objects+i*4,peek32(values+((i*37)%64)*4));i=i+1;}
    verify(kernel_gc_collect(g)==0 and gc_live(g)==22);
    i=0;while i<64 {
        if i%3==0 {let p=peek32(values+i*4);verify(peek32(p+8)==p);verify(gc_remove_root(g,p)==1);}
        i=i+1;
    }
    verify(kernel_gc_collect(g)==0 and gc_live(g)==0);
    let large=heap_alloc(gh,24000);verify(large!=0);heap_free(gh,large);
    outb(244,42);while 1>0 {hlt();}
}
