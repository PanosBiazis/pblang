// Loopback framing: header delimiter followed by a bounded body, no disk writes.
let TCP=import("stdlib:native_tcp.sapp");let Net=import("stdlib:net.sapp");
if platform()!="linux" or not TCP.available().ok {throw "this example needs the tested Linux TCP boundary";}
let listener=TCP.listen_ipv4("127.0.0.1",0,4);assert(listener.ok,"listener");
let done=channel();let worker=spawn(fn(){
    let client=Net.connect("127.0.0.1:"+str(listener.port));
    Net.write(client,"BODY 9\r\n123456789");Net.close(client);send(done.sender,true);
});
let peer=TCP.accept_bounded(listener,1000);let failure=false;
try {
    assert(peer.ok,"accept");
    let header=TCP.read_until(peer,"\r\n",64,1000);
    let first=TCP.read_available_bytes(peer,3,1000,20);
    assert(header.ok and header.text=="BODY 9\r\n" and first.ok and first.count<=3,"header and bounded first part");
    let rest=TCP.read_exact_bytes(peer,9-first.count,1000);
    assert(rest.ok and bytes_to_str(first.bytes)+bytes_to_str(rest.bytes)=="123456789","no dropped or repeated body bytes");
} catch {failure=true;};
TCP.close(peer);TCP.close(listener);recv_timeout(done.receiver,2000);join(worker);
assert(not failure,"frame exchange failed after cleanup");
print "native_tcp_frames_pass";
