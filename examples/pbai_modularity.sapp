// Import only the selected provider at top level, preserving package lock context.
let AI=import("stdlib/pbai.sapp");
let SENSOR=import("stdlib:pbai_sensor.sapp");
let RESOLVER=import("stdlib:controlled_modularity.sapp");
let binding=AI.modular_bind_limited("sensor-v1",SENSOR,RESOLVER,map{max_calls:1});
let probe=binding.report();assert(probe.ok,"sensor capability verified");
let result=binding.run(map{values:[2,4,6,100],period_seconds:1,sigma:3,absolute_tolerance:1});
assert(result.status=="result" and result.output.status=="result" and result.output.value.outlier,"selected adapter execution");
print json_stringify(map{probe:probe,result:result});

let metrics=binding.metrics();
assert(metrics.executed_calls==1 and metrics.provider_results==1,"actual call observed");
assert(not metrics.retains_payloads and not metrics.authorizes_action,"private operational evidence only");
binding.clear_metrics();
assert(binding.metrics().observed_calls==0 and binding.report().ok,"clearing statistics preserves binding");

assert(binding.status().remaining_calls==0 and binding.run(nil).error=="call_limit_reached","clearing metrics does not renew call budget");
assert(binding.cancel() and binding.run(nil).error=="binding_cancelled","owner stops future calls");
assert(not binding.status().preemption and not binding.status().in_flight,"honest synchronous lifecycle");
