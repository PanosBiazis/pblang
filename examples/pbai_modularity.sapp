// Import only the selected provider at top level, preserving package lock context.
let AI=import("stdlib/pbai.sapp");
let SENSOR=import("stdlib:pbai_sensor.sapp");
let RESOLVER=import("stdlib:controlled_modularity.sapp");
let binding=AI.modular_bind("sensor-v1",SENSOR,RESOLVER);
let probe=binding.report();assert(probe.ok,"sensor capability verified");
let result=binding.run(map{values:[2,4,6,100],period_seconds:1,sigma:3,absolute_tolerance:1});
assert(result.status=="result" and result.output.status=="result" and result.output.value.outlier,"selected adapter execution");
print json_stringify(map{probe:probe,result:result});
