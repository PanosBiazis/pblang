let compute = import("stdlib:compute.sapp");

let cpu = [
    map{ kind: "cpu", present: true, usable: true, available: true, units: 8, weight: 8 },
];
let heterogeneous = [
    cpu[0],
    map{ kind: "gpu", present: true, usable: true, available: true, units: 1, weight: 32 },
];

let cheap = compute.select_device(128, cpu, compute.policy(map{
    preferred_device: "cpu", min_parallel_items: 1, max_workers: 8,
    workload: "generic",
}));

let heavy = compute.select_device(128, cpu, compute.policy(map{
    preferred_device: "cpu", min_parallel_items: 1, max_workers: 8,
    work_units_per_item: 4096,
}));

let tensor = compute.select_device(2, heterogeneous, compute.policy(map{
    preferred_device: "gpu", workload: "tensor", min_accelerator_items: 1,
}));

print "cheap=" + cheap.device + "/" + cheap.mode + " workers=" + str(cheap.workers);
print "heavy=" + heavy.device + "/" + heavy.mode + " workers=" + str(heavy.workers);
print "tensor=" + tensor.device + "/" + tensor.mode
    + " work=" + str(tensor.estimate.work_units)
    + " required=" + str(tensor.cost.required_work_units);

