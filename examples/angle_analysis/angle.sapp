let MATH = import("stdlib:math.sapp");

let FORMAT = "pblang.example.angle-analysis.v1";
let MAX_ABS_DEGREES = 1000000000000;
let AXIS_EPSILON = 0.000000001;
let VALUE_EPSILON = 0.0000000001;

fn _bounded_number(value) {
    let encoded = if type(value) == "number" { json_stringify(value) } else { "null" };
    return type(value) == "number" and encoded != "null" and encoded != ""
        and num_abs(value) <= MAX_ABS_DEGREES;
}

fn parse_degrees(text) {
    if type(text) != "string" {
        return map{ ok: false, error: "angle must be text" };
    }
    let clean = str_trim(text);
    if len(clean) < 1 or len(clean) > 64
       or not regex_match(clean, "^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)$") {
        return map{ ok: false, error: "angle must be a bounded decimal number" };
    }
    let value = try parse_number(clean) catch nil;
    if not _bounded_number(value) {
        return map{ ok: false, error: "angle is outside the supported range" };
    }
    return map{ ok: true, value: value };
}

fn normalize_degrees(value) {
    if not _bounded_number(value) { throw "angle_analysis: invalid degree value"; }
    let normalized = num_mod(value, 360.0);
    if normalized < 0 { normalized = normalized + 360.0; }
    if num_abs(normalized) <= AXIS_EPSILON
       or num_abs(normalized - 360.0) <= AXIS_EPSILON {
        return 0.0;
    }
    return normalized;
}

fn _near(value, expected) { return num_abs(value - expected) <= AXIS_EPSILON; }

fn _location(normalized) {
    if _near(normalized, 0) {
        return map{ axis: "positive-x", quadrant: 0, reference_degrees: 0 };
    }
    if _near(normalized, 90) {
        return map{ axis: "positive-y", quadrant: 0, reference_degrees: 0 };
    }
    if _near(normalized, 180) {
        return map{ axis: "negative-x", quadrant: 0, reference_degrees: 0 };
    }
    if _near(normalized, 270) {
        return map{ axis: "negative-y", quadrant: 0, reference_degrees: 0 };
    }
    if normalized < 90 {
        return map{ axis: nil, quadrant: 1, reference_degrees: normalized };
    }
    if normalized < 180 {
        return map{ axis: nil, quadrant: 2, reference_degrees: 180 - normalized };
    }
    if normalized < 270 {
        return map{ axis: nil, quadrant: 3, reference_degrees: normalized - 180 };
    }
    return map{ axis: nil, quadrant: 4, reference_degrees: 360 - normalized };
}

fn _snap(value) {
    if num_abs(value) <= VALUE_EPSILON { return 0.0; }
    if num_abs(value - 1.0) <= VALUE_EPSILON { return 1.0; }
    if num_abs(value + 1.0) <= VALUE_EPSILON { return -1.0; }
    return value;
}

fn analyze_degrees(degrees, precision = 5) {
    if not _bounded_number(degrees) {
        return map{ ok: false, error: "degrees must be a finite bounded number" };
    }
    if type(precision) != "number" or precision != num_floor(precision)
       or precision < 0 or precision > 12 {
        return map{ ok: false, error: "precision must be an integer in 0..12" };
    }

    let normalized = normalize_degrees(degrees);
    let radians = MATH.deg_to_rad(normalized);
    let sine = _snap(MATH.sin(radians));
    let cosine = _snap(MATH.cos(radians));
    let tangent = nil;
    if num_abs(cosine) > VALUE_EPSILON { tangent = sine / cosine; }
    let location = _location(normalized);

    return map{
        ok: true,
        format: FORMAT,
        input_degrees: degrees,
        normalized_degrees: normalized,
        input_radians: MATH.deg_to_rad(degrees),
        normalized_radians: radians,
        sine: sine,
        cosine: cosine,
        tangent: tangent,
        axis: location.axis,
        quadrant: location.quadrant,
        reference_degrees: location.reference_degrees,
        unit_vector: map{ x: cosine, y: sine },
        display: map{
            degrees: MATH.round_to(normalized, precision),
            radians: MATH.round_to(radians, precision),
            sine: MATH.round_to(sine, precision),
            cosine: MATH.round_to(cosine, precision),
            tangent: if tangent == nil { nil } else { MATH.round_to(tangent, precision) }
        }
    };
}

export FORMAT, MAX_ABS_DEGREES, parse_degrees, normalize_degrees, analyze_degrees;
