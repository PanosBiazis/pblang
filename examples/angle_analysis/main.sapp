let OS = import("stdlib:os.sapp");
let ANGLE = import("angle.sapp");

fn usage() {
    print "Usage: pblang run examples/angle_analysis/main.sapp -- <degrees> [precision]";
}

fn main() {
    let args = OS.script_args();
    if len(args) < 1 or len(args) > 2 {
        usage();
        return false;
    }

    let parsed = ANGLE.parse_degrees(args[0]);
    if not parsed.ok {
        print "Invalid angle: " + parsed.error;
        return false;
    }
    let precision = 5;
    if len(args) == 2 { precision = try parse_number(args[1]) catch -1; }
    let report = ANGLE.analyze_degrees(parsed.value, precision);
    if not report.ok {
        print "Unable to analyze angle: " + report.error;
        return false;
    }

    print "Angle analysis";
    print "Input: " + str(report.input_degrees) + " degrees";
    print "Normalized: " + str(report.display.degrees) + " degrees";
    print "Radians: " + str(report.display.radians);
    print "Sine: " + str(report.display.sine);
    print "Cosine: " + str(report.display.cosine);
    print "Tangent: " + if report.display.tangent == nil {
        "undefined"
    } else { str(report.display.tangent) };
    if report.axis != nil {
        print "Location: " + report.axis + " axis";
    } else {
        print "Location: quadrant " + str(report.quadrant)
            + ", reference angle " + str(report.reference_degrees) + " degrees";
    }
    return true;
}

main();
