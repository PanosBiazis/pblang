let ANGLE = import("angle.sapp");

fn require(condition, message) {
    if not condition { throw "FAIL angle_analysis: " + message; }
}

fn near(a, b, epsilon) { return num_abs(a - b) <= epsilon; }

let zero = ANGLE.analyze_degrees(0, 8);
require(zero.ok and zero.axis == "positive-x" and zero.quadrant == 0,
    "zero degrees is on the positive x axis");
require(zero.sine == 0 and zero.cosine == 1 and zero.tangent == 0,
    "zero-degree trigonometric values are exact");

let right = ANGLE.analyze_degrees(90, 8);
require(right.axis == "positive-y" and right.quadrant == 0,
    "90 degrees is on the positive y axis");
require(right.sine == 1 and right.cosine == 0 and right.tangent == nil,
    "tangent is undefined when cosine is zero");

let negative = ANGLE.analyze_degrees(-90, 8);
require(negative.normalized_degrees == 270 and negative.axis == "negative-y",
    "negative angles normalize without losing their input");
require(negative.input_degrees == -90 and negative.input_radians < 0,
    "the report preserves signed input and its direct radian conversion");

let multi_turn = ANGLE.analyze_degrees(855, 8);
require(multi_turn.normalized_degrees == 135 and multi_turn.quadrant == 2
    and multi_turn.reference_degrees == 45,
    "multi-turn angles classify by their normalized direction");
require(near(multi_turn.sine, 0.707106781, 0.000001)
    and near(multi_turn.cosine, -0.707106781, 0.000001)
    and near(multi_turn.tangent, -1, 0.000001),
    "quadrant-two values preserve trigonometric signs");

require(ANGLE.parse_degrees("  -450.5 ").value == -450.5,
    "bounded decimal parsing accepts whitespace and fractions");
require(not ANGLE.parse_degrees(90).ok
    and not ANGLE.parse_degrees("").ok
    and not ANGLE.parse_degrees("1e3").ok
    and not ANGLE.parse_degrees("NaN").ok
    and not ANGLE.parse_degrees(str_repeat("9", 128)).ok,
    "non-text, exponent, non-finite, and oversized forms fail closed");
require(not ANGLE.analyze_degrees(ANGLE.MAX_ABS_DEGREES + 1, 5).ok,
    "numeric magnitude is bounded");
require(not ANGLE.analyze_degrees(30, -1).ok
    and not ANGLE.analyze_degrees(30, 13).ok
    and not ANGLE.analyze_degrees(30, 2.5).ok,
    "display precision is bounded to exact integers in 0..12");

print "angle_analysis_pass";
