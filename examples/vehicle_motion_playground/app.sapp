let Vehicle = import("examples/vehicle_motion_playground/vehicle.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");
let Math = import("stdlib:math.sapp");

fn model() {
    let drive = Vehicle.sample_drive();
    let scene2d = Vehicle.scene_2d(drive.state);
    let scene3d = Vehicle.scene_3d(drive.state);
    return map{
        drive: drive,
        plan_2d: Visual.compile(scene2d),
        plan_3d: Visual.compile(scene3d),
        visual_2d: Visual.summarize(scene2d),
        visual_3d: Visual.summarize(scene3d)
    };
}

fn _status(message) { return UI.action_set_text("drive_status", message); }

fn view(data) {
    return UI.screen([
        UI.heading("Vehicle Motion Playground", map{
            name: "brand", accessibility_label: "Vehicle Motion Playground"
        }),
        UI.text("One deterministic drive model for desktop, Web and Android", map{
            name: "subtitle"
        }),
        UI.text("Ready", map{
            name: "drive_status", accessibility_label: "Current drive status"
        }),
        UI.row([
            UI.button("Forward", _status("Accelerating"), map{
                name: "drive_forward", accessibility_label: "Accelerate forward"
            }),
            UI.button("Reverse", _status("Reversing"), map{
                name: "drive_reverse", accessibility_label: "Accelerate in reverse"
            }),
            UI.button("Left", _status("Steering left"), map{
                name: "steer_left", accessibility_label: "Steer left"
            }),
            UI.button("Right", _status("Steering right"), map{
                name: "steer_right", accessibility_label: "Steer right"
            }),
            UI.button("Brake", _status("Braking"), map{
                name: "drive_brake", accessibility_label: "Apply brake"
            })
        ], map{ name: "drive_controls", responsive: true, gap: 8 }),
        UI.grid([
            UI.card([
                UI.heading("Drive", map{ name: "drive_title" }),
                UI.text("Speed " + str(Math.round(data.drive.state.speed)), map{ name: "speed" }),
                UI.text("Distance " + str(Math.round(data.drive.state.distance)), map{
                    name: "distance"
                }),
                UI.text(str(data.drive.timing.steps) + " fixed updates", map{ name: "steps" })
            ], map{ name: "drive_card" }),
            UI.card([
                UI.heading("2D", map{ name: "mode_2d_title" }),
                UI.text(str(data.visual_2d.draw_nodes) + " procedural nodes", map{
                    name: "mode_2d_nodes"
                }),
                UI.button("Show 2D", _status("2D plan selected"), map{
                    name: "select_2d", accessibility_label: "Select two dimensional view"
                })
            ], map{ name: "mode_2d_card" }),
            UI.card([
                UI.heading("3D", map{ name: "mode_3d_title" }),
                UI.text(str(data.visual_3d.draw_nodes) + " procedural nodes", map{
                    name: "mode_3d_nodes"
                }),
                UI.button("Show 3D", _status("3D plan selected"), map{
                    name: "select_3d", accessibility_label: "Select three dimensional view"
                })
            ], map{ name: "mode_3d_card" })
        ], map{ name: "mode_grid", columns: 3, gap: 12 }),
        UI.text("No image file, network request or foreign game runtime is required.", map{
            name: "runtime_boundary"
        })
    ], map{ name: "vehicle_motion_root", gap: 16 });
}

fn web_options() {
    return map{
        theme: "light", lang: "en", host: "127.0.0.1", port: 8080,
        width: 1180, height: 800,
        palette: map{
            accent: [0, 126, 112], selected: [204, 91, 48], focus: [0, 95, 204]
        },
        source_sha256: Vehicle.source_hashes().vehicle_2d
    };
}

export model, view, web_options;
