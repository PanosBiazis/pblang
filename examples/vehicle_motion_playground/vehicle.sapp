let Game = import("stdlib:game.sapp");
let Visual = import("stdlib:visual_engine.sapp");
let Math = import("stdlib:math.sapp");

let PI = 3.141592653589793;
let TWO_PI = 6.283185307179586;
let CAR_HALF_WIDTH = 18;
let CAR_HALF_LENGTH = 36;

fn _number(value, minimum, maximum, label) {
    if type(value) != "number" or str_contains(str_lower(str(value)), "nan")
       or str_contains(str_lower(str(value)), "inf")
       or value < minimum or value > maximum {
        throw "vehicle: " + label + " must be finite and in "
            + str(minimum) + ".." + str(maximum);
    }
    return value;
}

fn _dimension(value, label) {
    value = _number(value, 160, 4096, label);
    if num_floor(value) != value { throw "vehicle: " + label + " must be a whole number"; }
    return value;
}

fn _normalize_angle(angle) {
    let wrapped = num_mod(angle + PI, TWO_PI);
    if wrapped < 0 { wrapped = wrapped + TWO_PI; }
    return wrapped - PI;
}

fn new_state(width = 640, height = 480) {
    width = _dimension(width, "world width");
    height = _dimension(height, "world height");
    return map{
        format: "pblang.example.vehicle-state.v1",
        x: width / 2, y: height / 2, heading: 0, speed: 0,
        distance: 0, collisions: 0, world_width: width, world_height: height
    };
}

fn controls(throttle = 0, steering = 0, brake = false) {
    if type(brake) != "bool" { throw "vehicle: brake must be boolean"; }
    return map{
        throttle: _number(throttle, -1, 1, "throttle"),
        steering: _number(steering, -1, 1, "steering"),
        brake: brake
    };
}

fn _copy_state(state) {
    if type(state) != "map" { throw "vehicle: state must be a map"; }
    return map{
        format: "pblang.example.vehicle-state.v1",
        x: _number(try state.x catch nil, -1000000, 1000000, "x"),
        y: _number(try state.y catch nil, -1000000, 1000000, "y"),
        heading: _number(try state.heading catch nil, -1000000, 1000000, "heading"),
        speed: _number(try state.speed catch nil, -1000, 1000, "speed"),
        distance: _number(try state.distance catch nil, 0, 1000000000000, "distance"),
        collisions: _number(try state.collisions catch nil, 0, 1000000000, "collisions"),
        world_width: _dimension(try state.world_width catch nil, "world width"),
        world_height: _dimension(try state.world_height catch nil, "world height")
    };
}

fn step(state, input, dt_seconds) {
    let next = _copy_state(state);
    let command = controls(try input.throttle catch 0, try input.steering catch 0,
        try input.brake catch false);
    let dt = _number(dt_seconds, 0.0001, 0.1, "step duration");
    if command.brake {
        next.speed = Game.move_toward(next.speed, 0, 260 * dt);
    } elif command.throttle != 0 {
        let acceleration = if command.throttle > 0 { 125 } else { 90 };
        next.speed = next.speed + command.throttle * acceleration * dt;
    } else {
        next.speed = Game.move_toward(next.speed, 0, 24 * dt);
    }
    next.speed = Game.clamp(next.speed, -70, 180);
    let speed_ratio = Game.clamp(next.speed / 90, -1, 1);
    next.heading = _normalize_angle(next.heading + command.steering * 2.3 * speed_ratio * dt);
    let travelled = next.speed * dt;
    next.x = next.x + Game.vec2_from_angle(next.heading - PI / 2, travelled).x;
    next.y = next.y + Game.vec2_from_angle(next.heading - PI / 2, travelled).y;
    next.distance = next.distance + num_abs(travelled);

    let hit = false;
    if next.x < CAR_HALF_WIDTH { next.x = CAR_HALF_WIDTH; hit = true; }
    if next.x > next.world_width - CAR_HALF_WIDTH {
        next.x = next.world_width - CAR_HALF_WIDTH; hit = true;
    }
    if next.y < CAR_HALF_LENGTH { next.y = CAR_HALF_LENGTH; hit = true; }
    if next.y > next.world_height - CAR_HALF_LENGTH {
        next.y = next.world_height - CAR_HALF_LENGTH; hit = true;
    }
    if hit { next.speed = 0; next.collisions = next.collisions + 1; }
    return next;
}

fn timing_state() { return map{ accumulator_ms: 0, dropped_ms: 0, frames: 0, steps: 0 }; }

fn advance_frame(state, input, elapsed_ms, timing = nil, max_steps = 8) {
    if timing == nil { timing = timing_state(); }
    if type(timing) != "map" { throw "vehicle: timing state must be a map"; }
    let accumulator = _number(try timing.accumulator_ms catch 0, 0, 16.6666666667,
        "timing accumulator");
    let dropped_before = _number(try timing.dropped_ms catch 0, 0, 1000000000000,
        "dropped time");
    let frames_before = _number(try timing.frames catch 0, 0, 1000000000, "frame count");
    let steps_before = _number(try timing.steps catch 0, 0, 1000000000, "step count");
    let plan = Game.fixed_step_plan(accumulator, elapsed_ms, 16.6666666667, max_steps);
    let next = _copy_state(state);
    let i = 0;
    while i < plan.steps {
        next = step(next, input, plan.step_seconds);
        i = i + 1;
    }
    return map{
        state: next,
        plan: plan,
        timing: map{
            accumulator_ms: plan.accumulator_ms,
            dropped_ms: dropped_before + plan.dropped_ms,
            frames: frames_before + 1,
            steps: steps_before + plan.steps
        }
    };
}

fn sample_drive() {
    let state = new_state();
    let timing = timing_state();
    let frame = 0;
    while frame < 150 {
        let steering = 0.45;
        if frame < 70 { steering = 0; }
        let input = controls(1, steering, frame >= 130);
        let elapsed = 18;
        if frame % 3 == 0 { elapsed = 15; }
        elif frame % 3 == 1 { elapsed = 17; }
        let result = advance_frame(state, input, elapsed, timing);
        state = result.state;
        timing = result.timing;
        frame = frame + 1;
    }
    return map{
        format: "pblang.example.vehicle-drive.v1",
        state: state, timing: timing, deterministic: true, bounded: true
    };
}

fn _world_point(state, x, y) {
    let rotated = Game.vec2_rotate(Game.vec2(x, y), state.heading);
    return [state.x + rotated.x, state.y + rotated.y];
}

fn scene_2d(state, width = 640, height = 480) {
    width = _dimension(width, "viewport width");
    height = _dimension(height, "viewport height");
    let scene = Visual.scene(width, height, map{
        title: "Vehicle Motion Playground 2D", backend: "portable-2d",
        bg: [25, 37, 45, 255]
    });
    Visual.add(scene, Visual.rect("road", 20, 20, width - 40, height - 40,
        [57, 64, 72, 255]));
    let lane = 70;
    while lane < height - 30 {
        Visual.add(scene, Visual.line2d("lane-" + str(lane), width / 2, lane,
            width / 2, lane + 30, [243, 196, 72, 255], 3));
        lane = lane + 55;
    }
    let body = [
        _world_point(state, -CAR_HALF_WIDTH, -CAR_HALF_LENGTH),
        _world_point(state, CAR_HALF_WIDTH, -CAR_HALF_LENGTH),
        _world_point(state, CAR_HALF_WIDTH, CAR_HALF_LENGTH),
        _world_point(state, -CAR_HALF_WIDTH, CAR_HALF_LENGTH)
    ];
    Visual.add(scene, Visual.polygon2d("vehicle-body", body, [0, 126, 112, 255], true));
    for wheel in [[-20, -22], [20, -22], [-20, 22], [20, 22]] {
        let point = _world_point(state, wheel[0], wheel[1]);
        Visual.add(scene, Visual.circle2d("wheel-" + str(wheel[0]) + "-" + str(wheel[1]),
            point[0], point[1], 5, [23, 27, 31, 255], true));
    }
    Visual.add(scene, Visual.text("speed", 30, 32,
        "Speed " + str(Math.round(state.speed)) + " | Collisions " + str(state.collisions),
        [244, 247, 250, 255], 14));
    return scene;
}

fn _box(id, width, height, depth, color, transform) {
    let node = Visual.cube3d(id, 0, 0, 0, 1, color);
    node.transform = transform;
    node.transform.scale = [width, height, depth];
    return node;
}

fn scene_3d(state, width = 800, height = 600) {
    width = _dimension(width, "viewport width");
    height = _dimension(height, "viewport height");
    let scene = Visual.scene(width, height, map{
        title: "Vehicle Motion Playground 3D", backend: "portable-3d",
        pipeline: "forward-3d", bg: [30, 43, 48, 255]
    });
    let px = (state.x - state.world_width / 2) / 55;
    let pz = (state.y - state.world_height / 2) / 55;
    Visual.add(scene, Visual.camera3d("camera", 8, 7, 10, [0, 0, 0], map{ fov: 55 }));
    Visual.add(scene, Visual.light3d("key-light", "directional", 4, 8, 3,
        [255, 244, 214, 255], 1.2));
    Visual.add(scene, Visual.terrain("road", 14, 18, [], map{ material: "asphalt", lod: "fixed" }));
    Visual.add(scene, _box("body", 2.2, 0.55, 4.2, [0, 126, 112, 255],
        Visual.transform3d(px, 0.75, pz, 0, 0 - state.heading, 0)));
    Visual.add(scene, _box("cabin", 1.7, 0.7, 1.9, [72, 145, 168, 255],
        Visual.transform3d(px, 1.35, pz + 0.15, 0, 0 - state.heading, 0)));
    for wheel in [[-1.2, -1.35], [1.2, -1.35], [-1.2, 1.35], [1.2, 1.35]] {
        Visual.add(scene, _box("wheel-3d-" + str(wheel[0]) + "-" + str(wheel[1]),
            0.35, 0.65, 0.8, [25, 28, 31, 255],
            Visual.transform3d(px + wheel[0], 0.45, pz + wheel[1], 0, 0 - state.heading, 0)));
    }
    return scene;
}

fn source_hashes() {
    return map{
        vehicle_2d: "390a410f2bb237cfb11d06c073159dff3a35caa1e40826ff2c68aa26748e495d",
        vehicle_3d: "781fe94c04a952e6e4cab53488c9f4c9fac17a54895b4ed37131ad91c2e24bf1"
    };
}

export new_state, controls, step, timing_state, advance_frame, sample_drive;
export scene_2d, scene_3d, source_hashes;
