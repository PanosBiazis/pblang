let Vehicle = import("examples/vehicle_motion_playground/vehicle.sapp");
let App = import("examples/vehicle_motion_playground/app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "vehicle_motion_playground test failed: " + message; }
}

fn near(actual, expected, tolerance, message) {
    if num_abs(actual - expected) > tolerance {
        throw "vehicle_motion_playground test failed: " + message
            + " actual=" + str(actual) + " expected=" + str(expected);
    }
}

fn record(bundle, name) {
    for item in bundle.records { if item.name == name { return item; } }
    return nil;
}

fn rejected(callable) { return (try { callable(); false } catch true); }

let original = Vehicle.new_state();
let accelerated = Vehicle.step(original, Vehicle.controls(1, 0, false), 0.1);
require(accelerated.speed > 0 and accelerated.y < original.y,
    "forward throttle must accelerate along the initial heading");
require(original.speed == 0 and original.y == 240,
    "physics steps must not mutate caller state");
let turned = Vehicle.step(accelerated, Vehicle.controls(1, 1, false), 0.1);
require(turned.heading > 0 and turned.x > accelerated.x,
    "steering while moving must rotate and redirect the vehicle");
let braked = Vehicle.step(turned, Vehicle.controls(0, 0, true), 0.1);
require(num_abs(braked.speed) < num_abs(turned.speed), "brake must reduce speed");

let edge = Vehicle.new_state();
edge.y = 36.1; edge.speed = 100;
let collision = Vehicle.step(edge, Vehicle.controls(1, 0, false), 0.1);
require(collision.y == 36 and collision.speed == 0 and collision.collisions == 1,
    "world boundary must clamp and stop the vehicle");

let timing = Vehicle.timing_state();
let stalled = Vehicle.advance_frame(Vehicle.new_state(), Vehicle.controls(1, 0, false),
    1000, timing, 4);
require(stalled.plan.steps == 4 and stalled.plan.dropped_steps > 0
    and stalled.timing.dropped_ms > 0,
    "long frames must use bounded catch-up and report dropped time");
let sample = Vehicle.sample_drive();
require(sample.deterministic and sample.bounded and sample.timing.frames == 150
    and sample.timing.steps > 100 and sample.state.distance > 0,
    "sample drive must finish with deterministic bounded work");

let plan2d = Visual.compile(Vehicle.scene_2d(sample.state, 320, 480));
let plan3d = Visual.compile(Vehicle.scene_3d(sample.state, 800, 600));
require(len(plan2d.draw) >= 8 and len(plan3d.draw) == 9,
    "procedural 2D and 3D plans must contain complete vehicle geometry");
require(len(plan2d.assets) == 0 and len(plan3d.assets) == 0,
    "render plans must not depend on missing or remote assets");
require(plan2d.render.backend == "portable-2d" and plan3d.render.backend == "portable-3d",
    "each scene must declare its portable renderer contract");

let data = App.model();
let tree = App.view(data);
require(UI.validate(tree).ok, "shared UI tree must validate");
for bundle in [
    UI.compile(tree, map{ target: "web", width: 320, height: 640 }),
    UI.compile(tree, map{ target: "native", width: 1440, height: 900 }),
    UI.compile(tree, map{ target: "android", width: 360, height: 720 })
] {
    require(record(bundle, "brand") != nil and record(bundle, "drive_status") != nil,
        "brand and accessible status must render on every target");
    require(record(bundle, "drive_forward") != nil and record(bundle, "drive_brake") != nil,
        "touch and keyboard-neutral drive controls must render");
    require(record(bundle, "select_2d") != nil and record(bundle, "select_3d") != nil,
        "view selectors must render");
    require(record(bundle, "runtime_boundary") != nil,
        "runtime boundary must remain visible");
}
let preview = UI.preview_web("Vehicle Motion Playground", tree, App.web_options());
require(preview.response.status == 200
    and str_contains(preview.generated.html, "viewport-fit=cover")
    and str_contains(preview.generated.css, "@media(max-width:640px)"),
    "Web preview must be responsive on compact viewports");
require(not str_contains(preview.generated.html, "http://")
    and not str_contains(preview.generated.html, "https://"),
    "Web preview must have no remote runtime dependency");

let hashes = Vehicle.source_hashes();
require(hashes.vehicle_2d ==
    "390a410f2bb237cfb11d06c073159dff3a35caa1e40826ff2c68aa26748e495d",
    "2D source digest must remain stable");
require(hashes.vehicle_3d ==
    "781fe94c04a952e6e4cab53488c9f4c9fac17a54895b4ed37131ad91c2e24bf1",
    "3D source digest must remain stable");
require(rejected(fn() { Vehicle.controls(2, 0, false); }),
    "out-of-range throttle must fail");
require(rejected(fn() { Vehicle.step(Vehicle.new_state(), Vehicle.controls(), 1); }),
    "oversized physics steps must fail");

for source_path in [
    "stdlib/game.sapp",
    "examples/vehicle_motion_playground/app.sapp",
    "examples/vehicle_motion_playground/benchmark.sapp",
    "examples/vehicle_motion_playground/main.sapp",
    "examples/vehicle_motion_playground/test.sapp",
    "examples/vehicle_motion_playground/vehicle.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
        "bounded security analysis must pass for " + source_path);
}

print "vehicle_motion_playground_pass";
