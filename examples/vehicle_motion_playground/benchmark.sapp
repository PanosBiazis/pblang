let Vehicle = import("examples/vehicle_motion_playground/vehicle.sapp");
let Visual = import("stdlib:visual_engine.sapp");

let state = Vehicle.new_state();
let timing = Vehicle.timing_state();
let frames = 4096;
let i = 0;
while i < frames {
    let steering = if i % 120 < 60 { 0.25 } else { 0 - 0.25 };
    let input = Vehicle.controls(0.7, steering, false);
    let result = Vehicle.advance_frame(state, input, 16, timing);
    state = result.state;
    timing = result.timing;
    i = i + 1;
}
let plan2d = Visual.compile(Vehicle.scene_2d(state));
let plan3d = Visual.compile(Vehicle.scene_3d(state));
print json_stringify(map{
    format: "pblang.example.vehicle-motion-benchmark.v1",
    frames: frames, fixed_steps: timing.steps, dropped_ms: timing.dropped_ms,
    distance: state.distance, nodes_2d: len(plan2d.draw), nodes_3d: len(plan3d.draw)
});
