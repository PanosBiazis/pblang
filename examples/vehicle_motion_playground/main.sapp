let App = import("examples/vehicle_motion_playground/app.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn main() {
    let data = App.model();
    let native = UI.compile(App.view(data), map{ target: "native", width: 1280, height: 800 });
    let result = map{
        format: "pblang.example.vehicle-motion-playground.v1",
        speed: data.drive.state.speed,
        distance: data.drive.state.distance,
        fixed_steps: data.drive.timing.steps,
        nodes_2d: len(data.plan_2d.draw),
        nodes_3d: len(data.plan_3d.draw),
        ui_records: len(native.records),
        verified: len(data.plan_2d.draw) >= 8 and len(data.plan_3d.draw) >= 8
            and len(native.records) > 0
    };
    print json_stringify(result);
    return result.verified;
}

main();
