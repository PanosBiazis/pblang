let AI=import("stdlib/pbai.sapp");
let R=import("stdlib:resource_scope.sapp");
fn close_owned(closer){return fn(){return map{ok:true,value:closer()};};}
fn use_owned(scope){
print json_stringify(AI.neural_specialist_student_tool(map{op:"capabilities"}));
let holdout=[map{x:[7,0],y:4}];
let teacher=AI.neural_specialist_train([map{x:[0],y:4}],holdout);
let seed=AI.neural_specialist_distill(teacher.artifact,[[0],[1,0]],holdout);
scope.defer(close_owned(seed.close));
let checkpoint=seed.checkpoint();assert(seed.close(),"release checkpoint seed");
let active=AI.neural_specialist_student_load(checkpoint);
scope.defer(close_owned(active.close));
let original=json_stringify(active.predict([2,0]));
print json_stringify(AI.neural_specialist_student_tool(map{op:"predict_batch",checkpoint:checkpoint,contexts:[[2,0],[3,0]],include_logits:false}));
print json_stringify(AI.neural_specialist_student_tool(map{op:"compare",baseline:checkpoint,candidate:checkpoint,examples:holdout}));

// Tool batches own their private handles; this independently loaded active model
// remains the caller's responsibility after successful or rejected requests.
let rejected=AI.neural_specialist_student_tool(map{op:"predict_batch",checkpoint:checkpoint,contexts:[[2,0],[]],include_logits:false});
assert(rejected.error=="invalid_request" and rejected.result==nil,"no partial malformed batch");
assert(json_stringify(active.predict([2,0]))==original,"independent active model retained");
assert(active.close(),"caller closes its own active model");
print json_stringify(map{format:"pbai.student-tool.ownership-example.v1",active_preserved:true,active_closed:true});
return map{ok:true,value:nil};
}
let result=R.with_scope(use_owned);
assert(result.ok and result.cleanup_ok,"tools workflow and explicit cleanup complete");
