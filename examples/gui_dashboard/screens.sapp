// examples/gui_dashboard/screens.sapp
// Screen metadata used by PBIDE Designer tabs.

fn screens() {
    return [
        map{ id: "dashboard", title: "Dashboard", target: "gui", preset: "app_shell" },
        map{ id: "settings", title: "Settings", target: "gui", preset: "form_stack" },
        map{ id: "metrics", title: "Metrics", target: "gui", preset: "chart_panel" }
    ];
}

fn main() {
    let s = screens();
    print "screen_count=" + str(len(s));
    for i len(s) {
        print str(i + 1) + ". " + s[i].title + " -> " + s[i].preset;
    }
}

main();

