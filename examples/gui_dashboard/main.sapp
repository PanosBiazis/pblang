// examples/gui_dashboard/main.sapp
// PBIDE GUI dashboard starter. Safe to run: prints an optimized render plan.

let UI = import("stdlib/micro_gui.sapp");

fn build_dashboard() {
    let app = UI.app("PBIDE Dashboard", 720, 420);
    UI.add(app, UI.label("title", "Project Dashboard"));
    UI.add(app, UI.label("subtitle", "Build, test, preview and ship from one screen"));
    UI.add(app, UI.field("search", "", "search files or commands"));
    UI.add(app, UI.progress("build", 0.72));
    UI.add(app, UI.progress("tests", 0.91));
    UI.add(app, UI.checkbox("watch", "Watch project", true));
    UI.add(app, UI.checkbox("gpu", "Prefer GPU rendering", true));
    UI.add(app, UI.button("run", "Run"));
    UI.add(app, UI.button("preview", "Preview"));
    UI.add(app, UI.button("settings", "Settings"));
    UI.layout_column(app, 18, 18, 260, 8, 8, 8, 4);
    return app;
}

fn main() {
    let app = build_dashboard();
    let plan = UI.prepare(app, 7, 10, 5, map{ backend: "portable", gpu_present: true });
    print "dashboard=" + app.title;
    print "widgets=" + str(len(app.widgets));
    print "commands=" + str(plan.command_count);
    print "hits=" + str(plan.hit_count);
    print "route=" + str(plan.device.route);
    print "cost=" + str(plan.cost.weight);
}

main();

