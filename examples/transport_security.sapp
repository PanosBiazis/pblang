let Guard = import("stdlib:transport_security.sapp");

let identity = Guard.signal_fingerprint("peer-address", "paired-device-public-id");
let monitor = Guard.new(map{ expected_identity: identity });
let result = Guard.observe(monitor, map{
    transport: "wifi", purpose: "connectivity", protocol: "pbremote-e2e",
    application_authenticated: true, identity_fingerprint: identity,
    sequence: 0, nonce: "example-nonce-0001",
    gateway_fingerprint: Guard.signal_fingerprint("gateway", "local-gateway")
});
print json_stringify(map{ result: result, status: Guard.status(monitor) });
