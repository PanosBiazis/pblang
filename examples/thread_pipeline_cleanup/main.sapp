let T=import("stdlib:thread.sapp");
// Every stage finishes before the next begins. One worker preserves ordering.
let pipeline=T.pipeline([
    map{workers:1,process:fn(x){return x*2;}},
    map{workers:1,process:fn(x){if x==4 {return nil;}return x+1;}}
]);
let result=T.pipeline_run(pipeline,[1,2,3]);
assert(result==[3,7],"complete pipeline results");
print json_stringify(result);
