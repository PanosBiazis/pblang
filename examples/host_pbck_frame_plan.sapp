let Plan = import("stdlib:host_pbck_frame_plan.sapp");

// Platform backends lower this canonical flat plan instead of recursively
// decoding PBCK functions and closure captures themselves.
let decoded = map{
    format: "host-pbck-v1", version: 1,
    chunk: map{
        instructions: [map{ op: 0, operand: 0 }, map{ op: 33 }],
        constants: ["portable frame plan"], source_name: nil
    }
};
let plan = Plan.build_decoded(decoded);
let report = Plan.stats(plan);

print "format=" + report.format;
print "functions=" + str(report.functions);
print "instructions=" + str(report.instructions);
print "result_constant=" + Plan.constant_at(plan, plan.root_function, 0);
