// Web Server Example — full-featured HTTP server with routing
let server = import("stdlib:http_server.sapp");
let log = import("stdlib:log.sapp");

log.set_format("text");
log.info("Starting web server...", nil);

// Create the app
let app = server.app_new();

// Middleware: logging
server.app_use(app, server.mw_log());

// Middleware: rate limiting (10 req/second)
server.app_use(app, server.mw_rate_limit(10, 1000));

// Routes
server.app_get(app, "/", fn(req) {
    return server.res.ok_json(map{
        message: "Hello from pblang!",
        version: "0.5.1"
    });
});

server.app_get(app, "/health", fn(req) {
    return server.res.ok_json(map{ status: "ok" });
});

server.app_get(app, "/users/:id", fn(req) {
    let user_id = req.params.id;
    return server.res.ok_json(map{
        id: user_id,
        name: "User " + user_id
    });
});

server.app_post(app, "/echo", fn(req) {
    return server.res.ok_json(map{
        echo: req.body,
        headers: req.headers
    });
});

// Start server
print "Server running on http://127.0.0.1:8080";
server.serve_forever_app("127.0.0.1:8080", app);
