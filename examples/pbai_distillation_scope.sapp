// Trusted explicit binding and synchronous ownership; synthetic token examples.
let AI=import("stdlib/pbai.sapp");let N=import("stdlib:pbai_neural_adapter.sapp");
let R=import("stdlib:resource_scope.sapp");let specialist=AI.neural_specialist_bind(N);
fn cleanup(closer){return fn(){return map{ok:true,value:closer()};};}
fn use(student,mode){return fn(scope){
 scope.defer(cleanup(student.close));
 if mode=="bad_predict" {student.predict([]);}
 if mode=="overlap_evaluate" {student.evaluate([map{x:[0],y:4}]);}
 return map{ok:true,value:student.predict([6,0])};
};}
let teacher=specialist.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let seed=specialist.distill(teacher.artifact,[[0]],[map{x:[7,0],y:4}]);
let active=specialist.student_load(seed.checkpoint());assert(seed.close(),"seed owner cleanup");
let before=json_stringify(active.predict([6,0]));let outcomes=[];
for mode in ["success","bad_predict","overlap_evaluate","success"] {
 let student=specialist.distill(teacher.artifact,[[0]],[map{x:[7,0],y:4}]);
 let predict=student.predict;let result=R.with_scope(use(student,mode));
 let closed=try {predict([6,0]);false} catch true;
 assert(result.cleanup_ok and result.cleanups_attempted==1 and closed and not student.close(),"scope retires private model on every exit");
 assert(result.ok==(mode=="success") and json_stringify(active.predict([6,0]))==before,"caller model survives failed use and recovery");
 push(outcomes,map{mode:mode,ok:result.ok,body_status:result.body_status,closed:closed});
}
assert(active.close(),"caller owns active model cleanup");
print json_stringify(map{format:"pbai.distillation-scope.example.v1",outcomes:outcomes,
 active_preserved:true,physical_memory_release_verified:false});
