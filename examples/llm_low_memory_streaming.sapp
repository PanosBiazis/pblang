let Store = import("stdlib:llm_tiered_store.sapp");

fn digest(bytes) { return sha256(base64_encode_bytes(bytes)); }

let root = "/tmp/pblang-llm-streaming-example";
try proc_spawn_wait("/bin/rm", ["-rf", "--", root]) catch nil;
fs_mkdirs(root);
let dense = str_to_bytes("dense-weights");
let expert_a = str_to_bytes("expert-a-weights");
let expert_b = str_to_bytes("expert-b-weights");
fs_write_bytes(root + "/dense.bin", dense);
fs_write_bytes(root + "/expert-a.bin", expert_a);
fs_write_bytes(root + "/expert-b.bin", expert_b);

let shards = [
    Store.model_part("dense-0", "dense.bin", len(dense), digest(dense), "dense", 0, -1, "int4"),
    Store.model_part("expert-0-0", "expert-a.bin", len(expert_a), digest(expert_a), "expert", 0, 0, "int4"),
    Store.model_part("expert-0-1", "expert-b.bin", len(expert_b), digest(expert_b), "expert", 0, 1, "int4")
];
let runtime = Store.create(root, shards, Store.config(64, map{
    expected_precision: "int4", prefetch_capacity: 2, hot_slots: 1
}));
if not runtime.ok { throw runtime.error; }

let resident = Store.load(runtime, "dense-0", true);
Store.record_routes(runtime, 0, [1, 1, 0, 1]);
Store.queue_expert_prefetch(runtime, 0, 1);
Store.run_prefetch(runtime, 1);
let expert = Store.load(runtime, Store.predict_experts(runtime, 0, 1)[0]);

print json_stringify(map{
    dense_verified: resident.verified,
    hot_expert: Store.predict_experts(runtime, 0, 1)[0],
    expert_cache_hit: expert.cache_hit,
    status: Store.status(runtime)
});
Store.close(runtime);
try proc_spawn_wait("/bin/rm", ["-rf", "--", root]) catch nil;
