let App = import("examples/native_document_studio/document_studio.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn main() {
    let data = App.model();
    let compiled = UI.compile(App.view(data), map{ target: "native", width: 1280, height: 800 });
    let result = map{
        format: "pblang.example.native-document-studio.v1",
        pdf_bytes: data.document.byte_length,
        pages: data.inspection.pages,
        title: data.inspection.title,
        images: data.inspection.images,
        links: data.inspection.links,
        ui_records: len(compiled.records),
        exported: false,
        verified: data.inspection.ok and data.inspection.pages == 1
            and len(compiled.records) > 0
    };
    print json_stringify(result);
    return result.verified;
}

main();
