let App = import("examples/native_document_studio/document_studio.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "native_document_studio test failed: " + message; }
}

fn record(bundle, name) {
    for item in bundle.records { if item.name == name { return item; } }
    return nil;
}

let data = App.model();
require(data.inspection.ok and data.inspection.pages == 1
    and data.inspection.images == 1 and data.inspection.links == 1,
    "sample document must generate and inspect deterministically");
require(data.document.table_rows == 4 and len(data.inspection.rendered_text) == 12,
    "all table, image and link content must remain visible to inspection");
require(not data.document.privacy.author_embedded
    and not data.document.privacy.creator_embedded
    and not data.document.privacy.source_path_embedded,
    "identity and machine path metadata must remain absent");

let tree = App.view(data);
require(UI.validate(tree).ok, "shared UI tree must validate");
let web = UI.compile(tree, map{ target: "web", width: 320, height: 640 });
let native = UI.compile(tree, map{ target: "native", width: 1440, height: 900 });
let android = UI.compile(tree, map{ target: "android", width: 360, height: 720 });
for bundle in [web, native, android] {
    require(record(bundle, "brand") != nil, "brand must render on every target");
    require(record(bundle, "document_status") != nil, "accessible status must render");
    require(record(bundle, "prepare_pdf") != nil, "prepare action must render");
    require(record(bundle, "inspect_pdf") != nil, "inspect action must render");
    require(record(bundle, "review_limits") != nil, "limits action must render");
    require(record(bundle, "export_boundary") != nil, "explicit export boundary must render");
}

let preview = UI.preview_web("Native Document Studio", tree, App.web_options());
require(preview.response.status == 200, "generated Web preview must return HTTP 200");
require(str_contains(preview.generated.html, "viewport-fit=cover"),
    "Web preview must support compact viewports");
require(str_contains(preview.generated.css, "@media(max-width:640px)"),
    "Web preview must include responsive rules");
require(not str_contains(preview.generated.html, "http://")
    and not str_contains(preview.generated.html, "https://"),
    "Web preview must not load a remote asset or service");
require(App.source_sha256() ==
    "a28797b11953392e8b84a6253f15be1d8989ce64c800bbcb16307bf081df0205",
    "source provenance digest must remain stable");

for source_path in [
    "stdlib/pdf_document.sapp",
    "examples/native_document_studio/benchmark.sapp",
    "examples/native_document_studio/document_studio.sapp",
    "examples/native_document_studio/export.sapp",
    "examples/native_document_studio/main.sapp",
    "examples/native_document_studio/test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
        "bounded security analysis must pass for " + source_path);
}

print "native_document_studio_pass";
