let PDF = import("stdlib:pdf_document.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn sample_image() {
    let rgb = [];
    let y = 0;
    while y < 12 {
        let x = 0;
        while x < 12 {
            let color = if (x + y) % 2 == 0 { [0, 126, 112] } else { [204, 91, 48] };
            for channel in color { array_push(rgb, channel); }
            x = x + 1;
        }
        y = y + 1;
    }
    return map{ width: 12, height: 12, rgb: rgb };
}

fn document_spec() {
    return map{
        title: "Native Document Studio",
        heading: "Hello, PBLang!",
        summary: "A deterministic PDF shared by CLI, Web, desktop and Android.",
        rows: [
            ["Capability", "Status"],
            ["Native PDF bytes", "Ready"],
            ["Bounded inspection", "Ready"],
            ["Private metadata", "Omitted"]
        ],
        image: sample_image(),
        link: map{ label: "Open the standards reference", url: "https://example.com/pdf" }
    };
}

fn model() {
    let document = PDF.create(document_spec());
    let inspection = PDF.inspect(document.bytes);
    return map{
        document: document,
        inspection: inspection,
        capabilities: PDF.capabilities(),
        export_path: "examples/native_document_studio/generated/document-composer.pdf"
    };
}

fn _set_status(message) { return UI.action_set_text("document_status", message); }

fn view(data) {
    return UI.screen([
        UI.heading("Native Document Studio", map{
            name: "brand", accessibility_label: "Native Document Studio"
        }),
        UI.text("Compose and inspect a private local PDF", map{ name: "subtitle" }),
        UI.text("Ready", map{
            name: "document_status", accessibility_label: "Current document status"
        }),
        UI.grid([
            UI.card([
                UI.heading("Document", map{ name: "document_title" }),
                UI.text(data.inspection.title, map{ name: "pdf_title" }),
                UI.text(str(data.inspection.pages) + " page, "
                    + str(data.inspection.byte_length) + " bytes", map{ name: "pdf_size" }),
                UI.button("Prepare PDF", _set_status("PDF prepared in memory"), map{
                    name: "prepare_pdf", accessibility_label: "Prepare PDF in memory"
                })
            ], map{ name: "document_card" }),
            UI.card([
                UI.heading("Content", map{ name: "content_title" }),
                UI.text(str(len(data.inspection.rendered_text)) + " text items", map{
                    name: "text_count"
                }),
                UI.text(str(data.inspection.images) + " image, "
                    + str(data.inspection.links) + " secure link", map{ name: "asset_count" }),
                UI.button("Inspect", _set_status("Structure and xref validated"), map{
                    name: "inspect_pdf", accessibility_label: "Inspect PDF structure"
                })
            ], map{ name: "content_card" }),
            UI.card([
                UI.heading("Privacy", map{ name: "privacy_title" }),
                UI.text("No author or creator metadata", map{ name: "metadata_policy" }),
                UI.text("No source path or remote asset", map{ name: "path_policy" }),
                UI.button("Review limits", _set_status("Classic one-page PDF subset"), map{
                    name: "review_limits", accessibility_label: "Review PDF subset limits"
                })
            ], map{ name: "privacy_card" })
        ], map{ name: "document_grid", columns: 3, gap: 12 }),
        UI.text("Export is an explicit local action; this screen never writes silently.", map{
            name: "export_boundary"
        })
    ], map{ name: "native_document_studio_root", gap: 16 });
}

fn web_options() {
    return map{
        theme: "light", lang: "en", host: "127.0.0.1", port: 8080,
        width: 1180, height: 780,
        palette: map{
            accent: [0, 126, 112], selected: [204, 91, 48], focus: [0, 95, 204]
        },
        source_sha256: "a28797b11953392e8b84a6253f15be1d8989ce64c800bbcb16307bf081df0205"
    };
}

fn source_sha256() {
    return "a28797b11953392e8b84a6253f15be1d8989ce64c800bbcb16307bf081df0205";
}

export sample_image, document_spec, model, view, web_options, source_sha256;
