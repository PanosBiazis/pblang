let App = import("examples/native_document_studio/document_studio.sapp");

let iterations = 200;
let total_bytes = 0;
let i = 0;
while i < iterations {
    let data = App.model();
    if not data.inspection.ok { throw "native_document_studio benchmark inspection failed"; }
    total_bytes = total_bytes + data.document.byte_length;
    i = i + 1;
}
print json_stringify(map{
    format: "pblang.example.native-document-benchmark.v1",
    iterations: iterations, total_pdf_bytes: total_bytes
});
