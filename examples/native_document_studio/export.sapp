let App = import("examples/native_document_studio/document_studio.sapp");
let FS = import("stdlib:fs.sapp");
let PDF = import("stdlib:pdf_document.sapp");

fn main() {
    let data = App.model();
    let directory = "examples/native_document_studio/generated";
    FS.mkdirs(directory);
    FS.write_bytes(data.export_path, data.document.bytes);
    let saved = FS.read_bytes(data.export_path);
    let inspected = PDF.inspect(saved);
    if not inspected.ok or inspected.byte_length != data.document.byte_length {
        throw "native_document_studio: exported PDF failed read-back verification";
    }
    print json_stringify(map{
        format: "pblang.example.native-document-export.v1",
        ok: true, path: data.export_path, bytes: inspected.byte_length,
        pages: inspected.pages, title: inspected.title
    });
    return true;
}

main();
