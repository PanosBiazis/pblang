let Analysis = import("examples/vehicle_emissions_lab/analysis.sapp");
let App = import("examples/vehicle_emissions_lab/app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");

fn main() {
    let report = Analysis.sample_report(true);
    let ui = UI.compile(App.view(report), map{ target: "native", width: 1280, height: 800 });
    let chart = Visual.compile(App.visual_scene(report, 960, 540));
    let result = map{
        format: "pblang.example.vehicle-emissions-lab.v1",
        rows: report.row_count,
        selected_predictor: report.selected_predictor,
        r2: report.metrics.r2,
        ui_records: len(ui.records),
        chart_commands: len(chart.draw),
        verified: report.bounded and len(ui.records) > 0 and len(chart.draw) == 3
    };
    print json_stringify(result);
    return result.verified;
}

main();
