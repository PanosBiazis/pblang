let Analysis = import("examples/vehicle_emissions_lab/analysis.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");

fn _status_action(message) {
    return UI.action_set_text("analysis_status", message);
}

fn view(report) {
    let correlation_cards = [];
    for item in report.correlations {
        array_push(correlation_cards, UI.card([
            UI.heading(item.feature, map{ name: "correlation_" + item.feature + "_title" }),
            UI.text("Correlation: " + str(item.coefficient), map{
                name: "correlation_" + item.feature + "_value"
            })
        ], map{ name: "correlation_" + item.feature }));
    }
    return UI.screen([
        UI.heading("Vehicle Emissions Lab", map{
            name: "brand",
            accessibility_label: "Vehicle Emissions Lab"
        }),
        UI.text("Local, bounded data analysis", map{ name: "subtitle" }),
        UI.row([
            UI.button("Dataset", _status_action(str(report.row_count) + " rows validated"), map{
                name: "show_dataset", accessibility_label: "Show dataset status"
            }),
            UI.button("Model", _status_action("Predictor: " + report.selected_predictor), map{
                name: "show_model", accessibility_label: "Show model status"
            }),
            UI.button("Privacy", _status_action("Raw rows and category labels are hidden"), map{
                name: "show_privacy", accessibility_label: "Show privacy status"
            })
        ], map{ name: "actions", responsive: true, gap: 8 }),
        UI.text("Analysis ready", map{
            name: "analysis_status",
            accessibility_label: "Current analysis status"
        }),
        UI.grid([
            UI.card([
                UI.heading("Best predictor", map{ name: "predictor_title" }),
                UI.text(report.selected_predictor, map{ name: "predictor_value" })
            ], map{ name: "predictor_card" }),
            UI.card([
                UI.heading("R squared", map{ name: "r2_title" }),
                UI.text(str(report.metrics.r2), map{ name: "r2_value" })
            ], map{ name: "r2_card" }),
            UI.card([
                UI.heading("RMSE", map{ name: "rmse_title" }),
                UI.text(str(report.metrics.rmse), map{ name: "rmse_value" })
            ], map{ name: "rmse_card" })
        ], map{ name: "metric_grid", columns: 3, gap: 12 }),
        UI.heading("Feature relationships", map{ name: "correlations_title" }),
        UI.grid(correlation_cards, map{ name: "correlation_grid", columns: 3, gap: 12 }),
        UI.text("Model scope: best single numeric feature. No detector or policy claim is implied.", map{
            name: "model_scope_note"
        })
    ], map{ name: "vehicle_emissions_root", gap: 16 });
}

fn visual_scene(report, width = 960, height = 540) {
    let scene = Visual.scene(width, height, map{
        title: "Actual and predicted CO2 emissions",
        backend: "portable"
    });
    let actual = [];
    let predicted = [];
    for point in report.plot_points {
        array_push(actual, [point.x, point.actual]);
        array_push(predicted, [point.x, point.predicted]);
    }
    Visual.add(scene, Visual.text("chart_title", 24, 24,
        "Actual and predicted CO2 emissions", [31, 41, 55, 255], 22));
    if len(actual) > 0 {
        Visual.add(scene, Visual.line_chart("actual_series", actual, map{
            title: "Actual", x_label: report.selected_predictor,
            y_label: report.target, color: [0, 126, 112, 255]
        }));
        Visual.add(scene, Visual.line_chart("predicted_series", predicted, map{
            title: "Predicted", x_label: report.selected_predictor,
            y_label: report.target, color: [218, 85, 47, 255]
        }));
    }
    return scene;
}

fn web_options() {
    return map{
        theme: "light",
        lang: "en",
        host: "127.0.0.1",
        port: 8080,
        width: 1180,
        height: 820,
        palette: map{
            accent: [0, 126, 112],
            selected: [218, 85, 47],
            focus: [0, 95, 204]
        },
        source_sha256: Analysis.source_sha256()
    };
}

export view, visual_scene, web_options;
