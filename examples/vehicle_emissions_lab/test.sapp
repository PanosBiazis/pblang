let Analysis = import("examples/vehicle_emissions_lab/analysis.sapp");
let App = import("examples/vehicle_emissions_lab/app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "vehicle_emissions_lab test failed: " + message; }
}

fn rejected(callable) { return (try { callable(); false } catch true); }

fn record(bundle, name) {
    for item in bundle.records { if item.name == name { return item; } }
    return nil;
}

let private_report = Analysis.sample_report(false);
require(private_report.row_count == 20 and private_report.column_count == 6,
    "sample dimensions must be deterministic");
require(private_report.selected_predictor == "fuel_l_per_100km",
    "strongest numeric predictor must be selected from measured correlation");
require(private_report.metrics.train_rows == 16 and private_report.metrics.test_rows == 4,
    "deterministic 80/20 split must retain every paired row");
require(private_report.metrics.r2 > 0.9 and private_report.metrics.rmse < 50,
    "sample model must meet its measured quality floor");
require(len(private_report.plot_points) == 0
    and not private_report.privacy.raw_rows_included
    and not private_report.privacy.category_labels_included,
    "raw values and category labels must stay private by default");
require(len(private_report.categorical_profiles) == 2
    and private_report.categorical_profiles[0].category_count == 6,
    "categorical data must be encoded without disclosing labels");

let visual_report = Analysis.sample_report(true);
require(len(visual_report.plot_points) == 4 and visual_report.privacy.plot_points_opt_in,
    "plot values require explicit opt-in and remain bounded");
let plan = Visual.compile(App.visual_scene(visual_report, 320, 480));
require(len(plan.draw) == 3, "chart must contain title, actual and predicted series");

require(rejected(fn() { Analysis.analyze_csv_text(""); }),
    "empty input must fail");
require(rejected(fn() { Analysis.analyze_csv_text("x,y\n1,2\n2,3\n3,4\n"); }),
    "missing required columns must fail");
require(rejected(fn() { Analysis.analyze_csv_text(Analysis.sample_csv(), map{
    numeric_features: ["engine_l", "engine_l"]
}); }), "duplicate feature declarations must fail");
require(rejected(fn() { Analysis.analyze_csv_text(Analysis.sample_csv(), map{
    test_every: 1
}); }), "unsafe split interval must fail");

let view = App.view(private_report);
require(UI.validate(view).ok, "shared UI tree must validate");
let web = UI.compile(view, map{ target: "web", width: 320, height: 640 });
let native = UI.compile(view, map{ target: "native", width: 1440, height: 900 });
let android = UI.compile(view, map{ target: "android", width: 360, height: 720 });
for bundle in [web, native, android] {
    require(record(bundle, "brand") != nil, "brand must render on every target");
    require(record(bundle, "show_dataset") != nil, "dataset action must render");
    require(record(bundle, "show_model") != nil, "model action must render");
    require(record(bundle, "show_privacy") != nil, "privacy action must render");
    require(record(bundle, "analysis_status") != nil, "accessible status must render");
}

let preview = UI.preview_web("Vehicle Emissions Lab", view, App.web_options());
require(preview.response.status == 200, "generated Web preview must return HTTP 200");
require(str_contains(preview.generated.html, "viewport-fit=cover"),
    "Web preview must support compact viewports");
require(str_contains(preview.generated.css, "@media(max-width:640px)"),
    "Web preview must include responsive rules");
require(not str_contains(preview.generated.html, "http://")
    and not str_contains(preview.generated.html, "https://"),
    "Web preview must have no remote runtime dependency");
require(Analysis.source_sha256() ==
    "7b12ac3eeca65e42a0d81f953ec6bb7af9a78ee7f9c26cc4d4a10b8be8f5ba60",
    "source provenance digest must remain stable");

for source_path in [
    "examples/vehicle_emissions_lab/analysis.sapp",
    "examples/vehicle_emissions_lab/app.sapp",
    "examples/vehicle_emissions_lab/benchmark.sapp",
    "examples/vehicle_emissions_lab/main.sapp",
    "examples/vehicle_emissions_lab/test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
        "bounded security analysis must pass for " + source_path);
}

print "vehicle_emissions_lab_pass";
