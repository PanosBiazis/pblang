let Analysis = import("examples/vehicle_emissions_lab/analysis.sapp");

let csv = "vehicle_class,fuel_type,engine_l,cylinders,fuel_l_per_100km,co2_emissions\n";
let i = 0;
while i < 2048 {
    let engine = 1 + num_mod(i, 40) / 10;
    let cylinders = 3 + num_mod(i, 6);
    let fuel = 4 + engine * 2 + num_mod(i, 7) / 10;
    let emissions = fuel * 22 + cylinders * 2;
    csv = csv + "class-" + str(num_mod(i, 8)) + ",fuel-" + str(num_mod(i, 4))
        + "," + str(engine) + "," + str(cylinders) + "," + str(fuel)
        + "," + str(emissions) + "\n";
    i = i + 1;
}

let report = Analysis.analyze_csv_text(csv);
if report.row_count != 2048 or report.metrics.train_rows + report.metrics.test_rows != 2048
   or len(report.plot_points) != 0 or not report.bounded {
    throw "bounded vehicle emissions benchmark failed";
}
print json_stringify(map{
    format: "pblang.example.vehicle-emissions-benchmark.v1",
    rows: report.row_count,
    columns: report.column_count,
    selected_predictor: report.selected_predictor,
    raw_rows_disclosed: report.privacy.raw_rows_included,
    verified: true
});
