// Run the direct PBLang-to-x86-64 code generator through the reproducible
// benchmark contract. Requires --allow-all for bounded subprocess measurement.
let R = import("stdlib:repro_benchmark.sapp");

let row = R.benchmark_language("pblang-codegen-x64", "integer_kernel", 1, 3, 30);
if row.status == "unavailable" {
    print "codegen_benchmark status=unavailable reason=" + str(row.reason);
} elif row.status != "ok" {
    throw "direct-codegen benchmark failed: " + row.status + " " + str(try row.detail catch "");
} else {
    print "codegen_benchmark status=ok checksum=" + row.checksum
        + " compile_median_ms=" + str(row.compile_warm.median_ms)
        + " run_median_ms=" + str(row.run_warm.median_ms)
        + " rss_median_kib=" + str(row.rss_warm.median_ms)
        + " artifact_bytes=" + str(row.artifact_size_bytes);
}
