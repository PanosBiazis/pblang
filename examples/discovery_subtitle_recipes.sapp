let S=import("stdlib:subtitles.sapp");let R=import("stdlib:subtitle_review.sapp");
let doc=S.parse_srt("1\n00:00:00,000 --> 00:00:02,000\nabcd\n\n2\n00:00:01,000 --> 00:00:03,000\nefghij\n\n3\n00:00:04,000 --> 00:00:05,000\nk\n");
let reading=R.analyze(doc,2);
assert(reading.above_reading_limit==1 and reading.attention_count==2,"reading load and overlapping cue union");
// A cue sheet here is a metadata table, not a parser for CD CUE files.
let sheet=[];for cue in reading.cues {array_push(sheet,map{cue:cue.cue_index+1,start_ms:cue.start_ms,end_ms:cue.end_ms,reasons:cue.reasons});}
assert(sheet[1].cue==2 and reading.timing.gap_ms==1000,"cue sheet and gaps");
let clip=R.clip_review(doc,1500,2500,2);
assert(clip.source_indices==[0,1] and clip.report.cues[0].characters_per_second==8,"clip reading load increases");
let unicode=R.analyze(map{format:S.FORMAT,cues:[map{start_ms:0,end_ms:1000,text:"é α"}]},3);
assert(unicode.cues[0].nonspace_codepoints==3 and unicode.above_reading_limit==0,"literal Unicode and custom threshold");
print json_stringify(map{reading_load:reading,cue_sheet:sheet,clip_review:clip,unicode_metrics:unicode});
