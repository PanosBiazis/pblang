let LAB = import("examples/quantum_circuit_lab/lab.sapp");
let Security = import("stdlib:security_analysis.sapp");
let Simulator = import("stdlib:quantum_sim.sapp");

fn require(value, message) {
    if not value { throw "quantum_circuit_lab test failed: " + message; }
}

fn rejected(callable) { return (try { callable(); false } catch true); }

let bell = LAB.bell_report();
require(bell.verified and bell.probabilities[0] > 0.499999
and bell.probabilities[3] > 0.499999,
"Bell state must contain only the |00> and |11> basis states");
require(num_abs(bell.observables["ZZ"] - 1) < 0.000000001
and num_abs(bell.observables["XX"] - 1) < 0.000000001,
"Bell state must expose the expected ZZ and XX correlations");
require(str_contains(bell.qasm, "h q[0]") and str_contains(bell.qasm, "cx q[0],q[1]"),
"Bell circuit must produce portable OpenQASM operations");

let random_bit = LAB.random_bit_report();
require(random_bit.verified and not random_bit.sampled,
"random-bit report must validate theory without flaky random sampling");
require(num_abs(random_bit.theoretical_zero_probability - 0.5) < 0.000000001
and num_abs(random_bit.theoretical_one_probability - 0.5) < 0.000000001,
"Hadamard measurement probabilities must be balanced");

let square_root_x = LAB.square_root_x_report();
require(square_root_x.verified and square_root_x.equivalent_up_to_global_phase,
"H-S-H must implement the square root of X up to global phase");

let grover = LAB.grover_two_qubit_report();
require(grover.verified and grover.target_basis_index == 3
and grover.most_likely_basis_index == 3,
"one Grover iteration must amplify the |11> target");
require(grover.probabilities[3] > 0.999999999,
"Grover target probability must be effectively one");

require(num_abs(LAB.expectation(Simulator.bell_state(), "ZZ") - 1) < 0.000000001,
"public expectation helper must evaluate a valid Pauli label");
require(rejected(fn() { LAB.expectation([[1, 0], [0, 0]], "Z"); }),
"observable helper must reject non-two-qubit state shapes");
require(rejected(fn() { LAB.expectation(Simulator.bell_state(), "ZA"); }),
"observable helper must reject unknown Pauli symbols");

let report = LAB.run();
require(report.verified and report.execution == "deterministic-local-state-vector-simulation",
"integrated lab must verify all circuit reports");
require(not report.real_quantum_hardware and not report.cloud_credentials_required,
"local simulation must not claim hardware execution or require credentials");
require(LAB.source_sha256().qiskit_bell ==
"b9ca17cd7c6ecd43f3ab353984f604cad62b15f38ff0568982689ea866e0dd86",
"source provenance digest must remain stable");

for source_path in [
    "examples/quantum_circuit_lab/lab.sapp",
    "examples/quantum_circuit_lab/main.sapp",
    "examples/quantum_circuit_lab/test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
    "bounded security analysis must pass for " + source_path);
}

print "quantum_circuit_lab_pass";
