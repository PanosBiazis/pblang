// Deterministic local replacement for several fragmented Qiskit, Cirq, and Q# demos.

let Quantum = import("stdlib:quantum.sapp");
let Simulator = import("stdlib:quantum_sim.sapp");

let EPSILON = 0.000000001;

fn source_sha256() {
    return map{
        qiskit_bell: "b9ca17cd7c6ecd43f3ab353984f604cad62b15f38ff0568982689ea866e0dd86",
        qiskit_grover: "5d03cc3b70606b09d5d8c20ae98f1c7512ff3d83210be6d425b623b6ca9538e11d",
        cirq_sqrt_x: "f8640d7bd1ba3f9cf223c259e76a46ddfa7b6a04feadd52d0adbd799a725beeb",
        qsharp_random_bit: "7a71c7a6c976d6725d9cbe7ababf31c254edec249b85a133ead2e3fd75f70d07",
        qsharp_project: "6499d775a379e7c488066f9832fd940d337cd8e0d40e00320fefc1b37e39ae26",
        virtual_machine_notebook: "c0d69ece66c47860a8026058cfa8794e7219ab97ddf0637169ceb0b4e24bd893",
        starter_notebook: "fdcc9671a15cf2e99c47d2f57f9ef836c91b7a9ad0ab625ad1992d717f3b33f4"
    };
}

fn _close(left, right) { return num_abs(left - right) <= EPSILON; }

fn _inner_product_real(left, right) {
    if type(left) != "array" or type(right) != "array" or len(left) != len(right) {
        throw "states must be equal-sized amplitude arrays";
    }
    let real = 0;
    let imaginary = 0;
    let i = 0;
    while i < len(left) {
        let ar = left[i][0];
        let ai = left[i][1];
        let br = right[i][0];
        let bi = right[i][1];
        real = real + ar * br + ai * bi;
        imaginary = imaginary + ar * bi - ai * br;
        i = i + 1;
    }
    if num_abs(imaginary) > EPSILON { throw "observable expectation is not real"; }
    return real;
}

fn _pauli_state(state, label) {
    if type(state) != "array" or len(state) != 4 {
        throw "this observable lab accepts exactly two qubits";
    }
    if type(label) != "string" or len(label) != 2 {
        throw "Pauli label must contain exactly two symbols";
    }
    let transformed = state;
    let position = 0;
    while position < 2 {
        let symbol = str_upper(label[position..(position + 1)]);
        let qubit = 1 - position;
        if symbol == "X" { transformed = Simulator.x_gate(transformed, qubit); }
        else if symbol == "Y" { transformed = Simulator.y_gate(transformed, qubit); }
        else if symbol == "Z" { transformed = Simulator.z_gate(transformed, qubit); }
        else if symbol != "I" { throw "unsupported Pauli symbol: " + symbol; }
        position = position + 1;
    }
    return transformed;
}

fn expectation(state, label) {
    return _inner_product_real(state, _pauli_state(state, label));
}

fn bell_report() {
    let state = Simulator.bell_state();
    let probabilities = Simulator.probabilities(state);
    let circuit = Quantum.circuit(2);
    Quantum.bell(circuit, 0, 1);

    let observables = map{};
    for label in ["IZ", "IX", "ZI", "XI", "ZZ", "XX"] {
        observables[label] = expectation(state, label);
    }
    let verified = _close(probabilities[0], 0.5)
        and _close(probabilities[1], 0)
        and _close(probabilities[2], 0)
        and _close(probabilities[3], 0.5)
        and _close(observables["IZ"], 0)
        and _close(observables["IX"], 0)
        and _close(observables["ZI"], 0)
        and _close(observables["XI"], 0)
        and _close(observables["ZZ"], 1)
        and _close(observables["XX"], 1)
        and _close(Simulator.state_norm(state), 1);
    return map{
        circuit: "bell-h-cx",
        qubits: 2,
        state: state,
        probabilities: probabilities,
        observables: observables,
        qasm: Quantum.emit_qasm(circuit),
        verified: verified
    };
}

fn random_bit_report() {
    let state = Simulator.h_gate(Simulator.zero_state(1), 0);
    let probabilities = Simulator.probabilities(state);
    return map{
        circuit: "hadamard-random-bit",
        qubits: 1,
        probabilities: probabilities,
        theoretical_zero_probability: probabilities[0],
        theoretical_one_probability: probabilities[1],
        sampled: false,
        verified: _close(probabilities[0], 0.5)
            and _close(probabilities[1], 0.5)
            and _close(Simulator.state_norm(state), 1)
    };
}

fn square_root_x_report() {
    let state = Simulator.zero_state(1);
    state = Simulator.h_gate(state, 0);
    state = Simulator.s_gate(state, 0);
    state = Simulator.h_gate(state, 0);
    let probabilities = Simulator.probabilities(state);
    return map{
        circuit: "sqrt-x-via-h-s-h",
        qubits: 1,
        state: state,
        probabilities: probabilities,
        equivalent_up_to_global_phase: true,
        verified: _close(probabilities[0], 0.5)
            and _close(probabilities[1], 0.5)
            and _close(Simulator.state_norm(state), 1)
    };
}

fn grover_two_qubit_report() {
    let state = Simulator.zero_state(2);
    state = Simulator.h_gate(state, 0);
    state = Simulator.h_gate(state, 1);

    // Oracle: mark |11> by changing its phase.
    state = Simulator.cz_gate(state, 0, 1);

    // Diffusion operator for a two-qubit uniform superposition.
    state = Simulator.h_gate(state, 0);
    state = Simulator.h_gate(state, 1);
    state = Simulator.x_gate(state, 0);
    state = Simulator.x_gate(state, 1);
    state = Simulator.cz_gate(state, 0, 1);
    state = Simulator.x_gate(state, 0);
    state = Simulator.x_gate(state, 1);
    state = Simulator.h_gate(state, 0);
    state = Simulator.h_gate(state, 1);

    let probabilities = Simulator.probabilities(state);
    return map{
        circuit: "grover-two-qubit-target-11",
        qubits: 2,
        target_basis_index: 3,
        probabilities: probabilities,
        most_likely_basis_index: Simulator.most_likely(state),
        verified: _close(probabilities[0], 0)
            and _close(probabilities[1], 0)
            and _close(probabilities[2], 0)
            and _close(probabilities[3], 1)
            and _close(Simulator.state_norm(state), 1)
    };
}

fn run() {
    let bell = bell_report();
    let random_bit = random_bit_report();
    let square_root_x = square_root_x_report();
    let grover = grover_two_qubit_report();
    return map{
        format: "pblang.example.quantum-circuit-lab.v1",
        execution: "deterministic-local-state-vector-simulation",
        real_quantum_hardware: false,
        cloud_credentials_required: false,
        bell: bell,
        random_bit: random_bit,
        square_root_x: square_root_x,
        grover: grover,
        source_sha256: source_sha256(),
        verified: bell.verified and random_bit.verified
            and square_root_x.verified and grover.verified
    };
}

export source_sha256, expectation, bell_report, random_bit_report,
       square_root_x_report, grover_two_qubit_report, run;
