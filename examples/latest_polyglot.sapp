// Safe default: demonstrate coalescing and the existing execution refusal.
// No foreign source runs unless the caller separately supplies the existing
// registry acknowledgements and the process has the necessary capabilities.
let L=import("stdlib:latest_updates.sapp");
let P=import("stdlib:polyglot.sapp");
let q=L.new_buffer();
q.submit("preview",map{language:"python",source:"print(20+1)",options:nil});
q.submit("preview",map{language:"python",source:"print(21+21)",options:nil});
let outcome=q.flush(fn(key,job){
    let result=P.run_block(job.language,job.source,job.options);
    if not result.ok {print "Polyglot request refused by the existing execution policy.";return false;}
    print result.stdout;
    return true;
});
print outcome.coalesced;
