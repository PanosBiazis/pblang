// Safe multi-format configuration ingestion and conversion in pure PBLang.

let serialization = import("stdlib:serialization.sapp");

let config_text = "name: pblang\ntargets:\n  - x86_64\n  - c99\nlimits:\n  workers: 4\n";
let parsed = serialization.parse_safe(config_text, "yaml", map{
    max_input_bytes: 65536,
    max_lines: 1000,
    max_depth: 16,
    max_items: 10000,
});

if not parsed.ok {
    print "configuration rejected: " + parsed.error;
} else {
    let json = serialization.stringify_safe(parsed.value, "json_pretty", map{ max_output_bytes: 131072 });
    if not json.ok { print "output rejected: " + json.error; }
    else { print json.value; }
}

let converted = serialization.convert_safe("name = \"pblang\"\nworkers = 4\n", "toml", "yaml");
if converted.ok { print converted.value; }
