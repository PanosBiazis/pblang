let App=import("./app.sapp");
let reader=App.create();App.enable_preferences(reader);reader.settings=true;
reader.width=320;reader.height=240;reader.focus_target="font_family";App.refresh(reader);
// Ordered events from one input poll: change page, release, then edit its choice.
App.update(reader,[map{type:"keydown",key:"PageDown"},map{type:"keyup",key:"PageDown"},map{type:"keydown",key:"Enter"},map{type:"keyup",key:"Enter"}]);
assert(reader.form.focus=="body_size" and reader.preferences.draft.body_size==18,"New page receives Enter");
assert(reader.preferences.draft.font_family=="sans","Previous choice remains untouched");
reader.session.close();print "reader_event_batch_demo_pass";
