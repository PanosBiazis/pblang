// Bounded presentation of the existing native preference controls.
let Flow=import("stdlib:text_flow.sapp");
let UI=import("stdlib:modern_ui.sapp");let Type=import("stdlib:ui_typography.sapp");
fn names() {return ["font_family","body_size","font_scale","line_height","density"];}
fn index(name) {let keys=names();for i len(keys) {if keys[i]==name {return i;}}return -1;}
fn clips(view,width,height) {
    let bundle=UI.compile(view,map{width:width,height:height});
    for record in bundle.records {
        let node=record.source;
        if node.kind=="button" and index(try node.name catch "")>=0 {
            let label=Flow.layout(node.text,num_max(0,record.w-24),node);
            if label.truncated or len(label.lines)>1 {return true;}
        }
    }
    return false;
}
fn plan(height,anchor=0) {
    if type(height)!="number" or height!=num_floor(height) or height<240 or height>4320 {throw "Settings height must match GUI bounds.";}
    if type(anchor)!="number" or anchor!=num_floor(anchor) or anchor<0 or anchor>=5 {throw "Invalid settings anchor.";}
    // 192px fixed chrome, plus 48px per choice, including its inter-row gap.
    let capacity=num_min(5,num_max(1,num_floor((height-192)/48)));
    let page=num_floor(anchor/capacity);let start=page*capacity;
    return map{capacity:capacity,count:num_ceil(5/capacity),page:page,start:start,end:num_min(5,start+capacity)};
}
fn view(original,toolbar,layout,previous,next) {
    for button in toolbar.children {button.font_size=14;button.line_height=1.25;button.h=40;}
    let children=[toolbar,UI.spacer(8),UI.heading("Reading appearance",map{font_size:20,line_height:1.25,h:26}),UI.spacer(6),
        UI.text("Options "+str(layout.start+1)+"–"+str(layout.end)+" of 5",map{font_size:12,line_height:1.25,h:18,name:"settings_status"}),UI.spacer(6),
        UI.row([UI.button("Previous options",previous,map{name:"settings_previous",font_size:14,line_height:1.25,h:40,enabled:layout.page>0}),
            UI.button("Next options",next,map{name:"settings_next",font_size:14,line_height:1.25,h:40,enabled:layout.page+1<layout.count})],map{responsive:false,padding:0,gap:8}),UI.spacer(8)];
    let keys=names();
    for i len(keys) {if i>=layout.start and i<layout.end {
        if i>layout.start {push(children,UI.spacer(8));}
        for node in original.children {if (try node.name catch "")==keys[i] {
            node.font_size=14;node.line_height=1.25;node.h=40;push(children,node);
        }}
    }}
    push(children,UI.spacer(6));push(children,UI.text("Page Up / Down • Done to return",map{font_size:12,line_height:1.25,h:18,tone:"muted"}));
    return Type.apply(UI.screen(children,map{padding:12,gap:0}),map{font_family:"sans",text_spacing:"natural",line_height:1.25});
}
export names,index,clips,plan,view;
