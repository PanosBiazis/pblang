// Reader-owned v1 profile reuses the shared appearance validation contract.
let View=import("stdlib:browser_view.sapp");let Json=import("stdlib:json.sapp");
let FORMAT="pblang.reader.appearance";let MAX_BYTES=4096;
fn defaults() {return View.appearance();}
fn encode(appearance) {
    let style=View.appearance(appearance);
    return Json.stringify(map{format:FORMAT,version:1,appearance:style})+"\n";
}
fn _decode(text) {
    assert(type(text)=="string" and len(str_to_bytes(text))<=MAX_BYTES,"Profile byte limit.");
    let value=Json.parse(text);
    assert(type(value)=="map" and len(value)==3 and value.format==FORMAT
        and type(value.version)=="number" and value.version==1,"Unknown profile schema.");
    assert(type(value.appearance)=="map" and len(value.appearance)==8,"Incomplete appearance.");
    let style=View.appearance(value.appearance);
    // Canonical JSON also rejects duplicate keys, alternate field spellings and
    // ambiguous edited input. Developers can use encode() for canonical output.
    assert(str_trim(text)==str_trim(encode(style)),"Noncanonical profile.");return style;
}
fn decode(text) {
    let style=try _decode(text) catch nil;
    if style==nil {return map{ok:false,appearance:defaults(),message:"Profile ignored; using defaults"};}
    return map{ok:true,appearance:style,message:"Saved appearance loaded"};
}
export defaults,encode,decode;
