let App=import("./app.sapp");
let reader=App.create();App.enable_preferences(reader);reader.settings=true;
App.adjust_text_ratio(reader,"font_scale",1);App.adjust_text_ratio(reader,"line_height",1);App.update(reader,[]);
assert(reader.preferences.draft.font_scale==1.05 and reader.preferences.draft.line_height==1.5,"Fine text ratios");
assert(reader.appearance.font_scale==1 and reader.appearance.line_height==1.45,"Draft stays unapplied");
App.close_preferences(reader);App.update(reader,[]);reader.session.close();print "reader_text_ratio_demo_pass";
