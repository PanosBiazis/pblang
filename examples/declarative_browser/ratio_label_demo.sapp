// Concise button labels preserve the full developer-supplied appearance value.
let App=import("./app.sapp");let GUI=import("stdlib:gui.sapp");let Profile=import("./appearance_profile.sapp");
let reader=App.create();App.configure(reader,map{font_scale:1.23456789012345,line_height:1.45678901234567});
let original=Profile.encode(reader.appearance);reader.width=320;reader.height=240;reader.settings=true;
for name in ["font_scale","line_height"] {
 reader.focus_target=name;App.refresh(reader);let widget=GUI.get(reader.form,name);
 print widget.text;print widget.accessibility_label;
 assert(Profile.encode(reader.appearance)==original,"Displaying the label preserves the exact value");
}
reader.session.close();print "reader_ratio_label_demo_pass";
