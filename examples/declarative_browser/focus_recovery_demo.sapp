// Layout recovery retains a selected link until another user action replaces it.
let App=import("./app.sapp");let reader=App.create("local","dark",map{title_size:40,font_scale:1.5});
reader.form.focus="block2";App.update(reader,[map{type:"resize",w:320,h:240}]);
assert(not reader.reading_plan.available and reader.form.focus==nil,"No invisible control receives focus");
App.update(reader,[map{type:"resize",w:800,h:816}]);
assert(reader.form.focus=="block2","Guide link focus recovered");
App.update(reader,[map{type:"keydown",key:"Enter"},map{type:"keyup",key:"Enter"}]);
assert(reader.session.snapshot().url=="pb://guide","Recovered link opens normally");
reader.session.close();print "reader_focus_recovery_demo_pass";
