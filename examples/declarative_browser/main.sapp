let args=try env_get("PBLANG_SCRIPT_ARGS") catch "";
if args==nil {args="";}
let input_source:any=nil;let input_info:any=nil;
let arguments=str_split(args,"\n");
if len(arguments)>1 {
    assert(len(arguments)==3 and arguments[1]=="--open" and (arguments[0]=="--gui-session" or arguments[0]=="--gui-profile" or arguments[0]=="--check-document"),"Invalid reader document arguments.");
    let Input=import("./document_file.sapp");input_info=Input.load(arguments[2]);
    if not input_info.ok {
        if arguments[0]=="--check-document" {print json_stringify(map{ok:false,format:"pblang.reader.document.v1",code:input_info.code,error:input_info.error});}
        else {print input_info.error;}
        // Expected admission failures must not expose interpreter paths/stack traces.
        // The bounded reader has already closed its handles; no GUI/profile exists yet.
        os_exit(1);
    }
    input_source=input_info.source;args=arguments[0];
}
// Admission completes before loading presentation modules or preferences.
if args=="--check-document" and input_info!=nil {
    print json_stringify(map{ok:true,format:"pblang.reader.document.v1",bytes:input_info.bytes,blocks:input_info.blocks});
} else {
    let App=import("./app.sapp");let D=import("stdlib:browser_document.sapp");
    let Session=import("stdlib:browser_session.sapp");let View=import("stdlib:browser_view.sapp");
    let G=import("stdlib:graphics.sapp");let UI=import("stdlib:modern_ui.sapp");
    if args=="--gui" or args=="--gui-session" or args=="--gui-profile" {
        let Store=import("./appearance_store.sapp");
        let parent:any=nil;let loaded=map{can_save:false,appearance:nil,message:"Session only: --with-profile to save"};let saver:any=nil;let reloader:any=nil;
        if args=="--gui-profile" {parent=Store.data_parent(cwd(),try env_get("PBLANG_READER_DATA_DIR") catch nil);loaded=Store.load(parent);}
        if args=="--gui-profile" {saver=fn(style) {
            let result=Store.save(parent,style,loaded.token);
            if result.confirmed {loaded.token=result.token;}return result;
        };
            reloader=fn() {
                let fresh=Store.load(parent);
                if not fresh.ok or not fresh.can_save or fresh.token=="missing" {return map{ok:false};}
                loaded.token=fresh.token;return map{ok:true,appearance:fresh.appearance,save:saver};
            };
        }
        let active_saver:any=nil;if loaded.can_save {active_saver=saver;}
        let c=App.create("local","dark",nil,input_source);App.enable_preferences(c,loaded.appearance,active_saver,loaded.message,reloader);let win=G.Window(c.width,c.height,"PBLang document browser");
        App.set_text_measure(c,fn(text,size,family){return win.textMeasure(text,size,0,family);});App.refresh(c);
        G.run(win,c,App.update,App.draw,30);
        c.session.close();
    } elif args=="--export" {
        let s=Session.create(App.pages());let bundle=s.bundle();fs_mkdirs("build/declarative-browser");
        for name in map_keys(bundle.files) {fs_write("build/declarative-browser/"+name,bundle.files[name]);}
        s.close();print "Offline browser: build/declarative-browser/home.html";
    } elif args=="--android" {
        let doc=D.import_html(App.pages()["pb://home"]);
        let result=UI.build_android("PB Document Reader",View.create(doc),map{package:"org.pblang.documentreader",min_sdk:21,target_sdk:34,theme:"dark",output:"build/pblang-document-reader.apk"});
        assert(result.ok,"Android packaging");print "Android read-only/inspection preview: build/pblang-document-reader.apk";
    } elif args=="--web-preview" {
        let doc=D.import_html(App.pages()["pb://home"]);
        UI.export_web("PBLang document",View.create(doc),"build/declarative-browser-web",map{theme:"dark"});
        print "Shared web preview: build/declarative-browser-web/index.html";
    } elif args=="" {
        let s=Session.create(App.pages());assert(s.follow(2).url=="pb://guide","local navigation");
        assert(s.back().url=="pb://home","history");
        let doc=s.snapshot().document;assert(D.import_html(D.export_html(doc))==doc,"UI roundtrip");
        s.close();print "declarative_browser_pass";
    } else {throw "usage: main.sapp [--gui|--gui-session|--gui-profile|--export|--web-preview|--android]";}
}
