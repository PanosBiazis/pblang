let Install=import("./install_manager.sapp");let raw=try env_get("PBLANG_SCRIPT_ARGS") catch "";
let args=if raw==nil or raw=="" {[]}else{str_split(raw,"\n")};
let result=Install.run(args);print json_stringify(result);
if not result.ok {throw "Reader installation operation not confirmed; inspect the result before retrying.";}
