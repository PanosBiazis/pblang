let App=import("./app.sapp");let GUI=import("stdlib:gui.sapp");
let reader=App.create();App.enable_preferences(reader);App.refresh(reader);
GUI.get(reader.form,"appearance").onclick(reader.form);App.update(reader,[]);
GUI.get(reader.form,"font_family").onclick(reader.form);App.update(reader,[]);
assert(reader.preferences.draft.font_family=="serif" and reader.appearance.font_family=="sans","Draft remains separate");
App.update(reader,[map{type:"keydown",key:"Escape"},map{type:"keyup",key:"Escape"}]);
assert(not reader.settings and reader.form.focus=="appearance","Escape returns to the document and opener");
assert(reader.preferences.draft==reader.appearance and not reader.form.close_requested,"Draft discarded without closing");
assert(not App.close_preferences(reader),"Programmatic dismissal is a no-op when already closed");
reader.session.close();print "reader_escape_demo_pass";
