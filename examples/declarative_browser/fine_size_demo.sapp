let App=import("./app.sapp");
let reader=App.create();App.enable_preferences(reader);reader.settings=true;
App.adjust_text_size(reader,"body_size",1);App.adjust_text_size(reader,"title_size",1);App.update(reader,[]);
assert(reader.preferences.draft.body_size==17 and reader.preferences.draft.title_size==29,"Fine sizes");
assert(reader.appearance.body_size==16,"Draft stays unapplied");
App.close_preferences(reader);App.update(reader,[]);reader.session.close();
print "reader_fine_size_demo_pass";
