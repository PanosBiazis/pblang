let D=import("stdlib:browser_document.sapp");let Session=import("stdlib:browser_session.sapp");
let View=import("stdlib:browser_view.sapp");let UI=import("stdlib:modern_ui.sapp");let GUI=import("stdlib:gui.sapp");
fn pages() {
    return map{
        "pb://home":"<article><h1>PBLang document browser</h1><p>Local documents. Shared graphics. Explicit permissions.</p><h2>Start exploring</h2><a href=\"pb://guide\">Open the guide</a><a href=\"pb://about\">About this browser</a></article>",
        "pb://guide":"<article><h1>Guide — Οδηγός</h1><p>Edit a small HTML document or create the same interface in PBLang. Text and local links round-trip through the shared UI document.</p><p>Use Back, Forward and Home. No scripts, downloads or remote pages execute.</p><a href=\"pb://about\">Read the boundaries</a><a href=\"pb://home\">Return home</a></article>",
        "pb://about":"<article><h1>Explicit boundaries</h1><p>This is an offline declarative document browser. It is not a general web engine, authentication service, Tor client or antivirus.</p><p>Web and Android previews share text and destination inspection. Native navigation belongs to this local session.</p><a href=\"pb://home\">Return home</a></article>"};
}
fn _perform(controller,operation,index) {
    if operation=="link" {controller.session.follow(index);}
    elif operation=="back" {controller.session.back();}
    elif operation=="forward" {controller.session.forward();}
    else {controller.session.home();}
    controller.navigations=controller.navigations+1;controller.pending=true;
    controller.settings=false;controller.focus_target="";
    return true;
}
fn _move(controller,operation,index=nil) {
    return fn(form) {
        let moved=try _perform(controller,operation,index) catch false;
        if not moved {let destination=GUI.get(form,"destination");destination.text="Destination denied by this session";form.dirty=true;}
    };
}
fn configure(controller,options) {
    if type(options)!="map" {throw "browser appearance requires a map";}
    let next=map{};for key in map_keys(controller.appearance) {next[key]=controller.appearance[key];}
    for key in map_keys(options) {next[key]=options[key];}
    next=View.appearance(next);controller.appearance=next;controller.pending=true;return next;
}
fn _style_toggle(controller) {
    return fn(form) {
        controller.settings=not controller.settings;
        controller.focus_target="appearance";
        if controller.settings {controller.focus_target="font_family";}
        controller.pending=true;
    };
}
fn _cycle(controller,key,values) {
    return fn(form) {
        let index=-1;for i len(values) {if values[i]==controller.appearance[key] {index=i;}}
        let next=map{};next[key]=values[(index+1)%len(values)];configure(controller,next);
    };
}
fn _settings(controller) {
    let style=controller.appearance;
    return UI.screen([
        UI.heading("Reading appearance",map{font_size:26,font_weight:"bold",wrap:true,max_lines:2}),
        UI.text("Choose a family, size and spacing. Your page stays open.",map{font_size:16,wrap:true,max_lines:3}),
        UI.button("Font: "+style.font_family,_cycle(controller,"font_family",["sans","serif","monospace","system"]),map{name:"font_family"}),
        UI.button("Text size: "+str(style.body_size),_cycle(controller,"body_size",[14,16,18,20]),map{name:"body_size"}),
        UI.button("Text scale: "+str(style.font_scale),_cycle(controller,"font_scale",[1,1.25,1.5]),map{name:"font_scale"}),
        UI.button("Line spacing: "+str(style.line_height),_cycle(controller,"line_height",[1.25,1.45,1.75]),map{name:"line_height"}),
        UI.button("Density: "+style.density,_cycle(controller,"density",["comfortable","compact"]),map{name:"density"}),
        UI.text("Native fonts use installed fallbacks. Reading settings stay in this session.",map{font_size:12,wrap:true,max_lines:3,tone:"muted"})
    ],map{padding:24,gap:12});
}
fn refresh(controller) {
    let previous=controller.form;
    let snap=controller.session.snapshot();let view=View.create(snap.document,controller.appearance);
    view.children[0].text="Local navigation • "+snap.level+" • "+snap.url;
    if controller.settings {view=_settings(controller);}
    let toolbar=UI.row([
        UI.button("Back",_move(controller,"back"),map{name:"back",enabled:snap.can_back,variant:"secondary",text_align:"center",accessibility_label:"Go back"}),
        UI.button("Forward",_move(controller,"forward"),map{name:"forward",enabled:snap.can_forward,variant:"secondary",text_align:"center",accessibility_label:"Go forward"}),
        UI.button("Home",_move(controller,"home"),map{name:"home",variant:"secondary",text_align:"center",accessibility_label:"Go home"}),
        UI.button(if controller.settings {"Done"} else {"Style"},_style_toggle(controller),map{name:"appearance",variant:"secondary",text_align:"center",accessibility_label:"Reading appearance"})
    ],map{responsive:false,padding:0,gap:6});
    let children=[toolbar];for node in view.children {push(children,node);}view.children=children;
    let blocks=if controller.settings {[]} else {D.inspect(snap.document).blocks};let index=0;
    // Bind only the local links already admitted by the session. No imported handler.
    for block in blocks {
        if block.tag=="a" {
            for node in view.children {
                if (try node.name catch "")=="block"+str(index) {
                    node.text=block.text;node.onclick=_move(controller,"link",index);node.action=nil;
                }
            }
        }
        index=index+1;
    }
    let Typography=import("stdlib:ui_typography.sapp");
    view=Typography.apply(view,map{font_family:controller.appearance.font_family,text_spacing:"natural",
        font_size:num_floor(controller.appearance.button_size*controller.appearance.font_scale+0.5),line_height:controller.appearance.line_height});
    controller.form=UI.build("PBLang document browser",view,map{width:controller.width,height:controller.height,theme:controller.theme});
    // Rebuilding a presentation must not turn a held key into a fresh press.
    // Keep only keyboard state; pointer capture and old widgets belong to the old view.
    if previous!=nil {
        for key in map_keys(previous.pressed_keys) {controller.form.pressed_keys[key]=previous.pressed_keys[key];}
        controller.form.shift=previous.shift;
    }
    let target=controller.focus_target;
    if target==nil {target=try previous.focus catch nil;}
    if target!=nil and target!="" {
        let control=GUI.get(controller.form,target);
        if control!=nil and control.kind=="button" and control.enabled and (try control.visible catch true) {
            controller.form.focus=target;
        }
    }
    controller.focus_target=nil;controller.pending=false;
    return controller.form;
}
fn create(level="local",theme="dark",appearance=nil) {
    let style=View.appearance(appearance);
    let controller=map{appearance:style,settings:false,focus_target:nil,session:Session.create(pages(),map{level:level}),pending:true,form:nil,navigations:0,width:800,height:816,theme:theme};
    refresh(controller);return controller;
}
fn update(controller,events) {
    for event in events {GUI.handle_event(controller.form,event);}
    if controller.form.close_requested {controller.graphics_stop=true;}
    controller.width=controller.form.w;controller.height=controller.form.h;
    if controller.pending {refresh(controller);}
    return controller.form.dirty;
}
export pages,create,configure,refresh,update;
