let Settings=import("./settings_layout.sapp");
let Focus=import("./focus_indicator.sapp");
let Profile=import("./appearance_profile.sapp");
let Pagination=import("./pagination.sapp");
let D=import("stdlib:browser_document.sapp");let Session=import("stdlib:browser_session.sapp");
let View=import("stdlib:browser_view.sapp");let UI=import("stdlib:modern_ui.sapp");let GUI=import("stdlib:gui.sapp");
fn pages() {
    return map{
        "pb://home":"<article><h1>PBLang document browser</h1><p>Local documents. Shared graphics. Explicit permissions.</p><h2>Start exploring</h2><a href=\"pb://guide\">Open the guide</a><a href=\"pb://about\">About this browser</a></article>",
        "pb://guide":"<article><h1>Guide — Οδηγός</h1><p>Edit a small HTML document or create the same interface in PBLang. Text and local links round-trip through the shared UI document.</p><p>Use Back, Forward and Home. No scripts, downloads or remote pages execute.</p><a href=\"pb://about\">Read the boundaries</a><a href=\"pb://home\">Return home</a></article>",
        "pb://about":"<article><h1>Explicit boundaries</h1><p>This is an offline declarative document browser. It is not a general web engine, authentication service, Tor client or antivirus.</p><p>Web and Android previews share text and destination inspection. Native navigation belongs to this local session.</p><a href=\"pb://home\">Return home</a></article>"};
}
fn _history_stamp(snapshot) {
    return map{url:snapshot.url,count:snapshot.history_count,back:snapshot.can_back,forward:snapshot.can_forward};
}
fn _sync_history(controller,snapshot) {
    let stamp=_history_stamp(snapshot);
    if controller.reading_history.stamp==stamp {return false;}
    controller.reading_history=map{stamp:stamp,back:[],forward:[]};return true;
}
// Opt out without moving the current page; changing policy forgets remembered positions.
fn remember_positions(controller,enabled=true) {
    if type(enabled)!="bool" {throw "Remember reading positions must be boolean.";}
    if controller.remember_positions==enabled {return false;}
    controller.remember_positions=enabled;
    controller.reading_history=map{stamp:_history_stamp(controller.session.snapshot()),back:[],forward:[]};return true;
}
fn _perform(controller,operation,index) {
    let before=controller.session.snapshot();
    if operation=="link" {controller.session.follow(index);}
    elif operation=="back" {controller.session.back();}
    elif operation=="forward" {controller.session.forward();}
    else {controller.session.home();}
    let after=controller.session.snapshot();
    // Commit presentation history only after session navigation succeeds.
    _sync_history(controller,before);
    let history=controller.reading_history;let anchor=controller.reading_anchor;
    let saved=map{};for key in map_keys(anchor) {saved[key]=anchor[key];}
    let current=map{url:before.url,anchor:saved};
    let next=map{block:-1,offset:0};
    if controller.remember_positions {
        if operation=="back" or operation=="forward" {
            let source=history.back;let destination=history.forward;
            let available=before.can_back;
            if operation=="forward" {source=history.forward;destination=history.back;available=before.can_forward;}
            if available {
                push(destination,current);
                if len(source)>0 {let entry=array_pop(source);if entry.url==after.url {next=entry.anchor;}}
            } else {next=current.anchor;}
        } elif after.url!=before.url {
            push(history.back,current);history.forward=[];
            if len(history.back)>31 {let kept=[];for i len(history.back) {if i>0 {push(kept,history.back[i]);}}history.back=kept;}
        }
    }
    history.stamp=_history_stamp(after);
    controller.navigations=controller.navigations+1;controller.pending=true;
    controller.settings=false;controller.focus_target="";
    controller.reading_anchor=next;controller.reading_plan=nil;controller.reading_page=0;
    return true;
}
fn _move(controller,operation,index=nil) {
    return fn(form) {
        let moved=try _perform(controller,operation,index) catch false;
        if not moved {let destination=GUI.get(form,"destination");destination.text="Destination denied by this session";form.dirty=true;}
    };
}
fn configure(controller,options) {
    if type(options)!="map" {throw "browser appearance requires a map";}
    let next=map{};for key in map_keys(controller.appearance) {next[key]=controller.appearance[key];}
    for key in map_keys(options) {next[key]=options[key];}
    next=View.appearance(next);controller.appearance=next;controller.pending=true;return next;
}
fn close_preferences(controller) {
    if not controller.settings or controller.form.close_requested {return false;}
    controller.settings=false;controller.focus_target="appearance";
    if controller.preferences!=nil and controller.preferences.draft!=controller.appearance {
        controller.preferences.draft=View.appearance(controller.appearance);controller.preferences.message="Unapplied changes discarded";
    }
    controller.pending=true;return true;
}
fn _style_toggle(controller) {return fn(form) {
    if controller.settings {close_preferences(controller);return;}
    controller.settings=true;controller.focus_target="font_family";controller.settings_anchor=0;
    if controller.preferences!=nil {controller.preferences.draft=View.appearance(controller.appearance);}
    controller.pending=true;
};
}
fn _cycle(controller,key,values) {
    return fn(form) {
        let style=controller.appearance;if controller.preferences!=nil {style=controller.preferences.draft;}
        let index=-1;for i len(values) {if values[i]==style[key] {index=i;}}
        let next=map{};next[key]=values[(index+1)%len(values)];
        if controller.preferences==nil {configure(controller,next);}
        else {
            let draft=View.appearance(controller.preferences.draft);draft[key]=next[key];
            controller.preferences.draft=View.appearance(draft);controller.preferences.message="Changes not applied";controller.pending=true;
        }
    };
}
fn _callable(value) {return type(value)=="fn" or type(value)=="closure" or type(value)=="builtin";}
fn enable_preferences(controller,appearance=nil,save=nil,message="Changes stay in this session",reload=nil) {
    if save!=nil and type(save)!="fn" and type(save)!="closure" and type(save)!="builtin" {throw "Appearance saver must be callable.";}
    if reload!=nil and not _callable(reload) {throw "Appearance reloader must be callable.";}
    if appearance!=nil {configure(controller,appearance);}
    controller.preferences=map{draft:View.appearance(controller.appearance),save:save,reload:reload,message:message};controller.pending=true;
}
// Explicit read only: accept a complete validated style and a renewed saver together.
fn reload_preferences(controller) {
    let prefs=controller.preferences;if prefs==nil or prefs.reload==nil {return false;}
    let result=try prefs.reload() catch nil;
    let accepted=try {
        assert(type(result)=="map" and result.ok==true,"Reload unavailable.");
        assert(type(result.appearance)=="map" and len(result.appearance)==8 and _callable(result.save),"Incomplete reload.");
        map{appearance:View.appearance(result.appearance),save:result.save}
    } catch nil;
    if accepted==nil {
        prefs.save=nil;prefs.message="Reload failed; current style kept";controller.pending=true;return false;
    }
    configure(controller,accepted.appearance);prefs.draft=View.appearance(accepted.appearance);
    prefs.save=accepted.save;prefs.message="Saved style reloaded; draft replaced";controller.pending=true;return true;
}
fn _has_reload(controller) {return controller.preferences!=nil and controller.preferences.reload!=nil;}
fn _settings_count(controller) {return len(Settings.names(controller.preferences!=nil,_has_reload(controller)));}
fn _preference_action(controller,action) {return fn(form) {
    if action=="reload" {reload_preferences(controller);return;}
    let prefs=controller.preferences;let style=View.appearance(prefs.draft);
    if action=="reset" {style=Profile.defaults();}
    if action=="apply" or (action=="reset" and prefs.save==nil) {
        configure(controller,style);prefs.draft=View.appearance(style);prefs.message="Applied for this session";return;
    }
    let result=try prefs.save(style) catch nil;
    if result!=nil and (try result.ok catch false)==true {
        configure(controller,style);prefs.draft=View.appearance(style);
        prefs.message="Saved for next launch";if action=="reset" {prefs.message="Defaults saved";}
    } else {
        prefs.message="Could not save; choices kept";
        if result!=nil and (try result.history_full catch false) {prefs.message="History full; archive old profiles";}
        if result!=nil and (try result.reload catch false) {
            prefs.save=nil;prefs.message="Profile changed; restart to reload";
            if prefs.reload!=nil {prefs.message="Profile changed; Reload saved style";}
        }
        if result!=nil and (try result.attempted catch false) {
            prefs.save=nil;prefs.message="Save uncertain; restart to check";
            if prefs.reload!=nil {prefs.message="Save uncertain; Reload saved style";}
        }
    }
    controller.pending=true;
};}
fn _settings(controller) {
    let style=if controller.preferences==nil {controller.appearance} else {controller.preferences.draft};
    let view=UI.screen([
        UI.heading("Reading appearance",map{font_size:26,font_weight:"bold",wrap:true,max_lines:2}),
        UI.text("Choose a family, size and spacing. Your page stays open.",map{font_size:16,wrap:true,max_lines:3}),
        UI.button("Font: "+style.font_family,_cycle(controller,"font_family",["sans","serif","monospace","system"]),map{name:"font_family"}),
        UI.button("Text size: "+str(style.body_size),_cycle(controller,"body_size",[14,16,18,20]),map{name:"body_size"}),
        UI.button("Title size: "+str(style.title_size),_cycle(controller,"title_size",[20,24,28,32,36,40]),map{name:"title_size"}),
        UI.button("Text scale: "+str(style.font_scale),_cycle(controller,"font_scale",[1,1.25,1.5]),map{name:"font_scale"}),
        UI.button("Line spacing: "+str(style.line_height),_cycle(controller,"line_height",[1.25,1.45,1.75]),map{name:"line_height"}),
        UI.button("Density: "+style.density,_cycle(controller,"density",["comfortable","compact"]),map{name:"density"}),
        UI.text("Native fonts use installed fallbacks. Reading settings stay in this session.",map{font_size:12,wrap:true,max_lines:3,tone:"muted"})
    ],map{padding:24,gap:12});
    if controller.preferences!=nil {
        view.children[1].text="Choose options, then Apply or Save.";
        array_pop(view.children);
        push(view.children,UI.button("Apply for this session",_preference_action(controller,"apply"),map{name:"style_apply",font_size:14}));
        push(view.children,UI.button("Save for next launch",_preference_action(controller,"save"),map{name:"style_save",font_size:14,enabled:controller.preferences.save!=nil}));
        push(view.children,UI.button(if controller.preferences.save==nil {"Reset this session"} else {"Reset defaults"},_preference_action(controller,"reset"),map{name:"style_reset",font_size:14}));
        if _has_reload(controller) {push(view.children,UI.button("Reload saved style",_preference_action(controller,"reload"),map{name:"style_reload",font_size:14}));}
        push(view.children,UI.text(controller.preferences.message,map{name:"profile_status",font_size:12,wrap:true,max_lines:3,tone:"muted"}));
    }
    return view;
}
fn set_text_measure(controller,measure=nil) {
    if measure!=nil and type(measure)!="fn" and type(measure)!="closure" and type(measure)!="builtin" {throw "Reader text measurement requires a function or nil.";}
    controller.text_measure=measure;controller.pending=true;
}
fn settings_page(controller,index) {
    if type(index)!="number" or index!=num_floor(index) {throw "Settings page index must be an integer.";}
    let layout=controller.settings_layout;if not controller.settings or layout==nil {return false;}
    let page=num_max(0,num_min(layout.count-1,index));if page==layout.page {return false;}
    controller.settings_anchor=page*layout.capacity;controller.focus_target=Settings.names(controller.preferences!=nil,_has_reload(controller))[controller.settings_anchor];
    controller.pending=true;return true;
}
fn _settings_move(controller,delta) {return fn(form) {settings_page(controller,controller.settings_layout.page+delta);};}
fn read_page(controller,index) {
    if type(index)!="number" or index!=num_floor(index) {throw "Reader page index must be an integer.";}
    let plan=controller.reading_plan;if plan==nil or not plan.available or controller.settings {return false;}
    let selected=num_max(0,num_min(len(plan.pages)-1,index));
    if selected==controller.reading_page {return false;}
    controller.reading_anchor=Pagination.anchor(plan,selected);controller.reading_page=selected;
    controller.pending=true;return true;
}
fn _page_move(controller,delta) {return fn(form) {read_page(controller,controller.reading_page+delta);};}
fn _bind_links(view,controller,blocks,paged) {
    let index=0;for block in blocks {
        if block.tag=="a" {for node in view.children {
            if (try node.name catch "")=="block"+str(index) {
                if not paged {node.text=block.text;}
                node.onclick=_move(controller,"link",index);node.action=nil;
            }
        }}index=index+1;
    }
}
fn refresh(controller) {
    let previous=controller.form;
    let snap=controller.session.snapshot();
    if _sync_history(controller,snap) {controller.reading_anchor=map{block:-1,offset:0};}
    let view=View.create(snap.document,controller.appearance);
    view.children[0].text="Local navigation • "+snap.level+" • "+snap.url;
    if controller.settings {view=_settings(controller);}
    let toolbar=UI.row([
        UI.button("Back",_move(controller,"back"),map{name:"back",enabled:snap.can_back,variant:"secondary",text_align:"center",accessibility_label:"Go back"}),
        UI.button(if controller.width<360 {"Fwd"}else{"Forward"},_move(controller,"forward"),map{name:"forward",enabled:snap.can_forward,variant:"secondary",text_align:"center",accessibility_label:"Go forward"}),
        UI.button("Home",_move(controller,"home"),map{name:"home",variant:"secondary",text_align:"center",accessibility_label:"Go home"}),
        UI.button(if controller.settings {"Done"} else {"Style"},_style_toggle(controller),map{name:"appearance",variant:"secondary",text_align:"center",accessibility_label:"Reading appearance"})
    ],map{responsive:false,padding:0,gap:6});
    let children=[toolbar];for node in view.children {push(children,node);}view.children=children;
    let Typography=import("stdlib:ui_typography.sapp");
    view=Typography.apply(view,map{font_family:controller.appearance.font_family,text_spacing:"natural",
        font_size:num_floor(controller.appearance.button_size*controller.appearance.font_scale+0.5),line_height:controller.appearance.line_height});
    let target=controller.focus_target;if target==nil {target=try previous.focus catch nil;}
    controller.settings_layout=nil;
    if controller.settings {
        // Keep navigation usable independently of the document's magnification.
        for button in view.children[0].children {button.font_size=14;button.font_family="sans";button.line_height=1.25;button.h=40;}
        let selected=Settings.index(target,controller.preferences!=nil,_has_reload(controller));if selected>=0 {controller.settings_anchor=selected;}
        if Pagination.needs(view,controller.width,controller.height) or Settings.clips(view,controller.width,controller.height,controller.preferences!=nil,_has_reload(controller)) {
            controller.settings_layout=Settings.plan(controller.height,controller.settings_anchor,_settings_count(controller));
            view=Settings.view(view,toolbar,controller.settings_layout,_settings_move(controller,-1),_settings_move(controller,1));
        }
    }
    let paged=false;
    if not controller.settings {
        controller.reading_plan=nil;
        // Measure the actual native labels, which omit the portable Inspect prefix.
        _bind_links(view,controller,D.inspect(snap.document).blocks,false);
        if Pagination.needs(view,controller.width,controller.height,controller.text_measure) {
            paged=true;let plan=Pagination.plan(snap.document,controller.appearance,controller.width,controller.height,controller.text_measure);
            controller.reading_plan=plan;controller.reading_page=Pagination.locate(plan,controller.reading_anchor);
            // Compact navigation remains reachable independently of document magnification.
            for button in toolbar.children {button.font_size=14;button.line_height=1.25;button.h=40;}
            view=Pagination.view(plan,controller.reading_page,controller.appearance,toolbar,_page_move(controller,-1),_page_move(controller,1));
            view=Typography.apply(view,map{font_family:controller.appearance.font_family,text_spacing:"natural",line_height:controller.appearance.line_height});
        }
        if paged {_bind_links(view,controller,D.inspect(snap.document).blocks,true);}
    }
    controller.form=UI.build("PBLang document browser",view,map{width:controller.width,height:controller.height,theme:controller.theme});
    // Rebuilding a presentation must not turn a held key into a fresh press.
    // Keep only keyboard state; pointer capture and old widgets belong to the old view.
    if previous!=nil {
        for key in map_keys(previous.pressed_keys) {controller.form.pressed_keys[key]=previous.pressed_keys[key];}
        controller.form.shift=previous.shift;
    }
    if target=="settings_next" or target=="settings_previous" {
        let wanted=GUI.get(controller.form,target);
        if wanted==nil or not wanted.enabled {target=if controller.settings {Settings.names(controller.preferences!=nil,_has_reload(controller))[controller.settings_anchor]}else{"appearance"};}
    }
    if target=="reading_next" or target=="reading_previous" {
        let wanted=GUI.get(controller.form,target);
        if wanted==nil {target="appearance";}
        elif not wanted.enabled {target=if target=="reading_next" {"reading_previous"}else{"reading_next"};}
    }
    if target!=nil and target!="" {
        let control=GUI.get(controller.form,target);
        if control!=nil and control.kind=="button" and control.enabled and (try control.visible catch true) {
            controller.form.focus=target;
        }
    }
    controller.focus_target=nil;controller.pending=false;
    return controller.form;
}
fn create(level="local",theme="dark",appearance=nil,source=nil) {
    let style=View.appearance(appearance);
    let documents=pages();if source!=nil {documents["pb://home"]=source;}
    let controller=map{remember_positions:true,reading_history:map{stamp:nil,back:[],forward:[]},preferences:nil,text_measure:nil,settings_anchor:0,settings_layout:nil,reading_anchor:map{block:-1,offset:0},reading_plan:nil,reading_page:0,appearance:style,settings:false,focus_target:nil,session:Session.create(documents,map{level:level}),pending:true,form:nil,navigations:0,width:800,height:816,theme:theme};
    refresh(controller);return controller;
}
fn update(controller,events) {
    for event in events {
        let key=try event.key catch "";let fresh=(try event.type catch "")=="keydown" and not map_has(controller.form.pressed_keys,key);
        if fresh and key=="Escape" and controller.settings and not controller.form.close_requested {
            // Consume this press before the shared GUI can turn it into a window close.
            controller.form.pressed_keys[key]=true;close_preferences(controller);
            // Later events in this batch must target the document, not stale settings.
            controller.width=controller.form.w;controller.height=controller.form.h;
            refresh(controller);continue;
        }
        GUI.handle_event(controller.form,event);
        if fresh and controller.settings and controller.settings_layout!=nil {
            if key=="PageDown" or key=="Next" {settings_page(controller,controller.settings_layout.page+1);}
            elif key=="PageUp" or key=="Prior" {settings_page(controller,controller.settings_layout.page-1);}
            elif key=="Home" {settings_page(controller,0);}
            elif key=="End" {settings_page(controller,controller.settings_layout.count-1);}
        }
        elif fresh and not controller.settings and controller.reading_plan!=nil {
            if key=="PageDown" or key=="Next" {read_page(controller,controller.reading_page+1);}
            elif key=="PageUp" or key=="Prior" {read_page(controller,controller.reading_page-1);}
            elif key=="Home" {read_page(controller,0);}
            elif key=="End" {read_page(controller,len(controller.reading_plan.pages)-1);}
        }
    }
    if controller.form.close_requested {controller.graphics_stop=true;}
    if controller.width!=controller.form.w or controller.height!=controller.form.h {controller.pending=true;}
    controller.width=controller.form.w;controller.height=controller.form.h;
    if controller.pending {refresh(controller);}
    return controller.form.dirty;
}
fn draw(controller,canvas,highlight=true) {
    if type(highlight)!="bool" {throw "Reader focus highlight must be boolean.";}
    GUI.draw(canvas,controller.form);
    if highlight {Focus.draw(canvas,controller.form);}
    return true;
}
export pages,create,configure,refresh,update,draw,read_page,settings_page,set_text_measure,enable_preferences,reload_preferences,remember_positions,close_preferences;
