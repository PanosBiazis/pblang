// Feed resize events through App.update so the selected link stays reachable.
let App=import("./app.sapp");let GUI=import("stdlib:gui.sapp");
let reader=App.create();reader.form.focus="appearance";
App.update(reader,[map{type:"keydown",key:"Tab"},map{type:"keyup",key:"Tab"}]);
assert(reader.form.focus=="block2","Guide selected by keyboard");
App.update(reader,[map{type:"resize",w:320,h:240}]);
assert(reader.form.focus=="block2" and GUI.get(reader.form,"block2")!=nil,"Selected link is on the visible page");
App.update(reader,[map{type:"keydown",key:"Enter"},map{type:"keyup",key:"Enter"}]);
assert(reader.session.snapshot().url=="pb://guide","Enter follows the selected link after resize");
reader.session.close();print "reader_resize_focus_demo_pass";
