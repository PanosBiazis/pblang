// Explicit bounded, read-only file admission. No path-based fallback or writes.
let D=import("stdlib:browser_document.sapp");let Dir=import("stdlib:linux_dirfs.sapp");let Path=import("stdlib:path.sapp");
fn rejected() {return map{ok:false,source:nil,bytes:0,blocks:0,error:"Document unavailable or unsupported; no document or preferences changed."};}
fn decode(bytes) {
    if type(bytes)!="array" or len(bytes)<1 or len(bytes)>D.MAX_SOURCE_BYTES {return rejected();}
    let text=try bytes_to_str(bytes) catch nil;
    if text==nil or str_to_bytes(text)!=bytes {return rejected();}
    let source=str_trim(text);let document=try D.inspect(D.import_html(source)) catch nil;
    if document==nil {return rejected();}
    return map{ok:true,source:source,bytes:len(bytes),blocks:len(document.blocks),error:nil};
}
fn path(value) {
    if type(value)!="string" or len(value)<2 or len(value)>4096 or not str_starts_with(value,"/") or str_contains(value,"\\") {return nil;}
    for i len(value) {let code=strcharcodeat(value,i);if code<32 or code==127 {return nil;}}
    let result=Path.normalize(value);if result=="/" {return nil;}return result;
}
fn load(value) {
    let selected=path(value);if selected==nil {return rejected();}
    let fs=Dir.open_absolute(Path.dirname(selected),false,false);if not fs.ok {return rejected();}
    let read=try Dir.read_bytes_relative(fs,Path.basename(selected),D.MAX_SOURCE_BYTES) catch nil;
    let closed=try Dir.close(fs) catch false;
    if not closed or read==nil or not read.ok {return rejected();}
    return decode(read.bytes);
}
export decode,path,load;
