// Explicit bounded, read-only file admission. No path-based fallback or writes.
let D=import("stdlib:browser_document.sapp");let Dir=import("stdlib:linux_dirfs.sapp");let Path=import("stdlib:path.sapp");
// Stable public codes; never forward parser exceptions, paths or source text.
fn rejected(code) {
    let hint="File could not be read safely. Choose a readable regular file without symbolic links.";
    if code=="invalid_input" {hint="Pass an array of UTF-8 bytes to decode.";}
    elif code=="invalid_path" {hint="Use an absolute file path without control characters or backslashes, at most 4096 characters.";}
    elif code=="empty_document" {hint="The file is empty. Add a supported article with a title.";}
    elif code=="too_large" {hint="The file exceeds 16 KiB (16384 bytes). Reduce its size and retry.";}
    elif code=="invalid_utf8" {hint="The file is not valid UTF-8. Save it as UTF-8 and retry.";}
    elif code=="unsupported_document" {hint="Use the supported article/h1/p/h2/local-link format and field limits; scripts, nested markup and remote links are unsupported.";}
    return map{ok:false,source:nil,bytes:0,blocks:0,code:code,error:"Document unavailable or unsupported; no document or preferences changed. "+hint};
}
fn decode(bytes) {
    if type(bytes)!="array" {return rejected("invalid_input");}
    if len(bytes)>D.MAX_SOURCE_BYTES {return rejected("too_large");}
    if len(bytes)<1 {return rejected("empty_document");}
    let text=try bytes_to_str(bytes) catch nil;
    if text==nil or str_to_bytes(text)!=bytes {return rejected("invalid_utf8");}
    let source=str_trim(text);if source=="" {return rejected("empty_document");}
    let document=try D.inspect(D.import_html(source)) catch nil;
    if document==nil {return rejected("unsupported_document");}
    return map{ok:true,source:source,bytes:len(bytes),blocks:len(document.blocks),code:"ok",error:nil};
}
fn path(value) {
    if type(value)!="string" or len(value)<2 or len(value)>4096 or not str_starts_with(value,"/") or str_contains(value,"\\") {return nil;}
    for i len(value) {let code=strcharcodeat(value,i);if code<32 or code==127 {return nil;}}
    let result=Path.normalize(value);if result=="/" {return nil;}return result;
}
fn load(value) {
    let selected=path(value);if selected==nil {return rejected("invalid_path");}
    let fs=Dir.open_absolute(Path.dirname(selected),false,false);if not fs.ok {return rejected("read_failed");}
    let read=try Dir.read_bytes_relative(fs,Path.basename(selected),D.MAX_SOURCE_BYTES) catch nil;
    let closed=try Dir.close(fs) catch false;
    if not closed or read==nil {return rejected("read_failed");}
    if not read.ok {
        // Adapter for the existing bounded-reader result; other failures stay generic.
        if (try read.error catch nil)=="file exceeds byte limit" {return rejected("too_large");}
        return rejected("read_failed");
    }
    return decode(read.bytes);
}
export decode,path,load;
