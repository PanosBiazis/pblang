// Refine the existing bounded text flow using the owning window's font metrics.
// Keeping its initial lines also preserves the bitmap fallback's width budget.
let Flow=import("stdlib:text_flow.sapp");let Layout=import("stdlib:text_layout.sapp");
fn fits(text,width,options,heading=false,measure=nil,height=nil) {
    if measure==nil or text=="" {return true;}
    let m=Flow.metrics(options,heading);
    let available=if height==nil {m.line_height}else{height};
    let actual=try measure(text,m.size,try options.font_family catch "sans") catch nil;
    // GUI uses the bitmap fallback when host measurement is unavailable or too tall.
    if actual==nil or not (try actual.ok catch false) or (try actual.height catch m.size)>available {return true;}
    return actual.width<=num_max(0,width-m.extra);
}
fn lines(text,width,options,heading=false,measure=nil) {
    let flow=Flow.layout(text,width,options,heading);
    if measure==nil or flow.truncated {return flow;}
    let refined=[];
    for initial in flow.lines {
        if len(refined)>=64 {flow.truncated=true;return flow;}
        if initial=="" {push(refined,"");continue;}
        let remaining=initial;
        while remaining!="" {
            if len(refined)>=64 {flow.truncated=true;return flow;}
            if fits(remaining,width,options,heading,measure) {push(refined,remaining);break;}
            let end=0;let space=-1;let prefix="";
            for group in Layout.clusters(remaining) {
                let candidate=prefix+group.text;
                if not fits(candidate,width,options,heading,measure) {break;}
                prefix=candidate;end=len(prefix);if group.text==" " {space=end-1;}
            }
            if end==0 or len(refined)>=64 {flow.truncated=true;return flow;}
            if end<len(remaining) and space>0 {end=space;}
            let line=str_slice(remaining,0,end);
            if str_ends_with(line," ") {line=str_slice(line,0,len(line)-1);}
            push(refined,line);remaining=str_slice(remaining,end,len(remaining));
            if str_starts_with(remaining," ") {remaining=str_slice(remaining,1,len(remaining));}
        }
    }
    flow.lines=refined;return flow;
}
export fits,lines;
