let App=import("./app.sapp");
let reader=App.create();reader.width=320;reader.height=240;
App.enable_preferences(reader,nil,fn(style){return map{ok:false,reload:true};});
reader.settings=true;reader.focus_target="style_save";App.refresh(reader);
App.update(reader,[map{type:"keydown",key:"Enter"},map{type:"keyup",key:"Enter"}]);
assert(reader.preferences.save==nil,"Conflicting Save remains blocked");
assert(reader.form.focus=="style_apply","Session-only recovery receives visible focus");
// Focus is not activation: only a new press chooses the focused recovery action.
App.update(reader,[map{type:"keydown",key:"Enter"},map{type:"keyup",key:"Enter"}]);
assert(reader.preferences.message=="Applied for this session","Explicitly apply without saving");
reader.session.close();print "reader_recovery_focus_demo_pass";
