// Fresh shared built-in documents, independent of window and view initialization.
fn pages() {
    return map{
        "pb://home":"<article><h1>PBLang document browser</h1><p>Local documents. Shared graphics. Explicit permissions.</p><h2>Start exploring</h2><a href=\"pb://guide\">Open the guide</a><a href=\"pb://about\">About this browser</a></article>",
        "pb://guide":"<article><h1>Guide — Οδηγός</h1><p>Edit a small HTML document or create the same interface in PBLang. Text and local links round-trip through the shared UI document.</p><p>Use Back, Forward and Home. No scripts, downloads or remote pages execute.</p><a href=\"pb://about\">Read the boundaries</a><a href=\"pb://home\">Return home</a></article>",
        "pb://about":"<article><h1>Explicit boundaries</h1><p>This is an offline declarative document browser. It is not a general web engine, authentication service, Tor client or antivirus.</p><p>Web and Android previews share text and destination inspection. Native navigation belongs to this local session.</p><a href=\"pb://home\">Return home</a></article>"};
}
export pages;
