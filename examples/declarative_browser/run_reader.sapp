//
// examples/declarative_browser/run_reader.sapp — Pure-PBLang Document Reader Launcher
//
// Replaces examples/declarative_browser/run-reader.sh with identical CLI flags, exit codes,
// and capability-isolated runtime dispatch.

let Path = import("stdlib:path.sapp");

fn _usage_text() {
    return "Usage: ./pblang run run_reader.sapp --allow-all -- [--with-profile|--session-only|--check] [--open FILE]\n"
        + "       ./pblang run run_reader.sapp --allow-all -- --help | --manage OPERATION ARGS...\n"
        + "Default: session-only. --open reads one supported UTF-8 document, at most 16 KiB, without writes or network access.\n"
        + "--with-profile enables local Save and trusted stat subprocesses; no command allowlist.\n";
}

fn _collect_args() {
    let raw_env = env_get("PBLANG_SCRIPT_ARGS");
    if raw_env != nil and raw_env != "" {
        let parts = str_split(raw_env, "\n");
        let env_out = [];
        let k = 0;
        while k < len(parts) {
            if parts[k] != "" { array_push(env_out, parts[k]); }
            k = k + 1;
        }
        return env_out;
    }
    let argv = try os_args() catch [];
    if not is_array(argv) { return []; }
    let n = len(argv);
    let i = 0;
    let found = false;
    while i < n {
        let a = str(argv[i]);
        i = i + 1;
        if str_ends_with(a, ".sapp") or str_ends_with(a, ".pbck") { found = true; break; }
    }
    if not found { return []; }
    while i < n {
        let a2 = str(argv[i]);
        if a2 == "--" { i = i + 1; break; }
        if not str_starts_with(a2, "-") { break; }
        i = i + 1;
    }
    let out = [];
    while i < n {
        array_push(out, str(argv[i]));
        i = i + 1;
    }
    return out;
}

fn _resolve_reader_root() {
    let cur = cwd();
    if fs_exists(cur + "/package-receipt.json") or (fs_exists(cur + "/pblang") and fs_exists(cur + "/examples/declarative_browser/main.sapp")) {
        return cur;
    }
    if fs_exists(cur + "/main.sapp") and fs_exists(cur + "/install.sapp") and fs_exists(cur + "/../../pblang") {
        return Path.normalize(cur + "/../..");
    }
    return cur;
}

fn _resolve_runtime_bin(reader_dir: string) {
    let env_bin = env_get("PBLANG_BIN");
    if env_bin != nil and env_bin != "" and fs_exists(env_bin) {
        return env_bin;
    }
    if fs_exists(reader_dir + "/pblang") {
        return reader_dir + "/pblang";
    }
    if fs_exists(reader_dir + "/target/release/pblang") {
        return reader_dir + "/target/release/pblang";
    }
    return "pblang";
}

fn _dispatch_in_dir(reader_dir: string, pb_bin: string, sub_args: any) {
    let res = nil;
    if Path.normalize(cwd()) == Path.normalize(reader_dir) {
        res = proc_spawn_wait(pb_bin, sub_args);
    } elif fs_exists("/usr/bin/env") {
        let env_args = ["-C", reader_dir, pb_bin];
        let i = 0;
        while i < len(sub_args) {
            array_push(env_args, sub_args[i]);
            i = i + 1;
        }
        res = proc_spawn_wait("/usr/bin/env", env_args);
    } else {
        res = proc_spawn_wait(pb_bin, sub_args);
    }
    if res.stdout != "" { print(res.stdout); }
    if res.stderr != "" { eprint(res.stderr); }
    os_exit(res.exit_code);
}

let caller_dir = cwd();
let reader_dir = _resolve_reader_root();
let pb_bin = _resolve_runtime_bin(reader_dir);
let args = _collect_args();

if len(args) > 0 and args[0] == "--manage" {
    let m_args = ["run", "examples/declarative_browser/install.sapp", "--allow-all", "--deny-net", "--deny-http", "--"];
    let m = 1;
    while m < len(args) {
        array_push(m_args, args[m]);
        m = m + 1;
    }
    _dispatch_in_dir(reader_dir, pb_bin, m_args);
}

let mode = "session";
let mode_set = false;
let input_path = "";
let input_set = false;

let idx = 0;
while idx < len(args) {
    let arg = args[idx];
    if arg == "--with-profile" or arg == "--session-only" or arg == "--check" {
        if mode_set {
            eprint(_usage_text());
            os_exit(2);
        }
        mode_set = true;
        if arg == "--with-profile" { mode = "profile"; }
        elif arg == "--session-only" { mode = "session"; }
        else { mode = "check"; }
        idx = idx + 1;
    } elif arg == "--open" {
        if input_set or idx + 1 >= len(args) or args[idx + 1] == "" {
            eprint(_usage_text());
            os_exit(2);
        }
        input_set = true;
        let raw_in = args[idx + 1];
        if str_starts_with(raw_in, "/") {
            input_path = raw_in;
        } else {
            input_path = caller_dir + "/" + raw_in;
        }
        idx = idx + 2;
    } elif arg == "--help" {
        if len(args) != 1 or mode_set or input_set {
            eprint(_usage_text());
            os_exit(2);
        }
        print(_usage_text());
        os_exit(0);
    } else {
        eprint(_usage_text());
        os_exit(2);
    }
}

let run_target = if fs_exists(reader_dir + "/package-receipt.json") { "." } else { "examples/declarative_browser/main.sapp" };

if input_set {
    let reader_entry = "--gui-session";
    if mode == "profile" { reader_entry = "--gui-profile"; }
    elif mode == "check" { reader_entry = "--check-document"; }
    if mode == "profile" {
        _dispatch_in_dir(reader_dir, pb_bin, ["run", run_target, "--allow-all", "--deny-net", "--deny-http", "--deny-spawn", "--", reader_entry, "--open", input_path]);
    } else {
        _dispatch_in_dir(reader_dir, pb_bin, ["run", run_target, "--allow-all", "--deny-net", "--deny-http", "--deny-exec", "--deny-spawn", "--", reader_entry, "--open", input_path]);
    }
}

if mode == "profile" {
    _dispatch_in_dir(reader_dir, pb_bin, ["run", run_target, "--allow-all", "--deny-net", "--deny-http", "--deny-spawn", "--", "--gui-profile"]);
}
if mode == "session" {
    _dispatch_in_dir(reader_dir, pb_bin, ["run", run_target, "--allow-all", "--deny-net", "--deny-http", "--deny-exec", "--deny-spawn", "--", "--gui-session"]);
}
_dispatch_in_dir(reader_dir, pb_bin, ["run", run_target, "--allow-all", "--deny-net", "--deny-http", "--deny-exec", "--deny-spawn"]);
