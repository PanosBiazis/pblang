let Fit=import("./text_fit.sapp");
// Bounded presentation only: the canonical document and local-link policy stay intact.
let D=import("stdlib:browser_document.sapp");let View=import("stdlib:browser_view.sapp");
let UI=import("stdlib:modern_ui.sapp");let Flow=import("stdlib:text_flow.sapp");
fn normalized(text) {let words=[];for word in str_split(text," ") {if word!="" {push(words,word);}}return str_join(words," ");}
fn needs(view,width,height,measure=nil) {
    let bundle=UI.compile(view,map{width:width,height:height});
    for record in bundle.records {
        if record.y+record.h>bundle.profile.height-12 {return true;}
        let node=record.source;
        // Document link labels must remain fully readable, even when a button would clip them.
        if node.kind=="button" and str_starts_with(try node.name catch "","block") {
            let label=Flow.layout(node.text,num_max(0,record.w-24),node);
            let size=Flow.metrics(node).size;let label_height=record.h-num_max(0,(record.h-size)/2);
            if label.truncated or len(label.lines)>1 or not Fit.fits(node.text,num_max(0,record.w-24),node,false,measure,label_height) {return true;}
        }
        if (node.kind=="text" or node.kind=="heading") and (try node.wrap catch false) {
            let layout=Flow.layout(node.text,record.w,node,node.kind=="heading");
            if layout.truncated {return true;}
            for line in layout.lines {if not Fit.fits(line,record.w,node,node.kind=="heading",measure) {return true;}}
        }
    }
    return false;
}
fn _rows(out,text,block,size,style,heading=false,measure=nil) {
    let clean=normalized(text);let options=map{font_family:style.font_family,font_size:size,line_height:style.line_height,font_weight:if heading {"bold"}else{"normal"}};
    // A canonical block contains at most 256 characters. Native refinement may
    // need more than the generic 64 rows without any individual cluster clipping.
    let flow=Fit.lines(clean,out.width-24,options,heading,measure,256);
    if flow.truncated {out.available=false;out.reason="Text cluster cannot fit the supported viewport.";return;}
    let cursor=0;let index=0;
    for line in flow.lines {
        let offset=str_index_of(str_slice(clean,cursor,len(clean)),line);
        if offset<0 {throw "Reader line coverage mismatch.";}
        let start=cursor+offset;cursor=start+len(line);
        push(out.rows,map{kind:"text",text:line,block:block,start:start,end:cursor,size:size,
            heading:heading,h:flow.metrics.line_height,gap:if index==0 {8}else{0}});index=index+1;
    }
}
fn plan(document,options,width,height,measure=nil) {
    if type(width)!="number" or type(height)!="number" or width!=num_floor(width) or height!=num_floor(height)
        or width<320 or width>7680 or height<240 or height>4320 {throw "Reader viewport must fit the GUI viewport bounds.";}
    let doc=D.inspect(document);let style=View.appearance(options);
    let out=map{width:width,height:height,rows:[],pages:[],available:true,reason:"",content_height:height-186};
    _rows(out,doc.title,-1,num_floor(style.title_size*style.font_scale+0.5),style,true,measure);
    let index=0;
    for block in doc.blocks {
        let size=num_floor(style.body_size*style.font_scale+0.5);if block.tag=="h2" {size=size+4;}
        _rows(out,block.text,index,size,style,block.tag=="h2",measure);
        if block.tag=="a" {push(out.rows,map{kind:"link",text:block.text,href:block.href,block:index,
            start:len(normalized(block.text)),end:len(normalized(block.text)),h:40,gap:4});}
        index=index+1;
    }
    let rows=[];let used=0;
    for row in out.rows {
        if row.h>out.content_height {out.available=false;out.reason="Window is too short for the selected text size.";}
        let gap=if len(rows)==0 {0}else{row.gap};
        if used+gap+row.h>out.content_height and len(rows)>0 {push(out.pages,rows);rows=[];used=0;gap=0;}
        push(rows,row);used=used+gap+row.h;
    }
    if len(rows)>0 {push(out.pages,rows);}
    // Preserve the controller/anchor when magnification exceeds the page budget;
    // a larger viewport can recover the complete layout without reopening the document.
    if len(out.pages)>512 {out.available=false;out.reason="Reader page budget exceeded.";out.pages=[];}
    return out;
}
fn locate(plan,anchor) {
    let selected=0;
    for i len(plan.pages) {for row in plan.pages[i] {
        if row.block<anchor.block or (row.block==anchor.block and (row.start<anchor.offset
            or (row.start==anchor.offset and (row.kind=="text" or (try anchor.kind catch "text")=="link")))) {selected=i;}
    }}return selected;
}
fn anchor(plan,page) {
    if type(page)!="number" or page!=num_floor(page) or page<0 or page>=len(plan.pages) {throw "Invalid reader page.";}
    let first=plan.pages[page][0];return map{block:first.block,offset:first.start,kind:first.kind};
}
fn view(plan,page,style,toolbar,previous,next) {
    let count=len(plan.pages);let usable=plan.available and count>0;
    let children=[toolbar,UI.spacer(8),UI.text(if usable {"Page "+str(page+1)+" / "+str(count)+" • Page Up / Page Down"}else{"Reading layout needs more space"},map{name:"reading_status",font_size:12,line_height:1.25,h:18}),UI.spacer(6),
        UI.row([UI.button("Previous page",previous,map{name:"reading_previous",enabled:usable and page>0,font_size:14,line_height:1.25,h:40}),
            UI.button("Next page",next,map{name:"reading_next",enabled:usable and page+1<count,font_size:14,line_height:1.25,h:40})],map{responsive:false,gap:8,padding:0}),UI.spacer(8)];
    if usable {
        let first=true;
        for row in plan.pages[page] {
            if not first and row.gap>0 {push(children,UI.spacer(row.gap));}first=false;
            if row.kind=="link" {push(children,UI.button("Open link",UI.action_set_text("destination",row.href),map{name:"block"+str(row.block),font_size:14,line_height:1.25,h:40,accessibility_label:"Open local link: "+row.text}));}
            else {push(children,UI.text(row.text,map{name:"reading_"+str(row.block)+"_"+str(row.start),font_size:row.size,font_weight:if row.heading{"bold"}else{"normal"},h:row.h,wrap:false}));}
        }
    }else {push(children,UI.text("Enlarge window or change Style.",map{name:"reading_help",font_size:14,line_height:1.25,wrap:true,max_lines:2,h:40}));}
    push(children,UI.spacer(6));push(children,UI.text("Local links only • No network access",map{name:"destination",font_size:12,line_height:1.25,wrap:true,max_lines:2,h:36,tone:"muted"}));
    return UI.screen(children,map{padding:12,gap:0,font_family:style.font_family});
}
export normalized,needs,plan,locate,anchor,view;
