let App=import("./app.sapp");let GUI=import("stdlib:gui.sapp");
let reader=App.create();
GUI.get(reader.form,"block2").onclick(reader.form);App.update(reader,[]);
App.update(reader,[map{type:"keydown",key:"Left",alt:true},map{type:"keyup",key:"Left"}]);
assert(reader.session.snapshot().url=="pb://home","Alt+Left goes back");
App.history_shortcuts(reader,false); // An embedding app can reserve Alt+arrows.
App.update(reader,[map{type:"keydown",key:"Right",alt:true},map{type:"keyup",key:"Right"}]);
assert(reader.session.snapshot().url=="pb://home","Disabled shortcut stays put");
App.history_shortcuts(reader); // Re-enable; toolbar and page keys are independent.
App.update(reader,[map{type:"keydown",key:"Right",alt:true},map{type:"keyup",key:"Right"}]);
assert(reader.session.snapshot().url=="pb://guide","Alt+Right goes forward");
reader.session.close();print "reader_shortcuts_demo_pass";
