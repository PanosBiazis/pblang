let App=import("./app.sapp");
let reader=App.create();App.enable_preferences(reader);reader.width=320;reader.height=240;
reader.settings=true;reader.focus_target="style_apply";App.refresh(reader);
App.settings_page(reader,7);App.update(reader,[]);
assert(reader.form.focus=="style_reset","Unavailable Save page leads forward to Reset");
App.settings_page(reader,7);App.update(reader,[]);
assert(reader.form.focus=="style_apply","Unavailable Save page leads backward to Apply");
App.close_preferences(reader);App.update(reader,[]);reader.session.close();print "reader_disabled_page_demo_pass";
