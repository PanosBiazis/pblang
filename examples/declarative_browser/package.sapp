// Run from the repository's supported PBLang environment; no Python build step.
let Builder=import("./package_builder.sapp");
let raw=try env_get("PBLANG_SCRIPT_ARGS") catch "";let args=if raw==nil or raw=="" {[]}else{str_split(raw,"\n")};
if len(args)!=4 or args[2]!="--runtime" {throw "usage: package.sapp REPO NEW_OUTPUT --runtime ELF_RUNTIME";}
let result=Builder.bundle(args[0],args[1],args[3]);print json_stringify(result);
if not result.ok {throw "Reader package not confirmed. Inspect the result and preserve any staging/output.";}
