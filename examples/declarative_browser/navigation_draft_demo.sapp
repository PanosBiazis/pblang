let App=import("./app.sapp");let GUI=import("stdlib:gui.sapp");
let reader=App.create();App.enable_preferences(reader);App.update(reader,[]);
GUI.get(reader.form,"appearance").onclick(reader.form);App.update(reader,[]);
GUI.get(reader.form,"font_family").onclick(reader.form);App.update(reader,[]);
assert(reader.preferences.draft.font_family=="serif" and reader.appearance.font_family=="sans","Only draft changed");
GUI.get(reader.form,"home").onclick(reader.form);App.update(reader,[]);
assert(not reader.settings and reader.preferences.draft==reader.appearance,"Navigation discards draft immediately");
assert(reader.preferences.message=="Unapplied changes discarded","Dismissal is explained");
reader.session.close();print "reader_navigation_draft_demo_pass";
