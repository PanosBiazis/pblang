// Headless controller example: the actual GUI uses these same navigation callbacks.
let App=import("./app.sapp");let GUI=import("stdlib:gui.sapp");let D=import("stdlib:browser_document.sapp");
let source=D.export_html(D.create("A remembered reading position",[
    map{tag:"p",text:str_repeat("Readable local text. ",12)},
    map{tag:"a",text:"Open guide",href:"pb://guide"}]));
let reader=App.create("local","dark",map{body_size:20,font_scale:1.5},source);
reader.width=320;reader.height=480;App.refresh(reader);
App.read_page(reader,len(reader.reading_plan.pages)-1);App.refresh(reader);
let position=reader.reading_anchor;
GUI.get(reader.form,"block1").onclick(reader.form);App.update(reader,[]);
GUI.get(reader.form,"back").onclick(reader.form);App.update(reader,[]);
assert(reader.reading_anchor==position,"Back returns to the reading position");
App.remember_positions(reader,false); // Optional legacy first-page navigation.
assert(reader.reading_anchor==position,"Policy change keeps the current page");
reader.session.close();print "reader_position_demo_pass";
