let App=import("./app.sapp");
let reader=App.create();
App.zoom(reader,1);App.update(reader,[]);
assert(reader.appearance.font_scale==1.05,"one session zoom step");
App.zoom_shortcuts(reader,false); // Host application reserves Ctrl/Meta shortcuts.
App.zoom(reader,0);App.update(reader,[]);
assert(reader.appearance.font_scale==1,"reset changes only text scale");
reader.session.close();print "reader_zoom_demo_pass";
