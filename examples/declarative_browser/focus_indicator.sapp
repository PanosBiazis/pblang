// Reader-only native presentation; never changes focus, events or widget geometry.
let GUI=import("stdlib:gui.sapp");let Style=import("stdlib:ui_style.sapp");
let Colors=import("stdlib:colors.sapp");let Clip=import("stdlib:rect_clip.sapp");
fn _crop(rect,bounds) {
    let x=num_max(rect.x,bounds.x);let y=num_max(rect.y,bounds.y);
    return map{x:x,y:y,w:num_max(0,num_min(rect.x+rect.w,bounds.x+bounds.w)-x),h:num_max(0,num_min(rect.y+rect.h,bounds.y+bounds.h)-y)};
}
fn _plan(form) {
    let name=form.focus;if name==nil {return nil;}
    let w=GUI.get(form,name);
    if w==nil or w.kind!="button" or not (try w.enabled catch true) or not (try w.visible catch true) {return nil;}
    // Native reader controls exceed these limits; smaller custom controls keep legacy drawing.
    let x=num_ceil(w.x)+2;let y=num_ceil(w.y)+2;
    let width=num_floor(w.x+w.w)-x-2;let height=num_floor(w.y+w.h)-y-2;
    if width<20 or height<20 {return nil;}
    let style=Style.button(form.palette,try w.variant catch "primary",try w.selected catch false,true);
    let fill=style.fill;
    if type(fill)!="array" or (len(fill)!=3 and len(fill)!=4) {return nil;}
    if len(fill)==4 and fill[3]!=255 {return nil;}
    let choice=Colors.best_text_checked(map{r:fill[0],g:fill[1],b:fill[2]});
    let rgb=Colors.hex_checked(choice.hex);let color=[rgb.r,rgb.g,rgb.b,255];
    let bounds=Clip.region(map{x:0,y:0,w:form.w,h:form.h});let clip=try w.clip_rect catch nil;
    if clip!=nil {bounds=_crop(bounds,Clip.region(clip));}
    let rects=[];
    for rect in [map{x:x,y:y,w:width,h:3},map{x:x,y:y+height-3,w:width,h:3},
        map{x:x,y:y+3,w:3,h:height-6},map{x:x+width-3,y:y+3,w:3,h:height-6}] {
        let visible=_crop(rect,bounds);if visible.w>0 and visible.h>0 {push(rects,visible);}
    }
    if len(rects)==0 {return nil;}
    return map{name:name,color:color,contrast:choice.ratio,thickness:3,rects:rects};
}
// Unsupported/malformed custom presentation gets the unchanged GUI fallback.
fn plan(form) {return try _plan(form) catch nil;}
fn draw(canvas,form) {
    let indicator=plan(form);if indicator==nil {return false;}
    for rect in indicator.rects {canvas.rect(rect.x,rect.y,rect.w,rect.h,indicator.color);}
    return true;
}
export plan,draw;
