let Lifecycle = import("examples/supervised_tasks/lifecycle.sapp");
let App = import("examples/supervised_tasks/app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "supervised_tasks test failed: " + message; }
}

fn rejected(callable) { return (try { callable(); false } catch true); }

fn record(bundle, name) {
    for item in bundle.records { if item.name == name { return item; } }
    return nil;
}

let plan = Lifecycle.plan(map{
    short_iterations: 5, short_delay_ms: 1, worker_poll_ms: 1, deadline_ms: 250
});
require(plan.bounded and plan.cooperative_cancellation and not plan.daemon_threads,
    "plan must describe bounded structured workers");
require(plan.planned_short_ms == 5 and len(plan.workers) == 2,
    "plan must preserve the validated workload");

require(rejected(fn() { Lifecycle.plan("invalid"); }), "non-map options must fail");
require(rejected(fn() { Lifecycle.plan(map{ short_iterations: 0 }); }),
    "zero iterations must fail");
require(rejected(fn() { Lifecycle.plan(map{ short_iterations: 65 }); }),
    "oversized work must fail");
require(rejected(fn() { Lifecycle.plan(map{
    short_iterations: 20, short_delay_ms: 10, deadline_ms: 100
}); }), "deadline without cleanup headroom must fail");
require(rejected(fn() { Lifecycle.plan(map{
    worker_poll_ms: 100, deadline_ms: 100
}); }), "deadline shorter than cancellation polling and cleanup must fail");

let run = Lifecycle.run(map{
    short_iterations: 5, short_delay_ms: 1, worker_poll_ms: 1, deadline_ms: 500
});
require(run.verified, "structured lifecycle must verify");
require(run.short_status.status == "completed", "short task must complete");
require(run.background_status.status == "cancelled",
    "background task must observe cancellation");
require(run.before_reap.active == 0 and run.before_reap.detached == 0
    and run.before_reap.unreaped == 0,
    "terminal state must have no active, detached or unreaped worker");
require(run.reaped == 2 and run.after_reap.tracked == 0,
    "both terminal records must be reaped");

let repeat = 0;
while repeat < 12 {
    let cycle = Lifecycle.run(map{
        short_iterations: 1, short_delay_ms: 0, worker_poll_ms: 1, deadline_ms: 250
    });
    require(cycle.verified and cycle.after_reap.tracked == 0,
        "repeated lifecycle must not leak at cycle " + str(repeat));
    repeat = repeat + 1;
}

let capabilities = Lifecycle.capabilities();
require(capabilities.structured_workers and capabilities.deterministic_reaping,
    "capabilities must expose implemented lifecycle guarantees");
require(not capabilities.preemptive_thread_termination
    and not capabilities.blocking_native_call_isolation,
    "unsupported force termination and isolation must remain explicit");

let view = App.view();
require(UI.validate(view).ok, "shared UI tree must validate");
let web = UI.compile(view, map{ target: "web", width: 320, height: 640 });
let native = UI.compile(view, map{ target: "native", width: 1440, height: 900 });
let android = UI.compile(view, map{ target: "android", width: 360, height: 720 });
for bundle in [web, native, android] {
    require(record(bundle, "brand") != nil, "brand must render on every target");
    require(record(bundle, "inspect_short") != nil, "short task action must render");
    require(record(bundle, "inspect_background") != nil,
        "background task action must render");
    require(record(bundle, "inspect_cleanup") != nil, "cleanup action must render");
    require(record(bundle, "stage_detail") != nil, "accessible stage status must render");
    require(record(bundle, "scope_note") != nil, "scope limitation must remain visible");
}

let preview = UI.preview_web("Supervised Task Lab", view, App.web_options());
require(preview.response.status == 200, "generated Web preview must return HTTP 200");
require(str_contains(preview.generated.html, "viewport-fit=cover"),
    "Web preview must support compact viewports");
require(str_contains(preview.generated.css, "@media(max-width:640px)"),
    "Web preview must include responsive rules");
require(not str_contains(preview.generated.html, "http://")
    and not str_contains(preview.generated.html, "https://"),
    "Web preview must have no remote runtime dependency");
require(App.source_sha256() ==
    "3631284ad8c23a9d288c06f0ea76147d9f2a381c2fbf770d70db7afedaf39511",
    "source provenance digest must remain stable");

for source_path in [
    "examples/supervised_tasks/lifecycle.sapp",
    "examples/supervised_tasks/app.sapp",
    "examples/supervised_tasks/benchmark.sapp",
    "examples/supervised_tasks/main.sapp",
    "examples/supervised_tasks/test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
        "bounded security analysis must pass for " + source_path);
}

print "supervised_tasks_pass";
