let Lifecycle = import("examples/supervised_tasks/lifecycle.sapp");

let completed = 0;
let index = 0;
while index < 32 {
    let report = Lifecycle.run(map{
        short_iterations: 1, short_delay_ms: 0, worker_poll_ms: 1, deadline_ms: 250
    });
    if not report.verified or report.after_reap.tracked != 0 {
        throw "bounded lifecycle benchmark leaked a supervised worker";
    }
    completed = completed + 1;
    index = index + 1;
}

print json_stringify(map{
    format: "pblang.example.supervised-tasks-benchmark.v1",
    lifecycle_cycles: completed,
    workers_started: completed * 2,
    residual_workers: 0,
    verified: completed == 32
});
