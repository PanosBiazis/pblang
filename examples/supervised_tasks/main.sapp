let Lifecycle = import("examples/supervised_tasks/lifecycle.sapp");
let App = import("examples/supervised_tasks/app.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn main() {
    let report = Lifecycle.run();
    if not report.verified { throw "supervised lifecycle verification failed"; }

    let ui = UI.compile(App.view(), map{ target: "native", width: 1280, height: 800 });
    print "short=" + report.short_status.status;
    print "cooperative=" + report.background_status.status;
    print "active=" + str(report.before_reap.active)
        + " detached=" + str(report.before_reap.detached)
        + " unreaped=" + str(report.before_reap.unreaped);
    print json_stringify(map{
        format: "pblang.example.supervised-tasks.v2",
        verified: report.verified,
        reaped: report.reaped,
        ui_records: len(ui.records),
        capabilities: Lifecycle.capabilities()
    });
    return report.verified;
}

main();
