let thread = import("stdlib:thread.sapp");

let supervisor = thread.supervisor();

let quick_id = supervisor.spawn(fn() { return 6 * 7; }, 1000);
let quick = supervisor.wait(quick_id, 1000);
if quick.status != "completed" { throw "quick task did not complete"; }

let cancellable_id = supervisor.spawn_cooperative(fn(token) {
    let pause = channel_buffered(1);
    let iterations = 0;
    while not token.requested(token) {
        recv_timeout(pause.receiver, 1);
        iterations = iterations + 1;
    }
    return iterations;
}, 5000);

if not supervisor.cancel(cancellable_id, "example-stop") {
    throw "cancellation request was rejected";
}

let stopped = supervisor.wait(cancellable_id, 1000);
if stopped.status != "cancelled" { throw "cooperative task did not stop"; }

let stats = supervisor.stats();
print "quick=" + quick.status;
print "cooperative=" + stopped.status;
print "active=" + str(stats.active) + " detached=" + str(stats.detached);
