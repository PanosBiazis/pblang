let UI = import("stdlib:modern_ui.sapp");

fn source_sha256() {
    return "3631284ad8c23a9d288c06f0ea76147d9f2a381c2fbf770d70db7afedaf39511";
}

fn _inspect_action(title, detail) {
    return UI.action_sequence([
        UI.action_set_text("selected_stage", title),
        UI.action_set_text("stage_detail", detail)
    ]);
}

fn view() {
    return UI.screen([
        UI.heading("Supervised Task Lab", map{
            name: "brand", accessibility_label: "Supervised Task Lab"
        }),
        UI.text("Bounded work, cooperative cancellation and proven cleanup", map{
            name: "subtitle"
        }),
        UI.grid([
            UI.card([
                UI.heading("Short task"),
                UI.text("Completes a validated, finite number of steps"),
                UI.button("Inspect", _inspect_action("Short task",
                    "Deadline-bound work reaches completed status"), map{
                    name: "inspect_short", accessibility_label: "Inspect short task lifecycle"
                })
            ], map{ name: "short_card" }),
            UI.card([
                UI.heading("Background task"),
                UI.text("Polls a transferable cancellation token"),
                UI.button("Inspect", _inspect_action("Background task",
                    "Cancellation is observed at a safe interruption point"), map{
                    name: "inspect_background",
                    accessibility_label: "Inspect background task lifecycle"
                })
            ], map{ name: "background_card" }),
            UI.card([
                UI.heading("Cleanup proof"),
                UI.text("No active, detached or unreaped workers remain"),
                UI.button("Inspect", _inspect_action("Cleanup proof",
                    "Terminal records are joined and deterministically reaped"), map{
                    name: "inspect_cleanup", accessibility_label: "Inspect cleanup proof"
                })
            ], map{ name: "cleanup_card" })
        ], map{ name: "lifecycle_grid", columns: 3, gap: 12 }),
        UI.heading("Short task", map{ name: "selected_stage" }),
        UI.text("Deadline-bound work reaches completed status", map{
            name: "stage_detail", accessibility_label: "Selected lifecycle stage details"
        }),
        UI.progress(100, map{
            name: "cleanup_progress", accessibility_label: "Cleanup verification complete"
        }),
        UI.text("Preemptive thread termination is not claimed.", map{
            name: "scope_note", accessibility_label: "Runtime scope limitation"
        })
    ], map{ name: "supervised_tasks_root", gap: 16 });
}

fn web_options() {
    return map{
        theme: "light", lang: "en", host: "127.0.0.1", port: 8080,
        width: 1180, height: 800, source_sha256: source_sha256(),
        palette: map{
            accent: [0, 121, 107], selected: [0, 77, 64], focus: [0, 95, 204]
        }
    };
}

export source_sha256, view, web_options;
