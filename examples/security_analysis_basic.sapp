// examples/security_analysis_basic.sapp — Basic Static Security Analysis Example
let SECURITY = import("stdlib:security_analysis.sapp");

let sample_code = "// Safe loopback health probe with explicit suppression\n// pblang-security-ignore-next-line: network.plaintext-http reason=loopback health probe\nlet health_url = \"http://127.0.0.1:8080/health\";\nlet token = \"safe-entropy-token\";\n";

let report = SECURITY.analyze(sample_code, "health_service.sapp", map{
    minimum_blocking_severity: "high"
});

print "Security Analysis Result: ok=" + str(report.ok) + " blocking=" + str(report.blocking) + " findings=" + str(report.finding_count);
print json_stringify(report);
