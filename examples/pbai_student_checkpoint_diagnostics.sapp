// Read only: create student.json with the existing file example beforehand.
let S=import("stdlib:pbai_checkpoint_scope.sapp");
let directory=env_get("PBAI_CHECKPOINT_TEST_DIR");let name=env_get("PBAI_CHECKPOINT_CANDIDATE");
assert(type(directory)=="string" and directory!="","explicit private checkpoint directory required");
assert(name=="missing.json" or name=="corrupt.json" or name=="student.json","select a fixed diagnostic case");
let result=S.with_files([path_join(directory,"student.json"),path_join(directory,name)],fn(handles){
 return map{ok:true,value:handles[1].predict([6,0]).token};
});
print json_stringify(map{format:"pbai.checkpoint-diagnostic.example.v1",ok:result.ok,
 stage:result.stage,acquisition_error:result.acquisition_error,acquired_count:result.acquired_count,
 cleanup_ok:result.cleanup_ok,cleanups_attempted:result.cleanups_attempted,value:result.value,
 original_body_error_available:result.original_error_available,globally_activated:false});
