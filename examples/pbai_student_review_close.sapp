let AI=import("stdlib/pbai.sapp");
let N=import("stdlib:pbai_neural_adapter.sapp");
let specialist=AI.neural_specialist_bind(N);let R=import("stdlib:resource_scope.sapp");
fn close_owned(closer){return fn(){return map{ok:true,value:closer()};};}
fn use_owned(scope){
let old_train=[map{x:[0],y:4},map{x:[1,0],y:4}];let old_valid=[map{x:[7,0],y:4}];
let teacher=specialist.train([old_train[0]],old_valid);
let seed=specialist.distill(teacher.artifact,[[0],[1,0]],old_valid);
scope.defer(close_owned(seed.close));
let parent=seed.checkpoint();assert(seed.close(),"release checkpoint seed");
let history=specialist.student_history(parent,old_train,old_valid);
// Explicit terminal close is separate from rollback and exporting artifacts.
let h=specialist.student_continue_reviewed(parent,history,
 [map{x:[2,0],y:4},map{x:[3,0],y:4}],[map{x:[4,0],y:4}]);
scope.defer(close_owned(h.close));
assert(h.report().passed,"synthetic review passes");h.accept();
let exported=h.checkpoint();let before=json_stringify(h.predict([5,0]));
assert(h.close() and not h.close(),"terminal and idempotent close");
let refused=try {h.predict([5,0]);false} catch true;
let restored=specialist.student_load(exported);
scope.defer(close_owned(restored.close));
assert(refused and h.status().phase=="closed" and h.status().active_checkpoint_digest==nil,"closed handle refuses inference");
assert(json_stringify(restored.predict([5,0]))==before,"earlier explicit export remains usable");
print json_stringify(map{format:"pbai.student-review-close.example.v1",phase:h.status().phase,
 inference_refused:refused,export_usable:true,report_available:h.report().passed,globally_activated:false});
return map{ok:true,value:nil};
}
let result=R.with_scope(use_owned);
assert(result.ok and result.cleanup_ok,"review-close workflow and explicit cleanup complete");
