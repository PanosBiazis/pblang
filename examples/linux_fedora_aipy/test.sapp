let AIPY = import("../aipy/app.sapp");

fn require(value, message) { if not value { throw "linux_fedora_aipy test failed: " + message; } }

let first = AIPY.sample(42, 8);
let second = AIPY.sample(42, 8);
require(first == second and len(first) == 8, "generation must be deterministic and bounded");

let demo = AIPY.demo(42);
require(demo.ok and demo.stored == 8 and demo.parameterized_sql, "database demo failed");

let web = AIPY.create_app(42);
let home = web.handle(map{ method: "GET", path: "/", headers: map{ "user-agent": "Mozilla/5.0" }, body: "" });
require(home.status == 200 and str_contains(home.body, "AIPY data dashboard"), "home route failed");
require(map_has(home.headers, "Content-Security-Policy"), "security headers missing");
let api = web.handle(map{ method: "GET", path: "/api/samples", headers: map{ "user-agent": "Mozilla/5.0" }, body: "" });
require(api.status == 200, "API route failed");
web.conn.close();

print "linux_fedora_aipy_pass";
