let P=import("stdlib:thread_pool.sapp");
fn delayed(ms,value) {return fn(){sleep_ms(ms);return value;};}
let race=P.race_owned([delayed(0,"cache"),delayed(50,"lookup")],10);
// The caller owns both jobs after early return, including on timeout.
// Settle before leaving the owning scope or discarding the result.
P.settle_race(race);
if race.ready { print race.value; }
else { print race.status; }
assert(race.handles[0].__resolved and race.handles[1].__resolved,"owned completion");
