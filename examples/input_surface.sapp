let INPUT=import("stdlib:input_surface.sapp");
// Synthetic interactive-board corners; normalized coordinates can feed any renderer.
print json_stringify(INPUT.transform(map{width:1920,height:1080,rotation:90},
    [map{x:0,y:0},map{x:1920,y:1080}]));
// A complete synthetic pen stroke. No connected device or input injection.
print json_stringify(INPUT.analyze([
    map{contact_id:0,kind:"pen",phase:"start",time_ms:0,x:0.1,y:0.2,pressure:0.2},
    map{contact_id:0,kind:"pen",phase:"move",time_ms:16,x:0.5,y:0.5,pressure:0.7,tilt_x:10},
    map{contact_id:0,kind:"pen",phase:"end",time_ms:32,x:0.8,y:0.8,pressure:0}]));
