// Read-only Linux identity probe. No keyboard, desktop, or process-control signal.
let P=import("stdlib:linux_pidfd.sapp");
fn demonstrate() {
    let current=P.current_pid();
    if not current.ok {throw "current process identity unavailable";}
    let held=P.open(current.pid);
    if not held.ok {throw "Linux pidfd support unavailable";}
    let present=try P.exists(held) catch false;
    let released=try P.close(held) catch false;
    print map{identity_held:present,resources_released:released};
    if not released {throw "identity cleanup was not fully confirmed";}
}
if platform()=="linux" {demonstrate();}
else {print "This identity probe requires Linux; no platform fallback was attempted.";}
