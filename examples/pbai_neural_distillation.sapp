let AI=import("stdlib/pbai.sapp");
let R=import("stdlib:resource_scope.sapp");
fn close_owned(closer){return fn(){return map{ok:true,value:closer()};};}
fn use_owned(scope){
let teacher=AI.neural_specialist_train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let student=AI.neural_specialist_distill(teacher.artifact,[[0],[1,0]],[map{x:[7,0],y:4}]);
scope.defer(close_owned(student.close));
print json_stringify(student.report);
print json_stringify(student.evaluate([map{x:[6,0],y:4}]));
print student.predict([6,0]).token;
assert(student.close(),"release caller-owned distillation state");
return map{ok:true,value:nil};
}
let result=R.with_scope(use_owned);
assert(result.ok and result.cleanup_ok,"distillation workflow and explicit cleanup complete");
