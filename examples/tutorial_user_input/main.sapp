// Tutorial: User Input
// Ask the user for text + a number from stdin.
// In some non-interactive runners, read_line() may return nil.

print "What is your name?";
let name_raw = read_line();
let name = if name_raw == nil { "Developer" } else { str_trim(name_raw) };

print "Hi, " + name + "!";
print "Give me your favorite number:";
let n_raw = read_line();
let n = if n_raw == nil { nil } else { try parse_number(str_trim(n_raw)) catch nil };

if n == nil {
    print "No valid number provided.";
} else {
    print "number + 1 = " + str(n + 1);
    print "number^2 = " + str(n * n);
}
