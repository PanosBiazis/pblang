// Safe PBLang translations for every file in Documents/codes/linux.

let Safety = import("examples/linux_script_ports/safety.sapp");
let AIPY = import("../aipy/app.sapp");
let Bench = import("stdlib:benchmark.sapp");

fn _entry(source, destination, sha256_value, category, risk, replacement) {
    return map{ source: source, destination: destination, sha256: sha256_value,
        category: category, risk: risk, replacement: replacement };
}

fn catalog() {
    return [
    _entry("bench_bootstrap.sh", "linux_bench_bootstrap", "b6f02baf1c1adf132a6cae5850f416a082812e244671c519373e697c7c7c56d1", "benchmark", "medium", "bounded native PBLang benchmark"),
    _entry("chperm.sh", "linux_chperm", "32faafa74f135576b0f37df3946ffacf6de9a5135839d03c822b4e5d09bf8652", "permissions", "high", "non-recursive explicit chmod"),
    _entry("compile_native.sh", "linux_compile_native", "a302eb36e7a2e1bdf1091b459a87145d493f6be99e35c04b48b7a446d0a62925", "build", "medium", "PBLang build plan without shell"),
    _entry("fedora/aipy/aipy.py", "linux_fedora_aipy", "29154bd3939f1839ffaacced490dc896ad28535e14e04a722dd278e7f761396f", "data", "low", "seeded PBLang model data"),
    _entry("fedora/aipy/aipy2.py", "linux_fedora_aipy", "404894eac27607c3899470bad2f413dbe78d675405d809321120bdc25b33ae93", "web", "medium", "loopback hardened PBLang web app"),
    _entry("fedora/aipy/aipy3.py", "linux_fedora_aipy", "6db1eb393256f23a6cbb7001f8fc06cfc84ab29f72314ad8f9c0aec1f1619da4", "database", "medium", "bounded transactional generation"),
    _entry("fedora/aipy/connect.php", "linux_fedora_aipy", "d772a008dd9258f9e0f50a94f3b8e7d475171793d3f8791714b2306d1d32941c", "database", "high", "credential-free in-memory SQLite"),
    _entry("fedora/aipy/index.html", "linux_fedora_aipy", "338cfa74426b620ef7557c89459da1a93316997c683e079665520d75f78907f0", "web", "low", "escaped responsive PBLang HTML"),
    _entry("fedora/aipy/index.php", "linux_fedora_aipy", "b34fce67ef9fc6f290adc32ef5f3e6381fca33b082cd7ac76a26ab8f2613dd87", "web", "high", "parameterized bounded table query"),
    _entry("fedora/aipy/python.txt", "linux_fedora_aipy", "9195455e5a060e2aa7c3e44356777c10f18d609f1934fe3b4992db6c4bf140c4", "documentation", "medium", "dependency-free PBLang setup report"),
    _entry("fedora/aipy/start.py", "linux_fedora_aipy", "ff0bcabdb119499b3d152afb79794066c16a8532f425afdd8f72bae6a97b9d62", "orchestration", "medium", "single-process PBLang composition"),
    _entry("fedora/aipy/style.css", "linux_fedora_aipy", "253a0a8954259e9b14e0356b0c694885b4804cfc7dcdc84709debf520b400d6f", "web", "low", "responsive generated CSS"),
    _entry("fedora/aipy/table.html", "linux_fedora_aipy", "1c255648d4a86d180a6ecd960920d965993262e85dabe9bb30bb59719551b0ee", "web", "low", "escaped generated table"),
    _entry("fedora/chperm.sh", "linux_fedora_chperm", "32faafa74f135576b0f37df3946ffacf6de9a5135839d03c822b4e5d09bf8652", "permissions", "high", "duplicate preserved as independent example"),
    _entry("fedora/screenshot_ocr.py", "linux_fedora_screenshot_ocr", "74eb9010fec952dc31789adf66c5a1a89a31fb3f8e9cbadc489ebd75f798ef58", "ocr", "high", "consent-gated bounded OCR adapter"),
    _entry("fedora/ssocr.sh", "linux_fedora_ssocr", "68b134e20a7134d18ef4a01b3a02aa8b5a81d72ae678577de8896859616c5025", "ocr", "high", "PBLang OCR launcher"),
    _entry("fedora/strapi.sh", "linux_fedora_strapi", "c74eb58ecfdf723719615726a66af7afe9b704c75667ed56b4c601f6e3dafc15", "dev-server", "medium", "bounded npm plan"),
    _entry("fedora/taskmanager.sh", "linux_fedora_taskmanager", "bf85f46f79b1aa9d64cad964c7048a0e39052379153f967d7c6aef24301d721e", "process", "high", "bounded process listing and TERM"),
    _entry("fedora/vscode.sh", "linux_fedora_vscode", "dc247850272565a514d1524bcbe7e193936d02cfe03657fc071068f903e7c021", "launcher", "high", "validated Flatpak launch without no-sandbox"),
    _entry("fedora/vscode2.sh", "linux_fedora_vscode2", "9346ff666d8cfb652a87c5750f1de5b47aa6390b366f1c4733a610851f5f2263", "launcher", "high", "validated Flatpak launch without sudo"),
    _entry("fedora/xampp.sh", "linux_fedora_xampp", "8fe4117c28ee55b02e3b13f571488032740c03e6c607e2f91c487515ab12294c", "service", "high", "fixed executable launch plan"),
    _entry("linuxscript.sh", "linux_language_basics", "19c392b8ba138824ee6dab8228f90270050a1ea1e1368c684da094775d804a7c", "tutorial", "low", "pure PBLang language tutorial"),
    _entry("ntfsf.sh", "linux_ntfs_recovery", "5d0c7eb94a8a4887e5a8fcc7b29d03d787c9f7bf178a27d13a711ed31036c211", "storage", "critical", "explicit device repair plan"),
    _entry("refresh-perplexity-context.ps1", "linux_refresh_context", "839c0b2048b9e0942e1e18bff06637149671e749ed4f0cca58f5bf9b5a082316", "filesystem", "medium", "validated descriptor-safe migration plan"),
    _entry("ssocr.sh", "linux_ssocr", "2c6731c154e63d75aa5b98d33cd7459dc385d90f2c462b53b43b80987958e8c5", "ocr", "high", "PBLang OCR launcher"),
    _entry("start-ide-backend.sh", "linux_start_ide_backend", "ec97d8be4bd99e1c0e12fa6cbda5581632a38e78066588148d1e2b3509af0ee3", "dev-server", "medium", "validated loopback backend plan"),
    _entry("strapi.sh", "linux_strapi", "c74eb58ecfdf723719615726a66af7afe9b704c75667ed56b4c601f6e3dafc15", "dev-server", "medium", "bounded npm plan"),
    _entry("t", "linux_test_runner", "9098bc8678192625011ff3cf81d9278f5d9f4223551ac55a61c32737902b9eca", "testing", "high", "non-destructive bounded test plan"),
    _entry("taskmanager.sh", "linux_taskmanager", "bf85f46f79b1aa9d64cad964c7048a0e39052379153f967d7c6aef24301d721e", "process", "high", "bounded process listing and TERM"),
    _entry("test/test.txt", "linux_test_fixture", "f2ca1bb6c7e907d06dafe4687e579fce76b37e4e93b7605022da52e6ccc26fd2", "fixture", "low", "PBLang fixture contract"),
    _entry("update.sh", "linux_system_update", "f59ff1db27fe64654b4793908e5c305bce32c10dfa7c82c7b2de41adc417ab16", "system-update", "critical", "one explicit package operation at a time"),
    _entry("vscode.sh", "linux_vscode", "9346ff666d8cfb652a87c5750f1de5b47aa6390b366f1c4733a610851f5f2263", "launcher", "high", "validated Flatpak launch without sudo"),
    _entry("vscode2.sh", "linux_vscode2", "dc247850272565a514d1524bcbe7e193936d02cfe03657fc071068f903e7c021", "launcher", "high", "validated Flatpak launch without no-sandbox"),
    _entry("xampp.sh", "linux_xampp", "c72134188a092f691e5f33b4ccbf09742036337ab5b778a8ed5d0291724d8798", "service", "high", "fixed executable launch plan"),
    _entry("xampp2.sh", "linux_xampp2", "8fe4117c28ee55b02e3b13f571488032740c03e6c607e2f91c487515ab12294c", "service", "high", "fixed executable launch plan")
    ];
}

fn find(source) {
    for item in catalog() { if item.source == source { return item; } }
    return nil;
}

fn _pure_benchmark() {
    let work = fn() { let total = 0; for i 1000 { total = total + i; } return total; };
    Bench.warmup(work, 3);
    let measured = Bench.run("pblang_integer_sum", work, 15);
    return map{ ok: true, executed: true, bounded: true, result: measured };
}

fn _basics(args) {
    let name = Safety.option(args, "name", "PBLang programmer");
    if len(name) > 80 { return map{ ok: false, error: "name is too long" }; }
    let values = [];
    for i in 1 to 5 { push(values, i * i); }
    return map{ ok: true, greeting: "Hello " + name, squares: values,
        terminal_control_sequences: false, interactive_clear_removed: true };
}

fn _permissions(source, args) {
    let path = Safety.option(args, "path", "workspace-item");
    let mode = Safety.option(args, "mode", "755");
    if not Safety.safe_relative_path(path) or not (mode == "700" or mode == "750"
    or mode == "755" or mode == "770" or mode == "640" or mode == "644"
    or mode == "444") {
        return map{ ok: false, error: "use a safe relative path and an allowlisted mode" };
    }
    return Safety.fixed_action("chmod", "high", source + ":" + path + ":" + mode,
    ["/usr/bin/chmod", "/bin/chmod"], ["--", mode, path], args, map{ timeout_secs: 10 },
    ["recursive chmod was intentionally removed", "mode 777 is intentionally rejected"]);
}

fn _process(source, args) {
    let pid = Safety.option(args, "pid", "");
    if pid == "" {
        return Safety.fixed_action("process-list", "low", source,
        ["/usr/bin/ps", "/bin/ps"], ["-eo", "pid,ppid,stat,comm"], args,
        map{ timeout_secs: 5, max_output_bytes: 524288 });
    }
    if not Safety.safe_pid(pid) { return map{ ok: false, error: "invalid PID" }; }
    return Safety.fixed_action("process-term", "high", source + ":" + pid,
    ["/usr/bin/kill", "/bin/kill"], ["-TERM", "--", pid], args,
    map{ timeout_secs: 5 }, ["SIGKILL and name-wide killall were intentionally removed"]);
}

fn _vscode(source, args) {
    let path = Safety.option(args, "path", ".");
    if path != "." and not Safety.safe_relative_path(path) {
        return map{ ok: false, error: "workspace path must be relative" };
    }
    return Safety.fixed_action("launch-vscode", "medium", source + ":" + path,
    ["/usr/bin/flatpak", "/bin/flatpak"], ["run", "com.visualstudio.code", path], args,
    map{ timeout_secs: 30, max_output_bytes: 262144, inherit_environment: true },
    ["eval, sudo, dbus-launch and --no-sandbox were removed"]);
}

fn _xampp(source, args) {
    return Safety.fixed_action("launch-xampp-manager", "high", source,
    ["/opt/lampp/manager-linux-x64.run", "/opt/lampp/manager-linux.run"], [], args,
    map{ timeout_secs: 60, inherit_environment: true },
    ["no sudo escalation is performed by the example"]);
}

fn _ntfs(source, args) {
    let device = Safety.option(args, "device", "");
    if not Safety.safe_device(device) {
        return map{ ok: false, executed: false,
            error: "provide an explicit bounded --device=/dev/... value" };
    }
    return Safety.fixed_action("ntfs-repair", "critical", source + ":" + device,
    ["/usr/bin/ntfsfix", "/bin/ntfsfix"], [device], args,
    map{ timeout_secs: 120, max_output_bytes: 524288 },
    ["the fixed /dev/sdb1 target and automatic mount were removed",
    "unmount and back up the selected filesystem before repair"]);
}

fn _update(source, args) {
    let operation = Safety.option(args, "operation", "update");
    let argv = [];
    if operation == "update" { argv = ["update"]; }
    elif operation == "upgrade" { argv = ["upgrade", "--no-remove"]; }
    elif operation == "check" { argv = ["check"]; }
    else { return map{ ok: false, error: "operation must be update, upgrade, or check" }; }
    return Safety.fixed_action("package-" + operation, "critical", source + ":" + operation,
    ["/usr/bin/apt-get", "/bin/apt-get"], argv, args,
    map{ timeout_secs: 1800, max_output_bytes: 2097152, inherit_environment: true },
    ["dist-upgrade, autoremove and clean are no longer chained", "no sudo is invoked"]);
}

fn _ocr(source, args) {
    let preview = Safety.preview("screen-ocr", "high", source,
    ["/usr/bin/flameshot", "/bin/flameshot"], ["gui", "-r"],
    ["screen capture requires explicit per-run consent", "captured pixels are not persisted"]);
    if not Safety.has_arg(args, "--apply") or Safety.option(args, "confirm", "") != preview.confirmation {
        return Safety.run_plan(preview, args, map{ timeout_secs: 90, max_output_bytes: 8388608,
            inherit_environment: true });
    }
    let shot = Safety.run_plan(preview, args, map{ timeout_secs: 90, max_output_bytes: 8388608,
        inherit_environment: true });
    if not shot.ok or not shot.command_ok { return shot; }
    let language = Safety.option(args, "language", "eng");
    if language != "eng" and language != "ell" and language != "eng+ell" {
        return map{ ok: false, error: "language must be eng, ell, or eng+ell" };
    }
    let result = Safety.fixed_action("ocr-decode", "high", source + ":" + language,
    ["/usr/bin/tesseract", "/bin/tesseract"], ["stdin", "stdout", "-l", language],
    ["--apply", "--confirm=" + Safety.confirmation("ocr-decode", source + ":" + language)],
    map{ timeout_secs: 90, max_output_bytes: 1048576, stdin_bytes: shot.stdout_bytes,
        inherit_environment: true });
    return result;
}

fn _dev_plan(source, kind, args) {
    let port = Safety.option(args, "port", if kind == "ide" { "3000" } else { "1337" });
    if not Safety.safe_port(port) { return map{ ok: false, error: "port must be in 1024..65535" }; }
    return map{ ok: true, executed: false, dry_run: true, source: source, kind: kind,
        host: "127.0.0.1", port: parse_number(port), shell_used: false,
        note: "Use the product's PBLang-native build/server API from its project directory; arbitrary cwd execution is intentionally not inferred." };
}

fn _aipy(source) {
    let result = AIPY.demo(42);
    result.source = source;
    result.replaces = "Python, PHP, JavaScript, CSS and MySQL implementation";
    return result;
}

fn run(source, args) {
    let metadata = find(source);
    if metadata == nil { return map{ ok: false, error: "unknown migrated source", source: source }; }
    let result = map{};
    if source == "bench_bootstrap.sh" { result = _pure_benchmark(); }
    elif source == "chperm.sh" or source == "fedora/chperm.sh" { result = _permissions(source, args); }
    elif source == "linuxscript.sh" { result = _basics(args); }
    elif source == "ntfsf.sh" { result = _ntfs(source, args); }
    elif source == "taskmanager.sh" or source == "fedora/taskmanager.sh" { result = _process(source, args); }
    elif source == "update.sh" { result = _update(source, args); }
    elif source == "vscode.sh" or source == "vscode2.sh" or source == "fedora/vscode.sh" or source == "fedora/vscode2.sh" { result = _vscode(source, args); }
    elif source == "xampp.sh" or source == "xampp2.sh" or source == "fedora/xampp.sh" { result = _xampp(source, args); }
    elif source == "ssocr.sh" or source == "fedora/ssocr.sh" or source == "fedora/screenshot_ocr.py" { result = _ocr(source, args); }
    elif str_starts_with(source, "fedora/aipy/") { result = _aipy(source); }
    elif source == "strapi.sh" or source == "fedora/strapi.sh" { result = _dev_plan(source, "strapi", args); }
    elif source == "start-ide-backend.sh" { result = _dev_plan(source, "ide", args); }
    elif source == "test/test.txt" { result = map{ ok: true, value: "test", executable: false, fixture: true }; }
    elif source == "compile_native.sh" { result = map{ ok: true, executed: false, dry_run: true,
            backend: "codegen_x86_64", safe_argv: true, note: "Use stdlib:build.sapp from a declared PBLang package; temporary shell drivers and --allow-all were removed." }; }
    elif source == "t" { result = map{ ok: true, executed: false, dry_run: true,
            cleanup: "descriptor-scoped", note: "Use the PBLang package test runner; wildcard /tmp cleanup and --allow-all were removed." }; }
    elif source == "refresh-perplexity-context.ps1" { result = map{ ok: true, executed: false,
            dry_run: true, path: Safety.option(args, "path", "PERPLEXITY_CONTEXT.md"),
            note: "Use descriptor-oriented file APIs; clipboard export remains explicit and opt-in." }; }
    else { result = map{ ok: false, error: "migration dispatch is incomplete", source: source }; }
    result.migration = metadata;
    return result;
}

fn status() {
    return map{ format: "pblang.linux-script-ports.v1", source_count: len(catalog()),
        implementation_language: "pblang", original_scripts_executed: false,
        safety: Safety.status() };
}

export catalog, find, run, status;
