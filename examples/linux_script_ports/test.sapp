let Ports = import("examples/linux_script_ports/runtime.sapp");
let Safety = import("examples/linux_script_ports/safety.sapp");
let AIPY = import("../aipy/app.sapp");

fn require(value, message) { if not value { throw "linux_script_ports test failed: " + message; } }

let items = Ports.catalog();
require(len(items) == 35, "all 35 source files must be represented");
let sources = map{}; let destinations = map{}; let aipy_sources = 0;
for item in items {
    require(len(item.sha256) == 64, "every source must have a SHA-256");
    require(not map_has(sources, item.source), "source entries must be unique");
    sources[item.source] = true;
    if str_starts_with(item.source, "fedora/aipy/") {
        require(item.destination == "linux_fedora_aipy", "AIPY sources must share one example project");
        aipy_sources = aipy_sources + 1;
    } else {
        require(not map_has(destinations, item.destination), "non-AIPY folders must be unique");
        destinations[item.destination] = true;
    }
}
require(aipy_sources == 10, "all ten AIPY sources must map to one project");

require(Safety.safe_relative_path("project/file.sapp"), "safe relative path rejected");
require(not Safety.safe_relative_path("../secret"), "traversal accepted");
require(not Safety.safe_relative_path("/etc/passwd"), "absolute path accepted");
require(Safety.safe_pid("1234") and not Safety.safe_pid("1") and not Safety.safe_pid("12x"), "PID validation failed");
require(Safety.safe_port("8080") and not Safety.safe_port("80") and not Safety.safe_port("99999"), "port validation failed");
require(Safety.safe_device("/dev/sdb1") and not Safety.safe_device("/dev/disk/by-id/x") and not Safety.safe_device("/etc/passwd"), "device validation failed");

let permission = Ports.run("chperm.sh", ["--path=workspace", "--mode=755"]);
require(permission.ok and permission.dry_run and not permission.executed, "permissions must default to dry-run");
let blocked = Ports.run("chperm.sh", ["--path=workspace", "--mode=755", "--apply", "--confirm=wrong"]);
require(not blocked.ok and blocked.blocked, "wrong confirmation must fail closed");
require(not Ports.run("chperm.sh", ["--path=../escape", "--mode=777"]).ok, "unsafe chmod accepted");
require(not Ports.run("ntfsf.sh", []).ok, "implicit disk target accepted");
require(not Ports.run("taskmanager.sh", ["--pid=1"]).ok, "PID 1 accepted");
require(Ports.run("linuxscript.sh", ["--name=Ada"]).greeting == "Hello Ada", "tutorial translation failed");
require(Ports.run("test/test.txt", []).value == "test", "fixture translation failed");

let first = AIPY.sample(42, 8); let second = AIPY.sample(42, 8);
require(first == second and len(first) == 8, "AIPY generation must be bounded and deterministic");
let demo = AIPY.demo(42);
require(demo.ok and demo.stored == 8 and demo.parameterized_sql, "AIPY database/web demo failed");
let web = AIPY.create_app(42);
let response = web.handle(map{ method: "GET", path: "/", headers: map{ "user-agent": "Mozilla/5.0" }, body: "" });
require(response.status == 200 and str_contains(response.body, "AIPY data dashboard"), "AIPY route failed");
require(map_has(response.headers, "Content-Security-Policy"), "security headers missing");
web.conn.close();

print "linux_script_ports_pass";
