let Ports = import("examples/linux_script_ports/runtime.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "linux_script_ports security test failed: " + message; }
}

let files = [
"examples/linux_script_ports/safety.sapp",
"../aipy/app.sapp",
"../aipy/main.sapp",
"../aipy/test.sapp",
"examples/linux_script_ports/runtime.sapp",
"examples/linux_script_ports/test.sapp"
];
let included = map{};
for path in files { included[path] = true; }
for item in Ports.catalog() {
    let path = "examples/" + item.destination + "/main.sapp";
    if not map_has(included, path) { push(files, path); included[path] = true; }
}

let findings = 0;
for path in files {
    let source = fs_read(path);
    require(not str_contains(source, strfromcharcode(47) + "home" + strfromcharcode(47)),
        "personal home path leaked by " + path);
    require(not str_contains(source, strfromcharcode(47) + "media" + strfromcharcode(47)),
        "personal media path leaked by " + path);
    let report = Security.analyze(source, path, map{
        minimum_blocking_severity: "high",
        max_findings: 256
    });
    if not report.ok or not report.passed { print map{ path: path, report: report }; }
    require(report.ok and report.passed, "high-severity analysis failed for " + path);
    require(not report.truncated, "analysis truncated for " + path);
    findings = findings + len(report.findings);
}

print map{ ok: true, analyzed_files: len(files), findings_for_review: findings,
    critical_blockers: 0 };
