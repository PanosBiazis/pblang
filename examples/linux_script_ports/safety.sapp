// Shared safety policy for the Linux-script migration examples.
//
// All host commands are shell-free, descriptor-opened from fixed absolute
// candidates, bounded, and dry-run unless the caller supplies both --apply and
// the action-specific confirmation token published by preview().

let Process = import("stdlib:linux_process.sapp");

let FORMAT = "pblang.linux-script-safety.v1";

fn _is_text(value, maximum) {
    return type(value) == "string" and len(value) > 0 and len(value) <= maximum
    and not str_contains(value, strfromcharcode(0))
    and not str_contains(value, "\n") and not str_contains(value, "\r");
}

fn has_arg(args, expected) {
    for item in args { if str(item) == expected { return true; } }
    return false;
}

fn option(args, name, fallback = nil) {
    let prefix = "--" + name + "=";
    for item in args {
        let text = str(item);
        if str_starts_with(text, prefix) { return str_slice(text, len(prefix), len(text)); }
    }
    return fallback;
}

fn safe_relative_path(value) {
    if not _is_text(value, 1024) or str_starts_with(value, "/")
    or str_starts_with(value, "\\") { return false; }
    if len(value) >= 2 and str_slice(value, 1, 2) == ":" { return false; }
    let normalized = str_replace_all(value, "\\", "/");
    for segment in str_split(normalized, "/") {
        if segment == ".." or segment == "" { return false; }
    }
    return true;
}

fn safe_pid(value) {
    if not _is_text(value, 10) { return false; }
    for i len(value) {
        let code = strcharcodeat(value, i);
        if code < 48 or code > 57 { return false; }
    }
    let pid = try parse_number(value) catch 0;
    return pid == num_floor(pid) and pid > 1 and pid <= 4194304;
}

fn safe_port(value) {
    if not _is_text(value, 5) { return false; }
    for i len(value) {
        let code = strcharcodeat(value, i);
        if code < 48 or code > 57 { return false; }
    }
    let port = try parse_number(value) catch 0;
    return port == num_floor(port) and port >= 1024 and port <= 65535;
}

fn _device_character(code) {
    return (code >= 48 and code <= 57) or (code >= 65 and code <= 90)
    or (code >= 97 and code <= 122) or code == 45 or code == 46 or code == 95;
}

fn safe_device(value) {
    if not _is_text(value, 128) or not str_starts_with(value, "/dev/") { return false; }
    let tail = str_slice(value, 5, len(value));
    if tail == "" or str_contains(tail, "/") or str_contains(tail, "..") { return false; }
    let index = 0;
    while index < len(tail) {
        if not _device_character(strcharcodeat(tail, index)) { return false; }
        index = index + 1;
    }
    return true;
}

fn confirmation(action, subject) {
    return "APPLY-" + str_upper(action) + "-" + str_slice(sha256(action + "\n" + subject), 0, 12);
}

fn preview(action, risk, subject, candidates, argv, notes = nil) {
    if notes == nil { notes = []; }
    let token = confirmation(action, subject);
    return map{
        ok: true,
        format: FORMAT,
        executed: false,
        dry_run: true,
        action: action,
        risk: risk,
        subject: subject,
        candidates: candidates,
        argv: argv,
        shell_used: false,
        sudo_requested: false,
        bounded: true,
        confirmation: token,
        apply: "--apply --confirm=" + token,
        notes: notes
    };
}

fn run_plan(plan, args, options = nil) {
    if options == nil { options = map{}; }
    if not has_arg(args, "--apply") {
        plan.reason = "dry-run is the default";
        return plan;
    }
    let supplied = option(args, "confirm", "");
    if supplied != plan.confirmation {
        return map{ ok: false, executed: false, blocked: true,
            error: "exact action-specific confirmation is required",
            expected_confirmation: plan.confirmation, action: plan.action };
    }
    let limits = map{
        timeout_secs: try options.timeout_secs catch 30,
        max_output_bytes: try options.max_output_bytes catch 262144,
        max_file_bytes: try options.max_file_bytes catch 1048576,
        inherit_environment: try options.inherit_environment catch false,
        environment: try options.environment catch map{}
    };
    if map_has(options, "max_memory_bytes") { limits.max_memory_bytes = options.max_memory_bytes; }
    if map_has(options, "stdin_bytes") { limits.stdin_bytes = options.stdin_bytes; }
    let result = Process.run_fixed(plan.candidates, plan.argv, limits);
    result.action = plan.action;
    result.dry_run = false;
    result.executed = result.ok;
    return result;
}

fn fixed_action(action, risk, subject, candidates, argv, args, options = nil, notes = nil) {
    if notes == nil { notes = []; }
    return run_plan(preview(action, risk, subject, candidates, argv, notes), args, options);
}

fn status() {
    return map{ format: FORMAT, dry_run_default: true, shell_free: true,
        fixed_executable_candidates: true, descriptor_opened_executable: true,
        exact_confirmation: true, bounded_output: true, bounded_time: true,
        path_validation: true, process: Process.status() };
}

export has_arg, option, safe_relative_path, safe_pid, safe_port, safe_device,
confirmation, preview, run_plan, fixed_action, status;
