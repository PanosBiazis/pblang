let R=import("stdlib:recipe_manifest.sapp");let F=import("stdlib:template_fields.sapp");
let manifest=map{format:R.FORMAT,recipes:[
 map{id:"greeting",platforms:["linux","web"],requires:["literal_fields"],inputs:map{name:"Learner"},expected:map{text:"Hello Learner"}},
 map{id:"device",platforms:["android"],requires:["physical_sensor"],inputs:map{},expected:map{value:1}},
 map{id:"literal_id",platforms:["linux"],requires:[],inputs:map{id:"007"},expected:map{id:"007"}},
 map{id:"waiting",platforms:["linux"],requires:[],inputs:map{},expected:map{done:true}}
]};
let restored=json_parse(json_stringify(manifest));assert(R.validate(restored),"portable trusted JSON roundtrip");
let plan=R.plan(restored,"linux",["literal_fields"]);
// Actual local execution of the existing template library; manifest never evaluates code.
let actual=F.render("Hello {{name}}",plan.recipes[0].inputs);
let report=R.assess(restored,"linux",["literal_fields"],[map{id:"greeting",actual:map{text:actual}},map{id:"literal_id",actual:map{id:7}}]);
assert(report.recipes[0].status=="matched","local result matches expected text");
assert(report.recipes[1].status=="unsupported","absent device is not silently passed");
assert(report.recipes[2].status=="mismatch","numeric conversion loses literal identifier");
assert(report.recipes[3].status=="not_run","no observation is not success");
print json_stringify(report);
