let F=import("stdlib:compiler/selfhost_frontend.sapp");
let sources=["let a=1;", "let b:number=nil-1;", "print 42;"];
// Default: at most eight workers. Use one for direct sequential debugging.
let results=F.frontend_compile_many(sources,1);
assert(results[0].ok and not results[1].ok and results[2].ok,"ordered diagnostics");
print "Compiled three sources; the second was rejected as expected.";
// Large batches reuse each worker for a contiguous group of inputs.
let many = [];
for i 17 { array_push(many, "let value=" + str(i) + ";"); }
let grouped = F.frontend_compile_many(many, 4);
assert(len(grouped) == 17, "all groups returned");
for result in grouped { assert(result.ok, "grouped compilation"); }
print "Compiled 17 sources with at most four workers in total.";
