let AI=import("stdlib/pbai.sapp");let R=import("stdlib:resource_scope.sapp");
// Capture the bundled closer immediately, before export or use can fail.
fn close_owned(closer){return fn(){return map{ok:true,value:closer()};};}
fn use_owned(scope){
let teacher=AI.neural_specialist_train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let student=AI.neural_specialist_distill(teacher.artifact,[[0],[1,0]],[map{x:[7,0],y:4}]);
scope.defer(close_owned(student.close));
let checkpoint=student.checkpoint();let encoded=AI.neural_specialist_student_encode(checkpoint);
assert(student.close(),"exported checkpoint has independent lifetime");
let loaded=AI.neural_specialist_student_load(AI.neural_specialist_student_decode(encoded));
scope.defer(close_owned(loaded.close));
print json_stringify(loaded.evaluate([map{x:[6,0],y:4}]));
// To persist explicitly, provide a new filename below an existing private directory:
// AI.neural_specialist_student_save_new(path,checkpoint);
// File-loaded handles also need a captured closer registered with this scope.
return map{ok:true,value:nil};
}
let result=R.with_scope(use_owned);
assert(result.ok and result.cleanup_ok,"student workflow and explicit cleanup complete");
