// Bounded JSONL event consumer. A trusted device adapter may write frames here.
// Input format: {"events":[...]} per line. EOF stops. No background process.
// The host allocates read_line before the16KiB check: use OS resource limits
// for hostile streams. This is responsive processing, not hard real-time.
let INPUT=import("stdlib:input_surface.sapp");
let events=[];
for frame_index 32 {
    let line=read_line();if line==nil{break;}
    if len(line)>16384 {throw "input stream frame too large";}
    let frame=try json_parse(line) catch nil;
    if type(frame)!="map" or len(map_keys(frame))!=1 or not map_has(frame,"events") {
        throw "invalid input stream frame";
    }
    let rows=frame.events;
    if type(rows)!="array" or len(rows)>32 or len(events)+len(rows)>256 {throw "input stream event limit";}
    for row in rows {events[len(events)]=row;}
    let summary=try INPUT.analyze(events) catch nil;
    if summary==nil {throw "invalid input event sequence";}
    print json_stringify(map{frame:frame_index+1,summary:summary,hardware_source_verified:false});
}
