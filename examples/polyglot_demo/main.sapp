// Polyglot Multi-Language Demo
// Demonstrates @python, @js, @bash blocks in the same .sapp file.
// Run with: pblang run examples/polyglot_demo/main.sapp

print "=== pblang Polyglot Demo ===";
print "";

fn fibonacci(n) {
    if n <= 1 { return n; }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

print "pblang: fibonacci(10) = " + str(fibonacci(10));

// Use the polyglot bridge
let poly = import("stdlib:polyglot.sapp");

print "";
print "--- Python ---";
let py_result = poly.run_block("python3", "print('Hello from Python!')");
print "Python ok: " + str(py_result.ok);

print "";
print "--- Node.js ---";
let js_result = poly.run_block("node", "console.log('Hello from Node.js!');");
print "Node ok: " + str(js_result.ok);

print "";
print "--- Bash ---";
let sh_result = poly.run_block("bash", "echo 'Hello from Bash!'");
print "Bash ok: " + str(sh_result.ok);

// String and platform info
print "";
print "--- System Info ---";
print "Platform: " + platform();
print "String join: " + str_join(["a", "b", "c"], ", ");

print "";
print "=== Demo Complete ===";
