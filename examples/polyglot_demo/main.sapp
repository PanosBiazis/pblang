// Polyglot Multi-Language Demo
// Demonstrates @python, @js, @bash blocks in the same .sapp file.
// Current Linux bootstrap: pblang run examples/polyglot_demo/main.sapp --allow-exec --allow-ffi

print "=== pblang Polyglot Demo ===";
print "";

fn fibonacci(n) {
    if n <= 1 { return n; }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

print "pblang: fibonacci(10) = " + str(fibonacci(10));

// Use the polyglot bridge
let poly = import("stdlib:polyglot.sapp");
fn unsafe_polyglot(code) {
    return map{ trusted_source: true, timeout_secs: 5, unsafe_polyglot: true,
        unsafe_polyglot_sha256: sha256(code) };
}

print "";
print "--- Python ---";
let py_code = "print('Hello from Python!')";
let py_result = poly.run_block("python3", py_code, unsafe_polyglot(py_code));
print "Python ok: " + str(py_result.ok);
if not py_result.ok { print "Python status: " + py_result.error; }

print "";
print "--- Node.js ---";
let js_code = "console.log('Hello from Node.js!');";
let js_result = poly.run_block("node", js_code, unsafe_polyglot(js_code));
print "Node ok: " + str(js_result.ok);
if not js_result.ok { print "Node status: " + js_result.error; }

print "";
print "--- Bash ---";
let sh_code = "echo 'Hello from Bash!'";
let sh_result = poly.run_block("bash", sh_code, unsafe_polyglot(sh_code));
print "Bash ok: " + str(sh_result.ok);
if not sh_result.ok { print "Bash status: " + sh_result.error; }

// String and platform info
print "";
print "--- System Info ---";
print "Platform: " + platform();
print "String join: " + str_join(["a", "b", "c"], ", ");

print "";
print "=== Demo Complete ===";
