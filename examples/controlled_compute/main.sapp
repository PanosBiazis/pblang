let compute = import("stdlib:compute.sapp");

let items = [1, 2, 3, 4, 5, 6];
let result = compute.run_controlled(items, fn(x) { return x * x; }, map{
    preferred_device: "auto",
    workload: "generic",
    max_workers: 2,
    min_parallel_items: 4,
    fallback_to_cpu: true,
});

if not result.ok { throw "controlled compute failed: " + result.route.reason; }
print "route=" + result.route.device + "/" + result.route.mode
    + " workers=" + str(result.route.workers);
print result.results;
