// pblang:target=kernel
// pblang:extern heap_init gc_new gc_set_auto gc_alloc gc_add_root gc_remove_root gc_set_child gc_live gc_collections kernel_gc_collect
// Kernel-only failure injection. Control-field writes below are test operations,
// never an application API. Prepend kernel/heap.sapp + kernel/gc.sapp.
fn verify(ok) { if not ok { outb(244, 1); while 1 > 0 { hlt(); } } }
fn kmain() {
    let h=kmalloc(8);let region=kmalloc(32768);heap_init(h,region,32768);
    let g=gc_new(h);verify(g!=0);gc_set_auto(g,0);
    let a=gc_alloc(g,1);let b=gc_alloc(g,1);let child=gc_alloc(g,1);verify(a!=0 and b!=0 and child!=0);
    gc_set_child(a,0,child);gc_set_child(child,0,a);gc_set_child(b,0,a);gc_add_root(g,a);gc_add_root(g,b);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==3);
    let before=gc_collections(g);let epoch=peek32(g+44);
    // Simulate a work-table admission failure after marking the first root.
    // Restore the test's damaged count before any subsequent valid operation.
    poke32(g+16,1);verify(kernel_gc_collect(g)==0-1);poke32(g+16,3);
    verify(gc_collections(g)==before and peek32(g+44)==epoch+1);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==3);
    verify(peek32(a)==peek32(g+44) and peek32(b)==peek32(g+44) and peek32(child)==peek32(g+44));
    // Count corruption discovered inside the single-edge fast path must fail
    // without sweeping, even when the work queue itself has not filled up.
    verify(gc_remove_root(g,b)==1);poke32(g+16,1);
    before=gc_collections(g);verify(kernel_gc_collect(g)==0-1);
    poke32(g+16,3);verify(gc_collections(g)==before);
    verify(gc_add_root(g,b)==1 and kernel_gc_collect(g)==0 and gc_live(g)==3);
    // Reused generation must not retain garbage with a stale matching mark.
    let garbage=gc_alloc(g,0);verify(garbage!=0);poke32(garbage,1);
    poke32(g+44,2147483647);verify(kernel_gc_collect(g)==0);
    verify(peek32(g+44)==1 and gc_live(g)==3);
    let newer=gc_alloc(g,0);verify(newer!=0 and peek32(newer)==0);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==3);
    let i=0;while i<100 {verify(kernel_gc_collect(g)==0 and gc_live(g)==3);i=i+1;}
    verify(gc_remove_root(g,a)==1 and gc_remove_root(g,b)==1);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==0);
    poke32(g+44,2147483647);verify(kernel_gc_collect(g)==0 and gc_live(g)==0);
    outb(244,42);while 1>0 {hlt();}
}
