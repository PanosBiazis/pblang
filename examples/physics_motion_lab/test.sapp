let Physics = import("examples/physics_motion_lab/physics.sapp");
let App = import("examples/physics_motion_lab/app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "physics_motion_lab test failed: " + message; }
}

fn rejected(callable) { return (try { callable(); false } catch true); }

fn close(left, right, tolerance = 0.000001) {
    return num_abs(left - right) <= tolerance;
}

fn record(bundle, name) {
    for item in bundle.records { if item.name == name { return item; } }
    return nil;
}

let projectile = Physics.projectile(20, 45, 9.8, 101);
require(projectile.sample_count == 101 and projectile.points[0].x == 0
and projectile.points[0].y == 0 and projectile.points[100].y == 0,
"projectile starts and lands at ground level");
require(close(projectile.bounds.max_x, 40.8163265306, 0.00001)
and close(projectile.bounds.max_y, 10.2040816327, 0.00001),
"projectile range and peak height must match the ideal model");
require(rejected(fn() { Physics.projectile(20, 0, 9.8, 101); }),
"zero launch angle must fail the flight model");
require(rejected(fn() { Physics.projectile(20, 45, 0, 101); }),
"zero gravity must fail explicitly");

let harmonic = Physics.harmonic(1, 2 * 3.141592653589793, 1, 5);
require(close(harmonic.points[0].y, 0) and close(harmonic.points[1].y, 1)
and close(harmonic.points[3].y, -1),
"harmonic quarter-cycle samples must be exact within tolerance");

let pendulum = Physics.pendulum(2, 30, 9.8, 2, 11);
require(pendulum.meta.approximation and pendulum.meta.model == "small-angle-ideal-pendulum",
"pendulum approximation must be explicit");
require(close(pendulum.points[0].x, 1) and pendulum.points[0].y < 0,
"pendulum initial geometry must match length and angle");
require(rejected(fn() { Physics.pendulum(2, 31, 9.8, 2, 11); }),
"angles outside the declared approximation must fail");

let circular = Physics.circular(1, 2 * 3.141592653589793, 1, 5);
require(close(circular.points[0].x, 1) and close(circular.points[0].y, 0)
and close(circular.points[1].x, 0) and close(circular.points[1].y, 1),
"uniform circular quarter-turn samples must be correct");

let wave = Physics.wave(1, 10, 1, 0, 5);
require(close(wave.points[0].y, 0) and close(wave.points[1].y, 1)
and close(wave.points[3].y, -1),
"wave quarter-wavelength samples must be correct");

require(rejected(fn() { Physics.wave(1, 10, 1, 0, 1); }),
"sample count below two must fail");
require(rejected(fn() { Physics.wave(1, 10, 1, 0, 513); }),
"sample count above the work budget must fail");

let suite = Physics.default_suite(33);
require(len(suite) == 5, "all five source simulations must be retained");
for report in suite {
    require(report.bounded and report.sample_count == 33,
    "every simulation must honor the shared sample budget");
    let scene = App.visual_scene(report, 320, 480);
    let plan = Visual.compile(scene);
    require(len(plan.draw) == 3 and len(plan.timeline) == 33,
    "each simulation must produce chart, cursor and bounded animation keys");
}

let view = App.view();
require(UI.validate(view).ok, "shared UI tree must validate");
let phone = UI.compile(view, map{ target: "web", width: 320, height: 640 });
let desktop = UI.compile(view, map{ target: "native", width: 1440, height: 900 });
let android = UI.compile(view, map{ target: "android", width: 360, height: 720 });
for bundle in [phone, desktop, android] {
    require(record(bundle, "brand") != nil, "brand must render on every target");
    require(record(bundle, "select_projectile") != nil, "projectile selector must render");
    require(record(bundle, "select_wave") != nil, "wave selector must render");
    require(record(bundle, "simulation_status") != nil, "selection status must render");
}

let preview = UI.preview_web("Physics Motion Lab", view, App.web_options());
require(preview.response.status == 200, "generated Web preview must return HTTP 200");
require(str_contains(preview.generated.html, "viewport-fit=cover"),
"Web preview must support compact viewports");
require(str_contains(preview.generated.css, "@media(max-width:640px)"),
"Web preview must include responsive rules");
require(not str_contains(preview.generated.html, "http://")
and not str_contains(preview.generated.html, "https://"),
"Web preview must have no remote runtime dependency");

require(Physics.source_sha256() ==
"60038a7805e16e5efa97820405918bd7453bc5668f35eca348f6499bc3669988",
"source provenance digest must remain stable");

for source_path in [
    "examples/physics_motion_lab/physics.sapp",
    "examples/physics_motion_lab/app.sapp",
    "examples/physics_motion_lab/main.sapp",
    "examples/physics_motion_lab/test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
    "bounded security analysis must pass for " + source_path);
}

print "physics_motion_lab_pass";
