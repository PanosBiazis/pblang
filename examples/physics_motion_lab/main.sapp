let Physics = import("examples/physics_motion_lab/physics.sapp");
let App = import("examples/physics_motion_lab/app.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn main() {
    let suite = Physics.default_suite(121);
    let summaries = [];
    let visual_nodes = 0;
    let timeline_keys = 0;
    for report in suite {
        array_push(summaries, Physics.summary(report));
        let plan = App.compiled_visual(report);
        visual_nodes = visual_nodes + len(plan.draw);
        timeline_keys = timeline_keys + len(plan.timeline);
    }
    let ui = UI.compile(App.view(), map{ target: "native", width: 1280, height: 800 });
    print json_stringify(map{
        format: "pblang.example.physics-motion-lab.v1",
        simulations: summaries,
        ui_records: len(ui.records),
        visual_nodes: visual_nodes,
        timeline_keys: timeline_keys,
        verified: len(summaries) == 5 and visual_nodes == 15 and timeline_keys == 605
    });
    return len(summaries) == 5;
}

main();
