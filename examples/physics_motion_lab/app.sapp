let Physics = import("examples/physics_motion_lab/physics.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");

fn _select_action(item) {
    return UI.action_sequence([
        UI.action_set_text("active_title", item.title),
        UI.action_set_text("active_detail", item.detail),
        UI.action_set_text("simulation_status", item.title + " selected")
    ]);
}

fn view() {
    let controls = [];
    let cards = [];
    for item in Physics.catalog() {
        array_push(controls, UI.button(item.title, _select_action(item), map{
            name: "select_" + item.id,
            accessibility_label: "Select " + item.title + " simulation"
        }));
        array_push(cards, UI.card([
            UI.heading(item.title, map{ name: item.id + "_title" }),
            UI.text(item.detail, map{ name: item.id + "_detail" })
        ], map{ name: "simulation_" + item.id }));
    }
    return UI.screen([
        UI.heading("Physics Motion Lab", map{
            name: "brand",
            accessibility_label: "Physics Motion Lab"
        }),
        UI.row(controls, map{ name: "simulation_picker", responsive: true, gap: 8 }),
        UI.heading("Projectile", map{ name: "active_title" }),
        UI.text("Constant gravity", map{ name: "active_detail" }),
        UI.text("Projectile selected", map{
            name: "simulation_status",
            accessibility_label: "Selected simulation"
        }),
        UI.grid(cards, map{ name: "simulation_grid", columns: 3, gap: 12 })
    ], map{ name: "physics_motion_root", gap: 16 });
}

fn visual_scene(report, width = 960, height = 600) {
    let scene = Visual.scene(width, height, map{
        title: report.title,
        backend: "portable"
    });
    let series = [];
    let i = 0;
    while i < len(report.points) {
        array_push(series, [report.points[i][report.x_key], report.points[i][report.y_key]]);
        i = i + 1;
    }
    Visual.add(scene, Visual.text("title", 24, 24, report.title,
        [238, 244, 249, 255], 24));
    Visual.add(scene, Visual.line_chart("motion_chart", series, map{
        title: report.title,
        x_label: report.x_label,
        y_label: report.y_label,
        color: [0, 168, 150, 255]
    }));
    Visual.add(scene, Visual.circle2d("motion_cursor", series[0][0], series[0][1], 5,
        [232, 93, 73, 255], true));
    i = 0;
    while i < len(series) {
        Visual.add_key(scene, "motion_cursor", i, map{ x: series[i][0], y: series[i][1] });
        i = i + 1;
    }
    return scene;
}

fn compiled_visual(report, width = 960, height = 600) {
    return Visual.compile(visual_scene(report, width, height));
}

fn web_options() {
    return map{
        theme: "light",
        lang: "en",
        host: "127.0.0.1",
        port: 8080,
        width: 1180,
        height: 820,
        palette: map{
            accent: [0, 126, 112],
            selected: [0, 105, 92],
            focus: [0, 95, 204]
        },
        source_sha256: Physics.source_sha256()
    };
}

export view, visual_scene, compiled_visual, web_options;
