// Bounded numerical backend for five introductory motion simulations.

let Math = import("stdlib:math.sapp");

let PI = 3.141592653589793;
let MAX_SAMPLES = 512;
let EPSILON = 0.000000001;

fn source_sha256() {
    return "60038a7805e16e5efa97820405918bd7453bc5668f35eca348f6499bc3669988";
}

fn _number(value, minimum, maximum, label) {
    if type(value) != "number" or value < minimum or value > maximum {
        throw label + " must be a bounded number in " + str(minimum) + ".." + str(maximum);
    }
    return value;
}

fn _sample_count(value) {
    if type(value) != "number" or value != num_floor(value)
       or value < 2 or value > MAX_SAMPLES {
        throw "samples must be a whole 2.." + str(MAX_SAMPLES);
    }
    return value;
}

fn _time_grid(duration, samples) {
    let count = _sample_count(samples);
    let span = _number(duration, EPSILON, 10000, "duration");
    let step = span / (count - 1);
    let values = [];
    let i = 0;
    while i < count {
        let value = i * step;
        if i == count - 1 { value = span; }
        array_push(values, value);
        i = i + 1;
    }
    return values;
}

fn _bounds(points, x_key, y_key) {
    if len(points) == 0 { throw "points must not be empty"; }
    let min_x = points[0][x_key];
    let max_x = min_x;
    let min_y = points[0][y_key];
    let max_y = min_y;
    let i = 1;
    while i < len(points) {
        let x = points[i][x_key];
        let y = points[i][y_key];
        if x < min_x { min_x = x; }
        if x > max_x { max_x = x; }
        if y < min_y { min_y = y; }
        if y > max_y { max_y = y; }
        i = i + 1;
    }
    return map{ min_x: min_x, max_x: max_x, min_y: min_y, max_y: max_y };
}

fn _report(kind, title, x_label, y_label, points, x_key, y_key, meta) {
    return map{
        format: "pblang.example.physics-motion.v1",
        kind: kind,
        title: title,
        x_label: x_label,
        y_label: y_label,
        points: points,
        sample_count: len(points),
        bounds: _bounds(points, x_key, y_key),
        x_key: x_key,
        y_key: y_key,
        meta: meta,
        bounded: true
    };
}

fn projectile(speed = 20, angle_degrees = 45, gravity = 9.8, samples = 121) {
    let velocity = _number(speed, EPSILON, 10000, "speed");
    let angle = _number(angle_degrees, 0.1, 89.9, "angle_degrees") * PI / 180;
    let g = _number(gravity, 0.1, 100, "gravity");
    let duration = 2 * velocity * Math.sin(angle) / g;
    let times = _time_grid(duration, samples);
    let points = [];
    let i = 0;
    while i < len(times) {
        let t = times[i];
        let x = velocity * Math.cos(angle) * t;
        let y = velocity * Math.sin(angle) * t - 0.5 * g * t * t;
        if num_abs(y) < EPSILON { y = 0; }
        array_push(points, map{ t: t, x: x, y: y });
        i = i + 1;
    }
    return _report("projectile", "Projectile motion", "Distance (m)", "Height (m)",
        points, "x", "y", map{
            model: "constant-gravity-no-drag",
            speed_m_s: velocity,
            angle_degrees: angle_degrees,
            gravity_m_s2: g,
            duration_s: duration
        });
}

fn harmonic(amplitude = 1, angular_frequency = nil, duration = 10, samples = 121) {
    let a = _number(amplitude, EPSILON, 1000000, "amplitude");
    let omega = angular_frequency;
    if omega == nil { omega = 2 * PI; }
    omega = _number(omega, EPSILON, 1000000, "angular_frequency");
    let times = _time_grid(duration, samples);
    let points = [];
    let i = 0;
    while i < len(times) {
        array_push(points, map{ t: times[i], y: a * Math.sin(omega * times[i]) });
        i = i + 1;
    }
    return _report("harmonic", "Simple harmonic motion", "Time (s)", "Displacement (m)",
        points, "t", "y", map{
            model: "sinusoidal-ideal-oscillator",
            amplitude_m: a,
            angular_frequency_rad_s: omega,
            duration_s: duration
        });
}

fn pendulum(length = 2, angle_degrees = 30, gravity = 9.8,
            duration = 10, samples = 121) {
    let l = _number(length, EPSILON, 10000, "length");
    let degrees = _number(angle_degrees, 0 - 30, 30, "angle_degrees");
    let g = _number(gravity, 0.1, 100, "gravity");
    let theta0 = degrees * PI / 180;
    let omega = num_sqrt(g / l);
    let times = _time_grid(duration, samples);
    let points = [];
    let i = 0;
    while i < len(times) {
        let theta = theta0 * Math.cos(omega * times[i]);
        array_push(points, map{
            t: times[i], theta: theta,
            x: l * Math.sin(theta),
            y: 0 - l * Math.cos(theta)
        });
        i = i + 1;
    }
    return _report("pendulum", "Pendulum motion", "Horizontal position (m)",
        "Vertical position (m)", points, "x", "y", map{
            model: "small-angle-ideal-pendulum",
            approximation: true,
            length_m: l,
            initial_angle_degrees: degrees,
            gravity_m_s2: g,
            duration_s: duration
        });
}

fn circular(radius = 1, angular_velocity = nil, duration = 10, samples = 121) {
    let r = _number(radius, EPSILON, 1000000, "radius");
    let omega = angular_velocity;
    if omega == nil { omega = 2 * PI; }
    omega = _number(omega, EPSILON, 1000000, "angular_velocity");
    let times = _time_grid(duration, samples);
    let points = [];
    let i = 0;
    while i < len(times) {
        array_push(points, map{
            t: times[i],
            x: r * Math.cos(omega * times[i]),
            y: r * Math.sin(omega * times[i])
        });
        i = i + 1;
    }
    return _report("circular", "Circular motion", "X position (m)", "Y position (m)",
        points, "x", "y", map{
            model: "uniform-circular-motion",
            radius_m: r,
            angular_velocity_rad_s: omega,
            duration_s: duration
        });
}

fn wave(amplitude = 1, wavelength = 10, frequency = 1,
        time = 0, spatial_samples = 121) {
    let a = _number(amplitude, EPSILON, 1000000, "amplitude");
    let lambda = _number(wavelength, EPSILON, 1000000, "wavelength");
    let f = _number(frequency, EPSILON, 1000000, "frequency");
    let t = _number(time, 0 - 10000, 10000, "time");
    let count = _sample_count(spatial_samples);
    let points = [];
    let i = 0;
    while i < count {
        let x = if i == count - 1 { lambda } else { lambda * i / (count - 1) };
        let y = a * Math.sin((2 * PI / lambda) * x - (2 * PI * f) * t);
        if num_abs(y) < EPSILON { y = 0; }
        array_push(points, map{ x: x, y: y });
        i = i + 1;
    }
    return _report("wave", "Wave propagation", "Position (m)", "Displacement (m)",
        points, "x", "y", map{
            model: "ideal-travelling-sine-wave",
            amplitude_m: a,
            wavelength_m: lambda,
            frequency_hz: f,
            time_s: t
        });
}

fn catalog() {
    return [
        map{ id: "projectile", title: "Projectile", detail: "Constant gravity" },
        map{ id: "harmonic", title: "Oscillator", detail: "Sinusoidal motion" },
        map{ id: "pendulum", title: "Pendulum", detail: "Small-angle model" },
        map{ id: "circular", title: "Circular", detail: "Uniform rotation" },
        map{ id: "wave", title: "Wave", detail: "Travelling sine profile" }
    ];
}

fn default_suite(samples = 121) {
    return [projectile(20, 45, 9.8, samples), harmonic(1, 2 * PI, 10, samples),
        pendulum(2, 30, 9.8, 10, samples), circular(1, 2 * PI, 10, samples),
        wave(1, 10, 1, 0, samples)];
}

fn summary(report) {
    return map{
        kind: report.kind,
        title: report.title,
        sample_count: report.sample_count,
        bounds: report.bounds,
        model: report.meta.model,
        bounded: report.bounded
    };
}

export source_sha256, projectile, harmonic, pendulum, circular, wave,
       catalog, default_suite, summary;
