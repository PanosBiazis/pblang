// Cache derived local work. This example opts into a two-entry LRU quota.
let C=import("stdlib:cache.sapp");
let memo=C.bounded_policy(0,2,0,"lru");
let evaluations=0;
fn word_count(text) {
 return C.get_or_set(memo,text,fn(){
  evaluations=evaluations+1;
  return len(str_split(text," "));
 });
}
print word_count("local derived work");
print word_count("local derived work");
if evaluations!=1 {throw "memoized work repeated";}
C.clear(memo);
print "cache_memoize_pass";
