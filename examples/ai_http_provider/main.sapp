// examples/ai_http_provider/main.sapp
// OpenAI-style HTTP provider adapter using stdlib http + json.
// API-key auth uses stdlib:http.sapp post_auth, which builds the Bearer header
// on top of the lower-level http_post_auth(url, headers_map, body) builtin.

import "stdlib:http.sapp";
import "stdlib:json.sapp";
import "stdlib:strings.sapp";
// For typed tensor input, use: let t = import("stdlib:tensor.sapp");
// Pass t.to_request_body(tensor) as the "inputs" field in build_request.

fn build_request(model, messages) {
    return json.stringify(map{ model: model, messages: messages });
}

// Single-shot call to any OpenAI-compatible endpoint.
fn call_provider(endpoint, api_key, body) {
    let res = http.post_auth(endpoint, body, api_key);
    return json.parse(res);
}

fn openai_chat(api_key, model, messages) {
    let body = build_request(model, messages);
    return call_provider("https://api.openai.com/v1/chat/completions", api_key, body);
}

// openai_chat_auth(prompt, api_key) — uses post_auth with Bearer token for API-key auth.
fn openai_chat_auth(prompt, api_key) {
    let http = import("stdlib:http.sapp");
    let messages = [map{"role": "user", "content": prompt}];
    let body = build_request("openai", messages);
    return http.post_auth("https://api.openai.com/v1/chat/completions", body, api_key);
}

// openai_chat_stream(prompt, api_key, on_token)
// Streaming chat: calls on_token(token_str) for each SSE data chunk.
// Uses http.post_stream_auth (shim) + parse_sse_line.
fn openai_chat_stream(prompt, api_key, on_token) {
    let http = import("stdlib:http.sapp");
    let messages = [map{ "role": "user", "content": prompt }];
    let body = json.stringify(map{ "model": "gpt-4o", "stream": true, "messages": messages });
    http.post_stream_auth("https://api.openai.com/v1/chat/completions", body, api_key, fn(chunk) {
        let lines = strings.lines(chunk);
        for i len(lines) {
            let parsed = http.parse_sse_line(lines[i]);
            if parsed != nil and parsed.kind == "data" {
                if parsed.value != "[DONE]" {
                    let obj = try json.parse(parsed.value) catch nil;
                    if obj != nil {
                        let delta = try obj.choices[0].delta.content catch nil;
                        if delta != nil { on_token(delta); }
                    }
                }
            }
        }
    });
}

// Streaming stub: wire to chunked HTTP once W3 streaming exists.
fn streaming_chat(api_key, model, messages, on_chunk) {
    let result = openai_chat(api_key, model, messages);
    on_chunk(result);
}

fn provider_info() {
    return map{ name: "openai-compat", version: "1.0", supports_streaming: false, supports_tools: false };
}

export build_request, call_provider, openai_chat, openai_chat_auth, openai_chat_stream, streaming_chat, provider_info;
