let Env = import("stdlib:env.sapp");

let config = Env.virtual(map{ PBREMOTE_MODE: "private" });
Env.virtual_set(config, "ui.scale", "compact");
print map{
    mode: Env.virtual_get(config, "PBREMOTE_MODE"),
    scale: Env.virtual_get(config, "ui.scale"),
    keys: Env.virtual_keys(config), usage: Env.virtual_usage(config),
    host_environment_access: config.host_environment_access
};
