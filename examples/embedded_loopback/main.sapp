let Embedded = import("stdlib:embedded.sapp");

let circuit = Embedded.new_circuit(map{name:"Digital loopback", mode:"emulator"});
if not Embedded.Circuit.add_device(circuit, "target", "arduino-uno").ok {
    throw "could not create emulated embedded target";
}

let session = Embedded.Controller.connect(circuit, "target");
if not session.ok { throw session.error; }
let verified = Embedded.Controller.verify_loopback(session);
let closed = Embedded.Controller.close(session);

assert(verified.ok and verified.result.pass, "LOW and HIGH loopback phases pass");
assert(closed.termios_restored, "controller session closes cleanly");
print json_stringify(verified.result);
