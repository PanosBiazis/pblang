// Portable Android-phone contract with deterministic input and sensor data.
let Device = import("stdlib:device_emulator.sapp");
let Input = import("stdlib:input_events.sapp");

let profile = Device.resolve("smartphone", "android", "34", "arm64");
if not profile.ok { throw profile.error; }

let phone = Device.machine(profile, map{ max_input_events: 32, max_signal_updates: 32 });
Device.input_apply(phone, Input.pointer_event(120, 240).event);
Device.input_apply(phone, Input.pointer_delta_event(10, -20).event);
Device.input_apply(phone, Input.type_event("PBLang").event);
Device.signal_write(phone, "accelerometer-x", 0.25);
Device.tick(phone, 16);
// Invalid duration is caught before either simulated clock changes.
let rejected = try Device.tick(phone, 0.5) catch "rejected";
assert(rejected == "rejected" and phone.clock_ms == 16, "fractional tick rejected");
assert(Device.tick(phone, 4) == 20 and phone.platform.clock_ms == 20,
       "valid integer tick recovers without adding rejected duration");
Device.signal_write(phone, "accelerometer-x", 0.5);
assert(Device.signal_read(phone, "accelerometer-x").updated_ms == 20,
       "signal uses the accepted device time");

print Device.stats(phone);
