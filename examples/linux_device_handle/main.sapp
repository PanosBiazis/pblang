let DEVICE = import("stdlib:linux_device_handle.sapp");

let support = DEVICE.available();
print "backend=" + support.platform + " available=" + str(support.ok);
print "max_io_bytes=" + str(support.max_io_bytes) + " allowlisted_ioctl=" + str(support.ioctl_allowlisted);

// No device is opened unless the operator supplies one explicitly.
let configured_path = try env_get("PB_I2C_DEVICE") catch nil;
let path = if type(configured_path) == "string" { configured_path } else { "" };
if path != "" {
    let handle = DEVICE.open_device(path, "i2c", "read");
    if not handle.ok { throw handle.error; }
    let capabilities = DEVICE.ioctl_u64(handle, "I2C_FUNCS");
    DEVICE.close(handle);
    if not capabilities.ok { throw capabilities.error; }
    print "i2c_functions=" + str(capabilities.value);
} else {
    print "No hardware touched. Set PB_I2C_DEVICE=/dev/i2c-N for a read-only capability query.";
}
