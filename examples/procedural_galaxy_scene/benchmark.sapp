let Galaxy = import("examples/procedural_galaxy_scene/galaxy.sapp");
let App = import("examples/procedural_galaxy_scene/app.sapp");

fn main() {
    let report = Galaxy.generate(4096, 20260821, 8, 100, 10, 8, 3.141592653589793);
    let plan = App.compiled_visual(report, 1920, 1080);
    let grouped = 0;
    for group in report.groups { grouped = grouped + group.count; }
    let result = map{
        format: "pblang.example.procedural-galaxy-benchmark.v1",
        stars: report.star_count,
        grouped_points: grouped,
        visual_nodes: len(plan.draw),
        viewport: plan.viewport,
        verified: grouped == 4096 and report.star_count == 4096
    };
    print json_stringify(result);
    return result.verified;
}

main();
