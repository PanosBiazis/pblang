// Deterministic, bounded procedural spiral-galaxy model.

let Math = import("stdlib:math.sapp");

let PI = 3.141592653589793;
let TAU = 6.283185307179586;
let RNG_MODULUS = 2147483647;
let MIN_STARS = 16;
let MAX_STARS = 4096;

fn source_sha256() {
    return "8f84c056721db4bce12b2b856c0aca201bc2f96af9c779430971680537b15b28";
}

fn _number(value, minimum, maximum, label) {
    if type(value) != "number" or value < minimum or value > maximum {
        throw label + " must be a bounded number in " + str(minimum) + ".." + str(maximum);
    }
    return value;
}

fn _integer(value, minimum, maximum, label) {
    let number = _number(value, minimum, maximum, label);
    if number != num_floor(number) { throw label + " must be a whole number"; }
    return number;
}

fn _rng(seed) {
    return map{ state: _integer(seed, 1, RNG_MODULUS - 1, "seed") };
}

fn _uniform(rng) {
    rng.state = (rng.state * 16807) % RNG_MODULUS;
    return rng.state / RNG_MODULUS;
}

fn _bell(rng) {
    let sum = 0;
    let i = 0;
    while i < 6 {
        sum = sum + _uniform(rng);
        i = i + 1;
    }
    return sum - 3;
}

fn _groups() {
    return [
        map{ id: "core", title: "Core white", color: [255, 248, 224, 255], points: [], count: 0 },
        map{ id: "blue", title: "Blue", color: [112, 181, 255, 255], points: [], count: 0 },
        map{ id: "white", title: "White", color: [230, 239, 255, 255], points: [], count: 0 },
        map{ id: "gold", title: "Gold", color: [255, 205, 102, 255], points: [], count: 0 },
        map{ id: "red", title: "Red", color: [255, 125, 112, 255], points: [], count: 0 }
    ];
}

fn _palette_index(radial_ratio, temperature) {
    if radial_ratio < 0.14 { return 0; }
    if temperature < 0.24 { return 4; }
    if temperature < 0.48 { return 3; }
    if temperature < 0.76 { return 2; }
    return 1;
}

fn generate(star_count = 512, seed = 20260821, arms = 4,
            max_radius = 12, thickness = 0.35, turns = 2.5,
            arm_spread = 0.45) {
    let count = _integer(star_count, MIN_STARS, MAX_STARS, "star_count");
    let arm_count = _integer(arms, 2, 8, "arms");
    let radius_limit = _number(max_radius, 0.1, 100, "max_radius");
    let z_scale = _number(thickness, 0, 10, "thickness");
    let turn_count = _number(turns, 0.25, 8, "turns");
    let spread = _number(arm_spread, 0, PI, "arm_spread");
    let rng = _rng(seed);
    let groups = _groups();
    let arm_totals = [];
    let arm = 0;
    while arm < arm_count {
        array_push(arm_totals, 0);
        arm = arm + 1;
    }

    let min_x = 0;
    let max_x = 0;
    let min_y = 0;
    let max_y = 0;
    let min_z = 0;
    let max_z = 0;
    let sum_x = 0;
    let sum_y = 0;
    let sum_z = 0;
    let first_star = map{ point: [0, 0, 0], arm: 0, palette: "" };
    let last_star = map{ point: [0, 0, 0], arm: 0, palette: "" };
    let i = 0;
    while i < count {
        let arm_index = i % arm_count;
        let radial_ratio = num_sqrt(_uniform(rng));
        let radius = radial_ratio * radius_limit;
        let base_angle = arm_index * TAU / arm_count;
        let angle = base_angle + turn_count * TAU * radial_ratio
            + (_uniform(rng) - 0.5) * spread;
        let x = radius * Math.cos(angle);
        let y = radius * Math.sin(angle);
        let z = _bell(rng) * z_scale * (0.35 + 0.65 * radial_ratio);
        let palette_index = _palette_index(radial_ratio, _uniform(rng));
        let point = [x, y, z];
        array_push(groups[palette_index].points, point);
        groups[palette_index].count = groups[palette_index].count + 1;
        arm_totals[arm_index] = arm_totals[arm_index] + 1;

        let star = map{ point: point, arm: arm_index, palette: groups[palette_index].id };
        if i == 0 {
            first_star = star;
            min_x = x; max_x = x;
            min_y = y; max_y = y;
            min_z = z; max_z = z;
        } else {
            if x < min_x { min_x = x; }
            if x > max_x { max_x = x; }
            if y < min_y { min_y = y; }
            if y > max_y { max_y = y; }
            if z < min_z { min_z = z; }
            if z > max_z { max_z = z; }
        }
        last_star = star;
        sum_x = sum_x + x;
        sum_y = sum_y + y;
        sum_z = sum_z + z;
        i = i + 1;
    }

    return map{
        format: "pblang.example.procedural-galaxy.v1",
        seed: seed,
        deterministic: true,
        cryptographic_randomness: false,
        bounded: true,
        star_count: count,
        arms: arm_count,
        arm_totals: arm_totals,
        groups: groups,
        first_star: first_star,
        last_star: last_star,
        bounds: map{
            min_x: min_x, max_x: max_x,
            min_y: min_y, max_y: max_y,
            min_z: min_z, max_z: max_z
        },
        centroid: [sum_x / count, sum_y / count, sum_z / count],
        parameters: map{
            max_radius: radius_limit,
            thickness: z_scale,
            turns: turn_count,
            arm_spread: spread
        },
        model: "bounded-logical-spiral-point-cloud"
    };
}

fn presets() {
    return [
        map{ id: "compact", title: "Compact", stars: 128, detail: "Fast preview" },
        map{ id: "balanced", title: "Balanced", stars: 512, detail: "Default scene" },
        map{ id: "dense", title: "Dense", stars: 2048, detail: "Higher detail" }
    ];
}

fn summary(report) {
    let palette_counts = [];
    for group in report.groups {
        array_push(palette_counts, map{ id: group.id, count: group.count });
    }
    return map{
        format: report.format,
        star_count: report.star_count,
        arms: report.arms,
        seed: report.seed,
        palette_counts: palette_counts,
        bounds: report.bounds,
        deterministic: report.deterministic,
        bounded: report.bounded
    };
}

export source_sha256, generate, presets, summary;
