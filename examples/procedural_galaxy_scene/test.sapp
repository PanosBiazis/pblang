let Galaxy = import("examples/procedural_galaxy_scene/galaxy.sapp");
let App = import("examples/procedural_galaxy_scene/app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "procedural_galaxy_scene test failed: " + message; }
}

fn rejected(callable) { return (try { callable(); false } catch true); }

fn record(bundle, name) {
    for item in bundle.records { if item.name == name { return item; } }
    return nil;
}

fn point_count(report) {
    let total = 0;
    for group in report.groups { total = total + group.count; }
    return total;
}

let first = Galaxy.generate(512, 77, 4, 12, 0.35, 2.5, 0.45);
let replay = Galaxy.generate(512, 77, 4, 12, 0.35, 2.5, 0.45);
let changed = Galaxy.generate(512, 78, 4, 12, 0.35, 2.5, 0.45);
require(sha256(json_stringify(first.groups)) == sha256(json_stringify(replay.groups)),
"the same seed must recreate the exact point cloud");
require(sha256(json_stringify(first.groups)) != sha256(json_stringify(changed.groups)),
"a different seed must change the point cloud");
require(first.star_count == 512 and point_count(first) == 512,
"every generated star must appear exactly once");
require(first.deterministic and first.bounded and not first.cryptographic_randomness,
"the randomness and work contracts must be explicit");
require(first.bounds.min_x >= -12 and first.bounds.max_x <= 12
and first.bounds.min_y >= -12 and first.bounds.max_y <= 12,
"planar points must remain inside the configured radius");
require(first.bounds.min_z >= -1.05 and first.bounds.max_z <= 1.05,
"vertical points must remain inside the bounded bell approximation");
for total in first.arm_totals {
    require(total == 128, "round-robin arms must receive equal stars");
}

require(rejected(fn() { Galaxy.generate(15); }), "too few stars must fail");
require(rejected(fn() { Galaxy.generate(4097); }), "too many stars must fail");
require(rejected(fn() { Galaxy.generate(16, 0); }), "zero seed must fail");
require(rejected(fn() { Galaxy.generate(16, 1, 1); }), "one arm must fail");
require(rejected(fn() { Galaxy.generate(16, 1, 4, 0); }), "zero radius must fail");
require(rejected(fn() { Galaxy.generate(16, 1, 4, 12, -1); }),
"negative thickness must fail");

let scene = App.visual_scene(first, 320, 480);
let plan = Visual.compile(scene);
require(len(plan.draw) >= 7 and plan.viewport.w == 320 and plan.viewport.h == 480,
"the portable scene must contain the sky, star clouds, camera and title");

let view = App.view();
require(UI.validate(view).ok, "shared UI tree must validate");
let phone = UI.compile(view, map{ target: "web", width: 320, height: 640 });
let desktop = UI.compile(view, map{ target: "native", width: 1440, height: 900 });
let android = UI.compile(view, map{ target: "android", width: 360, height: 720 });
for bundle in [phone, desktop, android] {
    require(record(bundle, "brand") != nil, "brand must render on every target");
    require(record(bundle, "preset_compact") != nil, "compact preset must render");
    require(record(bundle, "preset_dense") != nil, "dense preset must render");
    require(record(bundle, "scene_status") != nil, "accessible status must render");
}

let preview = UI.preview_web("Procedural Galaxy", view, App.web_options());
require(preview.response.status == 200, "generated Web preview must return HTTP 200");
require(str_contains(preview.generated.html, "viewport-fit=cover"),
"Web preview must support compact viewports");
require(str_contains(preview.generated.css, "@media(max-width:640px)"),
"Web preview must include responsive rules");
require(not str_contains(preview.generated.html, "http://")
and not str_contains(preview.generated.html, "https://"),
"Web preview must have no remote runtime dependency");

require(Galaxy.source_sha256() ==
"8f84c056721db4bce12b2b856c0aca201bc2f96af9c779430971680537b15b28",
"source provenance digest must remain stable");

for source_path in [
    "examples/procedural_galaxy_scene/galaxy.sapp",
    "examples/procedural_galaxy_scene/app.sapp",
    "examples/procedural_galaxy_scene/benchmark.sapp",
    "examples/procedural_galaxy_scene/main.sapp",
    "examples/procedural_galaxy_scene/test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
    "bounded security analysis must pass for " + source_path);
}

print "procedural_galaxy_scene_pass";
