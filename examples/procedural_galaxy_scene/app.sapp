let Galaxy = import("examples/procedural_galaxy_scene/galaxy.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");

fn _preset_action(preset) {
    return UI.action_sequence([
        UI.action_set_text("active_preset", preset.title),
        UI.action_set_text("active_detail", preset.detail),
        UI.action_set_text("scene_status", str(preset.stars) + " stars selected")
    ]);
}

fn view() {
    let controls = [];
    for preset in Galaxy.presets() {
        array_push(controls, UI.button(preset.title, _preset_action(preset), map{
            name: "preset_" + preset.id,
            accessibility_label: "Select " + preset.title + " galaxy density"
        }));
    }
    return UI.screen([
        UI.heading("Procedural Galaxy", map{
            name: "brand",
            accessibility_label: "Procedural Galaxy"
        }),
        UI.text("Deterministic spiral point cloud", map{ name: "subtitle" }),
        UI.row(controls, map{ name: "density_picker", responsive: true, gap: 8 }),
        UI.heading("Balanced", map{ name: "active_preset" }),
        UI.text("Default scene", map{ name: "active_detail" }),
        UI.text("512 stars selected", map{
            name: "scene_status",
            accessibility_label: "Galaxy scene status"
        }),
        UI.grid([
            UI.card([
                UI.heading("Reproducible"),
                UI.text("A seed recreates the same scene")
            ], map{ name: "deterministic_card" }),
            UI.card([
                UI.heading("Bounded"),
                UI.text("Every density has a fixed work limit")
            ], map{ name: "bounded_card" }),
            UI.card([
                UI.heading("Portable"),
                UI.text("One model for Web, desktop and Android")
            ], map{ name: "portable_card" })
        ], map{ name: "quality_grid", columns: 3, gap: 12 })
    ], map{ name: "procedural_galaxy_root", gap: 16 });
}

fn visual_scene(report, width = 960, height = 600) {
    let scene = Visual.scene(width, height, map{
        title: "Procedural Galaxy",
        backend: "portable",
        bg: [4, 7, 14, 255],
        quality: "balanced"
    });
    Visual.add(scene, Visual.skybox("deep_space", nil, [4, 7, 14, 255]));
    for group in report.groups {
        if group.count > 0 {
            Visual.add(scene, Visual.cloud_nd("stars_" + group.id, group.points, group.color));
        }
    }
    let radius = report.parameters.max_radius;
    Visual.add(scene, Visual.camera3d("orbit_camera", radius * 1.8, radius * 1.2,
        radius * 1.4, [0, 0, 0], map{ fov: 52, near: 0.05, far: radius * 10 }));
    Visual.add(scene, Visual.text("scene_title", 24, 24,
        str(report.star_count) + " deterministic stars", [238, 244, 255, 255], 22));
    return scene;
}

fn compiled_visual(report, width = 960, height = 600) {
    return Visual.compile(visual_scene(report, width, height));
}

fn web_options() {
    return map{
        theme: "dark",
        lang: "en",
        host: "127.0.0.1",
        port: 8080,
        width: 1180,
        height: 820,
        palette: map{
            accent: [54, 132, 255],
            selected: [22, 94, 210],
            focus: [255, 205, 102]
        },
        source_sha256: Galaxy.source_sha256()
    };
}

export view, visual_scene, compiled_visual, web_options;
