let Galaxy = import("examples/procedural_galaxy_scene/galaxy.sapp");
let App = import("examples/procedural_galaxy_scene/app.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn main() {
    let report = Galaxy.generate();
    let visual = App.compiled_visual(report);
    let ui = UI.compile(App.view(), map{ target: "native", width: 1280, height: 800 });
    let result = map{
        format: "pblang.example.procedural-galaxy-scene.v1",
        galaxy: Galaxy.summary(report),
        ui_records: len(ui.records),
        visual_nodes: len(visual.draw),
        verified: report.star_count == 512 and len(visual.draw) >= 7
    };
    print json_stringify(result);
    return result.verified;
}

main();
