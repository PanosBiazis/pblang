// Character and string classifier based on the original school exercise by
// Panos Biazis. The first implementation was written independently in C and
// this PBLang edition expands it to bounded Unicode-scalar text analysis.

let Unicode = import("stdlib:unicode.sapp");

fn describe(row) {
    return "[" + str(row.index) + "] " + Unicode.escape_string(row.character)
        + " U+" + Unicode.hex_codepoint(row.codepoint) + " -> " + row.kind;
}

fn classify(value) {
    if type(value) != "string" or len(value) == 0 {
        print "No character was provided.";
        return false;
    }

    let rows = Unicode.classify_text(value);
    if len(rows) == 1 {
        print "Character classification:";
    } else {
        print "String classification (" + str(len(rows)) + " characters):";
    }
    for row in rows { print describe(row); }
    return true;
}

fn main() {
    print "Give a string or a character:";
    let input = read_line();
    if input == nil {
        print "Input is unavailable.";
        return false;
    }
    return classify(input);
}

main();
