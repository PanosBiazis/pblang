// Compile with --initialize initialize --entry work --cleanup release.
// Top-level declarations do not acquire external resources.
let owned=[];
fn initialize() { push(owned,7); }
fn work() {
    for _i 1 {
        let p=map{run:fn(self){return owned[0];}};
        print (try {p:run()} catch 9);
    }
}
fn release() { array_pop(owned);print "released"; }
