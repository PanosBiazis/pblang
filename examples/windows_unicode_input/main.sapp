// Build a real x86-64 Windows semantic-input helper entirely in PBLang.
// Set PB_WINDOWS_INPUT_ARTIFACT to persist it for target-host verification.
let WindowsInput = import("stdlib:windows_unicode_input.sapp");

let sample = "PBLang: Ελληνικά, 中文, 😀";
let built = WindowsInput.artifact(sample);
if not built.ok { throw built.error; }

let output = try env_get("PB_WINDOWS_INPUT_ARTIFACT") catch nil;
if type(output) == "string" and output != "" { fs_write_bytes(output, built.bytes); }
print map{ format: built.format, scalars: built.scalar_count,
    utf16_units: built.utf16_units, send_input_calls: built.send_input_calls,
    input_events: built.input_events,
    artifact_bytes: built.artifact_bytes,
    persisted: type(output) == "string" and output != "" };
