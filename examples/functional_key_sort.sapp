let F=import("stdlib:functional.sapp");
let rows=[map{name:"beta",rank:2},map{name:"alpha",rank:1},map{name:"gamma",rank:2}];
let key=fn(row){return row.rank;};let compare=fn(a,b){return a-b;};
let sorted=F.stable_sort_by_key(rows,key,compare);
print F.map(sorted,fn(row){return row.name;});
let order=F.stable_argsort_by_key(rows,key,compare);print order;
assert(order==[1,0,2],"stable rank order");
