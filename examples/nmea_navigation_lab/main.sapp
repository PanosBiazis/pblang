let NMEA = import("stdlib:nmea.sapp");
let App = import("examples/nmea_navigation_lab/app.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn main() {
    let sentences = [
        "$GPGGA,123519,4807.038,N,01131.000,E,1,08,0.9,545.4,M,46.9,M,,*47",
        "$GPRMC,225446,A,4916.45,N,12311.12,W,000.5,054.7,191194,020.3,E*68"
    ];
    let parsed = NMEA.parse_batch(sentences, 2);
    let views = [];
    for record in parsed.records { array_push(views, NMEA.privacy_view(record, 2)); }
    let ui = UI.compile(App.view(), map{ target: "native", width: 1280, height: 800 });
    let result = map{
        format: "pblang.example.nmea-navigation-lab.v1",
        records: views, parsed: parsed.valid, rejected: parsed.invalid,
        ui_records: len(ui.records), adapters: NMEA.adapter_status(),
        verified: parsed.valid == 2 and parsed.invalid == 0
    };
    print json_stringify(result);
    return result.verified;
}

main();
