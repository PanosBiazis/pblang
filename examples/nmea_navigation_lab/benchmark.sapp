let NMEA = import("stdlib:nmea.sapp");

let vectors = [
    "$GPGGA,123519,4807.038,N,01131.000,E,1,08,0.9,545.4,M,46.9,M,,*47",
    "$GPRMC,225446,A,4916.45,N,12311.12,W,000.5,054.7,191194,020.3,E*68"
];
let sentences = [];
let i = 0;
while i < 128 {
    array_push(sentences, vectors[i % 2]);
    i = i + 1;
}

let parsed = NMEA.parse_batch(sentences, 128);
if not parsed.ok or parsed.valid != 128 or parsed.invalid != 0 {
    throw "bounded NMEA benchmark produced an invalid result";
}

let privacy_records = 0;
for record in parsed.records {
    let safe = NMEA.privacy_view(record, 2);
    if not safe.ok or safe.exact_position_exposed { throw "privacy projection failed"; }
    privacy_records = privacy_records + 1;
}

print json_stringify(map{
    format: "pblang.example.nmea-navigation-benchmark.v1",
    sentence_count: parsed.count,
    privacy_records: privacy_records,
    max_batch_exercised: parsed.count == 128,
    verified: privacy_records == 128
});
