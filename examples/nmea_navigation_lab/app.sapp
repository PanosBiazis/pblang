let UI = import("stdlib:modern_ui.sapp");

fn source_sha256() {
    return "6a2cfd67aa48320d875c180afaca5a8eadf9cb38a227bca0e8bf0d6d18725ab2";
}

fn _precision_action(title, decimals) {
    return UI.action_sequence([
        UI.action_set_text("active_precision", title),
        UI.action_set_text("privacy_status",
            "Location display limited to " + str(decimals) + " decimal places")
    ]);
}

fn view() {
    return UI.screen([
        UI.heading("NMEA Navigation Lab", map{
            name: "brand", accessibility_label: "NMEA Navigation Lab"
        }),
        UI.text("Checksum-first GPS sentence inspection", map{ name: "subtitle" }),
        UI.row([
            UI.button("Regional", _precision_action("Regional", 1), map{
                name: "precision_regional",
                accessibility_label: "Show regional coordinate precision"
            }),
            UI.button("Coarse", _precision_action("Coarse", 2), map{
                name: "precision_coarse",
                accessibility_label: "Show coarse coordinate precision"
            })
        ], map{ name: "precision_picker", responsive: true, gap: 8 }),
        UI.heading("Coarse", map{ name: "active_precision" }),
        UI.text("Location display limited to 2 decimal places", map{
            name: "privacy_status", accessibility_label: "Location privacy status"
        }),
        UI.grid([
            UI.card([
                UI.heading("GGA"),
                UI.text("Fix quality, satellites, dilution and altitude")
            ], map{ name: "gga_card" }),
            UI.card([
                UI.heading("RMC"),
                UI.text("Status, UTC, date, speed and course")
            ], map{ name: "rmc_card" }),
            UI.card([
                UI.heading("Live adapters"),
                UI.text("Blocked until a reviewed native adapter exists")
            ], map{ name: "adapter_card" })
        ], map{ name: "format_grid", columns: 3, gap: 12 })
    ], map{ name: "nmea_navigation_root", gap: 16 });
}

fn web_options() {
    return map{
        theme: "light", lang: "en", host: "127.0.0.1", port: 8080,
        width: 1180, height: 820, source_sha256: source_sha256(),
        palette: map{
            accent: [0, 119, 109], selected: [0, 88, 80], focus: [0, 95, 204]
        }
    };
}

export source_sha256, view, web_options;
