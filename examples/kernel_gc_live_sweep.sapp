// pblang:target=kernel
// pblang:extern heap_init gc_new gc_set_auto gc_alloc gc_add_root gc_remove_root gc_set_child gc_live gc_collections kernel_gc_collect
// QEMU-only fixture: prepend kernel/heap.sapp and kernel/gc.sapp.
// Raw control reads verify stable ownership-table compaction, not a public ABI.
fn verify(ok) { if not ok { outb(244,1); while 1>0 { hlt(); } } }
fn kmain() {
    let h=kmalloc(8);let region=kmalloc(32768);heap_init(h,region,32768);
    let g=gc_new(h);verify(g!=0);gc_set_auto(g,0);
    let garbage0=gc_alloc(g,0);let a=gc_alloc(g,3);let b=gc_alloc(g,1);
    let garbage1=gc_alloc(g,0);let c=gc_alloc(g,1);let garbage2=gc_alloc(g,0);let d=gc_alloc(g,1);
    verify(garbage0!=0 and garbage1!=0 and garbage2!=0 and a!=0 and b!=0 and c!=0 and d!=0);
    gc_set_child(a,0,b);gc_set_child(a,1,c);gc_set_child(a,2,b);
    gc_set_child(b,0,d);gc_set_child(c,0,d);gc_set_child(d,0,a);
    verify(gc_add_root(g,a)==1 and gc_add_root(g,a)==1 and gc_add_root(g,d)==1);
    // Duplicate roots and shared edges must not inflate the marked-object count.
    verify(kernel_gc_collect(g)==0 and gc_live(g)==4);
    let table=peek32(g+20);
    verify(peek32(table)==a and peek32(table+4)==b and peek32(table+8)==c and peek32(table+12)==d);
    let rounds=gc_collections(g);let i=0;
    while i<1000 {
        verify(kernel_gc_collect(g)==0 and gc_live(g)==4);
        verify(peek32(g+12)==0 and peek32(g+20)==table);
        verify(peek32(table)==a and peek32(table+4)==b and peek32(table+8)==c and peek32(table+12)==d);
        i=i+1;
    }
    verify(gc_collections(g)==rounds+1000);
    // One formerly reachable branch dies; the next pass must sweep again.
    gc_set_child(a,1,0);verify(kernel_gc_collect(g)==0 and gc_live(g)==3);
    verify(peek32(table)==a and peek32(table+4)==b and peek32(table+8)==d);
    verify(gc_remove_root(g,a)==2 and gc_remove_root(g,d)==1);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==0);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==0);
    // A rooted leaf is also eligible for the all-live path, then reclaimable.
    let leaf=gc_alloc(g,0);verify(leaf!=0 and gc_add_root(g,leaf)==1);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==1);
    verify(gc_remove_root(g,leaf)==1 and kernel_gc_collect(g)==0 and gc_live(g)==0);
    outb(244,42);while 1>0 {hlt();}
}
