// examples/self_host_demo/main.sapp
//
// Demonstrates the self-hosted pblang compiler pipeline:
//   Tokenizer → Parser → Type Checker → Code Generator → Optimizer → IR
//
// This script compiles a small pblang program end-to-end using the
// self-hosted compiler components written in pblang itself, then
// prints the generated bytecode.

fn main() {
    print("═══════════════════════════════════════════════");
    print("  pblang Self-Hosting Compiler Demo");
    print("═══════════════════════════════════════════════");
    print("");

    // ── Import compiler components ─────────────────────────────────────────
    let tok = import("stdlib/compiler/tokenizer.sapp");
    let par = import("stdlib/compiler/parser.sapp");
    let tck = import("stdlib/compiler/typeck.sapp");
    let cg = import("stdlib/compiler/codegen.sapp");
    let opt = import("stdlib/compiler/optimizer.sapp");
    let ir = import("stdlib/compiler/ir.sapp");
    let front = import("stdlib/compiler/selfhost_frontend.sapp");

    // ── Source program to compile ──────────────────────────────────────────
    let source = "
fn factorial(n) {
    if n <= 1 { return 1; }
    return n * factorial(n - 1);
}

fn add(a, b) {
    return a + b;
}

let result = add(3, 4);
let fact5 = factorial(5);
print result;
print fact5;
";

    print("── Source ──");
    print(source);
    print("");

    // ── Step 1: Tokenize ───────────────────────────────────────────────────
    print("── Step 1: Tokenize ──");
    let tokens = tok.tokenize(source);
    print("  Tokens: " + str(len(tokens)));
    print("  Sample: " + tok.format_tokens(tokens));
    print("");

    // ── Step 2: Parse ──────────────────────────────────────────────────────
    print("── Step 2: Parse ──");
    let ast = par.parse(tokens);
    print("  Statements: " + str(len(ast.stmts)));
    if len(ast.errors) > 0 {
        print("  Parse errors: " + str(len(ast.errors)));
        let e = 0;
        while e < len(ast.errors) {
            print("    " + ast.errors[e]);
            e = e + 1;
        }
    } else {
        print("  No parse errors.");
    }
    print("");

    // ── Step 3: Type Check ─────────────────────────────────────────────────
    print("── Step 3: Type Check ──");
    let diagnostics = tck.type_check(ast.stmts);
    print("  Diagnostics: " + str(len(diagnostics)));
    let d = 0;
    while d < len(diagnostics) {
        print("    " + diagnostics[d].message);
        d = d + 1;
    }
    print("");

    // ── Step 4: Code Generation ────────────────────────────────────────────
    print("── Step 4: Code Generation ──");
    let chunk = cg.compile_stmts(ast.stmts);
    print("  Instructions: " + str(len(chunk.instructions)));
    print("  Constants: " + str(len(chunk.constants)));
    print("");

    // ── Step 5: Optimization ───────────────────────────────────────────────
    print("── Step 5: Optimization ──");
    let opt_result = opt.optimize(chunk);
    print("  " + opt.stats_to_string(opt_result.stats));
    print("  Before: " + str(len(chunk.instructions)) + " insts");
    print("  After:  " + str(len(opt_result.chunk.instructions)) + " insts");
    print("");

    // ── Step 6: IR Analysis ────────────────────────────────────────────────
    print("── Step 6: IR Analysis ──");
    let cfg = ir.build_cfg(opt_result.chunk);
    let doms = ir.compute_dominators(cfg);
    let loops = ir.detect_loops(cfg, doms);

    print(ir.cfg_to_string(cfg));
    print(ir.loops_to_string(loops));
    print("");

    // ── Step 7: Disassembly ────────────────────────────────────────────────
    print("── Step 7: Bytecode Disassembly (optimized) ──");
    cg.disasm_chunk(opt_result.chunk);
    print("");

    // ── Step 8: Frontend convenience wrapper ───────────────────────────────
    print("── Step 8: Frontend convenience wrapper ──");
    let fe_result = front.frontend_compile(source);
    print("  Compilation ok: " + str(fe_result.ok));
    print("  Generated: " + str(len(fe_result.chunk.instructions)) + " instructions");
    print("");

    // ── Step 9: Smoke test ─────────────────────────────────────────────────
    print("── Step 9: Compiler Smoke Test ──");
    let boot = import("stdlib/compiler/bootstrap.sapp");
    let smoke = boot.compiler_smoke_test();
    boot.print_smoke_results(smoke);

    print("");
    print("═══════════════════════════════════════════════");
    print("  Self-Hosting Compiler Demo Complete");
    print("═══════════════════════════════════════════════");
}

main();
