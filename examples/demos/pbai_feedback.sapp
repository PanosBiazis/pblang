// Explicit encoder and decoder parameters; inference does not train either model.
let NN=import("stdlib:nn.sapp");
let feedback=import("stdlib/pbai_feedback.sapp");
let encoder=feedback.stack([NN.dense_new(2,4,41),NN.dense_new(4,1,42)]);
let decoder=feedback.stack([NN.dense_new(1,3,51),NN.dense_new(3,2,52)]);
let result=feedback.cycle(encoder,decoder,[0.2,0.8],map{
 max_iterations:16,tolerance:0.000001,damping:0.8,anchor:0.25
});
print result.stop_reason;
print result.residual;
print result.reconstruction_error;
print result.input;
print result.output;
