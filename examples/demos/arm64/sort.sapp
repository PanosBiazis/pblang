let a = [5, 2, 8, 1, 9, 3];
let n = len(a);
let i = 0;
while i < n {
    let j = 0;
    while j < n - 1 - i {
        if a[j] > a[j + 1] {
            let t = a[j];
            a[j] = a[j + 1];
            a[j + 1] = t;
        }
        j = j + 1;
    }
    i = i + 1;
}
let k = 0;
while k < n { print a[k]; k = k + 1; }
