// words.sapp — str_split demo: split a CSV line and a sentence, print each token.
let csv = str_split("ada,grace,alan,linus", ",");
let i = 0;
while i < len(csv) { print "name " + str(i) + ": " + csv[i]; i = i + 1; }
let w = str_split("pblang runs on every device", " ");
print "words: " + str(len(w));
print w[len(w) - 1] + " " + w[1];
