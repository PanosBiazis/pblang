let Logic = import("stdlib:logic.sapp");
let Relationships = import("./relationships.sapp");
let App = import("./app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "relationship reasoning lab test failed: " + message; }
}

fn record(bundle, name) {
    for item in bundle.records { if item.name == name { return item; } }
    return nil;
}

let data = Relationships.report("casey");
require(data.children == ["ellis", "gray"], "children query must preserve fact order");
require(data.siblings == ["drew"], "sibling rule must exclude self and deduplicate parents");
require(data.ancestors == ["arden", "blair"], "ancestor closure must find both parents");
require(data.descendants == ["ellis", "gray"], "descendant closure must find both children");
require(len(data.grandparents) == 0, "reference person must not have grandparents in fixture");
require(not data.evidence.children.truncated and not data.evidence.siblings.truncated
    and not data.evidence.ancestors.truncated and not data.evidence.descendants.truncated,
    "all reference queries must complete inside explicit budgets");
require(data.source_sha256 == [
    "ff2ee83bbd68a46bffb0ae93660e827eecfc88d9c30a458039172b679fad275d",
    "689a3588ea5ef7dd4e051efbbb952ed064f74cea78658502691de7914ebe744f"
], "source identity must be content-addressed");
require(not data.personal_source_names_retained and not data.network_access
    and not data.persistent_storage and len(data.foreign_dependencies) == 0,
    "migration must remain synthetic, local and PBLang-only");

let grandparents = Relationships.report("ellis");
require(grandparents.grandparents == ["arden", "blair"],
    "two-hop grandparent rule must derive both results");

let cyclic = Logic.db();
Logic.fact(cyclic, "parent", ["a", "b"]);
Logic.fact(cyclic, "parent", ["b", "a"]);
let X = Logic.var("X");
let Y = Logic.var("Y");
let Z = Logic.var("Z");
Logic.add_rule(cyclic, Logic.rule(Logic.pred("ancestor", [X, Y]), [
    Logic.pred("parent", [X, Y])
]));
Logic.add_rule(cyclic, Logic.rule(Logic.pred("ancestor", [X, Y]), [
    Logic.pred("parent", [X, Z]), Logic.pred("ancestor", [Z, Y])
]));
let cycle_result = Logic.ask_bounded(cyclic, "ancestor", ["a", X], map{
    max_depth: 8, max_steps: 200, max_solutions: 16
});
require(cycle_result.truncated,
    "cyclic recursive knowledge must be visibly bounded, never reported complete");

let tree = App.view(data);
require(UI.validate(tree).ok, "shared UI tree must validate");
for bundle in [
    UI.compile(tree, map{ target: "web", width: 320, height: 640 }),
    UI.compile(tree, map{ target: "native", width: 1440, height: 900 }),
    UI.compile(tree, map{ target: "android", width: 360, height: 720 })
] {
    require(record(bundle, "brand") != nil and record(bundle, "query_status") != nil,
        "brand and accessible status must render on every target");
    require(record(bundle, "show_children") != nil and record(bundle, "show_siblings") != nil
        and record(bundle, "show_ancestors") != nil and record(bundle, "show_descendants") != nil,
        "query controls must render on every target");
    require(record(bundle, "evidence_card") != nil and record(bundle, "privacy_card") != nil
        and record(bundle, "constraint_boundary") != nil,
        "solver evidence and boundaries must remain visible");
}
let preview = UI.preview_web("Relationship Reasoning Lab", tree, App.web_options());
require(preview.response.status == 200
    and str_contains(preview.generated.html, "viewport-fit=cover")
    and str_contains(preview.generated.css, "@media(max-width:640px)"),
    "Web preview must be responsive on compact screens");
require(not str_contains(preview.generated.html, "http://")
    and not str_contains(preview.generated.html, "https://"),
    "Web preview must have no remote dependency");

let visual = Visual.compile(App.visual_scene(720, 520));
require(len(visual.draw) == 22 and len(visual.assets) == 0,
    "relationship graph must contain eight edges and seven local node-label pairs");

for source_path in [
    "stdlib/logic.sapp",
    "examples/relationship_reasoning_lab/relationships.sapp",
    "examples/relationship_reasoning_lab/app.sapp",
    "examples/relationship_reasoning_lab/main.sapp",
    "examples/relationship_reasoning_lab/benchmark.sapp",
    "examples/relationship_reasoning_lab/test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
        "bounded security analysis must pass for " + source_path);
}

print "relationship_reasoning_lab_pass";
