let Relationships = import("./relationships.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");

fn model(person = "casey") { return Relationships.report(person); }

fn _count_text(label, values) {
    return str(len(values)) + " " + label;
}

fn view(data) {
    return UI.screen([
        UI.heading("Relationship Reasoning Lab", map{
            name: "brand", accessibility_label: "Relationship Reasoning Lab"
        }),
        UI.text("Bounded declarative queries over local synthetic facts", map{
            name: "subtitle"
        }),
        UI.text("Selected: " + data.person, map{
            name: "selected_person", accessibility_label: "Selected synthetic person"
        }),
        UI.row([
            UI.button("Children", UI.action_set_text("query_status",
                _count_text("children", data.children)), map{
                name: "show_children", accessibility_label: "Show children query summary"
            }),
            UI.button("Siblings", UI.action_set_text("query_status",
                _count_text("siblings", data.siblings)), map{
                name: "show_siblings", accessibility_label: "Show siblings query summary"
            }),
            UI.button("Ancestors", UI.action_set_text("query_status",
                _count_text("ancestors", data.ancestors)), map{
                name: "show_ancestors", accessibility_label: "Show ancestors query summary"
            }),
            UI.button("Descendants", UI.action_set_text("query_status",
                _count_text("descendants", data.descendants)), map{
                name: "show_descendants", accessibility_label: "Show descendants query summary"
            })
        ], map{ name: "query_controls", responsive: true, gap: 8 }),
        UI.text("Ready", map{
            name: "query_status", accessibility_label: "Relationship query status"
        }),
        UI.grid([
            UI.card([
                UI.heading("Knowledge"),
                UI.text(str(data.facts) + " facts"),
                UI.text(str(data.rules) + " rules")
            ], map{ name: "knowledge_card" }),
            UI.card([
                UI.heading("Solver evidence"),
                UI.text(str(data.evidence.ancestors.steps) + " ancestor-query steps"),
                UI.text("Complete: " + str(not data.evidence.ancestors.truncated))
            ], map{ name: "evidence_card" }),
            UI.card([
                UI.heading("Privacy"),
                UI.text("Synthetic identities only"),
                UI.text("No network or storage")
            ], map{ name: "privacy_card" })
        ], map{ name: "summary_grid", columns: 3, gap: 12 }),
        UI.text("Inequality is evaluated after variables are bound; full Prolog dif/2 is not claimed.", map{
            name: "constraint_boundary", accessibility_label: "Logic constraint boundary"
        })
    ], map{ name: "relationship_reasoning_root", gap: 16 });
}

fn visual_scene(width = 960, height = 600) {
    let graph = Relationships.graph();
    let positions = map{
        arden: [170, 90], blair: [390, 90], casey: [230, 260], drew: [430, 260],
        finley: [650, 260], ellis: [330, 450], gray: [570, 450]
    };
    let scene = Visual.scene(width, height, map{
        title: "Synthetic relationship graph", backend: "portable",
        bg: [247, 249, 251, 255]
    });
    let edge_index = 0;
    while edge_index < len(graph.parent_edges) {
        let edge = graph.parent_edges[edge_index];
        let parent = positions[edge[0]];
        let child = positions[edge[1]];
        Visual.add(scene, Visual.line2d("edge-" + str(edge_index),
            parent[0], parent[1], child[0], child[1], [88, 101, 112, 255], 2));
        edge_index = edge_index + 1;
    }
    let person_index = 0;
    while person_index < len(graph.people) {
        let person = graph.people[person_index];
        let point = positions[person];
        Visual.add(scene, Visual.circle2d("person-" + person,
            point[0], point[1], 24, [0, 121, 107, 255], true));
        Visual.add(scene, Visual.text("label-" + person,
            point[0] - 24, point[1] + 40, person, [23, 31, 38, 255], 14));
        person_index = person_index + 1;
    }
    return scene;
}

fn web_options() {
    return map{
        theme: "light", lang: "en", host: "127.0.0.1", port: 8080,
        width: 1180, height: 820,
        palette: map{
            accent: [0, 121, 107], selected: [198, 72, 40], focus: [0, 91, 150]
        }
    };
}

export model, view, visual_scene, web_options;
