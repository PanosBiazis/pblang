let Logic = import("stdlib:logic.sapp");

fn main() {
    let database = Logic.db();
    let count = 96;
    let i = 0;
    while i < count - 1 {
        Logic.fact(database, "parent", ["node-" + str(i), "node-" + str(i + 1)]);
        i = i + 1;
    }
    let X = Logic.var("X");
    let Y = Logic.var("Y");
    let Z = Logic.var("Z");
    Logic.add_rule(database, Logic.rule(Logic.pred("ancestor", [X, Y]), [
        Logic.pred("parent", [X, Y])
    ]));
    Logic.add_rule(database, Logic.rule(Logic.pred("ancestor", [X, Y]), [
        Logic.pred("parent", [X, Z]), Logic.pred("ancestor", [Z, Y])
    ]));
    let result = Logic.ask_bounded(database, "ancestor", ["node-0", X], map{
        max_depth: 128, max_steps: 1000000, max_solutions: 256
    });
    let values = Logic.distinct(Logic.select_one(result.rows, X));
    let report = map{
        format: "pblang.example.relationship-reasoning-benchmark.v1",
        nodes: count, relationships: count - 1, descendants: len(values),
        steps: result.steps, truncated: result.truncated,
        verified: not result.truncated and len(values) == count - 1
    };
    print json_stringify(report);
    return report.verified;
}

main();
