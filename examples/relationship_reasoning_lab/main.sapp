let App = import("./app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");

fn main() {
    let data = App.model();
    let ui = UI.compile(App.view(data), map{ target: "native", width: 1280, height: 800 });
    let visual = Visual.compile(App.visual_scene());
    let verified = not data.evidence.ancestors.truncated
        and len(data.children) == 2 and len(data.siblings) == 1
        and len(ui.records) > 0 and len(visual.draw) == 22;
    let result = map{
        format: data.format, facts: data.facts, rules: data.rules,
        children: data.children, siblings: data.siblings,
        ancestor_steps: data.evidence.ancestors.steps,
        ui_records: len(ui.records), visual_nodes: len(visual.draw), verified: verified
    };
    print json_stringify(result);
    return verified;
}

main();
