let Logic = import("stdlib:logic.sapp");

let FORMAT = "pblang.example.relationship-reasoning-lab.v1";
let SOURCE_SHA256 = [
    "ff2ee83bbd68a46bffb0ae93660e827eecfc88d9c30a458039172b679fad275d",
    "689a3588ea5ef7dd4e051efbbb952ed064f74cea78658502691de7914ebe744f"
];
let QUERY_LIMITS = map{ max_depth: 16, max_steps: 20000, max_solutions: 256 };

fn database() {
    let knowledge = Logic.db();
    for edge in [
        ["arden", "casey"], ["arden", "drew"],
        ["blair", "casey"], ["blair", "drew"],
        ["casey", "ellis"], ["finley", "ellis"],
        ["casey", "gray"], ["finley", "gray"]
    ] { Logic.fact(knowledge, "parent", edge); }
    for attribute in [
        ["arden", "male"], ["blair", "female"],
        ["casey", "female"], ["drew", "male"],
        ["finley", "male"], ["ellis", "female"], ["gray", "male"]
    ] { Logic.fact(knowledge, "gender", attribute); }

    let X = Logic.var("X");
    let Y = Logic.var("Y");
    let Z = Logic.var("Z");
    Logic.add_rule(knowledge, Logic.rule(Logic.pred("father", [X, Y]), [
        Logic.pred("parent", [X, Y]), Logic.pred("gender", [X, "male"])
    ]));
    Logic.add_rule(knowledge, Logic.rule(Logic.pred("mother", [X, Y]), [
        Logic.pred("parent", [X, Y]), Logic.pred("gender", [X, "female"])
    ]));
    Logic.add_rule(knowledge, Logic.rule(Logic.pred("sibling", [X, Y]), [
        Logic.pred("parent", [Z, X]), Logic.pred("parent", [Z, Y]),
        Logic.not_equal(X, Y)
    ]));
    Logic.add_rule(knowledge, Logic.rule(Logic.pred("grandparent", [X, Y]), [
        Logic.pred("parent", [X, Z]), Logic.pred("parent", [Z, Y])
    ]));
    Logic.add_rule(knowledge, Logic.rule(Logic.pred("ancestor", [X, Y]), [
        Logic.pred("parent", [X, Y])
    ]));
    Logic.add_rule(knowledge, Logic.rule(Logic.pred("ancestor", [X, Y]), [
        Logic.pred("parent", [X, Z]), Logic.pred("ancestor", [Z, Y])
    ]));
    return knowledge;
}

fn _values(result, variable) {
    return Logic.distinct(Logic.select_one(result.rows, variable));
}

fn children(knowledge, person) {
    let child = Logic.var("Child");
    let result = Logic.ask_bounded(
        knowledge, "parent", [person, child], QUERY_LIMITS);
    return map{ values: _values(result, child), evidence: result };
}

fn siblings(knowledge, person) {
    let sibling = Logic.var("Sibling");
    let result = Logic.ask_bounded(
        knowledge, "sibling", [person, sibling], QUERY_LIMITS);
    return map{ values: _values(result, sibling), evidence: result };
}

fn ancestors(knowledge, person) {
    let ancestor = Logic.var("Ancestor");
    let result = Logic.ask_bounded(
        knowledge, "ancestor", [ancestor, person], QUERY_LIMITS);
    return map{ values: _values(result, ancestor), evidence: result };
}

fn descendants(knowledge, person) {
    let descendant = Logic.var("Descendant");
    let result = Logic.ask_bounded(
        knowledge, "ancestor", [person, descendant], QUERY_LIMITS);
    return map{ values: _values(result, descendant), evidence: result };
}

fn grandparents(knowledge, person) {
    let grandparent = Logic.var("Grandparent");
    let result = Logic.ask_bounded(
        knowledge, "grandparent", [grandparent, person], QUERY_LIMITS);
    return map{ values: _values(result, grandparent), evidence: result };
}

fn report(person = "casey") {
    let knowledge = database();
    let child_result = children(knowledge, person);
    let sibling_result = siblings(knowledge, person);
    let ancestor_result = ancestors(knowledge, person);
    let descendant_result = descendants(knowledge, person);
    let grandparent_result = grandparents(knowledge, person);
    return map{
        ok: true, format: FORMAT, person: person,
        children: child_result.values, siblings: sibling_result.values,
        ancestors: ancestor_result.values, descendants: descendant_result.values,
        grandparents: grandparent_result.values,
        evidence: map{
            children: child_result.evidence, siblings: sibling_result.evidence,
            ancestors: ancestor_result.evidence, descendants: descendant_result.evidence,
            grandparents: grandparent_result.evidence
        },
        facts: len(Logic.facts_of(knowledge, "parent"))
            + len(Logic.facts_of(knowledge, "gender")),
        rules: len(knowledge.rules), source_sha256: SOURCE_SHA256,
        implementation_language: "pblang", foreign_dependencies: [],
        personal_source_names_retained: false, network_access: false,
        persistent_storage: false
    };
}

fn graph() {
    let knowledge = database();
    return map{
        people: ["arden", "blair", "casey", "drew", "finley", "ellis", "gray"],
        parent_edges: Logic.facts_of(knowledge, "parent")
    };
}

export FORMAT, SOURCE_SHA256, QUERY_LIMITS;
export database, children, siblings, ancestors, descendants, grandparents, report, graph;
