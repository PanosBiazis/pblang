let C=import("stdlib:resource_capacity.sapp");
let window=map{start_ms:0,end_ms:60};
// 1. Two bookings fit a two-unit room; a third creates a ten-ms shortage.
let rooms=C.analyze([map{id:"room",capacity:2}],[map{id:"a",resource:"room",start_ms:10,end_ms:40,units:1},map{id:"b",resource:"room",start_ms:20,end_ms:50,units:1},map{id:"c",resource:"room",start_ms:30,end_ms:40,units:1}],window);
assert(rooms.resources[0].peak_units==3 and rooms.resources[0].overload_ms==10,"room capacity");
// 2. Exact handoff: ending at 30 does not overlap starting at 30.
let shifts=C.analyze([map{id:"staff",capacity:1}],[map{id:"first",resource:"staff",start_ms:0,end_ms:30,units:1},map{id:"second",resource:"staff",start_ms:30,end_ms:60,units:1}],window);
assert(shifts.overloaded_resources==0 and shifts.resources[0].used_unit_ms==60,"half-open handoff");
// 3. Independent resources: spare capacity on B cannot conceal a shortage on A.
let separate=C.analyze([map{id:"A",capacity:2},map{id:"B",capacity:8}],[map{id:"batch",resource:"A",start_ms:0,end_ms:60,units:3}],window);
assert(separate.overloaded_resources==1 and separate.resources[0].shortfall_unit_ms==60 and separate.resources[1].used_unit_ms==0,"resource isolation");
print json_stringify(map{rooms:rooms,handoff:shifts,separate:separate});
