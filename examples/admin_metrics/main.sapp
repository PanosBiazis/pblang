let Dashboard=import("./dashboard.sapp");
let args=try env_get("PBLANG_SCRIPT_ARGS") catch "";
if args!=nil and args!="" and args!="--export" {throw "usage: main.sapp [--export]";}
let report=Dashboard.build();
assert(report.sessions==75 and report.requests==7800 and report.failures==140,"synthetic aggregate totals");
assert(len(report.spatial)==6 and len(report.spatial[0])==3 and len(report.display[0])==2,"ND projection shapes");
if args=="--export" {
    fs_mkdirs("build/admin-metrics");fs_write("build/admin-metrics/index.html",report.html);
    print "Synthetic dashboard: build/admin-metrics/index.html";
} else {print "synthetic_admin_metrics_pass";}
