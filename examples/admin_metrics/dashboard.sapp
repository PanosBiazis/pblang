// Fixed synthetic aggregates only. No identities, sessions, authentication or service access.
let ND=import("stdlib:nd_projection.sapp");let Plot=import("stdlib:ui_scatter_plot.sapp");
let HTML=import("stdlib:html.sapp");let Web=import("stdlib:ui_form_web_document.sapp");
fn build() {
    // active sessions, requests, failed requests, p95 latency in milliseconds
    let points=[[10,1200,12,180],[8,900,9,140],[25,2400,72,320],[4,400,2,90],[16,1600,32,240],[12,1300,13,110]];
    let names=["Tenant A","Tenant B","Tenant C","Tenant D","Tenant E","Tenant F"];
    let rows=[];let sessions=0;let requests=0;let failures=0;let index=0;
    for point in points {
        push(rows,[names[index],point[0],point[1],point[2],point[3]]);
        sessions=sessions+point[0];requests=requests+point[1];failures=failures+point[2];index=index+1;
    }
    let direct=ND.compile([[0,1,0,0],[0,0,0,1]]).project(points);
    let spatial=ND.compile([[0,0.001,0,0],[0,0,0.05,0],[0,0,0,0.01]]).project(points);
    let display=ND.compile([[1,0,0.35],[0,1,0.25]]).project(spatial);
    let overview="<section class=\"metrics\"><p><strong>"+str(sessions)+"</strong> Active sessions</p><p><strong>"+str(requests)+"</strong> Requests</p><p><strong>"+str(failures)+"</strong> Failed requests</p></section>";
    let table=HTML.table(["Synthetic tenant","Active sessions","Requests","Failed requests","p95 latency (ms)"],rows);
    let first=Plot.render(direct,"Requests and latency","Requests","p95 latency (ms)",map{point_labels:names,x_domain:[0,3000],y_domain:[0,400],description:"Two axes selected from four-dimensional aggregate records."});
    let second=Plot.render(display,"Operational projection","Projected U","Projected V",map{point_labels:names,x_domain:[0,4],y_domain:[0,5],description:"A 3D view projected onto 2D: x=requests/1000, y=failures/20, z=latency/100; U=x+0.35z, V=y+0.25z. Active sessions are omitted from this view."});
    let css=Web.stylesheet()+".metrics{display:flex;flex-wrap:wrap;gap:1rem}.metrics p{background:#146b59;color:white;padding:1rem;border-radius:.7rem}.metrics strong{display:block;font-size:1.8rem}.admin-table{overflow:auto}.admin-table table{border-collapse:collapse;width:100%}.admin-table th,.admin-table td{text-align:left;padding:.6rem;border-bottom:1px solid #718d9f}.pb-scatter{margin:2rem 0}";
    let body="<main><h1>Synthetic admin metrics</h1><p>Six fictional tenants. Static aggregate data only; this example implements no login, SSO or tenant access control.</p>"+overview+"<h2>Aggregate values</h2><div class=\"admin-table\" tabindex=\"0\" role=\"region\" aria-label=\"Synthetic tenant metrics table\">"+table+"</div>"+first+second+"<p>Projection distances are visual summaries, not anomaly scores. Read the table for exact values. No network requests or tracking.</p></main>";
    let page=HTML.page("Synthetic admin metrics",body,"<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; style-src 'unsafe-inline'\"><style>"+css+"</style>");
    return map{html:page,rows:rows,spatial:spatial,display:display,sessions:sessions,requests:requests,failures:failures};
}
export build;
