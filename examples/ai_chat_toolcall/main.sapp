// Example: AI Chat with Tool-Call Support
// Demonstrates OpenAI-style function calling (tool_calls) request/response flow.
//
// Tool-Call Flow:
// 1. Send initial message with tool definitions to the AI
// 2. AI responds with finish_reason == "tool_calls" and a tool_calls array
// 3. Execute the requested tool locally
// 4. Send the tool result back as a new message with role: "tool"
// 5. AI provides final response incorporating the tool output

import "stdlib:http.sapp";
import "stdlib:json.sapp";

// =============================================================================
// Tool Definitions
// =============================================================================

// Example tool: get_weather
// Simulates fetching weather data for a location
fn get_weather(location) {
    // In production, this would call a real weather API
    // For this example, we return mock data
    let mock_data = map{
        "New York": map{ temp: 72, unit: "F", condition: "Partly cloudy" },
        "London": map{ temp: 15, unit: "C", condition: "Rainy" },
        "Tokyo": map{ temp: 25, unit: "C", condition: "Sunny" }
    };

    // Default response for unknown locations
    let default_data = map{ temp: 68, unit: "F", condition: "Clear" };

    if map.has(mock_data, location) {
        return mock_data[location];
    }
    return default_data;
}

// Tool registry: maps tool names to their implementations
fn execute_tool(tool_name, arguments_json) {
    let args = json.parse(arguments_json);

    if tool_name == "get_weather" {
        let location = try args.location catch "Unknown";
        return get_weather(location);
    }

    return map{ error: "Unknown tool: " + tool_name };
}

// =============================================================================
// Request Building
// =============================================================================

// Build OpenAI-compatible tools array for the API request
fn build_tools_schema() {
    return [
        map{
            type: "function",
            function: map{
                name: "get_weather",
                description: "Get the current weather for a location",
                parameters: map{
                    type: "object",
                    properties: map{
                        location: map{
                            type: "string",
                            description: "The city and country, e.g., 'Tokyo, Japan'"
                        }
                    },
                    required: ["location"]
                }
            }
        }
    ];
}

// Build the request body for chat completion
fn build_request_body(model, messages, tools) {
    let body = map{
        model: model,
        messages: messages
    };

    // Include tools if provided
    if tools != nil {
        body.tools = tools;
    }

    return json.stringify(body);
}

// =============================================================================
// API Communication
// =============================================================================

// Make a chat completion request with Bearer token authentication
fn chat_completion(endpoint, api_key, model, messages, tools) {
    let body = build_request_body(model, messages, tools);
    let response_str = http.post_auth(endpoint, body, api_key);
    return json.parse(response_str);
}

// Parse the finish_reason from the response
fn get_finish_reason(response) {
    let choices = try response.choices catch [];
    if len(choices) > 0 {
        return try choices[0].finish_reason catch nil;
    }
    return nil;
}

// Extract tool_calls array from response
fn get_tool_calls(response) {
    let choices = try response.choices catch [];
    if len(choices) > 0 {
        let message = try choices[0].message catch nil;
        if message != nil {
            return try message.tool_calls catch nil;
        }
    }
    return nil;
}

// Extract assistant message from response
fn get_assistant_message(response) {
    let choices = try response.choices catch [];
    if len(choices) > 0 {
        return try choices[0].message catch nil;
    }
    return nil;
}

// Extract content from response
fn get_content(response) {
    let choices = try response.choices catch [];
    if len(choices) > 0 {
        let message = try choices[0].message catch nil;
        if message != nil {
            return try message.content catch "";
        }
    }
    return "";
}

// =============================================================================
// Tool-Call Flow Implementation
// =============================================================================

// Process tool_calls from AI response
// Returns array of tool result messages
fn process_tool_calls(tool_calls) {
    let tool_messages = [];
    let i = 0;

    while i < len(tool_calls) {
        let tool_call = tool_calls[i];
        let tool_call_id = try tool_call.id catch "";
        let tool_name = try tool_call.function.name catch "";
        let arguments = try tool_call.function.arguments catch "{}";

        print "  [Tool Call] " + tool_name + "(" + arguments + ")";

        // Execute the tool
        let result = execute_tool(tool_name, arguments);
        let result_json = json.stringify(result);

        print "  [Tool Result] " + result_json;

        // Build tool result message
        tool_messages[len(tool_messages)] = map{
            role: "tool",
            tool_call_id: tool_call_id,
            content: result_json
        };

        i = i + 1;
    }

    return tool_messages;
}

// Complete tool-call flow:
// 1. Send message -> 2. Handle tool_calls -> 3. Send results -> 4. Get final response
fn chat_with_tools(endpoint, api_key, model, user_message) {
    // Step 1: Initial message with tools defined
    let messages = [
        map{ role: "user", content: user_message }
    ];

    let tools = build_tools_schema();

    print "[Step 1] Sending message with tool definitions...";
    print "  User: " + user_message;

    let response = chat_completion(endpoint, api_key, model, messages, tools);
    let finish_reason = get_finish_reason(response);

    print "[Step 2] Received response, finish_reason: " + finish_reason;

    // Step 2: Check if AI wants to call tools
    if finish_reason == "tool_calls" {
        print "  AI requested tool execution";

        // Get the assistant message with tool_calls
        let assistant_msg = get_assistant_message(response);
        let tool_calls = get_tool_calls(response);

        // Add assistant message to conversation
        messages[len(messages)] = assistant_msg;

        // Step 3: Execute tools and collect results
        print "[Step 3] Executing tool calls...";
        let tool_messages = process_tool_calls(tool_calls);

        // Add tool result messages to conversation
        let j = 0;
        while j < len(tool_messages) {
            messages[len(messages)] = tool_messages[j];
            j = j + 1;
        }

        // Step 4: Send results back and get final response
        print "[Step 4] Sending tool results back to AI...";
        let final_response = chat_completion(endpoint, api_key, model, messages, nil);
        let final_content = get_content(final_response);

        print "[Final Response]";
        print "  " + final_content;

        return final_content;
    }

    // No tool calls - direct response
    let content = get_content(response);
    print "  Direct response: " + content;
    return content;
}

// =============================================================================
// Provider Registry Pattern Integration
// =============================================================================

// Alternative: Use provider_registry for multi-provider support
// This shows how to integrate tool-calls with the registry pattern

fn register_tool_provider(registry, name, endpoint, api_key) {
    // Extend provider_registry pattern for tool support
    registry.register(name, endpoint, api_key);
}

fn call_with_tools_registry(endpoint, api_key, model, messages, tools) {
    // Use http.post_auth directly (provider_registry.call_best doesn't support tools)
    return chat_completion(endpoint, api_key, model, messages, tools);
}

// =============================================================================
// Main Entry Point
// =============================================================================

fn main() {
    print "=== AI Chat Tool-Call Example ===";
    print "";

    // Configuration - use environment variables or config file in production
    let endpoint = "https://api.openai.com/v1/chat/completions";
    let api_key = "YOUR_API_KEY_HERE";  // Replace with actual key
    let model = "gpt-4o";

    // Example prompt that should trigger tool usage
    let user_message = "What's the weather like in Tokyo right now?";

    print "Endpoint: " + endpoint;
    print "Model: " + model;
    print "";

    // Run the complete tool-call flow
    // Note: This will fail without a valid API key
    // To test, replace YOUR_API_KEY_HERE with an actual OpenAI API key

    // Simulated flow for demonstration (no actual API call):
    print "--- Simulated Tool-Call Flow ---";
    print "";
    print "[Step 1] Sending message with tool definitions...";
    print "  User: " + user_message;
    print "";
    print "[Step 2] Received response, finish_reason: tool_calls";
    print "  AI requested tool execution";
    print "";
    print "[Step 3] Executing tool calls...";
    print "  [Tool Call] get_weather({\"location\": \"Tokyo\"})";

    let weather_result = get_weather("Tokyo");
    print "  [Tool Result] " + json.stringify(weather_result);
    print "";
    print "[Step 4] Sending tool results back to AI...";
    print "";
    print "[Final Response]";
    print "  Based on the current weather data, Tokyo is experiencing sunny";
    print "  conditions with a temperature of 25C (77F). It's a great day";
    print "  to be outdoors in Tokyo!";
    print "";

    // Uncomment to make actual API call (requires valid API key):
    // let result = chat_with_tools(endpoint, api_key, model, user_message);

    print "=== Flow Complete ===";
    print "";
    print "Summary:";
    print "1. User sends message asking about weather";
    print "2. AI recognizes need for weather data, returns tool_calls";
    print "3. We execute get_weather('Tokyo') locally";
    print "4. We send {role: 'tool', content: weather_data} back";
    print "5. AI incorporates tool output into final response";
}

// =============================================================================
// Exports
// =============================================================================

export get_weather, execute_tool, build_tools_schema, build_request_body;
export chat_completion, get_finish_reason, get_tool_calls, get_assistant_message;
export get_content, process_tool_calls, chat_with_tools;
export register_tool_provider, call_with_tools_registry, main;
