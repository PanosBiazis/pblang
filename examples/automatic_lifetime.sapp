// The self-hosted compiler releases this temporary local reference at block exit.
// Compile with the PBLang-written frontend to exercise the new lifetime behavior.
let size=0;
if true {
    let scratch=str_repeat("x",1024*1024);
    size=len(scratch);
}
print size;
// A value returned from a block stays valid after its local slot is cleared.
let kept=if true {let value=map{answer:42};value;} else {map{answer:0};};
print kept.answer;
