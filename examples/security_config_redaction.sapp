// examples/security_config_redaction.sapp — Configuration Secret Redaction & Confidentiality Example
let SEC = import("stdlib:security.sapp");
let FABRIC = import("stdlib:aap_ecosystem_unified_fabric.sapp");

let raw_api_key = "pbl_live_sec_9934781200456123";
let masked = SEC.mask_secret(raw_api_key);

let conf_report = FABRIC.enforce_strict_confidentiality_and_redaction(map{
    repo_visibility: "private",
    raw_log_line: "service_boot config token=secret_tok_991 pass=supersecret key=" + raw_api_key
});

print "Config Redaction Verification: ok=" + str(conf_report.ok) + " private=" + str(conf_report.repository_visibility == "private");
print "Masked key: " + masked;
print "Redacted log preview: " + conf_report.redacted_preview;
print json_stringify(conf_report);
