// Bend-style divide-and-conquer in pblang.
//
// Run:
//   pblang run examples/bend_style_parallel/main.sapp --allow-all

let bend = import("stdlib:bend.sapp");

let n = 100000;
let total = bend.range_sum_parallel(1, n + 1, 4);
print "sum 1.." + str(n) + " = " + str(total);

let sorted = bend.divide_sort([9, 2, 7, 4, 1, 8, 3, 6, 5], fn(a, b) { return a < b; }, 3);
print "sorted = " + str(sorted);

let tree = bend.bend_tree_parallel(
    0,
    fn(x) { return x < 4; },
    fn(x) { return x + 1; },
    fn(x) { return x + 1; },
    fn(x) { return 1; },
    8,
    3
);
print "tree leaves sum = " + str(bend.tree_sum(tree));
