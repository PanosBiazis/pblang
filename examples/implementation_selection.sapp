// Retain both implementations. Select once, then use the chosen API.
let Switch = import("stdlib:implementation_switch.sapp");
let configuration = map{enabled:true, implementation:"pblang"};
let constructors = map{
    pblang:fn() { return map{sum:fn(a,b) { return a + b; }}; },
    // This placeholder preserves the integration point without running a tool.
    // Keep foreign loading/execution inside this constructor in real programs.
    polyglot:fn() { throw "retained backend not configured in this example"; }
};
let service = Switch.open(configuration.enabled, configuration.implementation, constructors);
print service.sum(20,22);
// enabled=false refuses construction. Changing implementation to polyglot
// explicitly selects the retained constructor; a failure never switches back.
