// The caller serializes the COMPLETE final result before applying the byte cap.
let Cap = import("stdlib:tool_result_cap.sapp");
let wire = json_stringify(map{ result: map{ message: "Γεια σου 🙂" } });
let receipt = Cap.bound_prevalidated_json(wire, 128);
assert(receipt.accepted and receipt.output == wire, "complete result admitted");
// Only output is the bounded wire payload. The receipt is local metadata.
if receipt.output != nil { print receipt.output; }
let large = json_stringify(map{ result: str_repeat("🙂", 80) });
let capped = Cap.bound_prevalidated_json(large, 64);
assert(capped.capped and capped.output == Cap.replacement_json(), "whole fixed replacement");
print capped.output;
let tiny = Cap.bound_prevalidated_json(large, 1);
assert(tiny.output == nil and tiny.output_bytes == 0, "no oversized fallback");
