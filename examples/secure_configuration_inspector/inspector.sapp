let Config = import("stdlib:config.sapp");

let SOURCE_SHA256 = "da69a2e4d2ea60dc03ea001f9b971db1ac8116f25db432b948fae3e18d65fbd9";

fn schema() {
    return [
        map{ key: "DEBUG", type: "bool", required: true },
        map{ key: "DATABASE_URL", type: "url", required: true },
        map{ key: "API_KEY", type: "string", required: true },
        map{ key: "SECRET_KEY", type: "string", required: true },
        map{ key: "PORT", type: "int", required: false },
        map{ key: "PUBLIC_ORIGIN", type: "https_url", required: false }
    ];
}

fn sample_dotenv() {
    return "DEBUG=false\n"
        + "DATABASE_URL=postgres://service.invalid/application\n"
        + "API_KEY=example-only-value\n"
        + "SECRET_KEY=local-development-value\n"
        + "PORT=8080\n"
        + "PUBLIC_ORIGIN=https://app.invalid\n";
}

fn _valid_bool(value) {
    let lower = str_lower(value);
    return lower == "true" or lower == "false" or lower == "1" or lower == "0"
        or lower == "yes" or lower == "no" or lower == "on" or lower == "off";
}

fn _valid_integer(value) {
    let number = try parse_number(value) catch nil;
    return number != nil and num_floor(number) == number;
}

fn _valid_url(value, https_only) {
    if https_only { return str_starts_with(str_lower(value), "https://"); }
    let lower = str_lower(value);
    return str_starts_with(lower, "postgres://")
        or str_starts_with(lower, "postgresql://")
        or str_starts_with(lower, "mysql://")
        or str_starts_with(lower, "sqlite://")
        or str_starts_with(lower, "https://");
}

fn _valid(value, expected) {
    if expected == "bool" { return _valid_bool(value); }
    if expected == "int" { return _valid_integer(value); }
    if expected == "url" { return _valid_url(value, false); }
    if expected == "https_url" { return _valid_url(value, true); }
    return type(value) == "string";
}

fn inspect_text(text, specifications = nil) {
    if specifications == nil { specifications = schema(); }
    if type(specifications) != "array" or len(specifications) > 128 {
        throw "configuration inspector: schema must contain at most 128 fields";
    }
    let parsed = Config.parse_dotenv_strict(text);
    if not parsed.ok {
        return map{
            format: "pblang.configuration-inspection.v1", ok: false, ready: false,
            fields: [], errors: parsed.errors, warnings: parsed.warnings,
            parsed_entries: parsed.entries, sensitive_entries: parsed.sensitive_entries,
            sensitive_values_exposed: false, host_environment_access: false,
            filesystem_access: false, bounded: true
        };
    }

    let snapshot = Config.redacted_values(parsed.values);
    let fields = [];
    let errors = [];
    let warnings = [];
    let expected = map{};
    let valid_count = 0;
    for specification in specifications {
        let key = str(try specification.key catch "");
        let expected_type = str(try specification.type catch "string");
        let required = try specification.required catch false;
        if key == "" or map_has(expected, key) {
            throw "configuration inspector: schema contains an empty or duplicate key";
        }
        expected[key] = true;
        let present = map_has(parsed.values, key);
        let sensitive = Config.is_sensitive_key(key);
        let status = "missing-optional";
        let display = "Not set";
        if present {
            display = snapshot.values[key];
            if _valid(parsed.values[key], expected_type) {
                status = "valid";
                valid_count = valid_count + 1;
            } else {
                status = "invalid-type";
                array_push(errors, key + " must be " + expected_type);
            }
        } else if required {
            status = "missing-required";
            array_push(errors, key + " is required");
        }
        array_push(fields, map{ key: key, expected_type: expected_type,
            required: required, present: present, sensitive: sensitive,
            display_value: display, status: status });
    }

    for key in snapshot.keys {
        if not map_has(expected, key) {
            array_push(warnings, key + " is not declared in the schema");
            array_push(fields, map{ key: key, expected_type: "unknown",
                required: false, present: true,
                sensitive: Config.is_sensitive_key(key),
                display_value: snapshot.values[key], status: "unknown" });
        }
    }
    return map{
        format: "pblang.configuration-inspection.v1",
        ok: len(errors) == 0, ready: len(errors) == 0,
        fields: fields, errors: errors, warnings: warnings,
        parsed_entries: parsed.entries, valid_fields: valid_count,
        sensitive_entries: snapshot.redacted_count,
        sensitive_values_exposed: snapshot.sensitive_values_exposed,
        host_environment_access: false, filesystem_access: false, bounded: true
    };
}

fn source_sha256() { return SOURCE_SHA256; }

export schema, sample_dotenv, inspect_text, source_sha256;
