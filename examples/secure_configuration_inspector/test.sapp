let Config = import("stdlib:config.sapp");
let Inspector = import("examples/secure_configuration_inspector/inspector.sapp");
let App = import("examples/secure_configuration_inspector/app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "secure configuration inspector test failed: " + message; }
}

fn record(bundle, name) {
    for item in bundle.records { if item.name == name { return item; } }
    return nil;
}

let data = App.model();
require(data.ready and data.sensitive_entries == 3,
    "sample configuration must validate and classify all sensitive fields");
require(not data.sensitive_values_exposed and not data.host_environment_access
    and not data.filesystem_access and data.bounded,
    "inspection must remain private, inert and bounded");
let serialized = json_stringify(data);
require(str_index_of(serialized, "example-only-value") < 0
    and str_index_of(serialized, "local-development-value") < 0
    and str_index_of(serialized, "postgres://") < 0,
    "report serialization must not contain raw sensitive values");

let missing = Inspector.inspect_text("DEBUG=true\nPORT=8080\n");
require(not missing.ready and len(missing.errors) == 3,
    "required fields must be reported without throwing");
let malformed = Inspector.inspect_text("DEBUG=maybe\nBAD-KEY=x\n");
require(not malformed.ready and len(malformed.errors) > 0,
    "malformed input must fail closed");
let unknown = Inspector.inspect_text(Inspector.sample_dotenv() + "EXTRA_MODE=safe\n");
require(unknown.ready and len(unknown.warnings) == 1,
    "unknown fields must remain visible as warnings");

let tree = App.view(data);
require(UI.validate(tree).ok, "shared UI tree must validate");
let web = UI.compile(tree, map{ target: "web", width: 320, height: 640 });
let native = UI.compile(tree, map{ target: "native", width: 1440, height: 900 });
let android = UI.compile(tree, map{ target: "android", width: 360, height: 720 });
for bundle in [web, native, android] {
    require(record(bundle, "brand") != nil, "brand must render on every target");
    require(record(bundle, "inspection_status") != nil,
        "accessible status must render on every target");
    require(record(bundle, "safe_preview") != nil,
        "redacted preview must render on every target");
    require(record(bundle, "validate") != nil,
        "validation action must render on every target");
}

let preview = UI.preview_web("Configuration Inspector", tree, App.web_options());
require(preview.response.status == 200, "Web preview must return HTTP 200");
require(str_contains(preview.generated.html, "viewport-fit=cover")
    and str_contains(preview.generated.css, "@media(max-width:640px)"),
    "Web preview must be responsive on compact screens");
require(str_index_of(preview.generated.html, "example-only-value") < 0
    and str_index_of(preview.generated.html, "postgres://") < 0,
    "generated Web output must not expose sensitive values");
require(str_index_of(preview.generated.html, "<script src=\"http") < 0
    and str_index_of(preview.generated.html, "<link href=\"http") < 0
    and str_index_of(preview.generated.css, "url(http") < 0,
    "generated Web output must have no remote dependency");
require(Inspector.source_sha256() ==
    "da69a2e4d2ea60dc03ea001f9b971db1ac8116f25db432b948fae3e18d65fbd9",
    "source provenance digest must remain stable");

for source_path in [
    "stdlib/config.sapp",
    "examples/secure_configuration_inspector/inspector.sapp",
    "examples/secure_configuration_inspector/app.sapp",
    "examples/secure_configuration_inspector/main.sapp",
    "examples/secure_configuration_inspector/benchmark.sapp",
    "examples/secure_configuration_inspector/test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated
        and analysis.high == 0,
        "bounded security analysis must pass for " + source_path);
}

let strict = Config.parse_dotenv_strict(Inspector.sample_dotenv());
require(strict.ok and Config.redacted_values(strict.values).redacted_count == 3,
    "example must exercise the shared strict configuration API");

print "secure_configuration_inspector_pass";
