let Config = import("stdlib:config.sapp");

let text = "";
let i = 0;
while i < 192 {
    let key = if num_mod(i, 3) == 0 { "API_KEY_" + str(i) } else { "VALUE_" + str(i) };
    text = text + key + "=sample-" + str(i) + "\n";
    i = i + 1;
}
let parsed = Config.parse_dotenv_strict(text);
if not parsed.ok or parsed.entries != 192 or parsed.sensitive_entries != 64 {
    throw "secure configuration parser benchmark failed";
}
let safe = Config.redacted_values(parsed.values);
if safe.redacted_count != 64 or safe.sensitive_values_exposed {
    throw "secure configuration redaction benchmark failed";
}
print json_stringify(map{
    format: "pblang.example.secure-configuration-benchmark.v1",
    entries: parsed.entries, redacted: safe.redacted_count,
    host_environment_access: false, filesystem_access: false,
    verified: true
});
