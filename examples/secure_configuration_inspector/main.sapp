let App = import("examples/secure_configuration_inspector/app.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn main() {
    let data = App.model();
    let compiled = UI.compile(App.view(data), map{
        target: "native", width: 1280, height: 800
    });
    let result = map{
        format: "pblang.example.secure-configuration-inspector.v1",
        ready: data.ready, fields: len(data.fields),
        sensitive_entries: data.sensitive_entries,
        sensitive_values_exposed: data.sensitive_values_exposed,
        host_environment_access: data.host_environment_access,
        filesystem_access: data.filesystem_access,
        ui_records: len(compiled.records),
        verified: data.ready and not data.sensitive_values_exposed
            and len(compiled.records) > 0
    };
    print json_stringify(result);
    return result.verified;
}

main();
