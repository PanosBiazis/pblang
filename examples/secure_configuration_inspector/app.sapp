let Inspector = import("examples/secure_configuration_inspector/inspector.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn model(text = nil) {
    if text == nil { text = Inspector.sample_dotenv(); }
    return Inspector.inspect_text(text);
}

fn _status_text(data) {
    if data.ready {
        return str(data.valid_fields) + " fields valid; "
            + str(data.sensitive_entries) + " sensitive values protected";
    }
    return str(len(data.errors)) + " configuration errors";
}

fn _safe_preview(data) {
    let lines = [];
    for field in data.fields {
        array_push(lines, field.key + "=" + field.display_value);
    }
    return str_join(lines, "\n");
}

fn view(data) {
    let cards = [];
    for field in data.fields {
        let privacy = if field.sensitive { "Protected" } else { "Visible" };
        array_push(cards, UI.card([
            UI.heading(field.key, map{ name: "field_" + field.key + "_title" }),
            UI.text(field.status, map{ name: "field_" + field.key + "_status" }),
            UI.text(field.display_value, map{ name: "field_" + field.key + "_value" }),
            UI.text(privacy, map{ name: "field_" + field.key + "_privacy" })
        ], map{ name: "field_" + field.key }));
    }
    return UI.screen([
        UI.heading("Configuration Inspector", map{
            name: "brand", accessibility_label: "Configuration Inspector"
        }),
        UI.text(_status_text(data), map{
            name: "inspection_status", accessibility_label: "Configuration status"
        }),
        UI.area(_safe_preview(data), map{
            name: "safe_preview", accessibility_label: "Redacted configuration preview",
            read_only: true, rows: 8
        }),
        UI.button("Validate", UI.action_set_text("inspection_status", _status_text(data)), map{
            name: "validate", accessibility_label: "Validate configuration"
        }),
        UI.grid(cards, map{ name: "field_grid", columns: 3, gap: 12 })
    ], map{ name: "configuration_inspector_root", gap: 16 });
}

fn web_options() {
    return map{
        theme: "light", lang: "en", host: "127.0.0.1", port: 8080,
        width: 1180, height: 820,
        palette: map{
            accent: [0, 116, 103], selected: [194, 65, 12], focus: [0, 92, 170]
        }
    };
}

export model, view, web_options;
