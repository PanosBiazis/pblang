let owned_buffer=[];
fn acquire(){array_push(owned_buffer,7);}
fn perform(){
    if env_get("PBLANG_BUNDLE_DEMO_FAIL")=="1" {
        let invalid=[];
        print invalid[map{}];
    }
    print owned_buffer[0];
}
fn dispose(){owned_buffer=[];print "resources released";}
export acquire,perform,dispose;
