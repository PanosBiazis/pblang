// Acquire only from the explicit initializer; module loading owns no resource.
let buffer=[];
fn acquire() {push(buffer,7);}
fn exercise() {
    for _i 1 {
        let p=map{run:fn(self){return buffer[0];}};
        print (try {p:run()} catch 9);
    }
}
fn release_owned() {array_pop(buffer);print "released";}
export acquire,exercise,release_owned;
