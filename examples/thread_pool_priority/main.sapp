// Stable priority ordering: equal priorities retain submission order.
let P = import("stdlib:thread_pool.sapp");
let pool = P.new_thread_pool(2);
P.submit_priority(pool, fn() { return "background"; }, 1);
P.submit_priority(pool, fn() { return "interactive-first"; }, 10);
P.submit_priority(pool, fn() { return "interactive-second"; }, 10);
print P.run_all(pool).results;
P.shutdown(pool);
// run_parallel preserves collected priority order too; simultaneous callback
// execution is not a strict wall-clock priority schedule or real-time guarantee.
