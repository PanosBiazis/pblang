let Policy = import("stdlib:machine_code_policy.sapp");

let identifiers = ["return-42", "return-100", "add-5-5"];
let rounds = 24; let generated = 0; let bytes = 0; let i = 0;
while i < rounds {
    let j = 0;
    while j < len(identifiers) {
        let report = Policy.verify_blueprint(identifiers[j]);
        if not report.ok { throw "machine code safety benchmark verification failed"; }
        let k = 0;
        while k < len(report.artifacts) {
            bytes = bytes + report.artifacts[k].size; generated = generated + 1; k = k + 1;
        }
        j = j + 1;
    }
    i = i + 1;
}
print json_stringify(map{
    format:"pblang.example.machine-code-safety-benchmark.v1",
    rounds:rounds, artifacts_generated:generated, total_bytes:bytes, verified:true
});
