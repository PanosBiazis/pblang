let Policy = import("stdlib:machine_code_policy.sapp");

let FORMAT = "pblang.example.machine-code-safety-lab.v1";
let SOURCE_SHA256 = [
    "0ca887ce3ab41fc8664a200de95b419f9711b28d43d946c28d1fa8884825d2da",
    "1a91d67f3f912f4abdcb670bd79b3948b69bce2000903b621518bbcf9926e056",
    "58c63cda2f9b1416b25318a0dc77f8fd238b03b20bf2d8fd2b944c8589feaf1f",
    "8eed118fd683246718d6794a3a57bf98f5e30281686003b3e97401f98dd7fa6d",
    "1bffa96b93cbfc3ca9a26ae14b019f1afcff0454192aa59e8cf21ce1eade94ec",
    "7510bf3deac3d1dc6f4684520f7e4821bed1f007c335a85b25b9587288654fdd"
];

fn _profiles() {
    return [
        map{ id:"quick-memory-return", executes_raw_bytes:true, memory_mode:"rwx",
            shell_or_script:true, temporary_executable:false, hex:"48C7C02A000000C3",
            declared_arch:"x86_64", container_arch:"x86_64" },
        map{ id:"dos-com-return", executes_raw_bytes:true, memory_mode:"rx",
            shell_or_script:true, temporary_executable:true, hex:"B02AB44CCD20",
            declared_length:6, declared_arch:"x86", container_arch:"x86",
            claims_exit_code:true, dos_interrupt:0x20 },
        map{ id:"debug-com-return", executes_raw_bytes:true, memory_mode:"rx",
            shell_or_script:true, temporary_executable:true, hex:"B82A00B44CCD21",
            declared_length:8, declared_arch:"x86", container_arch:"x86",
            claims_exit_code:true, dos_interrupt:0x21 },
        map{ id:"handmade-pe-return", executes_raw_bytes:true, memory_mode:"rx",
            shell_or_script:true, temporary_executable:true, hex:"50450000L0101",
            declared_arch:"x86_64", container_arch:"i386" },
        map{ id:"memory-return", executes_raw_bytes:true, memory_mode:"rwx",
            shell_or_script:true, temporary_executable:false, hex:"48C7C02A000000C3",
            declared_arch:"x86_64", container_arch:"x86_64" },
        map{ id:"multiple-return-menu", executes_raw_bytes:true, memory_mode:"rx",
            shell_or_script:true, temporary_executable:true,
            hex:"48C7C005000000488305050000000C3",
            declared_arch:"x86_64", container_arch:"x86_64" }
    ];
}

fn build() {
    let reviews = []; let profiles = _profiles(); let total_findings = 0; let high = 0; let i = 0;
    while i < len(profiles) {
        let reviewed = Policy.review_recipe(profiles[i]);
        array_push(reviews, reviewed); total_findings = total_findings + reviewed.finding_count;
        high = high + reviewed.high; i = i + 1;
    }
    let programs = []; let artifact_points = [];
    for id in ["return-42", "return-100", "add-5-5"] {
        let verified = Policy.verify_blueprint(id); array_push(programs, verified);
        let j = 0;
        while j < len(verified.artifacts) {
            let artifact = verified.artifacts[j];
            array_push(artifact_points, [id + " " + artifact.artifact_format, artifact.size]); j = j + 1;
        }
    }
    return map{
        ok:len(reviews) == 6 and high > 0 and len(programs) == 3,
        format:FORMAT, reviews:reviews, programs:programs,
        source_sha256:SOURCE_SHA256, total_findings:total_findings, high_findings:high,
        artifact_points:artifact_points, implementation_language:"pblang",
        original_source_retained:false, personal_paths_retained:false,
        raw_execution_enabled:false, network_access:false, shell_access:false
    };
}

export FORMAT, SOURCE_SHA256, build;
