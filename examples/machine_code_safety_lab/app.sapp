let Workbench = import("./workbench.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");

fn model() { return Workbench.build(); }

fn view(data) {
    return UI.screen([
        UI.heading("Machine Code Safety Lab", map{
            name:"brand", accessibility_label:"Machine Code Safety Lab"
        }),
        UI.text("Turn historical byte recipes into bounded, portable PBLang artifacts", map{
            name:"subtitle"
        }),
        UI.row([
            UI.card([
                UI.heading("Legacy review", map{ name:"legacy_title" }),
                UI.text(str(len(data.reviews)) + " recipes inspected", map{ name:"legacy_count" }),
                UI.text(str(data.high_findings) + " high-risk mechanics found", map{ name:"legacy_risk" })
            ], map{ name:"legacy_card" }),
            UI.card([
                UI.heading("Safe replacements", map{ name:"replacement_title" }),
                UI.text(str(len(data.programs)) + " declarative programs", map{ name:"replacement_count" }),
                UI.text("DOS COM, Linux ELF, Windows PE", map{ name:"target_summary" })
            ], map{ name:"replacement_card" })
        ], map{ name:"summary_row", responsive:true, gap:12 }),
        UI.grid([
            UI.card([UI.heading("Return 42", map{ name:"return_42_title" }),
                UI.text("Portable oracle + 3 artifacts", map{ name:"return_42_state" })], map{ name:"return_42_card" }),
            UI.card([UI.heading("Return 100", map{ name:"return_100_title" }),
                UI.text("Portable oracle + 3 artifacts", map{ name:"return_100_state" })], map{ name:"return_100_card" }),
            UI.card([UI.heading("Add 5 + 5", map{ name:"add_title" }),
                UI.text("Portable oracle + 3 artifacts", map{ name:"add_state" })], map{ name:"add_card" })
        ], map{ name:"program_grid", columns:3, gap:12 }),
        UI.button("Review migration policy", UI.action_set_text("policy_status",
            "Raw bytes stay disabled; declarative IR is validated before code generation"), map{
            name:"policy_action", accessibility_label:"Review machine code migration policy"
        }),
        UI.text("Ready", map{ name:"policy_status", accessibility_label:"Migration policy status" }),
        UI.text("Foreign artifacts require their named target-host verification; generation is not proof of execution.", map{
            name:"verification_boundary", accessibility_label:"Artifact verification boundary"
        })
    ], map{ name:"machine_code_lab_root", gap:16 });
}

fn visual_scene(data, width = 820, height = 520) {
    let scene = Visual.scene(width, height, map{ title:"Artifact sizes", backend:"portable" });
    Visual.add(scene, Visual.bar_chart("artifact_sizes", data.artifact_points, map{
        title:"Generated bytes by blueprint and target", x_label:"Artifact", y_label:"Bytes",
        color:[0, 112, 102, 255]
    }));
    return scene;
}

fn web_options() {
    return map{
        theme:"light", lang:"en", host:"127.0.0.1", port:8080,
        width:1180, height:820,
        palette:map{ accent:[0,112,102], selected:[190,72,42], focus:[0,84,150] }
    };
}

export model, view, visual_scene, web_options;
