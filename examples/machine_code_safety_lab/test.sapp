let Policy = import("stdlib:machine_code_policy.sapp");
let Workbench = import("./workbench.sapp");
let App = import("./app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) { if not value { throw "machine code safety lab test failed: " + message; } }
fn record(bundle, name) {
    let i = 0; while i < len(bundle.records) {
        if bundle.records[i].name == name { return bundle.records[i]; } i = i + 1;
    } return nil;
}

let data = Workbench.build();
require(data.ok and len(data.reviews) == 6 and len(data.programs) == 3,
    "all six recipes and three normalized programs are represented");
require(data.total_findings >= 20 and data.high_findings >= 10,
    "historical mechanics remain visibly diagnosed");
require(len(data.source_sha256) == 6 and not data.original_source_retained
    and not data.personal_paths_retained, "source identity is content-addressed and privacy safe");
require(not data.raw_execution_enabled and not data.network_access and not data.shell_access,
    "the example exposes no raw execution, network, or shell capability");

let expected = [42, 100, 10]; let i = 0;
while i < len(data.programs) {
    require(data.programs[i].ok and data.programs[i].evaluated == expected[i],
        "portable result is correct for program " + str(i));
    require(len(data.programs[i].artifacts) == 3,
        "every safe program has three target artifacts"); i = i + 1;
}

let tree = App.view(data);
require(UI.validate(tree).ok, "shared UI tree validates");
for bundle in [
    UI.compile(tree, map{ target:"web", width:320, height:640 }),
    UI.compile(tree, map{ target:"native", width:1440, height:900 }),
    UI.compile(tree, map{ target:"android", width:360, height:720 })
] {
    require(record(bundle, "brand") != nil and record(bundle, "legacy_card") != nil
        and record(bundle, "replacement_card") != nil, "summary renders for every target");
    require(record(bundle, "policy_action") != nil and record(bundle, "verification_boundary") != nil,
        "policy action and honest boundary render for every target");
}
let preview = UI.preview_web("Machine Code Safety Lab", tree, App.web_options());
require(preview.response.status == 200 and str_contains(preview.generated.html, "viewport-fit=cover")
    and str_contains(preview.generated.css, "@media(max-width:640px)"),
    "Web preview remains responsive");
require(not str_contains(preview.generated.html, "http://")
    and not str_contains(preview.generated.html, "https://"), "Web preview uses no remote assets");
let visual = Visual.compile(App.visual_scene(data));
require(len(visual.draw) == 1 and len(visual.assets) == 0, "chart stays local and asset free");

for source_path in [
    "../../stdlib/machine_code_policy.sapp", "workbench.sapp", "app.sapp",
    "main.sapp", "benchmark.sapp", "test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{ minimum_blocking_severity:"high" });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
        "bounded security analysis passes for " + source_path);
}

require(Policy.inspect_hex("48C7C02A000000C3").ok, "public strict hex inspector remains available");
print "machine_code_safety_lab_pass";
