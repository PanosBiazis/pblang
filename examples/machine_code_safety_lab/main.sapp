let App = import("./app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");

let data = App.model();
let ui = UI.compile(App.view(data), map{ target:"native", width:1180, height:820 });
let visual = Visual.compile(App.visual_scene(data));
print json_stringify(map{
    format:data.format, verified:data.ok, reviewed_recipes:len(data.reviews),
    safe_programs:len(data.programs), high_findings:data.high_findings,
    artifacts_generated:len(data.artifact_points), ui_records:len(ui.records),
    visual_nodes:len(visual.draw)
});
