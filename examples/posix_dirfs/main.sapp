let DirFS = import("stdlib:posix_dirfs.sapp");

let state = DirFS.available();
print "platform=" + state.platform
    + " available=" + str(state.ok)
    + " openat=" + str(state.component_openat)
    + " nofollow=" + str(state.nofollow)
    + " fallback=" + str(state.pathname_fallback);

if state.ok {
    let root = DirFS.open(".", false);
    if not root.ok { throw root.error; }
    let loaded = DirFS.read_prefix_bytes(root, "pblang.toml", 128);
    DirFS.close(root);
    if not loaded.ok { throw loaded.error; }
    print "source_size=" + str(loaded.source_size)
        + " returned=" + str(len(loaded.bytes))
        + " truncated=" + str(loaded.truncated);
}
