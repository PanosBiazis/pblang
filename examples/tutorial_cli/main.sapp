let os = import("stdlib:os.sapp");

let args = os.args();
let cmd = if len(args) > 0 { args[0] } else { "help" };
let db_file = "notes.txt";

fn read_notes() {
    try {
        return fs_read(db_file);
    } catch e {
        return "";
    }
}

fn write_notes(s) {
    fs_write(db_file, s);
}

if cmd == "add" {
    if len(args) < 2 {
        print "usage: add <note>";
    } else {
        let old = read_notes();
        write_notes(old + args[1] + "\n");
        print "added";
    }
} else if cmd == "list" {
    print read_notes();
} else {
    print "commands: add, list";
}
