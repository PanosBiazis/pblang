// Compile both the entry and its dependency with PBLang. The caller explicitly
// chooses the static-linking profile; no dependency files are opened at runtime.
let OS = import("stdlib:os.sapp");
let Native = import("stdlib:compiler/native_bundle.sapp");
let sources = map{
    "methods": "fn exercise(){for i 2 {let p=map{run:fn(self){return 7;}};print (try {p:run()} catch 9);}} export exercise;"
};
let artifact = Native.compile_bundle(
    "let methods=import /* dependency */ (\"methods\");methods.exercise();",
    fn(name){return try sources[name] catch nil;}
);
let args=OS.script_args();
if len(args) != 1 { throw "usage: native_static_bundle.sapp OUTPUT.pbck"; }
fs_write_bytes(args[0],artifact);
print "static bundle compiled";
