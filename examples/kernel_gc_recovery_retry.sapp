// pblang:target=kernel
// pblang:extern heap_init heap_alloc gc_new gc_set_auto gc_set_threshold gc_alloc gc_set_child gc_add_root gc_remove_root gc_live gc_collections gc_alloc_low_memory gc_alloc_rooted_low_memory kernel_gc_collect_low_memory
// QEMU fixture: prepend heap, gc and gc_low_memory. Exit 85 means success.
fn require(ok) { if not ok { outb(244,1); while 1>0 { hlt(); } } }
fn exhaust(h) { let p=heap_alloc(h,8); while p!=0 { p=heap_alloc(h,8); } require(peek32(h)==0); }
fn trial(threshold, children, rooted) {
    let h=kmalloc(8); let arena=kmalloc(16384); heap_init(h,arena,16384);
    let g=gc_new(h); require(g!=0); gc_set_auto(g,0);
    let first=gc_alloc(g,1); require(first!=0); let last=first; let i=1;
    while i<130 {
        let next=gc_alloc(g,1); require(next!=0 and gc_set_child(last,0,next)==1);
        last=next; i=i+1;
    }
    require(gc_set_child(last,0,first)==1 and gc_add_root(g,first)==1);
    i=0; while i<200 { require(gc_alloc(g,0)!=0); i=i+1; } exhaust(h);
    require(gc_live(g)==330 and peek32(g+36)==512);
    gc_set_threshold(g,threshold); gc_set_auto(g,1);
    let obj=0;
    if rooted==1 { obj=gc_alloc_rooted_low_memory(g,children); }
    else { obj=gc_alloc_low_memory(g,children); }
    // Collection admits the live ring and releases 200 leaves. A second pass
    // before allocation is unnecessary, even when the allocation cannot fit.
    require(gc_collections(g)==1 and peek32(g+44)==1 and peek32(g+4)==1);
    require(peek32(g+8)==threshold and peek32(last+8)==first);
    if children==1000 {
        require(obj==0 and gc_live(g)==130 and peek32(g+12)==0 and peek32(g+24)==1);
    } else {
        require(obj!=0 and gc_live(g)==131 and peek32(g+12)==8 and peek32(obj+4)==0);
        if rooted==1 { require(peek32(g+24)==2 and gc_remove_root(g,obj)==1); }
        else { require(peek32(g+24)==1); }
    }
    // The ordinary policy is back in force on the next, distinct allocation.
    require(gc_alloc(g,0)!=0 and peek32(g+4)==1);
    if threshold==0 { require(gc_collections(g)==2); }
    else { require(gc_collections(g)==1); }
    require(gc_remove_root(g,first)==1 and kernel_gc_collect_low_memory(g)==0 and gc_live(g)==0);
}
// Root publication can fail after the recovered object itself fits. Policy and
// the one remaining free block must survive every rollback.
fn rollback_trial() {
    let h=kmalloc(8); let arena=kmalloc(16384); heap_init(h,arena,16384);
    let g=gc_new(h); require(g!=0); gc_set_auto(g,0);
    let first=gc_alloc(g,1); require(first!=0); let last=first; let i=1;
    while i<129 { let next=gc_alloc(g,1); require(next!=0); gc_set_child(last,0,next); last=next; i=i+1; }
    gc_set_child(last,0,first); i=0;
    while i<64 { require(gc_add_root(g,first)==1); i=i+1; }
    require(gc_alloc(g,0)!=0); exhaust(h); gc_set_threshold(g,0); gc_set_auto(g,1);
    i=0;
    while i<100 {
        require(gc_alloc_rooted_low_memory(g,0)==0 and peek32(g+4)==1);
        require(gc_live(g)==129 and peek32(g+24)==64 and gc_collections(g)==1);
        let block=peek32(h); require(block!=0 and peek32(block)==16 and peek32(block+4)==0);
        i=i+1;
    }
    require(gc_remove_root(g,first)==64 and kernel_gc_collect_low_memory(g)==0 and gc_live(g)==0);
}
fn kmain() {
    let rooted=0;
    while rooted<2 {
        trial(0,0,rooted); trial(-1,0,rooted); trial(1000000,0,rooted);
        trial(0,1000,rooted); trial(-1,1000,rooted); trial(1000000,1000,rooted);
        rooted=rooted+1;
    }
    rollback_trial();
    outb(244,42); while 1>0 { hlt(); }
}
