let O=import("stdlib:db_owned.sapp");
let D=import("stdlib:db.sapp");
// Trusted synchronous work; only this connection is closed at callback return.
let answer=O.with_sqlite(":memory:",fn(c){
    c.exec("create table values_table(v integer)",[]);
    c.exec("insert into values_table values (?)",[42]);
    return D.query_value(c,"select v from values_table",[]);
});
print answer;
