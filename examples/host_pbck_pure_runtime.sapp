let VM = import("stdlib:host_pbck_vm.sapp");

// A host-PBCK program can use deterministic runtime services without receiving
// filesystem, process, network, graphics, clock or entropy capabilities.
let program = map{
    format: "host-pbck-v1", version: 1,
    chunk: map{
        instructions: [
            map{ op: 14, operand: 0 }, map{ op: 0, operand: 1 },
            map{ op: 31, operand: 1 }, map{ op: 16, operand: 2 },
            map{ op: 33 }
        ],
        constants: ["json_parse", "{\"ready\":true}", "ready"],
        source_name: "host_pbck_pure_runtime"
    }
};

let result = VM.run_decoded(program, map{
    max_steps: 64,
    max_collection_items: 64
});
print json_stringify(map{
    value: result.value,
    host_calls: result.runtime.host_calls,
    steps: result.runtime.steps
});
