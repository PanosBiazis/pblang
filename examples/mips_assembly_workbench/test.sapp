let Workbench = import("./workbench.sapp");
let App = import("./app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "mips assembly workbench test failed: " + message; }
}

fn record(bundle, name) {
    for item in bundle.records { if item.name == name { return item; } }
    return nil;
}

let data = Workbench.build();
require(data.ok and len(data.cases) == 3, "all three migrated behavior cases must pass");
require(data.cases[0].result.execution.memory["0"] == 25,
    "arithmetic source must store 25 at address zero");
require(data.cases[1].observed_value == 0,
    "zero-initialized register addition must preserve source behavior");
require(data.cases[2].observed_value == 9
    and len(data.cases[2].result.assembled.warnings) == 4,
    "legacy source must normalize four shorthand instructions visibly");
require(data.source_sha256 == [
    "2d298d1e275f1ca4db8616fdff47f354e48828b40ce78c7843d2ace2be8baedd",
    "d80834c62f383d6692503e5bff92d1cd4ca73b479d982fc80ac59ee1ccf4656f",
    "f16055175eb42dc82ba4bc27020fcd12771231e1ff477626a792a6c43f03892a"
], "source identity must be content-addressed");
require(not data.source_text_persisted and not data.network_access
    and not data.process_execution and len(data.foreign_dependencies) == 0,
    "normal operation must remain local and PBLang-only");

let tree = App.view(data);
require(UI.validate(tree).ok, "shared UI tree must validate");
for bundle in [
    UI.compile(tree, map{ target: "web", width: 320, height: 640 }),
    UI.compile(tree, map{ target: "native", width: 1440, height: 900 }),
    UI.compile(tree, map{ target: "android", width: 360, height: 720 })
] {
    require(record(bundle, "brand") != nil and record(bundle, "case_status") != nil,
        "brand and accessible status must render on every target");
    require(record(bundle, "select_arithmetic") != nil
        and record(bundle, "select_register_add") != nil and record(bundle, "select_legacy") != nil,
        "case controls must render on every target");
    require(record(bundle, "encoding_card") != nil and record(bundle, "execution_card") != nil
        and record(bundle, "isolation_card") != nil,
        "encoding, execution and isolation evidence must remain visible");
}
let preview = UI.preview_web("MIPS Assembly Workbench", tree, App.web_options());
require(preview.response.status == 200
    and str_contains(preview.generated.html, "viewport-fit=cover")
    and str_contains(preview.generated.css, "@media(max-width:640px)"),
    "Web preview must be responsive on compact screens");
require(not str_contains(preview.generated.html, "http://")
    and not str_contains(preview.generated.html, "https://"),
    "Web preview must have no remote dependency");
let visual = Visual.compile(App.visual_scene(data, 720, 520));
require(len(visual.draw) == 1 and len(visual.assets) == 0,
    "register chart must be a local asset-free visual plan");

for source_path in [
    "../../stdlib/emulator_mips32.sapp", "../../stdlib/mips_assembly.sapp",
    "workbench.sapp", "app.sapp", "main.sapp", "benchmark.sapp", "test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
        "bounded security analysis must pass for " + source_path);
}

print "mips_assembly_workbench_pass";
