let Workbench = import("./workbench.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");

fn model() { return Workbench.build(); }

fn view(data) {
    return UI.screen([
        UI.heading("MIPS Assembly Workbench", map{
            name: "brand", accessibility_label: "MIPS Assembly Workbench"
        }),
        UI.text("Parse, encode and execute a bounded MIPS32 subset locally", map{
            name: "subtitle"
        }),
        UI.row([
            UI.button("Arithmetic", UI.action_set_text("case_status",
                "Arithmetic/store case verified"), map{
                name: "select_arithmetic", accessibility_label: "Select arithmetic and store case"
            }),
            UI.button("Register add", UI.action_set_text("case_status",
                "Register-add case verified"), map{
                name: "select_register_add", accessibility_label: "Select register addition case"
            }),
            UI.button("Legacy", UI.action_set_text("case_status",
                "Legacy shorthand normalized with warnings"), map{
                name: "select_legacy", accessibility_label: "Select legacy shorthand case"
            })
        ], map{ name: "case_controls", responsive: true, gap: 8 }),
        UI.text("Ready", map{
            name: "case_status", accessibility_label: "Assembly case status"
        }),
        UI.grid([
            UI.card([
                UI.heading("Encoding"),
                UI.text(str(data.cases[0].result.assembled.instruction_count) + " words"),
                UI.text("Real 32-bit instruction encoding")
            ], map{ name: "encoding_card" }),
            UI.card([
                UI.heading("Execution"),
                UI.text(str(data.cases[0].result.execution.instructions) + " instructions"),
                UI.text(str(data.cases[0].result.execution.memory_writes) + " memory write")
            ], map{ name: "execution_card" }),
            UI.card([
                UI.heading("Isolation"),
                UI.text("No external assembler"),
                UI.text("No process or network access")
            ], map{ name: "isolation_card" })
        ], map{ name: "summary_grid", columns: 3, gap: 12 }),
        UI.text("Supported subset: " + str_join(data.supported_subset, ", "), map{
            name: "subset_boundary", accessibility_label: "Supported MIPS instruction subset"
        }),
        UI.text("Labels, directives, macros, binaries and complete operating-system ABIs are not claimed.", map{
            name: "unsupported_boundary", accessibility_label: "Unsupported assembly features"
        })
    ], map{ name: "mips_workbench_root", gap: 16 });
}

fn visual_scene(data, width = 960, height = 560) {
    let scene = Visual.scene(width, height, map{
        title: "MIPS register state", backend: "portable"
    });
    Visual.add(scene, Visual.bar_chart("register_values", data.register_points, map{
        title: "Selected register values", x_label: "Register", y_label: "Unsigned value",
        color: [0, 116, 112, 255]
    }));
    return scene;
}

fn web_options() {
    return map{
        theme: "light", lang: "en", host: "127.0.0.1", port: 8080,
        width: 1180, height: 820,
        palette: map{
            accent: [0, 116, 112], selected: [188, 67, 36], focus: [0, 90, 156]
        }
    };
}

export model, view, visual_scene, web_options;
