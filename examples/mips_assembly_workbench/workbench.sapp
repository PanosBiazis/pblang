let Assembly = import("stdlib:mips_assembly.sapp");

let FORMAT = "pblang.example.mips-assembly-workbench.v1";
let SOURCE_SHA256 = [
    "2d298d1e275f1ca4db8616fdff47f354e48828b40ce78c7843d2ace2be8baedd",
    "d80834c62f383d6692503e5bff92d1cd4ca73b479d982fc80ac59ee1ccf4656f",
    "f16055175eb42dc82ba4bc27020fcd12771231e1ff477626a792a6c43f03892a"
];

fn _case(id, title, source, options, expected_register, expected_value) {
    let result = Assembly.execute(source, options);
    let observed = nil;
    if result.ok { observed = result.execution.registers[expected_register]; }
    return map{
        id: id, title: title, ok: result.ok, result: result,
        expected_register: expected_register, expected_value: expected_value,
        observed_value: observed,
        verified: result.ok and observed == expected_value
    };
}

fn build() {
    let arithmetic = _case("arithmetic-store", "Arithmetic and aligned store",
        "addi $t0,$t0,10\naddi $t1,$t1,15\nadd $s0,$t0,$t1\n"
            + "sw $s0,0x0($t2)\nadd $s2,$s0,$t2\n",
        map{}, 18, 25);
    let register_add = _case("register-add", "Canonical register addition",
        "add $s0,$s1,$s2\n", map{}, 16, 0);
    let legacy = _case("legacy-shorthand", "Explicit legacy normalization",
        "addi $s0,4\naddi $s1,5\naddi $s2,10\naddi $s3,$zero\nadd $s3,$s0,$s1\n",
        map{ legacy_shorthand: true }, 19, 9);
    let cases = [arithmetic, register_add, legacy];
    let verified = true;
    let case_index = 0;
    while case_index < len(cases) {
        if not cases[case_index].verified { verified = false; }
        case_index = case_index + 1;
    }
    let register_points = [];
    for index in [8, 9, 16, 18] {
        array_push(register_points, [index, arithmetic.result.execution.registers[index]]);
    }
    return map{
        ok: verified, format: FORMAT, cases: cases,
        register_points: register_points,
        source_sha256: SOURCE_SHA256, implementation_language: "pblang",
        foreign_dependencies: [], source_text_persisted: false,
        network_access: false, process_execution: false,
        supported_subset: ["ADD", "ADDU", "ADDI", "ADDIU", "SW", "NOP", "SYSCALL"]
    };
}

export FORMAT, SOURCE_SHA256, build;
