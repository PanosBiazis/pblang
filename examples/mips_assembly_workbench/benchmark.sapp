let Assembly = import("stdlib:mips_assembly.sapp");

fn main() {
    let lines = [];
    let count = 512;
    let index = 0;
    while index < count {
        array_push(lines, "addiu $t0,$t0,1");
        index = index + 1;
    }
    let source = str_join(lines, "\n");
    let result = Assembly.execute(source, map{
        max_source_chars: 32768, max_lines: 1024, max_instructions: 1024,
        instruction_budget: 1024
    });
    let report = map{
        format: "pblang.example.mips-assembly-benchmark.v1",
        source_lines: count, encoded_words: result.assembled.instruction_count,
        executed: result.execution.instructions, final_t0: result.execution.registers[8],
        verified: result.ok and result.execution.registers[8] == count
    };
    print json_stringify(report);
    return report.verified;
}

main();
