let App = import("./app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");

fn main() {
    let data = App.model();
    let ui = UI.compile(App.view(data), map{ target: "native", width: 1280, height: 800 });
    let visual = Visual.compile(App.visual_scene(data));
    let result = map{
        format: data.format, cases: len(data.cases),
        encoded_words: data.cases[0].result.assembled.instruction_count,
        memory_writes: data.cases[0].result.execution.memory_writes,
        ui_records: len(ui.records), visual_nodes: len(visual.draw),
        verified: data.ok and len(ui.records) > 0 and len(visual.draw) == 1
    };
    print json_stringify(result);
    return result.verified;
}

main();
