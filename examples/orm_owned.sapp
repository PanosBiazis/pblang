let Owned=import("stdlib:db_owned.sapp");
let ORM=import("stdlib:orm.sapp");
// Trusted synchronous callback: the connection closes after this returns.
let result=Owned.with_sqlite(":memory:",fn(c){
    ORM.define_model(c,"items",["id INTEGER PRIMARY KEY","name TEXT"]);
    ORM.insert(c,"items",map{id:1,name:"first"});
    ORM.upsert(c,"items",map{id:1,name:"updated"});
    return ORM.find(c,"items",map{order:"id DESC",limit:1})[0].name;
});
print result;
