// Build and run this fixed numeric example through the hosted C99 backend.
// Requires a local C compiler and the bounded `timeout` runner.
let C = import("stdlib:compiler/ctranspile.sapp");
let source = "let order=0; let a=[0]; "
    + "fn target(){order=order*10+1;return a;} "
    + "fn slot(){order=order*10+2;return 0;} "
    + "fn value(){order=order*10+3;return 42;} "
    + "let result=(target()[slot()]=value()); print order; print result; print a[0];";
let result = C.run_program(source, map{profile:"portable", timeout_ms:5000});
if not result.ok { throw "C99 example failed; inspect the compiler/runner setup"; }
assert(result.stdout == "123\n42\n42\n", "assignment sequence and result");
print result.stdout;
