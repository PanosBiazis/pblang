let Astronomy = import("stdlib:astronomy.sapp");

let FORMAT = "pblang.example.solar-daylight-planner.v1";
let MIGRATED_SOURCE_SHA256 = "a294387c416b714c2d7335e505656ed99a651b9c315e0d4818b732c4490b02c1";

fn build(year = 2024, latitude = 35, longitude = 0, utc_offset_minutes = 0,
    step_days = 7) {
    let observer = Astronomy.location(latitude, longitude, utc_offset_minutes);
    let series = Astronomy.year_series(year, observer, step_days);
    let sunrise_points = [];
    let sunset_points = [];
    let event_points = [];
    for row in series.samples {
        if row.status == "normal" {
            array_push(sunrise_points, [row.ordinal, row.sunrise.minute]);
            array_push(sunset_points, [row.ordinal, row.sunset.minute]);
            array_push(event_points, [row.ordinal, 0, row.sunrise.minute]);
            array_push(event_points, [row.ordinal, 1, row.sunset.minute]);
        }
    }
    return map{
        ok: true, format: FORMAT, series: series,
        sunrise_points: sunrise_points, sunset_points: sunset_points,
        event_points_3d: event_points, capabilities: Astronomy.capabilities(),
        original_source_sha256: MIGRATED_SOURCE_SHA256,
        implementation_language: "pblang", foreign_dependencies: [],
        coordinates_persisted: false, network_access: false
    };
}

export FORMAT, MIGRATED_SOURCE_SHA256, build;
