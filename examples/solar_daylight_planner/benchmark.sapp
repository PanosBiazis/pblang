let Astronomy = import("stdlib:astronomy.sapp");

let observer = Astronomy.location(35, 0, 0);
let checksum = 0;
let years = 16;
let year = 2000;
while year < 2000 + years {
    let series = Astronomy.year_series(year, observer, 1);
    checksum = checksum + series.sample_count
        + num_floor(series.maximum_daylight_minutes - series.minimum_daylight_minutes);
    year = year + 1;
}
if checksum <= 0 { throw "solar daylight benchmark failed"; }
print json_stringify(map{
    format: "pblang.example.solar-daylight-benchmark.v1",
    years: years, daily_events: 5844, checksum: checksum,
    network_access: false, verified: true
});
