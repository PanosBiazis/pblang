let App = import("examples/solar_daylight_planner/app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");

fn main() {
    let data = App.model();
    let ui = UI.compile(App.view(data), map{ target: "native", width: 1280, height: 800 });
    let visual = Visual.compile(App.visual_scene(data));
    let result = map{
        format: data.format, samples: data.series.sample_count,
        sunrise_points: len(data.sunrise_points), sunset_points: len(data.sunset_points),
        visual_nodes: len(visual.draw), ui_records: len(ui.records),
        verified: data.series.sample_count > 0 and len(data.sunrise_points) > 0
            and len(visual.draw) == 3 and len(ui.records) > 0
    };
    print json_stringify(result);
    return result.verified;
}

main();
