let Planner = import("examples/solar_daylight_planner/solar_planner.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");
let Math = import("stdlib:math.sapp");

fn model() { return Planner.build(); }

fn _hours(minutes) { return Math.round_to(minutes / 60, 2); }

fn view(data) {
    let series = data.series;
    return UI.screen([
        UI.heading("Solar Daylight Planner", map{
            name: "brand", accessibility_label: "Solar daylight planner"
        }),
        UI.text("Deterministic local solar planning", map{ name: "subtitle" }),
        UI.text("Ready", map{
            name: "planner_status", accessibility_label: "Planner status"
        }),
        UI.row([
            UI.card([
                UI.heading("Longest sampled day", map{ name: "longest_title" }),
                UI.text(series.longest.date_text, map{ name: "longest_date" }),
                UI.text(str(_hours(series.maximum_daylight_minutes)) + " hours", map{
                    name: "longest_duration"
                })
            ], map{ name: "longest_card" }),
            UI.card([
                UI.heading("Shortest sampled day", map{ name: "shortest_title" }),
                UI.text(series.shortest.date_text, map{ name: "shortest_date" }),
                UI.text(str(_hours(series.minimum_daylight_minutes)) + " hours", map{
                    name: "shortest_duration"
                })
            ], map{ name: "shortest_card" }),
            UI.card([
                UI.heading("Coverage", map{ name: "coverage_title" }),
                UI.text(str(series.sample_count) + " bounded samples", map{ name: "sample_count" }),
                UI.text("Solar rise, noon and set", map{ name: "event_coverage" })
            ], map{ name: "coverage_card" })
        ], map{ name: "summary_row", responsive: true, gap: 12 }),
        UI.row([
            UI.button("Sunrise", UI.action_set_text("planner_status", "Sunrise series selected"), map{
                name: "select_sunrise", accessibility_label: "Select sunrise series"
            }),
            UI.button("Sunset", UI.action_set_text("planner_status", "Sunset series selected"), map{
                name: "select_sunset", accessibility_label: "Select sunset series"
            }),
            UI.button("3D events", UI.action_set_text("planner_status", "3D event plan selected"), map{
                name: "select_3d", accessibility_label: "Select three dimensional event plan"
            })
        ], map{ name: "view_controls", responsive: true, gap: 8 }),
        UI.text("Lunar rise and set require a separately verified ephemeris.", map{
            name: "lunar_boundary", accessibility_label: "Lunar calculation boundary"
        }),
        UI.text("Coordinates stay in memory and are never sent or stored.", map{
            name: "privacy_boundary", accessibility_label: "Coordinate privacy boundary"
        })
    ], map{ name: "solar_planner_root", gap: 16 });
}

fn visual_scene(data, width = 960, height = 600) {
    let scene = Visual.scene(width, height, map{
        title: "Solar Daylight Planner", backend: "portable"
    });
    Visual.add(scene, Visual.line_chart("sunrise_series", data.sunrise_points, map{
        title: "Sunrise", x_label: "Day of year", y_label: "Local minute",
        color: [231, 119, 36, 255]
    }));
    Visual.add(scene, Visual.line_chart("sunset_series", data.sunset_points, map{
        title: "Sunset", x_label: "Day of year", y_label: "Local minute",
        color: [0, 112, 121, 255]
    }));
    Visual.add(scene, Visual.scatter3d("solar_events_3d", data.event_points_3d, map{
        title: "Solar events", x_label: "Day", y_label: "Event", color: [77, 87, 171, 255]
    }));
    return scene;
}

fn web_options() {
    return map{
        theme: "light", lang: "en", host: "127.0.0.1", port: 8080,
        width: 1180, height: 820,
        palette: map{
            accent: [0, 112, 121], selected: [190, 68, 25], focus: [0, 86, 158]
        }
    };
}

export model, view, visual_scene, web_options;
