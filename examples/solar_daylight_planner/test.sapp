let Astronomy = import("stdlib:astronomy.sapp");
let Planner = import("examples/solar_daylight_planner/solar_planner.sapp");
let App = import("examples/solar_daylight_planner/app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "solar daylight planner test failed: " + message; }
}

fn record(bundle, name) {
    for item in bundle.records { if item.name == name { return item; } }
    return nil;
}

let data = Planner.build();
require(data.series.sample_count == 53 and len(data.sunrise_points) == 53
    and len(data.sunset_points) == 53 and len(data.event_points_3d) == 106,
    "weekly reference series must be complete and deterministic");
require(data.original_source_sha256 ==
    "a294387c416b714c2d7335e505656ed99a651b9c315e0d4818b732c4490b02c1",
    "source identity must be content-addressed");
require(len(data.foreign_dependencies) == 0 and not data.network_access
    and not data.coordinates_persisted, "normal execution must be local and private");
require(data.capabilities.solar_rise_set and not data.capabilities.lunar_rise_set,
    "capability report must distinguish implemented solar and deferred lunar events");

let scene = App.visual_scene(data, 320, 480);
let visual = Visual.compile(scene);
require(len(visual.draw) == 3 and len(visual.assets) == 0,
    "2D and 3D visual plans must be local and asset-free");

let tree = App.view(data);
require(UI.validate(tree).ok, "shared UI tree must validate");
for bundle in [
    UI.compile(tree, map{ target: "web", width: 320, height: 640 }),
    UI.compile(tree, map{ target: "native", width: 1440, height: 900 }),
    UI.compile(tree, map{ target: "android", width: 360, height: 720 })
] {
    require(record(bundle, "brand") != nil and record(bundle, "planner_status") != nil,
        "brand and accessible status must render on every target");
    require(record(bundle, "select_sunrise") != nil and record(bundle, "select_sunset") != nil
        and record(bundle, "select_3d") != nil, "view controls must render on every target");
    require(record(bundle, "lunar_boundary") != nil and record(bundle, "privacy_boundary") != nil,
        "accuracy and privacy boundaries must remain visible");
}
let preview = UI.preview_web("Solar Daylight Planner", tree, App.web_options());
require(preview.response.status == 200
    and str_contains(preview.generated.html, "viewport-fit=cover")
    and str_contains(preview.generated.css, "@media(max-width:640px)"),
    "Web preview must be responsive on compact screens");
require(not str_contains(preview.generated.html, "http://")
    and not str_contains(preview.generated.html, "https://"),
    "Web preview must have no remote dependency");

let polar = Astronomy.year_series(2024, Astronomy.location(70, 0, 0), 7);
let has_polar = false;
for row in polar.samples { if row.status != "normal" { has_polar = true; } }
require(has_polar, "planner library must preserve polar states in series data");

for source_path in [
    "stdlib/astronomy.sapp",
    "examples/solar_daylight_planner/solar_planner.sapp",
    "examples/solar_daylight_planner/app.sapp",
    "examples/solar_daylight_planner/main.sapp",
    "examples/solar_daylight_planner/benchmark.sapp",
    "examples/solar_daylight_planner/test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
        "bounded security analysis must pass for " + source_path);
}

print "solar_daylight_planner_pass";
