let App = import("examples/favorite_moments_card/app.sapp");
let UI = import("stdlib:modern_ui.sapp");

let OUTPUT = "examples/favorite_moments_card/build/web";
let result = UI.export_web(App.APP_NAME, App.view(), OUTPUT, App.web_options());

fs_mkdirs(OUTPUT + "/assets");
fs_write_bytes(
OUTPUT + "/assets/favorite-moment.png",
fs_read_bytes("examples/favorite_moments_card/assets/favorite-moment.png")
);
fs_write_bytes(
OUTPUT + "/assets/open-source-mark.png",
fs_read_bytes("examples/favorite_moments_card/assets/open-source-mark.png")
);

print "site=" + result.output + "/index.html";
print "digest=" + result.digest;
print "nodes=" + str(result.generated.nodes);
print "actions=" + str(result.generated.actions);
