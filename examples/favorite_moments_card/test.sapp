let App = import("examples/favorite_moments_card/app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "favorite_moments_card test failed: " + message; }
}

fn record(bundle, name) {
    for item in bundle.records {
        if item.name == name { return item; }
    }
    return nil;
}

let view = App.view();
let validation = UI.validate(view);
require(validation.ok, "view contract must validate");

let phone = UI.compile(view, map{ target: "web", width: 320, height: 568 });
let desktop = UI.compile(view, map{ target: "web", width: 1440, height: 900 });
for bundle in [phone, desktop] {
    require(record(bundle, "favorite_photo") != nil, "favorite photo must render");
    require(record(bundle, "open_source_mark") != nil, "open-source mark must render");
    require(record(bundle, "like_button") != nil, "like action must render");
    require(record(bundle, "post_button") != nil, "post action must render");
    require(record(bundle, "accept_button") != nil, "accept action must render");
    require(record(bundle, "learn_button") != nil, "learn action must render");
}

let preview = UI.preview_web(App.APP_NAME, view, App.web_options());
let html = preview.generated.html;
let css = preview.generated.css;
require(preview.response.status == 200, "web preview must return HTTP 200");
require(preview.generated.actions == 7, "all portable actions must be generated");
require(str_contains(html, "<meta charset=\"utf-8\">"), "output must declare UTF-8");
require(str_contains(html, "viewport-fit=cover"), "output must be viewport-aware");
require(str_contains(html, App.HERO_ASSET), "favorite image must use a local relative path");
require(str_contains(html, App.MARK_ASSET), "provided image must use a local relative path");
require(str_contains(html, "aria-live=\"polite\""), "status updates must be accessible");
require(str_contains(css, "@media(max-width:640px)"), "mobile responsive rules must exist");
require(str_contains(css, "letter-spacing:0"), "text spacing must remain stable");
require(not str_contains(html, "/run/media/"), "legacy personal media path must not leak");
require(not str_contains(html, "/media/"), "personal workspace path must not leak");
require(not str_contains(html, "/home/"), "personal home path must not leak");

let hero = fs_read_bytes("examples/favorite_moments_card/assets/favorite-moment.png");
let mark = fs_read_bytes("examples/favorite_moments_card/assets/open-source-mark.png");
require(len(hero) > 10000, "favorite image asset must be present");
require(len(mark) == 12964, "provided image asset must be copied exactly");
require(hero[0] == 137 and hero[1] == 80 and hero[2] == 78 and hero[3] == 71,
"favorite image must be PNG");
require(mark[0] == 137 and mark[1] == 80 and mark[2] == 78 and mark[3] == 71,
"provided image must be PNG");

for source_path in [
"examples/favorite_moments_card/app.sapp",
"examples/favorite_moments_card/main.sapp",
"examples/favorite_moments_card/test.sapp"
] {
    let report = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(report.ok and report.passed and not report.truncated and report.high == 0,
    "bounded security analysis must pass for " + source_path);
}

print "favorite_moments_card_pass";
