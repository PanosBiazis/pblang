// Responsive PBLang-only remake of a small one-file HTML exercise.

let UI = import("stdlib:modern_ui.sapp");

let APP_NAME = "Favorite Moments";
let ORIGINAL_SHA256 = "5b27beb48bad672875787ee8c2274303102ea8dc6f1d4955b43a2be67d31ec17";
let HERO_ASSET = "./assets/favorite-moment.png";
let MARK_ASSET = "./assets/open-source-mark.png";

fn view() {
    let like_action = UI.action_sequence([
    UI.action_set_text("like_status", "Saved to your favorite moments."),
    UI.action_message("Moment liked")
    ]);
    let post_action = UI.action_sequence([
    UI.action_set_text("post_status", "Your post is ready to share."),
    UI.action_message("Post prepared")
    ]);
    let accept_action = UI.action_sequence([
    UI.action_set_text("connection_status", "Connection accepted."),
    UI.action_message("Connection accepted")
    ]);

    return UI.screen([
    UI.column([
    UI.heading(APP_NAME, map{
        name: "page_title",
        accessibility_label: "Favorite Moments example"
    }),
    UI.text("A small, private-by-default place for the little things worth sharing.", map{
        name: "page_summary"
    })
    ], map{ name: "page_header", gap: 8 }),

    UI.grid([
    UI.image(nil, map{
        name: "favorite_photo",
        src: HERO_ASSET,
        accessibility_label: "A tabby cat beside rain-covered roses, a copper kettle, and wool mittens",
        min_h: 220
    }),
    UI.card([
    UI.heading("Little things", map{ name: "little_things_title" }),
    UI.text("Raindrops on roses, whiskers on kittens, bright copper kettles, and warm woolen mittens.", map{
        name: "favorite_things"
    }),
    UI.separator(),
    UI.row([
    UI.button("Like", like_action, map{
        name: "like_button",
        accessibility_label: "Like this favorite moment"
    }),
    UI.button("Post", post_action, map{
        name: "post_button",
        accessibility_label: "Prepare this moment for sharing"
    })
    ], map{ name: "sharing_actions", responsive: true }),
    UI.text("Not yet saved.", map{
        name: "like_status",
        accessibility_label: "Like status"
    }),
    UI.text("No post prepared.", map{
        name: "post_status",
        accessibility_label: "Post status"
    })
    ], map{ name: "favorite_card", title: "My favourite things" })
    ], map{ name: "favorite_grid", columns: 2, gap: 16 }),

    UI.card([
    UI.row([
    UI.image(nil, map{
        name: "open_source_mark",
        src: MARK_ASSET,
        accessibility_label: "Open-source cat silhouette mark",
        min_w: 96,
        min_h: 96,
        max_w: 180,
        max_h: 180
    }),
    UI.column([
    UI.heading("Connect and learn", map{ name: "connect_title" }),
    UI.text("Choose the three letter tiles, accept the connection, and continue learning with code.", map{
        name: "connect_help"
    }),
    UI.row([
    UI.button("D", UI.action_set_text("letter_status", "D selected"), map{
        name: "letter_d",
        accessibility_label: "Select letter D"
    }),
    UI.button("O", UI.action_set_text("letter_status", "O selected"), map{
        name: "letter_o",
        accessibility_label: "Select letter O"
    }),
    UI.button("G", UI.action_set_text("letter_status", "G selected"), map{
        name: "letter_g",
        accessibility_label: "Select letter G"
    })
    ], map{ name: "letter_tiles", responsive: false }),
    UI.text("Choose a letter.", map{
        name: "letter_status",
        accessibility_label: "Selected letter"
    }),
    UI.row([
    UI.button("Accept", accept_action, map{
        name: "accept_button",
        accessibility_label: "Accept the connection"
    }),
    UI.button("Learn", UI.action_message("Keep learning with PBLang"), map{
        name: "learn_button",
        accessibility_label: "Learn to code with PBLang"
    })
    ], map{ name: "connection_actions", responsive: true }),
    UI.text("Waiting for approval.", map{
        name: "connection_status",
        accessibility_label: "Connection status"
    })
    ], map{ name: "connect_content", grow: 1 })
    ], map{ name: "connect_row", responsive: true })
    ], map{ name: "connect_card" })
    ], map{ name: "root" });
}

fn web_options() {
    return map{
        theme: "light",
        lang: "en",
        host: "127.0.0.1",
        port: 8080,
        width: 1120,
        height: 800,
        source_sha256: ORIGINAL_SHA256
    };
}

export APP_NAME, ORIGINAL_SHA256, HERO_ASSET, MARK_ASSET, view, web_options;
