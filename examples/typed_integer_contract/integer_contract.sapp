// Exact, language-neutral integer contracts implemented only in PBLang.

let I32_MIN = bigint("-2147483648");
let I32_MAX = bigint("2147483647");
let U64_MAX = bigint("18446744073709551615");
let MAX_SAFE_NUMBER = bigint("9007199254740991");

fn source_set_sha256() {
    return "f711457358b8ab5ed3439a39e5e5310daf27ff2112dd65d56bae9c4a8e1d172c";
}

fn _decimal_text(value, label, allow_negative, max_digits) {
    let text = str_trim(str(value));
    if text == "" { throw label + " must not be empty"; }
    let start = 0;
    if text[0..1] == "-" {
        if not allow_negative { throw label + " must be unsigned"; }
        start = 1;
    }
    if start == len(text) { throw label + " must contain decimal digits"; }
    if len(text) - start > max_digits { throw label + " exceeds the decimal digit limit"; }
    let i = start;
    while i < len(text) {
        if str_index_of("0123456789", text[i..(i + 1)]) < 0 {
            throw label + " must use ASCII base-10 digits";
        }
        i = i + 1;
    }
    return text;
}

fn _exact_integer(value, label, allow_negative, max_digits) {
    if type(value) == "bigint" {
        return bigint(_decimal_text(str(value), label, allow_negative, max_digits));
    }
    if is_number(value) {
        if num_floor(value) != value { throw label + " must be an exact integer"; }
        let magnitude = value;
        if value < 0 { magnitude = -value; }
        if bigint(magnitude) > MAX_SAFE_NUMBER {
            throw label + " numeric value is not transport-safe; use a decimal string";
        }
        return bigint(value);
    }
    if type(value) == "string" {
        return bigint(_decimal_text(value, label, allow_negative, max_digits));
    }
    throw label + " must be an integer number, bigint, or decimal string";
}

fn sum_i32_as_string(a, b) {
    let left = _exact_integer(a, "a", true, 10);
    let right = _exact_integer(b, "b", true, 10);
    if left < I32_MIN or left > I32_MAX { throw "a is outside the i32 range"; }
    if right < I32_MIN or right > I32_MAX { throw "b is outside the i32 range"; }
    let result = left + right;
    if result < I32_MIN or result > I32_MAX { throw "i32 addition overflow"; }
    return str(result);
}

fn add_u64(left_value, right_value) {
    let left = _exact_integer(left_value, "left", false, 20);
    let right = _exact_integer(right_value, "right", false, 20);
    if left < bigint(0) or left > U64_MAX { throw "left is outside the u64 range"; }
    if right < bigint(0) or right > U64_MAX { throw "right is outside the u64 range"; }
    let result = left + right;
    if result > U64_MAX { throw "u64 addition overflow"; }
    return str(result);
}

fn describe() {
    return map{
        format: "pblang.example.typed-integer-contract.v1",
        source_sha256: source_set_sha256(),
        operations: [
            map{
                name: "sum_i32_as_string",
                arguments: ["i32", "i32"],
                result: "decimal-string",
                minimum: str(I32_MIN),
                maximum: str(I32_MAX)
            },
            map{
                name: "add_u64",
                arguments: ["u64", "u64"],
                result: "decimal-string",
                minimum: "0",
                maximum: str(U64_MAX)
            }
        ],
        numeric_transport_maximum: str(MAX_SAFE_NUMBER),
        larger_inputs_require_decimal_strings: true,
        foreign_execution: false
    };
}

fn _error(code, message) {
    return map{
        format: "pblang.example.typed-integer-response.v1",
        ok: false,
        executed: false,
        error_code: code,
        error: message
    };
}

fn invoke(request) {
    if type(request) != "map" { return _error("invalid_request", "request must be a map"); }
    if (try request.format catch "") != "pblang.example.typed-integer-request.v1" {
        return _error("invalid_format", "unsupported request format");
    }
    let operation = str(try request.operation catch "");
    let arguments = try request.arguments catch nil;
    if type(arguments) != "array" or len(arguments) != 2 {
        return _error("invalid_arguments", "exactly two arguments are required");
    }
    if operation != "sum_i32_as_string" and operation != "add_u64" {
        return _error("unknown_operation", "operation is not supported");
    }
    let value = nil;
    if operation == "sum_i32_as_string" {
        value = try sum_i32_as_string(arguments[0], arguments[1]) catch nil;
    } else {
        value = try add_u64(arguments[0], arguments[1]) catch nil;
    }
    if value == nil {
        return _error("invalid_arguments", "arguments violate the selected integer contract");
    }
    return map{
        format: "pblang.example.typed-integer-response.v1",
        ok: true,
        executed: true,
        operation: operation,
        value: value,
        value_type: "decimal-string"
    };
}

export source_set_sha256, sum_i32_as_string, add_u64, describe, invoke;
