let OS = import("stdlib:os.sapp");
let API = import("examples/typed_integer_contract/integer_contract.sapp");

fn usage() {
    print "Usage: pblang run examples/typed_integer_contract/main.sapp -- <i32|u64> <left> <right>";
    print "Operations: i32, u64";
}

fn main() {
    let arguments = OS.script_args();
    if len(arguments) == 0 {
        usage();
        print json_stringify(API.describe());
        return true;
    }
    if len(arguments) != 3 {
        usage();
        return false;
    }
    let operation = "";
    if str_lower(arguments[0]) == "i32" {
        operation = "sum_i32_as_string";
    } else if str_lower(arguments[0]) == "u64" {
        operation = "add_u64";
    } else {
        print "Unknown operation: " + arguments[0];
        return false;
    }
    let response = API.invoke(map{
        format: "pblang.example.typed-integer-request.v1",
        operation: operation,
        arguments: [arguments[1], arguments[2]]
    });
    if not response.ok {
        print "Unable to add values: " + response.error;
        return false;
    }
    print response.value;
    return true;
}

main();
