let API = import("examples/typed_integer_contract/integer_contract.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "typed_integer_contract test failed: " + message; }
}

fn rejected(callable) {
    return (try { callable(); false } catch true);
}

require(API.sum_i32_as_string(2, 3) == "5", "i32 addition preserves the original result shape");
require(API.sum_i32_as_string("-2147483648", "2147483647") == "-1",
"i32 boundary values remain exact");
require(rejected(fn() { API.sum_i32_as_string("2147483647", "1"); }),
"positive i32 overflow must fail");
require(rejected(fn() { API.sum_i32_as_string("-2147483648", "-1"); }),
"negative i32 overflow must fail");
require(rejected(fn() { API.sum_i32_as_string("1.0", "2"); }),
"non-integer decimal text must fail");

require(API.add_u64(2, 2) == "4", "u64 example baseline must be preserved");
require(API.add_u64("18446744073709551615", "0") == "18446744073709551615",
"full u64 maximum must remain exact");
require(rejected(fn() { API.add_u64("18446744073709551615", "1"); }),
"u64 overflow must fail");
require(rejected(fn() { API.add_u64("-1", "1"); }), "negative u64 input must fail");
require(rejected(fn() { API.add_u64(9007199254740992, 0); }),
"unsafe JSON-number range must require decimal strings");
require(rejected(fn() { API.add_u64("12e3", "0"); }),
"scientific notation must not cross the decimal-string contract");

let contract = API.describe();
require(contract.format == "pblang.example.typed-integer-contract.v1"
and len(contract.operations) == 2 and not contract.foreign_execution,
"contract metadata must be complete and honest");

let request = map{
    format: "pblang.example.typed-integer-request.v1",
    operation: "add_u64",
    arguments: ["9007199254740992", "8"]
};
let response = API.invoke(request);
require(response.ok and response.executed and response.value == "9007199254741000"
and response.value_type == "decimal-string", "language-neutral request must preserve exact values");
require(not API.invoke(nil).ok, "non-map request must fail closed");
require(not API.invoke(map{ format: "wrong", operation: "add_u64", arguments: [1, 2] }).ok,
"unknown request format must fail closed");
require(not API.invoke(map{
    format: "pblang.example.typed-integer-request.v1",
    operation: "multiply",
    arguments: [1, 2]
}).ok, "unknown operation must fail closed");
require(not API.invoke(map{
    format: "pblang.example.typed-integer-request.v1",
    operation: "add_u64",
    arguments: [1]
}).ok, "wrong argument count must fail closed");

for source_path in [
    "examples/typed_integer_contract/integer_contract.sapp",
    "examples/typed_integer_contract/main.sapp",
    "examples/typed_integer_contract/test.sapp"
] {
    let report = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(report.ok and report.passed and not report.truncated and report.high == 0,
    "bounded security analysis must pass for " + source_path);
}

print "typed_integer_contract_pass";
