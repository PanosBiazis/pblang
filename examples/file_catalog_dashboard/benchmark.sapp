let Catalog = import("stdlib:file_catalog.sapp");

let names = [];
let extensions = [".sapp", ".py", ".h", ".png", ".wav", ".mp4",
    ".pdf", ".json", ".sqlite3", ".tar.gz", ".apk", ".unknown"];
let i = 0;
while i < 2048 {
    array_push(names, "fixture-" + str(i) + extensions[i % len(extensions)]);
    i = i + 1;
}
let report = Catalog.summarize(names, map{ max_items: 2048 });
let plan = Catalog.visualization_plan(report, 1920, 1080);
if report.total_files != 2048 or report.names_included
   or len(plan.bars) != len(report.family_rows) {
    throw "bounded file catalog benchmark failed";
}
print json_stringify(map{
    format: "pblang.example.file-catalog-benchmark.v1",
    classified: report.total_files,
    unknown: report.unknown_files,
    rules: Catalog.capabilities().rule_count,
    names_disclosed: report.names_included,
    verified: true
});
