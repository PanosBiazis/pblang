let Catalog = import("stdlib:file_catalog.sapp");
let App = import("examples/file_catalog_dashboard/catalog_app.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn main() {
    let summary = App.sample_summary();
    let visualization = Catalog.visualization_plan(summary, 960, 540);
    let ui = UI.compile(App.view(summary), map{ target: "native", width: 1280, height: 800 });
    let result = map{
        format: "pblang.example.file-catalog-dashboard.v1",
        total_files: summary.total_files,
        known_files: summary.known_files,
        family_count: len(summary.family_rows),
        bar_count: len(visualization.bars),
        ui_records: len(ui.records),
        inventory_status: App.coverage_status(summary).status,
        complete_disk_coverage: false,
        privacy: summary.privacy,
        verified: summary.total_files == 10 and len(ui.records) > 0
    };
    print json_stringify(result);
    return result.verified;
}

main();
