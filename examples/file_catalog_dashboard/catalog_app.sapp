let Catalog = import("stdlib:file_catalog.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn source_sha256() {
    return "5cf64c844e513426f224ebffc284bce8d63e9d7274d98195fe864c24a9824240";
}

fn sample_summary() {
    return Catalog.summarize([
        "main.sapp", "parser.sapp", "notes.md", "guide.pdf", "photo.png",
        "sound.wav", "demo.mp4", "records.sqlite3", "bundle.tar.gz", "README"
    ]);
}

fn _inspect_action(name, detail) {
    return UI.action_sequence([
        UI.action_set_text("selected_family", name),
        UI.action_set_text("family_detail", detail)
    ]);
}

fn _count(value) {
    return type(value) == "number" and value == value and value >= 0
        and value <= 4096 and value == num_floor(value);
}

// Present existing report fields; never launch a scan or infer complete coverage.
fn coverage_status(summary) {
    if type(summary) != "map" or (try summary.format catch "") != "pblang.file-catalog.summary.v1" {
        throw "file catalog dashboard: a catalog summary is required";
    }
    let total = try summary.total_files catch nil;
    let known = try summary.known_files catch nil;
    let unknown = try summary.unknown_files catch nil;
    if not _count(total) or not _count(known) or not _count(unknown)
        or known + unknown != total {
        throw "file catalog dashboard: invalid classification counts";
    }
    let fields = ["inventory_truncated", "inventory_timed_out", "scanned_entries", "scan_scope"];
    let present = 0;
    for field in fields { if map_has(summary, field) { present = present + 1; } }
    let status = "supplied-list";
    let title = "Supplied list / sample; no scan evidence";
    let scope = "Counts describe only the supplied files. No directory or disk coverage is established.";
    let entries = "Entries visited: unavailable";
    if present > 0 {
        let truncated = try summary.inventory_truncated catch nil;
        let timed_out = try summary.inventory_timed_out catch nil;
        let scanned = try summary.scanned_entries catch nil;
        let valid = present == 4 and type(truncated) == "bool" and type(timed_out) == "bool"
            and _count(scanned) and scanned >= total
            and summary.scan_scope == "one directory level, metadata only";
        status = "unknown";
        title = "Scan evidence incomplete or invalid; coverage unknown";
        scope = "No scan-completion claim can be made from these fields.";
        if valid {
            entries = "Entries visited: " + str(scanned) + " (may include directories); classified files: " + str(total);
            scope = "One directory level, metadata only. Not a recursive inventory or proof of complete disk coverage.";
            status = "one-level-report";
            title = "One-level scan report; no truncation reported";
            if timed_out {
                status = "timed-out";
                title = "Timed out; partial scan report";
                if truncated { title = title + "; inventory truncated"; }
            } elif truncated {
                status = "partial";
                title = "Partial scan report; inventory truncated";
            }
        }
    }
    let rate = if total == 0 { 0 } else { num_floor(100 * known / total) };
    let suffix_label = if total == 0 { "No files to classify; suffix rate unavailable" }
        else { "Recognized suffixes: " + str(known) + " of " + str(total) + " (" + str(rate) + "%)" };
    return map{status:status, title:title, scope:scope, entries:entries,
        suffix_percent:rate, suffix_label:suffix_label, complete_disk_coverage:false,
        scan_executed_by_view:false};
}

fn view(summary = nil) {
    if summary == nil { summary = sample_summary(); }
    let coverage = coverage_status(summary);
    return UI.screen([
        UI.heading("File Catalog", map{
            name: "brand", accessibility_label: "File Catalog dashboard"
        }),
        UI.text(str(summary.total_files) + " files classified from metadata only", map{
            name: "summary", accessibility_label: "File classification summary"
        }),
        UI.card([
            UI.heading("Inventory scope", map{name:"inventory_scope_title"}),
            UI.text(coverage.title, map{name:"inventory_status", wrap:true,
                accessibility_label:"Inventory result status"}),
            UI.text(coverage.scope, map{name:"inventory_scope", wrap:true}),
            UI.text(coverage.entries, map{name:"inventory_entries", wrap:true})
        ], map{name:"inventory_scope_card", gap:8}),
        UI.grid([
            UI.card([
                UI.heading("Source"), UI.text("Code and scripts"),
                UI.button("Inspect", _inspect_action("Source",
                    "Language-aware suffixes with explicit ambiguous headers"), map{
                    name: "inspect_source", accessibility_label: "Inspect source files"
                })
            ], map{ name: "source_card" }),
            UI.card([
                UI.heading("Documents"), UI.text("Text, office and ebooks"),
                UI.button("Inspect", _inspect_action("Documents",
                    "Documents stay separate from source and structured data"), map{
                    name: "inspect_documents", accessibility_label: "Inspect documents"
                })
            ], map{ name: "document_card" }),
            UI.card([
                UI.heading("Media"), UI.text("Images, audio and video"),
                UI.button("Inspect", _inspect_action("Media",
                    "Media containers are counted without opening content"), map{
                    name: "inspect_media", accessibility_label: "Inspect media files"
                })
            ], map{ name: "media_card" }),
            UI.card([
                UI.heading("Packages"), UI.text("Archives and platform packages"),
                UI.button("Inspect", _inspect_action("Packages",
                    "Multipart archives and mobile packages use specific precedence"), map{
                    name: "inspect_packages", accessibility_label: "Inspect packages"
                })
            ], map{ name: "package_card" })
        ], map{ name: "family_grid", columns: 4, gap: 12 }),
        UI.heading("Source", map{ name: "selected_family" }),
        UI.text("Language-aware suffixes with explicit ambiguous headers", map{
            name: "family_detail", accessibility_label: "Selected family details"
        }),
        UI.text(coverage.suffix_label, map{name:"suffix_rate", wrap:true}),
        UI.progress(coverage.suffix_percent, map{
            name: "coverage", accessibility_label: "Recognized suffixes among listed files; not scan completion"
        }),
        UI.text("Suffix recognition is not scan completion or content verification.", map{
            name:"classification_boundary", wrap:true
        }),
        UI.text("Names and file contents are hidden in this dashboard.", map{
            name: "privacy_note", accessibility_label: "Privacy behavior"
        })
    ], map{ name: "file_catalog_root", gap: 16 });
}

fn web_options() {
    return map{
        theme: "light", lang: "en", host: "127.0.0.1", port: 8080,
        width: 1180, height: 800, source_sha256: source_sha256(),
        palette: map{
            accent: [0, 121, 107], selected: [0, 77, 64], focus: [0, 95, 204]
        }
    };
}

export source_sha256, sample_summary, view, web_options;
export coverage_status;
