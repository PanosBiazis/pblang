// Test adapter: caller supplies a newly created, owned directory containing
// three immediate files and one subdirectory. Never use this on a real volume.
let Catalog = import("stdlib:file_catalog.sapp");
let App = import("examples/file_catalog_dashboard/catalog_app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let raw = try env_get("PBLANG_SCRIPT_ARGS") catch "";
let args = str_split(raw, "\n");
if len(args) != 1 or args[0] == "" { throw "scan fixture requires one owned temporary directory"; }
let scanned = Catalog.scan_directory(args[0], map{max_items:16});
let limited = Catalog.scan_directory(args[0], map{max_items:1});
let state = App.coverage_status(scanned);
let partial = App.coverage_status(limited);
assert(scanned.total_files == 3 and scanned.scanned_entries == 4,
    "fixture scan counts immediate files and the subdirectory separately");
assert(state.status == "one-level-report" and not scanned.inventory_timed_out,
    "actual one-level result reaches the UI coverage model");
assert(limited.inventory_truncated and partial.status == "partial",
    "actual cap-limited result remains visibly partial");
assert(not scanned.names_included and not limited.names_included
    and not scanned.content_read and not limited.content_read,
    "existing scanner keeps aggregate metadata-only reporting");
let preview = UI.preview_web("Local fixture scan", App.view(scanned), App.web_options());
assert(not str_contains(preview.generated.html, args[0]), "dashboard must not expose the fixture path");
print json_stringify(map{actual_local_fixture:true, one_level_status:state.status,
    total_files:scanned.total_files, scanned_entries:scanned.scanned_entries,
    capped_status:partial.status, complete_disk_coverage:false, content_read:false});
