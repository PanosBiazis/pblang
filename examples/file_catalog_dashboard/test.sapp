let Catalog = import("stdlib:file_catalog.sapp");
let App = import("examples/file_catalog_dashboard/catalog_app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "file_catalog_dashboard test failed: " + message; }
}

fn record(bundle, name) {
    for item in bundle.records { if item.name == name { return item; } }
    return nil;
}

let summary = App.sample_summary();
require(summary.total_files == 10 and summary.known_files == 9 and summary.unknown_files == 1,
    "sample summary is deterministic");
require(not summary.names_included and len(summary.classified_items) == 0,
    "sample report does not disclose names");
let visualization = Catalog.visualization_plan(summary, 960, 540);
require(len(visualization.bars) == len(summary.family_rows)
    and len(visualization.donut_sectors) == len(summary.family_rows)
    and len(visualization.radial_columns) == len(summary.family_rows),
    "all visualization modes cover every aggregate family");
require(visualization.renderer_required and not visualization.foreign_runtime_required,
    "visualization honestly distinguishes renderer need from foreign dependency");

let view = App.view(summary);
require(UI.validate(view).ok, "shared UI tree must validate");
let web = UI.compile(view, map{ target: "web", width: 320, height: 640 });
let native = UI.compile(view, map{ target: "native", width: 1440, height: 900 });
let android = UI.compile(view, map{ target: "android", width: 360, height: 720 });
for bundle in [web, native, android] {
    require(record(bundle, "brand") != nil, "brand must render on every target");
    require(record(bundle, "inspect_source") != nil, "source action must render");
    require(record(bundle, "inspect_documents") != nil, "document action must render");
    require(record(bundle, "inspect_media") != nil, "media action must render");
    require(record(bundle, "inspect_packages") != nil, "package action must render");
    require(record(bundle, "privacy_note") != nil, "privacy note must remain visible");
}

let preview = UI.preview_web("File Catalog", view, App.web_options());
require(preview.response.status == 200, "generated Web preview must return HTTP 200");
require(str_contains(preview.generated.html, "viewport-fit=cover"),
    "Web preview must support compact viewports");
require(str_contains(preview.generated.css, "@media(max-width:640px)"),
    "Web preview must include responsive rules");
require(not str_contains(preview.generated.html, "http://")
    and not str_contains(preview.generated.html, "https://"),
    "Web preview must have no remote runtime dependency");
require(App.source_sha256() ==
    "5cf64c844e513426f224ebffc284bce8d63e9d7274d98195fe864c24a9824240",
    "source provenance digest must remain stable");

for source_path in [
    "stdlib/file_catalog.sapp",
    "examples/file_catalog_dashboard/catalog_app.sapp",
    "examples/file_catalog_dashboard/benchmark.sapp",
    "examples/file_catalog_dashboard/main.sapp",
    "examples/file_catalog_dashboard/test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
        "bounded security analysis must pass for " + source_path);
}

print "file_catalog_dashboard_pass";
