let Catalog = import("stdlib:file_catalog.sapp");
let App = import("examples/file_catalog_dashboard/catalog_app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Security = import("stdlib:security_analysis.sapp");
let GUI = import("stdlib:gui.sapp");

fn require(value, message) {
    if not value { throw "file_catalog_dashboard test failed: " + message; }
}

fn record(bundle, name) {
    for item in bundle.records { if item.name == name { return item; } }
    return nil;
}

let summary = App.sample_summary();
require(summary.total_files == 10 and summary.known_files == 9 and summary.unknown_files == 1,
    "sample summary is deterministic");
require(not summary.names_included and len(summary.classified_items) == 0,
    "sample report does not disclose names");
fn scan_report(truncated, timed_out) {
    let result = App.sample_summary();
    result.inventory_truncated = truncated;
    result.inventory_timed_out = timed_out;
    result.scanned_entries = 12;
    result.scan_scope = "one directory level, metadata only";
    return result;
}
let original = json_stringify(summary);
let supplied = App.coverage_status(summary);
require(supplied.status == "supplied-list" and supplied.suffix_percent == 90
    and not supplied.complete_disk_coverage and not supplied.scan_executed_by_view,
    "known suffix rate must not become inventory coverage");
require(json_stringify(summary) == original, "coverage presentation must preserve input");
for pair in [[scan_report(false, false), "one-level-report"],
             [scan_report(true, false), "partial"],
             [scan_report(false, true), "timed-out"],
             [scan_report(true, true), "timed-out"]] {
    let before = json_stringify(pair[0]);
    let state = App.coverage_status(pair[0]);
    require(state.status == pair[1] and not state.complete_disk_coverage,
        "reported scope and both interruption flags must survive presentation");
    require(str_contains(state.entries, "12") and str_contains(state.entries, "classified files: 10"),
        "visited entries and classified files must stay distinct");
    let preview_form = UI.run("Coverage", App.view(pair[0]), map{preview:true, width:1180, height:900}).form;
    GUI.get(preview_form, "inspect_media").onclick(preview_form);
    require(GUI.get(preview_form, "selected_family").text == "Media"
        and GUI.get(preview_form, "inventory_status").text == state.title
        and GUI.get(preview_form, "inventory_scope").text == state.scope,
        "family navigation must preserve inventory status and scope");
    require(json_stringify(pair[0]) == before, "view and navigation must preserve report input");
}
let missing = App.sample_summary(); missing.inventory_truncated = false;
require(App.coverage_status(missing).status == "unknown", "missing scan fields must not imply completeness");
for invalid in [nil, "false", 0] {
    let bad = scan_report(false, false); bad.inventory_timed_out = invalid;
    require(App.coverage_status(bad).status == "unknown", "invalid flag types remain unknown");
}
for invalid in [nil, -1, 2, 4097, 12.5, parse_number("NaN"), parse_number("inf")] {
    let bad = scan_report(false, false); bad.scanned_entries = invalid;
    require(App.coverage_status(bad).status == "unknown", "invalid or contradictory visited counts remain unknown");
}
let opaque = scan_report(false, false); opaque.scan_scope = "PRIVATE_SCOPE_SENTINEL";
let opaque_preview = UI.preview_web("Unknown evidence", App.view(opaque), App.web_options());
require(App.coverage_status(opaque).status == "unknown"
    and not str_contains(opaque_preview.generated.html, "PRIVATE_SCOPE_SENTINEL"),
    "unrecognized scope must not be echoed or promoted to known coverage");
let empty = App.coverage_status(Catalog.summarize([]));
require(empty.suffix_percent == 0 and str_contains(empty.suffix_label, "unavailable"),
    "empty input has no suffix-rate observation and is not complete inventory");
let all_known = Catalog.summarize(["main.sapp"]);
all_known.inventory_truncated = true; all_known.inventory_timed_out = false;
all_known.scanned_entries = 1; all_known.scan_scope = "one directory level, metadata only";
let still_partial = App.coverage_status(all_known);
require(still_partial.suffix_percent == 100 and still_partial.status == "partial"
    and not still_partial.complete_disk_coverage,
    "100 percent recognized suffixes must never erase truncation");
let invalid_counts = App.sample_summary(); invalid_counts.known_files = 11;
require((try App.coverage_status(invalid_counts) catch nil) == nil,
    "contradictory classification counters must fail before rendering");
let visualization = Catalog.visualization_plan(summary, 960, 540);
require(len(visualization.bars) == len(summary.family_rows)
    and len(visualization.donut_sectors) == len(summary.family_rows)
    and len(visualization.radial_columns) == len(summary.family_rows),
    "all visualization modes cover every aggregate family");
require(visualization.renderer_required and not visualization.foreign_runtime_required,
    "visualization honestly distinguishes renderer need from foreign dependency");

let view = App.view(summary);
require(UI.validate(view).ok, "shared UI tree must validate");
let web = UI.compile(view, map{ target: "web", width: 320, height: 640 });
let native = UI.compile(view, map{ target: "native", width: 1440, height: 900 });
let android = UI.compile(view, map{ target: "android", width: 360, height: 720 });
for bundle in [web, native, android] {
    require(record(bundle, "brand") != nil, "brand must render on every target");
    require(record(bundle, "inspect_source") != nil, "source action must render");
    require(record(bundle, "inspect_documents") != nil, "document action must render");
    require(record(bundle, "inspect_media") != nil, "media action must render");
    require(record(bundle, "inspect_packages") != nil, "package action must render");
    require(record(bundle, "privacy_note") != nil, "privacy note must remain visible");
    for name in ["inventory_status", "inventory_scope", "inventory_entries", "suffix_rate", "classification_boundary"] {
        require(record(bundle, name) != nil, "coverage boundary must compile for each target");
    }
}

let preview = UI.preview_web("File Catalog", view, App.web_options());
require(preview.response.status == 200, "generated Web preview must return HTTP 200");
require(str_contains(preview.generated.html, "viewport-fit=cover"),
    "Web preview must support compact viewports");
require(str_contains(preview.generated.css, "@media(max-width:640px)"),
    "Web preview must include responsive rules");
require(not str_contains(preview.generated.html, "http://")
    and not str_contains(preview.generated.html, "https://"),
    "Web preview must have no remote runtime dependency");
require(App.source_sha256() ==
    "5cf64c844e513426f224ebffc284bce8d63e9d7274d98195fe864c24a9824240",
    "source provenance digest must remain stable");

for source_path in [
    "stdlib/file_catalog.sapp",
    "examples/file_catalog_dashboard/catalog_app.sapp",
    "examples/file_catalog_dashboard/benchmark.sapp",
    "examples/file_catalog_dashboard/main.sapp",
    "examples/file_catalog_dashboard/test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
        "bounded security analysis must pass for " + source_path);
}

print "file_catalog_dashboard_pass";
