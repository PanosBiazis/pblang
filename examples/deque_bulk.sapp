let D=import("stdlib:deque.sapp");
let pending=D.from_array(["middle"]);
D.extend_front(pending,["first","second"]);
D.extend_back(pending,["last"]);
print D.to_array(pending);
assert(D.pop_front(pending)=="first","front order");
D.compact(pending);
assert(D.to_array(pending)==["second","middle","last"],"compact preserves order");
