let SECURITY = import("stdlib:security_analysis.sapp");

let source = "// pblang-security-ignore-next-line: network.plaintext-http reason=loopback health probe\nlet health = \"http://127.0.0.1:8080/health\";";
let report = SECURITY.analyze(source, "generated-health-probe.sapp", map{
    minimum_blocking_severity: "high"
});

print json_stringify(report);
