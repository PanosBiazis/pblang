let M=import("stdlib:matrix.sapp");
// Synthetic coefficient matrix deliberately requires a row pivot.
let A=[[0,2],[1,3]];let B=[[4,8,-2],[7,14,-2]];let saved=json_stringify([A,B]);
let X=M.solve_many(A,B);let scenarios=[];
for column in range(0,3) {
 let rhs=[B[0][column],B[1][column]];let independently=M.solve(A,rhs);let solution=[X[0][column],X[1][column]];
 let rebuilt=M.mul_vec(A,solution);let residual=0;
 for row in range(0,2) {assert(num_abs(solution[row]-independently[row])<0.000000001,"batched and independent solution agreement");let delta=num_abs(rebuilt[row]-rhs[row]);if delta>residual {residual=delta;}}
 assert(residual<0.000000001,"equation residual bound for this fixture");array_push(scenarios,map{column:column,solution:solution,residual_inf:residual});
}
assert(scenarios[0].solution==[1,2] and scenarios[1].solution==[2,4] and scenarios[2].solution==[1,-1],"known synthetic solutions");
assert(json_stringify([A,B])==saved,"original matrices preserved");
assert((try M.solve_many([[1,2],[2,4]],[[1],[2]]) catch nil)==nil,"singular system rejected");
assert((try M.solve_many(A,[[1],[2,3]]) catch nil)==nil,"ragged scenario matrix rejected");
for value in [true,"PRIVATE_SENTINEL",parse_number("NaN"),parse_number("inf")] {
 assert((try M.solve_many(A,[[value],[1]]) catch nil)==nil,"invalid numeric input rejected");
}
let too_many=[];for i in range(0,129) {array_push(too_many,0);}assert((try M.solve_many([[1]],[too_many]) catch nil)==nil,"RHS column bound");
print json_stringify(map{format:"pblang.matrix-scenario-example.v1",scenarios:scenarios,synthetic:true,condition_number_estimated:false,raw_matrices_included:false});
