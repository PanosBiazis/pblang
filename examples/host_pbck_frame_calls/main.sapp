let Plan = import("stdlib:host_pbck_frame_plan.sapp");
let Calls = import("stdlib:host_pbck_frame_calls.sapp");

// Compiler-emitted declarations occupy frame stack slots. A closure keeps the
// first slot alive and the second invocation is a tail call.
let add = map{
    __pbck_function: true, name: "add", arity: 1, min_arity: 1,
    defaults: [], is_vararg: false, parameter_types: [],
    chunk: map{ instructions: [
        map{ op: 28, operand: 0 }, map{ op: 25, operand: 0 }, map{ op: 1 },
        map{ op: 29, operand: 0 }, map{ op: 28, operand: 0 }, map{ op: 33 }
    ], constants: [], source_name: nil }
};
let decoded = map{
    format: "host-pbck-v1", version: 1,
    chunk: map{ instructions: [
        map{ op: 0, operand: 0 },
        map{ op: 27, fn_const: 1, captures: [map{ is_local: true, index: 0 }] },
        map{ op: 25, operand: 1 }, map{ op: 0, operand: 2 },
        map{ op: 31, operand: 1 }, map{ op: 11 },
        map{ op: 25, operand: 1 }, map{ op: 0, operand: 3 },
        map{ op: 32, operand: 1 }
    ], constants: [40, add, 1, 1], source_name: nil }
};

let prepared = Calls.prepare(Plan.build_decoded(decoded));
let result = Calls.run_prepared(prepared, 0, [], map{ require_i32: true });
let verified = Calls.verify_i32_prepared(prepared, 0, [], map{ max_steps: 1000 });
print "value=" + str(result.value)
    + " steps=" + str(result.steps)
    + " peak_frames=" + str(result.peak_frames)
    + " tail_calls=" + str(result.tail_calls)
    + " verified_functions=" + str(verified.reachable_function_count)
    + " verified_instructions=" + str(verified.reachable_instructions);
