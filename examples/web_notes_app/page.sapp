// examples/web_notes_app/page.sapp
// Tiny HTML builder used by the PBIDE web notes example.

fn _escape(text) {
    let s = str(text);
    s = str_replace_all(s, "&", "&amp;");
    s = str_replace_all(s, "<", "&lt;");
    s = str_replace_all(s, ">", "&gt;");
    s = str_replace_all(s, "\"", "&quot;");
    return s;
}

fn notes_page(title, notes) {
    let body = "";
    let i = 0;
    while notes != nil and i < len(notes) {
        let n = notes[i];
        body = body + "<article class=\"note\">";
        body = body + "<h2>" + _escape(try n.title catch "Untitled") + "</h2>";
        body = body + "<p>" + _escape(try n.text catch "") + "</p>";
        body = body + "</article>";
        i = i + 1;
    }
    return "<!doctype html><html><head><meta charset=\"utf-8\"><title>" +
        _escape(title) + "</title></head><body><main><h1>" +
        _escape(title) + "</h1>" + body + "</main></body></html>";
}

export notes_page;
