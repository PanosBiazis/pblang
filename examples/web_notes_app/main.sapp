// examples/web_notes_app/main.sapp
// Safe web-app starter: deterministic output, no background server loop.

let PAGE = import("examples/web_notes_app/page.sapp");

fn sample_notes() {
    return [
        map{ id: 1, title: "Plan", text: "Sketch the UI and browser tabs." },
        map{ id: 2, title: "Build", text: "Keep Run deterministic and Preview interactive." },
        map{ id: 3, title: "Ship", text: "Document the exact files." }
    ];
}

fn main() {
    let notes = sample_notes();
    let html = PAGE.notes_page("PBIDE Notes", notes);
    print "notes=" + str(len(notes));
    print "html_chars=" + str(len(html));
    print "first=" + notes[0].title + ": " + notes[0].text;
}

main();

