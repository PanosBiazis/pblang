// A child belongs to this synchronous scope. Exceptions still trigger cleanup.
let Scoped = import("stdlib:process_scope.sapp");
let Process = import("stdlib:process.sapp");

fn demonstrate() {
let result = Scoped.with_process(["/usr/bin/printf"], ["%s", "PBLang child"],
    map{timeout_secs:3,max_output_bytes:1024}, fn(child) {
        let completed = child.finish(3000);
        if not completed.command_ok { return map{ok:false,error:"child failed"}; }
        return map{ok:true,value:completed.stdout};
    });
if result.recovery_required {
    // Ownership is retained when a finite cleanup wait cannot confirm exit.
    let recovered = Process.close_bounded(result.recovery_handle, 250, 3000);
    if not recovered.handle_closed { throw "child still requires owned recovery"; }
}
if not result.ok { throw "scoped process example failed"; }
print result.value;
}

if Process.bounded_status().available { demonstrate(); }
else {
    print "Scoped child execution unavailable: the public backend is not verified; no child launched.";
}
