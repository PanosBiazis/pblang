// Content model for the responsive technology-site migration.

fn app_name() { return "Open Technology Studio"; }

fn source_set_sha256() {
    return "8d59ff77a085d4c5d413e68e8f11c1c62a630c216f9c3d65f45fff8e485d9a2f";
}

fn pages() {
    return [
        map{
            id: "home",
            title: "Technology made understandable",
            body: "Explore practical hardware, software, and automation through one clear, responsive experience."
        },
        map{
            id: "about",
            title: "About the studio",
            body: "We turn technical ideas into maintainable systems with explicit limits, accessible interfaces, and measurable behavior."
        },
        map{
            id: "services",
            title: "Services",
            body: "Choose embedded prototyping, application engineering, or workflow automation. Each service starts with a bounded plan."
        },
        map{
            id: "contact",
            title: "Contact",
            body: "Use the local form to prepare a request. This static example never transmits or stores the entered information."
        }
    ];
}

fn services() {
    return [
        map{
            id: "hardware",
            title: "Embedded systems",
            body: "Board-aware prototypes, bounded device communication, and testable hardware interfaces."
        },
        map{
            id: "software",
            title: "Application engineering",
            body: "Portable applications built around shared behavior, predictable state, and focused verification."
        },
        map{
            id: "automation",
            title: "Responsible automation",
            body: "Repeatable workflows with explicit permissions, resource limits, and useful failure reporting."
        }
    ];
}

fn stories() {
    return [
        map{
            id: "hardware_story",
            title: "Hardware and software together",
            body: "A reliable product treats the circuit, firmware, application, and operator workflow as one tested system."
        },
        map{
            id: "robotics_story",
            title: "Robotics with clear boundaries",
            body: "Sensors, actuators, and control logic need explicit timing, safety states, and observable recovery behavior."
        },
        map{
            id: "portable_story",
            title: "One model, several surfaces",
            body: "The shared PBLang component tree adapts to compact and wide layouts without project-authored browser scripts."
        }
    ];
}

export app_name, source_set_sha256, pages, services, stories;
