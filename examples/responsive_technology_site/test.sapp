let App = import("examples/responsive_technology_site/app.sapp");
let Model = import("examples/responsive_technology_site/model.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "responsive_technology_site test failed: " + message; }
}

fn record(bundle, name) {
    for item in bundle.records {
        if item.name == name { return item; }
    }
    return nil;
}

let pages = Model.pages();
let services = Model.services();
let stories = Model.stories();
require(len(pages) == 4, "all original site sections must be modeled");
require(len(services) == 3, "three distinct services must be modeled");
require(len(stories) == 3, "three technology stories must be modeled");
require(Model.source_set_sha256() == "8d59ff77a085d4c5d413e68e8f11c1c62a630c216f9c3d65f45fff8e485d9a2f",
"source-set provenance must remain deterministic");

let view = App.view();
let validation = UI.validate(view);
require(validation.ok, "shared view contract must validate");

let phone = UI.compile(view, map{ target: "web", width: 320, height: 640 });
let desktop = UI.compile(view, map{ target: "native", width: 1440, height: 900 });
let android = UI.compile(view, map{ target: "android", width: 360, height: 720 });
for bundle in [phone, desktop, android] {
    require(record(bundle, "brand") != nil, "brand must render on every compiled surface");
    require(record(bundle, "nav_home") != nil, "home navigation must render");
    require(record(bundle, "nav_contact") != nil, "contact navigation must render");
    require(record(bundle, "service_hardware") != nil, "hardware service must render");
    require(record(bundle, "service_software") != nil, "software service must render");
    require(record(bundle, "service_automation") != nil, "automation service must render");
    require(record(bundle, "contact_message") != nil, "contact note field must render");
    require(record(bundle, "privacy_button") != nil, "privacy action must render");
}

let preview = UI.preview_web(Model.app_name(), view, App.web_options());
let html = preview.generated.html;
let css = preview.generated.css;
require(preview.response.status == 200, "generated Web preview must return HTTP 200");
require(str_contains(html, "<meta charset=\"utf-8\">"), "output must declare UTF-8");
require(str_contains(html, "viewport-fit=cover"), "output must support compact viewports");
require(str_contains(html, "aria-live=\"polite\""), "dynamic status must be announced");
require(str_contains(css, "@media(max-width:640px)"), "mobile responsive rules must exist");
require(str_contains(css, "letter-spacing:0"), "stable text spacing must be explicit");
require(str_contains(css, "--pb-accent:rgb(0,112,102)"), "site accent must use the domain palette");
require(not str_contains(html, "jquery"), "generated page must not require jQuery");
require(not str_contains(html, "bootstrap"), "generated page must not require Bootstrap");
require(not str_contains(html, "http://"), "generated page must not load plain HTTP resources");
require(not str_contains(html, "https://"), "generated page must not load remote HTTPS resources");
require(not str_contains(html, "/media/"), "workspace paths must not leak");
require(not str_contains(html, "/home/"), "home paths must not leak");
require(not str_contains(html, "Panagiotis"), "personal author metadata must not be retained");
require(not str_contains(html, "example.com"), "placeholder personal contact data must not be retained");

for source_path in [
    "examples/responsive_technology_site/model.sapp",
    "examples/responsive_technology_site/app.sapp",
    "examples/responsive_technology_site/main.sapp",
    "examples/responsive_technology_site/test.sapp"
] {
    let report = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(report.ok and report.passed and not report.truncated and report.high == 0,
    "bounded security analysis must pass for " + source_path);
}

print "responsive_technology_site_pass";
