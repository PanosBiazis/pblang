let App = import("examples/responsive_technology_site/app.sapp");
let Model = import("examples/responsive_technology_site/model.sapp");
let UI = import("stdlib:modern_ui.sapp");

let OUTPUT = "examples/responsive_technology_site/build/web";
let result = UI.export_web(Model.app_name(), App.view(), OUTPUT, App.web_options());

print "site=" + result.output + "/index.html";
print "digest=" + result.digest;
print "nodes=" + str(result.generated.nodes);
print "actions=" + str(result.generated.actions);
