// PBLang-only migration of two early multi-page Web and Bootstrap exercises.

let UI = import("stdlib:modern_ui.sapp");
let Model = import("examples/responsive_technology_site/model.sapp");

fn _select_action(page) {
    return UI.action_sequence([
        UI.action_set_text("active_title", page.title),
        UI.action_set_text("active_body", page.body),
        UI.action_set_text("navigation_status", page.title + " selected"),
        UI.action_message(page.title)
    ]);
}

fn _story_action(story) {
    return UI.action_sequence([
        UI.action_set_text("story_title", story.title),
        UI.action_set_text("story_body", story.body),
        UI.action_set_text("story_status", story.title + " selected")
    ]);
}

fn _navigation() {
    let buttons = [];
    for page in Model.pages() {
        array_push(buttons, UI.button(page.id, _select_action(page), map{
            name: "nav_" + page.id,
            accessibility_label: "Show " + page.title
        }));
    }
    return UI.row(buttons, map{ name: "primary_navigation", responsive: true, gap: 8 });
}

fn _service_cards() {
    let cards = [];
    for service in Model.services() {
        array_push(cards, UI.card([
            UI.heading(service.title, map{ name: service.id + "_title" }),
            UI.text(service.body, map{ name: service.id + "_body" })
        ], map{ name: "service_" + service.id }));
    }
    return cards;
}

fn _story_picker() {
    let stories = Model.stories();
    let actions = [];
    for story in stories {
        array_push(actions, UI.button(story.title, _story_action(story), map{
            name: "story_" + story.id,
            accessibility_label: "Show story: " + story.title
        }));
    }
    return UI.card([
        UI.heading("Technology stories", map{ name: "stories_heading" }),
        UI.row(actions, map{ name: "story_actions", responsive: true, gap: 8 }),
        UI.heading(stories[0].title, map{ name: "story_title" }),
        UI.text(stories[0].body, map{ name: "story_body" }),
        UI.text("Hardware and software together selected", map{
            name: "story_status",
            accessibility_label: "Selected technology story"
        })
    ], map{ name: "story_showcase" });
}

fn _contact_panel() {
    return UI.card([
        UI.heading("Prepare a project note", map{ name: "contact_heading" }),
        UI.text("Fields remain inside this generated page. There is no network submission endpoint.", map{
            name: "contact_privacy"
        }),
        UI.input("", map{
            name: "contact_name",
            placeholder: "Name or team",
            accessibility_label: "Name or team"
        }),
        UI.input("", map{
            name: "contact_reply",
            placeholder: "Reply address",
            accessibility_label: "Reply address"
        }),
        UI.area("", map{
            name: "contact_message",
            placeholder: "What would you like to build?",
            accessibility_label: "Project request"
        }),
        UI.button("Review privacy", UI.action_sequence([
            UI.action_set_text("contact_status", "Local-only demo: nothing was sent or stored."),
            UI.action_message("No data transmitted")
        ]), map{
            name: "privacy_button",
            accessibility_label: "Review how this example handles form data"
        }),
        UI.text("No form data has left this page.", map{
            name: "contact_status",
            accessibility_label: "Contact form privacy status"
        })
    ], map{ name: "contact_panel" });
}

fn view() {
    let pages = Model.pages();
    return UI.screen([
        UI.column([
            UI.heading(Model.app_name(), map{
                name: "brand",
                accessibility_label: "Open Technology Studio"
            }),
            UI.text("A responsive PBLang component showcase with no CDN, tracker, or remote asset.", map{
                name: "tagline"
            }),
            _navigation(),
            UI.text("Technology made understandable selected", map{
                name: "navigation_status",
                accessibility_label: "Selected site section"
            })
        ], map{ name: "site_header", gap: 8 }),

        UI.card([
            UI.heading(pages[0].title, map{ name: "active_title" }),
            UI.text(pages[0].body, map{ name: "active_body" }),
            UI.row([
                UI.button("Explore services", _select_action(pages[2]), map{
                    name: "explore_services",
                    accessibility_label: "Show services overview"
                }),
                UI.button("Contact options", _select_action(pages[3]), map{
                    name: "contact_options",
                    accessibility_label: "Show contact options"
                })
            ], map{ name: "hero_actions", responsive: true })
        ], map{ name: "hero", title: "Overview" }),

        UI.heading("What we build", map{ name: "services_heading" }),
        UI.grid(_service_cards(), map{
            name: "services_grid",
            columns: 3,
            gap: 12
        }),
        _story_picker(),
        _contact_panel(),
        UI.text("Built from one bounded PBLang view tree.", map{
            name: "footer_note"
        })
    ], map{ name: "site_root", gap: 16 });
}

fn web_options() {
    return map{
        theme: "light",
        lang: "en",
        host: "127.0.0.1",
        port: 8080,
        width: 1180,
        height: 920,
        palette: map{
            accent: [0, 112, 102],
            selected: [0, 126, 110],
            focus: [0, 95, 204]
        },
        source_sha256: Model.source_set_sha256()
    };
}

export view, web_options;
