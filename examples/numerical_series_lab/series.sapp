// Exact, bounded migration of the pi, e, and sum-of-squares exercises.

let BIGNUM = import("stdlib:bignum.sapp");

let MAX_SIGNIFICANT_DIGITS = 1000;
let GUARD_DIGITS = 12;
let MAX_SQUARE_ITEMS = 1024;
let MAX_INTEGER_DIGITS = 4096;
let MAX_SAFE_INTEGER = 9007199254740991;

fn source_sha256() {
    return map{
        pi: "2a2bf6e5844eb9ae2c5017a25b230221f7c3e4bc47bf7dfe7ed59b1af6b136cd",
        e: "d11d5bc439b2f4d51ca12043b38732035c62df5a5b39517440a8a32c244c105f",
        squares: "39658b29a6eb489f43cb4c097068ff62c838b2deaf6f1de4ea35c7ac0f17e9e4"
    };
}

fn _bounded_digits(value) {
    if not is_number(value) or num_floor(value) != value {
        throw "significant_digits must be an integer";
    }
    if value < 1 or value > MAX_SIGNIFICANT_DIGITS {
        throw "significant_digits must be in 1.." + str(MAX_SIGNIFICANT_DIGITS);
    }
    return value;
}

fn _pow10(exponent) { return BIGNUM.pow(bigint(10), exponent); }

fn _round_guarded(value, guard_digits) {
    let divisor = _pow10(guard_digits);
    let quotient = value / divisor;
    let remainder = value % divisor;
    if remainder * bigint(2) >= divisor { quotient = quotient + bigint(1); }
    return quotient;
}

fn _format_fixed(value, fractional_digits) {
    let text = str(value);
    while len(text) <= fractional_digits { text = "0" + text; }
    if fractional_digits == 0 { return text; }
    let split = len(text) - fractional_digits;
    return text[0..split] + "." + text[split..len(text)];
}

fn _atan_reciprocal_scaled(reciprocal, scale) {
    let divisor = bigint(reciprocal);
    let divisor_squared = divisor * divisor;
    let power = divisor;
    let odd = 1;
    let positive = true;
    let total = bigint(0);
    let iterations = 0;
    while iterations < 5000 {
        let term = scale / (power * bigint(odd));
        if term == bigint(0) {
            return map{ value: total, iterations: iterations, converged: true };
        }
        if positive { total = total + term; }
        else { total = total - term; }
        positive = not positive;
        power = power * divisor_squared;
        odd = odd + 2;
        iterations = iterations + 1;
    }
    throw "arctangent series exceeded its iteration budget";
}

fn pi_report(significant_digits_value) {
    let significant_digits = _bounded_digits(significant_digits_value);
    let fractional_digits = significant_digits - 1;
    let scale = _pow10(fractional_digits + GUARD_DIGITS);
    let fifth = _atan_reciprocal_scaled(5, scale);
    let two_hundred_thirty_ninth = _atan_reciprocal_scaled(239, scale);
    let guarded = bigint(16) * fifth.value - bigint(4) * two_hundred_thirty_ninth.value;
    let rounded = _round_guarded(guarded, GUARD_DIGITS);
    return map{
        format: "pblang.example.constant-report.v1",
        constant: "pi",
        value: _format_fixed(rounded, fractional_digits),
        significant_digits: significant_digits,
        exact_arithmetic: true,
        correctly_rounded_claim: false,
        guard_digits: GUARD_DIGITS,
        iterations: fifth.iterations + two_hundred_thirty_ninth.iterations,
        method: "machin-fixed-point"
    };
}

fn e_report(significant_digits_value) {
    let significant_digits = _bounded_digits(significant_digits_value);
    let fractional_digits = significant_digits - 1;
    let scale = _pow10(fractional_digits + GUARD_DIGITS);
    let total = scale;
    let factorial = bigint(1);
    let index = 1;
    let iterations = 0;
    while iterations < 10000 {
        factorial = factorial * bigint(index);
        let term = scale / factorial;
        if term == bigint(0) {
            let rounded = _round_guarded(total, GUARD_DIGITS);
            return map{
                format: "pblang.example.constant-report.v1",
                constant: "e",
                value: _format_fixed(rounded, fractional_digits),
                significant_digits: significant_digits,
                exact_arithmetic: true,
                correctly_rounded_claim: false,
                guard_digits: GUARD_DIGITS,
                iterations: iterations,
                method: "factorial-series-fixed-point"
            };
        }
        total = total + term;
        index = index + 1;
        iterations = iterations + 1;
    }
    throw "factorial series exceeded its iteration budget";
}

fn _strict_bigint(value, label) {
    if type(value) == "bigint" { return value; }
    if is_number(value) and num_floor(value) != value {
        throw label + " must be an integer";
    }
    if is_number(value) and (value < -MAX_SAFE_INTEGER or value > MAX_SAFE_INTEGER) {
        throw label + " exceeds the exact numeric range";
    }
    let text = str_trim(str(value));
    if text == "" { throw label + " must not be empty"; }
    let start = 0;
    if text[0..1] == "-" or text[0..1] == "+" { start = 1; }
    if start == len(text) or len(text) - start > MAX_INTEGER_DIGITS {
        throw label + " exceeds the accepted decimal shape";
    }
    let i = start;
    while i < len(text) {
        if str_index_of("0123456789", text[i..(i + 1)]) < 0 {
            throw label + " must use ASCII base-10 digits";
        }
        i = i + 1;
    }
    return bigint(text);
}

fn sum_of_squares_report(values) {
    if type(values) != "array" { throw "values must be an array"; }
    if len(values) > MAX_SQUARE_ITEMS {
        throw "value count exceeds " + str(MAX_SQUARE_ITEMS);
    }
    let total = bigint(0);
    let normalized = [];
    let i = 0;
    while i < len(values) {
        let value = _strict_bigint(values[i], "values[" + str(i) + "]");
        array_push(normalized, str(value));
        total = total + value * value;
        i = i + 1;
    }
    return map{
        format: "pblang.example.sum-of-squares-report.v1",
        values: normalized,
        result: str(total),
        count: len(values),
        exact: true,
        input_mutated: false
    };
}

fn parse_integer_list(text) {
    let source = str_trim(str(text));
    if source == "" { return []; }
    let pieces = str_split(source, ",");
    if len(pieces) > MAX_SQUARE_ITEMS {
        throw "value count exceeds " + str(MAX_SQUARE_ITEMS);
    }
    let out = [];
    let i = 0;
    while i < len(pieces) {
        array_push(out, str(_strict_bigint(pieces[i], "item " + str(i + 1))));
        i = i + 1;
    }
    return out;
}

fn parse_significant_digits(text) {
    let value = str_trim(str(text));
    if value == "" { throw "significant_digits must not be empty"; }
    let i = 0;
    while i < len(value) {
        if str_index_of("0123456789", value[i..(i + 1)]) < 0 {
            throw "significant_digits must use ASCII base-10 digits";
        }
        i = i + 1;
    }
    return _bounded_digits(parse_number(value));
}

export source_sha256, pi_report, e_report, sum_of_squares_report;
export parse_integer_list, parse_significant_digits;
