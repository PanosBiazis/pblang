let OS = import("stdlib:os.sapp");
let SERIES = import("examples/numerical_series_lab/series.sapp");

fn usage() {
    print "Numerical series lab";
    print "  pi <significant-digits>";
    print "  e <significant-digits>";
    print "  squares <comma-separated-integers>";
}

fn main() {
    let arguments = OS.script_args();
    if len(arguments) != 2 { usage(); return false; }
    let operation = str_lower(arguments[0]);
    let report = nil;
    if operation == "pi" {
        report = try SERIES.pi_report(SERIES.parse_significant_digits(arguments[1])) catch nil;
    } else if operation == "e" {
        report = try SERIES.e_report(SERIES.parse_significant_digits(arguments[1])) catch nil;
    } else if operation == "squares" {
        report = try SERIES.sum_of_squares_report(
            SERIES.parse_integer_list(arguments[1])
        ) catch nil;
    } else {
        usage();
        return false;
    }
    if report == nil {
        print "Invalid or unsupported input for " + operation;
        return false;
    }
    print json_stringify(report);
    return true;
}

main();
