let SERIES = import("examples/numerical_series_lab/series.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "numerical_series_lab test failed: " + message; }
}

fn rejected(callable) { return (try { callable(); false } catch true); }

let pi = SERIES.pi_report(80);
require(str_starts_with(pi.value,
"3.14159265358979323846264338327950288419716939937510"),
"pi prefix must match the established decimal expansion");
require(len(pi.value) - 1 == 80,
"pi output must contain exactly the requested significant digits");
require(pi.exact_arithmetic and not pi.correctly_rounded_claim and pi.iterations > 0,
"pi report must state its precision contract honestly");

let e = SERIES.e_report(80);
require(str_starts_with(e.value,
"2.71828182845904523536028747135266249775724709369995"),
"e prefix must match the established decimal expansion");
require(len(e.value) - 1 == 80,
"e output must contain exactly the requested significant digits");
require(e.exact_arithmetic and not e.correctly_rounded_claim and e.iterations > 0,
"e report must state its precision contract honestly");

require(SERIES.pi_report(1).value == "3", "one-digit pi must round to 3");
require(SERIES.e_report(1).value == "3", "one-digit e must round to 3");
require(rejected(fn() { SERIES.pi_report(0); }), "zero precision must fail");
require(rejected(fn() { SERIES.e_report(1001); }), "excessive precision must fail");
require(rejected(fn() { SERIES.parse_significant_digits("1e2"); }),
"precision parser must reject exponent notation");

let values = ["3", "-4", "12", "9007199254740992"];
let squares = SERIES.sum_of_squares_report(values);
require(squares.result == "81129638414606681695789005144233",
"sum of squares must remain exact beyond the safe number range");
require(str(values) == "[3, -4, 12, 9007199254740992]" and not squares.input_mutated,
"sum of squares must not mutate caller input");
require(SERIES.sum_of_squares_report([]).result == "0",
"empty sum of squares must use the additive identity");
require(str(SERIES.parse_integer_list(" 3, -4, +12 ")) == "[3, -4, 12]",
"integer list parser must normalize signed decimal values");
require(rejected(fn() { SERIES.parse_integer_list("1,,2"); }),
"empty integer list items must fail");
require(rejected(fn() { SERIES.parse_integer_list("1.5,2"); }),
"fractional values must fail");
require(rejected(fn() { SERIES.sum_of_squares_report("1,2"); }),
"non-array input must fail");

let oversized = [];
let oi = 0;
while oi < 1025 { array_push(oversized, "1"); oi = oi + 1; }
require(rejected(fn() { SERIES.sum_of_squares_report(oversized); }),
"sum-of-squares work must be bounded");

for source_path in [
    "examples/numerical_series_lab/series.sapp",
    "examples/numerical_series_lab/main.sapp",
    "examples/numerical_series_lab/test.sapp"
] {
    let report = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(report.ok and report.passed and not report.truncated and report.high == 0,
    "bounded security analysis must pass for " + source_path);
}

print "numerical_series_lab_pass";
