let Embedded = import("stdlib:embedded.sapp");

let circuit = Embedded.new_circuit(map{
    name:"Portable LED Lab",
    mode:"emulator"
});

if not Embedded.Circuit.add_device(circuit, "uno-led", "arduino-uno").ok {
    throw "could not create portable UNO circuit";
}
if not Embedded.Circuit.add_device(circuit, "esp-led", "esp32-devkitc-v4").ok {
    throw "could not create portable ESP32 circuit";
}

Embedded.Circuit.set_blink(circuit, "uno-led", true, 500, 3000);
Embedded.Circuit.set_led(circuit, "esp-led", true);

let sample = 0;
while sample < 7 {
    let state = Embedded.Circuit.snapshot(circuit);
    print json_stringify(map{
        time_ms:state.elapsed_ms,
        uno_on:state.devices[0].observed_on,
        esp_on:state.devices[1].observed_on
    });
    Embedded.Circuit.tick(circuit, 500);
    sample = sample + 1;
}

let final_state = Embedded.Circuit.snapshot(circuit);
assert(not final_state.devices[0].observed_on, "finite UNO blink finishes off");
assert(final_state.devices[1].observed_on, "independent ESP LED remains on");
