// Bounded Android userspace model with isolated service state.
let Android = import("stdlib:android_emulator.sapp");

let emulator = Android.new(34, "arm64", map{
    max_events: 64, memory_bytes: 65536, max_files: 16
});
let app = map{
    package: "org.pblang.example", min_sdk: 21, target_sdk: 34,
    activities: [map{ name: ".MainActivity", exported: true }],
    main_activity: ".MainActivity",
    permissions: ["android.permission.INTERNET"],
    allow_cleartext: false
};

if not Android.install(emulator, app).ok { throw "example install failed"; }
if not Android.start_activity(emulator, "system", app.package).ok {
    throw "example activity failed";
}
if not Android.register_service(emulator, app.package, map{
    name: "status", exported: false, response: map{ state: "ready" }
}).ok { throw "example service failed"; }

let first = Android.call_service(emulator, app.package, app.package,
    "status", map{});
first.response.state = "caller-local-change";
let second = Android.call_service(emulator, app.package, app.package,
    "status", map{});
if second.response.state != "ready" { throw "service state alias detected"; }

print map{ service: second.response, stats: Android.stats(emulator) };
