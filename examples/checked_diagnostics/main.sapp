// Combine smart warnings and gradual type errors without running source.
let DX = import("stdlib:diagnostics.sapp");
let source = "fn twice(x:number){return x+x;} let unused=1; twice();";
let report = DX.diagnose_checked(source);
assert(not report.ok and report.type_checked, "invalid call detected");
assert(report.counts.error > 0 and report.counts.warning > 0, "both kinds retained");
print DX.format(report);
// Use report.ok for a gate; filtering displayed diagnostics is presentation only.
let valid = DX.diagnose_checked("fn twice(x:number){return x+x;} print twice(2);");
assert(valid.ok and valid.type_checked, "valid source");
