// Automatic idle waits and cleanup: no pause/resume calls are required.
let S = import("stdlib:scheduler.sapp");
let state = map{ completed: 0 };
S.set_timeout(fn() { state.completed = state.completed + 1; }, 40);
S.set_timeout(fn() { state.completed = state.completed + 1; S.stop(); }, 120);
// The loop sleeps between deadlines. Each completed callback is removed.
S.run_loop();
print "Completed: " + str(state.completed);
print "Retained timers: " + str(S.retained_timers());
