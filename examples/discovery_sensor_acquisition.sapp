let A=import("stdlib:sensor_acquisition.sapp");
let frontend=A.frontend(5,10000,10000,0.000001);
let quantizer=A.quantize(frontend.steady_volts,3.3,12);
let storage=A.stream(1000,3,12,60);
assert(frontend.steady_volts==2.5 and quantizer.code==3102,"synthetic acquisition chain");
assert(storage.packed_total_bytes==300000 and storage.aligned_total_bytes==360000,"one minute storage plan");
let fullscale=A.quantize(3.3,3.3,12);assert(fullscale.code==4095,"full scale");
assert((try A.quantize(5,3.3,12) catch nil)==nil,"overrange rejected");
print json_stringify(map{frontend:frontend,quantizer:quantizer,storage:storage,fullscale:fullscale,synthetic:true});
