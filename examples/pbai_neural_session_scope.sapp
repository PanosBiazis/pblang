// Register a captured closer immediately; scope covers synchronous catchable exits.
let AI=import("stdlib/pbai.sapp");let R=import("stdlib:resource_scope.sapp");
fn cleanup(closer){return fn(){return map{ok:true,value:closer()};};}
fn use(session,mode){return fn(scope){
 scope.defer(cleanup(session.close));
 if mode=="bad_predict" {session.predict([]);}
 if mode=="overlap_evaluate" {session.evaluate([map{x:[0],y:4}]);}
 let evaluation=session.evaluate([map{x:[6,0],y:4}]);
 if evaluation.passed {session.promote();}
 return map{ok:true,value:session.predict([6,0])};
};}
let outcomes=[];
for mode in ["success","bad_predict","overlap_evaluate","success"] {
 let session=AI.neural_specialist_session([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
 let predict=session.predict;let result=R.with_scope(use(session,mode));
 let closed=try {predict([6,0]);false} catch true;
 assert(result.ok==(mode=="success") and result.cleanup_ok and result.cleanups_attempted==1 and closed,"scope closes on success, failure and recovery");
 assert(not session.close(),"scope already closed the session");
 push(outcomes,map{mode:mode,ok:result.ok,closed:closed,body_status:result.body_status});
}
print json_stringify(map{format:"pbai.session-scope.example.v1",outcomes:outcomes,physical_memory_release_verified:false});
