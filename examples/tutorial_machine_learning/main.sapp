// tutorial_machine_learning/main.sapp
// ── Machine Learning Pipeline Demo ──────────────────────────────────────
// Demonstrates: train/test split, simple linear regression, accuracy
// calculation, tensor operations, and data processing.
// Uses: arrays, maps, functions, math operations.
//
// This is a self-contained, pure-pblang implementation of a simple
// ML pipeline — no external ML libraries required.
//
// Run with:
//   pblang run examples/tutorial_machine_learning/main.sapp

let math = import("stdlib:math.sapp");
let ml   = import("stdlib:ml.sapp");

print "╔════════════════════════════════════════════════╗";
print "║   pblang Machine Learning Pipeline            ║";
print "║   Linear Regression from Scratch              ║";
print "╚════════════════════════════════════════════════╝";

// ── Step 1: Generate synthetic dataset ───────────────────────────────────
// We create a dataset with a linear relationship plus noise:
//   y = 3.5 * x + 10 + noise
// Then we recover the coefficients through linear regression.

print "\n=== Step 1: Generate Dataset ===";

fn generate_data(n, slope, intercept, noise_level) {
    let X = []; // features
    let y = []; // targets

    let i = 0;
    while i < n {
        let x = i * 0.5 + 1.0;   // evenly spaced x values
        let noise = 0.0;
        // Simple deterministic pseudo-noise based on position
        if num_mod(i, 3) == 0 { noise = noise_level; }
        if num_mod(i, 5) == 2 { noise = 0 - noise_level * 0.5; }

        let target = slope * x + intercept + noise;
        X[i] = x;
        y[i] = target;
        i = i + 1;
    }
    return map{ X: X, y: y };
}

let dataset = generate_data(30, 3.5, 10.0, 2.0);
print "Generated " + str(len(dataset.X)) + " data points";
print "First 5 rows:";

let i = 0;
while i < 5 {
    print "  x=" + str(dataset.X[i]) + ", y=" + str(dataset.y[i]);
    i = i + 1;
}

// ── Step 2: Train/Test Split ────────────────────────────────────────────

print "\n=== Step 2: Train/Test Split (80/20) ===";

// Build array of {x, y} pairs for ml.train_test_split
let paired_data = [];
let j = 0;
while j < len(dataset.X) {
    paired_data[j] = map{ x: dataset.X[j], y: dataset.y[j] };
    j = j + 1;
}

let split = ml.train_test_split(paired_data, 0.2);
let train_data = split.train;
let test_data  = split.test;

print "Train set: " + str(len(train_data)) + " samples";
print "Test set:  " + str(len(test_data)) + " samples";

// Extract X and y from split data
fn unpack(data) {
    let X = [];
    let y = [];
    let i = 0;
    while i < len(data) {
        X[i] = data[i].x;
        y[i] = data[i].y;
        i = i + 1;
    }
    return map{ X: X, y: y };
}

let train = unpack(train_data);
let test  = unpack(test_data);

// ── Step 3: Simple Linear Regression ────────────────────────────────────
// Fit a line: y = w * x + b
// Using closed-form solution for simple linear regression:
//   w = Σ((x - mean_x) * (y - mean_y)) / Σ((x - mean_x)^2)
//   b = mean_y - w * mean_x

print "\n=== Step 3: Fit Linear Regression ===";

fn mean(arr) {
    if len(arr) == 0 { return 0.0; }
    let total = 0.0;
    let i = 0;
    while i < len(arr) {
        total = total + arr[i];
        i = i + 1;
    }
    return total / len(arr);
}

fn linear_regression_fit(X, y) {
    let n = len(X);
    if n == 0 { return map{ slope: 0.0, intercept: 0.0 }; }

    let mean_x = mean(X);
    let mean_y = mean(y);

    // Compute covariance(X, y) and variance(X)
    let cov_xy = 0.0;
    let var_x = 0.0;
    let i = 0;
    while i < n {
        let dx = X[i] - mean_x;
        let dy = y[i] - mean_y;
        cov_xy = cov_xy + dx * dy;
        var_x = var_x + dx * dx;
        i = i + 1;
    }

    let slope = 0.0;
    if var_x != 0.0 { slope = cov_xy / var_x; }
    let intercept = mean_y - slope * mean_x;

    return map{ slope: slope, intercept: intercept };
}

let model = linear_regression_fit(train.X, train.y);

print "True relationship:  y = 3.50 * x + 10.00";
print "Learned model:      y = " + str(model.slope) + " * x + " + str(model.intercept);

let slope_err = model.slope - 3.5;
if slope_err < 0 { slope_err = 0 - slope_err; }
let inter_err = model.intercept - 10.0;
if inter_err < 0 { inter_err = 0 - inter_err; }

print "Slope error:       " + str(slope_err);
print "Intercept error:   " + str(inter_err);

// ── Step 4: Predict on test set ──────────────────────────────────────────

print "\n=== Step 4: Predict on Test Set ===";

fn predict(X, model) {
    let preds = [];
    let i = 0;
    while i < len(X) {
        preds[i] = model.slope * X[i] + model.intercept;
        i = i + 1;
    }
    return preds;
}

let y_pred = predict(test.X, model);

print "Test set predictions vs actual:";
let k = 0;
while k < len(test.X) {
    print "  x=" + str(test.X[k]) + " | actual=" + str(test.y[k]) +
          " | predicted=" + str(y_pred[k]) +
          " | error=" + str(test.y[k] - y_pred[k]);
    k = k + 1;
}

// ── Step 5: Evaluate Model Accuracy ─────────────────────────────────────

print "\n=== Step 5: Model Evaluation ===";

// Mean Squared Error
fn mse_custom(actual, predicted) {
    if len(actual) == 0 { return 0.0; }
    let total = 0.0;
    let i = 0;
    while i < len(actual) {
        let diff = actual[i] - predicted[i];
        total = total + diff * diff;
        i = i + 1;
    }
    return total / len(actual);
}

// R-squared
fn r2_custom(actual, predicted) {
    if len(actual) == 0 { return 0.0; }
    let mean_y = mean(actual);
    let ss_res = 0.0;
    let ss_tot = 0.0;
    let i = 0;
    while i < len(actual) {
        ss_res = ss_res + (actual[i] - predicted[i]) * (actual[i] - predicted[i]);
        ss_tot = ss_tot + (actual[i] - mean_y) * (actual[i] - mean_y);
        i = i + 1;
    }
    if ss_tot == 0.0 { return 0.0; }
    return 1.0 - ss_res / ss_tot;
}

let mse_val = mse_custom(test.y, y_pred);
let rmse_val = num_sqrt(mse_val);
let r2_val = r2_custom(test.y, y_pred);

print "MSE:  " + str(mse_val);
print "RMSE: " + str(rmse_val);
print "R²:   " + str(r2_val);

// ── Step 6: Feature Scaling Demo ────────────────────────────────────────

print "\n=== Step 6: Feature Scaling ===";

let raw_features = [1.0, 5.0, 10.0, 100.0, 500.0, 1000.0];
print "Raw features:    " + json_stringify(raw_features);

let standardized = ml.standardize(raw_features);
print "Standardized:    " + json_stringify(standardized);

// ── Step 7: Cross-Validation Demo ───────────────────────────────────────

print "\n=== Step 7: 3-Fold Cross-Validation ===";

fn model_fn(X_train, y_train) {
    let m = linear_regression_fit(X_train, y_train);
    return fn(X_test) { return predict(X_test, m); };
}

let cv_result = ml.cross_validate(train.X, train.y, model_fn, 3);
print "Cross-validation scores: " + json_stringify(cv_result.scores);
print "Mean CV score: " + str(cv_result.mean);

// ── Step 8: Summary Report ───────────────────────────────────────────────

print "\n╔════════════════════════════════════════════════╗";
print "║   ML Pipeline Summary                         ║";
print "╚════════════════════════════════════════════════╝";

print "Model:          Linear Regression (closed form)";
print "True params:    y = 3.50x + 10.00";
print "Learned params: y = " + str(model.slope) + "x + " + str(model.intercept);
print "Train samples:  " + str(len(train.X));
print "Test samples:   " + str(len(test.X));
print "R² score:       " + str(r2_val);
print "RMSE:           " + str(rmse_val);
print "CV mean score:  " + str(cv_result.mean);

print "\n=== Done! ===";
