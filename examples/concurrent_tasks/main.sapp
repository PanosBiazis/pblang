// Concurrent Tasks Example — demonstrating async/pool patterns
let async_mod = import("stdlib:async.sapp");
let bench = import("stdlib:benchmark.sapp");

print "=== Concurrent Task Example ===";

// 1. Basic goroutine (async.go / async.await)
print "\n--- Goroutines ---";
let t1 = async_mod.go(fn() {
    sleep_ms(10);
    return "task 1 result";
});
let t2 = async_mod.go(fn() {
    sleep_ms(5);
    return "task 2 result";
});

let r1 = async_mod.await(t1);
let r2 = async_mod.await(t2);
print "Result 1: " + r1;
print "Result 2: " + r2;

// 2. Task pool
print "\n--- Task Pool (4 workers, 8 tasks) ---";
// Return from the factory before transferring each closure: its capture is
// closed and transferable instead of still referring to the caller's stack.
fn task_factory(task_id) {
    return fn() {
        sleep_ms(task_id * 2);
        return "task_" + str(task_id) + "_done";
    };
}
let tasks = [];
for i 8 { tasks[i] = task_factory(i); }

let pool_results = async_mod.pool(4, tasks);
assert(len(pool_results) == 8 and pool_results[7] == "task_7_done", "pool preserves closed captures");
print "Pool results:";
for i len(pool_results) {
    print "  [" + str(i) + "] " + str(pool_results[i]);
}

// 3. Timeout
print "\n--- Timeout ---";
let slow_result = async_mod.timeout(50, fn() {
    sleep_ms(10);
    return "finished in time";
});
if not slow_result.ready { print "Deadline expired; waiting for owned task during cleanup."; }
let slow_final = async_mod.all_settled([slow_result.future])[0];
assert(slow_final.ok and slow_final.value == "finished in time", "timeout task is joined");
print "Timeout result: " + str(slow_final.value);

// 4. Benchmark comparison
print "\n--- Benchmark ---";
fn fib(n) {
    if n <= 1 { return n; }
    return fib(n - 1) + fib(n - 2);
}
assert(fib(20) == 6765, "recursive benchmark result");
let b = bench.run("fibonacci_20", fn() { return fib(20); }, 10);
print "fib(20): avg=" + str(b.avg_ms) + "ms over " + str(b.iterations) + " iterations";
print "Done!";
