// Compile with tools/pbc.sapp --target pbck --out pipeline.pbck, then execute
// with pblang run pipeline.pbck --allow-all in this example's trusted project.
// Imports remain runtime imports; the artifact is not a standalone binary.
let T=import("stdlib:thread.sapp");
for batch 3 {
    let p=T.pipeline([map{process:fn(value){return value*2;},workers:1}]);
    print (try {p:run([1,2,3])} catch []);
}
