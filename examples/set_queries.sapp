let S=import("stdlib:set.sapp");
let numbers=S.from_array([1,2,3,4,5]);
let parts=S.partition(numbers,fn(v){return v%2==0;});
print S.to_array(parts.matched); // [2,4]
print S.to_array(parts.rejected); // [1,3,5]
assert(S.intersection_size(numbers,S.from_array([2,4,6]))==2,"common members");
assert(S.is_proper_subset(parts.matched,numbers),"proper subset");
