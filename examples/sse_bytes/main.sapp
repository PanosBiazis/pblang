// Each call supplies real bytes; the emoji and initial BOM cross chunk boundaries.
let S = import("stdlib:sse_bytes.sapp");
let reader = S.new(map{ chunk_bytes: 32, total_bytes: 128 });
let chunks = [[239], [187,191,100,97,116,97,58,32,240,159], [152], [128,13], [10,13,10]];
for chunk in chunks {
    for event in reader.feed(chunk) { print event.event + " data=" + event.data; }
}
reader.finish();
print reader.status().phase;
