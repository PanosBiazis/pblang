let A = import("stdlib:async.sapp");
// Return data across threads. Function values are not channel payloads.
let bad = A.go(fn(){return fn(){return 1;};});
let outcome = A.all_settled([bad])[0];
assert(not outcome.ok, "unsupported transfer fails without a long empty wait");
let items=[];
for i 32 {array_push(items,i);}
// Independent waiting jobs can use explicit concurrency when budget permits.
// Numeric/CPU work keeps the economical default unless measurement says otherwise.
let results=A.map_parallel(items,fn(x){sleep_ms(5);return x;},32);
assert(results[31] == 31, "ordered results with explicit parallelism");
print "transfer failure handled; independent waiting jobs completed";
