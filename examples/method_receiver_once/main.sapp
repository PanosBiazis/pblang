// Same expression runs through the PBLang-owned frontend/VM.
let FE = import("stdlib:compiler/selfhost_frontend.sapp");
let source = "let created=0;fn counter(){created=created+1;return map{value:created,read:fn(self){return self.value;}};}"
    + "print counter():read();print created;";
let result = FE.frontend_run(source);
assert(result.ok, "method example compiles and runs");
assert(result.output == [1,1], "receiver created once");
print result.output;
