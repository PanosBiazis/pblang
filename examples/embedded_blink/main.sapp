let Embedded = import("stdlib:embedded.sapp");
let Linux = import("stdlib:embedded_linux.sapp");
let ESP32 = import("stdlib:codegen_esp32_embedded.sapp");

// One portable application. Board aliases map status-led-test to UNO D7,
// classic ESP32 GPIO23, and a safe external GPIO on Pico-family boards.
let app = Embedded.blink("status-led-test", 500);
let uno = Embedded.build(app, "arduino-uno");
let esp_board = Embedded.board_info("esp32-devkitc-v4");
let esp32 = ESP32.compile(Embedded.IR.lower(app,esp_board));
let pico = Embedded.build(app, "raspberry-pi-pico");

print json_stringify(map{
    portable_program:app.metadata,
    uno:map{ok:uno.ok,backend:try uno.backend catch "",bytes:try uno.bytes catch 0},
    esp32:map{ok:esp32.ok,backend:esp32.backend,bytes:esp32.bytes,
        ram_loadable:esp32.ram_loadable,flash_bootable:esp32.flash_bootable,
        persistent_flash_ready:esp32.persistent_flash_ready},
    pico:map{ok:pico.ok,status:try pico.status catch "",error:try pico.error catch ""},
    connected:Linux.devices(),
    boundary:"UNO is general digital-write; ESP32 is the verified fixed GPIO23 500 ms blink slice"
});
