// Normalize synthetic metadata only; no dependency is loaded or file published.
let Lock=import("stdlib:portable_lock.sapp");
let manifest="[dependencies]\ndemo = { path = '../lib,a#b=c' }\n";
let digest=str_repeat("a",64);
let lock="content_hash_algorithm = \"pblang-package-tree-v2\"\n[dependencies.demo]\npath = \"/workspace/lib,a#b=c\"\nsha256 = \""+digest+"\"\n";
let result=Lock.normalize_text(manifest,lock,"/workspace/project");
assert(result.rewritten==1,"one relative dependency path");
print result.text;
