// Synthetic form migration: DFM structure -> detached overlay -> responsive web.
// Foreign Pascal handlers stay inert; the calculation below is written in PBLang.
let DFM=import("stdlib:ui_form_delphi_dfm.sapp");
let Doc=import("stdlib:ui_document.sapp");
let Overlay=import("stdlib:ui_form_overlay.sapp");
let Web=import("stdlib:ui_form_web.sapp");
let source="object QuoteForm: TForm1\n Caption = 'Quotation'\n ClientWidth = 480\n ClientHeight = 320\n"
+ " object Quantity: TEdit\n Left = 8\n Top = 8\n Width = 200\n Height = 30\n Text = '2'\n end\n"
+ " object Price: TEdit\n Left = 8\n Top = 48\n Width = 200\n Height = 30\n Text = '15'\n end\n"
+ " object Calculate: TButton\n Left = 8\n Top = 88\n Width = 200\n Height = 30\n Caption = 'Calculate'\n OnClick = CalculateClick\n end\nend\n";
let imported=DFM.import_text(source, "quotation.dfm");
if not imported.ok { throw "Synthetic DFM import failed"; }
let adapted=Overlay.apply(imported.document, [
map{id:"Quantity", set:map{props:map{hint:"Quantity (whole units)"}}},
map{id:"Price", set:map{props:map{hint:"Price per unit (whole currency units)"}}},
map{id:"Calculate", set:map{props:map{text:"Calculate total in PBLang"}}}
]);
// A second form built directly in PBLang, sharing the same web surface.
let notes=Doc.from_design(map{form:map{title:"Review", w:480, h:200}, model:map{}, widgets:[
    map{name:"Comment", kind:"textarea", x:0, y:0, w:300, h:90, props:map{value:"", hint:"Review comment (not saved)"}},
    map{name:"Preview", kind:"button", x:0, y:100, w:200, h:30, props:map{text:"Preview comment"}}
    ]});
let combined=Overlay.compose([map{prefix:"quote", document:adapted}, map{prefix:"review", document:notes}], "Form workbench");
fn whole(text) {
    // Business rule for this example only; no evaluation of expressions.
    if type(text) != "string" or len(text) < 1 or len(text) > 6 or not regex_match(text, "^[0-9]+$") { throw "Enter a whole number with at most six digits"; }
    return parse_number(text);
}

fn calculate(values) {
    let quantity=try whole(values["quote.Quantity"]) catch nil;
    let price=try whole(values["quote.Price"]) catch nil;
    if quantity == nil or price == nil { return "Enter whole numbers from 0 to 999999."; }
    return "Total: " + str(quantity * price) + " currency units";
}

fn review(values) { return "Comment preview: " + values["review.Comment"]; }
let actions=map{"quote.Calculate":calculate, "review.Preview":review};
let args=try env_get("PBLANG_SCRIPT_ARGS") catch "";
if args != nil and args != "" and args != "--serve" { throw "usage: main.sapp [--serve]"; }
let serving=args == "--serve";
if serving {
    print "Open 127.0.0.1:8766. Local synthetic-data preview; Ctrl+C stops it.";
    Web.serve(combined, actions);
} else {
    let app=Web.create(combined, actions);
    let response=app.handle(map{method:"GET", path:"/", headers:map{host:"127.0.0.1:8766"}, body:""});
    assert(response.status == 200 and str_contains(response.body, "Calculate total in PBLang"), "composed preview");
    assert(calculate(map{"quote.Quantity":"2", "quote.Price":"15"}) == "Total: 30 currency units", "calculation");
    app.close(); print "form_workbench_pass";
}
