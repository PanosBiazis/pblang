// Check generated source without loading the execution VM or running the source.
let CHECK = import("stdlib:compiler/source_analysis.sapp");
let valid = CHECK.analyze("fn double(x:number){return x * 2;} print double(3);");
assert(valid.ok, "valid example");
let invalid = CHECK.analyze("let value=nil-1;");
assert(not invalid.ok and invalid.diagnostics[0].code == "nil-arithmetic", "invalid example");
print "valid program: " + str(valid.ok);
print "invalid program: " + invalid.errors[0];
