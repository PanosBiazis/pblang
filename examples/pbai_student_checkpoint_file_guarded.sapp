// Compilation input: use the documented PBCK --entry/--cleanup command.
// Ordinary source execution does not invoke this explicit guarded entry.
let AI=import("stdlib/pbai.sapp");
let IO=import("stdlib:pbai_student_checkpoint_io.sapp");
let storage=AI.neural_specialist_checkpoint_bind(IO);
let state=map{owners:[],active:nil,retired:nil,predict:nil,ready:false,outcome:nil};
fn checkpoint_acquire(path){
 let handle=storage.load_file(path);
 // Capture ownership immediately, before checkpoint/prediction can fail.
 let owner=map{handle:handle,release:handle.close,attempted:false,closed:false};
 push(state.owners,owner);
 return owner;
}
fn checkpoint_close_once(owner){
 assert(not owner.attempted,"checkpoint cleanup already attempted");
 owner.attempted=true;
 let closed=owner.release();
 if type(closed)!="bool" {throw "invalid checkpoint close result";}
 owner.closed=closed;
 return closed;
}
fn checkpoint_work(){
 let directory=env_get("PBAI_CHECKPOINT_TEST_DIR");
 let phase=env_get("PBAI_CHECKPOINT_TEST_PHASE");
 assert(type(directory)=="string" and directory!="","explicit private checkpoint directory required");
 assert(phase=="read" or phase=="reload","select guarded read or reload phase");
 state.active=checkpoint_acquire(path_join(directory,"student.json"));
 let loaded=false;
 if phase=="reload" {
  let before=state.active.handle.checkpoint().digest;
  // Failed candidate admission retains the current model, matching the example.
  let replacement=try checkpoint_acquire(path_join(directory,"candidate.json")) catch nil;
  loaded=replacement!=nil;
  if loaded {
   state.retired=state.active;state.active=replacement;
   checkpoint_close_once(state.retired);
  } else {assert(state.active.handle.checkpoint().digest==before,"failed reload preserves previous model");}
 }
 state.predict=state.active.handle.predict;
 let prediction=state.predict([6,0]);
 if phase=="read" {assert(prediction.token==5,"restored synthetic learned prediction");}
 state.outcome=map{format:"pbai.checkpoint-file.example.v1",phase:phase,token:prediction.token,
  active_closed:false,active_prediction_blocked:false,globally_activated:false};
 if phase=="reload" {
  state.outcome.loaded=loaded;state.outcome.previous_retained=not loaded;
  state.outcome.retired_closed=false;
 }
 state.ready=true;
}
fn checkpoint_release(){
 let failed=false;let index=len(state.owners)-1;
 while index>=0 {
  let owner=state.owners[index];
  if not owner.attempted {
   let result=try checkpoint_close_once(owner) catch nil;
   if type(result)!="bool" {failed=true;}
  }
  index=index-1;
 }
 if state.ready {
  state.outcome.active_closed=state.active.closed;
  state.outcome.active_prediction_blocked=try {state.predict([6,0]);false} catch true;
  if not state.outcome.active_prediction_blocked {failed=true;}
  if state.retired!=nil {state.outcome.retired_closed=state.retired.closed;}
 }
 // All release outcomes are settled before reporting or propagating failure.
 if failed {throw "checkpoint guarded cleanup failed";}
 if state.ready {print json_stringify(state.outcome);}
}
