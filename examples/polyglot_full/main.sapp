// examples/polyglot_full/main.sapp — Comprehensive Polyglot System Demo
//
// Demonstrates the full pblang polyglot system:
//   - Detects all installed languages on the system
//   - Runs code in each detected language
//   - Shows cross-language calls (pblang→python, pblang→js, etc.)
//   - Demonstrates FFI bridge usage
//   - Pretty-prints a language availability table
//   - Shows language recommendation engine
//
// Run with: pblang run examples/polyglot_full/main.sapp

// ── Helpers ───────────────────────────────────────────────────────────────────

fn _pad_right(s, width) {
    let str_val = str(s);
    let pad = width - len(str_val);
    let result = str_val;
    if pad > 0 {
        let i = 0;
        while i < pad {
            result = result + " ";
            i = i + 1;
        }
    }
    return result;
}

fn unsafe_polyglot(code) {
    return map{ trusted_source: true, unsafe_polyglot: true,
        unsafe_polyglot_sha256: sha256(code) };
}

print "╔══════════════════════════════════════════════════════════════╗";
print "║        pblang — Comprehensive Polyglot System Demo          ║";
print "╠══════════════════════════════════════════════════════════════╣";

// ── Load modules ──────────────────────────────────────────────────────────────

print "║ Loading polyglot modules...                                   ║";

let reg = try import("stdlib:polyglot_registry.sapp") catch nil;
if reg == nil {
    print "║ FAILED to load polyglot_registry.sapp                        ║";
    print "╚══════════════════════════════════════════════════════════════╝";
    return;
}

let ffi_uni = try import("stdlib:ffi_universal.sapp") catch nil;
let ip = try import("stdlib:interop.sapp") catch nil;
let pb = try import("stdlib:polyglot_build.sapp") catch nil;

// ── Platform Info ─────────────────────────────────────────────────────────────

let plat = platform();
print "║ Platform: " + _pad_right(plat, 56) + "║";
print "╠══════════════════════════════════════════════════════════════╣";

// ── Language Detection ────────────────────────────────────────────────────────

print "║ Detecting installed languages...                              ║";
print "╠══════════════════════════════════════════════════════════════╣";

let installed = reg.detect_all();
let all_langs = reg.list_languages();

print "║ Language                    Category     Bridge      Available ║";
print "║ ───────────────────────────────────────────────────────────  ║";

let av_count = 0;
let total_count = len(all_langs);
for i len(all_langs) {
    let lang = all_langs[i];
    let name_col = _pad_right(lang.name, 22);
    let cat_col = _pad_right(lang.category, 12);
    let bridge_col = _pad_right(lang.bridge, 11);
    let avail_mark = " ✗ ";
    if lang.available {
        avail_mark = " ✓ ";
        av_count = av_count + 1;
    }
    print "║ " + avail_mark + " " + name_col + " " + cat_col + " " + bridge_col + "   ║";
}

print "║ ───────────────────────────────────────────────────────────  ║";
let summary = str(av_count) + " of " + str(total_count) + " languages available";
print "║ " + _pad_right(summary, 62) + "║";
print "╠══════════════════════════════════════════════════════════════╣";

// ── Run Code in Detected Languages ────────────────────────────────────────────

if len(installed) > 0 {
    print "║ Testing code execution in detected languages...               ║";
    print "║ (Running a simple expression in each)                         ║";
    print "╠══════════════════════════════════════════════════════════════╣";

    // Test Python
    if reg.is_available("python") {
        let code = "print('Hello from Python via pblang!')";
        let py_result = reg.run("python", code, unsafe_polyglot(code));
        if py_result.ok {
            print "║ [python]   ✓ " + _pad_right(str_trim(py_result.stdout), 49) + "║";
        } else {
            print "║ [python]   ✗ failed                                         ║";
        }
    }

    // Test Node.js
    if reg.is_available("javascript") {
        let code = "console.log('Hello from Node.js via pblang!');";
        let js_result = reg.run("javascript", code, unsafe_polyglot(code));
        if js_result.ok {
            print "║ [node.js]  ✓ " + _pad_right(str_trim(js_result.stdout), 49) + "║";
        } else {
            print "║ [node.js]  ✗ failed                                         ║";
        }
    }

    // Test Bash
    if reg.is_available("bash") {
        let code = "echo 'Hello from Bash via pblang!'";
        let sh_result = reg.run("bash", code, unsafe_polyglot(code));
        if sh_result.ok {
            print "║ [bash]     ✓ " + _pad_right(str_trim(sh_result.stdout), 49) + "║";
        } else {
            print "║ [bash]     ✗ failed                                         ║";
        }
    }

    // Test Go
    if reg.is_available("go") {
        let code = "package main\n\nimport \"fmt\"\n\nfunc main() {\n\tfmt.Println(\"Hello from Go via pblang!\")\n}\n";
        let go_result = reg.run("go", code, unsafe_polyglot(code));
        if go_result.ok {
            print "║ [go]       ✓ " + _pad_right(str_trim(go_result.stdout), 49) + "║";
        } else {
            print "║ [go]       ✗ failed                                         ║";
        }
    }

    // Test Ruby
    if reg.is_available("ruby") {
        let code = "puts 'Hello from Ruby via pblang!'";
        let rb_result = reg.run("ruby", code, unsafe_polyglot(code));
        if rb_result.ok {
            print "║ [ruby]     ✓ " + _pad_right(str_trim(rb_result.stdout), 49) + "║";
        } else {
            print "║ [ruby]     ✗ failed                                         ║";
        }
    }

    // Test Perl
    if reg.is_available("perl") {
        let code = "print \"Hello from Perl via pblang!\\n\";";
        let pl_result = reg.run("perl", code, unsafe_polyglot(code));
        if pl_result.ok {
            print "║ [perl]     ✓ " + _pad_right(str_trim(pl_result.stdout), 49) + "║";
        } else {
            print "║ [perl]     ✗ failed                                         ║";
        }
    }
}

// ── Language Recommendation ───────────────────────────────────────────────────

print "╠══════════════════════════════════════════════════════════════╣";
print "║ Language Recommendation Engine                                ║";
print "║ ───────────────────────────────────────────────────────────  ║";

let tasks = ["web server api", "ai machine learning", "systems programming",
             "android mobile", "ios app", "frontend ui", "scripting glue",
             "statistics data", "text parsing", "game development",
             "cross compile", "functional programming", "devops ci/cd"];

for i len(tasks) {
    let task = tasks[i];
    let rec = reg.best_for(task);
    let line = "\"" + task + "\" → " + rec.recommended;
    print "║ " + _pad_right(line, 62) + "║";
}

// ── FFI Universal Bridge ──────────────────────────────────────────────────────

print "╠══════════════════════════════════════════════════════════════╣";
print "║ FFI Universal Bridge                                          ║";
print "║ ───────────────────────────────────────────────────────────  ║";

if ffi_uni != nil {
    print "║ FFI types available:                                          ║";
    let types_list = ffi_uni.list_types();
    let type_line = "";
    for type_i len(types_list) {
        let t = types_list[type_i];
        if type_i > 0 { type_line = type_line + ", "; }
        type_line = type_line + t.type + "(" + str(t.size) + "B)";
    }
    print "║ " + _pad_right(type_line, 62) + "║";

    // Struct example
    let point_def = ffi_uni.struct_define("Point", [
        map{ name: "x", type: "int" },
        map{ name: "y", type: "int" },
    ]);
    print "║ Struct 'Point' defined: " + str(point_def.field_count) + " fields, " + str(point_def.total_size) + " bytes                ║";

    let packed = ffi_uni.struct_pack("Point", map{ x: 10, y: 20 });
    print "║ Packed Point(x=10, y=20): " + str(packed.packed) + _pad_right("", 30) + "║";

    let unpacked = ffi_uni.struct_unpack("Point", packed.packed);
    print "║ Unpacked: x=" + str(unpacked.values.x) + " y=" + str(unpacked.values.y) + _pad_right("", 40) + "║";
} else {
    print "║ ffi_universal.sapp not available                               ║";
}

// ── Interop Utilities ─────────────────────────────────────────────────────────

print "╠══════════════════════════════════════════════════════════════╣";
print "║ Interop Utilities                                             ║";
print "║ ───────────────────────────────────────────────────────────  ║";

if ip != nil {
    // Serialization test
    let test_val = map{ name: "pblang", version: 1, active: true, tags: ["polyglot", "ffi"] };
    let serialized = ip.serialize_to("python", test_val);
    print "║ serialize_to(python):                                         ║";
    print "║   " + _pad_right(serialized, 58) + "║";

    let lua_serialized = ip.serialize_to("lua", test_val);
    print "║ serialize_to(lua):                                            ║";
    print "║   " + _pad_right(lua_serialized, 58) + "║";
} else {
    print "║ interop.sapp not available                                    ║";
}

// ── Polyglot Build ────────────────────────────────────────────────────────────

print "╠══════════════════════════════════════════════════════════════╣";
print "║ Polyglot Build System                                         ║";
print "║ ───────────────────────────────────────────────────────────  ║";

if pb != nil {
    // Show block extraction
    let sample = "@python {\nprint('hello')\n}\n\n@js {\nconsole.log('world');\n}";
    let blocks = pb.extract_blocks(sample);
    print "║ Block extraction from sample: " + str(len(blocks)) + " blocks found               ║";
    for block_i len(blocks) {
        print "║   Block " + str(block_i) + ": @" + blocks[block_i].language + _pad_right("", 50) + "║";
    }

    // Show available build functions
    let build_fns = 22;
    print "║ Build functions: " + str(build_fns) + " languages supported                         ║";
} else {
    print "║ polyglot_build.sapp not available                             ║";
}

// ── Final Summary ─────────────────────────────────────────────────────────────

print "╠══════════════════════════════════════════════════════════════╣";
print "║ Demo Complete                                                 ║";
print "║                                                               ║";
print "║ Modules demonstrated:                                         ║";
print "║  ✓ polyglot_registry.sapp — language detection & execution    ║";
print "║  ✓ polyglot_build.sapp   — multi-language build system        ║";
if ffi_uni != nil {
    print "║  ✓ ffi_universal.sapp    — universal FFI bridge               ║";
}
if ip != nil {
    print "║  ✓ interop.sapp          — cross-language utilities           ║";
}
print "║                                                               ║";
print "║ System: " + _pad_right(plat + " — " + str(av_count) + "/" + str(total_count) + " languages detected", 47) + "║";
print "╚══════════════════════════════════════════════════════════════╝";

// _pad_right defined at top of file
