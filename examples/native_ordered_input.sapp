// Optional Linux X11 queue plus existing smooth GUI text. Other platforms retain
// legacy input. No automatic save, telemetry, injection, or external process.
let G=import("stdlib:graphics.sapp");let GUI=import("stdlib:gui.sapp");
let form=GUI.form("PBLang ordered input",720,300);form.text_render="auto";
let heading=GUI.label("heading",24,20,"Κείμενο / Text");heading.w=660;heading.h=30;GUI.add(form,heading);
GUI.add(form,GUI.textbox("entry",24,64,660,38,""));
GUI.add(form,GUI.textarea("notes",24,120,660,140,""));form.focus="entry";
let window=G.Window(form.w,form.h,form.title,map{ordered_input:true});
print "Input backend: "+window.input_backend;
G.run(window,form,fn(current,events) {for event in events {GUI.handle_event(current,event);}if current.close_requested {current.graphics_stop=true;}return current.dirty;},
    fn(current,canvas) {GUI.draw(canvas,current);},30);
