// Compile with tools/pbc.sapp --target pbck --entry work --cleanup release.
// Set PBLANG_CLEANUP_DEMO_FAIL=1 during execution to exercise a real host error.
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let context=V.execution_context(true);
fn work() {
    let setup=F.frontend_compile("memory_alloc(7);");
    V.run_seeded(setup.chunk,map{},context);
    if env_get("PBLANG_CLEANUP_DEMO_FAIL")=="1" {
        let invalid=map{
            instructions:[map{op:0,operand:0},map{op:0,operand:1},map{op:27,operand:0}],
            constants:[[],map{}]
        };
        V.run_seeded(invalid,map{},context);
    }
    print "work completed";
}
fn release() {
    let owned=context.memory;
    V.close_execution(context);
    if owned!=nil {assert(owned.closed and len(owned.owners)==0,"all managed owners released");}
    print "resources released";
}
