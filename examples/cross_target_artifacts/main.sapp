let Target = import("stdlib:target_artifact.sapp");

let ir = [["seti",0,0],["seti",1,10],["loop",1,[["add",0,1]]]];
let requests = [
    ["dos","6.22","x86"], ["cpm","2.2","z80"],
    ["linux","2.6","x86"], ["linux","2.6","x86_64"],
    ["windows","5.1","x86"], ["windows","5.2","x86_64"]
];
let i = 0;
while i < len(requests) {
    let r = requests[i]; let plan = Target.plan(r[0], r[1], r[2]);
    if plan.ok {
        let artifact = Target.build_ir(plan, ir);
        print plan.os + " " + plan.version + " " + plan.arch + " -> "
            + plan.executable_format + " " + str(artifact.size) + " bytes " + plan.status;
    } else {
        print r[0] + ": unavailable: " + plan.error;
    }
    i = i + 1;
}

let unavailable = Target.plan("android", "21", "arm64");
print "android native available=" + str(unavailable.ok) + " fallback=" + unavailable.portable_fallbacks[0];
