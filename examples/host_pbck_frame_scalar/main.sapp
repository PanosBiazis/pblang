let Plan = import("stdlib:host_pbck_frame_plan.sapp");
let Scalar = import("stdlib:host_pbck_frame_scalar.sapp");

// A portable scalar function: add two arguments, with 5 as the second default.
let add = map{
    __pbck_function: true, name: "add", arity: 2, min_arity: 1,
    defaults: [5], is_vararg: false, parameter_types: [],
    chunk: map{ instructions: [
        map{ op: 25, operand: 0 }, map{ op: 25, operand: 1 },
        map{ op: 1 }, map{ op: 33 }
    ], constants: [], source_name: nil }
};
let decoded = map{
    format: "host-pbck-v1", version: 1,
    chunk: map{ instructions: [map{ op: 33 }], constants: [add], source_name: nil }
};

let plan = Plan.build_decoded(decoded);
let program = Scalar.prepare(plan, 1);
let result = Scalar.run_prepared(program, [37]);
print "value=" + str(result.value)
    + " steps=" + str(result.steps)
    + " peak_stack=" + str(result.peak_stack)
    + " peak_locals=" + str(result.peak_locals);
