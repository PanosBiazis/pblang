// pblang:target=kernel
// pblang:extern heap_init heap_alloc heap_free _guarded_heap_free_from _kernel_memory_enter _kernel_memory_leave
// All 120 free orders, with/without intervening live guards and cursor reuse.
fn verify(ok) { if not ok {outb(244,1);while 1>0 {hlt();}} }
fn check_list(h, arena, expected) {
    let p=peek32(h);let end=arena-1;let total=0;let nodes=0;
    while p!=0 {
        verify(p>=arena and p<arena+4096 and p>end);
        let size=peek32(p);verify(size>=16 and p+size<=arena+4096);
        total=total+size;end=p+size;nodes=nodes+1;verify(nodes<=12);
        p=peek32(p+4);
    }
    verify(total==expected);
}
fn kmain() {
    let h=kmalloc(8);let arena=kmalloc(4096);let objects=kmalloc(20);let guards=kmalloc(20);
    let mode=0;let cases=0;
    while mode<4 {
        let encoded=0;
        while encoded<3125 {
            let digits=encoded;let mask=0;let valid=1;let i=0;
            while i<5 {let d=digits%5;digits=digits/5;let bit=bit_shl(1,d);if bit_and(mask,bit)!=0 {valid=0;}mask=bit_or(mask,bit);i=i+1;}
            if valid!=0 {
                heap_init(h,arena,4096);let used=0;i=0;
                while i<5 {
                    let p=heap_alloc(h,8+i*8);verify(p!=0);poke32(objects+i*4,p);poke32(p,100+i);used=used+16+i*8;
                    if mode>=2 {let guard=heap_alloc(h,8);verify(guard!=0);poke32(guards+i*4,guard);poke32(guard,700+i);used=used+16;}
                    i=i+1;
                }
                let flags=_kernel_memory_enter();let cursor=0;digits=encoded;i=0;
                while i<5 {
                    let d=digits%5;digits=digits/5;let p=peek32(objects+d*4);verify(peek32(p)==100+d);
                    if mode%2==0 {cursor=0;}
                    cursor=_guarded_heap_free_from(h,p,cursor);verify(cursor>=arena and cursor<=p-8);
                    used=used-16-d*8;check_list(h,arena,4096-used);i=i+1;
                }
                _kernel_memory_leave(flags);
                if mode>=2 {i=0;while i<5 {let guard=peek32(guards+i*4);verify(peek32(guard)==700+i);heap_free(h,guard);i=i+1;}}
                verify(peek32(h)==arena and peek32(arena)==4096 and peek32(arena+4)==0);
                let full=heap_alloc(h,4088);verify(full==arena+8);heap_free(h,full);cases=cases+1;
            }
            encoded=encoded+1;
        }
        mode=mode+1;
    }
    verify(cases==480);outb(244,42);while 1>0 {hlt();}
}
