let OS = import("stdlib:os.sapp");
let MODEL = import("examples/pico_button_led/model.sapp");

fn usage() {
    print "Pico button and LED";
    print "  demo      Run the deterministic bounce/debounce simulation";
    print "  firmware  Report portable IR and native backend status";
    print "  manual    Print the board, pin, and wiring manual";
}

fn main() {
    let arguments = OS.script_args();
    let operation = if len(arguments) == 0 { "demo" } else { str_lower(arguments[0]) };
    if len(arguments) > 1 { usage(); return false; }
    let report = nil;
    if operation == "demo" { report = MODEL.simulate(MODEL.demo_samples(), 10); }
    else if operation == "firmware" { report = MODEL.firmware_report(); }
    else if operation == "manual" { report = MODEL.technical_manual(); }
    else { usage(); return false; }
    print json_stringify(report);
    return true;
}

main();
