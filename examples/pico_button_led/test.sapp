let MODEL = import("examples/pico_button_led/model.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "pico_button_led test failed: " + message; }
}

fn rejected(callable) { return (try { callable(); false } catch true); }

let hashes = MODEL.source_sha256();
require(len(hashes.program) == 64 and len(hashes.circuit) == 64
and len(hashes.simulator) == 64, "all three source inputs need provenance hashes");

let wiring = MODEL.wiring_contract();
require(wiring.board == "raspberry-pi-pico" and wiring.logic_voltage == 3.3,
"wiring must target the RP2040 Pico at 3.3 V logic");
require(wiring.led.pin == "GPIO15" and str_contains(wiring.led.connection, "resistor"),
"physical LED wiring must include its series resistor");
require(wiring.button.pin == "GPIO14" and wiring.button.active_low
and wiring.button.pull == "internal-pull-up", "button wiring must preserve active-low behavior");

let firmware = MODEL.firmware_report();
require(firmware.portable_ir_valid, "the portable Pico pin program must validate");
require(not firmware.native_firmware_ready and not firmware.conditional_binding_ready,
"incomplete RP2040 codegen and conditional lowering must fail closed");
require(firmware.simulator_ready and not firmware.c_fallback,
"simulation is available without a foreign-source fallback");

let manual = MODEL.technical_manual();
require(manual.board.ok and manual.board.mcu.id == "rp2040",
"technical manual must resolve the RP2040 MCU");
require(manual.board.mcu.flash_bytes == 2097152
and manual.board.mcu.sram_bytes == 270336,
"manual must retain the target memory contract");

let simulation = MODEL.simulate(MODEL.demo_samples(), 10);
require(simulation.transitions == 2 and not simulation.final_button_pressed
and not simulation.final_led_on, "one stable press and release must produce two transitions");
require(not simulation.timeline[3].led_on and simulation.timeline[4].led_on,
"contact bounce must not turn on the LED before the stable window");
require(simulation.timeline[7].led_on and not simulation.timeline[8].led_on,
"release bounce must not turn off the LED before the stable window");
require(not simulation.physical_hardware_executed,
"deterministic simulation must not be reported as physical execution");

require(rejected(fn() { MODEL.simulate([map{time_ms:0,raw:2}], 10); }),
"non-binary button levels must fail");
require(rejected(fn() { MODEL.simulate([
    map{time_ms:10,raw:1}, map{time_ms:9,raw:0}
], 10); }), "non-monotonic samples must fail");
require(rejected(fn() { MODEL.simulate("samples", 10); }),
"non-array timelines must fail");
let oversized = [];
let oi = 0;
while oi < 4097 { array_push(oversized, map{time_ms:oi,raw:1}); oi = oi + 1; }
require(rejected(fn() { MODEL.simulate(oversized, 10); }),
"sample processing must be bounded");

for source_path in [
    "examples/pico_button_led/model.sapp",
    "examples/pico_button_led/main.sapp",
    "examples/pico_button_led/test.sapp"
] {
    let report = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(report.ok and report.passed and not report.truncated and report.high == 0,
    "bounded security analysis must pass for " + source_path);
}

print "pico_button_led_pass";
