// PBLang-only migration of the Raspberry Pi Pico button/LED exercise.

let Embedded = import("stdlib:embedded.sapp");
let GPIO = import("stdlib:gpio.sapp");

let BOARD_ID = "raspberry-pi-pico";
let LED_PIN = "GPIO15";
let BUTTON_PIN = "GPIO14";
let MAX_SAMPLES = 4096;

fn source_sha256() {
    return map{
        program: "bb8eb4f0c154756769a87a31beb7084b7341b1597c3a58392afbaaf6a03eeede",
        circuit: "206f438aaf991e0d77bd61aa3de8d174b1be2ee9f072aecc2b4826fa7010318f",
        simulator: "66eee4c9114e3bebc9a09d77e0ca31ce32970d5cd8b7841e412ed31a987979e1"
    };
}

fn wiring_contract() {
    return map{
        format: "pblang.example.pico-button-led-wiring.v1",
        board: BOARD_ID,
        logic_voltage: 3.3,
        led: map{
            pin: LED_PIN,
            active_high: true,
            connection: "GPIO15 -> 220..1000 ohm resistor -> LED anode; LED cathode -> GND"
        },
        button: map{
            pin: BUTTON_PIN,
            active_low: true,
            pull: "internal-pull-up",
            connection: "GPIO14 -> normally-open button -> GND"
        },
        safety: [
            "disconnect power before changing wiring",
            "use 3.3 V GPIO logic only",
            "a physical LED requires a series resistor",
            "do not connect GPIO14 directly to a supply rail"
        ]
    };
}

fn portable_program() {
    return Embedded.IR.program([
        Embedded.IR.pin_mode(LED_PIN, "output"),
        Embedded.IR.digital_write(LED_PIN, 0),
        Embedded.IR.pin_mode(BUTTON_PIN, "input-pullup")
    ], [
        Embedded.IR.digital_read(BUTTON_PIN),
        Embedded.IR.delay_ms(10)
    ], map{
        kind: "active-low-button-led-mirror",
        portable: true,
        sample_interval_ms: 10,
        conditional_binding_status: "not-representable-in-embedded-ir-v1"
    });
}

fn firmware_report() {
    let board = Embedded.board_info(BOARD_ID);
    let program = portable_program();
    let validation = Embedded.IR.validate(program, board);
    let artifact = Embedded.build(program, BOARD_ID);
    return map{
        format: "pblang.example.pico-button-led-firmware.v1",
        board: BOARD_ID,
        portable_ir_valid: validation.ok,
        validation: validation,
        native_firmware_ready: artifact.ok,
        backend: try artifact.backend catch "native-rp2040",
        backend_status: try artifact.status catch "incomplete",
        error: try artifact.error catch "",
        conditional_binding_ready: false,
        simulator_ready: true,
        c_fallback: false
    };
}

fn technical_manual() {
    let manual = Embedded.technical_manual(BOARD_ID);
    return map{
        format: "pblang.example.pico-button-led-manual.v1",
        board: manual,
        wiring: wiring_contract(),
        source_language: "pblang"
    };
}

fn simulate(samples, stable_ms = 10) {
    if type(samples) != "array" { throw "pico_button_led: samples must be an array"; }
    if len(samples) > MAX_SAMPLES { throw "pico_button_led: sample limit exceeded"; }
    let state = GPIO.debounce_new(1, stable_ms);
    let timeline = [];
    let transitions = 0;
    let i = 0;
    while i < len(samples) {
        let sample = samples[i];
        if type(sample) != "map" { throw "pico_button_led: sample must be a map"; }
        let previous = state.value;
        state = GPIO.debounce_step(state,
            try sample.raw catch nil, try sample.time_ms catch nil);
        if state.value != previous { transitions = transitions + 1; }
        let pressed = state.value == 0;
        array_push(timeline, map{
            time_ms: sample.time_ms,
            raw: sample.raw,
            debounced: state.value,
            button_pressed: pressed,
            led_on: pressed,
            changed: state.value != previous
        });
        i = i + 1;
    }
    return map{
        format: "pblang.example.pico-button-led-simulation.v1",
        board: BOARD_ID,
        samples: len(samples),
        transitions: transitions,
        timeline: timeline,
        final_button_pressed: state.value == 0,
        final_led_on: state.value == 0,
        deterministic: true,
        physical_hardware_executed: false
    };
}

fn demo_samples() {
    return [
        map{time_ms:0, raw:1},
        map{time_ms:100, raw:0},
        map{time_ms:105, raw:1},
        map{time_ms:110, raw:0},
        map{time_ms:121, raw:0},
        map{time_ms:200, raw:1},
        map{time_ms:205, raw:0},
        map{time_ms:210, raw:1},
        map{time_ms:221, raw:1}
    ];
}

export source_sha256, wiring_contract, portable_program, firmware_report;
export technical_manual, simulate, demo_samples;
