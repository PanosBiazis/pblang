let BUILD = import("stdlib:build.sapp");

// Planning is side-effect free apart from bounded host detection. Pass this
// script's path plus an output path to execute the selected build.
let args = import("stdlib:os.sapp").script_args();
if len(args) < 2 {
    print json_stringify(BUILD.smart_plan("main.sapp", "build/app", map{ goal: "balanced" }));
} else {
    let report = BUILD.smart_build(args[0], args[1], map{
        goal: if len(args) > 2 { args[2] } else { "balanced" },
        cache: true,
        fallback: true
    });
    print json_stringify(report);
}
