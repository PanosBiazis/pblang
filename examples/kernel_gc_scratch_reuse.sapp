// pblang:target=kernel
// pblang:extern heap_init heap_alloc heap_free gc_new gc_set_auto gc_set_threshold gc_alloc gc_set_child gc_add_root gc_remove_root gc_live gc_collections kernel_gc_collect
// QEMU-only: prepend heap.sapp + gc.sapp. Raw metadata writes inject failures.
fn verify(ok) {if not ok {outb(244,1);while 1>0 {hlt();}}}
fn free_bytes(h) {
    let p=peek32(h);let total=0;let steps=0;
    while p!=0 {verify(steps<1024);total=total+peek32(p);let next=peek32(p+4);verify(next==0 or next>p);p=next;steps=steps+1;}
    return total;
}
fn kmain() {
    let h=kmalloc(8);let region=kmalloc(16384);heap_init(h,region,16384);
    let g=gc_new(h);verify(g!=0);gc_set_auto(g,0);
    let saved=kmalloc(512);let fillers=kmalloc(4096);let i=0;
    while i<128 {
        let p=gc_alloc(g,1);verify(p!=0);gc_set_child(p,0,p);
        verify(gc_add_root(g,p)==1);poke32(saved+i*4,p);i=i+1;
    }
    verify(peek32(g+36)==256);let table=peek32(g+20);
    let count=0;let fill=heap_alloc(h,8);
    while fill!=0 {verify(count<1024);poke32(fillers+count*4,fill);count=count+1;fill=heap_alloc(h,8);}
    verify(peek32(h)==0);
    // Exactly half occupied: the borrowed queue fills the entire upper half.
    i=0;while i<100 {verify(kernel_gc_collect(g)==0 and gc_live(g)==128);verify(peek32(h)==0);i=i+1;}
    let roots=peek32(g+28);i=0;
    while i<128 {
        let p=peek32(saved+i*4);verify(peek32(table+i*4)==p and peek32(roots+i*4)==p and peek32(p+8)==p);i=i+1;
    }
    poke32(g+44,2147483647);verify(kernel_gc_collect(g)==0 and gc_live(g)==128 and peek32(h)==0);
    // A borrowed-buffer failure must not free an interior metadata pointer.
    let rounds=gc_collections(g);poke32(g+16,1);
    verify(kernel_gc_collect(g)==0-1);poke32(g+16,128);
    verify(gc_collections(g)==rounds and peek32(h)==0);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==128);
    // Automatic collection under pressure must reclaim a removed self-cycle
    // before allocating its replacement, without needing another scratch block.
    let victim=peek32(saved+127*4);verify(gc_remove_root(g,victim)==1);
    rounds=gc_collections(g);gc_set_auto(g,1);gc_set_threshold(g,0);
    let replacement=gc_alloc(g,1);verify(replacement!=0);
    verify(gc_collections(g)==rounds+1 and gc_live(g)==128);
    gc_set_child(replacement,0,replacement);verify(gc_add_root(g,replacement)==1);
    poke32(saved+127*4,replacement);gc_set_auto(g,0);verify(peek32(h)==0);
    // Release only fixture-owned fillers, then cross the borrowing boundary.
    i=0;while i<count {heap_free(h,peek32(fillers+i*4));i=i+1;}
    let extra=gc_alloc(g,0);verify(extra!=0 and gc_live(g)==129);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==128 and peek32(g+20)==table);
    // Grow the table after borrowed work occupied stale slots; new entries must
    // overwrite those slots before becoming part of the ownership table.
    i=0;while i<129 {verify(gc_alloc(g,0)!=0);i=i+1;}
    verify(gc_live(g)==257 and peek32(g+36)==512);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==128);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==128);
    // Publish more roots after borrowing and table growth.
    let x=gc_alloc(g,1);let y=gc_alloc(g,1);verify(x!=0 and y!=0);
    gc_set_child(x,0,x);gc_set_child(y,0,y);
    verify(gc_add_root(g,x)==1 and gc_add_root(g,y)==1);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==130);
    // Allocated-buffer partial failure: 130 real entries, injected count 129.
    // Use a second, fresh 256-slot table to force the allocated path at 129.
    let h2=kmalloc(8);let r2=kmalloc(16384);heap_init(h2,r2,16384);
    let g2=gc_new(h2);gc_set_auto(g2,0);i=0;
    while i<130 {let p=gc_alloc(g2,1);verify(p!=0);gc_set_child(p,0,p);verify(gc_add_root(g2,p)==1);i=i+1;}
    let available=free_bytes(h2);rounds=gc_collections(g2);poke32(g2+16,129);
    verify(kernel_gc_collect(g2)==0-1);poke32(g2+16,130);
    verify(gc_collections(g2)==rounds and free_bytes(h2)==available);
    verify(kernel_gc_collect(g2)==0 and gc_live(g2)==130 and free_bytes(h2)==available);
    i=0;while i<128 {verify(gc_remove_root(g,peek32(saved+i*4))==1);i=i+1;}
    verify(gc_remove_root(g,x)==1 and gc_remove_root(g,y)==1);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==0);
    outb(244,42);while 1>0 {hlt();}
}
