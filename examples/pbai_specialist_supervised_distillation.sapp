let AI=import("stdlib/pbai.sapp");
// Deliberately incorrect teacher for the caller's new label; no implicit ingestion.
let teacher=AI.neural_specialist_train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let student=AI.neural_specialist_distill_supervised(teacher.artifact,
 [map{x:[0],y:5},map{x:[1,0],y:5}],[map{x:[7,0],y:5}],
 map{epochs:64,lr:0.1,temperature:2,hard_weight:1,max_grad_norm:1});
print json_stringify(student.evaluate([map{x:[6,0],y:5}]));
