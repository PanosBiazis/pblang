let W = import("stdlib:wayland_unicode_input.sapp");

let plan = W.text_plan("PBLang: Ελληνικά, 中文, 😀");
if not plan.ok { throw plan.error; }
print json_stringify(map{
    candidate: W.candidate(),
    capabilities: W.capabilities(),
    scalar_count: plan.scalar_count,
    keymap_batches: plan.batch_count,
    first_keymap_bytes: len(str_to_bytes(plan.batches[0].keymap)) + 1
});
