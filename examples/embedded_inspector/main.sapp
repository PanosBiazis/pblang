let Embedded = import("stdlib:embedded.sapp");

let manual = Embedded.technical_manual("arduino-uno");
let pin = Embedded.inspect_pin("esp32-devkitc-v4", "GPIO25");

print json_stringify(map{
    uno:map{mcu:manual.mcu.id,physical_pins:manual.board.physical_pin_count,
        logic_voltage:manual.board.logic_voltage,backend:manual.compiler.status},
    esp32_gpio25:map{capabilities:pin.pin.capabilities,
        analog_write:pin.pin.operations["analog-write"],
        digital_write:pin.pin.operations["digital-write"],
        safety_notes:pin.pin.safety_notes}
});
