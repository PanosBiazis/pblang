// examples/fullstack_designer_browser/web.sapp
// HTML preview helper for PBIDE Browser tabs.

fn preview_page(title, subtitle) {
    return "<!doctype html><html><head><meta charset=\"utf-8\"><title>" +
        str(title) + "</title></head><body><main><h1>" + str(title) +
        "</h1><p>" + str(subtitle) +
        "</p><a href=\"https://example.com\">Example link</a>" +
        "<form action=\"/search\"><input name=\"q\" value=\"pblang\"><button>Search</button></form>" +
        "</main></body></html>";
}

export preview_page;
