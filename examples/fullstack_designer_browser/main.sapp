// examples/fullstack_designer_browser/main.sapp
// Composite example for PBIDE: code, designer, and browser tabs together.

let UI = import("stdlib/micro_gui.sapp");
let WEB = import("examples/fullstack_designer_browser/web.sapp");

fn main() {
    let app = UI.app("Composite Studio", 640, 360);
    UI.add(app, UI.label("title", "Composite Studio"));
    UI.add(app, UI.field("url", "example.com", "preview url"));
    UI.add(app, UI.button("open", "Open Browser Tab"));
    UI.add(app, UI.button("design", "Open Designer"));
    UI.add(app, UI.progress("ready", 1.0));
    UI.layout_column(app, 16, 16, 220, 8, 8, 8, 4);
    let plan = UI.prepare(app, 7, 10, 5, map{ backend: "portable", gpu_present: true });
    let page = WEB.preview_page("Composite Studio", "Designer + Browser + Code");
    print "composite_widgets=" + str(len(app.widgets));
    print "render_commands=" + str(plan.command_count);
    print "preview_html_chars=" + str(len(page));
    print "browser_tabs=3";
}

main();

