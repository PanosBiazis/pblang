let R=import("stdlib:report_customization.sapp");
let preferences_saved=map{report_language:"el",style:map{preset:"dark",font_size:14}};
let before=json_stringify(preferences_saved);
let preview=R.plan("el",preferences_saved,map{report_language:"en",style:map{preset:"ink",landscape:true}});
assert(preview.ui_language=="el" and preview.report_language=="en","Greek UI with English report");
assert(preview.style.font_size==14 and preview.style.preset=="ink" and preview.style.landscape,"operation style merge");
assert(R.plan("el",preferences_saved).report_language=="el" and json_stringify(preferences_saved)==before,"temporary override does not change preferences_saved preferences");
assert(preview.foreground_background_contrast==21,"black on white");
print json_stringify(map{synthetic:true,preview:preview,after_operation:R.plan("el",preferences_saved)});
