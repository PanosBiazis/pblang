// Persistent self-hosted module cache plus one-process native batch compilation.
let FE = import("stdlib/compiler/selfhost_frontend.sapp");
let SESSION = import("stdlib/native/compile_session.sapp");

let id = str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 16);
let root = "/tmp/pblang_compiler_cache_example_" + id;
let module_path = root + "_module.sapp";
let module_cache = root + "_modules";
let native_cache = root + "_native";
let out1 = root + "_one.elf";
let out2 = root + "_two.elf";

fs_write(module_path, "let VALUE = 41; export VALUE;");
let main_source = "let m = import(\"" + module_path + "\"); let answer = m.VALUE + 1;";
let run_options = map{
    module_cache: true, module_cache_root: module_cache,
    max_source_bytes: 1048576, max_modules: 16, max_steps: 10000
};
let cold = FE.frontend_run_bounded(main_source, run_options);
let warm = FE.frontend_run_bounded(main_source, run_options);
if not cold.ok or cold.globals.answer != 42 or cold.module_cache.stores != 1 { throw "module cache cold run failed"; }
if not warm.ok or warm.globals.answer != 42 or warm.module_cache.hits != 1 { throw "module cache warm run failed"; }

let source1 = "let n = 6 * 7; print n;";
let source2 = "let n = 40 + 2; print n;";
let native = SESSION.compile_many(SESSION.session(map{ cache_root: native_cache }), [
    map{ source: source1, output: out1 }, map{ source: source2, output: out2 }
]);
if not native.ok or native.published != 2 or native.cache_errors != 0 { throw "native batch compile failed"; }

print json_stringify(map{
    module_cold_stores: cold.module_cache.stores,
    module_warm_hits: warm.module_cache.hits,
    native_artifacts: native.published
});

fn cleanup_dir(path) {
    let entries = try fs_listdir(path) catch [];
    let i = 0; while i < len(entries) { try fs_remove(path_join(path, entries[i])) catch nil; i = i + 1; }
    try fs_remove(path) catch nil;
}
cleanup_dir(module_cache); cleanup_dir(native_cache);
try fs_remove(module_path) catch nil; try fs_remove(out1) catch nil; try fs_remove(out2) catch nil;
