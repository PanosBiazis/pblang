// Crystal-inspired compile-time record generation using bounded PBLang macros.
let M = import("stdlib:macro.sapp");

let macros = M.registry();
M.install_record_macro(macros);
let generated = M.expand_source_bounded(macros,
    "@record(person, name, age);\nlet ada = person(\"Ada\", 36);\nprint ada.name;",
    map{ max_passes: 4, max_output_bytes: 4096 });
let checked = M.analyze_generated(generated.source);
if not checked.ok { throw "generated record source did not parse"; }
print generated.source;
