// examples/thread_pool/main.sapp
// Work-queue pattern: N worker threads drain a shared job channel.
// Demonstrates: spawn, channel, send, recv, channel_close, join.
// Use a block so jobs/results are captured as upvalues by the workers.

{
let jobs    = channel();
let results = channel();

// Spawn 3 workers (loop until recv returns nil)
let w1 = spawn(fn() {
    let job = recv(jobs.receiver);
    while job != nil {
        send(results.sender, job * 2);
        job = recv(jobs.receiver);
    }
});
let w2 = spawn(fn() {
    let job = recv(jobs.receiver);
    while job != nil {
        send(results.sender, job * 2);
        job = recv(jobs.receiver);
    }
});
let w3 = spawn(fn() {
    let job = recv(jobs.receiver);
    while job != nil {
        send(results.sender, job * 2);
        job = recv(jobs.receiver);
    }
});

// Enqueue 6 jobs
send(jobs.sender, 1);
send(jobs.sender, 2);
send(jobs.sender, 3);
send(jobs.sender, 4);
send(jobs.sender, 5);
send(jobs.sender, 6);

// Send nil sentinel to stop workers (one per worker)
send(jobs.sender, nil);
send(jobs.sender, nil);
send(jobs.sender, nil);

join(w1);
join(w2);
join(w3);

// Collect results
let total = 0;
let i = 0;
while i < 6 {
    total = total + recv(results.receiver);
    i = i + 1;
}
// sum of 2*(1+2+3+4+5+6) = 42
if total != 42 { print "fail"; }
print "thread_pool_result: " + str(total);
}
