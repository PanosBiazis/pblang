let QR = import("stdlib:qrcode.sapp");

let code = QR.encode("https://pblang.dev", "Q");
if not code.ok { throw code.error; }

print QR.to_text(code);
fs_write("pblang-qr.svg", QR.to_svg(code, 6, "#111827", "#ffffff"));
fs_write_bytes("pblang-qr.png", QR.to_png(code, 6));
print "wrote pblang-qr.svg and pblang-qr.png";
