// pblang:target=kernel
// pblang:extern addr_of heap_init heap_alloc heap_free gc_new gc_set_auto gc_alloc gc_alloc_rooted gc_add_root gc_remove_root gc_set_child gc_live kernel_gc_collect kernel_irq_save_disable kernel_irq_restore idt_set_gate idt_load pic_remap pic_mask pic_eoi pit_init
// Kernel-only: prepend heap, gc, interrupts and timer. One active CPU; QEMU only.
fn verify(ok) { if not ok { outb(244,1); while 1>0 {hlt();} } }
fn isr_timer() {
    let flags=kernel_irq_save_disable();
    if bit_and(flags,512)!=0 {outb(244,1);}
    let g=peek32(36864);
    let obj=gc_alloc_rooted(g,0);
    if obj==0 {outb(244,1);}
    if kernel_gc_collect(g)!=0 {outb(244,1);}
    gc_remove_root(g,obj);
    poke32(36868,peek32(36868)+1);
    kernel_irq_restore(flags);pic_eoi();
}
fn kmain() {
    cli();let h=kmalloc(8);let region=kmalloc(65536);heap_init(h,region,65536);
    let g=gc_new(h);verify(g!=0);gc_set_auto(g,0);poke32(36864,g);poke32(36868,0);
    let flags=kernel_irq_save_disable();verify(bit_and(flags,512)==0);
    let persistent=gc_alloc_rooted(g,1);verify(persistent!=0);
    gc_set_child(persistent,0,persistent);kernel_irq_restore(flags);
    flags=kernel_irq_save_disable();verify(bit_and(flags,512)==0);kernel_irq_restore(flags);
    let idt=kmalloc(2048);pic_remap();pic_mask(254,255);
    idt_set_gate(idt,32,addr_of("isr_timer"),8,142);idt_load(idt);pit_init(1193);sti();
    let i=0;
    while i<2000 {
        let obj=gc_alloc_rooted(g,1);verify(obj!=0);
        gc_set_child(obj,0,persistent);
        verify(kernel_gc_collect(g)==0);
        verify(peek32(obj+8)==persistent and peek32(persistent+8)==persistent);
        // Force timer collection between publishing the object and using it again.
        if i % 100 == 0 {hlt();verify(peek32(obj+8)==persistent);}
        verify(gc_remove_root(g,obj)==1);i=i+1;
    }
    while peek32(36868)<10 {hlt();}
    flags=kernel_irq_save_disable();verify(bit_and(flags,512)!=0);
    let nested=kernel_irq_save_disable();verify(bit_and(nested,512)==0);
    verify(kernel_gc_collect(g)==0);verify(gc_live(g)==1);
    kernel_irq_restore(nested);
    nested=kernel_irq_save_disable();verify(bit_and(nested,512)==0);kernel_irq_restore(nested);
    kernel_irq_restore(flags);
    flags=kernel_irq_save_disable();verify(bit_and(flags,512)!=0);
    // Failure return must also preserve the incoming disabled state.
    verify(gc_alloc(g,-1)==0);nested=kernel_irq_save_disable();verify(bit_and(nested,512)==0);
    kernel_irq_restore(nested);
    // Root publication failure must undo the object registration and allocation.
    let h2=kmalloc(8);let r2=kmalloc(4096);heap_init(h2,r2,4096);
    let g2=gc_new(h2);verify(g2!=0);gc_set_auto(g2,0);
    let kept=gc_alloc_rooted(g2,0);verify(kept!=0);
    i=1;while i<64 {verify(gc_add_root(g2,kept)==1);i=i+1;}
    let hole=heap_alloc(h2,8);verify(hole!=0);
    let filler=heap_alloc(h2,8);while filler!=0 {filler=heap_alloc(h2,8);}
    heap_free(h2,hole);
    let head=peek32(h2);let block_size=peek32(head);verify(head!=0);
    verify(heap_alloc(h2,-1)==0);verify(heap_alloc(h2,2147483633)==0);
    verify(heap_alloc(h2,2147483647)==0);
    verify(peek32(h2)==head and peek32(head)==block_size);
    verify(gc_alloc_rooted(g2,0)==0);verify(gc_live(g2)==1);
    verify(peek32(g2+24)==64);verify(heap_alloc(h2,8)==hole);
    nested=kernel_irq_save_disable();verify(bit_and(nested,512)==0);kernel_irq_restore(nested);
    outb(244,42);while 1>0 {hlt();}
}
