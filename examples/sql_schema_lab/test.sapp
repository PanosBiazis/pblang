let LAB = import("schema_lab.sapp");

fn require(condition, message) {
    if not condition { throw "FAIL sql_schema_lab: " + message; }
}

let conn = LAB.open_memory();
let first_schema = LAB.apply_schema(conn);
let second_schema = LAB.apply_schema(conn);
require(first_schema.ok and second_schema.ok
    and first_schema.migration_count == 4 and second_schema.migration_count == 4,
    "versioned migrations are complete and idempotent");

let alpha = LAB.add_record(conn, "alpha", 72, "general");
let beta = LAB.add_record(conn, "beta", 41, "general");
let gamma = LAB.add_record(conn, "gamma", 88, "special-group");
require(alpha.ok and beta.ok and gamma.ok,
    "parameterized inserts create records and related groups");
require(not LAB.add_record(conn, "alpha", 50, "general").ok,
    "the unique label constraint rejects duplicate records");

require(not LAB.add_record(conn, "", 50, "general").ok
    and not LAB.add_record(conn, "bad;drop", 50, "general").ok
    and not LAB.add_record(conn, "valid", -1, "general").ok
    and not LAB.add_record(conn, "valid", 101, "general").ok
    and not LAB.add_record(conn, "valid", 2.5, "general").ok,
    "malformed text and out-of-range scores fail before SQL execution");

let updated = LAB.update_score(conn, "beta", 65);
require(updated.ok and updated.record.score == 65,
    "parameterized updates return the updated record");
require(not LAB.update_score(conn, "missing", 50).ok,
    "updates of missing records fail cleanly");

let rollback = LAB.rollback_probe(conn);
require(rollback.ok and not rollback.transaction_committed and rollback.remaining_rows == 0,
    "thrown transaction work is fully rolled back");

let report = LAB.report(conn);
require(report.ok and report.format == LAB.FORMAT and len(report.schema) == 5,
    "schema metadata includes migrations, two tables, one view, and one index");
require(len(report.ascending) == 3 and report.ascending[0].label == "beta"
    and report.ascending[2].label == "gamma",
    "ascending view query orders by score");
require(len(report.descending) == 3 and report.descending[0].label == "gamma"
    and report.descending[2].label == "beta",
    "descending view query orders by score");
require(len(report.passing) == 3,
    "AND-bound range filtering returns the expected records");

conn.close();
print "sql_schema_lab_pass";
