let DB = import("stdlib:db.sapp");

let FORMAT = "pblang.example.sql-schema-lab.v1";
let MAX_TEXT_LENGTH = 64;

fn migrations() {
    return [
        map{ version: 1, up: "CREATE TABLE groups (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL UNIQUE)" },
        map{ version: 2, up: "CREATE TABLE records (id INTEGER PRIMARY KEY AUTOINCREMENT, label TEXT NOT NULL UNIQUE, score INTEGER NOT NULL CHECK (score >= 0 AND score <= 100), group_id INTEGER NOT NULL, created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (group_id) REFERENCES groups(id))" },
        map{ version: 3, up: "CREATE VIEW record_summary AS SELECT records.id AS id, records.label AS label, records.score AS score, groups.name AS group_name FROM records INNER JOIN groups ON groups.id = records.group_id" },
        map{ version: 4, up: "CREATE INDEX records_score_index ON records(score)" }
    ];
}

fn open_memory() {
    let conn = DB.sqlite.open(":memory:");
    conn.exec("PRAGMA foreign_keys = ON", []);
    return conn;
}

fn apply_schema(conn) {
    let applied = DB.migrate(conn, migrations());
    if applied == nil {
        return map{ ok: false, error: "schema migration failed" };
    }
    let count = DB.query_value(conn,
        "SELECT COUNT(*) AS count FROM __pblang_migrations", []);
    return map{ ok: true, migration_count: count };
}

fn _text(value, label) {
    if type(value) != "string" {
        return map{ ok: false, error: label + " must be text" };
    }
    let clean = str_trim(value);
    if len(clean) < 1 or len(clean) > MAX_TEXT_LENGTH
       or not regex_match(clean, "^[A-Za-z0-9][A-Za-z0-9 _-]*$") {
        return map{ ok: false,
            error: label + " must use 1..64 letters, digits, spaces, underscores, or hyphens" };
    }
    return map{ ok: true, value: clean };
}

fn _score(value) {
    if type(value) != "number" or value != num_floor(value)
       or value < 0 or value > 100 {
        return map{ ok: false, error: "score must be an integer in 0..100" };
    }
    return map{ ok: true, value: value };
}

fn add_record(conn, label, score, group_name) {
    let checked_label = _text(label, "label");
    if not checked_label.ok { return checked_label; }
    let checked_group = _text(group_name, "group");
    if not checked_group.ok { return checked_group; }
    let checked_score = _score(score);
    if not checked_score.ok { return checked_score; }

    let result = conn.tx(fn(c) {
        c.exec("INSERT OR IGNORE INTO groups(name) VALUES (?)", [checked_group.value]);
        let group = DB.query_one(c, "SELECT id FROM groups WHERE name = ?", [checked_group.value]);
        if group == nil { throw "group creation failed"; }
        c.exec("INSERT INTO records(label, score, group_id) VALUES (?, ?, ?)",
            [checked_label.value, checked_score.value, group.id]);
        return c.last_insert_rowid();
    });
    if not result.ok {
        return map{ ok: false, error: "record violates a database constraint" };
    }
    return map{ ok: true, id: result.value };
}

fn update_score(conn, label, score) {
    let checked_label = _text(label, "label");
    if not checked_label.ok { return checked_label; }
    let checked_score = _score(score);
    if not checked_score.ok { return checked_score; }
    conn.exec("UPDATE records SET score = ? WHERE label = ?",
        [checked_score.value, checked_label.value]);
    let row = DB.query_one(conn,
        "SELECT id, label, score FROM records WHERE label = ?", [checked_label.value]);
    if row == nil { return map{ ok: false, error: "record was not found" }; }
    return map{ ok: true, record: row };
}

fn rollback_probe(conn) {
    let result = conn.tx(fn(c) {
        c.exec("INSERT INTO groups(name) VALUES (?)", ["rollback-probe"]);
        throw "intentional rollback";
    });
    let count = DB.query_value(conn,
        "SELECT COUNT(*) AS count FROM groups WHERE name = ?", ["rollback-probe"]);
    return map{ ok: not result.ok and count == 0,
        transaction_committed: result.ok, remaining_rows: count };
}

fn report(conn) {
    let schema = conn.query(
        "SELECT type, name FROM sqlite_master WHERE name NOT LIKE 'sqlite_%' ORDER BY type, name",
        []);
    let ascending = conn.query(
        "SELECT id, label, score, group_name FROM record_summary ORDER BY score ASC, id ASC",
        []);
    let descending = conn.query(
        "SELECT id, label, score, group_name FROM record_summary ORDER BY score DESC, id ASC",
        []);
    let passing = conn.query(
        "SELECT id, label, score FROM records WHERE score >= ? AND score <= ? ORDER BY score DESC",
        [50, 100]);
    return map{ ok: true, format: FORMAT, schema: schema,
        ascending: ascending, descending: descending, passing: passing };
}

export FORMAT, MAX_TEXT_LENGTH, migrations, open_memory, apply_schema;
export add_record, update_score, rollback_probe, report;
