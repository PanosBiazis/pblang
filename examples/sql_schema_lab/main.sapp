let OS = import("stdlib:os.sapp");
let LAB = import("schema_lab.sapp");

fn usage() {
    print "Usage: pblang run examples/sql_schema_lab/main.sapp -- [label score group]";
}

fn main() {
    let args = OS.script_args();
    if len(args) != 0 and len(args) != 3 {
        usage();
        return false;
    }

    let conn = LAB.open_memory();
    let schema = LAB.apply_schema(conn);
    if not schema.ok {
        conn.close();
        print "Unable to initialize schema: " + schema.error;
        return false;
    }

    if not LAB.add_record(conn, "alpha", 72, "general").ok
       or not LAB.add_record(conn, "beta", 41, "general").ok {
        conn.close();
        print "Unable to seed the disposable database";
        return false;
    }

    if len(args) == 3 {
        let score = try parse_number(args[1]) catch -1;
        let added = LAB.add_record(conn, args[0], score, args[2]);
        if not added.ok {
            conn.close();
            print "Unable to add record: " + added.error;
            return false;
        }
    }

    let updated = LAB.update_score(conn, "beta", 65);
    let rollback = LAB.rollback_probe(conn);
    let report = LAB.report(conn);
    print "PBLang SQL schema lab";
    print "Applied migrations: " + str(schema.migration_count);
    print "Schema objects: " + str(len(report.schema));
    print "Rows ordered by descending score:";
    for row in report.descending {
        print "  " + row.label + " | score=" + str(row.score)
            + " | group=" + row.group_name;
    }
    print "Parameterized update: " + if updated.ok { "passed" } else { "failed" };
    print "Transaction rollback: " + if rollback.ok { "passed" } else { "failed" };
    conn.close();
    return updated.ok and rollback.ok;
}

main();
