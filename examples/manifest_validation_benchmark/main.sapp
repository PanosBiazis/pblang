let Manifest = import("stdlib:manifest_validate.sapp");
let Benchmark = import("stdlib:benchmark.sapp");

let source = "[package]\nname = \"benchmark-app\"\n"
    + "version = \"12.34.56-alpha.1+build.001\"\nentry = \"src/main.sapp\"\n"
    + "release_channel = \"nightly.20260829\"\nshow_release_channel = true\n"
    + "release_channel_in_artifact = true\n\n[dependencies]\n";
let i = 0;
while i < 20 {
    source = source + "dependency_" + str(i) + " = \"1.2." + str(i) + "\"\n";
    i = i + 1;
}

fn validate_batch() {
    let count = 0; let last = nil;
    while count < 25 {
        last = Manifest.validate_manifest_text(source);
        if not last.ok or last.dependency_count != 20
           or last.package.exact_version_identity != "12.34.56-alpha.1+build.001"
           or last.package.channel_changes_package_identity {
            throw "manifest benchmark correctness gate failed";
        }
        count = count + 1;
    }
    return last.dependency_count;
}

Benchmark.warmup(validate_batch, 5);
let samples = []; i = 0;
while i < 9 {
    let started = now_ms(); let checksum = validate_batch();
    if checksum != 20 { throw "manifest benchmark checksum mismatch"; }
    array_push(samples, (now_ms() - started) / 25.0); i = i + 1;
}
let result = Benchmark.stats("strict-manifest-20-dependencies-ms-per-validation", samples);
print json_stringify(map{ok:true,format:"pblang.manifest-validation-benchmark.v1",
    warmups:5,samples_ms_per_validation:samples,median_ms:result.median_ms,
    p95_ms:result.p95_ms,stability:result.stability,dependency_count:20,
    source_bytes:len(str_to_bytes(source)),exact_identity:true,effects:false});
