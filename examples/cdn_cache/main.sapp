let CDN = import("stdlib:cdn_cache.sapp");

let root = "target/cdn-cache-example";
fs_mkdirs(root);
fs_write(root + "/app.js", "console.log('served by pblang');\n");

// One high-level object supplies a safe static origin plus bounded edge and
// regional caches. The same policy can be deployed at real edge processes.
let site = CDN.static_site(root, map{
    allowed_hosts: ["example.local"],
    policy: map{
        scope: "public", browser_ttl_ms: 60000, shared_ttl_ms: 300000,
        stale_while_revalidate_ms: 30000, stale_if_error_ms: 300000
    }
});

let request = map{
    method: "GET", scheme: "https", host: "example.local",
    path: "/app.js", headers: map{ "Accept-Encoding": "identity" }
};
let first = site.handle(request);
let second = site.handle(request);
assert(first.status == 200 and first.cdn.source == "MISS", "first static request reaches origin");
assert(second.status == 200 and second.cdn.source == "EDGE-HIT", "second static request is served at edge");

let conditional = map{
    method: "GET", scheme: "https", host: "example.local", path: "/app.js",
    headers: map{
        "Accept-Encoding": "identity",
        "If-None-Match": first.headers.ETag
    }
};
let unchanged = site.handle(conditional);
assert(unchanged.status == 304 and unchanged.body == "", "conditional request avoids the body transfer");

let purged = site.purge_path("/app.js");
assert(purged.removed == 2, "purge invalidates edge and regional copies");
let after_purge = site.handle(request);
assert(after_purge.cdn.source == "MISS", "purged asset returns to origin");

let metrics = site.stats();
print "cdn_example first=" + first.cdn.source + " second=" + second.cdn.source +
      " conditional=" + str(unchanged.status) + " origin_fetches=" + str(metrics.metrics.origin_fetches);

try fs_remove(root + "/app.js") catch nil;
