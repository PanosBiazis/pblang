// await_all settles every sibling before reporting a task failure.
let A = import("stdlib:async.sapp");
let failed = A.go(fn(){ throw "example failure"; });
let sibling = A.go(fn(){ sleep_ms(20); return 42; });
let rejected = try { A.await_all([failed, sibling]); false } catch true;
assert(rejected and failed.resolved and sibling.resolved, "all workers settled");
// Successful sibling results remain available after the aggregate failure.
assert(A.await(sibling) == 42, "cached sibling result");
print "All workers settled; sibling result: " + str(A.await(sibling));
