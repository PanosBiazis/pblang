let V=import("stdlib:compiler/vm.sapp");
fn call(name,values){let c=[map{__bi:name}];let ins=[map{op:0,operand:0}];for v in values {array_push(c,v);array_push(ins,map{op:0,operand:len(c)-1});}array_push(ins,map{op:18,operand:len(values)});return map{constants:c,instructions:ins};}
let cases=[7];for key in ["max_steps","max_frames","max_stack","max_locals","max_output","max_value_items"] {for value in [0,num_sqrt(-1)] {let opts=map{};opts[key]=value;array_push(cases,opts);}}
for options in cases {let c=V.execution_context(true);V.run_seeded(call("memory_alloc",[7]),map{},c);V.run_seeded(call("push_lifetime",[]),map{},c);V.run_seeded(call("borrow_immutable",[1]),map{},c);V.run_seeded(call("memory_alloc",[9]),map{},c);let m=c.memory;
assert((try {V.run_seeded_bounded(map{constants:[],instructions:[]},map{},options,c);false}catch true),"initialization rejects");assert(m.closed and len(m.owners)==0 and len(m.borrows)==0 and m.reclaimed==2,"initialization memory released");V.close_execution(c);}
print "initialization_cleanup_pass";
