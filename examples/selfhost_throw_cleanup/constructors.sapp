// Four constructor routes release two lifetimes and a borrow on escape.
let F=import("stdlib:compiler/selfhost_frontend.sapp");let V=import("stdlib:compiler/vm.sapp");
let setup=F.frontend_compile("memory_alloc(7);push_lifetime();borrow_immutable(1);memory_alloc(9);");assert(setup.ok,"setup");
for expression in ["call1(bigint,0.5)", "call1(decimal,\"bad\")", "call1(rational,\"1/0\")", "call2(rational,1,0)"] {
    let c=V.execution_context(true);V.run_seeded(setup.chunk,map{},c);let m=c.memory;
    let code=F.frontend_compile("fn call1(f,a){return f(a);}fn call2(f,a,b){return f(a,b);}"+expression+";");assert(code.ok,"source");
    assert((try {V.run_seeded_bounded(code.chunk,map{},nil,c);false} catch true),"constructor error");
    assert(c.memory==nil and m.closed and m.reclaimed==2 and len(m.owners)==0 and len(m.borrows)==0,"owned cleanup");
    V.close_execution(c);assert(m.reclaimed==2,"idempotence");
}
print "constructor_cleanup_pass";
