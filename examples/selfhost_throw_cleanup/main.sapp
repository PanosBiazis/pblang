let F=import("stdlib:compiler/selfhost_frontend.sapp");
let VM=import("stdlib:compiler/vm.sapp");
// Ordinary frontend execution opts into escaping guest-error cleanup itself.
let failed=try F.frontend_run("memory_alloc(42); throw \"example failure\";") catch true;
assert(failed==true,"guest error propagates");
// Internal orchestration/debugging: explicitly shared contexts remain owned by
// their caller by default. Opt in only when an escaping error ends the run.
let context=VM.execution_context(true);
let chunk=F.frontend_compile("push_lifetime(); memory_alloc(7); error(\"stop\");").chunk;
try VM.run_seeded(chunk,map{},context) catch nil;
assert(context.memory==nil,"private scalar ownership cleared");
VM.close_execution(context); // idempotent
print "Guest error propagated; private scalar ownership cleared.";
