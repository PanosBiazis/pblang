// Collection errors close an explicitly owned PBLang VM context, while leaving
// original host diagnostics intact. This does not change direct retained p:run.
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let setup=F.frontend_compile("memory_alloc(7);push_lifetime();borrow_immutable(1);memory_alloc(9);");
let bad=F.frontend_compile("fn invoke(f){f(map{k:7},9);}invoke(map_remove);");
assert(setup.ok and bad.ok,"example compilation");
let ctx=V.execution_context(true);V.run_seeded(setup.chunk,map{},ctx);let state=ctx.memory;
let rejected=(try {V.run_seeded_bounded(bad.chunk,map{},nil,ctx);false} catch true);
assert(rejected and state.closed and ctx.memory==nil,"owned error closes");
assert(state.reclaimed==2 and len(state.borrows)==0,"scopes reclaimed");
print "collection failure: owned values released";
let exact=F.frontend_compile("fn id(x){return x;}print id(bigint(\"42\"));print id(rational(3,2));print id(decimal(\"1.25\"));");
assert(exact.ok,"exact number compilation");
let result=V.run_bounded(exact.chunk);
print result.output;
