// An escaping string failure releases explicitly owned scalar memory.
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let ctx=V.execution_context(true);
let setup=F.frontend_compile("memory_alloc(7);push_lifetime();borrow_immutable(1);memory_alloc(9);");
assert(setup.ok,"setup compiles");V.run_seeded(setup.chunk,map{},ctx);
let memory=ctx.memory;
let code=F.frontend_compile("fn call(f,x){return f(x);}call(str_upper,nil);");
assert(code.ok,"dynamic source compiles");
let failed=try {V.run_seeded(code.chunk,map{},ctx);false} catch true;
assert(failed and ctx.memory==nil and memory.closed,"escaping string failure closes ownership");
assert(memory.reclaimed==2 and len(memory.borrows)==0,"both lifetimes released");
V.close_execution(ctx);assert(memory.reclaimed==2,"close is idempotent");
print "string_cleanup_pass";
