// String and array slice errors preserve private ownership and guest catches.
let V=import("stdlib:compiler/vm.sapp");
fn call(name,values){let c=[map{__bi:name}];let ins=[map{op:0,operand:0}];for v in values {array_push(c,v);array_push(ins,map{op:0,operand:len(c)-1});}array_push(ins,map{op:18,operand:len(values)});return map{constants:c,instructions:ins};}
let cases=[["str_slice", [nil, 0, 1]], ["str_slice", ["x", nil, 1]], ["str_slice", ["x", 0, nil]], ["str_slice", ["x", -1, 1]], ["str_slice", ["x", 0, -1]], ["slice", [nil, nil, nil]], ["slice", [[1], -1, nil]], ["slice", [[1], nil, -1]], ["slice", [map{}, nil, nil]]];
for item in cases {let c=V.execution_context(true);V.run_seeded(call("memory_alloc",[7]),map{},c);V.run_seeded(call("push_lifetime",[]),map{},c);V.run_seeded(call("borrow_immutable",[1]),map{},c);V.run_seeded(call("memory_alloc",[9]),map{},c);let m=c.memory;assert((try {V.run_seeded(call(item[0],item[1]),map{},c);false} catch true),"reject");assert(m.closed and len(m.owners)==0 and len(m.borrows)==0 and m.reclaimed==2,"owned cleanup");V.close_execution(c);}
let failure=call("slice",[[1],-1,nil]);let handler=call("memory_get",[1]);array_push(handler.instructions,map{op:12,operand:0});let caught=map{constants:[map{try_chunk:failure,catch_chunk:handler}],instructions:[map{op:35,operand:0}]};
let c=V.execution_context(true);V.run_seeded(call("memory_alloc",[7]),map{},c);assert(V.run_seeded(caught,map{},c).output==[7] and not c.memory.closed,"caught memory live");V.close_execution(c);
let b=V.execution_context();V.run_seeded(call("memory_alloc",[7]),map{},b);assert((try {V.run_seeded(failure,map{},b);false} catch true) and not b.memory.closed,"borrowed memory live");V.close_execution(b);
print "slice_cleanup_pass";
