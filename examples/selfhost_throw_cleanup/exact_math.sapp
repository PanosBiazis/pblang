// Explicit modulo/power failures release an opted-in context, just like %.
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
for source in ["invoke(num_mod,bigint(7),bigint(0));","invoke(num_pow,bigint(2),-1);"] {
    let ctx=V.execution_context(true);
    let setup=F.frontend_compile("memory_alloc(7);push_lifetime();borrow_immutable(1);memory_alloc(9);");
    assert(setup.ok,"setup compiles");V.run_seeded(setup.chunk,map{},ctx);
    let memory=ctx.memory;let code=F.frontend_compile("fn invoke(f,a,b){return f(a,b);}"+source);
    assert(code.ok,"math fixture compiles");
    let failed=try {V.run_seeded_bounded(code.chunk,map{},nil,ctx);false} catch true;
    assert(failed and ctx.memory==nil and memory.closed,"escaping math failure closes ownership");
    assert(memory.reclaimed==2 and len(memory.owners)==0 and len(memory.borrows)==0,"both lifetimes released");
    V.close_execution(ctx);assert(memory.reclaimed==2,"close is idempotent");
}
print "exact_math_cleanup_pass";
