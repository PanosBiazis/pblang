// Driver on the retained host; guest programs execute on the PBLang VM.
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
// A guest catch can continue using the same allocation.
let handled=F.frontend_run("let h=memory_alloc(42); print try memory_get(nil) catch memory_get(h);");
assert(handled.output==[42],"handled memory failure preserves live value");
// Internal orchestrators may inspect their own context. Never expose it to a guest.
let context=V.execution_context(true);
let allocate=F.frontend_compile("memory_alloc(42);");
V.run_seeded(allocate.chunk,map{},context);
let state=context.memory;
let failed=try V.run_seeded(F.frontend_compile("memory_get(nil);").chunk,map{},context) catch true;
assert(failed==true and state.closed and len(state.owners)==0,"escaping memory failure reclaims");
V.close_execution(context);
assert(state.reclaimed==1,"explicit close does not reclaim twice");
print "handled value: 42; escaping failure: reclaimed";
