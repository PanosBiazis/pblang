// Retained-host driver, with user code running on the PBLang-written VM.
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let context=V.execution_context(true);
V.run_seeded(F.frontend_compile("memory_alloc(42);").chunk,map{},context);
let state=context.memory;let globals=map{};
let source="fn call(f,a){return f(a,99);}let values=[7];call(array_pop,values);";
let code=F.frontend_compile(source);assert(code.ok,"dynamic call admitted");
let failed=try {V.run_seeded(code.chunk,globals,context);false} catch true;
assert(failed and globals.values==[7],"wrong arity rejected before mutation");
assert(state.closed and len(state.owners)==0,"escaping failure reclaimed ownership");
V.close_execution(context);assert(state.reclaimed==1,"reclaimed exactly once");
let handled=F.frontend_run("let h=memory_alloc(42);fn call(f){return f();}print try call(array_push) catch memory_get(h);");
assert(handled.output==[42],"guest handler retains live allocation");
print "wrong arity: rejected; array: [7]; escaping ownership: reclaimed; caught value: 42";
