// Guest limits are terminal; an outer orchestrator owns the resulting failure.
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let ctx=V.execution_context(true);
V.run_seeded(F.frontend_compile("memory_alloc(42);").chunk,map{},ctx);
let memory=ctx.memory;
let code=F.frontend_compile("while true {}").chunk;
let failed=try V.run_seeded_bounded(code,map{},map{max_steps:20},ctx) catch true;
assert(failed==true,"step limit terminates the run");
assert(memory.closed and len(memory.owners)==0 and ctx.memory==nil,"owned state reclaimed");
V.close_execution(ctx);
assert(memory.reclaimed==1,"close is idempotent");
print "step limit enforced; owned allocation reclaimed";
