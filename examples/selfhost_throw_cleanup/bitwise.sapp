// Public-CLI acceptance for six builtins, shift-domain errors, catches/borrows.
let V=import("stdlib:compiler/vm.sapp");
fn call(name,args){let constants=[map{__bi:name}];let ins=[map{op:0,operand:0}];for a in args {array_push(constants,a);array_push(ins,map{op:0,operand:len(constants)-1});}array_push(ins,map{op:18,operand:len(args)});return map{constants:constants,instructions:ins};}
let alloc=call("memory_alloc",[7]);let nested=call("push_lifetime",[]);let borrow=call("borrow_immutable",[1]);
for item in [["bit_and",[nil,1]],["bit_or",[1,nil]],["bit_xor",[0.5,1]],["bit_not",[nil]],["bit_shl",[1,64]],["bit_shr",[1,-1]]] {
 let c=V.execution_context(true);V.run_seeded(alloc,map{},c);V.run_seeded(nested,map{},c);V.run_seeded(borrow,map{},c);V.run_seeded(alloc,map{},c);let m=c.memory;let fail=call(item[0],item[1]);
 assert((try {V.run_seeded_bounded(fail,map{},nil,c);false} catch true),"bitwise rejection");assert(c.memory==nil and m.closed and m.reclaimed==2 and len(m.borrows)==0,"owned cleanup");V.close_execution(c);assert(m.reclaimed==2,"idempotence");
}
let failure=call("bit_shl",[1,64]);let handler=call("memory_get",[1]);array_push(handler.instructions,map{op:12,operand:0});
let caught=map{constants:[map{try_chunk:failure,catch_chunk:handler}],instructions:[map{op:35,operand:0}]};
let c=V.execution_context(true);V.run_seeded(alloc,map{},c);assert(V.run_seeded(caught,map{},c).output==[7] and not c.memory.closed,"caught memory live");V.close_execution(c);
let b=V.execution_context();V.run_seeded(alloc,map{},b);assert((try {V.run_seeded(failure,map{},b);false} catch true) and not b.memory.closed,"borrowed memory live");V.close_execution(b);
print "bitwise_cleanup_pass";
