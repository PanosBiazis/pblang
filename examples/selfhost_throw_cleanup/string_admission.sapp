let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let context=V.execution_context(true);
V.run_seeded(F.frontend_compile("memory_alloc(7);").chunk,map{},context);
let state=context.memory;
let failed=try {
    V.run_seeded(F.frontend_compile("str_repeat(nil,2);").chunk,map{},context);
    false
} catch true;
assert(failed and state.closed and len(state.owners)==0,"escaping string rejection releases scalar state");
V.close_execution(context);
let handled=F.frontend_run("let h=memory_alloc(11);print try str_pad_left(nil,2,\"x\") catch memory_get(h);");
assert(handled.output==[11],"guest catch retains its scalar handle");
print "String rejection cleanup and handled recovery passed";

let bounded=V.run_bounded(F.frontend_compile("print str_pad_left(\"a\",num_sqrt(-1),\"x\");print str_replace_all(\"ab\",\"\",\"xy\");").chunk,map{max_value_items:8});
assert(bounded.output==["a","xyaxybxy"],"NaN and exact replacement quota admitted");
let over=try {V.run_bounded(F.frontend_compile("try str_replace_all(\"ab\",\"\",\"xyz\") catch 7;").chunk,map{max_value_items:8});false} catch true;
assert(over,"replacement quota cannot be swallowed by a guest catch");
print "Bounded padding and replacement admission passed";
