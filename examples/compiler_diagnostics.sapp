// Structured typo diagnostics from the PBLang-written frontend.
let tokenizer = import("stdlib/compiler/tokenizer.sapp");
let parser = import("stdlib/compiler/parser.sapp");
let checker = import("stdlib/compiler/typeck.sapp");

let source = "let message = \"hello\"; print mesage;";
let ast = parser.parse(tokenizer.tokenize(source));
let diagnostics = checker.type_check(ast.stmts);

for diagnostic in diagnostics {
    print diagnostic.code + ": " + diagnostic.message;
    let suggestion = try diagnostic.suggestion catch nil;
    if suggestion != nil { print "  " + diagnostic.help; }
}
