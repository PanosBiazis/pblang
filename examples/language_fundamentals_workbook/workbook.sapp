// Safe, deterministic migration of an early multi-topic C# console exercise.

let CLASS = import("stdlib:class.sapp");

let MAX_MAGNITUDE = 1000000000;
let MAX_STUDENTS = 64;
let MAX_STUDENT_BYTES = 128;
let MAX_SEQUENCE = 256;
let MAX_TRIANGLE_ROWS = 32;

fn source_sha256() {
    return map{
        program: "00e145ff8addc6b967fd72c09649590d7f2aa6e808e027b8d58df29a3fcc1772",
        project: "3f46d597d8b20606b7ea25861120646ca60a75eeb26c4b3e0a9468cdd383755a",
        solution: "a4e6bb91ccdf9b35ac433c55ab07274ae38f17d4430b192638d43832afd84187"
    };
}

fn _number(value, label) {
    if type(value) != "number" or value < 0 - MAX_MAGNITUDE or value > MAX_MAGNITUDE {
        throw label + " must be a bounded number";
    }
    return value;
}

fn _integer(value, minimum, maximum, label) {
    if type(value) != "number" or value != num_floor(value)
       or value < minimum or value > maximum {
        throw label + " must be a whole " + str(minimum) + ".." + str(maximum);
    }
    return value;
}

fn _text(value, label) {
    if type(value) != "string" { throw label + " must be text"; }
    let cleaned = str_trim(value);
    if cleaned == "" or len(str_to_bytes(cleaned)) > MAX_STUDENT_BYTES {
        throw label + " must contain 1.." + str(MAX_STUDENT_BYTES) + " UTF-8 bytes";
    }
    return cleaned;
}

fn _truncating_division(left, right) {
    if right == 0 { throw "division by zero"; }
    let quotient = left / right;
    if quotient >= 0 { return num_floor(quotient); }
    return 0 - num_floor(0 - quotient);
}

let Addition = CLASS.define("Addition", ["left", "right"], map{
    sum: fn(self) { return self.left + self.right; }
});

fn arithmetic_report(left_value, right_value, decimal_left_value, decimal_right_value) {
    let left = _integer(left_value, 0 - MAX_MAGNITUDE, MAX_MAGNITUDE, "left");
    let right = _integer(right_value, 0 - MAX_MAGNITUDE, MAX_MAGNITUDE, "right");
    let decimal_left = _number(decimal_left_value, "decimal_left");
    let decimal_right = _number(decimal_right_value, "decimal_right");
    if right == 0 { throw "right must not be zero"; }

    let addition = CLASS.new(Addition, map{ left: left, right: right });
    let quotient = _truncating_division(left, right);
    return map{
        sum: CLASS.call(addition, "sum"),
        product: left * right,
        quotient_truncated_toward_zero: quotient,
        remainder: left - quotient * right,
        mixed_sum: left + decimal_right,
        decimal_difference_truncated: _truncating_division(
            num_floor((decimal_right - decimal_left) * 1000000),
            1000000
        ),
        constructor_fields_correct: addition.left == left and addition.right == right
    };
}

fn text_report(word_value, phrase_value) {
    let word = _text(word_value, "word");
    let phrase = _text(phrase_value, "phrase");
    let first = word[0..1];
    let codepoint = strcharcodeat(first, 0);
    return map{
        phrase: phrase,
        word: word,
        first_character: first,
        first_codepoint: codepoint,
        codepoint_round_trip: strfromcharcode(codepoint),
        round_trip_verified: strfromcharcode(codepoint) == first
    };
}

fn comparison_report(left_value, right_value) {
    let left = _number(left_value, "left");
    let right = _number(right_value, "right");
    let relation = "equal";
    if left > right { relation = "left-greater"; }
    else if left < right { relation = "right-greater"; }
    return map{ left: left, right: right, relation: relation };
}

fn loop_report(row_count_value, start_value, step_value, limit_value) {
    let row_count = _integer(row_count_value, 0, MAX_TRIANGLE_ROWS, "row_count");
    let current = _integer(start_value, 0 - MAX_MAGNITUDE, MAX_MAGNITUDE, "start");
    let step = _integer(step_value, 1, MAX_SEQUENCE, "step");
    let limit = _integer(limit_value, current, MAX_MAGNITUDE, "limit");

    let triangle = [];
    let row = 1;
    while row <= row_count {
        let symbols = "";
        let column = 0;
        while column < row { symbols = symbols + "*"; column = column + 1; }
        array_push(triangle, symbols);
        row = row + 1;
    }

    let progression = [];
    let guard = 0;
    while current <= limit and guard < MAX_SEQUENCE {
        array_push(progression, current);
        current = current + step;
        guard = guard + 1;
    }
    return map{
        triangle: triangle,
        progression: progression,
        progression_complete: current > limit,
        bounded: true
    };
}

fn attendance_report(student_values) {
    if type(student_values) != "array" or len(student_values) > MAX_STUDENTS {
        throw "students must be an array with at most " + str(MAX_STUDENTS) + " entries";
    }
    let students = [];
    let i = 0;
    while i < len(student_values) {
        array_push(students, _text(student_values[i], "student " + str(i + 1)));
        i = i + 1;
    }
    return map{
        count: len(students),
        students: students,
        input_mutated: str(students) != str(student_values)
    };
}

fn collection_report(count_value) {
    let count = _integer(count_value, 0, MAX_SEQUENCE, "count");
    let numbers = [];
    let i = 0;
    let sum = 0;
    while i < count {
        array_push(numbers, i);
        sum = sum + i;
        i = i + 1;
    }
    return map{
        numbers: numbers,
        initialized: len(numbers),
        sum: sum,
        average: if count == 0 { nil } else { sum / count },
        all_elements_initialized: true
    };
}

fn output_parameters_report(base_value) {
    let base = _integer(base_value, 0 - MAX_MAGNITUDE, MAX_MAGNITUDE, "base");
    return map{ number: base + 10, label: "items" };
}

fn run(student_values = nil) {
    let students = student_values;
    if students == nil { students = ["Student One", "Student Two"]; }
    let report = map{
        format: "pblang.example.language-fundamentals.v1",
        arithmetic: arithmetic_report(10, -50, 1.2, -10.62),
        text: text_report("Friend", "A short language exercise"),
        comparison: comparison_report(10, -50),
        loops: loop_report(5, 10, 5, 25),
        attendance: attendance_report(students),
        collections: collection_report(100),
        output_parameters: output_parameters_report(15),
        source_sha256: source_sha256(),
        bounded: true
    };
    report.verified = report.arithmetic.sum == -40
        and report.arithmetic.constructor_fields_correct
        and report.text.round_trip_verified
        and report.loops.progression_complete
        and report.collections.all_elements_initialized;
    return report;
}

export source_sha256, arithmetic_report, text_report, comparison_report,
       loop_report, attendance_report, collection_report,
       output_parameters_report, run;
