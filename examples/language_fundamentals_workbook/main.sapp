let OS = import("stdlib:os.sapp");
let WORKBOOK = import("examples/language_fundamentals_workbook/workbook.sapp");

fn main() {
    let arguments = OS.script_args();
    let report = nil;
    if len(arguments) == 0 {
        report = try WORKBOOK.run() catch nil;
    } else {
        report = try WORKBOOK.run(arguments) catch nil;
    }
    if report == nil {
        print "Invalid student list: use at most 64 non-empty names of at most 128 UTF-8 bytes";
        return false;
    }
    print json_stringify(report);
    return report.verified;
}

main();
