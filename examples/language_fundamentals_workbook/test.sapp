let WORKBOOK = import("examples/language_fundamentals_workbook/workbook.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "language_fundamentals_workbook test failed: " + message; }
}

fn rejected(callable) { return (try { callable(); false } catch true); }

let arithmetic = WORKBOOK.arithmetic_report(10, -50, 1.2, -10.62);
require(arithmetic.sum == -40 and arithmetic.product == -500,
"arithmetic and corrected class constructor must agree");
require(arithmetic.quotient_truncated_toward_zero == 0 and arithmetic.remainder == 10,
"integer division must preserve C# truncation semantics");
require(arithmetic.constructor_fields_correct,
"constructor arguments must initialize instance fields in the correct direction");
require(rejected(fn() { WORKBOOK.arithmetic_report(10, 0, 1, 2); }),
"division by zero must fail explicitly");
require(rejected(fn() { WORKBOOK.arithmetic_report(1000000001, 2, 1, 2); }),
"arithmetic magnitude must be bounded");

let text = WORKBOOK.text_report("Friend", "Hello learner");
require(text.first_character == "F" and text.first_codepoint == 70,
"first-character extraction must expose the Unicode codepoint");
require(text.round_trip_verified and text.codepoint_round_trip == "F",
"codepoint conversion must round-trip");
require(rejected(fn() { WORKBOOK.text_report("", "valid"); }),
"empty text must fail");

require(WORKBOOK.comparison_report(3, 2).relation == "left-greater",
"greater branch must be reachable");
require(WORKBOOK.comparison_report(2, 3).relation == "right-greater",
"less branch must be reachable");
require(WORKBOOK.comparison_report(3, 3).relation == "equal",
"equal branch must be reachable");

let loops = WORKBOOK.loop_report(3, 10, 5, 25);
require(str(loops.triangle) == "[*, **, ***]",
"nested loop must build the expected triangle rows");
require(str(loops.progression) == "[10, 15, 20, 25]" and loops.progression_complete,
"while loop must terminate after the inclusive limit");
require(rejected(fn() { WORKBOOK.loop_report(33, 0, 1, 1); }),
"triangle rows must be bounded");
require(rejected(fn() { WORKBOOK.loop_report(1, 0, 0, 1); }),
"non-progressing loop steps must be rejected");

let names = [" Student One ", "Student Two"];
let attendance = WORKBOOK.attendance_report(names);
require(attendance.count == 2 and attendance.students[0] == "Student One",
"attendance must normalize a copied list");
require(str(names) == "[ Student One , Student Two]" and attendance.input_mutated,
"normalization must not mutate caller input");
require(rejected(fn() { WORKBOOK.attendance_report([""]); }),
"empty student entries must fail");
let oversized = [];
let oi = 0;
while oi < 65 { array_push(oversized, "Student"); oi = oi + 1; }
require(rejected(fn() { WORKBOOK.attendance_report(oversized); }),
"attendance allocation must be bounded");

let empty = WORKBOOK.collection_report(0);
let collection = WORKBOOK.collection_report(100);
require(empty.average == nil and empty.initialized == 0,
"empty collection must avoid division by zero");
require(collection.initialized == 100 and collection.numbers[99] == 99
and collection.sum == 4950 and collection.all_elements_initialized,
"collection must initialize every element before use");
require(rejected(fn() { WORKBOOK.collection_report(257); }),
"collection size must be bounded");

let output = WORKBOOK.output_parameters_report(15);
require(output.number == 25 and output.label == "items",
"multi-value output is represented explicitly as a result map");

let full = WORKBOOK.run(["Student One"]);
require(full.verified and full.bounded and full.attendance.count == 1,
"integrated workbook report must verify itself");
require(WORKBOOK.source_sha256().program ==
"00e145ff8addc6b967fd72c09649590d7f2aa6e808e027b8d58df29a3fcc1772",
"source provenance digest must remain stable");

for source_path in [
    "examples/language_fundamentals_workbook/workbook.sapp",
    "examples/language_fundamentals_workbook/main.sapp",
    "examples/language_fundamentals_workbook/test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
    "bounded security analysis must pass for " + source_path);
}

print "language_fundamentals_workbook_pass";
