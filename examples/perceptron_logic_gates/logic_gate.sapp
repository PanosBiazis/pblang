let ML = import("stdlib:ml.sapp");

fn dataset(name) {
    let normalized = str_lower(str_trim(str(name)));
    let samples = [[0, 0], [0, 1], [1, 0], [1, 1]];
    if normalized == "and" { return map{ ok: true, name: "AND", samples: samples,
        labels: [0, 0, 0, 1], linearly_separable: true }; }
    if normalized == "or" { return map{ ok: true, name: "OR", samples: samples,
        labels: [0, 1, 1, 1], linearly_separable: true }; }
    if normalized == "nand" { return map{ ok: true, name: "NAND", samples: samples,
        labels: [1, 1, 1, 0], linearly_separable: true }; }
    if normalized == "xor" { return map{ ok: true, name: "XOR", samples: samples,
        labels: [0, 1, 1, 0], linearly_separable: false }; }
    return map{ ok: false, error: "gate must be and, or, nand, or xor" };
}

fn classify_gate(gate_name, max_epochs) {
    let report = dataset(gate_name);
    if not report.ok {
        return report;
    }
    if type(max_epochs) != "number" or max_epochs != num_floor(max_epochs)
       or max_epochs < 1 or max_epochs > 10000 {
        return map{ ok: false, error: "max_epochs must be an integer in 1..10000" };
    }
    let initial = ML.perceptron_create([0.2, 0.3], 0.1);
    let training = ML.perceptron_train(initial, report.samples, report.labels,
        map{ learning_rate: 0.1, max_epochs: max_epochs, early_stop: true });
    let evaluation = ML.perceptron_evaluate(training.model, report.samples, report.labels);
    let expectation_met = false;
    if report.linearly_separable {
        expectation_met = training.converged and evaluation.accuracy == 1;
    } else {
        expectation_met = not training.converged and evaluation.accuracy < 1;
    }
    return map{ ok: true, gate: report.name, linearly_separable: report.linearly_separable,
                initial_model: initial, training: training, evaluation: evaluation,
                expectation_met: expectation_met };
}

export dataset, classify_gate;
