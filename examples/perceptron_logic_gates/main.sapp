let OS = import("stdlib:os.sapp");
let Gates = import("logic_gate.sapp");

fn usage() {
    print "Usage: pblang run examples/perceptron_logic_gates/main.sapp -- <and|or|nand|xor> [max-epochs]";
}

fn main() {
    let args = OS.script_args();
    if len(args) < 1 or len(args) > 2 { usage(); return false; }
    let max_epochs = 100;
    if len(args) == 2 {
        max_epochs = try parse_number(args[1]) catch -1;
    }
    let result = Gates.classify_gate(args[0], max_epochs);
    if not result.ok { print "Unable to train: " + result.error; return false; }
    print result.gate + " perceptron";
    print "Linearly separable: " + str(result.linearly_separable);
    let i = 0;
    while i < len(result.evaluation.predictions) {
        print json_stringify(Gates.dataset(args[0]).samples[i]) + " -> "
            + str(result.evaluation.predictions[i]);
        i = i + 1;
    }
    print "Converged: " + str(result.training.converged);
    print "Epochs: " + str(result.training.epochs_run)
        + ", updates: " + str(result.training.updates)
        + ", accuracy: " + str(result.evaluation.accuracy);
    print "Expectation check: " + if result.expectation_met { "passed" } else { "failed" };
    return result.expectation_met;
}

main();
