let Gates = import("logic_gate.sapp");

fn require(condition, message) {
    if not condition { throw "FAIL perceptron_logic_gates: " + message; }
}

for gate in ["and", "or", "nand"] {
    let result = Gates.classify_gate(gate, 100);
    require(result.ok and result.linearly_separable and result.training.converged
        and result.evaluation.accuracy == 1 and result.expectation_met,
        str_upper(gate) + " must converge and classify every row");
}

let xor_result = Gates.classify_gate("xor", 40);
require(xor_result.ok and not xor_result.linearly_separable
    and not xor_result.training.converged and xor_result.evaluation.accuracy < 1
    and xor_result.expectation_met,
    "XOR must be reported as outside one perceptron's capacity");
require(not Gates.dataset("unknown").ok, "unknown gates must fail cleanly");
require(not Gates.classify_gate("and", 0).ok, "invalid epoch policy must fail cleanly");

print "perceptron_logic_gates_pass";
