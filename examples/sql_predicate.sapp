let P=import("stdlib:sql_predicate.sapp");
let O=import("stdlib:orm.sapp");
let Owned=import("stdlib:db_owned.sapp");
let count=Owned.with_sqlite(":memory:",fn(c){
 O.define_model(c,"items",["name TEXT","age INTEGER"]);
 O.insert(c,"items",map{name:"alpha",age:21});
 O.insert(c,"items",map{name:"beta",age:17});
 let filter=P.compile_all([["age","ge",18],["name","in",["alpha","gamma"]]]);
 return len(O.find(c,"items",map{where:filter.sql,params:filter.params}));
});
print count;
