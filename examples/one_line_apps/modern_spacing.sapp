// Shared spacing presets through the existing application builders.
let UI=import("stdlib:modern_ui.sapp");
let Space=import("stdlib:ui_spacing.sapp");
let Type=import("stdlib:ui_typography.sapp");
let Style=import("stdlib:ui_style.sapp");
fn view() {
    let cards=[];
    for density in ["compact","comfortable","spacious"] {
        array_push(cards,UI.card([
            UI.heading(density,Type.preset("subtitle",map{wrap:true})),
            UI.text("Your space.",Type.preset("body",map{wrap:true})),
            UI.text("Your choice.",Type.preset("caption",map{wrap:true}))
        ],Space.preset(density)));
    }
    return UI.screen([
        UI.text("PBLANG / SPACING STUDIO",Type.preset("caption",map{tone:"accent"})),
        UI.heading("Room to breathe.",Type.preset("display",map{wrap:true,max_lines:3})),
        UI.row(cards,map{gap:18,padding:0,responsive:true}),
        UI.card([
            UI.heading("Keep controls apart",Type.preset("subtitle",map{wrap:true})),
            UI.grid([UI.button("One",nil,map{variant:"secondary"}),UI.button("Two",nil,map{variant:"secondary"}),
                UI.button("Three",nil,map{variant:"secondary"}),UI.button("Four",nil,map{variant:"secondary"})],map{columns:2,gap:12,padding:0}),
            UI.text("Ready",Type.preset("body",map{name:"status",wrap:true})),
            UI.button("Try an action",UI.action_set_text("status","Spacing preserves actions."),map{fill_width:true})
        ],Space.preset("comfortable",map{fill_width:true}))
    ],Space.preset("comfortable"));
}
fn main() {
    let args=str(try env_get("PBLANG_SCRIPT_ARGS") catch "");
    let options=Style.options("light");options.width=1080;options.height=900;
    if str_contains(args,"--web") {return UI.export_web("PBLang Spacing Studio",view(),"build/modern-spacing",options);}
    if str_contains(args,"--android-build") {
        options.package="org.pblang.spacingstudio";options.output="build/pblang-spacing-studio.apk";
        return UI.build_android("PBLang Spacing Studio",view(),options);
    }
    options.preview=not str_contains(args,"--native");
    let result=UI.run("PBLang Spacing Studio",view(),options);
    return map{widgets:result.widgets,preview:result.preview};
}
print json_stringify(main());
