// Optional text flow through the existing native, Web and Android builders.
let UI=import("stdlib:modern_ui.sapp");
let Type=import("stdlib:ui_typography.sapp");
let Style=import("stdlib:ui_style.sapp");
fn view() {
    let cards=[];
    for alignment in ["left","center","right"] {
        array_push(cards,UI.card([
            UI.text(alignment,Type.preset("caption",map{tone:"accent",text_align:alignment,fill_width:true})),
            UI.heading("Room for every word",Type.preset("title",map{wrap:true,max_lines:3,text_align:alignment,fill_width:true})),
            UI.text("A shared options map lets your message adapt to the space available on each screen.",
                Type.preset("body",map{wrap:true,max_lines:5,text_align:alignment,fill_width:true}))
        ],map{padding:18,gap:12,grow:1,fill_width:true}));
    }
    return UI.screen([
        UI.text("PBLANG / TEXT FLOW",Type.preset("caption",map{tone:"accent"})),
        UI.heading("Give your words room.",Type.preset("display",map{wrap:true,max_lines:3})),
        UI.text("Readable layouts that follow your content, from a wide desktop to a narrow phone.",Type.preset("body",map{wrap:true,max_lines:3})),
        UI.row(cards,map{gap:20,responsive:true}),
        UI.card([
            UI.heading("Choose how much to show",Type.preset("subtitle",map{wrap:true})),
            UI.text("This paragraph has a two-line limit. Extra content ends with an ellipsis so the reader can see that there is more to discover. The same choice travels with the app to Web, native GUI and Android.",
                Type.preset("body",map{wrap:true,max_lines:2,fill_width:true})),
            UI.text("Preserved line breaks.\nPredictable space for the next control.",Type.preset("caption",map{wrap:true,max_lines:2,fill_width:true}))
        ],map{padding:20,gap:12})
    ],map{padding:24,gap:20});
}
fn main() {
    let args=str(try env_get("PBLANG_SCRIPT_ARGS") catch "");
    let options=Style.options("light");options.width=1080;options.height=800;
    if str_contains(args,"--web") {return UI.export_web("PBLang Text Flow",view(),"build/modern-text-flow",options);}
    if str_contains(args,"--android-build") {
        options.package="org.pblang.textflow";options.output="build/pblang-text-flow.apk";
        return UI.build_android("PBLang Text Flow",view(),options);
    }
    options.preview=not str_contains(args,"--native");
    let result=UI.run("PBLang Text Flow",view(),options);
    return map{widgets:result.widgets,preview:result.preview};
}
print json_stringify(main());
