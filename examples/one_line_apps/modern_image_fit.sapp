// One image and three explicit framing choices. No network or external assets.
let UI=import("stdlib:modern_ui.sapp");
let Style=import("stdlib:ui_style.sapp");
let Pipeline=import("stdlib:image_pipeline.sapp");
let Images=import("stdlib:modern_ui_android_image.sapp");
fn sample() {
    let pixels=[];
    for y 16 {
        let row=[];
        for x 32 {
            let c=[35,58,94];
            if x<8 {c=[47,179,170];} elif x>=24 {c=[240,151,68];}
            if (x-16)*(x-16)+(y-8)*(y-8)<=36 {c=[245,239,212];}
            array_push(row,c);
        }
        array_push(pixels,row);
    }
    return pixels;
}
fn view(rendering="auto") {
    let frame=sample();let cards=[];
    let descriptions=["Keep the entire image","Fill the frame with a center crop","Match the frame dimensions"];
    let index=0;
    for fit in ["contain","cover","stretch"] {
        array_push(cards,UI.card([
            UI.image(frame,map{name:fit,fit:fit,image_rendering:rendering,h:180,src:"./sample.png",accessibility_label:"Colored panorama with a circle"}),
            UI.text(descriptions[index],map{wrap:true})
        ],map{title:fit,padding:16,gap:12,fill_width:true}));index=index+1;
    }
    return UI.screen([UI.text("PBLANG / IMAGE STUDIO",map{tone:"accent"}),
        UI.heading("One image. Three ways to frame it.",map{wrap:true}),
        UI.text("Choose image framing and pixel rendering for each image.",map{wrap:true}),
        UI.row(cards,map{gap:20,responsive:true})],map{padding:24,gap:18});
}
fn main() {
    let args=str(try env_get("PBLANG_SCRIPT_ARGS") catch "");
    let options=Style.options("light");options.width=1080;options.height=680;
    let rendering=if str_contains(args,"--pixelated") {"pixelated"} else {"auto"};
    let tree=view(rendering);
    if str_contains(args,"--android-build") {
        options.android_images=true;options.package="org.pblang.imagestudio";
        options.output="build/pblang-image-studio.apk";
        return UI.build_android("PBLang Image Studio",tree,options);
    }
    if str_contains(args,"--web") {
        let output="build/modern-image-fit";
        let result=UI.export_web("PBLang Image Studio",tree,output,options);
        fs_write_bytes(output+"/sample.png",Pipeline.encode_png(Images.normalize(sample()).image));
        return map{ok:result.ok,output:output};
    }
    options.preview=not str_contains(args,"--native");
    let result=UI.run("PBLang Image Studio",tree,options);
    return map{widgets:result.widgets,preview:result.preview};
}
print json_stringify(main());
