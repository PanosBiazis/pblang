// Every call is a compact facade over the corresponding configurable PBLang
// library. Preview execution keeps this example terminating and side-effect-free.
let app = import("stdlib:app.sapp");

let rest = app.rest("Status API", fn(ctx) { return map{ status: "ok" }; }, map{ preview: true });
let desktop = app.desktop("Dashboard", [map{ kind: "label", text: "Ready" }], map{ preview: true });
let game = app.game("Movement", fn(ctx) { return ctx.modules.game.vec2(ctx.step, ctx.step * 2); }, map{ preview: true, preview_execute: true, steps: 3 });
let multimedia = app.multimedia("Image", fn(ctx) { return ctx.modules.image.make_image(2, 2, 255); }, map{ preview: true, preview_execute: true });
let database = app.database("SQL", fn(ctx) { return ctx.modules.db.sql_placeholders(2); }, map{ preview: true, preview_execute: true, allow_io: true });
let networking = app.networking("Request", fn(ctx) { return ctx.modules.networking.new_request("GET", "https://example.invalid"); }, map{ preview: true, preview_execute: true, allow_io: true });
let automation = app.automation("Workflow", fn(ctx) { return ctx.step + 1; }, map{ preview: true, preview_execute: true, steps: 3 });
let ai = app.ai("Similarity", fn(ctx) { return ctx.modules.ai.cosine_similarity([1, 0], [1, 0]); }, map{ preview: true, preview_execute: true, allow_io: true });
let ml = app.ml("Regression", fn(ctx) { return ctx.modules.ml.linreg_predict(ctx.modules.ml.linreg_fit([1, 2, 3], [2, 4, 6]), 4); }, map{ preview: true, preview_execute: true });

print "one-line domain apps: rest=" + rest.response.json.status
    + " desktop_widgets=" + str(desktop.widgets)
    + " game_x=" + str(game.value.x)
    + " image_rows=" + str(len(multimedia.value))
    + " sql=" + database.value
    + " request=" + networking.value.method
    + " workflow=" + str(automation.value)
    + " ai=" + str(ai.value)
    + " ml=" + str(ml.value);
