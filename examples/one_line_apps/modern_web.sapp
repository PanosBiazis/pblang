let app = import("stdlib/app.sapp");
let ui = import("stdlib/modern_ui.sapp");

let view = ui.screen([
ui.heading("PBLang everywhere", map{ name: "status" }),
ui.card([
ui.input("", map{ name: "name", placeholder: "Your name" }),
ui.button("Continue", ui.action_sequence([
ui.action_set_text("status", "Ready"),
ui.action_message("The same components run on desktop, Web and Android")
]))
], map{ title: "Shared component tree" })
]);

let result = app.surface("Modern Web", view, map{
    mode: "web", operation: "preview", theme: "light"
});
print "web_status=" + str(result.response.status);
print "web_bytes=" + str(len(result.response.body));
