let app = import("stdlib/app.sapp"); app.run(map{ kind: "gui", name: "One-line GUI", width: 520, height: 280, widgets: [map{ kind: "label", text: "Built only with pblang" }, map{ kind: "textbox", name: "message", value: "Edit me" }, map{ kind: "slider", name: "level", value: 70 }, map{ kind: "button", text: "Close from the window controls" }] });
