let app = import("stdlib/app.sapp"); print app.fullstack("One-line workspace", map{ preview: true, start: "web", cli: map{ message: "ready" }, gui: map{ widgets: [map{ kind: "label", text: "Ready" }] }, web: map{ handler: fn(ctx) { return ctx.json(map{ ready: true }); } } }).web.response.json.ready;
