let app = import("stdlib/app.sapp");
let ui = import("stdlib/modern_ui.sapp");

let view = ui.screen([
    ui.heading("PBLang Device Center", map{ name: "status" }),
    ui.text("The same declarative tree runs on desktop and builds for Android."),
    ui.card([
        ui.input("", map{ name: "device", placeholder: "Device name" }),
        ui.row([
            ui.choice(["USB", "Wi-Fi", "Tor"], 1, nil, map{ name: "transport" }),
            ui.toggle("Remember", true, nil, map{ name: "remember" })
        ]),
        ui.slider(65, 0, 100, nil, map{ name: "quality" }),
        ui.progress(65, map{ name: "progress" }),
        ui.button("Connect", ui.action_sequence([
            ui.action_set_text("status", "Connected securely"),
            ui.action_message("Device is ready")
        ]), map{ name: "connect", accessibility_label: "Connect to device" })
    ], map{ title: "Connection" })
]);

let result = app.modern_android("PBLang Modern UI", view, map{
    package: "org.pblang.modernuidemo",
    min_sdk: 21,
    target_sdk: 34,
    theme: "dark",
    width: 412,
    height: 915,
    output: "examples/one_line_apps/release/PBLang-Modern-UI-debug.apk"
});
if not result.ok { throw "Android build failed at " + result.stage + ": " + result.error; }
print "apk=" + result.output;
print "sha256=" + result.sha256;
