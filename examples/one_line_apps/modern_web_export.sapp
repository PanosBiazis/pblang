let app = import("stdlib/app.sapp");
let ui = import("stdlib/modern_ui.sapp");
let gfx = import("stdlib/graphics.sapp");

let view = ui.screen([
ui.heading("PBLang Studio", map{ name: "status" }),
ui.text("One component tree for desktop, browser and Android."),
ui.card([
ui.row([
ui.input("", map{
    name: "project", placeholder: "Project name",
    accessibility_label: "Project name"
}),
ui.choice(["Desktop", "Web", "Android"], 1, nil, map{ name: "target" })
]),
ui.grid([
ui.button("Create", ui.action_sequence([
ui.action_set_text("status", "Project ready"),
ui.action_message("Created with shared PBLang components")
])),
ui.toggle("Open in PBIDE", true),
ui.progress(0.8, map{ accessibility_label: "Build progress" })
], map{ columns: 3 })
], map{ title: "New application" })
]);

let result = app.surface("PBLang Studio", view, map{
    mode: "web", operation: "export",
    output: "build/modern-web-demo",
    theme: "light",
    palette: map{ accent: gfx.rgb(0, 122, 112) }
});
print "web_export=" + result.output;
print "web_digest=" + result.digest;
