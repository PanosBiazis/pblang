let app = import("stdlib/app.sapp");
let ui = import("stdlib/modern_ui.sapp");

app.modern("PBLang Modern UI", ui.screen([
    ui.heading("One view, responsive layout"),
    ui.text("Resize the window: rows and grids adapt automatically."),
    ui.card([
        ui.row([
            ui.input("Ada", map{ name: "name" }),
            ui.choice(["Dark", "Light", "System"], 0, nil, map{ name: "theme" })
        ]),
        ui.grid([
            ui.button("Create"),
            ui.button("Preview"),
            ui.button("Publish")
        ], map{ columns: 3 }),
        ui.toggle("Remember workspace", true),
        ui.progress(0.72)
    ], map{ title: "Project" })
]), map{ width: 820, height: 560, theme: "dark" });
