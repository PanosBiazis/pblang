// The same checkbox action works through the existing native/Web/Android builders.
let UI=import("stdlib:modern_ui.sapp");
let Style=import("stdlib:ui_style.sapp");
let Type=import("stdlib:ui_typography.sapp");
fn view() {
    return UI.screen([
        UI.heading("One change. One action.",Type.preset("display",map{wrap:true})),
        UI.text("Click a checkbox or its label. Use Tab and Space with a keyboard.",Type.preset("body",map{wrap:true})),
        UI.card([
            UI.toggle("Notifications",false,UI.action_set_text("status","Notifications changed"),map{name:"notify",accessibility_label:"Notifications for this project"}),
            UI.toggle("Locked preference",false,nil,map{name:"locked",enabled:false,accessibility_label:"Locked project preference",action:UI.action_set_text("status","ERROR: disabled action ran")})
        ],Style.card_preset("surface",map{padding:20,gap:20})),
        UI.text("Ready",Type.preset("body",map{name:"status",wrap:true})),
        UI.button("Reset message",UI.action_set_text("status","Ready"),map{name:"reset"})
    ],map{padding:20,gap:20});
}
fn main() {
    let args=str(try env_get("PBLANG_SCRIPT_ARGS") catch "");let options=Style.options("light");options.width=900;options.height=640;
    if str_contains(args,"--web") {return UI.export_web("PBLang Toggle Actions",view(),"build/modern-toggle-actions",options);}
    if str_contains(args,"--android-build") {options.package="org.pblang.toggleactions";options.output="build/pblang-toggle-actions.apk";return UI.build_android("PBLang Toggle Actions",view(),options);}
    options.preview=not str_contains(args,"--native");let result=UI.run("PBLang Toggle Actions",view(),options);return map{widgets:result.widgets,preview:result.preview};
}
print json_stringify(main());
