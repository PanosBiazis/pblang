// Shared type presets, ordinary option maps, existing platform adapters.
let UI=import("stdlib:modern_ui.sapp");
let Type=import("stdlib:ui_typography.sapp");
let Style=import("stdlib:ui_style.sapp");
fn view() {
    let cards=[];
    for alignment in ["left","center","right"] {
        array_push(cards,UI.card([
            UI.text(alignment,Type.preset("caption",map{tone:"accent",text_align:alignment,fill_width:true})),
            UI.heading("Aa 123",Type.preset("title",map{text_align:alignment,fill_width:true})),
            UI.text("Your type.",Type.preset("body",map{text_align:alignment,fill_width:true}))
        ],map{padding:18,gap:12,grow:1,fill_width:true}));
    }
    return UI.screen([
        UI.text("PBLANG / TYPE STUDIO",Type.preset("caption",map{tone:"accent"})),
        UI.heading("Make it clear.",Type.preset("display",map{tone:"primary"})),
        UI.text("Size, weight and alignment from one options map.",Type.preset("body")),
        UI.row(cards,map{gap:20,responsive:true}),
        UI.card([
            UI.heading("Five ready-to-use styles",Type.preset("subtitle")),
            UI.text("Display / Title / Subtitle / Body / Caption",Type.preset("body")),
            UI.text("Shared choices. Existing application builders.",Type.preset("caption",map{tone:"muted"}))
        ],map{padding:20,gap:12})
    ],map{padding:24,gap:20});
}
fn main() {
    let args=str(try env_get("PBLANG_SCRIPT_ARGS") catch "");
    let options=Style.options("light");options.width=1080;options.height=720;
    if str_contains(args,"--web") {return UI.export_web("PBLang Type Studio",view(),"build/modern-typography",options);}
    if str_contains(args,"--android-build") {
        options.package="org.pblang.typestudio";options.output="build/pblang-type-studio.apk";
        return UI.build_android("PBLang Type Studio",view(),options);
    }
    options.preview=not str_contains(args,"--native");
    let result=UI.run("PBLang Type Studio",view(),options);
    return map{widgets:result.widgets,preview:result.preview};
}
print json_stringify(main());
