let app = import("stdlib/app.sapp");
let ui = import("stdlib/modern_ui.sapp");

let shared = ui.screen([
ui.heading("One UI, many surfaces"),
ui.row([
ui.input("", map{ name: "query", placeholder: "Search" }),
ui.button("Search", ui.action_message("Searching"))
])
]);

// Change only mode/operation; components and application structure stay shared.
let result = app.surface("Shared UI", shared, map{
    mode: "auto", operation: "preview", theme: "dark"
});
print result.kind;
