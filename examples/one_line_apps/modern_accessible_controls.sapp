// Contextual names reuse the same controls, visual labels and actions.
let UI=import("stdlib:modern_ui.sapp");
let Style=import("stdlib:ui_style.sapp");
let Type=import("stdlib:ui_typography.sapp");
fn project(title,key,variant) {
    return UI.card([
        UI.heading(title,Type.preset("title",map{wrap:true})),
        UI.text("One clear name for every action.",Type.preset("body",map{wrap:true})),
        UI.button("Open",UI.action_set_text("status","Opened "+title),map{name:key,accessibility_label:"Open project "+title,fill_width:true})
    ],Style.card_preset(variant,map{padding:20,gap:16}));
}
fn view() {
    return UI.screen([
        UI.heading("Names that give context",Type.preset("display",map{wrap:true})),
        UI.text("Use Tab and Enter to open a project. Each Open button has its own accessible name.",Type.preset("body",map{wrap:true})),
        UI.row([project("Atlas","atlas","surface"),project("Boreal","boreal","outlined")],map{gap:24,responsive:true}),
        UI.toggle("Notifications",true,nil,map{name:"notify",accessibility_label:"Notifications for project Atlas"}),
        UI.button("Open",nil,map{name:"unavailable",enabled:false,accessibility_label:"Open unavailable project"}),
        UI.text("Ready",Type.preset("body",map{name:"status",wrap:true}))
    ],map{padding:20,gap:20});
}
fn main() {
    let args=str(try env_get("PBLANG_SCRIPT_ARGS") catch "");
    let options=Style.options("light");options.width=1000;options.height=720;
    if str_contains(args,"--web") {return UI.export_web("PBLang Accessible Controls",view(),"build/modern-accessible-controls",options);}
    if str_contains(args,"--android-build") {
        options.package="org.pblang.accessiblecontrols";options.output="build/pblang-accessible-controls.apk";
        return UI.build_android("PBLang Accessible Controls",view(),options);
    }
    options.preview=not str_contains(args,"--native");
    let result=UI.run("PBLang Accessible Controls",view(),options);
    return map{widgets:result.widgets,preview:result.preview};
}
print json_stringify(main());
