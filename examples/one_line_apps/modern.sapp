let app = import("stdlib/app.sapp");
let ui = import("stdlib/modern_ui.sapp");

let result = app.modern("Device center", ui.screen([
    ui.heading("Device center"),
    ui.card([
        ui.row([
            ui.input("", map{ name: "device", bind: "device" }),
            ui.choice(["USB", "LAN", "Tor"], 1, nil, map{ name: "transport" })
        ]),
        ui.grid([
            ui.button("Connect"),
            ui.button("Files"),
            ui.button("Terminal")
        ], map{ columns: 3 }),
        ui.progress(0.65)
    ], map{ title: "Connection" })
]), map{
    preview: true,
    model: map{ device: "Local device" },
    width: 760,
    height: 520,
    theme: "dark"
});

print "modern target=" + result.plan.target
    + " widgets=" + str(result.widgets)
    + " density=" + result.form.viewport.density;
