// Per-card choices extend the same Modern UI tree and existing renderers.
let UI=import("stdlib:modern_ui.sapp");
let Style=import("stdlib:ui_style.sapp");
let Space=import("stdlib:ui_spacing.sapp");
let Type=import("stdlib:ui_typography.sapp");
fn view() {
    let cards=[];
    for name in ["surface","outlined","tonal"] {
        let options=Style.card_preset(name,map{padding:20,gap:14});
        if name=="outlined" {options.card_radius=0;}
        array_push(cards,UI.card([
            UI.heading(name,Type.preset("title",map{wrap:true})),
            UI.text("Your own shape.",Type.preset("body",map{wrap:true})),
            UI.text("Same shared theme.",Type.preset("caption",map{wrap:true}))
        ],options));
    }
    return UI.screen([
        UI.text("PBLANG / CARD STUDIO",Type.preset("caption",map{tone:"accent"})),
        UI.heading("Make each surface yours.",Type.preset("display",map{wrap:true,max_lines:3})),
        UI.text("Choose corners, borders and depth with one options map.",Type.preset("body",map{wrap:true})),
        UI.row(cards,map{gap:24,padding:8,responsive:true}),
        UI.card([
            UI.heading("Built on what already works",Type.preset("subtitle",map{wrap:true})),
            UI.text("Cards can differ while controls and actions stay familiar.",Type.preset("body",map{wrap:true})),
            UI.text("Ready",Type.preset("body",map{name:"status",wrap:true})),
            UI.button("Try it",UI.action_set_text("status","Your action still works."),map{fill_width:true})
        ],Style.card_preset("surface",map{card_radius:24,card_elevation:4,padding:24,gap:16,fill_width:true}))
    ],Space.preset("comfortable"));
}
fn main() {
    let args=str(try env_get("PBLANG_SCRIPT_ARGS") catch "");
    let options=Style.options(if str_contains(args,"--dark") {"dark"} else {"light"});options.width=1080;options.height=800;
    if options.theme=="light" {options.palette.field=[234,237,250];}
    if str_contains(args,"--web") {return UI.export_web("PBLang Card Studio",view(),"build/modern-cards",options);}
    if str_contains(args,"--android-build") {
        options.package="org.pblang.cardstudio";options.output="build/pblang-card-studio.apk";
        return UI.build_android("PBLang Card Studio",view(),options);
    }
    options.preview=not str_contains(args,"--native");
    let result=UI.run("PBLang Card Studio",view(),options);
    return map{widgets:result.widgets,preview:result.preview};
}
print json_stringify(main());
