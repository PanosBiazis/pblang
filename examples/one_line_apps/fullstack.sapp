let app = import("stdlib/app.sapp"); print app.run(map{ kind: "fullstack", name: "One-line workspace", preview: true, start: "web", cli: map{ args: ["status"], commands: map{ status: fn(ctx) { return "ready"; } } }, gui: map{ model: map{ status: "ready" }, widgets: [map{ kind: "label", text: "Workspace" }, map{ kind: "textbox", name: "status", bind: "status" }] }, web: map{ routes: [map{ path: "/", handler: fn(ctx) { return ctx.html("<h1>One-line full-stack pblang</h1>"); } }] } }).kind;
