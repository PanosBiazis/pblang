// Run with a new .zip destination after --. Only synthetic explicit bytes.
let A=import("stdlib:secure_archive.sapp");
let P=import("stdlib:archive_publication.sapp");
let OS=import("stdlib:os.sapp");
let args=OS.script_args();
if len(args)!=1 { print "Usage: publish.sapp NEW.zip"; OS.exit(1); }
let bytes=A.pack([map{name:"documents/",data:[]},
    map{name:"documents/hello.txt",data:str_to_bytes("Hello from PBLang")},
    map{name:"binary.bin",data:[0,128,255]}],"fast");
let result=P.save(args[0],bytes);
print json_stringify(result);
if not result.ok { OS.exit(1); }
