// Caller explicitly chooses a new file, never a directory tree.
let A=import("stdlib:secure_archive.sapp");
let P=import("stdlib:archive_publication.sapp");
let OS=import("stdlib:os.sapp");
let args=OS.script_args();
assert(len(args)==1,"Usage: extract.sapp NEW_FILE");
let bytes=A.pack([map{name:"nested/binary.bin",data:[0,128,255]}],"store");
let result=P.extract_member(args[0],bytes,"nested/binary.bin");
print json_stringify(result);
if not result.ok { OS.exit(1); }
