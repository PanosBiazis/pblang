let A=import("stdlib:secure_archive.sapp");
let P=import("stdlib:archive_publication.sapp");
let OS=import("stdlib:os.sapp");
let args=OS.script_args();assert(len(args)==1,"Usage: extract_empty.sapp NEW_FILE");
let bytes=A.pack([map{name:"empty.txt",data:[]},map{name:"other.txt",data:[1]}],"store");
let result=P.extract_member(args[0],bytes,"empty.txt");
print json_stringify(result);
if not result.ok {OS.exit(1);}
