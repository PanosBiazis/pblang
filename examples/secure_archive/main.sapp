// Explicit bytes only: no implicit disk access, extraction or code execution.
let Archive=import("stdlib:secure_archive.sapp");
let archive=Archive.pack([
    map{name:"documents/",data:[]},
    map{name:"documents/hello.txt",data:str_to_bytes("Hello from PBLang")},
    map{name:"binary.bin",data:[0,128,255]}
],"fast");
print json_stringify(Archive.inspect(archive));
let preview=Archive.view(archive,"documents/hello.txt",5);
print bytes_to_str(preview.data);
print preview.truncated;
let files=Archive.unpack(archive);
print files[2].data;
