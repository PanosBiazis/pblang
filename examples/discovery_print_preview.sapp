// Synthetic page planning; no printer, driver, file or network access.
let Units=import("stdlib:units.sapp");let Clip=import("stdlib:rect_clip.sapp");
fn pixels(mm,dpi) {return mm*(dpi/(Units.in_to_cm(1)*10));}
fn page(width_mm,height_mm,margins,dpi) {
 for size in [width_mm,height_mm] {if type(size)!="number" or not(size>=1 and size<=2000) {throw "invalid paper size";}}
 if type(dpi)!="number" or not(dpi>=36 and dpi<=1200) or dpi!=num_floor(dpi) {throw "invalid DPI";}
 if type(margins)!="array" or len(margins)!=4 {throw "expected left top right bottom margins";}
 for margin in margins {if type(margin)!="number" or not(margin>=0 and margin<=2000) {throw "invalid margin";}}
 if margins[0]+margins[2]>=width_mm or margins[1]+margins[3]>=height_mm {throw "no printable area";}
 let left=num_ceil(pixels(margins[0],dpi));let top=num_ceil(pixels(margins[1],dpi));
 let right=num_floor(pixels(width_mm-margins[2],dpi));let bottom=num_floor(pixels(height_mm-margins[3],dpi));
 if right<=left or bottom<=top {throw "no whole printable pixel";}
 return map{width:num_floor(pixels(width_mm,dpi)),height:num_floor(pixels(height_mm,dpi)),
  clip:Clip.region(map{x:left,y:top,w:right-left,h:bottom-top}),dpi:dpi};
}
let frame=page(210,297,[10,10,10,10],254);
assert(frame.width==2100 and frame.height==2970 and frame.clip==map{x:100,y:100,w:1900,h:2770},"millimetres to pixel page");
// Use the existing clip adapter with a recording sink instead of a device.
let calls=[];let sink=map{rect:fn(x,y,w,h,color){array_push(calls,map{x:x,y:y,w:w,h:h});}};
let canvas=Clip.canvas(sink,frame.clip);
for x in [80,180,1950,2050] {canvas.rect(x,90,80,40,0);}
assert(calls==[map{x:100,y:100,w:60,h:30},map{x:180,y:100,w:80,h:30},map{x:1950,y:100,w:50,h:30}],"motifs clipped to page interior; outside motif discarded");
let fractional=page(10,10,[0.15,0.25,0.15,0.25],254);
assert(fractional.clip==map{x:2,y:3,w:96,h:94},"fractional pixel edges rounded inward");
let invalid_margins=(try page(210,297,[110,10,100,10],254) catch nil)==nil;
let invalid_dpi=(try page(210,297,[10,10,10,10],true) catch nil)==nil;
let subpixel=(try page(1,1,[0.49,0.49,0.49,0.49],36) catch nil)==nil;
assert(invalid_margins and invalid_dpi and subpixel,"invalid or subpixel area rejected");
assert(frame.clip==map{x:100,y:100,w:1900,h:2770},"source frame unchanged");
print json_stringify(map{format:"pblang.print-preview-lessons.v1",synthetic:true,printer_accessed:false,
 page:frame,clipped_motifs:calls,fractional_page:fractional,
 rejected:map{empty_area:invalid_margins,boolean_dpi:invalid_dpi,subpixel_area:subpixel},physical_print_verified:false});
