// Trusted maintainer example only; use an existing private test directory.
// This low-level backend does not yet verify package/root ACLs itself.
let W=import("stdlib:windows_dirfs.sapp");
let Resources=import("stdlib:resource_scope.sapp");
assert(platform()=="windows","explicit Windows example lane required");
let root=env_get("PB_WINDOWS_EXAMPLE_ROOT");
let bridge=env_get("PBLANG_WINDOWS_ABI_BRIDGE");
assert(type(root)=="string" and root!="","supply the owned test directory");
let fs=W.open(root,false,bridge);assert(fs.ok,"open owned directory");
fn close_root() {return map{ok:W.close(fs),value:nil};}
let outcome=Resources.with_scope(fn(scope){
    scope.defer(close_root);
    let name=".pb-example-"+str_slice(sha256(base64_encode_bytes(random_bytes(16))),0,12);
    let bytes=str_to_bytes("PBLang publication example");
    assert(W.write_new_exclusive(fs,name,bytes,false).ok,"new owned file");
    let moved=W.move(fs,name,name+".ready",false);
    if not moved.ok {
        // A cleanup error can follow successful publication. Do not retry or
        // delete by assuming that ok:false means no effect happened.
        if try moved.published catch false {throw "published; cleanup requires inspection";}
        throw "publication failed";
    }
    assert(W.read_bytes(fs,name+".ready",len(bytes)).bytes==bytes,"exact readback");
    assert(W.remove_file(fs,name+".ready").ok,"remove owned demonstration file");
    return map{ok:true,value:"example complete"};
});
assert(outcome.ok,"body and automatic root cleanup must succeed");
print "windows_atomic_publication_example_pass";
