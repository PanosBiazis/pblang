// Reusable bounded ISA models share one PBLang validation contract.
let MOS = import("stdlib:emulator_6502.sapp");
let Z80 = import("stdlib:emulator_z80.sapp");
let AVR = import("stdlib:emulator_avr.sapp");
let MSP = import("stdlib:emulator_msp430.sapp");
let MIPS = import("stdlib:emulator_mips32.sapp");
let PPC = import("stdlib:emulator_powerpc32.sapp");
let SPARC = import("stdlib:emulator_sparc32.sapp");
let RV = import("stdlib:emulator_riscv64.sapp");
let WASM = import("stdlib:emulator_wasm.sapp");

let mos = MOS.run(MOS.program([
    MOS.load_a(0), MOS.load_x(5), MOS.clear_carry(), MOS.add_carry(3),
    MOS.decrement_x(), MOS.branch_not_equal(-5), MOS.break_instruction()
]));
let z80 = Z80.run(Z80.program([
    Z80.ld_a(0), Z80.ld_b(5), Z80.add_imm(3), Z80.dec_b(),
    Z80.jump_relative_nz(-5), Z80.halt()
]));
let avr = AVR.run(AVR.program([
    AVR.load_immediate(24, 0), AVR.load_immediate(18, 3),
    AVR.load_immediate(16, 5), AVR.add(24, 18), AVR.decrement(16),
    AVR.branch_not_equal(-3), AVR.halt()
]));
let msp = MSP.run(MSP.program([
    MSP.move_immediate(20, 4), MSP.add_immediate(22, 4),
    MSP.move_register(4, 15), MSP.halt()
]));
let mips = MIPS.run([
    MIPS.add_immediate_unsigned(2, 0, 4001),
    MIPS.add_immediate_unsigned(4, 0, 42), MIPS.syscall_instruction()
]);
let ppc = PPC.run(PPC.program([
    [PPC.add_immediate(3, 0, 42)], PPC.exit_sequence()
]));
let sparc = SPARC.run(SPARC.program([
    SPARC.move_immediate(42, SPARC.O0), SPARC.exit_sequence()
]));
let riscv = RV.run(RV.program([
    RV.add_immediate(17, 0, 93), RV.add_immediate(10, 0, 42),
    RV.environment_call()
]));
let wasm = WASM.run(WASM.program([
    WASM.i32_const(20), WASM.i32_const(22), WASM.add_i32(),
    WASM.return_instruction()
]));

if not mos.ok { throw mos.error; }
if not z80.ok { throw z80.error; }
if not avr.ok { throw avr.error; }
if not msp.ok { throw msp.error; }
if not mips.ok { throw mips.error; }
if not ppc.ok { throw ppc.error; }
if not sparc.ok { throw sparc.error; }
if not riscv.ok { throw riscv.error; }
if not wasm.ok { throw wasm.error; }
print map{ mos_6502: mos.value, z80: z80.value, avr: avr.value,
           msp430: msp.value, mips32: mips.value, powerpc32: ppc.value,
           sparc32: sparc.value,
           riscv64: riscv.value, wasm: wasm.value };
