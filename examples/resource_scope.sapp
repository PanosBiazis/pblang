let R=import("stdlib:resource_scope.sapp");
let DB=import("stdlib:db.sapp");
let outcome=R.with_scope(fn(scope){
    let connection=DB.sqlite.open(":memory:");
    let handle=connection.handle;
    scope.defer(fn(){sqlite_close(handle);return map{ok:true,value:nil};});
    let rows=connection.query("select 42 as answer",[]);
    return map{ok:true,value:rows};
});
if outcome.ok {print outcome.value;}
else {print outcome.body_status;print outcome.cleanup_ok;}
