let CAN=import("stdlib:linux_can.sapp");
let support=CAN.available();
print "backend="+support.platform+" available="+str(support.ok)+" classic_can="+str(support.classic_can);

let configured=try env_get("PB_CAN_INTERFACE") catch nil;
let interface=if type(configured)=="string"{configured}else{""};
if interface=="" {
    print "No socket opened. Set PB_CAN_INTERFACE=can0 to receive up to 20 frames for one second.";
} else {
    let socket=CAN.open_interface(interface);if not socket.ok{throw socket.error;}
    let result=CAN.read_frames(socket,20,1000);CAN.close(socket);
    if not result.ok{throw result.error;}
    print json_stringify(result);
}
