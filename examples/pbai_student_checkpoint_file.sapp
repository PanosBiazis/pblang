// Opt-in file example: caller supplies an existing private directory and phase.
let AI=import("stdlib/pbai.sapp");
let N=import("stdlib:pbai_neural_adapter.sapp");
let IO=import("stdlib:pbai_student_checkpoint_io.sapp");
let R=import("stdlib:resource_scope.sapp");
fn write_owned(specialist,storage,path){return fn(resources){
 let teacher=specialist.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
 let student=specialist.distill_supervised(teacher.artifact,[map{x:[0],y:5}],[map{x:[7,0],y:5}],
  map{epochs:64,lr:0.1,temperature:2,hard_weight:1,max_grad_norm:1});
 // Capture this returned handle directly before any export or save.
 let release=student.close;
 resources.defer(fn(){
  let closed=release();
  if type(closed)!="bool" {return map{ok:false,error:"invalid checkpoint close result"};}
  return map{ok:true,value:closed};
 });
 let checkpoint=try student.checkpoint() catch nil;
 if checkpoint==nil {return map{ok:false,error:"checkpoint export failed"};}
 let receipt=try storage.save_new(path,checkpoint) catch nil;
 if receipt==nil {return map{ok:false,error:"checkpoint could not be created exclusively in a private directory"};}
 assert(receipt.ok and receipt.no_replace and not receipt.globally_activated,"explicit exclusive save");
 return map{ok:true,value:nil};
};}
fn read_owned(storage,path){return fn(resources){
 let restored=storage.load_file(path);
 let release=restored.close;
 resources.defer(fn(){
  let closed=release();
  if type(closed)!="bool" {return map{ok:false,error:"invalid checkpoint close result"};}
  return map{ok:true,value:closed};
 });
 let predict_alias=restored.predict;let prediction=predict_alias([6,0]);
 let active_closed=release();let blocked=try {predict_alias([6,0]);false} catch true;
 assert(active_closed and not restored.close() and blocked,"release final read handle");
 assert(prediction.token==5,"restored synthetic learned prediction");
 return map{ok:true,value:map{token:prediction.token,active_closed:active_closed,active_prediction_blocked:blocked}};
};}
fn reload_owned(storage,path,directory){return fn(resources){
 let active=storage.load_file(path);
 let active_release=active.close;
 resources.defer(fn(){
  let closed=active_release();
  if type(closed)!="bool" {return map{ok:false,error:"invalid checkpoint close result"};}
  return map{ok:true,value:closed};
 });
 let before=active.checkpoint().digest;
 let replacement=try storage.load_file(path_join(directory,"candidate.json")) catch nil;
 let loaded=replacement!=nil;let retired_closed=false;
 if loaded {
  let retired_release=active_release;
  active=replacement;
  active_release=active.close;
  resources.defer(fn(){
   let closed=active_release();
   if type(closed)!="bool" {return map{ok:false,error:"invalid checkpoint close result"};}
   return map{ok:true,value:closed};
  });
  retired_closed=retired_release();
 } else {assert(active.checkpoint().digest==before,"failed reload preserves previous model");}
 let predict_alias=active.predict;let token=predict_alias([6,0]).token;
 let active_closed=active_release();let blocked=try {predict_alias([6,0]);false} catch true;
 assert(active_closed and not active.close() and blocked,"release final active reload handle");
 return map{ok:true,value:map{loaded:loaded,previous_retained:not loaded,retired_closed:retired_closed,token:token,active_closed:active_closed,active_prediction_blocked:blocked}};
};}
let specialist=AI.neural_specialist_bind(N);
let storage=AI.neural_specialist_checkpoint_bind(IO);
let directory=env_get("PBAI_CHECKPOINT_TEST_DIR");let phase=env_get("PBAI_CHECKPOINT_TEST_PHASE");
assert(type(directory)=="string" and directory!="","explicit private checkpoint directory required");
let path=path_join(directory,"student.json");
if phase=="write" {
 let result=R.with_scope(write_owned(specialist,storage,path));
 if result.original_error_available {throw result.error;}
 assert(result.body_status=="returned","checkpoint write workflow failed");
 assert(result.ok and result.cleanup_ok,"checkpoint write cleanup failed");
 print json_stringify(map{format:"pbai.checkpoint-file.example.v1",phase:phase,saved:true,globally_activated:false});
} elif phase=="read" {
 let result=R.with_scope(read_owned(storage,path));
 if result.original_error_available {throw result.error;}
 assert(result.body_status=="returned","checkpoint read workflow failed");
 assert(result.ok and result.cleanup_ok,"checkpoint read cleanup failed");
 let val=result.value;
 print json_stringify(map{format:"pbai.checkpoint-file.example.v1",phase:phase,token:val.token,active_closed:val.active_closed,
  active_prediction_blocked:val.active_prediction_blocked,globally_activated:false});
} elif phase=="reload" {
 let result=R.with_scope(reload_owned(storage,path,directory));
 if result.original_error_available {throw result.error;}
 assert(result.body_status=="returned","checkpoint reload workflow failed");
 assert(result.ok and result.cleanup_ok,"checkpoint reload cleanup failed");
 let val=result.value;
 print json_stringify(map{format:"pbai.checkpoint-file.example.v1",phase:phase,loaded:val.loaded,
  previous_retained:val.previous_retained,retired_closed:val.retired_closed,token:val.token,active_closed:val.active_closed,
  active_prediction_blocked:val.active_prediction_blocked,globally_activated:false});
} elif phase=="close" {
 let loaded=storage.load_file(path);let checkpoint=loaded.checkpoint();let before=loaded.predict([6,0]);
 let predict_alias=loaded.predict;let first=loaded.close();let repeated=loaded.close();
 let blocked=try {predict_alias([6,0]);false} catch true;
 let restored=specialist.student_load(checkpoint);let token=restored.predict([6,0]).token;
 assert(first and not repeated and blocked and token==before.token and restored.close(),"explicit loaded-handle lifetime");
 print json_stringify(map{format:"pbai.checkpoint-file.example.v1",phase:phase,first_close:first,
  repeated_close:repeated,retired_prediction_blocked:blocked,reloaded_token:token,globally_activated:false});
} elif str_starts_with(phase,"close-error-") {
 let loaded=storage.load_file(path);loaded.close();
 if phase=="close-error-predict" {loaded.predict("SYNTHETIC_CLOSED_PRIVATE_INPUT");}
 elif phase=="close-error-evaluate" {loaded.evaluate(nil);}
 elif phase=="close-error-checkpoint" {loaded.checkpoint();}
 throw "unexpected closed handle success";
} else {throw "select explicit write, read, reload or close phase";}
