let S=import("stdlib:snapshot_compare.sapp");
let a=str_repeat("a",64);let b=str_repeat("b",64);
fn entry(id,digest,size) {return map{id:id,digest:digest,size:size};}
fn manifest(entries) {return map{format:S.FORMAT,entries:entries};}
let before=manifest([entry("kept",a,10),entry("changed",a,20),entry("deleted",b,30),entry("conflict",a,40)]);
let after=manifest([entry("conflict",a,41),entry("added",b,50),entry("changed",b,20),entry("kept",a,10)]);
let saved=json_stringify(before);let report=S.compare(before,after);
assert(report.counts.unchanged==1 and report.counts.modified==1,"same size does not hide a different digest");
assert(report.counts.removed==1 and report.counts.added==1,"addition and removal remain separate; no rename inference");
assert(report.counts.inconsistent==1,"same digest with different declared sizes needs review");
assert(report.entries[0].id=="kept" and report.entries[4].id=="added","before order, then newly added entries");
assert(json_stringify(before)==saved and not report.merge_performed and not report.contents_verified,"comparison preserves sources and does not verify physical files");
print json_stringify(report);
