let Barcode = import("stdlib:barcode.sapp");
let App = import("examples/linear_barcode_studio/app.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn main() {
    let symbols = [
        Barcode.encode("PBLANG-128", "code128"),
        Barcode.encode("400638133393", "ean13"),
        Barcode.encode("03600029145", "upca")
    ];
    let reports = [];
    for symbol in symbols {
        if not symbol.ok { throw symbol.error; }
        let plan = Barcode.render_plan(symbol, 2, 72);
        array_push(reports, map{
            symbology: symbol.symbology, modules: symbol.module_count,
            bars: len(plan.bars), width: plan.width,
            svg_sha256: sha256(Barcode.to_svg(symbol, 2, 72))
        });
    }
    let ui = UI.compile(App.view(), map{ target: "native", width: 1280, height: 800 });
    let result = map{
        format: "pblang.example.linear-barcode-studio.v1",
        reports: reports, ui_records: len(ui.records),
        capabilities: Barcode.capabilities(), verified: len(reports) == 3
    };
    print json_stringify(result);
    return result.verified;
}

main();
