let UI = import("stdlib:modern_ui.sapp");

fn source_sha256() {
    return "3ee71c1f17cfd3ca4fc89f2c70b3d9b27f0aaff9b01027fc635a64c294dd42e6";
}

fn _select_action(name, description) {
    return UI.action_sequence([
        UI.action_set_text("active_format", name),
        UI.action_set_text("format_status", description)
    ]);
}

fn view() {
    return UI.screen([
        UI.heading("Linear Barcode Studio", map{
            name: "brand", accessibility_label: "Linear Barcode Studio"
        }),
        UI.text("Local, validated and dependency-free encoding", map{ name: "subtitle" }),
        UI.row([
            UI.button("Code 128B", _select_action("Code 128B", "Printable ASCII, 1 to 48 characters"), map{
                name: "select_code128", accessibility_label: "Select Code 128 Set B"
            }),
            UI.button("EAN-13", _select_action("EAN-13", "Twelve data digits plus a generated check digit"), map{
                name: "select_ean13", accessibility_label: "Select EAN-13"
            }),
            UI.button("UPC-A", _select_action("UPC-A", "Eleven data digits plus a generated check digit"), map{
                name: "select_upca", accessibility_label: "Select UPC-A"
            })
        ], map{ name: "format_picker", responsive: true, gap: 8 }),
        UI.heading("Code 128B", map{ name: "active_format" }),
        UI.text("Printable ASCII, 1 to 48 characters", map{
            name: "format_status", accessibility_label: "Selected barcode requirements"
        }),
        UI.grid([
            UI.card([UI.heading("Validate"), UI.text("Length, alphabet and check-digit rules")],
                map{ name: "validate_card" }),
            UI.card([UI.heading("Render"), UI.text("Portable bar plan, local SVG and bounded PNG")],
                map{ name: "render_card" }),
            UI.card([UI.heading("Scope"), UI.text("GS1-128 and FNC1 remain explicitly unavailable")],
                map{ name: "scope_card" })
        ], map{ name: "workflow_grid", columns: 3, gap: 12 })
    ], map{ name: "linear_barcode_root", gap: 16 });
}

fn web_options() {
    return map{
        theme: "light", lang: "en", host: "127.0.0.1", port: 8080,
        width: 1180, height: 800, source_sha256: source_sha256(),
        palette: map{
            accent: [0, 121, 107], selected: [0, 77, 64], focus: [0, 95, 204]
        }
    };
}

export source_sha256, view, web_options;
