let Barcode = import("stdlib:barcode.sapp");

let vectors = [
    map{ data: "PBLANG-CODE-128-BOUNDED-WORKLOAD-0123456789", format: "code128" },
    map{ data: "400638133393", format: "ean13" },
    map{ data: "03600029145", format: "upca" }
];
let encoded = 0;
let module_total = 0;
let i = 0;
while i < 192 {
    let vector = vectors[i % len(vectors)];
    let symbol = Barcode.encode(vector.data, vector.format);
    if not symbol.ok { throw "bounded barcode benchmark failed to encode"; }
    let plan = Barcode.render_plan(symbol, 2, 72);
    if not plan.ok or len(plan.bars) == 0 { throw "bounded barcode benchmark failed to render"; }
    encoded = encoded + 1;
    module_total = module_total + symbol.module_count;
    i = i + 1;
}

print json_stringify(map{
    format: "pblang.example.linear-barcode-benchmark.v1",
    encoded: encoded, module_total: module_total,
    verified: encoded == 192
});
