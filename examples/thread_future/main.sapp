let T = import("stdlib:thread.sapp");

let future = T.go(fn(){sleep_ms(20); return nil;});
let state = T.await_timeout(future, 1);
if not state.ok {
    print "Still running; retaining the future until completion.";
    T.await(future);
}
assert(T.is_ready(future), "nil is a completed result");
print "Completed, including when the value is nil.";
// thread keeps failure-as-nil compatibility. Use async.all_settled when the
// application must distinguish a task failure from a successful nil result.
