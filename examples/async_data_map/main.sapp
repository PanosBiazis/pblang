let A=import("stdlib:async.sapp");
let rows=[];
for i 128 {array_push(rows,map{id:i,values:[i,i+1,i+2]});}
// Automatic data transfer avoids a full input copy in every worker.
// The original rows remain owned by this VM; results keep input order.
let sums=A.map_parallel(rows,fn(row){
    let total=0;
    for value in row.values {total=total+value;}
    return map{id:row.id,total:total};
},4);
assert(sums[127].total==384,"ordered map result");
print sums[127];

// Independent batches reuse the parent API; no manual module cleanup is needed.
// Keep only the current batch's results when earlier batches are no longer needed.
for batch 3 {
    let values=A.map_parallel(rows,fn(row){return row.id;},4);
    assert(len(values)==128 and values[127]==127,"repeated batch");
}
