let S=import("stdlib:signal.sapp");
let source=S.new();
let doubled=S.map_signal(source,fn(v){return v*2;});
S.subscribe(doubled,fn(v){print v;});
S.emit(source,3); // prints 6
S.disconnect(doubled);
assert(S.count(source)==0,"upstream subscription released");
S.emit(source,4); // no forwarded event
S.emit(doubled,9); // local subscribers still receive 9
S.clear(doubled);
