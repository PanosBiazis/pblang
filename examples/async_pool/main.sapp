let A = import("stdlib:async.sapp");
let inputs = [];
for i 24 { array_push(inputs, i); }
// The default reuses at most eight workers, preserving input order.
let automatic = A.map_parallel(inputs, fn(x){ return x * x; });
// Explicit concurrency is useful for debugging or known workload budgets.
let serial = A.map_parallel(inputs, fn(x){ return x * x; }, 1);
assert(json_stringify(automatic) == json_stringify(serial), "same values");
print "completed " + str(len(automatic)) + " jobs";
