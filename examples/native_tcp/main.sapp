// Deadline-bound native TCP listener round trip without host-language source.
let TCP = import("stdlib:native_tcp.sapp");

let listener = TCP.listen_ipv4("127.0.0.1", 0, 8);
if not listener.ok { throw "native TCP listener failed: " + listener.error; }
let endpoint = "127.0.0.1:" + str(listener.port);
let completed = channel();
let worker = spawn(fn() {
    let peer = tcp_connect(endpoint);
    tcp_write(peer, "ping\n");
    let response = tcp_read_until(peer, "\n", 256);
    tcp_close(peer);
    send(completed.sender, response);
});

let socket = TCP.accept_bounded(listener, 250);
if not socket.ok { TCP.close(listener); throw "native TCP accept failed"; }
let received = TCP.read_until(socket, "\n", 256, 250);
if received.ok and received.text == "ping\n" {
    TCP.write_text(socket, "pong\n", 250);
}
TCP.close(socket);
let response = recv_timeout(completed.receiver, 2000);
join(worker); TCP.close(listener);
if response != "pong\n" { throw "native TCP round trip failed"; }
print json_stringify(map{ ok: true, format: TCP.FORMAT,
    response: str_trim(response), bounded: true, listener_closed: listener.closed });
