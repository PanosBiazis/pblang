// Retained source may print 9. The explicit PBLang-to-PBCK route prints 7.
// Preflight: pblang --check --via-pblang --retained-source examples/retained_nested_method.sapp
// See docs/PUBLIC_RETAINED_SOURCE_CHECK.md; this is an intentional regression fixture.
for _i 1 {
    let p = map{run: fn(self) { return 7; }};
    print (try { p:run() } catch 9);
}
