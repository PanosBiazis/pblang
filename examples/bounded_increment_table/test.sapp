let TABLE = import("examples/bounded_increment_table/table.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "bounded_increment_table test failed: " + message; }
}

fn rejected(callable) { return (try { callable(); false } catch true); }

let report = TABLE.build(5, "1.5", "0.25", 4);
require(str(report.values) == "[1.5, 1.75, 2, 2.25, 2.5]",
"positive decimal increment sequence must be exact");
require(report.initialized == 5 and report.unused_capacity == 0
and report.final_value == "2.5", "capacity accounting must include the initial value");
require(report.exact_decimal_arithmetic and report.all_elements_initialized
and not report.out_of_bounds_access, "memory and precision contract must be explicit");

let partial = TABLE.build(8, "10", "-1.5", 3);
require(str(partial.values) == "[10, 8.5, 7, 5.5]"
and partial.unused_capacity == 4, "negative increments and unused capacity must be supported");

let exact = TABLE.build(4, "0.1", "0.1", 3);
require(str(exact.values) == "[0.1, 0.2, 0.3, 0.4]",
"base-10 increments must avoid binary floating-point drift");
require(TABLE.build(1, "+7", "0", 0).final_value == "7",
"zero increments must retain one initialized value");

require(rejected(fn() { TABLE.build(0, "1", "1", 0); }),
"zero capacity must fail");
require(rejected(fn() { TABLE.build(3, "1", "1", 3); }),
"times exceeding capacity must fail before allocation");
require(rejected(fn() { TABLE.build(4097, "1", "1", 0); }),
"capacity must be bounded");
require(rejected(fn() { TABLE.build(2, "1e3", "1", 1); }),
"exponent notation must fail");
require(rejected(fn() { TABLE.build(2, ".5", "1", 1); }),
"decimal point requires a leading digit");
require(rejected(fn() { TABLE.build(2, "1", 0.1, 1); }),
"implicit floating-point inputs must fail");
require(rejected(fn() { TABLE.parse_count("-1", "times"); }),
"count parser must reject signs");

let hashes = TABLE.source_sha256();
require(len(hashes.program) == 64 and len(hashes.project) == 64
and len(hashes.build) == 64, "source provenance hashes must be complete");

for source_path in [
    "examples/bounded_increment_table/table.sapp",
    "examples/bounded_increment_table/main.sapp",
    "examples/bounded_increment_table/test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
    "bounded security analysis must pass for " + source_path);
}

print "bounded_increment_table_pass";
