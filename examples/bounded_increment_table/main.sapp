let OS = import("stdlib:os.sapp");
let TABLE = import("examples/bounded_increment_table/table.sapp");

fn usage() {
    print "Bounded increment table";
    print "  <capacity> <start-decimal> <increment-decimal> <times>";
}

fn main() {
    let arguments = OS.script_args();
    if len(arguments) != 4 { usage(); return false; }
    let report = try TABLE.build(
        TABLE.parse_count(arguments[0], "capacity"),
        arguments[1],
        arguments[2],
        TABLE.parse_count(arguments[3], "times")
    ) catch nil;
    if report == nil {
        print "Invalid table request";
        return false;
    }
    print json_stringify(report);
    return true;
}

main();
