// Memory-safe migration of the earlier variable-length C table exercise.

let MAX_CAPACITY = 4096;
let MAX_DECIMAL_TEXT = 1024;

fn source_sha256() {
    return map{
        program: "5febff9af9782ba49459c9b8bc14e6d2c3feb2541937d1c7934d53b1324338f1",
        project: "b587a05a5b3960fcf95b615fa372f128add1723dc01522fe7b277f43af867528",
        build: "f8c14cdfcc40a3838c4e021b9fa85cbcbdb56ba9e79f266925d7fc4a92d977fd"
    };
}

fn _whole(value, minimum, maximum, label) {
    if type(value) != "number" or value != num_floor(value)
       or value < minimum or value > maximum {
        throw label + " must be a whole " + str(minimum) + ".." + str(maximum);
    }
    return value;
}

fn _decimal(value, label) {
    if type(value) == "decimal" { return value; }
    if type(value) != "string" { throw label + " must be a decimal string"; }
    let text = str_trim(value);
    if text == "" or len(text) > MAX_DECIMAL_TEXT {
        throw label + " exceeds the accepted decimal shape";
    }
    let start = 0;
    if text[0..1] == "-" or text[0..1] == "+" { start = 1; }
    if start == len(text) { throw label + " must include digits"; }
    let dot = -1;
    let digits = 0;
    let i = start;
    while i < len(text) {
        let character = text[i..(i + 1)];
        if character == "." {
            if dot >= 0 { throw label + " must contain at most one decimal point"; }
            dot = i;
        } else if str_index_of("0123456789", character) >= 0 {
            digits = digits + 1;
        } else {
            throw label + " must use ASCII base-10 notation";
        }
        i = i + 1;
    }
    if digits == 0 or dot == start or dot == len(text) - 1 {
        throw label + " must include digits around its decimal point";
    }
    return decimal(text);
}

fn build(capacity_value, start_value, increment_value, times_value) {
    let capacity = _whole(capacity_value, 1, MAX_CAPACITY, "capacity");
    let times = _whole(times_value, 0, MAX_CAPACITY - 1, "times");
    if times + 1 > capacity {
        throw "times plus the initial value exceed table capacity";
    }
    let current = _decimal(start_value, "start");
    let increment = _decimal(increment_value, "increment");
    let values = [str(current)];
    let i = 0;
    while i < times {
        current = current + increment;
        array_push(values, str(current));
        i = i + 1;
    }
    return map{
        format: "pblang.example.increment-table.v1",
        capacity: capacity,
        initialized: len(values),
        unused_capacity: capacity - len(values),
        start: str(_decimal(start_value, "start")),
        increment: str(increment),
        times: times,
        values: values,
        final_value: values[len(values) - 1],
        exact_decimal_arithmetic: true,
        all_elements_initialized: true,
        out_of_bounds_access: false
    };
}

fn parse_count(text, label) {
    let value = str_trim(str(text));
    if value == "" or len(value) > 4 { throw label + " exceeds the accepted integer shape"; }
    let i = 0;
    while i < len(value) {
        if str_index_of("0123456789", value[i..(i + 1)]) < 0 {
            throw label + " must use ASCII base-10 digits";
        }
        i = i + 1;
    }
    return parse_number(value);
}

export source_sha256, build, parse_count;
