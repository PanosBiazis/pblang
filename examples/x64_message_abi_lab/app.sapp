let Workbench = import("./workbench.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");

fn model() { return Workbench.build(); }

fn view(data) {
    return UI.screen([
        UI.heading("x64 Message ABI Lab", map{
            name: "brand", accessibility_label: "x64 Message ABI Lab"
        }),
        UI.text("Generate real Linux and Windows artifacts without a foreign compiler", map{
            name: "subtitle"
        }),
        UI.row([
            UI.card([
                UI.heading("Linux ELF", map{ name: "linux_title" }),
                UI.text(str(data.artifacts.linux.artifact_bytes) + " bytes", map{ name: "linux_size" }),
                UI.text("Static syscalls, RX mapping", map{ name: "linux_policy" })
            ], map{ name: "linux_card" }),
            UI.card([
                UI.heading("Windows PE32+", map{ name: "windows_title" }),
                UI.text(str(data.artifacts.windows.artifact_bytes) + " bytes", map{ name: "windows_size" }),
                UI.text("IAT calls, NX and W/X split", map{ name: "windows_policy" })
            ], map{ name: "windows_card" })
        ], map{ name: "artifact_row", responsive: true, gap: 12 }),
        UI.grid([
            UI.card([
                UI.heading("ABI review", map{ name: "review_title" }),
                UI.text(str(data.diagnosed_sources) + " incompatible source variants diagnosed", map{
                    name: "review_status", accessibility_label: "ABI review status"
                })
            ], map{ name: "review_card" }),
            UI.card([
                UI.heading("Privacy", map{ name: "privacy_title" }),
                UI.text("Synthetic message only", map{ name: "privacy_state" }),
                UI.text("Provenance stored as SHA-256", map{ name: "provenance_state" })
            ], map{ name: "privacy_card" })
        ], map{ name: "quality_grid", columns: 2, gap: 12 }),
        UI.button("Review contracts", UI.action_set_text("review_status",
            "Linux valid; three historical variants require ABI repair"), map{
            name: "review_action", accessibility_label: "Review ABI contracts"
        }),
        UI.text("Windows artifact structure is verified here; live Windows execution remains a target-host gate.", map{
            name: "verification_boundary", accessibility_label: "Windows verification boundary"
        })
    ], map{ name: "x64_message_abi_root", gap: 16 });
}

fn visual_scene(data, width = 760, height = 480) {
    let scene = Visual.scene(width, height, map{ title: "Artifact sizes", backend: "portable" });
    Visual.add(scene, Visual.bar_chart("artifact_sizes", data.artifact_points, map{
        title: "Generated artifact bytes", x_label: "Target", y_label: "Bytes",
        color: [0, 116, 112, 255]
    }));
    return scene;
}

fn web_options() {
    return map{
        theme: "light", lang: "en", host: "127.0.0.1", port: 8080,
        width: 1180, height: 820,
        palette: map{
            accent: [0, 116, 112], selected: [188, 67, 36], focus: [0, 90, 156]
        }
    };
}

export model, view, visual_scene, web_options;
