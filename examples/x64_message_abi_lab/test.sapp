let Artifacts = import("stdlib:x64_message_artifact.sapp");
let Workbench = import("./workbench.sapp");
let App = import("./app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "x64 message ABI lab test failed: " + message; }
}

fn record(bundle, name) {
    let i = 0;
    while i < len(bundle.records) {
        if bundle.records[i].name == name { return bundle.records[i]; }
        i = i + 1;
    }
    return nil;
}

let data = Workbench.build();
require(data.ok and data.diagnosed_sources == 3 and len(data.reviews) == 4,
    "one valid source and three incompatible variants must be classified");
require(data.reviews[0].compatible and data.reviews[1].finding_count == 3
    and data.reviews[2].finding_count == 3 and data.reviews[3].finding_count == 2,
    "ABI findings must preserve the four migrated behavior profiles");
require(data.artifacts.linux.inspection.segment_rx
    and not data.artifacts.linux.inspection.writable_code,
    "Linux code segment must remain read-execute only");
require(data.artifacts.windows.wx_split and data.artifacts.windows.nx_compatible
    and data.artifacts.windows.shadow_space_bytes == 32,
    "Windows artifact must preserve W/X, NX and shadow-space evidence");
require(len(data.source_sha256) == 4 and not data.source_text_persisted
    and not data.personal_message_retained and not data.network_access,
    "migration provenance must remain content-addressed and privacy safe");
require(not data.foreign_compiler_used and not data.foreign_linker_used,
    "artifact generation must remain PBLang-only");

let tree = App.view(data);
require(UI.validate(tree).ok, "shared UI tree must validate");
for bundle in [
    UI.compile(tree, map{ target: "web", width: 320, height: 640 }),
    UI.compile(tree, map{ target: "native", width: 1440, height: 900 }),
    UI.compile(tree, map{ target: "android", width: 360, height: 720 })
] {
    require(record(bundle, "brand") != nil and record(bundle, "linux_card") != nil
        and record(bundle, "windows_card") != nil, "artifact cards must render on every target");
    require(record(bundle, "review_action") != nil and record(bundle, "verification_boundary") != nil,
        "action and verification boundary must render on every target");
}
let preview = UI.preview_web("x64 Message ABI Lab", tree, App.web_options());
require(preview.response.status == 200
    and str_contains(preview.generated.html, "viewport-fit=cover")
    and str_contains(preview.generated.css, "@media(max-width:640px)"),
    "Web preview must be responsive on compact screens");
require(not str_contains(preview.generated.html, "http://")
    and not str_contains(preview.generated.html, "https://"),
    "Web preview must not depend on remote assets");
let visual = Visual.compile(App.visual_scene(data, 720, 520));
require(len(visual.draw) == 1 and len(visual.assets) == 0,
    "artifact size chart must remain local and asset free");

let direct = Artifacts.build_pair("Direct contract\n");
require(direct.ok and direct.linux.artifact_bytes > 120 and direct.windows.artifact_bytes > 512,
    "public artifact API must build both targets");

for source_path in [
    "../../stdlib/x64_message_artifact.sapp", "workbench.sapp", "app.sapp",
    "main.sapp", "benchmark.sapp", "test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
        "bounded security analysis must pass for " + source_path);
}

print "x64_message_abi_lab_pass";
