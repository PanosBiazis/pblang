let Artifacts = import("stdlib:x64_message_artifact.sapp");

let FORMAT = "pblang.example.x64-message-abi-lab.v1";
let SOURCE_SHA256 = [
    "43e8b8cc7f502d2c1bf031c87bd60f75765585efe7d0daa79b2c3754941dd5b3",
    "aaaf6f2bd48d7dbd9684a0b777cef76f992f6971ca59bacea4e701c2c8736299",
    "a9e410414fcf2050776de830f61e2668853bfe01ac2e4fafe0d9fead69245660",
    "1d8d56d67c6c7f08716f8f68ff050b73e0118ac298de85ddcedde5e213d9c320"
];

fn _review(id, title, spec) {
    let result = Artifacts.review_abi(spec);
    return map{
        id: id, title: title, valid_input: result.ok,
        compatible: try result.compatible catch false,
        finding_count: try result.finding_count catch 0,
        findings: try result.findings catch []
    };
}

fn build(message = "Hello from PBLang\n") {
    let artifacts = Artifacts.build_pair(message);
    let reviews = [
        _review("linux-syscall", "Linux raw syscall source", map{
            platform: "linux-x86_64-syscall", calls: ["write", "exit"],
            argument_1_register: "rdi", shadow_space_bytes: 0, stack_aligned: true,
            direct_syscalls: true, external_calls: false
        }),
        _review("mixed-windows-a", "Mixed ABI Windows source A", map{
            platform: "windows-x86_64", calls: ["printf", "ExitProcess"],
            argument_1_register: "rdi", shadow_space_bytes: 0, stack_aligned: false,
            direct_syscalls: false, external_calls: true
        }),
        _review("mixed-windows-b", "Mixed ABI Windows source B", map{
            platform: "windows-x86_64", calls: ["printf", "ExitProcess"],
            argument_1_register: "rdi", shadow_space_bytes: 0, stack_aligned: false,
            direct_syscalls: false, external_calls: true
        }),
        _review("windows-frame", "Incomplete Windows call frame", map{
            platform: "windows-x86_64", calls: ["printf", "exit"],
            argument_1_register: "rcx", shadow_space_bytes: 0, stack_aligned: false,
            direct_syscalls: false, external_calls: true
        })
    ];
    let diagnosed = 0; let i = 0;
    while i < len(reviews) {
        if reviews[i].finding_count > 0 { diagnosed = diagnosed + 1; }
        i = i + 1;
    }
    return map{
        ok: artifacts.ok and reviews[0].compatible and diagnosed == 3,
        format: FORMAT, artifacts: artifacts, reviews: reviews,
        diagnosed_sources: diagnosed, source_sha256: SOURCE_SHA256,
        artifact_points: [
            ["Linux ELF", artifacts.linux.artifact_bytes],
            ["Windows PE", artifacts.windows.artifact_bytes]
        ],
        implementation_language: "pblang", foreign_compiler_used: false,
        foreign_linker_used: false, source_text_persisted: false,
        personal_message_retained: false, network_access: false,
        linux_live_execution_verified_elsewhere: true,
        windows_live_execution_verified: false
    };
}

export FORMAT, SOURCE_SHA256, build;
