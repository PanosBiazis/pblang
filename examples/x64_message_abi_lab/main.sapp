let App = import("./app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");

let data = App.model();
let tree = App.view(data);
let ui = UI.compile(tree, map{ target: "native", width: 1180, height: 820 });
let visual = Visual.compile(App.visual_scene(data));
print json_stringify(map{
    format: data.format, verified: data.ok,
    linux_bytes: data.artifacts.linux.artifact_bytes,
    windows_bytes: data.artifacts.windows.artifact_bytes,
    diagnosed_sources: data.diagnosed_sources,
    ui_records: len(ui.records), visual_nodes: len(visual.draw)
});
