let Artifacts = import("stdlib:x64_message_artifact.sapp");

let iterations = 64;
let linux_bytes = 0; let windows_bytes = 0; let i = 0;
while i < iterations {
    let pair = Artifacts.build_pair("bounded artifact " + str(i) + "\n");
    if not pair.ok { throw "x64 artifact benchmark failed"; }
    linux_bytes = linux_bytes + pair.linux.artifact_bytes;
    windows_bytes = windows_bytes + pair.windows.artifact_bytes;
    i = i + 1;
}
print json_stringify(map{
    format: "pblang.example.x64-message-benchmark.v1", iterations: iterations,
    artifacts_generated: iterations * 2, linux_bytes: linux_bytes,
    windows_bytes: windows_bytes, verified: true
});
