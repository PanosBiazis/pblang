let json=import("stdlib:json.sapp");
let raw="{\"id\":9007199254740991.0,\"ratio\":0.1}";
let value=json.parse(raw);
assert(value.id==parse_number("9007199254740991"),"boundary preserved");
let copy=json.parse(json.stringify(value));
assert(copy.id==value.id and copy.ratio==value.ratio,"binary64 roundtrip");
assert(json.parse_exact("0.5")==0.5,"exact binary fraction");
assert((try {json.parse_exact("0.1");false} catch true),"strict mode is explicit");
print json.stringify(value);
print "json_numbers_example_pass";
