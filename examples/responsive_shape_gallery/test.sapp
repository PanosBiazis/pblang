let Gallery = import("examples/responsive_shape_gallery/gallery.sapp");
let App = import("examples/responsive_shape_gallery/app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "responsive_shape_gallery test failed: " + message; }
}

fn rejected(callable) { return (try { callable(); false } catch true); }

fn record(bundle, name) {
    for item in bundle.records { if item.name == name { return item; } }
    return nil;
}

fn verify_layout(width, height, palette) {
    let report = Gallery.layout(width, height, 16, palette);
    require(len(report.items) == 5 and report.responsive and not report.clipped,
        "layout must retain all five responsive primitives");
    for item in report.items {
        require(item.bounds.min_x >= 0 and item.bounds.min_y >= 0
        and item.bounds.max_x <= width and item.bounds.max_y <= height,
        item.id + " must remain inside the viewport");
    }
    let plan = Visual.compile(App.visual_scene(report));
    require(len(plan.draw) == 7 and plan.viewport.w == width and plan.viewport.h == height,
        "scene must include canvas, five shapes and title at the requested size");
    return report;
}

let phone = verify_layout(240, 320, "vivid");
let desktop = verify_layout(1440, 900, "high-contrast");
let ultrawide = verify_layout(3840, 1080, "vivid");
require(phone.items[1].kind == "ellipse" and desktop.items[4].kind == "arc",
"ellipse and arc must remain first-class shapes across layouts");
require(ultrawide.items[0].width > desktop.items[0].width,
"shape geometry must respond to wider viewports");

require(rejected(fn() { Gallery.layout(239, 320); }), "undersized width must fail");
require(rejected(fn() { Gallery.layout(240, 319); }), "undersized height must fail");
require(rejected(fn() { Gallery.layout(960, 600, 0); }), "unsafe padding must fail");
require(rejected(fn() { Gallery.layout(960, 600, 24, "missing"); }),
"unknown palettes must fail");

let view = App.view();
require(UI.validate(view).ok, "shared UI tree must validate");
let web_ui = UI.compile(view, map{ target: "web", width: 320, height: 640 });
let native_ui = UI.compile(view, map{ target: "native", width: 1440, height: 900 });
let android_ui = UI.compile(view, map{ target: "android", width: 360, height: 720 });
for bundle in [web_ui, native_ui, android_ui] {
    require(record(bundle, "brand") != nil, "brand must render on every target");
    require(record(bundle, "palette_vivid") != nil, "vivid palette control must render");
    require(record(bundle, "palette_high-contrast") != nil,
        "high-contrast palette control must render");
    require(record(bundle, "gallery_status") != nil, "accessible status must render");
}

let preview = UI.preview_web("Responsive Shape Gallery", view, App.web_options());
require(preview.response.status == 200, "generated Web preview must return HTTP 200");
require(str_contains(preview.generated.html, "viewport-fit=cover"),
"Web preview must support compact viewports");
require(str_contains(preview.generated.css, "@media(max-width:640px)"),
"Web preview must include responsive rules");
require(not str_contains(preview.generated.html, "http://")
and not str_contains(preview.generated.html, "https://"),
"Web preview must have no remote runtime dependency");

require(Gallery.source_sha256() ==
"c3d3756e9b06ce1c75031a04650628113f27aef0b856d9d72b341a8991cd42ab",
"source provenance digest must remain stable");

for source_path in [
    "stdlib/visual_engine.sapp",
    "examples/responsive_shape_gallery/gallery.sapp",
    "examples/responsive_shape_gallery/app.sapp",
    "examples/responsive_shape_gallery/main.sapp",
    "examples/responsive_shape_gallery/test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
    "bounded security analysis must pass for " + source_path);
}

print "responsive_shape_gallery_pass";
