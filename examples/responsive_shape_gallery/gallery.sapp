// Responsive geometry model for five vector primitives.

let PI = 3.141592653589793;

fn source_sha256() {
    return "c3d3756e9b06ce1c75031a04650628113f27aef0b856d9d72b341a8991cd42ab";
}

fn _dimension(value, minimum, maximum, label) {
    if type(value) != "number" or value != num_floor(value)
       or value < minimum or value > maximum {
        throw label + " must be a whole number in " + str(minimum) + ".." + str(maximum);
    }
    return value;
}

fn _bounds(min_x, min_y, max_x, max_y) {
    return map{ min_x: min_x, min_y: min_y, max_x: max_x, max_y: max_y };
}

fn palettes() {
    return [
        map{
            id: "vivid", title: "Vivid",
            colors: map{
                rectangle: [230, 73, 83, 255], ellipse: [45, 117, 220, 255],
                line: [0, 142, 105, 255], triangle: [245, 190, 54, 255],
                arc: [137, 89, 201, 255]
            }
        },
        map{
            id: "high-contrast", title: "High contrast",
            colors: map{
                rectangle: [213, 94, 0, 255], ellipse: [0, 114, 178, 255],
                line: [0, 0, 0, 255], triangle: [240, 228, 66, 255],
                arc: [204, 121, 167, 255]
            }
        }
    ];
}

fn _palette(palette_id) {
    for palette in palettes() {
        if palette.id == palette_id { return palette; }
    }
    throw "unknown palette: " + str(palette_id);
}

fn layout(width = 960, height = 600, padding = 24, palette_id = "vivid") {
    let w = _dimension(width, 240, 4096, "width");
    let h = _dimension(height, 320, 4096, "height");
    let pad = _dimension(padding, 8, 128, "padding");
    if pad * 2 >= w or pad * 2 >= h { throw "padding leaves no drawable viewport"; }
    let palette = _palette(palette_id);
    let usable_w = w - 2 * pad;
    let usable_h = h - 2 * pad;
    let left = pad;
    let top = pad;

    let rect_x = left + 0.04 * usable_w;
    let rect_y = top + 0.08 * usable_h;
    let rect_w = 0.25 * usable_w;
    let rect_h = 0.20 * usable_h;

    let ellipse_x = left + 0.72 * usable_w;
    let ellipse_y = top + 0.18 * usable_h;
    let ellipse_rx = 0.14 * usable_w;
    let ellipse_ry = 0.10 * usable_h;

    let line_x1 = left + 0.08 * usable_w;
    let line_y1 = top + 0.48 * usable_h;
    let line_x2 = left + 0.34 * usable_w;
    let line_y2 = top + 0.72 * usable_h;

    let triangle = [
        [left + 0.60 * usable_w, top + 0.48 * usable_h],
        [left + 0.78 * usable_w, top + 0.76 * usable_h],
        [left + 0.94 * usable_w, top + 0.48 * usable_h]
    ];

    let arc_x = left + 0.25 * usable_w;
    let arc_y = top + 0.88 * usable_h;
    let arc_rx = 0.16 * usable_w;
    let arc_ry = 0.08 * usable_h;

    return map{
        format: "pblang.example.responsive-shape-layout.v1",
        viewport: map{ width: w, height: h, padding: pad },
        palette: palette,
        responsive: true,
        clipped: false,
        items: [
            map{
                id: "rectangle", kind: "rectangle", x: rect_x, y: rect_y,
                width: rect_w, height: rect_h, color: palette.colors.rectangle,
                bounds: _bounds(rect_x, rect_y, rect_x + rect_w, rect_y + rect_h)
            },
            map{
                id: "ellipse", kind: "ellipse", x: ellipse_x, y: ellipse_y,
                radius_x: ellipse_rx, radius_y: ellipse_ry, color: palette.colors.ellipse,
                bounds: _bounds(ellipse_x - ellipse_rx, ellipse_y - ellipse_ry,
                    ellipse_x + ellipse_rx, ellipse_y + ellipse_ry)
            },
            map{
                id: "line", kind: "line", x1: line_x1, y1: line_y1,
                x2: line_x2, y2: line_y2, width: 5, color: palette.colors.line,
                bounds: _bounds(line_x1, line_y1, line_x2, line_y2)
            },
            map{
                id: "triangle", kind: "triangle", points: triangle,
                color: palette.colors.triangle,
                bounds: _bounds(triangle[0][0], triangle[0][1],
                    triangle[2][0], triangle[1][1])
            },
            map{
                id: "arc", kind: "arc", x: arc_x, y: arc_y,
                radius_x: arc_rx, radius_y: arc_ry,
                start_radians: PI, end_radians: 2 * PI,
                width: 5, color: palette.colors.arc,
                bounds: _bounds(arc_x - arc_rx, arc_y - arc_ry,
                    arc_x + arc_rx, arc_y + arc_ry)
            }
        ]
    };
}

fn summary(report) {
    return map{
        format: report.format,
        viewport: report.viewport,
        palette: report.palette.id,
        item_count: len(report.items),
        responsive: report.responsive,
        clipped: report.clipped
    };
}

export source_sha256, palettes, layout, summary;
