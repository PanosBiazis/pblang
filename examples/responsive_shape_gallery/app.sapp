let Gallery = import("examples/responsive_shape_gallery/gallery.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Visual = import("stdlib:visual_engine.sapp");

fn _palette_action(palette) {
    return UI.action_sequence([
        UI.action_set_text("active_palette", palette.title),
        UI.action_set_text("gallery_status", palette.title + " palette selected")
    ]);
}

fn view() {
    let controls = [];
    for palette in Gallery.palettes() {
        array_push(controls, UI.button(palette.title, _palette_action(palette), map{
            name: "palette_" + palette.id,
            accessibility_label: "Select " + palette.title + " shape palette"
        }));
    }
    return UI.screen([
        UI.heading("Shape Gallery", map{
            name: "brand", accessibility_label: "Responsive Shape Gallery"
        }),
        UI.text("Five portable vector primitives", map{ name: "subtitle" }),
        UI.row(controls, map{ name: "palette_picker", responsive: true, gap: 8 }),
        UI.heading("Vivid", map{ name: "active_palette" }),
        UI.text("Vivid palette selected", map{
            name: "gallery_status", accessibility_label: "Gallery palette status"
        }),
        UI.grid([
            UI.card([UI.heading("Responsive"), UI.text("Geometry follows the viewport")],
                map{ name: "responsive_card" }),
            UI.card([UI.heading("Portable"), UI.text("One scene contract across targets")],
                map{ name: "portable_card" }),
            UI.card([UI.heading("Bounded"), UI.text("Exactly five validated primitives")],
                map{ name: "bounded_card" })
        ], map{ name: "quality_grid", columns: 3, gap: 12 })
    ], map{ name: "shape_gallery_root", gap: 16 });
}

fn visual_scene(report) {
    let width = report.viewport.width;
    let height = report.viewport.height;
    let scene = Visual.scene(width, height, map{
        title: "Responsive Shape Gallery",
        backend: "portable",
        bg: [247, 249, 252, 255]
    });
    Visual.add(scene, Visual.rect("canvas", 0, 0, width, height, [247, 249, 252, 255]));
    for item in report.items {
        if item.kind == "rectangle" {
            Visual.add(scene, Visual.rect(item.id, item.x, item.y,
                item.width, item.height, item.color));
        } else if item.kind == "ellipse" {
            Visual.add(scene, Visual.ellipse2d(item.id, item.x, item.y,
                item.radius_x, item.radius_y, item.color, true));
        } else if item.kind == "line" {
            Visual.add(scene, Visual.line2d(item.id, item.x1, item.y1,
                item.x2, item.y2, item.color, item.width));
        } else if item.kind == "triangle" {
            Visual.add(scene, Visual.polygon2d(item.id, item.points, item.color, true));
        } else if item.kind == "arc" {
            Visual.add(scene, Visual.arc2d(item.id, item.x, item.y,
                item.radius_x, item.radius_y, item.start_radians,
                item.end_radians, item.color, item.width));
        } else {
            throw "unsupported gallery shape: " + str(item.kind);
        }
    }
    Visual.add(scene, Visual.text("scene_title", report.viewport.padding,
        report.viewport.padding, "Colorful Shapes", [20, 28, 40, 255], 22));
    return scene;
}

fn compiled_visual(report) { return Visual.compile(visual_scene(report)); }

fn web_options() {
    return map{
        theme: "light", lang: "en", host: "127.0.0.1", port: 8080,
        width: 1180, height: 820,
        palette: map{
            accent: [0, 114, 178], selected: [213, 94, 0], focus: [137, 89, 201]
        },
        source_sha256: Gallery.source_sha256()
    };
}

export view, visual_scene, compiled_visual, web_options;
