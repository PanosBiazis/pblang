let Gallery = import("examples/responsive_shape_gallery/gallery.sapp");
let App = import("examples/responsive_shape_gallery/app.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn main() {
    let report = Gallery.layout();
    let plan = App.compiled_visual(report);
    let ui = UI.compile(App.view(), map{ target: "native", width: 1280, height: 800 });
    let result = map{
        format: "pblang.example.responsive-shape-gallery.v1",
        gallery: Gallery.summary(report),
        visual_nodes: len(plan.draw),
        ui_records: len(ui.records),
        verified: len(report.items) == 5 and len(plan.draw) == 7
    };
    print json_stringify(result);
    return result.verified;
}

main();
