let store = import("stdlib:data_store.sapp");

// One-line construction of a bounded, namespaced, LRU memory store.
let session = store.open(map{ backend: "memory", namespace: "demo", max_entries: 128, max_units: 1048576 });
store.set(session, "user", map{ name: "Ada", roles: ["developer"] }, map{ ttl_ms: 60000 });
print "memory_user=" + store.get(session, "user").name + " size=" + str(store.stats(session).size);
store.close(session);

// The same operations on a disk-backed SQLite store. Values remain structured
// and the namespace can be cleared without touching another product's records.
let path = "target/data_store_example.db";
try fs_remove(path) catch nil;
let durable = store.open(map{ backend: "sqlite", path: path, namespace: "notes", max_entries: 1000, max_units: 16777216 });
store.set(durable, "welcome", map{ title: "PBLang", body: "one API, multiple backends" });
store.close(durable);

let reopened = store.sqlite(path, map{ namespace: "notes", max_entries: 1000, max_units: 16777216 });
print "sqlite_note=" + store.get(reopened, "welcome").title + " size=" + str(store.stats(reopened).size);
store.clear(reopened);
store.close(reopened);
try fs_remove(path) catch nil;
try fs_remove(path + "-wal") catch nil;
try fs_remove(path + "-shm") catch nil;
