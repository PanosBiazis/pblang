// The caller keeps ownership after a timeout and explicitly settles all work.
let A = import("stdlib:async.sapp");
let slow = A.go(fn() { sleep_ms(100); return "completed later"; });
let first = A.await_timeout(slow, 5);
if not first.ready { print "Waiting ended; task still has an owner."; }
let results = A.all_settled([slow]);
assert(results[0].ok and results[0].value == "completed later", "task settled");
assert(A.await(slow) == "completed later", "result can be reused");
print "async_lifecycle_example_pass";

// timeout now returns ownership explicitly; it no longer returns a bare value.
let timed = A.timeout(5, fn(){ sleep_ms(40); return 42; });
if not timed.ready { print "Deadline expired; retaining the future."; }
assert(A.await(timed.future) == 42, "timeout worker settled");
