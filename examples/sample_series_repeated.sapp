// Complete trailing means preserve cancellation residuals and repeated samples.
let Series=import("stdlib:sample_series.sapp");
let samples=[1000000000,0.000000001,-1000000000,1000000000,0.000000001,-1000000000];
let means=Series.moving_mean(samples,3);
assert(len(means.values)==4,"one result per complete window");
for value in means.values {assert(value==0.000000001/3,"small residual preserved");}
print "Repeated samples: four complete means, with the small residual retained.";
