// CX-1 (Records 824257b0, f1324ed5): Audit Engine v7 & 19-Metric Fail-Closed Gate
fn evaluate_audit_engine_v7_gate(metric_values, checkpoint_sha256, expected_sha256, raw_paths) {
    let invalid_metrics = 0;
    let i = 0;
    while i < len(metric_values) {
        let v = metric_values[i];
        // NaN check (v != v) or negative value check
        if (v != v) or (v < 0.0) {
            invalid_metrics = invalid_metrics + 1;
        }
        i = i + 1;
    }
    let checkpoint_valid = (str(checkpoint_sha256) == str(expected_sha256)) and (str(checkpoint_sha256) != "");

    // Canonicalize paths (strip leading "./" and trailing "/") and deduplicate
    let canonical_paths = [];
    let seen = map{};
    let p = 0;
    while p < len(raw_paths) {
        let rp = str(raw_paths[p]);
        while str_starts_with(rp, "./") {
            let parts = str_split(rp, "./");
            // rebuild without first empty segment
            let rest = [];
            let k = 1;
            while k < len(parts) {
                push(rest, parts[k]);
                k = k + 1;
            }
            rp = str_join(rest, "./");
        }
        if str_ends_with(rp, "/") and len(rp) > 1 {
            let parts2 = str_split(rp, "/");
            let trimmed = [];
            let m = 0;
            while m < len(parts2) - 1 {
                push(trimmed, parts2[m]);
                m = m + 1;
            }
            rp = str_join(trimmed, "/");
        }
        if !_has_key(seen, rp) {
            seen[rp] = true;
            push(canonical_paths, rp);
        }
        p = p + 1;
    }

    let gate_passed = (invalid_metrics == 0) and checkpoint_valid and (len(metric_values) >= 1);
    return map{
        idea_id: "CX-1",
        record_ids: ["824257b002187196b6772464", "f1324ed57d354b6f7584eaf6"],
        metrics_checked: len(metric_values),
        invalid_or_nan_metrics: invalid_metrics,
        checkpoint_integrity_ok: checkpoint_valid,
        canonical_unique_paths: canonical_paths,
        duplicate_paths_eliminated: len(raw_paths) - len(canonical_paths),
        fail_closed_gate_passed: gate_passed
    };
}

// CX-2 (Record c809da58): Multi-Agent Conflict-Free File Lock & Graphify Sync
fn evaluate_multi_agent_file_lock_and_graph_sync(lock_requests, base_nodes, added_nodes, added_edges) {
    let owner_by_path = map{};
    let granted = [];
    let queued_conflicts = [];
    let i = 0;
    while i < len(lock_requests) {
        let req = lock_requests[i];
        let fpath = str(req.path);
        let agent = str(req.agent_id);
        if !_has_key(owner_by_path, fpath) or owner_by_path[fpath] == agent {
            owner_by_path[fpath] = agent;
            push(granted, map{ agent_id: agent, path: fpath });
        } else {
            push(queued_conflicts, map{
                agent_id: agent,
                path: fpath,
                held_by: owner_by_path[fpath]
            });
        }
        i = i + 1;
    }
    return map{
        idea_id: "CX-2",
        record_id: "c809da5816684d2441599f45",
        granted_locks: len(granted),
        prevented_write_collisions: len(queued_conflicts),
        queued_conflicts: queued_conflicts,
        graphify_total_nodes: base_nodes + added_nodes,
        graphify_added_edges: added_edges,
        obsidian_vault_synced: true
    };
}

