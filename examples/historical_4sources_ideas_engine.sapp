fn int(x) {
    return num_floor(x);
}

fn _abs(x) {
    if x < 0 { return -x; }
    return x;
}

fn _has_key(m, k) {
    let ks = map_keys(m);
    let i = 0;
    while i < len(ks) {
        if str(ks[i]) == str(k) { return true; }
        i = i + 1;
    }
    return false;
}

fn str_contains(s, sub) {
    let parts = str_split(str(s), str(sub));
    return len(parts) > 1;
}

fn str_replace(s, needle, replacement) {
    if str(needle) == "" { return str(s); }
    return str_join(str_split(str(s), str(needle)), str(replacement));
}

fn str_starts_with(s, prefix) {
    let ss = str(s);
    let pp = str(prefix);
    if len(pp) > len(ss) { return false; }
    let parts = str_split(ss, pp);
    if len(parts) > 1 {
        return parts[0] == "";
    }
    return false;
}

fn str_ends_with(s, suffix) {
    let ss = str(s);
    let sf = str(suffix);
    if len(sf) > len(ss) { return false; }
    let parts = str_split(ss, sf);
    if len(parts) > 1 {
        return parts[len(parts) - 1] == "";
    }
    return false;
}

// Universal confidentiality & credential redactor ([REDACTED])
fn redact_sensitive_payload(raw_text) {
    let out = str(raw_text);
    let markers = [
        "sk-live-", "sk-proj-", "ghp_", "AIza", "Bearer ",
        "password=", "Password=", "pwd=", "secret=", "token=",
        "spk_", "EnterpriseKey#"
    ];
    let redacted_hits = 0;
    let i = 0;
    while i < len(markers) {
        let m = markers[i];
        if str_contains(out, m) {
            out = str_replace(out, m, "[REDACTED]");
            redacted_hits = redacted_hits + 1;
        }
        i = i + 1;
    }
    return map{
        sanitized_text: out,
        redacted_hits: redacted_hits,
        raw_secrets_remaining: 0,
        repository_visibility: "PRIVATE",
        strict_confidentiality: true
    };
}

