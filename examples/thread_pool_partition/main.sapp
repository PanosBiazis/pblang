let P=import("stdlib:thread_pool.sapp");
// Six elements, four workers: no overlapping fractional slices.
print P.parallel_map([0,1,2,3,4,5],fn(x){return x*x;},4);
// Repeated calls reuse the minimal future backend in this VM.
assert(P.parallel_map([2,3],fn(x){return x*x;},2)==[4,9],"reused backend");
let pool=P.new();
for i 5 {P.submit(pool,fn(){return 7;});}
print P.auto_size(pool); // 3, a valid integer worker count
print P.run_parallel(pool);
P.shutdown(pool);
