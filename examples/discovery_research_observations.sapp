// Entirely synthetic educational datasets; no acquisition or scientific inference.
let R=import("stdlib:research_observations.sapp");
let Recipes=import("stdlib:recipe_manifest.sapp");
let growth=R.summarize(map{value_unit:"cm",summary_unit:"m",value_mode:"absolute",time_unit:"day",timebase:"relative"},
    [map{subject:1,time:0,value:10},map{subject:2,time:0,value:20},map{subject:1,time:1,value:nil},map{subject:2,time:1,value:30}]);
let environment=R.summarize(map{value_unit:"degF",summary_unit:"degC",value_mode:"absolute",time_unit:"min",timebase:"relative"},
    [map{subject:1,time:0,value:68},map{subject:1,time:1,value:77},map{subject:1,time:2,value:nil}]);
assert(num_abs(growth.mean-0.2)<0.000000000001 and environment.mean==22.5,"synthetic unit conversions");
let recipe=map{format:Recipes.FORMAT,recipes:[map{id:"research_missingness",platforms:["linux"],requires:["units","research_observations"],
    inputs:map{synthetic:true},expected:map{rows:4,observed:3,missing:1,subjects:2}}]};
let assessment=Recipes.assess(recipe,"linux",["units","research_observations"],
    [map{id:"research_missingness",actual:map{rows:growth.row_count,observed:growth.observed_count,missing:growth.missing_count,subjects:growth.subject_count}}]);
assert(assessment.counts.matched==1 and not assessment.execution_verified,"declared recipe assessment");
print json_stringify(map{synthetic:true,plant_measurement_review:growth,environment_review:environment,recipe:recipe,assessment:assessment});
