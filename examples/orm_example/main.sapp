// ORM Example — demonstrating ActiveRecord-style database operations
let orm = import("stdlib:orm.sapp");

// Connect to SQLite
let db = orm.connect("example.db");

// Define the schema
orm.define_model(db, "User", [
    "id INTEGER PRIMARY KEY AUTOINCREMENT",
    "name TEXT NOT NULL",
    "email TEXT UNIQUE NOT NULL",
    "created_at INTEGER DEFAULT 0"
]);

// Insert records
let id1 = orm.insert(db, "User", map{
    name: "Alice",
    email: "alice@example.com",
    created_at: now_ms()
});

let id2 = orm.insert(db, "User", map{
    name: "Bob",
    email: "bob@example.com",
    created_at: now_ms()
});

print "Inserted users with ids: " + str(id1) + ", " + str(id2);

// Find by ID
let alice = orm.find_by_id(db, "User", id1);
print "Found: " + alice.name + " (" + alice.email + ")";

// Find with WHERE clause
let all_users = orm.find_all(db, "User");
print "Total users: " + str(len(all_users));

// Update
orm.update(db, "User", id1, map{ name: "Alice Smith" });
let updated = orm.find_by_id(db, "User", id1);
print "Updated name: " + updated.name;

// Paginate
let page = orm.paginate(db, "User", 1, 10);
print "Page 1: " + str(len(page.rows)) + " users, total: " + str(page.total);

// Cleanup
orm.raw_exec(db, "DROP TABLE User", nil);
print "Done!";
