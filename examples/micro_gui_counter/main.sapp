// examples/micro_gui_counter/main.sapp
// Small GUI project built on stdlib/micro_gui.sapp.
//
// It prints a compact render plan instead of opening a native window. That keeps the
// example fast and deterministic while the GUI foundation stays renderer-agnostic.

let UI = import("stdlib/micro_gui.sapp");

fn main() {
    let app = UI.app("Counter", 320, 220);
    UI.add(app, UI.label("title", "Counter demo"));
    UI.add(app, UI.field("name", "", "name"));
    UI.add(app, UI.checkbox("live", "Live preview", true));
    UI.add(app, UI.progress("load", 0.25));
    UI.add(app, UI.button("inc", "Increment"));
    UI.layout_column(app, 12, 12, 190, 6, 6, 8, 4);

    let p0 = UI.plan(app, 6, 8, 4);
    print "commands=" + str(p0.command_count) + " hits=" + str(p0.hit_count);

    UI.handle_click(app, 20, 40);
    UI.handle_key(app, "A");
    UI.handle_key(app, "d");
    UI.handle_key(app, "a");
    UI.handle_click(app, 20, 70);
    let action = UI.handle_click(app, 20, 100);

    let p1 = UI.plan(app, 6, 8, 4);
    print "name=" + app.widgets[1].value;
    print "live=" + str(app.widgets[2].checked);
    print "action=" + str(try action.id catch "none");
    print "changed=" + str(p0.signature != p1.signature);
}

main();
