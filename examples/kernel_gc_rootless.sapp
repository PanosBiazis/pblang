// pblang:target=kernel
// pblang:extern heap_init heap_alloc heap_free gc_new gc_set_auto gc_set_threshold gc_alloc gc_add_root gc_remove_root gc_set_child gc_live gc_collections kernel_gc_collect
// QEMU-only fixture. Explicit metadata writes exercise generation wrap and
// valid ownership-table permutations, not application-facing operations.
fn verify(ok) { if not ok { outb(244,1);while 1>0 {hlt();} } }
fn free_bytes(h) {
    let total=0;let block=peek32(h);
    while block!=0 {total=total+peek32(block);block=peek32(block+4);}
    return total;
}
fn kmain() {
    let h=kmalloc(8);let region=kmalloc(65536);heap_init(h,region,65536);
    let g=gc_new(h);verify(g!=0);gc_set_auto(g,0);
    let foreign=heap_alloc(h,32);verify(foreign!=0);poke32(foreign,1234567);
    let bytes=free_bytes(h);let epoch=0;
    while epoch<4 {
        let first=0;let previous=0;let i=0;
        while i<128 {
            let obj=gc_alloc(g,1);verify(obj!=0);
            if i==0 {first=obj;} else {verify(gc_set_child(previous,0,obj)==1);}
            previous=obj;i=i+1;
        }
        verify(gc_set_child(previous,0,first)==1);
        verify(gc_add_root(g,first)==1 and gc_add_root(g,first)==1);
        verify(kernel_gc_collect(g)==0 and gc_live(g)==128);
        verify(gc_remove_root(g,first)==2);
        // Reverse the table to exercise descending free-list cursor fallback.
        if epoch==1 {
            let table=peek32(g+20);i=0;
            while i<64 {
                let a=peek32(table+i*4);let other=127-i;
                poke32(table+i*4,peek32(table+other*4));poke32(table+other*4,a);i=i+1;
            }
        }
        if epoch==2 {poke32(g+44,2147483647);}
        let generation=peek32(g+44);let before=gc_collections(g);
        verify(kernel_gc_collect(g)==0 and gc_live(g)==0);
        verify(gc_collections(g)==before+1 and peek32(g+12)==0);
        if generation==2147483647 {verify(peek32(g+44)==1);}
        else {verify(peek32(g+44)==generation+1);}
        verify(free_bytes(h)==bytes and peek32(foreign)==1234567);
        epoch=epoch+1;
    }
    // Empty wrap; later roots must still survive and new objects start unmarked.
    poke32(g+44,2147483647);verify(kernel_gc_collect(g)==0 and peek32(g+44)==1);
    let kept=gc_alloc(g,0);verify(kept!=0 and peek32(kept)==0);
    verify(gc_add_root(g,kept)==1 and kernel_gc_collect(g)==0 and gc_live(g)==1);
    verify(gc_remove_root(g,kept)==1);
    // Automatic rootless collection runs before the new allocation is published.
    gc_set_auto(g,1);gc_set_threshold(g,1);
    let garbage=gc_alloc(g,0);verify(garbage!=0);
    let before=gc_collections(g);let next=gc_alloc(g,0);verify(next!=0);
    verify(gc_collections(g)==before+1 and gc_live(g)==1 and peek32(next)==0);
    verify(kernel_gc_collect(g)==0 and gc_live(g)==0);
    verify(free_bytes(h)==bytes and peek32(foreign)==1234567);
    heap_free(h,foreign);outb(244,42);while 1>0 {hlt();}
}
