let Route=import("stdlib:route_lesson.sapp");
let graph=map{nodes:["Start","Via","End","Isolated"],edges:[
    map{from:"Start",to:"End",cost:9},map{from:"Start",to:"Via",cost:2},map{from:"Via",to:"End",cost:3}]};
let lesson=Route.diagram(graph,"Start","End");
assert(lesson.report.path==["Start","Via","End"] and lesson.report.cost==5,"cheaper indirect route");
assert(not lesson.report.nodes[3].reachable,"isolated node remains visible");
print json_stringify(lesson);
