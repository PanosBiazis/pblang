// Offline PBLang-only workbench. No deployment, listener, account or credentials.
let Ops=import("stdlib:devops_pipeline.sapp");
let Proxy=import("stdlib:proxy_config.sapp");
let API=import("stdlib:ops_services.sapp");
let config=Proxy.create(8080,[map{id:"app_a",port:8081},map{id:"app_b",port:8082}]);
let artifacts=map{};
let jobs=[map{id:"validate",needs:[]},map{id:"render",needs:["validate"]},map{id:"check",needs:["render"]}];
let result=Ops.run(jobs,fn(id){
    if id=="validate" { return map{ok:Proxy.validate(config)}; }
    if id=="render" { artifacts.nginx=Proxy.nginx(config); artifacts.haproxy=Proxy.haproxy(config); return map{ok:true}; }
    return map{ok:str_contains(artifacts.nginx,"127.0.0.1:8080") and str_contains(artifacts.haproxy,"127.0.0.1:8080")};
},true);
let decision=Proxy.select(config,[false,true]);
// This callback is deliberately synthetic, NOT an authenticated service adapter.
let response=API.fetch("ngrok",nil,fn(request){return map{status:200,body:"{\"endpoints\":[]}"};},true);
assert(result.ok and decision.upstream.id=="app_b" and response.ok,"offline composition works");
print json_stringify(map{format:"pblang.devops-workbench.v1",pipeline:result,
    config_exports:["nginx","haproxy"],selected_fixture_backend:decision.upstream.id,
    api_fixture_parsed:response.ok,external_connection_performed:false,
    external_config_syntax_verified:false,production_ready:false});
