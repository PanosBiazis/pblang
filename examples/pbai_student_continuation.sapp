let AI=import("stdlib/pbai.sapp");
let teacher=AI.neural_specialist_train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let student=AI.neural_specialist_distill(teacher.artifact,[[0],[1,0]],[map{x:[7,0],y:4}]);
let original=student.checkpoint();
let continued=AI.neural_specialist_student_continue(original,
 [map{x:[2,0],y:5},map{x:[3,0],y:5}],[map{x:[4,0],y:5}],map{epochs:64,lr:0.1,max_grad_norm:1});
print json_stringify(continued.evaluate([map{x:[5,0],y:5}]));
print AI.neural_specialist_student_load(original).predict([5,0]).token;
// A caller can explicitly save continued.checkpoint() to a new private file.
