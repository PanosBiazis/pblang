// Explicit synchronous scope; prepare student.json with the file example first.
let AI=import("stdlib/pbai.sapp");let S=import("stdlib:pbai_checkpoint_scope.sapp");
let scoped=AI.neural_specialist_checkpoint_scope_bind(S);
let directory=env_get("PBAI_CHECKPOINT_TEST_DIR");let phase=env_get("PBAI_CHECKPOINT_SCOPE_PHASE");
assert(type(directory)=="string" and directory!="","explicit private checkpoint directory required");
assert(phase=="success" or phase=="throw","select success or throw scope example");
let predict=nil;
let result=scoped.with_file(path_join(directory,"student.json"),fn(loaded){
 predict=loaded.predict;let token=predict([6,0]).token;
 if phase=="throw" {throw "synthetic application failure";}
 return map{ok:true,value:token};
});
let blocked=try {predict([6,0]);false} catch true;
assert(result.cleanup_ok and result.cleanups_attempted==1 and blocked,"scope closes even after a catchable application exception");
assert(result.ok==(phase=="success"),"application must inspect the result status");
print json_stringify(map{format:"pbai.checkpoint-scope.example.v1",ok:result.ok,
 body_status:result.body_status,cleanup_ok:result.cleanup_ok,cleanups_attempted:result.cleanups_attempted,
 token:result.value,original_error_available:result.original_error_available,
 saved_prediction_blocked:blocked,globally_activated:false});
