let App = import("examples/bounded_loopback_service/app.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn main() {
    let data = App.model();
    let compiled = UI.compile(App.view(data), map{
        target: "native", width: 1280, height: 760
    });
    let result = map{
        format: "pblang.example.bounded-loopback-service.v1",
        live_supported: data.capability.live_supported,
        loopback_only: data.capability.loopback_only,
        bounded_accept: data.capability.bounded_accept,
        payload_logged: data.capability.payload_logged,
        ui_records: len(compiled.records), live_executed: false,
        verified: data.sample.ok and len(compiled.records) > 0
    };
    print json_stringify(result);
    return result.verified;
}

main();
