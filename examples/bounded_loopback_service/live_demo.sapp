let Service = import("examples/bounded_loopback_service/service.sapp");

let result = Service.live_self_test();
print json_stringify(map{
    format: "pblang.example.bounded-loopback-live.v1",
    ok: result.ok, executed: result.executed,
    unsupported: try result.unsupported catch false,
    loopback_only: result.loopback_only,
    payload_exposed: result.payload_exposed,
    server_ok: try result.server.ok catch false,
    client_ok: try result.client.ok catch false,
    listener_closed: try result.server.listener_closed catch false,
    server_socket_closed: try result.server.socket_closed catch false,
    client_socket_closed: try result.client.socket_closed catch false,
    server_error: try result.server.error catch nil,
    client_error: try result.client.error catch nil
});
if result.executed and not result.ok { throw "bounded loopback live check failed"; }
