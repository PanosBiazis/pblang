let Service = import("examples/bounded_loopback_service/service.sapp");
let App = import("examples/bounded_loopback_service/app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "bounded loopback service test failed: " + message; }
}

fn record(bundle, name) {
    for item in bundle.records { if item.name == name { return item; } }
    return nil;
}

let frame = Service.make_request("request-1", "Καλημέρα");
let handled = Service.handle_frame(frame);
require(handled.ok and handled.request_id == "request-1"
    and handled.received_bytes == len(str_to_bytes("Καλημέρα"))
    and not handled.payload_exposed,
    "valid Unicode request must produce a privacy-safe acknowledgement");
require(not Service.handle_frame("").ok
    and not Service.handle_frame("{}\n").ok
    and not Service.handle_frame("not-json\n").ok,
    "empty and malformed frames must fail closed");
require((try Service.make_request("bad id", "hello") catch nil) == nil,
    "invalid request identifiers must be rejected");
let oversized = "";
let index = 0;
while index < Service.MAX_MESSAGE_BYTES + 1 {
    oversized = oversized + "x";
    index = index + 1;
}
require((try Service.make_request("oversized", oversized) catch nil) == nil,
    "oversized messages must be rejected before serialization");
require((try Service.options(map{ host: "0.0.0.0" }) catch nil) == nil,
    "wildcard listeners must be rejected before network access");
require((try Service.options(map{ accept_timeout_ms: 0 }) catch nil) == nil,
    "invalid deadlines must fail before network access");

let data = App.model();
let tree = App.view(data);
require(UI.validate(tree).ok, "shared UI tree must validate");
let web = UI.compile(tree, map{ target: "web", width: 320, height: 640 });
let native = UI.compile(tree, map{ target: "native", width: 1440, height: 900 });
let android = UI.compile(tree, map{ target: "android", width: 360, height: 720 });
for bundle in [web, native, android] {
    require(record(bundle, "brand") != nil, "brand must render on every target");
    require(record(bundle, "connection_status") != nil,
        "accessible status must render on every target");
    require(record(bundle, "run_check") != nil,
        "check action must render on every target");
    require(record(bundle, "privacy_card") != nil,
        "privacy status must render on every target");
}
let preview = UI.preview_web("Loopback Connection Lab", tree, App.web_options());
require(preview.response.status == 200
    and str_contains(preview.generated.css, "@media(max-width:640px)"),
    "Web preview must be responsive");
require(str_index_of(preview.generated.html, "0.0.0.0") < 0,
    "Web output must not advertise a wildcard endpoint");

let support = Service.capabilities();
if support.live_supported {
    let live = Service.live_self_test();
    require(live.ok and live.executed and live.server.listener_closed
        and live.server.socket_closed and live.client.socket_closed,
        "live loopback round trip must terminate with all descriptors closed");
    let listener = Service.open_listener(map{ accept_timeout_ms: 20 });
    require(listener.ok, "timeout test listener must open");
    let started = now_ms();
    let timed = Service.serve_once(listener);
    let elapsed = now_ms() - started;
    require(not timed.ok and timed.timeout and timed.listener_closed
        and elapsed >= 5 and elapsed < 500,
        "empty listener must stop at its deadline and close cleanly");
}

require(Service.source_sha256() ==
    "7a69f736e96c0ed7c576e7832e661eeee20961b5172b8244e86ebd93fde79b73",
    "source provenance digest must remain stable");
for source_path in [
    "examples/bounded_loopback_service/service.sapp",
    "examples/bounded_loopback_service/app.sapp",
    "examples/bounded_loopback_service/main.sapp",
    "examples/bounded_loopback_service/live_demo.sapp",
    "examples/bounded_loopback_service/benchmark.sapp",
    "examples/bounded_loopback_service/test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated
        and analysis.high == 0,
        "bounded security analysis must pass for " + source_path);
}

print "bounded_loopback_service_pass";
