let Service = import("examples/bounded_loopback_service/service.sapp");

let accepted = 0;
let i = 0;
while i < 4096 {
    let frame = Service.make_request("request_" + str(i), "payload-" + str(i));
    let result = Service.handle_frame(frame);
    if not result.ok or result.payload_exposed { throw "loopback protocol benchmark failed"; }
    accepted = accepted + 1;
    i = i + 1;
}
print json_stringify(map{
    format: "pblang.example.bounded-loopback-benchmark.v1",
    requests: accepted, network_access: false, payload_exposed: false,
    verified: accepted == 4096
});
