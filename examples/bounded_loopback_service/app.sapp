let Service = import("examples/bounded_loopback_service/service.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn model() {
    let capability = Service.capabilities();
    let sample = Service.handle_frame(Service.make_request("preview-1", "hello"));
    return map{ capability: capability, sample: sample,
        status: if capability.live_supported { "Ready for local check" }
            else { "Live adapter unavailable on this platform" } };
}

fn view(data) {
    return UI.screen([
        UI.heading("Loopback Connection Lab", map{
            name: "brand", accessibility_label: "Loopback Connection Lab"
        }),
        UI.text(data.status, map{
            name: "connection_status", accessibility_label: "Connection status"
        }),
        UI.button("Check", UI.action_set_text("connection_status", data.status), map{
            name: "run_check", accessibility_label: "Run local connection check"
        }),
        UI.grid([
            UI.card([
                UI.heading("Endpoint", map{ name: "endpoint_title" }),
                UI.text("127.0.0.1", map{ name: "endpoint_value" }),
                UI.text("Local only", map{ name: "endpoint_scope" })
            ], map{ name: "endpoint_card" }),
            UI.card([
                UI.heading("Deadlines", map{ name: "deadlines_title" }),
                UI.text("Accept, read and write bounded", map{ name: "deadlines_value" }),
                UI.text(str(data.capability.max_frame_bytes) + " byte frame limit",
                    map{ name: "frame_limit" })
            ], map{ name: "deadlines_card" }),
            UI.card([
                UI.heading("Privacy", map{ name: "privacy_title" }),
                UI.text("Payload hidden", map{ name: "payload_policy" }),
                UI.text("Peer identity hidden", map{ name: "peer_policy" })
            ], map{ name: "privacy_card" })
        ], map{ name: "status_grid", columns: 3, gap: 12 }),
        UI.text("Request " + data.sample.request_id + " accepted", map{
            name: "sample_status", accessibility_label: "Sample protocol status"
        })
    ], map{ name: "loopback_service_root", gap: 16 });
}

fn web_options() {
    return map{ theme: "light", lang: "en", host: "127.0.0.1", port: 8080,
        width: 1180, height: 760,
        palette: map{ accent: [0, 105, 92], selected: [190, 72, 20], focus: [0, 90, 168] } };
}

export model, view, web_options;
