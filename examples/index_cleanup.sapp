// PBLang VM-owned resources are reclaimed for escaping guest index failures.
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let context=V.execution_context(true);
let setup=F.frontend_compile("memory_alloc(7);");
V.run_seeded(setup.chunk,map{},context);
let memory=context.memory;
let failing=F.frontend_compile("let values=[];print values[1];");
let failed=try {V.run_seeded(failing.chunk,map{},context);false} catch true;
assert(failed and memory.closed and context.memory==nil,"automatic index failure cleanup");
print "Index failure caught; managed resources released automatically.";
