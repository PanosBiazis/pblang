// Shared native/Web import contract; only validated, detached pixels reach the model.
let LED=import("stdlib:uno_r4_led_matrix.sapp");let S=import("stdlib:serialization.sapp");
let FORMAT="pblang.uno-r4-led-export.v1";
let MAPPING="row-major; pixel y*12+x; MSB-first uint32 words";
let MAX_BYTES=131072;
fn decode(text) {
    let parsed=S.parse_safe(text,"json",map{max_input_bytes:MAX_BYTES,max_output_bytes:MAX_BYTES,
        max_line_bytes:MAX_BYTES,max_lines:16384,max_depth:5,max_items:14000,strict:true,reject_duplicate_keys:true});
    if not parsed.ok or parsed.duplicate_keys_checked!=true {throw "Invalid or oversized LED export JSON.";}
    let value=parsed.value;
    if type(value)!="map" or len(map_keys(value))!=4 {throw "Expected LED export envelope.";}
    for key in ["format","mapping","document","arduino_frames"] {if not map_has(value,key) {throw "Missing LED export field.";}}
    if value.format!=FORMAT or value.mapping!=MAPPING {throw "Unsupported LED export format or mapping.";}
    let document=LED.validate(value.document);let rows=value.arduino_frames;
    if type(rows)!="array" or len(rows)!=len(document.frames) {throw "Arduino frame count mismatch.";}
    for i len(rows) {
        let row=rows[i];if type(row)!="array" or len(row)!=4 {throw "Invalid Arduino frame row.";}
        let expected=LED.pack(document.frames[i].pixels);
        for j 3 {if not LED.integer(row[j],0,4294967295) or row[j]!=expected[j] {throw "Arduino words disagree with pixels.";}}
        if not LED.integer(row[3],50,5000) or row[3]!=document.frames[i].duration_ms {throw "Arduino duration mismatch.";}
    }
    return document;
}
export FORMAT,MAPPING,MAX_BYTES,decode;
