let Model=import("./model.sapp");
let args=try env_get("PBLANG_SCRIPT_ARGS") catch "";if args==nil {args="";}
if args=="--gui" {let Native=import("./view.sapp");Native.run();}
elif args=="--web" {let Web=import("./web.sapp");print "LED Studio preview: http://127.0.0.1:8768/";Web.serve();}
elif args=="--export" {print Model.export_document(Model.create());}
elif args=="" {print "UNO R4 LED Studio: --gui, --web, --export. Preview only; no hardware connection.";}
else {throw "Usage: main.sapp [--gui|--web|--export]";}
