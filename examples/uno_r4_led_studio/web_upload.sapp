// Strict, bounded browser file form. Filenames are ignored, never paths or logs.
let Exchange=import("./exchange.sapp");
let MAX_BODY=Exchange.MAX_BYTES+8192;
fn decode(body,content_type,text_field,duration_field,import_action) {
    if type(body)!="string" or len(body)>MAX_BODY or len(str_to_bytes(body))>MAX_BODY {throw "Invalid upload.";}
    let prefix="multipart/form-data; boundary=";
    if type(content_type)!="string" or not str_starts_with(content_type,prefix) {throw "Invalid upload.";}
    let boundary=str_slice(content_type,len(prefix),len(content_type));
    if str_starts_with(boundary,"\"") and str_ends_with(boundary,"\"") {boundary=str_slice(boundary,1,len(boundary)-1);}
    if len(boundary)<1 or len(boundary)>70 {throw "Invalid upload.";}
    for c in str_to_bytes(boundary) {if not ((c>=48 and c<=57) or (c>=65 and c<=90) or (c>=97 and c<=122) or c==45 or c==95) {throw "Invalid upload.";}}
    let start="--"+boundary+"\r\n";
    if not str_starts_with(body,start) {throw "Invalid upload.";}
    let chunks=str_split(str_slice(body,len(start),len(body)),"\r\n--"+boundary);
    if len(chunks)!=7 or not (chunks[6]=="--\r\n" or chunks[6]=="--") {throw "Invalid upload.";}
    let values=map{};
    for i 6 {
        let part=chunks[i];if i>0 {if not str_starts_with(part,"\r\n") {throw "Invalid upload.";}part=str_slice(part,2,len(part));}
        let split=str_split(part,"\r\n\r\n");if len(split)<2 or len(split[0])>1024 {throw "Invalid upload.";}
        let headers=str_split(split[0],"\r\n");if len(headers)>2 {throw "Invalid upload.";}
        let cd="Content-Disposition: form-data; name=\"";
        if not str_starts_with(headers[0],cd) {throw "Invalid upload.";}
        let naming=str_split(str_slice(headers[0],len(cd),len(headers[0])),"\"");
        let key=naming[0];
        if not (key=="csrf" or key=="revision" or key=="action" or key==text_field or key==duration_field or key=="file") or map_has(values,key) {throw "Invalid upload.";}
        if key=="file" {
            if len(naming)!=4 or naming[1]!="; filename=" or naming[3]!="" or len(naming[2])>256 {throw "Invalid upload.";}
            // Browser MIME is only a hint. The strict export decoder validates content.
            if len(headers)==2 and not str_starts_with(headers[1],"Content-Type: ") {throw "Invalid upload.";}
        } elif len(naming)!=2 or naming[1]!="" or len(headers)!=1 {throw "Invalid upload.";}
        let data=str_slice(part,len(split[0])+4,len(part));
        let maximum=if key=="file" {Exchange.MAX_BYTES} else {4096};
        if len(data)>maximum or len(str_to_bytes(data))>maximum or str_contains(data,strfromcharcode(0)) {throw "Invalid upload.";}
        values[key]=data;
    }
    if values.action!=import_action {throw "Invalid upload.";}
    let ordinary=[];
    for key in ["csrf","revision","action",text_field,duration_field] {push(ordinary,key+"="+url_encode(values[key]));}
    return map{body:str_join(ordinary,"&"),payload:values.file};
}
export MAX_BODY,decode;
