let GUI=import("stdlib:gui.sapp");let G=import("stdlib:graphics.sapp");
let Model=import("./model.sapp");let Exchange=import("./exchange.sapp");let File=import("stdlib:secure_file.sapp");
fn _label(form,name,x,y,w,h,text,size=16) {
    GUI.add(form,GUI.styled_label(name,x,y,w,h,text,map{font_size:size,font_family:"sans",text_spacing:"natural",wrap:true,max_lines:3}));
}
fn _action(app,operation,value=nil) {
    return fn(form) {
        let draft_duration=GUI.get(form,"duration").value;let actual=value;
        if operation=="text" or operation=="static_text" {actual=GUI.get(form,"text").value;}
        if operation=="duration" or operation=="timing_all" {actual=try parse_number(GUI.get(form,"duration").value) catch nil;}
        if operation=="play" {actual=try parse_number(GUI.get(form,"repetitions").value) catch 0;}
        let ok=false;
        if operation=="import" {
            let loaded=try File.read_text(GUI.get(form,"import_path").value,Exchange.MAX_BYTES) catch nil;
            if loaded!=nil and loaded.ok {ok=try Model.apply(app.state,"import",loaded.text) catch false;}
        } else {ok=try Model.apply(app.state,operation,actual,num_floor(now_ms())) catch false;}
        if ok and operation=="import" {let field=GUI.get(form,"text");field.value="";let repeats=GUI.get(form,"repetitions");repeats.value="1";}
        if not ok {app.state.status="Cannot apply: check input, file format and limits.";if operation=="static_text" {app.state.status="Static text: use 1–2 supported glyphs. Frame retained.";}}
        if app.state.export_requested {
            app.state.export_requested=false;
            let path="build/uno-r4-led-studio/frames-"+str(num_floor(now_ms()))+".json";
            let written=try File.write_text_new_exclusive(path,Model.export_document(app.state)) catch nil;
            if written!=nil and written.ok {app.state.status="Saved new validated export under build/uno-r4-led-studio/.";}
            else {app.state.status="Export not confirmed. Existing files were not replaced.";}
        }
        sync(app);if not ok and (operation=="duration" or operation=="timing_all") {let field=GUI.get(form,"duration");field.value=draft_duration;}
    };
}
fn _button(app,name,x,y,w,text,op,value=nil) {
    let button=GUI.button(name,x,y,w,36,text,_action(app,op,value));
    button.font_size=14;button.font_family="sans";button.text_spacing="natural";button.variant="secondary";
    GUI.add(app.form,button);
}
fn sync(app) {
    for i 96 {let button=GUI.get(app.form,"pixel_"+str(i));button.selected=false;}
    let status=GUI.get(app.form,"status");status.text=app.state.status;
    let timeline=GUI.get(app.form,"timeline");timeline.text="Frame "+str(app.state.index+1)+" / "+str(len(app.state.document.frames))+" · "+str(app.state.document.total_ms)+" ms total";
    let duration=GUI.get(app.form,"duration");duration.value=str(app.state.document.frames[app.state.index].duration_ms);
    app.form.dirty=true;
}
fn create(width=600) {
    if width!=390 and width!=600 {throw "Preview width must be 390 or 600.";}
    let app=map{state:Model.create(),form:GUI.form("PBLang UNO R4 LED Studio",width,760),step:num_floor((width-48)/12)};
    GUI.set_text_render(app.form,"auto");
    _label(app.form,"title",24,18,width-48,30,"UNO R4 · LED Studio",24);
    _label(app.form,"notice",24,52,width-48,38,"12 × 8 red LEDs · preview only",14);
    let bw=num_floor((width-66)/4);
    _button(app,"heart",24,88,bw,"Heart","preset","heart");
    _button(app,"border",30+bw,88,bw,"Border","preset","border");
    _button(app,"checker",36+bw*2,88,bw,"Checker","preset","checker");
    _button(app,"clear",42+bw*3,88,bw,"Clear","preset","clear");
    for i 96 {
        let button=GUI.button("pixel_"+str(i),24+(i%12)*app.step,138+num_floor(i/12)*app.step,app.step-4,app.step-4,"",_action(app,"pixel",i));
        button.variant="secondary";GUI.add(app.form,button);
    }
    let y=146+8*app.step;
    _label(app.form,"timeline",24,y,width-48,26,"",14);
    y=y+32;let text=GUI.textbox("text",24,y,width-242,34,"PB");text.max_chars=8;GUI.add(app.form,text);
    _button(app,"static_text",width-208,y,88,"Static text","static_text");
    _button(app,"render_text",width-112,y,88,"Scroll text","text");
    y=y+44;
    _button(app,"previous",24,y,bw,"Previous","previous");_button(app,"next",30+bw,y,bw,"Next","next");
    _button(app,"add",36+bw*2,y,bw,"Duplicate","add");_button(app,"delete",42+bw*3,y,bw,"Delete","delete");
    y=y+44;let duration=GUI.textbox("duration",24,y,bw,34,"250");duration.max_chars=4;GUI.add(app.form,duration);
    _button(app,"set_duration",30+bw,y,bw,"Set ms","duration");_button(app,"play",36+bw*2,y,bw,"Play","play");_button(app,"stop",42+bw*3,y,bw,"Stop","stop");
    y=y+44;_button(app,"invert",24,y,bw,"Invert","invert");_button(app,"timing_all",30+bw,y,bw,"All ms","timing_all");_button(app,"export",36+bw*2,y,width-60-bw*2,"Export new JSON","export");
    y=y+44;let path=GUI.textbox("import_path",24,y,width-144,34,"");path.max_chars=4096;GUI.add(app.form,path);
    _button(app,"import",width-112,y,88,"Import","import");
    y=y+40;_label(app.form,"import_help",24,y,width-48,30,"Import: path to an exported JSON (max 128 KiB).",12);
    y=y+32;_label(app.form,"repeat_help",24,y,width-48,22,"Repeats 1–8 · limit 60 s / 128 frames",12);
    y=y+24;let repeats=GUI.textbox("repetitions",24,y,80,30,"1");repeats.max_chars=2;GUI.add(app.form,repeats);
    y=y+36;_label(app.form,"status",24,y,width-48,48,"",14);
    _label(app.form,"help",24,y+48,width-48,40,"Static text: 1–2 glyphs, current frame. Scroll text: 1–8, replaces all frames.",12);
    app.form.h=y+94;sync(app);return app;
}
fn update(app,events,now=nil) {
    for event in events {GUI.handle_event(app.form,event);}
    if app.form.close_requested {app.graphics_stop=true;app.state.playing=false;}
    let time=now;if time==nil {time=num_floor(now_ms());}
    if Model.tick(app.state,time) {sync(app);}
    return app.form.dirty;
}
fn draw(app,canvas) {
    GUI.draw(canvas,app.form);let pixels=Model.current(app.state);
    for i 96 {
        let button=GUI.get(app.form,"pixel_"+str(i));let color=G.rgb(70,32,39);
        if pixels[i]==1 {color=G.rgb(255,77,94);}
        let inset=num_max(4,num_floor(button.w/5));
        canvas.rect(button.x+inset,button.y+inset,button.w-inset*2,button.h-inset*2,color);
    }
}
fn run() {let app=create();let win=G.Window(app.form.w,app.form.h,"PBLang UNO R4 LED Studio");G.run(win,app,update,draw,30);}
export create,sync,update,draw,run;
