// Only separates the bounded payload. The existing form handler must still
// authenticate Host/origin/CSRF/revision before any JSON decode/model mutation.
let Exchange=import("./exchange.sapp");
let MAX_BODY=Exchange.MAX_BYTES*3+8192;
fn split_body(body) {
    if type(body)!="string" or len(body)>MAX_BODY or len(str_to_bytes(body))>MAX_BODY {throw "Import form exceeds body limit.";}
    let pairs=str_split(body,"&");if len(pairs)>12 {throw "Too many editor fields.";}
    let ordinary=[];let payload=nil;let workspace=nil;let repetitions=nil;let counter=map{};
    for pair in pairs {
        let parts=str_split(pair,"=");if len(parts)!=2 {throw "Invalid form field.";}
        if parts[0]=="counter_start" or parts[0]=="counter_end" or parts[0]=="counter_seconds" {
            if map_has(counter,parts[0]) or len(parts[1])>96 {throw "Invalid counter field.";}
            // Numeric UI fields never need encoded data; reject malformed escapes
            // and NUL before stripping these values from the guarded form body.
            let raw=parts[1];let i=0;
            while i<len(raw) {if raw[i]=="%" {if i+2>=len(raw) or not str_contains("0123456789abcdefABCDEF",raw[i+1]) or not str_contains("0123456789abcdefABCDEF",raw[i+2]) {throw "Invalid counter escape.";}i=i+2;}i=i+1;}
            let value=url_decode(str_join(str_split(raw,"+")," "));
            if len(value)>32 or str_contains(value,strfromcharcode(0)) {throw "Invalid counter input.";}
            counter[parts[0]]=value;continue;
        }
        if parts[0]=="repetitions" {
            if repetitions!=nil or len(parts[1])>32 {throw "Invalid repetition field.";}
            repetitions=parts[1];continue;
        }
        if parts[0]=="workspace" {
            if workspace!=nil or not (parts[1]=="draw" or parts[1]=="text" or parts[1]=="animation" or parts[1]=="dynamic") {throw "Invalid workspace choice.";}
            workspace=parts[1];continue;
        }
        if parts[0]!="animation" {push(ordinary,pair);continue;}
        if payload!=nil {throw "Duplicate animation field.";}
        let bytes=str_to_bytes(parts[1]);let i=0;
        while i<len(bytes) {
            if bytes[i]==37 {
                if i+2>=len(bytes) {throw "Invalid percent escape.";}
                for j in [i+1,i+2] {let b=bytes[j];if not ((b>=48 and b<=57) or (b>=65 and b<=70) or (b>=97 and b<=102)) {throw "Invalid percent escape.";}}
                i=i+2;
            }
            i=i+1;
        }
        payload=url_decode(str_join(str_split(parts[1],"+")," "));
        if len(payload)>Exchange.MAX_BYTES or len(str_to_bytes(payload))>Exchange.MAX_BYTES or str_contains(payload,strfromcharcode(0)) {throw "Invalid or oversized animation.";}
    }
    return map{body:str_join(ordinary,"&"),payload:payload,workspace:workspace,repetitions:repetitions,counter:counter};
}
export MAX_BODY,split_body;
