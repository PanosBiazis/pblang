// Explicit opt-in web controller. Browser input never selects a port or uploaded project.
let Device=import("./device_export.sapp");
let Host=import("./device_host.sapp");
fn create(plan,port,confirmed=false,runner=nil){
    let frozen=Device.validate(plan);
    if type(confirmed)!="bool" or not confirmed or not regex_match(port,"^/dev/ttyACM[0-9]{1,3}$") {throw "Explicit UNO port confirmation required.";}
    if runner==nil {runner=Host.run;}
    let action=fn(document,command){
        if command!="PLAY" and command!="STOP" and command!="STATUS" {throw "Unsupported device command.";}
        if command=="PLAY" {
            let current=try Device.plan(document,frozen.repetitions) catch nil;
            if current==nil or current.digest!=frozen.digest {
                return map{ok:false,message:"Edited frames differ from the installed Arduino project. Export and upload them before physical Play. Stop remains available."};
            }
        }
        let result=try runner(frozen,port,command,true) catch nil;
        if result==nil or not result.ok {
            return map{ok:false,message:"Device command not confirmed. Output may be uncertain; check USB and use Stop. No automatic retry."};
        }
        let state=result.reply.state;
        return map{ok:true,message:"Arduino confirmed "+command+": "+state+"; frame "+str(result.reply.frame)+"; remaining "+str(result.reply.remaining_ms)+" ms. This is a device reply, not visual LED verification."};
    };
    return map{action:action};
}
export create;
