// Explicit opt-in host controller. Browser input cannot choose executables or ports.
let Device=import("./device_export.sapp");
let Host=import("./device_host.sapp");
fn _remember(uploader,plan){if uploader==nil or not map_has(uploader,"confirm") {return true;}let result=try uploader.confirm(plan) catch nil;return result!=nil and (try result.ok catch false)==true;}
fn _message(ok,message){return map{ok:ok,message:message};}
fn create(plan,port,confirmed=false,runner=nil,uploader=nil){
    let state=map{installed:Device.validate(plan),candidate:nil,busy:false,uncertain:false};
    if type(confirmed)!="bool" or not confirmed or not regex_match(port,"^/dev/ttyACM[0-9]{1,3}$") {throw "Explicit UNO port confirmation required.";}
    if runner==nil {runner=Host.run;}
    let call=fn(p,command){return try runner(p,port,command,true) catch nil;};
    let recover=fn(command){
        if state.candidate!=nil {
            let candidate=call(state.candidate,command);
            if candidate!=nil and candidate.ok {state.installed=state.candidate;state.candidate=nil;state.uncertain=false;_remember(uploader,state.installed);return candidate;}
        }
        let installed=call(state.installed,command);
        if installed!=nil and installed.ok {state.candidate=nil;state.uncertain=false;return installed;}
        return nil;
    };
    let action=fn(document,command){
        if command!="PLAY" and command!="STOP" and command!="STATUS" and command!="UPLOAD" {throw "Unsupported device command.";}
        if state.busy {
            if command=="PLAY" or command=="UPLOAD" {return _message(false,"Project transfer is active. Choose Check Arduino for progress, or Stop Arduino to cancel.");}
            let progress=nil;
            if command=="STOP" {progress=try uploader.cancel() catch nil;}else {progress=try uploader.poll() catch nil;}
            if progress==nil {return _message(false,"Transfer state unavailable. Play is blocked until cleanup is confirmed.");}
            if progress.upload_attempted {state.uncertain=true;}
            if not progress.complete or not progress.cleanup_confirmed {return _message(false,progress.message+" Choose Check Arduino for progress; no playback starts automatically.");}
            state.busy=false;
            if progress.phase=="done" and progress.ok {
                let verified=call(state.candidate,"STATUS");
                if verified!=nil and verified.ok {
                    state.installed=state.candidate;state.candidate=nil;state.uncertain=false;
                    let saved=_remember(uploader,state.installed);
                    let message="Current project uploaded and confirmed by Arduino. Choose Play on Arduino to start.";
                    if not saved {message=message+" Installed-plan checkpoint failed; host restart requires explicit recovery.";}
                    return _message(true,message);
                }
                state.uncertain=true;
                return _message(false,"Upload finished but Arduino identity/project was not confirmed. Check Arduino again; Play is blocked.");
            }
            if not state.uncertain {state.candidate=nil;}
            if command!="STOP" {return _message(false,"Transfer failed or was cancelled. No automatic retry or playback. Check Arduino before retrying.");}
        }
        if command=="UPLOAD" {
            if uploader==nil {return _message(false,"Project transfer is not configured on this host. Export and upload the project first.");}
            if state.uncertain {return _message(false,"Arduino project is uncertain. Check Arduino or Stop Arduino before another transfer.");}
            let current=try Device.plan(document,state.installed.repetitions) catch nil;
            if current==nil {return _message(false,"Project exceeds device frame, repetition or duration limits. Existing firmware retained.");}
            let stopped=call(state.installed,"STOP");
            if stopped==nil or not stopped.ok {return _message(false,"Arduino Stop was not confirmed. Project transfer did not start.");}
            state.candidate=current;
            let started=try uploader.start(current,true) catch nil;
            if started==nil {state.busy=true;return _message(false,"Transfer start is uncertain. Choose Check Arduino or Stop Arduino; no automatic retry.");}
            state.busy=not started.complete or not started.cleanup_confirmed;
            if started.upload_attempted {state.uncertain=true;}
            if not state.busy and not state.uncertain {state.candidate=nil;}
            return _message(started.ok,started.message+" Choose Check Arduino for progress; no playback starts automatically.");
        }
        if command=="PLAY" {
            if state.uncertain {return _message(false,"Arduino project is uncertain. Check Arduino before Play.");}
            let current=try Device.plan(document,state.installed.repetitions) catch nil;
            if current==nil or current.digest!=state.installed.digest {
                let next="Export and upload them before physical Play.";
                if uploader!=nil {next="Choose Send current project, then Check Arduino until confirmed, then Play on Arduino.";}
                return _message(false,"Edited frames differ from the installed Arduino project. "+next+" Stop remains available.");
            }
        }
        let result=nil;
        if state.uncertain {result=recover(command);}else {result=call(state.installed,command);}
        if result==nil or not result.ok {
            return _message(false,"Device command not confirmed. Output may be uncertain; check USB and use Stop. No automatic retry.");
        }
        let phase=result.reply.state;
        return _message(true,"Arduino confirmed "+command+": "+phase+"; frame "+str(result.reply.frame)+"; remaining "+str(result.reply.remaining_ms)+" ms. This is a device reply, not visual LED verification.");
    };
    return map{action:action,supports_upload:uploader!=nil};
}
export create;
