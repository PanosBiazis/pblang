// Independent single-use controls: Play must not consume the visible Stop.
// At most 16 rendered pages, each with up to four small guarded forms.
let Doc=import("stdlib:ui_document.sapp");
let Forms=import("stdlib:ui_form_web.sapp");
let MAX_PAGES=16;
fn _once(state,entry,action,key) {
    return fn(values) {
        if entry.used {throw "Device form already used.";}
        entry.used=true;
        if key=="device_play" or key=="device_upload" {
            if entry.epoch!=state.epoch {entry.stale=true;return "Newer device controls were used. This older request did not run. Use the current controls.";}
        }
        if key!="device_status" {state.epoch=state.epoch+1;}
        return action(values);
    };
}
fn _close(page){for entry in page {entry.app.close();}}
fn create(port,options,actions) {
    let state=map{pages:[],sequence:0,epoch:0,closed:false};
    let widgets=[
        map{name:"device_status",label:"Check Arduino"},
        map{name:"device_play",label:"Play on Arduino"},
        map{name:"device_stop",label:"Stop Arduino"}
    ];
    if map_has(actions,"device_upload") {push(widgets,map{name:"device_upload",label:"Send current project"});}
    let render=fn(overrides=nil,blocked=false){
        if state.closed or state.sequence>=9007199254740000 or state.epoch>=9007199254740000 {throw "Device controls closed.";}
        if len(state.pages)>=MAX_PAGES {
            _close(state.pages[0]);let kept=[];
            for i len(state.pages) {if i>0 {push(kept,state.pages[i]);}}
            state.pages=kept;
        }
        state.sequence=state.sequence+1;let entries=[];let html="<div class=\"device-buttons\">";
        // Register before rendering so a later failure still leaves owned forms closeable.
        push(state.pages,entries);
        let ordinal=0;
        for widget in widgets {
            ordinal=ordinal+1;
            let key=widget.name;
            let entry=map{path:"/device/"+str(state.sequence)+"/"+str(ordinal),app:nil,used:false,stale:false,epoch:state.epoch};
            let selected=actions[key];if overrides!=nil and map_has(overrides,key) {selected=overrides[key];}
            let bound=map{};bound[key]=_once(state,entry,selected,key);
            let document=Doc.from_design(map{form:map{title:"Arduino",w:200,h:100},model:map{},widgets:[
                map{name:key,kind:"button",x:0,y:0,w:100,h:30,parent:"root",props:map{text:widget.label}}]});
            entry.app=Forms.create(document,bound,port,options);push(entries,entry);
            let page=entry.app.handle(map{method:"GET",path:"/",headers:map{host:"127.0.0.1:"+str(port)},body:""});
            if page.status!=200 {throw "Device controls unavailable.";}
            let form=str_split(str_split(page.body,"<form ")[1],"</form>")[0];
            form=str_join(str_split(form,"action=\"/action\""),"action=\""+entry.path+"#arduino-device\"");
            if blocked and (key=="device_play" or key=="device_upload") {
                form=str_join(str_split(form,"<button "),"<button disabled aria-disabled=\"true\" ");
            }
            html=html+"<form class=\"device-controls\" "+form+"</form>";
        }
        return html+"</div>";
    };
    let handle=fn(req){
        if state.closed {return nil;}
        for page in state.pages {for entry in page {
            if entry.path==req.path {
                if entry.used {return nil;}
                // Only guarded POST reaches an action. GET never creates an effect.
                let response=entry.app.handle(map{method:req.method,path:"/action",headers:req.headers,body:req.body});
                if entry.used {entry.app.close();}
                response.device_stale=entry.stale;return response;
            }
        }}
        return nil;
    };
    let close=fn(){state.closed=true;for page in state.pages {_close(page);}state.pages=[];return true;};
    return map{render:render,handle:handle,close:close};
}
export create;
