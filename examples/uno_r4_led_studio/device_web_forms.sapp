// Independent, single-use device forms. Editor rebuilds cannot revoke Stop.
// Keep only the most recent 16 rendered pages; eviction and close revoke them.
let Doc=import("stdlib:ui_document.sapp");
let Forms=import("stdlib:ui_form_web.sapp");
let MAX_PAGES=16;
fn _once(entry,action) {
    return fn(values) {
        if entry.used {throw "Device form already used.";}
        entry.used=true;
        return action(values);
    };
}
fn create(port,options,actions) {
    let state=map{pages:[],sequence:0,closed:false};
    let widgets=[
        map{name:"device_status",kind:"button",x:0,y:0,w:100,h:30,parent:"root",props:map{text:"Check Arduino"}},
        map{name:"device_play",kind:"button",x:0,y:0,w:100,h:30,parent:"root",props:map{text:"Play on Arduino"}},
        map{name:"device_stop",kind:"button",x:0,y:0,w:100,h:30,parent:"root",props:map{text:"Stop Arduino"}}
    ];
    if map_has(actions,"device_upload") {push(widgets,map{name:"device_upload",kind:"button",x:0,y:0,w:100,h:30,parent:"root",props:map{text:"Send current project"}});}
    let document=Doc.from_design(map{form:map{title:"Arduino",w:600,h:100},model:map{},widgets:widgets});
    let render=fn(overrides=nil){
        if state.closed or state.sequence>=9007199254740990 {throw "Device controls closed.";}
        if len(state.pages)>=MAX_PAGES {
            state.pages[0].app.close();let kept=[];
            for i len(state.pages) {if i>0 {push(kept,state.pages[i]);}}
            state.pages=kept;
        }
        state.sequence=state.sequence+1;
        let entry=map{path:"/device/"+str(state.sequence),app:nil,used:false};
        let bound=map{};for key in map_keys(actions) {let selected=actions[key];if overrides!=nil and map_has(overrides,key) {selected=overrides[key];}bound[key]=_once(entry,selected);}
        entry.app=Forms.create(document,bound,port,options);
        let page=entry.app.handle(map{method:"GET",path:"/",headers:map{host:"127.0.0.1:"+str(port)},body:""});
        if page.status!=200 {entry.app.close();throw "Device controls unavailable.";}
        push(state.pages,entry);
        let form=str_split(str_split(page.body,"<form ")[1],"</form>")[0];
        form=str_join(str_split(form,"action=\"/action\""),"action=\""+entry.path+"#arduino-device\"");
        return "<form class=\"device-controls\" "+form+"</form>";
    };
    let handle=fn(req){
        if state.closed {return nil;}
        for entry in state.pages {
            if entry.path==req.path {
                if entry.used {return nil;}
                // Only POST reaches /action. GET never creates a physical effect.
                let response=entry.app.handle(map{method:req.method,path:"/action",headers:req.headers,body:req.body});
                if entry.used {entry.app.close();}
                return response;
            }
        }
        return nil;
    };
    let close=fn(){state.closed=true;for entry in state.pages {entry.app.close();}state.pages=[];return true;};
    return map{render:render,handle:handle,close:close};
}
export create;
