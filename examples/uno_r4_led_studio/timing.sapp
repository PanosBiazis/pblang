// Preview repetitions never alter exported frames or their durations.
let LED=import("stdlib:uno_r4_led_matrix.sapp");
fn repetitions(document,value) {
    if not LED.integer(value,1,8) {throw "Choose 1–8 repetitions.";}
    if document.total_ms*value>60000 or len(document.frames)*value>128 {throw "Repeated preview exceeds 60 seconds or 128 displayed frames.";}
    return value;
}
export repetitions;
