// On-board application logic, compiled by the PBLang-owned numeric C backend.
// Only fixed numeric storage and board I/O cross the thin Arduino SDK adapter.
// Cells: 0 ready,1 running,2 start,3 visible frame,4 phase,5 RX length,6 discard,
// 7 RX start,8 last command,10 TX length,11 TX offset; RX16..47, request48..63,
// previous request64..79, TX128..639. All allocations are static in the adapter.
fn fw_elapsed(start) {let elapsed=pb_millis()-start;if elapsed<0 {elapsed=elapsed+4294967296;}return elapsed;}
fn fw_stop(phase) {pb_set(1,0);pb_set(3,0);pb_set(4,phase);if pb_get(0)==1 {pb_clear();}return 0;}
fn fw_tick() {
    if pb_get(1)!=1 {return 0;}
    let elapsed=fw_elapsed(pb_get(2));
    if elapsed>=project_total_ms() {fw_stop(2);return 0;}
    let offset=elapsed%project_pass_ms();let end=0;
    for index project_frame_count() {
        end=end+project_word(index,3);
        if offset<end {
            if pb_get(3)!=index+1 {pb_render(project_word(index,0),project_word(index,1),project_word(index,2));pb_set(3,index+1);}
            return 0;
        }
    }
    fw_stop(3);return 0;
}
fn fw_send(value) {let size=pb_get(10);if size<512 {pb_set(128+size,value);pb_set(10,size+1);}return 0;}
fn fw_literal(id) {for i literal_length(id) {fw_send(literal_byte(id,i));}return 0;}
fn fw_number(value) {if value>=10 {fw_number((value-value%10)/10);}fw_send(48+value%10);return 0;}
fn fw_flush() {
    let quota=0;
    while quota<32 and pb_get(11)<pb_get(10) and pb_writable()>0 {
        let wrote=pb_put(pb_get(128+pb_get(11)));if wrote!=1 {break;}
        pb_set(11,pb_get(11)+1);quota=quota+1;
    }
    if pb_get(11)>=pb_get(10) {pb_set(10,0);pb_set(11,0);}
    return 0;
}
fn fw_reply(command,error) {
    fw_tick();pb_set(10,0);pb_set(11,0);
    let remaining=0;if pb_get(1)==1 {remaining=project_total_ms()-fw_elapsed(pb_get(2));if remaining<0 {remaining=0;}}
    fw_literal(0);for i 64 {fw_send(project_digest_byte(i));}
    fw_literal(1);if command==0 {fw_literal(34);}else {fw_literal(29+command);}
    fw_literal(2);for i 16 {fw_send(pb_get(48+i));}
    fw_literal(3);if error==0 {fw_literal(12);}else {fw_literal(13);}
    fw_literal(4);fw_literal(40+error);fw_literal(5);fw_literal(20+pb_get(4));
    fw_literal(6);fw_number(pb_get(3));fw_literal(7);fw_number(remaining);
    fw_literal(8);fw_number(project_frame_count());fw_literal(9);fw_number(project_repetitions());
    fw_literal(10);fw_number(project_total_ms());fw_literal(11);return 0;
}
fn fw_match(id,start,count) {
    if literal_length(id)!=count {return 0;}
    for i count {if pb_get(16+start+i)!=literal_byte(id,i) {return 0;}}
    return 1;
}
fn fw_input_error() {for i 16 {pb_set(48+i,48);}fw_reply(0,1);return 0;}
fn fw_process() {
    let size=pb_get(5);if size>0 and pb_get(16+size-1)==13 {size=size-1;}
    let split=0;while split<size and pb_get(16+split)!=32 {split=split+1;}
    if split>=size or size-split-1!=16 {fw_input_error();return 0;}
    for i 16 {
        let c=pb_get(16+split+1+i);
        if not ((c>=48 and c<=57) or (c>=97 and c<=102)) {fw_input_error();return 0;}
        pb_set(48+i,c);
    }
    let command=0;
    for i 4 {if fw_match(30+i,0,split)==1 {command=i+1;}}
    if command==0 {fw_reply(0,2);return 0;}
    if pb_get(0)!=1 {fw_reply(command,3);return 0;}
    let same=1;for i 16 {if pb_get(48+i)!=pb_get(64+i) {same=0;}}
    if same==1 {
        if pb_get(8)==command {fw_reply(command,0);}else {fw_reply(command,4);}
        return 0;
    }
    if command==2 {
        pb_set(2,pb_millis());pb_set(1,1);pb_set(4,1);pb_set(3,1);
        pb_render(project_word(0,0),project_word(0,1),project_word(0,2));
    }else {if command==3 {fw_stop(0);}}
    pb_set(8,command);for i 16 {pb_set(64+i,pb_get(48+i));}
    fw_reply(command,0);return 0;
}
fn pb_setup() {
    for i 640 {pb_set(i,0);}
    pb_serial_begin();pb_set(0,pb_begin());
    if pb_get(0)==1 {fw_stop(0);}else {fw_stop(3);}
    return 0;
}
fn pb_loop() {
    fw_tick();fw_flush();if pb_get(10)>0 {return 0;}
    if pb_get(5)>0 and fw_elapsed(pb_get(7))>=500 {pb_set(6,1);pb_set(5,0);}
    let quota=0;
    while quota<32 and pb_available()>0 {
        let c=pb_read();if c<0 {break;}quota=quota+1;
        if c==10 {
            if pb_get(6)==1 {fw_input_error();}else {fw_process();}
            pb_set(5,0);pb_set(6,0);break;
        }else {if pb_get(6)==0 {
            let used=pb_get(5);if used==0 {pb_set(7,pb_millis());}
            if used>=31 or (c<32 and c!=13) or c>126 {pb_set(6,1);pb_set(5,0);}
            else {pb_set(16+used,c);pb_set(5,used+1);}
        }}
    }
    fw_tick();fw_flush();return 0;
}
