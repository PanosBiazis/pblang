let LED=import("stdlib:uno_r4_led_matrix.sapp");
fn create() {return map{document:LED.animation([map{pixels:LED.preset("heart"),duration_ms:250}]),index:0,playing:false,started:0,last_time:0,text:"PB",status:"Preview only. No board connection.",export_requested:false};}
fn current(state) {return LED.frame(state.document.frames[state.index].pixels);}
fn export_document(state) {
    let doc=LED.validate(state.document);
    return json_stringify(map{format:"pblang.uno-r4-led-export.v1",document:doc,
        mapping:"row-major; pixel y*12+x; MSB-first uint32 words",arduino_frames:LED.arduino_sequence(doc)});
}
fn apply(state,operation,value=nil,now=0) {
    let next=LED.validate(state.document);let index=state.index;
    if operation=="stop" {state.playing=false;state.status="Stopped.";return true;}
    if operation=="play" {
        if not LED.integer(now,0,9007199254740991-next.total_ms) {throw "Invalid playback clock.";}
        state.playing=true;state.started=now;state.last_time=now;state.index=0;state.status="Playing once (maximum 60 seconds).";return true;
    }
    if operation=="export" {export_document(state);state.export_requested=true;state.status="Validated frame export ready.";return true;}
    if operation=="pixel" {
        if not LED.integer(value,0,95) {throw "Invalid pixel index.";}
        next.frames[index].pixels[value]=1-next.frames[index].pixels[value];
    } elif operation=="preset" {next.frames[index].pixels=LED.preset(value);}
    elif operation=="invert" {for i 96 {next.frames[index].pixels[i]=1-next.frames[index].pixels[i];}}
    elif operation=="add" {push(next.frames,map{pixels:LED.frame(next.frames[index].pixels),duration_ms:next.frames[index].duration_ms});index=len(next.frames)-1;}
    elif operation=="delete" {
        if len(next.frames)==1 {throw "Keep at least one frame.";}
        let kept=[];for i len(next.frames) {if i!=index {push(kept,next.frames[i]);}}next.frames=kept;index=num_min(index,len(kept)-1);
    } elif operation=="previous" {index=num_max(0,index-1);}
    elif operation=="next" {index=num_min(len(next.frames)-1,index+1);}
    elif operation=="duration" {next.frames[index].duration_ms=value;}
    elif operation=="text" {next=LED.text_animation(value,100);index=0;}
    else {throw "Unknown studio action.";}
    next=LED.animation(next.frames);
    state.document=next;state.index=index;state.playing=false;
    if operation=="text" {state.text=value;}
    state.status="Frame "+str(index+1)+" / "+str(len(next.frames))+" | "+str(next.frames[index].duration_ms)+" ms";
    return true;
}
fn tick(state,now) {
    if not state.playing {return false;}
    if not LED.integer(now,state.last_time,9007199254740991) {state.playing=false;state.status="Playback stopped: clock changed.";return true;}
    state.last_time=now;let elapsed=now-state.started;let end=0;let index=0;
    // The controller owns a validated document; do not copy 96 pixels per frame
    // on every idle clock tick. Scan at most 64 timing entries.
    while index<len(state.document.frames) {
        end=end+state.document.frames[index].duration_ms;
        if elapsed<end {break;}index=index+1;
    }
    let finished=index==len(state.document.frames);index=num_min(index,len(state.document.frames)-1);
    let changed=index!=state.index or finished;state.index=index;
    if finished {state.playing=false;state.status="Playback complete.";}
    return changed;
}
export create,current,apply,tick,export_document;
