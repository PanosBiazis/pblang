let Counter=import("./counter.sapp");let Timing=import("./timing.sapp");let Text=import("./text.sapp");let LED=import("stdlib:uno_r4_led_matrix.sapp");let Exchange=import("./exchange.sapp");
fn create() {return map{document:LED.animation([map{pixels:LED.preset("heart"),duration_ms:250}]),index:0,source:"frames",generator:nil,counter_value:nil,export_kind:"frames",repeat_count:1,playing:false,started:0,last_time:0,text:"PB",status:"Preview only. No board connection.",export_requested:false};}
fn current(state) {return LED.frame(state.document.frames[state.index].pixels);}
fn export_document(state) {
    let doc=LED.validate(state.document);
    return json_stringify(map{format:Exchange.FORMAT,document:doc,
        mapping:Exchange.MAPPING,arduino_frames:LED.arduino_sequence(doc)});
}
fn export_project(state) {
    let base=json_parse(export_document(state));base.format=Exchange.PROJECT_FORMAT;
    base.generator=if state.generator==nil {nil} else {Counter.validate(state.generator)};
    return json_stringify(base);
}
fn preview(state) {
    if state.playing and state.source=="counter" {return Counter.frame(state.counter_value);}
    return current(state);
}
fn _apply(state,operation,value,now) {
    let next=LED.validate(state.document);let index=state.index;
    if operation=="stop" {
        state.playing=false;state.status="Stopped.";
        if state.source=="counter" {state.status="Counter stopped at "+Counter.label(state.counter_value)+". Authored frames retained.";}
        state.source="frames";return true;
    }
    if operation=="counter_settings" or operation=="counter_start" {
        let config=Counter.validate(value);let total=Counter.duration(config);
        if operation=="counter_start" and not LED.integer(now,0,9007199254740991-total) {throw "Invalid counter clock.";}
        state.generator=config;state.counter_value=config.start;state.playing=operation=="counter_start";
        state.source="frames";state.status="Counter settings saved. Authored frames retained.";
        if state.playing {state.source="counter";state.started=now;state.last_time=now;state.status="Local timed counter running. No sensor or board connection.";}
        return true;
    }
    if operation=="counter_clear" {state.generator=nil;state.counter_value=nil;state.source="frames";state.playing=false;state.status="Counter removed. Authored frames retained.";return true;}
    if operation=="play" {
        let count=value;if count==nil {count=state.repeat_count;}count=Timing.repetitions(next,count);
        if not LED.integer(now,0,9007199254740991-next.total_ms*count) {throw "Invalid playback clock.";}
        state.source="frames";state.repeat_count=count;state.playing=true;state.started=now;state.last_time=now;state.index=0;state.status="Preview running: "+str(count)+" pass(es), maximum 60 seconds.";return true;
    }
    if operation=="export_project" {export_project(state);state.export_requested=true;state.export_kind="project";state.status="Validated project export ready.";return true;}
    if operation=="export" {export_document(state);state.export_kind="frames";state.export_requested=true;state.status="Validated frame export ready.";return true;}
    if operation=="import" {let project=Exchange.decode_project(value);next=project.document;state.generator=project.generator;state.counter_value=if project.generator==nil {nil} else {project.generator.start};index=0;}
    elif operation=="counter_capture" {if state.generator==nil or state.counter_value==nil {throw "Configure a counter before capturing.";}next.frames[index].pixels=Counter.frame(state.counter_value);}
    elif operation=="static_text" {next.frames[index].pixels=Text.frame(value);}
    elif operation=="pixel" {
        if not LED.integer(value,0,95) {throw "Invalid pixel index.";}
        next.frames[index].pixels[value]=1-next.frames[index].pixels[value];
    } elif operation=="preset" {next.frames[index].pixels=LED.preset(value);}
    elif operation=="invert" {for i 96 {next.frames[index].pixels[i]=1-next.frames[index].pixels[i];}}
    elif operation=="add" {push(next.frames,map{pixels:LED.frame(next.frames[index].pixels),duration_ms:next.frames[index].duration_ms});index=len(next.frames)-1;}
    elif operation=="delete" {
        if len(next.frames)==1 {throw "Keep at least one frame.";}
        let kept=[];for i len(next.frames) {if i!=index {push(kept,next.frames[i]);}}next.frames=kept;index=num_min(index,len(kept)-1);
    } elif operation=="previous" {index=num_max(0,index-1);}
    elif operation=="next" {index=num_min(len(next.frames)-1,index+1);}
    elif operation=="duration" {next.frames[index].duration_ms=value;}
    elif operation=="timing_all" {for item in next.frames {item.duration_ms=value;}}
    elif operation=="text" {next=LED.text_animation(value,100);index=0;}
    else {throw "Unknown studio action.";}
    next=LED.animation(next.frames);
    state.document=next;state.index=index;state.playing=false;state.source="frames";
    if operation=="text" or operation=="static_text" {state.text=value;}
    if operation=="import" {state.repeat_count=1;state.text="";state.export_requested=false;state.started=0;state.last_time=0;}
    state.status="Frame "+str(index+1)+" / "+str(len(next.frames))+" | "+str(next.frames[index].duration_ms)+" ms";
    return true;
}
// Resolve the elapsed frame on a candidate. Invalid actions must not advance
// selection, clocks or playback; native and Web callers share this transaction.
fn apply(state,operation,value=nil,now=nil) {
    let candidate=map{};for key in map_keys(state) {candidate[key]=state[key];}
    if now!=nil and operation!="import" and operation!="play" and operation!="counter_start" and operation!="counter_settings" {tick(candidate,now);}
    let clock=now;if clock==nil {clock=0;}
    _apply(candidate,operation,value,clock);
    for key in map_keys(candidate) {state[key]=candidate[key];}
    return true;
}
fn tick(state,now) {
    if not state.playing {return false;}
    if not LED.integer(now,state.last_time,9007199254740991) {state.playing=false;state.source="frames";state.status="Playback stopped: clock changed.";return true;}
    if state.source=="counter" {
        let item=Counter.sample(state.generator,now-state.started);let changed=state.counter_value!=item.value or item.finished;
        state.last_time=now;state.counter_value=item.value;
        if item.finished {state.playing=false;state.source="frames";state.status="Counter complete at "+Counter.label(item.value)+". Authored frames retained.";}
        return changed;
    }
    state.last_time=now;let elapsed=now-state.started;let end=0;let index=0;
    if elapsed>=state.document.total_ms*state.repeat_count {let changed=state.playing or state.index!=len(state.document.frames)-1;state.index=len(state.document.frames)-1;state.playing=false;state.status="Playback complete.";return changed;}
    elapsed=elapsed%state.document.total_ms;
    // The controller owns a validated document; do not copy 96 pixels per frame
    // on every idle clock tick. Scan at most 64 timing entries.
    while index<len(state.document.frames) {
        end=end+state.document.frames[index].duration_ms;
        if elapsed<end {break;}index=index+1;
    }
    let finished=index==len(state.document.frames);index=num_min(index,len(state.document.frames)-1);
    let changed=index!=state.index or finished;state.index=index;
    if finished {state.playing=false;state.status="Playback complete.";}
    return changed;
}
export create,current,preview,apply,tick,export_document,export_project;
