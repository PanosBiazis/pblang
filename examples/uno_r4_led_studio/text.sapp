// Static text is an explicit current-frame operation, independent of scrolling.
let LED=import("stdlib:uno_r4_led_matrix.sapp");let Font=import("stdlib:bitmap_font.sapp");
fn frame(text) {
    if type(text)!="string" or len(text)<1 or len(text)>2 {throw "Static text requires 1–2 supported glyphs to fit without cropping.";}
    let pixels=LED.blank();let left=num_floor((12-(len(text)*6-1))/2);
    for i len(text) {
        let code=strcharcodeat(text,i);let glyph=Font.glyph(code);
        if code==32 {glyph=[0,0,0,0,0,0,0];}
        if glyph==nil {throw "Unsupported static text glyph.";}
        for y 7 {for x 5 {pixels[y*12+left+i*6+x]=num_floor(glyph[y]/num_pow(2,4-x))%2;}}
    }
    return pixels;
}
export frame;
