// Script-free editor: bounded SVG playback and guarded JSON re-import.
let Doc=import("stdlib:ui_document.sapp");let Forms=import("stdlib:ui_form_web.sapp");
let Playback=import("./playback.sapp");let Import=import("./web_import.sapp");
let HTTP=import("stdlib:http_server.sapp");let HTML=import("stdlib:html.sapp");let Model=import("./model.sapp");
fn _widget(name,kind,props,parent="root") {return map{name:name,kind:kind,x:0,y:0,w:100,h:30,parent:parent,props:props};}
fn _action(holder,op,value=nil) {
    return fn(values) {
        let actual=value;if op=="text" {actual=values.text;}
        if op=="duration" {actual=try parse_number(values.duration) catch nil;}
        if op=="import" {actual=holder.pending_import;}
        let clock=num_floor(now_ms());
        // A malformed import leaves document, selection AND playback untouched.
        if op!="import" {Model.tick(holder.model,clock);}
        let ok=try Model.apply(holder.model,op,actual,clock) catch false;
        if not ok {holder.model.status="Cannot apply: check input, JSON format and limits.";}
        holder.changed=true;return holder.model.status;
    };
}
fn _build(holder) {
    let widgets=[_widget("pixels","panel",map{title:"12 × 8 · click an LED"})];let actions=map{};let pixels=Model.current(holder.model);
    for i 96 {
        let name="pixel_"+str(i);let label="·";if pixels[i]==1 {label="●";}
        push(widgets,_widget(name,"button",map{text:label},"pixels"));actions[name]=_action(holder,"pixel",i);
    }
    push(widgets,_widget("position","label",map{text:"Frame "+str(holder.model.index+1)+" / "+str(len(holder.model.document.frames))+" · "+str(holder.model.document.total_ms)+" ms total"}));
    push(widgets,_widget("text","textbox",map{value:holder.model.text,hint:"Text (1–8 supported glyphs)"}));
    push(widgets,_widget("duration","textbox",map{value:str(holder.model.document.frames[holder.model.index].duration_ms),hint:"Frame duration, 50–5000 ms"}));
    let labels=map{heart:"Heart",border:"Border",checker:"Checker",clear:"Clear",invert:"Invert",previous:"Previous",next:"Next",add:"Duplicate frame",delete:"Delete frame",text:"Create scrolling text",duration:"Set duration",play:"Play once",stop:"Stop",import:"Import JSON"};
    for name in ["heart","border","checker","clear","invert","previous","next","add","delete","text","duration","play","stop","import"] {
        let label=labels[name];
        let id="do_"+name;push(widgets,_widget(id,"button",map{text:label}));
        if name=="stop" {
            holder.stop_action="a_"+str(len(widgets));
            if holder.options!=nil and (try holder.options.hide_source_names catch true)==false {holder.stop_action=id;}
        }
        if name=="heart" or name=="border" or name=="checker" or name=="clear" {actions[id]=_action(holder,"preset",name);}
        else {actions[id]=_action(holder,name);}
    }
    push(widgets,_widget("status","label",map{text:holder.model.status}));
    push(widgets,_widget("limits","label",map{text:"Preview only. Play once ends automatically; Stop or edit to end playback. Text supports Latin, digits and a documented Greek/symbol subset. No board connection."}));
    let document=Doc.from_design(map{form:map{title:"UNO R4 LED Studio",w:600,h:800},model:map{},widgets:widgets});
    return Forms.create(document,actions,holder.port,holder.options);
}
fn _decorate(holder,response) {
    if response.status!=200 {return response;}
    response.body=str_join(str_split(response.body,"Adapted layout. Imported event handlers are inactive; buttons require explicit PBLang actions."),"Create frames for the UNO R4 WiFi LED matrix. Preview only.");
    response.body=str_join(str_split(response.body,"Local preview; no account isolation. Use synthetic data."),"Changes stay in this session until you export JSON.");
    let pixels=Model.current(holder.model);
    // Ordinals belong to this bounded document: panel first, then 96 buttons.
    for i 96 {
        let label="Pixel "+str(i%12+1)+", "+str(num_floor(i/12)+1)+": off";
        if pixels[i]==1 {label="Pixel "+str(i%12+1)+", "+str(num_floor(i/12)+1)+": on";}
        let id="a_"+str(i+2);if holder.options!=nil and (try holder.options.hide_source_names catch true)==false {id="pixel_"+str(i);}
        let needle="value=\""+id+"\"";
        response.body=str_join(str_split(response.body,needle),needle+" aria-label=\""+HTML.escape(label)+"\" title=\""+HTML.escape(label)+"\"");
    }
    let preview="";
    if holder.model.playing {
        let elapsed=num_max(0,num_min(holder.model.document.total_ms-1,num_floor(now_ms())-holder.model.started));
        let stop=holder.stop_action;
        preview=Playback.svg(holder.model.document,elapsed)+"<p class=\"motion-note\">Reduced motion is enabled: static frame preview. Use Stop to return to editing.</p><button form=\"led-editor\" type=\"submit\" name=\"action\" value=\""+stop+"\">Stop playback</button>";
        response.body=str_join(str_split(response.body,"<form "),preview+"<form id=\"led-editor\" ");
        // Avoid editing a stale static grid while the preview advances above it.
        response.body=str_join(str_split(response.body,"<fieldset"),"<fieldset disabled hidden");
    }
    response.body=str_join(str_split(response.body,"</form>"),"<label for=\"animation-import\">Paste exported JSON (max 128 KiB), then choose Import JSON<textarea id=\"animation-import\" name=\"animation\" maxlength=\"131072\" rows=\"4\" spellcheck=\"false\" autocomplete=\"off\"></textarea></label></form><p><a href=\"/frames.json\" download>Download validated JSON</a></p>");
    return response;
}
fn create(port=8768,options=nil) {
    let holder=map{model:Model.create(),port:port,options:options,app:nil,changed:false,closed:false,window:0,requests:0,limited:true,pending_import:nil,stop_action:""};holder.app=_build(holder);
    if options!=nil {holder.limited=try options.discourage_scraping catch true;}
    let handle=fn(req) {
        let window=num_floor(now_ms()/60000);
        if holder.window!=window {holder.window=window;holder.requests=0;}
        let download=req.method=="GET" and req.path=="/frames.json";
        let request=req;
        if download or (holder.limited and holder.requests>=120) {request=map{method:"GET",path:"/",headers:req.headers,body:""};}
        if holder.limited and holder.requests>=120 {
            let limited=holder.app.handle(request);
            if limited.status==200 {limited.status=429;limited.body="Request budget reached. Try later.";limited.headers["Retry-After"]="60";}
            return limited;
        }
        holder.requests=holder.requests+1;
        holder.changed=false;
        if req.method=="POST" and req.path=="/action" {
            let separated=try Import.split_body(req.body) catch nil;
            if separated==nil {
                let guarded=holder.app.handle(map{method:"GET",path:"/",headers:req.headers,body:""});
                if guarded.status==200 {guarded.status=400;guarded.body="Invalid or oversized import form. Existing animation retained.";}
                return guarded;
            }
            holder.pending_import=separated.payload;
            request=map{method:req.method,path:req.path,headers:req.headers,body:separated.body};
        }
        let response=holder.app.handle(request);holder.pending_import=nil;
        if response.status==200 and req.method=="GET" and req.path=="/" {
            if Model.tick(holder.model,num_floor(now_ms())) {holder.changed=true;}
        }
        if download and response.status==200 {
            response.body=Model.export_document(holder.model);response.content_type="application/json; charset=utf-8";
            response.headers["Content-Disposition"]="attachment; filename=uno-r4-frames.json";return response;
        }
        if holder.closed {return response;}
        if response.status==200 and req.path=="/style.css" {
            response.body=response.body+"\nfieldset[hidden]{display:none}.motion-note{display:none}@media(prefers-reduced-motion:reduce){.motion-note{display:block}#led-playback g{visibility:hidden!important}#led-playback g:first-of-type{visibility:visible!important}#led-playback>text{display:none}}#led-playback{display:block;width:100%;max-width:36rem;margin:1rem auto}textarea{width:100%;box-sizing:border-box;background:#121a28;color:#fff;font:inherit}main{max-width:44rem}form{grid-template-columns:repeat(2,minmax(0,1fr))}fieldset,p,label,output{grid-column:1/-1}fieldset:first-of-type{grid-template-columns:repeat(12,minmax(0,1fr));gap:4px;background:#151b29}fieldset:first-of-type legend{color:#f26979;background:#151b29;padding:.4rem;border-radius:.4rem}fieldset:first-of-type button{padding:0;min-height:24px;aspect-ratio:1;color:#ff596d;background:#242e40;font-size:clamp(16px,3.5vw,30px);border-color:#52617c}fieldset:first-of-type button:focus-visible{outline-color:#ffb9c3}output{font-family:monospace}body{background:#101724;color:#e9eef5}form{background:#1c2536}input{background:#121a28;color:#fff}button{background:#345285}a{color:#b9d5ff}p.note{color:#b7c7d8}fieldset:first-of-type legend{font-size:1rem}@media(max-width:480px){main{padding:12px}form{padding:12px}fieldset:first-of-type{padding:8px;gap:2px}}";
            return response;
        }
        if holder.changed and response.status==200 {
            holder.app.close();holder.app=_build(holder);
            let page=map{method:"GET",path:"/",headers:req.headers,body:""};response=holder.app.handle(page);
        }
        if response.status==200 and (req.path=="/" or req.path=="/action") {return _decorate(holder,response);}
        return response;
    };
    return map{handle:handle,close:fn(){holder.closed=true;holder.pending_import=nil;holder.model.playing=false;return holder.app.close();},state:holder.model,port:port};
}
fn serve(port=8768,max_connections=nil) {
    let app=create(port);let failed=false;
    try HTTP.serve_forever_timeout("127.0.0.1:"+str(port),app.handle,map{request_timeout_ms:5000,write_timeout_ms:1000,accept_poll_ms:1,max_inflight:1,max_header_bytes:8192,max_body_bytes:Import.MAX_BODY,max_response_bytes:1048576,max_connections:max_connections}) catch {failed=true;};
    app.close();if failed {throw "LED Studio loopback preview could not run.";}
}
export create,serve;
