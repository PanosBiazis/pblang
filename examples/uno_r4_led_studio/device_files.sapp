// Bounded local files and exclusive sketch publication; no compiler process/upload.
let Dir=import("stdlib:linux_dirfs.sapp");let X=import("./exchange.sapp");let Device=import("./device_export.sapp");
fn location(path) {
    if type(path)!="string" or not str_starts_with(path,"/") or len(path)>4096
        or str_contains(path,"\\") or str_contains(path,strfromcharcode(0)) {throw "Expected an absolute local path.";}
    let parts=str_split(path,"/");let name=parts[len(parts)-1];let parent="";
    if len(parts)<3 or name=="" or name=="." or name==".." {throw "Expected a file or new folder below a local directory.";}
    for i len(parts)-1 {if i>0 {if parts[i]=="" or parts[i]=="." or parts[i]==".." {throw "Ambiguous path.";}parent=parent+"/"+parts[i];}}
    return map{parent:parent,name:name};
}
fn read(path,limit) {
    let at=location(path);let fs=Dir.open_absolute(at.parent,false,false);if not fs.ok {throw "Input directory unavailable.";}
    let value=try Dir.read_bytes(fs,at.name,limit) catch map{ok:false};let closed=Dir.close(fs);
    if not value.ok or not closed {throw "Bounded input read failed.";}return bytes_to_str(value.bytes);
}
fn project(path,repetitions=1) {return Device.plan(X.decode_project(read(path,X.MAX_BYTES)).document,repetitions);}
fn write_sketch(fs,at,p,result,adapter,state) {
    state.error="New private output directory required.";
    let made=Dir.mkdir_new(fs,at.name,false);if not made.ok or not made.permission_private {throw state.error;}
    state.error="Sketch write failed; partial private output retained.";
    let files=map{"pblang_firmware.h":result.c_source,"firmware.sapp":result.pblang_source,
        "plan.json":json_stringify(p),"build.json":json_stringify(map{backend:result.backend,
            native_ra4m1_backend:false,fqbn:"arduino:renesas_uno:unor4wifi",source_sha256:result.source_sha256,
            c_sha256:result.c_sha256,adapter_sha256:sha256(adapter),project_digest:p.digest})};
    files[at.name+".ino"]=adapter;
    for name in map_keys(files) {
        let written=Dir.write_new_exclusive(fs,at.name+"/"+name,str_to_bytes(files[name]),false);
        if not written.ok {throw state.error;}
    }
    state.error="";return true;
}
fn publish(input,output,repetitions=1) {
    let p=project(input,repetitions);let at=location(output);
    if not regex_match(at.name,"^[A-Za-z][A-Za-z0-9_]{0,63}$") {throw "Sketch folder needs a simple Arduino identifier.";}
    // Run this entry point from the retained PBLang package root.
    let result=Device.lower(p,fs_read("examples/uno_r4_led_studio/device_firmware.sapp"));
    let adapter=fs_read("examples/uno_r4_led_studio/device_adapter.ino");
    let fs=Dir.open_absolute(at.parent,false,false);if not fs.ok {throw "Output parent unavailable.";}
    let state=map{error:""};let published=try write_sketch(fs,at,p,result,adapter,state) catch false;
    let closed=Dir.close(fs);if not published {throw state.error;}if not closed {throw "Output directory close failed.";}
    return map{ok:true,output:output,project_digest:p.digest,frames:len(p.rows),repetitions:p.repetitions,
        total_ms:p.total_ms,backend:result.backend,source_sha256:result.source_sha256,c_sha256:result.c_sha256,
        compiled_for_board:false,uploaded:false};
}
export read,project,publish;
