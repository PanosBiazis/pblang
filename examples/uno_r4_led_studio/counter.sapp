// Local elapsed-time generator. No authored frame list, device or sensor feed.
let LED=import("stdlib:uno_r4_led_matrix.sapp");let Text=import("./text.sapp");
fn validate(value) {
    if type(value)!="map" or len(map_keys(value))!=4 {throw "Counter settings require kind, start, end and interval_ms.";}
    for key in ["kind","start","end","interval_ms"] {if not map_has(value,key) {throw "Missing counter setting.";}}
    if value.kind!="counter" or not LED.integer(value.start,0,99) or not LED.integer(value.end,0,99)
    or not LED.integer(value.interval_ms,1000,10000) or value.interval_ms%1000!=0 {throw "Counter: values 0–99, interval 1–10 whole seconds.";}
    let count=num_abs(value.end-value.start)+1;
    if count>30 or count*value.interval_ms>60000 {throw "Counter preview is limited to 30 values and 60 seconds.";}
    return map{kind:"counter",start:value.start,end:value.end,interval_ms:value.interval_ms};
}
fn duration(config) {let c=validate(config);return (num_abs(c.end-c.start)+1)*c.interval_ms;}
fn sample(config,elapsed) {
    let c=validate(config);if not LED.integer(elapsed,0,9007199254740991) {throw "Invalid counter elapsed time.";}
    let count=num_abs(c.end-c.start)+1;let step=num_min(count-1,num_floor(elapsed/c.interval_ms));
    let direction=1;if c.end<c.start {direction=-1;}
    return map{value:c.start+step*direction,finished:elapsed>=count*c.interval_ms};
}
fn label(value) {if not LED.integer(value,0,99) {throw "Invalid counter value.";}let text=str(value);if value<10 {text="0"+text;}return text;}
fn frame(value) {return Text.frame(label(value));}
fn svg(value) {
    let pixels=frame(value);let unlit=[];let lit=[];
    for p 96 {let path="M"+str((p%12)*10+1)+" "+str(num_floor(p/12)*10+1)+"h8v8h-8z";push(unlit,path);if pixels[p]==1 {push(lit,path);}}
    return "<svg id=\"led-counter\" viewBox=\"0 0 120 94\" role=\"img\" aria-label=\"Local timed counter: "+label(value)+"\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"120\" height=\"94\" fill=\"#151b29\"/><path fill=\"#462027\" d=\""+str_join(unlit," ")+"\"/><path fill=\"#ff596d\" d=\""+str_join(lit," ")+"\"/><text x=\"4\" y=\"89\" fill=\"#e9eef5\" font-size=\"6\">Counter "+label(value)+"</text></svg>";
}
export validate,duration,sample,label,frame,svg;
