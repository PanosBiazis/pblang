// Validated project export through the PBLang numeric C compiler; no device I/O.
let LED=import("stdlib:uno_r4_led_matrix.sapp");let Timing=import("./timing.sapp");
let FORMAT="pblang.uno-r4-led-device-plan.v1";
fn plan(document,repetitions=1) {
    let doc=LED.validate(document);let repeats=Timing.repetitions(doc,repetitions);
    let content=map{format:FORMAT,board:"arduino-uno-r4-wifi",document:doc,repetitions:repeats};
    return map{format:FORMAT,board:content.board,document:doc,repetitions:repeats,
        rows:LED.arduino_sequence(doc),total_ms:doc.total_ms*repeats,digest:sha256(json_stringify(content))};
}
fn validate(value) {
    if type(value)!="map" or len(map_keys(value))!=7 {throw "Invalid device plan.";}
    let clean=plan(value.document,value.repetitions);
    if json_stringify(clean)!=json_stringify(value) {throw "Device plan content or digest mismatch.";}
    return clean;
}
let C=import("stdlib:compiler/ctranspile.sapp");
// Generate numeric PBLang accessors; firmware uses no heap strings.
let LITERALS=["{\"protocol\":\"PBLED1\",\"board\":\"UNO_R4_WIFI\",\"digest\":\"", "\",\"command\":\"", "\",\"request\":\"", "\",\"ok\":", ",\"error\":\"", "\",\"state\":\"", "\",\"frame\":", ",\"remaining_ms\":", ",\"frames\":", ",\"repetitions\":", ",\"total_ms\":", "}\n", "true", "false", "", "", "", "", "", "", "idle", "running", "done", "error", "", "", "", "", "", "", "HELLO", "PLAY", "STOP", "STATUS", "ERROR", "", "", "", "", "", "", "input", "command", "matrix", "request-reused"];
fn literals_source() {
    let lengths="fn literal_length(id) {";let bytes="fn literal_byte(id,index) {";
    for i len(LITERALS) {
        lengths=lengths+"if id=="+str(i)+" {return "+str(len(LITERALS[i]))+";}";
        bytes=bytes+"if id=="+str(i)+" {";
        for j len(LITERALS[i]) {bytes=bytes+"if index=="+str(j)+" {return "+str(strcharcodeat(LITERALS[i],j))+";}";}
        bytes=bytes+"}";
    }
    return lengths+"return 0;}\n"+bytes+"return 0;}\n";
}
fn source(value,firmware) {
    let p=validate(value);
    if type(firmware)!="string" or len(firmware)>32768 {throw "Invalid bounded PBLang firmware source.";}
    let generated="fn project_frame_count() {return "+str(len(p.rows))+";}\n"
        +"fn project_repetitions() {return "+str(p.repetitions)+";}\n"
        +"fn project_pass_ms() {return "+str(p.document.total_ms)+";}\n"
        +"fn project_total_ms() {return "+str(p.total_ms)+";}\nfn project_word(frame,word) {\n";
    for i len(p.rows) {generated=generated+"if frame=="+str(i)+" {";for j 4 {generated=generated+"if word=="+str(j)+" {return "+str(p.rows[i][j])+";}";}generated=generated+"}\n";}
    generated=generated+"return 0;}\nfn project_digest_byte(index) {";
    for i 64 {generated=generated+"if index=="+str(i)+" {return "+str(strcharcodeat(p.digest,i))+";}";}
    return firmware+"\n"+generated+"return 0;}\n"+literals_source();
}
fn lower(value,firmware) {
    let combined=source(value,firmware);let code=C.transpile(combined);
    return map{plan:validate(value),pblang_source:combined,c_source:code,source_sha256:sha256(combined),c_sha256:sha256(code),backend:"pblang-numeric-c",native_ra4m1_backend:false};
}
export FORMAT,plan,validate,source,lower;
