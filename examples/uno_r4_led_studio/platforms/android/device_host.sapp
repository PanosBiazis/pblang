// Explicit Linux host for Web/Android controls of an already uploaded UNO project.
let Files=import("../../device_files.sapp");
let Control=import("../../device_control.sapp");
let Web=import("../../web.sapp");
let App=import("./config.sapp");
let raw=try env_get("PBLANG_SCRIPT_ARGS") catch "";
let args=[];if type(raw)=="string" and raw!="" {args=str_split(raw,"\n");}
if len(args)!=4 or args[3]!="--confirm-uno-r4-wifi" or not regex_match(args[2],"^[1-8]$") {
    throw "Expected ABS_PROJECT_JSON /dev/ttyACM<N> REPEATS --confirm-uno-r4-wifi";
}
let plan=Files.project(args[0],parse_number(args[2]));
let control=Control.create(plan,args[1],true);
print "LED Studio device controls: http://127.0.0.1:"+str(App.PORT)+"/ (no automatic playback)";
Web.serve(App.PORT,nil,control,Files.read(args[0],131072));
