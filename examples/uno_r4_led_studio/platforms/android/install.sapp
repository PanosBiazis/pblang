// Explicitly install/open on one selected Android device; never start hardware playback.
let ADB=import("stdlib:android_adb.sapp");
let App=import("./config.sapp");
fn checked(result,label){if not result.ok {throw ADB.result_error(result,label);}return result;}
let adb=ADB.discover_adb();
if adb==nil {throw "adb is unavailable";}
let listed=checked(ADB.run_bounded(adb,["devices","-l"],10),"Device discovery");
let requested=try env_get("PBLANG_ANDROID_SERIAL") catch "";
let selected=ADB.select_device(ADB.parse_devices(listed.stdout),requested);
if not selected.ok {throw selected.error;}
let serial=selected.device.serial;
let apk=App.options().output;
if not fs_exists(apk){throw "Build LED Studio Android before installing.";}
checked(ADB.install_apk(adb,serial,apk,App.PACKAGE,28),"APK install");
let port="tcp:"+str(App.PORT);
checked(ADB.run_bounded(adb,["-s",serial,"reverse",port,port],10),"USB loopback connection");
checked(ADB.run_bounded(adb,["-s",serial,"shell","am","start","-W","-n",App.PACKAGE+"/.MainActivity"],20),"Open LED Studio");
print "LED Studio opened. Keep the host server running on port "+str(App.PORT)+".";
