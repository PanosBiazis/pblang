// Installable Android companion. The editor runs in the paired host's PBLang process.
let WebView=import("stdlib:android_webview.sapp");
let App=import("./config.sapp");
let result=WebView.build(App.name(),App.options());
if not result.ok {throw "LED Studio Android build failed: "+result.stage+": "+result.error;}
print "apk="+result.output;
print "sha256="+result.sha256;
