// No remote host, serial identifier or user content belongs in this package.
fn name(){return "UNO R4 LED Studio";}
let PACKAGE="org.pblang.unor4ledstudio";
let PORT=18774;
fn options(){
    return map{package:PACKAGE,min_sdk:21,target_sdk:34,
        version:"0.1.0",version_code:1,javascript:false,
        url:"http://127.0.0.1:"+str(PORT)+"/",
        output:"build/uno-r4-led-studio/android/UNO-R4-LED-Studio-debug.apk"};
}
export name,PACKAGE,PORT,options;
