//
// examples/uno_r4_led_studio/platforms/desktop/launch.sapp — Cross-Platform Pure-PBLang Desktop Launcher
//
// Replaces launch.sh, launch.command, and launch.ps1. Validates an explicit absolute native
// PBLang runtime path and verifies the complete UNO R4 LED Studio source package before running.

let Path = import("stdlib:path.sapp");

fn _collect_args() {
    let raw_env = env_get("PBLANG_SCRIPT_ARGS");
    if raw_env != nil and raw_env != "" {
        let parts = str_split(raw_env, "\n");
        let env_out = [];
        let k = 0;
        while k < len(parts) {
            if parts[k] != "" { array_push(env_out, parts[k]); }
            k = k + 1;
        }
        return env_out;
    }
    let argv = try os_args() catch [];
    if not is_array(argv) { return []; }
    let n = len(argv);
    let i = 0;
    let found = false;
    while i < n {
        let a = str(argv[i]);
        i = i + 1;
        if str_ends_with(a, ".sapp") or str_ends_with(a, ".pbck") { found = true; break; }
    }
    if not found { return []; }
    while i < n {
        let a2 = str(argv[i]);
        if a2 == "--" { i = i + 1; break; }
        if not str_starts_with(a2, "-") { break; }
        i = i + 1;
    }
    let out = [];
    while i < n {
        array_push(out, str(argv[i]));
        i = i + 1;
    }
    return out;
}

fn _is_abs_path(p: string) {
    if str_starts_with(p, "/") { return true; }
    if len(p) >= 3 and strcharcodeat(p, 1) == 58 and (strcharcodeat(p, 2) == 92 or strcharcodeat(p, 2) == 47) {
        return true;
    }
    return false;
}

fn _is_regular_file(p: string) {
    if (try fs_exists(p) catch false) != true { return false; }
    let ls = try fs_listdir(p) catch nil;
    if is_array(ls) { return false; }
    return true;
}

fn _locate_repo_root() {
    let cur = cwd();
    if _is_regular_file(cur + "/stdlib/graphics.sapp") and _is_regular_file(cur + "/examples/uno_r4_led_studio/view.sapp") {
        return cur;
    }
    let up = Path.normalize(cur + "/../../../..");
    if _is_regular_file(up + "/stdlib/graphics.sapp") and _is_regular_file(up + "/examples/uno_r4_led_studio/view.sapp") {
        return up;
    }
    return cur;
}

let args = _collect_args();
let runtime = "";
if len(args) == 1 {
    runtime = args[0];
} elif len(args) == 2 and (args[0] == "--runtime" or args[0] == "-Runtime") {
    runtime = args[1];
} else {
    eprint("Usage: ./pblang run examples/uno_r4_led_studio/platforms/desktop/launch.sapp --allow-all -- /absolute/path/to/pblang\n");
    os_exit(64);
}

if not _is_abs_path(runtime) {
    eprint("Supply an absolute path to the PBLang executable.\n");
    os_exit(64);
}
if not _is_regular_file(runtime) {
    eprint("The selected PBLang runtime is not an executable file.\n");
    os_exit(66);
}
if env_get("OS") == "Windows_NT" and not str_ends_with(str_lower(runtime), ".exe") {
    eprint("Select a compatible native PBLang .exe file.\n");
    os_exit(66);
}

let ver_probe = try proc_spawn_wait(runtime, ["--version"]) catch map{ exit_code: 126 };
if ver_probe.exit_code != 0 {
    eprint("The selected PBLang runtime is not an executable file.\n");
    os_exit(66);
}

let repo_root = _locate_repo_root();
if not _is_regular_file(repo_root + "/stdlib/graphics.sapp") or not _is_regular_file(repo_root + "/examples/uno_r4_led_studio/view.sapp") {
    eprint("Keep this launcher inside the complete PBLang source package.\n");
    os_exit(66);
}

let target_entry = "examples/uno_r4_led_studio/platforms/desktop/main.sapp";
let res = if env_get("OS") != "Windows_NT" and fs_exists("/usr/bin/env") and Path.normalize(cwd()) != Path.normalize(repo_root) {
    proc_spawn_wait("/usr/bin/env", ["-C", repo_root, runtime, "run", target_entry, "--allow-all"])
} else {
    proc_spawn_wait(runtime, ["run", target_entry, "--allow-all"])
};
if res.stdout != "" { print(res.stdout); }
if res.stderr != "" { eprint(res.stderr); }
os_exit(res.exit_code);
