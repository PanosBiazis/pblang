// Declarative, one-pass browser animation. No script, polling or repeat timer.
let LED=import("stdlib:uno_r4_led_matrix.sapp");
fn svg(document,elapsed=0) {
    let doc=LED.validate(document);
    if not LED.integer(elapsed,0,doc.total_ms) {throw "Invalid preview time.";}
    let parts=["<svg id=\"led-playback\" viewBox=\"0 0 120 100\" role=\"img\" aria-label=\"One-pass LED animation; use Stop to return to editing\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"120\" height=\"100\" fill=\"#151b29\"/>"];
    let start=0;
    for i len(doc.frames) {
        let item=doc.frames[i];let end=start+item.duration_ms;
        if end>elapsed {
            let path=[];
            for p 96 {if item.pixels[p]==1 {push(path,"M"+str((p%12)*10+1)+" "+str(num_floor(p/12)*10+1)+"h8v8h-8z");}}
            let begin=num_max(0,start-elapsed);let duration=end-num_max(start,elapsed);
            let fill="remove";if i==len(doc.frames)-1 {fill="freeze";}
            push(parts,"<g data-frame=\""+str(i+1)+"\" visibility=\"hidden\"><path fill=\"#ff596d\" d=\""+str_join(path," ")+"\"/><text x=\"4\" y=\"88\" fill=\"#e9eef5\" font-size=\"6\">Frame "+str(i+1)+" / "+str(len(doc.frames))+"</text><set attributeName=\"visibility\" to=\"visible\" begin=\""+str(begin)+"ms\" dur=\""+str(duration)+"ms\" fill=\""+fill+"\"/></g>");
        }
        start=end;
    }
    push(parts,"<text x=\"4\" y=\"97\" fill=\"#e9eef5\" font-size=\"5\" visibility=\"hidden\">Playback complete<set attributeName=\"visibility\" to=\"visible\" begin=\""+str(doc.total_ms-elapsed)+"ms\" dur=\"1ms\" fill=\"freeze\"/></text></svg>");
    return str_join(parts,"");
}
export svg;
