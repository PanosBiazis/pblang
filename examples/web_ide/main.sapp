// examples/web_ide/main.sapp — Web IDE demo
//
// Demonstrates importing and using the stdlib/ide.sapp module
// to create a web-based code editor.
//
// Run with: pblang run examples/web_ide/main.sapp

let ide = import("stdlib:ide.sapp");

print "╔══════════════════════════════════════════════╗";
print "║   pblang Web IDE — Demo                     ║";
print "╚══════════════════════════════════════════════╝";
print "";

// Start the IDE on port 8090
let result = ide.start(8090);

print "";
print "Status: " + if result.ok { "OK" } else { "FAILED" };
print "Port: " + str(result.port);
print "URL: " + result.url;
print "";
print "Alternatively, write the IDE page to a file:";
print "  ide.write_to_file(\"my_ide.html\");";
print "";

// Optionally write the IDE HTML to a file for standalone use
let written = ide.write_to_file("web_ide_standalone.html");
print "Standalone HTML written to: " + written.path + " (" + str(written.size) + " bytes)";
