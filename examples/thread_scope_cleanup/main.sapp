let T = import("stdlib:thread.sapp");
let results = T.scope(fn(sc) {
    T.scope_launch(sc,fn(){return 10;});
    T.scope_launch(sc,fn(){return 20;});
});
assert(results==[10,20],"launch-order results");
let done=channel_buffered(1);
fn body(sc) {
    T.scope_launch(sc,fn(){sleep_ms(20);send(done.sender,true);});
    throw "example body failure";
}
let failed=try {T.scope(body);false} catch true;
assert(failed and recv_timeout(done.receiver,0)==true,"worker joined before body failure reported");
channel_close(done.sender);
print "thread_scope_cleanup_pass";
