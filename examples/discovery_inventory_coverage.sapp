// Synthetic observations only: this example never scans a device.
let Progress = import("stdlib:project_discovery_progress.sapp");
fn observation(names, state, source="direct") {
    return map{names:names, observation:map{source:source, state:state, depth:0}};
}
let claims = [
    observation(["Cargo.toml", "Cargo.toml"], "completed"),
    observation(["Cargo.toml", "pblang.toml"], "truncated"),
    observation(["package.json"], "timeout", "index"),
    observation([], "unavailable"),
    observation([], "excluded"),
    observation([], "error")
];
let before = json_stringify(claims);
let report = Progress.describe(claims);
assert(report.ok and report.root_count==6, "six synthetic root claims");
for state in ["completed", "truncated", "timeout", "unavailable", "excluded", "error"] {
    assert(report.state_counts[state]==1, "each state remains visible");
}
assert(report.input_count==5 and report.unique_name_count_sum==4, "deduplication stays within each root");
assert(report.family_counts.cargo==2 and report.recognized_marker_count==4, "observations are not distinct projects");
assert(report.source_counts.direct==5 and report.source_counts.index==1, "index remains distinct from direct input");
assert(not report.coverage_verified and not report.absence_verified
    and not report.index_freshness_verified and not report.root_identity_verified,
    "caller claims do not verify coverage, identity or freshness");
assert(not report.contains_names and not report.contains_paths and not report.safe_to_log,
    "name-free aggregates still need a disclosure decision");
let contradiction = Progress.describe([
    observation(["pblang.toml"], "completed"),
    observation(["Cargo.toml"], "excluded")
]);
assert(not contradiction.ok and contradiction.root_count==0
    and contradiction.input_count==0 and contradiction.recognized_marker_count==0,
    "invalid later claim rejects the entire batch without partial counts");
assert(json_stringify(claims)==before, "original input remains unchanged");
print json_stringify(map{synthetic:true, report:report,
    contradictory_batch_rejected:not contradiction.ok,
    interpretation:"marker observations, not unique projects or complete drive coverage"});
