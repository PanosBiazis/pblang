// Optional automatic scalar-owner cleanup on retained and PBLang bytecode VMs.
let M=import("stdlib:memory.sapp");
let Owned=import("stdlib:memory_owned.sapp");
let baseline=M.stats().total_locations;
let result=Owned.with_box(40,fn(handle){
    M.write(handle,42);
    M.borrow(handle);
    return M.read(handle);
});
print result;
print M.stats().total_locations-baseline;
