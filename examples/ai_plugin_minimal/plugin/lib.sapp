// Minimal AI plugin example — normalized request/response envelope, stub implementation.
// Contract: plugin_info, capabilities, build_request, invoke (see AI_plugin_pattern.md).

fn plugin_info() {
    return map{ name: "ai_plugin_minimal", version: "0.1.0" };
}

fn capabilities() {
    return map{ chat: true };
}

fn build_request(prompt, opts) {
    return map{ provider: opts.provider, model: opts.model, options: map{ max_tokens: opts.max_tokens } };
}

fn invoke(prompt, opts) {
    let req = build_request(prompt, opts);
    let resp = map{ message: "stubbed by example bridge" };
    return map{ request: req, response: resp };
}

export plugin_info, capabilities, build_request, invoke;
