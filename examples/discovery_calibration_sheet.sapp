let C=import("stdlib:calibration_sheet.sapp");
let points=[map{input:0,output:0},map{input:10,output:20},map{input:20,output:30}];
let model=C.make(points,"raw","units");let saved=json_stringify(model);
assert(C.estimate(model,[0,5,10,15,20])==[0,10,20,25,30],"piecewise interpolation and exact references");
let report=C.review(model,[map{id:"low",input:5,expected:11},map{id:"high",input:15,expected:23}]);
assert(report.rows[0].residual==-1 and report.rows[1].residual==2,"signed residual = estimate minus expected");
assert(report.mean_abs_residual==1.5 and num_abs(report.rmse-num_sqrt(2.5))<0.000000001,"residual summary");
assert((try C.estimate(model,[-1]) catch nil)==nil and (try C.estimate(model,[21]) catch nil)==nil,"no extrapolation on either side");
let restored=json_parse(saved);assert(C.validate(restored) and C.estimate(restored,[5])==[10],"JSON roundtrip");
assert(json_stringify(model)==saved and not report.reference_points_included and not report.raw_checks_included,"original points preserved; report omits raw inputs");
print json_stringify(report);
