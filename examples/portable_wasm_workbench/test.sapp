let WASM = import("stdlib:wasm_module.sapp");
let Workbench = import("examples/portable_wasm_workbench/wasm_workbench.sapp");
let App = import("examples/portable_wasm_workbench/app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "portable WASM workbench test failed: " + message; }
}

fn rejected(callable) { return (try { callable(); false } catch true); }

fn record(bundle, name) {
    for item in bundle.records { if item.name == name { return item; } }
    return nil;
}

let data = Workbench.run();
require(data.value == 42 and data.modeled_value == 42 and data.cross_checked,
    "migrated addition must return and independently model 42");
require(data.envelope_valid and data.has_main_function and data.wasm_bytes > 8,
    "generated WebAssembly artifact must have a bounded envelope and main export");
require(data.original_source_sha256 == Workbench.MIGRATED_SOURCE_SHA256,
    "source provenance must be content-addressed");
require(not data.foreign_compiler_used and not data.generated_server_used
    and not data.network_access and not data.filesystem_access,
    "normal execution must require no C compiler, server, network or filesystem");
require(rejected(fn() { Workbench.run(2147483647, 1); }),
    "overflow must fail before compilation");

let tree = App.view(data);
require(UI.validate(tree).ok, "shared UI tree must validate");
let web = UI.compile(tree, map{ target: "web", width: 320, height: 640 });
let native = UI.compile(tree, map{ target: "native", width: 1440, height: 900 });
let android = UI.compile(tree, map{ target: "android", width: 360, height: 720 });
for bundle in [web, native, android] {
    require(record(bundle, "brand") != nil, "brand must render on every target");
    require(record(bundle, "result") != nil, "result must render on every target");
    require(record(bundle, "rerun") != nil, "run action must render on every target");
    require(record(bundle, "validation_boundary") != nil,
        "honest validation boundary must render on every target");
}

let preview = UI.preview_web("Portable WASM Workbench", tree, App.web_options());
require(preview.response.status == 200, "Web preview must return HTTP 200");
require(str_contains(preview.generated.html, "viewport-fit=cover")
    and str_contains(preview.generated.css, "@media(max-width:640px)"),
    "Web preview must respond to compact screens");
require(str_index_of(preview.generated.html, "<script src=\"http") < 0
    and str_index_of(preview.generated.html, "<link href=\"http") < 0
    and str_index_of(preview.generated.css, "url(http") < 0,
    "generated Web output must not depend on remote assets");

let direct = WASM.compile("fn add(a, b) { return a + b; } fn main() { return add(9, 8); }");
require(direct.metadata.has_main_function and direct.metadata.envelope_valid,
    "public WASM facade must compile and inspect direct PBLang source");

for source_path in [
    "stdlib/wasm_module.sapp",
    "examples/portable_wasm_workbench/wasm_workbench.sapp",
    "examples/portable_wasm_workbench/app.sapp",
    "examples/portable_wasm_workbench/main.sapp",
    "examples/portable_wasm_workbench/benchmark.sapp",
    "examples/portable_wasm_workbench/test.sapp"
] {
    let analysis = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(analysis.ok and analysis.passed and not analysis.truncated and analysis.high == 0,
        "bounded security analysis must pass for " + source_path);
}

print "portable_wasm_workbench_pass";
