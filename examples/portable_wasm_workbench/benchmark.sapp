let Workbench = import("examples/portable_wasm_workbench/wasm_workbench.sapp");

let checksum = 0;
let total_bytes = 0;
let i = 0;
while i < 96 {
    let report = Workbench.run(i - 48, 96 - i);
    checksum = checksum + report.value;
    total_bytes = total_bytes + report.wasm_bytes;
    i = i + 1;
}
if checksum != 4608 or total_bytes <= 0 { throw "portable WASM benchmark failed"; }
print json_stringify(map{
    format: "pblang.example.portable-wasm-benchmark.v1",
    modules: 96, checksum: checksum, total_bytes: total_bytes,
    foreign_compiler_used: false, verified: true
});
