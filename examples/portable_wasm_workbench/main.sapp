let App = import("examples/portable_wasm_workbench/app.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn main() {
    let data = App.model();
    let native = UI.compile(App.view(data), map{ target: "native", width: 1280, height: 800 });
    let result = map{
        format: data.format, value: data.value, modeled_value: data.modeled_value,
        wasm_bytes: data.wasm_bytes, sections: len(data.sections),
        has_main_function: data.has_main_function,
        ui_records: len(native.records), verified: data.cross_checked
            and data.envelope_valid and data.has_main_function and len(native.records) > 0
    };
    print json_stringify(result);
    return result.verified;
}

main();
