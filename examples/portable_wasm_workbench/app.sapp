let Workbench = import("examples/portable_wasm_workbench/wasm_workbench.sapp");
let UI = import("stdlib:modern_ui.sapp");

fn model(left = 20, right = 22) { return Workbench.run(left, right); }

fn view(data) {
    let section_cards = [];
    for section in data.sections {
        array_push(section_cards, UI.card([
            UI.heading(section.name, map{ name: "section_" + str(section.id) + "_title" }),
            UI.text(str(section.payload_bytes) + " payload bytes", map{
                name: "section_" + str(section.id) + "_size"
            })
        ], map{ name: "section_" + str(section.id) }));
    }
    let expression = str(data.left) + " + " + str(data.right) + " = " + str(data.value);
    return UI.screen([
        UI.heading("Portable WASM Workbench", map{
            name: "brand", accessibility_label: "Portable WebAssembly Workbench"
        }),
        UI.text(expression, map{
            name: "result", accessibility_label: "Verified addition result"
        }),
        UI.row([
            UI.card([
                UI.heading("Generated module", map{ name: "module_title" }),
                UI.text(str(data.wasm_bytes) + " bytes", map{ name: "module_size" }),
                UI.text(str(len(data.sections)) + " sections", map{ name: "section_count" })
            ], map{ name: "module_summary" }),
            UI.card([
                UI.heading("Verification", map{ name: "verification_title" }),
                UI.text("PBLang model and WASM source agree", map{ name: "verification_state" }),
                UI.text("main export present", map{ name: "main_export_state" })
            ], map{ name: "verification_summary" })
        ], map{ name: "summary_row", responsive: true, gap: 12 }),
        UI.button("Re-run sample", UI.action_set_text("result", expression), map{
            name: "rerun", accessibility_label: "Run the verified sample again"
        }),
        UI.grid(section_cards, map{ name: "section_grid", columns: 3, gap: 12 }),
        UI.text("Independent engine validation remains a release test boundary.", map{
            name: "validation_boundary", accessibility_label: "Validation boundary"
        })
    ], map{ name: "portable_wasm_root", gap: 16 });
}

fn web_options() {
    return map{
        theme: "light", lang: "en", host: "127.0.0.1", port: 8080,
        width: 1180, height: 820,
        palette: map{
            accent: [0, 112, 121], selected: [191, 54, 12], focus: [0, 88, 168]
        }
    };
}

export model, view, web_options;
