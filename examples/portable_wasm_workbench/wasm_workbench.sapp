let WASM = import("stdlib:wasm_module.sapp");

let FORMAT = "pblang.example.portable-wasm-workbench.v1";
let MIGRATED_SOURCE_SHA256 = "ba024cfe6f202fb905c4172a8bf9d202340036abfdb1d80b44ecdc682c8e4e13";

fn run(left = 20, right = 22) {
    let result = WASM.addition(left, right, map{
        max_source_bytes: 4096, max_module_bytes: 65536,
        max_sections: 64, max_exports: 64
    });
    return map{
        ok: true, format: FORMAT, left: left, right: right, value: result.value,
        modeled_value: result.modeled_value, wasm_bytes: result.module.bytes,
        wasm_sha256: result.module.sha256, sections: result.module.sections,
        exports: result.module.exports, has_main_function: result.module.has_main_function,
        envelope_valid: result.module.envelope_valid,
        semantic_validation: result.module.semantic_validation,
        cross_checked: result.cross_checked, source_bytes: result.source_bytes,
        original_source_sha256: MIGRATED_SOURCE_SHA256,
        implementation_language: "pblang", foreign_compiler_used: false,
        generated_server_used: false, network_access: false, filesystem_access: false
    };
}

export FORMAT, MIGRATED_SOURCE_SHA256, run;
