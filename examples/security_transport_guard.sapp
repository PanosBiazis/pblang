// examples/security_transport_guard.sapp — Transport Security & Replay Guard Example
let Guard = import("stdlib:transport_security.sapp");

let identity = Guard.signal_fingerprint("peer-address", "paired-terminal-01");
let monitor = Guard.new(map{ expected_identity: identity });

let observation = Guard.observe(monitor, map{
    transport: "wifi",
    purpose: "connectivity",
    protocol: "pbremote-e2e",
    application_authenticated: true,
    identity_fingerprint: identity,
    sequence: 0,
    nonce: "nonce-sec-guard-9901",
    gateway_fingerprint: Guard.signal_fingerprint("gateway", "local-gateway")
});

let status = Guard.status(monitor);
print "Transport Security Guard: ok=" + str(observation.ok) + " blocked=" + str(observation.blocked);
print json_stringify(map{ observation: observation, status: status });
