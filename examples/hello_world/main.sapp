// Hello World — the simplest pblang program
print "Hello, World!";

let name = "pblang";
let version = 0.5;
print "Welcome to " + name + " v" + str(version) + "!";

// Arrays
let fruits = ["apple", "banana", "cherry"];
for fruit in fruits {
    print "  - " + fruit;
}

// Maps
let person = map{ name: "Alice", age: 30 };
print person.name + " is " + str(person.age);

// Functions
fn greet(who) { return "Hello, " + who + "!"; }
print greet("World");

// Error handling
let result = try error("boom") catch "handled safely";
print result;
