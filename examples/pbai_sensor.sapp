let AI=import("stdlib/pbai.sapp");
let result=AI.sensor_analyze(map{values:[10,12,14,30],period_seconds:2,sigma:3,absolute_tolerance:0.5});
assert(result.status=="result" and result.value.outlier,"synthetic sensor deviation");
assert(result.value.expected_last==16 and result.value.slope_per_second==1,"prefix-only trend");
print json_stringify(result);
