let T=import("stdlib:thread.sapp");
let completed=try {
    T.thread_pool(2,[1,2,3],fn(value){
        if value==2 {throw "invalid job";}
        return value*2;
    });
    true
} catch false;
assert(not completed,"failure reported after workers are joined");
print "The pool failed; its started workers have finished.";
// Completed external effects are not rolled back. A nonterminating worker can
// still prevent cleanup from finishing; this API cannot forcibly cancel it.
