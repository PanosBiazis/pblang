// Run from the repository: pblang run examples/sse_reader/main.sapp
let SSE = import("stdlib:sse_reader.sapp");
let reader = SSE.new(map{ chunk_chars: 256, total_chars: 1024, events: 8 });
let chunks = ["id: sample\r", "\ndata: Γεια ", "😀\r\ndata: κόσμε\r\n\r", "\ndata: [DONE]\n\n"];
for chunk in chunks {
    for event in reader.feed(chunk) {
        print event.event + " id=" + event.last_event_id + " data=" + event.data;
    }
}
reader.finish();
print reader.status().phase;
