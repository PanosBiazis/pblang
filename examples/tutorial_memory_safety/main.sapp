// tutorial_memory_safety/main.sapp
// ── Memory Safety Demo ───────────────────────────────────────────────────
// Demonstrates: ownership, borrowing, lifetimes, error handling.
// Uses pblang's builtin memory safety primitives via the memory stdlib.
//
// Key concepts:
//   - Ownership: only one owner per value
//   - Borrowing: immutable (&T) and mutable (&mut T) borrows
//   - Lifetimes: scoped handles become inaccessible when scope exits
//   - Error on use-after-move / use-after-free
//
// Run with:
//   pblang run examples/tutorial_memory_safety/main.sapp

let mem = import("stdlib:memory.sapp");
let math = import("stdlib:math.sapp");

print "╔════════════════════════════════════════════════╗";
print "║   pblang Memory Safety Tutorial               ║";
print "║   Ownership · Borrowing · Lifetimes           ║";
print "╚════════════════════════════════════════════════╝";

// ── 1. Ownership: Box and Read ───────────────────────────────────────────

print "\n=== 1. Ownership: Allocating & Reading ===";

// Allocate a value on the heap — `box` creates a mutable owned value
let handle_a = mem.box(42);
print "Allocated handle_a = " + str(handle_a) + " with value " + str(mem.read(handle_a));

// Allocate another value
let handle_b = mem.box("hello");
print "Allocated handle_b = " + str(handle_b) + " with value '" + mem.read(handle_b) + "'";

// You can update an owned value (if mutable)
mem.write(handle_a, 99);
print "Updated handle_a to " + str(mem.read(handle_a));

// ── 2. Immutable Borrowing ───────────────────────────────────────────────

print "\n=== 2. Immutable Borrowing (&T) ===";

// Create an immutable borrow — this gives read-only access
let borrow_id = mem.borrow(handle_a);
print "Created immutable borrow " + str(borrow_id) + " for handle_a";

// We can still read through the original handle
print "Read through handle: " + str(mem.read(handle_a));

// Multiple immutable borrows are allowed
let borrow_id2 = mem.borrow(handle_a);
print "Created second immutable borrow " + str(borrow_id2) + " — multiple &T borrows are OK!";

// Release borrows
mem.release(borrow_id2);
mem.release(borrow_id);
print "Both borrows released";

// ── 3. Mutable Borrowing ─────────────────────────────────────────────────

print "\n=== 3. Mutable Borrowing (&mut T) ===";

let handle_c = mem.box(100);
print "Allocated handle_c with value " + str(mem.read(handle_c));

// Create a mutable borrow — exclusive access
let mut_borrow = mem.borrow_mut(handle_c);
print "Got mutable borrow " + str(mut_borrow) + " for handle_c";

// Release and update
mem.release(mut_borrow);
mem.write(handle_c, 200);
print "After borrow release, updated handle_c to " + str(mem.read(handle_c));

// ── 4. Move Semantics (use-after-move errors) ────────────────────────────

print "\n=== 4. Move Semantics ===";

// pblang tracks ownership. After moving a value, accessing it should error.
// We demonstrate this with try/catch to show graceful handling.

let handle_d = mem.box("important data");
print "Allocated handle_d with value '" + mem.read(handle_d) + "'";

// Free the memory — this is like "dropping" the value
mem.free(handle_d);
print "Freed handle_d";

// Attempting to read after free would be a runtime error.
// We catch it gracefully:
let after_free = try mem.read(handle_d) catch "ERROR: use-after-free detected!";
print "Read after free returned: " + str(after_free);

// ── 5. Lifetime Scopes ──────────────────────────────────────────────────

print "\n=== 5. Lifetime Scopes ===";

// Scoped allocation — value lives only inside the scope
let scoped_result = mem.scope(fn() {
    let local_handle = mem.box("scoped value");
    print "  Inside scope: local value is '" + mem.read(local_handle) + "'";

    // This handle becomes inaccessible when the scope exits.
    return map{ seen: "scoped value was alive", handle: local_handle };
});

print "Scope returned: " + json_stringify(scoped_result);

// Accessing the local_handle after scope exit would fail
let leaked = try mem.read(scoped_result.handle) catch "correctly invalidated after scope";
print "Access after scope: " + str(leaked);
// The current VM retains the expired allocation until explicit free.
mem.free(scoped_result.handle);

// ── 6. Lifetime-scoped Automatic Borrow Cleanup ─────────────────────────────────

print "\n=== 6. Lifetime Scope — Automatic Cleanup ===";

let handle_e = mem.box(map{ name: "Resource", count: 42 });
print "Allocated resource handle";

// memory.scope registers a lifetime and releases its borrows on return or
// caught failure. Merely dropping a SafeRef map does not perform that cleanup.
fn use_scoped_borrow(h) {
    return mem.scope(fn() {
        mem.borrow(h);
        let val = mem.read(h);
        print "  Borrowed value: " + json_stringify(val);
        return val;
    });
}

let result = use_scoped_borrow(handle_e);
print "After the lifetime scope exits, handle_e is usable again:";
mem.write(handle_e, map{ name: "Resource", count: 99 });
print "  Updated: " + json_stringify(mem.read(handle_e));
mem.free(handle_e);

// ── 7. Memory Statistics ─────────────────────────────────────────────────

print "\n=== 7. Memory Stats ===";

let stats = mem.stats();
print "Memory system statistics:";
print "  " + json_stringify(stats);

// Free remaining handles
mem.free(handle_a);
mem.free(handle_b);
mem.free(handle_c);

print "\n=== Memory Safety Demo Complete ===";
print "Key takeaways:";
print "  1. Owned values have exactly one owner";
print "  2. Multiple immutable borrows (&T) can coexist";
print "  3. At most one mutable borrow (&mut T) at a time";
print "  4. Use-after-free is caught at runtime";
print "  5. Lifetime scopes invalidate handles; allocation reclamation needs free";
print "  6. memory.scope releases scoped borrows automatically";
