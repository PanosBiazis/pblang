let OS = import("stdlib:os.sapp");
let WORKBENCH = import("examples/algorithm_workbench/workbench.sapp");

fn usage() {
    print "Algorithm workbench";
    print "  sort <comma-separated-integers>";
    print "  search <sorted-comma-separated-integers> <target>";
    print "  fib <count>";
}

fn main() {
    let arguments = OS.script_args();
    if len(arguments) == 0 { usage(); return true; }
    let operation = str_lower(arguments[0]);
    let report = nil;
    if operation == "sort" and len(arguments) == 2 {
        report = try WORKBENCH.sort_report(WORKBENCH.parse_integer_list(arguments[1])) catch nil;
    } else if operation == "search" and len(arguments) == 3 {
        report = try WORKBENCH.binary_search_report(
            WORKBENCH.parse_integer_list(arguments[1]),
            WORKBENCH.parse_integer(arguments[2], "target")
        ) catch nil;
    } else if operation == "fib" and len(arguments) == 2 {
        report = try WORKBENCH.fibonacci_report(
            WORKBENCH.parse_integer(arguments[1], "count")
        ) catch nil;
    } else {
        usage();
        return false;
    }
    if report == nil {
        print "Invalid or unsupported input for " + operation;
        return false;
    }
    print json_stringify(report);
    return try report.verified catch false;
}

main();
