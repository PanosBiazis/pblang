let WORKBENCH = import("examples/algorithm_workbench/workbench.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "algorithm_workbench test failed: " + message; }
}

fn rejected(callable) { return (try { callable(); false } catch true); }

let input = [5, 1, 4, 2, 8, 2];
let sorted = WORKBENCH.sort_report(input);
require(sorted.verified and str(sorted.sorted) == "[1, 2, 2, 4, 5, 8]",
"three sorting implementations must agree");
require(str(input) == "[5, 1, 4, 2, 8, 2]" and not sorted.input_mutated,
"sorting must not mutate caller input");
require(sorted.bubble.comparisons > 0 and sorted.bubble.swaps > 0
and sorted.bubble.stable, "bubble trace must expose useful metrics");

let already_sorted = WORKBENCH.bubble_sort_trace([1, 2, 3, 4]);
require(already_sorted.passes == 1 and already_sorted.swaps == 0,
"optimized bubble sort must stop after an unchanged pass");
require(WORKBENCH.sort_report([]).verified, "empty sorting input must be valid");
require(WORKBENCH.sort_report([7]).verified, "single-item sorting input must be valid");
require(rejected(fn() { WORKBENCH.sort_report("1,2"); }), "non-array sorting input must fail");
let oversized = [];
let oi = 0;
while oi < 513 { array_push(oversized, oi); oi = oi + 1; }
require(rejected(fn() { WORKBENCH.sort_report(oversized); }), "sort work must be bounded");

let hit = WORKBENCH.binary_search_report([1, 3, 5, 7, 9], 7);
let miss = WORKBENCH.binary_search_report([1, 3, 5, 7, 9], 8);
require(hit.verified and hit.found and hit.index == 3, "binary search hit must be reported");
require(miss.verified and not miss.found and miss.index == -1, "binary search miss must be reported");
require(rejected(fn() { WORKBENCH.binary_search_report([2, 1], 1); }),
"unsorted binary-search input must fail explicitly");

let fibonacci = WORKBENCH.fibonacci_report(12);
require(fibonacci.verified and fibonacci.exact and len(fibonacci.sequence) == 12,
"all Fibonacci implementations must agree");
require(fibonacci.sequence[0] == "0" and fibonacci.sequence[10] == "55",
"Fibonacci sequence uses the expected zero-based definition");
require(WORKBENCH.fibonacci_report(0).verified, "empty Fibonacci sequence must be valid");
require(rejected(fn() { WORKBENCH.fibonacci_report(-1); }), "negative count must fail");
require(rejected(fn() { WORKBENCH.fibonacci_report(129); }), "Fibonacci work must be bounded");

require(str(WORKBENCH.parse_integer_list(" 5, -2, 0 ")) == "[5, -2, 0]",
"CLI integer list parser must trim items");
require(rejected(fn() { WORKBENCH.parse_integer_list("1,,2"); }),
"empty list item must fail");
require(rejected(fn() { WORKBENCH.parse_integer_list("1e3,2"); }),
"exponent notation must fail");
require(rejected(fn() { WORKBENCH.parse_integer_list("1.5,2"); }),
"fractional notation must fail");

for source_path in [
    "examples/algorithm_workbench/workbench.sapp",
    "examples/algorithm_workbench/main.sapp",
    "examples/algorithm_workbench/test.sapp"
] {
    let report = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(report.ok and report.passed and not report.truncated and report.high == 0,
    "bounded security analysis must pass for " + source_path);
}

print "algorithm_workbench_pass";
