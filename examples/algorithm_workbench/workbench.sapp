// Bounded migration of the sorting, searching, and Fibonacci C exercise.

let ALGO = import("stdlib:algo.sapp");
let ADVANCED = import("stdlib:algorithms_advanced.sapp");
let BIGNUM = import("stdlib:bignum.sapp");

let MAX_ITEMS = 512;
let MAX_FIBONACCI_COUNT = 128;
let MAX_SAFE_INTEGER = 9007199254740991;

fn source_sha256() {
    return "668f4d037d44e51092c4d45b3fedea0e3e9fd842f288c5bc689a3c3a5ad353f0";
}

fn _integer(value, label) {
    if not is_number(value) or num_floor(value) != value {
        throw label + " must be an integer";
    }
    if value < -MAX_SAFE_INTEGER or value > MAX_SAFE_INTEGER {
        throw label + " exceeds the exact numeric range";
    }
    return value;
}

fn _copy_values(values) {
    if type(values) != "array" { throw "values must be an array"; }
    if len(values) > MAX_ITEMS { throw "value count exceeds " + str(MAX_ITEMS); }
    let out = [];
    let i = 0;
    while i < len(values) {
        array_push(out, _integer(values[i], "values[" + str(i) + "]"));
        i = i + 1;
    }
    return out;
}

fn _arrays_equal(a, b) {
    if len(a) != len(b) { return false; }
    let i = 0;
    while i < len(a) {
        if a[i] != b[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn is_sorted(values) {
    if type(values) != "array" { return false; }
    let i = 1;
    while i < len(values) {
        if values[i - 1] > values[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn bubble_sort_trace(values) {
    let out = _copy_values(values);
    let comparisons = 0;
    let swaps = 0;
    let passes = 0;
    let end = len(out) - 1;
    while end > 0 {
        let changed = false;
        let i = 0;
        while i < end {
            comparisons = comparisons + 1;
            if out[i] > out[i + 1] {
                let temporary = out[i];
                out[i] = out[i + 1];
                out[i + 1] = temporary;
                swaps = swaps + 1;
                changed = true;
            }
            i = i + 1;
        }
        passes = passes + 1;
        if not changed { end = 0; }
        else { end = end - 1; }
    }
    return map{
        format: "pblang.example.bubble-sort-trace.v1",
        sorted: out,
        comparisons: comparisons,
        swaps: swaps,
        passes: passes,
        stable: true,
        input_mutated: false
    };
}

fn sort_report(values) {
    let input = _copy_values(values);
    let bubble = bubble_sort_trace(input);
    let standard = ALGO.merge_sort(input);
    let advanced = ADVANCED.merge_sort(input);
    let verified = _arrays_equal(bubble.sorted, standard)
        and _arrays_equal(standard, advanced) and is_sorted(standard);
    return map{
        format: "pblang.example.algorithm-sort-report.v1",
        input: input,
        sorted: standard,
        bubble: bubble,
        implementations_checked: ["bubble_sort", "algo.merge_sort", "algorithms_advanced.merge_sort"],
        verified: verified,
        input_mutated: false
    };
}

fn binary_search_report(values, target) {
    let input = _copy_values(values);
    let expected = _integer(target, "target");
    if not is_sorted(input) { throw "binary search requires ascending sorted input"; }
    let first = ALGO.binary_search(input, expected);
    let second = ADVANCED.binary_search(input, expected);
    if first != second { throw "binary search implementations disagree"; }
    return map{
        format: "pblang.example.algorithm-search-report.v1",
        target: expected,
        found: first >= 0,
        index: first,
        implementations_checked: ["algo.binary_search", "algorithms_advanced.binary_search"],
        verified: true,
        input_mutated: false
    };
}

fn _fib_iterative(count) {
    let out = [];
    let previous = bigint(0);
    let current = bigint(1);
    let i = 0;
    while i < count {
        array_push(out, str(previous));
        let next = previous + current;
        previous = current;
        current = next;
        i = i + 1;
    }
    return out;
}

fn _fib_memo(index, memo) {
    let key = str(index);
    if map_has(memo, key) { return memo[key]; }
    let value = _fib_memo(index - 1, memo) + _fib_memo(index - 2, memo);
    memo[key] = value;
    return value;
}

fn _fib_memoized(count) {
    let memo = map{ "0": bigint(0), "1": bigint(1) };
    let out = [];
    let i = 0;
    while i < count {
        array_push(out, str(_fib_memo(i, memo)));
        i = i + 1;
    }
    return out;
}

fn fibonacci_report(count_value) {
    let count = _integer(count_value, "count");
    if count < 0 or count > MAX_FIBONACCI_COUNT {
        throw "count must be in 0.." + str(MAX_FIBONACCI_COUNT);
    }
    let iterative = _fib_iterative(count);
    let memoized = _fib_memoized(count);
    let verified = _arrays_equal(iterative, memoized);
    let i = 0;
    while i < count {
        if iterative[i] != str(BIGNUM.fib(i)) { verified = false; }
        i = i + 1;
    }
    return map{
        format: "pblang.example.algorithm-fibonacci-report.v1",
        count: count,
        sequence: iterative,
        implementations_checked: ["iterative_bigint", "memoized_bigint", "bignum.fib"],
        verified: verified,
        exact: true
    };
}

fn _decimal_integer(text, label) {
    let value = str_trim(str(text));
    if value == "" { throw label + " must not be empty"; }
    let start = 0;
    if value[0..1] == "-" { start = 1; }
    if start == len(value) or len(value) - start > 16 {
        throw label + " is outside the accepted decimal shape";
    }
    let i = start;
    while i < len(value) {
        if str_index_of("0123456789", value[i..(i + 1)]) < 0 {
            throw label + " must use ASCII base-10 digits";
        }
        i = i + 1;
    }
    let parsed = parse_number(value);
    return _integer(parsed, label);
}

fn parse_integer_list(text) {
    let source = str_trim(str(text));
    if source == "" { return []; }
    let pieces = str_split(source, ",");
    if len(pieces) > MAX_ITEMS { throw "value count exceeds " + str(MAX_ITEMS); }
    let out = [];
    let i = 0;
    while i < len(pieces) {
        array_push(out, _decimal_integer(pieces[i], "item " + str(i + 1)));
        i = i + 1;
    }
    return out;
}

fn parse_integer(text, label = "value") { return _decimal_integer(text, label); }

export source_sha256, is_sorted, bubble_sort_trace, sort_report, binary_search_report;
export fibonacci_report, parse_integer_list, parse_integer;
