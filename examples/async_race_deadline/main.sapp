let A=import("stdlib:async.sapp");
let futures=[A.go(fn(){sleep_ms(30);return "first";}),
             A.go(fn(){sleep_ms(60);return "second";})];
let result=A.await_race_timeout(futures,0);
if result.ready { print result; }
else { print "No completed task yet; both futures remain owned."; }
// A timeout never cancels work: settle every future before leaving the owner.
print A.all_settled(futures);
