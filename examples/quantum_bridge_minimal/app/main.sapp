// Consumer app: uses quantum_bridge_minimal as local dependency.
import "stdlib:quantum.sapp";
let bridge = import("plugin");
let c = quantum.circuit(2);
let c = quantum.h(c, 0);
let job = bridge.build_job(c, map{ provider: "sim", shots: 256 });
print job.provider;
print job.shots;
print job.metadata.qubits;
