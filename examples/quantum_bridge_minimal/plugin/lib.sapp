// Minimal quantum bridge example — build job envelope from circuit + options (see Help Q1).
// Inline minimal QASM emission (no stdlib import from plugin path); job envelope: provider, shots, qasm, metadata.

fn _emit_qasm(c) {
    let s = "OPENQASM 2.0;\ninclude \"qelib1.inc\";\n";
    s = s + "qreg q[" + str(c.n) + "];\n";
    s = s + "creg c[" + str(c.n) + "];\n";
    for i len(c.ops) {
        let op = c.ops[i];
        if op.gate == "h" { s = s + "h q[" + str(op.q) + "];\n"; }
        else { if op.gate == "cx" { s = s + "cx q[" + str(op.c) + "],q[" + str(op.t) + "];\n"; } }
    }
    return s;
}

fn build_job(c, opts) {
    let qasm = _emit_qasm(c);
    let meta = map{ qubits: c.n };
    return map{ provider: opts.provider, shots: opts.shots, qasm: qasm, metadata: meta };
}

export build_job;
