let Example=import("./document.sapp");let Web=import("stdlib:ui_form_web.sapp");
let example=Example.build();
let actions=map{Explain:fn(values){return "16 synthetic points: 4D -> 3D -> 2D. The second view selects time and response from four-dimensional measurements. Each view declares its axis ranges and names every source point. This is an affine projection, not a VR renderer.";}};
let args=try env_get("PBLANG_SCRIPT_ARGS") catch "";
if args!=nil and args!="" and args!="--serve" {throw "usage: main.sapp [--serve]";}
if args=="--serve" {
    print "Open 127.0.0.1:8768. Synthetic local preview; Ctrl+C stops it.";
    Web.serve(example.document,actions,8768);
} else {
    let app=Web.create(example.document,actions,8768);
    let response=app.handle(map{method:"GET",path:"/",headers:map{host:"127.0.0.1:8768"},body:""});
    assert(response.status==200 and str_contains(response.body,"<svg"),"spatial form preview");
    assert(len(example.spatial)==16 and len(example.spatial[0])==3,"3D coordinates");
    app.close();print "nd_form_example_pass";
}
