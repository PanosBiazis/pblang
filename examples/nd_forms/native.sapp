// The same synthetic 4D -> 3D -> 2D data, drawn with the existing CPU window API.
let Example=import("./document.sapp");let G=import("stdlib:graphics.sapp");
let example=Example.build();let background=G.rgb(244,247,251);let ink=G.rgb(24,44,61);let accent=G.rgb(31,100,142);
let win=G.Window(640,400,"PBLang named projections");
let state=map{started:now_ms(),graphics_stop:false,dirty:true};
G.run(win,state,fn(current,events){
    for event in events {if event.type=="close" {current.graphics_stop=true;}}
    if now_ms()-current.started>=3000 {current.graphics_stop=true;}
    return current.dirty;
},fn(current,canvas){
    canvas.clear(background);
    canvas.text(24,16,"4D vertices through 3D into 2D",ink);
    canvas.line(48,48,48,336,ink);canvas.line(48,336,612,336,ink);
    let index=0;
    for point in example.display {
        let x=48+(point[0]+2)/4*564;let y=336-(point[1]+2)/4*288;
        canvas.circle(x,y,4,accent);index=index+1;canvas.text(x+6,y-4,str(index),ink);
    }
    canvas.text(24,360,"X: -2 to 2   Y: -2 to 2   16 named vertices",ink);
    canvas.text(24,380,"Read exact values in the Web table. Closes in 3 seconds.",ink);
    current.dirty=false;
},30);
print "native_projection_pass";
