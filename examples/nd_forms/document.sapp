// Synthetic 4D data -> 3D coordinates -> passive 2D form views.
let ND=import("stdlib:nd_projection.sapp");let Doc=import("stdlib:ui_document.sapp");
let Overlay=import("stdlib:ui_form_overlay.sapp");
fn build() {
    let points=[];
    for a in [-1,1] {for b in [-1,1] {for c in [-1,1] {for d in [-1,1] {push(points,[a,b,c,d]);}}}}
    let spatial=ND.compile([[1,0,0,0.45],[0,1,0,0.3],[0,0,1,0.2]]).project(points);
    let display=ND.compile([[1,0,0.4],[0,1,0.3]]).project(spatial);
    let samples=[];for i 16 {push(samples,[i,20+i*0.5,100-i,2+i*i]);}
    let measurements=ND.compile([[1,0,0,0],[0,0,0,1]]).project(samples);
    let base=Doc.from_design(map{form:map{title:"Dimensions · PBLang",w:900,h:900},model:map{},widgets:[
        map{name:"Intro",kind:"label",x:0,y:0,w:800,h:40,props:map{text:"Spatial and data projections. Read-only views; expand Point values for accessible coordinates."}},
        map{name:"Spatial",kind:"scatter",x:0,y:40,w:800,h:340,props:map{points:display,title:"4D vertices through a 3D view",x_label:"Projected X",y_label:"Projected Y"}},
        map{name:"Measurements",kind:"scatter",x:0,y:400,w:800,h:340,props:map{points:measurements,title:"Sensor samples",x_label:"Time",y_label:"Response"}},
        map{name:"Explain",kind:"button",x:0,y:750,w:200,h:40,props:map{text:"Explain these views"}}
    ]},"pblang-nd-example");
    let document=Overlay.apply(base,[map{id:"Measurements",set:map{props:map{title:"Two selected axes of four-dimensional measurements"}}}]);
    assert(base.widgets[2].props.title=="Sensor samples","overlay does not modify source");
    return map{document:document,spatial:spatial,display:display,measurements:measurements};
}
export build;
