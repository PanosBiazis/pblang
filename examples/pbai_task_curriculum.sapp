let AI=import("stdlib/pbai.sapp");
let groups=[map{family:"sum-mod-four",split:"training",examples:[map{x:[4,0,0],y:0},map{x:[4,1,1],y:2}]},
 map{family:"sum-mod-four",split:"validation",examples:[map{x:[4,1,2],y:3}]},
 map{family:"sum-mod-four",split:"test",examples:[map{x:[4,3,2],y:1}]}];
let curriculum=AI.neural_task_curriculum_split(8,3,groups);
print json_stringify(curriculum.report);
