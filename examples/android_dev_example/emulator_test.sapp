let App = import("examples/android_dev_example/app.sapp");
let Android = import("stdlib:android_emulator.sapp");
let Input = import("stdlib:input_events.sapp");

fn require(value, message) {
    if not value { throw "android_dev_example emulator test failed: " + message; }
}

fn spec() {
    return map{
        package: App.PACKAGE_NAME,
        min_sdk: 21,
        target_sdk: 34,
        activities: [map{ name: ".MainActivity", exported: true }],
        main_activity: ".MainActivity",
        permissions: [],
        allow_cleartext: false
    };
}

let architectures = ["armv7", "arm64", "x86", "x86_64"];
let api = 21;
let cases = 0;

while api <= 36 {
    for architecture in architectures {
        let emulator = Android.new(api, architecture, map{
            width: if api % 2 == 0 { 1080 } else { 720 },
            height: if api % 2 == 0 { 2400 } else { 1280 },
            memory_bytes: 65536,
            max_events: 32,
            max_files: 8,
            max_input_events: 8
        });

        let installed = Android.install(emulator, spec());
        require(installed.ok, "install on API " + str(api) + " " + architecture);
        require(len(installed.auto_grants) == 0, "application requests no permissions");

        let launched = Android.start_activity(emulator, "system", App.PACKAGE_NAME);
        require(launched.ok and launched.state == "resumed",
            "launch on API " + str(api) + " " + architecture);
        require(Android.input_apply(emulator, App.PACKAGE_NAME,
            Input.pointer_event(180, 320).event).ok, "foreground touch input");

        require(Android.write_private(emulator, App.PACKAGE_NAME, App.PACKAGE_NAME,
            "state/welcome", App.WELCOME_MESSAGE).ok, "private state write");
        let stored = Android.read_private(emulator, App.PACKAGE_NAME, App.PACKAGE_NAME,
            "state/welcome");
        require(stored.ok and stored.data == App.WELCOME_MESSAGE, "private state read");

        require(Android.background(emulator, App.PACKAGE_NAME).state == "stopped",
            "background lifecycle");
        require(Android.destroy(emulator, App.PACKAGE_NAME).state == "destroyed",
            "destroy lifecycle");
        require(Android.start_activity(emulator, "system", App.PACKAGE_NAME).ok,
            "recreate after destroy");

        let status = Android.app_status(emulator, App.PACKAGE_NAME);
        require(status.ok and status.running and status.launches == 2,
            "relaunch accounting");
        let removed = Android.uninstall(emulator, App.PACKAGE_NAME);
        require(removed.ok and removed.removed_private_files == 1,
            "uninstall removes private state");

        cases = cases + 1;
    }
    api = api + 1;
}

print "android_dev_example_emulator_pass cases=" + str(cases);
