let App = import("examples/android_dev_example/app.sapp");
let UI = import("stdlib:modern_ui.sapp");
let Android = import("stdlib:modern_ui_android.sapp");
let Runtime = import("stdlib:app.sapp");
let GUI = import("stdlib:gui.sapp");
let Security = import("stdlib:security_analysis.sapp");

fn require(value, message) {
    if not value { throw "android_dev_example test failed: " + message; }
}

fn record(bundle, name) {
    for item in bundle.records {
        if item.name == name { return item; }
    }
    return nil;
}

let view = App.view();
let validation = UI.validate(view);
require(validation.ok, "view contract must validate");

let compact = UI.compile(view, map{ target: "android", width: 320, height: 568 });
let tablet = UI.compile(view, map{ target: "android", width: 1280, height: 800 });
require(record(compact, "message") != nil, "compact message must be rendered");
require(record(compact, "continue_button") != nil, "compact button must be rendered");
require(record(tablet, "message") != nil, "tablet message must be rendered");
require(record(tablet, "continue_button") != nil, "tablet button must be rendered");

let generated = Android.generate(App.APP_NAME, compact, App.android_options("unused.apk"));
require(generated.package == App.PACKAGE_NAME, "original package name must be retained");
require(generated.activity == App.PACKAGE_NAME + ".MainActivity",
    "launch activity must be generated");
require(len(generated.class_bytes) > 500, "generated Activity must contain JVM bytecode");
require(generated.class_bytes[0] == 202 and generated.class_bytes[1] == 254
    and generated.class_bytes[2] == 186 and generated.class_bytes[3] == 190,
    "generated Activity must have JVM class magic");
require(str_contains(generated.manifest, "android:usesCleartextTraffic=\"false\""),
    "cleartext traffic must remain disabled");
require(str_contains(generated.manifest, "android:allowBackup=\"false\""),
    "application backup must remain disabled");
require(generated.responsive.runtime_screen_width_dp,
    "layout must use the device width at runtime");
require(generated.responsive.minimum_touch_target_dp == 48,
    "touch controls must meet the minimum target size");

let preview = Runtime.modern(App.APP_NAME, view, map{
    preview: true,
    width: 360,
    height: 640,
    theme: "light"
});
let button = GUI.get(preview.form, "continue_button");
let message = GUI.get(preview.form, "message");
require(button != nil and message != nil, "interactive controls must exist");
button.onclick(preview.form);
require(message.text == App.WELCOME_MESSAGE,
    "button must reproduce the original Android behavior");

for source_path in [
    "examples/android_dev_example/app.sapp",
    "examples/android_dev_example/main.sapp"
] {
    let report = Security.analyze(fs_read(source_path), source_path, map{
        minimum_blocking_severity: "high"
    });
    require(report.ok and report.passed and not report.truncated and report.high == 0,
        "security analysis must pass for " + source_path);
}

print "android_dev_example_pass";
