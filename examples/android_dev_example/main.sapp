let App = import("examples/android_dev_example/app.sapp");
let Runtime = import("stdlib:app.sapp");

let result = Runtime.modern_android(
    App.APP_NAME,
    App.view(),
    App.android_options()
);

if not result.ok {
    throw "Android build failed at " + result.stage + ": " + result.error;
}

print "apk=" + result.output;
print "sha256=" + result.sha256;
print "bytes=" + str(result.bytes);
