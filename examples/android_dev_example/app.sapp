// PBLang-only application contract for the original project1 Android example.

let UI = import("stdlib:modern_ui.sapp");

let APP_NAME = "Android Programming";
let PACKAGE_NAME = "com.example.myapp";
let WELCOME_MESSAGE = "Welcome to Android Programming!!!";

fn view() {
    return UI.screen([
        UI.heading(APP_NAME, map{
            name: "title",
            accessibility_label: "Android Programming example"
        }),
        UI.card([
            UI.text("Press the button to display the welcome message.", map{
                name: "message",
                accessibility_label: "Application message"
            }),
            UI.button("Continue", UI.action_set_text("message", WELCOME_MESSAGE), map{
                name: "continue_button",
                accessibility_label: "Display welcome message"
            })
        ], map{
            name: "welcome_card",
            title: "Welcome"
        })
    ], map{ name: "root" });
}

fn android_options(output = "examples/android_dev_example/release/AndroidDevExample-debug.apk") {
    return map{
        package: PACKAGE_NAME,
        version: "1.0.0",
        version_code: 1,
        min_sdk: 21,
        target_sdk: 34,
        theme: "light",
        width: 412,
        height: 915,
        compact_breakpoint_dp: 600,
        output: output
    };
}

export APP_NAME, PACKAGE_NAME, WELCOME_MESSAGE, view, android_options;
