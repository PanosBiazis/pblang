// Browser runtime emitted by PBLang for the authenticated local bridge.

fn source(session_token) {
    let token = json_stringify(str(session_token));
    return "\"use strict\";\n"
    + "(()=>{const TOKEN=" + token + ";const API='/api';const DEFAULT_TIMEOUT_MS=6000;const CONNECT_TIMEOUT_MS=12000;let busy=false,timer=0,connected=false;"
    + "const named=n=>document.querySelector('[data-pb-name=\"'+CSS.escape(n)+'\"]');"
    + "const text=(n,v)=>{const e=named(n);if(!e)return;if(e.matches('input,textarea'))e.value=String(v);else{const x=e.querySelector('[data-pb-value]');(x||e).textContent=String(v);}};"
    + "const progress=(n,v)=>{const e=named(n);if(e)e.value=Math.max(0,Math.min(1,Number(v)||0));};"
    + "const value=n=>{const e=named(n);return e?e.value:'';};const checked=n=>{const e=named(n);const i=e&&e.querySelector('input');return !!(i&&i.checked);};"
    + "const status=v=>text('connection_status',v);const setBusy=v=>{busy=v;document.querySelectorAll('button[data-pb-name]').forEach(b=>{b.disabled=v;});};"
    + "async function api(path,method='GET',body=null,timeoutMs=DEFAULT_TIMEOUT_MS){const c=new AbortController();const t=setTimeout(()=>c.abort(),timeoutMs);try{const r=await fetch(API+path,{method,headers:{'X-PBLang-Session':TOKEN,'Content-Type':'application/json'},body:body===null?null:JSON.stringify(body),signal:c.signal,cache:'no-store'});const d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||('HTTP '+r.status));return d;}finally{clearTimeout(t);}}"
    + "function board(){return value('board')==='1'?'esp32-devkitc-v4':'arduino-uno';}"
    + "function applyTelemetry(t){if(!t)return;const a=t.adc||{};const p=Number(a.led_percent??a.percent??0);progress('adc_level',p/100);progress('brightness_level',p/100);text('adc_value','Input '+Math.round(p)+'%');text('brightness_value','LED '+Math.round(p)+'%');const b=t.button||{};status('Connected - LED '+(t.blinking?'blinking':t.on?'on':'off')+', button '+(b.pressed?'pressed':'released'));}"
    + "async function devices(){const d=await api('/devices');const s=named('port');if(!s)return;const old=s.value;s.textContent='';for(const x of d.devices){const o=document.createElement('option');o.value=x.port;o.textContent=x.label;s.appendChild(o);}if(!d.devices.length){const o=document.createElement('option');o.value='';o.textContent='No wired device available';s.appendChild(o);}if([...s.options].some(o=>o.value===old))s.value=old;status(d.devices.length+' wired device(s) available');}"
    + "async function connect(){status('Connecting and verifying firmware...');const d=await api('/connect','POST',{board:board(),port:value('port')},CONNECT_TIMEOUT_MS);connected=true;text('device_status',d.board+' - connected');applyTelemetry(d.telemetry);status('Connected to '+d.port);}"
    + "async function disconnect(){await api('/disconnect','POST',{});connected=false;text('device_status',board()+' - offline');status('Disconnected');stopPoll();}"
    + "async function command(action,options={}){if(!connected)throw new Error('Connect a board first');const d=await api('/command','POST',{action,options});if(d.telemetry)applyTelemetry(d.telemetry);else if(d.result&&action==='adc'){const p=Number(d.result.led_percent||0);progress('adc_level',p/100);progress('brightness_level',p/100);text('adc_value','Input '+Math.round(p)+'%');text('brightness_value','LED '+Math.round(p)+'%');}else status('Command completed: '+action);return d;}"
    + "function stopPoll(){if(timer){clearTimeout(timer);timer=0;}}function schedule(){stopPoll();const m=value('refresh_mode');if(!connected||m==='0')return;let ms=Math.floor(Number(value('refresh_interval'))||1000);ms=Math.max(m==='1'?100:250,Math.min(m==='1'?5000:3600000,ms));timer=setTimeout(async()=>{try{const d=await command('refresh');if(d.telemetry)applyTelemetry(d.telemetry);}catch(e){status(e.message);}schedule();},ms);}"
    + "async function act(name){if(busy)return;setBusy(true);try{if(name==='connect')await connect();else if(name==='disconnect')await disconnect();else if(name==='rescan')await devices();else if(name==='led_on')await command('on');else if(name==='led_off')await command('off');else if(name==='led_toggle')await command('toggle');else if(name==='blink_start')await command('blink',{interval_ms:Math.floor(Number(value('interval'))),duration_ms:Math.floor(Number(value('duration')))});else if(name==='blink_stop')await command('stop');else if(name==='adc')await command('adc');else if(name==='loopback')await command('loopback');else if(name==='button_read')await command('button');else if(name==='refresh_now')await command('refresh');else if(name==='inspector'){const d=await api('/inspect');text('inspector_output',d.text);status('Inspector updated');}}catch(e){status(e.name==='AbortError'?'The wired board did not answer before the safe deadline':e.message);}finally{setBusy(false);}}"
    + "document.addEventListener('click',e=>{const b=e.target.closest('[data-pb-name]');if(b&&b.matches('button')){e.preventDefault();act(b.getAttribute('data-pb-name'));}});"
    + "document.addEventListener('change',async e=>{const n=e.target.closest('[data-pb-name]');if(!n)return;const name=n.getAttribute('data-pb-name');try{if(name==='analog_follow'&&connected)await command('follow',{enabled:checked('analog_follow')});else if(name==='refresh_mode')schedule();else if((name==='board'||name==='port')&&connected)await disconnect();}catch(x){status(x.message);}});"
    + "addEventListener('pagehide',()=>{stopPoll();});devices().catch(e=>status('Local bridge unavailable: '+e.message));})();\n";
}

export source;
