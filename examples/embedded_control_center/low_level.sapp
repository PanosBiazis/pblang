// Low-level example: explicit circuit, session, ADC frame and cleanup.

let Embedded = import("stdlib:embedded.sapp");

let circuit = Embedded.new_circuit(map{name:"ADC low-level example", mode:"emulator"});
if not Embedded.Circuit.add_device(circuit, "target", "arduino-uno").ok {
    throw "could not add emulated Arduino UNO";
}
let session = Embedded.Controller.connect(circuit, "target");
if not session.ok { throw session.error; }
let sample = Embedded.Controller.read_adc(session);
if not sample.ok or not Embedded.Controller.close(session).ok {
    throw "ADC low-level example failed";
}
print json_stringify(sample.result);
