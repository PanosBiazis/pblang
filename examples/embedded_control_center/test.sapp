let Model = import("examples/embedded_control_center/model.sapp");
let View = import("examples/embedded_control_center/view.sapp");
let UI = import("stdlib:modern_ui.sapp");
let GUI = import("stdlib:gui.sapp");
let Desktop = import("examples/embedded_control_center/desktop_app.sapp");

let app = Model.create(map{mode:"emulator", board:"arduino-uno"});
assert(app.ok, "emulated control center connects");
let adc = Model.command(app, "adc");
assert(adc.ok and adc.result.raw == 512 and adc.result.maximum == 1023,
    "emulated ADC has a bounded normalized result");
assert(adc.result.led_percent>78 and adc.result.led_percent<79
    and Model.command(app,"follow",map{enabled:false}).ok
    and Model.command(app,"follow",map{enabled:true}).ok,
    "shared model calibrates and controls the analog LED route");
let button=Model.command(app,"button");
assert(button.ok and not button.result.pressed and button.result.pin=="D4",
    "emulated button exposes the board-specific read-only input");
assert(Model.command(app, "on").ok, "LED on command succeeds");
assert(Model.command(app, "toggle").ok, "LED toggle command succeeds");
assert(Model.command(app, "blink", map{interval_ms:250, duration_ms:1000}).ok,
    "bounded blink command succeeds");
assert(Model.command(app, "loopback").result.pass, "loopback verifies both phases");
let configured=Model.configure_refresh(app,"periodic",1000);
assert(configured.ok and configured.refresh.interval_ms==1000,
    "periodic refresh accepts an explicit bounded interval");
let due=configured.refresh.next_due_ms;
assert(not Model.poll(app,due-1).polled and Model.poll(app,due).polled,
    "periodic refresh runs only when due");
assert(Model.set_active(app,false).ok and Model.poll(app,due+1000).reason=="inactive",
    "background lifecycle pauses device polling");
assert(not Model.configure_refresh(app,"live",50).ok
    and not Model.configure_refresh(app,"periodic",3600001).ok,
    "unsafe refresh rates fail closed");
assert(Model.close(app).termios_restored, "session closes cleanly");

let view = View.create(map{board:"Arduino UNO", adc_percent:50,
    led_percent:78,analog_follow:true});
let phone = UI.compile(view, map{target:"android", width:320, height:568});
let desktop = UI.compile(view, map{target:"desktop", width:1280, height:800});
assert(phone.profile.compact and not desktop.profile.compact,
    "shared view responds to compact and wide layouts");
assert(len(phone.records) == len(desktop.records),
    "all controls remain available on every layout");
let analog_controls=0;for record in phone.records{
    if record.name=="analog_follow" or record.name=="brightness_level"{analog_controls=analog_controls+1;}
}
assert(analog_controls==2,"compact Android layout retains analog LED controls");

let native=Desktop.create(map{mode:"emulator"});
assert(GUI.get(native,"connect")!=nil and GUI.get(native,"port")!=nil
    and GUI.get(native,"inspector_output")!=nil,
    "native GUI exposes connection, discovery, and inspector controls");
GUI.get(native,"connect").onclick(native);
assert(native.desktop_app.connected,
    "native GUI connects the shared controller model");
GUI.get(native,"adc").onclick(native);
assert(str_contains(GUI.get(native,"adc_value").text,"78%")
    and str_contains(GUI.get(native,"brightness_value").text,"78%"),
    "native GUI presents live input and LED output telemetry");
GUI.get(native,"inspector").onclick(native);
assert(str_contains(GUI.get(native,"inspector_output").value,"arduino-uno")
    and str_contains(GUI.get(native,"inspector_output").value,"Polls:"),
    "native inspector reports the selected board and bounded poll state");
GUI.set_prop(native,"refresh_mode","selected",1);
GUI.get(native,"refresh_mode").onchange(native);
assert(native.desktop_app.app.refresh.mode=="live",
    "native GUI controls the shared live refresh policy");
assert(Desktop.close(native).last_close_ok and not native.desktop_app.connected
    and native.close_requested,
    "native GUI restores the controller session and closes cooperatively");

let invalid = Model.create(map{mode:"wired", board:"arduino-uno"});
assert(not invalid.ok and invalid.code == "missing-port",
    "wired access fails closed without a selected port");
print "embedded_control_center_test=ok";
