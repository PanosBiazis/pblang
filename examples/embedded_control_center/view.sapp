// One bounded component tree for desktop, Web and generated Android output.

let UI = import("stdlib:modern_ui.sapp");

fn _handler(handlers,name,fallback) {
    if handlers!=nil and type(handlers)=="map" {
        let callback=try handlers[name] catch nil;
        if callback!=nil{return callback;}
    }
    return fallback;
}

fn create(state = nil, handlers = nil) {
    let selected = if state == nil { "Arduino UNO" } else { try state.board catch "Arduino UNO" };
    let board_index=if str_contains(str_lower(selected),"esp32"){1}else{0};
    let ports=if state==nil{["Automatic"]}else{try state.ports catch ["Automatic"]};
    if type(ports)!="array" or len(ports)<1{ports=["Automatic"];}
    let port_index=if state==nil{0}else{try state.port_index catch 0};
    if type(port_index)!="number" or port_index<0 or port_index>=len(ports){port_index=0;}
    let adc = if state == nil { 0 } else { try state.adc_percent catch 0 };
    let brightness=if state==nil{0}else{try state.led_percent catch adc};
    let adc_ratio=adc/100;let brightness_ratio=brightness/100;
    let following=if state==nil{true}else{try state.analog_follow catch true};
    return UI.screen([
        UI.heading("Embedded Control Center", map{name:"title"}),
        UI.text("Inspect, test and control a wired board from one responsive surface.",
            map{name:"summary"}),
        UI.row([
            UI.card([
                UI.heading("Device"),
                UI.choice(["Arduino UNO", "ESP32 DevKitC V4"], board_index,
                    _handler(handlers,"board_change",nil),
                    map{name:"board", accessibility_label:"Selected microcontroller board"}),
                UI.choice(ports,port_index,_handler(handlers,"port_change",nil),
                    map{name:"port",accessibility_label:"Selected wired serial port"}),
                UI.text(selected, map{name:"device_status"}),
                UI.row([
                    UI.button("Connect",_handler(handlers,"connect",
                        UI.action_set_text("connection_status","Connection requested")),
                        map{name:"connect",accessibility_label:"Connect selected wired board"}),
                    UI.button("Disconnect",_handler(handlers,"disconnect",
                        UI.action_set_text("connection_status","Disconnect requested")),
                        map{name:"disconnect"}),
                    UI.button("Rescan",_handler(handlers,"rescan",
                        UI.action_set_text("connection_status","Device refresh requested")),
                        map{name:"rescan",accessibility_label:"Refresh connected devices"})
                ],map{padding:0,gap:8})
            ], map{name:"device_card",padding:10,gap:8}),
            UI.card([
                UI.heading("Analog LED"),
                UI.progress(adc_ratio, map{name:"adc_level",accessibility_label:"Potentiometer level"}),
                UI.text("Input " + str(adc) + "%", map{name:"adc_value"}),
                UI.progress(brightness_ratio,map{name:"brightness_level",accessibility_label:"Analog LED brightness"}),
                UI.text("LED " + str(brightness) + "%",map{name:"brightness_value"}),
                UI.toggle("Follow potentiometer",following,
                    _handler(handlers,"follow_change",nil),
                    map{name:"analog_follow",accessibility_label:"Make PWM or DAC LED brightness follow the potentiometer",
                        action:if handlers==nil{UI.action_set_text("connection_status","Analog LED mode changed")}else{nil}}),
                UI.button("Read A/D", _handler(handlers,"adc",
                    UI.action_set_text("connection_status", "Analog read requested")),
                    map{name:"adc", accessibility_label:"Read analog input"})
            ], map{name:"adc_card",padding:10,gap:8})
        ], map{name:"overview", responsive:true,padding:0,gap:8}),
        UI.row([
            UI.card([
                UI.heading("LED control"),
                UI.row([
                    UI.button("On", _handler(handlers,"on",UI.action_set_text("connection_status", "LED on requested")),
                        map{name:"led_on"}),
                    UI.button("Off", _handler(handlers,"off",UI.action_set_text("connection_status", "LED off requested")),
                        map{name:"led_off"}),
                    UI.button("Toggle", _handler(handlers,"toggle",UI.action_set_text("connection_status", "LED toggle requested")),
                        map{name:"led_toggle"})
                ],map{padding:0,gap:8}),
                UI.slider(500, 10, 60000, nil,
                    map{name:"interval", accessibility_label:"Blink interval in milliseconds"}),
                UI.slider(0, 0, 86400000, nil,
                    map{name:"duration", accessibility_label:"Blink duration in milliseconds, zero means continuous"}),
                UI.row([
                    UI.button("Start blinking", _handler(handlers,"blink",UI.action_set_text("connection_status", "Blink requested")),
                        map{name:"blink_start"}),
                    UI.button("Stop", _handler(handlers,"stop",UI.action_set_text("connection_status", "Blink stop requested")),
                        map{name:"blink_stop"})
                ],map{padding:0,gap:8})
            ], map{name:"led_card",padding:10,gap:8}),
            UI.card([
                UI.heading("Diagnostics and updates"),
                UI.text("A0 -> D6 PWM | GPIO34 -> GPIO25 DAC",map{name:"analog_route"}),
                UI.row([
                    UI.button("Loopback", _handler(handlers,"loopback",UI.action_set_text("connection_status", "Loopback test requested")),
                        map{name:"loopback"}),
                    UI.button("Read button", _handler(handlers,"button",UI.action_set_text("connection_status", "Button read requested")),
                        map{name:"button_read", accessibility_label:"Read physical pushbutton input"}),
                    UI.button("Inspect", _handler(handlers,"inspector",UI.action_set_text("connection_status", "Inspector requested")),
                        map{name:"inspector"})
                ],map{padding:0,gap:8}),
                UI.text("Ready", map{name:"connection_status"}),
                UI.area("No inspection data yet.", map{name:"inspector_output",h:56,
                    readonly:true,max_chars:2048,
                    accessibility_label:"Current board and telemetry inspection details"}),
                UI.heading("Refresh"),
                UI.row([
                    UI.choice(["Manual", "Live", "Periodic"], 0,
                        _handler(handlers,"refresh_mode_change",nil),
                        map{name:"refresh_mode", accessibility_label:"Telemetry refresh mode"}),
                    UI.slider(1000, 100, 60000, nil,
                        map{name:"refresh_interval", accessibility_label:"Refresh interval in milliseconds"}),
                    UI.button("Refresh", _handler(handlers,"refresh_now",UI.action_set_text("connection_status", "Telemetry refresh requested")),
                        map{name:"refresh_now", accessibility_label:"Refresh board telemetry now"}),
                    UI.text("Manual", map{name:"refresh_status"})
                ],map{padding:0,gap:8,responsive:true})
            ], map{name:"checks_card",padding:10,gap:8})
        ],map{name:"control_row",responsive:true,padding:0,gap:8})
    ], map{name:"root",padding:10,gap:8});
}

export create;
