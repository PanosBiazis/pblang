let Bridge = import("examples/embedded_control_center/bridge.sapp");

fn request(method,path,token,body="") {
    let headers=map{};
    if token!=""{headers["X-PBLang-Session"]=token;}
    return map{method:method,path:path,headers:headers,body:body};
}

let bridge=Bridge.create(map{port:18766});
assert(bridge.ok and bridge.host=="127.0.0.1" and bridge.port==18766,"bridge is loopback-only");
let reserved=Bridge.bind(bridge);
assert(str_contains(tcp_local_addr(reserved),"127.0.0.1:18766"),
    "bridge can reserve its loopback listener before a UI launch");
tcp_close(reserved);
assert(len(bridge.state.token)>=32,"bridge creates an ephemeral high-entropy session token");
let page=Bridge.handle(bridge,request("GET","/",""));
assert(page.status==200 and str_contains(page.body,"Embedded Control Center"),"shared responsive page is served");
let denied=Bridge.handle(bridge,request("GET","/api/devices",""));
assert(denied.status==401 and str_contains(denied.body,"unauthorized"),"API fails closed without its session token");
let devices=Bridge.handle(bridge,request("GET","/api/devices",bridge.state.token));
assert(devices.status==200 and (try json_parse(devices.body).ok catch false),"authenticated device discovery works");
let malformed=Bridge.handle(bridge,request("POST","/api/connect",bridge.state.token,"[]"));
assert(malformed.status==400 and str_contains(malformed.body,"JSON object required"),"connect rejects non-object JSON");
let oversized=Bridge.handle(bridge,request("POST","/api/connect",bridge.state.token,str_repeat("x",4097)));
assert(oversized.status==413,"bridge bounds request bodies before parsing effects");
let runtime=Bridge.handle(bridge,request("GET","/pblang-ui.js",""));
assert(runtime.status==200 and str_contains(runtime.body,"const API='/api'")
    and str_contains(runtime.body,"api('/connect'") and str_contains(runtime.body,"X-PBLang-Session")
    and str_contains(runtime.body,"CONNECT_TIMEOUT_MS=12000")
    and str_contains(runtime.body,"setBusy(true)")
    and str_contains(runtime.body,"firmware"),
    "browser actions call the authenticated hardware API");
assert(Bridge.close(bridge).ok,"bridge cleanup is cooperative");
print "embedded_control_center_bridge_pass";
