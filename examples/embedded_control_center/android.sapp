// Android APK generated in PBLang. The Activity renders the same responsive
// Web surface served by the authenticated local hardware bridge.

let WebView = import("stdlib:android_webview.sapp");

let result = WebView.build("Embedded Control Center", map{
    package:"org.pblang.embeddedcontrolcenter",
    min_sdk:21, target_sdk:34, version:"1.3.0", version_code:4,
    url:"http://127.0.0.1:8766/",
    output:"examples/embedded_control_center/release/Embedded-Control-Center-debug.apk"
});
if not result.ok { throw "Android build failed at " + result.stage + ": " + result.error; }
print "apk=" + result.output;
print "sha256=" + result.sha256;
