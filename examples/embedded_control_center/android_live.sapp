// Install and launch the Android UI through an ADB reverse loopback tunnel.
// The bridge remains in this foreground process and ends with Ctrl+C.

let Bridge=import("examples/embedded_control_center/bridge.sapp");
let ADB=import("stdlib:android_adb.sapp");

let PACKAGE="org.pblang.embeddedcontrolcenter";
let ACTIVITY=PACKAGE+"/.MainActivity";
let APK="examples/embedded_control_center/release/Embedded-Control-Center-debug.apk";

fn require_adb(result,label){
    if not result.ok{throw ADB.result_error(result,label);}
    return true;
}

let adb=ADB.discover_adb();
if adb==nil{throw "adb is unavailable";}
let listed=ADB.run_bounded(adb,["devices","-l"],10);
if not listed.ok{throw ADB.result_error(listed,"Android device discovery");}
let requested=try env_get("PBLANG_ANDROID_SERIAL") catch "";
let selected=ADB.select_device(ADB.parse_devices(listed.stdout),requested);
if not selected.ok{throw selected.error;}
let serial=selected.device.serial;
if not fs_exists(APK){throw "build the Android APK first with android.sapp";}
require_adb(ADB.install_apk(adb,serial,APK,PACKAGE,28),"APK install");
require_adb(ADB.run_bounded(adb,["-s",serial,"reverse","tcp:8766","tcp:8766"],10),"ADB reverse");
ADB.run_bounded(adb,["-s",serial,"shell","am","force-stop",PACKAGE],10);

let bridge=Bridge.create(map{port:8766});
let listener=Bridge.bind(bridge);
require_adb(ADB.run_bounded(adb,["-s",serial,"shell","am","start","-W","-n",ACTIVITY],20),
    "Android activity launch");
print "Android bridge active for the selected device. Press Ctrl+C to stop.";
Bridge.listen_bound(bridge,listener);
tcp_close(listener);
Bridge.close(bridge);
