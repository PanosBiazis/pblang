// examples/quantum_bb84/main.sapp
// BB84-style QKD toy demo + Bell-state histogram using quantum_sim.histogram.

import "stdlib:crypto_quantum.sapp";
import "stdlib:quantum_sim.sapp";
import "stdlib:quantum.sapp";

// Placeholder classical parameters for bb84-style simulation.
let alice_bits  = [0, 1, 1, 0];
let alice_bases = [0, 0, 1, 1]; // 0 = Z, 1 = X
let bob_bases   = [0, 1, 1, 0];

print "QKD protocol: " + crypto_quantum.QKD_PROTOCOLS.bb84;
print "Alice bits: " + str(alice_bits);
print "Alice bases: " + str(alice_bases);
print "Bob bases: " + str(bob_bases);

// In a full implementation this would call a bb84_simulate helper; for now
// we just print the chosen protocol and parameters to show the wiring.

// Bell-state circuit: |Φ+> = (|00> + |11>)/sqrt(2)
let circ = quantum.circuit(2);
quantum.h(circ, 0);
quantum.cnot(circ, 0, 1);
quantum.measure_all(circ);

// Run the circuit several times and build a histogram of outcomes.
let shots = 20;
let results = [];
let i = 0;
while i < shots {
    results[i] = quantum.run(circ);
    i = i + 1;
}
let hist = quantum_sim.histogram(results);
print "Bell histogram: " + json_stringify(hist);

