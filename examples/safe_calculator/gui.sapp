// examples/safe_calculator/gui.sapp
// Native pblang graphics calculator inspired by the Tkinter/Avalonia desktop
// calculators in PyCalculator and AAP/desktop-apps.

let gfx = import("stdlib/graphics.sapp");
let K = import("stdlib/keymap.sapp");
let CALC = import("examples/safe_calculator/lib.sapp");

let START_W = 860;
let START_H = 820;

let BG = gfx.rgb(240, 244, 250);
let PANEL = gfx.rgb(255, 255, 255);
let PANEL_2 = gfx.rgb(248, 251, 255);
let BORDER = gfx.rgb(206, 216, 230);
let TEXT = gfx.rgb(31, 41, 55);
let MUTED = gfx.rgb(100, 116, 139);
let ACCENT = gfx.rgb(46, 107, 255);
let ACCENT_2 = gfx.rgb(25, 76, 195);
let DANGER = gfx.rgb(219, 39, 119);
let BUTTON = gfx.rgb(235, 241, 249);
let BUTTON_HOVER = gfx.rgb(221, 231, 246);
let BUTTON_DARK = gfx.rgb(227, 235, 247);
let MEMORY_FILL = gfx.rgb(230, 235, 247);
let FUNCTION_FILL = gfx.rgb(232, 246, 239);
let FUNCTION_TEXT = gfx.rgb(22, 101, 52);
let TOOL_FILL = gfx.rgb(230, 244, 250);
let DANGER_FILL = gfx.rgb(252, 231, 243);

fn _max(a, b) { if a > b { return a; } return b; }
fn _min(a, b) { if a < b { return a; } return b; }
fn _clamp(v, lo, hi) { if v < lo { return lo; } if v > hi { return hi; } return v; }

fn _theme(state) {
    let mode = str_lower(str(try state.theme catch "light"));
    if mode == "dark" {
        return map{
            name: "Dark",
            bg: gfx.rgb(15, 23, 42),
            panel: gfx.rgb(30, 41, 59),
            panel2: gfx.rgb(15, 23, 42),
            border: gfx.rgb(71, 85, 105),
            text: gfx.rgb(226, 232, 240),
            muted: gfx.rgb(148, 163, 184),
            accent: gfx.rgb(96, 165, 250),
            accent2: gfx.rgb(59, 130, 246),
            danger: gfx.rgb(244, 114, 182),
            button: gfx.rgb(51, 65, 85),
            button_hover: gfx.rgb(71, 85, 105),
            button_dark: gfx.rgb(63, 80, 105),
            memory: gfx.rgb(49, 58, 89),
            function_fill: gfx.rgb(20, 83, 45),
            function_text: gfx.rgb(134, 239, 172),
            tool: gfx.rgb(22, 78, 99),
            danger_fill: gfx.rgb(83, 32, 63)
        };
    }
    return map{
        name: "Light",
        bg: BG,
        panel: PANEL,
        panel2: PANEL_2,
        border: BORDER,
        text: TEXT,
        muted: MUTED,
        accent: ACCENT,
        accent2: ACCENT_2,
        danger: DANGER,
        button: BUTTON,
        button_hover: BUTTON_HOVER,
        button_dark: BUTTON_DARK,
        memory: MEMORY_FILL,
        function_fill: FUNCTION_FILL,
        function_text: FUNCTION_TEXT,
        tool: TOOL_FILL,
        danger_fill: DANGER_FILL
    };
}

fn _toggle_theme(state) {
    if str_lower(str(try state.theme catch "light")) == "dark" {
        state.theme = "light";
    } else {
        state.theme = "dark";
    }
    _set_status(state, "Theme: " + str(_theme(state).name));
}

fn _text(win, x, y, text, color, px) {
    let adv = num_floor(px * 0.56);
    if adv < 7 { adv = 7; }
    let ok = try win.textAA(x, y, str(text), color, px, adv) catch nil;
    if ok == nil { return win.text(x, y, str(text), color); }
    return ok;
}

fn _short_text(text, maxchars) {
    let s = str(text);
    if len(s) <= maxchars { return s; }
    if maxchars <= 3 { return str_slice(s, 0, maxchars); }
    return str_slice(s, 0, maxchars - 3) + "...";
}

fn _center_text(win, x, y, w, text, color, px) {
    let maxchars = num_floor((w - 12) / _max(7, num_floor(px * 0.56)));
    if maxchars < 1 { maxchars = 1; }
    let s = _short_text(text, maxchars);
    let tw = len(s) * _max(7, num_floor(px * 0.56));
    let tx = x + (w - tw) / 2;
    if tx < x + 6 { tx = x + 6; }
    return _text(win, tx, y, s, color, px);
}

fn _in_rect(mx, my, b) {
    return mx >= b.x and my >= b.y and mx <= b.x + b.w and my <= b.y + b.h;
}

fn _layout(w, h) {
    let margin = 20;
    if w < 560 { margin = 14; }
    let gap = 10;
    let right_w = 270;
    if w < 720 { right_w = 0; }
    let left_w = w - margin * 2 - gap;
    if right_w > 0 { left_w = w - margin * 2 - gap - right_w; }
    if left_w < 320 { left_w = w - margin * 2; right_w = 0; }
    let left_x = margin;
    let right_x = left_x + left_w + gap;
    let title_y = margin;
    let display_y = title_y + 38;
    let display_h = 64;
    let mode_y = display_y + display_h + 8;
    let keys_y = mode_y + 26;
    let row_count = len(_button_rows());
    let usable_h = h - keys_y - 54;
    let row_h = num_floor((usable_h - (row_count - 1) * gap) / row_count);
    row_h = _clamp(row_h, 34, 56);
    let col_w = num_floor((left_w - 3 * gap) / 4);
    let history_h = h - display_y;
    return map{
        margin: margin,
        gap: gap,
        left_x: left_x,
        left_w: left_w,
        right_x: right_x,
        right_w: right_w,
        title_y: title_y,
        display_y: display_y,
        display_h: display_h,
        mode_y: mode_y,
        keys_y: keys_y,
        row_h: row_h,
        col_w: col_w,
        history_x: right_x,
        history_y: display_y,
        history_w: right_w,
        history_h: history_h
    };
}

fn _button_rows() {
    return [
        ["MC", "MR", "M+", "M-"],
        ["C", "Back", "(", ")"],
        ["7", "8", "9", "/"],
        ["4", "5", "6", "*"],
        ["1", "2", "3", "-"],
        ["0", ".", "=", "+"],
        ["%", "mod", "^", "sqrt"],
        ["sin", "cos", "tan", "ln"],
        ["log10", "abs", "pi", "e"],
        ["asin", "acos", "atan", "fact"],
        ["Theme", "History", "Clear History", "Close"]
    ];
}

fn _button_kind(label) {
    if label == "=" { return "accent"; }
    if label == "C" or label == "Close" or label == "Clear History" { return "danger"; }
    if label == "/" or label == "*" or label == "-" or label == "+" or label == "^" or label == "%" or label == "mod" { return "op"; }
    if label == "MC" or label == "MR" or label == "M+" or label == "M-" { return "memory"; }
    if _is_function_button(label) or label == "pi" or label == "e" { return "function"; }
    if label == "Theme" or label == "History" or label == "Copy" or label == "Back" { return "tool"; }
    return "number";
}

fn _button_display(label) {
    if label == "Clear History" { return "Clear Hist"; }
    if label == "*" { return "x"; }
    if label == "/" { return "/"; }
    return label;
}

fn _buttons(layout) {
    let rows = _button_rows();
    let out = [];
    let r = 0;
    while r < len(rows) {
        let c = 0;
        while c < len(rows[r]) {
            let label = rows[r][c];
            let x = layout.left_x + c * (layout.col_w + layout.gap);
            let y = layout.keys_y + r * (layout.row_h + layout.gap);
            push(out, map{
                label: label,
                text: _button_display(label),
                kind: _button_kind(label),
                x: x,
                y: y,
                w: layout.col_w,
                h: layout.row_h
            });
            c = c + 1;
        }
        r = r + 1;
    }
    return out;
}

fn _hit_button(state, mx, my) {
    let layout = _layout(state.w, state.h);
    let buttons = _buttons(layout);
    let i = 0;
    while i < len(buttons) {
        if _in_rect(mx, my, buttons[i]) { return buttons[i].label; }
        i = i + 1;
    }
    return "";
}

fn _set_status(state, text) {
    state.status = str(text);
    state.redraw = true;
}

fn _is_function_button(label) {
    return label == "sqrt" or label == "sin" or label == "cos" or label == "tan"
        or label == "asin" or label == "acos" or label == "atan"
        or label == "ln" or label == "log10" or label == "abs" or label == "fact";
}

fn _append(state, ch) {
    if len(state.display) >= 200 {
        _set_status(state, "expression too long");
        return 0;
    }
    if state.display == "0" and ch != "." and ch != "+" and ch != "-" and ch != "*" and ch != "/" and ch != ")" {
        state.display = ch;
    } else {
        state.display = state.display + ch;
    }
    _set_status(state, "editing");
    return 0;
}

fn _append_operator(state, op) {
    if str_trim(state.display) == "" {
        if op == "+" or op == "-" { _append(state, op); }
        return 0;
    }
    state.display = state.display + " " + op + " ";
    _set_status(state, "editing");
}

fn _wrap_function(state, name) {
    let expr = str_trim(state.display);
    if expr == "" {
        state.display = name + "(";
    } else {
        state.display = name + "(" + expr + ")";
    }
    _set_status(state, "wrapped with " + name);
}

fn _toggle_sign(state) {
    let expr = str_trim(state.display);
    if expr == "" { state.display = "-"; return 0; }
    state.display = "0 - (" + expr + ")";
    _set_status(state, "sign toggled");
}

fn _backspace(state) {
    if len(state.display) <= 1 {
        state.display = "";
    } else {
        state.display = str_slice(state.display, 0, len(state.display) - 1);
    }
    _set_status(state, "editing");
}

fn _evaluate_current(state) {
    let expr = str_trim(state.display);
    let r = CALC.calculate(expr, state.history);
    if r.ok {
        state.display = str(r.value);
        state.last_result = r.value;
        _set_status(state, "Saved: " + expr + " = " + str(r.value));
    } else {
        _set_status(state, "Error: " + r.message);
    }
}

fn _current_number(state) {
    let expr = str_trim(state.display);
    if expr == "" { return map{ ok: true, value: 0 }; }
    return CALC.calculate(expr, []);
}

fn _memory_add(state, sign) {
    let r = _current_number(state);
    if not r.ok {
        _set_status(state, "Memory skipped: " + r.message);
        return 0;
    }
    state.memory = state.memory + sign * r.value;
    _set_status(state, "Memory = " + str(state.memory));
}

fn _press(state, label, win) {
    if label == "" { return 0; }
    state.last_button = label;
    if label == "=" { _evaluate_current(state); return 0; }
    if label == "C" { state.display = ""; _set_status(state, "Ready"); return 0; }
    if label == "Back" { _backspace(state); return 0; }
    if label == "+/-" { _toggle_sign(state); return 0; }
    if label == "Theme" { _toggle_theme(state); return 0; }
    if label == "History" { state.show_history = not state.show_history; _set_status(state, "History panel toggled"); return 0; }
    if label == "Copy" { _set_status(state, "Copy needs a host clipboard gate; display=" + state.display); return 0; }
    if label == "Clear History" { state.history = []; state.history_scroll = 0; _set_status(state, "History cleared"); return 0; }
    if label == "Close" { win.close(); return 0; }
    if label == "MC" { state.memory = 0; _set_status(state, "Memory cleared"); return 0; }
    if label == "MR" { state.display = str(state.memory); _set_status(state, "Memory recalled"); return 0; }
    if label == "M+" { _memory_add(state, 1); return 0; }
    if label == "M-" { _memory_add(state, 0 - 1); return 0; }
    if label == "pi" { _append(state, "pi"); return 0; }
    if label == "e" { _append(state, "e"); return 0; }
    if _is_function_button(label) { _wrap_function(state, label); return 0; }
    if label == "+" or label == "-" or label == "*" or label == "/" or label == "^" or label == "%" { _append_operator(state, label); return 0; }
    if label == "mod" { _append_operator(state, "mod"); return 0; }
    _append(state, label);
    return 0;
}

fn _is_allowed_char(ch) {
    return str_index_of("0123456789.+-*/^%() abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", ch) >= 0;
}

fn _scroll_delta(e) {
    let dy = try parse_number(str(try e.dy catch 0)) catch 0;
    if dy == nil or dy == 0 { return 0; }
    if dy > 0 {
        let n = num_floor(dy);
        if n < 1 { n = 1; }
        return 0 - n * 3;
    }
    let n = num_floor(0 - dy);
    if n < 1 { n = 1; }
    return n * 3;
}

fn _clamp_history_scroll(state, rows) {
    let total = len(state.history);
    if total <= rows { state.history_scroll = 0; return 0; }
    if state.history_scroll < 0 { state.history_scroll = 0; }
    let maxv = total - rows;
    if state.history_scroll > maxv { state.history_scroll = maxv; }
}

fn update(state, events) {
    if len(events) == 0 and not (try state.redraw catch true) { return false; }
    let changed = false;
    let i = 0;
    while i < len(events) {
        let e = events[i];
        if e.type == "mousemove" {
            state.mx = e.x;
            state.my = e.y;
            let next_hover = _hit_button(state, state.mx, state.my);
            if next_hover != state.hover {
                state.hover = next_hover;
                changed = true;
            }
        } elif e.type == "mousedown" and (try e.button catch "Left") == "Left" {
            let mx = try e.x catch state.mx;
            let my = try e.y catch state.my;
            state.mx = mx;
            state.my = my;
            let hit = _hit_button(state, mx, my);
            _press(state, hit, state.win);
            state.hover = hit;
            changed = true;
        } elif e.type == "scroll" {
            if state.show_history {
                state.history_scroll = state.history_scroll + _scroll_delta(e);
                _clamp_history_scroll(state, 18);
                changed = true;
            }
        } elif e.type == "keydown" {
            changed = true;
            if K.is_shift(e.key) { state.shift = true; }
            else if e.key == "Enter" or e.key == "Return" or e.key == "NumpadEnter" { _evaluate_current(state); }
            else if e.key == "Backspace" { _backspace(state); }
            else if e.key == "Escape" {
                if str_trim(state.display) == "" { state.win.close(); }
                else { state.display = ""; _set_status(state, "Ready; press Esc again to close"); }
            }
            else if e.key == "Delete" { state.display = ""; _set_status(state, "Ready"); }
            else if e.key == "Up" { state.history_scroll = state.history_scroll - 1; _clamp_history_scroll(state, 18); }
            else if e.key == "Down" { state.history_scroll = state.history_scroll + 1; _clamp_history_scroll(state, 18); }
            else {
                let ch = K.key_to_char(e.key, state.shift);
                if ch != "" and _is_allowed_char(ch) { _append(state, ch); }
            }
        } elif e.type == "keyup" {
            if K.is_shift(e.key) { state.shift = false; }
        }
        i = i + 1;
    }
    if changed { state.redraw = true; }
    return try state.redraw catch true;
}

fn _draw_panel(win, x, y, w, h, theme) {
    win.rect(x, y, w, h, theme.panel);
    win.rect(x, y, w, 2, theme.border);
    win.rect(x, y + h - 2, w, 2, theme.border);
    win.rect(x, y, 2, h, theme.border);
    win.rect(x + w - 2, y, 2, h, theme.border);
}

fn _draw_button(state, win, b) {
    let theme = _theme(state);
    let fill = theme.button;
    let text = theme.text;
    if b.kind == "op" { fill = theme.button_dark; }
    if b.kind == "memory" { fill = theme.memory; }
    if b.kind == "function" { fill = theme.function_fill; text = theme.function_text; }
    if b.kind == "tool" { fill = theme.tool; }
    if b.kind == "accent" { fill = theme.accent; text = gfx.rgb(255, 255, 255); }
    if b.kind == "danger" { fill = theme.danger_fill; text = theme.danger; }
    if state.hover == b.label {
        if b.kind == "accent" { fill = theme.accent2; }
        else { fill = theme.button_hover; }
    }
    win.rect(b.x, b.y, b.w, b.h, fill);
    win.rect(b.x, b.y, b.w, 1, theme.border);
    win.rect(b.x, b.y + b.h - 1, b.w, 1, theme.border);
    win.rect(b.x, b.y, 1, b.h, theme.border);
    win.rect(b.x + b.w - 1, b.y, 1, b.h, theme.border);
    _center_text(win, b.x, b.y + b.h / 2 - 9, b.w, b.text, text, 16);
}

fn _display_text(state, layout) {
    let maxchars = num_floor((layout.left_w - 28) / 12);
    if maxchars < 8 { maxchars = 8; }
    let s = state.display;
    if s == "" { s = "0"; }
    if len(s) <= maxchars { return s; }
    return "..." + str_slice(s, len(s) - maxchars + 3, len(s));
}

fn _draw_history(state, win, layout) {
    let theme = _theme(state);
    let hx = layout.history_x;
    let hy = layout.history_y;
    let hw = layout.history_w;
    let hh = layout.history_h - 20;
    if hw <= 0 {
        if not state.show_history { return 0; }
        hx = layout.left_x;
        hy = layout.display_y + layout.display_h + 8;
        hw = layout.left_w;
        hh = state.h - hy - 18;
    }
    _draw_panel(win, hx, hy, hw, hh, theme);
    _text(win, hx + 14, hy + 16, "History", theme.text, 17);
    _text(win, hx + hw - 82, hy + 18, str(len(state.history)) + " rows", theme.muted, 13);
    let line_y = hy + 48;
    win.rect(hx + 12, line_y - 10, hw - 24, 1, theme.border);
    let rows = num_floor((hh - 66) / 22);
    if rows < 1 { rows = 1; }
    _clamp_history_scroll(state, rows);
    if len(state.history) == 0 {
        _text(win, hx + 14, line_y + 10, "No history yet.", theme.muted, 14);
        return 0;
    }
    let start = len(state.history) - rows - state.history_scroll;
    if start < 0 { start = 0; }
    let idx = start;
    let row = 0;
    while idx < len(state.history) and row < rows {
        let item = state.history[idx];
        let txt = str(try item.text catch "");
        let maxc = num_floor((hw - 32) / 8);
        _text(win, hx + 14, line_y + row * 22, _short_text(txt, maxc), theme.text, 13);
        idx = idx + 1;
        row = row + 1;
    }
    return 0;
}

fn draw(state, win) {
    let sz = win.size();
    state.w = sz.w;
    state.h = sz.h;
    let theme = _theme(state);
    let layout = _layout(sz.w, sz.h);
    win.clear(theme.bg);
    _text(win, layout.left_x, layout.title_y, "Safe pblang Calculator", theme.text, 21);
    _text(win, layout.left_x, layout.title_y + 24, "No eval, shared parser, memory keys, history panel. Theme " + theme.name + ".", theme.muted, 13);

    _draw_panel(win, layout.left_x, layout.display_y, layout.left_w, layout.display_h, theme);
    _text(win, layout.left_x + 14, layout.display_y + 17, _display_text(state, layout), theme.text, 26);
    _text(win, layout.left_x, layout.mode_y, _short_text(state.status, num_floor(layout.left_w / 8)), theme.muted, 13);
    _text(win, layout.left_x + layout.left_w - 130, layout.mode_y, "M=" + str(state.memory), theme.muted, 13);

    let buttons = _buttons(layout);
    let i = 0;
    while i < len(buttons) {
        _draw_button(state, win, buttons[i]);
        i = i + 1;
    }

    if layout.right_w > 0 or state.show_history {
        _draw_history(state, win, layout);
    }

    _text(win, layout.left_x, sz.h - 24, "Keyboard: digits/operators, Enter, Backspace, Esc. Mouse: click buttons.", theme.muted, 12);
    state.redraw = false;
    return true;
}

fn main() {
    let win = gfx.Window(START_W, START_H, "Safe pblang Calculator");
    let state = map{
        win: win,
        w: START_W,
        h: START_H,
        display: "",
        status: "Ready",
        history: [],
        history_scroll: 0,
        memory: 0,
        last_result: 0,
        theme: "light",
        show_history: true,
        shift: false,
        mx: 0,
        my: 0,
        hover: "",
        last_button: "",
        redraw: true
    };
    gfx.run(win, state, update, draw, 30);
    win.close();
    print "calculator gui closed";
}

main();
