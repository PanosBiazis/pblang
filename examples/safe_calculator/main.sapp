// examples/safe_calculator/main.sapp
// Headless pblang version of the PyCalculator idea.
//
// Run this for deterministic tests and CLI output. Use gui.sapp for the
// Tkinter-like native calculator window.

let CALC = import("examples/safe_calculator/lib.sapp");

fn main() {
    let history = [];
    let samples = [
        "1 + 1",
        "(7 + 3) * 2",
        "27 / 9",
        "2 * (6 + 4.5) - 3",
        "2 ^ 8",
        "10 mod 3",
        "sqrt(16) + fact(5)",
        "abs(0 - 9) + floor(3.8)",
        "8 / 0",
        "sqrt(0 - 1)"
    ];
    let plan = CALC.build_ui_plan(samples[0]);
    print "calculator_ui commands=" + str(plan.command_count) + " hits=" + str(plan.hit_count) + " route=" + str(plan.device.route);

    for expr in samples {
        let r = CALC.calculate(expr, history);
        if r.ok {
            print expr + " = " + str(r.value);
        } else {
            print expr + " -> Error: " + r.message;
        }
    }

    print "history_count=" + str(len(history));
    for row in history {
        print "history: " + row.text;
    }
}

main();
