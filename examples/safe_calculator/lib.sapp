// examples/safe_calculator/lib.sapp
// Shared safe calculator engine for the CLI/render-plan and native GUI examples.

let UI = import("stdlib/micro_gui.sapp");
let MATH = import("stdlib/math.sapp");

fn _ok(value) { return map{ ok: true, value: value, message: "" }; }
fn _bad(message) { return map{ ok: false, value: 0, message: message }; }
fn _is_digit(ch) { return str_index_of("0123456789", ch) >= 0; }
fn _is_alpha(ch) {
    if len(ch) == 0 { return false; }
    let c = strcharcodeat(ch, 0);
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or ch == "_";
}
fn _is_alnum(ch) { return _is_alpha(ch) or _is_digit(ch); }
fn _is_space(ch) { return ch == " " or ch == "\n" or ch == "\t" or ch == "\r"; }
fn _is_op(ch) { return ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "^" or ch == "%"; }
fn _lower(s) { return str_lower(str(s)); }
fn _is_func(name) {
    let n = _lower(name);
    return n == "sin" or n == "cos" or n == "tan"
        or n == "asin" or n == "acos" or n == "atan"
        or n == "sqrt" or n == "ln" or n == "log" or n == "log10" or n == "log2"
        or n == "exp" or n == "abs" or n == "ceil" or n == "floor" or n == "round"
        or n == "cbrt" or n == "fact" or n == "factorial";
}

fn tokenize(expr) {
    let tokens = [];
    let i = 0;
    while i < len(expr) {
        let ch = str_slice(expr, i, i + 1);
        if _is_space(ch) {
            i = i + 1;
        } elif _is_digit(ch) or ch == "." {
            let start = i;
            let dots = 0;
            let digits = 0;
            while i < len(expr) {
                let c = str_slice(expr, i, i + 1);
                if _is_digit(c) {
                    digits = digits + 1;
                    i = i + 1;
                } elif c == "." and dots == 0 {
                    dots = dots + 1;
                    i = i + 1;
                } else {
                    break;
                }
            }
            let text = str_slice(expr, start, i);
            if digits == 0 { return map{ ok: false, tokens: tokens, message: "number expected near '.'" }; }
            let value = try parse_number(text) catch nil;
            if value == nil { return map{ ok: false, tokens: tokens, message: "invalid number: " + text }; }
            push(tokens, map{ kind: "number", text: text, value: value });
        } elif _is_op(ch) {
            if ch == "*" and i + 1 < len(expr) and str_slice(expr, i + 1, i + 2) == "*" {
                push(tokens, map{ kind: "op", text: "^", value: 0 });
                i = i + 2;
            } else {
                push(tokens, map{ kind: "op", text: ch, value: 0 });
                i = i + 1;
            }
        } elif _is_alpha(ch) {
            let start = i;
            while i < len(expr) and _is_alnum(str_slice(expr, i, i + 1)) {
                i = i + 1;
            }
            let name = _lower(str_slice(expr, start, i));
            if name == "mod" {
                push(tokens, map{ kind: "op", text: "%", value: 0 });
            } else {
                push(tokens, map{ kind: "name", text: name, value: 0 });
            }
        } elif ch == "!" {
            push(tokens, map{ kind: "op", text: ch, value: 0 });
            i = i + 1;
        } elif ch == "(" {
            push(tokens, map{ kind: "lparen", text: ch, value: 0 });
            i = i + 1;
        } elif ch == ")" {
            push(tokens, map{ kind: "rparen", text: ch, value: 0 });
            i = i + 1;
        } else {
            return map{ ok: false, tokens: tokens, message: "unexpected character: " + ch };
        }
    }
    return map{ ok: true, tokens: tokens, message: "" };
}

fn _peek(p) {
    if p.pos >= len(p.tokens) { return map{ kind: "eof", text: "", value: 0 }; }
    return p.tokens[p.pos];
}

fn _advance(p) {
    let t = _peek(p);
    p.pos = p.pos + 1;
    return t;
}

fn _parse_expr(p) { return _parse_add(p); }

fn _apply_func(name, value) {
    let n = _lower(name);
    if n == "sin" { return _ok(MATH.sin(value)); }
    if n == "cos" { return _ok(MATH.cos(value)); }
    if n == "tan" { return _ok(MATH.tan(value)); }
    if n == "asin" {
        if value < -1 or value > 1 { return _bad("asin domain error"); }
        return _ok(MATH.asin(value));
    }
    if n == "acos" {
        if value < -1 or value > 1 { return _bad("acos domain error"); }
        return _ok(MATH.acos(value));
    }
    if n == "atan" { return _ok(MATH.atan(value)); }
    if n == "sqrt" {
        if value < 0 { return _bad("sqrt domain error"); }
        return _ok(num_sqrt(value));
    }
    if n == "ln" {
        if value <= 0 { return _bad("ln domain error"); }
        return _ok(num_ln(value));
    }
    if n == "log" or n == "log10" {
        if value <= 0 { return _bad("log domain error"); }
        return _ok(MATH.log10(value));
    }
    if n == "log2" {
        if value <= 0 { return _bad("log2 domain error"); }
        return _ok(MATH.log2(value));
    }
    if n == "exp" { return _ok(num_exp(value)); }
    if n == "abs" { return _ok(num_abs(value)); }
    if n == "ceil" { return _ok(num_ceil(value)); }
    if n == "floor" { return _ok(num_floor(value)); }
    if n == "round" { return _ok(MATH.round(value)); }
    if n == "cbrt" { return _ok(MATH.cbrt(value)); }
    if n == "fact" or n == "factorial" {
        if value < 0 { return _bad("factorial domain error"); }
        if num_floor(value) != value { return _bad("factorial needs an integer"); }
        if value > 170 { return _bad("factorial too large"); }
        return _ok(MATH.factorial(value));
    }
    return _bad("unknown function: " + name);
}

fn _parse_factor(p) {
    let t = _peek(p);
    if t.kind == "op" and (t.text == "+" or t.text == "-") {
        _advance(p);
        let r = _parse_factor(p);
        if not r.ok { return r; }
        if t.text == "-" { return _ok(0 - r.value); }
        return r;
    }
    if t.kind == "number" {
        _advance(p);
        return _ok(t.value);
    }
    if t.kind == "lparen" {
        _advance(p);
        let inside = _parse_expr(p);
        if not inside.ok { return inside; }
        let close = _peek(p);
        if close.kind != "rparen" { return _bad("missing ')'"); }
        _advance(p);
        return inside;
    }
    if t.kind == "name" {
        _advance(p);
        let name = t.text;
        if name == "pi" { return _ok(MATH.PI); }
        if name == "e" { return _ok(MATH.E); }
        if name == "tau" { return _ok(MATH.TAU); }
        if name == "phi" { return _ok(MATH.PHI); }
        if name == "sqrt2" { return _ok(MATH.SQRT2); }
        if not _is_func(name) { return _bad("unknown name: " + name); }
        let open = _peek(p);
        if open.kind != "lparen" { return _bad("function needs parentheses: " + name); }
        _advance(p);
        let arg = _parse_expr(p);
        if not arg.ok { return arg; }
        let close = _peek(p);
        if close.kind != "rparen" { return _bad("missing ')' after " + name); }
        _advance(p);
        return _apply_func(name, arg.value);
    }
    return _bad("number or '(' expected");
}

fn _parse_power(p) {
    let left = _parse_factor(p);
    if not left.ok { return left; }
    let t = _peek(p);
    if t.kind == "op" and t.text == "^" {
        _advance(p);
        let right = _parse_power(p);
        if not right.ok { return right; }
        left.value = num_pow(left.value, right.value);
    }
    return left;
}

fn _parse_mul(p) {
    let left = _parse_power(p);
    if not left.ok { return left; }
    while true {
        let t = _peek(p);
        if t.kind != "op" or (t.text != "*" and t.text != "/" and t.text != "%") { break; }
        _advance(p);
        let right = _parse_power(p);
        if not right.ok { return right; }
        if t.text == "*" {
            left.value = left.value * right.value;
        } elif t.text == "/" {
            if right.value == 0 { return _bad("division by zero"); }
            left.value = left.value / right.value;
        } else {
            if right.value == 0 { return _bad("modulo by zero"); }
            left.value = MATH.fmod(left.value, right.value);
        }
    }
    return left;
}

fn _parse_add(p) {
    let left = _parse_mul(p);
    if not left.ok { return left; }
    while true {
        let t = _peek(p);
        if t.kind != "op" or (t.text != "+" and t.text != "-") { break; }
        _advance(p);
        let right = _parse_mul(p);
        if not right.ok { return right; }
        if t.text == "+" { left.value = left.value + right.value; }
        else { left.value = left.value - right.value; }
    }
    return left;
}

fn calculate(expr, history) {
    if str_trim(expr) == "" { return _bad("empty expression"); }
    if len(expr) > 240 { return _bad("expression too long"); }
    let toks = tokenize(expr);
    if not toks.ok { return _bad(toks.message); }
    let p = map{ tokens: toks.tokens, pos: 0 };
    let r = _parse_expr(p);
    if not r.ok { return r; }
    let tail = _peek(p);
    if tail.kind != "eof" { return _bad("unexpected token: " + tail.text); }
    push(history, map{ expression: expr, result: r.value, text: expr + " = " + str(r.value) });
    return r;
}

fn build_ui_plan(display) {
    let app = UI.app("Safe Calculator", 360, 420);
    UI.add(app, UI.label("title", "Safe pblang calculator"));
    UI.add(app, UI.field("display", display, "expression"));
    UI.add(app, UI.label("keys", "basic: + - * / ^ % mod; funcs: sqrt sin cos tan ln log10 abs fact; constants: pi e"));
    UI.add(app, UI.button("clear", "Clear"));
    UI.add(app, UI.button("history", "History"));
    UI.layout_column(app, 12, 12, 320, 8, 8, 10, 4);
    return UI.prepare(app, 6, 8, 4, map{ backend: "portable", gpu_present: false });
}

export tokenize, calculate, build_ui_plan;
