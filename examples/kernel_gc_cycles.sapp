// pblang:target=kernel
// pblang:extern heap_init heap_alloc gc_new gc_set_auto gc_set_threshold gc_collections gc_live gc_set_child gc_add_root gc_remove_root gc_alloc kernel_gc_collect
// Kernel-only fixture: prepend stdlib/kernel/heap.sapp and gc.sapp and lower with
// compiler/ctranspile.transpile_kernel_int. QEMU isa-debug-exit returns 85 on pass.
fn verify(ok) { if not ok { outb(244, 1); while 1 > 0 { hlt(); } } }
fn kmain() {
    let h = kmalloc(8); let region = kmalloc(196608); heap_init(h, region, 196608);
    let g = gc_new(h); verify(g != 0); gc_set_auto(g, 0);
    let first = gc_alloc(g, 1); verify(first != 0); let prev = first; let i = 1;
    while i < 4096 {
        let next = gc_alloc(g, 1); verify(next != 0);
        verify(gc_set_child(prev, 0, next) == 1); prev = next; i = i + 1;
    }
    verify(gc_set_child(prev, 0, first) == 1);
    verify(gc_set_child(first, -1, 0) == 0); verify(gc_set_child(first, 1, 0) == 0);
    verify(gc_alloc(g, -1) == 0); verify(gc_alloc(g, 536870906) == 0);
    i = 0; while i < 300 { verify(gc_add_root(g, first) == 1); i = i + 1; }
    verify(kernel_gc_collect(g) == 0); verify(gc_live(g) == 4096);
    verify(peek32(first + 8) != 0); verify(gc_remove_root(g, first) == 300);
    verify(gc_remove_root(g, first) == 0);
    verify(kernel_gc_collect(g) == 0); verify(gc_live(g) == 0);
    // Automatic collection keeps the root and does not reclaim the new object.
    let a = gc_alloc(g, 1); verify(a != 0); verify(gc_set_child(a, 0, a) == 1);
    verify(gc_add_root(g, a) == 1); gc_set_auto(g, 1); gc_set_threshold(g, 1);
    let before = gc_collections(g); let b = gc_alloc(g, 0); verify(b != 0);
    verify(gc_collections(g) == before + 1); verify(gc_live(g) == 2);
    verify(kernel_gc_collect(g) == 0); verify(gc_live(g) == 1);
    verify(gc_remove_root(g, a) == 1); verify(kernel_gc_collect(g) == 0); verify(gc_live(g) == 0);
    // Shared descendant, branching, a duplicate edge and a back edge.
    gc_set_auto(g, 0);
    let root = gc_alloc(g, 3); let left = gc_alloc(g, 1); let right = gc_alloc(g, 1);
    let shared = gc_alloc(g, 1);
    gc_set_child(root, 0, left); gc_set_child(root, 1, right); gc_set_child(root, 2, left);
    gc_set_child(left, 0, shared); gc_set_child(right, 0, shared); gc_set_child(shared, 0, root);
    verify(gc_add_root(g, root) == 1); verify(kernel_gc_collect(g) == 0); verify(gc_live(g) == 4);
    verify(gc_remove_root(g, root) == 1); verify(kernel_gc_collect(g) == 0); verify(gc_live(g) == 0);
    // More than half the table is active, so separate scratch is required.
    // Exhaust the arena; failed scratch allocation must never sweep.
    let h2 = kmalloc(8); let r2 = kmalloc(4096); heap_init(h2, r2, 4096);
    let g2 = gc_new(h2); verify(g2 != 0); gc_set_auto(g2, 0);
    let kept = gc_alloc(g2, 0); verify(kept != 0); verify(gc_add_root(g2, kept) == 1);
    i = 0; while i < 128 { verify(gc_alloc(g2, 0) != 0); i = i + 1; }
    let filler = heap_alloc(h2, 8); while filler != 0 { filler = heap_alloc(h2, 8); }
    verify(gc_alloc(g2, 0) == 0); verify(gc_live(g2) == 129);
    verify(kernel_gc_collect(g2) == 0 - 1); verify(gc_live(g2) == 129);
    verify(gc_collections(g2) == 0);
    i = 1; while i < 64 { verify(gc_add_root(g2, kept) == 1); i = i + 1; }
    verify(gc_add_root(g2, kept) == 0); verify(peek32(g2 + 24) == 64);
    verify(gc_remove_root(g2, kept) == 64);
    verify(kernel_gc_collect(g2) == 0); verify(gc_live(g2) == 0);
    let h3 = kmalloc(8); let r3 = kmalloc(16384); heap_init(h3, r3, 16384);
    let g3 = gc_new(h3); verify(g3 != 0); gc_set_auto(g3, 0);
    i = 0; while i < 256 { verify(gc_alloc(g3, 0) != 0); i = i + 1; }
    filler = heap_alloc(h3, 8); while filler != 0 { filler = heap_alloc(h3, 8); }
    verify(gc_alloc(g3, 0) == 0); verify(gc_live(g3) == 256);
    verify(kernel_gc_collect(g3) == 0); verify(gc_live(g3) == 0);
    let h4 = kmalloc(8); let r4 = kmalloc(512); heap_init(h4, r4, 512);
    i = 0; while i < 10000 { verify(gc_new(h4) == 0); i = i + 1; }
    verify(heap_alloc(h4, 496) != 0);
    // Control and object metadata fit, but the root table does not: unwind both.
    let h5 = kmalloc(8); let r5 = kmalloc(1280); heap_init(h5, r5, 1280);
    i = 0; while i < 1000 { verify(gc_new(h5) == 0); i = i + 1; }
    verify(heap_alloc(h5, 1272) != 0);
    outb(244, 42); while 1 > 0 { hlt(); }
}
