let B = import("stdlib:ai_turn_budget.sapp");
// Synthetic caller-defined fixed units per token, not a provider price list.
let prices = B.rates(3, 7, 1, 4);
let prompt = B.usage(10, 0, 20, 2);
let plan = B.affordable_output(prices, prompt, 100, 20);
assert(plan.allowed and plan.output_tokens == 6, "six output tokens fit the estimate");
print "Estimated affordable output tokens: " + str(plan.output_tokens);
// Provider-reported actual usage can differ. Record the full charge regardless.
let actual = B.account(prices, B.usage(10, 8, 20, 2), 100);
assert(actual.spent_units == 114 and actual.excess_units == 14, "overspend stays visible");
print "Actual units: " + str(actual.spent_units);
print "Units above budget: " + str(actual.excess_units);
