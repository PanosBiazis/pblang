let Binary = import("stdlib:host_pbck_frame_binary.sapp");
let FrameVM = import("stdlib:host_pbck_frame_vm.sapp");
let Plan = import("stdlib:host_pbck_frame_plan.sapp");

let decoded = map{
    format: "host-pbck-v1", version: 1,
    chunk: map{ instructions: [
        map{ op: 14, operand: 0 }, map{ op: 0, operand: 1 },
        map{ op: 31, operand: 1 }, map{ op: 33 }
    ], constants: ["device_name", "android"], source_name: nil }
};
let asset = Binary.encode_plan(Plan.build_decoded(decoded));
let result = FrameVM.run_bytes(asset, map{
    adapters: map{ device_name: fn(args) { return "PBRemote on " + args[0]; } }
});
print result.value;
print "steps=" + str(result.runtime.steps) + " host_calls=" + str(result.runtime.host_calls);
