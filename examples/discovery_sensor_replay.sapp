// Offline synthetic sensor lessons. No device, network, timer or file access.
let Samples=import("stdlib:sample_series.sapp");
let times=[0,1000,3000,6000];let measured=[10,14,18,12];
let before=json_stringify(map{times:times,measured:measured});
// Uneven time spacing matters: at 2000 ms the estimate is halfway from 14 to 18.
let query=[0,1000,2000,3000,4500,6000];
let estimated=Samples.interpolate(times,measured,query);
assert(estimated==[10,14,16,18,15,12],"offline interpolation and exact endpoints");
// A trailing mean is in sample space, not a time-weighted mean of uneven samples.
let smooth=Samples.moving_mean(measured,2);let smooth_times=[];
for i in range(smooth.first_source_index,len(times)) {array_push(smooth_times,times[i]);}
assert(smooth.values==[12,16,15] and smooth_times==[1000,3000,6000],"complete windows aligned to final sample");
// A configurable gap policy belongs to the caller. Here the maximum is 2000 ms.
let max_gap_ms=2000;let supported_queries=[];let rejected_queries=[];
for t in query {
 let exact=false;for known in times {if known==t {exact=true;}}
 let supported=exact;
 for i in range(1,len(times)) {if t>times[i-1] and t<times[i] and times[i]-times[i-1]<=max_gap_ms {supported=true;}}
 if supported {array_push(supported_queries,t);} else {array_push(rejected_queries,t);}
}
let gap_limited=Samples.interpolate(times,measured,supported_queries);
assert(supported_queries==[0,1000,2000,3000,6000] and rejected_queries==[4500],"long gap rejected, measured endpoint retained");
assert(gap_limited==[10,14,16,18,12],"gap-filtered estimates");
let outside_rejected=(try Samples.interpolate(times,measured,[6001]) catch nil)==nil;
let duplicate_time_rejected=(try Samples.interpolate([0,1000,1000],[1,2,3],[500]) catch nil)==nil;
let reversed_time_rejected=(try Samples.interpolate([1000,0],[1,2],[500]) catch nil)==nil;
assert(outside_rejected and duplicate_time_rejected and reversed_time_rejected,"invalid timelines do not produce plausible results");
assert(json_stringify(map{times:times,measured:measured})==before,"source samples unchanged");
print json_stringify(map{format:"pblang.sensor-replay-lessons.v1",synthetic:true,device_accessed:false,
 offline_replay:map{query_ms:query,estimated_values:estimated,values_are_measurements:false},
 sample_mean:map{window:smooth.window,time_ms:smooth_times,values:smooth.values,time_weighted:false},
 gap_policy:map{max_gap_ms:max_gap_ms,accepted_ms:supported_queries,rejected_ms:rejected_queries,values:gap_limited},
 invalid_timeline:map{outside_rejected:outside_rejected,duplicate_time_rejected:duplicate_time_rejected,reversed_time_rejected:reversed_time_rejected}});
