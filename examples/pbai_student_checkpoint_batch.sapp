// Explicit comparison of two files; all returned handles are closed at exit.
let AI=import("stdlib/pbai.sapp");let S=import("stdlib:pbai_checkpoint_scope.sapp");
let batch=AI.neural_specialist_checkpoint_batch_bind(S);
let directory=env_get("PBAI_CHECKPOINT_TEST_DIR");
assert(type(directory)=="string" and directory!="","explicit private checkpoint directory required");
let saved=[];
let result=batch.with_files([path_join(directory,"student.json"),path_join(directory,"candidate.json")],fn(handles){
 saved=handles;
 return map{ok:true,value:map{current:handles[0].predict([6,0]).token,candidate:handles[1].predict([6,0]).token}};
});
let closed=true;for handle in saved {if handle.close() {closed=false;}}
assert(closed,"batch closes all acquired handles");
print json_stringify(map{format:"pbai.checkpoint-batch.example.v1",ok:result.ok,stage:result.stage,
 acquired_count:result.acquired_count,cleanups_attempted:result.cleanups_attempted,cleanup_ok:result.cleanup_ok,
 body_status:result.body_status,value:result.value,globally_activated:false});
