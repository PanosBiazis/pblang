let GCD = import("gcd.sapp");

fn require(condition, message) {
    if not condition { throw "FAIL euclidean_gcd: " + message; }
}

let classic = GCD.analyze(1071, 462);
require(classic.ok and classic.gcd == 21 and classic.library_verified,
    "classic GCD agrees with the standard library");
require(len(classic.steps) == 3
    and classic.steps[0].remainder == 147
    and classic.steps[1].remainder == 21
    and classic.steps[2].remainder == 0,
    "the complete Euclidean trace is retained");

let negative = GCD.analyze(-48, 18);
require(negative.ok and negative.gcd == 6 and negative.library_verified,
    "negative operands are normalized");
require(GCD.analyze(0, 0).gcd == 0, "the documented zero-zero convention is stable");
require(GCD.analyze(0, 15).gcd == 15, "a zero operand is supported");
require(not GCD.analyze(1.5, 3).ok, "fractional operands fail closed");
require(not GCD.analyze("48", 18).ok, "non-numeric operands fail closed");

require(GCD.parse_integer("  -48 ").value == -48,
    "bounded decimal parsing accepts surrounding whitespace");
require(GCD.parse_integer(str(GCD.MAX_SAFE_INTEGER)).ok,
    "the exact integer boundary is accepted");
require(not GCD.parse_integer("9007199254740992").ok,
    "values beyond the exact integer boundary are rejected");
require(not GCD.parse_integer("1.5").ok
    and not GCD.parse_integer("1e3").ok
    and not GCD.parse_integer(str_repeat("9", 4096)).ok,
    "fractional, exponent, and oversized textual forms are rejected");

print "euclidean_gcd_pass";
