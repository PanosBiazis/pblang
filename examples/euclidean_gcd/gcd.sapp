let ALGO = import("stdlib:algo.sapp");

let MAX_SAFE_INTEGER = 9007199254740991;

fn _integer(value) {
    return type(value) == "number" and value == num_floor(value)
        and value >= 0 - MAX_SAFE_INTEGER and value <= MAX_SAFE_INTEGER;
}

fn parse_integer(text) {
    if type(text) != "string" {
        return map{ ok: false, error: "value must be text" };
    }
    let clean = str_trim(text);
    if len(clean) == 0 or len(clean) > 17
       or not regex_match(clean, "^-?[0-9]+$") {
        return map{ ok: false,
            error: "value must be a base-10 integer in the exact PBLang range" };
    }
    let value = try parse_number(clean) catch nil;
    if not _integer(value) {
        return map{ ok: false,
            error: "value is outside the exact PBLang integer range" };
    }
    return map{ ok: true, value: value };
}

fn analyze(a, b) {
    if not _integer(a) or not _integer(b) {
        return map{ ok: false,
            error: "both operands must be exact PBLang integers" };
    }

    let x = num_abs(a);
    let y = num_abs(b);
    let steps = [];
    while y != 0 {
        let remainder = num_mod(x, y);
        array_push(steps, map{ dividend: x, divisor: y,
            quotient: num_floor(x / y), remainder: remainder });
        x = y;
        y = remainder;
    }

    let library_result = ALGO.gcd(a, b);
    return map{ ok: true, first: a, second: b, gcd: x, steps: steps,
        library_result: library_result, library_verified: x == library_result };
}

fn format_step(step) {
    return str(step.dividend) + " = " + str(step.divisor) + " * "
        + str(step.quotient) + " + " + str(step.remainder);
}

export MAX_SAFE_INTEGER, parse_integer, analyze, format_step;
