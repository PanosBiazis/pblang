let OS = import("stdlib:os.sapp");
let GCD = import("gcd.sapp");

fn usage() {
    print "Usage: pblang run examples/euclidean_gcd/main.sapp -- <integer-a> <integer-b>";
}

fn main() {
    let args = OS.script_args();
    if len(args) != 2 {
        usage();
        return false;
    }

    let first = GCD.parse_integer(args[0]);
    let second = GCD.parse_integer(args[1]);
    if not first.ok {
        print "Invalid first integer: " + first.error;
        return false;
    }
    if not second.ok {
        print "Invalid second integer: " + second.error;
        return false;
    }

    let report = GCD.analyze(first.value, second.value);
    if not report.ok {
        print "Unable to calculate GCD: " + report.error;
        return false;
    }

    print "Euclidean algorithm";
    for step in report.steps { print "  " + GCD.format_step(step); }
    print "GCD(" + str(report.first) + ", " + str(report.second)
        + ") = " + str(report.gcd);
    print "Standard library cross-check: "
        + if report.library_verified { "passed" } else { "failed" };
    return report.library_verified;
}

main();
