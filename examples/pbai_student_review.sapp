let AI=import("stdlib/pbai.sapp");let R=import("stdlib:resource_scope.sapp");
// Capture the bundled closer immediately, before export or use can fail.
fn close_owned(closer){return fn(){return map{ok:true,value:closer()};};}
fn use_owned(scope){
// Synthetic explicit examples only. No conversation reads or automatic saving.
let previous_training=[map{x:[0],y:4},map{x:[1,0],y:4}];
let previous_holdout=[map{x:[7,0],y:4}];
let teacher=AI.neural_specialist_train([previous_training[0]],previous_holdout);
let student=AI.neural_specialist_distill(teacher.artifact,[[0],[1,0]],previous_holdout);
scope.defer(close_owned(student.close));
let parent=student.checkpoint();assert(student.close(),"release checkpoint seed");
let history=AI.neural_specialist_student_history(parent,previous_training,previous_holdout);
let reviewed=AI.neural_specialist_student_continue_reviewed(parent,history,
    [map{x:[2,0],y:4},map{x:[3,0],y:4}],[map{x:[4,0],y:4}]);
scope.defer(close_owned(reviewed.close));
print json_stringify(reviewed.report());
if reviewed.report().passed {
    print json_stringify(reviewed.accept());
    print json_stringify(reviewed.predict([5,0]));
    // Saving/exporting remains a separate decision. Restore this handle now.
    print json_stringify(reviewed.rollback());
}
return map{ok:true,value:nil};
}
let result=R.with_scope(use_owned);
assert(result.ok and result.cleanup_ok,"student workflow and explicit cleanup complete");
