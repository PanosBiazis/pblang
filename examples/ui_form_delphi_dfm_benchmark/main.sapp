let DFM = import("stdlib:ui_form_delphi_dfm.sapp");
let Benchmark = import("stdlib:benchmark.sapp");

let source = "object BenchForm: TBenchForm\n Caption = 'Benchmark'\n"
    + " ClientWidth = 960\n ClientHeight = 720\n";
let i = 0;
while i < 40 {
    source = source + " object Button" + str(i) + ": TButton\n"
        + "  Left = " + str((i % 8) * 110) + "\n"
        + "  Top = " + str(num_floor(i / 8) * 44) + "\n"
        + "  Width = 100\n  Height = 32\n"
        + "  Caption = 'Button " + str(i) + "'\n"
        + "  OnClick = Button" + str(i) + "Click\n end\n";
    i = i + 1;
}
source = source + "end\n";

fn import_batch() {
    let count = 0; let last = nil;
    while count < 3 {
        last = DFM.import_text(source, "benchmark.dfm");
        if not last.ok or last.widget_count != 40 { throw "benchmark correctness gate failed"; }
        count = count + 1;
    }
    return last.widget_count;
}

Benchmark.warmup(import_batch, 5);
let samples = []; i = 0;
while i < 9 {
    let started = now_ms(); let count = import_batch();
    if count != 40 { throw "benchmark checksum mismatch"; }
    array_push(samples, (now_ms() - started) / 3.0); i = i + 1;
}
let result = Benchmark.stats("delphi-dfm-import-40-widgets-ms-per-import", samples);
print json_stringify(map{ok:true,format:"pblang.delphi-dfm-benchmark.v1",
    warmups:5,samples_ms_per_import:samples,median_ms:result.median_ms,
    p95_ms:result.p95_ms,stability:result.stability,widget_count:40,
    source_bytes:len(str_to_bytes(source)),effects:false});
