let T=import("stdlib:translation_review.sapp");
// 1. Language and field order can change without losing the message contract.
let source=[map{id:"welcome",text:"Hello {{name}}, {{count}} tasks await."}];
let greek=[map{id:"welcome",text:"Εκκρεμούν {{count}} εργασίες, {{name}}."}];
assert(T.review(source,greek).ok,"reordered Greek fields");
// 2. Missing message and unexpected field are separate, inspectable diagnostics.
let incomplete=T.review([source[0],map{id:"exit",text:"Exit"}],[map{id:"welcome",text:"Γεια {{person}}"}]);
assert(incomplete.missing_ids==["exit"] and incomplete.messages[0].missing_fields==["name","count"] and incomplete.messages[0].extra_fields==["person"],"missing IDs and fields");
// 3. Repetition counts remain visible; equal sets alone would miss this change.
let repeated=T.review([map{id:"repeat",text:"{{name}} / {{name}}"}],[map{id:"repeat",text:"{{name}}"}]);
assert(repeated.messages[0].changed_counts==[map{name:"name",source_count:2,translated_count:1}],"repeated field changed");
print json_stringify(map{valid:T.review(source,greek),incomplete:incomplete,repeated:repeated});
