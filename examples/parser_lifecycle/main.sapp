let T = import("stdlib:compiler/tokenizer.sapp");
let P = import("stdlib:compiler/parser.sapp");
let caller_tokens = T.tokenize("let = ;");
let result = P.parse(caller_tokens);
// Normal and diagnostic returns automatically release the parser's references.
assert(len(result.errors) > 0, "the caller still owns the diagnostic result");
assert(P.retained_state().tokens == 0, "no retained parser token buffer");
assert(len(caller_tokens) > 0, "the caller's array remains intact");
// Optional debug reset after a caught direct-parser exception. Do not reset a
// parser while it is running; this module is not a reentrant parser service.
P.discard_state();
print "retained parser buffers: " + json_stringify(P.retained_state());
