let OS=import("stdlib:os.sapp");
let Bridge=import("./bridge.sapp");
let args=OS.script_args();
if len(args)==0 {
    print "Microcontroller connectivity: explicit USB status to local MQTT, once.";
    print "UNO: uno-r4-wifi /absolute/export.json /dev/ttyACM0 1883 1 1 --confirmed";
    print "ESP: esp32-wroom-32d /dev/ttyUSB0 1883 1 --confirmed";
    print "Broker must already listen on 127.0.0.1. No firmware upload or MCU Wi-Fi.";
} else {
    let result=Bridge.run(args);print json_stringify(result);
    if not result.ok {OS.exit(1);}
}
