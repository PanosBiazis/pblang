// tutorial_web_app/main.sapp
// ── Full-Stack Web App Demo ──────────────────────────────────────────────
// Demonstrates: HTTP server with routing, middleware, JSON API, static files.
// Uses: import, functions, maps, arrays, error handling.
//
// Run with:
//   pblang run examples/tutorial_web_app/main.sapp
//
// Then visit:
//   http://127.0.0.1:8080/            — welcome page (static HTML)
//   http://127.0.0.1:8080/api/users   — JSON API list
//   http://127.0.0.1:8080/api/stats   — JSON API stats
//   http://127.0.0.1:8080/health      — health check

let http = import("stdlib:http_server.sapp");
let json = import("stdlib:json.sapp");
let fs   = import("stdlib:fs.sapp");

// ── In-Memory "Database" ─────────────────────────────────────────────────

let users = [
    map{ id: 1, name: "Alice",   role: "admin",    email: "alice@example.com" },
    map{ id: 2, name: "Bob",     role: "user",     email: "bob@example.com"   },
    map{ id: 3, name: "Charlie", role: "user",     email: "charlie@example.com"},
    map{ id: 4, name: "Diana",   role: "moderator", email: "diana@example.com" },
];

// ── Helper: generate an HTML page ────────────────────────────────────────

fn html_page(title, body_content) {
    let h = "<!DOCTYPE html>\n<html>\n<head>\n";
    h = h + "<meta charset=\"utf-8\">\n";
    h = h + "<title>" + title + "</title>\n";
    h = h + "<style>\n";
    h = h + "  body { font-family: system-ui, sans-serif; max-width: 720px; margin: 2em auto; padding: 0 1em; color: #222; }\n";
    h = h + "  h1 { color: #1a5276; }\n";
    h = h + "  table { border-collapse: collapse; width: 100%; }\n";
    h = h + "  th, td { padding: 8px 12px; border-bottom: 1px solid #ddd; text-align: left; }\n";
    h = h + "  th { background: #f5f6fa; }\n";
    h = h + "  .badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 0.85em; }\n";
    h = h + "  .admin { background: #fce4ec; color: #c62828; }\n";
    h = h + "  .moderator { background: #fff3e0; color: #e65100; }\n";
    h = h + "  .user { background: #e8f5e9; color: #2e7d32; }\n";
    h = h + "</style>\n</head>\n<body>\n";
    h = h + "<h1>" + title + "</h1>\n";
    h = h + body_content;
    h = h + "<hr>\n<p><em>Powered by pblang — a safe systems language.</em></p>\n";
    h = h + "</body>\n</html>";
    return h;
}

// ── Route Handlers ───────────────────────────────────────────────────────

// Homepage — render table of users as HTML
fn handle_home(req) {
    let rows = "";
    for i len(users) {
        let u = users[i];
        rows = rows + "<tr>";
        rows = rows + "<td>" + str(u.id) + "</td>";
        rows = rows + "<td>" + u.name + "</td>";
        rows = rows + "<td><span class=\"badge " + u.role + "\">" + u.role + "</span></td>";
        rows = rows + "<td>" + u.email + "</td>";
        rows = rows + "</tr>\n";
    }
    let body = "<table><thead><tr><th>ID</th><th>Name</th><th>Role</th><th>Email</th></tr></thead><tbody>" + rows + "</tbody></table>";
    return map{ status: 200, body: html_page("pblang Web App — User Directory", body), content_type: "text/html" };
}

// JSON API — list all users
fn handle_api_users(req) {
    return map{ status: 200, json: users };
}

// JSON API — aggregate stats
fn handle_api_stats(req) {
    // Count role distribution
    let role_counts = map{ admin: 0, moderator: 0, user: 0 };
    let total = 0;
    for i len(users) {
        let role = users[i].role;
        role_counts[role] = try role_counts[role] catch 0;
        role_counts[role] = role_counts[role] + 1;
        total = total + 1;
    }
    return map{
        status: 200,
        json: map{
            total_users: total,
            roles: role_counts,
            timestamp: clock(),
        }
    };
}

// Health check
fn handle_health(req) {
    let status = map{
        status: "ok",
        uptime: clock(),
        memory: "runtime-tracked",
    };
    return map{ status: 200, json: status };
}

// User lookup by ID: /api/users/:id
fn handle_api_user_by_id(req) {
    let id_str = try req.params.id catch "0";
    let id = try parse_number(id_str) catch 0;

    for i len(users) {
        if users[i].id == id {
            return map{ status: 200, json: users[i] };
        }
    }
    return map{ status: 404, json: map{ error: "user not found", id: id } };
}

// ── Static file serving ──────────────────────────────────────────────────

fn handle_static(req) {
    return http.static_file_response("examples/tutorial_web_app/static", req.path);
}

// ── Build the App ────────────────────────────────────────────────────────

let app = http.app_new();

// Global middleware: log every request
http.app_use(app, http.mw_log());

// Routes: exact matches first, then parameterized routes
http.app_get(app, "/", handle_home);
http.app_get(app, "/api/users", handle_api_users);
http.app_get(app, "/api/stats", handle_api_stats);
http.app_get(app, "/api/users/:id", handle_api_user_by_id);
http.app_get(app, "/health", handle_health);

// ── Error Handling Wrapper ───────────────────────────────────────────────

fn safe_handler(req) {
    return try http.app_handle(app, req) catch map{
        status: 500,
        body: "<h1>500 Internal Server Error</h1><p>Something went wrong.</p>",
        content_type: "text/html",
    };
}

// ── Start the Server ─────────────────────────────────────────────────────

print "╔══════════════════════════════════════════════╗";
print "║   pblang Full-Stack Web App                 ║";
print "║   Listening on http://127.0.0.1:8080        ║";
print "║                                              ║";
print "║   Endpoints:                                 ║";
print "║     GET  /            — User directory       ║";
print "║     GET  /api/users   — JSON user list       ║";
print "║     GET  /api/stats   — JSON stats           ║";
print "║     GET  /api/users/1 — JSON user by ID      ║";
print "║     GET  /health      — Health check         ║";
print "╚══════════════════════════════════════════════╝";

http.serve_forever("127.0.0.1:8080", safe_handler);
