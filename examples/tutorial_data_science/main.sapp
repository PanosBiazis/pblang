// tutorial_data_science/main.sapp
// ── Data Processing Demo ─────────────────────────────────────────────────
// Demonstrates: CSV import, filtering, grouping, aggregation.
// Uses: iterators, map/filter/reduce patterns, imports.
// Outputs basic statistics to the console.
//
// Run with:
//   pblang run examples/tutorial_data_science/main.sapp

let csv  = import("stdlib:csv.sapp");
let math = import("stdlib:math.sapp");
let fs   = import("stdlib:fs.sapp");

// ── Sample Dataset (inline CSV) ──────────────────────────────────────────
// Simulates a product sales database.

let raw_csv = "id,product,category,price,quantity,date\n" +
              "1,Widget A,electronics,29.99,150,2024-01-15\n" +
              "2,Widget B,electronics,49.99,80,2024-01-20\n" +
              "3,Gadget X,toys,14.99,300,2024-02-01\n" +
              "4,Gadget Y,toys,19.99,200,2024-02-10\n" +
              "5,Sensor Pro,electronics,99.99,45,2024-02-15\n" +
              "6,Toy Car,toys,9.99,500,2024-03-01\n" +
              "7,LED Strip,electronics,24.99,120,2024-03-10\n" +
              "8,Puzzle Box,toys,12.49,175,2024-03-15\n" +
              "9,Smart Hub,electronics,149.99,30,2024-04-01\n" +
              "10,Board Game,toys,34.99,90,2024-04-10\n";

// ── Step 1: Parse CSV ───────────────────────────────────────────────────

print "=== Step 1: Parse CSV ===";
let rows = csv.parse(raw_csv, ",", true);
print "Parsed " + str(len(rows)) + " rows";

// Show first 3 rows
print "\nFirst 3 rows:";
for i 3 {
    print "  " + json_stringify(rows[i]);
}

// ── Step 2: Type Conversion ─────────────────────────────────────────────
// CSV values are strings — convert numeric fields.

print "\n=== Step 2: Type Conversion ===";

fn convert_row(row) {
    let price = try parse_number(row.price) catch 0.0;
    let qty   = try parse_number(row.quantity) catch 0;
    let id    = try parse_number(row.id) catch 0;
    return map{
        id: id,
        product: row.product,
        category: row.category,
        price: price,
        quantity: qty,
        date: row.date,
    };
}

let data = [];
for i len(rows) {
    data[i] = convert_row(rows[i]);
}

print "Converted " + str(len(data)) + " rows to typed records";

// ── Step 3: Filtering ───────────────────────────────────────────────────
// Find all electronics products

print "\n=== Step 3: Filtering (electronics only) ===";

fn is_electronics(item) {
    return item.category == "electronics";
}

let electronics_only = [];
for i len(data) {
    if is_electronics(data[i]) {
        electronics_only[len(electronics_only)] = data[i];
    }
}

print "Electronics products: " + str(len(electronics_only));
for i len(electronics_only) {
    let e = electronics_only[i];
    print "  " + e.product + " — $" + str(e.price) + " x " + str(e.quantity) + " units";
}

// ── Step 4: Mapping (transformations) ───────────────────────────────────
// Compute revenue for each item

print "\n=== Step 4: Map — Revenue per product ===";

fn compute_revenue(item) {
    let rev = item.price * item.quantity;
    return map{
        product: item.product,
        category: item.category,
        revenue: rev,
        date: item.date,
    };
}

let revenue_data = [];
for i len(data) {
    revenue_data[i] = compute_revenue(data[i]);
}

// Sort by revenue (descending) — simple bubble sort for demo
fn sort_by_revenue(arr) {
    let result = [];
    for i len(arr) { result[i] = arr[i]; }

    for i len(result) {
        for j len(result) {
            if result[i].revenue > result[j].revenue {
                let tmp = result[i];
                result[i] = result[j];
                result[j] = tmp;
            }
        }
    }
    return result;
}

let sorted = sort_by_revenue(revenue_data);
for i len(sorted) {
    let s = sorted[i];
    print "  " + s.product + " — $" + str(s.revenue) + " revenue";
}

// ── Step 5: Aggregation / Grouping ──────────────────────────────────────
// Total revenue per category

print "\n=== Step 5: Group by category + Aggregate ===";

fn group_by_category(items) {
    let groups = map{};
    for i len(items) {
        let cat = items[i].category;
        if map_has(groups, cat) == false {
            groups[cat] = [];
        }
        let arr = groups[cat];
        arr[len(arr)] = items[i];
        groups[cat] = arr;
    }
    return groups;
}

let grouped = group_by_category(data);

let cats = map_keys(grouped);
for i len(cats) {
    let cat = cats[i];
    let items = grouped[cat];

    // Compute aggregates
    let total_revenue = 0.0;
    let total_qty = 0;
    let min_price = nil;
    let max_price = nil;

    for j len(items) {
        let rev = items[j].price * items[j].quantity;
        total_revenue = total_revenue + rev;
        total_qty = total_qty + items[j].quantity;

        if min_price == nil or items[j].price < min_price {
            min_price = items[j].price;
        }
        if max_price == nil or items[j].price > max_price {
            max_price = items[j].price;
        }
    }

    let avg_price = total_revenue / total_qty;

    print "\n  Category: " + cat;
    print "    Products:      " + str(len(items));
    print "    Total Revenue: $" + str(total_revenue);
    print "    Total Qty:     " + str(total_qty);
    print "    Min Price:     $" + str(min_price);
    print "    Max Price:     $" + str(max_price);
    print "    Avg Price:     $" + str(avg_price);
}

// ── Step 6: Overall Statistics ──────────────────────────────────────────

print "\n=== Step 6: Overall Statistics ===";

fn total_revenue(items) {
    let total = 0.0;
    for i len(items) {
        total = total + items[i].price * items[i].quantity;
    }
    return total;
}

fn total_items(items) {
    let total = 0;
    for i len(items) { total = total + items[i].quantity; }
    return total;
}

let grand_revenue = total_revenue(data);
let grand_items   = total_items(data);
let avg_order     = grand_revenue / len(data);

print "Total Products Sold: " + str(grand_items);
print "Grand Revenue:       $" + str(grand_revenue);
print "Average per Product: $" + str(avg_order);

// ── Step 7: Finding top performers ──────────────────────────────────────

print "\n=== Step 7: Top Performers ===";

fn product_score(item) {
    // Score = revenue weighted by category bonus
    let revenue = item.price * item.quantity;
    let bonus = 1.0;
    if item.category == "electronics" { bonus = 1.5; }
    return revenue * bonus;
}

let best_product = data[0];
let best_score = product_score(data[0]);
for i len(data) {
    let score = product_score(data[i]);
    if score > best_score {
        best_score = score;
        best_product = data[i];
    }
}

print "Best product: " + best_product.product;
print "  Category: " + best_product.category;
print "  Revenue: $" + str(best_product.price * best_product.quantity);

// ── Step 8: Export results as CSV ───────────────────────────────────────

print "\n=== Step 8: Export Summary ===";
let summary = [];
for i len(sorted) {
    summary[i] = map{
        product: sorted[i].product,
        category: sorted[i].category,
        revenue: sorted[i].revenue,
    };
}

let output_csv = csv.stringify(summary, ",", ["product", "category", "revenue"]);
print "Exported " + str(len(summary)) + " summary rows as CSV:";
print output_csv;

// Save to file
let write_ok = try fs.write("examples/tutorial_data_science/output_summary.csv", output_csv) catch nil;
if write_ok == nil {
    print "Summary saved to output_summary.csv";
}

print "\n=== Done! ===";
