//
// scripts/compile_native.sapp — Pure-PBLang Multi-File Flattener & Native Compiler
//
// Replaces scripts/compile_native.sh. Flattens <main.sapp> + transitive import() modules
// via stdlib:source_inliner.sapp (`inline_file_prefixed`), then runs `pblang compile`.
//
// Usage: ./pblang run scripts/compile_native.sapp --allow-all -- <main.sapp> <output> [project_root]

let Inliner = import("stdlib:source_inliner.sapp");
let Path = import("stdlib:path.sapp");

fn _collect_args() {
    let raw_env = env_get("PBLANG_SCRIPT_ARGS");
    if raw_env != nil and raw_env != "" {
        let parts = str_split(raw_env, "\n");
        let env_out = [];
        let k = 0;
        while k < len(parts) {
            if parts[k] != "" { array_push(env_out, parts[k]); }
            k = k + 1;
        }
        return env_out;
    }
    let argv = try os_args() catch [];
    if not is_array(argv) { return []; }
    let n = len(argv);
    let i = 0;
    let found = false;
    while i < n {
        let a = str(argv[i]);
        i = i + 1;
        if str_ends_with(a, ".sapp") or str_ends_with(a, ".pbck") { found = true; break; }
    }
    if not found { return []; }
    while i < n {
        let a2 = str(argv[i]);
        if a2 == "--" { i = i + 1; break; }
        if not str_starts_with(a2, "-") { break; }
        i = i + 1;
    }
    let out = [];
    while i < n {
        array_push(out, str(argv[i]));
        i = i + 1;
    }
    return out;
}

fn _find_pb() {
    let env_b = env_get("PB");
    if env_b != nil and env_b != "" and fs_exists(env_b) { return env_b; }
    if fs_exists("./pblang") { return "./pblang"; }
    if fs_exists("target/release/pblang") { return "target/release/pblang"; }
    return "pblang";
}

let args = _collect_args();
if len(args) < 2 {
    eprint("usage: ./pblang run scripts/compile_native.sapp --allow-all -- <main.sapp> <output> [project_root]\n");
    os_exit(2);
}

let main_arg = args[0];
let out_bin = args[1];
let main_abs = Path.normalize(Path.absolute(main_arg));
let proj_root = if len(args) >= 3 { Path.normalize(Path.absolute(args[2])) } else { Path.dirname(main_abs) };
let base_name = Path.basename(main_abs);
let pb_bin = _find_pb();

let flat_file = "/tmp/pb_compile_native_" + str(num_floor(now_ms())) + ".sapp";

let inl_res = nil;
if Path.normalize(cwd()) == proj_root {
    inl_res = Inliner.inline_file_prefixed(base_name);
} else {
    inl_res = Inliner.inline_file_prefixed(main_abs);
}

if not is_map(inl_res) or not inl_res.ok {
    let reason = if is_map(inl_res) and map_has(inl_res, "reason") { str(inl_res.reason) } else { "unknown" };
    println("INLINE_FAIL " + reason);
    eprint("compile_native: flattening failed (see reason above).\n");
    os_exit(1);
}

fs_write(flat_file, inl_res.source);
println("INLINE_OK modules=" + str(inl_res.modules) + " bytes=" + str(len(inl_res.source)));

let comp = proc_spawn_wait(pb_bin, ["compile", flat_file, "--out", out_bin]);
try fs_remove(flat_file) catch nil;

if comp.exit_code == 0 and fs_exists(out_bin) {
    let sz = len(fs_read_bytes(out_bin));
    println("compile_native: built " + out_bin + " (" + str(sz) + " bytes)");
} else {
    if comp.stderr != "" { eprint(comp.stderr); }
    eprint("compile_native: native compile failed.\n");
    os_exit(1);
}
