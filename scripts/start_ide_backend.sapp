//
// scripts/start_ide_backend.sapp — Pure-PBLang Loopback IDE Backend Launcher
//
// Replaces scripts/start-ide-backend.sh. Validates TCP port in 1..65535 (default 8090,
// exit 2 on invalid port) and starts `serve --port <PORT>`.

fn _collect_args() {
    let raw_env = env_get("PBLANG_SCRIPT_ARGS");
    if raw_env != nil and raw_env != "" {
        let parts = str_split(raw_env, "\n");
        let env_out = [];
        let k = 0;
        while k < len(parts) {
            if parts[k] != "" { array_push(env_out, parts[k]); }
            k = k + 1;
        }
        return env_out;
    }
    let argv = try os_args() catch [];
    if not is_array(argv) { return []; }
    let n = len(argv);
    let i = 0;
    let found = false;
    while i < n {
        let a = str(argv[i]);
        i = i + 1;
        if str_ends_with(a, ".sapp") or str_ends_with(a, ".pbck") { found = true; break; }
    }
    if not found { return []; }
    while i < n {
        let a2 = str(argv[i]);
        if a2 == "--" { i = i + 1; break; }
        if not str_starts_with(a2, "-") { break; }
        i = i + 1;
    }
    let out = [];
    while i < n {
        array_push(out, str(argv[i]));
        i = i + 1;
    }
    return out;
}

fn _parse_valid_port(s: string) {
    if len(s) == 0 or len(s) > 5 { return -1; }
    let acc = 0;
    let i = 0;
    while i < len(s) {
        let c = strcharcodeat(s, i);
        if c < 48 or c > 57 { return -1; }
        acc = acc * 10 + (c - 48);
        i = i + 1;
    }
    if acc < 1 or acc > 65535 { return -1; }
    return acc;
}

let args = _collect_args();
let port_raw = if len(args) > 0 { args[0] } else { "8090" };
let port_num = _parse_valid_port(port_raw);
if port_num < 0 {
    eprint("Invalid port: " + port_raw + "\n");
    eprint("Usage: ./pblang run scripts/start_ide_backend.sapp --allow-all -- [port]\n");
    os_exit(2);
}

let root = cwd();
if not fs_exists(root + "/pblang.toml") and fs_exists(root + "/../pblang.toml") {
    root = root + "/..";
}

let bin_path = "";
if fs_exists(root + "/pblang") {
    bin_path = root + "/pblang";
} elif fs_exists(root + "/target/release/pblang") {
    bin_path = root + "/target/release/pblang";
} elif fs_exists(root + "/target/debug/pblang") {
    bin_path = root + "/target/debug/pblang";
}

let res = if bin_path != "" {
    proc_spawn_wait(bin_path, ["serve", "--port", str(port_num)])
} else {
    proc_spawn_wait("cargo", ["run", "--", "serve", "--port", str(port_num)])
};
if res.stdout != "" { print(res.stdout); }
if res.stderr != "" { eprint(res.stderr); }
os_exit(res.exit_code);
