#!/usr/bin/env bash
# scripts/t — compact pblang test/check runner (so you don't type the long line each time).
#
#   scripts/t <name>...   run tests/semantics/<name>_test.sapp  (+ check stdlib/<name>.sapp)
#   scripts/t all         run the whole semantics suite, report pass count
#   scripts/t check <f>   just `pblang check` a file
#
# Tip: alias it — `alias t=./scripts/t` — then `t pbconfig mat4`.

cd "$(dirname "$0")/.." || exit 1
PB=target/release/pblang
[ -x "$PB" ] || PB=target/debug/pblang
[ -x "$PB" ] || { echo "no pblang binary in target/{release,debug}"; exit 1; }

if [ "$1" = "all" ]; then
  # clean the two known stale fixtures so the suite is deterministic
  rm -rf tests/fixtures/_regsrv2 /tmp/pbnat_* 2>/dev/null
  n=0; f=0
  for t in tests/semantics/*_test.sapp; do
    n=$((n + 1))
    "$PB" run "$t" --allow-all >/dev/null 2>&1 || { f=$((f + 1)); echo "FAIL $(basename "$t")"; }
  done
  rm -rf tests/fixtures/_regsrv2 /tmp/pbnat_* 2>/dev/null
  echo "suite: $((n - f))/$n passed"
  exit $([ "$f" -eq 0 ] && echo 0 || echo 1)
fi

if [ "$1" = "check" ]; then
  shift
  "$PB" check "$@"
  exit $?
fi

rc=0
for name in "$@"; do
  out=$("$PB" run "tests/semantics/${name}_test.sapp" --allow-all 2>&1)
  status=$?
  if [ "$status" -eq 0 ]; then
    st="pass"
  else
    detail=$(printf '%s\n' "$out" | grep -m1 -iE 'fail|error' | head -c 90)
    [ -n "$detail" ] || detail="exit $status"
    st="FAIL — $detail"
    rc=1
  fi
  chk=""
  if [ -f "stdlib/${name}.sapp" ]; then
    chk=" · $("$PB" check "stdlib/${name}.sapp" 2>&1 | grep -oE '[0-9]+ error\(s\)' | head -1)"
  fi
  echo "${name}: ${st}${chk}"
done
exit $rc
