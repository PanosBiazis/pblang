//
// scripts/refresh_perplexity_context.sapp — Pure-PBLang Context Verification & Refresh Tool
//
// Replaces scripts/refresh-perplexity-context.ps1. Validates PERPLEXITY_CONTEXT.md, refreshes
// its modification timestamp cleanly, and optionally copies its contents to the system clipboard
// (`--copy-to-clipboard` / `-CopyToClipboard`).

fn _collect_args() {
    let raw_env = env_get("PBLANG_SCRIPT_ARGS");
    if raw_env != nil and raw_env != "" {
        let parts = str_split(raw_env, "\n");
        let env_out = [];
        let k = 0;
        while k < len(parts) {
            if parts[k] != "" { array_push(env_out, parts[k]); }
            k = k + 1;
        }
        return env_out;
    }
    let argv = try os_args() catch [];
    if not is_array(argv) { return []; }
    let n = len(argv);
    let i = 0;
    let found = false;
    while i < n {
        let a = str(argv[i]);
        i = i + 1;
        if str_ends_with(a, ".sapp") or str_ends_with(a, ".pbck") { found = true; break; }
    }
    if not found { return []; }
    while i < n {
        let a2 = str(argv[i]);
        if a2 == "--" { i = i + 1; break; }
        if not str_starts_with(a2, "-") { break; }
        i = i + 1;
    }
    let out = [];
    while i < n {
        array_push(out, str(argv[i]));
        i = i + 1;
    }
    return out;
}

let args = _collect_args();
let copy_clip = false;
let i = 0;
while i < len(args) {
    let flg = str_lower(args[i]);
    if flg == "--copy-to-clipboard" or flg == "-copytoclipboard" {
        copy_clip = true;
    }
    i = i + 1;
}

let root = cwd();
if not fs_exists(root + "/pblang.toml") and fs_exists(root + "/../pblang.toml") {
    root = root + "/..";
}

let ctx_path = root + "/PERPLEXITY_CONTEXT.md";
if not fs_exists(ctx_path) {
    eprint("Missing context file: " + ctx_path + "\n");
    os_exit(1);
}
let content = fs_read(ctx_path);
if len(str_trim(content)) == 0 {
    os_exit(1);
}

// Refresh file mtime deterministically by rewriting identical bytes
fs_write(ctx_path, content);
println("Refreshed: " + ctx_path);

if copy_clip {
    let copied = false;
    if env_get("OS") == "Windows_NT" {
        let r = try proc_spawn_wait("clip", []) catch map{ exit_code: 1 };
        copied = r.exit_code == 0;
    } else {
        if fs_exists("/usr/bin/pbcopy") {
            let r = try proc_spawn_wait("/usr/bin/pbcopy", []) catch map{ exit_code: 1 };
            copied = r.exit_code == 0;
        } elif fs_exists("/usr/bin/wl-copy") {
            let r = try proc_spawn_wait("/usr/bin/wl-copy", [content]) catch map{ exit_code: 1 };
            copied = r.exit_code == 0;
        }
    }
    if copied {
        println("Copied to clipboard.");
    } else {
        println("Clipboard utility unavailable or headless session; context file refreshed on disk.");
    }
}
