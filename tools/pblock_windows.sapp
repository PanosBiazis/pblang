// Publish a portable lock inside a trusted Windows package-staging directory.
// The semantic normalizer remains shared with pblock; this wrapper supplies a
// bounded build-time I/O path while Windows descriptor-backed publication is
// still being bootstrapped.

let LOCK = import("stdlib:portable_lock.sapp");
let OS = import("stdlib:os.sapp");

let MAX_DOCUMENT_BYTES = 1048576;

fn fail(message) { throw "pblock_windows: " + message; }

fn absolute_windows_path(path) {
    return type(path) == "string" and len(path) >= 4 and len(path) <= 4096
        and regex_match(path, "^[A-Za-z]:\\\\[^\\r\\n]+$")
        and not str_contains(path, strfromcharcode(0))
        and not str_contains(path, "\\\\..\\\\");
}

fn bounded_text(path, label) {
    let text = try fs_read(path) catch nil;
    if type(text) != "string" or len(text) < 1 or len(text) > MAX_DOCUMENT_BYTES {
        fail(label + " is missing or outside the one MiB bound");
    }
    return text;
}

fn publish(project) {
    if platform() != "windows" { fail("this build helper must execute on Windows"); }
    if not absolute_windows_path(project) { fail("project must be an absolute bounded Windows path"); }
    let manifest_path = project + "\\pblang.toml";
    let lock_path = project + "\\pblang.lock";
    let manifest = bounded_text(manifest_path, "manifest");
    let lock = bounded_text(lock_path, "lockfile");
    let normalized = LOCK.normalize_text(manifest, lock, project);
    let staged = lock_path + ".portable-stage";
    fs_write(staged, normalized.text);
    if bounded_text(staged, "staged lockfile") != normalized.text {
        try fs_remove(staged) catch nil;
        fail("staged lockfile verification failed");
    }
    if not (try { fs_rename(staged, lock_path); true } catch false) {
        try fs_remove(staged) catch nil;
        fail("atomic lockfile publication failed");
    }
    if bounded_text(lock_path, "published lockfile") != normalized.text {
        fail("published lockfile verification failed");
    }
    return map{ ok: true, format: "pblang.portable-lock.windows-build.v1",
        path: lock_path, rewritten: normalized.rewritten,
        descriptor_backend: false, trusted_staging_only: true };
}

let args = OS.script_args();
if len(args) != 1 { fail("usage: pblock_windows PROJECT_ROOT"); }
print json_stringify(publish(args[0]));

export publish;
