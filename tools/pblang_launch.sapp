//
// tools/pblang_launch.sapp — Pure-PBLang Sandboxed Admission-Guarded Bundle Launcher
//
// Replaces tools/pblang-launch.sh. Installed layout:
//   bin/pblang_launch.sapp, bin/pblang-native, libexec/native_bundle_guard.sapp.
// Runs `libexec/native_bundle_guard.sapp --sandbox -- pblang-launch-argv-v2 ...` and dispatches
// only on an explicit verified admission decision.

let Path = import("stdlib:path.sapp");

fn _collect_args() {
    let raw_env = env_get("PBLANG_SCRIPT_ARGS");
    if raw_env != nil and raw_env != "" {
        let parts = str_split(raw_env, "\n");
        let env_out = [];
        let k = 0;
        while k < len(parts) {
            if parts[k] != "" { array_push(env_out, parts[k]); }
            k = k + 1;
        }
        return env_out;
    }
    let argv = try os_args() catch [];
    if not is_array(argv) { return []; }
    let n = len(argv);
    let i = 0;
    let found = false;
    while i < n {
        let a = str(argv[i]);
        i = i + 1;
        if str_ends_with(a, ".sapp") or str_ends_with(a, ".pbck") { found = true; break; }
    }
    if not found { return []; }
    while i < n {
        let a2 = str(argv[i]);
        if a2 == "--" { i = i + 1; break; }
        if not str_starts_with(a2, "-") { break; }
        i = i + 1;
    }
    let out = [];
    while i < n {
        array_push(out, str(argv[i]));
        i = i + 1;
    }
    return out;
}

fn _locate_bundle_bindir() {
    let env_dir = env_get("PBLANG_BUNDLE_BINDIR");
    if env_dir != nil and env_dir != "" {
        return Path.normalize(env_dir);
    }
    let cur = cwd();
    if fs_exists(cur + "/pblang-native") and fs_exists(cur + "/../libexec/native_bundle_guard.sapp") {
        return cur;
    }
    if fs_exists(cur + "/bin/pblang-native") and fs_exists(cur + "/libexec/native_bundle_guard.sapp") {
        return cur + "/bin";
    }
    return cur + "/bin";
}

let bindir = _locate_bundle_bindir();
let native_bin = bindir + "/pblang-native";
let guard_sapp = Path.normalize(bindir + "/../libexec/native_bundle_guard.sapp");

if not fs_exists(native_bin) or not fs_exists(guard_sapp) {
    eprint("pblang launcher: native runtime or admission guard is missing\n");
    os_exit(126);
}

let user_args = _collect_args();
let guard_cmd = ["run", guard_sapp, "--sandbox", "--", "pblang-launch-argv-v2"];
let i = 0;
while i < len(user_args) {
    array_push(guard_cmd, user_args[i]);
    i = i + 1;
}

let adm_res = proc_spawn_wait(native_bin, guard_cmd);
if adm_res.exit_code != 0 {
    if adm_res.stderr != "" { eprint(adm_res.stderr); }
    os_exit(adm_res.exit_code);
}

let decision = str_trim(str(adm_res.stdout));
if decision == "pblang-launch-admit-v1" {
    let nat_res = proc_spawn_wait(native_bin, user_args);
    if nat_res.stdout != "" { print(nat_res.stdout); }
    if nat_res.stderr != "" { eprint(nat_res.stderr); }
    os_exit(nat_res.exit_code);
} elif decision == "pblang-launch-check-v1" {
    let chk_cmd = ["run", guard_sapp];
    let k = 0;
    while k < len(user_args) {
        array_push(chk_cmd, user_args[k]);
        k = k + 1;
    }
    let chk_res = proc_spawn_wait(native_bin, chk_cmd);
    if chk_res.stdout != "" { print(chk_res.stdout); }
    if chk_res.stderr != "" { eprint(chk_res.stderr); }
    os_exit(chk_res.exit_code);
} elif decision == "pblang-launch-check-usage-v1" {
    eprint("pblang --check: expected --check --via-pblang (or --self-host), supported capability options, optional --retained-source compatibility preflight, optional --bounded-source=BYTES (1..1048576; Linux no-follow reader requiring explicit --ffi-lib/--ffi-symbol grants), and exactly one filename; use -- before a filename starting with --\n");
    os_exit(2);
} else {
    eprint("pblang launcher: no valid admission decision\n");
    os_exit(126);
}
