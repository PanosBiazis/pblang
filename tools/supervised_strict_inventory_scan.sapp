// Thin CLI for one trusted Linux strict-scan process envelope.
let SUPERVISOR = import("stdlib:strict_scan_supervisor.sapp");

let raw = try env_get("PBLANG_SCRIPT_ARGS") catch "";
let args = if raw == nil or raw == "" { [] } else { str_split(raw, "\n") };
if len(args) != 9 {
    throw "supervised_strict_inventory_scan: root, runtime, runtime digest, graph manifest, manifest digest, graph digest, linked-source digest, libc and project root are required";
}
let result = SUPERVISOR.run(args[0], map{
    runtime_candidates: [args[1]], runtime_sha256: args[2],
    graph_manifest_path: args[3], graph_manifest_sha256: args[4],
    scanner_graph_sha256: args[5], linked_scanner_sha256: args[6],
    libc_path: args[7], project_root: args[8]
});
while try result.recovery_pending catch false {
    let handle = try result._recovery_handle catch nil;
    if handle == nil { throw "supervised_strict_inventory_scan: recovery ownership unavailable"; }
    result = SUPERVISOR.recover(handle, 5000);
}
if map_has(result, "_recovery_handle") { map_remove(result, "_recovery_handle"); }
print json_stringify(result);
