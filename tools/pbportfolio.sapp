// tools/pbportfolio.sapp -- safe cross-project portfolio/action planner.
//
// Usage:
//   pblang run tools/pbportfolio.sapp --allow-all
//   pblang run tools/pbportfolio.sapp --allow-all --max-depth=3 --max-entries=1200 . ../pbai ../pbremote
//
// The inventory is metadata-only: directory/file names and paths are used for
// classification, but file contents are never read.

let INV = import("stdlib:project_inventory.sapp");
let SURVEY = import("stdlib:project_survey.sapp");

fn user_args() {
    let a = os_args();
    let out = [];
    let i = 0;
    let seen = false;
    while i < len(a) {
        let tok = a[i];
        if not seen {
            if str_ends_with(tok, "pbportfolio.sapp") { seen = true; }
            i = i + 1;
            continue;
        }
        if not str_starts_with(tok, "--allow") { array_push(out, tok); }
        i = i + 1;
    }
    return out;
}

fn _num_after_prefix(arg, prefix, fallback) {
    if str_starts_with(arg, prefix) {
        let raw = str_slice(arg, len(prefix), len(arg));
        let n = try parse_number(raw) catch fallback;
        if n == nil { return fallback; }
        return n;
    }
    return fallback;
}

fn default_roots() {
    return [
        ".",
        "../pbai",
        "../pbos",
        "../pb-mcp-server",
        "../pbremote",
        "../pbspotit",
        "../pbide",
        "../pboffice",
        "../pbwatermarks-remover",
        "../aipy",
        "../pbnexus",
        "../pbmedia",
        "../pbcircuits",
        "../pbcomms",
        "../pbgitcomms",
        "../spotit",
        "/usr/share/vulkan",
        "/usr/share/mesa-demos"
    ];
}

let args = user_args();
let roots = [];
let max_depth = 4;
let max_entries = 1200;
let max_children = 160;
let max_runtime_ms = 30000;
let pages = 1;
let page_records = 128;
let limit_per_project = 5;
let line_limit = 20;
let show_inventory = false;
let show_proposals = false;
let show_reviews = false;

let i = 0;
while i < len(args) {
    let a = args[i];
    if a == "--help" or a == "-h" {
        print "pbportfolio: safe metadata-only portfolio/action planner";
        print "usage: pblang run tools/pbportfolio.sapp --allow-all [--max-depth=N] [--max-entries=N] [--max-children=N] [--max-runtime-ms=N] [--pages=N] [--page-records=N] [--limit=N] [--inventory] [--proposals] [--proposal-reviews] [roots...]";
        os_exit(0);
    } else if str_starts_with(a, "--max-depth=") {
        max_depth = _num_after_prefix(a, "--max-depth=", max_depth);
    } else if str_starts_with(a, "--max-entries=") {
        max_entries = _num_after_prefix(a, "--max-entries=", max_entries);
    } else if str_starts_with(a, "--max-children=") {
        max_children = _num_after_prefix(a, "--max-children=", max_children);
    } else if str_starts_with(a, "--max-runtime-ms=") {
        max_runtime_ms = _num_after_prefix(a, "--max-runtime-ms=", max_runtime_ms);
    } else if str_starts_with(a, "--pages=") {
        pages = _num_after_prefix(a, "--pages=", pages);
    } else if str_starts_with(a, "--page-records=") {
        page_records = _num_after_prefix(a, "--page-records=", page_records);
    } else if str_starts_with(a, "--limit=") {
        limit_per_project = _num_after_prefix(a, "--limit=", limit_per_project);
    } else if str_starts_with(a, "--lines=") {
        line_limit = _num_after_prefix(a, "--lines=", line_limit);
    } else if a == "--inventory" {
        show_inventory = true;
    } else if a == "--proposals" {
        show_proposals = true;
    } else if a == "--proposal-reviews" {
        show_reviews = true;
    } else if not str_starts_with(a, "--") {
        array_push(roots, a);
    }
    i = i + 1;
}

if len(roots) == 0 { roots = default_roots(); }

let result = INV.portfolio_action_from_roots(roots, map{
    max_depth: max_depth,
    max_entries: max_entries,
    max_children_per_dir: max_children,
    max_runtime_ms: max_runtime_ms,
    pages: pages,
    page_records: page_records,
    limit_per_project: limit_per_project,
    line_limit: line_limit
});

if show_inventory {
    let inv_lines = INV.inventory_lines(result.inventory, 16);
    let li = 0;
    while li < len(inv_lines) { print inv_lines[li]; li = li + 1; }
    print "";
}

let lines = try result.lines catch SURVEY.portfolio_action_lines(result.action_plan, line_limit);
let j = 0;
while j < len(lines) {
    print lines[j];
    j = j + 1;
}
if show_proposals {
    print "";
    let proposal_lines = SURVEY.proposal_lines(result.proposals, 10);
    let pi = 0;
    while pi < len(proposal_lines) { print proposal_lines[pi]; pi = pi + 1; }
}
if show_reviews {
    print "";
    for proposal in result.proposals.proposals {
        let review=SURVEY.review_proposal(proposal);
        print proposal.id+" -> "+(try review.decision catch "rejected")
            +" destination="+(try review.destination catch "none")
            +" repository_creation_allowed="+str(try review.repository_creation_allowed catch false);
    }
}
