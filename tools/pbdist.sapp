// tools/pbdist.sapp — command-line driver for the cross-OS executable builder.
//
// Turn a pblang script into native executables for any OS, from one host.
//
// Usage:
//   pblang run tools/pbdist.sapp --allow-all <src.sapp> [out_dir] [options]
//
// Options:
//   --list                 Show targets buildable on this host (and how to
//                          enable the rest), then exit.
//   --all                  Build every target available on this host.
//   --target <name>        Build a specific target (repeatable). Names:
//                          linux-x64, linux-arm64, windows-x64, windows-x86,
//                          macos-x64, macos-arm64.
//   --release              Small + stripped + static (recommended for shipping).
//   --size | --max | --debug   Optimization profile (default: speed/-O2).
//   --static               Fully static, copy-anywhere binary.
//   --no-strip             Keep symbol tables.
//   --lto                  Link-time optimization.
//   --compress             UPX-compress the output (if upx is installed).
//
// Examples:
//   pblang run tools/pbdist.sapp --allow-all app.sapp dist --all --release
//   pblang run tools/pbdist.sapp --allow-all app.sapp out --target windows-x64

let dist = import("stdlib/dist.sapp");

// Collect the user's args: everything after the script path, minus pblang's own
// --allow* flags. os_args() = ["run", <script>, "--allow-all", ...user...].
fn user_args() {
    let a = os_args();
    let out = [];
    let i = 0;
    let seen_script = false;
    while i < len(a) {
        let tok = a[i];
        if not seen_script {
            if str_ends_with(tok, "pbdist.sapp") { seen_script = true; }
            i = i + 1;
            continue;
        }
        if not str_starts_with(tok, "--allow") { array_push(out, tok); }
        i = i + 1;
    }
    return out;
}

fn main() {
    let args = user_args();

    // --list is a standalone query.
    let want_list = false;
    for a in args { if a == "--list" { want_list = true; } }
    if want_list {
        print "Targets buildable on this host:";
        let av = dist.available_targets();
        if len(av) == 0 { print "  (none — install a C compiler)"; }
        for t in av { print "  " + t.name + "  via " + t.compiler; }
        print "";
        print dist.missing_targets_help();
        return;
    }

    let src = nil;
    let out_dir = "dist";
    let targets = [];
    let want_all = false;
    let want_self_extract = false;
    let opts = dist.default_opts();

    let i = 0;
    while i < len(args) {
        let a = args[i];
        if a == "--all" { want_all = true; }
        elif a == "--self-extract" { want_self_extract = true; }
        elif a == "--release" { opts = dist.release_opts(); }
        elif a == "--size" { opts.opt = "size"; }
        elif a == "--max" { opts.opt = "max"; }
        elif a == "--debug" { opts.opt = "debug"; }
        elif a == "--static" { opts.static = true; }
        elif a == "--no-strip" { opts.strip = false; }
        elif a == "--lto" { opts.lto = true; }
        elif a == "--compress" { opts.compress = true; }
        elif a == "--target" { i = i + 1; if i < len(args) { array_push(targets, args[i]); } }
        elif str_starts_with(a, "--") { print "pbdist: unknown option " + a; }
        elif src == nil { src = a; }
        else { out_dir = a; }
        i = i + 1;
    }

    if src == nil {
        print "usage: pblang run tools/pbdist.sapp --allow-all <src.sapp> [out_dir] [--all|--target NAME] [--release]";
        print "       pblang run tools/pbdist.sapp --allow-all <src.sapp> [out.pbself] --self-extract";
        print "       pblang run tools/pbdist.sapp --allow-all --list";
        return;
    }

    // --self-extract: one portable, pure-pblang .pbself file (no C toolchain).
    if want_self_extract {
        let out = out_dir;
        if not str_ends_with(out, ".pbself") {
            let base = src;
            if str_ends_with(base, ".sapp") { base = str_slice(base, 0, len(base) - 5); }
            out = base + ".pbself";
        }
        let se = dist.self_extract(src, out);
        if not se.ok {
            print "pbdist: self-extract failed: " + (try se.reason catch "unknown");
            return;
        }
        print "Self-extracting bundle -> " + se.out
            + "  (" + str(se.bytes) + " B file, " + str(se.payload_bytes) + " B payload, "
            + str(se.modules) + " modules linked)";
        print "Run it with: pblang run " + se.out + " --allow-all";
        return;
    }

    let target_list = nil;          // nil => every available target
    if not want_all and len(targets) > 0 { target_list = targets; }
    if not want_all and len(targets) == 0 {
        // Default: just the host target.
        let av = dist.available_targets();
        if len(av) == 0 { print "pbdist: no C toolchain on this host."; return; }
        target_list = [ av[0].name ];
    }

    print "Building " + src + " -> " + out_dir + "/ ...";
    let rep = dist.build_all(src, out_dir, target_list, opts);
    print dist.report_to_string(rep);
    if not rep.ok { print ""; print "Some targets failed. " + dist.missing_targets_help(); }
}

main();
