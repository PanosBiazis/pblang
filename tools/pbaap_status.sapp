// tools/pbaap_status.sapp -- one-command bounded AAP status.
//
// Usage:
//   pblang run tools/pbaap_status.sapp
//   pblang run tools/pbaap_status.sapp --max-files=40 --lines=24
//   pblang run tools/pbaap_status.sapp --drill

let AAP = import("stdlib:aap_status.sapp");

fn user_args() {
    let a = os_args();
    let out = [];
    let i = 0;
    let seen = false;
    while i < len(a) {
        let tok = a[i];
        if not seen {
            if str_ends_with(tok, "pbaap_status.sapp") { seen = true; }
            i = i + 1;
            continue;
        }
        if not str_starts_with(tok, "--allow") { array_push(out, tok); }
        i = i + 1;
    }
    return out;
}

fn _num_after_prefix(arg, prefix, fallback) {
    if str_starts_with(arg, prefix) {
        let raw = str_slice(arg, len(prefix), len(arg));
        let n = try parse_number(raw) catch fallback;
        if n == nil { return fallback; }
        return n;
    }
    return fallback;
}

let args = user_args();
let max_depth = 4;
let max_entries = 600;
let max_children = 120;
let max_files = 60;
let max_file_bytes = 18000;
let max_findings = 80;
let line_limit = 28;
let include_portfolio = true;
let source_only_blockers = true;
let drill = false;

let i = 0;
while i < len(args) {
    let a = args[i];
    if a == "--help" or a == "-h" {
        print "pbaap_status: fail-closed AAP content-audit compatibility status";
        print "usage: pblang run tools/pbaap_status.sapp [--drill] [--source-gate|--strict-gate] [--no-portfolio] [--max-depth=N] [--max-files=N] [--max-file-bytes=N] [--lines=N]";
        print "currently reports unavailable with no findings, focus or ideas until strict content enumeration exists";
        os_exit(0);
    } else if a == "--no-portfolio" {
        include_portfolio = false;
    } else if a == "--drill" {
        drill = true;
    } else if a == "--source-gate" {
        source_only_blockers = true;
    } else if a == "--strict-gate" {
        source_only_blockers = false;
    } else if str_starts_with(a, "--max-depth=") {
        max_depth = _num_after_prefix(a, "--max-depth=", max_depth);
    } else if str_starts_with(a, "--max-entries=") {
        max_entries = _num_after_prefix(a, "--max-entries=", max_entries);
    } else if str_starts_with(a, "--max-children=") {
        max_children = _num_after_prefix(a, "--max-children=", max_children);
    } else if str_starts_with(a, "--max-files=") {
        max_files = _num_after_prefix(a, "--max-files=", max_files);
    } else if str_starts_with(a, "--max-file-bytes=") {
        max_file_bytes = _num_after_prefix(a, "--max-file-bytes=", max_file_bytes);
    } else if str_starts_with(a, "--max-findings=") {
        max_findings = _num_after_prefix(a, "--max-findings=", max_findings);
    } else if str_starts_with(a, "--lines=") {
        line_limit = _num_after_prefix(a, "--lines=", line_limit);
    }
    i = i + 1;
}

let report = AAP.status_report(nil, map{
    max_depth: max_depth,
    max_entries: max_entries,
    max_children_per_dir: max_children,
    max_files: max_files,
    max_file_bytes: max_file_bytes,
    max_findings: max_findings,
    source_only_blockers: source_only_blockers,
    include_portfolio: include_portfolio,
    require_allocation_bounded: true
});

let lines = AAP.status_lines(report, line_limit);
let j = 0;
while j < len(lines) {
    print lines[j];
    j = j + 1;
}

if drill {
    let detail = AAP.focus_detail(report, 0, 10);
    let dlines = AAP.focus_detail_lines(detail, line_limit);
    print "";
    let k = 0;
    while k < len(dlines) {
        print dlines[k];
        k = k + 1;
    }
}

if report.status == "blocked" or report.status == "unavailable"
   or report.status == "incomplete" { os_exit(1); }
