// CLI for stdlib:freeze.sapp.
// Usage: pblang run tools/pbfreeze.sapp --allow-all -- input.sapp output.pbck

let FREEZE = import("stdlib:freeze.sapp");

fn script_args() {
    let explicit = try env_get("PBLANG_SCRIPT_ARGS") catch nil;
    if type(explicit) == "string" and explicit != "" { return str_split(explicit, "\n"); }
    let argv = os_args(); let i = 0; let found = false;
    while i < len(argv) {
        let value = str(argv[i]); i = i + 1;
        if str_ends_with(value, "pbfreeze.sapp") { found = true; break; }
    }
    if not found { return []; }
    while i < len(argv) and (argv[i] == "--" or str_starts_with(str(argv[i]), "--allow")) { i = i + 1; }
    let out = []; while i < len(argv) { array_push(out, argv[i]); i = i + 1; }
    return out;
}

let args = script_args();
if len(args) != 2 { throw "pbfreeze: expected input.sapp and output.pbck"; }
let result = FREEZE.build(args[0], args[1]);
print json_stringify(result);
if not result.ok { throw "pbfreeze failed at " + result.stage + ": " + result.error; }
