// Read-only front end for the cross-platform pblang VM lab.
//
// The operational controller is published as an immutable, content-addressed
// bundle outside the source tree. This source command intentionally exposes
// only doctor/list/plan so a dirty worktree can never gain libvirt or SSH
// authority merely by being executed with --allow-all.

let OS = import("stdlib:os.sapp");
let PATH = import("stdlib:path.sapp");
let LAB = import("stdlib:vm_lab.sapp");

let MAX_MANIFEST_BYTES = 1048576;

fn fail(message, code = 2) { print "pbvmtest: " + message; os_exit(code); }

fn load_manifest(path) {
    let bytes=try fs_read_bytes(path) catch nil;
    if type(bytes)!="array" { fail("cannot read manifest"); }
    if len(bytes)<2 or len(bytes)>MAX_MANIFEST_BYTES { fail("manifest must be 2 bytes..1 MiB"); }
    let raw=try json_parse(bytes_to_str(bytes)) catch nil;
    let checked=LAB.validate_manifest(raw);
    if not checked.ok {
        print "pbvmtest: invalid manifest";
        for i len(checked.errors) { print "  - " + checked.errors[i]; }
        os_exit(2);
    }
    return map{raw:raw,checked:checked};
}

fn sanitized_target(guest) {
    let out=map{id:guest.id,kind:guest.kind,os:guest.os,arch:guest.arch,
        evidence:guest.evidence,enabled:guest.enabled,suites:guest.suites};
    if guest.kind=="libvirt-ssh" { out.domain=guest.domain; out.domain_uuid=guest.domain_uuid; }
    elif guest.kind=="android-emulator" { out.avd=guest.avd; }
    elif guest.kind=="hosted-runner" { out.runner=guest.runner; }
    elif guest.kind=="qemu-reference" { out.oracle=guest.oracle; }
    return out;
}

fn doctor(loaded) {
    let tools=map{
        kvm:try fs_exists("/dev/kvm") catch false,
        virsh:try fs_exists("/usr/bin/virsh") catch false,
        ssh:try fs_exists("/usr/bin/ssh") catch false,
        sftp:try fs_exists("/usr/bin/sftp") catch false,
        git:try fs_exists("/usr/bin/git") catch false,
        tar:try fs_exists("/usr/bin/tar") catch false,
        qemu_x86_64:try fs_exists("/usr/bin/qemu-system-x86_64") catch false,
        qemu_arm64_system:try fs_exists(OS.home_dir()+"/VMs/pblang-lab/controller/qemu-arm-runtime/usr/bin/qemu-system-aarch64") catch false,
        qemu_arm64_userspace:try fs_exists(OS.home_dir()+"/VMs/pblang-lab/controller/qemu-user-runtime/usr/bin/qemu-aarch64-static") catch false,
        android_emulator:try fs_exists(OS.home_dir()+"/Android/Sdk/emulator/emulator") catch false,
        adb:try fs_exists(OS.home_dir()+"/Android/Sdk/platform-tools/adb") catch false
    };
    let missing=[];
    for key in map_keys(tools) {
        if not tools[key] and key!="android_emulator" and key!="adb"
           and key!="qemu_arm64_system" and key!="qemu_arm64_userspace" { array_push(missing,key); }
    }
    let report=map{format:"pblang.vm-lab.doctor.v1",ok:len(missing)==0,
        platform:platform(),manifest_ok:loaded.checked.ok,targets:len(loaded.checked.guests),
        tools:tools,missing_required:missing,operational_controller:false,
        reason:"source-tree command is read-only; publish the reviewed immutable controller to run guests"};
    print json_stringify(report);
    if not report.ok { os_exit(1); }
}

fn list_targets(loaded) {
    let rows=[];
    for i len(loaded.checked.guests) { array_push(rows,sanitized_target(loaded.checked.guests[i])); }
    print json_stringify(map{format:"pblang.vm-lab.targets.v1",targets:rows});
}

fn print_plan(loaded,selector) {
    let planned=LAB.plan(loaded.raw,selector);
    if not planned.ok {
        for i len(planned.errors) { print "pbvmtest: " + planned.errors[i]; }
        os_exit(2);
    }
    print json_stringify(planned);
}

fn usage() {
    print "usage: pblang run tools/pbvmtest.sapp --allow-fs -- <doctor|list|plan> [selector] [--config=PATH]";
    print "       selector: enabled (default), all, or a target id";
}

fn main() {
    let args=OS.script_args(); let command="doctor"; let selector="enabled";
    let config=OS.home_dir()+"/.config/pblang/vm-lab.json"; let positionals=[];
    for i len(args) {
        let a=str(args[i]);
        if str_starts_with(a,"--config=") { config=str_slice(a,9,len(a)); }
        elif str_starts_with(a,"--") { fail("unknown option " + a); }
        else { array_push(positionals,a); }
    }
    if len(positionals)>0 { command=positionals[0]; }
    if len(positionals)>1 { selector=positionals[1]; }
    if len(positionals)>2 { usage(); os_exit(2); }
    if command=="help" { usage(); return; }
    if not PATH.is_absolute(config) { fail("config path must be absolute"); }
    let loaded=load_manifest(config);
    if command=="doctor" { doctor(loaded); }
    elif command=="list" { list_targets(loaded); }
    elif command=="plan" { print_plan(loaded,selector); }
    elif command=="run" or command=="emulators" or command=="report" {
        fail("operational commands require the reviewed immutable controller artifact",3);
    } else { usage(); os_exit(2); }
}

main();
