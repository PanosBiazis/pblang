// tools/pbscan.sapp — defensive security scanner CLI (stdlib/secscan.sapp).
//
// Scan a file (or inline text) for leaked secrets and hostile input patterns —
// a pre-commit / CI guard. Prints findings and exits non-zero when any are found.
//
// Usage:
//   pblang run tools/pbscan.sapp --allow-all <file>
//   pblang run tools/pbscan.sapp --allow-all --text "admin' OR '1'='1"
//
// Output: one line per finding (SECRET <type> <preview> | THREAT <type> <evidence>),
// then a summary. Findings -> the program prints "FINDINGS: N"; clean -> "CLEAN".

let sec = import("stdlib/secscan.sapp");

// os_args() = ["run", <script>, "--allow-all", <user args...>]; keep user args.
fn user_args() {
    let a = os_args();
    let out = [];
    let i = 0;
    let seen = false;
    while i < len(a) {
        let tok = a[i];
        if not seen {
            if str_ends_with(tok, "pbscan.sapp") { seen = true; }
            i = i + 1;
            continue;
        }
        if not str_starts_with(tok, "--allow") { array_push(out, tok); }
        i = i + 1;
    }
    return out;
}

let r = sec.cli_scan(user_args());

if not r.ok {
    print "pbscan: " + r.error;
} else {
    let i = 0;
    while i < len(r.secrets) {
        print "SECRET  " + str(r.secrets[i].type) + "  " + str(r.secrets[i].preview) + "***";
        i = i + 1;
    }
    let j = 0;
    while j < len(r.threats) {
        print "THREAT  " + str(r.threats[j].type) + "  [" + str(r.threats[j].evidence) + "]";
        j = j + 1;
    }
    if r.findings > 0 { print "FINDINGS: " + str(r.findings) + " (risk=" + str(r.risk) + ")"; }
    else { print "CLEAN"; }
}
