//
// tools/ci_docs_privacy_audit.sapp — 100% Pure-PBLang Docs Integrity, Manifest Synchronization
// & Public Zero-OPSEC Privacy Audit (replaces inline Python in .github/workflows/ci.yml).

fn _collect_cli_args() {
    let raw_env = env_get("PBLANG_SCRIPT_ARGS");
    if raw_env != nil and raw_env != "" {
        let parts = str_split(raw_env, "\n");
        let env_out = [];
        let k = 0;
        while k < len(parts) {
            if parts[k] != "" { array_push(env_out, parts[k]); }
            k = k + 1;
        }
        return env_out;
    }
    let argv = try os_args() catch [];
    if not is_array(argv) { return []; }
    let n = len(argv);
    let i = 0;
    let found = false;
    while i < n {
        let a = str(argv[i]);
        i = i + 1;
        if str_ends_with(a, ".sapp") or str_ends_with(a, ".pbck") { found = true; break; }
    }
    if not found { return []; }
    while i < n {
        let a2 = str(argv[i]);
        if a2 == "--" { i = i + 1; break; }
        if not str_starts_with(a2, "-") { break; }
        i = i + 1;
    }
    let out = [];
    while i < n {
        array_push(out, str(argv[i]));
        i = i + 1;
    }
    return out;
}

fn _parse_expected_version(argv) {
    let i = 0;
    while i < len(argv) {
        if argv[i] == "--expected-version" and i + 1 < len(argv) {
            return str_trim(argv[i + 1]);
        }
        if str_starts_with(argv[i], "--expected-version=") {
            return str_trim(str_slice(argv[i], 19, len(argv[i])));
        }
        i = i + 1;
    }
    return "";
}

fn _is_regular_file(path) {
    if (try fs_exists(path) catch false) != true { return false; }
    let dir_probe = try fs_listdir(path) catch nil;
    if is_array(dir_probe) { return false; }
    return true;
}

fn _strip_toml_comment(line) {
    let out = "";
    let in_str = false;
    let esc = false;
    let i = 0;
    let n = len(line);
    while i < n {
        let c = strcharcodeat(line, i);
        if c == 35 and not in_str {
            return out;
        }
        if c == 34 and not esc {
            in_str = not in_str;
        }
        out = out + str_slice(line, i, i + 1);
        if in_str and c == 92 and not esc {
            esc = true;
        } else {
            esc = false;
        }
        i = i + 1;
    }
    return out;
}

fn _unquote_toml_string(raw) {
    let t = str_trim(raw);
    if len(t) >= 2 and str_starts_with(t, "\"") and str_ends_with(t, "\"") {
        return str_slice(t, 1, len(t) - 1);
    }
    if len(t) >= 2 and str_starts_with(t, "'") and str_ends_with(t, "'") {
        return str_slice(t, 1, len(t) - 1);
    }
    return nil;
}

fn parse_toml_section_strings(text) {
    let norm = str_replace_all(str_replace_all(text, "\r\n", "\n"), "\r", "\n");
    let lines = str_split(norm, "\n");
    let sections = map{};
    let cur = "";
    sections[cur] = map{};
    let i = 0;
    while i < len(lines) {
        let clean = str_trim(_strip_toml_comment(lines[i]));
        if clean != "" {
            if str_starts_with(clean, "[") and str_ends_with(clean, "]") {
                if str_starts_with(clean, "[[") and str_ends_with(clean, "]]") {
                    cur = str_trim(str_slice(clean, 2, len(clean) - 2));
                } else {
                    cur = str_trim(str_slice(clean, 1, len(clean) - 1));
                }
                if not map_has(sections, cur) {
                    sections[cur] = map{};
                }
            } else {
                let eq = str_index_of(clean, "=");
                if eq > 0 {
                    let k = str_trim(str_slice(clean, 0, eq));
                    let v = _unquote_toml_string(str_slice(clean, eq + 1, len(clean)));
                    if v != nil {
                        if not map_has(sections, cur) {
                            sections[cur] = map{};
                        }
                        sections[cur][k] = v;
                    }
                }
            }
        }
        i = i + 1;
    }
    return sections;
}

fn parse_cff_version(text) {
    let norm = str_replace_all(str_replace_all(text, "\r\n", "\n"), "\r", "\n");
    let lines = str_split(norm, "\n");
    let i = 0;
    while i < len(lines) {
        let ln = lines[i];
        if str_starts_with(ln, "version:") {
            let rhs = str_trim(str_slice(ln, 8, len(ln)));
            let uq = _unquote_toml_string(rhs);
            if uq != nil { return uq; }
            return rhs;
        }
        i = i + 1;
    }
    return "";
}

fn _bytes_contains_subseq(hay, needle) {
    let hn = len(hay);
    let nn = len(needle);
    if nn == 0 { return true; }
    if hn < nn { return false; }
    let first = needle[0];
    let lim = hn - nn;
    let i = 0;
    while i <= lim {
        if hay[i] == first {
            let match_ok = true;
            let j = 1;
            while j < nn {
                if hay[i + j] != needle[j] {
                    match_ok = false;
                    break;
                }
                j = j + 1;
            }
            if match_ok { return true; }
        }
        i = i + 1;
    }
    return false;
}

fn extract_markdown_links(text) {
    let links = [];
    let n = len(text);
    let i = 0;
    while i < n {
        if strcharcodeat(text, i) == 91 { // '['
            let close_br = -1;
            let j = i + 1;
            while j < n {
                let cj = strcharcodeat(text, j);
                if cj == 91 {
                    i = j - 1;
                    break;
                }
                if cj == 93 { // ']'
                    close_br = j;
                    break;
                }
                j = j + 1;
            }
            if close_br > i + 1 and close_br + 1 < n and strcharcodeat(text, close_br + 1) == 40 { // '('
                let close_par = -1;
                let k = close_br + 2;
                while k < n {
                    let ck = strcharcodeat(text, k);
                    if ck == 41 { // ')'
                        close_par = k;
                        break;
                    }
                    if ck == 10 or ck == 13 {
                        break;
                    }
                    k = k + 1;
                }
                if close_par > close_br + 2 {
                    let label = str_slice(text, i + 1, close_br);
                    let target = str_trim(str_slice(text, close_br + 2, close_par));
                    array_push(links, map{ label: label, target: target });
                    i = close_par;
                }
            }
        }
        i = i + 1;
    }
    return links;
}

fn run_docs_privacy_audit(argv) {
    let expected_ver = _parse_expected_version(argv);

    // 1. Parse pblang.toml and cross-check Cargo.toml, editors/vscode/package.json & CITATION.cff
    if not _is_regular_file("pblang.toml") {
        throw "Missing pblang.toml";
    }
    let pb_toml = parse_toml_section_strings(fs_read("pblang.toml"));
    let pkg_sec = if map_has(pb_toml, "package") { pb_toml["package"] } else { map{} };
    let pb_ver = if map_has(pkg_sec, "version") { pkg_sec["version"] } else { "" };
    if pb_ver == "" or not regex_match(pb_ver, "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$") {
        throw "Invalid or empty SemVer in pblang.toml: '" + pb_ver + "'";
    }
    if expected_ver != "" and pb_ver != expected_ver {
        throw "Unexpected pblang.toml version: got '" + pb_ver + "', expected '" + expected_ver + "'";
    }

    if _is_regular_file("Cargo.toml") {
        let cargo_toml = parse_toml_section_strings(fs_read("Cargo.toml"));
        let cargo_pkg = if map_has(cargo_toml, "package") { cargo_toml["package"] } else { map{} };
        let cargo_ver = if map_has(cargo_pkg, "version") { cargo_pkg["version"] } else { "" };
        if cargo_ver != pb_ver {
            throw "Version mismatch between pblang.toml (" + pb_ver + ") and Cargo.toml (" + cargo_ver + ")";
        }
    }

    if _is_regular_file("editors/vscode/package.json") {
        let vs_pkg = json_parse(fs_read("editors/vscode/package.json"));
        let vs_ver = if is_map(vs_pkg) and map_has(vs_pkg, "version") { str(vs_pkg["version"]) } else { "" };
        if vs_ver != pb_ver {
            throw "Version mismatch between pblang.toml (" + pb_ver + ") and editors/vscode/package.json (" + vs_ver + ")";
        }
    }

    if _is_regular_file("CITATION.cff") {
        let cff_ver = parse_cff_version(fs_read("CITATION.cff"));
        if cff_ver != pb_ver {
            throw "Version mismatch between pblang.toml (" + pb_ver + ") and CITATION.cff (" + cff_ver + ")";
        }
    }

    // 2. Verify pblang.lock contains zero absolute host path markers
    let pfx_h = "/" + "home" + "/";
    let pfx_m = "/" + "media" + "/";
    let lock_text = fs_read("pblang.lock");
    if str_contains(lock_text, pfx_h) or str_contains(lock_text, pfx_m) {
        throw "Absolute path leaked in pblang.lock";
    }

    // 3. Scan every tracked file via git ls-files for forbidden local/private markers
    let forbidden_strs = [
        pfx_h + "pan",
        pfx_m + "pan",
        "Ext" + "HD",
        "SPSSD" + "T7",
        "@" + "gmail.com"
    ];
    let forbidden_bytes = [];
    let fi = 0;
    while fi < len(forbidden_strs) {
        array_push(forbidden_bytes, str_to_bytes(forbidden_strs[fi]));
        fi = fi + 1;
    }

    let git_res = proc_spawn_wait("git", ["ls-files"]);
    if git_res.exit_code != 0 {
        throw "git ls-files failed: " + str(git_res.stderr);
    }
    let raw_lines = str_split(str_replace_all(git_res.stdout, "\r\n", "\n"), "\n");
    let tracked = [];
    let ti = 0;
    while ti < len(raw_lines) {
        if raw_lines[ti] != "" {
            array_push(tracked, raw_lines[ti]);
        }
        ti = ti + 1;
    }

    let leaks = [];
    ti = 0;
    while ti < len(tracked) {
        let rel = tracked[ti];
        if rel != "tools/ci_docs_privacy_audit.sapp" and _is_regular_file(rel) {
            let data = fs_read_bytes(rel);
            let pi = 0;
            while pi < len(forbidden_bytes) {
                if _bytes_contains_subseq(data, forbidden_bytes[pi]) {
                    array_push(leaks, rel + ": contains forbidden local marker '" + forbidden_strs[pi] + "'");
                }
                pi = pi + 1;
            }
        }
        ti = ti + 1;
    }
    if len(leaks) > 0 {
        println("Public privacy check failed:\n" + str_join(leaks, "\n"));
        os_exit(1);
    }

    // 4. Parse relative Markdown [label](target) links across all 11 documentation indexes
    let md_files = [
        "README.md", "SECURITY.md", "CONTRIBUTING.md", "CHANGELOG.md",
        "docs/README.md", "tests/README.md", "examples/README.md",
        "bench/README.md", "bench/secure_archive/README.md",
        "emulators/README.md", "tools/README.md"
    ];
    let broken = [];
    let mi = 0;
    while mi < len(md_files) {
        let mf = md_files[mi];
        if not _is_regular_file(mf) {
            array_push(broken, mf + ": documentation index file missing");
        } else {
            let parent = path_dirname(mf);
            let text = fs_read(mf);
            let links = extract_markdown_links(text);
            let li = 0;
            while li < len(links) {
                let target = links[li].target;
                if not str_starts_with(target, "http://")
                   and not str_starts_with(target, "https://")
                   and not str_starts_with(target, "mailto:")
                   and not str_starts_with(target, "#") {
                    let hash_parts = str_split(target, "#");
                    let clean = hash_parts[0];
                    if clean != "" {
                        let resolved = if parent == "" or parent == "." { clean } else { parent + "/" + clean };
                        if not fs_exists(resolved) {
                            array_push(broken, mf + ": [" + links[li].label + "](" + target + ")");
                        }
                    }
                }
                li = li + 1;
            }
        }
        mi = mi + 1;
    }
    if len(broken) > 0 {
        println("Broken relative markdown links:\n" + str_join(broken, "\n"));
        os_exit(1);
    }

    let summary_msg = "Verified " + str(len(md_files)) + " documentation indexes, " + str(len(tracked)) + " tracked files, and manifests cleanly (v" + pb_ver + ").";
    println(summary_msg);
    return map{
        ok: true,
        version: pb_ver,
        md_count: len(md_files),
        tracked_count: len(tracked)
    };
}

if env_get("PBLANG_CI_DOCS_AUDIT_LIB") != "1" {
    run_docs_privacy_audit(_collect_cli_args());
}

export run_docs_privacy_audit, extract_markdown_links, parse_toml_section_strings, parse_cff_version;
