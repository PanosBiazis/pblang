// PBLang-owned source check with a failing process exit on diagnostics.
// Run with PBLANG_SCRIPT_ARGS containing exactly one source filename.
let FRONTEND = import("stdlib:compiler/source_analysis.sapp");
let raw = try env_get("PBLANG_SCRIPT_ARGS") catch "";
if raw == nil or str_trim(raw) == "" or str_contains(raw, "\n") {
    throw "pbcheck: expected one source filename";
}
let source = fs_read(raw);
let result = FRONTEND.analyze(source);
if not result.ok {
    for message in result.errors { print message; }
    throw "pbcheck: source check failed";
}
print "pbcheck: source check passed";
