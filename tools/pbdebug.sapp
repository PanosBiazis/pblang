// tools/pbdebug.sapp — the pblang line-level debugger / runner CLI.
//
// Run a whole file, a SPECIFIC RANGE OF LINES, or a single expression, on top of
// stdlib/debug.sapp (which evals via the self-hosted frontend). This is the
// command-line surface for "run specific lines of code while debugging".
//
// Usage:
//   pblang run tools/pbdebug.sapp --allow-all <file.sapp>                # run whole file
//   pblang run tools/pbdebug.sapp --allow-all <file.sapp> --lines 12:20  # run lines 12..20
//   pblang run tools/pbdebug.sapp --allow-all <file.sapp> --lines 7      # run a single line
//   pblang run tools/pbdebug.sapp --allow-all --expr "6 * 7"            # evaluate one expression
//   pblang run tools/pbdebug.sapp --allow-all <file.sapp> --lines 1:9 --disasm   # show bytecode
//   pblang run tools/pbdebug.sapp --allow-all <file.sapp> --lines 1:9 --trace    # show cost
//
// Prints the program's captured output (one value per line). On error, prints a
// message prefixed with "pbdebug:". --disasm/--trace add an annotated report.

let dbg = import("stdlib/debug.sapp");

// os_args() = ["run", <script>, "--allow-all", <user args...>]; keep the user args.
fn user_args() {
    let a = os_args();
    let out = [];
    let i = 0;
    let seen_script = false;
    while i < len(a) {
        let tok = a[i];
        if not seen_script {
            if str_ends_with(tok, "pbdebug.sapp") { seen_script = true; }
            i = i + 1;
            continue;
        }
        if not str_starts_with(tok, "--allow") { array_push(out, tok); }
        i = i + 1;
    }
    return out;
}

let args = user_args();

// Pull out path + line range for the optional --disasm/--trace reports.
let path = nil;
let lines = nil;
let want_disasm = false;
let want_trace = false;
let i = 0;
while i < len(args) {
    let a = args[i];
    if a == "--lines" and i + 1 < len(args) { lines = args[i + 1]; i = i + 2; continue; }
    if a == "--disasm" { want_disasm = true; i = i + 1; continue; }
    if a == "--trace"  { want_trace = true;  i = i + 1; continue; }
    if a == "--expr"   { i = i + 2; continue; }
    if not str_starts_with(a, "--") and path == nil { path = a; }
    i = i + 1;
}

fn _range(lines_spec) {
    let s = 1; let e = 1000000000;
    if lines_spec != nil {
        let parts = str_split(lines_spec, ":");
        s = parse_number(parts[0]);
        if len(parts) > 1 { e = parse_number(parts[1]); } else { e = s; }
    }
    return map{ s: s, e: e };
}

// --disasm / --trace operate on the selected file + range; they don't run via cli_run.
if (want_disasm or want_trace) and path != nil {
    let src = try fs_read(path) catch nil;
    if src == nil {
        print "pbdebug: cannot read " + str(path);
    } else {
        let rg = _range(lines);
        if want_disasm {
            let d = dbg.disasm_lines(src, rg.s, rg.e);
            print "── disasm lines " + str(rg.s) + ":" + str(rg.e) + " (" + str(len(d)) + " instructions) ──";
            let k = 0;
            while k < len(d) {
                print str(d[k].index) + "  " + str(d[k].name) + "  " + str(d[k].operand);
                k = k + 1;
            }
        }
        if want_trace {
            let snippet = dbg.run_lines(src, rg.s, rg.e).lines;
            let t = dbg.trace_source(snippet);
            let j = 0;
            while j < len(t.output) { print t.output[j]; j = j + 1; }
            print "── trace: ok=" + str(t.ok) + " elapsed=" + str(t.ms) + "ms ──";
        }
    }
} else {
    let r = dbg.cli_run(args);
    let k = 0;
    while k < len(r.output) { print r.output[k]; k = k + 1; }
    if not r.ok { print "pbdebug: " + r.error; }
}
