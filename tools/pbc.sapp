// tools/pbc.sapp — compile PBLang to a native executable, WASM, or native-VM PBCK.
//
//   pblang run tools/pbc.sapp <program.sapp> [--out <bin>] [--target x64|x64-dyn|pe64|arm64|wasm|pbck] [--safe] [--overflow]
// --target pbck emits native-VM bytecode, not a standalone executable or PBCS.
// PBCK-only --bundle statically links trusted project dependencies.
// PBCK-only --entry NAME --cleanup NAME adds an explicit native error cleanup boundary.
// Optional --initialize NAME runs declared initialization inside that boundary.
// --module-contract FILE --module-root ID [--module-capability NAME] checks explicit compatibility before compilation.
//
// --target wasm --local-source uses developer admission with optional
// --max-source-bytes=N and --max-tokens=N; other targets retain strict admission.
//
// --target arm64 CROSS-COMPILES from x86-64 to a static AArch64/ARM64 ELF using the pure-pblang arm64 backend
// (stdlib/codegen_arm64_ast.sapp) — no cross-toolchain needed. Integer subset (fn/if/elif/while/arith/print/
// calls/recursion); copy the result to any arm64 device (Pi, phone, arm64 server, Apple-silicon VM) and run it.
//
// --target x64-dyn emits a dynamically-linked Linux x86-64 ELF64 executable (PT_INTERP + .plt/.got dlopen/dlsym/dlclose)
// for native C ABI FFI (libm, libX11, libsqlite3, libGL) with zero C/Rust glue.
// --target pe64 CROSS-COMPILES to a 64-bit Windows PE32+ console executable (.exe) importing KERNEL32.dll directly.
//
// Uses the pure-pblang code generator (stdlib/native/codegen_x64.sapp) to emit a minimal static ELF —
// no libc or external toolchain. --safe retains its compatibility name and reports
// selected runtime checks; it is not a memory-safety certificate or isolation
// boundary. Valid generated array/map handles receive selected access checks.
// --overflow turns on checked signed add/sub/mul/neg (SIGILL on overflow).
//
// Supported source is the codegen subset (numbers, strings + str()/concat/slice/char, if/elif/else,
// while, functions + recursion, closures, arrays + push, maps). Unsupported constructs fail loud.

let cg = import("stdlib/native/codegen_x64.sapp");
let dcg = import("stdlib/native/elf_dyn_x64.sapp");
let pcg = import("stdlib/native/codegen_pe64.sapp");
let OS = import("stdlib:os.sapp");
let SOURCE = import("stdlib:compiler/checked_source.sapp");
// Bind tool dependencies while the retained host still has this script origin.
// Deferred imports inside main() would instead resolve against the caller cwd.
let modules = import("stdlib:controlled_modularity_file.sapp");
let linker = import("stdlib:compiler/native_bundle.sapp");
let bridge = import("stdlib:compiler/native_pbck.sapp");
let wcg = import("stdlib:codegen_wasm.sapp");
let acg = import("stdlib:codegen_arm64_ast.sapp");
let arm64_native = import("stdlib:native/codegen_arm64.sapp");
let s32 = import("stdlib/native/codegen_sub32.sapp");
let ipr = import("stdlib:ip_rights_provenance.sapp");
let cshield = import("stdlib:security/closed_source_shield.sapp");

fn _bad_option(message) { print "pbc: " + message; os_exit(2); }
fn _count(text) {
    if len(text) == 0 { return nil; }
    for ch in str_split(text, "") {
        let code = strcharcodeat(ch, 0);
        if code < 48 or code > 57 { return nil; }
    }
    return try parse_number(text) catch nil;
}

fn _is_flag(a) { return len(a) > 0 and strcharcodeat(a, 0) == 45; }
fn _has_suffix(f, ext) { if len(f) <= len(ext) { return false; } return str_slice(f, len(f) - len(ext), len(f)) == ext; }
fn _default_out(src) {
    // strip directory and the trailing ".sapp"
    let parts = str_split(src, "/");
    let base = parts[len(parts) - 1];
    if _has_suffix(base, ".sapp") { return str_slice(base, 0, len(base) - 5); }
    return base;
}

fn _maybe_seal_bytes(raw_bytes, fmt_kind, should_seal, ip_opts, sign_env_name) {
    if not should_seal { return raw_bytes; }
    let pol = ipr.build_ip_policy(ip_opts);
    let sec: any = nil;
    if sign_env_name != nil and len(sign_env_name) > 0 {
        sec = env_get(sign_env_name);
    }
    return ipr.seal_artifact_bytes(raw_bytes, fmt_kind, pol, sec);
}

fn main() {
    let a = OS.script_args();
    let src: any = nil; let out: any = nil; let safe = false; let overflow = false; let target = "x64"; let i = 0;
    let entry:any=nil; let cleanup:any=nil; let initialize:any=nil; let bundle=false;
    let module_contract:any=nil;let module_root:any=nil;let module_capabilities=[];
    let local_source = false; let budget = map{}; let target_set = false;
    let hybrid_mode = false; let freestanding_mode = false;
    let ip_explicit = false; let ip_disable = false;
    let ip_mode = "proprietary"; let ip_spdx: any = nil; let ip_holder: any = nil; let sign_env_name: any = nil;
    let capture_shield = true; let capture_shield_explicit = false;
    let open_symbols = false; let obfuscate_mode = false; let split_out: any = nil;
    while i < len(a) {
        let arg = a[i];
        if arg == "--out" {
            if out != nil or i + 1 >= len(a) { _bad_option("invalid or duplicate output option"); }
            if _is_flag(a[i + 1]) { _bad_option("output option requires a path"); }
            out = a[i + 1]; i = i + 1;
        } elif arg == "--split-out" {
            if split_out != nil or i + 1 >= len(a) { _bad_option("invalid or duplicate --split-out option"); }
            if _is_flag(a[i + 1]) { _bad_option("--split-out requires a server vault .sapp path"); }
            split_out = a[i + 1]; i = i + 1;
        } elif arg == "--capture-shield" {
            capture_shield = true; capture_shield_explicit = true;
        } elif arg == "--no-capture-shield" {
            capture_shield = false; capture_shield_explicit = true;
        } elif arg == "--open-symbols" {
            open_symbols = true;
        } elif arg == "--obfuscate" {
            obfuscate_mode = true;
        } elif arg=="--module-contract" or arg=="--module-root" or arg=="--module-capability" {
            if i+1>=len(a) or _is_flag(a[i+1]) { _bad_option("module option requires a value"); }
            if arg=="--module-contract" {
                if module_contract!=nil { _bad_option("duplicate module contract"); }module_contract=a[i+1];
            } elif arg=="--module-root" {
                if module_root!=nil { _bad_option("duplicate module root"); }module_root=a[i+1];
            } else {
                if len(module_capabilities)>=64 { _bad_option("module capability limit"); }push(module_capabilities,a[i+1]);
            }
            i=i+1;
        } elif arg == "--target" {
            if target_set or i + 1 >= len(a) { _bad_option("invalid or duplicate target option"); }
            target = a[i + 1]; target_set = true; i = i + 1;
        } elif arg == "--aot-native" {
            if not target_set { target = "aot-native"; target_set = true; }
        } elif arg == "--hybrid" {
            hybrid_mode = true;
        } elif arg == "--freestanding" {
            freestanding_mode = true;
            if not target_set { target = "baremetal-x64"; target_set = true; }
        } elif arg == "--ip-seal" {
            ip_explicit = true;
        } elif arg == "--no-ip-seal" {
            ip_disable = true;
        } elif arg == "--free" {
            ip_mode = "free"; ip_explicit = true;
        } elif arg == "--free-attribution" {
            ip_mode = "free-attribution"; ip_explicit = true;
        } elif arg == "--stealth" or arg == "--stealth-ip" {
            ip_mode = "stealth-private"; ip_explicit = true;
        } elif arg == "--license" {
            if i + 1 >= len(a) or _is_flag(a[i + 1]) { _bad_option("--license requires an SPDX identifier"); }
            ip_spdx = a[i + 1];
            if ip_mode == "proprietary" { ip_mode = "open-source"; }
            ip_explicit = true; i = i + 1;
        } elif arg == "--copyright-holder" {
            if i + 1 >= len(a) or _is_flag(a[i + 1]) { _bad_option("--copyright-holder requires a name"); }
            ip_holder = a[i + 1]; ip_explicit = true; i = i + 1;
        } elif arg == "--sign-env" {
            if i + 1 >= len(a) or _is_flag(a[i + 1]) { _bad_option("--sign-env requires an environment variable name"); }
            sign_env_name = a[i + 1]; ip_explicit = true; i = i + 1;
        } elif arg == "--initialize" {
            if initialize!=nil or i+1>=len(a) or _is_flag(a[i+1]) { _bad_option("invalid initialize option"); }
            initialize=a[i+1];i=i+1;
        } elif arg == "--entry" or arg == "--cleanup" {
            if i + 1 >= len(a) or _is_flag(a[i + 1]) { _bad_option("entry/cleanup requires a function name"); }
            if arg == "--entry" {
                if entry != nil { _bad_option("duplicate entry option"); }
                entry = a[i + 1];
            } else {
                if cleanup != nil { _bad_option("duplicate cleanup option"); }
                cleanup = a[i + 1];
            }
            i = i + 1;
        } elif arg == "--bundle" {
            if bundle { _bad_option("duplicate bundle option"); }
            bundle=true;
        } elif arg == "--safe" { safe = true; }
        elif arg == "--overflow" or arg == "--checked-arith" { overflow = true; }
        elif arg == "--local-source" {
            if local_source { _bad_option("duplicate local source option"); }
            local_source = true;
        } elif str_starts_with(arg, "--max-source-bytes=") or str_starts_with(arg, "--max-tokens=") {
            let is_bytes = str_starts_with(arg, "--max-source-bytes=");
            let key = if is_bytes { "max_source_bytes" } else { "max_tokens" };
            let offset = if is_bytes { 19 } else { 13 };
            if map_has(budget, key) { _bad_option("duplicate source budget"); }
            let count = _count(str_slice(arg, offset, len(arg)));
            if count == nil { _bad_option("invalid source budget"); }
            budget[key] = count;
        } elif _is_flag(arg) { _bad_option("unknown option"); }
        else {
            if src != nil { _bad_option("exactly one source file is required"); }
            src = arg;
        }
        i = i + 1;
    }
    if src == nil { _bad_option("source file required; use SOURCE --out OUTPUT --target x64|aot-native|aot-pe64|baremetal-x64|baremetal-x86|android-apk|android-dex|ios-macho|ios-app|x64-dyn|pe64|arm64|linux-arm64|aarch64|macos-arm64|darwin-arm64|wasm|pbck|x86|pe32|rv32|dos16|cpm80|c64|avr8"); }
    let valid_targets = map{
        "x64": true, "aot-native": true, "aot-pe64": true, "baremetal-x64": true, "baremetal-x86": true,
        "android-apk": true, "android-dex": true, "ios-macho": true, "ios-app": true,
        "x64-dyn": true, "pe64": true, "arm64": true,
        "linux-arm64": true, "aarch64": true, "macos-arm64": true, "darwin-arm64": true,
        "wasm": true, "pbck": true,
        "x86": true, "pe32": true, "rv32": true, "dos16": true, "cpm80": true, "c64": true, "avr8": true
    };
    if not map_has(valid_targets, target) { _bad_option("unknown target"); }
    if (entry != nil or cleanup != nil) and (entry == nil or cleanup == nil or target != "pbck") {
        _bad_option("--entry and --cleanup require each other and --target pbck");
    }
    if initialize!=nil and (entry==nil or cleanup==nil) {
        _bad_option("--initialize requires --entry/--cleanup");
    }
    if bundle and target != "pbck" {
        _bad_option("--bundle requires --target pbck");
    }
    if local_source and target != "wasm" { _bad_option("local source admission is currently supported only for wasm"); }
    if not local_source and len(map_keys(budget)) != 0 { _bad_option("source budgets require --local-source"); }
    let validated = try SOURCE.local_budget(budget) catch nil;
    if validated == nil { _bad_option("invalid source budget"); }
    if target == "pbck" and (safe or overflow) { _bad_option("pbck does not implement --safe or --overflow"); }
    if out == nil {
        let sfx = "";
        if split_out != nil and not target_set { sfx = ".client.sapp"; }
        elif target == "pbck" { sfx = ".pbck"; }
        elif target == "pe64" or target == "pe32" or target == "aot-pe64" { sfx = ".exe"; }
        elif target == "baremetal-x64" or target == "baremetal-x86" { sfx = ".elf"; }
        elif target == "android-apk" { sfx = ".apk"; }
        elif target == "android-dex" { sfx = ".dex"; }
        elif target == "ios-macho" { sfx = ".macho"; }
        elif target == "ios-app" { sfx = "_ios_dist"; }
        elif target == "dos16" or target == "cpm80" { sfx = ".com"; }
        elif target == "c64" { sfx = ".prg"; }
        elif target == "avr8" { sfx = ".hex"; }
        out = _default_out(src) + sfx;
    }
    if target == "pbck" and (out == src or not _has_suffix(out, ".pbck")) {
        _bad_option("pbck output must be a separate .pbck file");
    }

    if (module_contract==nil)!=(module_root==nil) or (module_contract==nil and len(module_capabilities)>0) {
        _bad_option("module contract and root require each other");
    }
    if module_contract!=nil {
        let plan=modules.check(module_contract,module_root,module_capabilities);
        if not plan.ok { _bad_option("module contract rejected: "+plan.code); }
    }

    if bundle {
        let bytes:any=nil;
        if initialize!=nil {bytes=linker.compile_file_with_lifecycle(src,initialize,entry,cleanup);}
        elif entry==nil {bytes=linker.compile_file(src);}
        else {bytes=linker.compile_file_with_cleanup(src,entry,cleanup);}
        fs_write_bytes(out,bytes);
        print "pbc: compiled static native PBCK ("+str(len(bytes))+" bytes); runtime permissions remain separate";
        return nil;
    }

    // The optional byte budget applies after this existing whole-file read.
    let source = fs_read(src);
    let prevent_ss = if capture_shield_explicit { capture_shield } else { ip_mode != "free" };
    let ip_opts = map{ mode: ip_mode };
    if ip_spdx != nil { ip_opts["license"] = ip_spdx; }
    if ip_holder != nil { ip_opts["holder"] = ip_holder; }
    let seal_exec_default = (not ip_disable) and (not local_source);
    let seal_explicit_only = (not ip_disable) and ip_explicit;

    // ── Split-Execution Server Vault Extraction (`--split-out <server_vault.sapp>`) ──
    if split_out != nil {
        let split_res = cshield.compile_split_application(source);
        fs_write(split_out, split_res.server_vault_code);
        source = split_res.client_stub_code;
        if not target_set and _has_suffix(out, ".sapp") {
            let client_src = if obfuscate_mode { cshield.obfuscate_sapp_source(source).code } else { source };
            fs_write(out, client_src);
            print "pbc: split-compiled '" + str(src) + "' → client '" + str(out) + "' + vault '" + str(split_out) + "' (" + str(len(split_res.server_functions)) + " @server_only fn(s))";
            return nil;
        }
    }

    // ── Source-to-Source AST Obfuscation (`--obfuscate` with `.sapp` output) ──
    if obfuscate_mode and not target_set and _has_suffix(out, ".sapp") {
        let obf_res = cshield.obfuscate_sapp_source(source);
        fs_write(out, obf_res.code);
        print "pbc: obfuscated '" + str(src) + "' → '" + str(out) + "' (" + str(obf_res.renamed_count) + " symbols, " + str(obf_res.encrypted_strings) + " strings)";
        return nil;
    }

    if target == "pbck" {
        if obfuscate_mode {
            source = cshield.obfuscate_sapp_source(source).code;
        }
        // Finish lexical, semantic and translation checks before touching output.
        let bytes:any=nil;
        if initialize != nil { bytes=bridge.compile_source_with_lifecycle(source,initialize,entry,cleanup); }
        elif entry == nil { bytes=bridge.compile_source(source); }
        else { bytes=bridge.compile_source_with_cleanup(source,entry,cleanup); }
        bytes = _maybe_seal_bytes(bytes, "auto", seal_explicit_only, ip_opts, sign_env_name);
        fs_write_bytes(out, bytes);
        print "pbc: compiled native PBCK (" + str(len(bytes)) + " bytes); run with pblang run and explicit permissions";
        return nil;
    }

    // ── WASM: pure-pblang WebAssembly backend → a .wasm module exporting main() → i64. Runs in every
    // browser and wasm runtime (node, wasmtime, wasmer, deno) — pblang's universal-runtime / web target.
    if target == "wasm" {
        if safe or overflow { print "  note: --safe/--overflow are x64-only; wasm gets the engine's own sandboxing"; }
        let wbin = if local_source { wcg.compile_wasm_local(source, validated) } else { wcg.compile_wasm(source) };
        wbin = _maybe_seal_bytes(wbin, "wasm", seal_exec_default, ip_opts, sign_env_name);
        fs_write_bytes(out, wbin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(wbin)) + " bytes, WebAssembly module)";
        print "  run it:  node -e \"WebAssembly.instantiate(require('fs').readFileSync('" + str(out) + "')).then(r=>console.log(String(r.instance.exports.main())))\"";
        return nil;
    }

    // ── Direct Native Mobile Targets (Zero-Wrapper Android DEX/APK & Apple iOS ARM64 Mach-O/.app) ──
    if target == "android-dex" or target == "android-apk" or target == "ios-macho" or target == "ios-app" {
        let mob = import("stdlib:native/mobile_native_ios_android.sapp");
        let app_nm = _default_out(src);
        let mob_spec = map{
            app_name: app_nm,
            package_name: "org.pblang.app." + str_lower(app_nm),
            bundle_id: "org.pblang.ios." + str_lower(app_nm),
            title: app_nm,
            mode: ip_mode,
            prevent_screenshots: prevent_ss
        };
        if target == "android-dex" {
            let dbin = mob.build_android_dex(mob_spec);
            dbin = _maybe_seal_bytes(dbin, "auto", seal_explicit_only, ip_opts, sign_env_name);
            fs_write_bytes(out, dbin);
            print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(dbin)) + " bytes, Dalvik classes.dex 035)";
            return nil;
        }
        if target == "android-apk" {
            let abin = mob.build_android_apk(mob_spec, out);
            if seal_explicit_only {
                let sealed_apk = _maybe_seal_bytes(abin.apk_bytes, "auto", true, ip_opts, sign_env_name);
                fs_write_bytes(out, sealed_apk);
                print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(sealed_apk)) + " bytes, zipalign Android APK)";
            } else {
                print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(abin.apk_bytes)) + " bytes, zipalign Android APK)";
            }
            return nil;
        }
        if target == "ios-macho" {
            let mbin = mob.build_ios_arm64_macho(mob_spec);
            mbin = _maybe_seal_bytes(mbin, "auto", seal_exec_default, ip_opts, sign_env_name);
            fs_write_bytes(out, mbin);
            print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(mbin)) + " bytes, Apple iOS ARM64 Mach-O)";
            return nil;
        }
        let ibun = mob.build_ios_app_bundle(mob_spec, out);
        print "pbc: compiled '" + str(src) + "' → '" + str(ibun.bundle_dir) + "' (" + str(ibun.macho_size) + " bytes Mach-O + Info.plist)";
        return nil;
    }

    // ── Sovereign Pure-PBLang Native ARM64 (Linux AArch64 ELF64 & Apple Silicon macOS Mach-O 64) ──
    if target == "linux-arm64" or target == "aarch64" {
        let bin = arm64_native.build_linux_arm64_elf64(source, nil);
        bin = _maybe_seal_bytes(bin, "elf", seal_exec_default, ip_opts, sign_env_name);
        fs_write_bytes(out, bin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(bin)) + " bytes, static Linux AArch64/ARM64 ELF64)";
        print "  run on arm64 hardware:  chmod +x " + str(out) + " && ./" + str(out);
        return nil;
    }
    if target == "macos-arm64" or target == "darwin-arm64" {
        let mbin = arm64_native.build_apple_silicon_macho64(source, nil);
        mbin = _maybe_seal_bytes(mbin, "auto", seal_explicit_only, ip_opts, sign_env_name);
        fs_write_bytes(out, mbin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(mbin)) + " bytes, Apple Silicon macOS ARM64 Mach-O 64)";
        print "  run on Apple Silicon:  chmod +x " + str(out) + " && ./" + str(out);
        return nil;
    }

    // ── ARM64 cross-compile: pure-pblang AArch64 backend → a static EM_AARCH64 ELF (runs on real arm64 HW).
    if target == "arm64" {
        if safe or overflow { print "  note: --safe/--overflow are x64-only; the arm64 backend emits a static native ELF"; }
        let bin = try acg.compile_elf(source) catch arm64_native.build_linux_arm64_elf64(source, nil);
        bin = _maybe_seal_bytes(bin, "elf", seal_exec_default, ip_opts, sign_env_name);
        fs_write_bytes(out, bin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(bin)) + " bytes, static AArch64/ARM64 ELF)";
        print "  run on arm64 hardware:  chmod +x " + str(out) + " && ./" + str(out) + " ; echo $?";
        return nil;
    }

    // ── Dynamic x86-64 ELF64 (dlopen/dlsym/dlclose FFI) ──
    if target == "x64-dyn" {
        cg.set_overflow_check(overflow);
        let dbin = dcg.compile_dyn(source);
        cg.set_overflow_check(false);
        dbin = _maybe_seal_bytes(dbin, "elf", seal_exec_default, ip_opts, sign_env_name);
        fs_write_bytes(out, dbin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(dbin)) + " bytes, dynamic x86-64 ELF64 with dlopen FFI)";
        print "  run it:  chmod +x " + str(out) + " && ./" + str(out);
        return nil;
    }

    // ── Pure-PBLang Unboxed Native x86-64 AOT (`aot-native` ELF64 & `aot-pe64` Windows PE32+) ──
    if target == "aot-native" or target == "aot-pe64" {
        let ucg = import("stdlib:native/aot_unboxed_native.sapp");
        let aopts = map{
            target: target,
            hybrid: hybrid_mode,
            freestanding: freestanding_mode,
            mode: ip_mode,
            open_symbols: open_symbols,
            strip_symbols: (not open_symbols) and (ip_mode != "free"),
            obfuscate_strings: if obfuscate_mode { true } else { ip_mode != "free" }
        };
        let rep = ucg.compile_aot_native(source, aopts);
        let abin = _maybe_seal_bytes(rep["binary"], "auto", seal_exec_default, ip_opts, sign_env_name);
        fs_write_bytes(out, abin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(abin)) + " bytes, " + rep["format"] + " [" + rep["mode"] + "])";
        return nil;
    }

    // ── Pure-PBLang Bootable Ring-0 OS Kernel (`baremetal-x64` ELF64 & `baremetal-x86` ELF32) ──
    if target == "baremetal-x64" or target == "baremetal-x86" {
        let bmk = import("stdlib:native/baremetal_kernel_x64.sapp");
        let kopts = map{ target: target, freestanding: true };
        let krep = bmk.compile_baremetal_kernel(source, kopts);
        let kbin = _maybe_seal_bytes(krep["binary"], "elf", seal_explicit_only, ip_opts, sign_env_name);
        fs_write_bytes(out, kbin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(kbin)) + " bytes, Ring-0 " + krep["format"] + ")";
        return nil;
    }

    // ── Windows x86-64 PE32+ (.exe) Cross-Compile ──
    if target == "pe64" {
        if safe or overflow { print "  note: --safe/--overflow apply to ELF64 x64; pe64 uses native bounds/unwinding checks"; }
        let pbin = pcg.compile_pe64(source);
        pbin = _maybe_seal_bytes(pbin, "pe", seal_exec_default, ip_opts, sign_env_name);
        fs_write_bytes(out, pbin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(pbin)) + " bytes, Windows x86-64 PE32+ executable)";
        print "  run on Windows x64:  .\\" + str(out);
        return nil;
    }

    // ── <= 32-bit Native Targets (32-bit x86 ELF32, 32-bit PE32, 32-bit RV32IM, 16-bit 8086 DOS, 8-bit CP/M-80, 8-bit 6502 C64, 8-bit AVR) ──
    if target == "x86" {
        let bin = s32.compile_elf32_x86(source);
        bin = _maybe_seal_bytes(bin, "elf", seal_exec_default, ip_opts, sign_env_name);
        fs_write_bytes(out, bin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(bin)) + " bytes, static 32-bit i386 Linux ELF32)";
        print "  run it:  chmod +x " + str(out) + " && ./" + str(out);
        return nil;
    }
    if target == "pe32" {
        let bin = s32.compile_pe32_x86(source);
        bin = _maybe_seal_bytes(bin, "pe", seal_exec_default, ip_opts, sign_env_name);
        fs_write_bytes(out, bin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(bin)) + " bytes, 32-bit Windows i686 PE32 executable)";
        print "  run on 32/64-bit Windows:  .\\" + str(out);
        return nil;
    }
    if target == "rv32" {
        let bin = s32.compile_elf32_rv32(source);
        bin = _maybe_seal_bytes(bin, "elf", seal_exec_default, ip_opts, sign_env_name);
        fs_write_bytes(out, bin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(bin)) + " bytes, static 32-bit RISC-V RV32IM ELF32)";
        return nil;
    }
    if target == "dos16" {
        let bin = s32.compile_dos16_com(source);
        bin = _maybe_seal_bytes(bin, "rom", seal_explicit_only, ip_opts, sign_env_name);
        fs_write_bytes(out, bin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(bin)) + " bytes, 16-bit Real-Mode 8086 MS-DOS/FreeDOS .COM)";
        return nil;
    }
    if target == "cpm80" {
        let bin = s32.compile_cpm80_com(source);
        bin = _maybe_seal_bytes(bin, "rom", seal_explicit_only, ip_opts, sign_env_name);
        fs_write_bytes(out, bin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(bin)) + " bytes, 8-bit Intel 8080/Z80 CP/M-80 .COM)";
        return nil;
    }
    if target == "c64" {
        let bin = s32.compile_c64_prg(source);
        bin = _maybe_seal_bytes(bin, "rom", seal_explicit_only, ip_opts, sign_env_name);
        fs_write_bytes(out, bin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(bin)) + " bytes, 8-bit MOS 6502 Commodore 64 .PRG)";
        return nil;
    }
    if target == "avr8" {
        let bin = s32.compile_avr8_hex(source);
        fs_write_bytes(out, bin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(bin)) + " bytes, 8-bit Atmel AVR ATmega328P Intel HEX)";
        return nil;
    }

    // ── x86-64 (default) ──
    cg.set_overflow_check(overflow);
    if safe {
        let r = cg.compile_safe(source);
        let sbin = _maybe_seal_bytes(r.binary, "elf", seal_exec_default, ip_opts, sign_env_name);
        fs_write_bytes(out, sbin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(sbin)) + " bytes, selected runtime checks)";
        print "  memory-safety certified: " + str(r.memory_safety_certified) + "; runtime isolated: " + str(r.runtime_isolated);
        let g = r.guarantees; let k = 0;
        while k < len(g) { print "  ✓ " + g[k]; k = k + 1; }
    } else {
        let bin = cg.compile_fns(source);
        bin = _maybe_seal_bytes(bin, "elf", seal_exec_default, ip_opts, sign_env_name);
        fs_write_bytes(out, bin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(bin)) + " bytes, static native ELF)";
    }
    if overflow { print "  ✓ signed integer arithmetic is overflow-checked — add/sub/mul/neg trap (SIGILL, exit 132) instead of wrapping"; }
    cg.set_overflow_check(false);   // reset the global so a reused module never leaks the mode
    print "run it:  chmod +x " + str(out) + " && ./" + str(out);
    return nil;
}

main();
