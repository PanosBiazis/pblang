// tools/pbc.sapp — compile PBLang to a native executable, WASM, or native-VM PBCK.
//
//   pblang run tools/pbc.sapp <program.sapp> [--out <bin>] [--target x64|arm64|wasm|pbck] [--safe] [--overflow]
// --target pbck emits native-VM bytecode, not a standalone executable or PBCS.
// PBCK-only --bundle statically links trusted project dependencies.
// PBCK-only --entry NAME --cleanup NAME adds an explicit native error cleanup boundary.
// Optional --initialize NAME runs declared initialization inside that boundary.
// --module-contract FILE --module-root ID [--module-capability NAME] checks explicit compatibility before compilation.
//
// --target wasm --local-source uses developer admission with optional
// --max-source-bytes=N and --max-tokens=N; other targets retain strict admission.
//
// --target arm64 CROSS-COMPILES from x86-64 to a static AArch64/ARM64 ELF using the pure-pblang arm64 backend
// (stdlib/codegen_arm64_ast.sapp) — no cross-toolchain needed. Integer subset (fn/if/elif/while/arith/print/
// calls/recursion); copy the result to any arm64 device (Pi, phone, arm64 server, Apple-silicon VM) and run it.
//
// Uses the pure-pblang code generator (stdlib/native/codegen_x64.sapp) to emit a minimal static ELF —
// no libc or external toolchain. --safe retains its compatibility name and reports
// selected runtime checks; it is not a memory-safety certificate or isolation
// boundary. Valid generated array/map handles receive selected access checks.
// --overflow turns on checked signed add/sub/mul/neg (SIGILL on overflow).
//
// Supported source is the codegen subset (numbers, strings + str()/concat/slice/char, if/elif/else,
// while, functions + recursion, closures, arrays + push, maps). Unsupported constructs fail loud.

let cg = import("stdlib/native/codegen_x64.sapp");
let OS = import("stdlib:os.sapp");
let SOURCE = import("stdlib:compiler/checked_source.sapp");
// Bind tool dependencies while the retained host still has this script origin.
// Deferred imports inside main() would instead resolve against the caller cwd.
let modules = import("stdlib:controlled_modularity_file.sapp");
let linker = import("stdlib:compiler/native_bundle.sapp");
let bridge = import("stdlib:compiler/native_pbck.sapp");
let wcg = import("stdlib:codegen_wasm.sapp");
let acg = import("stdlib:codegen_arm64_ast.sapp");

fn _bad_option(message) { print "pbc: " + message; os_exit(2); }
fn _count(text) {
    if len(text) == 0 { return nil; }
    for ch in str_split(text, "") {
        let code = strcharcodeat(ch, 0);
        if code < 48 or code > 57 { return nil; }
    }
    return try parse_number(text) catch nil;
}

fn _is_flag(a) { return len(a) > 0 and strcharcodeat(a, 0) == 45; }
fn _has_suffix(f, ext) { if len(f) <= len(ext) { return false; } return str_slice(f, len(f) - len(ext), len(f)) == ext; }
fn _default_out(src) {
    // strip directory and the trailing ".sapp"
    let parts = str_split(src, "/");
    let base = parts[len(parts) - 1];
    if _has_suffix(base, ".sapp") { return str_slice(base, 0, len(base) - 5); }
    return base;
}

fn main() {
    let a = OS.script_args();
    let src: any = nil; let out: any = nil; let safe = false; let overflow = false; let target = "x64"; let i = 0;
    let entry:any=nil; let cleanup:any=nil; let initialize:any=nil; let bundle=false;
    let module_contract:any=nil;let module_root:any=nil;let module_capabilities=[];
    let local_source = false; let budget = map{}; let target_set = false;
    while i < len(a) {
        let arg = a[i];
        if arg == "--out" {
            if out != nil or i + 1 >= len(a) { _bad_option("invalid or duplicate output option"); }
            if _is_flag(a[i + 1]) { _bad_option("output option requires a path"); }
            out = a[i + 1]; i = i + 1;
        } elif arg=="--module-contract" or arg=="--module-root" or arg=="--module-capability" {
            if i+1>=len(a) or _is_flag(a[i+1]) { _bad_option("module option requires a value"); }
            if arg=="--module-contract" {
                if module_contract!=nil { _bad_option("duplicate module contract"); }module_contract=a[i+1];
            } elif arg=="--module-root" {
                if module_root!=nil { _bad_option("duplicate module root"); }module_root=a[i+1];
            } else {
                if len(module_capabilities)>=64 { _bad_option("module capability limit"); }push(module_capabilities,a[i+1]);
            }
            i=i+1;
        } elif arg == "--target" {
            if target_set or i + 1 >= len(a) { _bad_option("invalid or duplicate target option"); }
            target = a[i + 1]; target_set = true; i = i + 1;
        } elif arg == "--initialize" {
            if initialize!=nil or i+1>=len(a) or _is_flag(a[i+1]) { _bad_option("invalid initialize option"); }
            initialize=a[i+1];i=i+1;
        } elif arg == "--entry" or arg == "--cleanup" {
            if i + 1 >= len(a) or _is_flag(a[i + 1]) { _bad_option("entry/cleanup requires a function name"); }
            if arg == "--entry" {
                if entry != nil { _bad_option("duplicate entry option"); }
                entry = a[i + 1];
            } else {
                if cleanup != nil { _bad_option("duplicate cleanup option"); }
                cleanup = a[i + 1];
            }
            i = i + 1;
        } elif arg == "--bundle" {
            if bundle { _bad_option("duplicate bundle option"); }
            bundle=true;
        } elif arg == "--safe" { safe = true; }
        elif arg == "--overflow" or arg == "--checked-arith" { overflow = true; }
        elif arg == "--local-source" {
            if local_source { _bad_option("duplicate local source option"); }
            local_source = true;
        } elif str_starts_with(arg, "--max-source-bytes=") or str_starts_with(arg, "--max-tokens=") {
            let is_bytes = str_starts_with(arg, "--max-source-bytes=");
            let key = if is_bytes { "max_source_bytes" } else { "max_tokens" };
            let offset = if is_bytes { 19 } else { 13 };
            if map_has(budget, key) { _bad_option("duplicate source budget"); }
            let count = _count(str_slice(arg, offset, len(arg)));
            if count == nil { _bad_option("invalid source budget"); }
            budget[key] = count;
        } elif _is_flag(arg) { _bad_option("unknown option"); }
        else {
            if src != nil { _bad_option("exactly one source file is required"); }
            src = arg;
        }
        i = i + 1;
    }
    if src == nil { _bad_option("source file required; use SOURCE --out OUTPUT --target x64|arm64|wasm|pbck"); }
    if target != "x64" and target != "arm64" and target != "wasm" and target != "pbck" { _bad_option("unknown target"); }
    if (entry != nil or cleanup != nil) and (entry == nil or cleanup == nil or target != "pbck") {
        _bad_option("--entry and --cleanup require each other and --target pbck");
    }
    if initialize!=nil and (entry==nil or cleanup==nil) {
        _bad_option("--initialize requires --entry/--cleanup");
    }
    if bundle and target != "pbck" {
        _bad_option("--bundle requires --target pbck");
    }
    if local_source and target != "wasm" { _bad_option("local source admission is currently supported only for wasm"); }
    if not local_source and len(map_keys(budget)) != 0 { _bad_option("source budgets require --local-source"); }
    let validated = try SOURCE.local_budget(budget) catch nil;
    if validated == nil { _bad_option("invalid source budget"); }
    if target == "pbck" and (safe or overflow) { _bad_option("pbck does not implement --safe or --overflow"); }
    if out == nil { out = _default_out(src) + if target == "pbck" { ".pbck" } else { "" }; }
    if target == "pbck" and (out == src or not _has_suffix(out, ".pbck")) {
        _bad_option("pbck output must be a separate .pbck file");
    }

    if (module_contract==nil)!=(module_root==nil) or (module_contract==nil and len(module_capabilities)>0) {
        _bad_option("module contract and root require each other");
    }
    if module_contract!=nil {
        let plan=modules.check(module_contract,module_root,module_capabilities);
        if not plan.ok { _bad_option("module contract rejected: "+plan.code); }
    }

    if bundle {
        let bytes:any=nil;
        if initialize!=nil {bytes=linker.compile_file_with_lifecycle(src,initialize,entry,cleanup);}
        elif entry==nil {bytes=linker.compile_file(src);}
        else {bytes=linker.compile_file_with_cleanup(src,entry,cleanup);}
        fs_write_bytes(out,bytes);
        print "pbc: compiled static native PBCK ("+str(len(bytes))+" bytes); runtime permissions remain separate";
        return nil;
    }

    // The optional byte budget applies after this existing whole-file read.
    let source = fs_read(src);

    if target == "pbck" {
        // Finish lexical, semantic and translation checks before touching output.
        let bytes:any=nil;
        if initialize != nil { bytes=bridge.compile_source_with_lifecycle(source,initialize,entry,cleanup); }
        elif entry == nil { bytes=bridge.compile_source(source); }
        else { bytes=bridge.compile_source_with_cleanup(source,entry,cleanup); }
        fs_write_bytes(out, bytes);
        print "pbc: compiled native PBCK (" + str(len(bytes)) + " bytes); run with pblang run and explicit permissions";
        return nil;
    }

    // ── WASM: pure-pblang WebAssembly backend → a .wasm module exporting main() → i64. Runs in every
    // browser and wasm runtime (node, wasmtime, wasmer, deno) — pblang's universal-runtime / web target.
    if target == "wasm" {
        if safe or overflow { print "  note: --safe/--overflow are x64-only; wasm gets the engine's own sandboxing"; }
        let wbin = if local_source { wcg.compile_wasm_local(source, validated) } else { wcg.compile_wasm(source) };
        fs_write_bytes(out, wbin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(wbin)) + " bytes, WebAssembly module)";
        print "  run it:  node -e \"WebAssembly.instantiate(require('fs').readFileSync('" + str(out) + "')).then(r=>console.log(String(r.instance.exports.main())))\"";
        return nil;
    }

    // ── ARM64 cross-compile: pure-pblang AArch64 backend → a static EM_AARCH64 ELF (runs on real arm64 HW).
    // Integer subset: fn/params, let/assign, if/elif/else, while, +-*/%, comparisons, and/or, bitwise, print,
    // calls, recursion. No external toolchain — one command from x86-64 to an ARM64 binary.
    if target == "arm64" {
        if safe or overflow { print "  note: --safe/--overflow are x64-only; the arm64 backend emits a plain integer ELF"; }
        let bin = acg.compile_elf(source);
        fs_write_bytes(out, bin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(bin)) + " bytes, static AArch64/ARM64 ELF)";
        print "  run on arm64 hardware:  chmod +x " + str(out) + " && ./" + str(out) + " ; echo $?";
        return nil;
    }

    // ── x86-64 (default) ──
    // Checked arithmetic is a global codegen mode; set it BEFORE emitting so it reaches every
    // add/sub/mul/neg site (shared by both the plain and --safe lowering paths).
    cg.set_overflow_check(overflow);
    if safe {
        let r = cg.compile_safe(source);
        fs_write_bytes(out, r.binary);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(r.binary)) + " bytes, selected runtime checks)";
        print "  memory-safety certified: " + str(r.memory_safety_certified) + "; runtime isolated: " + str(r.runtime_isolated);
        let g = r.guarantees; let k = 0;
        while k < len(g) { print "  ✓ " + g[k]; k = k + 1; }
    } else {
        let bin = cg.compile_fns(source);
        fs_write_bytes(out, bin);
        print "pbc: compiled '" + str(src) + "' → '" + str(out) + "' (" + str(len(bin)) + " bytes, static native ELF)";
    }
    if overflow { print "  ✓ signed integer arithmetic is overflow-checked — add/sub/mul/neg trap (SIGILL, exit 132) instead of wrapping"; }
    cg.set_overflow_check(false);   // reset the global so a reused module never leaks the mode
    print "run it:  chmod +x " + str(out) + " && ./" + str(out);
    return nil;
}

main();
