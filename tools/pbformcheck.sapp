// Check one UTF-8 text DFM without executing it, opening a listener or changing it.
// Exit 0 means web structural preflight passed, NOT complete application migration.
let Forms=import("stdlib:ui_form_check.sapp");
let Secure=import("stdlib:secure_file.sapp");
let OS=import("stdlib:os.sapp");
let args=OS.script_args();
if len(args) != 1 or type(args[0]) != "string" or len(args[0]) < 1 or len(args[0]) > 4096 {
    print json_stringify(map{ok:false, error:"usage: pbformcheck.sapp INPUT.dfm", format:"pblang.form-check.v1"});os_exit(2);
}
let loaded=try Secure.read_text(args[0], 1048576, false) catch nil;
if loaded == nil or not loaded.ok {
    print json_stringify(map{ok:false, error:"input-unavailable-or-invalid-utf8", format:"pblang.form-check.v1"});os_exit(2);
}
let report=Forms.analyze_dfm(loaded.text);print json_stringify(report);
os_exit(if report.ok {0} else {1});
