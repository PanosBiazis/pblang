//
// tools/ci_source_validation.sapp — 100% Pure-PBLang Repository Source & Package Metadata
// Integrity Validator (replaces inline Python in .github/workflows/source-validation.yml).

let SOURCE_SUFFIXES = map{
    ".sapp": true, ".rs": true, ".py": true, ".php": true, ".js": true, ".ts": true,
    ".sh": true, ".yml": true, ".yaml": true, ".toml": true, ".css": true, ".html": true,
    ".htm": true, ".xml": true, ".sql": true, ".java": true, ".kt": true, ".kts": true,
    ".c": true, ".h": true, ".cpp": true, ".hpp": true, ".cs": true, ".go": true,
    ".asm": true, ".lua": true, ".jsx": true, ".tsx": true, ".vue": true, ".swift": true,
    ".rb": true, ".pl": true, ".r": true, ".R": true, ".ps1": true
};

let MAX_SOURCE_SCAN_BYTES = 8388608; // 8 MiB

fn _is_regular_file(path) {
    if (try fs_exists(path) catch false) != true { return false; }
    let dir_probe = try fs_listdir(path) catch nil;
    if is_array(dir_probe) { return false; }
    return true;
}

fn _file_suffix(path) {
    let base = path_basename(path);
    let last_dot = -1;
    let i = 0;
    while i < len(base) {
        if strcharcodeat(base, i) == 46 {
            last_dot = i;
        }
        i = i + 1;
    }
    if last_dot <= 0 { return ""; }
    return str_slice(base, last_dot, len(base));
}

fn _bytes_match_at(b, pos, pat) {
    let pn = len(pat);
    if pos + pn > len(b) { return false; }
    let i = 0;
    while i < pn {
        if b[pos + i] != pat[i] { return false; }
        i = i + 1;
    }
    return true;
}

fn has_unresolved_merge_marker(file_bytes) {
    let m_left = str_to_bytes("<<<" + "<<<< ");
    let m_right = str_to_bytes(">>>" + ">>>> ");
    let n = len(file_bytes);
    let i = 0;
    let at_line_start = true;
    while i < n {
        if at_line_start {
            if (_bytes_match_at(file_bytes, i, m_left) or _bytes_match_at(file_bytes, i, m_right)) {
                let after = i + 8;
                if after < n and file_bytes[after] != 10 and file_bytes[after] != 13 {
                    return true;
                }
            }
        }
        let ch = file_bytes[i];
        at_line_start = (ch == 10 or ch == 13);
        i = i + 1;
    }
    return false;
}

fn _has_nonstandard_json_constant(text) {
    // Reject bare NaN, Infinity, -Infinity outside JSON double-quoted strings
    let in_str = false;
    let esc = false;
    let i = 0;
    let n = len(text);
    while i < n {
        let c = strcharcodeat(text, i);
        if in_str {
            if esc { esc = false; }
            elif c == 92 { esc = true; }
            elif c == 34 { in_str = false; }
            i = i + 1;
        } else {
            if c == 34 {
                in_str = true;
                i = i + 1;
            } elif (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 {
                let start = i;
                while i < n {
                    let cw = strcharcodeat(text, i);
                    if (cw >= 65 and cw <= 90) or (cw >= 97 and cw <= 122) or (cw >= 48 and cw <= 57) or cw == 95 {
                        i = i + 1;
                    } else {
                        break;
                    }
                }
                let ident = str_slice(text, start, i);
                if ident != "true" and ident != "false" and ident != "null" {
                    return ident;
                }
            } else {
                i = i + 1;
            }
        }
    }
    return nil;
}

fn _strip_toml_comment_strict(line) {
    let out = "";
    let in_dq = false;
    let in_sq = false;
    let esc = false;
    let i = 0;
    let n = len(line);
    while i < n {
        let c = strcharcodeat(line, i);
        if c == 35 and not in_dq and not in_sq {
            return map{ ok: true, text: out };
        }
        if c == 34 and not in_sq and not esc {
            in_dq = not in_dq;
        } elif c == 39 and not in_dq {
            in_sq = not in_sq;
        }
        out = out + str_slice(line, i, i + 1);
        if in_dq and c == 92 and not esc {
            esc = true;
        } else {
            esc = false;
        }
        i = i + 1;
    }
    if in_dq or in_sq {
        return map{ ok: false, error: "unterminated quoted string in TOML" };
    }
    return map{ ok: true, text: out };
}

fn _unquote_simple(raw) {
    let t = str_trim(raw);
    if len(t) >= 2 and str_starts_with(t, "\"") and str_ends_with(t, "\"") {
        return str_slice(t, 1, len(t) - 1);
    }
    if len(t) >= 2 and str_starts_with(t, "'") and str_ends_with(t, "'") {
        return str_slice(t, 1, len(t) - 1);
    }
    return nil;
}

fn parse_and_validate_toml(text) {
    if str_contains(text, strfromcharcode(0)) {
        return map{ ok: false, error: "TOML contains NUL byte" };
    }
    let norm = str_replace_all(str_replace_all(text, "\r\n", "\n"), "\r", "\n");
    let lines = str_split(norm, "\n");
    let sections = map{};
    let bin_paths = [];
    let lib_path = nil;
    let cur_sec = "";
    let in_bin_array = false;
    let bracket_depth = 0;
    let brace_depth = 0;
    sections[""] = map{};

    let i = 0;
    while i < len(lines) {
        let stripped = _strip_toml_comment_strict(lines[i]);
        if not stripped.ok {
            return map{ ok: false, error: stripped.error + " at line " + str(i + 1) };
        }
        let ln = str_trim(stripped.text);
        if ln != "" {
            if bracket_depth == 0 and brace_depth == 0 and str_starts_with(ln, "[") {
                if str_starts_with(ln, "[[") {
                    if not str_ends_with(ln, "]]") {
                        return map{ ok: false, error: "malformed TOML array-of-tables header at line " + str(i + 1) };
                    }
                    cur_sec = str_trim(str_slice(ln, 2, len(ln) - 2));
                    in_bin_array = (cur_sec == "bin");
                } else {
                    if not str_ends_with(ln, "]") {
                        return map{ ok: false, error: "malformed TOML table header at line " + str(i + 1) };
                    }
                    cur_sec = str_trim(str_slice(ln, 1, len(ln) - 1));
                    in_bin_array = false;
                }
                if cur_sec == "" {
                    return map{ ok: false, error: "empty TOML section header at line " + str(i + 1) };
                }
                if not map_has(sections, cur_sec) {
                    sections[cur_sec] = map{};
                }
            } else {
                if bracket_depth == 0 and brace_depth == 0 {
                    let eq = str_index_of(ln, "=");
                    if eq <= 0 {
                        return map{ ok: false, error: "expected key = value in TOML at line " + str(i + 1) };
                    }
                    let k = str_trim(str_slice(ln, 0, eq));
                    let rhs = str_trim(str_slice(ln, eq + 1, len(ln)));
                    if k == "" or rhs == "" {
                        return map{ ok: false, error: "incomplete assignment in TOML at line " + str(i + 1) };
                    }
                    let uq = _unquote_simple(rhs);
                    if not map_has(sections, cur_sec) {
                        sections[cur_sec] = map{};
                    }
                    sections[cur_sec][k] = if uq != nil { uq } else { rhs };
                    if in_bin_array and k == "path" and uq != nil {
                        array_push(bin_paths, uq);
                    }
                    if cur_sec == "lib" and k == "path" and uq != nil {
                        lib_path = uq;
                    }
                }
                // Update multiline bracket/brace depth outside strings
                let in_s = false;
                let s_ch = 0;
                let esc = false;
                let c_idx = 0;
                while c_idx < len(ln) {
                    let ch = strcharcodeat(ln, c_idx);
                    if in_s {
                        if esc { esc = false; }
                        elif ch == 92 and s_ch == 34 { esc = true; }
                        elif ch == s_ch { in_s = false; }
                    } else {
                        if ch == 34 or ch == 39 { in_s = true; s_ch = ch; }
                        elif ch == 91 { bracket_depth = bracket_depth + 1; }
                        elif ch == 93 { bracket_depth = bracket_depth - 1; }
                        elif ch == 123 { brace_depth = brace_depth + 1; }
                        elif ch == 125 { brace_depth = brace_depth - 1; }
                    }
                    c_idx = c_idx + 1;
                }
                if bracket_depth < 0 or brace_depth < 0 {
                    return map{ ok: false, error: "unbalanced brackets/braces in TOML at line " + str(i + 1) };
                }
            }
        }
        i = i + 1;
    }
    if bracket_depth != 0 or brace_depth != 0 {
        return map{ ok: false, error: "unclosed multiline array or inline table in TOML" };
    }
    return map{
        ok: true,
        sections: sections,
        bin_paths: bin_paths,
        lib_path: lib_path
    };
}

fn validate_basic_xml(text) {
    // Lightweight well-formed XML tag stack validator for pom.xml / .*proj
    let stack = [];
    let n = len(text);
    let i = 0;
    while i < n {
        if strcharcodeat(text, i) == 60 { // '<'
            if i + 3 < n and str_slice(text, i, i + 4) == "<!--" {
                let end_c = str_index_of(str_slice(text, i + 4, n), "-->");
                if end_c < 0 { return map{ ok: false, error: "unclosed XML comment" }; }
                i = i + 4 + end_c + 3;
                continue;
            }
            if i + 8 < n and str_slice(text, i, i + 9) == "<![CDATA[" {
                let end_cd = str_index_of(str_slice(text, i + 9, n), "]]>");
                if end_cd < 0 { return map{ ok: false, error: "unclosed XML CDATA" }; }
                i = i + 9 + end_cd + 3;
                continue;
            }
            let gt = -1;
            let in_q = 0;
            let j = i + 1;
            while j < n {
                let cj = strcharcodeat(text, j);
                if in_q != 0 {
                    if cj == in_q { in_q = 0; }
                } else {
                    if cj == 34 or cj == 39 { in_q = cj; }
                    elif cj == 62 { gt = j; break; }
                }
                j = j + 1;
            }
            if gt < 0 { return map{ ok: false, error: "unclosed XML tag" }; }
            let inner = str_trim(str_slice(text, i + 1, gt));
            if inner == "" { return map{ ok: false, error: "empty XML tag" }; }
            let c0 = strcharcodeat(inner, 0);
            if c0 != 63 and c0 != 33 { // skip <?...?> and <!DOCTYPE ...>
                if c0 == 47 { // closing </tag>
                    let close_name = str_trim(str_slice(inner, 1, len(inner)));
                    if len(stack) == 0 {
                        return map{ ok: false, error: "unexpected closing tag </" + close_name + ">" };
                    }
                    let top = stack[len(stack) - 1];
                    pop(stack);
                    if top != close_name {
                        return map{ ok: false, error: "mismatched XML tag: expected </" + top + ">, got </" + close_name + ">" };
                    }
                } elif not str_ends_with(inner, "/") {
                    let k = 0;
                    while k < len(inner) {
                        let ck = strcharcodeat(inner, k);
                        if ck == 32 or ck == 9 or ck == 10 or ck == 13 or ck == 47 { break; }
                        k = k + 1;
                    }
                    let open_name = str_slice(inner, 0, k);
                    if open_name == "" { return map{ ok: false, error: "invalid XML element name" }; }
                    array_push(stack, open_name);
                }
            }
            i = gt + 1;
        } else {
            i = i + 1;
        }
    }
    if len(stack) != 0 {
        return map{ ok: false, error: "unclosed XML element <" + stack[len(stack) - 1] + ">" };
    }
    return map{ ok: true };
}

fn _cargo_targets_exist(parsed_cargo) {
    let candidates = ["src/lib.rs", "src/main.rs"];
    if _is_regular_file("src/lib.rs") or _is_regular_file("src/main.rs") {
        return true;
    }
    let bin_dir = try fs_listdir("src/bin") catch nil;
    if is_array(bin_dir) {
        let i = 0;
        while i < len(bin_dir) {
            let entry = "src/bin/" + bin_dir[i];
            if str_ends_with(entry, ".rs") and _is_regular_file(entry) {
                return true;
            }
            if _is_regular_file(entry + "/main.rs") {
                return true;
            }
            i = i + 1;
        }
    }
    let bp = parsed_cargo.bin_paths;
    let bi = 0;
    while bi < len(bp) {
        if _is_regular_file(bp[bi]) { return true; }
        bi = bi + 1;
    }
    if parsed_cargo.lib_path != nil and _is_regular_file(parsed_cargo.lib_path) {
        return true;
    }
    return false;
}

fn run_source_validation() {
    let git_res = proc_spawn_wait("git", ["ls-files", "-s"]);
    if git_res.exit_code != 0 {
        throw "git ls-files -s failed: " + str(git_res.stderr);
    }
    let raw_lines = str_split(str_replace_all(git_res.stdout, "\r\n", "\n"), "\n");
    let files = [];
    let symlinks = map{};
    let i = 0;
    while i < len(raw_lines) {
        let ln = raw_lines[i];
        if ln != "" {
            let tab = str_index_of(ln, "\t");
            if tab > 0 {
                let meta = str_slice(ln, 0, tab);
                let rel = str_slice(ln, tab + 1, len(ln));
                array_push(files, rel);
                if str_starts_with(meta, "120000 ") {
                    symlinks[rel] = true;
                }
            }
        }
        i = i + 1;
    }

    let errors = [];

    // 1. Scan tracked source files (<= 8 MiB) for unresolved Git merge conflict markers
    i = 0;
    while i < len(files) {
        let p = files[i];
        if not map_has(symlinks, p) and _is_regular_file(p) {
            let suf = _file_suffix(p);
            if map_has(SOURCE_SUFFIXES, suf) {
                let fb = fs_read_bytes(p);
                if len(fb) <= MAX_SOURCE_SCAN_BYTES {
                    if has_unresolved_merge_marker(fb) {
                        array_push(errors, p + ": unresolved merge marker");
                    }
                }
            }
        }
        i = i + 1;
    }

    // 2. Validate pblang.toml, pblang.lock, Cargo.toml, and package.json
    let manifests = ["pblang.toml", "pblang.lock", "Cargo.toml", "package.json"];
    let mi = 0;
    while mi < len(manifests) {
        let name = manifests[mi];
        if _is_regular_file(name) {
            let text = try fs_read(name) catch nil;
            if text == nil {
                array_push(errors, name + ": unreadable UTF-8 text");
            } elif str_ends_with(name, ".json") {
                let bad_const = _has_nonstandard_json_constant(text);
                if bad_const != nil {
                    array_push(errors, name + ": non-standard JSON constant: " + bad_const);
                } else {
                    let parsed_json = try json_parse(text) catch nil;
                    if parsed_json == nil and str_trim(text) != "null" {
                        array_push(errors, name + ": invalid JSON syntax");
                    }
                }
            } else {
                let parsed_toml = parse_and_validate_toml(text);
                if not parsed_toml.ok {
                    array_push(errors, name + ": " + parsed_toml.error);
                } else {
                    let secs = parsed_toml.sections;
                    if name == "Cargo.toml" and map_has(secs, "package") {
                        if not _cargo_targets_exist(parsed_toml) {
                            array_push(errors, name + ": package has no existing library or binary target");
                        }
                    }
                    if name == "pblang.toml" and map_has(secs, "package") {
                        let pkg = secs["package"];
                        if map_has(pkg, "entry") {
                            let entry = pkg["entry"];
                            if type(entry) != "string" or entry == "" or not _is_regular_file(entry) {
                                array_push(errors, name + ": declared entry must name an existing file: " + str(entry));
                            }
                        }
                    }
                }
            }
        }
        mi = mi + 1;
    }

    // 3. Validate pom.xml / .csproj / .vbproj / .fsproj if present
    i = 0;
    while i < len(files) {
        let p = files[i];
        if not map_has(symlinks, p) and _is_regular_file(p) {
            let base = path_basename(p);
            let suf = _file_suffix(p);
            if base == "pom.xml" or suf == ".csproj" or suf == ".vbproj" or suf == ".fsproj" {
                let xtext = try fs_read(p) catch nil;
                if xtext == nil {
                    array_push(errors, p + ": invalid UTF-8 XML");
                } else {
                    let xv = validate_basic_xml(xtext);
                    if not xv.ok {
                        array_push(errors, p + ": invalid XML: " + xv.error);
                    }
                }
            }
        }
        i = i + 1;
    }

    // 4. Validate FILES.sha256 if present
    if _is_regular_file("FILES.sha256") {
        let ctext = fs_read("FILES.sha256");
        let clines = str_split(str_replace_all(ctext, "\r\n", "\n"), "\n");
        let saw_nonempty = false;
        let ci = 0;
        while ci < len(clines) {
            let line = clines[ci];
            if str_trim(line) != "" {
                saw_nonempty = true;
                if len(line) < 67 {
                    array_push(errors, "FILES.sha256: malformed checksum line");
                } else {
                    let expected = str_slice(line, 0, 64);
                    let sep = str_slice(line, 64, 66);
                    let fname = str_slice(line, 66, len(line));
                    if not regex_match(expected, "^[0-9a-fA-F]{64}$") or (sep != "  " and sep != " *") or fname == "" {
                        array_push(errors, "FILES.sha256: malformed checksum line");
                    } elif not _is_regular_file(fname) {
                        array_push(errors, "FILES.sha256: missing or changed file: " + fname);
                    } else {
                        let actual = sha256(bytes_to_str(fs_read_bytes(fname)));
                        if actual != str_lower(expected) {
                            array_push(errors, "FILES.sha256: missing or changed file: " + fname);
                        }
                    }
                }
            }
            ci = ci + 1;
        }
        if not saw_nonempty {
            array_push(errors, "FILES.sha256: checksum manifest is empty");
        }
    }

    let ei = 0;
    while ei < len(errors) {
        println(errors[ei]);
        ei = ei + 1;
    }

    let summary = "Checked " + str(len(files)) + " tracked paths and available package metadata. This is a source-integrity check; runtime, GUI and device tests are separate.\n";
    print(summary);

    let step_summary_path = env_get("GITHUB_STEP_SUMMARY");
    if step_summary_path != nil and step_summary_path != "" {
        fs_append(step_summary_path, summary);
    }

    if len(errors) > 0 {
        os_exit(1);
    }

    return map{
        ok: true,
        checked_count: len(files),
        errors: errors
    };
}

if env_get("PBLANG_CI_SOURCE_VAL_LIB") != "1" {
    run_source_validation();
}

export run_source_validation, has_unresolved_merge_marker, parse_and_validate_toml, validate_basic_xml;
