// Validate one explicit contract file; never discover or load project sources.
let OS=import("stdlib:os.sapp");let CONTRACT=import("stdlib:controlled_modularity_file.sapp");
let args=OS.script_args();
if len(args)<2 or len(args)>66 {print "usage: pbmodules CONTRACT.json ROOT [AVAILABLE_CAPABILITY ...]";os_exit(2);}
let capabilities=[];let i=2;while i<len(args) {push(capabilities,args[i]);i=i+1;}
let result=CONTRACT.check(args[0],args[1],capabilities);
print json_stringify(result);
if not result.ok {os_exit(1);}
