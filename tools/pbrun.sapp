// tools/pbrun.sapp — run a self-hosted (PBCS) .pbck bytecode file.
//
// Loads a .pbck artifact emitted by the pblang self-hosted toolchain
// (selfhost_pbck.write_file / selfhost_bundle.write_bundle_selfhost) and executes
// it on the self-hosted VM — no Rust front-end re-parses anything. This is the
// toolchain-facing surface of stdlib/selfhost_loader.sapp.
//
// Usage:
//   pblang run tools/pbrun.sapp --allow-all <file.pbck>          # run it
//   pblang run tools/pbrun.sapp --allow-all --info <file.pbck>   # inspect, don't run
//
// Prints the program's captured output, one value per line. With --info, prints
// the artifact's structure (bytes / instructions / constants / functions) instead
// of running it. On error, prints a message prefixed with "pbrun:".
//
// NOTE: this runs the SELF-HOSTED (PBCS) container. For the Rust-format .pbck use
// the built-in `pblang run <file.pbck>` instead.

let loader = import("stdlib/selfhost_loader.sapp");

// Collect user args after this script path, dropping pblang's own --allow* flags.
// os_args() = ["run", <script>, "--allow-all", <user args...>].
fn user_args() {
    let a = os_args();
    let out = [];
    let i = 0;
    let seen_script = false;
    while i < len(a) {
        let tok = a[i];
        if not seen_script {
            if str_ends_with(tok, "pbrun.sapp") { seen_script = true; }
            i = i + 1;
            continue;
        }
        if not str_starts_with(tok, "--allow") { array_push(out, tok); }
        i = i + 1;
    }
    return out;
}

let args = user_args();

// --info: inspect the artifact's structure instead of running it.
let want_info = false;
let path = nil;
let ai = 0;
while ai < len(args) {
    if args[ai] == "--info" { want_info = true; }
    else if path == nil and not str_starts_with(args[ai], "--") { path = args[ai]; }
    ai = ai + 1;
}

if want_info {
    if path == nil {
        print "pbrun: usage: pblang run tools/pbrun.sapp --allow-all --info <file.pbck>";
    } else {
        let info = loader.inspect_pbck(path);
        if info.ok {
            print str(info.bytes) + " bytes, " + str(info.instructions) + " instructions, "
                + str(info.constants) + " constants, " + str(info.functions) + " functions";
        } else {
            print "pbrun: " + info.error;
        }
    }
} else {
    let r = loader.cli_run(args);
    // Echo the program's captured output stream.
    let i = 0;
    while i < len(r.output) { print r.output[i]; i = i + 1; }
    if not r.ok { print "pbrun: " + r.error; }
}
