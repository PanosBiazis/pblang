// Independent syntax gate for the XKB keymaps generated by the native Wayland
// backend. xkbcomp is a verifier only; runtime actuation does not invoke it.

let OS = import("stdlib:os.sapp");
let W = import("stdlib:wayland_unicode_input.sapp");

let args = OS.script_args();
if len(args) > 1 { throw "verify_wayland_keymap: expected optional text"; }
let text = if len(args) == 1 { args[0] } else { "PBLang: Ελληνικά, 中文, 😀" };
let plan = W.text_plan(text); if not plan.ok { throw plan.error; }
let tool = "/usr/bin/xkbcomp";
if not fs_exists(tool) { throw "verify_wayland_keymap: /usr/bin/xkbcomp is unavailable"; }
let root = "/tmp/pblang-wayland-keymap-"
    + str_slice(sha256(base64_encode_bytes(random_bytes(24))), 0, 24);
let verified = 0; let i = 0;
while i < len(plan.batches) {
    let source = root + "-" + str(i) + ".xkb";
    let output = root + "-" + str(i) + ".compiled.xkb";
    fs_write(source, plan.batches[i].keymap);
    let result = try proc_spawn_wait(tool, ["-xkb", source, output]) catch nil;
    let exit_code = -1;
    if result != nil { exit_code = try result.exit_code catch -1; }
    let output_ok = try fs_exists(output) catch false;
    let diagnostic = "cannot execute xkbcomp";
    if result != nil {
        diagnostic = str(try result.stderr catch "")
            + str(try result.stdout catch "");
    }
    try fs_remove(source) catch nil; try fs_remove(output) catch nil;
    if exit_code != 0 {
        throw "verify_wayland_keymap: xkbcomp rejected batch " + str(i)
            + ": " + str_trim(diagnostic);
    }
    if output_ok {
        verified = verified + 1;
    } else {
        throw "verify_wayland_keymap: xkbcomp emitted no compiled batch " + str(i);
    }
    i = i + 1;
}
print json_stringify(map{ ok: true, format: "pblang.wayland.keymap-verification.v1",
    source_language: "pblang", verifier: tool, scalar_count: plan.scalar_count,
    verified_batches: verified, runtime_external_tool_required: false });
