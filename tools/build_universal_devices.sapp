let Sub32 = import("stdlib:native/codegen_sub32.sapp");
let COMP = import("stdlib:compression/deflate_gzip_zstd_lz4_archive.sapp");
let Mobile = import("stdlib:native/mobile_native_ios_android.sapp");
let PKG = import("stdlib:devtools/pkg_init_bench_sbom.sapp");

let FIXED_MTIME = 1762905600;
let FIXED_DOS_MOD = 1567358976; // 2026-11-12 00:00:00 -> (((2026-1980)<<9)|(11<<5)|12) << 16

fn _mcu_baremetal_entry_c_source() {
    return "#define PBMICRO_FREESTANDING 1\n"
        + "#if defined(__riscv)\n"
        + "#define PBMICRO_PUTC_MMIO 0x10000000u\n"
        + "#else\n"
        + "#define PBMICRO_PUTC_MMIO 0x40004404u\n"
        + "#endif\n"
        + "#include \"pblang_micro_vm.c\"\n\n"
        + "int pblang_mcu_entry(void) {\n"
        + "    pbm_puts_c(PBMICRO_VERSION_STR \"\\r\\n\");\n"
        + "    return pbmicro_load_and_run(&g_micro_vm, g_pbmicro_selftest_pbck, (uint32_t)sizeof(g_pbmicro_selftest_pbck)) ? 0 : 1;\n"
        + "}\n\n"
        + "void _start(void) {\n"
        + "    (void)pblang_mcu_entry();\n"
        + "    for (;;) {}\n"
        + "}\n\n"
        + "#if defined(__arm__) || defined(__thumb__)\n"
        + "extern unsigned int __stack_top __attribute__((weak));\n"
        + "void Reset_Handler(void) { _start(); }\n"
        + "__attribute__((section(\".isr_vector\"), used))\n"
        + "const void *const g_pblang_isr_vector[2] = {\n"
        + "    (const void *)0x20004000u,\n"
        + "    (const void *)Reset_Handler\n"
        + "};\n"
        + "#endif\n";
}

// ── Byte & File Helpers ──────────────────────────────────────────────────────

fn _to_bytes_buf(src) {
    if src == nil { return bytes_new(0); }
    let t = type(src);
    if t == "bytes" { return src; }
    if t == "string" {
        let arr = str_to_bytes(src);
        let n = len(arr);
        let b = bytes_new(n);
        let i = 0;
        while i < n {
            bytes_set(b, i, arr[i]);
            i = i + 1;
        }
        return b;
    }
    if is_array(src) {
        let n = len(src);
        let b = bytes_new(n);
        let i = 0;
        while i < n {
            bytes_set(b, i, bit_and(num_floor(src[i]), 255));
            i = i + 1;
        }
        return b;
    }
    throw "build_universal_devices: unsupported byte source type " + t;
}

fn _read_file_bytes_buf(path: string) {
    return _to_bytes_buf(fs_read_bytes(path));
}

fn _is_regular_file(path: string) {
    if (try fs_exists(path) catch false) != true { return false; }
    let probe = try fs_listdir(path) catch nil;
    if is_array(probe) { return false; }
    return true;
}

fn _is_dir(path: string) {
    if (try fs_exists(path) catch false) != true { return false; }
    let probe = try fs_listdir(path) catch nil;
    return is_array(probe);
}

fn _chmod_exec(path: string) {
    if env_get("OS") == "Windows_NT" { return; }
    if fs_exists("/bin/chmod") {
        proc_spawn_wait("/bin/chmod", ["755", path]);
    } elif fs_exists("/usr/bin/chmod") {
        proc_spawn_wait("/usr/bin/chmod", ["755", path]);
    } else {
        try proc_spawn_wait("chmod", ["755", path]) catch nil;
    }
}

fn _copy_file_binary(src: string, dst: string, exec_bit: bool) {
    let raw = fs_read_bytes(src);
    fs_write_bytes(dst, raw);
    if exec_bit {
        _chmod_exec(dst);
    }
}

fn _sort_strings(items) {
    let out = [];
    let i = 0;
    while i < len(items) {
        array_push(out, items[i]);
        i = i + 1;
    }
    let j = 1;
    while j < len(out) {
        let cur = out[j];
        let k = j - 1;
        while k >= 0 and out[k] > cur {
            out[k + 1] = out[k];
            k = k - 1;
        }
        out[k + 1] = cur;
        j = j + 1;
    }
    return out;
}

// ── Manifest Version Reader (Dynamic SemVer from pblang.toml) ────────────────

fn _strip_toml_comment(line: string) {
    let out = "";
    let in_str = false;
    let esc = false;
    let i = 0;
    let n = len(line);
    while i < n {
        let c = strcharcodeat(line, i);
        if c == 35 and not in_str {
            return out;
        }
        if c == 34 and not esc {
            in_str = not in_str;
        }
        out = out + str_slice(line, i, i + 1);
        if in_str and c == 92 and not esc {
            esc = true;
        } else {
            esc = false;
        }
        i = i + 1;
    }
    return out;
}

fn read_manifest_version(repo_root: string) {
    let toml_path = repo_root + "/pblang.toml";
    if not _is_regular_file(toml_path) {
        throw "Missing pblang.toml at " + toml_path;
    }
    let lines = str_split(str_replace_all(fs_read(toml_path), "\r\n", "\n"), "\n");
    let section = "";
    let i = 0;
    while i < len(lines) {
        let s = str_trim(_strip_toml_comment(lines[i]));
        if s != "" {
            if str_starts_with(s, "[") and str_ends_with(s, "]") {
                section = str_trim(str_slice(s, 1, len(s) - 1));
            } elif section == "package" {
                let eq = str_index_of(s, "=");
                if eq > 0 {
                    let k = str_trim(str_slice(s, 0, eq));
                    let v = str_trim(str_slice(s, eq + 1, len(s)));
                    if k == "version" and len(v) >= 2 and str_starts_with(v, "\"") and str_ends_with(v, "\"") {
                        return str_slice(v, 1, len(v) - 1);
                    }
                }
            }
        }
        i = i + 1;
    }
    throw "Unable to read [package].version from " + toml_path;
}

// ── Pure-PBLang Apple Universal2 Fat Mach-O Builder ──────────────────────────

fn _read_u32_le_buf(b, off: int) {
    return b[off] + b[off + 1] * 256 + b[off + 2] * 65536 + b[off + 3] * 16777216;
}

fn _write_u32_be_buf(b, off: int, val) {
    let u = val;
    if u < 0 { u = u + 4294967296; }
    bytes_set(b, off, bit_and(num_floor(u / 16777216), 255));
    bytes_set(b, off + 1, bit_and(num_floor(u / 65536), 255));
    bytes_set(b, off + 2, bit_and(num_floor(u / 256), 255));
    bytes_set(b, off + 3, bit_and(num_floor(u), 255));
}

fn build_apple_fat_macho(x64_path: string, arm64_path: string, out_path: string) {
    let b_x64 = _read_file_bytes_buf(x64_path);
    let b_arm = _read_file_bytes_buf(arm64_path);
    if len(b_x64) < 32 or len(b_arm) < 32 {
        throw "Mach-O slices are smaller than 32-byte mach_header_64";
    }
    // 0xFEEDFACF == 4277009103 (little-endian: CF FA ED FE)
    let m_x64 = _read_u32_le_buf(b_x64, 0);
    let m_arm = _read_u32_le_buf(b_arm, 0);
    if m_x64 != 4277009103 or m_arm != 4277009103 {
        throw "Expected 64-bit Mach-O slices (0xFEEDFACF)";
    }

    let align_bits = 14;
    let page = 16384; // 1 << 14 (16 KiB Apple Silicon page alignment)
    let off_x64 = page;
    let off_arm = num_floor((off_x64 + len(b_x64) + page - 1) / page) * page;
    let total_sz = off_arm + len(b_arm);

    let out = bytes_new(total_sz);
    // fat_header: magic = 0xCAFEBABE (3405691582), nfat_arch = 2
    _write_u32_be_buf(out, 0, 3405691582);
    _write_u32_be_buf(out, 4, 2);

    // fat_arch[0]: x86_64 (CPU_TYPE_X86_64 = 0x01000007 = 16777223, CPU_SUBTYPE_X86_64_ALL = 3)
    _write_u32_be_buf(out, 8, 16777223);
    _write_u32_be_buf(out, 12, 3);
    _write_u32_be_buf(out, 16, off_x64);
    _write_u32_be_buf(out, 20, len(b_x64));
    _write_u32_be_buf(out, 24, align_bits);

    // fat_arch[1]: arm64 (CPU_TYPE_ARM64 = 0x0100000C = 16777228, CPU_SUBTYPE_ARM64_ALL = 0)
    _write_u32_be_buf(out, 28, 16777228);
    _write_u32_be_buf(out, 32, 0);
    _write_u32_be_buf(out, 36, off_arm);
    _write_u32_be_buf(out, 40, len(b_arm));
    _write_u32_be_buf(out, 44, align_bits);

    if len(b_x64) > 0 {
        ffi_ptr_write(ffi_bytes_ptr(out) + off_x64, b_x64, len(b_x64));
    }
    if len(b_arm) > 0 {
        ffi_ptr_write(ffi_bytes_ptr(out) + off_arm, b_arm, len(b_arm));
    }

    fs_write_bytes(out_path, out);
    _chmod_exec(out_path);
    return map{ ok: true, size: total_sz, off_x64: off_x64, off_arm: off_arm };
}

// ── Pure-PBLang Android Installer & WASI Universal Launcher Generators ───────

fn _render_android_installer_sapp(ver: string) {
    return "// install_android.sapp — Pure-PBLang Android / Termux Runtime Installer (v" + ver + ")\n"
        + "// Run with: ./bin/pblang-android-arm64 run install_android.sapp --allow-all\n\n"
        + "let uname_res = try proc_spawn_wait(\"uname\", [\"-m\"]) catch map{ exit_code: 1, stdout: \"\" };\n"
        + "let arch = str_trim(str(uname_res.stdout));\n"
        + "let pfx = env_get(\"PREFIX\");\n"
        + "if pfx == nil or pfx == \"\" {\n"
        + "    let hm = env_get(\"HOME\");\n"
        + "    if hm == nil or hm == \"\" { hm = \".\"; }\n"
        + "    pfx = hm + \"/.local\";\n"
        + "}\n"
        + "let dst_dir = pfx + \"/bin\";\n"
        + "fs_mkdirs(dst_dir);\n"
        + "let src_bin = if arch == \"aarch64\" or arch == \"arm64\" { \"bin/pblang-android-arm64\" } else { \"bin/pblang-android-x86_64\" };\n"
        + "let dst_bin = dst_dir + \"/pblang\";\n"
        + "fs_write_bytes(dst_bin, fs_read_bytes(src_bin));\n"
        + "try proc_spawn_wait(\"chmod\", [\"755\", dst_bin]) catch nil;\n"
        + "println(\"Installed PBLang \" + \"" + ver + "\" + \" (\" + arch + \") to \" + dst_bin);\n";
}

fn _render_wasi_runner_sapp(ver: string) {
    return "// run_wasi.sapp — Pure-PBLang Universal WASI Launcher for pblang.wasm (v" + ver + ")\n"
        + "// Dispatches pblang.wasm via host WASI runtime (wasmtime / wasmer / wazero) or stdlib:wasm_module.sapp.\n\n"
        + "let WasmMod = import(\"stdlib:wasm_module.sapp\");\n\n"
        + "fn _find_wasi_engine() {\n"
        + "    let env_e = env_get(\"PBLANG_WASI_RUNTIME\");\n"
        + "    if env_e != nil and env_e != \"\" { return env_e; }\n"
        + "    let candidates = [\"wasmtime\", \"wasmer\", \"wazero\"];\n"
        + "    let i = 0;\n"
        + "    while i < len(candidates) {\n"
        + "        let c = candidates[i];\n"
        + "        let r = try proc_spawn_wait(c, [\"--version\"]) catch map{ exit_code: 127 };\n"
        + "        if r.exit_code == 0 { return c; }\n"
        + "        i = i + 1;\n"
        + "    }\n"
        + "    return \"\";\n"
        + "}\n\n"
        + "let wasm_path = if fs_exists(\"bin/pblang.wasm\") { \"bin/pblang.wasm\" } else { \"pblang.wasm\" };\n"
        + "let cli = try os_args() catch [];\n"
        + "let engine = _find_wasi_engine();\n"
        + "if engine != \"\" {\n"
        + "    let run_args = [\"run\", \"--dir=.\"];\n"
        + "    if engine == \"wazero\" { run_args = [\"run\", \"-mount=.:/\"]; }\n"
        + "    array_push(run_args, wasm_path);\n"
        + "    let k = 0;\n"
        + "    while k < len(cli) {\n"
        + "        if cli[k] != \"--\" { array_push(run_args, str(cli[k])); }\n"
        + "        k = k + 1;\n"
        + "    }\n"
        + "    let res = proc_spawn_wait(engine, run_args);\n"
        + "    if res.stdout != \"\" { print(res.stdout); }\n"
        + "    if res.stderr != \"\" { eprint(res.stderr); }\n"
        + "    os_exit(res.exit_code);\n"
        + "} else {\n"
        + "    let raw = fs_read_bytes(wasm_path);\n"
        + "    let info = WasmMod.inspect(raw);\n"
        + "    println(\"Verified WASI module \" + wasm_path + \" (\" + str(len(raw)) + \" bytes, PBLang v" + ver + ")\");\n"
        + "    let _ = info;\n"
        + "}\n";
}

// ── Pure-PBLang Deterministic USTAR .tar.gz & PKWARE .zip Packager ───────────

let _ZLIB_CACHE = map{ probed: false, handle: 0 };

fn _get_zlib() {
    if _ZLIB_CACHE.probed { return _ZLIB_CACHE.handle; }
    _ZLIB_CACHE.probed = true;
    let h = try ffi_load("libz.so.1") catch 0;
    if type(h) != "number" or h == 0 {
        h = try ffi_load("libz.dylib") catch 0;
    }
    if type(h) == "number" and h != 0 {
        _ZLIB_CACHE.handle = h;
    }
    return _ZLIB_CACHE.handle;
}

fn _fast_crc32(raw_b) {
    let n = len(raw_b);
    if n == 0 { return 0; }
    let zh = _get_zlib();
    if zh != 0 {
        return ffi_call_typed(zh, "crc32", "u64, ptr, u32 -> u64", [0, raw_b, n]);
    }
    return COMP.crc32_compute(raw_b);
}

fn _fast_deflate(raw_b, level: int) {
    let n = len(raw_b);
    if n == 0 or level <= 0 { return COMP.deflate_compress(raw_b, level); }
    let zh = _get_zlib();
    if zh != 0 {
        let bound = n + num_floor(n / 64) + 128;
        let dst = bytes_new(bound);
        let dlen_buf = ffi_struct_pack("<Q", [bound]);
        let rc = ffi_call_typed(zh, "compress2", "ptr, ptr, ptr, u64, i32 -> i32", [dst, dlen_buf, raw_b, n, 6]);
        if rc == 0 {
            let out_len = ffi_struct_unpack("<Q", dlen_buf, 0)[0];
            if out_len >= 6 {
                return bytes_slice(dst, 2, out_len - 4);
            }
        }
    }
    return COMP.deflate_compress(raw_b, level);
}

fn _fast_gzip(raw_b, level: int) {
    let zh = _get_zlib();
    if zh != 0 and level > 0 {
        let n = len(raw_b);
        let crc = _fast_crc32(raw_b);
        let def_b = _fast_deflate(raw_b, 6);
        let dlen = len(def_b);
        let out = bytes_new(10 + dlen + 8);
        // RFC 1952 header: 1f 8b 08 00 [FIXED_MTIME LE] 00 03
        bytes_set(out, 0, 31);
        bytes_set(out, 1, 139);
        bytes_set(out, 2, 8);
        bytes_set(out, 3, 0);
        bytes_set(out, 4, bit_and(FIXED_MTIME, 255));
        bytes_set(out, 5, bit_and(num_floor(FIXED_MTIME / 256), 255));
        bytes_set(out, 6, bit_and(num_floor(FIXED_MTIME / 65536), 255));
        bytes_set(out, 7, bit_and(num_floor(FIXED_MTIME / 16777216), 255));
        bytes_set(out, 8, 0);
        bytes_set(out, 9, 3);
        if dlen > 0 {
            ffi_ptr_write(ffi_bytes_ptr(out) + 10, def_b, dlen);
        }
        let trl = ffi_struct_pack("<II", [bit_and(crc, 4294967295), bit_and(n, 4294967295)]);
        ffi_ptr_write(ffi_bytes_ptr(out) + 10 + dlen, trl, 8);
        return out;
    }
    let gz_bytes = COMP.gzip_compress(raw_b, level);
    bytes_set(gz_bytes, 4, bit_and(FIXED_MTIME, 255));
    bytes_set(gz_bytes, 5, bit_and(num_floor(FIXED_MTIME / 256), 255));
    bytes_set(gz_bytes, 6, bit_and(num_floor(FIXED_MTIME / 65536), 255));
    bytes_set(gz_bytes, 7, bit_and(num_floor(FIXED_MTIME / 16777216), 255));
    return gz_bytes;
}

fn _bw_new(init_cap: int) {
    let cap = if init_cap < 256 { 256 } else { init_cap };
    return map{ buf: bytes_new(cap), size: 0, cap: cap };
}

fn _bw_ensure(bw, add_len: int) {
    let needed = bw.size + add_len;
    if needed <= bw.cap { return; }
    let ncap = bw.cap * 2;
    while ncap < needed { ncap = ncap * 2; }
    let nb = bytes_new(ncap);
    let old = bw.buf;
    let sz = bw.size;
    if sz > 0 {
        ffi_ptr_write(ffi_bytes_ptr(nb), old, sz);
    }
    bw.buf = nb;
    bw.cap = ncap;
}

fn _bw_push_u16_le(bw, v: int) {
    _bw_ensure(bw, 2);
    let o = bw.size;
    bytes_set(bw.buf, o, bit_and(v, 255));
    bytes_set(bw.buf, o + 1, bit_and(bit_shr(v, 8), 255));
    bw.size = o + 2;
}

fn _bw_push_u32_le(bw, v) {
    _bw_ensure(bw, 4);
    let u = v;
    if u < 0 { u = u + 4294967296; }
    let o = bw.size;
    bytes_set(bw.buf, o, bit_and(num_floor(u), 255));
    bytes_set(bw.buf, o + 1, bit_and(num_floor(u / 256), 255));
    bytes_set(bw.buf, o + 2, bit_and(num_floor(u / 65536), 255));
    bytes_set(bw.buf, o + 3, bit_and(num_floor(u / 16777216), 255));
    bw.size = o + 4;
}

fn _bw_push_bytes(bw, src_b) {
    let n = len(src_b);
    if n == 0 { return; }
    _bw_ensure(bw, n);
    ffi_ptr_write(ffi_bytes_ptr(bw.buf) + bw.size, src_b, n);
    bw.size = bw.size + n;
}

fn _bw_push_zeros(bw, count: int) {
    if count <= 0 { return; }
    _bw_ensure(bw, count);
    let z = bytes_new(count);
    ffi_ptr_write(ffi_bytes_ptr(bw.buf) + bw.size, z, count);
    bw.size = bw.size + count;
}

fn _bw_finish(bw) {
    if bw.size == bw.cap { return bw.buf; }
    return bytes_slice(bw.buf, 0, bw.size);
}

fn _tar_write_str(hdr, off: int, max_w: int, s: string) {
    let sb = str_to_bytes(s);
    let lim = if len(sb) > max_w { max_w } else { len(sb) };
    let i = 0;
    while i < lim {
        bytes_set(hdr, off + i, sb[i]);
        i = i + 1;
    }
}

fn _tar_write_octal(hdr, off: int, width: int, val) {
    let digits = width - 1;
    let v = num_floor(val);
    let i = digits - 1;
    while i >= 0 {
        bytes_set(hdr, off + i, 48 + (v % 8));
        v = num_floor(v / 8);
        i = i - 1;
    }
    bytes_set(hdr, off + digits, 0);
}

fn _tar_checksum(hdr) {
    let sum = 0;
    let i = 0;
    while i < 512 {
        if i >= 148 and i < 156 {
            sum = sum + 32;
        } else {
            sum = sum + hdr[i];
        }
        i = i + 1;
    }
    return sum;
}

fn _tar_append_entry(bw, arc_path: string, raw_b, exec_bit: bool) {
    let clean_path = str_replace_all(arc_path, "\\", "/");
    let prefix_str = "";
    let base_str = clean_path;
    if len(str_to_bytes(clean_path)) > 100 {
        let split_at = -1;
        let k = 0;
        while k < len(clean_path) {
            if strcharcodeat(clean_path, k) == 47 and k <= 155 and (len(clean_path) - k - 1) <= 100 {
                split_at = k;
                break;
            }
            k = k + 1;
        }
        if split_at < 0 {
            throw "TAR USTAR path exceeds 100+155 limit: " + clean_path;
        }
        prefix_str = str_slice(clean_path, 0, split_at);
        base_str = str_slice(clean_path, split_at + 1, len(clean_path));
    }

    let sz = len(raw_b);
    let mode_oct = if exec_bit { 493 } else { 420 }; // 0755 vs 0644
    let hdr = bytes_new(512);
    _tar_write_str(hdr, 0, 100, base_str);
    _tar_write_octal(hdr, 100, 8, mode_oct);
    _tar_write_octal(hdr, 108, 8, 0);
    _tar_write_octal(hdr, 116, 8, 0);
    _tar_write_octal(hdr, 124, 12, sz);
    _tar_write_octal(hdr, 136, 12, FIXED_MTIME);
    bytes_set(hdr, 156, 48); // '0' regular file
    _tar_write_str(hdr, 257, 6, "ustar");
    bytes_set(hdr, 263, 48);
    bytes_set(hdr, 264, 48);
    _tar_write_str(hdr, 265, 32, "root");
    _tar_write_str(hdr, 297, 32, "root");
    if prefix_str != "" {
        _tar_write_str(hdr, 345, 155, prefix_str);
    }
    let csum = _tar_checksum(hdr);
    _tar_write_octal(hdr, 148, 7, csum);
    bytes_set(hdr, 155, 32);

    _bw_push_bytes(bw, hdr);
    _bw_push_bytes(bw, raw_b);
    let rem = sz % 512;
    if rem != 0 {
        _bw_push_zeros(bw, 512 - rem);
    }
}

fn _collect_tree_entries(src_dir: string, rel_prefix: string, out_list, zip_level: int) {
    if not _is_dir(src_dir) { return; }
    let names = _sort_strings(fs_listdir(src_dir));
    let dirs = [];
    let files = [];
    let i = 0;
    while i < len(names) {
        let nm = names[i];
        if not str_starts_with(nm, ".") and not str_ends_with(nm, ".bak") {
            let full = src_dir + "/" + nm;
            if _is_dir(full) {
                array_push(dirs, nm);
            } elif _is_regular_file(full) {
                array_push(files, nm);
            }
        }
        i = i + 1;
    }

    let fi = 0;
    while fi < len(files) {
        let fnm = files[fi];
        let sp = src_dir + "/" + fnm;
        let rel = rel_prefix + "/" + fnm;
        let raw_b = _read_file_bytes_buf(sp);
        let is_exec = str_ends_with(fnm, ".exe") or str_ends_with(fnm, ".com");
        let crc = _fast_crc32(raw_b);
        let z_method = 0;
        let z_payload = raw_b;
        if zip_level > 0 and len(raw_b) > 0 {
            let def_b = _fast_deflate(raw_b, zip_level);
            if len(def_b) < len(raw_b) {
                z_method = 8;
                z_payload = def_b;
            }
        }
        array_push(out_list, map{
            rel: rel,
            raw: raw_b,
            exec: is_exec,
            crc: crc,
            z_method: z_method,
            z_payload: z_payload
        });
        fi = fi + 1;
    }

    let di = 0;
    while di < len(dirs) {
        let dnm = dirs[di];
        _collect_tree_entries(src_dir + "/" + dnm, rel_prefix + "/" + dnm, out_list, zip_level);
        di = di + 1;
    }
}

fn _load_cached_runtime_tree(repo_root: string, zip_level: int) {
    let entries = [];
    _collect_tree_entries(repo_root + "/stdlib", "stdlib", entries, zip_level);
    _collect_tree_entries(repo_root + "/tools", "tools", entries, zip_level);
    let docs = ["README.md", "CHANGELOG.md", "pblang.toml", "pblang.lock"];
    let i = 0;
    while i < len(docs) {
        let d = docs[i];
        let dp = repo_root + "/" + d;
        if _is_regular_file(dp) {
            let raw_b = _read_file_bytes_buf(dp);
            let crc = _fast_crc32(raw_b);
            let z_method = 0;
            let z_payload = raw_b;
            if zip_level > 0 and len(raw_b) > 0 {
                let def_b = _fast_deflate(raw_b, zip_level);
                if len(def_b) < len(raw_b) {
                    z_method = 8;
                    z_payload = def_b;
                }
            }
            array_push(entries, map{
                rel: d,
                raw: raw_b,
                exec: false,
                crc: crc,
                z_method: z_method,
                z_payload: z_payload
            });
        }
        i = i + 1;
    }
    return entries;
}

fn make_tar_gz_pure(out_tar_gz: string, top_dir: string, items: any, runtime_tree: any, gz_level: int) {
    let est = 4096;
    let i = 0;
    while i < len(items) {
        est = est + 1024;
        i = i + 1;
    }
    if runtime_tree != nil {
        let k = 0;
        while k < len(runtime_tree) {
            est = est + 512 + len(runtime_tree[k].raw) + 512;
            k = k + 1;
        }
    }
    let bw = _bw_new(est);
    i = 0;
    while i < len(items) {
        let it = items[i];
        let raw_b = _read_file_bytes_buf(it.src);
        let is_exec = if map_has(it, "exec") and it.exec == true { true } else { false };
        _tar_append_entry(bw, top_dir + "/" + it.dst, raw_b, is_exec);
        i = i + 1;
    }
    if runtime_tree != nil {
        let j = 0;
        while j < len(runtime_tree) {
            let rt = runtime_tree[j];
            _tar_append_entry(bw, top_dir + "/" + rt.rel, rt.raw, rt.exec);
            j = j + 1;
        }
    }
    _bw_push_zeros(bw, 1024);
    let tar_bytes = _bw_finish(bw);
    let gz_bytes = _fast_gzip(tar_bytes, gz_level);
    fs_write_bytes(out_tar_gz, gz_bytes);
    return len(gz_bytes);
}

fn _zip_append_prepared(out_bw, cd_bw, arc_path: string, raw_sz: int, crc, method: int, payload_b, exec_bit: bool) {
    let clean_name = str_replace_all(arc_path, "\\", "/");
    let name_b = _to_bytes_buf(clean_name);
    let comp_sz = len(payload_b);
    let local_off = out_bw.size;
    let ext_attr = if exec_bit { 2179792896 } else { 2175008768 }; // (0100755 << 16) vs (0100644 << 16)

    // Local File Header PK\x03\x04 (67324752)
    _bw_push_u32_le(out_bw, 67324752);
    _bw_push_u16_le(out_bw, 20);
    _bw_push_u16_le(out_bw, 2048);
    _bw_push_u16_le(out_bw, method);
    _bw_push_u32_le(out_bw, FIXED_DOS_MOD);
    _bw_push_u32_le(out_bw, crc);
    _bw_push_u32_le(out_bw, comp_sz);
    _bw_push_u32_le(out_bw, raw_sz);
    _bw_push_u16_le(out_bw, len(name_b));
    _bw_push_u16_le(out_bw, 0);
    _bw_push_bytes(out_bw, name_b);
    _bw_push_bytes(out_bw, payload_b);

    // Central Directory Header PK\x01\x02 (33639248)
    _bw_push_u32_le(cd_bw, 33639248);
    _bw_push_u16_le(cd_bw, 788); // Unix 2.0
    _bw_push_u16_le(cd_bw, 20);
    _bw_push_u16_le(cd_bw, 2048);
    _bw_push_u16_le(cd_bw, method);
    _bw_push_u32_le(cd_bw, FIXED_DOS_MOD);
    _bw_push_u32_le(cd_bw, crc);
    _bw_push_u32_le(cd_bw, comp_sz);
    _bw_push_u32_le(cd_bw, raw_sz);
    _bw_push_u16_le(cd_bw, len(name_b));
    _bw_push_u16_le(cd_bw, 0);
    _bw_push_u16_le(cd_bw, 0);
    _bw_push_u16_le(cd_bw, 0);
    _bw_push_u16_le(cd_bw, 0);
    _bw_push_u32_le(cd_bw, ext_attr);
    _bw_push_u32_le(cd_bw, local_off);
    _bw_push_bytes(cd_bw, name_b);
}

fn make_zip_pure(out_zip: string, top_dir: string, items: any, runtime_tree: any, zip_level: int) {
    let out_bw = _bw_new(65536);
    let cd_bw = _bw_new(16384);
    let count = 0;

    let i = 0;
    while i < len(items) {
        let it = items[i];
        let raw_b = _read_file_bytes_buf(it.src);
        let raw_sz = len(raw_b);
        let crc = _fast_crc32(raw_b);
        let method = 0;
        let payload = raw_b;
        if zip_level > 0 and raw_sz > 0 {
            let def_b = _fast_deflate(raw_b, zip_level);
            if len(def_b) < raw_sz {
                method = 8;
                payload = def_b;
            }
        }
        let is_exec = if map_has(it, "exec") and it.exec == true { true } else { false };
        _zip_append_prepared(out_bw, cd_bw, top_dir + "/" + it.dst, raw_sz, crc, method, payload, is_exec);
        count = count + 1;
        i = i + 1;
    }

    if runtime_tree != nil {
        let j = 0;
        while j < len(runtime_tree) {
            let rt = runtime_tree[j];
            _zip_append_prepared(out_bw, cd_bw, top_dir + "/" + rt.rel, len(rt.raw), rt.crc, rt.z_method, rt.z_payload, rt.exec);
            count = count + 1;
            j = j + 1;
        }
    }

    let cd_bytes = _bw_finish(cd_bw);
    let cd_off = out_bw.size;
    let cd_sz = len(cd_bytes);
    _bw_push_bytes(out_bw, cd_bytes);

    // End of Central Directory PK\x05\x06 (101010256)
    _bw_push_u32_le(out_bw, 101010256);
    _bw_push_u16_le(out_bw, 0);
    _bw_push_u16_le(out_bw, 0);
    _bw_push_u16_le(out_bw, count);
    _bw_push_u16_le(out_bw, count);
    _bw_push_u32_le(out_bw, cd_sz);
    _bw_push_u32_le(out_bw, cd_off);
    _bw_push_u16_le(out_bw, 0);

    let zip_bytes = _bw_finish(out_bw);
    fs_write_bytes(out_zip, zip_bytes);
    return len(zip_bytes);
}

// ── Pure-PBLang Binary Zero-OPSEC Privacy Scanner & SHA256SUMS Writer ────────

fn _file_sha256_and_size(path: string) {
    let raw = fs_read_bytes(path);
    let s = bytes_to_str(raw);
    return map{ sha256: sha256(s), bytes: len(s), raw_str: s };
}

fn _basename(p: string) {
    let i = len(p) - 1;
    while i >= 0 {
        let c = strcharcodeat(p, i);
        if c == 47 or c == 92 {
            return str_slice(p, i + 1, len(p));
        }
        i = i - 1;
    }
    return p;
}

fn privacy_scan_files(paths: any, forbidden_tokens: any) {
    let i = 0;
    while i < len(paths) {
        let p = paths[i];
        if _is_regular_file(p) {
            let blob_str = bytes_to_str(fs_read_bytes(p));
            let j = 0;
            while j < len(forbidden_tokens) {
                let tok = forbidden_tokens[j];
                if tok != nil and tok != "" and str_contains(blob_str, tok) {
                    throw "Privacy scan blocked forbidden host token in " + _basename(p);
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return true;
}

fn write_sha256sums(out_dir: string, forbidden_tokens: any) {
    let raw_names = fs_listdir(out_dir);
    let files = [];
    let i = 0;
    while i < len(raw_names) {
        let fnm = raw_names[i];
        if fnm != "SHA256SUMS.txt" and not str_starts_with(fnm, ".") {
            let fp = out_dir + "/" + fnm;
            if _is_regular_file(fp) {
                array_push(files, fnm);
            }
        }
        i = i + 1;
    }
    let sorted = _sort_strings(files);
    let full_paths = [];
    i = 0;
    while i < len(sorted) {
        array_push(full_paths, out_dir + "/" + sorted[i]);
        i = i + 1;
    }
    privacy_scan_files(full_paths, forbidden_tokens);

    let lines = [];
    let manifest = [];
    i = 0;
    while i < len(sorted) {
        let fnm = sorted[i];
        let fp = out_dir + "/" + fnm;
        let info = _file_sha256_and_size(fp);
        array_push(lines, info.sha256 + "  " + fnm);
        array_push(manifest, map{ file: fnm, sha256: info.sha256, bytes: info.bytes });
        i = i + 1;
    }
    fs_write(out_dir + "/SHA256SUMS.txt", str_join(lines, "\n") + "\n");
    return map{ ok: true, count: len(manifest), assets: manifest };
}

// ── Compiler & CLI Helpers ───────────────────────────────────────────────────

fn _run_cmd(bin: string, cmd_args: any, label: string) {
    let r = proc_spawn_wait(bin, cmd_args);
    if r.exit_code != 0 {
        throw "Command failed [" + label + "] (" + bin + "): " + str(r.stderr) + " " + str(r.stdout);
    }
    return r;
}

fn _find_zig() {
    let env_z = env_get("ZIG_BIN");
    if env_z != nil and env_z != "" and fs_exists(env_z) {
        return env_z;
    }
    let tmp_z = "/tmp/zig_toolchain/zig-linux-x86_64-0.13.0/zig";
    if fs_exists(tmp_z) {
        return tmp_z;
    }
    return "zig";
}

fn _parse_out_dir(ver: string) {
    let default_dir = "/tmp/pblang_v" + str_replace_all(ver, ".", "") + "_dist";
    let cli = try os_args() catch [];
    if is_array(cli) {
        let k = 0;
        while k < len(cli) {
            if cli[k] == "--out-dir" and k + 1 < len(cli) {
                return str(cli[k + 1]);
            }
            if str_starts_with(str(cli[k]), "--out-dir=") {
                return str_slice(str(cli[k]), 10, len(str(cli[k])));
            }
            k = k + 1;
        }
    }
    let raw = env_get("PBLANG_SCRIPT_ARGS");
    if raw == nil or raw == "" {
        return default_dir;
    }
    let parts = str_split(raw, "\n");
    let i = 0;
    while i < len(parts) {
        if parts[i] == "--out-dir" and i + 1 < len(parts) {
            return parts[i + 1];
        }
        i = i + 1;
    }
    return default_dir;
}

fn _compile_zr_zig(zig_bin: string, target: string, repo_root: string, out_bin: string, extra_flags: any) {
    let pmap = "-ffile-prefix-map=" + repo_root + "=.";
    let cargs = [
        "cc", "-target", target,
        "-Os", "-std=gnu99", pmap,
        "-Wno-unused-function",
        repo_root + "/runtime_stage3/pblang_zero_rust_vm.c"
    ];
    let i = 0;
    while i < len(extra_flags) {
        array_push(cargs, extra_flags[i]);
        i = i + 1;
    }
    array_push(cargs, "-o");
    array_push(cargs, out_bin);
    _run_cmd(zig_bin, cargs, "zig-cc:" + target);
}

fn _parse_uint(s: string, fallback: int) {
    if len(s) == 0 { return fallback; }
    let acc = 0;
    let i = 0;
    while i < len(s) {
        let c = strcharcodeat(s, i);
        if c < 48 or c > 57 { break; }
        acc = acc * 10 + (c - 48);
        i = i + 1;
    }
    if i == 0 { return fallback; }
    return acc;
}

fn _version_code_from_semver(ver: string) {
    let parts = str_split(ver, ".");
    let maj = if len(parts) > 0 { _parse_uint(parts[0], 5) } else { 5 };
    let min = if len(parts) > 1 { _parse_uint(parts[1], 1) } else { 1 };
    let pat = if len(parts) > 2 { _parse_uint(parts[2], 0) } else { 0 };
    return maj * 10000 + min * 100 + pat;
}

// ── Main Universal Matrix Build Entrypoint ───────────────────────────────────

fn build_all_universal_devices(out_dir: string) {
    let repo_root = cwd();
    let ver = read_manifest_version(repo_root);
    let ver_code = _version_code_from_semver(ver);
    let stage = out_dir + "/.staging";
    fs_mkdirs(stage);
    fs_mkdirs(out_dir);

    let zig_bin = _find_zig();
    let pmap = "-ffile-prefix-map=" + repo_root + "=.";
    let zr_src = repo_root + "/runtime_stage3/pblang_zero_rust_vm.c";
    let micro_src = repo_root + "/runtime_stage3/pblang_micro_vm.c";
    let dos_asm = repo_root + "/runtime_stage3/pblang_dos16_vm.asm";

    println("[1/8] Building Tier-1 Modern 64-bit Desktops, Workstations & Servers (v" + ver + ")...");
    // 1. Linux x86_64 (dynamic full + static musl)
    let bin_lx64 = stage + "/pblang-linux-x86_64";
    _run_cmd("gcc", ["-O3", "-std=gnu99", pmap, "-s", zr_src, "-ldl", "-lpthread", "-lm", "-o", bin_lx64], "gcc:linux-x86_64");
    let bin_lx64_static = stage + "/pblang-linux-x86_64-static";
    _compile_zr_zig(zig_bin, "x86_64-linux-musl", repo_root, bin_lx64_static, ["-s", "-lm"]);

    // 2. Linux ARM64 (Raspberry Pi 4/5, Graviton, Jetson, Asahi)
    let bin_larm64 = stage + "/pblang-linux-arm64";
    _compile_zr_zig(zig_bin, "aarch64-linux-musl", repo_root, bin_larm64, ["-s", "-lm"]);

    // 3. Windows x86_64 (PE32+) & Windows ARM64 (PE32+ Copilot+ / Snapdragon)
    let bin_wx64 = stage + "/pblang-windows-x86_64.exe";
    _run_cmd("x86_64-w64-mingw32-gcc", ["-O2", "-std=gnu99", "-Wl,--stack,16777216", pmap, "-s", zr_src, "-lws2_32", "-lwinhttp", "-lgdi32", "-luser32", "-lbcrypt", "-o", bin_wx64], "mingw64:windows-x86_64");
    let bin_warm64 = stage + "/pblang-windows-arm64.exe";
    _compile_zr_zig(zig_bin, "aarch64-windows-gnu", repo_root, bin_warm64, ["-s", "-lws2_32", "-lwinhttp", "-lgdi32", "-luser32", "-lbcrypt"]);

    // 4. macOS Apple Silicon (arm64) + Intel (x86_64) + Universal2 Fat Mach-O in 100% pure PBLang
    let bin_mac_arm64 = stage + "/pblang-macos-arm64";
    let bin_mac_x64 = stage + "/pblang-macos-x86_64";
    let bin_mac_univ = stage + "/pblang-macos-universal";
    _compile_zr_zig(zig_bin, "aarch64-macos", repo_root, bin_mac_arm64, ["-lc", "-lm"]);
    _compile_zr_zig(zig_bin, "x86_64-macos", repo_root, bin_mac_x64, ["-lc", "-lm"]);
    build_apple_fat_macho(bin_mac_x64, bin_mac_arm64, bin_mac_univ);

    // 5. Linux RISC-V 64, PowerPC64LE & MIPS64EL
    let bin_rv64 = stage + "/pblang-linux-riscv64";
    let bin_ppc64le = stage + "/pblang-linux-powerpc64le";
    let bin_mips64el = stage + "/pblang-linux-mips64el";
    _compile_zr_zig(zig_bin, "riscv64-linux-musl", repo_root, bin_rv64, ["-s", "-lm"]);
    _compile_zr_zig(zig_bin, "powerpc64le-linux-musl", repo_root, bin_ppc64le, ["-s", "-lm"]);
    _compile_zr_zig(zig_bin, "mips64el-linux-musl", repo_root, bin_mips64el, ["-s", "-lm"]);

    println("[2/8] Building Native Mobile Targets (Android Universal APK, Android CLI, iOS ARM64 Mach-O)...");
    let bin_and_arm64 = stage + "/pblang-android-arm64";
    let bin_and_x64 = stage + "/pblang-android-x86_64";
    _compile_zr_zig(zig_bin, "aarch64-linux-musl", repo_root, bin_and_arm64, ["-s", "-lm"]);
    _compile_zr_zig(zig_bin, "x86_64-linux-musl", repo_root, bin_and_x64, ["-s", "-lm"]);
    let android_installer_sapp = stage + "/install_android.sapp";
    fs_write(android_installer_sapp, _render_android_installer_sapp(ver));

    let apk_stage = stage + "/pblang-" + ver + "-android-universal.apk";
    let apk_res = Mobile.build_android_apk(map{
        package_name: "org.pblang.runtime",
        app_name: "PBLang",
        activity_name: "MainActivity",
        title: "PBLang v" + ver,
        payload: "Sovereign Pure-PBLang Android Runtime v" + ver,
        version_name: ver,
        version_code: ver_code,
        prevent_screenshots: true
    }, apk_stage);
    let apk_chk = Mobile.verify_android_apk(apk_res.apk_bytes);
    if not apk_chk.ok {
        throw "Android APK verification failed: " + str(apk_chk.error);
    }

    let ios_bundle_stage = stage + "/ios_bundle";
    fs_mkdirs(ios_bundle_stage);
    let ios_bundle = Mobile.build_ios_app_bundle(map{
        app_name: "PBLang",
        bundle_id: "org.pblang.runtime",
        title: "PBLang v" + ver,
        payload: "Sovereign Pure-PBLang iOS ARM64 Runtime v" + ver,
        version_name: ver,
        version_code: ver_code,
        prevent_screenshots: true
    }, ios_bundle_stage);
    let ios_chk = Mobile.verify_ios_arm64_macho(ios_bundle.macho_bytes);
    if not ios_chk.ok {
        throw "iOS ARM64 Mach-O verification failed: " + str(ios_chk.error);
    }
    let bin_ios_arm64 = stage + "/pblang-ios-arm64";
    fs_write_bytes(bin_ios_arm64, ios_bundle.macho_bytes);
    _chmod_exec(bin_ios_arm64);

    println("[3/8] Building Tier-2 Portable WebAssembly (wasm32-wasi) + Pure-PBLang WASI Launcher...");
    let bin_wasm = stage + "/pblang.wasm";
    _compile_zr_zig(zig_bin, "wasm32-wasi", repo_root, bin_wasm, ["-D_WASI_EMULATED_PROCESS_CLOCKS", "-D_WASI_EMULATED_SIGNAL", "-D_WASI_EMULATED_MMAN", "-Dchmod(p,m)=0", "-lwasi-emulated-process-clocks", "-lwasi-emulated-signal", "-lwasi-emulated-mman", "-s", "-lc", "-lm"]);
    let wasi_runner_sapp = stage + "/run_wasi.sapp";
    fs_write(wasi_runner_sapp, _render_wasi_runner_sapp(ver));

    println("[4/8] Building Tier-3 <= 32-bit Desktops, Netbooks, SBCs & OpenWrt Routers...");
    let bin_wx86 = stage + "/pblang-windows-x86.exe";
    _run_cmd("i686-w64-mingw32-gcc", ["-Os", "-std=gnu99", pmap, "-s", zr_src, "-lws2_32", "-lwinhttp", "-lgdi32", "-luser32", "-lbcrypt", "-o", bin_wx86], "mingw32:windows-x86");

    let bin_lx86 = stage + "/pblang-linux-x86";
    _compile_zr_zig(zig_bin, "x86-linux-musl", repo_root, bin_lx86, ["-s", "-lm"]);

    let bin_larmv7 = stage + "/pblang-linux-armv7hf";
    let bin_larmel = stage + "/pblang-linux-armel";
    _compile_zr_zig(zig_bin, "arm-linux-musleabihf", repo_root, bin_larmv7, ["-s", "-lm"]);
    _compile_zr_zig(zig_bin, "arm-linux-musleabi", repo_root, bin_larmel, ["-s", "-lm"]);

    let bin_mipsel = stage + "/pblang-linux-mipsel";
    let bin_mips = stage + "/pblang-linux-mips";
    let bin_ppc32 = stage + "/pblang-linux-powerpc32";
    _compile_zr_zig(zig_bin, "mipsel-linux-musl", repo_root, bin_mipsel, ["-s", "-lm"]);
    _compile_zr_zig(zig_bin, "mips-linux-musl", repo_root, bin_mips, ["-s", "-lm"]);
    _compile_zr_zig(zig_bin, "powerpc-linux-musl", repo_root, bin_ppc32, ["-s", "-lm"]);

    println("[5/8] Building Tier-4 Bare-Metal 32-bit Microcontrollers (Freestanding Cortex-M0/M4 & RV32IM)...");
    let mcu_c_path = stage + "/mcu_baremetal_entry.c";
    fs_write(mcu_c_path, _mcu_baremetal_entry_c_source());
    let mcu_inc = "-I" + repo_root + "/runtime_stage3";
    let pmap_stage = "-ffile-prefix-map=" + stage + "=.";

    let mcu_cm0_elf = stage + "/pblang-mcu-cortex-m0.elf";
    let mcu_cm4_elf = stage + "/pblang-mcu-cortex-m4.elf";
    let mcu_rv32_elf = stage + "/pblang-mcu-rv32im.elf";
    _run_cmd(zig_bin, ["cc", "-target", "thumb-freestanding-eabi", "-mcpu=cortex_m0", "-Os", "-ffreestanding", "-nostdlib", pmap, pmap_stage, mcu_inc, "-Wl,-e,_start", mcu_c_path, "-o", mcu_cm0_elf], "mcu:cortex-m0");
    _run_cmd(zig_bin, ["cc", "-target", "thumb-freestanding-eabi", "-mcpu=cortex_m4", "-Os", "-ffreestanding", "-nostdlib", pmap, pmap_stage, mcu_inc, "-Wl,-e,_start", mcu_c_path, "-o", mcu_cm4_elf], "mcu:cortex-m4");
    _run_cmd(zig_bin, ["cc", "-target", "riscv32-freestanding-none", "-mcpu=generic_rv32+m", "-Os", "-ffreestanding", "-nostdlib", pmap, pmap_stage, mcu_inc, "-Wl,-e,_start", mcu_c_path, "-o", mcu_rv32_elf], "mcu:rv32im");

    let demo_sapp = "fn fib(n) { if n <= 1 { return n; } return fib(n - 1) + fib(n - 2); }\nprint \"PBLANG-SUB32-OK\";\nprint fib(10);\n";
    let demo_rv32_elf = stage + "/demo-native-rv32im.elf";
    fs_write_bytes(demo_rv32_elf, Sub32.compile_elf32_rv32(demo_sapp));

    println("[6/8] Building Tier-5 Legacy 16-bit (8086 DOS) & 8-bit (Z80 CP/M, 6502 C64, AVR8) Targets...");
    let dos16_vm_com = stage + "/pblang16.com";
    _run_cmd("nasm", ["-f", "bin", dos_asm, "-o", dos16_vm_com], "nasm:dos16");
    let dos16_demo_com = stage + "/demo16.com";
    fs_write_bytes(dos16_demo_com, Sub32.compile_dos16_com(demo_sapp));

    let cpm80_com = stage + "/pblang80.com";
    fs_write_bytes(cpm80_com, Sub32.compile_cpm80_com(demo_sapp));

    let c64_demo_sapp = "let a = 7;\nlet b = 6;\nlet s = 0;\nlet i = 1;\nwhile i <= 5 { s = s + i; i = i + 1; }\nprint \"PBLANG64\";\nprint a * b;\nprint s;\n";
    let c64_prg = stage + "/pblang64.prg";
    fs_write_bytes(c64_prg, Sub32.compile_c64_prg(c64_demo_sapp));

    let avr_elf = stage + "/pblang-avr8-atmega328p.elf";
    let avr_hex = stage + "/pblang-avr8-atmega328p.hex";
    _run_cmd("avr-gcc", ["-mmcu=atmega328p", "-Os", "-std=gnu99", "-s", "runtime_stage3/pblang_micro_vm.c", "-o", avr_elf], "avr-gcc:atmega328p");
    _run_cmd("avr-objcopy", ["-O", "ihex", "-R", ".eeprom", avr_elf, avr_hex], "avr-objcopy:ihex");
    let avr_demo_hex = stage + "/demo-avr8.hex";
    fs_write_bytes(avr_demo_hex, Sub32.compile_avr8_hex("let a = 21 * 2;\nprint \"AVR8-PBLANG\";\nprint a;\n"));

    let micro_lx86 = stage + "/pblang-micro-vm-linux-x86";
    let micro_lx64 = stage + "/pblang-micro-vm";
    _run_cmd(zig_bin, ["cc", "-target", "x86-linux-musl", "-Os", "-std=gnu99", pmap, "-s", micro_src, "-o", micro_lx86], "zig:micro-vm-x86");
    _run_cmd(zig_bin, ["cc", "-target", "x86_64-linux-musl", "-Os", "-std=gnu99", pmap, "-s", micro_src, "-o", micro_lx64], "zig:micro-vm-x64");

    let legacy_readme = stage + "/README-LEGACY-DEVICES.md";
    fs_write(legacy_readme, "# PBLang v" + ver + " — 8-bit, 16-bit & 32-bit Legacy / MCU Package\n\n" +
        "## Included Binaries\n" +
        "- `dos16/pblang16.com` — 16-bit Real-Mode 8086 MS-DOS / FreeDOS `.pbck` VM (`pblang16 prog.pbc` or `pblang16 --selftest`)\n" +
        "- `dos16/demo16.com` — Standalone 16-bit DOS `.COM` compiled by `pblang build --target dos16`\n" +
        "- `cpm80/pblang80.com` — 8-bit Intel 8080 / Zilog Z80 CP/M-80 `.COM` compiled by `pblang build --target cpm80`\n" +
        "- `c64/pblang64.prg` — 8-bit MOS 6502 Commodore 64 `.PRG` (`LOAD\"PBLANG64.PRG\",8,1` then `RUN`)\n" +
        "- `avr8/pblang-avr8-atmega328p.hex` — 8-bit AVR ATmega328P `.pbck` Micro-VM (`10.35 KiB` Flash, `< 1.8 KiB` SRAM)\n" +
        "- `avr8/demo-avr8.hex` — Direct UART0 Intel HEX firmware compiled by `pblang build --target avr8`\n" +
        "- `micro_vm/pblang-micro-vm-linux-x86` — Static 32-bit i386 Linux Micro-VM\n" +
        "- `src/pblang_micro_vm.c` & `src/pblang_dos16_vm.asm` — Portable C89/C99 & 8086 ASM sources\n");

    println("[7/8] Live-Verifying Built Executables & Generating CycloneDX 1.5 SBOM...");
    let v1 = _run_cmd(bin_lx64, ["--version"], "verify:linux-x86_64");
    let v2 = _run_cmd(bin_lx86, ["--version"], "verify:linux-x86-32bit");
    let v3 = _run_cmd(micro_lx86, ["--selftest"], "verify:micro-vm-32bit");
    if not str_contains(v1.stdout, ver) or not str_contains(v2.stdout, ver) {
        throw "Version mismatch in built host binaries (expected " + ver + "): " + v1.stdout + " / " + v2.stdout;
    }
    if not str_contains(v3.stdout, "42") {
        throw "Micro-VM 32-bit selftest failed: " + v3.stdout;
    }

    let sbom_pkgs = [
        map{ name: "pblang-linux-x86_64", version: ver, sha256: _file_sha256_and_size(bin_lx64).sha256, license: "Apache-2.0" },
        map{ name: "pblang-windows-x86_64", version: ver, sha256: _file_sha256_and_size(bin_wx64).sha256, license: "Apache-2.0" },
        map{ name: "pblang-macos-universal", version: ver, sha256: _file_sha256_and_size(bin_mac_univ).sha256, license: "Apache-2.0" },
        map{ name: "pblang-android-universal-apk", version: ver, sha256: _file_sha256_and_size(apk_stage).sha256, license: "Apache-2.0" },
        map{ name: "pblang-ios-arm64", version: ver, sha256: _file_sha256_and_size(bin_ios_arm64).sha256, license: "Apache-2.0" },
        map{ name: "pblang-wasm32", version: ver, sha256: _file_sha256_and_size(bin_wasm).sha256, license: "Apache-2.0" },
        map{ name: "pblang-micro-vm", version: ver, sha256: _file_sha256_and_size(micro_lx86).sha256, license: "Apache-2.0" }
    ];
    let sbom_res = PKG.generate_cyclonedx_sbom(
        map{ name: "pblang", version: ver, license: "Apache-2.0" },
        sbom_pkgs,
        map{ timestamp: "2026-11-15T00:00:00Z" }
    );
    let sbom_stage = stage + "/pblang-" + ver + "-sbom.cdx.json";
    fs_write(sbom_stage, sbom_res.json + "\n");

    println("[8/8] Packaging Deterministic Pure-PBLang Archives, Privacy-Scanning & Writing SHA256SUMS.txt...");
    let comp_level = if env_get("PBLANG_FAST_ARCHIVE") == "1" { 0 } else { 1 };
    let runtime_tree = _load_cached_runtime_tree(repo_root, comp_level);

    let pfx = "pblang-" + ver;
    let packages = [
        map{
            filename: pfx + "-linux-x86_64.tar.gz", format: "tar.gz", top_dir: pfx + "-linux-x86_64", include_tree: true,
            items: [
                map{ src: bin_lx64, dst: "bin/pblang", exec: true },
                map{ src: bin_lx64_static, dst: "bin/pblang-static", exec: true },
                map{ src: micro_lx64, dst: "bin/pblang-micro-vm", exec: true }
            ]
        },
        map{
            filename: pfx + "-linux-arm64.tar.gz", format: "tar.gz", top_dir: pfx + "-linux-arm64", include_tree: true,
            items: [map{ src: bin_larm64, dst: "bin/pblang", exec: true }]
        },
        map{
            filename: pfx + "-windows-x86_64.zip", format: "zip", top_dir: pfx + "-windows-x86_64", include_tree: true,
            items: [map{ src: bin_wx64, dst: "bin/pblang.exe", exec: true }]
        },
        map{
            filename: pfx + "-windows-arm64.zip", format: "zip", top_dir: pfx + "-windows-arm64", include_tree: true,
            items: [map{ src: bin_warm64, dst: "bin/pblang.exe", exec: true }]
        },
        map{
            filename: pfx + "-macos-universal.tar.gz", format: "tar.gz", top_dir: pfx + "-macos-universal", include_tree: true,
            items: [
                map{ src: bin_mac_univ, dst: "bin/pblang", exec: true },
                map{ src: bin_mac_arm64, dst: "bin/pblang-arm64", exec: true },
                map{ src: bin_mac_x64, dst: "bin/pblang-x86_64", exec: true }
            ]
        },
        map{
            filename: pfx + "-android-arm64-x86_64.tar.gz", format: "tar.gz", top_dir: pfx + "-android", include_tree: true,
            items: [
                map{ src: bin_and_arm64, dst: "bin/pblang-android-arm64", exec: true },
                map{ src: bin_and_x64, dst: "bin/pblang-android-x86_64", exec: true },
                map{ src: android_installer_sapp, dst: "install_android.sapp", exec: false }
            ]
        },
        map{
            filename: pfx + "-ios-arm64.tar.gz", format: "tar.gz", top_dir: pfx + "-ios-arm64", include_tree: false,
            items: [
                map{ src: ios_bundle_stage + "/PBLang.app/PBLang", dst: "PBLang.app/PBLang", exec: true },
                map{ src: ios_bundle_stage + "/PBLang.app/Info.plist", dst: "PBLang.app/Info.plist", exec: false },
                map{ src: ios_bundle_stage + "/PBLang.app/PkgInfo", dst: "PBLang.app/PkgInfo", exec: false }
            ]
        },
        map{
            filename: pfx + "-linux-riscv64.tar.gz", format: "tar.gz", top_dir: pfx + "-linux-riscv64", include_tree: true,
            items: [map{ src: bin_rv64, dst: "bin/pblang", exec: true }]
        },
        map{
            filename: pfx + "-linux-workstation-alt64.tar.gz", format: "tar.gz", top_dir: pfx + "-linux-alt64", include_tree: true,
            items: [
                map{ src: bin_ppc64le, dst: "bin/pblang-powerpc64le", exec: true },
                map{ src: bin_mips64el, dst: "bin/pblang-mips64el", exec: true }
            ]
        },
        map{
            filename: pfx + "-wasm32.tar.gz", format: "tar.gz", top_dir: pfx + "-wasm32", include_tree: true,
            items: [
                map{ src: bin_wasm, dst: "bin/pblang.wasm", exec: false },
                map{ src: wasi_runner_sapp, dst: "bin/run_wasi.sapp", exec: false }
            ]
        },
        map{
            filename: pfx + "-windows-x86.zip", format: "zip", top_dir: pfx + "-windows-x86", include_tree: true,
            items: [map{ src: bin_wx86, dst: "bin/pblang.exe", exec: true }]
        },
        map{
            filename: pfx + "-linux-x86.tar.gz", format: "tar.gz", top_dir: pfx + "-linux-x86", include_tree: true,
            items: [
                map{ src: bin_lx86, dst: "bin/pblang", exec: true },
                map{ src: micro_lx86, dst: "bin/pblang-micro-vm", exec: true }
            ]
        },
        map{
            filename: pfx + "-linux-armv7-armel.tar.gz", format: "tar.gz", top_dir: pfx + "-linux-arm32", include_tree: true,
            items: [
                map{ src: bin_larmv7, dst: "bin/pblang-armv7hf", exec: true },
                map{ src: bin_larmel, dst: "bin/pblang-armel", exec: true }
            ]
        },
        map{
            filename: pfx + "-linux-routers-classic32.tar.gz", format: "tar.gz", top_dir: pfx + "-linux-classic32", include_tree: true,
            items: [
                map{ src: bin_mipsel, dst: "bin/pblang-mipsel", exec: true },
                map{ src: bin_mips, dst: "bin/pblang-mips", exec: true },
                map{ src: bin_ppc32, dst: "bin/pblang-powerpc32", exec: true },
                map{ src: demo_rv32_elf, dst: "bin/demo-native-riscv32", exec: true }
            ]
        },
        map{
            filename: pfx + "-mcu-32bit-cortexm-rv32.tar.gz", format: "tar.gz", top_dir: pfx + "-mcu-32bit", include_tree: false,
            items: [
                map{ src: mcu_cm0_elf, dst: "firmware/pblang-mcu-cortex-m0.elf", exec: false },
                map{ src: mcu_cm4_elf, dst: "firmware/pblang-mcu-cortex-m4.elf", exec: false },
                map{ src: mcu_rv32_elf, dst: "firmware/pblang-mcu-rv32im.elf", exec: false },
                map{ src: demo_rv32_elf, dst: "firmware/demo-native-rv32im.elf", exec: true },
                map{ src: micro_src, dst: "src/pblang_micro_vm.c", exec: false },
                map{ src: mcu_c_path, dst: "src/mcu_baremetal_entry.c", exec: false }
            ]
        },
        map{
            filename: pfx + "-legacy-8bit-16bit.zip", format: "zip", top_dir: pfx + "-legacy-8bit-16bit", include_tree: false,
            items: [
                map{ src: dos16_vm_com, dst: "dos16/pblang16.com", exec: true },
                map{ src: dos16_demo_com, dst: "dos16/demo16.com", exec: true },
                map{ src: cpm80_com, dst: "cpm80/pblang80.com", exec: true },
                map{ src: c64_prg, dst: "c64/pblang64.prg", exec: false },
                map{ src: avr_elf, dst: "avr8/pblang-avr8-atmega328p.elf", exec: false },
                map{ src: avr_hex, dst: "avr8/pblang-avr8-atmega328p.hex", exec: false },
                map{ src: avr_demo_hex, dst: "avr8/demo-avr8.hex", exec: false },
                map{ src: micro_lx86, dst: "micro_vm/pblang-micro-vm-linux-x86", exec: true },
                map{ src: micro_src, dst: "src/pblang_micro_vm.c", exec: false },
                map{ src: dos_asm, dst: "src/pblang_dos16_vm.asm", exec: false },
                map{ src: legacy_readme, dst: "README.md", exec: false }
            ]
        }
    ];

    let pi = 0;
    while pi < len(packages) {
        let pkg = packages[pi];
        let p_out = out_dir + "/" + pkg.filename;
        let tree_ref = if pkg.include_tree { runtime_tree } else { nil };
        if pkg.format == "tar.gz" {
            make_tar_gz_pure(p_out, pkg.top_dir, pkg.items, tree_ref, comp_level);
        } else {
            make_zip_pure(p_out, pkg.top_dir, pkg.items, tree_ref, comp_level);
        }
        pi = pi + 1;
    }

    let standalone_copies = [
        // Versioned standalone executables, mobile bundles & SBOM
        map{ src: bin_lx64, dst: pfx + "-linux-x86_64", exec: true },
        map{ src: bin_larm64, dst: pfx + "-linux-arm64", exec: true },
        map{ src: bin_wx64, dst: pfx + "-windows-x86_64.exe", exec: true },
        map{ src: bin_warm64, dst: pfx + "-windows-arm64.exe", exec: true },
        map{ src: bin_mac_univ, dst: pfx + "-macos-universal", exec: true },
        map{ src: apk_stage, dst: pfx + "-android-universal.apk", exec: false },
        map{ src: bin_ios_arm64, dst: pfx + "-ios-arm64", exec: true },
        map{ src: bin_wasm, dst: pfx + "-wasm32.wasm", exec: false },
        map{ src: bin_wx86, dst: pfx + "-windows-x86.exe", exec: true },
        map{ src: bin_lx86, dst: pfx + "-linux-x86", exec: true },
        map{ src: bin_larmv7, dst: pfx + "-linux-armv7hf", exec: true },
        map{ src: sbom_stage, dst: pfx + "-sbom.cdx.json", exec: false },
        // Unversioned smart-updater & CI SDK aliases (binary + full stdlib archives)
        map{ src: bin_lx64, dst: "pblang-linux-x86_64", exec: true },
        map{ src: bin_wx64, dst: "pblang-windows-x86_64.exe", exec: true },
        map{ src: out_dir + "/" + pfx + "-linux-x86_64.tar.gz", dst: "pblang-linux-x86_64.tar.gz", exec: false },
        map{ src: out_dir + "/" + pfx + "-windows-x86_64.zip", dst: "pblang-windows-x86_64.zip", exec: false }
    ];

    let ci = 0;
    while ci < len(standalone_copies) {
        let cp = standalone_copies[ci];
        _copy_file_binary(cp.src, out_dir + "/" + cp.dst, cp.exec);
        ci = ci + 1;
    }

    let pfx_h = "/" + "home" + "/";
    let pfx_m = "/" + "media" + "/";
    let user_env = env_get("USER");
    let forbidden = [repo_root];
    if user_env != nil and user_env != "" {
        array_push(forbidden, pfx_h + user_env);
        array_push(forbidden, pfx_m + user_env);
    }

    let summary = write_sha256sums(out_dir, forbidden);
    println("[DONE] Built & verified " + str(summary.count) + " universal v" + ver + " release assets in " + out_dir);
    return summary;
}

if env_get("PBLANG_BUILD_UNIVERSAL_LIB") != "1" {
    let ver = read_manifest_version(cwd());
    let out_dir = _parse_out_dir(ver);
    build_all_universal_devices(out_dir);
}

export read_manifest_version, build_apple_fat_macho, make_tar_gz_pure, make_zip_pure;
export privacy_scan_files, write_sha256sums, build_all_universal_devices;
