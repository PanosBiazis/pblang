// tools/pbgraph.sapp — one-command knowledge-graph builder (graphify + Obsidian, in pblang).
//
//   pblang run tools/pbgraph.sapp <folder> [--out <dir>]
//
// Reads every .md / .txt note in <folder>, parses [[wikilinks]], builds the knowledge graph, and writes
// an Obsidian-ready VAULT (one note per file with auto-backlinks) + GRAPH_REPORT.md + graph.json into
// <out> (default: <folder>/graphify-out). Open <out> in Obsidian, or feed graph.json to a GraphRAG agent.

let kg = import("stdlib/knowledge_graph.sapp");
// uses the raw fs_* builtins (fs_listdir / fs_read / fs_mkdirs / fs_write) so any path — including
// absolute ones — works from a single command; the fs.sapp wrapper would sandbox to the cwd.

// note name = filename with its extension stripped (everything before the final '.')
fn _stem(f) {
    let last = 0 - 1; let i = 0;
    while i < len(f) { if strcharcodeat(f, i) == 46 { last = i; } i = i + 1; }   // 46 = '.'
    if last >= 0 { return str_slice(f, 0, last); }
    return f;
}
fn _has_suffix(f, ext) {
    if len(f) <= len(ext) { return false; }
    return str_slice(f, len(f) - len(ext), len(f)) == ext;
}
fn _is_flag(arg) { return len(arg) > 0 and strcharcodeat(arg, 0) == 45; }   // starts with '-'

fn main() {
    let a = os_args();
    let dir = "."; let out = nil; let i = 0;
    while i < len(a) {
        let arg = a[i];
        if arg == "--out" and i + 1 < len(a) { out = a[i + 1]; i = i + 1; }
        elif not _is_flag(arg) and arg != "run" and not _has_suffix(arg, ".sapp") { dir = arg; }
        i = i + 1;
    }
    if out == nil { out = dir + "/graphify-out"; }

    // gather the corpus: every markdown / text note in the folder
    let files = fs_listdir(dir);
    let corpus = map{};
    let n = 0;
    let j = 0;
    while j < len(files) {
        let f = files[j];
        if _has_suffix(f, ".md") or _has_suffix(f, ".txt") {
            let content = fs_read(dir + "/" + f);
            corpus[_stem(f)] = content;
            n = n + 1;
        }
        j = j + 1;
    }
    if n == 0 {
        print "pbgraph: no .md/.txt notes found in '" + dir + "'";
        return nil;
    }

    let g = kg.build(corpus);
    fs_mkdirs(out);
    let written = kg.write_vault(g, out);
    print "pbgraph: " + str(n) + " notes → " + str(written) + " files in " + out + "/";
    print "";
    print kg.report(g);
    return nil;
}

main();
