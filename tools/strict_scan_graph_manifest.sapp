// Generate the exact canonical graph manifest for the trusted strict scanner.
// This developer tool prints data only; it grants no execution authority.
let LINK = import("stdlib:source_inliner.sapp");
let SECURE = import("stdlib:secure_file.sapp");

let MODULE_PATHS = [
    "tools/strict_inventory_scan.sapp",
    "stdlib/project_inventory.sapp",
    "stdlib/project_survey.sapp",
    "stdlib/product_health.sapp",
    "stdlib/secure_file.sapp",
    "stdlib/linux_dirfs.sapp",
    "stdlib/strict_cleanup_transition.sapp",
    "stdlib/linux_rename_noreplace.sapp",
    "stdlib/linux_linkat_held.sapp",
    "stdlib/native_crypto_accel.sapp",
    "stdlib/aes_gcm.sapp",
    "stdlib/codegen_x64.sapp",
    "stdlib/posix_dirfs.sapp",
    "stdlib/windows_dirfs.sapp",
    "stdlib/windows_native_abi.sapp",
    "stdlib/windows_pe.sapp",
    "stdlib/sha256_pb.sapp"
];

fn source_path(virtual_path) {
    if str_starts_with(virtual_path, "stdlib:") {
        return "stdlib/" + str_slice(virtual_path, 7, len(virtual_path));
    }
    return virtual_path;
}

let raw = try env_get("PBLANG_SCRIPT_ARGS") catch "";
let args = if raw == nil or raw == "" { [] } else { str_split(raw, "\n") };
if len(args) != 1 or not str_starts_with(args[0], "/") {
    throw "strict_scan_graph_manifest: one absolute project root is required";
}
let root = args[0]; let entry = "tools/strict_inventory_scan.sapp";
let source_by_path = map{};
for path in MODULE_PATHS {
    let loaded = SECURE.read_bytes(root + "/" + path, 1048576);
    if not loaded.ok or loaded.size < 1 { throw "strict_scan_graph_manifest: module unavailable"; }
    let source = try bytes_to_str(loaded.bytes) catch nil;
    if type(source) != "string" { throw "strict_scan_graph_manifest: module is not UTF-8"; }
    source_by_path[path] = source;
}
// Convert filesystem spelling to the virtual spelling understood by imports.
let modules = map{};
for path in MODULE_PATHS {
    if path != entry {
        let virtual = if str_starts_with(path, "stdlib/") {
            "stdlib:" + str_slice(path, 7, len(path))
        } else { path };
        modules[virtual] = source_by_path[path];
    }
}
let linked = LINK.link_modules(source_by_path[entry], modules, map{
    entry_path: entry,
    max_modules: 32, max_module_depth: 32,
    max_module_source_bytes: 1048576, max_total_source_bytes: 1048576,
    max_linked_source_bytes: 2097152, max_path_bytes: 1024
});
if not linked.ok {
    throw "strict_scan_graph_manifest: exact graph cannot be linked: "
        + str(try linked.reason catch "unknown");
}
if linked.modules != len(map_keys(modules)) {
    throw "strict_scan_graph_manifest: supplied graph contains unreachable modules";
}
let paths = [entry];
for virtual in linked.module_order { array_push(paths, source_path(virtual)); }
let rows = [];
for path in paths {
    let source = try source_by_path[path] catch nil;
    if type(source) != "string" { throw "strict_scan_graph_manifest: module missing"; }
    array_push(rows, map{ path: path,
        sha256: sha256(base64_encode_bytes(str_to_bytes(source))) });
}
print json_stringify(map{
    format: "pblang.strict-scan.graph-manifest.v1", entry_path: entry,
    input_graph_sha256: linked.input_graph_sha256,
    linked_source_sha256: sha256(linked.source), modules: rows
});
