// Summarize a PBLang module-audit JSON report without echoing source snippets.

let OS = import("stdlib:os.sapp");
let SECURE = import("stdlib:secure_file.sapp");
let PATH = import("stdlib:path.sapp");

fn increment(counts, key, amount = 1) { counts[key] = (try counts[key] catch 0) + amount; }

fn sorted_paths(counts) {
    let keys = map_keys(counts); let out = []; let used = map{};
    while len(out) < len(keys) {
        let best = 0 - 1; let i = 0;
        while i < len(keys) {
            if not (try used[keys[i]] catch false) {
                if best < 0 or counts[keys[i]] > counts[keys[best]] { best = i; }
            }
            i = i + 1;
        }
        if best < 0 { break; }
        used[keys[best]] = true; array_push(out, keys[best]);
    }
    return out;
}

fn main() {
    let args = OS.script_args(); let paths = []; let limit = 30; let high_limit = 0; let i = 0;
    while i < len(args) {
        if str_starts_with(args[i], "--limit=") { limit = try parse_number(str_slice(args[i], 8, len(args[i]))) catch 30; }
        elif str_starts_with(args[i], "--high-limit=") { high_limit = try parse_number(str_slice(args[i], 13, len(args[i]))) catch 0; }
        elif str_starts_with(args[i], "--") { print "pbmoduletriage: unknown option " + args[i]; os_exit(2); }
        else { array_push(paths, args[i]); }
        i = i + 1;
    }
    if len(paths) != 1 or limit < 1 or limit > 1000 or high_limit < 0 or high_limit > 10000 {
        print "usage: pbmoduletriage REPORT.json [--limit=N] [--high-limit=N]"; os_exit(2);
    }
    let report_path = if platform() == "linux" { PATH.normalize(PATH.absolute(paths[0])) } else { paths[0] };
    let loaded = if platform() == "linux" { SECURE.read_text(report_path, 67108864, false) }
        else { try { let bytes = fs_read_bytes(paths[0]);
            if len(bytes) > 67108864 { map{ ok: false } }
            else { map{ ok: true, text: bytes_to_str(bytes) } } } catch map{ ok: false } };
    if not loaded.ok { print "pbmoduletriage: report unavailable, unsafe, or larger than 64 MiB"; os_exit(2); }
    let report = try json_parse(loaded.text) catch nil;
    if type(report) != "map" or (try report.format catch "") != "pblang.module_audit.v1" {
        print "pbmoduletriage: invalid module audit report"; os_exit(2);
    }
    print "complete=" + str(report.complete) + " modules=" + str(report.module_count)
        + " files=" + str(report.files_scanned) + " findings=" + str(report.finding_count)
        + " degraded_encodings=" + str(try report.encoding_degraded_files catch 0);
    let sev = try report.aggregate.counts_severity catch map{};
    let kind = try report.aggregate.counts_kind catch map{};
    let role = try report.aggregate.counts_role catch map{};
    print "severity high=" + str(try sev.high catch 0) + " medium=" + str(try sev.medium catch 0)
        + " low=" + str(try sev.low catch 0) + " info=" + str(try sev.info catch 0);
    print "kind security=" + str(try kind.security catch 0) + " reliability=" + str(try kind.reliability catch 0)
        + " performance=" + str(try kind.performance catch 0) + " incomplete=" + str(try kind.incomplete catch 0)
        + " roadmap=" + str(try kind.roadmap catch 0);
    print "role source=" + str(try role.source catch 0) + " test=" + str(try role.test catch 0)
        + " docs=" + str(try role.docs catch 0) + " config=" + str(try role.config catch 0);
    let source_blocking = map{}; let source_high = map{}; let source_medium = map{};
    let modules = report.modules; i = 0;
    let incomplete_emitted = 0;
    while i < len(modules) and incomplete_emitted < limit {
        if not (try modules[i].complete catch false) {
            let reasons = try modules[i].incomplete_reasons catch [];
            let labels = []; let ri = 0;
            while ri < len(reasons) and ri < 8 {
                array_push(labels, str(try reasons[ri].reason catch "unknown incomplete reason")); ri = ri + 1;
            }
            print "incomplete " + str(modules[i].root) + " :: " + str_join(labels, "; ");
            incomplete_emitted = incomplete_emitted + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < len(modules) {
        let rows = modules[i].findings; let j = 0;
        while j < len(rows) {
            if (try rows[j].role catch "") == "source"
                and ((try rows[j].severity catch "") == "high" or rows[j].severity == "medium") {
                increment(source_blocking, rows[j].path);
                if rows[j].severity == "high" { increment(source_high, rows[j].path); }
                else { increment(source_medium, rows[j].path); }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    let ordered = sorted_paths(source_blocking); i = 0;
    while i < len(ordered) and i < limit {
        let path = ordered[i];
        print "source " + str(try source_high[path] catch 0) + " high "
            + str(try source_medium[path] catch 0) + " medium " + path;
        i = i + 1;
    }
    if high_limit > 0 {
        let emitted = 0; i = 0;
        while i < len(modules) and emitted < high_limit {
            let rows = modules[i].findings; let j = 0;
            while j < len(rows) and emitted < high_limit {
                if (try rows[j].role catch "") == "source" and (try rows[j].severity catch "") == "high" {
                    print "high " + rows[j].path + ":" + str(rows[j].line) + " " + str(rows[j].kind);
                    emitted = emitted + 1;
                }
                j = j + 1;
            }
            i = i + 1;
        }
    }
}

main();
