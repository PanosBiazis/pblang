// pblang/tools/pblang_stage3_selfhost_driver.sapp
// Unified Stage-3 Zero-Rust Native Host Compiler Driver, Deep Runtime Kernel,
// Cycle-Accurate Hardware Emulators & Physical Hardware Connection/Management CLI
// 100% Pure PBLang implementation.

let OS         = import("stdlib:os.sapp");
let JSON       = import("stdlib:json.sapp");
let Stage3Host = import("../runtime_stage3/stage3_native_host_runtime.sapp");
let DeepKernel = import("../runtime_stage3/deep_runtime_kernel.sapp");
let Emulators  = import("../emulators/hardware_emulators_suite.sapp");
let PhysMgr    = import("../emulators/physical_hardware_manager.sapp");

fn run_driver(raw_args = nil) {
    let a = if type(raw_args) == "array" { raw_args } else { [] };
    let cmd = "all";
    if len(a) > 0 {
        cmd = str(a[0]);
    }
    if cmd == "stage3-host" {
        print (JSON.stringify(Stage3Host.evaluate_stage3_zero_rust_host_replacement()));
        return 0;
    }
    if cmd == "deep-kernel" {
        print (JSON.stringify(DeepKernel.run_deep_runtime_kernel_suite()));
        return 0;
    }
    if cmd == "emulators" {
        print (JSON.stringify(Emulators.run_all_hardware_emulators_suite()));
        return 0;
    }
    if cmd == "hardware-manager" or cmd == "discover" {
        print (JSON.stringify(PhysMgr.run_physical_and_emulator_management_suite()));
        return 0;
    }
    if cmd == "connect" {
        let dev_id = "arduino_uno_r4_wifi";
        if len(a) > 1 { dev_id = str(a[1]); }
        print (JSON.stringify(PhysMgr.execute_hardware_operation_dual_mode(dev_id)));
        return 0;
    }
    if cmd == "flash" {
        let dev_id = "arduino_uno_r4_wifi";
        if len(a) > 1 { dev_id = str(a[1]); }
        print (JSON.stringify(PhysMgr.deploy_pblang_firmware_or_command_packet(dev_id)));
        return 0;
    }
    if cmd == "estop" {
        let dev_id = "cnc_3d_printer";
        if len(a) > 1 { dev_id = str(a[1]); }
        print (JSON.stringify(PhysMgr.connect_and_manage_hardware_device(dev_id, map{ trigger_emergency_stop: true })));
        return 0;
    }
    if cmd == "emit-elf64-hex" or cmd == "emit-elf64-bytes" {
        let elf = Stage3Host.compile_zero_rust_elf64_image(nil, 0);
        print (JSON.stringify(elf["bytes"]));
        return 0;
    }
    let h = Stage3Host.evaluate_stage3_zero_rust_host_replacement();
    let k = DeepKernel.run_deep_runtime_kernel_suite();
    let e = Emulators.run_all_hardware_emulators_suite();
    let p = PhysMgr.run_physical_and_emulator_management_suite();
    print (JSON.stringify(map{
        ok: h.ok and k.ok and e.ok and p.ok,
        stage3_zero_rust_host: h,
        deep_runtime_kernel: k,
        hardware_emulators_suite: e,
        physical_hardware_manager: p
    }));
    return 0;
}

run_driver(OS.script_args());
