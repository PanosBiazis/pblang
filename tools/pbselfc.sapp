// Compile PBLang source to the bounded self-hosted PBCS/PBCK format.
// Usage: pblang tools/pbselfc.sapp --allow-all -- input.sapp output.pbck

let Compiler = import("stdlib/compiler/selfhost_cli.sapp");

fn user_args() {
    let argv = os_args(); let out = []; let found = false; let i = 0;
    while i < len(argv) {
        let value = str(argv[i]);
        if found {
            if value != "--" and not str_starts_with(value, "--allow") {
                array_push(out, value);
            }
        } elif str_ends_with(value, "pbselfc.sapp") {
            found = true;
        }
        i = i + 1;
    }
    return out;
}

let args = user_args();
if len(args) != 2 {
    print "usage: pblang tools/pbselfc.sapp --allow-all -- input.sapp output.pbck";
    os_exit(2);
}
let result = Compiler.compile_file(args[0], args[1]);
print json_stringify(result);
if not result.ok { os_exit(1); }
