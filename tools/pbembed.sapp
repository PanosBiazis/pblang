// PBLang-native embedded CLI surface.

let Embedded = import("stdlib:embedded.sapp");
let Linux = import("stdlib:embedded_linux.sapp");
let ESP32 = import("stdlib:codegen_esp32_embedded.sapp");
let ESP32Live = import("stdlib:embedded_esp32_live.sapp");
let ESP32Loader = import("stdlib:embedded_esp32_loader.sapp");
let Circuit = import("stdlib:embedded_circuit.sapp");
let Controller = import("stdlib:embedded_controller.sapp");
let OS = import("stdlib:os.sapp");
let args = OS.script_args();

fn argument(index, fallback = nil) { if index < len(args) { return args[index]; } return fallback; }
fn has_argument(value) { for i len(args) { if args[i] == value { return true; } } return false; }
fn integer(index, fallback, minimum, maximum) {
    let value = try parse_number(str(argument(index, fallback))) catch nil;
    if value == nil or value != num_floor(value) or value < minimum or value > maximum {
        throw "pbembed: argument " + str(index) + " must be " + str(minimum) + ".." + str(maximum);
    }
    return value;
}

let command = str_lower(str(argument(0, "doctor")));
let result = map{};
if command == "boards" { result = map{ok:true,boards:Embedded.boards(),capabilities:Embedded.capabilities()}; }
elif command == "board-info" { result = Embedded.board_info(argument(1, "")); }
elif command == "manual" {
    result = Embedded.inspect(map{board:str(argument(1, "")),port:str(argument(2, ""))});
}
elif command == "inspect-pin" {
    result = Embedded.inspect_pin(str(argument(1, "")),str(argument(2, "")));
}
elif command == "inspect" {
    result = Embedded.inspect(map{board:str(argument(1, "")),port:str(argument(2, ""))});
}
elif command == "devices" { result = Linux.devices(map{include_serial:argument(1, "") == "--include-serial"}); }
elif command == "doctor" { result = Linux.doctor(map{include_serial:false}); }
elif command == "build-blink" {
    let board = str(argument(1, "arduino-uno")); let output = str(argument(2, "build/embedded/" + board + "/firmware.hex"));
    let artifact = Embedded.build(Embedded.blink("status-led-test", integer(3, 500, 1, 60000)), board);
    if artifact.ok { result = Linux.publish_artifact(artifact, output); result.artifact = artifact; }
    else { result = artifact; }
}
elif command == "simulate-blink" {
    result = Embedded.simulate(Embedded.blink("status-led-test", integer(2, 2, 1, 100)),
        str(argument(1, "arduino-uno")), map{events:3,instruction_budget:1000000});
}
elif command == "build-esp32-ram" {
    let board = Embedded.board_info("esp32-devkitc-v4");
    let lowered = Embedded.IR.lower(Embedded.blink("status-led-test", 500), board);
    let artifact = ESP32.compile(lowered);
    result = Linux.publish_artifact(artifact,
        str(argument(1, "build/embedded/esp32-devkitc-v4/blink-ram.bin")));
    if result.ok { result.artifact = artifact; }
}
elif command == "build-controller-uno" {
    let artifact = Embedded.build_controller("arduino-uno");
    result = Linux.publish_artifact(artifact,
        str(argument(1, "build/embedded/arduino-uno/controller.hex")));
    if result.ok { result.artifact = artifact; }
}
elif command == "load-esp32-ram" {
    let port = str(argument(1, "/dev/ttyUSB1"));
    if str(argument(2, "")) != "--confirm-ram-load" {
        result = map{ok:false,error:"append --confirm-ram-load after reviewing ESP32 board and port"};
    } else {
        let board = Embedded.board_info("esp32-devkitc-v4");
        let lowered = Embedded.IR.lower(Embedded.blink("status-led-test", 500), board);
        let artifact = ESP32.compile(lowered);
        result = ESP32Loader.load_ram(artifact,map{port:port,confirm_ram_load:true});
    }
}
elif command == "probe-uno" { result = Linux.probe_uno(str(argument(1, "/dev/ttyUSB0"))); }
elif command == "flash-blink" {
    let board = str(argument(1, "arduino-uno")); let port = str(argument(2, ""));
    let interval = integer(3, 500, 1, 60000); let confirmation = str(argument(4, ""));
    if confirmation != "--confirm-write" { result = map{ok:false,error:"append --confirm-write after reviewing board and port"}; }
    else {
        let artifact = Embedded.build(Embedded.blink("status-led-test", interval), board);
        if artifact.ok { result = Linux.flash(artifact, map{confirm_device_write:true,
            confirm_board:board,port:port,artifact_path:"build/embedded/" + board + "/firmware.hex"}); }
        else { result = artifact; }
    }
}
elif command == "flash-controller-uno" {
    let port = str(argument(1, "/dev/ttyUSB0"));
    if str(argument(2, "")) != "--confirm-write" {
        result = map{ok:false,error:"append --confirm-write after reviewing Arduino UNO and port"};
    } else {
        let artifact = Embedded.build_controller("arduino-uno");
        result = Linux.flash(artifact, map{confirm_device_write:true,
            confirm_board:"arduino-uno",port:port,
            artifact_path:"build/embedded/arduino-uno/controller.hex"});
    }
}
elif command == "control" {
    let board = str(argument(1, "arduino-uno")); let port = str(argument(2, ""));
    let action = str_lower(str(argument(3, "status")));
    if not has_argument("--confirm-control") {
        result = map{ok:false,error:"append --confirm-control after reviewing board, port, and action"};
    } else {
        let circuit = Circuit.new(map{name:"Wired controller",mode:"wired"});
        let added = Circuit.add_device(circuit, "target", board, map{mode:"wired",port:port});
        if not added.ok { result = added; }
        else {
            let session = Controller.connect(circuit, "target");
            if not session.ok { result = session; }
            elif action == "status" { result = Controller.status(session); }
            elif action == "on" { result = Controller.set_led(session, true); }
            elif action == "off" { result = Controller.set_led(session, false); }
            elif action == "toggle" { result = Controller.toggle_led(session); }
            elif action == "blink" { result = Controller.set_blink(session, true,
                integer(4, 500, 10, 60000), integer(5, 0, 0, 60000)); }
            elif action == "stop" { result = Controller.set_blink(session, false); }
            else { result = map{ok:false,error:"action must be status, on, off, toggle, blink, or stop"}; }
            let closed = Controller.close(session); result.termios_restored = closed.termios_restored;
            result.snapshot = Circuit.snapshot(circuit);
        }
    }
}
elif command == "monitor" {
    result = Linux.monitor(str(argument(1, "")), integer(4, 4096, 1, 65536),
        integer(3, 3000, 1, 60000), integer(2, 9600, 50, 4000000));
}
elif command == "verify-esp32-markers" {
    result = ESP32Live.verify_markers(map{ port:str(argument(1, "/dev/ttyUSB1")),
        samples:integer(2, 6, 3, 32), expected_ms:integer(3, 500, 50, 10000),
        tolerance_ms:integer(4, 250, 1, 10000) });
}
else { result = map{ok:false,error:"unknown command",commands:["doctor","boards","board-info","manual","inspect","inspect-pin","devices",
    "build-blink","build-esp32-ram","build-controller-uno","load-esp32-ram","simulate-blink","probe-uno",
    "flash-blink","flash-controller-uno","control","monitor",
    "verify-esp32-markers"]}; }

print json_stringify(result);
