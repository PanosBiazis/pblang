// tools/pbinput.sapp -- safe PBLang-native input contract CLI.
//
// This tool validates events, reports host adapters, builds structured argv,
// and runs deterministic virtual replay. It never actuates the live desktop.

let Events = import("stdlib:input_events.sapp");
let Control = import("stdlib:input_control.sapp");

fn user_args() {
    let raw = os_args(); let out = []; let seen = false; let i = 0;
    while i < len(raw) {
        let token = raw[i];
        if not seen {
            if str_ends_with(token, "pbinput.sapp") { seen = true; }
        } else if token != "--" and not str_starts_with(token, "--allow") {
            array_push(out, token);
        }
        i = i + 1;
    }
    return out;
}

fn usage(code) {
    print "pbinput: PBLang portable input validation and virtual replay";
    print "usage: pbinput status | plan-type <backend> <text> | plan-key <backend> <key>";
    print "       pbinput plan-move <backend> <x> <y> | plan-delta <backend> <dx> <dy>";
    print "       pbinput plan-click <backend> <button> | demo";
    os_exit(code);
}

fn number_arg(args, index) {
    if index >= len(args) { throw "missing numeric argument"; }
    return try parse_number(args[index]) catch nil;
}

fn plan(backend, checked) {
    if checked.ok { return Events.backend_plan(backend, checked.event); }
    return checked;
}

let args = user_args();
if len(args) == 0 or args[0] == "--help" or args[0] == "-h" { usage(if len(args) == 0 { 2 } else { 0 }); }

let action = args[0]; let result = map{};
if action == "status" {
    result = map{ format: "pblang.input.cli.status.v1", backends: Control.backends(),
                  portable_keys: Events.safe_keys(), live_actuation: false };
} else if action == "plan-type" and len(args) >= 3 {
    result = plan(args[1], Events.type_event(args[2]));
} else if action == "plan-key" and len(args) >= 3 {
    result = plan(args[1], Events.key_event(args[2]));
} else if action == "plan-move" and len(args) >= 4 {
    result = plan(args[1], Events.pointer_event(number_arg(args, 2), number_arg(args, 3)));
} else if action == "plan-delta" and len(args) >= 4 {
    result = plan(args[1], Events.pointer_delta_event(number_arg(args, 2), number_arg(args, 3)));
} else if action == "plan-click" and len(args) >= 3 {
    result = plan(args[1], Events.click_event(number_arg(args, 2)));
} else if action == "demo" {
    let device = Events.new_device(800, 600, map{ max_events: 8, max_text: 32 });
    result = Events.replay(device, [
        Events.pointer_event(40, 50).event, Events.pointer_delta_event(2, 3).event,
        Events.click_event(1).event, Events.type_event("PBLang").event
    ]);
} else {
    usage(2);
}

print json_stringify(result);
if not (try result.ok catch true) { os_exit(1); }
