// Explicit UNO R4 WiFi device route; no discovery, implicit flash, or port guessing.
let Files=import("../examples/uno_r4_led_studio/device_files.sapp");
let Host=import("../examples/uno_r4_led_studio/device_host.sapp");
let raw=try env_get("PBLANG_SCRIPT_ARGS") catch "";
let args=[];if type(raw)=="string" and raw!="" {args=str_split(raw,"\n");}
if len(args)<4 {
    print "From the PBLang package root: pblang run tools/pbleddevice.sapp --allow-all -- export ABS_PROJECT_JSON ABS_NEW_SKETCH_DIR REPEATS";
    print "Or: ... -- play|stop|status ABS_PROJECT_JSON /dev/ttyACM<N> REPEATS --confirm-uno-r4-wifi";
    throw "Explicit device arguments required.";
}
if not regex_match(args[3],"^[1-8]$") {throw "Repetitions must be 1..8 within the project duration/frame limits.";}
let repeats=parse_number(args[3]);let result=nil;
if args[0]=="export" and len(args)==4 {result=Files.publish(args[1],args[2],repeats);}
elif (args[0]=="play" or args[0]=="stop" or args[0]=="status") and len(args)==5 and args[4]=="--confirm-uno-r4-wifi" {
    let p=Files.project(args[1],repeats);result=Host.run(p,args[2],str_upper(args[0]),true);
}else {throw "Unsupported device operation or missing confirmation.";}
print json_stringify(result);if not result.ok {throw "Device operation not confirmed; inspect the reported state.";}
