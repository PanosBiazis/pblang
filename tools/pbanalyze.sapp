// Opt-in selectable source analyses. This tool is not part of the default build
// path; default build security is provided by stdlib:security_analysis.sapp.

let ANALYSIS = import("stdlib:source_analysis.sapp");
let SECURITY = import("stdlib:security_analysis.sapp");
let DEP_SECURITY = import("stdlib:security_dependency_analysis.sapp");
let OS = import("stdlib:os.sapp");

fn contains(values, wanted) {
    let i = 0; while i < len(values) { if str_lower(str(values[i])) == wanted or str_lower(str(values[i])) == "all" { return true; } i = i + 1; }
    return false;
}

fn main() {
    let args = OS.script_args();
    let paths = []; let names = ["security"]; let config_path = "";
    let fail_on_findings = false; let max_findings = 256; let entry_only = false;
    let project_root = ""; let i = 0;
    while i < len(args) {
        let arg = args[i];
        if str_starts_with(arg, "--analysis=") { names = str_split(str_slice(arg, 11, len(arg)), ","); }
        elif str_starts_with(arg, "--config=") { config_path = str_slice(arg, 9, len(arg)); }
        elif str_starts_with(arg, "--max-findings=") { max_findings = try parse_number(str_slice(arg, 15, len(arg))) catch 256; }
        elif arg == "--fail-on-findings" { fail_on_findings = true; }
        elif arg == "--entry-only" { entry_only = true; }
        elif str_starts_with(arg, "--project-root=") { project_root = str_slice(arg, 15, len(arg)); }
        elif str_starts_with(arg, "--") { print "pbanalyze: unknown option " + arg; os_exit(2); }
        else { array_push(paths, arg); }
        i = i + 1;
    }
    if len(paths) != 1 {
        print "usage: pbanalyze SOURCE [--analysis=security,quality,performance,completeness,roadmap|all] [--config=FILE] [--fail-on-findings] [--entry-only] [--project-root=DIR]";
        os_exit(2);
    }
    let security = map{ minimum_blocking_severity: "high" };
    if config_path != "" {
        let loaded = SECURITY.load_config(config_path);
        if not loaded.ok { print json_stringify(loaded); os_exit(2); }
        security = loaded.value;
        if not map_has(security, "minimum_blocking_severity") { security.minimum_blocking_severity = "high"; }
    }
    if contains(names, "security") {
        let policy_check = if entry_only { SECURITY.validate_policy(security) }
            else { DEP_SECURITY.validate_policy(map{ security: security, security_mode: "protect" }) };
        if not policy_check.ok { print json_stringify(policy_check); os_exit(2); }
    }
    let bytes = try fs_read_bytes(paths[0]) catch nil;
    if type(bytes) != "array" or len(bytes) > 16777216 {
        print json_stringify(map{ ok: false, error: "source is unavailable or exceeds byte limit" }); os_exit(2);
    }
    let source = try bytes_to_str(bytes) catch nil;
    if source == nil { print json_stringify(map{ ok: false, error: "source is not valid UTF-8" }); os_exit(2); }
    let dependency_report = nil;
    if contains(names, "security") and not entry_only {
        let dep_options = map{ security: security, security_mode: "protect", entry_source: source };
        if project_root != "" { dep_options.project_root = project_root; }
        dependency_report = DEP_SECURITY.analyze_entry(paths[0], dep_options);
    }
    let report = ANALYSIS.analyze(source, paths[0], map{
        analyses: names, security: security, max_findings: max_findings,
        security_report: dependency_report, fail_on_findings: fail_on_findings
    });
    report.security_scope = if entry_only { "entry" } else { "dependencies" };
    print json_stringify(report);
    if not report.passed { os_exit(1); }
}

main();
