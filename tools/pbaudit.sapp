// tools/pbaudit.sapp -- bounded safe-text project audit CLI.
//
// Usage:
//   pblang run tools/pbaudit.sapp --project=pbide .
//   pblang run tools/pbaudit.sapp --project=pbai --max-files=80 --backlog-limit=24 ../pbai
//
// This reads only capped text-like files from caller-approved roots, skips
// sensitive/cache/build paths, and prints summaries without echoing raw lines.

let TA = import("stdlib:project_text_audit.sapp");

fn user_args() {
    let a = os_args();
    let out = [];
    let i = 0;
    let seen = false;
    while i < len(a) {
        let tok = a[i];
        if not seen {
            if str_ends_with(tok, "pbaudit.sapp") { seen = true; }
            i = i + 1;
            continue;
        }
        if not str_starts_with(tok, "--allow") { array_push(out, tok); }
        i = i + 1;
    }
    return out;
}

fn _num_after_prefix(arg, prefix, fallback) {
    if str_starts_with(arg, prefix) {
        let raw = str_slice(arg, len(prefix), len(arg));
        let n = try parse_number(raw) catch fallback;
        if n == nil { return fallback; }
        return n;
    }
    return fallback;
}

fn _value_after_prefix(arg, prefix, fallback) {
    if str_starts_with(arg, prefix) { return str_slice(arg, len(prefix), len(arg)); }
    return fallback;
}

let args = user_args();
let roots = [];
let project = "pblang";
let max_depth = 4;
let max_entries = 1200;
let max_children = 160;
let max_files = 120;
let max_file_bytes = 20000;
let max_findings = 160;
let backlog_limit = 12;
let lines_limit = 20;
let source_only_blockers = true;

let i = 0;
while i < len(args) {
    let a = args[i];
    if a == "--help" or a == "-h" {
        print "pbaudit: bounded safe-text project audit";
        print "usage: pblang run tools/pbaudit.sapp [--project=name] [--source-gate|--strict-gate] [--max-depth=N] [--max-files=N] [--max-file-bytes=N] [--max-findings=N] [--backlog-limit=N] [--lines=N] [roots...]";
        os_exit(0);
    } else if str_starts_with(a, "--project=") {
        project = _value_after_prefix(a, "--project=", project);
    } else if a == "--source-gate" {
        source_only_blockers = true;
    } else if a == "--strict-gate" {
        source_only_blockers = false;
    } else if str_starts_with(a, "--max-depth=") {
        max_depth = _num_after_prefix(a, "--max-depth=", max_depth);
    } else if str_starts_with(a, "--max-entries=") {
        max_entries = _num_after_prefix(a, "--max-entries=", max_entries);
    } else if str_starts_with(a, "--max-children=") {
        max_children = _num_after_prefix(a, "--max-children=", max_children);
    } else if str_starts_with(a, "--max-files=") {
        max_files = _num_after_prefix(a, "--max-files=", max_files);
    } else if str_starts_with(a, "--max-file-bytes=") {
        max_file_bytes = _num_after_prefix(a, "--max-file-bytes=", max_file_bytes);
    } else if str_starts_with(a, "--max-findings=") {
        max_findings = _num_after_prefix(a, "--max-findings=", max_findings);
    } else if str_starts_with(a, "--backlog-limit=") {
        backlog_limit = _num_after_prefix(a, "--backlog-limit=", backlog_limit);
    } else if str_starts_with(a, "--lines=") {
        lines_limit = _num_after_prefix(a, "--lines=", lines_limit);
    } else if not str_starts_with(a, "--") {
        array_push(roots, a);
    }
    i = i + 1;
}

if len(roots) == 0 { roots = ["."]; }

let report = TA.audit_roots(project, roots, map{
    max_depth: max_depth,
    max_entries: max_entries,
    max_children_per_dir: max_children,
    max_files: max_files,
    max_file_bytes: max_file_bytes,
    max_findings: max_findings,
    suppress_test_fixtures: true,
    source_only_blockers: source_only_blockers,
    backlog_limit: backlog_limit
});

let lines = TA.audit_lines(report, lines_limit);
let j = 0;
while j < len(lines) {
    print lines[j];
    j = j + 1;
}

if report.quality_gate.passed != true { os_exit(1); }
