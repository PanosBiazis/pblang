// Standalone, bounded PBLang source security analysis.
// Usage: pblang run tools/pbsecure.sapp -- SOURCE [options]
// Options: --mode=audit|protect|strict --config=FILE --disable-rule=ID
//          --allow-high-suppressions --entry-only --project-root=DIR
//          --json-output=FILE

let SECURITY = import("stdlib:security_analysis.sapp");
let DEP_SECURITY = import("stdlib:security_dependency_analysis.sapp");
let SECURE_FILE = import("stdlib:secure_file.sapp");
let PATH = import("stdlib:path.sapp");
let OS = import("stdlib:os.sapp");
let MAX_REPORT_BYTES = 67108864;
let MAX_OUTPUT_PATH_BYTES = 4096;

fn _valid_output_path(path) {
    return type(path) == "string" and path != "" and len(path) <= MAX_OUTPUT_PATH_BYTES
        and not str_contains(path, strfromcharcode(0)) and not str_contains(path, "\n")
        and not str_contains(path, "\r") and not str_ends_with(path, "/")
        and not str_ends_with(path, "\\");
}

fn _normalized(path) { return PATH.normalize(PATH.absolute(path)); }

fn _same_path(left, right) {
    if left == "" or right == "" { return false; }
    let normalized_left = _normalized(left);
    let normalized_right = _normalized(right);
    let host = OS.platform();
    if host == "windows" or host == "macos" {
        normalized_left = str_lower(normalized_left);
        normalized_right = str_lower(normalized_right);
    }
    return normalized_left == normalized_right;
}

fn _publish(report, output, status) {
    let encoded = json_stringify(report);
    if output == "" { print encoded; os_exit(status); }
    let payload = encoded + "\n";
    if len(str_to_bytes(payload)) > MAX_REPORT_BYTES { os_exit(2); }
    if not SECURE_FILE.write_text_new_exclusive(output, payload, false, false).ok { os_exit(2); }
    os_exit(status);
}

fn _verify_entry_snapshot(path, expected_sha256) {
    let current = SECURE_FILE.read_text(path, 16777216, false);
    if not current.ok {
        return map{ ok: false, stable: false, error: "cannot securely reread entry source" };
    }
    let actual = sha256(current.text);
    return map{ ok: true, stable: actual == expected_sha256,
        expected_sha256: expected_sha256, actual_sha256: actual };
}

fn _verify_config_snapshot(path, expected_sha256) {
    let current = SECURITY.load_config(path);
    if not current.ok {
        return map{ ok: false, stable: false, error: "cannot securely reread security config" };
    }
    return map{ ok: true, stable: current.sha256 == expected_sha256,
        expected_sha256: expected_sha256, actual_sha256: current.sha256 };
}

fn _reject_without_output(message, output) {
    if output == "" { print json_stringify(map{ ok: false, passed: false, error: message }); }
    os_exit(2);
}

fn _collides_with_report(output, report) {
    if _same_path(output, try report.entry catch "") { return true; }
    let modules = try report.modules catch [];
    if type(modules) != "array" { return true; }
    let i = 0;
    while i < len(modules) {
        if _same_path(output, try modules[i].path catch "") { return true; }
        i = i + 1;
    }
    return false;
}

fn main() {
    let args = OS.script_args();
    let json_output = ""; let output_count = 0; let pre = 0;
    while pre < len(args) {
        if str_starts_with(args[pre], "--json-output=") {
            output_count = output_count + 1;
            if output_count == 1 { json_output = str_slice(args[pre], 14, len(args[pre])); }
        }
        pre = pre + 1;
    }
    if output_count > 1 or (output_count == 1 and not _valid_output_path(json_output)) { os_exit(2); }
    let positional = [];
    let mode = "strict";
    let config_path = "";
    let disabled = [];
    let allow_high = false;
    let entry_only = false;
    let project_root = "";
    let i = 0;
    while i < len(args) {
        let arg = args[i];
        if str_starts_with(arg, "--mode=") { mode = str_lower(str_slice(arg, 7, len(arg))); }
        elif str_starts_with(arg, "--config=") { config_path = str_slice(arg, 9, len(arg)); }
        elif str_starts_with(arg, "--disable-rule=") { array_push(disabled, str_slice(arg, 15, len(arg))); }
        elif arg == "--allow-high-suppressions" { allow_high = true; }
        elif arg == "--entry-only" { entry_only = true; }
        elif str_starts_with(arg, "--project-root=") { project_root = str_slice(arg, 15, len(arg)); }
        elif str_starts_with(arg, "--json-output=") { }
        elif str_starts_with(arg, "--") {
            _publish(map{ ok: false, passed: false, error: "unknown option" }, json_output, 2);
        }
        else { array_push(positional, arg); }
        i = i + 1;
    }
    if len(positional) != 1 or (mode != "audit" and mode != "protect" and mode != "strict") {
        _publish(map{ ok: false, passed: false,
            error: "usage: pbsecure SOURCE [--mode=audit|protect|strict] [--config=FILE] [--disable-rule=ID] [--entry-only] [--project-root=DIR] [--json-output=FILE]" },
            json_output, 2);
    }
    if _same_path(json_output, positional[0]) or _same_path(json_output, config_path) {
        _reject_without_output("report output collides with an input", json_output);
    }
    let policy = map{};
    let config_sha256 = "";
    if config_path != "" {
        let loaded = SECURITY.load_config(config_path);
        if not loaded.ok { _publish(loaded, json_output, 2); }
        policy = loaded.value;
        config_sha256 = loaded.sha256;
    }
    let configured_disabled = try policy.disabled_rule_ids catch [];
    // Dependency policy resolves nil as unset; direct pattern policy does not.
    // Other malformed values must not be silently repaired into a valid array.
    if configured_disabled == nil and not entry_only { configured_disabled = []; }
    if type(configured_disabled) == "array" {
        i = 0; while i < len(disabled) { array_push(configured_disabled, disabled[i]); i = i + 1; }
        policy.disabled_rule_ids = configured_disabled;
    }
    if allow_high { policy.allow_high_suppressions = true; }
    policy.minimum_blocking_severity = if mode == "strict" { "info" } else { "high" };

    let policy_check = if entry_only { SECURITY.validate_policy(policy) }
        else { DEP_SECURITY.validate_policy(map{ security: policy, security_mode: mode }) };
    if not policy_check.ok {
        policy_check.passed = false;
        if config_path != "" {
            policy_check.config_snapshot_verification = _verify_config_snapshot(config_path, config_sha256);
        }
        _publish(policy_check, json_output, 2);
    }

    let loaded_source = SECURE_FILE.read_text(positional[0], 16777216, false);
    if not loaded_source.ok {
        _publish(map{ ok: false, passed: false, error: "cannot securely read source" }, json_output, 2);
    }
    let source = loaded_source.text;
    let source_sha256 = sha256(source);
    let report = nil;
    if entry_only {
        report = SECURITY.analyze(source, positional[0], policy);
        report.scope = "entry"; report.dependency_wide = false; report.semantic_complete = false;
    } else {
        let dependency_options = map{ security: policy, security_mode: mode, entry_source: source };
        if project_root != "" { dependency_options.project_root = project_root; }
        report = DEP_SECURITY.analyze_entry(positional[0], dependency_options);
        report.scope = "dependencies";
    }
    report.mode = mode;
    report.enforced = mode != "audit";
    if mode == "audit" and entry_only { report.passed = report.ok; report.blocking = 0; }
    if entry_only {
        let snapshot = _verify_entry_snapshot(positional[0], source_sha256);
        report.snapshot_verification = snapshot;
        if not snapshot.ok or not snapshot.stable {
            report.passed = false; report.blocking = (try report.blocking catch 0) + 1;
        }
    } else {
        let snapshot = DEP_SECURITY.verify_snapshot(report);
        report.snapshot_verification = snapshot;
        if not snapshot.ok or not snapshot.stable {
            report.passed = false; report.blocking = (try report.blocking catch 0) + 1;
        }
    }
    if config_path != "" {
        let config_snapshot = _verify_config_snapshot(config_path, config_sha256);
        report.config_snapshot_verification = config_snapshot;
        if not config_snapshot.ok or not config_snapshot.stable {
            report.passed = false; report.blocking = (try report.blocking catch 0) + 1;
        }
    }
    if json_output != "" and _collides_with_report(json_output, report) {
        _reject_without_output("report output collides with analyzed source", json_output);
    }
    _publish(report, json_output, if report.passed { 0 } else { 1 });
}

main();
