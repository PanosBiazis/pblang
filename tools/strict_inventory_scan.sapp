// Run one bounded, metadata-only Linux inventory shard and emit path-free JSON.
// Supervised execution links this complete import graph into one immutable
// in-memory source snapshot and then denies runtime imports in the child.
let INV = import("stdlib:project_inventory.sapp");

fn _exact_bool(record, key, expected) {
    if type(record) != "map" or not map_has(record, key) { return false; }
    let value = record[key];
    return type(value) == "bool" and value == expected;
}

fn _exact_pass_count(record) {
    if type(record) != "map" or not map_has(record, "passes_completed") { return 0; }
    let value = record.passes_completed;
    if type(value) != "number" or value != num_floor(value)
       or value < 0 or value > 2 { return 0; }
    return value;
}

let raw = try env_get("PBLANG_SCRIPT_ARGS") catch "";
let args = if raw == nil or raw == "" { [] } else { str_split(raw, "\n") };
if len(args) != 1 or type(args[0]) != "string" or not str_starts_with(args[0], "/") {
    throw "strict_inventory_scan: exactly one absolute scan root is required";
}

let report = INV.inventory_admitted_root_stability(args[0], map{
    max_depth: 1, max_entries: 512, max_children_per_dir: 128,
    include_files: true, include_dirs: true, max_runtime_ms: 5000
});
let kinds = map{ file: 0, directory: 0, symlink: 0, error: 0 };
for record in try report.records catch [] {
    let kind = try record.kind catch "error";
    if map_has(kinds, kind) { kinds[kind] = kinds[kind] + 1; }
    else { kinds.error = kinds.error + 1; }
}
let error_codes = map{};
for row in try report.errors catch [] {
    let code = str(try row.code catch "unknown-error");
    error_codes[code] = (try error_codes[code] catch 0) + 1;
}
let admission_blockers = [];
if not _exact_bool(report, "complete", true) { array_push(admission_blockers, "inventory is incomplete"); }
if not _exact_bool(report, "truncated", false) { array_push(admission_blockers, "inventory is truncated"); }
if not _exact_bool(report, "timed_out", false) { array_push(admission_blockers, "inventory timeout state is unsafe"); }
if not _exact_bool(report, "hard_heap_bound", true) {
    array_push(admission_blockers, "hard heap enforcement is absent");
}
if not _exact_bool(report, "hard_wall_timeout", true) {
    array_push(admission_blockers, "hard wall-clock preemption is absent");
}
if not _exact_bool(report, "snapshot_consistent", true) {
    array_push(admission_blockers, "namespace snapshot consistency is not verified");
}
if not _exact_bool(report, "two_pass_stability_observed", true) {
    array_push(admission_blockers, "two-pass namespace stability was not observed");
}
if not _exact_bool(report, "observation_inconclusive", false) {
    array_push(admission_blockers, "namespace observation is inconclusive");
}
if not _exact_bool(report, "held_root_vfs_policy_admitted", true) {
    array_push(admission_blockers, "held root direct VFS type is not admitted");
}
if not _exact_bool(report, "mount_binding_rechecked", true) {
    array_push(admission_blockers, "held root mount binding was not rechecked");
}
let summary = map{
    format: "pblang.project_inventory.path-free-scan-evidence.v1",
    ok: _exact_bool(report, "ok", true),
    record_count: try report.record_count catch 0,
    scanned_dirs: try report.scanned_dirs catch 0,
    scanned_entries: try report.scanned_entries catch 0,
    skipped_count: try report.skipped_count catch 0,
    kinds: kinds, error_codes: error_codes,
    complete: _exact_bool(report, "complete", true),
    truncated: _exact_bool(report, "truncated", true),
    timed_out: _exact_bool(report, "timed_out", true),
    duration_ms: try report.duration_ms catch 0,
    directory_enumerator_allocation_bounded:
        _exact_bool(report, "directory_enumerator_allocation_bounded", true),
    stay_on_device_enforced: _exact_bool(report, "stay_on_device_enforced", true),
    entry_kind_tristate_enforced: _exact_bool(report, "entry_kind_tristate_enforced", true),
    snapshot_consistent: _exact_bool(report, "snapshot_consistent", true),
    two_pass_stability_observed: _exact_bool(report, "two_pass_stability_observed", true),
    namespace_change_observed: _exact_bool(report, "namespace_change_observed", true),
    observation_inconclusive: _exact_bool(report, "observation_inconclusive", true),
    held_root_vfs_policy_admitted: _exact_bool(report, "held_root_vfs_policy_admitted", true),
    mount_binding_rechecked: _exact_bool(report, "mount_binding_rechecked", true),
    direct_vfs_type_allowlisted: _exact_bool(report, "direct_vfs_type_allowlisted", true),
    direct_virtual_vfs_type_rejected: _exact_bool(report, "direct_virtual_vfs_type_rejected", true),
    direct_network_vfs_type_rejected: _exact_bool(report, "direct_network_vfs_type_rejected", true),
    direct_fuse_vfs_type_rejected: _exact_bool(report, "direct_fuse_vfs_type_rejected", true),
    unknown_vfs_type_rejected: _exact_bool(report, "unknown_vfs_type_rejected", true),
    backing_storage_locality_verified: false,
    trusted_mount_namespace_verified: false,
    procfs_authenticity_verified: false,
    corroborating_source: false,
    passes_completed: _exact_pass_count(report),
    hard_wall_timeout: _exact_bool(report, "hard_wall_timeout", true),
    total_wall_runtime_bounded: _exact_bool(report, "total_wall_runtime_bounded", true),
    hard_heap_bound: _exact_bool(report, "hard_heap_bound", true),
    idea_admission_eligible: false,
    idea_admission_blockers: admission_blockers,
    one_root_per_process: true, shard_root_count: 1,
    contains_absolute_paths: false, contains_records: false,
    enumerator_closed: _exact_bool(report, "enumerator_closed", true),
    contains_traversal_tokens: false, contains_content_tokens: false,
    contains_mount_identity: false, contains_filesystem_type: false,
    root_bound: (try report.format catch "") == "pblang.project_inventory.stability-report.v1"
        and _exact_bool(report, "ok", true)
        and _exact_bool(report, "enumerator_closed", true)
        and _exact_bool(report, "contains_absolute_paths", false)
        and _exact_bool(report, "contains_traversal_tokens", false)
        and _exact_bool(report, "contains_mount_identity", false)
        and _exact_bool(report, "contains_filesystem_type", false)
        and _exact_bool(report, "held_root_vfs_policy_admitted", true)
        and _exact_bool(report, "mount_binding_rechecked", true),
    safe_to_log: false,
    ffi_symbol_contract_verified: false, production_ready: false
};
print json_stringify(summary);
