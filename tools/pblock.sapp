// Make a bootstrap-generated pblang.lock portable without changing its hashes.
let LOCK = import("stdlib:portable_lock.sapp");

let raw = try env_get("PBLANG_SCRIPT_ARGS") catch "";
let args = [];
if raw != nil and raw != "" { args = str_split(raw, "\n"); }
let project = ".";
if len(args) > 0 and str_trim(args[0]) != "" { project = str_trim(args[0]); }
let result = LOCK.publish(project);
print "portable lock: " + result.path + " (" + str(result.rewritten) + " local dependencies)";
