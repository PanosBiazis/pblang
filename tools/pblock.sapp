// Make a bootstrap-generated pblang.lock portable without changing its hashes.
let LOCK = import("stdlib:portable_lock.sapp");

// Keep the actual argument boundaries and literal directory identity. The
// newline-encoded environment channel cannot represent every directory name.
let raw = os_args();
let args = [];
let after_separator = false;
for arg in raw {
    if after_separator { array_push(args, arg); }
    elif arg == "--" { after_separator = true; }
}
if len(args) > 1 or (len(args) == 1 and args[0] == "") {
    throw "pblock: expected zero or one nonempty project directory after --";
}
let project = if len(args) == 0 { "." } else { args[0] };
if str_contains(project, "\n") or str_contains(project, "\r") or str_contains(project, "\x00") {
    throw "pblock: project directory contains an unsupported control character";
}
let result = LOCK.publish(project);
print "portable lock: " + result.path + " (" + str(result.rewritten) + " local dependencies)";
