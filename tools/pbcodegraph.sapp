// tools/pbcodegraph.sapp — one-command CODE knowledge-graph builder for a pblang project.
//
//   pblang run tools/pbcodegraph.sapp <project-dir> [--out <dir>]
//
// Recursively scans <project-dir> for .sapp source, extracts each file's structure (functions, imports,
// exports) with stdlib/code_graph.sapp, builds the MODULE import graph, and writes CODE_REPORT.md +
// code_graph.json into <out> (default: <project-dir>/graphify-out). This is graphify pointed at CODE — it
// reads and understands a project's architecture (which modules exist, how they depend on each other, which
// are the hubs) instead of markdown notes. Uses raw fs_* builtins so absolute paths work in one command.

let cg = import("stdlib/code_graph.sapp");
let kg = import("stdlib/knowledge_graph.sapp");

fn _has_suffix(f, ext) {
    if len(f) <= len(ext) { return false; }
    return str_slice(f, len(f) - len(ext), len(f)) == ext;
}
fn _is_flag(arg) { return len(arg) > 0 and strcharcodeat(arg, 0) == 45; }
fn _has_dot(name) { let i = 0; while i < len(name) { if strcharcodeat(name, i) == 46 { return true; } i = i + 1; } return false; }
// noise directories we never want in a code graph (VCS, build output, other graphs, deps)
fn _skip_dir(name) {
    return name == "graphify-out" or name == ".git" or name == "target" or name == "node_modules"
        or name == "trash" or name == ".obsidian";
}

// Recursively collect every .sapp file under `dir` into `acc` (path → source). `cnt` is a 1-element array
// used as a shared mutable counter + cap (avoids rebuilding map_keys(acc) every step — that was O(n^2)).
// fs_listdir throws on a file and succeeds on a directory, so try/catch tells the two apart (no fs_is_dir).
fn walk(dir, acc, cnt, cap) {
    if cnt[0] >= cap { return nil; }
    let entries = try fs_listdir(dir) catch nil;
    if entries == nil { return nil; }
    let i = 0;
    while i < len(entries) {
        if cnt[0] >= cap { return nil; }
        let name = entries[i];
        let path = dir + "/" + name;
        // .sapp → a source file. Extensionless names are the only ones we probe as directories — this avoids
        // a throwing fs_listdir on every one of the (many, big) non-source files, which was the bottleneck.
        if _has_suffix(name, ".sapp") {
            acc[path] = bytes_to_str(fs_read_bytes(path));
            cnt[0] = cnt[0] + 1;
        } elif not _has_dot(name) and not _skip_dir(name) {
            let sub = try fs_listdir(path) catch nil;
            if sub != nil { walk(path, acc, cnt, cap); }
        }
        i = i + 1;
    }
    return nil;
}

fn main() {
    let a = os_args();
    let dir = "."; let out = nil; let calls = false; let i = 0;
    while i < len(a) {
        let arg = a[i];
        if arg == "--out" and i + 1 < len(a) { out = a[i + 1]; i = i + 1; }
        elif arg == "--calls" { calls = true; }
        elif not _is_flag(arg) and arg != "run" and not _has_suffix(arg, ".sapp") { dir = arg; }
        i = i + 1;
    }
    if out == nil { out = dir + "/graphify-out"; }

    let files = map{};
    let cnt = [0];
    walk(dir, files, cnt, 5000);
    let paths = map_keys(files);
    if len(paths) == 0 { print "pbcodegraph: no .sapp files found under '" + dir + "'"; return nil; }

    let analyses = cg.analyze_all(files);           // scan each file exactly once
    let g = cg.module_graph(analyses);
    fs_mkdirs(out);
    fs_write(out + "/CODE_REPORT.md", cg.report(analyses));
    fs_write(out + "/code_graph.json", kg.to_json(g));
    print "pbcodegraph: " + str(len(paths)) + " .sapp files → " + out + "/CODE_REPORT.md + code_graph.json";
    print "";
    print cg.report(analyses);
    // --calls: also build the function-level CALL graph (which fn calls which) — the deeper view.
    if calls {
        let cr = cg.call_report(files);
        fs_write(out + "/CALL_REPORT.md", cr);
        print "";
        print cr;
    }
    return nil;
}

main();
