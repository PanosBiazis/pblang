// No imports or host effects: this policy runs under --sandbox before dispatch.
// The Linux launcher supplies exactly one prefixed token, never a joined argv.
let args = os_args();
if len(args) != 5 or args[0] != "run" or args[2] != "--sandbox" or args[3] != "--" {
    throw "pblang launcher: invalid guard invocation";
}
let command = args[4];
if command != "no-command" and not str_starts_with(command, "command:") {
    throw "pblang launcher: invalid command token";
}
// Both clap and legacy native bundle dispatch require the first token 'bundle'.
// Deny every destination and flag shape, including --self-extract and --help.
if command == "command:bundle" {
    throw "pblang: native bundle is disabled because it can truncate source files. Use tools/pbpackage.sapp for its supported source-folder subset, or tools/pbc.sapp --bundle --target pbck with a fresh, separate output for its supported compiler subset. See docs/NATIVE_BUNDLE_SOURCE_INTEGRITY.md. The retained native binary is not repaired.";
}
print "pblang-launch-admit-v1";
