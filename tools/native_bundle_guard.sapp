// Linux launcher policy and explicit self-hosted check adapter.
// Admission runs under --sandbox: it never imports or reads a source file.
// The execution phase reuses this parser under the caller's runtime permissions.
fn capability_option(value) {
    if value == "--allow-all" or value == "--sandbox" { return true; }
    for name in ["exec", "ffi", "net", "fs", "http", "sqlite", "spawn", "gfx", "env", "import"] {
        if value == "--allow-" + name or value == "--deny-" + name { return true; }
    }
    return false;
}

fn classify(argv) {
    if len(argv) == 0 { return map{ action: "native" }; }
    if argv[0] == "bundle" {
        throw "pblang: native bundle is disabled because it can truncate source files. Use tools/pbpackage.sapp for its supported source-folder subset, or tools/pbc.sapp --bundle --target pbck with a fresh, separate output for its supported compiler subset. See docs/NATIVE_BUNDLE_SOURCE_INTEGRITY.md. The retained native binary is not repaired.";
    }
    // Only a leading check selector (optionally after capabilities) opts in.
    // Never interpret arguments of run/check/fmt/test or a bare script as ours.
    let start = 0;
    while start < len(argv) and capability_option(argv[start]) { start = start + 1; }
    if start == len(argv) { return map{ action: "native" }; }
    if argv[start] != "--check" and argv[start] != "--via-pblang" and argv[start] != "--self-host" {
        return map{ action: "native" };
    }
    let check_seen = false; let via_seen = false;
    // The legacy handler scans even after '--'. Capture that ambiguous form,
    // then validate proper option boundaries before permitting any file access.
    for arg in argv {
        if arg == "--check" { check_seen = true; }
        if arg == "--via-pblang" or arg == "--self-host" { via_seen = true; }
    }
    if not check_seen or not via_seen { return map{ action: "native" }; }
    let options = true; let check_count = 0; let via_count = 0; let path = nil;
    for arg in argv {
        if options and arg == "--" { options = false; }
        elif options and arg == "--check" { check_count = check_count + 1; }
        elif options and (arg == "--via-pblang" or arg == "--self-host") { via_count = via_count + 1; }
        elif options and capability_option(arg) { }
        elif options and str_starts_with(arg, "--") { return map{ action: "usage" }; }
        elif path != nil or len(arg) == 0 { return map{ action: "usage" }; }
        else { path = arg; }
    }
    if check_count != 1 or via_count == 0 or path == nil { return map{ action: "usage" }; }
    return map{ action: "check", path: path };
}

let raw = os_args();
if len(raw) < 2 or raw[0] != "run" { throw "pblang launcher: invalid guard invocation"; }
let admission = len(raw) >= 5 and raw[2] == "--sandbox" and raw[3] == "--"
    and raw[4] == "pblang-launch-argv-v2";
let offset = if admission { 5 } else { 2 };
let argv = []; while offset < len(raw) { array_push(argv, raw[offset]); offset = offset + 1; }
let route = classify(argv);
if admission {
    if route.action == "native" { print "pblang-launch-admit-v1"; }
    elif route.action == "check" { print "pblang-launch-check-v1"; }
    else { print "pblang-launch-check-usage-v1"; }
} else {
    if route.action != "check" { throw "pblang launcher: invalid check adapter invocation"; }
    // This executes only after admission. The native run command processes the
    // original capabilities before '--', including environment and locked sandbox.
    let FRONTEND = import("stdlib:compiler/source_analysis.sapp");
    let source = try fs_read(route.path) catch nil;
    if source == nil { print "pblang --check: failed to read source file"; os_exit(1); }
    let result = FRONTEND.analyze(source, false);
    if not result.ok {
        print "self-hosted check failed: " + str(result.errors);
        if map_has(result, "error") { print result.error; }
        os_exit(1);
    }
    print "self-hosted check ok (stmts=" + str(result.stmt_count) + ", tokens=" + str(result.tokens_count) + ")";
}
