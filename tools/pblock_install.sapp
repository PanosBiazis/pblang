// Explicit local installation step. Run from the trusted installation root.
// Host-bound output must not be committed; use pblock.sapp for publication.
let LOCK = import("stdlib:portable_lock.sapp");

// Keep the actual argument boundaries and literal directory identity. The
// newline-encoded environment channel cannot represent every directory name.
let raw = os_args();
let args = [];
let after_separator = false;
for arg in raw {
    if after_separator { array_push(args, arg); }
    elif arg == "--" { after_separator = true; }
}
if len(args) != 1 or args[0] == "" {
    throw "pblock_install: exactly one nonempty installed project directory is required after --";
}
let project = args[0];
if str_contains(project, "\n") or str_contains(project, "\r") or str_contains(project, "\x00") {
    throw "pblock_install: project directory contains an unsupported control character";
}
let result = LOCK.install(project);
print "installed dependency lock: " + str(result.rewritten) + " local dependencies; keep this file local";
