// Explicit local installation step. Run from the trusted installation root.
// Host-bound output must not be committed; use pblock.sapp for publication.
let LOCK=import("stdlib:portable_lock.sapp");
let raw=env_get("PBLANG_SCRIPT_ARGS") ?? "";
let args=if raw=="" {[]} else {str_split(raw,"\n")};
if len(args)!=1 or str_trim(args[0])=="" {throw "pblock_install: exactly one installed project directory is required";}
let result=LOCK.install(args[0]);
print "installed dependency lock: "+str(result.rewritten)+" local dependencies; keep this file local";
