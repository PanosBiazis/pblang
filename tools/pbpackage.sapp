// Public PBLang-owned package route; never dispatches to native `pblang bundle`.
let Package=import("stdlib:package_folder.sapp");
let raw=try env_get("PBLANG_SCRIPT_ARGS") catch "";
let args=if raw==nil or raw=="" {[]} else {str_split(raw,"\n")};
if len(args)!=4 or args[2]!="--runtime" {
    print "usage: pblang run tools/pbpackage.sapp --allow-all -- SOURCE NEW_OUTPUT --runtime ELF_RUNTIME";
    throw "pbpackage: expected source, new output, and explicit runtime";
}
let result=Package.bundle(args[0],args[1],args[3]);
print json_stringify(result);
if not result.ok {throw "pbpackage: packaging not confirmed; inspect the reported destination state";}
