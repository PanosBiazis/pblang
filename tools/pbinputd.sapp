// pbinputd -- bounded authenticated native-X11 input service.
//
// Start explicitly:
//   PB_INPUT_DAEMON_ENABLE=1 PB_INPUT_DAEMON_TOKEN=<32+ chars> \
//     pblang tools/pbinputd.sapp --allow-ffi
// It binds only to loopback. Each process lifetime accepts a finite request
// quota and then exits for supervisor-controlled restart/key rotation.

let Daemon = import("stdlib:input_daemon.sapp");
let X11 = import("stdlib:x11_input.sapp");

let enabled = try env_get("PB_INPUT_DAEMON_ENABLE") catch "";
if enabled != "1" and enabled != "true" { throw "pbinputd: explicit PB_INPUT_DAEMON_ENABLE=1 is required"; }

let token = try env_get("PB_INPUT_DAEMON_TOKEN") catch "";
if type(token) != "string" or len(token) < 32 { throw "pbinputd: PB_INPUT_DAEMON_TOKEN must contain at least 32 characters"; }

let addr = try env_get("PB_INPUT_DAEMON_ADDR") catch "127.0.0.1:47652";
if addr == nil or addr == "" { addr = "127.0.0.1:47652"; }
let max_requests = try parse_number(env_get("PB_INPUT_DAEMON_MAX_REQUESTS")) catch 1024;
if max_requests < 1 or max_requests > 1000000 or num_floor(max_requests) != max_requests {
    throw "pbinputd: PB_INPUT_DAEMON_MAX_REQUESTS must be an integer in 1..1000000";
}

let host = X11.available();
if not host.ok { throw "pbinputd: trusted native X11/XTest backend is unavailable"; }

let state = Daemon.new_state(token, map{ max_requests: max_requests, max_frame_chars: 16384 });
print json_stringify(map{ format: "pblang.input-daemon.ready.v1", address: addr,
                          backend: "pblang-x11-xtest", max_requests: max_requests });

let result = Daemon.serve(addr, state, fn(event) { return X11.execute(event); });
print json_stringify(result);
