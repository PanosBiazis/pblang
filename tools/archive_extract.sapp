// Opt-in local CLI: verify the whole ZIP, extract one regular member to a new file.
// Empty selected members require ZIP STORE; directory extraction is unsupported.
let Publication=import("stdlib:archive_publication.sapp");
let Dir=import("stdlib:linux_dirfs.sapp");
let OS=import("stdlib:os.sapp");
fn fail(code,message) {
    print json_stringify(map{ok:false,code:code,error:message,publication_attempted:false,
        metadata_only:true,safe_to_log:false});
    OS.exit(1);
}
let args=OS.script_args();
if len(args)!=4 or args[0]!="--extract" {
    fail("usage","Usage: archive_extract.sapp --extract INPUT.zip MEMBER NEW_FILE");
}
let input=args[1];
if platform()!="linux" or len(input)<1 or len(input)>4096 or len(str_to_bytes(input))>4096
    or str_contains(input,strfromcharcode(0)) or str_contains(input,"\\")
    or str_ends_with(input,"/") {
    fail("invalid_input","Choose a bounded local ZIP file on Linux.");
}
let parent=path_dirname(input); if parent=="" { parent="."; }
let fs=try { if str_starts_with(parent,"/") { Dir.open_absolute(parent,false,false) }
    else { Dir.open(parent,false,false) } } catch nil;
if fs==nil or not fs.ok { fail("input_unavailable","Input folder could not be opened securely."); }
let loaded=try Dir.read_bytes(fs,path_basename(input),4194304) catch nil;
let _closed=try Dir.close(fs) catch false;
if _closed and loaded!=nil and loaded.ok {
    let result=Publication.extract_member(args[3],loaded.bytes,args[2]);
    print json_stringify(result);
    if not result.ok { OS.exit(1); }
} else {
    fail("input_unavailable","Input could not be read completely with confirmed handle closure.");
}
