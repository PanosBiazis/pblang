// tools/pbmigrate.sapp -- PBLang-only migration manifest gate.
//
// Usage:
//   pblang run tools/pbmigrate.sapp examples/migration_policy_manifest.json
//   pblang run tools/pbmigrate.sapp --json manifest.json

let FS = import("stdlib:fs.sapp");
let POLICY = import("stdlib:migration_policy.sapp");

fn user_args() {
    let raw = os_args();
    let out = [];
    let i = 0;
    let seen_script = false;
    while i < len(raw) {
        let value = str(raw[i]);
        if not seen_script {
            if str_ends_with(value, "pbmigrate.sapp") { seen_script = true; }
            i = i + 1;
            continue;
        }
        if not str_starts_with(value, "--allow") { array_push(out, value); }
        i = i + 1;
    }
    return out;
}

let args = user_args();
let json_output = false;
let line_limit = 24;
let manifest_path = "";

fn _number_option(arg, prefix, fallback) {
    if not str_starts_with(arg, prefix) { return fallback; }
    let value = try parse_number(str_slice(arg, len(prefix), len(arg))) catch fallback;
    if value == nil or value < 4 or value > 200 { return fallback; }
    return value;
}

let i = 0;
while i < len(args) {
    let arg = str(args[i]);
    if arg == "--help" or arg == "-h" {
        print "pbmigrate: fail-closed PBLang-only change and migration gate";
        print "usage: pblang run tools/pbmigrate.sapp [--json] [--lines=N] <relative-manifest.json>";
        os_exit(0);
    } else if arg == "--json" {
        json_output = true;
    } else if str_starts_with(arg, "--lines=") {
        line_limit = _number_option(arg, "--lines=", line_limit);
    } else if str_starts_with(arg, "--") {
        print "pbmigrate: unknown option " + arg;
        os_exit(2);
    } else if manifest_path == "" {
        manifest_path = arg;
    } else {
        print "pbmigrate: only one manifest path is accepted";
        os_exit(2);
    }
    i = i + 1;
}

if manifest_path == "" {
    print "pbmigrate: a relative JSON manifest path is required";
    print "usage: pblang run tools/pbmigrate.sapp [--json] [--lines=N] <relative-manifest.json>";
    os_exit(2);
}

let manifest = try FS.read_json(manifest_path) catch nil;
if type(manifest) != "map" {
    print "pbmigrate: manifest could not be read as a JSON object";
    os_exit(2);
}

let report = POLICY.evaluate_manifest(manifest);
if json_output {
    print json_stringify(report);
} else {
    let lines = POLICY.report_lines(report, line_limit);
    let j = 0;
    while j < len(lines) {
        print lines[j];
        j = j + 1;
    }
}

if report.passed != true { os_exit(1); }
