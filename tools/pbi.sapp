// Run a local program through the PBLang-written tree interpreter.
// Usage: pblang run tools/pbi.sapp --allow-all -- PROGRAM [options]
// Optional developer budgets: --max-source-bytes=N --max-tokens=N
// No default source-size/token ceiling. Syntax checks remain mandatory. This
// local developer route is not a sandbox or a replacement for strict admission.
let ip = import("stdlib/compiler/interp.sapp");
let SOURCE = import("stdlib:compiler/checked_source.sapp");
let OS = import("stdlib:os.sapp");

fn _count(text) {
    if len(text) == 0 { return nil; }
    for ch in str_split(text, "") {
        let code = strcharcodeat(ch, 0);
        if code < 48 or code > 57 { return nil; }
    }
    return try parse_number(text) catch nil;
}

fn main() {
    let args = OS.script_args();
    let paths = []; let budget = map{};
    for arg in args {
        let key = ""; let value = "";
        if str_starts_with(arg, "--max-source-bytes=") {
            key = "max_source_bytes"; value = str_slice(arg, 19, len(arg));
        } elif str_starts_with(arg, "--max-tokens=") {
            key = "max_tokens"; value = str_slice(arg, 13, len(arg));
        } elif str_starts_with(arg, "--") {
            print "pbi: unknown option"; os_exit(2);
        } else { push(paths, arg); }
        if key != "" {
            if map_has(budget, key) { print "pbi: duplicate budget option"; os_exit(2); }
            let count = _count(value);
            if count == nil { print "pbi: invalid budget value"; os_exit(2); }
            budget[key] = count;
        }
    }
    if len(paths) != 1 {
        print "usage: pbi PROGRAM [--max-source-bytes=N] [--max-tokens=N]";
        os_exit(2);
    }
    let validated = try SOURCE.local_budget(budget) catch nil;
    if validated == nil { print "pbi: invalid budget value"; os_exit(2); }
    // This existing whole-file read is not a bounded streaming reader. The
    // optional source budget applies to admission after UTF-8 decoding.
    let src = bytes_to_str(fs_read_bytes(paths[0]));
    ip.eval_local_program(src, validated);
}
main();
