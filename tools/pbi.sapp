// tools/pbi.sapp — run a pblang program with the SELF-HOSTED interpreter: the tokenizer, parser, and
// evaluator are ALL written in pblang (stdlib/compiler/*.sapp), so this is pblang running pblang, with no
// Rust interpreter in the evaluation path (the Rust VM only hosts this driver; the language semantics are
// entirely pblang). Supported subset: let/const, fn (recursion + closures), if/elif/else, while, for×3,
// break/continue, print, arrays, maps, strings, +/-/*/// %, comparisons, and a curated builtin set.
//
//   pblang run tools/pbi.sapp <program.sapp>
//
// Compare `pblang run <program>` (Rust VM) with `pblang run tools/pbi.sapp <program>` (pblang-in-pblang) —
// they should print the same thing for any program in the supported subset.

let ip = import("stdlib/compiler/interp.sapp");

fn _is_flag(a) { return len(a) > 0 and strcharcodeat(a, 0) == 45; }

fn main() {
    // os_args() = ["run", "tools/pbi.sapp", "--allow-all", <program> ...]; drop "run" + flags, and the
    // first positional is this script, the second is the user's program file.
    let a = os_args();
    let pos = [];
    let i = 0;
    while i < len(a) { if a[i] != "run" and not _is_flag(a[i]) { push(pos, a[i]); } i = i + 1; }
    if len(pos) < 2 {
        print "usage: pblang run tools/pbi.sapp <program.sapp>";
        return nil;
    }
    let file = pos[1];
    let src = bytes_to_str(fs_read_bytes(file));
    ip.eval_program(src);
    return nil;
}

main();
