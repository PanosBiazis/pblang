// PBLang-native adaptive build CLI.
// Usage:
//   pblang run tools/pbbuild.sapp --allow-all -- SOURCE OUTPUT [options]
//   pblang run tools/pbbuild.sapp --allow-all -- --project DIR OUTPUT [options]
// Options: --goal=balanced|speed|size|debug|portable
//          --backend=auto|direct-x64|c99|pbck --target=NAME
//          --dry-run --no-cache --no-fallback --runtime-fallback

let BUILD = import("stdlib:build.sapp");
let OS = import("stdlib:os.sapp");

fn main() {
    let args = OS.script_args();
    let positional = [];
    let options = map{ goal: "balanced", backend: "auto", cache: true, fallback: true };
    let project = false;
    let dry_run = false;
    let i = 0;
    while i < len(args) {
        let arg = args[i];
        if arg == "--project" { project = true; }
        elif arg == "--dry-run" { dry_run = true; }
        elif arg == "--no-cache" { options.cache = false; }
        elif arg == "--no-fallback" { options.fallback = false; }
        elif arg == "--runtime-fallback" { options.runtime_fallback = true; }
        elif str_starts_with(arg, "--goal=") { options.goal = str_slice(arg, 7, len(arg)); }
        elif str_starts_with(arg, "--backend=") { options.backend = str_slice(arg, 10, len(arg)); }
        elif str_starts_with(arg, "--target=") { options.target = str_slice(arg, 9, len(arg)); }
        elif str_starts_with(arg, "--") {
            print "pbbuild: unknown option " + arg;
            os_exit(2);
        } else { array_push(positional, arg); }
        i = i + 1;
    }
    if len(positional) != 2 {
        print "usage: pbbuild [--project] SOURCE_OR_DIR OUTPUT [--goal=...] [--backend=...] [--dry-run]";
        os_exit(2);
    }
    let source = positional[0];
    let output = positional[1];
    if dry_run {
        if project {
            print json_stringify(map{ ok: true, project: source, output: output, note: "project entry resolves during execution", options: options });
        } else { print json_stringify(BUILD.smart_plan(source, output, options)); }
        return;
    }
    let report = if project { BUILD.smart_project(source, output, options) }
        else { BUILD.smart_build(source, output, options) };
    print json_stringify(report);
    if not report.ok { os_exit(1); }
}

main();
