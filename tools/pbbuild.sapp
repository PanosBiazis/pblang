// PBLang-native adaptive build CLI.
// Usage:
//   pblang run tools/pbbuild.sapp --allow-all -- SOURCE OUTPUT [options]
//   pblang run tools/pbbuild.sapp --allow-all -- --project DIR OUTPUT [options]
// Options: --goal=balanced|speed|size|debug|portable
//          --backend=auto|direct-x64|c99|pbck --target=NAME
//          --dry-run --no-cache --no-fallback --runtime-fallback
//          --security-mode=audit|protect|strict|off
//          --security-scope=dependencies|entry --no-security-analysis
//          --security-config=FILE --disable-security-rule=ID
//          --allow-high-security-suppressions

let BUILD = import("stdlib:build.sapp");
let OS = import("stdlib:os.sapp");
let SECURITY = import("stdlib:security_analysis.sapp");

fn main() {
    let args = OS.script_args();
    let positional = [];
    let options = map{ goal: "balanced", backend: "auto", cache: true, fallback: true };
    let project = false;
    let dry_run = false;
    let security_config_path = "";
    let disabled_security_rules = [];
    let security_mode_set = false;
    let i = 0;
    while i < len(args) {
        let arg = args[i];
        if arg == "--project" { project = true; }
        elif arg == "--dry-run" { dry_run = true; }
        elif arg == "--no-cache" { options.cache = false; }
        elif arg == "--no-fallback" { options.fallback = false; }
        elif arg == "--runtime-fallback" { options.runtime_fallback = true; }
        elif arg == "--no-security-analysis" { options.security_analysis = false; }
        elif arg == "--allow-high-security-suppressions" { options.security_allow_high_suppressions = true; }
        elif str_starts_with(arg, "--security-mode=") {
            options.security_mode = str_slice(arg, 16, len(arg)); security_mode_set = true;
        }
        elif str_starts_with(arg, "--security-scope=") {
            options.security_scope = str_slice(arg, 17, len(arg));
        }
        elif str_starts_with(arg, "--security-config=") { security_config_path = str_slice(arg, 18, len(arg)); }
        elif str_starts_with(arg, "--disable-security-rule=") {
            array_push(disabled_security_rules, str_slice(arg, 24, len(arg)));
        }
        elif str_starts_with(arg, "--goal=") { options.goal = str_slice(arg, 7, len(arg)); }
        elif str_starts_with(arg, "--backend=") { options.backend = str_slice(arg, 10, len(arg)); }
        elif str_starts_with(arg, "--target=") { options.target = str_slice(arg, 9, len(arg)); }
        elif str_starts_with(arg, "--") {
            print "pbbuild: unknown option " + arg;
            os_exit(2);
        } else { array_push(positional, arg); }
        i = i + 1;
    }
    if len(positional) != 2 {
        print "usage: pbbuild [--project] SOURCE_OR_DIR OUTPUT [--goal=...] [--backend=...] [--dry-run] [--security-mode=...] [--security-scope=dependencies|entry] [--security-config=FILE]";
        os_exit(2);
    }
    if security_config_path != "" {
        let loaded = SECURITY.load_config(security_config_path);
        if not loaded.ok { print "pbbuild: " + loaded.error; os_exit(2); }
        options.security = loaded.value;
        if not security_mode_set and map_has(loaded.value, "mode") { options.security_mode = loaded.value.mode; }
    }
    if len(disabled_security_rules) > 0 {
        let configured = try options.security.disabled_rule_ids catch [];
        if type(configured) != "array" { configured = []; }
        let i = 0; while i < len(disabled_security_rules) {
            array_push(configured, disabled_security_rules[i]); i = i + 1;
        }
        if type(try options.security catch nil) != "map" { options.security = map{}; }
        options.security.disabled_rule_ids = configured;
    }
    let source = positional[0];
    let output = positional[1];
    if dry_run {
        if project {
            print json_stringify(map{ ok: true, project: source, output: output, note: "project entry resolves during execution", options: options });
        } else { print json_stringify(BUILD.smart_plan(source, output, options)); }
        return;
    }
    let report = if project { BUILD.smart_project(source, output, options) }
        else { BUILD.smart_build(source, output, options) };
    print json_stringify(report);
    if not report.ok { os_exit(1); }
}

main();
