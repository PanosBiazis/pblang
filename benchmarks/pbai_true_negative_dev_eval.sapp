// Γενικό harness «αληθώς αρνητικών» για ΑΝΑΠΤΥΞΗ (dev): διαβάζει ορθές προτάσεις,
// μία ανά γραμμή, από το PBAI_EVAL_FILE και μετρά πόσες ο engine αφήνει ανέγγιχτες
// (καμία διάγνωση και αμετάβλητη πρόταση). Δεν είναι το κλειδωμένο test set.
// Χρήση:
//   PBAI_EVAL_FILE=/path/sentences.txt [PBAI_ENGINE_PATH=editors/ide/tools/ai/pbai_embedded_engine.sapp] \
//   pblang run benchmarks/pbai_true_negative_dev_eval.sapp

fn _pct(num, den) {
    if den <= 0 { return 0.0; }
    return num_floor(((num * 100.0) / den) * 10.0 + 0.5) / 10.0;
}

let eval_file = str_trim(str(env_get("PBAI_EVAL_FILE")));
let eng_env = try str_trim(str(env_get("PBAI_ENGINE_PATH"))) catch "";
let engine_path = if eng_env != "" and eng_env != "nil" { eng_env } else { "editors/ide/tools/ai/pbai_embedded_engine.sapp" };
let EMB = import(engine_path);

let raw = fs_read(eval_file);
let sentences = [];
for ln in str_split(raw, "\n") { let s = str_trim(ln); if len(s) > 0 { push(sentences, s); } }

let ckpt_path = "checkpoints/pbai_organic_synaptic_memory.json";
let had_ckpt = fs_exists(ckpt_path);
let orig_ckpt = if had_ckpt { try fs_read(ckpt_path) catch "" } else { "" };

let pass_strict = 0;
let pass_nodiag = 0;
let flags = 0;
let i = 0;
let t0 = now_ms();
let fails = [];
for s in sentences {
    let res = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: s, learn: false });
    let errs = res.orthographic_errors_count + res.syntactic_errors_count + res.semantic_errors_count;
    flags = flags + errs;
    if errs == 0 { pass_nodiag = pass_nodiag + 1; }
    if errs == 0 and res.corrected_sentence_el == s { pass_strict = pass_strict + 1; }
    elif len(fails) < 25 { push(fails, "  [" + str(i + 1) + "] «" + s + "» -> «" + res.corrected_sentence_el + "» (O=" + str(res.orthographic_errors_count) + " S=" + str(res.syntactic_errors_count) + " N=" + str(res.semantic_errors_count) + ")"); }
    i = i + 1;
}
let ms = now_ms() - t0;
if had_ckpt { try fs_write(ckpt_path, orig_ckpt) catch nil; }
print "engine: " + engine_path;
print "file:   " + eval_file + "  (sha256 " + sha256(raw) + ")";
print "STRICT (κανένα διαγνωστικό + αμετάβλητη): " + str(pass_strict) + "/" + str(len(sentences)) + " (" + str(_pct(pass_strict, len(sentences))) + "%)";
print "NO-DIAG: " + str(pass_nodiag) + "/" + str(len(sentences)) + " (" + str(_pct(pass_nodiag, len(sentences))) + "%)";
print "ψευδείς επισημάνσεις: " + str(flags) + "   χρόνος: " + str(ms) + " ms";
for f in fails { print f; }
