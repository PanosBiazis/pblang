// Τρέχει το ίδιο prompt (prompt_proofread_150_el.txt) σε μοντέλα του Ollama
// (cloud μέσω του τοπικού daemon ή local) και αποθηκεύει την ακατέργαστη έξοδο.
// Χρήση: PBAI_COMPARE_MODELS="m1,m2" pblang run benchmarks/compare/run_ollama_models.sapp

let PROMPT_PATH = "benchmarks/compare/prompt_proofread_150_el.txt";
let OUT_DIR = "benchmarks/compare/outputs";

fn _safe(name) {
    let s = str_replace_all(name, ":", "_");
    return str_replace_all(s, "/", "_");
}

fn run_model(model, prompt) {
    let body = json_stringify(map{
        model: model,
        stream: false,
        options: map{ temperature: 0.0 },
        messages: [map{ role: "user", content: prompt }]
    });
    let t0 = now_ms();
    let raw = try http_post("http://127.0.0.1:11434/api/chat", body) catch nil;
    let ms = now_ms() - t0;
    if raw == nil {
        print model + ": ΣΦΑΛΜΑ HTTP";
        return nil;
    }
    let parsed = try json_parse(raw) catch nil;
    let content = if parsed != nil { try parsed.message.content catch raw } else { raw };
    let path = OUT_DIR + "/" + _safe(model) + ".txt";
    fs_write(path, content);
    print model + ": " + str(len(content)) + " χαρακτήρες, " + str(ms) + " ms -> " + path;
    return path;
}

let prompt = fs_read(PROMPT_PATH);
print "prompt sha256: " + sha256(prompt);
let models = str_split(str_trim(env_get("PBAI_COMPARE_MODELS")), ",");
for m in models { let _ = run_model(m, prompt); }
