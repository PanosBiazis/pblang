// ============================================================================
// Βαθμολόγηση σύγκρισης μοντέλων στο κλειδωμένο σύνολο 150 ορθών ελληνικών
// προτάσεων του χρήστη (true-negative / do-no-harm).
//
// Είσοδος: benchmarks/compare/outputs/manifest.txt με γραμμές
//     αρχείο|ετικέτα|ms_συνολικά|σημείωση
// Κάθε αρχείο περιέχει την ακατέργαστη απάντηση του μοντέλου· εξάγεται το JSON
// array από το πρώτο "[" ως το τελευταίο "]".
//
// strict = has_errors == false ΚΑΙ corrected == αρχική πρόταση (byte-ίδια)
// loose  = has_errors == false
// Χρήση: pblang run benchmarks/compare/score_compare.sapp
// ============================================================================

let DATA_PATH = "benchmarks/data/pbai_user_heldout_150_el_2026-11-05.txt";
let EXPECTED_SHA = "49652fc7533b1188cea7c44ad4687419ec66aab18fffa13b6f861524f12e450e";
let OUT_DIR = "benchmarks/compare/outputs";

fn _first_index(s, ch) {
    let n = len(s);
    let i = 0;
    while i < n {
        if str_slice(s, i, i + 1) == ch { return i; }
        i = i + 1;
    }
    return -1;
}

fn _last_index(s, ch) {
    let i = len(s) - 1;
    while i >= 0 {
        if str_slice(s, i, i + 1) == ch { return i; }
        i = i - 1;
    }
    return -1;
}

fn _load_sentences() {
    let raw = fs_read(DATA_PATH);
    if sha256(raw) != EXPECTED_SHA { return nil; }
    let out = [];
    for ln in str_split(raw, "\n") {
        let t = str_trim(ln);
        if t != "" { push(out, t); }
    }
    return out;
}

fn score_file(path, sentences) {
    let content = try fs_read(path) catch nil;
    if content == nil { return map{ ok: false, reason: "missing" }; }
    let a = _first_index(content, "[");
    let b = _last_index(content, "]");
    if a < 0 or b <= a { return map{ ok: false, reason: "no_json_array" }; }
    let arr = try json_parse(str_slice(content, a, b + 1)) catch nil;
    if arr == nil { return map{ ok: false, reason: "json_parse_failed" }; }
    let strict = 0;
    let loose = 0;
    let answered = 0;
    let changed = [];
    let flagged = [];
    for item in arr {
        let n = try item.n catch 0;
        if n >= 1 and n <= len(sentences) {
            answered = answered + 1;
            let src = sentences[n - 1];
            let he = try item.has_errors catch true;
            let corr = str_trim(try str(item.corrected) catch "");
            if he == false { loose = loose + 1; } else { push(flagged, n); }
            if he == false and corr == src { strict = strict + 1; }
            if corr != src { push(changed, n); }
        }
    }
    return map{ ok: true, answered: answered, strict: strict, loose: loose,
                changed: changed, flagged: flagged };
}

fn run_compare() {
    let sentences = _load_sentences();
    if sentences == nil {
        print "ΣΦΑΛΜΑ: το κλειδωμένο σύνολο άλλαξε (SHA-256). Ακύρωση.";
        return nil;
    }
    print "SHA-256 συνόλου OK, προτάσεις: " + str(len(sentences));
    let manifest = fs_read(OUT_DIR + "/manifest.txt");
    let rows = [];
    print "| Μοντέλο | strict (ίδιο κείμενο) | loose (χωρίς flag) | απαντήσεις | χρόνος | σημείωση |";
    print "|---|---|---|---|---|---|";
    for ln in str_split(manifest, "\n") {
        let t = str_trim(ln);
        if t != "" and str_slice(t, 0, 1) != "#" {
            let f = str_split(t, "|");
            let r = score_file(OUT_DIR + "/" + str_trim(f[0]), sentences);
            let label = str_trim(f[1]);
            let ms = str_trim(f[2]);
            let note = if len(f) > 3 { str_trim(f[3]) } else { "" };
            if r.ok {
                print "| " + label + " | " + str(r.strict) + "/150 | " + str(r.loose) + "/150 | "
                    + str(r.answered) + " | " + ms + " ms | " + note
                    + (if len(r.changed) > 0 { " · άλλαξε: " + json_stringify(r.changed) } else { "" })
                    + (if len(r.flagged) > 0 { " · flag: " + json_stringify(r.flagged) } else { "" }) + " |";
            } else {
                print "| " + label + " | — | — | — | " + ms + " ms | ΑΠΟΤΥΧΙΑ: " + r.reason + " |";
            }
            push(rows, map{ label: label, file: str_trim(f[0]), ms: ms, note: note, result: r });
        }
    }
    fs_write(OUT_DIR + "/../compare_results.json", json_stringify(map{
        data_sha256: EXPECTED_SHA, rows: rows }));
    return rows;
}

let _ = run_compare();
