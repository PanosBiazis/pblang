// Μετατρέπει τα αποτελέσματα του pbAI στο κλειδωμένο 150 (results.json) στη μορφή
// που βαθμολογεί το score_compare.sapp: [{ n, has_errors, corrected }].
// Χρήση: pblang run benchmarks/compare/export_pbai_output.sapp
let SRC = "benchmarks/data/pbai_user_heldout_150_el_2026-11-05.results.json";
let DST = "benchmarks/compare/outputs/pbai_embedded.txt";
let res = json_parse(fs_read(SRC));
let out = [];
for r in res.rows {
    let errs = r.ortho + r.syn + r.sem;
    push(out, map{ n: r.n, has_errors: errs > 0, corrected: r.corrected });
}
fs_write(DST, json_stringify(out));
print "εξήχθησαν " + str(len(out)) + " γραμμές στο " + DST;
