// ============================================================================
// pbAI — Held-out 150 ελληνικών προτάσεων ΓΡΑΜΜΕΝΩΝ/ΔΟΘΕΙΣΩΝ ΑΠΟ ΤΟΝ ΧΡΗΣΤΗ
// Ημερομηνία κλειδώματος: 2026-11-05
// Δεδομένα: benchmarks/data/pbai_user_heldout_150_el_2026-11-05.txt
// SHA-256:  49652fc7533b1188cea7c44ad4687419ec66aab18fffa13b6f861524f12e450e
//
// Κανόνας: το σύνολο ΔΕΝ χρησιμοποιείται για tuning. Μετριέται μία φορά με τον
// engine ως έχει. Όλες οι προτάσεις είναι ορθές, φυσικές ελληνικές· άρα η
// μέτρηση είναι «αληθώς αρνητικά»: ο engine δεν πρέπει να βρει λάθη ούτε να
// αλλάξει την πρόταση. ΔΕΝ μετρά ανίχνευση λαθών ούτε κατανόηση.
// ============================================================================

let EMB = import("editors/ide/tools/ai/pbai_embedded_engine.sapp");

let DATA_PATH = "benchmarks/data/pbai_user_heldout_150_el_2026-11-05.txt";
let EXPECTED_SHA = "49652fc7533b1188cea7c44ad4687419ec66aab18fffa13b6f861524f12e450e";

fn _pct(num, den) {
    if den <= 0 { return 0.0; }
    return num_floor(((num * 100.0) / den) * 10.0 + 0.5) / 10.0;
}

fn _group_name(i) {
    if i < 30 { return "1-30 Καθημερινός λόγος"; }
    if i < 60 { return "31-60 Επαγγελματική επικοινωνία"; }
    if i < 90 { return "61-90 Άρθρα / storytelling"; }
    if i < 120 { return "91-120 Social media"; }
    return "121-150 Εξυπηρέτηση / UI";
}

fn run_user_heldout_150() {
    let raw = fs_read(DATA_PATH);
    let got_sha = sha256(raw);
    print "SHA-256 δεδομένων: " + got_sha;
    if got_sha != EXPECTED_SHA {
        print "ΣΦΑΛΜΑ: το σύνολο δεδομένων έχει αλλάξει. Η μέτρηση ακυρώνεται.";
        return map{ ok: false, reason: "hash_mismatch" };
    }
    let sentences = [];
    for ln in str_split(raw, "\n") {
        let s = str_trim(ln);
        if len(s) > 0 { push(sentences, s); }
    }

    let ckpt_path = "checkpoints/pbai_organic_synaptic_memory.json";
    let had_ckpt = fs_exists(ckpt_path);
    let orig_ckpt = if had_ckpt { try fs_read(ckpt_path) catch "" } else { "" };

    let groups = map{};
    let total_pass = 0;
    let failures = [];
    let rows = [];
    let i = 0;
    let t0 = now_ms();
    for s in sentences {
        let g = _group_name(i);
        if not map_has(groups, g) { groups[g] = map{ pass: 0, total: 0 }; }
        let res = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: s, learn: false });
        let errs = res.orthographic_errors_count + res.syntactic_errors_count + res.semantic_errors_count;
        let unchanged = res.corrected_sentence_el == s;
        let ok = errs == 0 and unchanged;
        groups[g].total = groups[g].total + 1;
        if ok {
            groups[g].pass = groups[g].pass + 1;
            total_pass = total_pass + 1;
        } else {
            push(failures, "  [" + str(i + 1) + "] «" + s + "» -> «" + res.corrected_sentence_el + "» (O=" + str(res.orthographic_errors_count) + " S=" + str(res.syntactic_errors_count) + " N=" + str(res.semantic_errors_count) + ") " + str(res.diagnostics_el));
        }
        push(rows, map{ n: i + 1, ok: ok, ortho: res.orthographic_errors_count, syn: res.syntactic_errors_count, sem: res.semantic_errors_count, corrected: res.corrected_sentence_el, response: res.organic_brain_response_el });
        i = i + 1;
    }
    let elapsed = now_ms() - t0;

    if had_ckpt { try fs_write(ckpt_path, orig_ckpt) catch nil; }

    print "========================================================================";
    print "pbAI USER HELD-OUT 150 (αληθώς αρνητικά, χωρίς tuning)";
    print "========================================================================";
    for g in ["1-30 Καθημερινός λόγος", "31-60 Επαγγελματική επικοινωνία", "61-90 Άρθρα / storytelling", "91-120 Social media", "121-150 Εξυπηρέτηση / UI"] {
        if map_has(groups, g) {
            print g + ": " + str(groups[g].pass) + "/" + str(groups[g].total) + " (" + str(_pct(groups[g].pass, groups[g].total)) + "%)";
        }
    }
    print "------------------------------------------------------------------------";
    print "ΣΥΝΟΛΟ: " + str(total_pass) + "/" + str(len(sentences)) + " (" + str(_pct(total_pass, len(sentences))) + "%)  χρόνος " + str(elapsed) + " ms";
    print "ΨΕΥΔΗ ΘΕΤΙΚΑ / ΑΛΛΟΙΩΣΕΙΣ:";
    for f in failures { print f; }

    try fs_write("benchmarks/data/pbai_user_heldout_150_el_2026-11-05.results.json", json_stringify(map{ sha256: got_sha, total_pass: total_pass, total: len(sentences), elapsed_ms: elapsed, rows: rows })) catch nil;
    return map{ ok: true, total_pass: total_pass, total: len(sentences) };
}

let _ = run_user_heldout_150();
