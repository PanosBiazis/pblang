// ============================================================================
// benchmarks/pbai_greek_bion_benchmark.sapp
// Πραγματικό Ποσοτικό Benchmark Αξιολόγησης του Εγκεφάλου 4 Φάσεων Bion (pbAI)
// Μετράει:
//   A. Ορθογραφική & Τονική Αποκατάσταση (Exact Corrected Sentence & Detection Recall)
//   B. Συντακτική Συμφωνία Γένους / Πτώσης / Μορίων (Detection & Correction Accuracy)
//   C. Νοηματική Συνοχή, Εμψυχότητα (Animacy) & Λογικές Αντιφάσεις
//   D. Πολυ-Προτασιακή Κατάτμηση (Multi-Sentence Boundary Preservation)
//   E. Ρυθμός Ψευδών Θετικών σε Ορθές Προτάσεις (False Positive Rate - FPR)
//   F. Ακρίβεια Επεισοδιακής Μνήμης, Κατώφλι Σχετικότητας & Καθαρότητα Απαντήσεων
// ============================================================================

let EMB = import("editors/ide/tools/ai/pbai_embedded_engine.sapp");

fn _pct(num, den) {
    if den <= 0 { return 0.0; }
    return num_floor(((num * 100.0) / den) * 10.0 + 0.5) / 10.0;
}

fn run_greek_bion_benchmark() {
    print "========================================================================";
    print "ΕΚΤΕΛΕΣΗ ΠΡΑΓΜΑΤΙΚΟΥ ΠΟΣΟΤΙΚΟΥ BENCHMARK BION (HELD-OUT EVALUATION)";
    print "========================================================================";

    // ------------------------------------------------------------------------
    // ΚΑΤΗΓΟΡΙΑ A: Ορθογραφική & Τονική Αποκατάσταση (12 περιπτώσεις)
    // ------------------------------------------------------------------------
    let ortho_cases = [
        map{ input: "Ο σοφος ανθροπος αναζητα την αληθια.", expected_corr: "Ο σοφός άνθρωπος αναζητά την αλήθεια.", expect_diag: true },
        map{ input: "ποτε παιζει η ΑΕΚ?", expected_corr: "Πότε παίζει η ΑΕΚ;", expect_diag: false },
        map{ input: "Ο μαθητης διαβαζει το βιβλιο.", expected_corr: "Ο μαθητής διαβάζει το βιβλίο.", expect_diag: false },
        map{ input: "Η σοφη δασκαλα γραφει την ιδεα.", expected_corr: "Η σοφή δασκάλα γράφει την ιδέα.", expect_diag: false },
        map{ input: "Ο καλος γιατρος θεραπευει τον ασθενη.", expected_corr: "Ο καλός γιατρός θεραπεύει τον ασθενή.", expect_diag: false },
        map{ input: "Ο μηχανικος κατασκευαζει την μηχανη.", expected_corr: "Ο μηχανικός κατασκευάζει την μηχανή.", expect_diag: false },
        map{ input: "Ο ηλιος φωτιζει την θαλασσα.", expected_corr: "Ο ήλιος φωτίζει την θάλασσα.", expect_diag: false },
        map{ input: "Ο μαθιτης διαβαζει το βιβλειο.", expected_corr: "Ο μαθητής διαβάζει το βιβλίο.", expect_diag: true },
        map{ input: "Η ελευθερεια και η δημοκρατεια φωτιζουν την ζωη.", expected_corr: "Η ελευθερία και η δημοκρατία φωτίζουν την ζωή.", expect_diag: true },
        map{ input: "Ο φιλοσοφος αναζητα την γνωση.", expected_corr: "Ο φιλόσοφος αναζητά την γνώση.", expect_diag: false },
        map{ input: "τι μπορεις να κανεις?", expected_corr: "Τι μπορείς να κάνεις;", expect_diag: false },
        map{ input: "γεια σου τι κανεις καλα εισαι?", expected_corr: "Γεια σου τι κάνεις καλά είσαι;", expect_diag: false }
    ];
    let ortho_exact_pass = 0;
    let ortho_failures = [];
    for oc in ortho_cases {
        let res = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: oc.input, learn: false });
        let corr = str_replace_all(res.corrected_sentence_el, "?", ";");
        let exp_c = str_replace_all(oc.expected_corr, "?", ";");
        let diag_ok = if oc.expect_diag { res.orthographic_errors_count >= 1 } else { true };
        if corr == exp_c and diag_ok {
            ortho_exact_pass = ortho_exact_pass + 1;
        } else {
            push(ortho_failures, "  [FAIL A] Input: «" + oc.input + "» -> Got: «" + res.corrected_sentence_el + "» (Expected: «" + oc.expected_corr + "», OrthoDiags=" + str(res.orthographic_errors_count) + ")");
        }
    }

    // ------------------------------------------------------------------------
    // ΚΑΤΗΓΟΡΙΑ B: Συντακτικός & Γραμματικός Έλεγχος (10 περιπτώσεις)
    // ------------------------------------------------------------------------
    let syn_cases = [
        map{ input: "Ο καλός θάλασσα βλέπει τον Αλέξανδρος!", expected_corr: "Η καλή θάλασσα βλέπει τον Αλέξανδρο!" },
        map{ input: "Η σοφός άνθρωπος αναζητά την αλήθεια.", expected_corr: "Ο σοφός άνθρωπος αναζητά την αλήθεια." },
        map{ input: "Το μεγάλη ιδέα φωτίζει τον άνθρωπο.", expected_corr: "Η μεγάλη ιδέα φωτίζει τον άνθρωπο." },
        map{ input: "Ο δάσκαλος βλέπει τον μαθητής.", expected_corr: "Ο δάσκαλος βλέπει τον μαθητή." },
        map{ input: "Η γάτα τρέχει σε ο κήπος.", expected_corr: "Η γάτα τρέχει στον κήπο." },
        map{ input: "Τον άνθρωπο βλέπει το δέντρο.", expected_corr: "Ο άνθρωπος βλέπει το δέντρο." },
        map{ input: "Ο μαθητής μπορείς κάνεις το έργο.", expected_corr_contains: "να" },
        map{ input: "Ο καλή δάσκαλος γράφει το βιβλίο.", expected_corr: "Ο καλός δάσκαλος γράφει το βιβλίο." },
        map{ input: "Η μικρός γάτα βλέπει την θάλασσα.", expected_corr: "Η μικρή γάτα βλέπει την θάλασσα." },
        map{ input: "Ο γιατρός εξετάζει τον ασθενής.", expected_corr: "Ο γιατρός εξετάζει τον ασθενή." }
    ];
    let syn_pass = 0;
    let syn_failures = [];
    for sc in syn_cases {
        let res = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: sc.input, learn: false });
        let has_syn_diag = res.syntactic_errors_count >= 1;
        let corr_ok = false;
        if map_has(sc, "expected_corr") {
            corr_ok = (res.corrected_sentence_el == sc.expected_corr);
        } elif map_has(sc, "expected_corr_contains") {
            corr_ok = str_contains(res.corrected_sentence_el, sc.expected_corr_contains);
        }
        if has_syn_diag and corr_ok {
            syn_pass = syn_pass + 1;
        } else {
            push(syn_failures, "  [FAIL B] Input: «" + sc.input + "» -> Got: «" + res.corrected_sentence_el + "» (SynDiags=" + str(res.syntactic_errors_count) + ")");
        }
    }

    // ------------------------------------------------------------------------
    // ΚΑΤΗΓΟΡΙΑ C: Νοηματικός Έλεγχος — Εμψυχότητα (Animacy) & Λογική (8 περιπτώσεις)
    // ------------------------------------------------------------------------
    let sem_cases = [
        map{ input: "Το τρακτέρ οδηγεί τον Αλέξανδρο.", expected_corr: "Ο Αλέξανδρος οδηγεί το τρακτέρ." },
        map{ input: "Το βιβλίο διαβάζει τον μαθητή.", expected_corr: "Ο μαθητής διαβάζει το βιβλίο." },
        map{ input: "Το αυτοκίνητο οδηγεί τον γιατρό.", expected_corr: "Ο γιατρός οδηγεί το αυτοκίνητο." },
        map{ input: "Η επιστολή γράφει την δασκάλα.", expected_corr: "Η δασκάλα γράφει την επιστολή." },
        map{ input: "Η πέτρα σκέφτεται την αλήθεια.", expect_diag_only: true },
        map{ input: "Το τραπέζι μαθαίνει την επιστήμη.", expect_diag_only: true },
        map{ input: "Ο μαθητής διαβάζει και δεν διαβάζει.", expect_diag_only: true },
        map{ input: "Ο ήλιος φωτίζει και δεν φωτίζει.", expect_diag_only: true }
    ];
    let sem_pass = 0;
    let sem_failures = [];
    for semc in sem_cases {
        let res = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: semc.input, learn: false });
        let has_sem_diag = res.semantic_errors_count >= 1;
        let corr_ok = true;
        if map_has(semc, "expected_corr") {
            corr_ok = (res.corrected_sentence_el == semc.expected_corr);
        }
        if has_sem_diag and corr_ok {
            sem_pass = sem_pass + 1;
        } else {
            push(sem_failures, "  [FAIL C] Input: «" + semc.input + "» -> Got: «" + res.corrected_sentence_el + "» (SemDiags=" + str(res.semantic_errors_count) + ")");
        }
    }

    // ------------------------------------------------------------------------
    // ΚΑΤΗΓΟΡΙΑ D: Πολυ-Προτασιακή Κατάτμηση (Multi-Sentence Segmentation — 6 περιπτώσεις)
    // ------------------------------------------------------------------------
    let multi_cases = [
        map{
            input: "Ο νεαρός μαθητής διαβάζει το βιβλίο... Η σοφή δασκάλα γράφει την ιδέα! Ποιος διαβάζει το βιβλίο;",
            must_contain: "Η σοφή δασκάλα γράφει την ιδέα",
            must_not_contain: "την σοφή δασκάλα"
        },
        map{
            input: "Ο ήλιος φωτίζει την θάλασσα. Η γάτα τρέχει στον κήπο.",
            must_contain: "Η γάτα τρέχει στον κήπο",
            must_not_contain: "την γάτα"
        },
        map{
            input: "Ο γιατρός θεραπεύει τον ασθενή! Η δασκάλα διαβάζει το βιβλίο.",
            must_contain: "Η δασκάλα διαβάζει το βιβλίο",
            must_not_contain: "την δασκάλα"
        },
        map{
            input: "Ο σοφός άνθρωπος αναζητά την αλήθεια. Ο μαθητής μαθαίνει την επιστήμη.",
            must_contain: "Ο μαθητής μαθαίνει την επιστήμη",
            must_not_contain: "τον μαθητή μαθαίνει"
        },
        map{
            input: "Η θάλασσα είναι μεγάλη. Ο ήλιος φωτίζει τον ουρανό!",
            must_contain: "Ο ήλιος φωτίζει",
            must_not_contain: "τον ήλιο φωτίζει"
        },
        map{
            input: "Ο ανθροπος αναζητα την αληθια. Η δασκαλα γραφει το βιβλιο.",
            must_contain: "Η δασκάλα γράφει το βιβλίο",
            must_not_contain: "την δασκάλα"
        }
    ];
    let multi_pass = 0;
    let multi_failures = [];
    for mc in multi_cases {
        let res = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: mc.input, learn: false });
        let c_el = res.corrected_sentence_el;
        if str_contains(c_el, mc.must_contain) and not str_contains(c_el, mc.must_not_contain) {
            multi_pass = multi_pass + 1;
        } else {
            push(multi_failures, "  [FAIL D] Input: «" + mc.input + "» -> Got: «" + c_el + "» (Must contain: «" + mc.must_contain + "»)");
        }
    }

    // ------------------------------------------------------------------------
    // ΚΑΤΗΓΟΡΙΑ E: Ψευδή Θετικά σε Ορθές Προτάσεις (False Positive Rate — 10 περιπτώσεις)
    // ------------------------------------------------------------------------
    let clean_cases = [
        "Ο σοφός άνθρωπος αναζητά την αλήθεια.",
        "Η καλή δασκάλα διαβάζει το βιβλίο.",
        "Πότε παίζει η ΑΕΚ;",
        "Γεια σου, τι κάνεις; Καλά είσαι;",
        "Τι μπορείς να κάνεις;",
        "Ο Αλέξανδρος οδηγεί το τρακτέρ στον κάμπο.",
        "Ο ήλιος φωτίζει την θάλασσα.",
        "Ο γιατρός θεραπεύει τον ασθενή.",
        "Η γάτα τρέχει στον κήπο.",
        "Ο μαθητής μαθαίνει την επιστήμη."
    ];
    let clean_true_negatives = 0;
    let fp_failures = [];
    for cc in clean_cases {
        let res = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: cc, learn: false });
        if res.diagnostics_count == 0 {
            clean_true_negatives = clean_true_negatives + 1;
        } else {
            push(fp_failures, "  [FAIL E - False Positive] Input: «" + cc + "» -> Flagged " + str(res.diagnostics_count) + " errors: " + json_stringify(res.all_diagnostics_el));
        }
    }

    // ------------------------------------------------------------------------
    // ΚΑΤΗΓΟΡΙΑ F: Επεισοδιακή Μνήμη, Κατώφλι Σχετικότητας & Καθαρότητα (8 περιπτώσεις)
    // ------------------------------------------------------------------------
    let _ = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: "Η ΑΕΚ παίζει την Κυριακή στη Νέα Φιλαδέλφεια.", learn: true });
    let _ = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: "Ο Νικόλας κατασκευάζει το ηλιακό ρομπότ στο εργαστήριο.", learn: true });

    let mem_pass = 0;
    let mem_failures = [];

    // F1. True recall for AEK time
    let q_f1 = EMB.assist_developer_interactive(map{ edition: "standalone_polyglot", prompt: "Πότε παίζει η ΑΕΚ;", persist_turn: false });
    if str_contains(q_f1.natural_answer, "Κυριακή") and not str_contains(q_f1.natural_answer, "Strict security") {
        mem_pass = mem_pass + 1;
    } else {
        push(mem_failures, "  [FAIL F1] Πότε παίζει η ΑΕΚ; -> " + q_f1.natural_answer);
    }

    // F2. True recall for AEK location
    let q_f2 = EMB.assist_developer_interactive(map{ edition: "standalone_polyglot", prompt: "Πού παίζει η ΑΕΚ;", persist_turn: false });
    if str_contains(q_f2.natural_answer, "Φιλαδέλφεια") and not str_contains(q_f2.natural_answer, "Strict security") {
        mem_pass = mem_pass + 1;
    } else {
        push(mem_failures, "  [FAIL F2] Πού παίζει η ΑΕΚ; -> " + q_f2.natural_answer);
    }

    // F3. True recall for Nikolas subject
    let q_f3 = EMB.assist_developer_interactive(map{ edition: "standalone_polyglot", prompt: "Ποιος κατασκευάζει το ηλιακό ρομπότ;", persist_turn: false });
    if str_contains(q_f3.natural_answer, "Νικόλας") and not str_contains(q_f3.natural_answer, "Strict security") {
        mem_pass = mem_pass + 1;
    } else {
        push(mem_failures, "  [FAIL F3] Ποιος κατασκευάζει το ηλιακό ρομπότ; -> " + q_f3.natural_answer);
    }

    // F4. Unseen subject with shared verb ("παίζει") -> must NOT falsely recall AEK!
    let q_f4 = EMB.assist_developer_interactive(map{ edition: "standalone_polyglot", prompt: "Πότε παίζει ο ΠΑΟΚ;", persist_turn: false });
    if not str_contains(q_f4.natural_answer, "Η ΑΕΚ παίζει") and str_contains(q_f4.natural_answer, "δεν έχει καταγραφεί") {
        mem_pass = mem_pass + 1;
    } else {
        push(mem_failures, "  [FAIL F4 - False Recall] Πότε παίζει ο ΠΑΟΚ; -> " + q_f4.natural_answer);
    }

    // F5. Unseen object with shared verb ("κατασκευάζει") -> must NOT falsely recall Nikolas!
    let q_f5 = EMB.assist_developer_interactive(map{ edition: "standalone_polyglot", prompt: "Ποιος κατασκευάζει τη γέφυρα;", persist_turn: false });
    if not str_contains(q_f5.natural_answer, "Νικόλας") and str_contains(q_f5.natural_answer, "δεν έχει καταγραφεί") {
        mem_pass = mem_pass + 1;
    } else {
        push(mem_failures, "  [FAIL F5 - False Recall] Ποιος κατασκευάζει τη γέφυρα; -> " + q_f5.natural_answer);
    }

    // F6. Greeting must be clean (no "Strict security" lesson boilerplate!)
    let q_f6 = EMB.assist_developer_interactive(map{ edition: "standalone_polyglot", prompt: "γεια σου τι κανεις καλα εισαι?", persist_turn: false });
    if str_contains(q_f6.natural_answer, "Είμαι πολύ καλά") and not str_contains(q_f6.natural_answer, "Strict security") {
        mem_pass = mem_pass + 1;
    } else {
        push(mem_failures, "  [FAIL F6 - Boilerplate] γεια σου τι κανεις καλα εισαι? -> " + q_f6.natural_answer);
    }

    // F7. Seed ontology vs User-taught provenance transparency ("Τι είναι η ΑΕΚ;")
    let q_f7 = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: "Τι είναι η ΑΕΚ;", learn: false });
    if str_contains(q_f7.organic_brain_response_el, "Αθλητική Ένωση Κωνσταντινουπόλεως") and str_contains(q_f7.organic_brain_response_el, "Βάση Οντολογίας") {
        mem_pass = mem_pass + 1;
    } else {
        push(mem_failures, "  [FAIL F7 - Provenance Label] Τι είναι η ΑΕΚ; -> " + q_f7.organic_brain_response_el);
    }

    // F8. Trainable Statistical / Neural Orthographic & Semantic Model Loss Improvement Check
    let b0 = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: "Ο σοφός άνθρωπος αναζητά την αλήθεια.", learn: false });
    let has_real_trained_model = map_has(b0, "statistical_model_metrics") and (try b0.statistical_model_metrics.loss_after < b0.statistical_model_metrics.loss_before catch false);
    if has_real_trained_model {
        mem_pass = mem_pass + 1;
    } else {
        push(mem_failures, "  [FAIL F8 - Real Trainable Model] Missing or non-converging statistical_model_metrics in bion trace");
    }

    let total_cases = len(ortho_cases) + len(syn_cases) + len(sem_cases) + len(multi_cases) + len(clean_cases) + 8;
    let total_passed = ortho_exact_pass + syn_pass + sem_pass + multi_pass + clean_true_negatives + mem_pass;

    print "A. Ορθογραφία & Τονισμός:       " + str(ortho_exact_pass) + "/" + str(len(ortho_cases)) + " (" + str(_pct(ortho_exact_pass, len(ortho_cases))) + "%)";
    for f in ortho_failures { print f; }
    print "B. Συντακτική Συμφωνία:         " + str(syn_pass) + "/" + str(len(syn_cases)) + " (" + str(_pct(syn_pass, len(syn_cases))) + "%)";
    for f in syn_failures { print f; }
    print "C. Νοηματική Συνοχή & Εμψυχία:  " + str(sem_pass) + "/" + str(len(sem_cases)) + " (" + str(_pct(sem_pass, len(sem_cases))) + "%)";
    for f in sem_failures { print f; }
    print "D. Πολυ-Προτασιακή Κατάτμηση:   " + str(multi_pass) + "/" + str(len(multi_cases)) + " (" + str(_pct(multi_pass, len(multi_cases))) + "%)";
    for f in multi_failures { print f; }
    print "E. Μηδενικά Ψευδή Θετικά (TNR): " + str(clean_true_negatives) + "/" + str(len(clean_cases)) + " (" + str(_pct(clean_true_negatives, len(clean_cases))) + "%)";
    for f in fp_failures { print f; }
    print "F. Μνήμη, Κατώφλι & Εκπαίδευση: " + str(mem_pass) + "/8 (" + str(_pct(mem_pass, 8)) + "%)";
    for f in mem_failures { print f; }
    print "------------------------------------------------------------------------";
    print "ΣΥΝΟΛΙΚΟ ΣΚΟΡ BENCHMARK:        " + str(total_passed) + "/" + str(total_cases) + " (" + str(_pct(total_passed, total_cases)) + "%)";
    print "========================================================================";

    return map{
        total_passed: total_passed,
        total_cases: total_cases,
        score_pct: _pct(total_passed, total_cases)
    };
}

run_greek_bion_benchmark();
