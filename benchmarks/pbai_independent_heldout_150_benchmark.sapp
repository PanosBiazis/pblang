// ============================================================================
// benchmarks/pbai_independent_heldout_150_benchmark.sapp
// ΠΡΑΓΜΑΤΙΚΟ ΑΝΕΞΑΡΤΗΤΟ HELD-OUT BENCHMARK 150 ΠΡΟΤΑΣΕΩΝ (BLIND EVALUATION)
// 150 Ελληνικές προτάσεις γενικού λεξιλογίου (καθημερινός, σχολικός & επιστημονικός
// λόγος) εκτός του αρχικού μικρού λεξικού αναφοράς, χωρισμένες σε 6 ισότιμες
// κατηγορίες των 25 προτάσεων (6 x 25 = 150 προτάσεις):
//   A. Ορθογραφία & Τονισμός σε Άγνωστο/Γενικό Λεξιλόγιο (25 προτάσεις)
//   B. Συντακτική Συμφωνία Γένους & Πτώσης σε Γενικό Λεξιλόγιο (25 προτάσεις)
//   C. Νοηματική Συνοχή, Εμψυχία (Animacy) & Λογική (25 προτάσεις)
//   D. Πολυ-Προτασιακή Κατάτμηση & Σύνθετη Στίξη (25 προτάσεις)
//   E. Αληθή Αρνητικά (True Negatives / 0% Ψευδή Θετικά σε Ορθές Προτάσεις) (25 προτάσεις)
//   F. Επεισοδιακή Μνήμη, Αρνητικός Έλεγχος Άγνωστων Οντοτήτων & Παραμορφώσεις (25 προτάσεις)
// ============================================================================

let EMB = import("editors/ide/tools/ai/pbai_embedded_engine.sapp");

fn _pct(num, den) {
    if den <= 0 { return 0.0; }
    return num_floor(((num * 100.0) / den) * 10.0 + 0.5) / 10.0;
}

fn run_independent_150_benchmark() {
    let ckpt_path = "checkpoints/pbai_organic_synaptic_memory.json";
    let had_ckpt = fs_exists(ckpt_path);
    let orig_ckpt = if had_ckpt { try fs_read(ckpt_path) catch "" } else { "" };
    let pbai_ckpt_path = "/media/panosboy/ExtHD/panag/Documents/projects/AAP/products/pbai/checkpoints/pbai_organic_synaptic_memory.json";
    let had_pbai_ckpt = fs_exists(pbai_ckpt_path);
    let orig_pbai_ckpt = if had_pbai_ckpt { try fs_read(pbai_ckpt_path) catch "" } else { "" };
    print "========================================================================";
    print "ΕΚΤΕΛΕΣΗ ΑΝΕΞΑΡΤΗΤΟΥ HELD-OUT BENCHMARK 150 ΠΡΟΤΑΣΕΩΝ (6 x 25 = 150)";
    print "========================================================================";

    // ------------------------------------------------------------------------
    // ΚΑΤΗΓΟΡΙΑ A: Ορθογραφία & Τονισμός σε Γενικό Λεξιλόγιο (25 προτάσεις)
    // ------------------------------------------------------------------------
    let cat_a = [
        map{ id: "A01", input: "Ο καθηγητης εξηγει το μαθημα.", expected_corr: "Ο καθηγητής εξηγεί το μάθημα.", expect_diag: false },
        map{ id: "A02", input: "Η φοιτητρια μελεταει την ιστορια.", expected_corr: "Η φοιτήτρια μελετάει την ιστορία.", expect_diag: false },
        map{ id: "A03", input: "Ο ζωγραφος ζωγραφιζει τον ουρανο.", expected_corr: "Ο ζωγράφος ζωγραφίζει τον ουρανό.", expect_diag: false },
        map{ id: "A04", input: "Ο ναυτικος ταξιδευει στο πελαγος.", expected_corr: "Ο ναυτικός ταξιδεύει στο πέλαγος.", expect_diag: false },
        map{ id: "A05", input: "Ο μαγειρας ετοιμαζει το φαγητο.", expected_corr: "Ο μάγειρας ετοιμάζει το φαγητό.", expect_diag: false },
        map{ id: "A06", input: "Ο αστρονομος παρατηρει τον πλανητη.", expected_corr: "Ο αστρονόμος παρατηρεί τον πλανήτη.", expect_diag: false },
        map{ id: "A07", input: "Ο ποιητης γραφει το ποιημα.", expected_corr: "Ο ποιητής γράφει το ποίημα.", expect_diag: false },
        map{ id: "A08", input: "Ο τεχνιτης επισκευαζει το ρολοι.", expected_corr: "Ο τεχνίτης επισκευάζει το ρολόι.", expect_diag: false },
        map{ id: "A09", input: "Ο πιλοτος κυβερναει το αεροπλανο.", expected_corr: "Ο πιλότος κυβερνάει το αεροπλάνο.", expect_diag: false },
        map{ id: "A10", input: "Ο δημοσιογραφος ανακοινωνει την ειδηση.", expected_corr: "Ο δημοσιογράφος ανακοινώνει την είδηση.", expect_diag: false },
        map{ id: "A11", input: "Ο αθλητης κερδιζει τον αγωνα.", expected_corr: "Ο αθλητής κερδίζει τον αγώνα.", expect_diag: false },
        map{ id: "A12", input: "Ο ψαρας ριχνει το διχτυ.", expected_corr: "Ο ψαράς ρίχνει το δίχτυ.", expect_diag: false },
        map{ id: "A13", input: "Ο δικαστης αποφασιζει με δικαιοσυνη.", expected_corr: "Ο δικαστής αποφασίζει με δικαιοσύνη.", expect_diag: false },
        map{ id: "A14", input: "Ο αρχιτεκτονας σχεδιαζει το κτιριο.", expected_corr: "Ο αρχιτέκτονας σχεδιάζει το κτίριο.", expect_diag: false },
        map{ id: "A15", input: "Ο βιολογος εξεταζει το κυτταρο.", expected_corr: "Ο βιολόγος εξετάζει το κύτταρο.", expect_diag: false },
        map{ id: "A16", input: "Ο φυσικος μελεταει την ενεργεια.", expected_corr: "Ο φυσικός μελετάει την ενέργεια.", expect_diag: false },
        map{ id: "A17", input: "Ο εργατης χτιζει τον τοιχο.", expected_corr: "Ο εργάτης χτίζει τον τοίχο.", expect_diag: false },
        map{ id: "A18", input: "Ο γεωργος καλλιεργει το χωραφι.", expected_corr: "Ο γεωργός καλλιεργεί το χωράφι.", expect_diag: false },
        map{ id: "A19", input: "Ο καπετανιος οδηγει το πλοιο.", expected_corr: "Ο καπετάνιος οδηγεί το πλοίο.", expect_diag: false },
        map{ id: "A20", input: "Ο καθηγιτής εξηγεί το μάθημα.", expected_corr: "Ο καθηγητής εξηγεί το μάθημα.", expect_diag: true },
        map{ id: "A21", input: "Ο αστρονόμος παρατιρεί τον πλανήτη.", expected_corr: "Ο αστρονόμος παρατηρεί τον πλανήτη.", expect_diag: true },
        map{ id: "A22", input: "Ο μαγειρας ετοιμάζει το φαγιτό.", expected_corr: "Ο μάγειρας ετοιμάζει το φαγητό.", expect_diag: true },
        map{ id: "A23", input: "Ο πιλότος κυβερνάει το αεροπλάνο.", expected_corr: "Ο πιλότος κυβερνάει το αεροπλάνο.", expect_diag: false },
        map{ id: "A24", input: "Ο τεχνίτης επισκευάζει το ρολόη.", expected_corr: "Ο τεχνίτης επισκευάζει το ρολόι.", expect_diag: true },
        map{ id: "A25", input: "Ο εργάτης χτίζη τον τοίχο.", expected_corr: "Ο εργάτης χτίζει τον τοίχο.", expect_diag: true }
    ];

    let pass_a = 0;
    let fail_a = [];
    for ca in cat_a {
        let res = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: ca.input, learn: false });
        let corr = str_replace_all(res.corrected_sentence_el, "?", ";");
        let exp_c = str_replace_all(ca.expected_corr, "?", ";");
        let diag_ok = if ca.expect_diag { res.orthographic_errors_count >= 1 } else { true };
        if corr == exp_c and diag_ok {
            pass_a = pass_a + 1;
        } else {
            push(fail_a, "  [" + ca.id + "] Input: «" + ca.input + "» -> Got: «" + res.corrected_sentence_el + "» (Expected: «" + ca.expected_corr + "», Ortho=" + str(res.orthographic_errors_count) + ")");
        }
    }

    // ------------------------------------------------------------------------
    // ΚΑΤΗΓΟΡΙΑ B: Συντακτική Συμφωνία Γένους & Πτώσης σε Γενικό Λεξιλόγιο (25 προτάσεις)
    // ------------------------------------------------------------------------
    let cat_b = [
        map{ id: "B01", input: "Η καλός καθηγητής εξηγεί το μάθημα.", expected_corr: "Ο καλός καθηγητής εξηγεί το μάθημα." },
        map{ id: "B02", input: "Ο έξυπνος φοιτήτρια μελετάει την ιστορία.", expected_corr: "Η έξυπνη φοιτήτρια μελετάει την ιστορία." },
        map{ id: "B03", input: "Το όμορφη πλατεία φωτίζει την πόλη.", expected_corr: "Η όμορφη πλατεία φωτίζει την πόλη." },
        map{ id: "B04", input: "Ο ζωγράφος ζωγραφίζει τον ουρανός.", expected_corr: "Ο ζωγράφος ζωγραφίζει τον ουρανό." },
        map{ id: "B05", input: "Ο αστρονόμος παρατηρεί τον πλανήτης.", expected_corr: "Ο αστρονόμος παρατηρεί τον πλανήτη." },
        map{ id: "B06", input: "Ο αθλητής κερδίζει τον αγώνας.", expected_corr: "Ο αθλητής κερδίζει τον αγώνα." },
        map{ id: "B07", input: "Ο εργάτης χτίζει τον τοίχος.", expected_corr: "Ο εργάτης χτίζει τον τοίχο." },
        map{ id: "B08", input: "Τον καθηγητή εξηγεί το μάθημα.", expected_corr: "Ο καθηγητής εξηγεί το μάθημα." },
        map{ id: "B09", input: "Τον πιλότο κυβερνάει το αεροπλάνο.", expected_corr: "Ο πιλότος κυβερνάει το αεροπλάνο." },
        map{ id: "B10", input: "Ο ναυτικός ταξιδεύει σε ο ωκεανός.", expected_corr: "Ο ναυτικός ταξιδεύει στον ωκεανό." },
        map{ id: "B11", input: "Η φοιτήτρια διαβάζει σε η βιβλιοθήκη.", expected_corr: "Η φοιτήτρια διαβάζει στην βιβλιοθήκη." },
        map{ id: "B12", input: "Ο γιατρός εργάζεται σε το νοσοκομείο.", expected_corr: "Ο γιατρός εργάζεται στο νοσοκομείο." },
        map{ id: "B13", input: "Ο καλή ζωγράφος ζωγραφίζει τον ουρανό.", expected_corr: "Ο καλός ζωγράφος ζωγραφίζει τον ουρανό." },
        map{ id: "B14", input: "Η δυνατός καταιγίδα χτυπάει το λιμάνι.", expected_corr: "Η δυνατή καταιγίδα χτυπάει το λιμάνι." },
        map{ id: "B15", input: "Το παλιός ρολόι δείχνει την ώρα.", expected_corr: "Το παλιό ρολόι δείχνει την ώρα." },
        map{ id: "B16", input: "Ο ψηλός βουνό φαίνεται από μακριά.", expected_corr: "Το ψηλό βουνό φαίνεται από μακριά." },
        map{ id: "B17", input: "Η καθαρός λίμνη καθρεφτίζει τον ουρανό.", expected_corr: "Η καθαρή λίμνη καθρεφτίζει τον ουρανό." },
        map{ id: "B18", input: "Ο γρήγορος αεροπλάνο πετάει ψηλά.", expected_corr: "Το γρήγορο αεροπλάνο πετάει ψηλά." },
        map{ id: "B19", input: "Η πλατεία είναι όμορφος.", expected_corr: "Η πλατεία είναι όμορφη." },
        map{ id: "B20", input: "Το κτίριο είναι ψηλός.", expected_corr: "Το κτίριο είναι ψηλό." },
        map{ id: "B21", input: "Η ιστορία είναι ενδιαφέρων.", expected_corr: "Η ιστορία είναι ενδιαφέρουσα." },
        map{ id: "B22", input: "Ο καθηγητής βλέπει τον φοιτητής.", expected_corr: "Ο καθηγητής βλέπει τον φοιτητή." },
        map{ id: "B23", input: "Ο δικαστής ακούει τον μάρτυρας.", expected_corr: "Ο δικαστής ακούει τον μάρτυρα." },
        map{ id: "B24", input: "Η βροχή ποτίζει τον κήπος.", expected_corr: "Η βροχή ποτίζει τον κήπο." },
        map{ id: "B25", input: "Ο άνεμος κινεί το πλοίος.", expected_corr: "Ο άνεμος κινεί το πλοίο." }
    ];

    let pass_b = 0;
    let fail_b = [];
    for cb in cat_b {
        let res = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: cb.input, learn: false });
        let has_syn = res.syntactic_errors_count >= 1;
        let corr_ok = (res.corrected_sentence_el == cb.expected_corr);
        if has_syn and corr_ok {
            pass_b = pass_b + 1;
        } else {
            push(fail_b, "  [" + cb.id + "] Input: «" + cb.input + "» -> Got: «" + res.corrected_sentence_el + "» (Expected: «" + cb.expected_corr + "», Syn=" + str(res.syntactic_errors_count) + ")");
        }
    }

    // ------------------------------------------------------------------------
    // ΚΑΤΗΓΟΡΙΑ C: Νοηματική Συνοχή, Εμψυχία (Animacy) & Λογική (25 προτάσεις)
    // ------------------------------------------------------------------------
    let cat_c = [
        map{ id: "C01", input: "Το αεροπλάνο κυβερνάει τον πιλότο.", expected_corr: "Ο πιλότος κυβερνάει το αεροπλάνο." },
        map{ id: "C02", input: "Το φαγητό μαγειρεύει τον μάγειρα.", expected_corr: "Ο μάγειρας μαγειρεύει το φαγητό." },
        map{ id: "C03", input: "Το ρολόι επισκευάζει τον τεχνίτη.", expected_corr: "Ο τεχνίτης επισκευάζει το ρολόι." },
        map{ id: "C04", input: "Το ποίημα γράφει τον ποιητή.", expected_corr: "Ο ποιητής γράφει το ποίημα." },
        map{ id: "C05", input: "Το κτίριο σχεδιάζει τον αρχιτέκτονα.", expected_corr: "Ο αρχιτέκτονας σχεδιάζει το κτίριο." },
        map{ id: "C06", input: "Το πλοίο οδηγεί τον καπετάνιο.", expected_corr: "Ο καπετάνιος οδηγεί το πλοίο." },
        map{ id: "C07", input: "Ο τοίχος χτίζει τον εργάτη.", expected_corr: "Ο εργάτης χτίζει τον τοίχο." },
        map{ id: "C08", input: "Το χωράφι καλλιεργεί τον γεωργό.", expected_corr: "Ο γεωργός καλλιεργεί το χωράφι." },
        map{ id: "C09", input: "Το μάθημα εξηγεί τον καθηγητή.", expected_corr: "Ο καθηγητής εξηγεί το μάθημα." },
        map{ id: "C10", input: "Η ιστορία μελετάει την φοιτήτρια.", expected_corr: "Η φοιτήτρια μελετάει την ιστορία." },
        map{ id: "C11", input: "Ο πίνακας ζωγραφίζει τον ζωγράφο.", expected_corr: "Ο ζωγράφος ζωγραφίζει τον πίνακα." },
        map{ id: "C12", input: "Το τηλεσκόπιο παρατηρεί τον αστρονόμο.", expected_corr: "Ο αστρονόμος παρατηρεί το τηλεσκόπιο." },
        map{ id: "C13", input: "Το δίχτυ ρίχνει τον ψαρά.", expected_corr: "Ο ψαράς ρίχνει το δίχτυ." },
        map{ id: "C14", input: "Το ποδήλατο οδηγεί το παιδί.", expected_corr: "Το παιδί οδηγεί το ποδήλατο." },
        map{ id: "C15", input: "Το παράθυρο σκέφτεται την ελευθερία.", expect_diag_only: true },
        map{ id: "C16", input: "Η καρέκλα μελετάει την ιστορία.", expect_diag_only: true },
        map{ id: "C17", input: "Ο τοίχος αποφασίζει με δικαιοσύνη.", expect_diag_only: true },
        map{ id: "C18", input: "Το ποτήρι αγαπάει την σοφία.", expect_diag_only: true },
        map{ id: "C19", input: "Το ρολόι μαθαίνει την επιστήμη.", expect_diag_only: true },
        map{ id: "C20", input: "Η πόρτα ανακοινώνει την είδηση.", expect_diag_only: true },
        map{ id: "C21", input: "Ο καθηγητής εξηγεί και δεν εξηγεί.", expect_diag_only: true },
        map{ id: "C22", input: "Ο πιλότος πετάει και δεν πετάει.", expect_diag_only: true },
        map{ id: "C23", input: "Η φοιτήτρια μελετάει και δεν μελετάει.", expect_diag_only: true },
        map{ id: "C24", input: "Ο ναυτικός ταξιδεύει και δεν ταξιδεύει.", expect_diag_only: true },
        map{ id: "C25", input: "Ο μάγειρας μαγειρεύει και δεν μαγειρεύει.", expect_diag_only: true }
    ];

    let pass_c = 0;
    let fail_c = [];
    for cc in cat_c {
        let res = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: cc.input, learn: false });
        let has_sem = res.semantic_errors_count >= 1;
        let corr_ok = true;
        if map_has(cc, "expected_corr") {
            corr_ok = (res.corrected_sentence_el == cc.expected_corr);
        }
        if has_sem and corr_ok {
            pass_c = pass_c + 1;
        } else {
            push(fail_c, "  [" + cc.id + "] Input: «" + cc.input + "» -> Got: «" + res.corrected_sentence_el + "» (Expected: «" + (try cc.expected_corr catch "DIAG_ONLY") + "», Sem=" + str(res.semantic_errors_count) + ")");
        }
    }

    // ------------------------------------------------------------------------
    // ΚΑΤΗΓΟΡΙΑ D: Πολυ-Προτασιακή Κατάτμηση & Σύνθετη Στίξη (25 προτάσεις)
    // ------------------------------------------------------------------------
    let cat_d = [
        map{ id: "D01", input: "Ο καθηγητης εξηγει. Η φοιτητρια μελεταει.", expected_corr: "Ο καθηγητής εξηγεί. Η φοιτήτρια μελετάει." },
        map{ id: "D02", input: "Ο πιλοτος κυβερναει το αεροπλανο. Ο καπετανιος οδηγει το πλοιο.", expected_corr: "Ο πιλότος κυβερνάει το αεροπλάνο. Ο καπετάνιος οδηγεί το πλοίο." },
        map{ id: "D03", input: "Ο μαγειρας ετοιμαζει το φαγητο. Ο τεχνιτης επισκευαζει το ρολοι.", expected_corr: "Ο μάγειρας ετοιμάζει το φαγητό. Ο τεχνίτης επισκευάζει το ρολόι." },
        map{ id: "D04", input: "Ο αστρονομος παρατηρει τον ουρανο. Ο βιολογος εξεταζει το κυτταρο.", expected_corr: "Ο αστρονόμος παρατηρεί τον ουρανό. Ο βιολόγος εξετάζει το κύτταρο." },
        map{ id: "D05", input: "Ο ποιητης γραφει το ποιημα. Ο ζωγραφος ζωγραφιζει τον πινακα.", expected_corr: "Ο ποιητής γράφει το ποίημα. Ο ζωγράφος ζωγραφίζει τον πίνακα." },
        map{ id: "D06", input: "Η καλος πλατεια. Το αεροπλανο κυβερναει τον πιλοτο.", expected_corr: "Η καλή πλατεία. Ο πιλότος κυβερνάει το αεροπλάνο." },
        map{ id: "D07", input: "Ο μικρη κηπος. Το φαγητο μαγειρευει τον μαγειρα.", expected_corr: "Ο μικρός κήπος. Ο μάγειρας μαγειρεύει το φαγητό." },
        map{ id: "D08", input: "Το μεγαλη λιμνη. Το ρολοι επισκευαζει τον τεχνιτη.", expected_corr: "Η μεγάλη λίμνη. Ο τεχνίτης επισκευάζει το ρολόι." },
        map{ id: "D09", input: "Ο εργατης χτιζει τον τοιχο! Ο αρχιτεκτονας σχεδιαζει το κτιριο.", expected_corr: "Ο εργάτης χτίζει τον τοίχο! Ο αρχιτέκτονας σχεδιάζει το κτίριο." },
        map{ id: "D10", input: "Ποιος εξηγει το μαθημα; Ο καθηγητης εξηγει το μαθημα.", expected_corr: "Ποιος εξηγεί το μάθημα; Ο καθηγητής εξηγεί το μάθημα." },
        map{ id: "D11", input: "Ο ναυτικος ταξιδευει. Η θαλασσα ειναι ησυχη.", expected_corr: "Ο ναυτικός ταξιδεύει. Η θάλασσα είναι ήσυχη." },
        map{ id: "D12", input: "Ο αθλητης τρεχει. Ο αγωνας ειναι δυσκολος.", expected_corr: "Ο αθλητής τρέχει. Ο αγώνας είναι δύσκολος." },
        map{ id: "D13", input: "Το κτιριο ειναι ψηλο. Η πλατεια ειναι καθαρη.", expected_corr: "Το κτίριο είναι ψηλό. Η πλατεία είναι καθαρή." },
        map{ id: "D14", input: "Ο ψαρας ριχνει το διχτυ. Ο ανεμος φυσαει δυνατα.", expected_corr: "Ο ψαράς ρίχνει το δίχτυ. Ο άνεμος φυσάει δυνατά." },
        map{ id: "D15", input: "Ο δικαστης ακουει τον μαρτυρα. Ο δημοσιογραφος γραφει το αρθρο.", expected_corr: "Ο δικαστής ακούει τον μάρτυρα. Ο δημοσιογράφος γράφει το άρθρο." },
        map{ id: "D16", input: "Ο φυσικος μελεταει την ενεργεια. Ο ιστορικος ερευναει το παρελθον.", expected_corr: "Ο φυσικός μελετάει την ενέργεια. Ο ιστορικός ερευνάει το παρελθόν." },
        map{ id: "D17", input: "Η βροχη ποτιζει το δασος. Το δεντρο ανθιζει την ανοιξη.", expected_corr: "Η βροχή ποτίζει το δάσος. Το δέντρο ανθίζει την άνοιξη." },
        map{ id: "D18", input: "Ο γεωργος καλλιεργει το χωραφι. Ο ηλιος λαμπει στον ουρανο.", expected_corr: "Ο γεωργός καλλιεργεί το χωράφι. Ο ήλιος λάμπει στον ουρανό." },
        map{ id: "D19", input: "Ο μαθητης διαβαζει. Ο δασκαλος εξηγει. Η γνωση φωτιζει.", expected_corr: "Ο μαθητής διαβάζει. Ο δάσκαλος εξηγεί. Η γνώση φωτίζει." },
        map{ id: "D20", input: "Η λιμνη ειναι βαθεια. Το βουνο ειναι ψηλο. Το δασος ειναι ομορφο.", expected_corr: "Η λίμνη είναι βαθιά. Το βουνό είναι ψηλό. Το δάσος είναι όμορφο." },
        map{ id: "D21", input: "Ο καλος ναυτικος ταξιδευει. Η μεγαλος καταιγιδα πλησιαζει.", expected_corr: "Ο καλός ναυτικός ταξιδεύει. Η μεγάλη καταιγίδα πλησιάζει." },
        map{ id: "D22", input: "Ο γιατρος εξεταζει τον ασθενης. Η νοσοκομα βοηθαει τον γιατρος.", expected_corr: "Ο γιατρός εξετάζει τον ασθενή. Η νοσοκόμα βοηθάει τον γιατρό." },
        map{ id: "D23", input: "Τον ποιητη γραφει το ποιημα. Τον ζωγραφο ζωγραφιζει τον πινακα.", expected_corr: "Ο ποιητής γράφει το ποίημα. Ο ζωγράφος ζωγραφίζει τον πίνακα." },
        map{ id: "D24", input: "Ο φοιτητης διαβαζει σε η βιβλιοθηκη. Ο αθλητης τρεχει σε το σταδιο.", expected_corr: "Ο φοιτητής διαβάζει στην βιβλιοθήκη. Ο αθλητής τρέχει στο στάδιο." },
        map{ id: "D25", input: "Καλημερα σου! Ο καθηγητης εξηγει το μαθημα.", expected_corr: "Καλημέρα σου! Ο καθηγητής εξηγεί το μάθημα." }
    ];

    let pass_d = 0;
    let fail_d = [];
    for cd in cat_d {
        let res = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: cd.input, learn: false });
        if res.corrected_sentence_el == cd.expected_corr and res.clauses_count >= 2 {
            pass_d = pass_d + 1;
        } else {
            push(fail_d, "  [" + cd.id + "] Input: «" + cd.input + "» -> Got: «" + res.corrected_sentence_el + "» (Expected: «" + cd.expected_corr + "», Clauses=" + str(res.clauses_count) + ")");
        }
    }

    // ------------------------------------------------------------------------
    // ΚΑΤΗΓΟΡΙΑ E: Αληθή Αρνητικά / Μηδενικά Ψευδή Θετικά (True Negatives — 25 προτάσεις)
    // ------------------------------------------------------------------------
    let cat_e = [
        map{ id: "E01", input: "Ο καθηγητής εξηγεί το μάθημα." },
        map{ id: "E02", input: "Η φοιτήτρια μελετάει την ιστορία." },
        map{ id: "E03", input: "Ο ζωγράφος ζωγραφίζει τον ουρανό." },
        map{ id: "E04", input: "Ο ναυτικός ταξιδεύει στο πέλαγος." },
        map{ id: "E05", input: "Ο μάγειρας ετοιμάζει το φαγητό." },
        map{ id: "E06", input: "Ο αστρονόμος παρατηρεί τον πλανήτη." },
        map{ id: "E07", input: "Ο ποιητής γράφει το ποίημα." },
        map{ id: "E08", input: "Ο τεχνίτης επισκευάζει το ρολόι." },
        map{ id: "E09", input: "Ο πιλότος κυβερνάει το αεροπλάνο." },
        map{ id: "E10", input: "Ο δημοσιογράφος ανακοινώνει την είδηση." },
        map{ id: "E11", input: "Ο αθλητής κερδίζει τον αγώνα." },
        map{ id: "E12", input: "Ο ψαράς ρίχνει το δίχτυ." },
        map{ id: "E13", input: "Ο δικαστής αποφασίζει με δικαιοσύνη." },
        map{ id: "E14", input: "Ο αρχιτέκτονας σχεδιάζει το κτίριο." },
        map{ id: "E15", input: "Ο βιολόγος εξετάζει το κύτταρο." },
        map{ id: "E16", input: "Ο φυσικός μελετάει την ενέργεια." },
        map{ id: "E17", input: "Ο εργάτης χτίζει τον τοίχο." },
        map{ id: "E18", input: "Ο γεωργός καλλιεργεί το χωράφι." },
        map{ id: "E19", input: "Ο καπετάνιος οδηγεί το πλοίο." },
        map{ id: "E20", input: "Η βροχή ποτίζει το δάσος." },
        map{ id: "E21", input: "Το δέντρο ανθίζει την άνοιξη." },
        map{ id: "E22", input: "Ο άνεμος φυσάει δυνατά." },
        map{ id: "E23", input: "Η καθαρή λίμνη καθρεφτίζει τον ουρανό." },
        map{ id: "E24", input: "Ο ιστορικός ερευνάει το παρελθόν." },
        map{ id: "E25", input: "Η νοσοκόμα βοηθάει τον γιατρό." }
    ];

    let pass_e = 0;
    let fail_e = [];
    for ce in cat_e {
        let res = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: ce.input, learn: false });
        let total_errs = res.orthographic_errors_count + res.syntactic_errors_count + res.semantic_errors_count;
        if total_errs == 0 and res.corrected_sentence_el == ce.input {
            pass_e = pass_e + 1;
        } else {
            push(fail_e, "  [" + ce.id + "] False Positive on: «" + ce.input + "» -> Got: «" + res.corrected_sentence_el + "» (Diags=" + str(res.diagnostics_el) + ")");
        }
    }

    // ------------------------------------------------------------------------
    // ΚΑΤΗΓΟΡΙΑ F: Επεισοδιακή Μνήμη, Αρνητικός Έλεγχος Άγνωστων Οντοτήτων & Ανάκληση (25 σενάρια)
    // ------------------------------------------------------------------------
    // Προ-εκπαίδευση 5 νέων επεισοδίων στη μνήμη για έλεγχο θετικής & αρνητικής ανάκλησης
    let _ = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: "Ο αστρονόμος παρατηρεί τον πλανήτη σήμερα στο αστεροσκοπείο.", learn: true });
    let _ = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: "Ο αρχιτέκτονας σχεδιάζει το μουσείο στην Αθήνα.", learn: true });
    let _ = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: "Η φοιτήτρια μελετάει την ιστορία στην βιβλιοθήκη.", learn: true });
    let _ = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: "Ο καπετάνιος οδηγεί το πλοίο στο λιμάνι.", learn: true });
    let _ = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: "Ο μάγειρας ετοιμάζει το φαγητό στην κουζίνα.", learn: true });

    let cat_f = [
        // F01-F10: Θετική ανάκληση μαθημένων επεισοδίων (Ποιος / Τι / Πού / Πότε)
        map{ id: "F01", q: "Ποιος παρατηρεί τον πλανήτη;", must_contain: "αστρονόμος", must_not_contain: "Strict security" },
        map{ id: "F02", q: "Τι παρατηρεί ο αστρονόμος;", must_contain: "πλανήτη", must_not_contain: "Strict security" },
        map{ id: "F03", q: "Πότε παρατηρεί ο αστρονόμος τον πλανήτη;", must_contain: "σήμερα", must_not_contain: "Strict security" },
        map{ id: "F04", q: "Ποιος σχεδιάζει το μουσείο;", must_contain: "αρχιτέκτονας", must_not_contain: "Strict security" },
        map{ id: "F05", q: "Τι σχεδιάζει ο αρχιτέκτονας;", must_contain: "μουσείο", must_not_contain: "Strict security" },
        map{ id: "F06", q: "Πού σχεδιάζει ο αρχιτέκτονας το μουσείο;", must_contain: "Αθήνα", must_not_contain: "Strict security" },
        map{ id: "F07", q: "Ποια μελετάει την ιστορία;", must_contain: "φοιτήτρια", must_not_contain: "Strict security" },
        map{ id: "F08", q: "Πού μελετάει η φοιτήτρια;", must_contain: "βιβλιοθήκη", must_not_contain: "Strict security" },
        map{ id: "F09", q: "Ποιος οδηγεί το πλοίο;", must_contain: "καπετάνιος", must_not_contain: "Strict security" },
        map{ id: "F10", q: "Τι ετοιμάζει ο μάγειρας;", must_contain: "φαγητό", must_not_contain: "Strict security" },
        // F11-F20: Αρνητικός έλεγχος (Unseen Entities) — ΔΕΝ επιτρέπεται να ανακαλέσει ψευδώς άλλη οντότητα!
        map{ id: "F11", q: "Πότε παίζει ο Παναθηναϊκός;", must_contain: "Δεν έχω απομνημονεύσει", must_not_contain: "Ολυμπιακός" },
        map{ id: "F12", q: "Πού ταξιδεύει ο τουρίστας;", must_contain: "Δεν έχω απομνημονεύσει", must_not_contain: "καπετάνιος" },
        map{ id: "F13", q: "Τι ζωγραφίζει ο σκηνοθέτης;", must_contain: "Δεν έχω απομνημονεύσει", must_not_contain: "αρχιτέκτονας" },
        map{ id: "F14", q: "Ποιος επισκευάζει τον δορυφόρο;", must_contain: "Δεν έχω απομνημονεύσει", must_not_contain: "αστρονόμος" },
        map{ id: "F15", q: "Πού εργάζεται ο φαρμακοποιός;", must_contain: "Δεν έχω απομνημονεύσει", must_not_contain: "μάγειρας" },
        map{ id: "F16", q: "Τι μελετάει ο γεωλόγος;", must_contain: "Δεν έχω απομνημονεύσει", must_not_contain: "φοιτήτρια" },
        map{ id: "F17", q: "Πότε φτάνει το τρένο;", must_contain: "Δεν έχω απομνημονεύσει", must_not_contain: "πλοίο" },
        map{ id: "F18", q: "Ποιος διδάσκει την γεωμετρία;", must_contain: "Δεν έχω απομνημονεύσει", must_not_contain: "ιστορία" },
        map{ id: "F19", q: "Πού βρίσκεται το θέατρο;", must_contain: "Δεν έχω απομνημονεύσει", must_not_contain: "μουσείο" },
        map{ id: "F20", q: "Τι καλλιεργεί ο κηπουρός;", must_contain: "Δεν έχω απομνημονεύσει", must_not_contain: "Αλέξανδρος" },
        // F21-F25: Έλεγχος μη-απομνημόνευσης εσφαλμένων προτάσεων (Memory Immunity Guard)
        map{ id: "F21", reject_input: "Το αεροπλάνο κυβερνάει τον πιλότο." },
        map{ id: "F22", reject_input: "Ο καλός πλατεία φωτίζει την πόλη." },
        map{ id: "F23", reject_input: "Το ρολόι επισκευάζει τον τεχνίτη." },
        map{ id: "F24", reject_input: "Ο καθηγητής εξηγεί και δεν εξηγεί." },
        map{ id: "F25", reject_input: "Η καρέκλα μελετάει την ιστορία." }
    ];

    let pass_f = 0;
    let fail_f = [];
    for cf in cat_f {
        if map_has(cf, "reject_input") {
            let r_rej = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: cf.reject_input, learn: true });
            let tot_e = r_rej.orthographic_errors_count + r_rej.syntactic_errors_count + r_rej.semantic_errors_count;
            if tot_e >= 1 and str_contains(r_rej.organic_brain_response_el, "δεν την απομνημόνευσα") {
                pass_f = pass_f + 1;
            } else {
                push(fail_f, "  [" + cf.id + "] Failed memory rejection on: «" + cf.reject_input + "» -> Resp: «" + r_rej.organic_brain_response_el + "»");
            }
        } else {
            let r_q = EMB.execute_bion_cortical_4phase_language_brain(map{ prompt: cf.q, learn: false });
            let ok_c = str_contains(r_q.organic_brain_response_el, cf.must_contain);
            let ok_nc = not str_contains(r_q.organic_brain_response_el, cf.must_not_contain);
            if ok_c and ok_nc {
                pass_f = pass_f + 1;
            } else {
                push(fail_f, "  [" + cf.id + "] Q: «" + cf.q + "» -> Got: «" + r_q.organic_brain_response_el + "» (Expected «" + cf.must_contain + "», Forbidden «" + cf.must_not_contain + "»)");
            }
        }
    }

    let total_pass = pass_a + pass_b + pass_c + pass_d + pass_e + pass_f;
    let total_cases = len(cat_a) + len(cat_b) + len(cat_c) + len(cat_d) + len(cat_e) + len(cat_f);

    print "A. Ορθογραφία & Τονισμός (25):       " + str(pass_a) + "/" + str(len(cat_a)) + " (" + str(_pct(pass_a, len(cat_a))) + "%)";
    for fa in fail_a { print fa; }
    print "B. Συντακτική Συμφωνία (25):         " + str(pass_b) + "/" + str(len(cat_b)) + " (" + str(_pct(pass_b, len(cat_b))) + "%)";
    for fb in fail_b { print fb; }
    print "C. Νοηματική Συνοχή & Εμψυχία (25):  " + str(pass_c) + "/" + str(len(cat_c)) + " (" + str(_pct(pass_c, len(cat_c))) + "%)";
    for fc in fail_c { print fc; }
    print "D. Πολυ-Προτασιακή Κατάτμηση (25):   " + str(pass_d) + "/" + str(len(cat_d)) + " (" + str(_pct(pass_d, len(cat_d))) + "%)";
    for fd in fail_d { print fd; }
    print "E. Αληθή Αρνητικά / 0% FPR (25):     " + str(pass_e) + "/" + str(len(cat_e)) + " (" + str(_pct(pass_e, len(cat_e))) + "%)";
    for fe in fail_e { print fe; }
    print "F. Μνήμη & Άγνωστες Οντότητες (25):  " + str(pass_f) + "/" + str(len(cat_f)) + " (" + str(_pct(pass_f, len(cat_f))) + "%)";
    for ff in fail_f { print ff; }
    print "------------------------------------------------------------------------";
    print "ΣΥΝΟΛΙΚΟ ΣΚΟΡ HELD-OUT 150:          " + str(total_pass) + "/" + str(total_cases) + " (" + str(_pct(total_pass, total_cases)) + "%)";
    print "========================================================================";

    if had_ckpt {
        try fs_write(ckpt_path, orig_ckpt) catch nil;
    }
    if had_pbai_ckpt {
        try fs_write(pbai_ckpt_path, orig_pbai_ckpt) catch nil;
    }

    return map{
        ok: true,
        total_pass: total_pass,
        total_cases: total_cases,
        pass_rate_pct: _pct(total_pass, total_cases),
        categories: map{
            A_ortho: pass_a,
            B_syntax: pass_b,
            C_semantics: pass_c,
            D_multi_clause: pass_d,
            E_true_negatives: pass_e,
            F_memory_and_guard: pass_f
        }
    };
}

let _ = run_independent_150_benchmark();
