// pblang/emulators/physical_hardware_manager.sapp
// Complete Physical Hardware Connection, Auto-Discovery, Transport Configuration,
// Firmware Flashing, Live Telemetry, Safe Hot-Unplug & Dual-Mode (Physical <-> Emulator)
// Management Engine in 100% Pure PBLang.

let Emulators = import("hardware_emulators_suite.sapp");

fn _get(m, k, d) {
    if type(m) == "map" and map_has(m, k) {
        return m[k];
    }
    return d;
}

// ============================================================================
// 1. Hardware Catalog & Physical Bus Signatures (USB VID:PID, UART, I2C, SPI, BLE, NFC, evdev, ADB)
// ============================================================================
fn hardware_device_catalog() {
    return map{
        "arduino_uno_r4_wifi": map{
            device_id: "arduino_uno_r4_wifi",
            display_name: "Arduino Uno R4 WiFi (Renesas RA4M1 + ESP32-S3 + 12x8 LED Matrix)",
            bus_type: "usb_cdc_acm_and_hid",
            linux_dev_nodes: ["/dev/ttyACM0", "/dev/ttyACM1"],
            usb_vid_pid: ["2341:1002", "2341:006d"],
            uart_config: map{ baud: 115200, data_bits: 8, parity: "N", stop_bits: 1, flow_control: "none" },
            flash_protocol: "bossa_renesas_ra4m1_dfu",
            safe_shutdown_state: "GPIO_ALL_HIGH_Z_LED_MATRIX_OFF"
        },
        "esp32_d": map{
            device_id: "esp32_d",
            display_name: "ESP32-D Dual-Core (Xtensa LX6 240MHz, 40-Pin GPIO, I2C/SPI/PWM/Wi-Fi)",
            bus_type: "usb_uart_bridge",
            linux_dev_nodes: ["/dev/ttyUSB0", "/dev/ttyUSB1"],
            usb_vid_pid: ["10c4:ea60", "1a86:7523"],
            uart_config: map{ baud: 921600, runtime_baud: 115200, data_bits: 8, parity: "N", stop_bits: 1 },
            flash_protocol: "esptool_slip_packet_v2",
            safe_shutdown_state: "GPIO_HOLD_RELEASE_PWM_ZERO"
        },
        "bme688_sensor": map{
            device_id: "bme688_sensor",
            display_name: "Bosch BME688 4-in-1 Gas, VOC, IAQ, Pressure, Humidity & Temp Sensor",
            bus_type: "i2c_or_spi",
            linux_dev_nodes: ["/dev/i2c-1", "/dev/i2c-0", "/dev/spidev0.0"],
            i2c_addresses: ["0x76", "0x77"],
            chip_id_register: "0xD0",
            expected_chip_id: 97,
            safe_shutdown_state: "SLEEP_MODE_HEATER_OFF_REG_0x74_0x00"
        },
        "cnc_3d_printer": map{
            device_id: "cnc_3d_printer",
            display_name: "3D Printer / 3-Axis CNC Controller (Marlin / Grbl Stepper & Thermal Bus)",
            bus_type: "usb_serial_gcode",
            linux_dev_nodes: ["/dev/ttyACM0", "/dev/ttyUSB0"],
            uart_config: map{ baud: 250000, fallback_baud: 115200, line_checksum: true },
            flash_protocol: "gcode_numbered_checksum_stream",
            safe_shutdown_state: "M112_EMERGENCY_STOP_HEATERS_OFF_STEPPERS_DISABLED"
        },
        "nfc_iso14443a_reader": map{
            device_id: "nfc_iso14443a_reader",
            display_name: "ISO-14443A / NTAG215 NFC Reader & Writer (PC/SC & NCI)",
            bus_type: "usb_ccid_pcsc_or_hidraw",
            linux_dev_nodes: ["/dev/hidraw0", "/run/pcscd/pcscd.comm"],
            rf_frequency_hz: 13560000,
            safe_shutdown_state: "RF_FIELD_OFF_UNPOWERED"
        },
        "ble_tag_m2543t1": map{
            device_id: "ble_tag_m2543t1",
            display_name: "BLE Smart Tag M2543T1 (CR2032 3.0V GATT & Advertising Beacon)",
            bus_type: "bluetooth_le_hci",
            linux_dev_nodes: ["/sys/class/bluetooth/hci0"],
            advertising_channels: [37, 38, 39],
            safe_shutdown_state: "GATT_DISCONNECT_PASSIVE_SCAN_ONLY"
        },
        "baseus_bs_ps011_stylus": map{
            device_id: "baseus_bs_ps011_stylus",
            display_name: "Baseus BS-PS011 Active/Passive Capacitive Stylus & Interactive Touch Board",
            bus_type: "linux_evdev_multitouch",
            linux_dev_nodes: ["/dev/input/event0", "/dev/input/event4"],
            safe_shutdown_state: "EVDEV_UNGRAB_RELEASE_TOUCH_SLOTS"
        },
        "alcatel_3x_mobile": map{
            device_id: "alcatel_3x_mobile",
            display_name: "Alcatel 3X (MediaTek MT6739 Android USB/ADB & Sensor Bridge)",
            bus_type: "usb_adb_and_mtp",
            linux_dev_nodes: ["/dev/bus/usb"],
            usb_vid_pid: ["1bbb:00f2", "18d1:4ee7"],
            safe_shutdown_state: "ADB_DISCONNECT_SAFE_UNMOUNT"
        }
