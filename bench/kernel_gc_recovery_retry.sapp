// pblang:target=kernel
// pblang:extern heap_init heap_alloc gc_new gc_set_auto gc_set_threshold gc_alloc gc_set_child gc_add_root gc_live gc_collections gc_alloc_low_memory
// Same pressure cycle before/after: keep a 130-node rooted ring, reclaim 200
// leaves from an exhausted arena, allocate one replacement, then 199 leaves.
// The old retry may perform two collections; the new retry performs one.
fn check(ok) { if not ok { outb(244,1); while 1>0 { hlt(); } } }
fn kmain() {
    let h=kmalloc(8);let region=kmalloc(16384);heap_init(h,region,16384);
    let g=gc_new(h);check(g!=0);gc_set_auto(g,0);
    let first=gc_alloc(g,1);check(first!=0);let last=first;let i=1;
    while i<130 {let next=gc_alloc(g,1);check(next!=0);gc_set_child(last,0,next);last=next;i=i+1;}
    gc_set_child(last,0,first);check(gc_add_root(g,first)==1);
    i=0;while i<200 {check(gc_alloc(g,0)!=0);i=i+1;}
    let filler=heap_alloc(h,8);while filler!=0 {filler=heap_alloc(h,8);}
    gc_set_threshold(g,0);let pass=0;
    while pass<10000 {
        check(peek32(h)==0 and gc_live(g)==330);gc_set_auto(g,1);
        check(gc_alloc_low_memory(g,0)!=0 and gc_live(g)==131 and peek32(g+4)==1);
        gc_set_auto(g,0);i=0;while i<199 {check(gc_alloc(g,0)!=0);i=i+1;}
        pass=pass+1;
    }
    check(gc_live(g)==330 and peek32(h)==0 and peek32(last+8)==first);
    let count=gc_collections(g);check(count==10000 or count==20000);
    outb(244,42);while 1>0 {hlt();}
}
