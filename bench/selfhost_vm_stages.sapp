// Pure-pblang bytecode-VM benchmark. Compile once, execute repeatedly.
let FE = import("stdlib/compiler/selfhost_frontend.sapp");
let VM = import("stdlib/compiler/vm.sapp");

let SRC = "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } return fib(18);";
let chunk = FE.frontend_compile(SRC).chunk;
let rounds = 5;
let t0 = now_ms();
let i = 0;
while i < rounds { VM.run(chunk); i = i + 1; }
let elapsed = now_ms() - t0;

print "SELFHOST_VM_FIB18_AVG_ms=" + str(elapsed / rounds);
print "SELFHOST_VM_FIB18_ROUNDS=" + str(rounds);
