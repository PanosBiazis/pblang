// Identical source for before/after runs. Time the process externally as well.
let CP = import("stdlib:compute.sapp");
let OS = import("stdlib:os.sapp");
let args = OS.script_args();
let mode = if len(args) > 0 { args[0] } else { "small" };
let rounds = if len(args) > 1 { parse_number(args[1]) } else { 100 };
assert(rounds >= 1 and rounds <= 100000, "benchmark rounds 1..100000");
assert(mode == "small" or mode == "cpu" or mode == "injected", "benchmark mode: small, cpu, injected");
fn options_for(mode) {
    if mode == "cpu" { return map{ preferred_device: "cpu" }; }
    if mode == "injected" { return map{ preferred_device: "cpu", devices: [] }; }
    return nil;
}
let options = options_for(mode);
let i = 0;
let checksum = 0;
while i < rounds {
    let result = CP.run_controlled([2, 3, 4, 5], fn(x) { return x * x; }, options);
    assert(result.ok and result.results == [4, 9, 16, 25], "equivalent results");
    checksum = checksum + result.results[3];
    i = i + 1;
}
assert(checksum == rounds * 25, "checksum");
print "COMPUTE_DISCOVERY|" + mode + "|" + str(rounds) + "|" + str(checksum);
