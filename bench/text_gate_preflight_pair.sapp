let OLD=import(env_get("PB_TEXT_GATE_REFERENCE"));
let NEW=import("stdlib:project_text_audit.sapp");
let B=import("stdlib:benchmark.sapp");
let roots=["tests/fixtures/module_audit/tools"];
let options=map{max_files:10,max_files_per_module:10,max_file_bytes:10000,max_findings_per_file:16};
let modules=NEW.audit_modules("fixture",roots,options).modules;
fn invoke(m,kind) {
    if kind=="roots" {return m.audit_roots("fixture",roots,options);}
    if kind=="modules" {return m.audit_modules("fixture",roots,options);}
    if kind=="combine-nil" {return m.combine_module_reports("fixture",modules,map{max_medium:nil,max_source_medium:nil,source_only_blockers:nil});}
    return m.combine_module_reports("fixture",modules,options);
}
fn normalize(v) {
    if type(v)=="map" {
        let result=map{};
        for key in map_keys(v) {result[key]=if key=="duration_ms" {0} else {normalize(v[key])};}
        return result;
    }
    if type(v)=="array" {let result=[];for item in v {push(result,normalize(item));}return result;}
    return v;
}
fn measure(m,kind,calls) {
    let start=now_ms();let result=nil;
    for i calls {result=invoke(m,kind);}
    return map{ms:now_ms()-start,result:result};
}
for kind in ["roots","modules","combine","combine-nil"] {
    let calls=if kind=="roots" or kind=="modules" {1} else {100};
    let expected=json_stringify(normalize(invoke(OLD,kind)));
    let before=[];let after=[];let ratios=[];
    for i 10 {
        let a=nil;let b=nil;
        if i%2==0 {a=measure(OLD,kind,calls);b=measure(NEW,kind,calls);}
        else {b=measure(NEW,kind,calls);a=measure(OLD,kind,calls);}
        if json_stringify(normalize(a.result))!=expected or json_stringify(normalize(b.result))!=expected
            or a.ms<=0 or b.ms<=0 {throw "text gate benchmark parity or clock failure";}
        if i>=2 {push(before,a.ms);push(after,b.ms);push(ratios,b.ms/a.ms);}
    }
    print json_stringify(map{operation:kind,calls:calls,warmup_pairs:2,retained_pairs:8,
        before_ms:before,after_ms:after,paired_ratios:ratios,
        before_stats:B.stats("before",before),after_stats:B.stats("after",after),ratio_stats:B.stats("ratio",ratios)});
}
