// PBLang-only warm benchmark for the extended application facade. It performs
// no external I/O; process startup is measured separately by the runner.
let APP = import("stdlib:app.sapp");

let REST_SPEC = map{
    kind: "rest", name: "bench-rest", preview: true,
    action: fn(ctx) { return map{ ok: true }; }
};
let DESKTOP_SPEC = map{
    kind: "desktop", name: "bench-desktop", preview: true,
    model: map{ state: "ready" },
    widgets: [map{ kind: "label", bind: "state" }, map{ kind: "button", text: "Run" }]
};
let GAME_SPEC = map{
    kind: "game", name: "bench-game", preview: true, preview_execute: true,
    steps: 16, action: fn(ctx) { return ctx.modules.game.vec2(ctx.step, ctx.step * 2); }
};
let MEDIA_SPEC = map{
    kind: "multimedia", name: "bench-media", preview: true, preview_execute: true,
    action: fn(ctx) {
        return ctx.modules.image.invert_colors(ctx.modules.image.make_image(16, 16, [10, 20, 30, 255]));
    }
};
let DB_SPEC = map{
    kind: "database", name: "bench-db", preview: true, preview_execute: true, allow_io: true,
    action: fn(ctx) { return ctx.modules.db.sql_placeholders(8); }
};
let NETWORK_SPEC = map{
    kind: "networking", name: "bench-network", preview: true, preview_execute: true, allow_io: true,
    action: fn(ctx) { return ctx.modules.networking.new_request("GET", "https://example.invalid"); }
};
let AUTOMATION_SPEC = map{
    kind: "automation", name: "bench-automation", preview: true, preview_execute: true,
    action: fn(ctx) {
        let workflow = ctx.modules.workflow;
        let pipeline = workflow.new();
        workflow.register(pipeline, "add", fn(value, params) { return value + params.amount; });
        workflow.add_node(pipeline, "a", "add", map{ amount: 2 });
        workflow.add_node(pipeline, "b", "add", map{ amount: 3 });
        workflow.connect(pipeline, "a", "b");
        return workflow.run(pipeline, 5).b;
    }
};
let AI_SPEC = map{
    kind: "ai", name: "bench-ai", preview: true, preview_execute: true, allow_io: true,
    action: fn(ctx) { return ctx.modules.ai.cosine_similarity([1, 2, 3, 4], [1, 2, 3, 4]); }
};
let ML_SPEC = map{
    kind: "ml", name: "bench-ml", preview: true, preview_execute: true,
    action: fn(ctx) {
        let model = ctx.modules.ml.linreg_fit([1, 2, 3, 4], [2, 4, 6, 8]);
        return ctx.modules.ml.linreg_predict(model, 5);
    }
};
let DOMAIN_SPECS = [GAME_SPEC, MEDIA_SPEC, DB_SPEC, NETWORK_SPEC, AUTOMATION_SPEC, AI_SPEC, ML_SPEC];

fn validate_domains() {
    let i = 0;
    while i < len(DOMAIN_SPECS) { APP.validate(DOMAIN_SPECS[i]); i = i + 1; }
}

fn plan_domains() {
    let i = 0;
    while i < len(DOMAIN_SPECS) {
        let spec = DOMAIN_SPECS[i];
        let was_execute = spec.preview_execute;
        spec.preview_execute = false;
        APP.plan(spec);
        spec.preview_execute = was_execute;
        i = i + 1;
    }
}

fn sorted(values) {
    let out = [];
    let i = 0;
    while i < len(values) { array_push(out, values[i]); i = i + 1; }
    i = 1;
    while i < len(out) {
        let value = out[i];
        let j = i - 1;
        while j >= 0 and out[j] > value { out[j + 1] = out[j]; j = j - 1; }
        out[j + 1] = value;
        i = i + 1;
    }
    return out;
}

fn stage(name, iterations, samples, thunk) {
    let measurements = [];
    let sample = 0;
    while sample < samples {
        let started = now_ms();
        let i = 0;
        while i < iterations { thunk(); i = i + 1; }
        array_push(measurements, now_ms() - started);
        sample = sample + 1;
    }
    let ordered = sorted(measurements);
    let median = ordered[num_floor(len(ordered) / 2)];
    let p95_index = num_floor((len(ordered) * 95 + 99) / 100) - 1;
    let p95 = ordered[p95_index];
    print "APP_DOMAIN_PHASE|" + name
        + "|iterations=" + str(iterations)
        + "|samples=" + str(samples)
        + "|median_ms=" + str(median)
        + "|p95_ms=" + str(p95)
        + "|median_per_op_ms=" + str(median / iterations);
}

if not APP.validate(REST_SPEC).ok or not APP.validate(DESKTOP_SPEC).ok { throw "app domain benchmark invalid adapter spec"; }
validate_domains();
plan_domains();
if APP.run(REST_SPEC).response.status != 200 { throw "app domain benchmark REST mismatch"; }
if APP.run(DESKTOP_SPEC).widgets != 2 { throw "app domain benchmark desktop mismatch"; }
if APP.run(GAME_SPEC).value.x != 15 { throw "app domain benchmark game mismatch"; }
if APP.run(MEDIA_SPEC).value[0][0][0] != 245 { throw "app domain benchmark multimedia mismatch"; }
if APP.run(DB_SPEC).value != "?,?,?,?,?,?,?,?" { throw "app domain benchmark database mismatch"; }
if APP.run(NETWORK_SPEC).value._sent != false { throw "app domain benchmark networking mismatch"; }
if APP.run(AUTOMATION_SPEC).value != 10 { throw "app domain benchmark automation mismatch"; }
if APP.run(AI_SPEC).value != 1 { throw "app domain benchmark AI mismatch"; }
if APP.run(ML_SPEC).value != 10 { throw "app domain benchmark ML mismatch"; }

stage("validate_seven_domains", 1000, 7, fn() { validate_domains(); });
stage("plan_seven_domains_no_execute", 1000, 7, fn() { plan_domains(); });
stage("rest_secure_preview", 100, 7, fn() { APP.run(REST_SPEC); });
stage("desktop_preview", 100, 7, fn() { APP.run(DESKTOP_SPEC); });
stage("game_16_steps", 200, 7, fn() { APP.run(GAME_SPEC); });
stage("image_invert_16x16", 100, 7, fn() { APP.run(MEDIA_SPEC); });
stage("database_builder", 500, 7, fn() { APP.run(DB_SPEC); });
stage("network_request_builder", 500, 7, fn() { APP.run(NETWORK_SPEC); });
stage("automation_two_nodes", 300, 7, fn() { APP.run(AUTOMATION_SPEC); });
stage("ai_cosine_four_values", 500, 7, fn() { APP.run(AI_SPEC); });
stage("ml_linear_regression_four_rows", 500, 7, fn() { APP.run(ML_SPEC); });
print "APP_DOMAIN_PHASE_SUITE|ok";
