// Controlled pblang-only before/after benchmarks for array/map/DataFrame paths.
let A = import("stdlib:array.sapp");
let M = import("stdlib:map.sapp");
let DF = import("stdlib:dataframe.sapp");

fn stage(name, iterations, thunk) {
    let t0 = now_ms();
    let i = 0;
    while i < iterations { thunk(); i = i + 1; }
    let elapsed = now_ms() - t0;
    print "DATA_PIPELINE_PHASE|" + name + "|" + str(iterations) + "|" + str(elapsed) + "|" + str(elapsed / iterations);
}

fn legacy_distinct_by(items, key_fn) {
    let keys = [];
    let out = [];
    for item in items {
        let raw_key = key_fn(item);
        let key = type(raw_key) + ":" + str(raw_key);
        let found = false;
        let i = 0;
        while i < len(keys) {
            if keys[i] == key { found = true; break; }
            i = i + 1;
        }
        if not found { keys[len(keys)] = key; out[len(out)] = item; }
    }
    return out;
}

fn legacy_merge_updates(updates) {
    let out = map{};
    for update in updates { out = M.merge(out, update); }
    return out;
}

fn direct_merge_updates(updates) {
    let out = map{};
    for update in updates { M.merge_into(out, update); }
    return out;
}

fn legacy_sort_rows(rows) {
    let out = [];
    for row in rows { out[len(out)] = row; }
    let i = 1;
    while i < len(out) {
        let key = out[i];
        let j = i - 1;
        while j >= 0 and out[j].value > key.value {
            out[j + 1] = out[j];
            j = j - 1;
        }
        out[j + 1] = key;
        i = i + 1;
    }
    return DF.from_rows(out);
}

fn legacy_rolling(frame, column, window) {
    let out = [];
    for i len(frame.rows) {
        if i + 1 < window { out[len(out)] = nil; }
        else {
            let sum = 0;
            let ok = true;
            let j = i - window + 1;
            while j <= i {
                let value = try frame.rows[j][column] catch nil;
                if type(value) != "number" { ok = false; }
                else { sum = sum + value; }
                j = j + 1;
            }
            if ok { out[len(out)] = sum / window; } else { out[len(out)] = nil; }
        }
    }
    return out;
}

fn legacy_join(left, right, on_column) {
    let result = [];
    for l in left.rows {
        let lk = str(try l[on_column] catch nil);
        for r in right.rows {
            if lk == str(try r[on_column] catch nil) {
                let merged = map{};
                for k in map_keys(l) { merged[k] = l[k]; }
                for k in map_keys(r) { if k != on_column { merged[k] = r[k]; } }
                result[len(result)] = merged;
            }
        }
    }
    return DF.from_rows(result);
}

fn legacy_pivot(frame, index_col, columns_col, values_col) {
    let index_vals = A.distinct_by(frame.rows, fn(row) { return row[index_col]; });
    let col_rows = A.distinct_by(frame.rows, fn(row) { return row[columns_col]; });
    let result = [];
    for indexed in index_vals {
        let iv = indexed[index_col];
        let row = map{};
        row[index_col] = iv;
        for col_row in col_rows {
            let cv = col_row[columns_col];
            let sum = 0;
            let found = false;
            for source in frame.rows {
                if str(source[index_col]) == str(iv) and str(source[columns_col]) == str(cv) {
                    sum = sum + source[values_col];
                    found = true;
                }
            }
            if found { row[str(cv)] = sum; }
        }
        result[len(result)] = row;
    }
    return DF.from_rows(result);
}

let ITEMS = [];
for i in 0 to 1999 { ITEMS[len(ITEMS)] = map{ id: i % 400, value: i }; }
let LEGACY_DISTINCT = legacy_distinct_by(ITEMS, fn(item) { return item.id; });
let DIRECT_DISTINCT = A.distinct_by(ITEMS, fn(item) { return item.id; });
if len(LEGACY_DISTINCT) != 400 or DIRECT_DISTINCT != LEGACY_DISTINCT { throw "data pipeline benchmark: distinct mismatch"; }

let UPDATES = [];
for i in 0 to 799 { let update = map{}; update["k" + str(i)] = i; UPDATES[len(UPDATES)] = update; }
if M.size(legacy_merge_updates(UPDATES)) != M.size(direct_merge_updates(UPDATES)) { throw "data pipeline benchmark: merge mismatch"; }

let SORT_ROWS = [];
for i in 0 to 999 { SORT_ROWS[len(SORT_ROWS)] = map{ value: 999 - i, original: i }; }
let SORT_FRAME = DF.from_rows(SORT_ROWS);
let LEGACY_SORTED = legacy_sort_rows(SORT_FRAME.rows);
let DIRECT_SORTED = DF.sort_by(SORT_FRAME, "value", "asc");
if LEGACY_SORTED.rows[0].value != DIRECT_SORTED.rows[0].value or DIRECT_SORTED.rows[999].value != 999 {
    throw "data pipeline benchmark: sort mismatch";
}

let ROLL_ROWS = [];
for i in 0 to 2999 { ROLL_ROWS[len(ROLL_ROWS)] = map{ value: i % 100 }; }
let ROLL_FRAME = DF.from_rows(ROLL_ROWS);
let LEGACY_ROLL = legacy_rolling(ROLL_FRAME, "value", 100);
let DIRECT_ROLL = DF.rolling_mean(ROLL_FRAME, "value", 100);
if LEGACY_ROLL != DIRECT_ROLL { throw "data pipeline benchmark: rolling mismatch"; }

let LEFT_ROWS = [];
let RIGHT_ROWS = [];
for i in 0 to 599 {
    LEFT_ROWS[len(LEFT_ROWS)] = map{ id: i, left_value: i * 2 };
    RIGHT_ROWS[len(RIGHT_ROWS)] = map{ id: i, right_value: i * 3 };
}
let LEFT = DF.from_rows(LEFT_ROWS);
let RIGHT = DF.from_rows(RIGHT_ROWS);
let LEGACY_JOINED = legacy_join(LEFT, RIGHT, "id");
let DIRECT_JOINED = DF.join(LEFT, RIGHT, "id");
if len(LEGACY_JOINED.rows) != 600 or DIRECT_JOINED.rows != LEGACY_JOINED.rows { throw "data pipeline benchmark: join mismatch"; }

let PIVOT_ROWS = [];
for region in 0 to 39 {
    for quarter in 0 to 9 {
        for sample in 0 to 1 {
            PIVOT_ROWS[len(PIVOT_ROWS)] = map{ region: region, quarter: quarter, amount: sample + 1 };
        }
    }
}
let PIVOT_FRAME = DF.from_rows(PIVOT_ROWS);
let LEGACY_PIVOT = legacy_pivot(PIVOT_FRAME, "region", "quarter", "amount");
let DIRECT_PIVOT = DF.pivot(PIVOT_FRAME, "region", "quarter", "amount", "sum");
if DIRECT_PIVOT.rows != LEGACY_PIVOT.rows { throw "data pipeline benchmark: pivot mismatch"; }

stage("legacy_distinct_by_2000", 1, fn() { legacy_distinct_by(ITEMS, fn(item) { return item.id; }); });
stage("indexed_distinct_by_2000", 4, fn() { A.distinct_by(ITEMS, fn(item) { return item.id; }); });
stage("legacy_repeated_map_merge_800", 1, fn() { legacy_merge_updates(UPDATES); });
stage("direct_map_merge_into_800", 4, fn() { direct_merge_updates(UPDATES); });
stage("legacy_insertion_sort_1000", 1, fn() { legacy_sort_rows(SORT_FRAME.rows); });
stage("stable_merge_sort_1000", 4, fn() { DF.sort_by(SORT_FRAME, "value", "asc"); });
stage("legacy_rolling_mean_3000_w100", 1, fn() { legacy_rolling(ROLL_FRAME, "value", 100); });
stage("sliding_rolling_mean_3000_w100", 4, fn() { DF.rolling_mean(ROLL_FRAME, "value", 100); });
stage("legacy_nested_join_600x600", 1, fn() { legacy_join(LEFT, RIGHT, "id"); });
stage("indexed_join_600x600", 4, fn() { DF.join(LEFT, RIGHT, "id"); });
stage("legacy_pivot_800_rows", 1, fn() { legacy_pivot(PIVOT_FRAME, "region", "quarter", "amount"); });
stage("indexed_pivot_800_rows", 4, fn() { DF.pivot(PIVOT_FRAME, "region", "quarter", "amount", "sum"); });
print "DATA_PIPELINE_HOTPATH_SUITE|ok";
