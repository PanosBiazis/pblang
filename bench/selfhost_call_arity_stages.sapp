// Fixed work for A/B measurements of the PBLang-written bytecode interpreter.
let TOK = import("stdlib:compiler/tokenizer.sapp");
let PAR = import("stdlib:compiler/parser.sapp");
let CG = import("stdlib:compiler/codegen.sapp");
let VM = import("stdlib:compiler/vm.sapp");
let B = import("stdlib:benchmark.sapp");
let cases = [
    ["closure0", "fn f() { return 7; }", "f()", 1400],
    ["closure1", "fn f(a) { return a + 1; }", "f(i)", 20100],
    ["closure2", "fn f(a,b) { return a + b; }", "f(i,3)", 20500],
    ["closure3", "fn f(a,b,c) { return a * 100 + b * 10 + c; }", "f(i,2,3)", 1994600],
    ["builtin1_control", "", "len([1,2,3])", 600],
    ["arithmetic_control", "", "i + 1", 20100]
];
fn execute(chunk, wanted, bounded) {
    let r = if bounded { VM.run_bounded(chunk, map{ max_steps: 20000, max_frames: 16 }) } else { VM.run(chunk) };
    if r.output != [wanted] { throw "call-arity benchmark checksum mismatch"; }
    return if bounded { r.runtime.steps } else { nil };
}
for item in cases {
    let source = item[1] + " let i = 0; let s = 0; while i < 200 { s = s + " + item[2] + "; i = i + 1; } print s;";
    let ast = PAR.parse(TOK.tokenize(source));
    if len(ast.errors) != 0 { throw "call-arity benchmark parse failure"; }
    let chunk = CG.compile_stmts(ast.stmts);
    for bounded in [false, true] {
        let steps = execute(chunk, item[3], bounded);
        execute(chunk, item[3], bounded);
        let times = [];
        for sample 7 {
            let start = now_ms();
            let current = execute(chunk, item[3], bounded);
            push(times, now_ms() - start);
            if current != steps { throw "call-arity benchmark step accounting changed"; }
        }
        print json_stringify(map{ workload: item[0], bounded: bounded, checksum: item[3],
            steps: steps, samples_ms: times, stats: B.stats(item[0], times) });
    }
}
