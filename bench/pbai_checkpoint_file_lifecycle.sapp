// Full private-file lifecycle; deliberately separate from the historical load-only workload.
let N=import("stdlib:pbai_neural_adapter.sapp");
let IO=import("stdlib:pbai_student_checkpoint_io.sapp");
let directory=env_get("PBAI_CHECKPOINT_TEST_DIR");
assert(type(directory)=="string" and directory!="","fresh private benchmark directory required");
let teacher=N.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let artifact=N.distill_supervised(teacher.artifact,[map{x:[0],y:5}],[map{x:[7,0],y:5}],
 map{epochs:64,lr:0.1,temperature:2,hard_weight:1,max_grad_norm:1}).checkpoint();
let path=path_join(directory,"student.json");IO.save_new(path,artifact);
let reference=N.student_load(artifact);let reference_prediction=reference.predict([6,0]);
assert(reference_prediction.token==5,"synthetic learned target");let expected=json_stringify(reference_prediction);
assert(reference.close(),"release reference handle outside timing");
let samples=[];let operations=5;let closed=0;let aliases=[];
for sample 8 {
 let start=now_ms();
 for repeat operations {
  let loaded=IO.load_file(path);push(aliases,loaded.predict);
  assert(json_stringify(loaded.predict([6,0]))==expected,"identical file prediction "+str(repeat));
  assert(loaded.close(),"each loaded handle closes before the next load");closed=closed+1;
 }
 let elapsed=now_ms()-start;if sample>0 {push(samples,elapsed);}
}
// Verify retained aliases outside timing; no process/RSS or zeroization claim.
let blocked=0;
for predict in aliases {
 let rejected=try {predict([6,0]);false} catch true;
 assert(rejected,"every saved alias must be terminal");blocked=blocked+1;
}
assert(closed==40 and blocked==40,"bounded complete lifecycle including warmup");
print json_stringify(map{format:"pbai.checkpoint-file-lifecycle.bench.v1",samples_ms:samples,
 warmups:1,operations_per_sample:operations,checkpoint_digest:artifact.digest,
 encoded_bytes:len(str_to_bytes(N.student_encode(artifact))),prediction:reference_prediction.token,
 closed_handles:closed,blocked_aliases:blocked,includes_inference:true,
 includes_file_read:true,includes_close:true,includes_alias_validation:false,
 includes_import_startup:false,includes_training:false,globally_activated:false});
