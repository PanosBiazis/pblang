// pblang:target=kernel
// pblang:extern heap_init gc_new gc_set_auto gc_alloc gc_set_child gc_add_root kernel_gc_collect gc_live gc_collections
// Fixed mixed workload: a 128-object live ring and 16 garbage leaves per pass.
// Prepend heap.sapp + the selected gc.sapp. QEMU exit 85 means all checks passed.
fn kmain() {
    let h=kmalloc(8);let region=kmalloc(131072);heap_init(h,region,131072);
    let g=gc_new(h);gc_set_auto(g,0);
    let first=gc_alloc(g,1);let prev=first;let i=1;
    while i<128 {let next=gc_alloc(g,1);gc_set_child(prev,0,next);prev=next;i=i+1;}
    gc_set_child(prev,0,first);gc_add_root(g,first);
    let rounds=0;
    while rounds<100000 {
        i=0;while i<16 {
            if gc_alloc(g,0)==0 {outb(244,1);while 1>0 {hlt();}}
            i=i+1;
        }
        if kernel_gc_collect(g)!=0 or gc_live(g)!=128 {outb(244,1);while 1>0 {hlt();}}
        rounds=rounds+1;
    }
    if gc_collections(g)!=100000 {outb(244,1);} else {outb(244,42);}
    while 1>0 {hlt();}
}
