let AUDIT = import("stdlib:project_text_audit.sapp");

fn sorted(values) {
    let out = []; let used = map{};
    while len(out) < len(values) {
        let best = 0 - 1; let i = 0;
        while i < len(values) {
            if not (try used[str(i)] catch false)
                and (best < 0 or values[i] < values[best]) { best = i; }
            i = i + 1;
        }
        used[str(best)] = true; array_push(out, values[best]);
    }
    return out;
}

fn stats(values) {
    let rows = sorted(values); let n = len(rows);
    return map{ samples: n, median_ms: rows[num_floor(n / 2)],
        p95_ms: rows[num_floor((n - 1) * 0.95)], min_ms: rows[0], max_ms: rows[n - 1] };
}

fn measure(rounds, operation) {
    let values = []; let i = 0; operation();
    while i < rounds {
        let started = now_ms(); operation(); array_push(values, now_ms() - started); i = i + 1;
    }
    return stats(values);
}

let nonce = str_slice(sha256(str(now_ms()) + str(random_bytes(12))), 0, 16);
let root = "tests/fixtures/module-audit-bench-" + nonce;
let module_a = root + "/a"; let module_b = root + "/b";
fs_mkdirs(module_a); fs_mkdirs(module_b);
let i = 0;
while i < 24 {
    fs_write(module_a + "/file_" + str(i) + ".sapp", "fn a_" + str(i) + "() { return " + str(i) + "; }\n");
    fs_write(module_b + "/file_" + str(i) + ".sapp", "fn b_" + str(i) + "() { return " + str(i + 1) + "; }\n");
    i = i + 1;
}
let options = map{ max_depth: 8, max_entries_per_module: 256,
    max_children_per_dir: 128, max_files_per_module: 64, max_file_bytes: 4096,
    max_runtime_ms_per_module: 30000, max_findings_per_file: 16,
    max_finding_index: 64, requested_roots: [module_a, module_b], audit_id: nonce };
let baseline = AUDIT.audit_modules("benchmark", [module_a, module_b], options);
if not baseline.ok or not baseline.complete { throw "module audit benchmark fixture incomplete"; }

fn full_scan() { AUDIT.audit_modules("benchmark", [module_a, module_b], options); }
fn snapshot_check() { AUDIT.verify_module_snapshot(baseline.modules[0], options); }
fn report_combine() { AUDIT.combine_module_reports("benchmark", baseline.modules, options); }

print json_stringify(map{ format: "pblang.module-audit-benchmark.v1", rounds: 15,
    modules: 2, files: 48, full_scan: measure(15, full_scan),
    unchanged_snapshot: measure(15, snapshot_check),
    report_recombine: measure(15, report_combine) });

i = 0;
while i < 24 {
    try fs_remove(module_a + "/file_" + str(i) + ".sapp") catch nil;
    try fs_remove(module_b + "/file_" + str(i) + ".sapp") catch nil;
    i = i + 1;
}
try fs_remove(module_a) catch nil; try fs_remove(module_b) catch nil; try fs_remove(root) catch nil;
