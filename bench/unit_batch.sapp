let U=import("stdlib:units.sapp");
fn scalar(values) {let out=[];for value in values {array_push(out,U.convert_checked(value,"degC","degF","difference"));}return out;}
let rows=[];for size in [32,128,512] {
 let values=[];for i in range(0,size){array_push(values,i/10-20);}
 assert(scalar(values)==U.convert_many(values,"degC","degF","difference"),"same batch output");
 for warm in range(0,2){scalar(values);U.convert_many(values,"degC","degF","difference");}
 let repeated=[];let batch=[];
 for sample in range(0,7){let start=clock();let a=scalar(values);array_push(repeated,(clock()-start)*1000);start=clock();let b=U.convert_many(values,"degC","degF","difference");array_push(batch,(clock()-start)*1000);assert(a==b,"every measured output agrees");}
 array_push(rows,map{values:size,repeated_ms:repeated,batch_ms:batch});
}print json_stringify(rows);
