// Correctness-gated benchmark for the core serialization formats.
// Run the whole process repeatedly and aggregate externally; individual stages
// use enough rounds to rise above the millisecond clock resolution.

let SER = import("stdlib:serialization.sapp");

let JSON_TEXT = "{\"name\":\"pblang\",\"version\":1,\"enabled\":true,\"targets\":[\"x86_64\",\"c99\",\"vm\"],\"limits\":{\"memory\":64,\"workers\":4}}";
let TOML_TEXT = "name = \"pblang\"\nversion = 1\nenabled = true\ntargets = [\"x86_64\", \"c99\", \"vm\"]\n\n[limits]\nmemory = 64\nworkers = 4\n";
let YAML_TEXT = "name: pblang\nversion: 1\nenabled: true\ntargets:\n  - x86_64\n  - c99\n  - vm\nlimits:\n  memory: 64\n  workers: 4\n";

let VALUE = SER.parse_format(JSON_TEXT, "json");

fn stage(name, rounds, body) {
    let checksum = 0;
    let start = now_ms();
    let i = 0;
    while i < rounds {
        checksum = checksum + body();
        i = i + 1;
    }
    let elapsed = now_ms() - start;
    if checksum <= 0 { throw "serialization benchmark checksum failed: " + name; }
    print "SERIALIZATION_PHASE|" + name + "|" + str(rounds) + "|" + str(elapsed)
        + "|" + str(elapsed / rounds) + "|" + str(checksum);
}

stage("json_parse", 4000, fn() {
    let v = SER.parse_format(JSON_TEXT, "json");
    return len(v.targets) + v.limits.workers;
});

stage("toml_parse", 2000, fn() {
    let v = SER.toml_parse(TOML_TEXT);
    return len(v.targets) + v.limits.workers;
});

stage("yaml_parse", 2000, fn() {
    let v = SER.yaml_parse(YAML_TEXT);
    return len(v.targets) + v.limits.workers;
});

stage("toml_stringify", 2000, fn() { return len(SER.toml_stringify(VALUE)); });
stage("yaml_stringify", 2000, fn() { return len(SER.yaml_stringify(VALUE)); });

stage("safe_json_parse", 1000, fn() {
    let r = SER.parse_safe(JSON_TEXT, "json");
    if not r.ok { return 0; }
    return len(r.value.targets) + r.value.limits.workers;
});

stage("safe_toml_parse", 500, fn() {
    let r = SER.parse_safe(TOML_TEXT, "toml");
    if not r.ok { return 0; }
    return len(r.value.targets) + r.value.limits.workers;
});

stage("safe_yaml_parse", 500, fn() {
    let r = SER.parse_safe(YAML_TEXT, "yaml");
    if not r.ok { return 0; }
    return len(r.value.targets) + r.value.limits.workers;
});

stage("safe_json_to_yaml", 500, fn() {
    let r = SER.convert_safe(JSON_TEXT, "json", "yaml");
    if not r.ok { return 0; }
    return len(r.value);
});

print "SERIALIZATION_PIPELINE_SUITE|ok";
