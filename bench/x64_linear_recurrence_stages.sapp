// Paired pure-pblang benchmark for the direct x86-64 additive-recurrence pass.
// The control adds a foldable +0 inside one recursive argument: generated TRMA
// code retains the pre-pass behavior, while the detector correctly rejects the
// non-canonical raw AST. Both programs compute the same sequence.
let X64 = import("stdlib/native/codegen_x64.sapp");

let FAST36 = "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } print fib(36);";
let CONTROL36 = "fn fib(n) { if n < 2 { return n; } return fib((n - 1) + 0) + fib(n - 2); } print fib(36);";
let FAST92 = "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } print fib(92);";

fn compile_samples(source, iterations) {
    let samples = [];
    let i = 0;
    while i < iterations {
        let t0 = now_ms();
        let bin = X64.compile_fns(source);
        if len(bin) < 120 or bin[0] != 127 or bin[4] != 2 { throw "linear recurrence benchmark emitted invalid ELF"; }
        push(samples, now_ms() - t0);
        i = i + 1;
    }
    let sorted = array_sort(samples);
    let total = 0.0; i = 0;
    while i < len(sorted) { total = total + sorted[i]; i = i + 1; }
    return map{ average_ms: total / iterations, median_ms: sorted[num_floor(len(sorted) / 2)] };
}

let fast = X64.compile_fns(FAST36);
let control = X64.compile_fns(CONTROL36);
let fast92 = X64.compile_fns(FAST92);
let fast_compile = compile_samples(FAST36, 30);
let control_compile = compile_samples(CONTROL36, 30);

fs_write_bytes("/tmp/pblang_x64_lr_fast36", fast);
fs_write_bytes("/tmp/pblang_x64_lr_control36", control);
fs_write_bytes("/tmp/pblang_x64_lr_fast92", fast92);

print "SCHEMA|variant|compile_average_ms|compile_median_ms|artifact_bytes|status";
print "LR|fast36|" + str(fast_compile.average_ms) + "|" + str(fast_compile.median_ms) + "|" + str(len(fast)) + "|ok";
print "LR|control36|" + str(control_compile.average_ms) + "|" + str(control_compile.median_ms) + "|" + str(len(control)) + "|ok";
print "LR_SUITE|ok";
