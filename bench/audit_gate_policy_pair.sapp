let OLD=import(env_get("PB_GATE_REFERENCE"));
let NEW=import("stdlib:project_audit.sapp");
let B=import("stdlib:benchmark.sapp");
let clean=NEW.scan_records([],16);
let report=NEW.scan_records([map{path:"src/review.sapp",text:"// TODO placeholder"}],16);
let qopts=map{max_high:0,max_medium:5,max_total:50,max_source_high:0,max_source_medium:5,max_source_total:50,source_only_blockers:false,allow_roadmap:true};
let copts=map{max_new_total:1,max_new_high:0,max_new_medium:1,block_new_security:true,block_new_reliability:true,block_new_performance:true};
fn invoke(m,kind){
    if kind=="quality-default" {return m.quality_gate(report);}
    if kind=="quality-explicit" {return m.quality_gate(report,qopts);}
    if kind=="compare-default" {return m.compare_reports(clean,report);}
    return m.compare_reports(clean,report,copts);
}
fn measure(m,kind){let start=now_ms();let result=nil;for i 300 {result=invoke(m,kind);}return map{ms:now_ms()-start,result:result};}
for kind in ["quality-default","quality-explicit","compare-default","compare-explicit"] {
    let expected=json_stringify(invoke(OLD,kind));let before=[];let after=[];let ratios=[];
    for i 14 {
        let a=nil;let b=nil;
        if i%2==0 {a=measure(OLD,kind);b=measure(NEW,kind);}
        else {b=measure(NEW,kind);a=measure(OLD,kind);}
        if json_stringify(a.result)!=expected or json_stringify(b.result)!=expected or a.ms<=0 or b.ms<=0 {throw "gate benchmark correctness/clock mismatch";}
        if i>=2 {push(before,a.ms);push(after,b.ms);push(ratios,b.ms/a.ms);}
    }
    print json_stringify(map{operation:kind,calls:300,warmup_pairs:2,retained_pairs:12,before_ms:before,after_ms:after,paired_ratios:ratios,before_stats:B.stats("before",before),after_stats:B.stats("after",after),ratio_stats:B.stats("ratio",ratios)});
}
