// Requires the explicitly configured, protected Win64 bridge package.
let ABI = import("stdlib:windows_native_abi.sapp");
let OS = import("stdlib:os.sapp");
let args = OS.script_args();
let size = if len(args)>0 { parse_number(args[0]) } else { 64 };
let rounds = if len(args)>1 { parse_number(args[1]) } else { 256 };
assert(platform()=="windows", "native Windows benchmark required");
assert(size>=1 and size<=65536 and size==num_floor(size), "benchmark size");
assert(rounds>=1 and rounds<=10000 and rounds==num_floor(rounds), "benchmark rounds");
let state = ABI.load_packaged(env_get("PBLANG_WINDOWS_ABI_BRIDGE"));
assert(state.ok, "protected bridge loads");
let pointer = ABI.allocate(state,size);
assert(pointer>0, "owned buffer allocated");
let values=[];let i=0;
while i<size { array_push(values,num_mod(i*73,256));i=i+1; }
i=0;
while i<rounds {
    assert(ABI.write_bytes(state,pointer,0,values), "native write succeeds");i=i+1;
}
assert(ABI.read_bytes(state,pointer,0,size)==values, "native byte parity");
// Compare both versions despite the older incorrect boolean success report.
ABI.free(state,pointer);
assert(not map_has(state.allocations,str(pointer)) and ABI.close(state), "native resources released");
print "WINDOWS_ABI_WRITE|"+str(size)+"|"+str(rounds);
