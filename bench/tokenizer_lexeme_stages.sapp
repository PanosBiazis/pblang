// Fixed synthetic lexemes only; no filesystem source intake or execution.
let T=import("stdlib:compiler/tokenizer.sapp");
let B=import("stdlib:benchmark.sapp");
for size in [128,2048,16384] {
    let word=str_repeat("a",size);let digits=str_repeat("1",size);
    let cases=[map{name:"identifier",source:word,kind:"ident",text:word},
        map{name:"line-comment",source:"//"+word,kind:"comment",text:word},
        map{name:"block-comment",source:"/*"+word+"*/",kind:"comment",text:word},
        map{name:"decimal",source:digits,kind:"number",text:digits}];
    for item in cases {
        let first=0;let samples=[];
        for iteration 8 {
            let start=now_ms();let result=T.tokenize_bounded(item.source,2);
            let elapsed=now_ms()-start;
            if not result.ok or result.token_count!=2 or result.tokens[0].kind!=item.kind
                or result.tokens[0].text!=item.text or result.tokens[1].kind!="eof" {
                throw "tokenizer lexeme benchmark: semantic mismatch";
            }
            if iteration==0 {first=elapsed;}
            if iteration>=3 {push(samples,elapsed);}
        }
        print json_stringify(map{operation:item.name,lexeme_scalars:size,first_ms:first,
            samples_ms:samples,stats:B.stats(item.name,samples)});
    }
}
