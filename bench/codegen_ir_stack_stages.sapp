// Isolated portable register-IR stack benchmark. The program is constructed
// before timing so the metric measures evaluator push/pop work, not IR setup.
let IR = import("stdlib/codegen_ir.sapp");

let DEPTH = 2000;
let ROUNDS = 3;

fn stack_program(depth) {
    let program = [["seti", 0, 1]];
    let i = 0;
    while i < depth { array_push(program, ["pushr", 0]); i = i + 1; }
    i = 0;
    while i < depth { array_push(program, ["popr", 1]); i = i + 1; }
    array_push(program, ["movr", 0, 1]);
    return program;
}

let PROGRAM = stack_program(DEPTH);
if IR.eval(PROGRAM) != 1 { throw "IR stack benchmark: evaluator result mismatch"; }

let t0 = now_ms();
let round = 0;
while round < ROUNDS {
    if IR.eval(PROGRAM) != 1 { throw "IR stack benchmark: repeated result mismatch"; }
    round = round + 1;
}
let elapsed = now_ms() - t0;
print "IR_STACK_POP|" + str(DEPTH) + "|" + str(ROUNDS) + "|" + str(elapsed);
