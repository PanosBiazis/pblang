// Wide-graph traversal benchmark. Graph construction happens before timing so
// the metric isolates BFS queue processing rather than map/edge setup.
let GRAPH = import("stdlib/graph.sapp");

let WIDTH = 2000;
let ROUNDS = 3;
let graph = GRAPH.new(true);
let expected_sum = 0;
let i = 0;
while i < WIDTH {
    let id = "n" + str(i);
    GRAPH.add_edge(graph, "root", id, 1);
    expected_sum = expected_sum + i;
    i = i + 1;
}

fn verify(order) {
    if len(order) != WIDTH + 1 or order[0] != "root" {
        throw "graph traversal benchmark: BFS shape mismatch";
    }
    let sum = 0;
    let j = 1;
    while j < len(order) {
        sum = sum + parse_number(str_slice(order[j], 1, len(order[j])));
        j = j + 1;
    }
    if sum != expected_sum { throw "graph traversal benchmark: BFS checksum mismatch"; }
}

verify(GRAPH.bfs(graph, "root"));
let t0 = now_ms();
let round = 0;
while round < ROUNDS {
    verify(GRAPH.bfs(graph, "root"));
    round = round + 1;
}
let elapsed = now_ms() - t0;
print "GRAPH_BFS_WIDE|" + str(WIDTH) + "|" + str(ROUNDS) + "|" + str(elapsed);
