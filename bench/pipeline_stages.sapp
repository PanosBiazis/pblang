// pipeline_stages.sapp — measure every stage of the pblang self-hosted pipeline
// (all three paths written in pblang): tokenize → parse → { interpret | codegen }.
// Native execution of the codegen output is timed by the shell wrapper.
// Run from pl-dev/pblang (so `stdlib/...` imports resolve).

let tok = import("stdlib/compiler/tokenizer.sapp");
let par = import("stdlib/compiler/parser.sapp");
let vm  = import("stdlib/compiler/interp.sapp");
let cg  = import("stdlib/native/codegen_x64.sapp");

let SRC  = "fn fib(n){ if n<2 {return n;} return fib(n-1)+fib(n-2); } return fib(20);";
let SRCP = "fn fib(n){ if n<2 {return n;} return fib(n-1)+fib(n-2); } print str(fib(20));";

// average ms per call over `n` iterations of a 0-arg thunk
fn avg_ms(thunk, n) {
    let t0 = now_ms();
    let i = 0;
    while i < n { thunk(); i = i + 1; }
    return (now_ms() - t0) / n;
}

let toks = tok.tokenize(SRC);
let t_tok = avg_ms(fn() { tok.tokenize(SRC); }, 300);
let t_parse = avg_ms(fn() { par.parse(toks); }, 300);

// interpret path (pblang tree-walking interpreter) — computes + prints fib(20)
let ti0 = now_ms();
vm.eval_program(SRCP);
let t_interp = now_ms() - ti0;

// codegen path (pblang → x86-64 machine code)
let t_cg = avg_ms(fn() { cg.compile_fns(SRC); }, 50);
let bytes = cg.compile_fns(SRC);
fs_write_bytes("/tmp/pipe_bin", bytes);

print "TOK_ms=" + str(t_tok);
print "PARSE_ms=" + str(t_parse);
print "INTERP_total_ms=" + str(t_interp);
print "CODEGEN_ms=" + str(t_cg);
print "SIZE_bytes=" + str(len(bytes));
