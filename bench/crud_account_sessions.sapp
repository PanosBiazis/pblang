// Reproducible synthetic workload: startup, bcrypt login and issued-session reads.
// PBLANG_ACCOUNT_BENCH_CATALOG selects a pre-provisioned synthetic catalog.
// Without it the same hash is supplied in memory. No credentials are printed.
let A=import("stdlib:crud_accounts.sapp");
let hash="$2b$12$B7w/XX4A/.4otknYJe0OOu69/Zr7IM3viqeA4Jl/tgB9GIcM/mPn.";
let path=try env_get("PBLANG_ACCOUNT_BENCH_CATALOG") catch nil;
let raw=try env_get("PBLANG_ACCOUNT_BENCH_REQUESTS") catch nil;
let count=if raw==nil or raw=="" {1000} else {parse_number(raw)};
assert(type(count)=="number" and count==num_floor(count) and count>=1 and count<=1000000,"bounded benchmark count");
let app=if path==nil or path=="" {A.create(map{editor:hash})} else {A.create_catalog(path)};
fn req(method,path,body="",cookie="") {
    // pblang-security-ignore-next-line: network.plaintext-http reason=synthetic in-process loopback request, no listener
    return map{method:method,path:path,body:body,headers:map{host:"127.0.0.1:8765",origin:"http://127.0.0.1:8765","content-type":"application/x-www-form-urlencoded",cookie:cookie}};
}
let page=app.gate(req("GET","/login"));
let csrf=str_split(str_split(page.body,"name=\"csrf\" value=\"")[1],"\"")[0];
let anonymous=str_split(page.headers["Set-Cookie"],";")[0];
let login=app.gate(req("POST","/login","username=editor&password=Synthetic+password+123%21&csrf="+csrf,anonymous));
assert(login.status==303,"synthetic login");
let session=str_split(login.headers["Set-Cookie"],";")[0];
let request=req("GET","/","",session);
for i count {assert(app.gate(request).grant,"authenticated request");}
app.close();print json_stringify(map{ok:true,requests:count});
