let PIPE = import("stdlib:execution_pipeline.sapp");

let IR = [
    ["seti", 0, 0], ["seti", 2, 3], ["seti", 3, 4], ["mul", 2, 3],
    ["add", 0, 2], ["seti", 1, 100], ["loop", 1, [["addi", 0, 1]]]
];
let SOURCE = "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } fn main() { return fib(12); }";

fn stage(name, count, work) {
    let t0 = now_ms(); let i = 0;
    while i < count { work(); i = i + 1; }
    let elapsed = now_ms() - t0;
    print "PIPE_PHASE|" + name + "|" + str(count) + "|" + str(elapsed) + "|" + str(elapsed / count);
}

let eval_result = PIPE.build_ir(IR, "eval");
if eval_result.evaluation.value != 112 { throw "execution pipeline reference mismatch"; }
for target in ["x86_64-linux", "i386-linux", "arm64-linux", "c99"] {
    let built = PIPE.build_ir(IR, target);
    print "PIPE_ARTIFACT|" + target + "|" + str(built.optimization.before) + "|" + str(built.optimization.after) + "|" + str(built.artifact_bytes);
}
let bytecode = PIPE.build_source(SOURCE, "interpreter");
let hosted_c99 = PIPE.build_source(SOURCE, "c99-hosted");
let wasm = PIPE.build_source(SOURCE, "wasm32");
print "PIPE_ARTIFACT|interpreter|" + str(len(SOURCE)) + "|0|" + str(bytecode.artifact_bytes);
print "PIPE_ARTIFACT|c99-hosted|" + str(len(SOURCE)) + "|0|" + str(hosted_c99.artifact_bytes);
print "PIPE_ARTIFACT|wasm32|" + str(len(SOURCE)) + "|0|" + str(wasm.artifact_bytes);
print "PIPE_EVAL|value|" + str(eval_result.evaluation.value) + "|steps|" + str(eval_result.evaluation.steps) + "|peak_stack|" + str(eval_result.evaluation.peak_stack);
let matrix = PIPE.optimization_matrix(IR);
for metric in matrix.backends {
    print "PIPE_MATRIX|" + metric.target + "|" + str(metric.before_bytes) + "|" + str(metric.after_bytes) + "|" + str(metric.saved_bytes) + "|" + str(metric.saved_percent);
}

for platform in [
    ["linux", "6.0", "x86_64"], ["linux", "6.0", "arm64"],
    ["windows", "11", "x86_64"], ["macos", "14", "arm64"],
    ["android", "34", "arm64"], ["ios", "17", "arm64"], ["wasi", "1", "wasm32"]
] {
    let plan = PIPE.plan_platform(platform[0], platform[1], platform[2]);
    if not plan.ok { throw "execution pipeline platform plan failed"; }
    print "PIPE_PLATFORM|" + platform[0] + "|" + platform[2] + "|" + plan.target + "|" + str(plan.direct_native) + "|" + str(plan.isa.verified);
}

stage("bounded_eval", 1000, fn() { PIPE.build_ir(IR, "eval"); });
stage("x86_64_build", 300, fn() { PIPE.build_ir(IR, "x86_64-linux"); });
stage("i386_build", 300, fn() { PIPE.build_ir(IR, "i386-linux"); });
stage("arm64_build", 300, fn() { PIPE.build_ir(IR, "arm64-linux"); });
stage("c99_build", 300, fn() { PIPE.build_ir(IR, "c99"); });
stage("cross_backend_optimization_matrix", 100, fn() { PIPE.optimization_matrix(IR); });
stage("interpreter_compile", 50, fn() { PIPE.build_source(SOURCE, "interpreter"); });
stage("c99_hosted_transpile", 100, fn() { PIPE.build_source(SOURCE, "c99-hosted"); });
stage("wasm_compile", 50, fn() { PIPE.build_source(SOURCE, "wasm32"); });
print "PIPE_SUITE|ok";
