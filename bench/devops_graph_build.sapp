let Before=import("./fixtures/devops_pipeline_before_graph_build.sapp");let After=import("stdlib:devops_pipeline.sapp");
fn measure(f,jobs) {let start=clock();for repeat in range(0,12) {f(jobs);}return (clock()-start)*1000/12;}
let results=[];
for shape in ["independent","chain","dense"] {
    let jobs=[];
    for i in range(0,32) {
        let deps=[];
        if shape=="chain" and i>0 {array_push(deps,"n"+str(i-1));}
        if shape=="dense" {for parent in range(num_max(0,i-16),i) {array_push(deps,"n"+str(parent));}}
        array_push(jobs,map{id:"n"+str(i),needs:deps});
    }
    assert(Before.order(jobs)==After.order(jobs),"equal output before timing");
    for warmup in range(0,3) {measure(Before.order,jobs);measure(After.order,jobs);}
    let before=[];let after=[];
    for sample in range(0,9) {
        if sample%2==0 {array_push(before,measure(Before.order,jobs));array_push(after,measure(After.order,jobs));}
        else {array_push(after,measure(After.order,jobs));array_push(before,measure(Before.order,jobs));}
    }
    array_push(results,map{shape:shape,before_ms:before,after_ms:after});
}
print json_stringify(map{clock:"system_time_wall",unit:"ms_per_call",jobs:32,warmups:3,samples:9,repetitions:12,results:results});
