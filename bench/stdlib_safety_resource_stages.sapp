// Correctness-gated resource-admission benchmark written entirely in pblang.
let MEM = import("stdlib:memory_safety.sapp");
let BUDGET = import("stdlib:resource_budget.sapp");

fn stage(name, iterations, thunk) {
    let t0 = now_ms();
    let i = 0;
    while i < iterations { thunk(); i = i + 1; }
    let elapsed = now_ms() - t0;
    print "SAFETY_RESOURCE_PHASE|" + name + "|" + str(iterations) + "|" +
          str(elapsed) + "|" + str(elapsed / iterations);
}

// Legacy admission discovers an oversized workload only after allocating all
// speculative objects. It is safe, but wastes time and peak memory.
fn legacy_late_admission(item_count, limit) {
    let arena = MEM.arena_new("legacy");
    let i = 0;
    while i < item_count {
        MEM.arena_alloc(arena, map{ index: i, payload: i * 2 });
        i = i + 1;
    }
    let accepted = item_count <= limit;
    MEM.arena_drop_all(arena);
    return accepted;
}

// Bounded admission stops at the first disallowed allocation.
fn bounded_early_admission(item_count, limit) {
    let arena = MEM.bounded_arena("bounded", limit, limit);
    let accepted = true;
    let i = 0;
    while i < item_count {
        let owner = try MEM.arena_alloc(arena, map{ index: i, payload: i * 2 }) catch nil;
        if owner == nil { accepted = false; break; }
        i = i + 1;
    }
    MEM.arena_drop_all(arena);
    return accepted;
}

let ITEMS = 5000;
let LIMIT = 500;
if legacy_late_admission(ITEMS, LIMIT) != false { throw "safety benchmark: legacy decision mismatch"; }
if bounded_early_admission(ITEMS, LIMIT) != false { throw "safety benchmark: bounded decision mismatch"; }

let ledger = BUDGET.ledger(BUDGET.budget("events", map{ items: 10000 }));
let i = 0;
while i < 1000 {
    let r = BUDGET.ledger_reserve(ledger, BUDGET.usage(map{ items: 1 }));
    if not r.accepted { throw "safety benchmark: valid ledger reservation rejected"; }
    i = i + 1;
}
if ledger.usage.values.items != 1000 { throw "safety benchmark: ledger accounting mismatch"; }

stage("legacy_late_reject_5000_limit500", 1, fn() { legacy_late_admission(ITEMS, LIMIT); });
stage("bounded_early_reject_5000_limit500", 4, fn() { bounded_early_admission(ITEMS, LIMIT); });
stage("transactional_ledger_1000", 4, fn() {
    let state = BUDGET.ledger(BUDGET.budget("events", map{ items: 10000 }));
    let j = 0;
    while j < 1000 {
        BUDGET.ledger_reserve(state, BUDGET.usage(map{ items: 1 }));
        j = j + 1;
    }
});
stage("fast_transactional_ledger_1000", 4, fn() {
    let state = BUDGET.ledger(BUDGET.budget("events", map{ items: 10000 }));
    let j = 0;
    while j < 1000 {
        if not BUDGET.ledger_try_reserve(state, map{ items: 1 }) {
            throw "safety benchmark: fast ledger rejected valid reservation";
        }
        j = j + 1;
    }
});

print "SAFETY_RESOURCE_SUITE|ok";
