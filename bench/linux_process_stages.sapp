let P = import("stdlib:linux_process.sapp");
let B = import("stdlib:benchmark.sapp");

fn require(condition, message) { if not condition { throw "linux_process_bench: " + message; } }

let warmup = P.run("/usr/bin/true", [], map{ timeout_secs: 3, max_output_bytes: 1024 });
require(warmup.ok and warmup.command_ok and warmup.process_group_terminated, "warmup correctness");

let samples = [];
for i 15 {
    let started = now_ms();
    let result = P.run("/usr/bin/printf", ["%s", "bounded"], map{
        timeout_secs: 3, max_output_bytes: 1024
    });
    let elapsed = now_ms() - started;
    require(result.ok and result.command_ok and result.stdout == "bounded"
        and result.process_group_terminated, "sample correctness");
    array_push(samples, elapsed);
}

let stats = B.stats("linux_process_run_ms", samples);
print json_stringify(map{
    format: "pblang.linux-process.benchmark.v1",
    samples: samples, median_ms: stats.median_ms, p95_ms: stats.p95_ms,
    min_ms: stats.min_ms, max_ms: stats.max_ms, stability: stats.stability,
    cv_percent: stats.cv_percent, iterations: len(samples),
    includes: ["argv image generation", "private directory", "supervisor generation",
        "process launch", "wait", "bounded read", "verified cleanup"],
    excludes: ["compiler startup", "module import"]
});
