// The baseline executes code: use only an operator-reviewed reference module.
// Paired timings retain every sample, including workloads with no class reuse.
let OLD=import(env_get("PB_TAINT_REFERENCE"));
let NEW=import("stdlib:security_taint.sapp");
let B=import("stdlib:benchmark.sapp");
fn make_policy(count,kind) {
    let sinks=map{};let indexes=[];for i 32 {push(indexes,255);}
    for i count {
        let label="class";
        if kind=="repeated-long" {label=str_repeat("α",128);}
        elif kind=="distinct-long" {label=str_repeat("a",253)+str(100+i);}
        sinks["sink"+str(i)]=map{severity:"high",class:label,args:indexes};
    }
    return map{taint_sinks:sinks};
}
fn measure(module,options,rounds) {
    let start=now_ms();let result=nil;
    for i rounds {result=module.validate_policy(options);}
    return map{elapsed:now_ms()-start,result:result};
}
for item in [map{name:"single-short",count:1,kind:"short",rounds:200},
    map{name:"repeated-short",count:128,kind:"short",rounds:10},
    map{name:"repeated-long",count:128,kind:"repeated-long",rounds:10},
    map{name:"distinct-long",count:128,kind:"distinct-long",rounds:10}] {
    let options=make_policy(item.count,item.kind);let expected=json_stringify(map{ok:true});
    let before=[];let after=[];let ratios=[];
    for iteration 14 {
        let a=nil;let b=nil;
        if num_mod(iteration,2)==0 {a=measure(OLD,options,item.rounds);b=measure(NEW,options,item.rounds);}
        else {b=measure(NEW,options,item.rounds);a=measure(OLD,options,item.rounds);}
        if json_stringify(a.result)!=expected or json_stringify(b.result)!=expected {throw "class validation benchmark result";}
        if a.elapsed<=0 or b.elapsed<=0 {throw "class validation clock resolution";}
        if iteration>=2 {push(before,a.elapsed);push(after,b.elapsed);push(ratios,b.elapsed/a.elapsed);}
    }
    print json_stringify(map{operation:item.name,rounds:item.rounds,before_ms:before,after_ms:after,paired_ratios:ratios,
        before_stats:B.stats(item.name,before),after_stats:B.stats(item.name,after),ratio_stats:B.stats("ratio",ratios)});
}
