let UI = import("stdlib/modern_ui.sapp");
let Android = import("stdlib/modern_ui_android.sapp");
let Web = import("stdlib/modern_ui_web.sapp");

fn sorted(values) {
    let out = [];
    for value in values {
        let next = []; let inserted = false;
        for item in out {
            if not inserted and value < item { array_push(next, value); inserted = true; }
            array_push(next, item);
        }
        if not inserted { array_push(next, value); }
        out = next;
    }
    return out;
}

fn percentile(values, value) {
    let ordered = sorted(values);
    let index = num_ceil(len(ordered) * value) - 1;
    if index < 0 { index = 0; }
    return ordered[index];
}

let view = UI.screen([
    UI.heading("Responsive benchmark"),
    UI.row([
        UI.input("", map{ name: "device", placeholder: "Device" }),
        UI.choice(["USB", "LAN", "Tor"], 1, nil, map{ name: "carrier" })
    ], map{ responsive: true }),
    UI.grid([
        UI.card([UI.text("Files"), UI.button("Open", UI.action_message("Open"))]),
        UI.card([UI.text("Terminal"), UI.button("Run", UI.action_message("Run"))]),
        UI.card([UI.text("Desktop"), UI.button("View", UI.action_message("View"))]),
        UI.card([UI.text("Rooms"), UI.button("Join", UI.action_message("Join"))])
    ], map{ columns: 4 })
]);

let viewports = [[320, 568], [360, 800], [390, 844], [412, 915],
    [740, 360], [768, 1024], [1280, 720], [1920, 1080], [2560, 1080], [3840, 2160]];
let compile_samples = []; let generation_samples = [];
let sample = 0; let checksum = 0;
while sample < 9 {
    let started = now_ms(); let i = 0; let bundles = [];
    while i < len(viewports) {
        let size = viewports[i];
        let target = if num_mod(i, 2) == 0 { "android" } else { "web" };
        let bundle = UI.compile(view, map{ target: target, width: size[0], height: size[1] });
        array_push(bundles, bundle); checksum = checksum + len(bundle.records);
        i = i + 1;
    }
    array_push(compile_samples, now_ms() - started);
    started = now_ms();
    let android = Android.generate("Responsive", bundles[0],
        map{ package: "org.pblang.responsivebench" });
    let web = Web.generate("Responsive", bundles[1], map{});
    checksum = checksum + len(android.class_bytes) + len(web.css);
    array_push(generation_samples, now_ms() - started);
    sample = sample + 1;
}

print json_stringify(map{
    format: "pblang.modern-ui-responsive-benchmark.v1",
    samples: 9, viewports_per_compile_sample: len(viewports),
    viewports: viewports, checksum: checksum,
    compile_ms: map{
        median: percentile(compile_samples, 0.5),
        p95: percentile(compile_samples, 0.95),
        raw: compile_samples
    },
    android_plus_web_generation_ms: map{
        median: percentile(generation_samples, 0.5),
        p95: percentile(generation_samples, 0.95),
        raw: generation_samples
    }
});
