// Correctness-gated cache/render hot-path benchmark. Results are local evidence,
// not universal performance claims.
let C = import("stdlib:cache.sapp");
let R = import("stdlib:render_cache.sapp");

fn stage(name, iterations, work) {
    let t0 = now_ms();
    let i = 0;
    while i < iterations { work(); i = i + 1; }
    let elapsed = now_ms() - t0;
    print "CACHE_RENDER_PHASE|" + name + "|" + str(iterations) + "|" +
          str(elapsed) + "|" + str(elapsed / iterations);
}

let legacy_map = map{};
let bounded = C.bounded(0, 4096, 4096);
let fill = 0;
while fill < 4096 {
    let key = "k" + str(fill);
    legacy_map[key] = fill;
    C.set(bounded, key, fill);
    fill = fill + 1;
}
assert(len(map_keys(legacy_map)) == C.size(bounded), "cache size fixtures match");

let sink = 0;
stage("legacy_map_keys_size", 5000, fn() { sink = sink + len(map_keys(legacy_map)); });
stage("bounded_o1_size", 5000, fn() { sink = sink + C.size(bounded); });

let churn = C.bounded(0, 256, 256);
let churn_i = 0;
stage("bounded_fifo_churn", 10000, fn() {
    C.set(churn, "entry-" + str(churn_i), churn_i);
    churn_i = churn_i + 1;
});
assert(C.size(churn) == 256, "bounded churn enforces capacity");
assert(C.stats(churn).evictions == 10000 - 256, "bounded churn eviction accounting");

fn paint_fixture(eager) {
    let dc = R.new(1000, 1000, 128);
    let i = 0;
    while i < 48 {
        R.mark(dc, i * 10, (i % 4) * 10, 4, 4);
        if eager { R.regions(dc); }
        i = i + 1;
    }
    let regions = R.regions(dc);
    assert(len(regions) == 48 and not R.is_full(dc), "render fixture remains equivalent");
    return len(regions);
}

assert(paint_fixture(true) == paint_fixture(false), "eager/deferred render result matches");
stage("eager_region_coalescing", 60, fn() { sink = sink + paint_fixture(true); });
stage("deferred_region_coalescing", 60, fn() { sink = sink + paint_fixture(false); });

if sink <= 0 { throw "benchmark sink was not exercised"; }
print "CACHE_RENDER_SUITE|ok";
