let FE = import("stdlib/compiler/selfhost_frontend.sapp");
let OPT = import("stdlib/compiler/optimizer.sapp");
let VM = import("stdlib/compiler/vm.sapp");

fn count_chunk(chunk) {
    let total = len(chunk.instructions);
    let i = 0;
    while i < len(chunk.constants) {
        let c = chunk.constants[i];
        if is_map(c) and map_has(c, "chunk") { total = total + count_chunk(c.chunk); }
        if is_map(c) and map_has(c, "try_chunk") {
            total = total + count_chunk(c.try_chunk) + count_chunk(c.catch_chunk);
        }
        i = i + 1;
    }
    return total;
}

let source = "fn hot(n) { let i = 0; let total = 0; while i < n { total = total + i; i = i + 1; } return total; } let answer = hot(20000);";
let raw = FE.frontend_compile(source).chunk;
let optimized = OPT.optimize_safe(raw);

let t0 = now_ms();
let raw_result = VM.run_bounded(raw, map{ max_steps: 500000 });
let t1 = now_ms();
let opt_result = VM.run_bounded(optimized.chunk, map{ max_steps: 500000 });
let t2 = now_ms();

if raw_result.globals.answer != opt_result.globals.answer { throw "benchmark semantic mismatch"; }
print "selfhost_vm_superinstructions";
print "raw_instructions=" + str(count_chunk(raw));
print "optimized_instructions=" + str(count_chunk(optimized.chunk));
print "locals_fused=" + str(optimized.stats.locals_fused);
print "raw_steps=" + str(raw_result.runtime.steps);
print "optimized_steps=" + str(opt_result.runtime.steps);
print "raw_ms=" + str(t1 - t0);
print "optimized_ms=" + str(t2 - t1);
