// Reproducible PBLang Android userspace-emulator stage benchmark.
let A = import("stdlib:android_emulator.sapp");
let FE = import("stdlib/compiler/selfhost_frontend.sapp");
let PBCK = import("stdlib:selfhost_pbck.sapp");
let B = import("stdlib:benchmark.sapp");

let PACKAGE = "org.pblang.benchmark";
let SPEC = map{
    package: PACKAGE, min_sdk: 26, target_sdk: 34,
    activities: [map{ name: ".MainActivity", exported: true }],
    main_activity: ".MainActivity", permissions: ["android.permission.INTERNET"],
    allow_cleartext: false
};
let SOURCE = "let total = 0; let i = 0; while i < 1000 { total = total + i; i = i + 1; } let answer = total;";
let COMPILED = FE.frontend_compile(SOURCE);
if not COMPILED.ok { throw "android emulator benchmark compile failed"; }
let ARTIFACT = PBCK.serialize_chunk(COMPILED.chunk);

fn lifecycle_round() {
    let em = A.new(34, "arm64");
    if not A.install(em, SPEC).ok { throw "android emulator benchmark install failed"; }
    if not A.start_activity(em, "system", PACKAGE).ok { throw "android emulator benchmark launch failed"; }
    if not A.background(em, PACKAGE).ok { throw "android emulator benchmark background failed"; }
    if not A.destroy(em, PACKAGE).ok { throw "android emulator benchmark destroy failed"; }
    return A.stats(em).events;
}

let runtime_em = A.new(34, "arm64", map{ max_events: 10000 });
if not A.install(runtime_em, SPEC).ok or not A.start_activity(runtime_em, "system", PACKAGE).ok {
    throw "android emulator benchmark runtime setup failed";
}
fn execute_round() {
    let run = A.run_pbcs(runtime_em, PACKAGE, ARTIFACT, nil,
        map{ max_steps: 50000, max_frames: 16, max_stack: 256, max_locals: 256,
            max_output: 16, max_value_items: 2048 });
    if not run.ok or run.globals.answer != 499500 { throw "android emulator benchmark parity failed"; }
    return run.runtime.steps;
}

fn samples(thunk, count) {
    let out = []; let i = 0;
    while i < count {
        let start = now_ms(); thunk(); array_push(out, now_ms() - start); i = i + 1;
    }
    return out;
}

let lifecycle = B.stats("android_lifecycle", samples(lifecycle_round, 9));
let execution = B.stats("android_pbcs_execution", samples(execute_round, 9));
print "ANDROID_EMULATOR_BENCH|lifecycle|" + json_stringify(lifecycle);
print "ANDROID_EMULATOR_BENCH|pbcs|" + json_stringify(execution);
print "ANDROID_EMULATOR_ARTIFACT|bytes|" + str(len(ARTIFACT));
print "ANDROID_EMULATOR_SUITE|ok";
