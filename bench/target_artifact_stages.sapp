let T = import("stdlib:target_artifact.sapp");
let ir = [["seti",0,0],["seti",1,32],["loop",1,[["addi",0,1]]]];
let cases = [
    ["dos","6.22","x86"], ["cpm","2.2","z80"],
    ["linux","6.0","x86"], ["linux","6.0","x86_64"], ["linux","6.0","arm64"],
    ["windows","11","x86"], ["windows","11","x86_64"], ["macos","14","x86_64"]
];
let rounds = 200; let bytes = 0; let i = 0; let j = 0;
let t0 = now_ms();
while i < rounds {
    j = 0;
    while j < len(cases) {
        let p = T.plan(cases[j][0], cases[j][1], cases[j][2]);
        let a = T.build_ir(p, ir); bytes = bytes + a.size;
        j = j + 1;
    }
    i = i + 1;
}
let elapsed = now_ms() - t0;
print "target_artifact_stages rounds=" + str(rounds) + " artifacts=" + str(rounds * len(cases)) + " bytes=" + str(bytes) + " ms=" + str(elapsed);
