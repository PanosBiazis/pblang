// Same codec workload before/after the PBCS minimum-arity fix.
// Run with --allow-env -- <functions|plain> <iterations>.
let FE = import("stdlib/compiler/selfhost_frontend.sapp");
let PB = import("stdlib/selfhost_pbck.sapp");
let VM = import("stdlib/compiler/vm.sapp");
let raw = try env_get("PBLANG_SCRIPT_ARGS") catch "";
let args = if raw == nil or raw == "" { [] } else { str_split(raw, "\n") };
let mode = if len(args) > 0 { args[0] } else { "functions" };
let iterations = if len(args) > 1 { parse_number(args[1]) } else { 1000 };
if mode != "functions" and mode != "plain" { throw "expected functions or plain"; }
if iterations < 1 or iterations != num_floor(iterations) { throw "expected positive iterations"; }
let source = if mode == "functions" {
    "fn add(a,b=2) { return a+b; } fn outer(x) { return fn(y) { return x+y; }; } let f=outer(7); print add(3)+f(4);"
} else { "let a=7; let b=9; print a+b;" };
let compiled = FE.frontend_compile(source);
if not compiled.ok { throw "benchmark compilation failed"; }
let size = 0; let i = 0;
while i < iterations {
    let bytes = PB.serialize_chunk(compiled.chunk);
    let restored = PB.deserialize_chunk(bytes);
    if str(VM.run(restored).output) != "[16]" { throw "benchmark output mismatch"; }
    size = len(bytes); i = i + 1;
}
print mode + ": iterations=" + str(iterations) + " artifact_bytes=" + str(size);
