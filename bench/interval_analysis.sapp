// Compare the same overlap-count task against an independent quadratic oracle.
// analyze also computes coverage, gaps and peak; the oracle computes counts only.
let I=import("stdlib:interval_analysis.sapp");
fn reference(data) {
 let counts=[]; let pairs=0;
 for a in range(0,len(data)) {
  let count=0;
  for b in range(0,len(data)) {
   if a!=b and data[a].start_ms<data[b].end_ms and data[b].start_ms<data[a].end_ms {count=count+1;}
  }
  array_push(counts,count);pairs=pairs+count;
 }
 return map{overlap_pairs:pairs/2,overlaps_by_index:counts};
}
let results=[];
for size in [32,128,512] {
 let data=[];
 for i in range(0,size) {let start=num_mod(i*31,size*4);array_push(data,map{start_ms:start,end_ms:start+1+num_mod(i*7,45)});}
 let expected=reference(data);let actual=I.analyze(data);
 assert(actual.overlap_pairs==expected.overlap_pairs and actual.overlaps_by_index==expected.overlaps_by_index,"same overlap counts");
 for warm in range(0,2) {reference(data);I.analyze(data);}
 let slow=[];let fast=[];
 for sample in range(0,7) {
  let start=clock();let a=reference(data);array_push(slow,(clock()-start)*1000);
  start=clock();let b=I.analyze(data);array_push(fast,(clock()-start)*1000);
  assert(a.overlaps_by_index==b.overlaps_by_index and a.overlap_pairs==b.overlap_pairs,"every measured result agrees");
 }
 array_push(results,map{intervals:size,reference_ms:slow,analysis_ms:fast});
}
print json_stringify(results);
