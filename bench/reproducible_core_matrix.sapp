// Reproducible compiled/interpreted competitor matrix. Requires --allow-all.
let R = import("stdlib:repro_benchmark.sapp");

fn value_or(value, fallback) { return if value == nil { fallback } else { value }; }
fn stat_value(summary, field) {
    if summary == nil { return "-"; }
    return str(value_or(try summary[field] catch nil, "-"));
}

let env = R.environment();
print "BENCH_ENV|schema=pblang.repro_benchmark.v1|kernel=" + env.kernel
    + "|cpu=" + env.cpu_model + "|logical_cpus=" + str(env.logical_cpus)
    + "|pblang=" + env.pblang + "|kernel_items=" + str(env.kernel_items);

let coverage = R.coverage(); let ci = 0;
while ci < len(coverage) {
    let c = coverage[ci];
    print "BENCH_COVERAGE|" + c.category + "|" + c.status + "|" + c.harness
        + "|" + str(value_or(try c.reason catch nil, "-"));
    ci = ci + 1;
}

let languages = R.languages(); let vi = 0;
while vi < len(languages) {
    let v = R.version(languages[vi].id);
    print "BENCH_TOOLCHAIN|" + languages[vi].id + "|" + v.status + "|" + str(v.version);
    vi = vi + 1;
}

let rows = R.run_matrix(nil, nil, 3, 7, 45);
print "BENCH_SCHEMA|workload|language|mode|status|compile_cold_ms|compile_median_ms|compile_p95_ms|run_cold_ms|run_median_ms|run_p95_ms|rss_median_kib|cpu_median_percent|artifact_bytes|checksum|run_samples_ms";
let ok = 0; let unavailable = 0; let failed = 0; let i = 0;
while i < len(rows) {
    let row = rows[i];
    if row.status == "ok" {
        print "BENCH_ROW|" + row.workload + "|" + row.language + "|" + row.mode + "|ok|"
            + str(value_or(row.compile_cold_ms, "-")) + "|"
            + stat_value(row.compile_warm, "median_ms") + "|" + stat_value(row.compile_warm, "p95_ms") + "|"
            + str(row.run_cold_ms) + "|" + stat_value(row.run_warm, "median_ms") + "|"
            + stat_value(row.run_warm, "p95_ms") + "|" + stat_value(row.rss_warm, "median_ms") + "|"
            + stat_value(row.cpu_warm, "median_ms") + "|" + str(value_or(row.artifact_size_bytes, "-")) + "|"
            + row.checksum + "|" + str(row.run_samples_ms);
        ok = ok + 1;
    } else {
        print "BENCH_ROW|" + row.workload + "|" + row.language + "|" + str(try row.mode catch "-")
            + "|" + row.status + "|-|-|-|-|-|-|-|-|-|-|[]";
        if row.status == "unavailable" { unavailable = unavailable + 1; }
        else { failed = failed + 1; }
    }
    i = i + 1;
}
print "BENCH_SUMMARY|rows=" + str(len(rows)) + "|ok=" + str(ok)
    + "|unavailable=" + str(unavailable) + "|failed=" + str(failed);
if failed > 0 { throw "reproducible competitor matrix contains failed rows"; }
print "REPRODUCIBLE_CORE_MATRIX_SUITE|ok";
