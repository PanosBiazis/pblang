// Reproducible phase benchmark for recursive types, generics and typed ADTs.
let T = import("stdlib/compiler/tokenizer.sapp");
let P = import("stdlib/compiler/parser.sapp");
let C = import("stdlib/compiler/typeck.sapp");

fn source_for(count, invalid) {
    let source = ""; let i = 0;
    while i < count {
        let suffix = str(i);
        source = source
            + "struct S" + suffix + " { value: number, label: string } "
            + "enum E" + suffix + " { A, B, C(number) } ";
        if invalid {
            source = source
                + "fn classify" + suffix + "(e: E" + suffix + "): number { "
                + "return match e.__variant { case \"A\": 1; }; } "
                + "let s" + suffix + " = S" + suffix + "(" + suffix + ", 9); "
                + "let e" + suffix + " = E" + suffix + ".C(\"bad\"); ";
        } else {
            source = source
                + "fn classify" + suffix + "(e: E" + suffix + "): number { "
                + "return match e.__variant { case \"A\": 1; case \"B\": 2; case \"C\": 3; }; } "
                + "let s" + suffix + " = S" + suffix + "(" + suffix + ", \"ok\"); "
                + "let n" + suffix + ": number = s" + suffix + ".value; "
                + "let e" + suffix + ": E" + suffix + " = E" + suffix + ".C(" + suffix + "); ";
        }
        source = source
            + "let nested" + suffix
            + ": map<string,result<array<number?>,string>> = map{}; ";
        i = i + 1;
    }
    return source;
}

fn percentile_index(count, percentile) {
    let index = num_floor((count - 1) * percentile);
    if index < 0 { return 0; }
    if index >= count { return count - 1; }
    return index;
}

fn emit(name, samples, units, checksum) {
    let sorted = array_sort(samples); let total = 0.0; let i = 0;
    while i < len(sorted) { total = total + sorted[i]; i = i + 1; }
    let p50 = sorted[percentile_index(len(sorted), 0.50)];
    let p95 = sorted[percentile_index(len(sorted), 0.95)];
    print "TYPE_SYSTEM_PHASE|" + name + "|" + str(len(sorted))
        + "|" + str(total / len(sorted)) + "|" + str(p50) + "|" + str(p95)
        + "|" + str(sorted[0]) + "|" + str(sorted[len(sorted) - 1])
        + "|" + str(units) + "|" + str(checksum) + "|ok";
}

fn parse_checked(tokens, expected_statements) {
    let ast = P.parse(tokens);
    if len(ast.errors) != 0 or len(ast.stmts) != expected_statements {
        throw "type-system benchmark: parse correctness gate";
    }
    return ast;
}

fn measure_parse(name, tokens, expected_statements, sample_count) {
    parse_checked(tokens, expected_statements);
    let samples = []; let checksum = 0; let i = 0;
    while i < sample_count {
        let started = now_ms();
        let ast = parse_checked(tokens, expected_statements);
        array_push(samples, now_ms() - started);
        checksum = checksum + len(ast.stmts); i = i + 1;
    }
    emit(name, samples, expected_statements, checksum);
}

fn measure_typecheck(name, ast, expected_diagnostics, sample_count) {
    let warm = C.type_check(ast.stmts);
    if len(warm) != expected_diagnostics {
        throw "type-system benchmark: " + name + " expected " + str(expected_diagnostics)
            + " diagnostics, got " + str(len(warm));
    }
    let samples = []; let checksum = 0; let i = 0;
    while i < sample_count {
        let started = now_ms();
        let diagnostics = C.type_check(ast.stmts);
        array_push(samples, now_ms() - started);
        checksum = checksum + len(diagnostics); i = i + 1;
    }
    emit(name, samples, len(ast.stmts), checksum);
}

let groups = 16;
let valid_tokens = T.tokenize(source_for(groups, false));
let invalid_tokens = T.tokenize(source_for(groups, true));
let valid_ast = parse_checked(valid_tokens, groups * 7);
let invalid_ast = parse_checked(invalid_tokens, groups * 6);

print "SCHEMA|type_system_phase|samples|average_ms|p50_ms|p95_ms|min_ms|max_ms|units|checksum|status";
measure_parse("recursive-type-parse", valid_tokens, groups * 7, 30);
measure_typecheck("typed-adt-valid", valid_ast, 0, 30);
measure_typecheck("typed-adt-diagnostics", invalid_ast, groups * 3, 30);
print "TYPE_SYSTEM_SUITE|ok";
