// Args: module path, columns, repetitions. The module may be a frozen baseline.
// Uses an in-memory recording connection: measures SQL construction, not SQLite.
let args=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");
let O=import(args[0]);
let columns=parse_number(args[1]);
let repeats=parse_number(args[2]);
let values=map{};
for i columns {values["field_"+str(i)]=i;}
let last_sql="";
let last_params=[];
let conn=map{exec:fn(sql,params){last_sql=sql;last_params=params;return nil;},last_insert_rowid:fn(){return 42;}};
let started=clock();
for i repeats {O.insert(conn,"items",values);O.upsert(conn,"items",values);}
let elapsed=clock()-started;
if len(last_params)!=columns {throw "benchmark parameter count mismatch";}
print "ORM_BUILDERS|"+str(elapsed)+"|"+sha256(last_sql+json_stringify(last_params))+"|ok";
