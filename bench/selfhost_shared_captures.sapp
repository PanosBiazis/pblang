// Equal-output workloads on the old and new compiler; process CPU/RSS includes
// compilation. Shared-sibling correctness is covered separately, not timed as
// if the old incorrect result were equivalent work.
let FE=import("stdlib/compiler/selfhost_frontend.sapp");
let VM=import("stdlib/compiler/vm.sapp");
let raw=try env_get("PBLANG_SCRIPT_ARGS") catch "";
let args=if raw==nil or raw=="" {[]} else {str_split(raw,"\n")};
let mode=if len(args)>0 {args[0]} else {"counter"};
let source="";let expected=5000;
if mode=="counter" {
    source="fn make(){let n=0;return fn(){n=n+1;return n;};}let c=make();let result=0;for i 5000 {result=c();}print result;";
} elif mode=="creation" {
    source="fn make(n){return fn(){return n;};}let result=0;for i 1000 {let f=make(i);result=result+f();}print result;";
    expected=499500;
} elif mode=="numeric" {
    source="let result=0;for i 5000 {result=result+1;}print result;";
} else {throw "unknown capture benchmark mode";}
let c=FE.frontend_compile(source);assert(c.ok,"benchmark compilation");
for i 3 {assert(VM.run(c.chunk).output==[expected],"benchmark output parity");}
print mode+": verified";
