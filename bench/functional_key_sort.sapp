let Old=import("./fixtures/functional_sort_before_keys.sapp");let F=import("stdlib:functional.sapp");
fn compare(a,b){if a<b {return -1;}if a>b {return 1;}return 0;}
fn cheap(row){return row.k;}
fn computed(row){let value=row.k;for _i 24 {value=(value*17+11)%1009;}return value;}
fn elapsed(call,a,key){let start=clock();call(a,key);return (clock()-start)*1000;}
let ops=[
 map{name:"sort_values",before:fn(a,key){return Old.stable_sort_by(a,fn(x,y){return compare(key(x),key(y));});},after:fn(a,key){return F.stable_sort_by_key(a,key,compare);}},
 map{name:"sort_indices",before:fn(a,key){let indexed=[];let i=0;while i<len(a){push(indexed,map{index:i,value:a[i]});i=i+1;}let sorted=Old.stable_sort_by(indexed,fn(x,y){return compare(key(x.value),key(y.value));});let out=[];for row in sorted {push(out,row.index);}return out;},after:fn(a,key){return F.stable_argsort_by_key(a,key,compare);}}
];
let results=[];
for n in [8,128,512] {for pattern in ["reversed","duplicates"] {
 let rows=[];for i n {let k=n-i;if pattern=="duplicates" {k=i%7;}push(rows,map{k:k,id:i});}
 for projection in [map{name:"cheap",key:cheap},map{name:"computed",key:computed}] {
  let key=projection.key;
  for op in ops {
   assert(op.before(rows,key)==op.after(rows,key),"full stable result parity");
   // Count projection calls separately, outside the timed work.
   let counter=[0];let counted=fn(v){counter[0]=counter[0]+1;return key(v);};
   op.before(rows,counted);let old_calls=counter[0];counter[0]=0;op.after(rows,counted);assert(counter[0]==n,"one projection per input");
   for _warmup 2 {op.before(rows,key);op.after(rows,key);}
   let before=[];let after=[];
   for sample 7 {
    if sample%2==0 {push(before,elapsed(op.before,rows,key));push(after,elapsed(op.after,rows,key));}
    else {push(after,elapsed(op.after,rows,key));push(before,elapsed(op.before,rows,key));}
   }
   push(results,map{operation:op.name,size:n,pattern:pattern,projection:projection.name,before_key_calls:old_calls,after_key_calls:n,before_ms:before,after_ms:after});
  }
 }
}}
print json_stringify(map{samples:7,warmups:2,calls_per_sample:1,results:results});
