let Before=import("fixtures/measure_document_before_results.sapp");let After=import("stdlib:measure_document.sapp");
fn batch(f,doc) {let start=clock();for i in range(0,10) {f(doc);}return (clock()-start)*1000/10;}
let results=[];
for count in [1,16,31] {
 let d=After.create("Synthetic benchmark");for i in range(1,count) {d=After.append(d);}
 for i in range(0,count) {if i%3==0 {d=After.set_row(d,i,"Resistance",2.2,"kohm","ohm");} elif i%3==1 {d=After.set_row(d,i,"Temperature",20,"degC","degF");} else {d=After.set_row(d,i,"Difference",10,"degC","degF","difference");}}
 assert(Before.results(d)==After.results(d),"same workload outputs");
 for i in range(0,3) {batch(Before.results,d);batch(After.results,d);}
 let before=[];let after=[];for i in range(0,9) {if i%2==0 {array_push(before,batch(Before.results,d));array_push(after,batch(After.results,d));} else {array_push(after,batch(After.results,d));array_push(before,batch(Before.results,d));}}
 array_push(results,map{rows:count,before_ms:before,after_ms:after});
}
print json_stringify(map{clock:"wall",unit:"ms_per_results_call",warmups:3,samples:9,repetitions:10,results:results});
