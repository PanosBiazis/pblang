// Robust benchmark evidence and fail-closed regression-budget overhead.
let B = import("stdlib:benchmark.sapp");
let P = import("stdlib:performance_budget.sapp");

let SAMPLES = [10, 10, 11, 9, 10, 10, 12, 10, 10, 30];
let summary = B.stats("quality-fixture", SAMPLES);
if summary.median_ms != 10 or summary.outlier_count != 2 { throw "benchmark quality summary mismatch"; }

let baseline = map{ median_ms: 10, peak_rss_kb: 1000, artifact_bytes: 500, ops_per_second: 1000 };
let candidate = map{ median_ms: 9, peak_rss_kb: 1020, artifact_bytes: 495, ops_per_second: 1100 };
let budgets = [
    map{ metric: "median_ms", max_regression_percent: 0 },
    map{ metric: "peak_rss_kb", max_regression_percent: 3 },
    map{ metric: "artifact_bytes", max_regression_percent: 0 },
    map{ metric: "ops_per_second", max_regression_percent: 0, lower_is_better: false }
];
if not P.evaluate(baseline, candidate, budgets).ok { throw "accepted performance budget failed"; }
if P.evaluate(baseline, map{ median_ms: 11 }, [map{ metric: "median_ms", max_regression_percent: 5 }]).ok { throw "regression budget did not fail closed"; }

fn stage(name, n, work) {
    let t0 = now_ms(); let i = 0;
    while i < n { work(); i = i + 1; }
    let elapsed = now_ms() - t0;
    print "BENCHMARK_QUALITY_PHASE|" + name + "|" + str(n) + "|" + str(elapsed) + "|" + str(elapsed / n);
}

print "BENCHMARK_QUALITY|median_ms|" + str(summary.median_ms);
print "BENCHMARK_QUALITY|p95_ms|" + str(summary.p95_ms);
print "BENCHMARK_QUALITY|mad_ms|" + str(summary.mad_ms);
print "BENCHMARK_QUALITY|iqr_ms|" + str(summary.iqr_ms);
print "BENCHMARK_QUALITY|cv_percent|" + str(summary.cv_percent);
print "BENCHMARK_QUALITY|outlier_count|" + str(summary.outlier_count);
print "BENCHMARK_QUALITY|stability|" + summary.stability;
stage("robust_summary", 2000, fn() { B.stats("quality-fixture", SAMPLES); });
stage("four_metric_budget", 5000, fn() { P.evaluate(baseline, candidate, budgets); });
print "BENCHMARK_QUALITY_SUITE|ok";
