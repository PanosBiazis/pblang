let T=import("stdlib:text_document.sapp");
fn reference(doc){let size=T.validate(doc);let words=0;let characters=0;for block in doc.blocks{let inside=false;characters=characters+len(block.text);for i in range(0,len(block.text)){let c=str_slice(block.text,i,i+1);let space=c==" " or c=="\t" or c=="\n" or c=="\r";if not space and not inside{words=words+1;}inside=not space;}}return map{blocks:size.blocks,text_bytes:size.text_bytes,body_characters:characters,body_words:words};}
let doc=T.create();doc.blocks=[];for i in range(0,32){array_push(doc.blocks,map{kind:"paragraph",text:str_repeat("λέξη αβ ",50)});}assert(reference(doc)==T.statistics(doc),"identical workload/results");for warm in range(0,2){reference(doc);T.statistics(doc);}let old=[];let current=[];for sample in range(0,7){let start=clock();reference(doc);array_push(old,(clock()-start)*1000);start=clock();T.statistics(doc);array_push(current,(clock()-start)*1000);}print json_stringify(map{reference_ms:old,current_ms:current,blocks:32,warmups:2,samples:7});
