let P=import("stdlib:palette_document.sapp");let Old=import("fixtures/palette_document_before_strip.sapp");
fn timed(doc,current){let start=clock();for i in range(0,5){if current {P.strip(doc);} else {Old.strip(doc);}}return (clock()-start)*1000/5;}
let results=[];for size in [1,4,8]{let doc=P.create();for i in range(1,size){doc=P.append(doc,"Color "+str(i),"#7357e8");}assert(P.strip(doc)==Old.strip(doc),"identical pixels");for warm in range(0,3){timed(doc,false);timed(doc,true);}let before=[];let after=[];for sample in range(0,9){if num_mod(sample,2)==0 {array_push(before,timed(doc,false));array_push(after,timed(doc,true));} else {array_push(after,timed(doc,true));array_push(before,timed(doc,false));}}array_push(results,map{swatches:size,before_ms:before,after_ms:after});}
print json_stringify(map{warmups:3,samples:9,calls_per_sample:5,unit:"ms_per_strip_call",results:results});
