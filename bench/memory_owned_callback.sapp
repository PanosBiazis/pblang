// Compare explicit scalar cleanup with opt-in automatic checked cleanup.
// Usage: pblang run bench/memory_owned_callback.sapp --allow-all -- manual|automatic
let M=import("stdlib:memory.sapp");
let OS=import("stdlib:os.sapp");
let args=OS.script_args();
if len(args) != 1 or (args[0] != "manual" and args[0] != "automatic") { throw "expected manual or automatic"; }
let Owned=if args[0] == "automatic" { import("stdlib:memory_owned.sapp") } else { nil };
fn manual(i) {
    let h=M.box(i);
    let result=M.scope(fn(){M.borrow(h);return M.read(h);});
    M.free(h);
    return result;
}
fn automatic(i) { return Owned.with_box(i,fn(h){M.borrow(h);return M.read(h);}); }
let work=if args[0] == "manual" { manual } else { automatic };
fn batch(n) {
    let sum=0; let i=0;
    while i<n { sum=sum+work(i); i=i+1; }
    return sum;
}
let before=M.stats();
if batch(20000) != 199990000 { throw "memory callback warmup mismatch"; }
let start=now_ms(); let checksum=batch(20000); let elapsed=now_ms()-start;
let after=M.stats();
if checksum != 199990000 or after.total_locations != before.total_locations or after.active_borrows != before.active_borrows or after.lifetime_depth != before.lifetime_depth { throw "memory callback benchmark mismatch"; }
print "OWNED_CALLBACK|"+args[0]+"|20000|"+str(elapsed)+"|owners_delta=0|borrows_delta=0|ok";
