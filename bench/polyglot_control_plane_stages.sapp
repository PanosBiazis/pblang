// Portable pblang-only benchmark for the polyglot control plane. It exercises
// registry routing and security policy without invoking foreign toolchains.

let REGISTRY = import("stdlib:polyglot_registry.sapp");
let GUARD = import("stdlib:polyglot_guard.sapp");
let POLICY = import("stdlib:polyglot_policy.sapp");
let ROUTER = import("stdlib:polyglot_router.sapp");

let SAFE = "import moderngl\nprint('ok')\n";
let UNSAFE = "import os\nos.system('rm -rf /')\n";

fn registry_lookup(rounds) {
    let checksum = 0;
    let i = 0;
    let t0 = now_ms();
    while i < rounds {
        if REGISTRY.is_supported("python") { checksum = checksum + 1; }
        if REGISTRY.category_of("rust") == "compiled" { checksum = checksum + 1; }
        if REGISTRY.lang_for_ext("js") == "javascript" { checksum = checksum + 1; }
        i = i + 1;
    }
    let elapsed = now_ms() - t0;
    if checksum != rounds * 3 { throw "polyglot benchmark: registry lookup mismatch"; }
    print "POLYGLOT_PHASE|registry_lookup|" + str(rounds) + "|" + str(elapsed) + "|" + str(elapsed / rounds);
}

fn alias_lookup(rounds) {
    let checksum = 0;
    let i = 0;
    let t0 = now_ms();
    while i < rounds {
        if REGISTRY.alias("py") == "python" { checksum = checksum + 1; }
        if REGISTRY.alias("c++") == "cpp" { checksum = checksum + 1; }
        i = i + 1;
    }
    let elapsed = now_ms() - t0;
    if checksum != rounds * 2 { throw "polyglot benchmark: alias mismatch"; }
    print "POLYGLOT_PHASE|alias_lookup|" + str(rounds) + "|" + str(elapsed) + "|" + str(elapsed / rounds);
}

fn guard_scan(rounds) {
    let blocked = 0;
    let i = 0;
    let t0 = now_ms();
    while i < rounds {
        if GUARD.scan(SAFE, "python").safe and not GUARD.scan(UNSAFE, "python").safe {
            blocked = blocked + 1;
        }
        i = i + 1;
    }
    let elapsed = now_ms() - t0;
    if blocked != rounds { throw "polyglot benchmark: guard mismatch"; }
    print "POLYGLOT_PHASE|guard_scan_pair|" + str(rounds) + "|" + str(elapsed) + "|" + str(elapsed / rounds);
}

fn policy_report(rounds) {
    let findings = 0;
    let i = 0;
    let t0 = now_ms();
    while i < rounds {
        let result = POLICY.report("python", UNSAFE);
        if not result.ran and not result.safe and len(result.findings) > 0 {
            findings = findings + 1;
        }
        i = i + 1;
    }
    let elapsed = now_ms() - t0;
    if findings != rounds { throw "polyglot benchmark: policy report mismatch"; }
    print "POLYGLOT_PHASE|policy_report|" + str(rounds) + "|" + str(elapsed) + "|" + str(elapsed / rounds);
}

fn route_filename(rounds) {
    let resolved = 0;
    let i = 0;
    let t0 = now_ms();
    while i < rounds {
        let route = ROUTER.resolve("src/worker.ts");
        if route.ok and route.language == "typescript" { resolved = resolved + 1; }
        i = i + 1;
    }
    let elapsed = now_ms() - t0;
    if resolved != rounds { throw "polyglot benchmark: filename route mismatch"; }
    print "POLYGLOT_PHASE|route_filename|" + str(rounds) + "|" + str(elapsed) + "|" + str(elapsed / rounds);
}

registry_lookup(100);
alias_lookup(10000);
guard_scan(1000);
policy_report(1000);
route_filename(10000);
print "POLYGLOT_CONTROL_PLANE_SUITE|ok";
