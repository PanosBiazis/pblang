// The environment-selected baseline must be an operator-reviewed prior module.
let OLD=import(env_get("PB_SOURCE_ANALYSIS_REFERENCE"));
let NEW=import("stdlib:source_analysis.sapp");
let B=import("stdlib:benchmark.sapp");
let source="let value=1;";
fn measure(module,options) {
    let start=now_ms();let result=nil;
    for i 100 {result=module.analyze(source,"selection-benchmark.sapp",options);}
    return map{elapsed:now_ms()-start,result:result};
}
for item in [map{name:"default",options:map{}},
    map{name:"performance",options:map{analyses:["performance"]}},
    map{name:"all",options:map{analyses:["all"]}}] {
    let control=OLD.analyze(source,"selection-benchmark.sapp",item.options);
    if not control.ok or not control.passed {throw "selection benchmark control";}
    let expected=json_stringify(control);let before=[];let after=[];let ratios=[];
    for i 14 {
        let a=nil;let b=nil;
        if num_mod(i,2)==0 {a=measure(OLD,item.options);b=measure(NEW,item.options);}
        else {b=measure(NEW,item.options);a=measure(OLD,item.options);}
        if json_stringify(a.result)!=expected or json_stringify(b.result)!=expected
            or a.elapsed<=0 or b.elapsed<=0 {throw "selection benchmark report/clock mismatch";}
        if i>=2 {push(before,a.elapsed);push(after,b.elapsed);push(ratios,b.elapsed/a.elapsed);}
    }
    print json_stringify(map{operation:item.name,rounds:100,before_ms:before,after_ms:after,paired_ratios:ratios,
        before_stats:B.stats("before",before),after_stats:B.stats("after",after),
        ratio_stats:B.stats("ratio",ratios)});
}
