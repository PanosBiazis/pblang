let G=import("stdlib:table_group.sapp");let S=import("stdlib:sheet_document.sapp");
fn rescanned(doc){let rows=G.group_rows(doc,0,true);let cols=G.group_rows(doc,1,true);let head=["Row / Column"];for label in cols.labels{array_push(head,label);}let cells=[head];for a in rows.labels{let row=[a];for b in cols.labels{let count=0;for i in range(1,len(doc.cells)){if doc.cells[i][0]==a and doc.cells[i][1]==b{count=count+1;}}array_push(row,str(count));}array_push(cells,row);}let result=map{format:S.FORMAT,cells:cells};S.validate(result);return result;}
let doc=S.create(32,2);doc.cells[0]=["Row","Column"];for i in range(1,32){doc.cells[i]=["group"+str(i),"bucket"+str(num_mod(i,7))];}assert(rescanned(doc)==G.cross(doc,0,1,true),"equal results");for warm in range(0,2){rescanned(doc);G.cross(doc,0,1,true);}let old=[];let current=[];for sample in range(0,7){let start=clock();let a=rescanned(doc);array_push(old,(clock()-start)*1000);start=clock();let b=G.cross(doc,0,1,true);array_push(current,(clock()-start)*1000);assert(a==b,"same measured results");}print json_stringify(map{reference_ms:old,indexed_ms:current,warmups:2,samples:7,records:31,row_categories:31,column_categories:7});
