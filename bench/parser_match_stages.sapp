// Same already-supported grammar before/after; never compare errors to success.
let T=import("stdlib:compiler/tokenizer.sapp");
let P=import("stdlib:compiler/parser.sapp");
let B=import("stdlib:benchmark.sapp");
let source="let value=2;let result=match value {case 1:3;case 2:4;else:5;};";
let tokens=T.tokenize(source);
let first=0;let samples=[];
for iteration 8 {
    let start=now_ms();let last=nil;
    for repeat 50 {last=P.parse(tokens);}
    let elapsed=now_ms()-start;
    if len(last.errors)!=0 or len(last.stmts)!=2 or last.stmts[1].value.kind!="match" {
        throw "parser benchmark: shape";
    }
    if iteration==0 {first=elapsed;}
    if iteration>=3 {push(samples,elapsed);}
}
print json_stringify(map{operation:"parse-supported-match",invocations_per_sample:50,
    first_ms:first,samples_ms:samples,stats:B.stats("parse-supported-match",samples)});
