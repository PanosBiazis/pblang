// Measures allocation-free return/break/continue control flow in the pure
// pblang tree interpreter. Every workload has an inline correctness gate.
let INT = import("stdlib/compiler/interp.sapp");

let RECURSION = INT.compile_program(
    "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } "
    + "if fib(18) != 2584 { missing(); }"
);
let NESTED_RETURN = INT.compile_program(
    "fn nested(v) { if true { let x = v; if true { let y = x + 1; return y; } } return -1; } "
    + "let i = 0; while i < 500 { if nested(i) != i + 1 { missing(); } i = i + 1; }"
);
let LOOP_CONTROL = INT.compile_program(
    "let total = 0; let i = 0; while i < 2000 { i = i + 1; "
    + "if i % 2 == 0 { continue; } if i > 1500 { break; } total = total + i; } "
    + "if total != 562500 { missing(); }"
);
let PLAIN_LOOP = INT.compile_program(
    "let total = 0; let i = 0; while i < 10000 { total = total + i; i = i + 1; } "
    + "if total != 49995000 { missing(); }"
);
let PLAIN_LOOP_SIGNAL_CHECKS = INT.compile_program(
    "let total = 0; let i = 0; while i < 10000 { total = total + i; i = i + 1; } "
    + "if total != 49995000 { missing(); }"
);
// Controlled A/B: retain the exact source and AST shape, but force the legacy
// per-statement signal checks for this independently compiled copy.
PLAIN_LOOP_SIGNAL_CHECKS.stmts[2]["@wq"] = false;
let PLAIN_LOOP_GENERIC_DISPATCH = INT.compile_program(
    "let total = 0; let i = 0; while i < 10000 { total = total + i; i = i + 1; } "
    + "if total != 49995000 { missing(); }"
);
// Controlled A/B: same source and AST shape with leaf and direct-assignment
// plans disabled, retaining the former generic expression dispatch.
PLAIN_LOOP_GENERIC_DISPATCH.stmts[2].cond["@ip"] = nil;
PLAIN_LOOP_GENERIC_DISPATCH.stmts[2].cond["@ie"] = 6;
let generic_body = PLAIN_LOOP_GENERIC_DISPATCH.stmts[2]["@wb"];
let gi = 0;
while gi < len(generic_body) {
    generic_body[gi]["@sa"] = nil;
    if generic_body[gi]["@is"] == 1 and generic_body[gi].expr["@ie"] == 8 {
        let rhs = generic_body[gi].expr.value;
        if map_has(rhs, "@ip") { rhs["@ip"] = nil; rhs["@ie"] = 6; }
    }
    gi = gi + 1;
}

fn measure(name, ast, iterations) {
    if INT.eval_ast(ast) != true { throw "control benchmark warmup failed: " + name; }
    let samples = [];
    let i = 0;
    while i < iterations {
        let t0 = now_ms();
        if INT.eval_ast(ast) != true { throw "control benchmark failed: " + name; }
        array_push(samples, now_ms() - t0);
        i = i + 1;
    }
    let sorted = array_sort(samples);
    let total = 0.0;
    i = 0;
    while i < len(sorted) { total = total + sorted[i]; i = i + 1; }
    print "CONTROL|" + name + "|" + str(iterations) + "|" + str(total / iterations)
        + "|" + str(sorted[num_floor(len(sorted) / 2)]) + "|ok";
}

print "SCHEMA|name|iterations|average_ms|median_ms|status";
measure("recursive_return_fib18", RECURSION, 5);
measure("nested_scope_return_500", NESTED_RETURN, 5);
measure("loop_break_continue_2000", LOOP_CONTROL, 10);
measure("plain_numeric_loop_10000", PLAIN_LOOP, 10);
measure("plain_numeric_loop_10000_generic_dispatch", PLAIN_LOOP_GENERIC_DISPATCH, 10);
measure("plain_numeric_loop_10000_signal_checks", PLAIN_LOOP_SIGNAL_CHECKS, 10);
print "CONTROL_SUITE|ok";
