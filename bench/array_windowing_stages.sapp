// Identical trusted workloads before/after; no malformed native sizes executed.
let A=import("stdlib:array.sapp");let B=import("stdlib:benchmark.sapp");
let input=[];for i 1024 {push(input,i);}
for operation in ["chunk","windows"] {
    for size in [1,16,1024] {
        let first=0;let samples=[];let iteration=0;
        while iteration<8 {
            let start=now_ms();
            let result=[];let repeat=0;
            while repeat<10 {
                if operation=="chunk" {result=A.chunk(input,size);}
                else {result=A.windows(input,size,16);}
                repeat=repeat+1;
            }
            let elapsed=now_ms()-start;
            let expected=0;
            if operation=="chunk" {expected=num_floor((1024+size-1)/size);}
            else {expected=num_floor((1024-size)/16)+1;}
            if len(result)!=expected {throw "array benchmark: result shape";}
            let group=0;
            while group<len(result) {
                let offset=group*size;if operation=="windows" {offset=group*16;}
                let length=size;if length>1024-offset {length=1024-offset;}
                if len(result[group])!=length {throw "array benchmark: group shape";}
                let j=0;while j<length {
                    if result[group][j]!=offset+j {throw "array benchmark: slot";}
                    j=j+1;
                }
                group=group+1;
            }
            let j=0;while j<1024 {if input[j]!=j {throw "array benchmark: input mutation";}j=j+1;}
            if iteration==0 {first=elapsed;}
            if iteration>=3 {push(samples,elapsed);}
            iteration=iteration+1;
        }
        print json_stringify(map{operation:operation,n:1024,size:size,step:16,invocations_per_sample:10,
            first_ms:first,samples_ms:samples,stats:B.stats(operation,samples)});
    }
}
