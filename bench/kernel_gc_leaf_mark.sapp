// pblang:target=kernel
// pblang:extern heap_init gc_new gc_set_auto gc_alloc gc_set_child gc_add_root gc_live gc_collections kernel_gc_collect
// One shared root with 256 leaf children, all alive across 200000 collections.
// Prepend heap.sapp + the selected gc.sapp; QEMU exit 85 verifies the workload.
fn kmain() {
    let h=kmalloc(8);let region=kmalloc(131072);heap_init(h,region,131072);
    let g=gc_new(h);gc_set_auto(g,0);let root=gc_alloc(g,256);let i=0;
    if root==0 {outb(244,1);while 1>0 {hlt();}}
    while i<256 {
        let leaf=gc_alloc(g,0);
        if leaf==0 or gc_set_child(root,i,leaf)!=1 {outb(244,1);while 1>0 {hlt();}}
        i=i+1;
    }
    if gc_add_root(g,root)!=1 {outb(244,1);while 1>0 {hlt();}}
    i=0;while i<200000 {
        if kernel_gc_collect(g)!=0 {outb(244,1);while 1>0 {hlt();}}
        i=i+1;
    }
    if gc_live(g)!=257 or gc_collections(g)!=200000 {outb(244,1);}
    else {outb(244,42);}
    while 1>0 {hlt();}
}
