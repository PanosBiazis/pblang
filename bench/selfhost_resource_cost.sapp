// End-to-end frontend + VM controls. Modes: plain/bounded; workloads below.
// Compare identical source and retained executable across isolated revisions.
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let args=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");
assert(len(args)==2,"expected plain|bounded and numeric|failed|success|blocks|failed_blocks");
assert(args[0]=="plain" or args[0]=="bounded","unknown execution mode");
let source="";let want=0;
if args[1]=="numeric" {
    source="let total=0;for i 20000 {let v=i+1;total=total+v;} print total;";want=200010000;
} elif args[1]=="failed" or args[1]=="success" {
    source="let total=0;for i 1000 {let x=try (if true {let v=i+1;throw 1;v;} else {0;}) catch 0;total=total+x;} print total;";
    if args[1]=="success" {source=str_replace_all(source,"throw 1;","");want=500500;}
} elif args[1]=="blocks" or args[1]=="failed_blocks" {
    source="let total=0;";
    for i 16 {
        if args[1]=="blocks" {source=source+"if true {let v=str_repeat(\"x\",2097152);total=total+len(v);}";}
        else {source=source+"total=total+len(try (if true {let v=str_repeat(\"x\",2097152);throw 77;v;} else {\"\";}) catch \"\");";}
    }
    source=source+"print total;";
    if args[1]=="blocks" {want=33554432;}
} else {throw "unknown resource-cost workload";}
let c=F.frontend_compile(source);assert(c.ok,"compile");
let r=nil;
if args[0]=="bounded" {r=V.run_bounded(c.chunk,map{max_steps:10000000,max_value_items:4194304});}
else {r=V.run(c.chunk);}
assert(r.output==[want],"output parity");
// Print only scalar output, never cyclic chunks, contexts or globals.
print r.output;
