// Unchanged builtin workload used before/after UTF-8 dispatch registration.
// Compile once and run repeatedly; no file, device, network or GUI work.
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let compiled=F.frontend_compile("fn work(n){let a=[1,2,3];let total=0;for i n {total=total+len(a)+bit_shr(i,1);}print total;} work(10000);");
if not compiled.ok { throw "control workload did not compile"; }
for repeat 4 {
    let result=V.run(compiled.chunk);
    if result.output!=[25025000] { throw "control workload result changed"; }
}
print "selfhost_utf8_control_pass";
