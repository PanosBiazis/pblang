// Hold arrays of a requested width; covers empty, direct and generic paths.
// Pass 0, 1, 2, 3 or 16 and use the same file on both measured revisions.
let F=import("stdlib/compiler/selfhost_frontend.sapp");
let V=import("stdlib/compiler/vm.sapp");
let args=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");
assert(len(args)==1,"expected array width");
let width=parse_number(args[0]);
assert(width==0 or width==1 or width==2 or width==3 or width==16,"benchmark width");
let elements=[];for i width {array_push(elements,"i");}
let source="let saved=[];for i 10000 {array_push(saved,["+str_join(elements,",")+"]);}"
    +"print len(saved);print len(saved[9999]);";
let expected=[10000,width];
if width>0 {source=source+"print saved[9999][0];";array_push(expected,9999);}
let c=F.frontend_compile(source);assert(c.ok,"array benchmark compilation");
assert(V.run(c.chunk).output==expected,"array benchmark output");
print "arrays: verified";
