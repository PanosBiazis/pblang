// Args: term/value count, repeats, optional mode (scalar, alternating, unique or membership). Measures optional filter construction, no database.
let P=import("stdlib:sql_predicate.sapp");
let args=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");
let count=parse_number(args[0]);let repeats=parse_number(args[1]);
let mode="scalar";if len(args)>2 {mode=args[2];}
let terms=[];
if mode=="membership" {
 let values=[];for i count {array_push(values,i);}
 terms=[["value","in",values]];
} else {
 if mode!="scalar" and mode!="alternating" and mode!="unique" {throw "invalid benchmark mode";}
 for i count {
  let name="value";
  if mode=="alternating" {if i%2==1 {name="other";}}
  if mode=="unique" {name="value"+str(i);}
  array_push(terms,[name,"ge",i]);
 }
}
let start=clock();let result=nil;
for i repeats {result=P.compile_all(terms);}
let elapsed=clock()-start;
if len(result.params)!=count {throw "predicate benchmark mismatch";}
print "SQL_PREDICATE|"+str(elapsed)+"|"+sha256(result.sql+json_stringify(result.params))+"|ok";
