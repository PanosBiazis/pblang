// Cross-feature pblang-only benchmark: one-line app composition, security,
// performance budgets, product-health aggregation, and polyglot policy.
let APP = import("stdlib:app.sapp");
let PERF = import("stdlib:product_performance.sapp");
let HEALTH = import("stdlib:product_health.sapp");
let POLYGLOT = import("stdlib:polyglot_router.sapp");

let BASELINE = map{ latency_ms: 10, memory_bytes: 1000, artifact_bytes: 500, throughput_per_second: 100 };
let CANDIDATE = map{ latency_ms: 9, memory_bytes: 1020, artifact_bytes: 490, throughput_per_second: 110 };
let BUDGETS = PERF.standard_budgets();
let APP_OPTIONS = map{ preview: true, start: "web" };

fn stage(name, iterations, thunk) {
    let t0 = now_ms(); let i = 0;
    while i < iterations { thunk(); i = i + 1; }
    let elapsed = now_ms() - t0;
    print "ECOSYSTEM_PHASE|" + name + "|" + str(iterations) + "|" + str(elapsed) + "|" + str(elapsed / iterations);
}

let contract = PERF.evaluate("pblang", BASELINE, CANDIDATE, BUDGETS);
if not contract.ok { throw "ecosystem benchmark performance contract failed"; }
let health = HEALTH.report("pblang", "bench", [PERF.health_check("performance_budget", contract, true)]);
if health.status != "ready" { throw "ecosystem benchmark health contract failed"; }
let app = APP.universal("bench", fn(request) { return request.surface; }, APP_OPTIONS);
if app.cli.value != "cli" or app.web.response.status != 200 or app.gui.widgets != 8 { throw "ecosystem benchmark universal app failed"; }
let polyglot = POLYGLOT.plan("py", "print('ok')", "secure");
if not polyglot.ok or not polyglot.allowed { throw "ecosystem benchmark polyglot policy failed"; }

stage("performance_contract_4_metrics", 1000, fn() { PERF.evaluate("pblang", BASELINE, CANDIDATE, BUDGETS); });
stage("product_health_release_gate", 1000, fn() {
    let report = HEALTH.report("pblang", "bench", [PERF.health_check("performance_budget", contract, true)]);
    HEALTH.release_gate(report, 80);
});
stage("secure_polyglot_plan", 1000, fn() { POLYGLOT.plan("py", "print('ok')", "secure"); });
stage("universal_cli_gui_web_preview", 25, fn() { APP.universal("bench", fn(request) { return request.surface; }, APP_OPTIONS); });
print "ECOSYSTEM_VERTICAL_SUITE|ok";
