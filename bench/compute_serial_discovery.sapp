let CP = import("stdlib:compute.sapp");
let OS = import("stdlib:os.sapp");
let args = OS.script_args();
let mode = if len(args) > 0 { args[0] } else { "threshold" };
let rounds = if len(args) > 1 { parse_number(args[1]) } else { 1000 };
assert(mode == "threshold" or mode == "policy" or mode == "storage_empty", "benchmark mode");
assert(rounds >= 1 and rounds <= 100000 and rounds == num_floor(rounds), "benchmark rounds");
let values = []; let n = 0;
while n < 32 { array_push(values, n); n = n + 1; }
let i = 0; let checksum = 0;
while i < rounds {
    if mode == "threshold" {
        let result = CP.run_controlled(values, fn(x) { return x; }, map{ preferred_device: "cpu", devices: [] });
        assert(result.ok and result.results == values, "threshold result parity");
    } elif mode == "policy" {
        let cfg = CP.policy(map{ max_workers: 1 });
        assert(cfg.max_workers == 1 and cfg.min_parallel_items == 32, "public policy parity");
    } else {
        let result = CP.storage_read_controlled([]);
        assert(result.results == [] and result.workers == 0, "empty storage parity");
    }
    checksum = checksum + 1; i = i + 1;
}
print "COMPUTE_SERIAL|" + mode + "|" + str(rounds) + "|" + str(checksum);
