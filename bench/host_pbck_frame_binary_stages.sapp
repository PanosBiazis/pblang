let Binary = import("stdlib:host_pbck_frame_binary.sapp");
let Plan = import("stdlib:host_pbck_frame_plan.sapp");
let Translate = import("stdlib:selfhost_to_pbck.sapp");

let nested = map{ arity: 1, min_arity: 1,
    chunk: map{ instructions: [map{ op: 16, operand: 0 }, map{ op: 19, operand: 0 }], constants: [] } };
let pbck = Translate.translate(map{
    instructions: [map{ op: 24, operand: 0 }, map{ op: 19, operand: 0 }],
    constants: [nested]
});
let iterations = 100;
let plan = Plan.build_bytes(pbck);
let started = now_ms(); let encoded = nil; let i = 0;
while i < iterations { encoded = Binary.encode_plan(plan); i = i + 1; }
let encode_ms = now_ms() - started;
started = now_ms(); let decoded = nil; i = 0;
while i < iterations { decoded = Binary.decode(encoded); i = i + 1; }
let decode_ms = now_ms() - started;
print json_stringify(map{
    benchmark: "host_pbck_frame_binary_stages", iterations: iterations,
    artifact_bytes: len(pbck), asset_bytes: len(encoded),
    functions: len(decoded.functions), instructions: len(decoded.opcodes),
    encode_total_ms: encode_ms, encode_per_iteration_ms: encode_ms / iterations,
    decode_total_ms: decode_ms, decode_per_iteration_ms: decode_ms / iterations
});
