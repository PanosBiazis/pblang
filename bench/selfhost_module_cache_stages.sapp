// Isolates self-hosted imported-module compilation from main compilation and VM
// execution. The persistent cache remains opt-in and every hit is PBCS-validated.
let FE = import("stdlib/compiler/selfhost_frontend.sapp");
let BENCH = import("stdlib/benchmark.sapp");
let UUID = import("stdlib/uuid.sapp");

let root = "/tmp/pblang_module_cache_bench_" + UUID.v4();
let module_path = root + "_module.sapp";
let cache_root = root + "_cache";
let module_source = "";
let i = 0;
while i < 300 {
    module_source = module_source + "fn f" + str(i) + "(x) { return x + " + str(i) + "; }\n";
    i = i + 1;
}
module_source = module_source + "let VALUE = f299(1); export VALUE;\n";
fs_write(module_path, module_source);
let main = "let m = import(\"" + module_path + "\"); let answer = m.VALUE + 1;";
let base_options = map{ max_source_bytes: 1048576, max_modules: 16, max_steps: 1000000 };
let cache_options = map{
    max_source_bytes: 1048576, max_modules: 16, max_steps: 1000000,
    module_cache: true, module_cache_root: cache_root
};

fn measure(name, options, repetitions, expected_mode) {
    let samples = []; let j = 0;
    while j < repetitions {
        let t0 = now_ms();
        let result = FE.frontend_run_bounded(main, options);
        let elapsed = now_ms() - t0;
        if not result.ok or result.globals.answer != 301 { throw "module cache benchmark correctness failure"; }
        if expected_mode == "miss" and (result.module_cache.misses != 1 or result.module_cache.stores != 1) {
            throw "module cache benchmark expected cold miss: " + str(result.module_cache);
        }
        if expected_mode == "hit" and result.module_cache.hits != 1 { throw "module cache benchmark expected hit"; }
        array_push(samples, elapsed); j = j + 1;
    }
    let stats = BENCH.stats(name, samples);
    print "MODULE_CACHE|" + name + "|" + str(stats.median_ms) + "|" + str(stats.p95_ms) + "|" + str(samples);
    return stats;
}

fn cleanup_cache(path) {
    let entries = try fs_listdir(path) catch [];
    let j = 0; while j < len(entries) { try fs_remove(path_join(path, entries[j])) catch nil; j = j + 1; }
    try fs_remove(path) catch nil;
}

fn measure_cold(repetitions) {
    let samples = []; let j = 0;
    while j < repetitions {
        let one_root = cache_root + "_cold_" + str(j);
        let options = map{
            max_source_bytes: 1048576, max_modules: 16, max_steps: 1000000,
            module_cache: true, module_cache_root: one_root
        };
        let t0 = now_ms();
        let result = FE.frontend_run_bounded(main, options);
        let elapsed = now_ms() - t0;
        if not result.ok or result.globals.answer != 301 or result.module_cache.misses != 1
            or result.module_cache.stores != 1 { throw "module cache benchmark cold failure: " + str(result.module_cache); }
        array_push(samples, elapsed); cleanup_cache(one_root); j = j + 1;
    }
    let stats = BENCH.stats("cache_cold_store", samples);
    print "MODULE_CACHE|cache_cold_store|" + str(stats.median_ms) + "|" + str(stats.p95_ms) + "|" + str(samples);
    return stats;
}

// Warm imported frontend modules before timing. This benchmark targets repeated
// module compilation/deserialization, not the host process's first import.
let warmup = FE.frontend_run_bounded("let answer = 42;", base_options);
if not warmup.ok { throw "module cache benchmark warmup failed"; }

print "MODULE_CACHE_SCHEMA|mode|median_ms|p95_ms|samples_ms";
let uncached = measure("uncached_module_compile", base_options, 11, "none");
let cold = measure_cold(7);
let prime = FE.frontend_run_bounded(main, cache_options);
if not prime.ok or prime.module_cache.stores != 1 { throw "module cache benchmark prime failed"; }
let warm = measure("cache_warm_load", cache_options, 11, "hit");
print "MODULE_CACHE_SPEEDUP|warm_vs_uncached|" + str(uncached.median_ms / warm.median_ms);
print "MODULE_CACHE_COLD_OVERHEAD|cold_vs_uncached|" + str(cold.median_ms / uncached.median_ms);

cleanup_cache(cache_root); try fs_remove(module_path) catch nil;
print "MODULE_CACHE_SUITE|ok";
