// Retain closures simultaneously to measure cells that outlive their creator.
// Run the identical file on both revisions; print only scalar verification.
let F=import("stdlib/compiler/selfhost_frontend.sapp");
let V=import("stdlib/compiler/vm.sapp");
let raw=try env_get("PBLANG_SCRIPT_ARGS") catch "";
let mode=if raw==nil or raw=="" {"single"} else {raw};
assert(mode=="single" or mode=="four","expected single or four captures");
let maker="fn make(n){return fn(){return n;};}";
let expected=[10000,0,9999];
if mode=="four" {
    maker="fn make(n){let a=n+1;let b=n+2;let c=n+3;return fn(){return n+a+b+c;};}";
    expected=[10000,6,40002];
}
let source=maker+"let saved=[];"
    +"for i 10000 {array_push(saved,make(i));}"
    +"print len(saved);print saved[0]();print saved[9999]();";
let c=F.frontend_compile(source);assert(c.ok,"retained capture compilation");
let result=V.run(c.chunk);
assert(result.output==expected,"retained capture parity");
print "retained captures: verified";
