// Correctness-gated hardware routing and execution-overhead benchmark.

let CP = import("stdlib:compute.sapp");

let CPU = [
    map{ kind: "cpu", present: true, usable: true, available: true, units: 8, weight: 8 },
];
let GPU = [
    CPU[0],
    map{ kind: "gpu", present: true, usable: true, available: true, units: 1, weight: 32 },
];

fn stage(name, rounds, body) {
    let checksum = 0;
    let started = now_ms();
    let i = 0;
    while i < rounds { checksum = checksum + body(i); i = i + 1; }
    let elapsed = now_ms() - started;
    if checksum != rounds { throw "hardware routing benchmark checksum failed: " + name; }
    print "HARDWARE_ROUTE_PHASE|" + name + "|" + str(rounds) + "|" + str(elapsed)
        + "|" + str(elapsed / rounds) + "|" + str(checksum);
}

let cheap = CP.policy(map{ preferred_device: "cpu", min_parallel_items: 1, max_workers: 8 });
stage("cheap_cpu_serial", 20000, fn(_i) {
    let route = CP.select_device(128, CPU, cheap);
    return if route.mode == "sequential" and route.workers == 1 { 1 } else { 0 };
});

let heavy = CP.policy(map{
    preferred_device: "cpu", min_parallel_items: 1, max_workers: 8,
    work_units_per_item: 4096,
});
stage("heavy_cpu_parallel", 20000, fn(_i) {
    let route = CP.select_device(128, CPU, heavy);
    return if route.mode == "parallel" and route.workers == 8 { 1 } else { 0 };
});

let tiny_gpu = CP.policy(map{
    preferred_device: "gpu", workload: "tensor", min_accelerator_items: 1,
    work_units_per_item: 1, fallback_to_cpu: true,
});
stage("tiny_gpu_rejected", 20000, fn(_i) {
    let route = CP.select_device(1, GPU, tiny_gpu);
    return if route.device == "cpu" and route.rejected[0].reason == "accelerator_overhead_not_amortized" { 1 } else { 0 };
});

let items = [];
let i = 0;
while i < 128 { array_push(items, i); i = i + 1; }

fn insertion_sort(values) {
    let out = [];
    let i = 0;
    while i < len(values) {
        let value = values[i];
        let j = len(out);
        array_push(out, value);
        while j > 0 and out[j - 1] > value { out[j] = out[j - 1]; j = j - 1; }
        out[j] = value;
        i = i + 1;
    }
    return out;
}

fn measure_execution(name, options) {
    let started = now_ms();
    let result = CP.run_controlled(items, fn(x) { return x + 1; }, options);
    let elapsed = now_ms() - started;
    if not result.ok or len(result.results) != 128 or result.results[0] != 1 or result.results[127] != 128 {
        throw "hardware execution benchmark result mismatch: " + name;
    }
    return elapsed;
}

fn print_execution(name, samples) {
    let sorted = insertion_sort(samples);
    print "HARDWARE_EXECUTION|" + name + "|samples=9|median_ms=" + str(sorted[4])
        + "|p95_ms=" + str(sorted[8]) + "|min_ms=" + str(sorted[0]);
}

let cost_options = map{
    devices: CPU, preferred_device: "cpu", min_parallel_items: 1, max_workers: 8,
};
let forced_options = map{
    devices: CPU, preferred_device: "cpu", min_parallel_items: 1, max_workers: 4,
    work_units_per_item: 4096,
};

// Warm both routes once, then alternate sample order to reduce systematic
// cache/frequency/order bias.
measure_execution("cost_aware_generic_warmup", cost_options);
measure_execution("forced_parallel_warmup", forced_options);
let cost_samples = [];
let forced_samples = [];
let round = 0;
while round < 9 {
    if round % 2 == 0 {
        array_push(cost_samples, measure_execution("cost_aware_generic", cost_options));
        array_push(forced_samples, measure_execution("forced_parallel", forced_options));
    } else {
        array_push(forced_samples, measure_execution("forced_parallel", forced_options));
        array_push(cost_samples, measure_execution("cost_aware_generic", cost_options));
    }
    round = round + 1;
}
print_execution("cost_aware_generic", cost_samples);
print_execution("forced_parallel", forced_samples);

print "HARDWARE_COST_ROUTING_SUITE|ok";
