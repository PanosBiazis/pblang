// Identical source for before/after resource-scope implementations.
// Run with: run bench/resource_scope_callbacks.sapp -- success|mixed
let R=import("stdlib:resource_scope.sapp");
let mode=env_get("PBLANG_SCRIPT_ARGS");
assert(mode=="success" or mode=="mixed","expected success or mixed");
let ok=map{ok:true,value:nil};
let failure=map{ok:false,error:"synthetic"};
fn close_ok(){return ok;}
fn close_error(){return failure;}
fn close_throw(){throw "synthetic";}
fn close_invalid(){return false;}
fn body(scope){
    for i 16 {
        if mode=="success" {scope.defer(close_ok);}
        else {
            let choice=num_mod(i,4);
            if choice==0 {scope.defer(close_ok);}
            elif choice==1 {scope.defer(close_error);}
            elif choice==2 {scope.defer(close_throw);}
            else {scope.defer(close_invalid);}
        }
    }
    return ok;
}
for i 10000 {
    let result=R.with_scope(body);
    assert(result.cleanups_attempted==16 and result.body_status=="returned","lifecycle");
    if mode=="success" {assert(result.ok and len(result.cleanup_errors)==0,"success result");}
    else {assert(not result.ok and len(result.cleanup_errors)==12,"mixed result");}
}
print "resource_scope_benchmark_pass";
