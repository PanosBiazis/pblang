let C=import("stdlib:colors.sapp");
fn scalar(colors){let out=[];for a in colors{let row=[];for b in colors{array_push(row,C.contrast_checked(a,b).ratio);}array_push(out,row);}return out;}
let results=[];
for size in [8,16,32]{let colors=[];for i in range(0,size){array_push(colors,map{r:(i*71)%256,g:(i*131)%256,b:(i*193)%256});}
 assert(scalar(colors)==C.contrast_matrix_checked(colors),"identical matrix");for warm in range(0,2){scalar(colors);C.contrast_matrix_checked(colors);}
 let repeated=[];let batch=[];for sample in range(0,7){let start=clock();let a=scalar(colors);array_push(repeated,(clock()-start)*1000);start=clock();let b=C.contrast_matrix_checked(colors);array_push(batch,(clock()-start)*1000);assert(a==b,"same measured output");}
 array_push(results,map{colors:size,repeated_ms:repeated,batch_ms:batch});
}print json_stringify(results);
