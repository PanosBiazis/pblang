// Trusted Linux benchmark: choose a NEW absolute file in an owned mode-0700
// local directory with PBLANG_CRUD_BENCH_FILE. Never reuse real application data.
// Run with reviewed file/FFI capabilities. Leaves its synthetic file and lock
// for inspection; there is no automatic deletion or overwrite.
let R=import("stdlib:crud_records.sapp");let P=import("stdlib:crud_persistent.sapp");
let path=env_get("PBLANG_CRUD_BENCH_FILE");P.initialize(path,100,65536);let store=P.open(path,100,65536);
let rev=0;for i 25 {store.insert(map{id:i+1,name:"Synthetic row",country:"Example",time:"01:02"},rev);rev=rev+1;}
for i 25 {store.update(map{id:i+1,name:"Updated row",country:"Example",time:"01:01"},rev);rev=rev+1;}
assert(store.list().matched==25,"same records");store.clear(rev,"DELETE ALL");assert(store.info().revision==51,"same revision");store.close();
