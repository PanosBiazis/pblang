// Only import an operator-reviewed baseline copy, never untrusted input.
// Two warmup pairs, twelve retained AB/BA pairs; correctness outside timing.
// Isolated stages are diagnostics, NOT additive parts of the full analyzer.
let OLD=import(env_get("PB_TAINT_REFERENCE"));
let NEW=import("stdlib:security_taint.sapp");
let TOK=import("stdlib:compiler/tokenizer.sapp");
let PAR=import("stdlib:compiler/parser.sapp");
let B=import("stdlib:benchmark.sapp");
let source="fn save(path) {fs_write(path,\"fixed\");}\nlet requested=env_get(\"INPUT\");save(requested);";
fn measure(work,rounds) {
    let start=now_ms();let result=nil;
    for iteration rounds {result=work();}
    return map{elapsed:now_ms()-start,result:result};
}
let options=map{max_taint_tokens:65536,max_taint_source_bytes:1048576,
    max_taint_findings:256,max_taint_steps:200000,max_call_expansions:20000};
let cases=[
    map{name:"limits-default",rounds:2000,a:fn(){return OLD.limits();},b:fn(){return NEW.limits();}},
    map{name:"limits-explicit",rounds:2000,a:fn(){return OLD.limits(options);},b:fn(){return NEW.limits(options);}},
    map{name:"analyze-full",rounds:100,a:fn(){return OLD.analyze(source,"fixture.sapp");},b:fn(){return NEW.analyze(source,"fixture.sapp");}}
];
let control=NEW.analyze(source,"fixture.sapp");
if not control.ok or control.passed or control.finding_count!=1 or not control.interprocedural_complete {
    throw "taint pair: semantic control";
}
for item in cases {
    let expected=json_stringify(item.a());let before=[];let after=[];let ratios=[];
    for iteration 14 {
        let a=nil;let b=nil;
        if num_mod(iteration,2)==0 {a=measure(item.a,item.rounds);b=measure(item.b,item.rounds);}
        else {b=measure(item.b,item.rounds);a=measure(item.a,item.rounds);}
        if json_stringify(a.result)!=expected or json_stringify(b.result)!=expected {throw "taint pair: result mismatch";}
        if a.elapsed<=0 or b.elapsed<=0 {throw "taint pair: insufficient clock resolution";}
        if iteration>=2 {push(before,a.elapsed);push(after,b.elapsed);push(ratios,b.elapsed/a.elapsed);}
    }
    print json_stringify(map{operation:item.name,rounds:item.rounds,before_ms:before,after_ms:after,
        before_stats:B.stats(item.name,before),after_stats:B.stats(item.name,after),
        paired_ratios:ratios,ratio_stats:B.stats("candidate/reference",ratios)});
}
let tokens=TOK.tokenize_bounded(source,65536);
if not tokens.ok {throw "taint stages: lexer control";}
let parsed=PAR.parse(tokens.tokens);
if len(parsed.errors)!=0 {throw "taint stages: parser control";}
for item in [
    map{name:"tokenize-isolated",work:fn(){return TOK.tokenize_bounded(source,65536);}},
    map{name:"parse-isolated",work:fn(){return PAR.parse(tokens.tokens);}}
] {
    let expected=json_stringify(item.work());let samples=[];
    for iteration 14 {
        let result=measure(item.work,100);
        if json_stringify(result.result)!=expected {throw "taint stages: result mismatch";}
        if iteration>=2 {push(samples,result.elapsed);}
    }
    print json_stringify(map{operation:item.name,rounds:100,samples_ms:samples,stats:B.stats(item.name,samples)});
}
