let Guard = import("stdlib:transport_security.sapp");

let identity = Guard.signal_fingerprint("peer-address", "benchmark-peer");
let monitor = Guard.new(map{ expected_identity: identity, max_nonces: 64 });
let iterations = 1000; let i = 0; let started = now_ms(); let accepted = 0;
while i < iterations {
    let result = Guard.observe(monitor, map{ transport: "unknown",
        purpose: "connectivity", protocol: "pbremote-e2e",
        application_authenticated: true, identity_fingerprint: identity,
        sequence: i, nonce: "benchmark-transport-nonce-" + str(i) });
    if result.ok { accepted = accepted + 1; }
    i = i + 1;
}
let elapsed = now_ms() - started; if elapsed <= 0 { elapsed = 0.001; }
print "SCHEMA|phase|iterations|total_ms|us_per_observation|accepted|status";
print "TRANSPORT_SECURITY_PHASE|authenticated_observation|" + str(iterations)
    + "|" + str(elapsed) + "|" + str((elapsed * 1000) / iterations)
    + "|" + str(accepted) + "|" + if accepted == iterations { "ok" } else { "failed" };
