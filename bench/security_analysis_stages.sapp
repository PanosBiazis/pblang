let PATTERN = import("stdlib:security_analysis.sapp");
let TAINT = import("stdlib:security_taint.sapp");
let DEP = import("stdlib:security_dependency_analysis.sapp");

fn sorted(values) {
    let out = []; let used = map{};
    while len(out) < len(values) {
        let best = 0 - 1; let i = 0;
        while i < len(values) {
            if not (try used[str(i)] catch false)
                and (best < 0 or values[i] < values[best]) { best = i; }
            i = i + 1;
        }
        used[str(best)] = true; array_push(out, values[best]);
    }
    return out;
}

fn stats(values) {
    let rows = sorted(values); let n = len(rows);
    let p95 = num_floor((n - 1) * 0.95);
    return map{ samples: n, median_ms: rows[num_floor(n / 2)], p95_ms: rows[p95],
        min_ms: rows[0], max_ms: rows[n - 1] };
}

fn measure(rounds, operation) {
    let values = []; let i = 0;
    operation();
    while i < rounds {
        let start = now_ms(); operation(); array_push(values, now_ms() - start); i = i + 1;
    }
    return stats(values);
}

let root = "tests/fixtures/_security_bench_" + str_slice(sha256(str(now_ms()) + str(random_bytes(12))), 0, 18);
let entry = root + "/main.sapp"; let dependency = root + "/dep.sapp";
let source = "let D = import(\"dep.sapp\");\nlet path = env_get(\"OUTPUT\");\nD.save(path);";
fs_mkdirs(root); fs_write(entry, source);
fs_write(dependency, "fn save(path) { fs_write(path, \"value\"); }\nexport save;");

fn pattern_operation() { PATTERN.analyze(source, entry, map{ minimum_blocking_severity: "high" }); }
fn semantic_operation() { TAINT.analyze(source, entry); }
fn dependency_operation() { DEP.analyze_entry(entry, map{ project_root: root,
    entry_source: source, security_mode: "protect" }); }

let result = map{ format: "pblang.security-analysis-benchmark.v1", rounds: 25,
    entry_bytes: len(str_to_bytes(source)), dependency_modules: 2,
    pattern: measure(25, pattern_operation), semantic: measure(25, semantic_operation),
    dependency_whole_program: measure(25, dependency_operation) };
print json_stringify(result);

try fs_remove(entry) catch nil; try fs_remove(dependency) catch nil; try fs_remove(root) catch nil;
