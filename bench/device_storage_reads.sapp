// Read-only, warm-cache scheduling comparison. The caller supplies eight
// synthetic 64 KiB files (0.txt .. 7.txt), each containing only ASCII x.
// This is not a physical disk throughput or endurance benchmark.
let CP = import("stdlib:compute.sapp");
let OS = import("stdlib:os.sapp");
let args = OS.script_args();
assert(len(args) == 2, "usage: fixture-directory sequential|parallel");
let mode = args[1];
assert(mode == "sequential" or mode == "parallel", "invalid mode");
let paths = [];
let i = 0;
while i < 8 { array_push(paths, path_join(args[0], str(i) + ".txt")); i = i + 1; }
let options = map{ max_workers: 4, min_parallel_files: if mode == "parallel" { 1 } else { 9 } };
let samples = [];
let expected = "x";
while len(expected) < 65536 { expected = expected + expected; }
let round = 0;
while round < 7 {
    let start = now_ms();
    let result = CP.storage_read_controlled(paths, options);
    let elapsed = now_ms() - start;
    assert(result.mode == mode and len(result.results) == 8, "storage route and count");
    i = 0;
    while i < 8 {
        let value = result.results[i];
        assert(value == expected, "fixture contents");
        i = i + 1;
    }
    if round > 0 { array_push(samples, elapsed); }
    round = round + 1;
}
print json_stringify(map{ mode: mode, bytes_per_batch: 524288, warmups: 1, samples_ms: samples });
