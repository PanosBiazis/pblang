let Old=import("./fixtures/signal_before_lifecycle.sapp");let S=import("stdlib:signal.sapp");
fn elapsed(call,s,calls){let start=clock();for _i calls {call(s);}return (clock()-start)*1000/calls;}
let results=[];
for n in [0,8,128,1024] {
 let old=Old.new();let current=S.new();
 for _i n {Old.subscribe(old,fn(v){return v;});S.subscribe(current,fn(v){return v;});}
 for op in [map{name:"count",before:Old.count,after:S.count,calls:100},
            map{name:"emit",before:fn(s){return Old.emit(s,1);},after:fn(s){return S.emit(s,1);},calls:3}] {
  assert(op.before(old)==op.after(current),"value parity");
  for _warmup 2 {op.before(old);op.after(current);}
  let before=[];let after=[];
  for sample 7 {
   if sample%2==0 {push(before,elapsed(op.before,old,op.calls));push(after,elapsed(op.after,current,op.calls));}
   else {push(after,elapsed(op.after,current,op.calls));push(before,elapsed(op.before,old,op.calls));}
  }
  push(results,map{operation:op.name,size:n,before_ms:before,after_ms:after});
 }
}
print json_stringify(map{samples:7,warmups:2,results:results});
