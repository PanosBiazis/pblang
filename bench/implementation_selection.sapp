// Stable-registry comparison. Set PBLANG_SELECTION_BENCH_MODE=open|bound|direct.
// No I/O in the timed workload. The process harness measures whole-run costs.
let Switch = import("stdlib:implementation_switch.sapp");
let mode = env_get("PBLANG_SELECTION_BENCH_MODE");
let constructor = fn() { return 42; };
let choices = map{pblang:constructor, polyglot:fn() { throw "inactive"; }};
let selected = constructor;
if mode == "bound" { selected = Switch.bind(true,"pblang",choices); }
if mode != "open" and mode != "bound" and mode != "direct" { throw "invalid benchmark mode"; }
let total = 0; let i = 0;
if mode == "open" {
    while i < 10000 { total = total + Switch.open(true,"pblang",choices); i = i + 1; }
} else {
    while i < 10000 { total = total + selected(); i = i + 1; }
}
if total != 420000 { throw "implementation benchmark parity failed"; }
print total;
