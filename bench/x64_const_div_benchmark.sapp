// Reproducible measurement for the direct x86-64 constant division/remainder lowering.
// Requires --allow-all because the shared harness executes bounded compiler/artifact argv.
let R = import("stdlib:repro_benchmark.sapp");

fn value(summary, field) {
    if summary == nil { return "-"; }
    let v = try summary[field] catch nil;
    return if v == nil { "-" } else { str(v) };
}

let env = R.environment();
print "X64_CONST_DIV_ENV|kernel=" + env.kernel + "|cpu=" + env.cpu_model
    + "|logical_cpus=" + str(env.logical_cpus) + "|pblang=" + env.pblang
    + "|kernel_items=" + str(env.kernel_items);
print "X64_CONST_DIV_SCHEMA|language|status|compile_cold_ms|compile_median_ms|compile_p95_ms|run_cold_ms|run_median_ms|run_p95_ms|rss_median_kib|artifact_bytes|checksum|samples_ms";

let languages = ["pblang-codegen-x64", "c", "cpp", "rust", "go"];
let failed = 0; let i = 0;
while i < len(languages) {
    let row = R.benchmark_language(languages[i], "integer_kernel", 5, 19, 45);
    if row.status == "ok" {
        print "X64_CONST_DIV_ROW|" + row.language + "|ok|" + str(row.compile_cold_ms)
            + "|" + value(row.compile_warm, "median_ms") + "|" + value(row.compile_warm, "p95_ms")
            + "|" + str(row.run_cold_ms) + "|" + value(row.run_warm, "median_ms")
            + "|" + value(row.run_warm, "p95_ms") + "|" + value(row.rss_warm, "median_ms")
            + "|" + str(row.artifact_size_bytes) + "|" + row.checksum + "|" + str(row.run_samples_ms);
    } else {
        print "X64_CONST_DIV_ROW|" + languages[i] + "|" + row.status + "|-|-|-|-|-|-|-|-|-|[]";
        if row.status != "unavailable" { failed = failed + 1; }
    }
    i = i + 1;
}
if failed > 0 { throw "x64 constant-division benchmark contains failed rows"; }
print "X64_CONST_DIV_SUITE|ok";
