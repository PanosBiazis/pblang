let Store = import("stdlib:llm_tiered_store.sapp");

fn digest(bytes) { return sha256(base64_encode_bytes(bytes)); }
fn payload(seed, size) {
    let out = [];
    let i = 0;
    while i < size { array_push(out, num_mod(seed + i * 17, 256)); i = i + 1; }
    return out;
}
fn percentile(sorted, fraction) {
    if len(sorted) == 0 { return 0; }
    let index = num_floor((len(sorted) - 1) * fraction);
    return sorted[index];
}
fn sorted_copy(values) {
    let out = [];
    let i = 0; while i < len(values) { array_push(out, values[i]); i = i + 1; }
    i = 1;
    while i < len(out) {
        let value = out[i]; let j = i - 1;
        while j >= 0 and out[j] > value { out[j + 1] = out[j]; j = j - 1; }
        out[j + 1] = value; i = i + 1;
    }
    return out;
}

let root = "/tmp/pblang-tiered-bench";
try proc_spawn_wait("/bin/rm", ["-rf", "--", root]) catch nil;
fs_mkdirs(root);
let shards = [];
let i = 0;
while i < 32 {
    let bytes = payload(i, 16384);
    let name = "expert-" + str(i) + ".bin";
    fs_write_bytes(root + "/" + name, bytes);
    array_push(shards, Store.model_part("expert-0-" + str(i), name, len(bytes),
        digest(bytes), "expert", 0, i, "int4"));
    i = i + 1;
}

let cold = [];
let warm = [];
let sample = 0;
while sample < 7 {
    let runtime = Store.create(root, shards, Store.config(262144, map{
        expected_precision: "int4", prefetch_capacity: 4, hot_slots: 4
    }));
    let started = now_ms();
    i = 0;
    while i < 16 { Store.load(runtime, "expert-0-" + str(i)); i = i + 1; }
    array_push(cold, now_ms() - started);

    started = now_ms();
    i = 0;
    while i < 16 { Store.load(runtime, "expert-0-" + str(i)); i = i + 1; }
    array_push(warm, now_ms() - started);
    Store.close(runtime);
    sample = sample + 1;
}
let c = sorted_copy(cold);
let w = sorted_copy(warm);
print json_stringify(map{
    format: "pblang.benchmark.llm_tiered_store.v1",
    samples: 7,
    workload: "16 verified 16KiB expert shards",
    cold_ms: map{ median: percentile(c, 0.5), p95: percentile(c, 0.95), raw: cold },
    warm_ms: map{ median: percentile(w, 0.5), p95: percentile(w, 0.95), raw: warm }
});
try proc_spawn_wait("/bin/rm", ["-rf", "--", root]) catch nil;
