// PBLang VM scalar scope reclamation. No comparison with native host timings.
let F = import("stdlib:compiler/selfhost_frontend.sapp");
let VM = import("stdlib:compiler/vm.sapp");
let chunk = F.frontend_compile("let i=0; let checksum=0; while i<2000 { push_lifetime(); let h=memory_alloc(i); let b=borrow_immutable(h); checksum=checksum+memory_get(h); pop_lifetime(); i=i+1; } print checksum; print memory_stats().total_locations; print memory_stats().active_borrows; print memory_stats().allocations; print memory_stats().reclaimed; print memory_stats().peak_locations;").chunk;
fn checked_run() {
    let r = VM.run(chunk);
    if r.output != [1999000, 0, 0, 2000, 2000, 1] { throw "selfhost memory benchmark mismatch"; }
}
checked_run();
let start = now_ms();
checked_run();
print "SELFHOST_MEMORY|2000|" + str(now_ms() - start) + "|live=0|borrows=0|reclaimed=2000|peak=1|ok";
