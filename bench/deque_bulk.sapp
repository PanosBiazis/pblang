let Old=import("./fixtures/deque_before_bulk.sapp");let D=import("stdlib:deque.sapp");
fn elapsed(call,a){let start=clock();call(a);return (clock()-start)*1000;}
let ops=[
 map{name:"from_array",before:Old.from_array,after:D.from_array},
 map{name:"extend_back",before:fn(a){let q=Old.from_array([-1]);for v in a {Old.push_back(q,v);}return q;},after:fn(a){let q=D.from_array([-1]);D.extend_back(q,a);return q;}},
 map{name:"extend_front",before:fn(a){let q=Old.from_array([-1]);let i=len(a);while i>0 {i=i-1;Old.push_front(q,a[i]);}return q;},after:fn(a){let q=D.from_array([-1]);D.extend_front(q,a);return q;}},
 map{name:"push_pop_back",before:fn(a){let q=Old.new();for v in a {Old.push_back(q,v);}for _v in a {Old.pop_back(q);}return q;},after:fn(a){let q=D.new();for v in a {D.push_back(q,v);}for _v in a {D.pop_back(q);}return q;}},
 map{name:"push_pop_front",before:fn(a){let q=Old.new();for v in a {Old.push_front(q,v);}for _v in a {Old.pop_front(q);}return q;},after:fn(a){let q=D.new();for v in a {D.push_front(q,v);}for _v in a {D.pop_front(q);}return q;}}
];
let results=[];
for n in [0,8,128,1024] {
 let a=[];for i n {push(a,i);}
 for op in ops {
  assert(Old.to_array(op.before(a))==D.to_array(op.after(a)),"full final value parity");
  for _warmup 2 {op.before(a);op.after(a);}
  let before=[];let after=[];
  for sample 7 {
   if sample%2==0 {push(before,elapsed(op.before,a));push(after,elapsed(op.after,a));}
   else {push(after,elapsed(op.after,a));push(before,elapsed(op.before,a));}
  }
  push(results,map{operation:op.name,size:n,before_ms:before,after_ms:after});
 }
}
print json_stringify(map{samples:7,warmups:2,calls_per_sample:1,results:results});
