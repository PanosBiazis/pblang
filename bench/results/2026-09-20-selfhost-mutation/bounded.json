  "workload_source": "// Identical successful mutations before/after bounded growth admission.\n// Call run(false) for ordinary execution, or run(true) for explicit limits.\nlet F=import(\"stdlib:compiler/selfhost_frontend.sapp\");\nlet V=import(\"stdlib:compiler/vm.sapp\");\nfn run(bounded) {\n    let compiled=F.frontend_compile(\"let a=[0,0];let m=map{a:0,b:0};for i 10000 {a[0]=i;m.a=i;m[\\\"b\\\"]=i;}print a[0]+m.a+m.b;\");\n    if not compiled.ok { throw \"mutation control did not compile\"; }\n    for repeat 4 {\n        let result=if bounded {\n            V.run_bounded(compiled.chunk,map{max_value_items:8,max_steps:2000000})\n        } else { V.run(compiled.chunk) };\n        if result.output!=[29997] { throw \"mutation control result changed\"; }\n    }\n    print \"selfhost_mutation_control_pass\";\n}\nexport run;\n",
