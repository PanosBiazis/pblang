  "workload_source": "// Unchanged builtin workload used before/after UTF-8 dispatch registration.\n// Compile once and run repeatedly; no file, device, network or GUI work.\nlet F=import(\"stdlib:compiler/selfhost_frontend.sapp\");\nlet V=import(\"stdlib:compiler/vm.sapp\");\nlet compiled=F.frontend_compile(\"fn work(n){let a=[1,2,3];let total=0;for i n {total=total+len(a)+bit_shr(i,1);}print total;} work(10000);\");\nif not compiled.ok { throw \"control workload did not compile\"; }\nfor repeat 4 {\n    let result=V.run(compiled.chunk);\n    if result.output!=[25025000] { throw \"control workload result changed\"; }\n}\nprint \"selfhost_utf8_control_pass\";\n",
