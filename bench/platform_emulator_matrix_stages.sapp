// Pure-pblang benchmark for profile resolution and bounded virtual execution.
let P = import("stdlib:platform_emulator.sapp");

let TARGETS = [
    ["linux", "6.8", "x86_64"], ["linux", "6.8", "riscv64"],
    ["windows", "11", "x86_64"], ["windows", "11", "arm64"],
    ["macos", "14", "arm64"], ["macos", "13", "x86_64"],
    ["android", "34", "arm64"], ["android", "34", "x86_64"],
    ["ios", "17", "arm64"], ["ios", "17", "arm64-simulator"],
    ["freebsd", "14", "riscv64"], ["openbsd", "7.5", "arm64"],
    ["netbsd", "10", "x86"], ["solaris", "11.4", "x86_64"], ["haiku", "1", "x86_64"],
    ["wasi", "1", "wasm32"],
    ["dos", "6.22", "x86"], ["cpm", "2.2", "z80"],
    ["amigaos", "3.1", "m68k"], ["os2", "2", "x86"],
    ["plan9", "4", "x86_64"], ["qnx", "7", "arm64"],
    ["freertos", "11", "avr"], ["zephyr", "3.7", "riscv32"],
    ["nuttx", "12", "armv7"], ["vxworks", "7", "sparc-v8"],
    ["baremetal", "1", "6502"], ["aix", "7.3", "powerpc64"],
    ["hpux", "11.31", "ia64"], ["irix", "6.5", "mips32"],
    ["chromeos", "120", "arm64"], ["fuchsia", "1", "x86_64"]
];

fn emit(name, iterations, work, thunk) {
    let t0 = now_ms(); let checksum = 0; let i = 0;
    while i < iterations { checksum = checksum + thunk(); i = i + 1; }
    let elapsed = now_ms() - t0;
    if elapsed <= 0 { elapsed = 0.001; }
    print "PLATFORM_PHASE|" + name + "|" + str(iterations) + "|" + str(elapsed)
        + "|" + str(iterations * work * 1000 / elapsed) + "|" + str(checksum) + "|ok";
}

fn profile_round() {
    let bits = 0; let i = 0;
    while i < len(TARGETS) {
        let p = P.resolve(TARGETS[i][0], TARGETS[i][1], TARGETS[i][2]);
        if not p.ok { throw "profile matrix resolution failed"; }
        bits = bits + p.pointer_bits; i = i + 1;
    }
    return bits;
}

let linux = P.resolve("linux", "6.8", "x86_64");
fn path_round() {
    let checksum = 0; let i = 0;
    while i < 64 {
        let p = P.normalize_path(linux, "/work/src/./module/../file" + str(i) + ".sapp");
        if not p.ok { throw "path benchmark mismatch"; }
        checksum = checksum + len(p.path); i = i + 1;
    }
    return checksum;
}

fn memory_round() {
    let m = P.machine(linux, map{ memory_bytes: 4096, max_output_bytes: 4096 });
    let block = []; let i = 0; while i < 64 { array_push(block, i); i = i + 1; }
    i = 0; while i < 32 { if not P.memory_write(m, i * 64, block).ok { throw "memory benchmark write"; } i = i + 1; }
    let r = P.memory_read(m, 31 * 64, 64); if not r.ok or r.bytes[63] != 63 { throw "memory benchmark read"; }
    return r.bytes[63];
}

fn memory_create(layout) {
    let m = P.machine(linux, map{ memory_bytes: 1048576, memory_layout: layout });
    if not P.memory_write(m, 1048572, [1, 2, 3, 4]).ok { throw "memory creation benchmark write"; }
    if P.memory_read(m, 1048572, 4).bytes[3] != 4 { throw "memory creation benchmark read"; }
    return P.memory_stats(m).resident_cells;
}

fn syscall_round() {
    let m = P.machine(linux, map{ memory_bytes: 1024, max_output_bytes: 8192 });
    let i = 0;
    while i < 100 {
        if not P.syscall(m, "setenv", map{ key: "K" + str(i), value: str(i) }).ok { throw "setenv benchmark"; }
        if not P.syscall(m, "write_file", map{ path: "/tmp/f" + str(i), data: "payload" }).ok { throw "file benchmark"; }
        if P.syscall(m, "read_file", map{ path: "/tmp/f" + str(i) }).data != "payload" { throw "read benchmark"; }
        P.syscall(m, "random_u32"); i = i + 1;
    }
    return m.syscall_count;
}

if profile_round() != 1616 { throw "profile checksum mismatch"; }
print "SCHEMA|phase|iterations|total_ms|work_units_per_s|checksum|status";
emit("resolve_32_targets", 1000, len(TARGETS), profile_round);
emit("normalize_64_paths", 100, 64, path_round);
emit("bounded_memory_2k", 100, 2048, memory_round);
emit("create_contiguous_memory_1m", 5, 1048576, fn() { return memory_create("contiguous"); });
emit("create_sparse_memory_1m", 100, 4, fn() { return memory_create("sparse"); });
emit("portable_syscall_400", 100, 400, syscall_round);
print "PLATFORM_EMULATOR_MATRIX_SUITE|ok";
