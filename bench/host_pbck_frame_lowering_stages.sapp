let Plan = import("stdlib:host_pbck_frame_plan.sapp");
let Calls = import("stdlib:host_pbck_frame_calls.sapp");
let Lowering = import("stdlib:host_pbck_frame_lowering.sapp");
let Benchmark = import("stdlib:benchmark.sapp");

let leaf = map{
    __pbck_function: true, name: "leaf", arity: 0, min_arity: 0,
    defaults: [], is_vararg: false, parameter_types: [],
    chunk: map{ instructions: [map{ op: 28, operand: 0 }, map{ op: 33 }], constants: [] }
};
let middle = map{
    __pbck_function: true, name: "middle", arity: 0, min_arity: 0,
    defaults: [], is_vararg: false, parameter_types: [],
    chunk: map{ instructions: [
        map{ op: 27, fn_const: 0, captures: [map{ is_local: false, index: 0 }] },
        map{ op: 31, operand: 0 }, map{ op: 33 }
    ], constants: [leaf] }
};
let artifact = map{
    format: "host-pbck-v1", version: 1,
    chunk: map{ instructions: [
        map{ op: 0, operand: 0 }, map{ op: 26, operand: 0 },
        map{ op: 27, fn_const: 1, captures: [map{ is_local: true, index: 0 }] },
        map{ op: 31, operand: 0 }, map{ op: 33 }
    ], constants: [73, middle] }
};
let plan = Plan.build_decoded(artifact);
let verified = Calls.verify_i32(plan, 0, [], map{ max_steps: 100 });
let image = Lowering.build(verified);
if Lowering.validate(image).expected_value != 73 { throw "lowering benchmark gate failed"; }

let SAMPLES = 9; let BUILD_ITERATIONS = 100; let VALIDATE_ITERATIONS = 1000;
let build_samples = []; let validate_samples = []; let sample = 0;
while sample < SAMPLES {
    let started = now_ms(); let i = 0; let check = 0;
    while i < BUILD_ITERATIONS {
        check = check + Lowering.build(verified).checksum; i = i + 1;
    }
    if check != BUILD_ITERATIONS * image.checksum { throw "build checksum mismatch"; }
    array_push(build_samples, now_ms() - started);
    started = now_ms(); i = 0; check = 0;
    while i < VALIDATE_ITERATIONS {
        check = check + Lowering.validate(image).checksum; i = i + 1;
    }
    if check != VALIDATE_ITERATIONS * image.checksum { throw "validate checksum mismatch"; }
    array_push(validate_samples, now_ms() - started);
    sample = sample + 1;
}
let build_stats = Benchmark.stats("build", build_samples);
let validate_stats = Benchmark.stats("validate", validate_samples);
print "HOST_PBCK_FRAME_LOWERING|stage=build|functions=" + str(image.function_count)
    + "|instructions=" + str(image.instruction_count) + "|iterations="
    + str(BUILD_ITERATIONS) + "|samples=" + str(SAMPLES) + "|median_ms="
    + str(build_stats.median_ms) + "|p95_ms=" + str(build_stats.p95_ms)
    + "|median_per_image_ms=" + str(build_stats.median_ms / BUILD_ITERATIONS);
print "HOST_PBCK_FRAME_LOWERING|stage=validate|functions=" + str(image.function_count)
    + "|instructions=" + str(image.instruction_count) + "|iterations="
    + str(VALIDATE_ITERATIONS) + "|samples=" + str(SAMPLES) + "|median_ms="
    + str(validate_stats.median_ms) + "|p95_ms=" + str(validate_stats.p95_ms)
    + "|median_per_image_ms=" + str(validate_stats.median_ms / VALIDATE_ITERATIONS);
