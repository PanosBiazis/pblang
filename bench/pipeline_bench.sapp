// bench/pipeline_bench.sapp — Pure-PBLang Self-Hosted Pipeline Stage Benchmark
//
// Replaces bench/pipeline_bench.sh. Runs bench/pipeline_stages.sapp and times native
// execution of the emitted `/tmp/pipe_bin` ELF64 binary.

fn _find_pb(root: string) {
    let env_b = env_get("PB");
    if env_b != nil and env_b != "" and fs_exists(env_b) { return env_b; }
    if fs_exists(root + "/pblang") { return root + "/pblang"; }
    if fs_exists(root + "/target/release/pblang") { return root + "/target/release/pblang"; }
    return "pblang";
}

fn _pad_right(s: string, w: int) {
    let out = s;
    while len(out) < w { out = out + " "; }
    return out;
}

fn _extract_kv(text: string, prefix: string) {
    let lines = str_split(str_replace_all(text, "\r\n", "\n"), "\n");
    let i = 0;
    while i < len(lines) {
        if str_starts_with(lines[i], prefix) {
            return str_slice(lines[i], len(prefix), len(lines[i]));
        }
        i = i + 1;
    }
    return "-";
}

let root = cwd();
let pb = _find_pb(root);

println("=== pblang self-hosted pipeline — per-stage timing (workload: fib(20)) ===");
let res = proc_spawn_wait(pb, ["run", "bench/pipeline_stages.sapp", "--allow-all"]);
let out = str(res.stdout);

let tok = _extract_kv(out, "TOK_ms=");
let prs = _extract_kv(out, "PARSE_ms=");
let interp = _extract_kv(out, "INTERP_total_ms=");
let cg = _extract_kv(out, "CODEGEN_ms=");
let sz = _extract_kv(out, "SIZE_bytes=");

let nat = "-";
if fs_exists("/tmp/pipe_bin") {
    try proc_spawn_wait("chmod", ["755", "/tmp/pipe_bin"]) catch nil;
    let best = 99999;
    let k = 0;
    while k < 5 {
        let t0 = now_ms();
        let _ = proc_spawn_wait("/tmp/pipe_bin", []);
        let d = num_floor(now_ms() - t0);
        if d < best { best = d; }
        k = k + 1;
    }
    nat = str(best);
    try fs_remove("/tmp/pipe_bin") catch nil;
}

println(_pad_right("stage", 38) + " " + "time_ms");
println(_pad_right("-------------------------------------", 38) + " " + "-------");
println(_pad_right("1. tokenize (source -> tokens)", 38) + " " + tok);
println(_pad_right("2. parse (tokens -> AST)", 38) + " " + prs);
println(_pad_right("3a. interpret (pblang tree-walker)", 38) + " " + interp);
println(_pad_right("3b. codegen (AST -> x86-64 bytes)", 38) + " " + cg);
println(_pad_right("3b. native execute (run machine code)", 38) + " " + nat);
println(_pad_right("codegen output size (bytes)", 38) + " " + sz);
println("");
println("Front end (tokenize+parse) is ~sub-ms; the tree-walking interpreter is the slow");
println("path, so compiling remains the speed route. Run this script repeatedly and compare");
println("medians: sub-millisecond stages and process startup are especially noise-sensitive.");
