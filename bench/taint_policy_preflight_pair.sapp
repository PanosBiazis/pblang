// Import only an operator-reviewed reference of the prior dependency module.
// Use identical current supporting modules; never import an untrusted baseline.
let OLD=import(env_get("PB_DEPENDENCY_REFERENCE"));
let NEW=import("stdlib:security_dependency_analysis.sapp");
let B=import("stdlib:benchmark.sapp");
let indexes=[];for i 32 {push(indexes,255);}
let sinks=map{};for i 128 {sinks["sink"+str(i)]=map{severity:"high",class:str_repeat("α",128),args:indexes};}
let boundary=map{taint_sources:[],taint_sanitizers:[],taint_sinks:sinks};
let custom=map{taint_sources:["env_get"],taint_sanitizers:[],taint_sinks:map{
    fs_write:map{severity:"high",class:"fixture",args:[0]}}};
fn measure(module,options,rounds) {
    let start=now_ms();let result=nil;
    for i rounds {result=module.analyze_entry("preflight-benchmark.sapp",options);}
    return map{elapsed:now_ms()-start,result:result};
}
for item in [map{name:"default-small",source:"let value=1;",policy:nil,rounds:50},
    map{name:"custom-flow",source:"fs_write(env_get(\"INPUT\"),\"fixed\");",policy:custom,rounds:50},
    map{name:"custom-boundary",source:"",policy:boundary,rounds:3}] {
    let options=map{entry_source:item.source,security:item.policy};
    let reference=OLD.analyze_entry("preflight-benchmark.sapp",options);
    if not reference.ok or not reference.semantic_complete or reference.module_count!=1 {throw "preflight benchmark control";}
    if item.name=="custom-flow" and (reference.passed or reference.finding_count!=2) {throw "preflight benchmark flow control";}
    let expected=json_stringify(reference);let before=[];let after=[];let ratios=[];
    for iteration 14 {
        let a=nil;let b=nil;
        if num_mod(iteration,2)==0 {a=measure(OLD,options,item.rounds);b=measure(NEW,options,item.rounds);}
        else {b=measure(NEW,options,item.rounds);a=measure(OLD,options,item.rounds);}
        if json_stringify(a.result)!=expected or json_stringify(b.result)!=expected {throw "preflight benchmark report mismatch";}
        if a.elapsed<=0 or b.elapsed<=0 {throw "preflight benchmark clock resolution";}
        if iteration>=2 {push(before,a.elapsed);push(after,b.elapsed);push(ratios,b.elapsed/a.elapsed);}
    }
    print json_stringify(map{operation:item.name,rounds:item.rounds,before_ms:before,after_ms:after,paired_ratios:ratios,
        before_stats:B.stats(item.name,before),after_stats:B.stats(item.name,after),ratio_stats:B.stats("ratio",ratios)});
}
