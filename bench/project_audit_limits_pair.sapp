// The reference must be an operator-reviewed prior module, never untrusted code.
let OLD=import(env_get("PB_PROJECT_AUDIT_REFERENCE"));
let NEW=import("stdlib:project_audit.sapp");
let B=import("stdlib:benchmark.sapp");
let clean="let value=1;";
let marked="// slow path\n// TODO implement renderer\n";
let records=[map{path:"module.sapp",text:marked},map{path:"other.sapp",text:clean}];
fn analyze(module,kind) {
    if kind=="text-clean" {return module.scan_text_report("module.sapp",clean);}
    if kind=="text-markers" {return module.scan_text_report("module.sapp",marked);}
    if kind=="text-cap-one" {return module.scan_text_report("module.sapp",marked,1);}
    return module.scan_records(records);
}
fn measure(module,kind) {
    let start=now_ms();let result=nil;
    for i 100 {result=analyze(module,kind);}
    return map{elapsed:now_ms()-start,result:result};
}
for kind in ["text-clean","text-markers","text-cap-one","records"] {
    let expected=json_stringify(analyze(OLD,kind));let before=[];let after=[];let ratios=[];
    for i 14 {
        let a=nil;let b=nil;
        if i%2==0 {a=measure(OLD,kind);b=measure(NEW,kind);}
        else {b=measure(NEW,kind);a=measure(OLD,kind);}
        if json_stringify(a.result)!=expected or json_stringify(b.result)!=expected
            or a.elapsed<=0 or b.elapsed<=0 {throw "project audit benchmark report/clock mismatch";}
        if i>=2 {push(before,a.elapsed);push(after,b.elapsed);push(ratios,b.elapsed/a.elapsed);}
    }
    print json_stringify(map{operation:kind,rounds:100,before_ms:before,after_ms:after,paired_ratios:ratios,
        before_stats:B.stats("before",before),after_stats:B.stats("after",after),ratio_stats:B.stats("ratio",ratios)});
}
