// Correctness-gated benchmark for the parser and full self-hosted front end.
// The first full parse includes cold module loading; later samples isolate the
// warm tokenizer/parser path used by long-lived tools such as pbide and the LSP.

let FRONTEND = import("stdlib:compiler/selfhost_frontend.sapp");
let TOKENIZER = import("stdlib:compiler/tokenizer.sapp");
let PARSER = import("stdlib:compiler/parser.sapp");

let SMALL = "let x = 1; print x;";
let MEDIUM = "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } let value = fib(12); print value;";

fn require_parse(label, parsed, expected_stmts) {
    if parsed == nil or parsed.ast == nil {
        throw "selfhost parser benchmark: " + label + " returned no AST";
    }
    if len(parsed.errors) != 0 {
        throw "selfhost parser benchmark: " + label + " returned diagnostics";
    }
    if len(parsed.ast.stmts) != expected_stmts {
        throw "selfhost parser benchmark: " + label + " statement count mismatch";
    }
}

fn full_parse_sample(label, source, expected_stmts) {
    let t0 = now_ms();
    let parsed = FRONTEND.frontend_parse_full(source);
    let elapsed = now_ms() - t0;
    require_parse(label, parsed, expected_stmts);
    print "SELFHOST_PARSER_PHASE|" + label + "|" + str(len(source)) + "|" + str(parsed.tokens_count) + "|" + str(elapsed);
    return parsed;
}

fn direct_parse_sample(label, source, expected_stmts, rounds) {
    let t0 = now_ms();
    let token_count = 0;
    let i = 0;
    while i < rounds {
        let tokens = TOKENIZER.tokenize(source);
        let ast = PARSER.parse(tokens);
        if len(ast.errors) != 0 or len(ast.stmts) != expected_stmts {
            throw "selfhost parser benchmark: direct " + label + " mismatch";
        }
        token_count = len(tokens);
        i = i + 1;
    }
    let elapsed = now_ms() - t0;
    print "SELFHOST_PARSER_DIRECT|" + label + "|" + str(rounds) + "|" + str(token_count) + "|" + str(elapsed) + "|" + str(elapsed / rounds);
}

fn node_factory_sample(label, rounds, compatibility_path) {
    let checksum = 0;
    let i = 0;
    let t0 = now_ms();
    while i < rounds {
        let node = map{ kind: "binary", op: "+", left: 0, right: 0 };
        if compatibility_path {
            node = PARSER.make_node("binary", map{ op: "+", left: i, right: i + 1 });
        } else {
            node = map{ kind: "binary", op: "+", left: i, right: i + 1 };
        }
        checksum = checksum + node.left + node.right;
        i = i + 1;
    }
    let elapsed = now_ms() - t0;
    if checksum != rounds * rounds { throw "selfhost parser benchmark: node factory checksum mismatch"; }
    print "SELFHOST_NODE_FACTORY|" + label + "|" + str(rounds) + "|" + str(elapsed) + "|" + str(elapsed / rounds);
}

full_parse_sample("cold_small", SMALL, 2);
full_parse_sample("warm_medium", MEDIUM, 3);
direct_parse_sample("small", SMALL, 2, 5000);
direct_parse_sample("medium", MEDIUM, 3, 2000);
node_factory_sample("direct", 100000, false);
node_factory_sample("compatibility", 100000, true);
print "SELFHOST_PARSER_SUITE|ok";
