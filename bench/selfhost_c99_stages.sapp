// pblang-only staged benchmark for the complete self-hosted C99 path.
let C99 = import("stdlib/compiler/ctranspile.sapp");
let UUID = import("stdlib/uuid.sapp");

let SOURCE = "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } print fib(32);";
let CONTROL_SOURCE = "let x = 1; let y = (x = 41) + 1; print x > 40 ? y : 0;";
let CLOSURE_SOURCE = "fn apply(f, x) { return f(x); } fn inc(x) { return x + 1; } "
    + "fn scale(k) { return fn(x) { return x * k; }; } "
    + "print apply(scale(6), 7) + apply(inc, 41);";
let PROJECT_SOURCE = "let F = import(\"../lib/factory.sapp\"); print F.answer();";
let PROJECT_MODULES = map{
    "lib/math.sapp": "const BASE = 40; fn add(a, b) { return BASE + a + b; } export add;",
    "lib/factory.sapp": "let M = import(\"math.sapp\"); const OFFSET = 2; let OP = fn(x) { return M.add(x, OFFSET); }; fn answer() { return OP(0); } export answer;"
};
let PROJECT_OPTIONS = map{ entry_path: "app/main.sapp" };

fn metric(name, value, unit, detail) {
    print "C99_STAGE|" + name + "|" + str(value) + "|" + unit + "|" + detail;
}

let cc = C99.find_c_compiler();
if cc == nil {
    print "C99_STAGE_SUITE|skip|no_c_compiler";
} else {
    let generated = C99.transpile_program(SOURCE);
    let t0 = now_ms();
    let i = 0;
    let iterations = 100;
    while i < iterations { C99.transpile_program(SOURCE); i = i + 1; }
    let generation_ms = now_ms() - t0;
    metric("transpile_total", generation_ms, "ms", "iterations=" + str(iterations));
    metric("transpile_average", generation_ms / iterations, "ms", "source_bytes=" + str(len(SOURCE)));
    metric("generated_c_size", len(generated), "bytes", "hosted_translation_unit");
    let control_generated = C99.transpile_program(CONTROL_SOURCE);
    metric("control_generated_c_size", len(control_generated), "bytes", "if_and_assignment_expressions");
    let closure_t0 = now_ms();
    i = 0;
    while i < iterations { C99.transpile_program(CLOSURE_SOURCE); i = i + 1; }
    let closure_generation_ms = now_ms() - closure_t0;
    let closure_generated = C99.transpile_program(CLOSURE_SOURCE);
    metric("closure_transpile_average", closure_generation_ms / iterations, "ms", "capture_by_value");
    metric("closure_generated_c_size", len(closure_generated), "bytes", "validated_handle_runtime");
    let link_t0 = now_ms();
    i = 0; let linked = nil;
    while i < iterations { linked = C99.link_program(PROJECT_SOURCE, PROJECT_MODULES, PROJECT_OPTIONS); i = i + 1; }
    let link_ms = now_ms() - link_t0;
    if not linked.ok or linked.modules != 2 { throw "self-host C99 benchmark: project link failed"; }
    metric("module_link_total", link_ms, "ms", "iterations=" + str(iterations));
    metric("module_link_average", link_ms / iterations, "ms", "modules=2;bounded_virtual_paths");
    metric("module_link_input", linked.input_bytes, "bytes", "reachable_project_source");
    metric("module_link_output", linked.output_bytes, "bytes", "prefixed_flat_source");
    metric("module_global_definitions", len(map_keys(linked.module_value_definitions)), "modules", "translation_unit_storage");
    let linked_lower_t0 = now_ms();
    i = 0;
    while i < iterations { C99.transpile_program(linked.source); i = i + 1; }
    let linked_lower_ms = now_ms() - linked_lower_t0;
    metric("linked_transpile_average", linked_lower_ms / iterations, "ms", "linking_excluded");
    let rejected = false;
    try { C99.transpile_program("import \"missing.sapp\"; print 1;"); } catch { rejected = true; }
    if not rejected { throw "self-host C99 benchmark: unresolved import did not fail closed"; }
    metric("unsupported_rejection", 1, "case", "no_C_artifact");

    let root = "/tmp/pblang_c99_bench_" + UUID.v4();
    let speed = C99.build_program(SOURCE, root + "_speed", map{ profile: "speed", compiler: cc });
    let size = C99.build_program(SOURCE, root + "_size", map{ profile: "size", compiler: cc });
    let portable = C99.build_program(SOURCE, root + "_portable", map{ profile: "portable", compiler: cc });
    let integer = C99.build_program(SOURCE, root + "_integer", map{ profile: "speed", numeric: "integer", compiler: cc });
    let linked_build = C99.build_program(PROJECT_SOURCE, root + "_linked", map{ profile: "speed", compiler: cc,
        modules: PROJECT_MODULES, entry_path: "app/main.sapp" });
    if not speed.ok or not size.ok or not portable.ok or not integer.ok or not linked_build.ok { throw "self-host C99 benchmark build failed"; }

    metric("compile_speed_profile", speed.compile_ms, "ms", "fallback=" + str(speed.portable_fallback));
    metric("compile_size_profile", size.compile_ms, "ms", "fallback=" + str(size.portable_fallback));
    metric("compile_portable_profile", portable.compile_ms, "ms", "fallback=false");
    metric("compile_integer_profile", integer.compile_ms, "ms", "explicit_integer_semantics");
    metric("artifact_speed", speed.artifact_bytes, "bytes", speed.compiler);
    metric("artifact_size", size.artifact_bytes, "bytes", size.compiler);
    metric("artifact_portable", portable.artifact_bytes, "bytes", portable.compiler);
    metric("artifact_integer", integer.artifact_bytes, "bytes", integer.compiler);
    metric("compile_linked_project", linked_build.compile_ms, "ms", "modules=" + str(linked_build.link.modules));
    metric("artifact_linked_project", linked_build.artifact_bytes, "bytes", linked_build.compiler);

    let r0 = now_ms();
    let runs = 5;
    i = 0;
    let last = nil;
    while i < runs { last = proc_spawn_wait(speed.output, []); i = i + 1; }
    let runtime_ms = now_ms() - r0;
    if last.exit_code != 0 or last.stdout != "2178309\n" { throw "self-host C99 runtime mismatch"; }
    metric("fib32_runtime_total", runtime_ms, "ms", "runs=" + str(runs));
    metric("fib32_runtime_average", runtime_ms / runs, "ms", "verified=2178309");

    r0 = now_ms();
    i = 0;
    while i < runs { last = proc_spawn_wait(integer.output, []); i = i + 1; }
    let integer_runtime_ms = now_ms() - r0;
    if last.exit_code != 0 or last.stdout != "2178309\n" { throw "integer self-host C99 runtime mismatch"; }
    metric("fib32_integer_runtime_total", integer_runtime_ms, "ms", "runs=" + str(runs));
    metric("fib32_integer_runtime_average", integer_runtime_ms / runs, "ms", "verified=2178309");

    let closure_output = root + "_closure";
    let closure_build = C99.build_program(CLOSURE_SOURCE, closure_output, map{ profile: "speed", compiler: cc });
    if not closure_build.ok { throw "self-host C99 closure benchmark build failed"; }
    r0 = now_ms();
    i = 0;
    while i < runs { last = proc_spawn_wait(closure_build.output, []); i = i + 1; }
    let closure_runtime_ms = now_ms() - r0;
    if last.exit_code != 0 or last.stdout != "84\n" { throw "self-host C99 closure runtime mismatch"; }
    metric("closure_runtime_average", closure_runtime_ms / runs, "ms", "verified=84");
    metric("closure_artifact", closure_build.artifact_bytes, "bytes", "validated_handle_runtime");

    r0 = now_ms();
    i = 0;
    while i < runs { last = proc_spawn_wait(linked_build.output, []); i = i + 1; }
    let linked_runtime_ms = now_ms() - r0;
    if last.exit_code != 0 or last.stdout != "42\n" { throw "linked project runtime mismatch"; }
    metric("linked_project_runtime_average", linked_runtime_ms / runs, "ms", "verified=42");

    try fs_remove(speed.output) catch nil;
    try fs_remove(size.output) catch nil;
    try fs_remove(portable.output) catch nil;
    try fs_remove(integer.output) catch nil;
    try fs_remove(closure_build.output) catch nil;
    try fs_remove(linked_build.output) catch nil;
    print "C99_STAGE_SUITE|ok|" + cc;
}
