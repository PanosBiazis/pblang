// Identical public-selector and execution workloads for before/after measurements.
let CP = import("stdlib:compute.sapp");
let OS = import("stdlib:os.sapp");
let args = OS.script_args();
let mode = if len(args) > 0 { args[0] } else { "public" };
let rounds = if len(args) > 1 { parse_number(args[1]) } else { 10000 };
assert(mode == "public" or mode == "execute", "benchmark mode");
assert(rounds >= 1 and rounds <= 100000 and rounds == num_floor(rounds), "benchmark rounds");
let options = map{ preferred_device: "cpu", max_workers: 1, devices: [] };
let cfg = CP.policy(options);
let i = 0; let checksum = 0;
while i < rounds {
    let cost = 1 + num_mod(i, 7);
    let route = nil;
    if mode == "public" {
        cfg.work_units_per_item = cost;
        route = CP.select_device(4, [], cfg);
    } else {
        options.work_units_per_item = cost;
        let result = CP.run_controlled([2,3,4,5], fn(x) { return x*x; }, options);
        assert(result.ok and result.results == [4,9,16,25], "result parity");
        route = result.route;
    }
    assert(route.ok and route.workers == 1 and route.estimate.work_units == 4 * cost, "fresh route parity");
    checksum = checksum + route.estimate.work_units;
    i = i + 1;
}
print "COMPUTE_ROUTE_VALIDATION|" + mode + "|" + str(rounds) + "|" + str(checksum);
