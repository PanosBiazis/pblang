// Fixed compiler driver for the reproducible direct-codegen benchmark.
// It accepts only an input source path and output artifact path selected by the
// bounded parent harness. The generated ELF has selected runtime checks and its format is validated
// before it is published to the temporary benchmark workspace.
fn script_args() {
    let explicit = try env_get("PBLANG_SCRIPT_ARGS") catch nil;
    if type(explicit) == "string" and explicit != "" { return str_split(explicit, "\n"); }
    let argv = os_args(); let i = 0; let found = false;
    while i < len(argv) {
        let a = str(argv[i]); i = i + 1;
        if str_ends_with(a, ".sapp") or str_ends_with(a, ".pbck") { found = true; break; }
    }
    if not found { return []; }
    while i < len(argv) {
        let a = str(argv[i]);
        if a == "--" { i = i + 1; break; }
        if not str_starts_with(a, "-") { break; }
        i = i + 1;
    }
    let out = []; while i < len(argv) { push(out, argv[i]); i = i + 1; } return out;
}
let args = script_args();
if len(args) != 2 {
    throw "repro_codegen_x64: expected source and artifact paths";
}

let source = fs_read(args[0]);
if len(str_to_bytes(source)) > 16777216 { throw "repro_codegen_x64: source limit exceeded"; }
let CG = import("stdlib/native/codegen_x64_tier1.sapp");
let compilation = CG.compile_safe(source);
if not compilation.safe {
    throw "repro_codegen_x64: compilation with selected runtime checks failed";
}

let bin = compilation.binary;
if len(bin) < 120 or bin[0] != 127 or bin[1] != 69 or bin[2] != 76 or bin[3] != 70 {
    throw "repro_codegen_x64: invalid ELF artifact";
}

let staged = args[1] + ".tmp-" + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 16);
fs_write_bytes(staged, bin);
let readback = try fs_read_bytes(staged) catch [];
if len(readback) != len(bin) { try fs_remove(staged) catch nil; throw "repro_codegen_x64: staged verification failed"; }
let published = try { fs_rename(staged, args[1]); true } catch false;
if not published { try fs_remove(staged) catch nil; throw "repro_codegen_x64: publication failed"; }
print len(bin);
