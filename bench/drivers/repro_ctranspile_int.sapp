// Fixed PBLang-only C99 integer-profile driver for equivalent integer workloads.
fn script_args() {
    let explicit = try env_get("PBLANG_SCRIPT_ARGS") catch nil;
    if type(explicit) == "string" and explicit != "" { return str_split(explicit, "\n"); }
    let argv = os_args(); let i = 0; let found = false;
    while i < len(argv) {
        let a = str(argv[i]); i = i + 1;
        if str_ends_with(a, ".sapp") or str_ends_with(a, ".pbck") { found = true; break; }
    }
    if not found { return []; }
    while i < len(argv) {
        let a = str(argv[i]);
        if a == "--" { i = i + 1; break; }
        if not str_starts_with(a, "-") { break; }
        i = i + 1;
    }
    let out = []; while i < len(argv) { push(out, argv[i]); i = i + 1; } return out;
}

let args = script_args();
if len(args) != 2 { throw "repro_ctranspile_int: expected source and C output paths"; }
let source = fs_read(args[0]);
if len(str_to_bytes(source)) > 16777216 { throw "repro_ctranspile_int: source limit exceeded"; }
let C99 = import("stdlib/compiler/ctranspile_tier1.sapp");
let generated = C99.transpile_program_int(source);
if type(generated) != "string" or len(generated) == 0 { throw "repro_ctranspile_int: empty C artifact"; }
let staged = args[1] + ".tmp-" + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 16);
fs_write(staged, generated);
if fs_read(staged) != generated { try fs_remove(staged) catch nil; throw "repro_ctranspile_int: staged verification failed"; }
let published = try { fs_rename(staged, args[1]); true } catch false;
if not published { try fs_remove(staged) catch nil; throw "repro_ctranspile_int: publication failed"; }
print len(str_to_bytes(generated));
