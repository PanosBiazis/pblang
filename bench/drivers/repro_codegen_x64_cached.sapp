// Incremental direct-codegen driver. Reports cache hits separately from cold compilation.
let SOURCE = import("stdlib:compiler/checked_source.sapp");
let CACHE = import("stdlib/native/artifact_cache.sapp");

fn script_args() {
    let explicit = try env_get("PBLANG_SCRIPT_ARGS") catch nil;
    if type(explicit) == "string" and explicit != "" { return str_split(explicit, "\n"); }
    let argv = os_args(); let i = 0; let found = false;
    while i < len(argv) {
        let a = str(argv[i]); i = i + 1;
        if str_ends_with(a, ".sapp") or str_ends_with(a, ".pbck") { found = true; break; }
    }
    if not found { return []; }
    while i < len(argv) {
        let a = str(argv[i]);
        if a == "--" { i = i + 1; break; }
        if not str_starts_with(a, "-") { break; }
        i = i + 1;
    }
    let out = []; while i < len(argv) { push(out, argv[i]); i = i + 1; } return out;
}

let args = script_args();
if len(args) < 2 or len(args) > 3 { throw "repro_codegen_x64_cached: expected source, artifact, and optional cache root"; }
let source = fs_read(args[0]);
SOURCE.parse_source(source);
let root = if len(args) == 3 { args[2] } else { CACHE.default_root() };
let deps = [
    "stdlib/native/codegen_x64.sapp",
    "stdlib/compiler/checked_source.sapp",
    "stdlib/compiler/tokenizer.sapp",
    "stdlib/compiler/parser.sapp",
    "stdlib/native/elf_x64.sapp"
];
let key = CACHE.cache_key(source, deps, "compile_safe;overflow=default;heap=default");
let cached = CACHE.load(root, key);
let bin = nil; let mode = "hit";
if cached.hit { bin = cached.binary; }
else {
    mode = "miss";
    let CG = import("stdlib/native/codegen_x64.sapp");
    let compilation = CG.compile_safe(source);
    if not compilation.safe or not CACHE.valid_x64_elf(compilation.binary) { throw "repro_codegen_x64_cached: compilation with selected runtime checks failed"; }
    bin = compilation.binary;
    let stored = CACHE.store(root, key, bin);
    if not stored.ok { throw "repro_codegen_x64_cached: " + stored.error; }
}
let published = CACHE.publish(args[1], bin);
if not published.ok { throw "repro_codegen_x64_cached: " + published.error; }
print mode + "|" + str(len(bin));
