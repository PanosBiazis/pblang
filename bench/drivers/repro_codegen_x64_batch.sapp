// One-process, multi-file direct x86-64 compiler driver.
let SESSION = import("stdlib/native/compile_session.sapp");

fn script_args() {
    let explicit = try env_get("PBLANG_SCRIPT_ARGS") catch nil;
    if type(explicit) == "string" and explicit != "" { return str_split(explicit, "\n"); }
    let argv = os_args(); let i = 0; let found = false;
    while i < len(argv) {
        let value = str(argv[i]); i = i + 1;
        if str_ends_with(value, ".sapp") or str_ends_with(value, ".pbck") { found = true; break; }
    }
    if not found { return []; }
    while i < len(argv) {
        let value = str(argv[i]);
        if value == "--" { i = i + 1; break; }
        if not str_starts_with(value, "-") { break; }
        i = i + 1;
    }
    let out = []; while i < len(argv) { array_push(out, argv[i]); i = i + 1; } return out;
}

let args = script_args();
if len(args) != 1 { throw "repro_codegen_x64_batch: expected one request JSON path"; }
let raw = fs_read(args[0]);
if type(raw) != "string" or len(str_to_bytes(raw)) > 1048576 { throw "repro_codegen_x64_batch: request limit exceeded"; }
let request = try json_parse(raw) catch nil;
if type(request) != "map" or type(try request.jobs catch nil) != "array"
    or len(request.jobs) == 0 or len(request.jobs) > 64 {
    throw "repro_codegen_x64_batch: invalid request";
}
let jobs = [];
let i = 0;
while i < len(request.jobs) {
    let item = request.jobs[i];
    if type(item) != "map" or type(try item.source_path catch nil) != "string"
        or type(try item.output catch nil) != "string" {
        throw "repro_codegen_x64_batch: invalid job";
    }
    let source = try fs_read(item.source_path) catch nil;
    if type(source) != "string" or len(str_to_bytes(source)) > 16777216 {
        throw "repro_codegen_x64_batch: source read or size failure";
    }
    array_push(jobs, map{ source: source, output: item.output });
    i = i + 1;
}
let options = map{};
if map_has(request, "cache_root") { options.cache_root = request.cache_root; }
if map_has(request, "cache") { options.cache = request.cache; }
let result = SESSION.compile_many(SESSION.session(options), jobs);
if not result.ok { throw "repro_codegen_x64_batch: " + result.error; }
print json_stringify(result);
