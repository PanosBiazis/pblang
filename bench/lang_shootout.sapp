//
// bench/lang_shootout.sapp — Pure-PBLang Cross-Language Recursive Fibonacci Shootout
//
// Replaces bench/lang_shootout.sh. Compares pblang (direct x86-64 codegen, C99 transpiler,
// selfhost C99 f64/int, and interpreter) against optional auto-detected host toolchains.

let CG = import("stdlib:native/codegen_x64.sapp");

fn _collect_args() {
    let raw_env = env_get("PBLANG_SCRIPT_ARGS");
    if raw_env != nil and raw_env != "" {
        let parts = str_split(raw_env, "\n");
        let env_out = [];
        let k = 0;
        while k < len(parts) {
            if parts[k] != "" { array_push(env_out, parts[k]); }
            k = k + 1;
        }
        return env_out;
    }
    let argv = try os_args() catch [];
    if not is_array(argv) { return []; }
    let n = len(argv);
    let i = 0;
    let found = false;
    while i < n {
        let a = str(argv[i]);
        i = i + 1;
        if str_ends_with(a, ".sapp") or str_ends_with(a, ".pbck") { found = true; break; }
    }
    if not found { return []; }
    while i < n {
        let a2 = str(argv[i]);
        if a2 == "--" { i = i + 1; break; }
        if not str_starts_with(a2, "-") { break; }
        i = i + 1;
    }
    let out = [];
    while i < n {
        array_push(out, str(argv[i]));
        i = i + 1;
    }
    return out;
}

fn _parse_uint(s: string, fallback: int) {
    if len(s) == 0 { return fallback; }
    let acc = 0;
    let i = 0;
    while i < len(s) {
        let c = strcharcodeat(s, i);
        if c < 48 or c > 57 { return fallback; }
        acc = acc * 10 + (c - 48);
        i = i + 1;
    }
    return acc;
}

fn _find_pb(root: string) {
    let env_b = env_get("PB");
    if env_b != nil and env_b != "" and fs_exists(env_b) { return env_b; }
    if fs_exists(root + "/target/release/pblang") { return root + "/target/release/pblang"; }
    if fs_exists(root + "/pblang") { return root + "/pblang"; }
    return "pblang";
}

fn _have(tool: string) {
    let r = try proc_spawn_wait("which", [tool]) catch map{ exit_code: 1 };
    return r.exit_code == 0;
}

fn _pad_right(s: string, w: int) {
    let o = s;
    while len(o) < w { o = o + " "; }
    return o;
}

fn _pad_left(s: string, w: int) {
    let o = s;
    while len(o) < w { o = " " + o; }
    return o;
}

fn _row(target: string, t_ms: string, res: string, notes: string) {
    println(_pad_right(target, 26) + " " + _pad_left(t_ms, 11) + " " + _pad_left(res, 16) + " " + _pad_left(notes, 12));
}

fn _skip(target: string, pkg: string) {
    _row(target, "n/a", "not installed", pkg);
}

fn _fsize(p: string) {
    if not fs_exists(p) { return "-"; }
    return str(len(fs_read_bytes(p)));
}

let args = _collect_args();
let n_val = if len(args) > 0 { _parse_uint(args[0], 32) } else { 32 };
let k_runs = if len(args) > 1 { _parse_uint(args[1], 3) } else { 3 };
let tmo_raw = env_get("TMO");
let tmo_sec = if tmo_raw != nil and tmo_raw != "" { _parse_uint(tmo_raw, 75) } else { 75 };
let has_timeout = _have("timeout");

let root = cwd();
let pb = _find_pb(root);
let asm_src = root + "/bench/fib_asm.S";
let work = "/tmp/pb_lang_shootout_" + str(num_floor(now_ms()));
fs_mkdirs(work);

let bestof = fn(cmd_bin: string, cmd_args: any) {
    let best = 99999999;
    let last_out = "";
    let i = 0;
    while i < k_runs {
        let t0 = now_ms();
        let r = if has_timeout {
            let ta = [str(tmo_sec), cmd_bin];
            let j = 0;
            while j < len(cmd_args) { array_push(ta, cmd_args[j]); j = j + 1; }
            proc_spawn_wait("timeout", ta)
        } else {
            proc_spawn_wait(cmd_bin, cmd_args)
        };
        let dt = num_floor(now_ms() - t0);
        if r.exit_code == 124 {
            return map{ rep: ">" + str(tmo_sec) + "s", res: "(timeout)" };
        }
        if dt < best { best = dt; }
        last_out = str_trim(str(r.stdout));
        i = i + 1;
    }
    return map{ rep: str(best), res: last_out };
};

let arch = str_trim(str((try proc_spawn_wait("uname", ["-m"]) catch map{ stdout: "x86_64" }).stdout));
let cores = str_trim(str((try proc_spawn_wait("nproc", []) catch map{ stdout: "1" }).stdout));
let utc = str_trim(str((try proc_spawn_wait("date", ["-u", "+%FT%TZ"]) catch map{ stdout: "" }).stdout));

println("=== Language shootout — fib(" + str(n_val) + "), best-of-" + str(k_runs) + " — " + utc + " ===");
println("    (host: " + arch + " " + cores + " cores; time_ms includes process startup)");
println("    (fixed N is embedded in source: compiler specialization is part of this category)");
_row("target", "time_ms", "result", "size/notes");
_row("--------------------------", "-----------", "----------------", "------------");

let fib_src = "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); }\nprint fib(" + str(n_val) + ");\n";
let fib_cg = work + "/fib_cg";
let cg_ok = false;
try {
    fs_write_bytes(fib_cg, CG.compile_fns(fib_src));
    proc_spawn_wait("chmod", ["755", fib_cg]);
    cg_ok = true;
} catch _e {
    cg_ok = false;
}
if cg_ok and fs_exists(fib_cg) {
    let b = bestof(fib_cg, []);
    _row("pblang (native codegen-x64)", b.rep, b.res, _fsize(fib_cg));
} else {
    _row("pblang (native codegen-x64)", "err", "compile failed", "-");
}

let fibr_sapp = work + "/fibr.sapp";
fs_write(fibr_sapp, "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); }\nprint str(fib(" + str(n_val) + "));\n");
let fib_pbc = work + "/fib_pbc";
if proc_spawn_wait(pb, ["compile", fibr_sapp, "--out", fib_pbc]).exit_code == 0 and fs_exists(fib_pbc) {
    let b = bestof(fib_pbc, []);
    _row("pblang (native C99)", b.rep, b.res, _fsize(fib_pbc));
}

let fibr_self = work + "/fibr_self.sapp";
fs_write(fibr_self, fib_src);
let fib_self_f64 = work + "/fib_pbself_f64";
let fib_self_int = work + "/fib_pbself_int";
if proc_spawn_wait(pb, ["run", root + "/bench/selfhost_c99_build.sapp", "--allow-exec", "--", fibr_self, fib_self_f64, fib_self_int]).exit_code == 0 and fs_exists(fib_self_f64) {
    let bf = bestof(fib_self_f64, []);
    _row("pblang (selfhost C99 f64)", bf.rep, bf.res, _fsize(fib_self_f64));
    let bi = bestof(fib_self_int, []);
    _row("pblang (selfhost C99 int)", bi.rep, bi.res, _fsize(fib_self_int));
} else {
    _row("pblang (selfhost C99)", "err", "compile failed", "-");
}

let b_interp = bestof(pb, ["run", fibr_sapp]);
_row("pblang (interpreter)", b_interp.rep, b_interp.res, "-");

if _have("as") and _have("ld") and fs_exists(asm_src) {
    let patched_asm = regex_replace_all(fs_read(asm_src), "\\bNVAL\\b", str(n_val));
    let s_file = work + "/fib_asm.S";
    let o_file = work + "/fib_asm.o";
    let a_bin = work + "/fib_asm";
    fs_write(s_file, patched_asm);
    if proc_spawn_wait("as", ["--64", s_file, "-o", o_file]).exit_code == 0 and proc_spawn_wait("ld", [o_file, "-o", a_bin]).exit_code == 0 {
        let ba = bestof(a_bin, []);
        _row("Assembly (hand-written)", ba.rep, ba.res, _fsize(a_bin));
    } else {
        _row("Assembly (hand-written)", "err", "assemble failed", "-");
    }
} else {
    _skip("Assembly (hand-written)", "binutils");
}

let c_file = work + "/fib.c";
fs_write(c_file, "#include <stdio.h>\nlong fib(long n){return n<2?n:fib(n-1)+fib(n-2);}\nint main(){printf(\"%ld\\n\",fib(" + str(n_val) + "));return 0;}\n");
if _have("gcc") {
    let c2 = work + "/fib_c2";
    if proc_spawn_wait("gcc", ["-O2", "-o", c2, c_file]).exit_code == 0 {
        let bc = bestof(c2, []);
        _row("C (gcc -O2)", bc.rep, bc.res, _fsize(c2));
    }
    let c0 = work + "/fib_c0";
    if proc_spawn_wait("gcc", ["-O0", "-o", c0, c_file]).exit_code == 0 {
        let bc0 = bestof(c0, []);
        _row("C (gcc -O0)", bc0.rep, bc0.res, _fsize(c0));
    }
} else { _skip("C (gcc)", "gcc"); }

if _have("clang") {
    let cl = work + "/fib_cl";
    if proc_spawn_wait("clang", ["-O2", "-o", cl, c_file]).exit_code == 0 {
        let bcl = bestof(cl, []);
        _row("C (clang -O2)", bcl.rep, bcl.res, _fsize(cl));
    }
} else { _skip("C (clang)", "clang"); }

let cpp_file = work + "/fib.cpp";
fs_write(cpp_file, "#include <cstdio>\nlong fib(long n){return n<2?n:fib(n-1)+fib(n-2);}\nint main(){printf(\"%ld\\n\",fib(" + str(n_val) + "));return 0;}\n");
if _have("g++") {
    let gpp = work + "/fib_gpp";
    if proc_spawn_wait("g++", ["-O2", "-o", gpp, cpp_file]).exit_code == 0 {
        let bg = bestof(gpp, []);
        _row("C++ (g++ -O2)", bg.rep, bg.res, _fsize(gpp));
    }
} else { _skip("C++ (g++)", "g++"); }

if _have("rustc") {
    let rs_file = work + "/fib.rs";
    let rs_bin = work + "/fib_rs";
    fs_write(rs_file, "fn fib(n:u64)->u64{if n<2{n}else{fib(n-1)+fib(n-2)}}\nfn main(){println!(\"{}\",fib(" + str(n_val) + "));}\n");
    if proc_spawn_wait("rustc", ["-O", "-o", rs_bin, rs_file]).exit_code == 0 {
        let br = bestof(rs_bin, []);
        _row("Rust (rustc -O)", br.rep, br.res, _fsize(rs_bin));
    }
} else { _skip("Rust (rustc)", "rustup / rust"); }

if _have("go") {
    let go_file = work + "/fib.go";
    let go_bin = work + "/fib_go";
    fs_write(go_file, "package main\nimport \"fmt\"\nfunc fib(n int64) int64{if n<2{return n};return fib(n-1)+fib(n-2)}\nfunc main(){fmt.Println(fib(" + str(n_val) + "))}\n");
    if proc_spawn_wait("go", ["build", "-o", go_bin, go_file]).exit_code == 0 {
        let bgo = bestof(go_bin, []);
        _row("Go (gc)", bgo.rep, bgo.res, _fsize(go_bin));
    } else { _skip("Go (gc)", "golang"); }
} else { _skip("Go (gc)", "golang-go"); }

if _have("node") {
    let js_file = work + "/fib.js";
    fs_write(js_file, "function fib(n){return n<2?n:fib(n-1)+fib(n-2);}console.log(fib(" + str(n_val) + "));\n");
    let bn = bestof("node", [js_file]);
    _row("JavaScript (Node/V8)", bn.rep, bn.res, "-");
} else { _skip("JavaScript (Node)", "nodejs"); }

if _have("zig") {
    let zig_file = work + "/fib.zig";
    let zig_bin = work + "/fib_zig";
    fs_write(zig_file, "const std=@import(\"std\");\nfn fib(n:i64)i64{return if(n<2) n else fib(n-1)+fib(n-2);}\npub fn main()!void{try std.io.getStdOut().writer().print(\"{d}\\n\",.{fib(" + str(n_val) + ")});}\n");
    if proc_spawn_wait("zig", ["build-exe", "-O", "ReleaseFast", "-femit-bin=" + zig_bin, zig_file]).exit_code == 0 and fs_exists(zig_bin) {
        let bz = bestof(zig_bin, []);
        _row("Zig (ReleaseFast)", bz.rep, bz.res, _fsize(zig_bin));
    } else { _skip("Zig", "zig"); }
} else { _skip("Zig", "zig"); }

let names = try fs_listdir(work) catch [];
let ci = 0;
while ci < len(names) {
    try fs_remove(work + "/" + names[ci]) catch nil;
    ci = ci + 1;
}
try fs_remove(work) catch nil;

println("");
println("Notes: 'pblang (native codegen-x64)' is the pblang-written DIRECT backend — no C in the compile path.");
println("       Absent toolchains show 'not installed'; install the named package and re-run to include them.");
