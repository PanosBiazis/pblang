let BUILD = import("stdlib:build.sapp");
let BENCH = import("stdlib:benchmark.sapp");
let UUID = import("stdlib:uuid.sapp");

let root = "/tmp/pblang_smart_build_bench_" + UUID.v4();
let source_path = root + ".sapp";
let output_path = root + ".elf";
let cache_root = root + "_cache";
let PLANS_PER_SAMPLE = 100;
let source = "let s = 0; let i = 0; while i < 100000 { s = (s + i * 7 + 3) % 1000003; i = i + 1; } print s;";
let options = map{ backend: "auto", goal: "speed", fallback: false, cache: true, cache_root: cache_root };
fs_write(source_path, source);

fn stats(name, samples) {
    let value = BENCH.stats(name, samples);
    print "SMART_BUILD_STAGE|" + name + "|" + str(value.median_ms) + "|" + str(value.p95_ms) + "|" + str(samples);
    return value;
}

// Prime host detection before measuring pure deterministic planning.
let first_plan = BUILD.smart_plan(source_path, output_path, options);
if not first_plan.ok or first_plan.strategies[0] != "direct-x64" { throw "smart build benchmark: direct plan unavailable"; }
let planning = [];
let i = 0;
while i < 9 {
    let t0 = now_ms();
    let j = 0;
    while j < PLANS_PER_SAMPLE {
        let p = BUILD.smart_plan(source_path, output_path, options);
        if not p.ok or p.target != "linux-x64" { throw "smart build benchmark: invalid plan"; }
        j = j + 1;
    }
    array_push(planning, now_ms() - t0);
    i = i + 1;
}

let t0 = now_ms();
let build_session = BUILD.smart_session(options);
let session_setup_ms = now_ms() - t0;
t0 = now_ms();
let cold = BUILD.smart_build_in_session(build_session, source_path, output_path, options);
let cold_ms = now_ms() - t0;
if not cold.ok or cold.cache_misses != 1 or cold.compiled != 1 { throw "smart build benchmark: cold build mismatch"; }
let executed = proc_spawn_wait(output_path, []);
if executed.exit_code != 0 or str_trim(executed.stdout) == "" { throw "smart build benchmark: artifact execution failed"; }

let warm = [];
i = 0;
while i < 9 {
    t0 = now_ms();
    let result = BUILD.smart_build_in_session(build_session, source_path, output_path, options);
    array_push(warm, now_ms() - t0);
    if not result.ok or result.cache_hits != 1 or result.compiled != 0 { throw "smart build benchmark: warm cache mismatch"; }
    i = i + 1;
}

let jobs = [];
i = 0;
while i < 6 {
    array_push(jobs, map{ source: source_path, output: root + "_batch_" + str(i) + ".elf" });
    i = i + 1;
}
let batch_samples = [];
i = 0;
while i < 9 {
    t0 = now_ms();
    let batch = BUILD.smart_build_many_in_session(build_session, jobs, options);
    array_push(batch_samples, now_ms() - t0);
    if not batch.ok or batch.cache_hits != 6 or batch.compiled != 0 { throw "smart build benchmark: warm batch mismatch"; }
    i = i + 1;
}

print "SMART_BUILD_SCHEMA|stage|median_ms|p95_ms|samples_ms";
let plan_stats = stats("plan_100", planning);
print "SMART_BUILD_STAGE|session_setup|" + str(session_setup_ms) + "|" + str(session_setup_ms) + "|[" + str(session_setup_ms) + "]";
print "SMART_BUILD_STAGE|cold_compile|" + str(cold_ms) + "|" + str(cold_ms) + "|[" + str(cold_ms) + "]";
let warm_stats = stats("warm_publish", warm);
let batch_stats = stats("warm_batch_6", batch_samples);
print "SMART_BUILD_DERIVED|plan_per_call_us|" + str(plan_stats.median_ms * 1000 / PLANS_PER_SAMPLE);
print "SMART_BUILD_DERIVED|warm_batch_per_artifact_ms|" + str(batch_stats.median_ms / 6);
print "SMART_BUILD_DERIVED|cold_vs_warm_speedup|" + str(cold_ms / warm_stats.median_ms);

try fs_remove(source_path) catch nil;
try fs_remove(output_path) catch nil;
i = 0;
while i < len(jobs) { try fs_remove(jobs[i].output) catch nil; i = i + 1; }
let entries = try fs_listdir(cache_root) catch [];
i = 0;
while i < len(entries) { try fs_remove(path_join(cache_root, entries[i])) catch nil; i = i + 1; }
try fs_remove(cache_root) catch nil;
print "SMART_BUILD_SUITE|ok";
