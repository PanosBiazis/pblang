// pblang:target=kernel
// pblang:extern heap_init heap_alloc heap_free
// Control: repeatedly free a middle block while both neighbours stay live.
fn kmain() {
    let h=kmalloc(8);let arena=kmalloc(4096);heap_init(h,arena,4096);
    let a=heap_alloc(h,24);let b=heap_alloc(h,24);let c=heap_alloc(h,24);
    poke32(a,91);poke32(c,92);let i=0;
    while i<1000000 {
        heap_free(h,b);let replacement=heap_alloc(h,24);
        if replacement!=b or peek32(a)!=91 or peek32(c)!=92 {outb(244,1);while 1>0 {hlt();}}
        i=i+1;
    }
    heap_free(h,a);heap_free(h,b);heap_free(h,c);
    if peek32(h)!=arena or peek32(arena)!=4096 or peek32(arena+4)!=0 {outb(244,1);}else {outb(244,42);}
    while 1>0 {hlt();}
}
