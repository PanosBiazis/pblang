let AI=import("stdlib/pbai.sapp");
let rows=[];
for size in [4,64,256] {
 let values=[];for i size {push(values,2*i+3);}
 let request=map{values:values,period_seconds:2,sigma:3,absolute_tolerance:0.5};
 let expected=json_stringify(AI.sensor_analyze(request));let samples=[];
 for trial 5 {
  let start=now_ms();for call 32 {assert(json_stringify(AI.sensor_analyze(request))==expected,"deterministic result");}
  push(samples,now_ms()-start);
 }
 let sorted=array_sort(samples);
 push(rows,map{size:size,samples_ms:samples,median_ms:sorted[2],p95_sample_ms:sorted[4],output_digest:sha256(expected)});
}
print json_stringify(map{format:"pbai.sensor.benchmark.v1",warmups:1,samples:5,calls_per_sample:32,rows:rows,
 scope:"shared desktop wall time including JSON serialization; synthetic linear data; no quality or cross-platform claim"});
