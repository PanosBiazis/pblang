// pblang:target=kernel
// pblang:extern heap_init heap_alloc heap_free
// Identical allocator workload for before/after QEMU runs. No heap resets.
fn kmain() {
    let h=kmalloc(8);let arena=kmalloc(4096);heap_init(h,arena,4096);let i=0;
    while i<1000000 {
        let a=heap_alloc(h,24);let b=heap_alloc(h,24);let c=heap_alloc(h,24);
        if a==0 or b==0 or c==0 {outb(244,1);while 1>0 {hlt();}}
        heap_free(h,a);heap_free(h,b);heap_free(h,c);i=i+1;
    }
    if peek32(h)!=arena or peek32(arena)!=4096 or peek32(arena+4)!=0 {outb(244,1);}else {outb(244,42);}
    while 1>0 {hlt();}
}
