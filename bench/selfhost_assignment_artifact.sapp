// Produce a native PBCK fixture; measure EXECUTION separately from compilation.
// Usage: run this file --allow-all -- indexed|attribute <disposable-output.pbck>
let FE=import("stdlib/compiler/selfhost_frontend.sapp");
let XL=import("stdlib/selfhost_to_pbck.sapp");
let args=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");
assert(len(args)==2,"expected mode and output artifact");
let source="";
if args[0]=="indexed" {
    source="let box=[\"\"];for i 20000 {box[0]=str_repeat(\"x\",1024);}print len(box[0]);";
} elif args[0]=="attribute" {
    source="let box=map{v:\"\"};for i 20000 {box.v=str_repeat(\"x\",1024);}print len(box.v);";
} else {throw "unknown assignment fixture mode";}
let result=FE.frontend_compile(source);assert(result.ok,"fixture compilation");
XL.write_file(args[1],result.chunk);
print "assignment artifact ready";
