//
// bench/competitor_suite.sapp — Pure-PBLang Reproducible Cross-Language Benchmark Orchestrator
//
// Replaces bench/competitor_suite.sh. Runs lang_shootout.sapp, loop_bench.sapp,
// language_category_matrix.sapp, resource_bench.sapp, pipeline_bench.sapp, and
// pblang_phase_suite.sapp, preserving raw evidence.

fn _collect_args() {
    let raw_env = env_get("PBLANG_SCRIPT_ARGS");
    if raw_env != nil and raw_env != "" {
        let parts = str_split(raw_env, "\n");
        let env_out = [];
        let k = 0;
        while k < len(parts) {
            if parts[k] != "" { array_push(env_out, parts[k]); }
            k = k + 1;
        }
        return env_out;
    }
    let argv = try os_args() catch [];
    if not is_array(argv) { return []; }
    let n = len(argv);
    let i = 0;
    let found = false;
    while i < n {
        let a = str(argv[i]);
        i = i + 1;
        if str_ends_with(a, ".sapp") or str_ends_with(a, ".pbck") { found = true; break; }
    }
    if not found { return []; }
    while i < n {
        let a2 = str(argv[i]);
        if a2 == "--" { i = i + 1; break; }
        if not str_starts_with(a2, "-") { break; }
        i = i + 1;
    }
    let out = [];
    while i < n {
        array_push(out, str(argv[i]));
        i = i + 1;
    }
    return out;
}

fn _find_pb(root: string) {
    let env_b = env_get("PB");
    if env_b != nil and env_b != "" and fs_exists(env_b) { return env_b; }
    if fs_exists(root + "/target/release/pblang") { return root + "/target/release/pblang"; }
    if fs_exists(root + "/pblang") { return root + "/pblang"; }
    return "pblang";
}

fn _env_or(key: string, fallback: string) {
    let v = env_get(key);
    if v != nil and v != "" { return v; }
    return fallback;
}

fn _utc_stamp() {
    let r = try proc_spawn_wait("date", ["-u", "+%Y%m%dT%H%M%SZ"]) catch map{ exit_code: 1, stdout: "" };
    let s = str_trim(str(r.stdout));
    if s != "" { return s; }
    return str(num_floor(now_ms()));
}

let root = cwd();
let pb = _find_pb(root);
let fib_n = _env_or("FIB_N", "32");
let loop_n = _env_or("LOOP_N", "10000000");
let reps = _env_or("REPS", "3");
let tmo = _env_or("TMO", "45");
try env_set("TMO", tmo) catch nil;

let stamp = _utc_stamp();
let args = _collect_args();
let out_dir = if len(args) > 0 { args[0] } else { root + "/bench/results/" + stamp };
fs_mkdirs(out_dir);

let uname_out = str_trim(str((try proc_spawn_wait("uname", ["-srmo"]) catch map{ stdout: "unknown" }).stdout));
let nproc_out = str_trim(str((try proc_spawn_wait("nproc", []) catch map{ stdout: "1" }).stdout));
let pb_ver = str_trim(str(proc_spawn_wait(pb, ["--version"]).stdout));

let env_lines = [
    "utc=" + stamp,
    "kernel=" + uname_out,
    "logical_cpus=" + nproc_out,
    "pblang=" + pb_ver
];
let tools = ["gcc", "clang", "rustc", "go", "node", "java", "ruby", "lua", "perl", "fpc", "dotnet", "mono"];
let ti = 0;
while ti < len(tools) {
    let tl = tools[ti];
    let wr = try proc_spawn_wait("which", [tl]) catch map{ exit_code: 1, stdout: "" };
    if wr.exit_code == 0 {
        array_push(env_lines, tl + "=" + str_trim(str(wr.stdout)));
    }
    ti = ti + 1;
}
fs_write(out_dir + "/environment.txt", str_join(env_lines, "\n") + "\n");

let run_and_save = fn(script_rel: string, extra_args: any, dst_file: string) {
    let c_args = ["run", root + "/" + script_rel, "--allow-all"];
    if len(extra_args) > 0 {
        array_push(c_args, "--");
        let i = 0;
        while i < len(extra_args) {
            array_push(c_args, extra_args[i]);
            i = i + 1;
        }
    }
    let r = proc_spawn_wait(pb, c_args);
    if r.exit_code != 0 {
        throw "Suite step failed (" + script_rel + "): " + str(r.stderr);
    }
    print(r.stdout);
    if dst_file != "" {
        fs_write(dst_file, str(r.stdout));
    }
    return str(r.stdout);
};

run_and_save("bench/lang_shootout.sapp", [fib_n, reps], out_dir + "/fib.txt");
run_and_save("bench/loop_bench.sapp", [loop_n, reps], out_dir + "/loop.txt");
let cat_out = run_and_save("bench/language_category_matrix.sapp", [], out_dir + "/language-categories.txt");
if not str_contains(cat_out, "LANGUAGE_CATEGORY_MATRIX_SUITE|ok") {
    throw "Missing LANGUAGE_CATEGORY_MATRIX_SUITE|ok marker";
}
run_and_save("bench/resource_bench.sapp", [fib_n], out_dir + "/resources.txt");
run_and_save("bench/pipeline_bench.sapp", [], out_dir + "/pipeline.txt");
run_and_save("bench/pblang_phase_suite.sapp", [out_dir + "/pblang-phases"], "");

println("Benchmark evidence written to " + out_dir);
