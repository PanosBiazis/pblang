// pblang:target=kernel
// pblang:extern heap_init gc_new gc_set_auto gc_alloc gc_set_child gc_add_root gc_live gc_collections kernel_gc_collect
// Every root is a self-cycle. Checks completion of all queued single edges.
fn kmain() {
    let h=kmalloc(8);let region=kmalloc(131072);heap_init(h,region,131072);
    let g=gc_new(h);gc_set_auto(g,0);let i=0;
    while i<128 {
        let obj=gc_alloc(g,1);
        if obj==0 or gc_set_child(obj,0,obj)!=1 or gc_add_root(g,obj)!=1 {
            outb(244,1);while 1>0 {hlt();}
        }
        i=i+1;
    }
    i=0;while i<200000 {
        if kernel_gc_collect(g)!=0 {outb(244,1);while 1>0 {hlt();}}
        i=i+1;
    }
    if gc_live(g)!=128 or gc_collections(g)!=200000 {outb(244,1);}
    else {outb(244,42);}
    while 1>0 {hlt();}
}
