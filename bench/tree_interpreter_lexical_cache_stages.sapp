// Long-batch benchmark for lexical lookup in the pure-pblang tree interpreter.
// Larger batches reduce CPU-frequency noise that dominates single fib runs.
let INT = import("stdlib/compiler/interp.sapp");

let FIB = "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } if fib(18) != 2584 { missing(); }";
let CHOOSE = "fn choose(n, k) { if k == 0 or k == n { return 1; } return choose(n - 1, k - 1) + choose(n - 1, k); } if choose(15, 7) != 6435 { missing(); }";
let CAPTURE = "fn counter(start) { let value = start; return fn(step) { value = value + step; return value; }; } let c = counter(1); let i = 0; while i < 200 { c(2); i = i + 1; } if c(0) != 401 { missing(); }";

let fib_ast = INT.compile_program(FIB);
let choose_ast = INT.compile_program(CHOOSE);
let capture_ast = INT.compile_program(CAPTURE);

fn measure(name, ast, iterations) {
    if INT.eval_ast(ast) != true { throw "lexical-cache benchmark warmup failed: " + name; }
    let t0 = now_ms();
    let i = 0;
    while i < iterations {
        if INT.eval_ast(ast) != true { throw "lexical-cache benchmark failed: " + name; }
        i = i + 1;
    }
    let elapsed = now_ms() - t0;
    print "LEXICAL_CACHE|" + name + "|" + str(iterations) + "|" + str(elapsed)
        + "|" + str(elapsed / iterations) + "|ok";
}

fn baseline_lookup(env, name) {
    let e = env;
    while e != nil {
        if map_has(e, name) { return e[name]; }
        e = e["@p"];
    }
    throw "lookup failed";
}

fn cached_lookup0(env, name) { return env[name]; }
fn cached_lookup1(env, name) { return env["@p"][name]; }
fn cached_lookup2(env, name) { return env["@p"]["@p"][name]; }

fn measure_lookup(name, lookup, env, key, iterations) {
    let sum = 0;
    let t0 = now_ms();
    let i = 0;
    while i < iterations { sum = sum + lookup(env, key); i = i + 1; }
    let elapsed = now_ms() - t0;
    if sum != iterations * 7 { throw "lookup benchmark result mismatch: " + name; }
    print "LEXICAL_LOOKUP|" + name + "|" + str(iterations) + "|" + str(elapsed)
        + "|" + str(elapsed / iterations) + "|ok";
}

print "SCHEMA|name|iterations|total_ms|average_ms|status";
measure("fib18", fib_ast, 15);
measure("choose15_7", choose_ast, 6);
measure("captured_assignment_200", capture_ast, 20);
let scope0 = map{ value: 7, "@p": nil };
let scope1 = map{ "@p": scope0 };
let scope2 = map{ "@p": scope1 };
measure_lookup("baseline_depth0", baseline_lookup, scope0, "value", 200000);
measure_lookup("cached_depth0", cached_lookup0, scope0, "value", 200000);
measure_lookup("baseline_depth1", baseline_lookup, scope1, "value", 200000);
measure_lookup("cached_depth1", cached_lookup1, scope1, "value", 200000);
measure_lookup("baseline_depth2", baseline_lookup, scope2, "value", 200000);
measure_lookup("cached_depth2", cached_lookup2, scope2, "value", 200000);
print "LEXICAL_CACHE_SUITE|ok";
