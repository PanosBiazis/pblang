// Compare identical validated workloads with an adaptive or forced-dense plan.
let ND=import("stdlib:nd_projection.sapp");
let mode=env_get("PB_ND_BENCH");if mode==nil {mode="sparse";}
if mode!="sparse" and mode!="dense" {throw "unknown projection workload";}
let matrix=[];
for row 3 {let values=[];for col 32 {let value=0;if mode=="dense" {value=(row+col)%5-2;} else {if col==row {value=1;}}push(values,value);}push(matrix,values);}
let points=[];for i 256 {let point=[];for col 32 {push(point,i-col);}push(points,point);}
let plan=ND.compile(matrix,[1,2,3]);let sum=0;
for repeat 125 {let output=plan.project(points);sum=sum+output[255][2];}
let expected=3;for col 32 {expected=expected+matrix[2][col]*points[255][col];}
assert(sum==expected*125,"projection benchmark output parity");print sum;
