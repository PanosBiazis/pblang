// Sparse shortest-path benchmark. Graph construction happens before timing so
// the metric isolates Dijkstra traversal and priority selection.
let GRAPH = import("stdlib/graph.sapp");

let NODES = 600;
let ROUNDS = 2;
let graph = GRAPH.new(true);
let i = 0;
while i < NODES - 1 {
    GRAPH.add_edge(graph, str(i), str(i + 1), 1);
    i = i + 1;
}

fn verify(distances) {
    if distances["0"] != 0 or distances[str(NODES - 1)] != NODES - 1 {
        throw "graph shortest-path benchmark: distance mismatch";
    }
}

verify(GRAPH.dijkstra(graph, "0"));
let t0 = now_ms();
let round = 0;
while round < ROUNDS {
    verify(GRAPH.dijkstra(graph, "0"));
    round = round + 1;
}
let elapsed = now_ms() - t0;
print "GRAPH_DIJKSTRA_SPARSE|" + str(NODES) + "|" + str(ROUNDS) + "|" + str(elapsed);
