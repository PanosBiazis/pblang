// End-to-end valid CLI comparison; supply only a reviewed prior pbaudit.sapp.
let B=import("stdlib:benchmark.sapp");
let reference=env_get("PB_AUDIT_CLI_REFERENCE");
let compiler=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let mode=env_get("PB_AUDIT_CLI_MODE") ?? "ordinary";
if type(reference)!="string" or reference=="" or (mode!="ordinary" and mode!="modules") {
    throw "audit CLI benchmark requires a reviewed reference and known mode";
}
fn measure(script) {
    let args=["-k","1s","8s",compiler,script,"--allow-all","--","--project=fixture",
        "--max-files=10","--max-file-bytes=10000","--max-findings=16",
        "tests/fixtures/module_audit/tools"];
    if mode=="modules" {push(args,"--module-by-module");}
    let start=now_ms();
    let result=proc_spawn_wait("/usr/bin/timeout",args);
    let elapsed=now_ms()-start;
    if result.exit_code!=0 or result.stderr!="" or elapsed<=0 {
        throw "audit CLI benchmark result/clock failed";
    }
    return map{elapsed:elapsed,output:result.stdout};
}
let before=[];let after=[];let ratios=[];let expected=nil;
for i 10 {
    let a=nil;let b=nil;
    if i%2==0 {a=measure(reference);b=measure("tools/pbaudit.sapp");}
    else {b=measure("tools/pbaudit.sapp");a=measure(reference);}
    if expected==nil {expected=a.output;}
    if a.output!=expected or b.output!=expected {throw "audit CLI benchmark output mismatch";}
    if i>=2 {push(before,a.elapsed);push(after,b.elapsed);push(ratios,b.elapsed/a.elapsed);}
}
print json_stringify(map{mode:mode,warmup_pairs:2,retained_pairs:8,
    before_ms:before,after_ms:after,paired_ratios:ratios,
    before_stats:B.stats("before",before),after_stats:B.stats("after",after),
    ratio_stats:B.stats("ratio",ratios)});
