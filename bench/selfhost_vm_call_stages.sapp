// Long-batch call-frame benchmark for the bytecode VM written in pblang.
let TOK = import("stdlib/compiler/tokenizer.sapp");
let PAR = import("stdlib/compiler/parser.sapp");
let CG = import("stdlib/compiler/codegen.sapp");
let VM = import("stdlib/compiler/vm.sapp");

fn compile(source) { return CG.compile_stmts(PAR.parse(TOK.tokenize(source)).stmts); }

let FIB = compile("fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } print fib(14);");
let ZERO = compile("fn one() { return 1; } fn work(n) { let i = 0; let s = 0; while i < n { s = s + one(); i = i + 1; } return s; } print work(2000);");
let TWO = compile("fn add(a, b) { return a + b; } fn work(n) { let i = 0; let s = 0; while i < n { s = add(s, i); i = i + 1; } return s; } print work(2000);");

fn measure(name, chunk, expected, iterations) {
    let warm = VM.run(chunk);
    if len(warm.output) != 1 or warm.output[0] != expected { throw "VM call benchmark warmup failed: " + name; }
    let t0 = now_ms();
    let i = 0;
    while i < iterations {
        let result = VM.run(chunk);
        if len(result.output) != 1 or result.output[0] != expected { throw "VM call benchmark failed: " + name; }
        i = i + 1;
    }
    let elapsed = now_ms() - t0;
    print "VM_CALL|" + name + "|" + str(iterations) + "|" + str(elapsed)
        + "|" + str(elapsed / iterations) + "|ok";
}

print "SCHEMA|name|iterations|total_ms|average_ms|status";
measure("recursive_unary_fib14", FIB, 377, 40);
measure("zero_arg_2000", ZERO, 2000, 8);
measure("two_arg_2000", TWO, 1999000, 8);
print "VM_CALL_SUITE|ok";
