// Controlled before/after benchmark for serialization, formatting, set, and
// text-layout hot paths. Candidate and legacy paths run in the same pblang VM.
let CSV = import("stdlib/csv.sapp");
let J = import("stdlib/json.sapp");
let F = import("stdlib:format.sapp");
let S = import("stdlib:set.sapp");

fn stage(name, iterations, thunk) {
    let t0 = now_ms();
    let i = 0;
    while i < iterations { thunk(); i = i + 1; }
    let elapsed = now_ms() - t0;
    print "STDLIB_PIPELINE_PHASE|" + name + "|" + str(iterations) + "|" + str(elapsed) + "|" + str(elapsed / iterations);
}

fn legacy_csv_needs_quote(value, delimiter) {
    return str_index_of(value, delimiter) >= 0
        or str_index_of(value, "\"") >= 0
        or str_index_of(value, "\n") >= 0
        or str_index_of(value, "\r") >= 0
        or (value != "" and len(str_trim(value)) == 0);
}

fn legacy_csv_quote(value) {
    let escaped = "";
    let i = 0;
    while i < len(value) {
        let ch = str_slice(value, i, i + 1);
        if ch == "\"" { escaped = escaped + "\"\""; }
        else { escaped = escaped + ch; }
        i = i + 1;
    }
    return "\"" + escaped + "\"";
}

fn legacy_csv_encode(value, delimiter) {
    if legacy_csv_needs_quote(value, delimiter) { return legacy_csv_quote(value); }
    return value;
}

fn legacy_csv_maybe_sanitize(value, sanitize) {
    if sanitize { return CSV.sanitize_field(value); }
    return value;
}

fn legacy_csv(rows, delimiter) {
    let output = "";
    let r = 0;
    while r < len(rows) {
        let line = "";
        let c = 0;
        while c < len(rows[r]) {
            if c > 0 { line = line + delimiter; }
            let value = legacy_csv_maybe_sanitize(str(try rows[r][c] catch ""), false);
            line = line + legacy_csv_encode(value, delimiter);
            c = c + 1;
        }
        output = output + line + "\n";
        r = r + 1;
    }
    return output;
}

fn legacy_parse_line(line, delimiter) {
    let result = [];
    let field = "";
    let i = 0;
    while i < len(line) {
        let ch = str_slice(line, i, i + 1);
        if ch == "\"" {
            i = i + 1;
            let in_q = true;
            while i < len(line) and in_q == true {
                let c2 = str_slice(line, i, i + 1);
                if c2 == "\"" {
                    if str_slice(line, i + 1, i + 2) == "\"" {
                        field = field + "\"";
                        i = i + 2;
                    } else {
                        in_q = false;
                        i = i + 1;
                    }
                } else {
                    field = field + c2;
                    i = i + 1;
                }
            }
        } else if ch == delimiter {
            array_push(result, field);
            field = "";
            i = i + 1;
        } else {
            field = field + ch;
            i = i + 1;
        }
    }
    array_push(result, field);
    return result;
}

fn legacy_split_records(text) {
    let records = [];
    let record = "";
    let i = 0;
    while i < len(text) {
        let ch = str_slice(text, i, i + 1);
        if ch == "\n" {
            array_push(records, record);
            record = "";
        } else {
            record = record + ch;
        }
        i = i + 1;
    }
    if len(record) > 0 { array_push(records, record); }
    return records;
}

fn legacy_json_lines(rows) {
    let out = "";
    let i = 0;
    while i < len(rows) {
        out = out + json_stringify(rows[i]);
        if i < len(rows) - 1 { out = out + "\n"; }
        i = i + 1;
    }
    return out;
}

fn legacy_table(rows) {
    let ncols = len(rows[0]);
    let widths = [];
    for c in 0 to ncols - 1 { array_push(widths, 0); }
    for row in rows {
        for c in 0 to ncols - 1 {
            let n = len(str(row[c]));
            if n > widths[c] { widths[c] = n; }
        }
    }
    let sep = "+";
    for c in 0 to ncols - 1 { sep = sep + str_repeat("-", widths[c] + 2) + "+"; }
    sep = sep + "\n";
    let result = sep;
    let r = 0;
    while r < len(rows) {
        let line = "|";
        for c in 0 to ncols - 1 {
            line = line + " " + str_pad_right(str(rows[r][c]), widths[c], " ") + " |";
        }
        result = result + line + "\n";
        if r == 0 { result = result + sep; }
        r = r + 1;
    }
    return result + sep;
}

fn legacy_union(a, b) {
    let r = S.clone(a);
    for v in S.to_array(b) { S.add(r, v); }
    return r;
}

let CSV_ROWS = [];
for r in 0 to 499 {
    let row = [];
    for c in 0 to 11 { array_push(row, "r" + str(r) + "c" + str(c) + "\"value"); }
    array_push(CSV_ROWS, row);
}
let CSV_EXPECTED = legacy_csv(CSV_ROWS, ",");
if CSV.stringify(CSV_ROWS) != CSV_EXPECTED { throw "pipeline benchmark: CSV stringify mismatch"; }
let SPLIT_ROWS = [];
for r in 0 to 39 {
    let row = [];
    for c in 0 to 11 { array_push(row, "plain-r" + str(r) + "-c" + str(c)); }
    array_push(SPLIT_ROWS, row);
}
let SPLIT_TEXT = legacy_csv(SPLIT_ROWS, ",");
if len(CSV.split_records(SPLIT_TEXT)) != len(legacy_split_records(SPLIT_TEXT)) {
    throw "pipeline benchmark: CSV record split mismatch";
}

let LONG_FIELDS = [];
for i in 0 to 399 { array_push(LONG_FIELDS, "field" + str(i) + "abcdefghijklmnop"); }
let LONG_LINE = str_join(LONG_FIELDS, ",");
let PARSED_LEGACY = legacy_parse_line(LONG_LINE, ",");
let PARSED_FAST = CSV.parse_line(LONG_LINE, ",");
if len(PARSED_FAST) != len(PARSED_LEGACY) or PARSED_FAST[399] != PARSED_LEGACY[399] {
    throw "pipeline benchmark: CSV parse_line mismatch";
}

let JSON_ROWS = [];
for i in 0 to 1499 { array_push(JSON_ROWS, map{ id: i, name: "item-" + str(i), active: true }); }
let JSON_EXPECTED = legacy_json_lines(JSON_ROWS);
if J.stringify_lines(JSON_ROWS) != JSON_EXPECTED { throw "pipeline benchmark: JSON Lines mismatch"; }

let TABLE_ROWS = [];
for r in 0 to 1999 {
    let row = [];
    for c in 0 to 9 { array_push(row, "cell-" + str(r) + "-" + str(c)); }
    array_push(TABLE_ROWS, row);
}
let TABLE_EXPECTED = legacy_table(TABLE_ROWS);
if F.table(TABLE_ROWS) != TABLE_EXPECTED { throw "pipeline benchmark: table mismatch"; }

let SET_A = S.new();
let SET_B = S.new();
for i in 0 to 2999 { S.add(SET_A, i); }
for i in 1500 to 4499 { S.add(SET_B, i); }
if S.size(legacy_union(SET_A, SET_B)) != S.size(S.union(SET_A, SET_B)) {
    throw "pipeline benchmark: set union mismatch";
}

stage("legacy_csv_stringify_6000_quoted_cells", 2, fn() { legacy_csv(CSV_ROWS, ","); });
stage("optimized_csv_stringify_6000_quoted_cells", 4, fn() { CSV.stringify(CSV_ROWS); });
stage("legacy_csv_parse_line_400_fields", 4, fn() { legacy_parse_line(LONG_LINE, ","); });
stage("chunked_csv_parse_line_400_fields", 4, fn() { CSV.parse_line(LONG_LINE, ","); });
stage("legacy_csv_split_records_40", 1, fn() { legacy_split_records(SPLIT_TEXT); });
stage("native_csv_split_records_40", 4, fn() { CSV.split_records(SPLIT_TEXT); });
stage("legacy_json_lines_1500", 2, fn() { legacy_json_lines(JSON_ROWS); });
stage("chunked_json_lines_1500", 4, fn() { J.stringify_lines(JSON_ROWS); });
stage("legacy_ascii_table_20000_cells", 2, fn() { legacy_table(TABLE_ROWS); });
stage("hybrid_ascii_table_20000_cells", 4, fn() { F.table(TABLE_ROWS); });
stage("legacy_set_union_3000x3000", 4, fn() { legacy_union(SET_A, SET_B); });
stage("direct_set_union_3000x3000", 4, fn() { S.union(SET_A, SET_B); });
print "STDLIB_PIPELINE_HOTPATH_SUITE|ok";
