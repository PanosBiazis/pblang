// One complete loopback transfer; includes native allocation/copying and search.
let TCP=import("stdlib:native_tcp.sapp");
let Net=import("stdlib:net.sapp");
if platform()!="linux" or not TCP.available().ok {throw "native TCP benchmark requires tested Linux boundary";}
let size=131072;let payload=str_repeat("x",size)+"\r\n\r\n";
let listener=TCP.listen_ipv4("127.0.0.1",0,4);assert(listener.ok,"listener");
let done=channel();let worker=spawn(fn(){let peer=Net.connect("127.0.0.1:"+str(listener.port));tcp_write(peer,payload);tcp_close(peer);send(done.sender,true);});
let peer=TCP.accept_bounded(listener,1000);assert(peer.ok,"peer");
let result=TCP.read_until(peer,"\r\n\r\n",size+4,60000);
TCP.close(peer);TCP.close(listener);recv_timeout(done.receiver,2000);join(worker);
assert(result.ok and result.text==payload,"complete exact payload");print result.count;
