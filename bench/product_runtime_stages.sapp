let RUNTIME = import("stdlib:product_runtime.sapp");

fn stage(name, iterations, thunk) {
    let t0 = now_ms();
    let i = 0;
    while i < iterations { thunk(); i = i + 1; }
    let elapsed = now_ms() - t0;
    print "PRODUCT_RUNTIME_PHASE|" + name + "|" + str(iterations) + "|" +
          str(elapsed) + "|" + str(elapsed / iterations);
}

let detailed = RUNTIME.runtime("pb-mcp-server", "request");
stage("detailed_admit_release", 2000, fn() {
    let a = RUNTIME.admit(detailed, map{ items: 1, workers: 1 });
    if not a.accepted { throw "detailed admission rejected"; }
    if not RUNTIME.release(detailed, map{ items: 1, workers: 1 }) { throw "detailed release failed"; }
});

let hot = RUNTIME.runtime("pb-mcp-server", "request");
stage("fast_admit_release", 2000, fn() {
    if not RUNTIME.try_admit(hot, map{ items: 1, workers: 1 }) { throw "fast admission rejected"; }
    if not RUNTIME.release(hot, map{ items: 1, workers: 1 }) { throw "fast release failed"; }
});

assert(len(map_keys(RUNTIME.snapshot(hot).usage)) > 0, "benchmark exercised runtime ledger");
print "PRODUCT_RUNTIME_SUITE|ok";
