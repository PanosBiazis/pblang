// Correctness-gated benchmark for policy, routing, FFI decisions, and bounded CPU execution.

let CP = import("stdlib:compute.sapp");
let FU = import("stdlib:ffi_universal.sapp");
let PP = import("stdlib:polyglot_policy.sapp");

let CPU_ONLY = [
    map{ kind: "cpu", present: true, usable: true, available: true, units: 8, weight: 8 },
    map{ kind: "gpu", present: true, usable: false, available: false, units: 1, weight: 0 },
];

fn stage(name, rounds, body) {
    let checksum = 0;
    let start = now_ms();
    let i = 0;
    while i < rounds { checksum = checksum + body(i); i = i + 1; }
    let elapsed = now_ms() - start;
    if checksum <= 0 { throw "controlled execution benchmark checksum failed: " + name; }
    print "CONTROLLED_PHASE|" + name + "|" + str(rounds) + "|" + str(elapsed)
        + "|" + str(elapsed / rounds) + "|" + str(checksum);
}

let auto_policy = CP.policy(map{ max_workers: 4, min_parallel_items: 32 });
stage("cheap_cpu_serial_route", 20000, fn(_i) {
    let route = CP.select_device(128, CPU_ONLY, auto_policy);
    return if route.ok and route.device == "cpu" and route.mode == "sequential" { 1 } else { 0 };
});

let heavy_policy = CP.policy(map{
    max_workers: 4, min_parallel_items: 1, work_units_per_item: 4096,
});
stage("heavy_cpu_parallel_route", 20000, fn(_i) {
    let route = CP.select_device(128, CPU_ONLY, heavy_policy);
    return if route.ok and route.device == "cpu" and route.mode == "parallel" and route.workers == 4 { 1 } else { 0 };
});

let gpu_policy = CP.policy(map{
    preferred_device: "gpu", workload: "tensor", min_accelerator_items: 1,
    fallback_to_cpu: true, max_workers: 4,
});
stage("gpu_fallback_plan", 20000, fn(_i) {
    let route = CP.select_device(128, CPU_ONLY, gpu_policy);
    return if route.ok and route.device == "cpu" and route.fallback_used { 1 } else { 0 };
});

let ffi_cfg = FU.ffi_policy(["/opt/pblang/libmath.so"], ["add_i64"], map{ max_args: 2 });
stage("ffi_decision_pair", 20000, fn(_i) {
    let good = FU.decide_call(ffi_cfg, "add_i64", [1, 2], ["i64", "i64"], "i64");
    let bad = FU.decide_call(ffi_cfg, "system", ["id"], ["str"], "i64");
    return if good.allowed and not bad.allowed { 1 } else { 0 };
});

stage("polyglot_bounded_report", 2000, fn(_i) {
    let r = PP.report("python", "eval(payload)");
    return if not r.ran and not r.safe and len(r.findings) > 0 { 1 } else { 0 };
});

let values = [];
let i = 0;
while i < 128 { array_push(values, i); i = i + 1; }
let t0 = now_ms();
let computed = CP.run_controlled(values, fn(x) { return x + 1; }, map{
    devices: CPU_ONLY, max_workers: 4, min_parallel_items: 1,
});
let elapsed = now_ms() - t0;
if not computed.ok or len(computed.results) != 128 or computed.results[0] != 1 or computed.results[127] != 128 {
    throw "controlled execution benchmark parallel result mismatch";
}
print "CONTROLLED_PHASE|bounded_parallel_map|1|" + str(elapsed) + "|" + str(elapsed) + "|128";
print "CONTROLLED_EXECUTION_SUITE|ok";
