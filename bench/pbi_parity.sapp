//
// bench/pbi_parity.sapp — Pure-PBLang Self-Hosted Interpreter Parity Suite
//
// Replaces bench/pbi_parity.sh. Verifies that `tools/pbi.sapp` produces byte-identical
// output to the host VM across all 25 language parity programs.

fn _find_pb(root: string) {
    let env_b = env_get("PB");
    if env_b != nil and env_b != "" and fs_exists(env_b) { return env_b; }
    if fs_exists(root + "/pblang") { return root + "/pblang"; }
    if fs_exists(root + "/target/release/pblang") { return root + "/target/release/pblang"; }
    return "pblang";
}

let root = cwd();
let pb = _find_pb(root);
let work = "/tmp/pb_pbi_parity_" + str(num_floor(now_ms()));
fs_mkdirs(work);
let prog_file = work + "/p.sapp";

let passed = 0;
let failed = 0;

let check_case = fn(label: string, prog: string) {
    fs_write(prog_file, prog + "\n");
    let vm_res = proc_spawn_wait(pb, ["run", prog_file, "--allow-all"]);
    let pi_res = proc_spawn_wait(pb, ["run", "tools/pbi.sapp", "--allow-all", "--", prog_file]);
    let vm_out = str_trim(str(vm_res.stdout));
    let pi_out = str_trim(str(pi_res.stdout));
    if vm_out == pi_out and vm_out != "" {
        passed = passed + 1;
    } else {
        println("FAIL [" + label + "]:");
        println("   VM : " + str_replace_all(vm_out, "\n", "|"));
        println("   pbi: " + str_replace_all(pi_out, "\n", "|"));
        failed = failed + 1;
    }
};

check_case("arithmetic precedence", "print 2 + 3 * 4 - 1;");
check_case("recursion (fib)", "fn fib(n){ if n<2 { return n; } return fib(n-1)+fib(n-2); } print fib(16);");
check_case("while + modulo", "let n=0; let s=0; while n<30 { if n%4==0 { s=s+n; } n=n+1; } print s;");
check_case("for count", "let s=0; for i 6 { s=s+i*i; } print s;");
check_case("for range inclusive", "let s=0; for i in 3 to 7 { s=s+i; } print s;");
check_case("break / continue", "let s=0; for i 20 { if i==10 { break; } if i%2==0 { continue; } s=s+i; } print s;");
check_case("closures (curry)", "fn add(a){ return fn(b){ return a+b; }; } let f=add(40); print f(2)+f(0);");
check_case("arrays index + sum", "let a=[5,10,15,20]; let t=0; let i=0; while i<len(a) { t=t+a[i]; i=i+1; } print t;");
check_case("array push + pop", "let a=[]; push(a,3); push(a,4); push(a,5); let x=pop(a); print x + len(a);");
check_case("array write", "let a=[1,2,3]; a[1]=99; print a[0]+a[1]+a[2];");
check_case("maps + map_keys", "let m=map{x:1,y:2,z:3}; let s=0; for k in map_keys(m) { s=s+m[k]; } print s;");
check_case("map member + insert", "let m=map{a:10}; m.b=20; print m.a+m.b;");
check_case("map_has", "let m=map{k:1}; if map_has(m,\"k\") { print 1; } else { print 0; }");
check_case("strings + equality", "let s=\"cat\"; if s==\"cat\" { print 1; } else { print 0; } if s!=\"dog\" { print 2; }");
check_case("str_split + for-in", "let w=str_split(\"a,bb,ccc\",\",\"); let t=0; for p in w { t=t+len(p); } print t;");
check_case("str_slice + charcode", "let s=\"pblang\"; print str_slice(s,0,2); print strcharcodeat(s,0);");
check_case("parse_number", "print parse_number(\"123\") + parse_number(\"77\");");
check_case("mixed print (num+str)", "fn f(b){ if b { return \"yes\"; } return 7; } print f(1); print f(0);");
check_case("nested data", "let g=map{n:\"pb\",xs:[1,2,3]}; let t=0; for v in g.xs { t=t+v; } print g.n; print t;");
check_case("compound assign", "let x=5; x+=3; x-=1; x*=4; print x;");
check_case("compound in loop", "let s=0; let i=0; while i<6 { s+=i*i; i+=1; } print s;");
check_case("str builtins", "print str_trim(\"  hi  \"); if str_starts_with(\"pblang\",\"pb\") { print 1; } print str_replace_all(\"a.b.c\",\".\",\"-\");");
check_case("power operator", "print 2 ** 10; print 3 ** 5;");
check_case("for k,v in map", "let m=map{a:1,b:2,c:3}; let s=0; for k, v in m { s+=v; } print s;");
check_case("for + continue", "let s=0; for i 8 { if i%2==0 { continue; } s+=i; } print s;");

try fs_remove(prog_file) catch nil;
try fs_remove(work) catch nil;

let suffix = if failed > 0 { " (" + str(failed) + " FAILED)" } else { "" };
println("pbi_parity: " + str(passed) + "/" + str(passed + failed) + " passed" + suffix);
if failed > 0 { os_exit(1); }
