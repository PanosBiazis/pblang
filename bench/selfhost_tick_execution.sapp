// Compile once and execute the unchanged try/catch workload ten times.
// This reduces the share of frontend cost without removing it from process timing.
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let args=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");
assert(len(args)==2,"expected plain|bounded success|failed");
assert(args[0]=="plain" or args[0]=="bounded","execution mode");
assert(args[1]=="success" or args[1]=="failed","workload");
let body="let x=n+1;x";
let want=500500;
if args[1]=="failed" {body="let x=n+1;throw 1;x";want=501500;}
let source="fn f(n){return try {"+body+"} catch {let y=n+2;y};}"
    +"let total=0;for i 1000 {total=total+f(i);}print total;";
let compiled=F.frontend_compile(source);assert(compiled.ok,"compile");
let repetitions=0;
while repetitions<10 {
    let result=nil;
    if args[0]=="plain" {result=V.run(compiled.chunk);}
    else {result=V.run_bounded(compiled.chunk,map{max_steps:10000000});}
    assert(result.output==[want],"before/after result parity");
    repetitions=repetitions+1;
}
print "ten executions verified";
