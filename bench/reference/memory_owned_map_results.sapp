// Benchmark-only pre-optimization reference; not a supported library entrypoint.
// Optional scalar-owner callback cleanup for retained and PBLang VMs.
// Import only when needed; ordinary memory.sapp users do not load these helpers.
// Callbacks are trusted, synchronous and must keep scalar values/replacements.
// Public numeric handles/raw builtins do not provide callback isolation.

// Run one callback with a checked borrow-lifetime boundary. Depth checks avoid
// popping the caller's scope after an unbalanced callback; token equality detects
// replacement of our scope. Mismatched scopes are reported, never auto-repaired.
fn _box_callback(handle, body_fn) {
    let depth = memory_stats().lifetime_depth;
    let token = push_lifetime();
    let outcome = try map{ok:true, value:body_fn(handle)} catch map{ok:false, value:nil};
    let scope_ok = false;
    if memory_stats().lifetime_depth == depth + 1 {
        let popped = try pop_lifetime() catch 0;
        scope_ok = popped == token and memory_stats().lifetime_depth == depth;
    }
    return map{ok:outcome.ok, value:outcome.value, scope_ok:scope_ok};
}

fn _free_box(handle) { memory_free(handle); return true; }

fn _with_box_result(value, mutable, body_fn) {
    // Match the self-host engine's scalar-only contract. Native composite alias
    // bookkeeping is not yet transactional; this helper does not certify it.
    let kind = type(value);
    if kind != "number" and kind != "string" and kind != "bool" and kind != "nil" {
        return map{ok:false, value:nil, error:"memory: owned callbacks require scalar values",
            allocation_ok:false, body_ok:false, cleanup_ok:true};
    }
    // Keep the owner outside the borrow scope; free it after scoped borrows close.
    let allocation = try map{ok:true, handle:memory_alloc(value, mutable)} catch map{ok:false};
    if not allocation.ok {
        return map{ok:false, value:nil, error:"memory: allocation failed",
            allocation_ok:false, body_ok:false, cleanup_ok:true};
    }
    let body = try _box_callback(allocation.handle, body_fn)
        catch map{ok:false, value:nil, scope_ok:false};
    let freed = try _free_box(allocation.handle) catch false;
    let clean = body.scope_ok and freed;
    if not clean {
        return map{ok:false, value:nil, error:"memory: owned callback cleanup failed",
            allocation_ok:true, body_ok:body.ok, cleanup_ok:false};
    }
    if not body.ok {
        return map{ok:false, value:nil, error:"memory: owned callback failed",
            allocation_ok:true, body_ok:false, cleanup_ok:true};
    }
    return map{ok:true, value:body.value, error:nil,
        allocation_ok:true, body_ok:true, cleanup_ok:true};
}

// Opt-in automatic cleanup of exactly this helper's owner. The callback receives
// its handle; arbitrary allocations made by the callback remain its responsibility.
fn with_box_result(value, body_fn) { return _with_box_result(value, true, body_fn); }
fn with_box_immutable_result(value, body_fn) { return _with_box_result(value, false, body_fn); }
fn with_box(value, body_fn) {
    let outcome = with_box_result(value, body_fn);
    if not outcome.ok { throw outcome.error; }
    return outcome.value;
}
fn with_box_immutable(value, body_fn) {
    let outcome = with_box_immutable_result(value, body_fn);
    if not outcome.ok { throw outcome.error; }
    return outcome.value;
}

export with_box, with_box_result, with_box_immutable, with_box_immutable_result;
