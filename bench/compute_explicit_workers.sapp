let CP = import("stdlib:compute.sapp");
let OS = import("stdlib:os.sapp");
let args = OS.script_args();
let mode = if len(args) > 0 { args[0] } else { "compute" };
let rounds = if len(args) > 1 { parse_number(args[1]) } else { 1000 };
assert(mode == "compute" or mode == "storage", "benchmark mode");
assert(rounds >= 1 and rounds <= 100000 and rounds == num_floor(rounds), "benchmark rounds");
let i = 0;
let checksum = 0;
while i < rounds {
    if mode == "compute" {
        let result = CP.run_controlled([2, 3, 4, 5], fn(x) { return x * x; }, map{
            preferred_device: "cpu", devices: [], max_workers: 1,
        });
        assert(result.ok and result.results == [4, 9, 16, 25], "compute parity");
        checksum = checksum + result.results[3];
    } else {
        let result = CP.storage_read_controlled([], map{ max_workers: 1 });
        assert(result.results == [] and result.workers == 0, "empty storage parity");
        checksum = checksum + 1;
    }
    i = i + 1;
}
print "COMPUTE_WORKERS|" + mode + "|" + str(rounds) + "|" + str(checksum);
