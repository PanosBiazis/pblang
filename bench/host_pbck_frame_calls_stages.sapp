// Correctness-gated flat call-frame versus generic PBCK VM benchmark.
let Plan = import("stdlib:host_pbck_frame_plan.sapp");
let Calls = import("stdlib:host_pbck_frame_calls.sapp");
let VM = import("stdlib:host_pbck_vm.sapp");

let add = map{
    __pbck_function: true, name: "add", arity: 1, min_arity: 1,
    defaults: [], is_vararg: false, parameter_types: [],
    chunk: map{ instructions: [
        map{ op: 28, operand: 0 }, map{ op: 25, operand: 0 }, map{ op: 1 },
        map{ op: 29, operand: 0 }, map{ op: 28, operand: 0 }, map{ op: 33 }
    ], constants: [] }
};
let artifact = map{
    format: "host-pbck-v1", version: 1,
    chunk: map{ instructions: [
        map{ op: 0, operand: 0 },
        map{ op: 27, fn_const: 1, captures: [map{ is_local: true, index: 0 }] },
        map{ op: 25, operand: 1 }, map{ op: 0, operand: 2 }, map{ op: 31, operand: 1 }, map{ op: 11 },
        map{ op: 25, operand: 1 }, map{ op: 0, operand: 3 }, map{ op: 32, operand: 1 }
    ], constants: [40, add, 1, 1] }
};

fn sorted(values) {
    let out = []; let i = 0;
    while i < len(values) { array_push(out, values[i]); i = i + 1; }
    i = 1;
    while i < len(out) {
        let value = out[i]; let j = i - 1;
        while j >= 0 and out[j] > value { out[j + 1] = out[j]; j = j - 1; }
        out[j + 1] = value; i = i + 1;
    }
    return out;
}

let plan = Plan.build_decoded(artifact);
let prepared = Calls.prepare(plan);
if Calls.run_prepared(prepared, 0, [], map{ require_i32: true }).value != 42
    or VM.run_decoded(artifact).value != 42 {
    throw "host PBCK call-frame benchmark correctness gate failed";
}
let verify_started = now_ms();
let verified = Calls.verify_i32_prepared(prepared, 0, [], map{ max_steps: 1000 });
let verify_ms = now_ms() - verify_started;
if verified.value != 42 or verified.reachable_function_count != 2
    or verified.reachable_instructions != 15 or verified.captures != 1 {
    throw "host PBCK verified graph benchmark gate failed";
}

let ITERATIONS = 500;
let SAMPLES = 9;
let flat_samples = []; let vm_samples = [];
let sample = 0;
while sample < SAMPLES {
    let started = now_ms(); let i = 0; let checksum = 0;
    while i < ITERATIONS {
        checksum = checksum + Calls.run_prepared(prepared, 0, [], map{ require_i32: true }).value;
        i = i + 1;
    }
    if checksum != ITERATIONS * 42 { throw "flat call-frame checksum mismatch"; }
    array_push(flat_samples, now_ms() - started);

    started = now_ms(); i = 0; checksum = 0;
    while i < ITERATIONS {
        checksum = checksum + VM.run_decoded(artifact).value;
        i = i + 1;
    }
    if checksum != ITERATIONS * 42 { throw "generic VM checksum mismatch"; }
    array_push(vm_samples, now_ms() - started);
    sample = sample + 1;
}

let flat = sorted(flat_samples); let vm = sorted(vm_samples);
let middle = num_floor(SAMPLES / 2);
print "HOST_PBCK_FRAME_CALLS|stage=verify_i32_graph|functions="
    + str(verified.reachable_function_count) + "|instructions="
    + str(verified.reachable_instructions) + "|captures=" + str(verified.captures)
    + "|elapsed_ms=" + str(verify_ms);
print "HOST_PBCK_FRAME_CALLS|stage=prepared_flat_calls|iterations=" + str(ITERATIONS)
    + "|samples=" + str(SAMPLES) + "|median_ms=" + str(flat[middle])
    + "|p95_ms=" + str(flat[SAMPLES - 1])
    + "|median_per_run_ms=" + str(flat[middle] / ITERATIONS);
print "HOST_PBCK_FRAME_CALLS|stage=generic_vm|iterations=" + str(ITERATIONS)
    + "|samples=" + str(SAMPLES) + "|median_ms=" + str(vm[middle])
    + "|p95_ms=" + str(vm[SAMPLES - 1])
    + "|median_per_run_ms=" + str(vm[middle] / ITERATIONS);
