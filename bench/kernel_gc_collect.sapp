// pblang:target=kernel
// pblang:extern heap_init heap_alloc gc_new gc_set_auto gc_set_threshold gc_collections gc_live gc_set_child gc_add_root gc_remove_root gc_alloc kernel_gc_collect
// Kernel-only, identical before/after workload within the old table capacities.
// Prepend heap.sapp and the selected gc.sapp; success is QEMU exit code 85.
fn kmain() {
    let h = kmalloc(8); let region = kmalloc(131072); heap_init(h, region, 131072);
    let g = gc_new(h); gc_set_auto(g, 0);
    let first = gc_alloc(g, 1); let prev = first; let i = 1;
    while i < 128 { let next = gc_alloc(g, 1); gc_set_child(prev, 0, next); prev = next; i = i + 1; }
    gc_set_child(prev, 0, first); gc_add_root(g, first);
    i = 0; while i < 50000 { kernel_gc_collect(g); i = i + 1; }
    if gc_live(g) != 128 or gc_collections(g) != 50000 { outb(244, 1); }
    else { outb(244, 42); }
    while 1 > 0 { hlt(); }
}
