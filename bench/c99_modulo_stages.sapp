// Paired runtime benchmark for default f64-compatible and explicit integer C99 profiles.
let C99 = import("stdlib/compiler/ctranspile.sapp");
let BENCH = import("stdlib/benchmark.sapp");
let UUID = import("stdlib/uuid.sapp");

let SOURCE = "let s = 0; let i = 0; while i < 1000000 { s = (s + (i % 1000) * 17 + 3) % 1000003; i = i + 1; } print s;";
let EXPECTED = "474518";

fn samples(name, executable, repetitions) {
    let values = []; let i = 0;
    let warm = proc_spawn_wait(executable, []);
    if warm.exit_code != 0 or str_trim(warm.stdout) != EXPECTED { throw "C99 modulo warmup mismatch: " + name; }
    while i < repetitions {
        let t0 = now_ms(); let result = proc_spawn_wait(executable, []); let elapsed = now_ms() - t0;
        if result.exit_code != 0 or str_trim(result.stdout) != EXPECTED { throw "C99 modulo result mismatch: " + name; }
        push(values, elapsed); i = i + 1;
    }
    let stats = BENCH.stats(name, values);
    print "C99_MOD_STAGE|" + name + "|" + str(stats.median_ms) + "|" + str(stats.p95_ms) + "|" + str(values);
}

let cc = C99.find_c_compiler();
if cc == nil { print "C99_MOD_SUITE|skip|no-c-compiler"; }
else {
    let root = "/tmp/pblang_c99_mod_" + UUID.v4();
    let fp = C99.build_program(SOURCE, root + "_float", map{ profile: "speed", numeric: "float", compiler: cc });
    let ip = C99.build_program(SOURCE, root + "_integer", map{ profile: "speed", numeric: "integer", compiler: cc });
    if not fp.ok or not ip.ok { throw "C99 modulo profile build failed"; }
    print "C99_MOD_SCHEMA|profile|median_ms|p95_ms|samples_ms";
    print "C99_MOD_ARTIFACT|float|" + str(fp.artifact_bytes) + "|integer|" + str(ip.artifact_bytes);
    samples("float", fp.output, 19);
    samples("integer", ip.output, 19);
    try fs_remove(fp.output) catch nil; try fs_remove(ip.output) catch nil;
    print "C99_MOD_SUITE|ok";
}
