// Args: repetitions and mixed/early/miss/long corpus. No files are opened.
let C=import("stdlib:file_catalog.sapp");
let args=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");
let repeats=parse_number(args[0]);let mode=args[1];let names=[];
if mode=="mixed" {names=["a.sapp","photo.png","x.tar.gz","main.d.ts","README","data.sqlite3","model.blend","music.flac","font.woff2","unknown.xyz"] ;}
elif mode=="early" {names=["a.sapp","x.tar.gz","a.d.ts"] ;}
elif mode=="miss" {names=["README","file.unknown",".unknown","trailing."] ;}
elif mode=="long" {names=[str_repeat("a",4000)+".sapp",str_repeat("a",4000)+".xyz"] ;}
elif mode=="dots" {names=[str_repeat(".",4094)+"py",str_repeat(".",4096)];}
elif mode=="separators" {names=[str_repeat("/",4089)+"main.py",str_repeat("/",4090)+"x.sapp"];}
elif mode=="backslashes" {names=[str_repeat("\\",4089)+"main.py",str_repeat("\\",4090)+"x.sapp"];}
elif mode=="fallback" {names=["private/"+str_repeat("a",128)+".py",str_repeat("/",4000)+str_repeat("a",90)+".py"];}
else {throw "unknown benchmark corpus";}
let checksum=0;let t=clock();
for i repeats {for name in names {let row=C.classify(name);checksum=checksum+len(row.label)+len(row.suffix);}}
print "CATALOG|"+str(clock()-t)+"|"+str(checksum);
