// Operator-selected local reference module; use only a reviewed checkout copy.
// Timings never serialize its path or source. Alternating AB/BA order controls
// temporal drift; fixture correctness is checked outside timed loops.
let OLD=import(env_get("PB_TOKENIZER_REFERENCE"));
let NEW=import("stdlib:compiler/tokenizer.sapp");
let B=import("stdlib:benchmark.sapp");
let OLD_TAINT=import(env_get("PB_TAINT_REFERENCE"));
let NEW_TAINT=import("stdlib:security_taint.sapp");
let long=str_repeat("a",16384);
let cases=[map{name:"small-program",source:"let x=1; print x;",rounds:200},
    map{name:"mixed-program",source:"fn save(path) {fs_write(path,\"fixed\");} let requested=env_get(\"INPUT\");save(requested);",rounds:100},
    map{name:"identifier",source:long,rounds:1},
    map{name:"line-comment",source:"//"+long,rounds:1},
    map{name:"block-comment",source:"/*"+long+"*/",rounds:1},
    map{name:"decimal",source:str_repeat("1",16384),rounds:1}];
fn measure(module,source,rounds) {
    let start=now_ms();let result=nil;
    for iteration rounds {result=module.tokenize_bounded(source,65536);}
    let elapsed=now_ms()-start;
    return map{elapsed:elapsed,result:result};
}

fn measure_taint(module,source) {
    let start=now_ms();let result=nil;
    for iteration 100 {result=module.analyze(source,"fixture.sapp");}
    return map{elapsed:now_ms()-start,result:result};
}
let taint_source=cases[1].source;
let expected=json_stringify(OLD_TAINT.analyze(taint_source,"fixture.sapp"));
let before=[];let after=[];let ratios=[];
for iteration 14 {
    let a=nil;let b=nil;
    if num_mod(iteration,2)==0 {a=measure_taint(OLD_TAINT,taint_source);b=measure_taint(NEW_TAINT,taint_source);}
    else {b=measure_taint(NEW_TAINT,taint_source);a=measure_taint(OLD_TAINT,taint_source);}
    if json_stringify(a.result)!=expected or json_stringify(b.result)!=expected {throw "paired taint semantic mismatch";}
    if iteration>=2 {push(before,a.elapsed);push(after,b.elapsed);push(ratios,b.elapsed/a.elapsed);}
}
print json_stringify(map{operation:"taint-analyze",rounds:100,before_ms:before,after_ms:after,
    before_stats:B.stats("taint-analyze",before),after_stats:B.stats("taint-analyze",after),
    paired_ratios:ratios,ratio_stats:B.stats("candidate/reference",ratios)});
for item in cases {
    let expected=json_stringify(OLD.tokenize_bounded(item.source,65536));
    let before=[];let after=[];let ratios=[];
    for iteration 14 {
        let a=nil;let b=nil;
        if num_mod(iteration,2)==0 {a=measure(OLD,item.source,item.rounds);b=measure(NEW,item.source,item.rounds);}
        else {b=measure(NEW,item.source,item.rounds);a=measure(OLD,item.source,item.rounds);}
        if json_stringify(a.result)!=expected or json_stringify(b.result)!=expected {throw "paired tokenizer semantic mismatch";}
        if iteration>=2 {push(before,a.elapsed);push(after,b.elapsed);push(ratios,b.elapsed/a.elapsed);}
    }
    print json_stringify(map{operation:item.name,rounds:item.rounds,before_ms:before,after_ms:after,
        before_stats:B.stats(item.name,before),after_stats:B.stats(item.name,after),
        paired_ratios:ratios,ratio_stats:B.stats("candidate/reference",ratios)});
}
