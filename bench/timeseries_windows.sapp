let Old=import("./fixtures/timeseries_before_windows.sapp");let T=import("stdlib:timeseries.sapp");
fn naive_extreme(a,w,maximum){let out=[];let i=0;while i+w<=len(a){let v=a[i];let j=1;
 while j<w {if (maximum and a[i+j]>v) or (not maximum and a[i+j]<v){v=a[i+j];}j=j+1;}
 push(out,v);i=i+1;}return out;}
fn elapsed(call,a,w){let start=clock();call(a,w);return (clock()-start)*1000;}
let results=[];
for n in [128,1024] {
 for kind in ["integer","decimal"] {
  let a=[];for i n {let v=(i*17)%101-50;if kind=="decimal" {v=v/10;}push(a,v);}
  for w in [1,8,64] {
   let ops=[map{name:"rolling_sum",before:Old.rolling_sum,after:T.rolling_sum},map{name:"sma",before:Old.sma,after:T.sma}];
   if kind=="integer" {
    push(ops,map{name:"rolling_min_vs_naive",before:fn(a,w){return naive_extreme(a,w,false);},after:T.rolling_min});
    push(ops,map{name:"rolling_max_vs_naive",before:fn(a,w){return naive_extreme(a,w,true);},after:T.rolling_max});
   }
   for op in ops {
    assert(op.before(a,w)==op.after(a,w),"full result parity");
    for _warmup 2 {op.before(a,w);op.after(a,w);}
    let before=[];let after=[];
    for sample 7 {
     if sample%2==0 {push(before,elapsed(op.before,a,w));push(after,elapsed(op.after,a,w));}
     else {push(after,elapsed(op.after,a,w));push(before,elapsed(op.before,a,w));}
    }
    push(results,map{operation:op.name,kind:kind,size:n,window:w,before_ms:before,after_ms:after});
   }
  }
 }
}
print json_stringify(map{samples:7,warmups:2,calls_per_sample:1,results:results});
