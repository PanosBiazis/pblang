// Correctness-gated comparison of one-time scalar preparation, prepared flat
// execution, and the generic recursive PBCK VM on the same 100-iteration sum.
let Plan = import("stdlib:host_pbck_frame_plan.sapp");
let Scalar = import("stdlib:host_pbck_frame_scalar.sapp");
let VM = import("stdlib:host_pbck_vm.sapp");

let artifact = map{
    format: "host-pbck-v1", version: 1,
    chunk: map{ instructions: [
        map{ op: 0, operand: 0 }, map{ op: 26, operand: 0 },
        map{ op: 0, operand: 1 }, map{ op: 26, operand: 1 },
        map{ op: 0, operand: 3 }, map{ op: 11 },
        map{ op: 25, operand: 0 }, map{ op: 25, operand: 1 },
        map{ op: 1 }, map{ op: 26, operand: 0 },
        map{ op: 25, operand: 1 }, map{ op: 0, operand: 1 },
        map{ op: 1 }, map{ op: 26, operand: 1 },
        map{ op: 25, operand: 1 }, map{ op: 0, operand: 2 },
        map{ op: 10 }, map{ op: 37, operand: 5 }, map{ op: 11 },
        map{ op: 25, operand: 0 }, map{ op: 33 }
    ], constants: [0, 1, 100, true], source_name: nil }
};

fn sorted(values) {
    let out = []; let i = 0;
    while i < len(values) { array_push(out, values[i]); i = i + 1; }
    i = 1;
    while i < len(out) {
        let value = out[i]; let j = i - 1;
        while j >= 0 and out[j] > value { out[j + 1] = out[j]; j = j - 1; }
        out[j + 1] = value; i = i + 1;
    }
    return out;
}

let plan = Plan.build_decoded(artifact);
let prepared = Scalar.prepare(plan);
if Scalar.run_prepared(prepared).value != 5050 or VM.run_decoded(artifact).value != 5050 {
    throw "host PBCK scalar benchmark correctness gate failed";
}

let PREPARE_ITERATIONS = 500;
let RUN_ITERATIONS = 100;
let SAMPLES = 9;
let prepare_samples = []; let scalar_samples = []; let vm_samples = [];
let sample = 0;
while sample < SAMPLES {
    let started = now_ms(); let i = 0; let checksum = 0;
    while i < PREPARE_ITERATIONS {
        let next = Scalar.prepare(plan);
        checksum = checksum + next.instruction_count;
        i = i + 1;
    }
    if checksum != PREPARE_ITERATIONS * 21 { throw "scalar prepare checksum mismatch"; }
    array_push(prepare_samples, now_ms() - started);

    started = now_ms(); i = 0; checksum = 0;
    while i < RUN_ITERATIONS {
        checksum = checksum + Scalar.run_prepared(prepared).value;
        i = i + 1;
    }
    if checksum != RUN_ITERATIONS * 5050 { throw "scalar run checksum mismatch"; }
    array_push(scalar_samples, now_ms() - started);

    started = now_ms(); i = 0; checksum = 0;
    while i < RUN_ITERATIONS {
        checksum = checksum + VM.run_decoded(artifact).value;
        i = i + 1;
    }
    if checksum != RUN_ITERATIONS * 5050 { throw "full VM checksum mismatch"; }
    array_push(vm_samples, now_ms() - started);
    sample = sample + 1;
}

let prepared_ordered = sorted(prepare_samples);
let scalar_ordered = sorted(scalar_samples);
let vm_ordered = sorted(vm_samples);
let middle = num_floor(SAMPLES / 2);
print "HOST_PBCK_FRAME_SCALAR|stage=prepare"
    + "|iterations=" + str(PREPARE_ITERATIONS) + "|samples=" + str(SAMPLES)
    + "|median_ms=" + str(prepared_ordered[middle])
    + "|p95_ms=" + str(prepared_ordered[SAMPLES - 1])
    + "|median_per_run_ms=" + str(prepared_ordered[middle] / PREPARE_ITERATIONS);
print "HOST_PBCK_FRAME_SCALAR|stage=prepared_run"
    + "|iterations=" + str(RUN_ITERATIONS) + "|samples=" + str(SAMPLES)
    + "|median_ms=" + str(scalar_ordered[middle])
    + "|p95_ms=" + str(scalar_ordered[SAMPLES - 1])
    + "|median_per_run_ms=" + str(scalar_ordered[middle] / RUN_ITERATIONS);
print "HOST_PBCK_FRAME_SCALAR|stage=generic_vm"
    + "|iterations=" + str(RUN_ITERATIONS) + "|samples=" + str(SAMPLES)
    + "|median_ms=" + str(vm_ordered[middle])
    + "|p95_ms=" + str(vm_ordered[SAMPLES - 1])
    + "|median_per_run_ms=" + str(vm_ordered[middle] / RUN_ITERATIONS);
