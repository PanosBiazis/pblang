// Identical successful mutations before/after bounded growth admission.
// Call run(false) for ordinary execution, or run(true) for explicit limits.
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
fn run(bounded) {
    let compiled=F.frontend_compile("let a=[0,0];let m=map{a:0,b:0};for i 10000 {a[0]=i;m.a=i;m[\"b\"]=i;}print a[0]+m.a+m.b;");
    if not compiled.ok { throw "mutation control did not compile"; }
    for repeat 4 {
        let result=if bounded {
            V.run_bounded(compiled.chunk,map{max_value_items:8,max_steps:2000000})
        } else { V.run(compiled.chunk) };
        if result.output!=[29997] { throw "mutation control result changed"; }
    }
    print "selfhost_mutation_control_pass";
}
export run;
