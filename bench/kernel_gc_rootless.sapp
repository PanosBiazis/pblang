// pblang:target=kernel
// pblang:extern heap_init gc_new gc_set_auto gc_alloc gc_set_child gc_live gc_collections kernel_gc_collect
// Repeat the same rootless lifetime; neither metadata nor arena is reset.
// Collection remains real reclamation, not replacement of a live heap.
fn kmain() {
    let h=kmalloc(8);let region=kmalloc(65536);heap_init(h,region,65536);
    let g=gc_new(h);gc_set_auto(g,0);let pass=0;
    while pass<10000 {
        let i=0;
        while i<512 {
            let obj=gc_alloc(g,1);
            if obj==0 or gc_set_child(obj,0,obj)!=1 {outb(244,1);while 1>0 {hlt();}}
            i=i+1;
        }
        if kernel_gc_collect(g)!=0 or gc_live(g)!=0 {outb(244,1);while 1>0 {hlt();}}
        pass=pass+1;
    }
    if gc_collections(g)!=10000 {outb(244,1);} else {outb(244,42);}
    while 1>0 {hlt();}
}
