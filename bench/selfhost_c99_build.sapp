// Stable argv-driven build driver for shell benchmark orchestration.
// Run from the repository root so stdlib module resolution is deterministic.
let OS = import("stdlib/os.sapp");
let C99 = import("stdlib/compiler/ctranspile.sapp");

let args = OS.script_args();
if len(args) != 3 { throw "usage: selfhost_c99_build.sapp -- <source> <f64-output> <integer-output>"; }
let source = fs_read(args[0]);
let f64 = C99.build_program(source, args[1], map{ profile: "speed", numeric: "float" });
let integer = C99.build_program(source, args[2], map{ profile: "speed", numeric: "integer" });
if not f64.ok { throw "self-host C99 f64 build failed: " + str(try f64.stderr catch f64.error); }
if not integer.ok { throw "self-host C99 integer build failed: " + str(try integer.stderr catch integer.error); }
print "SELFHOST_C99_BUILD|ok|" + str(f64.artifact_bytes) + "|" + str(integer.artifact_bytes);
