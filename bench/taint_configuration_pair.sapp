// Reference imports execute code: supply only an operator-reviewed Git copy.
// Keep all pairs, including unfavorable results. Isolated lexer/parser timings
// are diagnostic workloads and must not be summed as an end-to-end trace.
let OLD=import(env_get("PB_TAINT_REFERENCE"));
let NEW=import("stdlib:security_taint.sapp");
let TOK=import("stdlib:compiler/tokenizer.sapp");
let PAR=import("stdlib:compiler/parser.sapp");
let B=import("stdlib:benchmark.sapp");
let source="fn save(path) {fs_write(path,\"fixed\");}\nlet requested=env_get(\"INPUT\");save(requested);";
let custom=map{taint_sources:["env_get"],taint_sanitizers:[],taint_sinks:map{
    fs_write:map{severity:"high",class:"fixture",args:[0],control_flow:true}}};
fn measure(module,source,options,rounds) {
    let started=now_ms();let result=nil;
    for i rounds {result=module.analyze(source,"fixture.sapp",options);}
    return map{elapsed:now_ms()-started,result:result};
}
for item in [map{name:"default-small",source:"let value=1;",options:nil},
    map{name:"default-full",source:source,options:nil},map{name:"custom-full",source:source,options:custom}] {
    let reference=OLD.analyze(item.source,"fixture.sapp",item.options);
    if not reference.ok or not reference.interprocedural_complete {throw "configuration benchmark control";}
    if item.name!="default-small" and (reference.passed or reference.finding_count!=1) {throw "configuration benchmark finding control";}
    let expected=json_stringify(reference);let before=[];let after=[];let ratios=[];
    for iteration 14 {
        let a=nil;let b=nil;
        if num_mod(iteration,2)==0 {a=measure(OLD,item.source,item.options,100);b=measure(NEW,item.source,item.options,100);}
        else {b=measure(NEW,item.source,item.options,100);a=measure(OLD,item.source,item.options,100);}
        if json_stringify(a.result)!=expected or json_stringify(b.result)!=expected {throw "configuration benchmark report mismatch";}
        if a.elapsed<=0 or b.elapsed<=0 {throw "configuration benchmark clock resolution";}
        if iteration>=2 {push(before,a.elapsed);push(after,b.elapsed);push(ratios,b.elapsed/a.elapsed);}
    }
    print json_stringify(map{operation:item.name,rounds:100,before_ms:before,after_ms:after,paired_ratios:ratios,
        before_stats:B.stats(item.name,before),after_stats:B.stats(item.name,after),ratio_stats:B.stats("ratio",ratios)});
}
let tokens=TOK.tokenize_bounded(source,65536);
if not tokens.ok {throw "configuration lexer control";}
for item in [map{name:"tokenize-isolated",work:fn(){return TOK.tokenize_bounded(source,65536);}},
    map{name:"parse-isolated",work:fn(){return PAR.parse(tokens.tokens);}}] {
    let expected=json_stringify(item.work());let samples=[];
    for iteration 14 {
        let result=nil;let start=now_ms();
        for i 100 {result=item.work();}
        let elapsed=now_ms()-start;
        if json_stringify(result)!=expected {throw "configuration stage result mismatch";}
        if iteration>=2 {push(samples,elapsed);}
    }
    print json_stringify(map{operation:item.name,rounds:100,samples_ms:samples,stats:B.stats(item.name,samples)});
}
// Also retain the cost of strict validation at the admitted policy boundary.
// Build fixtures after the preceding measurements, outside every timed loop.
let indexes=[];for i 32 {push(indexes,255);}
let sinks=map{};
for i 128 {sinks["sink"+str(i)]=map{severity:"high",class:str_repeat("α",128),args:indexes};}
let boundary=map{taint_sources:[],taint_sanitizers:[],taint_sinks:sinks};
let expected=json_stringify(OLD.analyze("","fixture.sapp",boundary));
let before=[];let after=[];let ratios=[];
for iteration 14 {
    let a=nil;let b=nil;
    if num_mod(iteration,2)==0 {a=measure(OLD,"",boundary,5);b=measure(NEW,"",boundary,5);}
    else {b=measure(NEW,"",boundary,5);a=measure(OLD,"",boundary,5);}
    if json_stringify(a.result)!=expected or json_stringify(b.result)!=expected {throw "boundary policy report mismatch";}
    if a.elapsed<=0 or b.elapsed<=0 {throw "boundary policy clock resolution";}
    if iteration>=2 {push(before,a.elapsed);push(after,b.elapsed);push(ratios,b.elapsed/a.elapsed);}
}
print json_stringify(map{operation:"custom-boundary",rounds:5,before_ms:before,after_ms:after,paired_ratios:ratios,
    before_stats:B.stats("custom-boundary",before),after_stats:B.stats("custom-boundary",after),ratio_stats:B.stats("ratio",ratios)});
