// Same inputs/checks before and after the additive stable-sort implementation.
let F = import("stdlib:functional.sapp");
let B = import("stdlib:benchmark.sapp");
let mode = env_get("PB_SORT_MODE") ?? "legacy";
if mode != "legacy" and mode != "stable" { throw "sort benchmark: unsupported mode"; }
let sorter = F.sort_by;
if mode == "stable" { sorter = F.stable_sort_by; }
fn compare(a,b) { return a-b; }
for size in [256,1024] {
    for shape in ["sorted","reverse","duplicates"] {
        let input = [];
        let i = 0;
        while i < size {
            let value = i;
            if shape == "reverse" { value = size-i-1; }
            if shape == "duplicates" { value = (i*37)%17; }
            push(input,value); i=i+1;
        }
        let snapshot = slice(input,0,size);
        let expected = array_sort(input);
        let samples = [];
        let iteration = 0;
        // One first run (no cache flush), two warmups, then five retained samples.
        let first_ms = 0;
        while iteration < 8 {
            let start = now_ms();
            let result = sorter(input,compare);
            let elapsed = now_ms()-start;
            if result != expected or input != snapshot { throw "sort benchmark: result or input mismatch"; }
            if iteration == 0 { first_ms = elapsed; }
            if iteration >= 3 { push(samples,elapsed); }
            iteration=iteration+1;
        }
        let calls = [0];
        let counted = sorter(input,fn(a,b){calls[0]=calls[0]+1;return a-b;});
        if counted != expected { throw "sort benchmark: counted result mismatch"; }
        print json_stringify(map{mode:mode,size:size,shape:shape,first_ms:first_ms,
            samples_ms:samples,stats:B.stats(mode,samples),comparisons:calls[0],
            checksum:F.sum(counted)});
    }
}
