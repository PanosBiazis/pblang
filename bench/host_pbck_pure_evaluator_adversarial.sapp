// Adversarial latency characterization for the local-only PBCK pure evaluator.
// The program shape and call count stay identical; only the searched text size
// changes. Results are measurements, not a wall-time security guarantee.
let Evaluator = import("stdlib:host_pbck_pure_evaluator.sapp");
let Binary = import("stdlib:host_pbck_frame_binary.sapp");
let Plan = import("stdlib:host_pbck_frame_plan.sapp");

let CALLS = 512;
let SAMPLES = 7;

fn sorted(values) {
    let out = slice(values, 0, len(values));
    let i = 1;
    while i < len(out) {
        let value = out[i]; let j = i - 1;
        while j >= 0 and out[j] > value { out[j + 1] = out[j]; j = j - 1; }
        out[j + 1] = value; i = i + 1;
    }
    return out;
}

fn asset(text) {
    let constants = ["str_contains", text, "not-present"];
    let instructions = []; let i = 0;
    while i < CALLS {
        array_push(instructions, map{ op: 14, operand: 0 });
        array_push(instructions, map{ op: 0, operand: 1 });
        array_push(instructions, map{ op: 0, operand: 2 });
        array_push(instructions, map{ op: 31, operand: 2 });
        if i + 1 < CALLS { array_push(instructions, map{ op: 11 }); }
        i = i + 1;
    }
    array_push(instructions, map{ op: 33 });
    let decoded = map{ format: "host-pbck-v1", version: 1,
        chunk: map{ instructions: instructions, constants: constants, source_name: nil } };
    return Binary.encode_plan(Plan.build_decoded(decoded));
}

fn request(bytes) { return map{
    format: Evaluator.REQUEST_FORMAT,
    schema_version: Evaluator.SCHEMA_VERSION,
    asset_bytes: bytes
}; }

fn measure(label, bytes) {
    let samples = []; let expected_steps = nil; let sample = 0;
    while sample < SAMPLES {
        let started = now_ms();
        let result = Evaluator.evaluate(request(bytes));
        array_push(samples, now_ms() - started);
        if not result.ok or not is_bool(result.value) or result.value
            or result.runtime.host_calls != CALLS {
            throw "pure evaluator adversarial benchmark correctness gate failed";
        }
        if expected_steps == nil { expected_steps = result.runtime.steps; }
        if result.runtime.steps != expected_steps { throw "non-deterministic step count"; }
        sample = sample + 1;
    }
    let ordered = sorted(samples); let middle = num_floor(SAMPLES / 2);
    print "HOST_PBCK_PURE_EVALUATOR|case=" + label
        + "|calls=" + str(CALLS) + "|samples=" + str(SAMPLES)
        + "|asset_bytes=" + str(len(bytes)) + "|steps=" + str(expected_steps)
        + "|median_ms=" + str(ordered[middle])
        + "|p95_ms=" + str(ordered[SAMPLES - 1]);
}

measure("small_text", asset("aaaaaaaaaaaaaaaa"));
// 65,507 bytes plus the 12-byte builtin name, 11-byte needle, and 6-byte
// generated root name exactly use the evaluator's 65,536-byte text budget.
measure("max_total_text_budget", asset(str_repeat("a", 65507)));
