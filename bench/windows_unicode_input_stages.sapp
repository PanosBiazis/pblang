let W = import("stdlib:windows_unicode_input.sapp");

fn sorted(values) {
    let out = []; let i = 0; while i < len(values) { array_push(out, values[i]); i = i + 1; }
    i = 1;
    while i < len(out) {
        let value = out[i]; let j = i - 1;
        while j >= 0 and out[j] > value { out[j + 1] = out[j]; j = j - 1; }
        out[j + 1] = value; i = i + 1;
    }
    return out;
}
fn percentile(values, ratio) {
    let values = sorted(values); let index = num_floor((len(values) - 1) * ratio);
    return values[index];
}

let sample = "PBLang semantic input: Ελληνικά 中文 😀\n";
let planning = []; let generation = []; let sizes = []; let i = 0;
while i < 25 {
    let start = now_ms(); let plan = W.text_plan(sample); let planned = now_ms();
    let artifact = W.artifact(sample); let generated = now_ms();
    if not plan.ok or not artifact.ok { throw "windows Unicode benchmark generation failed"; }
    array_push(planning, planned - start); array_push(generation, generated - planned);
    array_push(sizes, artifact.artifact_bytes); i = i + 1;
}
print map{ format: "pblang.benchmark.windows-unicode-input.v1", samples: len(planning),
    input_scalars: len(sample),
    planning_ms: map{ median: percentile(planning, 0.5), p95: percentile(planning, 0.95) },
    artifact_generation_ms: map{ median: percentile(generation, 0.5), p95: percentile(generation, 0.95) },
    artifact_bytes: map{ median: percentile(sizes, 0.5), maximum: percentile(sizes, 1.0) } };
