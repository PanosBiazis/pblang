let IR = import("stdlib/codegen_ir.sapp");
let X64 = import("stdlib/codegen_x64.sapp");
let X86 = import("stdlib/codegen_x86.sapp");
let A64 = import("stdlib/codegen_arm64.sapp");

let SOURCE = [
    ["seti", 0, 1], ["addi", 0, 2],
    ["seti", 2, 1], ["ifnz", 2, [["addi", 0, 4]], [["addi", 0, 100]]],
    ["seti", 3, 20], ["loop", 3, [["addi", 0, 1], ["addi", 1, 0]]]
];
let CLEAN = IR.optimize(SOURCE);
if IR.eval(SOURCE) != IR.eval(CLEAN) { throw "IR optimizer benchmark result mismatch"; }
let PROPAGATED = [
    ["seti", 0, 0], ["seti", 2, 1], ["seti", 3, 20],
    ["ifnz", 2, [["addi", 0, 4]], [["addi", 0, 100]]],
    ["loop", 3, [["addi", 0, 1]]]
];
let PROPAGATED_CLEAN = IR.optimize(PROPAGATED);
if IR.eval(PROPAGATED) != IR.eval(PROPAGATED_CLEAN) { throw "IR constant propagation benchmark mismatch"; }
let DEAD_ARITH = [
    ["seti", 0, 1], ["seti", 1, 20],
    ["loop", 1, [
        ["addi", 0, 1],
        ["seti", 2, 10], ["addi", 2, 5], ["mul", 2, 0],
        ["seti", 3, 7], ["sub", 3, 0]
    ]]
];
let DEAD_ARITH_CLEAN = IR.optimize(DEAD_ARITH);
if IR.eval(DEAD_ARITH) != IR.eval(DEAD_ARITH_CLEAN) { throw "IR dead arithmetic benchmark mismatch"; }
let COPIED_CONSTANT = [
    ["seti", 0, 0], ["seti", 1, 41], ["movr", 2, 1],
    ["seti", 3, 1], ["loop", 3, [["addi", 0, 1]]],
    ["addi", 2, 1], ["movr", 0, 2]
];
let COPIED_CONSTANT_CLEAN = IR.optimize(COPIED_CONSTANT);
if IR.eval(COPIED_CONSTANT) != 42 or IR.eval(COPIED_CONSTANT_CLEAN) != 42 { throw "IR constant-copy propagation benchmark mismatch"; }
let KNOWN_ARITH = [
    ["seti", 0, 6], ["seti", 2, 7], ["mul", 0, 2],
    ["seti", 3, 0], ["loop", 3, [["addi", 0, 100]]],
    ["seti", 1, 2], ["loop", 1, [["addi", 0, 1]]]
];
let KNOWN_ARITH_REPORT = IR.optimize_report(KNOWN_ARITH);
let KNOWN_ARITH_CLEAN = KNOWN_ARITH_REPORT.ir;
if IR.eval(KNOWN_ARITH) != IR.eval(KNOWN_ARITH_CLEAN) { throw "IR known-arithmetic propagation benchmark mismatch"; }
let IDENTITIES = [
    ["seti", 0, 5], ["seti", 2, 0], ["seti", 3, 1],
    ["seti", 1, 100], ["loop", 1, [
        ["add", 0, 2], ["sub", 0, 2], ["mul", 0, 3], ["addi", 0, 1]
    ]],
    ["ifnz", 0, [["addi", 0, 2]], [["addi", 0, 2]]]
];
let IDENTITIES_REPORT = IR.optimize_report(IDENTITIES);
let IDENTITIES_CLEAN = IDENTITIES_REPORT.ir;
if IR.eval(IDENTITIES) != IR.eval(IDENTITIES_CLEAN) { throw "IR algebraic identity benchmark mismatch"; }

fn stage(name, n, work) {
    let t0 = now_ms(); let i = 0;
    while i < n { work(); i = i + 1; }
    let elapsed = now_ms() - t0;
    print "IR_OPT_PHASE|" + name + "|" + str(n) + "|" + str(elapsed) + "|" + str(elapsed / n);
}

let x64_before = X64.compile_program(SOURCE); let x64_after = X64.compile_program(CLEAN);
let x86_before = X86.compile_program(SOURCE); let x86_after = X86.compile_program(CLEAN);
let a64_before = A64.compile_program(SOURCE); let a64_after = A64.compile_program(CLEAN);
print "IR_OPT_SIZE|instructions|" + str(len(SOURCE)) + "|" + str(len(CLEAN));
print "IR_OPT_SIZE|x86_64_elf|" + str(len(x64_before)) + "|" + str(len(x64_after));
print "IR_OPT_SIZE|i386_elf|" + str(len(x86_before)) + "|" + str(len(x86_after));
print "IR_OPT_SIZE|arm64_elf|" + str(len(a64_before)) + "|" + str(len(a64_after));
print "IR_OPT_SIZE|c99_source|" + str(len(IR.emit_c(SOURCE))) + "|" + str(len(IR.emit_c(CLEAN)));
print "IR_CONSTPROP_SIZE|instructions|" + str(len(PROPAGATED)) + "|" + str(len(PROPAGATED_CLEAN));
print "IR_CONSTPROP_SIZE|x86_64_elf|" + str(len(X64.compile_program(PROPAGATED))) + "|" + str(len(X64.compile_program(PROPAGATED_CLEAN)));
print "IR_CONSTPROP_SIZE|i386_elf|" + str(len(X86.compile_program(PROPAGATED))) + "|" + str(len(X86.compile_program(PROPAGATED_CLEAN)));
print "IR_CONSTPROP_SIZE|arm64_elf|" + str(len(A64.compile_program(PROPAGATED))) + "|" + str(len(A64.compile_program(PROPAGATED_CLEAN)));
print "IR_CONSTPROP_SIZE|c99_source|" + str(len(IR.emit_c(PROPAGATED))) + "|" + str(len(IR.emit_c(PROPAGATED_CLEAN)));
print "IR_DEAD_ARITH_SIZE|loop_body|" + str(len(DEAD_ARITH[2][2])) + "|" + str(len(DEAD_ARITH_CLEAN[2][2]));
print "IR_DEAD_ARITH_SIZE|x86_64_elf|" + str(len(X64.compile_program(DEAD_ARITH))) + "|" + str(len(X64.compile_program(DEAD_ARITH_CLEAN)));
print "IR_DEAD_ARITH_SIZE|i386_elf|" + str(len(X86.compile_program(DEAD_ARITH))) + "|" + str(len(X86.compile_program(DEAD_ARITH_CLEAN)));
print "IR_DEAD_ARITH_SIZE|arm64_elf|" + str(len(A64.compile_program(DEAD_ARITH))) + "|" + str(len(A64.compile_program(DEAD_ARITH_CLEAN)));
print "IR_DEAD_ARITH_SIZE|c99_source|" + str(len(IR.emit_c(DEAD_ARITH))) + "|" + str(len(IR.emit_c(DEAD_ARITH_CLEAN)));
print "IR_CONST_COPY_SIZE|instructions|" + str(len(COPIED_CONSTANT)) + "|" + str(len(COPIED_CONSTANT_CLEAN));
print "IR_CONST_COPY_SIZE|x86_64_elf|" + str(len(X64.compile_program(COPIED_CONSTANT))) + "|" + str(len(X64.compile_program(COPIED_CONSTANT_CLEAN)));
print "IR_CONST_COPY_SIZE|i386_elf|" + str(len(X86.compile_program(COPIED_CONSTANT))) + "|" + str(len(X86.compile_program(COPIED_CONSTANT_CLEAN)));
print "IR_CONST_COPY_SIZE|arm64_elf|" + str(len(A64.compile_program(COPIED_CONSTANT))) + "|" + str(len(A64.compile_program(COPIED_CONSTANT_CLEAN)));
print "IR_CONST_COPY_SIZE|c99_source|" + str(len(IR.emit_c(COPIED_CONSTANT))) + "|" + str(len(IR.emit_c(COPIED_CONSTANT_CLEAN)));
print "IR_KNOWN_ARITH_SIZE|instructions|" + str(IR.instruction_count(KNOWN_ARITH)) + "|" + str(IR.instruction_count(KNOWN_ARITH_CLEAN));
print "IR_KNOWN_ARITH_SIZE|x86_64_elf|" + str(len(X64.compile_program(KNOWN_ARITH))) + "|" + str(len(X64.compile_program(KNOWN_ARITH_CLEAN)));
print "IR_KNOWN_ARITH_SIZE|i386_elf|" + str(len(X86.compile_program(KNOWN_ARITH))) + "|" + str(len(X86.compile_program(KNOWN_ARITH_CLEAN)));
print "IR_KNOWN_ARITH_SIZE|arm64_elf|" + str(len(A64.compile_program(KNOWN_ARITH))) + "|" + str(len(A64.compile_program(KNOWN_ARITH_CLEAN)));
print "IR_KNOWN_ARITH_SIZE|c99_source|" + str(len(IR.emit_c(KNOWN_ARITH))) + "|" + str(len(IR.emit_c(KNOWN_ARITH_CLEAN)));
print "IR_OPT_REPORT|" + KNOWN_ARITH_REPORT.mode + "|" + str(KNOWN_ARITH_REPORT.before) + "|" + str(KNOWN_ARITH_REPORT.peephole) + "|" + str(KNOWN_ARITH_REPORT.constants) + "|" + str(KNOWN_ARITH_REPORT.dead_stores) + "|" + str(KNOWN_ARITH_REPORT.after);
print "IR_IDENTITIES_SIZE|instructions|" + str(IR.instruction_count(IDENTITIES)) + "|" + str(IR.instruction_count(IDENTITIES_CLEAN));
print "IR_IDENTITIES_SIZE|x86_64_elf|" + str(len(X64.compile_program(IDENTITIES))) + "|" + str(len(X64.compile_program(IDENTITIES_CLEAN)));
print "IR_IDENTITIES_SIZE|i386_elf|" + str(len(X86.compile_program(IDENTITIES))) + "|" + str(len(X86.compile_program(IDENTITIES_CLEAN)));
print "IR_IDENTITIES_SIZE|arm64_elf|" + str(len(A64.compile_program(IDENTITIES))) + "|" + str(len(A64.compile_program(IDENTITIES_CLEAN)));
print "IR_IDENTITIES_SIZE|c99_source|" + str(len(IR.emit_c(IDENTITIES))) + "|" + str(len(IR.emit_c(IDENTITIES_CLEAN)));
print "IR_IDENTITIES_REPORT|" + str(IDENTITIES_REPORT.peephole_removed) + "|" + str(IDENTITIES_REPORT.constant_removed) + "|" + str(IDENTITIES_REPORT.dead_store_removed) + "|" + str(IDENTITIES_REPORT.cleanup_removed) + "|" + str(IDENTITIES_REPORT.removed);
stage("optimize", 1000, fn() { IR.optimize(SOURCE); });
stage("optimize_dead_arithmetic", 1000, fn() { IR.optimize(DEAD_ARITH); });
stage("optimize_constant_copy", 1000, fn() { IR.optimize(COPIED_CONSTANT); });
stage("optimize_known_arithmetic", 1000, fn() { IR.optimize(KNOWN_ARITH); });
stage("optimize_algebraic_identities", 1000, fn() { IR.optimize(IDENTITIES); });
stage("x86_64_codegen", 200, fn() { X64.compile_program(CLEAN); });
stage("i386_codegen", 200, fn() { X86.compile_program(CLEAN); });
stage("arm64_codegen", 200, fn() { A64.compile_program(CLEAN); });
stage("x86_64_codegen_dead_arithmetic", 500, fn() { X64.compile_program(DEAD_ARITH_CLEAN); });
stage("i386_codegen_dead_arithmetic", 500, fn() { X86.compile_program(DEAD_ARITH_CLEAN); });
stage("arm64_codegen_dead_arithmetic", 500, fn() { A64.compile_program(DEAD_ARITH_CLEAN); });
stage("x86_64_codegen_constant_copy", 500, fn() { X64.compile_program(COPIED_CONSTANT_CLEAN); });
stage("i386_codegen_constant_copy", 500, fn() { X86.compile_program(COPIED_CONSTANT_CLEAN); });
stage("arm64_codegen_constant_copy", 500, fn() { A64.compile_program(COPIED_CONSTANT_CLEAN); });
print "IR_OPT_SUITE|ok";
