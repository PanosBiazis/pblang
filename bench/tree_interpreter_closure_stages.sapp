// Measures closure-heavy tree-interpreter execution. The benchmark, workloads,
// correctness gates, and statistics are all implemented in pblang.
let INT = import("stdlib/compiler/interp.sapp");

let FIB_SOURCE = "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } if fib(18) != 2584 { missing(); }";
let CHOOSE_SOURCE = "fn choose(n, k) { if k == 0 or k == n { return 1; } return choose(n - 1, k - 1) + choose(n - 1, k); } if choose(15, 7) != 6435 { missing(); }";
let CAPTURE_SOURCE = "fn make_adder(x) { return fn(y) { return x + y; }; } let add7 = make_adder(7); if add7(35) != 42 { missing(); }";

let fib_ast = INT.compile_program(FIB_SOURCE);
let choose_ast = INT.compile_program(CHOOSE_SOURCE);
let capture_ast = INT.compile_program(CAPTURE_SOURCE);

fn measure(name, ast, iterations) {
    // One untimed execution validates the result and warms immutable AST data.
    if INT.eval_ast(ast) != true { throw "closure benchmark failed: " + name; }
    let samples = [];
    let i = 0;
    while i < iterations {
        let t0 = now_ms();
        if INT.eval_ast(ast) != true { throw "closure benchmark failed: " + name; }
        array_push(samples, now_ms() - t0);
        i = i + 1;
    }
    let sorted = array_sort(samples);
    let total = 0.0;
    i = 0;
    while i < len(sorted) { total = total + sorted[i]; i = i + 1; }
    print "CLOSURE|" + name + "|" + str(iterations) + "|" + str(total / iterations)
        + "|" + str(sorted[num_floor(len(sorted) / 2)]) + "|ok";
}

fn measure_compile(name, source, iterations) {
    INT.compile_program(source);
    let samples = [];
    let i = 0;
    while i < iterations {
        let t0 = now_ms();
        let ast = INT.compile_program(source);
        if not is_map(ast) or len(ast.stmts) == 0 { throw "compile benchmark failed: " + name; }
        array_push(samples, now_ms() - t0);
        i = i + 1;
    }
    let sorted = array_sort(samples);
    let total = 0.0;
    i = 0;
    while i < len(sorted) { total = total + sorted[i]; i = i + 1; }
    print "CLOSURE|" + name + "|" + str(iterations) + "|" + str(total / iterations)
        + "|" + str(sorted[num_floor(len(sorted) / 2)]) + "|ok";
}

fn measure_program(name, source, iterations) {
    if INT.eval_program(source) != true { throw "program benchmark failed: " + name; }
    let samples = [];
    let i = 0;
    while i < iterations {
        let t0 = now_ms();
        if INT.eval_program(source) != true { throw "program benchmark failed: " + name; }
        array_push(samples, now_ms() - t0);
        i = i + 1;
    }
    let sorted = array_sort(samples);
    let total = 0.0;
    i = 0;
    while i < len(sorted) { total = total + sorted[i]; i = i + 1; }
    print "CLOSURE|" + name + "|" + str(iterations) + "|" + str(total / iterations)
        + "|" + str(sorted[num_floor(len(sorted) / 2)]) + "|ok";
}

if INT.eval_ast(capture_ast) != true { throw "closure capture benchmark failed"; }
print "SCHEMA|name|iterations|average_ms|median_ms|status";
measure("fib18", fib_ast, 3);
measure("choose15_7", choose_ast, 2);
measure("closure_capture", capture_ast, 30);
measure_compile("compile_fib18", FIB_SOURCE, 50);
measure_program("end_to_end_fib18", FIB_SOURCE, 3);
print "CLOSURE_SUITE|ok";
