//
// bench/pbc_smoke.sapp — Pure-PBLang Regression Suite for tools/pbc.sapp
//
// Replaces bench/pbc_smoke.sh. Covers plain lowering, --safe (memory-certified),
// and --overflow (checked arithmetic) flags and their composition.

fn _find_pb(root: string) {
    let env_b = env_get("PB");
    if env_b != nil and env_b != "" and fs_exists(env_b) { return env_b; }
    if fs_exists(root + "/pblang") { return root + "/pblang"; }
    if fs_exists(root + "/target/release/pblang") { return root + "/target/release/pblang"; }
    return "pblang";
}

fn _chmod_x(path: string) {
    if fs_exists("/bin/chmod") {
        proc_spawn_wait("/bin/chmod", ["755", path]);
    } elif fs_exists("/usr/bin/chmod") {
        proc_spawn_wait("/usr/bin/chmod", ["755", path]);
    } else {
        try proc_spawn_wait("chmod", ["755", path]) catch nil;
    }
}

fn _normalize_signal_exit(rc: int) {
    // POSIX shells map signal kills (-SIG) to 128 + SIG; normalize if proc_spawn_wait returns negative
    if rc < 0 { return 128 + (0 - rc); }
    return rc;
}

let root = cwd();
let pb = _find_pb(root);
let work = "/tmp/pb_pbc_smoke_" + str(num_floor(now_ms()));
fs_mkdirs(work);

let total = 0;
let passed = 0;
let failed = 0;

let run_case = fn(prog: string, flags: any, label: string, expected_exit: int) {
    total = total + 1;
    let src = work + "/p" + str(total) + ".sapp";
    let bin = work + "/b" + str(total);
    fs_write(src, prog);
    let args = ["run", root + "/tools/pbc.sapp", "--allow-all", "--", src];
    let i = 0;
    while i < len(flags) {
        array_push(args, flags[i]);
        i = i + 1;
    }
    array_push(args, "--out");
    array_push(args, bin);
    let _ = proc_spawn_wait(pb, args);
    if not fs_exists(bin) {
        println("FAIL [" + label + "]: pbc produced no binary");
        failed = failed + 1;
        return;
    }
    _chmod_x(bin);
    let r = proc_spawn_wait("/bin/sh", ["-c", "\"$1\"", "sh", bin]);
    let rc = _normalize_signal_exit(r.exit_code);
    if rc == expected_exit {
        passed = passed + 1;
    } else {
        println("FAIL [" + label + "]: got " + str(rc) + ", expected " + str(expected_exit));
        failed = failed + 1;
    }
};

let ovf = "let x=3037000500; return x*x;";
let add_ovf = "let x=4611686018427387904; let y=4611686018427387904; return x+y;";
let safe_prog = "let x=5; return x*x;";

run_case(safe_prog, [], "plain: safe program returns 25", 25);
run_case(ovf, [], "plain: overflow WRAPS (not 132)", 144);
run_case(safe_prog, ["--safe"], "--safe: safe program still 25", 25);
run_case(ovf, ["--overflow"], "--overflow: mul overflow traps (132)", 132);
run_case(add_ovf, ["--overflow"], "--overflow: add overflow traps (132)", 132);
run_case(safe_prog, ["--overflow"], "--overflow: safe program no false trap", 25);
run_case(ovf, ["--safe", "--overflow"], "compose: --safe --overflow traps (132)", 132);
run_case(safe_prog, ["--safe", "--overflow"], "compose: safe program returns 25", 25);

run_case("let x=6; let y=2; return x/y;", ["--overflow"], "div 6/2 checked returns 3", 3);
run_case("let x=5; let y=0; return x/y;", ["--overflow"], "div-by-zero checked traps (132)", 132);
run_case("let x=5; let y=0; return x%y;", ["--overflow"], "mod-by-zero checked traps (132)", 132);
run_case("let x=5; let y=0; return x/y;", [], "div-by-zero plain is raw #DE (136)", 136);

let names = try fs_listdir(work) catch [];
let ci = 0;
while ci < len(names) {
    try fs_remove(work + "/" + names[ci]) catch nil;
    ci = ci + 1;
}
try fs_remove(work) catch nil;

println("pbc_smoke: " + str(passed) + "/" + str(total) + " passed");
if failed > 0 { os_exit(1); }
