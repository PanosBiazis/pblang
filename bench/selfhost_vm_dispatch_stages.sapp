// Correctness-gated dispatch benchmark for the bytecode VM written in pblang.
let TOK = import("stdlib/compiler/tokenizer.sapp");
let PAR = import("stdlib/compiler/parser.sapp");
let CG = import("stdlib/compiler/codegen.sapp");
let VM = import("stdlib/compiler/vm.sapp");

let FIB_SOURCE = "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } print fib(14);";
let LOOP_SOURCE = "fn work(n) { let i = 0; let s = 0; while i < n { s = s + i; i = i + 1; } print s; } work(10000);";
let LEN_SOURCE = "fn work(n) { let a = [1, 2, 3]; let i = 0; let s = 0; while i < n { s = s + len(a); i = i + 1; } print s; } work(10000);";
let SHR_SOURCE = "fn work(n) { let i = 0; let value = 0; while i < n { value = bit_shr(i, 1); i = i + 1; } print value; } work(10000);";

fn compile(src) { return CG.compile_stmts(PAR.parse(TOK.tokenize(src)).stmts); }
let fib = compile(FIB_SOURCE);
let loop = compile(LOOP_SOURCE);
let blen = compile(LEN_SOURCE);
let shr = compile(SHR_SOURCE);

fn require_output(chunk, expected, name) {
    let result = VM.run(chunk);
    if len(result.output) != 1 or result.output[0] != expected {
        throw "VM dispatch benchmark result mismatch: " + name;
    }
}

fn measure(name, chunk, expected, iterations) {
    require_output(chunk, expected, name);
    let samples = [];
    let i = 0;
    while i < iterations {
        let t0 = now_ms();
        require_output(chunk, expected, name);
        array_push(samples, now_ms() - t0);
        i = i + 1;
    }
    let sorted = array_sort(samples);
    let total = 0.0;
    i = 0;
    while i < len(sorted) { total = total + sorted[i]; i = i + 1; }
    print "VM_DISPATCH|" + name + "|" + str(iterations) + "|" + str(total / iterations)
        + "|" + str(sorted[num_floor(len(sorted) / 2)]) + "|ok";
}

print "SCHEMA|name|iterations|average_ms|median_ms|status";
measure("fib14", fib, 377, 5);
measure("arithmetic_loop_10000", loop, 49995000, 3);
measure("builtin_len_10000", blen, 30000, 3);
measure("builtin_shr_10000", shr, 4999, 3);
print "VM_DISPATCH_SUITE|ok";
