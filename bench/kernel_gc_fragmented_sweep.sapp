// pblang:target=kernel
// pblang:extern heap_init heap_alloc heap_free gc_new gc_set_auto gc_alloc gc_add_root kernel_gc_collect gc_live
// Fixed alternating garbage/live allocation layout: sweeping from the free-list
// head repeats earlier holes; a free-only cursor can traverse the holes once.
// Prepend heap.sapp + gc.sapp. QEMU exit 85 is success.
fn kmain() {
    let h=kmalloc(8);let arena=kmalloc(131072);let pass=0;
    while pass<80 {
        // Reset only after the previous test arena's ownership is discarded.
        heap_init(h,arena,131072);let g=gc_new(h);gc_set_auto(g,0);let i=0;
        while i<1024 {
            let garbage=gc_alloc(g,0);let live=gc_alloc(g,0);
            if garbage==0 or live==0 or gc_add_root(g,live)!=1 {outb(244,1);while 1>0 {hlt();}}
            i=i+1;
        }
        if kernel_gc_collect(g)!=0 or gc_live(g)!=1024 {outb(244,1);while 1>0 {hlt();}}
        pass=pass+1;
    }
    outb(244,42);while 1>0 {hlt();}
}
