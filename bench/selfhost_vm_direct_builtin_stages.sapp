// Within-process A/B for direct builtin descriptor caching. Both chunks are
// generated by the same compiler; the fallback copy has only the optional
// direct-call metadata removed, reproducing the allocation path.
let FE = import("stdlib/compiler/selfhost_frontend.sapp");
let VM = import("stdlib/compiler/vm.sapp");

fn disable_direct_metadata(chunk) {
    let removed = 0;
    let i = 0;
    while i < len(chunk.instructions) {
        if map_has(chunk.instructions[i], "direct_builtin_call") {
            map_remove(chunk.instructions[i], "direct_builtin_call");
            removed = removed + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < len(chunk.constants) {
        let constant = chunk.constants[i];
        if is_map(constant) and map_has(constant, "chunk") {
            removed = removed + disable_direct_metadata(constant.chunk);
        }
        if is_map(constant) and map_has(constant, "try_chunk") {
            removed = removed + disable_direct_metadata(constant.try_chunk);
        }
        if is_map(constant) and map_has(constant, "catch_chunk") {
            removed = removed + disable_direct_metadata(constant.catch_chunk);
        }
        i = i + 1;
    }
    return removed;
}

fn execute_checked(chunk, expected) {
    let result = VM.run(chunk);
    if len(result.output) != 1 or result.output[0] != expected {
        throw "direct builtin benchmark: result mismatch";
    }
}

fn timed_once(chunk, expected) {
    let t0 = now_ms();
    execute_checked(chunk, expected);
    return now_ms() - t0;
}

fn compare(label, source, expected) {
    let direct = FE.frontend_compile(source).chunk;
    let fallback = FE.frontend_compile(source).chunk;
    let markers = disable_direct_metadata(fallback);
    if markers == 0 { throw "direct builtin benchmark: no metadata markers"; }

    execute_checked(direct, expected);
    execute_checked(fallback, expected);

    let direct_ms = 0;
    let fallback_ms = 0;
    let pair = 0;
    while pair < 6 {
        if num_mod(pair, 2) == 0 {
            fallback_ms = fallback_ms + timed_once(fallback, expected);
            direct_ms = direct_ms + timed_once(direct, expected);
        } else {
            direct_ms = direct_ms + timed_once(direct, expected);
            fallback_ms = fallback_ms + timed_once(fallback, expected);
        }
        pair = pair + 1;
    }
    print "SELFHOST_VM_DIRECT_BUILTIN|" + label + "|" + str(markers) + "|" + str(fallback_ms) + "|" + str(direct_ms) + "|" + str(fallback_ms / direct_ms);
}

let LEN_SOURCE = "fn work(n) { let values = [1, 2, 3]; let i = 0; let total = 0; while i < n { total = total + len(values); i = i + 1; } print total; } work(10000);";
let SHR_SOURCE = "fn work(n) { let i = 0; let value = 0; while i < n { value = bit_shr(i, 1); i = i + 1; } print value; } work(10000);";

compare("len_10000", LEN_SOURCE, 30000);
compare("bit_shr_10000", SHR_SOURCE, 4999);
