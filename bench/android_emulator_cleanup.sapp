// Args: repetitions, success/failure, scalar owner count.
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let P=import("stdlib:selfhost_pbck.sapp");
let L=import("stdlib:android_emulator.sapp");
let args=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");
let repeats=parse_number(args[0]);let mode=args[1];let count=parse_number(args[2]);
let source="let i=0; while i<"+str(count)+" { memory_alloc(i); i=i+1; } ";
if mode=="failure" {source=source+"throw \"stop\";";} else {source=source+"print 42;";}
let compiled=F.frontend_compile(source);if not compiled.ok {throw "benchmark compile failed";}
let payload=P.serialize_chunk(compiled.chunk);
let em=L.new(34,"arm64",map{max_events:1000000});
let package_name="org.example.benchmark";
assert(L.install(em,map{package:package_name,activities:[map{name:".Main",exported:false}],main_activity:".Main"}).ok,"install");
assert(L.start_activity(em,"system",package_name).ok,"start");
let t=clock();
for i repeats {
 let result=L.run_pbcs(em,package_name,payload);
 if mode=="failure" {if result.ok or result.error!="PBCS execution failed or exceeded its runtime budget" {throw "failure mismatch";}}
 else {if not result.ok or result.output!=[42] {throw "success mismatch";}}
}
print "ANDROID_CLEANUP|"+str(clock()-t)+"|ok";
