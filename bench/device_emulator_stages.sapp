// Pure-PBLang benchmark for composed platform/device/input/signal contracts.
let D = import("stdlib:device_emulator.sapp");

let TARGETS = [
    ["desktop", "linux", "6.8", "x86_64"],
    ["smartphone", "android", "34", "arm64"],
    ["microcontroller", "freertos", "11", "avr"],
    ["satellite", "vxworks", "7", "sparc-v8"],
    ["calculator", "cpm", "2.2", "z80"],
    ["browser", "wasi", "1", "wasm32"]
];

fn emit(name, iterations, work, thunk) {
    let t0 = now_ms(); let checksum = 0; let i = 0;
    while i < iterations { checksum = checksum + thunk(); i = i + 1; }
    let elapsed = now_ms() - t0; if elapsed <= 0 { elapsed = 0.001; }
    print "DEVICE_PHASE|" + name + "|" + str(iterations) + "|" + str(elapsed)
        + "|" + str(iterations * work * 1000 / elapsed) + "|" + str(checksum) + "|ok";
}

fn resolve_round() {
    let checksum = 0; let i = 0;
    while i < len(TARGETS) {
        let p = D.resolve(TARGETS[i][0], TARGETS[i][1], TARGETS[i][2], TARGETS[i][3]);
        if not p.ok { throw "device profile resolution failed"; }
        checksum = checksum + p.memory_bytes + p.platform.pointer_bits; i = i + 1;
    }
    return checksum;
}

let phone = D.resolve("smartphone", "android", "34", "arm64");
fn input_round() {
    let m = D.machine(phone, map{ max_input_events: 1024 }); let i = 0;
    while i < 100 {
        if not D.input_apply(m, map{ format: "pblang.input.event.v1", kind: "pointer", x: i, y: i }).ok { throw "input benchmark pointer"; }
        if not D.input_apply(m, map{ format: "pblang.input.event.v1", kind: "type", text: "x" }).ok { throw "input benchmark text"; }
        i = i + 1;
    }
    return D.stats(m).input.event_count;
}

let sensor = D.resolve("sensor", "freertos", "11", "avr");
fn signal_round() {
    let m = D.machine(sensor, map{ max_signal_updates: 1024 }); let i = 0;
    while i < 256 {
        if not D.signal_write(m, "adc-" + str(i % 8), i).ok { throw "signal benchmark write"; }
        i = i + 1;
    }
    return D.stats(m).signal_updates;
}

if resolve_round() != 3768544 { throw "device resolver checksum mismatch"; }
print "SCHEMA|phase|iterations|total_ms|work_units_per_s|checksum|status";
emit("resolve_6_device_profiles", 1000, len(TARGETS), resolve_round);
emit("virtual_input_200_events", 100, 200, input_round);
emit("sensor_signal_256_updates", 100, 256, signal_round);
print "DEVICE_EMULATOR_SUITE|ok";
