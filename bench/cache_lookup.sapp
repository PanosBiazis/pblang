// Args: count repeats API (get/peek/has/get_entry) TTL (0/600000) policy (fifo/lru) hit/miss.
let C=import("stdlib:cache.sapp");
let args=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");
let count=parse_number(args[0]);let repeats=parse_number(args[1]);let api=args[2];let ttl=parse_number(args[3]);let policy=args[4];let outcome=args[5];
let c=C.bounded_policy(ttl,count,0,policy);let keys=[];
for i count {let key="key"+str(i);C.set(c,key,i);array_push(keys,key);}
let lookup=nil;
if api=="get" {lookup=C.get;} else if api=="peek" {lookup=C.peek;} else if api=="has" {lookup=C.has;} else if api=="get_entry" {lookup=C.get_entry;} else {throw "invalid benchmark API";}
if outcome!="hit" and outcome!="miss" {throw "invalid benchmark outcome";}
let index=0;let last=nil;let start=clock();
for i repeats {
 let key="missing";if outcome=="hit" {key=keys[index];}
 last=lookup(c,key);index=index+1;if index==count {index=0;}
}
let elapsed=clock()-start;
fn expected_value(outcome,repeats,count) {
 if outcome=="hit" {return (repeats-1)%count;}
 return nil;
}
fn expected_result(api,outcome,repeats,count) {
 if api=="has" {return outcome=="hit";}
 let value=expected_value(outcome,repeats,count);
 if api=="get_entry" {return map{found:outcome=="hit",value:value};}
 return value;
}
let expected=expected_result(api,outcome,repeats,count);
if last!=expected {throw "cache benchmark value mismatch";}
let stats=C.stats(c);let wanted_hits=0;let wanted_misses=0;
if api=="get" or api=="get_entry" {if outcome=="hit" {wanted_hits=repeats;} else {wanted_misses=repeats;}}
if stats.hits!=wanted_hits or stats.misses!=wanted_misses or stats.size!=count or stats.expired!=0 {throw "cache benchmark stats mismatch";}
print "CACHE_LOOKUP|"+str(elapsed)+"|"+sha256(json_stringify([last,stats]))+"|ok";
