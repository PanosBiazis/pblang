// Compactness and W^X matrix for pure-pblang register-IR backends.
let X64 = import("stdlib/codegen_x64.sapp");
let X86 = import("stdlib/codegen_x86.sapp");

let small_add = [["addi", 0, 23]];
let small_if = [["ifnz", 1, [["add", 0, 1]], []]];
let small_loop = [["loop", 1, [["add", 0, 1]]]];
let program = [["seti", 0, 0], ["seti", 1, 10], ["loop", 1, [["add", 0, 1]]]];

print "target,addi_bytes,ifnz_bytes,loop_bytes,elf_bytes,segment_flags";
print "x86-64," + str(len(X64.compile_ir(small_add))) + "," + str(len(X64.compile_ir(small_if))) + "," + str(len(X64.compile_ir(small_loop))) + "," + str(len(X64.compile_program(program))) + "," + str(X64.compile_program(program)[68]);
print "i386," + str(len(X86.compile_ir(small_add))) + "," + str(len(X86.compile_ir(small_if))) + "," + str(len(X86.compile_ir(small_loop))) + "," + str(len(X86.compile_program(program))) + "," + str(X86.compile_program(program)[76]);
print "i386_value_flags=" + str(X86.build_value(program)[76]);
