let Fast=import("stdlib:sequence_diff.sapp");let Full=import("fixtures/sequence_diff_full.sapp");
let rows=[];
for kind in ["identical","one_middle_edit","disjoint"]{
 let a=[];let b=[];for i in range(0,64){array_push(a,"block "+str(i));array_push(b,if kind=="disjoint" or (kind=="one_middle_edit" and i==32){"new "+str(i)}else {"block "+str(i)});}
 assert(Fast.compare(a,b)==Full.compare(a,b),"identical operation output");
 for warm in range(0,2){Full.compare(a,b);Fast.compare(a,b);}
 let full=[];let trimmed=[];
 for sample in range(0,7){let start=clock();let x=Full.compare(a,b);array_push(full,(clock()-start)*1000);start=clock();let y=Fast.compare(a,b);array_push(trimmed,(clock()-start)*1000);assert(x==y,"same measured outputs");}
 array_push(rows,map{workload:kind,items:64,full_ms:full,trimmed_ms:trimmed});
}print json_stringify(rows);
