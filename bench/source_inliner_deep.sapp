// Deterministic trusted-local linker benchmark. Change count identically in
// both checkouts for the 40, 2000 and 12000-module comparison workloads.
// Report link_ms separately from whole-process time and peak RSS.
let L=import("stdlib:source_inliner.sapp");
let count=12000;
fn resolve(path) {
 let idx=parse_number(str_slice(path,1,len(path)-5));
 if idx+1>=count { return "fn f"+str(idx)+"() { return 1; } export f"+str(idx)+";"; }
 return "let N=import(\"m"+str(idx+1)+".sapp\"); fn f"+str(idx)+"() { return N.f"+str(idx+1)+"(); } export f"+str(idx)+";";
}
let started=now_ms(); let result=L.inline_source_prefixed("let N=import(\"m0.sapp\"); print N.f0();",resolve);
if not result.ok or result.modules!=count { throw "deep link failed"; }
print json_stringify(map{ ok:result.ok, modules:result.modules, source_sha256:sha256(result.source), order_sha256:sha256(str_join(result.module_order,"\n")), link_ms:now_ms()-started });
