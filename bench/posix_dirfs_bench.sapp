let D = import("stdlib:posix_dirfs.sapp");
let B = import("stdlib:benchmark.sapp");
let J = import("stdlib:json.sapp");

if not D.available().ok { throw "portable POSIX directory handles are unavailable"; }
let fs = D.open(".", false); if not fs.ok { throw fs.error; }
B.warmup(fn() { return D.read_prefix_bytes(fs, "pblang.toml", 4096); }, 10);
let prefix = B.run("posix_dirfs_prefix_4k", fn() {
    return D.read_prefix_bytes(fs, "pblang.toml", 4096);
}, 100);
let range = B.run("posix_dirfs_range_256", fn() {
    return D.read_range_bytes(fs, "pblang.toml", 16, 256);
}, 100);
let check = D.read_prefix_bytes(fs, "pblang.toml", 4096);
if not check.ok or not check.descriptor_bound or not check.anonymous_snapshot {
    D.close(fs); throw "posix dirfs benchmark correctness gate failed";
}
D.close(fs);
print J.stringify(map{ format: "pblang.posix_dirfs.benchmark.v1",
    prefix: prefix, range: range,
    correctness: map{ descriptor_bound: true, pathname_fallback: false,
        anonymous_snapshot: true } });
