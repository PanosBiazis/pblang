// Detached, bounded literal operations over the existing Sheet model.
let Sheet=import("stdlib:sheet_document.sapp");
let Profile=import("stdlib:table_profile.sapp");
let Sort=import("stdlib:functional_sort.sapp");
fn _header(header) { if type(header)!="bool" { throw "header must be boolean"; } }
fn _column(column,count) {
    if type(column)!="number" or not (column>=0 and column<count) or column!=num_floor(column) { throw "invalid table column"; }
}
// Explicit selection/reordering. Duplicate selections and empty tables are not invented.
fn select_columns(doc,columns) {
    let size=Sheet.validate(doc);
    if type(columns)!="array" or len(columns)<1 or len(columns)>size.columns { throw "invalid column selection"; }
    let seen=map{};
    for column in columns { _column(column,size.columns); if map_has(seen,str(column)) { throw "duplicate selected column"; } seen[str(column)]=true; }
    let rows=[];
    for source in doc.cells { let row=[]; for column in columns { array_push(row,source[column]); } array_push(rows,row); }
    return map{format:Sheet.FORMAT,cells:rows};
}
// Stable literal ordering: "10" sorts before "2"; no locale or numeric coercion.
fn _ascending(a,b) {
    let limit=num_min(len(a.key),len(b.key));
    for i in range(0,limit) { if a.key[i]<b.key[i] {return -1;} if a.key[i]>b.key[i] {return 1;} }
    return len(a.key)-len(b.key);
}
fn _descending(a,b) { return -_ascending(a,b); }
fn sort_rows(doc,column,descending=false,header=false) {
    _header(header); let size=Sheet.validate(doc); _column(column,size.columns);
    if type(descending)!="bool" { throw "descending must be boolean"; }
    let source=Sheet.copy(doc); let start=if header {1} else {0};
    let entries=[];
    for r in range(start,len(source.cells)) {array_push(entries,map{key:str_to_bytes(source.cells[r][column]),row:source.cells[r]});}
    let ordered=Sort.stable_sort_by(entries,if descending {_descending} else {_ascending});
    let rows=[]; if header {array_push(rows,source.cells[0]);}
    for entry in ordered {array_push(rows,entry.row);}
    return map{format:Sheet.FORMAT,cells:rows};
}
fn trim_cells(doc,header=false) {
    _header(header); let result=Sheet.copy(doc);
    for r in range(if header {1} else {0},len(result.cells)) {
        for c in range(0,len(result.cells[r])) { result.cells[r][c]=str_trim(result.cells[r][c]); }
    }
    Sheet.validate(result); return result;
}
fn deduplicate(doc,header=false) {
    _header(header); let source=Sheet.copy(doc); let rows=[]; let seen=map{};
    if header { array_push(rows,source.cells[0]); }
    for r in range(if header {1} else {0},len(source.cells)) {
        let key=json_stringify(source.cells[r]);
        if not map_has(seen,key) { seen[key]=true; array_push(rows,source.cells[r]); }
    }
    // Rows already belong to the validated detached source; a subset needs no
    // second deep copy or repeated UTF-8 validation.
    return map{format:Sheet.FORMAT,cells:rows};
}
fn filter_rows(doc,column,query,header=false) {
    let indices=Profile.select_rows(doc,column,query,header); let source=Sheet.copy(doc); let rows=[];
    if header { array_push(rows,source.cells[0]); }
    for index in indices { array_push(rows,source.cells[index]); }
    if len(rows)==0 { throw "no rows match; a headerless Sheet cannot be empty"; }
    return map{format:Sheet.FORMAT,cells:rows};
}
// Exact step schemas; at most sixteen operations, all-or-nothing on the input.
fn apply(doc,steps,header=false) {
    _header(header); let result=Sheet.copy(doc);
    if type(steps)!="array" or len(steps)>16 { throw "invalid table steps"; }
    for step in steps {
        if type(step)!="map" or not map_has(step,"op") or type(step.op)!="string" { throw "invalid table step"; }
        if step.op=="trim" and len(step)==1 { result=trim_cells(result,header); }
        elif step.op=="deduplicate" and len(step)==1 { result=deduplicate(result,header); }
        elif step.op=="filter" and len(step)==3 and map_has(step,"column") and map_has(step,"query") {
            result=filter_rows(result,step.column,step.query,header);
        } elif step.op=="select" and len(step)==2 and map_has(step,"columns") {
            result=select_columns(result,step.columns);
        } elif step.op=="sort" and len(step)==3 and map_has(step,"column") and map_has(step,"descending") {
            result=sort_rows(result,step.column,step.descending,header);
        } else { throw "unsupported table step"; }
    }
    return result;
}
export trim_cells,deduplicate,filter_rows,select_columns,sort_rows,apply;
