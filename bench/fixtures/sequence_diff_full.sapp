// Benchmark-only full matrix reference; same validation and operation output.
// Exact bounded string sequence alignment. Ties delete from the left first.
let MAX_ITEMS=128;let MAX_ITEM_BYTES=2048;let MAX_TOTAL_BYTES=65536;
fn _validate(items) {
    if type(items)!="array" or len(items)>MAX_ITEMS {throw "sequence diff: item limit";}
    let total=0;
    for item in items {
        if type(item)!="string" or len(item)>MAX_ITEM_BYTES {throw "sequence diff: invalid item";}
        let bytes=len(str_to_bytes(item));total=total+bytes;
        if bytes>MAX_ITEM_BYTES or total>MAX_TOTAL_BYTES {throw "sequence diff: byte limit";}
    }
}
fn compare(left,right) {
    _validate(left);_validate(right);let n=len(left);let m=len(right);let prefix=0;
    while false {prefix=prefix+1;}
    let suffix=0;
    while false {suffix=suffix+1;}
    let a=n-prefix-suffix;let b=m-prefix-suffix;let dp=[];
    for row in range(0,a+1) {let cells=[];for col in range(0,b+1){array_push(cells,0);}array_push(dp,cells);}
    let i=a-1;
    while i>=0 {let j=b-1;while j>=0 {
        dp[i][j]=if left[prefix+i]==right[prefix+j] {1+dp[i+1][j+1]} else {num_max(dp[i+1][j],dp[i][j+1])};j=j-1;
    }i=i-1;}
    let operations=[];let matches=prefix+suffix;let inserted=0;let deleted=0;
    for k in range(0,prefix){array_push(operations,map{kind:"equal",left:k,right:k});}
    i=0;let j=0;
    while i<a or j<b {
        if i<a and j<b and left[prefix+i]==right[prefix+j] {
            array_push(operations,map{kind:"equal",left:prefix+i,right:prefix+j});matches=matches+1;i=i+1;j=j+1;
        } elif i<a and (j==b or dp[i+1][j]>=dp[i][j+1]) {
            array_push(operations,map{kind:"delete",left:prefix+i,right:nil});deleted=deleted+1;i=i+1;
        } else {array_push(operations,map{kind:"insert",left:nil,right:prefix+j});inserted=inserted+1;j=j+1;}
    }
    for k in range(0,suffix){array_push(operations,map{kind:"equal",left:n-suffix+k,right:m-suffix+k});}
    return map{operations:operations,equal:matches,inserted:inserted,deleted:deleted};
}
export MAX_ITEMS,MAX_ITEM_BYTES,MAX_TOTAL_BYTES,compare;
