// Headless PBIDE render-runtime hot-path benchmark. This measures the pure
// planning work only, so it is safe to run without opening a desktop window.
let IDE = import("stdlib:ide_features.sapp");

let PROFILE = map{
    format: "pblang.graphics.backend.profile.v1",
    backend: "minifb",
    present: "cpu-framebuffer",
    present_copy: "native-framebuffer",
    gpu_present: false,
    cpu_raster_ui: true,
    idle_present_skip: true,
    text_antialias: false,
    rect_fill: "row-slice-fill"
};

let COMMANDS = [];
let ci = 0;
while ci < 82 {
    array_push(COMMANDS, map{ op: "text", x: 80, y: 48 + ci * 16, text: "code-row" });
    ci = ci + 1;
}
let DIRTY = [map{ x: 0, y: 0, w: 1280, h: 860 }];
let PERF = map{
    draws: 40, skips: 1200, last_draw_ms: 8, avg_draw_ms: 7,
    text_calls: 220, text_skips: 24, text_aa: 0, text_bitmap: 196
};

fn build_plan() {
    return IDE.ide_render_frame_plan(1280, 860, PROFILE, DIRTY, COMMANDS,
        map{ target_fps: 60, parallel: true, perf: PERF });
}

let first = build_plan();
assert(first.runtime_plan.format == "pbide.render.runtime_plan.v1", "render benchmark fixture is valid");
let direct_quality = IDE.ide_render_quality_policy(PERF, PERF, map{ target_fps: 60 });
let direct_runtime = IDE.ide_render_runtime_plan(direct_quality, map{ target_fps: 60, idle_ms: 500 });
assert(first.runtime_plan.throttle == direct_runtime.throttle and
       first.runtime_plan.idle_ms == direct_runtime.idle_ms and
       first.runtime_plan.min_draw_gap_ms == direct_runtime.min_draw_gap_ms and
       first.runtime_plan.input_grace_ms == direct_runtime.input_grace_ms,
       "direct cached runtime decision matches the full frame planner");

let iterations = 1200;
let t0 = now_ms();
let i = 0;
let sink = 0;
while i < iterations {
    let plan = build_plan();
    sink = sink + plan.command_count + plan.runtime_plan.idle_ms;
    i = i + 1;
}
let elapsed = now_ms() - t0;
if sink <= 0 { throw "PBIDE render benchmark sink was not exercised"; }
print "PBIDE_RENDER_PHASE|legacy_plan_per_tick|" + str(iterations) + "|" + str(elapsed) + "|" + str(elapsed / iterations);

// Model 20 seconds of a busy 60 Hz event loop. A completed draw sample arrives
// every ten ticks, but the runtime policy is rebuilt at most once per second.
let cached_t0 = now_ms();
let tick = 0;
let draw_count = 0;
let last_draw_count = 0;
let last_refresh_ms = 0;
let initialized = false;
let refreshes = 0;
let cached_sink = 0;
while tick < iterations {
    if tick % 10 == 0 { draw_count = draw_count + 1; }
    let simulated_ms = tick * 1000 / 60;
    let decision = IDE.ide_render_runtime_cache_policy(
        last_refresh_ms, simulated_ms, last_draw_count, draw_count,
        map{ initialized: initialized, interval_ms: 1000 }
    );
    if decision.refresh {
        let runtime = direct_runtime;
        cached_sink = cached_sink + runtime.idle_ms;
        last_refresh_ms = simulated_ms;
        last_draw_count = draw_count;
        initialized = true;
        refreshes = refreshes + 1;
    }
    cached_sink = cached_sink + decision.bounded_entries;
    tick = tick + 1;
}
let cached_elapsed = now_ms() - cached_t0;
if cached_sink <= 0 or refreshes < 1 or refreshes > 21 { throw "PBIDE cached render benchmark lifecycle mismatch"; }
print "PBIDE_RENDER_PHASE|cached_runtime_policy|" + str(iterations) + "|" + str(cached_elapsed) + "|" + str(cached_elapsed / iterations);
print "PBIDE_RENDER_REFRESHES|" + str(iterations) + "|" + str(refreshes);
print "PBIDE_RENDER_SAVED_PLANS|" + str(iterations - refreshes);
print "PBIDE_RENDER_SUITE|ok";
