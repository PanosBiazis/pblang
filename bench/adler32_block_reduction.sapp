// Measures RFC 1950 Adler-32 block reduction against the former per-byte
// modulo implementation. Both paths run in the same PBLang VM.

let Flate = import("stdlib:flate.sapp");

fn sorted(values) {
    let out = slice(values, 0, len(values));
    let i = 1;
    while i < len(out) {
        let value = out[i];
        let j = i - 1;
        while j >= 0 and out[j] > value {
            out[j + 1] = out[j];
            j = j - 1;
        }
        out[j + 1] = value;
        i = i + 1;
    }
    return out;
}

fn median(values) {
    let out = sorted(values);
    return out[num_floor(len(out) / 2)];
}

fn adler32_per_byte(data) {
    let a = 1;
    let s = 0;
    let i = 0;
    while i < len(data) {
        a = (a + data[i]) % 65521;
        s = (s + a) % 65521;
        i = i + 1;
    }
    return s * 65536 + a;
}

let input = [];
let i = 0;
while i < 12000 {
    array_push(input, (i * 17 + 3) % 256);
    i = i + 1;
}

let expected = 472013194;
if adler32_per_byte(input) != expected or Flate.adler32(input) != expected {
    throw "Adler-32 benchmark correctness gate failed";
}

let samples = 9;
let operations = 5;
let legacy = [];
let blocked = [];
let sample = 0;
while sample < samples {
    let started = now_ms();
    i = 0;
    while i < operations {
        if adler32_per_byte(input) != expected { throw "legacy Adler-32 drift"; }
        i = i + 1;
    }
    array_push(legacy, now_ms() - started);

    started = now_ms();
    i = 0;
    while i < operations {
        if Flate.adler32(input) != expected { throw "blocked Adler-32 drift"; }
        i = i + 1;
    }
    array_push(blocked, now_ms() - started);
    sample = sample + 1;
}

let legacy_warm = slice(legacy, 1, len(legacy));
let blocked_warm = slice(blocked, 1, len(blocked));
let legacy_ms = median(legacy_warm) / operations;
let blocked_ms = median(blocked_warm) / operations;
print json_stringify(map{
    format: "pblang.adler32-block-reduction-benchmark.v1",
    bytes: len(input),
    samples: samples,
    warm_samples: len(legacy_warm),
    operations_per_sample: operations,
    correctness_gate: true,
    per_byte_modulo_median_ms: legacy_ms,
    block_reduced_median_ms: blocked_ms,
    speedup: legacy_ms / blocked_ms,
    latency_reduction_percent: (legacy_ms - blocked_ms) * 100 / legacy_ms
});
