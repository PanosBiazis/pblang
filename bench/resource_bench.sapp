//
// bench/resource_bench.sapp — Pure-PBLang Recursive Fibonacci Peak RSS & Artifact Size Benchmark
//
// Replaces bench/resource_bench.sh. Compares direct x86-64 codegen, C99 transpiler,
// interpreter, and optional installed host compilers, validating exact Fibonacci output.

let CG = import("stdlib:native/codegen_x64.sapp");

fn _collect_args() {
    let raw_env = env_get("PBLANG_SCRIPT_ARGS");
    if raw_env != nil and raw_env != "" {
        let parts = str_split(raw_env, "\n");
        let env_out = [];
        let k = 0;
        while k < len(parts) {
            if parts[k] != "" { array_push(env_out, parts[k]); }
            k = k + 1;
        }
        return env_out;
    }
    let argv = try os_args() catch [];
    if not is_array(argv) { return []; }
    let n = len(argv);
    let i = 0;
    let found = false;
    while i < n {
        let a = str(argv[i]);
        i = i + 1;
        if str_ends_with(a, ".sapp") or str_ends_with(a, ".pbck") { found = true; break; }
    }
    if not found { return []; }
    while i < n {
        let a2 = str(argv[i]);
        if a2 == "--" { i = i + 1; break; }
        if not str_starts_with(a2, "-") { break; }
        i = i + 1;
    }
    let out = [];
    while i < n {
        array_push(out, str(argv[i]));
        i = i + 1;
    }
    return out;
}

fn _find_pb(root: string) {
    let env_b = env_get("PB");
    if env_b != nil and env_b != "" and fs_exists(env_b) { return env_b; }
    if fs_exists(root + "/target/release/pblang") { return root + "/target/release/pblang"; }
    if fs_exists(root + "/pblang") { return root + "/pblang"; }
    return "pblang";
}

fn _have_cmd(tool: string) {
    let r = try proc_spawn_wait("which", [tool]) catch map{ exit_code: 1 };
    return r.exit_code == 0;
}

fn _pad_right(s: string, w: int) {
    let o = s;
    while len(o) < w { o = o + " "; }
    return o;
}

fn _pad_left(s: string, w: int) {
    let o = s;
    while len(o) < w { o = " " + o; }
    return o;
}

fn _row(label: string, res: string, rss: string, sz: string) {
    println(_pad_right(label, 26) + " " + _pad_left(res, 12) + " " + _pad_left(rss, 14) + " " + _pad_left(sz, 12));
}

fn _parse_int(s: string, fallback: int) {
    if len(s) == 0 { return fallback; }
    let neg = false;
    let i = 0;
    if strcharcodeat(s, 0) == 45 { neg = true; i = 1; }
    if i >= len(s) { return fallback; }
    let acc = 0;
    while i < len(s) {
        let c = strcharcodeat(s, i);
        if c < 48 or c > 57 { return fallback; }
        acc = acc * 10 + (c - 48);
        i = i + 1;
    }
    return if neg { 0 - acc } else { acc };
}

fn _expected_fib(n: int) {
    let a = 0;
    let b = 1;
    let i = 0;
    while i < n {
        let nxt = a + b;
        a = b;
        b = nxt;
        i = i + 1;
    }
    return str(a);
}

let args = _collect_args();
let n_val = if len(args) > 0 { _parse_int(args[0], 32) } else { 32 };
if n_val < 0 or n_val > 78 {
    eprint("resource_bench: N must be in 0..78 for exact validation\n");
    os_exit(2);
}
let expected = _expected_fib(n_val);
let root = cwd();
let pb = _find_pb(root);
let work = "/tmp/pb_resource_bench_" + str(num_floor(now_ms()));
fs_mkdirs(work);

let fib_sapp = work + "/fib.sapp";
let fib_src = "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); }\nprint fib(" + str(n_val) + ");\n";
fs_write(fib_sapp, fib_src);

let fib_pblang = work + "/fib_pblang";
fs_write_bytes(fib_pblang, CG.compile_fns(fib_src));
try proc_spawn_wait("chmod", ["755", fib_pblang]) catch nil;

let fib_c99 = work + "/fib_c99";
let _ = try proc_spawn_wait(pb, ["compile", fib_sapp, "--out", fib_c99]) catch nil;

let fib_c_src = work + "/fib.c";
let fib_c_bin = work + "/fib_c";
fs_write(fib_c_src, "#include <stdio.h>\nlong fib(long n) { return n < 2 ? n : fib(n - 1) + fib(n - 2); }\nint main(void) { printf(\"%ld\\n\", fib(" + str(n_val) + ")); return 0; }\n");
if _have_cmd("gcc") {
    try proc_spawn_wait("gcc", ["-O2", "-o", fib_c_bin, fib_c_src]) catch nil;
}

let fib_rs_src = work + "/fib.rs";
let fib_rs_bin = work + "/fib_rust";
fs_write(fib_rs_src, "fn fib(n: u64) -> u64 { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }\nfn main() { println!(\"{}\", fib(" + str(n_val) + ")); }\n");
if _have_cmd("rustc") {
    try proc_spawn_wait("rustc", ["-O", "-o", fib_rs_bin, fib_rs_src]) catch nil;
}

let fib_js = work + "/fib.js";
fs_write(fib_js, "function fib(n){ return n<2?n:fib(n-1)+fib(n-2); }\nconsole.log(fib(" + str(n_val) + "));\n");

_row("target", "result", "peak_rss_kb", "artifact_B");
_row("--------------------------", "------------", "--------------", "------------");

let had_err = false;
let measure = fn(label: string, artifact: string, cmd_bin: string, cmd_args: any) {
    let run_r = proc_spawn_wait(cmd_bin, cmd_args);
    let got = str_trim(str(run_r.stdout));
    if got != expected {
        _row(label, "WRONG:" + got, "-", "-");
        had_err = true;
        return;
    }
    let rss = "-";
    if fs_exists("/usr/bin/time") {
        let mfile = work + "/rss.txt";
        let t_args = ["-f", "%M", "-o", mfile, cmd_bin];
        let i = 0;
        while i < len(cmd_args) {
            array_push(t_args, cmd_args[i]);
            i = i + 1;
        }
        let tr = proc_spawn_wait("/usr/bin/time", t_args);
        if tr.exit_code == 0 and fs_exists(mfile) {
            rss = str_trim(fs_read(mfile));
        }
    }
    let sz = if artifact == "-" or not fs_exists(artifact) { "-" } else { str(len(fs_read_bytes(artifact))) };
    _row(label, got, rss, sz);
};

measure("pblang direct x86-64", fib_pblang, fib_pblang, []);
if fs_exists(fib_c99) {
    measure("pblang native C99", fib_c99, fib_c99, []);
}
measure("pblang interpreter", "-", pb, ["run", fib_sapp]);
if fs_exists(fib_c_bin) {
    measure("C gcc -O2", fib_c_bin, fib_c_bin, []);
}
if fs_exists(fib_rs_bin) {
    measure("Rust rustc -O", fib_rs_bin, fib_rs_bin, []);
}
if _have_cmd("node") {
    measure("JavaScript Node", "-", "node", [fib_js]);
}

let names = try fs_listdir(work) catch [];
let ci = 0;
while ci < len(names) {
    try fs_remove(work + "/" + names[ci]) catch nil;
    ci = ci + 1;
}
try fs_remove(work) catch nil;
if had_err { os_exit(1); }
