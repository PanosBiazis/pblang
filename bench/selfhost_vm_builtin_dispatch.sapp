// Pure-pblang bytecode-VM builtin-dispatch benchmark.
// Compile once, warm once, then execute identical chunks repeatedly.
let FE = import("stdlib/compiler/selfhost_frontend.sapp");
let VM = import("stdlib/compiler/vm.sapp");

fn measure(label, source, expected, rounds) {
    let compiled = FE.frontend_compile(source);
    if not compiled.ok { throw "compile failed for " + label; }

    let warm = VM.run(compiled.chunk);
    if len(warm.output) != 1 or warm.output[0] != expected {
        throw "wrong result for " + label;
    }

    let t0 = now_ms();
    let i = 0;
    while i < rounds {
        VM.run(compiled.chunk);
        i = i + 1;
    }
    let elapsed = now_ms() - t0;
    print label + "_AVG_ms=" + str(elapsed / rounds);
    print label + "_ROUNDS=" + str(rounds);
}

let LEN_SOURCE = "fn work(n) { let values = [1, 2, 3]; let i = 0; let total = 0; while i < n { total = total + len(values); i = i + 1; } print total; } work(10000);";
let SHR_SOURCE = "fn work(n) { let i = 0; let value = 0; while i < n { value = bit_shr(i, 1); i = i + 1; } print value; } work(10000);";

measure("SELFHOST_VM_BUILTIN_LEN", LEN_SOURCE, 30000, 4);
measure("SELFHOST_VM_BUILTIN_SHR", SHR_SOURCE, 4999, 4);
