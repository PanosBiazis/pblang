// Platform-emulator resource/accounting hot paths, entirely in pblang.
let P = import("stdlib:platform_emulator.sapp");

fn stage(name, iterations, work) {
    let t0 = now_ms(); let i = 0;
    while i < iterations { work(); i = i + 1; }
    let elapsed = now_ms() - t0;
    print "PLATFORM_RESOURCE_PHASE|" + name + "|" + str(iterations) + "|" +
          str(elapsed) + "|" + str(elapsed / iterations);
}

let linux = P.resolve("linux", "6.8", "x86_64");
let sparse = P.machine(linux, map{ memory_bytes: 1048576, memory_layout: "sparse" });
let i = 0;
while i < 4096 { P.memory_write(sparse, i * 2, [1]); i = i + 1; }
assert(len(map_keys(sparse.memory)) == P.memory_stats(sparse).resident_cells,
       "legacy and O(1) resident counts agree");

let sink = 0;
stage("legacy_sparse_map_keys", 2000, fn() { sink = sink + len(map_keys(sparse.memory)); });
stage("o1_sparse_resident_count", 2000, fn() { sink = sink + P.memory_stats(sparse).resident_cells; });

let virtual = P.machine(linux, map{
    memory_bytes: 16384, max_files: 256, max_storage_bytes: 65536
});
stage("quota_accounted_file_writes", 256, fn() {
    let n = P.machine_stats(virtual).files;
    let r = P.syscall(virtual, "write_file", map{ path: "/tmp/f" + str(n), data: "payload" });
    if not r.ok { throw "virtual file admission failed"; }
});
let stats = P.machine_stats(virtual);
assert(stats.files == 256 and stats.file_bytes == 256 * 7,
       "file counters and storage bytes match");
assert(not P.syscall(virtual, "write_file", map{ path: "/tmp/overflow", data: "x" }).ok,
       "file count quota remains enforced");

let before = P.memory_read(sparse, 9000, 2).bytes;
assert(not P.memory_write(sparse, 9000, [2, 999]).ok, "invalid batch rejected");
assert(P.memory_read(sparse, 9000, 2).bytes == before, "rejected batch is atomic");

if sink <= 0 { throw "benchmark sink was not exercised"; }
print "PLATFORM_RESOURCE_SUITE|ok";
