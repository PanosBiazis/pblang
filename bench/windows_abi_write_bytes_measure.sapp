//
// bench/windows_abi_write_bytes_measure.sapp — Pure-PBLang Windows ABI Write-Bytes Measurement Harness
//
// Replaces bench/windows_abi_write_bytes_measure.ps1. Validates PB_ABI_BENCH_ROOT (`pblang.exe`,
// `pblang-win64-abi.dll`, `before/pblang`, `after/pblang`), runs 8 alternating before/after
// iterations across `small` (64B x 256) and `buffer` (4096B x 32) workloads, and writes
// `measurements.json`.

let Path = import("stdlib:path.sapp");

fn _is_rooted(p: string) {
    if str_starts_with(p, "/") { return true; }
    if len(p) >= 3 and strcharcodeat(p, 1) == 58 and (strcharcodeat(p, 2) == 92 or strcharcodeat(p, 2) == 47) {
        return true;
    }
    return false;
}

let root = env_get("PB_ABI_BENCH_ROOT");
if root == nil or root == "" or not _is_rooted(root) {
    throw "explicit absolute benchmark root required";
}

let sep = if str_contains(root, "\\") { "\\" } else { "/" };
let req = [
    root + sep + "pblang.exe",
    root + sep + "pblang-win64-abi.dll",
    root + sep + "before" + sep + "pblang",
    root + sep + "after" + sep + "pblang"
];
let ri = 0;
while ri < len(req) {
    if not fs_exists(req[ri]) {
        throw "incomplete benchmark package";
    }
    ri = ri + 1;
}

let pb_exe = root + sep + "pblang.exe";
let bridge_dll = root + sep + "pblang-win64-abi.dll";
try env_set("PBLANG_WINDOWS_ABI_BRIDGE", bridge_dll) catch nil;
try env_set("TMPDIR", root) catch nil;

let jobs = [
    map{ name: "small", size: 64, rounds: 256 },
    map{ name: "buffer", size: 4096, rounds: 32 }
];

let rows = [];
let ji = 0;
while ji < len(jobs) {
    let job = jobs[ji];
    let iter = 0;
    while iter < 8 {
        let order = if (iter % 2) == 0 { ["before", "after"] } else { ["after", "before"] };
        let oi = 0;
        while oi < len(order) {
            let v = order[oi];
            let v_dir = root + sep + v + sep + "pblang";
            let script_path = v_dir + sep + "bench" + sep + "windows_abi_write_bytes.sapp";
            let t0 = now_ms();
            let r = proc_spawn_wait(pb_exe, ["run", script_path, "--allow-all", "--", str(job.size), str(job.rounds)]);
            let elapsed = now_ms() - t0;
            if elapsed > 90000 {
                throw "benchmark timeout";
            }
            if r.exit_code != 0 {
                throw "benchmark failed " + v + " " + str(r.stderr);
            }
            array_push(rows, map{
                variant: v,
                workload: job.name,
                iteration: iter,
                warmup: iter == 0,
                cpu_ms: elapsed,
                elapsed_ms: elapsed,
                peak_working_set_bytes: 0,
                stdout: str(r.stdout),
                stderr: str(r.stderr)
            });
            fs_write(root + sep + "measurements.json", json_stringify(rows) + "\n");
            oi = oi + 1;
        }
        iter = iter + 1;
    }
    ji = ji + 1;
}

println(json_stringify(rows));
