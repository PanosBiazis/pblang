// Repeat aggregate construction over the same 300 metadata names. No file I/O.
let C=import("stdlib:file_catalog.sapp");
let args=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");
let repeats=parse_number(args[0]);
let names=[];
for i 100 {array_push(names,"main.py");array_push(names,"image.png");array_push(names,"archive.tar.gz");}
let t=clock();let checksum=0;
for i repeats {let report=C.summarize(names);checksum=checksum+report.total_files;}
print "CATALOG|"+str(clock()-t)+"|"+str(checksum);
