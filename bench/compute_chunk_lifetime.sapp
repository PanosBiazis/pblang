let CP = import("stdlib:compute.sapp");
let OS = import("stdlib:os.sapp");
let args = OS.script_args();
let count = if len(args) > 0 { parse_number(args[0]) } else { 180000 };
assert(count >= 1 and count <= 500000 and count == num_floor(count), "benchmark count");
let input = []; let i = 0;
while i < count { array_push(input, i); i = i + 1; }
let output = CP.run_chunked(input, fn(x) { return x + 1; }, 4096);
assert(len(output) == count and len(input) == count, "length parity");
i = 0;
while i < count {
    assert(input[i] == i and output[i] == i + 1, "every input and output preserved");
    i = i + 1;
}
print "COMPUTE_CHUNK|" + str(count) + "|pass";
