//
// bench/pblang_phase_suite.sapp — Comprehensive Pure-PBLang Phase/Resource/Backend Suite
//
// Replaces bench/pblang_phase_suite.sh. Produces machine-readable evidence while failing
// closed on any correctness or tool execution error.

fn _collect_args() {
    let raw_env = env_get("PBLANG_SCRIPT_ARGS");
    if raw_env != nil and raw_env != "" {
        let parts = str_split(raw_env, "\n");
        let env_out = [];
        let k = 0;
        while k < len(parts) {
            if parts[k] != "" { array_push(env_out, parts[k]); }
            k = k + 1;
        }
        return env_out;
    }
    let argv = try os_args() catch [];
    if not is_array(argv) { return []; }
    let n = len(argv);
    let i = 0;
    let found = false;
    while i < n {
        let a = str(argv[i]);
        i = i + 1;
        if str_ends_with(a, ".sapp") or str_ends_with(a, ".pbck") { found = true; break; }
    }
    if not found { return []; }
    while i < n {
        let a2 = str(argv[i]);
        if a2 == "--" { i = i + 1; break; }
        if not str_starts_with(a2, "-") { break; }
        i = i + 1;
    }
    let out = [];
    while i < n {
        array_push(out, str(argv[i]));
        i = i + 1;
    }
    return out;
}

fn _find_pb(root: string) {
    let env_b = env_get("PB");
    if env_b != nil and env_b != "" and fs_exists(env_b) { return env_b; }
    if fs_exists(root + "/target/release/pblang") { return root + "/target/release/pblang"; }
    if fs_exists(root + "/pblang") { return root + "/pblang"; }
    return "pblang";
}

fn _chmod_x(path: string) {
    if fs_exists("/bin/chmod") {
        proc_spawn_wait("/bin/chmod", ["755", path]);
    } elif fs_exists("/usr/bin/chmod") {
        proc_spawn_wait("/usr/bin/chmod", ["755", path]);
    } else {
        try proc_spawn_wait("chmod", ["755", path]) catch nil;
    }
}

fn _file_size(path: string) {
    if not fs_exists(path) { return 0; }
    return len(fs_read_bytes(path));
}

fn _utc_stamp() {
    let r = try proc_spawn_wait("date", ["-u", "+%Y%m%dT%H%M%SZ"]) catch map{ exit_code: 1, stdout: "" };
    let s = str_trim(str(r.stdout));
    if s != "" { return s; }
    return str(num_floor(now_ms()));
}

fn _run_timed(fmt: string, res_file: string, append_flag: bool, cmd_bin: string, cmd_args: any) {
    let t_args = ["-f", fmt];
    if append_flag { array_push(t_args, "-a"); }
    array_push(t_args, "-o");
    array_push(t_args, res_file);
    array_push(t_args, cmd_bin);
    let i = 0;
    while i < len(cmd_args) {
        array_push(t_args, cmd_args[i]);
        i = i + 1;
    }
    let r = proc_spawn_wait("/usr/bin/time", t_args);
    if r.exit_code != 0 {
        throw "Timed command failed (" + cmd_bin + "): " + str(r.stderr) + " " + str(r.stdout);
    }
    return str(r.stdout);
}

fn _has_exact_line(text: string, marker: string) {
    let lines = str_split(str_replace_all(text, "\r\n", "\n"), "\n");
    let i = 0;
    while i < len(lines) {
        if lines[i] == marker { return true; }
        i = i + 1;
    }
    return false;
}

fn _has_prefix_line(text: string, pfx: string) {
    let lines = str_split(str_replace_all(text, "\r\n", "\n"), "\n");
    let i = 0;
    while i < len(lines) {
        if str_starts_with(lines[i], pfx) { return true; }
        i = i + 1;
    }
    return false;
}

let root = cwd();
let pb = _find_pb(root);
let stamp = _utc_stamp();
let args = _collect_args();
let out_dir = if len(args) > 0 { args[0] } else { root + "/bench/results/phase-" + stamp };
fs_mkdirs(out_dir);

if not fs_exists("/usr/bin/time") {
    throw "Missing /usr/bin/time required for phase resource measurement";
}

let uname_out = str_trim(str((try proc_spawn_wait("uname", ["-srmo"]) catch map{ stdout: "unknown" }).stdout));
let nproc_out = str_trim(str((try proc_spawn_wait("nproc", []) catch map{ stdout: "1" }).stdout));
let pb_ver = str_trim(str(proc_spawn_wait(pb, ["--version"]).stdout));
let env_txt = "utc=" + stamp + "\n"
    + "kernel=" + uname_out + "\n"
    + "logical_cpus=" + nproc_out + "\n"
    + "pblang=" + pb_ver + "\n";
fs_write(out_dir + "/environment.txt", env_txt);

let phases_out = _run_timed(
    "phase_process_elapsed_s=%e\nphase_process_peak_rss_kb=%M\nphase_process_user_s=%U\nphase_process_sys_s=%S",
    out_dir + "/phase_resources.txt",
    false,
    pb,
    ["run", root + "/bench/pblang_phase_stages.sapp", "--allow-all"]
);
print(phases_out);
fs_write(out_dir + "/phases.txt", phases_out);
if not _has_exact_line(phases_out, "PHASE_SUITE|ok") {
    throw "Missing PHASE_SUITE|ok marker in phases.txt";
}

let c99_stage_out = _run_timed(
    "selfhost_c99_process_elapsed_s=%e\nselfhost_c99_process_peak_rss_kb=%M\nselfhost_c99_process_user_s=%U\nselfhost_c99_process_sys_s=%S",
    out_dir + "/selfhost_c99_resources.txt",
    false,
    pb,
    ["run", root + "/bench/selfhost_c99_stages.sapp", "--allow-exec"]
);
print(c99_stage_out);
fs_write(out_dir + "/selfhost_c99.txt", c99_stage_out);
if not _has_prefix_line(c99_stage_out, "C99_STAGE_SUITE|ok|") {
    throw "Missing C99_STAGE_SUITE|ok| marker in selfhost_c99.txt";
}

let tree_fixtures = [
    ["tree_interpreter_closure", "tree_interpreter_closure_stages.sapp", "CLOSURE_SUITE|ok"],
    ["tree_interpreter_lexical", "tree_interpreter_lexical_cache_stages.sapp", "LEXICAL_CACHE_SUITE|ok"],
    ["tree_interpreter_control", "tree_interpreter_control_stages.sapp", "CONTROL_SUITE|ok"],
    ["tree_interpreter_layout", "tree_interpreter_closure_layout_stages.sapp", "CLOSURE_LAYOUT_SUITE|ok"],
    ["app_facade", "app_facade_stages.sapp", "APP_PHASE_SUITE|ok"],
    ["polyglot_control_plane", "polyglot_control_plane_stages.sapp", "POLYGLOT_CONTROL_PLANE_SUITE|ok"],
    ["ecosystem_vertical", "ecosystem_vertical_stages.sapp", "ECOSYSTEM_VERTICAL_SUITE|ok"],
    ["stdlib_hotpaths", "stdlib_hotpaths_stages.sapp", "STDLIB_HOTPATH_SUITE|ok"],
    ["stdlib_pipeline_hotpaths", "stdlib_pipeline_hotpaths_stages.sapp", "STDLIB_PIPELINE_HOTPATH_SUITE|ok"],
    ["stdlib_data_pipeline_hotpaths", "stdlib_data_pipeline_hotpaths_stages.sapp", "DATA_PIPELINE_HOTPATH_SUITE|ok"],
    ["stdlib_safety_resource", "stdlib_safety_resource_stages.sapp", "SAFETY_RESOURCE_SUITE|ok"],
    ["product_runtime", "product_runtime_stages.sapp", "PRODUCT_RUNTIME_SUITE|ok"],
    ["cache_render", "cache_render_stages.sapp", "CACHE_RENDER_SUITE|ok"],
    ["platform_resource", "platform_resource_stages.sapp", "PLATFORM_RESOURCE_SUITE|ok"]
];

let ti = 0;
while ti < len(tree_fixtures) {
    let fx = tree_fixtures[ti];
    let nm = fx[0];
    let sc = fx[1];
    let mk = fx[2];
    let fx_out = _run_timed(
        nm + "_process_elapsed_s=%e\n" + nm + "_process_peak_rss_kb=%M\n" + nm + "_process_user_s=%U\n" + nm + "_process_sys_s=%S",
        out_dir + "/" + nm + "_resources.txt",
        false,
        pb,
        ["run", root + "/bench/" + sc, "--allow-all"]
    );
    print(fx_out);
    fs_write(out_dir + "/" + nm + ".txt", fx_out);
    if not _has_exact_line(fx_out, mk) {
        throw "Fixture failed marker check: " + nm + " (" + mk + ")";
    }
    ti = ti + 1;
}

let emu_mat_out = _run_timed(
    "platform_emulator_process_elapsed_s=%e\nplatform_emulator_peak_rss_kb=%M\nplatform_emulator_user_s=%U\nplatform_emulator_sys_s=%S",
    out_dir + "/platform_emulator_resources.txt",
    false,
    pb,
    ["run", root + "/bench/platform_emulator_matrix_stages.sapp", "--allow-all"]
);
print(emu_mat_out);
fs_write(out_dir + "/platform_emulator.txt", emu_mat_out);
if not _has_exact_line(emu_mat_out, "PLATFORM_EMULATOR_MATRIX_SUITE|ok") {
    throw "Missing PLATFORM_EMULATOR_MATRIX_SUITE|ok marker";
}

_chmod_x("/tmp/pblang_phase_x64");
let nat_res = proc_spawn_wait("/tmp/pblang_phase_x64", []);
if str_trim(str(nat_res.stdout)) != "6765" {
    throw "Unexpected direct_x64 output: " + str(nat_res.stdout);
}
_run_timed(
    "direct_x64_elapsed_s=%e\ndirect_x64_peak_rss_kb=%M\ndirect_x64_user_s=%U\ndirect_x64_sys_s=%S",
    out_dir + "/direct_x64_resources.txt",
    false,
    "/tmp/pblang_phase_x64",
    []
);
let dx_res_txt = fs_read(out_dir + "/direct_x64_resources.txt");
fs_write(out_dir + "/direct_x64_resources.txt", dx_res_txt + "direct_x64_artifact_bytes=" + str(_file_size("/tmp/pblang_phase_x64")) + "\n");

_chmod_x("/tmp/pblang_phase_x64_stress");
let fib_csv_lines = ["run,elapsed_ms,result"];
let run_idx = 1;
while run_idx <= 5 {
    let t0 = now_ms();
    let sr = proc_spawn_wait("/tmp/pblang_phase_x64_stress", []);
    let t1 = now_ms();
    let s_val = str_trim(str(sr.stdout));
    if s_val != "14930352" {
        throw "Unexpected direct_x64_stress output: " + s_val;
    }
    array_push(fib_csv_lines, str(run_idx) + "," + str(num_floor(t1 - t0)) + "," + s_val);
    run_idx = run_idx + 1;
}
fs_write(out_dir + "/direct_x64_fib36.csv", str_join(fib_csv_lines, "\n") + "\n");
_run_timed(
    "direct_x64_fib36_peak_rss_kb=%M\ndirect_x64_fib36_user_s=%U\ndirect_x64_fib36_sys_s=%S",
    out_dir + "/direct_x64_fib36_resources.txt",
    false,
    "/tmp/pblang_phase_x64_stress",
    []
);
let dxs_txt = fs_read(out_dir + "/direct_x64_fib36_resources.txt");
fs_write(out_dir + "/direct_x64_fib36_resources.txt", dxs_txt + "direct_x64_fib36_artifact_bytes=" + str(_file_size("/tmp/pblang_phase_x64_stress")) + "\n");

let c_t0 = now_ms();
let comp_c99 = proc_spawn_wait(pb, ["compile", "/tmp/pblang_phase_source.sapp", "--out", "/tmp/pblang_phase_c99"]);
if comp_c99.exit_code != 0 {
    throw "pblang compile /tmp/pblang_phase_source.sapp failed";
}
let c99_compile_ms = num_floor(now_ms() - c_t0);
let c99_run = proc_spawn_wait("/tmp/pblang_phase_c99", []);
if str_trim(str(c99_run.stdout)) != "6765" {
    throw "Unexpected /tmp/pblang_phase_c99 result: " + str(c99_run.stdout);
}
let c99_hdr = "c99_compile_ms=" + str(c99_compile_ms) + "\n"
    + "c99_artifact_bytes=" + str(_file_size("/tmp/pblang_phase_c99")) + "\n"
    + "selfhost_c_source_bytes=" + str(_file_size("/tmp/pblang_phase_c99.c")) + "\n";
fs_write(out_dir + "/c99_resources.txt", c99_hdr);
_run_timed(
    "c99_elapsed_s=%e\nc99_peak_rss_kb=%M\nc99_user_s=%U\nc99_sys_s=%S",
    out_dir + "/c99_resources.txt",
    true,
    "/tmp/pblang_phase_c99",
    []
);

let emu_tests = [
    "emu_6502", "emu_avr", "emu_z80", "emu_mips", "emu_msp430",
    "emu_powerpc", "emu_riscv", "emu_sparc", "emu_wasm", "emu_quantum",
    "platform_emulator"
];
let emu_csv = ["emulator,status,elapsed_s,peak_rss_kb"];
let metric_tmp = "/tmp/pb_phase_emu_metric_" + str(num_floor(now_ms())) + ".txt";
let ei = 0;
while ei < len(emu_tests) {
    let ename = emu_tests[ei];
    let tr = proc_spawn_wait("/usr/bin/time", ["-f", "%e,%M", "-o", metric_tmp, pb, "run", root + "/tests/semantics/" + ename + "_test.sapp", "--allow-all"]);
    if tr.exit_code == 0 {
        array_push(emu_csv, ename + ",ok," + str_trim(fs_read(metric_tmp)));
    } else {
        array_push(emu_csv, ename + ",fail,-,-");
        fs_write(out_dir + "/emulators.csv", str_join(emu_csv, "\n") + "\n");
        try fs_remove(metric_tmp) catch nil;
        os_exit(1);
    }
    ei = ei + 1;
}
try fs_remove(metric_tmp) catch nil;
fs_write(out_dir + "/emulators.csv", str_join(emu_csv, "\n") + "\n");

let tmp_clean = ["/tmp/pblang_phase_x64", "/tmp/pblang_phase_x64_stress", "/tmp/pblang_phase_c99", "/tmp/pblang_phase_c99.c", "/tmp/pblang_phase_source.sapp"];
let ci = 0;
while ci < len(tmp_clean) {
    try fs_remove(tmp_clean[ci]) catch nil;
    ci = ci + 1;
}

println("Phase benchmark evidence written to " + out_dir);
