// Correctness-gated phase benchmark for the pure-PBLang worker supervisor.

let thread = import("stdlib:thread.sapp");

fn report(name, rounds, started, checksum) {
    let elapsed = now_ms() - started;
    if checksum != rounds { throw "thread supervisor benchmark checksum failed: " + name; }
    print "SUPERVISOR_PHASE|" + name + "|" + str(rounds) + "|" + str(elapsed)
        + "|" + str(elapsed / rounds) + "|" + str(checksum);
}

let completed_sup = thread.supervisor();
let completed_ids = [];
let completed_rounds = 64;
let started = now_ms();
let i = 0;
while i < completed_rounds {
    array_push(completed_ids, completed_sup.spawn(fn() { return 1; }, 5000));
    i = i + 1;
}
let checksum = 0;
i = 0;
while i < completed_rounds {
    if completed_sup.wait(completed_ids[i], 5000).status == "completed" {
        checksum = checksum + 1;
    }
    i = i + 1;
}
report("spawn_wait_completion", completed_rounds, started, checksum);

let status_rounds = 4096;
started = now_ms();
checksum = 0;
i = 0;
while i < status_rounds {
    if completed_sup.status(completed_ids[i % completed_rounds]).status == "completed" {
        checksum = checksum + 1;
    }
    i = i + 1;
}
report("terminal_status_lookup", status_rounds, started, checksum);

let cancelled_sup = thread.supervisor();
let cancelled_ids = [];
let cancelled_rounds = 32;
i = 0;
while i < cancelled_rounds {
    array_push(cancelled_ids, cancelled_sup.spawn_cooperative(fn(token) {
        let pause = channel_buffered(1);
        while not token.requested(token) { recv_timeout(pause.receiver, 1); }
        return 1;
    }, 5000));
    i = i + 1;
}
started = now_ms();
i = 0;
while i < cancelled_rounds {
    if not cancelled_sup.cancel(cancelled_ids[i], "benchmark") {
        throw "thread supervisor benchmark cancellation request failed";
    }
    i = i + 1;
}
checksum = 0;
i = 0;
while i < cancelled_rounds {
    if cancelled_sup.wait(cancelled_ids[i], 5000).status == "cancelled" {
        checksum = checksum + 1;
    }
    i = i + 1;
}
report("cooperative_cancel_wait", cancelled_rounds, started, checksum);

let completed_stats = completed_sup.stats();
let cancelled_stats = cancelled_sup.stats();
if completed_stats.completed != completed_rounds or completed_stats.active != 0 or
   cancelled_stats.cancelled != cancelled_rounds or cancelled_stats.active != 0 or
   completed_stats.detached != 0 or cancelled_stats.detached != 0 {
    throw "thread supervisor benchmark final-state mismatch";
}

print "SUPERVISOR_SUITE|ok";
