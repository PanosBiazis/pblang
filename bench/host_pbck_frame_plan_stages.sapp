// Reproducible PBLang-only benchmark for compact PBCK decode plus canonical
// frame-plan lowering. Hot instruction lookup is measured separately.
let Plan = import("stdlib:host_pbck_frame_plan.sapp");
let Translate = import("stdlib:selfhost_to_pbck.sapp");

let child = map{
    arity: 1, min_arity: 1,
    upvalues: [map{ index: 0, is_local: true }],
    chunk: map{
        instructions: [
            map{ op: 38, operand: 0 }, map{ op: 16, operand: 0 },
            map{ op: 1 }, map{ op: 39, operand: 0 },
            map{ op: 38, operand: 0 }, map{ op: 19 }
        ], constants: []
    }
};
let source = map{
    instructions: [
        map{ op: 0, operand: 0 }, map{ op: 17, operand: 0 },
        map{ op: 24, operand: 1 }, map{ op: 17, operand: 1 },
        map{ op: 16, operand: 1 }, map{ op: 0, operand: 2 },
        map{ op: 18, operand: 1 }, map{ op: 19 }
    ], constants: [40, child, 2]
};
let bytes = Translate.translate(source);

fn sorted(values) {
    let out = []; let i = 0;
    while i < len(values) { array_push(out, values[i]); i = i + 1; }
    i = 1;
    while i < len(out) {
        let value = out[i]; let j = i - 1;
        while j >= 0 and out[j] > value { out[j + 1] = out[j]; j = j - 1; }
        out[j + 1] = value; i = i + 1;
    }
    return out;
}

let warm = Plan.build_bytes(bytes);
let warm_stats = Plan.stats(warm);
if warm_stats.functions != 2 or warm_stats.instructions != 18 or warm_stats.captures != 1 {
    throw "frame-plan benchmark correctness gate failed";
}

let BUILD_ITERATIONS = 1000;
let LOOKUP_ITERATIONS = 100000;
let SAMPLES = 9;
let build_samples = [];
let lookup_samples = [];
let sample = 0;
while sample < SAMPLES {
    let started = now_ms(); let i = 0; let checksum = 0;
    while i < BUILD_ITERATIONS {
        let plan = Plan.build_bytes(bytes);
        checksum = checksum + len(plan.opcodes) + len(plan.functions);
        i = i + 1;
    }
    if checksum != BUILD_ITERATIONS * 20 { throw "frame-plan build checksum mismatch"; }
    array_push(build_samples, now_ms() - started);

    started = now_ms(); i = 0; checksum = 0;
    while i < LOOKUP_ITERATIONS {
        let instruction = Plan.instruction_at(warm, 0, i % warm.functions[0].instruction_count);
        checksum = checksum + instruction.op;
        i = i + 1;
    }
    if checksum <= 0 { throw "frame-plan lookup checksum mismatch"; }
    array_push(lookup_samples, now_ms() - started);
    sample = sample + 1;
}

let builds = sorted(build_samples);
let lookups = sorted(lookup_samples);
let middle = num_floor(SAMPLES / 2);
print "HOST_PBCK_FRAME_PLAN|stage=compact_decode_flatten"
    + "|iterations=" + str(BUILD_ITERATIONS)
    + "|samples=" + str(SAMPLES)
    + "|median_ms=" + str(builds[middle])
    + "|p95_ms=" + str(builds[SAMPLES - 1])
    + "|median_per_run_ms=" + str(builds[middle] / BUILD_ITERATIONS);
print "HOST_PBCK_FRAME_PLAN|stage=hot_instruction_lookup"
    + "|iterations=" + str(LOOKUP_ITERATIONS)
    + "|samples=" + str(SAMPLES)
    + "|median_ms=" + str(lookups[middle])
    + "|p95_ms=" + str(lookups[SAMPLES - 1])
    + "|median_per_run_ms=" + str(lookups[middle] / LOOKUP_ITERATIONS);
