// Identical workload for baseline/candidate layout RSS and compilation measurements.
let A=import("stdlib:codegen_arm64_ast.sapp");
let B=import("stdlib:benchmark.sapp");
let S=import("tests/fixtures/arm64_branch_sources.sapp");
let source=S.nested_source(24);
let samples=[];let sizes=[];
A.compile_ast(source); // one complete warmup; no artifact retained
for sample in range(0,5) {
    let start=now_ms();let code=A.compile_ast(source);
    push(samples,now_ms()-start);push(sizes,len(code));
}
print json_stringify(map{format:"pblang.arm64.layout.regression.v1",warmups:1,samples:5,
    source_sha256:sha256(source),artifact_sizes:sizes,timing:B.stats("nested24",samples)});
