// pblang-only benchmark for the unified application facade. Imports are warm;
// process-level cold startup is measured separately by the benchmark report.
let APP = import("stdlib/app.sapp");

let CLI_SPEC = map{ kind: "cli", name: "bench", args: ["run"], quiet: true, handler: fn(ctx) { return len(ctx.args); } };
let GUI_SPEC = map{ kind: "gui", name: "bench", preview: true, model: map{ value: "x" }, widgets: [
    map{ kind: "label", text: "Benchmark" }, map{ kind: "textbox", name: "value", bind: "value" }, map{ kind: "button", text: "Save" }
] };
let WEB_SPEC = map{ kind: "web", name: "bench", preview: true, handler: fn(ctx) { return ctx.json(map{ ok: true }); } };
let FULLSTACK_SPEC = map{
    kind: "fullstack", name: "bench", preview: true, start: "web",
    cli: map{ args: ["status"], commands: map{ status: fn(ctx) { return "ok"; } } },
    gui: map{ model: map{ status: "ok" }, widgets: [map{ kind: "label", name: "status", bind: "status" }] },
    web: map{ handler: fn(ctx) { return ctx.json(map{ status: "ok" }); } }
};

fn stage(name, iterations, thunk) {
    let t0 = now_ms();
    let i = 0;
    while i < iterations { thunk(); i = i + 1; }
    let elapsed = now_ms() - t0;
    print "APP_PHASE|" + name + "|" + str(iterations) + "|" + str(elapsed) + "|" + str(elapsed / iterations);
}

if not APP.validate(CLI_SPEC).ok { throw "app benchmark invalid CLI spec"; }
if APP.run(CLI_SPEC).value != 1 { throw "app benchmark CLI mismatch"; }
if APP.run(GUI_SPEC).widgets != 3 { throw "app benchmark GUI mismatch"; }
if APP.run(WEB_SPEC).response.status != 200 { throw "app benchmark web mismatch"; }
if APP.run(FULLSTACK_SPEC).web.response.status != 200 { throw "app benchmark fullstack mismatch"; }
if APP.universal("bench", fn(request) { return request.surface; }, map{ preview: true }).cli.value != "cli" { throw "app benchmark universal mismatch"; }

stage("validate_cli", 1000, fn() { APP.validate(CLI_SPEC); });
stage("plan_gui", 500, fn() { APP.plan(GUI_SPEC); });
stage("dispatch_cli", 500, fn() { APP.run(CLI_SPEC); });
stage("build_gui_preview", 100, fn() { APP.run(GUI_SPEC); });
stage("build_secure_web_preview", 50, fn() { APP.run(WEB_SPEC); });
stage("build_fullstack_preview", 25, fn() { APP.run(FULLSTACK_SPEC); });
stage("compact_cli", 500, fn() { APP.cli("ok", map{ quiet: true, args: [] }); });
stage("compact_gui_preview", 100, fn() { APP.gui("bench", GUI_SPEC.widgets, map{ preview: true }); });
stage("compact_web_preview", 50, fn() { APP.web("bench", WEB_SPEC.handler, map{ preview: true }); });
stage("universal_cli_gui_web_preview", 25, fn() { APP.universal("bench", fn(request) { return request.surface; }, map{ preview: true }); });
print "APP_PHASE_SUITE|ok";
