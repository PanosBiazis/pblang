// Controlled before/after benchmark for pblang-only standard-library hot paths.
// Every optimized path is correctness-gated against its legacy algorithm.
let B = import("stdlib:string_builder.sapp");
let S = import("stdlib:strings.sapp");
let H = import("stdlib:html.sapp");
let DQ = import("stdlib:deque.sapp");
let DS = import("stdlib:data_structures.sapp");

fn stage(name, iterations, thunk) {
    let t0 = now_ms();
    let i = 0;
    while i < iterations { thunk(); i = i + 1; }
    let elapsed = now_ms() - t0;
    print "STDLIB_PHASE|" + name + "|" + str(iterations) + "|" + str(elapsed) + "|" + str(elapsed / iterations);
}

fn legacy_join(parts, separator) {
    let out = "";
    let i = 0;
    while i < len(parts) {
        if i > 0 { out = out + separator; }
        out = out + str(parts[i]);
        i = i + 1;
    }
    return out;
}

let STRING_PARTS = [];
for i in 0 to 2999 { array_push(STRING_PARTS, "part-" + str(i)); }
let EXPECTED_STRING = legacy_join(STRING_PARTS, "|");
if S.join(STRING_PARTS, "|") != EXPECTED_STRING { throw "stdlib benchmark: string join mismatch"; }
let probe = B.new(); B.write_join(probe, STRING_PARTS, "|");
if B.finish(probe) != EXPECTED_STRING { throw "stdlib benchmark: string builder mismatch"; }

fn legacy_queue_round() {
    let queue = [];
    for i in 0 to 2999 { array_push(queue, i); }
    let checksum = 0;
    while len(queue) > 0 {
        checksum = checksum + queue[0];
        let i = 0;
        while i < len(queue) - 1 { queue[i] = queue[i + 1]; i = i + 1; }
        array_pop(queue);
    }
    return checksum;
}

fn deque_round() {
    let queue = DQ.new();
    for i in 0 to 2999 { DQ.push_back(queue, i); }
    let checksum = 0;
    while not DQ.is_empty(queue) { checksum = checksum + DQ.pop_front(queue); }
    return checksum;
}

let QUEUE_SUM = 2999 * 3000 / 2;
if legacy_queue_round() != QUEUE_SUM or deque_round() != QUEUE_SUM { throw "stdlib benchmark: deque checksum mismatch"; }

fn legacy_lru_new(cap) { return map{ cap: cap, items: map{}, order: [] }; }
fn legacy_lru_touch(cache, key) {
    let next = [];
    for current in cache.order { if current != key { array_push(next, current); } }
    array_push(next, key); cache.order = next;
}
fn legacy_lru_put(cache, key, value) {
    if map_has(cache.items, key) { cache.items[key] = value; legacy_lru_touch(cache, key); return; }
    if len(cache.order) >= cache.cap {
        map_remove(cache.items, cache.order[0]);
        let next = []; let i = 1;
        while i < len(cache.order) { array_push(next, cache.order[i]); i = i + 1; }
        cache.order = next;
    }
    cache.items[key] = value; array_push(cache.order, key);
}
fn legacy_lru_get(cache, key) {
    if not map_has(cache.items, key) { return nil; }
    legacy_lru_touch(cache, key); return cache.items[key];
}
fn legacy_lru_round() {
    let cache = legacy_lru_new(512);
    for i in 0 to 511 { legacy_lru_put(cache, "k" + str(i), i); }
    let checksum = 0;
    for i in 0 to 4095 { checksum = checksum + legacy_lru_get(cache, "k" + str(i % 512)); }
    return checksum;
}
fn linked_lru_round() {
    let cache = DS.lru_new(512);
    for i in 0 to 511 { DS.lru_put(cache, "k" + str(i), i); }
    let checksum = 0;
    for i in 0 to 4095 { checksum = checksum + DS.lru_get(cache, "k" + str(i % 512)); }
    return checksum;
}
let LRU_SUM = legacy_lru_round();
if linked_lru_round() != LRU_SUM { throw "stdlib benchmark: LRU checksum mismatch"; }

let HEADERS = [];
for i in 0 to 15 { array_push(HEADERS, "h" + str(i)); }
let ROWS = [];
for r in 0 to 79 {
    let row = [];
    for c in 0 to 15 { array_push(row, "r" + str(r) + "c" + str(c)); }
    array_push(ROWS, row);
}
fn legacy_escape(text) {
    let s = str(text);
    s = regex_replace_all(s, "&", "&amp;");
    s = regex_replace_all(s, "<", "&lt;");
    s = regex_replace_all(s, ">", "&gt;");
    s = regex_replace_all(s, "\"", "&quot;");
    s = regex_replace_all(s, "'", "&#39;");
    return s;
}
fn legacy_table(headers, rows) {
    let result = "<table><thead><tr>";
    for header in headers { result = result + "<th>" + legacy_escape(str(header)) + "</th>"; }
    result = result + "</tr></thead><tbody>";
    for row in rows {
        result = result + "<tr>";
        for cell in row { result = result + "<td>" + legacy_escape(str(cell)) + "</td>"; }
        result = result + "</tr>";
    }
    return result + "</tbody></table>";
}
let EXPECTED_TABLE = legacy_table(HEADERS, ROWS);
if H.table(HEADERS, ROWS) != EXPECTED_TABLE { throw "stdlib benchmark: HTML table mismatch"; }

stage("legacy_string_concat_3000", 8, fn() { legacy_join(STRING_PARTS, "|"); });
stage("chunked_string_join_3000", 8, fn() { S.join(STRING_PARTS, "|"); });
stage("string_builder_3000", 8, fn() { let b = B.new(); B.write_join(b, STRING_PARTS, "|"); B.finish(b); });
stage("legacy_queue_shift_3000", 1, fn() { legacy_queue_round(); });
stage("sparse_deque_fifo_3000", 4, fn() { deque_round(); });
stage("legacy_lru_scan_4096", 1, fn() { legacy_lru_round(); });
stage("linked_lru_o1_4096", 4, fn() { linked_lru_round(); });
stage("legacy_html_table_1280_cells", 3, fn() { legacy_table(HEADERS, ROWS); });
stage("chunked_html_table_1280_cells", 3, fn() { H.table(HEADERS, ROWS); });
print "STDLIB_HOTPATH_SUITE|ok";
