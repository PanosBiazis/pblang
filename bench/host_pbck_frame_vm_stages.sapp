let Binary = import("stdlib:host_pbck_frame_binary.sapp");
let FrameVM = import("stdlib:host_pbck_frame_vm.sapp");
let Plan = import("stdlib:host_pbck_frame_plan.sapp");
let VM = import("stdlib:host_pbck_vm.sapp");

let decoded = map{ format: "host-pbck-v1", version: 1,
    chunk: map{ instructions: [
        map{ op: 14, operand: 0 }, map{ op: 0, operand: 1 },
        map{ op: 31, operand: 1 }, map{ op: 33 }
    ], constants: ["double", 21], source_name: nil } };
let plan = Plan.build_decoded(decoded);
let asset = Binary.encode_plan(plan);
let options = map{ max_steps: 100, adapters: map{ double: fn(args) { return args[0] * 2; } } };
let prepared = FrameVM.prepare(plan);
if FrameVM.run_prepared(prepared, options).value != 42
    or FrameVM.run_bytes(asset, options).value != 42
    or VM.run_decoded(decoded, options).value != 42 {
    throw "host PBCK frame VM benchmark correctness gate failed";
}

fn sorted(values) {
    let out = []; let i = 0;
    while i < len(values) { array_push(out, values[i]); i = i + 1; }
    i = 1;
    while i < len(out) {
        let value = out[i]; let j = i - 1;
        while j >= 0 and out[j] > value { out[j + 1] = out[j]; j = j - 1; }
        out[j + 1] = value; i = i + 1;
    }
    return out;
}

let ITERATIONS = 500; let SAMPLES = 9;
let prepared_samples = []; let direct_samples = []; let asset_samples = [];
let sample = 0;
while sample < SAMPLES {
    let started = now_ms(); let i = 0; let checksum = 0;
    while i < ITERATIONS {
        checksum = checksum + FrameVM.run_prepared(prepared, options).value; i = i + 1;
    }
    if checksum != ITERATIONS * 42 { throw "prepared checksum mismatch"; }
    array_push(prepared_samples, now_ms() - started);

    started = now_ms(); i = 0; checksum = 0;
    while i < ITERATIONS { checksum = checksum + VM.run_decoded(decoded, options).value; i = i + 1; }
    if checksum != ITERATIONS * 42 { throw "direct checksum mismatch"; }
    array_push(direct_samples, now_ms() - started);

    started = now_ms(); i = 0; checksum = 0;
    while i < ITERATIONS { checksum = checksum + FrameVM.run_bytes(asset, options).value; i = i + 1; }
    if checksum != ITERATIONS * 42 { throw "asset checksum mismatch"; }
    array_push(asset_samples, now_ms() - started);
    sample = sample + 1;
}

let names = ["prepared", "direct_vm", "decode_prepare_run"];
let groups = [sorted(prepared_samples), sorted(direct_samples), sorted(asset_samples)];
let middle = num_floor(SAMPLES / 2); let g = 0;
while g < len(groups) {
    print "HOST_PBCK_FRAME_VM|stage=" + names[g] + "|iterations=" + str(ITERATIONS)
        + "|samples=" + str(SAMPLES) + "|median_ms=" + str(groups[g][middle])
        + "|p95_ms=" + str(groups[g][SAMPLES - 1])
        + "|median_per_run_ms=" + str(groups[g][middle] / ITERATIONS);
    g = g + 1;
}
