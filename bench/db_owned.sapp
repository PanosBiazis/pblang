// Both paths import the same libraries and open/query/close in-memory SQLite.
let D=import("../stdlib/db.sapp");
let O=import("../stdlib/db_owned.sapp");
let mode=env_get("PBLANG_SCRIPT_ARGS");
if mode != "manual" and mode != "automatic" {throw "expected manual or automatic";}
fn body(c) {return D.query_value(c,"select 42",[]);}
fn manual() {
    let c=D.sqlite.open(":memory:");
    let result=try [true,body(c)] catch [false,nil];
    c.close();
    if not result[0] {throw "benchmark callback failed";}
    return result[1];
}
fn automatic() {return O.with_sqlite(":memory:",body);}
let work=if mode == "manual" {manual} else {automatic};
let start=clock();
let sum=0;
for i 2000 {sum=sum+work();}
let elapsed=clock()-start;
if sum != 84000 {throw "benchmark output mismatch";}
print "DB_OWNED|"+mode+"|"+str(elapsed)+"|ok";
