let Before=import("fixtures/study_cards_before_edit.sapp");let After=import("stdlib:study_cards.sapp");
fn batch(f,deck) {let start=clock();for i in range(0,4) {f(deck);}return (clock()-start)*1000/4;}
let results=[];
for count in [1,16,64] {
 let pairs=[];for i in range(0,count) {array_push(pairs,map{prompt:"Synthetic question "+str(i),answer:"Synthetic answer."});}
 let deck=After.create("Synthetic benchmark",pairs,"2026-09-27");assert(Before.encode(deck)==After.encode(deck),"identical encoding");
 for i in range(0,3) {batch(Before.encode,deck);batch(After.encode,deck);}
 let before=[];let after=[];
 for i in range(0,9) {if i%2==0 {array_push(before,batch(Before.encode,deck));array_push(after,batch(After.encode,deck));} else {array_push(after,batch(After.encode,deck));array_push(before,batch(Before.encode,deck));}}
 array_push(results,map{cards:count,before_ms:before,after_ms:after});
}
print json_stringify(map{clock:"wall",warmups:3,samples:9,repetitions:4,results:results});
