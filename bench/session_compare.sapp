// One reviewed competitor row per process; run from the repository root.
// The external supervisor must bound wall time, address space and output.
let R = import("stdlib:repro_benchmark.sapp");
let language = env_get("PB_BENCH_LANGUAGE") ?? "pblang-interpreter";
let workload = env_get("PB_BENCH_WORKLOAD") ?? "startup";
let permitted = ["pblang-interpreter", "pblang-c99", "pblang-codegen-x64", "c", "python", "javascript"];
let found = false;
for id in permitted { if language == id { found = true; } }
if not found { throw "session_compare: unsupported language selection"; }
if workload != "startup" and workload != "integer_kernel" {
    throw "session_compare: unsupported workload selection";
}
let row = R.benchmark_language(language, workload, 3, 5, 10);
// Do not serialize tool paths, temporary paths, raw stdout/stderr or failure detail.
let report = map{ language: language, workload: workload, status: row.status };
if row.status == "ok" {
    report.checksum = row.checksum;
    report.source_bytes = row.source_bytes;
    report.artifact_bytes = row.artifact_size_bytes;
    report.compile_first_ms = row.compile_cold_ms;
    report.compile_samples_ms = row.compile_samples_ms;
    report.compile_stats = row.compile_warm;
    report.run_first_ms = row.run_cold_ms;
    report.run_samples_ms = row.run_samples_ms;
    report.run_stats = row.run_warm;
    report.peak_rss_kib_stats = row.rss_warm;
    report.cpu_percent_stats = row.cpu_warm;
}
print json_stringify(report);
if row.status != "ok" and row.status != "unavailable" {
    throw "session_compare: benchmark row failed; no performance claim";
}
