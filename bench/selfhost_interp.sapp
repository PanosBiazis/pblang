//
// bench/selfhost_interp.sapp — Pure-PBLang Self-Hosted Native Evaluator Suite
//
// Replaces bench/selfhost_interp.sh. Flattens `tokenizer.sapp` + `parser.sapp` +
// `checked_source.sapp` + `interp.sapp`, compiles them to native x86-64 ELF64 via
// `codegen_x64.sapp`, and verifies all 28 self-hosted evaluation cases.

let CG = import("stdlib:native/codegen_x64.sapp");

fn _strip_parser_for_native(par_raw: string) {
    let cut_idx = str_index_of(par_raw, "\nfn print_ast");
    let body = if cut_idx >= 0 { str_slice(par_raw, 0, cut_idx) } else { par_raw };
    let lines = str_split(str_replace_all(body, "\r\n", "\n"), "\n");
    let out = [];
    let skip_push = false;
    let i = 0;
    while i < len(lines) {
        let ln = lines[i];
        let tr = str_trim(ln);
        if str_starts_with(tr, "fn push(arr, value)") {
            if not str_contains(tr, "}") { skip_push = true; }
        } elif skip_push {
            if str_contains(tr, "}") { skip_push = false; }
        } else {
            array_push(out, ln);
        }
        i = i + 1;
    }
    return str_join(out, "\n") + "\n";
}

fn _strip_checked_source(raw: string) {
    let lines = str_split(str_replace_all(raw, "\r\n", "\n"), "\n");
    let out = [];
    let i = 0;
    while i < len(lines) {
        let ln = lines[i];
        if not str_starts_with(ln, "let Tokens = import") and not str_starts_with(ln, "let Parser = import") and not str_starts_with(ln, "export ") {
            let r1 = str_replace_all(ln, "Tokens.tokenize_bounded", "tokenize_bounded");
            let r2 = str_replace_all(r1, "Parser.parse", "parse");
            array_push(out, r2);
        }
        i = i + 1;
    }
    return str_join(out, "\n") + "\n";
}

fn _strip_interp_source(raw: string) {
    let lines = str_split(str_replace_all(raw, "\r\n", "\n"), "\n");
    let out = [];
    let i = 0;
    while i < len(lines) {
        let ln = lines[i];
        if not str_starts_with(ln, "let _SOURCE = import") and not str_starts_with(ln, "export ") {
            array_push(out, str_replace_all(ln, "_SOURCE.parse_source", "parse_source"));
        }
        i = i + 1;
    }
    return str_join(out, "\n") + "\n";
}

let root = cwd();
let tok_src = fs_read(root + "/stdlib/compiler/tokenizer.sapp");
let par_src = _strip_parser_for_native(fs_read(root + "/stdlib/compiler/parser.sapp"));
let chk_src = _strip_checked_source(fs_read(root + "/stdlib/compiler/checked_source.sapp"));
let int_src = _strip_interp_source(fs_read(root + "/stdlib/compiler/interp.sapp"));
let base_src = tok_src + "\n" + par_src + "\n" + chk_src + "\n" + int_src;

let work = "/tmp/pb_selfhost_interp_" + str(num_floor(now_ms()));
fs_mkdirs(work);
let nat_bin = work + "/n.bin";

let passed = 0;
let failed = 0;

let check_case = fn(prog: string, expected: string) {
    let esc = str_replace_all(prog, "\"", "\\\"");
    let full_src = base_src + "\nlet src = \"" + esc + "\";\neval_program(src);\n";
    let elf_bytes = nil;
    let err_msg = "";
    try {
        elf_bytes = CG.compile_fns(full_src);
    } catch e {
        err_msg = str(e);
    }
    if err_msg != "" or elf_bytes == nil {
        println("FAIL [" + prog + "]: native compile error: " + err_msg);
        failed = failed + 1;
        return;
    }
    fs_write_bytes(nat_bin, elf_bytes);
    try proc_spawn_wait("chmod", ["755", nat_bin]) catch nil;
    let r = proc_spawn_wait(nat_bin, []);
    let norm = str_trim(str_replace_all(str_replace_all(str(r.stdout), "\r\n", "\n"), "\n", " "));
    if norm == expected {
        passed = passed + 1;
    } else {
        println("FAIL [" + prog + "]: got '" + norm + "' expected '" + expected + "'");
        failed = failed + 1;
    }
};

check_case("print 42;", "42");
check_case("print 3 + 4 * 2 - 1;", "10");
check_case("print 2 * 3 + 4 * 5;", "26");
check_case("print 10 + 20 + 30;", "60");
check_case("print 100 - 6 * 3;", "82");
check_case("print 7 - 2 - 1;", "4");
check_case("let x = 5; print x + 3;", "8");
check_case("let a = 10; let b = 20; print a + b;", "30");
check_case("let i = 0; while i < 5 { print i; i = i + 1; }", "0 1 2 3 4");
check_case("fn sq(n){ return n * n; } print sq(7);", "49");
check_case("fn fib(n){ if n<2 { return n; } return fib(n-1)+fib(n-2); } print fib(10);", "55");
check_case("fn mk(a){ return fn(b){ return a+b; }; } let add5=mk(5); print add5(10);", "15");
check_case("print \"hi\";", "hi");
check_case("let s = \"ab\"; if s == \"ab\" { print 1; } else { print 0; }", "1");
check_case("let w = \"cat\"; if w != \"dog\" { print 1; } else { print 0; }", "1");
check_case("fn g(n){ if n == 0 { return \"zero\"; } return \"pos\"; } print g(0); print g(9);", "zero pos");
check_case("let a = [10, 20, 30]; print a[1];", "20");
check_case("let a = [1, 2, 3]; a[0] = 99; print a[0];", "99");
check_case("let a = [5, 6, 7]; let s = 0; let i = 0; while i < 3 { s = s + a[i]; i = i + 1; } print s;", "18");
check_case("let m = map{ a: 1, b: 2 }; print m.a + m.b;", "3");
check_case("let m = map{}; m.k = 5; print m.k;", "5");
check_case("let m = map{ name: \"bob\" }; print m.name;", "bob");
check_case("let s = 0; for i 5 { s = s + i; } print s;", "10");
check_case("for i in 1 to 3 { print i; }", "1 2 3");
check_case("let a=[10,20,30]; let t=0; for x in a { t = t + x; } print t;", "60");
check_case("let s=0; for i 10 { if i == 5 { break; } s = s + 1; } print s;", "5");
check_case("let s=0; for i 5 { if i == 2 { continue; } s = s + i; } print s;", "8");
check_case("let i=0; while i<8 { i = i+1; if i==3 { continue; } if i==6 { break; } print i; }", "1 2 4 5");

try fs_remove(nat_bin) catch nil;
try fs_remove(work) catch nil;

let suffix = if failed > 0 { " (" + str(failed) + " FAILED)" } else { "" };
println("selfhost_interp: " + str(passed) + "/" + str(passed + failed) + " passed" + suffix);
if failed > 0 { os_exit(1); }
