// Identical workload for old/current module comparison in disposable fixtures.
// Warm up each variant, then alternate at least nine measured runs. Measure the
// process CPU and peak RSS externally; this workload sends no nonzero signals.
let P=import("stdlib:linux_pidfd.sapp");
let current=P.current_pid();assert(current.ok,"current identity required");
for i 100000 {
    let held=P.open(current.pid);
    assert(held.ok and P.close(held),"identity acquired and released");
}
print "100000 released";
