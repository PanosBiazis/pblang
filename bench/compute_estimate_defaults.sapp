// Supplement the existing routing workloads with explicit and absent hints.
let CP = import("stdlib:compute.sapp");
let OS = import("stdlib:os.sapp");
let args = OS.script_args();
let mode = if len(args) > 0 { args[0] } else { "missing" };
let rounds = if len(args) > 1 { parse_number(args[1]) } else { 100000 };
assert(mode == "missing" or mode == "explicit", "benchmark mode");
assert(rounds >= 1 and rounds <= 100000 and rounds == num_floor(rounds), "benchmark rounds");
let cfg = map{ format: "pblang.compute.policy.v1", workload: "tensor" };
if mode == "explicit" { cfg.work_units_per_item = 4096; cfg.transfer_bytes_per_item = 16; }
let checksum = 0; let i = 0;
while i < rounds {
    let value = CP.estimate_work(3, cfg);
    assert(value.work_units == 12288 and value.transfer_bytes == 48, "estimate parity");
    checksum = checksum + value.work_units;
    i = i + 1;
}
print "COMPUTE_ESTIMATE_DEFAULTS|" + mode + "|" + str(rounds) + "|" + str(checksum);
