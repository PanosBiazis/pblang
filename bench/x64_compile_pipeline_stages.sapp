// Separates process startup, backend import, in-process emission, and full publication.
let X64 = import("stdlib/native/codegen_x64.sapp");
let BENCH = import("stdlib/benchmark.sapp");
let UUID = import("stdlib/uuid.sapp");

let PBLANG = "./target/release/pblang";
let SOURCE = "let s = 0; let i = 0; while i < 1000000 { s = (s + (i % 1000) * 17 + 3) % 1000003; i = i + 1; } print s;";

fn child_samples(name, args, repetitions) {
    let samples = [];
    let i = 0;
    while i < repetitions {
        let t0 = now_ms();
        let result = proc_spawn_wait(PBLANG, args);
        let elapsed = now_ms() - t0;
        if result.exit_code != 0 { throw "x64 compile pipeline failed: " + name + ": " + result.stderr; }
        array_push(samples, elapsed);
        i = i + 1;
    }
    let s = BENCH.stats(name, samples);
    print "X64_COMPILE_STAGE|" + name + "|" + str(s.median_ms) + "|" + str(s.p95_ms) + "|" + str(samples);
    return s;
}

fn in_process_samples(repetitions) {
    let samples = [];
    let i = 0;
    while i < repetitions {
        let t0 = now_ms();
        let bin = X64.compile_fns(SOURCE);
        let elapsed = now_ms() - t0;
        if len(bin) < 120 or bin[0] != 127 or bin[1] != 69 { throw "x64 in-process artifact invalid"; }
        array_push(samples, elapsed);
        i = i + 1;
    }
    let s = BENCH.stats("in_process_emit", samples);
    print "X64_COMPILE_STAGE|in_process_emit|" + str(s.median_ms) + "|" + str(s.p95_ms) + "|" + str(samples);
    return s;
}

fn cache_cold_samples(root, source_file, artifact_file, repetitions) {
    let samples = []; let i = 0;
    while i < repetitions {
        let one_root = root + "_cold_" + str(i);
        let t0 = now_ms();
        let result = proc_spawn_wait(PBLANG, ["run", "bench/drivers/repro_codegen_x64_cached.sapp", "--allow-all", "--", source_file, artifact_file, one_root]);
        let elapsed = now_ms() - t0;
        if result.exit_code != 0 or not str_starts_with(str_trim(result.stdout), "miss|") { throw "x64 cold cache fixture failed: " + result.stderr; }
        array_push(samples, elapsed);
        try proc_spawn_wait("rm", ["-rf", "--", one_root]) catch nil;
        i = i + 1;
    }
    let s = BENCH.stats("cache_cold_publish", samples);
    print "X64_COMPILE_STAGE|cache_cold_publish|" + str(s.median_ms) + "|" + str(s.p95_ms) + "|" + str(samples);
    return s;
}

fn non_negative(value) {
    if value < 0 { return 0; }
    return value;
}

let root = "/tmp/pblang_x64_compile_pipeline_" + UUID.v4();
let source_path = root + ".sapp";
let artifact_path = root + ".elf";
let cache_root = root + "_cache";
fs_write(source_path, SOURCE);

print "X64_COMPILE_SCHEMA|stage|median_ms|p95_ms|samples_ms";
let startup = child_samples("process_startup", ["run", "bench/drivers/repro_empty.sapp"], 9);
let backend = child_samples("backend_import", ["run", "bench/drivers/repro_codegen_x64_import.sapp"], 9);
let emitter = in_process_samples(19);
let full = child_samples("full_uncached_publish", ["run", "bench/drivers/repro_codegen_x64.sapp", "--allow-all", "--", source_path, artifact_path], 9);
let cold_cache = cache_cold_samples(cache_root, source_path, artifact_path, 5);
let primed = proc_spawn_wait(PBLANG, ["run", "bench/drivers/repro_codegen_x64_cached.sapp", "--allow-all", "--", source_path, artifact_path, cache_root]);
if primed.exit_code != 0 or not str_starts_with(str_trim(primed.stdout), "miss|") { throw "x64 cache priming failed: " + primed.stderr; }
let warm_cache = child_samples("cache_warm_publish", ["run", "bench/drivers/repro_codegen_x64_cached.sapp", "--allow-all", "--", source_path, artifact_path, cache_root], 9);
let driver_build = proc_spawn_wait(PBLANG,
    ["run", "tools/pbcodegen_cache.sapp", "--allow-all"]);
let driver_report = try json_parse(str_trim(driver_build.stdout)) catch nil;
if driver_build.exit_code != 0 or type(driver_report) != "map"
    or not driver_report.ok or not fs_exists(driver_report.artifact) {
    throw "x64 precompiled driver build failed: " + driver_build.stderr;
}
let precompiled = child_samples("precompiled_full_publish",
    ["run", driver_report.artifact, "--allow-all", "--", source_path, artifact_path], 9);

fn resource_sample(name, args) {
    let command = [ "-f", "X64_COMPILE_RSS|" + name + "|%M|KiB", PBLANG ];
    let i = 0;
    while i < len(args) { array_push(command, args[i]); i = i + 1; }
    let measured = proc_spawn_wait("/usr/bin/time", command);
    if measured.exit_code != 0 {
        throw "x64 resource sample failed: " + name + ": " + measured.stderr;
    }
    let lines = str_split(measured.stderr, "\n");
    i = 0;
    while i < len(lines) {
        if str_starts_with(lines[i], "X64_COMPILE_RSS|") { print lines[i]; }
        i = i + 1;
    }
}
resource_sample("source_import_full_publish",
    ["run", "bench/drivers/repro_codegen_x64.sapp", "--allow-all", "--",
        source_path, artifact_path]);
resource_sample("precompiled_full_publish",
    ["run", driver_report.artifact, "--allow-all", "--",
        source_path, artifact_path]);

let import_overhead = non_negative(backend.median_ms - startup.median_ms);
let uncached_overhead = non_negative(full.median_ms - emitter.median_ms);
let emitter_share = if full.median_ms > 0 { emitter.median_ms * 100 / full.median_ms } else { 0 };
let warm_speedup = if warm_cache.median_ms > 0 { full.median_ms / warm_cache.median_ms } else { 0 };
print "X64_COMPILE_DERIVED_SCHEMA|metric|value|unit";
print "X64_COMPILE_DERIVED|cold_backend_import_overhead|" + str(import_overhead) + "|ms";
print "X64_COMPILE_DERIVED|uncached_non_emitter_overhead|" + str(uncached_overhead) + "|ms";
print "X64_COMPILE_DERIVED|emitter_share|" + str(emitter_share) + "|percent";
print "X64_COMPILE_DERIVED|warm_cache_speedup|" + str(warm_speedup) + "|ratio";
print "X64_COMPILE_DERIVED|cold_cache_penalty|" + str(non_negative(cold_cache.median_ms - full.median_ms)) + "|ms";
print "X64_COMPILE_DERIVED|precompiled_speedup|" + str(full.median_ms / precompiled.median_ms) + "|ratio";
print "X64_COMPILE_DERIVED|precompiled_driver_bytes|" + str(driver_report.bytes) + "|bytes";

try fs_remove(source_path) catch nil;
try fs_remove(artifact_path) catch nil;
try proc_spawn_wait("rm", ["-rf", "--", cache_root]) catch nil;
print "X64_COMPILE_STAGE_SUITE|ok";
