// Correctness-gated builtin-resolution benchmark for the pure-pblang tree
// interpreter. Compile once, warm once, then report distribution statistics
// for repeated execution with fresh interpreter environments.
let INT = import("stdlib/compiler/interp.sapp");

let LEN_SOURCE =
    "fn work(n) { let a = [1, 2, 3, 4]; let i = 0; let total = 0; "
    + "while i < n { total = total + len(a); i = i + 1; } return total; } "
    + "if work(15000) != 60000 { missing(); }";

let MAP_SOURCE =
    "fn work(n) { let m = map{x: 7}; let i = 0; let total = 0; "
    + "while i < n { if map_has(m, \"x\") { total = total + 1; } i = i + 1; } return total; } "
    + "if work(15000) != 15000 { missing(); }";

let STRING_SOURCE =
    "fn work(n) { let i = 0; let total = 0; while i < n { "
    + "if str_starts_with(\"pblang\", \"pb\") { total = total + 1; } i = i + 1; } return total; } "
    + "if work(15000) != 15000 { missing(); }";

let MIXED_SOURCE =
    "fn work(n) { let a = [1, 2, 3, 4]; let m = map{x: 7}; let i = 0; let total = 0; "
    + "while i < n { total = total + len(a); if map_has(m, \"x\") { total = total + 1; } "
    + "if str_starts_with(\"pblang\", \"pb\") { total = total + 1; } i = i + 1; } return total; } "
    + "if work(5000) != 30000 { missing(); }";

let LEN_LOOP = INT.compile_program(LEN_SOURCE);
let MAP_LOOP = INT.compile_program(MAP_SOURCE);
let STRING_LOOP = INT.compile_program(STRING_SOURCE);
let MIXED_LOOP = INT.compile_program(MIXED_SOURCE);

// Controlled copies retain prepared builtin dispatch but force the former
// dynamic scope check. AST paths are asserted before mutation so parser drift
// fails loud.
let LEN_DYNAMIC = INT.compile_program(LEN_SOURCE);
let MAP_DYNAMIC = INT.compile_program(MAP_SOURCE);
let STRING_DYNAMIC = INT.compile_program(STRING_SOURCE);
let MIXED_DYNAMIC = INT.compile_program(MIXED_SOURCE);

fn require_direct(call, label) {
    if call["@ib"] != true or call["@iu"] != true {
        throw "builtin-resolution control path changed: " + label;
    }
    call["@iu"] = false;
}

require_direct(LEN_DYNAMIC.stmts[0].body.stmts[3].body.stmts[0].expr.value.right, "len");
require_direct(MAP_DYNAMIC.stmts[0].body.stmts[3].body.stmts[0].cond, "map_has");
require_direct(STRING_DYNAMIC.stmts[0].body.stmts[2].body.stmts[0].cond, "str_starts_with");
require_direct(MIXED_DYNAMIC.stmts[0].body.stmts[4].body.stmts[0].expr.value.right, "mixed len");
require_direct(MIXED_DYNAMIC.stmts[0].body.stmts[4].body.stmts[1].cond, "mixed map_has");
require_direct(MIXED_DYNAMIC.stmts[0].body.stmts[4].body.stmts[2].cond, "mixed str_starts_with");

fn percentile_index(count, percentile) {
    let index = num_floor((count - 1) * percentile);
    if index < 0 { return 0; }
    if index >= count { return count - 1; }
    return index;
}

fn measure(name, ast, sample_count) {
    if INT.eval_ast(ast) != true { throw "builtin-resolution benchmark warmup failed: " + name; }

    let samples = [];
    let i = 0;
    while i < sample_count {
        let started = now_ms();
        if INT.eval_ast(ast) != true { throw "builtin-resolution benchmark failed: " + name; }
        array_push(samples, now_ms() - started);
        i = i + 1;
    }

    let sorted = array_sort(samples);
    let total = 0.0;
    i = 0;
    while i < len(sorted) { total = total + sorted[i]; i = i + 1; }
    let p50 = sorted[percentile_index(len(sorted), 0.50)];
    let p95 = sorted[percentile_index(len(sorted), 0.95)];
    print "BUILTIN_RESOLUTION|" + name + "|" + str(sample_count)
        + "|" + str(total / sample_count) + "|" + str(p50) + "|" + str(p95)
        + "|" + str(sorted[0]) + "|" + str(sorted[len(sorted) - 1]) + "|ok";
}

fn measure_pair(name, dynamic_ast, direct_ast, sample_count) {
    if INT.eval_ast(dynamic_ast) != true or INT.eval_ast(direct_ast) != true {
        throw "builtin-resolution paired warmup failed: " + name;
    }
    let dynamic_samples = [];
    let direct_samples = [];
    let i = 0;
    while i < sample_count {
        let started = 0;
        if i % 2 == 0 {
            started = now_ms(); INT.eval_ast(dynamic_ast);
            array_push(dynamic_samples, now_ms() - started);
            started = now_ms(); INT.eval_ast(direct_ast);
            array_push(direct_samples, now_ms() - started);
        } else {
            started = now_ms(); INT.eval_ast(direct_ast);
            array_push(direct_samples, now_ms() - started);
            started = now_ms(); INT.eval_ast(dynamic_ast);
            array_push(dynamic_samples, now_ms() - started);
        }
        i = i + 1;
    }
    let dynamic_sorted = array_sort(dynamic_samples);
    let direct_sorted = array_sort(direct_samples);
    let dynamic_p50 = dynamic_sorted[percentile_index(len(dynamic_sorted), 0.50)];
    let direct_p50 = direct_sorted[percentile_index(len(direct_sorted), 0.50)];
    let change = 0.0;
    if dynamic_p50 > 0 { change = (direct_p50 - dynamic_p50) * 100 / dynamic_p50; }
    print "BUILTIN_RESOLUTION_CONTROL|" + name + "|" + str(sample_count)
        + "|" + str(dynamic_p50) + "|" + str(direct_p50) + "|" + str(change) + "|ok";
}

print "SCHEMA|name|samples|average_ms|p50_ms|p95_ms|min_ms|max_ms|status";
measure("len_15000", LEN_LOOP, 9);
measure("map_has_15000", MAP_LOOP, 9);
measure("str_starts_with_15000", STRING_LOOP, 9);
measure("mixed_collections_5000", MIXED_LOOP, 9);
print "CONTROL_SCHEMA|name|paired_samples|dynamic_scope_p50_ms|direct_p50_ms|change_percent|status";
measure_pair("len_15000", LEN_DYNAMIC, LEN_LOOP, 7);
measure_pair("map_has_15000", MAP_DYNAMIC, MAP_LOOP, 7);
measure_pair("str_starts_with_15000", STRING_DYNAMIC, STRING_LOOP, 7);
measure_pair("mixed_collections_5000", MIXED_DYNAMIC, MIXED_LOOP, 7);
print "BUILTIN_RESOLUTION_SUITE|ok";
