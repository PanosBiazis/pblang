// Trusted analysis-only source; the named source/sink functions are never run.
let T=import("stdlib:security_taint.sapp");let B=import("stdlib:benchmark.sapp");
let source="fn save(path) {fs_write(path,\"fixed\");}\nlet requested=env_get(\"INPUT\");save(requested);";
let first=0;let samples=[];
for iteration 8 {
    let start=now_ms();let last=nil;
    for repeat 10 {last=T.analyze(source,"fixture.sapp");}
    let elapsed=now_ms()-start;
    if not last.ok or last.passed or last.finding_count!=1 or not last.interprocedural_complete {
        throw "taint benchmark: semantic control";
    }
    if iteration==0 {first=elapsed;}
    if iteration>=3 {push(samples,elapsed);}
}
print json_stringify(map{operation:"analyze-interprocedural-taint",invocations_per_sample:10,
    first_ms:first,samples_ms:samples,stats:B.stats("analyze-interprocedural-taint",samples)});
