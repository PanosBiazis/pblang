// Correctness-gated local benchmark for cache/data-store hot paths. It compares
// PBLang implementations on the same process and input; it is not a universal
// database or language-performance claim. Redis is excluded unless an external,
// explicitly configured service is available.
let B = import("stdlib:benchmark.sapp");
let C = import("stdlib:cache.sapp");
let S = import("stdlib:data_store.sapp");

fn phase(name, operations, samples, work) {
    let warm = 0;
    while warm < 2 {
        let i = 0; while i < operations { work(i); i = i + 1; }
        warm = warm + 1;
    }
    let times = [];
    let sample = 0;
    while sample < samples {
        let started = now_ms();
        let i = 0; while i < operations { work(i); i = i + 1; }
        array_push(times, now_ms() - started);
        sample = sample + 1;
    }
    let result = B.stats(name, times);
    result.operations_per_sample = operations;
    result.ns_per_operation = (result.median_ms * 1000000.0) / operations;
    print "DATA_STORE_PHASE|" + name + "|" + json_stringify(result);
    return result;
}

let fifo = C.bounded_policy(0, 1024, 1024, "fifo");
let lru = C.bounded_policy(0, 1024, 1024, "lru");
let i = 0;
while i < 1024 { C.set(fifo, "k" + str(i), i); C.set(lru, "k" + str(i), i); i = i + 1; }
let sink = 0;
phase("cache_fifo_get", 20000, 9, fn(index) { sink = sink + C.get(fifo, "k" + str(index % 1024)); });
phase("cache_lru_get", 20000, 9, fn(index) { sink = sink + C.get(lru, "k" + str(index % 1024)); });

let memory = S.memory(map{ namespace: "bench", max_entries: 1024, max_units: 8388608, policy: "fifo" });
i = 0; while i < 1024 { assert(S.set(memory, "k" + str(i), i).ok, "memory fixture admission"); i = i + 1; }
phase("data_store_memory_get", 10000, 9, fn(index) { sink = sink + S.get(memory, "k" + str(index % 1024)); });
phase("data_store_memory_replace", 5000, 9, fn(index) { assert(S.set(memory, "k" + str(index % 1024), index).ok, "memory replace"); });
assert(S.stats(memory).size == 1024, "memory benchmark remains bounded");

let sqlite = S.sqlite(":memory:", map{ namespace: "bench", max_entries: 1024, max_units: 8388608 });
i = 0; while i < 1024 { assert(S.set(sqlite, "k" + str(i), i).ok, "SQLite fixture admission"); i = i + 1; }
phase("data_store_sqlite_get", 1000, 9, fn(index) { sink = sink + S.get(sqlite, "k" + str(index % 1024)); });
phase("data_store_sqlite_replace", 500, 9, fn(index) { assert(S.set(sqlite, "k" + str(index % 1024), index).ok, "SQLite replace"); });
assert(S.stats(sqlite).size == 1024, "SQLite benchmark remains bounded");

S.close(memory); S.close(sqlite);
if sink <= 0 { throw "benchmark sink was not exercised"; }
print "DATA_STORE_CONDITIONAL|redis|not-run|external-service-required";
print "DATA_STORE_SUITE|ok";
