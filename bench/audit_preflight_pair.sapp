// Import only an operator-reviewed previous bridge; both use current dependencies.
let OLD=import(env_get("PB_TEXT_AUDIT_REFERENCE"));
let NEW=import("stdlib:project_text_audit.sapp");
let B=import("stdlib:benchmark.sapp");
let sample_size=env_get("PB_AUDIT_PAIR_ROUNDS") ?? "50";
if sample_size!="5" and sample_size!="50" {throw "audit benchmark rounds must be 5 or 50";}
let rounds=if sample_size=="5" {5} else {50};
let roots=["tests/fixtures/module_audit/tools"];
fn analyze(module,mode) {
    if mode=="roots" {return module.audit_roots("fixture",roots,map{max_findings:16,max_files:10,max_file_bytes:10000});}
    return module.audit_modules("fixture",roots,map{max_findings_per_file:16,max_files_per_module:10,max_file_bytes:10000});
}
fn normalized(report,mode) {
    if not report.complete {throw "audit benchmark incomplete fixture";}
    if mode=="roots" {report.collected.duration_ms=0;}
    else {report.duration_ms=0;for item in report.modules {item.duration_ms=0;}}
    return json_stringify(report);
}
fn measure(module,mode) {
    let start=now_ms();let result=nil;
    for i rounds {result=analyze(module,mode);}
    return map{elapsed:now_ms()-start,result:result};
}
for mode in ["roots","modules"] {
    let expected=normalized(analyze(OLD,mode),mode);let before=[];let after=[];let ratios=[];
    for i 14 {
        let a=nil;let b=nil;
        if i%2==0 {a=measure(OLD,mode);b=measure(NEW,mode);}
        else {b=measure(NEW,mode);a=measure(OLD,mode);}
        if normalized(a.result,mode)!=expected or normalized(b.result,mode)!=expected
            or a.elapsed<=0 or b.elapsed<=0 {throw "audit benchmark result/clock mismatch";}
        if i>=2 {push(before,a.elapsed);push(after,b.elapsed);push(ratios,b.elapsed/a.elapsed);}
    }
    print json_stringify(map{operation:mode,rounds:rounds,before_ms:before,after_ms:after,paired_ratios:ratios,
        before_stats:B.stats("before",before),after_stats:B.stats("after",after),ratio_stats:B.stats("ratio",ratios)});
}
