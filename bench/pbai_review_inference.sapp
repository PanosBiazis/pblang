let AI=import("stdlib/pbai.sapp");
let old_train=[map{x:[0],y:4},map{x:[1,0],y:4}];let old_holdout=[map{x:[7,0],y:4}];
let teacher=AI.neural_specialist_train([old_train[0]],old_holdout);
let parent=AI.neural_specialist_distill(teacher.artifact,[[0],[1,0]],old_holdout).checkpoint();
let history=AI.neural_specialist_student_history(parent,old_train,old_holdout);
let review=AI.neural_specialist_student_continue_reviewed(parent,history,[map{x:[2,0],y:4}],[map{x:[4,0],y:4}]);
let contexts=[];for i 32 {push(contexts,[num_floor(i/8),i%8]);}
fn workload() {let out=[];for ids in contexts {push(out,review.predict(ids));}return json_stringify(out);}
let results=[];
for phase in ["reviewed","accepted","rolled-back"] {
    if phase=="accepted" {review.accept();}
    if phase=="rolled-back" {review.rollback();}
    let expected=workload();let samples=[];
    for sample 5 {let start=now_ms();let observed=workload();push(samples,now_ms()-start);assert(observed==expected,"stable predictions");assert(len(samples)==sample+1,"sample count");}
    let ordered=array_sort(samples);
    push(results,map{phase:phase,checkpoint_digest:review.checkpoint().digest,output_digest:sha256(expected),
        samples_ms:samples,median_ms:ordered[2],p95_sample_ms:ordered[4]});
}
assert(results[0].output_digest==results[2].output_digest,"rollback restores exact outputs");
print json_stringify(map{format:"pbai.review.inference.benchmark.v1",contexts:32,warmups:1,samples:5,results:results,
    scope:"review construction excluded; 32 predict calls plus identical JSON serialization per sample; shared desktop wall time"});
