// Same reviewed temporary file, identical read+decode output; no analyzer timing.
let S=import("stdlib:secure_file.sapp");
let B=import("stdlib:benchmark.sapp");
let OS=import("stdlib:os.sapp");
let path=path_join(OS.temp_dir(),"pblang_read_bench_"+str_slice(sha256(str(now_ms())+str(random_bytes(8))),0,16));
let payload=str_repeat("let value=1; // α\n",128);
fn legacy() {
    let bytes=fs_read_bytes(path);
    if len(bytes)>16777216 {throw "limit";}
    return bytes_to_str(bytes);
}
fn bounded() {
    let loaded=try S.read_bytes(path,16777216,false) catch map{ok:false};
    if not loaded.ok {throw "bounded read failed";}
    return bytes_to_str(loaded.bytes);
}
fn measure(read) {
    let start=now_ms();let result="";
    for i 100 {result=read();}
    let elapsed=now_ms()-start;
    if result!=payload or elapsed<=0 {throw "read benchmark control failed";}
    return elapsed;
}
fn exercise() {
    fs_write(path,payload);
    let before=[];let after=[];let ratios=[];
    for i 10 {
        let a=0;let b=0;
        if num_mod(i,2)==0 {a=measure(legacy);b=measure(bounded);}
        else {b=measure(bounded);a=measure(legacy);}
        if i>=2 {push(before,a);push(after,b);push(ratios,b/a);}
    }
    return map{operation:"read-and-decode",source_bytes:len(str_to_bytes(payload)),rounds:100,
        before_ms:before,after_ms:after,paired_ratios:ratios,
        before_stats:B.stats("legacy-read",before),after_stats:B.stats("bounded-read",after),
        ratio_stats:B.stats("ratio",ratios)};
}
let outcome=try map{ok:true,result:exercise()} catch map{ok:false};
if fs_exists(path) {fs_remove(path);}
if not outcome.ok {throw "analysis read benchmark failed";}
print json_stringify(outcome.result);
