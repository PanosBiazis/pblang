// Paired same-process microbenchmark for the tree interpreter's private
// closure metadata representation. Alternating order limits frequency drift.

let ITERATIONS = 400000;
let map_closure = map{
    __fn: true,
    params: ["n"],
    arity: 1,
    body: [1],
    env: map{ value: 7 }
};
let array_closure = [9173, ["n"], 1, [1], map{ value: 7 }];

fn map_reads() {
    let total = 0;
    let i = 0;
    while i < ITERATIONS {
        total = total + map_closure.arity + len(map_closure.params)
            + len(map_closure.body) + map_closure.env.value;
        i = i + 1;
    }
    return total;
}

fn array_reads() {
    let total = 0;
    let i = 0;
    while i < ITERATIONS {
        total = total + array_closure[2] + len(array_closure[1])
            + len(array_closure[3]) + array_closure[4].value;
        i = i + 1;
    }
    return total;
}

fn sample(run) {
    let t0 = now_ms();
    let result = run();
    let elapsed = now_ms() - t0;
    if result != ITERATIONS * 10 { throw "closure-layout result mismatch"; }
    return elapsed;
}

map_reads(); array_reads();
let map_samples = [];
let array_samples = [];
let round = 0;
while round < 5 {
    if round % 2 == 0 {
        array_push(map_samples, sample(map_reads));
        array_push(array_samples, sample(array_reads));
    } else {
        array_push(array_samples, sample(array_reads));
        array_push(map_samples, sample(map_reads));
    }
    round = round + 1;
}
map_samples = array_sort(map_samples);
array_samples = array_sort(array_samples);
let map_median = map_samples[2];
let array_median = array_samples[2];
if map_median <= 0 or array_median <= 0 { throw "closure-layout clock failure"; }

print "SCHEMA|layout|iterations|median_ms|reads_per_second|status";
print "CLOSURE_LAYOUT|map|" + str(ITERATIONS) + "|" + str(map_median)
    + "|" + str((ITERATIONS * 4 * 1000) / map_median) + "|ok";
print "CLOSURE_LAYOUT|array|" + str(ITERATIONS) + "|" + str(array_median)
    + "|" + str((ITERATIONS * 4 * 1000) / array_median) + "|ok";
print "CLOSURE_LAYOUT_SUITE|ok";
