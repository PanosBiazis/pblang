let G=import("stdlib:table_group.sapp");let Before=import("fixtures/table_group_before_axis_reuse.sapp");let S=import("stdlib:sheet_document.sapp");
fn timed(doc,current,a,b){let start=clock();for i in range(0,20){if current {G.cross(doc,a,b,true);} else {Before.cross(doc,a,b,true);}}return (clock()-start)*1000/20;}
let results=[];for categories in [1,3,7]{let doc=S.create(32,2);doc.cells[0]=["First","Second"];for r in range(1,32){doc.cells[r]=["group"+str(num_mod(r,categories)),"other"+str(num_mod(r,3))];}
 for b in [0,1]{assert(G.cross(doc,0,b,true)==Before.cross(doc,0,b,true),"same workload and results");for warm in range(0,3){timed(doc,false,0,b);timed(doc,true,0,b);}let before=[];let after=[];
  for sample in range(0,9){if num_mod(sample,2)==0{array_push(before,timed(doc,false,0,b));array_push(after,timed(doc,true,0,b));} else {array_push(after,timed(doc,true,0,b));array_push(before,timed(doc,false,0,b));}}
  array_push(results,map{records:31,categories:categories,same_axis:b==0,before_ms:before,after_ms:after});
 }}print json_stringify(map{warmups:3,samples:9,calls_per_sample:20,unit:"ms_per_cross_call",results:results});
