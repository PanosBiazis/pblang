// Args: current|reference, count, repeats. Same imports and output checks.
let DB = import("../stdlib/db.sapp");
let OLD = import("./reference/db_placeholders_linear.sapp");
let args = str_split(env_get("PBLANG_SCRIPT_ARGS"), "\n");
let mode = args[0];
let count = parse_number(args[1]);
let repeats = parse_number(args[2]);
let build = DB.sql_placeholders;
if mode == "reference" { build = OLD.sql_placeholders; }
let start = clock();
let out = "";
for i repeats { out = build(count); }
let elapsed = clock() - start;
if len(out) != count * 2 - 1 { throw "benchmark output length mismatch"; }
print "DB_PLACEHOLDERS|" + mode + "|" + str(elapsed) + "|" + sha256(out) + "|ok";
