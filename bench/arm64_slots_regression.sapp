// Stable large-function workload: slot assignment must not enumerate all prior names.
let A=import("stdlib:codegen_arm64_ast.sapp");let B=import("stdlib:benchmark.sapp");
let parts=[];
for i in range(0,4100) {push(parts,"let v"+str(i)+"="+str(i)+";");}
let source=str_join(parts,"")+"return v4099;";
let samples=[];let sizes=[];
A.compile_ast(source);
for sample in range(0,5) {
    let start=now_ms();let code=A.compile_ast(source);
    push(samples,now_ms()-start);push(sizes,len(code));
}
print json_stringify(map{format:"pblang.arm64.slots.regression.v1",warmups:1,samples:5,
    source_sha256:sha256(source),artifact_sizes:sizes,timing:B.stats("locals4100",samples)});
