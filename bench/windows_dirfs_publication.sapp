// Maintainer-only Windows benchmark in an owned working directory.
let W=import("stdlib:windows_dirfs.sapp");
assert(platform()=="windows","Windows benchmark lane required");
let name=env_get("PB_DIRFS_WORKLOAD");assert(name=="short" or name=="long","explicit workload");
let folder=if name=="short" {"data"} else {str_repeat("long-path-",8)};
let base=".pb-publish-bench-"+str_slice(sha256(base64_encode_bytes(random_bytes(16))),0,12);
fs_mkdirs(base+"/"+folder);
let fs=W.open(base,false,env_get("PBLANG_WINDOWS_ABI_BRIDGE"));assert(fs.ok,"owned root");
let path=folder+"/value.bin";
for i 1024 {assert(W.write_atomic(fs,path,[num_mod(i,256),0,255],false).ok,"atomic publication");}
assert(W.read_bytes(fs,path,3).bytes==[255,0,255],"same final bytes");
assert(W.remove_file(fs,path).ok,"file removed");assert(W.close(fs),"root closed");
fs_remove(base+"/"+folder);fs_remove(base);print "publication_benchmark_pass";
