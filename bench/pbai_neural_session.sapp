// Synthetic lifecycle measurement; no independent generalization claim.
let AI=import("stdlib/pbai.sapp");
let training=[];let validation=[];let test=[];
for i 4 {
    push(training,map{x:[i],y:i+4});push(validation,map{x:[7,i],y:i+4});
    for prefix in [[6],[5],[4,6],[6,5]] {let x=[];for p in prefix {push(x,p);}push(x,i);push(test,map{x:x,y:i+4});}
}
fn stats(values) {let sorted=array_sort(values);return map{samples:values,median_ms:sorted[3],p95_sample_ms:sorted[6]};}
let training_ms=[];let evaluation_ms=[];let inference_ms=[];let rollback_ms=[];
let report=map{};let expected="";
for sample 8 {
    let start=now_ms();let session=AI.neural_specialist_session(training,validation);let trained=now_ms()-start;
    let baseline=session.predict([6,0]);
    start=now_ms();let evaluation=session.evaluate(test);let evaluated=now_ms()-start;
    assert(evaluation.passed,"fixture passes private candidate gate");
    session.promote();let active=session.predict([6,0]);
    start=now_ms();for _call 32 {session.predict([6,0]);}let inference=(now_ms()-start)/32;
    start=now_ms();session.rollback();let restored=session.predict([6,0]);let rollback=now_ms()-start;
    assert(baseline.artifact_digest!=active.artifact_digest,"promotion switches artifact");
    assert(baseline.artifact_digest==restored.artifact_digest and json_stringify(baseline.logits)==json_stringify(restored.logits),"rollback exact parity");
    let identity=json_stringify(evaluation);
    if expected=="" {expected=identity;}else {assert(expected==identity,"repeatable quality measurements");}
    report=evaluation;
    if sample>0 {push(training_ms,trained);push(evaluation_ms,evaluated);push(inference_ms,inference);push(rollback_ms,rollback);}
}
print json_stringify(map{format:"pbai.neural.lifecycle.benchmark.v1",suite:"tiny-token-session-v1",
    warmups:1,samples:7,inference_calls_per_sample:32,training_examples:4,validation_examples:4,test_examples:16,
    evaluation:report,training:stats(training_ms),evaluation_time:stats(evaluation_ms),
    promoted_inference:stats(inference_ms),rollback_and_prediction:stats(rollback_ms),
    promotion_switches_artifact:true,rollback_exact_parity:true,persists_weights:false,globally_activated:false,
    scope:"synthetic related-distribution token mapping; explicit session only; no independent provenance",
    timing_scope:"in-process wall time; inference includes artifact validation and base reconstruction; p95 of sample averages",
    agi_status:"not-demonstrated",asi_status:"not-demonstrated"});
