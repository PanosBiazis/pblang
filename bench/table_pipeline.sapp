// Identical workloads and pre-change implementation; Wall-clock milliseconds per call.
let Before=import("./fixtures/table_transform_before_pipeline.sapp");
let After=import("stdlib:table_transform.sapp");let Sheet=import("stdlib:sheet_document.sapp");
fn measure(f,doc,steps) {let start=clock();for repeat in range(0,20) {f(doc,steps,true);}return (clock()-start)*1000/20;}
let doc=Sheet.create(32,8);
for c in range(0,8) {doc.cells[0][c]="column"+str(c);}
for r in range(1,32) {for c in range(0,8) {doc.cells[r][c]=" value"+str(r%8)+"_"+str(c)+" ";}}
let original=Sheet.encode(doc);let repeated=[];for i in range(0,16) {array_push(repeated,map{op:"trim"});}
let workloads=[map{name:"clean",steps:[map{op:"trim"},map{op:"deduplicate"}]},
    map{name:"five_steps",steps:[map{op:"trim"},map{op:"filter",column:0,query:"value"},map{op:"sort",column:1,descending:true},map{op:"select",columns:[1,0,2]},map{op:"deduplicate"}]},
    map{name:"sixteen_trims",steps:repeated}];
let results=[];
for workload in workloads {
    assert(Before.apply(doc,workload.steps,true)==After.apply(doc,workload.steps,true),"equivalent output");
    for warmup in range(0,3) {measure(Before.apply,doc,workload.steps);measure(After.apply,doc,workload.steps);}
    let before=[];let after=[];
    for sample in range(0,9) {
        if sample%2==0 {array_push(before,measure(Before.apply,doc,workload.steps));array_push(after,measure(After.apply,doc,workload.steps));}
        else {array_push(after,measure(After.apply,doc,workload.steps));array_push(before,measure(Before.apply,doc,workload.steps));}
    }
    array_push(results,map{name:workload.name,before_ms:before,after_ms:after});
}
assert(Sheet.encode(doc)==original,"benchmark input unchanged");
print json_stringify(map{clock:"system_time_wall",unit:"ms_per_call",rows:32,columns:8,warmups:3,samples:9,repetitions:20,results:results});
