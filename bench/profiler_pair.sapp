// The baseline module must be an operator-reviewed local Git copy.
// Importing it executes code. Never use an untrusted supplied path.
let OLD=import(env_get("PB_PROFILER_REFERENCE"));
let NEW=import("stdlib:profiler.sapp");
let B=import("stdlib:benchmark.sapp");
fn work(){return 7;}
fn measure(module,mode) {
    module.reset();
    let start=now_ms();let result=nil;
    if mode=="benchmark" {result=module.benchmark("fixed",work,20000);}
    else {for iteration 2000 {result=module.trace(work);}}
    let elapsed=now_ms()-start;
    if mode=="benchmark" {
        if result.result!=7 or result.iterations!=20000 or len(map_keys(result))!=7 {throw "profiler benchmark control";}
    } else {
        if result!=7 or len(module.trace_log())!=2000 {throw "profiler trace control";}
    }
    module.reset();return elapsed;
}
for mode in ["benchmark","trace"] {
    let before=[];let after=[];let ratios=[];
    for iteration 14 {
        let a=0;let b=0;
        if num_mod(iteration,2)==0 {a=measure(OLD,mode);b=measure(NEW,mode);}
        else {b=measure(NEW,mode);a=measure(OLD,mode);}
        if a<=0 or b<=0 {throw "profiler pair: clock resolution";}
        if iteration>=2 {push(before,a);push(after,b);push(ratios,b/a);}
    }
    print json_stringify(map{operation:mode,rounds:if mode=="benchmark"{20000}else{2000},
        before_ms:before,after_ms:after,paired_ratios:ratios,
        before_stats:B.stats(mode,before),after_stats:B.stats(mode,after),ratio_stats:B.stats("ratio",ratios)});
}
