// Warm in-process PBIDE surface benchmark. Cold process startup and locked
// module verification are excluded and must be measured separately.

let Surface = import("editors/ide/pbide_surface.sapp");
let Workspace = import("editors/ide/pbide_workspace.sapp");

let WARMUPS = 3;
let SAMPLES = 9;
let ITERATIONS = 40;

fn measure(name, thunk, verify) {
    let i = 0;
    while i < WARMUPS {
        if not verify(thunk()) { throw "PBIDE benchmark correctness failure: " + name; }
        i = i + 1;
    }
    let values = [];
    let checksum = 0;
    i = 0;
    while i < SAMPLES {
        let started = now_ms();
        let j = 0;
        while j < ITERATIONS {
            if not verify(thunk()) { throw "PBIDE benchmark correctness failure: " + name; }
            checksum = checksum + 1;
            j = j + 1;
        }
        push(values, now_ms() - started);
        i = i + 1;
    }
    let ordered = array_sort(values);
    let middle = num_floor(len(ordered) / 2);
    let p95_index = num_floor((len(ordered) * 95 + 99) / 100) - 1;
    print "PBIDE_SURFACE_STAGE|" + name
        + "|median_ms=" + str(ordered[middle])
        + "|p95_ms=" + str(ordered[p95_index])
        + "|median_per_op_ms=" + str(ordered[middle] / ITERATIONS)
        + "|checksum=" + str(checksum)
        + "|samples_ms=" + str(ordered);
}

measure("manifest-web", fn() { return Surface.surface_manifest("web"); },
    fn(value) { return value.action_count == 12 and value.panel_count == 11; });
measure("manifest-native", fn() { return Surface.surface_manifest("native"); },
    fn(value) { return value.action_count == 12 and value.panel_count == 11; });
measure("compile-web", fn() { return Surface.preview("web", "print 42;"); },
    fn(value) { return value.target == "web" and len(value.records) > 0; });
let workspace_fixture = Workspace.create([
    Workspace.document("src/main.sapp", "let answer = 42;"),
    Workspace.document("tests/main_test.sapp", "assert(true, \"ok\");")
]);
let workspace_json = Workspace.encode(workspace_fixture);
measure("workspace-decode", fn() { return Workspace.decode(workspace_json); },
    fn(value) { return len(value.tabs) == 2 and value.total_source_bytes > 0; });

print "PBIDE_SURFACE_BENCHMARK|ok|warmups=" + str(WARMUPS)
    + "|samples=" + str(SAMPLES) + "|iterations=" + str(ITERATIONS)
    + "|startup_import_excluded=true";
