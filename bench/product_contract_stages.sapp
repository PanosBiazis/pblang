let B = import("stdlib:benchmark.sapp");
let E = import("stdlib:product_release_evidence.sapp");
let UI = import("stdlib:ui_document.sapp");

let A = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
let D = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd";
let COMMIT = "0123456789abcdef0123456789abcdef01234567";
let SAMPLES = 9;

fn source_row() {
    return E.source("benchmark-product", "1.2.3", "stable", "0.6.0-alpha",
        A, D, A, COMMIT, map{clean_tree:true, reproducible_inputs:true});
}

let source = source_row();
let artifact = E.artifact(source, "linux-bundle", D, 4096, A, "1.2.3", "stable",
    ["linux:x86_64"], map{signed_artifact:true, signature_sha256:A,
        sbom_sha256:D, attestation_sha256:A, install_verified:true,
        upgrade_verified:true, rollback_verified:true, uninstall_verified:true});
let report = E.test_report(source, artifact, "full", A, A, D, 120, 0, 0,
    ["linux:x86_64"], map{complete_suite:true, process_isolated:true});
let platform = E.platform_evidence(source, artifact, "linux", "x86_64", "physical-lab",
    D, D, ["install", "start", "rollback", "uninstall"], map{physical:true});
let policy = E.policy("stable", 1, ["linux-bundle"], ["full"], [
    E.target_requirement("linux-bundle", "linux", "x86_64",
        ["install", "start", "rollback", "uninstall"])
]);

fn large_design() {
    let widgets = []; let i = 0;
    while i < 512 {
        array_push(widgets, map{name:"widget_" + str(i), kind:"label", parent:"root",
            x:num_mod(i, 32) * 8, y:num_floor(i / 32) * 8, w:8, h:8,
            props:map{text:"bounded" + str(i), visible:true}, events:map{}, bind:""});
        i = i + 1;
    }
    return map{form:map{title:"Contract benchmark",w:1024,h:768}, widgets:widgets,
        model:map{theme:"dark", revision:1}};
}

let design = large_design();
let document = UI.from_design(design, "pblang-gui");

fn measure(name, body, expected_checksum) {
    B.warmup(body, 3);
    let samples = []; let checksum = 0; let i = 0;
    while i < SAMPLES {
        let started = now_ms(); checksum = checksum + body();
        array_push(samples, now_ms() - started); i = i + 1;
    }
    if checksum != expected_checksum * SAMPLES {
        throw "product contract benchmark checksum mismatch: " + name;
    }
    let stats = B.stats(name, samples);
    print "PRODUCT_CONTRACT_PHASE|" + name + "|" + str(SAMPLES) + "|"
        + str(stats.p50_ms) + "|" + str(stats.p95_ms) + "|"
        + str(checksum) + "|" + str(samples) + "|ok";
}

print "SCHEMA|phase|samples|p50_ms|p95_ms|checksum|raw_ms|status";
measure("release_source", fn() { return len(source_row().source_sha256); }, 64);
measure("release_evaluate", fn() {
    let gate = E.evaluate(source, policy, [artifact], [report], [platform]);
    if not gate.structurally_complete or gate.production_ready or gate.trust_verified {
        throw "release evidence correctness gate failed";
    }
    return gate.artifact_count + gate.test_report_count + gate.platform_evidence_count;
}, 3);
measure("ui_canonicalize_512", fn() {
    let result = UI.from_design(design, "pblang-gui");
    if result.widget_count != 512 or result.value_node_count <= 512 {
        throw "UI canonicalization correctness gate failed";
    }
    return result.widget_count;
}, 512);
measure("ui_validate_512", fn() {
    let result = UI.validate(document);
    if not result.ok or result.document.widget_count != 512 {
        throw "UI validation correctness gate failed";
    }
    return result.document.widget_count;
}, 512);
print "PRODUCT_CONTRACT_SUITE|ok";
