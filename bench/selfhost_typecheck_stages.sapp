// Correctness-gated phase benchmark for the pblang-written type checker.
let T = import("stdlib/compiler/tokenizer.sapp");
let P = import("stdlib/compiler/parser.sapp");
let C = import("stdlib/compiler/typeck.sapp");
let BL = import("stdlib/compiler/builtins_list.sapp");

fn parsed(source) {
    let ast = P.parse(T.tokenize(source));
    if len(ast.errors) != 0 { throw "typecheck benchmark: parser diagnostics"; }
    return ast;
}

fn typed_source(count, invalid) {
    let source = ""; let i = 0;
    while i < count {
        source = source + "fn add" + str(i) + "(a: number, b: number = 2): number { return a + b; } ";
        if invalid {
            source = source + "let value" + str(i) + ": number = add" + str(i) + "(\"bad\"); ";
        } else {
            source = source + "let value" + str(i) + ": number = add" + str(i) + "(" + str(i) + "); ";
        }
        i = i + 1;
    }
    return source;
}

fn builtin_source(count) {
    let source = ""; let i = 0;
    while i < count {
        source = source + "let n" + str(i) + " = str_trim(\" value \" ); ";
        i = i + 1;
    }
    return source;
}

fn measure_registry(iterations) {
    let cached = BL.builtin_set();
    if not BL.is_builtin_name("str_trim") or not map_has(cached, "str_trim") {
        throw "typecheck benchmark: builtin registry correctness gate";
    }
    let legacy_sum = 0; let i = 0; let t0 = now_ms();
    while i < iterations {
        if BL.is_builtin_name("str_trim") { legacy_sum = legacy_sum + 1; }
        i = i + 1;
    }
    let legacy_ms = now_ms() - t0;
    let cached_sum = 0; i = 0; t0 = now_ms();
    while i < iterations {
        if map_has(cached, "str_trim") { cached_sum = cached_sum + 1; }
        i = i + 1;
    }
    let cached_ms = now_ms() - t0;
    if legacy_sum != iterations or cached_sum != iterations {
        throw "typecheck benchmark: builtin registry checksum";
    }
    print "BUILTIN_REGISTRY|" + str(iterations) + "|" + str(legacy_ms) + "|"
        + str(cached_ms) + "|" + str(legacy_sum + cached_sum) + "|ok";
}

fn measure(name, iterations, ast, expected_diags) {
    let warm = C.type_check(ast.stmts);
    if len(warm) != expected_diags {
        throw "typecheck benchmark: " + name + " expected " + str(expected_diags) + " diagnostics, got " + str(len(warm));
    }
    let t0 = now_ms(); let checksum = 0; let i = 0;
    while i < iterations { checksum = checksum + len(C.type_check(ast.stmts)); i = i + 1; }
    let elapsed = now_ms() - t0;
    print "TYPECHECK_PHASE|" + name + "|" + str(iterations) + "|" + str(elapsed)
        + "|" + str(elapsed / iterations) + "|" + str(len(ast.stmts)) + "|" + str(checksum) + "|ok";
}

let legacy = parsed("fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } fn sum_to(n) { let i = 0; let s = 0; while i < n { s = s + i; i = i + 1; } return s; } let answer = fib(12) + sum_to(20); print answer;");
let typed = parsed(typed_source(64, false));
let invalid = parsed(typed_source(64, true));
let builtins = parsed(builtin_source(128));

let malformed = C.type_check([map{ kind: "expr_stmt", expr: map{ kind: "call" } }]);
if len(malformed) != 1 or malformed[0].code != "malformed-ast" { throw "typecheck benchmark: malformed AST gate"; }
let bounded = C.type_check(typed.stmts, map{ max_nodes: 8 });
if len(bounded) == 0 or bounded[len(bounded) - 1].code != "resource-limit" { throw "typecheck benchmark: resource gate"; }

print "SCHEMA|typecheck_phase|iterations|total_ms|avg_ms|statements|diagnostic_checksum|status";
print "SCHEMA|builtin_registry|iterations|legacy_rebuild_ms|cached_lookup_ms|checksum|status";
measure("legacy-compatible", 500, legacy, 0);
measure("typed-signatures", 50, typed, 0);
measure("typed-diagnostics", 50, invalid, 64);
measure("builtin-lookups", 50, builtins, 0);
measure_registry(5000);
print "TYPECHECK_SUITE|ok";
