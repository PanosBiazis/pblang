let Old=import("./fixtures/set_before_queries.sapp");let S=import("stdlib:set.sapp");
fn even(v){return v%2==0;}
fn elapsed(call,a,b,calls){let start=clock();for _i calls {call(a,b);}return (clock()-start)*1000/calls;}
let ops=[
 map{name:"size",before:fn(a,b){return Old.size(a);},after:fn(a,b){return S.size(a);},calls:20},
 map{name:"impossible_subset",before:Old.is_subset,after:S.is_subset,calls:3},
 map{name:"disjoint_small",before:Old.is_disjoint,after:S.is_disjoint,calls:3},
 map{name:"intersection_size",before:fn(a,b){return Old.size(Old.intersection(a,b));},after:S.intersection_size,calls:3},
 map{name:"intersection_size_equal",before:fn(a,b){return Old.size(Old.intersection(a,a));},after:fn(a,b){return S.intersection_size(a,a);},calls:3},
 map{name:"partition_vs_two_filters",before:fn(a,b){return [Old.to_array(Old.filter(a,even)),Old.to_array(Old.filter(a,fn(v){return not even(v);}))];},after:fn(a,b){let p=S.partition(a,even);return [S.to_array(p.matched),S.to_array(p.rejected)];},calls:1},
 map{name:"each",before:fn(a,b){let n=0;Old.each(a,fn(v){n=n+1;});return n;},after:fn(a,b){let n=0;S.each(a,fn(v){n=n+1;});return n;},calls:1}
];
let results=[];
for n in [0,8,128,1024] {
 let a=S.new();for i n {S.add(a,i);}let b=S.from_array([-1]);
 for op in ops {
  assert(op.before(a,b)==op.after(a,b),"result parity");
  for _warmup 2 {op.before(a,b);op.after(a,b);}
  let before=[];let after=[];
  for sample 7 {
   if sample%2==0 {push(before,elapsed(op.before,a,b,op.calls));push(after,elapsed(op.after,a,b,op.calls));}
   else {push(after,elapsed(op.after,a,b,op.calls));push(before,elapsed(op.before,a,b,op.calls));}
  }
  push(results,map{operation:op.name,size:n,before_ms:before,after_ms:after});
 }
}
print json_stringify(map{samples:7,warmups:2,results:results});
