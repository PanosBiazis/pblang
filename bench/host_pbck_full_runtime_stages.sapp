// PBLang-only, correctness-gated warm benchmark for the complete PBCK-v1
// opcode contract. Process startup and decoding are intentionally separate.
let VM = import("stdlib:host_pbck_vm.sapp");

let cleanup = map{
    __pbck_function: true, name: "cleanup", arity: 0, min_arity: 0,
    defaults: [], is_vararg: false, parameter_types_present: false,
    parameter_types: [], chunk: map{
        instructions: [map{ op: 0, operand: 0 }, map{ op: 33 }],
        constants: [nil], source_name: nil
    }
};
let artifact = map{
    format: "host-pbck-v1", version: 1,
    chunk: map{
        instructions: [
            map{ op: 0, operand: 0 }, map{ op: 0, operand: 1 }, map{ op: 41 },
            map{ op: 13, operand: 2 }, map{ op: 18, operand: 2 },
            map{ op: 0, operand: 3 }, map{ op: 42, operand: 4 }, map{ op: 11 },
            map{ op: 0, operand: 5 }, map{ op: 0, operand: 6 }, map{ op: 43 }, map{ op: 11 },
            map{ op: 0, operand: 7 }, map{ op: 44 }, map{ op: 11 },
            map{ op: 27, fn_const: 8, captures: [] }, map{ op: 34 },
            map{ op: 14, operand: 2 }, map{ op: 33 }
        ],
        constants: [
            2, 8, "power", map{ answer: 42 }, "answer", [3, 5], 1,
            map{ ok: true, value: 11 }, cleanup
        ], source_name: nil
    }
};

fn sorted(values) {
    let out = []; let i = 0;
    while i < len(values) { array_push(out, values[i]); i = i + 1; }
    i = 1;
    while i < len(out) {
        let value = out[i]; let j = i - 1;
        while j >= 0 and out[j] > value { out[j + 1] = out[j]; j = j - 1; }
        out[j + 1] = value; i = i + 1;
    }
    return out;
}

let warmup = VM.run_decoded(artifact, map{ max_steps: 100 });
if warmup.value != 256 or warmup.exports.power != 256 { throw "PBCK benchmark correctness gate failed"; }
if len(VM.SUPPORTED_OPCODES) != 48 { throw "PBCK benchmark opcode gate failed"; }

let ITERATIONS = 1000;
let SAMPLES = 9;
let samples = [];
let sample = 0;
while sample < SAMPLES {
    let started = now_ms(); let i = 0; let checksum = 0;
    while i < ITERATIONS {
        let result = VM.run_decoded(artifact, map{ max_steps: 100 });
        checksum = checksum + result.value + result.exports.power;
        i = i + 1;
    }
    if checksum != ITERATIONS * 512 { throw "PBCK benchmark checksum mismatch"; }
    array_push(samples, now_ms() - started);
    sample = sample + 1;
}
let ordered = sorted(samples);
let median = ordered[num_floor(SAMPLES / 2)];
let p95 = ordered[SAMPLES - 1];
print "HOST_PBCK_FULL_RUNTIME|iterations=" + str(ITERATIONS)
    + "|samples=" + str(SAMPLES)
    + "|median_ms=" + str(median)
    + "|p95_ms=" + str(p95)
    + "|median_per_run_ms=" + str(median / ITERATIONS)
    + "|opcodes=48";
