// Before/after whole-process comparison; negative case does forbidden body work
// on the old VM. Its savings must not be presented as a valid-program speedup.
let FE=import("stdlib/compiler/selfhost_frontend.sapp");
let VM=import("stdlib/compiler/vm.sapp");
let raw=try env_get("PBLANG_SCRIPT_ARGS") catch "";
let args=if raw==nil or raw=="" {[]} else {str_split(raw,"\n")};
let mode=if len(args)>0 {args[0]} else {"overload"};
let source=""; let expected=5000;
if mode=="overload" {
    source="let obj=map{__add__:fn(a,b){return b+1;}};let i=0;let result=0;while i<5000{result=obj+i;i=i+1;}print result;";
} elif mode=="numeric" {
    source="let i=0;let result=0;while i<5000{result=i+1;i=i+1;}print result;";
} elif mode=="rejected_allocation" {
    source="let obj=map{__add__:fn(a){let waste=str_repeat(\"x\",8388608);throw \"body error\";}};let result=try(obj+1)catch 0;print result;";
    expected=0;
} else {throw "unknown method benchmark mode";}
let c=FE.frontend_compile(source);if not c.ok {throw "benchmark compile failed";}
let i=0;
while i<5 {
    let result=VM.run(c.chunk);
    if result.output!=[expected] {throw "benchmark result mismatch";}
    i=i+1;
}
print mode+": verified";
