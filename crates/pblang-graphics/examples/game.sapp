// examples/game.sapp — minimal event-driven window + keyboard-controlled rect
let gfx = import("stdlib/graphics.sapp");

let win = gfx.Window(800, 600, "My Game");

let state = map{
    "x": 400,
    "y": 300,
    "speed": 5,
    "vx": 0,
    "vy": 0
};

fn update(state, events) {
    state["vx"] = 0;
    state["vy"] = 0;
    let i = 0;
    while i < len(events) {
        let e = events[i];
        if e["type"] == "keydown" {
            let k = e["key"];
            if k == "Left" or k == "A" { state["vx"] = 0 - state["speed"]; }
            if k == "Right" or k == "D" { state["vx"] = state["speed"]; }
            if k == "Up" or k == "W" { state["vy"] = 0 - state["speed"]; }
            if k == "Down" or k == "S" { state["vy"] = state["speed"]; }
            if k == "Escape" { win.close(); }
        }
        if e["type"] == "close" { win.close(); }
        i = i + 1;
    }
    state["x"] = state["x"] + state["vx"];
    state["y"] = state["y"] + state["vy"];
}

fn draw(state, win) {
    win.clear(gfx.BLACK);
    win.rect(100, 100, 200, 150, gfx.BLUE);
    win.rect(state["x"], state["y"], 40, 40, gfx.RED);
}

gfx.run(win, state, update, draw, 60);

win.close();
print ("Game closed");
