// examples/game.sapp — minimal window + rect (use gfx_demo.sapp for keyboard/events)
let gfx = import("stdlib/graphics.sapp");

let win = gfx.Window(800, 600, "My Game");

let player = map{
    "x": 400,
    "y": 300,
    "speed": 5
};

fn update() {
    // TODO: use gfx.run() with events for input
}

fn draw(window) {
    window.clear(gfx.BLACK);
    window.rect(100, 100, 200, 150, gfx.BLUE);
    window.rect(player["x"], player["y"], 40, 40, gfx.RED);
}

gfx.runGameLoop(win, update, draw, 60);

win.close();
print ("Game closed");
