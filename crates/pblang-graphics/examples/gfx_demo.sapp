// gfx_demo.sapp — keyboard-driven rect, event loop (run from repo root: pblang run crates/pblang-graphics/examples/gfx_demo.sapp)
let gfx = import("stdlib/graphics.sapp");

let win = gfx.Window(800, 600, "pblang GFX demo");

let state = map{
    "x": 100,
    "y": 100,
    "vx": 0,
    "vy": 0
};

fn update(state, events) {
    state["vx"] = 0;
    state["vy"] = 0;
    let i = 0;
    while i < len(events) {
        let e = events[i];
        let t = e["type"];
        if t == "keydown" {
            let k = e["key"];
            if k == "Left"  { state["vx"] = 0 - 4; }
            if k == "Right" { state["vx"] = 4; }
            if k == "Up"    { state["vy"] = 0 - 4; }
            if k == "Down"  { state["vy"] = 4; }
            if k == "Escape" { win.close(); }
        }
        if t == "close" { win.close(); }
        i = i + 1;
    }
    state["x"] = state["x"] + state["vx"];
    state["y"] = state["y"] + state["vy"];
}

fn draw(state, win) {
    win.clear(gfx.BLACK);
    win.rect(state["x"], state["y"], 80, 60, gfx.RED);
}

gfx.run(win, state, update, draw, 60);
