// show.sapp — the browser demo: everything below is pblang, compiled to wasm. No JS logic.
fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); }
fn gcd(a, b) { if b == 0 { return a; } return gcd(b, a % b); }
fn sq(x) { return x * x; }
fn greet(name) { return "hello, " + name + "!"; }
print greet("browser");
print "pblang is running as WebAssembly — strings built on the wasm heap:";
let i = 1;
while i <= 6 { print "sq(" + str(i) + ") = " + str(sq(i)); i = i + 1; }
let k = 0;
let row = "fib:";
while k < 10 { row = row + " " + str(fib(k)); k = k + 1; }
print row;
print "gcd(1071, 462) = " + str(gcd(1071, 462));
