// PBLang-native workspace entrypoint declared by pblang.toml (v1.0.0-stable).
let OS = import("stdlib:os.sapp");
let REPRO = import("stdlib:repro_benchmark.sapp");

fn usage() {
    print "pblang-workspace commands: status | benchmark-codegen | help";
}

let args = OS.script_args();
let command = if len(args) == 0 { "status" } else { args[0] };

if command == "status" {
    print "pblang-workspace 1.0.0 channel=stable status=stable";
    print "direct_codegen=stdlib/native/codegen_x64.sapp";
    print "stage3_zero_rust_runtime=runtime_stage3/stage3_native_host_runtime.sapp";
    print "hardware_emulators=emulators/hardware_emulators_suite.sapp";
    print "physical_hardware_manager=emulators/physical_hardware_manager.sapp";
    print "reproducible_benchmarks=bench/reproducible_core_matrix.sapp";
} elif command == "benchmark-codegen" {
    let row = REPRO.benchmark_language("pblang-codegen-x64", "integer_kernel", 1, 3, 30);
    if row.status == "unavailable" {
        print "codegen_benchmark status=unavailable reason=" + str(row.reason);
    } elif row.status != "ok" {
        throw "codegen benchmark failed: " + row.status + " " + str(try row.detail catch "");
    } else {
        print "codegen_benchmark status=ok checksum=" + row.checksum
            + " compile_median_ms=" + str(row.compile_warm.median_ms)
            + " run_median_ms=" + str(row.run_warm.median_ms)
            + " artifact_bytes=" + str(row.artifact_size_bytes);
    }
} elif command == "help" or command == "--help" or command == "-h" {
    usage();
} else {
    usage();
    throw "unknown pblang-workspace command: " + command;
}
