!.gitattributes

# Keep the reviewed cross-platform VM/iOS workflow visible without exposing
# other dot-directory state that the broad rules above intentionally ignore.
!.github/
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/vm-lab-hosted.yml

# Mutable local pbAI learning state must never enter source control.
/stdlib/ai/pbai/stdlib/pbai_live_corpus.txt

# Share only the reviewed editor workspace settings, never local IDE state.
!.vscode/
.vscode/*
!.vscode/settings.json

