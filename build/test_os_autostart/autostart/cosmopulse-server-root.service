[Unit]
Description=CosmoPulse OmniMail™ Enterprise Server Daemon (System Root Mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/app/.gemini/antigravity/scratch/cosmodata-suite/pbcosmodata
ExecStart=/opt/app/.local/bin/pbcosmodata daemon
Restart=always
RestartSec=5
Environment=PBCOSMODATA_BACKGROUND=1

[Install]
WantedBy=multi-user.target
