[Desktop Entry]
Type=Application
Version=1.0
Name=CosmoPulse OmniMail™ Background Daemon
Comment=Auto-start CosmoPulse OmniMail™ in background when computer/server starts
Exec=/opt/app/.local/bin/pbcosmodata daemon
Icon=build/test_os_autostart/icons/cosmopulse.svg
Terminal=false
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
