[Desktop Entry]
Type=Application
Version=1.0
Name=CosmoPulse OmniMail™
GenericName=ERP AI & Customer 360 Suite
Comment=Starts CosmoPulse OmniMail™ in background on boot/login with desktop tray icon
Exec=/opt/app/.local/bin/pbcosmodata gui
Icon=build/test_os_autostart/icons/cosmopulse.svg
Terminal=false
Categories=Office;Finance;Development;
StartupNotify=true
X-GNOME-Autostart-enabled=true
