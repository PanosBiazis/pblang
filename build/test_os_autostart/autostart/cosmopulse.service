[Unit]
Description=CosmoPulse OmniMail™ Background Service (User Mode - No Admin Required)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/app/.gemini/antigravity/scratch/cosmodata-suite/pbcosmodata
ExecStart=/opt/app/.local/bin/pbcosmodata daemon
Restart=always
RestartSec=5
Environment=PBCOSMODATA_BACKGROUND=1

[Install]
WantedBy=default.target
