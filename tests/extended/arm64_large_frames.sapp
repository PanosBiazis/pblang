// Explicit extended gate: large frame/slot/incoming argument execution checks.
let A=import("stdlib:codegen_arm64_ast.sapp");
let REF=import("tests/fixtures/arm64_execution_reference.sapp");
fn locals(count){let s="";for i in range(0,count){s=s+"let v"+str(i)+"=1;";}return s;}
let body=locals(512)+"v511=41;return v0+v511;";
assert(REF.arm64_run(A.compile_ast("fn work(){"+body+"}return work();")).exit==42,"shifted frame restores caller");
let incoming=locals(4100)+"v4099=1;return ninth+v4099;";
assert(REF.arm64_run(A.compile_ast("fn work(a,b,c,d,e,f,g,h,ninth){"+incoming+"}return work(0,0,0,0,0,0,0,0,41);")).exit==42,
    "wide frame, high/low adjustment, wide local write/read and incoming ninth argument");
print "arm64_large_frames_pass";
