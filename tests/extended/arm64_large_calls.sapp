// Opt-in large calls execution in the test reference. No native/isolation claim.
let A=import("stdlib:codegen_arm64_ast.sapp");
let S=import("tests/fixtures/arm64_wide_sources.sapp");
let REF=import("tests/fixtures/arm64_execution_reference.sapp");
for count in [173, 520, 1369, 4105] {
    let result=REF.arm64_run(A.compile_ast(S.call_source(count,true)));
    assert(result.exit==42,"large calls values and stack preservation");
    assert(result.out=="1\n26\n","nested arguments evaluated once in source order");
}
print "arm64_large_calls_pass";
