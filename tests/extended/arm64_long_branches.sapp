// Expensive local correctness probes; no guest/hardware or isolation claim.
let A=import("stdlib:codegen_arm64_ast.sapp");
let S=import("tests/fixtures/arm64_branch_sources.sapp");
let REF=import("tests/fixtures/arm64_execution_reference.sapp");
fn check(source, expected, output) {
    let code=A.compile_ast(source);
    assert(len(code)>1048576,"fixture must exercise long machine-code span");
    let result=REF.arm64_run(code);
    assert(result.exit==expected and result.out==output,"long-branch execution and relocation");
}
check(S.if_source(0),17,"");check(S.if_source(1),42,"");
check(S.while_source(0),17,"");check(S.while_source(1),42,"");
check(S.mixed_source(0),17,"before\nagain\nafter\n");
check(S.mixed_source(1),42,"before\ntaken\n");
check(S.short_source("and",0),17,"");check(S.short_source("or",1),42,"");
check(S.short_source("and",1),42,"");check(S.short_source("or",0),42,"");
check(S.nested_source(24),42,"");
check(S.forward_source(),42,"");
print "arm64_long_branches_pass";
