// Opt-in large maps execution in the test reference. No native/isolation claim.
let A=import("stdlib:codegen_arm64_ast.sapp");
let S=import("tests/fixtures/arm64_wide_sources.sapp");
let REF=import("tests/fixtures/arm64_execution_reference.sapp");
for count in [256, 2048] {
    let result=REF.arm64_run(A.compile_ast(S.map_source(count,true)));
    assert(result.exit==42,"large maps values and stack preservation");
}
print "arm64_large_maps_pass";
