// Opt-in large arrays execution in the test reference. No native/isolation claim.
let A=import("stdlib:codegen_arm64_ast.sapp");
let S=import("tests/fixtures/arm64_wide_sources.sapp");
let REF=import("tests/fixtures/arm64_execution_reference.sapp");
for count in [512, 4095] {
    let result=REF.arm64_run(A.compile_ast(S.array_source(count,true)));
    assert(result.exit==42,"large arrays values and stack preservation");
}
print "arm64_large_arrays_pass";
