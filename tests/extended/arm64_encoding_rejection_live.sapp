if platform()!="linux" {print "arm64_encoding_rejection_live_skip_linux_required";os_exit(0);}
let A=import("stdlib:codegen_arm64_ast.sapp");let UUID=import("stdlib:uuid.sapp");let OS=import("stdlib:os.sapp");
fn rejects(work){return try {work();false} catch true;}
let compiler=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let base=path_join(OS.temp_dir(),"pblang_arm_encoding_"+UUID.v4());
let input=base+".sapp";let output=base+".elf";
fn exercise(){
    // Small source, large generated body: the conditional skips over imm19.
    let prefix="if 0 {"+str_repeat("print 1;",9362);
    let fits=A.compile_ast(prefix+str_repeat("0;",5)+"}return 42;");
    let branch_word=fits[24]+fits[25]*256+fits[26]*65536+fits[27]*16777216;
    assert(num_floor(branch_word/32)%524288==262143,"largest positive imm19 encodes exactly");
    let branch=prefix+str_repeat("0;",6)+"}return 42;";
    assert(rejects(fn(){A.compile_ast(branch);}),"out-of-range conditional must reject");
    let array="let a=["+str_repeat("0,",511)+"0];return 42;";
    assert(rejects(fn(){A.compile_ast(array);}),"unexpanded array bump cannot spill instruction fields");
    let params="";let args="";
    for i in range(0,200){if i>0 {params=params+",";args=args+",";} params=params+"a"+str(i);args=args+"0";}
    let call="fn work("+params+"){return a199;}return work("+args+");";
    assert(rejects(fn(){A.compile_ast(call);}),"unexpanded outgoing argument area rejects");
    let map_source="let m=map{";
    for i in range(0,256){if i>0{map_source=map_source+",";}map_source=map_source+"k"+str(i)+":0";}
    assert(rejects(fn(){A.compile_ast(map_source+"};return 42;");}),"unexpanded map bump rejects");
    fs_write(input,branch);fs_write(output,"previous artifact");
    let r=proc_spawn_wait("/usr/bin/timeout",["-k","1s","20s",compiler,"run","tools/pbc.sapp","--",input,"--target","arm64","--out",output]);
    assert(r.exit_code==1 and fs_read(output)=="previous artifact","CLI preserves old artifact on encoding rejection");
    assert(str_contains(r.stderr,"branch exceeds signed imm19 encoding"),"actual fixed encoding error");
    assert(not str_contains(r.stderr,"print 1;"),"diagnostic does not echo source");
    assert(len(A.compile_elf("return 42;"))>64,"valid compile after rejected encodings");
}
let passed=try {exercise();true} catch false;
for path in [input,output]{try fs_remove(path) catch nil;}
assert(passed,"ARM64 encoding rejection regression");
print "arm64_encoding_rejection_live_pass";
