// tests/omni_bench_test.sapp
// Verification of honest live process benchmarks (`stdlib/repro_benchmark.sapp`) and
// explicitly labeled synthetic catalog models (`stdlib/omni_bench.sapp`).

let OMNI = import("stdlib/omni_bench.sapp");
let WAVE = import("stdlib/backlog_completion_wave.sapp");
let REPRO = import("stdlib/repro_benchmark.sapp");

let checks = 0;
fn check(cond, msg) {
    if not cond {
        throw "OMNI_BENCH_TEST_FAIL: " + msg;
    }
    checks = checks + 1;
}

// 1. Verify coverage() distinguishes live runnable harnesses from synthetic_model entries
let cov = REPRO.coverage();
check(len(cov) == 22, "22 benchmark categories present");
let runnable_count = 0;
let synthetic_count = 0;
let ci = 0;
while ci < len(cov) {
    if cov[ci].harness == "omni_bench" {
        check(cov[ci].status == "synthetic_model", "omni_bench category marked synthetic_model: " + cov[ci].category);
        synthetic_count = synthetic_count + 1;
    } else {
        check(cov[ci].status == "runnable", "live harness category marked runnable: " + cov[ci].category);
        runnable_count = runnable_count + 1;
    }
    ci = ci + 1;
}
check(runnable_count == 10 and synthetic_count == 12, "10 live runnable categories and 12 synthetic_model categories");

// 2. Verify version() queries the real pblang binary (no hardcoded 1.0.0 string)
let ver = REPRO.version("pblang-interpreter");
check(ver.status == "ok" and str_contains(ver.version, "pblang "), "real pblang version queried: " + ver.version);
check(not str_contains(ver.version, "1.0.0"), "pblang version is not hardcoded to 1.0.0");

// 3. Verify honest live execution of pblang-interpreter (real VM), pblang-c99 (transpile + gcc),
//    pblang-codegen-x64, and pblang-tier1-x64 on integer_kernel
let row_interp = REPRO.benchmark_language("pblang-interpreter", "integer_kernel", 1, 3, 30);
let row_c99 = REPRO.benchmark_language("pblang-c99", "integer_kernel", 1, 3, 30);
let row_x64 = REPRO.benchmark_language("pblang-codegen-x64", "integer_kernel", 1, 3, 30);
let row_tier1 = REPRO.benchmark_language("pblang-tier1-x64", "integer_kernel", 1, 3, 30);

check(row_interp.status == "ok" and row_interp.checksum == "474518", "pblang-interpreter integer_kernel ok");
check(row_interp.artifact_size_bytes == nil, "pblang-interpreter has no hidden AOT binary artifact");
check(row_c99.status == "ok" and row_c99.checksum == "474518", "pblang-c99 integer_kernel ok");
check(row_c99.compile_warm.median_ms > 5.0, "pblang-c99 measures real transpile + C compiler time");
check(row_x64.status == "ok" and row_x64.checksum == "474518", "pblang-codegen-x64 integer_kernel ok");
check(row_tier1.status == "ok" and row_tier1.checksum == "474518", "pblang-tier1-x64 integer_kernel ok");
check(row_x64.artifact_size_bytes <= 512, "pblang-codegen-x64 binary <= 512 bytes");
check(row_tier1.artifact_size_bytes <= 512, "pblang-tier1-x64 binary <= 512 bytes");

// 4. Verify synthetic catalog models explicitly declare measured_live == false and mode == "synthetic_catalog_model"
let audit = WAVE.run_omni_computing_and_devtools_supremacy_audit(map{
    workload_ops: 1000000,
    qubits: 14,
    dna_length: 300,
    signal_samples: 4096,
    neurons: 2048
});
check(audit.ok == true, "omni synthetic catalog evaluation ok");
check(audit.measured_live == false and audit.mode == "synthetic_catalog_model", "audit marked synthetic_catalog_model");
check(audit.multi_arch_and_modes.measured_live == false, "multi_arch_and_modes marked measured_live == false");
check(audit.multi_arch_and_modes.architecture_count == 12, "12 hardware architectures cataloged");
check(audit.multi_arch_and_modes.mode_count == 3, "3 execution modes cataloged");
check(audit.multi_arch_and_modes.competitor_count == 20, "20 competitor ecosystems cataloged");

let w10 = WAVE.run_pblang_omni_supremacy_wave10_suite();
check(w10.ok == true and w10.measured_live == false and w10.mode == "synthetic_catalog_model", "wave10 marked synthetic_catalog_model");

print "OMNI_BENCH_HONESTY_AND_CATALOG_PASS checks=" + str(checks);
