let DB = import("stdlib:db.sapp");
let NET = import("stdlib:net/index.sapp");
let ARM64 = import("stdlib:native/codegen_arm64.sapp");
let DM = import("stdlib:desktop_media/index.sapp");
let UI_IDX = import("stdlib:ui/index.sapp");
let CRYPTO_IDX = import("stdlib:crypto/index.sapp");
let POLY_IDX = import("stdlib:polyglot/index.sapp");
let DEV = import("stdlib:devtools/index.sapp");
let SYS = import("stdlib:sys/index.sapp");

let assertions_passed = 0;

fn check_true(cond, label) {
    if not cond {
        throw "V4.2.0 ASSERTION FAILED: " + str(label);
    }
    assertions_passed = assertions_passed + 1;
}

fn check_throws(thunk, label) {
    let threw = false;
    try {
        thunk();
    } catch err_msg {
        threw = true;
    }
    if not threw {
        throw "V4.2.0 SECURITY/SAFETY INVARIANT DID NOT THROW: " + str(label);
    }
    assertions_passed = assertions_passed + 1;
}

println("=== PBLang v4.2.0 Sovereign Six-Pillar & Zero-Vulnerability Suite ===");

// ── PILLAR 1: Enterprise DB Wire Drivers, MVCC/AEAD DB, Pool & SQL Safety ────
let mem_db = DB.memory.open();
mem_db.exec("CREATE TABLE accounts (id INTEGER PRIMARY KEY, email TEXT, balance INTEGER)");
DB.memory.create_index(mem_db, "accounts", "email", "hash");
DB.memory.create_index(mem_db, "accounts", "balance", "btree");

mem_db.exec("INSERT INTO accounts (id, email, balance) VALUES (?, ?, ?)", [1, "alice@example.org", 1500]);
mem_db.exec("INSERT INTO accounts (id, email, balance) VALUES (?, ?, ?)", [2, "bob@example.org", 3200]);

// MVCC Snapshot Rollback Isolation
mem_db.exec("BEGIN");
mem_db.exec("UPDATE accounts SET balance = ? WHERE email = ?", [999999, "alice@example.org"]);
check_true(DB.query_value(mem_db, "SELECT balance FROM accounts WHERE email = ?", ["alice@example.org"]) == 999999, "MVCC read-own-write");
mem_db.exec("ROLLBACK");
check_true(DB.query_value(mem_db, "SELECT balance FROM accounts WHERE email = ?", ["alice@example.org"]) == 1500, "MVCC atomic rollback");

let rich_rows = mem_db.query("SELECT email, balance FROM accounts WHERE balance >= ?", [2000]);
check_true(len(rich_rows) == 1 and rich_rows[0].email == "bob@example.org", "B-Tree range index query");

// AEAD AES-256-GCM Encrypted Snapshot + 1-Byte Tamper Rejection
let snap_path = "/tmp/pblang_v420_snap_" + str(SYS.pure_monotonic_ns()) + ".pbsdb";
let snap_key = "Sovereign-DB-Key-2026-Strong-32B!";
DB.memory.save_encrypted_snapshot(mem_db, snap_path, snap_key);
let restored_db = DB.memory.load_encrypted_snapshot(snap_path, snap_key);
check_true(DB.query_value(restored_db, "SELECT balance FROM accounts WHERE id = ?", [2]) == 3200, "AES-256-GCM snapshot roundtrip");
check_throws(fn() {
    DB.memory.load_encrypted_snapshot(snap_path, "Wrong-Key-Material-Must-Fail-AEAD!");
}, "AEAD snapshot wrong-key rejection");
try fs_remove(snap_path) catch nil;

// Wire Placeholder Normalization, DSN Secret Redaction & SQLi Runtime Guard
let pg_norm = DB.sql.postgres_placeholders("SELECT * FROM users WHERE org = ? AND id = ?");
check_true(str_contains(str(pg_norm), "$1") and str_contains(str(pg_norm), "$2"), "PostgreSQL v3 $1/$2 placeholder rewrite");
let redacted = DB.unified.redact_dsn("postgres://svc_user:UltraS3cretPass!@127.0.0.1:5432/ledger");
check_true(not str_contains(redacted, "UltraS3cretPass!"), "DSN password redaction");
check_throws(fn() {
    DB.sql.guard_parameterized("SELECT * FROM accounts WHERE email = 'admin' OR 1=1 --", [], true);
}, "Runtime SQL injection tautology/comment block");

// Connection Pool & SHA-256 Schema Migrations
let db_pool = DB.pool.create("memory://v420_pool_test", map{ max_size: 4 });
let mig_res = DB.pool.with_conn(db_pool, fn(c) {
    return DB.migrations.run(c, [
        map{ version: 1, name: "init_items", up: "CREATE TABLE items (id INTEGER PRIMARY KEY, sku TEXT)", down: "DROP TABLE items" }
    ]);
});
check_true(is_map(mig_res), "SHA-256 tracked DB migration over pool");
DB.pool.close(db_pool);
println("[1/6] PASS: Pillar 1 — Enterprise DB Wire Drivers, MVCC+Indexes, AES-256-GCM Snapshot & SQLi Shield");

// ── PILLAR 2: Multi-Gen Adaptive HTTP (0.9–3), HPACK/QPACK, QUIC, DoQ & Security ─
let h09 = NET.encode_http09_request("/cern/1991.html");
check_true(h09 == "GET /cern/1991.html\r\n", "HTTP/0.9 encode");
check_throws(fn() { NET.encode_http09_request("/bad\r\nHost: evil"); }, "HTTP/0.9 CRLF injection block");

let h10_resp = NET.decode_http10_response("HTTP/1.0 200 OK\r\nContent-Type: text/plain\r\n\r\nHello-1996");
check_true(h10_resp.status == 200 and h10_resp.body == "Hello-1996", "HTTP/1.0 response decode");
check_throws(fn() { NET.encode_http10_request("GET", "/", map{ "X-Inj": "a\r\nEvil: 1" }, nil); }, "HTTP/1.0 CRLF header injection block");

// SSRF Metadata & Private Network Guard
check_throws(fn() { NET.check_url_ssrf("http://169.254.169.254/latest/meta-data/"); }, "Cloud metadata 169.254.169.254 SSRF block");

// HTTP/2 HPACK Compression & CVE-2023-44487 Rapid-Reset / Smuggling Shields
let hpack_enc = NET.hpack_new_context(4096);
let hpack_dec = NET.hpack_new_context(4096);
let req_hdrs = [
    [":method", "GET"],
    [":scheme", "https"],
    [":authority", "api.example.org"],
    [":path", "/v1/telemetry"],
    ["user-agent", "pblang-sovereign/4.2.0"],
    ["accept", "application/json"]
];
let b1 = NET.hpack_encode_headers(hpack_enc, req_hdrs);
let b2 = NET.hpack_encode_headers(hpack_enc, req_hdrs);
check_true(len(b2) < len(b1) / 2, "HPACK dynamic table >50% header compression on repeat burst");
let d1 = NET.hpack_decode_headers(hpack_dec, b1);
let d2 = NET.hpack_decode_headers(hpack_dec, b2);
check_true(len(d1) == 6 and len(d2) == 6, "HPACK lossless roundtrip");
check_throws(fn() {
    NET.hpack_encode_headers(hpack_enc, [[":method", "GET"], ["transfer-encoding", "chunked"]]);
}, "HTTP/2 connection-specific Transfer-Encoding smuggling block");

// CVE-2023-44487 HTTP/2 Rapid-Reset DoS Protection
let h2_srv = NET.h2_new_connection("server", map{ max_rst_per_window: 4 });
let rst_tripped = false;
let s_idx = 0;
while s_idx < 8 {
    let sid = 1 + s_idx * 2;
    let hdr_blk = NET.hpack_encode_headers(NET.hpack_new_context(4096), [[":method", "GET"], [":scheme", "https"], [":authority", "example.org"], [":path", "/"]]);
    NET.h2_receive_frame(h2_srv, NET.h2_decode_frame(NET.h2_encode_frame(1, 0x04, sid, hdr_blk), 0));
    let rst_payload = [0, 0, 0, 8]; // CANCEL (0x08)
    let ev_rst = NET.h2_receive_frame(h2_srv, NET.h2_decode_frame(NET.h2_encode_frame(3, 0, sid, rst_payload), 0));
    if not ev_rst.ok and ev_rst.goaway {
        rst_tripped = true;
        break;
    }
    s_idx = s_idx + 1;
}
check_true(rst_tripped, "CVE-2023-44487 HTTP/2 Rapid-Reset rate limiter triggers GOAWAY(ENHANCE_YOUR_CALM)");

// HTTP/3 + QPACK + QUIC + WebTransport + DoQ + Alt-Svc SSRF Guard + Adaptive Selector
let qp_blk = NET.qpack_encode_headers([[":method", "POST"], [":scheme", "https"], [":authority", "edge.example.org"], [":path", "/ingest"]]);
let qp_dec = NET.qpack_decode_headers(qp_blk);
check_true(len(qp_dec) == 4, "HTTP/3 QPACK header roundtrip");

let wt_dg = NET.wt_encode_datagram(4, "realtime-pose-tick");
let wt_unpacked = NET.wt_decode_datagram(wt_dg);
check_true(wt_unpacked.session_id == 4 and wt_unpacked.text == "realtime-pose-tick", "RFC 9297 WebTransport datagram roundtrip");

let dns_q = NET.encode_dns_query("pblang.org", 1, 0x4242, true);
let doq_frm = NET.doq_encode_frame(dns_q.packet);
let doq_dec = NET.doq_decode_frame(doq_frm, 0);
check_true(doq_dec.length == len(dns_q.packet), "RFC 9250 DNS-over-QUIC 2-byte length-prefixed frame");

let alt_cache = NET.new_alt_svc_cache();
check_throws(fn() {
    NET.record_alt_svc(alt_cache, "https://example.org:443", "h3=\"127.0.0.1:443\"; ma=3600");
}, "Alt-Svc SSRF redirect to loopback rejected");
check_throws(fn() {
    NET.record_alt_svc(alt_cache, "https://example.org:443", "h3=\":22\"; ma=3600");
}, "Alt-Svc privileged SSH port 22 hijack rejected");

let sel_loopback = NET.select_optimal_http_protocol(map{ scheme: "http", host: "127.0.0.1", rtt_ms: 0.1, concurrent_streams: 1 });
let sel_burst_h2 = NET.select_optimal_http_protocol(map{ scheme: "https", host: "api.example.org", rtt_ms: 18.0, packet_loss_pct: 0.0, concurrent_streams: 32, udp_blocked: true });
let sel_lossy_h3 = NET.select_optimal_http_protocol(map{ scheme: "https", host: "edge.example.org", rtt_ms: 85.0, packet_loss_pct: 2.5, concurrent_streams: 16, mobile_roaming: true, alt_svc_h3: true });
check_true(sel_loopback.chosen_protocol == "HTTP/1.1", "Adaptive HTTP picks HTTP/1.1 Keep-Alive on 0.1ms loopback");
check_true(sel_burst_h2.chosen_protocol == "HTTP/2", "Adaptive HTTP picks HTTP/2 for 32-stream low-loss burst / UDP-blocked");
check_true(sel_lossy_h3.chosen_protocol == "HTTP/3", "Adaptive HTTP picks HTTP/3 over QUIC on lossy mobile WAN");

let sec_hdrs = NET.build_hardened_http_security_headers();
check_true(str_contains(sec_hdrs.headers["Strict-Transport-Security"], "max-age="), "Hardened HSTS header");
check_true(NET.validate_sec_fetch_csrf(map{ "sec-fetch-site": "cross-site" }, "POST").ok == false, "Sec-Fetch-Site cross-site POST CSRF blocked");
println("[2/6] PASS: Pillar 2 — Adaptive HTTP/0.9–3, HPACK/QPACK, QUIC/WebTransport/DoQ & Anti-Exploit Shields");

// ── PILLAR 3: Deep Closures, Generic ADTs/?/Match, Pure ARM64 & Live W^X JIT ─
fn make_5_level_closure(a) {
    let shared = a;
    return fn(b) {
        shared = shared + b;
        return fn(c) {
            shared = shared + c;
            return fn(d) {
                return fn(e) {
                    return shared + d + e;
                };
            };
        };
    };
}
check_true(make_5_level_closure(10)(5)(3)(2)(1) == 21, "5-level mutable lexical upvalue chain");

let loop_thunks = [];
for idx in [0, 1, 2, 3] {
    array_push(loop_thunks, fn() { return idx * 10; });
}
check_true(loop_thunks[0]() == 0 and loop_thunks[1]() == 10 and loop_thunks[3]() == 30, "Per-iteration loop closure capture");

enum Outcome<T, E> {
    Ok(T),
    Err(E)
}

trait Measurable<T> {
    fn score(self) -> number;
}
check_true(Measurable.__trait_name == "Measurable", "Generic trait declaration");

fn parse_positive(n) {
    if n > 0 { return Outcome.Ok(n * 2); }
    return Outcome.Err("non-positive");
}

fn pipeline_double(n) {
    let v = parse_positive(n)?;
    return Outcome.Ok(v + 7);
}

let ok_out = pipeline_double(10);
let err_out = pipeline_double(-3);
let ok_val = match ok_out {
    case Outcome.Ok(x): x;
    case Outcome.Err(msg): -1;
};
let err_tag = match err_out {
    case Outcome.Ok(x): "unexpected";
    case Outcome.Err(msg): msg;
};
check_true(ok_val == 27 and err_tag == "non-positive", "Generic enum<T,E> + ? propagation + exhaustive destructuring match");

// 100% Pure-PBLang ARM64 (AArch64) Compiler -> ELF64 + Mach-O + Deterministic A64 CPU Emulation
let arm64_src = "fn fib(n) { if n <= 1 { return n; } return fib(n - 1) + fib(n - 2); }\nfn main() { return fib(10); }";
let arm64_elf = ARM64.build_linux_arm64_elf64(arm64_src);
let arm64_macho = ARM64.build_apple_silicon_macho64(arm64_src);
check_true(len(arm64_elf) > 120 and arm64_elf[0] == 0x7F and arm64_elf[18] == 183, "Linux AArch64 ELF64 binary emission (EM_AARCH64=183)");
check_true(len(arm64_macho) > 120, "Apple Silicon ARM64 Mach-O 64-bit binary emission");
let emu_res = ARM64.emulate_arm64_binary(arm64_elf);
check_true(emu_res.ok and emu_res.exit_code == 55, "Pure-PBLang ARM64 A64 CPU+FPU emulator executes fib(10) == 55");

// Direct OS Kernel W^X (RW -> RX, never RWX) Machine-Code Execution on x86_64
let caps = SYS.pure_os_capabilities();
if caps.arch == "x86_64" and caps.native_ffi_active {
    // SysV / Win64: `mov eax, 42; ret` (`B8 2A 00 00 00 C3`)
    let wx_blk = SYS.pure_wx_alloc([0xB8, 0x2A, 0x00, 0x00, 0x00, 0xC3]);
    SYS.pure_wx_protect_rx(wx_blk);
    let jit_rv = SYS.pure_wx_exec_i64(wx_blk, 0);
    SYS.pure_wx_free(wx_blk);
    check_true(jit_rv == 42, "Direct W^X (PROT_READ|PROT_EXEC) native CPU execution");
}
println("[3/6] PASS: Pillar 3 — Deep Closures, Generic ADTs/?/Match, Pure ARM64 ELF64/Mach-O & W^X JIT");

// ── PILLARS 4 & 5: Wayland/Vulkan 240Hz, OS Desktop, Consent Media & Barrels ─
let surf = DM.create_gpu_surface(map{ width: 64, height: 64, target_hz: 240, fractional_scale_120ths: 180 });
let hidpi = DM.compute_fractional_hidpi_metrics(1920, 1080, 180);
check_true(hidpi.scale_factor == 1.5 and hidpi.physical_width == 2880, "Wayland wp-fractional-scale-v1 150% HiDPI metrics");
DM.configure_surface_capture_shield(surf, map{ enabled: true, blur_on_unfocus: true });
let veil_ev = DM.handle_surface_security_event(surf, map{ kind: "focus_lost" });
check_true(veil_ev.veil_active == true, "Wayland/GPU compositor focus-lost anti-capture veil");

let vbus = DM.create_virtual_desktop_bus();
DM.clipboard_set_sensitive("Temp-OTP-884210", 50, map{ bus: vbus, now_ms: 1000 });
check_true(DM.clipboard_get_text(map{ bus: vbus, now_ms: 1020 }).text == "Temp-OTP-884210", "Sensitive clipboard before TTL");
check_true(DM.clipboard_get_text(map{ bus: vbus, now_ms: 1100 }).text == "", "Sensitive clipboard auto-wiped after TTL expiry");

// Strict Fail-Closed Zero-Trust Consent Gate on Microphone & Camera
let mic_deny = DM.open_audio_capture_stream(map{ backend: "loopback" });
let cam_deny = DM.open_camera_stream(map{ backend: "loopback" });
check_true(mic_deny.ok == false and mic_deny.code == DM.PERMISSION_DENIED_MIC, "Mic stream denied without explicit consent token");
check_true(cam_deny.ok == false and cam_deny.code == DM.PERMISSION_DENIED_CAMERA, "Camera stream denied without explicit consent token");

let mic_tok = DM.issue_media_consent_token("microphone", "sess-v420", 30000, 1000);
let mic_st = DM.open_audio_capture_stream(map{ consent_token: mic_tok, backend: "loopback", now_ms: 1010 });
let pcm_pkt = DM.capture_audio_frames(mic_st, 256, map{ now_ms: 1020 });
let wav_bytes = DM.export_audio_wav_bytes(pcm_pkt);
let wav_dec = DM.decode_audio_wav_bytes(wav_bytes);
check_true(len(wav_bytes) > 44 and len(wav_dec.samples) == 256, "Consent-gated PipeWire/WAV audio pipeline");
DM.revoke_media_consent_token(mic_tok);
let rev_cap = DM.capture_audio_frames(mic_st, 64, map{ consent_token: mic_tok, now_ms: 1030 });
check_true(rev_cap.ok == false, "Revoked mic consent token halts capture immediately");

check_true(UI_IDX.UI_NAMESPACE_VERSION == "4.2.0" and CRYPTO_IDX.CRYPTO_NAMESPACE_VERSION == "4.2.0" and POLY_IDX.POLYGLOT_NAMESPACE_VERSION == "4.2.0", "Thematic stdlib barrels v4.2.0");
println("[4/6] PASS: Pillars 4 & 5 — Wayland 240Hz/HiDPI, Native Desktop, Consent-Gated Media & Thematic Barrels");

// ── PILLAR 6: Static SQL Checker (Pass 7), Workspace LSP v4.2, Coverage & Fuzz ─
let bad_sql_code = "let DB = import(\"stdlib:db.sapp\");\nfn leak(u) { let c = DB.memory.open(); return c.query(\"SELECT * FROM t WHERE name = '\" + u + \"'\"); }\n";
let bad_sql_diag = DEV.check_source(bad_sql_code, "bad_sql.sapp");
