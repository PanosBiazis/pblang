    }
});
check_true(is_map(def_resp) and map_has(def_resp, "result") and def_resp["result"] != nil, "Workspace LSP v4.2 cross-file go-to-definition");

let fuzz_rep = DEV.fuzz_function(fn(x) {
    if x >= 42 { throw "overflow_threshold"; }
    return true;
}, map{ arity: 1, param_types: ["int"], max_iterations: 120, seed: 2026 });
check_true(fuzz_rep["bug_found"] == true and fuzz_rep["minimal_shrunk_input"][0] == 42, "Property fuzzer shrinks integer failure exactly to boundary 42");
println("[5/6] PASS: Pillar 6 — Compile-Time SQL Safety, Multi-File Workspace LSP v4.2 & Shrinking Fuzzer");

// ── UNIVERSAL ADAPTIVE HORIZON & PERMANENT ANTI-OOM SHIELD ───────────────────
let mcu_stack = SYS.select_adaptive_stack(map{ ram_mib: 1, word_bits: 8, has_tls: false });
let retro_stack = SYS.select_adaptive_stack(map{ ram_mib: 2048, word_bits: 64, has_aes_hw: false, has_avx2: false, has_tls: true });
