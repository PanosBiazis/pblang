DEV.lsp_handle_message(wlsp, map{ jsonrpc: "2.0", id: 0, method: "initialize", params: map{} });
DEV.lsp_index_file(wlsp, "file:///workspace/math_util.sapp", "export fn triple_val(x: number) -> number {\n    return x * 3;\n}\n");
