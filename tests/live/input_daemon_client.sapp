// Opt-in client for an isolated pbinputd integration test.

let D = import("stdlib:input_daemon.sapp");
let E = import("stdlib:input_events.sapp");

let token = try env_get("PB_INPUT_DAEMON_TOKEN") catch "";
let addr = try env_get("PB_INPUT_DAEMON_ADDR") catch "127.0.0.1:47652";
if len(token) < 32 { throw "input daemon live client: token is missing"; }

fn send(seq, event) {
    let socket = tcp_connect(addr);
    tcp_write(socket, D.make_request(token, seq, event) + "\n");
    let line = tcp_read_until(socket, "\n", 65536);
    tcp_close(socket);
    let response = json_parse(str_trim(line));
    if not response.result.ok { throw "input daemon live client: " + str(response.result.error); }
    return response.result;
}

let first = send(0, E.pointer_delta_event(13, 17).event);
let second = send(1, E.type_event("PBd!").event);
print json_stringify(map{ ok: true, first: first.event, second: second.event });
