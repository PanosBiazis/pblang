// Live native-X11 probe. Run only against a disposable nested X server such
// as Xephyr; this file intentionally is not part of tests/semantics.

let X = import("stdlib:x11_input.sapp");
let E = import("stdlib:input_events.sapp");

let host = X.available();
if not host.ok { throw "x11 isolated probe: X11/XTest backend unavailable"; }

let moved = X.execute(E.pointer_delta_event(37, 29).event);
if not moved.ok { throw "x11 isolated probe: relative motion failed: " + str(moved.error); }

let typed = X.execute(E.type_event("PBLang!").event);
if not typed.ok { throw "x11 isolated probe: ASCII typing failed: " + str(typed.error); }

// A fresh Xephyr keymap often has no Greek keycode. This result is observable
// and must not be promoted to success when XKeysymToKeycode returns zero.
let unicode = X.execute(E.type_event("α").event);

print json_stringify(map{
    ok: true,
    display: host.display,
    relative_motion: moved.ok,
    ascii_text: typed.ok,
    unicode_current_keymap: unicode.ok,
    unicode_note: if unicode.ok { "mapped by current X11 keymap" } else { "keysym absent from current X11 keymap" }
});
