// Live native-X11 probe. Run only against a disposable nested X server such
// as Xephyr; this file intentionally is not part of tests/semantics.

let X = import("stdlib:x11_input.sapp");
let E = import("stdlib:input_events.sapp");

let host = X.available();
if not host.ok { throw "x11 isolated probe: X11/XTest backend unavailable"; }

let moved = X.execute(E.pointer_delta_event(37, 29).event);
if not moved.ok { throw "x11 isolated probe: relative motion failed: " + str(moved.error); }

let typed = X.execute(E.type_event("PBLang!").event);
if not typed.ok { throw "x11 isolated probe: ASCII typing failed: " + str(typed.error); }

let unicode = X.execute(E.type_event("α").event);
if not unicode.ok or not unicode.layout_independent_unicode
    or unicode.semantic_unicode_scalars != 1 or not unicode.keymap_restored {
    throw "x11 isolated probe: reversible semantic Unicode failed: " + str(unicode);
}
let diverse = X.execute(E.type_event("AΑα😀≤").event);
if not diverse.ok or not diverse.layout_independent_unicode
    or diverse.semantic_unicode_scalars != 5 or not diverse.keymap_restored {
    throw "x11 isolated probe: multi-script semantic Unicode failed: " + str(diverse);
}

print json_stringify(map{
    ok: true,
    display: host.display,
    relative_motion: moved.ok,
    ascii_text: typed.ok,
    unicode_layout_independent: unicode.layout_independent_unicode,
    semantic_unicode_scalars: unicode.semantic_unicode_scalars,
    keymap_restored: unicode.keymap_restored,
    multi_script_scalars: diverse.semantic_unicode_scalars,
    multi_script_keymap_restored: diverse.keymap_restored
});
