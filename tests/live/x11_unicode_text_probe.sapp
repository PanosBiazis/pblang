// Toolkit-level Unicode text probe. Run only against a disposable nested X
// server with a focused text field; never against the operator display.

let X = import("stdlib:x11_input.sapp");
let E = import("stdlib:input_events.sapp");

let display = try env_get("DISPLAY") catch "";
if type(display) != "string" or not str_starts_with(display, ":")
    or display == ":0" or display == ":0.0" {
    throw "x11 Unicode text probe requires an isolated nested DISPLAY";
}
let expected = try env_get("PBLANG_X11_PROBE_TEXT") catch "AΑα😀≤";
if type(expected) != "string" or len(expected) == 0 {
    throw "x11 Unicode text probe requires non-empty PBLANG_X11_PROBE_TEXT";
}
let commit_raw = str_lower(str(try env_get("PBLANG_X11_PROBE_COMMIT") catch "true"));
let commit = commit_raw != "0" and commit_raw != "false" and commit_raw != "no";
let typed = X.execute(E.type_event(expected).event);
if not typed.ok or not typed.layout_independent_unicode
    or typed.semantic_unicode_scalars != len(expected) or not typed.keymap_restored {
    throw "x11 Unicode text probe actuation failed: " + str(typed);
}
if commit {
    let committed = X.execute(E.key_event("Enter").event);
    if not committed.ok { throw "x11 Unicode text probe could not commit the field"; }
}

print json_stringify(map{
    ok: true, expected: expected, scalars: typed.semantic_unicode_scalars,
    keymap_restored: typed.keymap_restored, server_synchronized: typed.server_synchronized,
    committed: commit
});
