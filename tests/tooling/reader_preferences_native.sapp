// Pure PBLang native verification: bounded keyboard preference focus journey on Greek guide page (390x844).
let App = import("../../examples/declarative_browser/app.sapp");
let Focus = import("../../examples/declarative_browser/focus_indicator.sapp");
let D = import("stdlib:browser_document.sapp");
let S = import("stdlib:browser_session.sapp");
let G = import("stdlib:graphics.sapp");
let FM = import("stdlib:font_metrics.sapp");

fn _cli_args() {
    let raw = try env_get("PBLANG_SCRIPT_ARGS") catch "";
    if type(raw) == "string" and raw != "" { return str_split(raw, "\n"); }
    let argv = os_args();
    let out = [];
    let after = false;
    for item in argv {
        if after { array_push(out, item); }
        elif item == "--" { after = true; }
    }
    return out;
}

fn _parse_opts(args) {
    let env_mode = try env_get("PBLANG_FOCUS_PROBE") catch "after";
    if env_mode == nil or env_mode == "" { env_mode = "after"; }
    let opts = map{ package: "", evidence: "", runtime: "", report: "", mode: env_mode, xvfb: false };
    let i = 0;
    while i < len(args) {
        let a = args[i];
        if a == "--xvfb" { opts.xvfb = true; i = i + 1; }
        elif (a == "--package" or a == "--evidence" or a == "--runtime" or a == "--report" or a == "--mode") and i + 1 < len(args) {
            opts[str_slice(a, 2, len(a))] = args[i + 1];
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return opts;
}

fn _font_measurer() {
    let fonts = map{};
    for fam in ["sans", "serif", "monospace", "system"] {
        let resolved = G.text_font_resolve(fam);
        fonts[fam] = if resolved != "" { FM.load(resolved) } else { nil };
    }
    return fn(text, px, family) {
        if text == "" { return map{ ok: true, width: 0, height: px }; }
        let fam = if map_has(fonts, family) { family } else { "sans" };
        let layout = try FM.layout(fonts[fam], text, px) catch nil;
        if layout != nil {
            return map{ ok: true, width: layout.width, height: layout.height };
        }
        return map{ ok: true, width: num_floor(len(text) * px * 0.6 + 0.999), height: px };
    };
}

fn _draw_and_observe(c, measure_fn, observations) {
    let canvas = map{
        clear: fn(_col) {},
        rect: fn(_x, _y, _rw, _rh, _col) {},
        rects: fn(_list, _col) {},
        line: fn(_x1, _y1, _x2, _y2, _col) {},
        point: fn(_x, _y, _col) {},
        circle: fn(_cx, _cy, _r, _col) {},
        textMeasure: fn(text, px, _adv, fam) { return measure_fn(text, px, fam); },
        textStyled: fn(_x, _y, _text, _col, _px, _adv, fam) {
            return map{ ok: true, font: fam, renderer: "native-aa-fontdue", positioning: "truetype-baseline" };
        }
    };
    App.draw(c, canvas);
    for w in c.form.widgets {
        assert(w.x >= 0 and w.y >= 0 and w.x + w.w <= c.width and w.y + w.h <= c.height, "widget within 390x844 bounds");
    }
    if c.form.focus != nil {
        assert(Focus.plan(c.form) != nil, "focused reader button has visible focus indicator");
    }
    let state = map{
        settings: c.settings,
        focus: c.form.focus,
        family: c.appearance.font_family,
        body_size: c.appearance.body_size,
        url: c.session.snapshot().url
    };
    array_push(observations, state);
    return state;
}

fn _press(c, name) {
    let k = if name == "Return" { "Enter" } else { name };
    App.update(c, [map{ type: "keydown", key: k }, map{ type: "keyup", key: k }]);
}

fn main() {
    let opts = _parse_opts(_cli_args());
    assert(opts.mode == "after" or opts.mode == "before", "supported focus probe mode");
    let measure = _font_measurer();

    let pages = App.pages();
    let guide_doc = D.create("Οδηγός ανάγνωσης", [
        map{ tag: "p", text: "Διάλεξε γραμματοσειρά και μέγεθος. Η εστίαση πρέπει να μένει στην επιλογή σου." },
        map{ tag: "p", text: "Χρησιμοποίησε Enter, Tab και Shift+Tab. Οι αλλαγές ισχύουν στο ίδιο έγγραφο." },
        map{ tag: "a", text: "Επιστροφή στην αρχή", href: "pb://home" }
    ]);
    let guide_html = D.export_html(guide_doc);
    pages["pb://guide"] = guide_html;

    let c = App.create();
    c.session.close();
    c.session = S.create(pages);
    c.session.navigate("pb://guide");
    c.width = 390;
    c.height = 844;
    App.set_text_measure(c, measure);
    App.refresh(c);
    c.form.focus = "appearance";

    let observations = [];
    let s0 = _draw_and_observe(c, measure, observations);
    assert(not s0.settings and s0.focus == "appearance", "initial appearance focus");

    _press(c, "Return");
    let s1 = _draw_and_observe(c, measure, observations);
    assert(s1.settings and s1.family == "sans" and s1.focus == "font_family", "Enter opened settings with font_family focused");

    _press(c, "Return");
    let s2 = _draw_and_observe(c, measure, observations);
    assert(s2.family == "serif" and s2.focus == "font_family", "font_family retained focus on serif");

    _press(c, "Return");
    let s3 = _draw_and_observe(c, measure, observations);
    assert(s3.family == "monospace" and s3.focus == "font_family", "font_family retained focus on monospace");

    _press(c, "Tab");
    let s4 = _draw_and_observe(c, measure, observations);
    assert(s4.focus == "body_size", "Tab moved focus to body_size");

    _press(c, "Return");
    let s5 = _draw_and_observe(c, measure, observations);
    assert(s5.body_size == 18 and s5.focus == "body_size", "body_size retained focus on 18");

    // Physical LeftShift held across both Tab presses.
    App.update(c, [map{ type: "keydown", key: "LeftShift" }]);
    _press(c, "Tab");
    let s6 = _draw_and_observe(c, measure, observations);
    assert(s6.focus == "font_family", "first Shift+Tab returned to font_family");
    _press(c, "Tab");
    let s7 = _draw_and_observe(c, measure, observations);
    assert(s7.focus == "appearance", "second Shift+Tab returned to Done (appearance)");
    App.update(c, [map{ type: "keyup", key: "LeftShift" }]);

    _press(c, "Return");
    let final_state = _draw_and_observe(c, measure, observations);
    assert(not final_state.settings and final_state.family == "monospace" and final_state.body_size == 18 and final_state.focus == "appearance" and final_state.url == "pb://guide", "complete keyboard preference journey preserved Greek page");
    assert(D.export_html(c.session.snapshot().document) == guide_html, "Greek document unchanged");

    c.session.close();

    let result = map{
        passed: true,
        settings: final_state.settings,
        focus: final_state.focus,
        family: final_state.family,
        body_size: final_state.body_size,
        url: final_state.url,
        observations: observations
    };
    if opts.evidence != "" {
        fs_mkdirs(opts.evidence);
        fs_write(path_join(opts.evidence, "acceptance.json"), json_stringify(result) + "\n");
    }
    if opts.report != "" {
        fs_write(opts.report, json_stringify(result) + "\n");
    }
    print json_stringify(result);
}

main();
