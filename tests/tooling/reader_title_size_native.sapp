// Pure PBLang native verification: title size customization across imported documents, session Apply, Reset, and backups.
let App = import("../../examples/declarative_browser/app.sapp");
let Store = import("../../examples/declarative_browser/appearance_store.sapp");
let Profile = import("../../examples/declarative_browser/appearance_profile.sapp");
let DocFile = import("../../examples/declarative_browser/document_file.sapp");
let Dir = import("stdlib:linux_dirfs.sapp");
let G = import("stdlib:graphics.sapp");
let FM = import("stdlib:font_metrics.sapp");

fn _cli_args() {
    let raw = try env_get("PBLANG_SCRIPT_ARGS") catch "";
    if type(raw) == "string" and raw != "" { return str_split(raw, "\n"); }
    let argv = os_args();
    let out = [];
    let after = false;
    for item in argv {
        if after { array_push(out, item); }
        elif item == "--" { after = true; }
    }
    return out;
}

fn _parse_opts(args) {
    let opts = map{ package: "", evidence: "", runtime: "", report: "", xvfb: false };
    let i = 0;
    while i < len(args) {
        let a = args[i];
        if a == "--xvfb" { opts.xvfb = true; i = i + 1; }
        elif (a == "--package" or a == "--evidence" or a == "--runtime" or a == "--report") and i + 1 < len(args) {
            opts[str_slice(a, 2, len(a))] = args[i + 1];
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return opts;
}

fn _mk_private_tmp(prefix) {
    let name = "pblang_tooling_s4_" + prefix + "_" + str(num_floor(now_ms()));
    let tmp_fs = Dir.open_absolute("/tmp", false, false);
    assert(tmp_fs.ok, "open /tmp handle");
    let created = Dir.mkdir_new(tmp_fs, name, false);
    let closed = Dir.close(tmp_fs);
    assert(created.ok and closed, "create private temp dir");
    return path_join("/tmp", name);
}

fn _rm_tree(path) {
    if not (try fs_exists(path) catch false) { return; }
    let entries = try fs_listdir(path) catch nil;
    if type(entries) == "array" {
        for name in entries { _rm_tree(path_join(path, name)); }
    }
    let _r = try fs_remove(path) catch nil;
}

fn _font_measurer() {
    let fonts = map{};
    for fam in ["sans", "serif", "monospace", "system"] {
        let resolved = G.text_font_resolve(fam);
        fonts[fam] = if resolved != "" { FM.load(resolved) } else { nil };
    }
    return fn(text, px, family) {
        if text == "" { return map{ ok: true, width: 0, height: px }; }
        let fam = if map_has(fonts, family) { family } else { "sans" };
        let layout = try FM.layout(fonts[fam], text, px) catch nil;
        if layout != nil {
            return map{ ok: true, width: layout.width, height: layout.height };
        }
        return map{ ok: true, width: num_floor(len(text) * px * 0.6 + 0.999), height: px };
    };
}

fn _key(c, name) {
    let k = if name == "Return" { "Enter" } else { name };
    App.update(c, [map{ type: "keydown", key: k }, map{ type: "keyup", key: k }]);
}

fn _tabs(c, n) {
    for _i n { _key(c, "Tab"); }
}

fn _click(c, x, y) {
    App.update(c, [
        map{ type: "mousedown", button: "Left", x: x, y: y },
        map{ type: "mouseup", button: "Left", x: x, y: y }
    ]);
}

fn _launch_doc(data_dir, doc_path, measure_fn) {
    let doc_info = DocFile.load(doc_path);
    assert(doc_info.ok, "admit imported HTML document");
    let loaded = Store.load(data_dir);
    let saver = fn(style) {
        let r = Store.save(data_dir, style, loaded.token);
        if r.confirmed { loaded.token = r.token; }
        return r;
    };
    let reloader = fn() {
        let fresh = Store.load(data_dir);
        if not fresh.ok or not fresh.can_save or fresh.token == "missing" { return map{ ok: false }; }
        loaded.token = fresh.token;
        return map{ ok: true, appearance: fresh.appearance, save: saver };
    };
    let c = App.create("local", "dark", nil, doc_info.source);
    App.enable_preferences(c, loaded.appearance, saver, loaded.message, reloader);
    App.set_text_measure(c, measure_fn);
    App.refresh(c);
    return c;
}

fn _current_profile(profile_path) {
    let parsed = Profile.decode(fs_read(profile_path));
    assert(parsed.ok, "valid saved profile");
    return parsed.appearance;
}

fn _journey(opts, work, data_dir) {
    let profile_path = path_join(path_join(data_dir, "reader-style"), "appearance-v1.json");
    let measure = _font_measurer();

    let doc1 = path_join(work, "Title — imported.html");
    fs_write(doc1, "<article><h1>Readable title — Τίτλος</h1><p>" + str_repeat("Reading text. ", 18) + "</p><a href=\"pb://guide\">Guide</a></article>");
    let original1 = fs_read_bytes(doc1);

    let c1 = _launch_doc(data_dir, doc1, measure);
    _click(c1, 700, 44);
    _tabs(c1, 2);
    assert(c1.form.focus == "title_size", "focused title_size");
    _key(c1, "Return");
    assert(c1.preferences.draft.title_size == 32 and not fs_exists(profile_path), "draft title_size 32 without saving");

    _tabs(c1, 5);
    assert(c1.form.focus == "style_save", "focused style_save");
    _key(c1, "Return");
    let saved = fs_read_bytes(profile_path);
    let style = _current_profile(profile_path);
    assert(style.title_size == 32 and style.body_size == 16 and style.font_scale == 1, "saved title_size 32");

    _click(c1, 700, 44);
    assert(not c1.settings and c1.appearance.title_size == 32, "returned to document with title_size 32");
    c1.session.close();
    assert(fs_read_bytes(doc1) == original1, "first document unchanged");

    // Second imported document reuses the exact saved profile; Apply does not overwrite.
    let doc2 = path_join(work, "Second document.html");
    fs_write(doc2, "<article><h1>Second document</h1><p>A new article retains the saved reading appearance.</p></article>");
    let original2 = fs_read_bytes(doc2);

    let c2 = _launch_doc(data_dir, doc2, measure);
    assert(fs_read_bytes(profile_path) == saved and c2.appearance.title_size == 32, "second document loaded saved title_size 32");
    _click(c2, 700, 44);
    App.update(c2, [map{ type: "resize", w: 320, h: 480 }]);
    _tabs(c2, 2);
    _key(c2, "Return");
    assert(c2.preferences.draft.title_size == 36 and fs_read_bytes(profile_path) == saved, "compact draft 36 did not write");

    _key(c2, "Next");
    assert(c2.form.focus == "style_apply", "compact actions page focused Apply");
    _key(c2, "Return");
    assert(c2.appearance.title_size == 36 and fs_read_bytes(profile_path) == saved, "Apply updated session only");
    _click(c2, 275, 32);
    assert(not c2.settings and c2.appearance.title_size == 36, "compact Done returned to session-36 document");
    c2.session.close();
    assert(fs_read_bytes(doc2) == original2, "second document unchanged");

    // Restart returns to saved 32, then Reset restores 28 and creates backup.
    let c3 = _launch_doc(data_dir, doc2, measure);
    assert(fs_read_bytes(profile_path) == saved and c3.appearance.title_size == 32, "restart restored saved 32");
    _click(c3, 700, 44);
    _tabs(c3, 8);
    assert(c3.form.focus == "style_reset", "focused style_reset");
    _key(c3, "Return");
    let reset = _current_profile(profile_path);
    assert(reset.title_size == 28 and reset.body_size == 16 and reset.font_scale == 1, "Reset defaults saved 28");
    _click(c3, 700, 44);
    c3.session.close();

    let style_dir = path_join(data_dir, "reader-style");
    let has_backup = false;
    for entry in fs_listdir(style_dir) {
        if str_starts_with(entry, "previous-") and str_ends_with(entry, ".json") {
            if fs_read_bytes(path_join(style_dir, entry)) == saved { has_backup = true; }
        }
    }
    assert(has_backup, "previous-*.json backup preserved exact 32-px profile bytes");

    let c4 = _launch_doc(data_dir, doc2, measure);
    assert(_current_profile(profile_path) == reset and c4.appearance.title_size == 28, "restart after Reset loaded 28");
    c4.session.close();
    assert(fs_read_bytes(doc2) == original2, "second document remained unchanged");

    let report = map{
        passed: true,
        real_launcher: true,
        saved_title: 32,
        reset_title: 28,
        new_document_same_saved_profile: true,
        apply_did_not_write: true,
        inputs_unchanged: true,
        backup_preserved: true,
        compact_choices_and_actions: true
    };
    if opts.evidence != "" {
        fs_mkdirs(opts.evidence);
        fs_write(path_join(opts.evidence, "acceptance.json"), json_stringify(report) + "\n");
    }
    if opts.report != "" {
        fs_write(opts.report, json_stringify(report) + "\n");
    }
    print json_stringify(report);
    return true;
}

fn main() {
    let opts = _parse_opts(_cli_args());
    let work = _mk_private_tmp("title_size");
    let data_dir = path_join(work, "data");
    let work_fs = Dir.open_absolute(work, false, true);
    assert(work_fs.ok and Dir.mkdir_new(work_fs, "data", false).ok and Dir.close(work_fs), "prepare private data folder");

    let ok = try _journey(opts, work, data_dir) catch false;

    _rm_tree(work);
    assert(not fs_exists(work), "cleaned temporary directory");
    assert(ok, "reader_title_size_native checks passed");
}

main();
