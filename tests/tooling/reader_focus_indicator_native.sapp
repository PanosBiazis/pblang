// Pure-PBLang verification of compact 3px high-contrast focus frame pixels, Tab/Shift+Tab transitions, large-text focus journey, and zero session-only writes.
let App = import("../../examples/declarative_browser/app.sapp");
let Focus = import("../../examples/declarative_browser/focus_indicator.sapp");
let Colors = import("stdlib:colors.sapp");
let Dir = import("stdlib:linux_dirfs.sapp");
let G = import("stdlib:graphics.sapp");
let FontMetrics = import("stdlib:font_metrics.sapp");

fn _parse_cli() {
    let raw = os_args();
    let out: any = map{package: nil, evidence: nil, report: nil, runtime: nil, xvfb: false};
    let after = false;
    let i = 0;
    while i < len(raw) {
        let arg = raw[i];
        if not after {
            if arg == "--" { after = true; }
        } elif arg == "--xvfb" {
            out.xvfb = true;
        } elif (arg == "--package" or arg == "--evidence" or arg == "--report" or arg == "--runtime") and i + 1 < len(raw) {
            let val = raw[i + 1];
            if arg == "--package" { out.package = val; }
            elif arg == "--evidence" { out.evidence = val; }
            elif arg == "--report" { out.report = val; }
            elif arg == "--runtime" { out.runtime = val; }
            i = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn _mkdir_private(parent, name) {
    let fs = Dir.open_absolute(parent, false, false);
    assert(fs.ok, "open parent");
    let created = Dir.mkdir_new(fs, name, false);
    let closed = Dir.close(fs);
    assert(created.ok and closed, "mkdir private");
    return parent + "/" + name;
}

fn _rm_tree(path) {
    let removed = false;
    try { fs_remove(path); removed = true; } catch {}
    if removed { return true; }
    let kids = try fs_listdir(path) catch nil;
    if type(kids) == "array" {
        for kid in kids { let _child = _rm_tree(path + "/" + kid); }
    }
    let ok = false;
    try { fs_remove(path); ok = true; } catch {}
    return ok;
}

fn _tree_entry_count(root) {
    let kids = try fs_listdir(root) catch nil;
    if type(kids) != "array" { return 0; }
    let count = 0;
    for kid in kids {
        count = count + 1 + _tree_entry_count(root + "/" + kid);
    }
    return count;
}

fn _make_text_measurer() {
    let cache_fonts = map{};
    let cache_metrics: any = map{};
    let cache_widths: any = map{};
    return fn(text, px, family) {
        if not map_has(cache_fonts, family) {
            let resolved = G.text_font_resolve(family);
            cache_fonts[family] = resolved;
            cache_metrics[family] = if resolved != "" { try FontMetrics.load(resolved) catch nil } else { nil };
        }
        let key = json_stringify([family, px, text]);
        if map_has(cache_widths, key) { return cache_widths[key]; }
        let layout = try FontMetrics.layout(cache_metrics[family], text, px) catch nil;
        let w = if layout != nil { layout.width } else { len(text) * num_max(4, num_floor(px * 0.56)) };
        let h = if layout != nil { layout.height } else { px };
        let res = map{ok: true, width: w, height: h, font: cache_fonts[family]};
        cache_widths[key] = res;
        return res;
    };
}

fn _to_rgb(col) {
    if type(col) == "array" and len(col) >= 3 {
        return [col[0], col[1], col[2], if len(col) >= 4 { col[3] } else { 255 }];
    }
    if type(col) == "string" {
        let parsed = try Colors.hex_checked(col) catch nil;
        if parsed != nil { return [parsed.r, parsed.g, parsed.b, 255]; }
    }
    return [0, 0, 0, 255];
}

fn _render_surface(c) {
    let state: any = map{bg: [15, 17, 26], ops: []};
    let canvas = map{
        clear: fn(col) {
            let rgba = _to_rgb(col);
            state.bg = [rgba[0], rgba[1], rgba[2]];
            state.ops = [];
        },
        rect: fn(rx, ry, rw, rh, col) {
            if rw > 0 and rh > 0 {
                array_push(state.ops, map{x: rx, y: ry, w: rw, h: rh, rgba: _to_rgb(col)});
            }
        },
        rects: fn(items, col) {
            let rgba = _to_rgb(col);
            for it in items {
                if it.w > 0 and it.h > 0 {
                    array_push(state.ops, map{x: it.x, y: it.y, w: it.w, h: it.h, rgba: rgba});
                }
            }
        },
        point: fn(px, py, col) {
            array_push(state.ops, map{x: px, y: py, w: 1, h: 1, rgba: _to_rgb(col)});
        },
        line: fn(_x1, _y1, _x2, _y2, _col) {},
        circle: fn(_cx, _cy, _r, _col) {}
    };
    let _d = App.draw(c, canvas);
    return state;
}

fn _pixel_at(surface, px, py) {
    let cur = [surface.bg[0], surface.bg[1], surface.bg[2]];
    for op in surface.ops {
        if px >= op.x and px < op.x + op.w and py >= op.y and py < op.y + op.h {
            let rgba = op.rgba;
            let a = rgba[3];
            if a >= 255 {
                cur = [rgba[0], rgba[1], rgba[2]];
            } elif a > 0 {
                cur = [
                    num_floor((rgba[0] * a + cur[0] * (255 - a)) / 255),
                    num_floor((rgba[1] * a + cur[1] * (255 - a)) / 255),
                    num_floor((rgba[2] * a + cur[2] * (255 - a)) / 255)
                ];
            }
        }
    }
    return cur;
}

fn _band_160(surface) {
    return [
        _pixel_at(surface, 160, 166),
        _pixel_at(surface, 160, 167),
        _pixel_at(surface, 160, 168)
    ];
}

fn _key(c, raw_name) {
    let k = if raw_name == "Return" { "Enter" } else { raw_name };
    let _d = App.update(c, [map{type: "keydown", key: k}]);
    let _u = App.update(c, [map{type: "keyup", key: k}]);
}

fn _shift_tab(c) {
    let _s1 = App.update(c, [map{type: "keydown", key: "LeftShift", shift: true}]);
    let _t1 = App.update(c, [map{type: "keydown", key: "Tab", shift: true}]);
    let _t2 = App.update(c, [map{type: "keyup", key: "Tab", shift: true}]);
    let _s2 = App.update(c, [map{type: "keyup", key: "LeftShift", shift: false}]);
}

fn _click(c, xpos, ypos) {
    let _d = App.update(c, [map{type: "mousedown", x: xpos, y: ypos, button: "Left"}]);
    let _u = App.update(c, [map{type: "mouseup", x: xpos, y: ypos, button: "Left"}]);
}

fn _close(c) {
    for _i 3 {
        if c.form.close_requested { break; }
        _key(c, "Escape");
    }
    assert(c.form.close_requested, "clean reader close");
    c.session.close();
}

fn _run(scratch) {
    let data_dir = _mkdir_private(scratch, "data");
    let profile_path = data_dir + "/reader-style/appearance-v1.json";
    let measurer = _make_text_measurer();

    let c = App.create("local", "dark");
    App.enable_preferences(c, nil, nil, "Session only: --with-profile to save", nil);
    App.set_text_measure(c, measurer);
    let _ref = App.refresh(c);
    _click(c, 700, 44);
    assert(c.settings and c.form.focus == "font_family", "Style opened on session-only launch");

    // 1. Compact 320x240 focus frame pixel verification.
    let _r_small = App.update(c, [map{type: "resize", w: 320, h: 240}]);
    _key(c, "Home");
    assert(c.form.focus == "font_family", "Home focused font_family");
    let plan_small = Focus.plan(c.form);
    assert(plan_small != nil and plan_small.thickness == 3 and plan_small.contrast >= 4.5, "Focus.plan 3px >= 4.5 contrast");
    let surf_small = _render_surface(c);

    _key(c, "Tab");
    assert(c.form.focus != "font_family", "Tab moved focus away from font_family");
    let surf_tab = _render_surface(c);

    _shift_tab(c);
    assert(c.form.focus == "font_family", "Shift+Tab restored focus to font_family");
    let surf_back = _render_surface(c);

    let white = [[255, 255, 255], [255, 255, 255], [255, 255, 255]];
    let accent = [[108, 92, 231], [108, 92, 231], [108, 92, 231]];
    assert(_band_160(surf_small) == white, "Compact focused frame is 3 white pixels thick at (160, 166..168)");
    assert(_band_160(surf_tab) == accent, "Tab removed old frame leaving accent fill");
    assert(_band_160(surf_back) == white, "Shift+Tab restored 3px white focus frame");
    // Also verify outside top edge (y = 165) is button accent fill, proving exact 3px thickness.
    assert(_pixel_at(surf_small, 160, 165) == [108, 92, 231] and _pixel_at(surf_small, 160, 169) == [108, 92, 231], "exact 3px top frame bounds");

    let ratio = Colors.contrast_ratio(map{r: 255, g: 255, b: 255}, map{r: 108, g: 92, b: 231});
    assert(ratio >= 4.5, "WCAG AA contrast >= 4.5");

    // 2. Large-text 320x480 keyboard focus journey.
    let _r_tall = App.update(c, [map{type: "resize", w: 320, h: 480}]);
    _key(c, "Home");
    let seq = ["Return", "Tab", "Return", "Return", "Tab", "Return", "Return", "Tab", "Return", "Tab", "Tab", "Return", "PageDown", "Return"];
    for k in seq { _key(c, k); }
    let _surf_large_settings = _render_surface(c);
    assert(c.appearance.font_family == "serif" and c.appearance.body_size == 20 and c.appearance.title_size == 36, "large-text session settings applied");

    _click(c, 275, 32);
    assert(not c.settings, "returned to large-text document");
    let _surf_large_doc = _render_surface(c);
    _key(c, "Tab");
    assert(Focus.plan(c.form) != nil, "document control has visible focus frame");
    let _surf_next = _render_surface(c);
    _key(c, "Return");
    _key(c, "End");
    let _surf_last = _render_surface(c);

    // First Escape on document clears focus or requests close cleanly; verify session-only never wrote profile.
    _close(c);
    assert(not fs_exists(profile_path) and _tree_entry_count(data_dir) == 0, "Session-only focus journey must not save");

    return map{
        passed: true,
        default_no_exec_no_profile_writes: true,
        large_text: true,
        keyboard_focus_journey: true,
        pixel_frame_thickness: 3,
        pixel_contrast_ratio: ratio,
        tab_removes_old_frame: true,
        shift_tab_restores_frame: true,
        visual_review_required: false
    };
}

fn main() {
    let cli = _parse_cli();
    let scratch_name = "pblang_tooling_s3_focus_ind_" + str(num_floor(now_ms()));
    let scratch = _mkdir_private("/tmp", scratch_name);
    let result = try _run(scratch) catch nil;
    let _cleaned = _rm_tree(scratch);
    assert(result != nil and result.passed == true, "reader_focus_indicator_native failed");
    let json_text = json_stringify(result);
    if cli.evidence != nil and cli.evidence != "" {
        fs_mkdirs(cli.evidence);
        fs_write(cli.evidence + "/acceptance.json", json_text + "\n");
    }
    if cli.report != nil and cli.report != "" {
        fs_mkdirs(path_dirname(cli.report));
        fs_write(cli.report, json_text + "\n");
    }
    print json_text;
}

main();
