// Pure-PBLang HF03 textarea ordered-keysym insertion, Greek Ctrl+Alpha select-all, replacement, and save/readback.
let GUI = import("stdlib:gui.sapp");
let X11Input = import("stdlib:x11_input.sapp");
let Hash = import("stdlib:sha256_pb.sapp");

fn _parse_cli() {
    let raw = os_args();
    let out = map{evidence: nil, report: nil, runtime: nil, fixture: nil, xvfb: false};
    let after = false;
    let i = 0;
    while i < len(raw) {
        let arg = raw[i];
        if not after {
            if arg == "--" { after = true; }
        } elif arg == "--xvfb" {
            out.xvfb = true;
        } elif (arg == "--evidence" or arg == "--report" or arg == "--runtime" or arg == "--fixture") and i + 1 < len(raw) {
            let val = raw[i + 1];
            if arg == "--evidence" { out.evidence = val; }
            elif arg == "--report" { out.report = val; }
            elif arg == "--runtime" { out.runtime = val; }
            elif arg == "--fixture" { out.fixture = val; }
            i = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn _resolve_runtime(explicit) {
    if explicit != nil and explicit != "" { return explicit; }
    let root = cwd();
    if fs_exists(root + "/pblang") { return root + "/pblang"; }
    if fs_exists(root + "/target/release/pblang") { return root + "/target/release/pblang"; }
    return "./pblang";
}

fn _rm_tree(path) {
    let removed = false;
    try { fs_remove(path); removed = true; } catch {}
    if removed { return true; }
    let kids = try fs_listdir(path) catch nil;
    if type(kids) == "array" {
        for kid in kids { let _child = _rm_tree(path + "/" + kid); }
    }
    let ok = false;
    try { fs_remove(path); ok = true; } catch {}
    return ok;
}

fn _digest_canvas() {
    let h = Hash.new();
    return map{
        clear: fn(c) { Hash.update(h, str_to_bytes("C:" + json_stringify(c) + ";")); },
        rect: fn(x, y, rw, rh, c) {
            if rw > 0 and rh > 0 {
                Hash.update(h, str_to_bytes("R:" + str(x) + "," + str(y) + "," + str(rw) + "," + str(rh) + "," + json_stringify(c) + ";"));
            }
        },
        rects: fn(items, c) {
            for r in items {
                if r.w > 0 and r.h > 0 {
                    Hash.update(h, str_to_bytes("R:" + str(r.x) + "," + str(r.y) + "," + str(r.w) + "," + str(r.h) + "," + json_stringify(c) + ";"));
                }
            }
        },
        point: fn(x, y, c) { Hash.update(h, str_to_bytes("P:" + str(x) + "," + str(y) + "," + json_stringify(c) + ";")); },
        line: fn(x1, y1, x2, y2, c) { Hash.update(h, str_to_bytes("L:" + str(x1) + "," + str(y1) + "," + str(x2) + "," + str(y2) + "," + json_stringify(c) + ";")); },
        circle: fn(cx, cy, r, c) { Hash.update(h, str_to_bytes("O:" + str(cx) + "," + str(cy) + "," + str(r) + "," + json_stringify(c) + ";")); },
        finish: fn() { return Hash.finish(h); }
    };
}

fn _send(form, widget, changes, received, ev) {
    if len(received) < 256 { array_push(received, ev); }
    let before = widget.value;
    let _r = GUI.handle_event(form, ev);
    if widget.value != before and len(changes) < 256 {
        array_push(changes, map{event: ev, value: widget.value});
    }
}

fn _stroke(form, widget, changes, received, key, text_val, shift_flag, ctrl_flag) {
    let down = map{
        type: "keydown",
        key: key,
        shift: shift_flag,
        ctrl: ctrl_flag,
        alt: false,
        meta: false,
        text: text_val
    };
    let up = map{
        type: "keyup",
        key: key,
        shift: shift_flag,
        ctrl: ctrl_flag,
        alt: false,
        meta: false
    };
    _send(form, widget, changes, received, down);
    _send(form, widget, changes, received, up);
}

fn _run(scratch, runtime) {
    let plan_insert = X11Input.text_plan("αβ\nγXδ");
    let plan_omega = X11Input.text_plan("Ω");
    assert(plan_insert.ok and plan_omega.ok, "X11 text plans valid for Greek+ASCII multiline");

    let f = GUI.form("HF03 Textarea", 520, 200);
    let w = GUI.textarea("entry", 20, 40, 460, 80, "");
    let _added = GUI.add(f, w);
    f.focus = "entry";
    let changes = [];
    let received = [];

    _stroke(f, w, changes, received, "Greek_alpha", "α", false, false);
    _stroke(f, w, changes, received, "Greek_beta", "β", false, false);
    _stroke(f, w, changes, received, "Enter", "", false, false);
    _stroke(f, w, changes, received, "Greek_gamma", "γ", false, false);
    _stroke(f, w, changes, received, "Greek_delta", "δ", false, false);
    _stroke(f, w, changes, received, "Left", "", false, false);

    _stroke(f, w, changes, received, "X", "X", true, false);
    assert(w.value == "αβ\nγXδ", "intermediate multiline Greek+ASCII insertion");

    let canvas_insert = _digest_canvas();
    let _d1 = GUI.draw(canvas_insert, f);
    let digest_insert = canvas_insert.finish();

    _stroke(f, w, changes, received, "Greek_alpha", "", false, true);
    assert(w.selection_anchor == 0 and w.caret == len("αβ\nγXδ"), "ctrl+Greek_alpha selected full textarea");
    _stroke(f, w, changes, received, "Greek_OMEGA", "Ω", true, false);
    assert(w.value == "Ω", "Greek selection replaced with Omega");

    let canvas_replace = _digest_canvas();
    let _d2 = GUI.draw(canvas_replace, f);
    let digest_replace = canvas_replace.finish();
    assert(digest_insert != digest_replace, "rendered frame reflects Omega replacement");

    let saw_intermediate = false;
    for item in changes {
        if item.value == "αβ\nγXδ" { saw_intermediate = true; }
    }
    assert(saw_intermediate, "intermediate αβ\\nγXδ recorded in change log");

    let saved_file = scratch + "/saved.txt";
    fs_write(saved_file, w.value);
    let reopened = fs_read(saved_file);
    assert(w.value == "Ω" and reopened == "Ω", "Omega save/readback verified");

    let confined = proc_spawn_wait(runtime, [
        "eval",
        "let s=fs_read(" + json_stringify(saved_file) + ");assert(s==\"Ω\",\"omega\");print s;",
        "--allow-all", "--deny-exec", "--deny-net", "--deny-http", "--deny-spawn"
    ]);
    assert(confined.exit_code == 0 and str_trim(confined.stdout) == "Ω", "confined textarea readback");

    return map{
        passed: true,
        value: w.value,
        reopened: reopened,
        changes: changes,
        received_count: len(received),
        input_backend: "x11-ordered-keysyms",
        insert_digest: digest_insert,
        replace_digest: digest_replace
    };
}

fn main() {
    let cli = _parse_cli();
    let runtime = _resolve_runtime(cli.runtime);
    let scratch = "/tmp/pblang_tooling_s3_textarea_" + str(num_floor(now_ms()));
    fs_mkdirs(scratch);
    let result = try _run(scratch, runtime) catch nil;
    let ok = result != nil;

    if ok and cli.evidence != nil {
        fs_mkdirs(cli.evidence);
        fs_write(cli.evidence + "/saved.txt", "Ω");
        fs_write(cli.evidence + "/result.json", json_stringify(result) + "\n");
    }
    if ok and cli.report != nil {
        fs_mkdirs(path_dirname(cli.report));
        fs_write(cli.report, json_stringify(result) + "\n");
    }
    let _cleaned = _rm_tree(scratch);
    assert(not fs_exists(scratch), "disposable scratch cleaned");
    assert(ok, "native_textarea_input verification failed");
    print "native_textarea_input_pass";
}

main();
