// Pure-PBLang verification of readable browser navigation, serif typography, natural advances, and bounded font caches.
let App = import("../../examples/declarative_browser/app.sapp");
let G = import("stdlib:graphics.sapp");
let GUI = import("stdlib:gui.sapp");
let FontMetrics = import("stdlib:font_metrics.sapp");

fn _parse_cli() {
    let raw = os_args();
    let out: any = map{evidence: nil, report: nil, runtime: nil, package: nil, width: nil, xvfb: false};
    let after = false;
    let i = 0;
    while i < len(raw) {
        let arg = raw[i];
        if not after {
            if arg == "--" { after = true; }
        } elif arg == "--xvfb" {
            out.xvfb = true;
        } elif (arg == "--evidence" or arg == "--report" or arg == "--runtime" or arg == "--package" or arg == "--width") and i + 1 < len(raw) {
            let val = raw[i + 1];
            if arg == "--evidence" { out.evidence = val; }
            elif arg == "--report" { out.report = val; }
            elif arg == "--runtime" { out.runtime = val; }
            elif arg == "--package" { out.package = val; }
            elif arg == "--width" { out.width = try parse_number(val) catch nil; }
            i = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn _rm_tree(path) {
    let removed = false;
    try { fs_remove(path); removed = true; } catch {}
    if removed { return true; }
    let kids = try fs_listdir(path) catch nil;
    if type(kids) == "array" {
        for kid in kids { let _child = _rm_tree(path + "/" + kid); }
    }
    let ok = false;
    try { fs_remove(path); ok = true; } catch {}
    return ok;
}

fn _proportional_fallback_width(text, px) {
    let total = 0;
    let i = 0;
    while i < len(text) {
        let cp = strcharcodeat(text, i);
        if cp == 32 or cp == 105 or cp == 108 or cp == 46 or cp == 44 {
            total = total + num_max(2, num_floor(px * 0.32));
        } elif cp == 87 or cp == 77 {
            total = total + num_max(6, num_floor(px * 0.85));
        } else {
            total = total + num_max(4, num_floor(px * 0.56));
        }
        i = i + 1;
    }
    return total;
}

fn _styled_canvas() {
    let state = map{
        closed: false,
        fonts: map{},
        metrics: map{},
        widths: map{},
        font_bytes: 0,
        width_bytes: 0,
        rects: 0
    };
    let measure_impl = fn(text, px, advance, family) {
        if state.closed { throw "window is closed"; }
        if not map_has(state.fonts, family) {
            let resolved = G.text_font_resolve(family);
            state.fonts[family] = resolved;
            let loaded = if resolved != "" { try FontMetrics.load(resolved) catch nil } else { nil };
            state.metrics[family] = loaded;
            if loaded != nil { state.font_bytes = state.font_bytes + loaded.cache_bytes; }
        }
        let key = json_stringify([family, px, advance, text]);
        if map_has(state.widths, key) { return state.widths[key]; }
        let width_px = 0;
        let height_px = px;
        let positioning = "truetype-baseline";
        if advance > 0 {
            width_px = len(text) * advance;
            positioning = "retained-host";
        } else {
            let layout = try FontMetrics.layout(state.metrics[family], text, px) catch nil;
            if layout != nil {
                width_px = layout.width;
                height_px = layout.height;
            } else {
                width_px = _proportional_fallback_width(text, px);
                positioning = "proportional-fallback";
            }
        }
        let res = map{
            ok: true,
            width: width_px,
            height: height_px,
            font: state.fonts[family],
            renderer: "native-aa-fontdue",
            positioning: positioning
        };
        let cost = len(str_to_bytes(key)) + 64;
        if state.width_bytes + cost > 131072 {
            state.widths = map{};
            state.width_bytes = 0;
        }
        state.widths[key] = res;
        state.width_bytes = state.width_bytes + cost;
        return res;
    };
    return map{
        clear: fn(_c) {},
        rect: fn(_x, _y, rw, rh, _c) { if rw > 0 and rh > 0 { state.rects = state.rects + 1; } },
        rects: fn(items, _c) { state.rects = state.rects + len(items); },
        point: fn(_x, _y, _c) {},
        line: fn(_x1, _y1, _x2, _y2, _c) {},
        circle: fn(_cx, _cy, _r, _c) {},
        textMeasure: measure_impl,
        textStyled: fn(_x, _y, text, _color, px, advance, family) {
            return measure_impl(text, px, advance, family);
        },
        textCacheStatus: fn() {
            let chars = 0;
            for fam in map_keys(state.metrics) {
                let fnt = state.metrics[fam];
                if fnt != nil { chars = chars + fnt.metric_cache_bytes; }
            }
            return map{
                font_bytes: state.font_bytes,
                character_bytes: chars,
                run_bytes: 0,
                measurement_bytes: state.width_bytes,
                payload_bytes: state.font_bytes + chars + state.width_bytes,
                payload_limit: 9568256,
                includes_vm_overhead: false
            };
        },
        close: fn() {
            state.closed = true;
            state.fonts = map{};
            state.metrics = map{};
            state.widths = map{};
            state.font_bytes = 0;
            state.width_bytes = 0;
        }
    };
}

fn _press(controller, raw_key, shift_flag) {
    let key = if raw_key == "Return" { "Enter" } else { raw_key };
    if shift_flag {
        let _s1 = App.update(controller, [map{type: "keydown", key: "LeftShift", shift: true}]);
        let _k1 = App.update(controller, [map{type: "keydown", key: key, shift: true}]);
        let _k2 = App.update(controller, [map{type: "keyup", key: key, shift: true}]);
        let _s2 = App.update(controller, [map{type: "keyup", key: "LeftShift", shift: false}]);
    } else {
        let _k1 = App.update(controller, [map{type: "keydown", key: key}]);
        let _k2 = App.update(controller, [map{type: "keyup", key: key}]);
    }
}

fn _snapshot_state(controller, canvas, probe_path) {
    let begin = now_ms();
    let _drawn = App.draw(controller, canvas);
    let snap = controller.session.snapshot();
    let state = map{
        url: snap.url,
        navigations: controller.navigations,
        settings: controller.settings,
        family: controller.appearance.font_family,
        draw_ms: now_ms() - begin
    };
    fs_write(probe_path, json_stringify(state));
    return state;
}

fn _run_for_width(width, scratch) {
    let c = App.create();
    c.width = width;
    c.height = if width == 390 { 844 } else { 816 };
    let canvas = _styled_canvas();
    App.set_text_measure(c, fn(text, size, family) { return canvas.textMeasure(text, size, 0, family); });
    let _refreshed = App.refresh(c);

    let fixed = canvas.textMeasure("iiii Wide words", 18, 12, "sans");
    let natural = canvas.textMeasure("iiii Wide words", 18, 0, "sans");
    assert(fixed.ok and natural.ok and natural.width < fixed.width, "natural advances narrower than fixed cell grid");

    let probe_path = scratch + "/reader-probe-" + str(width) + ".json";
    let observations = [];

    let s0 = _snapshot_state(c, canvas, probe_path);
    assert(s0.navigations == 0 and not s0.settings and s0.url == "pb://home", "initial state settled");
    array_push(observations, s0);

    for k in ["Tab", "Tab", "Tab", "Return"] { _press(c, k, false); }
    let s1 = _snapshot_state(c, canvas, probe_path);
    assert(s1.navigations == 1 and s1.url == "pb://guide", "followed local guide link");
    array_push(observations, s1);

    for k in ["Tab", "Return"] { _press(c, k, false); }
    let s2 = _snapshot_state(c, canvas, probe_path);
    assert(s2.navigations == 2 and s2.url == "pb://home", "navigated back home");
    array_push(observations, s2);

    for k in ["Tab", "Return"] { _press(c, k, false); }
    let s3 = _snapshot_state(c, canvas, probe_path);
    assert(s3.navigations == 3 and s3.url == "pb://guide", "navigated forward to guide");
    array_push(observations, s3);

    for k in ["Tab", "Tab", "Tab", "Return"] { _press(c, k, false); }
    let s4 = _snapshot_state(c, canvas, probe_path);
    assert(s4.settings and s4.family == "sans", "opened Style preferences");
    array_push(observations, s4);

    _press(c, "Return", false);
    let s5 = _snapshot_state(c, canvas, probe_path);
    assert(s5.settings and s5.family == "serif", "cycled font_family to serif");
    array_push(observations, s5);

    _press(c, "Tab", true);
    _press(c, "Return", false);
    let s6 = _snapshot_state(c, canvas, probe_path);
    assert(not s6.settings and s6.family == "serif", "returned from Style with serif active");
    array_push(observations, s6);

    let cache_before = canvas.textCacheStatus();
    assert(cache_before.payload_bytes <= cache_before.payload_limit, "bounded font caches");
    canvas.close();
    let cleared = canvas.textCacheStatus();
    assert(cleared.payload_bytes == 0, "caches cleared on close");
    assert((try canvas.textMeasure("closed", 16, 0, "sans") catch nil) == nil, "closed canvas rejects measurement");

    let snap = c.session.snapshot();
    let title = GUI.get(c.form, "page_title");
    assert(snap.url == "pb://guide" and c.navigations == 3, "guide destination preserved");
    assert(not c.settings and c.appearance.font_family == "serif", "serif appearance retained");
    assert(title != nil and title.text_status.spacing == "natural" and title.text_status.requested_family == "serif", "styled title status");
    c.session.close();

    return map{
        url: snap.url,
        navigations: c.navigations,
        width: c.width,
        height: c.height,
        title: snap.document.form.title,
        typography: title.text_status,
        cache: cache_before,
        cache_after_close: cleared,
        fixed_width: fixed.width,
        natural_width: natural.width,
        observations: observations
    };
}

fn _run(scratch, cli) {
    let env_w = try parse_number(env_get("PBLANG_READER_WIDTH")) catch nil;
    let selected = if cli.width != nil { cli.width } elif env_w != nil { env_w } else { 800 };
    assert(selected == 800 or selected == 390, "supported reader probe width");
    let primary: any = _run_for_width(selected, scratch);
    let secondary_w = if selected == 800 { 390 } else { 800 };
    let secondary = _run_for_width(secondary_w, scratch);
    assert(secondary.url == "pb://guide" and secondary.typography.requested_family == "serif", "secondary viewport verified");
    primary["passed"] = true;
    primary["secondary_width_verified"] = secondary_w;
    return primary;
}

fn main() {
    let cli = _parse_cli();
    let scratch = "/tmp/pblang_tooling_s3_readable_browser_" + str(num_floor(now_ms()));
    fs_mkdirs(scratch);
    let result = try _run(scratch, cli) catch nil;
    let ok = result != nil;

    if ok and cli.evidence != nil {
        fs_mkdirs(cli.evidence);
        fs_write(cli.evidence + "/acceptance.json", json_stringify(result) + "\n");
    }
    if ok and cli.report != nil {
        fs_mkdirs(path_dirname(cli.report));
        fs_write(cli.report, json_stringify(result) + "\n");
    }
    let _cleaned = _rm_tree(scratch);
    assert(not fs_exists(scratch), "disposable scratch cleaned");
    assert(ok, "readable_browser_native verification failed");
    print json_stringify(result);
}

main();
