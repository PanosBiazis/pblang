// Pure PBLang native verification: paginated Greek reader keyboard/resize journey and anchor preservation.
let App = import("../../examples/declarative_browser/app.sapp");
let D = import("stdlib:browser_document.sapp");
let S = import("stdlib:browser_session.sapp");
let G = import("stdlib:graphics.sapp");
let FM = import("stdlib:font_metrics.sapp");

fn _cli_args() {
    let raw = try env_get("PBLANG_SCRIPT_ARGS") catch "";
    if type(raw) == "string" and raw != "" { return str_split(raw, "\n"); }
    let argv = os_args();
    let out = [];
    let after = false;
    for item in argv {
        if after { array_push(out, item); }
        elif item == "--" { after = true; }
    }
    return out;
}

fn _parse_opts(args) {
    let opts = map{ package: "", evidence: "", runtime: "", report: "", xvfb: false };
    let i = 0;
    while i < len(args) {
        let a = args[i];
        if a == "--xvfb" { opts.xvfb = true; i = i + 1; }
        elif (a == "--package" or a == "--evidence" or a == "--runtime" or a == "--report") and i + 1 < len(args) {
            opts[str_slice(a, 2, len(a))] = args[i + 1];
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return opts;
}

fn _font_measurer() {
    let fonts = map{};
    for fam in ["sans", "serif", "monospace", "system"] {
        let resolved = G.text_font_resolve(fam);
        fonts[fam] = if resolved != "" { FM.load(resolved) } else { nil };
    }
    return fn(text, px, family) {
        if text == "" { return map{ ok: true, width: 0, height: px }; }
        let fam = if map_has(fonts, family) { family } else { "sans" };
        let layout = try FM.layout(fonts[fam], text, px) catch nil;
        if layout != nil {
            return map{ ok: true, width: layout.width, height: layout.height };
        }
        return map{ ok: true, width: num_floor(len(text) * px * 0.6 + 0.999), height: px };
    };
}

fn _observe(c, measure_fn, observations) {
    let canvas = map{
        clear: fn(_col) {},
        rect: fn(_x, _y, _rw, _rh, _col) {},
        rects: fn(_list, _col) {},
        line: fn(_x1, _y1, _x2, _y2, _col) {},
        point: fn(_x, _y, _col) {},
        circle: fn(_cx, _cy, _r, _col) {},
        textMeasure: fn(text, px, _adv, fam) { return measure_fn(text, px, fam); },
        textStyled: fn(_x, _y, _text, _col, _px, _adv, fam) {
            return map{ ok: true, font: fam, renderer: "native-aa-fontdue", positioning: "truetype-baseline" };
        }
    };
    App.draw(c, canvas);
    let bounds = true;
    for widget in c.form.widgets {
        if widget.x < 0 or widget.y < 0 or widget.x + widget.w > c.form.w or widget.y + widget.h > c.form.h {
            bounds = false;
        }
    }
    let state = map{
        page: c.reading_page,
        pages: if c.reading_plan == nil { 1 } else { len(c.reading_plan.pages) },
        anchor: c.reading_anchor,
        settings: c.settings,
        focus: c.form.focus,
        body_size: c.appearance.body_size,
        width: c.width,
        height: c.height,
        bounds: bounds,
        url: c.session.snapshot().url
    };
    array_push(observations, state);
    return state;
}

fn _press(c, name) {
    let k = if name == "Return" { "Enter" } else { name };
    App.update(c, [map{ type: "keydown", key: k }, map{ type: "keyup", key: k }]);
}

fn main() {
    let opts = _parse_opts(_cli_args());
    let measure = _font_measurer();

    let blocks = [];
    for i 3 {
        array_push(blocks, map{
            tag: "p",
            text: "Ενότητα " + str(i + 1) + ". Μεγαλύτερα γράμματα, χωρίς χαμένο κείμενο. Η σελιδοποίηση κρατά τη θέση ανάγνωσης όταν αλλάζεις το παράθυρο. " + str_repeat("Read every sentence. ", 4)
        });
    }
    array_push(blocks, map{ tag: "a", text: "Τέλος οδηγού — άνοιγμα τοπικού προορισμού", href: "pb://about" });
    let document = D.create("Οδηγός με μεγάλα γράμματα", blocks);
    let original = D.export_html(document);

    let c = App.create();
    let local = App.pages();
    local["pb://guide"] = original;
    c.session.close();
    c.session = S.create(local);
    c.session.navigate("pb://guide");
    c.width = 390;
    c.height = 844;
    App.configure(c, map{ body_size: 20, font_scale: 1.5 });
    App.refresh(c);

    let observations = [];
    let first = _observe(c, measure, observations);
    assert(first.page == 0 and not first.settings and first.bounds and first.pages > 1, "initial paginated state");

    _press(c, "Next");
    let second = _observe(c, measure, observations);
    assert(second.page == 1 and second.bounds, "Next advanced to page 1");
    let anchor = second.anchor;

    for _i 2 { _press(c, "Tab"); }
    let s_focus = _observe(c, measure, observations);
    if s_focus.focus != "appearance" {
        _press(c, "Tab");
        s_focus = _observe(c, measure, observations);
    }
    assert(s_focus.focus == "appearance", "focused appearance button");

    _press(c, "Return");
    let s_open = _observe(c, measure, observations);
    assert(s_open.settings and s_open.focus == "font_family", "opened Style settings");

    _press(c, "Tab");
    assert(_observe(c, measure, observations).focus == "body_size", "focused body_size");
    _press(c, "Return");
    let s_size = _observe(c, measure, observations);
    assert(s_size.body_size == 14 and s_size.focus == "body_size", "cycled body_size 20 -> 14");

    App.update(c, [map{ type: "keydown", key: "LeftShift" }]);
    _press(c, "Tab");
    _press(c, "Tab");
    App.update(c, [map{ type: "keyup", key: "LeftShift" }]);
    assert(_observe(c, measure, observations).focus == "appearance", "Shift+Tab x2 focused Done");

    _press(c, "Return");
    let s_closed = _observe(c, measure, observations);
    assert(not s_closed.settings and s_closed.anchor == anchor and s_closed.bounds, "closing settings preserved anchor");

    App.update(c, [map{ type: "resize", w: 320, h: 480 }]);
    let s_narrow = _observe(c, measure, observations);
    assert(s_narrow.width == 320 and s_narrow.height == 480 and s_narrow.anchor == anchor and s_narrow.bounds, "320x480 resize preserved anchor");

    _press(c, "End");
    let s_end = _observe(c, measure, observations);
    assert(s_end.page == s_end.pages - 1 and s_end.bounds, "End reached last page");

    for _i 8 {
        if c.form.focus == "block3" { break; }
        _press(c, "Tab");
    }
    assert(_observe(c, measure, observations).focus == "block3", "focused last-page local link block3");

    _press(c, "Return");
    let s_dest = _observe(c, measure, observations);
    assert(s_dest.url == "pb://about" and c.navigations == 1 and s_dest.bounds, "last-page link navigated to pb://about");

    _press(c, "Escape");
    if not c.form.close_requested { _press(c, "Escape"); }
    assert(c.form.close_requested, "Escape requested clean close");
    assert(D.export_html(document) == original, "source content preserved");
    c.session.close();

    let report = map{
        result: "pass",
        passed: true,
        observations: observations,
        port_or_hardware_access: false
    };
    if opts.evidence != "" {
        fs_mkdirs(opts.evidence);
        fs_write(path_join(opts.evidence, "acceptance.json"), json_stringify(report) + "\n");
    }
    if opts.report != "" {
        fs_write(opts.report, json_stringify(report) + "\n");
    }
    print json_stringify(map{ result: "pass", passed: true, steps: len(observations), port_or_hardware_access: false });
}

main();
