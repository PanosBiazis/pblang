// Pure PBLang headless verification for UNO R4 LED Studio counter native journey:
// authored 2-frame state, Save counter 0..3 @ 1s, Start counter -> pixel buttons
// disabled & authored frames untouched on click, Stop -> pixel buttons re-enabled,
// explicit Capture -> updates selected frame, Project JSON export & roundtrip
// after Remove, and atomic rejection of invalid counter_seconds = 0.
// Never opens an X11 window on the user's desktop and cleans up all exports.

let GUI = import("stdlib:gui.sapp");
let SECURE_FILE = import("stdlib:secure_file.sapp");
let Model = import("../../examples/uno_r4_led_studio/model.sapp");
let View = import("../../examples/uno_r4_led_studio/view.sapp");

fn _has_str(items, target) {
    for item in items {
        if item == target {
            return true;
        }
    }
    return false;
}

fn _rm_rf(path) {
    if not fs_exists(path) {
        return 0;
    }
    let entries = try fs_listdir(path) catch nil;
    if type(entries) == "array" {
        for name in entries {
            if name != "." and name != ".." {
                _rm_rf(path + "/" + name);
            }
        }
    }
    let _removed = try fs_remove(path) catch nil;
    return 0;
}

fn _cleanup_exports(export_dir, had_export_dir, before_entries) {
    if not fs_exists(export_dir) {
        return 0;
    }
    let current = try fs_listdir(export_dir) catch [];
    if type(current) == "array" {
        for name in current {
            if name != "." and name != ".." and not _has_str(before_entries, name) {
                let _r = try fs_remove(export_dir + "/" + name) catch nil;
            }
        }
    }
    if not had_export_dir {
        let rem = try fs_listdir(export_dir) catch [];
        if type(rem) == "array" and len(rem) == 0 {
            let _rd = try fs_remove(export_dir) catch nil;
        }
    }
    return 0;
}

fn _snapshot_state(app) {
    let st = app.state;
    return map{
        frames_sha: sha256(Model.export_document(st)),
        project_sha: sha256(Model.export_project(st)),
        count: len(st.document.frames),
        index: st.index,
        source: st.source,
        playing: st.playing,
        value: st.counter_value,
        generator: st.generator,
        status: st.status,
        pixel_enabled: GUI.get(app.form, "pixel_0").enabled,
        counter_end: GUI.get(app.form, "counter_end").value,
        counter_seconds: GUI.get(app.form, "counter_seconds").value
    };
}

fn _click(app, px, py) {
    View.update(app, [
        map{type: "mousemove", x: px, y: py},
        map{type: "mousedown", button: "Left", x: px, y: py},
        map{type: "mouseup", button: "Left", x: px, y: py}
    ]);
    return _snapshot_state(app);
}

fn _replace_text(app, text_val) {
    View.update(app, [
        map{type: "keydown", key: "ControlLeft", ctrl: true},
        map{type: "keydown", key: "A", ctrl: true},
        map{type: "keyup", key: "A", ctrl: true},
        map{type: "keyup", key: "ControlLeft", ctrl: false}
    ]);
    let n = len(text_val);
    let i = 0;
    while i < n {
        let ch = str_slice(text_val, i, i + 1);
        View.update(app, [
            map{type: "keydown", key: ch, text: ch},
            map{type: "keyup", key: ch}
        ]);
        i = i + 1;
    }
    return _snapshot_state(app);
}

fn _run_counter_journey(tmp_dir, export_dir, before_exports) {
    let observations = [];
    let app = View.create(390);
    Model.apply(app.state, "add");
    View.sync(app);

    let import_path_str = tmp_dir + "/uno-counter-import.json";
    let path_widget = GUI.get(app.form, "import_path");
    path_widget.value = import_path_str;

    // 1. Initial 2-frame state at index 1
    let s0 = _snapshot_state(app);
    assert(s0.count == 2 and s0.playing == false and s0.index == 1, "initial 2-frame counter fixture state");
    push(observations, s0);

    // 2. Toggle pixel_0 on selected frame (index 1) and record authored frames_sha
    let s1 = _click(app, 35, 150);
    let authored_sha = s1.frames_sha;
    push(observations, s1);

    // 3. Click counter_end (200, 688), set to "3", click Save (60, 724) -> value == 0, playing == false
    _click(app, 200, 688);
    let s2 = _replace_text(app, "3");
    assert(s2.counter_end == "3", "counter_end set to 3");
    push(observations, s2);

    let s3 = _click(app, 60, 724);
    assert(s3.playing == false and s3.value == 0, "Save counter settings sets counter_value=0 stopped");
    push(observations, s3);

    // 4. Click Start (150, 724), advance 1150 ms -> source == "counter", value == 1, pixel_enabled == false
    _click(app, 150, 724);
    app.state.started = app.state.started - 1150;
    app.state.last_time = app.state.last_time - 1150;
    View.update(app, []);
    let s4 = _snapshot_state(app);
    assert(s4.playing == true and s4.source == "counter" and s4.value == 1, "counter running at value 1");
    assert(s4.frames_sha == authored_sha and s4.pixel_enabled == false, "pixel_0 disabled and authored frames preserved");
    push(observations, s4);

    // 5. Clicking pixel_0 (35, 150) while counter is running must NOT mutate authored frames!
    let s5 = _click(app, 35, 150);
    assert(s5.frames_sha == authored_sha, "clicking disabled pixel_0 during counter preserves authored frames");
    push(observations, s5);

    // 6. Click Stop (320, 504) -> playing == false, source == "frames", pixel_enabled == true, value in 1..3
    let s6 = _click(app, 320, 504);
    assert(s6.playing == false and s6.source == "frames" and s6.frames_sha == authored_sha and s6.pixel_enabled == true, "Stop restores frame source and re-enables pixels");
    assert(s6.value >= 1 and s6.value <= 3, "stopped counter value retained");
    push(observations, s6);

    // 7. Click Capture (235, 724) -> explicitly copies stopped counter value to frame 1
    let s7 = _click(app, 235, 724);
    assert(s7.playing == false and s7.count == 2 and s7.index == 1, "Capture stays stopped on frame index 1");
    assert(s7.frames_sha != authored_sha, "Capture updated selected frame pixels");
    push(observations, s7);

    // 8. Click Project export (320, 548) -> verify v2 project format & generator metadata
    let s8 = _click(app, 320, 548);
    assert(s8.status == "Saved new validated export under build/uno-r4-led-studio/.", "Project export confirmed");
    push(observations, s8);

    let after_exports = fs_listdir(export_dir);
    let created_files = [];
    for fname in after_exports {
        if str_starts_with(fname, "project-") and str_ends_with(fname, ".json") and not _has_str(before_exports, fname) {
            push(created_files, export_dir + "/" + fname);
        }
    }
    assert(len(created_files) == 1, "exactly 1 new project-*.json export created");
    let raw_project = fs_read(created_files[0]);
    fs_remove(created_files[0]);

    let expected_proj_sha = sha256(raw_project);
    let project_doc = json_parse(raw_project);
    assert(project_doc.format == "pblang.uno-r4-led-project.v2", "project export format v2");
    assert(project_doc.generator != nil and project_doc.generator.kind == "counter" and project_doc.generator.start == 0 and project_doc.generator.end == 3 and project_doc.generator.interval_ms == 1000, "exported generator 0..3 @ 1000ms");

    // 9. Save exported project to private temp import file, click Remove (320, 724), then click Import (320, 592)
    fs_write(import_path_str, raw_project);
    let s9 = _click(app, 320, 724);
    assert(s9.generator == nil and s9.playing == false, "Remove clears generator");
    push(observations, s9);

    let s10 = _click(app, 320, 592);
    assert(s10.project_sha == expected_proj_sha and s10.counter_end == "3" and s10.value == 0 and s10.playing == false, "Project JSON import restored project_sha and counter_end=3");
    push(observations, s10);

    // 10. Invalid counter_seconds = "0" + Save (60, 724) rejected atomically
    let snap_proj_sha = s10.project_sha;
    _click(app, 300, 688);
    let s11 = _replace_text(app, "0");
    assert(s11.counter_seconds == "0", "counter_seconds edited to 0");
    push(observations, s11);

    let s12 = _click(app, 60, 724);
    assert(s12.project_sha == snap_proj_sha and s12.playing == false and s12.counter_seconds == "0", "invalid counter_seconds=0 rejected atomically");
    push(observations, s12);

    return observations;
}

fn main() {
    assert(fs_exists(cwd() + "/tests/fixtures/uno_r4_led_studio_counter_native.sapp"), "counter native fixture exists");
    let export_dir = cwd() + "/build/uno-r4-led-studio";
    let had_export_dir = fs_exists(export_dir);
    let before_exports = [];
    if had_export_dir {
        let listed = try fs_listdir(export_dir) catch [];
        if type(listed) == "array" {
            before_exports = listed;
        }
    }

    let tmp_dir = "/tmp/pblang_tooling_s2_uno_counter_native_" + str(now_ms());
    let created_tmp = SECURE_FILE.create_private_temporary_directory_new(tmp_dir);
    assert(created_tmp.ok == true, "private temp dir created");

    let observations = [];
    let err_msg = "";
    try {
        observations = _run_counter_journey(tmp_dir, export_dir, before_exports);
    } catch e {
        err_msg = str(e);
    }

    _cleanup_exports(export_dir, had_export_dir, before_exports);
    _rm_rf(tmp_dir);
    if err_msg != "" {
        throw err_msg;
    }

    print json_stringify(map{
        result: "pass",
        passed: true,
        static_authored_frames_preserved_during_source: true,
        pixel_edit_disabled_during_source: true,
        capture_explicit: true,
        project_file_roundtrip: true,
        invalid_settings_atomic: true,
        observations: len(observations)
    });
    return 0;
}

main();
