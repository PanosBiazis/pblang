// Pure PBLang headless verification for UNO R4 LED Studio native 390px view:
// pixel click, Tab+Enter keyboard pixel toggle, static "PB" (1 frame),
// scrolling "PB" (25 frames), "200" + All ms -> 5000ms, "2" repetitions +
// Play/Stop, validated Frames export + 32-bit Arduino word packing check,
// Clear + Import roundtrip, and atomic malformed-JSON import rejection.
// Never opens an X11 window on the user's desktop and cleans up all exports.

let GUI = import("stdlib:gui.sapp");
let SECURE_FILE = import("stdlib:secure_file.sapp");
let Model = import("../../examples/uno_r4_led_studio/model.sapp");
let View = import("../../examples/uno_r4_led_studio/view.sapp");

fn _has_str(items, target) {
    for item in items {
        if item == target {
            return true;
        }
    }
    return false;
}

fn _rm_rf(path) {
    if not fs_exists(path) {
        return 0;
    }
    let entries = try fs_listdir(path) catch nil;
    if type(entries) == "array" {
        for name in entries {
            if name != "." and name != ".." {
                _rm_rf(path + "/" + name);
            }
        }
    }
    let _removed = try fs_remove(path) catch nil;
    return 0;
}

fn _cleanup_exports(export_dir, had_export_dir, before_entries) {
    if not fs_exists(export_dir) {
        return 0;
    }
    let current = try fs_listdir(export_dir) catch [];
    if type(current) == "array" {
        for name in current {
            if name != "." and name != ".." and not _has_str(before_entries, name) {
                let _r = try fs_remove(export_dir + "/" + name) catch nil;
            }
        }
    }
    if not had_export_dir {
        let rem = try fs_listdir(export_dir) catch [];
        if type(rem) == "array" and len(rem) == 0 {
            let _rd = try fs_remove(export_dir) catch nil;
        }
    }
    return 0;
}

fn _snapshot_state(app) {
    let st = app.state;
    return map{
        duration_input: GUI.get(app.form, "duration").value,
        total_ms: st.document.total_ms,
        repeat_count: st.repeat_count,
        repeat_input: GUI.get(app.form, "repetitions").value,
        export_sha256: sha256(Model.export_document(st)),
        index: st.index,
        count: len(st.document.frames),
        playing: st.playing,
        pixel0: st.document.frames[st.index].pixels[0],
        pixel1: st.document.frames[st.index].pixels[1],
        text: st.text,
        status: st.status
    };
}

fn _click(app, px, py) {
    View.update(app, [
        map{type: "mousemove", x: px, y: py},
        map{type: "mousedown", button: "Left", x: px, y: py},
        map{type: "mouseup", button: "Left", x: px, y: py}
    ]);
    return _snapshot_state(app);
}

fn _key_tap(app, key_name, text_opt) {
    let down = map{type: "keydown", key: key_name};
    if text_opt != nil {
        down["text"] = text_opt;
    }
    View.update(app, [
        down,
        map{type: "keyup", key: key_name}
    ]);
    return _snapshot_state(app);
}

fn _replace_text(app, text_val) {
    View.update(app, [
        map{type: "keydown", key: "ControlLeft", ctrl: true},
        map{type: "keydown", key: "A", ctrl: true},
        map{type: "keyup", key: "A", ctrl: true},
        map{type: "keyup", key: "ControlLeft", ctrl: false}
    ]);
    let n = len(text_val);
    let i = 0;
    while i < n {
        let ch = str_slice(text_val, i, i + 1);
        _key_tap(app, ch, ch);
        i = i + 1;
    }
    return _snapshot_state(app);
}

fn _pack_word32(pixels, offset) {
    let acc = 0;
    for bit 32 {
        acc = acc * 2 + pixels[offset + bit];
    }
    return acc;
}

fn _run_journey(tmp_dir, export_dir, before_exports) {
    let observations = [];
    let app = View.create(390);
    let import_path_str = tmp_dir + "/uno-r4-import-test.json";
    let import_widget = GUI.get(app.form, "import_path");
    import_widget.value = import_path_str;

    // 1. Initial heart preset state
    let s0 = _snapshot_state(app);
    assert(s0.count == 1 and s0.playing == false and s0.pixel0 == 0, "initial heart frame");
    push(observations, s0);

    // 2. Click pixel 0 at (35, 150) -> pixel0 == 1
    let s1 = _click(app, 35, 150);
    assert(s1.pixel0 == 1, "click (35,150) toggles pixel_0 on");
    push(observations, s1);

    // 3. Tab + Enter -> focuses pixel_1 and toggles pixel1 == 1
    _key_tap(app, "Tab", nil);
    let s2 = _key_tap(app, "Enter", nil);
    assert(s2.pixel0 == 1 and s2.pixel1 == 1, "Tab+Enter toggles pixel_1 on");
    push(observations, s2);

    // 4. Click Static text at (225, 416) -> 1 frame, 250ms
    let s3 = _click(app, 225, 416);
    assert(s3.count == 1 and s3.index == 0 and s3.playing == false and s3.total_ms == 250, "Static PB stays 1 frame 250ms");
    push(observations, s3);

    // 5. Click Scroll text at (320, 416) -> 25 frames
    let s4 = _click(app, 320, 416);
    assert(s4.count == 25 and s4.index == 0 and s4.playing == false, "Scroll PB creates 25 frames");
    push(observations, s4);

    // 6. Focus duration (50, 504), replace with "200", click All ms (150, 548) -> total_ms == 5000
    _click(app, 50, 504);
    let s5 = _replace_text(app, "200");
    assert(s5.duration_input == "200", "duration textbox updated to 200");
    push(observations, s5);

    let s6 = _click(app, 150, 548);
    assert(s6.count == 25 and s6.total_ms == 5000, "All ms sets 25 frames * 200ms = 5000ms");
    push(observations, s6);

    // 7. Focus repetitions (50, 688), replace with "2", click Play (232, 504), advance 450ms, click Stop (320, 504)
    _click(app, 50, 688);
    let s7 = _replace_text(app, "2");
    assert(s7.repeat_input == "2", "repetitions textbox updated to 2");
    push(observations, s7);

    let s8 = _click(app, 232, 504);
    assert(s8.playing == true and s8.repeat_count == 2, "Play starts with repeat_count == 2");
    push(observations, s8);

    app.state.started = app.state.started - 450;
    app.state.last_time = app.state.last_time - 450;
    View.update(app, []);

    let s9 = _click(app, 320, 504);
    assert(s9.playing == false, "Stop halts playback cleanly");
    push(observations, s9);

    // 8. Click Frames export at (240, 548) and verify exported JSON + 32-bit word packing
    let s10 = _click(app, 240, 548);
    assert(s10.status == "Saved new validated export under build/uno-r4-led-studio/.", "Frames export status confirmed");
    push(observations, s10);

    let after_exports = fs_listdir(export_dir);
    let created_files = [];
    for fname in after_exports {
        if str_starts_with(fname, "frames-") and str_ends_with(fname, ".json") and not _has_str(before_exports, fname) {
            push(created_files, export_dir + "/" + fname);
        }
    }
    assert(len(created_files) == 1, "exactly 1 new frames-*.json export created");
    let exported_raw = fs_read(created_files[0]);
    fs_remove(created_files[0]);

    let expected_digest = sha256(exported_raw);
    let exported = json_parse(exported_raw);
    assert(len(exported.document.frames) == 25 and len(exported.arduino_frames) == 25, "exported 25 frames and 25 arduino sequences");
    for fi 25 {
        let fr = exported.document.frames[fi];
        let words = exported.arduino_frames[fi];
        assert(_pack_word32(fr.pixels, 0) == words[0] and _pack_word32(fr.pixels, 32) == words[1] and _pack_word32(fr.pixels, 64) == words[2] and fr.duration_ms == words[3], "packed Arduino words match frame " + str(fi));
    }

    // 9. Write exported document to private temp import file, click Clear (320, 100), then click Import (320, 592)
    fs_write(import_path_str, json_stringify(exported));
    _click(app, 320, 100);
    let s11 = _click(app, 320, 592);
    assert(s11.count == 25 and s11.index == 0 and s11.playing == false and s11.pixel0 == 0 and s11.pixel1 == 0, "Import restored 25 frames at index 0");
    assert(s11.export_sha256 == expected_digest and s11.repeat_count == 1 and s11.repeat_input == "1", "Import digest exact and repeat reset to 1");
    push(observations, s11);

    // 10. Overwrite import file with "{malformed" and click Import (320, 592) -> atomic rejection!
    fs_write(import_path_str, "{malformed");
    let s12 = _click(app, 320, 592);
    assert(s12.count == 25 and s12.index == 0 and s12.playing == false and s12.pixel0 == 0, "malformed import left state intact");
    assert(s12.export_sha256 == expected_digest, "malformed import preserved exact export sha256");
    assert(s12.status == "Cannot apply: check input, file format and limits.", "malformed import status banner");
    push(observations, s12);

    return observations;
}

fn main() {
    assert(fs_exists(cwd() + "/tests/fixtures/uno_r4_led_studio_native.sapp"), "native fixture exists");
    let export_dir = cwd() + "/build/uno-r4-led-studio";
    let had_export_dir = fs_exists(export_dir);
    let before_exports = [];
    if had_export_dir {
        let listed = try fs_listdir(export_dir) catch [];
        if type(listed) == "array" {
            before_exports = listed;
        }
    }

    let tmp_dir = "/tmp/pblang_tooling_s2_uno_native_" + str(now_ms());
    let created_tmp = SECURE_FILE.create_private_temporary_directory_new(tmp_dir);
    assert(created_tmp.ok == true, "private temp dir created");

    let observations = [];
    let err_msg = "";
    try {
        observations = _run_journey(tmp_dir, export_dir, before_exports);
    } catch e {
        err_msg = str(e);
    }

    _cleanup_exports(export_dir, had_export_dir, before_exports);
    _rm_rf(tmp_dir);
    if err_msg != "" {
        throw err_msg;
    }

    print json_stringify(map{
        result: "pass",
        passed: true,
        observations_count: len(observations),
        observations: observations
    });
    return 0;
}

main();
