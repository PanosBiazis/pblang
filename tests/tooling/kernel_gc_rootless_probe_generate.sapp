// QEMU-only operation probe, separate from timing. Low RAM 0x7000 is test-only.
let C=import("stdlib:compiler/ctranspile.sapp");
let args=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");
assert(len(args)==2,"expected selected GC source and output C");
let gc=fs_read(args[0]);
let marker="if peek32(obj) == generation {";
assert(len(str_split(gc,marker))==2,"expected one sweep mark-test site");
gc=str_replace_all(gc,marker,"poke32(28672,peek32(28672)+1);"+marker);
let fixture=fs_read("bench/kernel_gc_rootless.sapp");
fixture=str_replace_all(fixture,"10000","1");
fixture=str_replace_all(fixture,"let pass=0;","let pass=0;poke32(28672,0);");
fixture=str_replace_all(fixture,"if gc_collections(g)!=1", "emit_number(peek32(28672));outb(233,10);if gc_collections(g)!=1");
let emit="fn emit_number(n){if n>=10 {emit_number(n/10);}outb(233,48+n%10);}\n";
fs_write(args[1],C.transpile_kernel_int(fs_read("stdlib/kernel/heap.sapp")+gc+emit+fixture));
print "rootless mark probe generated";
