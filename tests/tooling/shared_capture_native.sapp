// Explicit local harness: caller supplies a disposable directory and retained VM.
let FE=import("stdlib/compiler/selfhost_frontend.sapp");
let XL=import("stdlib/selfhost_to_pbck.sapp");
let cases=import("tests/fixtures/shared_capture_cases.sapp").cases;
let args=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");
assert(len(args)==2,"expected disposable output directory and executable");
let checked=0;
for i len(cases) {
    let item=cases[i];
    let result=FE.frontend_compile(item[0]);
    assert(result.ok,"native fixture compiles");
    let lines=[];for value in item[1] {array_push(lines,str(value));}
    let expected=str_join(lines,"\n");
    for optimized in [false,true] {
        let path=args[0]+"/capture-"+str(i)+"-"+str(optimized)+".pbck";
        if optimized {XL.write_file_optimized(path,result.chunk);}
        else {XL.write_file(path,result.chunk);}
        let run=proc_spawn_wait(args[1],["run",path,"--allow-all"]);
        assert(run.exit_code==0 and str_trim(run.stdout)==expected,
            "native capture case "+str(i)+" optimized="+str(optimized)+" stdout="+run.stdout+" stderr="+run.stderr);
        checked=checked+1;
    }
}
print "native shared capture cases: "+str(checked);
