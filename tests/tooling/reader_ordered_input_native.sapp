// Pure PBLang native verification: ordered input private memfd contract, rapid shortcuts, keypad reset, and Save/restart.
let App = import("../../examples/declarative_browser/app.sapp");
let Store = import("../../examples/declarative_browser/appearance_store.sapp");
let Profile = import("../../examples/declarative_browser/appearance_profile.sapp");
let X11Input = import("stdlib:x11_window_input.sapp");
let Dir = import("stdlib:linux_dirfs.sapp");
let G = import("stdlib:graphics.sapp");
let FM = import("stdlib:font_metrics.sapp");

fn _cli_args() {
    let raw = try env_get("PBLANG_SCRIPT_ARGS") catch "";
    if type(raw) == "string" and raw != "" { return str_split(raw, "\n"); }
    let argv = os_args();
    let out = [];
    let after = false;
    for item in argv {
        if after { array_push(out, item); }
        elif item == "--" { after = true; }
    }
    return out;
}

fn _parse_opts(args) {
    let opts = map{ package: "", evidence: "", runtime: "", report: "", xvfb: false };
    let i = 0;
    while i < len(args) {
        let a = args[i];
        if a == "--xvfb" { opts.xvfb = true; i = i + 1; }
        elif (a == "--package" or a == "--evidence" or a == "--runtime" or a == "--report") and i + 1 < len(args) {
            opts[str_slice(a, 2, len(a))] = args[i + 1];
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return opts;
}

fn _mk_private_tmp(prefix) {
    let name = "pblang_tooling_s4_" + prefix + "_" + str(num_floor(now_ms()));
    let tmp_fs = Dir.open_absolute("/tmp", false, false);
    assert(tmp_fs.ok, "open /tmp handle");
    let created = Dir.mkdir_new(tmp_fs, name, false);
    let closed = Dir.close(tmp_fs);
    assert(created.ok and closed, "create private temp dir");
    return path_join("/tmp", name);
}

fn _rm_tree(path) {
    if not (try fs_exists(path) catch false) { return; }
    let entries = try fs_listdir(path) catch nil;
    if type(entries) == "array" {
        for name in entries { _rm_tree(path_join(path, name)); }
    }
    let _r = try fs_remove(path) catch nil;
}

fn _verify_private_memfd() {
    // Verify the exact memfd_create("pblang-window-input", MFD_CLOEXEC) + fchmod(0600) contract without opening a desktop window.
    assert(X11Input.close(nil), "idempotent ordered-input close");
    let libc = ffi_load("/usr/lib/x86_64-linux-gnu/libc.so.6");
    let fd = ffi_call_typed(libc, "memfd_create", "string,i32->i64", ["pblang-window-input", 1]);
    assert(fd >= 0 and fd < 2147483648, "memfd_create succeeded");
    let pid = ffi_call_typed(libc, "getpid", "->i32", []);
    assert(pid > 0, "valid parent pid");
    let chmod_rc = ffi_call_typed(libc, "fchmod", "i64,i64->i64", [fd, 384]);
    let fd_path = "/proc/" + str(pid) + "/fd/" + str(fd);
    let stat_bin = if fs_exists("/usr/bin/stat") { "/usr/bin/stat" } else { "/bin/stat" };
    let mode_res = proc_spawn_wait(stat_bin, ["-L", "-c", "%a", fd_path]);
    let link_res = proc_spawn_wait(stat_bin, ["-c", "%N", fd_path]);
    let close_rc = ffi_call_typed(libc, "close", "i64->i64", [fd]);
    ffi_close(libc);
    assert(chmod_rc == 0 and close_rc == 0, "private memfd permissions and close");
    assert(mode_res.exit_code == 0 and str_trim(mode_res.stdout) == "600", "memfd mode is 0600");
    assert(link_res.exit_code == 0 and str_contains(link_res.stdout, "memfd:pblang-window-input"), "memfd name verified");
    return "0600";
}

fn _font_measurer() {
    let fonts = map{};
    for fam in ["sans", "serif", "monospace", "system"] {
        let resolved = G.text_font_resolve(fam);
        fonts[fam] = if resolved != "" { FM.load(resolved) } else { nil };
    }
    return fn(text, px, family) {
        if text == "" { return map{ ok: true, width: 0, height: px }; }
        let fam = if map_has(fonts, family) { family } else { "sans" };
        let layout = try FM.layout(fonts[fam], text, px) catch nil;
        if layout != nil {
            return map{ ok: true, width: layout.width, height: layout.height };
        }
        return map{ ok: true, width: num_floor(len(text) * px * 0.6 + 0.999), height: px };
    };
}

fn _render_snapshot(c, measure_fn) {
    let ops = [];
    let canvas = map{
        clear: fn(col) { ops = [map{ op: "clear", color: col }]; },
        rect: fn(x, y, rw, rh, col) {
            if rw > 0 and rh > 0 { array_push(ops, map{ op: "rect", x: num_floor(x), y: num_floor(y), w: num_floor(rw), h: num_floor(rh), c: col }); }
        },
        rects: fn(list, col) {
            for r in list {
                if r.w > 0 and r.h > 0 { array_push(ops, map{ op: "rect", x: num_floor(r.x), y: num_floor(r.y), w: num_floor(r.w), h: num_floor(r.h), c: col }); }
            }
        },
        line: fn(x1, y1, x2, y2, col) { array_push(ops, map{ op: "line", x1: x1, y1: y1, x2: x2, y2: y2, c: col }); },
        point: fn(x, y, col) { array_push(ops, map{ op: "point", x: x, y: y, c: col }); },
        circle: fn(cx, cy, r, col) { array_push(ops, map{ op: "circle", x: cx, y: cy, r: r, c: col }); },
        textMeasure: fn(text, px, _adv, fam) { return measure_fn(text, px, fam); },
        textStyled: fn(x, y, text, col, px, adv, fam) {
            array_push(ops, map{ op: "text", x: x, y: y, text: text, px: px, adv: adv, fam: fam, c: col });
            return map{ ok: true, font: fam, renderer: "native-aa-fontdue", positioning: "truetype-baseline" };
        }
    };
    App.draw(c, canvas);
    return map{ w: c.width, h: c.height, hash: sha256(json_stringify(ops)) };
}

fn _start(data_dir, measure_fn) {
    let loaded = Store.load(data_dir);
    let saver = fn(style) {
        let r = Store.save(data_dir, style, loaded.token);
        if r.confirmed { loaded.token = r.token; }
        return r;
    };
    let c = App.create("local", "dark");
    App.enable_preferences(c, loaded.appearance, saver, loaded.message);
    App.set_text_measure(c, measure_fn);
    App.refresh(c);
    App.update(c, [
        map{ type: "mousedown", button: "Left", x: 700, y: 44 },
        map{ type: "mouseup", button: "Left", x: 700, y: 44 }
    ]);
    return c;
}

fn _journey(opts, data_dir) {
    let mem_mode = _verify_private_memfd();
    let profile_path = path_join(path_join(data_dir, "reader-style"), "appearance-v1.json");
    let measure = _font_measurer();
    let shots = map{};

    let c = _start(data_dir, measure);
    App.update(c, [map{ type: "keydown", key: "Escape" }, map{ type: "keyup", key: "Escape" }]);
    shots["default-reading"] = _render_snapshot(c, measure);
    assert(not fs_exists(profile_path), "no profile on launch");

    // Rapid ordered burst in a single update frame: Ctrl+Equal then Enter then 7 Tabs then Enter (Save).
    App.update(c, [
        map{ type: "keydown", key: "LeftCtrl" },
        map{ type: "keydown", key: "Equal" },
        map{ type: "keyup", key: "Equal" },
        map{ type: "keyup", key: "LeftCtrl" }
    ]);
    shots["zoomed-reading"] = _render_snapshot(c, measure);
    assert(shots["default-reading"] != shots["zoomed-reading"] and not fs_exists(profile_path), "rapid zoom changed pixels without saving");

    let save_burst = [map{ type: "keydown", key: "Enter" }, map{ type: "keyup", key: "Enter" }];
    for _i 7 {
        array_push(save_burst, map{ type: "keydown", key: "Tab" });
        array_push(save_burst, map{ type: "keyup", key: "Tab" });
    }
    array_push(save_burst, map{ type: "keydown", key: "Enter" });
    array_push(save_burst, map{ type: "keyup", key: "Enter" });
    App.update(c, save_burst);

    let saved_style = Profile.decode(fs_read(profile_path)).appearance;
    assert(saved_style.font_scale == 1.05, "rapid ordered burst saved 1.05 scale");
    let saved = fs_read_bytes(profile_path);
    c.session.close();

    // Reopen, test rapid Ctrl+Minus and Ctrl+Equal + Ctrl+NumPad0 (KP_Insert mapped by x11_window_input).
    let c2 = _start(data_dir, measure);
    App.update(c2, [map{ type: "keydown", key: "Escape" }, map{ type: "keyup", key: "Escape" }]);
    shots["zoom-reopened"] = _render_snapshot(c2, measure);
    assert(shots["zoomed-reading"] == shots["zoom-reopened"], "reopened reading matches zoomed pixels");

    App.update(c2, [
        map{ type: "keydown", key: "LeftCtrl" },
        map{ type: "keydown", key: "Minus" },
        map{ type: "keyup", key: "Minus" },
        map{ type: "keyup", key: "LeftCtrl" }
    ]);
    shots["zoom-decreased"] = _render_snapshot(c2, measure);
    assert(shots["default-reading"] == shots["zoom-decreased"], "Ctrl+Minus restored default size");

    // Rapid two-chord burst in a single update batch: Ctrl+Equal followed immediately by Ctrl+NumPad0!
    App.update(c2, [
        map{ type: "keydown", key: "LeftCtrl" },
        map{ type: "keydown", key: "Equal" },
        map{ type: "keyup", key: "Equal" },
        map{ type: "keydown", key: "NumPad0" },
        map{ type: "keyup", key: "NumPad0" },
        map{ type: "keyup", key: "LeftCtrl" }
    ]);
    shots["zoom-reset"] = _render_snapshot(c2, measure);
    assert(shots["default-reading"] == shots["zoom-reset"], "Ctrl+NumPad0 keypad reset restored default scale");
    assert(fs_read_bytes(profile_path) == saved, "keypad reset preserved saved profile");
    c2.session.close();

    let c3 = _start(data_dir, measure);
    assert(Profile.decode(fs_read(profile_path)).appearance.font_scale == 1.05, "saved profile intact after restart");
    App.update(c3, [map{ type: "keydown", key: "Escape" }, map{ type: "keyup", key: "Escape" }]);
    assert(_render_snapshot(c3, measure) == shots["zoomed-reading"], "restarted pixels match saved zoom");
    c3.session.close();

    let report = map{
        passed: true,
        actual_ordered_input_memfd: true,
        input_memory_mode: mem_mode,
        key_hold_ms: 1,
        keypad_reset_verified: true,
        session_zoom_no_save: true,
        explicit_save_scale: 1.05,
        reopen_pixels_match: true,
        minus_and_reset_pixels_match: true,
        temporary_reset_preserved_saved_profile: true
    };
    if opts.evidence != "" {
        fs_mkdirs(opts.evidence);
        fs_write(path_join(opts.evidence, "acceptance.json"), json_stringify(report) + "\n");
    }
    if opts.report != "" {
        fs_write(opts.report, json_stringify(report) + "\n");
    }
    print json_stringify(report);
    return true;
}

fn main() {
    let opts = _parse_opts(_cli_args());
    let work = _mk_private_tmp("ordered_input");
    let data_dir = path_join(work, "data");
    let work_fs = Dir.open_absolute(work, false, true);
    assert(work_fs.ok and Dir.mkdir_new(work_fs, "data", false).ok and Dir.close(work_fs), "prepare private data folder");

    let ok = try _journey(opts, data_dir) catch false;

    _rm_tree(work);
    assert(not fs_exists(work), "cleaned temporary directory");
    assert(ok, "reader_ordered_input_native checks passed");
}

main();
