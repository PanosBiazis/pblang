// QEMU-only allocator-call probe. Arguments: GC source, 128 or 129, output C.
// Counters reserve low RAM 0x7000..0x7007 in a single-CPU generated test kernel.
let C=import("stdlib:compiler/ctranspile.sapp");
fn replace_once(text,needle,replacement) {
    let parts=str_split(text,needle);assert(len(parts)==2,"scratch probe: expected one source marker");
    return parts[0]+replacement+parts[1];
}
let args=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");
assert(len(args)==3,"scratch probe: GC source, node count, output C required");
assert(args[1]=="128" or args[1]=="129","scratch probe: node count must be 128 or 129");
let heap=fs_read("stdlib/kernel/heap.sapp");
heap=replace_once(heap,"fn _guarded_heap_alloc(ctrl, n) {", "fn _guarded_heap_alloc(ctrl, n) {poke32(28672,peek32(28672)+1);poke32(28676,peek32(28676)+n);");
let fixture=fs_read("bench/kernel_gc_collect.sapp");
fixture=replace_once(fixture,"i < 128", "i < "+args[1]);
fixture=replace_once(fixture,"i = 0; while i < 50000", "poke32(28672,0);poke32(28676,0);i = 0; while i < 1");
fixture=replace_once(fixture,"gc_collections(g) != 50000", "gc_collections(g) != 1");
fixture=replace_once(fixture,"if gc_live(g) != 128", "emit_number(peek32(28672));outb(233,32);emit_number(peek32(28676));outb(233,10);if gc_live(g) != "+args[1]);
let emit="fn emit_number(value) {if value>=10 {emit_number(value/10);}outb(233,48+value%10);}\n";
fs_write(args[2],C.transpile_kernel_int(heap+fs_read(args[0])+emit+fixture));
print "scratch allocation probe generated";
