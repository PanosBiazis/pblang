// QEMU-only operation counter, separate from timing. Low RAM is fixture-owned.
let C=import("stdlib:compiler/ctranspile.sapp");
let a=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");
assert(len(a)==2,"expected selected heap source and destination C");
let heap=fs_read(a[0]);
let parts=str_split(heap,"fn _guarded_heap_free_from(");assert(len(parts)==2,"one free cursor implementation");
let end=str_split(parts[1],"fn _guarded_heap_free(");assert(len(end)==2,"one ordinary free wrapper");
heap=parts[0]+"fn _guarded_heap_free_from("+str_replace_all(end[0],"peek32(","probe_peek32(")+"fn _guarded_heap_free("+end[1];
let fixture="fn probe_peek32(p){poke32(28672,peek32(28672)+1);return peek32(p);}\n"
    +"fn emit_number(n){if n>=10 {emit_number(n/10);}outb(233,48+n%10);}\n"
    +"fn kmain(){let h=kmalloc(8);let arena=kmalloc(4096);let round=0;while round<2 {heap_init(h,arena,4096);"
    +"let a=heap_alloc(h,24);let b=heap_alloc(h,24);let c=heap_alloc(h,24);poke32(28672,0);heap_free(h,a);"
    +"if round==1 {heap_free(h,b);heap_free(h,c);}emit_number(peek32(28672));outb(233,10);round=round+1;}"
    +"outb(244,42);while 1>0 {hlt();}}";
fs_write(a[1],C.transpile_kernel_int(heap+fixture));
print "heap merge probe generated";
