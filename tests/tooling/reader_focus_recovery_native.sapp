// Pure-PBLang verification that focused link recovery survives unavailable large-text compact layout and yields to explicit new focus.
let App = import("../../examples/declarative_browser/app.sapp");
let Store = import("../../examples/declarative_browser/appearance_store.sapp");
let Dir = import("stdlib:linux_dirfs.sapp");
let G = import("stdlib:graphics.sapp");
let FontMetrics = import("stdlib:font_metrics.sapp");
let Hash = import("stdlib:sha256_pb.sapp");

fn _parse_cli() {
    let raw = os_args();
    let out: any = map{package: nil, evidence: nil, report: nil, runtime: nil, xvfb: false};
    let after = false;
    let i = 0;
    while i < len(raw) {
        let arg = raw[i];
        if not after {
            if arg == "--" { after = true; }
        } elif arg == "--xvfb" {
            out.xvfb = true;
        } elif (arg == "--package" or arg == "--evidence" or arg == "--report" or arg == "--runtime") and i + 1 < len(raw) {
            let val = raw[i + 1];
            if arg == "--package" { out.package = val; }
            elif arg == "--evidence" { out.evidence = val; }
            elif arg == "--report" { out.report = val; }
            elif arg == "--runtime" { out.runtime = val; }
            i = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn _mkdir_private(parent, name) {
    let fs = Dir.open_absolute(parent, false, false);
    assert(fs.ok, "open parent");
    let created = Dir.mkdir_new(fs, name, false);
    let closed = Dir.close(fs);
    assert(created.ok and closed, "mkdir private");
    return parent + "/" + name;
}

fn _rm_tree(path) {
    let removed = false;
    try { fs_remove(path); removed = true; } catch {}
    if removed { return true; }
    let kids = try fs_listdir(path) catch nil;
    if type(kids) == "array" {
        for kid in kids { let _child = _rm_tree(path + "/" + kid); }
    }
    let ok = false;
    try { fs_remove(path); ok = true; } catch {}
    return ok;
}

fn _make_text_measurer() {
    let cache_fonts = map{};
    let cache_metrics: any = map{};
    let cache_widths: any = map{};
    return fn(text, px, family) {
        if not map_has(cache_fonts, family) {
            let resolved = G.text_font_resolve(family);
            cache_fonts[family] = resolved;
            cache_metrics[family] = if resolved != "" { try FontMetrics.load(resolved) catch nil } else { nil };
        }
        let key = json_stringify([family, px, text]);
        if map_has(cache_widths, key) { return cache_widths[key]; }
        let layout = try FontMetrics.layout(cache_metrics[family], text, px) catch nil;
        let w = if layout != nil { layout.width } else { len(text) * num_max(4, num_floor(px * 0.56)) };
        let h = if layout != nil { layout.height } else { px };
        let res = map{ok: true, width: w, height: h, font: cache_fonts[family]};
        cache_widths[key] = res;
        return res;
    };
}

fn _full_digest(c) {
    let h = Hash.new();
    let canvas = map{
        clear: fn(col) { Hash.update(h, str_to_bytes("C:" + json_stringify(col) + ";")); },
        rect: fn(rx, ry, rw, rh, col) {
            if rw > 0 and rh > 0 {
                Hash.update(h, str_to_bytes("R:" + str(rx) + "," + str(ry) + "," + str(rw) + "," + str(rh) + ":" + json_stringify(col) + ";"));
            }
        },
        rects: fn(items, col) {
            let ctag = json_stringify(col);
            for it in items {
                if it.w > 0 and it.h > 0 {
                    Hash.update(h, str_to_bytes("G:" + str(it.x) + "," + str(it.y) + "," + str(it.w) + "," + str(it.h) + ":" + ctag + ";"));
                }
            }
        },
        point: fn(px, py, col) { Hash.update(h, str_to_bytes("P:" + str(px) + "," + str(py) + ":" + json_stringify(col) + ";")); },
        line: fn(lx1, ly1, lx2, ly2, col) { Hash.update(h, str_to_bytes("L:" + str(lx1) + "," + str(ly1) + "," + str(lx2) + "," + str(ly2) + ":" + json_stringify(col) + ";")); },
        circle: fn(_cx, _cy, _r, _col) {}
    };
    let _d = App.draw(c, canvas);
    return Hash.finish(h);
}

fn _key(c, raw_name) {
    let k = if raw_name == "Return" { "Enter" } else { raw_name };
    let _d = App.update(c, [map{type: "keydown", key: k}]);
    let _u = App.update(c, [map{type: "keyup", key: k}]);
}

fn _shift_tab(c) {
    let _s1 = App.update(c, [map{type: "keydown", key: "LeftShift", shift: true}]);
    let _t1 = App.update(c, [map{type: "keydown", key: "Tab", shift: true}]);
    let _t2 = App.update(c, [map{type: "keyup", key: "Tab", shift: true}]);
    let _s2 = App.update(c, [map{type: "keyup", key: "LeftShift", shift: false}]);
}

fn _click(c, xpos, ypos) {
    let _d = App.update(c, [map{type: "mousedown", x: xpos, y: ypos, button: "Left"}]);
    let _u = App.update(c, [map{type: "mouseup", x: xpos, y: ypos, button: "Left"}]);
}

fn _close(c) {
    for _i 3 {
        if c.form.close_requested { break; }
        _key(c, "Escape");
    }
    assert(c.form.close_requested, "clean reader close");
    c.session.close();
}

fn _start_style(data_dir, measurer) {
    let loaded = Store.load(data_dir);
    let saver = fn(style) {
        let res = Store.save(data_dir, style, loaded.token);
        if res.confirmed { loaded.token = res.token; }
        return res;
    };
    let reloader = fn() {
        let fresh = Store.load(data_dir);
        if not fresh.ok or not fresh.can_save or fresh.token == "missing" { return map{ok: false}; }
        loaded.token = fresh.token;
        return map{ok: true, appearance: fresh.appearance, save: saver};
    };
    let active_saver: any = if loaded.can_save { saver } else { nil };
    let c = App.create("local", "dark");
    App.enable_preferences(c, loaded.appearance, active_saver, loaded.message, reloader);
    App.set_text_measure(c, measurer);
    let _ref = App.refresh(c);
    _click(c, 700, 44);
    assert(c.settings, "Style opened");
    return c;
}

fn _run(scratch) {
    let data_dir = _mkdir_private(scratch, "data");
    let profile_path = data_dir + "/reader-style/appearance-v1.json";
    let measurer = _make_text_measurer();

    // Seed large-text profile (title_size=40, font_scale=1.5) via real AppearanceStore.
    let old_loaded = Store.load(data_dir);
    let large_style = map{};
    for k in map_keys(old_loaded.appearance) { large_style[k] = old_loaded.appearance[k]; }
    large_style["title_size"] = 40;
    large_style["font_scale"] = 1.5;
    let saved_res = Store.save(data_dir, large_style, old_loaded.token);
    assert(saved_res.ok and saved_res.owned_handles_closed, "large-text profile saved");
    let saved_bytes = fs_read_bytes(profile_path);

    // 1. Reference guide render: Escape -> Tab -> Return opens pb://guide directly.
    let c1 = _start_style(data_dir, measurer);
    _key(c1, "Escape");
    _key(c1, "Tab");
    assert(c1.form.focus == "block2", "focused block2 link on wide layout");
    _key(c1, "Return");
    assert(c1.session.snapshot().url == "pb://guide", "reference opened pb://guide");
    let guide_reference = _full_digest(c1);
    _close(c1);

    // 2. Unavailable 320x240 layout hides link focus; restoring 800x816 recovers block2 and opens pb://guide identically.
    let c2 = _start_style(data_dir, measurer);
    _key(c2, "Escape");
    _key(c2, "Tab");
    assert(c2.form.focus == "block2", "focused block2 before compact resize");
    let _wide_focused = _full_digest(c2);
    let _r_unavail = App.update(c2, [map{type: "resize", w: 320, h: 240}]);
    assert(c2.reading_plan != nil and not c2.reading_plan.available and c2.form.focus == nil, "no invisible control receives focus during unavailable layout");
    let _unavail_digest = _full_digest(c2);
    let _r_restore = App.update(c2, [map{type: "resize", w: 800, h: 816}]);
    assert(c2.form.focus == "block2", "block2 link focus recovered after restoring 800x816");
    _key(c2, "Return");
    assert(c2.session.snapshot().url == "pb://guide", "recovered link opened pb://guide");
    let guide_after_recovery = _full_digest(c2);
    assert(guide_after_recovery == guide_reference, "guide pixels after focus recovery match reference");
    _close(c2);

    // 3. Explicit keyboard input during unavailable 320x240 layout cancels pending link recovery and retains new focus.
    let c3 = _start_style(data_dir, measurer);
    _key(c3, "Escape");
    _shift_tab(c3);
    assert(c3.form.focus == "home", "Shift+Tab from Style focused Home");
    let home_focus_reference = _full_digest(c3);
    _key(c3, "Tab");
    _key(c3, "Tab");
    assert(c3.form.focus == "block2", "focused block2 before cancellation test");
    let _r_unavail2 = App.update(c3, [map{type: "resize", w: 320, h: 240}]);
    assert(c3.form.focus == nil, "focus nil on unavailable layout");
    _key(c3, "Tab");
    assert(c3.form.focus == "home", "Tab on unavailable layout focused toolbar Home and cancelled link recovery");
    let _r_restore2 = App.update(c3, [map{type: "resize", w: 800, h: 816}]);
    assert(c3.form.focus == "home", "Home focus retained after enlarging back to 800x816");
    let new_focus_retained = _full_digest(c3);
    assert(new_focus_retained == home_focus_reference, "retained Home focus matches reference");
    _close(c3);

    assert(fs_read_bytes(profile_path) == saved_bytes, "Focus/layout transitions must not write appearance");

    return map{
        passed: true,
        guide_pixels_match_reference: true,
        new_input_cancels_recovery: true,
        profile_unchanged: true,
        sizes: [[800, 816], [320, 240]],
        visual_review_required: false
    };
}

fn main() {
    let cli = _parse_cli();
    let scratch_name = "pblang_tooling_s3_focus_rec_" + str(num_floor(now_ms()));
    let scratch = _mkdir_private("/tmp", scratch_name);
    let result = try _run(scratch) catch nil;
    let _cleaned = _rm_tree(scratch);
    assert(result != nil and result.passed == true, "reader_focus_recovery_native failed");
    let json_text = json_stringify(result);
    if cli.evidence != nil and cli.evidence != "" {
        fs_mkdirs(cli.evidence);
        fs_write(cli.evidence + "/acceptance.json", json_text + "\n");
    }
    if cli.report != nil and cli.report != "" {
        fs_mkdirs(path_dirname(cli.report));
        fs_write(cli.report, json_text + "\n");
    }
    print json_text;
}

main();
