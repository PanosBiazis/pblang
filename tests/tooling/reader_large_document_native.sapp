// Pure PBLang native verification: large imported document (>20 pages, 256-W heading, Greek text), focus ring, and anchor recovery.
let App = import("../../examples/declarative_browser/app.sapp");
let P = import("../../examples/declarative_browser/pagination.sapp");
let Fit = import("../../examples/declarative_browser/text_fit.sapp");
let Focus = import("../../examples/declarative_browser/focus_indicator.sapp");
let D = import("stdlib:browser_document.sapp");
let S = import("stdlib:browser_session.sapp");
let G = import("stdlib:graphics.sapp");
let FM = import("stdlib:font_metrics.sapp");

fn _cli_args() {
    let raw = try env_get("PBLANG_SCRIPT_ARGS") catch "";
    if type(raw) == "string" and raw != "" { return str_split(raw, "\n"); }
    let argv = os_args();
    let out = [];
    let after = false;
    for item in argv {
        if after { array_push(out, item); }
        elif item == "--" { after = true; }
    }
    return out;
}

fn _parse_opts(args) {
    let base_env = (try env_get("READER_BASELINE") catch "0") == "1";
    let opts = map{ package: "", evidence: "", runtime: "", report: "", baseline: base_env, xvfb: false };
    let i = 0;
    while i < len(args) {
        let a = args[i];
        if a == "--xvfb" { opts.xvfb = true; i = i + 1; }
        elif a == "--baseline" { opts.baseline = true; i = i + 1; }
        elif (a == "--package" or a == "--evidence" or a == "--runtime" or a == "--report") and i + 1 < len(args) {
            opts[str_slice(a, 2, len(a))] = args[i + 1];
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return opts;
}

fn _snapshot_dir(root) {
    let out = map{};
    if root == "" or not (try fs_exists(root) catch false) { return out; }
    fn walk(rel) {
        let full = if rel == "" { root } else { path_join(root, rel) };
        let entries = try fs_listdir(full) catch nil;
        if type(entries) == "array" {
            for name in array_sort(entries) {
                walk(if rel == "" { name } else { rel + "/" + name });
            }
        } else {
            out[rel] = sha256(base64_encode_bytes(fs_read_bytes(full)));
        }
    }
    walk("");
    return out;
}

fn _font_measurer() {
    let fonts = map{};
    for fam in ["sans", "serif", "monospace", "system"] {
        let resolved = G.text_font_resolve(fam);
        fonts[fam] = if resolved != "" { FM.load(resolved) } else { nil };
    }
    return fn(text, px, family) {
        if text == "" { return map{ ok: true, width: 0, height: px }; }
        let fam = if map_has(fonts, family) { family } else { "sans" };
        let layout = try FM.layout(fonts[fam], text, px) catch nil;
        if layout != nil {
            return map{ ok: true, width: layout.width, height: layout.height };
        }
        return map{ ok: true, width: num_floor(len(text) * px * 0.6 + 0.999), height: px };
    };
}

fn _draw_frame(c, measure_fn, seen, observations) {
    let drawn = [];
    let canvas = map{
        clear: fn(_col) {},
        rect: fn(_x, _y, _rw, _rh, _col) {},
        rects: fn(_list, _col) {},
        line: fn(_x1, _y1, _x2, _y2, _col) {},
        point: fn(_x, _y, _col) {},
        circle: fn(_cx, _cy, _r, _col) {},
        textMeasure: fn(text, px, _adv, fam) { return measure_fn(text, px, fam); },
        textStyled: fn(x, y, text, _col, _px, _adv, fam) {
            array_push(drawn, map{ x: x, y: y, text: text, ok: true });
            return map{ ok: true, font: fam, renderer: "native-aa-fontdue", positioning: "truetype-baseline" };
        }
    };
    App.draw(c, canvas);
    let bounds = true;
    let exact = true;
    for w in c.form.widgets {
        if w.x < 0 or w.y < 0 or w.x + w.w > c.width or w.y + w.h > c.height { bounds = false; }
        if str_starts_with(w.name, "reading_") and w.name != "reading_status" and w.name != "reading_help" and w.kind == "label" {
            let found = false;
            for item in drawn {
                if item.ok and item.x == w.x and item.y == w.y {
                    found = true;
                    if item.text != w.text { exact = false; }
                }
            }
            if not found { exact = false; }
            if c.width == 320 and c.height == 480 and not c.settings and c.session.snapshot().url == "pb://guide" {
                seen[w.name] = w.text;
            }
        }
    }
    let plan = c.reading_plan;
    let state = map{
        width: c.width,
        height: c.height,
        available: plan != nil and plan.available,
        page: c.reading_page,
        pages: if plan == nil { 1 } else { len(plan.pages) },
        reason: if plan == nil { "" } else { plan.reason },
        anchor: c.reading_anchor,
        bounds: bounds,
        exact: exact,
        focus: c.form.focus,
        focus_visible: Focus.plan(c.form) != nil,
        settings: c.settings,
        url: c.session.snapshot().url
    };
    array_push(observations, state);
    return state;
}

fn _press(c, name) {
    let k = if name == "Return" { "Enter" } else { name };
    App.update(c, [map{ type: "keydown", key: k }, map{ type: "keyup", key: k }]);
}

fn main() {
    let opts = _parse_opts(_cli_args());
    let before_pkg = _snapshot_dir(opts.package);
    let measure = _font_measurer();

    let source = "<article><h1>Large imported text</h1><h2>" + str_repeat("W", 256) + "</h2><p>" + str_repeat("Ελληνικό κείμενο. ", 12) + "</p><a href=\"pb://about\">Final local destination</a></article>";
    let original = D.import_html(source);
    let original_html = D.export_html(original);

    if opts.baseline {
        // Verify that the legacy 64-row limit would truncate 256 broad W glyphs at 66px.
        let legacy_flow = Fit.lines(str_repeat("W", 256), 296, map{ font_family: "serif", font_size: 66, line_height: 1.25, font_weight: "bold" }, true, measure, 64);
        assert(legacy_flow.truncated, "64-row baseline truncates 256 broad W glyphs");
        let base_res = map{ expected_failure_reproduced: true, passed: true };
        print json_stringify(base_res);
        return;
    }

    let c = App.create();
    let local = App.pages();
    local["pb://guide"] = source;
    c.session.close();
    c.session = S.create(local);
    c.session.navigate("pb://guide");
    c.width = 320;
    c.height = 240;
    App.configure(c, map{ font_family: "serif", body_size: 40, title_size: 40, font_scale: 1.5, line_height: 1.25 });
    App.set_text_measure(c, measure);
    App.refresh(c);

    let seen = map{};
    let observations = [];

    let s0 = _draw_frame(c, measure, seen, observations);
    assert(s0.width == 320 and s0.height == 240 and not s0.available and s0.bounds, "320x240 small help view");

    App.update(c, [map{ type: "resize", w: 320, h: 480 }]);
    let first = _draw_frame(c, measure, seen, observations);
    assert(first.width == 320 and first.height == 480 and first.available and first.page == 0 and first.bounds and first.exact, "320x480 first page");
    let count = first.pages;
    assert(count > 20, "large imported document spans >20 pages");

    let page = 1;
    while page < count {
        _press(c, "Next");
        let sp = _draw_frame(c, measure, seen, observations);
        assert(sp.page == page and sp.bounds and sp.exact, "visited page " + str(page));
        page = page + 1;
    }
    let last = observations[len(observations) - 1];
    assert(last.page == count - 1, "reached last page");
    let anchor = last.anchor;

    for _i 7 {
        if c.form.focus == "appearance" { break; }
        _press(c, "Tab");
    }
    let s_app = _draw_frame(c, measure, seen, observations);
    assert(s_app.focus == "appearance" and s_app.focus_visible, "appearance button focused with visible indicator");

    _press(c, "Return");
    let s_set = _draw_frame(c, measure, seen, observations);
    assert(s_set.settings and s_set.anchor == anchor and s_set.bounds, "opened Style preserving anchor");

    // Done is always the fourth compact toolbar control at (275, 32).
    App.update(c, [
        map{ type: "mousedown", button: "Left", x: 275, y: 32 },
        map{ type: "mouseup", button: "Left", x: 275, y: 32 }
    ]);
    let s_done = _draw_frame(c, measure, seen, observations);
    assert(not s_done.settings and s_done.anchor == anchor and s_done.focus == "appearance" and s_done.focus_visible, "Done closed Style and kept anchor");

    let resizes = [
        map{ w: 640, h: 720, available: true },
        map{ w: 320, h: 240, available: false },
        map{ w: 320, h: 480, available: true }
    ];
    for step in resizes {
        App.update(c, [map{ type: "resize", w: step.w, h: step.h }]);
        let sr = _draw_frame(c, measure, seen, observations);
        assert(sr.width == step.w and sr.height == step.h and sr.available == step.available and sr.anchor == anchor and sr.bounds and sr.exact and sr.focus == "appearance" and sr.focus_visible, "resize roundtrip preserved anchor & focus");
    }

    _press(c, "Prior");
    assert(_draw_frame(c, measure, seen, observations).page == count - 2, "Prior stepped back one page");
    _press(c, "Next");
    assert(_draw_frame(c, measure, seen, observations).page == count - 1, "Next returned to final page");

    for _i 7 {
        if c.form.focus == "block2" { break; }
        _press(c, "Tab");
    }
    let s_link = _draw_frame(c, measure, seen, observations);
    assert(s_link.focus == "block2" and s_link.focus_visible, "final link block2 focused with visible indicator");

    _press(c, "Return");
    let s_final = _draw_frame(c, measure, seen, observations);
    assert(s_final.url == "pb://about" and s_final.bounds and s_final.exact and c.navigations == 1, "final link navigated to pb://about");

    let inspected = D.inspect(original);
    for index in [-1, 0, 1, 2] {
        let total = "";
        for offset 257 {
            let key = "reading_" + str(index) + "_" + str(offset);
            if map_has(seen, key) { total = total + seen[key]; }
        }
        let expected = if index < 0 { inspected.title } else { inspected.blocks[index].text };
        assert(str_replace_all(total, " ", "") == str_replace_all(P.normalized(expected), " ", ""), "all imported characters drawn");
    }
    assert(D.export_html(original) == original_html, "imported source unchanged");
    c.session.close();

    let pkg_unchanged = _snapshot_dir(opts.package) == before_pkg;
    assert(pkg_unchanged, "package unchanged");

    let report = map{
        passed: true,
        visited_pages: count,
        all_imported_characters_drawn: true,
        anchor_recovered: true,
        style_roundtrip: true,
        focus_visible: true,
        final_link_opened: true,
        package_unchanged: pkg_unchanged
    };
    if opts.evidence != "" {
        fs_mkdirs(opts.evidence);
        fs_write(path_join(opts.evidence, "acceptance.json"), json_stringify(report) + "\n");
    }
    if opts.report != "" {
        fs_write(opts.report, json_stringify(report) + "\n");
    }
    print json_stringify(report);
}

main();
