// Generate a single-CPU QEMU queue-write probe, never a host executable.
// Arguments: GC source path, destination C. Uses current heap implementation.
// Test instrumentation reserves low RAM 0x7000 and debug port 0xe9.
let C=import("stdlib:compiler/ctranspile.sapp");
fn replace_once(text, needle, replacement) {
    let parts=str_split(text,needle);
    assert(len(parts)==2,"leaf probe: expected one source marker");
    return parts[0]+replacement+parts[1];
}
let args=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");
assert(len(args)==2,"leaf probe: GC source and output C required");
let gc=fs_read(args[0]);let marker="poke32(work + tail * 4,";
let pieces=str_split(gc,marker);assert(len(pieces)==3,"leaf probe: expected two queue writes");
gc=pieces[0];let i=1;
while i<3 {gc=gc+"poke32(28672,peek32(28672)+1); "+marker+pieces[i];i=i+1;}
let fixture=fs_read("bench/kernel_gc_leaf_mark.sapp");
fixture=replace_once(fixture,"i=0;while i<200000", "poke32(28672,0);i=0;while i<1");
fixture=replace_once(fixture,"gc_collections(g)!=200000", "gc_collections(g)!=1");
fixture=replace_once(fixture,"if gc_live(g)!=257", "emit_number(peek32(28672));outb(233,10);if gc_live(g)!=257");
let emit="fn emit_number(value) {if value>=10 {emit_number(value/10);}outb(233,48+value%10);}\n";
fs_write(args[1],C.transpile_kernel_int(fs_read("stdlib/kernel/heap.sapp")+gc+emit+fixture));
print "leaf queue probe generated";
