// Pure PBLang native verification: TrueType-measured text fit across narrow/small/wide viewports and full glyph coverage.
let App = import("../../examples/declarative_browser/app.sapp");
let P = import("../../examples/declarative_browser/pagination.sapp");
let D = import("stdlib:browser_document.sapp");
let S = import("stdlib:browser_session.sapp");
let GUI = import("stdlib:gui.sapp");
let G = import("stdlib:graphics.sapp");
let FM = import("stdlib:font_metrics.sapp");

fn _cli_args() {
    let raw = try env_get("PBLANG_SCRIPT_ARGS") catch "";
    if type(raw) == "string" and raw != "" { return str_split(raw, "\n"); }
    let argv = os_args();
    let out = [];
    let after = false;
    for item in argv {
        if after { array_push(out, item); }
        elif item == "--" { after = true; }
    }
    return out;
}

fn _parse_opts(args) {
    let opts = map{ package: "", evidence: "", runtime: "", fixture: "", work_dir: "", cwd: "", report: "", xvfb: false };
    let i = 0;
    while i < len(args) {
        let a = args[i];
        if a == "--xvfb" { opts.xvfb = true; i = i + 1; }
        elif a == "--work-dir" and i + 1 < len(args) { opts.work_dir = args[i + 1]; i = i + 2; }
        elif (a == "--package" or a == "--evidence" or a == "--runtime" or a == "--fixture" or a == "--cwd" or a == "--report") and i + 1 < len(args) {
            opts[str_slice(a, 2, len(a))] = args[i + 1];
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return opts;
}

fn _font_measurer() {
    let fonts = map{};
    for fam in ["sans", "serif", "monospace", "system"] {
        let resolved = G.text_font_resolve(fam);
        fonts[fam] = if resolved != "" { FM.load(resolved) } else { nil };
    }
    return fn(text, px, family) {
        if text == "" { return map{ ok: true, width: 0, height: px }; }
        let fam = if map_has(fonts, family) { family } else { "sans" };
        let layout = try FM.layout(fonts[fam], text, px) catch nil;
        if layout != nil {
            return map{ ok: true, width: layout.width, height: layout.height };
        }
        return map{ ok: true, width: num_floor(len(text) * px * 0.6 + 0.999), height: px };
    };
}

fn _draw_frame(c, measure_fn, seen, clipped, observations) {
    let drawn = [];
    let canvas = map{
        clear: fn(_col) {},
        rect: fn(_x, _y, _rw, _rh, _col) {},
        rects: fn(_list, _col) {},
        line: fn(_x1, _y1, _x2, _y2, _col) {},
        point: fn(_x, _y, _col) {},
        circle: fn(_cx, _cy, _r, _col) {},
        textMeasure: fn(text, px, _adv, fam) { return measure_fn(text, px, fam); },
        textStyled: fn(x, y, text, _col, _px, _adv, fam) {
            array_push(drawn, map{ x: x, y: y, text: text, ok: true });
            return map{ ok: true, font: fam, renderer: "native-aa-fontdue", positioning: "truetype-baseline" };
        }
    };
    GUI.draw(canvas, c.form);
    let bounds = true;
    let exact = true;
    let help = "";
    let footer = "";
    for w in c.form.widgets {
        if w.x < 0 or w.y < 0 or w.x + w.w > c.width or w.y + w.h > c.height { bounds = false; }
        if str_starts_with(w.name, "reading_") and w.name != "reading_status" and w.name != "reading_help" and w.kind == "label" {
            let found = false;
            for item in drawn {
                if item.ok and item.x == w.x and item.y == w.y {
                    found = true;
                    if item.text != w.text { exact = false; }
                }
            }
            if not found { exact = false; }
            if c.width == 320 and c.height == 480 and c.session.snapshot().url == "pb://guide" {
                seen[w.name] = w.text;
            }
        }
        if w.name == "reading_help" or w.name == "destination" {
            let parts = [];
            for item in drawn {
                if item.ok and item.x == w.x and item.y >= w.y and item.y < w.y + w.h {
                    array_push(parts, item.text);
                }
            }
            if w.name == "reading_help" { help = str_join(parts, ""); }
            if w.name == "destination" { footer = str_join(parts, ""); }
        }
    }
    let plan = c.reading_plan;
    let state = map{
        width: c.width,
        height: c.height,
        available: plan != nil and plan.available,
        page: c.reading_page,
        pages: if plan == nil { 1 } else { len(plan.pages) },
        anchor: c.reading_anchor,
        bounds: bounds,
        exact: exact,
        help: help,
        footer: footer,
        focus: c.form.focus,
        url: c.session.snapshot().url,
        baseline_clipped_lines: clipped
    };
    array_push(observations, state);
    return state;
}

fn _press(c, name) {
    let k = if name == "Return" { "Enter" } else { name };
    App.update(c, [map{ type: "keydown", key: k }, map{ type: "keyup", key: k }]);
}

fn main() {
    let opts = _parse_opts(_cli_args());
    let measure = _font_measurer();

    let blocks = [
        map{ tag: "p", text: str_repeat("WWWWWWWWW ", 8) + "Ελληνικό κείμενο με τόνους και πλατιά γράμματα. Κάθε χαρακτήρας παραμένει ορατός." },
        map{ tag: "a", text: "Ο τελευταίος τοπικός σύνδεσμος", href: "pb://about" }
    ];
    let doc = D.create("WWWWWWWW — Οδηγός", blocks);
    let original = D.export_html(doc);

    let c = App.create();
    let local = App.pages();
    local["pb://guide"] = original;
    c.session.close();
    c.session = S.create(local);
    c.session.navigate("pb://guide");
    c.width = 320;
    c.height = 240;
    App.configure(c, map{ font_family: "serif", body_size: 30, title_size: 40, font_scale: 1.5, line_height: 2.5 });
    App.refresh(c);

    let baseline = P.plan(doc, c.appearance, 320, 480);
    let clipped = 0;
    for row in baseline.rows {
        if row.kind == "text" {
            let m = measure(row.text, row.size, "serif");
            if m.ok and m.height <= row.h and m.width + (if row.heading { 1 } else { 0 }) > 296 {
                clipped = clipped + 1;
            }
        }
    }
    assert(clipped > 0, "real TrueType font proves approximate layout would clip broad glyphs");

    App.set_text_measure(c, measure);
    App.refresh(c);

    let seen = map{};
    let observations = [];

    let s_help = _draw_frame(c, measure, seen, clipped, observations);
    assert(s_help.width == 320 and s_help.height == 240 and not s_help.available and s_help.bounds and s_help.exact, "320x240 unavailable help layout");
    assert(str_replace_all(s_help.help, " ", "") == str_replace_all("Enlarge window or change Style.", " ", ""), "320x240 help message rendered");
    assert(str_replace_all(s_help.footer, " ", "") == str_replace_all("Local links only • No network access", " ", ""), "320x240 footer rendered");

    App.update(c, [map{ type: "resize", w: 320, h: 480 }]);
    let first = _draw_frame(c, measure, seen, clipped, observations);
    assert(first.width == 320 and first.height == 480 and first.available and first.page == 0 and first.bounds and first.exact, "320x480 first page");

    let page = 1;
    while page < first.pages {
        _press(c, "Next");
        let sp = _draw_frame(c, measure, seen, clipped, observations);
        assert(sp.page == page and sp.bounds and sp.exact, "visited measured page " + str(page));
        page = page + 1;
    }
    let last = observations[len(observations) - 1];
    assert(last.page == first.pages - 1, "reached last measured page");
    let anchor = last.anchor;

    App.update(c, [map{ type: "resize", w: 640, h: 720 }]);
    let wide = _draw_frame(c, measure, seen, clipped, observations);
    assert(wide.width == 640 and wide.height == 720 and wide.anchor == anchor and wide.bounds and wide.exact, "640x720 preserved anchor");

    App.update(c, [map{ type: "resize", w: 320, h: 240 }]);
    let small = _draw_frame(c, measure, seen, clipped, observations);
    assert(small.width == 320 and small.height == 240 and not small.available and small.anchor == anchor and small.bounds, "320x240 retained anchor");
    assert(str_replace_all(small.help, " ", "") == str_replace_all("Enlarge window or change Style.", " ", ""), "small help text intact");

    App.update(c, [map{ type: "resize", w: 320, h: 480 }]);
    let restored = _draw_frame(c, measure, seen, clipped, observations);
    assert(restored.width == 320 and restored.height == 480 and restored.available and restored.anchor == anchor and restored.bounds and restored.exact, "320x480 restored anchor");

    _press(c, "End");
    let end_state = _draw_frame(c, measure, seen, clipped, observations);
    assert(end_state.page == end_state.pages - 1 and end_state.bounds and end_state.exact, "End on last page");

    for _i 9 {
        if c.form.focus == "block1" { break; }
        _press(c, "Tab");
    }
    assert(_draw_frame(c, measure, seen, clipped, observations).focus == "block1", "focused block1 link");

    _press(c, "Return");
    let dest = _draw_frame(c, measure, seen, clipped, observations);
    assert(dest.url == "pb://about" and dest.bounds and dest.exact and c.navigations == 1, "last local link opened pb://about");

    for index in [-1, 0, 1] {
        let total = "";
        for offset 257 {
            let key = "reading_" + str(index) + "_" + str(offset);
            if map_has(seen, key) { total = total + seen[key]; }
        }
        let src = if index < 0 { D.inspect(doc).title } else { blocks[index].text };
        assert(str_replace_all(total, " ", "") == str_replace_all(P.normalized(src), " ", ""), "all title and text characters visited and drawn");
    }
    assert(D.export_html(doc) == original, "canonical document unchanged");
    c.session.close();

    let report = map{
        result: "pass",
        passed: true,
        baseline_clipped_lines: clipped,
        observations: observations,
        port_or_hardware_access: false
    };
    if opts.evidence != "" {
        fs_mkdirs(opts.evidence);
        fs_write(path_join(opts.evidence, "acceptance.json"), json_stringify(report) + "\n");
    }
    if opts.report != "" {
        fs_write(opts.report, json_stringify(report) + "\n");
    }
    print json_stringify(map{ result: "pass", passed: true, baseline_clipped_lines: clipped, pages: first.pages, port_or_hardware_access: false });
}

main();
