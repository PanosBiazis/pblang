// Pure-PBLang verification of declarative browser keyboard link/back/forward navigation.
let App = import("../../examples/declarative_browser/app.sapp");
let GUI = import("stdlib:gui.sapp");

fn _parse_cli() {
    let raw = os_args();
    let out = map{evidence: nil, report: nil, runtime: nil, package: nil, xvfb: false};
    let after = false;
    let i = 0;
    while i < len(raw) {
        let arg = raw[i];
        if not after {
            if arg == "--" { after = true; }
        } elif arg == "--xvfb" {
            out.xvfb = true;
        } elif (arg == "--evidence" or arg == "--report" or arg == "--runtime" or arg == "--package") and i + 1 < len(raw) {
            let val = raw[i + 1];
            if arg == "--evidence" { out.evidence = val; }
            elif arg == "--report" { out.report = val; }
            elif arg == "--runtime" { out.runtime = val; }
            elif arg == "--package" { out.package = val; }
            i = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn _rm_tree(path) {
    let removed = false;
    try { fs_remove(path); removed = true; } catch {}
    if removed { return true; }
    let kids = try fs_listdir(path) catch nil;
    if type(kids) == "array" {
        for kid in kids { let _child = _rm_tree(path + "/" + kid); }
    }
    let ok = false;
    try { fs_remove(path); ok = true; } catch {}
    return ok;
}

fn _make_canvas() {
    let stats = map{clears: 0, rects: 0, lines: 0, points: 0};
    return map{
        stats: stats,
        clear: fn(_color) { stats.clears = stats.clears + 1; },
        rect: fn(_x, _y, rw, rh, _color) { if rw > 0 and rh > 0 { stats.rects = stats.rects + 1; } },
        rects: fn(items, _color) { stats.rects = stats.rects + len(items); },
        point: fn(_x, _y, _color) { stats.points = stats.points + 1; },
        line: fn(_x1, _y1, _x2, _y2, _color) { stats.lines = stats.lines + 1; },
        circle: fn(_cx, _cy, _r, _color) { stats.lines = stats.lines + 16; }
    };
}

fn _normalize_key(name) {
    if name == "Return" { return "Enter"; }
    return name;
}

fn _press_key(controller, raw_key) {
    let key = _normalize_key(raw_key);
    let _down = App.update(controller, [map{type: "keydown", key: key}]);
    let _up = App.update(controller, [map{type: "keyup", key: key}]);
}

fn _run(scratch, xvfb) {
    let c = App.create();
    let canvas = _make_canvas();
    let _initial_draw = App.draw(c, canvas);
    assert(canvas.stats.clears == 1 and canvas.stats.rects > 0, "initial declarative frame rendered");
    assert(c.session.snapshot().url == "pb://home" and c.navigations == 0, "initial home state");

    let sequence = ["Tab", "Tab", "Tab", "Return", "Tab", "Return", "Tab", "Return"];
    for key in sequence {
        _press_key(c, key);
        let _step_draw = GUI.draw(canvas, c.form);
    }

    let snap = c.session.snapshot();
    assert(snap.url == "pb://guide" and c.navigations == 3, "keyboard link/back/forward journey");
    assert(snap.document.form.title == "Guide — Οδηγός", "guide title preserved");
    assert(snap.can_back and not snap.can_forward, "history state settled after forward");

    let _final_draw = App.draw(c, canvas);
    let probe_json = scratch + "/probe.json";
    let result = map{
        passed: true,
        url: snap.url,
        navigations: c.navigations,
        title: snap.document.form.title,
        rendered_rects: canvas.stats.rects,
        xvfb_requested: xvfb
    };
    fs_write(probe_json, json_stringify(result));
    assert(json_parse(fs_read(probe_json)).navigations == 3, "probe serialization verified");
    c.session.close();
    return result;
}

fn main() {
    let cli = _parse_cli();
    let scratch = "/tmp/pblang_tooling_s3_declarative_browser_" + str(num_floor(now_ms()));
    fs_mkdirs(scratch);
    let result = try _run(scratch, cli.xvfb) catch nil;
    let ok = result != nil;

    if ok and cli.evidence != nil {
        fs_mkdirs(cli.evidence);
        fs_write(cli.evidence + "/acceptance.json", json_stringify(result) + "\n");
    }
    if ok and cli.report != nil {
        fs_mkdirs(path_dirname(cli.report));
        fs_write(cli.report, json_stringify(result) + "\n");
    }
    let _cleaned = _rm_tree(scratch);
    assert(not fs_exists(scratch), "disposable scratch cleaned");
    assert(ok, "declarative_browser_native failed");
    print json_stringify(result);
}

main();
