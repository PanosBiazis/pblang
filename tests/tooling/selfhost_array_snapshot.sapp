// Differential raw-VM compatibility probe. Compare JSON from two revisions;
// do not treat malformed raw chunks as serialized-bytecode admission tests.
let V=import("stdlib/compiler/vm.sapp");
fn inst(op,arg){return map{op:op,operand:arg};}
let rows=[];
for count in [0,1,2,3,4,8,64,0-1,0.5,1.5,2.5,bigint(1),decimal(2),rational(3),nil,true,"2"] {
    for available in [0,1,2,3,4] {
        let instructions=[];let constants=[];
        for i available {array_push(constants,i+10);array_push(instructions,inst(0,i));}
        array_push(instructions,inst(25,count));array_push(instructions,inst(19,0));
        for limits in [map{},map{max_value_items:1},map{max_stack:1},map{max_steps:2}] {
            let r=V.runtime_limits(limits);
            r.steps=0;r.peak_frames=0;r.peak_stack=0;r.peak_locals=0;r.peak_output=0;
            r.tripped=false;r.reason="";
            let e=V.execution_context();let value=nil;
            let failed=try {value=V.exec(map{instructions:instructions,constants:constants},[],map{},[],[],r,0,e);false;} catch true;
            V.close_execution(e);
            array_push(rows,map{failed:failed,value:value,runtime:r});
        }
    }
}
print json_stringify(rows);
