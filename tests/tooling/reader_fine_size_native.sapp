// Pure-PBLang verification of 1px Left/Right fine font size adjustments across compact and wide viewports, explicit Save, and Escape discard.
let App = import("../../examples/declarative_browser/app.sapp");
let Profile = import("../../examples/declarative_browser/appearance_profile.sapp");
let Store = import("../../examples/declarative_browser/appearance_store.sapp");
let Dir = import("stdlib:linux_dirfs.sapp");
let G = import("stdlib:graphics.sapp");
let FontMetrics = import("stdlib:font_metrics.sapp");

fn _parse_cli() {
    let raw = os_args();
    let out: any = map{package: nil, evidence: nil, report: nil, runtime: nil, xvfb: false};
    let after = false;
    let i = 0;
    while i < len(raw) {
        let arg = raw[i];
        if not after {
            if arg == "--" { after = true; }
        } elif arg == "--xvfb" {
            out.xvfb = true;
        } elif (arg == "--package" or arg == "--evidence" or arg == "--report" or arg == "--runtime") and i + 1 < len(raw) {
            let val = raw[i + 1];
            if arg == "--package" { out.package = val; }
            elif arg == "--evidence" { out.evidence = val; }
            elif arg == "--report" { out.report = val; }
            elif arg == "--runtime" { out.runtime = val; }
            i = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn _mkdir_private(parent, name) {
    let fs = Dir.open_absolute(parent, false, false);
    assert(fs.ok, "open parent");
    let created = Dir.mkdir_new(fs, name, false);
    let closed = Dir.close(fs);
    assert(created.ok and closed, "mkdir private");
    return parent + "/" + name;
}

fn _rm_tree(path) {
    let removed = false;
    try { fs_remove(path); removed = true; } catch {}
    if removed { return true; }
    let kids = try fs_listdir(path) catch nil;
    if type(kids) == "array" {
        for kid in kids { let _child = _rm_tree(path + "/" + kid); }
    }
    let ok = false;
    try { fs_remove(path); ok = true; } catch {}
    return ok;
}

fn _tree_entry_count(root) {
    let kids = try fs_listdir(root) catch nil;
    if type(kids) != "array" { return 0; }
    let count = 0;
    for kid in kids {
        count = count + 1 + _tree_entry_count(root + "/" + kid);
    }
    return count;
}

fn _make_text_measurer() {
    let cache_fonts = map{};
    let cache_metrics: any = map{};
    let cache_widths: any = map{};
    return fn(text, px, family) {
        if not map_has(cache_fonts, family) {
            let resolved = G.text_font_resolve(family);
            cache_fonts[family] = resolved;
            cache_metrics[family] = if resolved != "" { try FontMetrics.load(resolved) catch nil } else { nil };
        }
        let key = json_stringify([family, px, text]);
        if map_has(cache_widths, key) { return cache_widths[key]; }
        let layout = try FontMetrics.layout(cache_metrics[family], text, px) catch nil;
        let w = if layout != nil { layout.width } else { len(text) * num_max(4, num_floor(px * 0.56)) };
        let h = if layout != nil { layout.height } else { px };
        let res = map{ok: true, width: w, height: h, font: cache_fonts[family]};
        cache_widths[key] = res;
        return res;
    };
}

fn _draw_once(c) {
    let canvas = map{
        clear: fn(_col) {},
        rect: fn(_x, _y, _w, _h, _col) {},
        rects: fn(_items, _col) {},
        point: fn(_x, _y, _col) {},
        line: fn(_x1, _y1, _x2, _y2, _col) {},
        circle: fn(_cx, _cy, _r, _col) {}
    };
    let _d = App.draw(c, canvas);
}

fn _key(c, raw_name) {
    let k = if raw_name == "Return" { "Enter" } elif raw_name == "Page_Down" { "PageDown" } elif raw_name == "Page_Up" { "PageUp" } else { raw_name };
    let _d = App.update(c, [map{type: "keydown", key: k}]);
    let _u = App.update(c, [map{type: "keyup", key: k}]);
}

fn _tabs(c, n) {
    for _i n { _key(c, "Tab"); }
}

fn _click(c, xpos, ypos) {
    let _d = App.update(c, [map{type: "mousedown", x: xpos, y: ypos, button: "Left"}]);
    let _u = App.update(c, [map{type: "mouseup", x: xpos, y: ypos, button: "Left"}]);
}

fn _close(c) {
    for _i 3 {
        if c.form.close_requested { break; }
        _key(c, "Escape");
    }
    assert(c.form.close_requested, "clean reader close");
    c.session.close();
}

fn _start_style(data_dir, measurer) {
    let loaded = Store.load(data_dir);
    let saver = fn(style) {
        let res = Store.save(data_dir, style, loaded.token);
        if res.confirmed { loaded.token = res.token; }
        return res;
    };
    let reloader = fn() {
        let fresh = Store.load(data_dir);
        if not fresh.ok or not fresh.can_save or fresh.token == "missing" { return map{ok: false}; }
        loaded.token = fresh.token;
        return map{ok: true, appearance: fresh.appearance, save: saver};
    };
    let active_saver: any = if loaded.can_save { saver } else { nil };
    let c = App.create("local", "dark");
    App.enable_preferences(c, loaded.appearance, active_saver, loaded.message, reloader);
    App.set_text_measure(c, measurer);
    let _ref = App.refresh(c);
    _click(c, 700, 44);
    assert(c.settings and c.form.focus == "font_family", "Style opened with font_family focused");
    return c;
}

fn _run(scratch) {
    let data_dir = _mkdir_private(scratch, "data");
    let profile_path = data_dir + "/reader-style/appearance-v1.json";
    let measurer = _make_text_measurer();

    let c1 = _start_style(data_dir, measurer);
    let _r_compact = App.update(c1, [map{type: "resize", w: 320, h: 240}]);
    _key(c1, "Page_Down");
    assert(c1.form.focus == "body_size", "compact Page_Down focused body_size");
    _key(c1, "Left");
    assert(c1.preferences.draft.body_size == 15, "body_size stepped down to 15");
    _key(c1, "Right");
    _key(c1, "Right");
    assert(c1.preferences.draft.body_size == 17, "body_size stepped up to 17");
    _draw_once(c1);
    assert(_tree_entry_count(data_dir) == 0, "Fine adjustment must not implicitly save");

    let _r_wide = App.update(c1, [map{type: "resize", w: 800, h: 816}]);
    _key(c1, "Tab");
    assert(c1.form.focus == "title_size", "Tab focused title_size on wide viewport");
    _key(c1, "Left");
    assert(c1.preferences.draft.title_size == 27, "title_size stepped down to 27");
    _key(c1, "Right");
    _key(c1, "Right");
    assert(c1.preferences.draft.title_size == 29, "title_size stepped up to 29");
    _draw_once(c1);

    _tabs(c1, 5);
    assert(c1.form.focus == "style_save", "focused style_save");
    _key(c1, "Return");
    _draw_once(c1);
    assert(fs_exists(profile_path), "profile explicitly saved");
    let decoded = Profile.decode(fs_read(profile_path));
    assert(decoded.ok and decoded.appearance.body_size == 17 and decoded.appearance.title_size == 29, "saved body_size 17 and title_size 29");

    let saved_bytes = fs_read_bytes(profile_path);
    _key(c1, "Escape");
    _draw_once(c1);
    assert(not c1.settings and not c1.form.close_requested, "Escape returned to document without closing");
    _close(c1);

    let c2 = _start_style(data_dir, measurer);
    _draw_once(c2);
    assert(fs_read_bytes(profile_path) == saved_bytes and c2.appearance.body_size == 17 and c2.appearance.title_size == 29, "restart loaded body_size 17 and title_size 29");
    _key(c2, "Tab");
    _key(c2, "Left");
    assert(c2.preferences.draft.body_size == 16, "draft stepped to 16");
    _key(c2, "Escape");
    assert(c2.appearance.body_size == 17 and fs_read_bytes(profile_path) == saved_bytes, "Escape discard kept saved profile");
    _close(c2);

    return map{
        passed: true,
        body_size: 17,
        title_size: 29,
        no_implicit_save: true,
        explicit_save: true,
        restart_kept: true,
        escape_discard_kept_saved: true,
        compact_size: [320, 240],
        wide_size: [800, 816],
        visual_review_required: false
    };
}

fn main() {
    let cli = _parse_cli();
    let scratch_name = "pblang_tooling_s3_fine_" + str(num_floor(now_ms()));
    let scratch = _mkdir_private("/tmp", scratch_name);
    let result = try _run(scratch) catch nil;
    let _cleaned = _rm_tree(scratch);
    assert(result != nil and result.passed == true, "reader_fine_size_native failed");
    let json_text = json_stringify(result);
    if cli.evidence != nil and cli.evidence != "" {
        fs_mkdirs(cli.evidence);
        fs_write(cli.evidence + "/acceptance.json", json_text + "\n");
    }
    if cli.report != nil and cli.report != "" {
        fs_mkdirs(path_dirname(cli.report));
        fs_write(cli.report, json_text + "\n");
    }
    print json_text;
}

main();
