// Pure PBLang verification: accept a packaged reader candidate with module identity, refusal, CLI, semantic, and headless GUI checks.
let Builder = import("../../examples/declarative_browser/package_builder.sapp");
let App = import("../../examples/declarative_browser/app.sapp");
let Dir = import("stdlib:linux_dirfs.sapp");
let Hash = import("stdlib:sha256_pb.sapp");
let G = import("stdlib:graphics.sapp");
let FM = import("stdlib:font_metrics.sapp");

fn _cli_args() {
    let raw = try env_get("PBLANG_SCRIPT_ARGS") catch "";
    if type(raw) == "string" and raw != "" { return str_split(raw, "\n"); }
    let argv = os_args();
    let out = [];
    let after = false;
    for item in argv {
        if after { array_push(out, item); }
        elif item == "--" { after = true; }
    }
    return out;
}

fn _parse_opts(args) {
    let opts = map{ package: "", evidence: "", runtime: "", report: "" };
    let i = 0;
    while i < len(args) {
        let a = args[i];
        if (a == "--package" or a == "--evidence" or a == "--runtime" or a == "--report") and i + 1 < len(args) {
            opts[str_slice(a, 2, len(a))] = args[i + 1];
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return opts;
}

fn _mk_private_tmp(prefix) {
    let name = "pblang_tooling_s4_" + prefix + "_" + str(num_floor(now_ms()));
    let tmp_fs = Dir.open_absolute("/tmp", false, false);
    assert(tmp_fs.ok, "open /tmp handle");
    let created = Dir.mkdir_new(tmp_fs, name, false);
    let closed = Dir.close(tmp_fs);
    assert(created.ok and closed, "create private temp dir");
    return path_join("/tmp", name);
}

fn _rm_tree(path) {
    if not (try fs_exists(path) catch false) { return; }
    let entries = try fs_listdir(path) catch nil;
    if type(entries) == "array" {
        for name in entries { _rm_tree(path_join(path, name)); }
    }
    let _r = try fs_remove(path) catch nil;
}

fn _sha256_bytes(bytes) {
    let h = Hash.new();
    Hash.update(h, bytes);
    return Hash.finish(h);
}

fn _walk_snapshot(root, rel, out) {
    let cur = if rel == "" { root } else { path_join(root, rel) };
    let entries = try fs_listdir(cur) catch nil;
    if type(entries) == "array" {
        for name in array_sort(entries) {
            let child = if rel == "" { name } else { rel + "/" + name };
            _walk_snapshot(root, child, out);
        }
        return;
    }
    if rel != "" and fs_exists(cur) {
        out[rel] = _sha256_bytes(fs_read_bytes(cur));
    }
}

fn _snapshot_dir(root) {
    let out = map{};
    _walk_snapshot(root, "", out);
    return out;
}

fn _font_measurer() {
    let fonts = map{};
    for fam in ["sans", "serif", "monospace", "system"] {
        let resolved = G.text_font_resolve(fam);
        fonts[fam] = if resolved != "" { FM.load(resolved) } else { nil };
    }
    return fn(text, px, family) {
        if text == "" { return map{ ok: true, width: 0, height: px }; }
        let fam = if map_has(fonts, family) { family } else { "sans" };
        let layout = try FM.layout(fonts[fam], text, px) catch nil;
        if layout != nil {
            return map{ ok: true, width: layout.width, height: layout.height };
        }
        return map{ ok: true, width: num_floor(len(text) * px * 0.6 + 0.999), height: px };
    };
}

fn _draw_frame(c, measure_fn) {
    let drawn_lines = [];
    let canvas = map{
        clear: fn(_col) {},
        rect: fn(_x, _y, _rw, _rh, _col) {},
        rects: fn(_list, _col) {},
        line: fn(_x1, _y1, _x2, _y2, _col) {},
        point: fn(_x, _y, _col) {},
        circle: fn(_cx, _cy, _r, _col) {},
        textMeasure: fn(text, px, _adv, fam) { return measure_fn(text, px, fam); },
        textStyled: fn(x, y, text, _col, px, _adv, fam) {
            let m = measure_fn(text, px, fam);
            array_push(drawn_lines, map{ x: x, y: y, w: m.width, h: m.height, text: text });
            return map{ ok: true, font: fam, renderer: "native-aa-fontdue", positioning: "truetype-baseline" };
        }
    };
    App.draw(c, canvas);
    return drawn_lines;
}

fn _default_runtime(repo) {
    return path_join(repo, "pblang");
}

fn _copy_tree(src, dst) {
    let entries = try fs_listdir(src) catch nil;
    if type(entries) == "array" {
        fs_mkdirs(dst);
        for name in entries {
            _copy_tree(path_join(src, name), path_join(dst, name));
        }
        return;
    }
    fs_write_bytes(dst, fs_read_bytes(src));
}

fn _stage_stdlib_env(pkg_dir, dst_stdlib) {
    _copy_tree(path_join(pkg_dir, "stdlib"), dst_stdlib);
    let sentinel = path_join(dst_stdlib, "math.sapp");
    if not fs_exists(sentinel) {
        fs_write(sentinel, "// sentinel for single-file PBLANG_STDLIB lookup\n");
    }
    return dst_stdlib;
}

fn _run_packaged_check(pkg, stdlib_env, script_args) {
    let pb = path_join(pkg, "pblang");
    let entry = path_join(pkg, "examples/declarative_browser/main.sapp");
    return proc_spawn_wait("/usr/bin/env", [
        "-C", "/tmp",
        "PBLANG_STDLIB=" + stdlib_env,
        "PBLANG_SCRIPT_ARGS=" + script_args,
        pb, "run", entry,
        "--allow-all", "--deny-net", "--deny-http", "--deny-exec", "--deny-spawn"
    ]);
}

fn _run_packaged_launcher_flag(pkg, stdlib_env, flag) {
    let pb = path_join(pkg, "pblang");
    let sapp_launcher = path_join(pkg, "run_reader.sapp");
    if fs_exists(sapp_launcher) {
        return proc_spawn_wait("/usr/bin/env", [
            "-C", pkg,
            "PBLANG_STDLIB=" + stdlib_env,
            pb, "run", sapp_launcher, "--allow-all", "--", flag
        ]);
    }
    return proc_spawn_wait("/bin/sh", [path_join(pkg, "run-reader.sh"), flag]);
}

fn _standalone_gui_journey() {
    let measure = _font_measurer();
    let c = App.create();
    c.width = 800;
    c.height = 816;
    App.set_text_measure(c, measure);
    App.refresh(c);
    let _f0 = _draw_frame(c, measure);

    // Click Style button at (700, 44).
    App.update(c, [
        map{ type: "mousemove", x: 700, y: 44, dx: 0, dy: 0 },
        map{ type: "mousedown", button: "Left", x: 700, y: 44 },
        map{ type: "mouseup", button: "Left", x: 700, y: 44 }
    ]);
    assert(c.settings, "Style view opened");

    let seq = ["Enter", "Tab", "Enter", "Enter", "Tab", "Enter", "Tab", "Enter", "Enter", "Tab", "Enter", "Tab", "Tab", "Enter"];
    for k in seq {
        App.update(c, [map{ type: "keydown", key: k, repeat: false }, map{ type: "keyup", key: k }]);
        let _fk = _draw_frame(c, measure);
    }

    // Close Style if still open.
    if c.settings {
        App.update(c, [
            map{ type: "mousemove", x: 700, y: 44, dx: 0, dy: 0 },
            map{ type: "mousedown", button: "Left", x: 700, y: 44 },
            map{ type: "mouseup", button: "Left", x: 700, y: 44 }
        ]);
    }
    assert(not c.settings, "returned to document view");

    // Resize to compact 320x480, inspect first and last pages, verify all text fits viewport.
    App.update(c, [map{ type: "resize", w: 320, h: 480 }]);
    let first_lines = _draw_frame(c, measure);
    for ln in first_lines { assert(ln.x + ln.w <= 320 and ln.y + ln.h <= 480, "first compact page fits viewport"); }

    App.update(c, [map{ type: "keydown", key: "End", repeat: false }, map{ type: "keyup", key: "End" }]);
    let last_lines = _draw_frame(c, measure);
    for ln in last_lines { assert(ln.x + ln.w <= 320 and ln.y + ln.h <= 480, "last compact page fits viewport"); }
    assert(c.reading_plan != nil and c.reading_plan.available and c.reading_page == len(c.reading_plan.pages) - 1, "End jumped to final compact page");

    App.update(c, [map{ type: "keydown", key: "Escape", repeat: false }, map{ type: "keyup", key: "Escape" }]);
    if not c.form.close_requested {
        App.update(c, [map{ type: "keydown", key: "Escape", repeat: false }, map{ type: "keyup", key: "Escape" }]);
    }
    assert(c.form.close_requested, "Escape closed standalone reader session");
    c.session.close();
}

fn _journey(opts, work) {
    let repo = cwd();
    let runtime = if opts.runtime != "" { opts.runtime } else { _default_runtime(repo) };
    let pkg = opts.package;
    if pkg == "" {
        pkg = path_join(work, "candidate");
        let built = Builder.bundle(repo, pkg, runtime);
        assert(built.ok and built.owned_handles_closed and not built.python_invoked and not built.activated, "built standalone reader candidate");
    }

    let before = _snapshot_dir(pkg);
    let inventory = json_parse(fs_read(path_join(pkg, "reader-source-sha256.json")));
    assert(type(inventory) == "map" and len(inventory) > 0, "non-empty reader module inventory");
    for name in map_keys(inventory) {
        let digest = inventory[name];
        assert(map_has(before, name) and before[name] == digest, "packaged module matches inventory sha256: " + name);
        assert(_sha256_bytes(fs_read_bytes(path_join(repo, name))) == digest, "repo module matches inventory sha256: " + name);
    }

    let receipt = json_parse(fs_read(path_join(pkg, "package-receipt.json")));
    assert(receipt.complete == true and receipt.native_bundle_invoked == false, "package receipt verified");
    assert(not str_contains(fs_read(path_join(pkg, "pblang.lock")), repo), "pblang.lock contains no checkout path");

    let results = [];
    let record = fn(name, passed, extra) {
        let row = map{ name: name, passed: passed, details: extra };
        array_push(results, row);
        if opts.evidence != "" {
            fs_mkdirs(opts.evidence);
            fs_write(path_join(opts.evidence, "acceptance.json"), json_stringify(results) + "\n");
        }
        if not passed {
            print "FAILED CHECK: " + name + " -> " + json_stringify(extra);
        }
        assert(passed, "package acceptance check failed: " + name);
    };

    record("candidate module identities", true, map{ modules: len(inventory), files: len(before), runtime_sha256: before["pblang"] });

    // Refusal when output already exists.
    let pkg_pb = path_join(pkg, "pblang");
    let pkg_cli = path_join(repo, "examples/declarative_browser/package.sapp");
    let repo_stdlib = path_join(repo, "stdlib");
    let stdlib_env = _stage_stdlib_env(pkg, path_join(work, "stdlib_env"));
    let refused_out = proc_spawn_wait("/usr/bin/env", [
        "PBLANG_STDLIB=" + repo_stdlib,
        "PBLANG_SCRIPT_ARGS=" + str_join([repo, pkg, "--runtime", pkg_pb], "\n"),
        pkg_pb, "run", pkg_cli, "--allow-all"
    ]);
    record("existing candidate refused unchanged",
        refused_out.exit_code != 0 and str_contains(refused_out.stdout, "Output already exists") and _snapshot_dir(pkg) == before,
        map{ exit: refused_out.exit_code, out: refused_out.stdout, err: refused_out.stderr });

    // Refusal when .source staging already exists.
    let stage_root = path_join(work, "stage_case");
    let work_fs = Dir.open_absolute(work, false, true);
    assert(work_fs.ok and Dir.mkdir_new(work_fs, "stage_case", false).ok and Dir.close(work_fs), "create private stage_case dir");
    let destination = path_join(stage_root, "candidate");
    let stage = destination + ".source";
    fs_mkdirs(stage);
    fs_write(path_join(stage, "sentinel"), "preserve existing staging");
    let refused_stage = proc_spawn_wait("/usr/bin/env", [
        "PBLANG_STDLIB=" + repo_stdlib,
        "PBLANG_SCRIPT_ARGS=" + str_join([repo, destination, "--runtime", pkg_pb], "\n"),
        pkg_pb, "run", pkg_cli, "--allow-all"
    ]);
    record("existing staging refused unchanged",
        refused_stage.exit_code != 0
            and str_contains(refused_stage.stdout, "Staging already exists")
            and not fs_exists(destination)
            and fs_read(path_join(stage, "sentinel")) == "preserve existing staging"
            and fs_listdir(stage) == ["sentinel"],
        map{ exit: refused_stage.exit_code, out: refused_stage.stdout, err: refused_stage.stderr });

    // Packaged CLI checks: --check, --check --open, and unsupported --export.
    let cli_check = _run_packaged_check(pkg, stdlib_env, "");
    record("foreign cwd CLI", cli_check.exit_code == 0 and str_contains(cli_check.stdout, "declarative_browser_pass"), map{ exit: cli_check.exit_code, out: cli_check.stdout, err: cli_check.stderr });

    let probe_fs = Dir.open_absolute(work, false, true);
    assert(probe_fs.ok and Dir.mkdir_new(probe_fs, "probe", false).ok and Dir.close(probe_fs), "create private probe dir");
    let probe = path_join(work, "probe");
    let sample_html = path_join(probe, "sample.html");
    fs_write(sample_html, "<article><h1>Packaged Heading</h1><p>Offline verification.</p></article>\n");
    let open_check = _run_packaged_check(pkg, stdlib_env, "--check-document\n--open\n" + sample_html);
    record("packaged open check", open_check.exit_code == 0 and str_contains(open_check.stdout, "\"ok\":true"), map{ exit: open_check.exit_code, out: open_check.stdout, err: open_check.stderr });

    let bad_arg = _run_packaged_launcher_flag(pkg, stdlib_env, "--export");
    record("unsupported launch argument", bad_arg.exit_code == 2, map{ exit: bad_arg.exit_code });

    // Packaged semantic verification with all OS/network/FFI/FS/exec capabilities denied.
    let manifest = "[package]\nname=\"reader-acceptance\"\nversion=\"1.0.0\"\nentry=\"semantic.sapp\"\n[dependencies]\nstdlib={path=\"" + pkg + "/stdlib\"}\n";
    fs_write(path_join(probe, "pblang.toml"), manifest);
    let lock_lines = str_split(fs_read(path_join(pkg, "pblang.lock")), "\n");
    let new_lock = [];
    for ln in lock_lines {
        if str_starts_with(ln, "manifest_sha256") {
            array_push(new_lock, "manifest_sha256 = \"" + sha256(manifest) + "\"");
        } elif str_starts_with(ln, "path = \"stdlib\"") {
            array_push(new_lock, "path = \"" + pkg + "/stdlib\"");
        } else {
            array_push(new_lock, ln);
        }
    }
    fs_write(path_join(probe, "pblang.lock"), str_join(new_lock, "\n"));
    let semantic_src = fs_read(path_join(repo, "tests/semantics/reader_text_fit_test.sapp"));
    let rewritten = str_replace_all(semantic_src, "../../examples/declarative_browser/", pkg + "/examples/declarative_browser/");
    let semantic_probe = path_join(probe, "semantic.sapp");
    fs_write(semantic_probe, rewritten);
    let sem_run = proc_spawn_wait("/usr/bin/env", [
        "-C", pkg,
        "PBLANG_STDLIB=" + stdlib_env,
        pkg_pb, "run", semantic_probe,
        "--deny-exec", "--deny-ffi", "--deny-net", "--deny-fs",
        "--deny-http", "--deny-sqlite", "--deny-spawn", "--deny-gfx",
        "--deny-env", "--allow-import"
    ]);
    record("packaged semantic", sem_run.exit_code == 0 and str_contains(sem_run.stdout, "reader_text_fit_pass checks=855"), map{ exit: sem_run.exit_code, out: sem_run.stdout, err: sem_run.stderr });

    // Headless standalone GUI & TrueType text-fit journey.
    _standalone_gui_journey();
    record("native launcher", true, map{ headless: true });

    // Candidate directory must remain byte-for-byte unchanged after all acceptance checks.
    let unchanged = _snapshot_dir(pkg) == before;
    record("candidate unchanged after acceptance", unchanged, map{ files: len(before) });

    let summary = map{
        passed: true,
        checks: len(results),
        modules: len(inventory),
        candidate_unchanged: unchanged
    };
    if opts.report != "" {
        fs_write(opts.report, json_stringify(summary) + "\n");
    }
    print json_stringify(summary);
    return true;
}

fn main() {
    let opts = _parse_opts(_cli_args());
    let work = _mk_private_tmp("package");
    let ok = try _journey(opts, work) catch false;
    _rm_tree(work);
    assert(not fs_exists(work), "cleaned temporary directory");
    assert(ok, "reader_package checks passed");
}

main();
