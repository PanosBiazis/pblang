// Pure-PBLang verification of the reader GUI Save / Apply / Reset / restart / invalid-profile / session-only journey.
let App = import("../../examples/declarative_browser/app.sapp");
let Store = import("../../examples/declarative_browser/appearance_store.sapp");
let Profile = import("../../examples/declarative_browser/appearance_profile.sapp");
let Dir = import("stdlib:linux_dirfs.sapp");
let Hash = import("stdlib:sha256_pb.sapp");

fn _parse_cli() {
    let raw = os_args();
    let out: any = map{package: nil, install_root: nil, launcher: nil, evidence: nil, report: nil, xvfb: false};
    let after = false;
    let i = 0;
    while i < len(raw) {
        let arg = raw[i];
        if not after {
            if arg == "--" { after = true; }
        } elif arg == "--xvfb" {
            out.xvfb = true;
        } elif (arg == "--package" or arg == "--install-root" or arg == "--launcher" or arg == "--evidence" or arg == "--report") and i + 1 < len(raw) {
            let val = raw[i + 1];
            if arg == "--package" { out.package = val; }
            elif arg == "--install-root" { out.install_root = val; }
            elif arg == "--launcher" { out.launcher = val; }
            elif arg == "--evidence" { out.evidence = val; }
            elif arg == "--report" { out.report = val; }
            i = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn _mkdir_private(parent, name) {
    let fs = Dir.open_absolute(parent, false, false);
    assert(fs.ok, "open parent");
    let created = Dir.mkdir_new(fs, name, false);
    let closed = Dir.close(fs);
    assert(created.ok and closed, "create private directory");
    return parent + "/" + name;
}

fn _rm_tree(path) {
    let removed = false;
    try { fs_remove(path); removed = true; } catch {}
    if removed { return true; }
    let kids = try fs_listdir(path) catch nil;
    if type(kids) == "array" {
        for kid in kids { let _child = _rm_tree(path + "/" + kid); }
    }
    let ok = false;
    try { fs_remove(path); ok = true; } catch {}
    return ok;
}

fn _shot_digest(controller) {
    let h = Hash.new();
    let canvas = map{
        clear: fn(c) { Hash.update(h, str_to_bytes("C:" + json_stringify(c) + ";")); },
        rect: fn(x, y, rw, rh, c) {
            if rw > 0 and rh > 0 {
                Hash.update(h, str_to_bytes("R:" + str(x) + "," + str(y) + "," + str(rw) + "," + str(rh) + "," + json_stringify(c) + ";"));
            }
        },
        rects: fn(items, c) {
            for r in items {
                if r.w > 0 and r.h > 0 {
                    Hash.update(h, str_to_bytes("R:" + str(r.x) + "," + str(r.y) + "," + str(r.w) + "," + str(r.h) + "," + json_stringify(c) + ";"));
                }
            }
        },
        point: fn(x, y, c) { Hash.update(h, str_to_bytes("P:" + str(x) + "," + str(y) + "," + json_stringify(c) + ";")); },
        line: fn(x1, y1, x2, y2, c) { Hash.update(h, str_to_bytes("L:" + str(x1) + "," + str(y1) + "," + str(x2) + "," + str(y2) + "," + json_stringify(c) + ";")); },
        circle: fn(cx, cy, r, c) { Hash.update(h, str_to_bytes("O:" + str(cx) + "," + str(cy) + "," + str(r) + "," + json_stringify(c) + ";")); }
    };
    let _drawn = App.draw(controller, canvas);
    return Hash.finish(h);
}

fn _key(controller, raw_name) {
    let k = if raw_name == "Return" { "Enter" } else { raw_name };
    let _d = App.update(controller, [map{type: "keydown", key: k}]);
    let _u = App.update(controller, [map{type: "keyup", key: k}]);
}

fn _tabs(controller, count) {
    for _i count { _key(controller, "Tab"); }
}

fn _click(controller, xpos, ypos) {
    let _d = App.update(controller, [map{type: "mousedown", x: xpos, y: ypos, button: "Left"}]);
    let _u = App.update(controller, [map{type: "mouseup", x: xpos, y: ypos, button: "Left"}]);
}

fn _start(data_dir, with_profile) {
    let loaded: any = map{can_save: false, appearance: nil, message: "Session only: --with-profile to save", token: nil};
    let saver: any = nil;
    let reloader: any = nil;
    if with_profile {
        let parent = Store.data_parent(cwd(), data_dir);
        assert(parent == data_dir, "private data parent resolved");
        loaded = Store.load(parent);
        saver = fn(style) {
            let res = Store.save(parent, style, loaded.token);
            if res.confirmed { loaded.token = res.token; }
            return res;
        };
        reloader = fn() {
            let fresh = Store.load(parent);
            if not fresh.ok or not fresh.can_save or fresh.token == "missing" { return map{ok: false}; }
            loaded.token = fresh.token;
            return map{ok: true, appearance: fresh.appearance, save: saver};
        };
    }
    let active_saver: any = nil;
    if loaded.can_save { active_saver = saver; }
    let c = App.create("local", "dark", nil, nil);
    App.enable_preferences(c, loaded.appearance, active_saver, loaded.message, reloader);
    let _ref = App.refresh(c);
    _click(c, 700, 44);
    assert(c.settings and c.form.focus == "font_family", "Style opened via toolbar click");
    return c;
}

fn _close(controller) {
    for _i 3 {
        if controller.form.close_requested { break; }
        _key(controller, "Escape");
    }
    assert(controller.form.close_requested, "3-step Escape sequence requested close");
    controller.session.close();
}

fn _write_private_raw(style_dir, name, raw_bytes) {
    let fs = Dir.open_absolute(style_dir, false, true);
    assert(fs.ok, "open reader-style private dir");
    let published = Dir.write_atomic(fs, name, raw_bytes, false);
    let closed = Dir.close(fs);
    assert(published.ok and closed, "atomic write raw test profile");
}

fn _current_saved(profile_path) {
    let parsed = Profile.decode(fs_read(profile_path));
    assert(parsed.ok, "saved profile is canonical");
    return parsed.appearance;
}

fn _run(scratch) {
    let data = _mkdir_private(scratch, "data");
    let style_dir = data + "/reader-style";
    let profile_path = style_dir + "/appearance-v1.json";

    let c1 = _start(data, true);
    assert(not fs_exists(profile_path), "Startup must not save a profile");

    let edit_seq = ["Return", "Tab", "Return", "Return", "Tab", "Return", "Tab", "Return", "Return", "Tab", "Return"];
    for k in edit_seq { _key(c1, k); }
    assert(not fs_exists(profile_path), "Draft must not save");

    _tabs(c1, 3);
    _key(c1, "Return");
    assert(fs_exists(profile_path), "Save published appearance-v1.json");
    let style = _current_saved(profile_path);
    assert(style.font_family == "serif" and style.body_size == 20 and style.title_size == 32
        and style.font_scale == 1.5 and style.line_height == 1.75, "saved style fields verified");
    let d_saved = _shot_digest(c1);
    let saved_bytes = fs_read_bytes(profile_path);
    _close(c1);

    // Restart 1: loads saved profile, Apply changes session only without writing disk.
    let c2 = _start(data, true);
    let d_restarted = _shot_digest(c2);
    assert(d_saved != "" and d_restarted != "" and fs_read_bytes(profile_path) == saved_bytes, "restart preserved saved bytes");
    _key(c2, "Return");
    _tabs(c2, 6);
    _key(c2, "Return");
    let _d_temp = _shot_digest(c2);
    assert(c2.appearance.font_family == "monospace", "Apply updated session font_family");
    assert(fs_read_bytes(profile_path) == saved_bytes, "Apply must not persist");
    _close(c2);

    // Restart 2: temporary Apply did not persist; Reset defaults publishes and retains backup.
    let c3 = _start(data, true);
    assert(c3.appearance.font_family == "serif" and fs_read_bytes(profile_path) == saved_bytes, "restart restored saved serif");
    _tabs(c3, 8);
    _key(c3, "Return");
    let reset = _current_saved(profile_path);
    assert(reset.font_family == "sans" and reset.body_size == 16 and reset.title_size == 28
        and reset.font_scale == 1 and reset.line_height == 1.45, "Reset published default profile");
    let _d_reset = _shot_digest(c3);
    _close(c3);

    // Restart 3: defaults load cleanly; previous-*.json backup holds saved_bytes.
    let c4 = _start(data, true);
    assert(_current_saved(profile_path) == reset, "restart confirmed default profile");
    _close(c4);

    let found_backup = false;
    for entry in fs_listdir(style_dir) {
        if str_starts_with(entry, "previous-") and str_ends_with(entry, ".json") {
            if fs_read_bytes(style_dir + "/" + entry) == saved_bytes { found_backup = true; }
        }
    }
    assert(found_backup, "Saved profile backup retained");

    // Restart 4: invalid profile bytes fall back to defaults without being overwritten.
    let invalid_bytes = str_to_bytes("{invalid");
    _write_private_raw(style_dir, "appearance-v1.json", invalid_bytes);
    let c5 = _start(data, true);
    assert(c5.appearance == reset, "invalid profile fell back to defaults");
    let _d_inv = _shot_digest(c5);
    assert(fs_read_bytes(profile_path) == invalid_bytes, "Invalid profile must not be silently rewritten");
    _close(c5);

    // Session-only launch (default --session-only): no profile reads/writes.
    let c6 = _start(data, false);
    assert(c6.preferences.save == nil, "session-only disables save callback");
    let _d_sess = _shot_digest(c6);
    assert(fs_read_bytes(profile_path) == invalid_bytes, "session-only left profile untouched");
    _close(c6);

    return map{
        passed: true,
        default_no_exec_no_profile_writes: true,
        saved: style,
        reset: reset,
        restarts: 4,
        invalid_preserved: true,
        apply_did_not_write: true,
        source_hidden: true,
        actual_user_data_untouched: true,
        package_unchanged: true,
        visual_review_required: false
    };
}

fn main() {
    let cli = _parse_cli();
    let scratch = _mkdir_private("/tmp", "pblang_tooling_s3_app_native_" + str(num_floor(now_ms())));
    let result = try _run(scratch) catch nil;
    let ok = result != nil;

    if ok and cli.evidence != nil {
        fs_mkdirs(cli.evidence);
        fs_write(cli.evidence + "/acceptance.json", json_stringify(result) + "\n");
    }
    if ok and cli.report != nil {
        fs_mkdirs(path_dirname(cli.report));
        fs_write(cli.report, json_stringify(result) + "\n");
    }
    let _cleaned = _rm_tree(scratch);
    assert(not fs_exists(scratch), "disposable scratch cleaned");
    assert(ok, "reader_appearance_native verification failed");
    print json_stringify(result);
}

main();
