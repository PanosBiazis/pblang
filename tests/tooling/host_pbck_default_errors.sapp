// Supervisor verification for uncaught host_pbck_inspect and host_pbck_decode
// default/type/depth boundary diagnostics in pure PBLang.

fn _expected_diagnostic(scenario, reader) {
    if scenario == "depth" and reader == "inspect" {
        return "host_pbck: function nesting limit exceeded";
    }
    if scenario == "depth" {
        return "host_pbck_decode: nesting limit exceeded";
    }
    if scenario == "defaults" and reader == "inspect" {
        return "host_pbck: invalid default count";
    }
    if scenario == "defaults" {
        return "host_pbck_decode: invalid default count";
    }
    if scenario == "types" and reader == "inspect" {
        return "host_pbck: invalid parameter-type count";
    }
    return "host_pbck_decode: parameter-type limit exceeded";
}

fn _matches_uncaught_diagnostic(first_line, expected) {
    // Retained host binary emits: error[file:line:col]: <expected>
    if str_starts_with(first_line, "error[") and str_ends_with(first_line, "]: " + expected) {
        return true;
    }
    // Sovereign zero-rust runtime emits: Runtime error: <expected> (at file:line in fn)
    if str_starts_with(first_line, "Runtime error: " + expected + " (at ") and str_ends_with(first_line, ")") {
        return true;
    }
    if first_line == "Runtime error: " + expected {
        return true;
    }
    return false;
}

fn main() {
    let raw_args = os_args();
    let pb_arg = "";
    let report_arg = "";
    let i = 0;
    while i < len(raw_args) {
        let a = raw_args[i];
        if (a == "--pblang" or a == "--runtime") and i + 1 < len(raw_args) {
            pb_arg = raw_args[i + 1];
            i = i + 1;
        } elif a == "--report" and i + 1 < len(raw_args) {
            report_arg = raw_args[i + 1];
            i = i + 1;
        }
        i = i + 1;
    }

    let repo_root = cwd();
    let pb_bin = if pb_arg != "" { pb_arg } else { repo_root + "/pblang" };
    assert(fs_exists(pb_bin), "host_pbck_default_errors: pblang binary missing");
    let target_script = repo_root + "/tests/semantics/host_pbck_default_depth_test.sapp";
    assert(fs_exists(target_script), "host_pbck_default_errors: semantics test missing");

    // 1. Verify positive 64-depth boundary acceptance first (0 script args).
    let pos = proc_spawn_wait(pb_bin, ["run", "--allow-all", target_script]);
    assert(pos.exit_code == 0 and pos.stdout == "host_pbck_default_depth_pass\n", "positive 64-depth boundary check failed");

    // 2. Verify all 9 uncaught negative scenario x reader combinations.
    let scenarios = ["depth", "defaults", "types"];
    let readers = ["inspect", "decode", "compact"];
    let rows = [];

    let si = 0;
    while si < len(scenarios) {
        let scenario = scenarios[si];
        let ri = 0;
        while ri < len(readers) {
            let reader = readers[ri];
            let expected = _expected_diagnostic(scenario, reader);
            let proc = proc_spawn_wait(pb_bin, [
                "run", "--allow-all", target_script, "--", scenario, reader
            ]);
            let err_lines = str_split(proc.stderr, "\n");
            let first_err = if len(err_lines) > 0 { str_trim(err_lines[0]) } else { "" };
            let ok = proc.exit_code == 1
                and proc.stdout == ""
                and _matches_uncaught_diagnostic(first_err, expected);
            array_push(rows, map{
                scenario: scenario,
                reader: reader,
                exit: proc.exit_code,
                diagnostic: first_err,
                expected: expected,
                passed: ok
            });
            if not ok {
                print "FAIL: " + scenario + "/" + reader + " exit=" + str(proc.exit_code) + " stdout=" + proc.stdout + " err=" + first_err;
            }
            assert(ok, "host_pbck_default_errors failed: " + scenario + "/" + reader);
            print scenario + "/" + reader + ": pass";
            ri = ri + 1;
        }
        si = si + 1;
    }

    if report_arg != "" {
        let pdir = path_dirname(report_arg);
        if pdir != "" and pdir != "." { fs_mkdirs(pdir); }
        fs_write(report_arg, json_stringify(map{ passed: true, cases: rows }) + "\n");
    }
    print "host_pbck_default_errors_pass: cases=" + str(len(rows));
}

main();
