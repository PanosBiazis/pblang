// Generate a QEMU-only count probe, not a timing benchmark or host executable.
// Arguments: heap source, GC source, output C. All paths are caller-provided.
// Low RAM 0x7000 is reserved by this single-CPU test for the traversal counter.
let C=import("stdlib:compiler/ctranspile.sapp");
fn replace_once(text, needle, replacement) {
    let parts=str_split(text,needle);
    assert(len(parts)==2,"sweep probe: expected one source marker");
    return parts[0]+replacement+parts[1];
}
let args=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");
assert(len(args)==3,"sweep probe: heap source, GC source, output C required");
let heap=fs_read(args[0]);
if str_contains(heap,"while cur > 0 and cur < block") {
    heap=replace_once(heap,"while cur > 0 and cur < block {", "while cur > 0 and cur < block {poke32(28672,peek32(28672)+1);");
    // Count the nonzero stopping successor too, matching the original probe.
    heap=replace_once(heap,"let nxt = cur;", "if cur > 0 {poke32(28672,peek32(28672)+1);}let nxt = cur;");
} else {
    heap=replace_once(heap,"if cur >= block", "poke32(28672,peek32(28672)+1); if cur >= block");
}
let fixture=fs_read("bench/kernel_gc_fragmented_sweep.sapp");
fixture=replace_once(fixture,"while pass<80", "while pass<1");
fixture=replace_once(fixture,"if kernel_gc_collect(g)!=0", "poke32(28672,0); if kernel_gc_collect(g)!=0");
fixture=replace_once(fixture,"pass=pass+1;", "emit_number(peek32(28672));outb(233,10);pass=pass+1;");
let emit="fn emit_number(value) {if value>=10 {emit_number(value/10);}outb(233,48+value%10);}\n";
fs_write(args[2],C.transpile_kernel_int(heap+fs_read(args[1])+emit+fixture));
print "sweep probe generated";
