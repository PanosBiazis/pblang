// Pure-PBLang verification of same-title input isolation and Greek/ASCII save/readback.
let GUI = import("stdlib:gui.sapp");
let X11Input = import("stdlib:x11_input.sapp");

fn _parse_cli() {
    let raw = os_args();
    let out = map{evidence: nil, report: nil, runtime: nil, package: nil, xvfb: false};
    let after = false;
    let i = 0;
    while i < len(raw) {
        let arg = raw[i];
        if not after {
            if arg == "--" { after = true; }
        } elif arg == "--xvfb" {
            out.xvfb = true;
        } elif (arg == "--evidence" or arg == "--report" or arg == "--runtime" or arg == "--package") and i + 1 < len(raw) {
            let val = raw[i + 1];
            if arg == "--evidence" { out.evidence = val; }
            elif arg == "--report" { out.report = val; }
            elif arg == "--runtime" { out.runtime = val; }
            elif arg == "--package" { out.package = val; }
            i = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn _resolve_runtime(explicit) {
    if explicit != nil and explicit != "" { return explicit; }
    let root = cwd();
    if fs_exists(root + "/pblang") { return root + "/pblang"; }
    if fs_exists(root + "/target/release/pblang") { return root + "/target/release/pblang"; }
    return "./pblang";
}

fn _rm_tree(path) {
    let removed = false;
    try { fs_remove(path); removed = true; } catch {}
    if removed { return true; }
    let kids = try fs_listdir(path) catch nil;
    if type(kids) == "array" {
        for kid in kids { let _child = _rm_tree(path + "/" + kid); }
    }
    let ok = false;
    try { fs_remove(path); ok = true; } catch {}
    return ok;
}

fn _make_canvas() {
    let count = map{rects: 0};
    return map{
        count: count,
        clear: fn(_c) {},
        rect: fn(_x, _y, rw, rh, _c) { if rw > 0 and rh > 0 { count.rects = count.rects + 1; } },
        rects: fn(items, _c) { count.rects = count.rects + len(items); },
        point: fn(_x, _y, _c) {},
        line: fn(_x1, _y1, _x2, _y2, _c) {},
        circle: fn(_cx, _cy, _r, _c) {}
    };
}

fn _deliver_stroke(form, key_name, committed_text, shift_flag) {
    let down = map{
        type: "keydown",
        key: key_name,
        shift: shift_flag,
        ctrl: false,
        alt: false,
        meta: false,
        text: committed_text
    };
    let up = map{
        type: "keyup",
        key: key_name,
        shift: shift_flag,
        ctrl: false,
        alt: false,
        meta: false
    };
    let _d = GUI.handle_event(form, down);
    let _u = GUI.handle_event(form, up);
}

fn _run(scratch, runtime) {
    let ascii_plan = X11Input.text_plan("abcdef");
    let greek_plan = X11Input.text_plan("αβγ");
    let compose = X11Input.compose_plan("αβγ");
    assert(ascii_plan.ok and len(ascii_plan.strokes) == 6, "ASCII X11 text plan");
    assert(greek_plan.ok and len(greek_plan.strokes) == 3, "Greek X11 text plan");
    assert(compose.ok and len(compose.sequences) == 3, "Greek compose plan");

    let forms = [];
    let canvases = [];
    for _idx 2 {
        let f = GUI.form("PBLang Input Pair", 500, 180);
        let _added = GUI.add(f, GUI.textbox("entry", 20, 60, 460, 36, ""));
        f.focus = "entry";
        f.text_render = "auto";
        array_push(forms, f);
        array_push(canvases, _make_canvas());
    }
    assert(forms[0].title == forms[1].title and forms[0].title == "PBLang Input Pair", "equal public titles");

    for ch in ["a", "b", "c", "d", "e", "f"] {
        _deliver_stroke(forms[0], str_upper(ch), ch, false);
    }
    assert(GUI.get(forms[0], "entry").value == "abcdef", "first window received ASCII");
    assert(GUI.get(forms[1], "entry").value == "", "second window isolated from first");

    let greek_strokes = [
        ["Greek_alpha", "α"],
        ["Greek_beta", "β"],
        ["Greek_gamma", "γ"]
    ];
    for pair in greek_strokes {
        _deliver_stroke(forms[1], pair[0], pair[1], false);
    }
    assert(GUI.get(forms[0], "entry").value == "abcdef", "first window preserved after Greek input");
    assert(GUI.get(forms[1], "entry").value == "αβγ", "second window received Greek keysyms");

    for i 2 {
        assert(forms[i].dirty, "form marked dirty before draw");
        let _drawn = GUI.draw(canvases[i], forms[i]);
        assert(not forms[i].dirty and canvases[i].count.rects > 0, "form rendered cleanly");
    }

    let values = [GUI.get(forms[0], "entry").value, GUI.get(forms[1], "entry").value];
    let saved_path = scratch + "/values.json";
    let encoded = json_stringify(values);
    fs_write(saved_path, encoded);
    assert(fs_read(saved_path) == encoded, "exact byte save/readback");
    let parsed = json_parse(fs_read(saved_path));
    assert(parsed == ["abcdef", "αβγ"], "decoded pair matches expected values");

    let confined_probe = "let v=json_parse(fs_read(" + json_stringify(saved_path) + "));assert(v[0]==\"abcdef\" and v[1]==\"αβγ\",\"confined readback\");print \"ok\";";
    let sub = proc_spawn_wait(runtime, [
        "eval", confined_probe,
        "--allow-all", "--deny-exec", "--deny-net", "--deny-http", "--deny-spawn"
    ]);
    assert(sub.exit_code == 0 and str_trim(sub.stdout) == "ok", "confined readback subprocess");

    return map{
        passed: true,
        same_public_title: true,
        separate_values: values,
        exact_save_readback: true,
        confined_capabilities_verified: true,
        visual_review_required: false
    };
}

fn main() {
    let cli = _parse_cli();
    let runtime = _resolve_runtime(cli.runtime);
    let scratch = "/tmp/pblang_tooling_s3_ordered_pair_" + str(num_floor(now_ms()));
    fs_mkdirs(scratch);
    let result = try _run(scratch, runtime) catch nil;
    let ok = result != nil;

    if ok and cli.evidence != nil {
        fs_mkdirs(cli.evidence);
        fs_write(cli.evidence + "/summary.json", json_stringify(result) + "\n");
    }
    if ok and cli.report != nil {
        fs_mkdirs(path_dirname(cli.report));
        fs_write(cli.report, json_stringify(result) + "\n");
    }
    let _cleaned = _rm_tree(scratch);
    assert(not fs_exists(scratch), "disposable scratch cleaned");
    assert(ok, "native_ordered_pair verification failed");
    print json_stringify(result);
}

main();
