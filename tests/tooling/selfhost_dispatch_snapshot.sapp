// Run under both revisions and compare the JSON records structurally. Only
// scalar fixture outputs and accounting are recorded, never cyclic VM globals.
let F=import("stdlib/compiler/selfhost_frontend.sapp");
let V=import("stdlib/compiler/vm.sapp");
let O=import("stdlib/compiler/optimizer.sapp");
let P=import("stdlib/selfhost_pbck.sapp");
let cases=import("tests/fixtures/shared_capture_cases.sapp").cases;
let snapshots=[];let artifacts=[];
for item in cases {
    let compiled=F.frontend_compile(item[0]);assert(compiled.ok,"fixture compiles");
    for chunk in [compiled.chunk,O.optimize_safe(compiled.chunk).chunk] {
        array_push(artifacts,P.serialize_chunk(chunk));
        for limits in [map{},map{max_steps:1},map{max_steps:3},map{max_steps:10},
            map{max_steps:50},map{max_stack:1},map{max_stack:2},map{max_frames:2},
            map{max_locals:1},map{max_value_items:2}] {
            let r=V.runtime_limits(limits);
            r.steps=0;r.peak_frames=0;r.peak_stack=0;r.peak_locals=0;r.peak_output=0;
            r.tripped=false;r.reason="";
            let out=[];let locals=[];let e=V.execution_context();
            let failed=try {V.exec(chunk,locals,map{},out,[],r,0,e);false;} catch true;
            V.close_execution(e);
            array_push(snapshots,map{failed:failed,output:out,runtime:r,local_count:len(locals)});
        }
    }
}
print json_stringify(map{artifacts:artifacts,runs:snapshots});
