// Pure-PBLang verification of compact settings paging across an unavailable Save page without storage writes.
let App = import("../../examples/declarative_browser/app.sapp");
let Store = import("../../examples/declarative_browser/appearance_store.sapp");
let Dir = import("stdlib:linux_dirfs.sapp");
let Hash = import("stdlib:sha256_pb.sapp");

fn _parse_cli() {
    let raw = os_args();
    let out = map{package: nil, evidence: nil, report: nil, xvfb: false};
    let after = false;
    let i = 0;
    while i < len(raw) {
        let arg = raw[i];
        if not after {
            if arg == "--" { after = true; }
        } elif arg == "--xvfb" {
            out.xvfb = true;
        } elif (arg == "--package" or arg == "--evidence" or arg == "--report") and i + 1 < len(raw) {
            let val = raw[i + 1];
            if arg == "--package" { out.package = val; }
            elif arg == "--evidence" { out.evidence = val; }
            elif arg == "--report" { out.report = val; }
            i = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn _mkdir_private(parent, name) {
    let fs = Dir.open_absolute(parent, false, false);
    assert(fs.ok, "open parent");
    let created = Dir.mkdir_new(fs, name, false);
    let closed = Dir.close(fs);
    assert(created.ok and closed, "mkdir private");
    return parent + "/" + name;
}

fn _rm_tree(path) {
    let removed = false;
    try { fs_remove(path); removed = true; } catch {}
    if removed { return true; }
    let kids = try fs_listdir(path) catch nil;
    if type(kids) == "array" {
        for kid in kids { let _child = _rm_tree(path + "/" + kid); }
    }
    let ok = false;
    try { fs_remove(path); ok = true; } catch {}
    return ok;
}

fn _snapshot_walk(root, rel, acc) {
    let current = if rel == "" { root } else { root + "/" + rel };
    let kids = try fs_listdir(current) catch nil;
    if type(kids) == "array" {
        for kid in array_sort(kids) {
            let next_rel = if rel == "" { kid } else { rel + "/" + kid };
            _snapshot_walk(root, next_rel, acc);
        }
    } else {
        acc[rel] = sha256(base64_encode_bytes(fs_read_bytes(current)));
    }
}

fn _snapshot(root) {
    let acc = map{};
    _snapshot_walk(root, "", acc);
    return acc;
}

fn _frame_digest(controller) {
    let h = Hash.new();
    let canvas = map{
        clear: fn(c) { Hash.update(h, str_to_bytes("C:" + json_stringify(c) + ";")); },
        rect: fn(x, y, rw, rh, c) {
            if rw > 0 and rh > 0 {
                Hash.update(h, str_to_bytes("R:" + str(x) + "," + str(y) + "," + str(rw) + "," + str(rh) + "," + json_stringify(c) + ";"));
            }
        },
        rects: fn(items, c) {
            for r in items {
                if r.w > 0 and r.h > 0 {
                    Hash.update(h, str_to_bytes("R:" + str(r.x) + "," + str(r.y) + "," + str(r.w) + "," + str(r.h) + "," + json_stringify(c) + ";"));
                }
            }
        },
        point: fn(x, y, c) { Hash.update(h, str_to_bytes("P:" + str(x) + "," + str(y) + "," + json_stringify(c) + ";")); },
        line: fn(x1, y1, x2, y2, c) { Hash.update(h, str_to_bytes("L:" + str(x1) + "," + str(y1) + "," + str(x2) + "," + str(y2) + "," + json_stringify(c) + ";")); },
        circle: fn(cx, cy, r, c) { Hash.update(h, str_to_bytes("O:" + str(cx) + "," + str(cy) + "," + str(r) + "," + json_stringify(c) + ";")); }
    };
    let _d = App.draw(controller, canvas);
    return Hash.finish(h);
}

fn _normalize(k) {
    if k == "Return" { return "Enter"; }
    return k;
}

fn _key(c, raw_name) {
    let k = _normalize(raw_name);
    let _d = App.update(c, [map{type: "keydown", key: k}]);
    let _u = App.update(c, [map{type: "keyup", key: k}]);
}

fn _click(c, xpos, ypos) {
    let _d = App.update(c, [map{type: "mousedown", x: xpos, y: ypos, button: "Left"}]);
    let _u = App.update(c, [map{type: "mouseup", x: xpos, y: ypos, button: "Left"}]);
}

fn _run(scratch) {
    let data = _mkdir_private(scratch, "data");
    let unmanaged_style = _mkdir_private(data, "reader-style");
    let profile = unmanaged_style + "/appearance-v1.json";
    fs_write_bytes(profile, str_to_bytes("{invalid"));
    let before = _snapshot(data);

    // Match main.sapp --gui-profile startup when Store.load sees an unmanaged/unavailable folder.
    let loaded = Store.load(data);
    assert(not loaded.can_save, "unmanaged invalid profile disables saving");
    let reloader = fn() {
        let fresh = Store.load(data);
        if not fresh.ok or not fresh.can_save or fresh.token == "missing" { return map{ok: false}; }
        return map{ok: true, appearance: fresh.appearance, save: fn(_s) { return map{ok: false}; }};
    };
    let c = App.create("local", "dark", nil, nil);
    App.enable_preferences(c, loaded.appearance, nil, loaded.message, reloader);
    let _ref = App.refresh(c);
    _click(c, 700, 44);
    assert(c.settings, "opened Style");

    let _rz = App.update(c, [map{type: "resize", w: 320, h: 240}]);
    _key(c, "Home");
    for _i 6 { _key(c, "Next"); }
    assert(c.form.focus == "style_apply", "reached style_apply page");
    let d_apply = _frame_digest(c);

    // Forward Next from style_apply skips disabled style_save and lands on style_reset.
    _key(c, "Next");
    assert(c.form.focus == "style_reset", "forward Next skipped disabled style_save");
    let d_forward = _frame_digest(c);

    // End reaches style_reload, then Prior reaches style_reset with identical rendered frame.
    _key(c, "End");
    assert(c.form.focus == "style_reload", "End reached style_reload");
    _key(c, "Prior");
    assert(c.form.focus == "style_reset", "Prior from style_reload reached style_reset");
    let d_reset_ref = _frame_digest(c);
    assert(d_forward == d_reset_ref, "forward skip matches reference Reset frame");

    // Backward Prior from style_reset skips disabled style_save and lands on style_apply.
    _key(c, "Prior");
    assert(c.form.focus == "style_apply", "backward Prior skipped disabled style_save");
    let d_backward = _frame_digest(c);
    assert(d_backward == d_apply, "backward skip matches Apply frame");

    // Mouse pager click at (230, 136) uses the same bounded destination rule.
    _click(c, 230, 136);
    assert(c.form.focus == "style_reset", "mouse pager skipped disabled style_save");
    let d_pointer = _frame_digest(c);
    assert(d_pointer == d_reset_ref, "mouse pager matches Reset reference frame");

    // Held keyboard Next across multiple poll ticks moves only one bounded step.
    _key(c, "Prior");
    assert(c.form.focus == "style_apply", "returned to style_apply before held Next");
    for _tick 5 {
        let _held = App.update(c, [map{type: "keydown", key: "Next"}]);
    }
    let _rel = App.update(c, [map{type: "keyup", key: "Next"}]);
    assert(c.form.focus == "style_reset", "held Next moved once to style_reset");
    let d_held = _frame_digest(c);
    assert(d_held == d_reset_ref, "held Next frame matches Reset reference");

    // Activate Reset in session-only mode, Escape back to document, then close cleanly.
    _key(c, "Return");
    let _d_applied = _frame_digest(c);
    _key(c, "Escape");
    assert(not c.settings and not c.form.close_requested, "Escape returned to document without closing");
    let _d_doc = _frame_digest(c);

    for _i 3 {
        if c.form.close_requested { break; }
        _key(c, "Escape");
    }
    assert(c.form.close_requested, "clean close requested");
    c.session.close();

    assert(_snapshot(data) == before, "Read-only paging/reset did not modify storage");
    return map{
        passed: true,
        disabled_save_skipped_both_directions: true,
        mouse_pager: true,
        held_key_one_move: true,
        reset_reachable: true,
        invalid_profile_unchanged: true,
        same_gui_pid: true,
        compact_size: [320, 240],
        visual_review_required: false
    };
}

fn main() {
    let cli = _parse_cli();
    let scratch = _mkdir_private("/tmp", "pblang_tooling_s3_disabled_page_" + str(num_floor(now_ms())));
    let result = try _run(scratch) catch nil;
    let ok = result != nil;

    if ok and cli.evidence != nil {
        fs_mkdirs(cli.evidence);
        fs_write(cli.evidence + "/acceptance.json", json_stringify(result) + "\n");
    }
    if ok and cli.report != nil {
        fs_mkdirs(path_dirname(cli.report));
        fs_write(cli.report, json_stringify(result) + "\n");
    }
    let _cleaned = _rm_tree(scratch);
    assert(not fs_exists(scratch), "disposable scratch cleaned");
    assert(ok, "reader_disabled_page_native verification failed");
    print json_stringify(result);
}

main();
