// Pure-PBLang verification of keyboard-only preferences at the 320x240 minimum viewport and live resize.
let App = import("../../examples/declarative_browser/app.sapp");
let GUI = import("stdlib:gui.sapp");

fn _parse_cli() {
    let raw = os_args();
    let out = map{evidence: nil, report: nil, runtime: nil, xvfb: false};
    let after = false;
    let i = 0;
    while i < len(raw) {
        let arg = raw[i];
        if not after {
            if arg == "--" { after = true; }
        } elif arg == "--xvfb" {
            out.xvfb = true;
        } elif (arg == "--evidence" or arg == "--report" or arg == "--runtime") and i + 1 < len(raw) {
            let val = raw[i + 1];
            if arg == "--evidence" { out.evidence = val; }
            elif arg == "--report" { out.report = val; }
            elif arg == "--runtime" { out.runtime = val; }
            i = i + 1;
        }
        i = i + 1;
    }
    return out;
}

fn _rm_tree(path) {
    let removed = false;
    try { fs_remove(path); removed = true; } catch {}
    if removed { return true; }
    let kids = try fs_listdir(path) catch nil;
    if type(kids) == "array" {
        for kid in kids { let _child = _rm_tree(path + "/" + kid); }
    }
    let ok = false;
    try { fs_remove(path); ok = true; } catch {}
    return ok;
}

fn _canvas() {
    let n = map{rects: 0};
    return map{
        n: n,
        clear: fn(_c) {},
        rect: fn(_x, _y, rw, rh, _c) { if rw > 0 and rh > 0 { n.rects = n.rects + 1; } },
        rects: fn(items, _c) { n.rects = n.rects + len(items); },
        point: fn(_x, _y, _c) {},
        line: fn(_x1, _y1, _x2, _y2, _c) {},
        circle: fn(_cx, _cy, _r, _c) {}
    };
}

fn _observe(c, canvas) {
    let _d = GUI.draw(canvas, c.form);
    let bounds = true;
    for w in c.form.widgets {
        if w.x < 0 or w.y < 0 or w.x + w.w > c.width or w.y + w.h > c.height { bounds = false; }
    }
    return map{
        settings: c.settings,
        focus: c.form.focus,
        width: c.width,
        height: c.height,
        bounds: bounds,
        layout: c.settings_layout,
        appearance: c.appearance,
        anchor: c.reading_anchor,
        url: c.session.snapshot().url
    };
}

fn _press(c, raw_key, hold_ticks) {
    let k = if raw_key == "Return" { "Enter" } elif raw_key == "space" { "Space" } else { raw_key };
    for _t hold_ticks {
        let _d = App.update(c, [map{type: "keydown", key: k}]);
    }
    let _u = App.update(c, [map{type: "keyup", key: k}]);
}

fn _shift_tabs(c, count) {
    let _s1 = App.update(c, [map{type: "keydown", key: "LeftShift", shift: true}]);
    for _i count {
        let _k1 = App.update(c, [map{type: "keydown", key: "Tab", shift: true}]);
        let _k2 = App.update(c, [map{type: "keyup", key: "Tab", shift: true}]);
    }
    let _s2 = App.update(c, [map{type: "keyup", key: "LeftShift", shift: false}]);
}

fn _run(scratch) {
    let c = App.create();
    let _nav = c.session.navigate("pb://guide");
    c.width = 320;
    c.height = 240;
    let _ref = App.refresh(c);
    let initial_anchor = c.reading_anchor;
    let canvas = _canvas();
    let observations = [];

    let initial = _observe(c, canvas);
    assert(not initial.settings and initial.bounds, "initial 320x240 guide state within bounds");
    array_push(observations, initial);

    for _i 3 { _press(c, "Tab", 1); }
    let s_btn = _observe(c, canvas);
    assert(s_btn.focus == "appearance", "3 Tabs reached Style button");
    array_push(observations, s_btn);

    _press(c, "Return", 1);
    let s_open = _observe(c, canvas);
    assert(s_open.settings and s_open.focus == "font_family" and s_open.bounds, "opened compact Style on font_family");
    array_push(observations, s_open);

    let expected_steps: any = [
        ["font_family", "serif"],
        ["body_size", 18],
        ["title_size", 32],
        ["font_scale", 1.25],
        ["line_height", 1.75],
        ["density", "compact"]
    ];
    for step in expected_steps {
        let field = step[0];
        let wanted = step[1];
        let before = _observe(c, canvas);
        assert(before.focus == field and before.bounds, "compact page focused " + field);
        _press(c, "Return", 1);
        let after = _observe(c, canvas);
        assert(after.focus == field and after.bounds and after.appearance[field] == wanted, "updated " + field);
        array_push(observations, after);
        if field != "density" {
            // Hold Next across 3 poll ticks to verify single-page bounded advance.
            _press(c, "Next", 3);
        }
    }

    // Resize to 390x844 (all 6 choices on a single unclipped page) and 520x844 (unpaged expanded view).
    let _rz1 = App.update(c, [map{type: "resize", w: 390, h: 844}]);
    let tall_narrow = _observe(c, canvas);
    assert(tall_narrow.width == 390 and tall_narrow.height == 844 and tall_narrow.focus == "density"
        and tall_narrow.bounds and (tall_narrow.layout == nil or tall_narrow.layout.count == 1),
        "390x844 fits all settings on one page");
    array_push(observations, tall_narrow);

    let _rz_wide = App.update(c, [map{type: "resize", w: 520, h: 844}]);
    let expanded = _observe(c, canvas);
    assert(expanded.width == 520 and expanded.height == 844 and expanded.focus == "density"
        and expanded.layout == nil and expanded.bounds, "520x844 expanded layout without pagination");
    array_push(observations, expanded);

    // Resize back to 320x240 compact preferences view: retains density on page 5.
    let _rz2 = App.update(c, [map{type: "resize", w: 320, h: 240}]);
    let last_compact = _observe(c, canvas);
    assert(last_compact.width == 320 and last_compact.height == 240 and last_compact.focus == "density"
        and last_compact.bounds and last_compact.layout.page == 5, "320x240 retained density page 5");
    array_push(observations, last_compact);

    _press(c, "Home", 1);
    let at_home = _observe(c, canvas);
    assert(at_home.focus == "font_family" and at_home.bounds, "Home jumped to first compact page");
    _press(c, "End", 1);
    let at_end = _observe(c, canvas);
    assert(at_end.focus == "density" and at_end.bounds, "End jumped to last compact page");

    _shift_tabs(c, 1);
    let at_prev = _observe(c, canvas);
    assert(at_prev.focus == "settings_previous", "Shift+Tab focused settings_previous");

    _press(c, "space", 3);
    let at_lh = _observe(c, canvas);
    assert(at_lh.focus == "line_height" and at_lh.bounds and at_lh.appearance.line_height == 1.75, "Space on settings_previous stepped to line_height");
    array_push(observations, at_lh);

    _press(c, "End", 1);
    assert(_observe(c, canvas).focus == "density", "End returned to density");
    _shift_tabs(c, 2);
    assert(_observe(c, canvas).focus == "appearance", "Shift+Tab x2 focused Done button");

    _press(c, "Return", 1);
    let done = _observe(c, canvas);
    assert(not done.settings and done.focus == "appearance" and done.anchor == initial_anchor and done.bounds, "Done restored document and reading anchor");
    array_push(observations, done);

    _press(c, "Escape", 1);
    _press(c, "Escape", 1);
    assert(c.form.close_requested, "Escape x2 requested window close");
    assert(not c.settings and c.session.snapshot().url == "pb://guide" and c.navigations == 0, "Done preserved document");
    assert(c.appearance.font_family == "serif" and c.appearance.body_size == 18 and c.appearance.title_size == 32
        and c.appearance.font_scale == 1.25 and c.appearance.line_height == 1.75 and c.appearance.density == "compact",
        "all settings changed through keyboard input");
    assert(c.reading_anchor == initial_anchor, "preference pages preserved reading position");

    let state_path = scratch + "/reader-compact-settings.json";
    fs_write(state_path, json_stringify(done));
    assert(json_parse(fs_read(state_path)).url == "pb://guide", "probe state roundtrip");
    c.session.close();

    return map{
        result: "pass",
        passed: true,
        observations: observations,
        device_access: false
    };
}

fn main() {
    let cli = _parse_cli();
    let scratch = "/tmp/pblang_tooling_s3_compact_settings_" + str(num_floor(now_ms()));
    fs_mkdirs(scratch);
    let result = try _run(scratch) catch nil;
    let ok = result != nil;

    if ok and cli.evidence != nil {
        fs_mkdirs(cli.evidence);
        fs_write(cli.evidence + "/acceptance.json", json_stringify(result) + "\n");
    }
    if ok and cli.report != nil {
        fs_mkdirs(path_dirname(cli.report));
        fs_write(cli.report, json_stringify(result) + "\n");
    }
    let _cleaned = _rm_tree(scratch);
    assert(not fs_exists(scratch), "disposable scratch cleaned");
    assert(ok, "reader_compact_settings_native verification failed");
    print json_stringify(result);
}

main();
