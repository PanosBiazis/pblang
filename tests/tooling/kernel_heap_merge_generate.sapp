// Generate reproducible QEMU-only heap checks. Does not compile or execute them.
let C=import("stdlib:compiler/ctranspile.sapp");
let a=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");
assert(len(a)==2,"expected fixture|merge|fragmented|rooted|mixed and output prefix");
let choices=map{fixture:"examples/kernel_heap_merge.sapp",merge:"bench/kernel_heap_merge.sapp",
    fragmented:"bench/kernel_heap_fragmented.sapp",rooted:"bench/kernel_gc_collect.sapp",mixed:"bench/kernel_gc_mixed_sweep.sapp"};
assert(map_has(choices,a[0]),"unknown heap-check workload");
let fixture=fs_read(choices[a[0]]);
if a[0]=="rooted" {
    assert(str_contains(fixture,"i < 50000 {") and str_contains(fixture,"!= 50000 {"),"rooted workload changed; review iteration contract");
    fixture=str_replace_all(fixture,"i < 50000 {","i < 500000 {");
    fixture=str_replace_all(fixture,"!= 50000 {","!= 500000 {");
}
let source=fs_read("stdlib/kernel/heap.sapp")+fs_read("stdlib/kernel/gc.sapp")+fs_read("stdlib/kernel/interrupts.sapp")+fs_read("stdlib/kernel/timer.sapp")+fixture;
fs_write(a[1]+".c",C.transpile_kernel_int(source));
fs_write(a[1]+".ld",str_replace_all(C.kernel_linker_script(),".bss :",".bss ALIGN(4096) :"));
print "kernel heap check generated; execute only in a disposable emulator";
