// Pure PBLang headless verification for native keyboard boundary cases
// (slow, rapid, overlap, and UTF-8 Greek committed text + save/reopen parity).
// Never opens an X11 window on the user's desktop.

let GUI = import("stdlib:gui.sapp");
let X11_INPUT = import("stdlib:x11_input.sapp");
let SECURE_FILE = import("stdlib:secure_file.sapp");

fn _parse_cli() {
    let args = os_args();
    let cfg = map{
        runtime_path: cwd() + "/pblang",
        evidence_dir: "",
        standalone: true
    };
    let n = len(args);
    let i = 0;
    while i < n {
        let a = args[i];
        if a == "--runtime" and i + 1 < n {
            cfg["runtime_path"] = args[i + 1];
            i = i + 2;
        } elif a == "--evidence" and i + 1 < n {
            cfg["evidence_dir"] = args[i + 1];
            cfg["standalone"] = false;
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return cfg;
}

fn _rm_rf(path) {
    if not fs_exists(path) {
        return 0;
    }
    let entries = try fs_listdir(path) catch nil;
    if type(entries) == "array" {
        for name in entries {
            if name != "." and name != ".." {
                _rm_rf(path + "/" + name);
            }
        }
    }
    let _removed = try fs_remove(path) catch nil;
    return 0;
}

fn _write_checked(path, content) {
    fs_write(path, content);
    return fs_exists(path);
}

fn _read_checked(path, max_bytes) {
    let raw = fs_read(path);
    assert(len(raw) <= max_bytes, "bounded read exceeded max_bytes");
    return raw;
}

fn _new_boundary_form() {
    let f = GUI.form("PBLang Input Boundary", 640, 220);
    GUI.add(f, GUI.textbox("entry", 20, 60, 590, 36, ""));
    f.focus = "entry";
    return f;
}

fn _verify_x11_input_plans() {
    let tp_ascii = X11_INPUT.text_plan("abc");
    assert(tp_ascii.ok == true and tp_ascii.text == "abc", "text_plan ascii ok");
    assert(len(tp_ascii.strokes) == 3 and tp_ascii.strokes[0].keysym == "a", "text_plan ascii strokes");

    let tp_greek = X11_INPUT.text_plan("αβ");
    assert(tp_greek.ok == true and len(tp_greek.strokes) == 2, "text_plan greek ok");
    assert(str_lower(tp_greek.strokes[0].keysym) == "u03b1", "text_plan greek U03B1 keysym");

    let cp = X11_INPUT.compose_plan("aα");
    assert(cp.ok == true and cp.format == "pblang.x11.unicode-compose.v1", "compose_plan format");
    assert(len(cp.sequences) == 2, "compose_plan sequence length");
    assert(cp.sequences[0].mode == "direct", "compose_plan ascii direct");
    assert(cp.sequences[1].mode == "linux-unicode-compose" and cp.sequences[1].hex == "3b1", "compose_plan greek compose");

    let caps = X11_INPUT.capabilities();
    assert(caps.external_xdotool_required == false and caps.text_ascii == true, "x11_input capabilities");
    return true;
}

fn _verify_committed_text_guards() {
    let f = _new_boundary_form();
    // Control character (< 32) in committed text must be ignored, NOT reinterpreted as physical key "A"
    GUI.handle_event(f, map{type: "keydown", key: "A", text: "\n"});
    GUI.handle_event(f, map{type: "keyup", key: "A"});
    assert(GUI.get(f, "entry").value == "", "control char in committed text suppressed");

    // Empty committed text suppresses physical key translation (dead-key / compose pre-commit)
    GUI.handle_event(f, map{type: "keydown", key: "B", text: ""});
    GUI.handle_event(f, map{type: "keyup", key: "B"});
    assert(GUI.get(f, "entry").value == "", "empty committed text suppresses physical key");

    // Oversized (> 256 scalars) committed text is rejected cleanly
    let huge = "";
    for _idx 260 {
        huge = huge + "z";
    }
    GUI.handle_event(f, map{type: "keydown", key: "Z", text: huge});
    GUI.handle_event(f, map{type: "keyup", key: "Z"});
    assert(GUI.get(f, "entry").value == "", "oversized committed text rejected");
    return true;
}

fn _deliver_case_events(f, case_name) {
    let delivered = 0;
    if case_name == "slow" {
        for ch in ["a", "b", "c"] {
            let key_up = str_upper(ch);
            GUI.handle_event(f, map{type: "keydown", key: key_up, text: ch, shift: false, ctrl: false, alt: false, meta: false});
            GUI.handle_event(f, map{type: "keyup", key: key_up, shift: false, ctrl: false, alt: false, meta: false});
            delivered = delivered + 2;
        }
    } elif case_name == "rapid" {
        for ch in ["a", "b", "c", "d", "e", "f"] {
            let key_up = str_upper(ch);
            GUI.handle_event(f, map{type: "keydown", key: key_up, text: ch, shift: false, ctrl: false, alt: false, meta: false});
            GUI.handle_event(f, map{type: "keyup", key: key_up, shift: false, ctrl: false, alt: false, meta: false});
            delivered = delivered + 2;
        }
    } elif case_name == "overlap" {
        // Press 'b', then press 'a' while 'b' is still held, then release 'b', then release 'a'
        GUI.handle_event(f, map{type: "keydown", key: "B", text: "b", shift: false, ctrl: false, alt: false, meta: false});
        GUI.handle_event(f, map{type: "keydown", key: "A", text: "a", shift: false, ctrl: false, alt: false, meta: false});
        GUI.handle_event(f, map{type: "keyup", key: "B", shift: false, ctrl: false, alt: false, meta: false});
        GUI.handle_event(f, map{type: "keyup", key: "A", shift: false, ctrl: false, alt: false, meta: false});
        delivered = 4;
    } elif case_name == "greek" {
        GUI.handle_event(f, map{type: "keydown", key: "Greek_alpha", text: "α", shift: false, ctrl: false, alt: false, meta: false});
        GUI.handle_event(f, map{type: "keyup", key: "Greek_alpha", shift: false, ctrl: false, alt: false, meta: false});
        GUI.handle_event(f, map{type: "keydown", key: "Greek_beta", text: "β", shift: false, ctrl: false, alt: false, meta: false});
        GUI.handle_event(f, map{type: "keyup", key: "Greek_beta", shift: false, ctrl: false, alt: false, meta: false});
        delivered = 4;
    } else {
        throw "unknown boundary case: " + case_name;
    }
    return delivered;
}

fn _deliver_legacy_ascii_parity(case_name, expected) {
    if case_name == "greek" {
        return true;
    }
    let f = _new_boundary_form();
    if case_name == "slow" {
        for k in ["A", "B", "C"] {
            GUI.handle_event(f, map{type: "keydown", key: k});
            GUI.handle_event(f, map{type: "keyup", key: k});
        }
    } elif case_name == "rapid" {
        for k in ["A", "B", "C", "D", "E", "F"] {
            GUI.handle_event(f, map{type: "keydown", key: k});
            GUI.handle_event(f, map{type: "keyup", key: k});
        }
    } elif case_name == "overlap" {
        GUI.handle_event(f, map{type: "keydown", key: "B"});
        GUI.handle_event(f, map{type: "keydown", key: "A"});
        GUI.handle_event(f, map{type: "keyup", key: "B"});
        GUI.handle_event(f, map{type: "keyup", key: "A"});
    }
    assert(GUI.get(f, "entry").value == expected, "legacy keymap parity for " + case_name);
    return true;
}

fn _run_suite(evidence_dir, scratch_dir) {
    _verify_x11_input_plans();
    _verify_committed_text_guards();

    let cases = [
        map{name: "slow", keys: ["a", "b", "c"], hold_ms: 120, expected: "abc"},
        map{name: "rapid", keys: ["a", "b", "c", "d", "e", "f"], hold_ms: 1, expected: "abcdef"},
        map{name: "overlap", keys: ["b", "a"], hold_ms: 120, expected: "ba"},
        map{name: "greek", keys: ["U03b1", "U03b2"], hold_ms: 180, expected: "αβ"}
    ];

    fs_mkdirs(evidence_dir);
    fs_mkdirs(scratch_dir);

    let results = [];
    for spec in cases {
        let name = spec.name;
        let f = _new_boundary_form();
        let events_seen = _deliver_case_events(f, name);
        let actual = GUI.get(f, "entry").value;
        assert(actual == spec.expected, "boundary case " + name + " expected " + spec.expected + " got " + actual);
        assert(len(map_keys(f.pressed_keys)) == 0, "pressed_keys cleared after keyup in " + name);

        _deliver_legacy_ascii_parity(name, spec.expected);

        let case_tmp = scratch_dir + "/" + name;
        fs_mkdirs(case_tmp);
        let saved_path = case_tmp + "/synthetic.txt";
        assert(_write_checked(saved_path, actual), "save " + name);
        let reopened = _read_checked(saved_path, 4096);
        assert(reopened == actual and actual == spec.expected, "save/reopen exact for " + name);

        let detail = map{
            case: name,
            injected: spec.keys,
            expected: spec.expected,
            value: actual,
            reopened: reopened,
            exact: actual == spec.expected,
            save_reopen_exact: reopened == actual,
            hold_ms: spec.hold_ms,
            events: events_seen,
            headless: true
        };
        assert(_write_checked(evidence_dir + "/" + name + ".json", json_stringify(detail) + "\n"), "write case evidence " + name);

        push(results, map{
            case: name,
            expected: spec.expected,
            value: actual,
            exact: true,
            save_reopen_exact: true,
            hold_ms: spec.hold_ms
        });
    }

    let summary_path = evidence_dir + "/summary.json";
    assert(_write_checked(summary_path, json_stringify(results) + "\n"), "write summary.json");
    let parsed_summary = json_parse(_read_checked(summary_path, 65536));
    assert(len(parsed_summary) == 4, "summary.json has all 4 cases");
    return results;
}

fn main() {
    let cfg = _parse_cli();
    assert(fs_exists(cwd() + "/tests/fixtures/native_keyboard_boundary.sapp"), "boundary fixture exists");
    let base_tmp = "/tmp/pblang_tooling_s2_kbd_boundary_" + str(now_ms());
    let created_tmp = SECURE_FILE.create_private_temporary_directory_new(base_tmp);
    assert(created_tmp.ok == true, "private temp dir created");
    let evidence_dir = cfg.evidence_dir;
    if evidence_dir == "" {
        evidence_dir = base_tmp + "/evidence";
    }
    let scratch_dir = base_tmp + "/scratch";

    let results = [];
    let err_msg = "";
    try {
        results = _run_suite(evidence_dir, scratch_dir);
    } catch e {
        err_msg = str(e);
    }

    _rm_rf(base_tmp);
    if err_msg != "" {
        throw err_msg;
    }

    print json_stringify(map{
        passed: true,
        cases_verified: len(results),
        results: results
    });
    return 0;
}

main();
