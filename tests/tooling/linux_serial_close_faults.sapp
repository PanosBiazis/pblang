// Run the actual PBLang serial close body (stdlib/linux_serial.sapp) with
// synthetic FFI primitives only — no serial device, PTY, or native library opened.

let SECURE = import("stdlib:secure_file.sapp");

let FIXTURE_TAIL = "\n"
    + "let fault = map{modem:0,termios:0,calls:[]};\n"
    + "fn fake_ffi_call_typed(lib,name,signature,args) {\n"
    + "    let _l = lib; let _s = signature; let _a = args;\n"
    + "    array_push(fault.calls,name);\n"
    + "    if name==\"calloc\" { return 300; }\n"
    + "    if name==\"ioctl\" {\n"
    + "        if fault.modem==2 { throw \"synthetic modem failure\"; }\n"
    + "        return if fault.modem==1 {-1} else {0};\n"
    + "    }\n"
    + "    if name==\"tcsetattr\" {\n"
    + "        if fault.termios==2 { throw \"synthetic termios failure\"; }\n"
    + "        return if fault.termios==1 {-1} else {0};\n"
    + "    }\n"
    + "    return 0;\n"
    + "}\n"
    + "fn fake_ffi_close(lib) { let _l = lib; array_push(fault.calls,\"ffi_close\"); return nil; }\n"
    + "fn expect(value,label){ if not value { throw \"serial close fixture: \" + label; } }\n"
    + "fn fresh(){ return map{format:FORMAT,libc:10,crypto:20,fd:123,closed:false,\n"
    + "    original:100,working:200,configured:true,original_modem:3,modem_captured:true}; }\n"
    + "fn reset(modem,termios){ fault.modem=modem; fault.termios=termios; fault.calls=[]; }\n"
    + "let both=[\"calloc\",\"memset\",\"memset\",\"memset\",\"memset\",\"ioctl\",\"free\",\n"
    + "    \"tcsetattr\",\"close\",\"free\",\"free\",\"ffi_close\",\"ffi_close\"];\n"
    + "let cases=0;\n"
    + "for m 3 { for t 3 {\n"
    + "    reset(m,t); let state=fresh(); let result=close(state);\n"
    + "    expect(result.ok==(m==0 and t==0),\"combined restoration result \"+str(m)+\"/\"+str(t));\n"
    + "    expect(result.termios_restored==result.ok,\"legacy result fields agree\");\n"
    + "    expect(fault.calls==both,\"all cleanup attempted after restoration failure\");\n"
    + "    expect(state.closed and state.fd==-1 and state.original==0 and state.working==0,\n"
    + "        \"terminal released state\");\n"
    + "    let again=close(state);\n"
    + "    expect(again.ok and fault.calls==both,\"repeat close does not repeat effects\");\n"
    + "    cases=cases+1;\n"
    + "}}\n"
    + "for captured 2 { for configured 2 {\n"
    + "    reset(1,1); let state=fresh(); state.modem_captured=captured==1;\n"
    + "    state.configured=configured==1; let result=close(state);\n"
    + "    expect(result.ok==(captured==0 and configured==0),\"only required restoration contributes\");\n"
    + "    let expected=[];\n"
    + "    if captured==1 { expected=[\"calloc\",\"memset\",\"memset\",\"memset\",\"memset\",\"ioctl\",\"free\"]; }\n"
    + "    if configured==1 { array_push(expected,\"tcsetattr\"); }\n"
    + "    for name in [\"close\",\"free\",\"free\",\"ffi_close\",\"ffi_close\"] { array_push(expected,name); }\n"
    + "    expect(fault.calls==expected,\"configuration-dependent cleanup order\"); cases=cases+1;\n"
    + "}}\n"
    + "reset(1,1); let unopened=fresh(); unopened.fd=-1;\n"
    + "expect(close(unopened).ok,\"no restoration without open descriptor\");\n"
    + "expect(fault.calls==[\"free\",\"free\",\"ffi_close\",\"ffi_close\"],\"unopened cleanup\"); cases=cases+1;\n"
    + "reset(1,0); let no_original=fresh(); no_original.original=0;\n"
    + "expect(not close(no_original).ok,\"modem failure retained without termios snapshot\");\n"
    + "expect(fault.calls==[\"calloc\",\"memset\",\"memset\",\"memset\",\"memset\",\"ioctl\",\"free\",\n"
    + "    \"close\",\"free\",\"ffi_close\",\"ffi_close\"],\"missing original cleanup\"); cases=cases+1;\n"
    + "reset(0,0); expect(close(nil).ok and len(fault.calls)==0,\"nil remains harmless\"); cases=cases+1;\n"
    + "print \"linux_serial_close_faults_pass \"+str(cases);\n";

fn _rm_tree(path) {
    let entries = try fs_listdir(path) catch nil;
    if entries != nil {
        let i = 0;
        while i < len(entries) {
            _rm_tree(path + "/" + entries[i]);
            i = i + 1;
        }
    }
    let _r = try fs_remove(path) catch false;
}

fn main() {
    let raw_args = os_args();
    let runtime_arg = "";
    let source_arg = "";
    let report_arg = "";
    let i = 0;
    while i < len(raw_args) {
        let a = raw_args[i];
        if a == "--runtime" and i + 1 < len(raw_args) {
            runtime_arg = raw_args[i + 1];
            i = i + 1;
        } elif a == "--source" and i + 1 < len(raw_args) {
            source_arg = raw_args[i + 1];
            i = i + 1;
        } elif a == "--report" and i + 1 < len(raw_args) {
            report_arg = raw_args[i + 1];
            i = i + 1;
        }
        i = i + 1;
    }

    let repo_root = cwd();
    let runtime_bin = if runtime_arg != "" { runtime_arg } else { repo_root + "/pblang" };
    let source_path = if source_arg != "" { source_arg } else { repo_root + "/stdlib/linux_serial.sapp" };
    assert(fs_exists(runtime_bin), "linux_serial_close_faults: runtime binary missing");
    assert(fs_exists(source_path), "linux_serial_close_faults: linux_serial.sapp missing");

    let source = fs_read(source_path);
    assert(str_contains(source, "fn close(state)"), "linux_serial.sapp must define fn close(state)");
    assert(not str_contains(source, "fake_ffi_"), "linux_serial.sapp must not contain fake_ffi_ hooks");

    let stdlib_dir = repo_root + "/stdlib";
    let transformed = str_replace_all(source, "ffi_call_typed(", "fake_ffi_call_typed(");
    transformed = str_replace_all(transformed, "ffi_close(", "fake_ffi_close(");
    transformed = str_replace_all(transformed, "import(\"stdlib:", "import(\"" + stdlib_dir + "/");
    transformed = str_replace_all(transformed, "import(\"stdlib/", "import(\"" + stdlib_dir + "/");

    let scratch = "/tmp/pblang_tooling_s1_serial_close_" + str(num_floor(now_ms()));
    assert(SECURE.create_private_temporary_directory_new(scratch).ok, "create private scratch");

    let fixture_path = scratch + "/close_faults.sapp";
    fs_write(fixture_path, transformed + FIXTURE_TAIL);

    let proc = proc_spawn_wait(runtime_bin, [
        "run", fixture_path,
        "--deny-ffi", "--deny-exec", "--deny-spawn", "--deny-net",
        "--deny-http", "--deny-env", "--deny-gfx", "--deny-sqlite"
    ]);

    _rm_tree(scratch);
    assert(not fs_exists(scratch), "linux_serial_close_faults scratch cleaned up");

    let ok = proc.exit_code == 0 and str_contains(proc.stdout, "linux_serial_close_faults_pass 16");
    if not ok {
        print "SERIAL_CLOSE_FAIL: exit=" + str(proc.exit_code) + " stderr=" + proc.stderr + " stdout=" + proc.stdout;
    }

    if report_arg != "" {
        let pdir = path_dirname(report_arg);
        if pdir != "" and pdir != "." { fs_mkdirs(pdir); }
        fs_write(report_arg, json_stringify(map{
            passed: ok,
            exit: proc.exit_code,
            stdout: proc.stdout,
            stderr: proc.stderr
        }) + "\n");
    }

    assert(ok, "serial close fault matrix failed");
    print str_trim(proc.stdout);
}

main();
