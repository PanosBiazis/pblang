// Headless GUI.run window-option forwarding and input-order validation check
// for stdlib/gui.sapp in pure PBLang.

let SECURE = import("stdlib:secure_file.sapp");

let MOCK_SRC = "let calls=map{windows:[],runs:[]};\n"
    + "fn rgb(r,g,b) {return [r,g,b];}\n"
    + "fn Window(w,h,title,options=nil) {\n"
    + "    let win=map{tag:\"fake-window\"};\n"
    + "    array_push(calls.windows,map{w:w,h:h,title:title,options:options,window:win});return win;\n"
    + "}\n"
    + "fn run(win,state,update,draw,fps) {\n"
    + "    array_push(calls.runs,map{window:win,state:state,update:update,draw:draw,fps:fps});\n"
    + "}\n"
    + "export rgb,Window,run,calls;\n";

fn _build_fixture(gui_path, mock_path) {
    return "let GUI=import(" + json_stringify(gui_path) + ");\n"
        + "let Mock=import(" + json_stringify(mock_path) + ");\n"
        + "let checks=0;\n"
        + "fn check(ok,message) {assert(ok,message);checks=checks+1;}\n"
        + "fn probe(mode,options=nil) {\n"
        + "    let f=GUI.form(\"Forwarding contract\",800,600);\n"
        + "    let layouts=map{count:0};\n"
        + "    GUI.set_layout(f,fn(current,profile){let _c=current;let _p=profile;layouts.count=layouts.count+1;});\n"
        + "    let index=len(Mock.calls.windows);\n"
        + "    let result=if mode==\"omitted\" {GUI.run(f)} else {GUI.run(f,options)};\n"
        + "    check(result==0,\"GUI.run return value\");\n"
        + "    check(layouts.count==1,\"relayout occurs once\");\n"
        + "    check(len(Mock.calls.windows)==index+1,\"one constructor call\");\n"
        + "    check(len(Mock.calls.runs)==index+1,\"one event loop call\");\n"
        + "    let made=Mock.calls.windows[index];let loop=Mock.calls.runs[index];\n"
        + "    check(made.w==800 and made.h==600 and made.title==\"Forwarding contract\",\"constructor dimensions and title\");\n"
        + "    check(loop.fps==30 and loop.state.title==f.title and loop.window.tag==\"fake-window\",\"event loop contract\");\n"
        + "    let ut=type(loop.update);let dt=type(loop.draw);\n"
        + "    check((ut==\"closure\" or ut==\"fn\" or ut==\"function\") and (dt==\"closure\" or dt==\"fn\" or dt==\"function\"),\"callbacks passed\");\n"
        + "    if options==nil {check(made.options==nil,\"nil remains nil\");}\n"
        + "    else {check(made.options.ordered_input==options.ordered_input,\"ordered input forwarded exactly\");}\n"
        + "}\n"
        + "probe(\"omitted\");probe(\"explicit\",nil);\n"
        + "for flag in [true,false] {\n"
        + "    let opts=map{ordered_input:flag,sentinel:\"untouched\"};\n"
        + "    probe(\"explicit\",opts);\n"
        + "    check(len(map_keys(opts))==2 and opts.ordered_input==flag and opts.sentinel==\"untouched\",\"caller options unchanged\");\n"
        + "}\n"
        + "let empty=map{};\n"
        + "let f=GUI.form(\"Empty\",800,600);GUI.run(f,empty);\n"
        + "check(len(map_keys(empty))==0 and len(map_keys(Mock.calls.windows[4].options))==0,\"empty map accepted unchanged\");\n"
        + "let bad_opts: any = [true,false,7,\"yes\",[]];\n"
        + "for bad in bad_opts {\n"
        + "    let form=GUI.form(\"Invalid\",800,600);let changed=map{count:0};\n"
        + "    GUI.set_layout(form,fn(current,profile){let _c=current;let _p=profile;changed.count=changed.count+1;});\n"
        + "    let before=len(Mock.calls.windows);let call_bad=fn(){GUI.run(form,bad);return false;};let caught=try call_bad() catch true;\n"
        + "    check(caught,\"invalid options rejected\");\n"
        + "    check(changed.count==0 and len(Mock.calls.windows)==before,\"invalid options rejected before relayout/window\");\n"
        + "}\n"
        + "let bad_fields: any = [nil,0,1,\"true\",[],map{}];\n"
        + "for bad in bad_fields {\n"
        + "    let form=GUI.form(\"Invalid field\",800,600);let changed=map{count:0};\n"
        + "    GUI.set_layout(form,fn(current,profile){let _c=current;let _p=profile;changed.count=changed.count+1;});\n"
        + "    let before=len(Mock.calls.windows);let opts=map{ordered_input:bad};\n"
        + "    let call_bf=fn(){GUI.run(form,opts);return false;};let caught=try call_bf() catch true;\n"
        + "    check(caught,\"invalid field rejected\");\n"
        + "    check(changed.count==0 and len(Mock.calls.windows)==before,\"invalid field rejected before relayout/window\");\n"
        + "    check(len(map_keys(opts))==1,\"invalid caller map unchanged\");\n"
        + "}\n"
        + "print \"gui_window_options_pass:\"+str(checks);\n";
}

fn _rm_tree(path) {
    let entries = try fs_listdir(path) catch nil;
    if entries != nil {
        let i = 0;
        while i < len(entries) {
            _rm_tree(path + "/" + entries[i]);
            i = i + 1;
        }
    }
    let _r = try fs_remove(path) catch false;
}

fn _count_occurrences(haystack, needle) {
    let parts = str_split(haystack, needle);
    return len(parts) - 1;
}

fn main() {
    let raw_args = os_args();
    let runtime_arg = "";
    let evidence_arg = "";
    let gui_src_arg = "";
    let report_arg = "";
    let idx = 0;
    while idx < len(raw_args) {
        let a = raw_args[idx];
        if a == "--runtime" and idx + 1 < len(raw_args) {
            runtime_arg = raw_args[idx + 1];
            idx = idx + 1;
        } elif a == "--evidence" and idx + 1 < len(raw_args) {
            evidence_arg = raw_args[idx + 1];
            idx = idx + 1;
        } elif a == "--gui-source" and idx + 1 < len(raw_args) {
            gui_src_arg = raw_args[idx + 1];
            idx = idx + 1;
        } elif a == "--report" and idx + 1 < len(raw_args) {
            report_arg = raw_args[idx + 1];
            idx = idx + 1;
        }
        idx = idx + 1;
    }

    let repo_root = cwd();
    let runtime_bin = if runtime_arg != "" { runtime_arg } else { repo_root + "/pblang" };
    assert(fs_exists(runtime_bin), "gui_window_options_check: runtime binary missing");
    let gui_source = if gui_src_arg != "" { gui_src_arg } else { repo_root + "/stdlib/gui.sapp" };
    assert(fs_exists(gui_source), "gui_window_options_check: gui.sapp source missing");

    let text = fs_read(gui_source);
    let old_import = "let gfx  = import(\"stdlib/graphics.sapp\");";
    assert(_count_occurrences(text, old_import) == 1, "expected exactly one original graphics import; source not transformed");

    let keep_evidence = evidence_arg != "";
    let out_dir = if keep_evidence {
        evidence_arg
    } else {
        "/tmp/pblang_tooling_s1_gui_opts_" + str(num_floor(now_ms()))
    };
    if keep_evidence {
        fs_mkdirs(out_dir);
    } else {
        assert(SECURE.create_private_temporary_directory_new(out_dir).ok, "create private scratch");
    }

    let stage = out_dir + "/stage";
    fs_mkdirs(stage);
    let mock_path = stage + "/window_options_mock.sapp";
    let gui_stage = stage + "/gui.sapp";
    let check_path = stage + "/check.sapp";

    let stdlib_dir = repo_root + "/stdlib";
    let transformed = str_replace_all(text, old_import, "let gfx  = import(" + json_stringify(mock_path) + ");");
    transformed = str_replace_all(transformed, "import(\"stdlib/", "import(\"" + stdlib_dir + "/");
    transformed = str_replace_all(transformed, "import(\"stdlib:", "import(\"" + stdlib_dir + "/");

    fs_write(mock_path, MOCK_SRC);
    fs_write(gui_stage, transformed);
    let fixture_src = _build_fixture(gui_stage, mock_path);
    fs_write(check_path, fixture_src);

    let t0 = now_ms();
    let proc = proc_spawn_wait(runtime_bin, [
        "run",
        "--deny-exec", "--deny-net", "--deny-http", "--deny-spawn", "--deny-gfx", "--deny-sqlite",
        check_path
    ]);
    let elapsed_s = (now_ms() - t0) / 1000.0;

    let passed = proc.exit_code == 0 and proc.stderr == "" and proc.stdout == "gui_window_options_pass:63\n";
    let report = map{
        source_sha256: sha256(text),
        transformed_sha256: sha256(transformed),
        fixture_sha256: sha256(fixture_src),
        import_replacements: 1,
        scope: "headless forwarding; not native input acceptance",
        check: map{
            exit: proc.exit_code,
            seconds: elapsed_s,
            stdout: proc.stdout,
            stderr: proc.stderr
        },
        passed: passed
    };

    if keep_evidence {
        fs_write(out_dir + "/report.json", json_stringify(report) + "\n");
    }
    if report_arg != "" {
        let pdir = path_dirname(report_arg);
        if pdir != "" and pdir != "." { fs_mkdirs(pdir); }
        fs_write(report_arg, json_stringify(report) + "\n");
    }

    if not keep_evidence {
        _rm_tree(out_dir);
        assert(not fs_exists(out_dir), "gui_window_options_check scratch removed");
    }

    if not passed {
        print "GUI_WINDOW_OPTIONS_FAIL: exit=" + str(proc.exit_code) + " stderr=" + proc.stderr + " stdout=" + proc.stdout;
    }
    assert(passed, "gui_window_options_check failed");
    print "gui_window_options_check_pass: checks=63";
}

main();
