// Generate a two-CPU QEMU fixture, not a host executable or general AP launcher.
let C=import("stdlib:compiler/ctranspile.sapp");
let emitted=C.transpile_kernel_int(fs_read("stdlib/kernel/heap.sapp")+fs_read("stdlib/kernel/gc.sapp")+fs_read("stdlib/kernel/interrupts.sapp")+fs_read("stdlib/kernel/timer.sapp")+fs_read("examples/kernel_gc_smp.sapp"));
let shim="\n/* QEMU fixture-only xAPIC/real-mode bootstrap. Never execute on the host. */\nstatic u32 fixture_cpu_id(void){u32 a=1,b,c,d;__asm__ volatile(\"cpuid\":\"+a\"(a),\"=b\"(b),\"=c\"(c),\"=d\"(d));return b>>24;}\nstatic u32 fixture_apic_base(void){u32 a=1,b,c,d;__asm__ volatile(\"cpuid\":\"+a\"(a),\"=b\"(b),\"=c\"(c),\"=d\"(d));if(!(d&512))return 0;u32 lo,hi;__asm__ volatile(\"rdmsr\":\"=a\"(lo),\"=d\"(hi):\"c\"(27));if(hi || !(lo&2048) || (lo&1024))return 0;return lo&0xfffff000u;}\nextern unsigned char fixture_ap_start[],fixture_ap_end[];\n__asm__(\n\".pushsection .text\\n.code16\\n\"\n\"fixture_ap_start:\\n cli\\n cld\\n xorw %ax,%ax\\n movw %ax,%ds\\n movw %ax,%es\\n movw %ax,%ss\\n\"\n\"lgdtw fixture_ap_gdtr-fixture_ap_start+0x8000\\n\"\n\"movl %cr0,%eax\\n orl $1,%eax\\n movl %eax,%cr0\\n\"\n\"ljmpl $8,$fixture_ap_pm-fixture_ap_start+0x8000\\n.code32\\n\"\n\"fixture_ap_pm:\\n movw $16,%ax\\n movw %ax,%ds\\n movw %ax,%es\\n movw %ax,%ss\\n movw %ax,%fs\\n movw %ax,%gs\\n\"\n\"movl 0x7ff0,%esp\\n xorl %ebp,%ebp\\n call *0x7ff4\\n 1: cli\\n hlt\\n jmp 1b\\n\"\n\".balign 8\\nfixture_ap_gdt:\\n.quad 0\\n.quad 0x00cf9a000000ffff\\n.quad 0x00cf92000000ffff\\n\"\n\"fixture_ap_gdtr:\\n.word 23\\n.long fixture_ap_gdt-fixture_ap_start+0x8000\\n\"\n\"fixture_ap_end:\\n.code32\\n.popsection\\n\");\nstatic u32 fixture_prepare_ap(u32 entry,u32 stack){u32 n=(u32)(fixture_ap_end-fixture_ap_start);if(!entry||!stack||n>4096)return 0;for(u32 i=0;i<n;i++)poke8(0x8000+i,fixture_ap_start[i]);poke32(0x7ff0,stack&~15u);poke32(0x7ff4,entry);__asm__ volatile(\"\":::\"memory\");return 1;}\n";
let output="";let inserted=false;
for line in str_split(emitted,"\n") {
    if line=="long _align8(long x);" {output=output+shim;inserted=true;}
    output=output+line+"\n";
}
assert(inserted,"SMP fixture: emitted boundary not found");
let destination=try env_get("PBLANG_SCRIPT_ARGS") catch "";
assert(destination!=nil and str_trim(destination)!="","destination C path required");
fs_write(str_split(destination,"\n")[0],output);
print "SMP fixture generated";
