let AI=import("stdlib/pbai.sapp");let N=import("stdlib:pbai_neural_adapter.sapp");
let bound=AI.neural_specialist_bind(N);
let expected=env_get("PBAI_TOOL_LIFETIME_PHASE")!="baseline";
let teacher=N.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let artifact=N.distill(teacher.artifact,[[0],[1,0]],[map{x:[7,0],y:4}]).checkpoint();
let encoded=N.student_encode(artifact);let active=N.student_load(artifact);
let original=active.predict([0]);let active_digest=active.checkpoint().digest;let rows=[];
let routes=[map{name:"direct",call:N.student_tool},map{name:"facade",call:AI.neural_specialist_student_tool},map{name:"bound",call:bound.student_tool}];
for route in routes {
 for mode in ["compact","verbose","throw_first","throw_second","nan_second","oversized_second","shape_second","recover"] {
  N.tool_probe_mode(mode);let count=N.tool_probe_count();
  let request=map{op:"predict_batch",checkpoint:artifact,contexts:[[0],[1,0]],include_logits:mode!="compact"};
  let before=json_stringify(request);let result=route.call(request);
  assert(N.tool_probe_count()==count+1,"one private model per admitted batch");
  let state=N.tool_probe_inspect(count);
  assert(state.close_calls==(if expected {1} else {0}) and state.predict_closed==expected
   and state.checkpoint_closed==expected and state.evaluate_closed==expected and state.compare_closed==expected
   and state.diagnostic_close_released!=expected,"private handle lifetime observed before diagnostic cleanup");
  assert(state.predictions==(if mode=="throw_first" {1} else {2}),"batch stops exactly at failing prediction");
  let ok=mode=="compact" or mode=="verbose" or mode=="recover";
  if ok {
   assert(result.status=="result" and result.error==nil and len(result.result.predictions)==2,"detached batch survives private close");
   for i in range(0,2) {
    let row=result.result.predictions[i];let oracle=active.predict(request.contexts[i]);
    assert(row.index==i and row.token==oracle.token,"ordered prediction oracle");
    if mode=="compact" {assert(len(row)==2,"compact output unchanged");}
    else {assert(json_stringify(row.logits)==json_stringify(oracle.logits),"detached logits unchanged after close");}
   }
  } else {
   assert(len(result)==4 and result.format=="pbai.neural.student-tool.v1" and result.status=="error"
    and result.result==nil and result.error=="computation_failed","fixed error with no partial batch");
  }
  assert(not str_contains(json_stringify(result),"synthetic private") and json_stringify(request)==before
   and N.student_encode(artifact)==encoded,"request/artifact unchanged and fault text private");
  assert(active.checkpoint().digest==active_digest and json_stringify(active.predict([0]))==json_stringify(original),"independent original active model retained");
  push(rows,map{route:route.name,mode:mode,status:result.status,lifetime:state});
 }
 let count=N.tool_probe_count();let invalid=route.call(map{op:"predict_batch",checkpoint:artifact,contexts:[[0],[]],include_logits:false});
 assert(invalid.error=="invalid_request" and invalid.result==nil and N.tool_probe_count()==count,"malformed later context rejected before acquisition");
}
assert(active.close(),"caller still owns active model close");let active_state=N.tool_probe_inspect(0);
assert(active_state.close_calls==1 and active_state.predict_closed and not active_state.diagnostic_close_released,"active closes only on explicit caller close");
print json_stringify(map{format:"pbai.student-tool.lifetime.v1",phase:if expected {"fixed"} else {"baseline"},
 cases:len(rows),invalid_before_acquisition:3,active_preserved:true,active_closed:true,rows:rows,physical_release_verified:false});
