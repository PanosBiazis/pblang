// Exercise the real review constructor; hooks only alter export/cleanup outcomes.
let AI=import("stdlib/pbai.sapp");let N=import("stdlib:pbai_neural_adapter.sapp");let bound=AI.neural_specialist_bind(N);
let teacher=N.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let seed=N.distill(teacher.artifact,[[0],[1,0]],[map{x:[7,0],y:4}]);let parent=seed.checkpoint();assert(seed.close(),"seed closes");
let history=N.student_history(parent,[map{x:[0],y:4},map{x:[1,0],y:4}],[map{x:[7,0],y:4}]);
let parent_text=N.student_encode(parent);let history_text=N.student_history_encode(parent,history);
let independent=N.student_load(parent);let independent_prediction=json_stringify(independent.predict([5,0]));
let fixed=env_get("PBAI_REVIEW_FAILURE_PHASE")!="baseline";
let routes=[map{name:"direct",run:N.student_continue_reviewed},map{name:"legacy",run:AI.neural_specialist_student_continue_reviewed},map{name:"binding",run:bound.student_continue_reviewed}];
fn exercise(run,mode){
 let label=4;let epochs=16;if mode=="rejected" {label=5;epochs=64;}
 let train=[map{x:[2,0],y:label},map{x:[3,0],y:label}];if mode=="preflight" {train=[map{x:[0],y:4}];}
 return run(parent,history,train,[map{x:[4,0],y:label}],map{epochs:epochs,lr:if label==5 {0.1} else {0.05},max_grad_norm:1});
}
let error_mode=env_get("PBAI_REVIEW_FAILURE_ERROR");let error_route=env_get("PBAI_REVIEW_FAILURE_ROUTE");
if error_mode!=nil and error_mode!="" {
 for route in routes {if route.name==error_route {
  N.export_probe_configure(error_mode);exercise(route.run,error_mode);throw "expected constructor failure";
 }}
 throw "select explicit error route";
}
let rows=[];let legacy=[];
for route in routes {for mode in ["success","rejected","export_throw","export_nil","cleanup_throw","cleanup_nil","cleanup_number","cleanup_false","both_throw","both_nil","cleanup_before","both_before","preflight"] {
 N.export_probe_configure(mode);let h=try exercise(route.run,mode) catch nil;
 let returned=h!=nil;let expected=mode=="success" or mode=="rejected" or mode=="cleanup_false";
 if not fixed and (mode=="cleanup_nil" or mode=="cleanup_number") {expected=true;}
 assert(returned==expected,"review return admission follows cleanup qualification");
 let observed=N.export_probe_observe();let count=if mode=="preflight" {0} else {1};assert(len(observed)==count,"constructor owns only acquired handle");
 let before_failure=mode=="cleanup_before" or mode=="both_before";
 for item in observed {
  assert(item.attempts==1 and item.exports==1,"one export and one cleanup attempt");
  assert(item.predict_blocked==not before_failure and item.export_blocked==not before_failure and item.evaluate_blocked==not before_failure,"real saved methods observed before diagnostic cleanup");
  assert(item.first_closes==if before_failure {0} else {1},"actual first close evidence");
 }
 let diagnostic=N.export_probe_diagnostic_close();assert(diagnostic==if before_failure {1} else {0},"unconfirmed handles require explicit test cleanup, never count as caller success");
 if returned {
  let value=map{report:h.report(),status:h.status(),checkpoint:h.checkpoint(),history:h.history(),prediction:h.predict([5,0])};
  if mode=="success" or mode=="rejected" or mode=="cleanup_false" {push(legacy,map{route:route.name,mode:mode,value:value});}
  assert(h.close(),"returned review has independent owned lifetime");
 }
 assert(json_stringify(independent.predict([5,0]))==independent_prediction,"independent model stays live");
 assert(N.student_encode(parent)==parent_text and N.student_history_encode(parent,history)==history_text,"parent and history unchanged");
 push(rows,map{route:route.name,mode:mode,returned:returned,handles:observed,diagnostic_closes:diagnostic});
}}
assert(independent.close(),"independent owner closes");
print json_stringify(map{format:"pbai.review-export-cleanup.v1",rows:rows,legacy:legacy,independent_preserved:true,parent_preserved:true});
