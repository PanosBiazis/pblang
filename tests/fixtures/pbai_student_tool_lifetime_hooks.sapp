// Private-copy lifecycle observer; original methods perform all model operations.
let tool_probe=map{mode:"active",items:[]};
fn _tool_probe_predict(item,ids){
 item.predictions=item.predictions+1;
 if (item.mode=="throw_first" and item.predictions==1) or (item.mode=="throw_second" and item.predictions==2) {
  throw "synthetic private prediction fault";
 }
 let result=item.predict(ids);
 if item.predictions==2 {
  if item.mode=="nan_second" {let zero=len([]);result.logits[0]=0/zero;}
  if item.mode=="oversized_second" {result.logits[0]=10000000000000;}
  if item.mode=="shape_second" {return nil;}
 }
 return result;
}
fn _tool_probe_wrap(handle,mode,artifact){
 let item=map{mode:mode,artifact:artifact,predict:handle.predict,checkpoint:handle.checkpoint,
  evaluate:handle.evaluate,compare:handle.compare,close:handle.close,predictions:0,closes:0};
 push(tool_probe.items,item);
 handle.predict=fn(ids){return _tool_probe_predict(item,ids);};
 handle.close=fn(){item.closes=item.closes+1;return item.close();};
 return handle;
}
fn tool_probe_mode(mode){tool_probe.mode=mode;}
fn tool_probe_count(){return len(tool_probe.items);}
fn tool_probe_inspect(index){
 let item=tool_probe.items[index];
 // Inspect original methods before cleanup. The diagnostic close cannot turn a
 // previously live handle into a passing observation.
 let predict_closed=try {item.predict([0]);false} catch true;
 let checkpoint_closed=try {item.checkpoint();false} catch true;
 let evaluate_closed=try {item.evaluate([map{x:[0],y:4}]);false} catch true;
 let compare_closed=try {item.compare(item.artifact,[map{x:[0],y:4}]);false} catch true;
 let again=item.close();
 return map{mode:item.mode,predictions:item.predictions,close_calls:item.closes,
  predict_closed:predict_closed,checkpoint_closed:checkpoint_closed,evaluate_closed:evaluate_closed,
  compare_closed:compare_closed,diagnostic_close_released:again,physical_release_verified:false};
}
export tool_probe_mode,tool_probe_count,tool_probe_inspect;
