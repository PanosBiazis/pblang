let App=import("../../examples/declarative_browser/app.sapp");let G=import("stdlib:graphics.sapp");let GUI=import("stdlib:gui.sapp");
let width=try parse_number(env_get("PBLANG_READER_WIDTH")) catch 800;
if width==nil {width=800;}assert(width==800 or width==390,"fixed probe dimensions");
let c=App.create();c.width=width;c.height=if width==390 {844} else {816};App.refresh(c);
let started=now_ms();let win=G.Window(c.width,c.height,"PBLang readable browser probe");
let cache_before=map{};
let fixed=win.textMeasure("iiii Wide words",18,12,"sans");let natural=win.textMeasure("iiii Wide words",18,0,"sans");
assert(fixed.ok and natural.ok and natural.width<fixed.width,"retained host actually uses natural advances");
G.run(win,c,fn(current,events){
    let changed=App.update(current,events);
    if now_ms()-started>24000 {current.graphics_stop=true;}
    return changed;
},fn(current,canvas){
    let begin=now_ms();GUI.draw(canvas,current.form);cache_before=canvas.textCacheStatus();
    let snapshot=current.session.snapshot();
    fs_write("build/reader-probe-"+str(width)+".json",json_stringify(map{url:snapshot.url,navigations:current.navigations,
        settings:current.settings,family:current.appearance.font_family,draw_ms:now_ms()-begin}));
},30);
let cleared=win.textCacheStatus();
assert(cleared.payload_bytes==0 and cache_before.payload_bytes<=cache_before.payload_limit,"bounded caches cleared on close");
assert((try win.textMeasure("closed",16,0,"sans") catch nil)==nil,"closed window cannot repopulate caches");
let snap=c.session.snapshot();let title=GUI.get(c.form,"page_title");
assert(snap.url=="pb://guide" and c.navigations==3,"keyboard link/back/forward journey");
assert(not c.settings and c.appearance.font_family=="serif","keyboard appearance editing and return");
assert(title.text_status.spacing=="natural" and title.text_status.requested_family=="serif","real native styled draw");
print json_stringify(map{url:snap.url,navigations:c.navigations,width:c.width,height:c.height,
    title:snap.document.form.title,typography:title.text_status,cache:cache_before,cache_after_close:cleared,fixed_width:fixed.width,natural_width:natural.width});
c.session.close();
