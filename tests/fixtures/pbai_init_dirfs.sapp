// Synthetic handles only; no operating-system descriptors are acquired.
let state=map{opens:0,closes:[],paths:[],fault_at:0,fault:"ok",cleanup:"ok",callback:nil};
fn configure(at=0,fault="ok",cleanup="ok",callback=nil) {
 state.opens=0;state.closes=[];state.paths=[];state.fault_at=at;
 state.fault=fault;state.cleanup=cleanup;state.callback=callback;
}
fn available() {return map{library_ready:true};}
fn open(root,a=false,b=false) {
 state.opens=state.opens+1;push(state.paths,root);
 if state.opens==1 and state.callback!=nil {state.callback();}
 if state.opens==state.fault_at {
  if state.fault=="throw" {throw "synthetic-private-acquisition";}
  if state.fault=="nil" {return nil;}
  if state.fault=="number" {return 1;}
  if state.fault=="unavailable" {return map{ok:false};}
 }
 return map{ok:true,id:state.opens};
}
fn open_absolute(root,a=false,b=false) {return open(root,a,b);}
fn close(handle) {
 push(state.closes,handle.id);
 if state.cleanup=="mixed" {
  if len(state.closes)==1 {return false;}
  if len(state.closes)==2 {throw "synthetic-private-cleanup";}
 }
 if len(state.closes)==1 {
  if state.cleanup=="false" {return false;}
  if state.cleanup=="throw" {throw "synthetic-private-cleanup";}
  if state.cleanup=="nil" {return nil;}
  if state.cleanup=="number" {return 1;}
  if state.cleanup=="string" {return "true";}
 }
 return true;
}
fn read_bytes_relative(handle,path,budget) {return map{ok:true,bytes:[1,2,3,4]};}
fn snapshot() {return map{opens:state.opens,closes:state.closes,paths:state.paths};}
export configure,available,open,open_absolute,close,read_bytes_relative,snapshot;
