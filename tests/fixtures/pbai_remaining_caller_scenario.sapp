// Test-only real caller body; the Python harness supplies its private directory.
fn _caller_workflow(){throw "test harness must supply the real caller";}
let N=import("stdlib:pbai_neural_adapter.sapp");
let target=env_get("PBAI_CALLER_TARGET");let setup=target=="checkpoint_reload_reviewed";
let fixed=env_get("PBAI_CALLER_LIFETIME_PHASE")!="baseline";
let directory=env_get("PBAI_CHECKPOINT_TEST_DIR");
let names=["student.json","better.json","worse.json"];
let teacher=N.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let seed=N.distill(teacher.artifact,[[0]],[map{x:[7,0],y:4}]);
let active=N.student_load(seed.checkpoint());assert(seed.close(),"independent seed cleanup");
let active_before=json_stringify(active.predict([6,0]));let rows=[];
let modes=if setup {["success","export_failure","save_failure","acquire_failure","success"]}
 else {["success","export_failure","review_export_failure","use_failure","loaded_use_failure","acquire_failure","loaded_acquire_failure","success"]};
for mode in modes {
 if setup {
  for name in names {let path=path_join(directory,name);if fs_exists(path) {fs_remove(path);}}
  // A real exclusive-create failure at the second file, never a mocked save.
  if mode=="save_failure" {fs_write(path_join(directory,"better.json"),"synthetic-existing-checkpoint");}
 }
 N.caller_probe_configure(mode,target);
 let succeeded=try {_caller_workflow();true} catch false;
 let observed=N.caller_probe_observe();let failed=mode!="success";
 assert(succeeded!=failed,"actual caller success/error preserved");
 assert(observed.injected==(failed and mode!="save_failure"),"requested injection reached");
 let closed=0;let live=0;
 for row in observed.rows {
  assert(row.predict_closed==row.checkpoint_closed,"saved original operations agree about lifetime");
  if row.predict_closed {closed=closed+1;} else {live=live+1;}
  if fixed {assert(row.first_closes==1 and row.predict_closed,"each acquired handle explicitly retired exactly once");}
 }
 assert(len(observed.rows)>0,"observer saw actual construction");
 if not fixed {assert(live>0,"baseline exposes omitted caller cleanup");}
 let files=[];
 if setup {
  for name in names {
   let path=path_join(directory,name);
   if fs_exists(path) {
    let text=fs_read(path);let sentinel=mode=="save_failure" and name=="better.json";
    if sentinel {assert(text=="synthetic-existing-checkpoint","existing destination unchanged");}
    else {assert(N.student_encode(N.student_decode(text))==text,"saved checkpoint encoding remains canonical");}
    push(files,map{name:name,bytes:len(str_to_bytes(text)),digest:sha256(text),existing:sentinel});
   }
  }
  let expected=0;
  if mode=="success" {expected=3;}
  if mode=="save_failure" {expected=2;}
  if mode=="acquire_failure" {expected=1;}
  assert(len(files)==expected,"partial explicit files preserved, no extra writes");
 }
 assert(json_stringify(active.predict([6,0]))==active_before,"independent active model preserved");
 push(rows,map{mode:mode,succeeded:succeeded,acquired:len(observed.rows),closed:closed,live:live,handles:observed.rows,files:files});
}
assert(active.close(),"independent owner cleanup");
print json_stringify(map{format:"pbai.caller-lifetime.v1",target:target,benchmark:false,phase:if fixed {"fixed"} else {"baseline"},
 cases:len(rows),rows:rows,active_preserved:true,physical_memory_release_verified:false});
