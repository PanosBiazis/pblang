// Fixed synthetic bytes; no OS descriptors, callbacks or network.
let large=[];let i=0;while i<64 {push(large,num_mod(i,4)+1);i=i+1;}
fn available() {return map{library_ready:true};}
fn open(root,a=false,b=false) {return map{ok:true};}
fn open_absolute(root,a=false,b=false) {return open(root,a,b);}
fn close(handle) {return true;}
fn read_bytes_relative(handle,path,budget) {if path=="large" {return map{ok:true,bytes:large};}return map{ok:true,bytes:[1,2,3,4]};}
export available,open,open_absolute,close,read_bytes_relative;
