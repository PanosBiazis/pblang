let Store=import("../../examples/declarative_browser/appearance_store.sapp");
let args=str_split(env_get("PBLANG_SCRIPT_ARGS"),"\n");let result=nil;
if args[0]=="load" {result=Store.load(args[1]);}
elif args[0]=="save" {result=Store.save(args[1],json_parse(args[2]),args[3]);}
elif args[0]=="parent" {result=Store.data_parent(args[1],args[2]);}
else {throw "Unknown test operation";}
print json_stringify(result);
