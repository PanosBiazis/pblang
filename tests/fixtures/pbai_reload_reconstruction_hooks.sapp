// Test-only factory. Inline this into a PRIVATE copied neural owner, never into
// a release. Returned handles are the real unmodified constructor's handles.
fn _reconstruction_blocked(predict){return try {predict([6,0]);false} catch true;}
fn _reconstruction_load(state,artifact){
 assert(state.calls<16,"bounded reconstruction fault fixture");state.calls=state.calls+1;
 let matches=type(artifact)=="map" and map_has(artifact,"digest") and artifact.digest==state.target;
 if matches {state.target_calls=state.target_calls+1;}
 let fail=matches and ((state.mode=="once" and state.target_calls==2)
  or (state.mode=="repeat" and (state.target_calls==2 or state.target_calls==4)));
 let event=map{call:state.calls,target:matches,target_call:if matches {state.target_calls} else {0},action:"loaded",prior_candidate_closed:false};
 if fail {
  let previous=state.handles[len(state.handles)-1];
  event.prior_candidate_closed=previous.target and _reconstruction_blocked(previous.predict);
  event.action="injected_failure";push(state.events,event);state.failures=state.failures+1;
  throw "synthetic private reconstruction failure";
 }
 let handle=state.load(artifact);
 push(state.handles,map{call:state.calls,target:matches,predict:handle.predict,close:handle.close});
 push(state.events,event);return handle;
}
fn _reconstruction_report(state){
 let closed=[];let all_closed=true;
 for item in state.handles {
  // Observe terminal state BEFORE the diagnostic repeated-close probe. If a
  // handle leaked, report failure even though the probe then cleans the fixture.
  let was_closed=_reconstruction_blocked(item.predict);let again=item.close();
  let repeated_false=type(again)=="bool" and not again;
  if not was_closed or not repeated_false {all_closed=false;}
  push(closed,map{call:item.call,target:item.target,closed_before_probe:was_closed,repeated_close_false:repeated_false});
 }
 return map{mode:state.mode,calls:state.calls,target_calls:state.target_calls,failures:state.failures,
  events:state.events,handles:closed,all_closed:all_closed};
}
fn reconstruction_fault_fixture(load,target,mode){
 assert(type(load)=="fn" or type(load)=="closure","trusted original constructor required");
 assert(type(target)=="string" and len(target)==64,"synthetic target digest required");
 assert(mode=="none" or mode=="once" or mode=="repeat","bounded fault mode required");
 let state=map{load:load,target:target,mode:mode,calls:0,target_calls:0,failures:0,events:[],handles:[]};
 return map{load:fn(artifact){return _reconstruction_load(state,artifact);},report:fn(){return _reconstruction_report(state);}};
}
export reconstruction_fault_fixture;
