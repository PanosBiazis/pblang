let View=import("../../examples/uno_r4_led_studio/view.sapp");let G=import("stdlib:graphics.sapp");
let app=View.create(390);let win=G.Window(app.form.w,app.form.h,"PBLang UNO R4 LED Studio test");let started=now_ms();
G.run(win,app,fn(current,events){
    let dirty=View.update(current,events);
    if now_ms()-started>14000 {current.graphics_stop=true;}
    return dirty;
},fn(current,canvas){
    View.draw(current,canvas);
    let state=current.state;
    fs_write("build/uno-r4-native-state.json",json_stringify(map{index:state.index,count:len(state.document.frames),playing:state.playing,pixel0:state.document.frames[state.index].pixels[0],pixel1:state.document.frames[state.index].pixels[1],text:state.text,status:state.status}));
},30);
assert(len(app.state.document.frames)==25 and not app.state.playing,"native text animation and stop");
print "uno_r4_native_pass";
