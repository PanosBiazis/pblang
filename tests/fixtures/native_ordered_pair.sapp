// Two equal public titles exercise per-window binding and keyboard isolation.
let G=import("stdlib:graphics.sapp");let GUI=import("stdlib:gui.sapp");let wait=channel();let forms=[];let windows=[];
for i in range(0,2) {
    let f=GUI.form("PBLang Input Pair",500,180);GUI.add(f,GUI.textbox("entry",20,60,460,36,""));f.focus="entry";f.text_render="auto";
    let w=G.Window(f.w,f.h,f.title,map{ordered_input:true});assert(w.input_backend=="x11-ordered-keysyms","owned pair queue attached");push(forms,f);push(windows,w);
}
let start=now_ms();
while now_ms()-start<5000 {
    for i in range(0,2) {
        for event in windows[i].pollEvents() {GUI.handle_event(forms[i],event);}
        if forms[i].dirty {GUI.draw(windows[i],forms[i]);}windows[i].present();
    }
    recv_timeout(wait.receiver,10);
}
let values=[];for i in range(0,2) {push(values,GUI.get(forms[i],"entry").value);windows[i].close();}
let path=env_get("PBLANG_INPUT_DIAG_OUT");let text=json_stringify(values);fs_write(path,text);assert(fs_read(path)==text,"pair exact save/readback");print text;
