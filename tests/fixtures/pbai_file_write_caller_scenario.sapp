// Run the real file example, inspecting original aliases before probe cleanup.
fn _caller_workflow(){throw "test harness must supply the real caller";}
let N=import("stdlib:pbai_neural_adapter.sapp");
let fixed=env_get("PBAI_CALLER_LIFETIME_PHASE")!="baseline";
let path=path_join(env_get("PBAI_CHECKPOINT_TEST_DIR"),"student.json");
let rows=[];
for mode in ["success","export_failure","save_failure","construction_failure","close_before","close_after","close_invalid","export_close_before","save_close_after","success"] {
 if fs_exists(path) {fs_remove(path);}
 let save_failure=mode=="save_failure" or mode=="save_close_after";
 if save_failure {fs_write(path,"synthetic-existing-checkpoint");}
 N.caller_probe_configure(mode,"checkpoint_file");
 let succeeded=try {_caller_workflow();true} catch false;
 let observed=N.caller_probe_observe();
 let body_failed=save_failure or mode=="construction_failure" or mode=="export_failure" or mode=="export_close_before";
 let close_failed=mode=="close_before" or mode=="close_after" or mode=="close_invalid";
 assert(succeeded==not (body_failed or (fixed and close_failed)),"workflow reports no false success: "+mode);
 let expected=if mode=="construction_failure" {0} else {1};
 assert(len(observed.rows)==expected,"real acquired handle count");
 let unconfirmed=mode=="close_before" or mode=="export_close_before";
 for row in observed.rows {
  assert(row.predict_closed==row.checkpoint_closed,"original aliases agree");
  assert(row.close_calls==if fixed {1} else {0},"exactly one registered cleanup attempt");
  assert(row.first_closes==if fixed and not unconfirmed {1} else {0},"first actual release count");
  assert(row.predict_closed==(fixed and not unconfirmed),"observe before diagnostic release");
 }
 let exists=fs_exists(path);let digest="";
 if exists {
  let text=fs_read(path);digest=sha256(text);
  if save_failure {assert(text=="synthetic-existing-checkpoint","exclusive save preserves existing bytes");}
  else {assert(N.student_encode(N.student_decode(text))==text,"canonical detached checkpoint survives close");}
 }
 assert(exists==(save_failure or not body_failed),"expected file effects only");
 push(rows,map{mode:mode,succeeded:succeeded,handles:observed.rows,file_exists:exists,file_digest:digest});
}
print json_stringify(map{format:"pbai.caller-lifetime.v1",target:"checkpoint_file",phase:if fixed {"fixed"} else {"baseline"},cases:len(rows),rows:rows,physical_memory_release_verified:false});
