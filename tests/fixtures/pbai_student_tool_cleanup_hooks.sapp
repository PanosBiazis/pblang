// Test-only wrappers around actual bundled model methods; no replacement math.
let cleanup_probe=map{mode:"active",items:[]};
fn _cleanup_predict(item,ids) {
 item.predictions=item.predictions+1;
 if (item.mode=="throw_first" and item.predictions==1)
  or ((item.mode=="both_throw" or item.mode=="both_before") and item.predictions==2) {
  throw "synthetic private prediction detail";
 }
 let value=item.predict(ids);
 if (item.mode=="nan_second" or item.mode=="both_nil") and item.predictions==2 {
  let zero=len([]);value.logits[0]=0/zero;
 }
 return value;
}
fn _cleanup_close(item) {
 item.closes=item.closes+1;
 if item.mode=="cleanup_before" or item.mode=="both_before" {throw "synthetic private cleanup detail";}
 let closed=item.close();
 if item.mode=="cleanup_throw" or item.mode=="both_throw" {throw "synthetic private cleanup detail";}
 if item.mode=="cleanup_nil" or item.mode=="both_nil" {return nil;}
 if item.mode=="cleanup_number" {return 1;}
 if item.mode=="cleanup_false" {return item.close();}
 return closed;
}
fn _cleanup_wrap(handle,artifact) {
 let item=map{mode:cleanup_probe.mode,artifact:artifact,predict:handle.predict,
  checkpoint:handle.checkpoint,evaluate:handle.evaluate,compare:handle.compare,close:handle.close,
  predictions:0,closes:0};
 push(cleanup_probe.items,item);
 handle.predict=fn(ids){return _cleanup_predict(item,ids);};
 handle.close=fn(){return _cleanup_close(item);};
 return handle;
}
fn cleanup_probe_mode(mode){cleanup_probe.mode=mode;}
fn cleanup_probe_count(){return len(cleanup_probe.items);}
fn cleanup_probe_inspect(index) {
 let item=cleanup_probe.items[index];
 // Observe all original methods before any diagnostic close can change state.
 let predicted=try {item.predict([0]);false} catch true;
 let checkpoint=try {item.checkpoint();false} catch true;
 let evaluated=try {item.evaluate([map{x:[0],y:4}]);false} catch true;
 let compared=try {item.compare(item.artifact,[map{x:[0],y:4}]);false} catch true;
 let diagnostic=item.close();
 return map{predictions:item.predictions,close_calls:item.closes,predict_closed:predicted,
  checkpoint_closed:checkpoint,evaluate_closed:evaluated,compare_closed:compared,
  diagnostic_close_released:diagnostic,physical_release_verified:false};
}
export cleanup_probe_mode,cleanup_probe_count,cleanup_probe_inspect;
