// Shared positive fixture for the retained host and PBLang tree interpreter.
fn missing() { throw "literal default fixture failed"; }
fn options(a = 7, b = "pb", c = true, d = nil, e = 9) {
    return [a, b, c, d, e];
}
let zero = options();
if zero[0] != 7 or zero[1] != "pb" or zero[2] != true or zero[3] != nil or zero[4] != 9 { missing(); }
let one = options(11);
if one[0] != 11 or one[1] != "pb" or one[4] != 9 { missing(); }
let two = options(11, "x");
if two[1] != "x" or two[2] != true or two[4] != 9 { missing(); }
let three = options(11, "x", false);
if three[2] != false or three[3] != nil or three[4] != 9 { missing(); }
let four = options(11, "x", false, 42);
if four[3] != 42 or four[4] != 9 { missing(); }
let all = options(nil, nil, nil, nil, nil);
for value in all { if value != nil { missing(); } }
fn increment(value = 5) { value = value + 1; return value; }
if increment() != 6 or increment() != 6 or increment(10) != 11 { missing(); }
fn add(a, b = 4) { return a + b; }
if add(3) != 7 or add(3, 8) != 11 { missing(); }
fn partial(a, b, c = 6) { return c; }
if partial(1, 2) != 6 { missing(); }
fn outer(seed) {
    fn inner(step = 2) { seed = seed + step; return seed; }
    return inner;
}
let counter = outer(10);
if counter() != 12 or counter(3) != 15 or counter() != 17 { missing(); }
let box = map{ call: options };
if box.call()[0] != 7 { missing(); }
let callbacks = [options];
if callbacks[0](1, "a", false)[4] != 9 { missing(); }
fn recurse(n = 3) { if n == 0 { return 0; } return 1 + recurse(n - 1); }
if recurse() != 3 { missing(); }
print "interp_defaults_program_pass";
