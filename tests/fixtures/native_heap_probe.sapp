let X=import("stdlib/native/codegen_x64.sapp");
let args=os_args();let mode=args[len(args)-1];
let value=1048576;
if mode=="nan" { value=parse_number("NaN"); }
elif mode=="infinity" { value=parse_number("inf"); }
elif mode=="private" { let cases=json_parse(fs_read("tests/fixtures/backend_admission_cases.json"));value=cases.invalid_cap; }
elif mode!="valid" { throw "unknown probe mode"; }
X.set_heap_reserve(value);
print "native_heap_probe_pass";
