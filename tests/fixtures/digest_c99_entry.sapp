let D=import("stdlib:digest.sapp");
let bytes=str_to_bytes("abc");
if D.sha1_hex_bytes(bytes)!="a9993e364706816aba3e25717850c26c9cd0d89d"{throw "sha1 mismatch";}
if D.md5_hex_bytes(bytes)!="900150983cd24fb0d6963f7d28e17f72"{throw "md5 mismatch";}
if D.blake3_hex_bytes(bytes)!="6437b3ac38465133ffb63b75273a8db548c558465d79db03fd359c6cd5bd9d85"{throw "blake3 mismatch";}
print "digest_c99_pass";
