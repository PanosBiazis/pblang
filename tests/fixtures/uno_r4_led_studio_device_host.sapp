let M=import("../../examples/uno_r4_led_studio/model.sapp");
let D=import("../../examples/uno_r4_led_studio/device_export.sapp");
let H=import("../../examples/uno_r4_led_studio/device_host.sapp");
let p=D.plan(M.create().document,2);let checks=0;
fn check(value,label) {if not value {throw label;}checks=checks+1;}
let fake=map{};
fn reset(mode) {fake=map{mode:mode,clock:0,counter:0,queue:[],commands:[],closed:false,opened:false};}
fn open(port,baud) {fake.opened=true;return map{ok:true};}
fn flush(handle) {return map{ok:true};}
fn nonce() {fake.counter=fake.counter+1;return str_slice(sha256(str(fake.counter)),0,16);}
fn now() {return fake.clock;}
fn close(handle) {fake.closed=true;return map{ok:fake.mode!="close",termios_restored:fake.mode!="close"};}
fn reply(command,id) {return map{protocol:"PBLED1",board:"UNO_R4_WIFI",digest:p.digest,command:command,request:id,
    ok:true,error:"",state:"idle",frame:0,remaining_ms:0,frames:len(p.rows),repetitions:p.repetitions,total_ms:p.total_ms};}
fn write(handle,bytes,timeout) {
    let lines=str_split(bytes_to_str(bytes),"\n");let command="";let id="";
    for i len(lines) {if lines[i]!="" {let parts=str_split(lines[i]," ");command=parts[0];id=parts[1];}}
    array_push(fake.commands,command);let r=reply(command,id);
    if command=="HELLO" and fake.mode=="digest" {r.digest="wrong";}
    if command=="PLAY" {
        if fake.mode=="write" {return map{ok:false,bytes_sent:2};}
        if fake.mode=="timeout" or fake.mode=="lost" {return map{ok:true,bytes_sent:len(bytes)};}
        r.state="running";r.frame=1;r.remaining_ms=p.total_ms;
        if fake.mode=="nonce" {r.request="0000000000000000";}
    }
    if command=="STOP" and fake.mode=="lost" {return map{ok:true,bytes_sent:len(bytes)};}
    let text=json_stringify(r)+"\n";
    if command=="STOP" and fake.mode=="nonce" {text=json_stringify(reply("ERROR","0000000000000000"))+"\n"+text;}
    fake.queue=str_to_bytes(text);return map{ok:true,bytes_sent:len(bytes)};
}
fn read(handle,maximum,timeout) {
    fake.clock=fake.clock+10;let bytes=[];let count=num_min(17,len(fake.queue));
    for i count {array_push(bytes,fake.queue[i]);}
    fake.queue=slice(fake.queue,count,len(fake.queue));return map{ok:true,bytes:bytes,count:count};
}
let io=map{open:open,flush:flush,write:write,read:read,close:close,now:now,nonce:nonce};
reset("good");let r=H.run_with(io,p,"/dev/ttyACM0","PLAY",true);
check(r.ok and r.identity_matched and r.play_attempted and r.reply.state=="running","play acknowledgement");
check(fake.closed and json_stringify(fake.commands)=="[\"HELLO\",\"PLAY\"]","handshake first and close");
reset("good");r=H.run_with(io,p,"/dev/ttyACM0","STOP",true);check(r.ok and r.stop_confirmed,"stop");
reset("good");r=H.run_with(io,p,"/dev/ttyACM0","STATUS",true);check(r.ok and not r.play_attempted,"status no play");
reset("digest");r=H.run_with(io,p,"/dev/ttyACM0","PLAY",true);
check(not r.ok and not r.identity_matched and len(fake.commands)==1 and fake.closed,"wrong project no play");
for mode in ["nonce","timeout","write"] {
    reset(mode);r=H.run_with(io,p,"/dev/ttyACM0","PLAY",true);
    check(not r.ok and r.stop_confirmed and not r.output_uncertain and fake.closed,"failed play cleanup "+mode);
    check(json_stringify(fake.commands)=="[\"HELLO\",\"PLAY\",\"STOP\"]","no play replay "+mode);
}
reset("lost");r=H.run_with(io,p,"/dev/ttyACM0","PLAY",true);check(not r.ok and r.output_uncertain and fake.closed,"lost device uncertain");
reset("close");r=H.run_with(io,p,"/dev/ttyACM0","STATUS",true);check(not r.ok and not r.termios_restored,"close failure visible");
reset("good");check((try H.run_with(io,p,"/dev/ttyUSB0","PLAY",true) catch nil)==nil and not fake.opened,"no implicit CP2102");
check((try H.run_with(io,p,"/dev/ttyACM0","PLAY",false) catch nil)==nil and not fake.opened,"confirmation before open");
let valid=reply("STATUS","1234567890abcdef");
for field in ["board","digest","protocol","request","command","frames","repetitions","total_ms","state","frame","remaining_ms","ok"] {
    let bad=json_parse(json_stringify(valid));bad[field]="wrong";
    check((try H.response(json_stringify(bad),p,"STATUS","1234567890abcdef") catch nil)==nil,"reject "+field);
}
let text=json_stringify(valid);check((try H.response("{\"board\":\"UNO_R4_WIFI\","+str_slice(text,1,len(text)),p,"STATUS","1234567890abcdef") catch nil)==nil,"duplicate key");
let tampered=json_parse(json_stringify(p));tampered.rows[0][0]=0;check((try D.validate(tampered) catch nil)==nil,"tampered plan");
print "uno_r4_led_studio_device_host_pass checks="+str(checks);
