let AI=import("stdlib/pbai.sapp");let S=import("stdlib:pbai_checkpoint_scope.sapp");
let IO=import("stdlib:pbai_student_checkpoint_io.sapp");let N=import("stdlib:pbai_neural_adapter.sapp");
let bound=AI.neural_specialist_checkpoint_scope_bind(S);
let directory=env_get("PBAI_CHECKPOINT_TEST_DIR");let phase=env_get("PBAI_SCOPE_PHASE");
let path=path_join(directory,"student.json");
fn rejects(f){return try {f();false} catch true;}
assert(rejects(fn(){throw "expected";}) and not rejects(fn(){return 1;}),"calibrated rejection helper");
if phase=="baseline" {
 let loaded=IO.load_file(path);let alias=loaded.predict;let reached_close=false;
 let failed=try {loaded.predict(nil);reached_close=true;loaded.close();false} catch true;
 assert(failed and not reached_close and alias([6,0]).token==5,"catching the old unscoped pattern leaves a live handle");
 assert(loaded.close() and rejects(fn(){alias([6,0]);}),"explicit fixture cleanup");
 print "pbai_checkpoint_scope_unscoped_gap:1";
} elif phase=="real" {
 let cases=0;let cycle=[];push(cycle,cycle);
 let bad_results=[nil,false,true,0,"synthetic-private-result",[],cycle,map{},map{ok:1,value:3},map{ok:true},map{ok:false}];
 for use in [S.with_file,bound.with_file] {
  let escaped=map{};let original=map{code:"synthetic-body-failure"};let exports=map{};
  let out=use(path,fn(handle){escaped=handle;exports.checkpoint=handle.checkpoint();exports.prediction=handle.predict([6,0]);return map{ok:true,value:exports};});
  assert(out.ok and out.cleanup_ok and out.cleanups_attempted==1 and out.value.prediction.token==5,"success is closed before return");
  assert(rejects(fn(){escaped.predict([6,0]);}) and not escaped.close(),"returned handle is terminal");
  let independent=N.student_load(out.value.checkpoint);assert(independent.predict([6,0]).token==5 and independent.close(),"detached output remains reusable");cases=cases+1;
  out=use(path,fn(handle){escaped=handle;return map{ok:false,error:original};});
  original.code="changed";
  assert(not out.ok and out.original_error_available and out.error.code=="changed" and out.body_status=="returned"
   and out.cleanup_ok and out.cleanups_attempted==1 and not escaped.close(),"explicit error retained separately from cleanup");cases=cases+1;
  for failure in ["explicit","prediction","evaluation"] {
   let methods=map{};
   out=use(path,fn(handle){methods=map{predict:handle.predict,evaluate:handle.evaluate,checkpoint:handle.checkpoint,close:handle.close};
    if failure=="explicit" {throw "synthetic-private-body-error";}
    if failure=="prediction" {handle.predict(nil);}else {handle.evaluate(nil);}
    return map{ok:true,value:nil};
   });
   assert(not out.ok and out.body_status=="exception" and out.body_result==nil and not out.original_error_available
    and out.error==nil and out.cleanup_ok and out.cleanups_attempted==1,"caught body failure cannot skip cleanup");
   assert(rejects(fn(){methods.predict([6,0]);}) and rejects(fn(){methods.evaluate([map{x:[6,0],y:5}]);})
    and rejects(methods.checkpoint) and not methods.close(),"all saved methods see terminal state");cases=cases+1;
  }
  for value in bad_results {
   out=use(path,fn(handle){escaped=handle;return value;});
   assert(not out.ok and out.body_status=="invalid_result" and out.cleanup_ok and out.cleanups_attempted==1
    and not escaped.close(),"malformed body result still releases handle");cases=cases+1;
  }
  out=use(path,fn(handle){escaped=handle;assert(handle.close(),"explicit early close");return map{ok:true,value:false};});
  assert(out.ok and type(out.value)=="bool" and not out.value and out.cleanup_ok and out.cleanups_attempted==1 and not escaped.close(),"early close remains idempotent");cases=cases+1;
  let forged_calls=0;
  out=use(path,fn(handle){escaped=handle;handle.close=fn(){forged_calls=forged_calls+1;throw "forged close";};return map{ok:true,value:handle.predict};});
  assert(out.ok and forged_calls==0 and rejects(fn(){out.value([6,0]);}),"captured close survives public-field replacement");cases=cases+1;
  let inner_methods=map{};
  out=use(path,fn(outer){escaped=outer;let captured=inner_methods;
   let nested=use(path,fn(inner){captured.predict=inner.predict;captured.close=inner.close;throw "synthetic nested failure";});
   assert(type(captured.predict)=="fn" or type(captured.predict)=="closure","inner prediction was actually captured");
   assert(not nested.ok and nested.cleanup_ok and not captured.close() and rejects(fn(){captured.predict([6,0]);}),"nested failure closes only its own handle");
   return map{ok:true,value:outer.predict([6,0]).token};
  });
  assert(out.ok and out.value==5 and not escaped.close(),"outer remains live until its own scope ends");cases=cases+1;
  out=use(path,fn(handle){return map{ok:true,value:handle};});
  assert(out.ok and rejects(fn(){out.value.predict([6,0]);}) and not out.value.close(),"returning a handle transfers only closed state");cases=cases+1;
 }
 assert(cases==40,"twenty cases per direct or bound route");
 print "pbai_checkpoint_scope_real_pass:"+str(cases);
} elif phase=="faults" {
 let cases=0;let callback_calls=0;let cycle=[];push(cycle,cycle);
 for use in [S.with_file,bound.with_file] {
  for bad in [nil,true,1,"synthetic-private-body",[],cycle,map{}] {
   IO.configure("normal");assert(rejects(fn(){use("synthetic-private-path",bad);}),"invalid body rejected");
   assert(IO.stats().loads==0 and IO.stats().closes==0,"invalid body cannot invoke storage");cases=cases+1;
  }
  IO.configure("load-throw");
  assert(rejects(fn(){use("synthetic-private-path",fn(_handle){callback_calls=callback_calls+1;return map{ok:true,value:nil};});}),"load error remains an exception");
  assert(IO.stats().loads==1 and IO.stats().closes==0 and callback_calls==0,"load failure neither retries nor calls body/cleanup");cases=cases+1;
  for mode in ["close-throw","close-nil","close-number","close-string","close-map","close-cycle"] {for success in [true,false] {
   IO.configure(mode);let error=map{code:"synthetic-primary-error"};
   let out=use("synthetic-private-path",fn(_handle){if success {return map{ok:true,value:17};}return map{ok:false,error:error};});
   assert(not out.ok and not out.cleanup_ok and out.cleanups_attempted==1 and len(out.cleanup_errors)==1
    and IO.stats().loads==1 and IO.stats().closes==1,"cleanup failure has one attempt and no retry");
   if success {assert(out.value==17 and out.body_result.ok,"successful body result survives cleanup failure");}
   else {assert(out.original_error_available and out.error==error and not out.body_result.ok,"cleanup cannot mask returned primary error");}
   let failure=out.cleanup_errors[0];
   if mode=="close-throw" {assert(failure.kind=="exception" and failure.result==nil,"opaque cleanup exception");}
   else {assert(failure.kind=="error_result" and failure.result.error=="invalid checkpoint close result","malformed cleanup has generic error");}
   cases=cases+1;
  }}
 }
 assert(cases==40 and callback_calls==0,"bounded fault matrix for both routes");
 print "pbai_checkpoint_scope_faults_pass:"+str(cases);
} elif phase=="error-missing" or phase=="error-corrupt" {
 let target=path_join(directory,if phase=="error-missing" {"missing.json"} else {"corrupt.json"});
 bound.with_file(target,fn(_handle){print "BODY_EXECUTED";return map{ok:true,value:nil};});
 throw "UNEXPECTED_SCOPE_SUCCESS";
} else {throw "select bounded scope fixture phase";}
