// Shared test-only AArch64 execution reference; no native execution/isolation claim.
fn fail(m) { throw "FAIL arm64 reference: " + m; }
// ── in-pblang AArch64 interpreter (executes what the compiler emits; halts on svc x8==93 → x0&255) ──
fn _word(code, off) { return code[off] + code[off + 1] * 256 + code[off + 2] * 65536 + code[off + 3] * 16777216; }
fn _idiv(n, m) { let q = n / m; if q >= 0 { return num_floor(q); } return 0 - num_floor(0 - q); }
fn _pw2(s) { let r = 1; let i = 0; while i < s { r = r * 2; i = i + 1; } return r; }
fn _holds(cc, r) { if cc == 0 { return r == 0; } if cc == 1 { return r != 0; } if cc == 10 { return r >= 0; } if cc == 11 { return r < 0; } if cc == 12 { return r > 0; } if cc == 13 { return r <= 0; } return false; }
fn arm64_run(code) {
    let x = []; let r = 0; while r < 32 { push(x, 0); r = r + 1; }
    let sp = 1048576; let mem = map{}; let bmem = map{}; let cmpres = 0; let out = "";
    let imgbase = 4194424; let imglen = len(code);   // loaded image: entry 0x400078; string data lives after the code
    let nwords = num_floor(len(code) / 4); let pc = 0; let guard = 0; let result = 0; let halted = false;
    while pc >= 0 and pc < nwords and guard < 200000000 and not halted {
        guard = guard + 1;
        let word = _word(code, pc * 4);
        let top = num_floor(word / 16777216) % 256;
        let op6 = num_floor(word / 67108864) % 64;
        let rd = word % 32; let rn = num_floor(word / 32) % 32; let ra = num_floor(word / 1024) % 32; let rm = num_floor(word / 65536) % 32;
        let next = pc + 1;
        if op6 == 5 { let o = word % 67108864; if o >= 33554432 { o = o - 67108864; } next = pc + o; }                       // b
        else if op6 == 37 { let o = word % 67108864; if o >= 33554432 { o = o - 67108864; } x[30] = pc + 1; next = pc + o; } // bl
        else if top == 210 { let hw = num_floor(word / 2097152) % 2; let imm = num_floor(word / 32) % 65536; if rd != 31 { if hw == 1 { x[rd] = imm * 65536; } else { x[rd] = imm; } } }  // movz (hw=1 → lsl#16)
        else if top == 146 { let imm = num_floor(word / 32) % 65536; if rd != 31 { x[rd] = 0 - imm - 1; } }                  // movn Xd,#imm (~imm; movn x,#0 = -1)
        else if top == 242 { let imm = num_floor(word / 32) % 65536; if rd != 31 { x[rd] = (x[rd] % 65536) + imm * 65536; } }// movk hi
        else if top == 139 { let sh = num_floor(word / 1024) % 64; if rd != 31 { x[rd] = x[rn] + x[rm] * _pw2(sh); } }        // add (shifted reg: lsl#sh)
        else if top == 203 { if rd != 31 { x[rd] = x[rn] - x[rm]; } }                                                        // sub
        else if top == 138 { if rd != 31 { x[rd] = bit_and(x[rn], x[rm]); } }                                                // and
        else if top == 202 { if rd != 31 { x[rd] = bit_xor(x[rn], x[rm]); } }                                                // eor
        else if top == 235 { cmpres = x[rn] - x[rm]; }                                                                       // cmp
        else if top == 155 { let ms = num_floor(word / 32768) % 2; if rd != 31 { if ms == 1 { x[rd] = x[ra] - x[rn] * x[rm]; } else { x[rd] = x[rn] * x[rm] + x[ra]; } } } // madd/msub
        else if top == 154 { let isd = num_floor(word / 2048) % 2; if isd == 1 { if rd != 31 { x[rd] = _idiv(x[rn], x[rm]); } } else { let cc = num_floor(word / 4096) % 16; let v = 0; if not _holds(cc, cmpres) { v = 1; } if rd != 31 { x[rd] = v; } } } // sdiv/cset
        else if top == 145 { let imm = num_floor(word / 1024) % 4096; if num_floor(word / 4194304) % 2 == 1 { imm = imm * 4096; } let base = sp; if rn != 31 { base = x[rn]; } let v = base + imm; if rd == 31 { sp = v; } else { x[rd] = v; } } // add imm (reg31=SP)
        else if top == 209 { let imm = num_floor(word / 1024) % 4096; if num_floor(word / 4194304) % 2 == 1 { imm = imm * 4096; } let base = sp; if rn != 31 { base = x[rn]; } let v = base - imm; if rd == 31 { sp = v; } else { x[rd] = v; } } // sub imm
        else if top == 249 { let l = num_floor(word / 4194304) % 2; let off = num_floor(word / 1024) % 4096 * 8; let base = sp; if rn != 31 { base = x[rn]; } let a = base + off;
            if l == 1 { if rd != 31 { if a >= imgbase and a < imgbase + imglen { let p = a - imgbase; x[rd] = code[p] + code[p + 1] * 256 + code[p + 2] * 65536 + code[p + 3] * 16777216; } else { x[rd] = mem[str(a)]; } } } else { mem[str(a)] = x[rd]; } }  // ldr/str (ldr reads string length from the data image)
        else if top == 169 { sp = sp - 16; mem[str(sp)] = x[rd]; mem[str(sp + 8)] = x[ra]; }                                 // stp [sp,#-16]!
        else if top == 168 { if rd != 31 { x[rd] = mem[str(sp)]; } if ra != 31 { x[ra] = mem[str(sp + 8)]; } sp = sp + 16; } // ldp [sp],#16
        else if top == 170 { if rd != 31 { if rn == 31 { x[rd] = x[rm]; } else { x[rd] = bit_or(x[rn], x[rm]); } } }         // mov/orr
        else if top == 57 { let l = num_floor(word / 4194304) % 2; let imm = num_floor(word / 1024) % 4096; let base = sp; if rn != 31 { base = x[rn]; } let a = base + imm;  // strb (L=0) / ldrb (L=1)
            if l == 1 { let bb = 0; if a >= imgbase and a < imgbase + imglen { bb = code[a - imgbase]; } elif map_has(bmem, str(a)) { bb = bmem[str(a)]; } if rd != 31 { x[rd] = bb; } }
            else { bmem[str(a)] = x[rd] % 256; } }
        else if top == 180 { let o = num_floor(word / 32) % 524288; if o >= 262144 { o = o - 524288; } if x[rd] == 0 { next = pc + o; } } // cbz
        else if top == 181 { let o = num_floor(word / 32) % 524288; if o >= 262144 { o = o - 524288; } if x[rd] != 0 { next = pc + o; } } // cbnz
        else if top == 214 { next = x[30]; }                                                                                // ret
        else if top == 212 {                                                                                                // svc
            if x[8] == 93 { result = x[0]; halted = true; }                                                                 //   exit(x0)
            else if x[8] == 222 { x[0] = 268435456; }                                                                       //   mmap → fixed heap base 0x10000000
            else if x[8] == 64 { let bf = x[1]; let ln = x[2]; let ii = 0; while ii < ln { let a = bf + ii; let bb = 0; if a >= imgbase and a < imgbase + imglen { bb = code[a - imgbase]; } elif map_has(bmem, str(a)) { bb = bmem[str(a)]; } out = out + strfromcharcode(bb); ii = ii + 1; } }  // write(fd, buf, len): bytes from the data image or the byte-mem'd stack
        }
        else { throw "arm64_run: unmodeled instruction word " + str(word); }
        x[31] = 0;
        pc = next;
    }
    if not halted { fail("ran off the end without svc-exit"); }
    let e = result % 256; if e < 0 { e = e + 256; } return map{ exit: e, out: out };
}

export arm64_run;
