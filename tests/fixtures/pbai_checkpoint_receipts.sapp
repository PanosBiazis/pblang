// Run only in the installed harness with its private synthetic secure_file shim.
let AI=import("stdlib/pbai.sapp");let N=import("stdlib:pbai_neural_adapter.sapp");
let IO=import("stdlib:pbai_student_checkpoint_io.sapp");let backend=import("stdlib:secure_file.sapp");
let storage=AI.neural_specialist_checkpoint_bind(IO);
let mode=env_get("PBAI_RECEIPT_MODE");if mode==nil or mode=="" {mode="cases";}
let teacher=N.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let artifact=N.distill_supervised(teacher.artifact,[map{x:[0],y:5}],[map{x:[7,0],y:5}],
 map{epochs:64,lr:0.1,temperature:2,hard_weight:1,max_grad_norm:1}).checkpoint();
let encoded=N.student_encode(artifact);let bytes=len(str_to_bytes(encoded));
let parent=N.student_load(artifact);let prediction=json_stringify(parent.predict([6,0]));let checkpoint=json_stringify(parent.checkpoint());
let private_path="SYNTHETIC_PRIVATE_CHECKPOINT_PATH";
fn save_ok() {return map{ok:true,size:bytes,no_replace:true,exclusive_create:true,
 descriptor_bound_parent:true,atomic_namespace_admission:true,atomic_visibility:false};}
fn read_ok() {return map{ok:true,text:encoded,size:bytes};}
fn unchanged() {
 assert(json_stringify(parent.predict([6,0]))==prediction and json_stringify(parent.checkpoint())==checkpoint
  and N.student_encode(artifact)==encoded,"previous model and input checkpoint unchanged");
}
fn rejects(f) {return try {f();false} catch true;}
if mode=="baseline" {
 backend.configure(map{ok:true},read_ok());let saved=storage.save_new(private_path,artifact);
 assert(saved.ok and saved.no_replace,"baseline falsely claims exclusive save without backend evidence");
 backend.configure(save_ok(),map{ok:true,text:encoded,size:1});
 assert(storage.load_file(private_path).predict([6,0]).token==5,"baseline accepts inconsistent read size");
 backend.configure(map{ok:1},map{ok:1,text:encoded,size:bytes});
 assert(storage.save_new(private_path,artifact).ok and storage.load_file(private_path).predict([6,0]).token==5,"baseline accepts nonboolean success");
 print "pbai_checkpoint_receipts_baseline_gap:4";
} elif mode=="cases" {
 assert(rejects(fn(){throw "expected";}) and not rejects(fn(){return 1;}),"calibrated catch helper");
 let cycle=map{};cycle.self=cycle;let called=false;let callback=fn(){called=true;return true;};
 let bad_writes=[nil,false,true,7,"SYNTHETIC_PRIVATE_BACKEND_ERROR",[],cycle,map{},map{ok:true},map{ok:false,error:cycle}];
 for key in ["ok","size","no_replace","exclusive_create","descriptor_bound_parent","atomic_namespace_admission","atomic_visibility"] {
  let value=save_ok();map_remove(value,key);push(bad_writes,value);
 }
 for key in ["ok","no_replace","exclusive_create","descriptor_bound_parent","atomic_namespace_admission"] {
  for wrong in [false,1,"true",callback] {let value=save_ok();value[key]=wrong;push(bad_writes,value);}
 }
 for wrong in [true,0,"false",callback] {let value=save_ok();value.atomic_visibility=wrong;push(bad_writes,value);}
 for wrong in [nil,-1,0,bytes-1,bytes+1,4097,1.5,str(bytes),true,[]] {let value=save_ok();value.size=wrong;push(bad_writes,value);}
 let saves=0;let loads=0;
 for failed in bad_writes {
  backend.configure(failed,read_ok());let previous_receipt=map{previous:true};let receipt=previous_receipt;
  let accepted=try {receipt=storage.save_new(private_path,artifact);true} catch false;
  if accepted {throw "malformed save response accepted";}
  assert(receipt.previous,"failed save preserves caller receipt/state");
  assert(backend.counts().writes==1 and backend.counts().reads==0,"one save, no retry or readback after failure");
  unchanged();saves=saves+1;
 }
 let bad_reads=[nil,false,true,7,"SYNTHETIC_PRIVATE_BACKEND_ERROR",[],cycle,map{},map{ok:true},map{ok:false,error:cycle}];
 for key in ["ok","text","size"] {let value=read_ok();map_remove(value,key);push(bad_reads,value);}
 for wrong in [false,1,"true",callback] {let value=read_ok();value.ok=wrong;push(bad_reads,value);}
 for wrong in [nil,-1,0,bytes-1,bytes+1,4097,1.5,str(bytes),true,[]] {let value=read_ok();value.size=wrong;push(bad_reads,value);}
 for wrong in [nil,7,[],cycle,callback,str_repeat(" ",4097),str_repeat("é",2049)] {let value=read_ok();value.text=wrong;push(bad_reads,value);}
 for text in ["{","{}","{\"format\":0,\"format\":1}"] {push(bad_reads,map{ok:true,text:text,size:len(str_to_bytes(text))});}
 for failed in bad_reads {
  backend.configure(save_ok(),failed);let active=parent;
  let accepted=try {active=storage.load_file(private_path);true} catch false;
  if accepted {throw "malformed load response accepted";}
  assert(json_stringify(active.predict([6,0]))==prediction,"failed load preserves active model");
  assert(backend.counts().reads==1 and backend.counts().writes==0,"one read, no retry or fallback save");
  unchanged();loads=loads+1;
 }
 for throwing in ["write","read"] {
  backend.configure(save_ok(),read_ok(),throwing=="write",throwing=="read");
  if throwing=="write" {assert(rejects(fn(){storage.save_new(private_path,artifact);}),"provider write error rejected");}
  else {assert(rejects(fn(){storage.load_file(private_path);}),"provider read error rejected");}
  unchanged();
 }
 backend.configure(nil,nil,true,true);
 assert(rejects(fn(){storage.save_new(private_path,map{});}) and rejects(fn(){storage.load_file(nil);}),"input validation before backend");
 assert(backend.counts().writes==0 and backend.counts().reads==0,"invalid inputs cause no provider calls");
 let write=save_ok();write.extra=cycle;let read=read_ok();read.extra=callback;
 backend.configure(write,read);
 let receipt=storage.save_new(private_path,artifact);let restored=storage.load_file(private_path);
 assert(receipt.ok and receipt.bytes==bytes and receipt.no_replace and not receipt.atomic_visibility
  and not receipt.globally_activated and not str_contains(json_stringify(receipt),private_path),"normal receipt and privacy preserved");
 assert(json_stringify(restored.predict([6,0]))==prediction and json_stringify(restored.checkpoint())==checkpoint,"normal roundtrip preserves result");
 assert(not called,"unknown metadata and malformed callbacks never invoked");unchanged();
 print "pbai_checkpoint_receipts_pass:"+str(saves)+":"+str(loads);
} else {
 let write=save_ok();let read=read_ok();let bad_artifact=false;
 if mode=="write_throw" {backend.configure(write,read,true,false);}
 elif mode=="read_throw" {backend.configure(write,read,false,true);}
 elif mode=="write_nil" {backend.configure(nil,read);}
 elif mode=="read_nil" {backend.configure(write,nil);}
 elif mode=="write_size" {write.size=1;backend.configure(write,read);}
 elif mode=="read_json" {backend.configure(write,map{ok:true,text:"{",size:1});}
 elif mode=="read_artifact" {backend.configure(write,map{ok:true,text:"{}",size:2});}
 elif mode=="invalid_input" {bad_artifact=true;backend.configure(nil,nil,true,true);}
 else {throw "unknown receipt error fixture mode";}
 if str_starts_with(mode,"write") or bad_artifact {storage.save_new(private_path,if bad_artifact {map{}} else {artifact});}
 else {storage.load_file(private_path);}
 throw "UNEXPECTED_CHECKPOINT_SUCCESS";
}
