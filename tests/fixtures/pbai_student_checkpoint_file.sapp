let AI=import("stdlib/pbai.sapp");
let directory=env_get("PBAI_CHECKPOINT_TEST_DIR");let phase=env_get("PBAI_CHECKPOINT_TEST_PHASE");
if directory==nil or directory=="" {throw "explicit test directory required";}
fn rejects(f) {return try {f();false} catch true;}
if phase=="write" {
 let teacher=AI.neural_specialist_train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
 let student=AI.neural_specialist_distill_supervised(teacher.artifact,[map{x:[0],y:5}],[map{x:[7,0],y:5}],
  map{epochs:64,lr:0.1,temperature:2,hard_weight:1,max_grad_norm:1});
 let artifact=student.checkpoint();let receipt=AI.neural_specialist_student_save_new(directory+"/student.json",artifact);
 assert(receipt.ok and receipt.no_replace and not receipt.atomic_visibility and not receipt.encrypted,"honest exclusive storage receipt");
 assert(not str_contains(json_stringify(receipt),directory),"receipt excludes private paths");
 assert(rejects(fn(){AI.neural_specialist_student_save_new(directory+"/student.json",artifact);}),"existing checkpoint never replaced");
 for name in ["link.json","existing.json","parent-link/other.json","public/other.json","missing/other.json"] {
  assert(rejects(fn(){AI.neural_specialist_student_save_new(directory+"/"+name,artifact);}),"unsafe or unavailable destination rejected");
 }
 assert(rejects(fn(){AI.neural_specialist_student_save_new(directory+"/invalid.json",map{});}),"invalid artifact rejected before file creation");
 print "checkpoint_write_pass";
} elif phase=="read" {
 let loaded=AI.neural_specialist_student_load_file(directory+"/student.json");
 assert(loaded.predict([6,0]).token==5,"fresh process restores learned prediction");
 assert(not loaded.report.exact_student_input_disjointness_checked,"file load cannot restore missing split provenance");
 for name in ["link.json","existing.json","oversized.json","invalid-utf8.json","pipe.json","parent-link/student.json"] {
  assert(rejects(fn(){AI.neural_specialist_student_load_file(directory+"/"+name);}),"malformed, symlink or special file rejected");
 }
 print "checkpoint_read_pass";
} elif phase=="denied" {
 assert(rejects(fn(){AI.neural_specialist_student_load_file(directory+"/student.json");}),"missing native capability does not fall back to unguarded read");
 print "checkpoint_denied_capability_pass";
} else {throw "explicit test phase required";}
