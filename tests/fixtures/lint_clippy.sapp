// Fixture for clippy-style idiom lints (tests/lint.rs).
fn demo(x, a, flag) {
    let r = x == true;
    let same = a == a;
    let zero = a - a;
    let dn = not (not flag);
    if a > 0 {
        if x > 0 {
            print "both";
        }
    }
    while true {
        print "loop";
    }
    x = x;
    return r + same + zero + dn;
}
