// Observes original methods in a private copied owner, not production exports.
let continuation_probe=map{mode:"success",items:[]};
fn _continuation_probe_wrap(handle){
 let item=map{predict:handle.predict,checkpoint:handle.checkpoint,evaluate:handle.evaluate,
  close:if map_has(handle,"close") {handle.close} else {nil},closes:0};
 push(continuation_probe.items,item);
 if item.close!=nil {handle.close=fn(){item.closes=item.closes+1;return item.close();};}
 if continuation_probe.mode=="checkpoint_fault" {handle.checkpoint=fn(){throw "synthetic private export fault";};}
 return handle;
}
fn continuation_probe_mode(mode){continuation_probe.mode=mode;}
fn continuation_probe_count(){return len(continuation_probe.items);}
fn continuation_probe_inspect(index){
 let item=continuation_probe.items[index];
 let prediction_closed=try {item.predict([6,0]);false} catch true;
 let checkpoint_closed=try {item.checkpoint();false} catch true;
 let evaluation_closed=try {item.evaluate([map{x:[6,0],y:4}]);false} catch true;
 let diagnostic=nil;if item.close!=nil {diagnostic=item.close();}
 return map{close_calls:item.closes,prediction_closed:prediction_closed,
  checkpoint_closed:checkpoint_closed,evaluation_closed:evaluation_closed,
  diagnostic_close:diagnostic,physical_release_verified:false};
}
export continuation_probe_mode,continuation_probe_count,continuation_probe_inspect;
