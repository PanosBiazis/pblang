// Run with --deny-ffi on an isolated display: legacy creation must still work.
let G=import("stdlib:graphics.sapp");let w=G.Window(320,180,"PBLang input fallback",map{ordered_input:true});
assert(w.input_backend=="legacy","missing FFI keeps legacy input");w.present();w.pollEvents();w.close();w.close();
assert(not w.isOpen(),"fallback closes normally");print "native_ordered_fallback_pass";
