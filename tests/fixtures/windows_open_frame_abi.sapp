// Test-only bounded memory model for the Win64 NtCreateFile record. No FFI.
let model=map{next:4096,sizes:map{},cells:map{},allocs:0,writes:0,calls:0,
    closes:0,fail_alloc:0,fail_write:0,status:0,handle:11,expected_root:10};
fn reset(options) {
    assert(len(map_keys(model.sizes))==0,"previous call released its buffers");
    model.cells=map{};model.allocs=0;model.writes=0;model.calls=0;model.closes=0;
    model.fail_alloc=try options.fail_alloc catch 0;
    model.fail_write=try options.fail_write catch 0;
    model.status=try options.status catch 0;
    model.handle=try options.handle catch 11;
    model.expected_root=try options.root catch 10;
}
fn allocate(state,size) {
    model.allocs=model.allocs+1;
    if model.allocs==model.fail_alloc {return 0;}
    model.next=model.next+256;model.sizes[str(model.next)]=size;return model.next;
}
fn free(state,pointer) {
    assert(map_has(model.sizes,str(pointer)),"free must use the live allocation base exactly once");
    map_remove(model.sizes,str(pointer));return true;
}
fn _range(pointer,offset,width) {
    assert(map_has(model.sizes,str(pointer)),"checked access requires allocation base");
    assert(offset>=0 and width>=0 and offset+width<=model.sizes[str(pointer)],"access inside owned buffer");
}
fn _write(pointer,offset,value,width) {
    _range(pointer,offset,width);model.writes=model.writes+1;
    if model.writes==model.fail_write {return false;}
    model.cells[str(pointer)+":"+str(offset)]=value;return true;
}
fn write_u8(state,pointer,offset,value) {return _write(pointer,offset,value,1);}
fn write_u16(state,pointer,offset,value) {return _write(pointer,offset,value,2);}
fn write_u32(state,pointer,offset,value) {return _write(pointer,offset,value,4);}
fn write_u64(state,pointer,offset,value) {return _write(pointer,offset,value,8);}
fn write_bytes(state,pointer,offset,bytes) {return _write(pointer,offset,bytes,len(bytes));}
fn _cell(pointer,offset) {return try model.cells[str(pointer)+":"+str(offset)] catch 0;}
fn read_u64(state,pointer,offset) {
    _range(pointer,offset,8);assert(offset==80,"read HANDLE from final eight bytes");return model.handle;
}
fn call_dirfs(state,name,args) {
    if name=="MultiByteToWideChar" {return map{ok:true,value:5};}
    if name=="CloseHandle" {model.closes=model.closes+1;return map{ok:true,value:1};}
    assert(name=="NtCreateFile","only reviewed native operations");model.calls=model.calls+1;
    let frame=args[2]-16;
    assert(model.sizes[str(frame)]==88,"one exact record allocation");
    assert(args[0]==frame+80 and args[3]==frame+64,"nonoverlapping output and IO status");
    assert(num_mod(frame,8)==0,"eight-byte alignment");
    assert(_cell(frame,0)==8 and _cell(frame,2)==10,"UTF-16 lengths exclude/include terminator");
    assert(model.sizes[str(_cell(frame,8))]==10,"live separate UTF-16 buffer");
    assert(_cell(frame,16)==48 and _cell(frame,24)==model.expected_root,"object size and held root");
    assert(_cell(frame,32)==frame and _cell(frame,40)==0x1040,"object name and no-reparse flags");
    assert(_cell(frame,48)==0 and _cell(frame,56)==0,"reserved security fields stay zero");
    assert(args[1]==0x1000A1 and args[4]==0 and args[5]==0x80 and args[6]==7,"unchanged access and sharing");
    assert(args[7]==3 and args[8]==0x200021 and args[9]==0 and args[10]==0,"unchanged disposition and options");
    return map{ok:true,value:model.status};
}
fn counts() {return map{buffers:len(map_keys(model.sizes)),allocs:model.allocs,
    writes:model.writes,calls:model.calls,closes:model.closes};}
export reset,allocate,free,write_u8,write_u16,write_u32,write_u64,write_bytes,read_u64,call_dirfs,counts;
