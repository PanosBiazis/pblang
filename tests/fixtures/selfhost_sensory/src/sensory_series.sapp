// Pure bounded envelope review. Caller provenance is an assertion, never attestation.
let Units=import("stdlib:units.sapp");
let Series=import("stdlib:sample_series.sapp");
fn _shape(value,fields) {
    if type(value)!="map" or len(value)!=len(fields) {throw "sensory: invalid record";}
    for _field in fields {if not map_has(value,_field) {throw "sensory: invalid record";}}
}
fn _number(value,low,high,integer=false) {
    if type(value)!="number" or not (value>=low and value<=high) {throw "sensory: invalid number";}
    if integer and value!=num_floor(value) {throw "sensory: invalid number";}
}
fn _unit(modality,unit) {
    if modality=="temperature" {return unit=="degC" or unit=="degF" or unit=="K";}
    if modality=="pressure" {return unit=="Pa" or unit=="kPa" or unit=="bar";}
    if modality=="gas_resistance" {return unit=="ohm" or unit=="kohm" or unit=="Mohm";}
    if modality=="taste_voltage" or modality=="eeg_voltage" or modality=="emg_voltage" {return unit=="V" or unit=="mV";}
    return false;
}
fn review(document) {
    _shape(document,["modality","unit","summary_unit","provenance","sample_rate_hz","calibration","range","samples","replay_count"]);
    if not _unit(document.modality,document.unit) or not _unit(document.modality,document.summary_unit) {throw "sensory: unsupported modality or unit";}
    if document.provenance!="synthetic" and document.provenance!="imported" and document.provenance!="measured" {throw "sensory: invalid provenance";}
    _number(document.sample_rate_hz,1,10000,true);
    let period=1000000/document.sample_rate_hz;
    if period!=num_floor(period) {throw "sensory: cadence needs integral microseconds";}
    _shape(document.calibration,["scale","offset"]);
    _number(document.calibration.scale,-1000000,1000000);
    _number(document.calibration.offset,-1000000,1000000);
    if document.calibration.scale==0 {throw "sensory: zero calibration scale";}
    _shape(document.range,["minimum","maximum"]);
    _number(document.range.minimum,-1000000,1000000);_number(document.range.maximum,-1000000,1000000);
    if document.range.minimum>document.range.maximum {throw "sensory: invalid range";}
    // Range is expressed in summary units; absolute temperature must be physical.
    Units.convert_checked(document.range.minimum,document.summary_unit,document.summary_unit,"absolute");
    Units.convert_checked(document.range.maximum,document.summary_unit,document.summary_unit,"absolute");
    if type(document.samples)!="array" or len(document.samples)<2 or len(document.samples)>256 {throw "sensory: sample limit";}
    _number(document.replay_count,1,len(document.samples),true);
    let values=[];
    // Complete validation includes rows beyond the replay prefix.
    for i len(document.samples) {
        let sample=document.samples[i];_shape(sample,["sequence","time_us","value"]);
        _number(sample.sequence,0,255,true);_number(sample.time_us,0,255000000,true);
        if sample.sequence!=i or sample.time_us!=i*period {throw "sensory: irregular sequence or timing";}
        _number(sample.value,-1000000,1000000);
        let calibrated=sample.value*document.calibration.scale+document.calibration.offset;
        _number(calibrated,-1000000,1000000);
        let converted=Units.convert_checked(calibrated,document.unit,document.summary_unit,"absolute");
        _number(converted,-1000000,1000000);
        if document.modality=="gas_resistance" and converted<0 {throw "sensory: negative resistance";}
        if i<document.replay_count {array_push(values,converted);}
    }
    let minimum=values[0];let maximum=values[0];let outside=0;let equal=0;
    for i len(values) {
        let value=values[i];
        if value<minimum {minimum=value;}if value>maximum {maximum=value;}
        if value<document.range.minimum or value>document.range.maximum {outside=outside+1;}
        if i>0 and value==values[i-1] {equal=equal+1;}
    }
    return map{format:"pb_mcp.sensory-series-review.v1",native_pblang:true,
        modality:document.modality,summary_unit:document.summary_unit,
        declared_provenance:document.provenance,provenance_verified:false,
        mode:"offline-prefix-replay",validated_samples:len(document.samples),replayed_samples:len(values),
        remaining_samples:len(document.samples)-len(values),sample_rate_hz:document.sample_rate_hz,
        relative_span_seconds:(len(values)-1)/document.sample_rate_hz,
        cadence_verified:"supplied-relative-microsecond-grid-only",physical_clock_verified:false,
        calibration_applied:true,calibration_verified:false,
        metrics:map{minimum:minimum,maximum:maximum,mean:Series.moving_mean(values,len(values)).values[0]},
        quality:map{outside_supplied_range:outside,equal_adjacent_pairs:equal,
            constant_prefix:minimum==maximum,meaning:"descriptive-only-no-sensor-health-inference"},
        contains_raw_samples:false,contains_identifiers:false,contains_measurement_statistics:true,
        safe_to_log:false,persisted:false,acquisition_performed:false,effect_performed:false,
        network_used:false,model_loaded:false,permission_granted:false,clinical_interpretation:false};
}
export review;
