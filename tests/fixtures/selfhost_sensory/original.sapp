let Frontend=import("stdlib:compiler/selfhost_frontend.sapp");
let source="let T=import(\"src/sensory_tools.sapp\"); let d=map{modality:\"pressure\",unit:\"kPa\",summary_unit:\"Pa\",provenance:\"synthetic\",sample_rate_hz:2,calibration:map{scale:1,offset:0},range:map{minimum:0,maximum:5000},samples:[map{sequence:0,time_us:0,value:1},map{sequence:1,time_us:500000,value:3}],replay_count:2}; let r=T.call_sensory(\"sensory_series_review\",map{series_json:json_stringify(d)}); print r.metrics.mean; print r.replayed_samples; print r.acquisition_performed;";
let result=Frontend.frontend_run(source);
assert(result.ok and result.output==[2000,2,false],"sensory selfhost frontend parity");
print "sensory_selfhost_pass";
