let AI=import("stdlib/pbai.sapp");let S=import("stdlib:pbai_checkpoint_scope.sapp");
let IO=import("stdlib:pbai_student_checkpoint_io.sapp");let N=import("stdlib:pbai_neural_adapter.sapp");
let bound=AI.neural_specialist_checkpoint_batch_bind(S);let phase=env_get("PBAI_BATCH_PHASE");
let directory=env_get("PBAI_CHECKPOINT_TEST_DIR");let path=path_join(directory,"student.json");
fn rejects(f){return try {f();false} catch true;}
assert(rejects(fn(){throw "expected";}) and not rejects(fn(){return 1;}),"calibrated rejection");
fn paths(n){let out=[];while len(out)<n {push(out,path);}return out;}
fn reverse(n){let out=[];let i=n;while i>0 {push(out,i);i=i-1;}return out;}
fn closed(handles){for handle in handles {
 let predict=handle.predict;assert(type(predict)=="fn" or type(predict)=="closure","real saved prediction callable");
 assert(not handle.close() and rejects(fn(){predict([6,0]);}),"each saved real handle is terminal");
}}
let cases=0;
if phase=="faults" {
 let cycle=[];push(cycle,cycle);let longpath="";while len(longpath)<4097 {longpath=longpath+"x";}
 let badpaths=[nil,true,1,"private",map{},cycle,[],paths(9),[nil],[true],[1],[[]],[map{}],[""],[longpath],["x"+strfromcharcode(0)], [path,nil]];
 let badbody=[nil,true,1,"private",[],cycle,map{}];
 for use in [S.with_files,bound.with_files] {
  let calls=0;let callback=fn(_handles){calls=calls+1;return map{ok:true,value:1};};
  for bad in badpaths {IO.configure(0,"normal");assert(rejects(fn(){use(bad,callback);}),"invalid list rejected before IO");
   assert(IO.stats().loads==0 and len(IO.stats().order)==0 and calls==0,"whole request preflight before first load");cases=cases+1;}
  for bad in badbody {IO.configure(0,"normal");assert(rejects(fn(){use(paths(1),bad);}),"invalid body before IO");
   assert(IO.stats().loads==0 and len(IO.stats().order)==0,"no invalid body effects");cases=cases+1;}
  for fail in range(1,9) {for mode in ["normal","throw"] {
   IO.configure(fail,mode);let out=use(paths(8),callback);let count=fail-1;
   assert(not out.ok and out.stage=="acquire" and out.acquired_count==count and out.cleanups_attempted==count
    and out.body_status=="exception" and out.body_result==nil and out.error==nil and not out.original_error_available,"partial acquisition classified");
   assert(IO.stats().loads==fail and IO.stats().order==reverse(count) and calls==0,"stop loading and close only acquired in reverse order");
   let failures=if mode=="throw" {count} else {0};
   assert(len(out.cleanup_errors)==failures and out.cleanup_ok==(failures==0),"cleanup continues after each failure");cases=cases+1;
  }}
  for mode in ["normal","throw","nil","number","string","map","cycle"] {for success in [true,false] {
   IO.configure(0,mode);let primary=map{code:"synthetic-primary"};
   let out=use(paths(8),fn(_handles){if success {return map{ok:true,value:17};}return map{ok:false,error:primary};});
   assert(out.stage=="body" and out.acquired_count==8 and out.cleanups_attempted==8 and IO.stats().loads==8
    and IO.stats().order==reverse(8),"each acquired handle gets one reverse-order cleanup");
   assert(out.ok==(success and mode=="normal") and out.cleanup_ok==(mode=="normal"),"combined success contract");
   if success {assert(out.value==17 and out.body_result.ok,"body success retained");}
   else {primary.code="changed";assert(out.original_error_available and out.error.code=="changed" and not out.body_result.ok,"original error alias retained");}
   if mode!="normal" {assert(len(out.cleanup_errors)==8,"all cleanup failures collected");
    for failure in out.cleanup_errors {assert(failure.kind==(if mode=="throw" {"exception"} else {"error_result"}),"cleanup type classification");}
   }cases=cases+1;
  }}
  for bad in [nil,false,true,0,"private",[],cycle,map{},map{ok:1,value:3},map{ok:true},map{ok:false}] {
   IO.configure(0,"normal");let out=use(paths(2),fn(_handles){return bad;});
   assert(not out.ok and out.stage=="body" and out.body_status=="invalid_result" and out.cleanup_ok
    and out.acquired_count==2 and IO.stats().order==[2,1],"malformed result still closes all");cases=cases+1;
  }
 }
 assert(cases==130,"65 fault cases per route");print "pbai_checkpoint_batch_faults_pass:"+str(cases);
} elif phase=="real" {
 for use in [S.with_files,bound.with_files] {
  let saved=[];
  let out=use(paths(2),fn(handles){saved=handles;return map{ok:true,value:map{checkpoint:handles[0].checkpoint(),token:handles[1].predict([6,0]).token}};});
  assert(out.ok and out.stage=="body" and out.acquired_count==2 and out.cleanups_attempted==2 and out.value.token==5,"two independent real handles");closed(saved);
  let detached=N.student_load(out.value.checkpoint);assert(detached.predict([6,0]).token==5 and detached.close(),"detached export reusable");cases=cases+1;
  for count in [1,8] {out=use(paths(count),fn(handles){return map{ok:true,value:handles};});
   assert(out.ok and out.acquired_count==count and out.cleanups_attempted==count and len(out.value)==count,"inclusive batch limits");closed(out.value);cases=cases+1;}
  for mode in ["error","throw","predict","nil"] {
   out=use(paths(2),fn(handles){saved=handles;
    if mode=="error" {return map{ok:false,error:"explicit error"};}
    if mode=="throw" {throw "synthetic body failure";}
    if mode=="predict" {handles[1].predict(nil);}return nil;
   });
   assert(not out.ok and out.stage=="body" and out.cleanup_ok and out.acquired_count==2 and out.cleanups_attempted==2,"all handles closed on body failure");closed(saved);cases=cases+1;
  }
  let forged=0;
  out=use(paths(2),fn(handles){saved=[handles[0],handles[1]];assert(handles[0].close(),"early close");
   assert(handles[1].predict([6,0]).token==5,"closing one duplicate-path handle preserves the other");
   handles[1].close=fn(){forged=forged+1;throw "forged";};array_pop(handles);array_pop(handles);return map{ok:true,value:1};});
  assert(out.ok and out.acquired_count==2 and out.cleanups_attempted==2 and forged==0 and len(saved)==2,"ledger independent from exposed list and close");
  assert(not saved[0].close() and rejects(fn(){saved[1].predict([6,0]);}),"original closers retained");cases=cases+1;
  out=use(paths(1),fn(handles){let outer=handles[0];
   let inner=S.with_files([path,path_join(directory,"missing.json")],fn(_items){throw "unreachable body";});
   assert(not inner.ok and inner.stage=="acquire" and inner.acquired_count==1 and inner.cleanups_attempted==1 and inner.cleanup_ok,"nested partial acquisition closes its own handle");
   return map{ok:true,value:outer.predict([6,0]).token};});
  assert(out.ok and out.value==5 and out.acquired_count==1,"outer survives inner acquisition failure");cases=cases+1;
  for targets in [[path_join(directory,"missing.json"),path],[path,path_join(directory,"missing.json")],[path,path_join(directory,"corrupt.json")]] {
   let called=false;out=use(targets,fn(_items){called=true;return map{ok:true,value:nil};});
   let count=if targets[0]==path {1} else {0};
   assert(not called and not out.ok and out.stage=="acquire" and out.acquired_count==count and out.cleanups_attempted==count
    and out.cleanup_ok and out.body_status=="exception" and not out.original_error_available,"real partial acquisition result");cases=cases+1;
  }
 }
 assert(cases==24,"12 real cases per route");print "pbai_checkpoint_batch_real_pass:"+str(cases);
} else {throw "select batch real or faults";}
