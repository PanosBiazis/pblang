// Trusted test driver: only the selected backend runs; supplied source is data.
let Checked = import("stdlib:compiler/checked_source.sapp");
let WASM = import("stdlib:codegen_wasm.sapp");
let ARM = import("stdlib:codegen_arm64_ast.sapp");
let X64 = import("stdlib/native/codegen_x64.sapp");
let args = os_args();
let backend = args[len(args) - 2];
let mode = args[len(args) - 1];
let cases = json_parse(fs_read("tests/fixtures/backend_admission_cases.json"));
let source = cases.valid;
let bytes = 1048576;
let tokens = 65536;
if map_has(cases, mode) and mode != "invalid_cap" { source = cases[mode]; }
elif mode == "bytes" { bytes = 8; }
elif mode == "tokens" { tokens = 3; }
elif mode == "cap" { bytes = cases.invalid_cap; }
elif mode != "valid" { throw "unknown fixture mode"; }
if backend == "xexpr" and mode == "valid" { source = "7;"; }
if backend == "checked" { Checked.parse_source(source, bytes, tokens); }
elif backend == "wasm" { WASM.compile_wasm(source); }
elif backend == "arm" { ARM.compile_ast(source); }
elif backend == "elf" { ARM.compile_elf(source); }
elif backend == "xexpr" { X64.compile_expr_exit(source); }
elif backend == "xprogram" { X64.compile_program(source); }
elif backend == "xfns" { X64.compile_fns(source); }
elif backend == "xsafe" { X64.compile_safe(source); }
else { throw "unknown fixture backend"; }
print "backend_admission_probe_pass";
