// Synthetic Greek presentation check. Native preference callbacks are not exported.
let D=import("stdlib:browser_document.sapp");let V=import("stdlib:browser_view.sapp");
let UI=import("stdlib:modern_ui.sapp");
let doc=D.create("Οδηγός ανάγνωσης",[
    map{tag:"p",text:"Διάλεξε γραμματοσειρά και μέγεθος. Η εστίαση πρέπει να μένει στην επιλογή σου."},
    map{tag:"p",text:"Χρησιμοποίησε Enter, Tab και Shift+Tab. Οι αλλαγές ισχύουν στο ίδιο έγγραφο."},
    map{tag:"a",text:"Επιστροφή στην αρχή",href:"pb://home"}
]);
let view=V.create(doc,map{font_family:"monospace",body_size:18});
UI.export_web("Οδηγός ανάγνωσης",view,"build/reader-preferences-web",map{theme:"dark"});
print "reader_preferences_web_export_pass";
