let App=import("../../examples/declarative_browser/app.sapp");let GUI=import("stdlib:gui.sapp");let G=import("stdlib:graphics.sapp");
let c=App.create();c.session.navigate("pb://guide");c.width=320;c.height=240;App.refresh(c);let anchor=c.reading_anchor;
let start=now_ms();let win=G.Window(320,240,"PBLang compact preferences");
G.run(win,c,fn(current,events){let changed=App.update(current,events);if now_ms()-start>60000 {current.graphics_stop=true;}return changed;},fn(current,canvas){
    GUI.draw(canvas,current.form);let bounds=true;for w in current.form.widgets {if w.x<0 or w.y<0 or w.x+w.w>current.width or w.y+w.h>current.height {bounds=false;}}
    fs_write("build/reader-compact-settings.json",json_stringify(map{settings:current.settings,focus:current.form.focus,
        width:current.width,height:current.height,bounds:bounds,layout:current.settings_layout,appearance:current.appearance,anchor:current.reading_anchor,url:current.session.snapshot().url}));
},30);
assert(not c.settings and c.session.snapshot().url=="pb://guide" and c.navigations==0,"Done preserves document");
assert(c.appearance.font_family=="serif" and c.appearance.body_size==18 and c.appearance.title_size==32 and c.appearance.font_scale==1.25 and c.appearance.line_height==1.75 and c.appearance.density=="compact","all settings changed through real input");
assert(c.reading_anchor==anchor,"preference pages preserve reading position");c.session.close();print "reader_compact_settings_native_pass";
