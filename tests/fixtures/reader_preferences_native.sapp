let App=import("../../examples/declarative_browser/app.sapp");
let D=import("stdlib:browser_document.sapp");let S=import("stdlib:browser_session.sapp");
let G=import("stdlib:graphics.sapp");let GUI=import("stdlib:gui.sapp");
let mode=try env_get("PBLANG_FOCUS_PROBE") catch "after";if mode==nil {mode="after";}
assert(mode=="before" or mode=="after","bounded native probe mode");
let pages=App.pages();pages["pb://guide"]=D.export_html(D.create("Οδηγός ανάγνωσης",[
    map{tag:"p",text:"Διάλεξε γραμματοσειρά και μέγεθος. Η εστίαση πρέπει να μένει στην επιλογή σου."},
    map{tag:"p",text:"Χρησιμοποίησε Enter, Tab και Shift+Tab. Οι αλλαγές ισχύουν στο ίδιο έγγραφο."},
    map{tag:"a",text:"Επιστροφή στην αρχή",href:"pb://home"}
]));
let c=App.create();c.session.close();c.session=S.create(pages);c.session.navigate("pb://guide");
c.width=390;c.height=844;App.refresh(c);c.form.focus="appearance";
let started=now_ms();let win=G.Window(390,844,"PBLang reader preference focus");
G.run(win,c,fn(current,events){
    let changed=App.update(current,events);
    if now_ms()-started>(if mode=="before" {11000} else {18000}) {current.graphics_stop=true;}
    return changed;
},fn(current,canvas){
    GUI.draw(canvas,current.form);
    fs_write("build/reader-focus-"+mode+".json",json_stringify(map{
        settings:current.settings,focus:current.form.focus,family:current.appearance.font_family,
        body_size:current.appearance.body_size,url:current.session.snapshot().url
    }));
},30);
let state=map{settings:c.settings,focus:c.form.focus,family:c.appearance.font_family,
    body_size:c.appearance.body_size,url:c.session.snapshot().url};
if mode=="before" {
    assert(c.settings and c.form.focus==nil and c.appearance.font_family=="serif","reproduce lost focus after preference update");
} else {
    assert(not c.settings and c.form.focus=="appearance" and c.appearance.font_family=="monospace"
        and c.appearance.body_size==18 and state.url=="pb://guide","complete keyboard preference journey preserves Greek page");
}
c.session.close();print json_stringify(state);
