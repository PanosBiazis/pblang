// Synthetic installed-test adapter, never a production backend switch.
let state=map{fail:0,mode:"normal",loads:0,order:[],handles:[]};
fn configure(fail,mode){state.fail=fail;state.mode=mode;state.loads=0;state.order=[];state.handles=[];}
fn stats(){return map{loads:state.loads,order:state.order,handles:state.handles};}
fn _handle(id,mode){
 let item=map{id:id,closed:false};
 item.close=fn(){
  push(state.order,id);
  if mode=="throw" {throw "synthetic private cleanup failure";}
  if mode=="nil" {return nil;}if mode=="number" {return 1;}if mode=="string" {return "synthetic private result";}
  if mode=="map" {return map{ok:true};}if mode=="cycle" {let cycle=[];push(cycle,cycle);return cycle;}
  if item.closed {return false;}item.closed=true;return true;
 };
 return item;
}
fn load_file(_path){
 state.loads=state.loads+1;if state.loads==state.fail {throw "synthetic private acquisition failure";}
 let handle=_handle(state.loads,state.mode);push(state.handles,handle);return handle;
}
export configure,stats,load_file;
