// Test-only observer of actual returned handles; never a replacement model.
let _caller_probe=map{enabled:false,mode:"success",target:"checkpoint",rows:[],injected:false};
fn caller_probe_configure(mode,target){_caller_probe.enabled=true;_caller_probe.mode=mode;_caller_probe.target=target;_caller_probe.rows=[];_caller_probe.injected=false;}
fn _caller_probe_acquire(kind){
 if _caller_probe.enabled and _caller_probe.mode=="acquire_failure" {
  let wanted=if _caller_probe.target=="review" {"review"} else {"loaded"};
  if kind==wanted {_caller_probe.injected=true;throw "synthetic acquisition failure";}
 }
}
fn _caller_probe_wrap(handle,kind){
 if not _caller_probe.enabled {return handle;}
 let row=map{kind:kind,close:handle.close,predict:handle.predict,checkpoint:handle.checkpoint,close_calls:0,first_closes:0};
 push(_caller_probe.rows,row);
 handle.close=fn(){row.close_calls=row.close_calls+1;let result=row.close();if result {row.first_closes=row.first_closes+1;}return result;};
 handle.checkpoint=fn(){
  if _caller_probe.mode=="export_failure" and kind=="distill" {_caller_probe.injected=true;throw "synthetic export failure";}
  return row.checkpoint();
 };
 handle.predict=fn(ids){
  if _caller_probe.mode=="use_failure" and kind=="review" {_caller_probe.injected=true;return row.predict([]);}
  return row.predict(ids);
 };
 if map_has(handle,"evaluate") {
  row.evaluate=handle.evaluate;
  handle.evaluate=fn(examples){
   if _caller_probe.mode=="use_failure" and (kind=="loaded" or kind=="continuation") {_caller_probe.injected=true;return row.evaluate([]);}
   return row.evaluate(examples);
  };
 }
 return handle;
}
fn caller_probe_observe(){
 let rows=[];
 for row in _caller_probe.rows {
  let predict_closed=try {row.predict([6,0]);false} catch true;
  let checkpoint_closed=try {row.checkpoint();false} catch true;
  // Observe original aliases before diagnostic cleanup; do not count the probe's close.
  push(rows,map{kind:row.kind,predict_closed:predict_closed,checkpoint_closed:checkpoint_closed,
   close_calls:row.close_calls,first_closes:row.first_closes});
  row.close();
 }
 return map{injected:_caller_probe.injected,rows:rows};
}
export caller_probe_configure,caller_probe_observe;
