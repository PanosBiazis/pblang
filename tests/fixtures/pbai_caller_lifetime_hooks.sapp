// Test-only observer of actual returned handles; never a replacement model.
let _caller_probe=map{enabled:false,mode:"success",target:"checkpoint",rows:[],injected:false,attempts:0};
fn caller_probe_configure(mode,target){_caller_probe.enabled=true;_caller_probe.mode=mode;_caller_probe.target=target;_caller_probe.rows=[];_caller_probe.injected=false;_caller_probe.attempts=0;}
fn _caller_probe_acquire(kind){
 if _caller_probe.enabled and _caller_probe.mode=="construction_failure" and kind=="distill" {_caller_probe.injected=true;throw "synthetic initial construction failure";}
 if _caller_probe.enabled {_caller_probe.attempts=_caller_probe.attempts+1;}
 if _caller_probe.enabled and _caller_probe.target=="checkpoint_reload_reviewed" and _caller_probe.mode=="acquire_failure" {
  if kind=="distill" and _caller_probe.attempts==2 {_caller_probe.injected=true;throw "synthetic later acquisition failure";}
  return;
 }
 if _caller_probe.enabled and _caller_probe.target=="checkpoint_file_guarded" and _caller_probe.mode=="replacement_acquire_failure" and kind=="loaded" and _caller_probe.attempts==2 {throw "synthetic replacement acquisition failure";}
 if _caller_probe.enabled and _caller_probe.mode=="loaded_acquire_failure" and kind=="loaded" {_caller_probe.injected=true;throw "synthetic restore acquisition failure";}
 if _caller_probe.enabled and _caller_probe.mode=="acquire_failure" {
  let wanted=if (_caller_probe.target=="review" or _caller_probe.target=="review_close") {"review"} else {"loaded"};
  if kind==wanted {_caller_probe.injected=true;throw "synthetic acquisition failure";}
 }
}
fn _caller_probe_wrap(handle,kind){
 if not _caller_probe.enabled {return handle;}
 let row=map{kind:kind,close:handle.close,predict:handle.predict,checkpoint:handle.checkpoint,close_calls:0,first_closes:0,export_digests:[]};
 row.private_batch=_caller_probe.target=="tools" and kind=="loaded" and len(_caller_probe.rows)==2;
 push(_caller_probe.rows,row);
 handle.close=fn(){
  row.close_calls=row.close_calls+1;
  let mode=_caller_probe.mode;let file=_caller_probe.target=="checkpoint_file" or _caller_probe.target=="checkpoint_file_guarded";
  if file and (mode=="close_before" or mode=="export_close_before" or mode=="loaded_use_close_before") {throw "synthetic close before release";}
  let result=row.close();if result {row.first_closes=row.first_closes+1;}
  if file and (mode=="close_after" or mode=="save_close_after") {throw "synthetic close after release";}
  if file and mode=="close_invalid" {return "invalid-close-result";}
  return result;
 };
 handle.checkpoint=fn(){
  if (_caller_probe.mode=="export_failure" or _caller_probe.mode=="export_close_before") and (kind=="distill" or _caller_probe.target=="checkpoint_file_guarded") {_caller_probe.injected=true;throw "synthetic export failure";}
  if _caller_probe.mode=="review_export_failure" and kind=="review" {_caller_probe.injected=true;throw "synthetic review export failure";}
  let artifact=row.checkpoint();push(row.export_digests,sha256(json_stringify(artifact)));return artifact;
 };
 handle.predict=fn(ids){
  if _caller_probe.mode=="use_failure" and kind=="review" {_caller_probe.injected=true;return row.predict([]);}
  if (_caller_probe.mode=="loaded_use_failure" or _caller_probe.mode=="loaded_use_close_before") and kind=="loaded" {_caller_probe.injected=true;return row.predict([]);}
  if (_caller_probe.mode=="distill_predict_failure" and kind=="distill") or (_caller_probe.mode=="tool_failure" and row.private_batch) {_caller_probe.injected=true;return row.predict([]);}
  return row.predict(ids);
 };
 if map_has(handle,"evaluate") {
  row.evaluate=handle.evaluate;
  handle.evaluate=fn(examples){
   if _caller_probe.mode=="use_failure" and (kind=="loaded" or kind=="continuation") {_caller_probe.injected=true;return row.evaluate([]);}
   if _caller_probe.mode=="distill_evaluate_failure" and kind=="distill" {_caller_probe.injected=true;return row.evaluate([]);}
   return row.evaluate(examples);
  };
 }
 return handle;
}
fn caller_probe_observe(){
 let rows=[];
 for row in _caller_probe.rows {
  let predict_closed=try {row.predict([6,0]);false} catch true;
  let checkpoint_closed=try {row.checkpoint();false} catch true;
  // Observe original aliases before diagnostic cleanup; do not count the probe's close.
  push(rows,map{kind:row.kind,predict_closed:predict_closed,checkpoint_closed:checkpoint_closed,
   close_calls:row.close_calls,first_closes:row.first_closes,export_digests:row.export_digests});
  row.close();
 }
 return map{injected:_caller_probe.injected,rows:rows};
}
export caller_probe_configure,caller_probe_observe;
