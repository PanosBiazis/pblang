let G=import("stdlib:graphics.sapp");let UI=import("stdlib:gui.sapp");
let f=UI.form("HF03 Textarea",520,200);let w=UI.textarea("entry",20,40,460,80,"");UI.add(f,w);f.focus="entry";
let win=G.Window(f.w,f.h,f.title,map{ordered_input:true});let started=now_ms();let changes=[];let received=[];
G.run(win,f,fn(current,events){for event in events {if len(received)<256 {push(received,event);}let before=w.value;UI.handle_event(current,event);if w.value!=before and len(changes)<256 {push(changes,map{event:event,value:w.value});}}if now_ms()-started>4500 {current.graphics_stop=true;}return current.dirty;},fn(current,canvas){UI.draw(canvas,current);},60);
let path=env_get("HF03_OUT");fs_write(path,w.value);let reopened=fs_read(path);print json_stringify(map{value:w.value,reopened:reopened,changes:changes,received:received,input_backend:win.input_backend});
