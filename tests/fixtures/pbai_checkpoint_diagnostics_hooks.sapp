
let _diagnostic_rows=[];
fn diagnostic_probe_reset(){_diagnostic_rows=[];}
fn _diagnostic_wrap(handle){
 let row=map{predict:handle.predict,checkpoint:handle.checkpoint,close:handle.close,first_closes:0};
 push(_diagnostic_rows,row);
 handle.close=fn(){let result=row.close();if result {row.first_closes=row.first_closes+1;}return result;};return handle;
}
fn diagnostic_probe_observe(){let out=[];for row in _diagnostic_rows {
 let closed=try {row.predict([6,0]);false} catch true;let export_closed=try {row.checkpoint();false} catch true;
 assert(closed==export_closed,"original aliases agree");push(out,map{closed:closed,first_closes:row.first_closes});row.close();
 }return out;
}
export diagnostic_probe_reset,diagnostic_probe_observe;
