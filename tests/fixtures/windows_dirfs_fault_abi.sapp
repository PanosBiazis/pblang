// Deterministic model only: no FFI, memory addresses or operating-system handles.
let model=map{next:100,sizes:map{},written:0,renames:0,deletes:0,fail_close:false,fail_rename:false};
fn reset(fail_close,fail_rename) {model.fail_close=fail_close;model.fail_rename=fail_rename;model.renames=0;model.deletes=0;}
fn allocate(state,size) {model.next=model.next+100;model.sizes[str(model.next)]=size;return model.next;}
fn free(state,pointer) {map_remove(model.sizes,str(pointer));return true;}
fn write_u8(state,pointer,offset,value) {return true;}
fn write_u16(state,pointer,offset,value) {return true;}
fn write_u32(state,pointer,offset,value) {return true;}
fn write_u64(state,pointer,offset,value) {return true;}
fn write_bytes(state,pointer,offset,bytes) {return true;}
fn read_u64(state,pointer,offset) {return 11;}
fn read_u32(state,pointer,offset) {
    if model.sizes[str(pointer)]==8 {return if offset==0 {16} else {0};}
    return model.written;
}
fn read_bytes(state,pointer,offset,count) {let out=[];for i count {array_push(out,0);}return out;}
fn call_dirfs(state,name,args) {
    let value=1;
    if name=="MultiByteToWideChar" {value=2;}
    elif name=="NtCreateFile" {value=0;}
    elif name=="WriteFile" {model.written=args[2];}
    elif name=="NtSetInformationFile" {model.renames=model.renames+1;value=if model.fail_rename {-1} else {0};}
    elif name=="CloseHandle" {value=if model.fail_close {0} else {1};}
    elif name=="SetFileInformationByHandle" {model.deletes=model.deletes+1;}
    elif name=="GetLastError" {value=5;}
    return map{ok:true,value:value};
}
fn counts() {return map{renames:model.renames,deletes:model.deletes,buffers:len(map_keys(model.sizes))};}
export reset,allocate,free,write_u8,write_u16,write_u32,write_u64,write_bytes;
export read_u64,read_u32,read_bytes,call_dirfs,counts;
