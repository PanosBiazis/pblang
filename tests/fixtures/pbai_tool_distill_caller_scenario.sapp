// Real caller observation; this fixture never substitutes a numerical model.
fn _caller_workflow(){throw "test harness must supply the real caller";}
let N=import("stdlib:pbai_neural_adapter.sapp");
let target=env_get("PBAI_CALLER_TARGET");let fixed=env_get("PBAI_CALLER_LIFETIME_PHASE")!="baseline";
let teacher=N.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let seed=N.distill(teacher.artifact,[[0]],[map{x:[7,0],y:4}]);
let checkpoint=seed.checkpoint();let active=N.student_load(checkpoint);assert(seed.close(),"independent seed cleanup");
let original=json_stringify(active.predict([6,0]));let original_checkpoint=json_stringify(active.checkpoint());let rows=[];
let modes=["success","distill_evaluate_failure","construction_failure","success"];
if target=="distillation" {modes=["success","distill_evaluate_failure","distill_predict_failure","construction_failure","success"];}
if target=="tools" {modes=["success","export_failure","loaded_use_failure","acquire_failure","tool_failure","success"];}
for mode in modes {
 N.caller_probe_configure(mode,target);
 let succeeded=try {_caller_workflow();true} catch false;
 let observed=N.caller_probe_observe();let failed=mode!="success" and mode!="tool_failure";
 assert(succeeded!=failed and observed.injected==(mode!="success"),"real caller outcome and requested failure reached");
 let closed=0;let live=0;
 for row in observed.rows {
  assert(row.predict_closed==row.checkpoint_closed,"saved original methods agree about lifetime");
  if row.predict_closed {closed=closed+1;} else {live=live+1;}
  if fixed {assert(row.first_closes==1 and row.predict_closed,"actual owner retired each acquired handle exactly once");}
 }
 let expected_acquired=1;
 if mode=="construction_failure" {expected_acquired=0;}
 let expected_live=0;
 if mode=="distill_evaluate_failure" or mode=="distill_predict_failure" {expected_live=1;}
 if target=="tools" {
  expected_live=1;
  if mode=="loaded_use_failure" {expected_live=2;expected_acquired=2;}
  if mode=="success" or mode=="tool_failure" {
   expected_acquired=3;
   // Batch provider owns its private loaded handle; its worker only borrows it.
   let borrowed=observed.rows[2];assert(borrowed.kind=="loaded" and borrowed.first_closes==1 and borrowed.predict_closed,"tool provider still closes its own borrowed-worker handle");
  }
 }
 assert(len(observed.rows)==expected_acquired,"exact construction count, including no handle on constructor failure");
 if not fixed {assert(live==expected_live,"baseline distinguishes already-correct success from missing exception cleanup");}
 assert(json_stringify(active.predict([6,0]))==original and json_stringify(active.checkpoint())==original_checkpoint,"independent caller model and checkpoint preserved");
 push(rows,map{mode:mode,succeeded:succeeded,acquired:len(observed.rows),closed:closed,live:live,handles:observed.rows});
}
assert(active.close(),"independent caller cleanup");
print json_stringify(map{format:"pbai.caller-lifetime.v1",target:target,benchmark:false,phase:if fixed {"fixed"} else {"baseline"},cases:len(rows),rows:rows,active_preserved:true,physical_memory_release_verified:false});
