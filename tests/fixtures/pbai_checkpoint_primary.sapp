let AI=import("stdlib/pbai.sapp");let N=import("stdlib:pbai_neural_adapter.sapp");
let IO=import("stdlib:pbai_student_checkpoint_io.sapp");let S=import("stdlib:pbai_checkpoint_scope.sapp");
let bound=AI.neural_specialist_checkpoint_batch_bind(S);let fixed=env_get("PBAI_PRIMARY_PHASE")!="baseline";
let directory=env_get("PBAI_CHECKPOINT_TEST_DIR");let path=path_join(directory,"student.json");
let teacher=N.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let seed=N.distill(teacher.artifact,[[0]],[map{x:[7,0],y:4}]);let artifact=seed.checkpoint();assert(seed.close(),"seed owned");
assert(IO.save_new(path,artifact).ok,"real private file setup");
let original=fs_read(path);let independent=N.student_load(artifact);let prediction=json_stringify(independent.predict([6,0]));
let rows=[];let legacy=[];
for route in [map{name:"direct",use:S.with_files},map{name:"binding",use:bound.with_files}] {
 for failure in [map{name:"missing",error:"checkpoint could not be read within private storage bounds"},
  map{name:"encoding",error:"invalid student checkpoint encoding"}] {
  for mode in ["normal","already_closed","nil","throw_after","throw_before","recover"] {
   N.primary_probe_reset(mode);let called=false;let paths=[path,path_join(directory,failure.name+".json")];let before=json_stringify(paths);
   let out=route.use(paths,fn(_handles){called=true;return map{ok:true,value:nil};});
   assert(not called and not out.ok and out.stage=="acquire" and out.acquired_count==1
    and out.cleanups_attempted==1 and out.value==nil,"partial load stops before callback");
   assert(out.acquisition_error==map{index:1,error:failure.error},"diagnostic unchanged");
   if fixed {assert(out.error==failure.error and out.original_error_available and out.body_status=="returned"
    and out.body_result==map{ok:false,error:failure.error},"known primary survives cleanup independently");}
   else {assert(out.error==nil and not out.original_error_available and out.body_status=="exception" and out.body_result==nil,"baseline discards primary");}
   let cleanup_ok=mode=="normal" or mode=="already_closed" or mode=="recover";
   assert(out.cleanup_ok==cleanup_ok and len(out.cleanup_errors)==(if cleanup_ok {0} else {1}),"cleanup outcome separately recorded");
   if not cleanup_ok {let error=out.cleanup_errors[0];assert(error.id==0
    and error.kind==(if mode=="nil" {"error_result"} else {"exception"}),"fixed cleanup classification");
    if mode=="nil" {assert(error.result==map{ok:false,error:"invalid checkpoint close result"},"malformed closer bounded error");}}
   let observed=N.primary_probe_observe();assert(len(observed)==1 and observed[0].attempts==1
    and observed[0].closed==(mode!="throw_before") and observed[0].diagnostic_close==(mode=="throw_before"),"logical lifetime before test cleanup");
   assert(fs_read(path)==original and json_stringify(paths)==before and json_stringify(independent.predict([6,0]))==prediction,"files,request,independent owner unchanged");
   assert(not str_contains(json_stringify(out),directory) and not str_contains(json_stringify(out),"synthetic private"),"no private backend detail");
   push(rows,map{route:route.name,mode:mode,failure:failure.name,primary_available:out.original_error_available,observed:observed});
   // Compare every other public field, including acquisition and cleanup reports.
   for field in ["error","original_error_available","body_status","body_result"] {map_remove(out,field);}
   push(legacy,out);
  }
 }
 for mode in ["success","body_error","body_throw","first_missing"] {
  N.primary_probe_reset("normal");let called=false;let targets=if mode=="first_missing" {[path_join(directory,"missing.json")]} else {[path]};
  let out=route.use(targets,fn(handles){called=true;
   if mode=="body_error" {assert(handles[0].close(),"application early close");return map{ok:false,error:"synthetic explicit primary"};}
   if mode=="body_throw" {throw "synthetic private body detail";}
   return map{ok:true,value:handles[0].predict([6,0])};
  });
  if mode=="first_missing" {
   assert(not called and out.acquired_count==0 and out.cleanups_attempted==0 and out.cleanup_ok,"absent handle has no cleanup");
   assert(out.original_error_available==fixed and out.body_status==(if fixed {"returned"} else {"exception"}),"first rejection primary");
   if fixed {assert(out.error==out.acquisition_error.error and out.body_result==map{ok:false,error:out.error},"first error retained");}
  } else {
   assert(called and out.stage=="body" and out.cleanups_attempted==1 and out.cleanup_ok,"body path unchanged");
   if mode=="body_error" {assert(out.error=="synthetic explicit primary" and out.original_error_available,"early-close false preserves application primary");}
   if mode=="body_throw" {assert(out.error==nil and not out.original_error_available and out.body_status=="exception","unknown original exception remains opaque");}
   if mode=="success" {assert(out.ok and out.value.token==independent.predict([6,0]).token,"success unchanged");}
   push(legacy,out);
  }
  let observed=N.primary_probe_observe();for item in observed {assert(item.closed and item.attempts==(if mode=="body_error" {2} else {1}) and not item.diagnostic_close,"body-owned closure");}
  push(rows,map{route:route.name,mode:mode,failure:"",primary_available:out.original_error_available,observed:observed});
 }
}
assert(json_stringify(independent.predict([6,0]))==prediction and independent.close(),"independent owner retained and closed");
print json_stringify(map{format:"pbai.checkpoint-primary.v1",rows:rows,legacy:legacy,independent_preserved:true});
