let S=import("stdlib:llm_tiered_store.sapp");let D=import("stdlib:linux_dirfs.sapp");let F=import("streaming.sapp");
let completed=0;
for facade in [false,true] {
 for mode in ["ok","false","throw","nil","number","string","mixed"] {
  let state=map{session:nil,callback_seen:false};
  D.configure(mode,fn(){
   state.callback_seen=true;let b=state.session;
   assert(not S.status(b).ok and S.status(b).cleanup.attempted,"terminal before callback");
   assert(S.status(b).resident_bytes==0 and S.status(b).queued_prefetch==0,"cache detached before cleanup callback");
   let cyclic=[];push(cyclic,cyclic);
   assert(S.load(b,cyclic).code=="closed" and S.queue_prefetch(b,cyclic).code=="closed","reentrant operations rejected before argument inspection");
   assert(not S.close(b) and D.calls()==1,"reentrant close cannot retry handles");
   let snapshot=S.status(b);snapshot.cleanup.unconfirmed_handles=999;snapshot.cleanup.first_error="caller-edited";snapshot.cached_shards=999;
  });
  let parts=[S.model_part("a","a.bin",4,sha256(base64_encode_bytes([1,2,3,4]))),S.model_part("b","b.bin",4,sha256(base64_encode_bytes([1,2,3,4])))];
  let options=map{ram_budget_bytes:4,mirrors:[S.mirror("synthetic-two"),S.mirror("synthetic-three")]};
  let b=if facade {F.open("synthetic-primary",parts,options)} else {S.create("synthetic-primary",parts,S.config(4,options))};state.session=b;
  assert(b.ok,"fixture store created");let before=S.status(b);let before_json=json_stringify(before);
  let result=if facade {F.load_weight(b,"a")} else {S.load(b,"a")};assert(result.ok,"fixture read verifies bytes");let bytes_json=json_stringify(result.bytes);
  D.fail_reads();let failed=S.load(b,"b");assert(not failed.ok,"primary operation error created");let error_json=json_stringify(failed);
  assert(S.queue_prefetch(b,["b"]).ok,"pending work queued");
  let closed=if facade {F.close(b)} else {S.close(b)};
  assert(type(closed)=="bool" and closed==(mode=="ok"),"boolean result requires every close confirmed");
  let after=if facade {F.status(b)} else {S.status(b)};
  let expected=map{unconfirmed:1,code:"close_invalid_result"};
  if mode=="ok" {expected.unconfirmed=0;expected.code=nil;}
  if mode=="mixed" {expected.unconfirmed=3;}
  if mode=="false" or mode=="mixed" {expected.code="close_unconfirmed";}
  if mode=="throw" {expected.code="close_threw";}
  assert(not after.ok and after.cleanup.attempted and not after.cleanup.retry_supported,"closed regardless of cleanup result");
  assert(after.cleanup.confirmed_handles==3-expected.unconfirmed and after.cleanup.unconfirmed_handles==expected.unconfirmed and after.cleanup.first_error==expected.code,"all handles attempted and first bounded error preserved");
  assert(state.callback_seen and D.calls()==3 and D.ids()==[1,2,3],"one attempt per handle including later roots");
  assert(after.cached_shards==0 and after.queued_prefetch==0 and after.resident_bytes==0,"failure cannot retain active cache or queue");
  let saved=json_stringify(after);assert(not S.close(b) and D.calls()==3,"repeated close performs no ambiguous retry");
  for entry in b.roots {assert(entry.handle==nil and not entry.available,"uncertain handle detached");}
  assert(json_stringify(S.status(b))==saved and json_stringify(before)==before_json,"status snapshots remain detached");
  assert(json_stringify(failed)==error_json and json_stringify(result.bytes)==bytes_json,"cleanup never replaces primary error or prior bytes");
  assert(not str_contains(saved,"synthetic-private-detail") and not str_contains(saved,"synthetic-primary"),"cleanup status excludes exceptions and root names");
  completed=completed+1;
 }
}
assert(completed==14,"all direct and facade fault cases executed");
print "pbai_close_fault_cases_pass:14";
