// Synthetic diagnostic only. Driver supplies a private temporary output path.
let GUI=import("stdlib:gui.sapp");let G=import("stdlib:graphics.sapp");
let f=GUI.form("PBLang Input Boundary",640,220);GUI.add(f,GUI.textbox("entry",20,60,590,36,""));f.focus="entry";
let started=now_ms();let received=[];let edits=[];
G.run(G.Window(f.w,f.h,f.title),f,fn(current,events){
 for event in events {
  let before=GUI.get(current,"entry").value;
  if len(received)<256 {push(received,event);}
  GUI.handle_event(current,event);
  let after=GUI.get(current,"entry").value;
  if before!=after and len(edits)<256 {push(edits,map{event:event,before:before,after:after});}
 }
 if now_ms()-started>=3500 {current.graphics_stop=true;}
 return current.dirty;
},fn(current,canvas){GUI.draw(canvas,current);},30);
let value=GUI.get(f,"entry").value;let path=env_get("PBLANG_INPUT_DIAG_OUT");fs_write(path,value);
let reopened=fs_read(path);assert(reopened==value,"synthetic save/reopen matches GUI value");
print json_stringify(map{backend:gfxbackendprofile(),received:received,edits:edits,value:value,reopened:reopened});
