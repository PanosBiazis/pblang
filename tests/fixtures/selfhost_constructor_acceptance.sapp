// Guest catches and borrowed contexts retain their numeric-constructor memory.
let F=import("stdlib:compiler/selfhost_frontend.sapp");let V=import("stdlib:compiler/vm.sapp");
let setup=F.frontend_compile("memory_alloc(7);").chunk;
for expression in ["call1(bigint,0.5)", "call1(decimal,\"bad\")", "call1(rational,\"1/0\")", "call2(rational,1,0)"] {
    let prefix="fn call1(f,a){return f(a);}fn call2(f,a,b){return f(a,b);}";
    let c=V.execution_context(true);V.run_seeded(setup,map{},c);let m=c.memory;
    let code=F.frontend_compile(prefix+"print try "+expression+" catch memory_get(1);");assert(code.ok,"caught source");
    assert(V.run_seeded_bounded(code.chunk,map{},nil,c).output==[7] and not m.closed and c.handlers==0,"caught owner stays live");V.close_execution(c);
    let b=V.execution_context();V.run_seeded(setup,map{},b);let bm=b.memory;
    let fail=F.frontend_compile(prefix+expression+";");assert(fail.ok,"borrowed source");
    assert((try {V.run_seeded(fail.chunk,map{},b);false} catch true),"borrowed error");
    assert(not bm.closed and len(bm.owners)==1,"caller retains memory");V.close_execution(b);
}
print "selfhost_constructor_acceptance_pass";
