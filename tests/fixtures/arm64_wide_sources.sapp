// Deterministic sources shared by fast compilation and opt-in execution probes.
fn call_source(n, observed = false) {
    let params="";let args="";
    for i in range(0,n){
        if i>0 {params=params+",";args=args+",";}
        params=params+"a"+str(i);
        let value="0";
        if observed {
            if i==0 {value="tap(1)";} elif i==7 {value="7";} elif i==8 {value="8";} elif i==n-1 {value="tap(26)";}
        }
        args=args+value;
    }
    if not observed {return "fn f("+params+"){return 42;}return f("+args+");";}
    return "fn tap(n){print n;return n;}fn f("+params+"){return a0+a7+a8+a"+str(n-1)+";}"
        +"fn outer(){let saved=42;let result=f("+args+");return result+saved-42;}return 1+outer()-1;";
}
fn array_source(n, observed = false) {
    if not observed {return "let a=["+str_repeat("0,",n-1)+"0];return 42;";}
    return "fn value(){return 29;}let a=[13,"+str_repeat("0,",n-2)+"value()];let b=[7];"
        +"if len(a)!="+str(n)+" or b[0]!=7{return 0;}return a[0]+a["+str(n-1)+"];";
}
fn map_source(n, observed = false) {
    let src="let m=map{";
    for i in range(0,n){
        if i>0 {src=src+",";}
        let value="0";
        if observed {if i==0 {value="13";} elif i==n-1 {value="value()";}}
        src=src+"k"+str(i)+":"+value;
    }
    if not observed {return src+"};return 42;";}
    return "fn value(){return 29;}"+src+"};let b=[7];if b[0]!=7{return 0;}return m.k0+m.k"+str(n-1)+";";
}
export call_source, array_source, map_source;
