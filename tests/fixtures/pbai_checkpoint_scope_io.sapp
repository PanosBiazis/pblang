// Private installed-test replacement only, never an application backend option.
let state=map{mode:"normal",loads:0,closes:0};
fn configure(mode){state.mode=mode;state.loads=0;state.closes=0;}
fn stats(){return map{loads:state.loads,closes:state.closes};}
fn load_file(_path){
 state.loads=state.loads+1;
 if state.mode=="load-throw" {throw "checkpoint could not be read within private storage bounds";}
 let mode=state.mode;let closed=false;
 return map{close:fn(){
  state.closes=state.closes+1;
  if mode=="close-throw" {throw "synthetic-private-cleanup-error";}
  if mode=="close-nil" {return nil;}
  if mode=="close-number" {return 1;}
  if mode=="close-string" {return "synthetic-private-close-result";}
  if mode=="close-map" {return map{ok:true};}
  if mode=="close-cycle" {let cycle=[];push(cycle,cycle);return cycle;}
  if closed {return false;}closed=true;return true;
 }};
}
export configure,stats,load_file;
