let A = import("stdlib:aes_gcm.sapp");

fn require_equal(actual, expected, stage) {
    if actual != expected { throw "AES C99 differential failed at " + stage; }
    print stage + "_pass";
}

require_equal(
    A.bytes_hex(A.hmac_sha256_bytes(str_to_bytes("Hi There"), [
        0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,
        0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,0x0b
    ])),
    "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7",
    "hmac");

require_equal(
    A.bytes_hex(A.pbkdf2_hmac_sha256(str_to_bytes("password"), str_to_bytes("salt"), 1, 32)),
    "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b",
    "pbkdf2_round_1");

require_equal(
    A.bytes_hex(A.pbkdf2_hmac_sha256(str_to_bytes("password"), str_to_bytes("salt"), 2, 32)),
    "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43",
    "pbkdf2_round_2");
