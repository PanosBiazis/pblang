let S = import("stdlib:secure_file.sapp");

let raw = try env_get("PBLANG_SCRIPT_ARGS") catch "";
let args = if raw == nil or raw == "" { [] } else { str_split(raw, "\n") };
if len(args) != 1 { throw "deny-exec content probe requires one root"; }

let handle = S.open_bounded_enumerator(args[0], 60000);
if not handle.ok { throw "deny-exec content probe cannot hold root"; }
let page = S.enumerate_bounded(handle, "", 8);
let file = nil;
for entry in try page.entries catch [] {
    if (try entry.name catch "") == "file" { file = entry; }
}
let loaded = if file == nil { map{ ok: false } }
    else { S.read_bounded_enumerator_file(handle, file.content_token, 16) };
let closed = S.close_bounded_enumerator(handle);
if not page.ok or file == nil or not loaded.ok or not closed
   or loaded.bytes != str_to_bytes("f") {
    throw "deny-exec content probe failed";
}
print "linux_bounded_content_deny_exec_pass";
