let GUI=import("stdlib:gui.sapp");let G=import("stdlib:graphics.sapp");
let f=GUI.form("PBLang Keyboard Delivery",640,320);let toggles=0;let disabled=0;let buttons=0;
GUI.add(f,GUI.label("title",20,16,"Native keyboard delivery"));
GUI.add(f,GUI.checkbox("active",20,54,"Active",false,fn(current){toggles=toggles+1;}));
let locked=GUI.checkbox("locked",20,88,"Disabled",false,fn(current){disabled=disabled+1;});locked.enabled=false;GUI.add(f,locked);
GUI.add(f,GUI.textbox("entry",20,130,590,34,""));
GUI.add(f,GUI.button("done",20,190,180,36,"Done",fn(current){buttons=buttons+1;}));
let started=now_ms();let events_log=[];let presents=0;let draws=0;let polls=0;
let ordered=env_get("PBLANG_INPUT_ORDERED")=="1";
let win=G.Window(f.w,f.h,f.title,map{ordered_input:ordered});let original_present=win.present;let original_poll=win.pollEvents;
win.present=fn(){presents=presents+1;original_present();};
win.pollEvents=fn(){polls=polls+1;return original_poll();};
G.run(win,f,fn(current,events){
 for event in events {if len(events_log)<200 {push(events_log,event);}GUI.handle_event(current,event);}
 if now_ms()-started>=11000 {current.graphics_stop=true;}
 return current.dirty;
},fn(current,canvas){draws=draws+1;GUI.draw(canvas,current);},30);
print json_stringify(map{toggles:toggles,disabled:disabled,buttons:buttons,checked:GUI.get(f,"active").checked,text:GUI.get(f,"entry").value,focus:f.focus,events:events_log,presents:presents,polls:polls,draws:draws,input_backend:win.input_backend,closed:not win.isOpen()});
