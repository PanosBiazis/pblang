let S=import("stdlib:llm_tiered_store.sapp");let D=import("stdlib:linux_dirfs.sapp");let F=import("streaming.sapp");
let parts=[S.model_part("a","a.bin",4,sha256(base64_encode_bytes([1,2,3,4])))];
fn start(facade,options) {
 if facade {return F.open("synthetic-primary",parts,options);}
 return S.create("synthetic-primary",parts,S.config(4,options));
}
fn options() {return map{ram_budget_bytes:4,mirrors:[S.mirror("synthetic-two"),S.mirror("synthetic-three")]};}
fn inert(failed) {
 let before=json_stringify(failed);let calls=json_stringify(D.snapshot());let cycle=[];push(cycle,cycle);
 assert(not S.close(failed) and not F.close(failed),"failed creation cannot retry cleanup");
 assert(S.load(failed,cycle).code=="closed" and F.run_prefetch(failed).code=="closed","failed result grants no session operations");
 assert(S.status(failed).code=="closed" and F.status(failed).code=="closed","failed result is not a session");
 assert(json_stringify(failed)==before and json_stringify(D.snapshot())==calls,"primary failure preserved without more backend effects");
 assert(not str_contains(before,"synthetic-private") and not str_contains(before,"synthetic-primary"),"raw backend text and roots are absent from failure");
}
let completed=0;
for facade in [false,true] {
 for invalid in [nil,"bad",map{},42,true] {
  D.configure();let failed=start(facade,map{mirrors:invalid});
  assert(not failed.ok and failed.code=="config" and D.snapshot().opens==0 and D.snapshot().closes==[],"invalid mirror container rejected before any acquisition");
  inert(failed);completed=completed+1;
 }
 let too_many=[];for i 65 {push(too_many,S.mirror("synthetic-extra"));}
 D.configure();let oversized=start(facade,map{mirrors:too_many});
 assert(oversized.code=="config" and D.snapshot().opens==0,"65 mirrors rejected before any acquisition");inert(oversized);completed=completed+1;
 let cycle=[];push(cycle,cycle);D.configure();
 let optional=start(facade,map{mirrors:[nil,42,map{},cycle,S.mirror("synthetic-two")]});
 assert(optional.ok and D.snapshot().opens==2 and S.close(optional),"malformed optional mirror records keep prior skip policy");completed=completed+1;
 let at_limit=[];for i 64 {push(at_limit,S.mirror("synthetic-extra"));}
 D.configure();let bounded=start(facade,map{mirrors:at_limit});
 assert(bounded.ok and D.snapshot().opens==65 and S.close(bounded) and len(D.snapshot().closes)==65,"exact mirror limit supported");completed=completed+1;
 let mutable=options();D.configure(0,"ok","ok",fn(){
  mutable.mirrors[0].root="caller-changed";mutable.mirrors[0].weight=999;
  push(mutable.mirrors,S.mirror("caller-added"));mutable.require_linux_confinement=false;
 });
 let planned=start(facade,mutable);
 assert(planned.ok and D.snapshot().paths==["synthetic-primary","synthetic-two","synthetic-three"] and planned.roots[1].weight==1,"acquisition uses a detached preflight plan");
 assert(S.close(planned),"planned session closes normally");completed=completed+1;
 D.configure(1,"unavailable");let unavailable=start(facade,options());
 assert(unavailable.code=="root" and not unavailable.acquisition_uncertain and unavailable.cleanup.confirmed_handles==0 and unavailable.cleanup.unconfirmed_handles==0 and D.snapshot().closes==[],"ordinary primary failure has no owned handles");
 assert(unavailable.error=="primary shard root is unavailable or not safely confined","existing primary root error preserved");inert(unavailable);completed=completed+1;
 D.configure(3,"unavailable");let skipped=start(facade,options());
 assert(skipped.ok and len(skipped.roots)==2 and S.close(skipped) and D.snapshot().closes==[1,2],"ordinary unavailable mirror remains optional");completed=completed+1;
 for fault in ["throw","nil","number"] {
  D.configure(1,fault);let primary=start(facade,options());
  assert(primary.code=="root" and primary.acquisition_uncertain and primary.cleanup.attempted and primary.cleanup.confirmed_handles==0 and primary.cleanup.unconfirmed_handles==0 and D.snapshot().closes==[],"unknown acquisition does not invent a cleanup owner");
  inert(primary);completed=completed+1;
  for cleanup in ["ok","false","throw","nil","number","string","mixed"] {
   D.configure(3,fault,cleanup);let failed=start(facade,options());
   assert(not failed.ok and failed.code=="root" and failed.error=="shard root initialization failed" and failed.acquisition_uncertain,"acquisition failure remains primary despite rollback outcomes");
   let expected=map{count:1,code:"close_invalid_result"};
   if cleanup=="ok" {expected.count=0;expected.code=nil;}
   if cleanup=="false" or cleanup=="mixed" {expected.code="close_unconfirmed";}
   if cleanup=="throw" {expected.code="close_threw";}
   if cleanup=="mixed" {expected.count=2;}
   assert(failed.cleanup.attempted and failed.cleanup.confirmed_handles==2-expected.count and failed.cleanup.unconfirmed_handles==expected.count and failed.cleanup.first_error==expected.code and not failed.cleanup.retry_supported,"all known owners accounted for without claiming uncertain release");
   assert(D.snapshot().opens==3 and D.snapshot().closes==[1,2],"earlier owners retired once even after rollback failure");
   inert(failed);failed.cleanup.confirmed_handles=999;assert(not F.close(failed) and D.snapshot().closes==[1,2],"editing failure diagnostics cannot revive cleanup authority");completed=completed+1;
  }
 }
}
assert(completed==70,"all direct and actual facade cases executed");
print "pbai_init_fault_cases_pass:70";
