// Test-only synthetic transport. The runner supplies a private directory/umask.
let AI=import("stdlib/pbai.sapp");
let root=env_get("PBAI_REVIEW_TEST_DIR");let phase=env_get("PBAI_REVIEW_TEST_PHASE");
if root==nil or root=="" {throw "isolated review fixture directory required";}
let parent_path=path_join(root,"parent.json");let history_path=path_join(root,"history.json");
let next_path=path_join(root,"next.json");let next_history_path=path_join(root,"next-history.json");
if phase=="seed" {
    let training=[map{x:[0],y:4},map{x:[1,0],y:4}];let holdout=[map{x:[7,0],y:4}];
    let teacher=AI.neural_specialist_train([training[0]],holdout);
    let parent=AI.neural_specialist_distill(teacher.artifact,[[0],[1,0]],holdout).checkpoint();
    fs_write(parent_path,AI.neural_specialist_student_encode(parent));
    fs_write(history_path,AI.neural_specialist_student_history_encode(parent,AI.neural_specialist_student_history(parent,training,holdout)));
} else {
    let parent=AI.neural_specialist_student_decode(fs_read(parent_path));
    let history=AI.neural_specialist_student_history_decode(parent,fs_read(history_path));
    if phase=="resume" {
        let review=AI.neural_specialist_student_continue_reviewed(parent,history,
            [map{x:[2,0],y:4},map{x:[3,0],y:4}],[map{x:[4,0],y:4}]);
        assert(review.report().passed,"persisted declared history review");review.accept();
        let next=review.checkpoint();let next_history=review.history();
        fs_write(next_path,AI.neural_specialist_student_encode(next));
        fs_write(next_history_path,AI.neural_specialist_student_history_encode(next,next_history));
        review.rollback();assert(review.checkpoint().digest==parent.digest,"parent restored after export");
    } else {
        if phase!="verify" {throw "invalid review fixture phase";}
        let next=AI.neural_specialist_student_decode(fs_read(next_path));
        let next_history=AI.neural_specialist_student_history_decode(next,fs_read(next_history_path));
        assert(next.steps==parent.steps+32 and next.digest!=parent.digest,"fresh process retains accepted update");
        assert(next_history.generation==1 and len(next_history.training)==4 and len(next_history.holdout)==2,"fresh process retains split history");
        let refused=try {
            AI.neural_specialist_student_continue_reviewed(next,next_history,[map{x:[4,0],y:4}],[map{x:[5,0],y:4}]);false
        } catch true;
        assert(refused,"persisted holdout cannot become training");
        assert(AI.neural_specialist_student_load(parent).predict([5,0]).token==4,"original checkpoint independently loadable");
    }
}
print "pbai_student_review_file_pass";
