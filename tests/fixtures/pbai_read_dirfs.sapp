// Synthetic directory backend: no OS descriptors, networking or real file reads.
let state=map{opens:0,reads:[],closes:[],mode:"ok",all:false,callback:nil,bad_path:nil};
fn behavior(mode="ok",all=false,callback=nil,bad_path=nil) {
 state.reads=[];state.mode=mode;state.all=all;state.callback=callback;state.bad_path=bad_path;
}
fn configure(mode="ok",all=false,callback=nil) {state.opens=0;state.closes=[];behavior(mode,all,callback);}
fn available() {return map{library_ready:true};}
fn open(root,a=false,b=false) {state.opens=state.opens+1;return map{ok:true,id:state.opens};}
fn open_absolute(root,a=false,b=false) {return open(root,a,b);}
fn close(handle) {push(state.closes,handle.id);return true;}
fn read_bytes(handle,path,budget) {
 push(state.reads,handle.id);
 if len(state.reads)==1 and state.callback!=nil {state.callback();}
 let bad=(state.all or len(state.reads)==1) and (state.bad_path==nil or path==state.bad_path);
 if bad {
  if state.mode=="throw" {throw "synthetic-private-read-detail";}
  if state.mode=="false" {return map{ok:false,error:"synthetic-private-read-detail"};}
  if state.mode=="nil" {return nil;}
  if state.mode=="number" {return 1;}
  if state.mode=="missing_ok" {return map{bytes:[1,2,3,4]};}
  if state.mode=="truthy_ok" {return map{ok:"true",bytes:[1,2,3,4]};}
  if state.mode=="numeric_ok" {return map{ok:1,bytes:[1,2,3,4]};}
  if state.mode=="missing_bytes" {return map{ok:true};}
  if state.mode=="wrong_bytes" {return map{ok:true,bytes:"1234"};}
  if state.mode=="wrong_size" {return map{ok:true,bytes:[1,2,3]};}
  if state.mode=="corrupt" {return map{ok:true,bytes:[4,3,2,1]};}
 }
 return map{ok:true,bytes:[1,2,3,4]};
}
fn snapshot() {return map{opens:state.opens,reads:state.reads,closes:state.closes};}
export behavior,configure,available,open,open_absolute,close,read_bytes,snapshot;
