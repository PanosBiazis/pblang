// Small source-hidden installation acceptance: repeated/different scalars.
let J=import("stdlib:json.sapp");
let n=parse_number("9007199254740991");
let v=J.parse("[0.5,0.5,0.25,1.25,9007199254740991.0,9007199254740991.0]");
assert(v==[0.5,0.5,0.25,1.25,n,n],"repeated and different decimal values");
let z=J.parse("[-0.0,-0.0,0.0,0.0,-1e-400,-1e-400]");
for i in [0,1,4,5] { assert(num_to_le_bytes(z[i])==[0,0,0,0,0,0,0,128],"negative zero"); }
for i in [2,3] { assert(num_to_le_bytes(z[i])==[0,0,0,0,0,0,0,0],"positive zero"); }
assert(J.parse_exact("[0.5,0.5,1.25]")==[0.5,0.5,1.25],"exact decimals");
assert((try {J.parse_exact("[0.1,0.1]");false} catch true),"rounded values rejected in exact mode");
assert(J.parse("[0.1,0.1]")==[parse_number("0.1"),parse_number("0.1")],"ordinary rounding retained");
print "json_cycle12_values_pass";
