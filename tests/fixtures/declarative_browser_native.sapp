let App=import("../../examples/declarative_browser/app.sapp");let G=import("stdlib:graphics.sapp");let GUI=import("stdlib:gui.sapp");
let c=App.create();let started=now_ms();let win=G.Window(c.width,c.height,"PBLang document browser probe");
G.run(win,c,fn(current,events){
    let changed=App.update(current,events);
    if now_ms()-started>6500 {current.graphics_stop=true;}
    return changed;
},fn(current,canvas){GUI.draw(canvas,current.form);},30);
let snap=c.session.snapshot();
assert(snap.url=="pb://guide" and c.navigations==3,"keyboard link/back/forward journey");
print json_stringify(map{url:snap.url,navigations:c.navigations,title:snap.document.form.title});
c.session.close();
