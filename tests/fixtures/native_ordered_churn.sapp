// Driver creates and destroys 50 unrelated windows after the observer is ready.
let Input=import("stdlib:x11_window_input.sapp");let GUI=import("stdlib:gui.sapp");let waiting=channel();
let s=Input.open("PBLang Churn Acceptance");assert(s!=nil,"observer initialized");
print "observer-ready";recv_timeout(waiting.receiver,1000);
let queued=ffi_call_typed(s.x,"XPending","ptr->i64",[s.display]);assert(queued>=100 and queued<=220,"synthetic creation/destruction notifications queued");
let handle=gfxcreatewindow(420,180,s.nonce);assert(Input.bind(s,"PBLang Churn Acceptance"),"checked property lookup tolerates destroyed windows");
let f=GUI.form("input",420,180);GUI.add(f,GUI.textbox("entry",0,0,300,40,""));f.focus="entry";
print "owned-window-ready";let start=now_ms();
while now_ms()-start<2000 {gfxpresent(handle);for event in Input.poll(s) {GUI.handle_event(f,event);}recv_timeout(waiting.receiver,10);}
let value=GUI.get(f,"entry").value;gfxclose(handle);assert(Input.close(s),"observer cleaned up");
let path=env_get("PBLANG_INPUT_DIAG_OUT");fs_write(path,value);assert(fs_read(path)==value,"churn save/readback");
print json_stringify(map{queued_before_owned_window:queued,value:value});
