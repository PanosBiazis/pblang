// Execute this same contract with the retained host and the self-hosted frontend.
let C=import("stdlib:file_catalog.sapp");
fn require(ok,message){if not ok {throw "FAIL summary: "+message;}}
let names=["C:\\private\\main.py","archive.tar.gz","photo.png","a.py","README",map{name:"ignored.sapp",kind:"dir"},map{name:"b.sapp"}];
let before=str(names);
let report=C.summarize(names);
require(report.total_files==6 and report.known_files==5 and report.unknown_files==1,"totals");
require(report.by_family.source==3 and report.by_label["Python Source"]==2,"histograms");
require(report.family_rows==[map{name:"archive",count:1},map{name:"image",count:1},map{name:"source",count:3},map{name:"unknown",count:1}],"sorted family rows");
require(not report.names_included and report.classified_items==[],"private default");
require(not str_contains(str(report),"private") and not str_contains(str(report),"main.py"),"no input names in aggregate");
require(str(names)==before,"input unchanged");
for options in [nil,map{},map{max_items:10},map{include_names:false}] {
 let empty=C.summarize([],options);
 require(empty.total_files==0 and empty.label_rows==[] and empty.family_rows==[] and not empty.names_included,"empty and partial options");
 require(C.visualization_plan(empty).bars==[],"empty visualization");
}
let disclosed=C.summarize(["C:\\private\\main.py"],map{include_names:true});
require(disclosed.classified_items[0].name=="main.py","explicit basename");
let plan=C.visualization_plan(report,640,360);
require(len(plan.bars)==4 and plan.donut_sectors[3].end_degrees==360,"portable visualization");
for options in [1,[],map{max_items:nil},map{max_items:0},map{max_items:4097},map{max_items:1.5},map{include_names:nil},map{include_names:1},map{include_names:"yes"}] {
 require((try {C.summarize([],options);false} catch true),"invalid option rejected");
}
require((try {C.summarize(["a.py","b.py"],map{max_items:1});false} catch true),"item budget");
require((try {C.summarize([map{}]);false} catch true),"missing name");
require((try {C.summarize("a.py");false} catch true),"invalid collection");
print "file_catalog_summary_contract_pass";
