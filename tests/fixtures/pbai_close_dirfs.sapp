// Deterministic test substitute; owns no OS descriptors or real filesystem roots.
let state=map{mode:"ok",calls:0,next_id:0,ids:[],callback:nil,fail_read:false};
fn configure(mode,callback=nil) {state.mode=mode;state.calls=0;state.next_id=0;state.ids=[];state.callback=callback;state.fail_read=false;}
fn available() {return map{library_ready:true};}
fn open(root,a=false,b=false) {state.next_id=state.next_id+1;return map{ok:true,id:state.next_id,closed:false};}
fn open_absolute(root,a=false,b=false) {return open(root,a,b);}
fn read_bytes(handle,path,budget) {if state.fail_read {return map{ok:false};}return map{ok:true,bytes:[1,2,3,4]};}
fn fail_reads() {state.fail_read=true;}
fn close(handle) {
 state.calls=state.calls+1;push(state.ids,handle.id);
 if state.calls==1 and state.callback!=nil {state.callback();}
 if state.mode=="mixed" {if state.calls==1 {return false;}if state.calls==2 {throw "synthetic-private-detail";}return nil;}
 if state.calls==1 {
  if state.mode=="false" {return false;}if state.mode=="throw" {throw "synthetic-private-detail";}
  if state.mode=="nil" {return nil;}if state.mode=="number" {return 1;}if state.mode=="string" {return "true";}
 }
 return true;
}
fn calls() {return state.calls;}
fn ids() {return state.ids;}
export configure,available,open,open_absolute,read_bytes,fail_reads,close,calls,ids;
