// Synthetic read outcomes only: no OS descriptors or filesystem effects.
let state=map{opens:0,closes:[],reads:[],attempts:0,mode:"ok",all:false,callback:nil,path:"large"};
fn behavior(mode="ok",all=false,callback=nil,path="large") {state.reads=[];state.attempts=0;state.mode=mode;state.all=all;state.callback=callback;state.path=path;}
fn configure() {state.opens=0;state.closes=[];behavior();}
fn available() {return map{library_ready:true};}
fn open(root,a=false,b=false) {state.opens=state.opens+1;return map{ok:true,id:state.opens};}
fn open_absolute(root,a=false,b=false) {return open(root,a,b);}
fn close(handle) {push(state.closes,handle.id);return true;}
fn read_bytes_relative(handle,path,budget) {
 push(state.reads,path);let bytes=[1,2,3,4];if path=="large" {bytes=[1,2,3,4,5,6,7,8];}if path=="empty" {bytes=[];}
 if path==state.path {
  state.attempts=state.attempts+1;if state.attempts==1 and state.callback!=nil {state.callback();}
  if state.all or state.attempts==1 {
   if state.mode=="throw" {throw "synthetic-private-reader-detail";}
   if state.mode=="false" {return map{ok:false,error:"synthetic-private-reader-detail"};}
   if state.mode=="partial" {return map{ok:true,bytes:[1,2,3]};}
   if state.mode=="missing_bytes" {return map{ok:true};}
   if state.mode=="wrong_type" {return map{ok:true,bytes:"partial"};}
   if state.mode=="truthy" {return map{ok:1,bytes:bytes};}
   if state.mode=="corrupt" {bytes[0]=9;}
  }
 }
 return map{ok:true,bytes:bytes};
}
fn snapshot() {return map{opens:state.opens,reads:state.reads,closes:state.closes};}
export configure,behavior,available,open,open_absolute,close,read_bytes_relative,snapshot;
