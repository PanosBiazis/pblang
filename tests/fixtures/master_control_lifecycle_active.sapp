let MC = import("stdlib:master_control.sapp");
fn require(value, message) { if not value { throw "master lifecycle: " + message; } }
let root = env_get("PB_MASTER_CONTROL_HOME");
require(type(root) == "string" and str_starts_with(root, "/")
    and str_contains(root, "/.master-lifecycle-test-"), "isolated fixture root required");
let nonce = "test-owned-lifecycle-nonce";
fs_write(root + "/.pb_master_control_unlock", nonce);
require(MC.unlock(nonce).ok, "initial unlock");
fn approved() {
    let request = MC.request(map{ kind: "screen" });
    require(request.status == "pending", "request admission");
    require(MC.approve(request.id, nonce).ok, "local approval");
    return request.id;
}
let calls = map{ count: 0 };
fn effect() { calls.count = calls.count + 1; return "fixture-result"; }

let first = approved();
require(MC.execute(first, effect).result == "fixture-result", "successful result preserved");
require(not MC.execute(first, effect).ok, "successful action replayed");
require(not MC.approve(first, nonce).ok, "consumed action approved again");
require(calls.count == 1 and MC.status().pending == 0, "consumed action retained");

let failed = approved();
let failure = false;
try { MC.execute(failed, fn() { calls.count = calls.count + 1; throw "fixture failure"; }); }
catch { failure = true; }
require(failure, "executor error was swallowed");
require(not MC.execute(failed, effect).ok and not MC.approve(failed, nonce).ok,
    "failed action retained authority");
require(calls.count == 2 and MC.status().pending == 0, "failure cleanup");

let reentrant = approved();
let nested = map{ ran: false };
let outer = MC.execute(reentrant, fn() {
    nested.ran = MC.execute(reentrant, effect).ok;
    return true;
});
require(outer.ok and not nested.ran and calls.count == 2, "re-entrant execution replayed");

let locked = approved();
let unapproved = MC.request(map{ kind: "screen" });
require(MC.lock().ok and MC.status().pending == 0, "lock retained pending requests");
require(MC.unlock(nonce).ok, "fresh unlock");
require(not MC.execute(locked, effect).ok and not MC.approve(locked, nonce).ok
    and not MC.approve(unapproved.id, nonce).ok, "lock resurrected old authority");
let fresh = approved();
require(fresh > locked and MC.execute(fresh, effect).ok, "fresh request after lock");

let killed = approved();
require(MC.kill().ok and MC.status().pending == 0, "kill retained pending requests");
require(not MC.unlock(nonce).ok and not MC.execute(killed, effect).ok,
    "kill did not latch");
require(not MC.reset("wrong-fixture-nonce").ok, "invalid reset accepted");
require(MC.reset(nonce).ok and MC.unlock(nonce).ok, "local reset");
require(not MC.execute(killed, effect).ok and not MC.approve(killed, nonce).ok,
    "reset resurrected killed authority");

let mutation = map{ kind: "screen" };
let changed = MC.request(mutation);
require(MC.approve(changed.id, nonce).ok, "mutable fixture approval");
mutation.kind = "power";
require(not MC.execute(changed.id, effect).ok, "execution skipped policy recheck");
mutation.kind = "screen";
require(not MC.execute(changed.id, effect).ok, "policy rejection retained approval");
require(not MC.execute(999999, effect).ok, "unknown request executed");

for i 32 { require(MC.execute(approved(), effect).ok, "sequential execution"); }
require(MC.status().pending == 0 and calls.count == 35, "queue contains consumed requests");
let log = json_stringify(MC.audit_log());
require(not str_contains(log, nonce) and not str_contains(log, root),
    "lifecycle audit exposed fixture credentials or path");
MC.lock();
print "master_control_lifecycle_active_pass";
