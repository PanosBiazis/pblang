let G=import("stdlib:graphics.sapp");let M=import("stdlib:font_metrics.sapp");
let window=G.Window(320,200,"PBLang font cache probe");
for size in [12,16,24,32] {
    let result=window.textMeasure("Guide — Οδηγός ά g",size,0,"sans");
    assert(result.ok and result.positioning=="truetype-baseline","Greek and descenders use measured native positioning");
    let width=result.width;result.width=0;
    assert(window.textMeasure("Guide — Οδηγός ά g",size,0,"sans").width==width,"measure results do not expose cache mutation");
}
let font=M.load(G.text_font_resolve("sans"));
assert(font!=nil and M.layout(font,"á",16)==nil,"combining marks explicitly use host fallback");
for i 140 {window.textMeasure("Agά "+str(i),16,0,"sans");}
let status=window.textCacheStatus();assert(status.payload_bytes<=status.payload_limit,"entry churn stays inside payload budget");
let before=status.payload_bytes;window.textMeasure("Agά 139",16,0,"sans");
assert(window.textCacheStatus().payload_bytes==before,"cache hits do not accumulate budget");
assert((try window.textMeasure("bad",16,0,"remote") catch nil)==nil,"only declared families admitted");
window.close();assert(window.textCacheStatus().payload_bytes==0,"window close clears font/text retention");
print json_stringify(map{test:"font_metrics_native_pass",cache:status,after_close:window.textCacheStatus()});
