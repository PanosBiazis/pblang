// Trusted positive/bounded fixture; no raw malformed native builtin invocation.
let A=import("stdlib:array.sapp");
let input=[1,2,3,4,5];
let chunks=A.chunk(input,2);let windows=A.windows(input,3,2);
if len(chunks)!=3 or chunks[0][0]!=1 or chunks[2][0]!=5 {throw "portable chunk shape";}
if len(windows)!=2 or windows[1][2]!=5 {throw "portable window shape";}
let huge=100000000000000000000.0;
let one=A.chunk(input,huge);let first=A.windows(input,2,huge);
if len(one)!=1 or len(one[0])!=5 or len(first)!=1 or first[0][1]!=2 {throw "portable huge count";}
print "array_windowing_portable_pass";
