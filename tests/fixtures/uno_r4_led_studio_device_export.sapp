let M=import("../../examples/uno_r4_led_studio/model.sapp");let D=import("../../examples/uno_r4_led_studio/device_export.sapp");
let state=M.create();M.apply(state,"add");M.apply(state,"preset","border");M.apply(state,"timing_all",1000);
let p=D.plan(state.document,2);let result=D.lower(p,fs_read("examples/uno_r4_led_studio/device_firmware.sapp"));
fs_mkdirs("build/pblang_led_device");fs_write("build/pblang_led_device/pblang_led_device.ino",fs_read("examples/uno_r4_led_studio/device_adapter.ino"));
fs_write("build/pblang_led_device/pblang_firmware.h",result.c_source);fs_write("build/pblang_led_device/firmware.sapp",result.pblang_source);
fs_write("build/pblang_led_device/plan.json",json_stringify(p));fs_write("build/pblang_led_device/project.json",M.export_document(state));
print "uno_r4_led_studio_device_export_pass";
