let AI=import("stdlib/pbai.sapp");let directory=env_get("PBAI_CONTINUATION_TEST_DIR");let phase=env_get("PBAI_CONTINUATION_TEST_PHASE");
if directory==nil or directory=="" {throw "explicit isolated fixture directory required";}
if phase=="write" {
 let teacher=AI.neural_specialist_train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
 let student=AI.neural_specialist_distill(teacher.artifact,[[0],[1,0]],[map{x:[7,0],y:4}]);
 AI.neural_specialist_student_save_new(directory+"/parent.json",student.checkpoint());
 print "continuation_parent_saved";
} elif phase=="continue" {
 let parent=AI.neural_specialist_student_load_file(directory+"/parent.json");
 let checkpoint=parent.checkpoint();let before=AI.neural_specialist_student_encode(checkpoint);
 let candidate=AI.neural_specialist_student_continue(checkpoint,[map{x:[2,0],y:5},map{x:[3,0],y:5}],
  [map{x:[4,0],y:5}],map{epochs:64,lr:0.1,max_grad_norm:1});
 assert(candidate.predict([5,0]).token==5 and parent.predict([5,0]).token==4,"fresh-process continuation preserves original handle");
 assert(before==AI.neural_specialist_student_encode(AI.neural_specialist_student_load_file(directory+"/parent.json").checkpoint()),"original on-disk checkpoint unchanged");
 AI.neural_specialist_student_save_new(directory+"/continued.json",candidate.checkpoint());
 print "continuation_candidate_saved";
} elif phase=="read" {
 let parent=AI.neural_specialist_student_load_file(directory+"/parent.json");
 let candidate=AI.neural_specialist_student_load_file(directory+"/continued.json");
 assert(parent.predict([5,0]).token==4 and candidate.predict([5,0]).token==5,"both versions survive restart independently");
 assert(candidate.checkpoint().steps==parent.checkpoint().steps+128,"persisted cumulative counters");
 print "continuation_restored_pass";
} else {throw "explicit fixture phase required";}
