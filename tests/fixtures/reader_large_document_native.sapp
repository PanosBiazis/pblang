let App=import("../../examples/declarative_browser/app.sapp");let P=import("../../examples/declarative_browser/pagination.sapp");let Focus=import("../../examples/declarative_browser/focus_indicator.sapp");
let D=import("stdlib:browser_document.sapp");let S=import("stdlib:browser_session.sapp");let G=import("stdlib:graphics.sapp");
let source="<article><h1>Large imported text</h1><h2>"+str_repeat("W",256)+"</h2><p>"+str_repeat("Ελληνικό κείμενο. ",12)+"</p><a href=\"pb://about\">Final local destination</a></article>";
let original=D.import_html(source);let original_html=D.export_html(original);let c=App.create();let local=App.pages();local["pb://guide"]=source;c.session.close();c.session=S.create(local);c.session.navigate("pb://guide");
c.width=320;c.height=240;App.configure(c,map{font_family:"serif",body_size:40,title_size:40,font_scale:1.5,line_height:1.25});
let win=G.Window(320,240,"PBLang large imported reader");App.set_text_measure(c,fn(t,s,f){return win.textMeasure(t,s,0,f);});App.refresh(c);
let native_draw=win.textStyled;let drawn=[];let seen=map{};let started=now_ms();
win.textStyled=fn(x,y,text,color,size,advance,family){let result=native_draw(x,y,text,color,size,advance,family);push(drawn,map{x:x,y:y,text:text,ok:try result.ok catch false});return result;};
G.run(win,c,fn(current,events){let changed=App.update(current,events);if now_ms()-started>50000 {current.graphics_stop=true;}return changed;},fn(current,canvas){
    drawn=[];App.draw(current,canvas);let bounds=true;let exact=true;
    for w in current.form.widgets {
        if w.x<0 or w.y<0 or w.x+w.w>current.width or w.y+w.h>current.height {bounds=false;}
        if str_starts_with(w.name,"reading_") and w.name!="reading_status" and w.name!="reading_help" and w.kind=="label" {
            let found=false;for item in drawn {if item.ok and item.x==w.x and item.y==w.y {found=true;if item.text!=w.text {exact=false;}}}
            if not found {exact=false;}
            if current.width==320 and current.height==480 and not current.settings and current.session.snapshot().url=="pb://guide" {seen[w.name]=w.text;}
        }
    }
    let plan=current.reading_plan;fs_write("/probe/state.json",json_stringify(map{width:current.width,height:current.height,available:plan!=nil and plan.available,
        page:current.reading_page,pages:if plan==nil {1}else{len(plan.pages)},reason:if plan==nil {""}else{plan.reason},anchor:current.reading_anchor,bounds:bounds,exact:exact,
        focus:current.form.focus,focus_visible:Focus.plan(current.form)!=nil,settings:current.settings,url:current.session.snapshot().url}));
},30);
if (try env_get("READER_BASELINE") catch "")!="1" {
    let inspected=D.inspect(original);
    for index in [-1,0,1,2] {
        let total="";for offset 257 {let key="reading_"+str(index)+"_"+str(offset);if map_has(seen,key) {total=total+seen[key];}}
        let expected=if index<0 {inspected.title}else{inspected.blocks[index].text};
        assert(str_replace_all(total," ","")==str_replace_all(P.normalized(expected)," ",""),"all imported characters actually drawn");
    }
    assert(c.session.snapshot().url=="pb://about" and c.navigations==1,"final canonical link opens");
}
assert(D.export_html(original)==original_html,"imported source unchanged");c.session.close();print "reader_large_document_native_pass";
