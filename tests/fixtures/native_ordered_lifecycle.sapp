let G=import("stdlib:graphics.sapp");let waiting=channel();
let warm=G.Window(320,180,"PBLang lifecycle warmup",map{ordered_input:true});
assert(warm.input_backend=="x11-ordered-keysyms","warm input attachment");warm.close();warm.close();
print "ready";recv_timeout(waiting.receiver,200);
for i in range(0,12) {
    // Concurrent windows with equal public titles must each use their own queue.
    let first=G.Window(320,180,"PBLang same title",map{ordered_input:true});
    let second=G.Window(320,180,"PBLang same title",map{ordered_input:true});
    assert(first.input_backend=="x11-ordered-keysyms" and second.input_backend=="x11-ordered-keysyms","distinct attachments");
    first.pollEvents();second.pollEvents();first.close();second.close();first.close();second.close();
    assert(not first.isOpen() and not second.isOpen(),"closed window state");
}
let unsupported=G.Window(320,180,"Ελληνικός τίτλος",map{ordered_input:true});
assert(unsupported.input_backend=="legacy","unsupported title preserves existing backend");unsupported.close();
print "closed";recv_timeout(waiting.receiver,500);print "native_ordered_lifecycle_pass";
