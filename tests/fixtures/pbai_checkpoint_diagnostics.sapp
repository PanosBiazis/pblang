// Real file adapter and real handles; test hooks only observe lifetime.
let AI=import("stdlib/pbai.sapp");let N=import("stdlib:pbai_neural_adapter.sapp");
let IO=import("stdlib:pbai_student_checkpoint_io.sapp");let S=import("stdlib:pbai_checkpoint_scope.sapp");
let bound=AI.neural_specialist_checkpoint_batch_bind(S);
let directory=env_get("PBAI_CHECKPOINT_TEST_DIR");let fixed=env_get("PBAI_DIAGNOSTIC_PHASE")!="baseline";
let path=path_join(directory,"student.json");
let teacher=N.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let seed=N.distill(teacher.artifact,[[0]],[map{x:[7,0],y:4}]);let checkpoint=seed.checkpoint();assert(seed.close(),"setup seed closes");
assert(IO.save_new(path,checkpoint).ok,"real exclusive file setup");
let independent=N.student_load(checkpoint);let before=json_stringify(independent.predict([6,0]));
let rows=[];let legacy=[];
for route in [map{name:"direct",use:S.with_files},map{name:"binding",use:bound.with_files}] {
 for failure in [map{name:"missing",error:"checkpoint could not be read within private storage bounds"},
  map{name:"encoding",error:"invalid student checkpoint encoding"},map{name:"checkpoint",error:"invalid student checkpoint"},
  map{name:"duplicate",error:"invalid student checkpoint encoding"}] {
  for index in [0,1,7] {
   let paths=[];for i 8 {push(paths,if i==index {path_join(directory,failure.name+".json")} else {path});}
   let called=false;N.diagnostic_probe_reset();
   let out=route.use(paths,fn(_handles){called=true;return map{ok:true,value:1};});
   assert(not out.ok and not called and out.stage=="acquire" and out.acquired_count==index
    and out.cleanups_attempted==index and out.cleanup_ok,"failed acquisition lifetime unchanged");
   if fixed {assert(out.body_status=="returned" and out.error==failure.error and out.original_error_available
    and out.body_result==map{ok:false,error:failure.error},"known acquisition is a primary error");}
   else {assert(out.body_status=="exception" and out.error==nil and not out.original_error_available,"historical opaque acquisition");}
   let diagnostic=if map_has(out,"acquisition_error") {out.acquisition_error} else {nil};
   if fixed {assert(diagnostic==map{index:index,error:failure.error},"known adapter error and zero-based failed index retained");}
   else {assert(diagnostic==nil,"baseline loses known adapter cause");}
   let observed=N.diagnostic_probe_observe();assert(len(observed)==index,"no absent handle cleaned");
   for item in observed {assert(item.closed and item.first_closes==1,"all prior real handles explicitly closed before diagnostic cleanup");}
   if map_has(out,"acquisition_error") {map_remove(out,"acquisition_error");}
   push(legacy,out);push(rows,map{route:route.name,mode:failure.name,index:index,diagnostic:diagnostic,handles:observed});
  }
 }
 for mode in ["one","eight","body_error","body_throw","invalid_result"] {
  let count=2;if mode=="one" {count=1;}if mode=="eight" {count=8;}
  let paths=[];for i count {push(paths,path);}let primary=map{code:"synthetic-body-error"};N.diagnostic_probe_reset();
  let out=route.use(paths,fn(handles){
   if mode=="body_error" {return map{ok:false,error:primary};}
   if mode=="body_throw" {throw "synthetic body throw";}
   if mode=="invalid_result" {return nil;}
   return map{ok:true,value:handles[0].predict([6,0])};
  });
  assert(out.stage=="body" and out.acquired_count==count and out.cleanups_attempted==count and out.cleanup_ok,"body lifetime unchanged");
  if mode=="body_error" {assert(out.original_error_available and out.error==primary,"explicit body error retained independently");}
  if fixed {assert(out.acquisition_error==nil,"no invented acquisition cause on body outcome");}
  let observed=N.diagnostic_probe_observe();for item in observed {assert(item.closed and item.first_closes==1,"returned real handles terminal");}
  if map_has(out,"acquisition_error") {map_remove(out,"acquisition_error");}
  push(legacy,out);push(rows,map{route:route.name,mode:mode,diagnostic:nil,handles:observed});
 }
}
assert(json_stringify(independent.predict([6,0]))==before and independent.close(),"independent model preserved");
print json_stringify(map{format:"pbai.checkpoint-acquisition-diagnostics.v1",rows:rows,legacy:legacy,independent_preserved:true});
