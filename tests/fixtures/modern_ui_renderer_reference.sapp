// Trusted synthetic reference: no disk/network/device effects.
let UI=import("stdlib:modern_ui.sapp");
let Web=import("stdlib:modern_ui_web.sapp");
let Android=import("stdlib:modern_ui_android.sapp");
fn view() {
    return UI.screen([UI.heading("Reference α😀",map{name:"status"}),
        UI.card([UI.row([UI.input("demo"),UI.button("Next",UI.action_set_text("status","Done"))]),
            UI.choice(["A","B"],1)],map{title:"Tools"})]);
}
fn verify() {
    let web=Web.generate("Reference",UI.compile(view(),map{target:"web"}));
    let android=Android.generate("Reference",UI.compile(view(),map{target:"android"}),
        map{package:"org.pblang.reference"});
    // Captured before the current-view revalidation change on the same VM.
    assert(web.digest=="8d011b64aa23d6015aae8c8b10d4b634aa0a56047168f7af96713c096503135e",
        "unmodified Web output remains identical");
    assert(sha256(json_stringify(android.class_bytes))=="064131b00bcb14bb414ff9508997014ed2060ff637394e17b92147116c168d92",
        "unmodified Android class-byte array remains identical");
    assert(android.widgets==5 and android.actions==1,"unmodified metadata retained");
    return true;
}
export verify;
