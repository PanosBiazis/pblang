let LinuxDirFS = import("stdlib:linux_dirfs.sapp");
let SECURE = import("stdlib:secure_file.sapp");

let before = LinuxDirFS.scan_mount_admission_status();
let injected = LinuxDirFS.exercise_mount_cleanup_failure_for_test();
let after = LinuxDirFS.scan_mount_admission_status();
let denied = SECURE.open_admitted_scan_enumerator("/tmp", 1000);

print json_stringify(map{
    format: "pblang.linux-dirfs.mount-cleanup-poison-probe.v1",
    initially_ready: try before.ready catch false,
    injection_verified: try injected.ok catch false,
    cleanup_failed: try injected.cleanup_failed catch false,
    process_admission_poisoned: try after.process_admission_poisoned catch false,
    later_admission_denied: not (try denied.ok catch true),
    later_admission_not_started: try denied.admission_not_started catch false,
    later_enumerator_closed: try denied.enumerator_closed catch false,
    error_code: try denied.error_code catch "",
    authorizes_scan: false
});
