let SECURE = import("stdlib:secure_file.sapp");

let attempts = 20;
let failures = 0;
let successes = 0;
let capacity_error = false;
let open_successes = 0;
let open_failures = 0;
let enumerate_successes = 0;
let enumerate_failures = 0;
let close_successes = 0;
let close_failures = 0;
let cleanup_failures = 0;
let invalidated_results = 0;
let last_error = "";
let last_error_code = "";

for _attempt attempts {
    let handle = SECURE.open_bounded_enumerator("/tmp", 1000);
    if not handle.ok {
        failures = failures + 1;
        open_failures = open_failures + 1;
        last_error = str(try handle.error catch "");
        last_error_code = str(try handle.error_code catch "");
        if str_contains(str(try handle.error catch ""), "capacity") {
            capacity_error = true;
        }
    } else {
        open_successes = open_successes + 1;
        let result = SECURE.enumerate_bounded(handle, "", 1);
        if result.ok {
            successes = successes + 1;
            enumerate_successes = enumerate_successes + 1;
        }
        else {
            failures = failures + 1;
            enumerate_failures = enumerate_failures + 1;
            last_error = str(try result.error catch "");
            last_error_code = str(try result.error_code catch "");
            if str_contains(str(try result.error catch ""), "capacity") {
                capacity_error = true;
            }
            let cleanup_failed = try result.cleanup_failed catch false;
            let handle_invalidated = try result.handle_invalidated catch false;
            if cleanup_failed {
                cleanup_failures = cleanup_failures + 1;
            }
            if handle_invalidated {
                invalidated_results = invalidated_results + 1;
            }
        }
        let closed = SECURE.close_bounded_enumerator(handle);
        if closed { close_successes = close_successes + 1; }
        else { close_failures = close_failures + 1; }
    }
}

print json_stringify(map{
    format: "pblang.linux-dirfs.ffi-denial-probe.v1",
    attempts: attempts, failures: failures, successes: successes,
    open_successes: open_successes, open_failures: open_failures,
    enumerate_successes: enumerate_successes,
    enumerate_failures: enumerate_failures,
    close_successes: close_successes, close_failures: close_failures,
    cleanup_failures: cleanup_failures,
    invalidated_results: invalidated_results,
    last_error: last_error,
    last_error_code: last_error_code,
    capacity_error: capacity_error,
    structured_completion: failures + successes == attempts
});
