// Test-only observation of real continuation handles, never a production provider.
let export_probe=map{mode:"success",records:[]};
fn export_probe_configure(mode){export_probe.mode=mode;export_probe.records=[];}
fn _export_probe_close(record,mode){return fn(){
 record.attempts=record.attempts+1;
 if mode=="cleanup_before" or mode=="both_before" {throw "synthetic cleanup detail";}
 let closed=record.close_original();if closed {record.first_closes=record.first_closes+1;}
 if mode=="cleanup_throw" or mode=="both_throw" {throw "synthetic cleanup detail";}
 if mode=="cleanup_nil" or mode=="both_nil" {return nil;}
 if mode=="cleanup_number" {return 1;}
 if mode=="cleanup_false" {return false;}
 return closed;
};}
fn _export_probe_checkpoint(record,mode){return fn(){
 record.exports=record.exports+1;
 if mode=="export_throw" or mode=="both_throw" or mode=="both_nil" or mode=="both_before" {throw "synthetic checkpoint detail";}
 if mode=="export_nil" {return nil;}
 return record.checkpoint_original();
};}
fn _export_probe_wrap(handle){
 let mode=export_probe.mode;
 let record=map{attempts:0,first_closes:0,exports:0,close_original:handle.close,
  checkpoint_original:handle.checkpoint,predict_original:handle.predict,evaluate_original:handle.evaluate};
 push(export_probe.records,record);handle.close=_export_probe_close(record,mode);handle.checkpoint=_export_probe_checkpoint(record,mode);return handle;
}
fn export_probe_observe(){
 let rows=[];
 for record in export_probe.records {
  let predict_blocked=try {record.predict_original([5,0]);false} catch true;
  let export_blocked=try {record.checkpoint_original();false} catch true;
  let evaluate_blocked=try {record.evaluate_original([map{x:[5,0],y:4}]);false} catch true;
  push(rows,map{attempts:record.attempts,first_closes:record.first_closes,exports:record.exports,
   predict_blocked:predict_blocked,export_blocked:export_blocked,evaluate_blocked:evaluate_blocked});
 }
 return rows;
}
fn export_probe_diagnostic_close(){let count=0;for record in export_probe.records {if record.close_original(){count=count+1;}}return count;}
export export_probe_configure,export_probe_observe,export_probe_diagnostic_close;
