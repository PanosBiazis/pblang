let App=import("../../examples/declarative_browser/app.sapp");let D=import("stdlib:browser_document.sapp");let S=import("stdlib:browser_session.sapp");
let G=import("stdlib:graphics.sapp");let GUI=import("stdlib:gui.sapp");
let blocks=[];for i 3 {push(blocks,map{tag:"p",text:"Ενότητα "+str(i+1)+". Μεγαλύτερα γράμματα, χωρίς χαμένο κείμενο. Η σελιδοποίηση κρατά τη θέση ανάγνωσης όταν αλλάζεις το παράθυρο. "+str_repeat("Read every sentence. ",4)});}
push(blocks,map{tag:"a",text:"Τέλος οδηγού — άνοιγμα τοπικού προορισμού",href:"pb://about"});
let document=D.create("Οδηγός με μεγάλα γράμματα",blocks);let original=D.export_html(document);
let c=App.create();let local=App.pages();local["pb://guide"]=original;c.session.close();c.session=S.create(local);c.session.navigate("pb://guide");
c.width=390;c.height=844;App.configure(c,map{body_size:20,font_scale:1.5});App.refresh(c);
let started=now_ms();let win=G.Window(390,844,"PBLang paginated reader");
G.run(win,c,fn(current,events){let changed=App.update(current,events);if now_ms()-started>60000 {current.graphics_stop=true;}return changed;},fn(current,canvas){
    GUI.draw(canvas,current.form);let bounds=true;for widget in current.form.widgets {if widget.y+widget.h>current.form.h {bounds=false;}}
    fs_write("build/reader-pagination-native.json",json_stringify(map{page:current.reading_page,pages:if current.reading_plan==nil {1}else{len(current.reading_plan.pages)},anchor:current.reading_anchor,
        settings:current.settings,focus:current.form.focus,body_size:current.appearance.body_size,width:current.width,height:current.height,
        bounds:bounds,url:current.session.snapshot().url}));
},30);
assert(c.session.snapshot().url=="pb://about" and c.navigations==1,"last-page local link navigates");
assert(D.export_html(document)==original,"source content preserved");c.session.close();print "reader_pagination_native_pass";
