let AI=import("stdlib/pbai.sapp");let N=import("stdlib:pbai_neural_adapter.sapp");
let bound=AI.neural_specialist_bind(N);let fixed=env_get("PBAI_CONTINUATION_LIFETIME_PHASE")!="baseline";
let teacher=N.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let artifact=N.distill(teacher.artifact,[[0],[1,0]],[map{x:[7,0],y:4}]).checkpoint();
let history=N.student_history(artifact,[map{x:[0],y:4},map{x:[1,0],y:4}],[map{x:[7,0],y:4}]);
let original=N.student_encode(artifact);let history_text=N.student_history_encode(artifact,history);
let active=N.student_load(artifact);let prediction=json_stringify(active.predict([6,0]));let rows=[];
let routes=[map{name:"direct",call:N.student_continue_reviewed},
 map{name:"facade",call:AI.neural_specialist_student_continue_reviewed},map{name:"bound",call:bound.student_continue_reviewed}];
for route in routes {
 for mode in ["success","checkpoint_fault","rejected","recover"] {
  let label=if mode=="rejected" {5} else {4};
  let training=[map{x:[2,0],y:label},map{x:[3,0],y:label}];let validation=[map{x:[4,0],y:label}];
  let options=map{epochs:if mode=="rejected" {64} else {16},lr:0.1,max_grad_norm:1};
  let input=json_stringify([artifact,history,training,validation,options]);
  N.continuation_probe_mode(mode);let count=N.continuation_probe_count();
  let review=try route.call(artifact,history,training,validation,options) catch nil;
  assert(N.continuation_probe_count()==count+1,"one private continuation per review");
  let observed=N.continuation_probe_inspect(count);
  assert(observed.close_calls==(if fixed {1} else {0}) and observed.prediction_closed==fixed
   and observed.checkpoint_closed==fixed and observed.evaluation_closed==fixed,"original methods terminal before observer cleanup");
  assert(observed.diagnostic_close==(if fixed {false} else {nil}),"diagnostic cannot mask missing cleanup");
  if mode=="checkpoint_fault" {assert(review==nil,"failed export cannot yield a review");}
  else {
   assert(review!=nil and review.report().passed==(mode!="rejected"),"real passing/rejected review preserved");
   assert(review.checkpoint().digest==artifact.digest,"review retains caller baseline before acceptance");
   if mode!="rejected" {
    review.accept();let cp=review.checkpoint();let oracle=N.student_load(cp);
    assert(json_stringify(review.predict([6,0]))==json_stringify(oracle.predict([6,0])) and oracle.close(),"accepted exported weights remain usable");
    review.rollback();assert(review.checkpoint().digest==artifact.digest,"rollback retained");
   }
   assert(review.close(),"caller owns returned review");
  }
  assert(json_stringify([artifact,history,training,validation,options])==input
   and N.student_encode(artifact)==original and N.student_history_encode(artifact,history)==history_text,"caller input unchanged");
  assert(json_stringify(active.predict([6,0]))==prediction,"caller active model survives success/failure/recovery");
  push(rows,map{route:route.name,mode:mode,lifetime:observed});
 }
 let count=N.continuation_probe_count();let rejected=try {route.call(artifact,history,[map{x:[0],y:4}],[map{x:[4,0],y:4}]);false} catch true;
 assert(rejected and N.continuation_probe_count()==count,"invalid overlap rejected before training handle acquisition");
}
assert(active.close(),"caller closes active model explicitly");
print json_stringify(map{format:"pbai.continuation.lifetime.v1",phase:if fixed {"fixed"} else {"baseline"},
 cases:len(rows),active_preserved:true,rows:rows,physical_release_verified:false});
