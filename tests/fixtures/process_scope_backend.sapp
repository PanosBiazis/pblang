// Deterministic lifecycle failures. This fixture never launches a process.
let ledger=map{live:false,mode:"normal",closes:0,finishes:0,starts:0};
fn reset(mode) {
    assert(not ledger.live,"preceding owner recovered");
    ledger.mode=mode;ledger.closes=0;ledger.finishes=0;ledger.starts=0;
}
fn counts() {return map{live:ledger.live,closes:ledger.closes,finishes:ledger.finishes,starts:ledger.starts};}
fn start_fixed_bounded(candidates,args,options) {
    ledger.starts=ledger.starts+1;
    if ledger.mode=="launch_failed" {return map{ok:false,started:false,error:"launch failed"};}
    ledger.live=true;
    return map{ok:ledger.mode!="recovery_start",started:true,format:"fixture",id:"owned",
        error:"incomplete launch",requires_recovery:ledger.mode=="recovery_start"};
}
fn poll_bounded(handle) {
    assert(ledger.live and handle.id=="owned","poll owns live child");
    return map{ok:true,active:true};
}
fn request_cancel_bounded(handle,grace_ms) {
    assert(ledger.live and handle.id=="owned","cancel owns live child");
    return map{ok:true,requested:true};
}
fn finish_bounded(handle,wait_ms) {
    assert(ledger.live and handle.id=="owned","finish owns live child");
    ledger.finishes=ledger.finishes+1;
    if ledger.mode=="throws" {throw "synthetic cleanup failure";}
    if ledger.mode=="pending" {return map{handle_closed:false,requires_recovery:true};}
    ledger.live=false;
    return map{ok:true,handle_closed:true,command_ok:true,stdout:"finished"};
}
fn close_bounded(handle,grace_ms,wait_ms) {
    ledger.closes=ledger.closes+1;return finish_bounded(handle,wait_ms);
}
fn recover(handle) {
    ledger.mode="normal";return close_bounded(handle,0,100);
}
export reset,counts,start_fixed_bounded,poll_bounded,request_cancel_bounded,
       finish_bounded,close_bounded,recover;
