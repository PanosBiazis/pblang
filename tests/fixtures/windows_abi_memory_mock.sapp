// Test-only replacement of the FFI call boundary. Never invokes native code.
fn _test_ffi(library, symbol, signature, args) {
    array_push(library.calls, symbol);
    if (try library.fail_at catch 0) == len(library.calls) {
        if (try library.fail_throw catch false) { throw "test write failure"; }
        return -1;
    }
    if symbol == "HeapFree" {
        if library.free_result == "throw" { throw "test release failure"; }
        return library.free_result;
    }
    let widths = map{ pb_mem_write_u8: 1, pb_mem_write_u16: 2,
        pb_mem_write_u32: 4, pb_mem_write_u64: 8 };
    if map_has(widths, symbol) {
        let i = 0; let value = args[2];
        while i < widths[symbol] {
            library.bytes[args[1] + i] = num_mod(value, 256);
            value = num_floor(value / 256); i = i + 1;
        }
        let mode = try library.after_write catch "";
        if mode == "revoke" { map_remove(library.owner.allocations, "4096"); }
        elif mode == "shrink" { library.owner.allocations["4096"] = 4; }
        elif mode == "close" { library.owner.closed = true; }
        elif mode == "invalid-size" { library.owner.allocations["4096"] = num_pow(2.0,1100.0)-num_pow(2.0,1100.0); }
        return 0;
    }
    throw "unexpected test FFI call: " + symbol;
}
