fn block_value(should_fail) {
    let outcome = try {
        if should_fail { throw "expected imported failure"; };
        let value = 20;
        value + 22
    } catch -1;
    return outcome;
}

fn conditional_value(use_try, should_fail) {
    let configured = false;
    if use_try {
        configured = try {
            if should_fail { throw "expected conditional failure"; };
            true
        } catch false;
    } else {
        configured = try { true } catch false;
    }
    return configured;
}

export block_value;
export conditional_value;
