let MC = import("stdlib:master_control.sapp");
fn check(value, why) { if not value { throw "audit privacy: " + why; } }
let root = env_get("PB_MASTER_CONTROL_HOME");
check(str_contains(root, "/.master-audit-test-"), "private fixture required");
let nonce = "synthetic-audit-unlock";
fs_write(root + "/.pb_master_control_unlock", nonce);
check(MC.unlock(nonce).ok, "unlock");
let action = map{ kind: "screen", text: "SYNTHETIC_PRIVATE_DETAIL", path: "SYNTHETIC_PRIVATE_PATH" };
let pending = MC.request(action);
check(pending.status == "pending" and MC.approve(pending.id, nonce).ok, "approval");
let result = MC.execute(pending.id, fn() { return "unchanged-result"; });
check(result.ok and result.result == "unchanged-result", "effect result preserved");
check(MC.request(map{ kind: "power", text: action.text }).status == "denied", "policy retained");
let memory = json_stringify(MC.audit_log());
let disk = fs_read(root + "/.pb_master_control_audit.log");
let events_only = env_get("PB_MASTER_CONTROL_AUDIT") == "events";
for content in [memory, disk] {
    check(str_contains(content, "requested") and str_contains(content, "executed")
        and str_contains(content, "denied_policy"), "event trace retained");
    check(not str_contains(content, nonce), "nonce omitted");
    check(str_contains(content, action.text) != events_only, "text profile");
    check(str_contains(content, action.path) != events_only, "path profile");
}
MC.lock();
print "master_control_audit_pass";
