// Deterministic foreign-boundary failures; never loads a library or signals a PID.
let state=map{mode:"normal",loads:0,releases:0,closes:0,signals:0,hook:nil};
fn reset(mode) {
    state.mode=mode;state.loads=0;state.releases=0;state.closes=0;state.signals=0;state.hook=nil;
}
fn counts() {return map{loads:state.loads,releases:state.releases,closes:state.closes,signals:state.signals};}
fn on_close(hook) {state.hook=hook;}
fn load(path) {
    state.loads=state.loads+1;
    if state.mode=="load_error" or (state.mode=="load_fallback" and state.loads==1) {
        throw "synthetic load failure";
    }
    return 17;
}
fn release(handle) {
    assert(handle==17,"fixture owns library");state.releases=state.releases+1;
    if state.mode=="unload_throws" {throw "synthetic unload failure";}
}
fn call(handle,symbol,signature,args) {
    assert(handle==17,"fixture owns library");
    if symbol=="getpid" {return 41;}
    if symbol=="pidfd_open" {
        assert(signature=="i32,i32->i32" and args[1]==0,"fixed open tuple");return 31;
    }
    if symbol=="pidfd_send_signal" {
        assert(signature=="i32,i32,ptr,i32->i32" and args[0]==31 and args[2]==0 and args[3]==0,
            "fixed signal tuple");state.signals=state.signals+1;return 0;
    }
    assert(symbol=="close" and signature=="i32->i32" and args==[31],"fixed close tuple");
    state.closes=state.closes+1;
    if state.hook!=nil {state.hook();}
    if state.mode=="close_throws" {throw "synthetic close failure";}
    if state.mode=="close_error" {return -1;}
    return 0;
}
export reset,counts,on_close,load,release,call;
