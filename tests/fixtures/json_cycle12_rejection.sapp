// Small installation acceptance: invalid values cannot hide behind a run.
// Exact native exception-message parity is covered by the separate oracle.
let J=import("stdlib:json.sapp");
let S=import("stdlib:serialization.sapp");
for text in ["[0.5,0.5,]","[0.5,0.5,1e9999]","[0.5,0.5,{\"x\":1e9999,\"x\":1}]"] {
    assert((try {J.parse(text);false} catch true),"original admission after repeated values");
    let r=S.parse_safe(text,"json",map{reject_duplicate_keys:false});
    assert(not r.ok and r.schema=="pblang.serialization.result.v1","structured rejection");
    assert(r.diagnostics[0].code=="invalid_json" and r.diagnostics[0].message=="invalid JSON document","diagnostic code and message preserved");
}
let overflow=S.parse_safe("[0.5,0.5,1e9999]","json");
assert(overflow.diagnostics[0].line==0 and overflow.diagnostics[0].column==0,"native admission diagnostic location");
assert((try {J.parse_exact("[0.5,0.5,0e-4097]");false} catch true),"exact exponent policy after repeated values");
assert(J.parse("[0.5,0.5]")==[0.5,0.5],"no failed-parse state retained");
print "json_cycle12_rejection_pass";
