// Small installation probe for caught and borrowed host math failures.
let F=import("stdlib:compiler/selfhost_frontend.sapp");let V=import("stdlib:compiler/vm.sapp");
let setup=F.frontend_compile("memory_alloc(7);").chunk;
for expression in ["invoke(num_mod,bigint(7),bigint(0))","invoke(num_pow,bigint(2),-1)"] {
    let c=V.execution_context(true);V.run_seeded(setup,map{},c);let m=c.memory;
    let caught=F.frontend_compile("fn invoke(f,a,b){return f(a,b);}print try "+expression+" catch memory_get(1);");
    assert(caught.ok,"caught fixture compiles");
    assert(V.run_seeded_bounded(caught.chunk,map{},nil,c).output==[7],"handler can read memory");
    assert(c.memory==m and not m.closed and c.handlers==0,"caught owner stays live");V.close_execution(c);
    let borrowed=V.execution_context();V.run_seeded(setup,map{},borrowed);let b=borrowed.memory;
    let fail=F.frontend_compile("fn invoke(f,a,b){return f(a,b);}"+expression+";").chunk;
    assert((try {V.run_seeded(fail,map{},borrowed);false} catch true),"borrowed error escapes");
    assert(not b.closed and len(b.owners)==1,"caller retains ownership");V.close_execution(borrowed);
}
print "selfhost_exact_math_acceptance_pass";
