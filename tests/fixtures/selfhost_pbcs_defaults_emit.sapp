// Emit both routes into a caller-owned disposable working directory.
// Execute with the retained pblang binary; run the two resulting .pbck files.
let FE = import("stdlib/compiler/selfhost_frontend.sapp");
let PB = import("stdlib/selfhost_pbck.sapp");
let XL = import("stdlib/selfhost_to_pbck.sapp");
let compiled = FE.frontend_compile("fn add(a,b=2) { return a+b; } print add(3);");
if not compiled.ok { throw "default-argument fixture did not compile"; }
XL.write_file("pbcs_defaults_original.pbck", compiled.chunk);
let bytes = PB.serialize_chunk(compiled.chunk);
fs_write_bytes("pbcs_defaults.pbcs", bytes);
XL.write_file("pbcs_defaults_restored.pbck", PB.deserialize_chunk(bytes));
print "pbcs_defaults_emitted";
