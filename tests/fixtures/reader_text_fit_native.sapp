let App=import("../../examples/declarative_browser/app.sapp");let P=import("../../examples/declarative_browser/pagination.sapp");
let D=import("stdlib:browser_document.sapp");let S=import("stdlib:browser_session.sapp");let GUI=import("stdlib:gui.sapp");let G=import("stdlib:graphics.sapp");
let blocks=[map{tag:"p",text:str_repeat("WWWWWWWWW ",8)+"Ελληνικό κείμενο με τόνους και πλατιά γράμματα. Κάθε χαρακτήρας παραμένει ορατός."},map{tag:"a",text:"Ο τελευταίος τοπικός σύνδεσμος",href:"pb://about"}];
let doc=D.create("WWWWWWWW — Οδηγός",blocks);let original=D.export_html(doc);let c=App.create();let local=App.pages();local["pb://guide"]=original;c.session.close();c.session=S.create(local);c.session.navigate("pb://guide");
c.width=320;c.height=240;App.configure(c,map{font_family:"serif",body_size:30,title_size:40,font_scale:1.5,line_height:2.5});App.refresh(c);
let win=G.Window(320,240,"PBLang measured reader");let measure=fn(text,size,family){return win.textMeasure(text,size,0,family);};
let baseline=P.plan(doc,c.appearance,320,480);let clipped=0;
for row in baseline.rows {if row.kind=="text" {let m=measure(row.text,row.size,"serif");if m.ok and m.height<=row.h and m.width+(if row.heading {1}else{0})>296 {clipped=clipped+1;}}}
assert(clipped>0,"real font proves approximate layout would clip broad glyphs");
App.set_text_measure(c,measure);App.refresh(c);
let native_draw=win.textStyled;let drawn=[];win.textStyled=fn(x,y,text,color,size,advance,family){let result=native_draw(x,y,text,color,size,advance,family);push(drawn,map{x:x,y:y,text:text,ok:try result.ok catch false});return result;};
let seen=map{};
let started=now_ms();
G.run(win,c,fn(current,events){let changed=App.update(current,events);if now_ms()-started>90000 {current.graphics_stop=true;}return changed;},fn(current,canvas){
    drawn=[];GUI.draw(canvas,current.form);let bounds=true;let exact=true;let help="";let footer="";
    for w in current.form.widgets {
        if w.x<0 or w.y<0 or w.x+w.w>current.width or w.y+w.h>current.height {bounds=false;}
        if str_starts_with(w.name,"reading_") and w.name!="reading_status" and w.name!="reading_help" and w.kind=="label" {
            let found=false;for item in drawn {if item.ok and item.x==w.x and item.y==w.y {found=true;if item.text!=w.text {exact=false;}}}
            if not found {exact=false;}
            if current.width==320 and current.height==480 and current.session.snapshot().url=="pb://guide" {seen[w.name]=w.text;}
        }
        if w.name=="reading_help" or w.name=="destination" {let parts=[];for item in drawn {if item.ok and item.x==w.x and item.y>=w.y and item.y<w.y+w.h {push(parts,item.text);}}
            if w.name=="reading_help" {help=str_join(parts,"");}
            if w.name=="destination" {footer=str_join(parts,"");}
        }
    }
    let plan=current.reading_plan;fs_write("build/reader-measured.json",json_stringify(map{width:current.width,height:current.height,available:plan!=nil and plan.available,
        page:current.reading_page,pages:if plan==nil {1}else{len(plan.pages)},anchor:current.reading_anchor,bounds:bounds,exact:exact,help:help,footer:footer,
        focus:current.form.focus,url:current.session.snapshot().url,baseline_clipped_lines:clipped}));
},30);
// The driver visits every measured page and records exact draws. Reconstruct by normalized block/offset.
for index in [-1,0,1] {
    let total="";for offset 257 {let key="reading_"+str(index)+"_"+str(offset);if map_has(seen,key) {total=total+seen[key];}}
    let source=if index<0 {D.inspect(doc).title}else{blocks[index].text};
    assert(str_replace_all(total," ","")==str_replace_all(P.normalized(source)," ",""),"all actual title and text rows visited and rendered");
}
assert(c.session.snapshot().url=="pb://about" and c.navigations==1,"last local link remains usable");assert(D.export_html(doc)==original,"source stays intact");
c.session.close();print "reader_text_fit_native_pass baseline_clipped="+str(clipped);
