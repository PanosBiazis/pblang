// Compare these deterministic fingerprints on both revisions. No artifact files.
let PB = import("stdlib/selfhost_pbck.sapp");
let FE = import("stdlib/compiler/selfhost_frontend.sapp");
let OPT = import("stdlib/compiler/optimizer.sapp");
fn fingerprint(chunk) { print sha256(str(PB.serialize_chunk(chunk))); }
let sources = [
    "fn f(a,b=2) { return a+b; } print f(3);",
    "fn outer(x) { return fn(y) { return x+y; }; } let f=outer(2); print f(5);",
    "let result=try missing() catch 9; print result;",
    "let i=0; let total=0; while i<300 { total=total+i; i=i+1; } print total;",
    "print \"Hello Ελληνικά 😀\\n\"; print true; print nil;"
];
let i = 0;
while i < len(sources) {
    let c = FE.frontend_compile(sources[i]);
    if not c.ok { throw "codec corpus compilation failed"; }
    fingerprint(c.chunk); fingerprint(OPT.optimize_safe(c.chunk).chunk); i = i + 1;
}
let empty = map{instructions:[],constants:[]};
fingerprint(map{instructions:[],constants:[map{
    arity:1048575,min_arity:1048574,chunk:empty,
    upvalues:[map{index:1048575,is_local:true},map{index:65536,is_local:false}]
}]});
fingerprint(map{instructions:[],constants:[map{arity:0,chunk:empty,upvalues:[]}]});
