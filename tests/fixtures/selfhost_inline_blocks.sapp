// Shared source for retained, self-hosted and serialized/native bytecode runs.
fn verify(value,label){if not value {throw label;}}
fn flags() {
    let caught=false;
    let result=try {throw "synthetic";} catch {caught=true;};
    return [caught,result];
}
verify(flags()==[true,nil],"catch writes enclosing scalar");
fn values() {
    let value=1;
    let empty={value=2;};
    let tail={let local=3;value=value+local;value};
    let nested=try {value=value+1;throw 1;} catch {value=value+1;value};
    return [value,empty,tail,nested];
}
verify(values()==[7,nil,5,7],"body, handler and nested blocks share caller slots");
fn shadows() {
    let value=9;
    let result={let value=3;{let value=4;value};value};
    return [value,result];
}
verify(shadows()==[9,3],"block declarations stay lexical");
fn return_boundary() {
    let result=try {return 7;} catch 90;
    let nested={if true {return 6;};99};
    let loop={while true {break;};5};
    return [result,nested,loop];
}
verify(return_boundary()==[7,6,5],"explicit control keeps function boundary");
fn closures() {
    let result={let value=[12];(fn(){return value;})};
    let alias={let value=map{n:7};value};
    alias.n=8;
    return [result()[0],alias.n];
}
verify(closures()==[12,8],"escaping closure and alias survive block cleanup");
let saved=[];
for i 2 {
    let next={let value=i+1;(fn(){return value;})};
    array_push(saved,next);
}
verify([saved[0](),saved[1]()]==[1,2],"repeated blocks retain separate closure environments");
fn failures() {
    let value=0;
    for i 8 {
        let result=try {value=value+1;throw 1;} catch {value=value+2;value};
        verify(result==(i+1)*3,"each handler observes current enclosing value");
    }
    return value;
}
verify(failures()==24,"repeated handlers preserve mutations");
verify({nil}==nil and {false}==false and {0}==0,"all tail values preserved");
let global_value=1;
let result={global_value=9;global_value};
verify(result==9 and global_value==9,"global assignment");
print "selfhost_inline_blocks_pass";
