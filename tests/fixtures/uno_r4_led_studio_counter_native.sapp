let M=import("../../examples/uno_r4_led_studio/model.sapp");let V=import("../../examples/uno_r4_led_studio/view.sapp");let G=import("stdlib:graphics.sapp");let GUI=import("stdlib:gui.sapp");
let app=V.create(390);M.apply(app.state,"add");V.sync(app);
let path=GUI.get(app.form,"import_path");path.value="build/uno-counter-import.json";
let win=G.Window(app.form.w,app.form.h,"PBLang UNO counter test");let start=now_ms();
G.run(win,app,fn(current,events){let dirty=V.update(current,events);if now_ms()-start>28000 {current.graphics_stop=true;}return dirty;},fn(current,canvas){
    V.draw(current,canvas);let state=current.state;
    fs_write("build/uno-counter-native-state.json",json_stringify(map{frames_sha:sha256(M.export_document(state)),project_sha:sha256(M.export_project(state)),count:len(state.document.frames),index:state.index,source:state.source,playing:state.playing,value:state.counter_value,generator:state.generator,status:state.status,pixel_enabled:GUI.get(current.form,"pixel_0").enabled,counter_end:GUI.get(current.form,"counter_end").value,counter_seconds:GUI.get(current.form,"counter_seconds").value}));
},30);
assert(not app.state.playing,"counter fixture left stopped");print "uno_r4_led_studio_counter_native_pass";
