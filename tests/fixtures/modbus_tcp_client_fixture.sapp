let MODBUS = import("stdlib:modbus_tcp.sapp");

let port = parse_number(env_get("PB_MODBUS_TEST_PORT"));
let result = MODBUS.read_ipv4("127.0.0.1", port, map{
    transaction_id: 0x1234, unit_id: 7, function: "holding",
    address: 0x0102, count: 2, timeout_ms: 5000
});
if not result.ok { throw "fixture Modbus client failed: " + result.error; }
print json_stringify(result);
