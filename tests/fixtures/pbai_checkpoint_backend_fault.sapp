// Fault injection only: copied over secure_file in an isolated synthetic installation.
// No filesystem operations; counters establish exact calls and original arguments.
let state=map{write:nil,read:nil,write_throws:false,read_throws:false,writes:0,reads:0};
fn configure(write_value,read_value,write_throws=false,read_throws=false) {
 state.write=write_value;state.read=read_value;state.write_throws=write_throws;state.read_throws=read_throws;
 state.writes=0;state.reads=0;
}
fn counts() {return map{writes:state.writes,reads:state.reads};}
fn write_text_new_exclusive(path,text,create_parent=true,private_parent=false) {
 assert(type(path)=="string" and type(text)=="string" and not create_parent and private_parent,"original save arguments retained");
 state.writes=state.writes+1;
 if state.write_throws {throw "SYNTHETIC_PRIVATE_BACKEND_ERROR";}
 return state.write;
}
fn read_text(path,max_bytes,private_parent=false) {
 assert(type(path)=="string" and max_bytes==4096 and private_parent,"original read bounds retained");
 state.reads=state.reads+1;
 if state.read_throws {throw "SYNTHETIC_PRIVATE_BACKEND_ERROR";}
 return state.read;
}
export configure,counts,write_text_new_exclusive,read_text;
