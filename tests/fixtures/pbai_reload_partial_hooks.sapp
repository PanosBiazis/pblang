// Test-only instrumentation in a PRIVATE copied owner. Observe actual values but
// retain no model/adapter reference from a partially completed constructor.
fn _partial_blocked(predict){return try {predict([6,0]);false} catch true;}
fn _partial_load(state,artifact){
 assert(state.calls<16,"bounded partial construction fixture");state.calls=state.calls+1;
 let matches=type(artifact)=="map" and map_has(artifact,"digest") and artifact.digest==state.target;
 if matches {state.target_calls=state.target_calls+1;}
 state.inject=matches and ((state.mode=="once" and state.target_calls==2)
  or (state.mode=="repeat" and (state.target_calls==2 or state.target_calls==4)));
 let event=map{call:state.calls,target:matches,target_call:if matches {state.target_calls} else {0},
  action:"entered",prior_candidate_closed:false,stages:[],real_stage_observed:false};
 push(state.events,event);
 let handle=state.load(artifact);
 event.action="loaded";push(state.handles,map{call:state.calls,target:matches,predict:handle.predict,close:handle.close});
 return handle;
}
fn _partial_observe(state,stage,value){
 let event=state.events[len(state.events)-1];
 assert(len(event.stages)<3,"bounded construction stages");
 if stage=="model" {
  assert(value.format=="pblang.llm.stacked_decoder.v1" and len(value.layers)==1
   and len(value.token_embedding)==8 and len(value.lm_head)==8,"real tiny model created");
 } else {
  assert((stage=="initial" or stage=="student") and value.format=="pblang.llm.lora_adapter.v1"
   and value.rank==1 and len(value.a_matrix)==8 and len(value.a_matrix[0])==1
   and len(value.b_matrix)==1 and len(value.b_matrix[0])==8,"real rank-one adapter created");
  if stage=="initial" {assert(value.steps==0,"actual initial adapter");}
  if stage=="student" and event.target {assert(value.steps==128,"actual reviewed saved student restored");}
 }
 push(event.stages,stage);event.real_stage_observed=true;
 if state.inject and stage==state.stage {
  let previous=state.handles[len(state.handles)-1];
  event.prior_candidate_closed=previous.target and _partial_blocked(previous.predict);
  event.action="partial_failure";state.failures=state.failures+1;
  throw "synthetic private partial construction failure";
 }
}
fn _partial_report(state){
 let closed=[];let all_closed=true;
 for item in state.handles {
  let before=_partial_blocked(item.predict);let again=item.close();
  let repeated=type(again)=="bool" and not again;
  if not before or not repeated {all_closed=false;}
  push(closed,map{call:item.call,target:item.target,closed_before_probe:before,repeated_close_false:repeated});
 }
 return map{mode:state.mode,fault_stage:state.stage,calls:state.calls,target_calls:state.target_calls,
  failures:state.failures,events:state.events,handles:closed,all_closed:all_closed,
  partial_memory_release_verified:false};
}
fn partial_fault_fixture(load,target,mode,stage){
 assert(type(load)=="fn" or type(load)=="closure","trusted original constructor required");
 assert(type(target)=="string" and len(target)==64,"synthetic digest required");
 assert(mode=="none" or mode=="once" or mode=="repeat","bounded fault mode required");
 assert(stage=="model" or stage=="initial" or stage=="student","bounded partial stage required");
 let state=map{load:load,target:target,mode:mode,stage:stage,inject:false,calls:0,target_calls:0,failures:0,events:[],handles:[]};
 return map{load:fn(artifact){return _partial_load(state,artifact);},
  observe:fn(at,value){_partial_observe(state,at,value);},report:fn(){return _partial_report(state);}};
}
export partial_fault_fixture;
