if 0.0 { print "bad"; } else { print "zero false"; }
if "" { print "bad"; } else { print "empty str false"; }
if [] { print "bad"; } else { print "empty array false"; }
if map{} { print "bad"; } else { print "empty map false"; }
if nil { print "bad"; } else { print "nil false"; }
if 1 { print "one true"; }
if "x" { print "nonempty true"; }
