// A prepared call node must be rejected as a default, never executed.
let I = import("stdlib/compiler/interp.sapp");
let ast = I.compile_program("fn private_default_canary() { print 987; return 1; } fn f(a = 1) { return a; } private_default_canary();");
ast.stmts[1].params[0].default = ast.stmts[2].expr;
I.eval_ast(ast);
