// Fixed trusted sources for long-branch correctness probes; not external input.
fn padding() { return str_repeat("print 1;", 9400); }
fn if_source(flag) {
    return "if "+str(flag)+" {return 42;"+padding()+"}else{return 17;}";
}
fn while_source(flag) {
    return "while "+str(flag)+" {return 42;"+padding()+"}return 17;";
}
fn mixed_source(flag) {
    return "fn small(x){return x+1;}fn big(flag){print \"before\";let i=0;while i<2 {i=i+1;if flag {print \"taken\";return small(41);"+padding()+"}elif i==1 {print \"again\";}else{print \"after\";}}return small(16);}return big("+str(flag)+");";
}
fn short_source(op, flag) {
    let entries=[];
    for i in range(0,16000) { push(entries,"k"+str(i)+":0"); }
    return "if "+str(flag)+" "+op+" map{"+str_join(entries,",")+"} {return 42;}return 17;";
}
fn nested_source(depth) {
    return str_repeat("if 0 {",depth)+padding()+str_repeat("}",depth)+"return 42;";
}
fn forward_source() {
    return "fn big(){let n=0;if 1 {n=41;}elif 0 {"+padding()+"}return later(n);}fn later(x){return x+1;}return big();";
}
export if_source, while_source, mixed_source, short_source, nested_source, forward_source;
