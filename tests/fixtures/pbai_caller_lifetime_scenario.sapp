fn _caller_workflow(){throw "test harness must supply the real caller";}
let N=import("stdlib:pbai_neural_adapter.sapp");
let target=env_get("PBAI_CALLER_TARGET");let benchmark=env_get("PBAI_CALLER_BENCHMARK")=="1";
let fixed=env_get("PBAI_CALLER_LIFETIME_PHASE")!="baseline";
let teacher=N.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let seed=N.distill(teacher.artifact,[[0]],[map{x:[7,0],y:4}]);
let active=N.student_load(seed.checkpoint());assert(seed.close(),"independent seed cleanup");
let active_before=json_stringify(active.predict([6,0]));let rows=[];
let modes=if benchmark {["success"]} else {["success","export_failure","use_failure","acquire_failure","success"]};
for mode in modes {
 N.caller_probe_configure(mode,target);
 let succeeded=try {_caller_workflow();true} catch false;
 let observed=N.caller_probe_observe();let failed=mode!="success";
 assert(succeeded!=failed and observed.injected==failed,"actual failure reached and preserved");
 let closed=0;let live=0;
 for row in observed.rows {
  assert(row.predict_closed==row.checkpoint_closed,"saved original operations agree about lifetime");
  if row.predict_closed {closed=closed+1;} else {live=live+1;}
  if fixed {assert(row.first_closes==1 and row.predict_closed,"caller explicitly retired each actual acquired handle");}
 }
 assert(len(observed.rows)>0,"observer saw actual construction");
 if not fixed {assert(live>0,"baseline exposes omitted caller cleanup");}
 assert(json_stringify(active.predict([6,0]))==active_before,"independent active model preserved on success/failure/recovery");
 push(rows,map{mode:mode,succeeded:succeeded,acquired:len(observed.rows),closed:closed,live:live,handles:observed.rows});
}
assert(active.close(),"independent caller cleanup");
print json_stringify(map{format:"pbai.caller-lifetime.v1",target:target,benchmark:benchmark,phase:if fixed {"fixed"} else {"baseline"},
 cases:len(rows),rows:rows,active_preserved:true,physical_memory_release_verified:false});
