let primary_probe=map{mode:"normal",items:[]};
fn primary_probe_reset(mode){primary_probe.mode=mode;primary_probe.items=[];}
fn _primary_close(row){
 row.attempts=row.attempts+1;
 if row.mode=="throw_before" {throw "synthetic private cleanup detail";}
 let closed=row.close();
 if row.mode=="throw_after" {throw "synthetic private cleanup detail";}
 if row.mode=="nil" {return nil;}
 return closed;
}
fn _primary_wrap(handle){
 let row=map{mode:primary_probe.mode,predict:handle.predict,checkpoint:handle.checkpoint,
  close:handle.close,attempts:0};
 if row.mode=="already_closed" {assert(row.close(),"test preclosed real handle");}
 push(primary_probe.items,row);handle.close=fn(){return _primary_close(row);};return handle;
}
fn primary_probe_observe(){let out=[];for row in primary_probe.items {
 let closed=try {row.predict([6,0]);false} catch true;
 let exported=try {row.checkpoint();false} catch true;assert(closed==exported,"original saved methods agree");
 let diagnostic=row.close();
 push(out,map{attempts:row.attempts,closed:closed,diagnostic_close:diagnostic});
 }return out;
}
export primary_probe_reset,primary_probe_observe;
