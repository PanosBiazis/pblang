let AI=import("stdlib/pbai.sapp");let N=import("stdlib:pbai_neural_adapter.sapp");
let bound=AI.neural_specialist_bind(N);let fixed=env_get("PBAI_TOOL_CLEANUP_PHASE")!="baseline";
let teacher=N.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let seed=N.distill(teacher.artifact,[[0],[1,0]],[map{x:[7,0],y:4}]);
let artifact=seed.checkpoint();assert(seed.close(),"seed explicitly closed");
let encoded=N.student_encode(artifact);let active=N.student_load(artifact);
let original=json_stringify(active.predict([0]));let rows=[];let legacy=[];
let routes=[map{name:"direct",call:N.student_tool},map{name:"legacy",call:AI.neural_specialist_student_tool},map{name:"binding",call:bound.student_tool}];
for route in routes {
 for mode in ["compact","verbose","throw_first","nan_second","cleanup_throw","cleanup_nil",
  "cleanup_number","cleanup_false","both_throw","both_nil","cleanup_before","both_before","recover"] {
  N.cleanup_probe_mode(mode);let count=N.cleanup_probe_count();
  let request=map{op:"predict_batch",checkpoint:artifact,contexts:[[0],[1,0]],include_logits:mode!="compact"};
  let before=json_stringify(request);let response=route.call(request);
  assert(N.cleanup_probe_count()==count+1,"one acquired private model");
  let state=N.cleanup_probe_inspect(count);
  let unreleased=mode=="cleanup_before" or mode=="both_before";
  assert(state.close_calls==1 and state.predict_closed!=unreleased and state.checkpoint_closed!=unreleased
   and state.evaluate_closed!=unreleased and state.compare_closed!=unreleased
   and state.diagnostic_close_released==unreleased,"caller closure observed before diagnostic cleanup");
  assert(state.predictions==(if mode=="throw_first" {1} else {2}),"prediction stops at original fault");
  let primary=mode=="throw_first" or mode=="nan_second" or mode=="both_throw" or mode=="both_nil" or mode=="both_before";
  let malformed=mode=="cleanup_nil" or mode=="cleanup_number";
  let cleanup=malformed or mode=="cleanup_throw" or mode=="cleanup_before";
  let code="";
  if primary {code="computation_failed";}
  else {if cleanup {if fixed {code="cleanup_failed";} else {if not malformed {code="computation_failed";}}}}
  assert(len(response)==4 and response.format=="pbai.neural.student-tool.v1","legacy response shape");
  if code!="" {
   assert(response.status=="error" and response.result==nil and response.error==code,"exact error precedence, no partial batch");
  } else {
   assert(response.status=="result" and response.error==nil and len(response.result.predictions)==2,"complete detached result");
   for i in range(0,2) {
    let predicted=response.result.predictions[i];let oracle=active.predict(request.contexts[i]);
    assert(predicted.index==i and predicted.token==oracle.token,"ordered token oracle");
    if mode=="compact" {assert(len(predicted)==2,"compact shape");}
    else {assert(json_stringify(predicted.logits)==json_stringify(oracle.logits),"detached logits after close");}
   }
  }
  if not cleanup {push(legacy,map{route:route.name,mode:mode,response:response});}
  assert(not str_contains(json_stringify(response),"synthetic private") and json_stringify(request)==before
   and N.student_encode(artifact)==encoded,"private faults suppressed and caller input unchanged");
  assert(json_stringify(active.predict([0]))==original and active.checkpoint().digest==artifact.digest,"independent active model preserved");
  push(rows,map{route:route.name,mode:mode,status:response.status,error:response.error,lifetime:state});
 }
 let count=N.cleanup_probe_count();
 let invalid=route.call(map{op:"predict_batch",checkpoint:artifact,contexts:[[0],[]],include_logits:false});
 assert(invalid.error=="invalid_request" and invalid.result==nil and N.cleanup_probe_count()==count,"preflight before acquisition");
 let corrupt=N.student_decode(encoded);corrupt.a[0][0]=999;
 let rejected=route.call(map{op:"predict_batch",checkpoint:corrupt,contexts:[[0]],include_logits:false});
 assert(rejected.error=="invalid_checkpoint" and rejected.result==nil and N.cleanup_probe_count()==count,"checkpoint rejected before acquisition");
 push(legacy,map{route:route.name,mode:"preflight",response:invalid});
 push(legacy,map{route:route.name,mode:"invalid_checkpoint",response:rejected});
}
assert(active.close(),"independent model explicitly closed by caller");
let active_state=N.cleanup_probe_inspect(0);
assert(active_state.close_calls==1 and active_state.predict_closed and not active_state.diagnostic_close_released,"caller ownership unchanged");
print json_stringify(map{format:"pbai.student-tool.cleanup.v1",rows:rows,legacy:legacy,preflight_cases:6,
 active_preserved:true,active_closed:true,seed_closed:true,physical_release_verified:false});
