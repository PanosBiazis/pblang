check(dioph.on_unit_circle and dioph.x_str == "5/13" and dioph.y_str == "12/13", "Diophantus circle parametrization (5/13)^2 + (12/13)^2 == 1");

// 8b. Indian: Chakravala Pell, Ramanujan 1914 modular pi, Madhava corrected pi
let pell61 = CANON.chakravala_pell(61);
check(pell61.verified and pell61.x_str == "1766319049" and pell61.y_str == "226153980", "Bhaskara II Chakravala N=61 -> (1766319049, 226153980)");
let pell2 = CANON.chakravala_pell(2);
