// 8a. Hellenic: Archimedes, Caratheodory (1907), Heron, Diophantus
let arch4 = CANON.archimedes_pi_bounds(4); // 96-gon
check(arch4.polygon_sides == "96" and arch4.strictly_brackets_pi and arch4.archimedes_classic_96gon_verified, "Archimedes 96-gon brackets 3+10/71 < L_4 < pi < U_4 < 3+1/7");
let arch24 = CANON.archimedes_pi_bounds(24);
check(arch24.strictly_brackets_pi and arch24.bound_width < 1e-13, "cancellation-free Archimedes 24 doublings width < 1e-13");

// Caratheodory's Theorem in R^2 (8 points -> <= 3 positive weights) and R^3 (9 points -> <= 4 positive weights)
let pts_2d = [[0.0, 0.0], [4.0, 0.0], [4.0, 4.0], [0.0, 4.0], [1.0, 3.0], [3.0, 1.0], [2.0, 3.5], [2.5, 0.5]];
let w_2d   = [0.10,       0.15,       0.12,       0.08,       0.20,       0.15,       0.10,       0.10];
let cara2 = CANON.caratheodory_convex_reduction(pts_2d, w_2d);
check(cara2.support_size <= 3 and cara2.reconstruction_error < 1e-14, "Caratheodory 2D reduces 8 points to <= 3 with exact convex sum");

let pts_3d = [
    [0.0, 0.0, 0.0], [3.0, 0.0, 0.0], [0.0, 3.0, 0.0], [0.0, 0.0, 3.0],
    [2.0, 2.0, 1.0], [1.0, 2.0, 2.0], [2.0, 1.0, 2.0], [1.5, 0.5, 2.5], [0.5, 2.5, 1.5]
];
let w_3d = [0.1, 0.1, 0.1, 0.1, 0.15, 0.15, 0.1, 0.1, 0.1];
let cara3 = CANON.caratheodory_convex_reduction(pts_3d, w_3d);
check(cara3.support_size <= 4 and cara3.reconstruction_error < 1e-14, "Caratheodory 3D reduces 9 points to <= 4 with exact convex sum");

let heron_84 = CANON.heron_area_exact(13, 14, 15);
check(heron_84.is_rational_area and heron_84.exact_area_str == "84", "Heron exact area(13, 14, 15) == 84");
