check(pell109.verified and pell109.x_str == "158070671986249" and pell109.y_str == "15140424455100", "Chakravala N=109 -> (158070671986249, 15140424455100)");

let ram4 = CANON.ramanujan_1914_pi(4);
check(str_starts_with(ram4.pi_decimal_50, "3.1415926535897932384626433832795"), "Ramanujan 1914 4 terms gives 31+ exact decimal digits of pi");
check(ram4.abs_error_float < 1e-15, "Ramanujan 1914 float machine precision");

let mad50 = CANON.madhava_corrected_pi(50);
check(mad50.corrected_error < 1e-10 and mad50.uncorrected_error > 0.015, "Madhava 3rd-order rational correction improves error by >8 orders of magnitude");

// 8c. Chinese & Japanese (Wasan): Seki-Aitken Delta^2 & Exact Sylvester Resultant
let seq_pi = [];
let ps_s = 0.0;
let ps_sgn = 1.0;
let pk = 0;
while pk < 12 {
    ps_s = ps_s + ps_sgn * (4.0 / (2.0 * pk + 1.0));
    ps_sgn = 0.0 - ps_sgn;
    array_push(seq_pi, ps_s);
    pk = pk + 1;
}
let ait = CANON.seki_aitken_delta2(seq_pi);
check(num_abs(ait.estimate - CANON.PI) < 0.001 and num_abs(ait.raw_last - CANON.PI) > 0.08, "Seki-Aitken Delta^2 accelerates alternating series");
let ait_plat = CANON.seki_aitken_delta2([3.0, 3.0, 3.0, 3.0]);
check(ait_plat.estimate == 3.0 and ait_plat.plateau_skips == 2, "Seki-Aitken safely skips 0/0 converged plateau without NaN");

let res_zero = CANON.sylvester_resultant([1, -5, 6], [1, 0, -4]); // common root x = 2
check(res_zero.has_common_root and res_zero.resultant_str == "0", "Sylvester resultant == 0 iff polynomials share a root");
let res_nz = CANON.sylvester_resultant([1, 0, 1], [1, -2]); // Res(x^2+1, x-2) = 2^2 + 1 = 5
check(not res_nz.has_common_root and res_nz.resultant_str == "5", "Sylvester resultant Res(x^2+1, x-2) == 5");

// 8d. Islamic Golden Age: Al-Tusi Spherical Triangle & Al-Kashi Cubic sin(1 deg)
let tusi = CANON.al_tusi_spherical_triangle(CANON.PI / 2.0, CANON.PI / 2.0, CANON.PI / 2.0);
check_near(tusi.side_c_rad, CANON.PI / 2.0, 1e-14, "Al-Tusi octant spherical side c == pi/2");
check_near(tusi.spherical_excess_rad, CANON.PI / 2.0, 1e-14, "Girard spherical excess of S^2 octant == pi/2");
check(tusi.sine_law_residual < 1e-15, "Al-Tusi spherical law of sines residual < 1e-15");

let kashi = CANON.al_kashi_cubic_trig_sin1deg();
check(kashi.abs_error < 1e-15 and kashi.cubic_residual < 1e-16, "Al-Kashi cubic contraction sin(1 deg) accurate to < 1e-15");

