// End-to-End Verification Suite for Open Backlog Capabilities (100% PBLang, 0 Lint Warnings)
// Covers: PB-04-013, PB-03-010, PB-03-006, PB-05-008, PB-05-018, PB-05-015, PB-04-005, PB-05-012, PB-05-021,
//         PB-01-004, PB-01-005, PB-03-001..005, PB-03-009, PB-04-001, PB-04-002, PB-04-012,
//         PB-02-004, PB-02-007, PB-02-009, PB-02-010, PB-02-013, PB-05-007, PB-05-009, PB-05-020

let Bcrypt = import("stdlib:password_bcrypt.sapp");
let BcryptLinux = import("stdlib:password_bcrypt_linux.sapp");
let Oidc = import("stdlib:oidc_sso.sapp");
let Consent = import("stdlib:user_consent_gate.sapp");
let Caps = import("stdlib:open_capabilities_suite.sapp");
let Manifest = import("stdlib:manifest_validate.sapp");
let Archive = import("stdlib:secure_archive.sapp");
let Tar = import("stdlib:tar.sapp");
let Pbz = import("stdlib:pbz.sapp");

let checks = 0;
fn check(cond, label) {
    if not cond {
        throw "OPEN_BACKLOG_CAPABILITIES_FAIL: " + label;
    }
    checks = checks + 1;
}

fn throws_err(action) {
    let failed = false;
    try action() catch {
        failed = true;
    };
    return failed;
}

// ── 1. PB-04-013: 100% Pure-PBLang OpenBSD $2b$ Bcrypt (Eksblowfish) ─────────
let v1 = Bcrypt.hash_with_setting("U*U", "$2b$05$CCCCCCCCCCCCCCCCCCCCC.", 0);
check(v1 == "$2b$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW", "OpenBSD $2b$05 vector 1 (U*U) got=" + v1);

let v2 = Bcrypt.hash_with_setting("U*U*", "$2b$05$CCCCCCCCCCCCCCCCCCCCC.", 0);
check(v2 == "$2b$05$CCCCCCCCCCCCCCCCCCCCC.VGOzA784oUp/Z0DY336zx7pLYAy0lwK", "OpenBSD $2b$05 vector 2 (U*U*)");

let v3 = Bcrypt.hash_with_setting("U*U*U", "$2b$05$XXXXXXXXXXXXXXXXXXXXXO", 0);
check(v3 == "$2b$05$XXXXXXXXXXXXXXXXXXXXXOAcXxm9kjPGEMsLznoKqmqw7tc8WCx4a", "OpenBSD $2b$05 vector 3 (U*U*U)");

let v4 = Bcrypt.hash_with_setting("Synthetic password 123!", "$2b$04$......................", 0);
check(v4 == "$2b$04$......................wHKzzlrPR443UehLm3Yke05hGRSg7GS", "libxcrypt parity $2b$04 vector 4");

let pure_prov = BcryptLinux.open_pure(4);
check(not pure_prov.ffi_used, "pure provider uses zero FFI");
let encoded_pw = pure_prov.hash("Synthetic password 123!");
check(Bcrypt.valid_hash(encoded_pw), "pure provider produces valid 60-char $2b$ hash");
check(pure_prov.verify("Synthetic password 123!", encoded_pw), "pure provider verify positive");
check(not pure_prov.verify("Wrong password 123!", encoded_pw), "pure provider verify negative");
check(throws_err(fn() { pure_prov.hash("short"); }), "pure provider rejects short password (<15 bytes)");
check(throws_err(fn() { pure_prov.hash("valid length password" + strfromcharcode(0)); }), "pure provider rejects NUL byte");
pure_prov.close();
check(throws_err(fn() { pure_prov.hash("Synthetic password 123!"); }), "closed pure provider rejects hash");

// ── 2. PB-03-010: OIDC & Multi-Tenant SSO (Google, Entra, Keycloak, PKCE) ───
// RFC 7636 Appendix B S256 test vector
let pkce = Oidc.create_pkce_challenge("dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk");
check(pkce.code_challenge == "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM", "RFC 7636 Appendix B S256 PKCE vector");
check(pkce.code_challenge_method == "S256", "PKCE method S256");

let google_prof = Oidc.provider_profile("google", map{
    client_id: "client-google-01",
    tenant_id: "acme-tenant.example.org"
});
let auth_req = Oidc.build_authorization_request(
    google_prof,
    "https://app.example.org/oidc/callback",
    "state_token_1234567890",
    "nonce_token_1234567890",
    "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
);
check(auth_req.ok and not auth_req.network_exchange_performed, "OIDC authorization request built offline");
check(str_contains(auth_req.authorization_url, "code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"), "OIDC URL embeds PKCE challenge");

// Microsoft Entra wildcard tenant guard
check(throws_err(fn() {
    Oidc.provider_profile("microsoft_entra", map{ client_id: "c1", tenant_id: "common" });
}), "Microsoft Entra rejects wildcard tenant by default");

let keycloak_prof = Oidc.provider_profile("keycloak", map{
    client_id: "kc-client",
    tenant_id: "corp-realm",
    base_url: "https://sso.example.org",
    realm: "corp-realm"
});
let verified_admin = Oidc.verify_id_token_claims(keycloak_prof, map{
    iss: "https://sso.example.org/realms/corp-realm",
    aud: "kc-client",
    sub: "user-admin-01",
    nonce: "nonce_token_1234567890",
    iat: 1700000000,
    exp: 1700003600,
    realm: "corp-realm",
    roles: ["viewer", "admin"]
}, "nonce_token_1234567890", 1700000100);
check(verified_admin.ok and verified_admin.is_admin, "Keycloak admin ID token verified");

check(not Oidc.verify_id_token_claims(keycloak_prof, map{
    iss: "https://sso.example.org/realms/corp-realm",
    aud: "kc-client",
    sub: "user-admin-01",
    nonce: "nonce_token_1234567890",
    iat: 1700000000,
    exp: 1700003600,
    realm: "other-realm",
    roles: ["admin"]
}, "nonce_token_1234567890", 1700000100).ok, "Cross-realm token claim rejected");

let reg = Oidc.create_tenant_registry();
let issued = reg.issue_session("sess_identifier_0001", verified_admin);
check(issued.ok, "Multi-tenant session issued");
check(reg.authorize("sess_identifier_0001", "corp-realm", "admin", 1700000200).allowed, "Tenant admin authorized");
check(not reg.authorize("sess_identifier_0001", "other-realm", "viewer", 1700000200).allowed, "Cross-tenant access denied");
reg.revoke_subject("corp-realm", "user-admin-01");
check(not reg.authorize("sess_identifier_0001", "corp-realm", "viewer", 1700000200).allowed, "Revoked subject immediately denied");

// ── 3. PB-03-006 & PB-05-008: Screen Sharing Preference & Phone/SMS Gate ────
let sp = Consent.create_screen_sharing_policy("owner_sess_12345", true, 5, 60000, 1000);
let unapproved_eval = Consent.evaluate_screen_sharing_request(sp, map{
    requester_session_id: "owner_sess_12345",
    target_id: "display-0",
    sensitive_action: false,
    now_ms: 2000
});
check(not unapproved_eval.allowed and unapproved_eval.reason == "target_approval_required", "Preference ON never bypasses target approval");

Consent.approve_screen_target(sp, "display-0", false);
let approved_eval = Consent.evaluate_screen_sharing_request(sp, map{
    requester_session_id: "owner_sess_12345",
    target_id: "display-0",
    sensitive_action: false,
    now_ms: 2000
});
check(approved_eval.allowed and approved_eval.owner_preference_active and not approved_eval.approvals_bypassed, "Owner preference ON allows approved target");

let sensitive_eval = Consent.evaluate_screen_sharing_request(sp, map{
    requester_session_id: "owner_sess_12345",
    target_id: "display-0",
    sensitive_action: true,
    now_ms: 2000
});
check(not sensitive_eval.allowed and sensitive_eval.reason == "sensitive_action_approval_required", "Sensitive action still requires explicit sensitive approval");

let non_owner_eval = Consent.evaluate_screen_sharing_request(sp, map{
    requester_session_id: "foreign_sess_999",
    target_id: "display-0",
    sensitive_action: false,
    now_ms: 2000
});
check(not non_owner_eval.allowed and non_owner_eval.reason == "non_owner_session_denied", "Non-owner session denied");

Consent.trigger_emergency_stop(sp);
let after_stop = Consent.evaluate_screen_sharing_request(sp, map{
    requester_session_id: "owner_sess_12345",
    target_id: "display-0",
    sensitive_action: false,
    now_ms: 2000
});
check(not after_stop.allowed and after_stop.reason == "emergency_stop_or_revoked", "Emergency stop halts sharing immediately");

// Phone / SMS explicit approval gate (PB-05-008)
let sms_plan = Consent.plan_sms_message("+306900000000", "Test verification code 1234");
check(sms_plan.ok and not sms_plan.executed and not sms_plan.hardware_transmitted, "SMS plan never sends without approval");
let no_approval_exec = Consent.execute_approved_action(sms_plan, nil, "", 5000);
check(not no_approval_exec.ok and no_approval_exec.error == "explicit_approval_required", "SMS execution blocked without approval record");

let sms_approval = Consent.issue_communication_approval(sms_plan, "local-operator", "APPROVE-TOKEN-9876543210", 5000, 30000);
let approved_exec = Consent.execute_approved_action(sms_plan, sms_approval, "APPROVE-TOKEN-9876543210", 6000);
check(approved_exec.ok and approved_exec.approval_verified and not approved_exec.hardware_transmitted, "Approved dry-run SMS verified");

let replay_exec = Consent.execute_approved_action(sms_plan, sms_approval, "APPROVE-TOKEN-9876543210", 6500);
check(not replay_exec.ok and replay_exec.error == "approval_already_used", "Single-use approval prevents replay");

// ── 4. PB-05-018, PB-05-015, PB-04-005, PB-05-012, PB-05-021 ───────────────
let bypass_tag = Caps.inspect_ble_tag_frame(map{
    model: "M2543T1",
    operation: "bypass_owner",
    owner_consent_token: "OWN-TOKEN-123456"
});
check(not bypass_tag.ok and bypass_tag.ownership_bypass_rejected, "Xiaomi Tag M2543T1 rejects ownership bypass");

let valid_tag = Caps.inspect_ble_tag_frame(map{
    model: "M2543T1",
    operation: "inspect_owned",
    owner_consent_token: "OWN-TOKEN-123456",
    battery_mv: 2950,
    rssi_dbm: -58
});
check(valid_tag.ok and valid_tag.battery_cell == "CR2032" and valid_tag.owner_verified, "Xiaomi Tag M2543T1 authorized telemetry verified");

let nyquist_fail = Caps.analyze_spectrum_ultrasound(map{
    sample_rate_hz: 48000,
    target_freq_hz: 25000,
    samples: [10, -10, 10, -10, 10, -10, 10, -10]
});
check(not nyquist_fail.ok and nyquist_fail.nyquist_limit_hz == 24000, "Ultrasound above Nyquist limit rejected");

let near_ultra_ok = Caps.analyze_spectrum_ultrasound(map{
    sample_rate_hz: 48000,
    target_freq_hz: 19500,
    samples: [100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100]
});
check(near_ultra_ok.ok and near_ultra_ok.band == "near-ultrasonic" and not near_ultra_ok.hardware_transmitted, "Near-ultrasonic PCM analysis within Nyquist bounds");

let app_schema = Caps.compile_template_to_app_schema(map{
    source_format: "xlsx",
    title: "Inventory & Cost Sheet",
    fields: [
        map{ name: "item_code", kind: "text", required: true },
        map{ name: "unit_price", kind: "currency", required: true },
        map{ name: "line_items", kind: "table", required: false }
    ]
});
check(app_schema.ok and app_schema.control_count == 3 and not app_schema.html_css_js_handwritten_required, "Excel template compiled to cross-target app schema");

let job_2d = Caps.validate_office_device_job(map{ device_class: "printer_2d", dpi: 600, copies: 2, pages: 10 });
check(job_2d.ok and job_2d.dimension_mode == "2D", "2D printer job contract verified");

check(not Caps.validate_office_device_job(map{ device_class: "fabricator_3d_nd", nozzle_temp_c: 450 }).ok, "3D thermal runaway temperature rejected");

let job_nd_ok = Caps.validate_office_device_job(map{ device_class: "fabricator_3d_nd", dimensions: 4, layer_height_mm: 0.15, nozzle_temp_c: 215, bed_temp_c: 60 });
check(job_nd_ok.ok and job_nd_ok.dimension_mode == "4D" and job_nd_ok.thermal_bounds_verified, "3D/nD fabricator job contract verified");

let synth_ds = Caps.generate_reproducible_research_dataset("research-seed-key-2026", ["subj-alpha", "subj-beta"], 4);
check(synth_ds.ok and synth_ds.pseudonymized and not synth_ds.raw_subject_ids_exposed and synth_ds.window_review.included_rows == 8, "Reproducible pseudonymized research dataset verified");

// ── 5. PB-01-005 & PB-01-004: Safe Package/Dependency/License/Capability Resolver ─
check(Manifest.is_supported_license("MIT") and Manifest.is_supported_license("Apache-2.0"), "Supported SPDX licenses");
check(Manifest.check_license_compatibility("MIT", "Apache-2.0").compatible, "MIT can depend on Apache-2.0");
check(not Manifest.check_license_compatibility("MIT", "GPL-3.0-only").compatible, "MIT cannot depend on GPL-3.0-only");

let pkg_graph_ok = Manifest.resolve_dependency_graph_safe([
    map{
        name: "app-root",
        version: "1.0.0",
        license: "MIT",
        required_capabilities: ["fs_read"],
        dependencies: [
            map{ name: "core-util", version: "^1.2.0", optional: false },
            map{ name: "opt-plugin", version: ">=2.0.0", optional: true }
        ]
    },
    map{
        name: "core-util",
        version: "1.4.2",
        license: "Apache-2.0",
        required_capabilities: ["fs_read"],
        dependencies: []
    }
], "app-root", ["fs_read"]);
check(pkg_graph_ok.ok and len(pkg_graph_ok.degraded_optional) == 1, "Safe fallback when optional dependency is absent");
check(pkg_graph_ok.order[0] == "core-util" and pkg_graph_ok.order[1] == "app-root", "Topological dependency install order verified");

let pkg_cycle = Manifest.resolve_dependency_graph_safe([
    map{ name: "pkg-a", version: "1.0.0", license: "MIT", dependencies: [map{ name: "pkg-b", version: "^1.0.0", optional: false }] },
    map{ name: "pkg-b", version: "1.0.0", license: "MIT", dependencies: [map{ name: "pkg-a", version: "^1.0.0", optional: false }] }
], "pkg-a", []);
check(not pkg_cycle.ok and pkg_cycle.code == "dependency_cycle_detected", "Dependency cycle detected deterministically");

// ── 6. PB-03-001..005 & PB-03-009: Desktop Control Broker, Single-GUI & Anti-Reset Consent ─
let broker = Consent.create_desktop_broker("broker-01", "desktop_session_owner_01", 1000);
let attach1 = Consent.request_broker_gui_attach(broker, "pid-1001");
check(attach1.ok and attach1.gui_instances == 1 and not attach1.duplicate_window_spawned, "First GUI attach succeeds");
let attach2 = Consent.request_broker_gui_attach(broker, "pid-1002");
check(attach2.ok and attach2.reused_existing_gui and attach2.gui_instances == 1 and not attach2.duplicate_window_spawned, "Duplicate GUI launch reuses single window (PB-03-001)");

let min_tr = Consent.transition_broker_window(broker, "minimized");
check(min_tr.ok and min_tr.window_state == "minimized" and min_tr.transport_connected and not min_tr.unintended_disconnect, "Minimize keeps transport connected without unintended disconnect (PB-03-002)");
let bg_tr = Consent.transition_broker_window(broker, "background");
check(bg_tr.ok and bg_tr.window_state == "background" and bg_tr.transport_connected, "Background keeps transport connected");
let fg_tr = Consent.transition_broker_window(broker, "foreground");
check(fg_tr.ok and fg_tr.window_state == "foreground" and fg_tr.transport_connected, "Restore foreground keeps transport connected");

let grant_rec = Consent.grant_scoped_tool_consent(broker, map{
    ai_client_id: "assistant-alpha",
    profile_mode: "work",
    tool_name: "desktop_input",
    target_app_id: "editor-window",
    target_device_id: "display-0",
    remember_checkbox: true,
    new_connection_dialog: "remembered_allow",
    sensitive_action_dialog: "explicit_per_action",
    unlimited_until_revoked: false,
    now_ms: 1000,
    duration_ms: 10000,
    max_events: 2,
    approval_nonce: "human-nonce-initial-0001"
});
check(Consent.evaluate_scoped_tool_action(broker, map{
    ai_client_id: "assistant-alpha",
    profile_mode: "work",
    tool_name: "desktop_input",
    target_app_id: "editor-window",
    target_device_id: "display-0",
    now_ms: 2000
}).allowed, "Scoped tool action 1 allowed");

// Cross-client / cross-profile / cross-target isolation (PB-03-005 & PB-03-009)
check(not Consent.evaluate_scoped_tool_action(broker, map{
    ai_client_id: "assistant-beta",
    profile_mode: "work",
    tool_name: "desktop_input",
    target_app_id: "editor-window",
    target_device_id: "display-0",
    now_ms: 2000
}).allowed, "Different AI client isolated and denied");

// Anti-hidden-reset check on silent renewal attempt (PB-03-004)
let silent_renew = Consent.attempt_consent_renewal(broker, grant_rec.scope_key, map{
    explicit_human_reapproval: false,
    additional_events: 100,
    additional_duration_ms: 60000
});
check(not silent_renew.ok and silent_renew.hidden_reset_blocked and silent_renew.max_events == 2, "Silent renewal blocked from resetting or extending limits (PB-03-004)");

// Explicit human re-approval with fresh nonce extends budget without erasing cumulative history
let human_renew = Consent.attempt_consent_renewal(broker, grant_rec.scope_key, map{
    explicit_human_reapproval: true,
    approval_nonce: "human-nonce-fresh-0002",
    additional_events: 2,
    additional_duration_ms: 5000
});
check(human_renew.ok and human_renew.renewed and human_renew.cumulative_events_consumed == 1 and human_renew.max_events == 4, "Explicit human renewal extends budget while preserving cumulative count");

// Unlimited-until-revoked mode + emergency stop (PB-03-003 & PB-03-004)
let unlim_grant = Consent.grant_scoped_tool_consent(broker, map{
    ai_client_id: "assistant-alpha",
    profile_mode: "work",
    tool_name: "screen_stream",
    target_app_id: "monitor-main",
    target_device_id: "display-0",
    remember_checkbox: true,
    unlimited_until_revoked: true,
    now_ms: 1000
});
check(unlim_grant.unlimited_until_revoked, "Unlimited until revoked grant created");
Consent.revoke_scoped_tool_consent(broker, unlim_grant.scope_key);
check(not Consent.evaluate_scoped_tool_action(broker, map{
    ai_client_id: "assistant-alpha",
    profile_mode: "work",
    tool_name: "screen_stream",
    target_app_id: "monitor-main",
    target_device_id: "display-0",
    now_ms: 2000
}).allowed, "Revoked unlimited grant immediately denied");

// ── 7. PB-04-001 & PB-04-002: Encrypted Archive & Multi-Format Safe Inspection ─
let enc_key = str_to_bytes("0123456789abcdef0123456789abcdef");
let enc_nonce = str_to_bytes("0123456789ab");
let enc_aad = str_to_bytes("archive-aad-v1");
let enc_archive = Archive.pack_encrypted([
    map{ name: "config/settings.json", data: str_to_bytes("{\"mode\":\"strict\"}") },
    map{ name: "notes/readme.txt", data: str_to_bytes("Encrypted archive payload") }
], enc_key, enc_nonce, enc_aad);
check(enc_archive.format == Archive.ENCRYPTED_FORMAT and enc_archive.entry_count == 2, "AES-256-GCM encrypted archive packed");

let enc_meta = Archive.inspect_encrypted(enc_archive, enc_key, enc_aad);
check(enc_meta.encrypted and enc_meta.authenticated and len(enc_meta.entries) == 2, "Encrypted archive metadata inspected with authentication");

let unpacked_ok = Archive.unpack_encrypted(enc_archive, enc_key, enc_aad);
check(len(unpacked_ok) == 2 and bytes_to_str(unpacked_ok[0].data) == "{\"mode\":\"strict\"}", "Encrypted archive authenticated and unpacked");

let wrong_key = str_to_bytes("X123456789abcdef0123456789abcdef");
check(throws_err(fn() { Archive.unpack_encrypted(enc_archive, wrong_key, enc_aad); }), "Wrong key rejected by AES-256-GCM tag verification");

// Multi-format inspection across TAR, PBZ, and ZIP (PB-04-002)
let tar_bytes = Tar.create([
    map{ name: "docs/guide.md", data: str_to_bytes("# Guide\nSafe tar entry") }
]);
let tar_insp = Archive.inspect_multi_format("tar", tar_bytes);
check(tar_insp.verified and len(tar_insp.entries) == 1 and tar_insp.entries[0].name == "docs/guide.md", "TAR archive safely inspected");

let pbz_bytes = Pbz.compress(str_to_bytes("print 42;"));
let pbz_insp = Archive.inspect_multi_format("pbz", pbz_bytes);
check(pbz_insp.verified and pbz_insp.expanded_bytes == 9, "PBZ archive safely inspected");

// ── 8. PB-02-004, PB-02-007, PB-02-009, PB-02-010, PB-02-013: Runtime Safety ─
let arena = Caps.create_memory_safety_arena(1024, 4, 5000, true);
let a1 = Caps.arena_alloc(arena, "buf-main", 512, "dig-v1", 1000);
check(a1.ok and a1.used_bytes == 512, "Arena allocation within bounds");
let a_exhaust = Caps.arena_alloc(arena, "buf-huge", 600, "dig-v1", 1000);
check(not a_exhaust.ok and a_exhaust.code == "memory_exhaustion_prevented", "Arena memory exhaustion prevented (PB-02-007)");

let ticket = Caps.arena_issue_toctou_ticket(arena, a1.handle_id);
let enter1 = Caps.arena_enter_exclusive(arena, a1.handle_id, "dig-v2", 1100);
check(enter1.ok and enter1.generation == 2, "Exclusive arena mutation increments generation");
let reentrant = Caps.arena_enter_exclusive(arena, a1.handle_id, nil, 1150);
check(not reentrant.ok and reentrant.code == "reentrant_or_concurrent_access_denied", "Reentrant access blocked (PB-02-004)");
Caps.arena_leave_exclusive(arena, a1.handle_id);

let toctou_check = Caps.arena_verify_toctou_ticket(arena, ticket);
check(not toctou_check.ok and toctou_check.toctou_detected, "TOCTOU state change between check and use detected (PB-02-004)");

let free1 = Caps.arena_free(arena, a1.handle_id);
check(free1.ok and not free1.double_free_detected, "First arena free succeeds");
let free2 = Caps.arena_free(arena, a1.handle_id);
check(not free2.ok and free2.double_free_detected, "Double free deterministically blocked (PB-02-004)");

let a2 = Caps.arena_alloc(arena, "buf-idle", 256, "dig-idle", 1000);
check(a2.ok, "Second arena allocation succeeds");
let trim_res = Caps.arena_trim_idle(arena, 7000);
check(trim_res.ok and trim_res.trimmed_handles == 1 and trim_res.reclaimed_bytes == 256, "Idle arena memory trimmed on schedule (PB-02-007)");

Caps.arena_begin_cleanup(arena);
let cleanup_alloc = Caps.arena_alloc(arena, "buf-late", 64, "dig", 8000);
check(not cleanup_alloc.ok and cleanup_alloc.code == "mutation_during_cleanup_denied", "Mutation during cleanup phase denied (PB-02-004)");

// Bounded async coordinator (PB-02-009)
let coord = Caps.create_bounded_async_coordinator(1, 1, 1000);
let t1 = Caps.submit_bounded_async_task(coord, "worker-1", 100, 500);
let t2 = Caps.submit_bounded_async_task(coord, "queued-2", 100, 500);
let t3 = Caps.submit_bounded_async_task(coord, "overflow-3", 100, 500);
check(t1.accepted and t1.status == "running" and t2.accepted and t2.status == "queued" and t3.code == "queue_backpressure_limit_reached", "Async queue backpressure enforced");
let sweep = Caps.sweep_bounded_async_deadlines(coord, 700);
check(sweep.ok and sweep.expired_count == 2 and sweep.recommended_idle_backoff_ms == 250, "Async deadlines swept and idle backoff engaged");

// Transactional lockfile publication & cleanup error preservation (PB-02-013)
check(not Caps.execute_transactional_lock_publication("CON.lock", fn() { return map{ ok: true }; }, fn() { return map{ ok: true }; }).ok, "Windows reserved device name rejected in lockfile path");
let lock_pub = Caps.execute_transactional_lock_publication(
    "/tmp/workspace/state.lock",
    fn() { return map{ ok: true, value: "published-v1" }; },
    fn() { return map{ ok: false, error: "unlink_permission_warning" }; }
);
check(lock_pub.committed and lock_pub.primary_result_preserved and lock_pub.primary_value == "published-v1" and not lock_pub.cleanup_ok, "Cleanup error reported without corrupting committed primary result (PB-02-013)");

// Process diagnostics & safe cleanup plan (PB-02-010)
let proc_diag = Caps.diagnose_and_plan_process_cleanup([
    map{ pid: 2010, ppid: 2000, state: "Z", owned_by_session: true },
    map{ pid: 2011, ppid: 1, state: "S", owned_by_session: true },
    map{ pid: 9999, ppid: 1, state: "Z", owned_by_session: false }
], [2000], false);
check(proc_diag.ok and len(proc_diag.zombie_pids) == 1 and len(proc_diag.orphan_pids) == 1 and proc_diag.unrelated_processes_touched == 0, "Zombie/orphan diagnostics ignore unrelated processes (PB-02-010)");

// ── 9. PB-05-007, PB-05-009, PB-05-020 & PB-04-012 ──────────────────────────
let cam_no_ind = Caps.authorize_peripheral_device_operation(map{
    device_kind: "camera",
    target_device_id: "cam-front-0",
    target_auth_token: "TARGET-AUTH-TOKEN-0001",
    expected_target_token: "TARGET-AUTH-TOKEN-0001",
    hardware_or_os_indicator_active: false
});
check(not cam_no_ind.allowed and cam_no_ind.error == "visible_capture_indicator_required", "Camera capture denied without active indicator");

let stylus_ok = Caps.authorize_peripheral_device_operation(map{
    device_kind: "stylus",
    target_device_id: "board-stylus-01",
    target_auth_token: "TARGET-AUTH-TOKEN-0001",
    expected_target_token: "TARGET-AUTH-TOKEN-0001"
});
check(stylus_ok.ok and stylus_ok.allowed and not stylus_ok.hardware_connected, "Stylus/board target authorization verified");

let rt_eval = Caps.evaluate_soft_realtime_stream(map{ deadline_budget_ms: 20 }, [8, 10, 11, 12, 14, 15, 16, 18, 19, 25]);
check(rt_eval.ok and not rt_eval.hard_realtime_guaranteed and rt_eval.deadline_misses == 1, "Soft-realtime stream monitor reports honest non-hard-RT contract (PB-05-020)");

// RBAC, TOTP & single-use recovery codes (PB-04-012)
check(Caps.validate_role("admin") and not Caps.validate_role("super_hacker"), "RBAC role validation");
check(Caps.authorize_role_action("admin", "operator", "rotate_keys").allowed, "Admin satisfies operator requirement");
check(not Caps.authorize_role_action("viewer", "editor", "update_record").allowed, "Viewer denied editor action");

let totp_secret = "JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP";
let code_t0 = Caps.compute_totp_code(totp_secret, 1700000000, 30);
check(len(code_t0) == 6, "6-digit TOTP code generated");
let totp_ver = Caps.verify_totp_code(totp_secret, code_t0, 1700000025, 30, 1);
check(totp_ver.ok and totp_ver.verified, "TOTP code verified within window");

let rec_bundle = Caps.generate_recovery_bundle("recovery-master-seed-2026", "acct-01", 4);
check(rec_bundle.ok and len(rec_bundle.plaintext_codes) == 4, "4 single-use recovery codes generated");
let first_code = rec_bundle.plaintext_codes[0];
let red1 = Caps.redeem_recovery_code(rec_bundle.recovery_state, first_code);
check(red1.ok and red1.redeemed and red1.remaining_count == 3, "First recovery code redemption succeeds");
let red2 = Caps.redeem_recovery_code(rec_bundle.recovery_state, first_code);
check(not red2.ok and red2.replay_blocked, "Recovery code replay blocked");

print "OPEN_BACKLOG_CAPABILITIES_PASS checks=" + str(checks);
