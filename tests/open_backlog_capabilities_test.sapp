// End-to-End Verification Suite for Open Backlog Capabilities (100% PBLang, 0 Lint Warnings)
// Covers: PB-04-013, PB-03-010, PB-03-006, PB-05-008, PB-05-018, PB-05-015, PB-04-005, PB-05-012, PB-05-021

let Bcrypt = import("stdlib:password_bcrypt.sapp");
let BcryptLinux = import("stdlib:password_bcrypt_linux.sapp");
let Oidc = import("stdlib:oidc_sso.sapp");
let Consent = import("stdlib:user_consent_gate.sapp");
let Caps = import("stdlib:open_capabilities_suite.sapp");

let checks = 0;
fn check(cond, label) {
    if not cond {
        throw "OPEN_BACKLOG_CAPABILITIES_FAIL: " + label;
    }
    checks = checks + 1;
}

fn throws_err(action) {
    let failed = false;
    try action() catch {
        failed = true;
    };
    return failed;
}

// ── 1. PB-04-013: 100% Pure-PBLang OpenBSD $2b$ Bcrypt (Eksblowfish) ─────────
let v1 = Bcrypt.hash_with_setting("U*U", "$2b$05$CCCCCCCCCCCCCCCCCCCCC.", 0);
check(v1 == "$2b$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW", "OpenBSD $2b$05 vector 1 (U*U) got=" + v1);

let v2 = Bcrypt.hash_with_setting("U*U*", "$2b$05$CCCCCCCCCCCCCCCCCCCCC.", 0);
check(v2 == "$2b$05$CCCCCCCCCCCCCCCCCCCCC.VGOzA784oUp/Z0DY336zx7pLYAy0lwK", "OpenBSD $2b$05 vector 2 (U*U*)");

let v3 = Bcrypt.hash_with_setting("U*U*U", "$2b$05$XXXXXXXXXXXXXXXXXXXXXO", 0);
check(v3 == "$2b$05$XXXXXXXXXXXXXXXXXXXXXOAcXxm9kjPGEMsLznoKqmqw7tc8WCx4a", "OpenBSD $2b$05 vector 3 (U*U*U)");

let v4 = Bcrypt.hash_with_setting("Synthetic password 123!", "$2b$04$......................", 0);
check(v4 == "$2b$04$......................wHKzzlrPR443UehLm3Yke05hGRSg7GS", "libxcrypt parity $2b$04 vector 4");

let pure_prov = BcryptLinux.open_pure(4);
check(not pure_prov.ffi_used, "pure provider uses zero FFI");
let encoded_pw = pure_prov.hash("Synthetic password 123!");
check(Bcrypt.valid_hash(encoded_pw), "pure provider produces valid 60-char $2b$ hash");
check(pure_prov.verify("Synthetic password 123!", encoded_pw), "pure provider verify positive");
check(not pure_prov.verify("Wrong password 123!", encoded_pw), "pure provider verify negative");
check(throws_err(fn() { pure_prov.hash("short"); }), "pure provider rejects short password (<15 bytes)");
check(throws_err(fn() { pure_prov.hash("valid length password" + strfromcharcode(0)); }), "pure provider rejects NUL byte");
pure_prov.close();
check(throws_err(fn() { pure_prov.hash("Synthetic password 123!"); }), "closed pure provider rejects hash");

// ── 2. PB-03-010: OIDC & Multi-Tenant SSO (Google, Entra, Keycloak, PKCE) ───
// RFC 7636 Appendix B S256 test vector
let pkce = Oidc.create_pkce_challenge("dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk");
check(pkce.code_challenge == "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM", "RFC 7636 Appendix B S256 PKCE vector");
check(pkce.code_challenge_method == "S256", "PKCE method S256");

let google_prof = Oidc.provider_profile("google", map{
    client_id: "client-google-01",
    tenant_id: "acme-tenant.example.org"
});
let auth_req = Oidc.build_authorization_request(
    google_prof,
    "https://app.example.org/oidc/callback",
    "state_token_1234567890",
    "nonce_token_1234567890",
    "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
);
check(auth_req.ok and not auth_req.network_exchange_performed, "OIDC authorization request built offline");
check(str_contains(auth_req.authorization_url, "code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"), "OIDC URL embeds PKCE challenge");

// Microsoft Entra wildcard tenant guard
check(throws_err(fn() {
    Oidc.provider_profile("microsoft_entra", map{ client_id: "c1", tenant_id: "common" });
}), "Microsoft Entra rejects wildcard tenant by default");

let keycloak_prof = Oidc.provider_profile("keycloak", map{
    client_id: "kc-client",
    tenant_id: "corp-realm",
    base_url: "https://sso.example.org",
    realm: "corp-realm"
});
let verified_admin = Oidc.verify_id_token_claims(keycloak_prof, map{
    iss: "https://sso.example.org/realms/corp-realm",
    aud: "kc-client",
    sub: "user-admin-01",
    nonce: "nonce_token_1234567890",
    iat: 1700000000,
    exp: 1700003600,
    realm: "corp-realm",
    roles: ["viewer", "admin"]
}, "nonce_token_1234567890", 1700000100);
check(verified_admin.ok and verified_admin.is_admin, "Keycloak admin ID token verified");

check(not Oidc.verify_id_token_claims(keycloak_prof, map{
    iss: "https://sso.example.org/realms/corp-realm",
    aud: "kc-client",
    sub: "user-admin-01",
    nonce: "nonce_token_1234567890",
    iat: 1700000000,
    exp: 1700003600,
    realm: "other-realm",
    roles: ["admin"]
}, "nonce_token_1234567890", 1700000100).ok, "Cross-realm token claim rejected");

let reg = Oidc.create_tenant_registry();
let issued = reg.issue_session("sess_identifier_0001", verified_admin);
check(issued.ok, "Multi-tenant session issued");
check(reg.authorize("sess_identifier_0001", "corp-realm", "admin", 1700000200).allowed, "Tenant admin authorized");
check(not reg.authorize("sess_identifier_0001", "other-realm", "viewer", 1700000200).allowed, "Cross-tenant access denied");
reg.revoke_subject("corp-realm", "user-admin-01");
check(not reg.authorize("sess_identifier_0001", "corp-realm", "viewer", 1700000200).allowed, "Revoked subject immediately denied");

// ── 3. PB-03-006 & PB-05-008: Screen Sharing Preference & Phone/SMS Gate ────
let sp = Consent.create_screen_sharing_policy("owner_sess_12345", true, 5, 60000, 1000);
let unapproved_eval = Consent.evaluate_screen_sharing_request(sp, map{
    requester_session_id: "owner_sess_12345",
    target_id: "display-0",
    sensitive_action: false,
    now_ms: 2000
});
check(not unapproved_eval.allowed and unapproved_eval.reason == "target_approval_required", "Preference ON never bypasses target approval");

Consent.approve_screen_target(sp, "display-0", false);
let approved_eval = Consent.evaluate_screen_sharing_request(sp, map{
    requester_session_id: "owner_sess_12345",
    target_id: "display-0",
    sensitive_action: false,
    now_ms: 2000
});
check(approved_eval.allowed and approved_eval.owner_preference_active and not approved_eval.approvals_bypassed, "Owner preference ON allows approved target");

let sensitive_eval = Consent.evaluate_screen_sharing_request(sp, map{
    requester_session_id: "owner_sess_12345",
    target_id: "display-0",
    sensitive_action: true,
    now_ms: 2000
});
check(not sensitive_eval.allowed and sensitive_eval.reason == "sensitive_action_approval_required", "Sensitive action still requires explicit sensitive approval");

let non_owner_eval = Consent.evaluate_screen_sharing_request(sp, map{
    requester_session_id: "foreign_sess_999",
    target_id: "display-0",
    sensitive_action: false,
    now_ms: 2000
});
check(not non_owner_eval.allowed and non_owner_eval.reason == "non_owner_session_denied", "Non-owner session denied");

Consent.trigger_emergency_stop(sp);
let after_stop = Consent.evaluate_screen_sharing_request(sp, map{
    requester_session_id: "owner_sess_12345",
    target_id: "display-0",
    sensitive_action: false,
    now_ms: 2000
});
check(not after_stop.allowed and after_stop.reason == "emergency_stop_or_revoked", "Emergency stop halts sharing immediately");

// Phone / SMS explicit approval gate (PB-05-008)
let sms_plan = Consent.plan_sms_message("+306900000000", "Test verification code 1234");
check(sms_plan.ok and not sms_plan.executed and not sms_plan.hardware_transmitted, "SMS plan never sends without approval");
let no_approval_exec = Consent.execute_approved_action(sms_plan, nil, "", 5000);
check(not no_approval_exec.ok and no_approval_exec.error == "explicit_approval_required", "SMS execution blocked without approval record");

let sms_approval = Consent.issue_communication_approval(sms_plan, "local-operator", "APPROVE-TOKEN-9876543210", 5000, 30000);
let approved_exec = Consent.execute_approved_action(sms_plan, sms_approval, "APPROVE-TOKEN-9876543210", 6000);
check(approved_exec.ok and approved_exec.approval_verified and not approved_exec.hardware_transmitted, "Approved dry-run SMS verified");

let replay_exec = Consent.execute_approved_action(sms_plan, sms_approval, "APPROVE-TOKEN-9876543210", 6500);
check(not replay_exec.ok and replay_exec.error == "approval_already_used", "Single-use approval prevents replay");

// ── 4. PB-05-018, PB-05-015, PB-04-005, PB-05-012, PB-05-021 ───────────────
let bypass_tag = Caps.inspect_ble_tag_frame(map{
    model: "M2543T1",
    operation: "bypass_owner",
    owner_consent_token: "OWN-TOKEN-123456"
});
check(not bypass_tag.ok and bypass_tag.ownership_bypass_rejected, "Xiaomi Tag M2543T1 rejects ownership bypass");

let valid_tag = Caps.inspect_ble_tag_frame(map{
    model: "M2543T1",
    operation: "inspect_owned",
    owner_consent_token: "OWN-TOKEN-123456",
    battery_mv: 2950,
    rssi_dbm: -58
});
check(valid_tag.ok and valid_tag.battery_cell == "CR2032" and valid_tag.owner_verified, "Xiaomi Tag M2543T1 authorized telemetry verified");

let nyquist_fail = Caps.analyze_spectrum_ultrasound(map{
    sample_rate_hz: 48000,
    target_freq_hz: 25000,
    samples: [10, -10, 10, -10, 10, -10, 10, -10]
});
check(not nyquist_fail.ok and nyquist_fail.nyquist_limit_hz == 24000, "Ultrasound above Nyquist limit rejected");

let near_ultra_ok = Caps.analyze_spectrum_ultrasound(map{
    sample_rate_hz: 48000,
    target_freq_hz: 19500,
    samples: [100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100, 100, -100]
});
check(near_ultra_ok.ok and near_ultra_ok.band == "near-ultrasonic" and not near_ultra_ok.hardware_transmitted, "Near-ultrasonic PCM analysis within Nyquist bounds");

let app_schema = Caps.compile_template_to_app_schema(map{
    source_format: "xlsx",
    title: "Inventory & Cost Sheet",
    fields: [
        map{ name: "item_code", kind: "text", required: true },
        map{ name: "unit_price", kind: "currency", required: true },
        map{ name: "line_items", kind: "table", required: false }
    ]
});
check(app_schema.ok and app_schema.control_count == 3 and not app_schema.html_css_js_handwritten_required, "Excel template compiled to cross-target app schema");

let job_2d = Caps.validate_office_device_job(map{ device_class: "printer_2d", dpi: 600, copies: 2, pages: 10 });
check(job_2d.ok and job_2d.dimension_mode == "2D", "2D printer job contract verified");

check(not Caps.validate_office_device_job(map{ device_class: "fabricator_3d_nd", nozzle_temp_c: 450 }).ok, "3D thermal runaway temperature rejected");

let job_nd_ok = Caps.validate_office_device_job(map{ device_class: "fabricator_3d_nd", dimensions: 4, layer_height_mm: 0.15, nozzle_temp_c: 215, bed_temp_c: 60 });
check(job_nd_ok.ok and job_nd_ok.dimension_mode == "4D" and job_nd_ok.thermal_bounds_verified, "3D/nD fabricator job contract verified");

let synth_ds = Caps.generate_reproducible_research_dataset("research-seed-key-2026", ["subj-alpha", "subj-beta"], 4);
check(synth_ds.ok and synth_ds.pseudonymized and not synth_ds.raw_subject_ids_exposed and synth_ds.window_review.included_rows == 8, "Reproducible pseudonymized research dataset verified");

print "OPEN_BACKLOG_CAPABILITIES_PASS checks=" + str(checks);
