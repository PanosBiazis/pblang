// tests/path_b_native_sovereign_test.sapp
//
// Path B — Pure-PBLang Self-Hosting Native Machine-Code Compiler Verification Suite:
//   1. Static freestanding Linux x86-64 ELF64 (codegen_x64.sapp):
//      - Compact ELF64 size discipline (<= 425 bytes minimal, < 20 KB full showcase)
//      - 5-level hardware stack-unwinding try/catch/throw + caught_error() + OOB/map traps
//      - Mutable heap-boxed closures (TAG_BOX)
//      - Dynamic auto-growing open-addressed hash maps (60 keys, tombstones, iteration)
//      - Cheney 2-space compacting GC + SYS_madvise(MADV_DONTNEED) (< 64 KB live after 5,000 turns)
//      - Direct Linux x86-64 syscalls + fork/waitpid + loopback IPv4 TCP roundtrip
//   2. Dynamic Linux x86-64 ELF64 Native FFI (elf_dyn_x64.sapp):
//      - PT_INTERP + .plt/.got dlopen/dlsym/dlclose + SysV AMD64 GP & SSE2 xmm0/xmm1 trampolines
//      - Live libm.so.6 (sqrt/hypot/pow), libX11.so.6, and libsqlite3.so.0 (:memory: SQL)
//   3. Cross-platform Windows x86-64 PE32+ executable emitter (codegen_pe64.sapp):
//      - Valid MZ/PE32+ headers, .text + .idata sections, KERNEL32.dll Import Directory & IAT
//   4. True 3-stage native self-hosting fixed-point (stage1_elf -> stage2_elf == stage3_elf):
//      - Byte-for-byte binary identity of stage2_elf and stage3_elf + stage3 native execution
//   5. Self-hosted OP_DEFER -> .pbck translation + tools/pbc.sapp multi-target CLI

let SmallX64 = import("stdlib/codegen_x64.sapp");
let X64 = import("stdlib/native/codegen_x64.sapp");
let DynX64 = import("stdlib/native/elf_dyn_x64.sapp");
let Pe64 = import("stdlib/native/codegen_pe64.sapp");
let SOURCE = import("stdlib/compiler/checked_source.sapp");
let CODE = import("stdlib/compiler/codegen.sapp");
let PBCK = import("stdlib/selfhost_to_pbck.sapp");
let OS = import("stdlib/os.sapp");

fn fail(msg) {
    throw "FAIL path_b_native_sovereign_test: " + msg;
}

fn assert_eq(got, want, label) {
    if got != want {
        fail(label + ": expected '" + str(want) + "', got '" + str(got) + "'");
    }
}

fn read_u16_le(b, off) {
    return b[off] + b[off + 1] * 256;
}

fn read_u32_le(b, off) {
    return b[off] + b[off + 1] * 256 + b[off + 2] * 65536 + b[off + 3] * 16777216;
}

fn bytes_contain_ascii(haystack, text) {
    let n = len(haystack);
    let m = len(text);
    if m == 0 { return true; }
    let i = 0;
    while i + m <= n {
        let ok = true;
        let j = 0;
        while j < m {
            if haystack[i + j] != strcharcodeat(text, j) {
                ok = false;
                j = m;
            } else {
                j = j + 1;
            }
        }
        if ok { return true; }
        i = i + 1;
    }
    return false;
}

fn find_pblang_bin() {
    if fs_exists("./target/release/pblang") { return "./target/release/pblang"; }
    if fs_exists("./target/debug/pblang") { return "./target/debug/pblang"; }
    return "pblang";
}

fn self_cc_source() {
    return "// Pure-PBLang Self-Hosting x86-64 ELF64 Native Machine-Code Compiler.\n// Compiles PBLang source directly into a standalone Linux x86-64 ELF64 executable\n// (zero Rust, zero C, zero libc, zero external assembler/linker) and compiles ITSELF\n// to an exact binary fixed-point: stage2_elf == stage3_elf.\n\nfn push_u16(b, v) {\n    push(b, v % 256);\n    push(b, (v / 256) % 256);\n}\n\nfn push_u32(b, v) {\n    let x = v;\n    if x < 0 { x = x + 4294967296; }\n    push(b, x % 256);\n    x = x / 256;\n    push(b, x % 256);\n    x = x / 256;\n    push(b, x % 256);\n    x = x / 256;\n    push(b, x % 256);\n}\n\nfn push_u64_lo(b, lo, hi) {\n    push_u32(b, lo);\n    push_u32(b, hi);\n}\n\nfn patch_u32(b, pos, v) {\n    let x = v;\n    if x < 0 { x = x + 4294967296; }\n    b[pos] = x % 256;\n    x = x / 256;\n    b[pos + 1] = x % 256;\n    x = x / 256;\n    b[pos + 2] = x % 256;\n    x = x / 256;\n    b[pos + 3] = x % 256;\n}\n\nfn is_alpha(c) {\n    if c >= 65 and c <= 90 { return 1; }\n    if c >= 97 and c <= 122 { return 1; }\n    if c == 95 { return 1; }\n    return 0;\n}\n\nfn is_digit(c) {\n    if c >= 48 and c <= 57 { return 1; }\n    return 0;\n}\n\nfn is_kw(s) {\n    if str_eq(s, \"fn\") == 1 or str_eq(s, \"let\") == 1 or str_eq(s, \"if\") == 1 or str_eq(s, \"elif\") == 1 or str_eq(s, \"else\") == 1 { return 1; }\n    if str_eq(s, \"while\") == 1 or str_eq(s, \"return\") == 1 or str_eq(s, \"print\") == 1 or str_eq(s, \"and\") == 1 or str_eq(s, \"or\") == 1 { return 1; }\n    return 0;\n}\n\nfn tokenize(src, kinds, texts, nums) {\n    let n = len(src);\n    let i = 0;\n    while i < n {\n        let c = strcharcodeat(src, i);\n        if c == 32 or c == 9 or c == 10 or c == 13 {\n            i = i + 1;\n        } elif c == 47 and i + 1 < n and strcharcodeat(src, i + 1) == 47 {\n            i = i + 2;\n            while i < n and strcharcodeat(src, i) != 10 { i = i + 1; }\n        } elif is_digit(c) == 1 {\n            let v = 0;\n            while i < n and is_digit(strcharcodeat(src, i)) == 1 {\n                v = v * 10 + (strcharcodeat(src, i) - 48);\n                i = i + 1;\n            }\n            push(kinds, 1); push(texts, \"\"); push(nums, v);\n        } elif is_alpha(c) == 1 {\n            let st = i;\n            while i < n and (is_alpha(strcharcodeat(src, i)) == 1 or is_digit(strcharcodeat(src, i)) == 1) {\n                i = i + 1;\n            }\n            let w = str_slice(src, st, i);\n            if is_kw(w) == 1 { push(kinds, 4); } else { push(kinds, 3); }\n            push(texts, w); push(nums, 0);\n        } elif c == 34 {\n            i = i + 1;\n            let s = \"\";\n            while i < n and strcharcodeat(src, i) != 34 {\n                let ch = strcharcodeat(src, i);\n                if ch == 92 {\n                    i = i + 1;\n                    let ec = strcharcodeat(src, i);\n                    if ec == 110 { s = s + strfromcharcode(10); }\n                    elif ec == 116 { s = s + strfromcharcode(9); }\n                    elif ec == 34 { s = s + strfromcharcode(34); }\n                    elif ec == 92 { s = s + strfromcharcode(92); }\n                    else { s = s + strfromcharcode(ec); }\n                    i = i + 1;\n                } else {\n                    let st2 = i;\n                    while i < n and strcharcodeat(src, i) != 34 and strcharcodeat(src, i) != 92 {\n                        i = i + 1;\n                    }\n                    s = s + str_slice(src, st2, i);\n                }\n            }\n            i = i + 1;\n            push(kinds, 2); push(texts, s); push(nums, 0);\n        } else {\n            let two = \"\";\n            if i + 1 < n { two = str_slice(src, i, i + 2); }\n            if str_eq(two, \"==\") == 1 or str_eq(two, \"!=\") == 1 or str_eq(two, \"<=\") == 1 or str_eq(two, \">=\") == 1 {\n                push(kinds, 5); push(texts, two); push(nums, 0);\n                i = i + 2;\n            } else {\n                push(kinds, 5); push(texts, str_slice(src, i, i + 1)); push(nums, 0);\n                i = i + 1;\n            }\n        }\n    }\n    push(kinds, 0); push(texts, \"\"); push(nums, 0);\n}\n\nfn str_eq(a, b) {\n    let n = len(a);\n    if n != len(b) { return 0; }\n    let i = 0;\n    while i < n {\n        if strcharcodeat(a, i) != strcharcodeat(b, i) { return 0; }\n        i = i + 1;\n    }\n    return 1;\n}\n\nfn find_str(arr, s) {\n    let i = 0;\n    let n = len(arr);\n    while i < n {\n        if str_eq(arr[i], s) == 1 { return i; }\n        i = i + 1;\n    }\n    return 0 - 1;\n}\n\n// ctx layout:\n// [0]=kinds, [1]=texts, [2]=nums, [3]=st_pos([idx, in_fn]),\n// [4]=code, [5]=locals, [6]=globals, [7]=call_pos, [8]=call_target,\n// [9]=str_fix_pos, [10]=str_fix_id, [11]=lits\n\nfn peek_k(ctx) { let sp = ctx[3]; let ks = ctx[0]; return ks[sp[0]]; }\nfn peek_t(ctx) { let sp = ctx[3]; let ts = ctx[1]; return ts[sp[0]]; }\nfn pk_eq(ctx, s) { let sp = ctx[3]; let ts = ctx[1]; return str_eq(ts[sp[0]], s); }\nfn peek_n(ctx) { let sp = ctx[3]; let ns = ctx[2]; return ns[sp[0]]; }\nfn adv(ctx) { let sp = ctx[3]; sp[0] = sp[0] + 1; }\n\nfn expect_t(ctx, want) {\n    let got = peek_t(ctx);\n    if str_eq(got, want) == 0 {\n        let sp = ctx[3];\n        print \"parse error at \" + str(sp[0]) + \": expected char \" + str(strcharcodeat(want, 0)) + \" got char \" + str(strcharcodeat(got, 0));\n        os_exit(1);\n    }\n    adv(ctx);\n}\n\nfn emit_call(ctx, name) {\n    let code = ctx[4];\n    push(code, 232);\n    push(ctx[7], len(code));\n    push(ctx[8], name);\n    push_u32(code, 0);\n}\n\nfn emit_str_lit(ctx, s) {\n    let lits = ctx[11];\n    let id = find_str(lits, s);\n    if id < 0 { id = len(lits); push(lits, s); }\n    let code = ctx[4];\n    push(code, 184);\n    push(ctx[9], len(code));\n    push(ctx[10], id);\n    push_u32(code, 0);\n}\n\nfn emit_var_load(ctx, name) {\n    let code = ctx[4];\n    let sp = ctx[3];\n    if sp[1] == 1 {\n        let li = find_str(ctx[5], name);\n        if li >= 0 {\n            let disp = 0 - ((li + 1) * 8);\n            push(code, 72); push(code, 139); push(code, 133); push_u32(code, disp);\n            return 0;\n        }\n    }\n    let globals = ctx[6];\n    let gi = find_str(globals, name);\n    if gi < 0 { gi = len(globals); push(globals, name); }\n    let gdisp = (gi + 4) * 8;\n    push(code, 73); push(code, 139); push(code, 134); push_u32(code, gdisp);\n    return 0;\n}\n\nfn emit_var_store(ctx, name) {\n    let code = ctx[4];\n    let sp = ctx[3];\n    if sp[1] == 1 {\n        let li = find_str(ctx[5], name);\n        if li >= 0 {\n            let disp = 0 - ((li + 1) * 8);\n            push(code, 72); push(code, 137); push(code, 133); push_u32(code, disp);\n            return 0;\n        }\n    }\n    let globals = ctx[6];\n    let gi = find_str(globals, name);\n    if gi < 0 { gi = len(globals); push(globals, name); }\n    let gdisp = (gi + 4) * 8;\n    push(code, 73); push(code, 137); push(code, 134); push_u32(code, gdisp);\n    return 0;\n}\n\nfn parse_expr(ctx) { return parse_or(ctx); }\n\nfn parse_primary(ctx) {\n    let code = ctx[4];\n    let k = peek_k(ctx);\n    let t = peek_t(ctx);\n    if k == 1 {\n        let v = peek_n(ctx);\n        adv(ctx);\n        if v <= 2147483647 {\n            push(code, 184); push_u32(code, v);\n        } else {\n            let lo = v % 4294967296;\n            let hi = v / 4294967296;\n            push(code, 72); push(code, 184); push_u64_lo(code, lo, hi);\n        }\n        return 0;\n    }\n    if k == 2 {\n        adv(ctx);\n        emit_str_lit(ctx, t);\n        return 0;\n    }\n    if str_eq(t, \"(\") == 1 {\n        adv(ctx);\n        parse_expr(ctx);\n        expect_t(ctx, \")\");\n        return 0;\n    }\n    if str_eq(t, \"[\") == 1 {\n        adv(ctx);\n        let cnt = 0;\n        if pk_eq(ctx, \"]\") == 0 {\n            parse_expr(ctx);\n            push(code, 80);\n            cnt = 1;\n            while pk_eq(ctx, \",\") == 1 {\n                adv(ctx);\n                parse_expr(ctx);\n                push(code, 80);\n                cnt = cnt + 1;\n            }\n        }\n        expect_t(ctx, \"]\");\n        push(code, 191); push_u32(code, cnt);\n        emit_call(ctx, \"__rt_arr_new\");\n        let idx = cnt - 1;\n        while idx >= 0 {\n            push(code, 90);\n            push(code, 72); push(code, 139); push(code, 72); push(code, 24);\n            push(code, 72); push(code, 137); push(code, 145); push_u32(code, idx * 8);\n            idx = idx - 1;\n        }\n        return 0;\n    }\n    if k == 3 {\n        let nm = t;\n        adv(ctx);\n        if pk_eq(ctx, \"(\") == 1 {\n            adv(ctx);\n            let argc = 0;\n            if pk_eq(ctx, \")\") == 0 {\n                parse_expr(ctx);\n                push(code, 80);\n                argc = 1;\n                while pk_eq(ctx, \",\") == 1 {\n                    adv(ctx);\n                    parse_expr(ctx);\n                    push(code, 80);\n                    argc = argc + 1;\n                }\n            }\n            expect_t(ctx, \")\");\n            if str_eq(nm, \"len\") == 1 {\n                push(code, 88);\n                push(code, 72); push(code, 139); push(code, 64); push(code, 8);\n                return 0;\n            }\n            if str_eq(nm, \"push\") == 1 {\n                push(code, 94); push(code, 95);\n                emit_call(ctx, \"__rt_arr_push\");\n                return 0;\n            }\n            if str_eq(nm, \"strcharcodeat\") == 1 {\n                push(code, 94); push(code, 95);\n                push(code, 15); push(code, 182); push(code, 68); push(code, 55); push(code, 16);\n                return 0;\n            }\n            if str_eq(nm, \"strfromcharcode\") == 1 {\n                push(code, 95);\n                emit_call(ctx, \"__rt_char_str\");\n                return 0;\n            }\n            if str_eq(nm, \"str_slice\") == 1 {\n                push(code, 90); push(code, 94); push(code, 95);\n                emit_call(ctx, \"__rt_str_slice\");\n                return 0;\n            }\n            if str_eq(nm, \"str\") == 1 {\n                push(code, 95);\n                emit_call(ctx, \"__rt_to_str\");\n                return 0;\n            }\n            if str_eq(nm, \"os_args\") == 1 {\n                emit_call(ctx, \"__rt_os_args\");\n                return 0;\n            }\n            if str_eq(nm, \"fs_read\") == 1 {\n                push(code, 95);\n                emit_call(ctx, \"__rt_fs_read\");\n                return 0;\n            }\n            if str_eq(nm, \"fs_write_bytes\") == 1 {\n                push(code, 94); push(code, 95);\n                emit_call(ctx, \"__rt_fs_write_bytes\");\n                return 0;\n            }\n            if str_eq(nm, \"os_exit\") == 1 {\n                push(code, 95);\n                push(code, 184); push_u32(code, 60);\n                push(code, 15); push(code, 5);\n                return 0;\n            }\n            emit_call(ctx, nm);\n            if argc > 0 {\n                push(code, 72); push(code, 129); push(code, 196); push_u32(code, argc * 8);\n            }\n            return 0;\n        }\n        emit_var_load(ctx, nm);\n        return 0;\n    }\n    let sp2 = ctx[3];\n    print \"parse error at \" + str(sp2[0]) + \" kind=\" + str(k) + \" ch0=\" + str(strcharcodeat(t, 0));\n    os_exit(1);\n    return 0;\n}\n\nfn parse_postfix(ctx) {\n    let code = ctx[4];\n    parse_primary(ctx);\n    while pk_eq(ctx, \"[\") == 1 {\n        adv(ctx);\n        push(code, 80);\n        parse_expr(ctx);\n        expect_t(ctx, \"]\");\n        push(code, 89);\n        push(code, 72); push(code, 139); push(code, 73); push(code, 24);\n        push(code, 72); push(code, 139); push(code, 4); push(code, 193);\n    }\n    return 0;\n}\n\nfn parse_mul(ctx) {\n    let code = ctx[4];\n    parse_postfix(ctx);\n    while pk_eq(ctx, \"*\") == 1 or pk_eq(ctx, \"/\") == 1 or pk_eq(ctx, \"%\") == 1 {\n        let op = peek_t(ctx);\n        adv(ctx);\n        push(code, 80);\n        parse_postfix(ctx);\n        push(code, 72); push(code, 137); push(code, 193);\n        push(code, 88);\n        if str_eq(op, \"*\") == 1 {\n            push(code, 72); push(code, 15); push(code, 175); push(code, 193);\n        } else {\n            push(code, 72); push(code, 153);\n            push(code, 72); push(code, 247); push(code, 249);\n            if str_eq(op, \"%\") == 1 { push(code, 72); push(code, 137); push(code, 208); }\n        }\n    }\n    return 0;\n}\n\nfn parse_add(ctx) {\n    let code = ctx[4];\n    parse_mul(ctx);\n    while pk_eq(ctx, \"+\") == 1 or pk_eq(ctx, \"-\") == 1 {\n        let op = peek_t(ctx);\n        adv(ctx);\n        push(code, 80);\n        parse_mul(ctx);\n        if str_eq(op, \"+\") == 1 {\n            push(code, 72); push(code, 137); push(code, 198);\n            push(code, 95);\n            emit_call(ctx, \"__rt_add\");\n        } else {\n            push(code, 72); push(code, 137); push(code, 193);\n            push(code, 88);\n            push(code, 72); push(code, 41); push(code, 200);\n        }\n    }\n    return 0;\n}\n\nfn parse_cmp(ctx) {\n    let code = ctx[4];\n    parse_add(ctx);\n    let t = peek_t(ctx);\n    if str_eq(t, \"==\") == 1 or str_eq(t, \"!=\") == 1 or str_eq(t, \"<\") == 1 or str_eq(t, \"<=\") == 1 or str_eq(t, \">\") == 1 or str_eq(t, \">=\") == 1 {\n        adv(ctx);\n        push(code, 80);\n        parse_add(ctx);\n        if str_eq(t, \"==\") == 1 or str_eq(t, \"!=\") == 1 {\n            push(code, 72); push(code, 137); push(code, 198);\n            push(code, 95);\n            emit_call(ctx, \"__rt_eq\");\n            if str_eq(t, \"!=\") == 1 { push(code, 72); push(code, 131); push(code, 240); push(code, 1); }\n        } else {\n            push(code, 72); push(code, 137); push(code, 193);\n            push(code, 88);\n            push(code, 72); push(code, 57); push(code, 200);\n            if str_eq(t, \"<\") == 1  { push(code, 15); push(code, 156); push(code, 192); }\n            elif str_eq(t, \"<=\") == 1 { push(code, 15); push(code, 158); push(code, 192); }\n            elif str_eq(t, \">\") == 1  { push(code, 15); push(code, 159); push(code, 192); }\n            else { push(code, 15); push(code, 157); push(code, 192); }\n            push(code, 15); push(code, 182); push(code, 192);\n        }\n    }\n    return 0;\n}\n\nfn parse_and(ctx) {\n    let code = ctx[4];\n    parse_cmp(ctx);\n    while pk_eq(ctx, \"and\") == 1 {\n        adv(ctx);\n        push(code, 72); push(code, 133); push(code, 192);\n        push(code, 15); push(code, 132); let jf = len(code); push_u32(code, 0);\n        parse_cmp(ctx);\n        push(code, 72); push(code, 133); push(code, 192);\n        push(code, 15); push(code, 149); push(code, 192);\n        push(code, 15); push(code, 182); push(code, 192);\n        push(code, 233); let je = len(code); push_u32(code, 0);\n        patch_u32(code, jf, len(code) - (jf + 4));\n        push(code, 49); push(code, 192);\n        patch_u32(code, je, len(code) - (je + 4));\n    }\n    return 0;\n}\n\nfn parse_or(ctx) {\n    let code = ctx[4];\n    parse_and(ctx);\n    while pk_eq(ctx, \"or\") == 1 {\n        adv(ctx);\n        push(code, 72); push(code, 133); push(code, 192);\n        push(code, 15); push(code, 133); let jt = len(code); push_u32(code, 0);\n        parse_and(ctx);\n        push(code, 72); push(code, 133); push(code, 192);\n        push(code, 15); push(code, 149); push(code, 192);\n        push(code, 15); push(code, 182); push(code, 192);\n        push(code, 233); let je = len(code); push_u32(code, 0);\n        patch_u32(code, jt, len(code) - (jt + 4));\n        push(code, 184); push_u32(code, 1);\n        patch_u32(code, je, len(code) - (je + 4));\n    }\n    return 0;\n}\n\nfn parse_block(ctx) {\n    expect_t(ctx, \"{\");\n    while pk_eq(ctx, \"}\") == 0 and peek_k(ctx) != 0 {\n        parse_stmt(ctx);\n    }\n    expect_t(ctx, \"}\");\n    return 0;\n}\n\nfn parse_if(ctx) {\n    let code = ctx[4];\n    adv(ctx);\n    parse_expr(ctx);\n    push(code, 72); push(code, 133); push(code, 192);\n    push(code, 15); push(code, 132); let jf = len(code); push_u32(code, 0);\n    parse_block(ctx);\n    if pk_eq(ctx, \"elif\") == 1 {\n        push(code, 233); let je = len(code); push_u32(code, 0);\n        patch_u32(code, jf, len(code) - (jf + 4));\n        parse_if(ctx);\n        patch_u32(code, je, len(code) - (je + 4));\n        return 0;\n    }\n    if pk_eq(ctx, \"else\") == 1 {\n        adv(ctx);\n        push(code, 233); let je2 = len(code); push_u32(code, 0);\n        patch_u32(code, jf, len(code) - (jf + 4));\n        parse_block(ctx);\n        patch_u32(code, je2, len(code) - (je2 + 4));\n        return 0;\n    }\n    patch_u32(code, jf, len(code) - (jf + 4));\n    return 0;\n}\n\nfn parse_stmt(ctx) {\n    let code = ctx[4];\n    let sp = ctx[3];\n    let ks = ctx[0];\n    let ts = ctx[1];\n    let t = peek_t(ctx);\n    if str_eq(t, \"let\") == 1 {\n        adv(ctx);\n        let nm = peek_t(ctx);\n        adv(ctx);\n        expect_t(ctx, \"=\");\n        parse_expr(ctx);\n        if pk_eq(ctx, \";\") == 1 { adv(ctx); }\n        if sp[1] == 1 {\n            let locals = ctx[5];\n            let li = find_str(locals, nm);\n            if li < 0 { li = len(locals); push(locals, nm); }\n            let disp = 0 - ((li + 1) * 8);\n            push(code, 72); push(code, 137); push(code, 133); push_u32(code, disp);\n        } else {\n            emit_var_store(ctx, nm);\n        }\n        return 0;\n    }\n    if str_eq(t, \"if\") == 1 { return parse_if(ctx); }\n    if str_eq(t, \"while\") == 1 {\n        adv(ctx);\n        let top = len(code);\n        parse_expr(ctx);\n        push(code, 72); push(code, 133); push(code, 192);\n        push(code, 15); push(code, 132); let jf = len(code); push_u32(code, 0);\n        parse_block(ctx);