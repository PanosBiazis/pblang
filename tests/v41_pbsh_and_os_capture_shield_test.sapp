//
// tests/v41_pbsh_and_os_capture_shield_test.sapp — Cross-Platform Verification Suite for:
//   1. Stage-3 `PBSH-v1` Polymorphic Anti-REA & Anti-LLM Closed-Source Bytecode Shield
//      (ChaCha20 + 2-share MBA white-box key unsealing + 256-opcode Fisher-Yates permutation
//       + stripped symbols/lines + HMAC-SHA256 fail-closed integrity; active by default on
//       proprietary builds, opt-out via `--free` / `--license <SPDX>` / `--open-symbols`)
//   2. Native OS / Framebuffer Anti-Screenshot, Focus-Loss & Print/Save Blur Veil
//      (`gfx_set_capture_shield`, `gfx_capture_shield_status`, `gfx_simulate_capture_event`)
//      with 100% lossless bit-exact SHA-256 pixel restoration for legitimate viewers.

let UUID = import("stdlib:uuid.sapp");

let assertions = 0;
fn demand(cond, msg) {
    if not cond {
        throw "V41_PBSH_CAPTURE_SHIELD_FAIL: " + str(msg);
    }
    assertions = assertions + 1;
}

fn find_pblang_bin() {
    let env_bin = env_get("PBLANG_BIN");
    if type(env_bin) == "string" and len(env_bin) > 0 and fs_exists(env_bin) {
        return env_bin;
    }
    if fs_exists("./pblang.exe") { return "./pblang.exe"; }
    if fs_exists("pblang.exe") { return "pblang.exe"; }
    if fs_exists("./pblang") { return "./pblang"; }
    return "pblang";
}

fn bytes_contains_ascii(haystack, needle_str) {
    let nb = bytes_from_str(needle_str);
    let nlen = len(nb);
    let hlen = len(haystack);
    if nlen == 0 or hlen < nlen { return false; }
    let first = nb[0];
    let limit = hlen - nlen;
    let i = 0;
    while i <= limit {
        if haystack[i] == first {
            let matched = true;
            let j = 1;
            while j < nlen {
                if haystack[i + j] != nb[j] {
                    matched = false;
                    j = nlen;
                } else {
                    j = j + 1;
                }
            }
            if matched { return true; }
        }
        i = i + 1;
    }
    return false;
}

println("=== PBLang v4.1.0 Stage-3 PBSH-v1 Polymorphic Shield & Native OS Capture Shield Suite ===");

let pblang_bin = find_pblang_bin();
let is_win = str_contains(str_lower(pblang_bin), ".exe") or fs_exists("C:\\Windows\\System32\\kernel32.dll");
let exe_ext = "";
if is_win { exe_ext = ".exe"; }

let ws = ".tmp_v41_pbsh_" + UUID.v4();
fs_mkdirs(ws);

// ── 1. Default Closed-Source `PBSH-v1` Shield vs `--free` / `--open-symbols` ──
let src_path = ws + "/secret_pricing_engine.sapp";
let secret_marker = "ULTRA_CONFIDENTIAL_FORMULA_K99_SOVEREIGN";
let secret_fn_name = "compute_proprietary_alpha_curve_v41";
let sample_code = "// Confidential pricing & ledger kernel\n"
    + "fn " + secret_fn_name + "(units, base_rate) {\n"
    + "    let tag = \"" + secret_marker + "\";\n"
    + "    let acc = 0;\n"
    + "    let i = 1;\n"
    + "    while i <= units {\n"
    + "        acc = acc + (i * base_rate) + len(tag);\n"
    + "        i = i + 1;\n"
    + "    }\n"
    + "    return acc;\n"
    + "}\n"
    + "println(\"PBSH_RESULT=\" + str(" + secret_fn_name + "(20, 7)));\n";
fs_write(src_path, sample_code);

// 1a. Default `--bundle-exe` (Proprietary / All Rights Reserved -> PBSH-v1 active by default!)
let closed_exe = ws + "/closed_app" + exe_ext;
let b_closed = proc_spawn_wait(pblang_bin, ["build", src_path, "--bundle-exe", "-o", closed_exe]);
demand(b_closed.exit_code == 0, "default closed-source --bundle-exe succeeded: " + b_closed.stderr);
demand(fs_exists(closed_exe), "closed_exe created on disk");

let info_closed = pbck_shield_inspect(closed_exe);
demand(info_closed.ok == true, "pbck_shield_inspect(closed_exe) ok");
demand(info_closed.bundled_exe == true, "closed_exe detected as bundled_exe");
demand(info_closed.shielded == true and info_closed.format == "PBSH-v1", "default --bundle-exe uses PBSH-v1 polymorphic shield");
demand(info_closed.encrypted == true and info_closed.opcode_permuted == true and info_closed.stripped == true, "PBSH enables encryption + 256-opcode permutation + symbol stripping");
demand(info_closed.integrity_ok == true, "PBSH HMAC-SHA256 integrity verified");
demand(info_closed.shannon_entropy > 7.75, "PBSH encrypted payload achieves near-ideal Shannon entropy (> 7.75 bits/byte): " + str(info_closed.shannon_entropy));

// Verify zero plaintext leaks in raw binary!
let closed_raw = fs_read_bytes(closed_exe);
demand(not bytes_contains_ascii(closed_raw, secret_marker), "secret string literal completely absent from closed_exe binary");
demand(not bytes_contains_ascii(closed_raw, secret_fn_name), "proprietary function identifier stripped & absent from closed_exe binary");
demand(not bytes_contains_ascii(closed_raw, "secret_pricing_engine.sapp"), "source filename stripped & absent from closed_exe binary");

// Execute closed_exe directly (20*21/2 * 7 + 20 * 40 = 1470 + 800 = 2270)
let run_closed = proc_spawn_wait(closed_exe, []);
demand(run_closed.exit_code == 0 and str_contains(run_closed.stdout, "PBSH_RESULT=2270"), "closed_exe executes accurately at native VM speed: " + run_closed.stdout);

// 1b. Standalone `.pbck --shield --anti-debug` vs `--free` size & opt-out verification
let shielded_pbck = ws + "/app_shielded.pbck";
let free_pbck = ws + "/app_free.pbck";
let free_exe = ws + "/free_app" + exe_ext;

let b_sh_pbck = proc_spawn_wait(pblang_bin, ["build", src_path, "--shield", "--anti-debug", "-o", shielded_pbck]);
demand(b_sh_pbck.exit_code == 0, "build --shield --anti-debug .pbck succeeded");
let info_sh_pbck = pbck_shield_inspect(shielded_pbck);
demand(info_sh_pbck.shielded == true and info_sh_pbck.anti_debug == true and info_sh_pbck.integrity_ok == true, "standalone .pbck --shield --anti-debug verified");
let sh_pbck_raw = fs_read_bytes(shielded_pbck);
demand(not bytes_contains_ascii(sh_pbck_raw, secret_marker), "secret string encrypted in .pbck");

let run_sh_pbck = proc_spawn_wait(pblang_bin, ["run", shielded_pbck]);
demand(run_sh_pbck.exit_code == 0 and str_contains(run_sh_pbck.stdout, "PBSH_RESULT=2270"), "pblang run executes PBSH .pbck seamlessly");

let b_free_pbck = proc_spawn_wait(pblang_bin, ["build", src_path, "--free", "-o", free_pbck]);
demand(b_free_pbck.exit_code == 0, "build --free .pbck succeeded");
let info_free_pbck = pbck_shield_inspect(free_pbck);
demand(info_free_pbck.shielded == false and info_free_pbck.format == "PBCK-v1", "--free produces open inspectable PBCK-v1");
demand(info_sh_pbck.payload_bytes <= info_free_pbck.payload_bytes, "stripped PBSH payload is smaller or equal vs unstripped PBCK (" + str(info_sh_pbck.payload_bytes) + " vs " + str(info_free_pbck.payload_bytes) + " bytes)");

let b_free_exe = proc_spawn_wait(pblang_bin, ["build", src_path, "--bundle-exe", "--free", "-o", free_exe]);
demand(b_free_exe.exit_code == 0, "build --bundle-exe --free succeeded");
let info_free_exe = pbck_shield_inspect(free_exe);
demand(info_free_exe.bundled_exe == true and info_free_exe.shielded == false, "--bundle-exe --free opts out of PBSH closed-source shield");

// CLI `pblang shield-inspect --json`
let cli_insp = proc_spawn_wait(pblang_bin, ["shield-inspect", closed_exe, "--json"]);
demand(cli_insp.exit_code == 0, "CLI shield-inspect --json succeeded");
let cli_insp_map = json_parse(cli_insp.stdout);
demand(cli_insp_map.shielded == true and cli_insp_map.integrity_ok == true, "CLI shield-inspect JSON matches builtin");

// 1c. Fail-closed 1-bit ciphertext tamper detection
let tampered_pbck = ws + "/tampered.pbck";
let mut_bytes = [];
let bi = 0;
while bi < len(sh_pbck_raw) {
    let bval = sh_pbck_raw[bi];
    if bi == 44 {
        bval = (bval + 1) % 256;
    }
    array_push(mut_bytes, bval);
    bi = bi + 1;
}
fs_write_bytes(tampered_pbck, mut_bytes);
let info_tamp = pbck_shield_inspect(tampered_pbck);
demand(info_tamp.shielded == true and info_tamp.integrity_ok == false, "1-byte ciphertext modification detected by PBSH HMAC-SHA256");
let run_tamp = proc_spawn_wait(pblang_bin, ["run", tampered_pbck]);
demand(run_tamp.exit_code != 0, "VM refuses to execute tampered PBSH bytecode (fail-closed)");

demand(type(security_is_debugger_present()) == "bool", "security_is_debugger_present() returns boolean cleanly");
println("  [PASS] 1. Stage-3 PBSH-v1 Polymorphic Bytecode Shield, Zero-Leak Stripping, Size Reduction & 1-Bit Tamper Rejection");

// ── 2. Native OS / Framebuffer Anti-Screenshot & Lossless Blur Veil (`gfx_set_capture_shield`) ──
let win = gfxcreatewindow("Confidential Financial Ledger", 320, 200, map{ headless: true });
gfxclear(win, [14, 22, 38]);
gfxdrawrect(win, 40, 40, 240, 120, [28, 110, 210]);
gfxdrawrect(win, 120, 70, 80, 60, [245, 190, 40]);
gfxdrawtextaa(win, 55, 48, "NET MARGIN: 948,250.00 EUR", [255, 255, 255], 14, "", 0);
gfxpresent(win);

let st_init = gfx_capture_shield_status(win);
demand(st_init.ok == true and st_init.capture_shield == false and st_init.veiled == false, "initial window has capture_shield=false, veiled=false");
let crisp_sha = st_init.frame_sha256;
let crisp_rgb = st_init.center_rgb;
demand(len(crisp_sha) == 64, "frame_sha256 is 64-hex SHA-256 digest");
demand(crisp_rgb[0] == 245 and crisp_rgb[1] == 190 and crisp_rgb[2] == 40, "crisp center pixel has exact rendered RGB (245, 190, 40)");

let arm_res = gfx_set_capture_shield(win, true, map{ blur_on_unfocus: true, block_print_save: true });
demand(arm_res.ok == true and arm_res.capture_shield == true and arm_res.blur_on_unfocus == true and arm_res.block_print_save == true, "gfx_set_capture_shield armed cleanly");

// While focused and no capture key pressed, legitimate viewer sees 100% original crisp pixels!
let st_armed = gfx_capture_shield_status(win);
demand(st_armed.frame_sha256 == crisp_sha and st_armed.veiled == false, "arming capture shield causes ZERO pixel degradation during normal focused viewing");

// Simulate PrintScreen attempt -> instant privacy blur veil engages!
let ev_prt = gfx_simulate_capture_event(win, "printscreen");
demand(ev_prt.ok == true and ev_prt.blocked == true and ev_prt.veiled == true and ev_prt.capture_attempts == 1, "PrintScreen intercepted and veiled");
let st_veiled = gfx_capture_shield_status(win);
demand(st_veiled.veiled == true and st_veiled.frame_sha256 != crisp_sha, "veiled framebuffer SHA-256 differs completely from crisp confidential frame");

// Restore focus -> 100% bit-exact SHA-256 restoration of confidential pixels!
let ev_in1 = gfx_simulate_capture_event(win, "focus_in");
demand(ev_in1.ok == true and ev_in1.veiled == false, "focus_in lifts privacy veil");
let st_restored1 = gfx_capture_shield_status(win);
demand(st_restored1.frame_sha256 == crisp_sha, "focus_in restores 100% bit-exact SHA-256 crisp pixels (zero quality loss)");
demand(st_restored1.center_rgb[0] == 245 and st_restored1.center_rgb[1] == 190 and st_restored1.center_rgb[2] == 40, "restored center RGB is bit-identical");

// Simulate focus_out (e.g. external snipping tool clicked), Ctrl+P, and Ctrl+S
let ev_out = gfx_simulate_capture_event(win, "focus_out");
demand(ev_out.blocked == true and ev_out.veiled == true, "focus_out engages blur veil against external snipping tools");
gfx_simulate_capture_event(win, "focus_in");

let ev_cp = gfx_simulate_capture_event(win, "ctrl_p");
demand(ev_cp.blocked == true and ev_cp.veiled == true and ev_cp.capture_attempts == 2, "Ctrl+P print shortcut blocked & veiled");
gfx_simulate_capture_event(win, "focus_in");

let ev_cs = gfx_simulate_capture_event(win, "ctrl_s");
demand(ev_cs.blocked == true and ev_cs.veiled == true and ev_cs.capture_attempts == 3, "Ctrl+S save shortcut blocked & veiled");
gfx_simulate_capture_event(win, "focus_in");

let st_final = gfx_capture_shield_status(win);
demand(st_final.frame_sha256 == crisp_sha and st_final.capture_attempts == 3, "all 3 capture attempts logged & crisp frame preserved bit-exact");

// One-call `gfxcreatewindow` with `capture_shield: true`
let win2 = gfxcreatewindow("One-Call Shielded Window", 160, 120, map{ headless: true, capture_shield: true });
let st_w2 = gfx_capture_shield_status(win2);
demand(st_w2.capture_shield == true and st_w2.blur_on_unfocus == true and st_w2.block_print_save == true, "one-call gfxcreatewindow(..., map{ capture_shield: true }) arms shield before first frame");

gfxclosewindow(win);
gfxclosewindow(win2);
println("  [PASS] 2. Native OS Anti-Screenshot, Focus-Out Snipping Defense, Ctrl+P/Ctrl+S Blocker & Bit-Exact Pixel Restore");

// Cleanup scratch workspace
let entries = try fs_list(ws) catch [];
let ei = 0;
while ei < len(entries) {
    try fs_remove(ws + "/" + entries[ei]) catch nil;
    ei = ei + 1;
}
try fs_remove(ws) catch nil;

println("=== ALL PBLANG v4.1.0 PBSH-v1 & OS CAPTURE SHIELD TESTS PASSED (" + str(assertions) + " assertions) ===");
