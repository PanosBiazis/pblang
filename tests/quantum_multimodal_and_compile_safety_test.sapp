// tests/quantum_multimodal_and_compile_safety_test.sapp
// PBLang v3.0.0 — Multimodal Quantum Hardware (Google Willow/Rainbow, IonQ/AQT Trapped-Ion,
// QuEra/Pasqal Rydberg Analog, Quandela/Xanadu Photonic Clements MZI & HOM)
// + Static Checker Pass 5 (Compile-Time Quantum Wire Bounds & No-Cloning Verification)

let QC = import("stdlib:quantum_computing.sapp");
let MQ = import("stdlib:quantum/multimodal_google_ion_rydberg_photonic.sapp");
let SC = import("stdlib:static_checker.sapp");

let assertions_passed = [0];

fn check(cond, msg) {
    if not cond {
        throw "ASSERTION FAILED: " + msg;
    }
    assertions_passed[0] = assertions_passed[0] + 1;
}

fn has_diag_code(report, expected_code) {
    let diags = report["diagnostics"];
    let i = 0;
    while i < len(diags) {
        if diags[i]["code"] == expected_code {
            return true;
        }
        i = i + 1;
    }
    return false;
}

println("=== [1/7] Google Willow (105q, 182 couplers) & Rainbow (23q) Topologies ===");
let willow = MQ.google_willow_topology();
check(willow.name == "Willow" and willow.processor_id == "willow_105q", "Willow processor metadata");
check(willow.n_qubits == 105 and len(willow.grid_qubits) == 105, "Willow exact 105 superconducting GridQubits");
check(willow.n_couplers == 182 and len(willow.couplers) == 182, "Willow exact 182 nearest-neighbor 2D couplers");
check(willow.t1_us == 68.0 and willow.t2_us == 89.0, "Willow T1=68us and T2=89us calibration");
check(willow.phased_xz_error == 0.00035 and willow.cz_error == 0.0014 and willow.readout_error == 0.005, "Willow gate & readout error rates");

let all_manhattan_1 = true;
let ci = 0;
while ci < len(willow.couplers) {
    let cp = willow.couplers[ci];
    let qa = willow.grid_qubits[cp.q0];
    let qb = willow.grid_qubits[cp.q1];
    let md = num_abs(qa.row - qb.row) + num_abs(qa.col - qb.col);
    if md != 1 or qa.cirq_id != str(qa.row) + "_" + str(qa.col) {
        all_manhattan_1 = false;
    }
    ci = ci + 1;
}
check(all_manhattan_1, "Every Willow coupler connects Manhattan-distance-1 GridQubit(r, c) pairs");

let rainbow = MQ.google_rainbow_topology();
check(rainbow.name == "Rainbow" and rainbow.processor_id == "rainbow_23q", "Rainbow processor metadata");
check(rainbow.n_qubits == 23 and rainbow.n_couplers == 33, "Rainbow exact 23 GridQubits and 33 couplers");

println("=== [2/7] Google Willow Native PhasedXZ + CZ Compiler, 2D SWAP Router & Cirq v2 ===");
// Verify EVERY single-qubit gate compiles to AT MOST ONE PhasedXZ gate with F > 0.9999999999!
let single_gate_names = ["h", "x", "sx", "y", "z", "s", "sdg", "t", "tdg", "rx", "ry", "rz"];
let gi = 0;
while gi < len(single_gate_names) {
    let gname = single_gate_names[gi];
    let c1 = QC.new_circuit(1);
    if gname == "h" { QC.h(c1, 0); }
    elif gname == "x" { QC.x(c1, 0); }
    elif gname == "sx" { QC.sx(c1, 0); }
    elif gname == "y" { QC.y(c1, 0); }
    elif gname == "z" { QC.z(c1, 0); }
    elif gname == "s" { QC.s(c1, 0); }
    elif gname == "sdg" { QC.sdg(c1, 0); }
    elif gname == "t" { QC.t(c1, 0); }
    elif gname == "tdg" { QC.tdg(c1, 0); }
    elif gname == "rx" { QC.rx(c1, 0, 1.13); }
    elif gname == "ry" { QC.ry(c1, 0, -0.87); }
    elif gname == "rz" { QC.rz(c1, 0, 2.31); }

    let w1 = MQ.transpile_to_google_willow(c1);
    let eq1 = MQ.verify_google_willow_equivalence(c1, w1);
    check(len(w1.gates) <= 1 and w1.gate_counts.phased_xz <= 1 and w1.gate_counts.cz == 0,
        "1q gate '" + gname + "' compiles to at most ONE PhasedXZ gate");
    check(eq1.ok and eq1.fidelity > 0.9999999999,
        "1q gate '" + gname + "' PhasedXZ unitary equivalence > 0.9999999999");
    gi = gi + 1;
}

// Verify 5 chained 1q rotations fuse into a SINGLE PhasedXZ gate
let c_fuse = QC.new_circuit(1);
QC.h(c_fuse, 0);
QC.t(c_fuse, 0);
QC.rx(c_fuse, 0, 0.73);
QC.rz(c_fuse, 0, -1.19);
QC.sx(c_fuse, 0);
let w_fuse = MQ.transpile_to_google_willow(c_fuse);
let eq_fuse = MQ.verify_google_willow_equivalence(c_fuse, w_fuse);
check(w_fuse.gate_counts.phased_xz == 1 and len(w_fuse.gates) == 1 and eq_fuse.fidelity > 0.9999999999,
    "5 consecutive 1q gates fuse into exactly 1 PhasedXZ gate with F > 0.9999999999");

// Multi-qubit GHZ + Toffoli + CZ + Rz circuit on 4 qubits routed on 2D grid
let c_multi = QC.new_circuit(4);
QC.h(c_multi, 0);
QC.cnot(c_multi, 0, 1);
QC.toffoli(c_multi, 0, 1, 3);
QC.cz(c_multi, 1, 2);
QC.ry(c_multi, 2, 0.64);
QC.mcz(c_multi, [0, 2], 3);
let w_multi = MQ.transpile_to_google_willow(c_multi, ["6_0", "6_1", "6_2", "5_2"]);
let eq_multi = MQ.verify_google_willow_equivalence(c_multi, w_multi);
check(w_multi.topology_valid and eq_multi.ok and eq_multi.fidelity > 0.9999999999,
    "4-qubit GHZ+Toffoli+MCZ circuit transpiled & routed on Willow 2D grid with F > 0.9999999999");
check(w_multi.gate_counts.swaps_inserted > 0,
    "Non-adjacent 2D grid qubits (6_0 to 5_2, Manhattan dist 3) insert Manhattan SWAPs");

// Sparse user GridQubits bridged automatically via 2D chip Manhattan shortest path
let c_sparse = QC.new_circuit(2);
QC.h(c_sparse, 0);
QC.cnot(c_sparse, 0, 1);
let w_sparse = MQ.transpile_to_google_willow(c_sparse, ["6_0", "6_3"]);
let eq_sparse = MQ.verify_google_willow_equivalence(c_sparse, w_sparse);
check(eq_sparse.ok and eq_sparse.fidelity > 0.9999999999 and w_sparse.n_qubits == 4,
    "Sparse Willow GridQubits ['6_0', '6_3'] bridged cleanly across 6_1, 6_2 with F > 0.9999999999");

let cirq_json = MQ.to_google_willow_cirq_v2(c_multi, ["6_0", "6_1", "6_2", "5_2"]);
let cirq_doc = json_parse(cirq_json);
check(cirq_doc["@type"] == "type.googleapis.com/cirq.google.api.v2.Program", "Cirq v2 @type header");
check(cirq_doc.language.gate_set == "willow_v2", "Cirq v2 willow_v2 gate_set");
check(len(cirq_doc.circuit.moments) >= 3, "Cirq v2 moment-by-moment schedule populated");
check(str_contains(cirq_json, "\"PhasedXZGate\"") and str_contains(cirq_json, "\"CZPowGate\"") and str_contains(cirq_json, "\"MeasurementGate\""),
    "Cirq v2 JSON contains PhasedXZGate, CZPowGate, and MeasurementGate");
check(str_contains(cirq_json, "\"6_0\"") and str_contains(cirq_json, "\"5_2\""),
    "Cirq v2 JSON uses authentic 'r_c' GridQubit IDs");

println("=== [3/7] Hardware-Calibrated Google QVM & Zero-Leak OAuth2 / Engine Client ===");
let bell_c = QC.new_circuit(2);
QC.h(bell_c, 0);
QC.cnot(bell_c, 0, 1);
let qvm_res = MQ.run_google_qvm(bell_c, "willow_105q", 1024, map{ seed: 202611 });
check(qvm_res.ok and qvm_res.engine == "google_qvm", "Google QVM execution ok");
check(qvm_res.processor_id == "willow_105q" and qvm_res.n_physical_qubits_chip == 105, "Google QVM Willow 105q metadata");
check(len(qvm_res.grid_qubits_used) == 2 and qvm_res.repetitions == 1024, "Google QVM grid_qubits_used & repetitions");
check(qvm_res.isa_unitary_fidelity > 0.9999999999, "Google QVM ISA unitary fidelity > 0.9999999999");
check(qvm_res.hellinger_fidelity > 0.96 and qvm_res.hellinger_fidelity <= 1.0,
    "Hardware-calibrated Willow QVM Bell state achieves high Hellinger fidelity (~98-99%)");
check(is_map(qvm_res.cirq_v2_program) and is_map(qvm_res.ideal_probs) and is_map(qvm_res.qvm_probabilities),
    "Google QVM returns cirq_v2_program, ideal_probs, and qvm_probabilities");

let shot_sum = 0;
let cks = map_keys(qvm_res.qvm_counts);
let ki = 0;
while ki < len(cks) {
    shot_sum = shot_sum + qvm_res.qvm_counts[cks[ki]];
    ki = ki + 1;
}
check(shot_sum == 1024, "Google QVM counts sum to exact 1024 repetitions");

// Rainbow 23q QVM + stress-test elevated noise trajectory unraveling
let ghz3 = QC.new_circuit(3);
QC.h(ghz3, 0);
QC.cnot(ghz3, 0, 1);
QC.cnot(ghz3, 1, 2);
let qvm_rb = MQ.run_google_qvm(ghz3, "rainbow_23q", 512, map{ seed: 99 });
check(qvm_rb.ok and qvm_rb.processor_id == "rainbow_23q" and qvm_rb.n_physical_qubits_chip == 23 and qvm_rb.hellinger_fidelity > 0.90,
    "Rainbow 23q QVM GHZ-3 simulation accurate");

let qvm_heavy_noise = MQ.run_google_qvm(bell_c, "willow_105q", 256, map{
    seed: 12345,
    phased_xz_error: 0.12,
    cz_error: 0.20,
    readout_error: 0.08,
    t1_us: 0.8,
    t2_us: 0.9
});
check(qvm_heavy_noise.ok and qvm_heavy_noise.hellinger_fidelity < qvm_res.hellinger_fidelity,
    "Elevated Pauli + T1/T2 + readout noise trajectories predictably degrade QVM Hellinger fidelity");

// Zero-leak secret scrubbing + OAuth2 + submit_google_quantum_engine fallback & mock v1alpha1
let dummy_sec = "SYNTH_TEST_SECRET_998877";
let scrubbed = MQ.scrub_google_quantum_secrets("Authorization: Bearer SYNTH_TEST_SECRET_998877 failed", [dummy_sec]);
check(not str_contains(scrubbed, dummy_sec) and str_contains(scrubbed, "[REDACTED]"),
    "scrub_google_quantum_secrets redacts sensitive tokens");

let sub_fallback = MQ.submit_google_quantum_engine(bell_c, "willow_105q", 256, map{ seed: 7 });
check(sub_fallback.ok and sub_fallback.qpu_submitted == false and sub_fallback.engine == "google_qvm",
    "submit_google_quantum_engine seamlessly falls back to hardware-calibrated Google QVM when no token is configured");

let oauth_missing = MQ.refresh_google_quantum_oauth2_token(map{});
check(oauth_missing.ok == false and oauth_missing.mode == "missing_google_oauth2_refresh_credentials",
    "refresh_google_quantum_oauth2_token cleanly reports missing refresh credentials without throwing");

let oauth_mock = MQ.refresh_google_quantum_oauth2_token(map{
    project_id: "demo-quantum-proj",
    client_id: "demo-client-id",
    refresh_token: "SYNTH_REFRESH_TOKEN_ABC123",
    mock_oauth_response: map{ access_token: "SYNTH_ACCESS_TOKEN_XYZ789", expires_in: 3600 }
});
check(oauth_mock.ok and oauth_mock.refreshed and oauth_mock.provider == "google_quantum_engine",
    "OAuth2 refresh exchange parses token response and caches access token");

let sub_v1 = MQ.submit_google_quantum_engine(bell_c, "willow_105q", 512, map{
    project_id: "demo-quantum-proj",
    access_token: "SYNTH_BEARER_TOK_55555",
    allowlisted: true,
    mock_v1alpha1_response: map{
        name: "projects/demo-quantum-proj/programs/prog-001",
        echo_leak_probe: "SYNTH_BEARER_TOK_55555"
    }
});
check(sub_v1.ok and sub_v1.qpu_submitted and sub_v1.engine == "google_quantum_engine_v1alpha1",
    "submit_google_quantum_engine dispatches Cirq v2 payload to quantum.googleapis.com/v1alpha1 when allowlisted");
check(sub_v1.endpoint == "https://quantum.googleapis.com/v1alpha1/projects/demo-quantum-proj/processors/willow_105q/programs",
    "Google Quantum Engine v1alpha1 endpoint URL formatting");
check(sub_v1.response.echo_leak_probe == "[REDACTED]",
    "Any accidental secret echo in v1alpha1 response is scrubbed to [REDACTED]");

println("=== [4/7] Trapped-Ion QPUs (IonQ Forte & European AQT IBEX — 0 SWAPs All-to-All) ===");
let forte = MQ.ionq_forte_topology();
let aqt = MQ.aqt_ibex_topology();
check(forte.n_qubits == 36 and forte.connectivity == "all_to_all" and forte.swaps_required == 0, "IonQ Forte 36q all-to-all topology");
check(aqt.n_qubits == 24 and aqt.provider == "aqt_eu" and aqt.connectivity == "all_to_all", "European AQT IBEX 24q all-to-all topology");

let c_ion8 = QC.new_circuit(8);
QC.h(c_ion8, 0);
QC.cnot(c_ion8, 0, 7);
QC.rx(c_ion8, 3, 0.91);
QC.ry(c_ion8, 5, -0.44);
QC.rz(c_ion8, 7, 1.25);
QC.sx(c_ion8, 2);
QC.cz(c_ion8, 2, 6);
QC.toffoli(c_ion8, 0, 4, 7);

let ion_compiled = MQ.transpile_to_trapped_ion(c_ion8);
let ion_eq = MQ.verify_trapped_ion_equivalence(c_ion8, ion_compiled);
check(ion_compiled.swaps_inserted == 0 and ion_compiled.gate_counts.swaps_inserted == 0,
    "Trapped-Ion compilation of 8q circuit with CNOT(0, 7) inserts ZERO SWAPs");
check(ion_compiled.gate_counts.ms > 0 and ion_compiled.gate_counts.gpi > 0 and ion_compiled.gate_counts.gpi2 > 0,
    "Trapped-Ion compilation uses native GPI, GPI2, and Molmer-Sorensen MS gates");
check(ion_eq.ok and ion_eq.basis_ok and ion_eq.fidelity > 0.9999999999,
    "Trapped-Ion 8-qubit circuit unitary equivalence > 0.9999999999");

let ion_json = MQ.to_ionq_native_json(c_ion8);
let ion_doc = json_parse(ion_json);
check(ion_doc.gateset == "native" and ion_doc.qubits == 8 and ion_doc.connectivity == "all_to_all" and len(ion_doc.circuit) == len(ion_compiled.gates),
    "IonQ Native Gateset JSON format verified");

println("=== [5/7] Neutral-Atom Rydberg Analog QPUs (QuEra Aquila / Pasqal / Braket AHS) ===");
let pi = 3.14159265358979323846;
let omega_2mhz = 2.0 * pi * 2.0; // 12.56637 rad/us
let rb_um = MQ.rydberg_blockade_radius_um(omega_2mhz, 0.0);
check(MQ.RYDBERG_RB87_C6_RAD_UM6_US == 5420158.53 and rb_um > 8.5 and rb_um < 9.0,
    "87Rb C6 van der Waals constant and Rydberg blockade radius R_b (~8.74 um at Omega=2*pi*2 MHz)");

// Far-apart atoms (r = 20 um >> R_b): resonant pi-pulse t_pi = pi / Omega excites |00> -> |11> independently!
let t_pi = pi / omega_2mhz;
let ryd_far = MQ.simulate_rydberg_hamiltonian([[0.0, 0.0], [20.0, 0.0]], omega_2mhz, 0.0, t_pi, 80);
check(ryd_far.ok and num_abs(ryd_far.norm - 1.0) < 0.000001, "Rydberg RK4 preserves wavefunction norm at r=20 um");
check(ryd_far.probabilities["11"] > 0.985,
    "Non-blockaded atoms at r=20 um >> R_b undergo independent Rabi flop to |11> (P(|11>) > 0.985)");

// Close atoms (r = 4 um < R_b): Rydberg blockade suppresses |11> to < 0.01 and enhances collective |W> = (|10>+|01>)/sqrt(2)!
let ryd_block_pi = MQ.simulate_rydberg_hamiltonian([[0.0, 0.0], [4.0, 0.0]], omega_2mhz, 0.0, t_pi, 80);
check(ryd_block_pi.ok and ryd_block_pi.probabilities["11"] < 0.01,
    "Rydberg Blockade at r=4 um < R_b suppresses doubly-excited state P(|11>) < 0.01");

let t_collective_pi = pi / (num_sqrt(2.0) * omega_2mhz);
let ryd_entangled = MQ.simulate_rydberg_hamiltonian([[0.0, 0.0], [4.0, 0.0]], omega_2mhz, 0.0, t_collective_pi, 80);
let p_bell_sym = ryd_entangled.probabilities["10"] + ryd_entangled.probabilities["01"];
check(ryd_entangled.probabilities["11"] < 0.01 and p_bell_sym > 0.985,
    "Collective sqrt(2)*Omega Rydberg blockade oscillation prepares (|10>+|01>)/sqrt(2) with P > 0.985 and P(|11>) < 0.01");

// Adiabatic Rydberg Maximum Independent Set (MIS) on 5-atom path graph 0-1-2-3-4 (unique MIS = {0,2,4} = "10101")
let path5_coords = [[0.0, 0.0], [5.5, 0.0], [11.0, 0.0], [16.5, 0.0], [22.0, 0.0]];
let mis_res = MQ.solve_rydberg_mis(path5_coords, 7.5, map{ steps: 90 });
check(mis_res.ok and mis_res.mis_cardinality == 3 and mis_res.mis_bitstring == "10101",
    "Adiabatic Rydberg MIS solver finds unique optimal independent set '10101' of size 3 on 5-atom unit-disk path");
check(mis_res.optimal_mis_total_prob > 0.65,
    "Adiabatic Rydberg sweep concentrates probability mass onto ground-state MIS");

let ahs_json = MQ.to_braket_ahs_json([[0.0, 0.0], [4.0, 0.0]], omega_2mhz, [-5.0, 8.0], 2.0);
let ahs_doc = json_parse(ahs_json);
check(ahs_doc.braketSchemaHeader.name == "braket.ir.ahs.program" and len(ahs_doc.setup.ahs_register.sites) == 2,
    "Amazon Braket AnalogHamiltonianSimulation (AHS) JSON schema verified");

println("=== [6/7] Photonic Linear-Optical QPUs (Clements MZI Mesh & Hong-Ou-Mandel Dip) ===");
// Test Clements et al. (Optica 3, 1460, 2016) exact decomposition on m = 2, 3, 4, 5 QFT optical unitaries!
let m_modes = 2;
while m_modes <= 5 {
    let qft_re = [];
    let qft_im = [];
    let inv_sqrt_m = 1.0 / num_sqrt(m_modes * 1.0);
    let r = 0;
    while r < m_modes {
        let row_r = [];
        let row_i = [];
        let c = 0;
        while c < m_modes {
            let ang = (2.0 * pi * r * c) / (m_modes * 1.0);
            push(row_r, num_cos(ang) * inv_sqrt_m);
            push(row_i, num_sin(ang) * inv_sqrt_m);
            c = c + 1;
        }
        push(qft_re, row_r);
        push(qft_im, row_i);
        r = r + 1;
    }
    let clem = MQ.clements_decompose_unitary(qft_re, qft_im, m_modes);
    let rec = MQ.reconstruct_clements_unitary(clem);
    let expected_bs = num_floor((m_modes * (m_modes - 1)) / 2);
    check(clem.ok and clem.n_beam_splitters == expected_bs,
        "Clements MZI mesh for m=" + str(m_modes) + " uses exact m(m-1)/2 = " + str(expected_bs) + " beam splitters");
    check(rec.ok and rec.frobenius_error < 0.0000000001,
        "Clements MZI reconstruction for m=" + str(m_modes) + " achieves ||U - U_mesh||_F < 1e-10 (got " + str(rec.frobenius_error) + ")");
    m_modes = m_modes + 1;
}

// Hong-Ou-Mandel two-photon quantum interference in Fock space {|2,0>, |1,1>, |0,2>}
let hom_50 = MQ.simulate_hong_ou_mandel(0.5);
check(hom_50.ok and hom_50.coincidence_prob_11 == 0.0,
    "Hong-Ou-Mandel 50:50 beam splitter destructive permanent interference gives exact P(|1,1>) == 0.0");
check(num_abs(hom_50.bunched_prob_20 - 0.5) < 0.000000000001 and num_abs(hom_50.bunched_prob_02 - 0.5) < 0.000000000001,
    "Hong-Ou-Mandel 50:50 beam splitter bunches photons into (|2,0> + |0,2>)/sqrt(2) with P=0.5 each");
check(hom_50.hom_visibility == 1.0, "Hong-Ou-Mandel visibility == 1.0 at R = 0.5");

let hom_20 = MQ.simulate_hong_ou_mandel(0.2);
check(hom_20.ok and hom_20.coincidence_prob_11 > 0.35 and num_abs(hom_20.coincidence_prob_11 - 0.36) < 0.000000000001,
    "Off-balance beam splitter (R=0.2, T=0.8) yields P(|1,1>) = (T - R)^2 = 0.36 > 0");

let hom_0 = MQ.simulate_hong_ou_mandel(0.0);
check(hom_0.ok and num_abs(hom_0.coincidence_prob_11 - 1.0) < 0.000000000001,
    "Transparent R=0.0 optical port yields P(|1,1>) == 1.0");

println("=== [7/7] Static Checker Pass 5: Compile-Time Quantum Wire Bounds & No-Cloning ===");
// 7.1 Valid quantum circuit programs (including loops & chained gate calls) must pass with 0 errors
let valid_q_src = "
let Q = import(\"stdlib:quantum_computing.sapp\");
let qc = Q.new_circuit(4);
Q.h(qc, 0);
Q.cnot(qc, 0, 1);
Q.toffoli(qc, 0, 1, 2);
Q.mcz(qc, [0, 1, 2], 3);
let q = 0;
while q < 3 {
    if q > 0 {
        Q.cnot(qc, 0, q);
    }
    q = q + 1;
}
fn non_quantum_swap(arr, i, j) { return arr; }
let a = [10, 20, 30];
non_quantum_swap(a, 1, 1);
";
let rep_valid = SC.check_source(valid_q_src);
check(rep_valid["ok"] and rep_valid["error_count"] == 0,
    "Valid quantum circuit + loop variable + non-quantum helper passes static_checker with 0 errors");

// 7.2 Register size bounds: new_circuit(0), new_circuit(-2), new_circuit(200), new_circuit(2.5)
let rep_reg0 = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); let qc = Q.new_circuit(0);");
check((not rep_reg0["ok"]) and has_diag_code(rep_reg0, "QUANTUM_INVALID_REGISTER_SIZE"),
    "new_circuit(0) rejected at compile time with QUANTUM_INVALID_REGISTER_SIZE");

let rep_reg_neg = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); let qc = Q.new_circuit(-4);");
check((not rep_reg_neg["ok"]) and has_diag_code(rep_reg_neg, "QUANTUM_INVALID_REGISTER_SIZE"),
    "new_circuit(-4) rejected at compile time with QUANTUM_INVALID_REGISTER_SIZE");

let rep_reg200 = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); let qc = Q.new_circuit(200);");
check((not rep_reg200["ok"]) and has_diag_code(rep_reg200, "QUANTUM_INVALID_REGISTER_SIZE"),
    "new_circuit(200) (> 156 qubits) rejected at compile time with QUANTUM_INVALID_REGISTER_SIZE");

let rep_reg_flt = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); let qc = Q.new_circuit(3.5);");
check((not rep_reg_flt["ok"]) and has_diag_code(rep_reg_flt, "QUANTUM_INVALID_REGISTER_SIZE"),
    "new_circuit(3.5) rejected at compile time with QUANTUM_INVALID_REGISTER_SIZE");

// 7.3 Wire out-of-bounds checks: Q.h(qc, 4), Q.x(qc, -1), const wire, MCZ array wire
let rep_oob_hi = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); let qc = Q.new_circuit(3); Q.h(qc, 4);");
check((not rep_oob_hi["ok"]) and has_diag_code(rep_oob_hi, "QUANTUM_WIRE_OUT_OF_BOUNDS"),
    "Q.h(qc, 4) on 3-qubit register rejected at compile time with QUANTUM_WIRE_OUT_OF_BOUNDS");

let rep_oob_eq = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); let qc = Q.new_circuit(3); Q.rx(qc, 3, 0.5);");
check((not rep_oob_eq["ok"]) and has_diag_code(rep_oob_eq, "QUANTUM_WIRE_OUT_OF_BOUNDS"),
    "Q.rx(qc, 3, 0.5) on 3-qubit register (0..2) rejected with QUANTUM_WIRE_OUT_OF_BOUNDS");

let rep_oob_neg = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); let qc = Q.new_circuit(3); Q.x(qc, -1);");
check((not rep_oob_neg["ok"]) and has_diag_code(rep_oob_neg, "QUANTUM_WIRE_OUT_OF_BOUNDS"),
    "Q.x(qc, -1) rejected at compile time with QUANTUM_WIRE_OUT_OF_BOUNDS");

let rep_oob_ssa = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); let n = 3; let bad_w = 5; let qc = Q.new_circuit(n); Q.sx(qc, bad_w);");
check((not rep_oob_ssa["ok"]) and has_diag_code(rep_oob_ssa, "QUANTUM_WIRE_OUT_OF_BOUNDS"),
    "SSA constant register size n=3 and bad_w=5 caught with QUANTUM_WIRE_OUT_OF_BOUNDS");

let rep_oob_mcz = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); let qc = Q.new_circuit(3); Q.mcz(qc, [0, 7], 1);");
check((not rep_oob_mcz["ok"]) and has_diag_code(rep_oob_mcz, "QUANTUM_WIRE_OUT_OF_BOUNDS"),
    "Q.mcz(qc, [0, 7], 1) out-of-bounds control wire caught with QUANTUM_WIRE_OUT_OF_BOUNDS");

// 7.4 Linearity / No-Cloning duplicate wire checks across CNOT, CZ, SWAP, Toffoli, MCZ, variables & arithmetic
let rep_nc_lit = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); let qc = Q.new_circuit(3); Q.cnot(qc, 2, 2);");
check((not rep_nc_lit["ok"]) and rep_nc_lit["error_count"] == 1 and has_diag_code(rep_nc_lit, "QUANTUM_NO_CLONING_DUPLICATE_WIRE"),
    "Q.cnot(qc, 2, 2) rejected with QUANTUM_NO_CLONING_DUPLICATE_WIRE");

let rep_nc_var = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); fn bad(q) { let qc = Q.new_circuit(4); Q.cnot(qc, q, q); }");
check((not rep_nc_var["ok"]) and has_diag_code(rep_nc_var, "QUANTUM_NO_CLONING_DUPLICATE_WIRE"),
    "Q.cnot(qc, q, q) symbolic duplicate variable wire rejected with QUANTUM_NO_CLONING_DUPLICATE_WIRE");

let rep_nc_expr = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); let qc = Q.new_circuit(4); Q.cz(qc, 1 + 1, 2);");
check((not rep_nc_expr["ok"]) and has_diag_code(rep_nc_expr, "QUANTUM_NO_CLONING_DUPLICATE_WIRE"),
    "Q.cz(qc, 1 + 1, 2) constant-folded duplicate wire rejected with QUANTUM_NO_CLONING_DUPLICATE_WIRE");

let rep_nc_swap = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); fn f(a) { let qc = Q.new_circuit(4); Q.swap(qc, a + 1, 1 + a); }");
check((not rep_nc_swap["ok"]) and has_diag_code(rep_nc_swap, "QUANTUM_NO_CLONING_DUPLICATE_WIRE"),
    "Q.swap(qc, a + 1, 1 + a) commutative expression duplicate wire rejected with QUANTUM_NO_CLONING_DUPLICATE_WIRE");

let rep_nc_toff = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); let qc = Q.new_circuit(3); Q.toffoli(qc, 0, 1, 0);");
check((not rep_nc_toff["ok"]) and has_diag_code(rep_nc_toff, "QUANTUM_NO_CLONING_DUPLICATE_WIRE"),
    "Q.toffoli(qc, 0, 1, 0) control/target overlap rejected with QUANTUM_NO_CLONING_DUPLICATE_WIRE");

let rep_nc_mcz1 = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); let qc = Q.new_circuit(3); Q.mcz(qc, [0, 1], 1);");
check((not rep_nc_mcz1["ok"]) and has_diag_code(rep_nc_mcz1, "QUANTUM_NO_CLONING_DUPLICATE_WIRE"),
    "Q.mcz(qc, [0, 1], 1) control overlapping target rejected with QUANTUM_NO_CLONING_DUPLICATE_WIRE");

let rep_nc_mcz2 = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); fn g(q) { let qc = Q.new_circuit(4); Q.mcz(qc, [q, 2], q); }");
check((not rep_nc_mcz2["ok"]) and has_diag_code(rep_nc_mcz2, "QUANTUM_NO_CLONING_DUPLICATE_WIRE"),
    "Q.mcz(qc, [q, 2], q) symbolic control overlapping target rejected with QUANTUM_NO_CLONING_DUPLICATE_WIRE");

let rep_nc_param_qc = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); fn helper(qc, w) { Q.cnot(qc, w, w); }");
check((not rep_nc_param_qc["ok"]) and rep_nc_param_qc["error_count"] == 1 and has_diag_code(rep_nc_param_qc, "QUANTUM_NO_CLONING_DUPLICATE_WIRE"),
    "Q.cnot(qc, w, w) on quantum module even with parameter circuit caught with QUANTUM_NO_CLONING_DUPLICATE_WIRE");

let rep_nc_cx_alias = SC.check_source("let Q = import(\"stdlib:quantum_computing.sapp\"); fn cx(circ, c, t) { return circ; } let qc = Q.new_circuit(3); cx(qc, 1, 1);");
check((not rep_nc_cx_alias["ok"]) and rep_nc_cx_alias["error_count"] == 1 and has_diag_code(rep_nc_cx_alias, "QUANTUM_NO_CLONING_DUPLICATE_WIRE"),
    "cx(qc, 1, 1) alias on tracked quantum circuit caught with QUANTUM_NO_CLONING_DUPLICATE_WIRE");

// 7.5 Static-check multimodal quantum pipeline program importing multimodal_google_ion_rydberg_photonic.sapp!
let multimodal_user_prog = "
let QC = import(\"stdlib:quantum_computing.sapp\");
let MQ = import(\"stdlib:quantum/multimodal_google_ion_rydberg_photonic.sapp\");
let c = QC.new_circuit(4);
QC.h(c, 0);
QC.cnot(c, 0, 1);
QC.toffoli(c, 0, 1, 3);
let w = MQ.transpile_to_google_willow(c);
let ion = MQ.transpile_to_trapped_ion(c);
let hom = MQ.simulate_hong_ou_mandel(0.5);
";
let rep_mm = SC.check_source(multimodal_user_prog);
check(rep_mm["ok"] and rep_mm["error_count"] == 0,
    "Multimodal quantum user program importing stdlib:quantum/multimodal_google_ion_rydberg_photonic.sapp passes static_checker with 0 errors");

let bad_mm_export = SC.check_source("let MQ = import(\"stdlib:quantum/multimodal_google_ion_rydberg_photonic.sapp\"); MQ.non_existent_fn();");
check((not bad_mm_export["ok"]) and has_diag_code(bad_mm_export, "UNKNOWN_MODULE_EXPORT"),
    "Unknown export on multimodal_google_ion_rydberg_photonic.sapp caught at compile time with UNKNOWN_MODULE_EXPORT");

println("ALL QUANTUM MULTIMODAL & COMPILE-TIME SAFETY TESTS PASSED: " + str(assertions_passed[0]) + " assertions!");
