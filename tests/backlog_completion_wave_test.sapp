    ]
});
check(hf03_res.ok and hf03_res.final_text == "Καλώς ήρθατε\nΓραμμή 2" and hf03_res.line_count == 2 and hf03_res.clicks_120ms_registered == 1 and not hf03_res.prefill_used_as_substitute, "hf03_wd_next02_03_greek_tonos_multiline_120ms");

// 23. Wave 3: HF-05 (Scope-Aware Lint Triage: True Unused vs False-Unused in Nested Scope)
let hf05_res = Wave.triage_pblang_lint_scopes(map{
    bindings: [
        map{ name: "outer_cfg", used_in_declaring_block: false, used_in_nested_closure_or_branch: true },
        map{ name: "dead_temp", used_in_declaring_block: false, used_in_nested_closure_or_branch: false },
        map{ name: "active_idx", used_in_declaring_block: true, used_in_nested_closure_or_branch: false }
    ]
});
check(hf05_res.ok and len(hf05_res.true_unused_warnings) == 1 and hf05_res.true_unused_warnings[0] == "dead_temp" and len(hf05_res.false_unused_nested_scope_verified) == 1 and not hf05_res.silenced_by_underscore_rename, "hf05_lint_scope_triage");

// 24. Wave 3: HF-08 & HF-09 (Shared CLI & GUI Scientific Calculator Contract)
let calc1 = Wave.evaluate_scientific_calculator_contract(map{ expression: "2+3*4", history: [], max_history: 4 });
let calc2 = Wave.evaluate_scientific_calculator_contract(map{ expression: "2^3^2", history: calc1.history, max_history: 4 });
let calc3 = Wave.evaluate_scientific_calculator_contract(map{ expression: "-2^2", history: calc2.history, max_history: 4 });
let calc4 = Wave.evaluate_scientific_calculator_contract(map{ expression: "(-2)^2", history: calc3.history, max_history: 4 });
let calc_bad1 = Wave.evaluate_scientific_calculator_contract(map{ expression: "1 2", history: calc4.history, max_history: 4 });
let calc_bad2 = Wave.evaluate_scientific_calculator_contract(map{ expression: "2)", history: calc4.history, max_history: 4 });
check(calc1.ok and calc1.result == 14 and calc2.result == 512 and calc3.result == -4 and calc4.result == 4, "hf08_hf09_calculator_precedence_and_associativity");
check(not calc_bad1.ok and calc_bad1.trailing_tokens_rejected and not calc_bad2.ok and calc_bad2.unmatched_closing_paren_rejected and len(calc4.history) == 4, "hf08_hf09_calculator_reject_invalid_and_bound_history");

// 25. Wave 3: HF-10 (TesterStudio Synthetic Test Executor with Real PASS/FAIL, Timeout & Log Redaction)
let ts_ok = Wave.execute_testerstudio_synthetic_suite(map{
    suite_name: "core_smoke",
    timeout_ms_per_case: 100,
    cancel_after_case_index: -1,
    cases: [
        map{ id: "c1", expected: 42, actual: 42, simulated_duration_ms: 10, log_message: "TOKEN=secret_val" }
    ]
});
let ts_fail = Wave.execute_testerstudio_synthetic_suite(map{
    suite_name: "failing_suite",
    timeout_ms_per_case: 100,
    cancel_after_case_index: 1,
    cases: [
        map{ id: "c1", expected: 1, actual: 2, simulated_duration_ms: 10, log_message: "mismatch" },
        map{ id: "c2", expected: 1, actual: 1, simulated_duration_ms: 250, log_message: "slow" },
        map{ id: "c3", expected: 1, actual: 1, simulated_duration_ms: 5, log_message: "after_cancel" }
    ]
});
check(ts_ok.ok and ts_ok.passed_count == 1 and ts_ok.case_results[0].log == "[REDACTED_SENSITIVE_LOG]" and not ts_ok.arbitrary_shell_or_eval_used, "hf10_testerstudio_pass_and_redaction");
check(not ts_fail.ok and ts_fail.failed_count == 1 and ts_fail.timed_out_count == 1 and ts_fail.canceled_count == 1, "hf10_testerstudio_fail_timeout_cancel");

// 26. Wave 3: HF-13 & HF-14 (pbAI Joint Encoder/Decoder Training & DEQ Implicit Differentiation)
let pbai_tr = Wave.train_joint_autoencoder_and_deq_step(map{
    train_samples: [0.2, 0.4, 0.6],
    held_out_samples: [0.3, 0.5],
    learning_rate: 0.15,
    initial_weight: 0.5,
    deq_contraction_factor: 0.5
});
let pbai_bad_deq = Wave.train_joint_autoencoder_and_deq_step(map{
    train_samples: [0.2, 0.4],
    held_out_samples: [0.3],
    learning_rate: 0.1,
    initial_weight: 0.5,
    deq_contraction_factor: 0.99
});
check(pbai_tr.ok and pbai_tr.hf13_joint_training.held_out_improved and pbai_tr.hf13_joint_training.non_constant_output_verified and pbai_tr.hf14_deq_implicit.is_true_implicit_differentiation, "hf13_hf14_joint_training_and_deq_implicit");
check(not pbai_bad_deq.ok and pbai_bad_deq.deq_convergence_rejected, "hf14_reject_non_contractive_deq");

// 27. Wave 3: HF-11, HF-12, HF-16, ROOT-RESOURCE-01 & PBOS-J01 (Recovery Corpus Inventory & p95 Benchmark Audit)
let bench_ok = Wave.evaluate_resource_p95_and_recovery_audit(map{
    warmup_count: 1,
    cpu_samples_pct: [6.5, 2.8, 3.0, 2.9, 3.1],
    wall_samples_ms: [20, 11, 12, 11, 12],
    rss_samples_kb: [18500, 18400, 18410, 18405, 18420],
    max_p95_cpu_pct: 4.0,
    restart_attempts_in_window: 1,
    max_restarts_allowed: 3,
    recovery_modules: [
        map{ legacy_sha256: "aaa111", main_sha256: "aaa111" },
        map{ legacy_sha256: "bbb222", main_sha256: "ccc333" },
        map{ legacy_sha256: "ddd444", main_sha256: "" }
    ]
});
check(bench_ok.ok and bench_ok.hf16_benchmark.p95_cpu_pct == 3.1 and bench_ok.hf11_hf12_recovery_inventory.identical_count == 1 and bench_ok.hf11_hf12_recovery_inventory.different_count == 1 and bench_ok.hf11_hf12_recovery_inventory.untracked_unique_count == 1, "hf11_12_16_pbos_j01_p95_and_recovery_audit");

print "BACKLOG_COMPLETION_WAVE_PASS checks=" + str(checks);
