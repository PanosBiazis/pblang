// Verification Suite for stdlib/backlog_completion_wave.sapp and stdlib/web_security.sapp
let Wave = import("stdlib:backlog_completion_wave.sapp");
let WebSec = import("stdlib:web_security.sapp");

let checks = 0;
fn check(cond, label) {
    if not cond {
        throw "BACKLOG_WAVE_FAIL: " + str(label);
    }
    checks = checks + 1;
}

// 1. PB-01-003: Feature/Module Gate + Debug Override Control
let gate_prod = Wave.create_feature_module_gate(map{ erp_sync: true, experimental_nd: false }, false);
check(Wave.evaluate_module_execution(gate_prod, "erp_sync").allowed, "pb_01_003_active_module");
check(not Wave.evaluate_module_execution(gate_prod, "experimental_nd").allowed, "pb_01_003_disabled_module");
check(not Wave.evaluate_module_execution(gate_prod, "unknown_mod").allowed, "pb_01_003_unknown_disabled_by_default");
let dbg_reject = Wave.toggle_module_state(gate_prod, "experimental_nd", true, "manual_debug_session");
check(not dbg_reject.ok and dbg_reject.debug_rejected, "pb_01_003_reject_debug_when_disabled");
let gate_dbg = Wave.create_feature_module_gate(map{ experimental_nd: false }, true);
let dbg_ok = Wave.toggle_module_state(gate_dbg, "experimental_nd", true, "manual_debug_session");
check(dbg_ok.ok and Wave.evaluate_module_execution(gate_dbg, "experimental_nd").allowed, "pb_01_003_allow_manual_debug_when_enabled");

// 2. PB-01-016 & PB-01-018: Unified Design System, WCAG AAA, Typography/Spacing Overrides & Security Indicator Guard
let ds_bad = Wave.compile_unified_design_system(map{ hide_security_indicators: true }, map{});
