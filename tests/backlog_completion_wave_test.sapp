let audit_ok = Wave.evaluate_observatory_and_pagespeed_audit(map{
    csp: obs_preset.csp,
    set_cookie: host_cookie,
    sri_sha384_present: true,
    agentic_browsing_passed_count: 7,
    anti_scraping_enabled: true,
    probe_protection_enabled: true
});
check(audit_ok.ok and audit_ok.observatory_tests_passed == 12 and audit_ok.observatory_csp_10_of_10, "pb_04_008_observatory_12_of_12");
check(not audit_ok.pagespeed_score_equals_security_proof and not audit_ok.anti_reverse_engineering_is_absolute_guarantee, "pb_04_009_011_honest_epistemic_limits");

