// tests/quantum_qec_stabilizer_test.sapp — Comprehensive Verification Suite for
// 1,000+ Qubit Bit-Packed Aaronson-Gottesman Clifford Stabilizer Tableau Simulator &
// Fault-Tolerant Quantum Error Correction ([[3,1,1]], Shor [[9,1,3]], Steane [[7,1,3]],
// Rotated Surface Code Surface-17 d=3 & d=5/d=7 + MWPM Decoder) (PBLang v3.0.0).

let QEC = import("stdlib:quantum/qec_stabilizer_1000q.sapp");
let QC = import("stdlib:quantum_computing.sapp");

let total_checks = 0;
let passed_checks = 0;

fn check(cond, label) {
    total_checks = total_checks + 1;
    if not cond {
        throw "FAIL [" + label + "]";
    }
    passed_checks = passed_checks + 1;
}

// ── 1. Bit-Packed Stabilizer Tableau Sizing & Algebraic Gate Identities ─────
let tab_1024 = QEC.new_stabilizer_tableau(1024, 42);
check(tab_1024.n_qubits == 1024 and tab_1024.words == 35 and tab_1024.total_rows == 2049,
    "1,024-qubit tableau packs rows into ceil(1024/30) == 35 30-bit words");

let tab_1200 = QEC.new_stabilizer_tableau(1200, 99);
check(tab_1200.n_qubits == 1200 and tab_1200.words == 40 and tab_1200.total_rows == 2401,
    "1,200-qubit tableau packs rows into ceil(1200/30) == 40 30-bit words");

// Verify exact Clifford identities on single/two-qubit stabilizer strings:
// SX * SX == X, S * S == Z, S * Sdg == I, H * Y * H == -Y
let t_alg = QEC.new_stabilizer_tableau(2, 7);
QEC.tab_sx(t_alg, 0);
QEC.tab_sx(t_alg, 0);
let m_sxsx = QEC.tab_measure(t_alg, 0, nil);
check(m_sxsx.deterministic and m_sxsx.outcome == 1, "SX * SX |0> == |1> deterministically");

let t_phase = QEC.new_stabilizer_tableau(2, 7);
QEC.tab_h(t_phase, 0);
QEC.tab_s(t_phase, 0);
QEC.tab_cnot(t_phase, 0, 1);
QEC.tab_s(t_phase, 1);
QEC.tab_h(t_phase, 0);
QEC.tab_h(t_phase, 1);
// State is (|01> + |10>) / sqrt(2) due to i * i == -1 destructive interference on |00>, |11>
let m_bell_0 = QEC.tab_measure(t_phase, 0, 0);
let m_bell_1 = QEC.tab_measure(t_phase, 1, nil);
check((not m_bell_0.deterministic) and m_bell_0.outcome == 0 and
      m_bell_1.deterministic and m_bell_1.outcome == 1,
      "Exact rowsum mod-4 phase tracks S*S == -1 interference: q0=0 forces q1=1 deterministically");

// Verify explicit rowsum(tab, h_row, i_row) export on commuting stabilizers (+Y0 Y1)*(+X0 X1) == -Z0 Z1
let t_rs = QEC.new_stabilizer_tableau(2, 11);
QEC.tab_h(t_rs, 0);
QEC.tab_s(t_rs, 0);
QEC.tab_cnot(t_rs, 0, 1);
QEC.tab_s(t_rs, 1);
QEC.tab_h(t_rs, 0);
QEC.tab_h(t_rs, 1);
let stabs_before = QEC.tab_stabilizer_strings(t_rs);
check(stabs_before[0] == "+YY" and stabs_before[1] == "+XX",
    "Stabilizer generators before rowsum are +YY and +XX");
let rs_mod4 = QEC.rowsum(t_rs, 3, 2);
let stabs_after = QEC.tab_stabilizer_strings(t_rs);
check(rs_mod4 == 2 and stabs_after[1] == "-ZZ",
    "rowsum(+XX, +YY) accumulates g=-1-1 == 2 mod 4 -> -ZZ");

// ── 2. Mandatory 1,000-Qubit GHZ State Build, Measurement & Runtime Check ───
let ghz_b0 = QEC.benchmark_ghz_1000q(1000, 0, 42);
check(ghz_b0.ok, "1,000-qubit GHZ benchmark ok (forced branch 0)");
check(ghz_b0.words_per_row == 34, "1,000-qubit GHZ uses 34 30-bit words per row");
check(ghz_b0.q0.deterministic == false and ghz_b0.q0.outcome == 0,
    "1,000-qubit GHZ q[0] measurement is non-deterministic (outcome 0)");
check(ghz_b0.q_mid_index == 499 and ghz_b0.q_mid.deterministic == true and ghz_b0.q_mid.outcome == 0,
    "1,000-qubit GHZ q[499] measurement is deterministic with matching outcome 0");
check(ghz_b0.q_last_index == 999 and ghz_b0.q_last.deterministic == true and ghz_b0.q_last.outcome == 0,
    "1,000-qubit GHZ q[999] measurement is deterministic with matching outcome 0");

let ghz_b1 = QEC.benchmark_ghz_1000q(1000, 1, 42);
check(ghz_b1.ok, "1,000-qubit GHZ benchmark ok (forced branch 1)");
check(ghz_b1.q0.deterministic == false and ghz_b1.q0.outcome == 1 and
      ghz_b1.q_mid.deterministic == true and ghz_b1.q_mid.outcome == 1 and
      ghz_b1.q_last.deterministic == true and ghz_b1.q_last.outcome == 1,
      "1,000-qubit GHZ q[0]=1 collapses q[499]=1 and q[999]=1 deterministically");

let ghz_rand = QEC.benchmark_ghz_1000q(1000, nil, 2026);
check(ghz_rand.ok and (not ghz_rand.q0.deterministic) and
      ghz_rand.q_mid.deterministic and ghz_rand.q_last.deterministic and
      ghz_rand.q0.outcome == ghz_rand.q_mid.outcome and
      ghz_rand.q0.outcome == ghz_rand.q_last.outcome,
      "1,000-qubit GHZ unforced random measurement collapses all 1,000 qubits identically");

// Simulate 1,024-qubit GHZ circuit via simulate_clifford_circuit (256 shots)
let ops_1024 = [map{ op: "h", q: 0 }];
let qi_1024 = 0;
while qi_1024 < 1023 {
    push(ops_1024, map{ op: "cnot", c: qi_1024, t: qi_1024 + 1 });
    qi_1024 = qi_1024 + 1;
}
let t_sim1024_start = now_ms();
let sim_1024 = QEC.simulate_clifford_circuit(1024, ops_1024, 256, 42);
let sim_1024_ms = now_ms() - t_sim1024_start;
let zeros_1024 = "";
let ones_1024 = "";
let z_i = 0;
while z_i < 1024 {
    zeros_1024 = zeros_1024 + "0";
    ones_1024 = ones_1024 + "1";
    z_i = z_i + 1;
}
check(sim_1024.ok and sim_1024.support_rank == 1 and len(map_keys(sim_1024.counts)) == 2 and
      (sim_1024.counts[zeros_1024] + sim_1024.counts[ones_1024] == 256),
      "1,024-qubit GHZ simulate_clifford_circuit (256 shots) produces exclusively 0^1024 and 1^1024");

// ── 3. Cross-Validation vs stdlib:quantum_computing.sapp (4q & 5q Clifford) ─
// 4-qubit Clifford circuit exercising H, S, Sdg, SX, X, Y, Z, CNOT, CZ, SWAP
let qc4 = QC.new_circuit(4);
QC.h(qc4, 0);
QC.sx(qc4, 1);
QC.x(qc4, 2);
QC.h(qc4, 3);
QC.s(qc4, 0);
QC.cnot(qc4, 0, 2);
QC.cz(qc4, 1, 3);
QC.y(qc4, 2);
QC.sdg(qc4, 3);
QC.cnot(qc4, 3, 1);
QC.z(qc4, 0);
QC.swap(qc4, 0, 2);
QC.h(qc4, 1);
QC.sx(qc4, 3);
QC.cz(qc4, 0, 1);
QC.h(qc4, 2);

let sv4_probs = QC.probabilities(qc4).by_bitstring;
let tab4_res = QEC.simulate_clifford_circuit(4, qc4, 4096, 1337);
let keys4 = map_keys(sv4_probs);
let max_diff_4q = 0.0;
let k4_i = 0;
while k4_i < len(keys4) {
    let bs = keys4[k4_i];
    let diff = num_abs(sv4_probs[bs] - tab4_res.exact_probabilities[bs]);
    if diff > max_diff_4q { max_diff_4q = diff; }
    k4_i = k4_i + 1;
}
let fid_4q = QC.compute_quantum_fidelity(sv4_probs, tab4_res.counts);
check(max_diff_4q < 0.000000000001,
    "4-qubit multi-gate Clifford circuit (H,S,Sdg,SX,X,Y,Z,CNOT,CZ,SWAP) matches statevector to < 1e-12");
check(fid_4q > 0.998,
    "4-qubit multi-gate Clifford Monte Carlo sampling achieves Hellinger fidelity > 0.998");

// 5-qubit entangled Clifford graph/stabilizer circuit with phase interference
let qc5 = QC.new_circuit(5);
QC.h(qc5, 0);
QC.h(qc5, 1);
QC.sx(qc5, 2);
QC.h(qc5, 3);
QC.x(qc5, 4);
QC.cz(qc5, 0, 1);
QC.cnot(qc5, 1, 2);
QC.s(qc5, 2);
QC.cz(qc5, 2, 3);
QC.cnot(qc5, 3, 4);
QC.sdg(qc5, 4);
QC.y(qc5, 1);
QC.z(qc5, 3);
QC.cnot(qc5, 4, 0);
QC.sx(qc5, 0);
QC.s(qc5, 1);
QC.h(qc5, 2);
QC.sdg(qc5, 3);
QC.h(qc5, 4);
QC.swap(qc5, 1, 3);
QC.cz(qc5, 0, 4);
QC.h(qc5, 0);

let sv5_probs = QC.probabilities(qc5).by_bitstring;
let tab5_res = QEC.simulate_clifford_circuit(5, qc5, 4096, 2026);
let keys5 = map_keys(sv5_probs);
let max_diff_5q = 0.0;
let k5_i = 0;
while k5_i < len(keys5) {
    let bs = keys5[k5_i];
    let diff = num_abs(sv5_probs[bs] - tab5_res.exact_probabilities[bs]);
    if diff > max_diff_5q { max_diff_5q = diff; }
    k5_i = k5_i + 1;
}
let fid_5q = QC.compute_quantum_fidelity(sv5_probs, tab5_res.counts);
check(max_diff_5q < 0.000000000001,
    "5-qubit multi-gate Clifford circuit matches statevector probabilities across all 32 states to < 1e-12");
check(fid_5q > 0.995,
    "5-qubit multi-gate Clifford Monte Carlo sampling achieves Hellinger fidelity > 0.995");

// ── 4. 3-Qubit Bit-Flip & Phase-Flip [[3, 1, 1]] Superposition Recovery ─────
// Arbitrary complex state: alpha = 0.6 - 0.2i, beta = -0.3 + 0.714142842854i
let bf_none = QEC.qec_bitflip_3q_test(0.6, -0.2, -0.3, 0.714142842854, -1);
check(bf_none.ok and bf_none.corrected_qubit == -1 and bf_none.fidelity > 0.999999999999,
    "3-qubit bit-flip code preserves arbitrary superposition with no error");

let eq_idx = 0;
while eq_idx < 3 {
    let bf = QEC.qec_bitflip_3q_test(0.6, -0.2, -0.3, 0.714142842854, eq_idx);
    check(bf.ok and bf.corrected_qubit == eq_idx and bf.fidelity > 0.999999999999,
        "3-qubit bit-flip code 100% recovers X error on physical qubit " + str(eq_idx));
    eq_idx = eq_idx + 1;
}

let pf_none = QEC.qec_phaseflip_3q_test(0.35, 0.55, -0.62, 0.436577599059, -1);
check(pf_none.ok and pf_none.corrected_qubit == -1 and pf_none.fidelity > 0.999999999999,
    "3-qubit phase-flip code preserves arbitrary superposition with no error");

let pq_idx = 0;
while pq_idx < 3 {
    let pf = QEC.qec_phaseflip_3q_test(0.35, 0.55, -0.62, 0.436577599059, pq_idx);
    check(pf.ok and pf.corrected_qubit == pq_idx and pf.fidelity > 0.999999999999,
        "3-qubit phase-flip code 100% recovers Z error on physical qubit " + str(pq_idx));
    pq_idx = pq_idx + 1;
}

// ── 5. Shor [[9, 1, 3]] Code: Exhaustive 28/28 Single-Qubit Pauli Faults ────
let shor_theta = 1.23456789;
let shor_phi = -2.09876543;

let shor_none = QEC.qec_shor_9q_protect(shor_theta, shor_phi, "none", 0);
check(shor_none.ok and shor_none.fidelity > 0.9999999999,
    "Shor [[9,1,3]] fault case 1/28 (none): F_L > 0.9999999999");

let paulis = ["X", "Y", "Z"];
let shor_min_fidelity = shor_none.fidelity;
let shor_pass_count = if shor_none.fidelity > 0.9999999999 { 1 } else { 0 };
let pi_idx = 0;
while pi_idx < 3 {
    let p_err = paulis[pi_idx];
    let sq = 0;
    while sq < 9 {
        let sres = QEC.qec_shor_9q_protect(shor_theta, shor_phi, p_err, sq);
        if sres.fidelity < shor_min_fidelity {
            shor_min_fidelity = sres.fidelity;
        }
        if sres.ok and sres.fidelity > 0.9999999999 {
            shor_pass_count = shor_pass_count + 1;
        }
        check(sres.ok and sres.fidelity > 0.9999999999,
            "Shor [[9,1,3]] fault " + p_err + "_" + str(sq) + " recovered with F_L > 0.9999999999");
        sq = sq + 1;
    }
    pi_idx = pi_idx + 1;
}
check(shor_pass_count == 28 and shor_min_fidelity > 0.9999999999,
    "Shor [[9,1,3]] passes ALL 28/28 fault cases with min F_L > 0.9999999999");

// ── 6. Steane [[7, 1, 3]] CSS Hamming Color Code: All 22/22 Fault Cases ─────
// Verify all 22 cases on BOTH Z-basis ("1") and X/Y superposition bases ("+", "+i")
let steane_states = ["0", "1", "+", "-", "+i", "-i"];
let st_i = 0;
while st_i < len(steane_states) {
    let lstate = steane_states[st_i];
    let r_none = QEC.qec_steane_7q_round(lstate, "none", 0);
    let state_passes = if r_none.ok and (not r_none.logical_error) and r_none.s_x == 0 and r_none.s_z == 0 { 1 } else { 0 };

    let ep_i = 0;
    while ep_i < 3 {
        let etype = paulis[ep_i];
        let eq = 0;
        while eq < 7 {
            let rr = QEC.qec_steane_7q_round(lstate, etype, eq);
            let expected_sz = if etype == "X" or etype == "Y" { eq + 1 } else { 0 };
            let expected_sx = if etype == "Z" or etype == "Y" { eq + 1 } else { 0 };
            if rr.ok and (not rr.logical_error) and rr.s_z == expected_sz and rr.s_x == expected_sx {
                state_passes = state_passes + 1;
            }
            if lstate == "+" {
                check(rr.ok and (not rr.logical_error) and rr.s_z == expected_sz and rr.s_x == expected_sx,
                    "Steane [[7,1,3]] |+_L> fault " + etype + "_" + str(eq) + " Hamming index exact & 0 logical error");
            }
            eq = eq + 1;
        }
        ep_i = ep_i + 1;
    }
    check(state_passes == 22,
        "Steane [[7,1,3]] logical |" + lstate + "_L> achieves 22/22 fault-free recovery");
    st_i = st_i + 1;
}

// ── 7. Rotated Surface Code (Surface-17 d=3, Surface-49 d=5, Surface-97 d=7) ─
let sc3 = QEC.build_rotated_surface_code(3);
check(sc3.name == "Surface-17" and sc3.n_data == 9 and sc3.n_ancilla == 8 and sc3.total_qubits == 17,
    "d=3 Rotated Surface Code is Surface-17 (9 data + 8 ancilla = 17 qubits)");
check(len(sc3.x_plaquettes) == 4 and len(sc3.z_plaquettes) == 4 and sc3.commutes and sc3.logical_anticommutes,
    "Surface-17 has 4 X-plaquettes, 4 Z-plaquettes, commuting CSS stabilizers & anticommuting logicals");

let sc5 = QEC.build_rotated_surface_code(5);
check(sc5.name == "Surface-49" and sc5.n_data == 25 and sc5.n_ancilla == 24 and sc5.total_qubits == 49,
    "d=5 Rotated Surface Code has 25 data + 24 ancilla = 49 qubits");
check(len(sc5.x_plaquettes) == 12 and len(sc5.z_plaquettes) == 12 and sc5.commutes and sc5.logical_anticommutes,
    "d=5 Rotated Surface Code has 12 X + 12 Z commuting plaquettes");

let sc7 = QEC.build_rotated_surface_code(7);
check(sc7.name == "Surface-97" and sc7.n_data == 49 and sc7.n_ancilla == 48 and sc7.total_qubits == 97 and
      sc7.commutes and sc7.logical_anticommutes,
      "d=7 Rotated Surface Code has 49 data + 48 ancilla = 97 qubits & commuting stabilizers");

// d=3 Surface-17: Exhaustive 27/27 single-qubit X, Y, Z errors -> 0 logical failures
let sc3_no_err = QEC.surface_code_syndrome_and_decode(sc3, [], []);
check(sc3_no_err.ok and (not sc3_no_err.logical_error), "Surface-17 zero-error round passes");

let sc3_w1_passes = 0;
let q3 = 0;
while q3 < 9 {
    let dx = QEC.surface_code_syndrome_and_decode(sc3, [q3], []);
    let dz = QEC.surface_code_syndrome_and_decode(sc3, [], [q3]);
    let dy = QEC.surface_code_syndrome_and_decode(sc3, [q3], [q3]);
    check(dx.ok and (not dx.logical_error), "Surface-17 corrects single X error on data qubit " + str(q3));
    check(dz.ok and (not dz.logical_error), "Surface-17 corrects single Z error on data qubit " + str(q3));
    check(dy.ok and (not dy.logical_error), "Surface-17 corrects single Y error on data qubit " + str(q3));
    if dx.ok and dz.ok and dy.ok {
        sc3_w1_passes = sc3_w1_passes + 3;
    }
    q3 = q3 + 1;
}
check(sc3_w1_passes == 27, "Surface-17 corrects 27/27 (100%) single-qubit X, Y, Z errors with 0 logical failures");

// d=5 Surface-49: Exhaustive 100% weight-1 (75/75) AND weight-2 (all C(25,2)=300 pairs for X, Z, Y, XZ!)
let sc5_w1_fails = 0;
let q5 = 0;
while q5 < 25 {
    if QEC.surface_code_syndrome_and_decode(sc5, [q5], []).logical_error { sc5_w1_fails = sc5_w1_fails + 1; }
    if QEC.surface_code_syndrome_and_decode(sc5, [], [q5]).logical_error { sc5_w1_fails = sc5_w1_fails + 1; }
    if QEC.surface_code_syndrome_and_decode(sc5, [q5], [q5]).logical_error { sc5_w1_fails = sc5_w1_fails + 1; }
    q5 = q5 + 1;
}
check(sc5_w1_fails == 0, "d=5 Surface-49 corrects 75/75 (100%) single-qubit X, Y, Z errors with 0 logical failures");

let sc5_w2_pairs = 0;
let sc5_w2_fails = 0;
let a5 = 0;
while a5 < 25 {
    let b5 = a5 + 1;
    while b5 < 25 {
        sc5_w2_pairs = sc5_w2_pairs + 1;
        if QEC.surface_code_syndrome_and_decode(sc5, [a5, b5], []).logical_error {
            sc5_w2_fails = sc5_w2_fails + 1;
        }
        if QEC.surface_code_syndrome_and_decode(sc5, [], [a5, b5]).logical_error {
            sc5_w2_fails = sc5_w2_fails + 1;
        }
        if QEC.surface_code_syndrome_and_decode(sc5, [a5, b5], [a5, b5]).logical_error {
            sc5_w2_fails = sc5_w2_fails + 1;
        }
        if QEC.surface_code_syndrome_and_decode(sc5, [a5], [b5]).logical_error {
            sc5_w2_fails = sc5_w2_fails + 1;
        }
        b5 = b5 + 1;
    }
    a5 = a5 + 1;
}
check(sc5_w2_pairs == 300 and sc5_w2_fails == 0,
    "d=5 Surface-49 corrects 100% of weight-2 errors across all 300 qubit pairs (1,200 X/Z/Y/XZ cases, 0 failures)");

// Below-Threshold Exponential Error Suppression (Google Willow Milestone)
let thresh = QEC.simulate_surface_code_threshold(0.02, 300, 2026);
check(thresh.ok and thresh.below_threshold,
    "simulate_surface_code_threshold(0.02, 300, 2026) confirms below-threshold regime");
check(thresh.p_logical_d5 < thresh.p_logical_d3 and thresh.p_logical_d3 < thresh.p_phys,
    "Exponential surface-code suppression verified: p_L(d=5) < p_L(d=3) < p_phys");

print "GHZ_1000Q_RUNTIME_MS=" + str(ghz_b0.elapsed_ms) + " SIM_1024Q_256SHOTS_MS=" + str(sim_1024_ms) +
      " THRESHOLD_D3=" + str(thresh.p_logical_d3) + " THRESHOLD_D5=" + str(thresh.p_logical_d5);
print "QUANTUM_QEC_STABILIZER_TEST_PASS checks=" + str(passed_checks) + "/" + str(total_checks);
