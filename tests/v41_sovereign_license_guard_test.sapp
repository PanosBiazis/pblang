// tests/v41_sovereign_license_guard_test.sapp — Comprehensive Verification Suite
// for `stdlib/security/sovereign_license_guard.sapp` (PBLang v4.1.0).
//
// Zero network calls, zero telemetry, zero host/user PII paths.

let SLG = import("stdlib:security/sovereign_license_guard.sapp");

let assertions = 0;

fn demand(cond, msg) {
    if not cond {
        throw "SOVEREIGN_LICENSE_GUARD_TEST_FAIL [" + str(assertions + 1) + "]: " + str(msg);
    }
    assertions = assertions + 1;
}

// ── 1. RFC 8032 Ed25519 & RFC 8439 ChaCha20-Poly1305 Official Test Vectors ──

let rfc_kp = SLG.generate_vendor_keypair("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60");
demand(rfc_kp.algorithm == "ed25519", "RFC 8032 keypair algorithm tag");
demand(rfc_kp.pk_hex == "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a", "RFC 8032 Vector #1 public key");
demand(SLG.derive_vendor_public_key(rfc_kp.sk_hex) == rfc_kp.pk_hex, "derive_vendor_public_key matches pk_hex");
let rfc_sig = SLG.ed25519_sign_message(rfc_kp.sk_hex, "");
demand(rfc_sig == "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b", "RFC 8032 Vector #1 deterministic signature");
demand(SLG.ed25519_verify_message(rfc_kp.pk_hex, "", rfc_sig), "RFC 8032 Vector #1 verify true");
demand(not SLG.ed25519_verify_message(rfc_kp.pk_hex, "x", rfc_sig), "RFC 8032 Vector #1 rejects 1-byte message diff");

// Fresh CSPRNG vendor keypair
let vendor_kp = SLG.generate_vendor_keypair();
let attacker_kp = SLG.generate_vendor_keypair();
demand(len(vendor_kp.sk_hex) == 64 and len(vendor_kp.pk_hex) == 64, "CSPRNG vendor keypair 64-hex lengths");
demand(vendor_kp.sk_hex != vendor_kp.pk_hex, "secret_key != public_key");
demand(vendor_kp.pk_hex != attacker_kp.pk_hex, "independent CSPRNG keypairs are distinct");
demand(vendor_kp.embed_in_client_binary == vendor_kp.pk_hex and vendor_kp.keep_strictly_offline == true, "vendor keypair safety metadata");

// RFC 8439 §2.8.2 ChaCha20-Poly1305 AEAD vector
let rfc_aead_key = [
    128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,
    144,145,146,147,148,149,150,151,152,153,154,155,156,157,158,159
];
let rfc_aead_nonce = [7,0,0,0, 64,65,66,67, 68,69,70,71];
let rfc_aead_aad = [80,81,82,83, 192,193,194,195, 196,197,198,199];
let rfc_aead_pt = str_to_bytes("Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.");
let rfc_aead_enc = SLG.chacha20_poly1305_aead_encrypt(rfc_aead_key, rfc_aead_nonce, rfc_aead_pt, rfc_aead_aad);
demand(rfc_aead_enc.tag_hex == "1ae10b594f09e26a7e902ecbd0600691", "RFC 8439 §2.8.2 Poly1305 tag exact match");
let rfc_aead_dec = SLG.chacha20_poly1305_aead_decrypt(rfc_aead_key, rfc_aead_nonce, rfc_aead_enc.ciphertext_bytes, rfc_aead_enc.tag_bytes, rfc_aead_aad);
demand(rfc_aead_dec.ok and bytes_to_str(rfc_aead_dec.plaintext_bytes) == bytes_to_str(rfc_aead_pt), "RFC 8439 §2.8.2 AEAD round-trip");
let bad_aad_dec = SLG.chacha20_poly1305_aead_decrypt(rfc_aead_key, rfc_aead_nonce, rfc_aead_enc.ciphertext_bytes, rfc_aead_enc.tag_bytes, [80,81]);
demand(not bad_aad_dec.ok and bad_aad_dec.plaintext_bytes == nil, "RFC 8439 AEAD rejects tampered AAD");

// ── 2. Privacy-Preserving Unlinkable Seat Commitment & Zero-PII Scrubber ────

let synth_machine_traits = map{
    cpu_arch: "x86_64",
    cores: 16,
    os_install_nonce: "synth-install-token-998877",
    raw_sensitive_label: "workstation-alpha-secret-host"
};

let seat_app_a1 = SLG.compute_privacy_seat_id("org.example.cad_pro", synth_machine_traits);
let seat_app_a2 = SLG.compute_privacy_seat_id("org.example.cad_pro", synth_machine_traits);
let seat_app_b  = SLG.compute_privacy_seat_id("org.example.audio_studio", synth_machine_traits);
let seat_other_hw = SLG.compute_privacy_seat_id("org.example.cad_pro", map{
    cpu_arch: "aarch64",
    cores: 8,
    os_install_nonce: "different-device-443322"
});
let seat_default_runtime = SLG.compute_privacy_seat_id("org.example.cli_tool");

demand(len(seat_app_a1) == 32 and len(seat_default_runtime) == 32, "compute_privacy_seat_id returns 32-char blinded hex token");
demand(seat_app_a1 == seat_app_a2, "compute_privacy_seat_id is deterministic for same app domain + machine");
demand(seat_app_a1 != seat_app_b, "cross-app unlinkability: identical machine yields uncorrelated seat_id across app domains");
demand(seat_app_a1 != seat_other_hw, "distinct machines yield distinct seat_ids");
demand(not str_contains(seat_app_a1, "workstation") and not str_contains(seat_app_a1, "998877") and not str_contains(seat_app_a1, ":"), "seat_id leaks zero raw OS strings");

// PII scrubber checks (constructed without literal PII/paths in repo)
let synth_email = "customer_jane" + "@" + "example.invalid";
let synth_unix_path = "/" + "usr_vol" + "/" + "jane_doe" + "/keys";
let synth_mac = "aa" + ":bb:" + "cc:dd:ee:ff";
let synth_ip = "198" + "." + "51" + "." + "100" + "." + "42";

demand(str_starts_with(SLG.scrub_pii_tag(synth_email, true), "anon_"), "scrub_pii_tag blinds email addresses");
demand(str_starts_with(SLG.scrub_pii_tag(synth_unix_path, true), "anon_"), "scrub_pii_tag blinds filesystem paths");
demand(str_starts_with(SLG.scrub_pii_tag(synth_mac, true), "anon_"), "scrub_pii_tag blinds MAC addresses");
demand(str_starts_with(SLG.scrub_pii_tag(synth_ip, true), "anon_"), "scrub_pii_tag blinds IPv4 addresses");
demand(SLG.scrub_pii_tag("pseudonym-customer-4096", true) == "pseudonym-customer-4096", "scrub_pii_tag preserves clean pseudonymous tag");

// ── 3. License Issuance & Offline Verification (`perpetual`, `subscription`, `trial`, `floating`) ──

let base_now = 1760000000;

// 3a. Perpetual Enterprise License (portable across user's devices, max_version ceiling, PII-scrubbed alias)
let perp_tok = SLG.issue_license(vendor_kp.sk_hex, map{
    license_id: "lic_perp_ent_001",
    product_id: "pblang-studio",
    edition: "enterprise",
    license_type: "perpetual",
    features: ["core", "confidential_reports", "advanced_export", "ai_copilot"],
    issued_at: base_now,
    not_before: base_now,
    expires_at: nil,
    max_version: "4.99.99",
    seat_id: nil,
    licensee_alias: synth_email
});

demand(str_starts_with(perp_tok, "PBLIC1."), "armored license uses PBLIC1. prefix");
demand(not str_contains(perp_tok, "customer_jane"), "issued token payload contains zero raw email PII");

let perp_ver = SLG.verify_license(perp_tok, vendor_kp.pk_hex, map{
    expected_product_id: "pblang-studio",
    now_unix: base_now + 315360000, // +10 years in the future!
    app_version: "4.1.0"
});
demand(perp_ver.ok and perp_ver.status == "valid", "perpetual license valid +10 years offline");
demand(perp_ver.is_perpetual == true and perp_ver.remaining_seconds == nil, "perpetual license never expires");
demand(perp_ver.edition == "enterprise" and perp_ver.license_type == "perpetual", "perpetual edition & type preserved");
demand(perp_ver.privacy_zero_telemetry == true, "privacy_zero_telemetry flag true");
demand(str_starts_with(perp_ver.licensee_alias, "anon_"), "verified token alias is privacy-blinded");

// SemVer ceiling checks on perpetual license (`max_version: "4.99.99"`)
let ver_ok_ceiling = SLG.verify_license(perp_tok, vendor_kp.pk_hex, map{
    expected_product_id: "pblang-studio",
    now_unix: base_now + 100,
    app_version: "4.99.99"
});
demand(ver_ok_ceiling.ok, "app_version at exact max_version ceiling passes");

let ver_over_ceiling = SLG.verify_license(perp_tok, vendor_kp.pk_hex, map{
    expected_product_id: "pblang-studio",
    now_unix: base_now + 100,
    app_version: "5.0.0"
});
demand(not ver_over_ceiling.ok and ver_over_ceiling.status == "version_exceeds_ceiling", "app_version above max_version ceiling rejected");

// 3b. Subscription Pro License (node-locked to `seat_app_a1`)
let sub_tok = SLG.issue_license(vendor_kp.sk_hex, map{
    license_id: "lic_sub_pro_002",
    product_id: "pblang-cad",
    edition: "pro",
    license_type: "subscription",
    features: ["core", "step_export"],
    issued_at: base_now,
    not_before: base_now + 60,
    expires_at: base_now + 86400 * 365,
    seat_id: seat_app_a1,
    licensee_alias: "studio-seat-alpha"
});

let sub_early = SLG.verify_license(sub_tok, vendor_kp.pk_hex, map{
    expected_product_id: "pblang-cad",
    now_unix: base_now + 10,
    seat_id: seat_app_a1
});
demand(not sub_early.ok and sub_early.status == "not_yet_valid", "not_before strictly enforced");

let sub_valid = SLG.verify_license(sub_tok, vendor_kp.pk_hex, map{
    expected_product_id: "pblang-cad",
    now_unix: base_now + 3600,
    seat_id: seat_app_a1,
    required_feature: "step_export"
});
demand(sub_valid.ok and sub_valid.remaining_seconds == 86400 * 365 - 3600, "subscription valid on matching seat_id with exact remaining_seconds");

let sub_missing_feat = SLG.verify_license(sub_tok, vendor_kp.pk_hex, map{
    expected_product_id: "pblang-cad",
    now_unix: base_now + 3600,
    seat_id: seat_app_a1,
    required_feature: "enterprise_cluster"
});
demand(not sub_missing_feat.ok and sub_missing_feat.status == "feature_not_entitled", "unentitled feature rejected");

let sub_wrong_seat = SLG.verify_license(sub_tok, vendor_kp.pk_hex, map{
    expected_product_id: "pblang-cad",
    now_unix: base_now + 3600,
    seat_id: seat_other_hw
});
demand(not sub_wrong_seat.ok and sub_wrong_seat.status == "seat_mismatch", "node-locked license rejected on wrong seat_id");

let sub_wrong_prod = SLG.verify_license(sub_tok, vendor_kp.pk_hex, map{
    expected_product_id: "other-product",
    now_unix: base_now + 3600,
    seat_id: seat_app_a1
});
demand(not sub_wrong_prod.ok and sub_wrong_prod.status == "product_mismatch", "wrong expected_product_id rejected");

// 3c. Trial & Floating Licenses + Expiry Check
let trial_tok = SLG.issue_license(vendor_kp.sk_hex, map{
    license_id: "lic_trial_003",
    product_id: "pblang-studio",
    edition: "standard",
    license_type: "trial",
    features: ["core"],
    issued_at: base_now,
    expires_at: base_now + 14 * 86400
});
let trial_ok = SLG.verify_license(trial_tok, vendor_kp.pk_hex, map{ now_unix: base_now + 7 * 86400 });
demand(trial_ok.ok and trial_ok.license_type == "trial", "active 14-day trial accepted at day 7");

let trial_exp = SLG.verify_license(trial_tok, vendor_kp.pk_hex, map{ now_unix: base_now + 14 * 86400 });
demand(not trial_exp.ok and trial_exp.status == "license_expired", "expired trial rejected at exact expiration second");

let float_tok = SLG.issue_license(vendor_kp.sk_hex, map{
    product_id: "pblang-studio",
    edition: "enterprise",
    license_type: "floating",
    max_seats: 50,
    issued_at: base_now,
    expires_at: base_now + 86400 * 90
});
let float_ok = SLG.verify_license(float_tok, vendor_kp.pk_hex, map{ now_unix: base_now + 100 });
demand(float_ok.ok and float_ok.license_type == "floating" and float_ok.max_seats == 50, "floating license preserves seat pool count");

// ── 4. Tampering, Keygen Forgery, Clock-Rollback & Offline CRL Attacks ───────

// 4a. Tampered Feature List Attack
let t_parts = str_split(trial_tok, ".");
let t_obj = json_parse(bytes_to_str(SLG.base64url_decode_bytes_strict(t_parts[1])));
t_obj["features"] = ["core", "confidential_reports", "enterprise_admin"];
let forged_feat_b64 = SLG.base64url_encode_bytes(str_to_bytes(SLG.canonical_json_encode(t_obj)));
let tampered_feat_tok = "PBLIC1." + forged_feat_b64 + "." + t_parts[2];
let res_tampered_feat = SLG.verify_license(tampered_feat_tok, vendor_kp.pk_hex, map{ now_unix: base_now + 100 });
demand(not res_tampered_feat.ok and res_tampered_feat.status == "invalid_signature", "tampered feature list rejected by Ed25519");

// 4b. Tampered Expiry Date Attack
let t_obj2 = json_parse(bytes_to_str(SLG.base64url_decode_bytes_strict(t_parts[1])));
t_obj2["expires_at"] = base_now + 86400 * 36500;
let forged_exp_b64 = SLG.base64url_encode_bytes(str_to_bytes(SLG.canonical_json_encode(t_obj2)));
let tampered_exp_tok = "PBLIC1." + forged_exp_b64 + "." + t_parts[2];
let res_tampered_exp = SLG.verify_license(tampered_exp_tok, vendor_kp.pk_hex, map{ now_unix: base_now + 100 });
demand(not res_tampered_exp.ok and res_tampered_exp.status == "invalid_signature", "tampered expiry date rejected by Ed25519");

// 4c. 1-Character Signature Bit-Flip Attack
let orig_sig = t_parts[2];
let first_ch = str_slice(orig_sig, 0, 1);
let flipped_ch = if first_ch == "0" { "1" } else { "0" };
let flipped_sig_tok = "PBLIC1." + t_parts[1] + "." + flipped_ch + str_slice(orig_sig, 1, len(orig_sig));
let res_flipped_sig = SLG.verify_license(flipped_sig_tok, vendor_kp.pk_hex, map{ now_unix: base_now + 100 });
demand(not res_flipped_sig.ok and res_flipped_sig.status == "invalid_signature", "1-nibble signature flip rejected");

// 4d. Wrong Vendor Public Key / Fake Keygen Attack
let keygen_tok = SLG.issue_license(attacker_kp.sk_hex, map{
    product_id: "pblang-studio",
    edition: "enterprise",
    license_type: "perpetual",
    features: ["core", "confidential_reports"]
});
let res_wrong_pk = SLG.verify_license(keygen_tok, vendor_kp.pk_hex, map{ now_unix: base_now + 100 });
demand(not res_wrong_pk.ok and res_wrong_pk.status == "invalid_signature", "attacker keygen token rejected against pinned vendor_pk_hex");

// 4e. Monotonic Anti-Clock-Rollback Guard (`> 300s` backward detection + state MAC)
let clk0 = SLG.check_and_advance_clock_guard(nil, base_now + 50000, vendor_kp.pk_hex);
demand(clk0.ok and not clk0.rollback_detected and clk0.max_seen_unix == base_now + 50000, "clock guard bootstrap ok");

let clk_jitter = SLG.check_and_advance_clock_guard(clk0.state, base_now + 50000 - 180, vendor_kp.pk_hex);
demand(clk_jitter.ok and not clk_jitter.rollback_detected and clk_jitter.max_seen_unix == base_now + 50000, "minor NTP drift <= 300s tolerated without lowering high-water mark");

let clk_advance = SLG.check_and_advance_clock_guard(clk_jitter.state, base_now + 90000, vendor_kp.pk_hex);
demand(clk_advance.ok and clk_advance.max_seen_unix == base_now + 90000, "clock guard advances high-water mark monotonically");

let clk_rollback = SLG.check_and_advance_clock_guard(clk_advance.state, base_now + 90000 - 301, vendor_kp.pk_hex);
demand(not clk_rollback.ok and clk_rollback.rollback_detected and clk_rollback.status == "clock_rollback_detected", "backward clock jump of 301s (> 300s) caught");

// Verify `verify_license` blocks trial extension via system clock rollback!
let res_trial_rollback = SLG.verify_license(trial_tok, vendor_kp.pk_hex, map{
    now_unix: base_now + 1000,
    high_water_state: clk_advance.state
});
demand(not res_trial_rollback.ok and res_trial_rollback.status == "clock_rollback_detected", "verify_license rejects rolled-back system clock");

// Verify tampered high_water_state MAC is caught
let tampered_clk_state = map{
    max_seen_unix: base_now + 100,
    observation_count: clk_advance.state.observation_count,
    guard_mac_hex: clk_advance.state.guard_mac_hex
};
let res_clk_tamper = SLG.check_and_advance_clock_guard(tampered_clk_state, base_now + 200, vendor_kp.pk_hex);
demand(not res_clk_tamper.ok and res_clk_tamper.status == "clock_state_tampered", "tampered high_water_state MAC rejected");

// 4f. Signed Offline CRL (`PBCRL1.`) Verification & Enforcement
let crl_tok = SLG.issue_signed_crl(vendor_kp.sk_hex, map{
    product_id: "pblang-studio",
    sequence: 4,
    issued_at: base_now + 5000,
    revoked_license_ids: ["lic_trial_003", "lic_leaked_999"]
});
let crl_ver = SLG.verify_signed_crl(crl_tok, vendor_kp.pk_hex);
demand(crl_ver.ok and crl_ver.sequence == 4, "offline signed CRL verifies with vendor_pk_hex");

let res_revoked_by_crl = SLG.verify_license(trial_tok, vendor_kp.pk_hex, map{
    now_unix: base_now + 6000,
    crl_token: crl_tok
});
demand(not res_revoked_by_crl.ok and res_revoked_by_crl.status == "license_revoked", "license listed in signed offline CRL is revoked");

let res_unrevoked_with_crl = SLG.verify_license(perp_tok, vendor_kp.pk_hex, map{
    now_unix: base_now + 6000,
    crl_token: crl_tok
});
demand(res_unrevoked_with_crl.ok, "non-revoked license passes signed offline CRL check");

let forged_crl = SLG.issue_signed_crl(attacker_kp.sk_hex, map{
    product_id: "pblang-studio",
    revoked_license_ids: []
});
let res_forged_crl = SLG.verify_license(perp_tok, vendor_kp.pk_hex, map{
    now_unix: base_now + 6000,
    crl_token: forged_crl
});
demand(not res_forged_crl.ok and res_forged_crl.status == "invalid_crl", "attacker-signed CRL fails closed");

// ── 5. Anti-NOP-Patch Key-Gated Feature Vault (Cryptographic Code & Formula Protection) ──

let secret_vault_key = SLG.generate_feature_vault_key();
demand(len(secret_vault_key) == 64, "generated 256-bit feature vault key is 64 hex chars");

let secret_enterprise_sapp = "
// Confidential Enterprise Quantitative Risk & Portfolio Margin Engine
let SECRET_DRIFT_COEFF = 137;
let SECRET_ALPHA_TAG = \"SOVEREIGN_QUANT_VAULT_ACTIVE\";
fn compute_confidential_margin(notional, volatility_bps, tier_factor) {
    let base_margin = num_floor((notional * volatility_bps) / 10000);
    return base_margin * tier_factor + SECRET_DRIFT_COEFF;
}
let computed_margin = compute_confidential_margin(
    vault_inputs.notional,
    vault_inputs.volatility_bps,
    vault_inputs.tier_factor
);
export computed_margin, SECRET_ALPHA_TAG;
";

let sealed_vault = SLG.seal_licensed_feature_vault(secret_enterprise_sapp, "confidential_reports", secret_vault_key);

// Prove `vault_map` contains ONLY the 5 safe public fields and ZERO `feature_key_hex` or plaintext!
let vkeys = array_sort(map_keys(sealed_vault));
demand(len(vkeys) == 5, "sealed vault_map has exact 5 fields");
demand(vkeys[0] == "ciphertext_hex" and vkeys[1] == "feature" and vkeys[2] == "mac_hex" and vkeys[3] == "nonce_hex" and vkeys[4] == "vault_version", "sealed vault_map exact schema without key material");
let vault_serialized = SLG.canonical_json_encode(sealed_vault);
demand(not str_contains(vault_serialized, secret_vault_key), "vault_map never contains feature_key_hex");
demand(not str_contains(vault_serialized, "compute_confidential_margin") and not str_contains(vault_serialized, "SOVEREIGN_QUANT_VAULT_ACTIVE"), "vault ciphertext leaks zero plaintext identifiers");

// High-entropy proof on a 16 KB confidential payload (Shannon entropy ~7.99 bits/byte!)
let large_secret_blob = str_repeat(secret_enterprise_sapp, 40);
let large_vault = SLG.seal_licensed_feature_vault(large_secret_blob, "confidential_reports", secret_vault_key);
// Measure exact byte-level Shannon entropy on raw ciphertext bytes directly
let raw_ct_arr = [];
let ci = 0;
while ci + 1 < len(large_vault.ciphertext_hex) {
    let chunk2 = str_slice(large_vault.ciphertext_hex, ci, ci + 2);
    let b0 = strcharcodeat(chunk2, 0);
    let b1 = strcharcodeat(chunk2, 1);
    let nib0 = if b0 >= 97 { b0 - 87 } else { b0 - 48 };
    let nib1 = if b1 >= 97 { b1 - 87 } else { b1 - 48 };
    array_push(raw_ct_arr, nib0 * 16 + nib1);
    ci = ci + 2;
}
let ct_entropy = SLG.shannon_entropy_bits(raw_ct_arr);
demand(ct_entropy > 7.95 and ct_entropy <= 8.0, "encrypted vault ciphertext has near-ideal random Shannon entropy (~7.99 bits/byte), got " + str(ct_entropy));

// Attack 1: Binary cracker NOP-patches boolean checks and passes `ok: true` with empty keys
let nop_patched_empty = map{
    ok: true,
    status: "valid",
    features: ["confidential_reports"],
    unlocked_keys: map{}
};
let unlock_nop1 = SLG.unlock_licensed_feature_vault(sealed_vault, nop_patched_empty, "confidential_reports");
demand(not unlock_nop1.ok and unlock_nop1.status == "missing_feature_key", "NOP-patched boolean bypass without cryptographic key fails");
let exec_nop1 = SLG.execute_licensed_sapp_vault(sealed_vault, nop_patched_empty, "confidential_reports", map{ notional: 100, volatility_bps: 100, tier_factor: 1 });
demand(not exec_nop1.ok and exec_nop1.status == "missing_feature_key", "execute_licensed_sapp_vault blocks NOP-patched empty license");

// Attack 2: Binary cracker NOP-patches boolean checks AND injects a forged/guessed 256-bit key
let forged_key_hex = "deadbeefcafebabe0123456789abcdefdeadbeefcafebabe0123456789abcdef";
let nop_patched_forged = map{
    ok: true,
    status: "valid",
    features: ["confidential_reports"],
    unlocked_keys: map{ "confidential_reports": forged_key_hex }
};
let unlock_nop2 = SLG.unlock_licensed_feature_vault(sealed_vault, nop_patched_forged, "confidential_reports");
demand(not unlock_nop2.ok and unlock_nop2.status == "vault_mac_mismatch", "NOP-patched bypass with forged key rejected by ChaCha20-Poly1305/HMAC");

// Even if the cracker ALSO NOP-patches the MAC check in `unlock_licensed_feature_vault` and forces raw ChaCha20 XOR:
let cracker_wrong_stream = SLG.chacha20_stream_xor(raw_ct_arr, range(0, 32), range(0, 12), 1);
let wrong_stream_entropy = SLG.shannon_entropy_bits(cracker_wrong_stream);
demand(wrong_stream_entropy > 7.95, "forced raw decryption without vendor key yields pure random noise (~7.99 bits/byte)");

// Attack 3: Genuine Trial customer license (valid Ed25519 signature, but lacks `confidential_reports` key)
let unlock_from_trial = SLG.unlock_licensed_feature_vault(sealed_vault, trial_ok, "confidential_reports");
demand(not unlock_from_trial.ok and unlock_from_trial.status == "missing_feature_key", "trial license without feature key cannot unlock enterprise vault");

// Legitimate Enterprise License Carrying Wrapped `feature_keys`
let ent_keyed_tok = SLG.issue_license(vendor_kp.sk_hex, map{
    license_id: "lic_ent_vault_777",
    product_id: "pblang-studio",
    edition: "enterprise",
    license_type: "subscription",
    features: ["core", "confidential_reports"],
    issued_at: base_now,
    expires_at: base_now + 86400 * 365,
    seat_id: seat_app_a1,
    feature_keys: map{
        "confidential_reports": secret_vault_key
    }
});

// Ensure raw `secret_vault_key` is AEAD-wrapped inside the token (not visible in raw Base64URL JSON!)
let ent_parts = str_split(ent_keyed_tok, ".");
let raw_tok_json = bytes_to_str(SLG.base64url_decode_bytes_strict(ent_parts[1]));
demand(not str_contains(raw_tok_json, secret_vault_key), "feature_key_hex is AEAD-wrapped inside token, never plaintext");

// Wrong machine cannot unwrap node-locked feature keys
let ent_wrong_machine = SLG.verify_license(ent_keyed_tok, vendor_kp.pk_hex, map{
    expected_product_id: "pblang-studio",
    now_unix: base_now + 500,
    seat_id: seat_other_hw
});
demand(not ent_wrong_machine.ok and len(map_keys(ent_wrong_machine.unlocked_keys)) == 0, "wrong machine gets zero unlocked_keys");

// Valid Enterprise customer on licensed seat unlocks AND executes the confidential `.sapp` formula in-memory!
let ent_verified = SLG.verify_license(ent_keyed_tok, vendor_kp.pk_hex, map{
    expected_product_id: "pblang-studio",
    now_unix: base_now + 500,
    seat_id: seat_app_a1
});
demand(ent_verified.ok and ent_verified.unlocked_keys["confidential_reports"] == secret_vault_key, "valid enterprise license unwraps exact 256-bit feature key");

let unlocked_res = SLG.unlock_licensed_feature_vault(sealed_vault, ent_verified, "confidential_reports");
demand(unlocked_res.ok and unlocked_res.plaintext_str == secret_enterprise_sapp, "enterprise vault decrypts byte-for-byte identical .sapp source");

let exec_res = SLG.execute_licensed_sapp_vault(
    sealed_vault,
    ent_verified,
    "confidential_reports",
    map{ notional: 250000, volatility_bps: 420, tier_factor: 3 }
);
// Expected: floor((250000 * 420) / 10000) * 3 + 137 = 10500 * 3 + 137 = 31637
demand(exec_res.ok and exec_res.status == "executed", "execute_licensed_sapp_vault runs unlocked .sapp module in memory");
demand(exec_res.exports.computed_margin == 31637, "unlocked confidential enterprise formula computes exact result 31637");
demand(exec_res.exports.SECRET_ALPHA_TAG == "SOVEREIGN_QUANT_VAULT_ACTIVE", "unlocked module exports confidential constant");

// Tampering 1 character in `sealed_vault.ciphertext_hex` causes immediate MAC rejection
let orig_ct = sealed_vault.ciphertext_hex;
let c0 = str_slice(orig_ct, 0, 1);
let c0_flip = if c0 == "a" { "b" } else { "a" };
let tampered_vault = map{
    vault_version: 1,
    feature: "confidential_reports",
    nonce_hex: sealed_vault.nonce_hex,
    ciphertext_hex: c0_flip + str_slice(orig_ct, 1, len(orig_ct)),
    mac_hex: sealed_vault.mac_hex
};
let tampered_unlock = SLG.unlock_licensed_feature_vault(tampered_vault, ent_verified, "confidential_reports");
demand(not tampered_unlock.ok and tampered_unlock.status == "vault_mac_mismatch", "1-nibble vault ciphertext tamper rejected");

// Evaluation license model + strict lowercase hex signature malleability guard
let eval_tok = SLG.issue_license(vendor_kp.sk_hex, map{
    product_id: "pblang-studio",
    edition: "standard",
    license_type: "evaluation",
    issued_at: base_now,
    expires_at: base_now + 3600
});
let eval_ver = SLG.verify_license(eval_tok, vendor_kp.pk_hex, map{ now_unix: base_now + 60 });
demand(eval_ver.ok and eval_ver.license_type == "evaluation", "evaluation license model supported");
let upper_sig_tok = "PBLIC1." + ent_parts[1] + "." + str_upper(ent_parts[2]);
demand(not SLG.verify_license(upper_sig_tok, vendor_kp.pk_hex, map{ now_unix: base_now + 500, seat_id: seat_app_a1 }).ok, "non-canonical uppercase signature hex rejected");

// ── 6. Zero-CDN Offline Web / PWA License Gate Snippet Verification ──────────

let web_snippet = SLG.generate_web_license_gate_snippet(vendor_kp.pk_hex, "PBLang Pro <PWA>");
demand(str_contains(web_snippet, vendor_kp.pk_hex), "web snippet embeds vendor_pk_hex");
demand(not str_contains(web_snippet, vendor_kp.sk_hex), "web snippet never embeds vendor_sk_hex");
demand(str_contains(web_snippet, "PBLang Pro &lt;PWA&gt;"), "web snippet HTML-escapes product title against XSS");
demand(str_contains(web_snippet, "crypto.subtle.importKey") and str_contains(web_snippet, "Ed25519"), "web snippet uses offline WebCrypto Ed25519 verification");
demand(not str_contains(web_snippet, "http:") and not str_contains(web_snippet, "https:") and not str_contains(web_snippet, "fetch(") and not str_contains(web_snippet, "sendBeacon"), "web snippet has zero CDN links and zero network calls");

print "PASS v41_sovereign_license_guard_test.sapp — " + str(assertions) + " assertions verified (0 telemetry, 0 PII)";
