// tests/quantum_heron_isa_test.sapp — IBM Quantum Heron r2 (156q) Native Hardware ISA
// Transpiler, Exact Unitary Equivalence Verifier & SamplerV2 Fidelity Verification Suite (v3.0.0)

let QC = import("stdlib:quantum_computing.sapp");

let _PI = 3.14159265358979323846;
let total_checks = 0;
let passed_checks = 0;

fn check(cond, label) {
    total_checks = total_checks + 1;
    if not cond {
        throw "FAIL [" + label + "]";
    }
    passed_checks = passed_checks + 1;
}

fn assert_heron_qasm_strict(qasm_str, expected_n_qubits, label) {
    check(str_starts_with(qasm_str, "OPENQASM 3.0;\ninclude \"stdgates.inc\";\nbit[" + str(expected_n_qubits) + "] c;\n"),
        label + ": exact Heron r2 ISA OpenQASM 3.0 header");
    check(not str_contains(qasm_str, "qubit["), label + ": forbids virtual qubit[] declaration");
    check(not str_contains(qasm_str, "\nh "), label + ": forbids non-ISA h gate");
    check(not str_contains(qasm_str, "\ncx "), label + ": forbids non-ISA cx gate");
    check(not str_contains(qasm_str, "\ny "), label + ": forbids non-ISA y gate");
    check(not str_contains(qasm_str, "\nz "), label + ": forbids non-ISA z gate");
    check(not str_contains(qasm_str, "\ns "), label + ": forbids non-ISA s gate");
    check(not str_contains(qasm_str, "\nt "), label + ": forbids non-ISA t gate");
    check(not str_contains(qasm_str, "\nrx("), label + ": forbids non-ISA rx gate");
    check(not str_contains(qasm_str, "\nry("), label + ": forbids non-ISA ry gate");
    check(not str_contains(qasm_str, "\nccx "), label + ": forbids non-ISA ccx gate");
    check(not str_contains(qasm_str, "ctrl("), label + ": forbids non-ISA mcz gate");
    check(str_contains(qasm_str, "c[0] = measure $"), label + ": emits physical qubit measurement");
}

// ── 1. Native sx, sdg, tdg, swap Simulator & OpenQASM 3.0 Identities ────────
let sx1 = QC.new_circuit(1);
QC.sx(sx1, 0);
let sv_sx1 = QC.run_statevector(sx1).amplitudes;
check(num_abs(sv_sx1[0][0] - 0.5) < 0.000000000001 and num_abs(sv_sx1[0][1] - 0.5) < 0.000000000001,
    "sx|0> amplitude[0] == 0.5 + 0.5i");
check(num_abs(sv_sx1[1][0] - 0.5) < 0.000000000001 and num_abs(sv_sx1[1][1] + 0.5) < 0.000000000001,
    "sx|0> amplitude[1] == 0.5 - 0.5i");

let sx2 = QC.new_circuit(1);
QC.sx(sx2, 0);
QC.sx(sx2, 0);
let p_sx2 = QC.probabilities(sx2);
check(num_abs(p_sx2.by_bitstring["1"] - 1.0) < 0.000000000001, "sx * sx |0> -> |1> with P == 1.000000000000");

// Verify sx * sx == x on arbitrary complex superposition (|0> + 2i|1>)/sqrt(5)
let theta_prep = 2.0 * num_atan2(2.0, 1.0);
let sup_x = QC.new_circuit(1);
QC.ry(sup_x, 0, theta_prep);
QC.s(sup_x, 0);
QC.x(sup_x, 0);

let sup_sxsx = QC.new_circuit(1);
QC.ry(sup_sxsx, 0, theta_prep);
QC.s(sup_sxsx, 0);
QC.sx(sup_sxsx, 0);
QC.sx(sup_sxsx, 0);
let sv_x_ref = QC.run_statevector(sup_x).amplitudes;
let sv_sxsx_ref = QC.run_statevector(sup_sxsx).amplitudes;
check(num_abs(sv_x_ref[0][0] - sv_sxsx_ref[0][0]) < 0.000000000001 and
      num_abs(sv_x_ref[0][1] - sv_sxsx_ref[0][1]) < 0.000000000001 and
      num_abs(sv_x_ref[1][0] - sv_sxsx_ref[1][0]) < 0.000000000001 and
      num_abs(sv_x_ref[1][1] - sv_sxsx_ref[1][1]) < 0.000000000001,
      "sx * sx equals x identically in complex amplitude & phase");

// Verify sdg & tdg dagger identities (S * Sdg = I, T * Tdg = I, Tdg^2 = Sdg)
let dag_qc = QC.new_circuit(1);
QC.ry(dag_qc, 0, 0.91);
QC.s(dag_qc, 0);
QC.sdg(dag_qc, 0);
QC.t(dag_qc, 0);
QC.tdg(dag_qc, 0);
let ref_ry = QC.new_circuit(1);
QC.ry(ref_ry, 0, 0.91);
let eq_dag = QC.verify_isa_equivalence(ref_ry, QC.transpile_to_heron_isa(dag_qc));
check(eq_dag.ok and eq_dag.fidelity > 0.999999999999, "S*Sdg == I and T*Tdg == I exact");

let tdg2_qc = QC.new_circuit(1);
QC.h(tdg2_qc, 0);
QC.tdg(tdg2_qc, 0);
QC.tdg(tdg2_qc, 0);
let sdg1_qc = QC.new_circuit(1);
QC.h(sdg1_qc, 0);
QC.sdg(sdg1_qc, 0);
let eq_tdg2 = QC.verify_isa_equivalence(sdg1_qc, QC.transpile_to_heron_isa(tdg2_qc));
check(eq_tdg2.ok and eq_tdg2.fidelity > 0.999999999999, "Tdg * Tdg == Sdg exact");

// Verify swap gate & OpenQASM 3.0 emission for sx, sdg, tdg, swap
let sw_qc = QC.new_circuit(3);
QC.x(sw_qc, 0);
QC.sx(sw_qc, 1);
QC.sdg(sw_qc, 1);
QC.tdg(sw_qc, 2);
QC.swap(sw_qc, 0, 2);
let sw_qasm = QC.to_openqasm3(sw_qc);
check(str_contains(sw_qasm, "sx q[1];") and str_contains(sw_qasm, "sdg q[1];") and
      str_contains(sw_qasm, "tdg q[2];") and str_contains(sw_qasm, "swap q[0], q[2];"),
      "to_openqasm3 serializes sx, sdg, tdg, swap");

let sw_test = QC.new_circuit(3);
QC.x(sw_test, 0);
QC.swap(sw_test, 0, 2);
check(num_abs(QC.probabilities(sw_test).by_bitstring["001"] - 1.0) < 0.000000000001, "swap(0, 2) maps |100> -> |001>");

// ── 2. Exact Unitary Equivalence of Heron r2 ISA Transpiler ─────────────────

// 2A. Single-qubit rx(0.73), ry(-1.19), rz(0.41), and y on (|0> + 2i|1>)/sqrt(5)
let rx_orig = QC.new_circuit(1);
QC.ry(rx_orig, 0, theta_prep);
QC.s(rx_orig, 0);
QC.rx(rx_orig, 0, 0.73);
let rx_isa = QC.transpile_to_heron_isa(rx_orig);
let rx_eq = QC.verify_isa_equivalence(rx_orig, rx_isa);
check(rx_eq.ok and num_abs(rx_eq.fidelity - 1.0) < 0.000000000001,
    "rx(0.73) on (|0>+2i|1>)/sqrt(5) Heron ISA fidelity == 1.000000000000");

let ry_orig = QC.new_circuit(1);
QC.ry(ry_orig, 0, theta_prep);
QC.s(ry_orig, 0);
QC.ry(ry_orig, 0, 0.0 - 1.19);
let ry_isa = QC.transpile_to_heron_isa(ry_orig);
let ry_eq = QC.verify_isa_equivalence(ry_orig, ry_isa);
check(ry_eq.ok and num_abs(ry_eq.fidelity - 1.0) < 0.000000000001,
    "ry(-1.19) on (|0>+2i|1>)/sqrt(5) Heron ISA fidelity == 1.000000000000");

let y_orig = QC.new_circuit(1);
QC.h(y_orig, 0);
QC.y(y_orig, 0);
let y_isa = QC.transpile_to_heron_isa(y_orig);
let y_eq = QC.verify_isa_equivalence(y_orig, y_isa);
check(y_eq.ok and num_abs(y_eq.fidelity - 1.0) < 0.000000000001,
    "y on superposition Heron ISA fidelity == 1.000000000000");

let euler_orig = QC.new_circuit(2);
QC.rx(euler_orig, 0, 0.73);
QC.ry(euler_orig, 0, 0.0 - 1.19);
QC.rz(euler_orig, 0, 0.41);
QC.y(euler_orig, 1);
QC.cnot(euler_orig, 0, 1);
QC.sdg(euler_orig, 0);
QC.tdg(euler_orig, 1);
QC.rx(euler_orig, 1, 0.0 - 0.67);
QC.ry(euler_orig, 0, 1.43);
let euler_isa = QC.transpile_to_heron_isa(euler_orig);
let euler_eq = QC.verify_isa_equivalence(euler_orig, euler_isa);
check(euler_eq.ok and euler_eq.fidelity > 0.999999999999,
    "Entangled arbitrary Euler rx(0.73)+ry(-1.19)+rz(0.41)+y+sdg+tdg Heron ISA fidelity == 1.0");

// 2B. Adjacent RZ fusion & < 1e-12 zero-angle elimination
let rz_merge_qc = QC.new_circuit(1);
QC.rz(rz_merge_qc, 0, 0.35);
QC.rz(rz_merge_qc, 0, 0.45);
let rz_merged_isa = QC.transpile_to_heron_isa(rz_merge_qc);
check(rz_merged_isa.gate_counts.total == 1 and rz_merged_isa.gate_counts.rz == 1 and
      num_abs(rz_merged_isa.gates[0].params[0] - 0.80) < 0.000000000001,
      "Adjacent rz(0.35) + rz(0.45) merges into single rz(0.80)");

let rz_cancel_qc = QC.new_circuit(1);
QC.rz(rz_cancel_qc, 0, _PI * 0.75);
QC.rz(rz_cancel_qc, 0, 0.0 - _PI * 0.75);
let rz_cancel_isa = QC.transpile_to_heron_isa(rz_cancel_qc);
check(rz_cancel_isa.gate_counts.total == 0, "Cancelling rz rotations drop below 1e-12 threshold to 0 physical gates");

// 2C. Bell state |Phi+> = (|00> + |11>)/sqrt(2)
let bell = QC.new_circuit(2);
QC.h(bell, 0);
QC.cnot(bell, 0, 1);
let bell_isa = QC.transpile_to_heron_isa(bell);
let bell_eq = QC.verify_isa_equivalence(bell, bell_isa);
check(bell_eq.ok and bell_eq.fidelity > 0.999999999999 and bell_isa.gate_counts.cz == 1,
    "Bell state Heron ISA equivalence F == 1.0 with 1 physical cz");
let bell_isa_qasm = QC.to_ibm_heron_isa_qasm3(bell);
assert_heron_qasm_strict(bell_isa_qasm, 2, "Bell ISA QASM3");
check(str_contains(bell_isa_qasm, "cz $0, $1;") and str_contains(bell_isa_qasm, "c[1] = measure $1;"),
    "Bell ISA QASM3 uses physical $0, $1 couplers");

// 2D. 3-Qubit GHZ (|000> + |111>)/sqrt(2) + custom physical layout [4, 5, 6]
let ghz3 = QC.new_circuit(3);
QC.h(ghz3, 0);
QC.cnot(ghz3, 0, 1);
QC.cnot(ghz3, 1, 2);
let ghz3_isa = QC.transpile_to_heron_isa(ghz3, [4, 5, 6]);
let ghz3_eq = QC.verify_isa_equivalence(ghz3, ghz3_isa);
check(ghz3_eq.ok and ghz3_eq.fidelity > 0.999999999999 and ghz3_isa.gate_counts.cz == 2,
    "3-qubit GHZ Heron ISA equivalence F == 1.0 with 2 physical cz gates");
let ghz3_qasm = QC.to_ibm_heron_isa_qasm3(ghz3, [4, 5, 6]);
assert_heron_qasm_strict(ghz3_qasm, 3, "GHZ3 ISA QASM3");
check(str_contains(ghz3_qasm, "cz $4, $5;") and str_contains(ghz3_qasm, "cz $5, $6;") and
      str_contains(ghz3_qasm, "c[2] = measure $6;"),
      "GHZ3 custom Heron physical layout $4-$5-$6");

// 2E. 4-Qubit Non-Adjacent CNOT(0, 3), CNOT(3, 0) & SWAP(0, 3) Linear Coupling Routing
let nonadj = QC.new_circuit(4);
QC.ry(nonadj, 0, 1.11);
QC.rx(nonadj, 1, 0.57);
QC.ry(nonadj, 2, 0.0 - 0.83);
QC.rz(nonadj, 3, 0.29);
QC.cnot(nonadj, 0, 3);
QC.cz(nonadj, 3, 0);
QC.swap(nonadj, 0, 3);
let nonadj_isa = QC.transpile_to_heron_isa(nonadj);
let nonadj_eq = QC.verify_isa_equivalence(nonadj, nonadj_isa);
check(nonadj_eq.ok and nonadj_eq.routing_ok and nonadj_eq.basis_ok and nonadj_eq.fidelity > 0.999999999999,
    "4-qubit non-adjacent CNOT(0,3)+CZ(3,0)+SWAP(0,3) SWAP-routed on adjacent couplers with F == 1.0");
assert_heron_qasm_strict(QC.to_ibm_heron_isa_qasm3(nonadj_isa), 4, "4q non-adjacent SWAP-routed QASM3");

// 2F. Toffoli (ccx) on entangled complex state (including non-adjacent controls)
let tof = QC.new_circuit(4);
QC.ry(tof, 0, 1.23);
QC.rx(tof, 1, 0.0 - 0.94);
QC.ry(tof, 2, 0.68);
QC.h(tof, 3);
QC.toffoli(tof, 0, 3, 1);
let tof_isa = QC.transpile_to_heron_isa(tof);
let tof_eq = QC.verify_isa_equivalence(tof, tof_isa);
check(tof_eq.ok and tof_eq.fidelity > 0.999999999999,
    "Non-adjacent Toffoli ccx(0, 3, 1) Heron ISA equivalence F == 1.0");

// 2G. 3-Qubit & 4-Qubit Grover Search (exercises multi-controlled Z / mcz)
let grov3 = QC.grover_search(3, 5);
let grov3_isa = QC.transpile_to_heron_isa(grov3.circuit);
let grov3_eq = QC.verify_isa_equivalence(grov3.circuit, grov3_isa);
check(grov3_eq.ok and grov3_eq.fidelity > 0.999999999999,
    "3-qubit Grover search circuit Heron ISA equivalence F == 1.0");
let grov3_isa_probs = QC.probabilities(grov3_isa);
check(num_abs(grov3_isa_probs.by_bitstring["101"] - grov3.target_probability) < 0.000000000001,
    "3-qubit Grover ISA circuit preserves exact 121/128 target probability on |101>");
assert_heron_qasm_strict(QC.to_ibm_heron_isa_qasm3(grov3_isa), 3, "Grover 3q ISA QASM3");

let grov4 = QC.grover_search(4, 11);
let grov4_isa = QC.transpile_to_heron_isa(grov4.circuit);
let grov4_eq = QC.verify_isa_equivalence(grov4.circuit, grov4_isa);
check(grov4_eq.ok and grov4_eq.fidelity > 0.999999999999,
    "4-qubit Grover search (ancilla-free 3-control mcz) Heron ISA equivalence F == 1.0");

// 2H. Full 156-Qubit Heron r2 Scale Circuit Transpilation ($0 .. $155)
let qc156 = QC.new_circuit(156);
QC.h(qc156, 0);
let q_idx = 0;
while q_idx < 155 {
    QC.cnot(qc156, q_idx, q_idx + 1);
    q_idx = q_idx + 1;
}
let isa156 = QC.transpile_to_heron_isa(qc156);
let qasm156 = QC.to_ibm_heron_isa_qasm3(isa156);
assert_heron_qasm_strict(qasm156, 156, "156-qubit Heron r2 full-chip GHZ");
check(isa156.gate_counts.cz == 155 and str_contains(qasm156, "c[155] = measure $155;"),
    "156-qubit Heron r2 GHZ transpiles cleanly to 155 adjacent physical cz gates ($0..$155)");

// ── 3. SamplerV2 Hex Samples / Counts Parser, Hellinger Fidelity & QPU Client ──

// 3A. SamplerV2 hex-samples array ["0x0", "0x7", "0x7", ...] on 3-qubit GHZ
let mock_ghz_samples_json = json_stringify(map{
    results: [
        map{
            data: map{
                c: map{
                    samples: ["0x0", "0x7", "0x7", "0x0", "0x7", "0x0", "0x0", "0x7"],
                    num_bits: 3
                }
            },
            metadata: map{ shots: 8 }
        }
    ]
});
let parsed_samps = QC.parse_sampler_v2_results(mock_ghz_samples_json, 3);
check(parsed_samps.ok and parsed_samps.total_shots == 8 and
      parsed_samps.counts["000"] == 4 and parsed_samps.counts["111"] == 4,
      "SamplerV2 hex-samples ['0x0', '0x7', ...] decoded to canonical {'000': 4, '111': 4}");
let ghz_fid = QC.compute_quantum_fidelity(QC.probabilities(ghz3), parsed_samps.counts);
check(num_abs(ghz_fid - 1.0) < 0.000000000001, "Exact 50/50 GHZ SamplerV2 Hellinger fidelity == 1.0");

// 3B. Asymmetric qubit endianness check: `x $0; c[0] = measure $0;` yields "0x1" in IBM SamplerV2
let asym_qc = QC.new_circuit(3);
QC.x(asym_qc, 0);
let mock_asym = QC.parse_sampler_v2_results(map{
    results: [map{ data: map{ c: map{ samples: ["0x1", "0x1", "0x1", "0x1"], num_bits: 3 } } }]
}, 3);
check(mock_asym.counts["100"] == 4 and num_abs(QC.compute_quantum_fidelity(QC.probabilities(asym_qc), mock_asym) - 1.0) < 0.000000000001,
    "IBM SamplerV2 clbit c[0]=LSB ('0x1') maps to q[0]=1 ('100') matching statevector bit order");

// 3C. SamplerV2 hex-counts map {"0x0": 510, "0x3": 514} on 2-qubit Bell state
let mock_bell_counts = map{
    results: [
        map{
            data: map{
                c: map{
                    counts: map{ "0x0": 510, "0x3": 514 },
                    num_bits: 2
                }
            }
        }
    ]
};
let parsed_bell_counts = QC.parse_sampler_v2_results(mock_bell_counts, 2);
check(parsed_bell_counts.ok and parsed_bell_counts.total_shots == 1024 and
      parsed_bell_counts.counts["00"] == 510 and parsed_bell_counts.counts["11"] == 514,
      "SamplerV2 hex-counts {'0x0': 510, '0x3': 514} decoded to {'00': 510, '11': 514}");

let bell_fid = QC.compute_quantum_fidelity(QC.probabilities(bell).by_bitstring, parsed_bell_counts.counts);
let expected_bc = num_sqrt(0.5 * (510.0 / 1024.0)) + num_sqrt(0.5 * (514.0 / 1024.0));
let expected_fid = expected_bc * expected_bc;
check(num_abs(bell_fid - expected_fid) < 0.000000000001 and bell_fid > 0.99999,
    "Bell Hellinger fidelity matches exact analytical Bhattacharyya^2 formula");

// 3D. 156-qubit SamplerV2 hex sample decoding without integer overflow
let hex156_all_ones = "0x" + str_repeat("f", 39);
let parsed_156 = QC.parse_sampler_v2_results(map{
    results: [map{ data: map{ c: map{ samples: ["0x0", hex156_all_ones], num_bits: 156 } } }]
}, 156);
check(parsed_156.counts[str_repeat("0", 156)] == 1 and parsed_156.counts[str_repeat("1", 156)] == 1,
    "156-qubit Heron r2 SamplerV2 hex string decoded losslessly without integer overflow");

// 3E. IAM Bearer passthrough & OPSEC / Fallback checks when env credentials unset
let direct_jwt = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.synthetic_unit_test_payload";
check(QC.exchange_ibm_iam_token(direct_jwt) == direct_jwt, "Direct Bearer JWT token bypasses IAM exchange cleanly");

let b_list = QC.list_ibm_quantum_backends();
check((not b_list.ok) and b_list.mode == "missing_ibm_token", "list_ibm_quantum_backends honest fallback in unit test");

let b_info = QC.get_ibm_backend_info("ibm_fez");
check((not b_info.ok) and b_info.mode == "missing_ibm_token" and b_info.name == "ibm_fez",
    "get_ibm_backend_info honest fallback in unit test");

let sub_fb = QC.submit_ibm_quantum_qpu(bell, "ibm_fez", 1024);
check(sub_fb.ok and (not sub_fb.qpu_submitted) and sub_fb.mode == "local_statevector_fallback_missing_ibm_token" and
      str_contains(sub_fb.openqasm3_isa, "cz $0, $1;"),
      "submit_ibm_quantum_qpu default ibm_fez fallback includes Heron ISA OpenQASM3");

let wait_fb = QC.run_and_wait_ibm_qpu(bell, "ibm_fez", 1024, 5);
check((not wait_fb.ok) and wait_fb.status == "MISSING_CREDENTIALS" and wait_fb.isa_gate_counts.cz == 1,
    "run_and_wait_ibm_qpu honest fallback when credentials absent");

// ── 4. European QuTech Quantum Inspire 2.0 (`cQASM 3.0` + `Tuna-17` 17q QPU) ─

let t17_topo = QC.tuna17_topology();
check(t17_topo.name == "Tuna-17" and t17_topo.backend_type_id == 7 and
      t17_topo.n_qubits == 17 and t17_topo.n_couplers == 24 and
      len(t17_topo.hamiltonian_path_17) == 17,
      "Tuna-17 topology metadata exposes 17 transmon qubits, 24 couplers, and 17-qubit Hamiltonian path");

fn tuna17_edge_exists(u, v) {
    let edges = t17_topo.undirected_edges;
    let lo = if u < v { u } else { v };
    let hi = if u < v { v } else { u };
    let i = 0;
    while i < len(edges) {
        if edges[i][0] == lo and edges[i][1] == hi {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn assert_tuna17_cqasm_strict(cqasm_text, label) {
    check(str_starts_with(cqasm_text, "version 3.0\n"), label + ": starts with cQASM 3.0 header");
    check((not str_contains(cqasm_text, "CNOT ")) and (not str_contains(cqasm_text, "SWAP ")),
        label + ": contains zero uncompiled CNOT/SWAP gates");
    let lines = str_split(cqasm_text, "\n");
    let all_couplers_ok = true;
    let cz_seen = 0;
    let i = 0;
    while i < len(lines) {
        let ln = str_trim(lines[i]);
        if str_starts_with(ln, "CZ ") {
            cz_seen = cz_seen + 1;
            // Format: CZ q[u], q[v]
            let comma = str_index_of(ln, ",");
            let lb1 = str_index_of(ln, "[");
            let rb1 = str_index_of(ln, "]");
            let right_part = str_slice(ln, comma + 1, len(ln));
            let lb2 = str_index_of(right_part, "[");
            let rb2 = str_index_of(right_part, "]");
            let u = json_parse(str_slice(ln, lb1 + 1, rb1));
            let v = json_parse(str_slice(right_part, lb2 + 1, rb2));
            if not tuna17_edge_exists(u, v) {
                all_couplers_ok = false;
            }
        }
        i = i + 1;
    }
    check(all_couplers_ok and cz_seen > 0, label + ": every CZ lies on a physical Tuna-17 coupler edge");
}

// 4A. Generic cQASM 3.0 emission (QX emulator mode)
let cqasm_gate_qc = QC.new_circuit(3);
QC.h(cqasm_gate_qc, 0);
QC.sx(cqasm_gate_qc, 1);
QC.sdg(cqasm_gate_qc, 1);
QC.tdg(cqasm_gate_qc, 2);
QC.rx(cqasm_gate_qc, 0, 0.0);
QC.rz(cqasm_gate_qc, 2, 0.5);
QC.cnot(cqasm_gate_qc, 0, 1);
QC.swap(cqasm_gate_qc, 1, 2);
let cqasm_qx = QC.to_cqasm3(cqasm_gate_qc);
check(str_contains(cqasm_qx, "version 3.0") and
      str_contains(cqasm_qx, "qubit[3] q") and
      str_contains(cqasm_qx, "bit[3] b") and
      str_contains(cqasm_qx, "X90 q[1]") and
      str_contains(cqasm_qx, "Sdag q[1]") and
      str_contains(cqasm_qx, "Tdag q[2]") and
      str_contains(cqasm_qx, "Rx(0.0) q[0]") and
      str_contains(cqasm_qx, "CNOT q[0], q[1]") and
      str_contains(cqasm_qx, "SWAP q[1], q[2]") and
      str_contains(cqasm_qx, "b = measure q"),
      "Generic to_cqasm3 emits valid cQASM 3.0 gates, float literals, and whole-register measure");

// 4B. Tuna-17 3-qubit GHZ on connected physical qubits [0, 1, 4]
let t17_ghz3 = QC.transpile_to_tuna17(ghz3, [0, 1, 4]);
let t17_ghz3_eq = QC.verify_tuna17_equivalence(ghz3, t17_ghz3);
check(t17_ghz3.topology_valid and t17_ghz3_eq.ok and
      t17_ghz3.gate_counts.cz == 2 and t17_ghz3.gate_counts.single_qubit == 5,
      "3-qubit GHZ on Tuna-17 [0, 1, 4] compiles to 2 CZ + 5 H with exact unitary fidelity 1.0");
let cqasm_t17_ghz3 = QC.to_cqasm3(t17_ghz3, map{ tuna17: true });
assert_tuna17_cqasm_strict(cqasm_t17_ghz3, "Tuna-17 GHZ-3 [0, 1, 4]");
check(str_contains(cqasm_t17_ghz3, "qubit[17] q") and
      str_contains(cqasm_t17_ghz3, "CZ q[0], q[1]") and
      str_contains(cqasm_t17_ghz3, "CZ q[1], q[4]") and
      str_contains(cqasm_t17_ghz3, "b[0] = measure q[0]") and
      str_contains(cqasm_t17_ghz3, "b[1] = measure q[1]") and
      str_contains(cqasm_t17_ghz3, "b[4] = measure q[4]"),
      "Tuna-17 cQASM 3.0 emits 17q register and indexed measurements on physical qubits [0, 1, 4]");

// 4C. Diamond plaquette [0, 1, 4, 2] + non-adjacent CNOT(1, 2) BFS coupler routing
let plaq_qc = QC.new_circuit(4);
QC.h(plaq_qc, 0);
QC.cnot(plaq_qc, 0, 1); // [0,1] direct coupler
QC.cnot(plaq_qc, 0, 3); // [0,2] direct coupler!
QC.cnot(plaq_qc, 1, 3); // [1,2] NOT direct -> BFS SWAP via q[0] or q[4]!
QC.rz(plaq_qc, 2, 0.37);
QC.cnot(plaq_qc, 2, 3); // [4,2] direct coupler!
let t17_plaq = QC.transpile_to_tuna17(plaq_qc, [0, 1, 4, 2]);
let t17_plaq_eq = QC.verify_tuna17_equivalence(plaq_qc, t17_plaq);
check(t17_plaq.topology_valid and t17_plaq_eq.ok and num_abs(t17_plaq_eq.fidelity - 1.0) < 0.0000000001,
    "4-qubit diamond plaquette [0, 1, 4, 2] routes non-adjacent CNOT(1, 2) with fidelity 1.0");
assert_tuna17_cqasm_strict(QC.to_cqasm3(t17_plaq, map{ tuna17: true }), "Tuna-17 diamond plaquette [0, 1, 4, 2]");

// 4D. Multi-hop BFS SWAP routing CNOT(0, 3) across [0, 1, 4, 7] + Toffoli + 4-qubit Grover
let hop_qc = QC.new_circuit(4);
QC.h(hop_qc, 0);
QC.ry(hop_qc, 1, 0.61);
QC.rx(hop_qc, 2, 0.0 - 0.44);
QC.cnot(hop_qc, 0, 3);
QC.toffoli(hop_qc, 0, 2, 3);
let t17_hop = QC.transpile_to_tuna17(hop_qc);
let t17_hop_eq = QC.verify_tuna17_equivalence(hop_qc, t17_hop);
check(t17_hop.topology_valid and t17_hop_eq.ok,
    "Multi-hop CNOT(0, 3) + Toffoli on Tuna-17 [0, 1, 4, 7] verified exact unitary equivalence");

let qi_grover4 = QC.grover_search(4, 11).circuit;
let t17_grover4 = QC.transpile_to_tuna17(qi_grover4);
let t17_grover4_eq = QC.verify_tuna17_equivalence(qi_grover4, t17_grover4);
check(t17_grover4.topology_valid and t17_grover4_eq.ok,
    "4-qubit Grover search circuit transpiles to Tuna-17 couplers with fidelity 1.0");
assert_tuna17_cqasm_strict(QC.to_cqasm3(t17_grover4, map{ tuna17: true }), "Tuna-17 4-qubit Grover");

// 4E. Disconnected custom physical subset [0, 16] auto-bridged across Tuna-17 couplers
let t17_disc = QC.transpile_to_tuna17(bell, [0, 16]);
let t17_disc_eq = QC.verify_tuna17_equivalence(bell, t17_disc);
check(t17_disc.topology_valid and t17_disc_eq.ok and
      t17_disc.measured_physical_qubits[0] == 0 and t17_disc.measured_physical_qubits[1] == 16,
      "Disconnected Tuna-17 subset [0, 16] auto-bridges across transmon couplers with fidelity 1.0");

// 4F. Full 17-qubit Tuna-17 Hamiltonian GHZ compilation
let ghz17 = QC.new_circuit(17);
QC.h(ghz17, 0);
let q17 = 0;
while q17 < 16 {
    QC.cnot(ghz17, q17, q17 + 1);
    q17 = q17 + 1;
}
let t17_full = QC.transpile_to_tuna17(ghz17);
let cqasm17 = QC.to_cqasm3(t17_full, map{ tuna17: true });
assert_tuna17_cqasm_strict(cqasm17, "Full 17-qubit Tuna-17 GHZ");
check(t17_full.gate_counts.cz == 16 and len(t17_full.measured_physical_qubits) == 17,
    "Full 17-qubit Tuna-17 GHZ compiles along 17-transmon Hamiltonian chain in exactly 16 CZ gates");

// 4G. Quantum Inspire 2.0 Result Decoder (17-bit little-endian & sparse physical qubit mapping)
let mock_qi_final_17 = map{
    job_id: 999001,
    final_result: map{
        shots_requested: 1024,
        shots_done: 1024,
        execution_time_in_seconds: 0.042,
        results: map{
            "00000000000000000": 508,
            "00000000000010011": 516
        }
    }
};
let qi_dec_ghz = QC.parse_quantum_inspire_results(mock_qi_final_17, 3, [0, 1, 4]);
check(qi_dec_ghz.ok and qi_dec_ghz.total_shots == 1024 and
      qi_dec_ghz.counts["000"] == 508 and qi_dec_ghz.counts["111"] == 516,
      "17-bit Tuna-17 result '00000000000010011' on [0, 1, 4] marginalizes cleanly to '111'");
let qi_ghz_fid = QC.compute_quantum_fidelity(QC.probabilities(ghz3), qi_dec_ghz.counts);
check(qi_ghz_fid > 0.9999, "Decoded Tuna-17 GHZ-3 counts yield Hellinger fidelity > 0.9999");

// Asymmetric sparse endianness check: X q[0]; X q[4] -> QI bitstring "10001" -> logical [q0, q1, q2] = "101"
let asym_qi_qc = QC.new_circuit(3);
QC.x(asym_qi_qc, 0);
QC.x(asym_qi_qc, 2);
let qi_dec_asym = QC.parse_quantum_inspire_results(map{
    items: [map{ results: map{ "10001": 16 }, shots_done: 16 }]
}, 3, [0, 1, 4]);
check(qi_dec_asym.counts["101"] == 16 and
      num_abs(QC.compute_quantum_fidelity(QC.probabilities(asym_qi_qc), qi_dec_asym.counts) - 1.0) < 0.000000000001,
      "Quantum Inspire b[0]=LSB, b[4]=bit4 ('10001') maps to logical '101' with fidelity 1.0");

// 4H. OPSEC & Missing-Token Offline Fallbacks for Quantum Inspire 2.0
let qi_tok_direct = QC.refresh_quantum_inspire_token(direct_jwt);
check(qi_tok_direct.ok and qi_tok_direct.mode == "direct_bearer_jwt" and
      not str_contains(json_stringify(qi_tok_direct), direct_jwt),
      "refresh_quantum_inspire_token accepts direct JWT without leaking secret in returned map");

let qi_tok_missing = QC.refresh_quantum_inspire_token();
check((not qi_tok_missing.ok) and qi_tok_missing.mode == "missing_qi_token",
    "refresh_quantum_inspire_token honest fallback when credentials absent");

let qi_blist = QC.list_quantum_inspire_backends();
check((not qi_blist.ok) and qi_blist.mode == "missing_qi_token",
    "list_quantum_inspire_backends honest fallback in unit test");

let qi_sub_fb = QC.submit_quantum_inspire_qpu(ghz3, "Tuna-17", 1024);
check(qi_sub_fb.ok and (not qi_sub_fb.qpu_submitted) and
      qi_sub_fb.mode == "local_statevector_fallback_missing_qi_token" and
      qi_sub_fb.backend_type_id == 7 and
      str_contains(qi_sub_fb.cqasm3, "CZ q[0], q[1]") and
      str_contains(qi_sub_fb.cqasm3, "CZ q[1], q[4]"),
      "submit_quantum_inspire_qpu default Tuna-17 fallback includes routed cQASM 3.0");

let qi_wait_fb = QC.run_and_wait_quantum_inspire_qpu(ghz3, "Tuna-17", 1024, 5);
check((not qi_wait_fb.ok) and qi_wait_fb.status == "MISSING_CREDENTIALS" and qi_wait_fb.isa_gate_counts.cz == 2,
    "run_and_wait_quantum_inspire_qpu honest fallback when credentials absent");

print "QUANTUM_HERON_ISA_TEST_PASS checks=" + str(passed_checks) + "/" + str(total_checks);
