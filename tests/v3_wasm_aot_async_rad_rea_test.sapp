// tests/v3_wasm_aot_async_rad_rea_test.sapp
// Comprehensive end-to-end verification suite for PBLang v3.0.0:
//   1. stdlib/native/wasm_web_pwa.sapp      (WASM32 + Canvas 2D RGBA PWA Target)
//   2. stdlib/native/aot_full_bundler.sapp  (Multi-Module DAG + Native ELF64/PE64/C99 Bundler)
//   3. stdlib/async_reactor.sapp            (Coroutine Reactor + RFC 9113 HTTP/2 + RFC 6455 WS)
//   4. stdlib/pkg_semver_registry.sapp      (SemVer 2.0 Backtracking Solver + RFC 8032 Ed25519)
//   5. stdlib/rad_twoway_designer.sapp      (Delphi/WinForms Two-Way RAD + Live SQLite Sync)
//   6. stdlib/rea_suite.sapp                (Real x86-64 / ARM64 / RV32IM Disassemblers + CFG Loops)

let WASM_PWA = import("stdlib:native/wasm_web_pwa.sapp");
let AOT = import("stdlib:native/aot_full_bundler.sapp");
let ASYNC = import("stdlib:async_reactor.sapp");
let PKG = import("stdlib:pkg_semver_registry.sapp");
let RAD = import("stdlib:rad_twoway_designer.sapp");
let REA = import("stdlib:rea_suite.sapp");
let FRONTEND = import("stdlib:compiler/selfhost_frontend.sapp");

let assert_count = 0;

fn check(cond, msg) {
    assert(cond, msg);
    assert_count = assert_count + 1;
}

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 1: Sovereign WASM32 + Canvas 2D RGBA Web-PWA Target
// ══════════════════════════════════════════════════════════════════════════════

let wasm_app_src = "
fn hyp(a, b) {
    return num_sqrt(a * a + b * b);
}

fn fib_iter(n) {
    let a = 0;
    let b = 1;
    let i = 0;
    while i < n {
        let nxt = a + b;
        a = b;
        b = nxt;
        i = i + 1;
    }
    return a;
}

fn render_frame(tick, mx, my, down) {
    gfxclear(12, 20, 36);
    gfxrect(4, 4, 16, 16, 250, 120, 40);
    gfxcircle(16, 16, 6, 40, 200, 180);
    gfxline(0, 0, 10, 10, 255, 255, 255);
    let h = hyp(3.0, 4.0);
    return fib_iter(10) + h;
}
";

let wasm_mod = WASM_PWA.compile_sapp_to_wasm_rgba(wasm_app_src, map{
    width: 64,
    height: 64
});

check(wasm_mod.ok == true, "wasm compile ok");
check(wasm_mod.rgba_base == 65536, "wasm rgba_base == 65536");
check(wasm_mod.byte_length == len(wasm_mod.wasm_bytes), "wasm byte_length matches array");
check(wasm_mod.byte_length > 200, "wasm non-trivial binary length");
check(wasm_mod.wasm_bytes[0] == 0 and wasm_mod.wasm_bytes[1] == 97 and wasm_mod.wasm_bytes[2] == 115 and wasm_mod.wasm_bytes[3] == 109, "wasm \\0asm magic");
check(wasm_mod.wasm_bytes[4] == 1 and wasm_mod.wasm_bytes[5] == 0 and wasm_mod.wasm_bytes[6] == 0 and wasm_mod.wasm_bytes[7] == 0, "wasm version 1");
check(wasm_mod.memory_pages >= 4, "wasm linear memory pages cover stack + 64x64x4 RGBA");

let wasm_info = WASM_PWA.inspect_wasm_sections(wasm_mod.wasm_bytes);
check(wasm_info.ok == true and wasm_info.magic_valid == true, "inspect_wasm_sections ok + magic_valid");
check(wasm_info.section_count == 5, "wasm has 5 canonical sections");
check(wasm_info.sections[0].id == 1 and wasm_info.sections[1].id == 3 and wasm_info.sections[2].id == 5 and wasm_info.sections[3].id == 7 and wasm_info.sections[4].id == 10, "wasm section order Type/Function/Memory/Export/Code");

let has_mem_exp = false;
let has_render_exp = false;
let has_hyp_exp = false;
let ei = 0;
while ei < len(wasm_info.exports) {
    let enm = wasm_info.exports[ei];
    if enm == "memory" { has_mem_exp = true; }
    if enm == "render_frame" { has_render_exp = true; }
    if enm == "hyp" { has_hyp_exp = true; }
    ei = ei + 1;
}
check(has_mem_exp == true, "wasm exports linear memory");
check(has_render_exp == true, "wasm exports render_frame");
check(has_hyp_exp == true, "wasm exports hyp");

// Test full offline PWA bundle generation on disk & clean up immediately
let pwa_dir = "./.pblang_v3_pwa_test_" + str(num_floor(now_ms()));
let pwa_src_file = pwa_dir + "/demo_app.sapp";
let pwa_out_dir = pwa_dir + "/dist";
fs_mkdirs(pwa_dir);
fs_write(pwa_src_file, wasm_app_src);

let pwa_res = WASM_PWA.build_web_pwa(pwa_src_file, pwa_out_dir, map{
    title: "Sovereign Canvas Test",
    width: 64,
    height: 64
});
check(pwa_res.ok == true, "build_web_pwa ok");
check(fs_exists(pwa_out_dir + "/app.wasm"), "PWA app.wasm emitted");
check(fs_exists(pwa_out_dir + "/index.html"), "PWA index.html emitted");
check(fs_exists(pwa_out_dir + "/manifest.webmanifest"), "PWA manifest.webmanifest emitted");
check(fs_exists(pwa_out_dir + "/sw.js"), "PWA sw.js emitted");

let html_txt = fs_read(pwa_out_dir + "/index.html");
check(str_contains(html_txt, "WebAssembly.instantiate"), "index.html instantiates WebAssembly");
check(str_contains(html_txt, "ImageData"), "index.html blits RGBA ImageData to Canvas 2D");
check(not str_contains(html_txt, "https://cdn"), "index.html has zero external CDN dependencies");

let sw_txt = fs_read(pwa_out_dir + "/sw.js");
check(str_contains(sw_txt, "./app.wasm") and str_contains(sw_txt, "caches.open"), "sw.js caches offline assets");

let disk_wasm = fs_read_bytes(pwa_out_dir + "/app.wasm");
check(len(disk_wasm) == wasm_mod.byte_length, "disk app.wasm matches compiled byte length");

fs_remove(pwa_out_dir + "/app.wasm");
fs_remove(pwa_out_dir + "/index.html");
fs_remove(pwa_out_dir + "/manifest.webmanifest");
fs_remove(pwa_out_dir + "/sw.js");
fs_remove(pwa_src_file);
fs_remove(pwa_out_dir);
fs_remove(pwa_dir);

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 2: Multi-Module Native AOT Bundler & Transpiler (DAG + ELF64/PE64/C99)
// ══════════════════════════════════════════════════════════════════════════════

let vfs = map{
    "pkg/base.sapp": "
fn helper(x) { return x + 100; }
fn scale_two(x) { return helper(x) * 2; }
export scale_two;
",
    "pkg/left.sapp": "
let B = import(\"base.sapp\");
fn helper(x) { return x - 50; }
fn compute_left(v) { return B.scale_two(v) + helper(60); }
export compute_left;
",
    "pkg/right.sapp": "
let B = import(\"base.sapp\");
fn compute_right(v) { return B.scale_two(v) + 7; }
export compute_right;
",
    "pkg/main.sapp": "
let L = import(\"left.sapp\");
let R = import(\"right.sapp\");
fn make_adder(k) {
    return fn(z) { return z + k; };
}
let add5 = make_adder(5);
let total = add5(L.compute_left(10) + R.compute_right(5));
"
};

let dag = AOT.resolve_import_dag("pkg/main.sapp", map{ virtual_fs: vfs });
check(dag.ok == true, "DAG resolved ok");
check(dag.module_count == 4, "Diamond DAG deduplicated to 4 modules");
check(dag.topological_order[0] == "pkg/base.sapp", "Leaf base.sapp ordered first");
check(dag.topological_order[3] == "pkg/main.sapp", "Entry main.sapp ordered last");

// Circular import cycle detection
let cyc_vfs = map{
    "a.sapp": "let B = import(\"b.sapp\");\n",
    "b.sapp": "let A = import(\"a.sapp\");\n"
};
let cyc_res = AOT.resolve_import_dag("a.sapp", map{ virtual_fs: cyc_vfs });
check(cyc_res.ok == false and cyc_res.cycle_detected == true, "Circular import rejected cleanly");
check(str_contains(cyc_res.error, "circular import"), "Circular import error identifies cycle");

// Collision-free single-unit .sapp bundle execution
let bundled = AOT.bundle_multi_module_sapp("pkg/main.sapp", map{ virtual_fs: vfs });
check(bundled.ok == true, "Multi-module .sapp bundle ok");
check(str_contains(bundled.source, "__m0_helper") and str_contains(bundled.source, "__m1_helper"), "Colliding helper symbols namespace-prefixed");
let bundle_exec = FRONTEND.frontend_run(bundled.source);
check(bundle_exec.ok == true and bundle_exec.globals["total"] == 452, "Bundled single-unit .sapp executed with colliding helpers & closure == 452");

// Native ELF64 and PE64 emission for integer multi-module DAG
let native_vfs = map{
    "math_leaf.sapp": "fn sq(n) { return n * n; }\nexport sq;\n",
    "app_entry.sapp": "let M = import(\"math_leaf.sapp\");\nlet r = M.sq(6) + M.sq(8);\nprint(r);\n"
};
let elf_res = AOT.compile_multi_module_aot("app_entry.sapp", "elf64", map{ virtual_fs: native_vfs });
check(elf_res.ok == true and elf_res.byte_length > 120, "Multi-module ELF64 AOT emitted");
check(elf_res.binary[0] == 127 and elf_res.binary[1] == 69 and elf_res.binary[2] == 76 and elf_res.binary[3] == 70, "ELF64 \\x7fELF magic verified");

let pe_res = AOT.compile_multi_module_aot("app_entry.sapp", "pe64", map{ virtual_fs: native_vfs });
check(pe_res.ok == true and pe_res.byte_length > 256, "Multi-module PE64 AOT emitted");
check(pe_res.binary[0] == 77 and pe_res.binary[1] == 90, "PE64 MZ header verified");

// Full dynamic C99 transpilation (floats, strings, arrays, maps, closures)
let c99_res = AOT.transpile_dag_to_c99("pkg/main.sapp", map{ virtual_fs: vfs });
check(c99_res.ok == true, "C99 DAG transpiler ok");
check(str_contains(c99_res.c_source, "typedef struct PbVal") and str_contains(c99_res.c_source, "int main(int argc, char **argv)"), "C99 runtime + main emitted");
check(c99_res.closure_count >= 1 and str_contains(c99_res.c_source, "pb_make_closure"), "C99 lexical closure support emitted");

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 3: Non-Blocking Event-Loop Reactor + HTTP/2 (RFC 9113) + WS (RFC 6455)
// ══════════════════════════════════════════════════════════════════════════════

let ev_loop = ASYNC.create_event_loop();
let chan = ASYNC.channel_async(8);
let trace_log = [];

let producer_t = ASYNC.spawn_task(ev_loop, fn(ctx) {
    if ctx.step == 0 {
        array_push(trace_log, "p1");
        chan.try_send(15);
        return ASYNC.sleep_async(5);
    }
    array_push(trace_log, "p2");
    chan.try_send(27);
    return ASYNC.async_done("sent_2");
});

let consumer_t = ASYNC.spawn_task(ev_loop, fn(ctx) {
    if not map_has(ctx.state, "acc") {
        ctx.state.acc = 0;
        ctx.state.got = 0;
    }
    if ctx.resume_value != nil and is_map(ctx.resume_value) and ctx.resume_value.ok {
        ctx.state.acc = ctx.state.acc + ctx.resume_value.value;
        ctx.state.got = ctx.state.got + 1;
        if ctx.state.got == 2 {
            array_push(trace_log, "c_done");
            return ASYNC.async_done(ctx.state.acc);
        }
    }
    return chan.recv_async();
});

let io_probe_t = ASYNC.spawn_task(ev_loop, fn(ctx) {
    if ctx.step == 0 {
        return ASYNC.wait_io_async(0, "read", 2);
    }
    return ASYNC.async_done("io_ready");
});

let gathered = ASYNC.gather_all(ev_loop, [producer_t, consumer_t, io_probe_t]);
check(len(gathered) == 3, "gather_all completed all 3 coroutines");
check(gathered[0] == "sent_2", "producer coroutine return value");
check(gathered[1] == 42, "consumer channel sum == 42");
check(gathered[2] == "io_ready", "wait_io_async coroutine resumed cleanly");
check(len(trace_log) == 3, "cooperative interleaving trace recorded");

// HTTP/2 RFC 9113 binary framing & RFC 7541 Static HPACK
check(len(ASYNC.HTTP2_CLIENT_PREFACE) == 24 and ASYNC.h2_verify_preface(ASYNC.HTTP2_CLIENT_PREFACE) == true, "HTTP/2 client preface 24 octets verified");

let h2_settings_raw = ASYNC.h2_encode_settings([
    map{ id: ASYNC.H2_SETTINGS_MAX_CONCURRENT_STREAMS, value: 100 },
    map{ id: ASYNC.H2_SETTINGS_INITIAL_WINDOW_SIZE, value: 65535 }
], false);
let h2_settings_frame = ASYNC.h2_decode_frame(h2_settings_raw, 0);
let h2_settings_dec = ASYNC.h2_decode_settings(h2_settings_frame);
check(h2_settings_frame.ok == true and h2_settings_frame.type_name == "SETTINGS", "HTTP/2 SETTINGS frame decoded");
check(len(h2_settings_dec.entries) == 2 and h2_settings_dec.entries[0].value == 100, "HTTP/2 SETTINGS parameters intact");

let h2_ack_frame = ASYNC.h2_decode_frame(ASYNC.h2_encode_settings([], true), 0);
let h2_ack_dec = ASYNC.h2_decode_settings(h2_ack_frame);
check(h2_ack_dec.ack == true and h2_ack_frame.length == 0, "HTTP/2 SETTINGS ACK frame");

let req_hdrs = [
    map{ name: ":method", value: "POST" },
    map{ name: ":scheme", value: "https" },
    map{ name: ":path", value: "/api/v3/telemetry" },
    map{ name: ":authority", value: "pblang.local" },
    map{ name: "x-sovereign-node", value: "alpha-1" }
];
let h2_hdr_raw = ASYNC.h2_encode_headers(3, req_hdrs, false, true);
let h2_hdr_frame = ASYNC.h2_decode_frame(h2_hdr_raw, 0);
let h2_hdr_dec = ASYNC.h2_decode_headers(h2_hdr_frame);
check(h2_hdr_frame.ok == true and h2_hdr_frame.stream_id == 3 and h2_hdr_frame.type_name == "HEADERS", "HTTP/2 HEADERS frame on stream 3");
check(len(h2_hdr_dec.headers) == 5, "HPACK decoded all 5 headers");
check(h2_hdr_dec.headers[0].value == "POST" and h2_hdr_dec.headers[2].value == "/api/v3/telemetry" and h2_hdr_dec.headers[4].value == "alpha-1", "HPACK indexed + literal headers roundtripped");

let h2_data_dec = ASYNC.h2_decode_frame(ASYNC.h2_encode_data(3, str_to_bytes("{\"ok\":true}"), true), 0);
check(h2_data_dec.type_name == "DATA" and bytes_to_str(h2_data_dec.payload) == "{\"ok\":true}", "HTTP/2 DATA frame roundtrip");

let h2_wu_frame = ASYNC.h2_decode_frame(ASYNC.h2_encode_window_update(3, 32768), 0);
let h2_wu_dec = ASYNC.h2_decode_window_update(h2_wu_frame);
check(h2_wu_frame.type_name == "WINDOW_UPDATE" and h2_wu_dec.increment == 32768, "HTTP/2 WINDOW_UPDATE roundtrip");

let h2_ping_frame = ASYNC.h2_decode_frame(ASYNC.h2_encode_ping([1, 2, 3, 4, 5, 6, 7, 8], false), 0);
let h2_ping_dec = ASYNC.h2_decode_ping(h2_ping_frame);
check(h2_ping_frame.type_name == "PING" and h2_ping_dec.opaque_data[7] == 8, "HTTP/2 PING 8-byte opaque payload");

let h2_go_frame = ASYNC.h2_decode_frame(ASYNC.h2_encode_goaway(7, 0, "graceful_shutdown"), 0);
let h2_go_dec = ASYNC.h2_decode_goaway(h2_go_frame);
check(h2_go_frame.type_name == "GOAWAY" and h2_go_dec.last_stream_id == 7 and h2_go_dec.debug_data == "graceful_shutdown", "HTTP/2 GOAWAY roundtrip");

// WebSocket RFC 6455 framing (masked 7-bit, 16-bit extended, PING/PONG/CLOSE & multiplexer)
let ws_short = ASYNC.ws_encode_frame(ASYNC.WS_OP_TEXT, "hello sovereign ws", true, [170, 187, 204, 221]);
let ws_short_dec = ASYNC.ws_decode_frame(ws_short, 0);
check(ws_short_dec.ok == true and ws_short_dec.masked == true and ws_short_dec.text == "hello sovereign ws", "WS masked 7-bit text roundtrip");

let long_str = "";
let li = 0;
while li < 200 { long_str = long_str + "X"; li = li + 1; }
let ws_16 = ASYNC.ws_encode_frame(ASYNC.WS_OP_TEXT, long_str, true, [19, 55, 42, 99]);
let ws_16_dec = ASYNC.ws_decode_frame(ws_16, 0);
check(ws_16_dec.ok == true and ws_16_dec.payload_length == 200 and ws_16_dec.text == long_str, "WS masked 16-bit extended length roundtrip");

let ws_close_dec = ASYNC.ws_decode_frame(ASYNC.ws_encode_close(1000, "normal", nil), 0);
check(ws_close_dec.opcode == ASYNC.WS_OP_CLOSE and ws_close_dec.close_code == 1000 and ws_close_dec.close_reason == "normal", "WS CLOSE 1000 frame roundtrip");

let mux = ASYNC.ws_create_multiplexer();
let mux_received = [];
mux.subscribe("metrics", fn(payload, seq) { array_push(mux_received, str(seq) + ":" + str(payload)); });
let ping_disp = mux.dispatch_frame(ASYNC.ws_encode_frame(ASYNC.WS_OP_PING, "hb1", true, [1, 2, 3, 4]));
check(ping_disp.ok == true and ping_disp.control == "ping" and len(ping_disp.pong_frame) >= 5, "WS multiplexer auto-generated PONG response");
let topic_frame = mux.encode_message("metrics", "cpu_ok", [9, 8, 7, 6]);
let topic_disp = mux.dispatch_frame(topic_frame);
check(topic_disp.delivered == 1 and mux_received[0] == "1:cpu_ok", "WS multiplexer pub/sub topic dispatch");

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 4: SemVer 2.0 Backtracking Solver & Ed25519 Signed Package Registry
// ══════════════════════════════════════════════════════════════════════════════

let sv_pre = PKG.parse_semver("2.1.0-alpha.1+build.9");
let sv_rel = PKG.parse_semver("2.1.0");
check(sv_pre.major == 2 and sv_pre.minor == 1 and sv_pre.prerelease[0] == "alpha", "SemVer 2.0 prerelease+build parsed");
check(PKG.semver_cmp("2.1.0-alpha.1", "2.1.0-alpha.2") == -1, "SemVer prerelease numeric ordering");
check(PKG.semver_cmp(sv_pre, sv_rel) == -1, "SemVer prerelease has lower precedence than normal release");
check(PKG.satisfies_range("1.4.2", "^1.2.0") == true and PKG.satisfies_range("2.0.0", "^1.2.0") == false, "SemVer caret range ^1.2.0");
check(PKG.satisfies_range("0.2.5", "^0.2.1") == true and PKG.satisfies_range("0.3.0", "^0.2.1") == false, "SemVer 0.y caret range ^0.2.1");
check(PKG.satisfies_range("1.2.9", "~1.2.3") == true and PKG.satisfies_range("1.3.0", "~1.2.3") == false, "SemVer tilde range ~1.2.3");
check(PKG.satisfies_range("1.5.0", ">=1.0.0 <2.0.0") == true and PKG.satisfies_range("2.0.0", ">=1.0.0 <2.0.0") == false, "SemVer compound comparator range");

// Backtracking conflict-driven solver: must backtrack from ui@2.0.0 (needs net@^2.0.0)
// to ui@1.4.0 (accepts net@^1.0.0) because crypto@1.1.0 requires net@~1.2.0!
let reg_index = map{
    ui: [
        map{ version: "2.0.0", deps: map{ net: "^2.0.0" } },
        map{ version: "1.4.0", deps: map{ net: "^1.0.0" } }
    ],
    crypto: [
        map{ version: "1.1.0", deps: map{ net: "~1.2.0" } }
    ],
    net: [
        map{ version: "2.1.0", deps: map{} },
        map{ version: "1.3.0", deps: map{} },
        map{ version: "1.2.5", deps: map{} }
    ]
};
let solved = PKG.resolve_dependencies(map{ ui: ">=1.0.0", crypto: "^1.0.0" }, reg_index);
check(solved.ok == true, "Backtracking SemVer solver succeeded");
check(solved.resolved.ui == "1.4.0", "Solver backtracked ui 2.0.0 -> 1.4.0");
check(solved.resolved.net == "1.2.5", "Solver selected net 1.2.5 satisfying ^1.0.0 & ~1.2.0");
check(str_starts_with(solved.install_order[0], "net@"), "Topological install order places leaf net first");

// Unsatisfiable dependency graph must produce clear derivation chain
let bad_index = map{
    alpha: [map{ version: "1.0.0", deps: map{ core: "^2.0.0" } }],
    beta: [map{ version: "1.0.0", deps: map{ core: "^1.0.0" } }],
    core: [map{ version: "2.0.0", deps: map{} }, map{ version: "1.5.0", deps: map{} }]
};
let conflict_res = PKG.resolve_dependencies(map{ alpha: "^1.0.0", beta: "^1.0.0" }, bad_index);
check(conflict_res.ok == false and conflict_res.conflict == true, "Unsatisfiable SemVer graph rejected");
check(str_contains(conflict_res.error, "core") and len(conflict_res.derivation_chain) > 0, "Conflict derivation chain explains core version incompatibility");

// Ed25519 RFC 8032 deterministic keypair + package manifest signing & tamper rejection
let seed_vec1 = [];
let si = 0;
while si < 32 { array_push(seed_vec1, 0); si = si + 1; }
seed_vec1[0] = 157; seed_vec1[1] = 97; seed_vec1[2] = 177; seed_vec1[3] = 157;
let kp = PKG.generate_publisher_keypair(seed_vec1);
check(len(kp.public_key_bytes) == 32 and len(kp.public_key_hex) == 64, "Ed25519 32-byte public key generated");

let orig_files = map{
    "src/lib.sapp": "fn ping() { return 200; }\nexport ping;\n",
    "README.md": "# Sovereign HTTP/2\n"
};
let pkg_manifest = map{
    name: "sovereign-http2",
    version: "3.0.0",
    dependencies: map{ net: "^1.2.0" },
    files: orig_files
};
let signed_pkg = PKG.sign_package_manifest(pkg_manifest, kp.secret_key_hex);
check(len(signed_pkg.signature_hex) == 128, "Ed25519 64-byte signature hex");

let ver_ok = PKG.verify_package_manifest(signed_pkg, kp.public_key_hex, orig_files);
check(ver_ok.ok == true, "Ed25519 signed package manifest + artifact SHA-256 verified");

// Tamper 1: modify source file content after signing
let tampered_files = map{
    "src/lib.sapp": "fn ping() { return 999; }\nexport ping;\n",
    "README.md": "# Sovereign HTTP/2\n"
};
let ver_tamper1 = PKG.verify_package_manifest(signed_pkg, kp.public_key_hex, tampered_files);
check(ver_tamper1.ok == false, "Ed25519 verification rejects tampered file content");

// Tamper 2: flip version metadata
let tampered_meta_pkg = map{
    schema: signed_pkg.schema,
    name: signed_pkg.name,
    version: "3.0.1",
    dependencies: signed_pkg.dependencies,
    file_digests: signed_pkg.file_digests,
    manifest_sha256: signed_pkg.manifest_sha256,
    signature_algorithm: signed_pkg.signature_algorithm,
    publisher_public_key: signed_pkg.publisher_public_key,
    signature_hex: signed_pkg.signature_hex
};
let ver_tamper2 = PKG.verify_package_manifest(tampered_meta_pkg, kp.public_key_hex);
check(ver_tamper2.ok == false, "Ed25519 verification rejects tampered manifest version");

// Tamper 3: wrong publisher public key
seed_vec1[0] = 42;
let kp_other = PKG.generate_publisher_keypair(seed_vec1);
let ver_tamper3 = PKG.verify_package_manifest(signed_pkg, kp_other.public_key_hex);
check(ver_tamper3.ok == false, "Ed25519 verification rejects wrong publisher key");

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 5: Two-Way Visual RAD Designer & Live SQLite Data-Aware Synchronizer
// ══════════════════════════════════════════════════════════════════════════════

let form_v1 = RAD.create_form("frm_inventory", "Warehouse Inventory", 1080, 720, map{
    table: "inventory_items",
    columns: ["id INTEGER PRIMARY KEY", "sku TEXT", "qty INTEGER", "unit_price REAL", "category TEXT"],
    filter_sql: ""
});
form_v1 = RAD.add_control(form_v1, map{ id: "lbl_sku", kind: "Label", x: 24, y: 24, caption: "SKU Code:" });
form_v1 = RAD.add_control(form_v1, map{ id: "edt_sku", kind: "Edit", x: 140, y: 24, field: "sku" });
form_v1 = RAD.add_control(form_v1, map{ id: "chk_active", kind: "CheckBox", x: 360, y: 24, caption: "Active SKU" });
form_v1 = RAD.add_control(form_v1, map{ id: "cmb_cat", kind: "ComboBox", x: 500, y: 24, field: "category", items: ["HARDWARE", "OPTICS", "SILICON"] });
form_v1 = RAD.add_control(form_v1, map{
    id: "btn_commit",
    kind: "Button",
    x: 740,
    y: 24,
    caption: "Save Item",
    on_click: "let valid = form_state != nil and db != nil;\nreturn valid;"
});
form_v1 = RAD.add_control(form_v1, map{ id: "grd_items", kind: "DataGrid", x: 24, y: 84, width: 640, height: 360 });
form_v1 = RAD.add_control(form_v1, map{ id: "cht_prices", kind: "Chart", x: 688, y: 84, width: 360, height: 360, series_field: "unit_price" });
form_v1.events.on_save = "let count_c = len(form_state.controls);\nreturn count_c == 7;";

// Forward codegen: Form AST -> .sapp
let rad_code = RAD.form_to_sapp_code(form_v1);
check(str_contains(rad_code, "fn build_form_model()") and str_contains(rad_code, "fn on_btn_commit_click(form_state, db)"), "RAD generated build_form_model and event handler");

// Simulate developer editing geometry, caption, title, AND custom event logic in .sapp text editor
let edited_rad_code = str_replace_all(rad_code, "x: 740,", "x: 800,");
edited_rad_code = str_replace_all(edited_rad_code, "\"Save Item\"", "\"Commit Inventory\"");
edited_rad_code = str_replace_all(edited_rad_code, "\"Warehouse Inventory\"", "\"Global Warehouse v3\"");
edited_rad_code = str_replace_all(edited_rad_code, "return valid;", "let audit_tag = \"RAD_SYNC\";\n    return valid;");

// Reverse parse: modified .sapp -> Form AST
let form_v2 = RAD.sapp_code_to_form(edited_rad_code);
check(form_v2.title == "Global Warehouse v3", "Two-way sync updated form title");
check(len(form_v2.controls) == 7, "Two-way sync preserved all 7 visual controls");
check(form_v2.controls[4].x == 800 and form_v2.controls[4].caption == "Commit Inventory", "Two-way sync updated Button x & caption");
check(str_contains(form_v2.controls[4].events.on_click, "let valid = form_state != nil") and str_contains(form_v2.controls[4].events.on_click, "audit_tag"), "Two-way sync preserved & updated custom on_click body");
check(str_contains(form_v2.events.on_save, "let count_c = len(form_state.controls);"), "Two-way sync preserved custom on_save body");

// Live in-memory SQLite binding + CRUD synchronization
let live_db = RAD.bind_sqlite_live(":memory:", form_v2);
check(live_db.ok == true and live_db.table == "inventory_items", "bind_sqlite_live initialized schema");

live_db.insert_row(map{ sku: "CHIP-X1", qty: 50, unit_price: 199.5, category: "SILICON" });
live_db.insert_row(map{ sku: "LENS-Q9", qty: 12, unit_price: 450.0, category: "OPTICS" });
live_db.insert_row(map{ sku: "BOARD-A4", qty: 30, unit_price: 85.25, category: "HARDWARE" });

let synced_f = live_db.get_form();
check(len(live_db.get_rows()) == 3, "SQLite live insert_row stored 3 records");
check(synced_f.controls[5].row_count == 3, "DataGrid live-synced 3 rows");
check(len(synced_f.controls[6].points) == 3 and synced_f.controls[6].points[1] == 450.0, "Chart series live-synced unit_price points");
check(synced_f.controls[1].value == "CHIP-X1", "Bound Edit control populated from current record");

live_db.update_row(2, map{ unit_price: 499.0, qty: 15 });
check(live_db.get_form().controls[6].points[1] == 499.0, "SQLite update_row refreshed Chart series");

live_db.delete_row(1);
check(live_db.get_form().controls[5].row_count == 2, "SQLite delete_row refreshed DataGrid row_count");
live_db.close();

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 6: Real Multi-Arch Disassemblers (x86-64 / ARM64 / RV32IM) & CFG Loops
// ══════════════════════════════════════════════════════════════════════════════

// 6A. x86-64: REX.WRXB, RIP-relative LEA, SIB scaled load, IMUL, SHL, DEC, JNE loop, SYSCALL, UD2
let x64_hex = "f30f1efa554889e54883ec30488d05400000004c8b448f10480fafc648c1e00248ffc975f30f05c9c30f0b";
let x64_ins = REA.disassemble_x86_64(x64_hex, 4096);
check(x64_ins[0].mnemonic == "endbr64" and x64_ins[3].operands == "rsp, 48", "x86-64 prologue + sub rsp, 48");
check(x64_ins[4].mnemonic == "lea" and x64_ins[4].operands == "rax, [rip + 64]", "x86-64 RIP-relative LEA");
check(x64_ins[5].mnemonic == "mov" and x64_ins[5].operands == "r8, qword ptr [rdi + rcx*4 + 16]", "x86-64 REX+SIB scaled displacement MOV");
check(x64_ins[6].mnemonic == "imul" and x64_ins[6].operands == "rax, rsi", "x86-64 two-byte 0F AF IMUL");
check(x64_ins[7].mnemonic == "shl" and x64_ins[7].operands == "rax, 2", "x86-64 Group 2 SHL imm8");
check(x64_ins[9].mnemonic == "jne" and x64_ins[9].target_offset == 24, "x86-64 JNE backward branch target");
check(x64_ins[10].mnemonic == "syscall" and x64_ins[13].mnemonic == "ud2", "x86-64 SYSCALL & UD2");

let x64_cfg = REA.build_real_cfg(x64_ins);
check(x64_cfg.has_standard_prologue == true and x64_cfg.stack_frame_bytes == 48, "x86-64 CFG prologue + 48B frame");
check(x64_cfg.idom["bb_1"] == "bb_0" and x64_cfg.idom["bb_2"] == "bb_1", "x86-64 Cooper-Harvey-Kennedy immediate dominators");
check(x64_cfg.loop_count == 1 and x64_cfg.natural_loops[0].header == "bb_1", "x86-64 CFG natural loop header bb_1 detected");

// 6B. ARM64 (A64): STP pre-index, ADD, MOVZ, MOVK, STR, LDR, SUB, CMP, B.NE loop, BL, SVC, LDP post-index, RET
let a64_hex = "fd7bbea9fd030091000880d22000a0f2e00f00f9e10f40f9210400d13f0000f1a1ffff5410000094010000d4fd7bc2a8c0035fd6";
let a64_decomp = REA.decompile_and_cfg_artifact(map{
    function_name: "arm64_worker",
    arch: "arm64",
    base_address: 8192,
    hex: a64_hex
});
check(a64_decomp.ok == true and a64_decomp.instruction_count == 13, "ARM64 decoded 13 A64 instructions");
check(a64_decomp.instructions[0].text == "stp x29, x30, [sp, #-32]!", "ARM64 pre-indexed STP prologue");
check(a64_decomp.instructions[2].text == "movz x0, #64" and a64_decomp.instructions[3].text == "movk x0, #1, lsl #16", "ARM64 MOVZ + shifted MOVK");
check(a64_decomp.instructions[4].text == "str x0, [sp, #24]" and a64_decomp.instructions[5].text == "ldr x1, [sp, #24]", "ARM64 unsigned-offset STR & LDR");
check(a64_decomp.instructions[7].text == "cmp x1, #0" and a64_decomp.instructions[8].mnemonic == "b.ne", "ARM64 CMP alias & B.NE");
check(a64_decomp.instructions[9].mnemonic == "bl" and a64_decomp.instructions[10].text == "svc #0", "ARM64 BL & SVC #0");
check(a64_decomp.instructions[11].text == "ldp x29, x30, [sp], #32" and a64_decomp.instructions[12].mnemonic == "ret", "ARM64 post-indexed LDP & RET");
check(a64_decomp.cfg.loop_count == 1 and a64_decomp.cfg.stack_frame_bytes == 32, "ARM64 CFG loop + 32B stack frame");

// 6C. RISC-V RV32IM: ADDI, SW, LUI, AUIPC, MUL, DIV, SUB, BNE loop, ECALL, LW, JALR (ret)
let rv_hex = "130101ff23261100b7220100171300003305b5023346c5023305b5409385f5ffe39805fe730000008320c1001301010167800000";
let rv_decomp = REA.decompile_and_cfg_artifact(map{
    function_name: "rv32im_kernel",
    arch: "rv32im",
    base_address: 16384,
    hex: rv_hex
});
check(rv_decomp.ok == true and rv_decomp.instruction_count == 13, "RV32IM decoded 13 instructions");
check(rv_decomp.instructions[0].text == "addi sp, sp, -16" and rv_decomp.instructions[1].text == "sw ra, 12(sp)", "RV32IM prologue ADDI + SW");
check(rv_decomp.instructions[2].text == "lui t0, 18" and rv_decomp.instructions[3].text == "auipc t1, 1", "RV32IM U-type LUI & AUIPC");
check(rv_decomp.instructions[4].text == "mul a0, a0, a1" and rv_decomp.instructions[5].text == "div a2, a0, a2", "RV32M hardware MUL & DIV");
check(rv_decomp.instructions[6].text == "sub a0, a0, a1", "RV32I R-type SUB");
check(rv_decomp.instructions[8].mnemonic == "bne" and rv_decomp.instructions[8].target_offset == 16, "RV32I B-type BNE backward target");
check(rv_decomp.instructions[9].mnemonic == "ecall" and rv_decomp.instructions[12].flow == "return", "RV32I ECALL & JALR return");
check(rv_decomp.cfg.loop_count == 1 and rv_decomp.cfg.natural_loops[0].header == "bb_1", "RV32IM CFG natural loop detected");

print("v3_wasm_aot_async_rad_rea_test: ALL " + str(assert_count) + " ASSERTIONS PASSED");
