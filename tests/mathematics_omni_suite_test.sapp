// tests/mathematics_omni_suite_test.sapp — PBLang v2.3.0 Sovereign Universal Mathematics Verification Suite
//
// End-to-end verification across all 12 categories & 64 subcategories of mathematics:
//   1. Unified Facade & Taxonomy (`stdlib:mathematics.sapp`)
//   2. Smart Step-by-Step Equation & Inequality Transformer (`simplify`, `expand`, `factor`, `complete_square`, `apart`, `trig`, `log`, `rationalize`, `isolate` + inequality sign flip)
//   3. Universal Equation, Sign-Chart Inequality & Multivariate System Solver (`excluded_poles`, `rejected_extraneous`, intervals, exact Q RREF, nonlinear Newton)
//   4. Exact Algebra, Intervals, Number Theory, Polynomials, Sturm & Aberth-Ehrlich (`stdlib:math/exact_algebra.sapp`)
//   5. Symbolic & Numerical Calculus, Vector Analysis, Limits, Series, ODE/PDE, Laplace & FFT (`stdlib:math/calculus_ode.sapp`)
//   6. Exact Q & Numerical Linear Algebra, Tensors, Differential/Computational Geometry & WGS-84 Geodesy (`stdlib:math/linalg_geometry.sapp`)
//   7. Probability, Hypothesis Tests, ML/PCA, Simplex/MILP/BFGS/LM/KKT, Quine-McCluskey, Graphs, Black-Scholes & SI Units (`stdlib:math/stats_opt_applied.sapp`)
//   8. Crisp XSS-Safe Vector SVG Plotting, DoS Security Bounds, `stdlib:math.sapp` Native Acceleration & `@math`/`@maxima` Polyglot Bridge

let MATH = import("stdlib:mathematics.sapp");
let LEGACY_MATH = import("stdlib:math.sapp");
let POLY = import("stdlib:polyglot_universal.sapp");

let _passed = 0;

fn check(cond, msg) {
    if not cond {
        throw "MATHEMATICS_OMNI_SUITE_FAIL: " + str(msg);
    }
    _passed = _passed + 1;
}

fn check_near(a, b, tol, msg) {
    let d = num_abs((a * 1.0) - (b * 1.0));
    if d > tol {
        throw "MATHEMATICS_OMNI_SUITE_NEAR_FAIL: " + str(msg) + " (got " + str(a) + ", expected " + str(b) + ", diff=" + str(d) + ")";
    }
    _passed = _passed + 1;
}

print "=== PBLang v2.3.0 Sovereign Universal Mathematics Verification Suite ===";

// ── 1. Catalog & Taxonomy ────────────────────────────────────────────────────
let cat = MATH.catalog();
check(cat.ok and cat.version == "2.3.0", "catalog version 2.3.0");
check(cat.categories_count == 12 and cat.subcategories_count >= 60, "12 categories & 60+ subcategories covered");
check(cat.security_posture.network_io == false and cat.security_posture.bounded_dos_guards == true, "zero network IO & DoS guards active");
print "  [PASS] 1. Sovereign Mathematics catalog (12 categories, " + str(cat.subcategories_count) + " subcategories)";

// ── 2. Smart Step-by-Step Equation & Inequality Transformer ──────────────────
let tr_cancel = MATH.simplify("(x^2 - 1)/(x - 1)");
check(tr_cancel.ok and tr_cancel.ascii == "x + 1", "rational GCD cancellation (x^2-1)/(x-1) -> x + 1");
check(str_contains(str(tr_cancel.domain_guard), "1"), "domain guard x != 1 preserved");

let tr_fact = MATH.factor("x^3 - 6x^2 + 11x - 6");
check(tr_fact.ok and len(tr_fact.steps) >= 1, "cubic factorization over Q with step trace");

let tr_cs = MATH.complete_square("2x^2 - 8x + 11", "x");
check(tr_cs.ok and tr_cs.extremum_type == "min" and tr_cs.vertex[0] == 2 and tr_cs.vertex[1] == 3, "complete_square vertex (2, 3) minimum");

let tr_apart = MATH.apart("(3x + 5)/((x - 1)*(x + 3))", "x");
check(tr_apart.ok and str_contains(tr_apart.ascii, "2") and str_contains(tr_apart.ascii, "1"), "partial fractions decomposition");

let tr_trig = MATH.transform("\\sin^{2}(x) + \\cos^{2}(x) + \\tan(x)\\cos(x)", "trig_simplify");
check(tr_trig.ok and str_contains(tr_trig.ascii, "sin(x)") and str_contains(tr_trig.ascii, "1"), "LaTeX Pythagorean + tan*cos trig simplification");

let tr_iso_formula = MATH.isolate("1/R = 1/R1 + 1/R2", "R");
check(tr_iso_formula.ok and str_contains(tr_iso_formula.ascii, "R1") and str_contains(tr_iso_formula.ascii, "R2"), "parallel resistor formula isolation for R");

let tr_iso_ineq = MATH.isolate("-3x + 6 <= 12", "x");
check(tr_iso_ineq.ok and (str_contains(tr_iso_ineq.ascii, ">=") or str_contains(tr_iso_ineq.unicode, "≥")) and str_contains(tr_iso_ineq.ascii, "-2"), "inequality flips direction on negative division (-3x + 6 <= 12 -> x >= -2)");
print "  [PASS] 2. Smart equation, formula & inequality step-by-step transformations";

// ── 3. Universal Equation, Sign-Chart Inequality & System Solver ─────────────
// 3a. Exact surd & complex quadratics
let sq_surd = MATH.solve("x^2 - 2x - 1 = 0");
check(sq_surd.ok and len(sq_surd.solutions) == 2 and str_contains(sq_surd.solutions[0].unicode + sq_surd.solutions[1].unicode, "√2"), "exact quadratic surd 1 ± √2");

let sq_cplx = MATH.solve("x^2 + 2x + 5 = 0");
check(sq_cplx.ok and len(sq_cplx.complex_solutions) == 2, "complex conjugate roots -1 ± 2i");

// 3b. Rational pole exclusion: x/(x - 2) + 1 = 2/(x - 2) -> candidate x=2 is a pole -> 0 valid solutions!
let sq_pole = MATH.solve("x/(x - 2) + 1 = 2/(x - 2)");
check(sq_pole.ok and len(sq_pole.solutions) == 0 and len(sq_pole.excluded_poles) >= 1, "rational equation rejects pole x = 2");

// 3c. Radical extraneous root rejection: sqrt(x + 3) = x - 3 -> x = 6 kept, x = 1 rejected
let sq_rad = MATH.solve("√(x + 3) = x - 3");
check(sq_rad.ok and len(sq_rad.solutions) == 1 and sq_rad.solutions[0].value == 6 and len(sq_rad.rejected_extraneous) == 1, "radical equation keeps x=6 and rejects extraneous x=1");

// 3d. Rational Inequality with Exact Sign Table: (x^2 - 4)/(x - 1) <= 0 -> (-∞, -2] ∪ (1, 2]
let ineq_rat = MATH.solve("(x^2 - 4)/(x - 1) <= 0");
check(ineq_rat.ok and ineq_rat.unicode == "(-∞, -2] ∪ (1, 2]" and len(ineq_rat.sign_table) >= 5, "rational inequality sign chart (-∞, -2] ∪ (1, 2] keeps pole x=1 open");

// 3e. Chained & absolute-value inequalities
let ineq_chain = MATH.solve("-3 < 2x + 1 <= 7");
check(ineq_chain.ok and ineq_chain.unicode == "(-2, 3]", "chained inequality -3 < 2x + 1 <= 7 -> (-2, 3]");

let ineq_abs = MATH.solve("|2x - 3| < 5");
check(ineq_abs.ok and ineq_abs.unicode == "(-1, 4)", "absolute-value inequality |2x - 3| < 5 -> (-1, 4)");

// 3f. Exact Q linear system & nonlinear system
let sys_lin = MATH.solve("2x + y - z = 8; -3x - y + 2z = -11; -2x + y + 2z = -3");
check(sys_lin.ok and sys_lin.status == "unique" and sys_lin.exact.x == "2" and sys_lin.exact.y == "3" and sys_lin.exact.z == "-1", "exact 3x3 linear system over Q");

let sys_nonlin = MATH.solve(["x^2 + y^2 = 25", "x - y = 1"], ["x", "y"]);
check(sys_nonlin.ok and len(sys_nonlin.solutions) >= 2, "nonlinear circle-line intersection solved");
print "  [PASS] 3. Universal equations, sign-chart inequalities & systems verified";

// ── 4. Exact Algebra, Intervals, Number Theory, Sturm & Aberth-Ehrlich ───────
let EX = MATH.exact();
let r_pi = EX.best_rational(3.141592653589793, 1000);
check(EX.rat_to_str(r_pi) == "355/113", "Stern-Brocot best_rational(pi, 1000) == 355/113");

let iv_s = EX.ival_sin(EX.ival(0.0, 3.141592653589793));
check_near(iv_s.lo, 0.0, 1e-12, "interval sin([0, pi]) lo");
check_near(iv_s.hi, 1.0, 1e-12, "interval sin([0, pi]) hi");

let crt_r = EX.crt([2, 4, 14], [6, 10, 15]);
check(crt_r.solvable and str(crt_r.lcm_modulus) == "30", "non-coprime generalized CRT mod 30");

let pell_61 = MATH.solve("pell(61)");
check(pell_61.ok and pell_61.x1 == "1766319049" and pell_61.y1 == "226153980", "Pell x^2 - 61y^2 = 1 exact bigint fundamental solution");

let p_sturm = EX.poly_from_coeffs_desc([1, 0, -5, 0, 4]); // (x^2 - 1)(x^2 - 4) -> roots -2, -1, 1, 2
check(EX.sturm_real_root_count(p_sturm, -3, 3) == 4, "Sturm exact real root count == 4");
let p_c4 = EX.poly_from_coeffs_desc([1, 0, 0, 0, 1]); // x^4 + 1 = 0
let c4_roots = EX.poly_all_roots(p_c4);
check(len(c4_roots) == 4, "Aberth-Ehrlich finds all 4 complex roots of x^4 + 1");

let aes_poly = EX.gf_poly_from_coeffs_desc([1, 0, 0, 0, 1, 1, 0, 1, 1], 2);
check(EX.gf_poly_is_irreducible(aes_poly, 2), "Rabin irreducibility of AES x^8+x^4+x^3+x+1 over F_2");
print "  [PASS] 4. Exact algebra, intervals, Pell/CRT, Sturm & Aberth-Ehrlich verified";

// ── 5. Calculus, Vector Analysis, Quadrature, Limits, Series, ODE/PDE & FFT ──
let d_xx = MATH.solve("diff(x^x, x)");
check(d_xx.ok and str_contains(d_xx.ascii, "ln(x)"), "generalized exponential derivative d/dx(x^x)");

let i_parts = MATH.solve("integrate(x^2 * exp(x), x)");
check(i_parts.ok and i_parts.verified, "symbolic tabular integration by parts verified by differentiation");

let i_gauss = MATH.solve("integrate(exp(-x^2), x, -inf, +inf)");
check_near(i_gauss.value, num_sqrt(3.14159265358979323846), 1e-11, "Tanh-Sinh improper Gaussian integral == sqrt(pi)");

let lim_lh = MATH.solve("limit((1 - cos(x))/x^2, x, 0)");
check(lim_lh.ok and lim_lh.exists, "L'Hopital limit exists");
check_near(lim_lh.value, 0.5, 1e-12, "lim (1-cos x)/x^2 == 1/2");

let basel = MATH.solve("sum(1/n^2, n, 1, inf)");
check_near(basel.value, (3.14159265358979323846 * 3.14159265358979323846) / 6.0, 1e-11, "Euler-Maclaurin Basel sum == pi^2/6");

let ode_ivp = MATH.solve("y'' + 4*y = 0; y(0)=1, y'(0)=2");
check(ode_ivp.ok and ode_ivp.ascii == "cos(2*x) + sin(2*x)", "symbolic 2nd-order IVP y''+4y=0 -> cos(2x)+sin(2x)");

let CALC = MATH.calculus();
let fft_sig = [1.0, -1.0, 2.0, 0.5];
let fft_rec = CALC.ifft(CALC.fft(fft_sig));
check_near(fft_rec[2].re, 2.0, 1e-13, "Cooley-Tukey IFFT(FFT(x)) exact reconstruction");
print "  [PASS] 5. Symbolic/numerical calculus, limits, series, ODEs & FFT verified";

// ── 6. Exact Q Linear Algebra, SVD, Tensors, Geometry & Vincenty WGS-84 ──────
let LA = MATH.linalg();
let H4 = LA.hilbert(4);
check(LA.det_exact(H4).str == "1/6048000", "Bareiss exact det(Hilbert_4) == 1/6048000");
let H4_inv = LA.inv_exact(H4);
check(LA.rat_to_string(H4_inv[3][3]) == "2800", "exact integer entry (4,4) == 2800 of Hilbert_4^-1");

let svd_r = LA.svd([[3.0, 2.0, 2.0], [2.0, 3.0, -2.0]]);
check_near(svd_r.singular_values[0], 5.0, 1e-11, "SVD sigma_1 == 5");
check_near(svd_r.singular_values[1], 3.0, 1e-11, "SVD sigma_2 == 3");

let wgs = LA.vincenty_wgs84(37.9838, 23.7275, 40.6401, 22.9444);
check(wgs.converged and wgs.distance_m > 302000.0 and wgs.distance_m < 303500.0, "Vincenty WGS-84 Athens -> Thessaloniki geodesic (~302.5 km)");

let tri = LA.delaunay_triangulation_2d([[0.0, 0.0], [4.0, 0.0], [4.0, 3.0], [0.0, 3.0], [2.0, 1.5]]);
check(len(tri.triangles) == 4, "Bowyer-Watson Delaunay triangulation 5-point rectangle -> 4 triangles");
print "  [PASS] 6. Exact Hilbert Q-linalg, SVD, Delaunay & Vincenty WGS-84 verified";

// ── 7. Statistics, Simplex/MILP/BFGS/LM/KKT, Quine-McCluskey & Finance ───────
let SO = MATH.stats_opt();
let welch = SO.t_test_2samp_welch([10.2, 10.5, 9.9, 10.4, 10.1], [8.1, 8.4, 7.9, 8.2, 8.0]);
check(welch.reject_h0_at_0_05 and welch.p_value < 0.0001, "Welch 2-sample t-test p < 1e-4");

let lp_r = SO.linprog_simplex([3.0, 2.0], [[2.0, 1.0], [2.0, 3.0], [3.0, 1.0]], [18.0, 42.0, 24.0], nil, nil, true);
check(lp_r.status == "optimal", "Two-Phase Simplex optimal status");
check_near(lp_r.fun, 33.0, 1e-9, "Simplex max objective == 33 at (3, 12)");

let milp_r = SO.milp_solve([5.0, 8.0], [[1.0, 1.0], [5.0, 9.0]], [6.0, 45.0], [0, 1], true);
check(milp_r.status == "optimal" and milp_r.x[0] == 0 and milp_r.x[1] == 5 and milp_r.fun == 40, "Branch-and-Bound MILP integer optimum (0, 5) -> 40");

let bfgs_r = SO.minimize_bfgs(fn(v) {
    let d1 = 1.0 - v[0];
    let d2 = v[1] - v[0] * v[0];
    return d1 * d1 + 100.0 * d2 * d2;
}, [-1.2, 1.0]);
check_near(bfgs_r.x[0], 1.0, 1e-5, "BFGS Rosenbrock x* == 1");
check_near(bfgs_r.x[1], 1.0, 1e-5, "BFGS Rosenbrock y* == 1");

check(str(SO.partition_count(100)) == "190569292", "Euler pentagonal partition p(100) == 190569292");

let qm = MATH.solve("boolean((A & B) | (!A & C) | (B & C))");
check(qm.ok and not str_contains(qm.minimal_sop, "B & C"), "Quine-McCluskey eliminates consensus term B & C");

let bs_c = SO.black_scholes(100.0, 100.0, 1.0, 0.05, 0.2, "call");
let bs_p = SO.black_scholes(100.0, 100.0, 1.0, 0.05, 0.2, "put");
check_near(bs_c.price - bs_p.price, 100.0 - 100.0 * num_exp(-0.05), 1e-11, "Black-Scholes exact Put-Call Parity");

let si_c = SO.convert_units(100.0, "C", "F");
check_near(si_c, 212.0, 1e-12, "SI unit conversion 100 C == 212 F");
print "  [PASS] 7. Statistics, Simplex/MILP/BFGS, Quine-McCluskey, Black-Scholes & SI units verified";

// ── 8. Crisp XSS-Safe SVG Plotter, DoS Guards, `math.sapp` & `@math` Polyglot ─
let svg = MATH.plot_svg(["x^2 - 4", "2x - 1"], -4, 4, map{ title: "Parabola & <script>alert(1)</script>" });
check(str_starts_with(svg, "<svg") and str_contains(svg, "&lt;script&gt;") and not str_contains(svg, "<script>"), "SVG plot generated with strict XSS entity escaping");

// Hardware-accelerated legacy `stdlib:math.sapp` compatibility + new suite hooks
check_near(LEGACY_MATH.sin(LEGACY_MATH.PI / 6.0), 0.5, 1e-15, "native hardware sin(pi/6) == 0.5 to 53-bit precision");
check_near(LEGACY_MATH.cos(LEGACY_MATH.PI / 3.0), 0.5, 1e-15, "native hardware cos(pi/3) == 0.5 to 53-bit precision");
let leg_ineq = LEGACY_MATH.solve("x^2 - 5x + 6 <= 0");
check(leg_ineq.ok and leg_ineq.unicode == "[2, 3]", "stdlib:math.sapp .solve() inequality [2, 3]");

// Omni-Polyglot `@math` / `@wolfram` / `@maxima` in-engine execution
let poly_m = POLY.eval_native("math", "(x^2 - 9)/(x - 3) <= 5;");
check(poly_m.ok and poly_m.executed_in_engine and poly_m.host_subprocess_used == false, "@math polyglot runs natively in Sovereign CAS");
let poly_w = POLY.eval_native("wolfram", "factor(x^2 - 49)");
check(poly_w.ok and str_contains(poly_w.stdout, "7"), "@wolfram polyglot factors x^2 - 49 natively");

// Security DoS bounds fail closed cleanly
let dos_caught = false;
let _ = try EX.rat_pow(EX.rat(2, 1), 999999999) catch { dos_caught = true; nil };
check(dos_caught, "MAX_BITS exponent DoS guard fails closed");

let qm_dos = false;
let qm_r = try SO.boolean_analyze("A & B & C & D & E & F & G & H & I & J & K & L & M") catch { qm_dos = true; nil };
if qm_r != nil and type(qm_r) != "map" { qm_dos = true; }
check(qm_dos, "MAX_QM_VARS 13-variable combinatorial DoS guard fails closed");

print "  [PASS] 8. XSS-safe SVG plotting, native math.sapp, @math/@wolfram polyglot & DoS bounds verified";
print "=== ALL MATHEMATICS OMNI-SUITE CHECKS PASSED (" + str(_passed) + " assertions) ===";
