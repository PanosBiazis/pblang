// tests/public_release_readiness_test.sapp — 100% PBLang Verification Suite for
// 1.0.0-stable & Public GitHub Readiness Backlog Items:
//   - PB-02-022: Rust-Independent TLS 1.3 & PEM Engine (stdlib/tls.sapp)
//   - PB-02-019: Relative-Root Bundle Source Preservation & Overlap Guard (stdlib/selfhost_bundle.sapp & stdlib/compiler/native_bundle.sapp)
//   - PB-02-023: Public GitHub Hygiene, Privacy & 1.0.0 Gate Auditor (stdlib/public_release_audit.sapp)
//   - PB-02-024: Zero-Rust Public Quickstart Verification on README.md
//   - PB-02-025: Differential Multi-Backend Compiler Parity Suite (stdlib/compiler/backend_parity.sapp)

let TLS = import("stdlib:tls.sapp");
let Bundle = import("stdlib:selfhost_bundle.sapp");
let NativeBundle = import("stdlib:compiler/native_bundle.sapp");
let Audit = import("stdlib:public_release_audit.sapp");
let Parity = import("stdlib:compiler/backend_parity.sapp");
let UUID = import("stdlib:uuid.sapp");

let total_checks = 0;
let passed_checks = 0;

fn check(cond, label) {
    total_checks = total_checks + 1;
    if not cond {
        throw "FAIL [" + label + "]";
    }
    passed_checks = passed_checks + 1;
}

// ── 1. PB-02-022: Rust-Independent TLS 1.3 & PEM Certificate Engine ──────────
let tls_status = TLS.pblang_tls13_status();
check(tls_status.ok, "tls13_status ok");
check(not tls_status.rust_dependent, "tls13_status rust_dependent is false");
check(tls_status.rustls_provider_conflict_bypassed, "tls13_status bypasses rustls conflict");
check(len(tls_status.supported_ciphers) == 3, "tls13_status 3 AEAD cipher suites");

let sample_cert = "-----BEGIN CERTIFICATE-----\nMIIBkTCB+wIJAKHHCgVZU6w9MAoGCCqGSM49BAMCMBMxETAPBgNVBAMMCE15Server\n-----END CERTIFICATE-----\n";
let sample_key = "-----BEGIN EC PRIVATE KEY-----\nMHcCAQEEII9q1234567890abcdef\n-----END EC PRIVATE KEY-----\n";
let cert_valid = TLS.validate_cert_pair(sample_cert, sample_key);
check(cert_valid.ok, "validate_cert_pair accepts valid ECDSA PEM pair");
check(not cert_valid.rust_dependent, "validate_cert_pair is rust_dependent:false");
check(cert_valid.key_kind == "ECDSA", "validate_cert_pair detects ECDSA key_kind");
check(len(cert_valid.cert_sha256) == 64, "validate_cert_pair computes 64-hex cert_sha256");

let cert_bad = TLS.validate_cert_pair("not-a-cert", sample_key);
check(len(cert_bad.error) > 0 and not cert_bad.ok, "validate_cert_pair rejects invalid cert PEM");

let inspected = TLS.inspect_certificate(sample_cert + sample_cert);
check(inspected.ok and inspected.chain_depth == 2, "inspect_certificate counts 2-cert chain");

// ── 2. PB-02-019: Relative-Root Bundle Source Integrity & Overlap Guard ──────
let self_copy = Bundle.validate_bundle_destination("src/main.sapp", "./src/main.sapp", ".");
check(len(self_copy.reason) > 0 and not self_copy.ok, "validate_bundle_destination rejects self-copy");

let overlap_root = Bundle.validate_bundle_destination("src/main.sapp", "./out.pbck", ".");
check(len(overlap_root.reason) > 0 and not overlap_root.ok, "validate_bundle_destination rejects output inside relative root");

let sapp_target = Bundle.validate_bundle_destination("src/main.sapp", "/tmp/safe_out.sapp", "src");
check(len(sapp_target.reason) > 0 and not sapp_target.ok, "validate_bundle_destination rejects .sapp output target");

let tmp_id = UUID.v4();
let rel_root = ".tmp_bundle_root_" + tmp_id;
let ext_out = "/tmp/pblang_safe_bundle_" + tmp_id + ".pbck";
fs_mkdirs(rel_root);
let main_file = rel_root + "/main.sapp";
let dep_file = rel_root + "/helper.sapp";
let main_src = "let h = import(\"helper.sapp\");\nprint h.compute_val();\n";
let dep_src = "fn compute_val() { return 99; }\nexport compute_val;\n";
fs_write(main_file, main_src);
fs_write(dep_file, dep_src);
let main_hash_before = sha256(fs_read(main_file));
let dep_hash_before = sha256(fs_read(dep_file));

// Attempt self-copy & in-root write via publish_bundle_safe -> must reject before touching files!
let rejected_self = NativeBundle.publish_bundle_safe(main_file, main_file, rel_root);
check(len(rejected_self.reason) > 0 and not rejected_self.ok, "publish_bundle_safe rejects self-overwrite");
let rejected_in_root = NativeBundle.publish_bundle_safe("main.sapp", rel_root + "/inside.pbck", rel_root);
check(len(rejected_in_root.reason) > 0 and not rejected_in_root.ok, "publish_bundle_safe rejects in-root overlap");
check(sha256(fs_read(main_file)) == main_hash_before, "main.sapp byte-identical after rejected overlap");
check(sha256(fs_read(dep_file)) == dep_hash_before, "helper.sapp byte-identical after rejected overlap");

// Safe isolated external publication from relative root
let safe_pub = NativeBundle.publish_bundle_safe("main.sapp", ext_out, rel_root);
check(safe_pub.ok and safe_pub.modules == 1 and not safe_pub.source_writes, "publish_bundle_safe succeeds to external destination");
check(fs_exists(ext_out) and safe_pub.byte_count > 16, "publish_bundle_safe wrote external .pbck artifact");
check(sha256(fs_read(main_file)) == main_hash_before, "main.sapp byte-identical after external bundle publication");
check(sha256(fs_read(dep_file)) == dep_hash_before, "helper.sapp byte-identical after external bundle publication");

try fs_remove(ext_out) catch nil;
try fs_remove(dep_file) catch nil;
try fs_remove(main_file) catch nil;
try fs_remove(rel_root) catch nil;

// ── 3. PB-02-023 & PB-02-024: Public GitHub Hygiene & Zero-Rust Quickstart ───
let clean_scan = Audit.scan_text_for_private_leaks("fn add(a, b) { return a + b; }", "src/math.sapp");
check(clean_scan.ok and clean_scan.clean and clean_scan.finding_count == 0, "scan_text_for_private_leaks passes clean source");

let leaky_text = "path = \"/home/" + "appuser/secret\" and token = \"gh" + "p_12345\"";
let leak_scan = Audit.scan_text_for_private_leaks(leaky_text, "config.toml");
check(leak_scan.ok and not leak_scan.clean and leak_scan.critical_count == 2, "scan_text_for_private_leaks catches local path and token");

let tree_audit = Audit.audit_repository_tree(map{
    ordered_input: true,
    "src/app.sapp": "print 42;",
    "README.md": "Use pblang run hello.sapp and modern_ui"
});
check(tree_audit.ok and tree_audit.public_hygiene_pass and tree_audit.scanned_files == 2, "audit_repository_tree passes clean tree");

let live_readme = fs_read("README.md");
let readme_audit = Audit.audit_readme_rust_independence(live_readme);
check(readme_audit.ok, "audit_readme_rust_independence executed on live README.md");
check(readme_audit.rust_independent_quickstart, "live README.md Quick start does not require Rust prerequisite");
check(readme_audit.mentions_standalone_pblang, "live README.md documents standalone pblang / tools/pbc.sapp");
check(readme_audit.privacy_clean, "live README.md has 0 private path/credential leaks");
check(readme_audit.public_readme_ready, "live README.md is public_readme_ready");

let gates_partial = Audit.evaluate_1_0_stability_gates(map{
    ordered_input: true,
    language_backend_parity: true,
    memory_resource_lifetime: true,
    rust_independence_and_isolation: true,
    supply_chain_lock_integrity: true,
    platform_verification_matrix: false,
    public_privacy_hygiene: true,
    web_security_by_default: true
});
check(gates_partial.ok and not gates_partial.ready_for_public_1_0_stable, "evaluate_1_0_stability_gates blocks when platform matrix is incomplete");
check(gates_partial.passed_count == 6 and len(gates_partial.blocking_gates) == 1, "evaluate_1_0_stability_gates reports 6/7 passed and 1 blocker");

let gates_full = Audit.evaluate_1_0_stability_gates(map{
    ordered_input: true,
    language_backend_parity: true,
    memory_resource_lifetime: true,
    rust_independence_and_isolation: true,
    supply_chain_lock_integrity: true,
    platform_verification_matrix: true,
    public_privacy_hygiene: true,
    web_security_by_default: true
});
check(gates_full.ok and gates_full.ready_for_public_1_0_stable and gates_full.score_pct == 100, "evaluate_1_0_stability_gates approves 7/7 gates");

// ── 4. PB-02-025: Differential Multi-Backend Compiler Parity Suite ───────────
let parity_suite = Parity.run_canonical_parity_suite();
check(parity_suite.ok, "run_canonical_parity_suite passed across all 6 backends");
check(not parity_suite.rust_compiler_required, "parity suite requires 0 Rust compiler involvement");
check(parity_suite.passed_cases == 4 and parity_suite.total_cases == 4, "all 4 canonical differential programs matched across VM, PBCK, C99, x86_64 ELF, ARM64 ELF, and WASM");

print "PUBLIC_RELEASE_READINESS_PASS checks=" + str(passed_checks) + "/" + str(total_checks);
