let post_orth1 = [
    rome.w_edited[0][0]*k_orth1[0] + rome.w_edited[0][1]*k_orth1[1] + rome.w_edited[0][2]*k_orth1[2] + rome.w_edited[0][3]*k_orth1[3],
    rome.w_edited[1][0]*k_orth1[0] + rome.w_edited[1][1]*k_orth1[1] + rome.w_edited[1][2]*k_orth1[2] + rome.w_edited[1][3]*k_orth1[3],
    rome.w_edited[2][0]*k_orth1[0] + rome.w_edited[2][1]*k_orth1[1] + rome.w_edited[2][2]*k_orth1[2] + rome.w_edited[2][3]*k_orth1[3],
    rome.w_edited[3][0]*k_orth1[0] + rome.w_edited[3][1]*k_orth1[1] + rome.w_edited[3][2]*k_orth1[2] + rome.w_edited[3][3]*k_orth1[3]
];
let prior_orth2_0 = w_know[0][2]*k_orth2[2] + w_know[0][3]*k_orth2[3];
let post_orth2_0 = rome.w_edited[0][2]*k_orth2[2] + rome.w_edited[0][3]*k_orth2[3];
check(vec_max_diff(post_orth1, prior_orth1) < 1e-9 and num_abs(post_orth2_0 - prior_orth2_0) < 1e-9, "P7.2 ROME causes < 1e-9 collateral drift on orthogonal keys");

