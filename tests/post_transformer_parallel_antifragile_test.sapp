let d_uw = PT.poincare_distance(p_u, p_w, 1.0);
check(PT.poincare_distance(p_u, p_u, 1.0) < 1e-12 and d_uw <= d_uv + d_vw + 1e-12, "P8.7 Poincaré geodesic distance satisfies identity & triangle inequality");

