];
let k_star = [0.6, 0.8, 0.0, 0.0];       // Target subject key
let k_orth1 = [-0.8, 0.6, 0.0, 0.0];     // Orthogonal key 1 (dot == 0)
let k_orth2 = [0.0, 0.0, 0.70710678, -0.70710678]; // Orthogonal key 2 (dot == 0)
