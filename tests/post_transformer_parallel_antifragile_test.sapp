// ── PILLAR 7: Surgical Rank-1 Causal Model Editing (ROME & LoRA) ─────────────
let w_know = [
    [2.0, -1.0, 0.5, 0.0],
    [0.0, 1.5, -0.5, 1.0],
    [-0.5, 0.5, 2.0, -1.0],
