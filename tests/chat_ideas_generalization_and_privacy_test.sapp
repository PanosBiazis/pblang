    sample_metric: "±0.05 mm Ακρίβεια Κβαντικού Βαθυμέτρου"
};

let custom_prof_app = Wave.instantiate_profession_app(custom_profession_input, "all_editions", "wcag_aaa_ultra_contrast");
check(custom_prof_app.ok, "custom_profession_app_ok");
check(custom_prof_app.profession_id == "quantum_subsea_cartographer", "custom_prof_id_matched");
check(custom_prof_app.sector_id == "deep_ocean_exploration", "custom_prof_sector_id_matched");
check(len(custom_prof_app.supported_editions) == 6, "custom_prof_6_supported_editions");
check(custom_prof_app.support_and_onboarding.interactive_guided_demo.enabled, "custom_prof_interactive_demo_enabled");
check(custom_prof_app.support_and_onboarding.contextual_ai_help_assistant.enabled, "custom_prof_ai_assistant_enabled");
check(custom_prof_app.support_and_onboarding.integrated_live_manual.enabled, "custom_prof_live_manual_enabled");
check(custom_prof_app.support_and_onboarding.built_in_security_and_doctor.enabled, "custom_prof_security_doctor_enabled");
check(custom_prof_app.support_and_onboarding.built_in_security_and_doctor.zero_admin_portable_supported, "custom_prof_zero_admin_portable_supported");
check(custom_prof_app.compiled_editions.desktop_native_records > 0, "custom_prof_desktop_records_present");
check(custom_prof_app.compiled_editions.web_studio_pwa_records > 0, "custom_prof_web_records_present");
check(custom_prof_app.compiled_editions.mobile_android_ios_records > 0, "custom_prof_mobile_records_present");
check(custom_prof_app.compiled_editions.polyform_14_targets_ready, "custom_prof_polyform_14_targets_ready");

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
// 6. AAP Unified Fabric: Fixed-Point Reconciliation & Strict Confidentiality/Redaction
// Verifies:
// - Exact 6-decimal fixed-point reconciliation, overflow-safe split arithmetic, and largest-remainder integer shares
// - Strict private repository enforcement, JWT/bearer/password zero-leak redaction, and in-RAM zeroization
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
let fp_envelope_custom = Wave.evaluate_fixed_point_and_interval_envelope(map{
    value_a: 98765.432100,
    value_b: 98765.432350,
    abs_tolerance: 0.000500,
    rel_tolerance: 0.000010,
    allocation_total_units: 5000,
    allocation_weights: [15.25, 34.75, 50.0],
    supply_v_max: 24.0,
    r_source_ohms: 75.0,
    r_load_min_ohms: 25.0,
    r_load_max_ohms: 150.0,
    timebase: "UTC",
    window_start_ms: 1000,
    window_end_ms: 7200000,
    busy_end_ms: 2400000
});

check(fp_envelope_custom.ok, "fp_envelope_custom_ok");
check(fp_envelope_custom.fixed_point_reconcile.within_tolerance, "fp_custom_reconcile_within_tolerance");
check(fp_envelope_custom.fixed_point_reconcile.split_product_overflow_safe, "fp_custom_overflow_safe");
check(fp_envelope_custom.largest_remainder_allocation.exact_sum_preserved, "fp_custom_exact_sum_preserved");
check(fp_envelope_custom.largest_remainder_allocation.allocated_sum == 5000, "fp_custom_allocated_sum_5000");
check(fp_envelope_custom.analytical_interval_envelope.interior_stationary_hit, "fp_custom_stationary_hit");
check(fp_envelope_custom.analytical_interval_envelope.max_load_power_w > 0.0, "fp_custom_max_power_positive");

let conf_redaction_custom = Wave.enforce_strict_confidentiality_and_redaction(map{
    repo_visibility: "private",
    raw_log_line: "AUTH_INIT client=enterprise_agent token=secret_tok_991 pass=top_secret_quantum_key_xyz999"
});

check(conf_redaction_custom.ok, "conf_redaction_custom_ok");
check(conf_redaction_custom.repository_visibility == "private", "conf_custom_repo_strictly_private");
check(conf_redaction_custom.public_exposure_blocked, "conf_custom_public_exposure_blocked");
check(conf_redaction_custom.raw_secrets_redacted, "conf_custom_raw_secrets_redacted");
check(not str_contains(conf_redaction_custom.redacted_preview, "secret_tok_991"), "conf_custom_no_leak_secret_tok");
check(not str_contains(conf_redaction_custom.redacted_preview, "top_secret_quantum_key"), "conf_custom_no_leak_pass");
check(conf_redaction_custom.memory_zeroization_on_drop, "conf_custom_memory_zeroization_on_drop");

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
// 7. AAP Deep Domain Engines: Wave 12 Specialized Runtime Subsystems
// Verifies:
// - PBIDE: Line-offset rope indexer, binary search offset lookup, and symbol extraction
// - PBCalc / PBMath: Exact rational reduction (7/15 + 4/9 = 41/45), Kahan summation, Aitken acceleration
// - PBGroupStats / PBTableCheck: Welford streaming mean/variance and relational table integrity
// - PBSensory / PBTesterStudio: Savitzky-Golay quadratic denoiser, monotone Hermite PCHIP, orthogonal pairwise suite
// - PBPlan / PBTile / PBQuote / PBBraveAddon: Critical Path Method (CPM), Guillotine 2D packing, B2B quote guard,
//   and Manifest V3 DOM anti-exfiltration shield with secret redaction
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
let custom_source_code = "let GLOBAL_CFG = map{ mode: \"strict\" };\n// Line 2 comment\nfn calculate_trajectory(x, y, z) {\n    let norm = (x * x + y * y + z * z);\n    return norm;\n}\nfn execute_telemetry_flush() {\n    return true;\n}\nexport calculate_trajectory, execute_telemetry_flush;\n";
let ide_rope_res = Wave.evaluate_ide_rope_and_symbol_engine(map{
    source_text: custom_source_code,
    query_byte_offset: 65
});
check(ide_rope_res.ok, "ide_rope_res_ok");
check(ide_rope_res.line_count >= 10, "ide_rope_ge_10_lines_counted");
check(ide_rope_res.resolved_line == 3, "ide_rope_resolved_line_in_function");
check(ide_rope_res.symbols_count == 5, "ide_rope_5_symbols_extracted");

let num_rational_res = Wave.evaluate_numerical_series_and_rational_engine(map{
    num_a: 7, den_a: 15,
    num_b: 4, den_b: 9,
    series: [1000000.0, 0.0000001, -1000000.0, 0.0000002, 3.14159, -3.14159],
    s0: 1.0,
    s1: 0.6666666666666666,
    s2: 0.8666666666666667
});
check(num_rational_res.ok, "num_rational_res_ok");
check(num_rational_res.rational_sum.canonical == "41/45", "num_rational_canonical_41_45");
check(num_rational_res.rational_sum.numerator == 41 and num_rational_res.rational_sum.denominator == 45, "num_rational_components_exact");
check(num_rational_res.aitken_acceleration.convergence_improved, "num_aitken_convergence_improved");

let stats_integrity_res = Wave.evaluate_streaming_stats_and_table_integrity(map{
    samples: [5.0, 15.0, 25.0, 35.0, 45.0, 55.0],
    rows: [
        map{ id: "ORD-101", foreign_id: "CUST-A", amount: 1200 },
        map{ id: "ORD-102", foreign_id: "CUST-B", amount: 2400 },
        map{ id: "ORD-103", foreign_id: "CUST-A", amount: 800 },
        map{ id: "ORD-104", foreign_id: "CUST-C", amount: 1600 }
    ],
    parent_keys: ["CUST-A", "CUST-B", "CUST-C", "CUST-D"]
});
check(stats_integrity_res.ok, "stats_integrity_res_ok");
check(stats_integrity_res.welford_stats.count == 6, "stats_welford_count_6");
check(stats_integrity_res.welford_stats.mean == 30.0, "stats_welford_mean_30");
