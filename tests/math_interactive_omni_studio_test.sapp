// PBLang Sovereign Mathematics v2.5.0 — Comprehensive End-to-End Integration Test
// Verifies:
// 1. Custom Functions (simple, multivariable, deeply nested compositions, piecewise, recursion, Lagrange f'(x), cycle guard)
// 2. Interactive Variables, Range Sliders (once / loop / ping_pong), Parameter Sweeps & Real-Time Autonomous Stepping
// 3. Statistical & Unit-Scale Invariance Concept Explorers (xbar, SS, s^2, s, CV%, dual bells, k-scaling CV vs D=s^2/xbar, formula probe)
// 4. 100% Pure-PBLang PhotoMath (2D Bitmap OCR + 3-method tutor + investigate_function), GeoGebra/Desmos, MATLAB/Control/Simulink, Mathematica
// 5. Omni-Dimensional Grapher (0D/1D, 2D, C, 3D, 4D SO(4) + slice, N-D Parallel/PCA/Andrews, Poincare Disk) in Instantaneous (SVG + BMP) & Live modes + Native gfx* Math Studio

let MATH = import("stdlib:mathematics.sapp");

let passed = 0;
fn check(cond, msg) {
    if not cond {
        throw "ASSERTION FAILED: " + msg;
    }
    passed = passed + 1;
}

fn approx(a, b, tol = 1e-6) {
    return num_abs((a * 1.0) - (b * 1.0)) <= tol;
}

print "=== PBLang v2.6.0 Interactive Lab, Flagship Suites & Omni-Dimensional Grapher Test ===";

// 0. Catalog & Version Verification
let cat = MATH.catalog();
check(cat.version == "2.6.0", "mathematics.sapp version == 2.6.0");
check(cat.categories_count == 25, "catalog has 25 macro-branches");

// ── 1. Custom Functions, Deep Compositions, Lagrange Prime Derivatives, Piecewise & Recursion ──
MATH.clear_functions();
let def_f = MATH.define_function("f(x) = x^2 + 1");
let def_g = MATH.define_function("g(x, a) = sin(a * x) + f(x)");
let def_h = MATH.define_function("h(x, y, z) = g(x + y, z) / (1 + f(z))");
let def_u = MATH.define_function("u(t) = h(cos(t), sin(t), 2)");
check(len(MATH.list_functions()) == 4, "4 custom functions registered");

let exp_u = MATH.expand_user_functions("u(0)");
let val_u0 = MATH.cas().eval_ast(exp_u.ast, map{});
// At t = 0: x+y = 1+0 = 1, z = 2 => g(1, 2)/(1 + f(2)) = (sin(2) + 2)/(1 + 5) = (sin(2) + 2)/6
check(approx(val_u0, (num_sin(2.0) + 2.0) / 6.0, 1e-9), "4-layer nested custom composition u(0)");

// Implicit multiplication preserved alongside multivariable user calls
let sol_quad = MATH.solve("f(x) = 10", "x");
check(sol_quad.ok and len(sol_quad.values) == 2, "solve('f(x) = 10') finds 2 roots (-3 and 3)");
let sol_imp = MATH.solve("x(x - 3) = 0", "x");
check(sol_imp.ok and len(sol_imp.values) == 2, "1-arg implicit multiplication x(x - 3) = 0 preserved");

// Lagrange prime notation f'(x) and Chain Rule f'(g(x, 1))
MATH.define_function("p(x) = x^3 - 4*x");
let dp_2 = MATH.cas().eval_ast(MATH.cas().parse_math("p'(2)"), map{});
let d2p_2 = MATH.cas().eval_ast(MATH.cas().parse_math("p''(2)"), map{});
check(approx(dp_2, 8.0, 1e-9), "Lagrange prime p'(2) == 8");
check(approx(d2p_2, 12.0, 1e-9), "Lagrange second prime p''(2) == 12");

let diff_comp = MATH.diff("f(sin(x))", "x");
let dc_val = MATH.cas().eval_ast(MATH.cas().parse_math(diff_comp.ascii), map{ x: 0.7 });
check(approx(dc_val, 2.0 * num_sin(0.7) * num_cos(0.7), 1e-8), "symbolic diff of composed custom function f(sin(x))");

// Piecewise & Recursive factorial + infinite cycle guard
MATH.define_function("ramp_sat(x) = piecewise(x < -1, -1, x <= 1, x, 1)");
check(approx(MATH.cas().eval_ast(MATH.cas().parse_math("ramp_sat(-3.5)"), map{}), -1.0, 1e-9), "piecewise branch 1");
check(approx(MATH.cas().eval_ast(MATH.cas().parse_math("ramp_sat(0.4)"), map{}), 0.4, 1e-9), "piecewise branch 2");
check(approx(MATH.cas().eval_ast(MATH.cas().parse_math("ramp_sat(9.0)"), map{}), 1.0, 1e-9), "piecewise default branch");

MATH.define_function("fact(n) = piecewise(n <= 1, 1, n * fact(n - 1))");
let fact6 = MATH.cas().eval_ast(MATH.cas().parse_math("fact(6)"), map{});
check(approx(fact6, 720.0, 1e-9), "recursive custom function fact(6) == 720");

MATH.define_function("bad_cyc(x) = bad_cyc(x + 1)");
let cyc_caught = false;
try {
    let _unused = MATH.expand_user_functions("bad_cyc(1)");
} catch err {
    cyc_caught = true;
}
check(cyc_caught, "mutual/self cycle guard prevents unbounded AST expansion");
MATH.clear_functions();

print "  [1] Custom Functions OK: u(0)=" + str(val_u0) + ", p'(2)=" + str(dp_2) + ", fact(6)=" + str(fact6);

// ── 2. Interactive Variable Lab, Sliders & Real-Time Autonomous Stepping ─────
let lab = MATH.create_lab(map{ name: "wave_packet_lab" });
lab.define("envelope(x, sigma) = exp(-(x^2) / (2 * sigma^2))");
lab.define("packet(x, t, k, omega, sigma) = envelope(x - 0.5*t, sigma) * cos(k*x - omega*t)");
lab.set_many(map{ x: 0.4, k: 3.0, omega: 4.0, sigma: 1.2 });

let v_t0 = lab.eval("packet(x, 0, k, omega, sigma)");
check(approx(v_t0, num_exp(-0.16 / 2.88) * num_cos(1.2), 1e-8), "lab.eval multivariable nested custom packet");

// Slider stepping modes: once, loop, ping_pong
lab.slider("a", 0.0, 2.0, 1.0, map{ initial: 0.0, mode: "ping_pong", playing: true });
lab.step(1); check(approx(lab.get("a"), 1.0, 1e-9), "ping_pong step 1 -> 1.0");
lab.step(1); check(approx(lab.get("a"), 2.0, 1e-9), "ping_pong step 2 -> 2.0");
lab.step(1); check(approx(lab.get("a"), 1.0, 1e-9), "ping_pong step 3 bounces -> 1.0");

// Full parameter sweep with sparkline & root tracking
lab.slider("c", -2.0, 2.0, 0.5, map{ initial: -2.0, mode: "once" });
let sweep = lab.run_sweep("x^2 + c", "c", map{ track_roots_var: "x", xmin: -5.0, xmax: 5.0 });
check(sweep.ok and sweep.steps_count == 9, "run_sweep 9 steps over [-2, 2]");
check(len(sweep.summary.sparkline_unicode) == 9, "Unicode sparkline generated for sweep");
check(len(sweep.steps[0].roots_in_window) == 2 and len(sweep.steps[8].roots_in_window) == 0, "sweep tracks 2 real roots at c=-2 and 0 real roots at c=+2");

// Real-time wall-clock autonomous stepping!
lab.slider("t", 0.0, 4.0, 0.1, map{ initial: 0.0, mode: "ping_pong", speed: 6.0, playing: true });
let cb_frames = 0;
let live_run = lab.play_realtime("packet(x, t, k, omega, sigma)", 120, 25, fn(frm) {
    cb_frames = cb_frames + 1;
});
check(live_run.ok and live_run.frames_count >= 3 and cb_frames == live_run.frames_count, "play_realtime autonomous stepping executed real frames");
check(lab.get("t") > 0.0, "slider t advanced autonomously over wall-clock time");

print "  [2] Interactive Lab OK: sweep sparkline=" + sweep.summary.sparkline_unicode + ", live frames=" + str(live_run.frames_count) + " (t=" + str(lab.get("t")) + ")";

// ── 3. Statistical & Unit-Scale Invariance Concept Explorers ─────────────────
let sd_samp = MATH.stddev_explorer([4, 7, 8, 10, 11], true);
let sd_pop = MATH.stddev_explorer([4, 7, 8, 10, 11], false);
check(approx(sd_samp.mean, 8.0, 1e-9) and approx(sd_samp.ss, 30.0, 1e-9), "stddev_explorer mean=8, SS=30");
check(approx(sd_samp.variance, 7.5, 1e-9) and approx(sd_pop.variance, 6.0, 1e-9), "sample s^2=7.5 vs population sigma^2=6.0");
check(len(sd_samp.steps_cards) == 4 and len(sd_samp.deviation_table.rows) == 5, "4 Greek/English step cards + 5 deviation rows");

let sd_out = MATH.stddev_explorer("with_outlier", true);
check(sd_out.dominant_observation.share_of_ss_pct > 70.0, "outlier x5=26 dominates squared-deviation SS (>70%)");

let cv_cmp = MATH.cv_comparison_explorer(50.0, 5.0, 200.0, 15.0, 10.0);
check(approx(cv_cmp.cv_a_pct, 10.0, 1e-9) and approx(cv_cmp.cv_b_pct, 7.5, 1e-9), "CV_A=10% and CV_B=7.5%");
check(cv_cmp.status_a_el == "Ομοιογενές" and cv_cmp.more_homogeneous == "B", "CV homogeneity classification in Greek");

let sc_inv = MATH.scale_invariance_explorer(8.0, 7.5, 100.0);
check(approx(sc_inv.cv.before, sc_inv.cv.after, 1e-12) and sc_inv.cv.unit_independent, "CV = s/|xbar| invariant under k=100");
check(approx(sc_inv.cv_sq.before, sc_inv.cv_sq.after, 1e-12) and sc_inv.cv_sq.unit_independent, "CV^2 = s^2/xbar^2 invariant under k=100");
check(approx(sc_inv.dispersion_index_D.after, 100.0 * sc_inv.dispersion_index_D.before, 1e-9) and not sc_inv.dispersion_index_D.unit_independent, "Fano D = s^2/xbar scales by k=100 (unit-dependent)");

let probe_cv = MATH.formula_invariance_probe("sqrt((x - y)^2) / (abs(x) + abs(y))", map{ x: 4.0, y: 10.0 }, 100.0, 5.0);
check(probe_cv.scale_invariant and probe_cv.homogeneity_degree == 0.0, "formula_invariance_probe detects degree-0 scale invariance");

print "  [3] Statistical Explorers OK: s^2=" + str(sd_samp.variance) + ", CV_B=" + str(cv_cmp.cv_b_pct) + "%, D_100x=" + str(sc_inv.dispersion_index_D.after);

// ── 4. Pure-PBLang PhotoMath, GeoGebra/Desmos, MATLAB/Simulink & Mathematica ─
// 4a. PhotoMath 2D Bitmap Render + OCR + Multi-Method Tutor
let bmp_2d = MATH.render_math_bitmap("(x^2 - 9)/(x - 3)");
let scan_res = MATH.photomath_scan_and_solve(bmp_2d, "x");
check(scan_res.ok and scan_res.layout_features.fraction_count >= 1 and scan_res.layout_features.superscript_count >= 1, "PhotoMath 2D fraction + superscript bitmap OCR");
check(scan_res.ascii == "x + 3", "PhotoMath OCR simplifies (x^2 - 9)/(x - 3) -> x + 3");

let tutor_q = MATH.photomath_tutor("x^2 - 5*x + 6 = 0", "x");
check(tutor_q.ok and len(tutor_q.methods) == 3, "PhotoMath quadratic tutor provides 3 pedagogical methods (Discriminant, Factoring/Viete, Completing Square)");

let inv_fn = MATH.investigate_function("(x^2 + 1)/(x - 1)", "x", -8.0, 8.0);
check(inv_fn.ok and len(inv_fn.asymptotes.vertical) == 1 and approx(inv_fn.asymptotes.vertical[0], 1.0, 1e-3), "investigate_function finds vertical asymptote x=1");
check(len(inv_fn.asymptotes.oblique) >= 1, "investigate_function finds oblique asymptote y = x + 1");

// 4b. GeoGebra Dynamic Geometry DAG & Desmos Nonlinear Fit
let geo = MATH.create_geogebra_canvas();
geo.add_point("A", 0.0, 0.0);
geo.add_point("B", 6.0, 0.0);
geo.add_point("C", 2.0, 4.0);
let tri = geo.triangle_centers("A", "B", "C");
check(tri.euler_line.collinear and approx(tri.euler_line.ratio_OG_to_GH, 0.5, 1e-6), "GeoGebra Euler line O-G-H collinear with OG:GH = 1:2");

let xs_fit = [0.0, 1.0, 2.0, 3.0, 4.0];
let ys_fit = [];
let fi = 0;
while fi < len(xs_fit) {
    push(ys_fit, 3.0 * num_exp(-0.5 * xs_fit[fi]) + 1.2);
    fi = fi + 1;
}
let dfit = MATH.desmos_fit("a * exp(-b * x) + c", ["a", "b", "c"], xs_fit, ys_fit, map{ a: 2.0, b: 0.3, c: 1.0 });
check(dfit.ok and dfit.r_squared > 0.999999 and approx(dfit.params.a, 3.0, 1e-3), "Desmos Levenberg-Marquardt nonlinear curve fit R^2 > 0.999999");

// 4c. MATLAB Control Systems (Transfer Function, Bode, Step) & Simulink Closed-Loop PID
let S = MATH.suites();
let plant = S.tf([1.0], [1.0, 2.0, 2.0]);
let bd = MATH.bode(plant, 0.1, 10.0, 25);
let stp = MATH.step_response(plant, 8.0, 0.02);
check(len(bd.mag_db) == 25 and stp.is_stable and approx(stp.steady_state, 0.5, 1e-2), "MATLAB Bode & Step Response of 1/(s^2+2s+2)");

let sim = MATH.create_simulink_model();
sim.add_step("ref", 0.0, 0.0, 1.0);
sim.add_sum("err", "+-");
sim.add_pid("pid", 8.0, 5.0, 1.5);
sim.add_integrator("plant_int", 0.0);
sim.add_scope("out_scope");
sim.connect("ref", "err", 0);
sim.connect("plant_int", "err", 1);
sim.connect("err", "pid", 0);
sim.connect("pid", "plant_int", 0);
sim.connect("plant_int", "out_scope", 0);
let sim_out = sim.simulate(4.0, 0.01);
let y_trace = sim_out.scopes.out_scope;
check(sim_out.ok and approx(y_trace[len(y_trace) - 1], 1.0, 0.03), "Simulink closed-loop PID converges to unit step 1.0");

// 4d. Mathematica Symbolic Term Rewriting, FixedPoint & Pade Approximant
let rew = MATH.replace_repeated("ln(a * b * c)", ["ln(x_ * y_) -> ln(x_) + ln(y_)"]);
check(rew.ok and rew.converged and rew.ascii == "ln(a) + ln(b) + ln(c)", "Mathematica replace_repeated symbolic pattern rule");
let fp_cos = S.fixed_point("cos(x)", "x", 1.0, 1e-12, 120);
check(fp_cos.converged and approx(fp_cos.value, 0.739085133215, 1e-9), "Mathematica FixedPoint Dottie number cos(x)=x");
let pade = MATH.pade_approximant("exp(x)", "x", 0.0, 2, 2);
check(pade.ok and approx(pade.eval_at(0.5), num_exp(0.5), 2e-4), "Mathematica [2/2] Pade approximant of exp(x)");

print "  [4] Flagship Suites OK: OCR='" + scan_res.ascii + "', Desmos R^2=" + str(dfit.r_squared) + ", PID y(4s)=" + str(y_trace[len(y_trace) - 1]);

// ── 5. Omni-Dimensional Grapher (0D–ND + Non-Euclidean, Instantaneous & Live, SVG & BMP, Native Studio) ──
let ODG = MATH.grapher();

// Multi-space scene manipulation & verification across 0D/1D, 2D, C, 3D, 4D, N-D, Hyperbolic
let sc_2d = MATH.create_scene(map{ title: "2D Explicit, Implicit & Vector Field", xmin: -4.0, xmax: 4.0, ymin: -4.0, ymax: 4.0 });
let lid1 = sc_2d.add_layer(ODG.layer_2d_explicit("sin(x + t) * cos(0.5*x)", -4.0, 4.0));
let lid2 = sc_2d.add_layer(ODG.layer_2d_implicit("x^2 + y^2 - 4", -4.0, 4.0, -4.0, 4.0, 32));
let lid3 = sc_2d.add_layer(ODG.layer_2d_vector_field("-y", "x", -3.0, 3.0, -3.0, 3.0, 9, [[1.5, 0.0]]));
check(len(sc_2d.list_layers()) == 3, "2D scene holds 3 heterogeneous layers");
sc_2d.pan(0.5, -0.25);
sc_2d.zoom(1.2);
sc_2d.toggle_layer(lid3, false);
sc_2d.toggle_layer(lid3, true);
let svg_2d = sc_2d.render_svg(800, 480);
let bmp_2d_img = sc_2d.render_bmp_bytes(320, 200);
check(str_starts_with(svg_2d, "<svg") and str_contains(svg_2d, "</svg>"), "2D scene renders valid SVG");
check(len(bmp_2d_img) > 192000 and bmp_2d_img[0] == 66 and bmp_2d_img[1] == 77, "2D scene renders valid 24-bit BM raster bytes");

// Complex Domain Coloring, 1D Boxplot/Histogram, 3D Surface + Lorenz, 4D SO(4) Tesseract + Hypersurface Slice, 6D Parallel Coords + PCA + Andrews, Poincare Disk
let svg_cplx = MATH.quick_svg(ODG.layer_complex_domain("x^3 - 3*x*y^2 - 1", "3*x^2*y - y^3", -2.0, 2.0, -2.0, 2.0, 20), 640, 420);
check(str_starts_with(svg_cplx, "<svg"), "2D Complex C domain coloring z^3 - 1 SVG");

let sc_3d = MATH.create_scene(map{ title: "3D Surface & Lorenz Attractor" });
sc_3d.add_layer(ODG.layer_3d_surface("sin(sqrt(x^2 + y^2 + 0.01))", -3.0, 3.0, -3.0, 3.0, 16, 16));
sc_3d.add_layer(ODG.layer_3d_parametric_curve("lorenz"));
sc_3d.rotate_3d(25.0, -10.0, 5.0);
let svg_3d = sc_3d.render_svg(800, 500);
check(str_starts_with(svg_3d, "<svg"), "3D Painter-sorted surface + Lorenz attractor SVG");

let sc_4d = MATH.create_scene(map{ title: "4D SO(4) Tesseract & Hypersurface Slice" });
sc_4d.add_layer(ODG.layer_4d_polytope("tesseract"));
sc_4d.add_layer(ODG.layer_4d_hypersurface_slice("x^2 + y^2 + z^2 - 2.5", nil, "z", 0.4, 14));
sc_4d.rotate_4d("xw", 0.55);
sc_4d.rotate_4d("yz", 0.35);
sc_4d.set_slice("w", 0.25);
let svg_4d = sc_4d.render_svg(800, 500);
check(str_starts_with(svg_4d, "<svg"), "4D SO(4) rotor + w=w0 hyperplane slice SVG");

let nd_data = [
    [5.1, 3.5, 1.4, 0.2, 1.1, 0.8],
    [4.9, 3.0, 1.4, 0.2, 1.0, 0.7],
    [6.7, 3.1, 4.7, 1.5, 2.4, 1.9],
    [6.3, 2.9, 5.6, 1.8, 3.1, 2.5],
    [7.2, 3.6, 6.1, 2.5, 3.5, 2.8]
];
let sc_nd = MATH.create_scene(map{ title: "6D Parallel Coordinates, Brushing & PCA" });
sc_nd.add_layer(ODG.layer_nd_parallel_coords(nd_data, ["x1", "x2", "x3", "x4", "x5", "x6"]));
sc_nd.set_brush(2, 4.0, 6.5);
sc_nd.reorder_axes([2, 3, 0, 1, 4, 5]);
let svg_nd = sc_nd.render_svg(800, 460);
let svg_pca = MATH.quick_svg(ODG.layer_nd_pca_projection(nd_data, ["A", "A", "B", "C", "C"], 3), 720, 460);
let svg_andrews = MATH.quick_svg(ODG.layer_nd_andrews_curves(nd_data, 64), 720, 440);
let svg_poin = MATH.quick_svg(ODG.layer_poincare_disk([[[-0.6, 0.2], [0.5, 0.4]], [[-0.3, -0.7], [0.6, -0.2]]]), 600, 600);
check(str_starts_with(svg_nd, "<svg") and str_starts_with(svg_pca, "<svg") and str_starts_with(svg_andrews, "<svg") and str_starts_with(svg_poin, "<svg"), "6D Parallel/Brushing + 3D PCA + Andrews Curves + Hyperbolic Poincare Disk SVGs");

// Live Real-Time Multi-Dimensional Scene Playback (`play_live`)
let live_sc = sc_4d.play_live(110, 25);
check(live_sc.ok and live_sc.frames >= 2 and live_sc.last_primitive_count > 10, "4D scene play_live real-time rotor animation");

// Statistical Concept Explorer Dashboard SVG + Native Math Studio across all 6 tabs
let stat_svg = MATH.render_statistical_concept_svg(map{ values: [4, 7, 8, 10, 11], is_sample: true, scale_k: 100.0 });
check(str_starts_with(stat_svg, "<svg") and str_contains(stat_svg, "CV"), "Greek Statistical & Unit-Invariance Dashboard SVG");

let studio_res = MATH.run_native_math_studio(map{ max_frames: 6, cycle_tabs: true, virtual: true });
check(studio_res.ok and studio_res.rendered_frames == 6 and len(studio_res.tabs_visited) == 6 and studio_res.draw_ops > 100, "Native Math Studio rendered all 6 interactive tabs cleanly");

print "  [5] Omni-Dimensional Grapher & Native Studio OK: 4D live frames=" + str(live_sc.frames) + ", BMP bytes=" + str(len(bmp_2d_img)) + ", Studio tabs=" + str(len(studio_res.tabs_visited)) + "/6 (" + str(studio_res.draw_ops) + " draw ops)";
print "ALL " + str(passed) + " ASSERTIONS PASSED!";
