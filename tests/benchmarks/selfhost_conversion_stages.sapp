let t0=now_ms();let F=import("stdlib:compiler/selfhost_frontend.sapp");let V=import("stdlib:compiler/vm.sapp");
let t1=now_ms();let r=F.frontend_compile("memory_alloc(7);push_lifetime();borrow_immutable(1);memory_alloc(9);parse_number(\"bad\");");assert(r.ok,"fixture compile");let code=r.chunk;
let t2=now_ms();let n=0;for i 100 {let c=V.execution_context(true);let failed=try {V.run_seeded(code,map{},c);false} catch true;V.close_execution(c);assert(failed,"guest must escape");n=n+1;}assert(n==100,"escape count");let t3=now_ms();print "stages "+str([t1-t0,t2-t1,t3-t2]);print "escape_benchmark_pass";
