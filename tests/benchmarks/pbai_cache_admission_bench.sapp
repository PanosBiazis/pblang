// Run the unchanged public-load benchmark against exact current sources.
let U=import("stdlib:uuid.sapp");let parent=path_dirname(cwd());
let exe=env_get("PBLANG_BIN");assert(type(exe)=="string" and exe!="","trusted runtime required");
let base=env_get("PBAI_STATE_ROOT");assert(type(base)=="string" and base!="","private state required");
let root=path_join(base,"cache-cost-"+U.v4());let step=["setup"];let output=[nil];
fn run(args) {let argv=["-k","1s","120s","/usr/bin/env","-C",root,exe];for arg in args {push(argv,arg);}return proc_spawn_wait("/usr/bin/timeout",argv);}
fn exercise() {
 fs_mkdirs(path_join(root,"stdlib"));
 let owner=fs_read(path_join(parent,"pblang/stdlib/llm_tiered_store.sapp"));fs_write(path_join(root,"stdlib/llm_tiered_store.sapp"),owner);
 assert(fs_read(path_join(root,"stdlib/llm_tiered_store.sapp"))==owner,"exact current owner copied");
 fs_write(path_join(root,"stdlib/linux_dirfs.sapp"),fs_read("tests/fixtures/pbai_cache_cost_dirfs.sapp"));
 fs_write(path_join(root,"streaming.sapp"),fs_read(path_join(parent,"pbai/stdlib/pbai_streaming.sapp")));
 fs_write(path_join(root,"embedded.sapp"),fs_read(path_join(parent,"pblang/stdlib/ai/pbai/stdlib/pbai_streaming.sapp")));
 fs_write(path_join(root,"main.sapp"),fs_read("tests/fixtures/pbai_cache_cost_case.sapp"));
 fs_write(path_join(root,"pblang.toml"),"[package]\nname=\"cache-cost-benchmark\"\nversion=\"0.1.0\"\nentry=\"main.sapp\"\n[dependencies]\nstdlib={path=\"stdlib\"}\n");
 step[0]="build";let built=run(["build"]);assert(built.exit_code==0 and str_contains(built.stdout,"build ok"),"benchmark builds");
 step[0]="measurement";let result=run(["run","main.sapp","--deny-net","--deny-http","--deny-ffi","--deny-exec","--deny-spawn"]);
 assert(result.exit_code==0,"benchmark child completes");let value=json_parse(result.stdout);
 assert(value.format=="pbai.cache-admission-benchmark.v1" and len(value.rows)==9 and value.batch==128 and value.warmups==2 and value.sample_count==7,"complete fixed benchmark record");
 for row in value.rows {assert(len(row.samples)==7,"all timed samples present");}output[0]=value;
}
let passed=try {exercise();true} catch false;
let removed=proc_spawn_wait("/bin/rm",["-rf","--",root]);
assert(passed,"cache benchmark: "+step[0]);assert(removed.exit_code==0,"owned benchmark fixture cleaned");
print json_stringify(output[0]);
