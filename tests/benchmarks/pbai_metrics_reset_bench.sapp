let AI=import("stdlib/pbai.sapp");let S=import("stdlib:pbai_sensor.sapp");let R=import("stdlib:controlled_modularity.sapp");
let binding=AI.modular_bind("sensor-v1",S,R);
let request=map{values:[2,4,6,100],period_seconds:1,sigma:3,absolute_tolerance:1};
let result=binding.run(request);let encoded=json_stringify(result);
let retained=binding.metrics();binding.cancel();
fn maps() {
 let parts=str_split(gc_stats()," ");
 for part in parts {let field=str_split(part,"=");if len(field)==2 and field[0]=="map_allocs" {return parse_number(field[1]);}}
 throw "map allocation counter unavailable";
}
fn reset_batch() {let count=0;while count<1000 {binding.clear_metrics();count=count+1;}}
let warm=0;while warm<3 {reset_batch();warm=warm+1;}
let samples=[];let sample=0;
while sample<9 {
 let before=maps();let started=now_ms();reset_batch();let elapsed=now_ms()-started;let after=maps();
 push(samples,map{map_allocations:after-before,elapsed_ms:elapsed});sample=sample+1;
}
assert(json_stringify(result)==encoded and retained.executed_calls==1,"caller results and snapshots retained unchanged");
assert(binding.status().cancelled and binding.metrics().observed_calls==0,"clearing cancelled binding cannot reactivate it");
print json_stringify(map{format:"pbai.reset-measurement.v1",batch:1000,warmups:3,sample_count:9,
 counter_scope:"process-cumulative-allocations-not-live-memory",clock:"now_ms-wall-clock",samples:samples});
