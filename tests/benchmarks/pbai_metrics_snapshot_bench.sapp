let AI=import("stdlib/pbai.sapp");let S=import("stdlib:pbai_sensor.sapp");let R=import("stdlib:controlled_modularity.sapp");
let request=map{values:[2,4,6,100],period_seconds:1,sigma:3,absolute_tolerance:1};
let binding=AI.modular_bind_limited("sensor-v1",S,R,map{max_calls:2});
let good=binding.run(request);let failed=binding.run(nil);binding.cancel();
let expected=json_stringify(binding.metrics());let good_json=json_stringify(good);let failed_json=json_stringify(failed);
fn field(raw,key) {for word in str_split(raw," ") {let parts=str_split(word,"=");if len(parts)==2 and parts[0]==key {return parse_number(parts[1]);}}throw "counter unavailable";}
fn batch(held) {let i=0;while i<1000 {push(held,binding.metrics());i=i+1;}}
let warm=0;while warm<3 {let held=[];batch(held);warm=warm+1;}
let rows=[];let sample=0;
while sample<9 {
 let held=[];let before=gc_stats();let started=now_ms();batch(held);let elapsed=now_ms()-started;let after=gc_stats();
 assert(len(held)==1000 and json_stringify(held[0])==expected and json_stringify(held[999])==expected,"caller retains full detached snapshots");
 push(rows,map{elapsed_ms:elapsed,map_allocations:field(after,"map_allocs")-field(before,"map_allocs"),string_allocations:field(after,"string_allocs")-field(before,"string_allocs")});sample=sample+1;
}
binding.clear_metrics();assert(binding.status().cancelled and json_stringify(good)==good_json and json_stringify(failed)==failed_json,"lifetime state and caller outputs preserved");
print json_stringify(map{format:"pbai.snapshot-benchmark.v1",warmups:3,sample_count:9,batch:1000,
 scope:"process-wide-cumulative-allocations-not-live-memory",clock:"now_ms-wall-clock",
 string_probe_overhead:1,retained_snapshots_per_batch:1000,samples:rows});
