    assert_true(loop22_1.ok == true and loop22_1.supported_languages_count == 28 and loop22_1.lexicographic_ranking_termination_proven == true, "v22.1.0 loop & termination prover must support 28 languages");

    let omni22_1 = v22_1.evaluate_all_category_36x288x1536_omniscience_swarm(map{});
    assert_true(omni22_1.ok == true and omni22_1.total_elastic_specialists == 104 and omni22_1.macro_categories_count == 36 and omni22_1.subcategories_count == 288 and omni22_1.thematic_micro_domains_count == 1536, "v22.1.0 omniscience swarm must cover 36x288x1536 with 104 elastic specialists");

    let semver22_1 = v22_1.evaluate_semver_and_concise_naming_governor(map{});
