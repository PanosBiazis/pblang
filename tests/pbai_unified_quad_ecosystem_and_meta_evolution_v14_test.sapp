    assert_true(saga22_1.ok == true and saga22_1.effective_tool_dispatch_latency_ms == 0.015 and saga22_1.orphaned_side_effects_on_abort == 0, "v22.1.0 Binary Register MCP Saga must achieve 0.015ms dispatch and 0 orphaned side effects");

