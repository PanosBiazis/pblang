check(pbexp.duplicate_clusters_found == 1, "PB-Explorer-Ultra SHA-256 deduplicator found 1 duplicate cluster");
check(pbexp.reclaimable_bytes == 2048, "PB-Explorer-Ultra calculated 2048 reclaimable bytes");
check(pbexp.quarantined_threats == 1, "PB-Explorer-Ultra quarantined high-entropy RWX binary before preview");
