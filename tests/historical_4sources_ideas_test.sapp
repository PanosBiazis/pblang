// 17. CC-Corp-5: Guard Break-Test, RLS Non-Superuser, SSRF Egress Block, Monotonic Lease & Export-View Equivalence
let ccc5_bad = Eng.evaluate_guard_break_test_and_export_view_equivalence(true, true, "postgres", false, 50, 49, 19038, 21937);
