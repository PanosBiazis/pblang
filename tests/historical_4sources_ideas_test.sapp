// 18. PB-Explorer-Ultra: Sovereign File Explorer & VFS Manager (Dual-Pane, Mount Auto-Heal, Dedup, AV & Batch Rename)
let pbexp = Eng.evaluate_sovereign_file_explorer_manager([
    map{ path: "/proj/a.sapp", size_bytes: 2048, sha256: "dup_sha", entropy: 4.5, has_rwx: false, preview_text: "secret=topsecret" },
    map{ path: "/proj/b_dup.sapp", size_bytes: 2048, sha256: "dup_sha", entropy: 4.5, has_rwx: false, preview_text: "clean" },
    map{ path: "/proj/malware.bin", size_bytes: 4096, sha256: "mal_sha", entropy: 7.98, has_rwx: true, preview_text: "RWX" }
], [
    map{ protocol: "smb", uri: "smb://127.0.0.1:1445/f/Transf/panosb", tunnel_port: 1445, ssh_agent_sock: "/run/user/1000/gcr/ssh", mounted: true }
], "file_{index}_{stem}.{ext}");
