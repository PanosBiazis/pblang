// tests/semantics/async_enrich_test.sapp — fix + enrichment for stdlib/async.sapp
//
// BUG: go() treated a task that RETURNED nil as a failure ("task returned nil")
//   AND masked real thrown errors as nil. A nil-returning task now succeeds with
//   value nil; a thrown error is reported as a real failure (detected via a
//   throw-sentinel, since pblang's catch can't bind the error). ENRICH:
//   all_settled (never throws), gather (spawn many + await all).

let async = import("stdlib/async.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── value task still works ───────────────────────────────────────────────────────
eq(async.await(async.go(fn() { return 42; })), 42, "value task awaits to value");

// ── FIX: nil-returning task succeeds with nil (does not throw) ────────────────────
let r = try async.await(async.go(fn() { return nil; })) catch "THREW";
eq(r, nil, "nil-returning task awaits to nil, not an error");

// ── FIX: a throwing task is reported as a failure ────────────────────────────────
let threw = try async.await(async.go(fn() { throw "boom"; })) catch "FAILED";
eq(threw, "FAILED", "throwing task surfaces as await failure");

// ── ENRICH: gather runs many and returns results in order ────────────────────────
let g = async.gather([fn() { return 1; }, fn() { return 2; }, fn() { return 3; }]);
eq(len(g), 3, "gather count"); eq(g[0], 1, "gather[0]"); eq(g[2], 3, "gather[2]");

// ── ENRICH: all_settled never throws, reports per-task ok ─────────────────────────
let settled = async.all_settled([async.go(fn() { return 7; }), async.go(fn() { throw "x"; })]);
eq(settled[0].ok, true, "all_settled ok task"); eq(settled[0].value, 7, "all_settled value");
eq(settled[1].ok, false, "all_settled failed task reported, not thrown");

// ── map_parallel still works ─────────────────────────────────────────────────────
let mp = async.map_parallel([1, 2, 3], fn(x) { return x * 10; });
eq(mp[0], 10, "map_parallel[0]"); eq(mp[2], 30, "map_parallel[2]");

print "async_enrich_pass";
