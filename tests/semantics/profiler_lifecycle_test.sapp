let P=import("stdlib:profiler.sapp");
fn expect(ok,label) {if not ok {throw "FAIL profiler-lifecycle: "+label;}}
P.reset();
expect(P.elapsed("missing")==0 and P.end("missing")==0 and P.since("missing")==0
    and P.between("missing","also-missing")==0 and P.count("missing")==0,"missing metrics start at zero");
P.start("phase");
let duration=P.end("phase");
expect(type(duration)=="number" and P.elapsed("phase")==duration,"local clock wrapper works");
let calls=0;
let empty=P.benchmark("empty",fn(){calls=calls+1;return 1;},0);
expect(empty.iterations==0 and empty.total_ms==0 and empty.avg_ms==0
    and empty.min_ms==0 and empty.max_ms==0 and empty.result==nil and calls==0,"empty benchmark");
P.reset();P.disable();
let returned=P.trace(fn(){calls=calls+1;return 42;});
expect(returned==42 and calls==1,"disabled tracing still executes callback once");
expect(len(P.trace_log())==0 and P.report().marks_count==0,"disabled tracing collects nothing");
P.enable();
returned=P.trace(fn(){return P.trace(fn(){return "inner";});});
expect(returned=="inner" and len(P.trace_log())==2,"nested trace returns and records each callback");
expect(P.report().marks_count==0,"trace does not overwrite shared marks");
let records=P.trace_log();
expect(records[0].result_type=="string" and records[1].result_type=="string","trace types");
expect(type(records[0].elapsed_ms)=="number" and type(records[1].elapsed_ms)=="number","trace durations");
let caught=try P.trace(fn(){throw "expected-profiler-fixture-error";}) catch "caught";
expect(caught=="caught" and len(P.trace_log())==2,"callback exception propagates without success record");
P.reset();
expect(P.inc("work")==1 and P.dec("work")==0,"counter lifecycle");
P.set_counter("work",5);expect(P.count("work")==5,"set counter");
P.mark("first");P.mark("last");
expect(type(P.between("first","last"))=="number" and type(P.since("first"))=="number","marks remain available");
P.clear_traces();expect(len(P.trace_log())==0,"clear traces");
P.reset();expect(P.report().marks_count==0 and len(P.report().sections)==0,"reset");
print "profiler_lifecycle_pass";
