let CPU = import("stdlib:emulator_msp430.sapp");

fn value(instructions) {
    let result = CPU.run(CPU.program(instructions));
    if not result.ok { throw result.error; }
    return result.value;
}

let encoded = CPU.move_immediate(5, 15);
assert(encoded[0] == 16447 and encoded[1] == 5, "canonical MOV immediate encoding");
assert(CPU.halt()[0] == 53298 and CPU.jump(-1)[0] == 16383, "canonical HALT/JMP encodings");
assert(value([CPU.move_immediate(21, 15), CPU.halt()]) == 21, "MOV immediate");
assert(value([CPU.move_immediate(20, 4), CPU.add_immediate(22, 4), CPU.move_register(4, 15), CPU.halt()]) == 42, "ADD immediate");
assert(value([CPU.move_immediate(30, 4), CPU.move_immediate(12, 5), CPU.add_register(5, 4), CPU.move_register(4, 15), CPU.halt()]) == 42, "ADD register");
assert(value([CPU.move_immediate(50, 4), CPU.subtract_immediate(8, 4), CPU.move_register(4, 15), CPU.halt()]) == 42, "SUB immediate");
assert(value([CPU.move_immediate(65530, 4), CPU.add_immediate(10, 4), CPU.move_register(4, 15), CPU.halt()]) == 4, "16-bit wrap");
assert(value([CPU.move_immediate(5, 4), CPU.move_immediate(1, 15), CPU.compare_immediate(5, 4), CPU.jump_zero(2), CPU.move_immediate(99, 15), CPU.halt()]) == 1, "JZ taken");
assert(value([CPU.move_immediate(6, 4), CPU.move_immediate(1, 15), CPU.compare_immediate(5, 4), CPU.jump_zero(2), CPU.move_immediate(99, 15), CPU.halt()]) == 99, "JZ not taken");
assert(value([CPU.move_immediate(0, 15), CPU.move_immediate(6, 4), CPU.move_immediate(7, 5),
              CPU.add_register(5, 15), CPU.subtract_immediate(1, 4), CPU.jump_not_zero(-4), CPU.halt()]) == 42, "software multiply");

assert(not CPU.run([16447]).ok, "truncated immediate fails closed");
assert(not CPU.run([65535]).ok, "unknown opcode fails closed");
assert(not CPU.run(CPU.program([CPU.jump(-1)]), map{ instruction_budget: 4 }).ok, "loop budget enforced");
assert((try CPU.move_register(16, 0) catch nil) == nil, "invalid register rejected");
assert((try CPU.jump_zero(512) catch nil) == nil, "invalid jump displacement rejected");

print "emu_msp430: reusable bounded subset passed encodings, arithmetic, malformed-code, register, jump, and budget checks";
