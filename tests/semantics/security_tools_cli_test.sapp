fn fail(message) { throw "FAIL security_tools_cli: " + message; }
fn require(value, message) { if value != true { fail(message); } }

let compiler = if fs_exists("/proc/self/exe") { "/proc/self/exe" } else { "pblang" };
let root = "/tmp/pblang_security_tools_" + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 12);
let source = root + ".sapp";
let config = root + ".json";
fs_write(source, "unsafe_device_mode();\n");
fs_write(config, json_stringify(map{ custom_rules: [
    map{ id: "device.unsafe-mode", severity: "high", needle: "unsafe_device_mode(",
        message: "unsafe device mode" }
], disabled_rule_ids: [], allow_high_suppressions: false }));

let blocked = proc_spawn_wait(compiler, ["tools/pbsecure.sapp", "--allow-all", "--",
    source, "--mode=protect", "--config=" + config]);
require(blocked.exit_code == 1, "custom high rule blocks pbsecure");
let blocked_report = json_parse(str_trim(blocked.stdout));
require(blocked_report.finding_count == 1 and blocked_report.findings[0].id == "device.unsafe-mode",
    "pbsecure emits the configured rule finding");

let disabled = proc_spawn_wait(compiler, ["tools/pbsecure.sapp", "--allow-all", "--",
    source, "--mode=protect", "--config=" + config, "--disable-rule=device.unsafe-mode"]);
require(disabled.exit_code == 0 and json_parse(str_trim(disabled.stdout)).finding_count == 0,
    "one invocation can disable a configured rule");

let selected = proc_spawn_wait(compiler, ["tools/pbanalyze.sapp", "--allow-all", "--",
    source, "--analysis=performance"]);
require(selected.exit_code == 0 and json_parse(str_trim(selected.stdout)).analyses[0] == "performance",
    "pbanalyze accepts a selective analysis category");

try fs_remove(source) catch nil;
try fs_remove(config) catch nil;
print "security_tools_cli_pass";
