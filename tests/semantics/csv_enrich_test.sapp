// tests/semantics/csv_enrich_test.sapp — fixes + enrichment for stdlib/csv.sapp
//
// SECURITY: CSV/formula injection — a field beginning with = + - @ (or tab/CR) is
//   executed as a formula by Excel/Sheets. sanitize_field()/stringify_safe() guard
//   it by prefixing a single quote. (Plain stringify stays lossless by design.)
// ENRICH: parse_typed (number/bool coercion), TSV helpers, columnar transforms
//   (to_columns / from_columns).

let csv = import("stdlib/csv.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base behavior unchanged ──────────────────────────────────────────────────────
let r = csv.parse("a,b\n1,2", ",", true);
eq(r[0].a, "1", "parse still works"); eq(r[0].b, "2", "parse b");

// ── SECURITY: formula-injection sanitization ─────────────────────────────────────
eq(csv.sanitize_field("=1+2"), "'=1+2", "sanitize = formula");
eq(csv.sanitize_field("+cmd"), "'+cmd", "sanitize + formula");
eq(csv.sanitize_field("-2+3"), "'-2+3", "sanitize - formula");
eq(csv.sanitize_field("@SUM(A1)"), "'@SUM(A1)", "sanitize @ formula");
eq(csv.sanitize_field("safe"), "safe", "sanitize leaves plain text");
let evil = [map{ name: "=HYPERLINK(\"http://evil\")", note: "ok" }];
let safe_out = csv.stringify_safe(evil, ",", ["name", "note"]);
// the dangerous value must be neutralized (leading quote) in the output
if str_index_of(safe_out, "'=HYPERLINK") < 0 { fail("stringify_safe must neutralize formula, got: " + safe_out); }

// ── ENRICH: parse_typed coerces numbers + booleans ───────────────────────────────
let t = csv.parse_typed("n,active,name\n42,true,Jo\n3.5,false,Al", ",", true);
eq(t[0].n, 42, "typed number int"); eq(t[0].active, true, "typed bool true"); eq(t[0].name, "Jo", "typed string kept");
eq(t[1].n, 3.5, "typed float"); eq(t[1].active, false, "typed bool false");

// ── ENRICH: TSV helpers ──────────────────────────────────────────────────────────
let tsv = csv.parse_tsv("a\tb\n1\t2", true);
eq(tsv[0].a, "1", "parse_tsv"); eq(tsv[0].b, "2", "parse_tsv b");
let tout = csv.stringify_tsv([map{ a: "x", b: "y" }], ["a", "b"]);
eq(tout, "a\tb\nx\ty\n", "stringify_tsv");

// ── ENRICH: columnar transforms round-trip ───────────────────────────────────────
let rows = [map{ id: "1", city: "NYC" }, map{ id: "2", city: "LA" }];
let cols = csv.to_columns(rows);
eq(len(cols.id), 2, "to_columns id length"); eq(cols.id[0], "1", "to_columns id[0]"); eq(cols.city[1], "LA", "to_columns city[1]");
let back = csv.from_columns(cols);
eq(len(back), 2, "from_columns length"); eq(back[0].id, "1", "from_columns row0 id"); eq(back[1].city, "LA", "from_columns row1 city");

print "csv_enrich_pass";
