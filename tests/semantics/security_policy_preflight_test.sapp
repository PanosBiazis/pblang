let S=import("stdlib:security_analysis.sapp");
let D=import("stdlib:security_dependency_analysis.sapp");
fn expect(ok,label) {if not ok {throw "FAIL security-policy-preflight: "+label;}}
let malformed=map{custom_rules:[map{id:"bad id",needle:"private-rule-marker",severity:"high"}]};
// Baseline reaches entry_source handling before rejecting this pattern policy.
let early=D.analyze_entry("policy-no-read.sapp",map{entry_source:42,security:malformed});
expect(not early.ok and early.error=="invalid security analysis configuration","pattern policy before source handling");
for value in [true,1,"private-rule-marker",[],fn(){return nil;}] {
    expect(not S.validate_policy(value).ok,"pattern non-map options rejected");
    expect(not D.validate_policy(value).ok,"dependency non-map options rejected");
}
for policy in [map{disabled_rule_ids:[]},map{custom_rules:[]},map{},
    map{custom_rules:[map{id:"fixture.rule",needle:"value",severity:"HIGH"}],minimum_blocking_severity:"INFO"}] {
    let before=json_stringify(policy);let result=S.validate_policy(policy);
    expect(result.ok and len(result)==1,"pattern success is outcome-only");
    expect(json_stringify(policy)==before,"policy unchanged");
    result.ok=false;result.rules=[];expect(len(S.validate_policy(policy))==1,"fresh result no shared rule refs");
}
for policy in [malformed,map{custom_rules:nil},map{custom_rules:[nil]},map{disabled_rule_ids:["bad id"]},
    map{allow_high_suppressions:1},map{minimum_blocking_severity:"private-rule-marker"}] {
    let result=S.validate_policy(policy);let actual=S.analyze("","fixture.sapp",policy);
    expect(not result.ok and result.error==actual.error,"preflight error agrees with analysis");
    expect(json_stringify(result.configuration_errors)==json_stringify(actual.configuration_errors),"exact configuration errors");
    expect(not str_contains(json_stringify(result),"private-rule-marker"),"no policy-value echo");
}
let many=[];for i 129 {push(many,map{id:"fixture.rule",needle:"value"});}
expect(not S.validate_policy(map{custom_rules:many}).ok,"rule count cap");
for mode in ["protect","strict","audit"] {
    let opts=map{security_mode:mode,security:malformed};
    let check=D.validate_policy(opts);
    expect(not check.ok and check.error==early.error,"all dependency modes reject before I/O");
    opts.security=map{taint_sources:nil,custom_rules:nil};
    expect(D.validate_policy(opts).ok,"dependency nil-as-unset resolution retained");
}
let options=map{security:map{taint_sources:[nil],custom_rules:[nil]},max_taint_tokens:0};
expect(D.analyze_entry("",options).error=="invalid entry path","entry path precedes policy");
expect(D.analyze_entry("fixture.sapp",map{security_mode:"unknown",security:malformed}).error=="invalid security mode","entry mode precedes policy");
expect(str_starts_with(D.validate_policy(options).error,"max_taint_tokens"),"numeric error precedence");
options.max_taint_tokens=65536;
expect(D.validate_policy(options).error=="taint_sources must contain bounded names","taint precedes pattern errors");
options.security.taint_sources=[];
expect(D.validate_policy(options).error==early.error,"pattern follows taint");
expect(not D.validate_policy(map{security_mode:"unknown"}).ok,"invalid mode rejected");
expect(str_starts_with(D.validate_policy(map{max_modules:0,security_mode:"unknown"}).error,"max_modules"),"dependency limits precede mode");
expect(D.validate_policy(map{security_mode:"unknown",max_taint_tokens:0}).error=="invalid security mode","mode precedes taint limits");
for field in ["custom_rules","disabled_rule_ids","allow_high_suppressions"] {
    let valid_value=if field=="allow_high_suppressions" {false} else {[]};
    let fallback="security_"+field;
    let nested=map{};nested[field]=valid_value;
    let outer=map{security:nested};outer[fallback]=42;
    expect(D.validate_policy(outer).ok,"valid nested pattern overrides bad fallback");
    nested[field]=nil;
    expect(not D.validate_policy(outer).ok,"nested nil uses invalid fallback");
    outer[fallback]=valid_value;
    expect(D.validate_policy(outer).ok,"nested nil uses valid fallback");
    nested[field]=42;
    expect(not D.validate_policy(outer).ok,"bad nested overrides valid fallback");
}
let valid=map{security:map{custom_rules:[],taint_sources:[]}};
let admitted=D.validate_policy(valid);expect(admitted.ok and len(admitted)==1,"dependency outcome contains no policies");
push(valid.security.custom_rules,nil);admitted.ok=true;valid.validated=true;
expect(not D.validate_policy(valid).ok,"previous outcome and supplied flag do not bypass mutation");
expect(not D.analyze_entry("fixture.sapp",map{entry_source:"let value=1;",security:valid.security}).ok,"analysis revalidates changed policy");
print "security_policy_preflight_pass";
