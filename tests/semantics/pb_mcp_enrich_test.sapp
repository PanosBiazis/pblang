// tests/semantics/pb_mcp_enrich_test.sapp — enrichment for stdlib/pb_mcp.sapp

let M = import("stdlib/pb_mcp.sapp");

fn fail(m) { throw "FAIL " + m; }
fn contains(arr, v) { let i = 0; while i < len(arr) { if arr[i] == v { return true; } i = i + 1; } return false; }

// ── tool_names ──────────────────────────────────────────────────────────────────────
let names = M.tool_names();
if not contains(names, "read_file") { fail("catalog has read_file"); }
if not contains(names, "watch_probe") { fail("catalog has watch_probe"); }
if len(names) != len(M.tool_catalog()) { fail("tool_names count matches catalog"); }

// ── has_tool ──────────────────────────────────────────────────────────────────────
if not M.has_tool("grep_code") { fail("has grep_code"); }
if M.has_tool("nonexistent_tool") { fail("unknown tool -> false"); }

// ── tools_by_profile ──────────────────────────────────────────────────────────────
let watchers = M.tools_by_profile("watchers");
if len(watchers) < 1 { fail("at least one watcher tool"); }
let i = 0;
while i < len(watchers) { if watchers[i].profile != "watchers" { fail("filtered by profile"); } i = i + 1; }
let core = M.tools_by_profile("core-code");
if len(core) < 1 { fail("at least one core-code tool"); }

print "pb_mcp_enrich_pass";
