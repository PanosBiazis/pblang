// tests/semantics/floatn_enrich_test.sapp — enrichment for stdlib/floatn.sapp
// Adds quantization-quality metrics: mse, max_abs_error, snr_db, compare_formats.

let F = import("stdlib/floatn.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let xs = [1.0, 0.5, 0.1, 0.123, 3.14159];

// ── base still works ─────────────────────────────────────────────────────────────
eq(F.quantize(1.0, "f16"), 1.0, "f16 quantizes 1.0 exactly");

// ── ENRICH: mse — zero for f64 (lossless here), positive for f16 ─────────────────
eq(F.mse(xs, "f64"), 0, "mse f64 = 0 (lossless)");
if F.mse(xs, "f16") <= 0 { fail("mse f16 should be positive"); }
if F.mse(xs, "f16") > 0.001 { fail("mse f16 should be small, got " + str(F.mse(xs, "f16"))); }

// ── ENRICH: max_abs_error ────────────────────────────────────────────────────────
eq(F.max_abs_error(xs, "f64"), 0, "max_abs_error f64 = 0");
if F.max_abs_error(xs, "f16") <= 0 { fail("max_abs_error f16 should be positive"); }

// ── ENRICH: snr_db — f16 has high but finite SNR ─────────────────────────────────
let snr = F.snr_db(xs, "f16");
if snr < 40 { fail("f16 SNR should be well above 40 dB, got " + str(snr)); }

// ── ENRICH: compare_formats ──────────────────────────────────────────────────────
let cmp = F.compare_formats(0.1, ["f16", "f64"]);
eq(len(cmp), 2, "compare_formats count");
eq(cmp[0].name, "f16", "compare_formats name");
eq(cmp[1].error, 0, "f64 quantizes 0.1 with zero error");
if cmp[0].error <= 0 { fail("f16 should have nonzero error on 0.1"); }

print "floatn_enrich_pass";
