let V=import("stdlib:table_cell_view.sapp");let S=import("stdlib:sheet_document.sapp");let UI=import("stdlib:modern_ui.sapp");let G=import("stdlib:gui.sapp");let doc=S.create(2,8);doc.cells[1][0]=str_repeat("x",256);doc.cells[1][1]="μικρό";let before=S.encode(doc);let view=V.create(doc,1);for target in ["native","web","android"]{assert(len(UI.compile(view,map{target:target,width:412,height:915}).records)>0,"portable row");}let form=UI.build("table",view,map{width:800,height:1000});G.get(form,"select_1").onclick(form);assert(G.get(form,"cell_line_0").text=="μικρό" and G.get(form,"cell_line_10").text=="","selection clears long cells");assert(G.get(form,"selected_column").text=="Column 2","selection label");assert(S.encode(doc)==before,"view input preserved");for row in [-1,2,0.5,"0"]{assert((try V.create(doc,row) catch nil)==nil,"row bounds");}print "table_cell_view_pass";
