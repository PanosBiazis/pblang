// tests/semantics/money_enrich2_test.sapp — wave 2 for stdlib/money.sapp
// allocate (proportional, no lost cents) + parse (currency strings).

let M = import("stdlib/money.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn sum_parts(parts) {
    let t = M.cents(0);   // 0
    let acc = "0";
    let i = 0;
    while i < len(parts) { acc = M.add(acc, parts[i]); i = i + 1; }
    return acc;
}

// ── allocate: equal weights, indivisible total -> no lost cents ────────────────────
let p = M.allocate("1.00", [1, 1, 1]);
eq(len(p), 3, "3 parts");
eq(M.compare(sum_parts(p), "1.00"), 0, "parts sum exactly to total");
eq(M.compare(p[0], "0.34"), 0, "first gets the extra cent");
eq(M.compare(p[1], "0.33"), 0, "second part");

// tiny amount
let q = M.allocate("0.05", [1, 1, 1]);
eq(M.compare(sum_parts(q), "0.05"), 0, "5 cents fully allocated");

// weighted
let w = M.allocate("1.00", [3, 1]);
eq(M.compare(w[0], "0.75"), 0, "3:1 -> 0.75");
eq(M.compare(w[1], "0.25"), 0, "3:1 -> 0.25");

// ── parse: strip $ , and spaces ─────────────────────────────────────────────────────
eq(M.compare(M.parse("$1,234.56"), "1234.56"), 0, "parse currency");
eq(M.compare(M.parse("-$5"), "-5"), 0, "parse negative");
eq(M.compare(M.parse("42"), "42"), 0, "parse plain");

print "money_enrich2_pass";
