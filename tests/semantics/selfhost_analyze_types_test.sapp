let F = import("stdlib:compiler/selfhost_frontend.sapp");
for source in [
    "fn f(x:number){return x;} f();",
    "let a=[1]; let x=a[missing_index];",
    "let x:number=nil-1;"
] {
    let parsed = F.frontend_parse_safe(source);
    assert(parsed.ok, "type-invalid source is syntactically valid");
    let result = F.frontend_analyze(source);
    assert(not result.ok and len(result.errors) > 0, "analysis rejects invalid types/names/arity");
    assert(len(result.diagnostics) > 0, "structured type diagnostics retained");
    assert(result.tokens_count > 0 and result.stmt_count > 0, "analysis metadata preserved");
}
for source in ["let x=1; print x;", "fn f(x:number){return x;} f(3);", "let a=[1]; let x=a[0];"] {
    assert(F.frontend_analyze(source).ok, "valid analysis");
}
let broken = F.frontend_analyze("let x = ;");
assert(not broken.ok and len(broken.errors) > 0 and len(broken.diagnostics) == 0, "parse errors precede typecheck");
print "selfhost_analyze_types_pass";
