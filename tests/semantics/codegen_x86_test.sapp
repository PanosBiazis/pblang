// tests/semantics/codegen_x86_test.sapp — 32-bit x86 (i386) backend: the SAME register IR
// compiled to legacy 32-bit machine code + ELF32, the format that runs on decades of older
// x86 hardware. Verified by RUNNING the static ELF32 and reading its exit code.

let CG = import("stdlib/codegen_x86.sapp");

fn fail(m) { throw "FAIL " + m; }

fn run_rc(ir, tag) {
    let elf = CG.compile_program(ir);
    let path = "pbx86_" + tag + ".bin";
    fs_write_bytes(path, elf);
    proc_spawn_wait("bash", ["-c", "chmod +x " + path]);
    let r = proc_spawn_wait("bash", ["-c", "./" + path + "; echo RC=$?"]);
    proc_spawn_wait("bash", ["-c", "rm -f " + path]);
    let out = try r.stdout catch "";
    let idx = str_index_of(out, "RC=");
    if idx < 0 { fail(tag + ": no exit code (<<" + str(out) + ">>)"); }
    return parse_number(str_trim(str_slice(out, idx + 3, len(out))));
}
fn eqrc(ir, want, tag) {
    let got = run_rc(ir, tag);
    if got != want { fail(tag + " exit got=" + str(got) + " want=" + str(want)); }
}

// it really is a 32-bit ELF: ELFCLASS32 and EM_386
let probe = CG.compile_program([["seti", 0, 0]]);
if probe[4] != 1 { fail("ELFCLASS32 (e_ident[4]==1)"); }
if probe[18] != 3 { fail("EM_386 (e_machine low byte==3)"); }
if probe[76] != 5 { fail("ordinary ELF32 segment must be RX, not writable"); }

let value_elf = CG.build_value([["seti", 0, 7]]);
if value_elf[76] != 5 { fail("build_value must use stack output and keep code RX"); }

let compact_add = CG.compile_ir([["addi", 0, 23]]);
if CG.compile_ir([["movr", 0, 1]]) != [0x89, 0xC8] { fail("movr eax,ecx encoding"); }
if len(compact_add) != 3 or compact_add[0] != 0x83 { fail("addi imm8 encoding"); }
let inc32 = CG.addi_r(2, 1);
if len(inc32) != 1 or inc32[0] != 0x42 { fail("addi one must select one-byte inc r32"); }
let compact_if = CG.compile_ir([["ifnz", 1, [["add", 0, 1]], []]]);
if len(compact_if) != 6 or compact_if[2] != 0x74 { fail("ifnz rel8 encoding"); }
let compact_loop = CG.compile_ir([["loop", 1, [["add", 0, 1]]]]);
if len(compact_loop) != 9 or compact_loop[2] != 0x74 or compact_loop[7] != 0x75 { fail("loop rel8 encoding"); }

eqrc([["seti", 0, 2], ["seti", 1, 3], ["add", 0, 1], ["seti", 1, 4], ["mul", 0, 1], ["seti", 1, 1], ["sub", 0, 1]], 19, "arith");
eqrc([["seti", 0, 100], ["addi", 0, 23]], 123, "addi");
eqrc([["seti", 0, 0], ["seti", 1, 10], ["loop", 1, [["add", 0, 1]]]], 55, "loop_sum");
eqrc([["seti", 0, 7], ["seti", 1, 0], ["loop", 1, [["addi", 0, 5]]]], 7, "loop_zero");

// Bodies beyond rel8 range must transparently select near jumps.
let long_body = [];
let li = 0;
while li < 70 { push(long_body, ["add", 0, 2]); li = li + 1; }
eqrc([["seti", 0, 0], ["seti", 1, 1], ["seti", 2, 1], ["ifnz", 1, long_body, [["seti", 0, 9]]]], 70, "ifnz_near");
eqrc([["seti", 0, 0], ["seti", 1, 2], ["seti", 2, 1], ["loop", 1, long_body]], 140, "loop_near");

print "codegen_x86_pass";
