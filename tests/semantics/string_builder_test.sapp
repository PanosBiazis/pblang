let B = import("stdlib:string_builder.sapp");

fn fail(message) { throw "FAIL string_builder: " + message; }
fn eq(actual, expected, message) { if actual != expected { fail(message + " got=" + str(actual)); } }

let b = B.new();
B.write(b, "alpha");
B.write(b, 42);
B.write_line(b, "!");
B.write_join(b, ["x", "y", "z"], ",");
eq(B.finish(b), "alpha42!\nx,y,z", "chunk composition");
eq(B.length(b), len("alpha42!\nx,y,z"), "tracked length");
eq(B.chunk_count(b), 5, "chunk count");

eq(B.take(b), "alpha42!\nx,y,z", "take returns output");
eq(B.is_empty(b), true, "take clears builder");
B.write_all(b, ["a", "b", "c"]);
eq(B.finish(b), "abc", "write_all");
B.clear(b);
eq(B.length(b), 0, "clear length");

let bounded = B.new(4);
B.write(bounded, "ab");
B.write(bounded, "cd");
let overflow = try { B.write(bounded, "e"); false } catch true;
eq(overflow, true, "max_chars fails closed");
eq(B.finish(bounded), "abcd", "overflow leaves content unchanged");

print "string_builder_pass";
