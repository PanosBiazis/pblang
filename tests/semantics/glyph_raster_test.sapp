// tests/semantics/glyph_raster_test.sapp — stdlib/glyph_raster.sapp
//
// The rasterization core that FILLS the glyph atlas: turn a glyph outline (contours of
// line/quadratic-bezier segments, as TrueType 'glyf' provides) into an alpha coverage
// bitmap via even-odd scanline fill, then blit it into the atlas texture. Font-format
// agnostic (a TTF byte-parser feeds it outlines); pure + deterministic.

let GR = import("stdlib/glyph_raster.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.001 { fail(m + " got=" + str(a)); } }
fn truthy(c, m) { if c != true { fail(m); } }

// ── empty bitmap ────────────────────────────────────────────────────────────────────
let b = GR.bitmap_new(6, 6);
eq(GR.get(b, 0, 0), 0, "fresh bitmap is empty");
eq(b.w, 6, "bitmap width");

// ── scanline fill of a square contour (one contour = a closed polygon) ──────────────
let square = [[map{ x: 1, y: 1 }, map{ x: 5, y: 1 }, map{ x: 5, y: 5 }, map{ x: 1, y: 5 }]];
let bmp = GR.rasterize(square, 6, 6);
truthy(GR.get(bmp, 3, 3) > 0, "pixel inside the square is filled");
truthy(GR.get(bmp, 2, 2) > 0, "another interior pixel filled");
eq(GR.get(bmp, 0, 0), 0, "pixel outside stays empty");
eq(GR.get(bmp, 5, 5), 0, "corner just outside the half-open span stays empty");

// ── even-odd rule: a hole (inner contour) is NOT filled ─────────────────────────────
let ring = [
    [map{ x: 0, y: 0 }, map{ x: 10, y: 0 }, map{ x: 10, y: 10 }, map{ x: 0, y: 10 }],   // outer
    [map{ x: 3, y: 3 }, map{ x: 7, y: 3 }, map{ x: 7, y: 7 }, map{ x: 3, y: 7 }]         // inner hole
];
let rb = GR.rasterize(ring, 10, 10);
truthy(GR.get(rb, 1, 5) > 0, "ring wall is filled");
eq(GR.get(rb, 5, 5), 0, "ring center (the hole) is empty");

// ── quadratic bezier flattening (TrueType outlines use quadratics) ──────────────────
let pts = GR.flatten_quad(map{ x: 0, y: 0 }, map{ x: 10, y: 0 }, map{ x: 10, y: 10 }, 4);
eq(len(pts), 5, "steps+1 points");
approx(pts[0].x, 0, "bezier start x"); approx(pts[0].y, 0, "bezier start y");
approx(pts[4].x, 10, "bezier end x"); approx(pts[4].y, 10, "bezier end y");

// ── blit a rasterized glyph into a bigger atlas bitmap at an offset ─────────────────
let atlas = GR.bitmap_new(12, 12);
GR.blit(atlas, GR.rasterize(square, 6, 6), 2, 2);
truthy(GR.get(atlas, 5, 5) > 0, "glyph pixel landed at offset (src 3,3 -> dst 5,5)");
eq(GR.get(atlas, 0, 0), 0, "outside the blit stays empty");

// ── antialiasing: a diagonal edge yields partial coverage (0 < c < 255) ─────────────
let tri = [[map{ x: 0, y: 0 }, map{ x: 4, y: 0 }, map{ x: 0, y: 4 }]];
let aa = GR.rasterize_aa(tri, 4, 4, 4);
truthy(GR.get(aa, 0, 0) > 200, "triangle corner nearly fully covered");
eq(GR.get(aa, 3, 3), 0, "far corner empty");
let sawPartial = false;
let yy = 0;
while yy < 4 {
    let xx = 0;
    while xx < 4 {
        let cvg = GR.get(aa, xx, yy);
        if cvg > 0 and cvg < 255 { sawPartial = true; }
        xx = xx + 1;
    }
    yy = yy + 1;
}
truthy(sawPartial, "AA produces partial-coverage edge pixels");

print "glyph_raster_pass";
