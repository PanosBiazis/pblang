let A=import("stdlib:integer_allocation.sapp");
fn rejects(f) {let bad=false;try {f();}catch {bad=true;}assert(bad,"invalid allocation rejected");}
assert(A.distribute(10,[1,1,1]).shares==[4,3,3],"stable tied remainder");
assert(A.distribute(7,[0,2,1]).shares==[0,5,2],"zero weight receives no share");
assert(A.distribute(0,[1,2]).shares==[0,0],"zero total");
let weights=[1,2,3];let report=A.distribute(11,weights);report.shares[0]=100;assert(weights==[1,2,3],"detached result");
for total in range(0,31) {for x in range(0,5) {for y in range(1,5) {
    let r=A.distribute(total,[x,y,3]);let sum=0;for share in r.shares {sum=sum+share;assert(share>=0 and share==num_floor(share),"integer shares");}
    assert(sum==total,"exact conservation");
    for i in range(0,3) {let quota=total*[x,y,3][i]/(x+y+3);assert(r.shares[i]>=num_floor(quota) and r.shares[i]<=num_ceil(quota),"floor or ceiling quota");}
}}}
let maximum=[];for i in range(0,128) {array_push(maximum,1000000);}let shares=A.distribute(1000000,maximum).shares;let sum=0;for share in shares {sum=sum+share;}assert(sum==1000000,"maximum exact arithmetic budget");
for f in [fn(){A.distribute(-1,[1]);},fn(){A.distribute(1.5,[1]);},fn(){A.distribute(1000001,[1]);},fn(){A.distribute(1,[]);},fn(){A.distribute(1,[0,0]);},fn(){A.distribute(1,[-1,2]);},fn(){A.distribute(1,[0.5]);},fn(){A.distribute(1,["1"]);}] {rejects(f);}
array_push(maximum,1);rejects(fn(){A.distribute(1,maximum);});print "integer_allocation_pass";
