// tests/semantics/pbai_multimodel_test.sapp — pbAI as a multi-model ensemble (voting across
// the native classifier + pluggable external LLM voters) and device-aware batch classification
// that fans out across all CPU cores. Parallel results must match the sequential ones.

let pbai = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── multi-model ensemble (voting) ────────────────────────────────────────────────────
pbai.clear_voters();
let p = "explain what this function does";
eq(pbai.ensemble(p), pbai.classify_scores(p).intent, "ensemble == native when no extra voters");

// register two external voters that agree -> they outvote the native model
pbai.register_voter("modelA", fn(x) { return "improve"; });
pbai.register_voter("modelB", fn(x) { return "improve"; });
eq(pbai.ensemble(p), "improve", "ensemble majority overrides native");
eq(len(pbai.voters()), 2, "two voters registered");
let det = pbai.ensemble_detail(p);
if not map_has(det, "tally") or not map_has(det, "intent") { fail("ensemble_detail shape"); }
pbai.clear_voters();
eq(len(pbai.voters()), 0, "voters cleared");

// ── device capabilities (pbAI knows the machine's power) ────────────────────────────
let cap = pbai.capabilities();
if cap.cpu_cores < 1 { fail("cpu_cores"); }
if not map_has(cap, "gpu") { fail("gpu field present"); }

// ── batch classification, sequential ────────────────────────────────────────────────
let prompts = [
    "explain this code", "find the bug here", "optimize this loop", "add comments to this",
    "how does pblang work", "make this faster", "what is wrong with this", "document this function"
];
let seq = pbai.classify_batch(prompts);
eq(len(seq), len(prompts), "batch length");
let i = 0;
while i < len(prompts) { eq(seq[i], pbai.classify_scores(prompts[i]).intent, "batch[" + str(i) + "] matches single"); i = i + 1; }

// ── parallel batch across all CPU cores == sequential ───────────────────────────────
let par = pbai.classify_batch_parallel(prompts);
eq(len(par), len(seq), "parallel batch length");
let j = 0;
while j < len(seq) { eq(par[j], seq[j], "parallel[" + str(j) + "] == sequential"); j = j + 1; }

// ── AI accelerator routing (CPU/GPU/NPU): smart batch falls back to CPU, or uses a hook ──
let accs = pbai.accelerators();
if len(accs) < 3 { fail("accelerators should list cpu/gpu/npu"); }
// no native runtime -> smart batch == CPU parallel result
eq(pbai.classify_batch_smart(prompts), seq, "smart batch falls back to CPU cores");
// plug a (mock) NPU runtime -> smart batch routes to it
pbai.register_accel("npu", fn(ps) { return ["bugs"]; });
eq(pbai.best_device(), "npu", "best device routes to the NPU runtime");
eq(pbai.classify_batch_smart(prompts), ["bugs"], "smart batch dispatches to the NPU runtime");

print "pbai_multimodel_pass";
