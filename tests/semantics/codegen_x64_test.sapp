// tests/semantics/codegen_x64_test.sapp — pblang generating REAL x86-64 machine code and a
// runnable native Linux ELF, with ZERO Rust in the codegen path. This is the seed of a
// "native mode": instead of running on the VM, pblang emits machine-code bytes, writes an
// ELF, and the bare CPU runs it. The decisive test ACTUALLY EXECUTES the generated binary.

let CG = import("stdlib/codegen_x64.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eqarr(a, b, m) {
    if len(a) != len(b) { fail(m + " len " + str(len(a)) + " vs " + str(len(b))); }
    let i = 0;
    while i < len(a) { if a[i] != b[i] { fail(m + " @" + str(i) + " got=" + str(a[i]) + " want=" + str(b[i])); } i = i + 1; }
}

// ── little-endian encoders ──────────────────────────────────────────────────────────
eqarr(CG.le16(0x3E), [0x3E, 0x00], "le16");
eqarr(CG.le32(60), [60, 0, 0, 0], "le32");
eqarr(CG.le64(0x400000), [0, 0, 0x40, 0, 0, 0, 0, 0], "le64 of 0x400000");

// ── real x86-64 instruction encodings (verifiable against any assembler) ────────────
// mov eax, 60 / mov edi, 1: compact writes preserve non-negative 64-bit values.
eqarr(CG.mov_imm32("rax", 60), [0xB8, 0x3C, 0x00, 0x00, 0x00], "mov eax,60 compact");
eqarr(CG.mov_imm32("rdi", 1), [0xBF, 0x01, 0x00, 0x00, 0x00], "mov edi,1 compact");
// Negative values retain the sign-extending 64-bit C7 form.
eqarr(CG.mov_imm32("rax", 0 - 1), [0x48, 0xC7, 0xC0, 0xFF, 0xFF, 0xFF, 0xFF], "mov rax,-1 sign extends");
// movabs rsi, 0x400078  ->  48 BE 78 00 40 00 00 00 00 00
eqarr(CG.movabs_imm64("rsi", 0x400078), [0x48, 0xBE, 0x78, 0x00, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00], "movabs rsi");
// syscall  ->  0F 05
eqarr(CG.syscall(), [0x0F, 0x05], "syscall");

// ── ELF container ───────────────────────────────────────────────────────────────────
let elf = CG.build_print_exit("hi\n");
eqarr([elf[0], elf[1], elf[2], elf[3]], [0x7F, 0x45, 0x4C, 0x46], "ELF magic \\x7fELF");
if elf[4] != 2 { fail("ELFCLASS64"); }          // e_ident[EI_CLASS] = 2
if elf[16] != 2 { fail("ET_EXEC"); }            // e_type low byte = 2
if elf[18] != 0x3E { fail("EM_X86_64"); }       // e_machine low byte = 0x3E
if elf[68] != 5 { fail("immutable executable must use an RX, never RWX, load segment"); }

// ── THE PROOF: run the generated native binary on the real CPU ──────────────────────
let path = "pbnative_test.bin";
fs_write_bytes(path, elf);
proc_spawn_wait("bash", ["-c", "chmod +x " + path]);
let r = proc_spawn_wait("bash", ["-c", "./" + path]);
let out = try r.stdout catch "";
proc_spawn_wait("bash", ["-c", "rm -f " + path]);
if str_index_of(out, "hi") < 0 { fail("native binary did not print 'hi' (got <<" + str(out) + ">>)"); }

print "codegen_x64_pass";
