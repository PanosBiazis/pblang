// Test: log.sapp
let log = import("stdlib:log.sapp");

// Log to file to test file output
let log_path = "target/test_log.txt";
log.set_output(log_path);
log.set_level("debug");
log.set_format("json");

log.debug("debug message", map{ x: 1 });
log.info("info message", map{ user: "alice" });
log.warn("warn message", nil);
log.log_error("error message", map{ code: 500 });

// Reset to stdout
log.set_output("stdout");
log.set_format("text");

// Verify file was written
let content = try fs_read(log_path) catch nil;
assert(content != nil, "log file should exist");
assert(str_contains(content, "debug message"), "log should contain debug message");
assert(str_contains(content, "info message"), "log should contain info message");
assert(str_contains(content, "error message"), "log should contain error message");

// Test named logger
let mylog = log.new_logger("my-module", "text");
mylog.info("module log", nil);

// Test timed
let result = log.timed("computation", fn() { return 42; });
assert(result == 42, "timed should return fn result");

// Cleanup
try fs_remove(log_path) catch nil;
print "log stdlib tests passed";
