// Test: a real PS/2 keyboard IRQ1 driver, §76.
//
// isr_kbd reads a scancode from the keyboard data port (0x60) and EOIs; installed on
// vector 0x21 it takes the asynchronous IRQ1 the PS/2 controller raises on a keypress.
// Proven END-TO-END in QEMU with a LIVE injected keystroke: the kernel signals
// readiness on serial, the host injects a key via the QEMU monitor (so it arrives
// after `sti`), the handler captures the scancode, and the kernel exits 85. We assert
// the codegen contract here (the boot + injection can't run in the test runner).

let ct = import("stdlib/compiler/ctranspile.sapp");
let intr = fs_read("stdlib/kernel/interrupts.sapp");
let con = fs_read("stdlib/kernel/console.sapp");

let src = "fn isr_kbd() { poke32(36864, kbd_scancode()); poke32(36868, 1); pic_eoi(); } "
    + "fn kmain() { serial_init(); let idt = kmalloc(2048); pic_remap(); "
    + "idt_set_gate(idt, 33, addr_of(\"isr_kbd\"), 8, 142); idt_load(idt); "
    + "poke32(36868, 0); sti(); serial_putc(82); "
    + "while peek32(36868) == 0 { hlt(); } outb(244, 42); while 1 > 0 { hlt(); } }";

let c = ct.transpile_kernel_int(intr + con + src);

// ── The keyboard handler ────────────────────────────────────────────────────────────
assert(str_contains(c, "__attribute__((interrupt)) void isr_kbd(void* _frame)"), "isr_kbd is a GCC interrupt handler");
assert(str_contains(c, "inb(96)"), "reads the keyboard data port 0x60 (scancode)");
assert(str_contains(c, "(long)(u64)&isr_kbd"), "installed on IRQ1 (vector 0x21) via addr_of");
assert(str_contains(c, "outb(32, 32)"), "EOI after handling the key");

// ── Serial readiness handshake (so the host injects after interrupts are live) ───────
assert(str_contains(c, "long serial_init("), "serial console initialised");
assert(str_contains(c, "long serial_putc("), "readiness byte emitted on serial");

assert(not str_contains(c, "double"), "float-runtime-free");
assert(str_contains(c, "0x1BADB002"), "multiboot header present");

print "kernel_keyboard_pass";
