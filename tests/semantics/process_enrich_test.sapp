// tests/semantics/process_enrich_test.sapp — enrichment for stdlib/process.sapp
// Ergonomic wrappers over proc_spawn_wait (needs --allow-exec; harness uses --allow-all).

let P = import("stdlib/process.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : <<" + s + ">>"); } }

// ── run: structured result ─────────────────────────────────────────────────────────
let r = P.run("echo", ["hello"]);
if not r.ok { fail("echo should succeed"); }
eq(r.exit_code, 0, "echo exit 0");
has(r.stdout, "hello", "echo stdout");

// ── output: trimmed stdout ─────────────────────────────────────────────────────────
eq(P.output("echo", ["hi"]), "hi", "output trims newline");

// ── success: true / false ──────────────────────────────────────────────────────────
if not P.success("true", []) { fail("`true` succeeds"); }
if P.success("false", []) { fail("`false` fails"); }

// ── which: resolves an existing command, nil otherwise ────────────────────────────
if P.which("sh") == nil { fail("sh should be found"); }
eq(P.which("definitely_not_a_real_command_xyz123"), nil, "missing cmd -> nil");

// ── check_output: returns stdout on success ───────────────────────────────────────
eq(P.check_output("echo", ["ok"]), "ok", "check_output returns stdout");

// ── spawn_wait still works (back-compat) ──────────────────────────────────────────
let raw = P.spawn_wait("echo", ["x"]);
eq(raw.exit_code, 0, "spawn_wait raw exit_code");

print "process_enrich_pass";
