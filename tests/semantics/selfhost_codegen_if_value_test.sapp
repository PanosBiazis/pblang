// tests/semantics/selfhost_codegen_if_value_test.sapp
//
// DIFFERENTIAL: a block used in value position (an if-expression branch, or a
// block-expression) whose LAST statement is an `if` must yield that if's chosen
// branch value -- matching the Rust VM. codegen_block_expr previously pushed nil
// for any non-expr_stmt tail, so a trailing `if` produced `nil` (proven:
// `let x = if true { if true {3} else {4} } else {5};` gave nil instead of 3).

let fe = import("stdlib/compiler/selfhost_frontend.sapp");

fn fail(m) { throw "FAIL " + m; }
fn val(src) {
    let r = fe.frontend_run(src);
    if not r.ok { fail("compile failed: " + src); }
    return r.globals["x"];
}
fn eq(label, got, want) { if str(got) != str(want) { fail(label + ": got " + str(got) + " want " + str(want)); } }

// trailing if-statement in the THEN branch of an if-expression
eq("nested_then", val("let x = if true { if true { 3 } else { 4 } } else { 5 };"), 3);
// trailing if-statement in the ELSE branch
eq("nested_else", val("let x = if false { 9 } else { if true { 3 } else { 4 } };"), 3);
// trailing if with elif chain
eq("elif_tail", val("let v = 2; let x = if true { if v == 1 { 10 } elif v == 2 { 20 } else { 30 } } else { 0 };"), 20);
// trailing if with NO else → nil when not taken
eq("noelse_taken", val("let x = if true { if true { 7 } } else { 0 };"), 7);
eq("noelse_skipped", val("let x = if true { if false { 7 } } else { 0 };"), nil);

// regressions: plain value tails still work
eq("plain_value", val("let x = if true { 3 } else { 5 };"), 3);
eq("block_with_let", val("let x = if true { let q = 1; q + 2 } else { 5 };"), 3);

print "selfhost_codegen_if_value_pass";
