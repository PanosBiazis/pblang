// tests/semantics/browser_render_enrich_test.sapp — enrichment for stdlib/browser_render.sapp
// Adds pdf_args (pure, chromium print-to-pdf) and is_chromium_family.

let R = import("stdlib/browser_render.sapp");

fn fail(m) { throw "FAIL " + m; }
fn contains(arr, v) { let i = 0; while i < len(arr) { if arr[i] == v { return true; } i = i + 1; } return false; }

// ── base render_args still works ─────────────────────────────────────────────────
let a = R.render_args("http://example.com", "/tmp/out.png", 800, 600, "chromium");
if not contains(a, "http://example.com") { fail("render_args includes url"); }

// ── ENRICH: pdf_args (chromium --print-to-pdf) ───────────────────────────────────
let pa = R.pdf_args("http://example.com", "/tmp/out.pdf");
if not contains(pa, "--print-to-pdf=/tmp/out.pdf") { fail("pdf_args has print-to-pdf flag: " + str(pa)); }
if not contains(pa, "http://example.com") { fail("pdf_args includes url"); }

// ── ENRICH: is_chromium_family ───────────────────────────────────────────────────
if not R.is_chromium_family("chromium") { fail("chromium is chromium-family"); }
if not R.is_chromium_family("google-chrome") { fail("chrome is chromium-family"); }
if R.is_chromium_family("firefox") { fail("firefox is NOT chromium-family"); }

print "browser_render_enrich_pass";
