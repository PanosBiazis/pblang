let View=import("stdlib:pipeline_timing_view.sapp");let UI=import("stdlib:modern_ui.sapp");let GUI=import("stdlib:gui.sapp");
let Web=import("stdlib:modern_ui_web.sapp");let Android=import("stdlib:modern_ui_android.sapp");
let source=json_stringify(map{format:"pblang.pipeline-estimate.v1",jobs:[map{id:"private_marker",needs:[]},map{id:"second",needs:[]}],durations_ms:map{private_marker:5,second:10}});
let tree=View.create(source);assert(not str_contains(json_stringify(tree),"private_marker"),"portable view omits job IDs and source");
for target in ["native","web","android"] {
    for width in [412,1000] {assert(len(UI.compile(tree,map{target:target,width:width,height:915}).records)>0,"shared view compiles");}
}
let web=Web.generate("Timing",UI.compile(tree,map{target:"web",width:412,height:915}));assert(web.actions==2,"two portable job actions");
assert(not str_contains(web.html,"private_marker"),"generated page omits source IDs");
let android=Android.generate("Timing",UI.compile(tree,map{target:"android",width:412,height:915}),map{package:"org.pblang.timingpreview"});assert(android.actions==2,"Android action generation");
let form=UI.build("Timing",tree,map{width:412,height:915});GUI.get(form,"timing_job_1").onclick(form);
assert(str_contains(GUI.get(form,"timing_detail_0").text,"critical") and GUI.get(form,"timing_detail_4").text=="Slack: 0 ms","portable click updates all job details");
GUI.get(form,"timing_job_0").onclick(form);assert(GUI.get(form,"timing_detail_4").text=="Slack: 5 ms","noncritical job slack");
let jobs=[];let durations=map{};for i in range(0,32) {let id="n"+str(i);array_push(jobs,map{id:id,needs:[]});durations[id]=0;}
let many=json_stringify(map{format:"pblang.pipeline-estimate.v1",jobs:jobs,durations_ms:durations});
let page=View.create(many,3);let last=UI.build("Timing",page,map{width:412,height:915});GUI.get(last,"timing_job_31").onclick(last);
assert(str_contains(GUI.get(last,"timing_detail_0").text,"32 / 32"),"last job accessible");
for widget in last.widgets {assert(widget.x>=0 and widget.y>=0 and widget.x+widget.w<=last.w and widget.y+widget.h<=last.h,"portable controls fit");}
for bad in [-1,4,0.5,true,nil] {assert((try View.create(many,bad) catch nil)==nil,"page rejected");}
assert((try View.create("{}") catch nil)==nil,"malformed source rejected");
print "pipeline_timing_view_pass";
