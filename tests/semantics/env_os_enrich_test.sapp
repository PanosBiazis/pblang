// tests/semantics/env_os_enrich_test.sapp — bug fix + enrichment for os.sapp + env.sapp

let OS = import("stdlib/os.sapp");
let E = import("stdlib/env.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── SECURITY FIX: is_executable must not be shell-injectable ───────────────────────
if not OS.is_executable("/bin/sh") { fail("/bin/sh is executable"); }
if OS.is_executable("/nonexistent_binary_xyz123") { fail("missing file not executable"); }
// An injection payload must be treated as a (non-existent) path, not run as a command.
let marker = "tests/fixtures/_os_injection_marker";
let injected = OS.is_executable("/bin/sh; touch " + marker + " #");
if injected { fail("injection payload should not be 'executable'"); }
// confirm the side-effect command did NOT run
let fsmod = import("stdlib/fs.sapp");
if fsmod.exists(marker) == true { fsmod.remove(marker); fail("VULNERABLE: injected command executed"); }

// ── os platform helpers ─────────────────────────────────────────────────────────────
let plat = OS.platform();
eq(OS.is_linux(), plat == "linux", "is_linux matches platform");
eq(OS.is_windows(), plat == "windows", "is_windows matches platform");
if plat == "windows" { eq(OS.path_sep(), ";", "win path sep"); eq(OS.line_sep(), "\r\n", "win line sep"); }
else { eq(OS.path_sep(), ":", "unix path sep"); eq(OS.line_sep(), "\n", "unix line sep"); }

// ── env: has / keys / expand ────────────────────────────────────────────────────────
E.set("PB_ENRICH_TEST_VAR", "hello");
if not E.has("PB_ENRICH_TEST_VAR") { fail("has set var"); }
if E.has("PB_DEFINITELY_UNSET_VAR_XYZ") { fail("unset var -> false"); }

let ks = E.keys();
let found = false;
let i = 0;
while i < len(ks) { if ks[i] == "PB_ENRICH_TEST_VAR" { found = true; } i = i + 1; }
if not found { fail("keys lists the set var"); }

eq(E.expand("a ${PB_ENRICH_TEST_VAR} b"), "a hello b", "expand braces");
eq(E.expand("$PB_ENRICH_TEST_VAR!"), "hello!", "expand bare");
eq(E.expand("none ${PB_DEFINITELY_UNSET_VAR_XYZ} x"), "none  x", "unset -> empty");

print "env_os_enrich_pass";
