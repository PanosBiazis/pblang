let Motion = import("stdlib:motion_detection.sapp");

fn require(value, message) {
    if not value { throw "motion_detection test failed: " + message; }
}

let linear = Motion.create(map{
    sensor_mode: "linear-acceleration", threshold: 0.8,
    cooldown_ms: 1500, max_samples: 8
});
require(linear.ok, "linear detector must initialize");
let first = Motion.sample(linear, 1.0, 0, 0, 0);
require(first.triggered and first.trigger_sequence == 1,
    "first qualifying linear sample must trigger without wall-clock dependence");
let suppressed = Motion.sample(linear, 1.1, 0, 0, 500000000);
require(not suppressed.triggered and suppressed.above_threshold
    and suppressed.cooldown_remaining_ms == 1000,
    "cooldown must suppress a repeated trigger and report remaining time");
let second = Motion.sample(linear, 0, 0, 1.2, 1500000000);
require(second.triggered and second.trigger_sequence == 2,
    "motion at the cooldown boundary must trigger");
let backwards = Motion.sample(linear, 1, 0, 0, 1499999999);
require(not backwards.ok and backwards.code == "non-monotonic-timestamp"
    and linear.samples == 3,
    "non-monotonic input must fail without consuming the sample budget");

let raw = Motion.create(map{
    sensor_mode: "accelerometer", threshold: 0.8,
    cooldown_ms: 1500, gravity_alpha: 0.9,
    warmup_samples: 8, max_samples: 16
});
let i = 0;
while i < 8 {
    let resting = Motion.sample(raw, 0, 0, 9.80665, i * 16000000);
    require(resting.ok and resting.warming and not resting.triggered,
        "raw accelerometer warmup must reject false alarms");
    i = i + 1;
}
let moved = Motion.sample(raw, 2.0, 0, 9.80665, 128000000);
require(moved.triggered and moved.motion.magnitude > 1.7,
    "three-axis gravity filtering must retain directional movement");

require(not Motion.create(map{ threshold: 0 }).ok,
    "zero threshold must fail closed");
require(not Motion.create(map{ sensor_mode: "gyroscope" }).ok,
    "unsupported sensor types must fail closed");
require(not Motion.sample(raw, 201, 0, 0, 144000000).ok,
    "physically unbounded samples must be rejected");
require(not Motion.replay([map{x:0,y:0,z:0,timestamp_ns:0}],
    map{max_samples:0}).ok, "invalid replay budgets must fail closed");
let oversized_replay=[];
let replay_index=0;
while replay_index<4097 {
    array_push(oversized_replay,map{x:0,y:0,z:0,timestamp_ns:replay_index});
    replay_index=replay_index+1;
}
let replay_limit=Motion.replay(oversized_replay);
require(not replay_limit.ok and replay_limit.code=="replay-budget-exceeded",
    "materialized replay must fail before allocating unbounded decisions");
require(not Motion.profile().android_adapter,
    "the pure core must not claim a live Android adapter");

print "motion_detection_pass";
