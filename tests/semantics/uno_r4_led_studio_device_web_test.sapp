let W=import("../../examples/uno_r4_led_studio/web.sapp");
let M=import("../../examples/uno_r4_led_studio/model.sapp");
let D=import("../../examples/uno_r4_led_studio/device_export.sapp");
let C=import("../../examples/uno_r4_led_studio/device_control.sapp");
let calls=[];let plan=D.plan(M.create().document,1);
fn runner(p,port,command,confirmed){
    push(calls,command);
    return map{ok:true,reply:map{state:"idle",frame:0,remaining_ms:0}};
}
fn req(method,path="/",body=""){return map{method:method,path:path,body:body,headers:map{host:"127.0.0.1:8768",origin:"http://127.0.0.1:8768","content-type":"application/x-www-form-urlencoded"}};}
fn hidden(p,key){return str_split(str_split(p.body,"name=\""+key+"\" value=\"")[1],"\"")[0];}
fn editor(p){return map{body:str_split(str_split(p.body,"id=\"led-editor\"")[1],"</form>")[0]};}
fn body(p,action){let form=editor(p);return "csrf="+hidden(form,"csrf")+"&revision="+hidden(form,"revision")+"&action="+action+"&f_text=&f_duration=100";}
fn device_req(p,action){
    let key=action;if action=="a_3" {key="device_stop";}elif action=="a_1" {key="device_status";}
    let ordinals=map{device_status:1,device_play:2,device_stop:3,device_upload:4};
    for chunk in str_split(p.body,"class=\"device-controls\"") {
        let form=str_split(chunk,"</form>")[0];
        if not str_contains(form,"/"+str(ordinals[key])+"#") {continue;}
        let path=str_split(str_split(form,"action=\"")[1],"#")[0];
        let f=map{body:form};let submitted=key;if str_starts_with(action,"a_") {submitted="a_1";}
        return req("POST",path,"csrf="+hidden(f,"csrf")+"&revision="+hidden(f,"revision")+"&action="+submitted);
    }
    throw "Missing device form.";
}
fn follow(app,request){let response=app.handle(request);if response.status==303 {assert(response.headers.Location=="/#arduino-device" and response.body=="","fixed no-body PRG redirect");return app.handle(req("GET"));}return response;}
let control=C.create(plan,"/dev/ttyACM0",true,runner);
let app=W.create(8768,map{hide_source_names:false,discourage_scraping:false,throttle_rejected_requests:false},control);
let p=app.handle(req("GET"));
assert(len(calls)==0 and str_contains(p.body,"Play on Arduino"),"GET exposes controls without physical action");
let forged=device_req(p,"device_play");forged.headers.origin="https://untrusted.invalid";
assert(app.handle(forged).status==403 and len(calls)==0,"origin blocks hardware action");
assert(str_contains(p.body,"id=\"animation-import\"") and str_contains(p.body,"Download project JSON"),"physical controls retain saved-project UI");
assert(not str_contains(p.body,"<fieldset hidden>"),"save/import fieldset is not hidden by device controls");
let post=device_req(p,"device_play");p=follow(app,post);
assert(p.status==200 and len(calls)==2 and calls[0]=="STATUS" and calls[1]=="PLAY","guarded Play reaches controller once");
assert(app.handle(post).status==303 and len(calls)==2,"replay does not repeat physical Play");
p=app.handle(req("POST","/action",body(p,"pixel_0")));
p=follow(app,device_req(p,"device_play"));
assert(len(calls)==2 and str_contains(p.body,"Edited frames differ"),"edited project cannot play stale firmware");
p=follow(app,device_req(p,"device_stop"));
assert(len(calls)==3 and calls[2]=="STOP","Stop remains available after edits");
p=app.handle(req("POST","/action",body(p,"do_play")));
assert(str_contains(p.body,"id=\"led-editor\" hidden") and str_contains(p.body,"class=\"device-controls\"") and str_contains(p.body,"Stop Arduino"),"physical Stop is exposed during preview");
p=follow(app,device_req(p,"device_stop"));
assert(len(calls)==4,"physical Stop during preview");
// A second tab changes editor state and performs STATUS while the first keeps Stop.
let tab_a=app.handle(req("GET"));let old_stop=device_req(tab_a,"device_stop");
let tab_b=app.handle(req("GET"));
tab_b=app.handle(req("POST","/action",body(tab_b,"do_border")));
tab_b=follow(app,device_req(tab_b,"device_status"));
let stopped=follow(app,old_stop);
assert(stopped.status==200 and len(calls)==6 and calls[5]=="STOP","other tab edits/status do not revoke independent Stop");
assert(app.handle(old_stop).status==303 and len(calls)==6,"consumed Stop cannot replay");
let malformed=device_req(stopped,"device_stop");malformed.body=malformed.body+"&csrf=duplicate";
assert(app.handle(malformed).status==400 and len(calls)==6,"duplicate CSRF rejected");
let wrong=device_req(stopped,"device_stop");wrong.body=str_join(str_split(wrong.body,"csrf="),"csrf=wrong");
assert(app.handle(wrong).status==403 and len(calls)==6,"forged token rejected");
let no_origin=device_req(stopped,"device_stop");no_origin.headers=map{host:"127.0.0.1:8768","content-type":"application/x-www-form-urlencoded"};
assert(app.handle(no_origin).status==403 and len(calls)==6,"missing origin rejected");
let get_device=device_req(stopped,"device_stop");get_device.method="GET";
assert(app.handle(get_device).status==404 and len(calls)==6,"GET cannot stop device");
assert(app.handle(device_req(stopped,"device_stop")).status==303 and len(calls)==7,"invalid requests do not consume valid Stop");
let expired_page=app.handle(req("GET"));let expired=device_req(expired_page,"device_stop");
for _i 16 {app.handle(req("GET"));}
assert(app.handle(expired).status==303 and len(calls)==7,"bounded page eviction rejects stale controls without effect");
app.close();assert(app.handle(old_stop).status==503,"close revokes device controls");
let offline=W.create();p=offline.handle(req("GET"));assert(not str_contains(p.body,"Play on Arduino"),"default remains offline");offline.close();
assert((try C.create(plan,"/dev/ttyUSB0",true,runner) catch nil)==nil,"wrong device namespace rejected");
assert((try C.create(plan,"/dev/ttyACM0",false,runner) catch nil)==nil,"explicit confirmation required");
let failed=C.create(plan,"/dev/ttyACM0",true,fn(p,port,command,confirmed){throw "sensitive device detail";});
let result=failed.action(M.create().document,"STATUS");assert(not result.ok and not str_contains(result.message,"sensitive"),"generic failure does not expose host diagnostics");
let restored=W.create(8768,nil,control,M.export_project(M.create()));
assert(len(calls)==7,"project restore does not access device");restored.close();
assert((try W.create(8768,nil,control,"{invalid") catch nil)==nil,"invalid startup project rejected before listener");
let opaque=W.create(8768,nil,control);let op=opaque.handle(req("GET"));
let oq=device_req(op,"a_3");let other=opaque.handle(req("GET"));
other=follow(opaque,device_req(other,"a_1"));
assert(opaque.handle(oq).status==303 and calls[len(calls)-1]=="STOP","default opaque controls survive another page action");
opaque.close();
let attempts=0;
let uncertain=W.create(8768,map{hide_source_names:false,discourage_scraping:false,throttle_rejected_requests:false},map{action:fn(document,command){attempts=attempts+1;throw "private native details";}});
let up=uncertain.handle(req("GET"));let ur=device_req(up,"device_stop");up=follow(uncertain,ur);
assert(up.status==200 and attempts==1 and not str_contains(up.body,"private native details"),"uncertain effect has fixed private error");
assert(uncertain.handle(ur).status==303 and attempts==1,"uncertain effect cannot be replayed");uncertain.close();
print "uno_r4_led_studio_device_web_pass";
