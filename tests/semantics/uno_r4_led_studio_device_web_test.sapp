let W=import("../../examples/uno_r4_led_studio/web.sapp");
let M=import("../../examples/uno_r4_led_studio/model.sapp");
let D=import("../../examples/uno_r4_led_studio/device_export.sapp");
let C=import("../../examples/uno_r4_led_studio/device_control.sapp");
let calls=[];let plan=D.plan(M.create().document,1);
fn runner(p,port,command,confirmed){
    push(calls,command);
    return map{ok:true,reply:map{state:"idle",frame:0,remaining_ms:0}};
}
fn req(method,path="/",body=""){return map{method:method,path:path,body:body,headers:map{host:"127.0.0.1:8768",origin:"http://127.0.0.1:8768","content-type":"application/x-www-form-urlencoded"}};}
fn hidden(p,key){return str_split(str_split(p.body,"name=\""+key+"\" value=\"")[1],"\"")[0];}
fn body(p,action){return "csrf="+hidden(p,"csrf")+"&revision="+hidden(p,"revision")+"&action="+action+"&f_text=&f_duration=100";}
let control=C.create(plan,"/dev/ttyACM0",true,runner);
let app=W.create(8768,map{hide_source_names:false,discourage_scraping:false,throttle_rejected_requests:false},control);
let p=app.handle(req("GET"));
assert(len(calls)==0 and str_contains(p.body,"Play on Arduino"),"GET exposes controls without physical action");
let forged=req("POST","/action",body(p,"device_play"));forged.headers.origin="https://untrusted.invalid";
assert(app.handle(forged).status==403 and len(calls)==0,"origin blocks hardware action");
assert(str_contains(p.body,"id=\"animation-import\"") and str_contains(p.body,"Download project JSON"),"physical controls retain saved-project UI");
assert(not str_contains(p.body,"<fieldset hidden>"),"save/import fieldset is not hidden by device controls");
let post=body(p,"device_play");p=app.handle(req("POST","/action",post));
assert(p.status==200 and len(calls)==1 and calls[0]=="PLAY","guarded Play reaches controller once");
assert(app.handle(req("POST","/action",post)).status==403 and len(calls)==1,"replay does not repeat physical Play");
p=app.handle(req("POST","/action",body(p,"pixel_0")));
p=app.handle(req("POST","/action",body(p,"device_play")));
assert(len(calls)==1 and str_contains(p.body,"Edited frames differ"),"edited project cannot play stale firmware");
p=app.handle(req("POST","/action",body(p,"device_stop")));
assert(len(calls)==2 and calls[1]=="STOP","Stop remains available after edits");
p=app.handle(req("POST","/action",body(p,"do_play")));
assert(str_contains(p.body,"id=\"led-editor\" hidden") and str_contains(p.body,"form=\"led-editor\" type=\"submit\" name=\"action\" value=\"device_stop\""),"physical Stop is exposed during preview");
p=app.handle(req("POST","/action",body(p,"device_stop")));
assert(len(calls)==3,"physical Stop during preview");app.close();
let offline=W.create();p=offline.handle(req("GET"));assert(not str_contains(p.body,"Play on Arduino"),"default remains offline");offline.close();
assert((try C.create(plan,"/dev/ttyUSB0",true,runner) catch nil)==nil,"wrong device namespace rejected");
assert((try C.create(plan,"/dev/ttyACM0",false,runner) catch nil)==nil,"explicit confirmation required");
let failed=C.create(plan,"/dev/ttyACM0",true,fn(p,port,command,confirmed){throw "sensitive device detail";});
let result=failed.action(M.create().document,"STATUS");assert(not result.ok and not str_contains(result.message,"sensitive"),"generic failure does not expose host diagnostics");
let restored=W.create(8768,nil,control,M.export_project(M.create()));
assert(len(calls)==3,"project restore does not access device");restored.close();
assert((try W.create(8768,nil,control,"{invalid") catch nil)==nil,"invalid startup project rejected before listener");
print "uno_r4_led_studio_device_web_pass";
