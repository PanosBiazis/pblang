let L=import("stdlib:portable_lock.sapp");
let digest=str_repeat("a",64);
let manifest="[dependencies]\nstdlib = { path = \"stdlib\" }\n";
let locked="content_hash_algorithm = \"pblang-package-tree-v2\"\nmanifest_sha256 = \""+digest+"\"\n[dependencies.stdlib]\npath = \"stdlib\"\nsha256 = \""+digest+"\"\n";
let result=L.installed_text(manifest,locked,"/installed/project");
assert(result.format=="pblang.installed-lock.v1" and result.rewritten==1,"explicit local format");
assert(str_contains(result.text,"path = \"/installed/project/stdlib\""),"anchor to project root");
assert(L.installed_text(manifest,result.text,"/installed/project").text==result.text,"idempotent materialization");
assert(L.normalize_text(manifest,result.text,"/installed/project").text==locked,"reversible portable publication preserves all other bytes");
for root in ["relative","",nil,7] {
    assert(try {L.installed_text(manifest,locked,root);false} catch true,"explicit absolute root required");
}
for malformed in [str_replace_all(locked,digest,"invalid"),locked+"source = \"git\"\n",str_replace_all(locked,"path = \"stdlib\"","path = \"/other/stdlib\""),locked+"[dependencies.remote]\npath = \"cache\"\nsha256 = \""+digest+"\"\n"] {
    assert(try {L.installed_text(manifest,malformed,"/installed/project");false} catch true,"invalid/mismatched/undeclared dependencies fail closed");
}
let extra="[metadata]\npath = \"unrelated\"\n";
assert(str_ends_with(L.installed_text(manifest,locked+extra,"/installed/project").text,extra),"unrelated sections preserved");
assert(str_ends_with(L.normalize_text(manifest,locked+extra,"/installed/project").text,extra),"publication section tracking fixed too");
let quoted=L.installed_text(manifest,locked,"/installed/name \"quoted\"");
assert(str_contains(quoted.text,"name \\\"quoted\\\""),"host path is TOML escaped");
print "installed_lock_pass";
