// Test: responsive 2D/3D design engine primitives used by the native IDE Designer.

let D = import("stdlib:design_engine.sapp");
let G = import("stdlib:gui.sapp");

let vp = D.viewport(900, 600);
assert(D.responsive_cols(400) == 1, "small viewport uses one column");
assert(D.responsive_cols(700) == 2, "medium viewport uses two columns");
assert(D.responsive_cols(1000) == 3, "desktop viewport uses three columns");

let a = D.item2d("button", "a", 5, 7, 100, 30);
let b = D.item2d("field", "b", 20, 10, 120, 30);
let c = D.item2d("panel", "c", 0, 0, 180, 80);
let items = [a, b, c];
let rs = D.grid_layout(items, vp, 2, 10, 20);
assert(len(rs) == 3, "grid returns one rect per item");
assert(rs[0].x == 20 and rs[0].y == 20, "grid first item starts at margin");
assert(rs[1].x > rs[0].x, "grid second item moves to next column");
assert(rs[2].y > rs[0].y, "grid third item wraps to next row");

D.set_anchor(a, "bottom-right");
let ar = D.apply_anchor(a, vp, 12);
assert(ar.x == 788 and ar.y == 558, "bottom-right anchor positions against viewport");

let sr = D.snap_rect(D.rect(13, 29, 101, 47), 16);
assert(sr.x == 16 and sr.y == 32 and sr.w == 96 and sr.h == 48, "snap_rect rounds to grid");

D.apply_layout(items, vp, "responsive");
assert(items[0].x >= 0 and items[0].w > 0, "apply_layout mutates item bounds");
assert(D.hit_test(items, items[2].x + 1, items[2].y + 1) == 2, "hit_test returns topmost matching item");

let cube = D.item3d("cube", "cube1", 10, 4, 2, 64, 64, 64);
let pr = D.project_item(cube, 100, 100, 2);
assert(pr.x == 116 and pr.y == 104, "project_item maps 3D iso position to 2D");

let mixed = [
    G.button("ok", 10, 10, 120, 32, "OK", nil),
    G.textbox("name", 10, 48, 160, 28, ""),
    D.item3d("cube", "cube2", 0, 0, 0, 64, 64, 64)
];
D.apply_layout(mixed, D.viewport(700, 400), "responsive");
assert(mixed[0].x >= 0 and mixed[0].h == 32, "layout accepts gui widgets without min_h");
assert(mixed[2].x >= 0 and mixed[2].h == 64, "layout still accepts 3D design items");

print "design_engine_pass";
