let Checked = import("stdlib:compiler/checked_source.sapp");
let Parser = import("stdlib:compiler/parser.sapp");
let Tokens = import("stdlib:compiler/tokenizer.sapp");

fn rejects(work) { return try { work(); false } catch true; }
fn expect_error(work, message) {
    assert(rejects(work), message);
}

let source = "return 7;";
assert(len(Checked.parse_source(source, len(source), 4).stmts) == 1, "exact byte and token caps include EOF");
expect_error(fn() { Checked.parse_source(source, len(source) - 1); }, "checked_source: source byte limit exceeded");
expect_error(fn() { Checked.parse_source(source, len(source), 3); }, "checked_source: token limit exceeded");
assert(len(Checked.parse_source("", 1, 1).stmts) == 0, "empty source fits EOF-only token cap");
assert(len(Checked.parse_source("// comment", 10, 2).stmts) == 0, "comments count before parser filtering");
expect_error(fn() { Checked.parse_source("// comment", 10, 1); }, "checked_source: token limit exceeded");

for marker in ["A", "é", "λ", "中", "😀", "é"] {
    let text = "/*" + marker + "*/return 7;";
    let bytes = len(str_to_bytes(text));
    assert(len(Checked.parse_source(text, bytes).stmts) == 1, "exact UTF-8 byte boundary");
    expect_error(fn() { Checked.parse_source(text, bytes - 1); }, "checked_source: source byte limit exceeded");
}
let nan_value = parse_number("NaN");
for value in [nil, true, false, "4", [], map{}, 0, -1, 1.5, nan_value, parse_number("inf"), parse_number("-inf"), bigint(2), decimal("2"), rational("2/1")] {
    expect_error(fn() { Checked.parse_source(source, value); }, "checked_source: invalid admission limit");
    expect_error(fn() { Checked.parse_source(source, 100, value); }, "checked_source: invalid admission limit");
}
expect_error(fn() { Checked.parse_source(source, Checked.MAX_SOURCE_BYTES + 1); }, "checked_source: invalid admission limit");
expect_error(fn() { Checked.parse_source(source, 100, Checked.MAX_TOKENS + 1); }, "checked_source: invalid admission limit");
for value in [nil, false, 7, [], map{}] {
    expect_error(fn() { Checked.parse_source(value); }, "checked_source: source must be text");
}

for text in ["return 7; /* private_canary", "return 7; let s=\"private_canary",
    "return 7; let x=0x;", "return 7; let x=1private_canary;"] {
    expect_error(fn() { Checked.parse_source(text); }, "checked_source: invalid or unterminated token");
}
for text in ["fn main(){return 7;", "fn f(x=){return 1;} return f(2);",
    "let private_canary:=1;return private_canary;", "return 7; @private_canary"] {
    expect_error(fn() { Checked.parse_source(text); }, "checked_source: syntax error");
}
// Raw parsing retains recovery for editors. Only the executable admission API
// refuses to return that partial AST, without disclosing source in diagnostics.
let recovered = Parser.parse(Tokens.tokenize("fn main(){return 7;"));
assert(len(recovered.stmts) > 0 and len(recovered.errors) > 0, "raw parser recovery remains available");
for text in ["let x=1 return x;", "/* complete */ return 7;", "let s=\"/* inert */\"; return 7;",
    "fn f(x=2){return x;} return f(2);", "let x:number=1;return x;", "return 0Xff;"] {
    assert(len(Checked.parse_source(text).errors) == 0, "valid grammar survives earlier failed parse");
}

let exact_bytes = "/*" + str_repeat(" ", Checked.MAX_SOURCE_BYTES - 4) + "*/";
assert(len(Checked.parse_source(exact_bytes).stmts) == 0, "hard source ceiling accepted exactly");
expect_error(fn() { Checked.parse_source(exact_bytes + " "); }, "checked_source: source byte limit exceeded");
let exact_tokens = str_repeat("//\n", Checked.MAX_TOKENS - 1);
assert(len(Checked.parse_source(exact_tokens).stmts) == 0, "hard token ceiling includes EOF");
expect_error(fn() { Checked.parse_source(exact_tokens + "//\n"); }, "checked_source: token limit exceeded");
print "checked_source_pass";
