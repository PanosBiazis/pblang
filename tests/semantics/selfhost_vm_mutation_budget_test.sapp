let VM=import("stdlib:compiler/vm.sapp");
let FE=import("stdlib:compiler/selfhost_frontend.sapp");
fn check(ok) { if not ok { throw "mutation budget regression"; } }
fn write_chunk(target,index,attribute=false) {
    let instructions=[map{op:0,operand:0}];
    if not attribute { array_push(instructions,map{op:0,operand:1}); }
    array_push(instructions,map{op:0,operand:2});
    array_push(instructions,map{op:if attribute {30} else {28},operand:1});
    return map{constants:[target,index,9],instructions:instructions};
}
// No following instruction observes the target: admission must happen before
// mutation, not through a later _runtime_tick. Retain an external alias to prove it.
for index in [2,2.5,2.999] {
    let a=[1,2];let before=json_stringify(a);
    check((try VM.run_bounded(write_chunk(a,index),map{max_value_items:2}) catch nil)==nil);
    check(json_stringify(a)==before);
}
for attribute in [false,true] {
    let m=map{a:1,b:2};let before=json_stringify(m);
    check((try VM.run_bounded(write_chunk(m,"c",attribute),map{max_value_items:2}) catch nil)==nil);
    check(json_stringify(m)==before);
    VM.run_bounded(write_chunk(m,"b",attribute),map{max_value_items:2});
    check(m==map{a:1,b:9});
    map_remove(m,"a");VM.run_bounded(write_chunk(m,"c",attribute),map{max_value_items:2});
    check(m==map{b:9,c:9});
}
let a=[1,2];VM.run_bounded(write_chunk(a,1.9),map{max_value_items:2});check(a==[1,9]);
let one=[1];VM.run_bounded(write_chunk(one,1),map{max_value_items:2});check(one==[1,9]);
// No new cap for ordinary applications; retained host indexing stays intact.
let unbounded=[1,2];VM.run(write_chunk(unbounded,2));check(unbounded==[1,2,9]);
let um=map{a:1,b:2};VM.run(write_chunk(um,"c"));check(len(um)==3);
for index in [-1,3,1000000000,"2",true,nil] {
    let bad=[1,2];
    check((try VM.run_bounded(write_chunk(bad,index),map{max_value_items:2}) catch nil)==nil);
    check(bad==[1,2]);
}
let invalid_key=map{a:1,b:2};
check((try VM.run_bounded(write_chunk(invalid_key,2),map{max_value_items:2}) catch nil)==nil);
check(invalid_key==map{a:1,b:2});
// A guest catch cannot turn admission failure into continuing effects.
for source in [
    "let a=[1,2]; a[2]=3;",
    "let a=map{a:1,b:2}; a.c=3;",
    "let a=map{a:1,b:2}; a[\"c\"]=3;",
    "let a=[1,2]; let caught=try {a[2]=3;42} catch 99; print 7;",
    "let a=map{a:1,b:2}; let caught=try {a.c=3;42} catch 99; print 7;"
] {
    check((try FE.frontend_run_bounded(source,map{max_value_items:2}) catch nil)==nil);
}
let good=FE.frontend_run_bounded("let a=[1,2];a[1]=9;print a[1];",map{max_value_items:2});
check(good.ok and good.output==[9]);
let nested=map{child:map{a:1,b:2}};
check((try VM.run_bounded(write_chunk(nested.child,"c"),map{max_value_items:2}) catch nil)==nil);
check(len(nested.child)==2);
print "selfhost_vm_mutation_budget_pass";
