// tests/semantics/thread_raii_test.sapp
//
// Locks the ERROR paths of thread.sapp's RAII helpers and circuit breaker.
// These were written as `catch err_val { ... }` — but pblang's catch does NOT
// bind a name, so that shape mis-parses: on a throw the handler evaluated the
// undefined `err_val`, the error ESCAPED, and the lock/semaphore was NEVER
// released (and the circuit breaker never counted the failure, so it could
// never open on real errors). This test would deadlock or fail on the old code.

let thread = import("stdlib:thread.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }

// ── with_read / with_write: throw inside → swallowed, lock released ─────────
let rw = thread.rwlock();
let r1 = try thread.with_read(rw, fn() { throw "boom"; }) catch "leaked-throw";
eq(r1, nil, "with_read swallows the fn's throw and returns nil");
// the real proof of release: a writer can still take the lock afterwards
let r2 = thread.with_write(rw, fn() { return 7; });
eq(r2, 7, "write lock is acquirable after a throwing read (lock was released)");

let r3 = try thread.with_write(rw, fn() { throw "boom"; }) catch "leaked-throw";
eq(r3, nil, "with_write swallows the fn's throw and returns nil");
let r4 = thread.with_read(rw, fn() { return 8; });
eq(r4, 8, "read lock is acquirable after a throwing write (lock was released)");

// happy paths unchanged
eq(thread.with_read(rw, fn() { return 1; }), 1, "with_read happy path");
eq(thread.with_write(rw, fn() { return 2; }), 2, "with_write happy path");

// ── with_semaphore: capacity-1, throw inside → permit released ──────────────
let s = thread.semaphore(1);
let s1 = try thread.with_semaphore(s, fn() { throw "boom"; }) catch "leaked-throw";
eq(s1, nil, "with_semaphore swallows the fn's throw and returns nil");
let s2 = thread.with_semaphore(s, fn() { return 9; });
eq(s2, 9, "the single permit is reusable after a throw (it was released)");

// ── circuit breaker: real errors are CAUGHT and COUNTED ─────────────────────
let cb = thread.circuit_breaker(2, 60000);
let c1 = try cb.call(fn() { throw "down"; }) catch "leaked-throw";
truthy(is_map(c1), "a throwing call returns an {ok:false} map, not a raised error");
eq(c1.ok, false, "first failure reported ok:false");
truthy(not cb.is_open(), "one failure (threshold 2) keeps the circuit closed");
let c2 = cb.call(fn() { throw "down"; });
eq(c2.ok, false, "second failure reported ok:false");
truthy(cb.is_open(), "two failures reach the threshold and OPEN the circuit");
let c3 = cb.call(fn() { return "never runs"; });
eq(c3.ok, false, "open circuit fast-fails");
eq(c3.error, "circuit open", "open circuit reports its state");
cb.reset();
let c4 = cb.call(fn() { return 5; });
eq(c4.ok, true, "after reset a good call succeeds");
eq(c4.value, 5, "and carries its value");

print "thread_raii_pass";
