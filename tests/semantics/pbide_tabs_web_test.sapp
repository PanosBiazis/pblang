let D=import("editors/ide/pbide_tabs_wire.sapp");
let W=import("editors/ide/pbide_text_web.sapp");
let H=import("editors/ide/pbide_text_history.sapp");
let C=import("editors/ide/pbide_history_wire.sapp");
let T=import("editors/ide/pbide_text.sapp");
fn history(text) { return H.create(T.selection(text),C.BUDGET); }
fn rejects(f) { return try { f(); false } catch true; }
fn form(state,source,op,insert="") {
    return "source="+url_encode(source)+"&start=0&end=0&insert="+url_encode(insert)
        +"&op="+op+"&pair=round&history="+url_encode(C.encode(D.current(state)))
        +"&workspace="+url_encode(D.encode(state));
}
let start=D.create(history("first"));
let encoded=D.encode(start);
assert(D.encode(D.decode(encoded))==encoded,"canonical wire roundtrip");
let second=W.parse_workspace(form(start,"first edited","new-draft"));
assert(second.active==2 and H.current(D.current(second)).text=="","new draft selected");
assert(H.current(D.current(D.select(second,1))).text=="first edited","new draft preserves typed original");
let back=W.parse_workspace(form(second,"second edited","draft-1"));
assert(back.active==1 and H.current(D.current(back)).text=="first edited","switch selects original");
let undone=W.parse_workspace(form(back,"first edited","undo"));
assert(H.current(D.current(undone)).text=="first","active undo restores first");
assert(H.current(D.current(D.select(undone,2))).text=="second edited","other draft history independent");
let redone=W.parse_workspace(form(undone,"first","redo"));
assert(H.current(D.current(redone)).text=="first edited","active redo preserved");
let discarded=W.parse_workspace(form(redone,"must be discarded","discard-draft"));
assert(discarded.active==2 and len(discarded.tabs)==1
    and H.current(D.current(discarded)).text=="second edited","discard removes only active draft");
assert(rejects(fn(){W.parse_workspace(form(discarded,"keep","discard-draft"));}),"final draft cannot be discarded");
let reused=D.add(discarded);
assert(reused.active==1,"lowest free draft id reused");
let four=D.add(D.add(reused));
assert(len(four.tabs)==4 and rejects(fn(){D.add(four);}),"four-draft cap enforced");
let empty=C.encode(history(""));
for bad in ["",str_repeat("~",D.MAX_ENCODED),str_repeat("x",D.MAX_ENCODED+1),
    D.FORMAT+"~01~1~1~"+empty,D.FORMAT+"~1~01~1~"+empty,
    D.FORMAT+"~1~1~01~"+empty,D.FORMAT+"~2~1~1~"+empty,
    D.FORMAT+"~1~2~1~"+empty+"~1~"+empty,
    D.FORMAT+"~1~1~1~"+empty+"~extra",D.FORMAT+"~1~5~1~"+empty] {
    assert(rejects(fn(){D.decode(bad);}),"malformed draft wire rejected");
}
let large=history(str_repeat("a",4096));
let maximum=D.restore(1,[map{id:1,history:large},map{id:2,history:large}]);
assert(D.decode(D.encode(maximum)).active==1,"inclusive combined source budget");
assert(rejects(fn(){D.restore(1,[map{id:1,history:large},map{id:2,history:large},map{id:3,history:history("x")}]);}),"combined history overflow rejected");
assert(rejects(fn(){D.create(history(str_repeat("x",4097)));}),"per-source cap enforced");
let over=D.FORMAT+"~1~3~1~"+C.encode(large)+"~2~"+C.encode(large)+"~3~"+C.encode(history("x"));
assert(rejects(fn(){D.decode(over);}),"wire aggregate overflow rejected");
let frozen=D.encode(maximum);
assert(rejects(fn(){W.parse_workspace(form(maximum,str_repeat("b",4096),"draft-2"));}),"new history cannot exceed shared budget");
assert(D.encode(maximum)==frozen,"failed transition preserves caller state");
let body=form(start,"draft","status");
let mismatch=str_replace_all(body,"history="+url_encode(C.encode(D.current(start))),"history="+url_encode(empty));
assert(rejects(fn(){W.parse_workspace(mismatch);}),"active history splicing rejected");
assert(rejects(fn(){W.parse_workspace(str_replace_all(body,"&history="+url_encode(C.encode(D.current(start))),""));}),"workspace without history rejected");
assert(rejects(fn(){W.parse_workspace(body+"&workspace="+url_encode(encoded));}),"duplicate workspace rejected");
for op in ["draft-0","draft-01","draft-5","draft-2"] {
    assert(rejects(fn(){W.parse_workspace(form(start,"draft",op));}),"invalid or missing target rejected");
}
let payload="</textarea><script>draft-private-canary</script>";
let hostile=D.create(history(payload));
let html=W.render(H.current(D.current(hostile)),D.current(hostile),nil,hostile);
assert(not str_contains(html,payload) and str_contains(html,"&lt;script&gt;"),"draft source escaped");
assert(str_contains(html,"aria-pressed=\"true\"") and str_contains(html,"Discard Draft1"),"active and discard controls labelled");
let large_history=H.commit(history(str_repeat("\"",4096)),T.selection(str_repeat("'",4096)));
let worst=D.create(large_history);
let worst_body=form(worst,str_repeat("'",4096),"status",str_repeat("&",4096));
assert(len(str_to_bytes(worst_body))<=W.MAX_BODY,"full history and worst form escaping fit transport");
let diagnostics=map{ok:false,diagnostics:[]};
for i 32 { push(diagnostics.diagnostics,map{kind:"error",message:str_repeat("<",512)}); }
let page=W.render(H.current(large_history),large_history,diagnostics,worst);
assert(len(str_to_bytes(page))+1024<W.MAX_RESPONSE,"full escaped page and diagnostics fit response with headers");
let req=map{method:"POST",path:"/edit",body:form(start,"typed","new-draft"),headers:map{
    host:"127.0.0.1:18771",origin:"http://127.0.0.1:18771",
    "content-type":"application/x-www-form-urlencoded"}};
req.headers["content-length"]=str(len(str_to_bytes(req.body)));
let reply=W.handle(req,18771);
assert(reply.status==200 and str_contains(reply.body,"Draft2"),"eight-field HTTP handler connected");
req.body=mismatch+"&private-canary=secret";
req.headers["content-length"]=str(len(str_to_bytes(req.body)));
let denied=W.handle(req,18771);
assert(denied.status==400 and not str_contains(denied.body,"private-canary"),"invalid workspace not echoed");
let empty_frames=[];
for i H.MAX_FRAMES { push(empty_frames,T.selection("")); }
let metadata_history=H.restore(empty_frames,H.MAX_FRAMES-1,C.BUDGET);
let overhead=D.restore(1,[map{id:1,history:large_history},map{id:2,history:metadata_history},
    map{id:3,history:metadata_history},map{id:4,history:metadata_history}]);
assert(len(str_to_bytes(form(overhead,str_repeat("'",4096),"status",str_repeat("&",4096))))<=W.MAX_BODY,
    "four tabs and maximum empty-frame metadata fit body cap");
assert(len(str_to_bytes(W.render(H.current(large_history),large_history,diagnostics,overhead)))+1024<W.MAX_RESPONSE,
    "four tabs plus worst source and diagnostics fit bounded response");
print "pbide_tabs_web_pass";
