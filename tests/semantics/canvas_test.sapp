// tests/semantics/canvas_test.sapp — renderer-agnostic 2D draw-command buffer.

let CV = import("stdlib/canvas.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : <<" + s + ">>"); } }

let red = map{ r: 255, g: 0, b: 0 };
let fg = map{ r: 220, g: 228, b: 240 };

let c = CV.new(200, 100);
CV.fill_rect(c, 0, 0, 200, 100, red);
CV.line(c, 0, 0, 200, 100, fg);
CV.text(c, 8, 8, "hi <there>", fg);

eq(CV.count(c), 3, "three commands recorded");
eq(CV.commands(c)[0].op, "fill_rect", "first op");
eq(CV.commands(c)[0].color.r, 255, "color carried");
eq(CV.commands(c)[2].op, "text", "text op");

// ── SVG export ──────────────────────────────────────────────────────────────────────
let svg = CV.to_svg(c);
has(svg, "<svg", "svg open");
has(svg, "</svg>", "svg close");
has(svg, "rect", "rect element");
has(svg, "rgb(255,0,0)", "red fill css");
has(svg, "&lt;there&gt;", "text content escaped");

// ── clear ────────────────────────────────────────────────────────────────────────
CV.clear(c);
eq(CV.count(c), 0, "cleared");

print "canvas_pass";
