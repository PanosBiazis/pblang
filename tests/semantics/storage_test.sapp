// tests/semantics/storage_test.sapp — Delphi-style compressed storage container.
let S = import("stdlib:storage.sapp");

fn fail(m) { throw "FAIL " + m; }

// ── put strings + bytes, get back (decompress on demand) ─────────────────────
let st = S.create();
S.put(st, "readme", "hello pblang storage");
S.put(st, "blob", [1, 2, 3, 250, 0, 255]);
if S.get(st, "readme") != "hello pblang storage" { fail("string round-trip"); }
let bb = S.get(st, "blob");
if len(bb) != 6 or bb[3] != 250 or bb[5] != 255 { fail("bytes round-trip"); }
if S.has(st, "nope") { fail("has should be false for missing"); }
if S.get(st, "nope") != nil { fail("get missing -> nil"); }

// a repetitive entry actually compresses
let big = "";
let i = 0;
while i < 100 { big = big + "compress me compress me compress me\n"; i = i + 1; }
S.put(st, "big", big);
let sstat = S.stats(st);
if sstat.compressed_bytes >= sstat.original_bytes { fail("storage should compress overall"); }
if S.get(st, "big") != big { fail("big entry round-trip"); }

// ── list / remove ────────────────────────────────────────────────────────────
if len(S.list(st)) != 3 { fail("list count (got " + str(len(S.list(st))) + ")"); }
S.remove(st, "blob");
if S.has(st, "blob") { fail("remove failed"); }
if len(S.list(st)) != 2 { fail("list after remove"); }

// ── save to one file, load it back, get on demand ────────────────────────────
let sv = S.save(st, "tests/semantics/_assets.pbst");
if not sv.ok or sv.entries != 2 { fail("save"); }
let st2 = S.load("tests/semantics/_assets.pbst");
fs_remove("tests/semantics/_assets.pbst");
if st2 == nil { fail("load returned nil"); }
if S.get(st2, "readme") != "hello pblang storage" { fail("loaded string entry"); }
if S.get(st2, "big") != big { fail("loaded big entry"); }
if len(S.list(st2)) != 2 { fail("loaded list count"); }

// ── put a folder (recursive) ─────────────────────────────────────────────────
let st3 = S.create();
S.put_folder(st3, "fixture/", "tests/semantics/fixtures/storage");
let lst = S.list(st3);
if len(lst) != 2 { fail("put_folder recursive fixture count"); }
let any = false;
let j = 0;
while j < len(lst) { if lst[j].name == "fixture/nested/codec.txt" { any = true; } j = j + 1; }
if not any { fail("put_folder should include nested fixture"); }
// and a folder entry decompresses back to the real file content (stored as bytes)
let pbz_src = bytes_to_str(S.get(st3, "fixture/nested/codec.txt"));
if not str_contains(pbz_src, "fn compress") { fail("folder entry content round-trip"); }

// ── pluggable backend: a storage built with a native codec still round-trips ──
// (codec falls back to pbz if the tool is absent; blobs are self-describing so save/load
// works regardless of which backend produced each entry)
let stz = S.create("zstd");
S.put(stz, "doc", big);
S.put(stz, "small", "hi");
if S.get(stz, "doc") != big { fail("zstd-backend entry round-trip"); }
let zstat = S.stats(stz);
if zstat.compressed_bytes >= zstat.original_bytes { fail("native-backed storage should compress"); }
let zsv = S.save(stz, "tests/semantics/_z.pbst");
let stz2 = S.load("tests/semantics/_z.pbst");
fs_remove("tests/semantics/_z.pbst");
if stz2 == nil or S.get(stz2, "doc") != big { fail("native-backed save/load round-trip"); }

print "storage_pass";
