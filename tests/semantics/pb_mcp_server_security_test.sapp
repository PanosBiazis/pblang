// tests/semantics/pb_mcp_server_security_test.sapp — lock in the pb-mcp-server file-access
// guard (security.sapp.safe_rel_path). The server's file tools route paths through this;
// a future weakening of the guard must fail here.

let sec = import("editors/ide/tools/mcpservers/pb-mcp-server/src/security.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn refused(path, m) {
    let r = try map{ v: sec.safe_rel_path(path, ".") } catch nil;   // nil = it threw
    if r != nil { fail(m + " should be REFUSED, got " + str(r.v)); }
}

// ── safe relative paths pass through (backslashes normalized) ──────────────────────
eq(sec.safe_rel_path("a/b/c", "."), "a/b/c", "plain relative");
eq(sec.safe_rel_path("a\\b", "."), "a/b", "backslash normalized");
eq(sec.safe_rel_path("", "fallback"), "fallback", "empty -> fallback");

// ── traversal / absolute / NUL are all refused ────────────────────────────────────
refused("../etc/passwd", "parent traversal");
refused("foo/../../etc/passwd", "mid-path traversal");
refused("/etc/passwd", "unix absolute");
refused("/", "root");
refused("a\\..\\b", "backslash traversal (normalized then caught)");
refused("a\x00b", "NUL byte");

print "pb_mcp_server_security_pass";
