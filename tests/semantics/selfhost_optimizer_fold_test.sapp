// tests/semantics/selfhost_optimizer_fold_test.sapp
//
// (1) DIFFERENTIAL semantics preservation: for a battery of programs, running the
//     UNOPTIMIZED chunk and the OPTIMIZED chunk (both optimize_safe and the
//     aggressive optimize) must give identical results. Any divergence is an
//     optimizer miscompile. (2) MOD constant folding: `17 % 5` must be folded at
//     compile time (the optimizer ran on the same VM, so `%` matches OP_MOD),
//     with a mod-by-zero guard mirroring the div-by-zero one.

let fe = import("stdlib/compiler/selfhost_frontend.sapp");
let vm = import("stdlib/compiler/vm.sapp");
let opt = import("stdlib/compiler/optimizer.sapp");

fn fail(m) { throw "FAIL " + m; }
// Unexpected exceptions fail the test; no string sentinel can stand in for them.
fn rc(ch, var) { return vm.run_bounded(ch).globals[var]; }
fn compile(src) {
    let result = fe.frontend_compile(src);
    if not result.ok { fail("fixture must compile"); }
    return result.chunk;
}
fn scalar_equal(a, b) {
    if type(a) != type(b) { return false; }
    // IEEE NaNs are unequal to themselves; both lanes must actually be numeric NaN.
    if type(a) == "number" and a != a and b != b { return true; }
    return a == b;
}
fn same(label, src, var) {
    let chunk = compile(src);
    let u = rc(chunk, var);
    let s = rc(opt.optimize_safe(chunk).chunk, var);
    let a = rc(opt.optimize(chunk).chunk, var);
    if not scalar_equal(u, s) { fail(label + " safe: unopt=" + str(u) + " opt=" + str(s)); }
    if not scalar_equal(u, a) { fail(label + " aggr: unopt=" + str(u) + " opt=" + str(a)); }
}

// Semantics preservation across the optimizer.
same("arith", "let x = 1 + 2 * 3 - 4;", "x");
same("foldchain", "let x = 2 + 3 + 4 + 5;", "x");
same("cmp", "let x = 5 == 5;", "x");
same("ifelse", "let x = 0; if 1 < 2 { x = 10; } else { x = 20; }", "x");
same("while", "let x = 0; let i = 0; while i < 5 { x = x + i; i = i + 1; }", "x");
same("sc_and", "let x = 1; let y = false and (x = 99);", "x");
same("fn", "fn f(n) { return n * 2 + 1; } let x = f(10);", "x");
same("nestif", "let x = if true { if false { 1 } else { 2 } } else { 3 };", "x");
same("div0", "let x = try (1/0) catch 42;", "x");        // div0 must NOT be folded to inf
same("mod", "let x = 17 % 5;", "x");
same("modneg", "let x = -7 % 3;", "x");                  // negative mod must fold safely
same("mod0_guard", "let x = try (5 % 0) catch 7;", "x"); // preserve runtime NaN; no exception sentinel

// MOD folding actually happens: the CONST,CONST,MOD triple collapses to one CONST.
let c = compile("let x = 17 % 5;");
let o = opt.optimize_safe(c).chunk;
if len(o.instructions) >= len(c.instructions) {
    fail("17 % 5 should fold (fewer instructions): unopt=" + str(len(c.instructions)) + " opt=" + str(len(o.instructions)));
}
if rc(o, "x") != 2 { fail("folded 17 % 5 must equal 2"); }

print "selfhost_optimizer_fold_pass";
