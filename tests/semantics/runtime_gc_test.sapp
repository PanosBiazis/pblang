let G = import("stdlib:runtime_gc.sapp");
let V = import("stdlib:compiler/vm_builtins.sapp");

fn require(value, message) { if not value { throw "FAIL runtime_gc: " + message; } }

require(V != nil, "PBLang-native builtin registry module loads");
let status = G.status();
require(status.format == "pblang.runtime_gc.v1", "status is versioned");
require(status.heap_scope == "host-thread", "host counters are scoped honestly");
require(not status.owner_isolation and not status.collection_allowed,
    "retained host collection is unavailable without owner isolation");

let result = G.collect();
require(not result.ok and not result.allowed and not result.performed and not result.conclusive,
    "collection fails closed and cannot be mistaken for success");
require(result.arrays_cleared == 0 and result.maps_cleared == 0 and result.modules_cleared == 0,
    "blocked collection reports no reclaimed containers");

let isolated = try G.require_owner_isolation() catch nil;
require(isolated == nil, "owner isolation precondition throws on retained host runtime");

require(not map_has(V.registry(), "gc_collect"),
    "PBLang-native guest VM does not expose retained host collection");
require(not map_has(V.registry(), "gc_stats"),
    "PBLang-native guest VM does not expose retained host heap counters");

print "runtime_gc_pass";
