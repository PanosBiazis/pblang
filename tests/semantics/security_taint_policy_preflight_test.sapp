let D=import("stdlib:security_dependency_analysis.sapp");
let T=import("stdlib:security_taint.sapp");
fn expect(ok,label) {if not ok {throw "FAIL taint-policy-preflight: "+label;}}
let invalid=[map{taint_sources:[nil]},map{taint_sanitizers:[true]},
    map{taint_sinks:map{unused:map{severity:"HIGH",class:"fixture",args:[0]}}}];
let errors=["taint_sources must contain bounded names","taint_sanitizers must contain bounded names","invalid taint sink policy"];
// No source executes. These marker paths are deliberately never created.
for mode in ["protect","strict","audit"] {
    for i len(invalid) {
        for source in [42,"/*","let M=import(\"policy-admission-unresolved-marker.sapp\");"] {
            let options=map{security:invalid[i],security_mode:mode,entry_source:source};
            let result=D.analyze_entry("policy-admission-no-read-fixture.sapp",options);
            expect(json_stringify(result)==json_stringify(map{ok:false,passed:false,format:D.FORMAT,error:errors[i]}),
                "deep policy rejects before entry source handling and import resolution");
        }
        let result=D.analyze_entry("policy-admission-no-read-fixture.sapp",map{security:invalid[i],security_mode:mode});
        expect(not result.ok and result.error==errors[i] and len(result)==4,"deep policy rejects before entry read");
    }
}
for value in [true,1,"policy-private-marker",[],fn(){return nil;}] {
    let result=T.validate_policy(value);
    expect(not result.ok and result.error=="taint policy requires map options" and len(result)==2,"non-map value-free rejection");
}
expect(json_stringify(T.validate_policy())==json_stringify(map{ok:true}),"default outcome only");
expect(T.validate_policy(map{max_taint_tokens:0}).ok,"numeric budgets remain separate API");
for i len(invalid) {
    let result=T.validate_policy(invalid[i]);
    expect(json_stringify(result)==json_stringify(map{ok:false,error:errors[i]}),"exact invalid schema");
    let options=map{entry_source:42,security:invalid[i],max_taint_tokens:0};
    expect(D.analyze_entry("fixture.sapp",options).error==T.limits(options).error,"numeric error precedence retained");
}
for field in ["taint_sources","taint_sanitizers","taint_sinks"] {
    let policy=map{};policy[field]=nil;
    expect(not T.validate_policy(policy).ok,"direct explicit nil rejected");
    expect(D.analyze_entry("fixture.sapp",map{entry_source:"let value=1;",security:policy}).passed,"dependency nil-as-unset retained");
}
let policy=map{taint_sources:[],taint_sanitizers:[],taint_sinks:map{}};
let original=json_stringify(policy);let admitted=T.validate_policy(policy);
expect(admitted.ok and len(admitted)==1 and json_stringify(policy)==original,"valid empty policy no mutation or container exposure");
admitted.ok=false;admitted.sinks=map{unused:true};
expect(len(T.validate_policy(policy))==1 and T.validate_policy(policy).ok,"outcomes are fresh independent maps");
push(policy.taint_sources,nil);admitted.ok=true;policy.validated=true;
expect(not T.validate_policy(policy).ok and not T.analyze("","fixture.sapp",policy).ok,"mutation and forged validation flag do not bypass checks");
let override=map{entry_source:"let value=1;",taint_sources:[nil],security:map{taint_sources:[]}};
expect(D.analyze_entry("fixture.sapp",override).passed,"nested explicit replacement wins");
override.security.taint_sources=nil;
expect(not D.analyze_entry("fixture.sapp",override).ok,"nested nil falls back to malformed top-level policy");
for mode in ["protect","strict","audit"] {
    expect(D.analyze_entry("fixture.sapp",map{entry_source:"let value=1;",security_mode:mode}).passed,"default valid source unchanged");
}
print "security_taint_policy_preflight_pass";
