// Test: barrier builtin — N threads rendezvous
// barrier_new(n), barrier_wait(b)
// Single-threaded test: barrier of 1 should release immediately.

let b = barrier_new(1);
let released = barrier_wait(b);
if released == false { print "FAIL barrier(1) should return true (was the releasing thread)"; }

// barrier(2): first arrival waits, second releases both.
// In single-thread context we verify re-use works after reset.
let b2 = barrier_new(2);
// First arrival (doesn't release yet in real scenario, but we test from one thread)
// Since barrier_wait blocks, we just test that barrier_new doesn't crash.
// Real multi-thread test is in the threads tests.

// barrier(1) used twice (cyclic reset)
let b3 = barrier_new(1);
let r1 = barrier_wait(b3);
let r2 = barrier_wait(b3);
if r1 == false { print "FAIL barrier reuse r1"; }
if r2 == false { print "FAIL barrier reuse r2"; }

// once_new + once_is_done
let o = once_new();
if once_is_done(o) != false { print "FAIL once_is_done initial"; }
// (once_do would require calling a closure — tested via once_do_lazy in thread stdlib test)

print "barrier_once_builtins_pass";
