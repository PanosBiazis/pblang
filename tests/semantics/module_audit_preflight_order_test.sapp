let T = import("stdlib:project_text_audit.sapp");
fn expect(ok, label) { if not ok { throw "FAIL module-preflight-order: " + label; } }
fn combine(roots, modules) { return T.combine_module_reports("fixture", modules, map{requested_roots: roots}); }
fn rejected(result, error) {
    expect(not result.ok and not result.complete and result.error == error
        and not map_has(result, "quality_gate") and not map_has(result, "modules"), "fixed rejection before partial aggregation");
}
// The module is independently invalid. Its error must not mask bad requests.
for roots in [[nil], [false], [""], ["private\x00root"], [map{}], ["a", "a"]] {
    let error = if len(roots) == 2 { "duplicate module root" } else { "invalid module root" };
    for modules in [[map{}], [42]] { rejected(combine(roots, modules), error); }
    let options = map{requested_roots: roots, max_high: "private-policy-marker"};
    expect(try { T.combine_module_reports("fixture", [map{}], options); false } catch true,
        "gate policy still precedes requested element admission");
}
rejected(combine(["a"], [map{}]), "invalid module report at index 0");
rejected(combine([], [map{}]), "invalid module report at index 0");
for roots in [nil, false, map{}, "private-list-marker"] {
    rejected(T.combine_module_reports("fixture", [map{}], map{requested_roots: roots, max_high: "bad"}), "requested_roots must be a bounded array");
}
rejected(T.combine_module_reports("fixture", nil, map{requested_roots: [nil], max_high: "bad"}), "modules must be a bounded array");
rejected(T.combine_module_reports("fixture", [map{}], map{max_finding_index: 0, requested_roots: [nil], max_high: "bad"}), "invalid aggregate finding index bound");
let too_many = []; for i 257 { array_push(too_many, "a"); }
rejected(T.combine_module_reports("fixture", [map{}], map{requested_roots: too_many}), "requested_roots must be a bounded array");
let long = ""; for i 4097 { long = long + "x"; }
rejected(combine([long], [map{}]), "invalid module root");
let options = map{requested_roots: ["a", "a"]}; let before = json_stringify(options);
rejected(T.combine_module_reports("fixture", [map{}], options), "duplicate module root");
expect(json_stringify(options) == before, "invalid request is not mutated");
options.requested_roots = ["a"];
rejected(T.combine_module_reports("fixture", [map{}], options), "invalid module report at index 0");
options.requested_roots = [nil];
rejected(T.combine_module_reports("fixture", [map{}], options), "invalid module root");
expect(T.module_audit_engine_revision() == "pblang.module-audit.engine.v9", "valid checkpoint identity unchanged");
print "module_audit_preflight_order_pass";
