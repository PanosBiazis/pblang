// tests/semantics/mcp_wave2_misc_test.sapp — wave 2: pb_mcp.profiles + provider_registry.reset_round_robin

let M = import("stdlib/pb_mcp.sapp");
let PR = import("stdlib/provider_registry.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn contains(arr, v) { let i = 0; while i < len(arr) { if arr[i] == v { return true; } i = i + 1; } return false; }

// ── pb_mcp.profiles: distinct profiles ────────────────────────────────────────────
let pf = M.profiles();
if not contains(pf, "core-code") { fail("profiles has core-code"); }
if not contains(pf, "watchers") { fail("profiles has watchers"); }
eq(len(pf), 2, "two distinct profiles");

// ── provider_registry.reset_round_robin ───────────────────────────────────────────
PR.clear();
PR.register("a", "http://a", "");
PR.register("b", "http://b", "");
eq(PR.next_provider_name(), "a", "rr first -> a");
eq(PR.next_provider_name(), "b", "rr second -> b");
PR.reset_round_robin();
eq(PR.next_provider_name(), "a", "after reset -> a again");
PR.clear();

print "mcp_wave2_misc_pass";
