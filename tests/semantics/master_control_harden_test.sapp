// tests/semantics/master_control_harden_test.sapp — deny-ceiling whitespace-obfuscation fix.

let MC = import("stdlib/master_control.sapp");

fn fail(m) { throw "FAIL " + m; }
fn deny(action, m) { if MC.classify(action).allowed { fail(m + " should be DENIED"); } }
fn allow(action, m) { if not MC.classify(action).allowed { fail(m + " should be allowed"); } }

// baseline
deny(map{ kind: "exec", command: "rm -rf /" }, "plain rm -rf /");

// ── FIX: whitespace-obfuscated variants must still be blocked ──────────────────────
deny(map{ kind: "exec", command: "rm   -rf   /" }, "extra spaces");
deny(map{ kind: "exec", command: "rm\t-rf\t/" }, "tabs");
deny(map{ kind: "exec", command: "rm \t -rf \t /" }, "mixed whitespace");

// keyboard input that types an obfuscated destructive command is also blocked
deny(map{ kind: "type", text: "rm    -rf    /" }, "typed obfuscated rm -rf /");

// benign commands still pass policy
allow(map{ kind: "exec", command: "ls -la" }, "ls is fine");
allow(map{ kind: "exec", command: "echo hello world" }, "echo is fine");

print "master_control_harden_pass";
