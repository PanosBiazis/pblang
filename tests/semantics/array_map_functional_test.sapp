// tests/semantics/array_map_functional_test.sapp
// Tests for map/filter/reduce/contains/index_of etc. from stdlib/array.sapp and map.sapp

let arr = import("stdlib:array.sapp");
let mp = import("stdlib:map.sapp");

// ---- array.map ----
let doubled = arr.map([1, 2, 3, 4, 5], fn(x) { return x * 2; });
if doubled[0] != 2 or doubled[4] != 10 { throw "FAIL array.map"; }

// ---- array.filter ----
let evens = arr.filter([1, 2, 3, 4, 5, 6], fn(x) { return num_mod(x, 2) == 0; });
if len(evens) != 3 or evens[0] != 2 { throw "FAIL array.filter"; }

// ---- array.reduce ----
let total = arr.reduce([1, 2, 3, 4, 5], fn(acc, x) { return acc + x; }, 0);
if total != 15 { throw "FAIL array.reduce"; }

// ---- array.contains ----
if arr.contains([10, 20, 30], 20) == false { throw "FAIL array.contains true"; }
if arr.contains([10, 20, 30], 99) == true { throw "FAIL array.contains false"; }

// ---- array.index_of ----
if arr.index_of([10, 20, 30], 20) != 1 { throw "FAIL array.index_of found"; }
if arr.index_of([10, 20, 30], 99) != -1 { throw "FAIL array.index_of not found"; }

// ---- array.first / last ----
if arr.first([10, 20, 30]) != 10 { throw "FAIL array.first"; }
if arr.last([10, 20, 30]) != 30 { throw "FAIL array.last"; }
if arr.first([]) != nil { throw "FAIL array.first empty"; }
if arr.last([]) != nil { throw "FAIL array.last empty"; }

// ---- array.slice ----
let sliced = arr.slice([10, 20, 30, 40, 50], 1, 4);
if len(sliced) != 3 or sliced[0] != 20 or sliced[2] != 40 { throw "FAIL array.slice"; }
let clipped = arr.slice([10, 20, 30], -5, 99);
if len(clipped) != 3 or clipped[0] != 10 or clipped[2] != 30 { throw "FAIL array.slice clipped"; }
let empty_slice = arr.slice([10, 20, 30], 3, 1);
if len(empty_slice) != 0 { throw "FAIL array.slice reversed"; }

// ---- array.reverse ----
let rev = arr.reverse([1, 2, 3]);
if rev[0] != 3 or rev[2] != 1 { throw "FAIL array.reverse"; }

// ---- native-backed array transforms ----
let uniq = arr.unique([1, 2, 1, 3, 2]);
if len(uniq) != 3 or uniq[0] != 1 or uniq[2] != 3 { throw "FAIL array.unique"; }

let zipped = arr.zip(["a", "b", "c"], [1, 2]);
if len(zipped) != 2 or zipped[0][0] != "a" or zipped[1][1] != 2 { throw "FAIL array.zip"; }

let chunks = arr.chunk([1, 2, 3, 4, 5], 2);
if len(chunks) != 3 or chunks[0][1] != 2 or chunks[2][0] != 5 { throw "FAIL array.chunk"; }

let flat = arr.flatten([[1, 2], 3, [4]]);
if len(flat) != 4 or flat[0] != 1 or flat[3] != 4 { throw "FAIL array.flatten"; }

let taken = arr.take([1, 2, 3], 2);
if len(taken) != 2 or taken[1] != 2 { throw "FAIL array.take"; }
let dropped = arr.drop([1, 2, 3], 1);
if len(dropped) != 2 or dropped[0] != 2 { throw "FAIL array.drop"; }
if len(arr.take([1, 2, 3], -5)) != 0 { throw "FAIL array.take negative"; }
if len(arr.drop([1, 2, 3], -5)) != 3 { throw "FAIL array.drop negative"; }

// ---- array.sum ----
if arr.sum([1, 2, 3, 4, 5]) != 15 { throw "FAIL array.sum"; }
if arr.min([5, 1, 9]) != 1 { throw "FAIL array.min"; }
if arr.max([5, 1, 9]) != 9 { throw "FAIL array.max"; }

// ---- array.any / all ----
if arr.any([1, 2, 3], fn(x) { return x > 2; }) == false { throw "FAIL array.any"; }
if arr.all([2, 4, 6], fn(x) { return num_mod(x, 2) == 0; }) == false { throw "FAIL array.all"; }
if arr.all([2, 3, 6], fn(x) { return num_mod(x, 2) == 0; }) == true { throw "FAIL array.all false"; }
if arr.none([1, 2, 3], fn(x) { return x > 9; }) == false { throw "FAIL array.none"; }
if arr.find([1, 4, 7], fn(x) { return x > 3; }) != 4 { throw "FAIL array.find"; }
if arr.find([1, 4, 7], fn(x) { return x > 9; }) != nil { throw "FAIL array.find nil"; }
if arr.find_index([1, 4, 7], fn(x) { return x > 3; }) != 1 { throw "FAIL array.find_index"; }
if arr.count([1, 2, 3, 4], fn(x) { return x > 2; }) != 2 { throw "FAIL array.count"; }
let parts = arr.partition([1, 2, 3, 4], fn(x) { return num_mod(x, 2) == 0; });
if len(parts[0]) != 2 or parts[0][0] != 2 or parts[1][0] != 1 { throw "FAIL array.partition"; }

// ---- one-pass array pipelines ----
let fm = arr.filter_map([1, 2, 3, 4], fn(x) { if x % 2 == 0 { return x * 10; } return nil; });
if fm != [20, 40] { throw "FAIL array.filter_map"; }
if arr.scan([1, 2, 3, 4], fn(acc, x) { return acc + x; }, 0) != [1, 3, 6, 10] { throw "FAIL array.scan"; }
let distinct = arr.distinct_by([
    map{ id: 1, name: "first" }, map{ id: 1, name: "duplicate" }, map{ id: 2, name: "second" }
], fn(x) { return x.id; });
if len(distinct) != 2 or distinct[0].name != "first" or distinct[1].id != 2 { throw "FAIL array.distinct_by"; }
let indexed = arr.index_by(distinct, fn(x) { return x.id; });
if indexed["1"].name != "first" or indexed["2"].name != "second" { throw "FAIL array.index_by"; }
let wins = arr.windows([1, 2, 3, 4, 5], 3, 2);
if wins != [[1, 2, 3], [3, 4, 5]] { throw "FAIL array.windows"; }
if (try arr.windows([1], 0) catch "blocked") != "blocked" { throw "FAIL array.windows size guard"; }

// ---- map.get_or ----
let m = map{ a: 1, b: 2 };
if mp.get_or(m, "a", 99) != 1 { throw "FAIL map.get_or present"; }
if mp.get_or(m, "z", 99) != 99 { throw "FAIL map.get_or absent"; }

// ---- map.values ----
let vals = mp.values(map{ x: 10, y: 20 });
if len(vals) != 2 { throw "FAIL map.values len"; }

// ---- map.merge ----
let merged = mp.merge(map{ a: 1 }, map{ b: 2, a: 99 });
if merged.b != 2 { throw "FAIL map.merge b"; }
if merged.a != 99 { throw "FAIL map.merge overwrite"; }

// ---- map.entries / from_entries ----
let ents = mp.entries(map{ x: 10, y: 20 });
if len(ents) != 2 { throw "FAIL map.entries len"; }
let rebuilt = mp.from_entries(ents);
if map_has(rebuilt, "x") == false { throw "FAIL map.from_entries"; }

// ---- map.map_values ----
let mv = mp.map_values(map{ a: 1, b: 2 }, fn(v) { return v * 10; });
if mv.a != 10 or mv.b != 20 { throw "FAIL map.map_values"; }

print "array_map_functional_pass";
