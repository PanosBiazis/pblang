// tests/semantics/array_map_functional_test.sapp
// Tests for map/filter/reduce/contains/index_of etc. from stdlib/array.sapp and map.sapp

let arr = import("stdlib:array.sapp");
let mp = import("stdlib:map.sapp");

// ---- array.map ----
let doubled = arr.map([1, 2, 3, 4, 5], fn(x) { return x * 2; });
if doubled[0] != 2 or doubled[4] != 10 { print "FAIL array.map"; }

// ---- array.filter ----
let evens = arr.filter([1, 2, 3, 4, 5, 6], fn(x) { return num_mod(x, 2) == 0; });
if len(evens) != 3 or evens[0] != 2 { print "FAIL array.filter"; }

// ---- array.reduce ----
let total = arr.reduce([1, 2, 3, 4, 5], fn(acc, x) { return acc + x; }, 0);
if total != 15 { print "FAIL array.reduce"; }

// ---- array.contains ----
if arr.contains([10, 20, 30], 20) == false { print "FAIL array.contains true"; }
if arr.contains([10, 20, 30], 99) == true { print "FAIL array.contains false"; }

// ---- array.index_of ----
if arr.index_of([10, 20, 30], 20) != 1 { print "FAIL array.index_of found"; }
if arr.index_of([10, 20, 30], 99) != -1 { print "FAIL array.index_of not found"; }

// ---- array.first / last ----
if arr.first([10, 20, 30]) != 10 { print "FAIL array.first"; }
if arr.last([10, 20, 30]) != 30 { print "FAIL array.last"; }
if arr.first([]) != nil { print "FAIL array.first empty"; }
if arr.last([]) != nil { print "FAIL array.last empty"; }

// ---- array.slice ----
let sliced = arr.slice([10, 20, 30, 40, 50], 1, 4);
if len(sliced) != 3 or sliced[0] != 20 or sliced[2] != 40 { print "FAIL array.slice"; }

// ---- array.reverse ----
let rev = arr.reverse([1, 2, 3]);
if rev[0] != 3 or rev[2] != 1 { print "FAIL array.reverse"; }

// ---- array.sum ----
if arr.sum([1, 2, 3, 4, 5]) != 15 { print "FAIL array.sum"; }

// ---- array.any / all ----
if arr.any([1, 2, 3], fn(x) { return x > 2; }) == false { print "FAIL array.any"; }
if arr.all([2, 4, 6], fn(x) { return num_mod(x, 2) == 0; }) == false { print "FAIL array.all"; }
if arr.all([2, 3, 6], fn(x) { return num_mod(x, 2) == 0; }) == true { print "FAIL array.all false"; }

// ---- map.get_or ----
let m = map{ a: 1, b: 2 };
if mp.get_or(m, "a", 99) != 1 { print "FAIL map.get_or present"; }
if mp.get_or(m, "z", 99) != 99 { print "FAIL map.get_or absent"; }

// ---- map.values ----
let vals = mp.values(map{ x: 10, y: 20 });
if len(vals) != 2 { print "FAIL map.values len"; }

// ---- map.merge ----
let merged = mp.merge(map{ a: 1 }, map{ b: 2, a: 99 });
if merged.b != 2 { print "FAIL map.merge b"; }
if merged.a != 99 { print "FAIL map.merge overwrite"; }

// ---- map.entries / from_entries ----
let ents = mp.entries(map{ x: 10, y: 20 });
if len(ents) != 2 { print "FAIL map.entries len"; }
let rebuilt = mp.from_entries(ents);
if map_has(rebuilt, "x") == false { print "FAIL map.from_entries"; }

// ---- map.map_values ----
let mv = mp.map_values(map{ a: 1, b: 2 }, fn(v) { return v * 10; });
if mv.a != 10 or mv.b != 20 { print "FAIL map.map_values"; }

print "array_map_functional_pass";
