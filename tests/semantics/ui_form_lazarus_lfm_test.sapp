let LFM=import("stdlib:ui_form_lazarus_lfm.sapp");
let Forms=import("stdlib:ui_form_interchange.sapp");
let UI=import("stdlib:ui_document.sapp");

let source="object Form1: TForm1\n  Caption = 'Workspace'\n"
    +"  ClientWidth = 640\n  ClientHeight = 480\n  LCLVersion = '3.0'\n"
    +"  object Panel1: TPanel\n    Width = 600\n    Height = 400\n    Align = alClient\n"
    +"    object Label1: TLabel\n      Caption = #915#949#953#945\n    end\n"
    +"    object Edit1: TEdit\n      Text = ''\n      ReadOnly = True\n    end\n"
    +"    object Button1: TButton\n      Caption = 'Apply'\n      OnClick = FOREIGN_HANDLER_CANARY\n    end\n"
    +"  end\nend\n";
let imported=LFM.import_text(source);
assert(imported.ok and imported.atomic and imported.lossy,"bounded LFM canonical import");
assert(imported.format=="pblang.lazarus-lfm-import.v1"
    and imported.document.source_format=="lazarus-lfm","distinct source dialect");
assert(imported.widget_count==4 and imported.document.widgets[1].parent=="Panel1",
    "nested parent ownership retained");
assert(imported.document.widgets[1].props.text=="Γεια"
    and imported.document.widgets[2].props.read_only,"Unicode and read-only retained");
assert(imported.unmapped_property_count==2,"LCL metadata and unsupported alignment counted");
assert(imported.foreign_handlers_omitted and imported.unmapped_event_count==1
    and not str_contains(json_stringify(imported),"FOREIGN_HANDLER_CANARY"),
    "foreign handlers never enter a bindable event map");
assert(UI.validate(imported.document).ok and not imported.root_class_verified
    and not imported.source_semantics_preserved and not imported.production_ready,
    "canonical validation does not establish Pascal ancestry or runtime parity");
assert(json_stringify(imported)==json_stringify(LFM.import_text(source)),"deterministic import");
assert(Forms.detect("screen.lfm",source).selected=="lazarus-lfm","registry detects LFM signature");
let partial="object Main: TForm1\nnot a valid body";
let detected=Forms.detect("screen.lfm",partial);
assert(detected.ok and detected.signature_only and not detected.validated
    and not detected.dialect_identity_verified and not LFM.import_text(partial).ok,
    "cheap signature never implies whole-document validity or source identity");
assert(not Forms.detect("bad\nname.lfm",source).ok
    and not Forms.detect("bad"+strfromcharcode(8238)+"name.lfm",source).ok,
    "display-control filenames rejected without echo");
assert(Forms.import_text("lazarus-lfm",source).ok,"explicit registry dispatch");
assert(not Forms.conversion_plan("lazarus-lfm","pblang-gui").executable,
    "preview import does not authorize executable conversion");
assert(not Forms.import_text("qt-ui",source).ok
    and not Forms.import_text("LAZARUS-LFM",source).ok
    and not Forms.import_text(nil,source).ok,"no dynamic or case-normalized fallback");
assert(not Forms.detect("screen.lfm","").ok
    and not Forms.detect("screen.lfm","not a form").ok,"extension is not sufficient");
assert(not LFM.import_text(source,"screen.dfm").ok
    and not LFM.import_text(source,"a\nname.lfm").ok
    and not LFM.import_text(source,"../screen.lfm").ok,"strict logical LFM name");

fn rejected(text,code) {
    let result=LFM.import_text(text);
    assert(not result.ok and result.error==code
        and result.format=="pblang.lazarus-lfm-import.v1",code);
}
for root in ["TDataModule","TFrame","TTimer","TCustomForm","TFormUnproven"] {
    rejected("object Main: "+root+"\nend","lfm-root-class-unsupported");
}
for child in ["TRichEdit","TTimer","TSQLQuery","TThirdPartyButton"] {
    rejected("object Main: TForm1\nobject Child: "+child+"\nend\nend",
        "unsupported-component-class");
}
rejected("inherited Main: TForm1\nend","lfm-inheritance-unsupported");
rejected("object Main: TForm1\ninline Child: TPanel\nend\nend","lfm-inheritance-unsupported");
rejected("TPF0binary","binary-lfm-unsupported");
rejected("object Main: TForm1\nPicture.Data = {FF}\nend","binary-blob-unsupported");
rejected("object Main: TForm1\nItems = <item>\nend","collection-unsupported");
rejected("object Main: TForm1\nCaption = Run();\nend","unsupported-expression");
rejected("object Main: TForm1\nCaption = 'a'\ncaption = 'b'\nend","duplicate-property");
rejected("object Main: TForm1\nobject X: TButton\nend\nobject x: TLabel\nend\nend",
    "duplicate-object-id");
rejected("object Main: TForm1\nend\nobject B: TForm2\nend","trailing-data");
rejected(str_repeat(" ",262145),"source-too-large");
rejected("object Main: TForm1\n"+str_repeat("object P: TPanel\n",1)
    +str_repeat("x",16385),"line-too-large");
let nested="object Main: TForm1\n";
for i in range(0,32) { nested=nested+"object P"+str(i)+": TPanel\n"; }
rejected(nested,"object-depth-exceeded");
let objects="object Main: TForm1\n";
for i in range(0,513) { objects=objects+"object B"+str(i)+": TButton\nend\n"; }
rejected(objects+"end","too-many-objects");
rejected("object Main: TForm1\nCaption = '"+str_repeat("x",8193)+"'\nend","invalid-value");
let private_source="object Main: TForm1\nFileName = '/private/LFM_SECRET_CANARY'\n"
    +"URL = 'https://LFM_SECRET_CANARY.invalid'\nend";
let private_result=LFM.import_text(private_source);
assert(private_result.ok and private_result.external_reference_present
    and not str_contains(json_stringify(private_result),"LFM_SECRET_CANARY"),
    "external references omitted without access");
assert(not LFM.status().filesystem and not LFM.status().process
    and not LFM.status().production_ready,"pure preview status");
let root_event=LFM.import_text("object Main: TForm1\nOnCreate = ROOT_HANDLER_CANARY\nend");
assert(root_event.ok and root_event.unmapped_event_count==1
    and not str_contains(json_stringify(root_event),"ROOT_HANDLER_CANARY"),"root handler omitted");
print "ui_form_lazarus_lfm_pass";
