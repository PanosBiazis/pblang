let A = import("stdlib:compiler/source_analysis.sapp");
let F = import("stdlib:compiler/selfhost_frontend.sapp");
for source in [nil, "", "  ", "/* comment only */", "let = ;", "let n=0x;",
    "let n=nil-1;", "let n=nil - 1;", "let n=nil/*c*/-0x1;",
    "let n=1; print n;", "fn f(x:number){return x;} f();",
    "fn f(x:number){return x;} print f(2);", "print absent;",
    "let s=\"λ😀\"; print s;", "let s=\"unterminated", "let n=1;\n/* unclosed",
    "let a=[1]; print a[missing];", "let a=[1]; print a[0];",
    "throw \"not executed\";", "let x = try missing() catch nil;",
    "fn f(x:number=1){return x;} f();"] {
    assert(json_stringify(A.analyze(source)) == json_stringify(F.frontend_analyze(source)),
        "source-only/full frontend result parity, including tokens and diagnostic metadata");
}
print "source_analysis_parity_pass";
