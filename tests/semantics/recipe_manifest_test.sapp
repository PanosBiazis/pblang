let R=import("stdlib:recipe_manifest.sapp");
fn recipe(id,expected) {return map{id:id,platforms:["linux","web"],requires:["compute"],inputs:map{amount:7},expected:expected};}
fn doc(items) {return map{format:R.FORMAT,recipes:items};}
fn bad(value) {return (try R.validate(value) catch nil)==nil;}
let manifest=doc([recipe("first",map{value:7}),recipe("second",map{text:"007"})]);let before=json_stringify(manifest);
assert(R.validate(json_parse(before)),"JSON roundtrip of trusted generated manifest");
let plan=R.plan(manifest,"linux",["compute"]);assert(plan.recipes[0].status=="ready" and not plan.execution_performed and not plan.capability_claims_verified,"readiness is not execution");
plan.recipes[0].inputs.amount=99;plan.recipes[0].expected.value=99;assert(json_stringify(manifest)==before,"detached plan");
let missing=R.plan(manifest,"linux",[]);assert(missing.recipes[0].status=="unsupported" and missing.recipes[0].missing_capabilities==["compute"],"missing capability");
let wrong_platform=R.plan(manifest,"windows",["compute"]);assert(not wrong_platform.recipes[0].platform_supported and wrong_platform.recipes[0].status=="unsupported","platform requirement");
let observed=[map{id:"second",actual:map{text:7}},map{id:"first",actual:map{value:7}}];
let report=R.assess(manifest,"linux",["compute"],observed);
assert(report.counts.matched==1 and report.counts.mismatch==1 and report.recipes[0].id=="first","typed equality and manifest order");
assert(not report.execution_verified and report.observations_are_caller_supplied and not report.raw_values_included,"honest evidence boundary");
assert(R.assess(manifest,"linux",["compute"],[]).counts.not_run==2,"missing observation is not success");
assert(R.assess(manifest,"android",[],[]).counts.unsupported==2,"unsupported assessment");
for observations in [[map{id:"other",actual:map{}}],[map{id:"first",actual:map{}},map{id:"first",actual:map{}}],[map{id:"first",actual:map{x:[]}}],[map{id:"first",actual:map{},extra:0}]] {assert((try R.assess(manifest,"linux",["compute"],observations) catch nil)==nil,"bad observations");}
assert((try R.assess(manifest,"android",["compute"],[map{id:"first",actual:map{value:7}}]) catch nil)==nil,"unsupported observation cannot become evidence");
for value in [nil,[],map{},map{format:R.FORMAT,recipes:[],extra:0},doc([nil]),doc([recipe("x",map{}),recipe("x",map{})]),doc([recipe("bad-id",map{})]),doc([recipe("x",map{nested:map{}})]),doc([recipe("x",map{large:1000000000001})]),doc([recipe("x",map{text:str_repeat("x",257)})])] {assert(bad(value),"malformed manifest");}
let r=recipe("x",map{});r.platforms=[];assert(bad(doc([r])),"empty platform list");r.platforms=["linux","linux"];assert(bad(doc([r])),"duplicate platform");r.platforms=["unknown"];assert(bad(doc([r])),"unknown platform");r.platforms=["linux"];r.requires=["compute","compute"];assert(bad(doc([r])),"duplicate capability");
assert((try R.plan(manifest,"linux",["compute","compute"]) catch nil)==nil,"duplicate available capability");
let max=[];for i in range(0,32) {array_push(max,recipe("r"+str(i),map{empty:nil,flag:true,min:-1000000000000,max:1000000000000,text:str_repeat("x",256)}));}
assert(R.validate(doc(max)),"max recipe count and scalar bounds");array_push(max,recipe("overflow",map{}));assert(bad(doc(max)),"recipe count bound");
let fields=map{};for i in range(0,16) {fields["f"+str(i)]=i;}assert(R.validate(doc([recipe("x",fields)])),"16 fields");fields.extra=17;assert(bad(doc([recipe("x",fields)])),"field limit");
assert(R.assess(doc([recipe("x",map{flag:true})]),"linux",["compute"],[map{id:"x",actual:map{flag:1}}]).counts.mismatch==1,"boolean is not number");
print "recipe_manifest_pass";
