let A=import("stdlib:project_audit.sapp");
let T=import("stdlib:project_text_audit.sapp");
fn expect(ok,label){if not ok {throw "FAIL text-gate: "+label;}}
fn rejects(action){return try {action();false} catch true;}
let defaults=A.require_quality_gate_options();
expect(json_stringify(defaults)==json_stringify(A.quality_gate(map{}).thresholds),"canonical defaults");
defaults.max_high=99;
expect(A.require_quality_gate_options().max_high==0,"fresh defaults");
let opts=map{max_medium:7,max_source_medium:nil,extra:"ignored"};
let original=json_stringify(opts);let resolved=A.require_quality_gate_options(opts);
expect(resolved.max_source_medium==7 and json_stringify(opts)==original,"inheritance and no mutation");
opts.max_medium=9;expect(resolved.max_medium==7,"no input alias");
resolved.max_medium=11;expect(opts.max_medium==9,"no output alias");
resolved.max_high=parse_number("inf");
expect(rejects(fn(){A.quality_gate(map{},resolved);}),"canonical value map is revalidated");
let invalid=[true,"private-policy-marker",[],map{},bigint(1),rational("1/1"),decimal("1"),parse_number("NaN"),parse_number("inf"),parse_number("-inf"),-1,0.5,9007199254740992];
for field in ["max_high","max_medium","max_total","max_source_high","max_source_medium","max_source_total"] {
    for value in invalid {
        let o=map{};o[field]=value;
        expect(rejects(fn(){A.require_quality_gate_options(o);}),"shared numeric rejection");
        expect(rejects(fn(){T.audit_roots("fixture",[],o);}),"root numeric rejection");
        expect(rejects(fn(){T.audit_modules("fixture",["tests/fixtures/module_audit/tools"],o);}),"module numeric rejection");
        expect(rejects(fn(){T.combine_module_reports("fixture",[],o);}),"aggregate numeric rejection");
    }
}
for field in ["allow_roadmap","source_only_blockers"] {
    for value in [0,1,"false",[],map{}] {
        let o=map{};o[field]=value;
        expect(rejects(fn(){T.audit_roots("fixture",[],o);}),"root bool rejection");
        expect(rejects(fn(){T.audit_modules("fixture",["tests/fixtures/module_audit/tools"],o);}),"module bool rejection");
        expect(rejects(fn(){T.combine_module_reports("fixture",[],o);}),"aggregate bool rejection");
    }
}
for o in [0,false,"private-options-marker",[]] {
    expect(rejects(fn(){A.require_quality_gate_options(o);}),"public options shape");
    expect(rejects(fn(){T.audit_roots("fixture",[],o);}),"root options shape");
    expect(T.audit_modules("fixture",["tests/fixtures/module_audit/tools"],o).error=="invalid module audit bounds","module options shape uses numeric preflight result");
    expect(rejects(fn(){T.combine_module_reports("fixture",[],o);}),"aggregate options shape");
}
let omitted=T.combine_module_reports("fixture",[]).quality_gate.thresholds;
expect(omitted.max_medium==8 and omitted.max_source_medium==4 and omitted.source_only_blockers,"wrapper omitted defaults");
let nils=map{max_medium:nil,max_source_medium:nil,source_only_blockers:nil};
let explicit_nil=T.combine_module_reports("fixture",[],nils).quality_gate.thresholds;
expect(explicit_nil.max_medium==5 and explicit_nil.max_source_medium==5 and not explicit_nil.source_only_blockers,"explicit nil compatibility");
let inherited=T.combine_module_reports("fixture",[],map{max_medium:7,max_source_medium:nil}).quality_gate.thresholds;
expect(inherited.max_medium==7 and inherited.max_source_medium==7,"wrapper source inheritance");
for value in [0,1,9007199254740991] {
    expect(T.combine_module_reports("fixture",[],map{max_total:value}).ok,"valid inclusive ceilings");
}
expect(T.audit_modules("fixture",[],map{max_high:"invalid"}).error=="roots must contain 1..256 modules","root shape precedence");
expect(T.audit_modules("fixture",["fixture"],map{max_findings_per_file:0,max_high:"invalid"}).error=="invalid module audit bounds","finding bound precedence");
expect(T.combine_module_reports("fixture",42,map{max_high:"invalid"}).error=="modules must be a bounded array","module array precedence");
expect(T.combine_module_reports("fixture",[],map{max_finding_index:0,max_high:"invalid"}).error=="invalid aggregate finding index bound","aggregate bound precedence");
expect(T.combine_module_reports("fixture",[],map{requested_roots:42,max_high:"invalid"}).error=="requested_roots must be a bounded array","requested roots precedence");
expect(T.module_audit_engine_revision()=="pblang.module-audit.engine.v9","module admission checkpoint revision");
print "project_text_audit_gate_policy_pass";
