// tests/semantics/assert_stdlib_test.sapp
let a = import("stdlib:assert.sapp");

// Basic assertions
a.eq(1 + 1, 2, "1+1=2");
a.eq("hello", "hello", "string eq");
a.ne(1, 2, "1 != 2");
a.ok(true, "true is ok");
a.ok(1 > 0, "1 > 0");
a.is_nil(nil, "nil is nil");
a.not_nil(42, "42 is not nil");

// throws test
a.throws(fn() {
    let x = 1 / 0;  // may or may not throw; try a runtime error instead
    nil[0];         // index nil — should throw
}, "nil index should throw");

// Summary should show all passed
let ok = a.summary();
if ok == false { print "FAIL assert summary"; }

print "assert_stdlib_pass";
