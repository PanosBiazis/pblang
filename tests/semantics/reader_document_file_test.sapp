let Input=import("../../examples/declarative_browser/document_file.sapp");let App=import("../../examples/declarative_browser/app.sapp");let D=import("stdlib:browser_document.sapp");
let count=0;fn check(ok,label){assert(ok,label);count=count+1;}
let source="<article><h1>Imported — Ελληνικά</h1><p>Read-only local text.</p><a href=\"pb://guide\">Guide</a><a href=\"pb://home\">Home</a></article>";
let valid=Input.decode(str_to_bytes(source));check(valid.ok and valid.blocks==3 and valid.source==source,"existing parser accepts supported source");
check(Input.decode(str_to_bytes(" \n\t"+source+"\r\n")).source==source,"outer whitespace accepted without modifying source bytes");
check(Input.decode(str_to_bytes(source+str_repeat(" ",16384-len(str_to_bytes(source))))).ok,"exact byte limit accepted before trimming");
for bytes in [[],[255],[192,175],str_to_bytes(source+str_repeat(" ",16385-len(str_to_bytes(source)))),str_to_bytes("<html>unsupported</html>"),str_to_bytes("<article><h1>x</h1><script>alert(1)</script></article>"),str_to_bytes("<article><h1>x</h1><a href=\"https://example.com/\">remote</a></article>"),str_to_bytes("<article><h1>x</h1><p>"+str_repeat("x",257)+"</p></article>"),str_to_bytes("<article><h1>x</h1>"+str_repeat("<p>x</p>",9)+"</article>"),str_to_bytes("<article><h1>x</h1><p onclick=\"run\">x</p></article>")] {
    let rejected=Input.decode(bytes);check(not rejected.ok and rejected.source==nil,"unsupported content yields no admitted source");
}
for value in [nil,42,"relative.html","/","/bad\nname","/bad\rname","/bad\tname","/bad\\name","/"+str_repeat("x",4096)] {check(Input.path(value)==nil,"invalid path rejected");}
check(Input.path("/tmp/./a/../Ελληνικά with spaces.html")=="/tmp/Ελληνικά with spaces.html","absolute lexical normalization preserves Unicode/spaces");
for item in [map{bytes:nil,code:"invalid_input"},map{bytes:[],code:"empty_document"},map{bytes:str_to_bytes(" \n\t"),code:"empty_document"},map{bytes:[255],code:"invalid_utf8"},map{bytes:[192,175],code:"invalid_utf8"},map{bytes:str_to_bytes(str_repeat(" ",16385)),code:"too_large"},map{bytes:str_to_bytes("<article><h1>PRIVATE_TITLE</h1><script>SECRET_SOURCE_MARKER</script></article>"),code:"unsupported_document"}] {
    let failure=Input.decode(item.bytes);check(not failure.ok and failure.code==item.code,"actionable stable failure code");
    check(failure.source==nil and not str_contains(failure.error,"PRIVATE_TITLE") and not str_contains(failure.error,"SECRET_SOURCE_MARKER"),"diagnostic never exposes source");
}
check(valid.code=="ok" and valid.error==nil,"admitted result has explicit success code");
check(Input.load("relative.html").code=="invalid_path","invalid path diagnosed before filesystem access");
let c=App.create("local","dark",nil,valid.source);let snapshot=c.session.snapshot();check(D.inspect(snapshot.document).title=="Imported — Ελληνικά" and snapshot.url=="pb://home","import becomes home for this session only");
check(c.session.follow(1).url=="pb://guide","existing local guide permitted");check(D.inspect(c.session.home().document).title=="Imported — Ελληνικά","Home returns to imported document");
let old=c.session.snapshot();let old_appearance=c.appearance;let old_anchor=c.reading_anchor;
check((try App.create("local","dark",nil,"<invalid>") catch nil)==nil,"invalid new session rejected");
check(c.session.snapshot()==old and c.appearance==old_appearance and c.reading_anchor==old_anchor,"existing session and settings unchanged by invalid creation");
let other=App.create();check(D.inspect(other.session.snapshot().document).title=="PBLang document browser","default launch unchanged");
let denied=Input.decode(str_to_bytes("<article><h1>Local</h1><a href=\"pb://unregistered\">Unknown</a></article>"));check(denied.ok,"lexically supported local link retained");
let restricted=App.create("local","dark",nil,denied.source);check((try restricted.session.follow(0) catch nil)==nil,"unregistered local destination remains denied");
restricted.session.close();other.session.close();c.session.close();print "reader_document_file_pass checks="+str(count);
