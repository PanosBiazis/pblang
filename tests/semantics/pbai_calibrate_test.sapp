// tests/semantics/pbai_calibrate_test.sapp — measurable accuracy + auto-calibration. evaluate()
// scores the ensemble AND each model on a labeled set; calibrate() learns per-voter reliability
// from that set so the ensemble becomes MORE accurate (down-weighting the models that are wrong).

let ens = import("stdlib/pbai_ensemble.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// native model: always correct ("bugs" with high confidence)
let scores = fn(p) { return map{ intent: "bugs", scores: [0.05, 0.9, 0.05, 0.05, 0.05] }; };
ens.configure(scores, ["explain", "bugs", "improve", "comment", "general"]);
ens.clear_voters();
ens.reset_stats();
ens.clear_native_cache();

let examples = [
    map{ prompt: "a", intent: "bugs" }, map{ prompt: "b", intent: "bugs" },
    map{ prompt: "c", intent: "bugs" }, map{ prompt: "d", intent: "bugs" }
];

// ── evaluate: per-model + ensemble accuracy on a labeled set ─────────────────────────────
ens.register_voter_weighted("heavy_wrong", fn(x) { return "improve"; }, 3);
ens.set_adaptive(true);
let ev = ens.evaluate(examples);
eq(ev.n, 4, "evaluated all examples");
approx(ev.per_model["native"], 1.0, "native is 100% accurate");
approx(ev.per_model["heavy_wrong"], 0.0, "the wrong voter is 0% accurate");
// before calibration the heavy wrong voter dominates -> ensemble is WRONG
eq(ev.ensemble_accuracy, 0, "uncalibrated ensemble is dragged down by the heavy wrong voter");

// ── calibrate: learn reliability from the set -> ensemble accuracy jumps ─────────────────
let cal = ens.calibrate(examples);
approx(cal.before, 0, "calibrate reports the pre-accuracy");
eq(cal.after, 1.0, "after calibration the reliable model wins -> 100%");
if ens.reliability("heavy_wrong") > 0.3 { fail("wrong voter reliability learned low"); }
if ens.reliability("native") < 0.7 { fail("native reliability learned high"); }

// a fresh evaluate now agrees with the calibrated accuracy
eq(ens.evaluate(examples).ensemble_accuracy, 1.0, "post-calibration evaluate is 100%");

ens.clear_voters();
ens.reset_stats();
print "pbai_calibrate_pass";
