// tests/semantics/thread_pool_enrich_test.sapp — fix + enrichment for stdlib/thread_pool.sapp
//
// BUG: submit_priority stored a priority but run_all/run_parallel never honored
//   it — tasks always ran in submission order, so priorities were ignored.
//   run_all now runs pending tasks highest-priority-first (stable for ties).
// ENRICH: get_result/get_status (the docs promised a task id "to retrieve
//   results" but there was no getter), submit_all.

let tp = import("stdlib/thread_pool.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base single-task run_all unchanged ───────────────────────────────────────────
let p0 = tp.new_thread_pool(2);
tp.submit(p0, fn() { return 21; });
let out0 = tp.run_all(p0);
eq(len(out0.results), 1, "run_all one result"); eq(out0.results[0], 21, "run_all value");

// ── FIX: run_all honors priority (higher first; ties keep submission order) ──────
let p = tp.new_thread_pool(2);
tp.submit_priority(p, fn() { return "low"; }, 1);
tp.submit_priority(p, fn() { return "high"; }, 10);
tp.submit_priority(p, fn() { return "mid"; }, 5);
let out = tp.run_all(p);
eq(out.results[0], "high", "highest priority ran first");
eq(out.results[1], "mid", "then mid"); eq(out.results[2], "low", "then low");

// ── ENRICH: get_result / get_status by task id ───────────────────────────────────
let p2 = tp.new_thread_pool(2);
let id = tp.submit(p2, fn() { return 99; });
tp.run_all(p2);
eq(tp.get_result(p2, id), 99, "get_result by id"); eq(tp.get_status(p2, id), "done", "get_status done");

// ── ENRICH: submit_all returns ids and runs all ──────────────────────────────────
let p3 = tp.new_thread_pool(2);
let ids = tp.submit_all(p3, [fn() { return 1; }, fn() { return 2; }]);
eq(len(ids), 2, "submit_all returns an id per task");
let out3 = tp.run_all(p3);
eq(out3.completed, 2, "submit_all tasks all ran");

// ── failures are isolated and counted ────────────────────────────────────────────
let p4 = tp.new_thread_pool(2);
tp.submit(p4, fn() { throw "boom"; });
tp.submit(p4, fn() { return 7; });
let out4 = tp.run_all(p4);
eq(out4.failed, 1, "one failure counted"); eq(out4.completed, 1, "good task still ran");

print "thread_pool_enrich_pass";
