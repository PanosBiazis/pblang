let G=import("stdlib:gui.sapp");
fn fixture(value="") {
 let f=G.form("event modifiers",400,240);G.add(f,G.textbox("field",10,10,250,30,value));
 G.add(f,G.textbox("second",10,50,250,30,""));G.add(f,G.button("go",10,90,100,30,"Go",nil));f.focus="field";return f;
}
fn press(f, key, options=nil) {if options==nil {options=map{};}let ev=map{type:"keydown",key:key};for name in map_keys(options){ev[name]=options[name];}let original=json_stringify(ev);G.handle_event(f,ev);assert(json_stringify(ev)==original,"caller event is immutable");}
fn up(f,key){G.handle_event(f,map{type:"keyup",key:key});}
let f=fixture();let w=G.get(f,"field");
press(f,"A",map{shift:true,ctrl:false,meta:false});press(f,"LeftShift");up(f,"A");up(f,"LeftShift");
assert(w.value=="A","letter-first native snapshot respects its Shift flag");
press(f,"Period",map{shift:true});up(f,"Period");assert(w.value=="A>","shifted punctuation uses the event flag");
// Explicit false overrides tracked modifiers only for the current event.
press(f,"LeftShift");press(f,"B",map{shift:false});up(f,"B");assert(w.value=="A>b" and f.shift,"explicit false is not ignored and does not rewrite tracked state");
press(f,"C");up(f,"C");assert(w.value=="A>bC","legacy event uses tracked Shift");
for invalid in [nil,"true",1,[],map{}] {press(f,"D",map{shift:invalid});up(f,"D");}
assert(w.value=="A>bCDDDDD","malformed flags fall back without truthy coercion");up(f,"LeftShift");
press(f,"E",map{shift:"true"});up(f,"E");assert(str_ends_with(w.value,"e"),"malformed true string is not a shift flag");
// Ctrl+A and Meta+A work before native modifier key edges; no accidental letter insertion.
for modifier in ["ctrl","meta"] {
 let text=fixture("old");let field=G.get(text,"field");let flags=map{shift:false};flags[modifier]=true;
 press(text,"A",flags);up(text,"A");assert(field.value=="old" and field.selection_anchor==0 and field.caret==3,"explicit selection chord");
 press(text,"X",map{ctrl:false,meta:false});up(text,"X");assert(field.value=="x","selection replacement after released chord");
}
// Resolve each modifier separately: false Ctrl must not erase a tracked Meta.
let mixed=fixture("data");let field=G.get(mixed,"field");press(mixed,"LeftSuper");press(mixed,"A",map{ctrl:false});up(mixed,"A");
assert(field.selection_anchor==0 and field.caret==4,"per-modifier legacy fallback");
press(mixed,"X",map{ctrl:false,meta:false});up(mixed,"X");assert(field.value=="x","explicit false flags allow text despite a stale tracked modifier");up(mixed,"LeftSuper");
let ctrl=fixture("abc");let ctrlfield=G.get(ctrl,"field");press(ctrl,"LeftCtrl");press(ctrl,"A");up(ctrl,"A");
assert(ctrlfield.selection_anchor==0 and ctrlfield.caret==3,"legacy Ctrl+A preserved");press(ctrl,"Z",map{ctrl:true});up(ctrl,"Z");assert(ctrlfield.value=="abc","modified nonselection text suppressed");up(ctrl,"LeftCtrl");
let paste=fixture("keep");press(paste,"V",map{ctrl:true});up(paste,"V");press(paste,"V",map{meta:true});up(paste,"V");assert(G.get(paste,"field").value=="keep","paste chords do not insert a literal v; clipboard is outside this contract");
press(paste,"LeftCtrl");press(paste,"V",map{ctrl:false,meta:false});up(paste,"V");up(paste,"LeftCtrl");press(paste,"X");up(paste,"X");assert(G.get(paste,"field").value=="keepvx","released event flags and later legacy release allow ordinary text");
// Reverse traversal uses the Tab event's flag, not event enumeration order.
let tabs=fixture();press(tabs,"Tab",map{shift:true});up(tabs,"Tab");assert(tabs.focus=="go","Shift+Tab wraps backward without preceding shift edge");
press(tabs,"LeftShift");press(tabs,"Tab",map{shift:false});up(tabs,"Tab");assert(tabs.focus=="field","false Shift traverses forward while tracking remains held");up(tabs,"LeftShift");
// Repeat and editor protections are unchanged; flags also apply to repeats.
let repeat=fixture();press(repeat,"A",map{shift:false});press(repeat,"A",map{shift:true});up(repeat,"A");assert(G.get(repeat,"field").value=="aA","repeat path consumes current-event modifiers");
let protected=fixture("keep");let pw=G.get(protected,"field");pw.readonly=true;press(protected,"A",map{ctrl:true});press(protected,"X",map{shift:true});assert(pw.value=="keep","readonly remains protected");
let area=G.form("area",300,160);G.add(area,G.textarea("area",10,10,250,100,""));area.focus="area";
press(area,"A",map{shift:true});up(area,"A");press(area,"B",map{ctrl:true});up(area,"B");assert(G.get(area,"area").value=="A","textarea receives shift and suppresses command chord");
print "gui_event_modifiers_pass";
