// Test: desktop-GUI round-trip parser (stdlib/gui_parse.sapp) — Visual_Designer D3, §97.
// Reads generated pblang desktop code (gui.sapp) back into the designer's form + widget
// tree (inverse of dzGenDesktop) via the self-hosted parser. Runs in the VM.
let G = import("stdlib/gui_parse.sapp");

let code = "// generated by pblang Studio — desktop GUI (gui.sapp)\n"
    + "let gui = import(\"stdlib/gui.sapp\");\n"
    + "fn on_ok_click(ctx) { }\n"
    + "fn on_sub_change(ctx) { }\n"
    + "fn build() {\n"
    + "    let form = gui.form(\"Sign Up\", 500, 360);\n"
    + "    gui.add(form, gui.label(\"label1\", 20, 36, \"Your name:\"));\n"
    + "    gui.add(form, gui.textbox(\"name\", 20, 64, 220, 28, \"\"));\n"
    + "    gui.add(form, gui.checkbox(\"sub\", 20, 110, \"Subscribe\", true, on_sub_change));\n"
    + "    gui.add(form, gui.button(\"ok\", 20, 150, 120, 32, \"OK\", on_ok_click));\n"
    + "    gui.add(form, gui.panel(\"info\", 260, 36, 200, 120, \"Info\"));\n"
    + "    return form;\n"
    + "}\n"
    + "fn main() { gui.run(build()); }\nmain();";

let d = G.parse(code);
assert(d.form.title == "Sign Up", "form title recovered");
assert(d.form.w == 500 and d.form.h == 360, "form size recovered");
assert(len(d.widgets) == 5, "five widgets recovered");
assert(d.widgets[0].kind == "label" and d.widgets[0].props.text == "Your name:", "label round-trip");
assert(d.widgets[1].kind == "textbox" and d.widgets[1].name == "name" and d.widgets[1].w == 220, "textbox geometry");
assert(d.widgets[2].kind == "checkbox" and d.widgets[2].props.checked == true, "checkbox checked state");
assert(d.widgets[2].events.change == "on_sub_change", "checkbox change handler wired");
assert(d.widgets[3].kind == "button" and d.widgets[3].events.click == "on_ok_click", "button click handler wired");
assert(d.widgets[4].kind == "panel" and d.widgets[4].props.title == "Info", "panel title round-trip");
assert(map_has(d.widgets[1], "events") == false, "unwired widget has no events");

// ── extended widgets (§98): radio / select / slider round-trip ────────────────────────
let code2 = "fn build() {\n"
    + "    let form = gui.form(\"W\", 400, 300);\n"
    + "    gui.add(form, gui.radio(\"r1\", 20, 20, \"A\", \"grp\", true, on_pick));\n"
    + "    gui.add(form, gui.radio(\"r2\", 20, 50, \"B\", \"grp\", false, nil));\n"
    + "    gui.add(form, gui.select(\"sel\", 20, 90, 160, 26, [\"one\", \"two\", \"three\"], 1, nil));\n"
    + "    gui.add(form, gui.slider(\"sld\", 20, 130, 200, 20, 42, 0, 100, nil));\n"
    + "    return form;\n"
    + "}";
let d2 = G.parse(code2);
assert(len(d2.widgets) == 4, "four extended widgets recovered");
assert(d2.widgets[0].kind == "radio" and d2.widgets[0].props.group == "grp" and d2.widgets[0].props.selected == true, "radio props");
assert(d2.widgets[0].events.change == "on_pick", "radio change handler wired");
assert(map_has(d2.widgets[1], "events") == false, "unwired radio has no events");
assert(d2.widgets[2].kind == "select" and len(d2.widgets[2].props.options) == 3, "select options array");
assert(d2.widgets[2].props.options[1] == "two" and d2.widgets[2].props.selected == 1, "select option values + index");
assert(d2.widgets[3].kind == "slider" and d2.widgets[3].props.value == 42 and d2.widgets[3].props.max == 100, "slider value + range as numbers");

// ── data-binding round-trip (§99): gui.set_model + gui.bind wrapping ───────────────────
let code3 = "fn build() {\n"
    + "    let form = gui.form(\"App\", 480, 320);\n"
    + "    gui.set_model(form, map{ name: \"Ada\", agree: true, vol: 70 });\n"
    + "    gui.add(form, gui.bind(gui.textbox(\"name\", 20, 20, 200, 26, \"\"), \"name\"));\n"
    + "    gui.add(form, gui.bind(gui.checkbox(\"agree\", 20, 60, \"Agree\", false, nil), \"agree\"));\n"
    + "    gui.add(form, gui.bind(gui.slider(\"vol\", 20, 100, 200, 20, 0, 0, 100, nil), \"vol\"));\n"
    + "    gui.add(form, gui.button(\"ok\", 20, 140, 120, 32, \"OK\", nil));\n"
    + "    return form;\n}";
let d3 = G.parse(code3);
assert(d3.model.name == "Ada" and d3.model.agree == true and d3.model.vol == 70, "model parsed with string/bool/number values");
assert(len(d3.widgets) == 4, "four widgets (bind-wrapped + plain)");
assert(d3.widgets[0].kind == "textbox" and d3.widgets[0].bind == "name", "textbox unwrapped from bind() with binding");
assert(d3.widgets[2].kind == "slider" and d3.widgets[2].bind == "vol" and d3.widgets[2].props.max == 100, "slider bind + geometry through bind() wrap");
assert(map_has(d3.widgets[3], "bind") == false, "unbound widget has no bind");

// graceful degradation: no gui calls -> default empty form; parse error -> empty (no crash)
let e = G.parse("fn main() { print 1; }");
assert(len(e.widgets) == 0 and e.form.title == "My App", "no gui calls -> default empty form");
assert(len(G.parse("not valid pblang {{{").widgets) == 0, "parse error -> empty (no crash)");

print "gui_parse_pass";
