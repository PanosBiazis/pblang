// Test: stdlib/hwinfo.sapp -- pblang machine inventory + compute planner.
// Structural / honesty assertions (machine-independent; detectors degrade to notes
// off-Windows, but the survey/plan shape is always present).

let HW = import("stdlib:hwinfo.sapp");

let s = HW.survey();
assert(is_map(s), "survey() returns a map");
assert(map_has(s, "cpu") and map_has(s, "ram") and map_has(s, "disks"), "survey has cpu/ram/disks");
assert(map_has(s, "gpus") and map_has(s, "npu") and map_has(s, "network") and map_has(s, "sound"), "survey has gpus/npu/network/sound");
assert(map_has(s, "devices"), "survey has a device-class section");
assert(is_array(s.compute_usable) and len(s.compute_usable) >= 2, "compute_usable lists CPU and GPU");
assert(is_array(s.detect_only) and len(s.detect_only) >= 4, "detect_only lists non-compute devices");

// CPU honestly reported as fully used
let c = HW.cpu();
assert(str_contains(c.used_by_pblang, "all cores"), "cpu() honest: all cores used");

// NPU honestly detect-only
let n = HW.npu();
assert(str_contains(str(n.used_by_pblang), "no pblang NPU compute backend"), "npu() honest: detection only");

// compute_plan: plans only the compute-capable devices, lists the rest honestly
let p = HW.compute_plan("balanced");
assert(map_has(p, "cpu") and map_has(p, "gpu"), "plan has cpu + gpu sections");
assert(p.cpu.workers >= 1, "plan assigns at least one CPU worker");
assert(is_array(p.not_compute) and len(p.not_compute) >= 5, "plan lists non-compute devices with reasons");
assert(str_contains(p.summary, "CPU") and str_contains(p.summary, "GPU"), "plan summary names the compute devices");

// vendor classification is vendor-agnostic (works for any manufacturer, not just this PC)
assert(HW.vendor("NVIDIA GeForce RTX 4090") == "nvidia", "classifies NVIDIA");
assert(HW.vendor("Intel(R) Arc(TM) A770 Graphics") == "intel", "classifies Intel");
assert(HW.vendor("AMD Radeon 780M Graphics") == "amd", "classifies AMD");
assert(HW.vendor("Apple M3 Max") == "apple", "classifies Apple");
assert(HW.vendor("Qualcomm Snapdragon X Elite") == "qualcomm", "classifies Qualcomm");
assert(HW.vendor("Some Unknown Accelerator") == "other", "unknown vendor -> other");

print "hwinfo_test_pass";
