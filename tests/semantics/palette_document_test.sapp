let P=import("stdlib:palette_document.sapp");let V=import("stdlib:palette_view.sapp");let C=import("stdlib:colors.sapp");let M=import("stdlib:binary_mask.sapp");let UI=import("stdlib:modern_ui.sapp");let G=import("stdlib:gui.sapp");let S=import("stdlib:sheet_document.sapp");let CSV=import("stdlib:sheet_csv.sapp");let Strings=import("stdlib:strings.sapp");
let p=P.create("Παλέτα");p=P.append(p,"Muted","#777");let original=P.encode(p);assert(P.decode(original)==p,"strict roundtrip");assert(p.swatches[1].hex=="#777777","canonical normalization");assert(not P.analyze(p)[1].contrast.aa_normal,"threshold result");
let changed=P.set_swatch(p,0,"Accent","#F00");assert(P.encode(p)==original and changed.swatches[0].hex=="#ff0000","detached edit");assert((try P.set_swatch(p,0,"Bad","#zzzzzz") catch nil)==nil and P.encode(p)==original,"failed edit leaves source");
let dup=Strings.replace_all(original,"\"title\":","\"title\":\"other\",\"title\":");assert((try P.decode(dup) catch nil)==nil,"duplicate fields");let extra=P.copy(p);extra.extra=1;assert((try P.copy(extra) catch nil)==nil,"unknown fields");let noncanonical=P.copy(p);noncanonical.background="#FFF";assert((try P.copy(noncanonical) catch nil)==nil,"canonical persisted format");
for bad in ["",str_repeat("界",27),"a\nb"]{assert((try P.create(bad) catch nil)==nil,"label bounds");}
let full=P.create();for i in range(1,8){full=P.append(full,"Color "+str(i),"#123456");}assert((try P.append(full) catch nil)==nil,"eight colors");assert((try P.remove(P.create(),0) catch nil)==nil,"keep one");assert((try P.remove(full,0.5) catch nil)==nil,"integer index");
let sheet=P.to_sheet(full);assert(S.decode(S.encode(sheet))==sheet and CSV.decode(CSV.encode(sheet))==sheet,"table exports roundtrip");let strip=P.strip(full);assert(len(strip)==16 and len(strip[0])==128,"strip bounds");strip[0][0][0]=100;assert(strip[1][0][0]==0 and strip[0][1][0]==0,"pixels independent");
let form=UI.build("Palette",V.create(p),map{width:412,height:915});G.get(form,"select_1").onclick(form);assert(G.get(form,"detail_4").text=="Color: #777777" and G.get(form,"detail_7").text=="AA normal: false","portable exact result selection");
for target in ["native","web","android"]{assert(len(UI.compile(V.create(full),map{target:target,width:412,height:915}).records)>0,"maximum portable");}
let mask=[[true,false],[false,true]];let pixels=M.rgba_colors(mask,C.hex_checked("#f00"),C.hex_checked("#00f"));assert(pixels[0][0]==[255,0,0,255] and pixels[0][1]==[0,0,255,255],"colored mask mapping");pixels[0][0][0]=0;assert(pixels[1][1][0]==255 and mask[0][0],"colored pixels independent");assert(M.rgba(mask)==M.rgba_colors(mask,C.hex_checked("#fff"),C.hex_checked("#000")),"binary compatibility");assert((try M.rgba_colors(mask,map{r:256,g:0,b:0},C.hex_checked("#000")) catch nil)==nil,"bad channel rejected");print "palette_document_pass";
