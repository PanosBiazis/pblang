// tests/semantics/ffi_universal_enrich2_test.sapp — wave 2 for stdlib/ffi_universal.sapp
// struct_layout (per-field offset/size) + struct_offset lookup.

let FU = import("stdlib/ffi_universal.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let fields = [
    map{ name: "id", type: "int32_t" },     // size 4, offset 0
    map{ name: "value", type: "int64_t" },  // size 8, offset 4
    map{ name: "flag", type: "bool" },      // size 1, offset 12
];

let layout = FU.struct_layout(fields);
eq(len(layout), 3, "three fields");
eq(layout[0].name, "id", "field 0 name");
eq(layout[0].offset, 0, "id offset 0");
eq(layout[0].size, FU.type_size("int32_t"), "id size");
eq(layout[1].offset, FU.type_size("int32_t"), "value offset after id");
eq(layout[2].offset, FU.type_size("int32_t") + FU.type_size("int64_t"), "flag offset after value");

// struct_offset: lookup by name; nil for unknown
eq(FU.struct_offset(fields, "value"), FU.type_size("int32_t"), "offset of value");
eq(FU.struct_offset(fields, "id"), 0, "offset of id");
eq(FU.struct_offset(fields, "nope"), nil, "unknown field -> nil");

// total still matches struct_size
eq(FU.struct_size(fields), FU.type_size("int32_t") + FU.type_size("int64_t") + FU.type_size("bool"),
   "layout total == struct_size");

print "ffi_universal_enrich2_pass";
