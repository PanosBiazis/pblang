// tests/semantics/thread_pool_stdlib_test.sapp — T5-beta: thread pool stdlib test
import "stdlib:thread.sapp";

// Test thread_pool: double each element
let tasks = [1, 2, 3, 4, 5];
let results = thread.thread_pool(2, tasks, fn(x) {
    return x * 2;
});

// Results should contain all doubled values (order may vary)
let sum = 0;
let i = 0;
while i < len(results) {
    sum = sum + results[i];
    i = i + 1;
}

// Sum should be 2+4+6+8+10 = 30
if sum == 30 {
    print "thread_pool_sum: ok";
} else {
    print "thread_pool_sum: FAIL sum=" + sum;
}

// Test with single worker
let tasks2 = [10, 20, 30];
let results2 = thread.thread_pool(1, tasks2, fn(x) { return x + 1; });
let sum2 = results2[0] + results2[1] + results2[2];
// Sum should be 11+21+31 = 63
if sum2 == 63 {
    print "thread_pool_single_worker: ok";
} else {
    print "thread_pool_single_worker: FAIL sum=" + sum2;
}

print "thread_pool_stdlib_pass";
