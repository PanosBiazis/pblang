// Bounded initialization rejects before guest effects and respects ownership.
let V=import("stdlib:compiler/vm.sapp");
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let O=import("stdlib:compiler/optimizer.sapp");
let P=import("stdlib:selfhost_pbck.sapp");
fn compiled(s){let r=F.frontend_compile(s);assert(r.ok,"fixture compile");return r.chunk;}
let setup=compiled("memory_alloc(7);push_lifetime();borrow_immutable(1);memory_alloc(9);");
let guest=compiled("let touched=1;print 42;");
let variants=[guest,O.optimize_safe(guest).chunk,P.deserialize_chunk(P.serialize_chunk(guest))];
let empty=map{constants:[],instructions:[]};
fn prepared(owned){let c=V.execution_context(owned);V.run_seeded(setup,map{},c);return c;}
let limits=[["max_steps",100000000],["max_frames",4096],["max_stack",1048576],["max_locals",1048576],["max_output",1048576],["max_value_items",16777216]];
let cases=[false,true,7,"bad",[],bigint(2),rational(1,2),decimal("1.5")];
for spec in limits {for value in [nil,"bad",0,-1,1.5,spec[1]+1,num_sqrt(-1)] {let options=map{};options[spec[0]]=value;array_push(cases,options);}}
for value in [num_exp(1000),-num_exp(1000),false,[],map{},bigint(2)] {array_push(cases,map{max_steps:value});}
let checks=0;
for options in cases {for code in variants {
 for policy in ["owned","borrowed","protected"] {let ctx=prepared(policy!="borrowed");let state=ctx.memory;let globals=map{};if policy=="protected" {ctx.handlers=1;}
  assert((try {V.run_seeded_bounded(code,globals,options,ctx);false}catch true),"initialization rejects");assert(len(globals)==0,"guest not executed");
  if policy=="owned" {assert(ctx.memory==nil and state.closed and state.reclaimed==2 and len(state.owners)==0 and len(state.borrows)==0,"owned initialization releases two lifetimes");}
  else {assert(ctx.memory==state and not state.closed and len(state.owners)==2 and len(state.borrows)==1,"caller/protected memory retained");}
  ctx.handlers=0;V.close_execution(ctx);V.close_execution(ctx);assert(state.reclaimed==2,"idempotent close");checks=checks+1;
 }
}}
// Protect valid lower/upper bounds without running a guest that exceeds them.
for spec in limits {for value in [1,spec[1]] {let opts=map{};opts[spec[0]]=value;let ctx=prepared(true);let r=V.run_seeded_bounded(empty,map{},opts,ctx);assert(r.runtime[spec[0]]==value and not ctx.memory.closed,"valid bound keeps memory");assert(V.runtime_limits(opts)[spec[0]]==value,"public limits parity");V.close_execution(ctx);}}
for options in [nil,map{},map{unknown:"ignored"}] {for code in variants {let ctx=prepared(true);let r=V.run_seeded_bounded(code,map{},options,ctx);assert(r.output==[42] and r.globals.touched==1 and not ctx.memory.closed,"valid initialization runs guest");V.close_execution(ctx);}}
// Existing NaN diagnostic wins even when cleanup metadata itself is damaged.
for opts in [7,map{max_steps:0},map{max_value_items:num_sqrt(-1)}] {let ctx=prepared(true);let state=ctx.memory;state.reclaimed=map{};assert((try {V.run_seeded_bounded(empty,map{},opts,ctx);false}catch true),"cleanup fault cannot turn rejection into success");state.reclaimed=0;V.close_execution(ctx);assert(state.closed,"fixture cleanup restored");}
let fresh=V.execution_context(true);assert((try {V.run_seeded_bounded(empty,map{},map{max_steps:0},fresh);false}catch true) and fresh.memory==nil,"rejection does not allocate memory");
assert(V.runtime_limits().max_steps==1000000 and V.runtime_limits().max_frames==256,"public defaults unchanged");
// Unbounded entry does not acquire bounded admission policy.
let plain=prepared(true);assert(V.run_seeded(guest,map{},plain).output==[42] and not plain.memory.closed,"unbounded entry unchanged");V.close_execution(plain);
print "selfhost_initialization_cleanup_pass: "+str(checks)+" ownership cases";
