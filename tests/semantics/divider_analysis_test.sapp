let A=import("stdlib:divider_analysis.sapp");let DC=import("stdlib:circuits_dc.sapp");
fn near(a,b) {assert(num_abs(a-b)<0.0000001,"independent nodal-solver agreement");}
for vin in [-12,0,5,12] {for top in [100,1000,10000] {for bottom in [100,2000,50000] {for percent in [0,1,5,20] {
 let r=A.analyze(vin,top,bottom,percent);let lo=1001;let hi= -1001;let ilo=1001;let ihi= -1001;
 for tf in [1-percent/100,1+percent/100] {for bf in [1-percent/100,1+percent/100] {
  let solved=DC.solve(DC.divider(vin,top*tf,bottom*bf));let value=solved.node_volts.output;let current=solved.resistors[0].current_amperes;
  lo=num_min(lo,value);hi=num_max(hi,value);ilo=num_min(ilo,current);ihi=num_max(ihi,current);
 }}
 near(r.nominal_vout,DC.solve(DC.divider(vin,top,bottom)).node_volts.output);near(r.minimum_vout,lo);near(r.maximum_vout,hi);near(r.minimum_current_amperes,ilo);near(r.maximum_current_amperes,ihi);
}}}}
near(A.analyze_units(5000,"mV",1,"kohm",1000,"ohm",5).minimum_vout,2.375);
for args in [[5,1,1000,5],[5,1000000,1000,5],[5,1000,1000,21],[5,1000,1000,-1],[5,1000,1000,nil]] {assert((try A.analyze(args[0],args[1],args[2],args[3]) catch nil)==nil,"tolerance and corner limits");}
assert((try A.analyze_units(5,"m",1,"kohm",1,"kohm") catch nil)==nil,"dimension mismatch");print "divider_analysis_pass";
