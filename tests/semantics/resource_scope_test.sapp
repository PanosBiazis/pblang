let R=import("stdlib:resource_scope.sapp");
fn check(ok,label){if not ok {throw "FAIL resource_scope: "+label;}}
fn success(value){return map{ok:true,value:value};}
let order=[];
let r=R.with_scope(fn(s){
    s.defer(fn(){array_push(order,1);return success(nil);});
    s.defer(fn(){array_push(order,2);return success(nil);});
    return success([7]);
});
check(r.ok and r.value==[7] and order==[2,1] and r.cleanups_attempted==2,"reverse cleanup");
let original=map{code:"body-failure",detail:[3]};
let close_error=map{code:"close-failure"};
order=[];
r=R.with_scope(fn(s){
    s.defer(fn(){array_push(order,1);return success(nil);});
    s.defer(fn(){array_push(order,2);throw "close exception";});
    s.defer(fn(){array_push(order,3);return map{ok:false,error:close_error};});
    return map{ok:false,error:original};
});
check(not r.ok and r.original_error_available and r.error==original,"primary error preserved");
original.detail[0]=8;
check(r.error.detail[0]==8,"error reference retained");
check(order==[3,2,1] and r.cleanups_attempted==3 and len(r.cleanup_errors)==2,"continue after cleanup failures");
check(r.cleanup_errors[0].result.error==close_error and r.cleanup_errors[1].kind=="exception","distinct cleanup failures");
order=[];
r=R.with_scope(fn(s){
    s.defer(fn(){array_push(order,1);return success(nil);});
    let empty=[];
    let invalid=empty[9];
    return success(invalid);
});
check(not r.ok and r.body_status=="exception" and not r.original_error_available and r.error==nil and order==[1],"implicit failure still cleans");
let malformed=[nil,false,true,0,"",[true,nil],[false,nil],[],map{},map{ok:1,value:3},map{ok:true},map{ok:false}];
fn returner(value){return fn(){return value;};}
fn invalid_result_case(value) {
    let r=R.with_scope(fn(s){s.defer(returner(value));return value;});
    check(not r.ok and r.body_status=="invalid_result" and r.cleanup_errors[0].kind=="invalid_result","strict result contract");
}
for value in malformed {invalid_result_case(value);}
let escaped=map{};
order=[];
r=R.with_scope(fn(s){
    escaped=s;
    s.defer(fn(){array_push(order,1);return success(nil);});
    s.defer(fn(){s.defer(fn(){array_push(order,9);return success(nil);});return success(nil);});
    return success(nil);
});
check(not r.ok and order==[1] and r.cleanups_attempted==2,"registration during cleanup rejected");
let rejected=try escaped.defer(fn(){return success(nil);}) catch -1;
check(rejected==-1,"escaped facade cannot reopen closed scope");
r=R.with_scope(fn(s){s.defer(17);return success(false);});
check(not r.ok and r.value==false and r.cleanup_errors[0].kind=="exception","non-callable cleanup fails visibly");
r=R.with_scope(fn(s){return success(nil);});
check(r.ok and r.value==nil and r.cleanups_attempted==0,"nil success");
r=R.with_scope(fn(s){return map{ok:false,error:nil};});
check(not r.ok and r.original_error_available and r.body_status=="returned","nil error is explicit failure");
order=[];
r=R.with_scope(fn(s){
    s.defer(fn(){array_push(order,3);return success(nil);});
    let inner=R.with_scope(fn(t){t.defer(fn(){array_push(order,1);return success(nil);});return success(2);});
    array_push(order,inner.value);
    return success(nil);
});
check(r.ok and order==[1,2,3],"nested scopes isolated");
let envelope=map{ok:false,error:"original"};
r=R.with_scope(fn(s){
    s.defer(fn(){envelope.ok=true;envelope.error="replacement";return success(nil);});
    return envelope;
});
check(not r.ok and r.error=="original" and not r.body_result.ok,"snapshot before cleanup");
let cleanup_envelope=map{ok:false,error:"close-original"};
r=R.with_scope(fn(s){
    s.defer(fn(){cleanup_envelope.error="changed";return success(nil);});
    s.defer(fn(){return cleanup_envelope;});
    return success(nil);
});
check(r.cleanup_errors[0].result.error=="close-original","snapshot each cleanup failure");
// Exception state must reset for each callback and each independent scope.
let mixed_calls=[];
fn mixed_cleanup_case(fail_body) {
    mixed_calls=[];
    let r=R.with_scope(fn(s){
        s.defer(fn(){array_push(mixed_calls,0);return success(nil);});
        s.defer(fn(){array_push(mixed_calls,1);return false;});
        s.defer(fn(){array_push(mixed_calls,2);throw "synthetic cleanup";});
        s.defer(fn(){array_push(mixed_calls,3);return success(false);});
        s.defer(fn(){array_push(mixed_calls,4);throw "synthetic cleanup";});
        if fail_body {throw "synthetic body";}
        return success(nil);
    });
    check(mixed_calls==[4,3,2,1,0] and r.cleanups_attempted==5,"exactly once after alternating failures");
    check(r.cleanup_errors==[map{id:4,kind:"exception",result:nil},map{id:2,kind:"exception",result:nil},map{id:1,kind:"invalid_result",result:nil}],"exception state is callback-local");
    if fail_body {check(r.body_status=="exception" and r.body_result==nil,"body exception classification");}
    else {check(r.body_status=="returned" and r.body_result==success(nil),"body exception state is scope-local");}
}
mixed_cleanup_case(true);mixed_cleanup_case(false);mixed_cleanup_case(true);mixed_cleanup_case(false);
print "resource_scope_pass";
