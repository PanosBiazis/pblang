let Frontend = import("stdlib:compiler/selfhost_frontend.sapp");
let Parser = import("stdlib:compiler/parser.sapp");
let Tokenizer = import("stdlib:compiler/tokenizer.sapp");
let C99 = import("stdlib:compiler/ctranspile.sapp");

fn require(value, message) {
    if not value { throw "FAIL selfhost-if-expr-elif: " + message; }
}

let source = "let n = 2; let value: number = if n == 1 { 10 } elif n == 2 { 20 } elif n == 3 { 30 } else { 40 };";
let parsed = Parser.parse(Tokenizer.tokenize(source));
require(len(parsed.errors) == 0 and len(parsed.stmts) == 2,
    "parser rejected expression-level elif chain");
let root = parsed.stmts[1].value;
require(root.kind == "if_expr" and root.else.kind == "if_expr"
    and root.else.else.kind == "if_expr"
    and root.else.else.else.kind == "block",
    "elif did not lower to a deterministic right-nested if-expression");

let executed = Frontend.frontend_run(source);
require(executed.ok and executed.globals.value == 20,
    "self-hosted VM did not execute selected elif arm");
let first = Frontend.frontend_run(
    "let value = if true { 1 } elif true { 2 } else { 3 };");
require(first.ok and first.globals.value == 1,
    "if-expression did not preserve first-match semantics");
let fallback = Frontend.frontend_run(
    "let value = if false { 1 } elif false { 2 } else { 3 };");
require(fallback.ok and fallback.globals.value == 3,
    "if-expression final else was not selected");
let legacy = Frontend.frontend_run(
    "let value = if false { 1 } else if true { 2 } else { 3 };");
require(legacy.ok and legacy.globals.value == 2,
    "legacy else-if expression compatibility regressed");
let optional = Frontend.frontend_run(
    "let value = if false { 1 } elif false { 2 };");
require(optional.ok and optional.globals.value == nil,
    "existing no-else nil behavior regressed");

let bounded = "let value = if false { 0 }";
let i = 0;
while i < 256 {
    bounded = bounded + " elif false { " + str(i) + " }"; i = i + 1;
}
bounded = bounded + " else { 999 };";
let rejected = Parser.parse(Tokenizer.tokenize(bounded));
require(len(rejected.errors) > 0
    and str_contains(rejected.errors[0], "too many arms"),
    "oversized elif chain did not fail through the parser bound");

let compiled = Frontend.frontend_compile(source);
require(compiled.ok and len(compiled.chunk.instructions) > 0,
    "expression-level elif did not compile to bytecode");
let c = C99.transpile_program(source);
require(str_contains(c, " ? ") and str_contains(c, " : "),
    "C99 lowering did not preserve conditional expression structure");

print "selfhost_if_expr_elif_pass";
