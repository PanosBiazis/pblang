let ABI = import("stdlib:windows_native_abi.sapp");
let PE = import("stdlib:windows_pe.sapp");

fn fail(message) { throw "FAIL windows_native_abi: " + message; }
fn contains_bytes(haystack, needle) {
    let i = 0;
    while i + len(needle) <= len(haystack) {
        let ok = true; let j = 0;
        while j < len(needle) and ok {
            if haystack[i + j] != needle[j] { ok = false; }
            j = j + 1;
        }
        if ok { return true; } i = i + 1;
    }
    return len(needle) == 0;
}

let built = ABI.artifact();
if built.format != "pblang.windows.pe64-dll.v1" or not PE.inspect_dll_x64(built.bytes).ok {
    fail("PE32+ DLL structure");
}
if built.export_count != 12 or len(built.exports) != 12 or built.max_call_arguments != 11
    or built.source_language != "pblang" or not built.no_foreign_source
    or not built.native_memory_bounds_owned_by_caller or len(built.sha256) != 64 {
    fail("artifact contract");
}
for i len(ABI.capabilities().memory_widths) {
    let width = ABI.capabilities().memory_widths[i];
    if width != [1,2,4,8][i] { fail("native memory widths"); }
}
let caps = ABI.capabilities();
if caps.integer_pointer_arguments != 11 or caps.floating_point_arguments != 0
    or not caps.bounded_cstring_copy or not caps.bounded_binary_hex_transfer
    or not caps.host_ffi_gate_required or caps.fixed_dirfs_symbol_count != 16
    or caps.arbitrary_symbol_resolution or caps.arbitrary_function_pointer_calls
    or not caps.package_acl_required or caps.raw_pointer_retention
    or caps.runtime_staging_supported or caps.external_compiler_required
    or not caps.fixed_semantic_input_api
    or caps.temporary_executable_required_for_input {
    fail("capability boundary");
}
let input_rejected = ABI.send_input_records(nil, [], 0);
if input_rejected.ok { fail("invalid semantic input records were accepted"); }
let rejected = ABI.call_dirfs(nil, "LoadLibraryA", []);
if rejected.ok or not str_contains(rejected.error, "outside the fixed ABI contract") {
    fail("arbitrary symbol rejection");
}

// Win64 gate: reserve 0x58 bytes, load the first four register arguments,
// marshal seven stack arguments, indirect-call the exact target, restore RSP.
if not contains_bytes(built.bytes, [0x48,0x83,0xEC,0x58])
    or not contains_bytes(built.bytes, [0x49,0x8B,0x0A,0x49,0x8B,0x52,0x08])
    or not contains_bytes(built.bytes, [0x49,0x8B,0x42,0x50,0x48,0x89,0x44,0x24,0x50])
    or not contains_bytes(built.bytes, [0x41,0xFF,0xD3,0x48,0x83,0xC4,0x58,0xC3]) {
    fail("eleven-argument Win64 lowering");
}

let path = ".pblang-win64-abi-test.dll";
fs_write_bytes(path, built.bytes);
let inspected = try proc_spawn_wait("x86_64-w64-mingw32-objdump", ["-p", path]) catch nil;
try fs_remove(path) catch nil;
if inspected == nil or (try inspected.exit_code catch -1) != 0 { fail("objdump inspection"); }
let output = try inspected.stdout catch "";
for i len(built.exports) {
    if not str_contains(output, built.exports[i]) { fail("missing export " + built.exports[i]); }
}
if not str_contains(output, "DLL Name") and not str_contains(output, "Export Address Table") {
    fail("export directory was not decoded");
}

print "windows_native_abi_pass";
