// tests/semantics/flexbox_test.sapp — flex row/column layout engine.

let F = import("stdlib/flexbox.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let items = [map{ w: 10, h: 5 }, map{ w: 20, h: 5 }];

// ── row, justify start ─────────────────────────────────────────────────────────────
let r = F.row(items, map{ x: 0, y: 0, width: 100, height: 10, gap: 0, justify: "start", align: "start" });
eq(r[0].x, 0, "first at 0"); eq(r[0].w, 10, "first width");
eq(r[1].x, 10, "second after first");

// ── gap ──────────────────────────────────────────────────────────────────────────
let g = F.row(items, map{ width: 100, height: 10, gap: 5 });
eq(g[1].x, 15, "gap pushes second to 15");

// ── justify center / end ──────────────────────────────────────────────────────────
let c = F.row(items, map{ width: 100, height: 10, justify: "center" });   // total 30, leftover 70
eq(c[0].x, 35, "center offset (100-30)/2");
let e = F.row(items, map{ width: 100, height: 10, justify: "end" });
eq(e[0].x, 70, "end offset 100-30");

// ── space-between ──────────────────────────────────────────────────────────────────
let sb = F.row(items, map{ width: 100, height: 10, justify: "space-between" });
eq(sb[0].x, 0, "sb first at 0");
eq(sb[1].x, 80, "sb second at width-its-width");

// ── grow distributes leftover ──────────────────────────────────────────────────────
let gr = F.row([map{ w: 10, h: 5, grow: 1 }, map{ w: 10, h: 5, grow: 1 }], map{ width: 100, height: 10 });
eq(gr[0].w, 50, "grow item 0 = 10 + 40"); eq(gr[1].w, 50, "grow item 1 = 50");
eq(gr[1].x, 50, "second starts after grown first");

// ── align center (cross axis) ──────────────────────────────────────────────────────
let ac = F.row(items, map{ width: 100, height: 10, align: "center" });
eq(ac[0].y, 2, "centered vertically (10-5)/2 floored");

// ── column swaps axes ───────────────────────────────────────────────────────────────
let col = F.column([map{ w: 5, h: 10 }, map{ w: 5, h: 20 }], map{ width: 10, height: 100, gap: 0 });
eq(col[0].y, 0, "col first at top"); eq(col[1].y, 10, "col second below first");

print "flexbox_pass";
