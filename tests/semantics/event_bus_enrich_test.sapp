// tests/semantics/event_bus_enrich_test.sapp — fix + enrichment for stdlib/event_bus.sapp
//
// FIX: a throwing subscriber aborted emit() so later subscribers never ran; emit
//   now isolates per-handler errors. ENRICH: prefix wildcards ("user.*"), emit
//   returns the handler count, events()/has_listeners().

let bus = import("stdlib/event_bus.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

bus.clear(nil);
let hits = map{ n: 0, last: nil };

// ── basic on/emit ────────────────────────────────────────────────────────────────
bus.on("ping", fn(d) { hits.n = hits.n + 1; hits.last = d; });
let c = bus.emit("ping", "hello");
eq(hits.n, 1, "handler invoked"); eq(hits.last, "hello", "handler got data"); eq(c, 1, "emit returns count");

// ── FIX: a throwing subscriber does not stop the others ──────────────────────────
bus.clear(nil);
let ran = map{ a: false, b: false };
bus.on("e", fn(d) { throw "boom"; });
bus.on("e", fn(d) { ran.b = true; });
bus.emit("e", nil);
eq(ran.b, true, "second handler still ran after first threw");

// ── ENRICH: prefix wildcard patterns ─────────────────────────────────────────────
bus.clear(nil);
let wc = map{ n: 0 };
bus.on("user.*", fn(d) { wc.n = wc.n + 1; });
bus.emit("user.created", map{ id: 1 });
bus.emit("user.deleted", map{ id: 2 });
bus.emit("order.placed", map{ id: 3 });
eq(wc.n, 2, "prefix wildcard fires for matching events only");

// ── once fires a single time ─────────────────────────────────────────────────────
bus.clear(nil);
let oc = map{ n: 0 };
bus.once("boot", fn(d) { oc.n = oc.n + 1; });
bus.emit("boot", nil); bus.emit("boot", nil);
eq(oc.n, 1, "once handler fires exactly once");

// ── off removes a handler ────────────────────────────────────────────────────────
bus.clear(nil);
let off_hits = map{ n: 0 };
let h = fn(d) { off_hits.n = off_hits.n + 1; };
bus.on("x", h); bus.off("x", h); bus.emit("x", nil);
eq(off_hits.n, 0, "off removed the handler");

// ── ENRICH: events() + has_listeners() ───────────────────────────────────────────
bus.clear(nil);
bus.on("a", fn(d) {}); bus.on("b", fn(d) {});
eq(len(bus.events()), 2, "events() lists registered events");
eq(bus.has_listeners("a"), true, "has_listeners true"); eq(bus.has_listeners("zzz"), false, "has_listeners false");

print "event_bus_enrich_pass";
