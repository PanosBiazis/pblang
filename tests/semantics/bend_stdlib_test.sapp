let bend = import("stdlib:bend.sapp");

fn assert_true(cond, msg) {
    if not cond { throw msg; }
}

fn main() {
    let seq = bend.range_sum(1, 101);
    let par = bend.range_sum_parallel(1, 101, 3);
    assert_true(seq == 5050, "range_sum should sum 1..100");
    assert_true(par == 5050, "range_sum_parallel should sum 1..100");

    let tree = bend.bend_tree(
        0,
        fn(x) { return x < 3; },
        fn(x) { return x + 1; },
        fn(x) { return x + 1; },
        fn(x) { return 1; },
        8
    );
    assert_true(bend.tree_sum(tree) == 8, "depth 3 binary leaf sum should be 8");
    assert_true(bend.tree_count(tree) == 15, "depth 3 full tree node count should be 15");

    let mapped = bend.parallel_map([1, 2, 3, 4], fn(x) { return x * x; }, 2);
    assert_true(mapped[0] == 1 and mapped[3] == 16, "parallel_map squares");

    let evens = bend.parallel_filter([1, 2, 3, 4, 5, 6], fn(x) { return x % 2 == 0; }, 2);
    assert_true(len(evens) == 3 and evens[0] == 2 and evens[2] == 6, "parallel_filter evens");

    let sorted = bend.divide_sort([5, 1, 4, 2, 3], fn(a, b) { return a < b; }, 2);
    assert_true(sorted[0] == 1 and sorted[4] == 5, "divide_sort order");

    let model = bend.runtime_model();
    assert_true(model.pblang_layer != "", "runtime model should describe pblang layer");

    print "bend_stdlib_pass";
}

main();
