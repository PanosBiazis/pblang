let R=import("stdlib:research_observations.sapp");
let spec=map{value_unit:"cm",summary_unit:"m",value_mode:"absolute",time_unit:"day",timebase:"relative"};
let rows=[map{subject:1,time:0,value:10},map{subject:2,time:0,value:20},
    map{subject:1,time:1,value:nil},map{subject:2,time:1,value:30}];
let before=json_stringify([spec,rows]);let result=R.summarize(spec,rows);
assert(result.row_count==4 and result.observed_count==3 and result.missing_count==1 and result.subject_count==2,"counts");
assert(num_abs(result.mean-0.2)<0.000000000001 and result.minimum==0.1 and result.maximum==0.3,"converted statistics");
assert(result.missing_fraction==0.25 and result.time_span_seconds==86400,"explicit time and missingness");
assert(result.method.weighting=="per-observed-row" and not result.contains_rows and not result.contains_subject_ids,"summary policy");
for flag in ["subject_identity_verified","missingness_mechanism_inferred","independence_verified","scientific_validity_verified","acquisition_performed","safe_to_log"] {assert(not result[flag],"no inferred authority");}
assert(not result.method.data_fingerprint_included and not result.method.runtime_pin_verified and not result.method.reproducibility_verified,"manifest describes method, not attestation");
result.method.summary_unit="changed";assert(json_stringify([spec,rows])==before and R.manifest(spec).summary_unit=="m","detached output and unchanged inputs");
let empty=R.summarize(spec,[]);assert(empty.row_count==0 and empty.mean==nil and empty.missing_fraction==nil and empty.time_span_seconds==nil,"empty is explicit");
let absent=R.summarize(spec,[map{subject:64,time:0,value:nil}]);
assert(absent.observed_count==0 and absent.minimum==nil and absent.maximum==nil and absent.mean==nil and absent.missing_fraction==1,"all missing has no imputed statistics");
let temperature=map{value_unit:"degF",summary_unit:"degC",value_mode:"absolute",time_unit:"ms",timebase:"relative"};
let warm=R.summarize(temperature,[map{subject:1,time:1000,value:32},map{subject:1,time:2000,value:212}]);
assert(num_abs(warm.mean-50)<0.000000000001 and warm.time_span_seconds==1,"affine absolute conversion");
temperature.value_mode="difference";
assert(R.summarize(temperature,[map{subject:1,time:0,value:18}]).mean==10,"temperature difference conversion");
fn rejected(configuration,observations) {
    assert((try R.summarize(configuration,observations) catch nil)==nil,"invalid dataset rejected entirely");
}
for bad in [nil,true,[],map{},map{value_unit:"cm",summary_unit:"m",value_mode:"absolute",time_unit:"day",timebase:"relative",name:"synthetic-private-name"}] {rejected(bad,[]);}
for field in ["value_unit","summary_unit","value_mode","time_unit","timebase"] {
    let broken=json_parse(json_stringify(spec));broken[field]="invalid";rejected(broken,[]);
}
let incompatible=json_parse(json_stringify(spec));incompatible.summary_unit="s";rejected(incompatible,[]);
let not_time=json_parse(json_stringify(spec));not_time.time_unit="m";rejected(not_time,[]);
for value in [nil,true,[],map{},"private-value",parse_number("NaN"),parse_number("inf"),parse_number("-inf")] {
    if value!=nil {rejected(spec,[map{subject:1,time:0,value:value}]);}
    rejected(spec,[map{subject:value,time:0,value:1}]);rejected(spec,[map{subject:1,time:value,value:1}]);
}
for subject in [0,65,1.5] {rejected(spec,[map{subject:subject,time:0,value:1}]);}
for row in [map{subject:1,time:0},map{subject:1,time:0,value:1,name:"private-name"},map{subject:1,time:-1,value:1},map{subject:1,time:1000000001,value:1},map{subject:1,time:0,value:1000000001}] {rejected(spec,[row]);}
rejected(spec,[map{subject:1,time:0,value:1},map{subject:1,time:0,value:nil}]);
rejected(spec,[map{subject:1,time:1,value:1},map{subject:1,time:0,value:2}]);
let overflow=json_parse(json_stringify(spec));overflow.value_unit="km";overflow.summary_unit="mm";rejected(overflow,[map{subject:1,time:0,value:1000000000}]);
let absolute=json_parse(json_stringify(temperature));absolute.value_mode="absolute";rejected(absolute,[map{subject:1,time:0,value:-500}]);
let second_spec=map{value_unit:"m",summary_unit:"m",value_mode:"absolute",time_unit:"s",timebase:"relative"};
let zero=R.summarize(second_spec,[map{subject:1,time:0,value:0},map{subject:1,time:1,value:0},map{subject:2,time:0,value:6}]);
assert(zero.observed_count==3 and zero.mean==2,"zero is observed and weighting is per row");
assert(R.summarize(second_spec,[map{subject:1,time:1000000000,value:-1000000000}]).mean==-1000000000,"numeric boundaries");
rejected(spec,[map{subject:1,time:1000000000,value:1}]);
for bad_rows in [nil,true,map{},"rows",1] {rejected(spec,bad_rows);}
let many=[];for i in range(0,256) {array_push(many,map{subject:1,time:i,value:1});}
assert(R.summarize(spec,many).row_count==256,"inclusive row bound");array_push(many,map{subject:1,time:256,value:1});rejected(spec,many);
assert(json_stringify(R.summarize(spec,rows))==json_stringify(R.summarize(json_parse(json_stringify(spec)),json_parse(json_stringify(rows)))),"repeatable same input");
print "research_observations_pass";
