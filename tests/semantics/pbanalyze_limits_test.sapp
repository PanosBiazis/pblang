let OS=import("stdlib:os.sapp");
if platform()!="linux" {print "pbanalyze_limits_skip_linux_required";os_exit(0);}
let compiler=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let fixture=path_join(OS.temp_dir(),"pblang_limit_"+str_slice(sha256(str(now_ms())+str(random_bytes(8))),0,16)+".sapp");
let failure="unexpected exception";
fn expect(ok,label) {if not ok {failure=label;throw label;}}
fn invoke(path,flags) {
    let args=["-k","1s","8s",compiler,"tools/pbanalyze.sapp","--allow-all","--",path,"--entry-only"];
    for flag in flags {push(args,flag);}
    return proc_spawn_wait("/usr/bin/timeout",args);
}
fn exercise() {
    let rejection=json_stringify(map{ok:false,error:"max_findings must be a finite integer in 1..1024"});
    for value in ["private-limit-marker","","NaN","inf","-inf","1.5","0","1025"] {
        let result=invoke(fixture+".missing",["--max-findings="+value,"--config="+fixture+".missing-config"]);
        expect(result.exit_code==2 and str_trim(result.stdout)==rejection,"invalid limit wins over absent source/config");
        expect(str_trim(result.stderr)=="","no internal exception or private value in stderr");
    }
    fs_write(fixture,"let strategy=\"slow path\";\nlet other=\"slow path\";\n");
    for value in ["1","1.0","1024"] {
        let result=invoke(fixture,["--analysis=performance","--max-findings="+value,"--fail-on-findings"]);
        expect(result.exit_code==1,"valid numeric limit reaches analysis");
        let report=json_parse(str_trim(result.stdout));
        expect(report.ok and not report.passed and report.finding_count==if value=="1024" {2} else {1},"exact CLI cap");
    }
    let defaults=invoke(fixture,["--analysis=performance"]);
    expect(defaults.exit_code==0 and json_parse(str_trim(defaults.stdout)).finding_count==2,"omitted limit defaults");
    let duplicate=invoke(fixture,["--analysis=performance","--max-findings=invalid","--max-findings=1"]);
    expect(duplicate.exit_code==0 and json_parse(str_trim(duplicate.stdout)).finding_count==1,"last option still wins");
    fs_write(fixture,"danger_accept_invalid_certs();\n");
    let blocking=invoke(fixture,["--max-findings=1"]);
    let report=json_parse(str_trim(blocking.stdout));
    expect(blocking.exit_code==1 and report.ok and not report.passed and report.finding_count==1,"small cap retains security failure");
    return true;
}
let succeeded=try exercise() catch false;
if fs_exists(fixture) {fs_remove(fixture);}
if not succeeded {throw "FAIL pbanalyze-limits: "+failure;}
print "pbanalyze_limits_pass";
