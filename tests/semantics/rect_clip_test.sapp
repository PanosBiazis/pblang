let Clip=import("stdlib:rect_clip.sapp");
let GUI=import("stdlib:gui.sapp");
fn rejects(callback) { let bad=false; try { callback(); } catch { bad=true; } return bad; }
let calls=[];
let win=map{rect:fn(x,y,w,h,c){push(calls,["rect",x,y,w,h]);},
    line:fn(x1,y1,x2,y2,c){push(calls,["line",x1,y1,x2,y2]);}};
let region=map{x:10,y:20,w:30,h:40};
let canvas=Clip.canvas(win,region);
region.x=500;
canvas.rect(0,0,100,100,0);
assert(calls[0]==["rect",10,20,30,40],"clip copied and oversized fill intersected");
canvas.line(100,30,0,30,0);
assert(calls[1]==["line",10,30,39,30],"reversed horizontal line uses inclusive pixel endpoints");
canvas.line(20,100,20,0,0);
assert(calls[2]==["line",20,20,20,59],"vertical line bounded");
canvas.point(10,20,0); canvas.point(40,20,0);
assert(len(calls)==4,"right edge excluded");
canvas.rect(0,0,1,1,0); canvas.line(0,19,100,19,0);
assert(len(calls)==4,"outside primitives discarded");
canvas.rect(10.5,20.5,2,2,0);
assert(calls[4]==["rect",11,21,1,1],"fractional fill conservatively rounds inward");
let empty=Clip.canvas(win,map{x:0,y:0,w:0,h:0});
empty.clear(0); empty.line(0,0,100,0,0); empty.point(0,0,0);
assert(len(calls)==5,"empty region emits nothing");
for bad in [nil,map{},map{x:0,y:0,w:-1,h:1},map{x:0.1,y:0,w:1,h:1},
    map{x:0,y:0,w:1,h:1,extra:1},map{x:0,y:0,w:1000001,h:1}] {
    assert(rejects(fn(){Clip.canvas(win,bad);}),"malformed region rejected");
}
canvas.line(0,0,100,100,0);
assert(calls[5]==["line",20,20,39,39],"diagonal clipped to included pixel centers");
canvas.circle(10,20,5,0);
assert(len(calls)>6 and len(calls)<=22,"partial circle emits bounded clipped segments");
assert(rejects(fn(){canvas.rect(nil,0,1,1,0);}),"invalid primitive rejected");
let form=GUI.form("Clipped pointer",320,240);
GUI.add(form,GUI.button("toolbar",0,0,100,30,"Toolbar",nil));
let preview=GUI.button("preview",0,0,200,200,"Preview",nil);
preview.clip_rect=map{x:0,y:40,w:100,h:100}; GUI.add(form,preview);
assert(GUI.hit_test(form,10,10).name=="toolbar","clipped content cannot occlude toolbar pointer");
assert(GUI.hit_test(form,10,50).name=="preview","visible intersection retains hit testing");
assert(GUI.hit_test(form,100,50)==nil,"half-open clip edge excluded");
assert(GUI.hit_test(form,2147483647,2147483647)==nil,"far native pointer is a miss, not an exception");
preview.clip_rect=map{x:250,y:210,w:20,h:20};
form.focus="toolbar";
assert(GUI.focus_next(form)=="toolbar","fully clipped controls skipped by keyboard traversal");
form.focus="preview";
let activated=map{count:0}; preview.onclick=fn(f){activated.count=activated.count+1;};
GUI.handle_event(form,map{type:"keydown",key:"Enter"});
assert(activated.count==0,"stale focus cannot activate a fully clipped control");
print "rect_clip_pass";
