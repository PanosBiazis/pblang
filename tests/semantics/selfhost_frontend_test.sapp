let sh = import("stdlib:compiler/selfhost_frontend.sapp");

let r = sh.frontend_analyze("let x = 1; print x;");
if r.ok != true { print "selfhost_frontend_fail_ok"; }
if r.stmt_count < 1 { print "selfhost_frontend_fail_stmt_count"; }
if r.tokens_count < 2 { print "selfhost_frontend_fail_tokens_count"; }
if len(r.tokens) < 2 { print "selfhost_frontend_fail_tokens_array"; }

let bad = sh.frontend_analyze("let x = ;");
if bad.ok == true { print "selfhost_frontend_fail_expected_error"; }
if len(bad.errors) == 0 { print "selfhost_frontend_fail_missing_errors"; }

print "selfhost_frontend_pass";
