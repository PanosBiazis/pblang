let sh = import("stdlib:compiler/selfhost_frontend.sapp");

let r = sh.frontend_analyze("let x = 1; print x;");
if r.ok != true { print "selfhost_frontend_fail_ok"; }
if r.stmt_count < 1 { print "selfhost_frontend_fail_stmt_count"; }
if r.tokens_count < 2 { print "selfhost_frontend_fail_tokens_count"; }
if len(r.tokens) < 2 { print "selfhost_frontend_fail_tokens_array"; }

let bad = sh.frontend_analyze("let x = ;");
if bad.ok == true { print "selfhost_frontend_fail_expected_error"; }
if len(bad.errors) == 0 { print "selfhost_frontend_fail_missing_errors"; }

// frontend_run captures printed output (drives the native IDE's F5 "run"). The
// self-hosted parser must accept the `print EXPR;` keyword form (real pblang's
// print is a statement, not a function), and the self-hosted VM must record each
// printed value into `output`. Regression guard for both fixes.
let kw = sh.frontend_run("print 7;");                       // keyword + space form
assert(kw.ok, "frontend_run keyword-print compiles");
assert(len(kw.output) == 1 and kw.output[0] == 7, "print 7; captured as output [7]");

let fn_out = sh.frontend_run("fn add(a, b) { return a + b; }\nprint add(2, 3);");
assert(len(fn_out.output) == 1 and fn_out.output[0] == 5, "print add(2,3); captured as [5]");

let multi = sh.frontend_run("print 1;\nprint \"hi\";\nprint 2;");
assert(len(multi.output) == 3, "three prints captured in order");
assert(multi.output[0] == 1 and multi.output[1] == "hi" and multi.output[2] == 2, "print order + types preserved");

let paren = sh.frontend_run("print(9);");                   // paren/call form still works
assert(len(paren.output) == 1 and paren.output[0] == 9, "print(9) call-form captured as [9]");

print "selfhost_frontend_pass";
