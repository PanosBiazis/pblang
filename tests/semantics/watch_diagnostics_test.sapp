// tests/semantics/watch_diagnostics_test.sapp — watchers expose the smart diagnostics
// engine (delegation, fail-safe). Confirms watch.diagnose/suggest/autofix wiring.

let W = import("stdlib/watch.sapp");

fn fail(m) { throw "FAIL " + m; }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : <<" + s + ">>"); } }

// ── watch.diagnose surfaces undefined-name with a suggestion ──────────────────────
let r = W.diagnose("let value = 1;\nprint valeu;");
if r.ok { fail("undefined name -> not ok"); }
let found = false;
let i = 0;
while i < len(r.diagnostics) {
    let d = r.diagnostics[i];
    if d.code == "undefined-name" and (try d.suggestion catch nil) == "value" { found = true; }
    i = i + 1;
}
if not found { fail("watch.diagnose should surface did-you-mean value"); }

// ── watch.suggest ──────────────────────────────────────────────────────────────────
let s = W.suggest("let value = 1;\nprint valeu;");
if len(s) < 1 { fail("watch.suggest should return a suggestion"); }

// ── watch.autofix ──────────────────────────────────────────────────────────────────
let fx = W.autofix("let value = 1;\nprint valeu;");
has(fx.fixed, "print value", "watch.autofix renames");

// ── watch.format_diagnostics renders text ─────────────────────────────────────────
let txt = W.format_diagnostics(r);
has(txt, "undefined-name", "format includes the code");

print "watch_diagnostics_pass";
