let C99 = import("stdlib/compiler/ctranspile.sapp");

fn fail(message) { throw "FAIL ctranspile-modulo: " + message; }
let int_c = C99.transpile_program_int("fn rem(a, b) { return a % b; } print rem(17, 5);");
if not str_contains(int_c, "pb_mod_checked(a, b)") { fail("dynamic integer modulo is not checked"); }
let const_c = C99.transpile_program_int("print 17 % 5;");
if not str_contains(const_c, "(17 % 5)") or str_contains(const_c, "pb_mod_checked(17") { fail("constant modulo lost direct lowering"); }
let float_c = C99.transpile_program("fn rem(a, b) { return a % b; } print rem(17, 5);");
if not str_contains(float_c, "pb_mod_checked((long)a, (long)b)") { fail("dynamic float-profile modulo is not checked"); }

let rejected = false;
try C99.transpile_program_int("print 1 % 0;") catch { rejected = true; }
if not rejected { fail("literal zero divisor was accepted"); }

let cc = C99.find_c_compiler();
if cc != nil {
    let ok = C99.run_program("let a = 17; let b = 5; print a % b;", map{ numeric: "integer", compiler: cc, timeout_ms: 5000 });
    if not ok.ok or ok.stdout != "2\n" { fail("checked modulo executable mismatch"); }
    let bad = C99.run_program("let a = 17; let b = 0; print a % b;", map{ numeric: "integer", compiler: cc, timeout_ms: 5000 });
    if bad.ok or bad.exit_code != 73 { fail("dynamic zero divisor did not fail closed"); }
}
print "ctranspile_modulo_pass";
