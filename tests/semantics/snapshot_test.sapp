// Test: snapshot.sapp — golden-file snapshot testing for the pblang QA stack.
//
// Snapshots serialize any value canonically (sorted map keys, JSON-escaped
// strings) and compare against a golden file on disk. First run creates the
// golden; later runs must match byte-for-byte or fail with a line diff.
// Update mode rewrites goldens in place. Names are sanitized so a snapshot
// name can never escape the snapshot directory.

let S = import("stdlib:snapshot.sapp");
let FS = import("stdlib:fs.sapp");

fn eq(a, b, msg) {
    if a != b { return error("FAIL " + msg + ": got " + str(a) + ", want " + str(b)); }
}

// ── scratch dir (target/ is gitignored); wipe leftovers from prior runs ─────
let DIR = "target/_snaptest";
try FS.mkdirs(DIR) catch nil;
let leftovers = FS.listdir(DIR);
let li = 0;
while li < len(leftovers) {
    try FS.remove(DIR + "/" + leftovers[li]) catch nil;
    li = li + 1;
}

// ── canonical serialization is deterministic and key-order independent ──────
let a1 = map{}; a1["zeta"] = 1; a1["alpha"] = [1, 2, map{ b: true, a: nil }];
let a2 = map{}; a2["alpha"] = [1, 2, map{ a: nil, b: true }]; a2["zeta"] = 1;
eq(S.serialize(a1), S.serialize(a2), "serialization ignores insertion order");
eq(S.serialize("l1\nl2"), "\"l1\\nl2\"", "strings JSON-escaped");
eq(S.serialize(nil), "null", "nil is null");

// ── first snap creates the golden, second matches it ────────────────────────
let st = S.new(DIR);
let r1 = S.snap(st, "user profile", map{ name: "ada", tags: ["x", "y"], age: 36 });
eq(r1["ok"], true, "first snap ok");
eq(r1["created"], true, "first snap created golden");
eq(FS.exists(r1["path"]), true, "golden file written");

let r2 = S.snap(st, "user profile", map{ age: 36, tags: ["x", "y"], name: "ada" });
eq(r2["ok"], true, "same value (different key order) matches");
eq(r2["created"], false, "no rewrite on match");

// ── mismatch fails with a line diff, golden untouched ────────────────────────
let r3 = S.snap(st, "user profile", map{ name: "ada", tags: ["x", "z"], age: 36 });
eq(r3["ok"], false, "changed value mismatches");
eq(len(r3["diff"]) > 0, true, "diff is non-empty");
eq(str_contains(r3["diff"], "\"z\""), true, "diff shows the new value");
let golden_after = FS.read(r3["path"]);
eq(str_contains(golden_after, "\"y\""), true, "golden not overwritten on mismatch");

// ── update mode rewrites the golden ──────────────────────────────────────────
S.set_update(st, true);
let r4 = S.snap(st, "user profile", map{ name: "ada", tags: ["x", "z"], age: 36 });
eq(r4["ok"], true, "update mode accepts new value");
eq(r4["updated"], true, "update flag reported");
S.set_update(st, false);
let r5 = S.snap(st, "user profile", map{ name: "ada", tags: ["x", "z"], age: 36 });
eq(r5["ok"], true, "new golden now matches");

// ── name sanitization: traversal-looking names stay inside DIR ──────────────
let r6 = S.snap(st, "../../evil/../name", "safe");
eq(r6["ok"], true, "hostile name snaps fine");
eq(str_contains(r6["path"], ".."), false, "no dot-dot in stored path");
eq(str_starts_with(r6["path"], DIR + "/"), true, "path stays inside snapshot dir");
eq(FS.exists(r6["path"]), true, "sanitized golden exists");

// ── multiline string round-trip ──────────────────────────────────────────────
let text = "line one\nline two\n\ttabbed \"quoted\"";
let r7 = S.snap(st, "multiline", text);
eq(r7["created"], true, "multiline created");
let r8 = S.snap(st, "multiline", text);
eq(r8["ok"], true, "multiline matches byte-for-byte");
let r9 = S.snap(st, "multiline", text + "!");
eq(r9["ok"], false, "changed multiline mismatches");

// ── assert_snap throws on mismatch, passes on match ──────────────────────────
let t1 = try map{ ok: true, v: S.assert_snap(st, "multiline", text) } catch map{ ok: false };
eq(t1["ok"], true, "assert_snap passes on match");
let t2 = try map{ ok: true, v: S.assert_snap(st, "multiline", "different") } catch map{ ok: false };
eq(t2["ok"], false, "assert_snap throws on mismatch");

// ── obsolete detection + prune (prune only in update mode) ───────────────────
FS.write(DIR + "/stale_orphan.snap", "\"old\"\n");
let orphans = S.obsolete(st);
eq(len(orphans), 1, "one obsolete snapshot found");
eq(orphans[0], "stale_orphan.snap", "orphan named");
let pr_noop = S.prune(st);
eq(pr_noop, 0, "prune is a no-op outside update mode");
eq(FS.exists(DIR + "/stale_orphan.snap"), true, "orphan kept outside update mode");
S.set_update(st, true);
let pr = S.prune(st);
eq(pr, 1, "prune removed one orphan in update mode");
eq(FS.exists(DIR + "/stale_orphan.snap"), false, "orphan deleted");
S.set_update(st, false);

// ── summary counts ────────────────────────────────────────────────────────────
let sm = S.summary(st);
eq(sm["created"] >= 3, true, "created counted");
eq(sm["matched"] >= 3, true, "matched counted");
eq(sm["mismatched"] >= 2, true, "mismatched counted");
eq(sm["updated"], 1, "updated counted");

// ── unserializable values are rejected, not silently stored ─────────────────
let bad = try map{ ok: true, v: S.snap(st, "badfn", fn(x) { return x; }) } catch map{ ok: false };
eq(bad["ok"], false, "functions are not snapshotable");

print "snapshot_pass";
