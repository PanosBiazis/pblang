let F=import("stdlib:compiler/selfhost_frontend.sapp");
let source="let O=import(\"stdlib:orm.sapp\"); let sql=\"\"; let params=[]; let calls=0; let c=map{exec:fn(s,p){sql=s;params=p;},last_insert_rowid:fn(){return 7;},query:fn(s,p){calls=calls+1;return [];}}; let data=map{}; for i 17 {data[\"f\"+str(i)]=i;} print O.insert(c,\"t\",data); print len(params); print len(map_keys(data)); print str_contains(sql,\"?, ?, ?\"); print O.upsert(c,\"t\",data); print (try O.find(c,\"t\",map{order:\"id ASC --\"}) catch \"rejected\"); print calls; O.find(c,\"t\",map{order:\"id DESC\"}); print calls;";
let result=F.frontend_run(source);
