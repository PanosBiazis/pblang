let VM=import("stdlib:compiler/vm.sapp");
let F=import("stdlib:compiler/selfhost_frontend.sapp");
fn compiled(source) {
    let r=F.frontend_compile(source);
    assert(r.ok,"fixture compiles");
    return r.chunk;
}
fn prepared(automatic) {
    let ctx=VM.execution_context(automatic);
    VM.run_seeded(compiled("let h=memory_alloc(7); push_lifetime(); borrow_immutable(h); memory_alloc(9);"),map{},ctx);
    return ctx;
}
for bounded in [false,true] {
    for value in [nil,false,0,"original-guest-error",[1,2],map{kind:"original"}] {
        let ctx=prepared(true); let memory=ctx.memory;
        let chunk=map{instructions:[map{op:0,operand:0},map{op:40,operand:nil}],constants:[value]};
        let caught=false;
        if bounded {try VM.run_seeded_bounded(chunk,map{},nil,ctx) catch {caught=true;};}
        else {try VM.run_seeded(chunk,map{},ctx) catch {caught=true;};}
        assert(caught and ctx.memory==nil,"escaping throw closes opted-in context");
        assert(memory.closed and len(memory.owners)==0 and len(memory.borrows)==0,"owners and borrows released");
        assert(memory.reclaimed==2 and ctx.handlers==0,"all scopes reclaimed once");
        VM.close_execution(ctx);
        assert(memory.reclaimed==2,"closing is idempotent");
    }
}
let borrowed=prepared(false);let retained=borrowed.memory;
assert((try {VM.run_seeded(compiled("throw \"borrowed\";"),map{},borrowed);false} catch true),"borrowed throw propagates");
assert(not retained.closed and len(retained.owners)==2,"borrowed state remains caller-owned");
VM.close_execution(borrowed);

for source in [
 "let h=memory_alloc(11); print try {throw \"inner\";} catch memory_get(h);",
 "let h=memory_alloc(11); print try {try {throw \"first\";} catch {throw \"second\";}} catch memory_get(h);",
 "let h=memory_alloc(11); fn f(){throw \"nested-call\";} print try f() catch memory_get(h);",
 "let h=memory_alloc(11); print try error(\"caught-error\") catch memory_get(h);",
 "let h=memory_alloc(11); print try 4 catch 0; print memory_get(h);",
 "let h=memory_alloc(11); print try nil catch 0; print memory_get(h);"
] {
    let ctx=VM.execution_context(true);
    let result=VM.run_seeded(compiled(source),map{},ctx);
    assert(result.output[len(result.output)-1]==11,"caught throw retains usable memory");
    assert(ctx.handlers==0 and not ctx.memory.closed,"handler count restored");
    VM.close_execution(ctx);
}
for source in [
 "error(\"builtin-original\");",
 "let fail=error; fail(\"aliased-original\");",
 "fn f(){throw \"nested\";} f();",
 "try {throw \"first\";} catch {throw \"second\";}",
 "try 1 catch 2; throw \"after-success\";",
 "try {throw \"first\";} catch 2; throw \"after-catch\";"
] {
    let ctx=prepared(true);let memory=ctx.memory;
    assert((try {VM.run_seeded(compiled(source),map{},ctx);false} catch true),"escaping error");
    assert(ctx.memory==nil and memory.closed and ctx.handlers==0,"nested escape closes entire context");
}
// A caught implicit host failure also removes its handler before a later throw.
let host_body=map{instructions:[map{op:0,operand:0},map{op:18,operand:0}],constants:[1]};
let host_catch=map{instructions:[map{op:0,operand:0},map{op:19,operand:nil}],constants:[7]};
let host_chunk=map{instructions:[map{op:35,operand:0},map{op:0,operand:1},map{op:40,operand:nil}],
    constants:[map{try_chunk:host_body,catch_chunk:host_catch},"after-host-catch"]};
let host_ctx=prepared(true);let host_memory=host_ctx.memory;
assert((try {VM.run_seeded(host_chunk,map{},host_ctx);false} catch true),"host catch followed by guest throw");
assert(host_memory.closed and host_ctx.handlers==0,"implicit handler does not mask later cleanup");
// Entry points retain failure behavior and fresh runs stay usable.
for bounded in [false,true] {
    let source="memory_alloc(1); throw \"frontend-original\";";
    let failed=false;
    if bounded {try F.frontend_run_bounded(source) catch {failed=true;};}
    else {try F.frontend_run(source) catch {failed=true;};}
    assert(failed,"frontend error propagated");
}
assert(F.frontend_run("print memory_stats().total_locations;").output==[0],"next execution is independent");
print "selfhost_throw_cleanup_pass";
