let Dispatch = import("stdlib:host_pbck_frame_dispatch.sapp");
let Plan = import("stdlib:host_pbck_frame_plan.sapp");

fn fail(message) { throw "FAIL host_pbck_frame_dispatch: " + message; }

let expected_names = [
    "constant", "add", "sub", "mul", "div", "eq", "not_eq", "gt", "ge", "lt", "le",
    "pop", "print", "define_global", "get_global", "set_global", "get_attr", "set_attr",
    "export", "make_array", "make_map", "get_index", "set_index", "try", "end_try",
    "get_local", "set_local", "closure", "get_upvalue", "set_upvalue", "close_upvalue",
    "call", "tail_call", "return", "defer", "jump", "jump_if_false", "jump_if_true",
    "not", "negate", "mod", "pow", "safe_get_attr", "safe_index", "result_unwrap",
    "is_nil", "dup", "throw"
];
if Dispatch.OPCODE_COUNT != 48 or len(expected_names) != Dispatch.OPCODE_COUNT {
    fail("canonical opcode count mismatch");
}
let op = 0;
while op < Dispatch.OPCODE_COUNT {
    let item = Dispatch.contract(op);
    if item.opcode != op or item.name != expected_names[op]
        or item.family != Dispatch.family(op)
        or item.operand_kind != Dispatch.operand_kind(op)
        or item.family_name != Dispatch.FAMILY_NAMES[item.family]
        or item.operand_kind_name != Dispatch.OPERAND_KIND_NAMES[item.operand_kind] {
        fail("opcode contract mismatch at " + str(op));
    }
    op = op + 1;
}
if not (try { Dispatch.contract(-1); false } catch true)
    or not (try { Dispatch.contract(48); false } catch true)
    or not (try { Dispatch.contract(1.5); false } catch true) {
    fail("invalid opcode did not fail closed");
}

let decoded = map{
    format: "host-pbck-v1", version: 1,
    chunk: map{
        instructions: [
            map{ op: 0, operand: 0 }, map{ op: 0, operand: 1 }, map{ op: 1 },
            map{ op: 46 }, map{ op: 36, operand: 6 }, map{ op: 11 }, map{ op: 33 }
        ], constants: [20, 22], source_name: nil
    }
};
let plan = Plan.build_decoded(decoded);
let report = Dispatch.scan(plan);
if not report.ok or report.format != Dispatch.FORMAT or report.functions != 1
    or report.instructions != 7 or report.dispatcher_coverage != 48
    or report.used_opcodes != 6 or report.opcode_counts[0] != 2
    or report.opcode_counts[1] != 1 or report.opcode_counts[36] != 1
    or report.operand_kind_counts[1] != 2
    or report.operand_kind_counts[3] != 1 or report.checksum != 9478759 {
    fail("deterministic structural scan mismatch: " + str(report));
}

let broken = Plan.build_decoded(decoded);
broken.opcodes[0] = 48;
if not (try { Dispatch.scan(broken); false } catch true) {
    fail("invalid frame plan did not fail closed");
}
