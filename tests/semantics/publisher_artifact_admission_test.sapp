let ADMISSION = import("stdlib:publisher_artifact_admission.sapp");
let RELEASE = import("stdlib:product_release_evidence.sapp");
let TRUST = import("stdlib:publisher_trust_store.sapp");
let SECURE = import("stdlib:secure_file.sapp");
let SHA256 = import("stdlib:sha256_pb.sapp");

let A = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
let B = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
let C = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc";
let D = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd";
let COMMIT = "0123456789abcdef0123456789abcdef01234567";
let KEY_HEX = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a";
let KEY_ID = "21fe31dfa154a261626bf854046fd2271b7bed4b6abe45aa58877ef47f9721b9";
let ARTIFACT_DIGEST = "87c04077a5bbf4abf090f9122a5d170d411c453b98e9eb672a1b96452aa15c87";
let LARGE_ARTIFACT_DIGEST = "64ff101c28da93e4f4b742b6498810adf9cebf8fca6547bb9004336037993e7c";
let HEX = "0123456789abcdef";

fn require(condition, message) { if not condition { throw message; } }

fn nibble(ch) {
    let index = 0;
    while index < len(HEX) {
        if str_slice(HEX, index, index + 1) == str_lower(ch) { return index; }
        index = index + 1;
    }
    throw "invalid test hex";
}

fn bytes(text) {
    let out = []; let index = 0;
    while index < len(text) {
        array_push(out, nibble(str_slice(text, index, index + 1)) * 16
            + nibble(str_slice(text, index + 1, index + 2)));
        index = index + 2;
    }
    return out;
}

fn source() {
    return RELEASE.source("demo", "1.2.3", "stable", "0.6.0-alpha",
        A, B, C, COMMIT, map{clean_tree:true, reproducible_inputs:true});
}

fn artifact(source_row, digest = nil) {
    if digest == nil { digest = ARTIFACT_DIGEST; }
    return RELEASE.artifact(source_row, "demo.pbck", digest, 26, A,
        "1.2.3", "stable", ["linux:x86_64", "linux:aarch64"], map{
            signed_artifact:true, signature_sha256:C, sbom_sha256:D,
            attestation_sha256:A, install_verified:false,
            upgrade_verified:false, rollback_verified:false,
            uninstall_verified:false});
}

fn signature() {
    // RFC 8032 test seed, used only to produce this deterministic v2 fixture.
    return bytes("e96b924de1e42cc0d2c22d8c9c9ae9f8eedeb042732a921c6dfaee579aa477f2"
        + "031230fc6268b5b8fa191102f3190a132febe6c1582e78d12af6d5ce5ca0b506");
}

fn wrong_digest_signature() {
    return bytes("04896c1bd21e2af526b5b6453e335b1e6979b7330172d952278e49d0c911a13a"
        + "0b41555b57630469f203184b2d568543cbf4aa18b2f057124984450339513804");
}

fn large_signature() {
    return bytes("583dfd285aa7d801b3cf1f12be627eb6549cc0a72adc71e1cb83fad9052e7937"
        + "ae8104dc29301317ce292d73138cf7de0823ad604267e4011f51dc942140520f");
}

fn large_artifact(source_row) {
    return RELEASE.artifact(source_row, "large.pbck", LARGE_ARTIFACT_DIGEST,
        ADMISSION.MAX_ARTIFACT_BYTES, A, "1.2.3", "stable",
        ["linux:x86_64", "linux:aarch64"], map{
            signed_artifact:true, signature_sha256:C, sbom_sha256:D,
            attestation_sha256:A, install_verified:false,
            upgrade_verified:false, rollback_verified:false,
            uninstall_verified:false});
}

fn store_text() {
    return json_stringify(map{format:TRUST.FORMAT, generation:7,
        publishers:[map{publisher_id:"example-publisher", policy_revision:3,
            key_id:KEY_ID, algorithm:"ed25519",
            public_key:base64_encode_bytes(bytes(KEY_HEX)), state:"active",
            product:"demo", package_id:"org.example.demo",
            release_channels:["stable"],
            targets:["linux:aarch64", "linux:x86_64"]}]});
}

fn request(store_path, artifact_path, source_row, artifact_row, signed) {
    return map{format:ADMISSION.REQUEST_FORMAT, trust_store_path:store_path,
        artifact_path:artifact_path, source:source_row,
        artifact:artifact_row, attestation:signed};
}

let root = "/tmp/pblang-publisher-artifact-"
    + str_slice(sha256(base64_encode_bytes(random_bytes(24))), 0, 24);
require(SECURE.create_private_temporary_directory_new(root).ok,
    "private artifact-admission fixture root creation failed");
let store_path = root + "/trusted.json";
let artifact_path = root + "/demo.pbck";
let artifact_bytes = base64_decode_bytes("cGJsYW5nLWFydGlmYWN0LXYyLWZpeHR1cmU=");
require(len(artifact_bytes) == 26
    and sha256(base64_encode_bytes(artifact_bytes)) == ARTIFACT_DIGEST,
    "artifact digest fixture drifted");
require(SECURE.write_text_new_exclusive(store_path, store_text(), false, true).ok
    and SECURE.write_atomic(artifact_path, artifact_bytes, false, true).ok,
    "artifact-admission fixtures could not be published");

let source_row = source();
let artifact_row = artifact(source_row);
let policy = RELEASE.publisher_policy("example-publisher", 3, bytes(KEY_HEX));
let signed = RELEASE.publisher_attestation_v2(source_row, artifact_row, policy,
    "org.example.demo", 42, signature());
let direct = RELEASE.verify_publisher_attestation_v2(source_row, artifact_row,
    policy, signed);
require(direct.ed25519_signature_verified and direct.release_binding_verified
    and direct.artifact_digest_algorithm_signed
    and direct.artifact_digest_algorithm == RELEASE.ARTIFACT_DIGEST_ALGORITHM
    and direct.attestation_message_sha256
        == "ec95410c3f917c1d3749df60650846db0a91c79de2264b0311d6548a338b0a2d"
    and not direct.artifact_bytes_measured and not direct.authorizes_execution,
    "v2 signature must bind the explicit artifact digest interpretation");

// A valid signature for 26 bytes cannot reserve 26 and copy 27 bytes.
let oversized_signed_path = root + "/oversized-signed.pbck";
let oversized_signed_bytes = base64_decode_bytes("cGJsYW5nLWFydGlmYWN0LXYyLWZpeHR1cmU=");
array_push(oversized_signed_bytes, 0);
require(SECURE.write_atomic(oversized_signed_path, oversized_signed_bytes, false, true).ok,
    "signed-size overflow fixture creation failed");
let before_oversized = ADMISSION.status();
let oversized_signed = ADMISSION.prepare(request(store_path, oversized_signed_path,
    source_row, artifact_row, signed));
let after_oversized = ADMISSION.status();
require(not oversized_signed.ok and oversized_signed.reason == "artifact-open-rejected"
    and not oversized_signed.artifact_snapshot_opened
    and after_oversized.open_admissions == before_oversized.open_admissions
    and after_oversized.reserved_admissions == before_oversized.reserved_admissions
    and after_oversized.poisoned_admissions == before_oversized.poisoned_admissions
    and after_oversized.held_or_reserved_bytes == before_oversized.held_or_reserved_bytes,
    "signed-size overflow rejects before snapshot allocation without consuming capacity");
require(SECURE.remove_file(oversized_signed_path, true).ok,
    "signed-size overflow fixture cleanup failed");

let store_sha256 = SHA256.sha256_hex_bytes(str_to_bytes(store_text()));
let pinned_request = request(store_path, artifact_path, source_row, artifact_row, signed);
for invalid_digest in [nil, false, 1, [], map{}, "private-digest-marker", str_upper(store_sha256)] {
    let invalid = ADMISSION.prepare_with_expected_store(pinned_request, invalid_digest);
    require(not invalid.ok and invalid.reason == "invalid-expected-store-digest"
        and not invalid.trust_store_snapshot_attempted and not invalid.artifact_snapshot_opened
        and invalid.caller_expected_store_digest_requested and not invalid.caller_expected_store_digest_matched
        and not str_contains(json_stringify(invalid), "private-digest-marker"),
        "invalid expected digest must fail before store or artifact I/O without echo");
}
let pinned = ADMISSION.prepare_with_expected_store(pinned_request, store_sha256);
require(pinned.ok and pinned.caller_expected_store_digest_matched and pinned.artifact_bytes_measured
    and not pinned.operator_trust_anchor_origin_verified and not pinned.authorizes_execution
    and not str_contains(json_stringify(pinned), store_sha256) and ADMISSION.close(pinned.handle).ok,
    "expected store admission binds actual measured artifact and cleans its handle");
let mismatched = ADMISSION.prepare_with_expected_store(pinned_request, A);
require(not mismatched.ok and mismatched.trust_store_snapshot_attempted
    and mismatched.trust_store_snapshot_cleanup_verified and not mismatched.artifact_snapshot_opened,
    "mismatched expected store rejects before artifact open");
let replacement_store = str_replace_all(store_text(), "\"generation\":7", "\"generation\":8");
require(SECURE.write_atomic(store_path, str_to_bytes(replacement_store), false, true).ok,
    "replacement store fixture failed");
let replaced = ADMISSION.prepare_with_expected_store(pinned_request, store_sha256);
require(not replaced.ok and not replaced.artifact_snapshot_opened,
    "replacement store rejected even when its key still verifies the signature");
let current_store = ADMISSION.prepare(pinned_request);
require(current_store.ok and ADMISSION.close(current_store.handle).ok,
    "legacy current-store API remains compatible with valid replacement");
require(SECURE.write_atomic(store_path, str_to_bytes(store_text()), false, true).ok,
    "store fixture restoration failed");
let expected_store = TRUST.verify_expected_current_snapshot_v2(store_path,
    store_sha256, source_row, artifact_row, signed);
require(expected_store.ok
    and expected_store.caller_expected_store_digest_requested
    and expected_store.caller_expected_store_digest_matched
    and expected_store.same_store_snapshot_measured_and_parsed
    and expected_store.snapshot_cleanup_verified
    and expected_store.configured_store_key_signature_verified
    and expected_store.artifact_digest_algorithm_signed
    and not expected_store.operator_trust_anchor_origin_verified
    and not expected_store.trusted_key_selection_verified
    and not expected_store.revocation_freshness_verified
    and not expected_store.publisher_authenticity_verified
    and not expected_store.authorizes_execution
    and not str_contains(json_stringify(expected_store), store_path)
    and not str_contains(json_stringify(expected_store), store_sha256),
    "caller-expected digest must bind the same store snapshot without becoming operator trust");
let wrong_store = TRUST.verify_expected_current_snapshot_v2(store_path, A,
    source_row, artifact_row, signed);
require(not wrong_store.ok and wrong_store.reason == "expected-store-digest-mismatch"
    and wrong_store.caller_expected_store_digest_requested
    and not wrong_store.caller_expected_store_digest_matched
    and wrong_store.snapshot_cleanup_verified
    and not wrong_store.configured_store_key_signature_verified,
    "wrong expected store digest must reject before key selection");
let uppercase_store = TRUST.verify_expected_current_snapshot_v2(store_path,
    str_upper(store_sha256), source_row, artifact_row, signed);
require(not uppercase_store.ok and uppercase_store.reason == "invalid-expected-store-digest"
    and not uppercase_store.caller_expected_store_digest_matched
    and not uppercase_store.protected_store_snapshot_verified,
    "uppercase or noncanonical expected digests must fail before opening");
let expected_bad_signature = RELEASE.publisher_attestation_v2(source_row,
    artifact_row, policy, "org.example.demo", 42, signature());
expected_bad_signature.signature[0] = expected_bad_signature.signature[0] + 1;
let expected_signature_rejected = TRUST.verify_expected_current_snapshot_v2(
    store_path, store_sha256, source_row, artifact_row, expected_bad_signature);
require(not expected_signature_rejected.ok
    and not expected_signature_rejected.caller_expected_store_digest_matched
    and expected_signature_rejected.snapshot_cleanup_verified
    and not expected_signature_rejected.configured_store_key_signature_verified,
    "digest match alone must not survive failed publisher verification");

let polyglot = TRUST.polyglot_verification_contract();
require(polyglot.format == TRUST.POLYGLOT_CONTRACT_FORMAT
    and polyglot.canonical_policy_owner == "pblang"
    and polyglot.pblang_supplies_trust_store_binding
    and not polyglot.foreign_filesystem_access
    and not polyglot.foreign_trust_anchor_selection
    and not polyglot.trust_boolean_forwarding
    and not polyglot.implementation_present
    and not polyglot.authorizes_execution and not polyglot.production_ready
    and str_contains(json_stringify(polyglot.forbidden_public_inputs),
        "trust-store-path")
    and str_contains(json_stringify(polyglot.forbidden_public_inputs),
        "expected-store-digest"),
    "polyglot contract must keep trust-store path and digest authority inside PBLang");

let wrong_artifact = artifact(source_row,
    "97c04077a5bbf4abf090f9122a5d170d411c453b98e9eb672a1b96452aa15c87");
let wrong_signed = RELEASE.publisher_attestation_v2(source_row, wrong_artifact,
    policy, "org.example.demo", 42, wrong_digest_signature());
let pinned_wrong_artifact = ADMISSION.prepare_with_expected_store(request(store_path,
    artifact_path, source_row, wrong_artifact, wrong_signed), store_sha256);
require(not pinned_wrong_artifact.ok and pinned_wrong_artifact.caller_expected_store_digest_matched
    and pinned_wrong_artifact.artifact_snapshot_cleanup_verified
    and not pinned_wrong_artifact.signed_digest_matched,
    "matched store evidence survives a later artifact measurement rejection");
let rejected = ADMISSION.prepare(request(store_path, artifact_path,
    source_row, wrong_artifact, wrong_signed));
require(not rejected.ok and rejected.handle == nil
    and not rejected.artifact_bytes_measured
    and rejected.artifact_snapshot_opened
    and rejected.artifact_snapshot_cleanup_attempted
    and rejected.artifact_snapshot_cleanup_verified
    and rejected.trust_store_snapshot_attempted
    and rejected.trust_store_snapshot_cleanup_verified
    and not rejected.same_object_prepared and not rejected.authorizes_execution,
    "measured digest mismatch must close the snapshot and issue no capability");

let bad_signature = RELEASE.publisher_attestation_v2(source_row, artifact_row,
    policy, "org.example.demo", 42, signature());
bad_signature.signature[0] = bad_signature.signature[0] + 1;
let rejected_signature = ADMISSION.prepare(request(store_path, artifact_path,
    source_row, artifact_row, bad_signature));
require(not rejected_signature.ok and not rejected_signature.artifact_snapshot_opened
    and rejected_signature.trust_store_snapshot_attempted
    and rejected_signature.trust_store_snapshot_cleanup_verified,
    "invalid signatures must be rejected before artifact snapshotting");

let legacy = RELEASE.publisher_attestation(source_row, artifact_row, policy,
    "org.example.demo", 42, signature());
let expected_v1 = TRUST.verify_expected_current_snapshot_v2(store_path,
    store_sha256, source_row, artifact_row, legacy);
require(not expected_v1.ok
    and expected_v1.caller_expected_store_digest_requested
    and not expected_v1.caller_expected_store_digest_matched
    and expected_v1.snapshot_cleanup_verified
    and not expected_v1.configured_store_key_signature_verified,
    "a matching store digest must not downgrade v2 verification to v1");
let rejected_v1 = ADMISSION.prepare(request(store_path, artifact_path,
    source_row, artifact_row, legacy));
require(not rejected_v1.ok and not rejected_v1.artifact_snapshot_opened,
    "v1 attestations must never downgrade into v2 artifact admission");

let revoked_store_path = root + "/revoked-trust.json";
let revoked_store_text = str_replace_all(store_text(),
    "\"state\":\"active\"", "\"state\":\"revoked\"");
let revoked_store_sha256 = SHA256.sha256_hex_bytes(
    str_to_bytes(revoked_store_text));
require(SECURE.write_text_new_exclusive(revoked_store_path,
    revoked_store_text, false, true).ok,
    "revoked expected-store fixture could not be published");
let expected_revoked = TRUST.verify_expected_current_snapshot_v2(
    revoked_store_path, revoked_store_sha256,
    source_row, artifact_row, signed);
require(not expected_revoked.ok
    and expected_revoked.reason == "publisher-key-revoked"
    and expected_revoked.caller_expected_store_digest_requested
    and not expected_revoked.caller_expected_store_digest_matched
    and expected_revoked.snapshot_cleanup_verified
    and expected_revoked.revocation_state_snapshot_applied
    and not expected_revoked.configured_store_key_signature_verified,
    "a matching digest must not override revocation in the same snapshot");

let huge_source = json_parse(json_stringify(source_row)); let huge_index = 0;
while huge_index < 1024 {
    huge_source["field-" + str(huge_index)] = huge_index;
    huge_index = huge_index + 1;
}
let huge_request = request(store_path, artifact_path,
    source_row, artifact_row, signed);
huge_request.source = huge_source;
let rejected_huge = ADMISSION.prepare(huge_request);
require(not rejected_huge.ok and not rejected_huge.artifact_snapshot_opened,
    "oversized nested maps must fail before key traversal or artifact work");
let huge_artifact = json_parse(json_stringify(artifact_row)); huge_index = 0;
while huge_index < 1024 {
    huge_artifact["field-" + str(huge_index)] = huge_index;
    huge_index = huge_index + 1;
}
let rejected_huge_artifact = ADMISSION.prepare(request(store_path, artifact_path,
    source_row, huge_artifact, signed));
require(not rejected_huge_artifact.ok
    and not rejected_huge_artifact.artifact_snapshot_opened,
    "oversized artifact maps must fail before key traversal or artifact work");
let huge_attestation = json_parse(json_stringify(signed)); huge_index = 0;
while huge_index < 1024 {
    huge_attestation["field-" + str(huge_index)] = huge_index;
    huge_index = huge_index + 1;
}
let rejected_huge_attestation = ADMISSION.prepare(request(store_path,
    artifact_path, source_row, artifact_row, huge_attestation));
require(not rejected_huge_attestation.ok
    and not rejected_huge_attestation.artifact_snapshot_opened,
    "oversized attestation maps must fail before key traversal or artifact work");

let admitted = ADMISSION.prepare(request(store_path, artifact_path,
    source_row, artifact_row, signed));
require(admitted.ok and admitted.artifact_snapshot_opened
    and admitted.artifact_snapshot_immutable and admitted.artifact_bytes_measured
    and admitted.signed_byte_count_matched and admitted.signed_digest_matched
    and admitted.artifact_digest_algorithm_signed
    and admitted.configured_store_signature_verified
    and admitted.protected_store_snapshot_verified
    and admitted.trust_store_snapshot_cleanup_verified
    and admitted.same_object_prepared
    and not admitted.same_verified_artifact_handoff
    and admitted.bearer_handle_issued
    and not admitted.bearer_handle_copy_resistant
    and not admitted.same_vm_handle_only
    and not admitted.same_vm_handle_scope_verified
    and not admitted.cross_vm_handle_isolation
    and not admitted.hostile_caller_capacity_isolation
    and not admitted.vm_enforced_typed_ffi
    and not admitted.operator_trust_anchor_origin_verified
    and not admitted.revocation_freshness_verified
    and not admitted.rollback_protection_enforced
    and not admitted.publisher_authenticity_verified
    and not admitted.authorizes_execution and not admitted.production_ready,
    "successful admission must report only the guarantees it actually proves");
let public_text = json_stringify(admitted);
require(not str_contains(public_text, root)
    and not str_contains(public_text, ARTIFACT_DIGEST)
    and not str_contains(public_text, KEY_HEX)
    and len(map_keys(admitted.handle)) == 2,
    "public admission evidence must not expose paths, bytes, digests, keys, or descriptors");

let copied_handle = json_parse(json_stringify(admitted.handle));
require(ADMISSION.close(copied_handle).ok,
    "copyable bearer handle must consume the held snapshot exactly once");
require(not ADMISSION.close(admitted.handle).ok,
    "closed artifact handles must not be reusable");
let forged = map{format:ADMISSION.HANDLE_FORMAT,
    id:"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="};
require(not ADMISSION.close(forged).ok,
    "well-formed but unissued handles must not select a held snapshot");

let changed_algorithm = RELEASE.publisher_attestation_v2(source_row,
    artifact_row, policy, "org.example.demo", 42, signature());
changed_algorithm.artifact_digest_algorithm = "sha256(raw-bytes)";
let rejected_algorithm = ADMISSION.prepare(request(store_path, artifact_path,
    source_row, artifact_row, changed_algorithm));
require(not rejected_algorithm.ok and rejected_algorithm.handle == nil
    and not rejected_algorithm.artifact_digest_algorithm_signed,
    "unsigned digest-algorithm reinterpretation must fail closed");

let polyglot = ADMISSION.polyglot_adapter_contract();
require(polyglot.canonical_policy_owner == "pblang"
    and polyglot.descriptor_lifecycle_owner == "pblang"
    and not polyglot.path_reopen_allowed and not polyglot.shell_execution_allowed
    and not polyglot.implementation_present and not polyglot.authorizes_execution,
    "polyglot boundary must remain a non-authorizing PBLang-owned contract");

let capacity_handles = []; let capacity_index = 0;
while capacity_index < ADMISSION.MAX_OPEN_ADMISSIONS {
    let capacity_admission = ADMISSION.prepare(request(store_path, artifact_path,
        source_row, artifact_row, signed));
    require(capacity_admission.ok,
        "fixed admission capacity fixture failed before the declared limit");
    array_push(capacity_handles, capacity_admission.handle);
    capacity_index = capacity_index + 1;
}
let capacity_rejected = ADMISSION.prepare(request(store_path, artifact_path,
    source_row, artifact_row, signed));
require(not capacity_rejected.ok and capacity_rejected.handle == nil
    and capacity_rejected.reason == "admission-capacity-reached",
    "the ninth admission must fail without acquiring an artifact snapshot");
for capacity_handle in capacity_handles {
    require(ADMISSION.close(capacity_handle).ok,
        "capacity fixture snapshot cleanup failed");
}

// Exercise the aggregate byte ceiling with four maximum-size snapshots. The
// fifth call has free descriptor slots but must fail before opening an artifact.
let large_path = root + "/large.pbck";
let created_large = try proc_spawn_wait("/bin/dd", ["if=/dev/zero",
    "of=" + large_path, "bs=1048576", "count=16", "status=none"])
    catch nil;
require(type(created_large) == "map" and created_large.exit_code == 0,
    "large aggregate-bound fixture creation failed");
let large_row = large_artifact(source_row);
let large_signed = RELEASE.publisher_attestation_v2(source_row, large_row,
    policy, "org.example.demo", 43, large_signature());
let large_handles = []; let large_index = 0;
while large_index < 4 {
    let large_admission = ADMISSION.prepare(request(store_path, large_path,
        source_row, large_row, large_signed));
    require(large_admission.ok,
        "aggregate-bound fixture failed before the declared byte ceiling");
    array_push(large_handles, large_admission.handle);
    large_index = large_index + 1;
}
let full_state = ADMISSION.status();
require(full_state.open_admissions == 4
    and full_state.held_or_reserved_bytes == ADMISSION.MAX_TOTAL_HELD_BYTES,
    "four maximum-size snapshots must exactly fill the aggregate byte ceiling");
let byte_rejected = ADMISSION.prepare(request(store_path, large_path,
    source_row, large_row, large_signed));
require(not byte_rejected.ok and byte_rejected.handle == nil
    and byte_rejected.reason == "admission-byte-capacity-reached"
    and not byte_rejected.artifact_snapshot_opened,
    "aggregate byte overflow must fail before artifact acquisition");
for large_handle in large_handles {
    require(ADMISSION.close(large_handle).ok,
        "aggregate-bound fixture snapshot cleanup failed");
}

let state = ADMISSION.status();
require(state.experimental and state.fixed_capacity_registry
    and state.open_admissions == 0
    and state.reserved_admissions == 0 and state.poisoned_admissions == 0
    and state.held_or_reserved_bytes == 0
    and state.max_artifact_bytes == 16777216
    and state.max_total_held_bytes == 67108864
    and state.same_object_preparation_supported == state.available
    and not state.same_verified_artifact_handoff_supported
    and not state.execution_supported and not state.polyglot_adapter_implemented
    and not state.bearer_handle_copy_resistant
    and not state.same_vm_handle_only
    and not state.same_vm_handle_scope_verified
    and not state.cross_vm_handle_isolation
    and not state.hostile_caller_capacity_isolation
    and not state.vm_enforced_typed_ffi
    and not state.publisher_authenticity_complete
    and not state.authorizes_execution and not state.production_ready,
    "artifact admission status must preserve every unresolved production boundary");

require(SECURE.remove_file(large_path, true).ok
    and SECURE.remove_file(artifact_path, true).ok
    and SECURE.remove_file(revoked_store_path, true).ok
    and SECURE.remove_file(store_path, true).ok,
    "artifact-admission fixture file cleanup failed");
let removed = try proc_spawn_wait("/bin/rmdir", [root]) catch nil;
require(type(removed) == "map" and removed.exit_code == 0,
    "artifact-admission fixture directory cleanup failed");

print "publisher artifact admission tests passed";
