let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let P=import("stdlib:selfhost_pbck.sapp");
let source=fs_read("tests/fixtures/selfhost_inline_blocks.sapp");
let compiled=F.frontend_compile(source);
assert(compiled.ok,"inline block compile");
for chunk in [compiled.chunk,P.deserialize_chunk(P.serialize_chunk(compiled.chunk))] {
    assert(V.run(chunk).output==["selfhost_inline_blocks_pass"],"plain and serialized result");
    assert(V.run_bounded(chunk).output==["selfhost_inline_blocks_pass"],"bounded result");
}
assert(F.frontend_run(source).output==["selfhost_inline_blocks_pass"],"optimized frontend result");
let nested=F.frontend_run("fn f(){let value=0;let x=try {let y=try {throw 1;} catch {value=value+1;throw 2;};0} catch {value=value+1;value};return x;} print f();");
assert(nested.output==[2],"nested throwing handlers preserve enclosing assignments");
// A failed inlined body must relinquish its local references before the handler.
compiled=F.frontend_compile("let value=try {let large=[1,2];throw 7;} catch 9;");
let result=V.run(compiled.chunk);
assert(result.globals.value==9,"implicit body boundary");
for value in result.locals {assert(value==nil,"failed block drops local reference");}
// No hidden OP_CLOSURE/OP_CALL for a plain block with no user function.
compiled=F.frontend_compile("let value={let inner=4;inner};");
for instruction in compiled.chunk.instructions {
    assert(instruction.op!=24 and instruction.op!=18,"no synthetic closure/call");
}
for malformed in ["let x=try {let a=1} catch 2;","let x=try {throw 1;} catch {let a=2", "let x={print 1}"] {
    assert(not F.frontend_compile(malformed).ok,"malformed block still rejected");
}
print "selfhost_inline_blocks_contract_pass";
