let crypto = import("stdlib:crypto_advanced.sapp");

// password_hash and verify
// Use default rounds (10000) for consistent hash/verify
let hash = crypto.password_hash("mypassword", "mysalt", 10000);
assert(type(hash) == "string", "hash should be string");
assert(len(hash) == 64, "SHA256 hex should be 64 chars");

let ok = crypto.password_verify("mypassword", "mysalt", hash);
assert(ok == true, "correct password should verify");

let bad_ok = crypto.password_verify("wrongpassword", "mysalt", hash);
assert(bad_ok == false, "wrong password should not verify");

// generate_token
let token = crypto.generate_token(32);
assert(type(token) == "string", "token should be string");
assert(len(token) == 32, "token should be 32 chars");

let token2 = crypto.generate_token(32);
assert(token != token2, "tokens should be unique (collision extremely unlikely)");

// uuid4
let uid = crypto.uuid4();
assert(type(uid) == "string", "uuid should be string");
assert(len(uid) == 36, "UUID should be 36 chars: " + str(len(uid)));
assert(str_contains(uid, "-"), "UUID should contain dashes");

print "crypto_advanced_pass";
