let tc = import("stdlib:typeclass.sapp");
let cls = import("stdlib:class.sapp");

let Show = tc.Show();
assert(tc.call(Show, "show", 42) == "42", "number show");
assert(tc.call(Show, "show", "hello") == "hello", "string show");
assert(tc.implements(Show, true), "bool implements show");

let Eq = tc.Eq();
assert(tc.call1(Eq, "eq", 7, 7), "number eq true");
assert(tc.call1(Eq, "eq", 7, 8) == false, "number eq false");
let laws = tc.check_laws(Eq, [1, 2, 3, "a", "a"]);
assert(laws.ok, "eq laws for primitives");

let Ord = tc.Ord();
assert(tc.call1(Ord, "cmp", 2, 5) == -1, "number cmp lt");
assert(tc.call1(Ord, "cmp", "abc", "abd") == -1, "string cmp lt");
assert(tc.call1(Ord, "cmp", "same", "same") == 0, "string cmp eq");

let point_pred = fn(x) {
    return type(x) == "map" and map_has(x, "x") and map_has(x, "y");
};
tc.instance_where(Show, "Point", point_pred, map{
    show: fn(p) { return "(" + str(p.x) + "," + str(p.y) + ")"; },
});
tc.instance_where(Eq, "Point", point_pred, map{
    eq: fn(a, b) {
        return point_pred(b) and a.x == b.x and a.y == b.y;
    },
});

let p1 = map{ x: 2, y: 3 };
let p2 = map{ x: 2, y: 3 };
let p3 = map{ x: 3, y: 2 };
assert(tc.call(Show, "show", p1) == "(2,3)", "custom show");
assert(tc.call1(Eq, "eq", p1, p2), "custom eq true");
assert(tc.call1(Eq, "eq", p1, p3) == false, "custom eq false");

let Bag = cls.define("Bag", ["items"], map{
    size: fn(self) { return len(self.items); },
});
tc.instance_for_class(Show, "Bag", map{
    show: fn(b) { return "Bag(" + str(len(b.items)) + ")"; },
});
let bag = cls.new(Bag, map{ items: [1, 2, 3] });
assert(tc.implements(Show, bag), "class instance implements show");
assert(tc.call(Show, "show", bag) == "Bag(3)", "class show instance");

let Monoid = tc.Monoid();
assert(tc.call1(Monoid, "concat", "a", "b") == "ab", "string monoid concat");
assert(tc.call(Monoid, "empty", "seed") == "", "string monoid empty");
assert(tc.call1(Monoid, "concat", [1, 2], [3]) == [1, 2, 3], "array monoid concat");

let labels = tc.instance_labels(Show);
assert(len(labels) >= 5, "labels include builtin and custom instances");

let Bad = tc.define("Bad", ["missing"]);
let invalid = try tc.instance_for_type(Bad, "number", map{}) catch "err";
assert(invalid == "err", "missing required method rejected");

print "typeclass_stdlib_pass";
