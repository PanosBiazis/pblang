// Uses a private, test-owned nonce directory and no real input backend.
fn require(value, message) { if not value { throw "master lifecycle: " + message; } }
let suffix = str_slice(sha256(str(random_bytes(16))), 0, 20);
let directory = cwd() + "/.master-lifecycle-test-" + suffix;
let made = proc_spawn_wait("/bin/mkdir", ["-m", "0700", "--", directory]);
require(made.exit_code == 0, "could not create private fixture directory");
let result = try proc_spawn_wait("/usr/bin/env", [
    "-i", "PATH=/usr/bin:/bin", "PB_MASTER_CONTROL=1",
    "PB_MASTER_CONTROL_HOME=" + directory,
    cwd() + "/target/release/pblang", "run",
    "tests/fixtures/master_control_lifecycle_active.sapp",
    "--allow-fs", "--allow-env", "--allow-import",
    "--deny-exec", "--deny-net", "--deny-http", "--deny-ffi",
    "--deny-spawn", "--deny-gfx", "--deny-sqlite"
]) catch nil;
try fs_remove(directory + "/.pb_master_control_unlock") catch nil;
try fs_remove(directory + "/.pb_master_control_audit.log") catch nil;
let removed = proc_spawn_wait("/bin/rmdir", ["--", directory]);
require(removed.exit_code == 0, "fixture cleanup failed");
require(result != nil and result.exit_code == 0
    and str_contains(result.stdout, "master_control_lifecycle_active_pass"),
    "isolated child failed: " + str(try result.stderr catch "unavailable"));
print "master_control_lifecycle_pass";
