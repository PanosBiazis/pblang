// tests/semantics/ecs_enrich_test.sapp — enrichment for stdlib/ecs.sapp
// Adds remove_component, query_one, count_with, all_entities, clear.

let ecs = import("stdlib/ecs.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let w = ecs.create_world();
let p = ecs.spawn(w, map{ position: map{ x: 0, y: 0 }, health: 100 });
ecs.spawn(w, map{ position: map{ x: 5, y: 5 } });   // no health

// ── base query still works ───────────────────────────────────────────────────────
eq(len(ecs.query(w, ["position"])), 2, "query position -> 2");
eq(len(ecs.query(w, ["position", "health"])), 1, "query position+health -> 1");

// ── ENRICH: count_with ───────────────────────────────────────────────────────────
eq(ecs.count_with(w, ["position"]), 2, "count_with position");
eq(ecs.count_with(w, ["health"]), 1, "count_with health");

// ── ENRICH: query_one ────────────────────────────────────────────────────────────
let one = ecs.query_one(w, ["health"]);
eq(one.id, p, "query_one returns the health entity");
eq(ecs.query_one(w, ["nonexistent"]), nil, "query_one no match -> nil");

// ── ENRICH: remove_component ─────────────────────────────────────────────────────
ecs.remove_component(w, p, "health");
eq(ecs.has_component(w, p, "health"), false, "component removed");
eq(ecs.count_with(w, ["health"]), 0, "no entities with health after removal");

// ── ENRICH: all_entities ─────────────────────────────────────────────────────────
eq(len(ecs.all_entities(w)), 2, "all_entities count");

// ── ENRICH: clear ────────────────────────────────────────────────────────────────
ecs.clear(w);
eq(ecs.entity_count(w), 0, "clear removes all");

print "ecs_enrich_pass";
