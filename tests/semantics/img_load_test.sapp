// tests/semantics/img_load_test.sapp
// Real pixel loading: parse a binary PPM (P6) into a 2D pixel array, and the gui image
// widget that holds it.
let il = import("stdlib:img_load.sapp");
let gfx = import("stdlib:graphics.sapp");
let gui = import("stdlib:gui.sapp");

fn fail(m) { throw "FAIL " + m; }

// 2x2 P6: header "P6\n2 2\n255\n" then RGB for red, green, blue, white.
let ppm = [80,54,10, 50,32,50,10, 50,53,53,10,
           255,0,0, 0,255,0, 0,0,255, 255,255,255];
let img = il.parse_ppm(ppm);
if img == nil { fail("parse_ppm returned nil"); }
if len(img) != 2 or len(img[0]) != 2 { fail("ppm dims (got " + str(len(img)) + "x" + str(len(img[0])) + ")"); }
if img[0][0] != gfx.rgb(255, 0, 0) { fail("pixel (0,0) should be red"); }
if img[1][1] != gfx.rgb(255, 255, 255) { fail("pixel (1,1) should be white"); }

// round-trip through a file
fs_write_bytes("tests/semantics/_t.ppm", ppm);
let img2 = il.load_ppm("tests/semantics/_t.ppm");
fs_remove("tests/semantics/_t.ppm");
if img2 == nil or len(img2) != 2 { fail("load_ppm round-trip"); }

// malformed input -> nil (not a crash)
if il.parse_ppm([1,2,3]) != nil { fail("non-PPM should return nil"); }

// gui image widget holds the pixels and is addable/gettable
let f = gui.form("t", 200, 200);
gui.add(f, gui.image("preview", 10, 10, 80, 60, img));
let w = gui.get(f, "preview");
if w == nil or w.kind != "image" { fail("image widget not created"); }
if len(w.img) != 2 { fail("image widget should hold the pixel grid"); }
// a nil-image widget is also valid (placeholder)
gui.add(f, gui.image("empty", 10, 80, 80, 60, nil));
if gui.get(f, "empty").img != nil { fail("empty image widget"); }

print "img_load_pass";
