// tests/semantics/hal_test.sapp — the Hardware Abstraction Layer: one big map of device
// classes + a set of COMMON verbs (open/read/write/ioctl/...) that apply to many devices,
// resolved to the right syscall (per arch) / WinAPI / path. Plus live access where possible.

let HAL = import("stdlib/hal.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : <<" + s + ">>"); } }

// ── the device catalog is broad ─────────────────────────────────────────────────────
let cs = HAL.classes();
if len(cs) < 12 { fail("HAL should know many device classes, got " + str(len(cs))); }
let names = "";
let i = 0; while i < len(cs) { names = names + cs[i] + " "; i = i + 1; }
has(names, "rng", "knows rng"); has(names, "gpio", "knows gpio"); has(names, "i2c", "knows i2c");
has(names, "serial", "knows serial"); has(names, "framebuffer", "knows framebuffer");

// ── per-device descriptors (linux path + access + windows hint) ──────────────────────
has(HAL.device("rng").linux.path, "random", "rng linux path");
eq(HAL.device("gpio").linux.access, "ioctl", "gpio uses ioctl");
has(HAL.device("serial").windows.path, "COM", "serial windows COM port");

// ── COMMON verbs reused across devices, mapped to syscalls per arch + WinAPI ─────────
let vs = HAL.verbs();
has(str(vs), "ioctl", "verbs include ioctl");
eq(HAL.syscall("read", "x86_64"), 0, "x86_64 read = 0");
eq(HAL.syscall("write", "x86_64"), 1, "x86_64 write = 1");
eq(HAL.syscall("ioctl", "x86_64"), 16, "x86_64 ioctl = 16");
eq(HAL.syscall("read", "arm64"), 63, "arm64 read = 63");
eq(HAL.syscall("write", "i386"), 4, "i386 write = 4");
has(HAL.windows_api("read"), "ReadFile", "windows read = ReadFile");
has(HAL.windows_api("ioctl"), "DeviceIoControl", "windows ioctl = DeviceIoControl");

// ── ioctl request-code table ────────────────────────────────────────────────────────
eq(HAL.ioctl_code("TIOCGWINSZ"), 0x5413, "TIOCGWINSZ code");
eq(HAL.ioctl_code("I2C_SLAVE"), 0x0703, "I2C_SLAVE code");

// ── a portable recipe: how to do verb V on class C ──────────────────────────────────
let r = HAL.recipe("gpio", "ioctl");
eq(r.access, "ioctl", "gpio ioctl recipe access");
has(r.linux_path, "gpiochip", "gpio recipe path");
eq(r.linux_syscall, 16, "gpio ioctl recipe -> syscall 16");

// ── live access via the current Linux drivers (rng) ─────────────────────────────────
let u = HAL.read_attr("rng");
if len(u) < 8 { fail("HAL.read_attr(rng) should return data from the kernel RNG driver"); }

print "hal_pass";
