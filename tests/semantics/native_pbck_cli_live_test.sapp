if platform() != "linux" { print "native_pbck_cli_skip_linux_required"; os_exit(0); }
let UUID=import("stdlib:uuid.sapp");let OS=import("stdlib:os.sapp");
let compiler=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let base=path_join(OS.temp_dir(),"pblang_pbck_cli_"+UUID.v4());
let source=base+".sapp";let output=base+".pbck";
fn child(flags) {
    let args=["-k","1s","20s",compiler,"run","tools/pbc.sapp","--allow-all","--",source,"--target","pbck","--out",output];
    for flag in flags {array_push(args,flag);}
    return proc_spawn_wait("/usr/bin/timeout",args);
}
fn exercise() {
    fs_write(output,"previous artifact");
    for flags in [["--safe"],["--overflow"],["--local-source"],["--max-tokens=4"]] {
        assert(child(flags).exit_code==2,"unsupported option rejected before file read");
        assert(fs_read(output)=="previous artifact","option failure preserves output");
    }
    for invalid in ["let n:number=nil-1;", "print 7; /* private_canary", "print missing_name;"] {
        fs_write(source,invalid);let result=child([]);
        assert(result.exit_code==1 and fs_read(output)=="previous artifact","compile failure preserves previous artifact");
        assert(not str_contains(result.stdout+result.stderr,"private_canary"),"no user source disclosure");
    }
    fs_write(source,"for i 1 {let p=map{run:fn(self){return 7;}};print (try {p:run()} catch 9);}");
    assert(child([]).exit_code==0,"CLI compilation");
    let result=proc_spawn_wait("/usr/bin/timeout",["-k","1s","5s",compiler,"run",output,"--sandbox"]);
    assert(result.exit_code==0 and result.stdout=="7\n","artifact runs without broad permissions");
    // Compiling a capability request does not grant that capability to the artifact.
    fs_write(source,"fs_read(\"private_canary\");");assert(child([]).exit_code==0,"capability source compiles");
    result=proc_spawn_wait("/usr/bin/timeout",["-k","1s","5s",compiler,"run",output,"--sandbox"]);
    assert(result.exit_code!=0 and str_contains(result.stderr,"fs access denied"),"runtime capability boundary retained");
}
let passed=try {exercise();true} catch false;
for path in [source,output] {try fs_remove(path) catch nil;}
assert(passed,"native PBCK CLI regression");
print "native_pbck_cli_pass";
