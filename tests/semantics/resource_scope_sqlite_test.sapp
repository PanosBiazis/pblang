let R=import("stdlib:resource_scope.sapp");
let DB=import("stdlib:db.sapp");
let state=map{handle:0,closed:0};
let result=R.with_scope(fn(scope){
    let conn=DB.sqlite.open(":memory:");
    state.handle=conn.handle;
    scope.defer(fn(){sqlite_close(state.handle);state.closed=state.closed+1;return map{ok:true,value:nil};});
    conn.query("select 42",[]);
    let empty=[];
    return map{ok:true,value:empty[3]};
});
if result.ok or result.body_status!="exception" or not result.cleanup_ok or state.closed!=1 {
    throw "FAIL SQLite cleanup after implicit failure";
}
let unusable=try {sqlite_query(state.handle,"select 1",[]);false} catch true;
if not unusable {throw "FAIL SQLite handle remains usable";}
print "resource_scope_sqlite_pass";
