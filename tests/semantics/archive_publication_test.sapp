let A=import("stdlib:secure_archive.sapp");
let P=import("stdlib:archive_publication.sapp");
let OS=import("stdlib:os.sapp");
let root=OS.script_args()[0];
let files=[map{name:"empty/",data:[]},map{name:"binary.bin",data:[0,128,255]},
    map{name:"text.txt",data:str_to_bytes("synthetic archive content")}];
for mode in ["store","fast","auto"] {
    let bytes=A.pack(files,mode); let path=root+"/"+mode+".zip";
    let _result=P.save(path,bytes);
    assert(_result.ok and _result.written and _result.publication_confirmed
        and _result.atomic_visibility and _result.durability_verified
        and _result.wrapper_handles_closed and not _result.partial_output_possible,"complete new archive");
    assert(fs_read_bytes(path)==bytes,"byte exact publication");
    assert(A.inspect(fs_read_bytes(path)).verified,"actual roundtrip inspection");
    assert(A.unpack(fs_read_bytes(path))[1].data==[0,128,255],"binary roundtrip");
    let again=P.save(path,bytes);
    assert(not again.ok and again.publication_attempted and again.output_may_exist
        and not again.publication_confirmed and not map_has(again,"written"),"collision uncertainty");
    assert(fs_read_bytes(path)==bytes,"existing archive preserved");
    for _private in [root,"binary.bin","text.txt","synthetic archive content","/proc/"] {
        if str_contains(json_stringify(_result)+json_stringify(again),_private) { throw "private metadata disclosed"; }
    }
}
let valid=A.pack([map{name:"a",data:[1,2,3]}],"store");
let corrupt=slice(valid,0,len(valid)); corrupt[31]=99;
for invalid in [nil,"zip",[],[256],[1.5],corrupt,slice(valid,0,len(valid)-1)] {
    let _result=P.save(root+"/invalid.zip",invalid);
    assert(not _result.ok and not _result.publication_attempted and not _result.written
        and _result.code=="invalid_archive","malformed fails before filesystem");
}
for options in [map{unknown:true},map{max_total_bytes:2},map{max_file_bytes:2},map{max_entries:0}] {
    let _result=P.save(root+"/invalid.zip",valid,options);
    assert(_result.code=="invalid_archive" and not _result.ok and not _result.publication_attempted,"limit validation before effects");
}
for path in [nil,"",root+"/bad.txt",root+"/nul"+strfromcharcode(0)+".zip",root+"/a\\b.zip"] {
    assert(P.save(path,valid).code=="invalid_output","output validation");
}
let _absent=P.save(root+"/missing/new.zip",valid);
assert(_absent.code=="parent_unavailable" and not _absent.ok and not _absent.publication_attempted,"no implicit parent creation");
assert(not fs_exists(root+"/invalid.zip") and not fs_exists(root+"/missing"),"rejection leaves namespace unchanged");
let empty=P.save(root+"/empty.zip",A.pack([],"store"));
assert(empty.ok and len(A.inspect(fs_read_bytes(root+"/empty.zip")).entries)==0,"empty ZIP is valid nonempty bytes");
print "archive_publication_pass";
