// tests/semantics/logic_enrich_test.sapp — enrichment for stdlib/logic.sapp
// Adds count, facts_of, retract, distinct, select_one to the Datalog engine.

let logic = import("stdlib/logic.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let db = logic.db();
logic.fact(db, "parent", ["tom", "bob"]);
logic.fact(db, "parent", ["bob", "ann"]);

let pq = logic.pred("parent", [logic.var("x"), logic.var("y")]);

// ── base query still works ───────────────────────────────────────────────────────
eq(len(logic.query(db, pq)), 2, "query returns both facts");

// ── ENRICH: count + facts_of ─────────────────────────────────────────────────────
eq(logic.count(db, pq), 2, "count");
eq(len(logic.facts_of(db, "parent")), 2, "facts_of lists facts");

// ── ENRICH: distinct on select results ───────────────────────────────────────────
logic.fact(db, "color", ["red"]);
logic.fact(db, "color", ["red"]);
let crows = logic.query(db, logic.pred("color", [logic.var("c")]));
eq(len(logic.distinct(logic.select(crows, [logic.var("c")]))), 1, "distinct dedupes");

// ── ENRICH: select_one (single column) ───────────────────────────────────────────
let xs = logic.select_one(logic.query(db, pq), logic.var("x"));
eq(len(xs), 2, "select_one count");

// ── ENRICH: retract removes a fact ───────────────────────────────────────────────
logic.retract(db, "parent", ["tom", "bob"]);
eq(logic.count(db, pq), 1, "retract removed one fact");

print "logic_enrich_pass";
