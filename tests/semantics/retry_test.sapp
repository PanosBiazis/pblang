// tests/semantics/retry_test.sapp — generic retry-with-backoff library.

let R = import("stdlib/retry.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── succeeds on the 3rd attempt ────────────────────────────────────────────────────
let calls = [0];
fn worker() {
    calls[0] = calls[0] + 1;
    if calls[0] < 3 { error("transient"); }
    return 42;
}
let r = R.run(worker, map{ attempts: 5, delay_ms: 0 });
if not r.ok { fail("should eventually succeed"); }
eq(r.value, 42, "returns the success value");
eq(r.attempts, 3, "took 3 attempts");

// ── exhausts the budget on a permanent failure ────────────────────────────────────
fn always_fail() { error("nope"); }
let f = R.run(always_fail, map{ attempts: 3, delay_ms: 0 });
eq(f.ok, false, "gives up");
eq(f.attempts, 3, "used all attempts");
eq(f.status, "exhausted", "exhaustion has a structured status");

// ── nil is a valid success value (not treated as failure) ─────────────────────────
fn returns_nil() { return nil; }
let n = R.run(returns_nil, map{ attempts: 4 });
eq(n.ok, true, "nil return is success");
eq(n.attempts, 1, "succeeded first try");

// ── run_or returns the fallback on failure ────────────────────────────────────────
eq(R.run_or(always_fail, map{ attempts: 2 }, "fallback"), "fallback", "run_or fallback");

// Unsafe values are normalized and the exponential schedule is capped.
let p = R.plan(map{ attempts: 1000000, delay_ms: 1000000, backoff: 1000, max_delay_ms: 120000 });
eq(p.max_attempts, 100, "attempt count is capped");
eq(p.base_delay_ms, 60000, "base delay is capped");
eq(p.multiplier, 16, "multiplier is capped");
let sched = R.schedule(map{ attempts: 4, delay_ms: 10, backoff: 2, max_delay_ms: 25 });
eq(len(sched.delays_ms), 3, "schedule has one delay between attempts");
eq(sched.delays_ms[0], 10, "first delay");
eq(sched.delays_ms[1], 20, "second delay");
eq(sched.delays_ms[2], 25, "schedule obeys max delay");

print "retry_pass";
