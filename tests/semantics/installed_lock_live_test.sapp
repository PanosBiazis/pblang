// Linux retained-runtime integration; all files belong to this disposable fixture.
if platform()!="linux" {print "installed_lock_live_skip_linux_required";os_exit(0);}
let L=import("stdlib:portable_lock.sapp");let U=import("stdlib:uuid.sapp");
let exe=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let root=path_join(cwd(),"target/installed-lock-"+U.v4());
let project=path_join(root,"installed");let caller=path_join(root,"caller");let moved=path_join(root,"moved");
let step=["setup"];
fn child(at,args) {
    let argv=["-k","1s","15s","/usr/bin/env","-C",at,exe];
    for arg in args {push(argv,arg);}
    return proc_spawn_wait("/usr/bin/timeout",argv);
}
fn execute(at,project_root) {return child(at,["run",path_join(project_root,"main.sapp"),"--allow-import","--deny-fs","--deny-exec","--deny-net","--deny-ffi"]);}
fn exercise() {
    fs_mkdirs(path_join(project,"stdlib"));fs_mkdirs(caller);
    fs_write(path_join(project,"pblang.toml"),"[package]\nname = \"installed-lock-fixture\"\nversion = \"0.1.0\"\nentry = \"main.sapp\"\n[dependencies]\nstdlib = { path = \"stdlib\" }\n");
    fs_write(path_join(project,"main.sapp"),"let m=import(\"stdlib:probe.sapp\");print m.value();");
    fs_write(path_join(project,"stdlib/probe.sapp"),"fn value(){return 7;}export value;");
    step[0]="build fixture";let built=child(project,["build","."]);assert(built.exit_code==0,"fixture build");
    L.publish(project);let portable=fs_read(path_join(project,"pblang.lock"));
    step[0]="reproduce unrelated cwd";let result=execute(caller,project);
    assert(result.exit_code!=0 and str_contains(result.stderr,"dependency path not found"),"relative retained lock fails from unrelated cwd");
    fs_mkdirs(path_join(caller,"stdlib"));
    fs_write(path_join(caller,"stdlib/probe.sapp"),"print \"DECOY_EXECUTED\";fn value(){return 99;}export value;");
    step[0]="materialize CLI";
    let command=["run","tools/pblock_install.sapp","--allow-all","--",project];
    result=child(cwd(),command);
    assert(result.exit_code==0 and not str_contains(result.stdout,root),"CLI materializes without logging local root");
    let installed=L.install(project);
    assert(installed.ok and installed.format=="pblang.installed-lock.v1","installed local metadata");
    let installed_text=fs_read(path_join(project,"pblang.lock"));
    assert(L.normalize_text(fs_read(path_join(project,"pblang.toml")),installed_text,project).text==portable,"all hash metadata retained");
    step[0]="CLI argument refusal";
    for args in [["run","tools/pblock_install.sapp","--allow-all"],
        ["run","tools/pblock_install.sapp","--allow-all","--",project,"extra"]] {
        assert(child(cwd(),args).exit_code!=0,"invalid CLI arity rejected");
        assert(fs_read(path_join(project,"pblang.lock"))==installed_text,"CLI refusal preserves installed lock");
    }
    step[0]="foreign cwd and caller decoy";result=execute(caller,project);

    assert(result.exit_code==0 and result.stdout=="7\n","installed dependency selected from unrelated cwd");
    let sandboxed=child(caller,["run",path_join(project,"main.sapp"),"--sandbox"]);
    assert(sandboxed.exit_code!=0 and str_contains(sandboxed.stderr,"import access denied"),"lock does not grant import capability");
    step[0]="tamper rejected";fs_write(path_join(project,"stdlib/probe.sapp"),"print \"TAMPER_EXECUTED\";fn value(){return 8;}export value;");
    result=execute(caller,project);
    assert(result.exit_code!=0 and not str_contains(result.stdout,"TAMPER_EXECUTED"),"content integrity still enforced");
    fs_write(path_join(project,"stdlib/probe.sapp"),"fn value(){return 7;}export value;");
    step[0]="publication and relocation";L.publish(project);fs_rename(project,moved);L.install(moved);
    result=execute(caller,moved);assert(result.exit_code==0 and result.stdout=="7\n","re-materialize portable release after relocation");
    step[0]="symlink refusal";L.publish(moved);let before=fs_read(path_join(moved,"pblang.lock"));
    fs_rename(path_join(moved,"stdlib"),path_join(moved,"actual-stdlib"));
    assert(proc_spawn_wait("/usr/bin/ln",["-s","actual-stdlib",path_join(moved,"stdlib")]).exit_code==0,"fixture symlink");
    assert(try {L.install(moved);false} catch true,"symlink dependency refused");
    assert(fs_read(path_join(moved,"pblang.lock"))==before,"refusal preserves lock bytes");
    fs_remove(path_join(moved,"stdlib"));fs_rename(path_join(moved,"actual-stdlib"),path_join(moved,"stdlib"));
}
let passed=try {exercise();true} catch false;
// Remove only the uniquely named fixture owned by this test.
let removed=proc_spawn_wait("/bin/rm",["-rf","--",root]);
assert(passed,"installed lock integration: "+step[0]);assert(removed.exit_code==0,"fixture cleanup");
print "installed_lock_live_pass";
