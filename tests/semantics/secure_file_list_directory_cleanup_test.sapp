// Counted resource-free backend; tests list_directory root ownership, single
// close, exception redaction, reply validation and admission boundaries.
fn _assert_result(result, B, close_mode, expected, open_abs) {
    let expected_abs = if open_abs { 1 } else { 0 };
    let expected_rel = if open_abs { 0 } else { 1 };
    assert(B.state.opens == expected_rel and B.state.open_absolutes == expected_abs
        and B.state.lists == 1 and B.state.closes == 1,
        "acquired root receives exactly one list and one close attempt");
    if close_mode != "success" {
        assert(not result.ok and result.cleanup_uncertain
            and not result.root_close_confirmed and len(map_keys(result)) == 4,
            "fixed cleanup uncertainty result");
        assert(result.error == "secure directory root cleanup could not be verified",
            "fixed root close diagnostic");
    } elif expected == "normal" {
        assert(result.ok and not result.truncated
            and json_stringify(result.entries) == json_stringify(["alpha.sapp", "beta.sapp"]),
            "normal listing preserved");
    } elif expected == "empty" {
        assert(result.ok and not result.truncated and len(result.entries) == 0,
            "empty listing preserved");
    } elif expected == "truncated" {
        assert(result.ok and result.truncated
            and json_stringify(result.entries) == json_stringify(["a", "b", "c", "d"]),
            "truncated listing preserved");
    } elif expected == "extra_fields" {
        assert(result.ok and not result.truncated and result.descriptor_bound
            and result.race_resistant and json_stringify(result.entries) == json_stringify(["x"]),
            "backend metadata fields preserved on valid listing");
    } elif expected == "backend_failure" {
        assert(not result.ok and result.error == "synthetic listing failure"
            and result.marker == 11, "backend error map retained after confirmed close");
    } elif expected == "throw" {
        assert(not result.ok and result.error == "secure directory listing backend failed",
            "backend exception redacted after confirmed close");
    } else {
        assert(not result.ok and result.error == "secure directory listing result is invalid",
            "malformed backend listing rejected");
    }
    if not result.ok {
        assert(not map_has(result, "entries"), "no entries exposed on rejected listing");
    }
    assert(not str_contains(json_stringify(result), "synthetic-private-value"),
        "thrown value never escapes");
}

fn run(S, B) {
    let cases = 0;
    let closes = ["success", "false", "nil", "number", "map", "throw"];
    let list_cases = [
        ["normal", "normal"],
        ["empty", "empty"],
        ["truncated", "truncated"],
        ["extra_fields", "extra_fields"],
        ["failure", "backend_failure"],
        ["throw", "throw"],
        ["nil", "invalid"],
        ["bad_ok", "invalid"],
        ["bad_entries", "invalid"],
        ["bad_entry", "invalid"],
        ["oversize_entries", "invalid"],
        ["missing_truncated", "invalid"],
        ["bad_truncated", "invalid"]
    ];
    for open_abs in [false, true] {
        let target = if open_abs { "/owned/root" } else { "owned/root" };
        for item in list_cases {
            for close_mode in closes {
                B.configure(item[0], close_mode);
                _assert_result(S.list_directory(target, 4), B, close_mode, item[1], open_abs);
                cases = cases + 1;
            }
        }
    }
    B.configure("normal", "success");
    for invalid_limit in [0, -1, 1.5, 4097, "4", nil,
                          parse_number("NaN"), parse_number("Infinity"), parse_number("-Infinity")] {
        if S.list_directory("owned/root", invalid_limit).ok { throw "invalid max_entries accepted"; }
    }
    for invalid_path in ["", "a" + strfromcharcode(0) + "b", 123, nil] {
        if S.list_directory(invalid_path, 4).ok { throw "invalid path accepted"; }
    }
    assert(B.state.opens == 0 and B.state.open_absolutes == 0
        and B.state.lists == 0 and B.state.closes == 0,
        "invalid admission arguments acquire nothing");
    for open_mode in ["false", "nil", "bad_ok"] {
        B.configure("normal", "success");
        B.state.open_mode = open_mode;
        let denied = S.list_directory("owned/root", 4);
        assert(not denied.ok and denied.error == "secure directory root is unavailable",
            "unacquired root rejected");
        assert(B.state.opens == 1 and B.state.lists == 0 and B.state.closes == 0,
            "unacquired root never closed");
    }
    return map{ ok: true, matrix_cases: cases, admission_cases: 16 };
}

export run;
