// Real generated-code regressions: sequencing, single evaluation, expression
// results, nested stores and preservation of checked array writes.
let C = import("stdlib:compiler/ctranspile.sapp");
let kernel=C.transpile_kernel("fn kmain(){while 1 {hlt();}}");
assert(str_contains(kernel,"_kstack[65536] __attribute__((used))"),"assembly-only boot stack retained under optimization");
let cc = C.find_c_compiler();
assert(cc != nil, "C compiler required for store regression test");
let cases = [
    map{source:"let order=0; let a=[10,20]; fn target(){order=order*10+1;return a;} fn slot(){order=order*10+2;return 0;} fn value(){order=order*10+3;return 42;} target()[slot()]=value(); print order; print a[0];", expected:"123\n42\n"},
    map{source:"let order=0; let a=[10]; fn target(){order=order*10+1;return a;} fn slot(){order=order*10+2;return 0;} fn value(){order=order*10+3;return 42;} print (target()[slot()]=value()); print order; print a[0];", expected:"42\n123\n42\n"},
    map{source:"let a=[1]; let b=[2]; let x=(a[0]=(b[0]=9)); print x; print a[0]; print b[0];",expected:"9\n9\n9\n"},
    map{source:"let a=[1]; let saved=a; fn replace(){a=[2,3];return 7;} a[0]=replace(); print saved[0]; print a[0];",expected:"7\n2\n"},
    map{source:"let order=0; let m=map{x:1}; fn target(){order=order*10+1;return m;} fn value(){order=order*10+2;return 6;} let n=(target().x=value()); print order; print n; print m.x;",expected:"12\n6\n6\n"},
    map{source:"let order=0; let m=map{x:1}; fn target(){order=order*10+1;return m;} fn value(){order=order*10+2;return 6;} target().x=value(); print order; print m.x;",expected:"12\n6\n"},
    map{source:"fn work(){let _pb_store_0_object=[1];let _pb_store_0_value=8;let _pb_store_1_index=0;print (_pb_store_0_object[_pb_store_1_index]=_pb_store_0_value);print _pb_store_0_object[0];} work();",expected:"8\n8\n"},
    map{source:"let a=[1,2]; print (a[3%2]=19); print a[1];",expected:"19\n19\n"}
];
let passed=0;
for numeric in ["float","integer"] {
    for item in cases {
        let r=C.run_program(item.source,map{compiler:cc,numeric:numeric,profile:"portable",timeout_ms:5000});
        assert(r.ok,"store executable succeeds");assert(r.stdout==item.expected,"store result/order preserved");
        passed=passed+1;
    }
    for source in ["let a=[1]; print (a[-1]=9);", "let a=[1]; print (a[1]=9);",
        "let a=[1]; print (a[5%2]=9);", "let a=[1]; fn bad(){return 2;} print (a[bad()]=9);",
        "let a=[1]; fn bad(){return -1;} a[bad()]=9;"] {
        let r=C.run_program(source,map{compiler:cc,numeric:numeric,profile:"portable",timeout_ms:5000});
        assert(not r.ok and r.exit_code==74,"invalid store rejected by bounds check");passed=passed+1;
    }
}
let fractional=C.run_program("let a=[1]; print (a[0.5]=9);",map{compiler:cc,profile:"portable",timeout_ms:5000});
assert(not fractional.ok and fractional.exit_code==74,"fractional float index rejected");
print "ctranspile_store_pass: " + str(passed+1) + " native cases";
