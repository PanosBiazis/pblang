// Pure-pblang tree-interpreter call/return regression coverage.
let I = import("stdlib/compiler/interp.sapp");
let T = import("stdlib/compiler/tokenizer.sapp");
let P = import("stdlib/compiler/parser.sapp");

fn run(src, label) {
    let ok = try I.eval_program(src) catch false;
    if ok != true { throw "FAIL interp-runtime: " + label; }
}

run("fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } if fib(10) != 55 { missing(); }", "recursion");
run("fn nothing() { return nil; } if nothing() != nil { missing(); }", "return nil");
run("fn values() { return [3, 7]; } if values()[1] != 7 { missing(); }", "return array");
run("fn record() { return map{x: 9}; } if record().x != 9 { missing(); }", "return map");
run("fn outer(x) { return fn(y) { return x + y; }; } let add4 = outer(4); if add4(6) != 10 { missing(); }", "closure metadata");
run("fn from_while() { while true { return 12; } } if from_while() != 12 { missing(); }", "while propagation");
run("fn from_for() { for i 5 { if i == 3 { return i; } } return -1; } if from_for() != 3 { missing(); }", "for propagation");
run("fn nested(v) { if true { let x = v; if true { let y = x + 1; return y; } } return -1; } if nested(41) != 42 { missing(); }", "return through nested lexical scopes");
run("fn nested_nil() { if true { let x = 1; return nil; } return 7; } if nested_nil() != nil { missing(); }", "nil return through lexical scope");
run("fn scoped_if() { let x = 5; if true { let x = 9; } return x; } if scoped_if() != 5 { missing(); }", "cached if scope preserves shadowing");
run("fn scoped_while() { let i = 0; let total = 0; while i < 3 { let local = i; total = total + local; i = i + 1; } return total; } if scoped_while() != 3 { missing(); }", "cached while scope preserves bindings");
run("fn zero() { return 8; } if zero() != 8 { missing(); }", "zero-arg fast path");
run("fn partial(a, b) { if b != nil { missing(); } return a; } if partial(6) != 6 { missing(); }", "one-arg missing parameter");
run("fn gcd(a, b) { if b == 0 { return a; } return gcd(b, a % b); } if gcd(1071, 462) != 21 { missing(); }", "two-arg recursion");
run("fn partial2(a, b, c) { if c != nil { missing(); } return a + b; } if partial2(4, 5) != 9 { missing(); }", "two-arg missing parameter");
run("fn first(a) { return a; } if first(7, 99) != 7 { missing(); }", "two-arg extra parameter");
run("let a = [1, 2]; if len(a) != 2 { missing(); } push(a, 7); if len(a) != 3 or a[2] != 7 { missing(); }", "scalar builtin dispatch");
run("let m = map{x: 4}; if not map_has(m, \"x\") or map_has(m, \"y\") { missing(); } if str_starts_with(\"pblang\", \"pb\") != true { missing(); }", "scalar map and string builtins");
run("let f = fn(x) { return x; }; fn change() { f = fn(x) { return x + 10; }; return 1; } if f(change()) != 11 { missing(); }", "argument-before-callee order");

let prepared = I.compile_program("fn add(a, b) { return a + b; } if add(8, 9) != 17 { missing(); }");
if I.eval_ast(prepared) != true or I.eval_ast(prepared) != true { throw "FAIL interp-runtime: reusable AST"; }
if prepared.stmts[0].kind != "fn" or prepared.stmts[1].kind != "if" {
    throw "FAIL interp-runtime: public AST kinds changed";
}
if not map_has(prepared.stmts[1], "@it") or prepared.stmts[1]["@itd"] != false {
    throw "FAIL interp-runtime: prepared if block metadata missing";
}
if prepared.stmts[1]["@inf"] != true {
    throw "FAIL interp-runtime: guard-only if metadata missing";
}
let fallback_prepared = I.compile_program("if false { missing(); } else { let ok = 1; }");
if fallback_prepared.stmts[0]["@inf"] != false {
    throw "FAIL interp-runtime: fallback if marked as guard-only";
}
let scoped_prepared = I.compile_program("let i = 0; while i < 1 { let local = i; i = i + 1; }");
if not map_has(scoped_prepared.stmts[1], "@wb") or scoped_prepared.stmts[1]["@wd"] != true {
    throw "FAIL interp-runtime: prepared while block metadata missing";
}
let raw_ast = P.parse(T.tokenize("fn twice(n) { return n * 2; } if twice(21) != 42 { missing(); }"));
if I.eval_ast(raw_ast) != true or I.eval_ast(raw_ast) != true {
    throw "FAIL interp-runtime: raw parser AST preparation";
}
let invalid_ast = try I.eval_ast(map{}) catch "caught";
if invalid_ast != "caught" { throw "FAIL interp-runtime: invalid AST accepted"; }

let forged_closure = try I.eval_program("let f = [9173]; f();") catch "caught";
if forged_closure != "caught" { throw "FAIL interp-runtime: malformed closure accepted"; }

print "interp_runtime_pass";
