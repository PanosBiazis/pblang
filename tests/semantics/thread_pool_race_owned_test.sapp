let P=import("stdlib:thread_pool.sapp");
fn task(ms,value) {return fn(){sleep_ms(ms);return value;};}
let result=P.race_owned([task(0,nil),task(250,9)],1000);
let pending=not result.handles[1].__resolved;
P.settle_race(result);
assert(result.ready and result.status=="ready" and result.value==nil and result.index==0,"nil success is explicit");
assert(pending,"loser ownership returned before settlement");
for handle in result.handles {assert(handle.__resolved,"all owned handles settled");}
assert(P.settle_race(result)==result,"repeat settlement");
let timeout=P.race_owned([task(100,7)],0);
P.settle_race(timeout);
assert(not timeout.ready and timeout.status=="timeout" and timeout.index==nil,"zero deadline");
assert(timeout.handles[0].__resolved,"timeout still owns worker");
let failed=P.race_owned([fn(){throw "private-task-detail";}],1000);
P.settle_race(failed);
assert(not failed.ready and failed.status=="failed","all failures finish");
let good=P.race_owned([fn(){throw "failed";},task(20,false)],1000);
P.settle_race(good);
assert(good.ready and good.index==1 and good.value==false,"first success after failure");
let empty=P.race_owned([],nil);
assert(empty.status=="empty" and len(empty.handles)==0,"empty does not wait");
for duration in [-1,0.5,true,"5",num_exp(1000),num_sqrt(-1),2147483648] {
    assert((try {P.race_owned([],duration);false} catch true),"invalid duration even on empty input");
}
for tasks in [nil,false,"x",map{}] {
    assert((try {P.race_owned(tasks,0);false} catch true),"invalid task collection");
}
let too_many=[];for i 65 {array_push(too_many,fn(){return 1;});}
assert((try {P.race_owned(too_many,0);false} catch true),"bounded launch count");
print "thread_pool_race_owned_pass";
