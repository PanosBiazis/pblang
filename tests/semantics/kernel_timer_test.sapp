// Test: the PIT timer driver (stdlib/kernel/timer.sapp) + hardware IRQ0, §76.
//
// timer.sapp programs the 8253 PIT (channel 0 -> IRQ0), the heartbeat for preemptive
// scheduling and timekeeping. Combined with the §72 IDT primitives and the §73 integer
// codegen mode, a kernel can take a REAL asynchronous hardware interrupt. Proven END-
// TO-END in QEMU: install isr_timer on vector 0x20, pit_init, sti, then spin in hlt
// until the timer ISR has run (no software `int`, no input — the PIT fires on its own)
// -> exit 85. We assert the codegen contract here (the boot can't run in the runner).

let ct = import("stdlib/compiler/ctranspile.sapp");
let intr = fs_read("stdlib/kernel/interrupts.sapp");
let timer = fs_read("stdlib/kernel/timer.sapp");

let src = "fn isr_timer() { poke32(36864, peek32(36864) + 1); pic_eoi(); } "
    + "fn kmain() { let idt = kmalloc(2048); pic_remap(); "
    + "idt_set_gate(idt, 32, addr_of(\"isr_timer\"), 8, 142); idt_load(idt); "
    + "pit_init(1193); sti(); while peek32(36864) == 0 { hlt(); } "
    + "outb(244, 42); while 1 > 0 { hlt(); } }";

let c = ct.transpile_kernel_int(intr + timer + src);

// ── PIT programming ─────────────────────────────────────────────────────────────────
assert(str_contains(c, "long pit_init(long divisor)"), "pit_init transpiled");
assert(str_contains(c, "outb(67, 54)"), "PIT command register 0x43 <- 0x36 (ch0, mode 3)");
assert(str_contains(c, "outb(64,"), "PIT divisor written to channel-0 data port 0x40");

// ── The timer handler is a real interrupt routine on the proven IRQ path ─────────────
assert(str_contains(c, "__attribute__((interrupt)) void isr_timer(void* _frame)"), "isr_timer is a GCC interrupt handler");
assert(str_contains(c, "(long)(u64)&isr_timer"), "installed via addr_of into an IDT gate");
assert(str_contains(c, "outb(32, 32)"), "handler sends EOI so the next IRQ can arrive");
assert(not str_contains(c, "double"), "float-runtime-free (boots under -mgeneral-regs-only)");
assert(str_contains(c, "0x1BADB002"), "multiboot header present");

print "kernel_timer_pass";
