// Test: uuid.sapp module
import "stdlib:uuid.sapp";

// v4 generates a string
let u = uuid.v4();
if type(u) != "string" { print "FAIL v4 type"; }
if len(u) != 36 { print "FAIL v4 length: " + str(len(u)); }

// is_valid
if uuid.is_valid(u) == false { print "FAIL is_valid generated"; }
if uuid.is_valid("not-a-uuid") != false { print "FAIL is_valid bad"; }
if uuid.is_valid("00000000-0000-0000-0000-000000000000") == false { print "FAIL is_valid nil uuid"; }

// nil_uuid
let n = uuid.nil_uuid();
if n != "00000000-0000-0000-0000-000000000000" { print "FAIL nil_uuid"; }

// Two v4 UUIDs should be different (with overwhelming probability)
let u2 = uuid.v4();
if u == u2 { print "FAIL two UUIDs identical (collision)"; }

// Hyphens at correct positions
if str_slice(u, 8, 9) != "-" { print "FAIL hyphen pos 8"; }
if str_slice(u, 13, 14) != "-" { print "FAIL hyphen pos 13"; }
if str_slice(u, 18, 19) != "-" { print "FAIL hyphen pos 18"; }
if str_slice(u, 23, 24) != "-" { print "FAIL hyphen pos 23"; }

print "uuid_stdlib_pass";
