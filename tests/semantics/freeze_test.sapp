let FREEZE = import("stdlib:freeze.sapp");

fn fail(message) { throw "FAIL freeze: " + message; }
fn require(value, message) { if value != true { fail(message); } }

let root = "build/test-freeze-" + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 16);
fs_mkdirs(root);
let lib = root + "/lib.sapp";
let main = root + "/main.sapp";
let artifact = root + "/app.pbck";
fs_write(lib, "fn square(x) { return x * x; } export square;");
fs_write(main, "let L = import(\"./lib.sapp\"); print L.square(9) + 1;");

let result = FREEZE.build(main, artifact);
require(result.ok, "build failed at " + str(try result.stage catch "unknown") + ": " + str(try result.error catch ""));
require(result.modules == 1 and result.bytes > 5 and len(result.sha256) == 64, "invalid build report");
let bytes = fs_read_bytes(artifact);
require(bytes[0] == 80 and bytes[1] == 66 and bytes[2] == 67 and bytes[3] == 75, "invalid PBCK magic");
let run = proc_spawn_wait("./target/release/pblang", ["run", artifact, "--allow-all"]);
require(run.exit_code == 0 and str_trim(run.stdout) == "82", "frozen artifact execution mismatch: " + run.stderr);

fs_remove(lib); fs_remove(main); fs_remove(artifact); fs_remove(root);
print "freeze_pass";
