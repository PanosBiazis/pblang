let UI=import("stdlib:modern_ui.sapp");
let Web=import("stdlib:modern_ui_web.sapp");
let Android=import("stdlib:modern_ui_android.sapp");
let original=UI.screen([UI.image(nil,map{name:"photo",src:"./sample.svg",accessibility_label:"Sample"})]);
let plain=Web.generate("Image",UI.compile(original,map{target:"web"}));
assert(not str_contains(plain.css,"object-position:center"),"absent option preserves original Web rules");
let android=Android.activity_class(UI.compile(original,map{target:"android"}));
for fit in ["contain","cover","stretch"] {
    let view=UI.screen([UI.image(nil,map{name:"photo",src:"./sample.svg",accessibility_label:"Sample",fit:fit,h:120})]);
    let web=Web.generate("Image",UI.compile(view,map{target:"web"}));
    let css_fit=if fit=="stretch" {"fill"} else {fit};
    assert(str_contains(web.css,"img.pb-image.pb-n-2{object-fit:"+css_fit+";object-position:center;min-height:0px;height:120px;}"),"explicit fit overrides base img CSS specificity");
    assert(web.html==plain.html,"image source and accessibility retained");
    let fitted=UI.screen([UI.image(nil,map{name:"photo",src:"./sample.svg",accessibility_label:"Sample",fit:fit})]);
    assert(Android.activity_class(UI.compile(fitted,map{target:"android"}))==android,"Android placeholder generation remains unchanged");
    for target in UI.targets() {
        let a=UI.compile(original,map{target:target});let b=UI.compile(fitted,map{target:target});
        assert(a.executable==b.executable and a.adapter==b.adapter,"platform capability claims unchanged");
        assert(b.records[0].source.fit==fit,"portable tree carries fit to adapters");
    }
}
let bundle=UI.compile(original,map{target:"web"});bundle.view.children[0].fit="invalid";
assert((try Web.generate("Invalid",bundle) catch nil)==nil,"changed fit is revalidated at rendering");
print "modern_ui_image_fit_pass";
