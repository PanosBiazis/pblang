// tests/semantics/memory_safety_enrich_test.sapp — enrichment for stdlib/memory_safety.sapp
// Adds Rust mem-style ops on owned values: replace, take, swap, map_owned.

let mem = import("stdlib/memory_safety.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base own/read/write still works ──────────────────────────────────────────────
let a = mem.own(10);
eq(mem.read(a), 10, "own/read");

// ── ENRICH: replace returns the OLD value, stores the new ─────────────────────────
eq(mem.replace(a, 20), 10, "replace returns old value");
eq(mem.read(a), 20, "replace stored new value");

// ── ENRICH: take returns old and leaves nil ──────────────────────────────────────
eq(mem.take(a), 20, "take returns old value");
eq(mem.read(a), nil, "take leaves nil");

// ── ENRICH: swap exchanges two owned values ──────────────────────────────────────
let x = mem.own(1);
let y = mem.own(2);
mem.swap(x, y);
eq(mem.read(x), 2, "swap x"); eq(mem.read(y), 1, "swap y");

// ── ENRICH: map_owned transforms in place ────────────────────────────────────────
let z = mem.own(5);
eq(mem.map_owned(z, fn(v) { return v * 10; }), 50, "map_owned returns new value");
eq(mem.read(z), 50, "map_owned stored result");

mem.drop(a); mem.drop(x); mem.drop(y); mem.drop(z);
print "memory_safety_enrich_pass";
