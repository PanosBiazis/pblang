// tests/semantics/tensor_enrich_test.sapp — fix + enrichment for stdlib/tensor.sapp
//
// FIX: sub/mul had no interpreter fallback (only add/scale did) — they returned an
//   error if the native path was unavailable; now they fall back like add.
// ENRICH: full, eye, flatten, equals_approx, map_elements, add_scalar.

let T = import("stdlib/tensor.sapp");

fn fail(m) { throw "FAIL " + m; }
fn dataeq(t, want, m) {
    let d = t["data"];
    if len(d) != len(want) { fail(m + " len " + str(len(d)) + " : " + str(d)); }
    let i = 0; while i < len(d) { if num_abs(d[i] - want[i]) > 0.000001 { fail(m + " @" + str(i) + " : " + str(d)); } i = i + 1; }
}

// ── base + sub/mul produce correct elementwise results ───────────────────────────
let a = T.tensor([2, 2], [3, 4, 5, 6]);
let b = T.tensor([2, 2], [1, 2, 3, 4]);
dataeq(T.add(a, b), [4, 6, 8, 10], "add");
dataeq(T.sub(a, b), [2, 2, 2, 2], "sub (with fallback)");
dataeq(T.mul(a, b), [3, 8, 15, 24], "mul (with fallback)");

// ── ENRICH: full / eye ───────────────────────────────────────────────────────────
dataeq(T.full([2, 2], 7), [7, 7, 7, 7], "full");
dataeq(T.eye(2), [1, 0, 0, 1], "eye 2x2 identity");

// ── ENRICH: flatten ──────────────────────────────────────────────────────────────
let f = T.flatten(a);
let sh = f["shape"];
if len(sh) != 1 or sh[0] != 4 { fail("flatten shape should be [4], got " + str(sh)); }

// ── ENRICH: equals_approx ────────────────────────────────────────────────────────
if not T.equals_approx(a, T.tensor([2, 2], [3.0000001, 4, 5, 6]), 0.001) { fail("equals_approx within eps"); }
if T.equals_approx(a, b, 0.001) { fail("equals_approx different tensors"); }

// ── ENRICH: map_elements / add_scalar ────────────────────────────────────────────
dataeq(T.map_elements(a, fn(x) { return x * 10; }), [30, 40, 50, 60], "map_elements");
dataeq(T.add_scalar(a, 1), [4, 5, 6, 7], "add_scalar");

print "tensor_enrich_pass";
