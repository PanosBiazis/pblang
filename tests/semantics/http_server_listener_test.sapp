let HTTP = import("stdlib:http_server.sapp");

fn fail(message) { throw "FAIL http_server_listener: " + message; }
fn truthy(value, message) { if value != true { fail(message); } }

let app = HTTP.app_new();
HTTP.app_get(app, "/health", fn(_req) {
    return HTTP.res_json(200, map{ ok: true, format: "listener-test.v1" });
});

let listener = tcp_listen("127.0.0.1:0");
let address = tcp_local_addr(listener);
let completed = channel();
let worker = spawn(fn() {
    send(completed.sender, HTTP.serve_listener_app(listener, app, 1));
});

let socket = tcp_connect(address);
tcp_write(socket, "GET /health HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
let headers = tcp_read_until(socket, "\r\n\r\n", 8192);
let body = try tcp_read(socket, 8192) catch "";
let response = headers + body;
tcp_close(socket);
if not str_contains(response, " 200 ") or
   not str_contains(response, "listener-test.v1") {
    fail("pre-bound listener response was " + json_stringify(response));
}
truthy(recv_timeout(completed.receiver, 1000) == 1,
       "finite listener worker terminates after its quota");
join(worker);
tcp_close(listener);

truthy((try HTTP.serve_listener_app(listener, app, 0) catch nil) == nil,
       "invalid connection quota is rejected");
print "http_server_listener_pass";
