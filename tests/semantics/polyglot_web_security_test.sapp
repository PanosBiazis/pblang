let WEB = import("stdlib:polyglot_web.sapp");
let SECURE = import("stdlib:secure_file.sapp");

fn fail(message) { throw "FAIL " + message; }
fn eq(actual, expected, message) {
    if actual != expected { fail(message + " got=" + str(actual) + " want=" + str(expected)); }
}

let html = WEB.bundle_html("<main>Hello</main>", "main { color: green; }", "print = 1;");
eq(str_contains(html, "Content-Security-Policy"), true, "bundle includes CSP");
eq(str_contains(html, "connect-src 'none'"), true, "bundle blocks outbound connections");
eq(str_contains(html, "frame-src 'none'"), true, "bundle blocks frames");
eq(str_contains(html, "no-referrer"), true, "bundle suppresses referrer data");
let escaped = WEB.bundle_text_html("<img src=x onerror=alert(1)><script>alert(2)</script>");
eq(str_contains(escaped, "<script>alert"), false, "untrusted text cannot create script markup");
eq(str_contains(escaped, "&lt;script&gt;"), true, "untrusted script text is escaped");
eq(str_contains(escaped, "script-src 'none'"), true, "untrusted text document disables scripts");

let path = WEB.bundle("<p>bounded</p>", "", "");
eq(str_starts_with(path, "/tmp/pblang-web-"), true, "bundle uses randomized temp filename");
eq(str_ends_with(path, ".html"), true, "bundle uses HTML suffix");
let loaded = SECURE.read_text(path, 1048576, false);
eq(loaded.ok, true, "bundle can be read through secure-file API");
eq(str_contains(loaded.text, "<p>bounded</p>"), true, "bundle content retained");

let plan = WEB.browser_plan(path);
if platform() == "linux" {
    eq(plan.ok, true, "Linux browser plan accepted secure local HTML");
    eq(plan.shell_used, false, "browser plan is shell-free");
    eq(plan.launcher_bounded, true, "browser launcher plan is bounded");
    eq(plan.browser_bounded, false, "browser execution is not misreported as bounded");
    eq(plan.identity_bound, false, "path identity limitation is explicit");
    eq(plan.raw_fallback, false, "browser plan has no raw fallback");
} else {
    print "polyglot_web_browser_plan_skip: bounded launcher is Linux-only";
}

eq(WEB.browser_plan("https://example.invalid/").ok, false,
    "browser plan rejects remote URLs");
eq(WEB.browser_plan("/tmp/not-html.txt").ok, false,
    "browser plan rejects non-HTML paths");

if fs_exists("/usr/bin/node") or fs_exists("/bin/node") {
    let result = WEB.js("console.log(JSON.stringify({answer: 42}));");
    eq(result.ok, true, "bounded Node execution succeeds");
    eq(result.bounded, true, "Node execution is supervised");
    eq(result.shell_used, false, "Node execution is shell-free");
    eq(result.sandboxed, false, "Node resource bounds are not mislabeled as a sandbox");
    eq(result.trusted_source_required, true, "Node source trust requirement is explicit");
    eq(str_contains(result.stdout, "42"), true, "Node output returned");
} else {
    print "polyglot_web_node_skip: fixed Node executable unavailable";
}
print "polyglot_web_browser_launcher_not_executed";

let removed = WEB.remove_bundle(path);
eq(removed.ok, true, "temporary bundle removed safely");
print "polyglot_web_security_pass";
