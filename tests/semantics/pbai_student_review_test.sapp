let AI=import("stdlib/pbai.sapp");
fn rejects(f) {return try {f();false} catch true;}
assert(rejects(fn(){throw "expected";}) and not rejects(fn(){return 1;}),"calibrated helper");
let old_train=[map{x:[0],y:4},map{x:[1,0],y:4}];let old_valid=[map{x:[7,0],y:4}];
let teacher=AI.neural_specialist_train([old_train[0]],old_valid);
let parent=AI.neural_specialist_distill(teacher.artifact,[[0],[1,0]],old_valid).checkpoint();
let encoded=AI.neural_specialist_student_encode(parent);
let history=AI.neural_specialist_student_history(parent,old_train,old_valid);
let history_text=AI.neural_specialist_student_history_encode(parent,history);
let training=[map{x:[2,0],y:4},map{x:[3,0],y:4}];let validation=[map{x:[4,0],y:4}];
let options=map{epochs:16,lr:0.05,max_grad_norm:1};
let reviewed=AI.neural_specialist_student_continue_reviewed(parent,history,training,validation,options);

assert(reviewed.report().passed,"positive review fixture");
assert(reviewed.status().phase=="reviewed" and reviewed.checkpoint().digest==parent.digest,"review does not activate");
let report=reviewed.report();report.passed=false;report.retention.candidate.correct=0;
assert(reviewed.report().passed and reviewed.report().retention.candidate.correct==1,"report is detached");
let accepted=reviewed.accept();assert(accepted.phase=="accepted" and accepted.session_candidate_active,"explicit local accept");
let next=reviewed.checkpoint();let next_history=reviewed.history();
assert(next.digest==reviewed.report().candidate_digest and next_history.checkpoint_digest==next.digest,"accept bound to evaluated export");
assert(next_history.generation==1 and len(next_history.training)==4 and len(next_history.holdout)==2,"history grows without forgetting prefix");
assert(not accepted.globally_activated and not accepted.authorizes_activation and not accepted.persists_weights,"local authority only");
assert(rejects(fn(){reviewed.accept();}) and reviewed.checkpoint().digest==next.digest,"second acceptance preserves active checkpoint");
let loaded=AI.neural_specialist_student_load(next);
assert(json_stringify(loaded.predict([5,0]))==json_stringify(reviewed.predict([5,0])),"active weights exactly match serialized evaluation");
assert(json_stringify(AI.neural_specialist_student_history_decode(next,AI.neural_specialist_student_history_encode(next,next_history)))==json_stringify(next_history),"history codec parity");
let rolled=reviewed.rollback();assert(rolled.phase=="rolled-back" and reviewed.checkpoint().digest==parent.digest,"rollback restores parent weights");
assert(AI.neural_specialist_student_history_encode(parent,reviewed.history())==history_text,"rollback restores parent history");
assert(rejects(fn(){reviewed.accept();}) and rejects(fn(){reviewed.rollback();}),"closed rollback terminal state");
// Revised labels may improve the new task while forgetting the old correct answer.
let bad=AI.neural_specialist_student_continue_reviewed(parent,history,[map{x:[2,0],y:5},map{x:[3,0],y:5}],[map{x:[4,0],y:5}],map{epochs:64,lr:0.1,max_grad_norm:1});
assert(bad.report().validation.candidate.loss<bad.report().validation.baseline.loss,"new-task improvement cannot hide forgetting");
assert(bad.report().retention.baseline_correct_regressions==1 and not bad.report().retention_passed,"actual forgotten answer blocks review");
let forged=bad.report();forged.passed=true;forged.retention_passed=true;
assert(rejects(fn(){bad.accept();}) and bad.status().phase=="rejected" and bad.checkpoint().digest==parent.digest,"report mutation cannot authorize rejection");
assert(rejects(fn(){bad.rollback();}) and bad.checkpoint().digest==parent.digest,"failed rollback preserves parent");
// History binding and admission checks happen before any training.
for examples in [old_train,old_valid,training] {
 assert(rejects(fn(){AI.neural_specialist_student_continue_reviewed(parent,history,training,examples,options);}),"historical/current validation overlap");
}
assert(rejects(fn(){AI.neural_specialist_student_continue_reviewed(parent,history,[map{x:[0/(0-1)],y:4}],validation,options);}),"signed zero history identity");
assert(rejects(fn(){AI.neural_specialist_student_continue_reviewed(next,next_history,training,[map{x:[5,0],y:4}],options);}),"accepted history rejects prior training on resume");
assert(rejects(fn(){AI.neural_specialist_student_continue_reviewed(next,next_history,[map{x:[5,0],y:4}],validation,options);}),"accepted holdout never becomes validation again");
assert(rejects(fn(){AI.neural_specialist_student_history_encode(next,history);}),"history cannot bind a different checkpoint");
let detached=AI.neural_specialist_student_history_decode(parent,history_text);detached.holdout[0].y=5;
assert(rejects(fn(){AI.neural_specialist_student_history_encode(parent,detached);}),"history labels are digest bound");
for text in ["", "{}", history_text+"x", "{\"format\":0,\"format\":1}"] {
 assert(rejects(fn(){AI.neural_specialist_student_history_decode(parent,text);}),"strict history decoder");
}
let STR=import("stdlib:strings.sapp");
let duplicate=STR.replace_all(history_text,"\"generation\":0","\"generation\":0,\"generation\":0");
assert(duplicate!=history_text and rejects(fn(){AI.neural_specialist_student_history_decode(parent,duplicate);}),"duplicate valid fields cannot silently collapse");
let huge=str_repeat("x",32769);
assert(rejects(fn(){AI.neural_specialist_student_history_decode(parent,huge);}),"bounded history bytes");
let cyclic=[];push(cyclic,cyclic);
let zero=len([]);
for examples in [nil,[],[map{x:cyclic,y:4}],[map{x:[0],y:0/zero}],[map{x:[0],y:4,extra:true}],[map{x:[0],y:4},map{x:[0/(0-1)],y:4}]] {
 assert(rejects(fn(){AI.neural_specialist_student_history(parent,examples,old_valid);}),"malformed bounded history");
}
assert(rejects(fn(){AI.neural_specialist_student_history(parent,old_train,old_train);}),"historical split overlap");
let no_correct=AI.neural_specialist_student_history(parent,old_train,[map{x:[7,0],y:5}]);
let empty_retention=AI.neural_specialist_student_continue_reviewed(parent,no_correct,training,validation,options);
assert(not empty_retention.report().retention_passed and rejects(fn(){empty_retention.accept();}),"no vacuous retention success");
assert(not reviewed.report().history_complete_verified and not reviewed.report().history_authenticated and not reviewed.report().independent_test,"caller history never becomes certified provenance");
// Independent public-load oracle checks that gate metrics describe the export.
let raw=AI.neural_specialist_student_continue(parent,training,validation,options).checkpoint();
let raw_loaded=AI.neural_specialist_student_load(raw);let parent_loaded=AI.neural_specialist_student_load(parent);
for entry in [[training,"training"],[validation,"validation"],[old_valid,"retention"]] {
 let metrics=reviewed.report()[entry[1]];
 assert(json_stringify(metrics.candidate)==json_stringify(raw_loaded.evaluate(entry[0]).student),"review uses exported candidate metrics");
 assert(json_stringify(metrics.baseline)==json_stringify(parent_loaded.evaluate(entry[0]).student),"review uses exact parent metrics");
}
let relabeled_history=AI.neural_specialist_student_history(parent,old_train,[map{x:[7,0],y:6}]);
let label_independent=AI.neural_specialist_student_continue_reviewed(parent,relabeled_history,training,[map{x:[4,0],y:6}],options);
assert(label_independent.report().candidate_digest==raw.digest,"neither validation nor retention labels alter training");
let resumed=AI.neural_specialist_student_continue_reviewed(next,next_history,[map{x:[5,0],y:4}],[map{x:[6,0],y:4}],options);
assert(resumed.report().declared_holdout_examples==2 and resumed.report().retention.baseline.examples==2,"all accumulated holdouts evaluated on resume");
assert(resumed.report().passed,"positive chained review");resumed.accept();
assert(resumed.history().generation==2 and len(resumed.history().holdout)==3,"accepted chain retains both prior validations");
// Capacity and generation limits are checked before training; no truncation.
let full_train=[];let full_holdout=[];
for i 128 {
 push(full_train,map{x:[0,num_floor(i/64),num_floor(i/8)%8,i%8],y:4});
 push(full_holdout,map{x:[7,num_floor(i/64),num_floor(i/8)%8,i%8],y:4});
}
let full=AI.neural_specialist_student_history(parent,full_train,full_holdout);
let full_text=AI.neural_specialist_student_history_encode(parent,full);
assert(len(AI.neural_specialist_student_history_decode(parent,full_text).training)==128,"maximum codec roundtrip");
assert(rejects(fn(){AI.neural_specialist_student_continue_reviewed(parent,full,training,validation,options);}),"full histories reject growth");
push(full_train,map{x:[1,0,0,0],y:4});
assert(rejects(fn(){AI.neural_specialist_student_history(parent,full_train,old_valid);}),"129 history examples rejected");
let exhausted=AI.neural_specialist_student_history_decode(parent,history_text);exhausted.generation=8;
exhausted.digest=sha256(json_stringify([exhausted.format,exhausted.checkpoint_digest,exhausted.generation,exhausted.training,exhausted.holdout]));
assert(rejects(fn(){AI.neural_specialist_student_continue_reviewed(parent,exhausted,training,validation,options);}),"generation ceiling");
let legacy_bad=AI.neural_specialist_student_history_decode(parent,history_text);legacy_bad.extra=true;
assert(rejects(fn(){AI.neural_specialist_student_history_encode(parent,legacy_bad);}),"unknown history fields rejected");
// Source and output mutations cannot change private acceptance or restoration state.
let private_review=AI.neural_specialist_student_continue_reviewed(parent,history,training,validation,options);
let expected=private_review.report().candidate_digest;
history.training[0].x[0]=6;parent.a[0][0]=999;training[0].y=0;validation[0].y=0;options.epochs=128;
let cp=private_review.checkpoint();cp.a[0][0]=999;let hh=private_review.history();hh.holdout[0].y=0;
private_review.accept();assert(private_review.checkpoint().digest==expected,"private accepted artifact independent of caller mutation");
private_review.rollback();assert(AI.neural_specialist_student_encode(private_review.checkpoint())==encoded,"private original remains restorable");
print "pbai_student_review_pass";
