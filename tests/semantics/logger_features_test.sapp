// tests/semantics/logger_features_test.sapp — lock the logger.sapp wave:
// per-instance levels (new(name, level)), the pure enabled()/format_line()
// surface, child level inheritance, and injection-safe formatting.

let logger = import("stdlib:logger.sapp");
let log = import("stdlib:log.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(s, needle, m) { if str_index_of(s, needle) < 0 { fail(m + " missing '" + needle + "' in: " + s); } }
fn lacks(s, needle, m) { if str_index_of(s, needle) >= 0 { fail(m + " leaked '" + needle + "' in: " + s); } }

logger.set_level("info");

// ── per-instance level overrides the global one ──────────────────────────────
let quiet = logger.new("api", "warn");
eq(quiet.enabled("info"), false, "instance-level warn suppresses info");
eq(quiet.enabled("warn"), true, "instance-level warn allows warn");
eq(quiet.enabled("error"), true, "instance-level warn allows error");

// no instance level → follows the global threshold
let plain = logger.new("web");
eq(plain.enabled("debug"), false, "global info suppresses debug");
eq(plain.enabled("info"), true, "global info allows info");
logger.set_level("error");
eq(plain.enabled("warn"), false, "global change reflected live");
logger.set_level("info");

// ── children inherit the parent's instance level ─────────────────────────────
let sub = quiet.child("db");
eq(sub.name, "api.db", "child name is dotted");
eq(sub.enabled("info"), false, "child inherits parent's warn level");

// ── pure formatter (testable without capturing stdout) ───────────────────────
let line = logger.format_line("api", "warn", "disk almost full");
has(line, "[WARN]", "level tag present");
has(line, "[api]", "logger name present");
has(line, "disk almost full", "message present");

// injection-safe: newline in the message can't forge a second log line
let evil = logger.format_line("api", "info", "x" + str_from_char_code(10) + "[ERROR] forged");
lacks(evil, str_from_char_code(10), "format_line escapes newlines");

// the sanitizer is shared with log.sapp and public there
eq(log.sanitize("a" + str_from_char_code(10) + "b"), "a\\nb", "log.sanitize exported");

print "logger_features_pass";
