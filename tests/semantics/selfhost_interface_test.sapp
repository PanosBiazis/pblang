// Test: the SELF-HOSTED compiler (stdlib/compiler/, written in pblang) now
// understands the `interface` keyword — one step further on the rust→pblang
// migration. The Rust frontend gained structural interfaces in §50; this proves
// the pblang-written tokenizer/parser/codegen/VM chain handles them too.
//
// Drives the self-hosted frontend (frontend_run → compiles via the pblang
// compiler, executes on the pblang VM stdlib/compiler/vm.sapp) and checks that
// `interface` desugars to a working structural-conformance predicate.

let fe = import("stdlib/compiler/selfhost_frontend.sapp");

// An interface with method requirements + a program exercising the predicate.
let src1 = "interface Shape { area(); perimeter(); } "
    + "let circle = map{ area: fn() { return 1; }, perimeter: fn() { return 2; } }; "
    + "let half = map{ area: fn() { return 0; } }; "
    + "let r_full = Shape(circle); "        // true  — has both members
    + "let r_partial = Shape(half); "       // false — missing perimeter
    + "let r_nonmap = Shape(42);";          // false — not a map

let res1 = fe.frontend_run(src1);
assert(res1.ok == true, "self-hosted compile of `interface` program must succeed");
assert(res1.globals["r_full"] == true, "self-hosted: conformer passes Shape()");
assert(res1.globals["r_partial"] == false, "self-hosted: missing member fails Shape()");
assert(res1.globals["r_nonmap"] == false, "self-hosted: non-map fails Shape()");

// Bare members are field requirements; empty interface accepts any map.
let src2 = "interface Point2 { x; y; } interface AnyMap {} "
    + "let p = map{ x: 1, y: 2 }; "
    + "let r_pt = Point2(p); "              // true
    + "let r_missing = Point2(map{ x: 1 }); " // false — no y
    + "let r_any = AnyMap(map{ z: 9 }); "   // true  — empty interface
    + "let r_any_bad = AnyMap(7);";         // false — not a map

let res2 = fe.frontend_run(src2);
assert(res2.ok == true, "self-hosted compile of field-interface program must succeed");
assert(res2.globals["r_pt"] == true, "self-hosted: field requirements satisfied");
assert(res2.globals["r_missing"] == false, "self-hosted: missing field fails");
assert(res2.globals["r_any"] == true, "self-hosted: empty interface accepts a map");
assert(res2.globals["r_any_bad"] == false, "self-hosted: empty interface rejects non-map");

// Interface conformance on a self-hosted CLASS instance: `has_member` walks the
// `__class` method table, so a class instance conforms by its methods. (Self-
// hosted classes instantiate via `C:new(...)` and dispatch via `c:method()`.)
let src3 = "class Acct { fn init(self, b) { self.bal = b; } fn deposit(self, a) { self.bal = self.bal + a; } fn balance(self) { return self.bal; } } "
    + "let acct = Acct:new(100); "
    + "interface Account { deposit(amt); balance(); } "
    + "interface Printable { print_me(); } "
    + "let r_conf = Account(acct); "        // true  — has deposit + balance via __class
    + "let r_noconf = Printable(acct);";    // false — no print_me

let res3 = fe.frontend_run(src3);
assert(res3.ok == true, "self-hosted compile of class+interface program must succeed");
assert(res3.globals["r_conf"] == true, "self-hosted: class instance conforms via __class methods");
assert(res3.globals["r_noconf"] == false, "self-hosted: class instance lacking a method fails");

// The Rust frontend already accepts reserved words as identifiers in bounded
// name contexts. Keep that compatibility for protocol code that names the
// Wayland registry string `interface`.
let src4 = "fn global(name, interface, version) { "
    + "let interface = interface + version; return interface; } "
    + "let r_contextual = global(1, 40, 2);";
let res4 = fe.frontend_run(src4);
assert(res4.ok == true,
    "self-hosted contextual interface identifier must compile");
assert(res4.globals["r_contextual"] == 42,
    "contextual interface parameter, binding and expression agree");

print "selfhost_interface_pass";
