// tests/semantics/networking_websocket_client_test.sapp
//
// networking.sapp now delegates to the canonical stdlib:websocket.sapp instead
// of its old broken re-implementation (hardcoded key, no accept check, raw
// unframed text on the wire). This locks the parts reachable without a socket:
//   - ws_endpoint() scheme/port/path resolution
//   - the send-framing ↔ recv-decoding interoperate at the byte level

let net = import("stdlib:networking.sapp");
let ws = import("stdlib:websocket.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }

// ── ws_endpoint: scheme-default ports, path + query, explicit port ────────────
let e1 = net.ws_endpoint("ws://example.com/chat");
eq(e1.host, "example.com", "ws host");
eq(e1.port, 80, "ws defaults to port 80");
eq(e1.secure, false, "ws is not secure");
eq(e1.path, "/chat", "ws path");

let e2 = net.ws_endpoint("wss://echo.example.com/s?room=1");
eq(e2.port, 443, "wss defaults to port 443");
eq(e2.secure, true, "wss is secure");
eq(e2.path, "/s?room=1", "path carries the query string");

let e3 = net.ws_endpoint("ws://host:8080/");
eq(e3.port, 8080, "explicit port wins");

let e4 = net.ws_endpoint("wss://host.only");
eq(e4.path, "/", "empty path defaults to /");

// ── the enriched control-frame API is exported ────────────────────────────────
truthy(is_fn(net.websocket_send_binary), "send_binary exported");
truthy(is_fn(net.websocket_ping), "ping exported");
truthy(is_fn(net.websocket_pong), "pong exported");

// ── send-framing interoperates with the streaming decoder (no socket) ─────────
// What websocket_send puts on the wire is ws.write_text(msg) (masked); a server
// unmasks+parses via stream_decode. Round-trip must recover the exact message.
let wire = ws.write_text("héllo ⚡");   // non-ASCII to catch UTF-8 framing bugs
let dec = ws.stream_decode(wire);
eq(dec.message, "héllo ⚡", "client-framed text decodes back intact");
eq(dec.consumed, len(wire), "the whole frame is consumed");

// a fragmented + ping-interleaved server stream a client would receive
let stream = [];
let f1 = ws.server_frame_frag(1, "part ", false);
let png = ws.server_ping("keepalive");
let f2 = ws.server_frame_frag(0, "two", true);
let j = 0; while j < len(f1) { array_push(stream, f1[j]); j = j + 1; }
j = 0; while j < len(png) { array_push(stream, png[j]); j = j + 1; }
j = 0; while j < len(f2) { array_push(stream, f2[j]); j = j + 1; }
let d2 = ws.stream_decode(stream);
eq(d2.message, "part two", "server fragments reassemble around a ping");
eq(len(d2.pings), 1, "the interleaved ping is captured for a pong");

print "networking_websocket_client_pass";
