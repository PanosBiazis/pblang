// tests/semantics/registry_plans_test.sapp — registry.sapp half-implementations
// finished, locked as pure PLANS (no spawn/network in this test):
//
//   - install/publish read `token` from the config map, then silently DROPPED
//     it: the CLI only accepts tokens via the PBLANG_REGISTRY_TOKEN env var
//     (SECURITY FIX #28 disabled --registry-token). The plan now carries the
//     env the runner must set (and restore) around proc_spawn_wait.
//   - publish passed `path` as a positional and NEVER passed the registry:
//     the CLI ignores positionals (manifest search starts at CWD) and reads
//     PBLANG_REGISTRY_INDEX from the env. The plan encodes both honestly.
//   - publish's docstring promised {name, version} but never parsed the
//     manifest -> manifest_summary(toml_text).

let reg = import("stdlib:registry.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }

// ── install_plan ─────────────────────────────────────────────────────────────
let ip = reg.install_plan(map{ url: "http://reg.local", token: "sekrit" }, "@s/pkg", "1.2.0");
eq(ip.ok, true, "install plan builds");
eq(ip.cmd, "pblang", "install uses the CLI");
eq(ip.args, ["install", "@s/pkg@1.2.0", "--registry-index", "http://reg.local"],
   "install args carry the registry index");
eq(ip.env["PBLANG_REGISTRY_TOKEN"], "sekrit", "config token rides the env (CLI reads only env)");

let ip2 = reg.install_plan("http://reg.local", "a", "0.1.0");
eq(map_has(ip2.env, "PBLANG_REGISTRY_TOKEN"), false, "string config has no token to set");

let ip3 = reg.install_plan(map{ url: "" }, "a", "0.1.0");
eq(ip3.ok, false, "empty url is a clean error");

// ── publish_plan ─────────────────────────────────────────────────────────────
let pp = reg.publish_plan(map{ url: "http://reg.local", token: "sekrit" }, ".");
eq(pp.ok, true, "publish plan builds");
eq(pp.args, ["publish"], "publish takes NO positional (CLI searches from cwd)");
eq(pp.env["PBLANG_REGISTRY_INDEX"], "http://reg.local", "publish registry rides the env");
eq(pp.env["PBLANG_REGISTRY_TOKEN"], "sekrit", "publish token rides the env");
eq(pp.run_from, ".", "plan states the directory the CLI must run from");

// ── manifest_summary ─────────────────────────────────────────────────────────
let toml = "[package]\nname = \"demo-pkg\"\nversion = \"2.0.1\"\nauthor = \"x\"\n";
let ms = reg.manifest_summary(toml);
eq(ms.name, "demo-pkg", "manifest name parsed");
eq(ms.version, "2.0.1", "manifest version parsed");
let ms2 = reg.manifest_summary("just junk");
eq(ms2.name, "unknown", "missing name -> unknown");
eq(ms2.version, "unknown", "missing version -> unknown");

print "registry_plans_pass";
