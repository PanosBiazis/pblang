let I2C=import("stdlib:linux_i2c.sapp");
fn expect(value,message){if not value{throw "FAIL Linux I2C: "+message;}}
fn rejected(work){return try { work(); false } catch true;}

let closed=0;
let backend=map{
    open:fn(path){return map{ok:true,path:path};},
    capabilities:fn(handle){return map{ok:true,value:196608};},
    probe:fn(handle,address,mode){return map{ok:true,responded:address==16,value:42};},
    close:fn(handle){closed=closed+1;return map{ok:true,closed:true};}
};
let result=I2C.scan_with_backend(2,[17,16],"receive-byte",backend);
expect(result.ok and result.path=="/dev/i2c-2" and result.requested_addresses==[16,17]
    and result.found_addresses==[16] and result.descriptor_closed and closed==1,
    "bounded explicit scan executes and closes the descriptor");
expect(rejected(fn(){I2C.normalize_addresses([]);})
    and rejected(fn(){I2C.normalize_addresses([2]);})
    and rejected(fn(){I2C.normalize_addresses([16,16]);})
    and rejected(fn(){I2C.scan_with_backend(256,[16],"receive-byte",backend);}),
    "empty, reserved, duplicate, and invalid bus inputs fail closed");
print "linux_i2c_contract_pass";
