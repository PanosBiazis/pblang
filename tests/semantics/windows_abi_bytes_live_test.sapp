// Explicit Windows release lane: heap buffers only, no desktop input or files.
let ABI = import("stdlib:windows_native_abi.sapp");
if platform() != "windows" {
    print "windows_abi_bytes_live_skip_non_windows";
} else {
    let path = try env_get("PBLANG_WINDOWS_ABI_BRIDGE") catch nil;
    assert(type(path)=="string" and path!="", "ACL-protected packaged bridge must be configured");
    let state = ABI.load_packaged(path);
    assert(state.ok, "packaged bridge loads");
    let pointer = ABI.allocate(state,64);
    assert(pointer > 0, "private test buffer allocated");
    let initial = []; let i = 0; while i < 64 { array_push(initial,90); i=i+1; }
    assert(ABI.write_bytes(state,pointer,0,initial), "sentinel buffer initialized");
    let invalid = [[-1,1,0,0],[256,0,0,0],[0.5,0.001953125,0,0],
        [1,2,3,4,-1],[1,2,3,4,5,6,7,256],[1,2,3,4,"bad"],[1,2,3,4,nil]];
    i = 0;
    while i < len(invalid) {
        assert(not ABI.write_bytes(state,pointer,3,invalid[i]), "malformed buffer rejected");
        assert(ABI.read_bytes(state,pointer,0,64)==initial, "native destination unchanged on invalid input");
        i=i+1;
    }
    let values = [0,255,128,127,1,254,2,253,3];
    assert(ABI.write_bytes(state,pointer,3,values), "unaligned native write");
    let actual = ABI.read_bytes(state,pointer,0,64);
    i=0;
    while i<64 {
        assert(actual[i] == (if i>=3 and i<12 { values[i-3] } else { 90 }), "native byte/canary parity");
        i=i+1;
    }
    assert(not ABI.write_bytes(state,pointer,63,[1,2]), "out of bounds rejected");
    assert(ABI.free(state,pointer), "buffer released");
    assert(not ABI.write_bytes(state,pointer,0,[1]), "freed buffer rejected");
    assert(ABI.close(state), "bridge closed");
    print "windows_abi_bytes_live_pass|7|64";
}
