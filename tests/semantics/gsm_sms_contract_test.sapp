let SMS=import("stdlib:gsm_sms.sapp");
fn expect(value,message){if not value{throw "FAIL GSM SMS: "+message;}}
fn rejected(work){return try { work(); false } catch true;}

let writes=[];let responses=["\r\nOK\r\n","\r\nOK\r\n","\r\nOK\r\n","\r\nOK\r\n",
    "\r\nOK\r\n","\r\n> ","\r\n+CMGS: 17\r\nOK\r\n"];
let response_index=0;
let backend=map{
    open:fn(port,baud){return map{ok:true,port:port,baud:baud};},
    write:fn(handle,bytes,timeout){array_push(writes,bytes);return map{ok:true,bytes_sent:len(bytes)};},
    read:fn(handle,maximum,timeout){let text=responses[response_index];response_index=response_index+1;
        return map{ok:true,bytes:str_to_bytes(text),timed_out:false};},
    close:fn(handle){return map{ok:true,closed:true};}
};
let sent=SMS.send_with_backend("/dev/ttyUSB0",115200,"+306900000000","hello",5000,backend);
expect(sent.ok and sent.executed and sent.accepted_by_modem and sent.descriptor_closed,
    "complete AT dialogue reaches modem acceptance");
expect(bytes_to_str(writes[0])=="AT\r" and bytes_to_str(writes[5])=="AT+CMGS=\"+306900000000\"\r"
    and writes[6][len(writes[6])-1]==26,"commands and Ctrl-Z terminator are exact");
expect(rejected(fn(){SMS.send_with_backend("/dev/ttyUSB0",115200,"6900000000","x",5000,backend);})
    and rejected(fn(){SMS.send_with_backend("/dev/ttyUSB0",115200,"+306900000000","",5000,backend);})
    and rejected(fn(){SMS.send_with_backend("/dev/ttyUSB0",115200,"+306900000000","hi "+str_from_char_code(0),5000,backend);}),
    "invalid recipient, empty body, and control bytes fail closed");
print "gsm_sms_contract_pass";
