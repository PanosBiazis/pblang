// tests/semantics/event_enrich3_test.sapp — wave 2 for stdlib/event.sapp (prepend)

let E = import("stdlib/event.sapp");

fn fail(m) { throw "FAIL " + m; }
fn arreq(a, b, m) {
    if len(a) != len(b) { fail(m + " len " + str(a)); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " [" + str(i) + "] " + str(a)); } i = i + 1; }
}

let bus = E.new();
let order = [];
E.on(bus, "x", fn(d) { array_push(order, "second"); });
E.prepend(bus, "x", fn(d) { array_push(order, "first"); });
E.emit(bus, "x", nil);
arreq(order, ["first", "second"], "prepended handler runs before existing");

// prepend on a fresh event works too
let order2 = [];
E.prepend(bus, "y", fn(d) { array_push(order2, "only"); });
E.emit(bus, "y", nil);
arreq(order2, ["only"], "prepend on new event");

print "event_enrich3_pass";
