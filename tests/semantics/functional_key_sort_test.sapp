let F=import("stdlib:functional.sapp");let S=import("stdlib:functional_sort.sapp");
fn eq(a,b,label){assert(a==b,label);}
fn asc(a,b){if a<b {return -1;}if a>b {return 1;}return 0;}
fn identity(x){return x;}
// Independent stable index oracle: enumerate each value bucket in input order.
for code 243 {
 let rest=code;let a=[];for _i 5 {push(a,rest%3);rest=num_floor(rest/3);}
 let expected=[];for key in [0,1,2] {for i 5 {if a[i]==key {push(expected,i);}}}
 let order=F.stable_argsort_by_key(a,identity,asc);eq(order,expected,"243 stable permutations");
 let sorted=[];for i in expected {push(sorted,a[i]);}
 eq(F.stable_sort_by_key(a,identity,asc),sorted,"sorted values oracle");
 eq(S.stable_argsort_by_key(a,identity,asc),order,"public facade parity");
}
let rows=[map{k:2,id:0},map{k:1,id:1},map{k:2,id:2},map{k:1,id:3}];
let projected=[];let phase=[];
let ordered=F.stable_sort_by_key(rows,fn(v){push(projected,v.id);push(phase,"key");return v.k;},fn(a,b){push(phase,"compare");return asc(a,b);});
eq(projected,[0,1,2,3],"one projection in source order");eq(slice(phase,0,4),["key","key","key","key"],"all projections before comparisons");
eq(F.map(ordered,fn(v){return v.id;}),[1,3,0,2],"stable object order");
ordered[0].k=9;eq(rows[1].k,9,"borrowed payloads");push(ordered,map{});eq(len(rows),4,"independent result slots");
eq(F.stable_argsort_by_key([1,3,3,2],identity,fn(a,b){return b-a;}),[1,2,3,0],"descending stable indices");
eq(F.stable_sort_by_key([nil,true,"x"],identity,fn(a,b){return 0;}),[nil,true,"x"],"opaque keys comparator owns ordering");
eq(F.stable_sort_by_key([],nil,nil),[],"empty no callbacks");eq(F.stable_argsort_by_key([],nil,nil),[],"empty indices");
let single=[0];eq(F.stable_sort_by_key([7],fn(x){single[0]=single[0]+1;return x;},nil),[7],"singleton key callback");eq(single[0],1,"singleton projected once");
eq(F.stable_argsort_by_key([7],identity,nil),[0],"singleton index");
let source=[3,1,2];let seen=[];
let snapshot=F.stable_sort_by_key(source,fn(v){push(seen,v);if len(seen)==1 {source[1]=99;push(source,0);}return v;},asc);
eq(seen,[3,1,2],"snapshot protects projection input slots");eq(snapshot,[1,2,3],"sort uses entry snapshot");eq(source,[3,99,2,0],"callback effects remain");
let changed=[3,1,2];let indexcalls=[0];
let snapshot_order=F.stable_argsort_by_key(changed,fn(v){indexcalls[0]=indexcalls[0]+1;if indexcalls[0]==1 {array_pop(changed);}return v;},asc);
eq(snapshot_order,[1,2,0],"indices refer to original slots despite mutation");eq(changed,[3,1],"callback shrink preserved");
let keycalls=[0];let cmpcalls=[0];let project=fn(v){keycalls[0]=keycalls[0]+1;return v;};let compare=fn(a,b){cmpcalls[0]=cmpcalls[0]+1;return asc(a,b);};
for call in [F.stable_sort_by_key,F.stable_argsort_by_key] {
 for invalid in [nil,1,"input",map{},F.repeat(0,4097)] {
  keycalls[0]=0;cmpcalls[0]=0;let failed=try call(invalid,project,compare) catch "error";eq(failed,"error","input bound/type rejected");eq(keycalls[0],0,"no rejected projection");eq(cmpcalls[0],0,"no rejected comparison");
 }
 let effects=[];let failkey=fn(v){push(effects,v);if v==2 {throw "projection";}return v;};cmpcalls[0]=0;
 let failed=try call([1,2,3],failkey,compare) catch "error";eq(failed,"error","projection error");eq(effects,[1,2],"stop at projection failure");eq(cmpcalls[0],0,"no comparison after projection failure");
 for bad in [nil,true,"bad",map{},bigint(1),parse_number("NaN"),parse_number("inf")] {
  keycalls[0]=0;let invalidcmp=fn(a,b){return bad;};let rejected=try call([2,1],project,invalidcmp) catch "error";
  eq(rejected,"error","invalid comparator result");eq(keycalls[0],2,"keys computed before comparator validation");
 }
}
let maximum=[];for i 4096 {push(maximum,4096-i);}
keycalls[0]=0;cmpcalls[0]=0;let indexes=F.stable_argsort_by_key(maximum,project,compare);
eq(keycalls[0],4096,"boundary projection count");assert(cmpcalls[0]<=49152,"comparison bound");
for i 4096 {eq(indexes[i],4095-i,"every boundary index");}
print "functional_key_sort_pass cases=243";
