let O=import("stdlib:orm.sapp");
fn require(ok,message){if not ok {throw "FAIL: "+message;}}
let calls=0;
let rowids=0;
let captured="";
let bound=[];
let c=map{exec:fn(sql,params){calls=calls+1;captured=sql;bound=params;},last_insert_rowid:fn(){rowids=rowids+1;return 42;}};
fn legacy(data,verb) {
 let keys=map_keys(data);let cols="";let placeholders="";let vals=[];
 for i len(keys) {
  if i>0 {cols=cols+", ";placeholders=placeholders+", ";}
  cols=cols+keys[i];placeholders=placeholders+"?";vals[i]=data[keys[i]];
 }
 return [verb+" items ("+cols+") VALUES ("+placeholders+")",vals];
}
for size in [0,1,2,4,8,9,16,17,100,2000] {
 let data=map{};
 for i size {data["field_"+str(i)]=i;}
 for verb in ["INSERT INTO","INSERT OR REPLACE INTO"] {
  let keys_before=map_keys(data);
  let expected=legacy(data,verb);let before=calls;let ids=rowids;
  let result=if verb=="INSERT INTO" {O.insert(c,"items",data)} else {O.upsert(c,"items",data)};
  require(result==42 and calls==before+1 and rowids==ids+1,"dispatch and return unchanged");
  require(captured==expected[0] and bound==expected[1],"exact SQL and value order parity");
  require(map_keys(data)==keys_before,"caller map keys unchanged");
 }
}
let sensitive="synthetic-private-value'); DROP TABLE items; --";
O.insert(c,"items",map{value:sensitive});
require(not str_contains(captured,sensitive) and bound==[sensitive],"values remain parameters");
for invalid in [map{"bad;key":1},map{"bad key":2},map{"":3}] {
 let before=calls;
 require((try O.insert(c,"items",invalid) catch "rejected")=="rejected","invalid insert identifier");
 require((try O.upsert(c,"items",invalid) catch "rejected")=="rejected","invalid upsert identifier");
 require(calls==before,"invalid keys never dispatch");
}
let sql=O.connect(":memory:");
O.define_model(sql,"items",["id INTEGER PRIMARY KEY","value TEXT"]);
O.insert(sql,"items",map{id:1,value:sensitive});
require(O.find_by_id(sql,"items",1).value==sensitive,"SQLite parameter round trip");
O.upsert(sql,"items",map{id:1,value:"updated"});
require(O.count(sql,"items")==1 and O.find_by_id(sql,"items",1).value=="updated","SQLite upsert parity");
sql.close();
print "orm_builders_pass";
