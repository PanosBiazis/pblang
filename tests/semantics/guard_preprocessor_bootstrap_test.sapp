let BOOT = import("stdlib:compiler/bootstrap.sapp");
let result = BOOT.guard_preprocessor_test();
if result.total != 5 or result.passed != 5 or result.failed != 0 {
    throw "FAIL guard_preprocessor_bootstrap: focused bootstrap guard checks";
}
for check in result.results {
    if not check.passed { throw "FAIL guard_preprocessor_bootstrap: unsuccessful check"; }
}
print "guard_preprocessor_bootstrap_pass";
