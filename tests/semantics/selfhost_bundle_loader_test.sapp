// tests/semantics/selfhost_bundle_loader_test.sapp
//
// The bundle -> loader handshake. selfhost_bundle.write_bundle_selfhost links a
// multi-file program into ONE self-contained self-hosted (PBCS) .pbck, and
// selfhost_loader.run_pbck loads + runs it on the self-hosted VM. Proves the full
// link -> emit -> (delete sources) -> load -> run loop with zero module files on
// disk and no Rust front-end anywhere in the path.

let bundle = import("stdlib/selfhost_bundle.sapp");
let loader = import("stdlib/selfhost_loader.sapp");

fn fail(m) { throw "FAIL " + m; }
fn expect(c, m) { if not c { fail(m); } }

fn uniq(tag) { return "/tmp/pblbl_" + tag + "_" + str(num_floor(now_ms())); }

// Two module files: a lib and a main that imports it.
let lib_path  = uniq("lib") + ".sapp";
let main_path = uniq("main") + ".sapp";
let out_path  = uniq("bundle") + ".pbck";

fs_write_bytes(lib_path, str_to_bytes("fn sq(x){ return x * x; } let BONUS = 4; export sq, BONUS;"));
fs_write_bytes(main_path, str_to_bytes("let m = import(\"" + lib_path + "\"); let answer = m.sq(9) + m.BONUS; print answer;"));

// Link + emit a self-contained PBCS .pbck.
let wb = bundle.write_bundle_selfhost(main_path, out_path);
expect(wb.ok, "write_bundle_selfhost must succeed");
expect(wb.out == out_path, "report carries the output path");

// Delete BOTH source files — a truly self-contained bundle must not need them.
fs_remove(lib_path);
fs_remove(main_path);
expect(fs_exists(lib_path) == false, "lib source removed");
expect(fs_exists(main_path) == false, "main source removed");

// Load + run from disk: 9*9 + 4 == 85.
let res = loader.run_pbck(out_path);
expect(res.ok, "run_pbck runs the self-contained bundle");
expect(res.globals["answer"] == 85, "bundled program computes 9*9 + 4 == 85");
expect(res.output[0] == 85, "bundled program's print output survives");

fs_remove(out_path);
print "selfhost_bundle_loader_pass";
