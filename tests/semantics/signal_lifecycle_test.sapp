let S = import("stdlib:signal.sapp");
fn eq(a,b,label) { assert(a==b,label); }

// Recursive duplicate must not re-enter downstream. Cap recursion even on old code.
let src=S.new(); let distinct=S.distinct_signal(src); let got=[];
S.subscribe(distinct,fn(v){ push(got,v); if len(got)<3 { S.emit(src,v); } });
S.emit(src,7);
eq(got,[7],"reentrant duplicate suppression");

// An inner changed value must remain the most recently seen value.
let nested=S.new(); let nd=S.distinct_signal(nested); let ng=[];
S.subscribe(nd,fn(v){ push(ng,v); if v==1 { S.emit(nested,2); } });
S.emit(nested,1); S.emit(nested,2);
eq(ng,[1,2],"inner emission state survives outer callback");
let nilsrc=S.new();let nilgot=[];let nilsig=S.distinct_signal(nilsrc);
S.subscribe(nilsig,fn(v){push(nilgot,v);});
S.emit(nilsrc,nil);S.emit(nilsrc,nil);S.emit(nilsrc,0);S.emit(nilsrc,nil);
eq(nilgot,[nil,0,nil],"nil is a valid signal payload");

// Every derived constructor exposes immediate-source teardown.
let constructors=[
 fn(s){return S.map_signal(s,fn(v){return v*2;});},
 fn(s){return S.filter_signal(s,fn(v){return v>0;});},
 fn(s){return S.scan_signal(s,fn(a,v){return a+v;},0);},
 fn(s){return S.distinct_signal(s);}
];
for make in constructors {
 let source=S.new(); let direct=[]; let values=[];
 let unsub=S.subscribe(source,fn(v){push(direct,v);});
 let derived=make(source);S.subscribe(derived,fn(v){push(values,v);});
 eq(S.count(source),2,"source registrations");
 S.emit(source,2);eq(len(values),1,"derived receives source");
 S.clear(derived);eq(S.count(source),2,"clear does not disconnect source");
 S.subscribe(derived,fn(v){push(values,v);});
 S.disconnect(derived);S.disconnect(derived);
 eq(S.count(source),1,"only owned subscription removed");
 S.emit(source,3);eq(len(values),1,"disconnected source ignored");
 S.emit(derived,9);eq(values[1],9,"direct emission remains usable");
 eq(direct,[2,3],"unrelated subscriber preserved");
 unsub();unsub();eq(S.count(source),0,"unsubscribe remains idempotent");
}
let a=S.new();let b=S.new();let merged=S.merge_signals(a,b);let mg=[];
S.subscribe(merged,fn(v){push(mg,v);});S.emit(a,1);S.emit(b,2);
S.disconnect(merged);eq(S.count(a),0,"merge left detached");eq(S.count(b),0,"merge right detached");
S.emit(a,3);S.emit(b,4);eq(mg,[1,2],"merge stops forwarding");
let same=S.new();let twice=S.merge_signals(same,same);
eq(S.count(same),2,"same source has two links");S.disconnect(twice);eq(S.count(same),0,"both same-source links detached");

// A disconnect during a callback takes effect on the next source emission.
let re=S.new();let rd=S.map_signal(re,fn(v){return v;});let rg=[];
S.subscribe(rd,fn(v){push(rg,v);S.disconnect(rd);S.emit(re,v+1);});
S.emit(re,1);eq(rg,[1],"disconnect before nested source emit");
let root=S.new();S.subscribe(root,fn(v){return v;});S.disconnect(root);
eq(S.count(root),1,"plain signal disconnect preserves local handlers");

// Disconnect is shallow; other consumers of an intermediate stream survive.
let chain=S.new();let middle=S.map_signal(chain,fn(v){return v;});
let leaf=S.filter_signal(middle,fn(v){return true;});S.disconnect(leaf);
eq(S.count(middle),0,"leaf detaches from middle");eq(S.count(chain),1,"middle stays connected");
S.disconnect(middle);eq(S.count(chain),0,"explicit middle disconnect");
// Snapshot ids: removing a later listener must not raise a missing-key error.
let mutation=S.new();let removed=fn(){return nil;};let seen=[];
S.subscribe(mutation,fn(v){push(seen,1);removed();});
removed=S.subscribe(mutation,fn(v){push(seen,2);});
eq(S.emit(mutation,0),1,"removed listener skipped");eq(seen,[1],"no stale callback");
let clearing=S.new();S.subscribe(clearing,fn(v){S.clear(clearing);});
S.subscribe(clearing,fn(v){throw "must not run";});
eq(S.emit(clearing,0),1,"clear during emit skips remaining listeners");
let adding=S.new();let added=[];
S.once(adding,fn(v){S.subscribe(adding,fn(x){push(added,x);});});
eq(S.emit(adding,1),1,"new listener deferred");eq(added,[],"not in current snapshot");
eq(S.emit(adding,2),1,"new listener gets next emission");eq(added,[2],"next value received");
print "signal_lifecycle_pass";
