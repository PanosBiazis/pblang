let Decode = import("stdlib:host_pbck_decode.sapp");
let Translate = import("stdlib:selfhost_to_pbck.sapp");

fn fail(message) { throw "FAIL host_pbck_decode: " + message; }

// Outer local slot 0 is captured by the nested function. The self-hosted
// opcodes are translated to native PBCK-v1 before decoding them again.
let inner = map{
    instructions: [
        map{ op: 38, operand: 0 },
        map{ op: 16, operand: 0 },
        map{ op: 1, operand: 0 },
        map{ op: 39, operand: 0 },
        map{ op: 38, operand: 0 },
        map{ op: 19, operand: 0 }
    ],
    constants: []
};
let function_constant = map{
    arity: 1, min_arity: 1, chunk: inner,
    upvalues: [map{ index: 0, is_local: true }]
};
let source = map{
    instructions: [
        map{ op: 0, operand: 0 }, map{ op: 17, operand: 0 },
        map{ op: 24, operand: 1 }, map{ op: 17, operand: 1 },
        map{ op: 16, operand: 1 }, map{ op: 0, operand: 2 },
        map{ op: 18, operand: 1 }, map{ op: 19, operand: 0 }
    ],
    constants: [40, function_constant, 2]
};

let decoded = Decode.decode_bytes(Translate.translate(source));
if decoded.format != "host-pbck-v1" or decoded.version != 1
    or decoded.instructions != 18 or decoded.constants != 7 {
    fail("artifact totals mismatch");
}
let root = decoded.chunk;
if len(root.instructions) != 11 or root.instructions[5].op != 27
    or root.instructions[5].fn_const != 3
    or len(root.instructions[5].captures) != 1
    or not root.instructions[5].captures[0].is_local
    or root.instructions[5].captures[0].index != 0 {
    fail("closure capture metadata mismatch");
}
let fnc = root.constants[3];
if not fnc.__pbck_function or fnc.arity != 1 or fnc.min_arity != 1
    or len(fnc.chunk.instructions) != 7
    or fnc.chunk.instructions[1].op != 28
    or fnc.chunk.instructions[4].op != 29 {
    fail("nested function or upvalue opcodes mismatch");
}
if root.instructions[9].op != 31 or root.instructions[9].operand != 1 {
    fail("call metadata mismatch");
}

let trailing = Translate.translate(source);
array_push(trailing, 0);
if not (try { Decode.decode_bytes(trailing); false } catch true) {
    fail("trailing bytes accepted");
}
if not (try { Decode.decode_bytes([80, 66, 67, 75, 2, 0, 0, 0, 0]); false } catch true) {
    fail("unsupported version accepted");
}

print "host_pbck_decode_pass";
