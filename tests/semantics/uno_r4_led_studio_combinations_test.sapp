// Deterministic user sequences: exact document, selection, clock and playback.
let M=import("../../examples/uno_r4_led_studio/model.sapp");let L=import("stdlib:uno_r4_led_matrix.sapp");
let P=import("../../examples/uno_r4_led_studio/playback.sapp");let checks=0;
fn check(value,label) {assert(value,label);checks=checks+1;}
fn denied(f) {return try {f();false;} catch true;}
fn pair() {let s=M.create();M.apply(s,"preset","clear");M.apply(s,"duration",50);M.apply(s,"add");M.apply(s,"pixel",95);M.apply(s,"duration",100);return s;}
let s=pair();M.apply(s,"previous");M.apply(s,"next");M.apply(s,"duration",150);M.apply(s,"play",nil,1000);
check(s.index==0 and s.playing,"play from nonfirst selection deliberately starts first");
M.apply(s,"stop",nil,1050);check(s.index==1 and not s.playing,"stop resolves exact frame boundary");
let first=json_stringify(s.document.frames[0]);M.apply(s,"pixel",0);
check(s.document.frames[1].pixels[0]==1 and json_stringify(s.document.frames[0])==first,"stop then edit changes only selected elapsed frame");
for elapsed in [0,49,50,149,150,151,1000] {
    let a=pair();M.apply(a,"play",nil,2000);let before=M.export_document(a);M.apply(a,"stop",nil,2000+elapsed);
    let index=0;if elapsed>=50 {index=1;}
    check(a.index==index and not a.playing and M.export_document(a)==before,"stop before/at/after completion preserves exact document");
    let snapshot=json_stringify(a);M.apply(a,"stop",nil,9000);check(json_stringify(a)==snapshot,"repeated stop idempotent");
}
for operation in ["preset","invert","pixel","duration","previous","next","add","delete"] {
    let a=pair();M.apply(a,"play",nil,3000);let values=map{preset:"border",pixel:0,duration:500};let value=try values[operation] catch nil;
    M.apply(a,operation,value,3060);check(not a.playing,"successful edit stops playback");
    if operation=="previous" {check(a.index==0,"previous starts from elapsed frame");}
    elif operation=="delete" {check(a.index==0 and len(a.document.frames)==1 and a.document.frames[0].pixels==L.blank(),"delete removes elapsed frame only");}
    elif operation=="add" {check(a.index==2 and len(a.document.frames)==3 and a.document.frames[2]==a.document.frames[1],"duplicate appends independent elapsed frame copy");M.apply(a,"pixel",0);check(a.document.frames[1].pixels[0]==0,"duplicate edit detached");}
    else {check(a.index==1 and a.document.frames[0].pixels==L.blank(),"action targets elapsed frame only");}
}
for duration in [nil,true,"50",0,49,50.5,5001,999999] {
    let a=pair();M.apply(a,"play",nil,4000);let before=json_stringify(a);
    check(denied(fn(){M.apply(a,"duration",duration,4060);}) and json_stringify(a)==before,"invalid duration cannot advance frame or clock");
}
for operation in ["pixel","preset","text","import","unknown"] {
    let a=pair();M.apply(a,"play",nil,5000);let before=json_stringify(a);let values=map{pixel:96,text:"漢"};let value=try values[operation] catch "invalid";
    check(denied(fn(){M.apply(a,operation,value,9000);}) and json_stringify(a)==before,"invalid action after nominal completion retains all state");
}
let single=M.create();let before=json_stringify(single);check(denied(fn(){M.apply(single,"delete");}) and json_stringify(single)==before,"cannot delete last frame");
M.apply(single,"previous");check(single.index==0,"previous lower bound");M.apply(single,"next");check(single.index==0,"next upper bound");
for preset in ["heart","border","checker","clear"] {let a=pair();M.apply(a,"preset",preset);check(a.document.frames[1].pixels==L.preset(preset) and a.document.frames[0].pixels==L.blank(),"preset only current frame");let before=M.current(a);M.apply(a,"invert");M.apply(a,"invert");check(M.current(a)==before,"double invert restores exact current frame");}
let frames=[];for _i 12 {push(frames,map{pixels:L.blank(),duration_ms:5000});}
let full=M.create();full.document=L.animation(frames);M.apply(full,"play",nil,6000);before=json_stringify(full);
check(denied(fn(){M.apply(full,"add",nil,6100);}) and json_stringify(full)==before,"duplicate total duration overflow is atomic during playback");
frames=[];for _i 64 {push(frames,map{pixels:L.blank(),duration_ms:50});}full.document=L.animation(frames);full.playing=false;before=json_stringify(full);
check(denied(fn(){M.apply(full,"add");}) and json_stringify(full)==before,"65th frame rejected atomically");
let a=pair();M.apply(a,"text","PB");check(len(a.document.frames)==25 and a.index==0 and not a.playing and a.document.frames[0].pixels==L.blank() and a.document.frames[24].pixels==L.blank(),"text deliberately includes entry/exit blank frames");
let exported=M.export_document(a);M.apply(a,"play",nil,7000);M.apply(a,"import",exported,9000);check(not a.playing and a.index==0 and a.started==0 and M.export_document(a)==exported,"valid import replaces playback and resets selection");
let identical=L.animation([map{pixels:L.blank(),duration_ms:50},map{pixels:L.blank(),duration_ms:50}]);
let svg=P.svg(identical);check(str_contains(svg,"Frame 1 / 2 · pass 1/1 · blank") and str_contains(svg,"Frame 2 / 2 · pass 1/1 · blank") and str_contains(svg,"begin=\"50ms\""),"blank/identical frames still have visible advancing labels");
let Text=import("../../examples/uno_r4_led_studio/text.sapp");
let t=pair();let other=json_stringify(t.document.frames[0]);let duration=t.document.frames[1].duration_ms;
M.apply(t,"static_text","PB");check(len(t.document.frames)==2 and t.index==1 and not t.playing and t.document.frames[1].duration_ms==duration and json_stringify(t.document.frames[0])==other,"static text changes only current pixels, no scrolling/replacement");
check(t.document.frames[1].pixels==Text.frame("PB") and t.text=="PB","static text deterministic frame and retained input");
let single_glyph=Text.frame("P");check(single_glyph[0]==0 and single_glyph[3]==1 and single_glyph[7]==0,"single 5x7 glyph centered without clipping");
for value in ["", "ABC", "漢", nil, 123] {let snapshot=json_stringify(t);check(denied(fn(){M.apply(t,"static_text",value);}) and json_stringify(t)==snapshot,"invalid static text atomic including duration and selection");}
M.apply(t,"timing_all",500);check(t.index==1 and t.document.total_ms==1000 and t.document.frames[0].duration_ms==500 and t.document.frames[1].duration_ms==500,"set all durations preserves frames and selection");
M.apply(t,"text","PB");let snapshot=json_stringify(t);check(denied(fn(){M.apply(t,"timing_all",5000);}) and json_stringify(t)==snapshot,"all-duration total overflow rejected atomically");
M.apply(t,"timing_all",200);check(t.document.total_ms==5000 and len(t.document.frames)==25,"scroll speed independently adjustable");
let repeated=pair();let export_before=M.export_document(repeated);M.apply(repeated,"play",3,10000);
for entry in [map{time:10000,index:0,playing:true},map{time:10050,index:1,playing:true},map{time:10150,index:0,playing:true},map{time:10449,index:1,playing:true},map{time:10450,index:1,playing:false}] {M.tick(repeated,entry.time);check(repeated.index==entry.index and repeated.playing==entry.playing and M.export_document(repeated)==export_before,"bounded repeated playback preserves exported document and resolves passes");}
let repeated_svg=P.svg(repeated.document,160,3);check(str_contains(repeated_svg,"pass 2/3") and str_contains(repeated_svg,"pass 3/3") and not str_contains(repeated_svg,"indefinite"),"remaining repeat SVG finite and labelled");
for invalid in [0,9,1.5,"2",true] {let snapshot=json_stringify(repeated);check(denied(fn(){M.apply(repeated,"play",invalid,20000);}) and json_stringify(repeated)==snapshot,"invalid repeat does not start or mutate preview");}
let budget=M.create();M.apply(budget,"text","PB");let budget_snapshot=json_stringify(budget);check(denied(fn(){M.apply(budget,"play",6,20000);}) and json_stringify(budget)==budget_snapshot,"expanded SVG frame budget enforced before play");
M.apply(budget,"timing_all",2000);budget_snapshot=json_stringify(budget);check(denied(fn(){M.apply(budget,"play",2,20000);}) and json_stringify(budget)==budget_snapshot,"repeated duration budget enforced before play");
print "uno_r4_led_studio_combinations_pass checks="+str(checks);
