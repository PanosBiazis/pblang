// C2: optional-to-optional assignment must compare the two inner types.
let C = import("stdlib/compiler/typeck.sapp");
fn demand(ok, message) { if not ok { throw "FAIL typeck-optional: " + message; } }
let n = C.ty_number();
let d = C.ty_decimal();
let s = C.ty_string();
let on = C.ty_option(n);
let od = C.ty_option(d);
demand(C.ty_assignable(on, od), "numeric option widening");
demand(C.ty_assignable(C.ty_option(C.ty_array(n)), C.ty_option(C.ty_array(d))), "optional array widening");
demand(C.ty_assignable(C.ty_option(C.ty_map(s, n)), C.ty_option(C.ty_map(s, d))), "optional map widening");
demand(C.ty_assignable(C.ty_option(C.ty_result(n, s)), C.ty_option(C.ty_result(d, s))), "optional result widening");
demand(C.ty_assignable(C.ty_nil(), on), "nil to optional");
demand(C.ty_assignable(n, od), "value to optional");
demand(not C.ty_assignable(on, n), "optional to required must reject");
demand(not C.ty_assignable(C.ty_option(s), on), "incompatible optional must reject");
demand(not C.ty_assignable(C.ty_option(C.ty_array(s)), C.ty_option(C.ty_array(n))), "incompatible nested optional");
print "selfhost_typeck_optional_pass";
