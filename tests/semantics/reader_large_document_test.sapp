let Fit=import("../../examples/declarative_browser/text_fit.sapp");let P=import("../../examples/declarative_browser/pagination.sapp");let App=import("../../examples/declarative_browser/app.sapp");
let D=import("stdlib:browser_document.sapp");let V=import("stdlib:browser_view.sapp");let S=import("stdlib:browser_session.sapp");let GUI=import("stdlib:gui.sapp");let Focus=import("../../examples/declarative_browser/focus_indicator.sapp");
let checks=0;fn check(ok,label){assert(ok,label);checks=checks+1;}
fn wide(text,size,family){return map{ok:true,width:len(text)*size,height:size};}
let text=str_repeat("W",256);let options=map{font_size:64,font_family:"serif",line_height:1.25,font_weight:"bold"};
check(Fit.lines(text,296,options,true,wide).truncated,"default 64-row contract retained");
let full=Fit.lines(text,296,options,true,wide,256);check(not full.truncated and len(full.lines)>64,"explicit measured budget supports complete block");
check(str_join(full.lines,"")==text,"all characters retained");for line in full.lines {check(Fit.fits(line,296,options,true,wide),"each line fits");}
for budget in [0,257,1.5,true,"256"] {check((try Fit.lines(text,296,options,true,wide,budget) catch nil)==nil,"invalid budget rejected");}
check(Fit.lines("W",20,options,true,wide,256).truncated,"unfittable cluster still rejected");
let combined=str_repeat("ά",128);let grouped=Fit.lines(combined,296,options,true,wide,256);
check(not grouped.truncated and str_join(grouped.lines,"")==combined,"combining characters retained");
for line in grouped.lines {check(num_mod(len(line),2)==0,"combining groups not split");}
let source="<article><h1>Large imported text</h1><h2>"+text+"</h2><p>"+str_repeat("Ελληνικό κείμενο. ",12)+"</p><a href=\"pb://about\">Final local destination</a></article>";
let doc=D.import_html(source);let before=D.export_html(doc);let style=V.appearance(map{font_family:"serif",body_size:40,title_size:40,font_scale:1.5,line_height:1.25});
for size in [map{w:320,h:240},map{w:320,h:480},map{w:390,h:844},map{w:800,h:816}] {
    let plan=P.plan(doc,style,size.w,size.h,wide);check(plan.available==(size.h>240),"size availability is honest");let covered=map{};let links=0;
    for page in plan.pages {for row in page {if row.kind=="text" {covered[str(row.block)]=(try covered[str(row.block)] catch "")+str_replace_all(row.text," ","");} if row.kind!="text" {links=links+1;}}}
    let inspected=D.inspect(doc);check(covered["-1"]==str_replace_all(inspected.title," ",""),"complete title");
    for i len(inspected.blocks) {check(covered[str(i)]==str_replace_all(inspected.blocks[i].text," ",""),"complete imported blocks");}
    check(links==1,"last local link retained");
    for i len(plan.pages) {check(P.locate(plan,P.anchor(plan,i))==i,"all page anchors round-trip");}
}
let c=App.create();let local=App.pages();local["pb://guide"]=source;c.session.close();c.session=S.create(local);c.session.navigate("pb://guide");c.width=320;c.height=480;
App.configure(c,style);App.set_text_measure(c,wide);App.refresh(c);App.read_page(c,20);App.update(c,[]);let anchor=c.reading_anchor;
for size in [map{w:320,h:240},map{w:640,h:720},map{w:320,h:480}] {
    App.update(c,[map{type:"resize",w:size.w,h:size.h}]);check(c.reading_anchor==anchor,"resize retains logical reading anchor");
    c.form.focus="appearance";check(Focus.plan(c.form)!=nil,"Style focus remains visible during recovery");
}
c.form.focus="appearance";App.update(c,[map{type:"keydown",key:"Enter"}]);App.update(c,[map{type:"keyup",key:"Enter"}]);check(c.settings,"Style remains reachable");
GUI.get(c.form,"appearance").onclick(c.form);App.update(c,[]);check(not c.settings and c.reading_anchor==anchor,"Style round-trip retains reading position");
App.read_page(c,len(c.reading_plan.pages)-1);App.update(c,[]);check(GUI.get(c.form,"block2")!=nil,"final link accessible");GUI.get(c.form,"block2").onclick(c.form);App.update(c,[]);check(c.session.snapshot().url=="pb://about","canonical destination opens");c.session.close();
let blocks=[];for i 8 {push(blocks,map{tag:"h2",text:text});}let maximum=D.create(str_repeat("W",80),blocks);
let limited=P.plan(maximum,style,320,240,wide);check(not limited.available and len(limited.pages)==0 and limited.reason=="Reader page budget exceeded.","page budget gives recoverable layout instead of throwing");
let recovered=P.plan(maximum,style,640,720,wide);check(recovered.available and len(recovered.pages)<=512,"maximum imported document recovers in larger viewport");
let maximum_source="<article><h1>"+str_repeat("W",80)+"</h1>"+str_repeat("<h2>"+text+"</h2>",8)+"</article>";
c=App.create();local=App.pages();local["pb://guide"]=maximum_source;c.session.close();c.session=S.create(local);c.session.navigate("pb://guide");
c.width=640;c.height=720;App.configure(c,style);App.set_text_measure(c,wide);App.refresh(c);App.read_page(c,5);App.update(c,[]);anchor=c.reading_anchor;
App.update(c,[map{type:"resize",w:320,h:240}]);check(not c.reading_plan.available and len(c.reading_plan.pages)==0,"controller survives exhausted page budget");
check(c.reading_anchor==anchor and not App.read_page(c,1),"unavailable navigation preserves anchor");
c.form.focus="appearance";check(Focus.plan(c.form)!=nil,"Style remains reachable after page budget exhaustion");
App.update(c,[map{type:"resize",w:640,h:720}]);check(c.reading_plan.available and c.reading_anchor==anchor and c.reading_page==P.locate(c.reading_plan,anchor),"controller restores exact logical position after budget recovery");c.session.close();
check(D.export_html(doc)==before,"canonical import unchanged");print "reader_large_document_pass checks="+str(checks);
