let T=import("stdlib:compiler/tokenizer.sapp");
let P=import("stdlib:compiler/parser.sapp");
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let S=import("stdlib:security_analysis.sapp");
let Taint=import("stdlib:security_taint.sapp");
let Check=import("editors/ide/pbide_source_check.sapp");
let Preview=import("editors/ide/pbide_source_highlight.sapp");
let bad=["123name","1.2name","1e2name","1e2e3","-2E-3name","1_000","1π","1e2変数",
    "1"+strfromcharcode(769),"1and","1or","12private_canary","1e2_private_canary"];
for literal in bad {
    let source="let name=9; let x="+literal+";";
    let tokens=T.tokenize(literal,true);
    assert(len(tokens)==2 and tokens[0].kind=="invalid" and tokens[0].text=="invalid number literal"
        and tokens[1].kind=="eof" and tokens[1].col==len(literal)+1,"whole suffix is one invalid token");
    assert(not str_contains(json_stringify(tokens),"private_canary"),"no invalid spelling in token diagnostics");
    assert(json_stringify(T.tokenize_bounded(literal,2,true).tokens)==json_stringify(tokens),"bounded schema parity");
    assert(not T.tokenize_bounded(literal,1).ok,"invalid token still counts against cap");
    let parsed=P.parse(T.tokenize(source));
    assert(len(parsed.stmts)==0 and len(parsed.errors)==1,"direct parser rejects all statements with one diagnostic");
    let compiled=F.frontend_compile(source);
    assert(not compiled.ok and len(compiled.chunk.instructions)==0,"no codegen for numeric suffix");
    assert(not F.frontend_run(source).ok,"bound suffix identifier cannot make malformed program executable");
    let guarded=F.frontend_compile_with_guard_prep(source);
    assert(not guarded.ok and not guarded.preprocess_stats.changed,"preprocessor retains invalid raw input");
    assert(not F.frontend_lint(source).ok and not Check.check(source).ok,"linter and PBIDE agree");
    assert(not Preview.render(source).highlighted,"preview retains escaped plain source");
    let scan=S.analyze(source,"fixture.sapp");let taint=Taint.analyze(source,"fixture.sapp");
    assert(not scan.passed and not scan.mandatory_complete and not taint.parser_complete,"security coverage fails closed");
    assert(not str_contains(json_stringify(parsed.errors),"private_canary")
        and not str_contains(json_stringify(taint),"private_canary"),"reports do not copy invalid suffixes");
}
for source in ["1e2-3","1e2+3","1e2*3","1..3","1.2..3","1e2..3","1/* gap */+2",
    "1// gap\n+2","1 and true","1 or false","1 in [1]","1\nname","(1).name","1.2 .name",
    "1\tname","1\r\nname","let name1=123;", "let s=\"123name\"; // 1e2name"] {
    for token in T.tokenize(source) { assert(token.kind!="invalid","separators/operators/comments/identifier digits remain valid"); }
}
let arithmetic=F.frontend_run("let a=1e2-3; let b=1e2+3; let c=1e2*3;");
assert(arithmetic.ok and arithmetic.globals.a==97 and arithmetic.globals.b==103 and arithmetic.globals.c==300,
    "scientific notation and adjacent arithmetic retain values");
let positioned=T.tokenize("\"😀\";\n  12π\r\nnext",true);
assert(positioned[2].kind=="invalid" and positioned[2].line==2 and positioned[2].col==3
    and positioned[3].text=="next" and positioned[3].line==3 and positioned[3].col==1,
    "suffix scan preserves physical Unicode/CRLF positions");
let long=T.tokenize_bounded("1"+str_repeat("π",2048)+";",3);
assert(long.ok and len(long.tokens)==3 and long.tokens[0].text=="invalid number literal"
    and long.tokens[1].text==";","long suffix does not leak or swallow delimiter");
let legacy="let result=match 1 { case n if n>0 ~ 1e2name; else: 0; };";
let guarded=F.frontend_compile_with_guard_prep(legacy);
assert(not guarded.ok and not guarded.preprocess_stats.changed,"legacy match cannot erase suffix failure");
print "selfhost_numeric_boundaries_pass";
