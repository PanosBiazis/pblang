// tests/semantics/cron_test.sapp — cron expression matcher.

let C = import("stdlib/cron.sapp");

fn fail(m) { throw "FAIL " + m; }
fn t(min, hr, day, mon, wd) { return map{ minute: min, hour: hr, day: day, month: mon, weekday: wd }; }

// ── wildcard ────────────────────────────────────────────────────────────────────────
if not C.matches("* * * * *", t(30, 5, 1, 1, 3)) { fail("* matches anything"); }

// ── exact minute ──────────────────────────────────────────────────────────────────
if not C.matches("30 * * * *", t(30, 5, 1, 1, 3)) { fail("minute 30"); }
if C.matches("30 * * * *", t(31, 5, 1, 1, 3)) { fail("minute 31 != 30"); }

// ── step */15 ───────────────────────────────────────────────────────────────────────
if not C.matches("*/15 * * * *", t(0, 0, 1, 1, 0)) { fail("0 is multiple of 15"); }
if not C.matches("*/15 * * * *", t(45, 0, 1, 1, 0)) { fail("45 is multiple of 15"); }
if C.matches("*/15 * * * *", t(7, 0, 1, 1, 0)) { fail("7 not multiple of 15"); }

// ── range 9-17 ──────────────────────────────────────────────────────────────────────
if not C.matches("0 9-17 * * *", t(0, 12, 1, 1, 0)) { fail("noon in 9-17"); }
if C.matches("0 9-17 * * *", t(0, 18, 1, 1, 0)) { fail("18 outside 9-17"); }

// ── weekdays list / Mon-Fri business hours ────────────────────────────────────────
if not C.matches("*/30 9-17 * * 1-5", t(30, 10, 5, 6, 2)) { fail("Tue 10:30 business"); }
if C.matches("*/30 9-17 * * 1-5", t(30, 10, 5, 6, 0)) { fail("Sunday excluded"); }

// ── comma list ──────────────────────────────────────────────────────────────────────
if not C.matches("0,15,45 * * * *", t(15, 1, 1, 1, 1)) { fail("15 in list"); }
if C.matches("0,15,45 * * * *", t(30, 1, 1, 1, 1)) { fail("30 not in list"); }

// ── new year midnight ───────────────────────────────────────────────────────────────
if not C.matches("0 0 1 1 *", t(0, 0, 1, 1, 5)) { fail("Jan 1 00:00"); }

// ── validity ────────────────────────────────────────────────────────────────────────
if not C.is_valid("* * * * *") { fail("5 fields valid"); }
if C.is_valid("* * *") { fail("3 fields invalid"); }
if C.matches("* * *", t(0, 0, 1, 1, 0)) { fail("malformed expr matches nothing"); }

print "cron_pass";
