let C = import("stdlib/native/artifact_cache.sapp");
let ELF = import("stdlib/native/elf_x64.sapp");

fn fail(message) { throw "FAIL native-artifact-cache: " + message; }
let root = "/tmp/pblang_native_cache_" + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 16);
let dep = root + "_dep.sapp";
let out = root + "_out.elf";
fs_write(dep, "export VALUE;");

let source = "print 1;";
let key = C.cache_key(source, [dep], "safe");
if key == C.cache_key(source + " ", [dep], "safe") { fail("source edit did not invalidate key"); }
fs_write(dep, "export VALUE2;");
if key == C.cache_key(source, [dep], "safe") { fail("dependency edit did not invalidate key"); }
fs_write(dep, "export VALUE;");

let bin = ELF.wrap_elf([184, 60, 0, 0, 0, 49, 255, 15, 5]);
if not C.valid_x64_elf(bin) { fail("generated ELF rejected"); }
let stored = C.store(root, key, bin);
if not stored.ok or stored.reused { fail("first store failed"); }
let loaded = C.load(root, key);
if not loaded.hit or len(loaded.binary) != len(bin) { fail("verified cache hit failed"); }
let reused = C.store(root, key, bin);
if not reused.ok or not reused.reused { fail("idempotent store did not reuse artifact"); }
let published = C.publish(out, loaded.binary);
if not published.ok or not C.valid_x64_elf(fs_read_bytes(out)) { fail("atomic publication failed"); }

let paths_bin = path_join(root, key + ".elf");
let damaged = fs_read_bytes(paths_bin); damaged[0] = 0; fs_write_bytes(paths_bin, damaged);
let rejected = C.load(root, key);
if rejected.hit or rejected.reason != "artifact-invalid" { fail("corrupt artifact was accepted"); }

try fs_remove(paths_bin) catch nil;
try fs_remove(path_join(root, key + ".json")) catch nil;
try fs_remove(root) catch nil;
try fs_remove(dep) catch nil; try fs_remove(out) catch nil;
print "native_artifact_cache_pass";
