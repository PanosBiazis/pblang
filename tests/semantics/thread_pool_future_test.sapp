let B=import("stdlib:thread_pool_future.sapp");
let T=import("stdlib:thread.sapp");
fn task(value) {return fn(){return value;};}
fn check(future,value) {
    assert(future.__resolved,"terminal flag");
    assert(channel_is_closed(future.__ch.receiver),"channel closed");
    assert(channel_size(future.__ch.receiver)==0,"result envelope drained");
    assert((try {join(future.__handle);false} catch true),"worker reaped exactly once");
    assert(json_stringify(B.await(future))==json_stringify(value),"backend cached result");
    assert(json_stringify(T.await(future))==json_stringify(value),"public cached result");
    assert(B.await_timeout(future,0).ok and T.await_timeout(future,0).ok,"both terminal polls");
}
for value in [nil,false,0,"",[],map{ok:false,value:nil},map{__go:true}] {
    let first=B.go(task(value));
    T.await(first);
    check(first,value);
    let second=T.go(task(value));
    B.await(second);
    check(second,value);
    let third=B.go(task(value));
    let terminal=B.await_timeout(third,1000);
    assert(terminal.ok,"terminal includes nil");
    check(third,value);
}
for work in [fn(){throw "synthetic-task-error";},fn(){return fn(){return 7;};},
             fn(){let a=[];array_push(a,a);return a;}] {
    let future=B.go(work);
    assert(B.await_timeout(future,1000).ok,"task/transfer failure is terminal");
    check(future,nil);
}
let slow=B.go(fn(){sleep_ms(150);return 7;});
let pending=B.await_timeout(slow,0);
let early=not pending.ok and not slow.__resolved;
B.await(slow);
assert(early,"timeout keeps worker ownership");
check(slow,7);

// Simulate the retained receive wait limit without a ten-second test. The
// worker/join/envelope are real; only the first receive returns early.
let source=fs_read("stdlib/thread_pool_future.sapp");
source=str_replace_all(source,"settle(future, recv(future.__ch.receiver))","settle(future, nil)");
let path=cwd()+"/.pool_future_late_"+sha256(str(random_bytes(16)))+".sapp";
fs_write_bytes(path,str_to_bytes(source));
fn late_wait(L) {
    let f=L.go(fn(){sleep_ms(20);return 19;});
    let value=L.await(f);
    check(f,19);
    return value==19;
}
let passed=try late_wait(import(path)) catch false;
fs_remove(path);
assert(passed,"recover late envelope after joining");
print "thread_pool_future_pass";
