let FE=import("stdlib:compiler/selfhost_frontend.sapp");
let source="let D=import(\"stdlib:deque.sapp\");let q=D.from_array([1,2]);D.extend_front(q,[nil,0]);D.extend_back(q,[3,4]);D.compact(q);let h=map{data:map{},head:9007199254740990,tail:9007199254740991};h.data[str(h.head)]=1;D.push_back(h,2);let result=[D.to_array(q),D.pop_front(q),D.pop_back(q),D.size(q),D.to_array(h)];";
let run=FE.frontend_run_bounded(source,map{max_steps:100000,max_frames:32,max_modules:8,max_source_bytes:65536});
assert(run.ok,"selfhost deque execution");assert(run.globals.result==[[nil,0,1,2,3,4],nil,4,4,[1,2]],"selfhost deque bulk");
print "selfhost_deque_bulk_pass";
