// tests/semantics/source_inliner_prefixed_test.sapp — the prefixed (namespaced) source linker.
//
// inline_source_prefixed gives each module a unique prefix and scope-aware-renames its top-level
// names + their references, so modules with COLLIDING top-level names (the case the shared-
// namespace inline_source rejects) link into one self-contained source the C transpiler accepts.
// This guards the collision + import-member-rewrite + strip behaviour structurally.

let INL = import("stdlib:source_inliner.sapp");

fn fail(m) { throw "FAIL " + m; }
fn truthy(c, m) { if c != true { fail(m); } }

// Two modules that BOTH define `new` (and `val`) — a hard collision for the shared namespace.
let mods = map{};
mods["a.sapp"] = "fn new() { return \"A\"; }\nfn val() { return 1; }\nexport new, val;\n";
mods["b.sapp"] = "fn new() { return \"B\"; }\nexport new;\n";

fn resolve(p) { return try mods[p] catch nil; }

let main_src = "let A = import(\"a.sapp\");\nlet B = import(\"b.sapp\");\nprint A.new() + B.new() + str(A.val());\n";

// Shared namespace MUST reject the collision (baseline).
let shared = INL.inline_source(main_src, resolve);
truthy(shared.ok == false, "shared-namespace linker rejects the colliding `new`");

// Prefixed linker MUST accept it.
let r = INL.inline_source_prefixed(main_src, resolve);
truthy(r.ok == true, "prefixed linker accepts colliding names (reason=" + str(try r.reason catch "") + ")");
let s = r.source;

// No import()/export survives; prefixing was applied.
truthy(not str_contains(s, "import("), "no import() remains in the flattened source");
truthy(not str_contains(s, "export "), "no export statement remains");
truthy(str_contains(s, "__pbi"), "module names were prefixed");

// Both colliding `new` definitions coexist under distinct prefixes, and the importer's member
// calls (A.new / B.new / A.val) were rewritten to prefixed bare calls.
truthy(str_contains(s, "_new("), "a prefixed new() call/definition is present");
truthy(str_contains(s, "_val("), "the prefixed val() survived");
truthy(r.modules == 2, "both modules were inlined (got " + str(r.modules) + ")");

let aliases = map{ "os_alias.sapp": "let cwd = cwd;\nexport cwd;\n" };
fn resolve_alias(path) { return try aliases[path] catch nil; }
let alias_link = INL.inline_source_prefixed(
    "let OS = import(\"os_alias.sapp\");\nprint type(OS.cwd);", resolve_alias);
truthy(alias_link.ok, "builtin alias module links");
truthy(str_contains(alias_link.source, "let __pbi0_cwd = cwd"),
    "builtin alias RHS remains the host builtin");
truthy(not str_contains(alias_link.source, "let __pbi0_cwd = __pbi0_cwd"),
    "builtin alias never becomes a self-reference");

// stdlib virtual paths are confined: traversal and foreign schemes must never
// be turned into filesystem candidates by product builds.
let escaped = INL.link_modules("let X = import(\"stdlib:../secret.sapp\");", map{});
truthy(not escaped.ok and str_contains(escaped.reason, "invalid or escaping import path"),
    "stdlib traversal is rejected before resolution");

// New projects resolve bare imports from the project root even when a module
// with the same basename exists beside the importer.
let rooted_modules = map{
    "shared.sapp": "fn value() { return 1; }\nexport value;\n",
    "lib/shared.sapp": "fn value() { return 2; }\nexport value;\n",
    "lib/consumer.sapp": "let S = import(\"shared.sapp\");\nfn value() { return S.value(); }\nexport value;\n"
};
let rooted = INL.link_modules(
    "let C = import(\"lib/consumer.sapp\");\nprint C.value();", rooted_modules);
truthy(rooted.ok, "root-first bare import links");
truthy(rooted.module_order[0] == "shared.sapp",
    "bare import prefers the project-root module when both candidates exist");

// Existing projects historically resolved that spelling beside the importer.
// Preserve that behavior only when no rooted module exists.
let fallback_modules = map{
    "lib/shared.sapp": "fn value() { return 2; }\nexport value;\n",
    "lib/consumer.sapp": "let S = import(\"shared.sapp\");\nfn value() { return S.value(); }\nexport value;\n"
};
let fallback = INL.link_modules(
    "let C = import(\"lib/consumer.sapp\");\nprint C.value();", fallback_modules);
truthy(fallback.ok, "legacy importer-relative bare import fallback links");
truthy(fallback.module_order[0] == "lib/shared.sapp",
    "legacy fallback selects the importer-relative module only when needed");

// `import` is also a valid map key. It must not be confused with executable
// import syntax, while an actual nested import remains fail-closed.
let import_key_modules = map{
    "metadata.sapp": "fn describe() { return map{ import: \"dependency\", value: 7 }; }\nexport describe;\n"
};
let import_key = INL.link_modules(
    "let M = import(\"metadata.sapp\");\nprint M.describe().value;", import_key_modules);
truthy(import_key.ok, "map key named import is inert linker data");
let nested_import = INL.link_modules(
    "fn load() { let M = import(\"metadata.sapp\"); return M.describe(); }", import_key_modules);
truthy(not nested_import.ok and str_contains(nested_import.reason, "nested/non-top-level import"),
    "real nested import remains rejected");

print "source_inliner_prefixed_pass";
