// Test: the SOCKS5 client protocol (stdlib/socks5.sapp) — for opt-in Tor routing, §91.
let S = import("stdlib/socks5.sapp");
let g = S.greeting();
assert(len(g) == 3 and strcharcodeat(g,0) == 5 and strcharcodeat(g,2) == 0, "no-auth greeting [5,1,0]");
let req = S.connect_request("example.com", 443);
assert(strcharcodeat(req,0) == 5 and strcharcodeat(req,1) == 1 and strcharcodeat(req,3) == 3, "CONNECT to a domain target");
assert(strcharcodeat(req,4) == 11, "domain length byte = len('example.com')");
let n = 11;
assert(strcharcodeat(req, 5+n) == 1 and strcharcodeat(req, 5+n+1) == 187, "port 443 big-endian = (1,187)");
assert(S.method_ok(S.parse_method_reply(strfromcharcode(5)+strfromcharcode(0))), "no-auth accepted");
assert(not S.method_ok(S.parse_method_reply(strfromcharcode(5)+strfromcharcode(255))), "no acceptable method -> rejected");
assert(S.connect_ok(S.parse_connect_reply(strfromcharcode(5)+strfromcharcode(0)+strfromcharcode(0))), "CONNECT success (rep 0)");
assert(not S.connect_ok(S.parse_connect_reply(strfromcharcode(5)+strfromcharcode(5))), "CONNECT refused (rep 5)");
assert(S.rep_text(5) == "connection refused", "reply code text");
print "socks5_pass";
