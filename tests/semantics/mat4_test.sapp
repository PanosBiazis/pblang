// tests/semantics/mat4_test.sapp — stdlib/mat4.sapp
//
// 4x4 matrix math for 3D (the transform2d analog one dimension up): model transforms,
// view (look_at), and projection (perspective/ortho) — the MVP a GPU 3D pipeline needs.
// Row-major 16-float storage; to_f32 emits column-major for GPU upload. Pure + testable.

let M = import("stdlib/mat4.sapp");

fn fail(m) { throw "FAIL " + m; }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "]"); } }

// ── identity / translate / scale ────────────────────────────────────────────────────
let p0 = M.transform(M.identity(), 1, 2, 3, 1);
approx(p0.x, 1, "id x"); approx(p0.y, 2, "id y"); approx(p0.z, 3, "id z"); approx(p0.w, 1, "id w");

let pt = M.transform(M.translate(10, 20, 30), 0, 0, 0, 1);
approx(pt.x, 10, "translate x"); approx(pt.y, 20, "translate y"); approx(pt.z, 30, "translate z");

let ps = M.transform(M.scale(2, 3, 4), 1, 1, 1, 1);
approx(ps.x, 2, "scale x"); approx(ps.y, 3, "scale y"); approx(ps.z, 4, "scale z");

// ── rotate about Z: (1,0,0) -> (0,1,0) ──────────────────────────────────────────────
let pr = M.transform(M.rotate_z(M.deg(90)), 1, 0, 0, 1);
approx(pr.x, 0, "rotz x"); approx(pr.y, 1, "rotz y");
// rotate about Y: (1,0,0) -> (0,0,-1)
let pry = M.transform(M.rotate_y(M.deg(90)), 1, 0, 0, 1);
approx(pry.z, 0 - 1, "roty z");

// ── multiply composes: translate AFTER scale (T*S) ──────────────────────────────────
let ts = M.multiply(M.translate(100, 0, 0), M.scale(2, 2, 2));
let pc = M.transform(ts, 3, 4, 5, 1);
approx(pc.x, 106, "compose x = 100 + 2*3"); approx(pc.y, 8, "compose y = 2*4");

// ── projection sanity ───────────────────────────────────────────────────────────────
// ortho maps the near-plane center to the origin in NDC
let o = M.ortho(0 - 1, 1, 0 - 1, 1, 0 - 1, 1);
let oc = M.transform(o, 0, 0, 0, 1);
approx(oc.x, 0, "ortho center x -> 0"); approx(oc.y, 0, "ortho center y -> 0");
// perspective produces a w that carries -z (so the GPU divides by depth)
let per = M.perspective(M.deg(60), 1.0, 0.1, 100.0);
let pp = M.transform(per, 0, 0, 0 - 5, 1);
approx(pp.w, 5, "perspective w = -z = 5");

// ── to_f32: 16 floats, column-major for GPU upload ──────────────────────────────────
let f = M.to_f32(M.translate(7, 8, 9));
eq(len(f), 16, "16 floats");
// column-major: translation lands in the last COLUMN = indices 12,13,14
approx(f[12], 7, "col-major tx at 12"); approx(f[13], 8, "ty at 13"); approx(f[14], 9, "tz at 14");

// ── look_at: an eye down +Z looking at the origin puts the origin in front (z negative) ─
let view = M.look_at(map{ x: 0, y: 0, z: 5 }, map{ x: 0, y: 0, z: 0 }, map{ x: 0, y: 1, z: 0 });
let vo = M.transform(view, 0, 0, 0, 1);
approx(vo.z, 0 - 5, "origin is 5 units in front of the camera");
approx(vo.x, 0, "origin stays centered x"); approx(vo.y, 0, "origin stays centered y");

print "mat4_pass";
