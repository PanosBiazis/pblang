let V=import("stdlib:study_mix_view.sapp");let UI=import("stdlib:modern_ui.sapp");let G=import("stdlib:gui.sapp");let e=V.build();for w in e.form.widgets{assert(w.x+w.w<=e.form.w and w.y+w.h<=e.form.h,"native controls fit");}let seed=G.get(e.form,"seed");seed.value="1";V.act(e.form,e.state,"mix");assert(e.state.report.seed==1 and e.state.can_save,"apply seed");seed.value="bad";V.act(e.form,e.state,"mix");assert(not e.state.can_save and e.state.report.seed==1,"failed mix retains previous selection and blocks save");for t in ["native","web","android"]{let view=V.view(V.sample(),4,42);let encoded=json_stringify(view);assert(not str_contains(encoded,"Reusable models?") and not str_contains(encoded,"One contract across products."),"metadata view excludes content");assert(len(UI.compile(view,map{target:t,width:412,height:915}).records)>0,"portable view");}print "study_mix_view_pass";
