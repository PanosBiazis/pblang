let I=import("stdlib:measure_table.sapp");let M=import("stdlib:measure_document.sapp");let S=import("stdlib:sheet_document.sapp");let C=import("stdlib:sheet_csv.sapp");
fn rejects(f) {assert((try (fn(){f();return false;})() catch true),"invalid table rejected");}
let doc=M.set_row(M.create("Μετρήσεις"),0,"Αύξηση",10,"degC","degF","difference");
let input=I.to_input_sheet(doc);assert(I.from_sheet(input,doc.title)==doc,"editable input roundtrip");
let report=M.to_sheet(doc);report.cells[1][5]="=99+99";assert(M.results(I.from_sheet(report))==[18],"report result ignored and recomputed literally");
let reordered=S.create(2,6);reordered.cells=[["Mode","To","Result","Label","From","Value"],["absolute","degF","bad","Δωμάτιο","degC","20"]];
assert(M.results(I.from_sheet(reordered))==[68],"exact header mapping independent of order");
let before=S.encode(reordered);let converted=I.from_sheet(reordered);converted.rows[0].label="Changed";assert(S.encode(reordered)==before,"detached import");
for pair in [["+1",1],["-.5",-0.5],["1.",1],["1e-9",0.000000001],["2E+2",200],["-0",0]] {
 let table=S.copy(input);table.cells[1][1]=pair[0];table.cells[1][2]="m";table.cells[1][3]="m";assert(I.from_sheet(table).rows[0].value==pair[1],"decimal spelling");
}
for text in [""," "," 1","1 ","1,5","1,000","=1+2","0x10","NaN","Infinity","1e","1e+",".e2","+","1..2","1e999","1e-999","1000000000001",str_repeat("0",65),"１２"] {
 let table=S.copy(input);table.cells[1][1]=text;rejects(fn(){I.from_sheet(table);});
}
for headers in [["Label","Value","From","To","To"],["label","Value","From","To","Mode"],["Label","Value","From","To","Result"],["Label","Value","From","To","Mode","Unexpected"]] {
 let table=S.create(2,len(headers));table.cells[0]=headers;rejects(fn(){I.from_sheet(table);});
}
rejects(fn(){I.from_sheet(S.create(1,5));});rejects(fn(){I.from_sheet(nil);});rejects(fn(){I.from_sheet(input,"");});
for change in [[2,"unknown"],[3,"kg"],[4,"auto"],[0,""]] {let table=S.copy(input);table.cells[1][change[0]]=change[1];rejects(fn(){I.from_sheet(table);});}
let cold=S.copy(input);cold.cells[1]=["Cold","-274","degC","K","absolute"];rejects(fn(){I.from_sheet(cold);});cold.cells[1][4]="difference";assert(M.results(I.from_sheet(cold))==[-274],"signed differences allowed");
let maximum=M.create();for i in range(1,31){maximum=M.append(maximum);}let table=I.to_input_sheet(maximum);
assert(I.from_sheet(C.decode(C.encode(table)),maximum.title)==maximum,"maximum 31 rows CSV roundtrip");
let bad=S.copy(table);bad.cells[31][3]="kg";let encoded=S.encode(bad);rejects(fn(){I.from_sheet(bad);});assert(S.encode(bad)==encoded,"last invalid row leaves input unchanged");
print "measure_table_pass";
