let graph = import("stdlib:graph.sapp");

fn position(values, target) {
    let i = 0;
    while i < len(values) {
        if values[i] == target { return i; }
        i = i + 1;
    }
    return -1;
}

// Create directed graph
let g = graph.new(true);
graph.add_node(g, "A", map{ label: "Node A" });
graph.add_node(g, "B", map{ label: "Node B" });
graph.add_node(g, "C", map{ label: "Node C" });
graph.add_edge(g, "A", "B", 1.0);
graph.add_edge(g, "B", "C", 2.0);
graph.add_edge(g, "A", "C", 5.0);

assert(graph.node_count(g) == 3, "node count should be 3");
assert(graph.edge_count(g) >= 3, "edge count should be >= 3");

// BFS
let bfs_result = graph.bfs(g, "A");
assert(len(bfs_result) == 3, "BFS should visit all 3 nodes");
assert(bfs_result[0] == "A", "BFS should start at A");

// DFS
let dfs_result = graph.dfs(g, "A");
assert(len(dfs_result) == 3, "DFS should visit all 3 nodes");

// Dijkstra
let dist = graph.dijkstra(g, "A");
assert(dist.A == 0.0, "distance to A should be 0");
assert(dist.B == 1.0, "distance to B should be 1");
assert(dist.C == 3.0, "distance to C via B should be 3: " + str(dist.C));

let disconnected = graph.new(true);
graph.add_edge(disconnected, "A", "B", 1);
graph.add_node(disconnected, "D", map{});
let disconnected_dist = graph.dijkstra(disconnected, "A");
assert(disconnected_dist.D == 999999999.0, "unreachable nodes retain the compatibility sentinel");

// Topological sort (DAG)
let sorted = graph.topological_sort(g);
assert(sorted != nil, "DAG should have valid topo sort");
assert(len(sorted) == 3, "topo sort should include all nodes");
assert(sorted[0] == "A", "A should come first in topo sort");

// Cycle detection
assert(graph.has_cycle(g) == false, "this DAG should have no cycle");

// Add a cycle
graph.add_edge(g, "C", "A", 1.0);
assert(graph.has_cycle(g) == true, "adding C->A creates a cycle");

let negative = graph.new(true);
graph.add_edge(negative, "A", "B", -1);
assert(try graph.dijkstra(negative, "A") catch "negative", "negative", "negative weights must fail closed");

// Undirected graph
let ug = graph.new(false);
graph.add_edge(ug, "X", "Y", 1.0);
graph.add_edge(ug, "Y", "Z", 1.0);
let n = graph.neighbors(ug, "Y");
assert(len(n) == 2, "Y should have 2 neighbors in undirected graph: " + str(len(n)));
assert(graph.has_cycle(ug) == false, "undirected chain should not have a cycle");
graph.add_edge(ug, "Z", "X", 1.0);
assert(graph.has_cycle(ug) == true, "undirected triangle should have a cycle");

// Exercise the non-recursive path beyond typical call-stack depths.
let deep = graph.new(false);
let i = 0;
while i < 1200 {
    graph.add_edge(deep, "u" + str(i), "u" + str(i + 1), 1);
    i = i + 1;
}
assert(graph.has_cycle(deep) == false, "deep undirected chain should not recurse or report a cycle");

// Kahn's queue is head-indexed: this wide dependency chain remains O(V+E).
let dag = graph.new(true);
i = 0;
while i < 600 {
    graph.add_edge(dag, "d" + str(i), "d" + str(i + 1), 1);
    i = i + 1;
}
let dag_order = graph.topological_sort(dag);
assert(len(dag_order) == 601, "large DAG should include every node");
assert(position(dag_order, "d0") < position(dag_order, "d300"), "topological dependency d0 before d300");
assert(position(dag_order, "d300") < position(dag_order, "d600"), "topological dependency d300 before d600");

print "graph stdlib tests passed";
