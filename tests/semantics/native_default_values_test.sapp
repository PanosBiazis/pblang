if platform()!="linux" {print "native_default_values_skip_linux_required";os_exit(0);}
let N=import("stdlib:compiler/native_pbck.sapp");let F=import("stdlib:compiler/selfhost_frontend.sapp");
let P=import("stdlib:selfhost_pbck.sapp");let X=import("stdlib:selfhost_to_pbck.sapp");
let U=import("stdlib:uuid.sapp");let exe=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let file=path_join(cwd(),".default_values_"+U.v4()+".pbck");
fn check(source,expected) {
    let compiled=F.frontend_compile(source);assert(compiled.ok,"native default fixture compiles");
    for bytes in [N.compile_source(source),X.translate_optimized(compiled.chunk),X.translate(P.deserialize_chunk(P.serialize_chunk(compiled.chunk)))] {
        fs_write_bytes(file,bytes);
        let r=proc_spawn_wait("/usr/bin/timeout",["-k","1s","15s",exe,"run",file,"--deny-net","--deny-http","--deny-exec","--deny-ffi","--deny-spawn"]);
        fs_remove(file);assert(r.exit_code==0 and r.stdout==expected,"native missing argument defaults: "+r.stdout+r.stderr);
    }
}
fn exercise() {
    check("fn f(x=7){return x;}print [f(),f(nil),f(0),f(false),f(\"\")];","[7, nil, 0, false, ]\n");
    check("fn f(a,b=2,c=3,d=4,e=5){return [a,b,c,d,e];}print f(1,nil);print f(1,2,nil,0,false);","[1, nil, 3, 4, 5]\n[1, 2, nil, 0, false]\n");
    check("fn f(x=7){return fn(){return x;};}print [f()(),f(nil)()];","[7, nil]\n");
    check("fn outer(n){fn inner(x=7){return [n,x];}return inner;}let f=outer(2);print [f(),f(nil)];","[[2, 7], [2, nil]]\n");
    check("fn f(a=false,b=0,c=\"γειά😀\",d=nil,e=-1.25){print [a,b,c,d,e];}f();","[false, 0, γειά😀, nil, -1.25]\n");
    check("fn f(x=7){return x;}let p=map{run:f};print (try [p.run(),p.run(nil)] catch 9);","[7, nil]\n");
}
let ok=try {exercise();true} catch false;try fs_remove(file) catch nil;
assert(ok,"native default regression");print "native_default_values_pass";
