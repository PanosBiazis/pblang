let Env = import("stdlib:env.sapp");

fn require(condition, message) {
    if not condition { throw "FAIL env_virtual: " + message; }
}
fn rejected(body) { return try { body(); false } catch true; }

Env.unset("PB_ENV_LOAD_TEST");
Env.unset("PB_ENV_EMPTY");
let loaded = Env.load("tests/fixtures/env_virtual.env");
require(loaded.ok and loaded.loaded == 2, "bounded .env load");
require(Env.get("PB_ENV_LOAD_TEST") == "loaded" and Env.get("PB_ENV_EMPTY") == "",
    "loaded values remain local, including empty values");
require(Env.all().PB_ENV_LOAD_TEST == "loaded", "loaded values are enumerable");
Env.unset("PB_ENV_LOAD_TEST");
Env.unset("PB_ENV_EMPTY");

let first = Env.virtual(map{ PBREMOTE_MODE: "private", retries: 3 });
let second = Env.virtual();
require(Env.virtual_get(first, "PBREMOTE_MODE") == "private"
    and Env.virtual_get(first, "retries") == "3",
    "initial values");
require(Env.virtual_get(second, "PBREMOTE_MODE") == nil, "isolated stores");
require(Env.virtual_set(first, "ui.scale", "compact") == nil
    and Env.virtual_get(first, "ui.scale") == "compact",
    "bounded set/get");
require(Env.virtual_has(first, "ui.scale") and Env.virtual_unset(first, "ui.scale")
    and not Env.virtual_has(first, "ui.scale") and not Env.virtual_unset(first, "ui.scale"),
    "unset semantics");

let snapshot = Env.virtual_all(first); snapshot.PBREMOTE_MODE = "mutated";
require(Env.virtual_get(first, "PBREMOTE_MODE") == "private", "snapshot must not alias store");
let usage = Env.virtual_usage(first);
require(usage.entries == 2 and usage.bytes > 0
    and Env.virtual_keys(first) == ["PBREMOTE_MODE", "retries"],
    "deterministic inventory");
require(not first.host_environment_access and not first.process_environment_mutation,
    "host isolation contract");

require(rejected(fn() { Env.virtual_get(first, ""); }), "empty key accepted");
require(rejected(fn() { Env.virtual_set(first, "1BAD", "x"); }), "invalid first key byte accepted");
require(rejected(fn() { Env.virtual_set(first, "BAD/KEY", "x"); }), "non-portable key accepted");
require(rejected(fn() { Env.virtual_set(first, "GOOD", "bad\x00value"); }), "NUL value accepted");
require(rejected(fn() { Env.virtual_set(first, str_repeat("K", Env.MAX_KEY_BYTES + 1), "x"); }),
    "oversized key accepted");
require(rejected(fn() { Env.virtual_set(first, "BIG", str_repeat("x", Env.MAX_VALUE_BYTES + 1)); }),
    "oversized value accepted");

let bounded = Env.virtual(); let i = 0;
while i < Env.MAX_ENTRIES {
    Env.virtual_set(bounded, "K" + str(i), "v"); i = i + 1;
}
require(rejected(fn() { Env.virtual_set(bounded, "OVERFLOW", "v"); }),
    "entry quota not enforced");
require(Env.virtual_usage(bounded).entries == Env.MAX_ENTRIES, "failed write mutated store");

print "env_virtual_pass";
