// tests/semantics/pbai_reliability_persist_test.sapp — the ensemble's learned calibration
// survives a restart. save_stats(path)/load_stats(path) persist per-voter reliability to JSON so
// pbAI keeps trusting the models that have proven accurate across sessions.

let pbai = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let path = "tests/semantics/_tmp_ens_stats.json";

// train up some reliability history
pbai.clear_voters();
pbai.reset_stats();
pbai.register_voter("good", fn(x) { return "bugs"; });
pbai.register_voter("bad", fn(x) { return "explain"; });
let i = 0;
while i < 5 { pbai.ensemble_detail("x"); pbai.record_outcome("bugs"); i = i + 1; }
let rg = pbai.reliability("good");
let rb = pbai.reliability("bad");
if rg <= rb { fail("precondition: good more reliable"); }

// save -> wipe -> the wipe really forgets -> load -> restored
eq(pbai.save_stats(path), true, "save_stats succeeds");
pbai.reset_stats();
approx(pbai.reliability("good"), 0.5, "after reset, reliability is neutral again");
eq(pbai.load_stats(path), true, "load_stats succeeds");
approx(pbai.reliability("good"), rg, "good reliability restored from disk");
approx(pbai.reliability("bad"), rb, "bad reliability restored from disk");

// loading a missing file is a graceful no-op (returns false, keeps current stats)
eq(pbai.load_stats("tests/semantics/_does_not_exist_xyz.json"), false, "missing file -> false");
approx(pbai.reliability("good"), rg, "stats unchanged after failed load");

// cleanup
fs_remove(path);
pbai.clear_voters();
pbai.reset_stats();
print "pbai_reliability_persist_pass";
