// tests/semantics/url_test.sapp — stdlib/url.sapp
import "stdlib:url.sapp";

// full parse
let u = url.parse("https://example.com:8080/a/b?x=1&y=two#top");
if u.scheme != "https" { throw "FAIL scheme: " + u.scheme; }
if u.host != "example.com" { throw "FAIL host: " + u.host; }
if u.port != 8080 { throw "FAIL port: " + str(u.port); }
if u.path != "/a/b" { throw "FAIL path: " + u.path; }
if u.query != "x=1&y=two" { throw "FAIL query: " + u.query; }
if u.fragment != "top" { throw "FAIL fragment: " + u.fragment; }
if u.params.x != "1" or u.params.y != "two" { throw "FAIL params: " + str(u.params); }

// no port / no query / no fragment
let u2 = url.parse("http://host/path");
if u2.host != "host" or u2.path != "/path" or u2.port != nil { throw "FAIL minimal: " + str(u2); }

// query parsing with encoded values (+ → space, %XX)
let q = url.parse_query("name=John+Doe&city=S%C3%A3o");
if q.name != "John Doe" { throw "FAIL query decode space: " + q.name; }
if q.city != "São" { throw "FAIL query decode utf8: " + q.city; }

// build_query encodes
let qs = url.build_query(map{ q: "a b", page: "2" });
// key order is map iteration order; assert both present and round-trip
let rt = url.parse_query(qs);
if rt.q != "a b" or rt.page != "2" { throw "FAIL build_query round-trip: " + qs; }

// build round-trips parse
let built = url.build(u);
let u3 = url.parse(built);
if u3.scheme != "https" or u3.host != "example.com" or u3.port != 8080 { throw "FAIL build/parse: " + built; }
if u3.path != "/a/b" or u3.fragment != "top" { throw "FAIL build/parse 2: " + built; }

// build from params (no explicit query)
let made = url.build(map{ scheme: "https", host: "api.test", path: "/v1", params: map{ key: "abc" } });
if made != "https://api.test/v1?key=abc" { throw "FAIL build from params: " + made; }

print "url_pass";
