// tests/semantics/text_layout_test.sapp — pblang-native shaping/layout layer.

let TL = import("stdlib/text_layout.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " missing=" + sub + " in " + s); } }

eq(TL.apply_code_ligatures("a->b != c"), "a→ b ≠  c", "code ligatures preserve cells");
eq(len(TL.apply_code_ligatures("a->b")), len("a->b"), "arrow ligature keeps scalar count");

let accented = "e\u{0301}";
let cs = TL.clusters(accented);
eq(len(cs), 1, "combining accent joins base cluster");
eq(cs[0].width, 1, "combined cluster occupies one cell");

let family = "👨\u{200D}👩\u{200D}👧";
let ecs = TL.clusters(family);
eq(len(ecs), 1, "ZWJ emoji sequence stays one cluster");
if not ecs[0].emoji { fail("ZWJ cluster marked emoji"); }

eq(TL.base_direction("abc שלום"), "ltr", "mixed text remains ltr when ltr dominates");
eq(TL.base_direction("שלום"), "rtl", "Hebrew-only text is rtl");
eq(TL.visual_text("abc שלום", map{ direction: "ltr" }), "abc םולש", "RTL run is reversed for visual order");

let shaped = TL.shape("fn add(a,b) { return a != b; }", map{ mode: "code" });
eq(shaped.format, "pblang.text.shape.v1", "shape format");
has(shaped.visual, "≠", "shape applies code ligature");
if shaped.measure.clusters <= 0 { fail("shape carries measurement"); }

print "text_layout_pass";
