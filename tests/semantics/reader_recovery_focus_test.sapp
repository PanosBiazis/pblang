let App=import("../../examples/declarative_browser/app.sapp");let GUI=import("stdlib:gui.sapp");let Profile=import("../../examples/declarative_browser/appearance_profile.sapp");
let n=0;fn check(ok,label) {assert(ok,label);n=n+1;}
fn event(c,t,k) {App.update(c,[map{type:t,key:k}]);}
fn key(c,k) {event(c,"keydown",k);event(c,"keyup",k);}
fn focus(c,name) {c.focus_target=name;App.refresh(c);}
for height in [240,288,320,480,816] {
    for recovery in [true,false] {
        for failure in ["reload","attempted"] {
            let state=map{writes:0,reads:0};let saved=Profile.defaults();saved.font_family="monospace";
            let saver=fn(style){state.writes=state.writes+1;let result=map{ok:false};result[failure]=true;return result;};
            let c=App.create();c.width=320;c.height=height;
            let loader=fn(){state.reads=state.reads+1;return map{ok:true,appearance:saved,save:saver};};
            let reloads=[nil,loader];let reload=reloads[if recovery {1}else{0}];
            App.enable_preferences(c,nil,saver,"Ready",reload);c.settings=true;focus(c,"font_family");key(c,"Enter");
            let draft=c.preferences.draft;let applied=c.appearance;let anchor=c.reading_anchor;let history=json_stringify(c.reading_history);
            focus(c,"style_save");event(c,"keydown","Enter");
            let target="style_apply";if recovery {target="style_reload";}
            check(c.form.focus==target,"failed Save focuses recovery at height "+str(height)+" / "+failure+" / "+str(recovery));
            let button=GUI.get(c.form,target);check(button!=nil and button.enabled and button.y>=0 and button.y+button.h<=height,"recovery action visible and enabled");
            check(c.preferences.save==nil and c.preferences.draft==draft and c.appearance==applied,"blocked saver and both styles retained");
            check(state.writes==1 and state.reads==0,"moving focus does not reload or save");
            check(c.reading_anchor==anchor and json_stringify(c.reading_history)==history,"reading state retained");
            let message=c.preferences.message;
            for i 3 {event(c,"keydown","Enter");check(state.writes==1 and state.reads==0 and c.appearance==applied,"held Enter cannot run recovery "+str(i));}
            check(c.preferences.message==message,"held Enter retains error explanation");
            event(c,"keyup","Enter");key(c,"Enter");
            if recovery {check(state.reads==1 and state.writes==1 and c.appearance==saved and c.preferences.save!=nil,"separate press explicitly reloads without saving");}
            else {check(state.reads==0 and state.writes==1 and c.appearance==draft,"separate press explicitly applies without saving");}
            check(c.form.focus==target,"explicit recovery retains its focus");
            key(c,"Escape");check(not c.settings and c.form.focus=="appearance" and not c.form.close_requested,"Escape still returns to reading");c.session.close();
        }
    }
}
// A retryable failure must keep Save focused and available.
let retry=App.create();let calls=map{writes:0};App.enable_preferences(retry,nil,fn(style){calls.writes=calls.writes+1;return map{ok:false,history_full:true};});retry.settings=true;focus(retry,"style_save");key(retry,"Enter");
check(retry.form.focus=="style_save" and retry.preferences.save!=nil and calls.writes==1,"retryable failure leaves Save focused");retry.session.close();
// A programmatic failed reload while Save is focused needs the same visible recovery.
let c=App.create();App.enable_preferences(c,nil,fn(style){return map{ok:true};},"Ready",fn(){return map{ok:false};});c.settings=true;focus(c,"style_save");
check(not App.reload_preferences(c),"synthetic reload rejected");App.update(c,[]);check(c.form.focus=="style_reload","programmatic failure also recovers Save focus");
focus(c,"body_size");App.reload_preferences(c);App.update(c,[]);check(c.form.focus=="body_size","unrelated valid focus is not stolen");
c.settings=false;c.focus_target="style_save";App.refresh(c);check(c.form.focus==nil,"document focus restoration unchanged");c.session.close();
print "reader_recovery_focus_pass checks="+str(n);
