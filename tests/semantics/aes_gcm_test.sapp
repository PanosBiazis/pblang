let A = import("stdlib:aes_gcm.sapp");
fn fail(m) { throw "FAIL aes_gcm: " + m; }
fn eq(a,b,m) { if a != b { fail(m + " got=" + str(a)); } }

let zero32=[]; for i 32 { zero32[i]=0; }
let zero16=[]; for i 16 { zero16[i]=0; }
let zero12=[]; for i 12 { zero12[i]=0; }
eq(A.bytes_hex(A.aes256_encrypt_block(zero16,zero32)),
   "dc95c078a2408989ad48a21492842087", "AES-256 block vector");

let empty=A.aes256_gcm_encrypt_bytes([],zero32,zero12);
eq(A.bytes_hex(empty.ciphertext),"","empty GCM ciphertext");
eq(A.bytes_hex(empty.tag),"530f8afbc74536b9a963b4f1c4cb738b","empty GCM tag");
let one=A.aes256_gcm_encrypt_bytes(zero16,zero32,zero12);
eq(A.bytes_hex(one.ciphertext),"cea7403d4d606b6e074ec5d3baf39d18","GCM ciphertext vector");
eq(A.bytes_hex(one.tag),"d0d1c8a799996bf0265b98b5d48ab919","GCM tag vector");
eq(A.aes256_gcm_decrypt_bytes(one.ciphertext,zero32,zero12,one.tag).plaintext,zero16,"GCM decrypt");
let bad=A.hex_bytes(A.bytes_hex(one.tag)); bad[0]=bit_xor(bad[0],1);
eq(A.aes256_gcm_decrypt_bytes(one.ciphertext,zero32,zero12,bad).ok,false,"GCM tamper rejection");

eq(A.bytes_hex(A.hmac_sha256_bytes(str_to_bytes("Hi There"), [
    0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,
    0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,0x0b,0x0b])),
   "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7","HMAC RFC vector");
eq(A.bytes_hex(A.pbkdf2_hmac_sha256(str_to_bytes("password"),str_to_bytes("salt"),1,32)),
   "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b","PBKDF2 c=1");
eq(A.bytes_hex(A.pbkdf2_hmac_sha256(str_to_bytes("password"),str_to_bytes("salt"),2,32)),
   "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43","PBKDF2 c=2");
let sequential_key=[]; for i 32 { sequential_key[i]=i; }
let sequential_iv=[]; for i 12 { sequential_iv[i]=i; }
let binary=[0,255,1,2,3,4,5]; let aad=str_to_bytes("pb-mcp-aad-v1");
let with_aad=A.aes256_gcm_encrypt_bytes_with_aad(binary,sequential_key,sequential_iv,aad);
eq(A.bytes_hex(with_aad.ciphertext),"47fdd719c6e1c7","binary AAD ciphertext oracle");
eq(A.bytes_hex(with_aad.tag),"82c4ba378e661fdebefcd138f795266e","binary AAD tag oracle");
eq(A.aes256_gcm_decrypt_bytes_with_aad(with_aad.ciphertext,sequential_key,sequential_iv,with_aad.tag,aad).plaintext,
   binary,"binary AAD decrypt oracle");
print "aes_gcm_pass";
