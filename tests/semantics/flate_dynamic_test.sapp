// Test: dynamic-Huffman DEFLATE encoder in flate.sapp.
//
// deflate() now builds an LZ77 token stream once and emits whichever of
// {stored, fixed-Huffman, dynamic-Huffman} is smallest — so the ratio never
// regresses and improves on skewed data. Correctness is proven by in-process
// round-trip through the existing inflate() (which already decodes all three
// block types), plus interop with the system gzip if present.

let F = import("stdlib:flate.sapp");

fn eq(a, b, msg) {
    if a != b { return error("FAIL " + msg + ": got " + str(a) + ", want " + str(b)); }
}

fn bytes_eq(a, b, msg) {
    eq(len(a), len(b), msg + " (length)");
    let i = 0;
    while i < len(a) {
        if a[i] != b[i] { return error("FAIL " + msg + " at byte " + str(i) + ": " + str(a[i]) + " != " + str(b[i])); }
        i = i + 1;
    }
}

// BTYPE of the first block: byte0 bit0 = BFINAL, bits1-2 = BTYPE (LSB-first).
fn first_btype(blob) {
    return bit_and(bit_shr(blob[0], 1), 3);
}

fn roundtrip(bytes, msg) {
    let comp = F.deflate(bytes);
    let back = F.inflate(comp);
    bytes_eq(back, bytes, msg);
}

// ── round-trip battery, including every edge case ─────────────────────────────
roundtrip([], "empty");
roundtrip([65], "single byte");
roundtrip([65, 65, 65, 65, 65, 65, 65, 65], "all same");
roundtrip(str_to_bytes("hello, hello, hello, world!"), "short repetitive text");

// all 256 byte values
let allb = [];
let v = 0;
while v < 256 { array_push(allb, v); v = v + 1; }
roundtrip(allb, "all 256 byte values");

// longer natural-ish text with real matches
let txt = "";
let r = 0;
while r < 20 {
    txt = txt + "the quick brown fox jumps over the lazy dog. ";
    r = r + 1;
}
roundtrip(str_to_bytes(txt), "long repetitive english");

// ── skewed literal distribution → dynamic Huffman should win and be chosen ───
// LCG-generated text over a small, heavily skewed alphabet with few long
// repeats: literals dominate and their skew beats fixed's flat 8-9 bits.
let alpha = str_to_bytes("aaaaaaaabbbbccde");   // skewed frequency by repetition
let sk = [];
let seed = 12345;
let k = 0;
while k < 1400 {
    seed = num_mod(1103515245 * seed + 12345, 2147483648);
    let idx = num_mod(num_floor(seed / 65536), len(alpha));
    array_push(sk, alpha[idx]);
    k = k + 1;
}
let cs = F.deflate(sk);
roundtrip(sk, "skewed alphabet round-trip");
eq(first_btype(cs), 2, "skewed data uses a dynamic block");
// dynamic Huffman should compress this well below a byte per symbol
if len(cs) >= len(sk) * 6 / 10 {
    error("FAIL skewed ratio: " + str(len(cs)) + " bytes for " + str(len(sk)) + " (expected < 60%)");
}

// ── incompressible random data → no pathological blow-up (stored/fixed) ──────
let rnd = [];
let s2 = 99991;
let j = 0;
while j < 1200 {
    s2 = num_mod(1103515245 * s2 + 12345, 2147483648);
    array_push(rnd, num_mod(num_floor(s2 / 32768), 256));
    j = j + 1;
}
let cr = F.deflate(rnd);
roundtrip(rnd, "random data round-trip");
// stored/fixed guarantees at most ~ len + small overhead; never > len + 5%
if len(cr) > len(rnd) + len(rnd) / 20 + 16 {
    error("FAIL random blow-up: " + str(len(cr)) + " for " + str(len(rnd)));
}
let bt = first_btype(cr);
if bt != 0 and bt != 1 {
    error("FAIL random should pick stored(0) or fixed(1), got btype " + str(bt));
}

// ── gzip / zlib wrappers still round-trip over the new encoder ────────────────
let payload = str_to_bytes(txt);
bytes_eq(F.gzip_decode(F.gzip_encode(payload)), payload, "gzip round-trip");
bytes_eq(F.zlib_decode(F.zlib_encode(payload)), payload, "zlib round-trip");
bytes_eq(F.gzip_decode(F.gzip_encode(sk)), sk, "gzip round-trip skewed (dynamic)");

print "flate_dynamic_pass";
