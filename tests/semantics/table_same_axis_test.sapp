let G=import("stdlib:table_group.sapp");let Before=import("../../bench/fixtures/table_group_before_axis_reuse.sapp");let S=import("stdlib:sheet_document.sapp");let CSV=import("stdlib:sheet_csv.sapp");
let cases=0;
for header in [false,true]{for size in [1,2,8,16,32]{for categories in [1,2,7,8]{
 let doc=S.create(size,2);for r in range(0,size){doc.cells[r]=["group"+str(num_mod(r,categories)),"other"+str(num_mod(r,3))];}let original=S.encode(doc);
 for a in [0,1]{for b in [0,1]{let old=try Before.cross(doc,a,b,header) catch nil;let current=try G.cross(doc,a,b,header) catch nil;assert(old==current,"exact old/new result or rejection");assert(S.encode(doc)==original,"source unchanged");cases=cases+1;
  if current!=nil{let total=0;for r in range(1,len(current.cells)){for c in range(1,len(current.cells[r])){total=total+parse_number(current.cells[r][c]);if a==b and r!=c{assert(current.cells[r][c]=="0","diagonal off-axis zero");}}}assert(total==size-(if header {1} else {0}),"record conservation");current.cells[0][0]="changed";assert(S.encode(doc)==original,"detached result");}
 }}
}}}
let literal=CSV.decode("Axis\n\"\"\n \nα\n=1+1\n__proto__\nα\n");assert(G.cross(literal,0,0,true)==Before.cross(literal,0,0,true),"literal categories");
for bad in [-1,2,0.5,"0",nil]{assert((try G.cross(literal,bad,bad,true) catch nil)==nil,"equal invalid axes still reject");}
assert((try G.cross(literal,0,0,"header") catch nil)==nil,"header remains explicit");let malformed=map{format:S.FORMAT,cells:[["a"],["b","c"]]};assert((try G.cross(malformed,0,0,false) catch nil)==nil,"same-axis still validates source");
let long=S.create(32,2);for r in range(0,32){long.cells[r]=[str_repeat("x",250)+str(num_mod(r,7)),"v"];}assert(G.cross(long,0,0,false)==Before.cross(long,0,0,false),"long labels");print "table_same_axis_pass cases="+str(cases);
