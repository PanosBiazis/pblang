let F = import("stdlib:functional.sapp");
fn expect(ok, label) { if not ok { throw "FAIL curry-contract: " + label; } }
let effects = [0];
let callback = fn(a, b, c, d) { effects[0] = effects[0] + 1; return a + b + c + d; };
let rejected = try map{ ok: true, value: F.curry(callback, 5) } catch map{ ok: false };
expect(not rejected.ok and effects[0] == 0, "unsupported positional arity rejected before collecting or calling");
for n in [-1, 1.5, "2", true, [], map{}] {
    let r = try map{ ok: true, value: F.curry(callback, n) } catch map{ ok: false };
    expect(not r.ok and effects[0] == 0, "invalid positional arity rejected");
}
expect(F.curry(fn() { return 7; }, 0) == 7, "zero arity remains immediate");
expect(F.curry(fn(x) { return x; }, 1)(8) == 8, "one argument");
expect(F.curry(fn(a, b) { return a - b; })(9)(2) == 7, "default two arguments");
expect(F.curry(fn(a, b) { return a - b; }, nil)(9)(2) == 7, "explicit nil default");
expect(F.curry(fn(a, b, c) { return [a, b, c]; }, 3)(1)(2)(3) == [1, 2, 3], "three argument order");
expect(F.curry(callback, 4)(1)(2)(3)(4) == 10 and effects[0] == 1, "four argument order and call count");
let partial = F.curry(fn(a, b, c) { return [a, b, c]; }, 3)(1);
expect(partial(2)(3) == [1, 2, 3] and partial(4)(5) == [1, 4, 5], "partial values can branch independently");
let failing = F.curry(fn(a) { throw 4; }, 1);
let failed = try map{ ok: true, value: failing(1) } catch map{ ok: false };
expect(not failed.ok, "callback exception propagates");
print "functional_curry_contract_pass";
