// Test: pbAI — pblang's own AI assistant (stdlib/pbai.sapp), §86.
//
// Unlike the kernel codegen tests, this RUNS in the pblang VM (pbai.sapp is pure pblang
// on nn.sapp — no kernel intrinsics). It verifies the neural intent classifier (the
// pbAI model) routes correctly and the grounded skills produce pblang-aware answers,
// entirely in-process with NO external model or network.

let pbai = import("stdlib/pbai.sapp");

// ── The neural intent classifier (the pbAI model) routes correctly ───────────────────
// ids: 0 explain  1 bugs  2 improve  3 comment  4 general
assert(pbai.classify("explain what this code does") == 0, "classifies an explain request");
assert(pbai.classify("find the bugs and errors here") == 1, "classifies a bug-finding request");
assert(pbai.classify("add comments to document this") == 3, "classifies a commenting request");

// ── Grounded code analysis: explain reports real structure ───────────────────────────
let ex = pbai.respond("Explain what this does:\n\nfn add(a, b) { return a + b; }\nfn main() { print add(2, 3); }");
assert(str_contains(ex, "2 function(s)"), "explain counts the functions");
assert(str_contains(ex, "add") and str_contains(ex, "main"), "explain lists the function names");

// ── pblang-aware bug review (catches things grounded in pblang itself) ───────────────
let bugs = pbai.respond("Find bugs:\n\nfn g() { let m = map{ a: 1 }; print m[b]; (x }");
assert(str_contains(bugs, "unbalanced"), "review flags unbalanced parens/braces");
assert(str_contains(bugs, "map_has"), "review knows missing-map-key reads RAISE (a pblang gotcha)");

// ── A tool hint overrides routing ────────────────────────────────────────────────────
let crit = pbai.respond_tool("ai_self_critique", "look at this:\n\nfn h() { (a }");
assert(str_contains(crit, "review"), "ai_self_critique routes to the review skill");

// ── General pblang knowledge ─────────────────────────────────────────────────────────
let gen = pbai.respond("How do maps work in pblang?");
assert(str_contains(gen, "map_has"), "general Q&A answers from pblang knowledge");

print "pbai_pass";
