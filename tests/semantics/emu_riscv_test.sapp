// emu_riscv_test.sapp — a verified RISC-V RV64I(+M) execution model in pblang.
//
// Part of the emulator suite that lets pblang codegen for ANY target be RUN-tested on this x86-64 host (no
// cross-hardware, no qemu). RISC-V is the clean, open, fixed-32-bit register ISA — a natural next backend and a
// good "modern/future" representative. This file carries BOTH an encoder (so programs read clearly and the field
// layout is checkable against the spec) and an interpreter (so programs are verified by their COMPUTED RESULT).

fn fail(m) { throw "FAIL emu-riscv: " + m; }
fn _le32(w) { return [w % 256, num_floor(w / 256) % 256, num_floor(w / 65536) % 256, num_floor(w / 16777216) % 256]; }
fn _cat(a, b) { let i = 0; while i < len(b) { push(a, b[i]); i = i + 1; } return a; }

// ── encoder (RV64I + M subset) ───────────────────────────────────────────────────────────────────────────────
fn rv_addi(rd, rs1, imm) { let i = imm; if i < 0 { i = i + 4096; } return _le32(i * 1048576 + rs1 * 32768 + rd * 128 + 19); }        // op 0x13
fn rv_add(rd, rs1, rs2)  { return _le32(rs2 * 1048576 + rs1 * 32768 + rd * 128 + 51); }                                             // op 0x33 funct7 0
fn rv_sub(rd, rs1, rs2)  { return _le32(32 * 33554432 + rs2 * 1048576 + rs1 * 32768 + rd * 128 + 51); }                             // funct7 0x20
fn rv_mul(rd, rs1, rs2)  { return _le32(1 * 33554432 + rs2 * 1048576 + rs1 * 32768 + rd * 128 + 51); }                              // funct7 0x01 (M)
fn rv_lui(rd, imm20)     { return _le32(imm20 * 4096 + rd * 128 + 55); }                                                            // op 0x37
fn _btype(rs1, rs2, funct3, boff) {
    let imm = boff; if imm < 0 { imm = imm + 8192; }                                                                                // 13-bit two's complement
    let imm12 = num_floor(imm / 4096) % 2; let imm11 = num_floor(imm / 2048) % 2;
    let imm10_5 = num_floor(imm / 32) % 64; let imm4_1 = num_floor(imm / 2) % 16;
    return _le32(imm12 * 2147483648 + imm10_5 * 33554432 + rs2 * 1048576 + rs1 * 32768 + funct3 * 4096 + imm4_1 * 256 + imm11 * 128 + 99); // op 0x63
}
fn rv_beq(rs1, rs2, boff) { return _btype(rs1, rs2, 0, boff); }
fn rv_bne(rs1, rs2, boff) { return _btype(rs1, rs2, 1, boff); }
fn rv_jal(rd, boff) {
    let imm = boff; if imm < 0 { imm = imm + 2097152; }                                                                             // 21-bit
    let imm20 = num_floor(imm / 1048576) % 2; let imm19_12 = num_floor(imm / 4096) % 256;
    let imm11 = num_floor(imm / 2048) % 2; let imm10_1 = num_floor(imm / 2) % 1024;
    return _le32(imm20 * 2147483648 + imm10_1 * 2097152 + imm11 * 1048576 + imm19_12 * 4096 + rd * 128 + 111); // op 0x6F
}
fn rv_ecall() { return _le32(115); }   // op 0x73, imm 0

// ── interpreter (Linux exit via ecall: a7/x17 == 93 → return a0/x10 & 255) ────────────────────────────────────
fn _word(code, off) { return code[off] + code[off + 1] * 256 + code[off + 2] * 65536 + code[off + 3] * 16777216; }
fn _sx(v, bits) { let half = 1; let b = 0; while b < bits - 1 { half = half * 2; b = b + 1; } if v >= half { return v - half * 2; } return v; }
fn riscv_run(code) {
    let x = []; let r = 0; while r < 32 { push(x, 0); r = r + 1; }
    let nwords = num_floor(len(code) / 4); let pc = 0; let guard = 0; let result = 0; let halted = false;
    while pc >= 0 and pc < nwords and guard < 1000000 and not halted {
        guard = guard + 1;
        let word = _word(code, pc * 4);
        let op = word % 128;
        let rd = num_floor(word / 128) % 32;
        let funct3 = num_floor(word / 4096) % 8;
        let rs1 = num_floor(word / 32768) % 32;
        let rs2 = num_floor(word / 1048576) % 32;
        let funct7 = num_floor(word / 33554432) % 128;
        let next = pc + 1;
        if op == 19 {                                                            // addi
            let imm = _sx(num_floor(word / 1048576) % 4096, 12);
            if rd != 0 { x[rd] = x[rs1] + imm; }
        } else if op == 51 {                                                     // add / sub / mul
            let v = 0;
            if funct7 == 32 { v = x[rs1] - x[rs2]; } else if funct7 == 1 { v = x[rs1] * x[rs2]; } else { v = x[rs1] + x[rs2]; }
            if rd != 0 { x[rd] = v; }
        } else if op == 55 {                                                     // lui
            let imm20 = num_floor(word / 4096) % 1048576;
            if rd != 0 { x[rd] = imm20 * 4096; }
        } else if op == 99 {                                                     // beq / bne
            let imm12 = num_floor(word / 2147483648) % 2; let imm11 = num_floor(word / 128) % 2;
            let imm10_5 = num_floor(word / 33554432) % 64; let imm4_1 = num_floor(word / 256) % 16;
            let off = _sx(imm12 * 4096 + imm11 * 2048 + imm10_5 * 32 + imm4_1 * 2, 13);
            let take = false;
            if funct3 == 0 { if x[rs1] == x[rs2] { take = true; } } else { if x[rs1] != x[rs2] { take = true; } }
            if take { next = pc + num_floor(off / 4); }
        } else if op == 111 {                                                    // jal
            let imm20 = num_floor(word / 2147483648) % 2; let imm19_12 = num_floor(word / 4096) % 256;
            let imm11 = num_floor(word / 1048576) % 2; let imm10_1 = num_floor(word / 2097152) % 1024;
            let off = _sx(imm20 * 1048576 + imm19_12 * 4096 + imm11 * 2048 + imm10_1 * 2, 21);
            if rd != 0 { x[rd] = (pc + 1) * 4; }
            next = pc + num_floor(off / 4);
        } else if op == 115 {                                                    // ecall
            if x[17] == 93 { result = x[10]; halted = true; }
        } else { throw "riscv_run: unmodeled opcode " + str(op); }
        x[0] = 0;
        pc = next;
    }
    if not halted { if guard >= 1000000 { fail("instruction budget exceeded"); } fail("ran off the end without ecall-exit"); }
    let e = result % 256; if e < 0 { e = e + 256; } return e;
}

// ── encoder spec-checks (canonical hex from the RISC-V ISA manual) ──
fn eqword(bytes, want, m) { let w = bytes[0] + bytes[1] * 256 + bytes[2] * 65536 + bytes[3] * 16777216; if w != want { fail(m + ": got 0x" + str(w) + " want 0x" + str(want)); } }
eqword(rv_addi(1, 0, 5), 5243027, "addi x1,x0,5 = 0x00500093");    // 0x00500093 = 5243027
eqword(rv_ecall(), 115, "ecall = 0x73");

// ── programs verified by COMPUTED RESULT ──
fn prog(insns) { let c = []; let i = 0; while i < len(insns) { _cat(c, insns[i]); i = i + 1; } return c; }
fn eq(g, w, m) { if g != w { fail(m + ": got " + str(g) + " want " + str(w)); } }
let A7 = rv_addi(17, 0, 93);   // a7 = 93 (sys_exit)

eq(riscv_run(prog([A7, rv_addi(10, 0, 42), rv_ecall()])),                                    42, "addi const");
eq(riscv_run(prog([A7, rv_addi(5, 0, 5), rv_addi(6, 0, 7), rv_add(10, 5, 6), rv_ecall()])),  12, "add 5+7");
eq(riscv_run(prog([A7, rv_addi(5, 0, 20), rv_addi(6, 0, 8), rv_sub(10, 5, 6), rv_ecall()])), 12, "sub 20-8");
eq(riscv_run(prog([A7, rv_addi(5, 0, 6), rv_addi(6, 0, 7), rv_mul(10, 5, 6), rv_ecall()])),  42, "mul 6*7");
eq(riscv_run(prog([A7, rv_lui(5, 16), rv_addi(10, 5, 100), rv_ecall()])),                   100, "lui 0x10000 + 100, &255");
// loop: sum 5+4+3+2+1 = 15. layout (word indices): 0:A7 1:acc=0 2:cnt=5 3:beq end 4:add 5:addi-1 6:jal back 7:ecall
eq(riscv_run(prog([A7, rv_addi(10, 0, 0), rv_addi(5, 0, 5),
                   rv_beq(5, 0, 16), rv_add(10, 10, 5), rv_addi(5, 5, 0 - 1), rv_jal(0, 0 - 12),
                   rv_ecall()])),                                                             15, "loop sum 5..1");
// bne-driven countdown that also multiplies: factorial-ish 4*3*2*1 = 24
eq(riscv_run(prog([A7, rv_addi(10, 0, 1), rv_addi(5, 0, 4),
                   rv_beq(5, 0, 16), rv_mul(10, 10, 5), rv_addi(5, 5, 0 - 1), rv_jal(0, 0 - 12),
                   rv_ecall()])),                                                             24, "loop factorial 4!");

print "emu_riscv: RV64I+M encoder matches spec, all programs computed correctly on the in-pblang interpreter";
