let RV = import("stdlib:emulator_riscv64.sapp");
let A7 = RV.add_immediate(17, 0, 93);

fn word(bytes) { return bytes[0] + bytes[1] * 256 + bytes[2] * 65536 + bytes[3] * 16777216; }
fn value(instructions) {
    let result = RV.run(RV.program(instructions));
    if not result.ok { throw result.error; }
    return result.value;
}

assert(word(RV.add_immediate(1, 0, 5)) == 5243027, "canonical ADDI encoding");
assert(word(RV.environment_call()) == 115, "canonical ECALL encoding");
assert(value([A7, RV.add_immediate(10, 0, 42), RV.environment_call()]) == 42, "ADDI");
assert(value([A7, RV.add_immediate(5, 0, 5), RV.add_immediate(6, 0, 7), RV.add(10, 5, 6), RV.environment_call()]) == 12, "ADD");
assert(value([A7, RV.add_immediate(5, 0, 20), RV.add_immediate(6, 0, 8), RV.subtract(10, 5, 6), RV.environment_call()]) == 12, "SUB");
assert(value([A7, RV.add_immediate(5, 0, 6), RV.add_immediate(6, 0, 7), RV.multiply(10, 5, 6), RV.environment_call()]) == 42, "MUL");
assert(value([A7, RV.load_upper_immediate(5, 16), RV.add_immediate(10, 5, 100), RV.environment_call()]) == 100, "LUI");
assert(value([A7, RV.add_immediate(10, 0, 0), RV.add_immediate(5, 0, 5),
              RV.branch_equal(5, 0, 16), RV.add(10, 10, 5), RV.add_immediate(5, 5, -1),
              RV.jump_and_link(0, -12), RV.environment_call()]) == 15, "loop");

assert(not RV.run([115]).ok, "truncated instruction fails closed");
assert(not RV.run(RV.program([RV.branch_equal(0, 0, 4092)] )).ok, "out-of-range branch target fails closed");
assert(not RV.run(RV.program([RV.jump_and_link(0, 0)]), map{ instruction_budget: 4 }).ok, "loop budget enforced");
assert((try RV.add(32, 0, 0) catch nil) == nil, "invalid register rejected");
assert((try RV.branch_equal(0, 0, 2) catch nil) == nil, "unaligned branch rejected");

print "emu_riscv: reusable bounded RV64 safe-integer subset passed encodings, arithmetic, malformed control, and budget checks";
