let U = import("stdlib:linux_uinput.sapp");
let E = import("stdlib:input_events.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

eq(U.io("UI_DEV_CREATE"), 0x5501, "UI_DEV_CREATE");
eq(U.io("UI_DEV_DESTROY"), 0x5502, "UI_DEV_DESTROY");
eq(U.io("UI_DEV_SETUP"), 0x405C5503, "UI_DEV_SETUP");
eq(U.io("UI_SET_EVBIT"), 0x40045564, "UI_SET_EVBIT");
eq(U.io("UI_SET_KEYBIT"), 0x40045565, "UI_SET_KEYBIT");
eq(U.io("UI_SET_RELBIT"), 0x40045566, "UI_SET_RELBIT");
eq(U.io("UI_SET_ABSBIT"), 0x40045567, "UI_SET_ABSBIT");
eq(U.io("UI_ABS_SETUP"), 0x401C5504, "UI_ABS_SETUP");

let setup = U.setup_bytes("PBLang Test Device");
eq(len(setup), 92, "uinput_setup ABI size");
eq(setup[0] + setup[1] * 256, 3, "BUS_USB");

let ev = U.input_event64(1, 28, 1);
eq(len(ev), 24, "x86_64 input_event ABI size");
eq(ev[16] + ev[17] * 256, 1, "event type");
eq(ev[18] + ev[19] * 256, 28, "event code");
eq(ev[20], 1, "event value");

let key = U.event_packet(E.key_event("Enter").event);
if not key.ok { fail("key packet"); }
eq(key.event_count, 4, "press/sync/release/sync");
eq(len(key.bytes), 96, "key packet bytes");
eq(len(key.capabilities), 2, "key capability count");

let move = U.event_packet(E.pointer_delta_event(-3, 5).event);
if not move.ok { fail("relative packet"); }
eq(move.event_count, 3, "x/y/sync events");
eq(len(move.bytes), 72, "relative packet bytes");

let absolute = U.event_packet(E.pointer_event(10, 20).event);
if not absolute.ok { fail("absolute pointer packet"); }
eq(absolute.event_count, 3, "absolute x/y/sync events");
eq(len(absolute.abs_setups), 2, "absolute axis setup count");
eq(len(absolute.abs_setups[0]), 28, "uinput_abs_setup ABI size");
eq(absolute.abs_setups[0][12], 0xFF, "absolute axis maximum low byte");
eq(absolute.abs_setups[0][13], 0x7F, "absolute axis maximum high byte");

let text = U.event_packet(E.type_event("aA!").event);
if not text.ok { fail("ASCII text packet"); }
eq(text.event_count, 20, "ASCII text includes shifted press/release synchronization");
eq(len(text.capabilities), 4, "ASCII text capability de-duplication");
let unicode = U.event_packet(E.type_event("α").event);
if unicode.ok or not str_contains(unicode.error, "ASCII") { fail("Unicode text must fail closed"); }

let artifact = U.build_event(E.click_event(1).event);
if not artifact.ok { fail("native artifact build"); }
eq(artifact.bytes[0], 0x7F, "ELF magic"); eq(artifact.bytes[1], 0x45, "ELF E");
eq(artifact.bytes[4], 2, "ELFCLASS64");
eq(artifact.bytes[68], 5, "RX segment, never RWX");
if artifact.size < 300 or not artifact.live_actuation { fail("artifact metadata"); }
let absolute_artifact = U.build_event(E.pointer_event(100, 200).event);
if not absolute_artifact.ok or len(absolute_artifact.packet.abs_setups) != 2 { fail("absolute native artifact build"); }
let text_artifact = U.build_event(E.type_event("PB 42!").event);
if not text_artifact.ok or text_artifact.packet.event_count < 20 { fail("ASCII text native artifact build"); }
let arm = U.build_event_arm64(E.pointer_delta_event(1, -1).event);
if not arm.ok or arm.arch != "arm64" { fail("ARM64 native artifact build"); }
eq(arm.bytes[18], 0xB7, "ARM64 ELF machine low byte"); eq(arm.bytes[19], 0, "ARM64 ELF machine high byte");
eq(arm.bytes[68], 5, "ARM64 ELF segment is RX, never RWX");
let arm_absolute = U.build_event_for_arch(E.pointer_event(100, 200).event, "aarch64");
if not arm_absolute.ok or len(arm_absolute.packet.abs_setups) != 2 { fail("ARM64 absolute artifact build"); }
let no_arch = U.build_event_for_arch(E.key_event("Enter").event, "mips32");
if no_arch.ok { fail("unsupported native architecture must fail closed"); }

let caps = U.capabilities();
if not caps.native_x86_64 or not caps.native_arm64 or not caps.absolute_pointer or not caps.text_ascii or caps.text_unicode or caps.daemon or caps.external_ydotool_required { fail("capability honesty"); }

print "linux_uinput_pass";
