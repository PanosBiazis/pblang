// tests/semantics/router_enrich3_test.sapp — wave for stdlib/router.sapp introspection.

let R = import("stdlib/router.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn contains(arr, v) { let i = 0; while i < len(arr) { if arr[i] == v { return true; } i = i + 1; } return false; }

let routes = R.route_map();
R.add_route(routes, "GET", "/users", fn(req) { return "u"; });
R.add_route(routes, "POST", "/users", fn(req) { return "c"; });
R.add_route(routes, "GET", "/posts/:id", fn(req) { return "p"; });

eq(R.route_count(routes), 3, "three routes");
if not contains(R.paths(routes), "/users") { fail("paths has /users"); }
if not contains(R.paths(routes), "/posts/:id", ) { fail("paths has /posts/:id"); }

if not R.has_route(routes, "GET", "/users") { fail("GET /users registered"); }
if not R.has_route(routes, "POST", "/users") { fail("POST /users registered"); }
if R.has_route(routes, "DELETE", "/users") { fail("DELETE /users not registered"); }
if R.has_route(routes, "GET", "/nope") { fail("unknown path -> false"); }

print "router_enrich3_pass";
