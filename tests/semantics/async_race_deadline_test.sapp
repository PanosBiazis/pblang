let A=import("stdlib:async.sapp");
fn task(value){return fn(){return value;};}
fn gated(receiver){return fn(){recv(receiver);return 17;};}
let gate=channel_buffered(1);
let slow=A.go(gated(gate.receiver));
let start=clock();
let pending=A.await_race_timeout([slow],5);
let elapsed=clock()-start;
let untouched=not slow.resolved;
send(gate.sender,true);
let eventual=A.await(slow);
channel_close(gate.sender);
assert(not pending.ready and not pending.ok and pending.index==nil,"deadline is pending");
assert(untouched and eventual==17,"timeout keeps worker ownership");
assert(elapsed<1,"pending race does not join unfinished work");
for value in [nil,false,0,"",[],map{timed_out:true},map{ok:false,value:nil}] {
    let future=A.go(task(value));
    let result=A.await_race_timeout([future],1000);
    assert(result.ready and result.ok and result.index==0,"terminal success");
    assert(json_stringify(result.value)==json_stringify(value),"ordinary values preserved");
    assert(future.resolved and channel_is_closed(future.channel.receiver),"winner settled");
    assert(channel_size(future.channel.receiver)==0,"winner queue drained");
    assert((try {join(future.worker);false} catch true),"winner already joined");
    let cached=A.await_race_timeout([future,future],0);
    assert(cached.ready and cached.ok and cached.index==0,"cached duplicate winner");
}
for work in [fn(){throw "fixture failure";},fn(){return fn(){return 1;};}] {
    let future=A.go(work);
    let result=A.await_race_timeout([future],1000);
    assert(result.ready and not result.ok and result.index==0,"task/transfer failure is terminal");
    assert(not A.await_race_timeout([future],0).ok,"failure stays cached");
    assert((try {A.await_race([future]);false} catch true),"unbounded race throws cached failure");
}
let gate2=channel_buffered(1);
let loser=A.go(gated(gate2.receiver));
let winner=A.go(task(42));
let selected=A.await_race_timeout([loser,winner],1000);
let loser_pending=not loser.resolved;
send(gate2.sender,true);
let states=A.all_settled([loser,winner]);
channel_close(gate2.sender);
assert(selected.ready and selected.ok and selected.index==1 and selected.value==42,"selected position");
assert(loser_pending and states[0].value==17,"loser still owned by caller");
let empty=A.await_race_timeout([],0);
assert(not empty.ready and empty.index==nil,"empty race has no winner");
for ms in [-1,0.5,nil,false,"1",num_exp(1000),num_sqrt(-1),2147483648] {
    assert((try {A.await_race_timeout([],ms);false} catch true),"invalid deadline rejected even for empty input");
}
assert(not A.await_race_timeout([],2147483647).ready,"largest allowed duration on empty input");
for invalid in [nil,false,1,"",map{}] {
    assert((try {A.await_race_timeout(invalid,0);false} catch true),"invalid race input rejected");
}
print "async_race_deadline_pass";
