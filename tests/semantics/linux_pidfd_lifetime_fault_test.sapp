// Run in a disposable fixture: replace only native calls in the real module.
let path="tests/fixtures/.pidfd_lifetime_subject.sapp";
assert(not fs_exists(path),"fresh fixture required");
let source=fs_read("stdlib/linux_pidfd.sapp");
source=str_replace_all(source,"ffi_load(","Boundary.load(");
source=str_replace_all(source,"ffi_call_typed(","Boundary.call(");
source=str_replace_all(source,"ffi_close(","Boundary.release(");
fs_write(path,"let Boundary=import(\"tests/fixtures/pidfd_boundary.sapp\");\n"+source);
let P=import("tests/fixtures/.pidfd_lifetime_subject.sapp");
let B=import("tests/fixtures/pidfd_boundary.sapp");
fn rejects(body) {return try {body();false} catch true;}

B.reset("load_error");
let unavailable=P.open(41);
assert(not unavailable.ok and unavailable.error=="trusted libc is unavailable",
    "load failure preserves public error");
assert(B.counts().loads==3 and B.counts().releases==0,"no unowned library release");
B.reset("load_error");assert(not P.current_pid().ok,"pid lookup preserves load error");
B.reset("load_fallback");let fallback=P.open(41);
assert(fallback.ok and B.counts().loads==2 and P.close(fallback),"fallback still owns one handle");
B.reset("normal");assert(P.current_pid().pid==41 and B.counts().releases==1,"pid lookup releases library");

B.reset("normal");
for signal in [nil,7,"USR1","","TERM\u0000"] {
    assert(rejects(fn(){P.signal_once(41,signal);}),"invalid signal rejected");
}
assert(B.counts().loads==0 and B.counts().signals==0,"rejected input acquires no resources");
for pid in [nil,1,-2,1.5,4194305] {
    assert(rejects(fn(){P.signal_once(pid,"CONT");}),"invalid identity rejected");
}
assert(B.counts().loads==0,"invalid identities acquire no resources");
let result=P.signal_once(41," sigcont ");
assert(result.signal=="CONT" and result.signal_sent and result.handle_closed,
    "normalization and successful one-shot behavior preserved");
assert(B.counts().loads==1 and B.counts().closes==1 and B.counts().releases==1,
    "one-shot owns and releases exactly one pair");

for mode in ["normal","close_error","close_throws","unload_throws"] {
    B.reset(mode);let held=P.open(41);
    let outcome=try P.close(held) catch "threw";
    assert(held.closed and held.fd==-1 and not P.exists(held),"descriptor retired on every close path");
    assert(not P.close(held) and rejects(fn(){P.send(held,"CONT");}),"no stale close or signal retry");
    assert(B.counts().closes==1 and B.counts().releases==1 and B.counts().signals==0,
        "each foreign close attempted once");
    if mode=="unload_throws" {
        assert(outcome=="threw" and held.libc==17,
            "unload failure retains library identity and existing exception behavior");
    } else {
        assert(outcome==(mode=="normal"),
            "success reported only on successful descriptor close");
    }
}
B.reset("normal");let held=P.open(41);
B.on_close(fn(){
    assert(not P.close(held) and not P.exists(held),"reentrant close sees retired identity");
    assert(rejects(fn(){P.send(held,"CONT");}),"reentrant signal refused");
});
assert(P.close(held) and B.counts().closes==1 and B.counts().releases==1,
    "reentrant foreign boundary cannot double-close");
fs_remove(path);print "linux_pidfd_lifetime_fault_pass";
