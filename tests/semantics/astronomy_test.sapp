let Astronomy = import("stdlib:astronomy.sapp");

fn require(value, message) {
    if not value { throw "astronomy test failed: " + message; }
}

fn near(actual, expected, tolerance, message) {
    if num_abs(actual - expected) > tolerance {
        throw "astronomy test failed: " + message + " actual=" + str(actual)
            + " expected=" + str(expected);
    }
}

fn rejected(callable) { return (try { callable(); false } catch true); }

require(Astronomy.is_leap_year(2000) and not Astronomy.is_leap_year(1900)
    and Astronomy.is_leap_year(2024), "Gregorian leap-year rules");
require(Astronomy.day_of_year(2024, 12, 31) == 366
    and Astronomy.day_of_year(2023, 12, 31) == 365, "day-of-year accounting");

let equator = Astronomy.solar_day(2024, 3, 20, Astronomy.location(0, 0, 0));
require(equator.status == "normal" and equator.sunrise != nil and equator.sunset != nil,
    "equatorial equinox must have ordinary rise and set events");
near(equator.daylight_minutes, 727, 20, "equinox daylight approximation");
near(equator.sunrise.minute, 364, 20, "equinox sunrise approximation");
near(equator.sunset.minute, 1091, 20, "equinox sunset approximation");
require(not equator.lunar_events.supported and not equator.network_access
    and not equator.stored_coordinates, "lunar and privacy boundaries must be explicit");

let polar_summer = Astronomy.solar_day(2024, 6, 21, Astronomy.location(70, 0, 0));
let polar_winter = Astronomy.solar_day(2024, 12, 21, Astronomy.location(70, 0, 0));
require(polar_summer.status == "polar-day" and polar_summer.daylight_minutes == 1440
    and polar_summer.sunrise == nil and polar_summer.sunset == nil,
    "polar day must not manufacture event times");
require(polar_winter.status == "polar-night" and polar_winter.daylight_minutes == 0
    and polar_winter.sunrise == nil and polar_winter.sunset == nil,
    "polar night must not manufacture event times");
let north_pole = Astronomy.solar_day(2024, 6, 21, Astronomy.location(90, 0, 0));
let south_pole = Astronomy.solar_day(2024, 6, 21, Astronomy.location(-90, 0, 0));
require(north_pole.status == "polar-day" and south_pole.status == "polar-night",
    "exact geographic poles must remain finite and seasonally opposite");

let base = Astronomy.solar_day(2024, 4, 10, Astronomy.location(35, 0, 0));
let shifted = Astronomy.solar_day(2024, 4, 10, Astronomy.location(35, 0, 120));
near(shifted.sunrise.total_minutes - base.sunrise.total_minutes, 120, 0.001,
    "civil UTC offset must shift local event times");

let series = Astronomy.year_series(2024, Astronomy.location(35, 0, 0), 1);
require(series.complete_daily_year and series.sample_count == 366,
    "leap year daily series must contain every day");
require(series.maximum_daylight_minutes > series.minimum_daylight_minutes
    and series.longest != nil and series.shortest != nil,
    "year summary must identify seasonal daylight extremes");

require(rejected(fn() { Astronomy.validate_date(2023, 2, 29); }), "invalid leap date");
require(rejected(fn() { Astronomy.location(91, 0, 0); }), "latitude bound");
require(rejected(fn() { Astronomy.location(0, 181, 0); }), "longitude bound");
require(rejected(fn() { Astronomy.location(0, 0, 841); }), "UTC offset bound");
require(rejected(fn() { Astronomy.year_series(2024, Astronomy.location(0, 0, 0), 0); }),
    "non-progressing series step");

print "astronomy_pass";
