// tests/semantics/struct_enum_test.sapp — struct + enum declaration syntax.

// ── struct: typed constructor + tagged-map instance ──────────────────────────
struct Point { x: number, y: number }
let p = Point(3, 4);
if p.x != 3 or p.y != 4 { throw "FAIL struct fields: " + str(p); }
if p.__struct != "Point" { throw "FAIL struct tag: " + str(p.__struct); }

struct Person { name: string, age: number }
let alice = Person("Alice", 30);
if alice.name != "Alice" or alice.age != 30 { throw "FAIL struct Person: " + str(alice); }

// trailing comma allowed
struct Vec3 { x: number, y: number, z: number, }
let v = Vec3(1, 2, 3);
if v.x + v.y + v.z != 6 { throw "FAIL struct Vec3"; }

// ── enum: unit variants ──────────────────────────────────────────────────────
enum Color { Red, Green, Blue }
if Color.Red.__variant != "Red" { throw "FAIL enum unit variant"; }
if Color.Red.__enum != "Color" { throw "FAIL enum tag"; }
if Color.Blue.__variant != "Blue" { throw "FAIL enum Blue"; }

// ── enum: data variants (typed constructors) ─────────────────────────────────
enum Shape { Empty, Circle(number), Rect(number, number) }
if Shape.Empty.__variant != "Empty" { throw "FAIL enum Empty unit"; }
let c = Shape.Circle(5);
if c.__variant != "Circle" or c.values[0] != 5 { throw "FAIL enum Circle: " + str(c); }
let rect = Shape.Rect(2, 3);
if rect.values[0] != 2 or rect.values[1] != 3 { throw "FAIL enum Rect: " + str(rect); }
if rect.__enum != "Shape" { throw "FAIL enum Rect tag"; }

// ── match on enum variant ────────────────────────────────────────────────────
fn area(shape) {
    return match shape.__variant {
        case "Empty": 0;
        case "Circle": shape.values[0] * shape.values[0] * 3;
        case "Rect": shape.values[0] * shape.values[1];
        else: 0 - 1
    };
}
if area(Shape.Circle(2)) != 12 { throw "FAIL area circle"; }
if area(Shape.Rect(3, 4)) != 12 { throw "FAIL area rect"; }
if area(Shape.Empty) != 0 { throw "FAIL area empty"; }

print "struct_enum_pass";
