let UI = import("stdlib/modern_ui.sapp");
let WebUI = import("stdlib/modern_ui_web.sapp");
let APP = import("stdlib/app.sapp");
let GFX = import("stdlib/graphics.sapp");

fn fail(message) { throw "FAIL modern_ui_web: " + message; }

fn require(value, message) { if not value { fail(message); } }

fn eq(actual, expected, message) {
    if actual != expected {
        fail(message + ": got " + str(actual) + ", expected " + str(expected));
    }
}

fn request(path) {
    return map{
        method: "GET", path: path,
        headers: map{ "user-agent": "Mozilla/5.0 pblang-web-test" },
        body: ""
    };
}

let view = UI.screen([
UI.heading("Tasks <script>alert(1)</script>", map{ name: "title" }),
UI.card([
UI.row([
UI.input("A&B", map{
    name: "task", placeholder: "New \"task\"",
    accessibility_label: "Task input"
}),
UI.choice(["Now", "Later & safer"], 1, nil, map{ name: "when" })
]),
UI.grid([
UI.button("Save", UI.action_sequence([
UI.action_set_text("title", "Saved <safely>"),
UI.action_message("Done </script><script>bad()</script>")
]), map{ name: "save" }),
UI.toggle("Remember", true, nil, map{ name: "remember" }),
UI.slider(25, 0, 100, nil, map{ name: "quality" })
], map{ columns: 3 }),
UI.progress(0.75, map{ name: "progress", accessibility_label: "Progress" }),
UI.image(nil, map{ name: "preview", accessibility_label: "Preview" })
], map{ name: "card", title: "Today" })
], map{ name: "root" });

let bundle = UI.compile(view, map{ target: "web", width: 1200, height: 760 });
eq(bundle.executable, true, "web adapter is linked");
eq(bundle.adapter, "stdlib/modern_ui_web.sapp", "web adapter contract");
require(len(UI.components()) >= 17, "shared component catalog exposed");

let generated = WebUI.generate("PBLang Web", bundle, map{
    theme: "light",
    palette: map{ accent: GFX.rgb(0, 122, 112) },
    lang: "en"
});
eq(generated.format, "pblang.modern-ui.web.v1", "generation format");
require(generated.nodes >= 12, "nested view rendered");
eq(generated.actions, 1, "button action table generated");
require(str_contains(generated.html, "&lt;script&gt;alert(1)&lt;/script&gt;"),
"text escaped");
require(not str_contains(generated.html, "<script>alert(1)</script>"),
"untrusted script not emitted");
require(not str_contains(generated.html, "onclick="), "no inline event handlers");
require(not str_contains(generated.html, " style="), "no inline styles");
require(str_contains(generated.html, "aria-live=\"polite\""), "live status is accessible");
require(str_contains(generated.css, "@media(max-width:640px)"), "responsive breakpoint emitted");
require(str_contains(generated.css, "@media(max-width:360px)")
    and str_contains(generated.css, "orientation:landscape")
    and str_contains(generated.css, "safe-area-inset-left")
    and str_contains(generated.css, "min-height:48px")
    and str_contains(generated.css, "overflow-x:hidden"),
    "small, wide, notched and overflow-constrained viewports are covered");
require(str_contains(generated.css, "prefers-reduced-motion"), "reduced motion supported");
require(str_contains(generated.actions_js, "\\u003c"), "action data is source-safe");

let built = WebUI.build("PBLang Web", bundle, map{ theme: "light" });
let page = built.handle(request("/"));
eq(page.status, 200, "page route");
require(str_contains(page.headers["Content-Security-Policy"], "script-src 'self'"),
"strict external-script CSP");
require(not str_contains(page.headers["Content-Security-Policy"], "unsafe-inline"),
"inline scripts remain forbidden");
eq(built.handle(request("/pblang-ui.css")).status, 200, "CSS route");
eq(built.handle(request("/pblang-ui.actions.js")).status, 200, "action route");
eq(built.handle(request("/pblang-ui.js")).status, 200, "runtime route");

let preview = APP.surface("PBLang Web", view, map{
    mode: "web", operation: "preview", theme: "light"
});
eq(preview.kind, "modern-ui-web", "surface dispatches Web mode");
eq(preview.response.status, 200, "surface Web preview");
let plan = UI.surface_plan(view, map{ mode: "desktop", operation: "preview" });
eq(plan.mode, "desktop", "explicit desktop mode retained");
eq(plan.shared_components, UI.components(), "mode plan uses shared components");
let compatibility = APP.modern("PBLang Web", view, map{
    mode: "web", operation: "preview"
});
eq(compatibility.response.status, 200, "modern helper accepts mode");
let pbide_source = fs_read("editors/ide/pbide.sapp");
require(str_contains(pbide_source, "target == \"modern\" or target == \"android\" or target == \"web\""),
"PBIDE routes Web through modern code generation");
require(str_contains(pbide_source, "mode: \\\"web\\\", operation: \\\"preview\\\""),
"PBIDE emits shared Web surface mode");

let callback_rejected = false;
try {
    let callback_view = UI.screen([
    UI.button("Unsafe", fn(form) { return form; }, map{ name: "unsafe" })
    ]);
    WebUI.generate("Rejected",
    UI.compile(callback_view, map{ target: "web" }), map{});
} catch { callback_rejected = true; }
require(callback_rejected, "host callback rejected");

let missing_target_rejected = false;
try {
    let invalid_view = UI.screen([
    UI.button("Broken", UI.action_set_text("missing", "x"), map{ name: "broken" })
    ]);
    WebUI.generate("Rejected",
    UI.compile(invalid_view, map{ target: "web" }), map{});
} catch { missing_target_rejected = true; }
require(missing_target_rejected, "missing action target rejected");

let unsafe_output_rejected = false;
try { UI.export_web("Rejected", view, "../escape", map{}); }
catch { unsafe_output_rejected = true; }
require(unsafe_output_rejected, "unsafe export path rejected");

let out = "build/test-modern-ui-web";
let exported = UI.export_web("PBLang Web", view, out, map{ theme: "dark" });
require(exported.ok, "static export succeeds");
for file in exported.files { require(fs_exists(out + "/" + file), "exported " + file); }
require(fs_exists(exported.manifest), "export manifest written");
for file in exported.files { fs_remove(out + "/" + file); }
fs_remove(exported.manifest);
fs_remove(out);

print "modern_ui_web_pass";
