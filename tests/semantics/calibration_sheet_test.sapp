let C=import("stdlib:calibration_sheet.sapp");
fn point(x,y) {return map{input:x,output:y};}
fn bad(value) {return (try C.validate(value) catch nil)==nil;}
let points=[point(0,0),point(10,20),point(20,30)];let model=C.make(points,"raw","units");let saved=json_stringify(model);
points[0].output=999;assert(model.points[0].output==0,"detached model construction");
assert(C.estimate(model,[0,5,10,15,20])==[0,10,20,25,30],"exact points and piecewise interpolation");
let checks=[map{id:"low",input:5,expected:11},map{id:"high",input:15,expected:23}];let checks_saved=json_stringify(checks);let r=C.review(model,checks);
assert(r.rows[0].residual==-1 and r.rows[1].residual==2 and r.max_abs_residual==2 and r.mean_abs_residual==1.5,"signed and absolute residuals");
assert(num_abs(r.rmse-num_sqrt(2.5))<0.000000001,"RMSE");
assert(not r.raw_checks_included and not r.reference_points_included and not r.physical_calibration_verified,"evidence boundaries");
assert(not map_has(r,"points") and not map_has(r.rows[0],"input") and not map_has(r.rows[0],"expected"),"report minimizes input data");
r.rows[0].estimate=777;assert(json_stringify(model)==saved and json_stringify(checks)==checks_saved,"review is detached");
let empty=C.review(model,[]);assert(empty.count==0 and empty.rmse==nil and empty.max_abs_residual==nil and empty.mean_abs_residual==nil,"no checks is not zero error");
assert(C.validate(json_parse(saved)),"trusted JSON roundtrip");
for value in [nil,[],map{},map{format:C.FORMAT,input_unit:"raw",output_unit:"units",points:[],extra:0}] {assert(bad(value),"malformed models");}
for values in [[],[point(0,0)],[point(0,0),point(0,1)],[point(1,0),point(0,1)],[nil,point(1,1)],[map{input:0,output:0,extra:1},point(1,1)]] {assert((try C.make(values,"raw","units") catch nil)==nil,"point contracts");}
for value in [nil,true,"1",[],map{},parse_number("NaN"),parse_number("inf"),parse_number("-inf"),1000000001,-1000000001] {
 assert((try C.make([point(0,0),point(value,1)],"raw","units") catch nil)==nil,"reference input types");
 assert((try C.make([point(0,value),point(1,1)],"raw","units") catch nil)==nil,"reference output types");
 assert((try C.estimate(model,[value]) catch nil)==nil,"query types");
 assert((try C.review(model,[map{id:"x",input:1,expected:value}]) catch nil)==nil,"check types");
}
for unit in [nil,true,"","a/b",str_repeat("x",33)] {assert((try C.make([point(0,0),point(1,1)],unit,"units") catch nil)==nil,"unit declaration bounds");}
for values in [nil,[],[-1],[21]] {assert((try C.estimate(model,values) catch nil)==nil,"query bounds and no extrapolation");}
for checks in [[nil],[map{id:"x",input:1,expected:1,extra:0}],[map{id:"x",input:1,expected:1},map{id:"x",input:2,expected:2}],[map{id:"x",input:-1,expected:1}]] {assert((try C.review(model,checks) catch nil)==nil,"malformed/duplicate/outside checks");}
assert((try C.review(model,[map{id:"x",input:"PRIVATE_SENTINEL",expected:0}]) catch nil)==nil,"non-numeric private input rejected");
let refs=[];for i in range(0,64) {array_push(refs,point(i,i*2));}let maximum=C.make(refs,"raw","units");let queries=[];let many=[];
for i in range(0,256) {array_push(queries,1);array_push(many,map{id:"c"+str(i),input:1,expected:2});}
assert(len(C.estimate(maximum,queries))==256 and C.review(maximum,many).rmse==0,"maximum counts");
array_push(refs,point(64,128));assert((try C.make(refs,"raw","units") catch nil)==nil,"65 references rejected");array_push(queries,1);array_push(many,map{id:"overflow",input:1,expected:2});assert((try C.estimate(maximum,queries) catch nil)==nil and (try C.review(maximum,many) catch nil)==nil,"257 queries/checks rejected");
let extreme=C.make([point(-1000000000,1000000000),point(1000000000,-1000000000)],"raw","units");assert(C.estimate(extreme,[-1000000000,0,1000000000])==[1000000000,0,-1000000000],"inclusive finite bounds and descending output");
assert(C.review(extreme,[map{id:"x",input:-1000000000,expected:-1000000000}]).rmse==2000000000,"maximum residual remains finite");
print "calibration_sheet_pass";
