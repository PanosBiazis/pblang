let F = import("stdlib:compiler/selfhost_frontend.sapp");
let sources = [];
for source_index 19 {
    let source = "let item=" + str(source_index) + "; print item;";
    if source_index == 3 { source = "let item:number=nil-1;"; }
    if source_index == 12 { source = "let = ;"; }
    array_push(sources, source);
}
let expected = F.frontend_compile_many(sources, 1);
for workers in [2, 4, 8, 19, 64] {
    let actual = F.frontend_compile_many(sources, workers);
    assert(len(actual) == 19, "partial final group retained");
    for result_index 19 {
        assert(actual[result_index].ok == expected[result_index].ok, "ordered status");
        assert(json_stringify(actual[result_index].diagnostics) == json_stringify(expected[result_index].diagnostics), "ordered diagnostics");
        assert(json_stringify(actual[result_index].chunk) == json_stringify(expected[result_index].chunk), "complete bytecode parity");
    }
}
let paths = [];
for file_index 17 {
    let path = "tests/fixtures/frontend_batch/good.sapp";
    if file_index % 3 == 0 { path = "tests/fixtures/frontend_batch/bad.sapp"; }
    array_push(paths, path);
}
expected = F.frontend_compile_file_many(paths, nil, 1);
for file_workers in [2, 4, 8] {
    let actual = F.frontend_compile_file_many(paths, nil, file_workers);
    assert(len(actual) == 17, "all file groups retained");
    for file_result_index 17 {
        assert(actual[file_result_index].path == paths[file_result_index] and actual[file_result_index].ok == expected[file_result_index].ok, "ordered files");
        assert(actual[file_result_index].symbol_table == nil, "no cyclic symbol table transfer");
        assert(json_stringify(actual[file_result_index].diagnostics) == json_stringify(expected[file_result_index].diagnostics), "file diagnostics");
        assert(json_stringify(actual[file_result_index].chunk) == json_stringify(expected[file_result_index].chunk), "file bytecode");
    }
}
print "frontend_batch_groups_pass";
