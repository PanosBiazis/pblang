// tests/semantics/text_normalize_test.sapp — stdlib/text_normalize.sapp
//
// Response output-normalizer, harvested from the G0DM0D3 "Semantic Transformation
// Modules (STM)" — a sequential pipeline that strips PREAMBLES, HEDGING, and
// FORMALITY markers from a model's reply so the substance is left clean. Pure +
// deterministic. Used to tidy pbAI answer synthesis before it reaches the user.

let N = import("stdlib/text_normalize.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }

// ── preamble: strip leading conversational filler, keep the rest verbatim ──────────
eq(N.strip_preamble("Certainly! The answer is 42."), "The answer is 42.", "certainly!");
eq(N.strip_preamble("Sure, the sky is blue."), "the sky is blue.", "sure,");
eq(N.strip_preamble("Of course. Two plus two is four."), "Two plus two is four.", "of course.");
eq(N.strip_preamble("The answer is 42."), "The answer is 42.", "no preamble = unchanged");

// ── hedging: drop tentative qualifiers ─────────────────────────────────────────────
eq(N.strip_hedging("I think the answer is 42"), "the answer is 42", "i think");
eq(N.strip_hedging("Perhaps we should go"), "we should go", "perhaps");
eq(N.strip_hedging("The answer is 42"), "The answer is 42", "no hedge = unchanged");

// ── formality: remove filler phrases anywhere, incl. trailing sentences ────────────
eq(N.strip_formality("Please note that the sky is blue."), "the sky is blue.", "leading formality");
eq(N.strip_formality("As an AI language model, I cannot do that."), "I cannot do that.", "as an ai");
eq(N.strip_formality("The sky is blue. I hope this helps!"), "The sky is blue.", "trailing formality dropped");

// ── normalize: full pipeline (preamble -> hedging -> formality -> tidy) ─────────────
eq(N.normalize("Sure! I think it is 42. I hope this helps!"), "it is 42.", "full pipeline");
eq(N.normalize("The answer is 42."), "The answer is 42.", "clean text untouched");
// idempotent: normalizing an already-clean result changes nothing
eq(N.normalize(N.normalize("Certainly! I believe it works.")), N.normalize("Certainly! I believe it works."), "idempotent");

// ── opts: stages are individually switchable ───────────────────────────────────────
eq(N.normalize_opts("I think it is 42. I hope this helps!", map{ formality: false }), "it is 42. I hope this helps!", "formality off keeps helper, hedging still runs");
eq(N.normalize_opts("Sure! it is 42.", map{ preamble: false }), "Sure! it is 42.", "preamble disabled keeps Sure!");

print "text_normalize_pass";
