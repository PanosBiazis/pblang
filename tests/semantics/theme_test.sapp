// tests/semantics/theme_test.sapp — editor theme/palette library.

let TH = import("stdlib/theme.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn is_color(c, m) { if type(c) != "map" or (try c.r catch nil) == nil { fail(m + " not a color: " + str(c)); } }

// ── presets ──────────────────────────────────────────────────────────────────────
let d = TH.dark();
let l = TH.light();
is_color(TH.role(d, "bg"), "dark bg");
is_color(TH.role(d, "fg"), "dark fg");
if not TH.is_dark(d) { fail("dark() is dark"); }
if TH.is_dark(l) { fail("light() is not dark"); }

// ── role fallback for unknown names ───────────────────────────────────────────────
is_color(TH.role(d, "totally_unknown_role"), "unknown role falls back to a color");

// ── with_role overrides immutably ─────────────────────────────────────────────────
let red = map{ r: 255, g: 0, b: 0 };
let d2 = TH.with_role(d, "accent", red);
eq(TH.role(d2, "accent").r, 255, "override applied");
if TH.role(d, "accent").r == 255 { fail("original theme unchanged (immutability)"); }

// ── syntax token colors ───────────────────────────────────────────────────────────
is_color(TH.token(d, "keyword"), "keyword token color");
is_color(TH.token(d, "string"), "string token color");
is_color(TH.token(d, "unknown_kind"), "unknown token falls back to fg");

// ── accessibility: fg/bg must meet WCAG AA (>= 4.5) in both presets ────────────────
if TH.contrast(d, "fg", "bg") < 4.5 { fail("dark fg/bg contrast >= 4.5"); }
if TH.contrast(l, "fg", "bg") < 4.5 { fail("light fg/bg contrast >= 4.5"); }

// ── preset registry ─────────────────────────────────────────────────────────────────
let ns = TH.names();
let has_dark = false; let i = 0;
while i < len(ns) { if ns[i] == "dark" { has_dark = true; } i = i + 1; }
if not has_dark { fail("names() includes dark"); }
if TH.is_dark(TH.preset("light")) { fail("preset('light') is light"); }

print "theme_pass";
