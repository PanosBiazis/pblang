let D=import("stdlib:diagnostics.sapp");
let W=import("stdlib:watch.sapp");
let T=import("stdlib:compiler/tokenizer.sapp");
let P=import("stdlib:compiler/parser.sapp");
let S=import("stdlib:compiler/semantic.sapp");
fn fixed(source,expected) {
    let result=D.autofix(source);
    assert(result.fixed==expected,"only intended reference spans change");
    assert(result.count>0 and D.diagnose(result.fixed).ok,"edited source rechecks successfully");
    assert(D.autofix(result.fixed).count==0,"autofix is idempotent");
}
fn unchanged(source) {
    let result=D.autofix(source);
    assert(result.fixed==source and result.count==0 and len(result.applied)==0,"ambiguous or unsupported input stays unchanged");
}
let source="let value=1; print valeu; print \"valeu\"; // valeu\n";
fixed(source,"let value=1; print value; print \"valeu\"; // valeu\n");
fixed("let value=1; let m=map{valeu:2}; print m.valeu; print m?.valeu; /* valeu */ print valeu;",
    "let value=1; let m=map{valeu:2}; print m.valeu; print m?.valeu; /* valeu */ print value;");
fixed("let value=1; fn f(valeu) { return valeu; } print valeu;",
    "let value=1; fn f(valeu) { return valeu; } print value;");
fixed("let value=1; print \"π\nvaleu\";\r\n\tprint valeu; print valeu;",
    "let value=1; print \"π\nvaleu\";\r\n\tprint value; print value;");
fixed("let τιμη=1; print τιμ; print \"τιμ\";", "let τιμη=1; print τιμη; print \"τιμ\";");
fixed("fn f(value) { return valeu; } print f(1);", "fn f(value) { return value; } print f(1);");
fixed("let value=1; print valeu; let longer=2; print longre;", "let value=1; print value; let longer=2; print longer;");
for text in ["fn f() { let value=1; return value; } print valeu;",
    "print valeu; let value=1; print value;",
    "if true { let value=1; print value; } else { print valeu; }",
    "fn f(value) { return valeu; } fn g(other) { return valeu; }",
    "let value=1; print valeu; print missing_unrelated_name;",
    "let value=1; print valeu; /* unterminated",
    "let value=1; print valeu; print \"unterminated"] {
    unchanged(text);
}
let invisible=D.diagnose("fn f() { let value=1; return value; } print valeu;");
for item in invisible.errors { assert(item.suggestion!= "value","nested name never suggested globally"); }
assert(W.autofix(source).fixed==D.autofix(source).fixed,"watch facade inherits safe fix");
let ordinary=T.tokenize("print valeu;");
for token in ordinary { assert(not map_has(token,"source_start"),"default token schema unchanged"); }
let ast=P.parse(ordinary);
assert(len(map_keys(ast.stmts[0].value))==2,"default identifier AST schema unchanged");
assert(not map_has(S.analyze(ast),"free_contexts"),"default semantic schema unchanged");
let marked=P.parse(T.tokenize("print \"π\n\"; print valeu;",true));
let identifier=marked.stmts[1].value;
assert(str_slice("print \"π\n\"; print valeu;",identifier.source_start,identifier.source_end)=="valeu",
    "scalar span unaffected by multiline string or Unicode");
let many="let value=1;"; let count=0;
while count<257 { many=many+"print valeu;"; count=count+1; }
unchanged(many);
let oversized=" "; while len(oversized)<=65536 { oversized=oversized+oversized; }
unchanged(oversized); unchanged(nil);
unchanged("let value=1; let m=map{valeu}; print m;");
print "diagnostics_autofix_scope_pass";
