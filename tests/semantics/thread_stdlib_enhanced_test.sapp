// Test: thread stdlib — WaitGroup, atomic, mutex helpers
import "stdlib:thread.sapp";

// ---- atomic helpers ----
let counter = thread.atomic(0);
if atomic_get(counter) != 0 { throw "FAIL atomic init"; }
let n1 = thread.atomic_inc(counter);
if n1 != 1 { throw "FAIL atomic_inc return"; }
let n2 = thread.atomic_dec(counter);
if n2 != 0 { throw "FAIL atomic_dec return"; }

// ---- mutex RAII (with_mutex) ----
let m = thread.mutex();
let shared = 0;
thread.with_mutex(m, fn() {
    shared = 42;
});
if shared != 42 { throw "FAIL with_mutex"; }

// ---- channel_new / send / recv ----
let ch = thread.channel_new();
thread.send_value(ch.sender, 99);
let got = thread.recv_value(ch.receiver);
if got != 99 { throw "FAIL channel_new send/recv"; }

// ---- buffered channel ----
let bch = thread.channel_new_buffered(2);
thread.send_value(bch.sender, "x");
thread.send_value(bch.sender, "y");
if thread.channel_len(bch) != 2 { throw "FAIL channel_len"; }
let bv1 = thread.recv_value(bch.receiver);
let bv2 = thread.recv_value(bch.receiver);
if bv1 != "x" or bv2 != "y" { throw "FAIL buffered recv values"; }

// ---- drain ----
let dch = thread.channel_new();
thread.send_value(dch.sender, 1);
thread.send_value(dch.sender, 2);
thread.send_value(dch.sender, 3);
channel_close(dch.sender);
let drained = thread.drain(dch);
if len(drained) != 3 { throw "FAIL drain count: " + str(len(drained)); }
if drained[0] != 1 { throw "FAIL drain[0]"; }
if drained[2] != 3 { throw "FAIL drain[2]"; }

// ---- select_nonblocking ----
let sch = thread.channel_new();
let res = thread.select_nonblocking([sch.receiver]);
if res != nil { throw "FAIL select_nonblocking empty should return nil"; }

// ---- once_do_lazy ----
let call_count = 0;
let lazy_val = thread.once_do_lazy(fn() {
    call_count = call_count + 1;
    return 777;
});
let r1 = lazy_val();
let r2 = lazy_val();
let r3 = lazy_val();
if r1 != 777 { throw "FAIL once_do_lazy value"; }
if call_count != 1 { throw "FAIL once_do_lazy called " + str(call_count) + " times (expected 1)"; }

// ---- semaphore ----
let sem = thread.semaphore(2);
let a1 = thread.sem_try_acquire(sem);
let a2 = thread.sem_try_acquire(sem);
let a3 = thread.sem_try_acquire(sem);   // should fail — capacity 2 exhausted
if a1 == false { throw "FAIL sem_try_acquire 1"; }
if a2 == false { throw "FAIL sem_try_acquire 2"; }
if a3 != false { throw "FAIL sem_try_acquire 3 should fail"; }
thread.sem_release(sem);
let a4 = thread.sem_try_acquire(sem);
if a4 == false { throw "FAIL sem_try_acquire after release"; }
thread.sem_release(sem);
thread.sem_release(sem);

print "thread_stdlib_enhanced_pass";
