// tests/semantics/multipart_enrich_test.sapp — fix + enrichment for stdlib/multipart
//
// FIX: the name="..." extraction matched the "name=" INSIDE "filename=", so when a
//      part declared filename before name (Content-Disposition: ...; filename="a.txt";
//      name="upload") it wrongly read the filename as the field name.
// ENRICH: boundary_from_content_type, fields()/files()/find() accessors, and build()
//      (a multipart encoder that round-trips with parse).

let mp = import("stdlib/multipart.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── FIX: name= must not match inside filename= (order-independent) ───────────────
let b = "BND";
let body = "--" + b + "\r\nContent-Disposition: form-data; filename=\"a.txt\"; name=\"upload\"\r\nContent-Type: text/plain\r\n\r\nhello\r\n--" + b + "--\r\n";
let parts = mp.parse(body, b);
eq(len(parts), 1, "one part parsed");
eq(parts[0].name, "upload", "field name extracted (not the filename)");
eq(parts[0].filename, "a.txt", "filename extracted");
eq(parts[0].body, "hello", "body extracted");

// name-first order still works
let body2 = "--" + b + "\r\nContent-Disposition: form-data; name=\"f\"; filename=\"x.bin\"\r\n\r\nQ\r\n--" + b + "--\r\n";
let p2 = mp.parse(body2, b);
eq(p2[0].name, "f", "name-first order");
eq(p2[0].filename, "x.bin", "filename after name");

// ── ENRICH: boundary_from_content_type ──────────────────────────────────────────
eq(mp.boundary_from_content_type("multipart/form-data; boundary=----abc123"), "----abc123", "unquoted boundary");
eq(mp.boundary_from_content_type("multipart/form-data; boundary=\"xy z\""), "xy z", "quoted boundary");
eq(mp.boundary_from_content_type("text/plain"), nil, "no boundary -> nil");

// ── ENRICH: fields() / files() / find() accessors ───────────────────────────────
let mixed = "--" + b + "\r\nContent-Disposition: form-data; name=\"user\"\r\n\r\njane\r\n"
          + "--" + b + "\r\nContent-Disposition: form-data; name=\"doc\"; filename=\"r.txt\"\r\nContent-Type: text/plain\r\n\r\nDATA\r\n"
          + "--" + b + "--\r\n";
let mparts = mp.parse(mixed, b);
let f = mp.fields(mparts);
eq(f.user, "jane", "fields() maps text field name->value");
if map_has(f, "doc") { fail("fields() must exclude file parts"); }
let files = mp.files(mparts);
eq(files.doc.filename, "r.txt", "files() includes file parts by name");
eq(files.doc.body, "DATA", "file body");
eq(mp.find(mparts, "user").body, "jane", "find() returns a part by name");
if mp.find(mparts, "nope") != nil { fail("find() missing -> nil"); }

// ── ENRICH: build() encodes a multipart body that parse() round-trips ────────────
let built = mp.build(map{ a: "1", b: "two" }, [ map{ name: "file", filename: "n.txt", content_type: "text/plain", body: "BODY" } ], "MK");
let rp = mp.parse(built, "MK");
let rf = mp.fields(rp);
eq(rf.a, "1", "built text field a");
eq(rf.b, "two", "built text field b");
let rfiles = mp.files(rp);
eq(rfiles.file.filename, "n.txt", "built file filename round-trips");
eq(rfiles.file.body, "BODY", "built file body round-trips");

print "multipart_enrich_pass";
