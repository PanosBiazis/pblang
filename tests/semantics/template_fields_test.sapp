let F=import("stdlib:template_fields.sapp");let T=import("stdlib:template.sapp");
fn rejects(f) {let failed=false;try {f();} catch {failed=true;}assert(failed,"invalid field input rejected");}
let p=F.compile("Hello {{ name }}, {{name}} / {{part_2}}");assert(F.names(p)==["name","part_2"],"stable unique fields");
let ctx=map{name:"{{part_2}}",part_2:"<literal>"};assert(F.render_compiled(p,ctx)=="Hello {{part_2}}, {{part_2}} / <literal>","substituted values are not reparsed or HTML transformed");
assert(T.render_fields("{{name}}",map{name:"Δείγμα"})=="Δείγμα" and T.field_names("{{x}}{{x}}") == ["x"],"legacy module opt-in facade");
assert(T.render("{{missing}}",map{})=="" and T.render("{{n | upper}}",map{n:"old"})=="OLD","legacy template behavior retained");
for s in ["{{", "{{x}","}}","{{a.b}}","{{x | upper}}","{{}}","{{1x}}","{% if x %}","{# comment #}",str_repeat("x",4097),str_repeat("{{x}}",65)] {rejects(fn(){F.compile(s);});}
rejects(fn(){F.render("{{x}}",map{});});rejects(fn(){F.render("{{x}}",map{x:1});});rejects(fn(){F.render("{{x}}",map{x:"αα"},3);});
assert(F.render("{{x}}",map{x:"αα"},4)=="αα" and F.render("",map{},0)=="","byte exact limits and empty literal");
let bad=F.compile("a");bad.extra=true;rejects(fn(){F.render_compiled(bad,map{});});
bad=map{format:F.FORMAT,tokens:[map{kind:"unknown",value:"x"}]};rejects(fn(){F.render_compiled(bad,map{});});
for limit in [-1,0.5,true,nil,32769] {rejects(fn(){F.render("",map{},limit);});}
let unchanged=json_stringify(p);F.render_compiled(p,ctx);assert(json_stringify(p)==unchanged and ctx.name=="{{part_2}}","no mutation");
print "template_fields_pass";
