let AI=import("stdlib/pbai.sapp");let B=import("stdlib:pbai_specialist_binding.sapp");
let S=import("stdlib:pbai_checkpoint_scope.sapp");let IO=import("stdlib:pbai_student_checkpoint_io.sapp");
let inert=import("tests/fixtures/pbai_checkpoint_scope_inert.sapp");
let noncallable=import("tests/fixtures/pbai_checkpoint_scope_noncallable.sapp");
fn rejects(f){return try {f();false} catch true;}
assert(rejects(fn(){throw "expected";}) and not rejects(fn(){return 1;}),"calibrated rejection");
let called=false;let callback=fn(){called=true;return S;};let cycle=[];push(cycle,cycle);let cases=0;
for bind in [B.bind_checkpoint_scope,AI.neural_specialist_checkpoint_scope_bind] {
 for bad in [nil,true,7,"synthetic-private-provider",[],cycle,map{},map{with_file:callback},callback,IO,noncallable] {
  assert(rejects(fn(){bind(bad);}),"reject incompatible scope binding without callback");cases=cases+1;
 }
 let unused=bind(inert);assert(len(unused)==2,"binding does not invoke scope");
 let bound=bind(S);let report=bound.report();let encoded=json_stringify(report);
 assert(len(bound)==2 and report.operations==["with_file"] and report.exports_checked,"scope surface only");
 assert(not report.provider_authenticated and not report.storage_guarantees_verified and not report.provider_called_during_bind
  and not report.automatic_persistence and not report.automatic_training and not report.globally_activated
  and not report.authorizes_action and report.cleanup_scope=="one-loaded-handle","honest scope report");
 report.operations[0]="forged";report.provider_authenticated=true;
 assert(json_stringify(bound.report())==encoded,"report is detached");
 assert(rejects(fn(){bound.with_file(nil,nil);}),"invalid body rejected before file access");
 let old=AI.neural_specialist_checkpoint_bind(IO);
 assert(len(old)==3 and old.report().operations==["save_new","load_file"],"old binding remains exact");
}
assert(cases==22 and not called,"all invalid providers rejected before effects");
print "pbai_checkpoint_scope_binding_pass:22";
