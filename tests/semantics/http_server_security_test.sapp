let H = import("stdlib:http_server.sapp");

let response = H.to_http_response(map{
    status: 200,
    body: "ok",
    content_type: "text/plain\r\nX-Bad: 1",
    headers: map{
        "X-Good": "yes",
        "X-Bad\r\nInjected": "no",
        "X-Also-Bad": "line1\r\nline2"
    }
});

assert(str_contains(response, "Content-Type: text/plain\r\n"), "unsafe content type falls back to text/plain");
assert(str_contains(response, "X-Good: yes\r\n"), "safe custom header is preserved");
assert(not str_contains(response, "Injected"), "header name CRLF injection is skipped");
assert(not str_contains(response, "line1\r\nline2"), "header value CRLF injection is skipped");

let json_response = H.to_http_response(map{
    status: 200,
    json: map{ ok: true },
    headers: map{
        "Cache-Control": "no-store",
        "X-Content-Type-Options": "nosniff",
        "X-Unsafe": "ok\r\nInjected: no"
    }
});
assert(str_contains(json_response, "Content-Type: application/json\r\n"), "JSON response keeps its content type with custom headers");
assert(str_contains(json_response, "Cache-Control: no-store\r\n"), "JSON response preserves safe custom headers");
assert(str_contains(json_response, "X-Content-Type-Options: nosniff\r\n"), "JSON response preserves security headers");
assert(not str_contains(json_response, "Injected: no"), "JSON response rejects unsafe header values");
assert(str_contains(json_response, "{\"ok\":true}"), "JSON response serializes the body once");

let timeout_result = try H.serve_once_timeout("127.0.0.1:0", fn(req) { return "ok"; }, 1) catch "timeout_rejected";
assert(timeout_result == "timeout_rejected",
    "timeout helper rejects values below its safe 10 ms minimum before binding");

let root = "/tmp/pblang_http_static_security_" + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 12);
let outside = root + "-outside.txt";
fs_mkdirs(root);
fs_write(root + "/index.txt", "safe");
fs_write(outside, "outside-secret");
assert(H.static_file_response(root, "/index.txt").body == "safe", "descriptor-relative static read succeeds");
let linked = proc_spawn_wait("ln", ["-s", outside, root + "/leak.txt"]);
assert(linked.exit_code == 0, "symlink fixture created");
let escaped = H.static_file_response(root, "/leak.txt");
assert(escaped.status == 404 and not str_contains(escaped.body, "outside-secret"),
    "static file symlink escape is rejected");
assert(H.static_file_response(root, "/../outside.txt").status == 403, "parent traversal is rejected");
assert(H.static_file_response(root, "/index.txt", 2).status == 404, "static file size bound is enforced");
try fs_remove(root + "/leak.txt") catch nil;
try fs_remove(root + "/index.txt") catch nil;
try fs_remove(root) catch nil;
try fs_remove(outside) catch nil;

print "http_server_security_pass";
