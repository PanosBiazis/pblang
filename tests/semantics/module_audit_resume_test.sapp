fn fail(message) { throw "FAIL module_audit_resume: " + message; }
fn require(value, message) { if value != true { fail(message); } }

let compiler = if fs_exists("/proc/self/exe") { "/proc/self/exe" } else { "pblang" };
let output = "/tmp/pblang-module-audit-resume-"
    + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 12) + ".json";
let parent_output = "tests/../tests/fixtures/module-audit-parent-report-"
    + str_slice(sha256(output), 0, 12) + ".json";
let base = ["tools/pbaudit.sapp", "--allow-all", "--",
    "--project=fixture", "--module-by-module", "--json-output=" + output,
    "--max-files=10", "--max-file-bytes=10000", "--max-findings=16",
    "tests/fixtures/module_audit/stdlib", "tests/fixtures/module_audit/tools"];

let first = proc_spawn_wait(compiler, base);
require(first.exit_code == 0, "bounded source gate accepts the complete fixture scan");
let first_report = json_parse(fs_read(output));
require(first_report.complete and first_report.module_count == 2
    and first_report.scanned_modules == 2 and first_report.resumed_modules == 0,
    "first scan checkpoints both independent modules");
require(not str_contains(fs_read(output), "sh -c fixed"),
    "checkpoint never stores a raw source finding line");

let resumed_args = ["tools/pbaudit.sapp", "--allow-all", "--",
    "--project=fixture", "--module-by-module", "--resume", "--json-output=" + output,
    "--max-files=10", "--max-file-bytes=10000", "--max-findings=16",
    "tests/fixtures/module_audit/stdlib", "tests/fixtures/module_audit/tools"];
let resumed = proc_spawn_wait(compiler, resumed_args);
require(resumed.exit_code == 0, "resumed findings preserve the quality gate result");
let resumed_report = json_parse(fs_read(output));
require(resumed_report.complete and resumed_report.module_count == 2
    and resumed_report.resumed_modules == 2 and resumed_report.scanned_modules == 0
    and resumed_report.finding_count == first_report.finding_count,
    "stable module snapshots resume without losing or duplicating findings");

// A previously exhausted shared row budget must not keep an unnecessarily
// empty index when earlier modules leave room on this invocation.
let trimmed = json_parse(fs_read(output));
require(trimmed.modules[0].finding_count > 0, "retained-row resume positive control");
trimmed.modules[0].findings = []; trimmed.modules[0].finding_index_truncated = true;
fs_write(output, json_stringify(trimmed));
require(proc_spawn_wait(compiler, resumed_args).exit_code == 0, "truncated stable module rerun");
let refilled = json_parse(fs_read(output));
require(refilled.scanned_modules == 1 and refilled.resumed_modules == 1
    and len(refilled.modules[0].findings) == len(first_report.modules[0].findings),
    "changed remaining allowance refills stable truncated index");

let parent_args = ["tools/pbaudit.sapp", "--allow-all", "--",
    "--project=parent-path", "--module-by-module", "--json-output=" + parent_output,
    "--max-files=10", "--max-file-bytes=10000", "tests/fixtures/../fixtures/module_audit/tools"];
require(proc_spawn_wait(compiler, parent_args).exit_code == 0 and fs_exists(parent_output),
    "normalized parent components support atomic report publication");

let state_root = "tests/fixtures/module-audit-resume-state-"
    + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 12);
let state_a = state_root + "/a"; let state_b = state_root + "/b";
let state_output = output + ".state";
fs_mkdirs(state_a); fs_mkdirs(state_b);
fs_write(state_a + "/main.sapp", "fn a() { return 1; }\n");
fs_write(state_b + "/main.sapp", "fn b() { return 2; }\n");
let state_base = ["tools/pbaudit.sapp", "--allow-all", "--",
    "--project=state", "--module-by-module", "--json-output=" + state_output,
    "--max-files=10", "--max-file-bytes=10000", state_a, state_b];
require(proc_spawn_wait(compiler, state_base).exit_code == 0,
    "state fixture initial checkpoint succeeds");
fs_write(state_a + "/main.sapp", "fn a() { return 3; }\n");
let state_resume = ["tools/pbaudit.sapp", "--allow-all", "--",
    "--project=state", "--module-by-module", "--resume", "--json-output=" + state_output,
    "--max-files=10", "--max-file-bytes=10000", state_a, state_b];
require(proc_spawn_wait(compiler, state_resume).exit_code == 0,
    "changed checkpoint rerun succeeds");
let state_report = json_parse(fs_read(state_output));
require(state_report.scanned_modules == 1 and state_report.resumed_modules == 1,
    "changed module is rescanned while unchanged module is reused");

try fs_remove(output) catch nil;
try fs_remove(parent_output) catch nil;
try fs_remove(state_output) catch nil;
try fs_remove(state_a + "/main.sapp") catch nil;
try fs_remove(state_b + "/main.sapp") catch nil;
try fs_remove(state_a) catch nil;
try fs_remove(state_b) catch nil;
try fs_remove(state_root) catch nil;
print "module_audit_resume_pass";
