// tests/semantics/pblang_features_test.sapp — pblang's self-describing capability matrix
// across categories, a scorecard, an honest comparison framing, and honest caveats.

let F = import("stdlib/pblang_features.sapp");

fn fail(m) { throw "FAIL " + m; }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : <<" + s + ">>"); } }

// ── broad category coverage ─────────────────────────────────────────────────────────
let cats = F.categories();
if len(cats) < 10 { fail("expected many categories, got " + str(len(cats))); }
let names = "";
let i = 0; while i < len(cats) { names = names + cats[i] + " | "; i = i + 1; }
has(names, "Native codegen", "has native codegen category");
has(names, "AI", "has AI category");
has(names, "Devices", "has devices/HAL category");
has(names, "Observability", "has observability category");

// ── each category lists features with a status + module ─────────────────────────────
let nc = F.features("Native codegen");
if len(nc) < 5 { fail("native codegen should list several features"); }
let f0 = nc[0];
if not map_has(f0, "status") or not map_has(f0, "module") { fail("feature needs status + module"); }

// ── scorecard tallies implemented features ──────────────────────────────────────────
let sc = F.scorecard();
if sc.total_features < 40 { fail("scorecard total too low: " + str(sc.total_features)); }
if sc.implemented < 1 { fail("scorecard implemented count"); }

// ── comparison framing is present AND honest (includes caveats) ──────────────────────
let cmp = F.compare();
if len(cmp) < 4 { fail("compare should cover several axes"); }
if not map_has(cmp[0], "axis") or not map_has(cmp[0], "pblang") { fail("compare axis shape"); }
let cav = F.caveats();
if len(cav) < 3 { fail("must state honest caveats (where pblang is NOT ahead)"); }

print "pblang_features_pass";
