let E = import("stdlib:input_events.sapp");

assert(E.canonical_key("Return") == "Enter", "Return canonicalizes portably");
assert(E.canonical_key("Page_Up") == "PageUp", "Page_Up canonicalizes portably");
assert(E.canonical_key("F12") == nil, "unsafe key rejected");
assert(not E.pointer_event(-1, 0).ok and not E.click_event(4).ok, "pointer/button bounds");
assert(not E.type_event(str_repeat("x", E.MAX_TEXT + 1)).ok, "oversized text rejected");
assert(not E.type_event("bad\x00text").ok, "NUL text rejected");

let type = E.type_event("-literal text").event;
let xp = E.backend_plan("xdotool", type);
assert(xp.ok and xp.command == "xdotool" and xp.args[0] == "type" and xp.args[3] == "--",
       "xdotool literal argv plan");
let yp = E.backend_plan("ydotool", type);
assert(yp.ok and yp.command == "ydotool" and yp.requires_daemon and yp.args[3] == "--args",
       "ydotool literal argv plan");
assert(E.backend_plan("ydotool", E.key_event("Return").event).args[3] == "Enter",
       "ydotool gets canonical key name");
assert(E.backend_plan("xdotool", E.key_event("Enter").event).args[1] == "Return",
       "xdotool gets X11 key name");
let absolute = E.pointer_event(320, 240).event;
let delta = E.pointer_delta_event(-20, 10).event;
assert(E.backend_plan("xdotool", absolute).args[0] == "mousemove", "xdotool absolute pointer argv");
assert(E.backend_plan("xdotool", delta).args[0] == "mousemove_relative", "xdotool relative pointer argv");
assert(E.backend_plan("ydotool", delta).args[0] == "mousemove", "ydotool relative pointer argv");
assert(not E.backend_plan("ydotool", absolute).ok, "ydotool absolute pointer fails closed");

let device = E.new_device(800, 600, map{ max_events: 8, max_text: 32 });
let replay = E.replay(device, [
    E.pointer_event(40, 50).event,
    E.pointer_delta_event(2, 3).event,
    E.click_event(1).event,
    E.type_event("abc").event,
    E.key_event("Backspace").event,
    E.key_event("Space").event,
    E.key_event("Enter").event
]);
assert(replay.ok and replay.state.x == 42 and replay.state.y == 53, "absolute and relative pointer replay");
assert(replay.state.click_count == 1 and replay.state.last_button == 1, "click replay");
assert(replay.state.text == "ab \n" and replay.state.last_key == "Enter", "text/key replay");
assert(not E.apply(device, E.pointer_event(900, 10).event).ok, "virtual display bounds");
assert(E.apply(device, E.click_event(1).event).ok, "event quota exact fit");
assert(not E.apply(device, E.click_event(1).event).ok, "event quota enforced");

print "input_events_pass";
