// Test: result.sapp module
import "stdlib:result.sapp";

let r1 = result.ok(42);
if r1.ok == false { print "FAIL ok constructor"; }
if result.is_ok(r1) == false { print "FAIL is_ok"; }
if result.unwrap(r1) != 42 { print "FAIL unwrap ok"; }

let r2 = result.err("oops");
if r2.ok == true { print "FAIL err constructor"; }
if result.is_err(r2) == false { print "FAIL is_err"; }
if result.unwrap_or(r2, 99) != 99 { print "FAIL unwrap_or"; }

let r3 = result.map_val(r1, fn(v) { return v * 2; });
if result.unwrap(r3) != 84 { print "FAIL map_val ok"; }

let r4 = result.map_val(r2, fn(v) { return v * 2; });
if r4.ok != false { print "FAIL map_val err passes through"; }

let r5 = result.and_then(r1, fn(v) { return result.ok(v + 1); });
if result.unwrap(r5) != 43 { print "FAIL and_then"; }

let s1 = result.to_string(r1);
if str_contains(s1, "Ok") == false { print "FAIL to_string ok"; }
let s2 = result.to_string(r2);
if str_contains(s2, "Err") == false { print "FAIL to_string err"; }

let r6 = result.from_try(fn() { return 10 + 5; });
if result.unwrap(r6) != 15 { print "FAIL from_try success"; }

print "result_stdlib_pass";
