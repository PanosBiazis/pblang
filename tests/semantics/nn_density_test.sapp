// tests/semantics/nn_density_test.sapp — grow NN density (function-preserving) + metrics.

let nn = import("stdlib/nn.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.00001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn veq(a, b, m) { let i = 0; while i < len(a) { approx(a[i], b[i], m); i = i + 1; } }

let net = nn.mlp_new(3, 4, 2, 7);
let x = [0.5, 0 - 0.2, 0.9];
let y0 = nn.predict(net, x);

// connectivity: total trainable parameters (weights + biases)
// l1: 4*3 w + 4 b = 16 ; l2: 2*4 w + 2 b = 10 ; total 26
eq(nn.connectivity(net), 26, "connectivity counts weights + biases");

// densify: add hidden neurons WITHOUT changing the function (denser capacity)
let d = nn.densify(net, 3);
eq(d.l1.n_out, 7, "densify added 3 hidden neurons");
if nn.connectivity(d) <= nn.connectivity(net) { fail("densify increases connectivity"); }
veq(nn.predict(d, x), y0, "densify preserves the function");

// widen_to: grow to a target hidden size
let w = nn.widen_to(net, 10);
eq(w.l1.n_out, 10, "widen_to reaches the target hidden size");
veq(nn.predict(w, x), y0, "widen_to preserves the function");
// already wide enough -> unchanged size
eq(nn.widen_to(net, 2).l1.n_out, 4, "widen_to never shrinks");

print "nn_density_pass";
