let CSV=import("stdlib:sheet_csv.sapp"); let T=import("stdlib:table_transform.sapp"); let Sheet=import("stdlib:sheet_document.sapp");
fn rejects(f) { let bad=false; try { f(); } catch { bad=true; } assert(bad,"invalid transform rejected"); }
let source=CSV.decode(" title ,value\n α ,001\nα,001\n beta ,=1+1\n"); let original=Sheet.encode(source);
let result=T.apply(source,[map{op:"trim"},map{op:"deduplicate"},map{op:"filter",column:0,query:"α"}],true);
assert(result.cells==[[" title ","value"],["α","001"]],"ordered trim, dedup, filter preserves literal values and header");
assert(Sheet.encode(source)==original,"source unchanged"); result.cells[0][0]="other";assert(source.cells[0][0]==" title ","detached header");
assert(T.deduplicate(CSV.decode("x\nx\nx")).cells==[["x"]],"first occurrence stable");
assert(T.deduplicate(CSV.decode("h\nh\nh"),true).cells==[["h"],["h"]],"header is not a data duplicate");
assert(T.filter_rows(source,0,"missing",true).cells==[source.cells[0]],"header-only empty result");
assert(T.filter_rows(source,0,"",false)==source,"empty query retains all");
assert(T.apply(source,[],true)==source,"zero-step copy");
assert(T.trim_cells(CSV.decode("  001  , =1+1 ")).cells==[["001","=1+1"]],"no typing or evaluation");
for f in [fn(){T.filter_rows(source,0,"missing");},fn(){T.apply(source,[map{op:"trim"},map{op:"unknown"}],true);},fn(){T.apply(source,[map{op:"trim",extra:1}]);},fn(){T.apply(source,[map{op:"filter",column:0}]);},fn(){T.trim_cells(source,1);},fn(){T.filter_rows(source,0.5,"a");},fn(){T.filter_rows(source,9,"a");},fn(){T.filter_rows(source,0,str_repeat("é",129));},fn(){T.apply(source,map{});}] { rejects(f); }
let many=[];for i in range(0,17) {array_push(many,map{op:"trim"});} rejects(fn(){T.apply(source,many);});
assert(Sheet.encode(source)==original,"failure after a successful step remains transactional");
let max=Sheet.create(32,8);assert(len(T.deduplicate(max).cells)==1,"maximum dimensions admitted");
let detached_dedup=T.deduplicate(source,true);detached_dedup.cells[1][0]="changed";
let detached_filter=T.filter_rows(source,0,"α",true);detached_filter.cells[1][0]="changed";
assert(Sheet.encode(source)==original,"optimized subsets keep detached data rows");
let sort_source=CSV.decode("key,value\n2,first\n10,second\n2,third\n,empty");let sort_original=Sheet.encode(sort_source);
let ascending=T.sort_rows(sort_source,0,false,true);
assert(ascending.cells==[["key","value"],["","empty"],["10","second"],["2","first"],["2","third"]],"stable literal ascending with preserved header");
assert(T.sort_rows(sort_source,0,true,true).cells==[["key","value"],["2","first"],["2","third"],["10","second"],["","empty"]],"stable descending also preserves ties");
assert(T.sort_rows(CSV.decode("id,name"),1,false,true).cells==[["id","name"]],"header-only sort");
assert(T.sort_rows(CSV.decode("β\nα\nA"),0).cells==[["A"],["α"],["β"]],"literal Unicode ordering");
let projected=T.select_columns(sort_source,[1,0]);assert(projected.cells[0]==["value","key"] and projected.cells[1]==["first","2"],"explicit column reorder");
projected.cells[1][0]="changed";ascending.cells[1][0]="changed";assert(Sheet.encode(sort_source)==sort_original,"selected and sorted cells detached");
assert(T.apply(sort_source,[map{op:"select",columns:[1]},map{op:"sort",column:0,descending:false}],true).cells[1]==["empty"],"pipeline indices use current projection");
for f in [fn(){T.select_columns(sort_source,[]);},fn(){T.select_columns(sort_source,[0,0]);},fn(){T.select_columns(sort_source,[2]);},fn(){T.select_columns(sort_source,[true]);},fn(){T.sort_rows(sort_source,0,1);},fn(){T.sort_rows(sort_source,-1);},fn(){T.apply(sort_source,[map{op:"sort",column:0,descending:false,extra:true}]);},fn(){T.apply(sort_source,[map{op:"select",columns:[0]},map{op:"sort",column:1,descending:false}]);}] {rejects(f);}
assert(Sheet.encode(sort_source)==sort_original,"failed composed sorting leaves source unchanged");
print "table_transform_pass";
