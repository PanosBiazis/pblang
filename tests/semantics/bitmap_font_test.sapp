// Test: the pblang bitmap font / text renderer (stdlib/bitmap_font.sapp), §90.
//
// The pblang-native IDE draws its own glyphs (no text builtin). draw_text emits pixels
// through a setpx callback; here a recording surface captures them so the renderer is
// tested in the VM with no display.

let F = import("stdlib/bitmap_font.sapp");

let surf = map{ pts: map{} };
let setpx = fn(x, y, c) { surf.pts[str(x) + "," + str(y)] = c; };
fn on(x, y) { return map_has(surf.pts, str(x) + "," + str(y)); }

// 'I' (code 73) = rows [14,4,4,4,4,4,14] = top bar, vertical stem, bottom bar
F.draw_char(setpx, 0, 0, 73, 9);
assert(on(1, 0) and on(2, 0) and on(3, 0), "I: top bar at cols 1..3");
assert(not on(0, 0) and not on(4, 0), "I: top bar edges off");
assert(on(2, 1) and on(2, 3) and on(2, 5), "I: vertical stem at col 2");
assert(on(1, 6) and on(2, 6) and on(3, 6), "I: bottom bar");
assert(surf.pts["2,0"] == 9, "color is passed through to setpx");

// glyph lookup: lowercase now has REAL distinct glyphs (§101), unknown -> nil
assert(F.glyph(105) != F.glyph(73), "lowercase 'i' has its own glyph, not the uppercase 'I'");
assert(F.glyph(1) == nil, "unknown code has no glyph");
// all 26 lowercase letters present and distinct from blank
let _c = 97; let _n = 0;
while _c <= 122 { if F.glyph(_c) != nil { _n = _n + 1; } _c = _c + 1; }
assert(_n == 26, "all 26 lowercase glyphs defined");
// common code symbols present (| ? @ # & ~)
assert(F.glyph(124) != nil and F.glyph(63) != nil and F.glyph(64) != nil, "pipe/question/at glyphs present");
assert(F.glyph(35) != nil and F.glyph(38) != nil and F.glyph(126) != nil, "hash/ampersand/tilde glyphs present");

// draw_text advances 6 px per char (incl. spaces, which draw nothing)
let surf2 = map{ pts: map{} };
let setpx2 = fn(x, y, c) { surf2.pts[str(x) + "," + str(y)] = 1; };
let endx = F.draw_text(setpx2, 0, 0, "A B", 1);   // 3 cells
assert(endx == 18, "draw_text advances 6 px per cell");
// the space (cell 1, x=6..10) draws nothing
let blank = true;
let xx = 6;
while xx < 11 { let yy = 0; while yy < 7 { if map_has(surf2.pts, str(xx) + "," + str(yy)) { blank = false; } yy = yy + 1; } xx = xx + 1; }
assert(blank, "space cell draws no pixels");

print "bitmap_font_pass";
