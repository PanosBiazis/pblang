// tests/semantics/datetime_calendar_test.sapp
//
// Calendar-aware date arithmetic on datetime.sapp — genuinely missing before
// (both datetime.sapp and date.sapp only had fixed-span add_days/hours/etc.):
// add_months/add_years must clamp the day to the target month's length
// (Jan 31 + 1 month -> Feb 28/29), plus period boundaries, quarter, day-of-year,
// date_range, and ISO week.

let dt = import("stdlib:datetime.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }

fn iso(y, mo, d, h, mi, s) { return dt.to_iso(dt.from_ymd(y, mo, d, h, mi, s)); }

// ── add_months: day clamped to target month length ───────────────────────────
eq(dt.to_iso(dt.add_months(dt.from_ymd(2024, 1, 31, 9, 30, 0), 1)),
   "2024-02-29T09:30:00", "Jan 31 + 1mo -> Feb 29 (leap), time preserved");
eq(dt.to_iso(dt.add_months(dt.from_ymd(2023, 1, 31, 0, 0, 0), 1)),
   "2023-02-28T00:00:00", "Jan 31 + 1mo -> Feb 28 (non-leap)");
eq(dt.to_iso(dt.add_months(dt.from_ymd(2024, 1, 15, 0, 0, 0), 13)),
   "2025-02-15T00:00:00", "13 months rolls the year over");
eq(dt.to_iso(dt.add_months(dt.from_ymd(2024, 12, 15, 0, 0, 0), 1)),
   "2025-01-15T00:00:00", "Dec + 1mo -> next January");
eq(dt.to_iso(dt.add_months(dt.from_ymd(2024, 3, 31, 0, 0, 0), 0 - 1)),
   "2024-02-29T00:00:00", "negative months (Mar 31 - 1mo -> Feb 29)");

// ── add_years: Feb 29 clamps on a non-leap target ────────────────────────────
eq(dt.to_iso(dt.add_years(dt.from_ymd(2024, 2, 29, 0, 0, 0), 1)),
   "2025-02-28T00:00:00", "Feb 29 + 1yr -> Feb 28 non-leap");
eq(dt.to_iso(dt.add_years(dt.from_ymd(2020, 6, 15, 0, 0, 0), 4)),
   "2024-06-15T00:00:00", "plain +4 years");

// ── period boundaries ─────────────────────────────────────────────────────────
let mid = dt.from_ymd(2024, 2, 15, 13, 45, 30);
eq(dt.to_iso(dt.start_of_month(mid)), "2024-02-01T00:00:00", "start_of_month");
eq(dt.to_iso(dt.end_of_month(mid)),   "2024-02-29T23:59:59", "end_of_month (leap Feb)");
eq(dt.to_iso(dt.start_of_year(mid)),  "2024-01-01T00:00:00", "start_of_year");
eq(dt.to_iso(dt.end_of_year(mid)),    "2024-12-31T23:59:59", "end_of_year");

// ── quarter / day_of_year ─────────────────────────────────────────────────────
eq(dt.quarter(dt.from_ymd(2024, 1, 1, 0, 0, 0)), 1, "Jan is Q1");
eq(dt.quarter(dt.from_ymd(2024, 4, 1, 0, 0, 0)), 2, "Apr is Q2");
eq(dt.quarter(dt.from_ymd(2024, 12, 1, 0, 0, 0)), 4, "Dec is Q4");
eq(dt.day_of_year(dt.from_ymd(2024, 1, 1, 0, 0, 0)), 1, "Jan 1 is day 1");
eq(dt.day_of_year(dt.from_ymd(2024, 3, 1, 0, 0, 0)), 61, "Mar 1 2024 (leap) is day 61");
eq(dt.day_of_year(dt.from_ymd(2023, 3, 1, 0, 0, 0)), 60, "Mar 1 2023 is day 60");

// ── date_range ────────────────────────────────────────────────────────────────
let r = dt.date_range(dt.from_ymd(2024, 1, 1, 0, 0, 0), dt.from_ymd(2024, 1, 5, 0, 0, 0), 2);
eq(len(r), 3, "range 1..5 step 2 -> [1,3,5]");
eq(dt.to_iso(r[0]), "2024-01-01T00:00:00", "range start");
eq(dt.to_iso(r[2]), "2024-01-05T00:00:00", "range end inclusive");

// ── ISO week delegation ───────────────────────────────────────────────────────
eq(dt.week_of_year(dt.from_ymd(2024, 1, 1, 0, 0, 0)), 1, "2024-01-01 is ISO week 1");


// ── business-day helpers ──────────────────────────────────────────────────────
// 2024-03-15 is a Friday.
let fri = dt.from_ymd(2024, 3, 15, 10, 0, 0);
eq(dt.is_business_day(fri), true, "Friday is a business day");
eq(dt.is_business_day(dt.from_ymd(2024, 3, 16, 0, 0, 0)), false, "Saturday is not");
// Friday + 1 business day -> Monday (skips the weekend)
eq(dt.to_iso(dt.add_business_days(fri, 1)), "2024-03-18T10:00:00", "Fri +1 biz -> Mon");
// Friday + 5 business days -> next Friday
eq(dt.to_iso(dt.add_business_days(fri, 5)), "2024-03-22T10:00:00", "Fri +5 biz -> next Fri");
// negative: Monday - 1 business day -> Friday
eq(dt.to_iso(dt.add_business_days(dt.from_ymd(2024, 3, 18, 9, 0, 0), 0 - 1)),
   "2024-03-15T09:00:00", "Mon -1 biz -> Fri");
// business_days_between: Mon..Fri (exclusive weekend) inclusive of both ends? count weekdays in [a,b)
eq(dt.business_days_between(dt.from_ymd(2024, 3, 11, 0, 0, 0), dt.from_ymd(2024, 3, 18, 0, 0, 0)), 5,
   "one full work week = 5 business days");
eq(dt.is_same_day(dt.from_ymd(2024, 3, 15, 1, 0, 0), dt.from_ymd(2024, 3, 15, 23, 0, 0)), true,
   "same calendar day, different times");
eq(dt.is_same_day(fri, dt.from_ymd(2024, 3, 16, 1, 0, 0)), false, "different days");

print "datetime_calendar_pass";
