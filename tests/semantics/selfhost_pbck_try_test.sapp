// tests/semantics/selfhost_pbck_try_test.sapp
//
// The self-hosted bytecode container (stdlib/selfhost_pbck.sapp) must round-trip
// EVERY constant kind the self-hosted compiler emits. It silently dropped the
// OP_TRY descriptor constant ({try_chunk, catch_chunk}): _w_value only recognized
// function constants (maps with a "chunk" key) and serialized the try descriptor
// (which has try_chunk/catch_chunk, NOT "chunk") as nil. So any chunk containing a
// try/catch did not survive serialize -> deserialize: OP_TRY then read nil and the
// reloaded program threw. This test serializes, reloads, and RUNS try/catch
// programs and checks the result matches running the original chunk.

let fe = import("stdlib/compiler/selfhost_frontend.sapp");
let vm = import("stdlib/compiler/vm.sapp");
let pb = import("stdlib/selfhost_pbck.sapp");

fn fail(m) { throw "FAIL " + m; }

// serialize -> deserialize -> run; return first printed value (or "THREW").
fn roundtrip(src) {
    let chunk = fe.frontend_compile(src).chunk;
    let bytes = pb.serialize_chunk(chunk);
    let back = pb.deserialize_chunk(bytes);
    let r = try vm.run(back) catch "THREW";
    if r == "THREW" { return "THREW"; }
    if len(r.output) == 0 { return "NOOUT"; }
    return r.output[0];
}

if roundtrip("let r = try 5 catch 9; print r;") != 5 { fail("try success path lost on round-trip"); }
if roundtrip("let r = try boom() catch 42; print r;") != 42 { fail("try catch path lost on round-trip"); }
if roundtrip("let s=0; for i in [1,2,3] { s = s + (try i catch 0); } print s;") != 6 { fail("try-in-loop lost"); }
if roundtrip("let r = try (try bad() catch 7) catch 8; print r;") != 7 { fail("nested try lost"); }
if roundtrip("fn f(){ return try boom() catch 11; } print f();") != 11 { fail("try inside a function lost"); }

// Regression: non-try chunks still round-trip (closures, ints, floats).
if roundtrip("fn adder(n){ return fn(x){ return x+n; }; } let a=adder(5); print a(100);") != 105 { fail("closure round-trip"); }
if roundtrip("print 6 * 7;") != 42 { fail("int round-trip"); }

// File round-trip (write_file/read_file) also carries try/catch.
let p = "/tmp/shpbck_try_" + str(num_floor(now_ms())) + ".pbcs";
pb.write_file(p, fe.frontend_compile("let r = try kaboom() catch 77; print r;").chunk);
let loaded = pb.read_file(p);
let fr = vm.run(loaded);
if fr.output[0] != 77 { fail("write_file/read_file lost try/catch, got " + str(fr.output[0])); }

print "selfhost_pbck_try_pass";
