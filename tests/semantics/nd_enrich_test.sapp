// tests/semantics/nd_enrich_test.sapp — enrichment for stdlib/nd.sapp
// Adds negate, midpoint, angle, manhattan/chebyshev distance, equals_approx, mat_det.

let nd = import("stdlib/nd.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.000001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn aeq(a, b, m) {
    if len(a) != len(b) { fail(m + " len"); }
    let i = 0; while i < len(a) { if num_abs(a[i] - b[i]) > 0.000001 { fail(m + " @" + str(i)); } i = i + 1; }
}

// ── base still works ─────────────────────────────────────────────────────────────
near(nd.length([3, 4]), 5, "length"); near(nd.dot([1, 2], [3, 4]), 11, "dot");

// ── ENRICH: negate / midpoint ────────────────────────────────────────────────────
aeq(nd.negate([1, -2, 3]), [-1, 2, -3], "negate");
aeq(nd.midpoint([0, 0], [4, 6]), [2, 3], "midpoint");

// ── ENRICH: angle ────────────────────────────────────────────────────────────────
near(nd.angle([1, 0], [0, 1]), 1.5707963267948966, "angle perpendicular = pi/2");
near(nd.angle([2, 0], [3, 0]), 0, "angle parallel = 0");

// ── ENRICH: manhattan / chebyshev ────────────────────────────────────────────────
near(nd.manhattan([0, 0], [3, 4]), 7, "manhattan");
near(nd.chebyshev([0, 0], [3, 4]), 4, "chebyshev");

// ── ENRICH: equals_approx ────────────────────────────────────────────────────────
if not nd.equals_approx([1, 2], [1.0000001, 2], 0.001) { fail("equals_approx within eps"); }

// ── ENRICH: mat_det (flat 2x2 / 3x3) ─────────────────────────────────────────────
near(nd.mat_det([1, 2, 3, 4]), -2, "mat_det 2x2");
near(nd.mat_det([1, 0, 0, 0, 1, 0, 0, 0, 1]), 1, "mat_det 3x3 identity");

print "nd_enrich_pass";
