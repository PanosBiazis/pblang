// tests/semantics/codegen_pe_print_test.sapp — a Windows PE that PRINTS: it imports
// GetStdHandle + WriteFile + ExitProcess and emits a Win64 call sequence to write a string
// and exit. No wine here, so the import table + call wiring are verified by objdump; on
// Windows it prints the message.

let C = import("stdlib/codegen_cross.sapp");

fn fail(m) { throw "FAIL " + m; }

let pe = C.pe64_print("hi from pblang\n");
let path = "pbpep_test.exe";
fs_write_bytes(path, pe);

if C.format_of(pe) != "pe" { fail("not a PE"); }

let r = proc_spawn_wait("bash", ["-c", "objdump -x " + path + " 2>/dev/null"]);
let out = try r.stdout catch "";
// all three kernel32 imports must be present and parseable
if str_index_of(str_lower(out), "kernel32") < 0 { fail("missing kernel32 import"); }
if str_index_of(out, "GetStdHandle") < 0 { fail("missing GetStdHandle import"); }
if str_index_of(out, "WriteFile") < 0 { fail("missing WriteFile import"); }
if str_index_of(out, "ExitProcess") < 0 { fail("missing ExitProcess import"); }

// the code must actually reference the WriteFile import slot (a call through the IAT)
let d = proc_spawn_wait("bash", ["-c", "objdump -d " + path + " 2>/dev/null | grep -c 'call'"]);
proc_spawn_wait("bash", ["-c", "rm -f " + path]);
if parse_number(str_trim(try d.stdout catch "0")) < 3 { fail("expected 3 import calls in code"); }

print "codegen_pe_print_pass";
