let app = import("stdlib:app.sapp");
let domains = import("stdlib:app_domains.sapp");

fn eq(actual, expected, label) {
    if actual != expected {
        throw "FAIL " + label + ": got " + str(actual) + ", expected " + str(expected);
    }
}

fn rejected(thunk, label) {
    let threw = false;
    try { thunk(); } catch { threw = true; }
    if not threw { throw "FAIL " + label + ": expected rejection"; }
}

eq(len(domains.kinds()), 7, "seven domain profiles");
for kind in domains.kinds() {
    eq(domains.supports(kind), true, "domain profile " + kind);
}

// REST is a convenience adapter over the hardened web framework. An action
// returns data; the adapter creates the route and JSON response.
let rest = app.rest("status-api", fn(ctx) {
    return map{ status: "ok", path: ctx.request.path };
}, map{
    preview: true,
    path: "/status",
    request: map{ method: "GET", path: "/status", headers: map{ "user-agent": "Mozilla/5.0 test" }, body: "" }
});
eq(rest.kind, "rest", "REST kind");
eq(rest.adapter, "web", "REST web adapter");
eq(rest.response.status, 200, "REST status");
eq(rest.response.json.status, "ok", "REST JSON body");
if not map_has(rest.response.headers, "Content-Security-Policy") { throw "FAIL REST security headers"; }

let advanced_rest = app.run(map{
    kind: "rest", name: "advanced-api", preview: true,
    routes: [map{ method: "GET", path: "/version", handler: fn(ctx) { return ctx.json(map{ version: 1 }); } }],
    request: map{ method: "GET", path: "/version", headers: map{ "user-agent": "Mozilla/5.0 test" }, body: "" }
});
eq(advanced_rest.response.json.version, 1, "explicit REST routes remain configurable");
eq(app.validate(map{ kind: "rest", preview: true }).ok, false, "REST action or routes required");
let bad_rest_plan = app.plan(map{ kind: "rest", preview: true });
eq(bad_rest_plan.ok, false, "REST plan preserves facade validation errors");
eq(app.validate(map{ kind: "rest", host: "0.0.0.0", action: fn(ctx) { return map{}; } }).ok, false, "REST public bind denied");

// Desktop is the same fully configurable native GUI path with a clearer name.
let desktop = app.desktop("control-panel", [
    map{ kind: "label", name: "state", bind: "state" },
    map{ kind: "button", name: "run", text: "Run" }
], map{ preview: true, model: map{ state: "ready" } });
eq(desktop.kind, "desktop", "desktop kind");
eq(desktop.adapter, "gui", "desktop GUI adapter");
eq(desktop.widgets, 2, "desktop widgets");
eq(desktop.form.widgets[0].text, "ready", "desktop binding");
let bad_desktop_plan = app.plan(map{ kind: "desktop", preview: true, width: 99999 });
eq(bad_desktop_plan.ok, false, "desktop plan preserves GUI validation errors");

// Preview is plan-only by default: no domain module or user action is run.
let preview_calls = 0;
let game_plan = app.game("plan-only", fn(ctx) { preview_calls = preview_calls + 1; return ctx.step; }, map{ preview: true });
eq(game_plan.executed, false, "domain preview is plan-only");
eq(game_plan.steps_executed, 0, "domain preview executes no steps");
eq(preview_calls, 0, "domain preview does not call action");

let game = app.game("movement", fn(ctx) {
    return ctx.modules.game.vec2(ctx.step + 1, (ctx.step + 1) * 2);
}, map{ preview: true, preview_execute: true, steps: 3, collect: true });
eq(game.executed, true, "game preview_execute");
eq(game.steps_executed, 3, "game bounded steps");
eq(len(game.values), 3, "game collected values");
eq(game.value.x, 3, "game final x");
eq(game.value.y, 6, "game final y");

let media = app.multimedia("invert", fn(ctx) {
    let image = ctx.modules.image.make_image(2, 1, [10, 20, 30, 255]);
    return ctx.modules.image.invert_colors(image);
}, map{ preview: true, preview_execute: true });
eq(len(media.value), 1, "multimedia image height");
eq(len(media.value[0]), 2, "multimedia image width");
eq(media.value[0][0][0], 245, "multimedia image operation");

// I/O-capable profiles fail closed until allow_io is explicit, even when a
// particular action only builds a request or SQL fragment without sending it.
let db_plan = app.database("query-plan", fn(ctx) { return ctx.modules.db.sql_placeholders(3); }, map{ preview: true });
eq(db_plan.executed, false, "database plan needs no I/O permission");
rejected(fn() {
    app.database("blocked-db", fn(ctx) { return ctx.modules.db.sql_placeholders(1); }, map{ preview: true, preview_execute: true });
}, "database execution without allow_io");
let db = app.database("query-plan", fn(ctx) { return ctx.modules.db.sql_placeholders(3); }, map{
    preview: true, preview_execute: true, allow_io: true
});
eq(db.value, "?,?,?", "database lower-level library access");

let network = app.networking("request-builder", fn(ctx) {
    let request = ctx.modules.networking.new_request("GET", "https://example.invalid/data");
    ctx.modules.networking.request_set_timeout(request, 250);
    return request;
}, map{ preview: true, preview_execute: true, allow_io: true });
eq(network.value.method, "GET", "network request builder");
eq(network.value.timeout_ms, 250, "network advanced configuration");
eq(network.value._sent, false, "network test performs no request");

let automation = app.automation("pipeline", fn(ctx) {
    let workflow = ctx.modules.workflow;
    let pipeline = workflow.new();
    workflow.register(pipeline, "add", fn(value, params) { return value + params.amount; });
    workflow.add_node(pipeline, "first", "add", map{ amount: 2 });
    workflow.add_node(pipeline, "second", "add", map{ amount: 3 });
    workflow.connect(pipeline, "first", "second");
    return workflow.run(pipeline, 5).second;
}, map{ preview: true, preview_execute: true });
eq(automation.value, 10, "automation workflow execution");

let ai = app.ai("vector-similarity", fn(ctx) {
    return ctx.modules.ai.cosine_similarity([1, 0], [1, 0]);
}, map{ preview: true, preview_execute: true, allow_io: true });
eq(ai.value, 1, "AI lower-level library access");

let ml = app.ml("linear-model", fn(ctx) {
    let model = ctx.modules.ml.linreg_fit([1, 2, 3], [2, 4, 6]);
    return ctx.modules.ml.linreg_predict(model, 4);
}, map{ preview: true, preview_execute: true });
eq(ml.value, 8, "ML lower-level library access");

eq(app.validate(map{ kind: "game", action: "not-a-function" }).ok, false, "domain action type checked");
eq(app.validate(map{ kind: "game", action: fn(ctx) { return nil; }, steps: 10001 }).ok, false, "domain step bound");
eq(app.validate(map{ kind: "ml", action: fn(ctx) { return nil; }, steps: 2 }).ok, false, "single-action domain rejects repeats");
eq(app.validate(map{ kind: "game", action: fn(ctx) { return nil; }, steps: 1001, collect: true }).ok, false, "collected output bound");
eq(app.validate(map{ kind: "game", action: fn(ctx) { return nil; }, input: str_repeat("x", 1048577) }).ok, false, "input text bound");
eq(app.validate(map{ kind: "game", action: fn(ctx) { return nil; }, options: [] }).ok, false, "options map required");
eq(app.validate(map{ kind: "game", action: fn(ctx) { return nil; }, side_effects: "yes" }).ok, false, "side-effect flag type checked");

let domain_plan = app.plan(map{ kind: "multimedia", name: "media-plan", action: fn(ctx) { return nil; }, preview: true });
eq(domain_plan.ok, true, "domain plan valid");
eq(domain_plan.blocking, false, "domain preview plan non-blocking");
eq(domain_plan.capabilities[1], "image", "domain capabilities visible");
