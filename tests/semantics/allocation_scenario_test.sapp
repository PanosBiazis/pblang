let C=import("stdlib:allocation_scenario.sapp");let A=import("stdlib:allocation_table.sapp");let S=import("stdlib:sheet_document.sapp");let CSV=import("stdlib:sheet_csv.sapp");let V=import("stdlib:table_cell_view.sapp");let UI=import("stdlib:modern_ui.sapp");
let doc=CSV.decode("Label,Weight\nSmall,1\nLarge,3\nLarge,3\nZero,0");let original=S.encode(doc);let r=C.compare(doc,3,4);
assert(r.document.cells[1]==["Small","1","1","0","-1"],"larger total may reduce an individual share");
assert(r.increased==2 and r.decreased==1 and r.unchanged==1 and r.change==1,"direction counts include zero weights");
assert(r.document.cells[2][0]==r.document.cells[3][0] and r.rows==4,"duplicate labels remain separate rows");
for a in range(0,13){for b in range(0,13){let c=C.compare(doc,a,b);let sum_a=0;let sum_b=0;let delta=0;let reversed=C.compare(doc,b,a);for i in range(1,len(c.document.cells)){let row=c.document.cells[i];sum_a=sum_a+parse_number(row[2]);sum_b=sum_b+parse_number(row[3]);delta=delta+parse_number(row[4]);assert(row[2]==reversed.document.cells[i][3] and row[3]==reversed.document.cells[i][2] and parse_number(row[4])==-parse_number(reversed.document.cells[i][4]),"reverse symmetry");}assert(sum_a==a and sum_b==b and delta==b-a,"both totals and delta conserved");assert(c.increased+c.decreased+c.unchanged==4,"all rows classified");if a==b{assert(c.unchanged==4,"equal totals");}}}
let maximum=CSV.decode("Label,Weight\nA,1000000\nB,1000000");assert(C.compare(maximum,1000000,0).document.cells[1][4]=="-500000","maximum and zero totals");
let all=S.create(32,2);all.cells[0]=["Label","Weight"];for i in range(1,32){all.cells[i]=["Group "+str(i),"1"];}
assert(C.compare(all,31,62).rows==31,"maximum recipient count");
let wide=S.copy(all);for i in range(1,32){wide.cells[i]=[str_repeat("x",247),"1000000"];}
A.from_sheet(wide,1000000);assert((try C.compare(wide,1000000,999999) catch nil)==nil,"comparison overflow rejected even when single allocation fits");
for invalid in [-1,0.5,1000001,"4",nil]{assert((try C.compare(doc,invalid,4) catch nil)==nil and (try C.compare(doc,3,invalid) catch nil)==nil,"both totals validated");}
assert((try C.compare(CSV.decode("Label,Weight\nA,0"),0,0) catch nil)==nil,"positive weight still required");
assert((try C.compare(map{},3,4) catch nil)==nil,"invalid source");
assert(CSV.decode(CSV.encode(r.document)).cells==r.document.cells,"comparison CSV roundtrip");
let view=V.create(r.document,1,"Allocation comparison");for target in ["native","web","android"]{assert(len(UI.compile(view,map{target:target,width:412,height:915}).records)>0,"five-column portable reader");}
r.document.cells[1][0]="changed";assert(S.encode(doc)==original,"source detached");print "allocation_scenario_pass pairs=169";
