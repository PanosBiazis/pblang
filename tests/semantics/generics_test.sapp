// Test: parametric generics (stdlib/generics.sapp) — type descriptors, parametric
// type constructors, typed containers, and the generics↔interface bridge.
// All implemented in pblang.

let g = import("stdlib:generics.sapp");

// --- Base type descriptors ---
assert(g.check(g.T_number(), 5) == true, "T_number accepts 5");
assert(g.check(g.T_number(), "x") == false, "T_number rejects string");
assert(g.check(g.T_string(), "hi") == true, "T_string accepts string");
assert(g.type_name(g.T_number()) == "number", "type_name");

// --- Parametric type constructors: list<T> ---
let IntList = g.T_list_of(g.T_number());
assert(g.type_name(IntList) == "list<number>", "parametric type name list<number>");
assert(g.check(IntList, [1, 2, 3]) == true, "list<number> accepts [1,2,3]");
assert(g.check(IntList, [1, "x", 3]) == false, "list<number> rejects mixed");
assert(g.check(IntList, "not a list") == false, "list<number> rejects non-array");

// --- Nested parametric: list<list<number>> ---
let Matrix = g.T_list_of(g.T_list_of(g.T_number()));
assert(g.type_name(Matrix) == "list<list<number>>", "nested parametric name");
assert(g.check(Matrix, [[1, 2], [3, 4]]) == true, "matrix accepts nested numbers");
assert(g.check(Matrix, [[1, 2], [3, "x"]]) == false, "matrix rejects inner string");

// --- map<K,V> ---
let StrToInt = g.T_map_of(g.T_string(), g.T_number());
assert(g.check(StrToInt, map{ a: 1, b: 2 }) == true, "map<string,number> accepts");
assert(g.check(StrToInt, map{ a: "x" }) == false, "map<string,number> rejects bad value");

// --- T_optional and T_union ---
let OptNum = g.T_optional(g.T_number());
assert(g.check(OptNum, 5) == true, "optional accepts value");
assert(g.check(OptNum, nil) == true, "optional accepts nil");
assert(g.check(OptNum, "x") == false, "optional rejects wrong type");
let NumOrStr = g.T_union(g.T_number(), g.T_string());
assert(g.check(NumOrStr, 5) == true, "union accepts number");
assert(g.check(NumOrStr, "x") == true, "union accepts string");
assert(g.check(NumOrStr, true) == false, "union rejects bool");

// --- Generics ↔ interface bridge (§50) ---
interface Drawable { draw(); }
let DrawableList = g.T_list_of(g.T_conforms(Drawable, "Drawable"));
let d1 = map{ draw: fn() { return "d1"; } };
let d2 = map{ draw: fn() { return "d2"; } };
let plain_obj = map{ x: 1 };
assert(g.check(DrawableList, [d1, d2]) == true, "list<Drawable> accepts conformers");
assert(g.check(DrawableList, [d1, plain_obj]) == false, "list<Drawable> rejects non-conformer");

// --- Typed container enforces its element type at runtime ---
let xs = g.typed_list(g.T_number());
g.tl_push(xs, 1);
g.tl_push(xs, 2);
g.tl_push(xs, 3);
assert(g.tl_len(xs) == 3, "typed_list length");
assert(g.tl_get(xs, 1) == 2, "typed_list get");
let threw = false;
try { g.tl_push(xs, "bad"); } catch { threw = true; }
assert(threw == true, "typed_list rejects wrong-typed element");

// --- Generic, type-preserving map/filter over a typed container ---
let doubled = g.tl_map(xs, g.T_number(), fn(x) { return x * 2; });
assert(g.tl_get(doubled, 2) == 6, "tl_map produces list<number>");
let strs = g.tl_map(xs, g.T_string(), fn(x) { return str(x); });
assert(g.tl_get(strs, 0) == "1", "tl_map can change element type to string");
let evens = g.tl_filter(xs, fn(x) { return x % 2 == 0; });
assert(g.tl_len(evens) == 1 and g.tl_get(evens, 0) == 2, "tl_filter keeps type");

// --- typed_map ---
let tm = g.typed_map(g.T_string(), g.T_number());
g.tm_set(tm, "age", 30);
assert(g.tm_get(tm, "age") == 30, "typed_map set/get");
let tmthrew = false;
try { g.tm_set(tm, "x", "notnum"); } catch { tmthrew = true; }
assert(tmthrew == true, "typed_map rejects bad value type");

// --- Generic value containers: box, pair, triple, Option ---
let b = g.box(g.T_number(), 7);
assert(g.unbox(b) == 7, "box stores value");
assert(g.unbox(g.box_map(b, g.T_string(), fn(x) { return str(x); })) == "7", "box_map");
let p = g.pair("k", 99);
assert(g.fst(p) == "k" and g.snd(p) == 99, "generic pair (any element types)");
let t = g.triple(1, "two", true);
assert(t.third == true, "generic triple");
let s = g.some(42);
assert(g.is_some(s) == true and g.opt_get(s, 0) == 42, "Option some");
assert(g.opt_get(g.none(), -1) == -1, "Option none default");
assert(g.opt_get(g.opt_map(s, fn(x) { return x + 1; }), 0) == 43, "Option map");

print "generics_pass";
