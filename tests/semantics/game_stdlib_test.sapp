let game = import("stdlib:game.sapp");

let cam = game.camera2d(10, 20, 2, 100, 80);
let screen = game.world_to_screen(cam, game.vec2(10, 20));
assert(screen.x == 50, "camera center x");
assert(screen.y == 40, "camera center y");
let world = game.screen_to_world(cam, screen);
assert(world.x == 10, "screen to world x");
assert(world.y == 20, "screen to world y");

let tm = game.tilemap(16, 16, [
    [0, 1, 0],
    [0, 0, 0]
], [1]);
assert(game.tile_at(tm, 1, 0) == 1, "tile_at");
assert(game.is_solid_tile(tm, 1), "solid tile");
let hits = game.tilemap_collisions(tm, game.rect(16, 0, 8, 8));
assert(len(hits) == 1, "tile collision");

let resolved = game.resolve_aabb_static(game.rect(0, 0, 10, 10), game.rect(8, 0, 10, 10));
assert(resolved.normal.x == -1, "resolve normal");

let grid = game.spatial_hash(10);
game.spatial_insert(grid, "a", game.rect(0, 0, 5, 5));
game.spatial_insert(grid, "b", game.rect(20, 0, 5, 5));
let near = game.spatial_query(grid, game.rect(0, 0, 10, 10));
assert(len(near) == 1, "spatial query one");
assert(near[0] == "a", "spatial query id");

let input = game.input_state();
game.input_set(input, "Space", true);
assert(game.input_down(input, "Space"), "input down");
assert(game.input_pressed(input, "Space"), "input pressed");
game.input_begin_frame(input);
assert(not game.input_pressed(input, "Space"), "pressed clears");
game.input_set(input, "Space", false);
assert(game.input_released(input, "Space"), "released");

let scene = game.scene("test");
let count = map{ n: 0 };
game.scene_system(scene, fn(s, dt) { count.n = count.n + 1; });
game.scene_update(scene, 0.016);
assert(count.n == 1, "scene system ran");

let emitter = game.particle_emitter(0, 0, 10, 1);
let particles = game.particle_update(emitter, 0.2);
assert(len(particles) == 2, "particle rate");

print "game_stdlib_pass";
