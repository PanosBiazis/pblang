// tests/semantics/gpu3d_host_test.sapp — stdlib/gpu3d_host.sapp
//
// Polyglot host codegen for the 3D pipeline (the gpu2d_host analog): emits Rust/wgpu,
// C/OpenGL, Python/moderngl, JS/WebGPU glue that uploads gpu3d's 40-byte mesh buffer + an
// MVP matrix uniform and draws it. Embeds gpu3d's shaders + vertex layout. Codegen only.

let H = import("stdlib/gpu3d_host.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "]"); } }
fn has(hay, needle, m) { if not str_contains(hay, needle) { fail(m + " (missing '" + needle + "')"); } }

eq(len(H.targets()), 4, "four host targets");

let r = H.emit_rust_wgpu();
has(r, "wgpu", "rust wgpu"); has(r, "create_shader_module", "rust shader"); has(r, "40", "rust 40-byte stride");

let c = H.emit_c_opengl();
has(c, "glDrawArrays", "c draw"); has(c, "glUniformMatrix4fv", "c uploads the MVP matrix"); has(c, "GL_", "c GL enums");

let py = H.emit_python_moderngl();
has(py, "moderngl", "python moderngl"); has(py, "u_mvp", "python MVP uniform");

let js = H.emit_js_webgpu();
has(js, "createRenderPipeline", "js pipeline");

eq(H.emit("rust-wgpu"), r, "dispatch rust");
let bad = (try H.emit("nope") catch "ERR");
eq(bad, "ERR", "unknown target throws");

print "gpu3d_host_pass";
