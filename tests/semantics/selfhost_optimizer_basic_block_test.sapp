// tests/semantics/selfhost_optimizer_basic_block_test.sapp
//
// Regression for the SELF-HOSTED optimizer (stdlib/compiler/optimizer.sapp).
// Mirrors the Rust constant-folder fix: constant_folding_pass must NOT fold a
// `CONST, CONST, BINOP` triple when a jump targets the middle of it. Folding
// across a basic-block boundary collapses two blocks — the exact bug that made
// `(try X catch <num>) <op> <num>` mis-evaluate (the try/catch success jump
// lands on the RHS constant). See docs/Bootstrap_safety.md Layer 2: the pblang
// optimizer and the Rust optimizer are twins and must agree.

let opt = import("stdlib/compiler/optimizer.sapp");

fn fail(m) { throw "FAIL " + m; }

// OP_CONSTANT = 0, OP_NOT_EQ = 6, OP_JUMP = 20 (from optimizer.sapp's table).

// --- Case 1: a jump targets the MIDDLE constant of a foldable triple. ---
// Layout mirrors `(try X catch 1) != 0`:
//   0: JUMP -> 2        (success path lands on the RHS constant)
//   1: CONST(1)         (catch value; triple starts here)
//   2: CONST(0)         (RHS; index 2 is a jump target!)
//   3: NOT_EQ
// Folding [1,2,3] -> CONST(true) would destroy the jump target and discard the
// try result. The guard must SUPPRESS the fold here.
fn make_guarded_chunk() {
    return map{
        instructions: [
            map{ op: 20, operand: 2 },  // JUMP -> 2
            map{ op: 0,  operand: 0 },  // CONST idx0 (=1)
            map{ op: 0,  operand: 1 },  // CONST idx1 (=0)  <- jump target
            map{ op: 6,  operand: 0 },  // NOT_EQ
        ],
        constants: [1, 0],
    };
}

let guarded = make_guarded_chunk();
let folded_guarded = opt.constant_folding_pass(guarded);
if folded_guarded != 0 {
    fail("fold must be suppressed when a jump targets the middle of the triple (got " + str(folded_guarded) + ")");
}
// The RHS constant the jump points at must survive unfolded.
if len(guarded.instructions) != 4 { fail("guarded chunk length must be unchanged (no fold)"); }
if guarded.instructions[2].op != 0 { fail("RHS constant (jump target) must survive as OP_CONSTANT"); }

// --- Case 2: a plain foldable triple with NO jump into it must STILL fold. ---
// The fix must not disable legitimate folding.
fn make_plain_chunk() {
    return map{
        instructions: [
            map{ op: 0, operand: 0 },  // CONST idx0 (=2)
            map{ op: 0, operand: 1 },  // CONST idx1 (=3)
            map{ op: 1, operand: 0 },  // OP_ADD (=1)
        ],
        constants: [2, 3],
    };
}

let plain = make_plain_chunk();
let folded_plain = opt.constant_folding_pass(plain);
if folded_plain != 1 { fail("legitimate triple must still fold (got " + str(folded_plain) + ")"); }
if len(plain.instructions) != 1 { fail("folded chunk should collapse to a single CONST"); }
if plain.instructions[0].op != 0 { fail("folded result must be OP_CONSTANT"); }
if plain.constants[plain.instructions[0].operand] != 5 { fail("2 + 3 must fold to 5"); }

// --- Case 3: conditional-jump threading. A JUMP_IF_FALSE whose target is an
// unconditional JUMP is retargeted straight to that jump's destination — the jump
// TYPE is preserved (still JIF), only the operand changes. ---
fn make_threaded_chunk() {
    return map{
        instructions: [
            map{ op: 21, operand: 2 },  // 0: JUMP_IF_FALSE -> 2
            map{ op: 12, operand: 0 },  // 1: PRINT (fall-through branch)
            map{ op: 20, operand: 4 },  // 2: JUMP -> 4 (intermediate unconditional)
            map{ op: 12, operand: 0 },  // 3: PRINT
            map{ op: 19, operand: 0 },  // 4: RETURN
        ],
        constants: [],
    };
}
let thr = make_threaded_chunk();
let nthr = opt.jump_optimization_pass(thr);
if nthr < 1 { fail("conditional jump should thread through the unconditional jump"); }
if thr.instructions[0].op != 21 { fail("threaded jump must keep its type (still JIF)"); }
if thr.instructions[0].operand != 4 { fail("JIF must retarget to the jump destination 4, got " + str(thr.instructions[0].operand)); }

// --- Case 4: jump-to-next removal. An unconditional JUMP to the very next
// instruction is a no-op and is removed; jumps that targeted it remap forward. ---
fn make_jtn_chunk() {
    return map{
        instructions: [
            map{ op: 21, operand: 2 },  // 0: JUMP_IF_FALSE -> 2
            map{ op: 20, operand: 2 },  // 1: JUMP -> 2 (jump-to-next, no-op)
            map{ op: 12, operand: 0 },  // 2: PRINT
            map{ op: 19, operand: 0 },  // 3: RETURN
        ],
        constants: [],
    };
}
let jtn = make_jtn_chunk();
let nrem = opt.jump_to_next_pass(jtn);
if nrem != 1 { fail("jump-to-next should be removed (got " + str(nrem) + ")"); }
if len(jtn.instructions) != 3 { fail("chunk should shrink by one instruction"); }
// the JIF at index 0 targeted index 2 (PRINT); after removing instr 1, PRINT is at
// index 1, so the JIF operand must remap to 1.
if jtn.instructions[0].op != 21 or jtn.instructions[0].operand != 1 { fail("JIF target must remap to 1, got " + str(jtn.instructions[0].operand)); }
if jtn.instructions[1].op != 12 { fail("PRINT should now be at index 1"); }

print "selfhost_optimizer_basic_block_pass";
