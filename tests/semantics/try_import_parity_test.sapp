let fixture = import("../fixtures/try_import_fixture.sapp");
let frontend = import("stdlib:compiler/selfhost_frontend.sapp");

if fixture.block_value(false) != 42 { fail("imported try block lost its tail value"); }
if fixture.block_value(true) != -1 { fail("imported try block did not run its catch expression"); }
if fixture.conditional_value(true, false) != true {
    fail("imported conditional try success path failed");
}
if fixture.conditional_value(true, true) != false {
    fail("imported conditional try catch path failed");
}
if fixture.conditional_value(false, false) != true {
    fail("imported alternate conditional try path failed");
}

let invalid = frontend.frontend_compile(
    "let x = try { if true { throw \"x\"; } 1 } catch 0;");
if invalid.ok or len(invalid.diagnostics) == 0
   or not str_contains(str(invalid.diagnostics), "Expected ';' after statement in expression block") {
    fail("self-hosted frontend did not reject an unterminated expression-block statement clearly");
}

print "try_import_parity_pass";
