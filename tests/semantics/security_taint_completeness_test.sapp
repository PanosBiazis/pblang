let T=import("stdlib:security_taint.sapp");
fn expect(ok,label) {if not ok {throw "FAIL taint-completeness: "+label;}}
let overflow=T.analyze("let value=env_get(\"INPUT\");\nhttp_get(value);\nfs_write(value,\"fixed\");",
    "fixture.sapp",map{max_taint_findings:1});
expect(overflow.ok and overflow.truncated and overflow.finding_count==1,"bounded retained evidence");
expect(overflow.findings[0].severity=="medium","retained first finding is medium");
expect(not overflow.passed and overflow.blocking>=1 and not overflow.interprocedural_complete,
    "omitted high finding cannot leave a passing report");
let exact=T.analyze("let value=env_get(\"INPUT\");\nhttp_get(value);",
    "fixture.sapp",map{max_taint_findings:1});
expect(exact.ok and exact.passed and not exact.truncated and exact.interprocedural_complete,
    "exact capacity alone is not overflow");
let repeated=T.analyze("fn probe(value,flag) {http_get(value);}\nprobe(env_get(\"A\"),0);\nprobe(env_get(\"B\"),env_get(\"C\"));",
    "fixture.sapp",map{max_taint_findings:1});
expect(repeated.ok and not repeated.truncated and repeated.finding_count==1 and repeated.call_expansions==2,
    "duplicate retained finding is not evidence loss");
let source="";for i 80 {source=source+"let v"+str(i)+"=1;\n";}
let limited=T.analyze(source,"fixture.sapp",map{max_taint_steps:100});
expect(limited.ok and not limited.passed and limited.limit_exceeded and not limited.interprocedural_complete,
    "AST exhaustion cannot claim complete interprocedural coverage");
expect(limited.ast_steps<=102,"AST limit stops work");
let calls=T.analyze("fn first(x) {return x;}fn second(x) {return x;}\nfirst(1);second(2);",
    "fixture.sapp",map{max_call_expansions:1});
expect(calls.ok and not calls.passed and calls.call_limit_exceeded and not calls.interprocedural_complete,
    "call expansion exhaustion remains blocking");
let control=T.analyze("if env_get(\"MODE\") {fs_remove(\"fixed-stage\");}","fixture.sapp");
expect(not control.passed and control.findings[0].control_flow,"control-only cleanup remains blocking");
print "security_taint_completeness_pass";
