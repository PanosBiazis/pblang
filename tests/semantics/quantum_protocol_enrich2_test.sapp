// tests/semantics/quantum_protocol_enrich2_test.sapp — wave 2 for stdlib/quantum_protocol.sapp
// submit_batch, run_shots (aggregated counts), completed_count.

let P = import("stdlib/quantum_protocol.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

P.clear();

// ── submit_batch: many specs in one call ──────────────────────────────────────────
let jobs = P.submit_batch([map{ n: 1, ops: [] }, map{ n: 1, ops: [] }]);
eq(len(jobs), 2, "two jobs returned");
eq(P.job_count(), 2, "queue has two");
eq(P.completed_count(), 2, "both completed");

// ── run_shots: deterministic circuit (X on q0 -> always 1) ─────────────────────────
let shots = P.run_shots(map{ n: 1, ops: [map{ gate: "x", q: 0 }] }, 8);
eq(shots.shots, 8, "ran 8 shots");
eq(shots.counts["1"], 8, "X|0> always measures 1");

// ── run_shots on identity -> always 0 ──────────────────────────────────────────────
let z = P.run_shots(map{ n: 1, ops: [] }, 5);
eq(z.counts["0"], 5, "|0> always measures 0");

print "quantum_protocol_enrich2_pass";
