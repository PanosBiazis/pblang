let K=import("stdlib:knowledge_intake_contract.sapp");
fn require(v,m){if not v{throw "FAIL knowledge intake: "+m;}}
fn base(){return map{format:K.FORMAT,source_id:"aap-idea-scan",
    metadata_sha256:str_repeat("a",64),claim_digest_algorithm:"sha256-length-framed-knowledge-claims-v1",
    claim_sha256:"",ownership_basis:"operator-owned",
    license_class:"private-reference",consent_confirmed:true,
    contains_private_metadata:false,redaction_verified:true,metadata_only:true,
    categories:["ai","ide","mobile"],destinations:["pblang","pbai"]};}
fn sealed(){let row=base();row.claim_sha256=K.claim_digest(row);return row;}
let admitted=K.admit(sealed());
require(admitted.ok and admitted.schema_eligible_for_review and not admitted.idea_routing_allowed
    and not admitted.independent_provenance_verified and not admitted.content_ingest_allowed
    and not admitted.training_allowed and not admitted.repository_creation_allowed
    and not admitted.safe_to_log and not admitted.caller_metadata_returned
    and not map_has(admitted,"source_id") and not map_has(admitted,"metadata_sha256")
    and not map_has(admitted,"claim_sha256"),
    "metadata ideas do not become content, training, or repositories");
let private=sealed(); private.contains_private_metadata=true; private.redaction_verified=false;
private.claim_sha256=K.claim_digest(private);
require(K.admit(private).error=="provenance-or-privacy-review-required","private metadata requires redaction");
let unknown=sealed(); unknown.path="/private/path";
require(K.admit(unknown).error=="exact-schema-required","unknown path field rejected");
let unlicensed=sealed(); unlicensed.license_class="review-required";
unlicensed.claim_sha256=K.claim_digest(unlicensed);
require(not K.admit(unlicensed).ok,"license review fails closed");
let tampered=sealed(); tampered.destinations=["pbremote"];
require(K.admit(tampered).error=="claim-digest-mismatch","claim changes require a new digest");
let oversized=base(); oversized.categories=[];
for i 1000 { array_push(oversized.categories,"category-"+str(i)); }
require(K.claim_digest(oversized)=="","public digest rejects oversized composites before canonicalization");
print "knowledge_intake_contract_pass";
