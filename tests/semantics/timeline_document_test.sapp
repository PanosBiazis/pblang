let T=import("stdlib:timeline_document.sapp");let V=import("stdlib:timeline_view.sapp");let UI=import("stdlib:modern_ui.sapp");let G=import("stdlib:gui.sapp");
let doc=T.create("Μάθημα");doc=T.set_entry(doc,0,"Εισαγωγή",0,10);doc=T.append(doc,"Example",8,20);let baseline=T.encode(doc);
assert(T.encode(T.decode(baseline))==baseline,"strict Unicode roundtrip");assert(T.analyze(doc).overlap_pairs==1,"shared timing");
let changed=T.rename(T.set_entry(doc,0,"Changed",1,9),"Renamed");assert(T.encode(doc)==baseline and changed.title=="Renamed","detached edits");
assert(T.remove(doc,0).entries[0].label=="Example","explicit removal");
for index in [-1,2,0.5,"0",nil] {assert((try T.set_entry(doc,index,"X",0,1) catch nil)==nil,"invalid index");}
assert((try T.remove(T.create(),0) catch nil)==nil,"retain one activity");
assert((try T.set_entry(doc,0,"",0,1) catch nil)==nil,"empty label");
assert((try T.set_entry(doc,0,"X",5,5) catch nil)==nil,"positive duration");
assert((try T.rename(doc,"bad\nname") catch nil)==nil,"single line title");
for value in ["{\"format\":\"pblang.timeline.v1\",\"format\":\"pblang.timeline.v1\",\"title\":\"X\",\"entries\":[]}", "{}","[]","{\"format\":\"future\"}",baseline+"x"] {assert((try T.decode(value) catch nil)==nil,"malformed persisted document");}
let Strings=import("stdlib:strings.sapp");
let duplicate=Strings.replace_all(baseline,"\"title\":","\"title\":\"duplicate\",\"title\":");
assert((try T.decode(duplicate) catch nil)==nil,"duplicate key in otherwise valid document");
let extra=T.copy(doc);extra.unknown=true;assert((try T.validate(extra) catch false)==false,"unknown field");
let form=UI.build("Timeline reader",V.create(doc),map{width:412,height:915});G.get(form,"select_1").onclick(form);
assert(G.get(form,"detail_1").text=="Example" and str_contains(G.get(form,"detail_6").text,"Overlaps: 1"),"portable action selects actual details");
let wide=T.set_entry(T.create(),0,str_repeat("界",80),0,1);
let wideform=UI.build("Wide labels",V.create(wide),map{width:412,height:915});let rebuilt="";
for i in range(1,5) {rebuilt=rebuilt+G.get(wideform,"detail_"+str(i)).text;}
assert(rebuilt==wide.entries[0].label,"complete wide-character labels without truncation");
let maxdoc=T.create();for i in range(1,T.MAX_ENTRIES){maxdoc=T.append(maxdoc,"Activity "+str(i),i*10,i*10+5);}
assert(T.encode(T.decode(T.encode(maxdoc)))==T.encode(maxdoc),"maximum persistence");
assert((try T.append(maxdoc,"Overflow",1,2) catch nil)==nil,"entry limit");
for target in ["native","web","android"] {assert(len(UI.compile(V.create(maxdoc,7),map{target:target,width:412,height:915}).records)>0,"last full portable page");}
for page in [-1,8,0.5,nil] {assert((try V.create(maxdoc,page) catch nil)==nil,"invalid page");}
assert(T.encode(doc)==baseline,"failed operations retain source");print "timeline_document_pass";
