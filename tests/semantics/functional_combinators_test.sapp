// Test: the functional-programming combinators added to stdlib/functional.sapp.
// Solidifies the functional paradigm — all implemented in pblang.

let f = import("stdlib:functional.sapp");

// --- Point-free ---
assert(f.identity(7) == 7, "identity");
assert(f.constant(9)(123) == 9, "constant ignores its arg");
assert(f.flip(fn(a, b) { return a - b; })(3, 10) == 7, "flip swaps args (10-3)");
let is_even = fn(x) { return x % 2 == 0; };
assert(f.complement(is_even)(3) == true, "complement negates predicate");
assert(f.partial(fn(a, b) { return a + b; }, 10)(5) == 15, "partial binds first arg");
assert(f.partial2(fn(a, b, c) { return a + b + c; }, 1, 2)(3) == 6, "partial2 binds two");

// --- tap / thread ---
let seen = [0];
let r = f.tap(42, fn(x) { seen[0] = x; });
assert(r == 42 and seen[0] == 42, "tap runs side effect, returns value");
assert(f.thread(3, [fn(x){return x+1;}, fn(x){return x*10;}]) == 40, "thread pipes value (3->4->40)");

// --- mapping / expansion ---
assert(f.sum(f.flat_map([1, 2, 3], fn(x) { return [x, x]; })) == 12, "flat_map flattens one level");
let zw = f.zip_with([1, 2, 3], [10, 20, 30], fn(a, b) { return a + b; });
assert(zw[0] == 11 and zw[2] == 33, "zip_with combines elementwise");
let sc = f.scan([1, 2, 3], fn(a, x) { return a + x; }, 0);
assert(sc[0] == 0 and sc[1] == 1 and sc[3] == 6, "scan collects intermediates");

// --- generators ---
let rep = f.repeat("x", 3);
assert(len(rep) == 3 and rep[2] == "x", "repeat");
let it = f.iterate(fn(x) { return x * 2; }, 1, 5);
assert(it[0] == 1 and it[4] == 16, "iterate (1,2,4,8,16)");

// --- windowing ---
let ch = f.chunk([1, 2, 3, 4, 5], 2);
assert(len(ch) == 3 and ch[0][1] == 2 and ch[2][0] == 5, "chunk into size-2 groups");
let wins = f.windows([1, 2, 3, 4], 2);
assert(len(wins) == 3 and wins[0][0] == 1 and wins[2][1] == 4, "sliding windows");

// --- aggregation ---
assert(f.sum([1, 2, 3, 4]) == 10, "sum");
assert(f.product([1, 2, 3, 4]) == 24, "product");
assert(f.mean([2, 4, 6]) == 4, "mean");
let words = [map{ w: "a", n: 3 }, map{ w: "b", n: 7 }, map{ w: "c", n: 1 }];
assert(f.max_by(words, fn(o) { return o.n; }).w == "b", "max_by");
assert(f.min_by(words, fn(o) { return o.n; }).w == "c", "min_by");
let fr = f.frequencies(["a", "b", "a", "a", "b"]);
assert(fr["a"] == 3 and fr["b"] == 2, "frequencies");

// --- declarative control ---
let classify = fn(x) {
    return f.cond([
        [fn(n) { return n < 0; }, fn(n) { return "neg"; }],
        [fn(n) { return n == 0; }, fn(n) { return "zero"; }],
        [fn(n) { return n > 0; }, fn(n) { return "pos"; }]
    ], x);
};
assert(classify(0 - 5) == "neg", "cond neg");
assert(classify(0) == "zero", "cond zero");
assert(classify(8) == "pos", "cond pos");
assert(f.when_fn(is_even, fn(x) { return x * 100; })(4) == 400, "when_fn applies on match");
assert(f.when_fn(is_even, fn(x) { return x * 100; })(3) == 3, "when_fn identity on miss");
let stats = f.juxt([f.sum, f.product, fn(a) { return len(a); }])([1, 2, 3]);
assert(stats[0] == 6 and stats[1] == 6 and stats[2] == 3, "juxt applies many fns");

print "functional_combinators_pass";
