let P=import("stdlib:thread_pool.sapp");
fn task(v) {return fn(){return v;};}
fn fail() {throw "test failure";}
for workers in [1,2,4,8] {
    let p=P.new_thread_pool(workers);
    P.submit(p,task("old"));
    assert(P.run_parallel(p).results==["old"],"first batch");
    let ids=[];
    array_push(ids,P.submit_priority(p,task(nil),2));
    array_push(ids,P.submit_priority(p,fail,3));
    array_push(ids,P.submit_priority(p,task(false),2));
    array_push(ids,P.submit_priority(p,task(0),4));
    let result=P.run_parallel(p);
    assert(result.completed==3 and result.failed==1,"second batch accounting");
    assert(result.results==[0,nil,false],"stable priority and nil result");
    assert(p.results==["old",0,nil,nil,false],"history order including failed slot");
    assert(P.get_result(p,ids[2])==false and P.get_result(p,ids[3])==0,"IDs remain independent from rank");
    assert(P.get_status(p,ids[1])=="failed","failure attached to original ID");
    assert(P.stats(p).pending==0,"nothing pending");
    assert(P.run_parallel(p).completed==0,"completed effects not repeated");
    P.shutdown(p);
}
// A non-transferable result fails its entire worker chunk; sibling outcomes remain.
fn untransferable(){return fn(){return 1;};}
let p=P.new_thread_pool(2);
P.submit(p,untransferable);P.submit(p,task("sibling"));P.submit(p,task("same chunk"));
let result=P.run_parallel(p);
assert(result.completed==1 and result.failed==2,"failed worker chunk accounting");
assert(result.results==["sibling"],"sibling result retained");
assert(p.results==[nil,"sibling",nil],"failed chunk slots retained");
assert(P.run_parallel(p).completed==0,"no retry after effects");
P.shutdown(p);
print "thread_pool_result_slots_pass";
