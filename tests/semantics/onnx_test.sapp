let ONNX = import("stdlib:onnx.sapp");
let FLOAT = import("stdlib:floatn.sapp");

fn fail(message) { throw "FAIL " + message; }
fn assert_true(value, message) { if not value { fail(message); } }
fn rejects(callable, message) { let rejected = false; try { callable(); } catch { rejected = true; } assert_true(rejected, message); }
fn append(out, values) { for i len(values) { out[len(out)] = values[i]; } return out; }
fn varint(value) {
    let out = []; let n = value;
    while n >= 128 { out[len(out)] = (n % 128) + 128; n = num_floor(n / 128); }
    out[len(out)] = n; return out;
}
fn field_var(number, value) { let out = varint(number * 8); append(out, varint(value)); return out; }
fn field_bytes(number, value) { let out = varint(number * 8 + 2); append(out, varint(len(value))); append(out, value); return out; }
fn field_text(number, value) { return field_bytes(number, str_to_bytes(value)); }
fn f32le(value) { let bytes = FLOAT.pack([value], "f32"); return [bytes[3], bytes[2], bytes[1], bytes[0]]; }
fn packed_f32(values) { let out = []; for i len(values) { append(out, f32le(values[i])); } return out; }
fn packed_vars(values) { let out = []; for i len(values) { append(out, varint(values[i])); } return out; }

fn dimension(value) { return field_var(1, value); }
fn shape(values) { let out = []; for i len(values) { append(out, field_bytes(1, dimension(values[i]))); } return out; }
fn tensor_type(dtype, dims) { let out = field_var(1, dtype); append(out, field_bytes(2, shape(dims))); return out; }
fn value_info(name, dtype, dims) { let out = field_text(1, name); append(out, field_bytes(2, field_bytes(1, tensor_type(dtype, dims)))); return out; }
fn initializer(name, dims, values) {
    let out = field_bytes(1, packed_vars(dims)); append(out, field_var(2, 1));
    append(out, field_bytes(4, packed_f32(values))); append(out, field_text(8, name)); return out;
}
fn node(op, inputs, output) {
    let out = []; for i len(inputs) { append(out, field_text(1, inputs[i])); }
    append(out, field_text(2, output)); append(out, field_text(4, op)); return out;
}
fn model(last_op = "Relu") {
    let graph = [];
    append(graph, field_bytes(1, node("MatMul", ["x", "w"], "m")));
    append(graph, field_bytes(1, node("Add", ["m", "b"], "a")));
    append(graph, field_bytes(1, node(last_op, ["a"], "y")));
    append(graph, field_text(2, "pblang-onnx-test"));
    append(graph, field_bytes(5, initializer("w", [2, 2], [2.0, -1.0, 1.0, 3.0])));
    append(graph, field_bytes(5, initializer("b", [2], [-1.0, 2.0])));
    append(graph, field_bytes(11, value_info("x", 1, [1, 2])));
    append(graph, field_bytes(12, value_info("y", 1, [1, 2])));
    let opset = field_var(2, 13);
    let out = field_var(1, 8); append(out, field_bytes(7, graph)); append(out, field_bytes(8, opset)); return out;
}

fn test_pblang_native_onnx_execution() {
    let decoded = ONNX.decode(model());
    assert_true(decoded.ir_version == 8 and decoded.opset == 13 and len(decoded.graph.nodes) == 3,
        "valid ONNX graph is decoded");
    let result = ONNX.run(decoded, map{ x: [3.0, 4.0] });
    assert_true(result.ok and result.backend == "pblang-cpu" and result.nodes_executed == 3,
        "model executes in the PBLang CPU backend");
    assert_true(result.outputs.y == [9.0, 11.0] and result.tensors.y.shape == [1, 2],
        "MatMul, Add, Relu and shape propagation are correct");
}

fn test_onnx_boundaries_fail_closed() {
    rejects(fn() { ONNX.decode([8]); }, "truncated protobuf is rejected");
    rejects(fn() { ONNX.decode(model("UnknownOp")); }, "unknown operator is rejected at decode time");
    rejects(fn() { ONNX.infer(model(), map{ x: [1.0] }); }, "declared input shape mismatch is rejected");
    rejects(fn() { ONNX.infer(model(), map{ x: [3.0, 4.0], unexpected: [1.0] }); }, "unexpected input is rejected");
    rejects(fn() { ONNX.infer(model(), map{ x: [3.0, 4.0] }, map{ max_operations: 1 }); }, "operation budget is enforced");
}
