// Live CLI numeric admission; run one field per supervised process if desired.
let OS = import("stdlib:os.sapp");
if platform() != "linux" { print "pbaudit_numeric_preflight_skip_linux_required"; os_exit(0); }
let compiler = env_get("PBLANG_BIN") ?? path_join(cwd(), "target/release/pblang");
let selected = env_get("PB_AUDIT_NUMERIC_FIELD") ?? "smoke";
let fields = [
    ["max-depth",0,32,32], ["max-entries",1,50000,50000],
    ["max-children",1,4096,4096], ["max-files",1,10000,100000],
    ["max-file-bytes",1000,1048576,16777216], ["max-runtime-ms",10,300000,300000],
    ["backlog-limit",1,9007199254740991,9007199254740991],
    ["lines",1,9007199254740991,9007199254740991]
];
let fixture = path_join(cwd(), "tests/fixtures/numeric-preflight-" +
    str_slice(sha256(str(now_ms()) + str(random_bytes(8))),0,16));
let output = path_join(OS.temp_dir(), path_basename(fixture) + ".json");
let marker = "owned-prior-report-marker";
let failure = "unexpected exception"; let invocations = 0;
fn expect(ok, label) { if not ok { failure = label; throw label; } }
fn invoke(mode, flags) {
    let args = ["-k","1s","8s",compiler,"tools/pbaudit.sapp","--allow-all","--",
        "--json-output=" + output, fixture];
    if mode != "ordinary" { push(args,"--module-by-module"); }
    if mode == "resume" { push(args,"--resume"); }
    for flag in flags { push(args,flag); }
    invocations = invocations + 1;
    return proc_spawn_wait("/usr/bin/timeout",args);
}
fn reject(field, mode, flags, maximum) {
    let result = invoke(mode, flags);
    let diagnostic = "pbaudit: " + field[0] + " must be a finite integer in " +
        str(field[1]) + ".." + str(maximum);
    expect(result.exit_code == 2 and str_trim(result.stdout) == diagnostic,
        "exact value-free numeric rejection: " + field[0] + "/" + mode);
    expect(result.stderr == "" and fs_exists(output) and fs_read(output) == marker,
        "old report preserved without private diagnostic detail");
}
fn accepted(mode, flags) {
    let result = invoke(mode,flags);
    // Minimal depth/entry/runtime requests may legitimately be incomplete.
    expect(result.exit_code == 0 or result.exit_code == 1,"valid bound reaches audit");
    let report = json_parse(fs_read(output));
    expect(type(report) == "map" and map_has(report,"complete"),
        "valid request writes an audit report");
    expect(result.stderr == "","valid request has no runtime diagnostic");
}
fn exercise() {
    fs_mkdirs(fixture); fs_write(fixture + "/main.sapp","let value=1;\n");
    if selected == "smoke" {
        // Keep the default suite cheap: pure tests cover the full scalar matrix.
        for sample in [[fields[0],"resume","1.5"],[fields[3],"modules","NaN"],
            [fields[4],"ordinary","private-number-marker"],[fields[7],"ordinary","0"]] {
            fs_write(output,marker);
            let field=sample[0]; let mode=sample[1];
            reject(field,mode,["--"+field[0]+"="+sample[2]],
                if mode=="ordinary" {field[2]} else {field[3]});
        }
        return true;
    }
    let tested = 0;
    for field in fields {
        if selected == field[0] {
            tested = tested + 1;
            for mode in ["ordinary","modules","resume"] {
                fs_write(output,marker);
                let maximum = if mode == "ordinary" { field[2] } else { field[3] };
                let raw = "private-number-marker";
                if mode == "modules" { raw = str(maximum+1); }
                if mode == "resume" { raw = "NaN"; }
                reject(field,mode,["--"+field[0]+"="+raw],maximum);
            }
            fs_write(output,marker);
            reject(field,"ordinary",["--"+field[0]+"="+str(field[1]),
                "--"+field[0]+"=invalid"],field[2]);
            for mode in ["ordinary","modules"] {
                let maximum = if mode == "ordinary" { field[2] } else { field[3] };
                accepted(mode,["--"+field[0]+"=invalid","--"+field[0]+"="+str(field[1])+".0"]);
                accepted(mode,["--"+field[0]+"="+str(maximum)]);
            }
            if field[0] == "max-files" or field[0] == "max-file-bytes" {
                accepted("ordinary",["--"+field[0]+"="+str(field[3]),"--module-by-module"]);
            }
        }
    }
    expect(tested == 1,"known single-field test selection");
    return true;
}
let succeeded = try exercise() catch false;
if fs_exists(fixture + "/main.sapp") { fs_remove(fixture + "/main.sapp"); }
if fs_exists(fixture) { fs_remove(fixture); }
if fs_exists(output) { fs_remove(output); }
if not succeeded { throw "FAIL pbaudit-numeric-preflight: " + failure + " after calls=" + str(invocations); }
print "pbaudit_numeric_preflight_pass " + selected + " calls=" + str(invocations);
