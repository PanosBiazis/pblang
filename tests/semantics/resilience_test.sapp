let R = import("stdlib:resilience.sapp");

let p = R.policy("network-call", map{
    max_attempts: 5, base_delay_ms: 100, multiplier: 2, max_delay_ms: 500,
    timeout_ms: 10000, failure_threshold: 2, recovery_ms: 1000
});
assert(p.valid and p.max_attempts == 5, "bounded resilience policy is valid");
assert(R.backoff_ms(p, 1) == 100 and R.backoff_ms(p, 4) == 500 and R.backoff_ms(p, 100) == 500, "backoff is exponential and overflow-safe");

let s = R.initial(p, 1000);
let first = R.begin_attempt(p, s, 1000);
assert(first.accepted and first.state.attempts == 1, "first attempt is admitted");
s = R.record_failure(p, first.state, 1010, "temporary", true);
let waiting = R.decision(p, s, 1050);
assert(not waiting.allowed and waiting.reason == "backoff" and waiting.retry_after_ms == 60, "retry waits for remaining backoff");
let second = R.begin_attempt(p, s, 1110);
assert(second.accepted and second.state.attempts == 2, "second attempt begins after backoff");
s = R.record_failure(p, second.state, 1120, "temporary", true);
assert(s.status == "open", "failure threshold opens circuit");
assert(R.decision(p, s, 1500).reason == "circuit-open", "open circuit blocks work");
let probe = R.begin_attempt(p, s, 2120);
assert(probe.accepted and probe.decision.mode == "half-open", "recovery admits one half-open probe");
s = R.record_success(probe.state, 2121);
assert(s.completed and s.status == "succeeded" and not R.decision(p, s, 2122).allowed, "success closes lifecycle permanently");

let cancelled = R.cancel(R.initial(p, 0), "user-stop", 2);
assert(cancelled.cancelled and R.decision(p, cancelled, 3).reason == "cancelled", "cancellation is explicit and terminal");
assert(R.decision(p, R.initial(p, 100), 99).reason == "clock-regression", "clock regression fails closed");
assert(R.decision(p, R.initial(p, 0), 10000).reason == "deadline-exceeded", "deadline fails closed");

let invalid = R.policy("bad", map{ max_atempts: 9 });
assert(not invalid.valid and R.decision(invalid, R.initial(invalid, 0), 0).reason == "invalid-policy", "unknown policy options fail closed");
let invalid_failure = R.record_failure(invalid, R.initial(invalid, 0), 0, "ignored", true);
assert(invalid_failure.completed and invalid_failure.reason == "invalid-policy", "failure transition also fails closed on invalid policy");

let one = R.policy("one-shot", map{ max_attempts: 1, timeout_ms: 1000 });
let one_run = R.begin_attempt(one, R.initial(one, 0), 0);
let exhausted = R.record_failure(one, one_run.state, 1, "permanent", true);
assert(exhausted.completed and exhausted.status == "exhausted", "attempt budget is terminal when exhausted");

print "resilience_pass";
