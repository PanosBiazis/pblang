let T=import("stdlib:translation_review.sapp");
fn message(id,text) {return map{id:id,text:text};}
fn rejected(a,b) {return (try T.review(a,b) catch nil)==nil;}
let source=[message("greeting","Private source {{name}} {{count}}"),message("plain","Plain")];
let target=[message("plain","Απλό"),message("greeting","{{count}} εργασίες για {{name}}")];let before=json_stringify([source,target]);
let good=T.review(source,target);assert(good.ok and good.messages[0].id=="greeting","Unicode translation and source order");
assert(json_stringify([source,target])==before and not str_contains(json_stringify(good),"Private source"),"no mutation or message text in report");
good.messages[0].id="changed";assert(source[0].id=="greeting","detached result");
let changed=T.review([message("a","{{x}} {{x}} {{y}}"),message("b","B")],[message("a","{{x}} {{z}}"),message("c","C")]);
assert(not changed.ok and changed.missing_ids==["b"] and changed.extra_ids==["c"],"message differences");
assert(changed.messages[0].missing_fields==["y"] and changed.messages[0].extra_fields==["z"] and changed.messages[0].changed_counts==[map{name:"x",source_count:2,translated_count:1}],"field multiset differences");
let blank=T.review([message("a","A")],[message("a"," \t\n")]);assert(not blank.ok and blank.empty_translations==1 and blank.messages[0].fields_match,"blank is distinct from field mismatch");
assert(T.review([],[]).ok,"empty catalogues");
assert(not T.review([], [message("extra","Extra")]).ok,"target only");
for malformed in [nil,map{},[nil],[map{id:"x"}],[map{id:"x",text:"X",extra:1}],[message("bad-key","X")],[message("x",42)],[message("x","X"),message("x","Y")],[message("x","{{missing")],[message("x","{{ user.name }}")],[message("x","{% if x %}")],[message("x","{{ x | upper }}")]] {
 assert(rejected(malformed,[]) and rejected([],malformed),"strict records and existing literal field grammar");
}
let max_records=[];for i in range(0,128) {array_push(max_records,message("m"+str(i),"{{a}}"));}
assert(T.review(max_records,max_records).ok,"128 messages accepted");
array_push(max_records,message("overflow","X"));assert(rejected(max_records,[]),"129 messages rejected");
let exact=[];let piece=str_repeat("x",4096);
for i in range(0,32) {array_push(exact,message("m"+str(i),piece));}
assert(T.review(exact,exact).ok,"exact aggregate byte budget");
array_push(exact,message("overflow","x"));assert(rejected(exact,[]),"aggregate byte budget enforced");
let fields=str_repeat("{{x}}",64);
assert(T.review([message("a",fields)],[message("a",fields)]).ok,"64 field occurrences accepted");
assert(rejected([message("a",fields+"{{x}}")],[]),"65 fields rejected");
print "translation_review_pass";
