let D = import("stdlib:linux_dirfs.sapp");
let checks = 0;
fn require(value, message) {
    checks = checks + 1;
    if not value { throw "FAIL linux_dirfs_relative_paths: " + message; }
}
let base = "/tmp/pblang-relative-paths-" + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 16);
fs_mkdirs(base + "/dirs/root/root"); fs_mkdirs(base + "/files");
fs_write(base + "/dirs/marker", "outer");
fs_write_bytes(base + "/dirs/root/value", [1, 0, 255]);
fs_write(base + "/dirs/root/root/nested", "nested");
fs_write_bytes(base + "/files/root", [9, 0, 128, 7]);
let dirs = D.open_absolute(base + "/dirs", false, false);
let files = D.open_absolute(base + "/files", false, false);
require(dirs.ok and files.ok, "real handles open");
let outer = D.list_relative(dirs);
require(outer.ok and array_sort(outer.entries) == ["marker", "root"], "empty/default denotes held root");
let literal = D.list_relative(dirs, "root");
require(literal.ok and array_sort(literal.entries) == ["root", "value"], "literal child directory");
require(D.list_relative(dirs, "root/root").entries == ["nested"], "repeated literal root components");
for alias in ["", ".", "root"] {
    let old = D.list(dirs, alias);
    require(old.ok and array_sort(old.entries) == ["marker", "root"], "legacy root alias preserved");
}
require(D.read_bytes_relative(dirs, "root/value", 3).bytes == [1, 0, 255], "nested exact binary bytes");
require(D.read_bytes_relative(files, "root", 4).bytes == [9, 0, 128, 7], "literal top-level filename");
require(not D.read_bytes(files, "root", 4).ok, "legacy file alias remains rejected");
require(not D.list_relative(files, "root").ok, "file is not a directory");
require(not D.read_bytes_relative(dirs, "root", 4).ok, "directory is not file content");
require(not D.read_bytes_relative(files, "root", 3).ok, "exact byte bound enforced");
require(not D.read_bytes_relative(files, "root", -1).ok, "negative limit rejected");
require(not D.read_bytes_relative(files, "root", 1.5).ok, "fractional limit rejected");
require(D.list_relative(dirs, "", 1).truncated, "listing truncation is reported");
for invalid in [".", "..", "../root", "root/../value", "/root", "root//value", "root/", "root/./value", strfromcharcode(0)] {
    require(not D.list_relative(dirs, invalid).ok, "invalid literal directory path");
    require(not D.read_bytes_relative(files, invalid, 4).ok, "invalid literal file path");
}
require(not D.read_bytes_relative(files, "", 4).ok, "empty filename rejected");
let linked = proc_spawn_wait("/bin/ln", ["-s", base + "/files/root", base + "/dirs/link"]);
require(linked.exit_code == 0, "synthetic file link created");
require(not D.read_bytes_relative(dirs, "link", 4).ok, "final symlink rejected");
linked = proc_spawn_wait("/bin/ln", ["-s", base + "/dirs/root", base + "/dirs/linkdir"]);
require(linked.exit_code == 0, "synthetic directory link created");
require(not D.list_relative(dirs, "linkdir").ok, "directory symlink rejected");
require(not D.read_bytes_relative(dirs, "linkdir/value", 4).ok, "intermediate symlink rejected");
let moved = proc_spawn_wait("/bin/mv", ["--", base + "/files", base + "/held"]);
require(moved.exit_code == 0, "synthetic root renamed");
fs_mkdirs(base + "/files"); fs_write(base + "/files/root", "replacement");
require(D.read_bytes_relative(files, "root", 4).bytes == [9, 0, 128, 7], "held directory survives pathname replacement");
require(D.close(dirs) and D.close(files), "handles close");
require(not D.list_relative(dirs).ok and not D.read_bytes_relative(files, "root", 4).ok, "closed handles rejected");
let cleaned = proc_spawn_wait("/bin/rm", ["-rf", "--", base]);
require(cleaned.exit_code == 0, "synthetic tree removed");
print "linux_dirfs_relative_paths_pass " + str(checks);
