let C99 = import("stdlib:compiler/ctranspile.sapp");
let FRONT = import("stdlib:compiler/selfhost_frontend.sapp");
let UUID = import("stdlib:uuid.sapp");

fn fail(message) { throw "FAIL ctranspile_module_globals: " + message; }

let modules = map{
    "lib/config.sapp": "const BASE = 40; fn seed() { return BASE; } export seed;",
    "lib/state.sapp": "let C = import(\"config.sapp\"); let counter = C.seed(); const STEP = 1; let transform = fn(x) { return x + STEP; }; fn next() { counter = transform(counter); return counter; } export next;"
};
let source = "let State = import(\"../lib/state.sapp\"); print State.next(); print State.next();";
let linked = C99.link_program(source, modules, map{ entry_path: "app/main.sapp" });
if not linked.ok or linked.module_order[0] != "lib/config.sapp" or linked.module_order[1] != "lib/state.sapp" {
    fail("deterministic dependency link failed");
}

let reference = FRONT.frontend_run(linked.source);
if not reference.ok or reference.output != [41, 42] { fail("self-host reference mismatch"); }

let lowered = C99.transpile_program_linked(source, modules, map{ entry_path: "app/main.sapp" });
if not lowered.ok or not str_contains(lowered.source, "static double __pbi0_BASE = 0;")
    or not str_contains(lowered.source, "static double __pbi1_counter = 0;")
    or not str_contains(lowered.source, "static double __pbi1_transform = 0;") {
    fail("hosted global declarations missing");
}

let cc = C99.find_c_compiler();
if cc != nil {
    let root = "/tmp/pblang_module_globals_" + UUID.v4();
    let c_path = root + ".c";
    let native_path = root + "_native";
    let sanitizer_path = root + "_san";
    fs_write(c_path, lowered.source);

    let built = proc_spawn_wait(cc, ["-std=gnu99", "-O2", c_path, "-o", native_path]);
    if built.exit_code != 0 { fail("native C compile failed: " + built.stderr); }
    let run = proc_spawn_wait(native_path, []);
    if run.exit_code != 0 or run.stdout != "41\n42\n" { fail("native/reference differential mismatch"); }

    let sanitizer = proc_spawn_wait(cc, ["-std=gnu99", "-O1", "-fno-omit-frame-pointer",
        "-fsanitize=address,undefined", c_path, "-o", sanitizer_path]);
    if sanitizer.exit_code == 0 {
        let checked = proc_spawn_wait(sanitizer_path, []);
        if checked.exit_code != 0 or checked.stdout != "41\n42\n" {
            fail("sanitized linked program failed: " + checked.stderr);
        }
    }

    try fs_remove(c_path) catch nil;
    try fs_remove(native_path) catch nil;
    try fs_remove(sanitizer_path) catch nil;
}

print "ctranspile_module_globals_pass";
