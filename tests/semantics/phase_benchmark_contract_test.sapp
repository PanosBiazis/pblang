// Keep the comprehensive benchmark wired to every major compiler/runtime tier.
let stages = bytes_to_str(fs_read_bytes("bench/pblang_phase_stages.sapp"));
let runner = bytes_to_str(fs_read_bytes("bench/pblang_phase_suite.sh"));
let direct_builtins = bytes_to_str(fs_read_bytes("bench/selfhost_vm_direct_builtin_stages.sapp"));

fn need(text, value) {
    if not str_contains(text, value) { throw "FAIL phase-benchmark-contract missing: " + value; }
}

for phase in ["tokenize", "parse", "semantic", "typecheck", "bytecode_codegen",
              "bytecode_optimize_safe", "selfhost_vm_fib12", "tree_interpreter_fib18",
              "c99_transpile", "x86_64_source_codegen", "x86_64_ir_codegen",
              "i386_ir_codegen", "arm64_ir_codegen", "arm64_source_codegen",
              "wasm_source_codegen"] {
    need(stages, "emit_phase(\"" + phase + "\"");
}
for target in ["emu_6502", "emu_avr", "emu_z80", "emu_mips", "emu_msp430",
               "emu_powerpc", "emu_riscv", "emu_sparc", "emu_wasm", "emu_quantum"] {
    need(runner, target);
}
need(stages, "PHASE_SUITE|ok");
need(runner, "phase_process_peak_rss_kb");
need(runner, "c99_compile_ms");
need(runner, "direct_x64_artifact_bytes");
need(stages, "NATIVE_STRESS_SOURCE");
need(runner, "direct_x64_fib36.csv");
need(runner, "direct_x64_fib36_peak_rss_kb");
need(direct_builtins, "SELFHOST_VM_DIRECT_BUILTIN|");
need(direct_builtins, "direct_builtin_call");
need(direct_builtins, "disable_direct_metadata(constant.chunk)");

print "phase_benchmark_contract_pass";
