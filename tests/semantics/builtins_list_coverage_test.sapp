// tests/semantics/builtins_list_coverage_test.sapp
//
// stdlib/compiler/builtins_list.sapp is the generated set of host builtin names
// the self-hosted linter uses for SOUND undefined-name detection. If it drifts
// behind the real VM builtin table, the linter falsely reports valid builtin
// calls as "undefined name" (a false positive). The list had fallen 16 builtins
// behind: num_to_le_bytes/num_from_le_bytes, gil_enabled, tensor_backend, and the
// 12 gfx* graphics builtins. This test pins that they are recognized and the
// linter does not false-flag them.

let bl = import("stdlib/compiler/builtins_list.sapp");
let fe = import("stdlib/compiler/selfhost_frontend.sapp");

fn fail(m) { throw "FAIL " + m; }

// The builtins that had been missing from the generated set.
let prev_missing = [
    "num_to_le_bytes", "num_from_le_bytes", "gil_enabled", "tensor_backend",
    "gfxcreatewindow", "gfxclosewindow", "gfxwindowopen", "gfxpollevents",
    "gfxclear", "gfxpresent", "gfxdrawpoint", "gfxdrawline", "gfxdrawrect",
    "gfxsize", "gfxisopen", "gfxclose"
];

// 1. Every previously-missing name is now in the builtin set.
let i = 0;
while i < len(prev_missing) {
    if not bl.is_builtin_name(prev_missing[i]) {
        fail("builtin not in generated set: " + prev_missing[i]);
    }
    i = i + 1;
}

// 2. The linter must NOT report these as "undefined name" when called.
//    Build a program that calls each one, lint it, and assert no undefined-name
//    diagnostic mentions any of them.
let src = "";
let j = 0;
while j < len(prev_missing) {
    src = src + "let _r" + str(j) + " = " + prev_missing[j] + "();\n";
    j = j + 1;
}
let lint = fe.frontend_lint(src);
let diags = lint.diagnostics;
let d = 0;
while d < len(diags) {
    let msg = try diags[d].message catch "";
    if str_contains(msg, "undefined name") {
        // Any undefined-name diagnostic here is a false positive on a real builtin.
        fail("linter false-flagged a real builtin: " + msg);
    }
    d = d + 1;
}

// 3. Sanity: a genuinely undefined name IS still flagged (soundness not lost).
let bad = fe.frontend_lint("let q = totally_not_a_real_builtin_xyz();");
let found_undef = false;
let b = 0;
while b < len(bad.diagnostics) {
    if str_contains(try bad.diagnostics[b].message catch "", "undefined name") { found_undef = true; }
    b = b + 1;
}
if not found_undef { fail("linter must still flag a genuinely undefined name"); }

// 4. The literal/keyword specials stay recognized (not VM builtins, but the
//    linter must not flag them).
let specials = ["true", "false", "nil", "print", "self"];
let s = 0;
while s < len(specials) {
    if not bl.is_builtin_name(specials[s]) { fail("special name dropped from set: " + specials[s]); }
    s = s + 1;
}

print "builtins_list_coverage_pass";
