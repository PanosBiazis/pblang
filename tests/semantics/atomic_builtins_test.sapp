// Test: atomic builtins (lock-free counters)
// atomic_new, atomic_get, atomic_set, atomic_add, atomic_sub, atomic_cas, atomic_swap

// atomic_new + atomic_get
let a = atomic_new(10);
if atomic_get(a) != 10 { throw "FAIL atomic_new/get"; }

// atomic_set
atomic_set(a, 42);
if atomic_get(a) != 42 { throw "FAIL atomic_set"; }

// atomic_add — returns NEW value
let v1 = atomic_add(a, 8);
if v1 != 50 { throw "FAIL atomic_add return: " + str(v1); }
if atomic_get(a) != 50 { throw "FAIL atomic_add state"; }

// atomic_sub — returns NEW value
let v2 = atomic_sub(a, 5);
if v2 != 45 { throw "FAIL atomic_sub return: " + str(v2); }

// atomic_cas — compare-and-swap
let ok1 = atomic_cas(a, 45, 100);   // should succeed
if ok1 == false { throw "FAIL atomic_cas success"; }
if atomic_get(a) != 100 { throw "FAIL atomic_cas value after success"; }

let ok2 = atomic_cas(a, 45, 999);   // should fail (current is 100, not 45)
if ok2 != false { throw "FAIL atomic_cas should fail"; }
if atomic_get(a) != 100 { throw "FAIL atomic_cas value unchanged after fail"; }

// atomic_swap — returns OLD value
let old = atomic_swap(a, 7);
if old != 100 { throw "FAIL atomic_swap old: " + str(old); }
if atomic_get(a) != 7 { throw "FAIL atomic_swap new value"; }

// Zero-init
let b = atomic_new(0);
if atomic_get(b) != 0 { throw "FAIL atomic default 0"; }

print "atomic_builtins_pass";
