let AI=import("stdlib/pbai.sapp");let B=import("stdlib:pbai_specialist_binding.sapp");
let S=import("stdlib:pbai_checkpoint_scope.sapp");let IO=import("stdlib:pbai_student_checkpoint_io.sapp");
let inert=import("tests/fixtures/pbai_checkpoint_batch_inert.sapp");
let badmodule=import("tests/fixtures/pbai_checkpoint_batch_noncallable.sapp");
let oldscope=import("tests/fixtures/pbai_checkpoint_scope_inert.sapp");
fn rejects(f){return try {f();false} catch true;}
assert(rejects(fn(){throw "expected";}) and not rejects(fn(){return 1;}),"calibrated rejection");
let called=false;let callback=fn(){called=true;return nil;};let cycle=[];push(cycle,cycle);let cases=0;
for bind in [B.bind_checkpoint_batch,AI.neural_specialist_checkpoint_batch_bind] {
 for bad in [nil,true,7,"synthetic-private-provider",[],cycle,map{},map{with_files:callback},callback,IO,badmodule,oldscope] {
  assert(rejects(fn(){bind(bad);}),"reject malformed batch provider");cases=cases+1;
 }
 assert(len(bind(inert))==2,"do not execute provider during binding");
 let bound=bind(S);let report=bound.report();let encoded=json_stringify(report);
 assert(len(bound)==2 and report.operations==["with_files"] and report.max_files==8 and report.exports_checked,"fixed batch surface");
 assert(not report.provider_authenticated and not report.storage_guarantees_verified and not report.provider_called_during_bind
  and not report.automatic_persistence and not report.automatic_training and not report.globally_activated and not report.authorizes_action,"honest report");
 report.operations[0]="changed";report.max_files=99;assert(json_stringify(bound.report())==encoded,"detached metadata");
 assert(rejects(fn(){bound.with_files([],nil);}),"no IO for invalid request");
 assert(len(AI.neural_specialist_checkpoint_scope_bind(oldscope))==2,"old one-file provider remains compatible");
 assert(len(AI.neural_specialist_checkpoint_bind(IO))==3,"old storage binding unchanged");
}
assert(cases==24 and not called,"all incompatible providers rejected before effects");
print "pbai_checkpoint_batch_binding_pass:24";
