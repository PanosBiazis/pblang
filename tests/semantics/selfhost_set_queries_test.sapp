let FE=import("stdlib:compiler/selfhost_frontend.sapp");
let source="let S=import(\"stdlib:set.sapp\");let a=S.from_array([1,2,3]);let b=S.from_array([2,3,4]);let p=S.partition(a,fn(v){return v%2==0;});let visited=[];S.each(a,fn(v){push(visited,v);S.remove(a,2);});let result=[S.intersection_size(a,b),S.to_array(p.matched),S.to_array(p.rejected),visited,S.is_proper_subset(a,S.union(a,b))];";
let run=FE.frontend_run_bounded(source,map{max_steps:100000,max_frames:32,max_modules:8,max_source_bytes:65536});
assert(run.ok,"selfhost set queries");assert(run.globals.result==[1,[2],[1,3],[1,3],true],"selfhost partition and mutation");
print "selfhost_set_queries_pass";
