// tests/semantics/format_enrich_test.sapp — fix + enrichment for stdlib/format.sapp
//
// BUG: color(text, name) did `COLORS[name] ?? ""` but indexing a missing map key
// THROWS (?? can't rescue it), so an unknown color name crashed. Fixed with
// map_has. ENRICH: strip_ansi, duration_human, ordinal, wrap, rgb (truecolor).

let f = import("stdlib/format.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── BUG FIX: unknown color name no longer throws ─────────────────────────────────
eq(f.color("hi", "notacolor"), "hi", "unknown color returns plain text");
if len(f.color("hi", "red")) <= 2 { fail("valid color should wrap with ANSI codes"); }

// ── ENRICH: strip_ansi removes color codes ───────────────────────────────────────
eq(f.strip_ansi(f.color("hello", "green")), "hello", "strip_ansi removes color");
eq(f.strip_ansi(f.rgb("x", 10, 20, 30)), "x", "strip_ansi removes truecolor");

// ── ENRICH: duration_human ───────────────────────────────────────────────────────
eq(f.duration_human(45), "45s", "duration seconds");
eq(f.duration_human(125), "2m 5s", "duration minutes");
eq(f.duration_human(3661), "1h 1m 1s", "duration hours");

// ── ENRICH: ordinal ──────────────────────────────────────────────────────────────
eq(f.ordinal(1), "1st", "1st"); eq(f.ordinal(2), "2nd", "2nd"); eq(f.ordinal(3), "3rd", "3rd");
eq(f.ordinal(4), "4th", "4th"); eq(f.ordinal(11), "11th", "11th"); eq(f.ordinal(22), "22nd", "22nd");

// ── ENRICH: wrap ─────────────────────────────────────────────────────────────────
eq(f.wrap("a b c d", 3), "a b\nc d", "word wrap at width 3");

// ── ENRICH: maps become readable tables without manual matrix conversion ───────
let mapped = f.table_from_maps([
    map{ name: "Ada", score: 10 },
    map{ name: "Lin", score: 12 }
], ["name", "score"]);
if str_index_of(mapped, "Ada") < 0 or str_index_of(mapped, "12") < 0 {
    fail("table_from_maps renders record values");
}

print "format_enrich_pass";
