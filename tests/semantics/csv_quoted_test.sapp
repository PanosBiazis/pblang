// tests/semantics/csv_quoted_test.sapp — G1/G2 CSV parsing test
import "stdlib:csv.sapp";

// Basic unquoted row
let row1 = csv.parse_line("a,b,c");
if len(row1) != 3      { print "basic_len FAIL: " + str(len(row1)); }
if row1[0] != "a"      { print "row1[0] FAIL"; }
if row1[1] != "b"      { print "row1[1] FAIL"; }
if row1[2] != "c"      { print "row1[2] FAIL"; }

// Quoted field containing a comma
let row2 = csv.parse_line("\"hello, world\",foo,bar");
if len(row2) != 3           { print "quoted_comma_len FAIL: " + str(len(row2)); }
if row2[0] != "hello, world" { print "quoted_comma_val FAIL: " + row2[0]; }
if row2[1] != "foo"          { print "row2[1] FAIL"; }

// Escaped double-quote inside quoted field
let row3 = csv.parse_line("\"he said \"\"hi\"\"\",test");
if len(row3) != 2              { print "escaped_quote_len FAIL: " + str(len(row3)); }
if row3[0] != "he said \"hi\"" { print "escaped_quote_val FAIL: " + row3[0]; }
if row3[1] != "test"           { print "row3[1] FAIL"; }

// Multi-row parse
let text = "name,age\nAlice,30\nBob,25";
let rows = csv.parse(text);
if len(rows) != 3     { print "multirow_len FAIL: " + str(len(rows)); }
if rows[0][0] != "name"  { print "header0 FAIL"; }
if rows[0][1] != "age"   { print "header1 FAIL"; }
if rows[1][0] != "Alice" { print "alice FAIL"; }
if rows[1][1] != "30"    { print "age30 FAIL"; }
if rows[2][0] != "Bob"   { print "bob FAIL"; }
if rows[2][1] != "25"    { print "age25 FAIL"; }

print "csv_quoted_fields_pass";
