// tests/semantics/csv_quoted_test.sapp — RFC 4180 quoted fields via stdlib csv (G2-gamma)
let csv = import("stdlib:csv.sapp");

// parse_line: unquoted
let row1 = csv.parse_line("a,b,c", ",");
if len(row1) != 3 or row1[0] != "a" or row1[1] != "b" or row1[2] != "c" {
    throw "fail";
}

// parse_line: quoted with comma
let row2 = csv.parse_line("one,\"two, half\",three", ",");
if len(row2) != 3 or row2[0] != "one" or row2[1] != "two, half" or row2[2] != "three" {
    throw "fail";
}

// parse_line: escaped quote
let row3 = csv.parse_line("\"say \"\"hi\"\"\"", ",");
if len(row3) != 1 or row3[0] != "say \"hi\"" {
    throw "fail";
}

// parse: multi-line (multiple rows)
let text = "alpha,beta\ngamma,delta";
let rows = csv.parse(text, ",", false);
if len(rows) != 2 or len(rows[0]) != 2 or rows[0][0] != "alpha" or rows[0][1] != "beta" {
    throw "fail";
}
if len(rows[1]) != 2 or rows[1][0] != "gamma" or rows[1][1] != "delta" {
    throw "fail";
}

print "csv_quoted_fields_pass";
