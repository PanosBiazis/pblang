// tests/semantics/csv_quoted_test.sapp — RFC 4180 quoted fields via stdlib csv (G2-gamma)
let csv = import("stdlib:csv.sapp");

// parse_line: unquoted
let row1 = csv.parse_line("a,b,c", ",");
if len(row1) != 3 or row1[0] != "a" or row1[1] != "b" or row1[2] != "c" {
    throw "fail";
}

// parse_line: quoted with comma
let row2 = csv.parse_line("one,\"two, half\",three", ",");
if len(row2) != 3 or row2[0] != "one" or row2[1] != "two, half" or row2[2] != "three" {
    throw "fail";
}

// parse_line: escaped quote
let row3 = csv.parse_line("\"say \"\"hi\"\"\"", ",");
if len(row3) != 1 or row3[0] != "say \"hi\"" {
    throw "fail";
}

// parse: multi-line (multiple rows)
let text = "alpha,beta\ngamma,delta";
let rows = csv.parse(text, ",", false);
if len(rows) != 2 or len(rows[0]) != 2 or rows[0][0] != "alpha" or rows[0][1] != "beta" {
    throw "fail";
}
if len(rows[1]) != 2 or rows[1][0] != "gamma" or rows[1][1] != "delta" {
    throw "fail";
}

// parse: CRLF records should not leave trailing carriage returns in fields.
let crlf = csv.parse("a,b\r\nc,d\r\n", ",", false);
if len(crlf) != 2 or crlf[0][1] != "b" or crlf[1][0] != "c" or crlf[1][1] != "d" {
    throw "fail";
}

// parse: quoted embedded newline stays inside one field/record.
let multi = csv.parse("name,note\nAlice,\"line1\nline2\"\nBob,ok", ",", true);
if len(multi) != 2 or multi[0].name != "Alice" or multi[0].note != "line1\nline2" {
    throw "fail";
}
if multi[1].name != "Bob" or multi[1].note != "ok" {
    throw "fail";
}

// parse: raw spacing belongs to the field, not the record splitter.
let spaced = csv.parse("name,note\nAlice, keeps spaces ", ",", true);
if spaced[0].note != " keeps spaces " {
    throw "fail";
}

// parse: missing header cells are present as empty strings.
let missing = csv.parse("a,b\n1", ",", true);
if missing[0].a != "1" or missing[0].b != "" {
    throw "fail";
}

// helpers: records, headers, maps, and row-to-map conversion.
let recs = csv.split_records("a,\"b\nc\"\nd,e");
if len(recs) != 2 or recs[0] != "a,\"b\nc\"" or recs[1] != "d,e" {
    throw "fail";
}
let h = csv.headers("\nleft,right\n1,2", ",");
if len(h) != 2 or h[0] != "left" or h[1] != "right" {
    throw "fail";
}
let raw_rows = csv.parse_records("x,y\n1,2", ",");
if len(raw_rows) != 2 or raw_rows[1][0] != "1" or raw_rows[1][1] != "2" {
    throw "fail";
}
let mapped = csv.to_maps([["Ada", "Lovelace"], ["Grace"]], ["first", "last"]);
if mapped[0].first != "Ada" or mapped[0].last != "Lovelace" or mapped[1].last != "" {
    throw "fail";
}

// stringify: map headers are inferred across all rows, and CR fields quote.
let out = csv.stringify_maps([map{ a: 1 }, map{ a: 2, b: "x\ry" }], ",", nil);
let round = csv.parse_maps(out, ",");
if len(csv.infer_headers([map{ a: 1 }, map{ b: 2 }])) != 2 {
    throw "fail";
}
if len(round) != 2 or round[0].a != "1" or round[0].b != "" or round[1].b != "x\ry" {
    throw "fail";
}

print "csv_quoted_fields_pass";
