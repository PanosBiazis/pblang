let L=import("stdlib:table_lookup.sapp");let CSV=import("stdlib:sheet_csv.sapp");let Sheet=import("stdlib:sheet_document.sapp");
fn rejects(f) {let bad=false;try {f();}catch {bad=true;}assert(bad,"invalid lookup rejected");}
let a=CSV.decode("id,count\n001,2\n002,4\n001,1\n003,5");let b=CSV.decode("key,label\n001,α\n002,\n1,numeric-looking");let original=Sheet.encode(a);
let result=L.join(a,b,0,0,[1]);
assert(result.document.cells==[["id","count","label"],["001","2","α"],["002","4",""],["001","1","α"],["003","5",""]],"stable repeated left keys and literal values");
assert(result.row_matches==[true,true,true,false] and result.matched==3 and result.unmatched==1,"missing differs from matched blank");
let inner=L.join(a,b,0,0,[1],"inner");assert(len(inner.document.cells)==4 and inner.source_rows==[1,2,3],"inner join provenance");
result.document.cells[1][0]="changed";result.document.cells[0][0]="changed";assert(Sheet.encode(a)==original and b.cells[1][1]=="α","detached output");
assert(L.join(CSV.decode("id\na"),CSV.decode("id,label"),0,0,[1],"inner").document.cells==[["id","label"]],"empty match retains headers");
for f in [fn(){L.join(a,CSV.decode("id,label\n1,a\n1,b"),0,0,[1]);},fn(){L.join(a,CSV.decode("id,label\n ,a"),0,0,[1]);},fn(){L.join(CSV.decode("id\n "),b,0,0,[1]);},fn(){L.join(a,b,0,0,[1,1]);},fn(){L.join(a,b,0.5,0,[1]);},fn(){L.join(a,b,0,0,[2]);},fn(){L.join(a,b,0,0,[]);},fn(){L.join(a,b,0,0,[1],"outer");},fn(){L.join(Sheet.create(1,8),b,0,0,[1]);}] {rejects(f);}
let large=Sheet.create(32,1);large.cells[0][0]="id";for r in range(1,32) {large.cells[r][0]="k";}
assert(len(L.join(large,CSV.decode("id,x\nk,v"),0,0,[1]).document.cells)==32,"maximum row count preserved");
let full=Sheet.create(32,2);full.cells[0]=["id","text"];for r in range(1,32) {full.cells[r]=["k",str_repeat("x",250)];}
rejects(fn(){L.join(full,CSV.decode("id,value\nk,"+str_repeat("y",256)),0,0,[1]);});
assert(not inner.safe_to_log and inner.contains_cell_text,"report disclosure");print "table_lookup_pass";
