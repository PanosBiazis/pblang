let F = import("stdlib:compiler/selfhost_frontend.sapp");
let V = import("stdlib:compiler/vm.sapp");
let P = import("stdlib:selfhost_pbck.sapp");
fn expect(ok, label) { if not ok { throw "FAIL try-context: " + label; } }
fn run(source) {
    let c = F.frontend_compile(source);
    expect(c.ok and len(c.diagnostics) == 0, "checked compilation");
    let limits = map{ max_steps: 6000, max_frames: 16 };
    let plain = V.run_bounded(c.chunk, limits);
    let optimized = F.frontend_run_bounded(source, limits);
    let restored = V.run_bounded(P.deserialize_chunk(P.serialize_chunk(c.chunk)), limits);
    expect(optimized.ok and plain.globals.result == optimized.globals.result, "optimized values agree");
    expect(plain.globals.result == restored.globals.result, "in-memory bytecode round-trip values agree");
    return plain.globals.result;
}
expect(run("fn outer(x) { return fn() { return try x catch 0; }; } let f = outer(7); let result = f();") == 7, "capture discovered only in body");
expect(run("fn boom() { throw 4; } fn outer(x) { return fn() { return try boom() catch x; }; } let f = outer(8); let result = f();") == 8, "capture discovered only in handler");
expect(run("fn outer(a, b) { return fn() { let first = b; let second = try a catch b; return [first, second, a, b]; }; } let result = outer(7, 8)();") == [8, 7, 7, 8], "new capture preserves prior upvalue indices");
expect(run("fn outer(x) { return fn() { return try (try x catch 0) catch 0; }; } let result = outer(7)();") == 7, "nested try shares capture context");
expect(run("fn outer(x) { return fn() { return try (fn() { return x; }) catch (fn() { return 0; }); }; } let middle = outer(7); let inner = middle(); let result = inner();") == 7, "closure inside try captures transitive outer");
expect(run("fn boom() { throw 4; } fn outer(x) { return fn() { return try boom() catch (fn() { return x; }); }; } let middle = outer(8); let inner = middle(); let result = inner();") == 8, "closure inside handler captures transitive outer");
expect(run("fn outer(x) { return fn() { let y = try (if true { x = x + 1; x; } else { 0; }) catch 0; return [y, x]; }; } let result = outer(7)();") == [8, 8], "upvalue assignment shares enclosing frame");
expect(run("fn outer(π) { return fn() { return try π catch 0; }; } let result = outer(7)();") == 7, "Unicode capture");
expect(run("fn outer(x) { return fn() { let x = 9; return try x catch 0; }; } let result = outer(7)();") == 9, "own local precedes parent capture");
expect(not F.frontend_compile("let result = absent;").ok, "undefined outer reference is rejected");
expect(run("fn make(scale) { return map{ apply: fn(x) { return try (if x >= 0 { let y = x * scale; y; } else { throw 4; 0; }) catch -1; } }; } let obj = make(2); let seen = []; for x in [1, -2, 3] { array_push(seen, obj.apply(x)); } let result = seen;") == [2, -1, 6], "object-style dispatch/closure/loop/exception composition");
print "selfhost_try_capture_pass";
