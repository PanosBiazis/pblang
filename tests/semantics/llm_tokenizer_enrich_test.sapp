// tests/semantics/llm_tokenizer_enrich_test.sapp — enrichment for stdlib/llm_tokenizer.sapp
// Adds encode_batch/decode_batch, pad_sequences, token_to_id/decode_id, count_tokens.

let tk = import("stdlib/llm_tokenizer.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn aeq(a, b, m) {
    if len(a) != len(b) { fail(m + " len"); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " @" + str(i)); } i = i + 1; }
}

let t = tk.char_train("hello world");

// ── base round-trip still works ──────────────────────────────────────────────────
eq(tk.decode(t, tk.encode(t, "hello")), "hello", "encode/decode round-trip");

// ── ENRICH: count_tokens / token_to_id / decode_id ───────────────────────────────
eq(tk.count_tokens(t, "hello"), 5, "count_tokens");
let hid = tk.token_to_id(t, "h");
eq(tk.decode_id(t, hid), "h", "token_to_id <-> decode_id round-trip");
eq(tk.token_to_id(t, "Z"), t.unk_id, "unknown token -> unk_id");

// ── ENRICH: encode_batch / decode_batch ──────────────────────────────────────────
let enc = tk.encode_batch(t, ["he", "lo"]);
eq(len(enc), 2, "encode_batch count");
let dec = tk.decode_batch(t, enc);
eq(dec[0], "he", "decode_batch[0]"); eq(dec[1], "lo", "decode_batch[1]");

// ── ENRICH: pad_sequences (pad short, truncate long) ─────────────────────────────
let padded = tk.pad_sequences([[1, 2], [3, 4, 5, 6]], 3, 0);
aeq(padded[0], [1, 2, 0], "pad short with pad_id");
aeq(padded[1], [3, 4, 5], "truncate long to max_len");

print "llm_tokenizer_enrich_pass";
