let B=import("../../examples/microcontroller_connectivity/bridge.sapp");
fn check(v){if not v {throw "Connectivity options regression.";}}
let uno=B.options(["uno-r4-wifi","/example/export.json","/dev/ttyACM0","1883","4","1","--confirmed"]);
check(uno.repetitions==4 and uno.broker_port==1883);
let esp=B.options(["esp32-wroom-32d","/dev/ttyUSB0","1883","0","--confirmed"]);
check(esp.sequence==0);
for args in [[],["unknown"],["esp32-wroom-32d","/dev/ttyUSB0","1883","1"],
    ["esp32-wroom-32d","/dev/ttyUSB0","1883suffix","1","--confirmed"],
    ["esp32-wroom-32d","/dev/ttyUSB0","65536","1","--confirmed"],
    ["esp32-wroom-32d","/dev/ttyUSB0","1883","2147483648","--confirmed"],
    ["esp32-wroom-32d","/dev/ttyUSB0/../ttyUSB1","1883","1","--confirmed"],
    ["uno-r4-wifi","relative.json","/dev/ttyACM0","1883","1","1","--confirmed"],
    ["uno-r4-wifi","/example/export.json","/dev/ttyACM0","1883","0","1","--confirmed"]] {
    check((try B.options(args) catch nil)==nil);
    let result=B.run(args);check(not result.ok and not result.network_attempted);
}
print "microcontroller connectivity options PASS";
