// Counted resource-free backend; Windows routing is modeled, not native tested.
fn _assert_result(result, B, close_mode, expected, reads, lists) {
    assert(B.state.opens == 1 and B.state.closes == 1
        and B.state.reads == reads and B.state.lists == lists, "exactly one acquired-parent close");
    if close_mode != "success" {
        assert(not result.ok and result.cleanup_uncertain and not result.parent_close_confirmed
            and len(map_keys(result)) == 4, "fixed cleanup uncertainty result");
        assert(result.error == "secure optional parent cleanup could not be verified", "fixed close diagnostic");
    } elif expected == "data" {
        assert(result.ok and not result.missing and result.text == "α" and result.size == 2
            and len(map_keys(result)) == 4, "normal UTF-8 result unchanged");
    } elif expected == "empty" {
        assert(result.ok and not result.missing and result.text == "" and result.size == 0, "empty file");
    } elif expected == "missing" {
        assert(result.ok and result.missing and len(map_keys(result)) == 2, "proven absence only");
    } else {
        assert(not result.ok, "malformed/error result rejected");
        if expected == "backend_failure" {
            assert(result.error == "synthetic failure" and result.marker == 7, "ordinary backend error retained");
        }
        if expected == "throw" {
            assert(result.error == "secure optional read backend failed", "exception diagnostic fixed");
        }
    }
    if not result.ok or (try result.missing catch false) {
        assert(not map_has(result, "text") and not map_has(result, "bytes"), "no data on rejected/missing result");
    }
    assert(not str_contains(json_stringify(result), "synthetic-private-value"), "no thrown value disclosure");
}

fn run(S, B, windows_model = false) {
    let cases = 0;
    let closes = ["success", "false", "nil", "number", "map", "throw"];
    if not windows_model {
        let list_cases = [
            ["present","data",1], ["absent","missing",0], ["truncated_absent","error",0],
            ["truncated_present","data",1], ["missing_truncated_absent","error",0],
            ["missing_truncated_present","data",1], ["bad_truncated_absent","error",0],
            ["bad_entries","error",0], ["bad_entry","error",0], ["oversize_entries","error",0],
            ["nil","error",0], ["bad_ok","error",0], ["failure","error",0], ["throw","throw",0]
        ];
        for item in list_cases {
            for close_mode in closes {
                B.configure(item[0], "success", close_mode);
                _assert_result(S.read_optional_text("owned/input", 8), B, close_mode, item[1], item[2], 1);
                cases = cases + 1;
            }
        }
    }
    let read_cases = [
        ["success","data"], ["empty","empty"], ["failure","backend_failure"], ["throw","throw"],
        ["nil","error"], ["bad_ok","error"], ["bad_bytes","error"], ["missing_bytes","error"],
        ["bad_size","error"], ["missing_size","error"], ["fraction","error"], ["negative","error"],
        ["nan","error"], ["infinity","error"], ["mismatch","error"], ["over_cap","error"],
        ["invalid_utf8","error"], ["missing",if windows_model {"missing"} else {"backend_failure"}],
        ["bad_missing","backend_failure"]
    ];
    for item in read_cases {
        for close_mode in closes {
            B.configure("present", item[0], close_mode);
            _assert_result(S.read_optional_text("owned/input", 8), B, close_mode, item[1], 1,
                if windows_model {0} else {1});
            cases = cases + 1;
        }
    }
    B.configure("present", "success", "success");
    for invalid in [-1, 1.5, "8", nil] { if S.read_optional_text("owned/input", invalid).ok { throw "invalid limit"; } }
    assert(not S.read_optional_text("", 8).ok, "empty path");
    assert(B.state.opens == 0 and B.state.closes == 0 and B.state.lists == 0 and B.state.reads == 0,
        "invalid admission acquires nothing");
    B.state.admit = false;
    assert(not S.read_optional_text("owned/input", 8).ok, "parent admission failure");
    assert(B.state.opens == 1 and B.state.closes == 0, "unacquired parent not closed");
    return map{ok:true,matrix_cases:cases,admission_cases:6,windows_model:windows_model};
}
export run;
