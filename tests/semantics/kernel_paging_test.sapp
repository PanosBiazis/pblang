// Test: virtual memory / paging language readiness (stdlib/kernel/paging.sapp), §83.
//
// The page-table primitives + the set_cr3/enable_paging/read_cr2/invlpg intrinsics — the
// reusable pblang facilities a kernel uses to build address spaces. (The VM subsystem is
// the author's to build; this is the readiness.) Proven END-TO-END in QEMU rigorously:
// identity-map the first 4 MiB (so the kernel keeps running), map VIRTUAL 4 MiB ->
// PHYSICAL 2 MiB via a second page table, enable paging, and read virtual 4 MiB back —
// it returns the sentinel written to physical 2 MiB, proving real address translation
// (exit 85). A broken table would page-fault -> triple fault -> exit 0.

let ct = import("stdlib/compiler/ctranspile.sapp");
let pg = fs_read("stdlib/kernel/paging.sapp");

let src = "fn kmain() { cli(); poke32(2097152, 305419896); "
    + "let pd = page_alloc(); pd_init(pd); "
    + "let pt0 = page_alloc(); pt_identity(pt0, 0); pd_set(pd, 0, pt0); "
    + "let pt1 = page_alloc(); pd_init(pt1); pt_map(pt1, 0, 2097152, 3); pd_set(pd, 1, pt1); "
    + "paging_enable(pd); let v = peek32(4194304); "
    + "if v == 305419896 { outb(244, 42); } while 1 > 0 { hlt(); } }";

let c = ct.transpile_kernel_int(pg + src);

// ── Paging intrinsics ────────────────────────────────────────────────────────────────
assert(str_contains(c, "static inline void set_cr3("), "set_cr3 (load page-directory base) intrinsic");
assert(str_contains(c, "orl $0x80000000"), "enable_paging flips CR0.PG (bit 31)");
assert(str_contains(c, "static inline u32 read_cr2("), "read_cr2 (faulting address) intrinsic");
assert(str_contains(c, "static inline void invlpg("), "invlpg (TLB flush) intrinsic");

// ── Page-table primitives ────────────────────────────────────────────────────────────
assert(str_contains(c, "long page_alloc()"), "4 KiB-aligned page allocator");
assert(str_contains(c, "long pd_init(long pd)"), "page-directory clear");
assert(str_contains(c, "long pd_set(long pd, long idx, long pt)"), "directory -> table link");
assert(str_contains(c, "long pt_identity(long pt, long base_phys)"), "identity-map a 4 MiB table");
assert(str_contains(c, "long pt_map(long pt, long idx, long phys, long flags)"), "map a single page");
assert(str_contains(c, "long paging_enable(long pd)"), "install CR3 + turn paging on");
// page_alloc rounds the bump-allocated base up to a 4 KiB boundary.
assert(str_contains(c, "(~(long)4095)"), "page_alloc aligns to a 4 KiB boundary");

assert(not str_contains(c, "double"), "paging path is float-runtime-free");
assert(str_contains(c, "0x1BADB002"), "multiboot header present");

print "kernel_paging_pass";
