let MEDIA = import("stdlib:media_generation.sapp");
let IMAGE = import("stdlib:image_pipeline.sapp");

fn expect(value, message) { if not value { throw "FAIL media generation: " + message; } }
fn rejected(callback) { return try { callback(); false } catch true; }

let capabilities = MEDIA.capabilities();
expect(capabilities.deterministic_native_generation and not capabilities.semantic_native_model,
    "capabilities distinguish procedural generation from semantic model inference");

let image = MEDIA.generate_image("bounded blue geometry", 24, 20, "mosaic");
expect(image.ok and image.width == 24 and image.height == 20
    and len(IMAGE.encode_png(image.image)) > 32 and not image.semantic_prompt_interpretation,
    "procedural image generation produces a valid PNG-ready RGBA image");

let tone = MEDIA.generate_tone(440, 0.02, "sine", 8000, 0.4, 1);
expect(tone.ok and tone.audio.sample_rate == 8000 and len(tone.audio.samples) == 160,
    "tone generation produces bounded PCM16 samples");
let effect = MEDIA.generate_sound_effect("confirm", 0.05, 8000, 0.4);
expect(effect.ok and len(effect.audio.samples) == 400,
    "sound-effect generation uses the requested duration");
let music = MEDIA.generate_music("short calm theme", 1, 120, "calm", 8000, 0.3);
expect(music.ok and music.generation_mode == "procedural-composition"
    and not music.semantic_prompt_interpretation,
    "music generation is executable and honestly classified");

let video = MEDIA.generate_video("moving color field", 16, 16, 0.1, 1, "motion");
expect(video.ok and video.frames == 1 and bytes_to_str(slice(video.bytes, 0, 8)) == "YUV4MPEG",
    "video generation emits a real bounded Y4M stream");

let png = IMAGE.encode_png(image.image);
let hook = MEDIA.create_hook_request("image-generate", "a semantic skyline", map{ width: 24, height: 20 });
let response = map{ request_digest: hook.request_digest, mime_type: "image/png",
    data_base64: base64_encode_bytes(png) };
let accepted = MEDIA.accept_hook_response(hook.request_json_base64,
    base64_encode_bytes(str_to_bytes(json_stringify(response))));
expect(accepted.ok and accepted.artifact_validated and accepted.output_bytes == len(png)
    and not accepted.credentials_consumed and not accepted.prompt_exposed,
    "model handoff validates request binding and artifact bytes without credentials");

expect(rejected(fn() { MEDIA.generate_image("x", 4096, 4096, "noise"); })
    and rejected(fn() { MEDIA.generate_tone(5, 1, "sine", 8000, 1, 1); })
    and rejected(fn() { MEDIA.create_hook_request("image-edit", "edit", map{}); }),
    "oversized, invalid, and incomplete requests fail closed");
let wrong = map{ request_digest: "wrong", mime_type: "image/png", data_base64: base64_encode_bytes(png) };
expect(rejected(fn() { MEDIA.accept_hook_response(hook.request_json_base64,
    base64_encode_bytes(str_to_bytes(json_stringify(wrong)))); }),
    "hook responses cannot be replayed against another request digest");

print "media_generation_test_pass";
