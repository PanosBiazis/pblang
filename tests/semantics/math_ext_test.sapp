// math_ext_test.sapp
// Basic coverage for math util, stats, algorithms, and linear algebra helpers.

let math = import("stdlib:math.sapp");

fn near(a, b, eps) {
    let d = a - b;
    if d < 0 { d = 0 - d; }
    return d <= eps;
}

// scalar helpers
if math.util.clamp(5, 0, 10) != 5 { throw "FAIL clamp inside"; }
if math.util.clamp(-1, 0, 10) != 0 { throw "FAIL clamp below"; }
if math.util.clamp(20, 0, 10) != 10 { throw "FAIL clamp above"; }

if math.util.lerp(0, 10, 0) != 0 { throw "FAIL lerp start"; }
if math.util.lerp(0, 10, 0.5) != 5 { throw "FAIL lerp mid"; }
if math.util.lerp(0, 10, 1) != 10 { throw "FAIL lerp end"; }

let s0 = math.util.smoothstep(0, 1, 0);
let s1 = math.util.smoothstep(0, 1, 0.5);
let s2 = math.util.smoothstep(0, 1, 1);
if s0 != 0 { throw "FAIL smoothstep start"; }
if s1 != 0.5 { throw "FAIL smoothstep mid"; }
if s2 != 1 { throw "FAIL smoothstep end"; }

if not near(math.asin(1), math.PI / 2, 0.000001) { throw "FAIL asin endpoint"; }
if not near(math.acos(1), 0, 0.000001) { throw "FAIL acos endpoint"; }
if not near(math.asin(0.5), math.PI / 6, 0.000001) { throw "FAIL asin mid"; }
if not near(math.deg_to_rad(180), math.PI, 0.000000001) {
    throw "FAIL degrees to radians public API";
}
if not near(math.rad_to_deg(math.PI / 2), 90, 0.000000001) {
    throw "FAIL radians to degrees public API";
}
if not near(math.rad_to_deg(math.deg_to_rad(-450)), -450, 0.000000001) {
    throw "FAIL signed angle conversion round trip";
}
let invalid_asin = try math.asin(1.1) catch nil;
if invalid_asin != nil { throw "FAIL asin must reject values outside -1..1"; }

// documented stats namespace
if math.stats.sum([1,2,3,4]) != 10 { throw "FAIL stats sum"; }
if math.stats.mean([2,4,6]) != 4 { throw "FAIL stats mean"; }
if math.stats.median([3,1,2]) != 2 { throw "FAIL stats median odd"; }
if math.stats.median([4,1,3,2]) != 2.5 { throw "FAIL stats median even"; }
if math.stats.variance([2,4,6]) != 4 { throw "FAIL stats variance"; }
if math.stats.stddev([2,4,6]) != 2 { throw "FAIL stats stddev"; }
if math.stats.min([3,1,2]) != 1 { throw "FAIL stats min"; }
if math.stats.max([3,1,2]) != 3 { throw "FAIL stats max"; }
if math.stats.range([3,1,2]) != 2 { throw "FAIL stats range"; }

// algorithms should use the non-negative gcd implementation.
if math.algorithms.gcd(-48, 18) != 6 { throw "FAIL gcd negative"; }
if math.algorithms.gcd(48, 18) != 6 { throw "FAIL gcd positive"; }

// linear algebra public API
let add = math.la.vec_add([1,2], [3,4]);
if add[0] != 4 or add[1] != 6 { throw "FAIL vec_add"; }
let sub = math.la.vec_sub([5,7], [2,3]);
if sub[0] != 3 or sub[1] != 4 { throw "FAIL vec_sub"; }
let scaled = math.la.vec_scale([2,4], 0.5);
if scaled[0] != 1 or scaled[1] != 2 { throw "FAIL vec_scale"; }
if math.la.vec_dot([1,2,3], [4,5,6]) != 32 { throw "FAIL vec_dot"; }

let mm = math.la.mat_mul([[1,2]], [[3],[4]]);
if mm[0][0] != 11 { throw "FAIL mat_mul"; }
let mv = math.la.mat_vec_mul([[1,2],[3,4]], [5,6]);
if mv[0] != 17 or mv[1] != 39 { throw "FAIL mat_vec_mul"; }
let tr = math.la.mat_transpose([[1,2,3],[4,5,6]]);
if tr[0][0] != 1 or tr[0][1] != 4 or tr[2][0] != 3 or tr[2][1] != 6 { throw "FAIL transpose"; }

// native tensor-backed routes for larger arrays should preserve the same API.
let big_a = [];
let big_b = [];
for i 512 {
    big_a[len(big_a)] = i;
    big_b[len(big_b)] = 1;
}
if math.stats.sum(big_b) != 512 { throw "FAIL native stats sum"; }
let big_add = math.la.vec_add(big_a, big_b);
if big_add[0] != 1 or big_add[511] != 512 { throw "FAIL native vec_add"; }
let big_dot = math.la.vec_dot(big_b, big_b);
if big_dot != 512 { throw "FAIL native vec_dot"; }

let sqrt34 = math.complex.sqrt(math.complex.new(3, 4));
if not near(sqrt34.re, 2, 0.000001) or not near(sqrt34.im, 1, 0.000001) { throw "FAIL complex sqrt 3+4i"; }
let sqrt_neg = math.complex.sqrt(math.complex.new(-1, 0));
if not near(sqrt_neg.re, 0, 0.000001) or not near(sqrt_neg.im, 1, 0.000001) { throw "FAIL complex sqrt -1"; }
let ln_one = math.complex.ln(math.complex.new(1, 0));
if not near(ln_one.re, 0, 0.000001) or not near(ln_one.im, 0, 0.000001) { throw "FAIL complex ln 1"; }
let eipi = math.complex.exp(math.complex.new(0, math.PI));
if not near(eipi.re, -1, 0.000001) or not near(eipi.im, 0, 0.000001) { throw "FAIL complex exp i*pi"; }
let pow_i2 = math.complex.pow_scalar(math.complex.new(0, 1), 2);
if not near(pow_i2.re, -1, 0.000001) or not near(pow_i2.im, 0, 0.000001) { throw "FAIL complex pow i^2"; }

print "math_ext_test: pass";

