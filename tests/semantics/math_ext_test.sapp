// math_ext_test.sapp
// Basic coverage for math.util scalar helpers.

let math = import("stdlib:math.sapp");

// clamp
print math.util.clamp(5, 0, 10);    // inside
print math.util.clamp(-1, 0, 10);   // below
print math.util.clamp(20, 0, 10);   // above

// lerp
print math.util.lerp(0, 10, 0);     // 0
print math.util.lerp(0, 10, 0.5);   // 5
print math.util.lerp(0, 10, 1);     // 10

// smoothstep basic shape within [0,1]
let s0 = math.util.smoothstep(0, 1, 0);
let s1 = math.util.smoothstep(0, 1, 0.5);
let s2 = math.util.smoothstep(0, 1, 1);
print s0;
print s1;
print s2;

print "math_ext_test: pass";

