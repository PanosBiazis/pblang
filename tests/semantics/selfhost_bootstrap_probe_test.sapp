// tests/semantics/selfhost_bootstrap_probe_test.sapp
//
// docs/CURRENT_STATUS.md "Recommended Next Steps" item 3 (bootstrap probe),
// bounded so the suite stays fast: the self-hosted VM imports and RUNS the
// compiler's own tokenizer (stdlib/compiler/tokenizer.sapp) on a pblang
// program — compiler code executing inside the compiler, one level down —
// and the result is diffed against the Rust VM running the same tokenizer.
// (bootstrap.sapp's self_compile_basic is level 1: components on their own
// source, ON the Rust VM. This is level 2: components run BY the self-hosted
// VM. The full frontend_compile-of-itself probe remains future perf work.)

let fe = import("stdlib/compiler/selfhost_frontend.sapp");
let T = import("stdlib/compiler/tokenizer.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }

let program = "fn add(x, y) { return x + y; }";

// level 0: the Rust VM runs the tokenizer
let native = T.tokenize(program);

// level 1->2: the self-hosted VM imports the SAME tokenizer source and runs it
let src = ""
    + "let T = import(\"stdlib/compiler/tokenizer.sapp\");\n"
    + "let toks = T.tokenize(\"fn add(x, y) { return x + y; }\");\n"
    + "let n = len(toks);\n"
    + "let first_kind = toks[0].kind;\n"
    + "let first_text = toks[0].text;\n"
    + "let last_kind = toks[n - 1].kind;\n";

let r = fe.frontend_run(src);
truthy(r.ok, "self-hosted VM runs the compiler's own tokenizer");

eq(r.globals["n"], len(native), "token count agrees across levels");
eq(r.globals["first_kind"], native[0].kind, "first token kind agrees");
eq(r.globals["first_text"], native[0].text, "first token text agrees");
eq(r.globals["last_kind"], native[len(native) - 1].kind, "last token kind agrees");

// and the values are the known-correct ones
eq(r.globals["n"], 15, "15 tokens");
eq(r.globals["first_kind"], "keyword", "starts with the fn keyword");
eq(r.globals["first_text"], "fn", "keyword text");

print "selfhost_bootstrap_probe_pass";
