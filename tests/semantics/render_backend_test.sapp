// tests/semantics/render_backend_test.sapp — stdlib/render_backend.sapp
//
// The "selectable backend" decision for a pblang UI app (PBIDE): given the HONEST gfx
// backend profile (stdlib/graphics.backend_profile), pick the render path and report
// whether a GPU host can be exported via the gpu2d stack. Pure decision logic — takes the
// profile as data so it is testable without a window.

let RB = import("stdlib/render_backend.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }

// three selectable paths
eq(len(RB.paths()), 3, "three render paths");

// ── CPU framebuffer profile (minifb, no GPU present) ────────────────────────────────
let cpu = map{ backend: "minifb", gpu_present: false, compiled_sdl2: false, cpu_raster_ui: true, present: "cpu-framebuffer" };
let s1 = RB.select(cpu);
eq(s1.path, "cpu-minifb", "minifb -> cpu path");
truthy(not s1.gpu, "no GPU present");
truthy(s1.can_export_gpu2d, "gpu2d host export is always available (codegen)");

// ── SDL2 GPU-present profile (CPU raster, GPU texture present) ───────────────────────
let sdl = map{ backend: "sdl2", gpu_present: true, compiled_sdl2: true, cpu_raster_ui: true, present: "gpu-texture-present" };
let s2 = RB.select(sdl);
eq(s2.path, "cpu-sdl2-present", "sdl2 -> cpu raster + gpu present");
truthy(s2.gpu, "GPU present active");
// honest: even with GPU present, UI is still CPU-rasterized
truthy(s2.cpu_raster, "UI pixels still CPU-rasterized");

// describe() is a human one-liner
truthy(str_contains(RB.describe(sdl), "sdl2"), "describe mentions backend");

// recommend() suggests the best available among the paths
truthy(str_contains(RB.recommend(cpu), "gpu2d") or str_contains(RB.recommend(cpu), "sdl2"), "recommend points to an upgrade path");

print "render_backend_pass";
