// tests/semantics/middleware_chain_test.sapp — fix + enrichment for middleware_chain
//
// FIX: run() implemented its recursion with a NESTED named function `_next`, but a
//      nested fn's self-call resolves as an (undefined) GLOBAL in pblang, so run()
//      THREW on any pipeline whose handlers call next() — i.e. the entire onion
//      pattern the module exists for. Hoisted to a module-level recursive helper.
// ENRICH: use (alias), add_all, length, and run_safe (never throws).

let mw = import("stdlib/middleware_chain.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── FIX: the onion runs, in the right order, mutating ctx ────────────────────────
let p = mw.create();
let log = [];
mw.add(p, fn(ctx, next) { array_push(log, "a-in"); ctx.a = 1; let r = next(ctx); array_push(log, "a-out"); return r; });
mw.add(p, fn(ctx, next) { array_push(log, "b-in"); ctx.b = 2; let r = next(ctx); array_push(log, "b-out"); return r; });
let out = mw.run(p, map{ data: "x" });
eq(out.a, 1, "first middleware ran");
eq(out.b, 2, "second middleware ran");
eq(out.data, "x", "ctx threaded through");
eq(str_join(log, ","), "a-in,b-in,b-out,a-out", "onion before/after order");

// ── short-circuit: a handler that does NOT call next stops the chain ─────────────
let p2 = mw.create();
mw.add(p2, fn(ctx, next) { return map{ stopped: true }; });
mw.add(p2, fn(ctx, next) { ctx.reached = true; return next(ctx); });
let out2 = mw.run(p2, map{});
eq(out2.stopped, true, "short-circuit returns the handler's result");
if (try out2.reached catch nil) != nil { fail("downstream handler must be skipped"); }

// ── empty pipeline returns the context unchanged ────────────────────────────────
eq(mw.run(mw.create(), map{ v: 9 }).v, 9, "empty pipeline passes ctx through");

// ── ENRICH: use alias + add_all + length ────────────────────────────────────────
let p3 = mw.create();
mw.use(p3, fn(ctx, next) { ctx.x = 1; return next(ctx); });
mw.add_all(p3, [
    fn(ctx, next) { ctx.y = 2; return next(ctx); },
    fn(ctx, next) { ctx.z = 3; return next(ctx); }
]);
eq(mw.length(p3), 3, "length counts all handlers");
let out3 = mw.run(p3, map{});
eq(out3.x + out3.y + out3.z, 6, "use + add_all handlers all ran");

// ── ENRICH: run_safe never throws (handler error -> {ok:false}) ─────────────────
let p4 = mw.create();
mw.add(p4, fn(ctx, next) { return next(ctx); });
mw.add(p4, fn(ctx, next) { return boom_undefined(); });   // throws
let safe = mw.run_safe(p4, map{});
eq(safe.ok, false, "run_safe reports a handler error as ok:false");
let pgood = mw.create();
mw.add(pgood, fn(ctx, next) { ctx.n = ctx.n + 1; return next(ctx); });
let okr = mw.run_safe(pgood, map{ n: 5 });
eq(okr.ok, true, "run_safe ok on success");
eq(okr.result.n, 6, "run_safe returns the result");

// ── compose (value transforms) still works ──────────────────────────────────────
let f = mw.compose([ fn(v) { return v + 1; }, fn(v) { return v * 10; } ]);
eq(f(2), 30, "compose applies transforms left-to-right");

print "middleware_chain_pass";
