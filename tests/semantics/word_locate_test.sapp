let P=import("stdlib:word_profile.sapp");let T=import("stdlib:text_document.sapp");let V=import("stdlib:word_profile_view.sapp");let UI=import("stdlib:modern_ui.sapp");let G=import("stdlib:gui.sapp");
let doc=T.from_text("word Word word, word\nλέξη λέξη α ά\nword\u00a0Word","wordonlytitle");let before=T.encode(doc);
for token in ["word","Word","word,","λέξη","α","ά","word\u00a0Word"]{let found=P.locate(doc,token);assert(found.found,"literal form found");let item=found.page.entries[num_mod(found.position,P.PAGE_SIZE)];assert(item.token==token,"exact returned form");assert(found.page==P.page(doc,found.page.index),"same page contract");}assert(P.locate(doc,"word").page.entries[0].blocks==[0],"unique locations");
for absent in ["WORD","wordonlytitle","wor","word Word"]{assert(P.locate(doc,absent)==map{found:false},"not substring or normalization");}
for bad in [nil,0,true,[],"",str_repeat("x",257),str_repeat("α",129),"a\u0000b"]{assert((try P.locate(doc,bad) catch nil)==nil,"bounded query");}assert((try P.locate(map{},"word") catch nil)==nil,"document validated");assert(P.locate(T.create(),"word")==map{found:false},"empty body");
let many=T.create();many.blocks=[];for b in range(0,32){let terms=[];for j in range(0,8){array_push(terms,"term"+str(b*8+j));}array_push(many.blocks,map{kind:"paragraph",text:str_join(terms," ")});}
for i in range(0,256){let found=P.locate(many,"term"+str(i));assert(found.found and found.position==i and found.page.index==num_floor(i/8),"all 256 forms located on exact page");assert(found.page.entries[num_mod(i,8)].blocks==[num_floor(i/8)],"source block for each form");}
let long=T.from_text(str_repeat("α",128));assert(P.locate(long,str_repeat("α",128)).found,"256-byte query boundary");let found=P.locate(doc,"word");found.page.entries[0].blocks[0]=99;assert(T.encode(doc)==before,"detached found page");
let last=P.locate(many,"term255");let view=V.create(many,last.page.index);for target in ["native","web","android"]{assert(len(UI.compile(view,map{target:target,width:412,height:915}).records)>0,"located page portable generation");}let f=UI.build("Located words",view,map{width:800,height:900});G.get(f,"select_7").onclick(f);assert(G.get(f,"detail_0").text=="term255","located page entry selection");print "word_locate_pass forms=256";
