let H=import("stdlib:project_marker_hints.sapp");

fn check_report(value) {
    let fields=["format","ok","error","input_count","unique_name_count",
        "recognized_marker_count","family_counts","metadata_only","contains_names",
        "contains_paths","contains_digests","content_read","execution_performed",
        "existence_verified","kind_verified","repository_verified","language_verified",
        "toolchain_verified","license_verified","authenticity_verified",
        "idea_admission_eligible","implementation_allowed","training_allowed",
        "external_effects_allowed","safe_to_log","production_ready"];
    assert(len(map_keys(value))==len(fields),"exact outer schema");
    for field in fields { assert(map_has(value,field),"required field"); }
    assert(value.format=="pblang.project-marker-hints.v1" and value.metadata_only,"format");
    let denied=["contains_names","contains_paths","contains_digests","content_read",
        "execution_performed","existence_verified","kind_verified","repository_verified",
        "language_verified","toolchain_verified","license_verified","authenticity_verified",
        "idea_admission_eligible","implementation_allowed","training_allowed",
        "external_effects_allowed","safe_to_log","production_ready"];
    for field in denied { assert(value[field]==false,"non-authorizing report"); }
    assert(len(map_keys(value.family_counts))==20,"exact family count");
    let sum=0;
    for family in map_keys(value.family_counts) {
        let count=value.family_counts[family];
        assert(type(count)=="number" and count==num_floor(count)
            and count>=0 and count<=256,"bounded integer family count");
        sum=sum+count;
    }
    assert(sum==value.recognized_marker_count
        and sum<=value.unique_name_count and value.unique_name_count<=value.input_count
        and value.input_count<=256,"aggregate count invariants");
    assert((value.ok and value.error=="")
        or (not value.ok and value.error=="invalid-input"),"exact success/failure pairing");
}

let families=["pblang","cargo","javascript_package","python_packaging","go_module",
    "maven","gradle","cmake","dart_pub","swift_package","godot","composer","bundler",
    "make","dotnet_project","msbuild_cpp","visual_studio_solution","delphi_project",
    "lazarus_project","unreal_project"];
let names=["pblang.toml","Cargo.toml","package.json","pyproject.toml","go.mod",
    "pom.xml","build.gradle","CMakeLists.txt","pubspec.yaml","Package.swift",
    "project.godot","composer.json","Gemfile","Makefile","private-marker.csproj",
    "private-marker.vcxproj","private-marker.sln","private-marker.dproj",
    "private-marker.lpi","private-marker.uproject"];
let report=H.summarize(names);
check_report(report);
assert(report.ok and report.input_count==20 and report.recognized_marker_count==20,"all families");
for family in families { assert(report.family_counts[family]==1,"one hint per family"); }
let public_text=json_stringify(report);
for name in names { assert(not str_contains(public_text,name),"no marker names"); }
assert(not str_contains(public_text,"private-marker"),"no user stems");

let aliases=H.summarize(["setup.py","build.gradle.kts","x.fsproj","x.vbproj",
    "x.slnx","x.groupproj","δοκιμή.lpi","x.slnx"]);
check_report(aliases);
assert(aliases.ok and aliases.input_count==8 and aliases.unique_name_count==7
    and aliases.recognized_marker_count==7 and aliases.family_counts.dotnet_project==2
    and aliases.family_counts.visual_studio_solution==1,"aliases and exact deduplication");
let generic=H.summarize(["x.cs","x.pas","x.dart","x.swift","x.tscn","x.uasset",
    "x.html","x.lpr",".csproj","x.CSPROJ","cargo.toml","PACKAGE.JSON","pubspec.yml"]);
assert(generic.ok and generic.recognized_marker_count==0,"no generic or case-folded hints");
let empty=H.summarize([]); check_report(empty);
assert(empty.ok and empty.unique_name_count==0,"empty is valid, not evidence of absence");

fn rejected(names) {
    let value=H.summarize(names); check_report(value);
    assert(not value.ok and value.error=="invalid-input" and value.input_count==0
        and value.unique_name_count==0 and value.recognized_marker_count==0,"fixed zeroed failure");
    for family in families { assert(value.family_counts[family]==0,"no partial counts"); }
    assert(not str_contains(json_stringify(value),"private-marker"),"failure privacy");
}
for bad in [nil,true,1,"Cargo.toml",map{}] { rejected(bad); }
for bad in [nil,true,1,map{},[],"",".","..","private-marker/x.csproj",
    "private-marker\\x.csproj","C:private-marker.csproj","private-marker:stream.csproj",
    str_repeat("x",256),str_repeat("é",128)] {
    rejected(["private-marker.csproj",bad]);
}
for control in [0,31,127,159,173,1564,6158,8203,8207,8232,8238,8288,8303,65279,65529,65531] {
    rejected(["private-marker"+strfromcharcode(control)+".csproj"]);
}
assert(H.summarize([str_repeat("x",248)+".csproj"]).recognized_marker_count==1,"255 byte boundary");
assert(H.summarize([str_repeat("é",124)+".csproj"]).recognized_marker_count==1,"UTF8 byte boundary");
let at_limit=[];
for _i in range(0,256) { array_push(at_limit,str_repeat("x",128)); }
assert(H.summarize(at_limit).ok and H.summarize(at_limit).unique_name_count==1,"count and byte limits");
at_limit[255]=str_repeat("x",129); rejected(at_limit);
at_limit[255]=str_repeat("x",128); array_push(at_limit,"x"); rejected(at_limit);
report.family_counts.pblang=100;
assert(H.summarize([]).family_counts.pblang==0,"fresh counts across calls");
print "project_marker_hints_pass";
