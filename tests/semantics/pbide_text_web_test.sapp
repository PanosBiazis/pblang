let W=import("editors/ide/pbide_text_web.sapp");
let T=import("editors/ide/pbide_text.sapp");
fn rejects(f) { let rejected=false; try { f(); } catch { rejected=true; } return rejected; }
fn form(source,start,end,op="status",insert="") {
    return "source="+url_encode(source)+"&start="+str(start)+"&end="+str(end)
        +"&insert="+url_encode(insert)+"&op="+op+"&pair=round";
}
let port=18771;
fn request(body) {
    return map{method:"POST",path:"/edit",body:body,headers:map{
        host:W.endpoint(port),origin:"http://"+W.endpoint(port),
        "content-type":"application/x-www-form-urlencoded","content-length":str(len(str_to_bytes(body)))}};
}
let text="  α😀\nβ  ";
assert(W.parse_form(form(text,2,4,"pair")).text=="  (α😀)\nβ  ","Unicode and whitespace retained");
assert(W.parse_form(form("\r\nx",0,0)).text=="\nx","browser CRLF normalized once");
assert(W.parse_form(form("abcd",1,3,"replace","x")).text=="axd","replacement connected");
assert(W.parse_form(form("a",1,1,"tab")).text=="a    ","Tab connected");
for body in ["",form("a",0,0)+"&source=b",str_replace_all(form("a",0,0),"insert=","source="),
    str_replace_all(form("a",0,0),"source=a","source=%GG"),
    str_replace_all(form("a",0,0),"source=a","source=%FF"),
    form("a",0,0,"run"),form("a",-1,0),form("a",1,0),form("a",0.5,1),
    form(strfromcharcode(0),0,0),form("x\ry",0,0),form(str_repeat("a",4097),0,0),
    form(str_repeat("a",4096),0,0,"tab")] {
    assert(rejects(fn(){W.parse_form(body);}),"malformed or oversized form rejected");
}
let marker="</textarea><script>private-canary</script>";
let safe=W.render(T.selection("\n"+marker,0,0));
assert(not str_contains(safe,marker) and str_contains(safe,"&lt;/textarea&gt;"),"textarea escaped");
assert(str_contains(safe,"spellcheck=\"false\">\n\n"),"leading newline survives HTML textarea parsing");
let good=request(form(text,2,4,"pair"));
let reply=W.handle(good,port);
assert(reply.status==200 and str_contains(reply.body,"(α😀)"),"handler applies core operation");
assert(reply.headers["Cache-Control"]=="no-store" and str_contains(reply.headers["Content-Security-Policy"],"script-src 'none'"),"private no-script response policy");
assert(reply.headers["Referrer-Policy"]=="same-origin","same-origin browser POST must retain Origin");
for origin in ["null","https://untrusted.invalid",""] {
    let bad=request(form(marker,0,0)); bad.headers.origin=origin;
    assert(W.handle(bad,port).status==403,"null, foreign and empty Origin still rejected");
}
for key in ["host","origin","content-type","content-length"] {
    let bad=request(form(marker,0,0)); bad.headers[key]="invalid";
    let denied=W.handle(bad,port);
    assert(denied.status==403 and not str_contains(denied.body,"private-canary"),"invalid headers rejected without source");
}
for path in ["/?source=private-canary","/run","/edit?source=x"] {
    let bad=request(form(marker,0,0)); bad.path=path;
    assert(W.handle(bad,port).status==403,"unknown path and query rejected");
}
let missing=request(form("a",0,0)); missing.headers=map{};
assert(not W.preflight(missing,port).allowed,"missing host and origin rejected");
let get=map{method:"GET",path:"/",headers:map{host:W.endpoint(port)},body:""};
assert(W.handle(get,port).status==200,"initial form available");
let bad=request(form(marker,99,100)); let denied=W.handle(bad,port);
assert(denied.status==400 and not str_contains(denied.body,"private-canary"),"invalid positions do not echo source");
print "pbide_text_web_pass";
