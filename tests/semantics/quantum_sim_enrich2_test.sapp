// tests/semantics/quantum_sim_enrich2_test.sapp — bug fixes + enrichment for quantum_sim.sapp
// FIX1: add_depolarizing_noise must not crash on multi-qubit (cnot) gates with no "q".
// FIX2: measure renormalization must be NaN-safe.
// ENRICH: cz_gate, most_likely, sample, shannon_entropy, state_norm, normalize.

let S = import("stdlib/quantum_sim.sapp");

fn fail(m) { throw "FAIL " + m; }
fn approx(a, b, m) { if (a - b) > 0.001 or (b - a) > 0.001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── FIX1: noise on a circuit containing a cnot must not throw ──────────────────────
let circ = [map{ gate: "h", q: 0 }, map{ gate: "cx", c: 0, t: 1 }];
let noisy = S.add_depolarizing_noise(circ, 1.0);   // p=1 -> always tries to add noise
// h has q (noise added); cx has no q (skipped) -> 2 originals + 1 noise = 3
eq(len(noisy), 3, "noise handles cnot without crashing");

// ── state_norm / normalize ─────────────────────────────────────────────────────────
approx(S.state_norm(S.zero_state(2)), 1.0, "zero_state is normalized");
let un = S.normalize([[2.0, 0.0], [0.0, 0.0]]);
approx(S.state_norm(un), 1.0, "normalize -> unit norm");
approx(un[0][0], 1.0, "normalize scales amplitude");

// ── cz_gate: phase flip on |11> ─────────────────────────────────────────────────────
let st = S.zero_state(2);
st = S.x_gate(st, 0);
st = S.x_gate(st, 1);          // |11>, amplitude at index 3
st = S.cz_gate(st, 0, 1);
approx(st[3][0], -1.0, "cz flips sign of |11>");
let probs = S.probabilities(st);
approx(probs[3], 1.0, "cz preserves probability");

// ── most_likely ─────────────────────────────────────────────────────────────────────
eq(S.most_likely(st), 3, "most_likely = |11> index");

// ── sample (no collapse): basis state samples deterministically ──────────────────────
eq(S.sample(S.zero_state(3)), 0, "sample |000> -> 0");

// ── shannon_entropy: 0 for basis, 1 bit for equal superposition ──────────────────────
approx(S.shannon_entropy(S.zero_state(1)), 0.0, "entropy basis = 0");
approx(S.shannon_entropy(S.h_gate(S.zero_state(1), 0)), 1.0, "entropy H|0> = 1 bit");

// ── FIX2: measuring a basis state stays valid (no NaN) ───────────────────────────────
let z = S.zero_state(1);
let out = S.measure(z, 0);   // |0> -> always 0
eq(out, 0, "measure |0> -> 0");
approx(S.state_norm(z), 1.0, "post-measure state still normalized");

print "quantum_sim_enrich2_pass";
