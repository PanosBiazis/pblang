let C=import("stdlib:cache.sapp");
fn require(ok,message){if not ok {throw "FAIL "+message;}}
for value in [nil,false,0,""] {
 let c=C.new(0);C.set(c,"key",value);
 require(C.get(c,"key")==value and C.peek(c,"key")==value and C.has(c,"key"),"false-like value is present");
 let entry=C.get_entry(c,"key");
 require(entry.found and entry.value==value,"entry keeps presence separate from value");
 let stats=C.stats(c);require(stats.hits==2 and stats.misses==0,"one hit per counting lookup");
 require(C.get(c,"missing")==nil and C.peek(c,"missing")==nil and not C.has(c,"missing"),"missing wrappers");
 let missing=C.get_entry(c,"missing");require(not missing.found and missing.value==nil,"missing entry shape");
 stats=C.stats(c);require(stats.hits==2 and stats.misses==2,"probes do not count misses");
 entry.found=false;entry.value="changed";missing.found=true;
 let fresh=C.get_entry(c,"key");require(fresh.found and fresh.value==value,"entry result maps are independent");
}
for read in [C.get,C.get_entry,C.has,C.peek] {
 let c=C.bounded_policy(0,2,10,"lru");C.set_sized(c,"old",1,3);C.set_sized(c,"new",2,2);
 // Synthetic elapsed deadline avoids sleeps and wall-clock timing races.
 c.__expiry["old"]=0;
 read(c,"old");
 require(C.size(c)==1 and C.stats(c).units==2 and C.stats(c).expired==1,"expired entry removed and units released");
 require(not map_has(c.__expiry,"old") and not map_has(c.__generation,"old"),"expired metadata removed");
 read(c,"old");require(C.stats(c).expired==1,"expiry counted once");
}
let c=C.new(0);C.set(c,"x",1);c.__expiry["x"]=0;C.get(c,"x");
require(C.stats(c).misses==1 and C.stats(c).hits==0,"expired get counts one miss");
C.set(c,"x",1);c.__expiry["x"]=0;C.get_entry(c,"x");
require(C.stats(c).misses==2,"expired entry counts one miss");
C.set(c,"x",1);c.__expiry["x"]=0;C.has(c,"x");
C.set(c,"x",1);c.__expiry["x"]=0;C.peek(c,"x");
require(C.stats(c).misses==2 and C.stats(c).expired==4,"expiry probes do not alter miss metrics");
for read in [C.get,C.get_entry] {
 let lru=C.bounded_policy(0,2,0,"lru");C.set(lru,"a",nil);C.set(lru,"b",2);read(lru,"a");C.set(lru,"c",3);
 require(C.has(lru,"a") and not C.has(lru,"b"),"counting reads refresh LRU for nil");
}
for read in [C.has,C.peek] {
 let lru=C.bounded_policy(0,2,0,"lru");C.set(lru,"a",nil);C.set(lru,"b",2);read(lru,"a");C.set(lru,"c",3);
 require(not C.has(lru,"a") and C.has(lru,"b"),"probes do not refresh LRU");
}
let permanent=C.new(0);C.set_ttl(permanent,"x",1,60000);C.touch(permanent,"x",0);
require(not map_has(permanent.__expiry,"x") and C.get(permanent,"x")==1,"touch can remove deadline");
let calls=0;C.set(permanent,"nil",nil);
require(C.get_or_set(permanent,"nil",fn(){calls=calls+1;return 9;})==nil and calls==0,"cached nil never recomputed");
let failed=try C.get_or_set(permanent,"failed",fn(){calls=calls+1;throw "synthetic failure";}) catch "rejected";
require(failed=="rejected" and not C.has(permanent,"failed"),"producer error not cached");
print "cache_lookup_pass";
