// tests/semantics/colors_enrich2_test.sapp — wave 2 enrichment for stdlib/colors.sapp
// gradient (color series), wcag_pass (AA/AAA decision), tetradic, split_complementary, is_dark.

let C = import("stdlib/colors.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let black = map{ r: 0, g: 0, b: 0 };
let white = map{ r: 255, g: 255, b: 255 };
let red = map{ r: 255, g: 0, b: 0 };

// ── gradient: N evenly-spaced colors including both endpoints ─────────────────────
let g = C.gradient(black, white, 3);
eq(len(g), 3, "gradient len");
eq(g[0].r, 0, "gradient start = c1");
eq(g[2].r, 255, "gradient end = c2");
eq(g[1].r, 127, "gradient midpoint");

// ── wcag_pass: black/white is max contrast (21) → passes everything ──────────────
if not C.wcag_pass(black, white, "AA", false) { fail("black/white passes AA"); }
if not C.wcag_pass(black, white, "AAA", false) { fail("black/white passes AAA"); }
// identical colors → contrast 1 → fails
if C.wcag_pass(white, white, "AA", false) { fail("white/white must fail AA"); }

// ── tetradic: 4 colors (0,90,180,270) ────────────────────────────────────────────
eq(len(C.tetradic(red)), 4, "tetradic count");

// ── split_complementary: base + 2 ────────────────────────────────────────────────
eq(len(C.split_complementary(red)), 3, "split_complementary count");

// ── is_dark ───────────────────────────────────────────────────────────────────────
if not C.is_dark(black) { fail("black is dark"); }
if C.is_dark(white) { fail("white is not dark"); }

print "colors_enrich2_pass";
