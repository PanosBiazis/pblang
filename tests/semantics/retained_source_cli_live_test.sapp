if platform()!="linux" {print "retained_source_cli_skip_linux_required";os_exit(0);}
let UUID=import("stdlib:uuid.sapp");let exe=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let source=path_join(cwd(),".retained_check_"+UUID.v4()+".sapp");
fn check(profile,driver=false) {
    let args=["-k","1s","15s","/usr/bin/env","PBLANG_CHECK_PROFILE="+profile,exe];
    if driver {for arg in ["run","stdlib/check_cli.sapp","--allow-all","--","--retained-source",source] {push(args,arg);}}
    else {push(args,"check");push(args,source);}
    return proc_spawn_wait("/usr/bin/timeout",args);
}
fn exercise() {
    fs_write(source,"for _i 1 {let p=map{run:fn(self){return 7;}};print (try {p:run()} catch 9);}");
    let original=fs_read(source);let rejected=check("retained-source");
    assert(rejected.exit_code!=0 and str_contains(rejected.stdout,"retained-nested-try"),"actual check command refuses source profile");
    assert(check("default").exit_code==0,"default compiler-independent check unchanged");
    assert(check("",true).exit_code!=0,"explicit driver flag refuses source");
    assert(fs_read(source)==original,"checker leaves source unchanged");
    fs_write(source,"print \"MUST_NOT_EXECUTE\";");let accepted=check("retained-source");
    assert(accepted.exit_code==0 and not str_contains(accepted.stdout,"MUST_NOT_EXECUTE"),"check never runs accepted program");
    assert(check("unknown_private_canary").exit_code!=0,"unknown profile fails closed");
    fs_write(source,"print missing_name;");assert(check("retained-source").exit_code!=0,"ordinary type/name diagnostics remain enabled");
    fs_write(source,"let dependency=import(\"private_canary\");");rejected=check("retained-source");
    assert(rejected.exit_code!=0 and not str_contains(rejected.stdout+rejected.stderr,"private_canary"),"imports refused without resolving paths");
}
let passed=try {exercise();true} catch false;
try fs_remove(source) catch nil;
assert(passed,"retained source CLI regression");print "retained_source_cli_pass";
