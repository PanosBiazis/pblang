let FE = import("stdlib:compiler/selfhost_frontend.sapp");
let VM = import("stdlib:compiler/vm.sapp");
let PBCK = import("stdlib:selfhost_pbck.sapp");
fn expect(ok, label) { if not ok { throw "FAIL vm-small-calls: " + label; } }
fn check(source, wanted) {
    let c = FE.frontend_compile(source);
    expect(c.ok and len(c.diagnostics) == 0, "checked compilation");
    let plain = VM.run(c.chunk);
    let bounded = VM.run_bounded(c.chunk, map{ max_steps: 10000, max_frames: 24 });
    let restored = VM.run_bounded(PBCK.deserialize_chunk(PBCK.serialize_chunk(c.chunk)), map{ max_steps: 10000, max_frames: 24 });
    let optimized = FE.frontend_run_bounded(source, map{ max_steps: 10000, max_frames: 24 });
    expect(plain.globals.result == wanted and bounded.globals.result == wanted, "plain and bounded values");
    expect(restored.globals.result == wanted and optimized.ok and optimized.globals.result == wanted, "serialized and optimized values");
    expect(restored.runtime.steps == bounded.runtime.steps, "serialized instruction accounting");
    let exact = VM.run_bounded(c.chunk, map{ max_steps: bounded.runtime.steps, max_frames: 24 });
    expect(exact.globals.result == wanted, "exact step budget accepts");
    let short = try map{ ok: true, value: VM.run_bounded(c.chunk, map{ max_steps: bounded.runtime.steps - 1, max_frames: 24 }) } catch map{ ok: false };
    expect(not short.ok, "one fewer step rejects");
}
check("fn f0() { return 7; } fn f1(a) { return a; } fn f2(a,b) { return [a,b]; } fn f3(a,b,c) { return [a,b,c]; } fn f4(a,b,c,d) { return [a,b,c,d]; } let result = [f0(), f1(nil), f2(1,2), f3(1,2,3), f4(1,2,3,4)];", [7, nil, [1,2], [1,2,3], [1,2,3,4]]);
check("fn make(x) { return fn(a,b,c) { x = x + 1; return [x,a,b,c]; }; } let f = make(5); let result = [f(1,2,3), f(4,5,6)];", [[6,1,2,3],[7,4,5,6]]);
check("let log = []; fn choose() { push(log,0); return fn(a,b,c) { push(log,4); return [a,b,c]; }; } fn mark(x) { push(log,x); return x; } let args = choose()(mark(1),mark(2),mark(3)); let result = [args,log];", [[1,2,3],[0,1,2,3,4]]);
check("fn f(a=4,b=5,c=6) { return [a,b,c]; } let result = [f(), f(1), f(1,2), f(1,2,3)];", [[4,5,6],[1,5,6],[1,2,6],[1,2,3]]);
check("fn bad(a,b,c) { throw 8; } fn none() { return nil; } let failed = try bad(1,2,3) catch 9; let result = [failed,none()];", [9,nil]);
check("fn len(x) { return 99; } let alias = len; let result = [alias([1,2]), len([])];", [99,99]);

// Checked compilation may report invalid arity; the VM must reject it too.
for source in ["fn f(a) { return a; } let result = f();", "fn f() { return 7; } let result = f(1);", "fn f(a) { return a; } let result = f(1,2,3);"] {
    let c = FE.frontend_compile(source);
    let invalid = try map{ ok: true, value: VM.run_bounded(c.chunk) } catch map{ ok: false };
    expect(not invalid.ok, "arity mismatch rejects");
}
for source in ["fn f() { return f(); } let result = try f() catch 7;", "fn f(x) { return f(x); } let result = try f(1) catch 7;", "fn f(a,b,c) { return f(a,b,c); } let result = try f(1,2,3) catch 7;"] {
    let c = FE.frontend_compile(source);
    expect(c.ok, "recursive source compiles");
    let limited = try map{ ok: true, value: VM.run_bounded(c.chunk, map{ max_steps: 1000, max_frames: 4 }) } catch map{ ok: false };
    expect(not limited.ok, "frame budget remains sticky through catch");
}
print "selfhost_vm_small_calls_pass";
