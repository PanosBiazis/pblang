let I = import("stdlib/compiler/interp.sapp");
fn require(ok, label) { if not ok { throw "interp defaults: " + label; } }
fn run(source, label) {
    let ast = I.compile_program(source);
    require(I.eval_ast(ast) and I.eval_ast(ast), label);
}
run("fn f(a = 7) { return a; } if f() != 7 { missing(); }", "omitted scalar");
run("fn f(a = 7) { return a; } if f(nil) != nil { missing(); }", "explicit nil");
run("fn f(a = false, b = 0, c = \"\", d = nil) { return [a,b,c,d]; } "
    + "let r = f(); if r[0] != false or r[1] != 0 or r[2] != \"\" or r[3] != nil { missing(); }", "falsey defaults");
run("fn f(a = -1) { return a; } if f() != -1 { missing(); }", "negative literal");
run("fn f(a = 0x10, b = 1.25, c = 1e2) { return a + b + c; } "
    + "if f() != 117.25 { missing(); }", "numeric literals");
run("fn f(a = \"γειά\\n😀\") { return a; } if f() != \"γειά\\n😀\" { missing(); }", "UTF-8 escaped string");
// Preserve the interpreter's existing tolerant required/extra-argument behavior.
run("fn f(a, b = 2) { if a != nil { missing(); } return b; } if f() != 2 { missing(); }", "missing required parameter");
run("let seen = 0; fn effect() { seen = seen + 1; return 9; } "
    + "fn f(a = 4) { return a; } if f(1, effect()) != 1 or seen != 1 { missing(); }", "evaluated extra argument");
for source in ["fn f(a = unknown_default) { return a; }", "fn f(a = [1]) { return a; }",
    "fn f(a = 0x) { return a; }",
    "let f = fn(a = 1) { return a; };"] {
    let rejected = try { I.compile_program(source); false } catch true;
    require(rejected, "unsupported default source still rejected");
}
// Raw parser ASTs are trusted inputs, but unsupported default nodes must never
// become an expression-evaluation path during closure creation.
for bad in [7, map{}, map{kind: "call", value: "private_default_canary"},
    map{kind: "string", value: []}, map{kind: "bool", value: "true"},
    map{kind: "number", value: []}] {
    let ast = I.compile_program("fn f(a = 1) { return a; }");
    ast.stmts[0].params[0].default = bad;
    let rejected = try { I.eval_ast(ast); false } catch true;
    require(rejected, "unsupported default AST rejected");
}
print "interp_defaults_pass";
