// tests/semantics/deobfuscate_test.sapp — stdlib/deobfuscate.sapp
//
// The DEFENSIVE inverse of the G0DM0D3 "Parseltongue" input-perturbation engine
// (~/G0DM0D3/src/lib/parseltongue.ts): instead of obfuscating trigger words to evade
// a filter, this DETECTS and CANONICALIZES adversarial obfuscation — leetspeak,
// Unicode homoglyphs, zero-width characters, and mixed-case disruption — so a guard
// or classifier sees the real text and cannot be bypassed. Pure + deterministic.

let D = import("stdlib/deobfuscate.sapp");
let U = import("stdlib/unicode.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }
fn falsy(c, m) { if c != false { fail(m); } }

let ZW = U.from_codepoint(8203);      // U+200B zero-width space
let CYR_A = U.from_codepoint(1072);   // Cyrillic 'а'
let CYR_E = U.from_codepoint(1077);   // Cyrillic 'е'
let CYR_O = U.from_codepoint(1086);   // Cyrillic 'о'

// ── zero-width stripping ───────────────────────────────────────────────────────────
eq(D.strip_zero_width("a" + ZW + "b" + ZW + "c"), "abc", "zero-width removed");
eq(D.count_zero_width("a" + ZW + "b" + ZW + "c"), 2, "two zero-width chars counted");

// ── leetspeak reversal (adjacency-aware: digits inside words, not bare numbers) ────
eq(D.unleet("h4ck3r"), "hacker", "leet h4ck3r -> hacker");
eq(D.unleet("l33t"), "leet", "leet l33t -> leet");
eq(D.count_leet("h4ck3r"), 2, "two leet substitutions");
eq(D.count_leet("area 2024"), 0, "bare numbers are not leet");

// ── homoglyph folding (Cyrillic look-alikes -> ASCII) ──────────────────────────────
eq(D.fold_homoglyphs("p" + CYR_A + "ssw" + CYR_O + "rd"), "password", "cyrillic a/o folded");
eq(D.count_homoglyphs("p" + CYR_A + "ss"), 1, "one homoglyph counted");

// ── canonicalize: strip zw + fold homoglyphs + unleet + lowercase ──────────────────
eq(D.canonicalize("H4CK" + ZW + CYR_E + "r"), "hacker", "full de-obfuscation pipeline");
eq(D.canonicalize("hello world"), "hello world", "clean text unchanged (just lowered)");

// ── detection + scoring ────────────────────────────────────────────────────────────
let clean = D.detect("please help me with my code");
falsy(D.is_obfuscated("please help me with my code"), "clean text is not obfuscated");
eq(len(clean.techniques), 0, "no techniques on clean text");

let atk = D.detect("h4ck" + ZW + " the " + CYR_O + "s");
truthy(D.is_obfuscated("h4ck" + ZW + " the " + CYR_O + "s"), "attack string is obfuscated");
truthy(atk.score > 0.5, "attack scores high");
truthy(len(atk.techniques) >= 2, "multiple techniques detected");

// ── the payoff: obfuscated trigger words are caught after canonicalization ─────────
// naive substring search misses "b0mb"; canonical search catches it.
falsy(str_contains("b0mb", "bomb"), "naive search misses leetspeak trigger");
truthy(D.contains_trigger("how to b0mb", ["bomb", "weapon"]), "canonical search catches obfuscated trigger");
falsy(D.contains_trigger("how to build a shed", ["bomb", "weapon"]), "no false positive on benign text");

print "deobfuscate_pass";
