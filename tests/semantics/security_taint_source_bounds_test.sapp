let T=import("stdlib:security_taint.sapp");
let D=import("stdlib:security_dependency_analysis.sapp");
fn expect(ok,label) {if not ok {throw "FAIL taint-source-bounds: "+label;}}
fn rejected(source,cap) {
    let result=T.analyze(source,"private-path-marker",map{max_taint_source_bytes:cap});
    expect(not result.ok and not result.passed and not result.parser_complete,
        "source rejected before parsing");
    expect(result.error=="taint source byte limit exceeded" and result.limit_exceeded,
        "size diagnostic takes precedence over lexical errors");
    let rendered=json_stringify(result);
    expect(not str_contains(rendered,"private-path-marker")
        and not str_contains(rendered,"private-source-marker"),"size error privacy");
}
for source in ["let x=1;","let x=\"π\";","let x=\"😀\";","let x=\"é\";"] {
    let bytes=len(str_to_bytes(source));
    expect(T.analyze(source,"fixture.sapp",map{max_taint_source_bytes:bytes}).passed,
        "exact UTF-8 byte boundary accepted");
    rejected(source,bytes-1);
}
expect(T.analyze("","fixture.sapp",map{max_taint_source_bytes:1}).passed,"empty input");
expect(T.analyze(" ","fixture.sapp",map{max_taint_source_bytes:1}).passed,"one byte");
expect(T.analyze("//😀","fixture.sapp",map{max_taint_source_bytes:12}).passed,
    "four-byte scalar fast path");
rejected("let x=\"private-source-marker",4);
for value in [nil,true,"private-source-marker",[],map{},0,-1,1.5,
    parse_number("NaN"),parse_number("inf"),parse_number("-inf"),134217729,
    bigint(10),decimal("10"),rational("10/1")] {
    let result=T.analyze("","fixture.sapp",map{max_taint_source_bytes:value});
    expect(not result.ok and not result.passed,"invalid source cap");
    expect(not str_contains(json_stringify(result),"private-source-marker"),"option privacy");
}
expect(T.limits().max_taint_source_bytes==1048576,"default cap");
expect(T.limits(map{max_taint_source_bytes:134217728}).ok,"hard upper boundary");
for mode in ["protect","strict","audit"] {
    let entry="tests/fixtures/taint_source_entry.sapp";
    let base=map{entry_source:"let D=import(\"./taint_source_child.sapp\"); let x=D.value();",security_mode:mode,max_module_bytes:64,
        max_total_bytes:128,retain_linked_source:true};
    let implicit=D.analyze_entry(entry,base);
    expect(implicit.passed and implicit.whole_program_taint.ok
        and implicit.module_count==2 and len(str_to_bytes(implicit.linked_source))>64,"linked budget is aggregate");
    base.security=map{max_taint_source_bytes:64};
    let explicit=D.analyze_entry(entry,base);
    expect(not explicit.passed and explicit.modules[0].taint.ok
        and not explicit.whole_program_taint.ok,"explicit cap not widened for linker");
    base.security=map{max_taint_source_bytes:1};
    let small=D.analyze_entry(entry,base);
    expect(not small.passed and not small.modules[0].taint.ok,"module cap enforced");
    base.security=map{max_taint_source_bytes:nil};
    expect(D.analyze_entry(entry,base).passed,"legacy nested nil remains unset");
    base.max_taint_source_bytes=1;
    expect(not D.analyze_entry(entry,base).passed,"top-level cap retained with nested nil");
    base.security=map{max_taint_source_bytes:1.5};
    let invalid=D.analyze_entry(entry,base);
    expect(not invalid.ok and not invalid.passed,"nested invalid cap rejects before traversal");
}
print "security_taint_source_bounds_pass";
