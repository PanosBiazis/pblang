let PCM = import("stdlib:audio_pcm.sapp");

fn fail(message) { throw "FAIL audio_pcm: " + message; }
fn expect(condition, message) { if not condition { fail(message); } }
fn rejects(callable, message) {
    let rejected = try { callable(); false } catch true;
    expect(rejected, message);
}

let mono = map{ format: PCM.FORMAT, sample_rate: 8000, channels: 1,
    samples: [0, 1000, -1000, 32767, -32768, 0, 0, 0] };
let bytes = PCM.encode_wav(mono);
let decoded = PCM.decode_wav(bytes);
expect(decoded.sample_rate == 8000 and decoded.channels == 1,
    "WAV format fields round trip");
expect(decoded.samples == mono.samples, "signed PCM16 samples round trip exactly");

let stereo = map{ format: PCM.FORMAT, sample_rate: 8000, channels: 2,
    samples: [1, 2, 3, 4, 5, 6] };
let reversed = PCM.reverse(stereo);
expect(reversed.samples == [5, 6, 3, 4, 1, 2],
    "reverse keeps stereo channel pairs together");

let clipped = PCM.volume(mono, 16);
expect(clipped.samples[3] == 32767 and clipped.samples[4] == -32768,
    "volume saturates instead of wrapping");

let segment = PCM.segment(mono, 0.00025, 0.0005);
expect(segment.samples == [-1000, 32767, -32768, 0],
    "segment uses frame-exact bounded indices");

let faster = PCM.speed(mono, 2);
expect(faster.samples == [0, -1000, -32768, 0],
    "speed resampling is deterministic");

let merged = PCM.merge([mono, mono]);
expect(len(merged.samples) == 16 and merged.samples[8] == 0,
    "merge preserves ordered compatible samples");

let mixed = PCM.mix(mono, mono, 1, 1);
expect(mixed.samples[1] == 2000 and mixed.samples[3] == 32767,
    "mix sums and saturates samples");

let normalized_silence = PCM.normalize(map{
    format: PCM.FORMAT, sample_rate: 8000, channels: 1, samples: [0, 0, 0]
}, -14);
expect(normalized_silence.samples == [0, 0, 0], "normalizing silence is stable");

let waveform = PCM.waveform(mono, 4);
expect(waveform.sample_count == 4 and len(waveform.samples) == 4,
    "waveform returns exactly the bounded point count");

let silence = PCM.silence_regions(mono, 0.00025, -60);
expect(silence.region_count == 1 and silence.regions[0].end_secs == 0.001,
    "trailing silence is closed at end of stream");

rejects(fn() { PCM.decode_wav([82, 73, 70, 70]); }, "truncated WAV fails closed");
rejects(fn() { PCM.speed(mono, 0); }, "zero speed fails closed");
rejects(fn() { PCM.merge([mono]); }, "single-input merge fails closed");
rejects(fn() { PCM.mix(mono, stereo); }, "incompatible mix fails closed");

print "audio_pcm_test: 14 checks passed";
