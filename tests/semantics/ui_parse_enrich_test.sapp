// tests/semantics/ui_parse_enrich_test.sapp — enrichment for stdlib/ui_parse.sapp
// Adds tree traversal: node_count (recursive) and find_nodes (by type).

let U = import("stdlib/ui_parse.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// flat tree: 4 top-level nodes
let flat = U.parse("fn render() { return html.tag(\"h1\", \"Hi\", map{}) + html.tag(\"p\", \"B\", map{}); }");
eq(len(flat), 2, "base parse still works");
eq(U.node_count(flat), 2, "node_count flat");

// nested: section containing button + p
let nested = U.parse("fn render() { return html.tag(\"section\", html.tag(\"button\", \"Go\", map{}) + html.tag(\"p\", \"in\", map{}), map{}); }");
eq(U.node_count(nested), 3, "node_count recurses children (section+button+p)");
eq(len(U.find_nodes(nested, "button")), 1, "find_nodes button");
eq(len(U.find_nodes(nested, "section")), 1, "find_nodes section");
eq(len(U.find_nodes(nested, "image")), 0, "find_nodes missing type -> 0");

print "ui_parse_enrich_pass";
