let SERIAL=import("stdlib:linux_serial.sapp");
fn expect(value,message){if not value{throw "FAIL linux serial: "+message;}}

if platform()!="linux" {expect(not SERIAL.available().ok,"non-Linux fails closed");print "linux_serial_unsupported_pass";return;}
expect(SERIAL.available().ok and SERIAL.available().termios_restore
    and SERIAL.available().max_io_bytes==65536,"bounded native support contract");
expect(not SERIAL.open_port("/tmp/not-a-device",9600).ok
    and not SERIAL.open_port("/dev/ttyUSB0",12345).ok,
    "namespace and baud policy reject invalid inputs");

if (try env_get("PB_PROJECT_TEST_ENABLE") catch "")!="1" {
    expect(not SERIAL.test_pty_pair().ok,"PTY fixture remains disabled without explicit test capability");
    print "linux_serial_guarded_pass";
    return;
}
let pair=SERIAL.test_pty_pair();expect(pair.ok,"PBLang PTY fixture allocation");
let serial=SERIAL.open_port(pair.path,115200);expect(serial.ok and serial.descriptor_bound
    and serial.nofollow and serial.nonblocking,"descriptor-held raw serial open: "+json_stringify(serial));
expect(SERIAL.test_write_master(pair,[99],500).ok,"queue stale serial byte");
expect(SERIAL.flush_input(serial).ok,"bounded serial input flush");
let flushed=SERIAL.read_bytes(serial,1,20);
expect(flushed.ok and flushed.bytes_read==0 and flushed.timed_out,"flushed byte is not observed");
let inbound=[0,65,10,128,255,66];
expect(SERIAL.test_write_master(pair,inbound,500).ok,"master binary write");
let read=SERIAL.read_bytes(serial,64,500);
expect(read.ok and read.bytes==inbound and read.bytes_read==len(inbound)
    and not read.truncated,"binary-safe slave read");
let outbound=[255,0,1,2,10,127];
expect(SERIAL.write_bytes(serial,outbound,500).ok,"binary-safe slave write");
let received=SERIAL.test_read_master(pair,64,500);
expect(received.ok and received.bytes==outbound,"master receives exact serial bytes");
let empty=SERIAL.read_bytes(serial,16,20);
expect(empty.ok and empty.bytes_read==0 and empty.timed_out,
    "empty read exits at explicit deadline");
let closed=SERIAL.close(serial);expect(closed.termios_restored and serial.closed,
    "close restores termios and releases descriptor");
SERIAL.close_test_pty(pair);
print "linux_serial_contract_pass";
