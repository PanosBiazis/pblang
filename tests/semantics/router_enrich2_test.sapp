// tests/semantics/router_enrich2_test.sapp — round 2 enrichment for stdlib/router.sapp
//
// FIX: dispatch matched on the RAW path, so a query string ("/users/5?x=1") broke
//      matching (the "?x=1" became part of the last segment) and req.query was
//      never populated.
// ENRICH: route groups (mount under a prefix), multi-method routes (method as a
//      list) + add_any, and automatic OPTIONS responses (204 + Allow).

let r = import("stdlib/router.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn h(name) { return fn(req) { return map{ status: 200, body: name, seen: req }; }; }

let routes = r.route_map();
r.add_route(routes, "GET", "/users/:id", h("user"));

// ── FIX: query string is stripped before matching, and parsed onto req.query ────
let m = r.dispatch(routes, "GET", "/users/5?x=1&y=two", map{});
eq(m.body, "user", "route matches despite a query string");
eq(m.seen.params.id, "5", "param captured with query present");
eq(m.seen.query.x, "1", "req.query parsed");
eq(m.seen.query.y, "two", "req.query second param");
eq(m.seen.path, "/users/5", "req.path has the query stripped");

// ── ENRICH: route groups (mount a sub-router under a prefix) ─────────────────────
let api = r.route_map();
r.add_route(api, "GET", "/health", h("health"));
r.add_route(api, "GET", "/users", h("list"));
r.mount(routes, "/api", api);
eq(r.dispatch(routes, "GET", "/api/health", map{}).body, "health", "mounted route matches under prefix");
eq(r.dispatch(routes, "GET", "/api/users", map{}).body, "list", "second mounted route");
eq(r.dispatch(routes, "GET", "/health", map{}).status, 404, "unmounted bare path is 404");

// ── ENRICH: multi-method route (method as a list) + add_any ─────────────────────
r.add_route(routes, ["GET", "POST"], "/multi", h("multi"));
eq(r.dispatch(routes, "GET", "/multi", map{}).body, "multi", "list-method matches GET");
eq(r.dispatch(routes, "POST", "/multi", map{}).body, "multi", "list-method matches POST");
eq(r.dispatch(routes, "DELETE", "/multi", map{}).status, 405, "list-method rejects others with 405");
r.add_any(routes, ["PUT", "PATCH"], "/any", h("any"));
eq(r.dispatch(routes, "PUT", "/any", map{}).body, "any", "add_any PUT");
eq(r.dispatch(routes, "PATCH", "/any", map{}).body, "any", "add_any PATCH");

// ── ENRICH: automatic OPTIONS (204 + Allow) ─────────────────────────────────────
let opt = r.dispatch(routes, "OPTIONS", "/users/5", map{});
eq(opt.status, 204, "OPTIONS on a matching path -> 204");
let has_get = false; let i = 0;
while i < len(opt.allow) { if opt.allow[i] == "GET" { has_get = true; } i = i + 1; }
if not has_get { fail("OPTIONS must advertise allowed methods: " + str(opt.allow)); }

// ── regression: existing behavior preserved ─────────────────────────────────────
eq(r.dispatch(routes, "POST", "/users/5", map{}).status, 405, "405 preserved");
eq(r.dispatch(routes, "HEAD", "/users/5", map{}).body, "user", "HEAD->GET preserved");
eq(r.dispatch(routes, "GET", "/nope", map{}).status, 404, "404 preserved");

print "router_enrich2_pass";
