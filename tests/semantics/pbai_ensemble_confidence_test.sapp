// tests/semantics/pbai_ensemble_confidence_test.sapp — a smart multi-LLM router doesn't just
// pick a winner, it KNOWS how sure it is. ensemble_confidence() = winner_score / total_score
// (1.0 = unanimous, lower = split). ensemble_decide() turns that into a routing decision:
// escalate to a heavier model when agreement is below a threshold.

let pbai = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let p = "explain what this function does";

// ── no extra voters: the native model is 100% of the weight -> fully confident ─────────
pbai.clear_voters();
approx(pbai.ensemble_confidence(p), 1.0, "native-only ensemble is unanimous");

// ── unanimous: every voter agrees with native -> confidence stays 1.0 ──────────────────
pbai.clear_voters();
pbai.register_voter("echo1", fn(x) { return pbai.classify_scores(x).intent; });
pbai.register_voter("echo2", fn(x) { return pbai.classify_scores(x).intent; });
approx(pbai.ensemble_confidence(p), 1.0, "unanimous voters keep confidence 1.0");

// ── split: voters disagree -> confidence drops below 1.0 (and stays a valid fraction) ──
pbai.clear_voters();
pbai.register_voter("dissent1", fn(x) { return map{ intent: "bugs", confidence: 0.9 }; });
pbai.register_voter("dissent2", fn(x) { return map{ intent: "improve", confidence: 0.9 }; });
let c = pbai.ensemble_confidence(p);
if c >= 1.0 { fail("split ensemble should be < 1.0 got=" + str(c)); }
if c <= 0.0 { fail("confidence must be a positive fraction got=" + str(c)); }

// ── ensemble_decide: escalate when agreement is below the threshold ────────────────────
pbai.clear_voters();
let d1 = pbai.ensemble_decide(p, 0.9);              // native-only, unanimous
eq(d1.escalate, false, "confident decision does not escalate");
if not map_has(d1, "intent") or not map_has(d1, "confidence") { fail("decide shape"); }

pbai.register_voter("dissent1", fn(x) { return map{ intent: "bugs", confidence: 0.9 }; });
pbai.register_voter("dissent2", fn(x) { return map{ intent: "docs", confidence: 0.9 }; });
let d2 = pbai.ensemble_decide(p, 0.99);            // three-way split, strict threshold
eq(d2.escalate, true, "split decision escalates to a heavier model");

pbai.clear_voters();
print "pbai_ensemble_confidence_pass";
