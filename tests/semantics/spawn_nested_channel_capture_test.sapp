// A module-owned channel must remain usable when a top-level handler is passed
// through a worker. Stateful network services depend on this safe dispatch
// pattern instead of sharing mutable maps across threads.

let REQUESTS = channel_buffered(2);

fn dispatch(value) {
    send(REQUESTS.sender, value);
    return true;
}

let worker = spawn(fn() { return dispatch(9); });
let value = recv_timeout(REQUESTS.receiver, 1000);
let completed = join(worker);
if value != 9 or not completed {
    throw "FAIL module-owned channel dispatch through worker";
}

print "spawn_nested_channel_capture_pass";
