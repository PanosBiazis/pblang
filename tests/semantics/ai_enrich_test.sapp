// tests/semantics/ai_enrich_test.sapp — enrichment for stdlib/ai.sapp
// Adds pure RAG/vector helpers (no network): chunk_text, normalize_vector, dot_product.

let ai = import("stdlib/ai.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.000001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn aeq(a, b, m) {
    if len(a) != len(b) { fail(m + " len " + str(len(a)) + " : " + str(a)); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " @" + str(i) + " : " + str(a)); } i = i + 1; }
}

// ── base cosine_similarity still works ───────────────────────────────────────────
near(ai.cosine_similarity([1, 0], [1, 0]), 1, "cosine identical");

// ── ENRICH: chunk_text (RAG chunking with overlap) ───────────────────────────────
let chunks = ai.chunk_text("abcdefghij", 4, 1);
aeq(chunks, ["abcd", "defg", "ghij"], "chunk_text size 4 overlap 1");
if len(ai.chunk_text("short", 100, 0)) != 1 { fail("text shorter than size -> one chunk"); }

// ── ENRICH: normalize_vector ─────────────────────────────────────────────────────
aeq(ai.normalize_vector([3, 4]), [0.6, 0.8], "normalize_vector unit length");

// ── ENRICH: dot_product ──────────────────────────────────────────────────────────
near(ai.dot_product([1, 2, 3], [4, 5, 6]), 32, "dot_product");

print "ai_enrich_pass";
