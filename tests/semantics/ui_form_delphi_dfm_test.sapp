let DFM = import("stdlib:ui_form_delphi_dfm.sapp");
let UI = import("stdlib:ui_document.sapp");

fn rejected(source, code) {
    let result = DFM.import_text(source);
    return not result.ok and result.error == code;
}

let source = "object MainForm: TMainAIForm\n"
    + "  Caption = #928#949#953#961#945#956#945#964#953#954#972\n"
    + "  ClientWidth = 640\n  ClientHeight = 480\n"
    + "  OnCreate = FormCreate\n"
    + "  object MainPanel: TPanel\n    Left = 8\n    Top = 8\n"
    + "    Width = 624\n    Height = 464\n    Caption = 'Tools'\n"
    + "    object PasswordEdit: TEdit\n      Left = 20\n      Top = 24\n"
    + "      Width = 240\n      Height = 28\n      Text = ''\n"
    + "      PasswordChar = 42\n      ReadOnly = False\n      OnChange = PasswordChanged\n"
    + "    end\n"
    + "    object SaveButton: TButton\n      Left = 280\n      Top = 24\n"
    + "      Width = 100\n      Height = 30\n      Caption = 'Save ''now'''\n"
    + "      Enabled = True\n      OnClick = SaveClicked\n    end\n"
    + "    object Choice: TComboBox\n      Left = 20\n      Top = 70\n"
    + "      Width = 200\n      Height = 28\n      Items.Strings = (\n"
    + "        'alpha'\n        #946#942#964#945\n      )\n      ItemIndex = 0\n    end\n"
    + "  end\nend\n";

let sniffed = DFM.sniff_text(source);
assert(sniffed.ok and sniffed.text_dfm, "text DFM signature is content-verified");
let imported = DFM.import_text(source, "MainAI.dfm");
assert(imported.ok and imported.atomic and imported.lossy,
    "strict import is atomic and reports unsupported root lifecycle events as lossy");
assert(imported.document.format == "pblang.ui-document.v1" and UI.validate(imported.document).ok,
    "DFM reaches the canonical renderer-neutral document");
assert(imported.document.form.title == "Πειραματικό" and imported.widget_count == 4,
    "Delphi numeric codepoints and nested objects are preserved deterministically");
assert(imported.document.widgets[0].parent == "root"
    and imported.document.widgets[1].parent == "MainPanel",
    "nested Delphi ownership maps to canonical parent IDs");
assert(imported.document.widgets[1].props.input_type == "password"
    and imported.document.widgets[1].props.sensitive_input
    and imported.document.widgets[1].events.change == "PasswordChanged",
    "password semantics and inert known event identifiers survive import");
assert(imported.document.widgets[2].events.click == "SaveClicked"
    and imported.document.widgets[2].props.text == "Save 'now'",
    "quoted apostrophes and click handlers remain data only");
assert(imported.document.widgets[3].props.options[1] == "βήτα",
    "bounded multiline lists preserve Delphi string atoms");
assert(json_stringify(DFM.import_text(source, "MainAI.dfm")) == json_stringify(imported),
    "the same source parses deterministically");

assert(rejected("TPF0binary", "binary-dfm-unsupported"), "binary DFM fails closed");
assert(rejected("object A: TForm1\n Caption = 'x'\nend\nobject B: TForm2\nend", "trailing-data"),
    "a second root cannot trail the atomic document");
assert(rejected("object A: TForm1\n Caption = 'x'\n caption = 'y'\nend", "duplicate-property"),
    "case-insensitive duplicate properties fail closed");
assert(rejected("object A: TForm1\n object X: TButton\n end\n object x: TLabel\n end\nend", "duplicate-object-id"),
    "case-insensitive duplicate component IDs fail closed");
assert(rejected("object A: TForm1\n object root: TButton\n end\nend", "reserved-object-id"),
    "canonical root ID cannot be shadowed");
assert(rejected("object A: TForm1\n object Hidden: TTimer\n end\nend", "unsupported-component-class"),
    "nonvisual effect-bearing components are never silently dropped");
assert(rejected("object A: TForm1\n object X: TButton\n OnClick = Run();\n end\nend", "unsupported-expression"),
    "event expressions and semicolon injection never become handlers");
assert(rejected("object A: TForm1\n object X: TEdit\n Visible = 'False'\n end\nend", "invalid-boolean-property"),
    "behavior properties reject ambiguous types");
assert(rejected("object A: TForm1\n Caption = #0\nend", "invalid-codepoint"),
    "NUL codepoints cannot be smuggled through Delphi string atoms");
assert(rejected("object A: TForm1\n Picture.Data = {00FF}\nend", "binary-blob-unsupported"),
    "embedded blobs are not decoded");

let too_deep = "object A: TForm1\n"; let limit_i = 0;
while limit_i < 32 {
    too_deep = too_deep + "object P" + str(limit_i) + ": TPanel\n"; limit_i = limit_i + 1;
}
assert(rejected(too_deep, "object-depth-exceeded"), "maximum nesting plus one fails before append");

let too_many_objects = "object A: TForm1\n"; limit_i = 0;
while limit_i < 513 {
    too_many_objects = too_many_objects + "object B" + str(limit_i) + ": TButton\nend\n";
    limit_i = limit_i + 1;
}
too_many_objects = too_many_objects + "end\n";
assert(rejected(too_many_objects, "too-many-objects"), "canonical widget maximum plus one fails closed");

let long_line = "object A: TForm1\nCaption = '"; limit_i = 0;
while limit_i < 16385 { long_line = long_line + "x"; limit_i = limit_i + 1; }
long_line = long_line + "'\nend\n";
assert(rejected(long_line, "line-too-large"), "line maximum plus one is rejected before value parsing");

let references = "object A: TForm1\n Caption = 'Safe'\n"
    + " FileName = '/tmp/PB_DFM_CANARY_SECRET'\n"
    + " URL = 'https://PB_DFM_CANARY.invalid/private'\n"
    + " ConnectionPath = '\\\\server\\PB_DFM_CANARY_UNC'\nend";
let reference_result = DFM.import_text(references, "safe.dfm");
assert(reference_result.ok and reference_result.external_reference_present,
    "external references are flagged without being activated");
assert(not str_contains(json_stringify(reference_result), "PB_DFM_CANARY"),
    "paths and URLs are omitted from canonical output and diagnostics");
assert(not DFM.status().filesystem and not DFM.status().network and not DFM.status().process
    and not DFM.status().ffi and not DFM.status().production_ready,
    "the importer advertises its pure preview boundary truthfully");
print "ui_form_delphi_dfm_pass";
