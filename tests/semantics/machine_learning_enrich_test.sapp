// tests/semantics/machine_learning_enrich_test.sapp — enrichment for stdlib/machine_learning.sapp
// Adds precision/recall/f1 (binary), r2_score/mae/rmse (regression), cosine_distance.

let ml = import("stdlib/machine_learning.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base still works ─────────────────────────────────────────────────────────────
near(ml.accuracy_score([1, 0, 1], [1, 0, 0]), 2 / 3, "accuracy_score");

// ── ENRICH: precision / recall / f1 (positive label = 1) ─────────────────────────
let yt = [1, 1, 0, 0];
let yp = [1, 0, 0, 0];
near(ml.precision_score(yt, yp, 1), 1, "precision = tp/(tp+fp)");
near(ml.recall_score(yt, yp, 1), 0.5, "recall = tp/(tp+fn)");
near(ml.f1_score(yt, yp, 1), 2 * 1 * 0.5 / 1.5, "f1");

// ── ENRICH: regression metrics ───────────────────────────────────────────────────
near(ml.r2_score([1, 2, 3], [1, 2, 3]), 1, "r2 perfect = 1");
near(ml.mae([1, 2], [1, 4]), 1, "mae");
near(ml.rmse([1, 2], [1, 4]), num_sqrt(2), "rmse");

// ── ENRICH: cosine_distance ──────────────────────────────────────────────────────
near(ml.cosine_distance([1, 0], [0, 1]), 1, "orthogonal -> 1");
near(ml.cosine_distance([1, 0], [1, 0]), 0, "identical -> 0");

print "machine_learning_enrich_pass";
