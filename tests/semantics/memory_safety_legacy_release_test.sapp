// C3: legacy handles remain compatible; mutable/unique borrows can be released.
let M = import("stdlib/memory_safety.sapp");
fn demand(ok, message) { if not ok { throw "FAIL legacy-release: " + message; } }
let baseline = M.stats().active_borrows;
fn balance() { demand(M.stats().active_borrows == baseline, "borrow leak"); }
let h = M.own(1);
demand(M.borrow(h) == h and M.borrow(h) == h, "legacy shared return value");
M.release(h);
demand(M.stats().active_borrows == baseline + 1, "release exactly one shared borrow");
M.release(h);
balance();
demand(M.borrow_mut(h) == h, "legacy mutable return value");
M.release(h);
balance();
M.write(h, 2);
demand(M.read(h) == 2, "write after mutable release");
let denied = try { M.release(h); false; } catch true;
demand(denied, "unborrowed handle must reject");
M.drop(h);
demand(try { M.release(h); false; } catch true, "dropped handle must reject");
let moved = M.own(3);
demand(M.move_val(moved) == moved, "legacy move return value");
M.release(moved);
balance();
demand(try { M.read(moved); false; } catch true, "release must not revive moved value");
M.drop(moved);

let exact = M.own(4);
let id = M.borrow_mut_id(exact);
M.release_id(id);
balance();
let shared = M.try_borrow_id(exact);
demand(map_has(shared, "some"), "exact shared borrow");
// The runtime deliberately makes ID release idempotent after lifetime cleanup.
// A repeated release must not consume a newer borrow of the same location.
M.release_id(id);
demand(M.stats().active_borrows == baseline + 1, "duplicate ID consumed another borrow");
demand(M.try_borrow_mut_id(exact).none == true, "conflicting exact mutable borrow");
M.release_id(shared.some);
let mut = M.try_borrow_mut_id(exact);
demand(map_has(mut, "some"), "exact mutable borrow");
M.release_id(mut.some);
balance();
M.drop(exact);
let exact_move = M.own(5);
let move_id = M.move_id(exact_move);
M.release_id(move_id);
balance();
demand(try { M.read(exact_move); false; } catch true, "exact release must not revive move");
M.drop(exact_move);
print "memory_safety_legacy_release_pass";
