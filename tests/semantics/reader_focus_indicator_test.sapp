let Focus=import("../../examples/declarative_browser/focus_indicator.sapp");let App=import("../../examples/declarative_browser/app.sapp");
let GUI=import("stdlib:gui.sapp");let Colors=import("stdlib:colors.sapp");let Style=import("stdlib:ui_style.sapp");
let count=0;fn check(ok,label){assert(ok,label);count=count+1;}
let form=GUI.form("Focus",320,240);let button=GUI.button("choice",12,164,296,40,"Font: sans",fn(f){return nil;});GUI.add(form,button);form.focus="choice";
for theme in ["dark","light"] {
    GUI.set_palette(form,GUI.palette(theme));
    for variant in ["primary","secondary","ghost","danger"] {
        button.variant=variant;
        for selected in [false,true] {
            button.selected=selected;let p=Focus.plan(form);check(p!=nil and len(p.rects)==4 and p.thickness==3,"bounded frame");
            let fill=Style.button(form.palette,variant,selected,true).fill;
            check(Colors.contrast_checked(map{r:p.color[0],g:p.color[1],b:p.color[2]},map{r:fill[0],g:fill[1],b:fill[2]}).ratio>=4.5,"high contrast chosen against actual fill");
            let area=0;for r in p.rects {check(r.x>=button.x and r.y>=button.y and r.x+r.w<=button.x+button.w and r.y+r.h<=button.y+button.h,"frame inside control");area=area+r.w*r.h;}
            check(area>=4*(button.w+button.h),"frame has sufficient pixel area");
        }
    }
}
button.variant="primary";button.selected=false;
for shade in [0,32,64,96,128,160,192,224,255] {
    form.palette.accent=[shade,shade,shade,255];check(Focus.plan(form).contrast>=4.5,"adaptive grayscale contrast");
}
let calls=[];let canvas=map{rect:fn(x,y,w,h,color){push(calls,map{x:x,y:y,w:w,h:h,color:color});}};
check(Focus.draw(canvas,form) and len(calls)==4 and form.focus=="choice","four drawing calls and no focus change");
button.clip_rect=map{x:14,y:166,w:20,h:20};let clipped=Focus.plan(form);
for r in clipped.rects {check(r.x>=14 and r.y>=166 and r.x+r.w<=34 and r.y+r.h<=186,"clip respected");}
button.clip_rect=map{x:500,y:500,w:1,h:1};check(Focus.plan(form)==nil,"fully clipped ignored");button.clip_rect=nil;
button.enabled=false;check(Focus.plan(form)==nil,"disabled ignored");button.enabled=true;
button.visible=false;check(Focus.plan(form)==nil,"hidden ignored");button.visible=true;
button.w=12;check(Focus.plan(form)==nil,"tiny custom control falls back");button.w=296;
form.palette.accent=[10,20,30,100];check(Focus.plan(form)==nil,"translucent fill retains fallback");
form.palette.accent=[-1,0,0];check(Focus.plan(form)==nil,"invalid RGB does not draw");
form.palette.accent=42;check(Focus.plan(form)==nil,"unresolved packed color retains fallback");
form.focus="missing";check(Focus.plan(form)==nil,"removed focus ignored");form.focus=nil;check(Focus.plan(form)==nil,"no focus draws nothing");
let c=App.create();App.enable_preferences(c,nil,nil,"Session only",fn(){return map{ok:false};});App.refresh(c);
c.form.focus="appearance";App.update(c,[map{type:"keydown",key:"Enter"}]);App.update(c,[map{type:"keyup",key:"Enter"}]);
App.configure(c,map{font_family:"monospace",button_size:40,font_scale:1.5,line_height:2.5});
for height in [240,320,480,816] {
    App.update(c,[map{type:"resize",w:320,h:height}]);let pages=c.settings_layout.count;
    for page pages {
        App.settings_page(c,page);App.update(c,[]);
        for w in c.form.widgets {if w.kind=="button" and w.enabled {
            c.form.focus=w.name;let p=Focus.plan(c.form);check(p!=nil,"every enabled compact action receives a frame");
            for r in p.rects {check(r.x>=0 and r.y>=0 and r.x+r.w<=320 and r.y+r.h<=height,"frame within viewport");}
        }}
    }
}
check(try {App.draw(c,canvas,42);false} catch true,"highlight switch is boolean");
c.session.close();print "reader_focus_indicator_pass checks="+str(count);
