let App=import("../../examples/declarative_browser/app.sapp");let GUI=import("stdlib:gui.sapp");let Profile=import("../../examples/declarative_browser/appearance_profile.sapp");
let n=0;fn check(ok,label){assert(ok,label);n=n+1;}
fn key(c,k){App.update(c,[map{type:"keydown",key:k},map{type:"keyup",key:k}]);}
fn make(height=816,prefs=true){let c=App.create();if prefs {App.enable_preferences(c);}c.width=320;c.height=height;c.settings=true;c.focus_target="body_size";App.refresh(c);return c;}
let c=make();key(c,"Left");check(c.preferences.draft.body_size==15,"Left decreases text by one");check(c.appearance.body_size==16,"draft is not applied");key(c,"Right");key(c,"Right");check(c.preferences.draft.body_size==17,"Right reaches non-preset size");check(c.form.focus=="body_size","focus retained");c.session.close();
for height in [240,288,480,816] {
 let r=make(height);key(r,"Left");check(r.preferences.draft.body_size==15,"compact decrement "+str(height));
 r.focus_target="title_size";App.refresh(r);key(r,"Right");check(r.preferences.draft.title_size==29,"title increment "+str(height));
 check(GUI.get(r.form,"title_size")!=nil,"focused title remains visible");
 App.update(r,[map{type:"keydown",key:"Right"},map{type:"keydown",key:"Right"}]);check(r.preferences.draft.title_size==30,"held key changes once");
 App.update(r,[map{type:"keydown",key:"Right"}]);check(r.preferences.draft.title_size==30,"held key survives rebuild");App.update(r,[map{type:"keyup",key:"Right"}]);
 key(r,"Escape");check(not r.settings and r.preferences.draft==r.appearance,"Escape discards fine draft");r.session.close();
}
let bounds=make();bounds.preferences.draft.body_size=12;App.refresh(bounds);bounds.form.probe="kept";key(bounds,"Left");check(bounds.preferences.draft.body_size==12 and bounds.form.probe=="kept","minimum no wrap or rebuild");
bounds.preferences.draft.body_size=40;App.refresh(bounds);key(bounds,"Right");check(bounds.preferences.draft.body_size==40,"maximum no wrap");
bounds.preferences.draft.body_size=27;App.refresh(bounds);key(bounds,"Right");check(bounds.preferences.draft.body_size==28,"custom value increments exactly");key(bounds,"Enter");check(bounds.preferences.draft.body_size==14,"legacy Enter presets retained");
for mod in ["ctrl","alt","meta","shift"] {let event=map{type:"keydown",key:"Right"};event[mod]=true;App.update(bounds,[event,map{type:"keyup",key:"Right"}]);check(bounds.preferences.draft.body_size==14,"modified arrow ignored "+mod);}
App.update(bounds,[map{type:"keydown",key:"LCtrl"}]);key(bounds,"Right");check(bounds.preferences.draft.body_size==14,"held modifier ignored");App.update(bounds,[map{type:"keyup",key:"LCtrl"}]);
bounds.form.focus="style_apply";key(bounds,"Right");check(bounds.preferences.draft.body_size==14 and bounds.appearance.body_size==16,"arrow does not apply");
bounds.form.focus="body_size";GUI.set_enabled(bounds.form,"body_size",false);key(bounds,"Right");check(bounds.preferences.draft.body_size==14,"disabled choice ignored");bounds.session.close();
let immediate=make(240,false);key(immediate,"Right");check(immediate.appearance.body_size==17,"legacy session mode applies directly");immediate.session.close();
let api=make();check(App.adjust_text_size(api,"body_size",1) and api.preferences.draft.body_size==17,"developer helper");
check((try {App.adjust_text_size(api,"caption_size",1);false} catch true),"unsupported property refused");check((try {App.adjust_text_size(api,"title_size",2);false} catch true),"invalid step refused");
key(api,"Escape");check(not App.adjust_text_size(api,"body_size",1),"helper inactive outside Style");api.session.close();
let state=map{saved:nil,count:0};let saver=fn(style){state.saved=Profile.decode(Profile.encode(style)).appearance;state.count=state.count+1;return map{ok:true};};
let saved=make();App.enable_preferences(saved,nil,saver);saved.focus_target="body_size";App.refresh(saved);key(saved,"Right");saved.focus_target="title_size";App.refresh(saved);key(saved,"Right");check(state.count==0,"editing never saves");saved.focus_target="style_save";App.refresh(saved);key(saved,"Enter");check(state.count==1 and state.saved.body_size==17 and state.saved.title_size==29 and saved.appearance==state.saved,"explicit Save accepts fine sizes");saved.session.close();
print "reader_fine_size_pass checks="+str(n);
