let Channel = import("stdlib:release_channel.sapp");

fn require(value, message) { if not value { throw "FAIL release_channel: " + message; } }

let unchanged = Channel.resolve("1.2.3");
require(unchanged.ok and unchanged.application_version == "1.2.3"
    and unchanged.artifact_suffix == "" and not unchanged.runtime_overhead,
    "absent metadata preserves the old version and artifact name");

let beta = Channel.resolve("1.2.3", map{
    release_channel:"Beta.2", show_release_channel:true,
    release_channel_in_artifact:true
});
require(beta.ok and beta.release_channel == "beta.2", "channel is canonicalized");
require(beta.package_identity == "1.2.3" and beta.qualified_version == "1.2.3 [beta.2]"
    and beta.application_version == "1.2.3 [beta.2]"
    and beta.artifact_suffix == "--channel-beta.2" and beta.stability == "prerelease"
    and not beta.channel_changes_package_identity,
    "opted-in display and artifact labels remain separate from package identity");

let hidden = Channel.resolve("1.2.3", map{release_channel:"nightly.20260828"});
require(hidden.application_version == "1.2.3" and hidden.qualified_version == "1.2.3",
    "channel identity can remain hidden from the application");
require(hidden.stability == "development" and hidden.known_channel,
    "numbered nightly channels retain their class");

let custom = Channel.resolve("1.2.3", map{release_channel:"partner-preview"});
require(custom.ok and custom.custom_channel, "bounded custom channels are supported");
require(not Channel.resolve("1.2.3", map{release_channel:"bad channel!"}).ok,
    "unsafe filename and version characters are rejected");
require(not Channel.resolve("1.2.3", map{show_release_channel:"yes"}).ok,
    "boolean controls are type checked");
require(not Channel.resolve("v1.2.3").ok and not Channel.resolve("01.2.3").ok,
    "release metadata accepts only canonical SemVer package identity");

let prerelease = Channel.resolve("0.5.0-alpha.1+build.001", map{
    release_channel:"nightly",show_release_channel:true,release_channel_in_artifact:true
});
require(prerelease.ok and prerelease.package_identity == "0.5.0-alpha.1+build.001"
    and prerelease.application_version == "0.5.0-alpha.1+build.001 [nightly]"
    and prerelease.artifact_suffix == "--channel-nightly"
    and prerelease.version_prerelease == "alpha.1" and prerelease.version_build == "build.001",
    "prerelease/build identity is exact while channel remains an independent badge");
require(Channel.resolve("0.5.0-alpha", map{release_channel:"stable"}).contradictory_stability,
    "stable distribution tracks explicitly flag prerelease package identity conflicts");

let toolchain = Channel.resolve("0.6.0", map{
    release_channel:"alpha", show_release_channel:true
});
let application = Channel.resolve("7.3.1", map{
    release_channel:"stable", show_release_channel:true,
    release_channel_in_artifact:true
});
require(toolchain.application_version == "0.6.0 [alpha]"
    and application.application_version == "7.3.1 [stable]"
    and application.artifact_suffix == "--channel-stable",
    "application identity remains independent from the PBLang toolchain identity");

print "release_channel_pass";
