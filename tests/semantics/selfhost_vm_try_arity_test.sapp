// tests/semantics/selfhost_vm_try_arity_test.sapp
//
// The self-hosted VM (stdlib/compiler/vm.sapp) must match the Rust VM on two
// edge cases its handlers got wrong:
//
//  1. OP_TRY used a VALUE sentinel ("__pblang_selfhost_try_sentinel__") to
//     detect a thrown error: `let r = try exec(body) catch SENTINEL; if r ==
//     SENTINEL {run handler}`. If the try BODY legitimately returned that exact
//     string, the VM mistook success for a throw and wrongly ran the handler.
//     A try/catch must run the handler ONLY on a real throw, whatever the body
//     returns -- including that sentinel string and including nil.
//
//  2. OP_CALL silently filled missing arguments with nil, so calling a 2-arg
//     function with 1 arg returned nil instead of throwing. The Rust VM throws
//     an arity error when fewer than min_arity args are supplied; the self-
//     hosted VM must do the same (while still honoring default params).

let fe = import("stdlib/compiler/selfhost_frontend.sapp");
let vm = import("stdlib/compiler/vm.sapp");

fn fail(m) { throw "FAIL " + m; }

// Run `src` on the self-hosted VM and return the first printed value, or the
// marker "THREW" if execution raised.
fn val(src) {
    let ch = fe.frontend_compile(src).chunk;
    let r = try vm.run(ch) catch "THREW";
    if r == "THREW" { return "THREW"; }
    if len(r.output) == 0 { return "NOOUT"; }
    return r.output[0];
}

let SENT = "__pblang_selfhost_try_sentinel__";

// 1. try body that returns the sentinel string must yield the sentinel, NOT the
//    handler's value.
let a = val("let x = try (\"" + SENT + "\") catch \"caught\"; print x;");
if a != SENT { fail("try returning sentinel string must yield it, got " + str(a)); }

// 1b. a normal try with no throw still returns the body value.
if val("let x = try (\"hello\") catch \"caught\"; print x;") != "hello" { fail("normal try body"); }

// 1c. a try body that returns nil must yield nil (not run the handler).
if val("let x = try (nil) catch \"caught\"; print x;") != nil { fail("try returning nil"); }

// 1d. a try whose body actually throws must run the handler.
if val("let x = try (1 + nil + undefined_global_xyz()) catch \"caught\"; print x;") != "caught" {
    fail("throwing try must run handler");
}

// 2. calling a 2-arg function with 1 arg must THROW (arity), matching the Rust VM.
if val("fn f(a, b) { return b; } let x = f(7); print x;") != "THREW" {
    fail("too-few-args call must throw arity error");
}

// 2b. supplying all args still works.
if val("fn f(a, b) { return a + b; } let x = f(3, 4); print x;") != 7 { fail("full-args call"); }

// 2c. calling a 1-arg function with 3 args must THROW (too many), like the Rust VM.
if val("fn f(a) { return a; } let x = f(1, 2, 3); print x;") != "THREW" {
    fail("too-many-args call must throw arity error");
}

print "selfhost_vm_try_arity_pass";
