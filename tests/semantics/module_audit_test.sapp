let AUDIT = import("stdlib:project_text_audit.sapp");

fn fail(message) { throw "FAIL module_audit: " + message; }
fn require(value, message) { if value != true { fail(message); } }
let root = "tests/fixtures/module_audit";
let a = root + "/stdlib";
let b = root + "/tools";

let report = AUDIT.audit_modules("fixture", [a, b], map{
    max_finding_index: 1, max_findings_per_file: 16,
    max_files_per_module: 10, max_file_bytes: 10000,
    suppress_test_fixtures: false
});
require(report.ok and report.complete and report.module_count == 2 and report.files_scanned == 3,
    "all eligible files across both modules are scanned");
require(report.finding_count >= 2 and report.finding_index_count == 1
    and report.finding_index_truncated, "bounded summary index does not stop module findings");
require(report.modules[0].files_scanned == 2 and report.modules[1].files_scanned == 1,
    "per-module coverage is retained");
require(report.modules[0].finding_count + report.modules[1].finding_count == report.finding_count,
    "aggregate count is derived from complete module reports");
require(len(report.modules[0].findings) > 0
    and not map_has(report.modules[0].findings[0], "text")
    and len(report.modules[0].findings[0].fingerprint) == 64,
    "persistent module findings redact source text and retain stable fingerprints");
require(not map_has(report.modules[0].files[0], "findings")
    and not map_has(report.modules[0].files[0], "suppressed"),
    "per-file summaries do not duplicate module finding indexes");

let combined = AUDIT.combine_module_reports("fixture", report.modules, map{
    max_finding_index: 1, requested_roots: [a, b], audit_id: "fixture-audit"
});
require(combined.ok and combined.complete and combined.finding_count == report.finding_count
    and combined.files_scanned == report.files_scanned
    and combined.finding_index_truncated and combined.audit_id == "fixture-audit"
    and combined.engine_revision == AUDIT.module_audit_engine_revision(),
    "independent module checkpoints recombine without losing aggregate counts");

let excluded = AUDIT.audit_modules("fixture", [a], map{
    max_files_per_module: 10, max_file_bytes: 10000, max_findings_per_file: 16,
    excluded_paths: [a + "/risk.sapp"]
});
require(excluded.ok and excluded.complete and excluded.files_scanned == 1
    and excluded.modules[0].eligible_files == 2,
    "checkpoint output can be excluded without hiding eligible coverage accounting");

let snapshot_root = "tests/fixtures/module-audit-state-"
    + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 12);
fs_mkdirs(snapshot_root);
fs_write(snapshot_root + "/main.sapp", "fn stable() { return 1; }\n");
let snapshot_report = AUDIT.audit_modules("snapshot", [snapshot_root], map{
    max_files_per_module: 10, max_file_bytes: 10000, max_findings_per_file: 16
});
require(snapshot_report.ok and snapshot_report.complete,
    "snapshot fixture is audited completely");
let stable_snapshot = AUDIT.verify_module_snapshot(snapshot_report.modules[0], map{
    max_files_per_module: 10, max_file_bytes: 10000
});
require(stable_snapshot.ok and stable_snapshot.stable and stable_snapshot.files_checked == 1,
    "unchanged module checkpoint verifies before resume");
fs_write(snapshot_root + "/main.sapp", "fn changed() { return 2; }\n");
let changed_snapshot = AUDIT.verify_module_snapshot(snapshot_report.modules[0], map{
    max_files_per_module: 10, max_file_bytes: 10000
});
require(changed_snapshot.ok and not changed_snapshot.stable,
    "changed module checkpoint cannot be reused");
try fs_remove(snapshot_root + "/main.sapp") catch nil;
try fs_remove(snapshot_root) catch nil;

let encoding_root = "tests/fixtures/module-audit-encoding-"
    + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 12);
fs_mkdirs(encoding_root);
let legacy_path = encoding_root + "/legacy.ps1";
let utf16_path = encoding_root + "/utf16.txt";
fs_write_bytes(legacy_path, [35, 32, 99, 97, 102, 233, 10, 87, 114, 105, 116, 101, 45, 79, 117, 116, 112, 117, 116, 32, 34, 111, 107, 34, 10]);
fs_write_bytes(utf16_path, [255, 254, 84, 0, 79, 0, 68, 0, 79, 0, 10, 0]);
let encoding_report = AUDIT.audit_modules("encoding", [encoding_root], map{
    max_files_per_module: 10, max_file_bytes: 10000, max_findings_per_file: 16
});
require(encoding_report.ok and encoding_report.complete and encoding_report.files_scanned == 2
    and encoding_report.encoding_degraded_files == 2
    and encoding_report.modules[0].encoding_degraded_files == 2,
    "legacy and UTF-16 text receive explicit ASCII-preserving audit coverage");
let encoding_stable = AUDIT.verify_module_snapshot(encoding_report.modules[0], map{
    max_files_per_module: 10, max_file_bytes: 10000
});
require(encoding_stable.ok and encoding_stable.stable,
    "legacy source raw-byte snapshot verifies before reuse");
fs_write_bytes(legacy_path, [35, 32, 99, 97, 102, 234, 10, 87, 114, 105, 116, 101, 45, 79, 117, 116, 112, 117, 116, 32, 34, 111, 107, 34, 10]);
let encoding_changed = AUDIT.verify_module_snapshot(encoding_report.modules[0], map{
    max_files_per_module: 10, max_file_bytes: 10000
});
require(encoding_changed.ok and not encoding_changed.stable,
    "raw-byte snapshot detects legacy-byte replacement even when decoded audit text is unchanged");
try fs_remove(legacy_path) catch nil;
try fs_remove(utf16_path) catch nil;
try fs_remove(encoding_root) catch nil;

let bounded = AUDIT.audit_modules("fixture", [a], map{
    max_files_per_module: 1, max_file_bytes: 10000, max_findings_per_file: 16
});
require(bounded.ok and not bounded.complete and bounded.status == "incomplete"
    and len(bounded.modules[0].incomplete_reasons) >= 1,
    "module file limit is explicit and cannot be reported as complete");

print "module_audit_pass";
