// Test: stdlib/debug.sapp — the runtime debugging toolkit.
//
// Builds on the self-hosted frontend (frontend_run = eval) plus stdlib/watch.sapp
// to provide: eval a source string, RUN A SPECIFIC RANGE OF LINES, evaluate a
// single expression, trace execution cost via a watcher, and disassemble a line
// range. All pure pblang on the Rust interpreter; no Rust changes.

let dbg = import("stdlib/debug.sapp");

// ── run_source: eval a snippet, capture printed output + top-level globals ──
let r1 = dbg.run_source("print 6 * 7;");
assert(r1.ok == true, "run_source ok");
assert(r1.output[0] == 42, "run_source captures printed output");

// a broken snippet reports failure WITHOUT throwing (never crashes the debugger)
let r2 = dbg.run_source("let = = ;");
assert(r2.ok == false, "run_source reports failure without throwing");

// ── run_lines: execute only a sub-range of a multi-line program (1-based) ──
let prog = "let x = 10;\nlet y = x + 5;\nprint y;\nprint x * 100;";
let rl = dbg.run_lines(prog, 1, 3);             // x, y, print y -> 15
assert(rl.ok == true, "run_lines ok");
assert(len(rl.output) == 1 and rl.output[0] == 15, "run_lines runs ONLY lines 1-3");
assert(rl.globals.y == 15, "run_lines exposes the range's globals");
assert(rl.start_line == 1 and rl.end_line == 3, "run_lines echoes the requested range");

let rl2 = dbg.run_lines(prog, 1, 4);            // both prints
assert(len(rl2.output) == 2 and rl2.output[1] == 1000, "run_lines 1-4 runs both prints");

let rl3 = dbg.run_lines(prog, 1, 999);          // end past EOF clamps
assert(rl3.ok == true and len(rl3.output) == 2, "run_lines clamps end past EOF");

// ── run_file_lines: same, sourced from disk ──
let tmp = "tests/semantics/.debug_tmp.sapp";
fs_write(tmp, prog);
let rf = dbg.run_file_lines(tmp, 1, 3);
assert(rf.ok == true and rf.output[0] == 15, "run_file_lines runs a range from a file");
let rfbad = dbg.run_file_lines("tests/semantics/.no_such_file.sapp", 1, 3);
assert(rfbad.ok == false, "run_file_lines reports a missing file without throwing");

// ── eval_expr: the value of a single expression (no print needed) ──
let ev = dbg.eval_expr("6 * 7 + 1");
assert(ev.ok == true and ev.value == 43, "eval_expr returns the expression value");

// ── trace_source: run under a watcher; report timing + allocation delta ──
let tr = dbg.trace_source("let a = [1, 2, 3]; print len(a);");
assert(tr.ok == true and tr.output[0] == 3, "trace_source runs and captures output");
assert(tr.ms >= 0, "trace_source reports elapsed ms (watcher)");
assert(tr.allocations != nil, "trace_source reports allocation delta from the watcher");

// ── disasm_lines: bytecode of a line range (watch.disasm) ──
let dl = dbg.disasm_lines(prog, 1, 1);
assert(len(dl) >= 1, "disasm_lines returns instructions for the range");
assert(dl[0].name != nil, "disasm_lines decodes opcode names");

// ── cli_run: pure CLI adapter (no print/exit) for tools/pbdebug.sapp ──
fs_write(tmp, prog);
let c1 = dbg.cli_run([tmp, "--lines", "1:3"]);
assert(c1.ok == true and c1.exit_code == 0, "cli_run --lines runs ok");
assert(len(c1.output) == 1 and c1.output[0] == 15, "cli_run runs the requested range");

let c1b = dbg.cli_run([tmp, "--lines", "1"]);    // single-line form
assert(c1b.ok == true and c1b.exit_code == 0 and len(c1b.output) == 0, "cli_run single-line range");

let c2 = dbg.cli_run(["--expr", "6 * 7"]);
assert(c2.ok == true and c2.exit_code == 0 and c2.value == 42, "cli_run --expr returns the value");

let c3 = dbg.cli_run([]);
assert(c3.ok == false and c3.exit_code == 2, "cli_run with no args -> usage error (exit 2)");

let c4 = dbg.cli_run(["tests/semantics/.no_such_file.sapp", "--lines", "1:2"]);
assert(c4.ok == false and c4.exit_code == 1, "cli_run missing file -> run error (exit 1)");

print "debug_toolkit_pass";
