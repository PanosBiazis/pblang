// Prepared builtin metadata and conservative lexical-shadow analysis must
// preserve the tree interpreter's dynamic name semantics.
let I = import("stdlib/compiler/interp.sapp");
let T = import("stdlib/compiler/tokenizer.sapp");
let P = import("stdlib/compiler/parser.sapp");

fn require(condition, message) {
    if not condition { throw "interp builtin resolution: " + message; }
}

fn run(source, label) {
    let result = try I.eval_program(source) catch false;
    require(result == true, label);
}

run(
    "let a = [1]; push(a, 7); if len(a) != 2 or pop(a) != 7 { missing(); } "
    + "if str(42) != \"42\" or abs(-7) != 7 { missing(); } "
    + "if str_slice(\"abcd\", 1, 3) != \"bc\" { missing(); } "
    + "if strcharcodeat(\"A\", 0) != 65 or strfromcharcode(65) != \"A\" { missing(); } "
    + "if str_split(\"a,b\", \",\")[1] != \"b\" or parse_number(\"42\") != 42 { missing(); } "
    + "let m = map{x: 1}; if not map_has(m, \"x\") or len(map_keys(m)) != 1 { missing(); } "
    + "if str_trim(\"  pblang  \") != \"pblang\" { missing(); } "
    + "if not str_starts_with(\"pblang\", \"pb\") { missing(); } "
    + "if str_replace_all(\"a-b-a\", \"a\", \"x\") != \"x-b-x\" { missing(); } "
    + "if num_pow(2, 5) != 32 { missing(); }",
    "prepared dispatch changed builtin behavior"
);

// Calls before and after a local declaration must still resolve dynamically.
run(
    "fn use() { let a = [1, 2]; if len(a) != 2 { missing(); } "
    + "let len = fn(x) { return 40 + x[0]; }; return len(a); } "
    + "if use() != 41 { missing(); }",
    "call-before-declaration or local shadowing changed"
);

run(
    "fn len(x) { return 90 + x[0]; } if len([2]) != 92 { missing(); }",
    "named function shadowing changed"
);
run(
    "fn apply(len) { return len(4); } let plus = fn(x) { return x + 3; }; "
    + "if apply(plus) != 7 { missing(); }",
    "parameter shadowing changed"
);
run(
    "let make = fn(len) { return fn(x) { return len(x); }; }; "
    + "let f = make(fn(x) { return x * 2; }); if f(6) != 12 { missing(); }",
    "function-literal parameter shadowing changed"
);
run(
    "let m = map{f: fn(x) { return x + 1; }}; if m.f(4) != 5 { missing(); } "
    + "let a = [fn(x) { return x * 2; }]; if a[0](3) != 6 { missing(); }",
    "member or index callee was treated as a builtin"
);

let loop_shadow = try I.eval_program("for len 1 { len([1]); }") catch "caught";
require(loop_shadow == "caught", "loop binding was incorrectly treated as a builtin");

let direct_ast = I.compile_program("let a = [1]; if len(a) != 1 { missing(); }");
let direct_call = direct_ast.stmts[1].cond.left;
require(direct_call["@ib"] == true, "builtin candidate was not prepared");
require(direct_call["@iu"] == true, "provably unshadowed builtin was not marked direct");

let shadow_ast = I.compile_program("fn len(x) { return 5; } if len([1]) != 5 { missing(); }");
let shadow_call = shadow_ast.stmts[1].cond.left;
require(shadow_call["@ib"] == true, "shadow candidate lost builtin metadata");
require(shadow_call["@iu"] == false, "shadow candidate was incorrectly marked direct");
require(I.eval_ast(shadow_ast), "prepared shadow candidate failed");

// A boolean marker came from the previous private metadata version. eval_ast
// must not trust it after the prepared layout changes.
let stale_ast = P.parse(T.tokenize("let a = [1, 2]; if len(a) != 2 { missing(); }"));
stale_ast["@interp_prepared"] = true;
require(I.eval_ast(stale_ast), "stale prepared marker was not rebuilt");
require(stale_ast["@interp_prepared"] == 3, "prepared marker version was not refreshed");
require(stale_ast.stmts[1].cond.left["@iu"] == true, "rebuilt raw AST lacks direct metadata");

print "interp_builtin_resolution_pass";
