let F=import("stdlib:compiler/selfhost_frontend.sapp");
let D=import("stdlib:db.sapp");
let source="let D=import(\"stdlib:db.sapp\"); for n in [0,1,2,17,127,256,1023,-1,0.1,2.9] {print D.sql_placeholders(n);} print (try D.sql_placeholders(9007199254740992) catch \"rejected\");";
let expected=[];
for n in [0,1,2,17,127,256,1023,-1,0.1,2.9] {array_push(expected,D.sql_placeholders(n));}
array_push(expected,"rejected");
let result=F.frontend_run(source);
if not result.ok or result.output != expected {throw "FAIL: selfhost DB placeholder parity";}
print "selfhost_db_placeholders_pass";
