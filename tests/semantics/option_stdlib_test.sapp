// Test: option.sapp module
import "stdlib:option.sapp";

let s1 = option.some(42);
if s1.some == false { print "FAIL some constructor"; }
if option.is_some(s1) == false { print "FAIL is_some"; }
if option.unwrap(s1) != 42 { print "FAIL unwrap some"; }

let n1 = option.none();
if n1.some == true { print "FAIL none constructor"; }
if option.is_none(n1) == false { print "FAIL is_none"; }
if option.unwrap_or(n1, 99) != 99 { print "FAIL unwrap_or none"; }

let s2 = option.of(42);
if option.is_some(s2) == false { print "FAIL of non-nil"; }

let n2 = option.of(nil);
if option.is_none(n2) == false { print "FAIL of nil"; }

let s3 = option.map_val(s1, fn(v) { return v + 1; });
if option.unwrap(s3) != 43 { print "FAIL map_val some"; }

let n3 = option.map_val(n1, fn(v) { return v + 1; });
if option.is_none(n3) == false { print "FAIL map_val none"; }

let s4 = option.filter(s1, fn(v) { return v > 10; });
if option.is_some(s4) == false { print "FAIL filter pass"; }

let n4 = option.filter(s1, fn(v) { return v > 100; });
if option.is_none(n4) == false { print "FAIL filter reject"; }

let ts = option.to_string(s1);
if str_contains(ts, "Some") == false { print "FAIL to_string some"; }
let tn = option.to_string(n1);
if tn != "None" { print "FAIL to_string none"; }

print "option_stdlib_pass";
