// Test: the SELF-HOSTED compiler (stdlib/compiler/) now parses `async fn` and
// `await` — another rust→pblang parity step (the Rust frontend had these in §48).
//
// `async fn f(p){body}` desugars to `fn f(p){ return spawn(fn(){body}); }`;
// `await E` desugars to `join(E)`. `await` is a whitespace-guarded contextual
// keyword (so `await(x)` stays an ordinary call). `spawn`/`join` are ordinary
// global builtins/idents (no longer reserved keywords in the self-hosted
// tokenizer) — so the desugar resolves them at runtime; programs supply them
// (here as synchronous stubs, since the self-hosted VM is single-threaded).
//
// NOTE: executing async fns that CAPTURE their params needs upvalue capture,
// which stdlib/compiler/vm.sapp does not yet support (a pre-existing gap — its
// OP_CLOSURE pushes the function constant without capturing the environment).
// So this test executes non-capturing async fns and verifies that capturing ones
// at least COMPILE. Upvalue capture is the next self-hosted-VM improvement.

let fe = import("stdlib/compiler/selfhost_frontend.sapp");

// --- async fn (no captured vars) executes via the desugar (sync spawn/join) ---
let src1 = "fn spawn(f) { return f(); } fn join(x) { return x; } "
    + "async fn compute() { return 6 * 7; } "
    + "let task = compute(); "          // = spawn(fn(){ return 6*7; }) = 42
    + "let result = await task; "       // = join(task) = 42
    + "let direct = await compute();";  // await on a call expression = 42

let r1 = fe.frontend_run(src1);
assert(r1.ok == true, "self-hosted compile+run of async/await must succeed");
assert(r1.globals["result"] == 42, "self-hosted: async compute() then await == 42");
assert(r1.globals["direct"] == 42, "self-hosted: await on a call expression == 42");

// --- await desugars to join(EXPR) for arbitrary expressions ---
let src2 = "fn join(x) { return x; } "
    + "let a = await (5 + 3); "         // join(8) = 8
    + "let b = await 10 * 2;";         // await binds as unary: join(10) * 2 = 20

let r2 = fe.frontend_run(src2);
assert(r2.ok == true, "self-hosted compile+run of await-expressions must succeed");
assert(r2.globals["a"] == 8, "self-hosted: await (5+3) == 8");
assert(r2.globals["b"] == 20, "self-hosted: await binds as a unary prefix (join(10)*2)");

// --- Whitespace guard: `await(x)` ADJACENT stays a call to a fn named `await` ---
let src3 = "fn await(v) { return v + 1; } "
    + "let d = await(99); "             // ordinary call -> 100
    + "let e = await( 7 );";           // also adjacent '(' -> call -> 8

let r3 = fe.frontend_run(src3);
assert(r3.ok == true, "self-hosted compile+run with `await` as a function name must succeed");
assert(r3.globals["d"] == 100, "self-hosted: await(99) is an ordinary call, not the keyword");
assert(r3.globals["e"] == 8, "self-hosted: await( 7 ) adjacent paren stays a call");

// --- Capturing async fn now EXECUTES (upvalue capture landed — see
//     selfhost_closure_test): the inner fn() captures a,b as upvalues. ---
let r4 = fe.frontend_run("fn spawn(f) { return f(); } fn join(x) { return x; } "
    + "async fn add(a, b) { return a + b; } let t = await add(1, 2);");
assert(r4.ok == true, "self-hosted: capturing async fn compiles+runs");
assert(r4.globals["t"] == 3, "self-hosted: capturing async fn executes (a,b captured) == 3");

print "selfhost_async_pass";
