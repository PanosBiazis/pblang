let EXIF = import("stdlib:exif.sapp");

fn expect(condition, message) { if not condition { throw "FAIL exif: " + message; } }

// Little-endian TIFF with width=640 and a sensitive owner tag.
let tiff = [73,73,42,0, 8,0,0,0,
    2,0,
    0,1, 4,0, 1,0,0,0, 128,2,0,0,
    48,164, 2,0, 6,0,0,0, 38,0,0,0,
    0,0,0,0,
    65,108,105,99,101,0];
let parsed = EXIF.parse(tiff);
expect(parsed.ok and parsed.container == "TIFF" and parsed.byte_order == "little-endian",
    "little-endian TIFF must parse");
expect(parsed.tag_count == 2 and parsed.tags[0].name == "ImageWidth" and
       parsed.tags[0].value == 640, "width tag must decode");
expect(parsed.tags[1].name == "CameraOwnerName" and parsed.tags[1].redacted and
       parsed.tags[1].value == "[redacted]" and parsed.redacted_count == 1,
    "owner identity must be redacted before publication");

let timestamp = [73,73,42,0, 8,0,0,0, 1,0,
    3,144, 2,0, 20,0,0,0, 26,0,0,0, 0,0,0,0,
    50,48,50,54,58,48,56,58,49,51,32,48,49,58,48,50,58,48,51,0];
let parsed_timestamp = EXIF.parse(timestamp);
expect(parsed_timestamp.ok and parsed_timestamp.tags[0].name == "DateTimeOriginal" and
       parsed_timestamp.tags[0].redacted and parsed_timestamp.tags[0].value == "[redacted]",
    "exact capture timestamp must be redacted");

// MakerNote/vendor UNDEFINED data can contain device identifiers and private blobs.
let maker_note = [73,73,42,0, 8,0,0,0, 1,0,
    124,146, 7,0, 4,0,0,0, 1,2,3,4, 0,0,0,0];
let parsed_maker_note = EXIF.parse(maker_note);
expect(parsed_maker_note.ok and parsed_maker_note.tags[0].name == "MakerNote" and
       parsed_maker_note.tags[0].redacted and parsed_maker_note.tags[0].value == "[redacted]",
    "vendor undefined metadata must be redacted before publication");

// Big-endian TIFF with orientation=6.
let big = [77,77,0,42, 0,0,0,8, 0,1,
    1,18, 0,3, 0,0,0,1, 0,6,0,0, 0,0,0,0];
let parsed_big = EXIF.parse(big);
expect(parsed_big.ok and parsed_big.byte_order == "big-endian" and
       parsed_big.tags[0].name == "Orientation" and parsed_big.tags[0].value == 6,
    "big-endian inline SHORT must decode");

// JPEG APP1 wrapper around the little-endian TIFF.
let jpeg = [255,216,255,225, 0,52, 69,120,105,102,0,0];
for i len(tiff) { jpeg[len(jpeg)] = tiff[i]; }
jpeg[len(jpeg)] = 255; jpeg[len(jpeg)] = 217;
let parsed_jpeg = EXIF.parse(jpeg);
expect(parsed_jpeg.ok and parsed_jpeg.container == "JPEG" and parsed_jpeg.tag_count == 2,
    "JPEG APP1 EXIF must parse");
let duplicate = [];
for i 2 { duplicate[len(duplicate)] = jpeg[i]; }
for _copy 2 {
    for i len(jpeg) - 4 { duplicate[len(duplicate)] = jpeg[2 + i]; }
}
duplicate[len(duplicate)] = 255; duplicate[len(duplicate)] = 217;
expect(not EXIF.parse(duplicate).ok and str_contains(EXIF.parse(duplicate).error, "duplicate"),
    "duplicate EXIF APP1 segments must fail closed");

let cyclic = [73,73,42,0, 8,0,0,0, 0,0, 8,0,0,0];
expect(not EXIF.parse(cyclic).ok and str_contains(EXIF.parse(cyclic).error, "cyclic"),
    "cyclic next-IFD pointer must fail closed");
let truncated = [73,73,42,0, 8,0,0,0, 1,0, 0,1];
expect(not EXIF.parse(truncated).ok, "truncated IFD must fail closed");
expect(not EXIF.parse([1,2,3,4]).ok, "unknown container must fail closed");

print "exif_pass";
