let I=import("stdlib:interval_analysis.sapp");
fn interval(a,b){return map{start_ms:a,end_ms:b};}
fn slot(a,b){return map{start_ms:a,end_ms:b,duration_ms:b-a};}
let source=[interval(18,24),interval(6,12),interval(21,30)];let before=json_stringify(source);let report=I.free_windows(source,0,60,6);
assert(report.slots==[slot(0,6),slot(12,18),slot(30,60)],"leading/internal/trailing and inclusive threshold");assert(report.occupied_ms==18 and report.free_ms==42 and report.matching_ms==42,"union occupancy once");
assert(I.free_windows(source,0,60,7).slots==[slot(30,60)],"filter short gaps");assert(I.free_windows(source,0,60,7).free_ms==42 and I.free_windows(source,0,60,7).matching_ms==30,"total free distinct from qualifying time");
assert(I.free_windows(source,10,22,1).slots==[slot(12,18)],"clip both boundaries");assert(I.free_windows([],3,9,6).slots==[slot(3,9)],"empty occupancy frees whole window");assert(I.free_windows([],3,9,7).slots==[],"minimum larger than window is valid no match");
assert(I.free_windows([interval(0,10),interval(20,30)],10,20,1).slots==[slot(10,20)],"touching outside entries are not busy");assert(I.free_windows([interval(0,10),interval(10,20)],0,20,1).slots==[],"touching occupied intervals leave no gap");assert(I.free_windows([interval(0,60),interval(5,8)],10,30,1).free_ms==0,"nested full coverage");
report.slots[0].start_ms=99;assert(json_stringify(source)==before,"output detached and source order retained");
for bounds in [[0,0,1],[2,1,1],[-1,3,1],[0,I.MAX_TIME_MS+1,1],[0,10,0],[0,10,-1],[0,10,0.5],[0,10,"1"],[0,10,I.MAX_TIME_MS+1],["0",10,1],[0,1.5,1]]{assert((try I.free_windows(source,bounds[0],bounds[1],bounds[2]) catch nil)==nil,"invalid parameters");}
assert((try I.free_windows([interval(100,99)],0,10,1) catch nil)==nil,"invalid out-of-window source still rejects");
// Independent discrete occupancy oracle, not another interval sweep.
for seed in range(0,40){let data=[];for j in range(0,num_mod(seed,13)){let a=num_mod(seed*7+j*11,51);array_push(data,interval(a,a+1+num_mod(seed+j,9)));}let minimum=1+num_mod(seed,8);let expected=[];let run_start=-1;let free=0;let matching=0;
 for t in range(5,46){let busy=t==45;for item in data{if item.start_ms<=t and t<item.end_ms{busy=true;}}
  if not busy{free=free+1;if run_start<0{run_start=t;}}
  elif run_start>=0{if t-run_start>=minimum{array_push(expected,slot(run_start,t));matching=matching+t-run_start;}run_start=-1;}
 }
 let actual=I.free_windows(data,5,45,minimum);assert(actual.slots==expected and actual.free_ms==free and actual.matching_ms==matching and actual.occupied_ms+free==40,"independent occupancy oracle");
}
let maximum=[];for i in range(0,512){array_push(maximum,interval(i*2+1,i*2+2));}let result=I.free_windows(maximum,0,1025,1);assert(len(result.slots)==513 and result.free_ms==513,"maximum 513 detached free windows");array_push(maximum,interval(1,2));assert((try I.free_windows(maximum,0,1025,1) catch nil)==nil,"source item cap");
assert(I.free_windows([],I.MAX_TIME_MS-1,I.MAX_TIME_MS,1).slots==[slot(I.MAX_TIME_MS-1,I.MAX_TIME_MS)],"maximum time boundary");print "interval_free_windows_pass";
