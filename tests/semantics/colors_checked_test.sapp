let C=import("stdlib:colors.sapp");
fn near(a,b){assert(num_abs(a-b)<0.000000001,"reference tolerance");}
fn ref(rgb){let parts=[];for key in ["r","g","b"]{let s=rgb[key]/255;array_push(parts,if s<=0.04045{s/12.92} else {((s+0.055)/1.055)**2.4});}return parts[0]*0.2126+parts[1]*0.7152+parts[2]*0.0722;}
let black=C.hex_checked("#000");let white=C.hex_checked("#FFF");assert(C.rgb_to_hex(white)=="#ffffff","canonical short hex");near(C.contrast_checked(black,white).ratio,21);near(C.contrast_checked(white,white).ratio,1);
assert(not C.contrast_checked(C.hex_checked("#777777"),white).aa_normal,"unrounded fail below 4.5");assert(C.contrast_checked(C.hex_checked("#767676"),white).aa_normal,"above threshold");
let samples=[];for i in range(0,32){array_push(samples,map{r:(i*71)%256,g:(i*131)%256,b:(i*193)%256});}let before=json_stringify(samples);let matrix=C.contrast_matrix_checked(samples);
for i in range(0,32){near(matrix[i][i],1);for j in range(0,32){let a=ref(samples[i]);let b=ref(samples[j]);near(matrix[i][j],(num_max(a,b)+0.05)/(num_min(a,b)+0.05));assert(matrix[i][j]==matrix[j][i],"symmetric");}}
assert(json_stringify(samples)==before,"inputs untouched");matrix[0][1]=999;assert(matrix[1][0]!=999,"independent cells");
for i in range(0,256){let gray=map{r:i,g:i,b:i};let result=C.best_text_checked(gray);assert(result.ratio>=4.5,"black or white normal-text candidate");near(result.ratio,num_max(C.contrast_checked(black,gray).ratio,C.contrast_checked(white,gray).ratio));}
for bad in [nil,1,"ffffff"," #fff","#ff","#ggg","#12345678"]{assert((try C.hex_checked(bad) catch nil)==nil,"strict hex rejection");}
for bad in [nil,[],map{r:0,g:0},map{r:0,g:0,b:0,a:255},map{r:-1,g:0,b:0},map{r:1.5,g:0,b:0},map{r:true,g:0,b:0},map{r:256,g:0,b:0}]{assert((try C.rgb_checked(bad) catch nil)==nil,"strict RGB rejection");}
assert(C.contrast_matrix_checked([])==[],"empty matrix");array_push(samples,black);assert((try C.contrast_matrix_checked(samples) catch nil)==nil,"matrix bound");print "colors_checked_pass";
