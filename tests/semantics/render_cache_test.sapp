// tests/semantics/render_cache_test.sapp — pure-pblang render efficiency: dirty-rectangle
// tracking + a frame governor. The graphics builtins rasterize on ONE CPU core every
// frame; this lets an app (e.g. pbide) repaint only what changed and skip frames where
// nothing changed at all. Pure logic — no window/GPU needed, so it's deterministic.

let R = import("stdlib/render_cache.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── rect helpers ───────────────────────────────────────────────────────────────────
let a = map{ x: 0, y: 0, w: 10, h: 10 };
let b = map{ x: 5, y: 5, w: 10, h: 10 };
let c = map{ x: 100, y: 100, w: 4, h: 4 };
eq(R.rect_overlaps(a, b), true, "overlapping rects detected");
eq(R.rect_overlaps(a, c), false, "disjoint rects not overlapping");
let u = R.rect_union(a, b);
eq(u.x, 0, "union x"); eq(u.y, 0, "union y"); eq(u.w, 15, "union w"); eq(u.h, 15, "union h");
let cl = R.rect_clip(map{ x: -5, y: -5, w: 20, h: 20 }, 10, 10);
eq(cl.x, 0, "clip x"); eq(cl.w, 10, "clip w to bounds");
eq(R.rect_area(map{ x: 0, y: 0, w: 3, h: 4 }), 12, "rect area");

// ── dirty tracker ──────────────────────────────────────────────────────────────────
let dc = R.new(200, 100);
eq(R.is_dirty(dc), false, "fresh cache is clean");
R.mark(dc, 0, 0, 10, 10);
R.mark(dc, 5, 5, 10, 10);                 // overlaps the first -> coalesces to one region
eq(R.is_dirty(dc), true, "marking makes it dirty");
let regs = R.regions(dc);
eq(len(regs), 1, "two overlapping marks coalesce into one region");
eq(regs[0].w, 15, "coalesced region spans both marks");

R.mark(dc, 150, 80, 10, 10);              // disjoint -> separate region
eq(len(R.regions(dc)), 2, "disjoint mark is a separate region");

// out-of-bounds marks are clipped away (zero-area, ignored)
let dc2 = R.new(50, 50);
R.mark(dc2, 100, 100, 10, 10);
eq(R.is_dirty(dc2), false, "fully out-of-bounds mark is ignored");

// large coverage collapses to a full repaint (partial redraw stops paying off)
let dc3 = R.new(100, 100);
R.mark(dc3, 0, 0, 90, 90);                // 81% of the surface
eq(R.is_full(dc3), true, "high coverage promotes to full repaint");
eq(len(R.regions(dc3)), 1, "full repaint is a single whole-surface region");
eq(R.regions(dc3)[0].w, 100, "full region covers the whole width");

R.clear_dirty(dc);
eq(R.is_dirty(dc), false, "clear_dirty resets after present");

// ── frame governor: skip frames with no change, cap to target fps ───────────────────
let g = R.governor_new(60);               // ~16.6ms interval
// first frame with an event -> render
let f1 = R.should_render(g, 0, "h0", true);
eq(f1.render, true, "renders on first event");
// same state, no event, before next interval -> skip
let f2 = R.should_render(f1.gov, 5, "h0", false);
eq(f2.render, false, "skips when nothing changed");
// state changed but still within the frame interval -> throttled (skip)
let f3 = R.should_render(f2.gov, 8, "h1", true);
eq(f3.render, false, "throttled within the fps interval even when dirty");
// state changed and interval elapsed -> render
let f4 = R.should_render(f3.gov, 30, "h1", true);
eq(f4.render, true, "renders once the interval elapses and state changed");
// interval elapsed but nothing changed -> still skip (no busy repaint)
let f5 = R.should_render(f4.gov, 60, "h1", false);
eq(f5.render, false, "no repaint when idle even past the interval");

print "render_cache_pass";
