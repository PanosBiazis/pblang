let GUI=import("stdlib:gui.sapp");
fn draw(options,smooth=true,scale=1) {
    let f=GUI.form("Type",200,100);GUI.set_text_render(f,"auto");
    f.viewport.ui_scale=scale;f.viewport.font_pixel_scale=2*scale;
    let w=GUI.label("label",10,10,"AB");w.w=120;w.h=60;
    for key in map_keys(options) {w[key]=options[key];}GUI.add(f,w);
    let calls=[];let rects=[];
    let win=map{clear:fn(c){},line:fn(a,b,c,d,e){},rect:fn(x,y,width,height,color){array_push(rects,map{x:x,y:y,w:width,h:height});}};
    if smooth {win.textAA=fn(x,y,text,color,size,advance){array_push(calls,map{x:x,y:y,text:text,size:size,advance:advance});return map{ok:true};};}
    GUI.draw(win,f);return map{calls:calls,rects:rects};
}
let legacy=draw(map{}).calls;
assert(len(legacy)==1 and legacy[0].size==18 and legacy[0].advance==12 and legacy[0].x==10,"unstyled native geometry remains identical");
let left=draw(map{font_size:18,text_align:"left"}).calls;
let center=draw(map{font_size:18,text_align:"center"}).calls;
let right=draw(map{font_size:18,text_align:"right"}).calls;
assert(left[0].y==8,"legacy styled label vertical geometry remains unchanged");
assert(left[0].x==10 and center[0].x==58 and right[0].x==106,"alignment uses actual fixed advance");
let large=draw(map{font_size:40,font_weight:"bold"}).calls;
assert(len(large)==2 and large[0].size==40 and large[1].x==large[0].x+1,"native AA size and synthetic bold");
let clipped=draw(map{font_size:40,font_weight:"bold",w:80,h:10});
assert(len(clipped.rects)>0 and len(clipped.calls)==0,"partial height uses clipped bitmap rendering");
for rect in clipped.rects {assert(rect.x>=10 and rect.x+rect.w<=90 and rect.y>=10 and rect.y+rect.h<=20,"short labels never escape their rectangle");}
let scaled=draw(map{font_size:24,h:80,w:200},true,2).calls;
assert(scaled[0].size==48,"explicit native size follows UI scale");
let short=draw(map{font_size:18,w:48,text_align:"right",text:"ABCDEFGHIJ"}).calls;
assert(short[0].text=="A..." and short[0].x==10,"ellipsis is aligned after fitting");
let bitmap=draw(map{font_size:18,text_align:"right"},false);
assert(len(bitmap.rects)>0,"bitmap fallback renders without native fonts");
for rect in bitmap.rects {assert(rect.x>=106 and rect.x+rect.w<=130,"bitmap uses the same alignment box");}
assert((try draw(map{font_size:100}) catch nil)==nil,"direct native styles enforce bounded size");
print "gui_typography_pass";
