// Test: pbAI-Max-oriented pblang LLM foundation layer.

let tok = import("stdlib:llm_tokenizer.sapp");
let ttrain = import("stdlib:llm_tokenizer_train.sapp");
let data = import("stdlib:llm_data.sapp");
let stream = import("stdlib:llm_stream.sapp");
let att = import("stdlib:llm_attention.sapp");
let train = import("stdlib:llm_train.sapp");
let eval = import("stdlib:llm_eval.sapp");
let weights = import("stdlib:llm_weights.sapp");
let quant = import("stdlib:llm_quant.sapp");
let binary = import("stdlib:llm_binary.sapp");
let offload = import("stdlib:llm_offload.sapp");

let records = [
    data.corpus_record("safe1.sapp", "fn add(a,b){return a+b;} fn main(){print add(1,1);}", "code"),
    data.corpus_record("credentials.json", "token=secret", "text")
];

let trun = ttrain.train_bpe_records(records, 80, 2, 2000);
assert(trun.summary.kind == "bpe", "corpus BPE training returns tokenizer");
assert(trun.skipped == 1, "tokenizer trainer skips secret records");
let q = data.record_quality(records[0]);
assert(q.keep and q.score > 0, "record quality keeps useful pblang code");
let fq = data.filter_quality_records(records);
assert(fq.kept == 1 and fq.skipped == 1, "quality filter keeps useful records and skips secret/noisy records");

let tokenizer = trun.tokenizer;
let ids = tok.encode(tokenizer, "fn add(a,b){return a+b;}", true, true);
let all_examples = data.lm_examples(ids, 4);
assert(len(all_examples) > 1, "large-model data path creates examples");
let examples = data.sample_stride(all_examples, 4);
assert(len(examples) <= len(all_examples) and len(examples) > 1, "diagnostic example sampling keeps a bounded representative subset");
let repeated = data.repeat_examples(examples, 3, 7);
assert(len(repeated) <= 7 and len(repeated) > len(examples), "curriculum repeat can boost high-signal examples within a cap");
let interleaved = data.interleave_priority_examples(examples, repeated, 2, 8);
assert(len(interleaved) <= 8 and len(interleaved) > len(examples), "curriculum interleave mixes priority examples into a bounded set");
let bsum = binary.tokenizer_summary(tokenizer);
assert(bsum.bit_width >= 1 and bsum.max_ids >= trun.summary.vocab_size, "binary token substrate computes enough bits for vocab IDs");
let bits = binary.id_to_bits(ids[0], bsum.bit_width);
assert(binary.bits_to_id(bits) == ids[0], "token IDs round-trip through binary bits");
let bfeatures = binary.token_binary_features(ids, trun.summary.vocab_size);
assert(bfeatures.bits == len(ids) * bsum.bit_width, "binary features see every token bit");
let bex = binary.binary_lm_examples(examples, trun.summary.vocab_size, 2);
assert(len(bex) == 2 and len(bex[0].y_bits) == bsum.bit_width, "LM examples expose x/y bit views");
let byte_bits = binary.text_to_byte_bits("pbAI");
assert(binary.byte_bits_to_text(byte_bits) == "pbAI", "byte-level data path round-trips text");

let st = stream.from_records([records[0]], 16, 8);
let ch1 = stream.next_chunk(st);
let ch2 = stream.next_chunk(st);
assert(not ch1.done and not ch2.done, "stream emits bounded chunks");
assert(stream.stats(st).emitted >= 2, "stream tracks emitted chunks");

let cfg = att.config(trun.summary.vocab_size, 8, 8, 16, 2, 2, 5);
let model = att.model_new(cfg);
let sum = att.summary(model);
assert(sum.layers == 2 and sum.heads == 2, "stacked multi-head model is configured");
assert(sum.binary_adapter and sum.binary_bit_width >= 1, "stacked model exposes binary token adapter");
assert(sum.live_mutable, "stacked model architecture is live-updatable");
assert(sum.growth_policy.enabled, "stacked model exposes controlled growth policy");
let bin_emb = att.binary_embedding(model, ids[0]);
assert(len(bin_emb) == cfg.d_model, "binary token embedding projects bits into hidden space");
let l = att.logits(model, examples[0].x);
assert(len(l) == trun.summary.vocab_size, "stacked decoder returns vocab logits");
let deeper = att.live_architecture_update(model, "deeper");
assert(deeper.action == "add_decoder_layer" and att.summary(model).layers == 3, "live architecture can add decoder layers");
let longer = att.live_architecture_update(model, "longer_context");
assert(longer.action == "extend_context" and att.summary(model).context == 16, "live architecture can extend context");
let old_scale = att.summary(model).binary_scale;
let stronger = att.live_architecture_update(model, "stronger_binary");
assert(stronger.action == "set_binary_scale" and att.summary(model).binary_scale > old_scale, "live architecture can adjust binary adapter strength");
let policy = att.set_growth_policy(model, map{ allowed_signals: ["stronger_binary", "weaker_binary"], target_valid_loss: 2.0 });
assert(policy.target_valid_loss == 2.0, "growth policy can be updated without disabling live growth");
let blocked = att.live_architecture_update(model, "deeper");
assert(blocked.action == "blocked", "growth policy can constrain manual architecture manipulation");
let directed = att.manipulate(model, map{ signal: "stronger_binary" });
assert(directed.action == "set_binary_scale", "manual NN manipulation uses the live growth gate");

let before = train.avg_loss(model, att.logits, examples);
let run = train.train_epochs(model, att.forward_hidden, examples, 2, 0.05);
let after = train.avg_loss(model, att.logits, examples);
assert(run.mode == "frozen-transformer-lm-head-backprop", "training mode is explicit");
assert(after <= before or run.final_loss > 0, "training/backprop path runs and reports loss");
let brun = train.train_binary_adapter_epochs(model, att.forward_hidden, examples, 1, 0.03, 0.01);
assert(brun.mode == "binary-adapter-analytic-backprop", "binary adapter has analytic backprop");
assert(brun.bit_width == bsum.bit_width and brun.examples == len(examples), "binary adapter training reports bit width and examples");
let deep = train.train_analytic_deep_inputs(model, att.forward_hidden, examples, 1, 0.02, 0.004, 0.004, 3);
assert(deep.mode == "analytic-input-embedding-binary-backprop", "deep input training uses analytic gradients instead of finite differences");
assert(deep.steps > 0 and deep.traces[0].updated_token_embeddings > 0, "analytic deep input training updates embedding state");
let split = data.split_bounded(all_examples, 0.25, 3, 1);
assert(split.original_train >= split.sampled_train and split.original_valid >= split.sampled_valid, "bounded split reports original and sampled sizes");
let er = train.error_report(model, att.logits, split.train, split.valid);
assert(er.valid_examples > 0 and er.train_examples > 0, "error report measures train and validation splits");
let adap = train.adaptive_error_reduction(model, att.forward_hidden, att.logits, att.live_architecture_update, split.train, split.valid, 1, 0.02, 0.01);
assert(adap.mode == "train-measure-grow" and len(adap.traces) == 1, "adaptive error reduction trains then applies controlled growth");
let fb = train.feedback_loop(model, att.forward_hidden, att.logits, att.live_architecture_update, split.train, split.valid, 1, 0.02, 0.01);
assert(fb.mode == "measure-train-feedback-grow" and len(fb.traces) == 1, "feedback loop measures error then applies gated growth");
assert(fb.traces[0].before_state.format == "pblang.llm.feedback_state.v1", "feedback loop keeps current feedback state");
assert(fb.traces[0].after_state.format == "pblang.llm.feedback_state.v1", "feedback loop keeps post-feedback state");
assert(fb.traces[0].evaluation.format == "pblang.llm.feedback_evaluation.v1", "feedback loop evaluates successful or failed feedback");
assert(fb.traces[0].evaluation.reinforcement.format == "pblang.llm.reinforcement.v1", "feedback comparison produces reward/punish signal");
let guesses = train.guess_candidates(model, er);
assert(len(guesses) == 4, "guessing loop can build growth candidates");
let guess = train.choose_guess(guesses);
assert(guess.signal != "", "guessing loop chooses a candidate signal");
let gl = train.guessing_loop(model, att.logits, att.live_architecture_update, split.train, split.valid, 1);
assert(gl.mode == "guess-policy-gated-growth" and len(gl.traces) == 1, "guessing loop applies policy-gated candidate growth");
assert(gl.traces[0].before_state.format == "pblang.llm.guess_state.v1", "guessing loop keeps current guess state");
assert(gl.traces[0].after_state.format == "pblang.llm.guess_state.v1", "guessing loop keeps post-guess state");
assert(gl.traces[0].evaluation.format == "pblang.llm.guess_evaluation.v1", "guessing loop evaluates successful or failed guesses");
assert(gl.traces[0].evaluation.reinforcement.action == "reward" or gl.traces[0].evaluation.reinforcement.action == "punish" or gl.traces[0].evaluation.reinforcement.action == "neutral", "guess comparison produces reward/punish/neutral signal");
let elite = train.select_elite(fb, gl, 1);
assert(elite.format == "pblang.llm.elite_selection.v1", "elite selection is versioned");
assert(len(elite.kept) == 1, "elite selection keeps the best candidate");
assert(len(elite.candidates) >= len(elite.kept), "elite selection ranks all candidates");

let ev = eval.evaluate(model, att.logits, examples);
assert(ev.examples == len(examples), "eval suite counts bounded diagnostic examples");
assert(ev.perplexity > 0, "eval suite computes perplexity");
let seq_ev = eval.sequence_evaluate(model, att.logits, ids, 4);
assert(seq_ev.format == "pblang.llm.sequence_eval.v1" and seq_ev.examples > 0, "eval suite can score a generated/id sequence");
assert(seq_ev.tokens == len(ids) and seq_ev.perplexity > 0, "sequence eval reports token count and perplexity");
let bench = eval.benchmark_generate(model, att.generate, examples[0].x, 2, 1);
assert(bench.tokens == 2, "generation benchmark counts tokens");
let penalized = att.repetition_penalized_logits([0.1, 0.9, 0.2], [1, 1, 1, 1], 8, 0.5, 4);
assert(penalized[1] < -1000000, "safe generation can hard-block a repeated tail token");
let safe_gen = att.generate_safe(model, examples[0].x, 4, 8, 0.5, 3);
assert(len(safe_gen) == len(examples[0].x) + 4, "safe generation appends requested tokens");
let qbad = eval.generation_quality("fn ", "fn /////////", ["fn"], ["<unk>"], 2, 4);
assert(not qbad.passed and qbad.repetition_run > 4, "generation quality rejects collapsed text");
let qok = eval.generation_quality("fn ", "fn add(a,b)", ["fn"], ["<unk>"], 2, 4);
assert(qok.passed and qok.normalized > qbad.normalized, "generation quality rewards non-collapsed text");
let noisy_shape = eval.text_shape("fn re///pbai");
let clean_shape = eval.text_shape("fn add(a,b) { return a + b; }");
assert(clean_shape.format == "pblang.llm.text_shape.v1" and clean_shape.score > noisy_shape.score, "text shape rewards cleaner pblang-like code");
let proxy = eval.regression_proxy(4.2, "validation-only-quick-screen");
assert(proxy.format == "pblang.llm.regression_proxy.v1" and proxy.cases == 0, "quick regression proxy avoids generation work");
let selection = eval.selection_score(4.2, map{ pass_rate: 1.0, average_score: 0.5, failed: 0 });
assert(selection.format == "pblang.llm.selection_score.v1" and selection.score < 4.2, "selection score combines validation and regression quality");
let choice = eval.choose_generation("fn ", ["fn /////////", "fn add(a,b)"], ["fn"], ["<unk>"], 2, 4);
assert(choice.format == "pblang.llm.generation_choice.v1" and choice.best_index == 1, "generation chooser keeps the best scored candidate");
assert(choice.best_quality.passed and len(choice.candidates) == 2, "generation chooser returns scored candidates");

let man = weights.manifest(model, trun.summary, "pbAI-Max-test", "pbAI-Max");
assert(man.format == "pblang.llm.weights.manifest.v1", "weight manifest is versioned");
let shards = weights.split_model(model);
let joined = weights.join_model(man, shards);
assert(weights.estimate_params(joined) > 0, "weight format can split/join model shards");
assert(len(joined.binary_projection) == bsum.bit_width, "weight format preserves binary projection shard");

let layer_plan = [
    offload.layer("embed", 100, 10, "cpu"),
    offload.layer("block0", 180, 20, "gpu"),
    offload.layer("block1", 180, 20, "gpu"),
    offload.layer("head", 90, 10, "cpu")
];
let kv_bytes = offload.kv_cache_bytes(8, len(layer_plan), 2, 4, 2);
let off_cfg = offload.config(1600, kv_bytes, 1, 1, 1);
let off_plan = offload.plan(layer_plan, off_cfg);
assert(off_plan.format == "pblang.llm.offload.plan.v1", "AirLLM-style offload plan is versioned");
assert(off_plan.streamed_layers > 0 and off_plan.fits_budget, "offload planner streams layers within a memory budget");
let off_summary = offload.summarize(off_plan);
assert(off_summary.kv_cache_bytes == kv_bytes, "offload planner reserves KV cache memory");
let off_mb = offload.microbatch_capacity(off_cfg, 100, 1, 8);
assert(off_mb > 0, "offload planner suggests a bounded microbatch size");

let hidden = att.forward_hidden(model, examples[0].x);
let last = hidden[len(hidden) - 1];
let qh = quant.quantize_lm_head(model, 8);
let qlog = quant.logits_q(last, qh);
assert(len(qlog) == trun.summary.vocab_size, "quantized LM head returns vocab logits");

let gcfg = att.gemma3_config(trun.summary.vocab_size, 16, 8, 16, 4, 4, 2, 3, 4, 19);
let gplan = att.attention_plan(gcfg);
assert(gplan.format == "pblang.llm.attention_plan.v1", "Gemma-style attention plan is versioned");
assert(gplan.family == "gemma3-style-local-global-gqa" and gplan.kv_heads == 2, "Gemma-style plan exposes grouped-query KV heads");
assert(gplan.layers[0].attention == "local" and gplan.layers[3].attention == "global", "Gemma-style plan mixes local layers with periodic global layers");
let gmodel = att.model_new(gcfg);
let gout = att.logits(gmodel, examples[0].x);
assert(len(gout) == trun.summary.vocab_size and att.summary(gmodel).attention_plan.layers[0].attention == "local", "Gemma-style local/global attention runs through logits");
let g4 = att.gemma4_config("Gemma4-style-E2B", trun.summary.vocab_size, 32, 8, 16, 4, 4, 23, map{
    kv_heads: 2,
    local_window: 8,
    global_every: 4,
    ple_dim: 2,
    total_params: 2000,
    active_params: 1000,
    experts: 4,
    active_experts: 1,
    modalities: ["text", "image", "audio"],
    draft_tokens: 3,
    accept_rate: 0.5
});
assert(g4.format == "pblang.llm.gemma4_style.config.v1" and g4.system_prompt_support, "Gemma 4 style config exposes native system-prompt support");
assert(g4.ple_params == trun.summary.vocab_size * 4 * 2, "Gemma 4 style config accounts for per-layer embeddings");
assert(g4.moe.loaded_to_active_ratio == 2 and g4.mtp.expected_tokens_per_verify == 2.5, "Gemma 4 style config exposes MoE and MTP planning");
let sys_turn = att.system_prompt_turn("be concise", "explain pblang", true);
assert(str_contains(sys_turn.text, "<|think|>") and sys_turn.thinking, "system prompt helper can enable thinking token flow");
let mm = att.multimodal_projection_plan("image", 16, 8, 4);
assert(mm.projection_params == 128 and mm.output_shape[1] == 8, "multimodal projection planner maps input features into model space");

let tq = quant.turboquant_mse([1.0, -2.0, 0.5, 0.25], 4, 11);
let tqv = quant.turboquant_dequantize(tq);
let tqe = quant.turboquant_error([1.0, -2.0, 0.5, 0.25], tq);
assert(tq.format == "pblang.llm.turboquant_mse.v1" and len(tqv) == 4, "TurboQuant-style MSE helper compresses and reconstructs vectors");
assert(tqe.mse >= 0 and tqe.max_error >= 0, "TurboQuant-style error report is bounded and versioned");
let qjl = quant.qjl_residual_signs([1.0, -2.0, 0.5, 0.25], tq, 6);
assert(qjl.format == "pblang.llm.qjl_residual_signs.v1" and len(qjl.signs) == 6, "TurboQuant-style QJL residual sketch stores one-bit signs");
let tqprod = quant.turboquant_prod([1.0, -2.0, 0.5, 0.25], 4, 11, 6);
assert(tqprod.format == "pblang.llm.turboquant_prod.v1" and tqprod.residual.sketch_dim == 6, "TurboQuant product mode carries base quantizer plus residual sketch");
let tqc = quant.turboquant_compression(tq, 4);
assert(tqc.format == "pblang.llm.turboquant_compression.v1" and tqc.ratio > 0, "TurboQuant-style compression report exposes ratio");
let tv = quant.turbovec_index([[1.0, 0.0], [0.0, 1.0], [0.8, 0.1]], 4, 7);
let tvs = quant.turbovec_search(tv, [1.0, 0.0], 2);
assert(tvs.format == "pblang.llm.turbovec.search.v1" and len(tvs.results) == 2, "TurboVec-style compressed vector search returns top-k results");
let tv2 = quant.turbovec_new(nil, 4, true);
let add = quant.turbovec_add_with_ids(tv2, [[1.0, 0.0], [0.0, 1.0], [0.8, 0.1]], [1001, 1002, 1003]);
assert(add.added == 3 and tv2.dim == 2, "TurboVec-style index supports online add with lazy dimension lock");
let allow = quant.turbovec_search(tv2, [1.0, 0.0], 5, [1003], nil);
assert(allow.effective_k == 1 and allow.results[0].id == 1003, "TurboVec-style search honors stable-id allowlists");
let masked = quant.turbovec_search(tv2, [1.0, 0.0], 5, nil, [true, false, true]);
assert(masked.effective_k == 2, "TurboVec-style search honors slot masks");
let rem = quant.turbovec_remove(tv2, 1002);
assert(rem.removed and not map_has(tv2.id_to_slot, "1002"), "TurboVec-style stable-id remove updates id map");
let man2 = quant.turbovec_manifest(tv2, "idmap");
assert(man2.magic == "TVIM" and man2.has_tqplus, "TurboVec-style manifest exposes id-map and TQ+ metadata");
let sw = quant.turbovec_swap_remove(tv2, 0);
assert(sw.removed and len(tv2.items) == 2, "TurboVec-style positional swap_remove shrinks index");

print "llm_max_foundation_pass";
