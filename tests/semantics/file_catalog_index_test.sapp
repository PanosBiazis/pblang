for rule in expected {
 for name in [rule[0],"sample"+rule[0],str_upper("sample"+rule[0]),"nested/sample"+rule[0],"δείγμα"+rule[0]] {
  let actual=C.classify(name);
  assert(actual.known and actual.suffix==rule[0] and actual.label==rule[1] and actual.family==rule[2],"baseline rule parity");
 }
}
for name in ["archive.tar.gz",".tar.gz","archive.tar.bz2","archive.tar.xz","module.d.ts",".d.ts"] {
 let x=C.classify(name);assert(x.known,"multipart known");
 assert(x.suffix!=".gz" and x.suffix!=".bz2" and x.suffix!=".xz" and x.suffix!=".ts","specific suffix wins");
}
assert(C.classify("CMakeLists.txt").label=="Build Configuration","special precedes txt");
for name in ["README",".unknown","trailing.","sample.unknown"] {assert(not C.classify(name).known,"unknown preserved");}
let changed=C.classify("one.sapp");changed.label="changed";changed.suffix=".changed";
assert(C.classify("two.sapp").label=="PBLang Source","results never alias rules");
let long_name=str_repeat("a",4000)+".sapp";
assert(C.classify(long_name).known,"long valid basename");
assert(C.classify(str_repeat(".",4094)+"py").label=="Python Source","dot-heavy name");
assert(not C.classify("name."+str_repeat("z",100)).known,"suffix longer than every rule");
assert(C.classify(str_repeat("/",4089)+"main.py").name=="main.py","separator-heavy path");
print "file_catalog_index_pass";
