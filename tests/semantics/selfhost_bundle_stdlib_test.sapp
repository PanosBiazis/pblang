let Bundle = import("stdlib/selfhost_bundle.sapp");
let PBCK = import("stdlib/selfhost_pbck.sapp");

fn fail(message) { throw "FAIL selfhost_bundle_stdlib: " + message; }
fn require(condition, message) { if not condition { fail(message); } }

let main_path = "/tmp/pblang-selfhost-bundle-stdlib-main.sapp";
fs_write(main_path,
    "let D = import(\"stdlib:compiler/diagnostic_suggestions.sapp\");\n"
        + "print len(D);\n");
let bundled = Bundle.bundle_file(main_path);
if not bundled.ok {
    fail("filesystem bundler resolves canonical stdlib imports: "
        + str(bundled.reason));
}
require(bundled.modules == 1,
    "filesystem bundler resolves one canonical stdlib module");

let comments = Bundle.bundle(
    "// import(\"fake-cycle.sapp\")\n"
        + "let example = \"import(\\\"fake-string.sapp\\\")\";\n"
        + "print 42;",
    fn(path) { throw "comment/string import reached resolver: " + path; }
);
require(comments.ok and comments.modules == 0,
    "dependency scan ignores imports inside comments and strings");
let output = "/tmp/pblang-selfhost-bundle-stdlib.pbck";
try fs_remove(output) catch nil;
let wrote = Bundle.write_bundle_selfhost(main_path, output);
require(wrote.ok and fs_exists(output) and wrote.bytes > 8,
    "canonical stdlib module graph publishes as bounded PBCS");
let decoded = PBCK.read_file(output);
require(len(decoded.instructions) > 0 and len(decoded.constants) > 0,
    "published compiler bundle round-trips");
fs_remove(output);
fs_remove(main_path);

print "selfhost_bundle_stdlib_pass";
