let AI=import("stdlib/pbai.sapp");
let N=import("stdlib:pbai_neural_adapter.sapp");
let B=import("stdlib:pbai_specialist_binding.sapp");
let wrong=import("stdlib:pbai_sensor.sapp");
let incomplete=import("tests/fixtures/pbai_specialist_noncallable.sapp");
let inert=import("tests/fixtures/pbai_specialist_bind_no_calls.sapp");
fn rejects(f) {return try {f();false} catch true;}
assert(rejects(fn(){throw "expected";}) and not rejects(fn(){return 1;}),"calibrated rejection helper");
fn same(a,b) {return json_stringify(a)==json_stringify(b);}
assert(len(AI.neural_specialist_bind(inert))==15 and len(B.bind(inert))==15,"binding never calls provider exports, including a compatible inert module");
let bound=AI.neural_specialist_bind(N);let direct=B.bind(N);
let report=bound.report();let text=json_stringify(report);
assert(same(report,direct.report()) and len(report.operations)==14 and len(bound)==15,"fixed computational surface and shared binder parity");
assert(report.exports_checked and not report.provider_authenticated and not report.numeric_inference_checked
 and not report.provider_called_during_bind and not report.automatic_training and not report.automatic_persistence
 and not report.globally_activated and not report.authorizes_action,"report makes only structural binding claims");
let called=false;let callback=fn(){called=true;return N;};let fake=map{};
for name in report.operations {fake[name]=callback;}
let cycle=[];push(cycle,cycle);let invalid=0;
for bind in [B.bind,AI.neural_specialist_bind] {
 for bad in [nil,true,7,"synthetic-private-provider-path",[],cycle,map{},fake,callback,wrong,incomplete] {
  assert(rejects(fn(){bind(bad);}),"invalid or incompatible provider has no usable binding");invalid=invalid+1;
 }
}
assert(invalid==22 and not called,"no map or callback evaluated during admission");
report.operations[0]="forged";report.provider_authenticated=true;
assert(json_stringify(bound.report())==text,"fixed detached report survives mutation");
assert(not map_has(bound,"student_save_new") and not map_has(bound,"student_load_file"),"file APIs are outside the computation binding");
let train=[map{x:[0],y:4}];let valid=[map{x:[7,0],y:4}];
let teacher=bound.train(train,valid);assert(same(teacher,N.train(train,valid)),"same explicit training and options defaults");
assert(same(bound.predict(teacher.artifact,[0]),N.predict(teacher.artifact,[0])),"teacher prediction parity");
let bound_session=bound.session(train,valid);let direct_session=N.session(train,valid);
assert(same(bound_session.status(),direct_session.status()),"session parity");
assert(bound_session.close() and direct_session.close(),"both session callers release their handles");
let student=bound.distill(teacher.artifact,[[0],[1,0]],valid);let checkpoint=student.checkpoint();
assert(same(checkpoint,N.distill(teacher.artifact,[[0],[1,0]],valid).checkpoint()),"distillation parity");
assert(same(bound.distill_supervised(teacher.artifact,train,valid).checkpoint(),N.distill_supervised(teacher.artifact,train,valid).checkpoint()),"supervised distillation parity");
let encoded=bound.student_encode(checkpoint);assert(encoded==N.student_encode(checkpoint),"checkpoint encode parity");
assert(same(bound.student_decode(encoded),checkpoint),"checkpoint decode parity");
assert(same(bound.student_load(checkpoint).predict([5,0]),N.student_load(checkpoint).predict([5,0])),"loaded inference parity");
let next_train=[map{x:[2,0],y:4},map{x:[3,0],y:4}];let next_valid=[map{x:[4,0],y:4}];
assert(same(bound.student_continue(checkpoint,next_train,next_valid).checkpoint(),N.student_continue(checkpoint,next_train,next_valid).checkpoint()),"diagnostic continuation parity");
let history=bound.student_history(checkpoint,[map{x:[0],y:4},map{x:[1,0],y:4}],valid);
assert(same(history,N.student_history(checkpoint,[map{x:[0],y:4},map{x:[1,0],y:4}],valid)),"history parity");
let history_text=bound.student_history_encode(checkpoint,history);
assert(history_text==N.student_history_encode(checkpoint,history) and same(bound.student_history_decode(checkpoint,history_text),history),"history codecs parity");
let reviewed=bound.student_continue_reviewed(checkpoint,history,next_train,next_valid);
assert(same(reviewed.report(),N.student_continue_reviewed(checkpoint,history,next_train,next_valid).report()),"review parity");
assert(reviewed.report().passed and reviewed.accept().phase=="accepted" and reviewed.rollback().phase=="rolled-back","bound review keeps acceptance and rollback");
assert(reviewed.close() and rejects(fn(){reviewed.predict([5,0]);}),"bound review keeps terminal close");
let request=map{op:"predict_batch",checkpoint:checkpoint,contexts:[[0],[5,0]],include_logits:true};
assert(same(bound.student_tool(request),N.student_tool(request)),"student tool numeric parity");
assert(json_stringify(bound.report())==text,"binding report neither trains nor changes across explicit operations");
print "pbai_specialist_binding_pass:14:22";
