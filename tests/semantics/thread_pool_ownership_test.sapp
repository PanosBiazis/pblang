let T=import("stdlib:thread.sapp");
for size in [nil,0,-1,1,2,20] {
    let values=[nil,false,0,map{__tp_stop:true},map{__tp_value:8},map{value:9}];
    let out=T.thread_pool(size,values,fn(x){return x;});
    assert(len(out)==len(values),"all values retained");
    for value in values {
        let found=false;
        for result in out {if json_stringify(value)==json_stringify(result) {found=true;}}
        assert(found,"nil and envelope-shaped data survive");
    }
}
for size in [0.5,1.5,true,"2",num_exp(1000),num_sqrt(-1)] {
    assert((try {T.thread_pool(size,[1],fn(x){return x;});false} catch true),"invalid count rejected");
}
assert(len(T.thread_pool(4,[],fn(x){return x;}))==0,"empty pool");
// Transfer failure is detected before a mapper can run.
let effects=channel_buffered(2);
fn mapper_with_effect(sender) {return fn(v){send(sender,true);return v;};}
assert((try {T.thread_pool(2,[1,fn(){return 2;}],mapper_with_effect(effects.sender));false} catch true),"bad task transfer");
assert(channel_size(effects.receiver)==0,"no worker launched for bad transfer");
channel_close(effects.sender);

// A failed worker must not cause return while its sibling still works.
fn failure_mapper(sender, transfer_failure) {
    return fn(v) {
        if v==0 {
            if transfer_failure {return fn(){return 1;};}
            throw "private-task-detail";
        }
        sleep_ms(80);
        send(sender,true);
        return v;
    };
}
for transfer_failure in [false,true] {
    let done=channel_buffered(1);
    assert((try {T.thread_pool(2,[0,1],failure_mapper(done.sender,transfer_failure));false} catch true),"pool failure");
    assert(recv_timeout(done.receiver,0)==true,"sibling completed before failure returned");
    channel_close(done.sender);
}
assert(T.thread_pool(1,[3],fn(x){return x+1;})[0]==4,"reusable after failure");
print "thread_pool_ownership_pass";
