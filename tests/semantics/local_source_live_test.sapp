if platform() != "linux" { print "local_source_live_skip_linux_required"; os_exit(0); }
let C = import("stdlib:compiler/ctranspile.sapp");
let UUID = import("stdlib:uuid.sapp");
let binary = env_get("PBLANG_BIN") ?? path_join(cwd(), "target/release/pblang");
let base = "/tmp/pblang_local_source_" + UUID.v4();
let source_path = base + ".sapp"; let output = base + ".out";
fn cleanup() { for path in [source_path, output, output + ".c"] { try fs_remove(path) catch nil; } }
fn child(extra) {
    let args = ["-k","1s","30s",binary,"run","tools/pbi.sapp","--allow-all","--",source_path];
    for item in extra { array_push(args,item); }
    return proc_spawn_wait("/usr/bin/timeout",args);
}
fn exercise() {
    // Above both former direct limits, with real statements rather than just comments.
    let source = str_repeat(" ",1048576) + str_repeat("0;",33000) + "print 42;";
    fs_write(source_path,source);
    let local = child([]);
    assert(local.exit_code==0 and local.stdout=="42\n", "large local pbi execution");
    let constrained = child(["--max-source-bytes=1048576"]);
    assert(constrained.exit_code==1 and constrained.stdout=="", "explicit byte cap rejects before print");
    let token_limited = child(["--max-tokens=65536"]);
    assert(token_limited.exit_code==1 and token_limited.stdout=="", "explicit token cap rejects before print");
    let built = C.build_program(source,output,map{admission:"local",profile:"portable"});
    assert(built.ok and built.source_admission=="local", "large local C99 build");
    let executed = proc_spawn_wait("/usr/bin/timeout",["-k","1s","8s",output]);
    assert(executed.exit_code==0 and executed.stdout=="42\n", "generated C99 artifact execution");
    let run = C.run_program("print 42;",map{admission:"local",source_budget:map{max_tokens:4},profile:"portable"});
    assert(run.ok and run.stdout=="42\n" and run.build.source_admission=="local","runner forwards local admission");
    assert(not C.run_program("print 42;",map{admission:"local",source_budget:map{max_tokens:2}}).ok,
        "runner forwards exhausted budget");
    assert(not C.run_program("print 42;",map{source_budget:map{max_tokens:4}}).ok,
        "runner rejects strict source budget");
    fs_write(output,"old output"); fs_write(output+".c","old C");
    for options in [map{admission:"local",source_budget:map{max_source_bytes:1}},
        map{admission:"local",source_budget:map{max_tokens:1}},
        map{admission:"local",modules:map{}},map{admission:"unknown"},
        map{source_budget:map{max_tokens:1}}] {
        assert(not C.build_program("print 42;",output,options).ok,"invalid or exhausted build policy rejects");
        assert(fs_read(output)=="old output" and fs_read(output+".c")=="old C","old artifacts preserved");
    }
    fs_write(source_path,str_repeat(" ",1048576)+"print 42; /* private_canary");
    let malformed = child([]);
    assert(malformed.exit_code==1 and malformed.stdout=="","large malformed source has no print effect");
    assert(str_contains(malformed.stderr,"checked_source: invalid or unterminated token")
        and not str_contains(malformed.stderr,"private_canary"),"fixed local lexical diagnostic");
    for flags in [["--max-tokens=0"],["--max-tokens=NaN"],["--max-tokens=2x"],
        ["--max-tokens=2","--max-tokens=3"],["--unknown"]] {
        let rejected = child(flags); assert(rejected.exit_code==2,"CLI rejects invalid budget options");
    }
    fs_write(source_path,"print 42;");
    let exact = child(["--max-source-bytes=9","--max-tokens=4"]);
    assert(exact.exit_code==0 and exact.stdout=="42\n","inclusive CLI byte and token budget");
}
let passed = try { exercise(); true } catch false;
cleanup(); assert(passed,"local source live regression");
print "local_source_live_pass";
