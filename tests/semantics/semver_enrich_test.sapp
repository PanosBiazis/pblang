// tests/semantics/semver_enrich_test.sapp — enrichment for stdlib/semver.sapp

let S = import("stdlib/semver.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn arreq(a, b, m) {
    if len(a) != len(b) { fail(m + " len " + str(a)); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " [" + str(i) + "] " + str(a)); } i = i + 1; }
}

// ── is_stable ─────────────────────────────────────────────────────────────────────
if not S.is_stable("1.2.3") { fail("1.2.3 stable"); }
if S.is_stable("1.0.0-rc1") { fail("rc1 not stable"); }
if S.is_stable("not.a.version") { fail("invalid not stable"); }

// ── max / min ─────────────────────────────────────────────────────────────────────
eq(S.max(["1.0.0", "2.3.1", "2.3.0"]), "2.3.1", "max");
eq(S.min(["1.0.0", "2.3.1", "0.9.9"]), "0.9.9", "min");
eq(S.max([]), nil, "max empty -> nil");

// ── sort (ascending) ──────────────────────────────────────────────────────────────
arreq(S.sort(["2.0.0", "1.0.0", "1.5.0"]), ["1.0.0", "1.5.0", "2.0.0"], "sort asc");

print "semver_enrich_pass";
