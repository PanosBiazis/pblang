let S=import("stdlib:slide_document.sapp"); let D=import("stdlib:text_document.sapp"); let V=import("stdlib:slide_view.sapp"); let UI=import("stdlib:modern_ui.sapp"); let G=import("stdlib:gui.sapp");
let d=S.create("Example"); d=S.set_slide(d,0,"First",["One","Two"],"speaker marker");
let detached=S.copy(d); detached.slides[0].lines[0]="Changed"; assert(d.slides[0].lines[0]=="One","deep copy");
d=S.insert(d,1); d=S.set_slide(d,1,"Second",["Different content"]);
assert(S.move(d,1,0).slides[0].title=="Second" and d.slides[0].title=="First","reorder detached");
assert(len(S.remove(d,0).slides)==1,"delete");
assert(S.encode(S.decode(S.encode(d)))==S.encode(d),"roundtrip");
let form=UI.build("Test",V.create(d),map{width:1100,height:1000}); G.get(form,"select_slide_1").onclick(form);
assert(G.get(form,"slide_line_0").text=="Second" and G.get(form,"slide_line_3").text=="","slide selection clears stale rows");
assert(not str_contains(json_stringify(V.create(d)),"speaker marker"),"speaker notes excluded from reader");
for i in range(2,8) { d=S.insert(d,i); }
assert(UI.validate(V.create(d)).ok and UI.validate(V.create(d)).actions==112,"full deck fits portable action budget");
for target in ["native","web","android"] { assert(len(UI.compile(V.create(d),map{target:target,width:412,height:915}).records)>0,"all view targets"); }
for op in [fn(){S.insert(d,8);},fn(){S.move(d,-1,0);},fn(){S.set_slide(d,0,"",[]);},fn(){S.set_slide(d,0,"Title",[str_repeat("x",81)]);},fn(){S.remove(S.create(),0);},fn(){S.decode("{\"format\":1,\"format\":2}");}] { assert((try op() catch "bad")=="bad","bounds and malformed data"); }
let notes=D.set_block(D.create("Notes"),0,"heading","Question"); notes=D.insert_block(notes,1,"paragraph","Answer");
assert(S.from_document(notes).slides[0].lines==["Answer"],"Writer conversion");
notes=D.insert_block(notes,2,"paragraph",str_repeat("a",401));
assert((try S.from_document(notes) catch "bad")=="bad","oversize sections refused rather than truncated");
print "slide_document_pass";
