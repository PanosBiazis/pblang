// tests/semantics/spawn_wire_cycle_test.sapp
// Returning a cyclic value from a spawned thread must surface as a *catchable* error,
// not a process abort. Regression: spawn's wire serializer recursed without a depth
// bound, so a cyclic structure (e.g. a symbol table with parent back-pointers) blew
// the thread stack and aborted the whole process with "stack overflow, aborting".
// The serializer now caps recursion depth and returns an ordinary error instead.

fn fail(m) { throw "FAIL " + m; }

// Self-referential array: cyclic[1] points back at cyclic itself.
let cyclic = [];
array_push(cyclic, 1);
array_push(cyclic, cyclic);

let h = try spawn(fn() { return cyclic; }) catch "SPAWN_REJECTED";
let r = try join(h) catch "CAUGHT_ERROR";
// We don't care whether rejection happens at spawn or join time — only that it is
// caught and the process is still alive to run the next line.
if r != "CAUGHT_ERROR" and r != "SPAWN_REJECTED" {
    fail("expected a caught error for cyclic spawn value, got " + str(r));
}

// A normal (acyclic) value must still round-trip through spawn/join unchanged.
let ok = join(spawn(fn() { return [1, 2, 3]; }));
if len(ok) != 3 or ok[0] != 1 or ok[2] != 3 { fail("acyclic spawn round-trip broken"); }

print "spawn_wire_cycle_pass";
