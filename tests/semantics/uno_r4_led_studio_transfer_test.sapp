let M=import("../../examples/uno_r4_led_studio/model.sapp");
let D=import("../../examples/uno_r4_led_studio/device_export.sapp");
let C=import("../../examples/uno_r4_led_studio/device_control.sapp");
let W=import("../../examples/uno_r4_led_studio/web.sapp");
let initial=M.create();let plan=D.plan(initial.document,1);let changed=M.create();M.apply(changed,"preset","border");
let sim=map{hardware:plan,target:nil,phase:"idle",fail_stop:false,lost:false,sends:0};let calls=[];
fn runner(p,port,command,confirmed){
    push(calls,command);if p.digest!=sim.hardware.digest or sim.lost or (command=="STOP" and sim.fail_stop) {return map{ok:false};}
    return map{ok:true,reply:map{state:if command=="PLAY" {"running"} else {"idle"},frame:if command=="PLAY" {1} else {0},remaining_ms:0}};
}
fn progress(complete,upload=false){return map{ok:true,complete:complete,cleanup_confirmed:complete,phase:sim.phase,upload_attempted:upload,message:sim.phase};}
let upload=map{confirm:fn(p){return map{ok:false};},start:fn(p,stopped){assert(stopped,"stop required");sim.target=p;sim.phase="compiling";return progress(false);},poll:fn(){if sim.phase=="compiling" {sim.phase="uploading";return progress(false,true);}sim.hardware=sim.target;sim.phase="done";return progress(true,true);},cancel:fn(){sim.phase="failed";return progress(true);}};
let c=C.create(plan,"/dev/ttyACM0",true,runner,upload);
assert(not c.action(changed.document,"PLAY").ok and len(calls)==0,"mismatch never plays stale frames");
sim.fail_stop=true;assert(not c.action(changed.document,"UPLOAD").ok and sim.target==nil,"unconfirmed stop blocks flash");sim.fail_stop=false;
assert(c.action(changed.document,"UPLOAD").ok and sim.phase=="compiling","explicit send begins after stop");
let count=len(calls);assert(not c.action(changed.document,"PLAY").ok and len(calls)==count,"busy play blocked");
assert(not c.action(changed.document,"UPLOAD").ok and len(calls)==count,"busy duplicate upload blocked");
c.action(changed.document,"STATUS");assert(sim.phase=="uploading","check advances compile to upload");
let r=c.action(changed.document,"STATUS");assert(r.ok and str_contains(r.message,"uploaded and confirmed"),"new identity confirmed after upload");
assert(str_contains(r.message,"checkpoint failed"),"failed checkpoint map is not treated as success");
assert(c.action(changed.document,"PLAY").ok and calls[len(calls)-1]=="PLAY","new project can play only after confirmation");
assert(not c.action(initial.document,"PLAY").ok,"old editor does not play new installed frames");
c.action(initial.document,"UPLOAD");r=c.action(initial.document,"STOP");assert(r.ok and sim.phase=="failed","stop cancels compile then clears board");
c.action(initial.document,"UPLOAD");c.action(initial.document,"STATUS");sim.lost=true;
r=c.action(initial.document,"STATUS");assert(not r.ok and str_contains(r.message,"not confirmed"),"sim.lost post-upload handshake is uncertain");
assert(not c.action(initial.document,"PLAY").ok,"unverified new firmware cannot play");sim.lost=false;
assert(c.action(initial.document,"STATUS").ok,"later explicit check recovers matching new identity");
assert(c.action(initial.document,"PLAY").ok,"recovered identity allows play");
// Snapshot bound sends reject another view's edits, while independent Stop works.
fn req(method,path="/",body=""){return map{method:method,path:path,body:body,headers:map{host:"127.0.0.1:8768",origin:"http://127.0.0.1:8768","content-type":"application/x-www-form-urlencoded"}};}
fn hidden(p,key){return str_split(str_split(p,"name=\""+key+"\" value=\"")[1],"\"")[0];}
fn device(p,action){let f=str_split(str_split(p.body,"class=\"device-controls\"")[1],"</form>")[0];return req("POST",str_split(str_split(f,"action=\"")[1],"#")[0],"csrf="+hidden(f,"csrf")+"&revision="+hidden(f,"revision")+"&action="+action);}
let app=W.create(8768,map{hide_source_names:false,discourage_scraping:false},map{supports_upload:true,action:fn(d,cmd){if cmd=="UPLOAD" {sim.sends=sim.sends+1;}return map{ok:true,message:"confirmed"};}});
let a=app.handle(req("GET"));let send=device(a,"device_upload");assert(str_contains(a.body,"Send current project"),"opt-in upload exposed");
let f=str_split(str_split(a.body,"id=\"led-editor\"")[1],"</form>")[0];
let b=app.handle(req("POST","/action","csrf="+hidden(f,"csrf")+"&revision="+hidden(f,"revision")+"&action=pixel_0&f_text=&f_duration=100"));
a=app.handle(send);assert(sim.sends==0 and str_contains(a.body,"Editor changed"),"stale send rejected before any effect");
a=app.handle(device(a,"device_upload"));assert(sim.sends==1,"fresh explicit send accepted");app.close();
print "uno_r4_led_studio_transfer_pass";
