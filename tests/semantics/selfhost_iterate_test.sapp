// Exercise the real functional library through the PBLang-written frontend/VM.
let FE = import("stdlib:compiler/selfhost_frontend.sapp");
let source = "let F = import(\"stdlib:functional.sapp\");"
    + "let seen = []; let next = fn(x) { push(seen,x); return x+1; };"
    + "let empty = F.iterate(next,1,0); let single = F.iterate(next,1,1);"
    + "let sequence = F.iterate(next,1,4);"
    + "let terminal = F.iterate(fn(x) { if x == 3 { throw 9; } return x+1; },1,3);"
    + "let mutations = map{n:0}; let borrowed = F.iterate(fn(x) { x.n = x.n+1; return x; },mutations,3);"
    + "let failed_calls = []; let outcome = try map{ok:true,value:F.iterate(fn(x) { push(failed_calls,x); if x == 2 { throw nil; } return x+1; },1,5)} catch map{ok:false};"
    + "let result = [empty,single,sequence,seen,terminal,mutations.n,len(borrowed),outcome.ok,failed_calls];";
let run = FE.frontend_run_bounded(source,map{max_steps:20000,max_frames:24,max_modules:8,max_source_bytes:32768});
if not run.ok { throw "FAIL selfhost-iterate: library import/execution"; }
if run.globals.result != [[],[1],[1,2,3,4],[1,2,3],[1,2,3],2,3,false,[1,2]] {
    throw "FAIL selfhost-iterate: result or callback effects";
}
print "selfhost_iterate_pass";
