// Complete DirFS module copies delegate only native effects to the counted model.
fn run(D, B, baseline = false, posix = false) {
    let count = 0;
    for wrote in [true, false] {
        let outcomes=if baseline {[true,false,nil,1]} else {[true,false,nil,1,"throw"]};
        for file_closed in outcomes {
            for parent_closed in outcomes {
                B.configure(wrote, file_closed, parent_closed);
                let fs = map{profile:D.profile("macos")};
                let r = D.write_new_exclusive(fs, "value", [206,177], false);
                assert(B.state.closes == [20,10], "each owned descriptor closed once in order");
                assert(B.state.writes == 1 and B.state.bytes == [206,177], "exact write once");
                let fc = type(file_closed)=="bool" and file_closed;
                let pc = type(parent_closed)=="bool" and parent_closed;
                assert(r.ok == (if baseline {wrote} else {wrote and fc and pc}), "no false success");
                assert(B.state.unlinks == (if baseline and not wrote {1} else {0}), "no implicit pathname rollback");
                if not baseline and not r.ok {
                    assert(r.write_completed==wrote and r.output_may_exist and r.publication_may_have_occurred,
                        "output existence is possible, never guaranteed");
                    assert(r.cleanup_uncertain and not r.retry_safe and not r.rollback_attempted and not r.rollback_complete,
                        "caller must stop; rollback not claimed");
                    assert(r.file_close_confirmed==fc and r.dirfs_parent_close_confirmed==pc,"separate close states");
                    if not wrote {assert(r.error=="exclusive destination write failed; output may remain","primary write error preserved");}
                    else {assert(r.error=="exclusive destination cleanup could not be verified; output may remain","fixed cleanup diagnostic");}
                }
                count=count+1;
            }
        }
    }
    let rejection_outcomes=if baseline {[true,false,nil,1]} else {[true,false,nil,1,"throw"]};
    for closed in rejection_outcomes {
        B.configure(true,true,closed);B.state.open_ok=false;
        let r=D.write_new_exclusive(map{profile:D.profile("macos")},"value",[],false);
        assert(not r.ok and B.state.writes==0 and B.state.unlinks==0 and B.state.closes==[10],"failed create only consumes owned parent");
        assert(not map_has(r,"output_may_exist"),"refusal does not claim creation");
        if not baseline and not (type(closed)=="bool" and closed) {
            assert(r.cleanup_uncertain and not r.dirfs_parent_close_confirmed and not r.retry_safe,"rejection cleanup uncertainty");
        }
        count=count+1;
    }
    B.configure(true,true,true);B.state.parent_ok=false;
    assert(not D.write_new_exclusive(map{},"value",[],false).ok,"parent rejection");
    assert(B.state.closes==[] and B.state.writes==0 and B.state.opens==0,"no unowned cleanup");
    B.configure(true,true,true);
    assert(not D.write_new_exclusive(map{},"value","invalid",false).ok,"payload rejection");
    assert(B.state.parents==0,"invalid payload before parent");
    return map{ok:true,cases:count+2,macos_native_verified:false};
}
export run;
