// tests/semantics/unicode_ident_test.sapp
//
// stdlib/unicode_ident.sapp — UAX#31-style identifier classification, in pblang.
// This is the reusable policy core that a future lexer change (Rust text::ident
// replacement, or the self-hosted tokenizer) would consult to enable
// Unicode-letter identifiers. It encodes the principled boundary: Unicode LETTERS
// (CJK/Greek/Cyrillic/accented Latin) are valid identifier characters; EMOJI are
// not (per UAX#31) unless explicitly opted in (Swift-style).

let u = import("stdlib/unicode_ident.sapp");

fn fail(m) { throw "FAIL " + m; }
fn expect(cond, m) { if not cond { fail(m); } }

// ── is_xid_start ────────────────────────────────────────────────────────────────
expect(u.is_xid_start(65), "A is an identifier start");          // 'A'
expect(u.is_xid_start(97), "a is an identifier start");          // 'a'
expect(u.is_xid_start(95), "_ is an allowed identifier start");  // '_'
expect(u.is_xid_start(955), "Greek lambda is a letter start");   // λ
expect(u.is_xid_start(22793), "CJK 変 is a letter start");        // 変
expect(u.is_xid_start(233), "Latin é is a letter start");        // é
expect(not u.is_xid_start(53), "digit 5 is not an identifier start");
expect(not u.is_xid_start(32), "space is not an identifier start");
expect(not u.is_xid_start(128512), "emoji is not an identifier start (UAX#31)"); // 😀

// ── is_xid_continue ─────────────────────────────────────────────────────────────
expect(u.is_xid_continue(65), "A continues an identifier");
expect(u.is_xid_continue(53), "digit 5 continues an identifier");
expect(u.is_xid_continue(95), "_ continues an identifier");
expect(u.is_xid_continue(955), "lambda continues an identifier");
expect(not u.is_xid_continue(32), "space does not continue an identifier");

// ── is_emoji ────────────────────────────────────────────────────────────────────
expect(u.is_emoji(128512), "😀 is emoji");
expect(u.is_emoji(9728), "☀ (U+2600) is emoji");
expect(not u.is_emoji(65), "A is not emoji");
expect(not u.is_emoji(955), "lambda is not emoji");

// ── is_valid_identifier (default: emoji disallowed) ──────────────────────────────
expect(u.is_valid_identifier("foo"), "ascii ident");
expect(u.is_valid_identifier("_x9"), "underscore + digit ident");
expect(u.is_valid_identifier("café"), "accented Latin ident");
expect(u.is_valid_identifier("λ"), "Greek ident");
expect(u.is_valid_identifier("変数"), "CJK ident");
expect(not u.is_valid_identifier("9bad"), "must not start with a digit");
expect(not u.is_valid_identifier("a b"), "must not contain a space");
expect(not u.is_valid_identifier(""), "empty is not an identifier");
expect(not u.is_valid_identifier("😀"), "emoji ident rejected by default (UAX#31)");
expect(not u.is_valid_identifier("a😀"), "emoji continue rejected by default");

// ── opt-in emoji identifiers (Swift-style) ───────────────────────────────────────
expect(u.is_valid_identifier("😀", true), "emoji ident allowed when opted in");
expect(u.is_valid_identifier("a😀", true), "emoji continue allowed when opted in");
expect(not u.is_valid_identifier("9😀", true), "digit start still invalid even with emoji opt-in");

print "unicode_ident_pass";
