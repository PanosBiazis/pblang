// tests/semantics/llm_offload_enrich_test.sapp — enrichment for stdlib/llm_offload.sapp
// Adds params_bytes, fits, bytes_human (pure memory-planning helpers).

let off = import("stdlib/llm_offload.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base kv_cache_bytes still works ──────────────────────────────────────────────
eq(off.kv_cache_bytes(10, 2, 4, 8, 2), 10 * 2 * 4 * 8 * 2 * 2, "kv_cache_bytes");

// ── ENRICH: params_bytes (n_params * bits / 8) ───────────────────────────────────
eq(off.params_bytes(1000000, 16), 2000000, "1M params @ 16-bit = 2MB");
eq(off.params_bytes(1000000, 4), 500000, "1M params @ 4-bit = 0.5MB");

// ── ENRICH: fits ─────────────────────────────────────────────────────────────────
eq(off.fits(100, 200), true, "fits within budget");
eq(off.fits(300, 200), false, "exceeds budget");

// ── ENRICH: bytes_human ──────────────────────────────────────────────────────────
eq(off.bytes_human(512), "512 B", "bytes");
eq(off.bytes_human(1536), "1.5 KB", "KB");

print "llm_offload_enrich_pass";
