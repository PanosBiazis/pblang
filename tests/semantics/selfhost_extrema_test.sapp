// Actual module import through the bounded PBLang frontend/VM, not all backends.
let F = import("stdlib:compiler/selfhost_frontend.sapp");
fn expect(ok, label) { if not ok { throw "FAIL selfhost-extrema: " + label; } }
let source = "let C = import(\"stdlib:functional.sapp\");"
    + "let seen = []; let key = fn(x) { push(seen, x); return x; };"
    + "let high = C.max_by([3, 9, 2], key); let high_seen = seen; seen = [];"
    + "let low = C.min_by([3, 9, 2], key); let low_seen = seen; seen = [];"
    + "let single = C.max_by([7], key); let single_seen = seen; seen = [];"
    + "let empty = C.min_by([], key); let empty_seen = seen;"
    + "let rows = [map{ id: 1, k: 5 }, map{ id: 2, k: 5 }];"
    + "let ties = [C.max_by(rows, fn(x) { return x.k; }).id, C.min_by(rows, fn(x) { return x.k; }).id];"
    + "let calls = [0]; let failed = try map{ ok: true, value: C.min_by([1, 2, 3], fn(x) { calls[0] = calls[0] + 1; if x == 2 { throw 7; } return x; }) } catch map{ ok: false };"
    + "let result = [high, high_seen, low, low_seen, single, single_seen, empty, empty_seen, ties, failed.ok, calls[0]];";
let result = F.frontend_run_bounded(source, map{ max_steps: 15000, max_frames: 24, max_modules: 8, max_source_bytes: 32768 });
expect(result.ok, "bounded frontend/library import");
expect(result.globals.result == [9, [3, 9, 2], 2, [3, 9, 2], 7, [7], nil, [], [1, 1], false, 2], "exact values, callback order/counts, ties and throw behavior");
print "selfhost_extrema_pass";
