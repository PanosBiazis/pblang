let CG = import("stdlib/native/codegen_x64.sapp");

fn fail(message) { throw "FAIL codegen-x64-const-div: " + message; }
fn has_bytes(haystack, needle) {
    let i = 0;
    while i + len(needle) <= len(haystack) {
        let ok = true; let j = 0;
        while j < len(needle) { if haystack[i + j] != needle[j] { ok = false; } j = j + 1; }
        if ok { return true; }
        i = i + 1;
    }
    return false;
}
fn run_source(source, tag) {
    let path = "pbnative_const_div_" + tag + ".bin";
    fs_write_bytes(path, CG.compile_fns(source));
    let chmod = proc_spawn_wait("chmod", ["700", path]);
    if (try chmod.exit_code catch 1) != 0 { try fs_remove(path) catch nil; fail(tag + " chmod failed"); }
    let result = proc_spawn_wait("./" + path, []);
    try fs_remove(path) catch nil;
    if (try result.exit_code catch 1) != 0 { fail(tag + " executable failed"); }
    return str_trim(try result.stdout catch "");
}

// Cover reciprocal correction boundaries, a divisor whose reciprocal is near
// 2^32, and the bounded single-subtract path. All values remain exact u32.
let boundary_source = "let x = 4294967295; print x / 3; print x % 3; print x / 7; print x % 7; print x / 65535; print x % 65535; print x / 2147483647; print x % 2147483647; let y = 999999; print y / 1000; print y % 1000; let z = 1016988; print z / 1000003; print z % 1000003;";
let boundary_expected = "1431655765\n0\n613566756\n3\n65537\n0\n2\n1\n999\n999\n1\n16985";
if run_source(boundary_source, "boundaries") != boundary_expected { fail("u32 quotient/remainder boundary mismatch"); }

let kernel_source = "let s = 0; let i = 0; while i < 1000000 { s = (s + (i % 1000) * 17 + 3) % 1000003; i = i + 1; } print s;";
let kernel = CG.compile_fns(kernel_source);
if not has_bytes(kernel, [72, 15, 175, 193, 72, 193, 232, 32]) { fail("reciprocal multiply/shift was not emitted"); }
if has_bytes(kernel, [72, 247, 243]) { fail("bounded constant modulo retained div rbx"); }
if run_source(kernel_source, "kernel") != "474518" { fail("optimized kernel checksum mismatch"); }

// An unconstrained function parameter cannot be proven u32. It must retain the
// full-width division fallback instead of receiving a speculative reduction.
let fallback = CG.compile_fns("fn rem(n) { return n % 3; } print rem(10);");
if not has_bytes(fallback, [72, 247, 243]) { fail("unknown range lost the 64-bit fallback"); }
if run_source("fn rem(n) { return n % 3; } print rem(10);", "fallback") != "1" { fail("fallback result mismatch"); }

// A value that starts non-negative but can become negative inside a loop is not
// a loop invariant. The backend must not reuse its pre-loop u32 fact.
let changing_source = "let x = 1; let i = 0; while i < 3 { print x % 3; x = x - 2; i = i + 1; }";
let changing = CG.compile_fns(changing_source);
if not has_bytes(changing, [72, 247, 243]) { fail("changing loop value received speculative u32 lowering"); }
if run_source(changing_source, "changing") != "1\n0\n1" { fail("changing loop fallback result mismatch"); }

print "codegen_x64_const_div_pass";
