let F=import("stdlib:compiler/selfhost_frontend.sapp");
fn check(source,expected) {
 let r=F.frontend_run(source);
 if not r.ok or r.output!=expected {throw "FAIL selfhost cache TTL output";}
}
let prefix="let C=import(\"stdlib:cache.sapp\"); let c=C.new(0); ";
for api in ["get","get_entry","has","peek"] {
 let source=prefix+"C.set_ttl(c,\"nil\",nil,600000); print C.has(c,\"nil\"); print C.get_entry(c,\"nil\").found; C.set_ttl(c,\"old\",42,600000); c.__expiry[\"old\"]=0; C."+api+"(c,\"old\"); print C.size(c); print C.stats(c).expired; print C.has(c,\"old\"); C."+api+"(c,\"old\"); print C.stats(c).expired; print C.stats(c).hits; print C.stats(c).misses;";
 let misses=0;if api=="get" or api=="get_entry" {misses=2;}
 check(source,[true,true,1,1,false,1,1,misses]);
}
check(prefix+"C.set_ttl(c,\"live\",1,600000); C.set_ttl(c,\"old\",2,600000); c.__expiry[\"old\"]=0; C.evict_expired(c); print C.stats(c).expired; print C.keys(c); print C.touch(c,\"live\",600000); print C.has(c,\"live\"); C.set(c,\"new\",3); c.__expiry[\"new\"]=0; print C.keys(c); print C.stats(c).expired; C.touch(c,\"live\",0); print map_has(c.__expiry,\"live\"); print C.get(c,\"live\");",[1,["live"],true,true,["live"],2,false,1]);
check(prefix+"C.set_ttl(c,\"value\",nil,600000); print C.get_or_set(c,\"value\",fn(){throw \"unexpected producer\";}); c.__expiry[\"value\"]=0; print C.get_or_set(c,\"value\",fn(){return 9;}); print C.get(c,\"value\");",[nil,9,9]);
check(fs_read("tests/semantics/cache_lookup_test.sapp"),["cache_lookup_pass"]);
print "selfhost_cache_ttl_pass";
