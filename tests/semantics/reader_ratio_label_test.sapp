let App=import("../../examples/declarative_browser/app.sapp");let GUI=import("stdlib:gui.sapp");let Profile=import("../../examples/declarative_browser/appearance_profile.sapp");
let n=0;fn check(ok,label){assert(ok,label);n=n+1;}
let state=map{saved:nil,writes:0};let save=fn(style){state.saved=Profile.decode(Profile.encode(style)).appearance;state.writes=state.writes+1;return map{ok:true};};
for size in [map{w:320,h:240},map{w:320,h:480},map{w:800,h:816}] {
 let c=App.create();App.configure(c,map{font_scale:1.23456789012345,line_height:1.45678901234567});App.enable_preferences(c,c.appearance,save);c.width=size.w;c.height=size.h;c.settings=true;
 let original=Profile.encode(c.appearance);
 for item in [map{key:"font_scale",prefix:"Scale: ",value:1.23456789012345,label:"~1.235"},map{key:"line_height",prefix:"Spacing: ",value:1.45678901234567,label:"~1.457"}] {
  c.focus_target=item.key;App.refresh(c);let w=GUI.get(c.form,item.key);
  check(len(w.text)<=28,"custom ratio label has bounded length");
  check(w.text==item.prefix+item.label+" (Left/Right)","long ratio is explicitly approximate");
  check(w.accessibility_label==item.prefix+str(item.value)+" (Left/Right)","exact numeric label retained as metadata");
  check(c.preferences.draft[item.key]==item.value and Profile.encode(c.appearance)==original,"rendering preserves exact draft and profile");
 }
 c.focus_target="style_save";App.refresh(c);GUI.get(c.form,"style_save").onclick(c.form);App.update(c,[]);
 check(Profile.encode(state.saved)==original and Profile.encode(c.appearance)==original,"Save keeps precise ratios");
 c.focus_target="font_scale";App.refresh(c);App.adjust_text_ratio(c,"font_scale",1);check(c.preferences.draft.font_scale==1.25,"arrows operate on original ratio");
 App.close_preferences(c);check(Profile.encode(c.appearance)==original,"discard does not quantize applied ratios");c.session.close();
}
check(state.writes==3,"one explicit save per size");
for value in [0.75,1,1.25,1.5,1.1234,1.2499999999999998] {
 let c=App.create();App.configure(c,map{font_scale:value});c.width=320;c.height=240;c.settings=true;c.focus_target="font_scale";App.refresh(c);let w=GUI.get(c.form,"font_scale");
 let expected=if len(str(value))<=6 {str(value)}else{"~1.25"};check(w.text=="Scale: "+expected+" (Left/Right)","short values and near-grid decimals");check(c.appearance.font_scale==value,"session-only mode retains precise value");c.session.close();
}
print "reader_ratio_label_pass checks="+str(n);
