let T = import("stdlib:embedded_targets.sapp");
let IR = import("stdlib:embedded_ir.sapp");

let uno = T.board("uno");
assert(uno.id == "arduino-uno" and uno.mcu == "atmega328p", "UNO alias resolves through board->MCU");
assert(uno.architecture_info.id == "avr8" and T.backend_status(uno).ok, "UNO native backend is explicit");
assert(T.pin(uno, "D7").port == "D" and T.pin(uno, "D7").bit == 7, "UNO D7 is a board alias");
assert(T.pin(uno, "status-led-test").gpio == 7, "portable test LED role maps to D7");
assert(uno.controller_loopback.output=="D6" and uno.controller_loopback.input=="D2",
    "UNO controller publishes its physical loopback pins");
assert(uno.controller_protocol_checks==14 and uno.controller_adc.pin=="A0"
       and uno.controller_adc.maximum==1023
       and uno.controller_identity=="exact-mcu-probe-board-and-firmware-unattested",
    "UNO descriptor publishes bounded evidence without overstating identity");

let esp = T.board("esp32");
assert(esp.id == "esp32-devkitc-v4" and esp.mcu_info.architecture == "xtensa-lx6", "ESP32 is not generalized to every Espressif MCU");
assert(T.pin(esp, "status-led-test").gpio == 23, "portable test LED role maps to GPIO23");
assert(esp.controller_loopback.output=="GPIO25" and esp.controller_loopback.input=="GPIO33",
    "ESP32 controller publishes its physical loopback pins");
assert(esp.controller_protocol_checks==14 and esp.controller_adc.pin=="GPIO34"
       and esp.controller_adc.maximum==4095
       and esp.controller_identity=="exact-mcu-probe-board-and-firmware-unattested",
    "ESP32 descriptor publishes bounded evidence without overstating identity");
assert(not T.backend_status(esp).ok and T.backend_status(esp).status == "incomplete", "ESP backend remains fail-closed");
assert(T.inspect_pin(esp.id,"GPIO23").pin.operations["digital-write"].compiler_status
       == "implemented-persistent-blink-only", "ESP GPIO23 inspector reports the narrow persistent backend");
let esp_manual=T.technical_manual(esp.id);
assert(esp_manual.mcu.external_flash_bytes==4194304 and esp_manual.mcu.rom_bytes==458752
       and esp_manual.mcu.sram_bytes==532480 and esp_manual.mcu.rtc_fast_sram_bytes==8192
       and esp_manual.mcu.rtc_slow_sram_bytes==8192, "ESP32-WROOM-32D memory capacities are exact");
assert(T.inspect_pin(esp.id, "GPIO25").pin.operations["analog-write"].physical,
       "ESP GPIO25 exposes physical DAC capability");
assert(T.inspect_pin(esp.id, "GPIO34").pin.operations["digital-write"].compiler_status == "not-available-on-pin",
       "ESP input-only pin inspector is explicit");

let input_only = IR.program([IR.pin_mode("GPIO34", "output")], [IR.delay_ms(1)]);
let input_report = IR.validate(input_only, esp);
assert(not input_report.ok and input_report.errors[0].code == "input-only-pin", "ESP input-only output rejected");
assert(not IR.validate(IR.program([IR.pin_mode("GPIO6", "output")], [IR.delay_ms(1)]), esp).ok,
       "ESP flash pin rejected");

let pico = T.board("raspberry-pi-pico");
let pico2 = T.board("raspberry-pi-pico-2");
assert(pico.mcu == "rp2040" and pico.architecture_info.id == "rp2040-arm", "RP2040 descriptor");
assert(pico2.mcu == "rp2350" and pico2.mcu_info.alternate_architecture == "rp2350-riscv", "RP2350 dual architecture descriptor");
assert(not T.backend_status(pico).ok and not T.backend_status(pico2).ok, "Raspberry Pi MCU backends remain honest");

let manual = T.technical_manual("arduino-uno");
assert(manual.ok and manual.board.physical_pin_count == 20 and manual.board.pin_alias_count == 26,
       "UNO technical manual covers every physical I/O and board alias");
assert(T.inspect_pin("uno", "D3").pin.operations["pwm-write"].physical,
       "UNO D3 PWM capability is visible");
assert(T.inspect_pin("uno", "A0").pin.operations["analog-read"].physical,
       "UNO A0 ADC capability is visible");
assert(not IR.validate(IR.program([IR.analog_write("A0", 127)], [IR.delay_ms(1)]), uno).ok,
       "UNO has no physical DAC and rejects analog-write");
assert(IR.validate(IR.program([IR.pwm_write("D3", 127)], [IR.delay_ms(1)]), uno).ok,
       "UNO PWM validates independently from backend completion");

let common = IR.blink("status-led-test", 500);
assert(IR.lower(common, uno).ok and IR.lower(common, esp).ok and IR.lower(common, pico).ok,
       "one portable Blink IR validates across AVR, ESP32 and RP2040 boards");
assert(not T.coverage().silent_fallback, "no silent C fallback");
print "embedded_targets_pass";
