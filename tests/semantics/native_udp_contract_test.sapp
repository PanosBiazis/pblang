let UDP=import("stdlib:native_udp.sapp");
fn expect(value,message){if not value{throw "FAIL native UDP: "+message;}}
if platform()!="linux" or not UDP.available().ok {print "native_udp_contract_skipped";return;}
let listener=UDP.listen_ipv4("127.0.0.1",0);expect(listener.ok,"ephemeral loopback listener");
let payload=[0,1,2,3,127,128,254,255];
let sent=UDP.send_ipv4("127.0.0.1",listener.port,payload,map{timeout_ms:500,broadcast:false});
expect(sent.ok and sent.bytes==8 and sent.nonblocking and sent.cloexec and not sent.shell_used,
    "exact binary datagram send: "+json_stringify(sent));
let received=UDP.receive(listener,64,500);UDP.close(listener);
expect(received.ok and received.datagram_complete and received.bytes==payload and listener.closed,"exact binary datagram receive and close");
let timeout_listener=UDP.listen_ipv4("127.0.0.1",0);let timed=UDP.receive(timeout_listener,64,10);UDP.close(timeout_listener);
expect(not timed.ok and timed.timeout,"empty receive obeys deadline");
print "native_udp_contract_pass";
