let GUIParse = import("stdlib:gui_parse.sapp");
let Document = import("stdlib:ui_document.sapp");

let source = "let gui = import(\"stdlib:gui.sapp\");\n"
    + "fn build() {\n"
    + " let form = gui.form(\"Calculator\", 420, 320);\n"
    + " gui.add(form, gui.textbox(\"display\", 12, 12, 396, 44, \"0\"));\n"
    + " gui.add(form, gui.button(\"equals\", 312, 252, 96, 48, \"=\", on_equals));\n"
    + " gui.set_model(form, map{mode:\"standard\", precision:12});\n"
    + "}\n";

let document = GUIParse.parse_document(source);
assert(document.ok and document.format == "pblang.ui-document.v1",
    "strict PBLang GUI import reaches the canonical UI document");
assert(document.widget_count == 2 and document.widgets[1].events.click == "on_equals",
    "geometry and inert handler identifiers survive canonicalization");
assert(document.model.mode == "standard" and not document.embedded_code
    and not document.direct_effects and not document.handlers_executed,
    "model metadata is preserved without granting effects");
assert(Document.validate(document).ok, "canonical document revalidates after serialization boundaries");

let duplicate = map{form:map{title:"Bad",w:200,h:200}, model:map{}, widgets:[
    map{name:"same",kind:"button",x:0,y:0,w:10,h:10,props:map{}},
    map{name:"same",kind:"label",x:0,y:20,w:10,h:10,props:map{}}
]};
let duplicate_rejected = false;
try { Document.from_design(duplicate, "delphi-fmx"); } catch { duplicate_rejected = true; }
assert(duplicate_rejected, "duplicate widget identities fail closed across form adapters");

let injected = map{form:map{title:"Bad",w:200,h:200}, model:map{}, widgets:[
    map{name:"button1",kind:"button",x:0,y:0,w:10,h:10,props:map{},
        events:map{click:"run(); delete_files()"}}
]};
let handler_rejected = false;
try { Document.from_design(injected, "qt-qml"); } catch { handler_rejected = true; }
assert(handler_rejected, "embedded handler code is never accepted as an inert event name");

let tampered = GUIParse.parse_document(source); tampered.widgets[0].parent = "missing";
assert(not Document.validate(tampered).ok, "mutable documents are revalidated at the consumer boundary");
assert(Document.status().renderer_neutral and not Document.status().production_ready,
    "canonical validation is distinct from tested renderer/importer readiness");
print "ui_document_pass";
