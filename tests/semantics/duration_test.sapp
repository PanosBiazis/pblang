// tests/semantics/duration_test.sapp — stdlib/duration.sapp
import "stdlib:duration.sapp";
let d = duration;

// constructors → seconds
if d.minutes(1) != 60 { throw "FAIL minutes"; }
if d.hours(1) != 3600 { throw "FAIL hours"; }
if d.days(1) != 86400 { throw "FAIL days"; }
if d.millis(1500) != 1.5 { throw "FAIL millis"; }
if d.weeks(1) != 604800 { throw "FAIL weeks"; }

// arithmetic
let span = d.add(d.hours(1), d.minutes(30));
if span != 5400 { throw "FAIL add: " + str(span); }
if d.sub(d.hours(2), d.hours(1)) != 3600 { throw "FAIL sub"; }
if d.scale(d.minutes(1), 3) != 180 { throw "FAIL scale"; }
if d.negate(d.seconds(5)) != 0 - 5 { throw "FAIL negate"; }
if d.abs_dur(d.seconds(0 - 5)) != 5 { throw "FAIL abs"; }

// comparison
if d.compare(d.seconds(1), d.seconds(2)) != 0 - 1 { throw "FAIL compare lt"; }
if d.compare(d.seconds(2), d.seconds(2)) != 0 { throw "FAIL compare eq"; }
if d.lt(d.seconds(1), d.seconds(2)) == false { throw "FAIL lt"; }

// conversions
if d.as_minutes(d.hours(1)) != 60 { throw "FAIL as_minutes"; }
if d.as_hours(d.days(1)) != 24 { throw "FAIL as_hours"; }
if d.as_millis(d.seconds(2)) != 2000 { throw "FAIL as_millis"; }
if d.between(100, 250) != 150 { throw "FAIL between"; }

// decomposition
let p = d.parts(d.add(d.days(1), d.add(d.hours(2), d.add(d.minutes(3), d.seconds(4)))));
if p.days != 1 or p.hours != 2 or p.minutes != 3 or p.seconds != 4 { throw "FAIL parts: " + str(p); }
let pm = d.parts(d.millis(1500));
if pm.seconds != 1 or pm.millis != 500 { throw "FAIL parts millis: " + str(pm); }

// humanize
if d.humanize(0) != "0s" { throw "FAIL humanize 0"; }
if d.humanize(5400) != "1h 30m" { throw "FAIL humanize 5400: " + d.humanize(5400); }
if d.humanize(d.millis(250)) != "250ms" { throw "FAIL humanize ms: " + d.humanize(d.millis(250)); }
if d.humanize(0 - 125) != "-2m 5s" { throw "FAIL humanize neg: " + d.humanize(0 - 125); }

// format_clock
if d.format_clock(3661) != "01:01:01" { throw "FAIL clock: " + d.format_clock(3661); }
if d.format_clock(d.add(d.days(2), 3661)) != "2:01:01:01" { throw "FAIL clock days: " + d.format_clock(d.add(d.days(2), 3661)); }

// parse
if d.parse("1h30m") != 5400 { throw "FAIL parse 1h30m: " + str(d.parse("1h30m")); }
if d.parse("90s") != 90 { throw "FAIL parse 90s"; }
if d.parse("2d 4h") != d.add(d.days(2), d.hours(4)) { throw "FAIL parse 2d 4h"; }
if d.parse("500ms") != 0.5 { throw "FAIL parse 500ms"; }
if d.parse("garbage") != nil { throw "FAIL parse garbage should be nil"; }
if d.parse("10x") != nil { throw "FAIL parse unknown unit should be nil"; }

// round-trip: parse(humanize(x)) == x for whole-second spans
let x = d.add(d.hours(3), d.add(d.minutes(15), d.seconds(7)));
if d.parse(d.humanize(x)) != x { throw "FAIL round-trip: " + d.humanize(x); }

print "duration_pass";
