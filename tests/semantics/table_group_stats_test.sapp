let N=import("stdlib:table_group_stats.sapp");let S=import("stdlib:sheet_document.sapp");let C=import("stdlib:sheet_csv.sapp");
let d=C.decode("Team,Value\nα,0.1\nβ,-2.5\nα,0.2\nβ,2.5\n,0001.230000\nα ,0\n__proto__,1\n");let before=S.encode(d);let r=N.summarize(d,0,1,true);
assert(r.cells==[["Group","Count","Sum","Min","Max"],["α","2","0.3","0.1","0.2"],["β","2","0","-2.5","2.5"],["","1","1.23","1.23","1.23"],["α ","1","0","0","0"],["__proto__","1","1","1","1"]],"exact decimal, cancellation, literal groups, source order");
r.cells[1][0]="changed";assert(S.encode(d)==before,"detached source");
assert(str(N.parse_value("-0.000000"))=="0","negative zero normalized");assert(str(N.parse_value("999999999999.999999"))=="999999999999.999999","maximum precision");
for bad in [""," "," 1","1 ","+1","-",".1","1.","1.2.3","1e2","NaN","Infinity","1,2","１２","=1+2","1000000000000","1.1234567","0\n",nil,1]{assert((try N.parse_value(bad) catch nil)==nil,"strict grammar");}
for bad in [-1,2,0.5,"1",nil]{assert((try N.summarize(d,0,bad,true) catch nil)==nil,"invalid numeric column");assert((try N.summarize(d,bad,1,true) catch nil)==nil,"invalid category");}
assert((try N.summarize(d,0,1,"header") catch nil)==nil,"explicit header boolean");
let empty=S.create(1,2);assert(N.summarize(empty,0,1,true).cells==[["Group","Count","Sum","Min","Max"]],"header-only has no invented group");assert((try N.summarize(empty,0,1,false) catch nil)==nil,"blank numeric cell rejects");
let invalid=S.copy(d);invalid.cells[2][1]="bad";assert((try N.summarize(invalid,0,1,true) catch nil)==nil and S.encode(d)==before,"no partial groups returned");
let maximum=S.create(32,2);let cursor=0;while cursor<32{maximum.cells[cursor]=["one","999999999999.999999"];cursor=cursor+1;}let big=N.summarize(maximum,0,1,false);assert(big.cells[1]==["one","32","31999999999999.999968","999999999999.999999","999999999999.999999"],"exact 32-row sum beyond safe scaled float range");
for i in range(0,32){maximum.cells[i]=[str(i),"1"];}assert((try N.summarize(maximum,0,1,false) catch nil)==nil,"32 groups reject without truncation");assert(len(N.summarize(maximum,0,1,true).cells)==32,"31 groups fit");
let wide=S.create(32,2);wide.cells[0]=["Group","Value"];let label="";while len(label)<254{label=label+"x";}for i in range(1,32){wide.cells[i]=[label+str(i),"12345"];}S.validate(wide);assert((try N.summarize(wide,0,1,true) catch nil)==nil,"output total bytes validated");
let same=C.decode("1\n1\n2\n");assert(N.summarize(same,0,0,false).cells[1]==["1","2","2","1","1"],"same column groups literal numeric labels");
print "table_group_stats_pass";
