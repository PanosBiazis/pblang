// tests/semantics/quantum_enrich_test.sapp — bug fix + enrichment for stdlib/quantum.sapp
// FIX: emit_qasm must emit x/y/z gates (run() & protocol support them).
// ENRICH: apply_y, apply_z, bell, gate_counts, op_count, reset.

let Q = import("stdlib/quantum.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(s, sub, m) { if str_contains(s, sub) == false { fail(m + " : " + s); } }

// ── BUG FIX: x/y/z gates must appear in emitted QASM ──────────────────────────────
let c = Q.circuit(1);
c = Q.apply_x(c, 0);
c = Q.apply_y(c, 0);
c = Q.apply_z(c, 0);
let qasm = Q.to_qasm(c);
has(qasm, "x q[0];", "qasm emits x");
has(qasm, "y q[0];", "qasm emits y");
has(qasm, "z q[0];", "qasm emits z");

// ── ENRICH: bell pair convenience ─────────────────────────────────────────────────
let b = Q.circuit(2);
b = Q.bell(b, 0, 1);
eq(len(b.ops), 2, "bell adds h + cx");
eq(b.ops[0].gate, "h", "bell first is h");
eq(b.ops[1].gate, "cx", "bell second is cx");

// ── ENRICH: gate_counts + op_count ────────────────────────────────────────────────
eq(Q.op_count(c), 3, "op_count = 3 (x,y,z)");
let gc = Q.gate_counts(c);
eq(gc["x"], 1, "gate_counts x"); eq(gc["y"], 1, "gate_counts y"); eq(gc["z"], 1, "gate_counts z");

// ── ENRICH: reset clears ops, keeps qubit count ───────────────────────────────────
c = Q.reset(c);
eq(len(c.ops), 0, "reset clears ops");
eq(c.n_qubits, 1, "reset keeps n_qubits");

print "quantum_enrich_pass";
