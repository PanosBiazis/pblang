// Test: augmented assignment operators (+=, -=, *=, /=, %=, **=)
// This is one of the most-requested features — every user writes x = x + 1

// += basic
let x = 10;
x += 5;
assert(x == 15, "x += 5 should give 15");

// -= basic
let y = 20;
y -= 8;
assert(y == 12, "y -= 8 should give 12");

// *= basic
let z = 4;
z *= 3;
assert(z == 12, "z *= 3 should give 12");

// /= basic
let w = 15;
w /= 3;
assert(w == 5, "w /= 3 should give 5");

// %= basic
let m = 17;
m %= 5;
assert(m == 2, "17 %= 5 should give 2");

// **= basic (exponentiation)
let p = 2;
p **= 8;
assert(p == 256, "2 **= 8 should give 256");

// Chaining
let n = 1;
n += 1;
n += 1;
n += 1;
assert(n == 4, "chained += should work");

// In a loop (common pattern!)
let sum = 0;
for i 10 { sum += i; }
assert(sum == 45, "sum via += in loop should be 45, got: " + str(sum));

// With arrays (index assignment)
let arr = [10, 20, 30];
arr[0] += 5;
assert(arr[0] == 15, "arr[0] += 5 should work");

arr[1] -= 5;
assert(arr[1] == 15, "arr[1] -= 5 should work");

arr[2] *= 2;
assert(arr[2] == 60, "arr[2] *= 2 should work");

// With maps (attribute assignment)
let counter = map{ value: 0 };
counter.value += 10;
assert(counter.value == 10, "counter.value += 10 should work");

counter.value -= 3;
assert(counter.value == 7, "counter.value -= 3 should work");

counter.value *= 4;
assert(counter.value == 28, "counter.value *= 4 should work");

// String concatenation with +=
let msg = "hello";
msg += " world";
assert(msg == "hello world", "string += should concatenate");

print "augmented_assignment_pass";
