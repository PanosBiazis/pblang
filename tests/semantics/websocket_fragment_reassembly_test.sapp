// websocket_fragment_reassembly_test.sapp
import "stdlib:websocket.sapp";

// Fragmented "Hello":
// frame1: FIN=0, opcode=1, payload="Hel"  → bytes [1, 3, 'H', 'e', 'l']
// frame2: FIN=1, opcode=0 (continuation), payload="lo" → bytes [128, 2, 'l', 'o']
let stream = [1, 3, 72, 101, 108, 128, 2, 108, 111];

let frames = websocket.parse_frames(stream);
if type(frames) == "map" and map_has(frames, "error") {
    throw "FAIL parse_frames error: " + str(frames.error);
} else {
    if len(frames) != 2 { throw "FAIL frame count"; }
    if frames[0].opcode != 1 or frames[0].fin != 0 { throw "FAIL frame1 header"; }
    if frames[1].opcode != 0 or frames[1].fin != 1 { throw "FAIL frame2 header"; }
}

let msg = websocket.parse_message(stream);
if map_has(msg, "error") {
    throw "FAIL parse_message error: " + str(msg.error);
} else {
    if msg.opcode != 1 { throw "FAIL message opcode"; }
    if msg.payload != "Hello" { throw "FAIL message payload"; }
    if msg.frames_used != 2 { throw "FAIL frames_used"; }
}

print "websocket_fragment_reassembly_pass";
