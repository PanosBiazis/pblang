// websocket_fragment_reassembly_test.sapp
import "stdlib:websocket.sapp";

// Fragmented "Hello":
// frame1: FIN=0, opcode=1, payload="Hel"
// frame2: FIN=1, opcode=0 (continuation), payload="lo"
let frame1 = strfromcharcode(1) + strfromcharcode(3) + "Hel";
let frame2 = strfromcharcode(128) + strfromcharcode(2) + "lo";
let stream = frame1 + frame2;

let frames = websocket.parse_frames(stream);
if type(frames) == "map" and map_has(frames, "error") {
    print "FAIL parse_frames error: " + str(frames.error);
} else {
    if len(frames) != 2 { print "FAIL frame count"; }
    if frames[0].opcode != 1 or frames[0].fin != 0 { print "FAIL frame1 header"; }
    if frames[1].opcode != 0 or frames[1].fin != 1 { print "FAIL frame2 header"; }
}

let msg = websocket.parse_message(stream);
if map_has(msg, "error") {
    print "FAIL parse_message error: " + str(msg.error);
} else {
    if msg.opcode != 1 { print "FAIL message opcode"; }
    if msg.payload != "Hello" { print "FAIL message payload"; }
    if msg.frames_used != 2 { print "FAIL frames_used"; }
}

print "websocket_fragment_reassembly_pass";
