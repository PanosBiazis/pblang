let M=import("../../examples/uno_r4_led_studio/model.sapp");let X=import("../../examples/uno_r4_led_studio/exchange.sapp");
let L=import("stdlib:uno_r4_led_matrix.sapp");let W=import("../../examples/uno_r4_led_studio/web_import.sapp");
let P=import("../../examples/uno_r4_led_studio/playback.sapp");
fn denied(f) {return try {f();false;} catch true;}
let original=M.create();M.apply(original,"text","πΩ");let encoded=M.export_document(original);
let imported=M.create();M.apply(imported,"play",nil,100);M.apply(imported,"import",encoded);
assert(M.export_document(imported)==encoded and imported.index==0 and not imported.playing and imported.text=="","roundtrip resets transient editor state");
let frames=[];for _i 64 {push(frames,map{pixels:L.blank(1),duration_ms:50});}
original.document=L.animation(frames);let largest=M.export_document(original);
assert(len(str_to_bytes(largest))<=X.MAX_BYTES,"64-frame export fits explicit import budget");
assert(len(X.decode(largest).frames)==64,"full export supported");
let doc=json_parse(encoded);doc.arduino_frames[0][0]=1;
let malformed=["", "{", "[]", encoded+"x", json_stringify(doc),str_repeat(" ",X.MAX_BYTES+1),str_repeat("Ω",65537),str_repeat("[",1000)+str_repeat("]",1000),"{\"a\":1,\"a\":2}","{\"a\":1,\"\\u0061\":2}"];
push(malformed,str_join(str_split(encoded,"\"mapping\""),"\"format\":\"pblang.uno-r4-led-export.v1\",\"mapping\""));
push(malformed,str_join(str_split(encoded,"\"mapping\""),"\"\\u0066ormat\":\"pblang.uno-r4-led-export.v1\",\"mapping\""));
doc=json_parse(encoded);doc.extra=0;push(malformed,json_stringify(doc));
doc=json_parse(encoded);doc.mapping="other";push(malformed,json_stringify(doc));
doc=json_parse(encoded);doc.document.frames[0].pixels[0]=true;push(malformed,json_stringify(doc));
doc=json_parse(encoded);doc.arduino_frames[0][3]=50;push(malformed,json_stringify(doc));
doc=json_parse(encoded);doc.arduino_frames[0][0]=false;push(malformed,json_stringify(doc));
doc=json_parse(encoded);doc.document.total_ms=0;push(malformed,json_stringify(doc));
push(malformed,json_stringify(json_parse(encoded).document));
M.apply(imported,"play",nil,500);M.tick(imported,650);let before=json_stringify(imported);
for bad in malformed {assert(denied(fn(){M.apply(imported,"import",bad);}) and json_stringify(imported)==before,"invalid import is atomic including playback");}
let separated=W.split_body("csrf=abc&animation="+url_encode(encoded)+"&action=do_import");
assert(separated.payload==encoded and separated.body=="csrf=abc&action=do_import","bounded payload separated without trusting form");
for bad in ["animation=%", "animation=%GG", "animation=%00", "animation=x&animation=y", "animation=x=y", "animation="+url_encode(str_repeat("Ω",65537)),str_repeat("x",W.MAX_BODY+1)] {assert(denied(fn(){W.split_body(bad);}),"malformed and oversized form rejected");}
let preview=P.svg(L.animation([map{pixels:L.blank(),duration_ms:50},map{pixels:L.blank(1),duration_ms:100}]),25);
assert(str_contains(preview,"begin=\"25ms\"") and str_contains(preview,"begin=\"125ms\"") and not str_contains(preview,"<script") and not str_contains(preview,"indefinite"),"one-pass bounded remaining SVG timing");
print "uno_r4_led_studio_import_pass";
