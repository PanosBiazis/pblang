// tests/semantics/pipe_enrich_test.sapp — enrichment for stdlib/pipe.sapp
// Adds compose_all, juxt, when/unless, complement, partial_right.

let pipe = import("stdlib/pipe.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

fn add1(x) { return x + 1; }
fn dbl(x) { return x * 2; }
fn is_even(x) { return x % 2 == 0; }
fn sub(a, b) { return a - b; }

// ── base still works ─────────────────────────────────────────────────────────────
eq(pipe.chain(3, [add1, dbl]), 8, "chain"); eq(pipe.compose(add1, dbl)(3), 7, "compose");

// ── ENRICH: compose_all (right-to-left) ──────────────────────────────────────────
eq(pipe.compose_all([add1, dbl])(3), 7, "compose_all = add1(dbl(3))");

// ── ENRICH: juxt ─────────────────────────────────────────────────────────────────
let j = pipe.juxt([add1, dbl])(5);
eq(j[0], 6, "juxt add1"); eq(j[1], 10, "juxt dbl");

// ── ENRICH: when / unless ────────────────────────────────────────────────────────
eq(pipe.when(is_even, dbl)(4), 8, "when applies on match");
eq(pipe.when(is_even, dbl)(3), 3, "when passes through on no match");
eq(pipe.unless(is_even, add1)(3), 4, "unless applies when pred false");
eq(pipe.unless(is_even, add1)(4), 4, "unless passes through when pred true");

// ── ENRICH: complement ───────────────────────────────────────────────────────────
eq(pipe.complement(is_even)(3), true, "complement of even on odd");

// ── ENRICH: partial_right ────────────────────────────────────────────────────────
eq(pipe.partial_right(sub, 2)(10), 8, "partial_right binds last arg -> 10-2");

print "pipe_enrich_pass";
