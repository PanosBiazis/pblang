let Q=import("stdlib:table_quality.sapp");let Select=import("stdlib:table_row_selection.sapp");let CSV=import("stdlib:sheet_csv.sapp");let Sheet=import("stdlib:sheet_document.sapp");
let doc=CSV.decode("name,value\n α ,2\nβ,\nβ,\nready,3");let before=Sheet.encode(doc);let report=Q.inspect(doc,true);
assert(report.rows_checked==4 and report.flagged_rows==3 and report.blank_cells==2 and report.padded_cells==1 and report.duplicate_rows==1,"independent totals");
assert(report.rows==[map{row:1,blank_columns:[],padded_columns:[0],duplicate_of:nil},map{row:2,blank_columns:[1],padded_columns:[],duplicate_of:nil},map{row:3,blank_columns:[1],padded_columns:[],duplicate_of:2}],"exact original positions");
assert(not str_contains(json_stringify(report),"α") and not str_contains(json_stringify(report),"name") and not report.safe_to_log,"no cell text or headings in report");
let selected=Q.select_flagged(doc,true);assert(selected.cells==[doc.cells[0],doc.cells[1],doc.cells[2],doc.cells[3]],"header retained exactly once");selected.cells[1][0]="changed";assert(Sheet.encode(doc)==before,"detached source");
assert(Q.inspect(CSV.decode("x\nx\nx"),false).rows==[map{row:1,blank_columns:[],padded_columns:[],duplicate_of:0},map{row:2,blank_columns:[],padded_columns:[],duplicate_of:0}],"duplicate points to first row including zero");
assert(Q.inspect(CSV.decode("x\nx"),true).flagged_rows==0,"header excluded from comparisons");
assert(Q.inspect(CSV.decode("x\n x"),false).duplicate_rows==0,"no normalized deduplication");
let blank=Q.inspect(Sheet.create(1,1));assert(blank.blank_cells==1 and blank.padded_cells==0,"empty string");
let padded=Q.inspect(CSV.decode(" 	 "));assert(padded.blank_cells==1 and padded.padded_cells==1,"whitespace can have both findings");
assert(Q.inspect(CSV.decode("header"),true).rows_checked==0,"header only");
assert((try Q.select_flagged(CSV.decode("a\nb")) catch nil)==nil,"no invented empty selection");
for bad in [true,nil,"0",[],[0,0],[1,0],[-1],[5],[0.5],[true]] {assert((try Select.select(doc,bad) catch nil)==nil,"invalid indices");}
assert((try Select.select(doc,[0],true) catch nil)==nil,"header is not data");
for bad in [nil,1,"true"] {assert((try Q.inspect(doc,bad) catch nil)==nil,"strict header mode");}
for bad in [nil,map{},map{format:Sheet.FORMAT,cells:[]},map{format:Sheet.FORMAT,cells:[["x"],["x","y"]]}] {assert((try Q.inspect(bad) catch nil)==nil,"invalid sheet");}
let max=Sheet.create(32,8);let full=Q.inspect(max);assert(full.flagged_rows==32 and full.blank_cells==256 and full.duplicate_rows==31,"maximum bounds");assert(Q.select_flagged(max)==max,"maximum selection");
let large=Sheet.create(32,1);for r in range(0,32) {large.cells[r][0]=str_repeat("x",256);}assert(Q.inspect(large).duplicate_rows==31,"8192 byte maximum");
// Independent pairwise oracle on varied small tables, including delimiter-like cell text.
for seed in range(0,12) {
 let t=Sheet.create(7,2);for r in range(0,7) {t.cells[r][0]=[""," a ","a","b|c","β"][(r+seed)%5];t.cells[r][1]=str((r*seed)%3);}
 let q=Q.inspect(t,false);let expected=[];
 for r in range(0,7) {
  let b=[];let pad=[];for c in range(0,2) {if str_trim(t.cells[r][c])=="" {array_push(b,c);}if str_trim(t.cells[r][c])!=t.cells[r][c] {array_push(pad,c);}}
  let first=-1;for prior in range(0,r) {if first<0 and t.cells[prior]==t.cells[r] {first=prior;}}
  if len(b)>0 or len(pad)>0 or first>=0 {array_push(expected,map{row:r,blank_columns:b,padded_columns:pad,duplicate_of:if first<0 {nil} else {first}});}
 }
 assert(q.rows==expected,"pairwise oracle");
}
print "table_quality_pass";
