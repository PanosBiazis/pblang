let CP = import("stdlib:compute.sapp");
let kinds = ["auto", "cpu", "sequential", "gpu", "npu", "simd", "distributed"];
let workloads = ["generic", "numeric", "tensor", "inference", "batch"];
let sizes = [0, 1, 31, 32, 256, 1000000000];
let devices = [[], [map{ kind: "gpu", usable: true }, map{ kind: "npu", usable: true },
    map{ kind: "simd", usable: true }, map{ kind: "distributed", usable: true }]];
let signatures = [];
let k = 0;
while k < len(kinds) {
    let w = 0;
    while w < len(workloads) {
        let cfg = CP.policy(map{ preferred_device: kinds[k], workload: workloads[w], max_workers: 4 });
        let n = 0;
        while n < len(sizes) {
            let d = 0;
            while d < len(devices) {
                let route = CP.select_device(sizes[n], devices[d], cfg);
                assert(route.estimate == CP.estimate_work(sizes[n], cfg), "route estimate remains exact");
                array_push(signatures, route);
                d = d + 1;
            }
            n = n + 1;
        }
        w = w + 1;
    }
    k = k + 1;
}
let cfg = CP.policy(map{ max_workers: 1 });
let first = CP.select_device(4, [], cfg);
first.estimate.work_units = 999;
assert(CP.select_device(4, [], cfg).estimate.work_units == 4, "returned estimates are not cached");
cfg.work_units_per_item = 7;
assert(CP.select_device(4, [], cfg).estimate.work_units == 28, "policy changes are observed");
cfg.work_units_per_item = nil;
assert(CP.select_device(4, [], cfg).estimate.work_units == 4, "nil retains workload default");
cfg.work_units_per_item = -1;
assert((try CP.select_device(4, [], cfg) catch "rejected") == "rejected", "mutated estimate input validated again");
cfg.work_units_per_item = 1000000000;
cfg.transfer_bytes_per_item = 1000000000;
let saturated = CP.select_device(1000000000, [], cfg);
assert(saturated.estimate.saturated and saturated.estimate.work_units == 9007199254740991,
    "shared estimate retains saturating arithmetic");
let strict = CP.policy(map{ preferred_device: "gpu", fallback_to_cpu: false, max_workers: 1 });
assert(not CP.select_device(4, [], strict).ok, "strict fallback prohibition unchanged");
let bad_options = [false, 1, "invalid", []];
k = 0;
while k < len(bad_options) {
    let options = bad_options[k];
    assert((try CP.policy(options) catch "rejected") == "rejected", "public policy validates option type");
    assert((try CP.run_controlled([], fn(x) { return x; }, options) catch "rejected") == "rejected",
        "execution validates option type before private field reads");
    assert((try CP.storage_read_controlled([], options) catch "rejected") == "rejected",
        "storage validates option type before private field reads");
    k = k + 1;
}
let invalid = [nil, true, 1, [], map{}, "CPU", "gpu ", "auto-extra"];
k = 0;
while k < len(invalid) {
    cfg.preferred_device = invalid[k];
    assert((try CP.select_device(1, [], cfg) catch "rejected") == "rejected", "raw selector accepts only exact names");
    k = k + 1;
}
print "compute_route_estimate_pass|" + str(len(signatures)) + "|" + sha256(json_stringify(signatures));
