let Android = import("stdlib:android_toolchain.sapp");

fn require(value, message) { if not value { throw "android toolchain security test failed: " + message; } }

let relative = try { Android.discover(map{ sdk_root: "relative/sdk" }); false } catch true;
require(relative, "relative SDK roots must fail before filesystem or process use");
let traversal = try { Android.discover(map{ sdk_root: "/tmp/sdk/../escape" }); false } catch true;
require(traversal, "parent traversal in SDK roots must fail closed");
let missing = Android.discover(map{ sdk_root: "/tmp/pblang-missing-android-sdk" });
require(not missing.ok and str_contains(missing.error, "no complete Android build-tools"),
    "safe missing SDK roots must return a structured discovery error");

print "android_toolchain_security_pass";
