// tests/semantics/diagnostics_lints_test.sapp — AST-based reliable lints
// unreachable-after-return/throw and self-assignment.

let D = import("stdlib/diagnostics.sapp");

fn fail(m) { throw "FAIL " + m; }
fn has_code(r, code) {
    let i = 0;
    while i < len(r.diagnostics) { if r.diagnostics[i].code == code { return true; } i = i + 1; }
    return false;
}

// ── unreachable code after return ─────────────────────────────────────────────────
let r1 = D.diagnose("fn f() { return 1;\nprint 2; }");
if not has_code(r1, "unreachable-code") { fail("should flag unreachable after return: " + str(r1.diagnostics)); }

// ── unreachable code after throw ──────────────────────────────────────────────────
let r2 = D.diagnose("fn g() { throw \"x\";\nprint 9; }");
if not has_code(r2, "unreachable-code") { fail("should flag unreachable after throw"); }

// ── no false positive when return is last statement ───────────────────────────────
let r3 = D.diagnose("fn h() { let a = 1;\nreturn a; }");
if has_code(r3, "unreachable-code") { fail("return as last stmt is fine, no unreachable"); }

// ── self-assignment ────────────────────────────────────────────────────────────────
let r4 = D.diagnose("let x = 1;\nx = x;");
if not has_code(r4, "self-assignment") { fail("should flag x = x: " + str(r4.diagnostics)); }

// ── no false positive on a normal assignment ──────────────────────────────────────
let r5 = D.diagnose("let x = 1;\nlet y = 2;\nx = y;");
if has_code(r5, "self-assignment") { fail("x = y is not self-assignment"); }

// ── identical pure operands, without breaking IEEE-754 NaN idioms ────────────────
let r6 = D.diagnose("fn ratio(x) { return x / x; }");
if not has_code(r6, "eq-op") { fail("x / x should be reported as an identical-operand risk"); }

let r7 = D.diagnose("fn ordered(x) { return x < x; }");
if not has_code(r7, "eq-op") { fail("x < x should be reported as an impossible strict ordering"); }

let r8 = D.diagnose("fn is_nan(x) { return x != x; } fn is_not_nan(x) { return x == x; }");
if has_code(r8, "eq-op") { fail("IEEE-754 NaN classification idioms must not be noisy"); }

let r9 = D.diagnose("fn maybe_nan(x) { return x <= x and x >= x; }");
if has_code(r9, "eq-op") { fail("non-strict self-comparison can intentionally classify NaN"); }

let r10 = D.diagnose("fn calls() { return sample() / sample(); }");
if has_code(r10, "eq-op") { fail("repeated calls are not equivalent pure operands"); }

print "diagnostics_lints_pass";
