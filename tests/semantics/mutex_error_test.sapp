// tests/semantics/mutex_error_test.sapp
// with_mutex / try_with_mutex must ALWAYS release the lock, even when the critical
// section throws, and must not silently swallow the failure. Regression: the old
// versions referenced a `catch` variable that pblang does not actually bind, so the
// error path threw "undefined global err_val"; with_mutex also returned nil on failure
// (swallowing it).
let thread = import("stdlib:thread.sapp");

fn fail(m) { throw "FAIL " + m; }

// ── with_mutex: throwing inside must propagate AND leave the lock released ────
let m = thread.mutex();
let propagated = false;
try {
    thread.with_mutex(m, fn() { throw "boom"; });
} catch {
    propagated = true;   // error surfaced, not swallowed
}
if not propagated { fail("with_mutex swallowed the error"); }
// Lock must be free now (it was released despite the throw).
if mutex_try_lock(m) != true { fail("with_mutex did not unlock on error"); }
mutex_unlock(m);

// ── with_mutex: success path returns the value ───────────────────────────────
let v = thread.with_mutex(m, fn() { return 7 * 6; });
if v != 42 { fail("with_mutex success value (got " + str(v) + ")"); }

// ── try_with_mutex: throwing inside returns {ok:false} and unlocks ───────────
let r = thread.try_with_mutex(m, fn() { throw "nope"; });
if r.ok != false { fail("try_with_mutex should report ok:false on error"); }
if mutex_try_lock(m) != true { fail("try_with_mutex did not unlock on error"); }
mutex_unlock(m);

// ── try_with_mutex: success path ─────────────────────────────────────────────
let r2 = thread.try_with_mutex(m, fn() { return 99; });
if r2.ok != true or r2.value != 99 { fail("try_with_mutex success"); }

print "mutex_error_pass";
