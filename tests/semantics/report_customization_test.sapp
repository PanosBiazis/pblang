let R=import("stdlib:report_customization.sapp");
let default=R.plan("en");
assert(default.ui_language=="en" and default.report_language=="el" and default.language_source=="default","UI does not select report language");
assert(default.style.font_size==12 and default.style.preset=="light" and not default.style.landscape and not default.style.dense,"declared style defaults");
let preferences_saved=map{report_language:"en",style:map{preset:"dark",font_size:18,dense:true}};
let operation=map{report_language:"el",style:map{preset:"ink",landscape:true}};
let saved_before=json_stringify(preferences_saved);let operation_before=json_stringify(operation);
let result=R.plan("en",preferences_saved,operation);
assert(result.report_language=="el" and result.language_source=="operation","operation precedence");
assert(result.style.preset=="ink" and result.style.font_size==18 and result.style.landscape and result.style.dense,"field-wise merge");
assert(result.foreground_background_contrast==21 and result.foreground.r==0 and result.background.r==255,"ink preset via theme primitives");
result.style.font_size=9;result.foreground.r=99;
assert(json_stringify(preferences_saved)==saved_before and json_stringify(operation)==operation_before,"input preserved");
assert(R.plan("el",preferences_saved,operation).foreground.r==0 and R.plan("el",preferences_saved).style.font_size==18,"fresh result");
assert(R.plan("el",preferences_saved,map{report_language:nil}).language_source=="saved","nil override inherits preferences_saved");
assert(R.plan("en",map{report_language:nil}).language_source=="default","nil preferences_saved uses explicit default");
for size in [9,24] { assert(R.plan("el",map{style:map{font_size:size}}).style.font_size==size,"font boundaries"); }
for preset in ["light","dark","ink"] {
    let value=R.plan("el",map{style:map{preset:preset}});
    assert(value.foreground_background_contrast>=1 and value.foreground_background_contrast<=21,"finite contrast");
    assert(not value.rendering_performed and not value.persistence_performed and not value.safe_to_log,"no external effects or disclosure authority");
}
fn rejected(preferences_saved,operation=nil) {
    assert((try R.plan("el",preferences_saved,operation) catch nil)==nil,"invalid preference rejected");
}
for bad in [true,[],"el",1,map{unknown:true},map{style:nil},map{style:[]},map{style:map{html:"<b>"}},map{report_language:"fr"},map{report_language:[]},map{style:map{preset:"<style>"}},map{style:map{dense:1}},map{style:map{landscape:"true"}}] { rejected(bad); }
for size in [8,25,12.5,"12",true,nil,parse_number("NaN"),parse_number("inf")] { rejected(map{style:map{font_size:size}}); }
rejected(map{style:map{preset:"invalid"}},map{style:map{preset:"ink"}});
rejected(map{},map{style:map{unknown:false}});
assert((try R.plan("fr") catch nil)==nil,"unsupported UI language rejected");
print "report_customization_pass";
