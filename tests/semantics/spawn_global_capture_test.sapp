// Ensure spawned closures can reference transferable top-level globals.
let ch = channel();
let h = spawn(fn() {
    send(ch.sender, "Hello from thread!");
});
let msg = recv(ch.receiver);
if msg != "Hello from thread!" {
    throw "FAIL spawn_global_capture msg=" + str(msg);
}
join(h);
print "spawn_global_capture_pass";
