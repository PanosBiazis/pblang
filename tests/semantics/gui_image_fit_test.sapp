let GUI=import("stdlib:gui.sapp");
let UI=import("stdlib:modern_ui.sapp");
let red=[240,30,30,255];let green=[30,240,30,255];let blue=[30,30,240,255];let yellow=[240,240,30,255];
let planar=[[red,green,blue,yellow],[red,green,blue,yellow]];
let bytes=[99,99];
for row in planar {for pixel in row {for channel in pixel {array_push(bytes,channel);}} array_push(bytes,88);}
let packed=map{format:"pblang.image.rgba8.v1",width:4,height:2,bytes:bytes,offset:2,stride:17};
fn render(frame,fit,width=12,height=12,clip=nil) {
    let f=GUI.form("Framing",40,40);
    let w=GUI.image("sample",4,4,width,height,frame);
    if fit!=nil {w.fit=fit;} if clip!=nil {w.clip_rect=clip;}
    GUI.add(f,w);
    let pixels=map{};let counts=map{rect:0,point:0};
    let rect=fn(x,y,w,h,c){
        counts.rect=counts.rect+1;
        let iy=y;while iy<y+h {let ix=x;while ix<x+w {pixels[str(ix)+","+str(iy)]=c;ix=ix+1;}iy=iy+1;}
    };
    let win=map{clear:fn(c){},rect:rect,point:fn(x,y,c){counts.point=counts.point+1;rect(x,y,1,1,c);},
        line:fn(x,y,x2,y2,c){}};
    GUI.draw(win,f);return map{pixels:pixels,counts:counts};
}
for fit in [nil,"stretch","contain","cover"] {
    let a=render(planar,fit);let b=render(packed,fit);
    assert(a.pixels==b.pixels,"packed stride and offset match planar image");
    assert(a.counts.point==0,"upscaling remains source-pixel rectangles");
}
assert(render(planar,nil).pixels==render(planar,"stretch").pixels,"legacy fit stays stretch");
let contained=render(planar,"contain").pixels;
assert(contained["5,5"]==GUI.palette().field,"contain retains top letterbox");
assert(contained["5,8"]==red and contained["14,8"]==yellow,"contain keeps all image columns");
let cropped=render(planar,"cover").pixels;
assert(cropped["5,8"]==green and cropped["14,8"]==blue,"cover crops outer columns");
let downsized=render(planar,"cover",2,2);
assert(downsized.pixels["4,4"]==green and downsized.pixels["5,4"]==blue,"downsample crop uses correct source");
let rgb=map{format:"pblang.image.rgb8.v1",width:1,height:1,offset:0,stride:3,bytes:[240,30,30]};
assert(render(rgb,"contain").pixels["8,8"]==red,"RGB frame receives opaque alpha");
let clipped=render(planar,"cover",12,12,map{x:7,y:7,w:4,h:4});
for key in map_keys(clipped.pixels) {assert(map_has(cropped,key) and clipped.pixels[key]==cropped[key],"scroll clipping composes with image crop");}
let view=UI.screen([UI.image(planar,map{name:"photo",fit:"cover",h:120})]);
let form=UI.build("Image",view);let image=GUI.get(form,"photo");
assert(image.fit=="cover","declarative option reaches native widget");
GUI.relayout(form,480,320);assert(image.fit=="cover" and image.img==planar,"resize retains frame and fit");
for invalid in [nil,true,"zoom"] {
    assert(not UI.validate(UI.screen([UI.image(planar,map{fit:invalid})])).ok,"shared validation rejects invalid fit");
}
let solid=[[red,red,red,red,red],[red,red,red,red,red],[red,red,red,red,red]];
for size in [[1,1],[2,5],[5,2],[7,11],[11,7],[3,3],[9,4],[4,9]] {
    let filled=render(solid,"cover",size[0],size[1]);
    for y in range(4,4+size[1]) {for x in range(4,4+size[0]) {
        assert(filled.pixels[str(x)+","+str(y)]==red,"cover leaves no seams at fractional crop boundaries");
    }}
}
let reduced=render(planar,"stretch",2,1);
assert(reduced.counts.point==2 and reduced.pixels["4,4"]==red and reduced.pixels["5,4"]==blue,"downscale uses destination pixels");
print "gui_image_fit_pass";
