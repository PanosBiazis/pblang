let S=import("stdlib:study_cards.sapp"); let Before=import("../../bench/fixtures/study_cards_before_edit.sapp");
fn rejects(f) { let bad=false; try { f(); } catch { bad=true; } assert(bad,"invalid edit rejected"); }
let deck=S.create("Synthetic",[map{prompt:"Question",answer:"Answer"},map{prompt:"Other",answer:"Other answer"}],"2026-09-27");
deck=S.review(deck,1,"good","2026-09-27"); let before=S.encode(deck);
let edited=S.edit(deck,1,"Ερώτηση;","Απάντηση.\nSecond line.");
assert(edited.cards[0].prompt=="Ερώτηση;" and edited.cards[0].answer=="Απάντηση.\nSecond line.","Unicode multiline edit");
for key in ["id","stage","due","reviews","last_review","format"] { assert(edited.cards[0][key]==deck.cards[0][key],"progress and identity preserved"); }
assert(S.encode(deck)==before,"input unchanged"); assert(edited.cards[1]==deck.cards[1],"other card unchanged");
edited.cards[1].answer="Detached"; assert(deck.cards[1].answer=="Other answer","other cards detached too");
assert(S.encode(S.decode(S.encode(edited)))==S.encode(edited),"edit survives roundtrip");
assert(S.encode(edited)==Before.encode(edited),"exact old/new encoding including Unicode");
for id in [0,3,65,1.5,"1",nil,true] { rejects(fn(){S.edit(deck,id,"Q","A");}); }
for text in ["","  ",nil,true,12,"x\u0000y",str_repeat("q",1025),str_repeat("α",513)] { rejects(fn(){S.edit(deck,1,text,"A");}); }
rejects(fn(){S.edit(deck,1,"Q",str_repeat("a",4097));});
let pairs=[]; for i in range(0,64) {array_push(pairs,map{prompt:"Q",answer:str_repeat("a",510)});}
let maximum=S.create("",pairs,"2026-09-27");
assert(S.encode(maximum)==Before.encode(maximum),"maximum-count exact encoding");
rejects(fn(){S.edit(maximum,1,"Q",str_repeat("a",600));});
let edge=S.edit(deck,1,str_repeat("α",512),str_repeat("β",2048)); assert(S.validate(edge),"UTF-8 limits accepted exactly");
assert(S.encode(edge)==Before.encode(edge),"maximum card exact encoding");
let invalid=S.copy(deck); invalid.cards[0].extra=true;
rejects(fn(){S.encode(invalid);}); rejects(fn(){Before.encode(invalid);});
assert(S.encode(deck)==before,"rejections and encoding do not mutate input");
print "study_edit_pass";
