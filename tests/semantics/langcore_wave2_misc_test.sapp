// tests/semantics/langcore_wave2_misc_test.sapp — wave 2: semver diff/sort_desc,
// result.collect, option.zip/flatten.

let S = import("stdlib/semver.sapp");
let R = import("stdlib/result.sapp");
let O = import("stdlib/option.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn arreq(a, b, m) {
    if len(a) != len(b) { fail(m + " len " + str(a)); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " [" + str(i) + "] " + str(a)); } i = i + 1; }
}

// ── semver.diff / sort_desc ──────────────────────────────────────────────────────
eq(S.diff("1.0.0", "2.0.0"), "major", "major diff");
eq(S.diff("1.1.0", "1.2.0"), "minor", "minor diff");
eq(S.diff("1.1.1", "1.1.2"), "patch", "patch diff");
eq(S.diff("1.1.1", "1.1.1"), "none", "no diff");
arreq(S.sort_desc(["1.0.0", "2.0.0", "1.5.0"]), ["2.0.0", "1.5.0", "1.0.0"], "sort_desc");

// ── result.collect ───────────────────────────────────────────────────────────────
let c = R.collect([R.ok(1), R.ok(2), R.ok(3)]);
if not R.is_ok(c) { fail("all ok -> Ok"); }
arreq(R.unwrap(c), [1, 2, 3], "collected values");
let c2 = R.collect([R.ok(1), R.err("boom"), R.ok(3)]);
if not R.is_err(c2) { fail("any err -> Err"); }
eq(R.unwrap_err(c2), "boom", "first error returned");

// ── option.zip / flatten ─────────────────────────────────────────────────────────
let z = O.zip(O.some(1), O.some(2));
if not O.is_some(z) { fail("zip of two Some -> Some"); }
arreq(O.unwrap(z), [1, 2], "zip pairs values");
if O.is_some(O.zip(O.some(1), O.none())) { fail("zip with None -> None"); }

let f = O.flatten(O.some(O.some(5)));
if not O.is_some(f) { fail("flatten Some(Some) -> Some"); }
eq(O.unwrap(f), 5, "flattened value");
eq(O.unwrap(O.flatten(O.some(9))), 9, "non-nested option unchanged");
if O.is_some(O.flatten(O.none())) { fail("flatten None -> None"); }

print "langcore_wave2_misc_pass";
