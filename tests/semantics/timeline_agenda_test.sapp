let A=import("stdlib:timeline_agenda.sapp");let T=import("stdlib:timeline_document.sapp");let D=import("stdlib:text_document.sapp");
assert(A.clock_ms("00:00")==0 and A.clock_ms("23:59")==86340000,"clock endpoints");
for c in [nil,0,true,"9:00","09:0","24:00","00:60","-1:00","09:00 "," 9:00","09.00","１２:00","aa:bb","1e:00","09:00\n"] {assert((try A.clock_ms(c) catch nil)==nil,"strict HH:MM rejection");}
let t=T.set_entry(T.create("Νυχτερινό πρόγραμμα"),0,"Later",60000,60001);t=T.append(t,"Earlier",59999,60000);t=T.append(t,"Overlap",59999,60001);let before=T.encode(t);
let r=A.project(t,"23:59");assert(r.entries[0].start=="D+1 00:00:00.000" and r.entries[0].end=="D+1 00:00:00.001","midnight exact milliseconds");
assert(r.entries[1].start=="D+0 23:59:59.999" and r.entries[1].end=="D+1 00:00:00.000","one millisecond rollover");
assert(r.entries[0].source_index==0 and r.entries[0].label=="Later" and r.entries[1].label=="Earlier","input order retained, no reschedule");
assert(r.entries[0].overlaps==1 and r.entries[1].overlaps==1 and r.entries[2].overlaps==2 and r.overlap_pairs==2,"half open touching intervals");
assert(r.entries[0].duration_ms==1 and r.gap_ms==0,"exact durations and gaps");
let writer=A.to_document(t,"23:59");assert(len(writer.blocks)==3 and writer.title==t.title and str_contains(writer.blocks[0].text,"no dates/timezones/DST") and str_contains(writer.blocks[0].text,"1. Later"),"Writer assumptions and first activity in same block");
assert(D.decode(D.encode(writer))==writer,"Writer roundtrip");r.entries[0].label="Changed";writer.blocks[0].text="Changed";assert(T.encode(t)==before,"detached results");
let maximum=T.set_entry(T.create(str_repeat("界",80)),0,str_repeat("界",80),359999998,359999999);
assert(A.project(maximum,"23:59").entries[0].end=="D+5 03:58:59.999","maximum supported offset");
for i in range(1,64) {maximum=T.append(maximum,str_repeat("界",80),i,i+1);}
let full=A.to_document(maximum,"23:59");assert(len(full.blocks)==64 and D.validate(full).text_bytes<=D.MAX_TOTAL_BYTES,"all64 widest labels supported without truncation");
for i in range(0,64) {assert(str_contains(full.blocks[i].text,maximum.entries[i].label),"each full label retained");}
let broken=T.copy(t);broken.entries[0].end_ms=60000;assert((try A.project(broken,"09:00") catch nil)==nil,"bad timeline rejected");
let gaps=T.set_entry(T.create(),0,"First",1000,2000);gaps=T.append(gaps,"Second",3000,4000);assert(A.project(gaps,"09:00").gap_ms==1000,"internal gaps exclude waiting before first");
assert(T.encode(t)==before,"source unchanged by failed operations");print "timeline_agenda_pass";
