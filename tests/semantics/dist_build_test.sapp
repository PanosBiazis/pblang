// tests/semantics/dist_build_test.sapp
//
// stdlib/dist.sapp — cross-OS executable builder, written in pblang. It drives
// `pblang transpile` (pblang -> portable C) and then a C compiler per target,
// so producing native executables for every OS needs NO Rust rebuild — the
// orchestration lives in pblang itself.
//
// This test proves the real end-to-end path on the host: build a tiny pblang
// program to a native executable and RUN it.

let dist = import("stdlib/dist.sapp");

fn fail(m) { throw "FAIL " + m; }
fn has(arr, v) { for x in arr { if x == v { return true; } } return false; }

// 1. The host target must be discoverable (this machine has a C compiler).
let avail = dist.available_targets();
let names = [];
for t in avail { array_push(names, t.name); }
if not has(names, "linux-x64") {
    fail("linux-x64 must be available on this host (cc/gcc/clang present)");
}

// 2. The full catalog must advertise the major desktop OSes regardless of which
//    toolchains are installed (availability is a separate query).
let cat_names = [];
for t in dist.all_targets() { array_push(cat_names, t.name); }
if not has(cat_names, "windows-x64") { fail("catalog must include windows-x64"); }
if not has(cat_names, "macos-arm64") { fail("catalog must include macos-arm64"); }

// 3. Build a real native executable and run it.
let stamp = str(num_floor(now_ms()));
let src = "/tmp/pbdist_" + stamp + ".sapp";
fs_write(src, "let x = 6; let y = 7; print x * y;\n");
let out_base = "/tmp/pbdist_" + stamp + "_bin";
let r = dist.build(src, "linux-x64", out_base);
if not r.ok { fail("native build failed: " + str(r.stderr)); }

let run = proc_spawn_wait(r.output, []);
let got = str_trim(run.stdout);
if got != "42" { fail("native exe must print 42, got: " + got); }

// 4. Optimization profiles are real and measurable: a size-optimized, stripped
//    build must run correctly AND be meaningfully smaller than a debug build.
let dbg = dist.build(src, "linux-x64", out_base + "_dbg", map{ opt: "debug" });
let small = dist.build(src, "linux-x64", out_base + "_small",
                       map{ opt: "size", strip: true, static: false });
if not small.ok { fail("size-optimized build failed: " + str(small.stderr)); }
if small.size == nil or dbg.size == nil { fail("builds must report a byte size"); }
if not (small.size < dbg.size) {
    fail("size+strip build (" + str(small.size) + ") must be smaller than debug (" + str(dbg.size) + ")");
}
let run2 = proc_spawn_wait(small.output, []);
if str_trim(run2.stdout) != "42" { fail("size-optimized exe must still print 42"); }

// 5. release() produces a runnable, fully-portable (static where supported) binary.
let rel = dist.release(src, out_base + "_rel", nil);
if not rel.ok { fail("release build failed: " + str(rel.stderr)); }
let run3 = proc_spawn_wait(rel.output, []);
if str_trim(run3.stdout) != "42" { fail("release exe must print 42"); }

// 6. A release channel changes the published filename only after the developer
//    explicitly opts into artifact labelling.
let beta = dist.build(src, "linux-x64", out_base + "_channel", map{
    release_channel:"beta.1", release_channel_in_artifact:true
});
if not beta.ok { fail("channel-labelled build failed: " + str(beta.stderr)); }
if not str_ends_with(beta.output, "_channel--channel-beta.1") {
    fail("channel-labelled artifact has unexpected name: " + beta.output);
}
if str_trim(proc_spawn_wait(beta.output, []).stdout) != "42" {
    fail("channel-labelled executable must preserve program behavior");
}

print "dist_build_pass";
