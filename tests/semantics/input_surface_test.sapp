let I=import("stdlib:input_surface.sapp");
fn check(v){if not v{throw "input surface regression";}}
let corner=[map{x:0,y:0},map{x:200,y:100}];
let t=I.transform(map{width:200,height:100,rotation:90},corner);
check(t.points[0].x==1 and t.points[0].y==0 and t.points[1].x==0 and t.points[1].y==1);
check(I.transform(map{width:200,height:100,mirror_x:true},corner).points[0].x==1);
for bad in [map{width:0,height:1},map{width:1,height:1,rotation:45},map{width:1,height:1,mirror_x:1},map{width:1,height:1,path:"private"}]{
    check((try I.transform(bad,[]) catch nil)==nil);
}
check((try I.transform(map{width:1,height:1},[map{x:2,y:0}]) catch nil)==nil);
let rows=[map{contact_id:1,kind:"pen",phase:"start",time_ms:0,x:0,y:0,pressure:0.2,tilt_x:-20},
    map{contact_id:2,kind:"touch",phase:"start",time_ms:1,x:1,y:1},
    map{contact_id:1,kind:"pen",phase:"move",time_ms:2,x:0.5,y:0.5,pressure:0.8,tilt_y:30},
    map{contact_id:1,kind:"pen",phase:"end",time_ms:3,x:1,y:1},
    map{contact_id:2,kind:"touch",phase:"cancel",time_ms:4,x:1,y:1}];
let r=I.analyze(rows);check(r.complete and r.peak_contacts==2 and r.duration_ms==4 and r.mean_pressure==0.5);
check(r.contacts_cancelled==1 and r.max_absolute_tilt==30 and not r.coordinates_included);
check(not I.analyze([rows[0]]).complete);
check((try I.analyze([rows[2]]) catch nil)==nil);
check((try I.analyze([rows[0],rows[0]]) catch nil)==nil);
check((try I.analyze([rows[1],rows[0]]) catch nil)==nil);
check((try I.analyze([rows[0],map{contact_id:1,kind:"touch",phase:"end",time_ms:1,x:0,y:0}]) catch nil)==nil);
check(I.analyze([rows[0],rows[3],map{contact_id:1,kind:"touch",phase:"start",time_ms:4,x:0,y:0}]).contacts_started==2);
for bad in [map{contact_id:32,kind:"touch",phase:"start",time_ms:0,x:0,y:0},
    map{contact_id:0,kind:"touch",phase:"start",time_ms:0,x:0,y:0,pressure:0},
    map{contact_id:0,kind:"pen",phase:"start",time_ms:0,x:0,y:0,pressure:2},
    map{contact_id:0,kind:"pen",phase:"start",time_ms:0,x:0,y:0,tilt_y:91}]{check((try I.analyze([bad]) catch nil)==nil);}
let many=[];for i 257{many[len(many)]=rows[0];}check((try I.analyze(many) catch nil)==nil);
check(I.analyze([]).complete);
print "input surface tests passed";
