// tests/semantics/game_enrich2_test.sapp — wave 2 enrichment for stdlib/game.sapp
// Scalar/angle helpers + cubic easing + vec2 perp/project.

let G = import("stdlib/game.sapp");

fn fail(m) { throw "FAIL " + m; }
fn approx(a, b, m) { if (a - b) > 0.001 or (b - a) > 0.001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── scalar helpers ────────────────────────────────────────────────────────────────
approx(G.lerp(0, 10, 0.5), 5, "lerp");
approx(G.clamp(15, 0, 10), 10, "clamp high");
approx(G.clamp(-3, 0, 10), 0, "clamp low");
approx(G.clamp(5, 0, 10), 5, "clamp mid");

// ── angle conversion ────────────────────────────────────────────────────────────
approx(G.deg_to_rad(180), 3.14159265, "deg_to_rad 180");
approx(G.rad_to_deg(3.14159265), 180, "rad_to_deg pi");

// ── cubic easing endpoints ────────────────────────────────────────────────────────
approx(G.ease_in_cubic(0), 0, "ease_in_cubic(0)");
approx(G.ease_in_cubic(1), 1, "ease_in_cubic(1)");
approx(G.ease_in_cubic(0.5), 0.125, "ease_in_cubic(0.5)");
approx(G.ease_out_cubic(0), 0, "ease_out_cubic(0)");
approx(G.ease_out_cubic(1), 1, "ease_out_cubic(1)");
approx(G.ease_in_out_cubic(0.5), 0.5, "ease_in_out_cubic(0.5)");

// ── vec2 perp / project ────────────────────────────────────────────────────────────
let p = G.vec2_perp(G.vec2(1, 0));   // -> (0, 1)
approx(p.x, 0, "perp.x"); approx(p.y, 1, "perp.y");
// project (3,3) onto x-axis (2,0) -> (3,0)
let pr = G.vec2_project(G.vec2(3, 3), G.vec2(2, 0));
approx(pr.x, 3, "project.x"); approx(pr.y, 0, "project.y");

print "game_enrich2_pass";
