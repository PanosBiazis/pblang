let Style=import("stdlib:ui_style.sapp");
let Colors=import("stdlib:colors.sapp");
let UI=import("stdlib:modern_ui.sapp");
let GUI=import("stdlib:gui.sapp");
let Web=import("stdlib:modern_ui_web.sapp");
let Android=import("stdlib:modern_ui_android.sapp");
fn rgb(value){return map{r:value[0],g:value[1],b:value[2]};}
fn contains(bytes,text) {
    let i=0;
    while i+len(text)<=len(bytes) {
        let j=0;
        while j<len(text) and bytes[i+j]==strcharcodeat(text,j) {j=j+1;}
        if j==len(text){return true;} i=i+1;
    }
    return false;
}
let view=UI.screen([
    UI.heading("Workspace",map{name:"title"}),
    UI.card([UI.text("Ready",map{name:"status",tone:"success"}),
        UI.button("Save",UI.action_set_text("status","Saved"),map{name:"save",variant:"primary"}),
        UI.button("Cancel",nil,map{name:"cancel",variant:"secondary"}),
        UI.button("Delete",nil,map{name:"delete",variant:"danger"}),
        UI.button("Active",nil,map{name:"active",variant:"navigation",selected:true}),
        UI.button("Disabled",nil,map{name:"disabled",enabled:false})],map{title:"Actions"})]);
for name in ["dark","light"] {
    let options=Style.options(name); let colors=options.palette;
    for pair in [["text","bg"],["text","panel"],["muted","bg"],["muted","panel"],
        ["on_accent","accent"],["on_accent","selected"],["on_accent","danger"]] {
        assert(Colors.contrast_ratio(rgb(colors[pair[0]]),rgb(colors[pair[1]]))>=4.5,
            "preset normal text contrast >= 4.5:1");
    }
    let form=UI.build("Synthetic",view,options);
    assert(form.card_radius==14 and form.text_render=="auto","opt-in shared presentation");
    assert(str(form.palette.accent)==str(colors.accent),"native palette");
    let web=Web.generate("Synthetic",UI.compile(view,map{target:"web"}),options);
    assert(str_contains(web.html,"aria-pressed=\"true\""),"selected state exposed");
    assert(str_contains(web.css,".pb-card{border-radius:14px}"),"web corner token");
    let secondary=Style.button(colors,"secondary");
    assert(str(secondary.fill)==str(colors.panel) and str(secondary.text)==str(colors.text),
        "secondary text is legible on panel");
    let android=Android.generate("Synthetic",UI.compile(view,map{target:"android"}),options);
    assert(contains(android.class_bytes,"setCornerRadius") and contains(android.class_bytes,"setStroke"),
        "Android rounded native card background emitted");
    assert(android.actions==1,"portable actions retained");
    GUI.get(form,"save").onclick(form);
    assert(GUI.get(form,"status").text=="Saved","native local action retained");
}
let one=Style.palette();one.bg[0]=99;
assert(Style.palette().bg[0]==15,"presets own fresh nested color arrays");
assert((try Style.options("unknown") catch nil)==nil,"invalid theme rejected");
for radius in [-1,33,1.5,"14",true] {
    assert((try Style.card_radius(map{card_radius:radius}) catch "rejected")=="rejected",
        "invalid radius rejected");
}
assert(Style.card_radius(map{})==nil and Style.card_radius(map{card_radius:0})==0,
    "absent and square corners remain distinct");
let bundle=UI.compile(view,map{target:"android"});
assert((try Android.generate("Synthetic",bundle,map{palette:map{unknown:[1,2,3]}}) catch nil)==nil,
    "Android rejects unknown palette role instead of ignoring it");
let legacy=Android.generate("Synthetic",bundle);
assert(not contains(legacy.class_bytes,"GradientDrawable"),"legacy Android card unchanged");
let web=Web.generate("Synthetic",UI.compile(view,map{target:"web"}));
assert(str_contains(web.css,"background:rgb(235,238,246)")==false,"dark palette stays dark");
assert(str_contains(web.css,"color:rgb(225,230,245)"),"secondary web text uses foreground");
// Palette values change generated Android constants; metadata alone is insufficient.
let a=Android.generate("Synthetic",bundle,map{palette:map{accent:[1,2,3]}});
let b=Android.generate("Synthetic",bundle,map{palette:map{accent:[4,5,6]}});
assert(sha256(json_stringify(a.class_bytes))!=sha256(json_stringify(b.class_bytes)),"Android honors accent override");
print "ui_style_pass";
