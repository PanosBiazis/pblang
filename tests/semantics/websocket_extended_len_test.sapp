// websocket_extended_len_test.sapp
// Verify 16-bit extended payload length encoding/decoding (>125 bytes).
import "stdlib:websocket.sapp";

let payload = "";
let i = 0;
while i < 130 {
    payload = payload + "x";
    i = i + 1;
}

let frame = websocket.write_frame(1, payload);

// Byte 1: MASK=1 + 126 marker => 254
let b1 = strcharcodeat(frame, 1);
if b1 != 254 { print "FAIL b1 expected 254 got " + str(b1); }

// Next two bytes: payload length (130 => 0x00 0x82)
let l0 = strcharcodeat(frame, 2);
let l1 = strcharcodeat(frame, 3);
if l0 != 0 or l1 != 130 { print "FAIL extended length bytes"; }

// Total frame length = 2 header + 2 extlen + 4 mask + payload
if len(frame) != 138 { print "FAIL frame length " + str(len(frame)); }

let parsed = websocket.parse_frame(frame);
if parsed["payload_len"] != 130 { print "FAIL parsed payload_len"; }
if parsed["payload"] != payload { print "FAIL parsed payload"; }

print "websocket_extended_len_pass";
