let W=import("stdlib:work_calendar.sapp");
fn rejects(f) {let bad=false;try {f();}catch {bad=true;}assert(bad,"invalid calendar rejected");}
assert(W.add("2026-09-25",1)=="2026-09-28","weekend skipped");
assert(W.add("2026-09-25",1,nil,["2026-09-28"])=="2026-09-29","explicit closure skipped");
assert(W.add("2026-09-28",-1)=="2026-09-25","reverse excludes starting date");
assert(W.add("2026-09-27",0)=="2026-09-27","zero retains closed start");
assert(W.add("2024-02-28",1)=="2024-02-29","leap day");
assert(W.add("2026-09-27",1,[6])=="2026-10-04","custom week");
let report=W.between("2026-09-25","2026-09-29",nil,["2026-09-28"]);assert(report.dates==["2026-09-25","2026-09-29"] and report.count==2,"inclusive interval");
assert(not W.is_workday("2026-09-27") and W.is_workday("2026-09-27",[6]),"explicit weekdays");
for f in [fn(){W.add("0001-01-01",-1);},fn(){W.add("9999-12-31",1);},fn(){W.add("2026-09-27",367);},fn(){W.add("2026-09-27",1.5);},fn(){W.add("2026-09-27",1,[]);},fn(){W.add("2026-09-27",1,[0,0]);},fn(){W.add("2026-09-27",1,[7]);},fn(){W.add("2026-09-27",1,nil,["2026-02-30"]);},fn(){W.add("2026-09-27",1,nil,["2026-09-28","2026-09-28"]);},fn(){W.between("2026-09-28","2026-09-27");},fn(){W.between("2020-01-01","2031-01-01");}] {rejects(f);}
let end=W.add("2026-09-27",366,[6]);assert(W.add(end,-366,[6])=="2026-09-27","maximum offset invertible from workday");print "work_calendar_pass";
