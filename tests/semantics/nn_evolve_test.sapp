// tests/semantics/nn_evolve_test.sapp — NN clone / merge / safe_merge / safe split +
// an OOP model wrapper. Pure structural ops (no long training needed).

let nn = import("stdlib/nn.sapp");

fn fail(m) { throw "FAIL " + m; }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.00001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn veq(a, b, m) { if len(a) != len(b) { fail(m + " length"); } let i = 0; while i < len(a) { approx(a[i], b[i], m + "[" + str(i) + "]"); i = i + 1; } }

let data = [ nn.sample([0, 0], [0]), nn.sample([0, 1], [1]), nn.sample([1, 0], [1]), nn.sample([1, 1], [0]) ];
let x = [1, 0];

// ── clone: deep copy; training the clone must not change the original ──────────────
let net = nn.mlp_new(2, 3, 1, 7);
let y0 = nn.predict(net, x);
let c = nn.clone(net);
nn.train(c, data, 20, 0.5);
veq(nn.predict(net, x), y0, "clone is independent (original unchanged after training clone)");
if nn.loss(c, data) >= nn.loss(net, data) and false { fail("unreachable"); }   // loss() exists

// ── merge: weighted average of two same-shape nets ────────────────────────────────
let a = nn.mlp_new(2, 3, 1, 1);
let b = nn.mlp_new(2, 3, 1, 99);
veq(nn.predict(nn.merge(a, b, 1), x), nn.predict(a, x), "merge alpha=1 == a");
veq(nn.predict(nn.merge(a, b, 0), x), nn.predict(b, x), "merge alpha=0 == b");
veq(nn.predict(nn.merge(a, a, 0.5), x), nn.predict(a, x), "merge of identical == identity");

// ── safe_merge: never worse than the better parent ────────────────────────────────
let sm = nn.safe_merge(a, b, data, 0.5);
let la = nn.loss(a, data); let lb = nn.loss(b, data);
let best = la; if lb < best { best = lb; }
if nn.loss(sm.net, data) > best + 0.00001 { fail("safe_merge must be <= best parent loss"); }
if sm.merged != true and sm.merged != false { fail("safe_merge reports merged flag"); }

// ── split_neuron: function-PRESERVING widening (output unchanged, hidden grows) ────
let s = nn.split_neuron(net, 0);
veq(nn.predict(s, x), nn.predict(net, x), "split preserves the function");
if s.l1.n_out != net.l1.n_out + 1 { fail("split adds one hidden neuron (l1)"); }
if s.l2.n_in != net.l2.n_in + 1 { fail("split widens l2 input"); }

// ── OOP model wrapper: encapsulated object with methods ────────────────────────────
let m = nn.model(nn.mlp_new(2, 3, 1, 5));
veq(m.predict(x), nn.predict(m.net, x), "model.predict matches");
let acc = m.accuracy(data);
if acc < 0 or acc > 1 { fail("model.accuracy in [0,1]"); }
let m2 = m.split(0);
if m2.net.l1.n_out != m.net.l1.n_out + 1 { fail("model.split grows hidden"); }
veq(m2.predict(x), m.predict(x), "model.split preserves function");
let mc = m.clone();
mc.train(data, 10, 0.5);
veq(m.predict(x), nn.predict(m.net, x), "model.clone is independent");

print "nn_evolve_pass";
