let App=import("../../examples/declarative_browser/app.sapp");let GUI=import("stdlib:gui.sapp");let D=import("stdlib:browser_document.sapp");
let n=0;fn check(ok,label){assert(ok,label);n=n+1;}
fn key(c,k){App.update(c,[map{type:"keydown",key:k},map{type:"keyup",key:k}]);}
fn resize(c,w,h){App.update(c,[map{type:"resize",w:w,h:h}]);}
fn make(){let c=App.create("local","dark",map{title_size:40,font_scale:1.5});assert(GUI.get(c.form,"block2")!=nil,"fixture wide guide link is visible");c.form.focus="block2";return c;}
let c=make();let before=c.session.snapshot();let content=D.export_html(before.document);let appearance=c.appearance;
resize(c,320,240);check(not c.reading_plan.available and c.form.focus==nil,"large-text layout is unavailable without focusing an invisible button");let anchor=c.reading_anchor;
resize(c,340,250);resize(c,800,816);check(c.form.focus=="block2" and GUI.get(c.form,"block2")!=nil,"focused link returns after unavailable resize round trip");
check(c.resize_focus==nil and c.reading_anchor==anchor,"deferred focus is consumed while typed reading anchor remains");check(c.session.snapshot()==before and D.export_html(c.session.snapshot().document)==content and c.appearance==appearance,"layout recovery preserves document and appearance");key(c,"Enter");check(c.session.snapshot().url=="pb://guide" and c.navigations==1,"restored Enter navigates once");c.session.close();
// Passive events do not replace intent; actual new keyboard/pointer actions do.
for event in [map{type:"mousemove",x:310,y:235},map{type:"keyup",key:"LShift"},map{type:"tick"}] {
 let reader=make();resize(reader,320,240);App.update(reader,[event]);resize(reader,800,816);check(reader.form.focus=="block2","passive event preserves deferred link");reader.session.close();
}
for event in [map{type:"keydown",key:"Tab"},map{type:"keydown",key:"Home"},map{type:"mousedown",x:315,y:235},map{type:"scroll",dx:0,dy:1}] {
 let reader=make();resize(reader,320,240);App.update(reader,[event]);let focus=reader.form.focus;check(reader.resize_focus==nil,"new input cancels deferred focus");resize(reader,800,816);check(reader.form.focus==focus and reader.form.focus!="block2","recovery never steals focus after input");reader.session.close();
}
let replaced=make();resize(replaced,320,240);replaced.session.navigate("pb://about");resize(replaced,800,816);check(replaced.resize_focus==nil and replaced.form.focus==nil,"external document change clears deferred link");replaced.session.close();
let style=make();resize(style,320,240);GUI.get(style.form,"appearance").onclick(style.form);App.update(style,[]);check(style.resize_focus==nil and style.settings,"programmatic Style opening clears deferred link");style.session.close();
let explicit=make();resize(explicit,320,240);explicit.focus_target="appearance";App.refresh(explicit);resize(explicit,800,816);check(explicit.resize_focus==nil and explicit.form.focus=="appearance","explicit focus wins");explicit.session.close();
let closed=make();resize(closed,320,240);App.update(closed,[map{type:"close"},map{type:"resize",w:800,h:816}]);check(closed.form.close_requested and closed.resize_focus==nil,"close clears deferred state and prevents recovery");closed.session.close();
let plain=App.create("local","dark",map{title_size:40,font_scale:1.5});resize(plain,320,240);resize(plain,800,816);check(plain.form.focus==nil and plain.resize_focus==nil,"no prior link focus creates no deferred target");plain.session.close();
print "reader_focus_recovery_pass checks="+str(n);
