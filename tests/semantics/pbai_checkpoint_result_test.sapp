let N=import("stdlib:pbai_neural_adapter.sapp");let IO=import("stdlib:pbai_student_checkpoint_io.sapp");
fn rejects(f){return try {f();false} catch true;}
let long="";for i 4097 {long=long+"x";}let unicode="";for i 2100 {unicode=unicode+"α";}
let cycle=[];push(cycle,cycle);let cases=0;
for text in [nil,true,1,[],cycle,map{},long,unicode,"{","{\"a\":1,\"a\":2}","[[[[[0]]]]]"] {
 let result=N.student_decode_result(text);assert(result==map{ok:false,error:"invalid student checkpoint encoding"},"bounded exact encoding error");
 assert(rejects(fn(){N.student_decode(text);}),"legacy encoding still throws");cases=cases+1;
}
for text in ["{}","[]","null","1","true"] {
 assert(N.student_decode_result(text)==map{ok:false,error:"invalid student checkpoint"},"decoded invalid artifact distinguished");cases=cases+1;
}
for path in [nil,true,1,[],cycle,map{},"",long,"private"+strfromcharcode(0)] {
 assert(IO.load_file_result(path)==map{ok:false,error:"invalid checkpoint path"},"invalid path rejected before backend access");
 assert(rejects(fn(){IO.load_file(path);}),"legacy path still throws");cases=cases+1;
}
let teacher=N.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let seed=N.distill(teacher.artifact,[[0]],[map{x:[7,0],y:4}]);let artifact=seed.checkpoint();assert(seed.close(),"fixture seed owned");
let text=N.student_encode(artifact);let result=N.student_decode_result(text);
assert(result.ok and len(result)==2 and result.value==N.student_decode(text),"checked and throwing decode have identical successful artifacts");
let loaded=N.student_load(result.value);let before=json_stringify(loaded.predict([6,0]));result.value.a[0][0]=999;
assert(json_stringify(loaded.predict([6,0]))==before and loaded.close(),"successful result detached from loaded owner");
assert(N.student_encode(N.student_decode_result(text).value)==text,"fresh decode remains unchanged");
print json_stringify(map{format:"pbai.checkpoint-result.v1",negative_cases:cases,success_compatibility:true});
