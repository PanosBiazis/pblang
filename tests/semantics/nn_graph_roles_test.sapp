// tests/semantics/nn_graph_roles_test.sapp — self-typing nodes: each node DECIDES its own
// role from its data-flow connectivity (input/output/hidden/isolated), chooses where data
// flows (route), and picks its processing (activation) from that role.

let G = import("stdlib/nn_graph.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let g = G.graph_new();
G.add_node(g, 0, "linear");   // 0
G.add_node(g, 0, "linear");   // 1
G.add_node(g, 0, "linear");   // 2
G.add_node(g, 0, "linear");   // 3 (left isolated)
G.add_bond(g, 0, 1, 1);
G.add_bond(g, 1, 2, 1);

// ── a node decides what type it wants to be, from how data flows through it ────────
eq(G.decide_role(g, 0), "input", "source node -> input");
eq(G.decide_role(g, 1), "hidden", "in+out node -> hidden");
eq(G.decide_role(g, 2), "output", "sink node -> output");
eq(G.decide_role(g, 3), "isolated", "no bonds -> isolated");

// auto_type tags every node and tallies the roles
let counts = G.auto_type(g);
eq(counts.input, 1, "one input"); eq(counts.hidden, 1, "one hidden");
eq(counts.output, 1, "one output"); eq(counts.isolated, 1, "one isolated");

// manual override: a node can choose its role
G.set_role(g, 3, "input");
eq(G.get_role(g, 3), "input", "node can choose its own role");

// ── the node decides where data flows (its strongest outgoing path) ───────────────
G.add_bond(g, 1, 3, 5);                // node 1 now also feeds node 3, more strongly
eq(G.route(g, 1), 3, "node routes data along its strongest outgoing bond");

// ── the node decides its processing (activation) from its role ────────────────────
G.auto_process(g);
eq(G.get_choice(g, 0), "linear", "input processes linearly");
eq(G.get_choice(g, 2), "sigmoid", "output squashes");
// node 1 became hidden -> tanh
G.decide_role(g, 1); G.auto_process(g);
eq(G.get_choice(g, 1), "tanh", "hidden uses tanh");

print "nn_graph_roles_pass";
