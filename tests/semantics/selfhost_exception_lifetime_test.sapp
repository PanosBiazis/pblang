let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let P=import("stdlib:selfhost_pbck.sapp");
let C=import("stdlib:compiler/codegen.sapp");
fn check(ok,label){if not ok {throw "FAIL exception-lifetime: "+label;}}
fn run(source,want){
    let c=F.frontend_compile(source);check(c.ok,"compile "+str(c.diagnostics));
    let plain=V.run(c.chunk);
    let optimized=F.frontend_run(source);
    let decoded=V.run(P.deserialize_chunk(P.serialize_chunk(c.chunk)));
    check(plain.globals.result==want and optimized.globals.result==want and decoded.globals.result==want,"result parity");
    for value in plain.locals {check(value==nil,"failed body drops references");}
    for value in decoded.locals {check(value==nil,"serialized cleanup");}
    return plain;
}
run("let result=try (if true {let v=[1,2];throw 77;v;} else {[];}) catch [3];",[3]);
run("fn fail(){throw 77;} let result=try (if true {let v=map{n:2};fail();v;} else {map{n:0};}) catch map{n:3};",map{n:3});
run("let result=try (if true {let empty=[];let v=[1];let z=empty[3];v;} else {[];}) catch [5];",[5]);
run("let keep=map{n:0};let result=try (if true {let v=map{n:5};keep=v;throw 77;v;} else {map{n:0};}) catch keep;",map{n:5});
run("let result=try (if true {let a=[1];let b=try (if true {let c=[2];throw 1;c;} else {[];}) catch (if true {let d=[3];throw 2;d;} else {[];});b;} else {[];}) catch [4];",[4]);
run("let result=try (if true {throw 1;let never=[8];never;} else {[];}) catch [9];",[9]);
run("let events=[];let result=try (if true {let v=[1];array_push(events,1);throw 1;v;} else {[];}) catch (if true {array_push(events,2);events;} else {[];});",[1,2]);
// Inherited caller slots remain intact when a nested try fails.
run("fn f(x){let r=try (if true {let y=[2];throw 1;y;} else {[];}) catch x;return r;} let result=f([7]);",[7]);
// An unexecuted declaration must not grow a bounded frame in its catch path.
let c=F.frontend_compile("let result=try (if true {throw 1;let a=[1];let b=[2];let c=[3];c;} else {[];}) catch [4];");
let bounded=V.run_bounded(c.chunk,map{max_locals:1,max_steps:1000});
check(bounded.globals.result==[4] and len(bounded.locals)==0,"no nil slot materialization");
// Values captured before failure survive through the handler and native lowering.
let captured=F.frontend_run("let f=fn(){return [0];};let result=try (if true {let v=[6];f=fn(){return v;};throw 1;v;} else {[];}) catch f();");
check(captured.ok and captured.globals.result==[6],"escaping capture");
// Inspect the caller-owned frame at handler entry, not just after completion.
let parsed=F.frontend_parse_full("let result=try (if true {let v=[1];throw 7;v;} else {[];}) catch (if len(frame)==1 and frame[0]==nil {1;} else {0;});");
let chunk=C.compile_stmts(parsed.ast.stmts);
let frame=[];
let globals=map{frame:frame};
V.exec(chunk,frame,globals,[],[]);
check(globals.result==1,"cleanup precedes handler evaluation");
print "selfhost_exception_lifetime_pass";
