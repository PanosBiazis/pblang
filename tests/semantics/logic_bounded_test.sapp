let Logic = import("stdlib:logic.sapp");

fn require(value, message) {
    if not value { throw "logic bounded test failed: " + message; }
}

fn rejects(run, label) {
    let rejected = false;
    try { run(); } catch error { rejected = true; }
    require(rejected, label);
}

let database = Logic.db();
Logic.fact(database, "edge", ["a", "b"]);
Logic.fact(database, "edge", ["a", "c"]);
Logic.fact(database, "edge", ["b", "d"]);

let X = Logic.var("X");
let Y = Logic.var("Y");
let distinct_edges = Logic.where_bounded(database, [
    Logic.pred("edge", [X, Y]),
    Logic.not_equal(X, Y)
], map{ max_steps: 100, max_solutions: 8, max_depth: 8 });
require(distinct_edges.ok and not distinct_edges.truncated,
    "bounded inequality query must complete");
require(Logic.select(distinct_edges.rows, [X, Y]) == [
    ["a", "b"], ["a", "c"], ["b", "d"]
], "ground inequality must retain distinct endpoints");

let equal_rows = Logic.where_bounded(database, [
    Logic.pred("edge", ["a", X]), Logic.equal(X, "b")
], map{ max_steps: 100, max_solutions: 8, max_depth: 8 });
require(Logic.select(equal_rows.rows, [X]) == [["b"]],
    "equality constraint must unify a bound variable");
require(len(Logic.query(database, Logic.not_equal("a", "b"))) == 1,
    "legacy query must understand ground inequality");
require(len(Logic.query(database, Logic.not_equal(X, "b"))) == 0,
    "unbound inequality must fail rather than guess");

let capped = Logic.ask_bounded(database, "edge", ["a", X], map{
    max_steps: 100, max_solutions: 1, max_depth: 8
});
require(capped.solutions == 1 and capped.truncated,
    "solution ceiling must return a marked partial result");

let work_limited = Logic.ask_bounded(database, "edge", [X, Y], map{
    max_steps: 1, max_solutions: 8, max_depth: 8
});
require(work_limited.truncated and work_limited.steps == 1,
    "step ceiling must stop exactly at its budget");

let chain_goals = [];
let chain_vars = [];
let chain_index = 0;
while chain_index < 80 {
    array_push(chain_vars, Logic.var("Chain" + str(chain_index)));
    chain_index = chain_index + 1;
}
chain_index = 0;
while chain_index < len(chain_vars) - 1 {
    array_push(chain_goals, Logic.equal(chain_vars[chain_index], chain_vars[chain_index + 1]));
    chain_index = chain_index + 1;
}
array_push(chain_goals, Logic.equal(chain_vars[len(chain_vars) - 1], "resolved"));
let long_chain = Logic.where_bounded(database, chain_goals, map{
    max_steps: 200, max_solutions: 4, max_depth: 8
});
require(not long_chain.truncated
    and Logic.select(long_chain.rows, [chain_vars[0]]) == [["resolved"]],
    "substitution chains beyond the former 64-hop ceiling must resolve completely");

rejects(fn() { Logic.query_bounded(database, Logic.pred("edge", [X, Y]), map{
    max_depth: 0
}); }, "zero depth must fail closed");
rejects(fn() { Logic.query_bounded(database, Logic.pred("edge", [X, Y]), map{
    max_steps: 1.5
}); }, "fractional work limit must fail closed");
rejects(fn() { Logic.query_bounded(database, Logic.pred("edge", [X, Y]), "fast"); },
    "non-map options must fail closed");

print "logic_bounded_pass";
