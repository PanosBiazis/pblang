// Run in an isolated fixture: only the native boundary is substituted.
let subject="tests/fixtures/.windows_open_frame_subject.sapp";
assert(not fs_exists(subject),"fresh fixture subject required");
let source=fs_read("stdlib/windows_dirfs.sapp");
let patched=str_replace_all(source,"import(\"stdlib:windows_native_abi.sapp\")",
    "import(\"tests/fixtures/windows_open_frame_abi.sapp\")");
assert(patched!=source,"native boundary substitution");fs_write(subject,patched);
let M=import("tests/fixtures/windows_open_frame_abi.sapp");
let W=import("tests/fixtures/.windows_open_frame_subject.sapp");
let fs=map{abi:map{},root_handle:10,closed:false};
M.reset(map{});assert(W.mkdir(fs,"data").ok,"native record and successful directory open");
assert(M.counts().allocs==3 and M.counts().calls==1 and M.counts().closes==1,"three local buffers and one closed handle");
assert(M.counts().buffers==0,"successful call releases native buffers");
for failed in [1,2,3] {
    M.reset(map{fail_alloc:failed});assert(not W.mkdir(fs,"data").ok,"allocation failure returned");
    assert(M.counts().buffers==0 and M.counts().calls==0,"allocation failure cleans up before native open");
}
for failed in [1,2,3,4,5,6,7,8,9] {
    M.reset(map{fail_write:failed});assert(not W.mkdir(fs,"data").ok,"record preparation failure returned");
    assert(M.counts().buffers==0 and M.counts().calls==0,"incomplete record never reaches native open");
}
for status in [-1073741772,-1073741766,-1073741771] {
    M.reset(map{status:status});assert(not W.mkdir(fs,"data").ok,"native open failure returned");
    assert(M.counts().calls==1 and M.counts().closes==0 and M.counts().buffers==0,"failed native open cleans up buffers only");
}
for handle in [nil,0,-1] {
    M.reset(map{handle:handle});assert(not W.mkdir(fs,"data").ok,"invalid output handle rejected");
    assert(M.counts().buffers==0 and M.counts().closes==0,"invalid handle not closed");
}
for path in ["../bad","C:/bad","/bad","bad//leaf","bad/../leaf"] {
    M.reset(map{});assert(not W.mkdir(fs,path).ok,"malformed path rejected");
    assert(M.counts().allocs==0,"malformed path allocates nothing");
}
M.reset(map{});fs.closed=true;assert(not W.mkdir(fs,"data").ok,"closed root rejected");
assert(M.counts().allocs==0,"closed root allocates nothing");fs.closed=false;
M.reset(map{root:99});fs.root_handle=99;assert(W.mkdir(fs,"data").ok,"subsequent call uses its own root");
assert(M.counts().buffers==0,"subsequent call releases its buffers");
fs_remove(subject);print "windows_open_frame_pass";
