let O = import("stdlib/db_owned.sapp");
let DB = import("stdlib/db.sapp");
fn require(ok, message) { if not ok { throw "FAIL: " + message; } }
fn alive(handle) { return try len(sqlite_query(handle, "select 1", [])) == 1 catch false; }

let escaped = nil;
let prepared = nil;
let result = O.with_sqlite_result(":memory:", fn(c) {
    escaped = c;
    c.exec("create table t(v integer)", []);
    c.exec("insert into t values (?)", [42]);
    prepared = c.prepare("select v from t");
    return DB.query_value(c, "select v from t", []);
});
require(result.ok and result.open_ok and result.body_ok and result.close_call_ok, "success states");
require(result.value == 42 and result.error == nil, "success value");
require(not alive(escaped.handle), "escaped handle closed");
require((try prepared.query([]) catch "closed") == "closed", "escaped prepared closure closed");
for value in [nil, false, 0, "", [1], map{x:2}] {
    require(O.with_sqlite(":memory:", fn(c) { return value; }) == value, "callback value preserved");
}
let failed_handle = 0;
let failed = O.with_sqlite_result(":memory:", fn(c) {
    failed_handle = c.handle;
    throw "private-callback-marker";
});
require(not failed.ok and failed.open_ok and not failed.body_ok and failed.close_call_ok, "caught body failure");
require(failed.value == nil and failed.error == "db: SQLite callback failed", "fixed private error");
require(not alive(failed_handle), "failed body closes original");
let called = false;
let opened = O.with_sqlite_result("invalid\u0000path", fn(c) { called = true; return 1; });
require(not opened.ok and not opened.open_ok and not opened.body_ok and opened.close_call_ok, "open failure state");
require(not called and opened.error == "db: SQLite open failed", "open failure skips callback");
let malformed = O.with_sqlite_result(":memory:", nil);
require(not malformed.ok and malformed.open_ok and malformed.close_call_ok, "malformed callback cleanup");
let foreign = DB.sqlite.open(":memory:");
let original = 0;
let close_called = false;
let mutated = O.with_sqlite_result(":memory:", fn(c) {
    original = c.handle;
    c.handle = foreign.handle;
    c.kind = "replaced";
    c.close = fn() { close_called = true; throw "wrong close"; };
    return true;
});
require(mutated.ok and not close_called, "cleanup ignores mutable facade");
require(not alive(original) and alive(foreign.handle), "only original handle closed");
foreign.close();
let fresh = nil;
let manual = O.with_sqlite_result(":memory:", fn(c) {
    c.close();
    fresh = DB.sqlite.open(":memory:");
    return nil;
});
require(manual.ok and alive(fresh.handle), "manual close and new handle stay independent");
fresh.close();
let throwing = try O.with_sqlite(":memory:", fn(c) { throw "private-marker"; }) catch "caught";
require(throwing == "caught", "throwing variant raises");
let escaped_result = O.with_sqlite(":memory:", fn(c) { return c; });
require(not alive(escaped_result.handle), "returned connection is closed");
print "db_owned_pass";
