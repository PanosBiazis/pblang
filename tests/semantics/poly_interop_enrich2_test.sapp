// tests/semantics/poly_interop_enrich2_test.sapp — wave 2: registry alias/extensions,
// ptr map_ptr/take, interop per-language serializers.

let R = import("stdlib/polyglot_registry.sapp");
let P = import("stdlib/ptr.sapp");
let IO = import("stdlib/interop.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn contains(arr, v) { let i = 0; while i < len(arr) { if arr[i] == v { return true; } i = i + 1; } return false; }

// ── registry alias / extensions ─────────────────────────────────────────────────────
eq(R.alias("js"), "javascript", "js -> javascript");
eq(R.alias("py"), "python", "py -> python");
eq(R.alias("c++"), "cpp", "c++ -> cpp");
eq(R.alias("rust"), "rust", "canonical unchanged");
eq(R.alias("totally_unknown"), "totally_unknown", "unknown passthrough");
let exts = R.extensions();
if not contains(exts, "rs") { fail("extensions has rs"); }
if not contains(exts, "c") { fail("extensions has c"); }

// ── ptr map_ptr / take ──────────────────────────────────────────────────────────────
let p = P.new(5);
let q = P.map_ptr(p, fn(x) { return x * 2; });
eq(P.get(q), 10, "map_ptr transforms");
eq(P.get(p), 5, "map_ptr leaves original");
let t = P.new(7);
eq(P.take(t), 7, "take returns value");
eq(P.get(t), nil, "take resets box to nil");

// ── interop per-language serializers (pure) ───────────────────────────────────────
let php = IO.to_php(42);
if type(php) != "string" or len(php) == 0 { fail("to_php returns string"); }
let lua = IO.to_lua(map{ a: 1 });
if type(lua) != "string" or len(lua) == 0 { fail("to_lua returns string"); }
let r = IO.to_r([1, 2, 3]);
if type(r) != "string" or len(r) == 0 { fail("to_r returns string"); }

print "poly_interop_enrich2_pass";
