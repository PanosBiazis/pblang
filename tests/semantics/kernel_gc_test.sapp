// Test: the TUNABLE mark-sweep GC (stdlib/kernel/gc.sapp), PrjAnalysis §75.
//
// A precise mark-sweep collector written in pblang over the §74 free-list heap,
// tunable in both axes requested: MANUAL collection (`kernel_gc_collect`, always available)
// and AUTOMATIC collection (fires inside `gc_alloc` once bytes-since >= threshold),
// with run-time tunables `gc_set_auto` (on/off) and `gc_set_threshold`. Lowered with
// the §73 integer mode so the collector is float-free.
//
// poke32/peek32/heap_* are kernel intrinsics (not pblang VM builtins), so the GC
// can't execute in the test runner — we assert the codegen contract here. Behaviour
// is proven by an actual QEMU boot: a self-proving kernel runs BOTH modes (manual
// collect frees garbage and a later alloc reuses its block; an auto-collect triggered
// by crossing the threshold does the same and bumps the collection counter) and exits
// 85 iff both reclaim. See §75.

let ct = import("stdlib/compiler/ctranspile.sapp");
let heap = fs_read("stdlib/kernel/heap.sapp");
let gc = fs_read("stdlib/kernel/gc.sapp");

let src = "fn kmain() { let hctrl = kmalloc(8); let region = kmalloc(16384); "
    + "heap_init(hctrl, region, 16384); let g = gc_new(hctrl); "
    + "gc_set_auto(g, 1); gc_set_threshold(g, 64); "
    + "let a = gc_alloc(g, 1); gc_add_root(g, a); kernel_gc_collect(g); "
    + "outb(244, 42); while 1 > 0 { hlt(); } }";

let c = ct.transpile_kernel_int(heap + gc + src);

// ── GC transpiles, in integer (float-free) mode ─────────────────────────────────────
assert(str_contains(c, "long gc_new(long heap_ctrl)"), "gc_new transpiled (long-typed)");
assert(str_contains(c, "long gc_alloc(long g, long nchildren)"), "gc_alloc transpiled");
assert(str_contains(c, "long gc_alloc_rooted(long g, long nchildren)"), "atomic root publication transpiled");
assert(str_contains(c, "pushfl; popl %0; cli"), "critical section saves incoming interrupt state");
assert(str_contains(c, "static inline void kernel_irq_restore(u32 flags)"), "critical section restores interrupt state");
assert(str_contains(c, "long kernel_gc_collect(long g)"), "kernel_gc_collect (MANUAL entry) transpiled");
assert(not str_contains(c, "long _gc_mark("), "marking does not recurse on the native stack");
assert(str_contains(c, "long gc_remove_root(long g, long obj)"), "root removal transpiled");
assert(not str_contains(c, "double"), "GC is float-runtime-free (int codegen mode)");

// ── The tunables exist — manual + auto ──────────────────────────────────────────────
assert(str_contains(c, "long gc_set_auto(long g, long on)"), "auto on/off tunable present");
assert(str_contains(c, "long gc_set_threshold(long g, long bytes)"), "threshold tunable present");
// gc_alloc's auto path: collect-before-alloc gated on auto flag + threshold.
assert(str_contains(c, "long gc_collections(long g)"), "collection counter (observability) present");

// ── Forward declarations let gc_alloc call kernel_gc_collect (defined later) ────────
// (The §75 transpiler change: prototypes are emitted before definitions.)
assert(str_contains(c, "long kernel_gc_collect(long g);"), "forward declaration for kernel_gc_collect emitted");

// ── Bootable unit ───────────────────────────────────────────────────────────────────
assert(str_contains(c, "0x1BADB002"), "multiboot header present");

print "kernel_gc_pass";
