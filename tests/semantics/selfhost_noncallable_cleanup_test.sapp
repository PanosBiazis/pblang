// Adapted from the independent 24-case cycle8 reproduction. The original
// report and leak assertions are preserved outside the repository as baseline.
let V=import("stdlib:compiler/vm.sapp");
let F=import("stdlib:compiler/selfhost_frontend.sapp");
fn code(source) {
    let result=F.frontend_compile(source);
    assert(result.ok,"synthetic fixture compiles");
    return result.chunk;
}
fn run(chunk,ctx,bounded) {
    if bounded {return V.run_seeded_bounded(chunk,map{},map{max_steps:10000,max_frames:32},ctx);}
    return V.run_seeded(chunk,map{},ctx);
}
let setup=code("memory_alloc(7);push_lifetime();borrow_immutable(1);memory_alloc(9);");
let recover=code("print memory_get(1);");
let cases=["let f=3;f();","let f=nil;f();","let f=map{};f();","fn call(f){return f();}call(3);"];
let rows=0;
for source in cases {
    let chunk=code(source);
    for bounded in [false,true] {
        for automatic in [false,true] {
            let ctx=V.execution_context(automatic);
            run(setup,ctx,bounded);
            let state=ctx.memory;
            let failed=try {run(chunk,ctx,bounded);false} catch true;
            let count=len(state.owners);
            let borrows=len(state.borrows);
            print map{case:source,bounded:bounded,automatic:automatic,failed:failed,
                closed_before_observer_cleanup:state.closed,owners_before_observer_cleanup:count,
                borrows_before_observer_cleanup:borrows,reclaimed_before_observer_cleanup:state.reclaimed};
            V.close_execution(ctx);
            assert(failed,"non-callable rejects");
            assert(count==(if automatic {0} else {2}) and borrows==(if automatic {0} else {1}),"escape releases only opted-in ownership");
            assert(state.closed and state.reclaimed==2 and ctx.memory==nil,"observer cleanup complete");
            V.close_execution(ctx);assert(state.reclaimed==2,"observer cleanup idempotent");
            rows=rows+1;
        }
        let handled=map{constants:[map{try_chunk:chunk,catch_chunk:recover}],instructions:[map{op:35,operand:0}]};
        let ctx=V.execution_context(true);run(setup,ctx,bounded);let state=ctx.memory;
        let result=run(handled,ctx,bounded);
        assert(result.output==[7] and not state.closed and ctx.handlers==0,"guest catch retains owner");
        V.close_execution(ctx);assert(state.reclaimed==2,"handled observer cleanup");rows=rows+1;
    }
}
// Existing explicit rejection control: closes opted-in state before escape.
let control=V.execution_context(true);run(setup,control,false);let state=control.memory;
assert((try {run(code("memory_get(nil);"),control,false);false} catch true),"control rejects");
assert(state.closed and state.reclaimed==2,"existing controlled cleanup works");
V.close_execution(control);
assert(control.memory==nil and state.reclaimed==2,"closed-engine context detaches idempotently");
print "selfhost_noncallable_cleanup_pass rows="+str(rows)+" controlled=1";
