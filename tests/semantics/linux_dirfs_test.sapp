let D = import("stdlib:linux_dirfs.sapp");

fn fail(message) { throw "FAIL linux_dirfs: " + message; }
fn require(value, message) { if value != true { fail(message); } }

let root = ".pblang-dirfs-test"; let moved = ".pblang-dirfs-test-held"; let outside = ".pblang-dirfs-outside";
try proc_spawn_wait("/bin/rm", ["-rf", "--", root, moved, outside]) catch nil;
fs_mkdirs(outside); fs_write_bytes(outside + "/sentinel", [9, 8, 7]);

let fs = D.open(root, true);
require(fs.ok, "root opens through trusted libc: " + str(fs));
require(D.status(fs).component_openat and D.status(fs).nofollow, "security properties are observable");
require(D.status(fs).relative_root_component_walk and D.status(fs).mkdir_race_reopen,
    "relative roots are resolved component-by-component");
require(D.mkdir(fs, "docs/nested").ok, "recursive mkdirat");
require(D.write_atomic(fs, "docs/nested/a.bin", [1, 2, 3, 4]).ok, "atomic write");
let read = D.read_bytes(fs, "docs/nested/a.bin", 4);
require(read.ok and read.bytes == [1, 2, 3, 4], "stable descriptor read");
require(not D.read_bytes(fs, "docs/nested/a.bin", 3).ok, "read quota enforced");
require(D.list(fs, "docs/nested", 8).entries == ["a.bin"], "directory listing");
require(D.move(fs, "docs/nested/a.bin", "docs/moved.bin").ok, "renameat move");
require(D.remove(fs, "docs/moved.bin").ok, "unlinkat file");

// Final and intermediate symbolic links must never be followed.
let linked = try proc_spawn_wait("/bin/ln", ["-s", "../" + outside, root + "/escape"]) catch nil;
let symlinks = linked != nil and linked.exit_code == 0;
require(not D.read_bytes(fs, "escape/sentinel", 16).ok, "intermediate escape rejected");
let escaped_write = D.write_atomic(fs, "escape/new", [1]);
if symlinks {
    require(not escaped_write.ok, "write through symlink rejected");
} else {
    require(escaped_write.ok, "ordinary confined replacement directory remains usable");
    require(not (try fs_exists(outside + "/new") catch false), "no-symlink fallback remains confined");
}

// Replace the visible root path after opening it. Descriptor-relative writes
// must remain in the held original directory and must not enter the replacement.
require((try { fs_rename(root, moved); true } catch false), "root renamed after open");
if symlinks {
    linked = try proc_spawn_wait("/bin/ln", ["-s", outside, root]) catch nil;
    require(linked != nil and linked.exit_code == 0, "visible root replaced by symlink");
} else {
    // Some mounted filesystems reject symlink creation. A replacement directory
    // still proves that operations remain relative to the held descriptor.
    fs_mkdirs(root);
}
require(D.write_atomic(fs, "held.bin", [5, 6]).ok, "write survives root namespace replacement");
require((try fs_exists(moved + "/held.bin") catch false), "write lands in held root");
require(not (try fs_exists(outside + "/held.bin") catch false), "replacement target remains untouched");

require(D.close(fs), "directory root closes once");
require(not D.close(fs), "second close is safe");
try proc_spawn_wait("/bin/rm", ["-rf", "--", root, moved, outside]) catch nil;

// O_NOFOLLOW on a multi-component path protects only the final component.
// The root opener must reject an intermediate symlink instead of opening the
// attacker-selected directory below it.
let nested_parent = ".pblang-dirfs-parent";
let nested_outside = ".pblang-dirfs-nested-outside";
try proc_spawn_wait("/bin/rm", ["-rf", "--", nested_parent, nested_outside]) catch nil;
fs_mkdirs(nested_outside + "/root");
let nested_link = try proc_spawn_wait("/bin/ln", ["-s", nested_outside, nested_parent]) catch nil;
if nested_link != nil and nested_link.exit_code == 0 {
    let escaped_root = D.open(nested_parent + "/root", false);
    require(not escaped_root.ok, "intermediate root symlink is rejected");
}
try proc_spawn_wait("/bin/rm", ["-rf", "--", nested_parent, nested_outside]) catch nil;

let cwd = D.open(".", false);
require(cwd.ok, "current directory can be held as a secure relative root");
require(D.close(cwd), "current-directory root closes cleanly");

let absolute_root = "/tmp/pblang-dirfs-absolute-" + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 16);
let absolute = D.open_absolute(absolute_root, true);
require(absolute.ok and absolute.absolute, "absolute private root opens without following links");
require(D.write_atomic(absolute, "state/config.json", str_to_bytes("{}"), true).ok,
    "absolute root publishes private files atomically");
require(bytes_to_str(D.read_bytes(absolute, "state/config.json", 16).bytes) == "{}",
    "absolute root reads through held directory handles");
require(D.protect_file(absolute, "state/config.json").ok,
    "absolute root protects an existing file through its held descriptor");
require(D.close(absolute), "absolute directory root closes");
let mode = try proc_spawn_wait("/usr/bin/stat", ["-c", "%a", absolute_root]) catch nil;
require(mode != nil and mode.exit_code == 0 and str_trim(mode.stdout) == "700",
    "absolute application root is mode 0700");
try proc_spawn_wait("/bin/rm", ["-rf", "--", absolute_root]) catch nil;
print "linux_dirfs_pass";
