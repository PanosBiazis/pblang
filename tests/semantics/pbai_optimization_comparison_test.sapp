let O = import("../../stdlib/pbai_optimization.sapp");

fn require(ok, message) { if not ok { throw "pbai_optimization_test: " + message; } }

fn report(backend, latency, quality = 0.99) {
    return map{
        format: O.BENCHMARK_FORMAT,
        backend: backend,
        workload: "tensor-matmul-inference",
        model_digest: sha256("same-model-artifact"),
        identical_workload: true,
        warmups: 2,
        samples: 7,
        median_latency_ms: latency,
        p95_latency_ms: latency * 1.2,
        throughput_per_second: 1000 / latency,
        peak_memory_bytes: 1048576,
        artifact_bytes: 524288,
        quality_score: quality,
        baseline_quality_score: 0.99,
        parity_passed: true,
        artifact_verified: true,
        runtime_verified: true,
        operator_coverage_passed: true,
        deterministic_fallback: backend == "cpu",
        precision: if backend == "gpu" { "f32" } else { "f64" },
        runtime: if backend == "gpu" { "pblang-wgpu-matmul-v1" } else { "portable-pblang-cpu" }
    };
}

// Pure synthetic reports: this test selects no real device and runs no benchmark.
let checks=0;
fn expect(value,message){require(value,message);checks=checks+1;}
let workload="tensor-matmul-inference";
let cpu=report("cpu",10);let gpu=report("gpu",5);
let original=O.select_backend(workload,[cpu,gpu]);
expect(original.selected=="gpu" and original.measured_speedup_over_cpu==2,"same artifact valid reports preserve selection");
let different=report("gpu",1);different.model_digest=sha256("different-model-artifact");
for reports in [[cpu,different],[different,cpu],[cpu,different,gpu],[gpu,different,cpu]] {
 let result=O.select_backend(workload,reports);
 expect(result.selected==if len(reports)==2 {"cpu"} else {"gpu"},"mismatched artifact cannot win regardless of position");
 expect(result.measured_speedup_over_cpu==if len(reports)==2 {1} else {2},"speedup is from matching model");
}
let inf=10 ** 400;let nan=inf-inf;
expect(inf-inf!=0 and nan!=nan,"nonfinite fixtures are actual nonfinite numbers");
let invalid_counts=[nil,"7",true,[],map{},-1,0,1,5.5,inf,-inf,nan,9007199254740992];
for field in ["warmups","samples","peak_memory_bytes","artifact_bytes"] {
 for bad in invalid_counts {
  // 1 is a valid byte count, and 5.5 violates every count field's integer rule.
  if not (bad==1 and (field=="peak_memory_bytes" or field=="artifact_bytes")) {
   let candidate=report("gpu",5);candidate[field]=bad;
   let before=json_stringify(cpu);
   let result=O.select_backend(workload,[cpu,candidate]);
   expect(result.ok and result.selected=="cpu","invalid GPU count/bytes: "+field);
   expect(json_stringify(cpu)==before,"selection does not mutate baseline");
   let baseline=report("cpu",10);baseline[field]=bad;
   expect(not O.select_backend(workload,[baseline,gpu]).ok,"invalid CPU count/bytes: "+field);
  }
 }
 let minimum=1;
 if field=="warmups" {minimum=2;} elif field=="samples" {minimum=5;}
 for value in [minimum,9007199254740991] {
  let c=report("cpu",10);let g=report("gpu",5);c[field]=value;g[field]=value;
  expect(O.select_backend(workload,[c,g]).selected=="gpu","inclusive exact count boundary: "+field);
 }
 let low=report("gpu",5);low[field]=minimum-1;
 expect(O.select_backend(workload,[cpu,low]).selected=="cpu","below required count");
}
for field in ["median_latency_ms","p95_latency_ms","throughput_per_second"] {
 for bad in [nil,"1",true,0,-1,inf,-inf,nan] {
  let candidate=report("gpu",5);candidate[field]=bad;
  expect(O.select_backend(workload,[cpu,candidate]).selected=="cpu","invalid GPU measurement: "+field);
  let baseline=report("cpu",10);baseline[field]=bad;
  expect(not O.select_backend(workload,[baseline,gpu]).ok,"invalid CPU measurement: "+field);
 }
}
let tiny=report("gpu",10 ** -300);let huge=report("cpu",10 ** 300);
expect(O.select_backend(workload,[huge,tiny]).selected=="cpu","overflowed speedup is not reportable evidence");
let slow=report("gpu",9.9);expect(O.select_backend(workload,[cpu,slow]).selected=="cpu","speedup threshold unchanged");
let earlier=report("gpu",5);earlier.p95_latency_ms=4;
expect(O.select_backend(workload,[cpu,earlier]).selected=="cpu","p95 cannot precede median");
expect(not O.select_backend(workload,[]).ok and not O.select_backend(workload,nil).ok,"invalid collection retains error contract");
expect(O.select_backend(workload,[cpu,nil,"private-report-canary",map{}]).selected=="cpu","malformed entries safely ignored");
expect(O.select_backend(workload,[cpu,gpu]).selected=="gpu","recovery after invalid reports");
print json_stringify(map{format:"pbai.optimization.comparison-test.v1",checks:checks,real_hardware_tested:false,model_training:false});
