// tests/semantics/kernel_timer_enrich_test.sapp — pure-math enrichment of kernel/timer.sapp.
// (The pit_init path uses outb intrinsics — kernel-codegen only; these functions are pure.)

let T = import("stdlib/kernel/timer.sapp");

fn fail(m) { throw "FAIL " + m; }
fn approx(a, b, m) { if (a - b) > 1 or (b - a) > 1 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── divisor for a normal rate ──────────────────────────────────────────────────────
approx(T.pit_divisor_for(1000), 1193, "~1 kHz divisor");

// ── BUG FIX: clamp to the 16-bit divisor range ────────────────────────────────────
eq(T.pit_divisor_for(1), 65535, "very low hz clamps to max divisor (was 1193182, overflow)");
eq(T.pit_divisor_for(2000000), 1, "very high hz clamps to min divisor (was 0 = slowest)");

// ── pit_frequency_for is the inverse ──────────────────────────────────────────────
approx(T.pit_frequency_for(1193), 1000, "1193 divisor -> ~1 kHz");
approx(T.pit_frequency_for(0), 18, "divisor 0 -> ~18.2 Hz (65536)");

print "kernel_timer_enrich_pass";
