// tests/semantics/ai_onnx_wrapper_test.sapp
// Verifies the stdlib AI wrapper around the raw onnx_infer bridge returns a
// structured result for an unavailable model instead of throwing or crashing.

import "stdlib:ai.sapp";

let r = ai.onnx_run("missing_model.onnx", map{}, map{});
if type(r) != "map" {
    throw "FAIL ai.onnx_run result type";
}

let ok = try r.success catch nil;
if ok == nil {
    throw "FAIL ai.onnx_run missing success";
}
if ok == true {
    throw "FAIL ai.onnx_run unexpectedly succeeded";
}

let err = try r.error catch "";
if len(err) == 0 {
    throw "FAIL ai.onnx_run missing error";
}

print "ai_onnx_wrapper_pass";
