// tests/semantics/log_features_test.sapp — lock the logging feature wave:
// per-logger levels (the old new_logger stored min_level but NEVER used it),
// bounded memory sink, trace/fatal levels, sampling, catch_and_log,
// counter field flattening, and file rotation.

let log = import("stdlib:log.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(s, needle, m) { if str_index_of(s, needle) < 0 { fail(m + " missing '" + needle + "' in: " + s); } }

log.use_memory_output();
log.set_level("info");
log.set_format("text");

fn entry_count() { return len(log.memory_entries()); }
fn last_line() {
    let entries = log.memory_entries();
    return entries[len(entries) - 1].line;
}

// ── per-logger min level (was a dead field) ──────────────────────────────────
// global=info, but a logger created at debug level must emit DEBUG lines
let verbose = log.new_logger("verbose-mod", "text", "debug");
let before = entry_count();
verbose.debug("trace detail", nil);
eq(entry_count(), before + 1, "per-logger debug level overrides global info");

// and a logger at warn level must suppress info
let quiet = log.new_logger("quiet-mod", "text", "warn");
before = entry_count();
quiet.info("chatty", nil);
eq(entry_count(), before, "per-logger warn level suppresses info");
quiet.warn("real problem", nil);
eq(entry_count(), before + 1, "per-logger warn level emits warn");

// ── trace + fatal levels ─────────────────────────────────────────────────────
log.set_level("trace");
before = entry_count();
log.trace("finest detail", nil);
eq(entry_count(), before + 1, "trace emitted at trace threshold");
has(last_line(), "TRACE", "trace level tagged");
log.set_level("error");
before = entry_count();
log.trace("hidden", nil);
log.debug("hidden", nil);
eq(entry_count(), before, "trace/debug suppressed at error threshold");
log.fatal("meltdown", nil);
eq(entry_count(), before + 1, "fatal always above error threshold");
has(last_line(), "FATAL", "fatal level tagged");
log.set_level("info");

// ── bounded memory sink ──────────────────────────────────────────────────────
log.set_memory_limit(3);
log.clear_memory();
log.info("m1", nil);
log.info("m2", nil);
log.info("m3", nil);
log.info("m4", nil);
eq(entry_count(), 3, "memory sink capped at limit");
has(log.memory_entries()[0].line, "m2", "oldest entry dropped first");
log.set_memory_limit(1000);

// ── sampling: log_every ──────────────────────────────────────────────────────
log.clear_memory();
let i = 0;
while i < 10 {
    log.log_every("hot-loop", 5, "info", "iteration", map{ i: i });
    i = i + 1;
}
eq(entry_count(), 2, "log_every(5) emits 1st and 6th of 10");
has(log.memory_entries()[0].line, "i=0", "first sampled entry is iteration 0");
has(log.memory_entries()[1].line, "i=5", "second sampled entry is iteration 5");

// ── catch_and_log ────────────────────────────────────────────────────────────
log.clear_memory();
let ok_result = log.catch_and_log("safe-op", fn() { return 42; });
eq(ok_result.ok, true, "catch_and_log success flag");
eq(ok_result.value, 42, "catch_and_log passes value through");
eq(entry_count(), 0, "no log entry on success");

let bad_result = log.catch_and_log("boom-op", fn() { throw "kaboom"; });
eq(bad_result.ok, false, "catch_and_log failure flag");
eq(entry_count(), 1, "failure logged");
has(last_line(), "boom-op", "failure log names the operation");
has(last_line(), "ERROR", "failure logged at error level");

// ── counter fields flattened (were nested under fields=map{...}) ─────────────
log.clear_memory();
log.counter("requests", 1, map{ route: "/api" });
has(last_line(), "route=/api", "counter extra fields flattened into the line");
has(last_line(), "value=1", "counter value present");

// ── counters introspection ───────────────────────────────────────────────────
log.counter("requests", 2, nil);
let snap = log.counters();
eq(snap.requests, 3, "counters() snapshot reflects total");
log.reset_counters();
eq(log.counter_value("requests"), 0, "reset_counters clears");

// ── file rotation ────────────────────────────────────────────────────────────
let path = "/tmp/pblang_log_rotate_test.log";
try fs_remove(path) catch nil;
try fs_remove(path + ".1") catch nil;
log.set_output(path);
log.set_max_file_size(64);
log.info("first entry with enough text to pass sixty-four bytes easily", nil);
log.info("second entry triggers rotation because the file is over budget", nil);
if fs_exists(path + ".1") == false { fail("rotation did not create " + path + ".1"); }
let rotated = fs_read(path + ".1");
has(rotated, "first entry", "rotated file holds the old contents");
let fresh = fs_read(path);
has(fresh, "second entry", "live file holds the new entry");
log.set_max_file_size(0);
log.set_output("stdout");
try fs_remove(path) catch nil;
try fs_remove(path + ".1") catch nil;

print "log_features_pass";
