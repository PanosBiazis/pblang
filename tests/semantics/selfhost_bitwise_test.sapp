// Test: the SELF-HOSTED compiler (stdlib/compiler/) now understands infix
// bitwise operators (& | ^ << >>), prefix ~, and radix literals (0x/0b/0o) —
// another step on the rust→pblang migration (the Rust frontend had these in §47;
// now the pblang tokenizer/parser/VM do too).
//
// Driven through frontend_run (pblang compiler → pblang VM stdlib/compiler/vm.sapp).

let fe = import("stdlib/compiler/selfhost_frontend.sapp");

// --- Core bitwise ops + radix literals ---
let src1 = "let a = 12 & 10; "       // 8
    + "let b = 12 | 3; "             // 15
    + "let c = 6 ^ 3; "              // 5
    + "let d = ~0; "                 // -1
    + "let e = 1 << 4; "             // 16
    + "let f = 256 >> 2; "           // 64
    + "let g = 0xFF; "               // 255
    + "let h = 0b1010; "             // 10
    + "let i = 0o17; "               // 15
    + "let j = ~5;";                 // -6

let r1 = fe.frontend_run(src1);
assert(r1.ok == true, "self-hosted compile of bitwise/radix program must succeed");
assert(r1.globals["a"] == 8, "self-hosted 12 & 10 == 8");
assert(r1.globals["b"] == 15, "self-hosted 12 | 3 == 15");
assert(r1.globals["c"] == 5, "self-hosted 6 ^ 3 == 5");
assert(r1.globals["d"] == 0 - 1, "self-hosted ~0 == -1");
assert(r1.globals["e"] == 16, "self-hosted 1 << 4 == 16");
assert(r1.globals["f"] == 64, "self-hosted 256 >> 2 == 64");
assert(r1.globals["g"] == 255, "self-hosted 0xFF == 255");
assert(r1.globals["h"] == 10, "self-hosted 0b1010 == 10");
assert(r1.globals["i"] == 15, "self-hosted 0o17 == 15");
assert(r1.globals["j"] == 0 - 6, "self-hosted ~5 == -6");

// --- Precedence: & tighter than ^ tighter than |; shift looser than +; all
//     tighter than comparison (mirrors the Rust §47 ladder). ---
let src2 = "let a = 1 | 2 & 3; "      // 1 | (2&3) = 3
    + "let b = 4 + 1 << 1; "         // (4+1) << 1 = 10
    + "let c = 1 ^ 1 & 0; "          // 1 ^ (1&0) = 1
    + "let d = 8 & 12 == 8; "        // (8&12) == 8 = true
    + "let e = (0xF0 | 0x0F) & 0xFF;"; // 255

let r2 = fe.frontend_run(src2);
assert(r2.ok == true, "self-hosted compile of precedence program must succeed");
assert(r2.globals["a"] == 3, "self-hosted & binds tighter than |");
assert(r2.globals["b"] == 10, "self-hosted shift binds looser than +");
assert(r2.globals["c"] == 1, "self-hosted & binds tighter than ^");
assert(r2.globals["d"] == true, "self-hosted bitwise binds tighter than ==");
assert(r2.globals["e"] == 255, "self-hosted parenthesised radix masks");

// --- Bit manipulation in a real computation: pack/unpack a byte pair ---
let src3 = "fn pack(hi, lo) { return (hi << 8) | lo; } "
    + "fn hi(x) { return (x >> 8) & 0xFF; } "
    + "fn lo(x) { return x & 0xFF; } "
    + "let packed = pack(0xAB, 0xCD); "   // 0xABCD = 43981
    + "let h = hi(packed); "              // 0xAB = 171
    + "let l = lo(packed);";              // 0xCD = 205

let r3 = fe.frontend_run(src3);
assert(r3.ok == true, "self-hosted compile of bit-packing program must succeed");
assert(r3.globals["packed"] == 43981, "self-hosted pack(0xAB,0xCD) == 0xABCD");
assert(r3.globals["h"] == 171, "self-hosted hi byte == 0xAB");
assert(r3.globals["l"] == 205, "self-hosted lo byte == 0xCD");

// --- Exponentiation `**` (was missing from the self-hosted parser; added with
//     the bitwise port). Right-associative; binds tighter than unary and `*`. ---
let src4 = "let a = 2 ** 8; "         // 256
    + "let b = 2 ** 3 ** 2; "         // right-assoc: 2 ** (3**2) = 512
    + "let c = 5 ** 0; "             // 1
    + "let d = 2 ** 10 + 1; "        // (2**10) + 1 = 1025
    + "let e = 3 * 2 ** 3;";         // 3 * (2**3) = 24

let r4 = fe.frontend_run(src4);
assert(r4.ok == true, "self-hosted compile of exponentiation program must succeed");
assert(r4.globals["a"] == 256, "self-hosted 2 ** 8 == 256");
assert(r4.globals["b"] == 512, "self-hosted ** is right-associative");
assert(r4.globals["c"] == 1, "self-hosted 5 ** 0 == 1");
assert(r4.globals["d"] == 1025, "self-hosted ** binds tighter than +");
assert(r4.globals["e"] == 24, "self-hosted ** binds tighter than *");

print "selfhost_bitwise_pass";
