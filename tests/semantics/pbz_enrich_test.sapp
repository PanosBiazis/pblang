// tests/semantics/pbz_enrich_test.sapp — safety enrichment for stdlib/pbz.sapp
//
// pbz's decompressor had no bounds checks — a malformed blob could crash (OOB) or
// be a decompression bomb (tiny input -> huge output). Adds:
//  - try_decompress: never throws (nil on malformed input)
//  - decompress_safe(blob, max_out): rejects (nil) output larger than max_out
//  - is_pbz: cheap tag sniff

let pbz = import("stdlib/pbz.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn arr_eq(a, b, m) {
    if len(a) != len(b) { fail(m + " len " + str(len(a)) + " vs " + str(len(b))); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " @" + str(i)); } i = i + 1; }
}

// ── base round-trip still works (binary incl bytes >= 128) ───────────────────────
let data = [0, 1, 200, 255, 72, 72, 72, 72, 72, 128, 254, 200, 255];
arr_eq(pbz.decompress(pbz.compress(data)), data, "binary round-trip");
eq(pbz.decompress_str(pbz.compress_str("hello hello hello world")), "hello hello hello world", "string round-trip");

// ── ENRICH: try_decompress is graceful on valid + malformed input ────────────────
arr_eq(pbz.try_decompress(pbz.compress(data)), data, "try_decompress valid");
eq(pbz.try_decompress([1, 0, 0, 0, 200, 1, 2, 3]), nil, "try_decompress malformed -> nil (no crash)");
eq(pbz.try_decompress([0, 0, 0, 0, 99, 5]), nil, "try_decompress truncated -> nil");

// ── ENRICH: decompress_safe enforces an output cap (bomb guard) ──────────────────
let blob = pbz.compress_str("the quick brown fox jumps over the lazy dog");
if pbz.decompress_safe(blob, 1000) == nil { fail("decompress_safe should allow within cap"); }
eq(pbz.decompress_safe(blob, 3), nil, "decompress_safe rejects output beyond the cap");

// ── ENRICH: is_pbz tag sniff ─────────────────────────────────────────────────────
eq(pbz.is_pbz(blob), true, "is_pbz true for a real blob");
eq(pbz.is_pbz([99, 1, 2]), false, "is_pbz false for non-pbz tag");
eq(pbz.is_pbz("not bytes"), false, "is_pbz false for non-array");

print "pbz_enrich_pass";
