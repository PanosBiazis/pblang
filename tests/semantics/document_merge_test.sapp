let Merge=import("stdlib:document_merge.sapp");let Text=import("stdlib:text_document.sapp");let CSV=import("stdlib:sheet_csv.sapp");let V=import("stdlib:document_view.sapp");let UI=import("stdlib:modern_ui.sapp");
fn rejects(f) {let failed=false;try {f();} catch {failed=true;}assert(failed,"invalid merge rejected");}
let template=map{format:Text.FORMAT,title:"For {{name}}",blocks:[map{kind:"heading",text:"{{name}}"},map{kind:"bullet",text:"Value: {{value}}"}]};
let table=CSV.decode("value,name,unused\n\"x,y\",Δείγμα,ignored\n{{name}},Other,ignored");let before=json_stringify([template,table]);
let result=Merge.render(template,table);assert(result.count==2 and result.fields==["name","value"],"named mapping independent of column order");
assert(result.documents[0].title=="For Δείγμα" and result.documents[0].blocks[1].kind=="bullet" and result.documents[0].blocks[1].text=="Value: x,y","title, Unicode and block kinds");
assert(result.documents[1].blocks[1].text=="Value: {{name}}","values remain literal");
result.documents[0].blocks[0].text="changed";assert(json_stringify([template,table])==before and result.documents[1].blocks[0].text=="Other","source and sibling ownership");
for input in ["name,value\n", "name,name\nx,y", " name,value\nx,y", "wrong,value\nx,y", "a.b,value\nx,y"] {rejects(fn(){Merge.render(template,CSV.decode(input));});}
let empty=Merge.render(template,CSV.decode("name,value\nName,\n"));assert(empty.documents[0].blocks[1].text=="Value: ","explicit empty cells supported");
let big=Text.from_text(str_repeat("{{name}}",5),"title");rejects(fn(){Merge.render(big,CSV.decode("name\n"+str_repeat("x",256)));});
big=Text.create("t");big.blocks=[];for i in range(0,31) {array_push(big.blocks,map{kind:"paragraph",text:str_repeat("x",1024)});}
rejects(fn(){Merge.render(big,CSV.decode("name\n"+str_repeat("x\n",9)));});
let maxrows=CSV.decode("name,value\n"+str_repeat("Example,yes\n",31));assert(Merge.render(template,maxrows).count==31,"maximum records");
let doc=Merge.render(template,table).documents[0];for target in ["native","web","android"] {assert(len(UI.compile(V.create(doc,target),map{target:target,width:412,height:915}).records)>0,"portable document reader generation");}
let web=V.create(doc,"web");assert(web.children[2].value==doc.title,"portable text uses natural platform wrapping");
rejects(fn(){V.create(doc,"unknown");});
let lines=Text.from_text("first\n"+str_repeat("long line\n",20)+"last","title");let pages=V.pages(lines);assert(len(pages)>1 and pages[0][0]=="title" and pages[len(pages)-1][len(pages[len(pages)-1])-1]=="last","native paging retains final text");
print "document_merge_pass";
