let M = import("stdlib:macos_unicode_input.sapp");

fn require(value, message) { if not value { throw "FAIL macos-unicode-input: " + message; } }

let plan = M.text_plan("Aα中😀\t\nA");
require(plan.ok and plan.scalar_count == 7 and plan.utf16_units == 6
    and plan.layout_independent_unicode, "multi-script UTF-16 plan mismatch");
require(plan.strokes[3].units[0] == 0xD83D and plan.strokes[3].units[1] == 0xDE00,
    "supplementary-plane surrogate lowering mismatch");
require(plan.strokes[4].semantic_key and plan.strokes[4].keycode == 48
    and plan.strokes[5].semantic_key and plan.strokes[5].keycode == 36,
    "Tab/Return semantic key lowering mismatch");
require(not M.text_plan("").ok and not M.text_plan("\x1b").ok,
    "empty or unsupported control text accepted");

let caps = M.capabilities(); let host = M.available();
require(caps.text_unicode_layout_independent and caps.supplementary_planes
    and caps.permission_preflight and caps.accessibility_permission_required
    and not caps.external_tool_required, "capability contract mismatch");
require(type(host.ok) == "bool" and host.backend == caps.backend,
    "availability contract is not total");
let non_text = M.execute(map{
    format: "pblang.input.event.v1", kind: "key", key: "Enter"
});
require(not non_text.ok and str_contains(non_text.error, "complete text"),
    "non-text event did not fail closed");
if platform() != "macos" {
    let unavailable = M.execute(map{
        format: "pblang.input.event.v1", kind: "type", text: "safe"
    });
    require(not unavailable.ok and str_contains(unavailable.error, "unavailable"),
        "non-macOS execution did not fail closed");
}
print "macos_unicode_input_pass";
