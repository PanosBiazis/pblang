// PBLang libraries on the retained host: not independent backend qualification.
let C = import("stdlib:class.sapp");
let F = import("stdlib:functional.sapp");
let G = import("stdlib:generics.sapp");
fn expect(ok, label) { if not ok { throw "FAIL paradigm-composition: " + label; } }

let Base = C.define("Scale", ["factor"], map{
    apply: fn(self, x) { return self.factor * x; }
});
let Derived = C.extend(Base, "OffsetScale", [], map{
    apply: fn(self, x) { return C.super1(self, "apply", x) + 1; }
});
let Mixed = C.mixin(Derived, map{ label: fn(self) { return "scale"; } });
let object = C.new(Mixed, map{ factor: 2 });
let transform = C.bind1(object, "apply");
let pipeline = F.pipe([transform, fn(x) { return x * 10; }]);
expect(F.map([1, 2, 3], pipeline) == [30, 50, 70], "inheritance/mixin/bound-method/functional pipeline");
expect(C.call(object, "label") == "scale", "mixin remains callable");

let values = G.typed_list(G.T_number());
for x in [1, 2, 3] { G.tl_push(values, x); }
let mapped = G.tl_map(values, G.T_number(), transform);
expect(G.tl_items(mapped) == [3, 5, 7], "generic mapping accepts bound method");
expect(F.reduce(G.tl_items(mapped), fn(a, x) { return a + x; }, 0) == 15, "generic result feeds functional fold");
expect(G.tl_items(values) == [1, 2, 3], "composition preserves input container");

let outcome = try map{ ok: true, value: G.tl_map(values, G.T_number(), fn(x) { return "wrong"; }) } catch map{ ok: false };
expect(not outcome.ok, "invalid generic mapper result is rejected");
expect(G.tl_items(values) == [1, 2, 3], "rejected mapper preserves input");
let absent = try map{ ok: true, value: C.bind1(object, "absent") } catch map{ ok: false };
expect(not absent.ok, "missing method is rejected before composition");

// The retained host discards a semicolon-terminated branch expression.
let guarded = fn(x) { return try (if x < 0 { throw 4; 0; } else { transform(x) }) catch -1; };
let combined = F.map([1, -2, 3], guarded);
expect(combined == [3, -1, 7], "functional/object/procedural/exception composition: " + str(combined));
print "multi_paradigm_composition_pass";
