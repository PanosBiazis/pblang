let S=import("stdlib:browser_session.sapp");
let pages=map{"pb://home":"<article><h1>Home</h1><p>Welcome</p><a href=\"pb://guide\">Guide</a><a href=\"pb://missing\">Missing</a></article>","pb://guide":"<article><h1>Guide</h1><a href=\"pb://home\">Home</a></article>"};
let options=map{level:"local",allow:["pb://home","pb://guide"]};let s=S.create(pages,options);
options.level="review";options.allow=[];pages["pb://guide"]="broken";
assert(s.follow(1).url=="pb://guide","detached pages and grants");
assert(s.back().url=="pb://home" and s.forward().url=="pb://guide","real history navigation");
let view=s.snapshot();view.document.form.title="forged";assert(s.snapshot().document.form.title=="Guide","detached snapshots");
s.home();assert((try s.follow(2) catch nil)==nil and s.snapshot().url=="pb://home","denial leaves history/current unchanged");
assert((try s.search("hello") catch nil)==nil,"local cannot propose external query");
for _i 40 {s.navigate("pb://guide");s.home();}
assert(s.snapshot().history_count==32,"bounded history");s.back();s.home();assert(not s.snapshot().can_forward,"branch truncates forward history");
let bundle=s.bundle();assert(len(map_keys(bundle.files))==2 and bundle.entry=="home.html" and str_contains(bundle.files["home.html"],"guide.html"),"functional local HTML links");
s.close();s.close();assert((try s.snapshot() catch nil)==nil and (try s.bundle() catch nil)==nil,"closed session unusable");
pages["pb://guide"]="<article><h1>Guide</h1><p>Text</p></article>";
let locked=S.create(pages,map{level:"locked"});assert((try locked.follow(1) catch nil)==nil and len(map_keys(locked.bundle().files))==1,"locked mode exposes home only");
let subset=S.create(pages,map{allow:["pb://home"]});assert((try subset.navigate("pb://guide") catch nil)==nil,"ungranted registered page denied");
let review=S.create(pages,map{level:"review"});let before=review.snapshot();
for item in S.search_engines() {let p=review.search("PBLang & Ελληνικά",item.id);assert(not p.effects and not p.executable and str_contains(p.url,"%26"),"existing engine template is inert and encoded");}
assert(review.search("a b","custom","https://search.example.com/?q=").url=="https://search.example.com/?q=a+b","explicit custom provider");
assert(review.snapshot()==before,"search proposal never changes history");
for bad in ["http://example.com/?q=","https://127.0.0.1/?q=","https://user@example.com/?q=","https://google-analytics.com/?q=","https://example.com/ads/?q=","file:///tmp/?q=","https://example..com/?q=","https://example.onion/?q=","https://example.com/?%xyq="] {assert((try review.search("x","custom",bad) catch nil)==nil,"blocked search templates");}
assert((try review.search("x","missing") catch nil)==nil,"unknown engine never silently falls back");
assert((try review.navigate("https://example.com/") catch nil)==nil,"network navigation unlinked");
for opts in [map{level:"tor"},map{javascript:true},map{allow:["pb://missing"]},map{allow:["pb://home","pb://home"]},map{home:"pb://missing"}] {assert((try S.create(pages,opts) catch nil)==nil,"unsupported permission or invalid grant rejected");}
assert(not S.capabilities().network and not S.capabilities().tor and not S.capabilities().downloads,"explicit capability limits");
let too_many=map{};for i 17 {too_many["pb://page"+str(i)]="<article><h1>x</h1></article>";}
assert((try S.create(too_many,map{home:"pb://page0"}) catch nil)==nil,"page count budget");
let D=import("stdlib:browser_document.sapp");let blocks=[];for _i 8 {push(blocks,map{tag:"p",text:str_repeat("&",256)});}
let large=D.export_html(D.create("Budget",blocks));let aggregate=map{};
for i 7 {aggregate["pb://page"+str(i)]=large;}
assert((try S.create(aggregate,map{home:"pb://page0"}) catch nil)==nil,"aggregate UTF8 source budget");
assert((try review.search(str_repeat("x",257)) catch nil)==nil,"query budget");
review.close();locked.close();subset.close();
print "browser_session_pass";
