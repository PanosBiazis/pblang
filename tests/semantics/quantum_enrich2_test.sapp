// tests/semantics/quantum_enrich2_test.sapp — wave 2 for stdlib/quantum.sapp
// swap/cz/ccx builders wired through BOTH emit_qasm and run(); ghz convenience.

let Q = import("stdlib/quantum.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(s, sub, m) { if str_contains(s, sub) == false { fail(m + " : " + s); } }

// ── builders queue the right ops ───────────────────────────────────────────────────
let c = Q.circuit(3);
c = Q.swap(c, 0, 1);
c = Q.cz(c, 0, 2);
c = Q.ccx(c, 0, 1, 2);
eq(c.ops[0].gate, "swap", "swap op");
eq(c.ops[1].gate, "cz", "cz op");
eq(c.ops[2].gate, "ccx", "ccx op");

// ── emit_qasm serializes them (no coverage drift) ─────────────────────────────────
let qasm = Q.to_qasm(c);
has(qasm, "swap q[0],q[1];", "qasm swap");
has(qasm, "cz q[0],q[2];", "qasm cz");
has(qasm, "ccx q[0],q[1],q[2];", "qasm ccx");

// ── run executes ccx: |110> --ccx--> |111> ─────────────────────────────────────────
let r = Q.circuit(3);
r = Q.apply_x(r, 0);
r = Q.apply_x(r, 1);
r = Q.ccx(r, 0, 1, 2);
r = Q.measure(r, 0, 0);
r = Q.measure(r, 1, 1);
r = Q.measure(r, 2, 2);
let m = Q.run(r);
eq(Q.measurements_to_string(m), "111", "ccx flips q2 when both controls set");

// ── ghz: H + CX chain ──────────────────────────────────────────────────────────────
let g = Q.circuit(3);
g = Q.ghz(g, [0, 1, 2]);
eq(len(g.ops), 3, "ghz emits H + 2 CX");
eq(g.ops[0].gate, "h", "ghz first is h");
eq(g.ops[1].gate, "cx", "ghz then cx");
eq(g.ops[2].gate, "cx", "ghz then cx again");

print "quantum_enrich2_pass";
