let Q=import("stdlib:quote_document.sapp");let Text=import("stdlib:text_document.sapp");let View=import("stdlib:quote_view.sapp");let UI=import("stdlib:modern_ui.sapp");let GUI=import("stdlib:gui.sapp");
fn rejects(f) {let bad=false;try {f();} catch {bad=true;}assert(bad,"invalid quote rejected");}
let doc=Q.from_csv("\"Design, review\",2,0.10\nGuide,1,0.20","Synthetic estimate","EUR","No hidden charges inferred.");
assert(Q.validate(doc).total_cents==40,"exact fractional prices");
assert(Q.decode(Q.encode(doc))==doc and Q.from_csv(Q.to_csv(doc),doc.title,doc.currency,doc.notes)==doc,"strict native and literal CSV roundtrip");
let clone=Q.copy(doc);clone.items[0].quantity=99;assert(doc.items[0].quantity==2,"detached items");
let text=Q.to_document(doc);assert(Text.validate(text).blocks>3 and str_contains(Text.to_text(text),"0.40 EUR"),"Writer exact subtotal");
let original=Q.encode(doc);
for input in ["", "x,0,1", "x,-1,1", "x,1.5,1", "x,1,1.001", "x,1,1e2", "x,1,-1", "x,1,1000000.01", "x,1,1,extra", " ,1,1"] {rejects(fn(){Q.from_csv(input);});}
for field in ["quantity","unit_cents"] {for v in [true,nil,"1",-1,0.5] {let bad=Q.copy(doc);bad.items[0][field]=v;rejects(fn(){Q.validate(bad);});}}
let bad=Q.copy(doc);bad.extra=1;rejects(fn(){Q.validate(bad);});bad=Q.copy(doc);bad.items[0].extra=1;rejects(fn(){Q.validate(bad);});
for c in ["eur","JPY",nil] {rejects(fn(){Q.create("Example",c);});}
rejects(fn(){Q.decode(str_replace_all(original,"\"format\":","\"format\":\"duplicate\",\"format\":"));});
rejects(fn(){Q.decode(original+" trailing");});
let max=Q.create();max.items=[];
for i in range(0,16) {array_push(max.items,map{description:str_repeat("α",128),quantity:100000,unit_cents:100000000});}
max.notes=str_repeat("β",1024);assert(Q.validate(max).total_cents==160000000000000,"maximum exact aggregate");
assert(Q.decode(Q.encode(max))==max and Text.validate(Q.to_document(max)).blocks<=64,"maximum supported export including split Unicode notes");
rejects(fn(){Q.from_csv("x,1,1","Bad\ntitle");});
rejects(fn(){Q.from_csv("x,1,1","Example","EUR",str_repeat("\n",64));});
rejects(fn(){Q.from_csv("x,1,1","Example","EUR","bad\tcontrol");});
let dense=Q.copy(max);dense.title=str_repeat("A",256);dense.notes=str_repeat("N",1985)+str_repeat("\n",63);
for i in range(0,len(dense.items)) {dense.items[i].description=str_repeat("x",256);}
assert(UI.validate(View.create(dense)).ok,"maximum ASCII and note line wrapping fits action budget");
let view=View.create(max);assert(UI.validate(view).ok and UI.validate(view).actions>0,"all-page reader actions");
for target in ["native","web","android"] {assert(len(UI.compile(View.create(doc),map{target:target,width:412,height:915}).records)>0,"portable estimate reader");}
let form=UI.build("Reader",view,map{width:412,height:915});let first=GUI.get(form,"body").value;
GUI.get(form,"page_1").onclick(form);assert(GUI.get(form,"body").value!=first,"native page update changes rendered content");
assert(GUI.get(form,"body").readonly and not GUI.get(form,"body").enabled,"read-only portable body");
GUI.get(form,"page_0").onclick(form);assert(GUI.get(form,"body").value==first,"return to first page");
array_push(max.items,map{description:"extra",quantity:1,unit_cents:1});rejects(fn(){Q.validate(max);});
let plan=map{target_cents:200000,fixed_cost_cents:10000,fixed_minutes:600,available_minutes:1200,offers:[map{id:"private-plan",price_cents:14900,unit_cost_cents:500,fee_bps:1000,fee_fixed_cents:50,units:17,minutes_per_sale:20}]};
let quote=Q.from_offer(plan,0,"Example","Configured package");assert(quote.items[0].quantity==1 and quote.items[0].unit_cents==14900,"one unit instead of forecast sales");
assert(not str_contains(Q.encode(quote),"private-plan") and not str_contains(Q.encode(quote),"target_cents"),"internal plan metadata excluded");
rejects(fn(){Q.from_offer(plan,1);});assert(Q.encode(doc)==original,"failures preserve source");
print "quote_document_pass";
