let AI=import("stdlib/pbai.sapp");
fn rejects(f) {return try {f();false} catch true;}
let caps=AI.neural_specialist_student_tool(map{op:"capabilities"});
assert(caps.status=="result" and caps.result.max_contexts==32 and not caps.result.training and not caps.result.activation,"truthful bounded capabilities");
let old_train=[map{x:[0],y:4},map{x:[1,0],y:4}];let old_holdout=[map{x:[7,0],y:4}];
let teacher=AI.neural_specialist_train([old_train[0]],old_holdout);
let parent=AI.neural_specialist_distill(teacher.artifact,[[0],[1,0]],old_holdout).checkpoint();
let loaded=AI.neural_specialist_student_load(parent);
let contexts=[[0],[1,0],[0/(0-1)],[7,7,7,7]];
let request=map{op:"predict_batch",checkpoint:parent,contexts:contexts,include_logits:false};
let before=json_stringify(request);let compact=AI.neural_specialist_student_tool(request);
assert(compact.status=="result" and len(compact.result.predictions)==4,"ordered batch result");
assert(json_stringify(request)==before,"caller input unchanged");
for i len(contexts) {
 let row=compact.result.predictions[i];assert(row.index==i and row.token==loaded.predict(contexts[i]).token,"batch oracle");
 assert(len(row)==2 and not map_has(row,"logits") and not map_has(row,"context"),"minimal default output");
}
request.include_logits=true;let verbose=AI.neural_specialist_student_tool(request);
for i len(contexts) {assert(json_stringify(verbose.result.predictions[i].logits)==json_stringify(loaded.predict(contexts[i]).logits),"exact logit oracle");}
let digest=verbose.result.checkpoint_digest;verbose.result.predictions[0].logits[0]=999;caps.result.max_contexts=10000;
assert(AI.neural_specialist_student_tool(map{op:"capabilities"}).result.max_contexts==32,"descriptor detached");
assert(AI.neural_specialist_student_tool(request).result.predictions[0].logits[0]!=999,"output mutations do not affect future calls");
let many=[];for i 32 {push(many,[i%8]);}
request.contexts=many;assert(len(AI.neural_specialist_student_tool(request).result.predictions)==32,"maximum batch including duplicate contexts");
push(many,[0]);assert(AI.neural_specialist_student_tool(request).status=="error","33 contexts rejected");
let zero=len([]);let cycle=[];push(cycle,cycle);
for bad in [nil,[],[[0],[]],[[8]],[[1.5]],[[true]],[[0/zero]],[[1/zero]],[[0,1,2,3,4]],[cycle]] {
 request.contexts=bad;let error=AI.neural_specialist_student_tool(request);
 assert(error.status=="error" and error.result==nil and error.error=="invalid_request","whole malformed batch rejected without partial results");
}
request.contexts=contexts;request.include_logits="true";assert(AI.neural_specialist_student_tool(request).status=="error","boolean field exact");
request.include_logits=false;request.secret="synthetic-private-marker";
assert(not str_contains(json_stringify(AI.neural_specialist_student_tool(request)),"synthetic-private-marker"),"extra sensitive field never echoed");
for bad in [nil,[],map{},map{op:"accept"},map{op:"train"},map{op:"capabilities",extra:true},map{op:cycle},map{op:fn(){throw "must not invoke";}}] {
 assert(AI.neural_specialist_student_tool(bad).status=="error","unsupported calls return structured errors");
}
let called=false;let callback=fn(){called=true;return "capabilities";};
let callback_error=AI.neural_specialist_student_tool(map{op:callback});
assert(callback_error.status=="error" and not called,"supplied function is data, never invoked");
assert(not str_contains(json_stringify(AI.neural_specialist_student_tool(map{op:"synthetic-private-marker"})),"synthetic-private-marker"),"unknown operation text never echoed");
let corrupt=AI.neural_specialist_student_decode(AI.neural_specialist_student_encode(parent));corrupt.a[0][0]=999;
assert(AI.neural_specialist_student_tool(map{op:"predict_batch",checkpoint:corrupt,contexts:[[0]],include_logits:false}).error=="invalid_checkpoint","checkpoint integrity validated");
// Diagnostic comparison cannot grant acceptance, even for a new-task improvement.
let changed=AI.neural_specialist_student_continue(parent,[map{x:[2,0],y:5},map{x:[3,0],y:5}],[map{x:[4,0],y:5}],map{epochs:64,lr:0.1,max_grad_norm:1}).checkpoint();
let examples=[map{x:[5,0],y:4},map{x:[6,0],y:5}];
let comparison=AI.neural_specialist_student_tool(map{op:"compare",baseline:parent,candidate:changed,examples:examples});
assert(comparison.status=="result" and comparison.result.metrics.baseline_correct_regressions==1,"paired comparison exposes lost old answers");
assert(json_stringify(comparison.result.metrics.baseline)==json_stringify(loaded.evaluate(examples).student),"baseline evaluation oracle");
assert(json_stringify(comparison.result.metrics.candidate)==json_stringify(AI.neural_specialist_student_load(changed).evaluate(examples).student),"candidate evaluation oracle");
assert(not comparison.result.authorizes_activation and not comparison.result.independent_test and not comparison.result.history_overlap_checked,"diagnostic authority and provenance limits");
assert(AI.neural_specialist_student_tool(map{op:"compare",baseline:parent,candidate:changed,examples:[examples[0],examples[0]]}).status=="error","duplicate evaluation contexts rejected");
let equal=AI.neural_specialist_student_tool(map{op:"compare",baseline:parent,candidate:parent,examples:examples});
assert(equal.status=="result" and equal.result.metrics.baseline_correct_regressions==0 and json_stringify(equal.result.metrics.baseline)==json_stringify(equal.result.metrics.candidate),"self comparison is an identity oracle");
for invalid in [nil,teacher.artifact,corrupt] {
 assert(AI.neural_specialist_student_tool(map{op:"compare",baseline:parent,candidate:invalid,examples:examples}).error=="invalid_checkpoint","comparison validates both artifacts");
}
// The faster reviewed predictor tracks each transition, including rejection.
let history=AI.neural_specialist_student_history(parent,old_train,old_holdout);
let review=AI.neural_specialist_student_continue_reviewed(parent,history,[map{x:[2,0],y:4}],[map{x:[4,0],y:4}]);
for phase in ["reviewed","accepted","rolled-back"] {
 if phase=="accepted" {review.accept();assert(rejects(fn(){review.accept();}),"second accept rejected");}
 if phase=="rolled-back" {review.rollback();assert(rejects(fn(){review.rollback();}),"second rollback rejected");}
 let snapshot=review.checkpoint();let oracle=AI.neural_specialist_student_load(snapshot);
 for ids in contexts {assert(json_stringify(review.predict(ids))==json_stringify(oracle.predict(ids)),"cached reviewed inference equals active checkpoint");}
 let prediction=review.predict([0]);prediction.logits[0]=999;snapshot.a[0][0]=999;
 assert(review.predict([0]).logits[0]!=999 and rejects(fn(){review.predict(cycle);}),"cached inference is private and validates input");
}
let rejected=AI.neural_specialist_student_continue_reviewed(parent,history,[map{x:[2,0],y:5},map{x:[3,0],y:5}],[map{x:[4,0],y:5}],map{epochs:64,lr:0.1,max_grad_norm:1});
assert(rejected.status().phase=="rejected" and rejects(fn(){rejected.accept();}),"failed gate stays rejected");
assert(json_stringify(rejected.predict([0]))==json_stringify(loaded.predict([0])),"rejection preserves parent inference");
assert(parent.digest==digest,"original checkpoint identity retained");
print "pbai_student_tools_pass";
