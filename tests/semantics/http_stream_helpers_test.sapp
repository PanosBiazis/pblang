// tests/semantics/http_stream_helpers_test.sapp
// Verifies documented stdlib:http streaming helpers are exported and SSE parsing
// still behaves without requiring a live network call.

import "stdlib:http.sapp";

if is_fn(http.get_stream) == false {
    throw "FAIL get_stream not a function";
}
if is_fn(http.post_stream) == false {
    throw "FAIL post_stream not a function";
}
if is_fn(http.post_stream_auth) == false {
    throw "FAIL post_stream_auth not a function";
}

let p = http.parse_sse_line("data: {\"ok\":true}");
if p == nil or p.kind != "data" or p.value != "{\"ok\":true}" {
    throw "FAIL parse_sse_line data";
}

let e = http.parse_sse_line("event: token");
if e == nil or e.kind != "event" or e.value != "token" {
    throw "FAIL parse_sse_line event";
}

print "http_stream_helpers_pass";
