let E = import("stdlib:ed25519_verify.sapp");

let HEX = "0123456789abcdef";

fn nibble(ch) {
    let i = 0;
    while i < 16 {
        if str_slice(HEX, i, i + 1) == str_lower(ch) { return i; }
        i = i + 1;
    }
    throw "invalid test hex";
}

fn bytes(text) {
    if len(text) % 2 != 0 { throw "odd test hex"; }
    let out = [];
    let i = 0;
    while i < len(text) {
        array_push(out, nibble(str_slice(text, i, i + 1)) * 16
        + nibble(str_slice(text, i + 1, i + 2)));
        i = i + 2;
    }
    return out;
}

fn require(value, message) { if not value { throw message; } }

fn test_ed25519_rfc8032_and_strict_rejections() {
    let public1 = bytes("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a");
    let signature1 = bytes("e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e06522490155"
    + "5fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b");
    require(E.verify(public1, [], signature1), "RFC 8032 empty-message vector rejected");

    let public2 = bytes("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c");
    let signature2 = bytes("92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da"
    + "085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00");
    require(E.verify(public2, [0x72], signature2), "RFC 8032 one-byte vector rejected");

    require(not E.verify(public2, [0x73], signature2), "changed message accepted");
    require(not E.verify(bytes("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660d"),
    [0x72], signature2), "changed public key accepted");
    let changed_signature = [];
    for byte in signature2 { array_push(changed_signature, byte); }
    changed_signature[10] = changed_signature[10] + 1;
    require(not E.verify(public2, [0x72], changed_signature), "changed signature accepted");

    require(not E.verify([], [], signature1), "short public key accepted");
    require(not E.verify(public1, [], []), "short signature accepted");
    require(not E.verify(public1, [256], signature1), "invalid message byte accepted");

    let oversized = [];
    let i = 0;
    while i < E.limits().max_message_bytes + 1 { array_push(oversized, 0); i = i + 1; }
    require(not E.verify(public1, oversized, signature1), "oversized message accepted");

    // S exactly equal to the group order L is non-canonical and must fail.
    let noncanonical_s = [];
    i = 0;
    while i < 32 { array_push(noncanonical_s, signature1[i]); i = i + 1; }
    let l_bytes = bytes("edd3f55c1a631258d69cf7a2def9de14"
    + "00000000000000000000000000000010");
    for byte in l_bytes { array_push(noncanonical_s, byte); }
    require(not E.verify(public1, [], noncanonical_s), "S >= L accepted");

    // Encoded identity and y == p are canonical/subgroup rejection probes.
    let identity = bytes("01000000000000000000000000000000"
    + "00000000000000000000000000000000");
    require(not E.verify(identity, [], signature1), "identity public key accepted");
    require(not E.verify(bytes("edffffffffffffffffffffffffffffff"
    + "ffffffffffffffffffffffffffff7f"), [], signature1), "non-canonical y accepted");

    let identity_r_signature = [];
    for byte in identity { array_push(identity_r_signature, byte); }
    i = 32;
    while i < 64 { array_push(identity_r_signature, signature1[i]); i = i + 1; }
    require(not E.verify(public1, [], identity_r_signature), "identity R accepted");

    // Independently generated and verified with OpenSSL 3: 200 zero bytes make
    // SHA-512 process multiple blocks in H(R || A || message).
    let openssl_public = bytes("2fab8a7390bd6fb5f8f5637482cc632f58a3d2c8c5cabcddd3fc4c057f328ba3");
    let openssl_signature = bytes("4e04916e537ac04c45a1d0b7dba2e92f8f902fcf64cc0a6c57bcc4f04d3bc2c0"
    + "deffc9bc9f5ac614500a3c353486ddb8f5a21dad77d8281ed6105bd2fee7da09");
    let multi_block_message = [];
    i = 0;
    while i < 200 { array_push(multi_block_message, 0); i = i + 1; }
    require(E.verify(openssl_public, multi_block_message, openssl_signature),
    "OpenSSL multi-block fixture rejected");

    let limits = E.limits();
    require(limits.verification_only and limits.canonical_scalar_required
    and limits.canonical_points_required and limits.prime_order_points_required,
    "strict verifier limits/status regressed");
}
