if platform()!="linux" {print "gate_policy_live_skip_linux_required";os_exit(0);}
let compiler=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let root="tests/fixtures/gate-policy-"+str_slice(sha256(str(now_ms())+str(random_bytes(8))),0,16);
let source="let A=import(\"stdlib:project_audit.sapp\");\nlet args=os_args();let mode=args[len(args)-1];\nlet options=map{max_high:\"private-policy-marker\"};\nif mode==\"bool\" {options=map{allow_roadmap:\"private-policy-marker\"};}\nif mode==\"shape\" {options=\"private-policy-marker\";}\nif mode==\"precedence\" {options=map{max_findings:0,max_high:\"private-policy-marker\"};}\nif mode==\"compare\" {A.compare_reports(map{findings:42},map{findings:42},map{max_new_total:parse_number(\"NaN\")});}\nelse {A.release_readiness(\"fixture\",42,options);}\n";
let failure="unexpected exception";
fn expect(ok,label){if not ok {failure=label;throw label;}}
fn exercise(){
    fs_mkdirs(root);fs_write(root+"/main.sapp",source);
    for row in [["number","project audit gate numeric limits must be finite integers in 0..9007199254740991"],
        ["bool","project audit gate flags must be booleans"],["shape","project audit gate options must be a map or nil"],
        ["precedence","project audit max_findings must be a finite integer in 1..4096"],
        ["compare","project audit gate numeric limits must be finite integers in 0..9007199254740991"]] {
        let r=proc_spawn_wait("/usr/bin/timeout",["-k","1s","5s",compiler,root+"/main.sapp","--allow-all","--",row[0]]);
        expect(r.exit_code==1 and r.stdout=="" and str_contains(r.stderr,"]: "+row[1]+"\n"),"exact diagnostic and exit status");
        expect(not str_contains(r.stderr,"private-policy-marker") and not str_contains(r.stderr,"len expects"),"no input echo or report traversal failure");
    }
    return true;
}
let ok=try exercise() catch false;
if fs_exists(root+"/main.sapp"){fs_remove(root+"/main.sapp");}
if fs_exists(root){fs_remove(root);}
if not ok {throw "FAIL gate-policy-live: "+failure;}
print "project_audit_gate_policy_live_pass";
