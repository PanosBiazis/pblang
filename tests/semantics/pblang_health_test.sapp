let H = import("stdlib:pblang_health.sapp");

let health = H.snapshot();
assert(health.format == "pblang.product_health.report.v1", "pblang health uses shared contract");
assert(health.product == "pblang", "pblang product identity");
assert(health.required_failed == 0, "required interpreter and safety checks pass");
assert(health.status != "blocked", "optional JIT/platform checks do not block portable runtime");
assert(len(health.checks) == 8, "pblang health is bounded and includes resilience and performance budgets");
assert(str_contains(str_join(health.capabilities, ","), "resilience-policy"), "pblang health publishes resilience capability");
assert(str_contains(str_join(health.capabilities, ","), "performance-budget"), "pblang health publishes performance budgets");

let regression = H.snapshot(map{
    baseline: map{ latency_ms: 100 }, candidate: map{ latency_ms: 110 },
    budgets: [map{ metric: "latency_ms", max_regression_percent: 5 }], source: "semantic-test"
});
assert(regression.status == "blocked" and regression.required_failed == 1, "measured performance regressions fail closed");
print "pblang_health_pass";
