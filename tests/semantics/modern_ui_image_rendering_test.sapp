let UI=import("stdlib:modern_ui.sapp");
let GUI=import("stdlib:gui.sapp");
let Web=import("stdlib:modern_ui_web.sapp");
let Android=import("stdlib:modern_ui_android.sapp");
let Fit=import("stdlib:image_fit.sapp");
let pixels=[[[255,0,0],[0,0,255]]];
fn view(options) {return UI.screen([UI.image(pixels,options)]);}
let original=view(map{name:"image",src:"./image.png"});
let oldweb=Web.generate("Image",UI.compile(original,map{target:"web"}));
assert(not str_contains(oldweb.css,"image-rendering:"),"absent option preserves browser default");
let android_modes=[];
for mode in ["auto","pixelated"] {
    let tree=view(map{name:"image",src:"./image.png",fit:"contain",image_rendering:mode,h:120,min_h:80});
    let web=Web.generate("Image",UI.compile(tree,map{target:"web"}));
    assert(str_contains(web.css,"img.pb-image.pb-n-2{image-rendering:"+mode+";}"),"per-image rendering independent of fit");
    assert(str_contains(web.css,"min-height:80px;height:120px"),"image min height remains explicit");
    let native=UI.build("Image",tree);
    assert(GUI.get(native,"image").image_rendering==mode,"native widget retains rendering preference");
    let bundle=UI.compile(tree,map{target:"android"});
    let bytes=Android.activity_class(bundle,map{android_images:true});
    assert(len(bytes)>0,"Android image rendering compiles");
    array_push(android_modes,bytes);
    // Without embedded images, only metadata changes: legacy output is identical.
    assert(Android.activity_class(bundle)==Android.activity_class(UI.compile(view(map{name:"image",h:120,min_h:80}),map{target:"android"})),"disabled embedding keeps placeholder bytes");
}
assert(android_modes[0]!=android_modes[1],"Android auto and pixelated emit different filter values");
let opts=map{image_rendering:"pixelated"};let tree=view(opts);
let bundle=UI.compile(tree,map{target:"web"});tree.children[0].image_rendering="pixelated;color:red";
assert((try Web.generate("Invalid",bundle) catch nil)==nil,"renderer revalidates mutated preference");
for invalid in [nil,true,1,[],map{},"smooth","PIXELATED"] {
    assert((try Fit.rendering(invalid) catch nil)==nil,"unknown rendering mode rejected");
    assert(not UI.validate(view(map{image_rendering:invalid})).ok,"shared contract rejects invalid rendering");
}
print "modern_ui_image_rendering_pass";
