// tests/semantics/dist_native_test.sapp
//
// dist.native(main_path, out_base) — the first-class "true native binary" entry
// point. For a self-contained program it produces a real, standalone executable
// (pblang -> C99 -> cc) that runs with NO pblang runtime. For a multi-module
// program (which the C transpiler can't link yet) it returns a clear redirect to
// the portable .pbself path rather than emitting a broken binary.
//
// This host has a C compiler (see dist_build_test), so the native build is
// hard-asserted here.

let dist = import("stdlib/dist.sapp");

fn fail(m) { throw "FAIL " + m; }
fn expect(c, m) { if not c { fail(m); } }

fn uniq(tag) { return "/tmp/pbnat_" + tag + "_" + str(num_floor(now_ms())); }

// ── 1. single-file program -> a real standalone native binary that runs ────────
let prog = uniq("p") + ".sapp";
let out  = uniq("bin");
fs_write_bytes(prog, str_to_bytes("fn fib(n){ if n < 2 { return n; } return fib(n-1) + fib(n-2); } print fib(15);"));

let r = dist.native(prog, out);
expect(r.ok, "native build succeeds for a self-contained program");
expect(r.native == true, "report is tagged native");
expect(r.standalone == true, "release default is a static, standalone binary");
expect(r.size != nil and r.size > 0, "report carries the binary size");

// It must RUN with no pblang runtime and print the right answer (fib(15) == 610).
let run = proc_spawn_wait(r.output, []);
expect(str_trim(run.stdout) == "610", "the native binary runs standalone: fib(15) == 610");
fs_remove(prog);
fs_remove(r.output);

// ── 2. multi-module program -> clear redirect, NOT a broken binary ─────────────
let lib  = uniq("lib") + ".sapp";
let main = uniq("main") + ".sapp";
fs_write_bytes(lib, str_to_bytes("fn sq(x){ return x*x; } export sq;"));
fs_write_bytes(main, str_to_bytes("let m = import(\"" + lib + "\"); print m.sq(12);"));

let r2 = dist.native(main, uniq("bin2"));
expect(r2.ok == false, "multi-module native build is refused (not a broken binary)");
expect(r2.multi_module == true, "report flags the multi-module limitation");
expect(str_index_of(r2.reason, "self_extract") >= 0 or str_index_of(r2.reason, ".pbself") >= 0,
       "the message redirects to the .pbself path");
fs_remove(lib);
fs_remove(main);

print "dist_native_pass";
