let color = import("stdlib/color.sapp");

let status = color.deprecated_status();
assert(status.deprecated, "color.sapp reports deprecated compatibility status");
assert(status.replacement == "stdlib:colors.sapp", "color.sapp names colors.sapp replacement");

let rgb = color.hex_to_rgb("#0a1b2c");
assert(rgb.r == 10 and rgb.g == 27 and rgb.b == 44, "color.sapp keeps hex_to_rgb compatibility");
assert(color.rgb_to_hex(10, 27, 44) == "#0a1b2c", "color.sapp keeps old rgb_to_hex arity");

let mid = color.lerp_color(map{ r: 0, g: 0, b: 0 }, map{ r: 10, g: 20, b: 30 }, 0.5);
assert(mid.r == 5 and mid.g == 10 and mid.b == 15, "color.sapp lerp delegates to colors mix");
assert(color.red("x") == "\x1b[31mx\x1b[0m", "color.sapp keeps ANSI helper");

print "color_compat_pass";
