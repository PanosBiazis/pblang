let R = import("stdlib:resources.sapp");

assert(R.bounded_steps(-5) == 0, "negative steps become zero");
assert(R.bounded_steps(1000000, 50) == 50, "steps are capped");
let snap = R.snapshot();
assert(snap.format == "pblang.resources.snapshot.v2", "resource snapshots are versioned");
assert(snap.heap_scope == "host-thread" and not snap.owner_isolation and not snap.collection_allowed,
    "resource snapshots disclose retained host heap scope");
assert(not R.gc().ok and not R.gc().performed and not R.gc().conclusive,
    "unsafe retained-host collection fails closed without false success");
let empty = R.live_capture(-1, fn(i) { return i; });
assert(len(empty) == 1, "negative live capture keeps only baseline");
let leak = R.leak_check(fn(i) { return i; }, 0);
assert(leak.rounds == 0 and leak.leaking == nil and not leak.conclusive and len(leak.samples) == 0,
    "zero-round leak check is explicitly inconclusive");
let measured = R.gc_measure("bounded", fn() { return 7; });
assert(measured.result == 7 and not measured.collection_performed and not measured.conclusive,
    "GC measurement runs work but does not misreport blocked collection");
print "resources_pass";
