let R = import("stdlib:resources.sapp");

assert(R.bounded_steps(-5) == 0, "negative steps become zero");
assert(R.bounded_steps(1000000, 50) == 50, "steps are capped");
let snap = R.snapshot();
assert(snap.format == "pblang.resources.snapshot.v1", "resource snapshots are versioned");
let empty = R.live_capture(-1, fn(i) { return i; });
assert(len(empty) == 1, "negative live capture keeps only baseline");
let leak = R.leak_check(fn(i) { return i; }, 0);
assert(leak.rounds == 0 and not leak.leaking and len(leak.samples) == 0, "zero-round leak check is safe");
print "resources_pass";
