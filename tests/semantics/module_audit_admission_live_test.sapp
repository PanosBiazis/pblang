// Linux trusted-checkout integration: tampered resume input stays byte-identical.
if platform() != "linux" { print "module_admission_live_skip_linux_required"; os_exit(0); }
let compiler = env_get("PBLANG_BIN") ?? path_join(cwd(), "target/release/pblang");
let root = "tests/fixtures/module-admission-live-" + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 16);
let output = root + "/report.json"; let source_root = root + "/src";
let failure = "unexpected exception";
fn expect(ok, label) { if not ok { failure = label; throw label; } }
fn child(resume) {
    let args = ["-k", "1s", "10s", compiler, "tools/pbaudit.sapp", "--allow-all", "--",
        "--project=fixture", "--module-by-module", "--json-output=" + output,
        "--max-files=10", "--max-file-bytes=10000", source_root];
    if resume { array_push(args, "--resume"); }
    return proc_spawn_wait("/usr/bin/timeout", args);
}
fn exercise() {
    fs_mkdirs(source_root); fs_write(source_root + "/main.sapp", "fn ready() { return 1; }\n");
    let first = child(false);
    expect(first.exit_code == 0 and fs_exists(output), "fresh current-engine checkpoint succeeds");
    let original = fs_read(output); let clean = json_parse(original);
    expect(clean.complete and clean.engine_revision == "pblang.module-audit.engine.v8", "current engine recorded");
    let valid = child(true); let resumed = json_parse(fs_read(output));
    expect(valid.exit_code == 0 and resumed.resumed_modules == 1 and resumed.scanned_modules == 0, "canonical checkpoint still resumes");
    for mode in ["negative", "flag", "map", "inconsistent", "row"] {
        let report = json_parse(original); let module = report.modules[0];
        if mode == "negative" { module.finding_count = -1; }
        else if mode == "flag" { module.complete = "private-flag-marker"; }
        else if mode == "map" { module.counts_role = "private-map-marker"; }
        else if mode == "inconsistent" { module.counts_kind.security = 1; }
        else { module.findings = [map{role: "source", kind: "security", severity: "high"}]; }
        let tampered = json_stringify(report); fs_write(output, tampered);
        let rejected = child(true);
        expect(rejected.exit_code == 2 and rejected.stdout == "pbaudit: checkpoint module reports are invalid\n",
            "malformed checkpoint fails with exact diagnostic");
        expect(not str_contains(rejected.stderr, "private-") and not str_contains(rejected.stdout, "private-"), "no supplied-value leakage");
        expect(fs_read(output) == tampered, "rejected checkpoint preserved byte-for-byte");
        expect(fs_read(source_root + "/main.sapp") == "fn ready() { return 1; }\n", "source fixture preserved");
    }
    // An old engine's identity cannot be resumed as the current scanner.
    let legacy = json_parse(original);
    legacy.engine_revision = "pblang.module-audit.engine.v7";
    legacy.audit_id = sha256(json_stringify(map{
        project: "fixture", engine_revision: "pblang.module-audit.engine.v7",
        roots: legacy.requested_roots, max_depth: 4, max_entries: 1200,
        max_children: 160, max_files: 10, max_file_bytes: 10000, max_runtime_ms: 30000,
        max_findings: 160, source_only_blockers: true, excluded_paths: [output]}));
    let old = json_stringify(legacy); fs_write(output, old);
    let outdated = child(true);
    expect(outdated.exit_code == 2 and str_contains(outdated.stdout, "checkpoint options or roots do not match this audit"), "old-engine checkpoint needs fresh scan");
    expect(fs_read(output) == old, "old checkpoint remains intact");
    return true;
}
let ok = try exercise() catch false;
for path in [output, source_root + "/main.sapp", source_root, root] {
    if fs_exists(path) { fs_remove(path); }
}
if not ok { throw "FAIL module-admission-live: " + failure; }
print "module_audit_admission_live_pass";
