// Test: stdlib/aap_status.sapp one-command bounded AAP status.

let AAP = import("stdlib:aap_status.sapp");

fn fail(m) { throw "FAIL " + m; }

let ROOT = "_aap_status_tmp";

fn cleanup() {
    try fs_remove(ROOT + "/pl-dev/pblang/src/main.sapp") catch nil;
    try fs_remove(ROOT + "/pl-dev/pblang/src") catch nil;
    try fs_remove(ROOT + "/pl-dev/pblang") catch nil;
    try fs_remove(ROOT + "/pl-dev") catch nil;
    try fs_remove(ROOT + "/ai/pbai/docs/pbAI.md") catch nil;
    try fs_remove(ROOT + "/ai/pbai/docs") catch nil;
    try fs_remove(ROOT + "/ai/pbai") catch nil;
    try fs_remove(ROOT + "/ai") catch nil;
    try fs_remove(ROOT + "/os-dev/pbos/src/kernel.sapp") catch nil;
    try fs_remove(ROOT + "/os-dev/pbos/src") catch nil;
    try fs_remove(ROOT + "/os-dev/pbos") catch nil;
    try fs_remove(ROOT + "/os-dev") catch nil;
    try fs_remove(ROOT + "/tools/pblang/pb-mcp-server/README.md") catch nil;
    try fs_remove(ROOT + "/tools/pblang/pb-mcp-server") catch nil;
    try fs_remove(ROOT + "/tools/pblang") catch nil;
    try fs_remove(ROOT + "/tools/rust/pb-mcp-server/src/lib.rs") catch nil;
    try fs_remove(ROOT + "/tools/rust/pb-mcp-server/src") catch nil;
    try fs_remove(ROOT + "/tools/rust/pb-mcp-server") catch nil;
    try fs_remove(ROOT + "/tools/rust") catch nil;
    try fs_remove(ROOT + "/tools") catch nil;
    try fs_remove(ROOT) catch nil;
}

cleanup();
fs_mkdirs(ROOT + "/pl-dev/pblang/src");
fs_mkdirs(ROOT + "/ai/pbai/docs");
fs_mkdirs(ROOT + "/os-dev/pbos/src");
fs_mkdirs(ROOT + "/tools/pblang/pb-mcp-server");
fs_mkdirs(ROOT + "/tools/rust/pb-mcp-server/src");

fs_write(ROOT + "/pl-dev/pblang/src/main.sapp", "fn main() {\n    panic!(\"bad\");\n}\n");
fs_write(ROOT + "/ai/pbai/docs/pbAI.md", "# pbAI\nTODO placeholder teacher data roadmap\n");
fs_write(ROOT + "/os-dev/pbos/src/kernel.sapp", "fn boot_plan() { return \"ok\"; }\n");
fs_write(ROOT + "/tools/pblang/pb-mcp-server/README.md", "# pblang MCP\nroadmap gap: more tools\n");
fs_write(ROOT + "/tools/rust/pb-mcp-server/src/lib.rs", "#[cfg(test)]\nmod tests {\n    fn ok() { let x = \"1\".parse().unwrap(); }\n}\n");

let projects = [
AAP.project("pblang", [ROOT + "/pl-dev/pblang"]),
AAP.project("pbai", [ROOT + "/ai/pbai"]),
AAP.project("pbos", [ROOT + "/os-dev/pbos"]),
AAP.project("pb-mcp-pblang", [ROOT + "/tools/pblang/pb-mcp-server"]),
AAP.project("pb-mcp-rust", [ROOT + "/tools/rust/pb-mcp-server"])
];

let defaults = AAP.default_projects();
if len(defaults) != 16 { fail("default status covers every declared product"); }
if defaults[1].roots[0] != "../pbai" or defaults[5].roots[0] != "../pbos" { fail("default product roots use current products layout"); }
if defaults[2].name != "pb-mcp-server" or defaults[2].roots[0] != "../pb-mcp-server" { fail("default MCP root uses current product checkout"); }
if defaults[3].name != "pbremote" or defaults[3].roots[0] != "../pbremote" { fail("default status includes PBRemote"); }
if defaults[4].name != "pbspotit" or defaults[4].roots[0] != "../pbspotit" { fail("default status includes PBSpotIt"); }

let report = AAP.status_report(projects, map{
    max_depth: 6,
    max_entries: 200,
    max_children_per_dir: 80,
    max_files: 30,
    max_file_bytes: 4000,
    max_findings: 60,
    include_portfolio: true,
    portfolio_max_depth: 6,
    portfolio_max_entries: 200,
    portfolio_max_children_per_dir: 80,
    portfolio_lines: 8
});

if report.format != "pblang.aap_status.report.v1" { fail("status report format"); }
if report.status != "blocked" or report.blocked_count != 1 { fail("one project should be blocked by source panic"); }
if report.needs_review_count < 2 { fail("docs/roadmap projects should need review"); }
if report.passed_count < 1 { fail("clean project should pass"); }
if report.source_blocking < 1 or report.total_findings < 3 { fail("status aggregates findings"); }
if report.portfolio == nil or report.portfolio.idea_admission.eligible
or len(report.portfolio.action_plan.projects) != 0
or report.portfolio.proposals.proposal_count != 0 {
    fail("portfolio coverage is included but unbounded inventory cannot derive actions");
}
if report.focus_count < 1 or len(report.next_focus) < 1 { fail("next focus queue is included"); }
if report.next_focus[0].project != "pblang" or report.next_focus[0].status != "blocked" { fail("blocked source project ranks first"); }
if not str_contains(str(try report.next_focus[0].recommended_command catch ""), "pbaudit.sapp") { fail("next focus includes follow-up command"); }
if str_contains(str(try report.next_focus[0].recommended_command catch ""), "--allow-all") { fail("next focus should not recommend full capability escalation"); }

let lines = str_join(AAP.status_lines(report, 20), "\n");
if not str_contains(lines, "AAP status: blocked") { fail("status lines include top-level status"); }
if not str_contains(lines, "pblang: blocked") { fail("status lines include per-project status"); }
if not str_contains(lines, "next focus:") or not str_contains(lines, "pblang/") { fail("status lines include next focus queue"); }
if not str_contains(lines, "portfolio:") { fail("status lines include portfolio summary"); }
if str_contains(lines, "panic!(\"bad\")") { fail("status lines must not print raw source"); }
let detail = AAP.focus_detail(report, 0, 8);
if detail.project != "pblang" or detail.status != "blocked" or not str_contains(str(detail.command), "pbaudit.sapp") { fail("focus_detail points at first ranked focus"); }
if str_contains(str(detail.command), "--allow-all") { fail("focus_detail command should not require --allow-all"); }
let detail_lines = str_join(AAP.focus_detail_lines(detail, 12), "\n");
if not str_contains(detail_lines, "AAP focus detail: pblang/") or not str_contains(detail_lines, "command:") { fail("focus_detail_lines include actionable header and command"); }
if str_contains(detail_lines, "panic!(\"bad\")") { fail("focus detail lines must not print raw source"); }

let clean = AAP.status_report([AAP.project("pbos", [ROOT + "/os-dev/pbos"])], map{ include_portfolio: false, max_depth: 4, max_files: 10 });
if clean.status != "passed" or clean.blocked_count != 0 { fail("clean single-project status passes"); }
if clean.portfolio != nil { fail("portfolio can be disabled"); }
if clean.focus_count != 1 or clean.next_focus[0].status != "passed" { fail("clean report still has a keep-green focus item"); }

cleanup();
print "aap_status_pass";
