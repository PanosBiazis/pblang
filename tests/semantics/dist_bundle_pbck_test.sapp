// tests/semantics/dist_bundle_pbck_test.sapp
//
// dist.bundle_pbck(main_path, out_base) — the dist-level "ship portable bytecode"
// target. Links a multi-file program into ONE self-contained, OPTIMIZED
// self-hosted (PBCS) .pbck and reports the size. The artifact runs via
// stdlib/selfhost_loader.sapp / tools/pbrun.sapp with no Rust front-end, and is
// self-contained (runs after its source modules are deleted). The shipped
// bytecode is run through the sound optimizer, so it is smaller + faster than the
// unoptimized bundle (report.saved > 0 on foldable input).

let dist   = import("stdlib/dist.sapp");
let loader = import("stdlib/selfhost_loader.sapp");

fn fail(m) { throw "FAIL " + m; }
fn expect(c, m) { if not c { fail(m); } }

fn uniq(tag) { return "/tmp/pbldist_" + tag + "_" + str(num_floor(now_ms())); }

let lib_path  = uniq("lib") + ".sapp";
let main_path = uniq("main") + ".sapp";
let out_base  = uniq("art");
let snapshot_base = uniq("snapshot");
let snapshot_sentinel = uniq("snapshot_sentinel");

fs_write_bytes(lib_path, str_to_bytes("fn sq(x){ return x * x; } export sq;"));
// `2 + 3 + 4` is constant-foldable -> the optimizer shrinks the shipped bytecode.
fs_write_bytes(main_path, str_to_bytes("let m = import(\"" + lib_path + "\"); let k = 2 + 3 + 4; let answer = m.sq(9) + k; print answer;"));

let rep = dist.bundle_pbck(main_path, out_base);
expect(rep.ok, "bundle_pbck must succeed");
expect(rep.out == out_base + ".pbck", "report carries the .pbck output path");
expect(fs_exists(rep.out), "the .pbck artifact exists on disk");
expect(rep.bytes > 0, "artifact has bytes");
expect(rep.modules >= 1, "report counts the bundled modules");

// Optimization claim: the optimized artifact is strictly smaller than the
// unoptimized bundle for this foldable program.
expect(rep.bytes_unopt > 0, "report records the unoptimized size");
expect(rep.bytes <= rep.bytes_unopt, "optimized bundle is never larger");
expect(rep.saved > 0, "optimizer shrinks the foldable bundle (saved > 0)");
expect(rep.saved == rep.bytes_unopt - rep.bytes, "saved == unopt - opt");

// Delete sources -> the artifact must still run (self-contained).
fs_remove(lib_path);
fs_remove(main_path);

let res = loader.run_pbck(rep.out);
expect(res.ok, "the optimized artifact runs from disk");
expect(res.globals["answer"] == 90, "sq(9) + (2+3+4) == 81 + 9 == 90");
expect(res.output[0] == 90, "artifact print output survives");

// The snapshot API compiles only the supplied analyzed bytes. A real import is
// rejected because this API deliberately has no filesystem resolver.
fs_write(snapshot_sentinel, "sentinel-safe");
let snapshot_link = try proc_spawn_wait("/bin/ln",
    ["-s", snapshot_sentinel, snapshot_base + ".pbck"]) catch nil;
expect(snapshot_link != nil and snapshot_link.exit_code == 0,
    "snapshot symlink attack fixture created");
let snapshot = dist.bundle_pbck_source(
    "let answer = 41 + 1; print answer;", snapshot_base, map{ optimize: true });
expect(snapshot.ok and snapshot.source_transport == "immutable-memory",
    "immutable linked source builds without filesystem resolution");
expect(snapshot.atomic_publication and not snapshot.symlink_target_followed
    and fs_read(snapshot_sentinel) == "sentinel-safe",
    "PBCK publication replaces the link without touching its target");
let snapshot_run = loader.run_pbck(snapshot.out);
expect(snapshot_run.ok and snapshot_run.globals["answer"] == 42,
    "immutable source is the complete PBCK input");
expect(not dist.bundle_pbck_blob("let m = import(\"missing.sapp\");", nil).ok,
    "snapshot API fails closed when linked imports remain");

fs_remove(rep.out);
fs_remove(snapshot.out);
fs_remove(snapshot_sentinel);
print "dist_bundle_pbck_pass";
