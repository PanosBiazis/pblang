let A=import("stdlib:project_audit.sapp");
let T=import("stdlib:project_text_audit.sapp");
fn expect(ok,label) {if not ok {throw "FAIL audit-finding-preflight: "+label;}}
expect(A.require_finding_limit()==500 and A.require_finding_limit(nil)==500,"fixed aggregate default");
for value in [1,200,500,4096] {expect(A.require_finding_limit(value)==value,"scalar admission unchanged");}
let invalid=[true,false,"private-limit-marker",[],map{},fn(){return 1;},
    parse_number("NaN"),parse_number("inf"),parse_number("-inf"),bigint(1),
    rational("1/1"),decimal("1"),0,-1,1.5,4097];
let module_error=map{ok:false,complete:false,format:"pblang.module_audit.v1",error:"invalid module audit bounds"};
for value in invalid {
    expect(try {A.require_finding_limit(value);false} catch true,"public validator rejects malformed values");
    expect(try {T.audit_roots("fixture",[],map{max_findings:value});false} catch true,"root audit propagates rejection");
    expect(json_stringify(T.audit_modules("fixture",["private-root-marker"],map{max_findings_per_file:value}))==json_stringify(module_error),"module exact value-free rejection");
}
expect(json_stringify(T.audit_modules("fixture",["private-root-marker"],map{max_findings_per_file:nil}))==json_stringify(module_error),"module nil remains invalid");
let roots_error=T.audit_modules("fixture",[],map{max_findings_per_file:parse_number("NaN")});
expect(not roots_error.ok and roots_error.error=="roots must contain 1..256 modules","root-shape error precedence");
for options in [map{},map{max_findings:nil},map{max_findings:1},map{max_findings:4096}] {
    let result=T.audit_roots("fixture",[],options);
    expect(not result.complete and not result.quality_gate.passed,"valid budget with empty roots still fails coverage");
}
for value in [1,4096] {
    let result=T.audit_modules("fixture",["tests/fixtures/module_audit/tools"],map{
        max_findings_per_file:value,max_files_per_module:10,max_file_bytes:10000});
    expect(result.ok and result.files_scanned==1,"valid module boundary reaches scan");
}
expect(T.module_audit_engine_revision()=="pblang.module-audit.engine.v9","checkpoint admission revision advanced");
print "project_text_audit_finding_preflight_pass";
