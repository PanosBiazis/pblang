let C=import("stdlib:crud_account_catalog.sapp");
let hash="$2b$12$B7w/XX4A/.4otknYJe0OOu69/Zr7IM3viqeA4Jl/tgB9GIcM/mPn.";
let source=map{revision:0,accounts:map{editor:hash}};
let encoded=C.encode(source);assert(C.decode(encoded)==source,"catalog roundtrip");
let copy=C.decode(encoded);copy.accounts.editor="changed";assert(source.accounts.editor==hash,"detached catalog");
fn reject(work){let failed=false;try work() catch {failed=true;};assert(failed,"invalid catalog rejected");}
for text in ["",encoded+"\n",encoded+"\neditor\t"+hash,str_replace_all(encoded,"\t0","\t00"),str_replace_all(encoded,"\t0","\t9007199254740992"),str_repeat("x",16385),str_replace_all(encoded,"editor","bad/name"),str_replace_all(encoded,hash,"plaintext-secret")] {
    reject(fn(){C.decode(text);});
}
for accounts in [map{},map{editor:"plaintext"},map{"bad\nname":hash}] {reject(fn(){C.encode(map{revision:0,accounts:accounts});});}
reject(fn(){C.encode(map{revision:true,accounts:source.accounts});});
reject(fn(){C.encode(map{revision:0,accounts:source.accounts,unexpected:true});});
let maximum=map{};for i 100 {maximum[str_repeat("u",64-len(str(i)))+str(i)]=hash;}
assert(len(str_to_bytes(C.encode(map{revision:9007199254740991,accounts:maximum})))<=C.MAX_BYTES,"complete admitted catalog fits byte bound");
assert(C.decode(C.encode(map{revision:9007199254740991,accounts:maximum})).revision==9007199254740991,"max revision exact");
maximum.extra=hash;reject(fn(){C.encode(map{revision:0,accounts:maximum});});
print "crud_account_catalog_pass";
