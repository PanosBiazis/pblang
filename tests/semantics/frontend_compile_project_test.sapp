// tests/semantics/frontend_compile_project_test.sapp
//
// frontend_compile_project(dir) compiles every .sapp file in a directory. It was
// dead-on-arrival: it called the non-existent builtin `fs_list` (the real one is
// `fs_listdir`), so EVERY call threw "undefined global 'fs_list'" before it could
// list anything. No test exercised it, so the broken exported API went unnoticed.
// This test compiles a small on-disk project and asserts the per-file results.

let fe = import("stdlib/compiler/selfhost_frontend.sapp");

fn fail(m) { throw "FAIL " + m; }

let dir = "/tmp/pbfcp_" + str(num_floor(now_ms()));
fs_mkdirs(dir);
fs_write_bytes(dir + "/a.sapp", str_to_bytes("fn a() { return 1; }"));
fs_write_bytes(dir + "/b.sapp", str_to_bytes("fn b() { return 2; } fn c() { return a() + 1; }"));
// A file with a real parse error so fail-counting is exercised.
fs_write_bytes(dir + "/broken.sapp", str_to_bytes("fn d( {"));
// A non-.sapp file must be ignored.
fs_write_bytes(dir + "/notes.txt", str_to_bytes("not pblang"));

// 1. Must NOT throw (it used to throw on the fs_list call).
let r = try fe.frontend_compile_project(dir) catch "THREW";
if r == "THREW" { fail("frontend_compile_project threw (fs_list bug?)"); }
if not is_map(r) { fail("result must be a map"); }

// 2. Only the three .sapp files are compiled (the .txt is ignored).
if r.files_compiled != 3 { fail("expected 3 .sapp files compiled, got " + str(r.files_compiled)); }

// 3. The two valid files compile; the broken one fails.
if r.ok_count != 2 { fail("expected 2 ok files, got " + str(r.ok_count)); }
if r.fail_count != 1 { fail("expected 1 failing file, got " + str(r.fail_count)); }
if r.ok { fail("project ok must be false when a file fails to compile"); }

// 4. Each result carries a file name and diagnostics array.
let i = 0;
let saw_broken = false;
while i < len(r.results) {
    let res = r.results[i];
    if (try res.file catch nil) == nil { fail("result missing file name"); }
    if res.file == "broken.sapp" {
        saw_broken = true;
        if res.ok { fail("broken.sapp must not be ok"); }
    }
    i = i + 1;
}
if not saw_broken { fail("broken.sapp result missing"); }

// cleanup (best-effort)
let _ = try fs_remove(dir + "/a.sapp") catch nil;
let _2 = try fs_remove(dir + "/b.sapp") catch nil;
let _3 = try fs_remove(dir + "/broken.sapp") catch nil;
let _4 = try fs_remove(dir + "/notes.txt") catch nil;

print "frontend_compile_project_pass";
