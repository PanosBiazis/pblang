let FE=import("stdlib/compiler/selfhost_frontend.sapp");
let VM=import("stdlib/compiler/vm.sapp");
let OPT=import("stdlib/compiler/optimizer.sapp");
let PB=import("stdlib/selfhost_pbck.sapp");
let L=import("stdlib/selfhost_loader.sapp");
fn expect(ok,label){if not ok {throw "FAIL shared capture: "+label;}}
fn check(source,want){
    let c=FE.frontend_compile(source);
    expect(c.ok,"compile "+str(c.diagnostics));
    for chunk in [c.chunk,OPT.optimize_safe(c.chunk).chunk] {
        expect(VM.run(chunk).output==want,"VM "+source);
        expect(VM.run_bounded(chunk).output==want,"bounded");
        let bytes=PB.serialize_chunk(chunk);
        expect(VM.run(PB.deserialize_chunk(bytes)).output==want,"PBCS");
        let loaded=L.run_pbck_bytes(bytes);expect(loaded.ok and loaded.output==want,"loader");
    }
}
let cases=import("tests/fixtures/shared_capture_cases.sapp").cases;
for item in cases {check(item[0],item[1]);}
// Low-level users explicitly finalize once; a second call cannot double-box.
let CG=import("stdlib/compiler/codegen.sapp");
let parsed=FE.frontend_compile(cases[0][0]);
let cg=CG.CodeGen();cg.is_module=true;CG.codegen_block(cg,parsed.ast.stmts);
let finished=CG.codegen_finish(cg);
let bytes=PB.serialize_chunk(finished);
expect(VM.run(finished).output==cases[0][1],"manual finalization");
expect(PB.serialize_chunk(CG.codegen_finish(cg))==bytes,"idempotent finalization");
// Existing raw VM/PBCS upvalues are not reinterpreted as cells.
let legacy=map{constants:[],instructions:[map{op:38,operand:0},map{op:19,operand:0}]};
expect(VM.exec(legacy,[],map{},[],[7])==7,"raw scalar upvalue remains scalar");
expect(VM.exec(PB.deserialize_chunk(PB.serialize_chunk(legacy)),[],map{},[],[7])==7,"legacy persisted upvalue");
print "selfhost_shared_capture_pass";
