// Test: stdlib/secscan.sapp — defensive cybersecurity toolkit.
//
// Threat detection (classify hostile input by attack class), leaked-secret
// scanning (find credentials in text/code), password-strength scoring with
// Shannon entropy, and redaction. Purely DEFENSIVE — detection + hardening, no
// attack tooling. Pure pblang; runs on the interpreter.

let sec = import("stdlib/secscan.sapp");

fn has_type(rows, name) {
    let i = 0;
    while i < len(rows) { if rows[i].type == name { return true; } i = i + 1; }
    return false;
}

// ── scan_input: classify hostile input by attack class ──
let sqli = sec.scan_input("admin' OR '1'='1");
assert(sqli.safe == false, "SQL injection is not safe");
assert(has_type(sqli.threats, "sql_injection"), "detects SQL injection");
assert(sqli.risk == "high" or sqli.risk == "critical", "SQLi is high/critical risk");

let xss = sec.scan_input("<script>alert(document.cookie)</script>");
assert(has_type(xss.threats, "xss"), "detects XSS");

let trav = sec.scan_input("../../etc/passwd");
assert(has_type(trav.threats, "path_traversal"), "detects path traversal");

let cmd = sec.scan_input("foo; rm -rf /");
assert(has_type(cmd.threats, "command_injection"), "detects command injection");

let clean = sec.scan_input("hello world, this is normal input 123");
assert(clean.safe == true and clean.risk == "none", "benign input is safe");

// ── detect_secrets: find leaked credentials in text ──
let s1 = sec.detect_secrets("aws_key=AKIAIOSFODNN7EXAMPLE in config");
assert(has_type(s1, "aws_access_key"), "detects AWS access key");
assert((try s1[0].value catch nil) == nil, "public secret findings never expose the raw value");

let s2 = sec.detect_secrets("token: ghp_1234567890abcdefghijklmnopqrstuvwx");
assert(has_type(s2, "github_token"), "detects GitHub token");

let s3 = sec.detect_secrets("-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----");
assert(has_type(s3, "private_key"), "detects private key block");

let s4 = sec.detect_secrets("k=A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6");
assert(has_type(s4, "high_entropy_secret"), "flags a high-entropy mixed token");

let ordered_alphabet = sec.detect_secrets("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789");
assert(len(ordered_alphabet) == 0, "ordered encoding alphabets are not high-entropy credentials");

let pathish = sec.detect_secrets("dataset=progrCS/RealAIVisualizer and path=pl-dev/pblang/stdlib/compiler");
assert(len(pathish) == 0, "path-like mixed-case identifiers are not high-entropy secrets");

let member_access = sec.detect_secrets("CircuitChannel.introduce1");
assert(len(member_access) == 0, "qualified source identifiers are not high-entropy secrets");

let artifacts = sec.detect_secrets("PBRemote-android14-universal-debug.apk PBRemote-linux-x86_64 remote-through-SOCKS5");
assert(len(artifacts) == 0, "artifact names and short protocol labels are not secrets");

let s0 = sec.detect_secrets("just some normal words here today and tomorrow");
assert(len(s0) == 0, "clean text has no secrets (no false positives)");

// ── shannon_entropy: bits/char ──
assert(sec.shannon_entropy("aaaa") == 0.0, "uniform string has zero entropy");
let e2 = sec.shannon_entropy("ab");
assert(e2 > 0.99 and e2 < 1.01, "two equiprobable chars -> 1 bit/char");

// ── password_strength: graded score + entropy bits ──
let weak = sec.password_strength("abc");
assert(weak.score == 0 and weak.verdict == "very_weak", "short lowercase password is very weak");
let strong = sec.password_strength("Tr0ub4dour&3xpl0it!");
assert(strong.score >= 3, "long mixed-class password scores strong");
assert(strong.has_symbol == true and strong.classes == 4, "strong password uses all char classes");
assert(strong.entropy_bits > weak.entropy_bits, "more entropy bits for the stronger password");

// ── redact: strip detected secrets from text (safe logging) ──
let r = sec.redact("connect with AKIAIOSFODNN7EXAMPLE now");
assert(str_contains(r, "AKIA***"), "redact masks the secret");
assert(str_contains(r, "AKIAIOSFODNN7EXAMPLE") == false, "redact removes the raw secret");

// ── cli_scan: pure CLI adapter for tools/pbscan.sapp (CI-style exit codes) ──
let tmp = "tests/semantics/.secscan_tmp.txt";
fs_write(tmp, "key=AKIAIOSFODNN7EXAMPLE\nuser=bad' or '1'='1");
let c = sec.cli_scan([tmp]);
assert(c.ok == true and c.exit_code == 1, "cli_scan flags findings with exit 1");
assert(len(c.secrets) >= 1, "cli_scan finds the secret");
assert((try c.secrets[0].value catch nil) == nil, "cli_scan structured result is redacted by construction");
assert(len(c.threats) >= 1, "cli_scan finds the threat");

let cc = sec.cli_scan(["--text", "totally clean content here"]);
assert(cc.ok == true and cc.exit_code == 0, "clean content -> exit 0");

let cu = sec.cli_scan([]);
assert(cu.ok == false and cu.exit_code == 2, "no args -> usage exit 2");

let cm = sec.cli_scan(["tests/semantics/.no_such_file.txt"]);
assert(cm.ok == false and cm.exit_code == 2, "missing file -> usage error");

print "secscan_pass";
