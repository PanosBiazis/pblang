let C=import("stdlib:controlled_modularity.sapp");
fn module(id) {return map{id:id,version:"1.0.0",interfaces:map{value:"1.0.0"},capabilities:[],dependencies:[]};}
fn edge(id,optional=false,fallback=nil) {return map{slot:"value",module:id,version:"1.0.0",interface:"value",interface_version:"1.0.0",optional:optional,fallback:fallback};}
fn document(modules) {return map{format:C.FORMAT,modules:modules};}
fn refused(doc,code) {let p=C.resolve(doc,"app");assert(not p.ok and p.code==code and len(p.order)==0 and len(p.bindings)==0,"closed rejection: "+code);}
let app=module("app");let cpu=module("cpu");let fast=module("fast");
let standalone=C.resolve(document([app]),"app");assert(standalone.ok and standalone.order==["app"],"standalone root without optional dependency");
app.dependencies=[edge("fast",true,"cpu")];
let fallback=C.resolve(document([app,cpu]),"app");assert(fallback.ok and fallback.order==["cpu","app"] and fallback.bindings[0].provider=="cpu" and fallback.bindings[0].status=="fallback","declared deterministic fallback");
let doc=document([app,cpu,fast]);let before=json_stringify(doc);
let connected=C.resolve(doc,"app");assert(connected.ok and connected.order==["fast","app"] and connected.bindings[0].status=="primary","integrated primary provider");
assert(json_stringify(doc)==before,"caller records not mutated");
assert(json_stringify(C.resolve(document([fast,app,cpu]),"app"))==json_stringify(connected),"catalog order independent");
fast.version="2.0.0";refused(doc,"package_version_mismatch");fast.version="1.0.0";
fast.interfaces.value="2.0.0";refused(doc,"interface_version_mismatch");fast.interfaces=map{};refused(doc,"missing_interface");fast.interfaces=map{value:"1.0.0"};
fast.capabilities=["accelerator"];refused(doc,"missing_capability");assert(C.resolve(doc,"app",["accelerator"]).ok,"explicit capability availability");fast.capabilities=[];
refused(document([app]),"missing_fallback");
app.dependencies=[edge("fast",true)];let disabled=C.resolve(document([app]),"app");assert(disabled.ok and disabled.bindings[0].provider==nil and disabled.bindings[0].status=="disabled","optional absent is explicit disabled slot");
app.dependencies=[edge("fast")];refused(document([app]),"missing_required");
fast.dependencies=[edge("app")];refused(document([app,fast]),"dependency_cycle");fast.dependencies=[];
let malformed=module("bad");malformed.version="01.0.0";refused(document([app,malformed]),"invalid_contract");
for broken in [nil,[],map{},map{format:C.FORMAT,modules:[]},document([app,app])] {assert(not C.validate(broken),"strict schema");}
let invalid=module("private/path");assert(not C.validate(document([invalid])),"paths cannot be IDs");
invalid=module("app");invalid.dependencies=[edge("fast",false,"cpu")];assert(not C.validate(document([invalid])),"required dependency cannot silently fallback");
invalid.dependencies=[edge("fast"),edge("cpu")];assert(not C.validate(document([invalid])),"duplicate slots rejected");
invalid=module("app");invalid.capabilities=["x","x"];assert(not C.validate(document([invalid])),"duplicate claims rejected");
invalid=module("app");invalid.extra="private_canary";let rejection=C.resolve(document([invalid]),"app");assert(not str_contains(json_stringify(rejection),"private_canary"),"unknown fields do not leak payload");
let many=[];for i 65 {push(many,module("m"+str(i)));}assert(not C.validate(document(many)),"module count bound");
let encoded=json_stringify(document([module("app")]));assert(C.parse(encoded).ok,"bounded JSON admission");
for text in ["{\"format\":\"x\",\"format\":\"y\"}",str_repeat(" ",262145),"{",str_repeat("[",14)+"0"+str_repeat("]",14)] {assert(not C.parse(text).ok,"duplicate/size/syntax/depth limits");}
assert(not C.resolve(document([module("app")]),"app",["cap","cap"]).ok,"invalid available claims refused");
assert(not connected.capability_claims_verified and not connected.execution_performed,"static planning never grants runtime authority");
let left=module("left");let right=module("right");let hub=module("app");
let a=edge("left");let b=edge("right");b.slot="other";hub.dependencies=[b,a];
let diamond=C.resolve(document([right,hub,left]),"app");
assert(diamond.order==["left","right","app"],"canonical dependency layers");
diamond.bindings[0].provider="changed";assert(hub.dependencies[0].module=="right" and hub.dependencies[1].module=="left","result mutation cannot change input records");
let chain=[];for i 64 {let m=module("n"+str(i));if i>0 {m.dependencies=[edge("n"+str(i-1))];}push(chain,m);}
assert(len(C.resolve(document(chain),"n63").order)==64,"maximum selected chain without recursive resolution");
let excessive=[];for i 17 {let m=module("m"+str(i));for j 16 {let dep=edge("leaf");dep.slot="s"+str(j);push(m.dependencies,dep);}push(excessive,m);}
assert(not C.validate(document(excessive)),"aggregate edge budget");
print "controlled_modularity_pass";
