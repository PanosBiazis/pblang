// tests/semantics/transform2d_test.sapp — stdlib/transform2d.sapp
//
// 2D affine transforms + a matrix stack + a clip-rect stack — the retained state a 2D
// renderer (nanovg / canvas / the gpu2d stack) keeps: translate/scale/rotate points,
// push/pop nested coordinate frames, and intersecting clip rectangles. Pure + testable.

let T = import("stdlib/transform2d.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── basic matrices ─────────────────────────────────────────────────────────────────
let p0 = T.apply(T.identity(), 5, 7);
approx(p0.x, 5, "identity x"); approx(p0.y, 7, "identity y");

let pt = T.apply(T.translate(10, 20), 5, 7);
approx(pt.x, 15, "translate x"); approx(pt.y, 27, "translate y");

let ps = T.apply(T.scale(2, 3), 5, 7);
approx(ps.x, 10, "scale x"); approx(ps.y, 21, "scale y");

// rotate 90 degrees: (1,0) -> (0,1)
let pr = T.apply(T.rotate(T.deg(90)), 1, 0);
approx(pr.x, 0, "rot90 x"); approx(pr.y, 1, "rot90 y");

// composition: multiply(A,B) applies B then A (A*B). Scale-then-translate a point.
let m = T.multiply(T.translate(100, 0), T.scale(2, 2));
let pc = T.apply(m, 3, 4);
approx(pc.x, 106, "compose x = 100 + 2*3"); approx(pc.y, 8, "compose y = 2*4");

// ── matrix stack: push/transform/pop restores ──────────────────────────────────────
let st = T.stack_new();
T.stack_translate(st, 10, 10);
let a = T.stack_apply(st, 0, 0);
approx(a.x, 10, "stack translate x");
T.push(st);
T.stack_scale(st, 2, 2);
let b = T.stack_apply(st, 5, 0);
approx(b.x, 20, "nested: 10 + 2*5");
T.pop(st);
let c = T.stack_apply(st, 5, 0);
approx(c.x, 15, "after pop: back to just translate (10+5)");

// ── clip stack: intersection + hit test ────────────────────────────────────────────
let cs = T.clip_new(0, 0, 100, 100);
T.clip_push(cs, map{ x: 50, y: 50, w: 100, h: 100 });
let cur = T.clip_current(cs);
eq(cur.x, 50, "clip intersect x"); eq(cur.y, 50, "clip intersect y");
eq(cur.w, 50, "clip intersect w"); eq(cur.h, 50, "clip intersect h (100 clamped)");
eq(T.clip_contains(cs, 60, 60), true, "inside clip");
eq(T.clip_contains(cs, 10, 10), false, "outside intersected clip");
T.clip_pop(cs);
eq(T.clip_contains(cs, 10, 10), true, "after pop, back to full clip");

print "transform2d_pass";
