// tests/semantics/protocol_enrich_test.sapp — enrichment for stdlib/protocol.sapp
//
// protocol.sapp is a JSON-backed message-schema module (define_message / encode /
// decode / validate). This adds: default values, repeated (array) fields, enum
// constraints, nested message fields, forgiving type aliases (int/float -> number,
// etc.), and encode_strict (validate-then-encode).

let p = import("stdlib/protocol.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base round-trip still works ─────────────────────────────────────────────────
let User = p.define_message("User", [
    map{ name: "id", type: "number", required: true },
    map{ name: "name", type: "string", required: true },
    map{ name: "role", type: "string", default: "guest" },
    map{ name: "age", type: "int" },                       // alias for number
    map{ name: "tags", type: "string", repeated: true },
    map{ name: "status", type: "string", enum: ["active", "banned"] }
]);
let enc = p.encode(User, map{ id: 1, name: "Jane" });
let back = p.decode(User, enc);
eq(back.id, 1, "id round-trip"); eq(back.name, "Jane", "name round-trip");

// ── ENRICH: defaults are filled on decode (and encode) ──────────────────────────
eq(back.role, "guest", "default applied on decode");
let enc2 = p.decode(User, p.encode(User, map{ id: 2, name: "Bob" }));
eq(enc2.role, "guest", "default applied through encode");

// ── ENRICH: type aliases (int counts as number) ─────────────────────────────────
eq(p.validate(User, map{ id: 1, name: "x", age: 30 }).valid, true, "int alias accepts a number");

// ── ENRICH: repeated fields must be arrays of the element type ───────────────────
eq(p.validate(User, map{ id: 1, name: "x", tags: ["a", "b"] }).valid, true, "repeated string array ok");
eq(p.validate(User, map{ id: 1, name: "x", tags: "nope" }).valid, false, "repeated must be an array");
eq(p.validate(User, map{ id: 1, name: "x", tags: ["a", 5] }).valid, false, "repeated element type checked");

// ── ENRICH: enum constraint ─────────────────────────────────────────────────────
eq(p.validate(User, map{ id: 1, name: "x", status: "active" }).valid, true, "enum value allowed");
eq(p.validate(User, map{ id: 1, name: "x", status: "ghost" }).valid, false, "enum value rejected");

// ── ENRICH: nested message field ────────────────────────────────────────────────
let Addr = p.define_message("Addr", [ map{ name: "city", type: "string", required: true } ]);
let Order = p.define_message("Order", [
    map{ name: "sku", type: "string", required: true },
    map{ name: "ship_to", message: Addr, required: true }
]);
eq(p.validate(Order, map{ sku: "A1", ship_to: map{ city: "NYC" } }).valid, true, "nested valid");
let bad = p.validate(Order, map{ sku: "A1", ship_to: map{} });
eq(bad.valid, false, "nested invalid propagates");

// ── ENRICH: encode_strict validates first ───────────────────────────────────────
let s = p.encode_strict(User, map{ id: 9, name: "Z", status: "active" });
eq(p.decode(User, s).id, 9, "encode_strict on valid data produces a message");
let threw = try p.encode_strict(User, map{ id: 9 }) catch "ERR";   // missing required name
eq(threw, "ERR", "encode_strict throws on invalid data");

// ── required still enforced by validate ─────────────────────────────────────────
eq(p.validate(User, map{ name: "x" }).valid, false, "missing required id -> invalid");

print "protocol_enrich_pass";
