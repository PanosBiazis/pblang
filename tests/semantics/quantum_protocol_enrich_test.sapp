// tests/semantics/quantum_protocol_enrich_test.sapp — enrichment for stdlib/quantum_protocol.sapp
// Job-queue lifecycle/introspection: clear, list_jobs, job_count, status_of, cancel.

let P = import("stdlib/quantum_protocol.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// start from a clean queue (other tests may share the module instance)
P.clear();
eq(P.job_count(), 0, "cleared -> 0 jobs");

// submit a 1-qubit job
let spec = map{ n: 1, ops: [map{ gate: "h", q: 0 }] };
let job = P.submit(spec);
eq(P.job_count(), 1, "one job after submit");

// list_jobs returns the job id
let ids = P.list_jobs();
eq(len(ids), 1, "list_jobs has 1");
eq(ids[0], job.job_id, "list_jobs id matches");

// status_of
eq(P.status_of(job.job_id), "completed", "status completed");
eq(P.status_of("does-not-exist"), "not_found", "missing -> not_found");

// cancel marks the job cancelled; returns true, false when missing
if not P.cancel(job.job_id) { fail("cancel existing -> true"); }
eq(P.status_of(job.job_id), "cancelled", "status now cancelled");
if P.cancel("nope") { fail("cancel missing -> false"); }

// clear empties the queue
P.clear();
eq(P.job_count(), 0, "clear -> 0");

print "quantum_protocol_enrich_pass";
