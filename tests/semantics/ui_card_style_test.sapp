let Style=import("stdlib:ui_style.sapp");
let UI=import("stdlib:modern_ui.sapp");
let GUI=import("stdlib:gui.sapp");
let Web=import("stdlib:modern_ui_web.sapp");
let Android=import("stdlib:modern_ui_android.sapp");
let Colors=import("stdlib:colors.sapp");
let a=Style.card_preset("outlined",map{card_radius:0,name:"square"});
assert(a.card_radius==0 and a.card_elevation==0 and a.name=="square","preset overrides retain ordinary options");
a.card_radius=30;assert(Style.card_preset("outlined").card_radius==14,"fresh presets");
let override=map{card_radius:8};let p=Style.card_preset("tonal",override);p.card_radius=4;
assert(override.card_radius==8,"caller options preserved");
assert((try Style.card_preset("unknown") catch nil)==nil,"unknown preset fails");
for field in ["card_radius","card_elevation","card_variant"] {
    for bad in [-1,33,1.5,true,[],map{},"bad;color:red"] {
        let opts=map{};opts[field]=bad;
        assert(not UI.validate(UI.screen([UI.card([],opts)])).ok,"invalid card option rejected");
    }
}
assert(not UI.validate(UI.screen([UI.card([],map{card_elevation:9})])).ok,"bounded elevation");
for theme in ["light","dark"] {
    let colors=Style.palette(theme);
    for name in ["surface","outlined","tonal"] {
        let style=Style.card(colors,Style.card_preset(name));
        for role in ["text","muted"] {
            let color=colors[role];let fill=style.fill;
            assert(Colors.contrast_ratio(map{r:color[0],g:color[1],b:color[2]},map{r:fill[0],g:fill[1],b:fill[2]})>=4.5,"preset card text contrast");
        }
    }
}
let tree=UI.screen([UI.card([UI.text("Square")],Style.card_preset("outlined",map{name:"square",card_radius:0})),
    UI.card([UI.text("Round")],Style.card_preset("tonal",map{name:"round",card_radius:24})),
    UI.card([UI.text("Inherited")],map{name:"inherited"})]);
let opts=Style.options("light");opts.card_radius=32;
let f=UI.build("Cards",tree,opts);
assert(GUI.get(f,"square").card_radius==0 and GUI.get(f,"round").card_radius==24 and not map_has(GUI.get(f,"inherited"),"card_radius"),"per-card options reach native widgets without changing inheritance");
let web=Web.generate("Cards",UI.compile(tree,map{target:"web"}),opts);
assert(str_contains(web.css,".pb-card.pb-n-2{border-radius:0px;") and str_contains(web.css,".pb-card{border-radius:32px}"),"local CSS specificity beats global token");
assert(str_contains(web.css,"box-shadow:none;") and str_contains(web.css,"background:rgb(255,255,255)"),"Web flat and semantic surface rules");
let portable=UI.compile(tree,map{target:"ios"});
assert(portable.view.children[0].card_radius==0,"portable iOS contract retains options");
let bundle=UI.compile(tree,map{target:"android"});let original=Android.activity_class(bundle,opts);
tree.children[0].card_radius=8;assert(original!=Android.activity_class(bundle,opts),"Android local corner choice changes class bytes");
tree.children[0].card_radius=0;tree.children[0].card_elevation=4;
assert(original!=Android.activity_class(bundle,opts),"Android elevation changes class bytes");
tree.children[0].card_elevation=0;tree.children[0].card_variant="tonal";
assert(original!=Android.activity_class(bundle,opts),"Android semantic surface changes class bytes");
tree.children[0].card_variant="bad";
assert((try Android.activity_class(bundle,opts) catch nil)==nil,"Android validates mutated card source");
assert((try Web.generate("Cards",UI.compile(tree,map{target:"web"}),opts) catch nil)==nil,"Web fails closed on invalid style");
fn draw(style,scale=1) {
    let form=GUI.form("Panel",240,180);form.palette=Style.palette("dark");form.card_radius=14;form.viewport.ui_scale=scale;
    let panel=GUI.panel("panel",10,10,120,80,"");GUI.style_panel(panel,style);GUI.add(form,panel);
    let rects=[];let win=map{clear:fn(c){},line:fn(a,b,c,d,e){},rect:fn(x,y,w,h,c){array_push(rects,map{x:x,y:y,w:w,h:h,color:c});}};
    GUI.draw(win,form);return rects;
}
fn color_at(rects,x,y) {
    let value=nil;for r in rects {if x>=r.x and y>=r.y and x<r.x+r.w and y<r.y+r.h {value=r.color;}}
    return value;
}
let square=draw(Style.card_preset("outlined",map{card_radius:0}));
let round=draw(Style.card_preset("tonal"));let palette=Style.palette("dark");
assert(str(color_at(square,10,10))==str(palette.accent),"square outlined corner drawn with accent");
assert(color_at(round,10,10)==nil and str(color_at(round,70,50))==str(palette.field),"round tonal corner and fill");
for r in round {assert(r.x+r.w<=130 and r.y+r.h<=90,"zero elevation has no outside shadow");}
let raised=draw(map{card_elevation:4},2);let max_x=0;
for r in raised {max_x=num_max(max_x,r.x+r.w);}
assert(max_x==138,"native elevation follows explicit scale");
assert((try GUI.style_panel(GUI.label("x",0,0,"x"),map{}) catch nil)==nil,"panel styling rejects other widgets");
print "ui_card_style_pass";
