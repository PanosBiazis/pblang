let C=import("stdlib:resource_capacity.sapp");let I=import("stdlib:interval_analysis.sapp");
fn booking(id,a,b,units=1,resource="r") {return map{id:id,resource:resource,start_ms:a,end_ms:b,units:units};}
let resources=[map{id:"r",capacity:3}];let window=map{start_ms:0,end_ms:30};
fn rejected(rs,bs,w) {return (try C.analyze(rs,bs,w) catch nil)==nil;}
let input=[booking("later",10,20,2),booking("early",0,15,2)];let before=json_stringify(input);
let report=C.analyze(resources,input,window);let r=report.resources[0];
assert(r.peak_units==4 and r.overload_ms==5 and r.shortfall_unit_ms==5,"weighted shortage");
assert(r.used_unit_ms==50 and r.available_unit_ms==90 and r.segments[len(r.segments)-1].load==0,"explicit idle window and integral");
assert(report.overloaded_resources==1 and json_stringify(input)==before,"input unchanged");
report.window.start_ms=9;report.resources[0].segments[0].booking_ids[0]="changed";
assert(window.start_ms==0 and json_stringify(input)==before,"detached report");
let handoff=C.analyze(resources,[booking("a",0,10,3),booking("b",10,30,3)],window);
assert(handoff.resources[0].peak_units==3 and handoff.overloaded_resources==0,"ending and starting together");
let idle=C.analyze(resources,[],window).resources[0];assert(idle.segments==[map{start_ms:0,end_ms:30,load:0,excess:0,booking_ids:[]}] and idle.used_unit_ms==0,"empty bookings");
// Independent discrete-time oracle, including unsorted, nested and weighted intervals.
for seed in range(0,24) {
 let bookings=[];
 for j in range(0,12) {let start=num_mod(seed*7+j*3,20);array_push(bookings,booking(str(j),start,start+1+num_mod(j+seed,10),1+num_mod(j,4)));}
 let actual=C.analyze(resources,bookings,window).resources[0];let peak=0;let used=0;let over=0;let excess=0;
 for t in range(0,30) {let load=0;for b in bookings {if b.start_ms<=t and t<b.end_ms {load=load+b.units;}}peak=num_max(peak,load);used=used+load;if load>3 {over=over+1;excess=excess+load-3;}}
 assert(actual.peak_units==peak and actual.used_unit_ms==used and actual.overload_ms==over and actual.shortfall_unit_ms==excess,"weighted discrete oracle");
 let covered=0;let previous=0;
 for s in actual.segments {assert(s.start_ms==previous and s.end_ms>s.start_ms,"complete ordered partition");covered=covered+s.end_ms-s.start_ms;previous=s.end_ms;}
 assert(covered==30,"full window covered exactly once");
}
for rs in [nil,[],[map{id:"r",capacity:0}],[map{id:"r",capacity:1.5}],[map{id:"r",capacity:true}],[map{id:"r",capacity:1,extra:0}],[map{id:"",capacity:1}],[map{id:"r",capacity:1},map{id:"r",capacity:2}]] {assert(rejected(rs,[],window),"bad resources");}
for bs in [nil,[map{}],[booking("x",0,1,0)],[booking("x",0,1,1.5)],[booking("x",0,1,1,"unknown")],[booking("x",0,0)],[booking("x",-1,1)],[booking("x",0,31)],[booking("x",0,1),booking("x",1,2)]] {assert(rejected(resources,bs,window),"bad bookings");}
assert(rejected(resources,[],map{start_ms:0,end_ms:0}),"zero window");
let max_resources=[];for j in range(0,32) {array_push(max_resources,map{id:str(j),capacity:C.MAX_UNITS});}
let max_bookings=[];for j in range(0,128) {array_push(max_bookings,booking(str(j),0,I.MAX_TIME_MS,C.MAX_UNITS,"0"));}
let maximum=C.analyze(max_resources,max_bookings,map{start_ms:0,end_ms:I.MAX_TIME_MS});
assert(maximum.resources[0].used_unit_ms==128*C.MAX_UNITS*I.MAX_TIME_MS and maximum.resources[0].shortfall_unit_ms==127*C.MAX_UNITS*I.MAX_TIME_MS,"bounded exact integral");
array_push(max_bookings,booking("overflow",0,1,1,"0"));assert(rejected(max_resources,max_bookings,window),"booking count bound");
array_push(max_resources,map{id:"overflow",capacity:1});assert(rejected(max_resources,[],window),"resource count bound");
print "resource_capacity_pass";
