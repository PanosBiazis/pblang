// tests/semantics/pbai_enrich_test.sapp — enrichment for stdlib/pbai.sapp
// Adds intents() (label set) and confidence() (top classification score).

let pbai = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }
fn contains(arr, v) { let i = 0; while i < len(arr) { if arr[i] == v { return true; } i = i + 1; } return false; }

// ── base classify_scores still works ─────────────────────────────────────────────
let cs = pbai.classify_scores("please analyze this code");
if type(cs.intent) != "string" { fail("classify_scores returns an intent string"); }

// ── ENRICH: intents() lists the label set, and classify picks from it ────────────
let ins = pbai.intents();
if len(ins) < 1 { fail("intents() should be non-empty"); }
if not contains(ins, cs.intent) { fail("classified intent must be in intents()"); }

// ── ENRICH: confidence() returns the top score ───────────────────────────────────
let c = pbai.confidence("hello there");
if c <= 0 { fail("confidence should be positive, got " + str(c)); }

print "pbai_enrich_pass";
