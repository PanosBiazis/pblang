// tests/semantics/merkle_test.sapp — Merkle tree in stdlib/merkle.sapp.
//
// SCHEME UNDER TEST (see stdlib/merkle.sapp header for the full rationale):
//   - Domain separation (RFC-6962 style): leaf_hash(d) = sha256("L:" + d),
//     node_hash(l, r) = sha256("N:" + l + r). The disjoint "L:"/"N:" prefixes
//     defend against second-preimage attacks.
//   - Odd node counts: the lone final node is DUPLICATED (Bitcoin convention),
//     applied consistently in build/prove/verify.
//   - Empty tree: canonical root is sha256("L:").
//
// These assertions test determinism, the single-leaf identity, full-index proof
// verification, tamper rejection (leaf / index / sibling), odd counts (3 and 5),
// and the documented empty-tree root — asserting self-consistency of the scheme.

let merkle = import("stdlib:merkle.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── Determinism: same items → same root ──────────────────────────────────────────
let items = ["a", "b", "c", "d"];
let t1 = merkle.build(items);
let t2 = merkle.build(["a", "b", "c", "d"]);
eq(merkle.root(t1), merkle.root(t2), "root is deterministic for a fixed item set");
eq(len(merkle.root(t1)), 64, "root is a 64-char sha256 hex digest");
// Order matters: a different ordering yields a different root.
let t_perm = merkle.build(["b", "a", "c", "d"]);
if merkle.root(t_perm) == merkle.root(t1) { fail("root must depend on leaf order"); }

// Known internal structure for 4 leaves (validates the folding + prefixes).
let la = merkle.leaf_hash("a");
let lb = merkle.leaf_hash("b");
let lc = merkle.leaf_hash("c");
let ld = merkle.leaf_hash("d");
let expect4 = merkle.node_hash(merkle.node_hash(la, lb), merkle.node_hash(lc, ld));
eq(merkle.root(t1), expect4, "4-leaf root == N(N(a,b), N(c,d))");
// Leaf and node domains never collide.
if merkle.leaf_hash("x") == merkle.node_hash("x", "x") { fail("leaf/node domains must be disjoint"); }

// ── Single-leaf tree: root == leaf_hash(item) ────────────────────────────────────
let single = merkle.build(["solo"]);
eq(merkle.root(single), merkle.leaf_hash("solo"), "single-leaf root == leaf_hash(item)");
// Its (empty) proof still verifies.
let sp = merkle.prove(single, 0);
eq(len(sp), 0, "single-leaf proof has no sibling steps");
eq(merkle.verify(merkle.root(single), "solo", 0, sp), true, "single-leaf proof verifies");

// ── verify() accepts a valid proof for EVERY index of a multi-item tree ──────────
let items4 = ["alpha", "beta", "gamma", "delta"];
let tree4 = merkle.build(items4);
let idx = 0;
while idx < len(items4) {
    let pr = merkle.prove(tree4, idx);
    eq(merkle.verify(merkle.root(tree4), items4[idx], idx, pr), true,
       "valid proof verifies for index " + str(idx));
    idx = idx + 1;
}

// ── verify() REJECTS tampering ───────────────────────────────────────────────────
let good_proof = merkle.prove(tree4, 1);   // proof for "beta" at index 1
// (a) tampered leaf data
eq(merkle.verify(merkle.root(tree4), "BETA-tampered", 1, good_proof), false,
   "reject a tampered leaf");
// (b) wrong index: a proof for index 1 must not verify "gamma" (index 2).
eq(merkle.verify(merkle.root(tree4), items4[2], 2, good_proof), false,
   "reject a proof used with the wrong leaf/index");
// (c) altered sibling hash inside the proof
let altered = [];
let ai = 0;
while ai < len(good_proof) {
    let step = good_proof[ai];
    if ai == 0 {
        array_push(altered, map{ hash: merkle.leaf_hash("not-the-sibling"), side: step["side"] });
    } else {
        array_push(altered, step);
    }
    ai = ai + 1;
}
eq(merkle.verify(merkle.root(tree4), items4[1], 1, altered), false,
   "reject a proof with an altered sibling");
// A flipped sibling side also breaks the fold.
let flipped = [];
let fi = 0;
while fi < len(good_proof) {
    let step = good_proof[fi];
    let ns = "left";
    if step["side"] == "left" { ns = "right"; }
    array_push(flipped, map{ hash: step["hash"], side: ns });
    fi = fi + 1;
}
eq(merkle.verify(merkle.root(tree4), items4[1], 1, flipped), false,
   "reject a proof with a flipped sibling side");

// ── Odd node counts: 3 and 5 items (lone node duplicated) ────────────────────────
let odd3 = merkle.build(["one", "two", "three"]);
let j3 = 0;
while j3 < 3 {
    let p3 = merkle.prove(odd3, j3);
    let d3 = ["one", "two", "three"];
    eq(merkle.verify(merkle.root(odd3), d3[j3], j3, p3), true,
       "3-item odd tree: index " + str(j3) + " verifies");
    j3 = j3 + 1;
}
// Explicit duplication check for 3 leaves: level1 = [N(a,b), N(c,c)], root = N(l1[0], l1[1]).
let o1 = merkle.leaf_hash("one");
let o2 = merkle.leaf_hash("two");
let o3 = merkle.leaf_hash("three");
let expect3 = merkle.node_hash(merkle.node_hash(o1, o2), merkle.node_hash(o3, o3));
eq(merkle.root(odd3), expect3, "3-leaf root uses lone-node duplication N(c,c)");

let odd5 = merkle.build(["v0", "v1", "v2", "v3", "v4"]);
let d5 = ["v0", "v1", "v2", "v3", "v4"];
let j5 = 0;
while j5 < 5 {
    let p5 = merkle.prove(odd5, j5);
    eq(merkle.verify(merkle.root(odd5), d5[j5], j5, p5), true,
       "5-item odd tree: index " + str(j5) + " verifies");
    j5 = j5 + 1;
}
// A tampered leaf in the odd tree still fails.
let p5b = merkle.prove(odd5, 4);
eq(merkle.verify(merkle.root(odd5), "v4-tampered", 4, p5b), false,
   "5-item tree rejects a tampered lone leaf");

// ── Empty tree: canonical documented root ────────────────────────────────────────
let empty = merkle.build([]);
eq(merkle.root(empty), merkle.empty_root(), "empty tree root == canonical empty_root()");
eq(merkle.root(empty), sha256("L:"), "empty_root() == sha256(\"L:\")");

print "merkle_pass";
