let D = import("stdlib:input_daemon.sapp");
let E = import("stdlib:input_events.sapp");
let Strings = import("stdlib:strings.sapp");

fn fail(m) { throw "FAIL input_daemon: " + m; }

let token = "0123456789abcdef0123456789abcdef";
let state = D.new_state(token, map{ max_requests: 2, max_frame_chars: 1024 });
let calls = 0;
fn actuator(event) { calls = calls + 1; return map{ ok: true, kind: event.kind }; }

let first = D.make_request(token, 7, E.key_event("Enter").event);
let verified = D.verify_request(state, first);
if not verified.ok or verified.seq != 7 or verified.event.kind != "key" { fail("valid request verification"); }
let accepted = D.handle_frame(state, first, actuator);
if not accepted.ok or calls != 1 or state.last_seq != 7 { fail("authenticated actuation"); }

let replay = D.handle_frame(state, first, actuator);
if replay.ok or calls != 1 or not str_contains(replay.error, "replayed") { fail("replay rejection"); }

let tampered = Strings.replace_first(D.make_request(token, 8, E.click_event(1).event), "\"button\":1", "\"button\":2");
let bad = D.handle_frame(state, tampered, actuator);
if bad.ok or calls != 1 or not str_contains(bad.error, "authentication") { fail("tamper rejection"); }

let second = D.make_request(token, 9, E.type_event("safe text").event);
if not D.handle_frame(state, second, actuator).ok or calls != 2 { fail("second accepted request"); }
let quota = D.handle_frame(state, D.make_request(token, 10, E.key_event("Tab").event), actuator);
if quota.ok or calls != 2 or not str_contains(quota.error, "quota") { fail("request quota"); }

let s = D.status(state);
if s.requests != 2 or s.rejected != 2 or s.remaining != 0 or not s.loopback_only or not s.replay_protected { fail("status counters"); }

let weak = try D.new_state("short") catch nil;
if weak != nil { fail("weak token accepted"); }

print "input_daemon_pass";
