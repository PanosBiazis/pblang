let N=import("stdlib:nfc_text.sapp");
fn check(v){if not v{throw "NDEF text regression";}}
let bytes=N.encode("Hi","en");check(json_stringify(bytes)==json_stringify([209,1,5,84,2,101,110,72,105]));
check(N.inspect(bytes).text_bytes==2 and not map_has(N.inspect(bytes),"text"));
check(N.inspect(bytes,true).text=="Hi");
let unicode="Δοκιμή NFC";check(N.inspect(N.encode(unicode,"el"),true).text==unicode);
let long=N.encode(str_repeat("x",300));check(long[0]==193 and N.inspect(long,true).text_bytes==300);
check(N.inspect(N.encode("","en"),true).text=="");
for bad in [[],[209,1,9,84,2,101,110], [241,1,3,84,2,101,110], [209,1,3,85,2,101,110],
    [209,1,3,84,130,101,110], [209,1,4,84,2,101,110,255], [209,1,3,84,2,101,110,0],
    [193,1,255,255,255,255,84,2,101,110], [209,1,3,84,2,101,256]] {
    check((try N.inspect(bad,true) catch nil)==nil);
}
check((try N.encode(str_repeat("x",4001)) catch nil)==nil);
check((try N.encode("x","-en") catch nil)==nil);
check((try N.inspect(bytes,1) catch nil)==nil);
print "NDEF text tests passed";
