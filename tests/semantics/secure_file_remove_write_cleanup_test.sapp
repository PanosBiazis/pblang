// Counted resource-free backend; tests write_atomic, write_text_atomic,
// remove, and remove_file parent ownership, single close, exception redaction,
// reply validation, and admission boundaries.
fn _assert_write(result, B, is_bytes, write_mode, close_mode) {
    assert(type(is_bytes) == "bool" and B.state.opens == 1
        and B.state.atomic_writes == 1 and B.state.closes == 1,
        "acquired parent receives exactly one atomic write and one close attempt");
    assert(B.state.bytes == [206, 177] and not B.state.create,
        "exact payload and create option passed to backend");
    if is_map(B.state.result) and map_has(B.state.result, "ok") and type(B.state.result.ok) == "bool" {
        assert(B.state.result.ok == (write_mode == "success"), "backend map ok not mutated");
        assert(not map_has(B.state.result, "cleanup_uncertain"), "backend map not mutated");
    }
    if close_mode != "success" {
        assert(not result.ok and result.cleanup_uncertain and not result.parent_close_confirmed,
            "unconfirmed parent close rejects atomic write");
        if write_mode == "success" {
            assert(result.write_backend_succeeded and result.publication_may_have_occurred,
                "successful backend write noted under cleanup uncertainty");
            assert(result.error == "secure atomic-write parent cleanup could not be verified",
                "fixed atomic-write cleanup diagnostic");
            assert(result.size == 2 and result.atomic and result.extra == map{ value: 7 },
                "original write metadata retained");
        } elif write_mode == "failure" {
            assert(result.error == "synthetic atomic failure" and result.marker == 19
                and not map_has(result, "write_backend_succeeded"),
                "primary backend error retained without invented completion");
        } elif write_mode == "object_error" {
            assert(result.error == map{ kind: "synthetic-atomic", code: 9 }
                and not map_has(result, "write_backend_succeeded"),
                "structured error value retained without stringification");
        } elif write_mode == "throw" {
            assert(result.error == "secure atomic write backend failed"
                and not map_has(result, "write_backend_succeeded"),
                "redacted backend exception diagnostic retained");
        } else {
            assert(result.error == "secure atomic write result is invalid"
                and not map_has(result, "write_backend_succeeded"),
                "invalid reply diagnostic retained");
        }
    } elif write_mode == "success" {
        assert(result == B.state.result and result.ok, "confirmed close preserves atomic write result");
    } elif write_mode == "failure" {
        assert(result == B.state.result and not result.ok
            and result.error == "synthetic atomic failure",
            "confirmed close preserves backend failure");
    } elif write_mode == "object_error" {
        assert(not result.ok and result.error == map{ kind: "synthetic-atomic", code: 9 },
            "confirmed close preserves object error");
    } elif write_mode == "throw" {
        assert(not result.ok and result.error == "secure atomic write backend failed",
            "confirmed close returns redacted exception error");
    } else {
        assert(not result.ok and result.error == "secure atomic write result is invalid",
            "confirmed close rejects malformed backend reply");
    }
    assert(not str_contains(json_stringify(result), "synthetic-private-value"),
        "thrown value never escapes atomic write");
}

fn _assert_remove(result, B, api, remove_mode, close_mode) {
    let file_only = api == "remove_file";
    assert(B.state.opens == 1 and B.state.removes == 1 and B.state.closes == 1
        and B.state.file_only == file_only,
        "acquired parent receives exactly one remove and one close attempt");
    if is_map(B.state.result) {
        assert(not map_has(B.state.result, "namespace_absent")
            and not map_has(B.state.result, "cleanup_uncertain"),
            "backend remove map is never mutated in place");
    }
    let invalid_msg = if file_only { "secure file remove result is invalid" }
        else { "secure remove result is invalid" };
    let throw_msg = if file_only { "secure file remove backend failed" }
        else { "secure remove backend failed" };
    let close_msg = if file_only { "secure file remove parent cleanup could not be verified" }
        else { "secure remove parent cleanup could not be verified" };

    if close_mode != "success" {
        assert(not result.ok and result.cleanup_uncertain and not result.parent_close_confirmed,
            "unconfirmed parent close rejects remove");
        assert(not map_has(result, "namespace_absent") and not map_has(result, "absence_evidence"),
            "unconfirmed parent close never claims namespace_absent");
        if remove_mode == "success" {
            assert(result.remove_backend_succeeded and result.removal_may_have_occurred
                and result.error == close_msg and result.path == "value",
                "successful backend remove noted under cleanup uncertainty");
        } elif remove_mode == "failure" {
            assert(result.error == "synthetic remove failure" and result.marker == 23
                and not map_has(result, "remove_backend_succeeded"),
                "primary remove error retained without invented completion");
        } elif remove_mode == "object_error" {
            assert(result.error == map{ kind: "synthetic-remove", code: 11 }
                and not map_has(result, "remove_backend_succeeded"),
                "structured remove error retained");
        } elif remove_mode == "throw" {
            assert(result.error == throw_msg and not map_has(result, "remove_backend_succeeded"),
                "redacted remove exception retained");
        } else {
            assert(result.error == invalid_msg and not map_has(result, "remove_backend_succeeded"),
                "invalid remove reply diagnostic retained");
        }
    } elif remove_mode == "success" {
        assert(result.ok and result.path == "value", "confirmed close preserves remove success");
        if file_only {
            assert(result.namespace_absent
                and result.absence_evidence == "descriptor-held file-only unlink"
                and not result.directory_removal and result.descriptor_bound_parent
                and not result.symlink_target_followed,
                "remove_file attaches absence evidence only after confirmed parent close");
        } else {
            assert(result == B.state.result and not map_has(result, "namespace_absent"),
                "general remove returns backend result unchanged");
        }
    } elif remove_mode == "failure" {
        assert(result == B.state.result and not result.ok
            and result.error == "synthetic remove failure"
            and not map_has(result, "namespace_absent"),
            "confirmed close preserves remove failure");
    } elif remove_mode == "object_error" {
        assert(not result.ok and result.error == map{ kind: "synthetic-remove", code: 11 }
            and not map_has(result, "namespace_absent"),
            "confirmed close preserves structured remove error");
    } elif remove_mode == "throw" {
        assert(not result.ok and result.error == throw_msg
            and not map_has(result, "namespace_absent"),
            "confirmed close returns redacted remove exception error");
    } else {
        assert(not result.ok and result.error == invalid_msg
            and not map_has(result, "namespace_absent"),
            "confirmed close rejects malformed remove reply");
    }
    assert(not str_contains(json_stringify(result), "synthetic-private-value"),
        "thrown value never escapes remove");
}

fn run(S, B) {
    let cases = 0;
    let modes = ["success", "failure", "object_error", "throw", "nil", "bad_ok"];
    let closes = ["success", "false", "nil", "number", "map", "throw"];

    for is_bytes in [true, false] {
        for write_mode in modes {
            for close_mode in closes {
                B.configure(write_mode, close_mode);
                let res = nil;
                if is_bytes {
                    res = S.write_atomic("owned/value", [206, 177], false, false);
                } else {
                    res = S.write_text_atomic("owned/value", "α", false, false);
                }
                _assert_write(res, B, is_bytes, write_mode, close_mode);
                cases = cases + 1;
            }
        }
    }

    for api in ["remove", "remove_file"] {
        for remove_mode in modes {
            for close_mode in closes {
                B.configure(remove_mode, close_mode);
                let res = if api == "remove" {
                    S.remove("owned/value", false)
                } else {
                    S.remove_file("owned/value", false)
                };
                _assert_remove(res, B, api, remove_mode, close_mode);
                cases = cases + 1;
            }
        }
    }

    B.configure("success", "success");
    assert(not S.write_atomic("owned/value", "not-bytes", false).ok, "reject non-array bytes");
    assert(not S.write_text_atomic("owned/value", [1, 2], false).ok, "reject non-string text");
    assert(not S.write_atomic("", [1], false).ok, "reject empty write_atomic path");
    assert(not S.write_text_atomic("a" + strfromcharcode(0) + "b", "x", false).ok, "reject nul write path");
    assert(not S.remove("").ok, "reject empty remove path");
    assert(not S.remove("owned/dir/").ok, "reject trailing slash remove path");
    assert(not S.remove_file("").ok, "reject empty remove_file path");
    assert(not S.remove_file("a" + strfromcharcode(0) + "b").ok, "reject nul remove_file path");
    assert(B.state.opens == 0 and B.state.atomic_writes == 0
        and B.state.removes == 0 and B.state.closes == 0,
        "argument rejection acquires nothing");

    for denied_op in ["write_atomic", "write_text_atomic", "remove", "remove_file"] {
        B.configure("success", "success");
        B.state.admit = false;
        let denied = nil;
        if denied_op == "write_atomic" {
            denied = S.write_atomic("owned/value", [1], false, false);
        } elif denied_op == "write_text_atomic" {
            denied = S.write_text_atomic("owned/value", "a", false, false);
        } elif denied_op == "remove" {
            denied = S.remove("owned/value", false);
        } else {
            denied = S.remove_file("owned/value", false);
        }
        assert(not denied.ok, "parent admission failure rejected");
        assert(B.state.opens == 1 and B.state.atomic_writes == 0
            and B.state.removes == 0 and B.state.closes == 0,
            "unacquired parent never written, removed, or closed");
    }

    return map{ ok: true, matrix_cases: cases, admission_cases: 12 };
}

export run;
