// Run against a complete facade and counted resource-free backend substitution.
fn run(S, B) {
    let cases = 0;
    for read_mode in ["success", "failure", "throw"] {
        for close_mode in ["success", "false", "nil", "number", "map", "throw"] {
            B.configure(read_mode, close_mode);
            let result = S.read_text_prefix("owned/input", 8);
            assert(B.state.opens == 1 and B.state.reads == 1 and B.state.closes == 1,
                "acquired parent receives exactly one prefix read and close attempt");
            if close_mode != "success" {
                assert(not result.ok and result.cleanup_uncertain
                    and not result.parent_close_confirmed, "ambiguous cleanup rejects prefix");
                assert(not map_has(result, "bytes") and not map_has(result, "text")
                    and len(map_keys(result)) == 4, "no payload on cleanup failure");
                assert(result.error == "secure prefix parent cleanup could not be verified",
                    "fixed cleanup diagnostic");
            } elif read_mode == "success" {
                assert(result.ok and result.text == "α" and result.source_size == 2
                    and result.size == 2 and result.returned_bytes == 2 and not result.truncated
                    and result.utf8_boundary_trimmed_bytes == 0 and result.race_resistant,
                    "normal prefix result preserved");
            } elif read_mode == "failure" {
                assert(not result.ok and result.error == "synthetic failure"
                    and result.marker == 7, "backend error map retained after confirmed close");
            } else {
                assert(not result.ok and result.error == "secure prefix backend failed"
                    and len(map_keys(result)) == 2, "backend exception redacted after cleanup");
            }
            assert(not str_contains(json_stringify(result), "synthetic-private-value"),
                "exception text does not escape");
            cases = cases + 1;
        }
    }
    B.configure("success", "success");
    for invalid in [-1, 1.5, "8", nil] {
        if S.read_text_prefix("owned/input", invalid).ok { throw "invalid limit accepted"; }
    }
    assert(not S.read_text_prefix("", 8).ok, "empty path rejected");
    assert(B.state.opens == 0 and B.state.reads == 0 and B.state.closes == 0,
        "invalid arguments acquire nothing");
    B.state.admit = false;
    assert(not S.read_text_prefix("owned/input", 8).ok, "parent rejection");
    assert(B.state.opens == 1 and B.state.reads == 0 and B.state.closes == 0,
        "unacquired parent never closed");
    return map{ok:true,matrix_cases:cases,admission_cases:6};
}
export run;
