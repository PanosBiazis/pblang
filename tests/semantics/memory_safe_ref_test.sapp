let M = import("stdlib:memory.sapp");
fn require(ok, reason) { if not ok { throw "FAIL memory_safe_ref: " + reason; } }
let before = M.stats();
let tracker = M.MemoryTracker();
let h = tracker.alloc(tracker, 11);
let other = tracker.alloc(tracker, 77);
let guard = M.SafeRef();
guard.release(guard);
guard.release(guard);
require((try guard.get(guard, tracker) catch "inactive") == "inactive", "fresh guard cannot read");
guard.acquire(guard, tracker, h, 0);
require(guard.get(guard, tracker) == 11, "active guard reads correct owner");
let original = guard.borrow_id;
require((try guard.acquire(guard, tracker, other, 0) catch "active") == "active", "reacquire rejects");
require(guard.borrow_id == original and M.stats().active_borrows == before.active_borrows + 1, "reacquire preserves borrow");
require((try guard.set(guard, tracker, other) catch "immutable") == "immutable", "immutable guard rejects write");
require(M.read(other) == 77, "another owner unchanged");
guard.release(guard);
guard.release(guard);
require((try guard.get(guard, tracker) catch "inactive") == "inactive", "released guard cannot read");
require((try guard.set(guard, tracker, other) catch "inactive") == "inactive", "released guard cannot write");
guard.acquire(guard, tracker, h, 1);
require((try guard.set(guard, tracker, other) catch "unsupported") == "unsupported", "write-through-borrow stays unsupported");
require(M.read(h) == 11 and M.read(other) == 77, "mutable guard cannot corrupt either owner");
guard.release(guard);
require((try guard.acquire(guard, tracker, -1, 0) catch "invalid") == "invalid", "failed acquisition remains inactive");
require(guard.released == 1, "failed acquisition preserves released state");
tracker.free(tracker, h); tracker.free(tracker, other);
require(M.stats().total_locations == before.total_locations and M.stats().active_borrows == before.active_borrows, "all resources restored");
print "memory_safe_ref_pass";
