// tests/semantics/visual_engine_enrich2_test.sapp — wave 2 for stdlib/visual_engine.sapp
// timeline_duration, key_count, node_props_at (all-props interpolation at t).

let V = import("stdlib/visual_engine.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let sc = V.scene(800, 600);
V.add_key(sc, "n1", 0, map{ x: 0, opacity: 1 });
V.add_key(sc, "n1", 10, map{ x: 100, opacity: 0 });
V.add_key(sc, "n2", 4, map{ x: 5 });

eq(V.key_count(sc), 3, "3 keys total");
eq(V.timeline_duration(sc), 10, "duration = latest key t");

// node_props_at interpolates every animated prop of the node at t
let p = V.node_props_at(sc, "n1", 5);
eq(p.x, 50, "x midpoint");
eq(p.opacity, 0.5, "opacity midpoint");

// at/after the end, props hold their last keyframe
let pe = V.node_props_at(sc, "n1", 99);
eq(pe.x, 100, "x clamped to last");

// a node with no keys -> empty map
let none = V.node_props_at(sc, "ghost", 1);
eq(len(map_keys(none)), 0, "no keys -> empty");

print "visual_engine_enrich2_pass";
