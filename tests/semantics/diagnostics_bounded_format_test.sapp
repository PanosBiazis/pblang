let D=import("stdlib:diagnostics.sapp");let checks=0;
fn exceptional(divisor){return [0.0/divisor,1.0/divisor];}
let edge=exceptional(0);
fn ok(v){assert(v,"bounded formatter regression");checks=checks+1;}
fn repeat(s,n){let out="";for _i n {out=out+s;}return out;}
fn result(ds){return map{diagnostics:ds,counts:map{error:len(ds),warning:0,hint:0}};}
fn entry(msg){return map{severity:"error",code:"synthetic",message:msg,line:2,help:nil};}
fn verify(r,limit){ok(type(r.text)=="string" and len(str_to_bytes(r.text))==r.bytes and r.bytes<=limit);}
for source in ["let x=1; print x;","print absent;","let unused=3;","let x:number=\"bad\";"] {
 let r=D.diagnose_checked(source);let out=D.format_bounded(r);verify(out,16384);ok(out.text==D.format(r) and not out.truncated);
}
let empty=result([]);ok(D.format_bounded(empty).text==D.format(empty));
ok(edge[0]!=edge[0] and edge[1]>9007199254740991);
for n in [0,1,3,4,1023,1024,16384] {
 let r=D.format_text_bounded([repeat("x",1025)],n);verify(r,n);ok(r.bytes==if n<1024 {n}else{1024});ok(r.truncated);
}
for text in ["a","α","é","😀","α😀x"] {
 let bytes=len(str_to_bytes(text));
 for n in [0,1,2,3,4,5,6,7,8] {
  let r=D.format_text_bounded([text],n);verify(r,n);ok(r.truncated==(bytes>n));
  ok(bytes_to_str(str_to_bytes(r.text))==r.text);
 }
}
for n in [0,1,1023,1024] {let s=repeat("x",n);let r=D.format_text_bounded([s],n);verify(r,n);ok(r.text==s and not r.truncated);}
let fields=[];for _i 16 {push(fields,repeat("x",1024));}
let exact=D.format_text_bounded(fields,16384);verify(exact,16384);ok(exact.bytes==16384 and not exact.truncated);
push(fields,"x");ok(D.format_text_bounded(fields,16384).truncated);
let ds=[];for _i 128 {push(ds,entry("x"));}
let full=D.format_bounded(result(ds));ok(not full.truncated and full.text==D.format(result(ds)));
push(ds,entry("last"));let partial=D.format_bounded(result(ds));ok(partial.truncated and not str_contains(partial.text,"last"));
let long=D.format_bounded(result([entry(repeat("α",513))]));verify(long,16384);ok(long.truncated);
for invalid in [-1,0.5,16385,nil,"1024",edge[0],edge[1]] {
 ok((try D.format_text_bounded(["x"],invalid) catch "rejected")=="rejected");
}
for invalid in [nil,"text",[map{private:"NEVER_RENDER"}],[7]] {ok((try D.format_text_bounded(invalid) catch "rejected")=="rejected");}
let too_many=[];for _i 33 {push(too_many,"");}ok((try D.format_text_bounded(too_many) catch "rejected")=="rejected");
for invalid in [nil,[],map{diagnostics:[],counts:nil},map{diagnostics:"x",counts:map{error:0,warning:0,hint:0}}] {ok((try D.format_bounded(invalid) catch "rejected")=="rejected");}
for value in [nil,-1,0.5,"1",map{private:"NEVER_RENDER"},9007199254740992,edge[0],edge[1]] {
 let r=result([]);r.counts.error=value;ok((try D.format_bounded(r) catch "rejected")=="rejected");
 let d=entry("x");d.line=value;
 if value!=nil {ok((try D.format_bounded(result([d])) catch "rejected")=="rejected");}
}
for key in ["severity","code","message","help"] {let d=entry("x");d[key]=map{private:"NEVER_RENDER"};ok((try D.format_bounded(result([d])) catch "rejected")=="rejected");}
let absent=map{severity:"hint",code:"ok",message:"small"};ok(not D.format_bounded(result([absent])).truncated);
// Unvisited tail is deliberately not schema validation; it must not be rendered.
let tail=[];for _i 128 {push(tail,entry("x"));}push(tail,map{private:"NEVER_RENDER"});ok(D.format_bounded(result(tail)).truncated);
let nul=D.format_text_bounded([strfromcharcode(0)],1);ok(nul.bytes==1 and not nul.truncated);
let subsequence=D.format_text_bounded(["α","x"],1);ok(subsequence.text=="x" and subsequence.truncated);
let maximum=D.format_text_bounded(["checked ",str(9007199254740991)," file(s): ",str(9007199254740991)," error(s), ",str(9007199254740991)," warning(s)"],255);
ok(not maximum.truncated and maximum.bytes+1+len("[diagnostic output truncated; final counts remain complete]")+1<512);
let hostile=entry("x");hostile.message=map{secret:"NEVER_RENDER"};
ok((try D.format_bounded(result([hostile])) catch "rejected")=="rejected");
print "diagnostics_bounded_format_pass: "+str(checks);
