let AI=import("stdlib/pbai.sapp");
fn rejects(f) {return try {f();false} catch true;}
assert(not rejects(fn(){return 1;}) and rejects(fn(){throw "expected";}),"calibrated helper");
let teacher=AI.neural_specialist_train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
for supervised in [false,true] {
 let student=if supervised {
  AI.neural_specialist_distill_supervised(teacher.artifact,[map{x:[0],y:5},map{x:[1,0],y:5}],
   [map{x:[7,0],y:5}],map{epochs:64,lr:0.1,temperature:2,hard_weight:1,max_grad_norm:1})
 } else {AI.neural_specialist_distill(teacher.artifact,[[0],[1,0]],[map{x:[7,0],y:4}])};
 let saved_report=json_stringify(student.report);let checkpoint=student.checkpoint();
 assert(len(checkpoint)==7 and not map_has(checkpoint,"training") and not map_has(checkpoint,"validation"),"fixed checkpoint excludes input datasets");
 let encoded=AI.neural_specialist_student_encode(checkpoint);
 assert(len(str_to_bytes(encoded))<4096,"bounded transport");
 let decoded=AI.neural_specialist_student_decode(" \n"+encoded+"\n ");
 let loaded=AI.neural_specialist_student_load(decoded);
 assert(encoded==AI.neural_specialist_student_encode(loaded.checkpoint()),"checkpoint is idempotent after decoding and loading");
 assert(json_stringify(student.report)==saved_report,"export never changes training report or weights");
 for context in [[0],[1,0],[7,0],[6,0]] {
  let before=student.predict(context);let after=loaded.predict(context);
  assert(before.token==after.token,"fixture predictions survive fixed-point export");
  for i len(before.logits) {let d=before.logits[i]-after.logits[i];assert(d*d<0.00000001,"bounded fixture quantization drift");}
 }
 let evaluation=loaded.evaluate([map{x:[0],y:if supervised {5} else {4}}]);
 assert(not evaluation.exact_student_input_disjointness_checked and not loaded.report.artifact_authenticated,"loaded handle cannot claim training holdout or authentication");
 assert(not map_has(loaded,"promote") and not map_has(loaded,"train"),"loaded handle is diagnostic only");
 let before=json_stringify(loaded.predict([6,0]));
 checkpoint.a[0][0]=0;decoded.b[0][0]=0;loaded.report.artifact_digest="changed";
 let prediction=loaded.predict([6,0]);prediction.logits[0]=999;
 let exported=loaded.checkpoint();exported.a[0][0]=999;
 assert(before==json_stringify(loaded.predict([6,0])),"caller mutations cannot alter private loaded weights");
 assert(rejects(fn(){AI.neural_specialist_student_load(checkpoint);}),"weight tampering invalidates digest");
 let good=AI.neural_specialist_student_decode(encoded);
 for key in ["format","profile","base_digest","digest","steps","a","b"] {
  let bad=AI.neural_specialist_student_decode(encoded);bad[key]=nil;
  assert(rejects(fn(){AI.neural_specialist_student_load(bad);}),"required shape fields validated");
 }
 for bad in [nil,[],map{},teacher.artifact] {assert(rejects(fn(){AI.neural_specialist_student_load(bad);}),"malformed or rank-2 artifact rejected");}
 let cycle=[];push(cycle,cycle);good.a=cycle;
 assert(rejects(fn(){AI.neural_specialist_student_encode(good);}),"cyclic tensors rejected before serialization");
 let prefix=str_slice(encoded,0,len(encoded)-1);
 for bad in ["",nil,1,"[]","{",encoded+"x",prefix+",\"steps\":128}",prefix+",\"\\u0073teps\":128}",
  str_repeat("[",100)+"0"+str_repeat("]",100),str_repeat(" ",4097),str_repeat("é",3000)] {
  assert(rejects(fn(){AI.neural_specialist_student_decode(bad);}),"bounded strict JSON including decoded duplicate keys");
 }
 let zero=len([]);
 for bad_step in [-1,4097,0.5,0/zero,1/zero,true] {
  let bad=AI.neural_specialist_student_decode(encoded);bad.steps=bad_step;
  assert(rejects(fn(){AI.neural_specialist_student_load(bad);}),"step counter bounds");
 }
 for value in [10000000001,-10000000001,0.25,0/zero,1/zero,true] {
  let bad=AI.neural_specialist_student_decode(encoded);bad.a[0][0]=value;
  assert(rejects(fn(){AI.neural_specialist_student_encode(bad);}),"integer factor bounds");
 }
 let forged=AI.neural_specialist_student_decode(encoded);forged.a[0][0]=forged.a[0][0]+1;
 forged.digest=sha256(json_stringify([forged.format,forged.profile,forged.base_digest,forged.a,forged.b,forged.steps]));
 assert(not AI.neural_specialist_student_load(forged).report.artifact_authenticated,"recomputed hash is not authentication");
 // A self-consistent checkpoint digest must not admit a different base model.
 let foreign=AI.neural_specialist_student_decode(encoded);foreign.base_digest=str_repeat("0",64);
 foreign.digest=sha256(json_stringify([foreign.format,foreign.profile,foreign.base_digest,foreign.a,foreign.b,foreign.steps]));
 let foreign_text=json_stringify(foreign);
 assert(rejects(fn(){AI.neural_specialist_student_load(foreign);})
  and rejects(fn(){AI.neural_specialist_student_encode(foreign);})
  and rejects(fn(){AI.neural_specialist_student_decode(foreign_text);}),"all entries verify the fixed base independently of the checkpoint digest");
 assert(before==json_stringify(loaded.predict([6,0])),"failed base validation leaves the previous model usable");
 let wide=map{};for i 100 {wide[str(i)]=i;}
 assert(rejects(fn(){AI.neural_specialist_student_encode(wide);}),"wide objects rejected");
 assert(rejects(fn(){loaded.predict([8]);}) and rejects(fn(){loaded.evaluate([]);}),"loaded inference/evaluation contracts");
}
print "pbai_student_checkpoint_pass";
