let Firmware = import("stdlib:embedded_protocol_avr.sapp");
let P = import("stdlib:embedded_protocol.sapp");

fn command(sequence, opcode, value = 0, interval = 500, duration = 0) {
    return map{sequence:sequence, opcode:opcode, value:value,
        interval_ms:interval, duration_ms:duration};
}

let artifact = Firmware.compile();
assert(artifact.ok and artifact.persistent_command_loop and artifact.baud == 115200,
    "persistent UNO command artifact");
assert(artifact.bytes < 4096 and not artifact.c_fallback
    and not artifact.assembler_dependency and not artifact.compiler_dependency,
    "compact PBLang-native firmware has no source fallback");

let set_flow = Firmware.verify([
    command(40, P.OP_STATUS),
    command(41, P.OP_SET, 1),
    command(41, P.OP_SET, 0),
    command(43, P.OP_TOGGLE)
]);
assert(set_flow.ok and len(set_flow.responses) == 4, "UART command/response flow executes");
assert(set_flow.responses[0].status == P.STATUS_OK
    and set_flow.responses[1].status == P.STATUS_OK and set_flow.responses[1].on,
    "status handshake and ordered set");
assert(set_flow.responses[2].status == P.STATUS_DUPLICATE and set_flow.responses[2].on,
    "duplicate set cannot change output");
assert(set_flow.responses[3].status == P.STATUS_OUT_OF_ORDER and set_flow.responses[3].on,
    "out-of-order toggle cannot change output");

let blink_flow = Firmware.verify([
    command(1, P.OP_STATUS), command(2, P.OP_BLINK, 0, 10, 30)
]);
assert(blink_flow.ok and blink_flow.responses[1].blinking
    and blink_flow.responses[1].on and blink_flow.responses[1].interval_ms == 10,
    "bounded blink command reaches firmware state");

print "embedded_protocol_avr_pass";
