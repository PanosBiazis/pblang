let C=import("stdlib:sample_clock.sapp");
let input=[4294967280,4,24,44];let before=json_stringify(input);let t=C.timeline(input,32,100);
assert(t.elapsed_ticks==[0,20,40,60] and t.deltas==[20,20,20] and t.total_ticks==60 and t.inferred_wraps==1,"32-bit rollover");
assert(t.assumes_forward_clock and not t.physical_verified and not t.raw_counters_included and not map_has(t,"ticks"),"explicit evidence contract");
t.elapsed_ticks[0]=123;assert(json_stringify(input)==before,"output is detached");
assert(C.timeline([250,4,130,0,126],8,126).elapsed_ticks==[0,10,136,262,388],"multiple bounded wraps across sequence");
let p=C.period_review([250,4,15,24],8,30,10);assert(p.errors_ticks==[0,1,-1] and p.interval_count==3 and p.max_abs_error_ticks==1,"signed period errors");
assert(num_abs(p.mean_abs_error_ticks-2/3)<0.000000001 and num_abs(p.rms_error_ticks-num_sqrt(2/3))<0.000000001,"absolute and RMS timing error");
assert(not p.missing_samples_inferred and not p.clock_reset_verified and not p.physical_verified,"timing is not proof of capture or reset");
let empty=C.period_review([0],8,127,10);assert(empty.interval_count==0 and empty.mean_abs_error_ticks==nil and empty.rms_error_ticks==nil and empty.max_abs_error_ticks==nil,"one sample has no measured intervals");
assert(C.period_review([1,11,21],8,20,10).rms_error_ticks==0,"exact period");
for bad in [[],[1,1],[10,9],[0,128],[0,101],[nil],[1.5],[256],[-1]] {assert((try C.timeline(bad,8,100) catch nil)==nil,"duplicate/backward/ambiguous/invalid counters rejected");}
for bad in [nil,true,"PRIVATE_CLOCK_SENTINEL",map{},parse_number("NaN"),parse_number("inf"),parse_number("-inf")] {
 assert((try C.timeline(bad,8,100) catch nil)==nil,"array type");
 assert((try C.timeline([bad],8,100) catch nil)==nil,"strict numeric tick type");
 assert((try C.timeline([1],bad,100) catch nil)==nil,"strict width type");
 assert((try C.timeline([1],8,bad) catch nil)==nil,"strict bound type");
 assert((try C.period_review([1],8,100,bad) catch nil)==nil,"strict period type");
}
for bits in [7,33,8.5] {assert((try C.timeline([0],bits,1) catch nil)==nil,"width limits");}
for step in [0,128,129,1.5] {assert((try C.timeline([0],8,step) catch nil)==nil,"half-cycle bound");}
for expected in [0,101,1.5] {assert((try C.period_review([0],8,100,expected) catch nil)==nil,"expected period bounds");}
let ticks=[];let counter=0;for i in range(0,256) {array_push(ticks,counter);counter=(counter+2147483647)%4294967296;}
let maximum=C.timeline(ticks,32,2147483647);assert(maximum.total_ticks==547608329985 and len(maximum.elapsed_ticks)==256,"maximum exact cumulative tick count");
let extremes=C.period_review(ticks,32,2147483647,1);assert(num_abs(extremes.rms_error_ticks-2147483646)<0.00001,"large squared timing errors remain finite");
array_push(ticks,counter);assert((try C.timeline(ticks,32,2147483647) catch nil)==nil,"257 samples rejected");
assert((try C.timeline([4294967296],32,10) catch nil)==nil,"32-bit upper bound");
print "sample_clock_pass";
