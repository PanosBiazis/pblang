let T=import("stdlib:security_taint.sapp");
let TOK=import("stdlib:compiler/tokenizer.sapp");
let D=import("stdlib:security_dependency_analysis.sapp");
fn expect(ok,label) {if not ok {throw "FAIL taint-token-bounds: "+label;}}
let source="let x=1;";let count=len(TOK.tokenize(source));
expect(T.analyze(source,"fixture.sapp",map{max_taint_tokens:count}).passed,"exact token budget accepted");
expect(T.analyze("","fixture.sapp",map{max_taint_tokens:1}).passed,"EOF budget");
let rejected=T.analyze(source,"private-token-path",map{max_taint_tokens:count-1});
expect(not rejected.ok and not rejected.passed and not rejected.parser_complete
    and not rejected.interprocedural_complete and rejected.limit_exceeded,"incomplete token analysis rejects");
expect(not str_contains(json_stringify(rejected),"private-token-path"),"cap diagnostic omits path");
let lexical=T.analyze("let x=1; \"private-token-source","fixture.sapp",map{max_taint_tokens:count});
expect(lexical.error=="token limit exceeded" and not str_contains(json_stringify(lexical),"private-token-source"),
    "token budget before later lexical work");
expect(T.limits().max_taint_tokens==65536,"default token cap");
for value in [nil,true,"private-token-option",[],map{},0,1.5,1048577,
    parse_number("NaN"),parse_number("inf"),parse_number("-inf"),bigint(2),decimal("2"),rational("2/1")] {
    let invalid=T.analyze(source,"fixture.sapp",map{max_taint_tokens:value});
    expect(not invalid.ok and not invalid.passed,"invalid token policy");
    expect(not str_contains(json_stringify(invalid),"private-token-option"),"option privacy");
}
for mode in ["protect","strict","audit"] {
    let options=map{entry_source:source,security_mode:mode,max_taint_tokens:count};
    expect(D.analyze_entry("fixture.sapp",options).passed,"default nesting and exact module budget");
    options.security=map{max_taint_tokens:1};
    let short=D.analyze_entry("fixture.sapp",options);
    expect(not short.passed and not short.graph_complete and short.limit_exceeded
        and short.module_count==0 and not short.whole_program_linked,"imports stop before pattern/taint/linker");
    options.security=map{max_taint_tokens:nil};
    expect(D.analyze_entry("fixture.sapp",options).passed,"legacy nil fallback");
    options.security=map{max_taint_tokens:1.5};
    let invalid=D.analyze_entry("fixture.sapp",options);
    expect(not invalid.ok and not invalid.passed,"nested invalid policy before reads");
    let entry="tests/fixtures/taint_source_entry.sapp";
    let main="let D=import(\"./taint_source_child.sapp\"); let x=D.value();";
    let linked=D.analyze_entry(entry,map{entry_source:main,security_mode:mode,
        security:map{max_taint_tokens:25}});
    expect(linked.graph_complete and linked.module_count==2 and linked.whole_program_linked
        and not linked.whole_program_taint.ok and not linked.passed,
        "whole-program token cap remains explicit and is not widened");
}
print "security_taint_token_bounds_pass";
