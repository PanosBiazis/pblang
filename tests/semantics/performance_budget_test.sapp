let P = import("stdlib:performance_budget.sapp");

fn eq(a, b, message) { if a != b { throw "FAIL " + message + " got=" + str(a) + " want=" + str(b); } }
fn near(a, b, message) { if num_abs(a - b) > 0.0001 { throw "FAIL " + message + " got=" + str(a) + " want=" + str(b); } }

let faster = P.compare_metric(100, 80);
eq(faster.ok, true, "numeric comparison accepted");
near(faster.improvement_percent, 20, "lower latency improvement");
let more_throughput = P.compare_metric(100, 120, false);
near(more_throughput.improvement_percent, 20, "higher throughput improvement");
eq(P.compare_metric("bad", 1).status, "invalid-metric", "non-numeric metrics fail closed");

let baseline = map{ median_ms: 100, peak_rss_kb: 1000, artifact_bytes: 500, ops_per_second: 100 };
let candidate = map{ median_ms: 90, peak_rss_kb: 1050, artifact_bytes: 510, ops_per_second: 110 };
let budgets = [
    map{ metric: "median_ms", max_regression_percent: 0 },
    map{ metric: "peak_rss_kb", max_regression_percent: 5 },
    map{ metric: "artifact_bytes", max_regression_percent: 3 },
    map{ metric: "ops_per_second", max_regression_percent: 0, lower_is_better: false }
];
let accepted = P.evaluate(baseline, candidate, budgets);
eq(accepted.ok, true, "time/memory/storage/throughput budgets pass");
eq(len(accepted.checks), 4, "all budgets checked");
eq(P.assert_within(baseline, candidate, budgets).status, "ok", "assert returns accepted evidence");

let regressed = P.evaluate(baseline, map{ median_ms: 106 }, [map{ metric: "median_ms", max_regression_percent: 5 }]);
eq(regressed.ok, false, "regression over budget fails");
eq(regressed.checks[0].status, "regression", "regression reason retained");
eq(P.evaluate(baseline, map{}, [map{ metric: "median_ms", max_regression_percent: 5 }]).failures[0], "missing-metric:median_ms", "missing metric fails closed");
eq(P.evaluate(map{ value: 0 }, map{ value: 1 }, [map{ metric: "value", max_regression_percent: 100 }]).checks[0].status, "zero-baseline-changed", "zero baseline cannot hide an increase");
eq(P.evaluate(map{ value: 0 }, map{ value: 0 }, [map{ metric: "value", max_regression_percent: 0 }]).ok, true, "unchanged zero baseline passes");

let threw = try P.assert_within(baseline, map{ median_ms: 200 }, [map{ metric: "median_ms", max_regression_percent: 0 }]) catch "caught";
eq(threw, "caught", "assert throws on failed budget");
print "performance_budget_pass";
