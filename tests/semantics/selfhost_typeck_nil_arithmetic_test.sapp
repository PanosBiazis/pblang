let T = import("stdlib:compiler/tokenizer.sapp");
let P = import("stdlib:compiler/parser.sapp");
let C = import("stdlib:compiler/typeck.sapp");
let F = import("stdlib:compiler/selfhost_frontend.sapp");
fn expect(ok, message) { if not ok { throw "FAIL typeck-nil-arithmetic: " + message; } }
fn check(source) {
    let ast = P.parse(T.tokenize(source));
    expect(len(ast.errors) == 0, "fixture parses");
    return C.type_check(ast.stmts);
}
fn nil_count(diags) {
    let count = 0;
    for d in diags { if d.code == "nil-arithmetic" { count = count + 1; } }
    return count;
}
for op in ["+", "-", "*", "/", "%"] {
    for pair in [["nil", "1"], ["1", "nil"], ["nil", "nil"]] {
        let source = "let result = " + pair[0] + " " + op + " " + pair[1] + ";";
        let diags = check(source);
        expect(len(diags) == 1 and nil_count(diags) == 1, "one diagnostic per invalid binary expression");
        let compiled = F.frontend_compile(source);
        expect(not compiled.ok and nil_count(compiled.diagnostics) == 1, "frontend reports nil arithmetic");
    }
}
expect(nil_count(check("let result = -nil;")) == 1, "unary nil negation");
expect(nil_count(check("let n = nil; let result: number = n - 1;")) == 1, "inferred nil binding");
expect(nil_count(check("let result = (nil - 1) * 2;")) == 1, "no cascading fabricated numeric result");
expect(nil_count(check("let result = (nil - 1) + (2 / nil);")) == 2, "both subexpressions checked");
expect(nil_count(check("let result = try (nil - 1) catch 9;")) == 1, "try does not erase a concrete type error");
for number in ["bigint(1)", "rational(1, 2)", "decimal(1)"] {
    expect(nil_count(check("let result = nil - " + number + ";")) == 1, "numeric precision ladder");
    expect(nil_count(check("let result = " + number + " - nil;")) == 1, "right nil across numeric ladder");
}
for source in [
    "let result = 3 + 2 * 4 - 1;",
    "let result = -3; let yes = not nil; let also = !nil;",
    "let equal = nil == nil; let different = nil != 1;",
    "let result = \"value=\" + nil; let reverse = nil + \"value\";",
    "fn dynamic(x) { return nil - x; }",
    "fn generic(x: T): T { return x - nil; }",
    "let possible: number? = nil; let result = possible - 1;"
] { expect(len(check(source)) == 0, "existing gradual and non-arithmetic behavior preserved"); }
// Concrete nil arithmetic fails the checked run gate before even an earlier print.
let rejected = F.frontend_run_bounded("print 123; let result = nil - 1;", map{ max_steps: 1000, max_frames: 8 });
expect(not rejected.ok and len(rejected.output) == 0, "checked runner does not execute rejected source");
let overloaded = F.frontend_run_bounded("let obj = map{ __rsub__: fn(self, other) { return 7; } }; let result = nil - obj;", map{ max_steps: 1000, max_frames: 8 });
expect(overloaded.ok and overloaded.globals.result == 7, "reflected overload with nil remains executable");
let valid = F.frontend_run_bounded("let result = (8 - 2) * 3 / 2;", map{ max_steps: 1000, max_frames: 8 });
expect(valid.ok and valid.globals.result == 9, "valid arithmetic still executes");
let env = C.TypeEnv();
let inferred = C.infer_expr(env, map{ kind: "binary", op: "-", line: 17,
    left: map{ kind: "nil" }, right: map{ kind: "number", value: 1 } });
expect(inferred.kind == "any" and len(env.diagnostics) == 1, "invalid expression has no fabricated numeric type");
expect(env.diagnostics[0].span.line == 17 and env.diagnostics[0].code == "nil-arithmetic",
    "diagnostic retains source location and stable category");
expect(env.diagnostics[0].message == "arithmetic on nil operand", "diagnostic does not echo source or values");
// Public AST entry retains malformed-input diagnosis rather than throwing.
let malformed = C.type_check([map{ kind: "expr_stmt", expr: map{ kind: "binary", op: "-" } }]);
expect(len(malformed) > 0 and malformed[0].code == "malformed-ast", "malformed operand shape");
print "selfhost_typeck_nil_arithmetic_pass";
