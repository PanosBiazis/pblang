// Isolated copies, hidden original sources, foreign caller and denied network.
if platform()!="linux" {print "pbai_checkpoint_batch_skip_linux_required";os_exit(0);}
let U=import("stdlib:uuid.sapp");let parent=path_dirname(cwd());let exe=env_get("PBLANG_BIN");
assert(type(exe)=="string" and exe!="","trusted PBLANG_BIN required");
let phase=env_get("PBAI_BATCH_PHASE");assert(phase=="real" or phase=="faults" or phase=="unavailable-scope" or phase=="unavailable-resource","bounded batch phase required");
let root=path_join("/tmp","pbai-checkpoint-batch-installed-"+U.v4());let caller=path_join(root,"caller");let step=["setup"];let completed=[0];
fn process(command,args){let argv=["-k","1s","20s",command];for arg in args {push(argv,arg);}return proc_spawn_wait("/usr/bin/timeout",argv);}
fn must(command,args){let out=process(command,args);assert(out.exit_code==0,"batch fixture operation");return out;}
fn build(at){let out=must("/usr/bin/env",["-C",at,exe,"build"]);assert(str_contains(out.stdout,"build ok"),"batch fixture build");}
fn hidden(at,mode,file="case.sapp"){
 let args=["--die-with-parent","--unshare-net","--ro-bind","/","/","--dev","/dev","--bind",root,root,
  "--tmpfs",path_join(parent,"pblang"),"--tmpfs",path_join(parent,"pbai")];
 let extra=env_get("PBAI_SOURCE_HIDE_ROOT");if type(extra)=="string" and extra!="" {push(args,"--tmpfs");push(args,extra);}
 for value in ["--setenv","PBAI_STATE_ROOT",path_join(root,"state"),"--setenv","PBAI_BATCH_PHASE",mode,
  "--setenv","PBAI_CHECKPOINT_TEST_DIR",path_join(at,"private"),"--setenv","PBAI_CHECKPOINT_TEST_PHASE",mode,
  "--chdir",caller,exe,"run",path_join(at,file),"--allow-all","--deny-net","--deny-http","--deny-sqlite"] {push(args,value);}
 if phase!="real" {for value in ["--deny-exec","--deny-spawn","--deny-ffi"] {push(args,value);}}
 return process("/usr/bin/bwrap",args);
}
fn exercise(){
 fs_mkdirs(root);must("/bin/chmod",["700",root]);fs_mkdirs(caller);fs_mkdirs(path_join(root,"state"));fs_mkdirs(path_join(caller,"stdlib"));
 for name in ["pbai_checkpoint_scope.sapp","resource_scope.sapp","pbai_student_checkpoint_io.sapp","secure_file.sapp","pbai_neural_adapter.sapp","pbai_specialist_binding.sapp","serialization.sapp","json.sapp"] {
  fs_write(path_join(path_join(caller,"stdlib"),name),"print \"DECOY_EXECUTED\";throw \"caller decoy\";\n");
 }
 fs_write(path_join(caller,"main.sapp"),"print 0;\n");
 fs_write(path_join(caller,"pblang.toml"),"[package]\nname=\"batch-caller\"\nversion=\"0.1.0\"\nentry=\"main.sapp\"\n[dependencies]\nstdlib={path=\"stdlib\"}\n");build(caller);
 for repo in ["pblang","pbai"] {
  let source=path_join(parent,repo);let at=path_join(root,repo);fs_mkdirs(at);must("/bin/cp",["-R",path_join(source,"stdlib"),path_join(at,"stdlib")]);
  fs_write(path_join(at,"case.sapp"),fs_read(path_join(source,"tests/fixtures/pbai_checkpoint_batch.sapp")));
  fs_write(path_join(at,"optional.sapp"),"let AI=import(\"stdlib/pbai.sapp\");let IO=import(\"stdlib:pbai_student_checkpoint_io.sapp\");assert(len(AI.neural_specialist_checkpoint_bind(IO))==3,\"old binding unchanged\");print \"batch_optional_pass\";\n");
  let examples=if repo=="pblang" {"examples"} else {"demo"};
  fs_write(path_join(at,"write.sapp"),fs_read(path_join(source,path_join(examples,"pbai_student_checkpoint_file.sapp"))));
  fs_write(path_join(at,"example.sapp"),fs_read(path_join(source,path_join(examples,"pbai_student_checkpoint_batch.sapp"))));
  fs_mkdirs(path_join(at,"private"));must("/bin/chmod",["700",path_join(at,"private")]);
  let dep=if repo=="pblang" {"stdlib"} else {"../pblang/stdlib"};
  fs_write(path_join(at,"pblang.toml"),"[package]\nname=\"batch-installed\"\nversion=\"0.1.0\"\nentry=\"case.sapp\"\n[dependencies]\nstdlib={path="+json_stringify(dep)+"}\n");
 }
 if phase=="faults" {fs_write(path_join(root,"pblang/stdlib/pbai_student_checkpoint_io.sapp"),fs_read(path_join(parent,"pblang/tests/fixtures/pbai_checkpoint_batch_io.sapp")));}
 build(path_join(root,"pblang"));build(path_join(root,"pbai"));let expected="";
 for repo in ["pblang","pbai"] {
  let at=path_join(root,repo);step[0]=phase+" "+repo;
  if str_starts_with(phase,"unavailable-") {
   let names=if phase=="unavailable-scope" {["pbai_checkpoint_scope.sapp"]} else {["resource_scope.sapp"]};
   for name in names {
    let dependency=path_join(root,"pblang/stdlib/"+name);let original=fs_read(dependency);
    for mode in ["missing","broken"] {
     step[0]=repo+" "+name+" "+mode;
     if mode=="missing" {fs_remove(dependency);}else {fs_write(dependency,"throw \"SELECTED_BATCH_DEPENDENCY_BROKEN\";\n");}
     build(path_join(root,"pblang"));build(path_join(root,"pbai"));
     let optional=hidden(at,"real","optional.sapp");assert(optional.exit_code==0 and optional.stdout=="batch_optional_pass\n","old storage remains independent");
     let result=hidden(at,"real","example.sapp");
     assert(result.exit_code!=0 and not str_contains(result.stdout,"DECOY_EXECUTED")
      and str_contains(result.stderr,if mode=="missing" {"import not found"} else {"SELECTED_BATCH_DEPENDENCY_BROKEN"}),"selected dependency cannot use caller fallback");
     print "batch dependency pass "+repo+" "+name+" "+mode;
     fs_write(dependency,original);
    }
   }
   build(path_join(root,"pblang"));build(path_join(root,"pbai"));
  } else {
   let original="";
   if phase=="real" {
    let wrote=hidden(at,"write","write.sapp");assert(wrote.exit_code==0 and json_parse(wrote.stdout).saved,"private checkpoint setup");
    original=fs_read(path_join(at,"private/student.json"));
    fs_write(path_join(at,"private/corrupt.json"),"{}");
   }
   let result=hidden(at,phase);
   if result.exit_code!=0 {print result.stdout;print str_replace_all(result.stderr,root,"<fixture>");}
   let marker=if phase=="real" {"pbai_checkpoint_batch_real_pass:24\n"} else {"pbai_checkpoint_batch_faults_pass:130\n"};
   assert(result.exit_code==0 and result.stdout==marker,"batch matrix exact result");
   if phase=="real" {
    let path=path_join(at,"private/student.json");let bytes=fs_read(path);assert(bytes==original,"real matrix preserves original checkpoint bytes");let outputs=[];
    for mode in ["missing","corrupt","valid"] {
     let candidate=path_join(at,"private/candidate.json");if mode!="missing" {fs_write(candidate,if mode=="corrupt" {"{}"} else {bytes});}
     let example=hidden(at,"real","example.sapp");assert(example.exit_code==0,"batch example completion");let value=json_parse(example.stdout);
     assert(value.ok==(mode=="valid") and value.stage==(if mode=="valid" {"body"} else {"acquire"})
      and value.acquired_count==(if mode=="valid" {2} else {1}) and value.cleanups_attempted==value.acquired_count
      and value.cleanup_ok and not value.globally_activated,"example partial acquisition explicit");
     if mode=="valid" {assert(value.value.current==5 and value.value.candidate==5,"synthetic comparison predictions");}
     push(outputs,example.stdout);
    }
    assert(fs_read(path)==bytes and fs_read(path_join(at,"private/candidate.json"))==bytes,"checkpoint files unchanged");
    let encoded=json_stringify(outputs);if expected!="" {assert(encoded==expected,"exact example product parity");}expected=encoded;
   }
  }
  completed[0]=completed[0]+1;
 }
}
let passed=try {exercise();true} catch false;let removed=process("/bin/rm",["-rf","--",root]);
assert(passed,"checkpoint batch acceptance: "+step[0]);assert(removed.exit_code==0 and completed[0]==2,"owned batch fixture cleanup");
print "pbai_checkpoint_batch_"+phase+"_pass";
