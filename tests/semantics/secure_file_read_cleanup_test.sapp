// Complete real facade, resource-free backend substitution in the tooling runner.
fn run(S, B) {
    let cases = 0;
    for api in ["bytes", "text"] {
        for read_mode in ["success", "failure", "throw"] {
            for close_mode in ["success", "false", "nil", "number", "map", "throw"] {
                B.configure(read_mode, close_mode);
                let result = if api == "bytes" { S.read_bytes("owned/input", 8) }
                    else { S.read_text("owned/input", 8) };
                assert(B.state.opens == 1 and B.state.reads == 1 and B.state.closes == 1,
                    "acquired parent receives exactly one read and close attempt");
                if close_mode != "success" {
                    assert(not result.ok and result.cleanup_uncertain
                        and not result.parent_close_confirmed, "ambiguous cleanup rejects read");
                    assert(not map_has(result, "bytes") and not map_has(result, "text")
                        and len(map_keys(result)) == 4, "no payload on cleanup failure");
                } elif read_mode == "success" {
                    assert(result.ok and result.size == 2, "normal read preserved");
                    if api == "bytes" { assert(result.bytes == [206,177], "exact bytes"); }
                    else { assert(result.text == "α", "exact UTF-8"); }
                } elif read_mode == "failure" {
                    assert(not result.ok and result.error == "synthetic failure", "backend failure retained");
                } else {
                    assert(not result.ok and result.error == "secure read backend failed",
                        "backend exception redacted after cleanup");
                }
                assert(not str_contains(json_stringify(result), "synthetic-private-value"),
                    "exception text does not escape");
                cases = cases + 1;
            }
        }
    }
    B.configure("success", "success");
    assert(not S.read_bytes("owned/input", -1).ok, "negative limit rejected");
    assert(not S.read_bytes("owned/input", "8").ok, "string limit rejected");
    assert(not S.read_bytes("", 8).ok, "empty path rejected");
    assert(B.state.opens == 0 and B.state.closes == 0, "invalid arguments acquire nothing");
    B.state.admit = false;
    assert(not S.read_bytes("owned/input", 8).ok, "parent rejection");
    assert(B.state.opens == 1 and B.state.reads == 0 and B.state.closes == 0,
        "unacquired parent never closed");
    return map{ok:true,matrix_cases:cases,admission_cases:4};
}
export run;
