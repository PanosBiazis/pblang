let X = import("stdlib:x11_input.sapp");
let E = import("stdlib:input_events.sapp");
fn fail(m) { throw "FAIL " + m; }

let key = X.plan(E.key_event("Enter").event);
if not key.ok or key.backend != "pblang-x11-xtest" or len(key.calls) != 6 { fail("key plan"); }
if not X.plan(E.click_event(1).event).ok { fail("click plan"); }
if not X.plan(E.pointer_delta_event(-2, 4).event).ok { fail("relative plan"); }
let absolute = X.plan(E.pointer_event(10, 20).event); if absolute.ok { fail("absolute must fail closed"); }
let typed = X.plan(E.type_event("Hello, PBLang!").event); if not typed.ok or len(typed.text.strokes) != 14 { fail("ASCII text plan"); }
if not typed.text.strokes[0].shift or typed.text.strokes[5].keysym != "comma" { fail("ASCII modifiers and punctuation"); }
let unicode = X.text_plan("α😀");
if not unicode.ok or unicode.strokes[0].keysym != "U03B1" or unicode.strokes[1].keysym != "U1F600" { fail("Unicode keysym plan"); }
let compose = X.compose_plan("Aα😀");
if not compose.ok or compose.sequences[0].mode != "direct" or
   compose.sequences[1].hex != "3b1" or compose.sequences[2].hex != "1f600" or
   compose.sequences[2].commit != "Return" or not compose.application_compatibility_required {
    fail("opt-in Unicode compose plan");
}
let controls = X.text_plan("a" + strfromcharcode(1)); if controls.ok { fail("unsupported control must fail closed"); }
let caps = X.capabilities();
if not caps.key or caps.absolute_pointer or not caps.text or not caps.text_unicode_current_keymap or
   not caps.unicode_compose_opt_in or not caps.unicode_compose_application_dependent or
   caps.changes_keyboard_layout or caps.external_xdotool_required { fail("capabilities"); }
if not map_has(X.available(), "trusted_absolute_paths") or not X.available()["trusted_absolute_paths"] { fail("trusted paths"); }

print "x11_input_pass";
