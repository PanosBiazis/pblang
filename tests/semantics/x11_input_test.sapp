let X = import("stdlib:x11_input.sapp");
let E = import("stdlib:input_events.sapp");
fn fail(m) { throw "FAIL " + m; }

let key = X.plan(E.key_event("Enter").event);
if not key.ok or key.backend != "pblang-x11-xtest" or len(key.calls) != 6 { fail("key plan"); }
if not X.plan(E.click_event(1).event).ok { fail("click plan"); }
if not X.plan(E.pointer_delta_event(-2, 4).event).ok { fail("relative plan"); }
let absolute = X.plan(E.pointer_event(10, 20).event);
if not absolute.ok or absolute.absolute_strategy != "bounded-relative-origin-anchor"
    or len(absolute.calls) != 6 or absolute.calls[1] != "XTestFakeRelativeMotionEvent"
    or absolute.calls[2] != "XTestFakeRelativeMotionEvent"
    or absolute.calls[4] != "XSync" { fail("absolute pointer plan"); }
let invalid_absolute = X.plan(map{ kind: "pointer", x: -1, y: 20 });
if invalid_absolute.ok { fail("invalid absolute pointer must fail closed"); }
let typed = X.plan(E.type_event("Hello, PBLang!").event); if not typed.ok or len(typed.text.strokes) != 14 { fail("ASCII text plan"); }
if not typed.text.strokes[0].shift or typed.text.strokes[5].keysym != "comma" { fail("ASCII modifiers and punctuation"); }
let unicode = X.text_plan("α😀");
if not unicode.ok or unicode.strokes[0].keysym != "U03B1" or unicode.strokes[1].keysym != "U1F600" { fail("Unicode keysym plan"); }
let compose = X.compose_plan("Aα😀");
if not compose.ok or compose.sequences[0].mode != "direct" or
   compose.sequences[1].hex != "3b1" or compose.sequences[2].hex != "1f600" or
   compose.sequences[2].commit != "Return" or not compose.application_compatibility_required {
    fail("opt-in Unicode compose plan");
}
let controls = X.text_plan("a" + strfromcharcode(1)); if controls.ok { fail("unsupported control must fail closed"); }
let defaults = X.execution_options();
if not defaults.semantic_unicode or defaults.unicode_compose { fail("safe execution defaults"); }
let explicit = X.execution_options(map{ semantic_unicode: false, unicode_compose: true });
if explicit.semantic_unicode or not explicit.unicode_compose { fail("explicit execution options"); }
let malformed = X.execution_options(map{ semantic_unicode: "yes", unicode_compose: 1 });
if not malformed.semantic_unicode or malformed.unicode_compose { fail("malformed options retain safe defaults"); }
let caps = X.capabilities();
if not caps.key or not caps.absolute_pointer
   or caps.absolute_pointer_strategy != "bounded-relative-origin-anchor"
   or not caps.absolute_pointer_multi_screen_origin_limited
   or not caps.text or not caps.text_unicode_current_keymap or
   not caps.unicode_reversible_empty_keycode_mapping or not caps.mapping_restore_required or
   not caps.unicode_mapping_process_serialized or
   not caps.unicode_mapping_cross_process_serialized or
   not caps.unicode_mapping_lock_crash_released or
   caps.unicode_mapping_lock_bounded_wait_ms != 1000 or
   not caps.unicode_compose_opt_in or not caps.unicode_compose_application_dependent or
   not caps.temporary_keyboard_mapping or caps.external_xdotool_required { fail("capabilities"); }
if not map_has(X.available(), "trusted_absolute_paths") or not X.available()["trusted_absolute_paths"] { fail("trusted paths"); }
if X.available().semantic_unicode != caps.text_unicode_layout_independent {
    fail("semantic Unicode availability must reflect trusted xmodmap discovery");
}

print "x11_input_pass";
