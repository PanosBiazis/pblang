let QR = import("stdlib:qrcode.sapp");

fn require(value, message) { if not value { throw "FAIL qrcode: " + message; } }
fn matrix_hash(qr) {
    let bits = "";
    for y qr.size { for x qr.size { bits = bits + if qr.modules[y][x] { "1" } else { "0" }; } }
    return sha256(bits);
}

let a = QR.encode("HELLO WORLD", "M");
require(a.ok and a.version == 1 and a.size == 21 and a.total_codewords == 26
    and a.mask >= 0 and a.mask <= 7, "version-1 metadata");
require(QR.encode("HELLO WORLD", "M").modules == a.modules, "deterministic matrix");
require(a.mask == 4 and matrix_hash(a) == "f516d851861750f4deffb7514598d7058ab57a40b130409930189536174c89aa",
    "version-1 reference matrix");
require(not QR.encode("", "M").ok and not QR.encode("x", "Z").ok,
    "invalid payload and unsupported level fail closed");

let quality = QR.encode("error correction Q", "Q");
let high = QR.encode("error correction H", "H");
require(quality.ok and quality.level == "Q" and high.ok and high.level == "H",
    "all standard error-correction levels");
require(quality.version == 2 and quality.mask == 3
    and matrix_hash(quality) == "b5668b7870cad5dc7df20ece632099289323ff59fb2d8331d835f95d6a13a020",
    "Q-level reference matrix");
require(high.version == 3 and high.mask == 0
    and matrix_hash(high) == "41ea935a3fd83d2ec1675119236da0521625bd74afd5dc3c7279d3d519c942d2",
    "H-level reference matrix");

let unicode = QR.encode("PBLang Ελληνικά 😀", "L");
require(unicode.ok and unicode.utf8_bytes == len(str_to_bytes("PBLang Ελληνικά 😀")),
    "UTF-8 byte mode");
require(unicode.version == 2 and unicode.mask == 0
    and matrix_hash(unicode) == "d883afeb09e940b1eb4cb52f116a6c284d50410a8de533dda5399a1894db405f",
    "version-2 Unicode reference matrix");
let medium = QR.encode(str_repeat("x", 80), "M");
let large = QR.encode(str_repeat("y", 180), "L");
require(medium.version == 5 and medium.mask == 0
    and matrix_hash(medium) == "b7e0b3cbc881006df51934ea35125fc13d071ab7cf0c0c245782084f5c59a023",
    "version-5 multi-block reference matrix");
require(large.version == 8 and large.mask == 1
    and matrix_hash(large) == "ca5cd5626de11c04f020390a9088d35108de6e3251977b18217ffb82515be035",
    "version-8 version-information reference matrix");

let svg = QR.to_svg(a, 4);
require(str_starts_with(svg, "<svg") and str_contains(svg, "<path")
    and str_contains(svg, "aria-label=\"QR code\""), "bounded accessible SVG");
require(try { QR.to_svg(a, 4, "url(evil)"); false } catch true,
    "SVG colors fail closed unless hexadecimal");
let text = QR.to_text(a);
require(str_contains(text, "██") and len(str_split(text, "\n")) == 29,
    "terminal renderer includes four-module quiet zone");

let png = QR.to_png(a, 4);
require(len(png) > 100 and png[0] == 137 and png[1] == 80 and png[2] == 78 and png[3] == 71,
    "PNG signature and payload");
fs_write_bytes(".pblang-qrcode-test.png", png);
fs_remove(".pblang-qrcode-test.png");
print "qrcode_pass";
