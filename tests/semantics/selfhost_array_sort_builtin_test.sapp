let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let O=import("stdlib:compiler/optimizer.sapp");
let B=import("stdlib:compiler/vm_builtins.sapp");
fn require(ok,message){if not ok {throw "FAIL array_sort: "+message;}}
require(map_has(B.registry(),"array_sort"),"registered");
for source in [
 "print array_sort([3,-1,2,2]);",
 "let sort=array_sort; print sort([3,-1,2,2]);",
 "fn call(f,x){return f(x);} print call(array_sort,[3,-1,2,2]);"
] {
 let c=F.frontend_compile(source);require(c.ok,"compile");
 for chunk in [c.chunk,O.optimize_safe(c.chunk).chunk] {
  require(V.run(chunk).output==[[-1,2,2,3]],"numeric order");
  require(V.run_bounded(chunk).output==[[-1,2,2,3]],"bounded parity");
 }
 for ins in c.chunk.instructions {if map_has(ins,"direct_builtin_call") {map_remove(ins,"direct_builtin_call");}}
 require(V.run(c.chunk).output==[[-1,2,2,3]],"legacy metadata optional");
}
for values in [[],["z","a","δ","A"],[true,false,nil],[map{x:1},map{x:2}],[3,"a",nil,2]] {
 let chunk=F.frontend_compile("print array_sort(input);").chunk;
 let out=V.run_seeded(chunk,map{input:values}).output;
 require(out==[array_sort(values)],"retained host ordering parity");
}
let unchanged=F.frontend_run("let a=[3,1,2]; let b=array_sort(a); b[0]=8; print a; print b;");
require(unchanged.output==[[3,1,2],[8,2,3]],"outer array detached");
let shallow=F.frontend_run("let a=[map{x:1}]; let b=array_sort(a); b[0].x=2; print a[0].x;");
require(shallow.output==[2],"nested alias semantics unchanged");
for args in ["","[],1","[],1,2","[],1,2,3","nil","1","map{}","\"private-value\""] {
 let r=F.frontend_run("let sort=array_sort; print try sort("+args+") catch 77;");
 require(r.ok and r.output==[77],"invalid input catchable");
}
require(F.frontend_run("fn array_sort(a){return [42];} print array_sort([]);").output==[[42]],"global shadow");
require(F.frontend_run("fn f(){let array_sort=fn(a){return [43];};return array_sort([]);} print f();").output==[[43]],"local shadow");
let compiled=F.frontend_compile("print array_sort(input);").chunk;
require((try V.run_seeded_bounded(compiled,map{input:[3,2,1]},map{max_value_items:2}) catch "limited")=="limited","existing bounded value policy");
print "selfhost_array_sort_builtin_pass";
