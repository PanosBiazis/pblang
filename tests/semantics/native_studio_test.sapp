// tests/semantics/native_studio_test.sapp — the ergonomic native layer: an easy IR builder,
// auto-optimize + validate, result caching (fast), and watcher-backed observability.

let S = import("stdlib/native_studio.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── easy builder: write readable steps instead of raw IR arrays ──────────────────────
let p = S.prog();
S.seti(p, 0, 0); S.seti(p, 1, 10); S.loopb(p, 1, [["add", 0, 1]]);   // sum 1..10
eq(len(p), 3, "builder accumulates ops");

// ── observability: metrics start clean ──────────────────────────────────────────────
S.reset();
eq(S.metrics().runs, 0, "metrics reset");

if S.available() {
    // ── smart run: optimize + validate + execute, returns the real value ────────────
    eq(S.run_value(p), 55, "studio run_value");
    eq(S.metrics().runs, 1, "one run recorded");
    eq(S.metrics().cache_hits, 0, "first run is a cache miss");

    // ── efficient: the SAME program is served from cache (no recompile/re-exec) ──────
    eq(S.run_value(p), 55, "cached run_value");
    eq(S.metrics().cache_hits, 1, "second run is a cache hit");

    // optimize is applied: a loop-free program folds to a constant before compiling
    eq(S.run_value([["seti", 0, 6], ["addi", 0, 36]]), 42, "studio folds + runs");
}

// ── bytecode fast path: folded constants run IN-PROCESS (no native exec needed) ──────
S.reset();
eq(S.strategy([["seti", 0, 6], ["addi", 0, 36]]), "const", "loop-free program -> const strategy");
eq(S.strategy([["seti", 0, 0], ["seti", 1, 3], ["loop", 1, [["add", 0, 1]]]]), "native", "loop program -> native strategy");
// the const path returns the answer with NO process spawn — works on ANY host
eq(S.run_value([["seti", 0, 6], ["addi", 0, 36]]), 42, "const fast-path value");
eq(S.metrics().const_hits, 1, "const fast-path recorded (no native exec)");
// in-process interpreter (the bytecode VM) runs even a loop with no native compile
eq(S.eval_interp([["seti", 0, 0], ["seti", 1, 10], ["loop", 1, [["add", 0, 1]]]]), 55, "eval_interp loop sum");

// ── observability: timing + trace + unified process report (watchers) ───────────────
if S.available() {
    let m = S.metrics();
    if not map_has(m, "total_ms") { fail("metrics should include timing"); }
    if len(S.trace()) < 1 { fail("trace should record operations"); }
    let rep = S.process_report();
    if not map_has(rep, "compute") or not map_has(rep, "metrics") { fail("process_report shape"); }
}

// ── info(): host + hardware view (watchers) ─────────────────────────────────────────
let nfo = S.info();
if str_index_of(str(nfo.host_arch), "x86") < 0 and str_index_of(str(nfo.host_arch), "arm") < 0 and str_index_of(str(nfo.host_arch), "i386") < 0 {
    fail("info host_arch: " + str(nfo.host_arch));
}
if not map_has(nfo, "hardware") { fail("info should include a hardware view from watchers"); }

print "native_studio_pass";
