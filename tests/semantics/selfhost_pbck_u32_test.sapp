// Independent arithmetic oracle for the little-endian u32 writer.
let PB = import("stdlib/selfhost_pbck.sapp");
fn require(ok, why) { if not ok { throw "FAIL PBCS u32: " + why; } }
fn chunk(value) {
    // OP_SUB has no interpreted operand; test the container field, not execution.
    return map{instructions:[map{op:2, operand:value}], constants:[]};
}
fn check(value) {
    let bytes = PB.serialize_chunk(chunk(value));
    require(len(bytes) == 22, "single instruction length");
    let expected = [80,66,67,83,3, 1,0,0,0, 2,0,0,0, 0];
    let rest = value; let i = 0;
    while i < 4 {
        let quotient = num_floor(rest / 256);
        array_push(expected, rest - quotient * 256);
        rest = quotient; i = i + 1;
    }
    i = 0; while i < 4 { array_push(expected, 0); i = i + 1; }
    i = 0;
    while i < len(bytes) { require(bytes[i] == expected[i], "independent byte oracle"); i = i + 1; }
    let decoded = PB.deserialize_chunk(bytes);
    require(decoded.instructions[0].operand == value, "unsigned roundtrip");
}
let edges = [0,1,254,255,256,257,65535,65536,65537,16777215,16777216,16777217,
    2147483647,2147483648,2147483649,4294967294,4294967295];
let i = 0; while i < len(edges) { check(edges[i]); i = i + 1; }
// Deterministic mixed bytes, with arithmetic kept below 2^53.
let state = 19; i = 0;
while i < 512 { state = (state * 1664525 + 1013904223) % 4294967296; check(state); i = i + 1; }
let invalid = [0-1, 0.25, 4294967296, "1", true, nil, [], map{}];
i = 0;
while i < len(invalid) {
    let rejected = try { PB.serialize_chunk(chunk(invalid[i])); false } catch true;
    require(rejected, "invalid operand rejected before packing"); i = i + 1;
}
// Input bytes are still independently untrusted; writer optimization must not
// accidentally relax reader validation on any byte of the u32 field.
let bad_values = [0-1,256,1.5,"0",true,nil]; let offset = 14;
while offset < 18 {
    i = 0;
    while i < len(bad_values) {
        let bytes = PB.serialize_chunk(chunk(0)); bytes[offset] = bad_values[i];
        let rejected = try { PB.deserialize_chunk(bytes); false } catch true;
        require(rejected, "invalid encoded byte rejected"); i = i + 1;
    }
    offset = offset + 1;
}
print "selfhost_pbck_u32_pass: 529 exact encodings, 32 rejected inputs";
