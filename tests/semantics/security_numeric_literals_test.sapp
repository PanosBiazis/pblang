let S=import("stdlib:security_analysis.sapp");
let T=import("stdlib:security_taint.sapp");
for source in ["let x=0x;","let x=0b102;","let x=0o8;","let x=1e+;","let x=0xprivate_canary;"] {
    let scan=S.analyze(source,"fixture.sapp",map{minimum_blocking_severity:"high",allow_high_suppressions:true});
    assert(scan.ok and not scan.passed and not scan.mandatory_complete and scan.mandatory_blocking>0,
        "invalid number makes mandatory analysis incomplete regardless of configured thresholds");
    let taint=T.analyze(source,"fixture.sapp");
    assert(not taint.ok and not taint.passed and not taint.parser_complete,"taint refuses invalid numeric AST");
    assert(not str_contains(json_stringify(scan),"private_canary")
        and not str_contains(json_stringify(taint),"private_canary"),"reports do not echo invalid numeric suffixes");
}
let valid="let x=0x10; let y=1e+2; let label=\"0b102\"; // 1e+\n";
assert(S.analyze(valid,"fixture.sapp").passed and T.analyze(valid,"fixture.sapp").parser_complete,
    "valid numbers and inert malformed-looking strings/comments retain analysis coverage");
print "security_numeric_literals_pass";
