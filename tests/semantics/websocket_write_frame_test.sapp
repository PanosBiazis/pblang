// tests/semantics/websocket_write_frame_test.sapp — W3/W4 websocket write test
import "stdlib:websocket.sapp";

// Write a text frame (opcode=1, unmasked)
let frame = websocket.write_frame("Hello", 1, false);
if frame == nil { print "write_frame nil FAIL"; }

// Write a binary frame (opcode=2)
let bin_frame = websocket.write_frame("data", 2, false);
if bin_frame == nil { print "write_frame_binary nil FAIL"; }

print "websocket_write_frame_test: pass";
