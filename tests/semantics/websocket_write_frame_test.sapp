// websocket_write_frame_test.sapp
// Verify write_frame byte layout per RFC 6455 for a small masked text frame.
import "stdlib:websocket.sapp";

let frame = websocket.write_frame(1, "Hi");

// Byte 0: FIN=1 + opcode=1 → 0x81 = 129
let b0 = strcharcodeat(frame, 0);
if b0 != 129 { print "FAIL write_frame b0: " + str(b0); }

// Byte 1: MASK=1 + plen=2 → 0x82 = 130
let b1 = strcharcodeat(frame, 1);
if b1 != 130 { print "FAIL write_frame b1: " + str(b1); }

// Total frame length: 2 header + 4 mask key + 2 payload = 8
if len(frame) != 8 { print "FAIL write_frame len: " + str(len(frame)); }

print "websocket_write_frame_test: pass";

