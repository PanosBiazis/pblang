let W=import("editors/ide/pbide_text_web.sapp");
let T=import("editors/ide/pbide_text.sapp");
let H=import("editors/ide/pbide_text_history.sapp");
let C=import("editors/ide/pbide_history_wire.sapp");
let D=import("editors/ide/pbide_tabs_wire.sapp");
let HTML=import("stdlib:html.sapp");
fn history(text) { return H.create(T.selection(text),C.BUDGET); }
fn request(body,path="/import",ct="multipart/form-data; boundary=PB_test") {
    return map{method:"POST",path:path,body:body,headers:map{host:"127.0.0.1:18771",origin:"http://127.0.0.1:18771",
        "content-type":ct,"content-length":str(len(str_to_bytes(body)))}};
}
fn upload(workspace,source) {
    return request("--PB_test\r\nContent-Disposition: form-data; name=\"workspace\"\r\n\r\n"+D.encode(workspace)
        +"\r\n--PB_test\r\nContent-Disposition: form-data; name=\"upload\"; filename=\"../private-canary.sapp\"\r\nContent-Type: text/plain\r\n\r\n"
        +source+"\r\n--PB_test--\r\n");
}
let original=D.create(history("old draft")); let before=D.encode(original);
let source="let π=\"😀\";\n</textarea><script>literal</script>";
let imported=W.handle(upload(original,strfromcharcode(65279)+str_replace_all(source,"\n","\r\n")),18771);
let expected=D.replace(D.add(original),history(source));
assert(imported.status==200 and str_contains(imported.body,HTML.escape(D.encode(expected)))
    and str_contains(imported.body,HTML.escape(source)) and not str_contains(imported.body,"private-canary")
    and not str_contains(imported.body,"<script>literal"),"new draft preserves workspace and escapes source, discards filename");
assert(D.encode(original)==before,"original workspace not mutated");
let full=D.restore(2,[map{id:1,history:history(str_repeat("a",4096))},map{id:2,history:history(str_repeat("b",4096))}]);
let four=D.add(D.add(D.add(original)));
for entry in [map{workspace:original,source:str_repeat("x",4097)},map{workspace:full,source:"x"},
    map{workspace:four,source:"x"},map{workspace:original,source:"a\rb"}] {
    let denied=W.handle(upload(entry.workspace,entry.source),18771);
    assert(denied.status==400 and str_contains(denied.body,"Import rejected.")
        and str_contains(denied.body,HTML.escape(D.encode(entry.workspace)))
        and not str_contains(denied.body,"private-canary"),"quota/text failure returns original canonical workspace for retry");
}
assert(W.handle(upload(full,""),18771).status==200,"empty file can be added at full byte budget");
for key in ["host","origin"] {
    let req=upload(original,source); req.headers[key]="https://foreign.invalid";
    assert(W.handle(req,18771).status==403,"upload retains host/origin gate");
}
let oversize=upload(original,"x"); oversize.headers["content-length"]="24577"; oversize.body="";
assert(not W.preflight(oversize,18771).allowed,"upload byte cap rejected before body access");
let mismatch=upload(original,"x"); mismatch.headers["content-length"]="1";
assert(W.handle(mismatch,18771).status==400,"actual body length checked");
let malformed=upload(original,"private-canary"); malformed.body=str_replace_all(malformed.body,before,"broken");
malformed.headers["content-length"]=str(len(str_to_bytes(malformed.body)));
let rejected=W.handle(malformed,18771);
assert(rejected.status==400 and not str_contains(rejected.body,"private-canary"),"malformed workspace never echoed");
let visible="\nunsaved \"<& edits😀";
let form="source="+url_encode(visible)+"&start=0&end=0&insert=&pair=round&op=import-file&history="
    +url_encode(C.encode(D.current(original)))+"&workspace="+url_encode(before);
let chooser=W.handle(request(form,"/edit","application/x-www-form-urlencoded"),18771);
let saved=D.replace(original,H.commit(D.current(original),T.selection(visible)));
assert(chooser.status==200 and str_contains(chooser.body,HTML.escape(D.encode(saved)))
    and str_contains(chooser.body,"enctype=\"multipart/form-data\"")
    and str_contains(chooser.body,"value=\""+HTML.escape(visible)+"\""),"chooser commits visible edits and escapes cancel source");
assert(str_index_of(chooser.body,"name=\"workspace\"")<str_index_of(chooser.body,"type=\"file\""),"workspace submitted before file");
let cancel=str_replace_all(form,"op=import-file","op=status");
assert(W.handle(request(cancel,"/edit","application/x-www-form-urlencoded"),18771).status==200,"return uses existing editor endpoint");
let worst=D.restore(1,[map{id:1,history:history(str_repeat("\"",4096))},map{id:2,history:history(str_repeat("'",4096))}]);
assert(len(str_to_bytes(W.import_page(worst,true)))+1024<W.MAX_RESPONSE,"chooser worst-case escaping fits response cap");
assert(str_contains(W.render(H.current(D.current(four)),D.current(four),nil,four),"value=\"import-file\" disabled"),"full draft toolbar disables import");
print "pbide_import_web_pass";
