let F=import("stdlib:compiler/selfhost_frontend.sapp");
let sources=["let a=1;", "let b:number=nil-1;", "let = ;", "fn add(x){return x+1;} print add(2);", "let c=[1,2,3];"];
let expected=[];
for source in sources {array_push(expected,F.frontend_compile(source));}
for size in [1,2,8] {
    let got=F.frontend_compile_many(sources,size);
    assert(len(got)==len(sources),"all source results");
    for i len(got) {
        assert(got[i].ok==expected[i].ok,"ordered status");
        assert(json_stringify(got[i].diagnostics)==json_stringify(expected[i].diagnostics),"diagnostics parity");
        assert(json_stringify(got[i].chunk.instructions)==json_stringify(expected[i].chunk.instructions),"instruction parity");
    }
    assert(len(F.frontend_compile_many([],size))==0,"empty batch");
}
for size in [nil,0,-1,1.5,65,true,"2",num_exp(1000),num_sqrt(-1)] {
    assert((try {F.frontend_compile_many([],size);false} catch true),"source limit rejected");
    assert((try {F.frontend_compile_file_many([],nil,size);false} catch true),"file limit rejected");
    assert((try {F.frontend_compile_project("unused",size);false} catch true),"project limit before directory access");
}
let paths=["tests/fixtures/frontend_batch/good.sapp","tests/fixtures/frontend_batch/bad.sapp"];
for size in [1,2] {
    let got=F.frontend_compile_file_many(paths,nil,size);
    assert(got[0].ok and not got[1].ok,"ordered file status");
    assert(got[0].symbol_table==nil,"wire-safe file result even sequential");
    let project=F.frontend_compile_project("tests/fixtures/frontend_batch",size);
    assert(project.ok_count==1 and project.fail_count==1,"project propagates worker option");
}
print "frontend_batch_limits_pass";
