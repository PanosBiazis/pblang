let H=import("editors/ide/pbide_text_history.sapp");
let T=import("editors/ide/pbide_text.sapp");
fn rejects(f) { let failed=false; try { f(); } catch { failed=true; } return failed; }
let first=T.selection("α😀β",1,2); let h=H.create(first);
let edited=H.commit(h,T.pair(first,"("));
assert(H.current(H.undo(edited)).text==first.text and H.current(H.undo(edited)).end==2,"undo restores text and selection");
assert(H.current(H.redo(H.undo(edited))).text=="α(😀)β","redo restores edit");
assert(H.current(h).text==first.text and len(h.frames)==1,"commit does not mutate original");
let branched=H.commit(H.undo(edited),T.tab(first));
assert(not H.availability(branched).redo and H.current(branched).text=="α    β","new edit discards redo branch");
let moved=H.commit(H.undo(edited),T.selection(first.text,0,0));
assert(len(moved.frames)==2 and H.availability(moved).redo,"selection-only change retains redo");
let same=H.undo(H.create(first)); assert(same.cursor==0,"undo boundary is stable");
let detached=H.current(edited); detached.text="changed";
assert(H.current(edited).text=="α(😀)β","returned snapshot is detached");
let bounded=H.create(T.selection(""));
for i in range(0,20) { bounded=H.commit(bounded,T.selection(str(i))); }
assert(len(bounded.frames)==9 and bounded.frames[0].text=="11","oldest snapshots evicted at frame cap");
let bytes=H.create(T.selection("αα"),8);
bytes=H.commit(bytes,T.selection("😀x"));
assert(len(bytes.frames)==1 and not H.availability(bytes).undo,"byte budget counts UTF8 not characters");
assert(rejects(fn(){H.commit(bytes,T.selection("123456789"));}),"oversize commit rejected");
assert(H.current(bytes).text=="😀x","failed commit preserves original");
assert(rejects(fn(){H.restore([],0);}),"empty history rejected");
assert(rejects(fn(){H.restore([first],0.5);}),"fractional cursor rejected");
assert(rejects(fn(){H.restore([first],1);}),"out of range cursor rejected");
assert(rejects(fn(){H.restore([first],0,0);}),"zero byte budget rejected");
print "pbide_text_history_pass";
