let C=import("stdlib:subtitle_clip.sapp");let S=import("stdlib:subtitles.sapp");
let doc=map{format:S.FORMAT,cues:[map{start_ms:0,end_ms:2000,text:"Εισαγωγή"},map{start_ms:1500,end_ms:4000,text:"A & <B>\nSecond line"},map{start_ms:5000,end_ms:6000,text:"End"}]};let before=S.to_srt(doc);
let out=C.extract(doc,1000,3000);assert(out.cues==[map{start_ms:0,end_ms:1000,text:doc.cues[0].text},map{start_ms:500,end_ms:2000,text:doc.cues[1].text}],"intersect clamp rebase");
assert(C.extract(doc,1000,3000,false).cues[1].start_ms==1500,"keep original axis");assert(C.extract(doc,2000,5000).cues==[map{start_ms:0,end_ms:2000,text:doc.cues[1].text}],"half-open touching boundaries excluded");
assert((try C.extract(doc,4000,5000) catch nil)==nil,"gap has no cues");out.cues[0].text="Changed";assert(S.to_srt(doc)==before,"detached result");
assert(S.parse_srt(S.to_srt(C.extract(doc,1000,3000)))==C.extract(doc,1000,3000),"SRT roundtrip");assert(str_contains(S.to_vtt(C.extract(doc,1000,3000)),"A &amp; &lt;B&gt;"),"literal VTT preserved");
for range in [[0,0],[2,1],[-1,5],[0,0.5],[true,5],[0,360000000],[nil,10],["0",10]] {assert((try C.extract(doc,range[0],range[1]) catch nil)==nil,"invalid boundaries");}
for mode in [nil,0,"zero"] {assert((try C.extract(doc,0,1000,mode) catch nil)==nil,"strict time mode");}
let edge=map{format:S.FORMAT,cues:[map{start_ms:S.MAX_TIME_MS-1,end_ms:S.MAX_TIME_MS,text:"Last"}]};assert(C.extract(edge,S.MAX_TIME_MS-1,S.MAX_TIME_MS).cues[0].end_ms==1,"maximum one millisecond interval");
let invalid=S.copy(doc);invalid.cues[2].text="";assert((try C.extract(invalid,0,1000) catch nil)==nil,"validate whole source before early stop");
let maximum=map{format:S.FORMAT,cues:[]};for i in range(0,128) {array_push(maximum.cues,map{start_ms:i,end_ms:i+2,text:str_repeat("x",512)});}assert(len(C.extract(maximum,0,130).cues)==128,"128 cues 65536 bytes");
// Independent overlap predicate and min/max oracle for all nonempty small windows.
let small=map{format:S.FORMAT,cues:[map{start_ms:0,end_ms:3,text:"a"},map{start_ms:2,end_ms:8,text:"b"},map{start_ms:2,end_ms:4,text:"c"},map{start_ms:9,end_ms:10,text:"d"}]};
for start in range(0,10) {for end in range(start+1,11) {
 let expected=[];for cue in small.cues {let lower=num_max(start,cue.start_ms);let upper=num_min(end,cue.end_ms);if upper>lower {array_push(expected,map{start_ms:lower-start,end_ms:upper-start,text:cue.text});}}
 let actual=try C.extract(small,start,end) catch nil;
 if len(expected)==0 {assert(actual==nil,"empty oracle");} else {assert(actual.cues==expected,"all-window oracle, tie order");}
}}
print "subtitle_clip_pass";
