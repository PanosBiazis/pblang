let P=import("stdlib:task_plan.sapp");let F=import("stdlib:task_plan_fields.sapp");let W=import("stdlib:task_plan_document.sapp");let T=import("stdlib:text_document.sapp");
fn rejects(f) {assert((try f() catch nil)==nil,"invalid fields rejected");}
let plan=P.edit(P.create("Old","9999-12-29"),"task_1","Last task",3,[]);let original=P.encode(plan);
let fields=F.read(plan,"task_1");assert(not F.pending(plan,"task_1",fields),"canonical fields clean");fields.start="9999-12-31";fields.days="1";fields.title="New";
let revised=F.apply(plan,"task_1",fields);assert(revised.start=="9999-12-31" and revised.tasks[0].days==1 and revised.title=="New","joint edit validates final state, not invalid intermediate date");
assert(P.encode(plan)==original,"source detached");fields.title="Other";assert(revised.title=="New","result detached from fields");
for value in ["", "0", "366", "1.0", "+1", " 1", "1e2", "NaN"] {let bad=F.read(plan,"task_1");bad.days=value;rejects(fn(){F.apply(plan,"task_1",bad);});}
for value in ["missing", "task_1", ",", str_repeat("x",784)] {let bad=F.read(plan,"task_1");bad.needs=value;rejects(fn(){F.apply(plan,"task_1",bad);});}
let extra=F.read(plan,"task_1");extra.other="x";rejects(fn(){F.apply(plan,"task_1",extra);});rejects(fn(){F.apply(plan,"missing",fields);});rejects(fn(){F.apply(plan,"task_1",nil);});
let doc=P.append(P.create("Παράδοση","2026-09-27"));doc=P.edit(doc,"task_2","Έλεγχος",2,["task_1"]);let edit=F.read(doc,"task_2");edit.needs=" task_1 ";let clean=F.apply(doc,"task_2",edit);assert(clean.tasks[1].needs==["task_1"],"prerequisite surrounding spaces normalized on apply");
let writer=W.create(doc);assert(writer.title==doc.title and len(writer.blocks)==4,"two blocks per task");assert(str_contains(writer.blocks[1].text,"unlimited workers") and str_contains(writer.blocks[3].text,"task_1") and str_contains(writer.blocks[3].text,"blocked"),"assumptions dependencies and status exported");
assert(T.decode(T.encode(writer))==writer,"Writer native roundtrip");
let many=P.create();for i in range(1,32) {many=P.append(many);}let full=W.create(many);assert(len(full.blocks)==64 and str_contains(full.blocks[62].text,"task_32"),"32-task plan fits block count without truncation");
rejects(fn(){W.create(map{});});assert(P.encode(plan)==original,"failed edits leave original intact");
print "task_plan_fields_and_document_pass";
