// tests/semantics/llm_adapters_enrich_test.sapp — enrichment for stdlib/llm_adapters.sapp
// Adds parameter-efficiency reporting: full_params, compression_ratio, param_savings.

let la = import("stdlib/llm_adapters.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn near(a, b, m) { if num_abs(a - b) > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// minimal model: lm_head is d_model(2) x vocab(4)
let model = map{ lm_head: [[0, 0, 0, 0], [0, 0, 0, 0]] };
let ad = la.lm_head_adapter(model, 1, 1.0, 1);

// ── base trainable_params (2*1 + 1*4 = 6) ────────────────────────────────────────
eq(la.trainable_params(ad), 6, "trainable_params");

// ── ENRICH: full_params (d_model*vocab) + efficiency ─────────────────────────────
eq(la.full_params(ad), 8, "full_params = 2*4");
near(la.compression_ratio(ad), 8 / 6, "compression_ratio = full/trainable");
near(la.param_savings(ad), 1 - 6 / 8, "param_savings = 1 - trainable/full");

print "llm_adapters_enrich_pass";
