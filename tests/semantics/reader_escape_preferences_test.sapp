let App=import("../../examples/declarative_browser/app.sapp");let GUI=import("stdlib:gui.sapp");
let D=import("stdlib:browser_document.sapp");let P=import("../../examples/declarative_browser/pagination.sapp");
let n=0;fn check(ok,label) {assert(ok,label);n=n+1;}
fn event(c,t,k) {App.update(c,[map{type:t,key:k}]);}
fn key(c,k) {event(c,"keydown",k);event(c,"keyup",k);}
fn act(c,name) {GUI.get(c.form,name).onclick(c.form);App.update(c,[]);}
let source=D.export_html(D.create("Keep my place",[map{tag:"p",text:str_repeat("Reading words. ",16)},map{tag:"a",text:"Guide",href:"pb://guide"}]));
fn make() {let c=App.create("local","dark",map{body_size:20,font_scale:1.5},source);c.width=320;c.height=480;App.refresh(c);App.read_page(c,len(c.reading_plan.pages)-1);App.refresh(c);return c;}
let c=make();let calls=map{save:0,reload:0};
let saver=fn(style) {calls.save=calls.save+1;return map{ok:true};};
App.enable_preferences(c,nil,saver,"Ready",fn(){calls.reload=calls.reload+1;return map{ok:false};});App.refresh(c);
let anchor=c.reading_anchor;let page=c.reading_page;let history=json_stringify(c.reading_history);let original=c.appearance;
check(not App.close_preferences(c) and not c.pending,"already closed is a no-op");
act(c,"appearance");act(c,"font_family");let old=c.form;
check(c.preferences.draft!=original and c.appearance==original,"unapplied draft differs");
event(c,"keydown","LShift");event(c,"keydown","Escape");
check(not c.settings and c.appearance==original and c.preferences.draft==original,"Escape discards only unapplied draft");
check(c.preferences.message=="Unapplied changes discarded","discard is explained");
check(c.reading_anchor==anchor and c.reading_page==page and json_stringify(c.reading_history)==history,"Escape keeps exact reading/history position");
check(c.form.focus=="appearance" and c.form.shift,"opener focus and held modifier preserved");
check(map_has(c.form.pressed_keys,"Escape") and not c.form.close_requested and not (try c.graphics_stop catch false),"consumed Escape cannot close window");
map_remove(old.pressed_keys,"Escape");check(map_has(c.form.pressed_keys,"Escape"),"rebuilt key state detached");
for i 8 {event(c,"keydown","Escape");check(not c.form.close_requested and not c.settings,"held Escape not replayed "+str(i));}
event(c,"keyup","Escape");event(c,"keyup","LShift");check(not c.form.shift and not map_has(c.form.pressed_keys,"Escape"),"key releases reach new form");
check(calls.save==0 and calls.reload==0,"Escape performs no save or reload");
// Already-applied choices survive; further draft changes are discarded.
act(c,"appearance");act(c,"font_family");App.settings_page(c,1);App.update(c,[]);act(c,"style_apply");let applied=c.appearance;
App.settings_page(c,0);App.update(c,[]);act(c,"font_family");key(c,"Escape");
check(c.appearance==applied and c.preferences.draft==applied and calls.save==0,"applied style survives Escape");
check(c.reading_anchor==anchor and c.reading_page==P.locate(c.reading_plan,anchor),"applied reflow retains anchor");
act(c,"appearance");App.settings_page(c,1);App.update(c,[]);act(c,"style_save");key(c,"Escape");
check(calls.save==1 and c.appearance==applied,"explicitly saved choices survive without duplicate save");
// Failure state remains fail-closed; dismissal is not a hidden recovery/retry.
act(c,"appearance");check(not App.reload_preferences(c),"synthetic reload fails");let message=c.preferences.message;
key(c,"Escape");check(c.preferences.save==nil and c.preferences.message==message and calls.reload==1 and calls.save==1,"unchanged failure state preserved");
// Resize and fresh keys later in the same batch must use the new document form.
act(c,"appearance");let family=c.appearance.font_family;
App.update(c,[map{type:"resize",w:390,h:600},map{type:"keydown",key:"Escape"},map{type:"keyup",key:"Escape"},map{type:"keydown",key:"Enter"},map{type:"keyup",key:"Enter"}]);
check(c.settings and c.width==390 and c.height==600,"same-batch Enter reopens Style at resized bounds");
check(c.preferences.draft.font_family==family and c.form.focus=="font_family","same-batch key cannot activate stale choice");
check(App.close_preferences(c) and not App.close_preferences(c),"programmatic dismissal is idempotent");App.update(c,[]);
check(c.form.focus=="appearance" and c.reading_anchor==anchor,"programmatic dismissal keeps focus and position");c.session.close();
// Legacy immediate settings have no draft to undo.
let legacy=make();act(legacy,"appearance");act(legacy,"font_family");key(legacy,"Escape");
check(legacy.appearance.font_family=="serif" and not legacy.settings,"legacy accepted setting remains");legacy.session.close();
for height in [240,288,480,816] {
    let short=make();App.enable_preferences(short);App.update(short,[map{type:"resize",w:320,h:height}]);act(short,"appearance");
    key(short,"End");short.form.focus=nil;key(short,"Escape");check(not short.settings and short.form.focus=="appearance" and not short.form.close_requested,"Escape works from every compact settings page even without focus");short.session.close();
}
// An actual close/quit event must still win, in either event ordering.
for kind in ["close","quit"] {
    for first in [true,false] {
        let closing=make();act(closing,"appearance");let close_event=map{type:kind};let escape_event=map{type:"keydown",key:"Escape"};
        let batch=[close_event,escape_event];if not first {batch=[escape_event,close_event];}App.update(closing,batch);
        check(closing.graphics_stop and closing.form.close_requested,"native "+kind+" retained; close first="+str(first));
        check(not App.close_preferences(closing),"dismissal cannot override requested close");closing.session.close();
    }
}
let document=make();document.form.focus=nil;key(document,"Escape");
check(document.graphics_stop and document.form.close_requested,"document Escape close behavior retained");document.session.close();
print "reader_escape_preferences_pass checks="+str(n);
