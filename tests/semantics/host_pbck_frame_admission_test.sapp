// A4: count live frames and admit parameter slots before allocating them.
let VM = import("stdlib:host_pbck_vm.sapp");
fn demand(ok, message) { if not ok { throw "FAIL frame-admission: " + message; } }
fn ins(op, operand = 0) { return map{op: op, operand: operand}; }
fn closure(index) { return map{op: 27, fn_const: index, captures: []}; }
fn program(code, constants) {
    return map{format: "host-pbck-v1", version: 1,
        chunk: map{instructions: code, constants: constants, source_name: nil}};
}
fn guest(arity, defaults, vararg, code, constants) {
    return map{__pbck_function: true, name: "fixture", arity: arity, min_arity: 0,
        defaults: defaults, is_vararg: vararg, parameter_types_present: false,
        parameter_types: [], chunk: program(code, constants).chunk};
}
fn rejected(artifact, options, reason) {
    // Retained host catch syntax is expression-based, not a named error binding.
    // Pair rejection with the identical artifact's N-boundary positive control.
    let failed = try { VM.run_decoded(artifact, options); false } catch true;
    demand(failed, "missing rejection: " + reason);
}
let leaf = guest(0, [], false, [ins(0, 0), ins(33)], [7]);
let call = program([closure(0), ins(31), ins(33)], [leaf]);
rejected(call, map{max_frames: 1}, "frame limit exceeded");
let two = VM.run_decoded(call, map{max_frames: 2});
demand(two.value == 7 and two.runtime.peak_frames == 2, "exact two-frame boundary");
let root = VM.run_decoded(program([ins(0, 0), ins(33)], [3]), map{max_frames: 1});
demand(root.value == 3 and root.runtime.peak_frames == 1, "root counts as one frame");
let tail = VM.run_decoded(program([closure(0), ins(32)], [leaf]), map{max_frames: 1});
demand(tail.value == 7 and tail.runtime.peak_frames == 1 and tail.runtime.tail_calls == 1,
    "handler-free tail reuse at one-frame limit");
let twice = VM.run_decoded(program([closure(0), ins(31), ins(11), closure(0), ins(31), ins(33)], [leaf]),
    map{max_frames: 2});
demand(twice.value == 7 and twice.runtime.peak_frames == 2, "returned frames must release admission");

let defaults = guest(2, [11, 12], false, [ins(33)], []);
let default_call = program([closure(0), ins(31), ins(33)], [defaults]);
rejected(default_call, map{max_stack: 1}, "parameter slots exceed stack limit");
rejected(default_call, map{max_locals: 1}, "parameter slots exceed locals limit");
demand(VM.run_decoded(default_call, map{max_stack: 2, max_locals: 2}).value == 12,
    "default parameters at exact slot limit");
let empty_body = program([closure(0), ins(31), ins(33)], [guest(2, [11, 12], false, [], [])]);
rejected(empty_body, map{max_stack: 1}, "parameter slots exceed stack limit");
rejected(empty_body, map{max_locals: 1}, "parameter slots exceed locals limit");
demand(VM.run_decoded(empty_body, map{max_stack: 2, max_locals: 2}).value == nil,
    "empty function body still admits parameters");
let varargs = guest(2, [11, 12], true, [ins(33)], []);
let vararg_call = program([closure(0), ins(31), ins(33)], [varargs]);
rejected(vararg_call, map{max_stack: 2}, "parameter slots exceed stack limit");
rejected(vararg_call, map{max_locals: 2}, "parameter slots exceed locals limit");
let empty_args = VM.run_decoded(vararg_call, map{max_stack: 3, max_locals: 3});
demand(is_array(empty_args.value) and len(empty_args.value) == 0, "empty varargs still reserve a slot");

// Guest cleanup calls need their own live frame too; failure cannot be swallowed.
let cleanup = program([closure(0), ins(34), ins(0, 1), ins(33)], [leaf, 9]);
rejected(cleanup, map{max_frames: 1}, "frame limit exceeded");
demand(VM.run_decoded(cleanup, map{max_frames: 2}).value == 9, "cleanup frame admission");

let effects = 0;
let effectful = guest(0, [], false, [ins(14, 0), ins(31), ins(33)], ["mark"]);
let adapters = map{mark: fn(_args) { effects = effects + 1; return 7; }};
let effect_call = program([closure(0), ins(31), ins(33)], [effectful]);
rejected(effect_call, map{max_frames: 1, adapters: adapters}, "frame limit exceeded");
demand(effects == 0, "rejected child executed an adapter");
demand(VM.run_decoded(effect_call, map{max_frames: 2, adapters: adapters}).value == 7
    and effects == 1, "admitted child effect");
let effect_cleanup = program([closure(0), ins(34), ins(0, 1), ins(33)], [effectful, 9]);
rejected(effect_cleanup, map{max_frames: 1, adapters: adapters}, "frame limit exceeded");
demand(effects == 1, "rejected cleanup executed an adapter");
let cleaned = VM.run_decoded(effect_cleanup, map{max_frames: 2, adapters: adapters});
demand(cleaned.value == 9 and cleaned.runtime.peak_frames == 2 and effects == 2,
    "admitted cleanup effect exactly once");
print "host_pbck_frame_admission_pass";
