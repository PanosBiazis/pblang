let S=import("stdlib:sample_series.sapp");
fn rejects(f) {let bad=false;try {f();}catch {bad=true;}assert(bad,"invalid samples rejected");}
let input=[2,4,6,8];let result=S.moving_mean(input,2);assert(result.values==[3,5,7] and result.first_source_index==1,"complete trailing windows");
result.values[0]=100;assert(input==[2,4,6,8],"detached samples");
assert(S.moving_mean(input,1).values==input and S.moving_mean(input,4).values==[5],"window boundaries");
assert(S.interpolate([0,2,4],[0,10,0],[0,1,2,3,4,1])==[0,5,10,5,0,5],"endpoints knots unsorted repeated queries");
assert(S.interpolate([0,2],[-1000000000,1000000000],[1])==[0],"numeric bounds");
let many=[];for i in range(0,4096) {array_push(many,1000000000);}assert(len(S.moving_mean(many,32).values)==4065,"maximum samples");
for f in [fn(){S.moving_mean([],1);},fn(){S.moving_mean(input,0);},fn(){S.moving_mean(input,1.5);},fn(){S.moving_mean(input,5);},fn(){S.moving_mean(["1"],1);},fn(){S.moving_mean([1000000001],1);},fn(){S.interpolate([0,0],[1,2],[0]);},fn(){S.interpolate([1,0],[1,2],[0]);},fn(){S.interpolate([0,1],[1],[0]);},fn(){S.interpolate([0,1],[1,2],[2]);},fn(){S.interpolate([0,1],[1,2],[]);}] {rejects(f);}
array_push(many,1);rejects(fn(){S.moving_mean(many,1);});print "sample_series_pass";

assert(S.interpolate([0,1],[1000000000,0.000000001],[1])==[0.000000001],"tiny final endpoint preserved");
assert(S.interpolate([0,1,2],[1000000000,-0.000000001,1000000000],[0,1,2])==[1000000000,-0.000000001,1000000000],"all exact knots preserved");
