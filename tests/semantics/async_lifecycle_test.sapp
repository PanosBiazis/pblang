let A = import("stdlib:async.sapp");
fn expect(value, message) { if not value { throw "FAIL async lifecycle: " + message; } }
for size in [0, -1, 1.5, "2", nil, true, num_exp(1000), num_sqrt(-1)] {
    expect((try A.pool(size, [fn(){return 1;}]) catch "rejected") == "rejected", "invalid pool size");
    if size != nil {
        expect((try A.map_parallel([1], fn(x){return x;}, size) catch "rejected") == "rejected", "invalid mapper size");
    }
}
expect((try A.pool(0, []) catch "rejected") == "rejected", "invalid empty pool also rejected");
expect(len(A.pool(1, [])) == 0, "valid empty pool");
expect(A.pool(9, [fn(){return 8;}])[0] == 8, "oversized pool clamps to task count");
let value = A.go(fn(){return map{__async_threw:true};});
expect(A.await(value).__async_threw, "sentinel-shaped value is not an exception");
expect(A.await(value).__async_threw, "cached value");
let failed = A.go(fn(){throw "failure";});
expect((try A.await(failed) catch "failed") == "failed", "task failure");
expect((try A.await(failed) catch "failed") == "failed", "cached failure");
let nil_task = A.go(fn(){return nil;});
let states = A.all_settled([value, failed, nil_task, value, failed]);
expect(states[0].ok and not states[1].ok and states[2].ok and states[2].value == nil, "mixed settled results");
expect(A.await(nil_task) == nil and not A.all_settled([failed])[0].ok, "cross API cache");
let slow = A.go(fn(){sleep_ms(400);return 9;});
let started = clock();
let pending = A.await_timeout(slow, 5);
expect(not pending.ready and (clock()-started)*1000 < 300, "deadline returns before worker");
expect(A.await(slow) == 9, "worker remains owned after deadline");
expect(A.await_timeout(nil_task, 0).ready, "nil completion is ready");
expect(A.await_timeout(failed, 0).ready and not A.await_timeout(failed, 0).ok, "error completion is ready");
let loser = A.go(fn(){sleep_ms(400);return 2;});
let winner = A.go(fn(){return 1;});
started = clock();
expect(A.await_race([loser, winner]) == 1, "fast winner");
expect((clock()-started)*1000 < 300, "race does not join slow loser");
expect(A.await(winner) == 1 and A.await(loser) == 2, "both futures remain reusable");
expect((try A.await_race([failed]) catch "failed") == "failed", "race surfaces cached failure");
expect(A.await_race([]) == nil, "empty race");
for ms in [-1, 0.5, "5", nil, true, num_exp(1000), num_sqrt(-1)] {
    expect((try A.await_timeout(nil_task, ms) catch "invalid") == "invalid", "invalid timeout rejected");
}
expect((try A.gather([fn(){throw "x";}, fn(){sleep_ms(10);return 2;}]) catch "failed") == "failed", "gather drains before surfacing failure");
print "async_lifecycle_pass";
