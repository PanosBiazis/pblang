let TRUST = import("stdlib:publisher_trust_store.sapp");
let SECURE = import("stdlib:secure_file.sapp");
let RELEASE = import("stdlib:product_release_evidence.sapp");

let A = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
let B = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
let C = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc";
let D = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd";
let COMMIT = "0123456789abcdef0123456789abcdef01234567";
let KEY_HEX = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a";
let KEY_ID = "21fe31dfa154a261626bf854046fd2271b7bed4b6abe45aa58877ef47f9721b9";
let HEX = "0123456789abcdef";

fn require(condition, message) { if not condition { throw message; } }

fn nibble(ch) {
    let i = 0;
    while i < 16 {
        if str_slice(HEX, i, i + 1) == str_lower(ch) { return i; }
        i = i + 1;
    }
    throw "invalid test hex";
}

fn bytes(text) {
    let out = []; let i = 0;
    while i < len(text) {
        array_push(out, nibble(str_slice(text, i, i + 1)) * 16
            + nibble(str_slice(text, i + 1, i + 2)));
        i = i + 2;
    }
    return out;
}

fn source() {
    return RELEASE.source("demo", "1.2.3", "stable", "0.6.0-alpha",
        A, B, C, COMMIT, map{clean_tree:true, reproducible_inputs:true});
}

fn artifact(source_row) {
    return RELEASE.artifact(source_row, "demo-linux", B, 4096, A,
        "1.2.3", "stable", ["linux:x86_64", "linux:aarch64"], map{
            signed_artifact:true, signature_sha256:C, sbom_sha256:D,
            attestation_sha256:A, install_verified:true, upgrade_verified:true,
            rollback_verified:true, uninstall_verified:true});
}

fn signature() {
    return bytes("6a6cd58be58665c24739af4937b0cea5e8dbbc8ce1a87cf492d154b432821533"
        + "8524205149fdf548059edc077eced34b986ac6ca7c6a510a16c283e33f78c002");
}

fn store_text(state, key, key_id, revision) {
    return json_stringify(map{format:TRUST.FORMAT, generation:7,
        publishers:[map{publisher_id:"example-publisher",
            policy_revision:revision, key_id:key_id, algorithm:"ed25519",
            public_key:base64_encode_bytes(key), state:state,
            product:"demo", package_id:"org.example.demo",
            release_channels:["stable"],
            targets:["linux:aarch64", "linux:x86_64"]}]});
}

fn scoped_store_text(product, package_id, channels, targets) {
    return json_stringify(map{format:TRUST.FORMAT, generation:7,
        publishers:[map{publisher_id:"example-publisher", policy_revision:3,
            key_id:KEY_ID, algorithm:"ed25519",
            public_key:base64_encode_bytes(bytes(KEY_HEX)), state:"active",
            product:product, package_id:package_id,
            release_channels:channels, targets:targets}]});
}

fn write_store(root, name, text) {
    let path = root + "/" + name;
    require(SECURE.write_text_new_exclusive(path, text, false, true).ok,
        "trust store fixture publication failed");
    return path;
}

fn attestation(source_row, artifact_row) {
    let policy = RELEASE.publisher_policy("example-publisher", 3, bytes(KEY_HEX));
    return RELEASE.publisher_attestation(source_row, artifact_row, policy,
        "org.example.demo", 42, signature());
}

let root = "/tmp/pblang-publisher-store-"
    + str_slice(sha256(base64_encode_bytes(random_bytes(24))), 0, 24);
let root_created = SECURE.create_private_temporary_directory_new(root);
require(root_created.ok,
    "private test root creation failed: " + json_stringify(root_created));

let path = write_store(root, "trusted.json",
    store_text("active", bytes(KEY_HEX), KEY_ID, 3));
let handle = TRUST.load(path);
require(handle.ok and handle.private_parent_verified
    and handle.immutable_store_snapshot_verified and not handle.raw_keys_exposed
    and handle.current_uid_private_snapshot_verified
    and not handle.path_pinned_by_host
    and not handle.expected_store_digest_pinned
    and not handle.bearer_handle_copy_resistant
    and handle.store_sha256_algorithm == "sha256(raw-bytes)"
    and not str_contains(json_stringify(handle), KEY_HEX),
    "private snapshot loader must return bounded, honest bearer evidence");

let source_row = source(); let artifact_row = artifact(source_row);
let signed = attestation(source_row, artifact_row);
let current = TRUST.verify_current_snapshot(path, source_row, artifact_row, signed);
require(current.ok and current.one_shot_current_path_requested
    and current.one_shot_current_path_verification
    and current.snapshot_cleanup_verified and not current.bearer_handle_issued
    and not current.legacy_handle_registry_used
    and current.legacy_handle_registry_bypassed
    and current.legacy_handle_capacity_independent
    and not current.hostile_caller_capacity_isolation
    and current.configured_store_key_selection_verified
    and current.release_scope_matched
    and current.configured_store_key_signature_verified
    and current.revocation_state_snapshot_applied
    and not current.revocation_freshness_verified
    and not map_has(current, "id")
    and not str_contains(json_stringify(current), KEY_HEX),
    "one-shot verification must close its snapshot without issuing a handle");

let verified = TRUST.verify_attestation(handle, source_row, artifact_row, signed);
require(verified.ok and verified.protected_store_snapshot_verified
    and not verified.operator_trust_anchor_origin_verified
    and not verified.trusted_key_selection_verified
    and verified.configured_store_key_selection_verified
    and verified.release_scope_matched
    and verified.ed25519_signature_verified
    and verified.configured_store_key_signature_verified
    and not verified.trusted_publisher_attestation_verified
    and verified.revocation_state_snapshot_applied
    and not verified.revocation_freshness_verified
    and not verified.artifact_bytes_measured
    and not verified.same_verified_artifact_handoff
    and not verified.rollback_protection_enforced
    and not verified.publisher_authenticity_verified
    and not verified.one_shot_current_path_requested
    and not verified.one_shot_current_path_verification
    and verified.bearer_handle_issued
    and verified.valid_bearer_handle_bound
    and verified.legacy_handle_registry_used
    and not verified.legacy_handle_capacity_independent
    and not verified.authorizes_execution and not verified.production_ready,
    "caller-selected private snapshots must not be inflated into operator trust");

let copied_handle = json_parse(json_stringify(handle));
require(TRUST.verify_attestation(copied_handle, source_row, artifact_row, signed).ok,
    "public handles are explicitly copyable bearer tokens, not opaque VM capabilities");
let forged_handle = map{format:TRUST.HANDLE_FORMAT, id:A};
let forged = TRUST.verify_attestation(forged_handle,
    source_row, artifact_row, signed);
require(not forged.ok and not forged.bearer_handle_issued
    and not forged.valid_bearer_handle_bound
    and forged.legacy_handle_registry_used,
    "well-formed unissued handles must not produce positive bearer evidence");

let current_changed_signature = attestation(source_row, artifact_row);
current_changed_signature.signature[0] = current_changed_signature.signature[0] + 1;
let rejected_current_signature = TRUST.verify_current_snapshot(path,
    source_row, artifact_row, current_changed_signature);
require(not rejected_current_signature.ok
    and rejected_current_signature.one_shot_current_path_requested
    and not rejected_current_signature.one_shot_current_path_verification
    and rejected_current_signature.snapshot_cleanup_verified
    and not rejected_current_signature.configured_store_key_selection_verified
    and not rejected_current_signature.release_scope_matched
    and not rejected_current_signature.ed25519_signature_verified,
    "one-shot modified signatures must close and clear positive evidence");

let current_wrong_scope = attestation(source_row, artifact_row);
current_wrong_scope.release_channel = "nightly";
let rejected_current_scope = TRUST.verify_current_snapshot(path,
    source_row, artifact_row, current_wrong_scope);
require(not rejected_current_scope.ok
    and rejected_current_scope.one_shot_current_path_requested
    and not rejected_current_scope.one_shot_current_path_verification
    and rejected_current_scope.snapshot_cleanup_verified
    and not rejected_current_scope.configured_store_key_selection_verified
    and not rejected_current_scope.release_scope_matched
    and not rejected_current_scope.ed25519_signature_verified,
    "one-shot wrong-scope attestations must clear positive evidence");

let current_wrong_key = attestation(source_row, artifact_row);
current_wrong_key.key_id = A;
let rejected_current_key = TRUST.verify_current_snapshot(path,
    source_row, artifact_row, current_wrong_key);
require(not rejected_current_key.ok
    and rejected_current_key.one_shot_current_path_requested
    and not rejected_current_key.one_shot_current_path_verification
    and rejected_current_key.snapshot_cleanup_verified
    and not rejected_current_key.configured_store_key_selection_verified
    and not rejected_current_key.release_scope_matched
    and not rejected_current_key.ed25519_signature_verified,
    "one-shot wrong-key attestations must clear positive evidence");

// Fill every remaining legacy handle slot. The registry-free one-shot path must
// still work and repeated calls must not consume a slot.
let capacity_handles = [];
let capacity_index = 0;
while capacity_index < TRUST.MAX_OPEN_STORES - 1 {
    let extra = TRUST.load(path);
    require(extra.ok, "legacy handle capacity fixture failed");
    array_push(capacity_handles, extra);
    capacity_index = capacity_index + 1;
}
require(not TRUST.load(path).ok,
    "legacy handle registry must retain its explicit hard capacity");
let independent_first = TRUST.verify_current_snapshot(path,
    source_row, artifact_row, signed);
let independent_second = TRUST.verify_current_snapshot(path,
    source_row, artifact_row, signed);
require(independent_first.ok and independent_second.ok
    and independent_first.legacy_handle_capacity_independent
    and independent_second.legacy_handle_registry_bypassed,
    "one-shot verification must remain independent of legacy handle capacity");
for extra_handle in capacity_handles {
    require(TRUST.close(extra_handle).ok, "legacy capacity fixture close failed");
}

// Replacing the path after load cannot replace the already sealed store bytes.
require(SECURE.remove_file(path).ok, "loaded store fixture removal failed");
write_store(root, "trusted.json", store_text("revoked", bytes(KEY_HEX), KEY_ID, 3));
let stale = TRUST.verify_attestation(handle, source_row, artifact_row, signed);
require(stale.ok and stale.revocation_state_snapshot_applied
    and not stale.revocation_freshness_verified,
    "path replacement cannot refresh revocation state in an existing snapshot");
let current_revoked = TRUST.verify_current_snapshot(root + "/trusted.json",
    source_row, artifact_row, signed);
require(not current_revoked.ok and current_revoked.one_shot_current_path_requested
    and not current_revoked.one_shot_current_path_verification
    and current_revoked.snapshot_cleanup_verified
    and current_revoked.revocation_state_snapshot_applied
    and not current_revoked.configured_store_key_signature_verified
    and not current_revoked.revocation_freshness_verified,
    "one-shot verification must reject revocation present in its opened snapshot");
let refreshed = TRUST.load(root + "/trusted.json");
require(refreshed.ok and not TRUST.verify_attestation(refreshed, source_row,
    artifact_row, signed).ok and TRUST.close(refreshed).ok,
    "a fresh snapshot must apply the replacement store's revoked state");

let changed_signature = attestation(source_row, artifact_row);
changed_signature.signature[0] = changed_signature.signature[0] + 1;
require(not TRUST.verify_attestation(handle, source_row, artifact_row,
    changed_signature).ok, "modified signatures must fail closed");

let wrong_key = attestation(source_row, artifact_row); wrong_key.key_id = A;
require(not TRUST.verify_attestation(handle, source_row, artifact_row, wrong_key).ok,
    "caller-selected keys must not bypass the protected store");
let unknown = attestation(source_row, artifact_row);
unknown.publisher_id = "attacker-controlled-publisher";
require(not TRUST.verify_attestation(handle, source_row, artifact_row, unknown).ok,
    "unknown publishers must not select a trust key");

let product_path = write_store(root, "wrong-product.json",
    scoped_store_text("other-product", "org.example.demo", ["stable"],
        ["linux:aarch64", "linux:x86_64"]));
let product_store = TRUST.load(product_path);
require(product_store.ok and not TRUST.verify_attestation(product_store,
    source_row, artifact_row, signed).ok and TRUST.close(product_store).ok,
    "publisher keys must not cross product scope");
let package_path = write_store(root, "wrong-package.json",
    scoped_store_text("demo", "org.example.other", ["stable"],
        ["linux:aarch64", "linux:x86_64"]));
let package_store = TRUST.load(package_path);
require(package_store.ok and not TRUST.verify_attestation(package_store,
    source_row, artifact_row, signed).ok and TRUST.close(package_store).ok,
    "publisher keys must not cross package scope");
let channel_path = write_store(root, "wrong-channel.json",
    scoped_store_text("demo", "org.example.demo", ["nightly"],
        ["linux:aarch64", "linux:x86_64"]));
let channel_store = TRUST.load(channel_path);
require(channel_store.ok and not TRUST.verify_attestation(channel_store,
    source_row, artifact_row, signed).ok and TRUST.close(channel_store).ok,
    "publisher keys must not cross release-channel scope");
let target_path = write_store(root, "wrong-target.json",
    scoped_store_text("demo", "org.example.demo", ["stable"],
        ["linux:aarch64"]));
let target_store = TRUST.load(target_path);
require(target_store.ok and not TRUST.verify_attestation(target_store,
    source_row, artifact_row, signed).ok and TRUST.close(target_store).ok,
    "publisher keys must not cross target scope");

let revoked_path = write_store(root, "revoked.json",
    store_text("revoked", bytes(KEY_HEX), KEY_ID, 3));
let revoked = TRUST.load(revoked_path);
require(revoked.ok and not TRUST.verify_attestation(revoked, source_row,
    artifact_row, signed).ok, "revoked publisher keys must fail closed");
require(TRUST.close(revoked).ok, "revoked store close failed");

let duplicate_json = "{\"format\":\"" + TRUST.FORMAT + "\","
    + "\"generation\":3,\"generation\":3,\"publishers\":[]}";
let duplicate_path = write_store(root, "duplicate.json", duplicate_json);
require(not TRUST.load(duplicate_path).ok,
    "duplicate or non-canonical JSON fields must be rejected");
let duplicate_current = TRUST.verify_current_snapshot(duplicate_path,
    source_row, artifact_row, signed);
require(not duplicate_current.ok and duplicate_current.snapshot_cleanup_verified
    and duplicate_current.one_shot_current_path_requested
    and not duplicate_current.one_shot_current_path_verification
    and not duplicate_current.configured_store_key_selection_verified
    and not duplicate_current.ed25519_signature_verified,
    "malformed one-shot stores must close and admit no positive evidence");

let nested_duplicate_text = str_replace_all(
    store_text("active", bytes(KEY_HEX), KEY_ID, 3),
    "\"publisher_id\":\"example-publisher\"",
    "\"publisher_id\":\"example-publisher\",\"\\u0070ublisher_id\":\"example-publisher\"");
let nested_duplicate_path = write_store(root, "nested-duplicate.json",
    nested_duplicate_text);
require(not TRUST.load(nested_duplicate_path).ok,
    "escaped-equivalent nested duplicate keys must fail structural preflight");
let trailing_line_path = write_store(root, "trailing-line.json",
    store_text("active", bytes(KEY_HEX), KEY_ID, 3) + "\n");
require(not TRUST.load(trailing_line_path).ok,
    "a second line or trailing newline must fail canonical preflight");
let too_deep_path = write_store(root, "too-deep.json",
    "{\"x\":[[[[[0]]]]]}");
require(not TRUST.load(too_deep_path).ok,
    "JSON deeper than the four-level store ceiling must fail before schema use");
let excessive_items = [];
let excessive_index = 0;
while excessive_index < TRUST.MAX_STORE_ITEMS + 1 {
    array_push(excessive_items, 0); excessive_index = excessive_index + 1;
}
let excessive_items_path = write_store(root, "too-many-items.json",
    json_stringify(map{x:excessive_items}));
require(not TRUST.load(excessive_items_path).ok,
    "JSON above the exact item ceiling must fail before schema use");
let invalid_utf8_path = root + "/invalid-utf8.json";
require(SECURE.write_atomic(invalid_utf8_path, [255], false, true).ok
    and not TRUST.load(invalid_utf8_path).ok,
    "invalid UTF-8 store bytes must fail closed");

let duplicate_row = map{publisher_id:"example-publisher", policy_revision:3,
    key_id:KEY_ID, algorithm:"ed25519",
    public_key:base64_encode_bytes(bytes(KEY_HEX)), state:"active",
    product:"demo", package_id:"org.example.demo", release_channels:["stable"],
    targets:["linux:aarch64", "linux:x86_64"]};
let duplicate_publisher_path = write_store(root, "duplicate-publisher.json",
    json_stringify(map{format:TRUST.FORMAT, generation:7,
        publishers:[duplicate_row, duplicate_row]}));
require(not TRUST.load(duplicate_publisher_path).ok,
    "duplicate publisher and key identifiers must be rejected");

let bad_binding_path = write_store(root, "bad-binding.json",
    store_text("active", bytes(KEY_HEX), A, 3));
require(not TRUST.load(bad_binding_path).ok,
    "key identifiers must be derived from the exact raw public key");

let control_identity = json_parse(store_text("active", bytes(KEY_HEX), KEY_ID, 3));
control_identity.publishers[0].publisher_id = "example\npublisher";
let control_path = write_store(root, "control-identity.json",
    json_stringify(control_identity));
require(not TRUST.load(control_path).ok,
    "control-character publisher identities must be rejected");

let oversized_path = write_store(root, "oversized.json", str_repeat("x", 16385));
require(not TRUST.load(oversized_path).ok,
    "oversized stores must be rejected before parsing");

let shared_path = "/tmp/pblang-publisher-shared-"
    + str_slice(sha256(base64_encode_bytes(random_bytes(24))), 0, 24);
require(SECURE.write_text_new_exclusive(shared_path,
    store_text("active", bytes(KEY_HEX), KEY_ID, 3), false, false).ok,
    "shared-parent fixture publication failed");
require(not TRUST.load(shared_path).ok,
    "stores outside a current-UID-owned mode-0700 parent must be rejected");

let symlink_path = root + "/linked.json";
let linked = try proc_spawn_wait("/bin/ln", ["-s", root + "/trusted.json",
    symlink_path]) catch nil;
require(type(linked) == "map" and linked.exit_code == 0
    and not TRUST.load(symlink_path).ok,
    "symbolic-link trust stores must be rejected by descriptor-relative nofollow open");

require(TRUST.close(handle).ok
    and not TRUST.verify_attestation(handle, source_row, artifact_row, signed).ok,
    "closed opaque handles must be consumed exactly once");
require(not TRUST.close(handle).ok, "trust store handles must not close twice");

require(SECURE.remove_file(root + "/trusted.json").ok
    and SECURE.remove_file(revoked_path).ok
    and SECURE.remove_file(product_path).ok
    and SECURE.remove_file(package_path).ok
    and SECURE.remove_file(channel_path).ok
    and SECURE.remove_file(target_path).ok
    and SECURE.remove_file(duplicate_path).ok
    and SECURE.remove_file(nested_duplicate_path).ok
    and SECURE.remove_file(trailing_line_path).ok
    and SECURE.remove_file(too_deep_path).ok
    and SECURE.remove_file(excessive_items_path).ok
    and SECURE.remove_file(invalid_utf8_path).ok
    and SECURE.remove_file(duplicate_publisher_path).ok
    and SECURE.remove_file(bad_binding_path).ok
    and SECURE.remove_file(control_path).ok
    and SECURE.remove_file(oversized_path).ok
    and SECURE.remove_file(shared_path).ok,
    "publisher store fixture cleanup failed");
let symlink_removed = try proc_spawn_wait("/bin/rm", [symlink_path]) catch nil;
require(type(symlink_removed) == "map" and symlink_removed.exit_code == 0,
    "publisher store symlink fixture cleanup failed");
let removed = try proc_spawn_wait("/bin/rmdir", [root]) catch nil;
require(type(removed) == "map" and removed.exit_code == 0,
    "publisher store private directory cleanup failed");

let status = TRUST.status();
require(status.available == status.protected_store_loading_supported
    and status.available == status.immutable_snapshot_supported
    and not status.operator_trust_anchor_origin_supported
    and not status.host_pinned_path_supported
    and not status.expected_store_digest_pinning_supported
    and status.caller_expected_store_digest_match_supported == status.available
    and status.same_store_snapshot_measure_parse_supported == status.available
    and status.bounded_json_preflight_supported
    and status.store_json_max_lines == TRUST.MAX_STORE_LINES
    and status.store_json_max_depth == TRUST.MAX_STORE_DEPTH
    and status.store_json_max_items == TRUST.MAX_STORE_ITEMS
    and status.store_json_duplicate_keys_rejected
    and not status.revocation_freshness_supported
    and status.one_shot_current_path_verification_supported == status.available
    and status.legacy_handle_capacity_independent_supported == status.available
    and not status.bearer_handle_copy_resistant
    and not status.hostile_caller_capacity_isolation
    and not status.artifact_measurement_supported
    and not status.same_object_handoff_supported
    and not status.rollback_enforcement_supported
    and status.polyglot_contract_available
    and not status.polyglot_adapter_implemented
    and not status.publisher_authenticity_complete
    and not status.production_ready,
    "publisher trust status must preserve the remaining production boundaries: "
        + json_stringify(status));

print "publisher trust store tests passed";
