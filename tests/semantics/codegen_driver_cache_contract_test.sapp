let source = fs_read("tools/pbcodegen_cache.sapp");

fn fail(message) { throw "FAIL codegen_driver_cache_contract: " + message; }
fn require(value, message) { if not value { fail(message); } }

require(str_contains(source, "pblang.codegen-driver-cache.v2"),
    "cache format is versioned");
require(str_contains(source, "LINK.inline_file_prefixed(DRIVER)"),
    "driver and dependencies are linked before bootstrap emission");
require(str_contains(source, "current-command"),
    "the running compiler is preferred over a stale system installation");
require(str_contains(source, "CACHE.valid_x64_elf(binary)"),
    "published driver must emit a structurally valid ELF");
require(str_contains(source, "execution_gate: true"),
    "successful metadata records the execution gate");
require(str_contains(source, "fingerprint = sha256"),
    "cache identity binds linked source and compiler identity");
require(str_contains(source, "compiler_sha256"),
    "cache metadata binds the exact compiler executable");
require(str_contains(source, "_compiler_digest(compiler.path)"),
    "cache lookup fingerprints the current compiler before reuse");
require(str_contains(source, "proc_spawn_wait(\"/usr/bin/sha256sum\", [path])"),
    "compiler hashing uses argv execution without shell interpolation");
require(str_contains(source, "LINK.file_graph_fingerprint"),
    "warm lookup verifies the dependency graph without relinking");
require(str_contains(source, "input_graph_sha256"),
    "cache metadata binds the complete input graph");
require(not str_contains(source, "/usr/local/bin/pblang"),
    "cache builder cannot silently select the stale system compiler");

print "codegen_driver_cache_contract_pass";
