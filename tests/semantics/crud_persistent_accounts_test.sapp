// Synthetic Linux private state, same catalog across restart; no permanent session.
let P=import("stdlib:crud_persistent.sapp");let Web=import("stdlib:crud_preview.sapp");let S=import("stdlib:secure_file.sapp");
fn req(method, path, body="", cookie=""){return map{method:method, path:path, body:body, headers:map{host:"127.0.0.1:8765", origin:"http://127.0.0.1:8765", "content-type":"application/x-www-form-urlencoded", cookie:cookie}};}

fn csrf(page){return str_split(str_split(page.body, "name=\"csrf\" value=\"")[1], "\"")[0];}

fn cookie(page){return str_split(page.headers["Set-Cookie"], ";")[0];}

fn login(app){let page=app.handle(req("GET", "/login"));let response=app.handle(req("POST", "/login", "username=editor&password=Synthetic+password+123%21&csrf=" + csrf(page), cookie(page)));assert(response.status == 303, "login");return cookie(response);}

fn exercise(root){
    let path=root + "/records.pbcrud";P.initialize(path, 10, 2048);
    let catalog=map{editor:"$2b$12$B7w/XX4A/.4otknYJe0OOu69/Zr7IM3viqeA4Jl/tgB9GIcM/mPn."};
    let app=Web.create_persistent_accounts(path, catalog, 8765, 10, 2048);
    assert(app.handle(req("GET", "/")).status == 303, "saved data not public");
    let session=login(app);let home=app.handle(req("GET", "/", "", session));
    assert(home.status == 200 and str_contains(home.body, "Saved on this device"), "authenticated durable home");
    let form="csrf=" + csrf(home) + "&revision=0&id=1&name=Persisted&country=Test&time=1";
    assert(app.handle(req("POST", "/create", form)).status == 403, "unauthenticated mutation rejected");
    assert(app.handle(req("POST", "/create", form, session)).status == 303, "authenticated save");app.close();
    let restarted=Web.create_persistent_accounts(path, catalog, 8765, 10, 2048);
    assert(restarted.handle(req("GET", "/", "", session)).status == 303, "sessions do not survive restart");
    let fresh=login(restarted);let loaded=restarted.handle(req("GET", "/", "", fresh));
    assert(loaded.status == 200 and str_contains(loaded.body, "Persisted") and not str_contains(loaded.body, root), "data survives restart without leaking path");
    let other=P.open(path, 10, 2048);other.update(map{id:1, name:"Changed elsewhere", country:"Test", time:"2"}, 1);other.close();
    assert(str_contains(restarted.handle(req("GET", "/", "", fresh)).body, "Changed elsewhere"), "authenticated refresh");
    assert(restarted.handle(req("POST", "/create", form, fresh)).status == 403, "old session CSRF rejected");
    assert(restarted.handle(req("POST", "/logout", "csrf=" + csrf(loaded), fresh)).status == 303, "logout");
    assert(restarted.handle(req("GET", "/", "", fresh)).status == 303, "saved data protected after logout");restarted.close();
    let text=fs_read(path);let failed=false;try Web.create_persistent_accounts(path, map{invalid:"bad"}) catch {failed=true;};
    assert(failed and fs_read(path) == text, "invalid account startup preserves records");
}
if platform() == "linux" {
    let root="/tmp/pblang-auth-store-" + str_slice(sha256(json_stringify(random_bytes(16))), 0, 24);
    assert(S.create_private_directory_new(root).ok, "private test directory");
    let failed=false;try exercise(root) catch {failed=true;};
    for name in ["records.pbcrud", "records.pbcrud.lock"] {try fs_remove(root + "/" + name) catch nil;}
    assert(S.remove(root).ok, "clean fixture");assert(not failed, "authenticated persistence workflow");
    print "crud_persistent_accounts_pass";
} else {print "crud_persistent_accounts_skip: Linux backend required";}
