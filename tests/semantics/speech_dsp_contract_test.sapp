let DSP=import("stdlib:speech_dsp.sapp");
let PCM=import("stdlib:audio_pcm.sapp");
fn expect(value,message){if not value{throw "FAIL speech DSP: "+message;}}
fn rejected(work){return try { work(); false } catch true;}

let samples=[];for i 1600{array_push(samples,1000+if num_mod(i,40)<20{3000}else{-3000});}
let source=map{format:PCM.FORMAT,sample_rate:16000,channels:1,samples:samples};
let result=DSP.enhance(source,-45,0.35,-3);
expect(result.ok and result.executed and len(result.audio.samples)==len(samples)
    and result.dc_removed and result.smoothed_gate and result.high_pass and result.normalized,
    "enhancement preserves duration and applies every declared stage");
let mean=0;for i len(result.audio.samples){mean=mean+result.audio.samples[i];}
mean=mean/len(result.audio.samples);
expect(num_abs(mean)<100,"DC offset is removed");
expect(rejected(fn(){DSP.enhance(source,-100,0.3,-3);})
    and rejected(fn(){DSP.enhance(source,-45,2,-3);}),
    "unsafe DSP parameters fail closed");
print "speech_dsp_contract_pass";
