let T=import("stdlib:thread.sapp");
let p=T.pipeline([
    map{workers:2,process:fn(x){sleep_ms(10);return x*2;}},
    map{workers:2,process:fn(x){if x==4 {return nil;} return x+1;}}
]);
for repetition 3 {
    let out=p:run([1,2,3]);
    assert(len(out)==2,"all stages complete before return");
    assert((out[0]==3 and out[1]==7) or (out[0]==7 and out[1]==3),"values in completion order");
}
assert(len(p:run([]))==0,"empty input");
let pass=T.pipeline([]);
assert(pass:run([nil,false,3])==[nil,false,3],"zero-stage identity");
let nil_input=T.pipeline([map{workers:8,process:fn(x){if x==nil {return 99;}return x;}}]);
let out=nil_input:run([nil,false]);
assert(len(out)==2,"nil input is data, not shutdown");
assert((out[0]==99 and out[1]==false) or (out[1]==99 and out[0]==false),"false retained");
let config=[map{process:fn(x){return x+1;}}];
let snapshot=T.pipeline(config);
config[0].workers=0;
config[0].process=fn(x){throw "changed";};
assert(snapshot:run([1])==[2],"configuration snapshot");
for invalid in [nil,false,3,"stages",map{}] {
    assert((try {T.pipeline(invalid);false} catch true),"invalid stage collection");
}
for invalid in [nil,false,3,map{},map{process:1}] {
    assert((try {T.pipeline([invalid]);false} catch true),"invalid stage");
}
for workers in [nil,false,"2",0,-1,0.5,num_exp(1000),num_sqrt(-1)] {
    assert((try {T.pipeline([map{process:fn(x){return x;},workers:workers}]);false} catch true),"invalid worker count");
}
for input in [nil,false,3,"input",map{}] {
    assert((try {p:run(input);false} catch true),"invalid input");
}
fn record(effect_sender) {return fn(x){send(effect_sender,true);return x;};}
let effects=channel_buffered(4);
let bad_input=T.pipeline([map{process:record(effects.sender),workers:2}]);
assert((try {bad_input:run([1,fn(){return 1;}]);false} catch true),"reject untransferable input");
assert(channel_size(effects.receiver)==0,"no mapper effects before input transfer succeeds");
channel_close(effects.sender);
fn fail_or_signal(sender, transfer_failure, gate) {
    return fn(v) {
        if v==0 {
            assert(recv_timeout(gate.receiver,1000)==true,"sibling entered");
            if transfer_failure {return fn(){return 1;};}
            throw "private task detail";
        }
        send(gate.sender,true);
        sleep_ms(30);
        send(sender,true);
        return v;
    };
}

for transfer in [false,true] {
    let completed=channel_buffered(1);
    let gate=channel_buffered(1);
    let later=channel_buffered(2);
    let first_task=fail_or_signal(completed.sender,transfer,gate);
    let second_task=record(later.sender);
    let failed=T.pipeline([
        map{workers:2,process:first_task},
        map{process:second_task}
    ]);
    assert((try {T.pipeline_run(failed,[0,1]);false} catch true),"task or result transfer failure propagates");
    let done=recv_timeout(completed.receiver,0);
    let later_count=channel_size(later.receiver);
    channel_close(completed.sender);channel_close(later.sender);channel_close(gate.sender);
    assert(done==true,"sibling finished before throw");
    assert(later_count==0,"later stage never starts after failure");

}
let filtered=T.pipeline([map{process:fn(x){return nil;}},map{process:fn(x){throw "should not run";}}]);
assert(len(filtered:run([1,2]))==0,"empty intermediate stage starts no worker");
assert(snapshot:run([2])==[3],"reusable after unrelated failure");
print "thread_pipeline_ownership_pass";
