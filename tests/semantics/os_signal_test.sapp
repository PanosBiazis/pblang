// tests/semantics/os_signal_test.sapp — OS1-alpha: os signal and env_set tests
import "stdlib:os.sapp";

// Test env_set and env_get round-trip
let key = "PBLANG_TEST_ENV_OS1";
let val = "hello_os1_test_" + "123";
os.env_set(key, val);
let got = os.env_get(key);
if got == val {
    print "os_env_set_get: ok";
} else {
    print "os_env_set_get: FAIL got=" + got;
}

// Test args() returns array
let arg_type = type(os.args());
if arg_type == "array" {
    print "os_args_is_array: ok";
} else {
    print "os_args_is_array: FAIL type=" + arg_type;
}

// Test signal_trap stub (just checks it's callable and returns without crash)
let sig_result = try os.signal_trap("SIGINT", fn(s) { print "signal: " + s; }) catch "error";
// Can be "stub", or nil, or a value - just ensure no crash
print "os_signal_trap_callable: ok";

print "os_env_set_pass";
