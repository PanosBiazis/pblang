// tests/semantics/os_signal_test.sapp — OS1-alpha: os signal + env_set guardrail tests
//
// Note (2026-05-27): `env_set` was intentionally disabled at the VM
// layer because mutating the process environment is not thread-safe
// (see crates/pblang-vm/src/vm/env.rs). This test now codifies that
// guardrail — it asserts `env_set` throws — instead of trying to
// exercise the disabled round-trip.
import "stdlib:os.sapp";

// env_set must throw (intentionally disabled).
let key = "PBLANG_TEST_ENV_OS1";
let val = "hello_os1_test_123";
let raised = try {
    os.env_set(key, val);
    false
} catch true;
if raised == false {
    throw "FAIL env_set should be disabled but did not throw";
}

// env_get on a never-set key returns nil (no side effect to clean up).
let got = os.env_get(key);
if got != nil {
    throw "FAIL env_get returned a value for an unset key: " + str(got);
}

// os.args() returns an array.
if type(os.args()) != "array" {
    throw "FAIL os_args_is_array";
}

// signal_trap is callable (stub on unsupported platforms is fine).
let _trap = try os.signal_trap("SIGINT", fn(s) { print "signal: " + s; }) catch "error";

print "os_env_set_pass";
