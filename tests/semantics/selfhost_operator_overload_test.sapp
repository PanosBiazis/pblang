// Test: the SELF-HOSTED VM (stdlib/compiler/vm.sapp) now dispatches OPERATOR
// OVERLOADING — the last major parity item with the Rust frontend (§51). The
// arithmetic/comparison opcodes keep their native fast path and, only when a map
// operand carries the dunder, dispatch the method (forward `a.__op__(a,b)` then
// reflected `b.__rop__(b,a)`), walking the `__class` chain so class instances
// conform too. Now possible because closures execute (§58).
//
// Implemented entirely in pblang (vm.sapp helpers _op_*/
// _lookup_member/_call_method).

let fe = import("stdlib/compiler/selfhost_frontend.sapp");

// --- Plain-map vector with arithmetic + comparison dunders ---
let vsrc = "fn vec(x, y) { return map{ x: x, y: y, "
    + "__add__: fn(self, o) { return vec(self.x + o.x, self.y + o.y); }, "
    + "__sub__: fn(self, o) { return vec(self.x - o.x, self.y - o.y); }, "
    + "__mul__: fn(self, k) { return vec(self.x * k, self.y * k); }, "
    + "__rmul__: fn(self, k) { return vec(self.x * k, self.y * k); }, "
    + "__rsub__: fn(self, k) { return vec(k - self.x, k - self.y); }, "
    + "__eq__: fn(self, o) { return self.x == o.x and self.y == o.y; }, "
    + "__lt__: fn(self, o) { return (self.x*self.x + self.y*self.y) < (o.x*o.x + o.y*o.y); } "
    + "}; } ";

let src1 = vsrc
    + "let a = vec(1, 2); let b = vec(3, 4); "
    + "let s = a + b; let sx = s.x; let sy = s.y; "   // 4, 6
    + "let d = b - a; let dx = d.x; "                  // 2
    + "let m = a * 10; let mx = m.x; "                 // 10 (forward __mul__)
    + "let r = 10 * a; let rx = r.x; "                 // 10 (reflected __rmul__)
    + "let neg = -a; let nx = neg.x; "                 // -1 (via __rsub__; -a == 0 - a)
    + "let eq = a == vec(1, 2); "                      // true
    + "let lt = a < b; "                               // true (forward __lt__)
    + "let gt = b > a;";                               // true (reflected __lt__)

let r1 = fe.frontend_run(src1);
assert(r1.ok == true, "self-hosted operator-overload program compiles+runs");
assert(r1.globals["sx"] == 4 and r1.globals["sy"] == 6, "self-hosted vec + vec via __add__");
assert(r1.globals["dx"] == 2, "self-hosted vec - vec via __sub__");
assert(r1.globals["mx"] == 10, "self-hosted vec * scalar via forward __mul__");
assert(r1.globals["rx"] == 10, "self-hosted scalar * vec via reflected __rmul__");
assert(r1.globals["nx"] == 0 - 1, "self-hosted -vec via __rsub__ (0 - vec)");
assert(r1.globals["eq"] == true, "self-hosted == via __eq__");
assert(r1.globals["lt"] == true, "self-hosted < via __lt__");
assert(r1.globals["gt"] == true, "self-hosted > via reflected __lt__");

// --- Native fast paths must be untouched ---
let src2 = "let a = 2 + 3; let b = 10 - 4; let c = 6 * 7; let d = 20 / 5; let e = 17 % 5; "
    + "let f = 5 == 5; let g = 3 < 7; let h = (\"ab\" + \"cd\");";
let r2 = fe.frontend_run(src2);
assert(r2.globals["a"] == 5 and r2.globals["b"] == 6 and r2.globals["c"] == 42, "self-hosted numeric +/-/* fast path");
assert(r2.globals["d"] == 4 and r2.globals["e"] == 2, "self-hosted numeric / and % fast path");
assert(r2.globals["f"] == true and r2.globals["g"] == true, "self-hosted numeric ==/< fast path");
assert(r2.globals["h"] == "abcd", "self-hosted string + concat fast path");

// --- Operator overloading on native CLASS instances (via __class chain) ---
let src3 = "class Money { fn init(self, c) { self.c = c; } "
    + "fn __add__(self, o) { return Money:new(self.c + o.c); } "
    + "fn __lt__(self, o) { return self.c < o.c; } "
    + "fn __eq__(self, o) { return self.c == o.c; } } "
    + "let p = Money:new(150); let q = Money:new(99); "
    + "let sum = p + q; let sc = sum.c; "      // 249
    + "let lt = q < p; "                        // true
    + "let eq = p == Money:new(150);";          // true

let r3 = fe.frontend_run(src3);
assert(r3.ok == true, "self-hosted class-instance operator overload compiles+runs");
assert(r3.globals["sc"] == 249, "self-hosted Money + Money via __class __add__");
assert(r3.globals["lt"] == true, "self-hosted Money < Money via __class __lt__");
assert(r3.globals["eq"] == true, "self-hosted Money == Money via __class __eq__");

// --- Opt-in: a map without dunders keeps structural == and is not "overloaded" ---
let src4 = "let m1 = map{ a: 1, b: 2 }; let m2 = map{ a: 1, b: 2 }; let m3 = map{ a: 9 }; "
    + "let same = m1 == m2; let diff = m1 == m3;";
let r4 = fe.frontend_run(src4);
assert(r4.globals["same"] == true, "self-hosted structural map == preserved (no __eq__)");
assert(r4.globals["diff"] == false, "self-hosted structural map != preserved");

print "selfhost_operator_overload_pass";
