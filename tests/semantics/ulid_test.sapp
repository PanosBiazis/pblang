// tests/semantics/ulid_test.sapp — time-sortable ULID library.

let U = import("stdlib/ulid.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let id = U.new();
eq(len(id), 26, "ULID is 26 chars");
if not U.is_valid(id) { fail("new() is valid: " + id); }
if U.is_valid("short") { fail("wrong length invalid"); }
if U.is_valid("01ARZ3NDEKTSV4RRFFQ69G5FAI") { fail("char I (not in Crockford) invalid"); }

// timestamp round-trips and reflects "now"
let before = now_ms();
let id2 = U.new();
let after = now_ms();
let ts = U.timestamp(id2);
if ts < before - 2000 or ts > after + 2000 { fail("timestamp ~ now: ts=" + str(ts)); }

// from_time encodes a specific time exactly
let fixed = U.from_time(1469918176385);
eq(U.timestamp(fixed), 1469918176385, "from_time round-trips the timestamp");

// time-ordering: an earlier-time ULID decodes to a smaller timestamp than a later one
// (big-endian base32 makes the string ordering match this — pblang lacks string '<', so
// we verify the monotonic property via the decoded numeric timestamps).
let early = U.from_time(1000000000000);
let late = U.from_time(2000000000000);
if not (U.timestamp(early) < U.timestamp(late)) { fail("earlier ULID < later ULID by time"); }

// two ULIDs at the same instant differ (random section)
if U.from_time(1000) == U.from_time(1000) { fail("same-time ULIDs should differ (randomness)"); }

print "ulid_pass";
