let Pages=import("../../examples/declarative_browser/pages.sapp");
let App=import("../../examples/declarative_browser/app.sapp");
let Session=import("stdlib:browser_session.sapp");let D=import("stdlib:browser_document.sapp");
let count=0;fn check(ok,label) {assert(ok,label);count=count+1;}
// Independent pre-extraction content oracle: built-in HTML must not change.
fn original_pages() {
    return map{
        "pb://home":"<article><h1>PBLang document browser</h1><p>Local documents. Shared graphics. Explicit permissions.</p><h2>Start exploring</h2><a href=\"pb://guide\">Open the guide</a><a href=\"pb://about\">About this browser</a></article>",
        "pb://guide":"<article><h1>Guide — Οδηγός</h1><p>Edit a small HTML document or create the same interface in PBLang. Text and local links round-trip through the shared UI document.</p><p>Use Back, Forward and Home. No scripts, downloads or remote pages execute.</p><a href=\"pb://about\">Read the boundaries</a><a href=\"pb://home\">Return home</a></article>",
        "pb://about":"<article><h1>Explicit boundaries</h1><p>This is an offline declarative document browser. It is not a general web engine, authentication service, Tor client or antivirus.</p><p>Web and Android previews share text and destination inspection. Native navigation belongs to this local session.</p><a href=\"pb://home\">Return home</a></article>"};
}


let expected=original_pages();check(Pages.pages()==expected,"shared pages preserve exact old content");
check(App.pages()==expected,"App.pages public API preserves content");
let first=Pages.pages();first["pb://home"]="changed";map_remove(first,"pb://guide");
check(Pages.pages()==expected,"shared pages return detached fresh maps");
let legacy=App.pages();legacy["pb://about"]="changed";
check(App.pages()==expected and Pages.pages()==expected,"App pages do not mutate shared state");
let session=Session.create(Pages.pages());check(session.follow(2).url=="pb://guide","same default navigation");
check(session.back().url=="pb://home","same history behavior");
for address in map_keys(expected) {let doc=D.import_html(expected[address]);check(D.import_html(D.export_html(doc))==doc,"same document roundtrip");}
session.close();print "reader_pages_pass checks="+str(count);
