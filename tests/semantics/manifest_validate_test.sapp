let mv = import("stdlib:manifest_validate.sapp");

let good = "[package]\nname = \"demo\"\nversion = \"0.1.0\"\nentry = \"main.sapp\"\n";
let r1 = mv.validate_manifest_text(good);
if not r1.ok { print "manifest_validate_fail_good"; }
if r1.package.name != "demo" { print "manifest_validate_fail_name"; }

let bad = "[package]\nname = \"demo\"\nversion = \"abc\"\n";
let r2 = mv.validate_manifest_text(bad);
if r2.ok { print "manifest_validate_fail_bad_ok"; }
if len(r2.errors) == 0 { print "manifest_validate_fail_bad_errors"; }

let qualified = "[package]\nname = \"demo\"\nversion = \"0.1.0\"\n"
    + "release_channel = \"Beta.2\"\nshow_release_channel = true\n"
    + "release_channel_in_artifact = true\n";
let r3 = mv.validate_manifest_text(qualified);
if not r3.ok { print "manifest_validate_fail_release_channel"; }
if r3.package.release_channel != "Beta.2" { print "manifest_validate_fail_release_channel_retained"; }
if r3.package.display_version != "0.1.0-beta.2" { print "manifest_validate_fail_display_version"; }
if r3.package.artifact_suffix != "-beta.2" { print "manifest_validate_fail_artifact_suffix"; }

let invalid_channel = "[package]\nname = \"demo\"\nversion = \"0.1.0\"\nrelease_channel = \"bad channel!\"\n";
if mv.validate_manifest_text(invalid_channel).ok { print "manifest_validate_fail_invalid_channel"; }

print "manifest_validate_pass";
