let mv = import("stdlib:manifest_validate.sapp");

let good = "[package]\nname = \"demo\"\nversion = \"0.1.0\"\nentry = \"main.sapp\"\n";
let r1 = mv.validate_manifest_text(good);
if r1.ok != true { print "manifest_validate_fail_good"; }
if r1.package.name != "demo" { print "manifest_validate_fail_name"; }

let bad = "[package]\nname = \"demo\"\nversion = \"abc\"\n";
let r2 = mv.validate_manifest_text(bad);
if r2.ok == true { print "manifest_validate_fail_bad_ok"; }
if len(r2.errors) == 0 { print "manifest_validate_fail_bad_errors"; }

print "manifest_validate_pass";
