let mv = import("stdlib:manifest_validate.sapp");
fn require(value, message) { if not value { throw "FAIL manifest_validate: " + message; } }

let good = "[package]\nname = \"demo\"\nversion = \"0.1.0\"\nentry = \"main.sapp\"\n";
let r1 = mv.validate_manifest_text(good);
require(r1.ok and r1.package.name == "demo", "basic manifest");

let bad = "[package]\nname = \"demo\"\nversion = \"abc\"\n";
let r2 = mv.validate_manifest_text(bad);
require(not r2.ok and len(r2.errors) > 0, "invalid version returns diagnostics");

let qualified = "[package]\nname = \"demo\"\nversion = \"0.1.0\"\n"
    + "release_channel = \"Beta.2\"\nshow_release_channel = true\n"
    + "release_channel_in_artifact = true\n";
let r3 = mv.validate_manifest_text(qualified);
require(r3.ok and r3.package.release_channel == "Beta.2", "release channel is retained as source metadata");
require(r3.package.display_version == "0.1.0 [beta.2]"
    and r3.package.artifact_suffix == "--channel-beta.2", "channel uses non-SemVer display/artifact labels");
require(r3.package.exact_version_identity == "0.1.0" and r3.package.version_is_independent
    and not r3.package.channel_changes_package_identity, "exact version identity is independent");

let invalid_channel = "[package]\nname = \"demo\"\nversion = \"0.1.0\"\nrelease_channel = \"bad channel!\"\n";
require(not mv.validate_manifest_text(invalid_channel).ok, "invalid channel");

for valid in ["0.5.0-alpha", "0.5.0-alpha.1+build.001", "0.5.0-0", "0.5.0+001"] {
    let result = mv.validate_manifest_text("[package]\nname = \"demo\"\nversion = \"" + valid + "\"\n");
    require(result.ok and result.package.version == valid
        and result.package.exact_version_identity == valid, "valid exact SemVer " + valid);
}

for invalid in ["0.5", "0.5.0.1", "v0.5.0", " 0.5.0", "0.5.0 ", "0 .5.0",
    "00.5.0", "0.05.0", "0.5.00", "0.5.0-", "0.5.0+", "0.5.0-alpha..1",
    "0.5.0-.alpha", "0.5.0-alpha.", "0.5.0-01", "0.5.0-alpha_beta",
    "0.5.0-alpha/one", "0.5.0-alpha%one", "0.5.0+one+two", "9007199254740992.0.0"] {
    require(not mv.validate_manifest_text("[package]\nname = \"demo\"\nversion = \"" + invalid + "\"\n").ok,
        "reject malformed SemVer");
}

let duplicate = "[package]\nname = \"demo\"\nversion = \"1.0.0\"\nversion = \"2.0.0\"\n";
require(not mv.validate_manifest_text(duplicate).ok, "duplicate package version fails closed");
let comment_spoof = "# version = \"9.9.9\"\n[package]\nname = \"demo\"\n";
require(not mv.validate_manifest_text(comment_spoof).ok, "comment cannot supply package version");
let section_spoof = "[metadata]\nversion = \"9.9.9\"\n[package]\nname = \"demo\"\n";
require(not mv.validate_manifest_text(section_spoof).ok, "other section cannot supply package version");
let duplicate_section = "[package]\nname = \"demo\"\nversion = \"1.0.0\"\n[package]\nentry = \"main.sapp\"\n";
require(not mv.validate_manifest_text(duplicate_section).ok, "duplicate package section fails closed");
for invalid_name in ["../escape", "a..b", "a/b", "a\\b", ".", "name\"break"] {
    require(not mv.validate_manifest_text("[package]\nname = \"" + invalid_name + "\"\nversion = \"1.0.0\"\n").ok,
        "unsafe package name rejected");
}

let prerelease_channel = mv.validate_manifest_text("[package]\nname = \"demo\"\n"
    + "version = \"0.5.0-alpha\"\nrelease_channel = \"stable\"\n");
require(prerelease_channel.ok and prerelease_channel.package.contradictory_stability,
    "contradictory stability is explicit for downstream publish policy");

print "manifest_validate_pass";
