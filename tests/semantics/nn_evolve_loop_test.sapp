// tests/semantics/nn_evolve_loop_test.sapp — the evolutionary self-hardening trainer:
// densify -> fork clones -> adversarial/curious-train variants -> safe_merge winner ->
// jenga trim -> nail/restore checkpoint. The champion's loss is monotone non-increasing,
// so the loop can never destroy the model (never-worse-than-start guarantee).

let nn = import("stdlib/nn.sapp");
let evo = import("stdlib/nn_evolve.sapp");

fn fail(m) { throw "FAIL " + m; }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.00001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn veq(a, b, m) { let i = 0; while i < len(a) { approx(a[i], b[i], m); i = i + 1; } }

let data = [ nn.sample([0, 0], [0]), nn.sample([0, 1], [1]), nn.sample([1, 0], [1]), nn.sample([1, 1], [0]) ];
let net = nn.mlp_new(2, 3, 1, 7);
let x = [1, 0];
let y0 = nn.predict(net, x);

let ev = evo.evolve(net, data, map{ generations: 3, pop: 2, epochs: 40, lr: 0.5, epsilon: 0.15, tol: 0.02, grow: true });

// ── never-destroy: the evolved net is never worse on clean data than the start ─────
if nn.loss(ev.net, data) > ev.start_loss + 0.00001 { fail("evolve must not increase loss (got " + str(nn.loss(ev.net, data)) + " vs start " + str(ev.start_loss) + ")"); }

// ── it actually learns: better than the untrained baseline ────────────────────────
if nn.loss(ev.net, data) >= ev.start_loss { fail("evolve should improve a learnable task"); }

// ── it reports what it did ────────────────────────────────────────────────────────
if ev.generations != 3 { fail("generations reported"); }
if ev.grew < 0 or ev.merges < 0 or ev.trims < 0 { fail("evolve reports grew/merges/trims counts"); }

// ── the original network is untouched (everything runs on clones) ─────────────────
veq(nn.predict(net, x), y0, "evolve leaves the original net intact");

// ── the result is a valid, usable network ─────────────────────────────────────────
if ev.net.l1.n_out < 1 { fail("evolved net has a hidden layer"); }
if len(nn.predict(ev.net, x)) != 1 { fail("evolved net still predicts"); }

print "nn_evolve_loop_pass";
