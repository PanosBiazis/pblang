let C=import("stdlib:pbai_curriculum.sapp");
fn rejects(f) {return try {f();false} catch true;}
fn copy(x) {return json_parse(json_stringify(x));}
assert(not rejects(fn(){return 1;}) and rejects(fn(){throw "expected";}),"calibrated helper");
let families=[map{family:"copy",split:"training",examples:[map{x:[0],y:0}]},
 map{family:"sum",split:"validation",examples:[map{x:[1],y:1}]},map{family:"difference",split:"test",examples:[map{x:[2],y:2}]}];
let tasks=copy(families);for group in tasks {group.family="copy";}
let transfer=C.prepare(8,3,families);let known=C.prepare_known_tasks(8,3,tasks);
assert(transfer.report.declared_family_disjointness_checked and not known.report.declared_family_disjointness_checked,"different evaluation claims");
assert(known.report.same_declared_families_in_all_splits and known.report.exact_context_disjointness_checked,"known task coverage and disjoint inputs");
assert(known.report.format=="pbai.curriculum.known-task-split.v1" and transfer.report.format=="pbai.curriculum.split.v1","explicit formats");
assert(not known.report.independent_provenance_verified and not known.report.semantic_family_identity_verified and not known.report.authorizes_activation,"no provenance or activation claim");
assert(rejects(fn(){C.prepare(8,3,tasks);}) and rejects(fn(){C.prepare_known_tasks(8,3,families);}),"modes cannot silently interchange");
let saved=json_stringify(known);tasks[0].examples[0].x[0]=7;tasks[2].examples[0].y=7;
assert(saved==json_stringify(known),"detached input ownership");
tasks=copy(families);for group in tasks {group.family="copy";}
let reordered=[map{examples:[map{y:-0.0,x:[-0.0]}],split:"training",family:"copy"},tasks[1],tasks[2]];
assert(C.prepare_known_tasks(8,3,reordered).report.snapshot_digest==known.report.snapshot_digest,"field order and signed zero canonicalization");
let changed=copy(tasks);changed[2].examples[0].y=3;
assert(C.prepare_known_tasks(8,3,changed).report.snapshot_digest!=known.report.snapshot_digest,"final labels bind snapshot");
changed=copy(tasks);changed[2].examples[0].x=[-0.0];changed[2].examples[0].y=3;
assert(rejects(fn(){C.prepare_known_tasks(8,3,changed);}),"changed label cannot hide repeated context");
changed=copy(tasks);push(changed,map{family:"copy",split:"training",examples:[map{x:[3],y:3}]});
assert(rejects(fn(){C.prepare_known_tasks(8,3,changed);}),"repeated family/split rejected even for distinct inputs");
changed=copy(tasks);changed[2].family="new";
assert(rejects(fn(){C.prepare_known_tasks(8,3,changed);}),"every family must occur in each split");
let maximum=[];for split in ["training","validation","test"] {for family 4 {
 let marker=0;if split=="validation" {marker=1;}if split=="test" {marker=2;}
 let examples=[];for i 8 {push(examples,map{x:[marker,family,i],y:i});}
 push(maximum,map{family:"f-"+str(family),split:split,examples:examples});
}}
let boundary=C.prepare_known_tasks(8,3,maximum);
assert(boundary.report.training_examples==32 and boundary.report.validation_examples==32 and boundary.report.test_examples==32,"exact 96-example boundary");
changed=copy(maximum);push(changed[0].examples,map{x:[7,7,7],y:0});
assert(rejects(fn(){C.prepare_known_tasks(8,3,changed);}),"33 examples in one split rejected");
changed=copy(maximum);push(changed,map{family:"overflow",split:"test",examples:[map{x:[7],y:0}]});
assert(rejects(fn(){C.prepare_known_tasks(8,3,changed);}),"13 groups rejected");
let zero=len([]);
for bad in [nil,true,[],map{},[tasks[0],tasks[1]]] {assert(rejects(fn(){C.prepare_known_tasks(8,3,bad);}),"group container/count bounds");}
for bad in [nil,true,0,1.5,257,0/zero,1/zero] {assert(rejects(fn(){C.prepare_known_tasks(bad,3,tasks);}),"vocabulary bounds");}
for bad in [nil,true,0,1.5,17,0/zero,1/zero] {assert(rejects(fn(){C.prepare_known_tasks(8,bad,tasks);}),"context bounds");}
for bad in [nil,true,"","A","a/b","a b","α",str_repeat("a",49)] {
 changed=copy(tasks);changed[0].family=bad;assert(rejects(fn(){C.prepare_known_tasks(8,3,changed);}),"identifier bounds");
}
for bad in [nil,true,map{},map{family:"copy",split:"test",examples:[]},map{family:"copy",split:"test",examples:[],extra:true}] {
 changed=copy(tasks);changed[2]=bad;assert(rejects(fn(){C.prepare_known_tasks(8,3,changed);}),"exact group schema");
}
for bad in [map{x:[],y:0},map{x:[0,1,2,3],y:0},map{x:[8],y:0},map{x:[true],y:0},map{x:[0/zero],y:0},
 map{x:[2],y:8},map{x:[2],y:1/zero},map{x:[2],y:0.5},map{x:[2]},map{x:[2],y:0,extra:true}] {
 changed=copy(tasks);changed[2].examples=[bad];assert(rejects(fn(){C.prepare_known_tasks(8,3,changed);}),"malformed examples");
}
let wide=map{};for i 1025 {wide["extra-"+str(i)]=i;}
changed=copy(tasks);changed[2]=wide;
assert(rejects(fn(){C.prepare_known_tasks(8,3,changed);}),"wide maps rejected before key enumeration");
changed=copy(tasks);changed[2].examples[0].x=[changed];
assert(rejects(fn(){C.prepare_known_tasks(8,3,changed);}),"cyclic nested input rejected by scalar schema");
let report=json_stringify(known.report);
assert(not str_contains(report,"\"x\"") and not str_contains(report,"\"y\""),"aggregate report excludes raw examples");
// The helper returns caller-owned mutable rows; revalidation is required after editing.
known.training[0].x[0]=6;assert(known.report.snapshot_digest==C.prepare_known_tasks(8,3,tasks).report.snapshot_digest,"snapshot identity is not a live mutable certificate");
print "pbai_curriculum_contracts_pass";
