let D=import("stdlib:text_document.sapp");let C=import("stdlib:document_compare.sapp");let V=import("stdlib:document_compare_view.sapp");let UI=import("stdlib:modern_ui.sapp");let GUI=import("stdlib:gui.sapp");
let a=D.from_text("Alpha\nBeta\nGamma","Before");let b=D.insert_block(a,1,"bullet","New");b.title="After";let r=C.compare(a,b);
assert(r.equal==3 and r.inserted==1 and r.deleted==0 and r.title_changed,"insertion does not shift changes");assert(r.entries[0].kind=="title","title separately visible");
let old=D.encode(a);r.entries[1].block.text="mutated";assert(D.encode(a)==old,"detached results");
let k=D.set_block(a,1,"heading","Beta");assert(C.compare(a,k).inserted==1 and C.compare(a,k).deleted==1,"kind matters");
let ws=D.set_block(a,1,"paragraph","Beta ");assert(not C.compare(a,ws).identical,"whitespace literal");assert(C.compare(a,D.decode(D.encode(a))).identical,"roundtrip identity");
assert(json_parse(C.encode(a,b)).format==C.FORMAT,"report serialized");assert((try C.compare(map{},b) catch nil)==nil,"invalid document");
let long=D.set_block(D.create(),0,"paragraph",str_repeat("界",300));let form=UI.build("Compare",V.create(long,long),map{width:412,height:915});GUI.get(form,"part_1").onclick(form);assert(GUI.get(form,"position").text=="Part 2 / 3","portable selection");
let fragments=V.fragments(C.compare(long,long).entries[0]);let joined="";for part in fragments{for line in part{joined=joined+line;}}assert(joined==long.blocks[0].text,"complete CJK text");
let newlines=D.set_block(D.create(),0,"paragraph",str_repeat("\n",1024));let report=C.compare(newlines,newlines);assert(len(V.fragments(report.entries[0]))==171,"all empty lines paginated");
for target in ["native","web","android"]{assert(len(UI.compile(V.create(newlines,newlines,0,21),map{target:target,width:412,height:915}).records)>0,"last group supported");}
assert((try V.create(a,b,-1) catch nil)==nil and (try V.create(a,b,0,1) catch nil)==nil,"index bounds");
let maxleft=D.create(str_repeat("a",256));let maxright=D.create(str_repeat("b",256));maxleft.blocks=[];maxright.blocks=[];
for i in range(0,64){array_push(maxleft.blocks,map{kind:"paragraph",text:"L"+str_repeat("\u0001",500)});array_push(maxright.blocks,map{kind:"paragraph",text:"R"+str_repeat("\u0002",500)});}
let maxreport=json_parse(C.encode(maxleft,maxright));assert(len(maxreport.entries)==129 and maxreport.inserted==64 and maxreport.deleted==64,"maximum escaped report encodes without truncation");
print "document_compare_pass";
