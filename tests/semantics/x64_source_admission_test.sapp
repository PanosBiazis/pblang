let X = import("stdlib/native/codegen_x64.sapp");
fn rejects(work) { return try { work(); false } catch true; }
let compilers = [X.compile_expr_exit, X.compile_program, X.compile_fns, X.compile_safe];
for source in ["7; /* unfinished", "7; let s=\"unfinished", "fn main(){return 7;",
    "fn f(x=){return 1;} return f(2);", "let x:=1;return x;", "7; let x=0x;",
    "let x=1private_canary;return x;", "7; @private_canary"] {
    for compile in compilers {
        assert(rejects(fn() { compile(source); }), "no x64 bytes or result for rejected source");
    }
}
for source in [str_repeat(" ", 1048576) + "7;", "/*" + str_repeat("😀", 262144) + "*/7;",
    str_repeat("//\n", 65536) + "7;"] {
    for compile in compilers { assert(rejects(fn() { compile(source); }), "hard source/token caps on every public route"); }
}
let exact = "/*" + str_repeat(" ", 1048576 - 6) + "*/7;";
for compile in compilers { assert(not rejects(fn() { compile(exact); }), "inclusive hard source cap"); }
assert(len(X.compile_expr_exit("(2+3)*4; // complete")) > 120, "expression positive after failures");
assert(len(X.compile_program("let x=1 return x;")) > 120, "optional semicolon retained");
for source in ["return 7;", "fn twice(n){return n*2;} return twice(7);",
    "let words=str_split(\"a,b\",\",\"); return len(words);",
    "let m=map{a:7}; return m[\"a\"];", "return parse_number(\"17\");", "return 2**3;"] {
    assert(len(X.compile_fns(source)) > 120, "functions and internal prelude remain supported");
    let result = X.compile_safe(source);
    assert(result.safe and len(result.binary) > 120, "legacy result still returned");
}
print "x64_source_admission_pass";
