let C=import("stdlib:file_catalog.sapp");
fn rejected(value) {return try {C.classify(value);false} catch true;}
for path in ["private/main.py","C:\\private\\main.py","C:main.py","\\\\host\\share\\main.py","mixed\\private/main.py"] {
 let row=C.classify(path);assert(row.name=="main.py" and row.label=="Python Source","portable basename");
 let summary=C.summarize([path],map{include_names:true});
 assert(summary.classified_items[0].name=="main.py","only basename disclosed");
 assert(not str_contains(str(summary),"private") and not str_contains(str(summary),"host"),"directory segments absent");
 let aggregate=C.summarize([path]);assert(not aggregate.names_included and aggregate.classified_items==[],"aggregate privacy");
}
for path in ["C:\\private\\", "private/", "C:",".","..","private/.","private/..","",42,nil] {
 assert(rejected(path),"invalid or directory-only input rejected");
}
assert(C.classify("C:\\ιδιωτικό\\δείγμα.SAPP").name=="δείγμα.SAPP","Unicode basename");
assert(C.classify(".sapp").known and C.classify(".gitignore").known,"dotfiles");
assert(C.classify("a:b.py").name=="b.py","drive-relative metadata semantics");
assert(rejected(str_repeat("x",4097)),"existing name bound preserved");
for path in ["scheme:main.py","1:main.py"] {assert(C.classify(path).name==path,"non-drive colon retained");}
assert(C.classify("dir/C:main.py").name=="C:main.py","drive syntax only at original start");
assert(C.classify("c:.gitignore").family=="configuration","drive relative special file");
assert(C.classify("//nested///main.py").name=="main.py","repeated separators");
for size in [62,63,64,65,126,127,128,129,254,255,256,257,1024,2048,4080] {
 for unit in ["a","δ"] {
  let name=str_repeat(unit,size-3)+".py";
  for prefix in ["private/","private\\","mixed\\dir/"] {
   let row=C.classify(prefix+name);
   assert(row.name==name and row.label=="Python Source","tail boundary and full-name fallback");
  }
 }
}
print "file_catalog_portable_pass";
