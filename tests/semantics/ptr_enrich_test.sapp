// tests/semantics/ptr_enrich_test.sapp — enrichment for stdlib/ptr.sapp

let P = import("stdlib/ptr.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let p = P.new(5);
eq(P.update(p, fn(x) { return x + 1; }), 6, "update returns new value");
eq(P.get(p), 6, "update mutates the box");

let c = P.clone(p);
P.set(c, 99);
eq(P.get(p), 6, "clone is independent");
eq(P.get(c), 99, "clone holds its own value");

if not P.is_ptr(P.new(1)) { fail("a box is a ptr"); }
if P.is_ptr(map{ x: 1 }) { fail("map without v is not a ptr"); }
if P.is_ptr(5) { fail("scalar is not a ptr"); }

print "ptr_enrich_pass";
