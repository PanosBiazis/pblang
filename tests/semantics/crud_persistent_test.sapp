let P = import("stdlib:crud_persistent.sapp");
let R = import("stdlib:crud_records.sapp");
fn denied(action) { let failed=false; try action() catch {failed=true;}; return failed; }
assert(not denied(fn(){return true;}), "helper accepts success");
let row = map{id:7,name:"Δοκιμή & <script>",country:"Example",time:"01:02"};
let source = map{revision:5,rows:[row]};
let restored = R.create(2, source); row.name="changed";
assert(restored.list().rows[0].name != row.name, "snapshot import detached");
let copy = restored.snapshot(); copy.rows[0].name="changed";
assert(restored.snapshot().rows[0].name != "changed", "snapshot export detached");
let encoded = P.encode(restored.snapshot());
assert(P.decode(encoded).rows == restored.snapshot().rows, "Unicode and escaped text round trip");
assert(P.decode(encoded).revision == 5, "revision restored exactly");
for text in ["", "{}", "PBLANG-CRUD-2\t0", "PBLANG-CRUD-1\t01",
    "PBLANG-CRUD-1\t0\n1\ta\tb\tc", "PBLANG-CRUD-1\t1\n",
    "PBLANG-CRUD-1\t1\n1\t%FF\tb\tc", "PBLANG-CRUD-1\t1\n1\t%00\tb\tc",
    "PBLANG-CRUD-1\t1\n1\t%\tb\tc", "PBLANG-CRUD-1\t2\n1\ta\tb\tc\n1\ta\tb\tc",
    "PBLANG-CRUD-1\t1\n1\ta\tb\tc\textra"] {
    assert(denied(fn(){P.decode(text);}), "malformed snapshot denied");
}
assert(denied(fn(){P.decode(encoded, 2, 64);}), "read byte budget");
assert(denied(fn(){P.encode(restored.snapshot(),64);}), "write byte budget");
assert(denied(fn(){R.create(1,map{revision:2,rows:[row,row]});}), "restore capacity");
assert(denied(fn(){R.create(2,map{revision:0,rows:[row]});}), "impossible revision");
assert(denied(fn(){R.create(2,map{revision:1,rows:[row],extra:true});}), "unknown envelope fields");
restored.close();assert(denied(fn(){restored.snapshot();}), "closed snapshot");
print "crud_persistent_codec_pass";
