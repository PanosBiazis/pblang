// Pure simulated clocks: no wall-clock waits, device I/O or host effects.
let D = import("stdlib:device_emulator.sapp");
let P = import("stdlib:platform_emulator.sapp");
let profile = D.resolve("microcontroller", "freertos", "11", "avr", map{ memory_bytes: 32 });
let m = D.machine(profile);
assert(D.tick(m) == 1 and m.platform.clock_ms == 1, "default advances both clocks");
assert(D.tick(m, 0) == 1 and m.platform.clock_ms == 1, "zero does not advance");
assert(D.tick(m, 86400000) == 86400001 and m.platform.clock_ms == 86400001, "maximum exact step");
assert(D.signal_write(m, "sample", 7).ok, "signal recorded after accepted tick");
let timestamp = D.signal_read(m, "sample").updated_ms;
let invalid = [-1, 86400001, 0.5, 1.9, -0.1, "1", nil, true, [], map{}, parse_number("NaN"), parse_number("Infinity"), parse_number("-Infinity")];
let i = 0;
while i < len(invalid) {
    let calls = m.platform.syscall_count;
    let rejected = try { D.tick(m, invalid[i]); false } catch true;
    assert(rejected, "invalid device step throws");
    assert(m.clock_ms == 86400001 and m.platform.clock_ms == 86400001, "invalid device step preserves clocks");
    assert(m.platform.syscall_count == calls, "device admission does not call platform");
    let response = P.syscall(m.platform, "clock_ms", map{ advance: invalid[i] });
    assert(not response["ok"], "invalid platform step returns error");
    assert(m.clock_ms == 86400001 and m.platform.clock_ms == 86400001, "invalid platform step preserves clocks");
    assert(m.platform.syscall_count == calls + 1, "rejected platform call retains attempt accounting");
    i = i + 1;
}
assert(D.tick(m, 2) == 86400003 and m.platform.clock_ms == 86400003, "valid tick recovers after invalid inputs");
assert(D.signal_read(m, "sample").updated_ms == timestamp, "existing sample timestamp remains stable");
assert(D.signal_write(m, "sample", 8).ok and D.signal_read(m, "sample").updated_ms == 86400003, "new sample uses accepted time");

let quota = D.machine(profile);
quota.platform.limits.max_syscalls = 1;
assert(D.tick(quota, 5) == 5, "last admitted syscall succeeds");
let failure = try D.tick(quota, 7) catch "rejected";
assert(failure == "rejected", "budget failure propagates");
assert(quota.clock_ms == 5 and quota.platform.clock_ms == 5, "budget failure preserves both clocks");
assert(quota.platform.syscall_count == 2, "budget failure counts attempted call");
quota.platform.limits.max_syscalls = 3;
assert(D.tick(quota, 2) == 7 and quota.platform.clock_ms == 7, "recovery after explicitly extending simulated budget");
assert(D.signal_write(quota, "sample", 9).ok and D.signal_read(quota, "sample").updated_ms == 7, "recovery sample uses committed time");

let stopped = D.machine(profile);
assert(D.tick(stopped, 4) == 4, "pre-exit tick");
assert(P.syscall(stopped.platform, "exit").ok, "simulated exit");
let before_exit_calls = stopped.platform.syscall_count;
assert((try D.tick(stopped, 3) catch "rejected") == "rejected", "post-exit tick rejects");
assert(stopped.clock_ms == 4 and stopped.platform.clock_ms == 4, "post-exit clocks stable");
assert(stopped.platform.syscall_count == before_exit_calls, "exit rejection retains existing accounting");

let broken = D.machine(profile);
let saved_platform = broken.platform;
broken.platform = nil;
assert((try D.tick(broken, 3) catch "rejected") == "rejected" and broken.clock_ms == 0, "invalid platform preserves local time");
broken.platform = map{};
assert((try D.tick(broken, 3) catch "rejected") == "rejected" and broken.clock_ms == 0, "platform exception preserves local time");
broken.platform = saved_platform;
assert(D.tick(broken, 3) == 3 and broken.platform.clock_ms == 3, "restored platform recovers");

let independent = P.machine(profile.platform, map{ memory_bytes: 32 });
assert(P.syscall(independent, "clock_ms").value == 1, "platform default unchanged");
assert(P.syscall(independent, "clock_ms", map{ advance: 0 }).value == 1, "platform zero unchanged");
assert(P.syscall(independent, "clock_ms", map{ advance: 86400000 }).value == 86400001, "platform maximum unchanged");
print "device_clock_pass";
