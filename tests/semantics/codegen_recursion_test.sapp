// tests/semantics/codegen_recursion_test.sapp — RECURSION compiles to native x86-64: calls
// auto-preserve r1/r2/r3, so a function can call itself. Verified by running the binary.

let X = import("stdlib/codegen_x64.sapp");

fn fail(m) { throw "FAIL " + m; }
fn run_rc(elf, tag) {
    let path = "pbrec_" + tag + ".bin";
    fs_write_bytes(path, elf);
    let r = proc_spawn_wait("bash", ["-c", "chmod +x " + path + " && ./" + path + "; rc=$?; rm -f " + path + "; echo RC=$rc"]);
    let out = try r.stdout catch "";
    let idx = str_index_of(out, "RC=");
    return parse_number(str_trim(str_slice(out, idx + 3, len(out))));
}
fn eqrc(elf, want, tag) { let g = run_rc(elf, tag); if g != want { fail(tag + " got " + str(g) + " want " + str(want)); } }

// factorial(n in r0) -> r0 = n!
//   if r0 != 0 { r1 = r0; r0 = r0 - 1; call fact; mul r0, r1 } else { r0 = 1 }
let fact = [map{ name: "fact", body: [
    ["ifnz", 0, [
        ["seti", 2, 1],            // r2 = 1 (decrement helper)
        ["seti", 1, 0], ["add", 1, 0],  // r1 = r0 (n)
        ["sub", 0, 2],             // r0 = n - 1
        ["call", "fact"],          // r0 = (n-1)!   (r1 preserved across the call)
        ["mul", 0, 1]              // r0 = (n-1)! * n
    ], [
        ["seti", 0, 1]             // base case: 0! = 1
    ]]
] }];
eqrc(X.compile_unit(fact, [["seti", 0, 5], ["call", "fact"]]), 120, "factorial_5");
eqrc(X.compile_unit(fact, [["seti", 0, 0], ["call", "fact"]]), 1, "factorial_0");
eqrc(X.compile_unit(fact, [["seti", 0, 6], ["call", "fact"]]), 208, "factorial_6_mod256");  // 720 & 0xFF = 208

print "codegen_recursion_pass";
