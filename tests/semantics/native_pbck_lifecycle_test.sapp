if platform()!="linux" {print "native_pbck_lifecycle_skip_linux_required";os_exit(0);}
let N=import("stdlib:compiler/native_pbck.sapp");let UUID=import("stdlib:uuid.sapp");
let runtime=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let path=path_join(cwd(),".lifecycle_"+UUID.v4()+".pbck");
fn check(init,work,release,expected,error=nil) {
    let source="let owned=[];fn init(){"+init+"}fn work(){"+work+"}fn release(){"+release+"}";
    fs_write_bytes(path,N.compile_source_with_lifecycle(source,"init","work","release"));
    let r=proc_spawn_wait("/usr/bin/timeout",["-k","1s","5s",runtime,"run",path,"--sandbox"]);
    assert(r.stdout==expected,"initialization/entry/cleanup order: "+r.stdout+r.stderr);
    if error==nil {assert(r.exit_code==0,"successful lifecycle");}
    else {assert(r.exit_code!=0 and str_contains(r.stderr,error) and (error=="SECONDARY" or not str_contains(r.stderr,"SECONDARY")),"original error retained: "+r.stderr);}
}
fn exercise() {
    check("push(owned,7);print \"INIT\";","print owned[0];return false;","array_pop(owned);print len(owned);","INIT\n7\n0\n");
    check("push(owned,7);throw \"INITIAL\";","print \"WRONG\";","array_pop(owned);print len(owned);throw \"SECONDARY\";","0\n","INITIAL");
    check("push(owned,7);let empty=[];print empty[map{}];","print \"WRONG\";","array_pop(owned);print len(owned);","0\n","array index must be number");
    check("push(owned,7);","throw \"PRIMARY\";","array_pop(owned);print len(owned);throw \"SECONDARY\";","0\n","PRIMARY");
    check("work=fn(){print \"WRONG\";};release=fn(){print \"WRONG\";};","print 7;","print \"CLEAN\";","7\nCLEAN\n");
    check("", "print 7;", "throw \"SECONDARY\";", "7\n", "SECONDARY");
    check("print (try {throw 1;} catch 7);","print 8;","print 9;","7\n8\n9\n");
    let valid="fn init(){}fn work(){}fn release(){}";
    for names in [["init","init","release"],["init","work","init"],["missing","work","release"],["init();","work","release"]] {
        assert((try {N.compile_source_with_lifecycle(valid,names[0],names[1],names[2]);false} catch true),"invalid lifecycle declaration");
    }
    for source in ["fn init(x){}fn work(){}fn release(){}",valid+"// __pb_lifecycle_entry",valid+"/* private_canary",str_repeat(" ",1048577)] {
        assert((try {N.compile_source_with_lifecycle(source,"init","work","release");false} catch true),"invalid source rejected");
    }
}
let passed=try {exercise();true} catch false;try fs_remove(path) catch nil;
assert(passed,"native lifecycle regression");print "native_pbck_lifecycle_pass";
