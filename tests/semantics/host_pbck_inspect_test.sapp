let Inspect = import("stdlib:host_pbck_inspect.sapp");
let Translate = import("stdlib:selfhost_to_pbck.sapp");

fn fail(message) { throw "FAIL host_pbck_inspect: " + message; }

let inner = map{ instructions: [map{ op: 16, operand: 2 }, map{ op: 19, operand: 0 }], constants: [] };
let chunk = map{
    instructions: [map{ op: 0, operand: 0 }, map{ op: 24, operand: 1 },
        map{ op: 18, operand: 1 }, map{ op: 25, operand: 2 }, map{ op: 19, operand: 0 }],
    constants: [7, map{ arity: 1, min_arity: 1, chunk: inner,
        upvalues: [map{ index: 2, is_local: true }] }]
};
let bytes = Translate.translate(chunk);
let report = Inspect.inspect_bytes(bytes);
if report.version != 1 or report.chunks != 2 or report.functions != 1
    or report.max_arity != 1 or report.max_captures != 1 or report.max_slot < 2
    or report.max_call_arity != 1 or report.instructions < 7
    or report.constant_kinds.number != 1 or report.constant_kinds.function != 1 {
    fail("host PBCK requirement report mismatch");
}
let trailing = []; let i = 0; while i < len(bytes) { array_push(trailing, bytes[i]); i = i + 1; }
array_push(trailing, 0);
let trailing_rejected = try { Inspect.inspect_bytes(trailing); false } catch true;
let magic_rejected = try { Inspect.inspect_bytes([80, 66, 67, 83, 2, 0, 0, 0, 0]); false } catch true;
if not trailing_rejected or not magic_rejected { fail("malformed host PBCK was accepted"); }

print "host_pbck_inspect_pass";
