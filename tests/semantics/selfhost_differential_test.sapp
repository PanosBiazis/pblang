// Test: DIFFERENTIAL parity between the Rust VM and the self-hosted compiler.
// Each construct is evaluated two ways — natively (this file runs on the Rust VM)
// and by compiling+running the same source through the pblang self-hosted
// frontend (frontend_run → stdlib/compiler/vm.sapp) — and the results must match.
// Any divergence is a self-hosted parity gap. (Runs under `pblang test`, whose
// call-depth limit is high enough for the self-hosted VM's host-recursion model.)

let fe = import("stdlib/compiler/selfhost_frontend.sapp");

fn dc(label, native, src, var) {
    let r = fe.frontend_run(src);
    if not r.ok { throw "PARITY[" + label + "]: self-hosted COMPILE FAILED"; }
    let sh = r.globals[var];
    if sh != native {
        throw "PARITY[" + label + "]: native=" + str(native) + " self-hosted=" + str(sh);
    }
}

// Arithmetic & precedence
dc("arith", 1 + 2 * 3 - 4, "let x = 1 + 2 * 3 - 4;", "x");
dc("div", 20 / 4, "let x = 20 / 4;", "x");
dc("mod", 17 % 5, "let x = 17 % 5;", "x");
dc("pow", num_pow(2, 8), "let x = 2 ** 8;", "x");
dc("paren", (1 + 2) * 3, "let x = (1 + 2) * 3;", "x");

// Bitwise & radix
dc("band", bit_and(12, 10), "let x = 12 & 10;", "x");
dc("bor", bit_or(12, 3), "let x = 12 | 3;", "x");
dc("bxor", bit_xor(6, 3), "let x = 6 ^ 3;", "x");
dc("shl", bit_shl(1, 4), "let x = 1 << 4;", "x");
dc("shr", bit_shr(256, 2), "let x = 256 >> 2;", "x");
dc("bnot", bit_not(0), "let x = ~0;", "x");
dc("hex", 255, "let x = 0xFF;", "x");
dc("bin", 10, "let x = 0b1010;", "x");

// Comparison & logical
dc("gt", 5 > 3, "let x = 5 > 3;", "x");
dc("eq", 4 == 4, "let x = 4 == 4;", "x");
dc("ne", 4 != 5, "let x = 4 != 5;", "x");
dc("and", true and false, "let x = true and false;", "x");
dc("or", false or true, "let x = false or true;", "x");
dc("not", not false, "let x = not false;", "x");

// Strings
dc("concat", "ab" + "cd", "let x = \"ab\" + \"cd\";", "x");
dc("upper", str_upper("hi"), "let x = str_upper(\"hi\");", "x");
dc("slen", len("hello"), "let x = len(\"hello\");", "x");

// Arrays
dc("alen", len([1, 2, 3]), "let x = len([1, 2, 3]);", "x");
dc("aidx", [10, 20, 30][1], "let x = [10, 20, 30][1];", "x");
dc("aloop", 6, "let arr = [1,2,3]; let x = 0; for v in arr { x = x + v; }", "x");

// Maps
dc("mmember", 42, "let m = map{ a: 42 }; let x = m.a;", "x");
dc("mhas", true, "let m = map{ a: 1 }; let x = map_has(m, \"a\");", "x");

// Functions, recursion, defaults
dc("call", 30, "fn add(a, b) { return a + b; } let x = add(10, 20);", "x");
dc("recur", 120, "fn fact(n) { if n <= 1 { return 1; } return n * fact(n - 1); } let x = fact(5);", "x");
dc("default", 15, "fn f(a, b = 5) { return a + b; } let x = f(10);", "x");

// Closures
dc("closure", 105, "fn adder(n) { return fn(x) { return x + n; }; } let g = adder(5); let x = g(100);", "x");

// Control flow
dc("elif", 2, "let n = 0; let x = 0; if n > 0 { x = 1; } else if n == 0 { x = 2; } else { x = 3; }", "x");
dc("while", 10, "let x = 0; let i = 0; while i < 5 { x = x + i; i = i + 1; }", "x");
dc("forcount", 10, "let x = 0; for i 5 { x = x + i; }", "x");
dc("break", 6, "let x = 0; for i 100 { if i > 3 { break; } x = x + i; }", "x");

// match
dc("match", "two", "let n = 2; let x = match n { case 1: \"one\" case 2: \"two\" else: \"other\" };", "x");

// try / catch / throw (the gap this differential found & fixed)
dc("trythrow", 99, "let x = try (throw \"e\") catch 99;", "x");
dc("trythrow2", 7, "fn risky(n) { if n < 0 { throw \"neg\"; } return n; } let x = try risky(-1) catch 7;", "x");
dc("tryok", 3, "let x = try (1 + 2) catch 0;", "x");

// Nil-safe operators
dc("coalesce", 7, "let a = nil; let x = a ?? 7;", "x");
dc("safemember", nil, "let a = nil; let x = a?.field;", "x");

// Inline if expression
dc("ifexpr", 100, "let x = if true { 100 } else { 200 };", "x");

// struct
dc("struct", 7, "struct Pt { x: number, y: number } let p = Pt(3, 4); let x = p.x + p.y;", "x");

// Precision ladder — bigint / rational / decimal (now wired into vm.sapp)
dc("bigadd", str(bigint(2) + bigint(3)), "let x = str(bigint(2) + bigint(3));", "x");
dc("bigmul", str(bigint(12345678901234567890) * bigint(2)), "let x = str(bigint(12345678901234567890) * bigint(2));", "x");
dc("bigpow", str(bigint(2) ** 64), "let x = str(bigint(2) ** 64);", "x");
dc("bigcmp", bigint(1000000000000) > bigint(999999999999), "let x = bigint(1000000000000) > bigint(999999999999);", "x");
dc("rational", str(rational(1, 3)), "let x = str(rational(1, 3));", "x");
dc("decimal", str(decimal("3.14")), "let x = str(decimal(\"3.14\"));", "x");

// Operator overloading (arithmetic + comparison, plain map and reflected)
dc("opadd", 6, "fn box(v) { return map{ v: v, __add__: fn(self, o) { return box(self.v + o.v); } }; } let r = box(2) + box(4); let x = r.v;", "x");
dc("oprmul", 30, "fn box(v) { return map{ v: v, __rmul__: fn(self, k) { return box(self.v * k); } }; } let r = 10 * box(3); let x = r.v;", "x");
dc("oplt", true, "fn box(v) { return map{ v: v, __lt__: fn(self, o) { return self.v < o.v; } }; } let x = box(2) < box(5);", "x");

print "selfhost_differential_pass";
