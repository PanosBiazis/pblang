// tests/semantics/llm_transformer_enrich_test.sapp — enrichment for stdlib/llm_transformer.sapp
// Adds generation sampling utilities: temperature_scale, top_k_filter, top_p_filter.

let tf = import("stdlib/llm_transformer.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── temperature_scale divides logits ─────────────────────────────────────────────
let ts = tf.temperature_scale([2, 4, 8], 2);
near(ts[0], 1, "temp 2"); near(ts[1], 2, "temp 2"); near(ts[2], 4, "temp 2");

// ── top_k_filter keeps the k highest, masks the rest very negative ────────────────
let tk = tf.top_k_filter([1, 5, 3, 2], 2);
near(tk[1], 5, "top_k keeps the max"); near(tk[2], 3, "top_k keeps 2nd");
if tk[0] > 0 - 1000000 { fail("top_k should mask non-top values"); }
if tk[3] > 0 - 1000000 { fail("top_k should mask non-top values"); }

// ── top_p_filter keeps the smallest set of top logits covering prob mass p ────────
// With one dominant logit, p=0.5 should keep only it.
let tp = tf.top_p_filter([10, 0, 0, 0], 0.5);
near(tp[0], 10, "top_p keeps the dominant logit");
if tp[1] > 0 - 1000000 { fail("top_p should mask the tail"); }

print "llm_transformer_enrich_pass";
