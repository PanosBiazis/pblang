// tests/semantics/pbai_accuracy_test.sapp — benchmark the pbAI intent classifier on a
// HELD-OUT set (prompts phrased differently from the training data) so accuracy reflects
// generalization, not memorization. The model is trained on hand-written sentences PLUS
// generated per-keyword samples (_augment_data); this locks in a minimum accuracy bar.

let pbai = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }

// [prompt, expected_intent] — none are verbatim training samples.
let cases = [
    ["explain what this function does", "explain"],
    ["walk me through this code", "explain"],
    ["what does this snippet do", "explain"],
    ["give me an overview of this program", "explain"],
    ["help me understand this logic", "explain"],
    ["trace this execution", "explain"],
    ["find the bugs in this code", "bugs"],
    ["why does this throw an error", "bugs"],
    ["this function crashes, what is wrong", "bugs"],
    ["debug this failing code", "bugs"],
    ["there is an exception here", "bugs"],
    ["this is broken, fix it", "bugs"],
    ["make this faster and cleaner", "improve"],
    ["refactor this function", "improve"],
    ["optimize this for performance", "improve"],
    ["simplify this code", "improve"],
    ["add comments to this code", "comment"],
    ["document this function with a docstring", "comment"],
    ["annotate this", "comment"],
    ["how does pblang handle concurrency", "general"],
    ["generate a hello world program", "general"],
    ["write a function that sorts a list", "general"],
    ["what is a typeclass in pblang", "general"],
    ["review the security model", "general"]
];

let ok = 0;
let i = 0;
while i < len(cases) {
    let got = pbai.classify_scores(cases[i][0]).intent;
    if got == cases[i][1] { ok = ok + 1; }
    else { print "  miss: '" + cases[i][0] + "' -> " + got + " (want " + cases[i][1] + ")"; }
    i = i + 1;
}
let total = len(cases);
print "pbai accuracy: " + str(ok) + "/" + str(total);
// Bar: at least 22/24 (~92%) held-out accuracy.
if ok < 22 { fail("pbai accuracy below bar: " + str(ok) + "/" + str(total)); }

print "pbai_accuracy_pass";
