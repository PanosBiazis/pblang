// tests/semantics/codegen_arm64_test.sapp — AArch64 (arm64) backend: the SAME register IR
// compiled to real ARM64 machine code + ELF. This x86-64 host has no arm64 emulator, so the
// proof is EXACT instruction encodings (verifiable against the ARM Architecture Reference
// Manual) plus a valid AArch64 ELF header — it runs on real arm64 hardware.

let A = import("stdlib/codegen_arm64.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eqw(got, want, m) {
    if len(got) != 4 { fail(m + " not a 4-byte word"); }
    let i = 0;
    while i < 4 { if got[i] != want[i] { fail(m + " @" + str(i) + " got=" + str(got[i]) + " want=" + str(want[i])); } i = i + 1; }
}

// AArch64 is fixed 32-bit, little-endian. These are the canonical encodings:
eqw(A.movz_imm16(0, 5),  [0xA0, 0x00, 0x80, 0xD2], "movz x0,#5");   // 0xD28000A0
eqw(A.add_rr(0, 1),      [0x00, 0x00, 0x01, 0x8B], "add x0,x0,x1"); // 0x8B010000
eqw(A.sub_rr(0, 1),      [0x00, 0x00, 0x01, 0xCB], "sub x0,x0,x1"); // 0xCB010000
eqw(A.mul_rr(0, 1),      [0x00, 0x7C, 0x01, 0x9B], "mul x0,x0,x1"); // 0x9B017C00
eqw(A.svc0(),            [0x01, 0x00, 0x00, 0xD4], "svc #0");       // 0xD4000001

// seti: small immediate is one movz (4 bytes); >16-bit needs movz+movk (8 bytes)
if len(A.seti_bytes(0, 5)) != 4 { fail("small seti is one instruction"); }
if len(A.seti_bytes(0, 0x12345)) != 8 { fail("32-bit seti is movz+movk"); }

// every compiled program is 4-byte aligned (fixed-width ISA)
let arith = [["seti", 0, 2], ["seti", 1, 3], ["add", 0, 1], ["seti", 1, 4], ["mul", 0, 1]];
let code = A.compile_ir(arith);
if A.compile_ir([["movr", 0, 1]]) != [0xE0, 0x03, 0x01, 0xAA] { fail("arm64 mov x0,x1 encoding"); }
if num_mod(len(code), 4) != 0 { fail("arm64 code must be 4-byte aligned"); }

// loops compile (guard + body + sub + cbnz), still 4-byte aligned
let loopsum = [["seti", 0, 0], ["seti", 1, 10], ["loop", 1, [["add", 0, 1]]]];
if num_mod(len(A.compile_ir(loopsum)), 4) != 0 { fail("arm64 loop not aligned"); }

// valid AArch64 ELF: magic, ELFCLASS64, EM_AARCH64 (0xB7)
let elf = A.compile_program(arith);
if elf[0] != 0x7F { fail("ELF magic"); }
if elf[4] != 2 { fail("ELFCLASS64"); }
if elf[68] != 5 { fail("ordinary ARM64 ELF segment must be RX, not writable"); }
if elf[18] != 0xB7 { fail("EM_AARCH64 (e_machine low byte 0xB7)"); }

print "codegen_arm64_pass";
