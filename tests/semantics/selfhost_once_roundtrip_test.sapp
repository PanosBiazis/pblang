let FE = import("stdlib:compiler/selfhost_frontend.sapp");
let VM = import("stdlib:compiler/vm.sapp");
let PB = import("stdlib:selfhost_pbck.sapp");
let module_source = fs_read("stdlib/functional_once.sapp");
if len(str_to_bytes(module_source)) > 4096 { throw "FAIL once-roundtrip: fixture module size"; }
let source = module_source
    + "\nlet seen = []; let good = once_attempt(fn(x){push(seen,x);return nil;}); let a=good(1);let b=good(2);"
    + "let count=[0];let bad=once_attempt(fn(x){count[0]=count[0]+1;throw nil;});"
    + "let c=try map{ok:true,value:bad(0)} catch map{ok:false};"
    + "let d=try map{ok:true,value:bad(1)} catch map{ok:false};"
    + "let result=[a,b,seen,c.ok,d.ok,count[0]];";
let compiled = FE.frontend_compile(source);
if not compiled.ok or len(compiled.diagnostics) != 0 { throw "FAIL once-roundtrip: compile"; }
let limits = map{max_steps:6000,max_frames:16};
let plain = VM.run_bounded(compiled.chunk,limits);
let optimized = FE.frontend_run_bounded(source,limits);
let restored = VM.run_bounded(PB.deserialize_chunk(PB.serialize_chunk(compiled.chunk)),limits);
let wanted = [nil,nil,[1],false,false,1];
if plain.globals.result != wanted or not optimized.ok or optimized.globals.result != wanted or restored.globals.result != wanted {
    throw "FAIL once-roundtrip: lifecycle result";
}
if plain.runtime.steps != restored.runtime.steps { throw "FAIL once-roundtrip: instruction accounting"; }
print "selfhost_once_roundtrip_pass";
