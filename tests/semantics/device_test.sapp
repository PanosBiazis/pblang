// tests/semantics/device_test.sapp — using real device drivers from PURE pblang (no Rust),
// through the kernel's devfs/sysfs/procfs interfaces. Kernel drivers exposed as files are
// reachable with pblang's existing file builtins; this proves it against live devices.

let D = import("stdlib/device.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── device-node presence ────────────────────────────────────────────────────────────
eq(D.exists("/dev/null"), true, "/dev/null exists");
eq(D.exists("/dev/pblang_no_such_device"), false, "missing device reported absent");

// ── WRITE to a char-device driver (the null driver) ─────────────────────────────────
let n = D.discard([1, 2, 3, 4, 5]);
eq(n, 5, "wrote 5 bytes to the null driver");

// ── USE the kernel RNG driver (finite per read, no hang) ────────────────────────────
let u1 = D.random_uuid();
let u2 = D.random_uuid();
eq(len(u1), 36, "uuid length");
if str_index_of(u1, "-") < 0 { fail("uuid format"); }
if u1 == u2 { fail("RNG driver should yield distinct UUIDs"); }

// ── read a kernel/procfs interface ──────────────────────────────────────────────────
if str_index_of(D.read_text("/proc/version"), "Linux") < 0 { fail("read /proc/version via kernel iface"); }

// ── honest capability report ────────────────────────────────────────────────────────
let c = D.capabilities();
eq(c.devfs_rw, true, "char/block device read/write reachable");
eq(c.sysfs, true, "sysfs reachable");
eq(c.procfs, true, "procfs reachable");
// Bounded allowlisted ioctl is now provided by the PBLang-native Linux device
// handle backend. mmap and vendor GPU stacks remain separate native boundaries.
eq(c.ioctl_via_pure_pblang, true, "bounded ioctl is reachable through the PBLang Linux device backend");
eq(c.gpu_vendor_libs, false, "vendor GPU userspace libs need dynamic linking");

print "device_pass";
