// Test: stdlib/machine_opt.sapp -- registers/cache/memory/backend/device planner.

let M = import("stdlib:machine_opt.sapp");

let cpu = M.profile("portable");
let mat = M.workload("matmul", 128, "f32");
let regs = M.register_plan(cpu, mat);
assert(regs.strategy == "vector-register", "numeric CPU workload uses vector register strategy");
assert(regs.expected_spills == 0, "portable profile has enough registers for matmul hot values");

let cache = M.cache_plan(mat, cpu);
assert(cache.tile.tile_rows > 1, "cache plan creates a useful tile size");
assert(cache.tile.tiles_total > 1, "large matrix is split into cache tiles");

let bin = M.binary_plan(mat, cpu);
assert(bin.backend == "cranelift-jit-or-c-aot", "numeric hot loop routes to machine-code backend");
assert(bin.keep_vm_fallback, "binary planner keeps VM fallback");

let old = M.profile("old");
let old_bin = M.binary_plan(mat, old);
assert(old_bin.backend == "freestanding-c", "old machines route to small AOT C backend");
let old_mem = M.memory_plan(1024 * 1024 * 1024, "stream", old);
assert(old_mem.chunks > 1, "old profile chunks large memory workloads");

let devices = [
    M.device("cpu", "portable cpu", map{ available: true, cores: 8 }),
    M.device("gpu", "gpu0", map{ available: true, tensor: true }),
    M.device("npu", "npu0", map{ available: true, runtime: false }),
    M.device("fpga", "fpga0", map{ available: true, toolchain: false }),
    M.device("quantum", "qpu0", map{ available: true, qubits: 32 }),
];

let gpu_route = M.device_plan(mat, devices);
assert(gpu_route.selected.kind == "gpu", "matmul chooses GPU when tensor runtime exists");

let infer_route = M.device_plan(M.workload("inference", 32, "f32"), [
    M.device("cpu", "portable cpu", map{ available: true, cores: 8 }),
    M.device("npu", "npu0", map{ available: true, runtime: false }),
]);
assert(infer_route.selected.kind == "cpu", "NPU without runtime is rejected and CPU remains fallback");
assert(len(infer_route.rejected) >= 1, "device planner records rejected devices");

let qwork = M.workload("quantum_circuit", 8, "qubit");
let qbin = M.binary_plan(qwork, M.profile("quantum"));
let qroute = M.device_plan(qwork, devices);
assert(qbin.backend == "quantum-protocol", "quantum workload routes through protocol backend");
assert(qroute.selected.kind == "quantum", "quantum workload chooses QPU when present");

let plan = M.full_plan(mat, cpu, devices);
let text = M.explain(plan);
assert(str_contains(text, "backend=cranelift-jit-or-c-aot"), "explain includes backend");
assert(str_contains(text, "Boundary:"), "explain states honest implementation boundary");
assert(plan.growth_rule != "", "full plan includes live-growth rule");

let desktop_play = M.play_plan("game.sapp", "desktop", map{ workload: "generic" });
assert(desktop_play.route == "pblang-vm", "desktop plays through the VM by default");
assert(desktop_play.stages[4] == "run-on-vm", "desktop play plan ends on VM execution");

let browser_play = M.play_plan("game.sapp", "browser", map{ workload: "generic" });
assert(browser_play.route == "wasm", "browser play plan routes to WASM");
assert(str_contains(browser_play.command, "--wasm"), "browser command names wasm compile path");

let mcu_play = M.play_plan("sensor.sapp", "microcontroller", map{ workload: "stream", size: 16, dtype: "i32" });
assert(mcu_play.route == "firmware-c-subset", "microcontroller play plan uses firmware C subset");
assert(mcu_play.optimization.profile.kind == "microcontroller", "microcontroller play plan uses small target profile");

let qplay = M.play_plan("bell.sapp", "quantum", map{ workload: "quantum_circuit", dtype: "qubit" });
assert(qplay.route == "quantum-protocol", "quantum play plan uses protocol route");
assert(qplay.stages[4] == "simulate-or-submit", "quantum play plan simulates or submits");

let matrix = M.play_matrix("app.sapp", ["desktop", "browser", "npu", "fpga", "iot"]);
assert(len(matrix) == 5, "play matrix creates one plan per target");
assert(matrix[2].target.kind == "npu", "play matrix keeps target order");
assert(matrix[4].route == "edge-runtime-or-controller", "iot plan uses edge/controller route");

print "machine_opt_pass";
