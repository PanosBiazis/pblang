// tests/semantics/random_enrich_test.sapp — enrichment for stdlib/random.sapp
// Adds bernoulli, weighted_choice, randoms/randints (arrays), geometric, bytes.

let rng = import("stdlib/random.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── determinism (base) ───────────────────────────────────────────────────────────
eq(rng.random(rng.seed(42)), rng.random(rng.seed(42)), "same seed -> same value");

// ── ENRICH: bernoulli returns 0/1 ────────────────────────────────────────────────
let g = rng.seed(7);
let b = rng.bernoulli(g, 0.5);
if b != 0 and b != 1 { fail("bernoulli must be 0 or 1, got " + str(b)); }
eq(rng.bernoulli(rng.seed(1), 1.0), 1, "bernoulli(p=1) = 1");
eq(rng.bernoulli(rng.seed(1), 0.0), 0, "bernoulli(p=0) = 0");

// ── ENRICH: weighted_choice respects zero weights ────────────────────────────────
let g2 = rng.seed(3);
let i = 0;
while i < 20 {
    eq(rng.weighted_choice(g2, ["a", "b"], [0, 1]), "b", "weighted_choice never picks a 0-weight item");
    i = i + 1;
}

// ── ENRICH: randoms / randints arrays ────────────────────────────────────────────
let g3 = rng.seed(99);
let rs = rng.randoms(g3, 5);
eq(len(rs), 5, "randoms length");
let j = 0; while j < len(rs) { if rs[j] < 0 or rs[j] >= 1 { fail("randoms out of [0,1)"); } j = j + 1; }
let is = rng.randints(rng.seed(99), 1, 6, 100);
eq(len(is), 100, "randints length");
j = 0; while j < len(is) { if is[j] < 1 or is[j] > 6 { fail("randints out of [1,6]"); } j = j + 1; }

// ── ENRICH: geometric >= 1 ───────────────────────────────────────────────────────
let gk = rng.geometric(rng.seed(5), 0.5);
if gk < 1 { fail("geometric must be >= 1, got " + str(gk)); }

// ── ENRICH: bytes ────────────────────────────────────────────────────────────────
let by = rng.bytes(rng.seed(11), 16);
eq(len(by), 16, "bytes length");
j = 0; while j < len(by) { if by[j] < 0 or by[j] > 255 { fail("byte out of range"); } j = j + 1; }

print "random_enrich_pass";
