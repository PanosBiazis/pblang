let UI=import("stdlib:modern_ui.sapp");
let GUI=import("stdlib:gui.sapp");
let Web=import("stdlib:modern_ui_web.sapp");
let Android=import("stdlib:modern_ui_android.sapp");
fn render(view) {return Web.generate("Accessible controls",UI.compile(view,map{target:"web"}));}
fn contains(bytes,text) {
    let needle=str_to_bytes(text);let i=0;
    while i+len(needle)<=len(bytes) {
        let same=true;let j=0;
        while j<len(needle) {if bytes[i+j]!=needle[j] {same=false;break;}j=j+1;}
        if same {return true;}i=i+1;
    }
    return false;
}
fn view() {
    return UI.screen([
        UI.text("Ready",map{name:"status"}),
        UI.button("Open",UI.action_set_text("status","Opened Atlas"),map{name:"atlas",accessibility_label:"Open project Atlas"}),
        UI.button("Open",nil,map{name:"disabled",enabled:false,accessibility_label:"Open unavailable project"}),
        UI.button("Open",UI.action_set_text("status","Opened Boreal"),map{name:"boreal",accessibility_label:"Open project Boreal"}),
        UI.toggle("Notifications",true,nil,map{name:"notify",accessibility_label:"Notifications for project Atlas"})
    ]);
}
let tree=view();let web=render(tree);
assert(str_contains(web.html,"aria-label=\"Open project Atlas\""),"button contextual name emitted");
assert(str_contains(web.html,"<input type=\"checkbox\" checked aria-label=\"Notifications for project Atlas\""),"checkbox label is on input, not wrapper");
assert(str_contains(web.html,"<span data-pb-value>Open</span>"),"visible text retained");
let plain=UI.screen([UI.button("Open"),UI.toggle("Notifications")]);let before=render(plain);
plain.children[0].accessibility_label="";plain.children[1].accessibility_label="";
assert(render(plain).html==before.html,"empty labels preserve visible HTML name and output");
let hostile="Open \"Atlas\" & <script>bad()</script>";
let escaped=render(UI.screen([UI.button("Open",nil,map{accessibility_label:hostile}),UI.toggle("Notify",false,nil,map{accessibility_label:hostile})]));
assert(str_contains(escaped.html,"aria-label=\"Open &quot;Atlas&quot; &amp; &lt;script&gt;bad()&lt;/script&gt;\""),"attribute text escaped");
assert(not str_contains(escaped.html,"<script>bad()"),"label cannot create markup");
assert(UI.validate(UI.input("",map{accessibility_label:"Search projects"})).ok,"existing field labels remain valid");
let boundary=str_repeat("α",1024);
assert(UI.validate(UI.button("Open",nil,map{accessibility_label:boundary})).ok,"1024 Unicode characters accepted");
for invalid in [nil,true,42,[],map{},boundary+"a","bad\rlabel","bad\u0000label","bad\u007flabel"] {
    let bad=UI.button("Open",nil,map{accessibility_label:invalid});
    assert(not UI.validate(bad).ok,"malformed or oversized label rejected");
    assert((try UI.compile(bad) catch nil)==nil,"compile rejects malformed label");
}
assert(UI.validate(UI.button("Open",nil,map{accessibility_label:"Open\nproject\tAtlas"})).ok,"existing newline/tab text accepted");
let diagnostic=UI.validate(UI.button("Open",nil,map{accessibility_label:boundary+"private-label-marker"}));
assert(not str_contains(str(diagnostic.errors),"private-label-marker"),"diagnostics omit rejected label content");
let native=UI.build("Accessible controls",tree);
assert(GUI.get(native,"atlas").accessibility_label=="Open project Atlas","native metadata retained");
assert(not map_has(GUI.get(native,"status"),"accessibility_label"),"omitted metadata not added");
GUI.focus_next(native);assert(native.focus=="atlas","first keyboard stop");
GUI.handle_event(native,map{type:"keydown",key:"Enter"});GUI.handle_event(native,map{type:"keyup",key:"Enter"});
assert(GUI.get(native,"status").text=="Opened Atlas","keyboard activation still works");
GUI.focus_next(native);assert(native.focus=="boreal","disabled control skipped");
GUI.focus_next(native);assert(native.focus=="notify","checkbox keyboard stop retained");
GUI.handle_event(native,map{type:"keydown",key:"Space"});GUI.handle_event(native,map{type:"keyup",key:"Space"});
assert(not GUI.get(native,"notify").checked,"checkbox keyboard toggle retained");
assert(tree.children[0].text=="Ready" and tree.children[4].checked,"native interaction does not alter caller tree");
let portable=UI.compile(tree,map{target:"ios"});
assert(portable.view.children[1].accessibility_label=="Open project Atlas","iOS portable metadata retained, not runtime proof");
let android=UI.compile(tree,map{target:"android"});let bytes=Android.activity_class(android);
assert(contains(bytes,"Open project Atlas") and contains(bytes,"Notifications for project Atlas") and contains(bytes,"setContentDescription"),"Android retains its existing label emission");
let mutable=UI.screen([UI.button("Open",nil,map{accessibility_label:"Valid"})]);
let wb=UI.compile(mutable,map{target:"web"});let ab=UI.compile(mutable,map{target:"android"});
mutable.children[0].accessibility_label=map{};
assert((try Web.generate("Bad",wb) catch nil)==nil,"Web revalidates mutated label");
assert((try Android.activity_class(ab) catch nil)==nil,"Android revalidates mutated label");
print "ui_accessible_controls_pass";
