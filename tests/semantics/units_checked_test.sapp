let U=import("stdlib:units.sapp");
fn near(a,b) {assert(num_abs(a-b)<=0.000001*num_max(1,num_abs(b)),"conversion numeric agreement");}
near(U.convert_checked(2.2,"kohm","ohm"),2200);near(U.convert_checked(1,"uF","pF"),1000000);
near(U.convert_checked(1,"kB","B"),1000);near(U.convert_checked(1,"KiB","B"),1024);near(U.convert(1,"kb","b"),1024);
near(U.convert_checked(10,"degC","degF"),50);near(U.convert_checked(10,"degC","degF","difference"),18);
near(U.convert_checked(-10,"degC","degF","difference"),-18);near(U.convert_checked(-459.67,"degF","K"),0);near(U.convert_checked(-273.15,"degC","K"),0);
near(U.convert_checked(0,"K","degF"),-459.67);near(U.convert_temp(100,"C","F"),212);
assert(U.convert_checked(0.123456789,"degF","degF")==0.123456789,"identity avoids offset roundoff");
for args in [[1,"m","kg","absolute"],[1,"F","degF","absolute"],[1,"v","V","absolute"],[1,"V","V","unknown"],[-0.01,"K","degC","absolute"],[-273.16,"degC","K","absolute"],[nil,"m","cm","absolute"],[true,"m","cm","absolute"],["1","m","cm","absolute"],[1000000000001,"m","m","absolute"],[1000000000000,"km","mm","absolute"]] {
 assert((try U.convert_checked(args[0],args[1],args[2],args[3]) catch nil)==nil,"invalid conversion rejected");
}
let catalog=U.catalog();assert(len(catalog)>60,"expanded catalog");let changed=U.describe_unit("V");changed.scale=99;assert(U.describe_unit("V").scale==1,"detached description");
for a in catalog {for b in catalog {if a.category==b.category {
 let converted=U.convert_checked(0.25,a.symbol,b.symbol);near(U.convert_checked(converted,b.symbol,a.symbol),0.25);
}}}
let values=[-10,0,10,20];let before=json_stringify(values);assert(U.convert_many(values,"degC","degF","difference")==[-18,0,18,36],"batch delta conversion");assert(json_stringify(values)==before,"source retained");
assert(U.convert_many([],"m","cm")==[],"empty batch");let maximum=[];for i in range(0,512){array_push(maximum,i);}
assert(len(U.convert_many(maximum,"mV","V"))==512,"maximum batch");array_push(maximum,513);assert((try U.convert_many(maximum,"mV","V") catch nil)==nil,"batch limit");
assert((try U.convert_many([1,nil,2],"m","cm") catch nil)==nil,"all-or-nothing malformed batch");print "units_checked_pass";
