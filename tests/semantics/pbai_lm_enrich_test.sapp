// tests/semantics/pbai_lm_enrich_test.sapp — enrichment for stdlib/pbai_lm.sapp
// Adds vocab_size (distinct chars) and perplexity (exp of loss).

let lm = import("stdlib/pbai_lm.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base vocab_build still works ─────────────────────────────────────────────────
let v = lm.vocab_build("hello");
near(v.size, 4, "vocab has 4 distinct chars");

// ── ENRICH: vocab_size ───────────────────────────────────────────────────────────
near(lm.vocab_size(v), 4, "vocab_size");

// ── ENRICH: perplexity = exp(loss) ───────────────────────────────────────────────
near(lm.perplexity(0), 1, "perplexity(0) = 1");
near(lm.perplexity(num_ln(2)), 2, "perplexity(ln2) = 2");

print "pbai_lm_enrich_pass";
