// tests/semantics/selfhost_breadth3_test.sapp
//
// Self-host breadth wave 3 — the last construct classes behind the stdlib
// `pblang check` false errors:
//
//   1. Ternary `cond ? a : b` (safety.sapp, blocks.sapp) — the Rust frontend
//      desugars it to an if-expression with single-expression arms.
//   2. `defer` as a plain identifier (async_io.sapp defines, calls and exports
//      `fn defer(fn_val)`; the self-hosted parser has no defer statement, so
//      the keyword is free to be a name).
//   3. `nil` as a fn NAME and export entry (blocks.sapp's AST builder
//      `fn nil()`); `nil` in expression position stays the literal.

let fe = import("stdlib/compiler/selfhost_frontend.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }
fn errs(r) { return try str(r.errors) catch "(no errors key)"; }

// ── 1. ternary ───────────────────────────────────────────────────────────────
let src1 = ""
    + "let a = 1 == 1 ? 10 : 20;\n"
    + "let b = 1 == 2 ? 10 : 20;\n"
    + "let msg = nil;\n"
    + "let c = \"x\" + (msg != nil ? (\": \" + str(msg)) : \"\");\n"  // safety.sapp shape
    + "let d = (3 > 2 ? 1 : 0) + (2 > 3 ? 1 : 0);\n";
let r1 = try fe.frontend_run(src1) catch map{ ok: false, errors: ["frontend threw"] };
truthy(r1.ok, "ternary parses and runs: " + errs(r1));
eq(r1.globals["a"], 1 == 1 ? 10 : 20, "true-arm agrees with Rust VM");
eq(r1.globals["a"], 10, "a = 10");
eq(r1.globals["b"], 20, "b = 20");
eq(r1.globals["c"], "x", "nil-guard ternary yields empty suffix");
eq(r1.globals["d"], 1, "parenthesized ternaries compose");

// ── 2. defer as identifier ───────────────────────────────────────────────────
let src2 = ""
    + "fn defer(f) { return f() + 1; }\n"
    + "let got = defer(fn() { return 41; });\n"
    + "export defer;\n";
let r2 = try fe.frontend_run(src2) catch map{ ok: false, errors: ["frontend threw"] };
truthy(r2.ok, "fn defer(...) parses and runs: " + errs(r2));
eq(r2.globals["got"], 42, "defer is definable and callable");

// ── 3. nil as fn name (blocks.sapp AST-builder shape) ────────────────────────
let src3 = ""
    + "fn nil() { return \"nil-node\"; }\n"
    + "let lit = nil;\n"                    // expression `nil` stays the literal
    + "export nil;\n";
let r3 = try fe.frontend_run(src3) catch map{ ok: false, errors: ["frontend threw"] };
truthy(r3.ok, "fn nil() parses and runs: " + errs(r3));
eq(r3.globals["lit"], nil, "expression-position nil is still the literal");

print "selfhost_breadth3_pass";
