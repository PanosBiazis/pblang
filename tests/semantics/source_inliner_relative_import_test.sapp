let LINK = import("stdlib:source_inliner.sapp");

fn require(value, message) {
    if not value { throw "FAIL source_inliner_relative_import: " + message; }
}

let modules = map{
    "pkg/outer.sapp": "let INNER = import(\"./inner.sapp\"); fn value() { return INNER.answer(); } export value;",
    "pkg/inner.sapp": "fn answer() { return 42; } export answer;"
};
fn resolve(path) { return try modules[path] catch nil; }
let linked = LINK.inline_source_prefixed(
    "let OUTER = import(\"pkg/outer.sapp\"); print OUTER.value();", resolve);
require(linked.ok and linked.modules == 2
    and len(linked.module_order) == 2
    and linked.module_order[0] == "pkg/inner.sapp"
    and linked.module_order[1] == "pkg/outer.sapp",
    "explicit relative import resolves against its importing module");
require(not str_contains(linked.source, "INNER.answer")
    and str_contains(linked.source, "__pbi0_answer"),
    "relative module member reference is rewritten to the canonical prefix");

print "source_inliner_relative_import_pass";
