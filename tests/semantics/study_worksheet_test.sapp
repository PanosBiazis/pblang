let S=import("stdlib:study_cards.sapp");let W=import("stdlib:study_worksheet.sapp");let D=import("stdlib:text_document.sapp");let UI=import("stdlib:modern_ui.sapp");let Reader=import("stdlib:document_excerpt_view.sapp");
fn reject(work){let failed=false;try {work();} catch {failed=true;}assert(failed,"invalid worksheet rejected");}
let deck=S.create("Synthetic",[map{prompt:"First prompt",answer:"ANSWER_ONLY_A"},map{prompt:"Second prompt",answer:str_repeat("α😊",682)}],"2026-09-27");deck.cards[1].id=64;deck=S.review(deck,64,"good","2026-09-27");let original=S.encode(deck);
let q=W.create(deck,"questions",2,1);assert(len(q.blocks)==3 and q.blocks[0].text=="Question 2 | Card 64" and q.blocks[1].text=="Second prompt","range and numbering");let question_text=D.encode(q);assert(not str_contains(question_text,"α😊"),"answer field excluded");
let a=W.create(deck,"answers",2,1);let chunks=[];for i in range(1,len(a.blocks)){array_push(chunks,a.blocks[i].text);}assert(str_join(chunks,"")==deck.cards[1].answer and len(a.blocks)==5,"full long answer");
q.blocks[1].text="changed";assert(S.encode(deck)==original,"source progress immutable");
for target in ["native","web","android"]{assert(len(UI.compile(Reader.view(a,1,"Answer key"),map{target:target,width:412,height:915}).records)>0,"last portable page");}
for args in [[0,1],[1,0],[1,17],[2,2],[1.5,1],[1,1.5],["1",1]] {reject(fn(){W.create(deck,"questions",args[0],args[1]);});}
reject(fn(){W.create(deck,"hidden",1,1);});let malformed=S.copy(deck);malformed.cards[0].prompt="";reject(fn(){W.create(malformed,"answers",2,1);});
let pairs=[];for i in range(0,64){array_push(pairs,map{prompt:"Q"+str(i),answer:"A"+str(i)});}let full=S.create("Full",pairs,"2026-09-27");let last=W.create(full,"questions",49,16);assert(len(last.blocks)==48 and last.blocks[45].text=="Question 64 | Card 64","all 64 reachable");
let heavy=[];for i in range(0,8){array_push(heavy,map{prompt:str(i),answer:str_repeat("a",4093)});}let huge=S.create("",heavy,"2026-09-27");reject(fn(){W.create(huge,"answers",1,8);});assert(len(W.create(huge,"answers",1,7).blocks)==35,"smaller range fits total bytes");
print "study_worksheet_pass";
