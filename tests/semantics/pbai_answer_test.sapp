// tests/semantics/pbai_answer_test.sapp — answer synthesis: after the ensemble decides
// the intent, the engine runs a host-provided RESPONDER to produce a full text answer
// (not just a label). Hosts wire their skill dispatcher via set_responder(fn(intent,
// prompt)); without one, answer() still returns the decision with text=nil.

let ens = import("stdlib/pbai_ensemble.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let scores = fn(p) { return map{ intent: "bugs", scores: [0.05, 0.9, 0.05, 0.05, 0.05] }; };
ens.configure(scores, ["explain", "bugs", "improve", "comment", "general"]);
ens.clear_voters();
ens.reset_stats();
ens.set_adaptive(false);
ens.set_parallel(false);
ens.set_responder(nil);

// no responder wired -> decision only, text stays nil
let a0 = ens.answer("this code crashes");
eq(a0.intent, "bugs", "answer decides the intent");
if a0.text != nil { fail("no responder -> text nil"); }
if a0.escalate { fail("unanimous native vote should not escalate"); }

// wire a responder: it receives the DECIDED intent and the prompt
ens.set_responder(fn(intent, prompt) { return "SKILL[" + intent + "] " + prompt; });
let a1 = ens.answer("this code crashes");
eq(a1.text, "SKILL[bugs] this code crashes", "responder runs with decided intent");
eq(a1.intent, "bugs", "intent carried through");
if a1.confidence < 0.99 { fail("sole confident voter -> confidence ~1"); }

// a throwing responder degrades to text=nil instead of crashing the answer path
ens.set_responder(fn(intent, prompt) { throw "responder boom"; });
let a2 = ens.answer("this code crashes");
eq(a2.intent, "bugs", "decision survives responder failure");
if a2.text != nil { fail("throwing responder -> text nil"); }

// (the canonical pbai host wiring is covered by pbai_host_answer_test — imports are
// hoisted, so wiring a host here would race this test's own engine manipulation)

ens.set_responder(nil);
ens.clear_voters();
ens.reset_stats();
print "pbai_answer_pass";
