if platform()!="linux" {print "native_bundle_lifecycle_skip_linux_required";os_exit(0);}
let N=import("stdlib:compiler/native_bundle.sapp");let B=import("stdlib:selfhost_bundle.sapp");let UUID=import("stdlib:uuid.sapp");
let exe=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let output=path_join(cwd(),".bundle_lifecycle_"+UUID.v4()+".pbck");
let main="let api=import(\"dependency\");fn init(){api.module_init();}fn work(){api.module_work();}fn release(){api.module_release();}";
fn execute(body,expected,error=nil) {
    let bytes=N.compile_bundle_with_lifecycle(main,fn(path){return body;},"init","work","release");
    fs_write_bytes(output,bytes);
    let result=proc_spawn_wait("/usr/bin/timeout",["-k","1s","5s",exe,"run",output,"--sandbox"]);
    assert(result.stdout==expected,"bundle lifecycle output: "+result.stdout+result.stderr);
    if error==nil {assert(result.exit_code==0,"bundle lifecycle success");}
    else {assert(result.exit_code!=0 and str_contains(result.stderr,error) and not str_contains(result.stderr,"SECONDARY"),"primary message retained");}
}
fn exercise() {
    execute("let owned=[];fn module_init(){push(owned,7);}fn module_work(){for i 1 {let p=map{run:fn(self){return owned[0];}};print (try {p:run()} catch 9);}}fn module_release(){array_pop(owned);print len(owned);}export module_init,module_work,module_release;","7\n0\n");
    execute("let owned=[];fn module_init(){push(owned,7);throw \"INITIAL\";}fn module_work(){print \"WRONG\";}fn module_release(){array_pop(owned);print len(owned);throw \"SECONDARY\";}export module_init,module_work,module_release;","0\n","INITIAL");
    execute("fn module_init(){}fn module_work(){throw \"WORK\";}fn module_release(){print \"CLEAN\";throw \"SECONDARY\";}export module_init,module_work,module_release;","CLEAN\n","WORK");
    // Import-time code is deliberately outside the declared main initializer.
    execute("throw \"TOPLEVEL\";fn module_init(){}fn module_work(){}fn module_release(){print \"WRONG\";}export module_init,module_work,module_release;","","TOPLEVEL");
    let calls=[0];let resolver=fn(path){calls[0]=calls[0]+1;return nil;};
    for source in ["let a=import(\"dependency\");",main+"/* private_canary",main+"let __bundle_bad=7;",main+"// __pb_lifecycle_bad"] {
        calls[0]=0;let rejected=B.bundle_with_lifecycle(source,resolver,"init","work","release");
        assert(not rejected.ok and calls[0]==0,"bad main rejected before resolver effects");
        assert(not str_contains(rejected.reason,"private_canary"),"fixed rejection message");
    }
    assert(not B.bundle_with_lifecycle(main,fn(path){return "let again=import(\"dependency\");";},"init","work","release").ok,"cycles fail closed");
    assert(not B.bundle_with_lifecycle(main,fn(path){return "fn __pb_lifecycle_entry(){}";},"init","work","release").ok,"generated global collision fails closed");
}
let passed=try {exercise();true} catch false;try fs_remove(output) catch nil;
assert(passed,"native bundle lifecycle regression");print "native_bundle_lifecycle_pass";
