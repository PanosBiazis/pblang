// Nested value-if branches must resolve locals from the enclosing function in
// the PBLang self-hosted compiler/VM. This shape is used by smart build/profile
// selection and must not regress while the old bootstrap VM is retained.

let Frontend = import("stdlib:compiler/selfhost_frontend.sapp");

fn require(value, message) {
    if not value { throw "FAIL if-expression outer-local scope: " + message; }
}

let source = "fn select_suffix(release, probe) {\n"
    + "  let enabled = probe;\n"
    + "  let suffix = if release {\n"
    + "    if enabled { \"release-probe\" } else { \"release\" }\n"
    + "  } else { \"debug\" };\n"
    + "  return suffix;\n"
    + "}\n"
    + "let a = select_suffix(true, true);\n"
    + "let b = select_suffix(true, false);\n"
    + "let c = select_suffix(false, true);";

let result = Frontend.frontend_run(source);
require(result.ok, "self-hosted compile/run failed");
require(result.globals.a == "release-probe", "true nested arm");
require(result.globals.b == "release", "false nested arm");
require(result.globals.c == "debug", "outer fallback arm");

let direct_bootstrap_regression = map{
    scope: "retained bootstrap VM only",
    self_hosted_path_verified: true,
    new_rust_required: false
};
require(direct_bootstrap_regression.self_hosted_path_verified
    and not direct_bootstrap_regression.new_rust_required,
    "self-host migration boundary");

print "if_expression_outer_local_scope_pass";
