// tests/semantics/parse_enrich2_test.sapp — wave 2 for stdlib/ui_parse.sapp + gui_parse.sapp
// ui_parse: find_first, flatten, node_types.  gui_parse: get_widget, has_widget.

let U = import("stdlib/ui_parse.sapp");
let G = import("stdlib/gui_parse.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn contains(arr, v) { let i = 0; while i < len(arr) { if arr[i] == v { return true; } i = i + 1; } return false; }

// ── ui_parse: nested tree section>(button,p) ──────────────────────────────────────
let nested = U.parse("fn render() { return html.tag(\"section\", html.tag(\"button\", \"Go\", map{}) + html.tag(\"p\", \"in\", map{}), map{}); }");

let btn = U.find_first(nested, "button");
if btn == nil { fail("find_first finds the button"); }
eq(btn.type, "button", "find_first returns the node");
eq(U.find_first(nested, "image"), nil, "find_first missing -> nil");

let flat = U.flatten(nested);
eq(len(flat), 3, "flatten yields all 3 nodes");

let types = U.node_types(nested);
if not contains(types, "section") { fail("node_types has section"); }
if not contains(types, "button") { fail("node_types has button"); }
eq(len(types), 3, "three distinct types");

// ── gui_parse: get_widget / has_widget ────────────────────────────────────────────
let code = "fn build() {\n"
    + "  let form = gui.form(\"T\", 100, 100);\n"
    + "  gui.add(form, gui.label(\"l1\", 0, 0, \"hi\"));\n"
    + "  gui.add(form, gui.button(\"b1\", 0, 0, 10, 10, \"OK\", on_click));\n"
    + "}\n";
let d = G.parse(code);

let w = G.get_widget(d, "b1");
if w == nil { fail("get_widget finds b1"); }
eq(w.kind, "button", "b1 is a button");
eq(G.get_widget(d, "nope"), nil, "get_widget missing -> nil");
if not G.has_widget(d, "l1") { fail("has_widget l1"); }
if G.has_widget(d, "zzz") { fail("has_widget zzz -> false"); }

print "parse_enrich2_pass";
