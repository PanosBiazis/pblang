let AD=import("stdlib:llm_adapters.sapp");
fn rejects(f) {return try {f();false} catch true;}
assert(not rejects(fn(){return 1;}) and rejects(fn(){throw "expected";}),"calibrated helper");
let model=map{lm_head:[[0.1,-0.1],[0.2,-0.2]],lm_bias:[0,0]};
let ad=AD.lm_head_adapter(model,1,2,5);ad.a_matrix=[[0.3],[-0.2]];ad.b_matrix=[[0.4,-0.1]];
let hidden=[0.7,-0.5];let q=[0.25,0.75];let saved=json_stringify([model,ad,hidden,q]);
fn objective(raw,q,t,w) {return (1-w)*AD.soft_target_loss(raw,q,t)+w*AD.soft_target_loss(raw,[0,1],1);}
for t in [0.25,1,2,8] {for w in [0,0.5,1] {
 let step=AD.train_supervised_step_clipped(model,ad,hidden,q,1,0.1,t,w,1000);
 let clipped=AD.train_supervised_step_clipped(model,ad,hidden,q,1,0.1,t,w,0.01);
 let displacement=0.0;let squared=0.0;let eps=0.00001;
 for key in ["a_matrix","b_matrix"] {for row len(ad[key]) {for col len(ad[key][row]) {
  let plus=json_parse(json_stringify(ad));let minus=json_parse(json_stringify(ad));
  plus[key][row][col]=plus[key][row][col]+eps;minus[key][row][col]=minus[key][row][col]-eps;
  let numerical=(objective(AD.logits(model,hidden,plus),q,t,w)-objective(AD.logits(model,hidden,minus),q,t,w))/(2*eps);
  squared=squared+numerical*numerical;
  let updated=if key=="a_matrix" {step.updated_a_matrix} else {step.updated_b_matrix};
  let actual=(ad[key][row][col]-updated[row][col])/0.1;let error=actual-numerical;
  assert(error*error<0.0000000001,"both factors match independent finite differences");
  let bounded=if key=="a_matrix" {clipped.updated_a_matrix} else {clipped.updated_b_matrix};
  let delta=ad[key][row][col]-bounded[row][col];displacement=displacement+delta*delta;
  error=delta-0.1*numerical*clipped.gradient_scale;
  assert(error*error<0.0000000000000001,"joint clipping preserves combined direction");
 }}}
 let error=clipped.gradient_norm-num_sqrt(squared);
 assert(error*error<0.0000000000000001 and displacement<=0.000001000001,"joint norm and displacement bound");
 assert(step.loss==objective(AD.logits(model,hidden,ad),q,t,w),"component objective before update");
 if w==0 or w==1 {
  let old=if w==0 {AD.train_soft_step_clipped(model,ad,hidden,q,0.1,t,1000)} else {AD.train_step(model,ad,hidden,1,0.1)};
  assert(json_stringify([step.updated_a_matrix,step.updated_b_matrix])==json_stringify([old.updated_a_matrix,old.updated_b_matrix]),"endpoint updates exactly preserve old kernels");
 }
}}
assert(saved==json_stringify([model,ad,hidden,q]),"no input mutation");
let zero=len([]);
for bad in [nil,true,"0",-1,1.01,0/zero,1/zero] {
 assert(rejects(fn(){AD.train_supervised_step_clipped(model,ad,hidden,q,1,0.1,2,bad,1);}),"weight bounds");
}
for bad in [nil,true,"1",-1,0.5,2,0/zero,1/zero] {
 assert(rejects(fn(){AD.train_supervised_step_clipped(model,ad,hidden,q,bad,0.1,2,0.5,1);}),"label bounds");
}
for bad in [nil,true,0,-1,1001,0/zero,1/zero] {
 assert(rejects(fn(){AD.train_supervised_step_clipped(model,ad,hidden,q,1,0.1,2,0.5,bad);}),"clipping bounds");
}
for bad in [nil,true,0,0.251,0/zero,1/zero] {
 assert(rejects(fn(){AD.train_supervised_step_clipped(model,ad,hidden,q,1,bad,2,0.5,1);}),"learning rate bounds");
}
assert(rejects(fn(){AD.train_supervised_step_clipped(model,ad,hidden,[0,0],1,0.1,2,1,1);}),"even hard-only requires valid teacher distribution");
assert(rejects(fn(){AD.train_supervised_step_clipped(model,ad,hidden,q,1,0.1,0,0.5,1);}),"temperature validation");
print "llm_supervised_distillation_pass";
