// tests/semantics/ollama_test.sapp — real local-ollama integration. The HTTP transport is
// injectable (fn(url,body)->text / fn(url)->text) so parsing/abstain logic is tested offline;
// a final guarded block does a LIVE smoke only when the ollama daemon is actually reachable.

let OLL = import("stdlib/ollama.sapp");
let PR = import("stdlib/provider_registry.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(list, v) { let i = 0; while i < len(list) { if list[i] == v { return true; } i = i + 1; } return false; }

// ── generate() extracts the `response` field from /api/generate JSON ───────────────────
let ok_post = fn(u, b) { return "{\"model\":\"llama3:latest\",\"response\":\"bugs\",\"done\":true}"; };
eq(OLL.generate("m", "p", ok_post), "bugs", "generate extracts the response text");

// error / unparseable transport -> nil (abstain), never crash
eq(OLL.generate("m", "p", fn(u, b) { return "error: connection refused"; }), nil, "error string -> nil");
eq(OLL.generate("m", "p", fn(u, b) { return "<<not json>>"; }), nil, "unparseable -> nil");
eq(OLL.generate("m", "p", fn(u, b) { throw "boom"; }), nil, "transport throw -> nil");

// ── available()/models()/default_model() parse /api/tags ──────────────────────────────
let tags_get = fn(u) { return "{\"models\":[{\"name\":\"llama3:latest\"},{\"name\":\"kimi:cloud\"}]}"; };
eq(OLL.available(tags_get), true, "available true when tags parse");
eq(OLL.available(fn(u) { return "error: refused"; }), false, "unavailable on error");
let ms = OLL.models(tags_get);
if not has(ms, "llama3:latest") { fail("models lists local model"); }
// default_model prefers a LOCAL (non :cloud) model
eq(OLL.default_model(tags_get), "llama3:latest", "default model is first local (non-cloud)");

// ── voter_caller() is a fn(msg)->text suitable for pbai.llm_voter's caller ─────────────
let vc = OLL.voter_caller("m", ok_post);
eq(vc("classify this"), "bugs", "voter_caller yields the model text");

// ── register() adds ollama to the provider_registry (OpenAI-compatible endpoint) ───────
PR.clear();
OLL.register();
eq(PR.has("ollama"), true, "register adds an ollama provider");
PR.clear();

// ── LIVE smoke: only runs if a real ollama daemon is reachable on this machine ─────────
if OLL.available() {
    let model = OLL.default_model();
    if model != nil {
        let t = OLL.generate(model, "Reply with only the single word: bugs");
        if not is_string(t) { fail("live ollama generate should return a string, got " + type(t)); }
    }
}

print "ollama_pass";
