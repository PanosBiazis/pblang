// tests/semantics/ollama_test.sapp — real local-ollama integration. The HTTP transport is
// injectable (fn(url,body)->text / fn(url)->text) so parsing/abstain logic is tested offline;
// a final guarded block does a LIVE smoke only when the ollama daemon is actually reachable.

let OLL = import("stdlib/ollama.sapp");
let PR = import("stdlib/provider_registry.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(list, v) { let i = 0; while i < len(list) { if list[i] == v { return true; } i = i + 1; } return false; }

// ── generate() extracts the `response` field from /api/generate JSON ───────────────────
let ok_post = fn(u, b) { return "{\"model\":\"llama3:latest\",\"response\":\"bugs\",\"done\":true}"; };
eq(OLL.generate("m", "p", ok_post), "bugs", "generate extracts the response text");
let generated = OLL.generate_result("llama3:latest", "bounded prompt", map{
    max_tokens: 7, temperature: 0.1
}, ok_post);
eq(generated.ok, true, "structured generation succeeds");
eq(generated.bounded, true, "structured generation reports bounded transport contract");

let embed_post = fn(u, b) {
    return "{\"model\":\"nomic-embed-text\",\"embeddings\":[[0.25,-0.5,0.75]]}";
};
let embedded = OLL.embed_result("nomic-embed-text", "alpha", map{}, embed_post);
eq(embedded.ok, true, "embed_result parses /api/embed response");
eq(embedded.dimensions, 3, "embedding dimensions are exact");
eq(embedded.embedding[1], -0.5, "embedding values are retained");

let tokenized = OLL.tokenize_result("llama3", "alpha beta", map{}, fn(u, b) {
    if not str_ends_with(u, "/api/tokenize") { fail("tokenize endpoint"); }
    return "{\"model\":\"llama3\",\"tokens\":[101,202,303]}";
});
eq(tokenized.ok, true, "tokenize_result parses bounded token ids");
eq(tokenized.token_count, 3, "tokenize_result reports exact count");
eq(OLL.tokenize_result("m", "p", map{}, fn(u, b) { return "{\"tokens\":[1.5]}"; }).ok,
   false, "non-integer token ids are rejected");

// error / unparseable transport -> nil (abstain), never crash
eq(OLL.generate("m", "p", fn(u, b) { return "error: connection refused"; }), nil, "error string -> nil");
eq(OLL.generate("m", "p", fn(u, b) { return "<<not json>>"; }), nil, "unparseable -> nil");
eq(OLL.generate("m", "p", fn(u, b) { throw "boom"; }), nil, "transport throw -> nil");
eq(OLL.embed_result("m", "p", map{}, fn(u, b) { return "{\"embeddings\":[[]]}"; }).ok,
   false, "empty embedding is rejected");

let remote_host = try OLL.set_host("http://example.com:11434") catch "refused";
eq(remote_host, "refused", "remote Ollama host is refused");
let cloud = try OLL.generate_result("remote:cloud", "p", map{}, ok_post) catch "refused";
eq(cloud, "refused", "cloud model is refused by default");
let huge = "x";
while len(huge) <= OLL.MAX_PROMPT_CHARS { huge = huge + huge; }
let oversized = try OLL.generate_result("m", huge, map{}, ok_post) catch "refused";
eq(oversized, "refused", "oversized prompt is refused before transport");
let unknown_option = try OLL.generate_result("m", "p", map{ surprise: true }, ok_post) catch "refused";
eq(unknown_option, "refused", "unknown generation options fail closed");

// ── available()/models()/default_model() parse /api/tags ──────────────────────────────
let tags_get = fn(u) { return "{\"models\":[{\"name\":\"llama3:latest\"},{\"name\":\"kimi:cloud\"}]}"; };
eq(OLL.available(tags_get), true, "available true when tags parse");
eq(OLL.available(fn(u) { return "error: refused"; }), false, "unavailable on error");
let ms = OLL.models(tags_get);
if not has(ms, "llama3:latest") { fail("models lists local model"); }
// default_model prefers a LOCAL (non :cloud) model
eq(OLL.default_model(tags_get), "llama3:latest", "default model is first local (non-cloud)");

// ── voter_caller() is a fn(msg)->text suitable for pbai.llm_voter's caller ─────────────
let vc = OLL.voter_caller("m", ok_post);
eq(vc("classify this"), "bugs", "voter_caller yields the model text");

// ── register() adds ollama to the provider_registry (OpenAI-compatible endpoint) ───────
PR.clear();
OLL.register();
eq(PR.has("ollama"), true, "register adds an ollama provider");
PR.clear();

// Live model execution is explicit because loading a multi-GB model is expensive.
if (try env_get("PBLANG_OLLAMA_LIVE_TEST") catch "") == "1" and OLL.available() {
    let model = OLL.default_model();
    if model != nil {
        let t = OLL.generate(model, "Reply with only the single word: bugs");
        if not is_string(t) { fail("live ollama generate should return a string, got " + type(t)); }
        if (try env_get("PBLANG_OLLAMA_LIVE_EMBED_TEST") catch "") == "1" {
            let e = OLL.embed_result(model, "bounded embedding smoke");
            if not e.ok or e.dimensions < 1 { fail("live Ollama embedding should return a vector"); }
        }
    }
}

print "ollama_pass";
