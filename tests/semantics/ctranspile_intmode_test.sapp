// Test: the INTEGER codegen mode of the C transpiler (PrjAnalysis §73).
//
// `transpile_kernel_int` / `transpile_freestanding_int` lower every pblang number
// to C `long` instead of `double`, producing FLOAT-RUNTIME-FREE kernels: no SSE, no
// soft-float libgcc. This is what lets a kernel that installs GCC interrupt handlers
// (`isr...` fns, which require -mgeneral-regs-only — no floating point) actually LINK
// and BOOT. Verified end-to-end offline: the generated kernel compiles with
//   gcc -m32 -ffreestanding -nostdlib -fno-pie -mgeneral-regs-only -c
// links with `ld -m elf_i386`, and BOOTS in QEMU where a fired `int $0x30` runs the
// pblang ISR (self-proving: marker 42 -> isa-debug-exit code 85). Here we lock the
// codegen contract (the boot itself can't run inside the pblang test runner).

let ct = import("stdlib/compiler/ctranspile.sapp");
let intr = fs_read("stdlib/kernel/interrupts.sapp");

let src = "fn isr_soft() { poke8(36864, 42); } "
    + "fn kmain() { let idt = kmalloc(2048); "
    + "idt_set_gate(idt, 48, addr_of(\"isr_soft\"), 8, 142); idt_load(idt); "
    + "let arr = [10, 20, 12]; let s = arr[0] + arr[1] + arr[2]; "
    + "let p = map{ x: s, y: 7 }; outb(244, p.x); while 1 > 0 { hlt(); } }";

// ── Integer mode: everything is `long`, nothing is `double` ─────────────────────────
let ci = ct.transpile_kernel_int(intr + src);
assert(not str_contains(ci, "double"), "INT MODE: no `double` anywhere (float-runtime-free)");
assert(str_contains(ci, "long kmain("), "kmain returns long");
assert(str_contains(ci, "long idt_set_gate(long idt_base"), "params lowered to long");
assert(str_contains(ci, "static long kmalloc(long n)"), "bump allocator is long-typed");
// Interrupt handler stays a proper void interrupt routine (it returns nothing)...
assert(str_contains(ci, "__attribute__((interrupt)) void isr_soft(void* _frame)"), "ISR still emitted as a GCC interrupt handler");
// ...but its body and addr_of are float-free.
assert(str_contains(ci, "(long)(u64)&isr_soft"), "addr_of lowers to a long in int mode");
// Aggregates lower through long* (not double*).
assert(str_contains(ci, "(long*)(u64)"), "array/struct access casts through long* in int mode");
assert(not str_contains(ci, "(double*)(u64)"), "no double* casts in int mode");

// ── Float mode unchanged (regression): numbers stay `double` ────────────────────────
let cf = ct.transpile_kernel(intr + src);
assert(str_contains(cf, "double kmain("), "FLOAT MODE: kmain still returns double");
assert(str_contains(cf, "static double kmalloc(double n)"), "FLOAT MODE: allocator still double");
assert(str_contains(cf, "(double*)(u64)"), "FLOAT MODE: still casts through double*");

// ── Mode does not leak across calls (int call restores the float default) ───────────
let cf2 = ct.transpile_kernel(intr + src);
assert(str_contains(cf2, "double kmain("), "after an int-mode call, float mode is restored");

// ── Freestanding int profile is float-free too ──────────────────────────────────────
let fi = ct.transpile_freestanding_int("fn add(a, b) { return bit_and(a + b, 255); }");
assert(str_contains(fi, "long add(long a, long b)"), "freestanding int: long signature");
assert(not str_contains(fi, "double"), "freestanding int: float-free");

print "ctranspile_intmode_pass";
