let F = import("stdlib:compiler/selfhost_frontend.sapp");
fn expect(ok, label) { if not ok { throw "FAIL selfhost-super-owner: " + label; } }
let source = "let C = import(\"stdlib:class.sapp\"); let visits = [];"
    + "let Base = C.define(\"Base\", [], map{ value: fn(self, x) { push(visits, \"base\"); return x * 2; }, fail: fn(self) { throw 7; } });"
    + "let Middle = nil; Middle = C.extend(Base, \"Middle\", [], map{ value: fn(self, x) { push(visits, \"middle\"); return C.super1(self, \"value\", x, Middle) + 1; }, fail: fn(self) { return C.super_call(self, \"fail\", Middle); } });"
    + "let Leaf = C.extend(Middle, \"Leaf\"); let obj = C.new(Leaf);"
    + "let value = C.bind1(obj, \"value\")(4);"
    + "let failed = try map{ ok: true, value: C.call(obj, \"fail\") } catch map{ ok: false };"
    + "let invalid = try map{ ok: true, value: C.super_method(obj, \"value\", map{}) } catch map{ ok: false };"
    + "let legacy = C.super1(C.new(Middle), \"value\", 5);"
    + "let result = [value, visits, failed.ok, invalid.ok, C.class_name(obj), legacy];";
let result = F.frontend_run_bounded(source, map{ max_steps: 20000, max_frames: 32, max_modules: 8, max_source_bytes: 32768 });
expect(result.ok, "actual class library import and execution");
expect(result.globals.result == [9, ["middle", "base", "base"], false, false, "Leaf", 10], "exact dispatch results/effects and unchanged identity");
print "selfhost_super_owner_pass";
