let mcp = import("stdlib:pb_mcp.sapp");
let pbai = import("stdlib:pbai.sapp");

let ctx = mcp.workspace_context();
assert(ctx.native == true, "workspace context is pblang-native");
assert(len(ctx.tools) >= 5, "tool catalog in context");

let catalog = pbai.tool_catalog();
assert(len(catalog) >= 5, "pbAI exposes tool catalog");

let self_text = mcp.read_file("stdlib/pb_mcp.sapp", 1, 20);
assert(str_contains(self_text, "pb_mcp"), "read_file reads workspace file");

let tail = mcp.read_file_tail("stdlib/pb_mcp.sapp", 5);
assert(str_contains(tail, "export"), "read_file_tail works");

let files = mcp.list_files("stdlib", 40);
assert(len(files) > 0, "list_files returns files");

let tree = mcp.project_tree("stdlib", 1, 30);
assert(str_contains(tree, "pb_mcp.sapp") or len(tree) > 0, "project_tree returns text");

let hits = mcp.grep_code("workspace_context", "stdlib", 20);
assert(len(hits) > 0, "grep_code finds symbol");
assert(str_contains(hits[0].path, "pb_mcp") or str_contains(hits[0].text, "workspace_context"), "grep hit shape");

let via_ai = pbai.tool_call("grep_code", map{ pattern: "typeclass", dir: "stdlib", max_matches: 5 });
assert(len(via_ai) > 0, "pbAI can call pb_mcp tools");

let answer = pbai.respond("what mcp tools can you use in this workspace?");
assert(str_contains(answer, "pb_mcp") and str_contains(answer, "read_file"), "pbAI explains tool bridge");

let blocked = try mcp.read_file("../Cargo.toml") catch "blocked";
assert(blocked == "blocked", "path traversal blocked");

print "pb_mcp_bridge_pass";
