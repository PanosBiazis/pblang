// Test: stdlib/pkg.sapp — package manifest + semver + validation + resolution
// (the foundation of a pblang package system; ecosystem weakness).

let pkg = import("stdlib:pkg.sapp");

// --- Manifest + validation ---
let m = pkg.manifest("mylib", "1.2.0", ["stdlib:functional.sapp"]);
assert(m.name == "mylib" and m.version == "1.2.0", "manifest fields");
let v = pkg.validate(m);
assert(v.ok == true, "well-formed manifest validates");

let bad = pkg.manifest("", "not-a-version", "notarray");
let vb = pkg.validate(bad);
assert(vb.ok == false, "bad manifest fails validation");
assert(len(vb.errors) == 3, "all three problems reported (name, version, deps)");

// --- Semver comparison ---
assert(pkg.semver_compare("1.2.3", "1.2.3") == 0, "equal versions");
assert(pkg.semver_compare("1.2.0", "1.10.0") == 0 - 1, "1.2.0 < 1.10.0 (numeric, not lexical)");
assert(pkg.semver_compare("2.0.0", "1.9.9") == 1, "2.0.0 > 1.9.9");
let pv = pkg.semver_parse("3.5.7");
assert(pv[0] == 3 and pv[1] == 5 and pv[2] == 7, "semver_parse");

// --- Constraint satisfaction ---
assert(pkg.semver_satisfies("1.4.2", "^1.2.0") == true, "^1.2.0 accepts 1.4.2 (same major, >=)");
assert(pkg.semver_satisfies("2.0.0", "^1.2.0") == false, "^1.2.0 rejects 2.0.0 (major bump)");
assert(pkg.semver_satisfies("1.1.0", "^1.2.0") == false, "^1.2.0 rejects 1.1.0 (below base)");
assert(pkg.semver_satisfies("1.2.9", "~1.2.0") == true, "~1.2.0 accepts 1.2.9 (same minor)");
assert(pkg.semver_satisfies("1.3.0", "~1.2.0") == false, "~1.2.0 rejects 1.3.0 (minor bump)");
assert(pkg.semver_satisfies("1.5.0", ">=1.2.0") == true, ">=1.2.0 accepts 1.5.0");
assert(pkg.semver_satisfies("1.0.0", ">=1.2.0") == false, ">=1.2.0 rejects 1.0.0");
assert(pkg.semver_satisfies("9.9.9", "*") == true, "* accepts anything");
assert(pkg.semver_satisfies("1.2.0", "1.2.0") == true, "exact match");

// --- Dependency resolution against real files ---
assert(pkg.dep_path("stdlib:functional.sapp") == "stdlib/functional.sapp", "dep_path maps stdlib:");
let r = pkg.resolve(pkg.manifest("app", "0.1.0", ["stdlib:functional.sapp", "stdlib:nn.sapp"]));
assert(r.ok == true, "all real deps resolve");
assert(len(r.resolved) == 2, "two deps resolved to file paths");
let r2 = pkg.resolve(pkg.manifest("app", "0.1.0", ["stdlib:does_not_exist_xyz.sapp"]));
assert(r2.ok == false and len(r2.missing) == 1, "a missing dep is reported");

print "pkg_pass";
