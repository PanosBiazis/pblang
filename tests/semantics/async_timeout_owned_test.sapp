let A = import("stdlib:async.sapp");
fn expect(value, message) { if not value { throw "FAIL owned timeout: " + message; } }
let started = clock();
let delayed = A.timeout(5, fn(){ sleep_ms(400); return 17; });
expect(not delayed.ready and not delayed.ok, "deadline miss has explicit status");
expect((clock()-started)*1000 < 300, "wait does not join unfinished worker");
expect(not delayed.future.resolved, "future still owned");
expect(A.await(delayed.future) == 17, "late worker can be joined");
expect(A.await(delayed.future) == 17, "late result cached");
for task in [fn(){return nil;}, fn(){return false;}, fn(){return map{__async_threw:true};}] {
    let done = A.timeout(500, task);
    expect(done.ready and done.ok, "nil/false/map success distinguished from timeout");
    expect(A.await(done.future) == done.value, "terminal result preserved");
}
let failed = A.timeout(500, fn(){throw "failed";});
expect(failed.ready and not failed.ok, "task failure distinguished from timeout");
expect((try A.await(failed.future) catch "failed") == "failed", "failure retained");
for ms in [-1, 0.5, "5", nil, true, num_exp(1000), num_sqrt(-1)] {
    expect((try A.timeout(ms, fn(){return 1;}) catch "invalid") == "invalid", "invalid duration rejected before spawn");
}
let no_wait = A.timeout(0, fn(){sleep_ms(30);return 8;});
expect(not no_wait.ready, "zero duration does not wait");
expect(A.await(no_wait.future) == 8, "zero duration still owns work");
fn make_task(captured) { return fn(){return captured + 3;}; }
let nested = A.go(make_task(12));
expect(A.await(nested) == 15, "captured data preserved by worker boundary");
let nested_task = A.go(fn(){
    let inner = import("stdlib:async.sapp");
    let state = inner.timeout(500, fn(){return 9;});
    return inner.await(state.future);
});
expect(A.await(nested_task) == 9, "nested workers retain independent ownership");
print "async_timeout_owned_pass";
