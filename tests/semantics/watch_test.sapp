// tests/semantics/watch_test.sapp
// pblang Watchers: unified observability + reverse-engineering facade.
let w = import("stdlib:watch.sapp");

fn fail(m) { throw "FAIL " + m; }
fn has_op(d, name) { for i len(d) { if d[i].name == name { return true; } } return false; }

// ── bytecode / opcode capture (lowest level) ─────────────────────────────────
let d = w.disasm("let x = 1 + 2;");
if len(d) == 0 { fail("disasm returned nothing"); }
if not has_op(d, "ADD") { fail("disasm should show an ADD opcode for 1 + 2"); }
if d[0].name == "" { fail("disasm entries need opcode names"); }

let hist = w.opcode_histogram("let a = 1 + 2; let b = 3 + 4;");
if hist.ADD != 2 { fail("opcode_histogram should count 2 ADD (got " + str(try hist.ADD catch 0) + ")"); }

let bc = w.bytecode("let x = 1 + 2;");
if not bc.ok or bc.instructions <= 0 { fail("bytecode summary"); }

// ── runtime probes ───────────────────────────────────────────────────────────
let h = w.heap();
if h.string_allocs == nil or h.string_allocs <= 0 { fail("heap() should report string_allocs"); }
let snap = w.capture_all();
let keys = map_keys(snap);
if not (map_has(snap, "time_ms") and map_has(snap, "heap") and map_has(snap, "memory") and map_has(snap, "compute")) {
    fail("capture_all missing keys: " + str(keys));
}

// ── watcher: snapshot / watch-a-block / diff ─────────────────────────────────
let wt = w.watcher("t");
let res = w.watch(wt, "alloc", fn() {
    let a = [];
    let i = 0;
    while i < 200 { array_push(a, i); i = i + 1; }
    return len(a);
});
if res.result != 200 { fail("watch should return the block's result"); }
if res.ms < 0 { fail("watch elapsed ms"); }
if not map_has(res.delta, "allocations") { fail("watch delta needs allocations"); }
if len(wt.snapshots) != 2 { fail("watch records before+after (got " + str(len(wt.snapshots)) + ")"); }

// diff of two explicit snapshots
let a1 = w.capture_all();
let a2 = w.capture_all();
let dd = w.diff(a1, a2);
if not map_has(dd, "ms") or not map_has(dd, "allocations") { fail("diff shape"); }

// ── reverse engineering: binary inspect + hexdump ────────────────────────────
let hx = w.hexdump([0, 255, 16, 171]);
if not str_contains(hx, "ff") or not str_contains(hx, "ab") { fail("hexdump hex output"); }

let bin = w.binary("stdlib/watch.sapp");
if not bin.available or bin.size <= 0 { fail("binary inspect should read the file"); }
if type(bin.entropy) != "number" { fail("binary entropy should be a number"); }
if bin.entropy < 0 { fail("entropy non-negative"); }

// ── live sampling (time-series) ──────────────────────────────────────────────
let series = w.sample(w.compute, 3, 5);
if len(series) != 3 { fail("sample should yield 3 samples"); }
if not map_has(series[0], "at") or not map_has(series[0], "value") { fail("sample shape"); }

// ── sampling modes: discrete / continuous / until ───────────────────────────
if len(w.sample_modes()) < 2 { fail("need at least discrete + continuous modes"); }

// continuous: dense series until a short duration elapses
let cont = w.sample_continuous(w.compute, 20);
if len(cont) < 1 { fail("sample_continuous should produce samples"); }
if not map_has(cont[0], "value") { fail("continuous sample shape"); }

// until (triggered): count to 3 via a mutable box, predicate stops it
let box = map{ n: 0 };
let trig = w.sample_until(fn() { box.n = box.n + 1; return box.n; }, fn(v) { return v >= 3; }, 10, 1);
if trig[len(trig) - 1].value != 3 { fail("sample_until should stop at predicate (got " + str(trig[len(trig) - 1].value) + ")"); }

// unified stream dispatch (discrete)
let st = w.stream(w.compute, map{ mode: "discrete", n: 2, interval_ms: 1 });
if len(st) != 2 { fail("stream discrete n=2"); }

// ── probe registry ───────────────────────────────────────────────────────────
if len(w.probes()) < 5 { fail("probe registry should list domains"); }
let t = w.probe("time");
if not map_has(t, "time_ms") { fail("probe('time')"); }

print "watch_pass";
