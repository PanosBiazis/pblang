// tests/semantics/logger_stdlib_test.sapp
let log = import("stdlib:logger.sapp");

// Test logger creation
let l = log.new("test");
if l.name != "test" { throw "FAIL logger name"; }

// Test level filtering: set to error, info should be suppressed
log.set_level("error");
if log.get_level() != "error" { throw "FAIL get_level"; }

// Reset to info
log.set_level("info");
if log.get_level() != "info" { throw "FAIL reset level"; }

// Test child logger
let child = l.child("sub");
if child.name != "test.sub" { throw "FAIL child name"; }

// Test that root logger exists
if log.root == nil { throw "FAIL root logger"; }

print "logger_stdlib_pass";
