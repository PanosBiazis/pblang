// tests/semantics/linker_local_symbol_test.sapp
//
// The portable linker substrate (stdlib/linker.sapp) dropped LOCAL symbols
// (global:false) entirely: _resolve_symbols only recorded globals, so a relocation
// targeting a local symbol defined in the SAME object was falsely reported as
// "undefined symbol" and the link failed. Local symbols are valid relocation
// targets in real object linking (static functions, local labels), and two objects
// may each define a local of the SAME name without colliding. The linker must
// resolve a relocation's symbol against its OWN object's locals first, then the
// global table, and expose the resolved target address.

let lk = import("stdlib/linker.sapp");

fn fail(m) { throw "FAIL " + m; }
fn expect(c, m) { if not c { fail(m); } }

// 1. A relocation targeting a local symbol in the same object must link, and the
//    relocation must resolve to that local's address (.text @4096, loc @offset 2).
let obj = lk.object("a.o",
    [lk.section(".text", [1, 2, 3, 4], ["alloc", "exec"], 16)],
    [lk.symbol("_start", ".text", 0, true), lk.symbol("loc", ".text", 2, false)],
    [lk.relocation(".text", 0, "loc", "abs64", 0)]
);
let img = lk.link([obj], map{base: 4096});
expect(img.ok, "local-symbol relocation must link (was 'undefined symbol'): " + str(img.diagnostics));
expect(img.relocations[0].target_address == 4098, "reloc must resolve to the local's address 4098, got " + str(try img.relocations[0].target_address catch "nil"));
// Local symbols stay OUT of the global symbol table (they're per-object).
expect(not map_has(img.symbols, "loc"), "local symbol must not pollute the global table");

// 2. Two objects each defining a local "tmp" must NOT collide, and each
//    relocation resolves to its own object's local.
let o1 = lk.object("one.o",
    [lk.section(".text", [0, 0, 0, 0], ["alloc"], 16)],
    [lk.symbol("tmp", ".text", 0, false)],
    [lk.relocation(".text", 0, "tmp", "abs64", 0)]
);
let o2 = lk.object("two.o",
    [lk.section(".text", [0, 0, 0, 0], ["alloc"], 16)],
    [lk.symbol("tmp", ".text", 0, false)],
    [lk.relocation(".text", 0, "tmp", "abs64", 0)]
);
let img2 = lk.link([o1, o2], map{base: 4096});
expect(img2.ok, "same-named locals in two objects must not collide: " + str(img2.diagnostics));
// one.o .text @4096; two.o .text aligned after (4 bytes -> 4112 with align 16).
expect(img2.relocations[0].target_address == 4096, "first local @4096, got " + str(img2.relocations[0].target_address));
expect(img2.relocations[1].target_address == 4112, "second local @4112, got " + str(img2.relocations[1].target_address));

// 3. Regression: a genuinely undefined relocation symbol still fails.
let bad = lk.object("b.o",
    [lk.section(".text", [1, 2], ["alloc"], 16)],
    [lk.symbol("_start", ".text", 0, true)],
    [lk.relocation(".text", 0, "nope", "abs64", 0)]
);
let imgb = lk.link([bad], map{base: 4096});
expect(not imgb.ok, "truly undefined symbol must still fail");
expect(str_contains(imgb.diagnostics[0], "undefined symbol"), "undefined diagnostic preserved");

// 4. Regression: a global-symbol relocation across objects still resolves.
let maino = lk.object("main.o",
    [lk.section(".text", [1, 2, 3, 4], ["alloc"], 16)],
    [lk.symbol("_start", ".text", 0, true)],
    [lk.relocation(".text", 0, "helper", "abs64", 0)]
);
let helpo = lk.object("help.o",
    [lk.section(".text", [9, 9], ["alloc"], 16)],
    [lk.symbol("helper", ".text", 0, true)],
    []
);
let img4 = lk.link([maino, helpo], map{base: 4096});
expect(img4.ok, "global cross-object relocation still links");
expect(img4.relocations[0].target_address == 4112, "global reloc resolves to helper @4112, got " + str(img4.relocations[0].target_address));

print "linker_local_symbol_pass";
