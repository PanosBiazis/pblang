let B=import("stdlib:compiler/vm_builtins.sapp");
let V=import("stdlib:compiler/vm.sapp");
let F=import("stdlib:compiler/selfhost_frontend.sapp");

// Compiler metadata is independent of engine state; callers cannot mutate it.
let names=B.memory_registry();
assert(len(names)==17,"memory name coverage");
names.memory_alloc=false; names.injected=true;
assert(B.memory_registry().memory_alloc,"fresh metadata");
assert(not map_has(B.memory_registry(),"injected"),"metadata mutation isolated");
let all=B.registry();
for key in map_keys(B.memory_registry()) { assert(map_has(all,key),"shared builtin coverage"); }
assert(F.frontend_compile("memory_alloc(7);").ok,"memory source compiles");
let empty=V.execution_context();
V.close_execution(empty);V.close_execution(empty);
assert(empty.memory==nil,"empty close does not create state");
assert(F.frontend_run("print 42;").output==[42],"ordinary scalar execution");

// Caller-owned engine state still closes without executing a guest call.
let E=import("stdlib:compiler/vm_memory.sapp");
assert(E.registry()==B.memory_registry(),"legacy registry parity");
let preset=V.execution_context();preset.memory=E.new_state();
let state=preset.memory;
E.dispatch(state,"memory_alloc",[99],1);
V.close_execution(preset);
assert(state.closed and len(state.owners)==0 and preset.memory==nil,"preexisting engine closes");

let compiled=F.frontend_compile("let h=memory_alloc(7);print memory_get(h);print memory_stats().total_locations;");
assert(compiled.ok,"ownership fixture compiles");
for bounded in [false,true] {
    let first=V.execution_context();let second=V.execution_context();
    let a=if bounded { V.run_seeded_bounded(compiled.chunk,map{},nil,first) }
        else { V.run_seeded(compiled.chunk,map{},first) };
    let b=if bounded { V.run_seeded_bounded(compiled.chunk,map{},nil,second) }
        else { V.run_seeded(compiled.chunk,map{},second) };
    assert(a.output==[7,1] and b.output==[7,1],"independent contexts");
    let retained=first.memory;
    V.close_execution(first);
    assert(retained.closed and len(retained.owners)==0,"first reclaimed");
    assert(not second.memory.closed and E.stats(second.memory).total_locations==1,"second remains live");
    V.close_execution(second);V.close_execution(second);
}
assert(F.frontend_run("let alloc=memory_alloc;let h=alloc(11);print memory_get(h);").output==[11],"first-class memory builtin");
assert(F.frontend_run("fn memory_alloc(x){return x+1;}print memory_alloc(3);").output==[4],"shadowing preserved");
// Metadata must remain independently linkable without an engine in the graph.
let L=import("stdlib:source_inliner.sapp");
let linked=L.link_modules(
    "let B=import(\"stdlib:compiler/vm_builtins.sapp\");print B.memory_registry().memory_alloc;",
    map{"stdlib:compiler/vm_builtins.sapp":fs_read("stdlib/compiler/vm_builtins.sapp")});
assert(linked.ok,"metadata graph has no ownership-engine dependency");
assert(F.frontend_run(linked.source).output==[true],"linked metadata executes");
print "selfhost_memory_metadata_pass";
