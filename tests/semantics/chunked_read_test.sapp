// tests/semantics/chunked_read_test.sapp
// Tests _parse_hex logic (used by chunked_read) via inline re-implementation
// using VM builtins str_index_of, str_slice, str_lower (W3-gamma).

fn parse_hex_test(s) {
    let digits = "0123456789abcdef";
    let result = 0;
    let i = 0;
    while i < len(s) {
        let c = str_lower(str_slice(s, i, i + 1));
        let d = str_index_of(digits, c);
        if d < 0 { return result; }
        result = result * 16 + d;
        i = i + 1;
    }
    return result;
}

if parse_hex_test("0") != 0 { throw "fail"; }
if parse_hex_test("1") != 1 { throw "fail"; }
if parse_hex_test("a") != 10 { throw "fail"; }
if parse_hex_test("f") != 15 { throw "fail"; }
if parse_hex_test("10") != 16 { throw "fail"; }
if parse_hex_test("ff") != 255 { throw "fail"; }
if parse_hex_test("1a3") != 419 { throw "fail"; }
if parse_hex_test("A") != 10 { throw "fail"; }
if parse_hex_test("FF") != 255 { throw "fail"; }

print "chunked_read_parse_hex_pass";
