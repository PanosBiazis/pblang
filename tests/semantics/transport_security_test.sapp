let Guard = import("stdlib:transport_security.sapp");
fn require(ok, message) { if not ok { throw "FAIL transport_security: " + message; } }

let identity = Guard.signal_fingerprint("peer-address", "device-a");
let gateway_a = Guard.signal_fingerprint("gateway", "192.0.2.1|aa:bb");
let gateway_b = Guard.signal_fingerprint("gateway", "192.0.2.2|cc:dd");
let guard = Guard.new(map{ expected_identity: identity, max_nonces: 16 });
let first = map{ transport: "wifi", purpose: "connectivity",
    protocol: "pbremote-e2e", application_authenticated: true,
    identity_fingerprint: identity, sequence: 0,
    nonce: "nonce-00000000001", gateway_fingerprint: gateway_a };
require(Guard.approve_signal_baseline(guard, first).ok, "authenticated baseline approval");
require(Guard.observe(guard, first).ok, "authenticated Wi-Fi observation");

let changed = map{ transport: "wifi", purpose: "connectivity",
    protocol: "pbremote-e2e", application_authenticated: true,
    identity_fingerprint: identity, sequence: 1,
    nonce: "nonce-00000000002", gateway_fingerprint: gateway_b };
let warned = Guard.observe(guard, changed);
require(warned.ok and warned.needs_signal_confirmation and len(warned.signal_changes) == 1,
    "gateway change warns without false-positive block");

let replay = Guard.observe(guard, changed);
require(not replay.ok and replay.blocked, "replay rejected");
let downgrade = map{ transport: "wifi", purpose: "connectivity", protocol: "tls12",
    application_authenticated: true, identity_fingerprint: identity, sequence: 2,
    nonce: "nonce-00000000003" };
require(not Guard.observe(guard, downgrade).ok, "downgrade rejected");
let impostor = map{ transport: "bluetooth", purpose: "connectivity",
    protocol: "pbremote-e2e", application_authenticated: true,
    identity_fingerprint: Guard.signal_fingerprint("peer-address", "device-b"),
    sequence: 2, nonce: "nonce-00000000004" };
require(not Guard.observe(guard, impostor).ok, "identity substitution rejected");

let changed_transport = map{ transport: "usb", purpose: "connectivity",
    protocol: "pbremote-e2e", application_authenticated: true,
    identity_fingerprint: identity, sequence: 2,
    nonce: "nonce-00000000007", data_enabled: true };
let transport_warned = Guard.observe(guard, changed_transport);
require(transport_warned.ok and transport_warned.needs_signal_confirmation
    and len(transport_warned.signal_changes) == 1
    and transport_warned.signal_changes[0] == "transport",
    "carrier change warns without treating either carrier as malicious");

let wrong_baseline = map{ transport: "bluetooth", purpose: "connectivity",
    protocol: "pbremote-e2e", application_authenticated: true,
    identity_fingerprint: Guard.signal_fingerprint("peer-address", "device-b"),
    sequence: 3, nonce: "nonce-00000000008" };
require(not Guard.approve_signal_baseline(guard, wrong_baseline).ok,
    "untrusted identity cannot replace carrier baseline");

let charger = Guard.new(map{ minimum_protocol: "none",
    require_application_authentication: false, max_nonces: 16 });
let hostile_charge = map{ transport: "charger", purpose: "charging", protocol: "none",
    application_authenticated: false, sequence: 0, nonce: "nonce-00000000005",
    data_enabled: true, charging: true };
require(not Guard.observe(charger, hostile_charge).ok, "charging data path rejected");
let charge_only = map{ transport: "charger", purpose: "charging", protocol: "none",
    application_authenticated: false, sequence: 0, nonce: "nonce-00000000006",
    data_enabled: false, charging: true };
require(Guard.observe(charger, charge_only).ok, "charge-only carrier accepted");

let snapshot = Guard.trusted_snapshot(guard);
snapshot.signal_baseline.gateway_fingerprint = gateway_b;
let snapshot_again = Guard.trusted_snapshot(guard);
require(snapshot_again.signal_baseline.gateway_fingerprint == gateway_a,
    "snapshot cannot mutate live signal baseline");
require(snapshot_again.transport_baseline == "wifi",
    "approved transport baseline persists without exposing identifiers");
let restored = Guard.restore_trusted(snapshot);
require(snapshot.ok and restored.ok and Guard.status(restored.guard).pinned_identity,
    "trusted pins restore without replay/session state");
require(not Guard.status(guard).raw_identifiers_exposed, "status redacts identifiers");
print "transport_security_pass";
