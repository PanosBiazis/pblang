let AI=import("stdlib/pbai.sapp");let N=import("stdlib:pbai_neural_adapter.sapp");
let bound=AI.neural_specialist_bind(N);
fn rejects(f){return try {f();false} catch true;}
assert(rejects(fn(){throw "calibration";}) and not rejects(fn(){return 1;}),"calibrated exception helper");
let teacher=N.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let artifact=N.distill(teacher.artifact,[[0],[1,0]],[map{x:[7,0],y:4}]).checkpoint();
let active=N.student_load(artifact);let expected=json_stringify(active.predict([6,0]));
let original=N.student_encode(artifact);let cycle=[];push(cycle,cycle);let count=0;
for make in [N.student_continue,AI.neural_specialist_student_continue,bound.student_continue] {
 let handle=make(artifact,[map{x:[2,0],y:4}],[map{x:[4,0],y:4}],map{epochs:16,lr:0.05,max_grad_norm:1});
 let checkpoint=handle.checkpoint();let encoded=N.student_encode(checkpoint);
 let report=handle.report;let report_text=json_stringify(report);
 let output=handle.predict([6,0]);let output_text=json_stringify(output);
 let metric=handle.evaluate([map{x:[6,0],y:4}]);let metric_text=json_stringify(metric);
 let predict=handle.predict;let evaluate=handle.evaluate;let export_checkpoint=handle.checkpoint;let close=handle.close;
 assert(close() and not handle.close(),"terminal idempotent close through saved method");
 for ids in [[6,0],nil,[],cycle] {assert(rejects(fn(){predict(ids);}),"closed predictions reject valid and malformed input");}
 for examples in [[map{x:[6,0],y:4}],nil,[],cycle] {assert(rejects(fn(){evaluate(examples);}),"closed evaluation rejects all inputs");}
 assert(rejects(export_checkpoint),"saved checkpoint method cannot reopen model");
 handle.closed=false;handle.report=map{};
 assert(rejects(fn(){handle.predict([6,0]);}) and not close(),"public mutation cannot reopen private state");
 assert(N.student_encode(checkpoint)==encoded and json_stringify(report)==report_text
  and json_stringify(output)==output_text and json_stringify(metric)==metric_text,"exports stay caller owned after close");
 let restored=N.student_load(checkpoint);assert(restored.checkpoint().digest==checkpoint.digest and restored.close(),"export remains reloadable");
 assert(N.student_encode(artifact)==original and json_stringify(active.predict([6,0]))==expected,"parent artifact and active model unchanged");
 count=count+1;
}
assert(active.close() and count==3,"three routes and explicit caller cleanup");
print "pbai_continuation_close_pass:3";
