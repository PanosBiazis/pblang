let A = import("stdlib:compiler/source_analysis.sapp");
let F = import("stdlib:compiler/selfhost_frontend.sapp");
for source in [nil, "", " ", 12, [], map{}, "/* comment only */",
    "let = ;", "let n=0x;", "let n=1e+;", "let n=nil-1;",
    "let s=\"unterminated", "let n=1; /* unclosed", "fn f( {",
    "let s=\"λ😀\"; print s;", "fn f(x:number){return x;} f();",
    "fn f(x:number=1){return x;} f();", "print missing;",
    "throw \"never run\";", "let n:number=\"x\";", "let a=[1]; print a[0];",
    "fn f(){let x=1;return fn(){x=x+1;return x;};} let g=f();print g();"] {
    let small = A.parse_safe(source); let full = F.frontend_parse_safe(source);
    assert(json_stringify(small) == json_stringify(full), "parse facade preserves complete result");
    if small.ast != nil {
        assert(json_stringify(A.typecheck(small.ast)) == json_stringify(F.frontend_typecheck(full.ast)),
            "type facade preserves complete result");
    }
}
for ast in [nil, map{stmts:nil}, map{stmts:[]}] {
    assert(json_stringify(A.typecheck(ast)) == json_stringify(F.frontend_typecheck(ast)), "empty AST parity");
}
let first = A.parse_safe("print 1;"); array_push(first.errors, "caller mutation");
assert(len(A.parse_safe("print 1;").errors) == 0, "results are not shared across requests");
print "source_parse_type_parity_pass";
