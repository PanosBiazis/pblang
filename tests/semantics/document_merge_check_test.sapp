let C=import("stdlib:document_merge_check.sapp");let M=import("stdlib:document_merge.sapp");
let D=import("stdlib:text_document.sapp");let S=import("stdlib:sheet_document.sapp");let CSV=import("stdlib:sheet_csv.sapp");
fn has(report,code) {for item in report.issues {if item.code==code {return true;}}return false;}
let doc=D.from_text("Hello {{name}}","{{name}}");let table=CSV.decode("name,extra\nExample,x\n,ignored");
let before=D.encode(doc);let data=S.encode(table);let result=C.inspect(doc,table);
assert(result.ready and result.records==2 and result.errors==0 and result.warnings==2,"blank and unused columns warn without rejecting");
assert(result.fields==["name"] and result.text_bytes==M.render(doc,table).text_bytes,"renderer agrees and fields deduplicate");
assert(has(result,"blank_value") and has(result,"unused_column"),"actionable warning codes");
assert(D.encode(doc)==before and S.encode(table)==data,"inputs remain unchanged");
result=C.inspect(map{},map{});assert(result.errors==2 and not result.ready,"both malformed inputs diagnosed");
result=C.inspect(doc,CSV.decode("other\nx"));assert(has(result,"missing_column") and result.issues[0].block==0,"missing title column diagnosed");
result=C.inspect(doc,CSV.decode("name,name\nx,y"));assert(has(result,"duplicate_header") and result.issues[0].column==2,"duplicate header location");
result=C.inspect(doc,CSV.decode("bad name\nx"));assert(has(result,"invalid_header"),"invalid header");
result=C.inspect(doc,CSV.decode("name"));assert(has(result,"no_records"),"header-only table");
let broken=D.from_text("{{unterminated","{{name|upper}}");result=C.inspect(broken,table);
assert(result.errors==2 and result.issues[0].block==0 and result.issues[1].block==1,"all malformed template parts located");
let huge=D.from_text("{{name}}{{name}}{{name}}{{name}}{{name}}");let rows=CSV.decode("name\nsmall\n"+str_repeat("x",256));
result=C.inspect(huge,rows);assert(not result.ready and result.errors==1 and result.issues[0].row==3 and has(result,"record_output_limit"),"only offending data row identified");
let unicode=D.from_text("ok","{{name}}{{name}}");result=C.inspect(unicode,CSV.decode("name\n"+str_repeat("β",100)));
assert(has(result,"record_output_limit"),"UTF-8 title limit uses renderer");
let repeated=D.create();repeated.blocks=[];for i in range(0,10) {array_push(repeated.blocks,map{kind:"paragraph",text:str_repeat("x",1000)});}
let many=S.create(32,1);many.cells[0][0]="name";result=C.inspect(repeated,many);
assert(has(result,"batch_output_limit") and not result.ready,"valid individual records can exceed total batch budget");
let all=D.from_text("{{a}}{{b}}{{c}}{{d}}{{e}}{{f}}{{g}}{{h}}");let blanks=S.create(32,8);blanks.cells[0]=["a","b","c","d","e","f","g","h"];
result=C.inspect(all,blanks);assert(result.ready and result.warnings==248 and len(result.issues)==64 and result.omitted==184,"bounded diagnostics retain exact omitted count");
assert(result.issues[0].row==2 and result.issues[0].column==1,"one-based table coordinates include header");
let literal=CSV.decode("name\n{{other}}");result=C.inspect(doc,literal);assert(result.ready and result.fields==["name"],"cell placeholders are literal");
assert(C.inspect(D.from_text("static"),CSV.decode("name\nx")).ready,"templates without fields remain supported");
print "document_merge_check_pass";

let V=import("stdlib:document_merge_check_view.sapp");let UI=import("stdlib:modern_ui.sapp");let G=import("stdlib:gui.sapp");let A=import("stdlib:modern_ui_android.sapp");
let tree=V.create(all,blanks,7);let form=UI.build("Check",tree,map{width:412,height:915});
G.get(form,"part_63").onclick(form);assert(str_contains(G.get(form,"position").text,"Issue 64"),"last portable issue reachable");
for widget in form.widgets {assert(widget.x+widget.w<=form.w and widget.y+widget.h<=form.h,"portable controls fit");}
for target in ["native","web","android"] {assert(len(UI.compile(tree,map{target:target,width:412,height:915}).records)>0,"portable diagnostics compile");}
assert(len(A.generate("PBMergeCheck",UI.compile(tree,map{target:"android",width:412,height:915}),map{package:"org.pblang.mergecheck"}).class_bytes)>0,"Android class generation");
for bad in [-1,8,0.5,"0",nil] {assert((try V.create(all,blanks,bad) catch nil)==nil,"invalid page group rejected");}
print "document_merge_check_view_pass";
