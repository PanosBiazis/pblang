let FE = import("stdlib:compiler/selfhost_frontend.sapp");
let source = "let F = import(\"stdlib:functional.sapp\"); let P = import(\"stdlib:pipe.sapp\");"
    + "let effects = [0]; let run = F.once(fn(x) { effects[0] = effects[0]+1; throw nil; });"
    + "let first = try map{ok:true,value:run(0)} catch map{ok:false};"
    + "let second = try map{ok:true,value:run(0)} catch map{ok:false};"
    + "let seen = []; let success = P.once_attempt(fn(x){push(seen,x);return nil;});"
    + "let a = success(3); let b = success(4);"
    + "let holder = map{run:nil}; let calls = [0];"
    + "holder.run = F.once(fn(x){calls[0] = calls[0]+1; if calls[0]>1 {throw 7;} return holder.run(x);});"
    + "let recursive = try map{ok:true,value:holder.run(0)} catch map{ok:false};"
    + "let again = try map{ok:true,value:holder.run(0)} catch map{ok:false};"
    + "let result = [first.ok,second.ok,effects[0],a,b,seen,recursive.ok,again.ok,calls[0]];";
let result = FE.frontend_run_bounded(source,map{max_steps:20000,max_frames:32,max_modules:10,max_source_bytes:32768});
if not result.ok { throw "FAIL selfhost-once-attempt: library import/run"; }
if result.globals.result != [false,false,1,nil,nil,[3],false,false,1] {
    throw "FAIL selfhost-once-attempt: lifecycle or callback effects";
}
print "selfhost_once_attempt_pass";
