// Isolated actual imports on Linux. No original source files are renamed or edited.
if platform()!="linux" {print "pbai_modularity_dependency_skip_linux_required";os_exit(0);}
let U=import("stdlib:uuid.sapp");
let exe=env_get("PBLANG_BIN") ?? "pblang";
let root=path_join(cwd(),"target/pbai-modularity-"+U.v4());
let library=path_join(cwd(),"../pblang/stdlib");
let dependencies=["algorithms_advanced.sapp","controlled_modularity.sapp","csv.sapp",
 "edit_distance.sapp","graph.sapp","json.sapp","min_priority_queue.sapp","semver.sapp","serialization.sapp","pbai_modularity.sapp"];
let sensor_source=fs_read(path_join(library,"pbai_sensor.sapp"));
let step=["setup"];let completed=[0];
fn child(at,args) {
 let argv=["-k","1s","15s","/usr/bin/env","-C",at,exe];for arg in args {push(argv,arg);}
 return proc_spawn_wait("/usr/bin/timeout",argv);
}
fn fixture(name,sensor,student,body,poison_resolver=false,bridge=nil) {
 step[0]=name;let at=path_join(root,name);fs_mkdirs(path_join(at,"stdlib"));
 for file in dependencies {fs_write(path_join(at,"stdlib/"+file),fs_read(path_join(library,file)));}
 if bridge!=nil {fs_write(path_join(at,"stdlib/pbai_modularity.sapp"),bridge);}
 if sensor!=nil {fs_write(path_join(at,"stdlib/pbai_sensor.sapp"),sensor);}
 if student!=nil {fs_write(path_join(at,"stdlib/pbai_neural_adapter.sapp"),student);}
 if poison_resolver {fs_write(path_join(at,"stdlib/controlled_modularity.sapp"),"throw \"unrequested resolver\";");}
 fs_write(path_join(at,"pblang.toml"),"[package]\nname=\"pbai-modularity-fixture\"\nversion=\"0.1.0\"\nentry=\"main.sapp\"\n[dependencies]\nstdlib={path=\"stdlib\"}\n");
 fs_write(path_join(at,"main.sapp"),"let M=import(\"stdlib:pbai_modularity.sapp\");"+body+"print \"fixture_pass\";");
 let built=child(at,["build"]);assert(built.exit_code==0,"fixture build");
 let result=child(at,["run","main.sapp","--deny-net","--deny-http","--deny-exec","--deny-ffi","--deny-spawn","--deny-sqlite"]);
 assert(result.exit_code==0 and result.stdout=="fixture_pass\n","isolated import fixture");
 assert(not str_contains(result.stderr,"synthetic-private-marker"),"private exception not emitted");
 completed[0]=completed[0]+1;
}
fn exercise() {
 let poison="print \"UNREQUESTED_IMPORT\";throw \"unrequested provider\";";
 fixture("catalog",poison,poison,"assert(not M.catalog().runtime_checked,\"static only\");",true);
 fixture("invalid",poison,poison,"assert(M.probe(\"gpu\").code==\"invalid_adapter\",\"reject before import\");",true);
 fixture("missing-sensor",nil,poison,"let p=M.probe(\"sensor-v1\");assert(p.code==\"dependency_unavailable\" and p.plan.bindings[0].status==\"disabled\",\"optional disabled\");assert(M.run(\"sensor-v1\",nil).output==nil,\"no execution\");");
 fixture("missing-student",poison,nil,"assert(M.probe(\"student-v1\").code==\"dependency_unavailable\",\"student absent\");");
 fixture("sensor-only",sensor_source,poison,"assert(M.probe(\"sensor-v1\").ok,\"unrequested student is never imported\");");
 fixture("resolver-error",sensor_source,poison,"assert(M.probe(\"sensor-v1\").code==\"resolution_failed\",\"resolver failure sanitized\");",true);
 fixture("bad-exports","fn contract(){return nil;}export contract;",poison,"assert(M.probe(\"sensor-v1\").code==\"incompatible_exports\",\"missing export\");");
 fixture("bad-contract","fn contract(){return map{format:\"sensor.v2\"};}fn analyze(r){throw \"must not execute\";}export contract,analyze;",poison,"assert(M.probe(\"sensor-v1\").code==\"incompatible_contract\",\"no fallback for incompatible provider\");");
 fixture("bad-result",str_replace_all(sensor_source,"expected_last:expected","expected_last:999"),poison,"assert(M.probe(\"sensor-v1\").code==\"probe_failed\",\"numeric oracle fails\");");
 fixture("throwing-probe",str_replace_all(sensor_source,"fn analyze(request) {","fn analyze(request) {throw \"synthetic-private-marker\";"),poison,"let p=M.probe(\"sensor-v1\");assert(p.code==\"probe_failed\" and not str_contains(json_stringify(p),\"synthetic-private-marker\"),\"fixed private error\");");
 fixture("contract-callback",str_replace_all(sensor_source,"period_seconds_integer:true","period_seconds_integer:fn(){print \"CALLBACK_EXECUTED\";return true;}"),poison,"assert(M.probe(\"sensor-v1\").code==\"incompatible_contract\",\"contract functions are not invoked\");");
 fixture("execution-error",str_replace_all(sensor_source,"fn analyze(request) {","fn analyze(request) {if request.period_seconds==3 {throw \"synthetic-private-marker\";}"),poison,"let r=M.run(\"sensor-v1\",map{values:[1,2,3,4],period_seconds:3,sigma:3,absolute_tolerance:1});assert(r.error==\"execution_failed\" and r.output==nil,\"runtime exceptions sanitized\");");
 let bind="let S=import(\"stdlib:pbai_sensor.sapp\");let R=import(\"stdlib:controlled_modularity.sapp\");let b=M.bind(\"sensor-v1\",S,R);assert(b.report().ok,\"admitted\");";
 let invoke="b.run(map{values:[1,2,3,4],period_seconds:3,sigma:3,absolute_tolerance:1});";
 fixture("metrics-exception",str_replace_all(sensor_source,"fn analyze(request) {","fn analyze(request) {if request.period_seconds==3 {throw \"synthetic-private-marker\";}"),poison,bind+invoke+"let m=b.metrics();assert(m.execution_errors==1 and m.executed_calls==1 and m.provider_errors==0,\"exception category\");assert(not str_contains(json_stringify(m),\"synthetic-private-marker\"),\"no exception retention\");");
 fixture("metrics-unclassified",str_replace_all(sensor_source,"fn analyze(request) {","fn analyze(request) {if request.period_seconds==3 {let a=[];push(a,a);return map{status:a,private:\"synthetic-private-marker\"};}"),poison,bind+invoke+"let m=b.metrics();assert(m.unclassified_replies==1 and m.provider_results==0,\"unknown reply is not success\");assert(not str_contains(json_stringify(m),\"synthetic-private-marker\"),\"cyclic private output not retained\");");
 let bridge=fs_read(path_join(library,"pbai_modularity.sapp"));
 let clock_check=bind+invoke+"let m=b.metrics();assert(m.provider_results==1 and m.duration.samples==0 and m.duration.invalid_samples==1 and m.duration.min_ms==nil and m.duration.total_ms==0,\"invalid clock cannot invent latency or alter result\");";
 fixture("metrics-clock-backward",sensor_source,poison,clock_check,false,str_replace_all(bridge,"let ended=if observe {try now_ms() catch nil} else {nil};","let ended=-1;"));
 fixture("metrics-clock-missing",sensor_source,poison,clock_check,false,str_replace_all(bridge,"let started=if observe {try now_ms() catch nil} else {nil};","let started=nil;"));
 fixture("metrics-clock-too-large",sensor_source,poison,clock_check,false,str_replace_all(bridge,"let ended=if observe {try now_ms() catch nil} else {nil};","let ended=started+86400001;"));
 fixture("malformed-source","fn broken(???",poison,"assert(M.probe(\"sensor-v1\").code==\"dependency_unavailable\",\"load failure is unavailable\");");
 fixture("student-bad-exports",poison,"let student_tool=nil;export student_tool;","assert(M.probe(\"student-v1\").code==\"incompatible_exports\",\"not callable\");");
 fixture("student-bad-contract",poison,"fn student_tool(r){return map{format:\"unsupported\"};}export student_tool;","assert(M.probe(\"student-v1\").code==\"incompatible_contract\",\"student contract mismatch\");");
}
let passed=try {exercise();true} catch false;
let cleaned=proc_spawn_wait("/bin/rm",["-rf","--",root]);
assert(passed,"pbai modularity dependency fixture: "+step[0]);assert(cleaned.exit_code==0,"fixture cleanup");
assert(completed[0]==20,"all dependency cases executed");
print "pbai_modularity_dependencies_pass";
