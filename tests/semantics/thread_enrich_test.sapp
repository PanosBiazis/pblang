// tests/semantics/thread_enrich_test.sapp — enrichment for stdlib/thread.sapp
//
// Adds the missing atomic read/write/CAS ops (only inc/dec were exposed) and a
// real async go()/try_await() (thread_pool already depended on thread_lib.go /
// try_await, which did not exist). await()/is_ready() now handle both the eager
// promise and the new spawn-backed go-future.

let t = import("stdlib/thread.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── atomics: get / set / add / cas / inc / dec ───────────────────────────────────
let a = t.atomic(10);
eq(t.atomic_get(a), 10, "atomic_get initial");
t.atomic_set(a, 20);
eq(t.atomic_get(a), 20, "atomic_set");
t.atomic_add(a, 5);
eq(t.atomic_get(a), 25, "atomic_add");
eq(t.atomic_cas(a, 25, 30), true, "atomic_cas success");
eq(t.atomic_get(a), 30, "atomic_cas applied");
eq(t.atomic_cas(a, 25, 99), false, "atomic_cas fails on mismatch");
eq(t.atomic_get(a), 30, "atomic_cas left value unchanged");
t.atomic_inc(a); t.atomic_dec(a);
eq(t.atomic_get(a), 30, "inc then dec round-trips");

// ── async go()/await() (non-capturing task) ──────────────────────────────────────
let f = t.go(fn() { return 6 * 7; });
eq(t.await(f), 42, "go + await");
eq(t.is_ready(f), true, "go future is ready after await");
eq(t.await(f), 42, "await is idempotent (cached)");

// ── try_await on a completed future returns the value ────────────────────────────
let f2 = t.go(fn() { return 100; });
t.await(f2);                      // ensure completed
eq(t.try_await(f2), 100, "try_await returns the resolved value");

// ── eager promise path still works ───────────────────────────────────────────────
let p = t.promise(fn() { return 5; });
eq(t.await(p), 5, "eager promise await unchanged");
eq(t.is_ready(p), true, "eager promise is_ready unchanged");

print "thread_enrich_pass";
