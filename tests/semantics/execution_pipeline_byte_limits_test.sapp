let PIPE = import("stdlib:execution_pipeline.sapp");

fn expect(value, message) {
    if value != true { throw "FAIL execution_pipeline_byte_limits: " + message; }
}
fn rejects(work) {
    return try { work(); false } catch true;
}

// Every negative has the identical source accepted at its exact byte boundary.
// No imports, filesystem operations, native execution or real private data.
for marker in ["A", "é", "λ", "中", "😀", "é"] {
    let source = "/* " + marker + " */ fn main() { return 42; }";
    let bytes = len(str_to_bytes(source));
    for target in ["interpreter", "c99-hosted", "wasm32"] {
        let exact = PIPE.build_source(source, target, map{ max_source_bytes: bytes });
        expect(exact.ok, "exact source-byte boundary: " + target);
        expect(rejects(fn() {
            PIPE.build_source(source, target, map{ max_source_bytes: bytes - 1 });
        }), "source byte boundary minus one: " + target);
    }
    let runnable = "/* " + marker + " */ let answer = 42;";
    let run_bytes = len(str_to_bytes(runnable));
    let preview = PIPE.run_source(runnable, map{ max_source_bytes: run_bytes });
    expect(preview.ok and preview.globals.answer == 42, "exact preview boundary");
    expect(rejects(fn() {
        PIPE.run_source(runnable, map{ max_source_bytes: run_bytes - 1 });
    }), "preview byte boundary minus one");
}

// Checked bytecode is a map, not serialized PBCK. Its existing display-based
// metric must still count UTF-8 bytes rather than Unicode characters.
let unicode_source = "let label = \"λ😀\";";
let compiled = PIPE.build_source(unicode_source, "interpreter");
expect(compiled.ok, "Unicode constant compiles");
let representation = str(compiled.artifact);
let represented_bytes = len(str_to_bytes(representation));
expect(represented_bytes > len(representation), "fixture exercises multibyte artifact content");
expect(compiled.artifact_bytes == represented_bytes, "chunk display-byte metric");
expect(PIPE.build_source(unicode_source, "interpreter", map{
    max_artifact_bytes: represented_bytes
}).ok, "exact chunk display-byte boundary");
expect(rejects(fn() {
    PIPE.build_source(unicode_source, "interpreter", map{ max_artifact_bytes: represented_bytes - 1 });
}), "chunk display-byte boundary minus one");

for target in ["c99-hosted", "wasm32"] {
    let source = "fn main() { return 42; }";
    let built = PIPE.build_source(source, target);
    expect(built.ok, "artifact control compiles");
    let bytes = if is_string(built.artifact) { len(str_to_bytes(built.artifact)) }
                else { len(built.artifact) };
    expect(built.artifact_bytes == bytes, "text or binary artifact metric");
    expect(PIPE.build_source(source, target, map{ max_artifact_bytes: bytes }).ok, "exact artifact boundary");
    expect(rejects(fn() {
        PIPE.build_source(source, target, map{ max_artifact_bytes: bytes - 1 });
    }), "artifact boundary minus one");
}

let zero = 0;
let nan_value = zero % zero;
for invalid in [nil, false, "10", [], map{}, 0, -1, 1.5, nan_value, 16777217] {
    expect(rejects(fn() { PIPE.limits(map{ max_source_bytes: invalid }); }), "malformed source ceiling");
}
expect(PIPE.limits(map{ max_source_bytes: 1 }).max_source_bytes == 1, "minimum source ceiling");
expect(PIPE.limits(map{ max_source_bytes: 16777216 }).max_source_bytes == 16777216, "maximum source ceiling");
expect(rejects(fn() { PIPE.build_source(42); }), "build rejects non-text source");
expect(rejects(fn() { PIPE.run_source(nil); }), "preview rejects non-text source");

print "execution_pipeline_byte_limits_pass";
