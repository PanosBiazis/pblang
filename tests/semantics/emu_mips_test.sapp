let MIPS = import("stdlib:emulator_mips32.sapp");
let V0 = MIPS.add_immediate_unsigned(2, 0, 4001);

fn value(code) {
    let result = MIPS.run(code);
    if not result.ok { throw result.error; }
    return result.value;
}

assert(value([V0, MIPS.add_immediate_unsigned(4, 0, 42), MIPS.syscall_instruction()]) == 42, "ADDIU");
assert(value([V0, MIPS.add_immediate_unsigned(8, 0, 5), MIPS.add_immediate_unsigned(9, 0, 7),
              MIPS.add_unsigned(4, 8, 9), MIPS.syscall_instruction()]) == 12, "ADDU");
assert(value([V0, MIPS.add_immediate_unsigned(8, 0, 20), MIPS.add_immediate_unsigned(9, 0, 8),
              MIPS.subtract_unsigned(4, 8, 9), MIPS.syscall_instruction()]) == 12, "SUBU");
assert(value([V0, MIPS.add_immediate_unsigned(8, 0, 6), MIPS.add_immediate_unsigned(9, 0, 7),
              MIPS.multiply(4, 8, 9), MIPS.syscall_instruction()]) == 42, "MUL");
assert(value([V0, MIPS.add_immediate_signed(8, 0, -10), MIPS.add_immediate_signed(9, 0, 3),
              MIPS.add_signed(4, 8, 9), MIPS.syscall_instruction()]) == 249, "signed ADD/ADDI");
assert(value([V0, MIPS.add_immediate_unsigned(8, 0, 0), MIPS.add_immediate_unsigned(9, 0, 5),
              MIPS.branch_equal(9, 0, 5), MIPS.nop(), MIPS.add_unsigned(8, 8, 9),
              MIPS.add_immediate_unsigned(9, 9, -1), MIPS.branch_equal(0, 0, -5), MIPS.nop(),
              MIPS.add_unsigned(4, 8, 0), MIPS.syscall_instruction()]) == 15, "delay-slot loop");

assert(not MIPS.run([MIPS.branch_equal(0, 0, 10), MIPS.nop()]).ok, "out-of-range target fails closed");
assert(not MIPS.run([MIPS.branch_equal(0, 0, -1)]).ok, "missing delay slot fails closed");
assert(not MIPS.run([63 * 67108864]).ok, "unknown opcode fails closed");
assert(not MIPS.run([MIPS.jump(0), MIPS.nop()], map{ instruction_budget: 4 }).ok, "loop budget enforced");
assert((try MIPS.add_unsigned(32, 0, 0) catch nil) == nil, "invalid register rejected");
assert((try MIPS.branch_equal(0, 0, 32768) catch nil) == nil, "invalid branch offset rejected");

let snippet = MIPS.run([
    MIPS.add_immediate_signed(8, 0, 10), MIPS.add_immediate_signed(9, 0, 15),
    MIPS.add_signed(16, 8, 9), MIPS.store_word(16, 0, 0)
], map{ allow_fallthrough: true, instruction_budget: 8, max_memory_words: 4 });
assert(snippet.ok and snippet.registers[16] == 25 and snippet.memory["0"] == 25
    and snippet.memory_writes == 1, "bounded snippet fallthrough and SW");
let exact_budget = MIPS.run([MIPS.nop()], map{
    allow_fallthrough: true, instruction_budget: 1
});
assert(exact_budget.ok and exact_budget.instructions == 1,
    "snippet fallthrough succeeds at the exact instruction budget");
assert(not MIPS.run([MIPS.store_word(0, 0, 2)], map{
    allow_fallthrough: true
}).ok, "unaligned SW fails closed");
assert(not MIPS.run([
    MIPS.load_upper_immediate(8, 32767),
    MIPS.add_immediate_unsigned(8, 8, 32767),
    MIPS.add_signed(9, 8, 8)
], map{ allow_fallthrough: true }).ok, "signed ADD overflow fails closed");

print "emu_mips: reusable bounded subset passed arithmetic, delay slots, malformed control, register, and budget checks";
