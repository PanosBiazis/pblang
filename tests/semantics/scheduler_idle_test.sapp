// Lifecycle and mutation regressions: paused values survive; retired callbacks do not.
let S = import("stdlib/scheduler.sapp");
fn eq(a, b, label) { if a != b { throw "FAIL " + label; } }
S.clear_all();
let hits = map{ value: 0, nested: -1, order: "" };
let first = S.set_interval(fn() { hits.value = hits.value + 1; }, 0);
eq(S.pause_timer(first), true, "pause");
eq(S.pause_timer(first), false, "idempotent pause");
eq(S.active_timers(), 0, "paused excluded");
eq(S.paused_timers(), 1, "paused count");
eq(S.retained_timers(), 1, "callback preserved");
eq(S.next_delay(500), 500, "paused excluded from deadline scan");
eq(S.run_pending(), 0, "idle callback not run");
eq(S.resume_timer(first), true, "resume");
eq(S.resume_timer(first), false, "idempotent resume");
eq(S.run_pending(), 1, "resumed callback");
eq(hits.value, 1, "retained state");
S.clear_timer(first);
eq(S.retained_timers(), 0, "cancel removes record");
let later = S.set_immediate(fn() {});
if later <= first { throw "IDs reused"; }
for bad in [-1, 0.5, true, "0", nil, 9000000000000000] {
    eq(S.is_active(bad), false, "invalid active");
    eq(S.pause_timer(bad), false, "invalid pause");
    eq(S.resume_timer(bad), false, "invalid resume");
    S.clear_timer(bad);
}
eq(S.is_active(later), true, "invalid IDs cannot cancel");
S.clear_all();
let ids = map{ other: nil, self: nil };
S.set_immediate(fn() {
    hits.order = hits.order + "a";
    hits.nested = S.run_pending();
    S.clear_timer(ids.other);
    S.set_immediate(fn() { hits.order = hits.order + "c"; });
});
ids.other = S.set_immediate(fn() { hits.order = hits.order + "b"; });
eq(S.run_pending(), 1, "cancel ready callback");
eq(hits.nested, 0, "no reentrant dispatch");
eq(hits.order, "a", "new work deferred");
eq(S.run_pending(), 1, "new work next pass");
eq(hits.order, "ac", "registration order");
eq(S.retained_timers(), 0, "completed records removed");
ids.self = S.set_interval(fn() { S.pause_timer(ids.self); }, 0);
eq(S.run_pending(), 1, "self pause");
eq(S.is_paused(ids.self), true, "self pause survives dispatch");
S.resume_timer(ids.self);
eq(S.run_pending(), 1, "self resume");
S.clear_all();
ids.self = S.set_immediate(fn() { S.pause_timer(ids.self); });
S.run_pending();
eq(S.retained_timers(), 0, "one shot cannot resurrect itself");
S.set_immediate(fn() { S.clear_all(); S.set_immediate(fn() { hits.value = 99; }); });
S.set_immediate(fn() { throw "must have been cancelled"; });
eq(S.run_pending(), 1, "clear all during dispatch");
eq(S.retained_timers(), 1, "new timer survives old pass");
S.run_pending();
eq(hits.value, 99, "new timer executes");
let err = S.set_interval(fn() { throw "expected"; }, 0);
eq(S.run_pending(), 1, "callback errors remain contained");
eq(S.is_active(err), true, "repeat policy preserved");
S.clear_all();
// Resume changes eligibility; another due callback cannot force same-pass execution.
S.set_immediate(fn() { S.pause_timer(ids.other); S.resume_timer(ids.other); });
ids.other = S.set_immediate(fn() { hits.value = 100; });
eq(S.run_pending(), 1, "resume defers to next pass");
eq(S.run_pending(), 1, "resumed work runs later");
for i 5000 { let id = S.set_immediate(fn() {}); S.clear_timer(id); }
eq(S.retained_timers(), 0, "churn leaves no timer history");
for bad in ["10", true, nil] {
    eq(try { S.set_timeout(fn() {}, bad); false } catch true, true, "bad delay");
}
for bad in [0, -1, "10", true, nil] {
    eq(try { S.next_delay(bad); false } catch true, true, "bad idle wait");
}
// Non-finite input is rejected before changing scheduler state.
let nan = num_sqrt(-1);
let infinity = num_pow(10, 400);
for bad in [nan, infinity, -infinity] {
    eq(try { S.set_timeout(fn() {}, bad); false } catch true, true, "nonfinite delay");
    eq(try { S.next_delay(bad); false } catch true, true, "nonfinite wait");
    eq(S.is_active(bad), false, "nonfinite ID");
}
// Pausing and resuming an executing one-shot still retires its replacement.
ids.self = S.set_immediate(fn() { S.pause_timer(ids.self); S.resume_timer(ids.self); });
eq(S.run_pending(), 1, "one-shot self resume");
eq(S.retained_timers(), 0, "one-shot replacement retired automatically");
print "scheduler_idle_pass";
