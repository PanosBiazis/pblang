let PIPE = import("stdlib:execution_pipeline.sapp");

fn fail(message) { throw "FAIL execution_pipeline: " + message; }
fn eq(actual, expected, message) {
    if actual != expected { fail(message + " got=" + str(actual) + " want=" + str(expected)); }
}

let program = [
    ["seti", 0, 1], ["seti", 1, 3],
    ["loop", 1, [["addi", 0, 2]]]
];

let reference = PIPE.build_ir(program, "eval", map{ max_eval_steps: 100 });
eq(reference.ok, true, "reference succeeds");
eq(reference.evaluation.value, 7, "bounded reference result");
eq(reference.executed, true, "only reference target executes");
if reference.optimization.after > reference.optimization.before { fail("optimizer grew IR"); }

let x64 = PIPE.build_ir(program, "x86_64-linux");
let x86 = PIPE.build_ir(program, "i386-linux");
let arm = PIPE.build_ir(program, "arm64-linux");
let c99 = PIPE.build_ir(program, "c99");
eq(x64.artifact[0], 127, "x86-64 ELF magic");
eq(x86.artifact[0], 127, "i386 ELF magic");
eq(arm.artifact[0], 127, "ARM64 ELF magic");
if not str_contains(c99.artifact, "int main(void)") { fail("portable C99 artifact"); }
eq(x64.executed, false, "native build is non-executing by default");

let matrix_program = [
    ["seti", 0, 1], ["seti", 2, 0], ["seti", 3, 1],
    ["seti", 1, 3], ["loop", 1, [
        ["add", 0, 2], ["sub", 0, 2], ["mul", 0, 3], ["addi", 0, 2]
    ]]
];
let matrix = PIPE.optimization_matrix(matrix_program, map{ max_eval_steps: 100 });
eq(matrix.ok, true, "optimization matrix succeeds");
eq(matrix.reference_value, 7, "optimization matrix reference value");
eq(matrix.native_executed, false, "optimization matrix never executes native artifacts");
eq(len(matrix.backends), 4, "optimization matrix covers every common classical backend");
let mi = 0;
while mi < len(matrix.backends) {
    if matrix.backends[mi].saved_bytes <= 0 { fail("matrix backend did not shrink: " + matrix.backends[mi].target); }
    mi = mi + 1;
}
let matrix_syscall = try PIPE.optimization_matrix([["syscall", 60, []]]) catch "caught";
eq(matrix_syscall, "caught", "optimization matrix rejects effects");

let denied_syscall = try PIPE.build_ir([
    ["seti", 1, 0], ["syscall", 60, [1]]
], "x86_64-linux") catch "caught";
eq(denied_syscall, "caught", "syscalls are deny-by-default");
let too_small = try PIPE.build_ir(program, "x86_64-linux", map{ max_artifact_bytes: 8 }) catch "caught";
eq(too_small, "caught", "artifact cap is enforced");

let interp = PIPE.build_source("fn main() { return 42; }", "interpreter");
let hosted_c99 = PIPE.build_source("fn main() { return 42; }", "c99-hosted");
let wasm = PIPE.build_source("fn main() { return 42; }", "wasm32");
eq(interp.ok, true, "self-hosted source compile succeeds");
eq(hosted_c99.ok, true, "self-hosted C99 source compile succeeds");
if not str_contains(hosted_c99.artifact, "double pb_main(") { fail("self-hosted C99 artifact missing pblang main"); }
let c99_closure = PIPE.build_source("fn outer(x) { return fn(y) { return x + y; }; } let f = outer(40); print f(2);", "c99-hosted");
eq(c99_closure.ok, true, "self-hosted C99 accepts numeric closures");
if not str_contains(c99_closure.artifact, "pb_closure_new(pb_lambda_") { fail("self-hosted C99 closure artifact missing conversion"); }
let c99_rejected = PIPE.build_source("import \"missing.sapp\"; print 1;", "c99-hosted");
eq(c99_rejected.ok, false, "self-hosted C99 rejects unresolved import");
let project_modules = map{
    "lib/base.sapp": "fn add(a, b) { return a + b; } export add;",
    "lib/api.sapp": "const B = import(\"base.sapp\"); fn answer() { return B.add(40, 2); } export answer;"
};
let project = PIPE.build_source("const API = import(\"../lib/api.sapp\"); print API.answer();", "c99-hosted",
    map{ modules: project_modules, entry_path: "app/main.sapp" });
eq(project.ok, true, "C99 project snapshot build succeeds");
eq(project.link.modules, 2, "C99 project link metadata");
eq(project.link.module_order[0], "lib/base.sapp", "C99 project dependency order");
if str_contains(project.artifact, "import(") or not str_contains(project.artifact, "__pbi") {
    fail("C99 project artifact was not resolved and namespaced");
}
let project_escape = PIPE.build_source("let X = import(\"../../x.sapp\");", "c99-hosted",
    map{ modules: map{}, entry_path: "app/main.sapp" });
eq(project_escape.ok, false, "C99 project root traversal is rejected");
let project_global = PIPE.build_source("let X = import(\"x.sapp\"); print X.value();", "c99-hosted",
    map{ modules: map{ "x.sapp": "let K = 42; fn value() { return K; } export value;" } });
eq(project_global.ok, true, "C99 module top-level values compile");
if not str_contains(project_global.artifact, "static double __pbi0_K = 0;")
    or not str_contains(project_global.artifact, "__pbi0_K = 42;") {
    fail("C99 module global storage/initialization artifact missing");
}
let wasm_modules = PIPE.build_source("fn main() { return 42; }", "wasm32", map{ modules: map{} });
eq(wasm_modules.ok, false, "unsupported target does not silently ignore module snapshot");
eq(wasm.artifact[0], 0, "WASM magic byte 0");
eq(wasm.artifact[1], 97, "WASM magic byte 1");
let source_cap = try PIPE.build_source("fn main() { return 42; }", "wasm32", map{ max_source_bytes: 4 }) catch "caught";
eq(source_cap, "caught", "source cap is enforced");

let bounded = PIPE.run_source("fn twice(x) { return x + x; } let answer = twice(21); print answer;", map{ max_eval_steps: 1000 });
eq(bounded.ok, true, "bounded source execution succeeds");
eq(bounded.globals.answer, 42, "bounded source result");
eq(bounded.output[0], 42, "bounded output capture");
let bounded_loop = try PIPE.run_source("while true { }", map{ max_eval_steps: 50 }) catch "caught";
eq(bounded_loop, "caught", "bounded source cannot run forever");

let linux = PIPE.plan_platform("linux", "6.0", "amd64");
let windows = PIPE.plan_platform("windows", "11", "x86_64");
let wasi = PIPE.plan_platform("wasi", "1", "wasm32");
eq(linux.target, "x86_64-linux", "Linux x86-64 direct backend");
eq(linux.direct_native, true, "Linux direct backend marked native");
eq(windows.target, "c99", "Windows uses honest portable fallback");
eq(windows.direct_native, false, "ELF is not claimed as native Windows");
eq(wasi.target, "wasm32", "WASI uses WebAssembly backend");

print "execution_pipeline_pass";
