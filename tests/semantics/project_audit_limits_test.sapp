let A=import("stdlib:project_audit.sapp");
fn expect(ok,label) {if not ok {throw "FAIL project-audit-limits: "+label;}}
let text="// slow path\n// slow path\n";
let records=[map{path:"limit-fixture.sapp",text:text}];
let rejected=try {A.scan_text_report("limit-fixture.sapp",text,1.5);false} catch true;
expect(rejected,"fractional cap must reject rather than retain two findings");
let invalid=[true,false,"private-limit-marker",[],map{},fn(){return 1;},
    parse_number("NaN"),parse_number("inf"),parse_number("-inf"),
    bigint(1),rational("1/1"),decimal("1"),0,-1,1.5,4097];
for value in invalid {
    expect(try {A.scan_text_report("private-path-marker",text,value);false} catch true,"text report rejection");
    expect(try {A.scan_text("private-path-marker",text,value);false} catch true,"array wrapper cannot become empty success");
    expect(try {A.scan_records(records,value);false} catch true,"record report rejection");
    expect(try {A.scan_records([],value);false} catch true,"empty collection cannot bypass admission");
    expect(try {A.quality_gate(A.audit_project("fixture",records,value));false} catch true,"quality gate cannot accept invalid audit");
    expect(try {A.release_readiness("fixture",records,map{max_findings:value});false} catch true,"readiness cannot accept invalid audit");
}
for value in [1,200,500,1024,4096] {
    let report=A.scan_text_report("limit-fixture.sapp",text,value);
    expect(report.finding_count==if value==1 {1} else {2},"exact positive retained cap");
    expect(len(map_keys(report))==8 and not map_has(report,"ok"),"success text schema unchanged");
    let combined=A.scan_records(records,value);
    expect(combined.finding_count==report.finding_count and not combined.passed,"record count and failure retained");
    expect(not A.quality_gate(combined,map{max_medium:0}).passed,"strict quality gate remains blocked");
}
expect(json_stringify(A.scan_text_report("limit-fixture.sapp",text))==json_stringify(A.scan_text_report("limit-fixture.sapp",text,nil)),"legacy nil text default");
expect(json_stringify(A.scan_records(records))==json_stringify(A.scan_records(records,nil)),"legacy nil record default");
let many="";for i 501 {many=many+"// slow path\n";}
expect(A.scan_text_report("limit-fixture.sapp",many).finding_count==200,"default text cap is 200");
expect(A.scan_text_report("limit-fixture.sapp",many,nil).finding_count==200,"nil text cap is 200");
let many_records=[map{path:"limit-fixture.sapp",text:many}];
expect(A.scan_records(many_records).finding_count==500,"default aggregate cap is 500");
expect(A.scan_records(many_records,nil).finding_count==500,"nil aggregate cap is 500");
let empty=A.scan_records([],1);expect(empty.passed and empty.finding_count==0,"valid empty input unchanged");
let before=json_stringify(records);A.scan_records(records,1);
expect(json_stringify(records)==before,"input records not modified");
print "project_audit_limits_pass";
