// New bounded acceptance for constructor failure AFTER successful file review.
// Production owner/example remain unchanged; instrumentation exists only in copies.
if platform()!="linux" {print "pbai_reconstruction_skip_linux_required";os_exit(0);}
let U=import("stdlib:uuid.sapp");let parent=path_dirname(cwd());let exe=env_get("PBLANG_BIN");let product=env_get("PBAI_RELOAD_PRODUCT");
assert(product=="pblang" or product=="pbai","select one reconstruction product");
assert(type(exe)=="string" and exe!="","trusted PBLANG_BIN required");
let root=path_join("/tmp","pbai-reconstruction-installed-"+U.v4());let caller=path_join(root,"caller");let step=["setup"];
fn process(command,args){let argv=["-s","INT","-k","2s","12s",command];for arg in args {push(argv,arg);}return proc_spawn_wait("/usr/bin/timeout",argv);}
fn must(command,args){let out=process(command,args);assert(out.exit_code==0,"reconstruction fixture operation");return out;}
fn build(at){let out=must("/usr/bin/env",["-C",at,exe,"build"]);assert(str_contains(out.stdout,"build ok"),"fixture build");}
fn hidden(at,phase,mode="none",file="example.sapp"){
 let args=["--die-with-parent","--unshare-net","--ro-bind","/","/","--dev","/dev","--bind",root,root,
  "--tmpfs",path_join(parent,"pblang"),"--tmpfs",path_join(parent,"pbai")];
 let extra=env_get("PBAI_SOURCE_HIDE_ROOT");if type(extra)=="string" and extra!="" {push(args,"--tmpfs");push(args,extra);}
 for value in ["--setenv","PBAI_STATE_ROOT",path_join(root,"state"),"--setenv","PBAI_RELOAD_PHASE",phase,
  "--setenv","PBAI_RELOAD_FAULT_MODE",mode,"--setenv","PBAI_CHECKPOINT_TEST_DIR",path_join(at,"private"),
  "--chdir",caller,exe,"run",path_join(at,file),"--allow-all","--deny-net","--deny-http","--deny-sqlite"] {push(args,value);}
 return process("/usr/bin/bwrap",args);
}
fn successful(out){
 if out.exit_code!=0 {print out.stdout;print str_replace_all(out.stderr,root,"<fixture>");}
 assert(out.exit_code==0 and out.stderr=="" and not str_contains(out.stdout,"DECOY_EXECUTED")
  and not str_contains(out.stdout,"synthetic private reconstruction failure"),"real example handles injected failure without leaking its text");
}
fn check(value,expected,old_digest,new_digest){
 assert(value.final_active_closed and value.initial_prediction_blocked and not value.globally_activated and len(value.steps)==4,"final ownership release");
 let active=old_digest;
 for i in range(0,4) {
  let item=value.steps[i];if expected[i]=="replaced" {active=new_digest;}
  assert(item.decision==expected[i] and item.active_digest==active and item.active_token==5,"expected active model survives or changes only on success");
  assert(item.previous_prediction_available==(expected[i]!="replaced") and item.retired_closed==(expected[i]=="replaced")
   and item.retired_prediction_blocked==item.retired_closed,"actual prior prediction alias survives failure and retires only after success");
  assert(item.candidate_acquired==(i>0) and item.candidate_closed==item.candidate_acquired,"every review candidate closes");
  if expected[i]=="replacement_load_failed" {assert(item.review.passed and item.review.candidate_digest==new_digest,"injected failure follows passed review");}
 }
}
fn exercise(){
 fs_mkdirs(root);must("/bin/chmod",["700",root]);fs_mkdirs(caller);fs_mkdirs(path_join(root,"state"));fs_mkdirs(path_join(caller,"stdlib"));
 for name in ["pbai_checkpoint_scope.sapp","resource_scope.sapp","pbai_student_checkpoint_io.sapp","secure_file.sapp","pbai_neural_adapter.sapp","pbai_specialist_binding.sapp","serialization.sapp","json.sapp","json_decode.sapp"] {
  fs_write(path_join(path_join(caller,"stdlib"),name),"print \"DECOY_EXECUTED\";throw \"caller decoy\";\n");
 }
 fs_write(path_join(caller,"main.sapp"),"print 0;\n");fs_write(path_join(caller,"pblang.toml"),"[package]\nname=\"reconstruction-caller\"\nversion=\"0.1.0\"\nentry=\"main.sapp\"\n[dependencies]\nstdlib={path=\"stdlib\"}\n");build(caller);
 for repo in ["pblang","pbai"] {
  let source=path_join(parent,repo);let at=path_join(root,repo);fs_mkdirs(at);must("/bin/cp",["-R",path_join(source,"stdlib"),path_join(at,"stdlib")]);
  let examples=if repo=="pblang" {"examples"} else {"demo"};
  fs_write(path_join(at,"example.sapp"),fs_read(path_join(source,path_join(examples,"pbai_student_checkpoint_reload_reviewed.sapp"))));
  fs_write(path_join(at,"driver.sapp"),"let N=import(\"stdlib:pbai_neural_adapter.sapp\");let ran=import(\"example.sapp\");assert(type(ran)==\"module\",\"real example executed\");print json_stringify(map{format:\"pbai.reconstruction.probe.v1\",trace:N.reconstruction_fixture_report()});\n");
  fs_mkdirs(path_join(at,"private"));must("/bin/chmod",["700",path_join(at,"private")]);
  let dep=if repo=="pblang" {"stdlib"} else {"../pblang/stdlib"};fs_write(path_join(at,"pblang.toml"),"[package]\nname=\"reconstruction-installed\"\nversion=\"0.1.0\"\nentry=\"example.sapp\"\n[dependencies]\nstdlib={path="+json_stringify(dep)+"}\n");
 }
 build(path_join(root,"pblang"));build(path_join(root,"pbai"));let at=path_join(root,product);step[0]="prepare";
 let prepared=hidden(at,"prepare");successful(prepared);assert(json_parse(prepared.stdout).created==3,"actual synthetic file preparation");
 let dir=path_join(at,"private");let original=fs_read(path_join(dir,"student.json"));let better=fs_read(path_join(dir,"better.json"));let worse=fs_read(path_join(dir,"worse.json"));
 let old_digest=json_parse(original).digest;let new_digest=json_parse(better).digest;assert(old_digest!=new_digest,"different valid model identities");
 step[0]="uninstrumented calibration";let baseline=hidden(at,"recover");successful(baseline);
 check(json_parse(baseline.stdout),["load_failed","rejected","replaced","unchanged"],old_digest,new_digest);
 let owner=path_join(root,"pblang/stdlib/pbai_neural_adapter.sapp");let source=fs_read(owner);
 let signature="fn student_load(artifact) {";let exports="export valid_student_artifact, student_encode, student_decode, student_load;";
 assert(len(str_split(source,signature))==2 and len(str_split(source,exports))==2
  and not str_contains(source,"reconstruction_fixture_report"),"exact known injection points, no fuzzy production rewrite");
 let hooks=fs_read(path_join(parent,"pblang/tests/fixtures/pbai_reload_reconstruction_hooks.sapp"));
 let shim=hooks+"\nlet reconstruction_fixture=reconstruction_fault_fixture(_reconstruction_original_student_load,"+json_stringify(new_digest)+",env_get(\"PBAI_RELOAD_FAULT_MODE\"));\nfn student_load(artifact){return reconstruction_fixture.load(artifact);}\nfn reconstruction_fixture_report(){return reconstruction_fixture.report();}\nexport reconstruction_fixture_report;\n";
 let instrumented=str_replace_all(str_replace_all(source,signature,"fn _reconstruction_original_student_load(artifact) {"),exports,shim+exports);
 fs_write(owner,instrumented);build(path_join(root,"pblang"));build(path_join(root,"pbai"));let results=[];
 for mode in ["none","once","repeat"] {
  step[0]=mode;let out=hidden(at,"recover",mode,"driver.sapp");successful(out);let lines=str_split(out.stdout,"\n");assert(len(lines)==3 and lines[2]=="","exact example and trace output");
  let value=json_parse(lines[0]);let probe=json_parse(lines[1]);assert(probe.format=="pbai.reconstruction.probe.v1","selected probe report");let trace=probe.trace;
  let expected=["load_failed","rejected","replacement_load_failed","replacement_load_failed"];
  if mode=="none" {expected=["load_failed","rejected","replaced","unchanged"];} elif mode=="once" {expected=["load_failed","rejected","replacement_load_failed","replaced"];}
  check(value,expected,old_digest,new_digest);
  let failures=2;if mode=="none" {failures=0;} elif mode=="once" {failures=1;}let calls=if mode=="none" {5} else {6};
  assert(trace.mode==mode and trace.calls==calls and trace.target_calls==(if mode=="none" {3} else {4})
   and trace.failures==failures and len(trace.handles)==calls-failures and trace.all_closed and len(trace.events)==calls,"exact bounded constructor and ownership accounting");
  for i in range(0,calls) {
   let event=trace.events[i];let injected=(mode!="none" and i==3) or (mode=="repeat" and i==5);
   assert(event.call==i+1 and event.target==(i>=2) and event.target_call==(if i>=2 {i-1} else {0})
    and event.action==(if injected {"injected_failure"} else {"loaded"}) and event.prior_candidate_closed==injected,"fail only the accepted reconstruction after its candidate closed");
  }
  for handle in trace.handles {assert(handle.closed_before_probe and handle.repeated_close_false,"no model handle left live before probe cleanup");}
  if mode=="none" {assert(lines[0]==str_split(baseline.stdout,"\n")[0],"instrumented no-fault behavior is byte-identical to unmodified example");}
  assert(fs_read(path_join(dir,"student.json"))==original and fs_read(path_join(dir,"better.json"))==better and fs_read(path_join(dir,"worse.json"))==worse,"recovery never changes persisted checkpoint bytes");
  push(results,map{mode:mode,example:value,trace:trace});
 }
 fs_write(owner,source);assert(fs_read(owner)==source,"only private owner instrumented and restored");
 print json_stringify(map{format:"pbai.reconstruction.acceptance.v1",product:product,uninstrumented_calibration:true,results:results});
}
let passed=try {exercise();true} catch false;let removed=process("/bin/rm",["-rf","--",root]);
assert(passed,"reconstruction acceptance: "+step[0]);assert(removed.exit_code==0,"private reconstruction fixture cleanup");
print "pbai_reconstruction_"+product+"_pass";
