let SNAPSHOT = import("stdlib:locked_source_snapshot.sapp");
let SHA256 = import("stdlib:sha256_pb.sapp");

fn require(value, message) {
    if not value { throw "FAIL locked_source_snapshot: " + message; }
}
fn tree_digest(items) {
    let by_path = map{}; let paths = [];
    for item in items { by_path[item.path] = item.bytes; array_push(paths, item.path); }
    let hash = SHA256.new();
    for path in array_sort(paths) {
        SHA256.update(hash, str_to_bytes(path)); SHA256.update(hash, [0]);
        SHA256.update(hash, by_path[path]); SHA256.update(hash, [0]);
    }
    return SHA256.finish(hash);
}

let root = "/tmp/pblang_locked_snapshot_" + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 16);
let dep = root + "/dep";
fs_mkdirs(dep + "/src");
let module_bytes = str_to_bytes("fn value() { return 42; }\nexport value;\n");
fs_write_bytes(dep + "/src/value.sapp", module_bytes);
let manifest = "[package]\nname = \"fixture\"\nversion = \"1.0.0\"\nentry = \"main.sapp\"\n\n"
    + "[dependencies]\ndep = { path = \"dep\" }\n";
fs_write(root + "/pblang.toml", manifest);
fs_write(root + "/main.sapp", "let D = import(\"dep:src/value.sapp\");\nprint D.value();\n");
let lock = "manifest_sha256 = \"" + SHA256.sha256_hex_bytes(str_to_bytes(manifest)) + "\"\n\n"
    + "[dependencies.dep]\npath = \"dep\"\nsha256 = \""
    + tree_digest([map{ path: "src/value.sapp", bytes: module_bytes }]) + "\"\n";
fs_write(root + "/pblang.lock", lock);

let loaded = SNAPSHOT.load(root);
require(loaded.ok and loaded.lock_verified and loaded.descriptor_confined, "valid lock snapshot");
require(map_has(loaded.modules, "main.sapp") and map_has(loaded.modules, "dep:src/value.sapp"),
    "project and package namespaces");
require(loaded.dependency_digests.dep == tree_digest([map{ path: "src/value.sapp", bytes: module_bytes }]),
    "exact fast canonical tree digest");

// A non-UTF-8 non-module file remains part of package integrity and forces a
// complete pure-PBLang reread rather than a mixed fast/pure suffix hash.
let binary = [255, 0, 128];
fs_write_bytes(dep + "/data.bin", binary);
let binary_digest = tree_digest([
    map{ path: "data.bin", bytes: binary }, map{ path: "src/value.sapp", bytes: module_bytes }
]);
let binary_lock = str_replace_all(lock,
    tree_digest([map{ path: "src/value.sapp", bytes: module_bytes }]), binary_digest);
fs_write(root + "/pblang.lock", binary_lock);
let binary_loaded = SNAPSHOT.load(root);
require(binary_loaded.ok and binary_loaded.dependency_digests.dep == binary_digest,
    "binary tree pure fallback");

fs_write(dep + "/src/value.sapp", "fn value() { return 43; }\nexport value;\n");
let tampered = SNAPSHOT.load(root);
require(not tampered.ok and str_contains(tampered.error, "digest mismatch"), "tamper rejection");

fs_write(dep + "/src/value.sapp", bytes_to_str(module_bytes));
fs_write(root + "/pblang.lock", str_replace_all(binary_lock, "path = \"dep\"", "path = \"/tmp/dep\""));
let absolute = SNAPSHOT.load(root);
require(not absolute.ok and str_contains(absolute.error, "portable path"), "absolute lock path rejection");

try fs_remove(root + "/pblang.lock") catch nil;
try fs_remove(root + "/main.sapp") catch nil;
try fs_remove(dep + "/src/value.sapp") catch nil;
try fs_remove(dep + "/data.bin") catch nil;
print "locked_source_snapshot_pass";
