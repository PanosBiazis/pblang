let CP = import("stdlib:compute.sapp");
let A = import("stdlib:accelerator.sapp");
let counts = [0, 1, 2, 3, 4, 31, 32, 33];
let cases = [
    map{ preferred_device: "cpu", devices: [] },
    map{ preferred_device: "sequential", devices: [], min_parallel_items: 1 },
    map{ allow_parallel: false, devices: [], min_parallel_items: 1 },
    map{ max_workers: nil, devices: [] },
    map{ max_workers: 2, devices: [], min_parallel_items: 2, work_units_per_item: 10000 },
    map{ devices: [], min_parallel_items: 2, work_units_per_item: 10000 },
    map{ devices: [], min_parallel_items: 4 },
    map{ devices: [], preferred_device: "gpu", fallback_to_cpu: false },
];
let i = 0;
while i < len(cases) {
    let opts = cases[i];
    let public_policy = CP.policy(opts);
    let c = 0;
    while c < len(counts) {
        let values = []; let expected = []; let n = 0;
        while n < counts[c] { array_push(values, n); array_push(expected, n * n); n = n + 1; }
        let planned = CP.select_device(len(values), [], public_policy);
        let actual = CP.run_controlled(values, fn(x) { return x * x; }, opts);
        assert(actual.route == planned, "execution must equal the fully resolved public policy route");
        if actual.ok { assert(actual.results == expected, "worker values and ordering preserved"); }
        else { assert(actual.results == nil, "strict accelerator failure preserved"); }
        c = c + 1;
    }
    i = i + 1;
}
let cores = CP.cpu_cores(); if cores > 64 { cores = 64; }
assert(CP.policy(map{ allow_parallel: false }).max_workers == cores, "public policy still resolves the default");
assert(CP.policy(map{ preferred_device: "sequential" }).max_workers == cores, "public sequential policy unchanged");
assert(CP.policy(map{ max_workers: nil }).max_workers == cores, "public nil worker default unchanged");
let bad = [map{ max_workers: 0 }, map{ min_parallel_items: 0 },
    map{ min_accelerator_items: 0 }, map{ max_accelerator_transfer_bytes: -1 },
    map{ work_units_per_item: "bad" }, map{ devices: "bad" }, map{ preferred_device: "bad" }];
i = 0;
while i < len(bad) {
    let empty = try CP.run_controlled([], fn(x) { return x; }, bad[i]) catch "rejected";
    let one = try CP.run_controlled([1], fn(x) { return x; }, bad[i]) catch "rejected";
    assert(empty == "rejected" and one == "rejected", "serial routes still validate inputs");
    i = i + 1;
}
// An accelerator can fail even for a small batch; preserve its complete CPU fallback route.
A.clear_runtimes();
A.register_runtime("gpu", fn(_payload) { throw "expected runtime failure"; });
let fallback = CP.run_controlled([2,3], fn(x) { return x*x; }, map{
    devices: [map{ kind: "gpu", usable: true }], preferred_device: "gpu",
    workload: "tensor", min_accelerator_items: 1, min_parallel_items: 4,
});
assert(fallback.ok and fallback.route.fallback_used and fallback.route.workers == 1
    and fallback.results == [4,9], "serial accelerator fallback preserved");
A.clear_runtimes();
assert(CP.run_chunked([1,2,3,4], fn(x) { return x*x; }, 2) == [1,4,9,16], "chunked automatic route");
let storage = CP.storage_read_controlled([]);
assert(storage.results == [] and storage.workers == 0, "empty storage route");
let invalid_storage = try CP.storage_read_controlled([], map{ min_parallel_files: 0 }) catch "rejected";
assert(invalid_storage == "rejected", "empty storage still validates thresholds");
let root = ".compute-serial-storage-" + str_slice(sha256(base64_encode_bytes(random_bytes(16))), 0, 16);
fs_mkdirs(root); fs_write(root + "/a", "first"); fs_write(root + "/b", "second");
let paths = [root + "/a", root + "/b"];
let serial_files = CP.storage_read_controlled(paths);
assert(serial_files.results == ["first", "second"] and serial_files.workers == 1
    and serial_files.mode == "sequential", "small real storage batch is unchanged");
let one_file = CP.storage_read_controlled([paths[0]], map{ min_parallel_files: 1 });
assert(one_file.workers == 1 and one_file.results == ["first"], "singleton storage stays serial");
let threshold_files = CP.storage_read_controlled(paths, map{ min_parallel_files: 2 });
let expected_workers = CP.cpu_cores(); if expected_workers > 2 { expected_workers = 2; }
assert(threshold_files.workers == expected_workers and threshold_files.results == ["first", "second"],
    "storage still resolves cores at the parallel threshold");
fs_remove(paths[0]); fs_remove(paths[1]); fs_remove(root);
print "compute_serial_discovery_pass";
