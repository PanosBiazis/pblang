let A = import("stdlib:secure_archive.sapp");
let Z = import("stdlib:zipfile.sapp");
fn expect(value, message) { if not value { throw message; } }
fn rejects(call) { return try { call(); false } catch true; }
let files = [map{ name: "folder/", data: [] }, map{ name: "folder/raw.bin", data: [0,128,255] },
    map{ name: "readme.txt", data: str_to_bytes("repeat repeat repeat repeat") }];
for mode in ["auto", "fast", "store"] {
    let packed = A.pack(files, mode);
    let report = A.inspect(packed);
    expect(report.verified and len(report.entries)==3 and report.total_bytes==30, "verified report");
    let restored = A.unpack(packed);
    expect(restored[1].data==[0,128,255] and restored[0].directory, "byte exact directories");
    let preview = A.view(packed,"folder/raw.bin",2);
    expect(preview.data==[0,128] and preview.truncated and preview.verified,"bounded view");
    expect(rejects(fn(){ A.inspect(packed,map{max_total_bytes:2}); }),"total cap");
    expect(rejects(fn(){ A.inspect(packed,map{max_entries:2}); }),"entry cap");
}
for name in ["../secret","/root","a\\b","C:a","a//b","a/./b","a/../b","nul.txt","COM1","name.","name ","a:b"] {
    expect(rejects(fn(){A.pack([map{name:name,data:[]}]);}),"bad path pack");
    expect(rejects(fn(){A.inspect(Z.create([map{name:name,data:[]}]));}),"bad path input");
}
expect(rejects(fn(){A.pack([map{name:"a",data:[]},map{name:"A",data:[]}]);}),"case collision");
expect(rejects(fn(){A.pack([map{name:"a",data:[]},map{name:"a/b",data:[]}]);}),"ancestor collision");
expect(rejects(fn(){A.pack([map{name:"a",data:[256]}]);}),"invalid byte");
expect(rejects(fn(){A.pack([map{name:"a/",data:[1]}]);}),"directory data");
expect(rejects(fn(){A.inspect([],map{unknown:1});}),"unknown options");
expect(rejects(fn(){A.pack(files,"unknown");}),"unknown mode");
let original = A.pack([map{name:"a",data:[1,2,3]}],"store");
let bad = slice(original,0,len(original)); bad[31]=99;
expect(rejects(fn(){A.inspect(bad);}),"CRC checked in view/list");
let descriptor=Z.entries(original)[0]; descriptor.offset=-1;
expect(rejects(fn(){Z.read_entry(original,descriptor,8);}),"negative descriptor");
expect(rejects(fn(){Z.read(original,"a",-1);}),"negative output limit");
let sizebad=slice(original,0,len(original)); sizebad[22]=0;
expect(rejects(fn(){Z.read(sizebad,"a",10);}),"local size mismatch");
let extra=slice(original,0,len(original)); extra[len(extra)-10]=1;
expect(rejects(fn(){Z.entries(extra);}),"central exact range");


// Independent CPython ZIP fixture with streaming data descriptor.
let streaming=base64_decode_bytes("UEsDBBQACAAIAHiCQ10AAAAAAAAAAAAAAAAMAAAAZXh0ZXJuYWwudHh0S0ktTi7KLCjJL1IoSS0uUUihMx8AUEsHCEOwjhIVAAAAgAAAAFBLAQIUAxQACAAIAHiCQ11DsI4SFQAAAIAAAAAMAAAAAAAAAAAAAACAAQAAAABleHRlcm5hbC50eHRQSwUGAAAAAAEAAQA6AAAATwAAAAAA");
expect(len(A.unpack(streaming)[0].data)==128,"external streaming ZIP");
let bad_descriptor=slice(streaming,0,len(streaming)); bad_descriptor[67]=bit_xor(bad_descriptor[67],1);
expect(rejects(fn(){A.inspect(bad_descriptor);}),"descriptor CRC mismatch");
let multidisk=slice(streaming,0,len(streaming)); multidisk[113]=1;
expect(rejects(fn(){A.inspect(multidisk);}),"entry disk rejected");
let short_size=slice(streaming,0,len(streaming)); short_size[103]=1;
expect(rejects(fn(){A.inspect(short_size);}),"lying output size");
expect(rejects(fn(){A.view(original,"a",0.5);}),"fractional preview limit");

let linked=base64_decode_bytes("UEsDBBQAAAAAAAAAIQD8L29GBgAAAAYAAAAEAAAAbGlua3RhcmdldFBLAQIUAxQAAAAAAAAAIQD8L29GBgAAAAYAAAAEAAAAAAAAAAAAAAD/oQAAAABsaW5rUEsFBgAAAAABAAEAMgAAACgAAAAAAA==");
expect(rejects(fn(){A.inspect(linked);}),"symlink entry");
let F=import("stdlib:flate.sapp"); let deflated=F.deflate_fast([1,2,3]);array_push(deflated,0);
expect(rejects(fn(){F.inflate(deflated,3,true);}),"trailing compressed bytes");
print "secure_archive_pass";
