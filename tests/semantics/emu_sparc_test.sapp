let SPARC = import("stdlib:emulator_sparc32.sapp");

fn require(condition, message) { if not condition { throw "FAIL emu-sparc: " + message; } }
fn value(parts, message) {
    let result = SPARC.run(SPARC.program(parts));
    if not result.ok { throw "FAIL emu-sparc: " + message + ": " + str(result.error); }
    return result.value;
}

require(SPARC.nop() == 16777216, "canonical nop encoding");
require(SPARC.move_immediate(5, SPARC.O0) == 2416975877, "canonical move encoding");
require(SPARC.trap_always(16) == 2446336016, "canonical trap encoding");
require(SPARC.add_register(SPARC.O0, SPARC.O1, SPARC.O2) == 2483159049, "canonical add encoding");

require(value([SPARC.move_immediate(42, SPARC.O0), SPARC.exit_sequence()], "move") == 42, "move result");
require(value([
    SPARC.move_immediate(30, SPARC.O1), SPARC.add_immediate(SPARC.O1, 12, SPARC.O0),
    SPARC.exit_sequence()
], "add immediate") == 42, "add immediate result");
require(value([
    SPARC.move_immediate(100, SPARC.O1), SPARC.move_immediate(58, SPARC.O2),
    SPARC.subtract_register(SPARC.O1, SPARC.O2, SPARC.O0), SPARC.exit_sequence()
], "subtract register") == 42, "subtract register result");
require(value([
    SPARC.move_immediate(99, SPARC.G0), SPARC.add_immediate(SPARC.G0, 42, SPARC.O0),
    SPARC.exit_sequence()
], "g0") == 42, "g0 remains zero");
require(value([
    SPARC.move_immediate(6, SPARC.O1), SPARC.move_immediate(7, SPARC.O2),
    SPARC.signed_multiply(SPARC.O1, SPARC.O2, SPARC.O0), SPARC.exit_sequence()
], "multiply") == 42, "multiply result");

let sum_loop = SPARC.program([
    SPARC.move_immediate(5, SPARC.O1), SPARC.move_immediate(0, SPARC.O0),
    SPARC.add_register(SPARC.O0, SPARC.O1, SPARC.O0),
    SPARC.subtract_cc_immediate(SPARC.O1, 1, SPARC.G0),
    SPARC.branch_not_equal(-2), SPARC.subtract_immediate(SPARC.O1, 1, SPARC.O1),
    SPARC.exit_sequence()
]);
let sum_result = SPARC.run(sum_loop);
require(sum_result.ok and sum_result.value == 15, "delay-slot loop");

let annul_untaken = SPARC.run(SPARC.program([
    SPARC.move_immediate(42, SPARC.O0), SPARC.move_immediate(0, SPARC.O1),
    SPARC.subtract_cc_immediate(SPARC.O1, 0, SPARC.G0),
    SPARC.branch_not_equal_annul(3), SPARC.add_immediate(SPARC.O0, 100, SPARC.O0),
    SPARC.exit_sequence()
]));
require(annul_untaken.ok and annul_untaken.value == 42, "untaken annul skips delay slot");

let malformed = SPARC.run([4294967296]);
require(not malformed.ok, "reject oversized word");
let escaped = SPARC.run(SPARC.program([SPARC.branch_always(100), SPARC.nop()]));
require(not escaped.ok and escaped.error == "branch target outside code", "reject escaped branch");
let budget = SPARC.run(sum_loop, map{ instruction_budget: 2 });
require(not budget.ok and budget.error == "instruction budget exceeded", "enforce budget");
let delay_control = SPARC.run(SPARC.program([
    SPARC.branch_always(2), SPARC.branch_always(1), SPARC.exit_sequence()
]));
require(not delay_control.ok and delay_control.error == "control transfer in delay slot is not modeled", "reject delay-slot branch");

print "emu_sparc: reusable bounded SPARC V8/LEON subset passed encodings, delay slots, malformed control, and budget checks";
