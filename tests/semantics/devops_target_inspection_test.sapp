let Inspect=import("stdlib:devops_inspection.sapp");
let source="{\"format\":\"pblang.devops-pipeline.v1\",\"jobs\":[{\"id\":\"private_marker\",\"needs\":[]},{\"id\":\"test\",\"needs\":[\"private_marker\"]},{\"id\":\"other\",\"needs\":[]}]}";
fn schema(value) {
    let keys=["format","ok","selection_mode","total_job_count","selected_job_count","target_count",
        "all_jobs_selected","report","execution_performed","production_ready"];
    assert(len(value)==10,"exact target envelope");
    for key in keys { assert(map_has(value,key),"required target field"); }
    assert(value.format=="pblang.devops-target-inspection.v1" and value.selection_mode=="target-closure"
        and not value.execution_performed and not value.production_ready,"distinct nonexecuting scope");
    assert(len(value.report)==11 and value.report.format=="pblang.devops-inspection.v1"
        and value.ok==value.report.ok and value.selected_job_count==value.report.job_count,"inner compatibility and counts");
}
fn bad(text,targets,reveal=false) {
    let value=Inspect.inspect_targets(text,targets,reveal); schema(value);
    assert(not value.ok and value.total_job_count==0 and value.selected_job_count==0 and value.target_count==0
        and not value.all_jobs_selected and not value.report.contains_job_ids
        and len(value.report.stages)==0,"zeroed failure scope");
    assert(not str_contains(json_stringify(value),"private_marker"),"failure masks identifiers");
}
let selected=Inspect.inspect_targets(source,["test"]); schema(selected);
assert(selected.ok and selected.total_job_count==3 and selected.selected_job_count==2
    and selected.target_count==1 and not selected.all_jobs_selected and selected.report.stage_count==2,
    "subset counts cannot masquerade as whole graph");
assert(not selected.report.contains_job_ids and not str_contains(json_stringify(selected),"private_marker"),"masked by default");
let revealed=Inspect.inspect_targets(source,["test"],true); schema(revealed);
assert(revealed.report.contains_job_ids and revealed.report.stages[0].job_ids[0]=="private_marker","literal reveal includes selected ancestors");
let all=Inspect.inspect_targets(source,["test","other"]); schema(all);
assert(all.all_jobs_selected and all.selected_job_count==3 and all.target_count==2,"selection completeness separate from execution");
for targets in [nil,[],"test",["missing"],["test","test"],["private_marker","missing"]] {bad(source,targets,true);}
for reveal in [nil,1,"true",map{},[]] {bad(source,["test"],reveal);}
for text in [nil,"",source+"x",str_repeat("x",65537),
    "{\"format\":\"pblang.devops-pipeline.v1\",\"jobs\":[],\"jobs\":[]}",
    "{\"format\":\"pblang.devops-pipeline.v1\",\"jobs\":[{\"id\":\"test\",\"needs\":[]},{\"id\":\"private_marker\",\"needs\":[\"missing\"]}]}"] {
    bad(text,["test"],true);
}
assert(Inspect.inspect_text(source).format=="pblang.devops-inspection.v1"
    and Inspect.inspect_text(source).job_count==3,"existing full inspection unchanged");
print "devops_target_inspection_pass";
