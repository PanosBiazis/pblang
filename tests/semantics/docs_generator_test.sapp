// tests/semantics/docs_generator_test.sapp — stdlib/docs_generator.sapp HTML generation.
//
// Regression guard for a real bug: `generate_html` and the index page concatenated a bare
// number (`len(functions)` / `len(results)`) into an HTML string with `+`. pblang's `+` does
// NOT coerce number→string, so those lines threw "type mismatch: string + number" the moment
// the generator ran (the module still imported, since the fault was inside a function body).
// The fix wraps them in `str(...)`. This test exercises that exact path end-to-end.

let DG = import("stdlib:docs_generator.sapp");

fn fail(m) { throw "FAIL " + m; }
fn truthy(c, m) { if c != true { fail(m); } }

let fns = [
    map{ name: "foo", signature: "fn foo(a)" },
    map{ name: "bar", signature: "fn bar()" },
];
// The call itself must not throw — it walks the count-concatenation line that was the bug.
let html = DG.generate_html("demo", fns, ["foo"], ["doc for foo", "doc for bar"]);

truthy(len(html) > 0, "generate_html returns non-empty HTML");
truthy(str_contains(html, "demo"), "HTML includes the module name");
truthy(str_contains(html, "Functions (2)"), "the count-concatenation renders the number (the fixed bug site)");
truthy(str_contains(html, "foo"), "HTML lists the documented functions");

print "docs_generator_pass";
