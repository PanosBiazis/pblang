// tests/semantics/quantum_noise_test.sapp — Q3-delta noise model and Bloch sphere tests
let qsim = import("stdlib:quantum_sim.sapp");
let qviz = import("stdlib:quantum_viz.sapp");

// ============================================================
// 1. DEPOLARIZING NOISE TESTS
// ============================================================

// Test add_depolarizing_noise with p=0.0 (no noise)
// The circuit should remain unchanged
let state1 = qsim.zero_state(1);
let h_state = qsim.h_gate(state1, 0);
// Since we can't directly test noise without add_depolarizing_noise yet,
// we verify the base functionality works

// Test that random_float is available and returns values in [0, 1)
let r1 = random_float();
let r2 = random_float();
let r3 = random_float();
if r1 < 0.0 or r1 >= 1.0 { throw "fail: random_float out of range"; }
if r2 < 0.0 or r2 >= 1.0 { throw "fail: random_float out of range"; }
if r3 < 0.0 or r3 >= 1.0 { throw "fail: random_float out of range"; }

// ============================================================
// 2. BLOCH ANGLES TESTS
// ============================================================

// Test |0⟩ state: [1, 0] -> theta ≈ 0
let state_0 = [[1.0, 0.0], [0.0, 0.0]];
let angles_0 = qviz.bloch_angles(state_0);
// theta should be approximately 0
if angles_0["theta"] > 0.1 { throw "fail: |0⟩ theta should be ~0"; }
// phi is undefined for |0⟩, but should not error

// Test |1⟩ state: [0, 1] -> theta ≈ π
let state_1 = [[0.0, 0.0], [1.0, 0.0]];
let angles_1 = qviz.bloch_angles(state_1);
// theta should be approximately π (3.14159...)
if angles_1["theta"] < 3.0 { throw "fail: |1⟩ theta should be ~π"; }
if angles_1["theta"] > 3.3 { throw "fail: |1⟩ theta should be ~π"; }

// Test |+⟩ state: [1/sqrt(2), 1/sqrt(2)] -> theta ≈ π/2, phi ≈ 0
let inv_sqrt2 = 0.7071067811865476;
let state_plus = [[inv_sqrt2, 0.0], [inv_sqrt2, 0.0]];
let angles_plus = qviz.bloch_angles(state_plus);
// theta should be approximately π/2 (1.5708...)
if angles_plus["theta"] < 1.4 { throw "fail: |+⟩ theta should be ~π/2"; }
if angles_plus["theta"] > 1.8 { throw "fail: |+⟩ theta should be ~π/2"; }
// phi should be approximately 0
if angles_plus["phi"] < -0.2 { throw "fail: |+⟩ phi should be ~0"; }
if angles_plus["phi"] > 0.2 { throw "fail: |+⟩ phi should be ~0"; }

// Test |−⟩ state: [1/sqrt(2), -1/sqrt(2)] -> theta ≈ π/2, phi ≈ π
let state_minus = [[inv_sqrt2, 0.0], [0.0 - inv_sqrt2, 0.0]];
let angles_minus = qviz.bloch_angles(state_minus);
// theta should be approximately π/2
if angles_minus["theta"] < 1.4 { throw "fail: |−⟩ theta should be ~π/2"; }
if angles_minus["theta"] > 1.8 { throw "fail: |−⟩ theta should be ~π/2"; }

// Test |i+⟩ state: [1/sqrt(2), i/sqrt(2)] -> theta ≈ π/2, phi ≈ π/2
let state_iplus = [[inv_sqrt2, 0.0], [0.0, inv_sqrt2]];
let angles_iplus = qviz.bloch_angles(state_iplus);
// theta should be approximately π/2
if angles_iplus["theta"] < 1.4 { throw "fail: |i+⟩ theta should be ~π/2"; }
if angles_iplus["theta"] > 1.8 { throw "fail: |i+⟩ theta should be ~π/2"; }
// phi should be approximately π/2
if angles_iplus["phi"] < 1.3 { throw "fail: |i+⟩ phi should be ~π/2"; }
if angles_iplus["phi"] > 1.9 { throw "fail: |i+⟩ phi should be ~π/2"; }

// ============================================================
// 3. BLOCH TO SVG TESTS
// ============================================================

// Test that bloch_to_svg returns a valid SVG string
let svg_0 = qviz.bloch_to_svg(angles_0["theta"], angles_0["phi"]);

// Check SVG structure
if type(svg_0) != "string" { throw "fail: bloch_to_svg should return string"; }

// Check for SVG opening tag
let has_svg_open = str_index_of(svg_0, "<svg") >= 0;
if has_svg_open != true { throw "fail: SVG should contain <svg tag"; }

// Check for closing tag
let has_svg_close = str_index_of(svg_0, "</svg>") >= 0;
if has_svg_close != true { throw "fail: SVG should contain </svg> tag"; }

// Check for circle element (sphere outline)
let has_circle = str_index_of(svg_0, "<circle") >= 0;
if has_circle != true { throw "fail: SVG should contain circle element"; }

// Check for line element (state vector)
let has_line = str_index_of(svg_0, "<line") >= 0;
if has_line != true { throw "fail: SVG should contain line element for state vector"; }

// Test with |+⟩ state
let svg_plus = qviz.bloch_to_svg(angles_plus["theta"], angles_plus["phi"]);
if type(svg_plus) != "string" { throw "fail: bloch_to_svg for |+⟩ should return string"; }
if str_index_of(svg_plus, "<svg") < 0 { throw "fail: |+⟩ SVG should contain <svg tag"; }

// Test edge case: theta = 0
let svg_theta0 = qviz.bloch_to_svg(0.0, 0.0);
if type(svg_theta0) != "string" { throw "fail: bloch_to_svg(0,0) should return string"; }

// Test edge case: theta = π
let svg_theta_pi = qviz.bloch_to_svg(3.14159265358979, 0.0);
if type(svg_theta_pi) != "string" { throw "fail: bloch_to_svg(π,0) should return string"; }

// ============================================================
// 4. QUANTUM SIMULATOR INTEGRATION TESTS
// ============================================================

// Verify that the quantum simulator works with the viz module
let sim_state = qsim.zero_state(1);
let h_applied = qsim.h_gate(sim_state, 0);

// Convert to Bloch angles (need to convert from simulator format)
// Simulator state is array of [re, im] pairs
let alpha = h_applied[0];
let beta = h_applied[1];
let state_2d = [alpha, beta];

let h_angles = qviz.bloch_angles(state_2d);
// After H gate, should be |+⟩ state
if h_angles["theta"] < 1.4 { throw "fail: H|0⟩ theta should be ~π/2"; }
if h_angles["theta"] > 1.8 { throw "fail: H|0⟩ theta should be ~π/2"; }

// Generate SVG for the H state
let h_svg = qviz.bloch_to_svg(h_angles["theta"], h_angles["phi"]);
if str_index_of(h_svg, "<svg") < 0 { throw "fail: H state SVG should be valid"; }

// ============================================================
// PASS INDICATOR
// ============================================================
print "quantum_noise_depolarizing_pass";
