// tests/semantics/registry_server_security_test.sapp — path-traversal fix in add_package.

let RS = import("stdlib/registry_server.sapp");
let F = import("stdlib/fs.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let dir = "tests/fixtures/_regsrv";
// clean slate
if F.exists(dir + "/packages/mypkg-1.0.0.tar.gz") == true { F.remove(dir + "/packages/mypkg-1.0.0.tar.gz"); }
if F.exists(dir + "/evil-1.0.0.tar.gz") == true { F.remove(dir + "/evil-1.0.0.tar.gz"); }

let cfg = RS.RegistryConfig(dir);
RS.registry_init(cfg);
F.write(dir + "/pkg.tar.gz", "dummy-tarball");

// ── safe add works ─────────────────────────────────────────────────────────────────
eq(RS.registry_add_package(cfg, "mypkg", "1.0.0", "desc", "me", dir + "/pkg.tar.gz"), true, "safe add ok");
if F.exists(dir + "/packages/mypkg-1.0.0.tar.gz") != true { fail("safe package written into packages dir"); }

// ── FIX: a traversal package name must be rejected and write nothing outside ───────
eq(RS.registry_add_package(cfg, "../evil", "1.0.0", "d", "a", dir + "/pkg.tar.gz"), false, "traversal name rejected");
if F.exists(dir + "/evil-1.0.0.tar.gz") == true { F.remove(dir + "/evil-1.0.0.tar.gz"); fail("VULN: file escaped packages_dir via name"); }

// ── traversal/slash in version is also rejected ───────────────────────────────────
eq(RS.registry_add_package(cfg, "pkg", "../1.0", "d", "a", dir + "/pkg.tar.gz"), false, "traversal version rejected");
eq(RS.registry_add_package(cfg, "a/b", "1.0.0", "d", "a", dir + "/pkg.tar.gz"), false, "slash in name rejected");

// cleanup
if F.exists(dir + "/packages/mypkg-1.0.0.tar.gz") == true { F.remove(dir + "/packages/mypkg-1.0.0.tar.gz"); }
if F.exists(dir + "/pkg.tar.gz") == true { F.remove(dir + "/pkg.tar.gz"); }

print "registry_server_security_pass";
