// tests/semantics/algo_stdlib_test.sapp
let algo = import("stdlib:algo.sapp");

// binary_search
let sorted = [1, 3, 5, 7, 9, 11, 13];
if algo.binary_search(sorted, 7) != 3 { throw "FAIL binary_search found: " + str(algo.binary_search(sorted, 7)); }
if algo.binary_search(sorted, 6) != -1 { throw "FAIL binary_search not found"; }

// gcd, lcm
if algo.gcd(48, 18) != 6 { throw "FAIL gcd: " + str(algo.gcd(48, 18)); }
if algo.lcm(4, 6) != 12 { throw "FAIL lcm: " + str(algo.lcm(4, 6)); }

// is_prime
if algo.is_prime(7) == false { throw "FAIL is_prime 7"; }
if algo.is_prime(4) { throw "FAIL is_prime 4"; }
if algo.is_prime(1) { throw "FAIL is_prime 1"; }
if algo.is_prime(2) == false { throw "FAIL is_prime 2"; }

// fibonacci
if algo.fibonacci(0) != 0 { throw "FAIL fib(0)"; }
if algo.fibonacci(1) != 1 { throw "FAIL fib(1)"; }
if algo.fibonacci(10) != 55 { throw "FAIL fib(10): " + str(algo.fibonacci(10)); }

// factorial
if algo.factorial(5) != 120 { throw "FAIL factorial(5)"; }
if algo.factorial(0) != 1 { throw "FAIL factorial(0)"; }

// merge_sort
let unsorted = [5, 2, 8, 1, 9, 3];
let s = algo.merge_sort(unsorted);
if s[0] != 1 or s[5] != 9 { throw "FAIL merge_sort: " + str(s[0]) + " " + str(s[5]); }

// flatten
let nested = [1, [2, 3], [4, [5]]];
let flat = algo.flatten(nested);
if flat[0] != 1 or flat[1] != 2 or flat[4] != 5 { throw "FAIL flatten: " + str(flat); }

print "algo_stdlib_pass";
