// tests/semantics/networking_advanced_enrich_test.sapp — fixes + enrichment
//
// FIXES:
//  * url_decode/url_encode only handled ~6 hard-coded chars ("%41" stayed "%41");
//    now general (any %XX, "+", full reserved set, UTF-8).
//  * url_parse threw parse_number on a non-numeric port and mis-parsed IPv6 hosts.
// ENRICHMENT: is_private_ip (SSRF guard), cidr_hosts, broadcast.

let na = import("stdlib/networking_advanced.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── FIX: complete url_decode ────────────────────────────────────────────────────
eq(na.url_decode("%41"), "A", "general %XX decode");
eq(na.url_decode("%2B"), "+", "%2B -> +");
eq(na.url_decode("a+b"), "a b", "+ -> space");
eq(na.url_decode(na.url_encode("café")), "café", "unicode encode/decode round-trip");
eq(na.url_decode(na.url_encode("a b&c=d")), "a b&c=d", "reserved round-trip (existing contract)");

// ── FIX: url_parse safe port + IPv6 ─────────────────────────────────────────────
eq(na.url_parse("http://host:notaport/p").port, nil, "non-numeric port -> nil (no throw)");
let v = na.url_parse("http://[::1]:8080/x");
eq(v.host, "[::1]", "ipv6 host keeps brackets");
eq(v.port, 8080, "ipv6 port");
// existing basic parse still correct
let u = na.url_parse("https://example.com:8443/a?x=1");
eq(u.host, "example.com", "basic host"); eq(u.port, 8443, "basic port"); eq(u.path, "/a", "basic path");

// ── ENRICH: is_private_ip (SSRF guard) ──────────────────────────────────────────
if not na.is_private_ip("10.1.2.3") { fail("10/8 private"); }
if not na.is_private_ip("172.16.5.5") { fail("172.16/12 private"); }
if na.is_private_ip("172.32.0.1") { fail("172.32 is NOT in 172.16/12"); }
if not na.is_private_ip("192.168.0.9") { fail("192.168/16 private"); }
if not na.is_private_ip("127.0.0.1") { fail("loopback private"); }
if not na.is_private_ip("169.254.1.1") { fail("link-local private"); }
if na.is_private_ip("8.8.8.8") { fail("public must be false"); }

// ── ENRICH: cidr_hosts / broadcast ──────────────────────────────────────────────
eq(na.cidr_hosts("192.168.1.0/24"), 254, "/24 usable hosts");
eq(na.cidr_hosts("10.0.0.0/30"), 2, "/30 usable hosts");
eq(na.cidr_hosts("10.0.0.0/31"), 2, "/31 (RFC 3021) = 2");
eq(na.cidr_hosts("10.0.0.5/32"), 1, "/32 = 1");
eq(na.broadcast("192.168.1.0/24"), "192.168.1.255", "broadcast address");

print "networking_advanced_enrich_pass";
