let pq = import("stdlib/min_priority_queue.sapp");

fn eq(actual, expected, label) {
    if actual != expected { throw "FAIL " + label + ": got=" + str(actual) + " expected=" + str(expected); }
}

let queue = pq.new();
eq(pq.is_empty(queue), true, "new queue empty");
eq(pq.pop(queue), nil, "empty pop");
pq.push(queue, "medium", 5);
pq.push(queue, "late", 9);
pq.push(queue, "first", 1);
pq.push(queue, "early", 2);
eq(pq.size(queue), 4, "size after pushes");
eq(pq.peek(queue).value, "first", "peek minimum");
eq(pq.pop(queue).value, "first", "pop priority 1");
eq(pq.pop(queue).value, "early", "pop priority 2");
eq(pq.pop(queue).value, "medium", "pop priority 5");
eq(pq.pop(queue).value, "late", "pop priority 9");
eq(pq.is_empty(queue), true, "drained queue empty");

eq(try pq.push(queue, "text", "high") catch "caught", "caught", "non-number priority rejected");
eq(try pq.push(queue, "nan", 0 / 0) catch "caught", "caught", "NaN priority rejected");
eq(try pq.push(queue, "infinity", 1 / 0) catch "caught", "caught", "infinite priority rejected");
pq.push(queue, "x", 1);
pq.clear(queue);
eq(pq.size(queue), 0, "clear");

print "min_priority_queue_pass";
