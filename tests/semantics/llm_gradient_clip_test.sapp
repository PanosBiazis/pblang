let AD=import("stdlib:llm_adapters.sapp");
fn rejects(f) {return try {f();false} catch true;}
assert(not rejects(fn(){return 1;}) and rejects(fn(){throw "expected";}),"calibrated rejection helper");
let model=map{lm_head:[[0.1,-0.1],[0.2,-0.2]],lm_bias:[0.0,0.0]};
let ad=AD.lm_head_adapter(model,1,2,5);ad.a_matrix=[[0.3],[-0.2]];ad.b_matrix=[[0.4,-0.1]];
let hidden=[0.7,-0.5];let targets=[0.25,0.75];let saved=json_stringify([model,ad,hidden,targets]);
for temperature in [0.25,1,2,8] {
 let plain=AD.train_soft_step(model,ad,hidden,targets,0.1,temperature);
 let loose=AD.train_soft_step_clipped(model,ad,hidden,targets,0.1,temperature,1000);
 assert(json_stringify(plain.updated_a_matrix)==json_stringify(loose.updated_a_matrix)
  and json_stringify(plain.updated_b_matrix)==json_stringify(loose.updated_b_matrix),"nonbinding clipping preserves exact legacy updates");
 let clipped=AD.train_soft_step_clipped(model,ad,hidden,targets,0.1,temperature,0.01);
 let norm_squared=0.0;let displacement=0.0;let eps=0.00001;
 for key in ["a_matrix","b_matrix"] {for row len(ad[key]) {for col len(ad[key][row]) {
  let plus=json_parse(json_stringify(ad));let minus=json_parse(json_stringify(ad));
  plus[key][row][col]=plus[key][row][col]+eps;minus[key][row][col]=minus[key][row][col]-eps;
  let numerical=(AD.soft_target_loss(AD.logits(model,hidden,plus),targets,temperature)-AD.soft_target_loss(AD.logits(model,hidden,minus),targets,temperature))/(2*eps);
  norm_squared=norm_squared+numerical*numerical;
  let updated=if key=="a_matrix" {clipped.updated_a_matrix} else {clipped.updated_b_matrix};
  let delta=ad[key][row][col]-updated[row][col];displacement=displacement+delta*delta;
  let error=delta-0.1*numerical*clipped.gradient_scale;
  assert(error*error<0.0000000000000001,"both factors share one scale and retain numerical gradient direction");
 }}}
 let error=clipped.gradient_norm-num_sqrt(norm_squared);
 assert(error*error<0.0000000000000001 and clipped.gradient_clipped,"reported norm matches independent finite differences");
 assert(displacement<=0.000001000001 and displacement>=0.000000999999,"joint update L2 norm equals learning rate times limit");
 assert(clipped.next_steps==1 and clipped.next_examples==1 and clipped.loss==plain.loss,"counter and pre-update loss compatibility");
}
assert(saved==json_stringify([model,ad,hidden,targets]),"inputs remain unmodified");
let zero_ad=AD.lm_head_adapter(model,1,2,5);zero_ad.a_matrix=[[0],[0]];
let zero_step=AD.train_soft_step_clipped(model,zero_ad,hidden,targets,0.1,2,1);
assert(zero_step.gradient_norm==0 and zero_step.gradient_scale==1 and not zero_step.gradient_clipped,"zero norm does not divide by zero");
let zero=len([]);
for bad in [nil,true,"1",0,-1,0.0000001,1001,1/zero,0/zero] {
 assert(rejects(fn(){AD.train_soft_step_clipped(model,ad,hidden,targets,0.1,2,bad);}),"invalid clipping limit");
}
let large_model=map{lm_head:[[0,0]],lm_bias:[0,0]};let large=AD.lm_head_adapter(large_model,1,1,5);
large.a_matrix=[[0]];large.b_matrix=[[1,0]];
let large_step=AD.train_soft_step_clipped(large_model,large,[num_pow(10,100)],[0,1],0.1,2,1);
assert(large_step.gradient_norm>num_pow(10,90) and large_step.gradient_scale>0,"large finite gradients normalize without overflow");
assert(rejects(fn(){AD.train_soft_step_clipped(large_model,large,[num_pow(10,200)],[0,1],0.1,2,1);}),"oversized gradients rejected, never replaced with zero");
assert(rejects(fn(){AD.train_soft_step_clipped(model,ad,hidden,[0,0],0.1,2,1);}),"soft target validation retained");
print "llm_gradient_clip_pass";
