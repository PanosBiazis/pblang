// tests/semantics/template_enrich_test.sapp — enrichment for stdlib/template.sapp
//
// SECURITY: render_safe() auto-HTML-escapes every {{ }} substitution (XSS-safe by
//   default), with a "| safe" / "| raw" filter to opt a value out. Plain render()
//   stays raw (unchanged) for backward compatibility.
// ENRICH: capitalize / truncate / reverse filters.

let tmpl = import("stdlib/template.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base behavior unchanged: render() does NOT escape ────────────────────────────
eq(tmpl.render("Hi {{ name }}", map{ name: "Jo" }), "Hi Jo", "render basic");
eq(tmpl.render("{{ x }}", map{ x: "<b>" }), "<b>", "render leaves raw (unchanged)");

// ── SECURITY: render_safe auto-escapes ───────────────────────────────────────────
eq(tmpl.render_safe("{{ x }}", map{ x: "<script>alert(1)</script>" }),
   "&lt;script&gt;alert(1)&lt;/script&gt;", "render_safe escapes HTML");
eq(tmpl.render_safe("{{ x | safe }}", map{ x: "<b>ok</b>" }), "<b>ok</b>", "| safe opts out of escaping");

// ── render_safe escapes inside loops too ─────────────────────────────────────────
eq(tmpl.render_safe("{% for i in items %}{{ i }}{% endfor %}", map{ items: ["<a>", "<b>"] }),
   "&lt;a&gt;&lt;b&gt;", "render_safe escapes loop output");

// ── ENRICH: filters ──────────────────────────────────────────────────────────────
eq(tmpl.render("{{ name | capitalize }}", map{ name: "alice" }), "Alice", "capitalize filter");
eq(tmpl.render("{{ s | truncate:5 }}", map{ s: "hello world" }), "hello...", "truncate filter");
eq(tmpl.render("{{ s | reverse }}", map{ s: "abc" }), "cba", "reverse filter");
// existing filters still work
eq(tmpl.render("{{ name | upper }}", map{ name: "jo" }), "JO", "upper still works");

print "template_enrich_pass";
