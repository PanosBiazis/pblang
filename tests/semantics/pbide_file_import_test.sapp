let U=import("editors/ide/pbide_file_import.sapp");
let ct="multipart/form-data; boundary=PB_test";
let disposition="Content-Disposition: form-data; name=\"upload\"; filename=\"private-canary.sapp\"";
fn envelope(source,workspace="workspace") {
    return "--PB_test\r\nContent-Disposition: form-data; name=\"workspace\"\r\n\r\n"+workspace
        +"\r\n--PB_test\r\n"+disposition+"\r\nContent-Type: text/plain\r\n\r\n"+source+"\r\n--PB_test--\r\n";
}
let source="\nlet π=\"😀\";\r\ninline --PB_test\r\n";
let good=envelope(source);
let result=U.parse(good,ct);
assert(result.source==source and result.workspace=="workspace","multipart preserves source including trailing CRLF");
assert(U.parse(str_slice(good,0,len(good)-2),ct).source==source,"final CRLF optional");
assert(U.parse(envelope(""),ct).source=="","selected empty file accepted");
assert(U.parse(str_replace_all(good,"Content-Type: text/plain\r\n",""),ct).source==source,"file MIME optional");
assert(U.boundary("multipart/form-data; boundary=\"PB_test\"")=="PB_test","quoted boundary accepted");
for invalid in ["", "multipart/form-data",ct+"; x=y", "multipart/form-data; boundary=a b",
    "multipart/form-data; boundary="+str_repeat("a",71), "multipart/form-data; boundary=\"a",nil] {
    assert((try { U.boundary(invalid); false; } catch true),"malformed content type rejected");
}
for bad in ["preamble"+good,good+"epilogue",good+"\r\n",str_replace_all(good,"\r\n","\n"),
    str_replace_all(good,"name=\"workspace\"","name=\"upload\""),
    str_replace_all(good,"name=\"upload\"","name=\"workspace\""),
    str_replace_all(good,"filename=\"private-canary.sapp\"","filename=\"\""),
    str_replace_all(good,"filename=\"private-canary.sapp\"","filename=\"x\"; extra=\"y\""),
    str_replace_all(good,disposition,disposition+"\r\n"+disposition),
    str_replace_all(good,"Content-Type: text/plain","X-Unknown: text/plain"),
    str_replace_all(good,"Content-Type: text/plain"," Content-Type: text/plain"),
    str_replace_all(good,"Content-Type: text/plain","Content-Type: text/plain; charset=utf-8"),
    str_replace_all(good,"Content-Type: text/plain","Content-Type: text/plain\r\nContent-Type: text/plain"),
    str_replace_all(good,"private-canary.sapp",str_repeat("x",513)),
    envelope("early\r\n--PB_test--\r\nignored"),envelope("a\r\n--PB_test\r\nextra"),
    envelope("a\r\n--PB_test-suffix"),envelope("x",str_repeat("x",17665)),str_repeat("x",U.MAX_BODY+1)] {
    assert((try { U.parse(bad,ct); false; } catch true),"malformed or ambiguous envelope rejected");
}
let bom=strfromcharcode(65279);
assert(U.normalize(bom+"α\r\n😀\r\n")=="α\n😀\n","one BOM stripped, CRLF normalized");
assert(U.normalize(bom+bom+"x")==bom+"x","only one leading BOM stripped");
assert(U.normalize(str_repeat("x",4096))==str_repeat("x",4096),"exact raw byte cap accepted");
assert(U.normalize(str_repeat("😀",1024))==str_repeat("😀",1024),"UTF-8 byte cap accepted");
for bad in [str_repeat("x",4097),str_repeat("😀",1025),bom+str_repeat("x",4094),
    str_repeat("\r\n",2049),"a\rb","a"+strfromcharcode(0)+"b",nil] {
    assert((try { U.normalize(bad); false; } catch true),"raw byte and text limits enforced before normalization");
}
print "pbide_file_import_pass";
