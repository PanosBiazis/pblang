let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let P=import("stdlib:selfhost_pbck.sapp");
fn check(ok,label){if not ok {throw "FAIL lifetime: "+label;}}
fn run(source,want){
    let c=F.frontend_compile(source);check(c.ok,"compile "+str(c.diagnostics)+" "+source);
    let a=V.run(c.chunk);
    let b=F.frontend_run(source);
    let d=V.run(P.deserialize_chunk(P.serialize_chunk(c.chunk)));
    check(a.globals.result==want and b.globals.result==want and d.globals.result==want,"values survive cleanup");
    return a;
}
let a=run("if true {let unused=[1,2,3];} let result=7;",7);
check(a.locals==[nil],"scope drops array reference");
a=run("let keep=map{n:0}; if true {let value=map{n:4};keep=value;} keep.n=8; let result=keep.n;",8);
check(a.locals==[nil],"alias kept, dead local cleared");
a=run("let result=if true {let value=[1,2];value;} else {[];};",[1,2]);
check(a.locals==[nil],"block result survives");
run("let f=fn(){return map{n:0};}; if true {let value=map{n:7};f=fn(){return value;};} let result=f().n;",7);
run("fn make(){let value=[8];return fn(){return value;};} let result=make()();",[8]);
a=run("for item in [[1],[2]] {let value=item;break;} let result=3;",3);
for value in a.locals {check(value==nil,"break clears binder/iterable/body");}
a=run("for i 3 {let value=[i];continue;} let result=4;",4);
for value in a.locals {check(value==nil,"continue and exit clear locals");}
a=run("let result=match [2] {case x if false:x; else:[9];};",[9]);
for value in a.locals {check(value==nil,"failed guard and subject cleanup");}
a=run("let result=match [2] {case x:x;};",[2]);
for value in a.locals {check(value==nil,"match result cleanup");}
// Escaping cells survive even when the original frame reference is cleared.
a=run("let saved=[]; for i 2 {let value=[i];if i==1 {continue;} array_push(saved,fn(){return value;});} let result=saved[0]();",[0]);
check(a.locals[3]==nil,"continue clears owner slot while escaped cell survives");
run("fn f(){let value=[8];let g=try fn(){return value;} catch nil;return g;} let result=f()();",[8]);
run("let result=try (if true {let v=[3];v;} else {[];}) catch [];",[3]);
a=run("let f=fn(){return [0];};if true {let value=[9];f=try fn(){return value;} catch f;}let result=f();",[9]);
check(a.locals[0]==nil,"try capture retains cell without retaining owner slot");
// No manual memory library, free or scheduler control is used.
print "selfhost_lifetime_pass";
