// One bounded product acceptance per invocation; both dependencies copied/hidden.
if platform()!="linux" {print "pbai_reviewed_reload_skip_linux_required";os_exit(0);}
let U=import("stdlib:uuid.sapp");let parent=path_dirname(cwd());let exe=env_get("PBLANG_BIN");
let product=env_get("PBAI_RELOAD_PRODUCT");assert(product=="pblang" or product=="pbai","select one reload product");
assert(type(exe)=="string" and exe!="","trusted PBLANG_BIN required");
let root=path_join("/tmp","pbai-reviewed-reload-installed-"+U.v4());let caller=path_join(root,"caller");let step=["setup"];
fn process(command,args){let argv=["-s","INT","-k","2s","12s",command];for arg in args {push(argv,arg);}return proc_spawn_wait("/usr/bin/timeout",argv);}
fn must(command,args){let out=process(command,args);assert(out.exit_code==0,"reviewed reload fixture operation");return out;}
fn build(at){let out=must("/usr/bin/env",["-C",at,exe,"build"]);assert(str_contains(out.stdout,"build ok"),"fixture build");}
fn hidden(at,mode,file="example.sapp"){
 let args=["--die-with-parent","--unshare-net","--ro-bind","/","/","--dev","/dev","--bind",root,root,
  "--tmpfs",path_join(parent,"pblang"),"--tmpfs",path_join(parent,"pbai")];
 let extra=env_get("PBAI_SOURCE_HIDE_ROOT");if type(extra)=="string" and extra!="" {push(args,"--tmpfs");push(args,extra);}
 for value in ["--setenv","PBAI_STATE_ROOT",path_join(root,"state"),"--setenv","PBAI_RELOAD_PHASE",mode,
  "--setenv","PBAI_CHECKPOINT_TEST_DIR",path_join(at,"private"),"--setenv","PBAI_CHECKPOINT_TEST_PHASE","reload",
  "--chdir",caller,exe,"run",path_join(at,file),"--allow-all","--deny-net","--deny-http","--deny-sqlite"] {push(args,value);}
 return process("/usr/bin/bwrap",args);
}
fn example(at,mode){let out=hidden(at,mode);
 if out.exit_code!=0 {print out.stdout;print str_replace_all(out.stderr,root,"<fixture>");}
 assert(out.exit_code==0 and not str_contains(out.stdout,"DECOY_EXECUTED"),"reviewed example completes from selected source");return json_parse(out.stdout);
}
fn check_steps(value,expected,digests){
 assert(value.final_active_closed and value.initial_prediction_blocked and not value.globally_activated and len(value.steps)==len(expected),"all active models terminal after example");
 for i in range(0,len(expected)) {
  let item=value.steps[i];assert(item.decision==expected[i] and item.active_token==5 and item.active_digest==digests[i],"exact decision and preserved/selected model");
  assert(item.previous_prediction_available==(expected[i]!="replaced"),"previous handle itself remains usable after failure");
  assert(item.retired_closed==(expected[i]=="replaced") and item.retired_prediction_blocked==item.retired_closed,"only replacement retires prior model");
  assert(item.candidate_acquired==(expected[i]!="load_failed") and item.candidate_closed==item.candidate_acquired,"every acquired review candidate closes");
 }
}
fn exercise(){
 fs_mkdirs(root);must("/bin/chmod",["700",root]);fs_mkdirs(caller);fs_mkdirs(path_join(root,"state"));fs_mkdirs(path_join(caller,"stdlib"));
 for name in ["pbai_checkpoint_scope.sapp","resource_scope.sapp","pbai_student_checkpoint_io.sapp","secure_file.sapp","pbai_neural_adapter.sapp","pbai_specialist_binding.sapp","serialization.sapp","json.sapp"] {
  fs_write(path_join(path_join(caller,"stdlib"),name),"print \"DECOY_EXECUTED\";throw \"caller decoy\";\n");
 }
 fs_write(path_join(caller,"main.sapp"),"print 0;\n");
 fs_write(path_join(caller,"pblang.toml"),"[package]\nname=\"reload-caller\"\nversion=\"0.1.0\"\nentry=\"main.sapp\"\n[dependencies]\nstdlib={path=\"stdlib\"}\n");build(caller);
 for repo in ["pblang","pbai"] {
  let source=path_join(parent,repo);let at=path_join(root,repo);fs_mkdirs(at);must("/bin/cp",["-R",path_join(source,"stdlib"),path_join(at,"stdlib")]);
  let examples=if repo=="pblang" {"examples"} else {"demo"};
  fs_write(path_join(at,"example.sapp"),fs_read(path_join(source,path_join(examples,"pbai_student_checkpoint_reload_reviewed.sapp"))));
  fs_write(path_join(at,"legacy.sapp"),fs_read(path_join(source,path_join(examples,"pbai_student_checkpoint_file.sapp"))));
  fs_write(path_join(at,"closed.sapp"),"let IO=import(\"stdlib:pbai_student_checkpoint_io.sapp\");let h=IO.load_file(path_join(env_get(\"PBAI_CHECKPOINT_TEST_DIR\"),\"student.json\"));h.close();h.compare(\"SYNTHETIC_PRIVATE_CANDIDATE\",nil);throw \"UNEXPECTED_COMPARISON\";\n");
  fs_mkdirs(path_join(at,"private"));must("/bin/chmod",["700",path_join(at,"private")]);
  let dep=if repo=="pblang" {"stdlib"} else {"../pblang/stdlib"};
  fs_write(path_join(at,"pblang.toml"),"[package]\nname=\"reviewed-reload-installed\"\nversion=\"0.1.0\"\nentry=\"example.sapp\"\n[dependencies]\nstdlib={path="+json_stringify(dep)+"}\n");
 }
 build(path_join(root,"pblang"));build(path_join(root,"pbai"));let at=path_join(root,product);step[0]="prepare";
 let prepared=example(at,"prepare");assert(prepared.created==3 and not prepared.globally_activated,"three explicitly prepared synthetic files");
 let dir=path_join(at,"private");let original=fs_read(path_join(dir,"student.json"));let better=fs_read(path_join(dir,"better.json"));let worse=fs_read(path_join(dir,"worse.json"));
 let old_digest=json_parse(original).digest;let new_digest=json_parse(better).digest;assert(old_digest!=new_digest,"distinct candidate checkpoints");
 step[0]="unguarded baseline";fs_write(path_join(dir,"candidate.json"),worse);let prior=hidden(at,"legacy","legacy.sapp");
 assert(prior.exit_code==0,"existing unguarded reload runs");let baseline=json_parse(prior.stdout);
 assert(baseline.loaded and baseline.token==6 and baseline.retired_closed and baseline.active_closed,"well-formed checkpoint alone can replace correct token 5 with wrong token 6");
 print "reviewed_reload_baseline_valid_but_regressing:1";
 step[0]="recovery";let recovered=example(at,"recover");check_steps(recovered,["load_failed","rejected","replaced","unchanged"],[old_digest,old_digest,new_digest,new_digest]);
 assert(not recovered.steps[1].review.passed and recovered.steps[1].review.baseline_correct_regressions==1
  and recovered.steps[2].review.passed and recovered.steps[2].review.candidate.loss<recovered.steps[2].review.baseline.loss,"quality gate is computed from real models");
 step[0]="review failure";let failed=example(at,"review-error");check_steps(failed,["review_failed"],[old_digest]);
 step[0]="corrupt file recovery";fs_write(path_join(dir,"worse.json"),"{}");let corrupt=example(at,"recover");
 check_steps(corrupt,["load_failed","load_failed","replaced","unchanged"],[old_digest,old_digest,new_digest,new_digest]);
 assert(fs_read(path_join(dir,"worse.json"))=="{}","no repair or overwrite of corrupt candidate");fs_write(path_join(dir,"worse.json"),worse);
 step[0]="closed comparison privacy";let closed=hidden(at,"closed","closed.sapp");
 assert(closed.exit_code!=0 and str_contains(closed.stderr,": student checkpoint is closed\n")
  and not str_contains(closed.stdout+closed.stderr,"SYNTHETIC_PRIVATE_CANDIDATE")
  and not str_contains(closed.stdout+closed.stderr,"UNEXPECTED_COMPARISON"),"closed guard precedes invalid private input validation");
 assert(fs_read(path_join(dir,"student.json"))==original and fs_read(path_join(dir,"better.json"))==better
  and fs_read(path_join(dir,"worse.json"))==worse,"all original checkpoint bytes preserved");
 print json_stringify(map{format:"pbai.reviewed-reload.acceptance.v1",product:product,recovery:recovered,review_failure:failed,corrupt_recovery:corrupt,closed_error_checked:true});
}
let passed=try {exercise();true} catch false;let removed=process("/bin/rm",["-rf","--",root]);
assert(passed,"reviewed reload acceptance: "+step[0]);assert(removed.exit_code==0,"private fixture cleanup");
print "pbai_reviewed_reload_"+product+"_pass";
