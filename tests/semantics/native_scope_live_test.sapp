if platform()!="linux" { print "native_scope_live_skip_linux_required"; os_exit(0); }
let SESSION=import("stdlib/native/compile_session.sapp");
let UUID=import("stdlib:uuid.sapp");let OS=import("stdlib:os.sapp");
let compiler=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let base=path_join(OS.temp_dir(),"pblang_scope_"+UUID.v4());
let source_path=base+".sapp";let output=base+".elf";let cache=base+"_cache";
fn child(args) {
    let argv=["-k","1s","8s",compiler];
    for arg in args { array_push(argv,arg); }
    return proc_spawn_wait("/usr/bin/timeout",argv);
}
fn check_scope(result) {
    assert(result.memory_safety_certified==false and result.runtime_isolated==false,"session cannot upgrade partial checks into isolation");
    assert(result.safety_scope=="selected_runtime_checks","explicit session scope");
}
fn exercise() {
    let valid=child(["run","tests/fixtures/native_heap_probe.sapp","--allow-all","--","valid"]);
    assert(valid.exit_code==0 and valid.stdout=="native_heap_probe_pass\n","diagnostic positive control");
    for mode in ["nan","infinity","private"] {
        let result=child(["run","tests/fixtures/native_heap_probe.sapp","--allow-all","--",mode]);
        let error=if mode=="private" {"heap reserve must be a byte count"} else {"heap reserve must be between 1 MiB and 1 GiB"};
        assert(result.exit_code==1 and str_contains(result.stderr,"]: codegen: "+error+"\n"),"actual fixed configuration error");
        assert(not str_contains(result.stderr+result.stdout,"private_canary"),"private configuration not echoed");
    }
    let source="print 42;";
    let state=SESSION.session(map{cache_root:cache});
    let cold=SESSION.compile_bytes(state,source);let warm=SESSION.compile_bytes(state,source);
    assert(cold.ok and warm.ok and cold.mode=="compiled" and warm.mode=="cache-hit","cold/warm scope controls");
    check_scope(cold);check_scope(warm);
    let batch=SESSION.compile_one(state,source,output);
    assert(batch.ok and batch.results[0].mode=="cache-hit","publication control");
    check_scope(batch);check_scope(batch.results[0]);fs_remove(output);
    fs_write(source_path,source);
    let cli=child(["run","tools/pbc.sapp","--allow-all","--",source_path,"--out",output,"--safe"]);
    assert(cli.exit_code==0 and fs_exists(output),"CLI compatibility build");
    assert(str_contains(cli.stdout,"selected runtime checks") and str_contains(cli.stdout,"memory-safety certified: false; runtime isolated: false"),"CLI reports actual guarantee");
    assert(not str_contains(cli.stdout,"CERTIFIED SAFE"),"CLI does not print false certificate");
    let permission=proc_spawn_wait("chmod",["700",output]);assert(permission.exit_code==0,"native permission");
    let run=proc_spawn_wait("/usr/bin/timeout",["-k","1s","3s",output]);
    assert(run.exit_code==0 and run.stdout=="42\n","CLI emitted working executable");fs_remove(output);
    let driver=child(["run","bench/drivers/repro_codegen_x64.sapp","--allow-all","--",source_path,output]);
    assert(driver.exit_code==0 and fs_exists(output),"uncached benchmark still publishes valid ELF");
}
let passed=try {exercise();true} catch false;
for p in [source_path,output] {try fs_remove(p) catch nil;}
for entry in (try fs_listdir(cache) catch []) {try fs_remove(path_join(cache,entry)) catch nil;}
try fs_remove(cache) catch nil;
assert(passed,"native scope integration regression");
print "native_scope_live_pass";
