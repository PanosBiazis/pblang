// Test: comparison operator overloading (__eq__/__ne__/__lt__/__le__/__gt__/__ge__)
// `==`/`!=` are structural by default and overload opt-in by presence of __eq__.
// `<`/`>`/`<=`/`>=` route through native num_cmp; when that can't compare (non-
// numbers) they dispatch the ordering dunder. Reflection (a > b ⟺ b < a) means
// defining __lt__, __le__, __eq__, __ne__ yields all six operators.

// --- Plain-map Version type ordered by (major, minor) ---
fn ver(maj, min) {
    return map{
        maj: maj, min: min,
        __eq__: fn(self, o) { return self.maj == o.maj and self.min == o.min; },
        __ne__: fn(self, o) { return not (self.maj == o.maj and self.min == o.min); },
        __lt__: fn(self, o) {
            if self.maj != o.maj { return self.maj < o.maj; }
            return self.min < o.min;
        },
        __le__: fn(self, o) {
            if self.maj != o.maj { return self.maj < o.maj; }
            return self.min <= o.min;
        },
    };
}

let a = ver(1, 2);
let b = ver(1, 5);
let c = ver(1, 2);

assert((a < b) == true, "a < b via __lt__");
assert((b > a) == true, "b > a via reflected __lt__");
assert((a <= c) == true, "a <= c via __le__");
assert((b >= a) == true, "b >= a via reflected __le__");
assert((a == c) == true, "a == c via __eq__");
assert((a != b) == true, "a != b via __ne__");
assert((a == b) == false, "a == b distinct versions");
assert((b < a) == false, "b < a is false");
assert((a >= b) == false, "a >= b is false (reflected __le__ gives b<=a false)");

// --- Native class instances: comparison via __class method table ---
class Temp {
    fn init(self, c) { self.c = c; }
    fn __eq__(self, o) { return self.c == o.c; }
    fn __lt__(self, o) { return self.c < o.c; }
    fn __le__(self, o) { return self.c <= o.c; }
}
let t1 = Temp(20);
let t2 = Temp(30);
assert((t1 < t2) == true, "Temp < via __class dispatch");
assert((t2 > t1) == true, "Temp > via reflected __class dispatch");
assert((t1 == Temp(20)) == true, "Temp == via __class dispatch");
assert((t1 <= Temp(20)) == true, "Temp <= equal via __class dispatch");

// --- Custom ordering is usable for sorting (manual insertion sort using <) ---
let items = [ver(2, 0), ver(1, 5), ver(1, 2), ver(3, 1), ver(1, 0)];
let n = len(items);
for i in 1 to n - 1 {
    let key = items[i];
    let j = i - 1;
    while j >= 0 and key < items[j] {
        items[j + 1] = items[j];
        j = j - 1;
    }
    items[j + 1] = key;
}
// Expect sorted: (1,0) (1,2) (1,5) (2,0) (3,1)
assert(items[0].maj == 1 and items[0].min == 0, "sorted[0] = (1,0)");
assert(items[1].maj == 1 and items[1].min == 2, "sorted[1] = (1,2)");
assert(items[2].maj == 1 and items[2].min == 5, "sorted[2] = (1,5)");
assert(items[3].maj == 2 and items[3].min == 0, "sorted[3] = (2,0)");
assert(items[4].maj == 3 and items[4].min == 1, "sorted[4] = (3,1)");

// --- Native numeric/string comparison and equality are unaffected ---
assert((5 == 5) == true, "numeric == fast path");
assert((5 != 6) == true, "numeric != fast path");
assert((3 < 7) == true, "numeric < fast path");
assert((9 >= 9) == true, "numeric >= fast path");
assert(("x" == "x") == true, "string == fast path");
assert(("x" == "y") == false, "string != distinct");

// --- Structural map equality still works when NO __eq__ is defined ---
assert((map{ a: 1, b: 2 } == map{ a: 1, b: 2 }) == true, "structural map == preserved");
assert((map{ a: 1 } == map{ a: 2 }) == false, "structural map != preserved");

print "comparison_overload_pass";
