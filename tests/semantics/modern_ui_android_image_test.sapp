let Images=import("stdlib:modern_ui_android_image.sapp");
let Pipeline=import("stdlib:image_pipeline.sapp");
let UI=import("stdlib:modern_ui.sapp");
let Android=import("stdlib:modern_ui_android.sapp");
fn contains(bytes,text) {
    let needle=str_to_bytes(text);let i=0;
    while i+len(needle)<=len(bytes) {
        if bytes[i]==needle[0] {
            let same=true;let j=1;
            while j<len(needle) {if bytes[i+j]!=needle[j] {same=false;break;}j=j+1;}
            if same {return true;}
        }
        i=i+1;
    }
    return false;
}
let planar=[[[255,0,0],[0,128,255,127]],[[255,255,255,0],[10,20,30,255]]];
let expected=[[[255,0,0,255],[0,128,255,127]],[[255,255,255,0],[10,20,30,255]]];
let packed=map{format:"pblang.image.rgba8.v1",width:2,height:2,offset:1,stride:9,
    bytes:[99,255,0,0,255,0,128,255,127,88,255,255,255,0,10,20,30,255,88]};
let a=Images.prepare(planar);let b=Images.prepare(packed);
assert(a==b and a.pixels==4,"planar and padded RGBA produce identical embedded image");
let decoded=Pipeline.decode_png(base64_decode_bytes(str_join(a.chunks,"")));
assert(decoded.image==expected,"PNG roundtrip retains every channel including alpha");
let normalized=Images.normalize(planar);normalized.image[0][0][0]=0;
assert(planar[0][0][0]==255,"normalization never mutates caller pixels");
let rgb=map{format:"pblang.image.rgb8.v1",width:1,height:1,offset:0,stride:3,bytes:[10,20,30]};
assert(Images.normalize(rgb).image==[[[10,20,30,255]]],"RGB becomes opaque RGBA");
for invalid in [nil,[],[[]],[[[1,2]]],[[[1,2,256]]],[[[1,2,3.5]]],[[[1,2,"3"]]],
    [[[1,2,3]],[]],map{format:"jpeg"},map{format:"pblang.image.rgb8.v1",width:1025,height:1},
    map{format:"pblang.image.rgb8.v1",width:129,height:128},
    map{format:"pblang.image.rgb8.v1",width:1,height:1,offset:0,stride:2,bytes:[1,2,3]},
    map{format:"pblang.image.rgb8.v1",width:1,height:1,offset:-1,stride:3,bytes:[1,2,3]}] {
    assert((try Images.prepare(invalid) catch nil)==nil,"malformed or oversized frame rejected");
}
assert((try Images.normalize(planar,3) catch nil)==nil,"remaining aggregate budget enforced before encoding");
assert(not Images.enabled(map{}) and Images.enabled(map{android_images:true}),"explicit opt-in");
for invalid in [nil,"true",1,[]] {assert((try Images.enabled(map{android_images:invalid}) catch nil)==nil,"strict switch");}
let original=UI.screen([UI.image(planar,map{name:"photo",fit:"contain",h:120,accessibility_label:"Preview"})]);
let bundle=UI.compile(original,map{target:"android"});
let legacy=Android.activity_class(bundle);
assert(legacy==Android.activity_class(bundle,map{android_images:false}),"false exactly preserves class bytes");
assert(not contains(legacy,"decodeByteArray"),"no opt-in means no decoder constants or calls");
for fit in ["contain","cover","stretch"] {
    original.children[0].fit=fit;
    let enabled=Android.activity_class(bundle,map{android_images:true});
    let scale="FIT_XY";if fit=="contain" {scale="FIT_CENTER";} elif fit=="cover" {scale="CENTER_CROP";}
    assert(contains(enabled,scale) and contains(enabled,"setImageBitmap") and contains(enabled,"decodeByteArray"),"real Android bitmap and fit methods emitted");
    assert(contains(enabled,"Preview"),"accessibility label retained");
}
let before_nil_width=Android.activity_class(bundle,map{android_images:true});
original.children[0].w=nil;
assert(Android.activity_class(bundle,map{android_images:true})==before_nil_width,"nil optional width retains parent width");
original.children[0].image=nil;
assert(Android.activity_class(bundle)==Android.activity_class(bundle,map{android_images:true}),"empty placeholders remain byte-identical");
original.children[0].image="unsupported";
assert((try Android.activity_class(bundle,map{android_images:true}) catch nil)==nil,"mutated source is checked at generation");
print "modern_ui_android_image_pass";
