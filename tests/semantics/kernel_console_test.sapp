// Test: stdlib/kernel/console.sapp — VGA text + serial console, written in pblang
// and transpiled to freestanding C. (Validated by an actual QEMU boot offline:
// a kernel using serial_init + serial_puts prints "PBLANG-KERNEL" on COM1 and
// exits QEMU with code 85.) Here we verify the console code transpiles to the
// expected native C via ctranspile.transpile_kernel.

let ct = import("stdlib/compiler/ctranspile.sapp");
let console = fs_read("stdlib/kernel/console.sapp");

// Transpile the console module + a kmain that uses it.
let kc = ct.transpile_kernel(console + " fn kmain() { serial_init(); serial_puts(0); vga_clear(15); }");

// --- VGA lowering ---
assert(str_contains(kc, "double vga_putc("), "vga_putc transpiled");
assert(str_contains(kc, "poke16"), "VGA writes lower to 16-bit memory stores");
assert(str_contains(kc, "753664"), "VGA base address 0xB8000 present");
assert(str_contains(kc, "double vga_puts("), "vga_puts transpiled");

// --- Serial lowering ---
assert(str_contains(kc, "double serial_init("), "serial_init transpiled");
assert(str_contains(kc, "outb"), "serial uses port output");
assert(str_contains(kc, "double serial_putc("), "serial_putc transpiled");
assert(str_contains(kc, "inb(1021)"), "serial polls the line-status register");
assert(str_contains(kc, "double serial_puts("), "serial_puts transpiled");

// --- It's a complete bootable unit (multiboot + allocator + intrinsics) ---
assert(str_contains(kc, "0x1BADB002"), "console kernel has the multiboot header");
assert(str_contains(kc, "_start"), "console kernel has the _start entry");
assert(not str_contains(kc, "#include"), "console kernel is freestanding (no libc)");

// --- The console uses only the transpilable subset (no unsupported-stmt markers
//     in the transpiled functions) ---
assert(not str_contains(kc, "unsupported stmt"), "console.sapp stays within the freestanding subset");

print "kernel_console_pass";
