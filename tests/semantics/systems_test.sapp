let sys = import("stdlib:systems.sapp");
// byte
assert(sys.byte(256) == 0, "byte(256) should wrap to 0");
assert(sys.byte(255) == 255, "byte(255) should be 255");
assert(sys.byte(-1) == 255, "byte(-1) should be 255");
// pack/unpack u16
let packed = sys.pack_u16_le(258);
assert(packed[0] == 2, "low byte of 258 LE should be 2");
assert(packed[1] == 1, "high byte of 258 LE should be 1");
let unpacked = sys.unpack_u16_le(packed);
assert(unpacked == 258, "unpack should give 258");
// buffer
let buf = sys.buffer_new(4);
assert(len(buf) == 4, "buffer should have 4 bytes");
let str_buf = sys.buffer_from_string("hi");
assert(len(str_buf) == 2, "buffer_from_string should have 2 bytes");
assert(str_buf[0] == 104, "first byte should be 'h'=104");
let back = sys.buffer_to_string(str_buf);
assert(back == "hi", "buffer_to_string should give 'hi'");
// hex
let hex = sys.buffer_to_hex([0, 255, 16]);
assert(hex == "00ff10", "hex should be 00ff10: " + hex);
let from_hex = sys.buffer_from_hex("deadbeef");
assert(len(from_hex) == 4, "from_hex should give 4 bytes");
assert(from_hex[0] == 222, "de = 222");
// system info
let plat = sys.platform();
assert(plat == "linux" or plat == "windows" or plat == "macos" or plat == "unknown", "platform should be valid");
let host = sys.hostname();
assert(type(host) == "string" and len(host) > 0, "hostname should be non-empty");
print "systems_stdlib_pass";
