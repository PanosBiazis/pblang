// Permanent get/get_entry/has/peek and LRU lookup parity. TTL and clock coverage lives in selfhost_cache_ttl_test.
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let source="let C=import(\"stdlib:cache.sapp\"); let c=C.bounded_policy(0,2,0,\"lru\"); C.set(c,\"a\",nil); C.set(c,\"b\",false); print C.has(c,\"a\"); print C.peek(c,\"b\"); let e=C.get_entry(c,\"a\"); print e.found; print e.value; C.set(c,\"c\",0); print C.has(c,\"b\"); print C.get(c,\"missing\"); print C.stats(c).expired; print C.stats(c).misses; print C.stats(c).hits;";
let result=F.frontend_run(source);
if not result.ok or result.output != [true,false,true,nil,false,nil,0,1,1] {throw "FAIL selfhost cache lookup parity";}
print "selfhost_cache_lookup_pass";
