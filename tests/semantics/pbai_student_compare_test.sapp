let AI=import("stdlib/pbai.sapp");let N=import("stdlib:pbai_neural_adapter.sapp");
let specialist=AI.neural_specialist_bind(N);
fn rejects(f){return try {f();false} catch true;}
assert(rejects(fn(){throw "expected";}) and not rejects(fn(){return 1;}),"calibrated rejection");
let teacher=specialist.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);let artifacts=[];
for spec in [map{label:5,epochs:64},map{label:5,epochs:128},map{label:6,epochs:64}] {
 let student=specialist.distill_supervised(teacher.artifact,[map{x:[0],y:spec.label}],[map{x:[7,0],y:spec.label}],
  map{epochs:spec.epochs,lr:0.1,temperature:2,hard_weight:1,max_grad_norm:1});push(artifacts,student.checkpoint());
}
let baseline=artifacts[0];let better=artifacts[1];let worse=artifacts[2];let heldout=[map{x:[6,0],y:5}];
let encoded=N.student_encode(baseline);let candidate_encoded=N.student_encode(better);
let wrong_digest=N.student_decode(candidate_encoded);wrong_digest.digest="invalid";
let bad_matrix=N.student_decode(candidate_encoded);bad_matrix.a[0][0]=0.5;
let extra=N.student_decode(candidate_encoded);extra.extra=true;
let cycle=[];push(cycle,cycle);let called=false;let callback=fn(){called=true;return better;};
let bad_candidates=[nil,true,1,"synthetic-private-candidate",[],cycle,map{},teacher.artifact,wrong_digest,bad_matrix,extra,callback];
let maximum=[];for i in range(0,32) {let a=num_floor(i/8);push(maximum,map{x:[a,i-a*8],y:5});}
let oversized=[];for ex in maximum {push(oversized,ex);}push(oversized,map{x:[4,0],y:5});
let negative_zero=0/(0-1);
let bad_examples=[nil,true,1,"synthetic-private-examples",map{},[],cycle,oversized,[map{}],[map{x:[],y:5}],
 [map{x:[0,1,2,3,4],y:5}],[map{x:[8],y:5}],[map{x:[0.5],y:5}],[map{x:[0],y:8}],
 [map{x:[0],y:1.5}],[map{x:[0],y:5,extra:true}],[map{x:[0],y:5},map{x:[negative_zero],y:5}]];
let cases=0;let evidence=map{};
for load in [N.student_load,AI.neural_specialist_student_load,specialist.student_load] {
 let active=load(baseline);let before=json_stringify(active.predict([6,0]));let alias=active.compare;
 let same=alias(baseline,heldout);assert(same.passed and same.non_vacuous and same.non_regression_passed
  and same.baseline.loss==same.candidate.loss and same.baseline_digest==same.candidate_digest,"identical valid checkpoint comparison");cases=cases+1;
 let improved=alias(better,heldout);let rejected=alias(worse,heldout);
 let oracle=load(better);let evaluated=oracle.evaluate(heldout);assert(oracle.close(),"oracle cleanup");
 assert(improved.passed and improved.candidate.loss<improved.baseline.loss and improved.baseline.correct==1
  and improved.candidate.correct==1 and improved.baseline_correct_regressions==0
  and improved.candidate==evaluated.student and improved.baseline==active.evaluate(heldout).student,"paired metrics agree with independent loaded evaluation");cases=cases+1;
 assert(not rejected.passed and rejected.baseline_correct_regressions==1 and rejected.candidate.correct==0
  and rejected.candidate.loss>rejected.baseline.loss,"well-formed regressing checkpoint is rejected");cases=cases+1;
 let vacuous=alias(baseline,[map{x:[6,0],y:7}]);assert(vacuous.non_regression_passed and not vacuous.non_vacuous and not vacuous.passed,"both-wrong tie cannot pass");cases=cases+1;
 let stronger=load(better);let less_confident=stronger.compare(baseline,heldout);
 assert(not less_confident.passed and less_confident.non_vacuous and less_confident.baseline_correct_regressions==0
  and less_confident.baseline.correct==less_confident.candidate.correct and less_confident.candidate.loss>less_confident.baseline.loss
  and stronger.close(),"worse loss is rejected even when accuracy and correct examples tie");cases=cases+1;
 let report_text=json_stringify(improved);improved.baseline.loss=0;improved.candidate.correct=99;
 assert(json_stringify(alias(better,heldout))==report_text,"detached report and repeatable read-only comparison");
 let full=alias(better,maximum);assert(full.baseline.examples==32 and full.candidate.examples==32,"inclusive comparison capacity");cases=cases+1;
 for bad in bad_candidates {assert(rejects(fn(){alias(bad,heldout);}),"invalid candidate rejected");cases=cases+1;}
 for bad in bad_examples {assert(rejects(fn(){alias(better,bad);}),"invalid or duplicate examples rejected");cases=cases+1;}
 assert(N.student_encode(active.checkpoint())==encoded and json_stringify(active.predict([6,0]))==before
  and N.student_encode(better)==candidate_encoded and not called,"successful and failed comparisons never change baseline/candidate or call supplied functions");
 evidence=alias(better,heldout);
 assert(not evidence.prior_training_overlap_checked and not evidence.independent_test and not evidence.labels_authenticated
  and not evidence.artifact_authenticated and not evidence.repeat_attempts_globally_limited and not evidence.persists_weights
  and not evidence.globally_activated and not evidence.authorizes_activation and not evidence.authorizes_action,"explicit comparison limitations");
 assert(active.close() and not active.close() and rejects(fn(){alias(better,heldout);}),"saved compare alias is terminal after close");cases=cases+1;
}
assert(cases==108,"36 comparison cases per direct, legacy or bound load route");
print json_stringify(map{format:"pbai.student-comparison.test.v1",cases:cases,metrics:evidence});
