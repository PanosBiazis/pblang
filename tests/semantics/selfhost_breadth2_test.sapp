// tests/semantics/selfhost_breadth2_test.sapp
//
// Self-host breadth wave 2: three more constructs the Rust frontend accepts
// but the self-hosted parser rejected (found by clustering `pblang check`
// false errors across stdlib):
//
//   1. `import "path";` statement form — binds the module under its basename
//      (datetime.sapp, http.sapp, ... use it).
//   2. `try { stmts; tail } catch expr` — block-expression try body
//      (path.sapp, parallel.sapp, ... use it), plus bare `{ ... }` blocks in
//      expression position.
//   3. `match` as a plain identifier (fn name / call / export) — regex.sapp
//      defines `fn match(s, pat)`; only `match <expr> {` starts a match-expr.
//
// Each is pinned by running source through the self-hosted frontend and
// checking the values the Rust VM produces for the same code.

let fe = import("stdlib/compiler/selfhost_frontend.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }
fn errs(r) { return try str(r.errors) catch "(no errors key)"; }

// ── 1. import "path"; statement form ─────────────────────────────────────────
let src1 = ""
    + "import \"stdlib/option.sapp\";\n"
    + "let got = option.unwrap_or(option.some(41), 0) + 1;\n";
let r1 = try fe.frontend_run(src1) catch map{ ok: false, errors: ["frontend threw"] };
truthy(r1.ok, "import-string form parses and runs: " + errs(r1));
eq(r1.globals["got"], 42, "import binds the module under its basename");

// ── 2. try { block } catch expr + bare block expressions ────────────────────
let src2 = ""
    + "let a = try { let t = 20; t + 2 } catch 0;\n"        // no throw -> tail
    + "let b = try { throw \"boom\"; 9 } catch 7;\n"        // throw -> handler
    + "let c = { let x = 3; x * 2 };\n"                     // bare block expr
    + "let d = try { probe_missing_fn(); true } catch false;\n";  // the path.sapp shape
let r2 = try fe.frontend_run(src2) catch map{ ok: false, errors: ["frontend threw"] };
truthy(r2.ok, "try-block / block-expr parse and run: " + errs(r2));
eq(r2.globals["a"], try { let t = 20; t + 2 } catch 0, "try-block tail value agrees with Rust VM");
eq(r2.globals["a"], 22, "a = 22");
eq(r2.globals["b"], try { throw "boom"; 9 } catch 7, "try-block throw->handler agrees");
eq(r2.globals["b"], 7, "b = 7");
eq(r2.globals["c"], { let x = 3; x * 2 }, "bare block expr agrees");
eq(r2.globals["c"], 6, "c = 6");
eq(r2.globals["d"], false, "missing fn inside try-block -> catch value");

// ── 3. `match` as an identifier ──────────────────────────────────────────────
let src3 = ""
    + "fn match(a, b) { return a * 10 + b; }\n"             // regex.sapp shape
    + "let m1 = match(4, 2);\n"                             // call
    + "let m2 = match 2 { case 1: 10; case 2: 20; else: 0 };\n"  // real match-expr still works
    + "export match;\n";
let r3 = try fe.frontend_run(src3) catch map{ ok: false, errors: ["frontend threw"] };
truthy(r3.ok, "match-as-identifier parses and runs: " + errs(r3));
eq(r3.globals["m1"], 42, "fn match(...) is callable");
eq(r3.globals["m2"], 20, "real match expressions still parse");

print "selfhost_breadth2_pass";
