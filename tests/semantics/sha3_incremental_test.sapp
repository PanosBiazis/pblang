let SHA3=import("stdlib:sha3.sapp");
fn require(value,message){if not value{throw "sha3_incremental_test: "+message;}}
let input=[];let i=0;while i<4097{array_push(input,(i*37+11)%256);i=i+1;}
let context=SHA3.new();let offset=0;let widths=[1,135,2,136,511,17,1024];let w=0;
while offset<len(input){let finish=num_min(offset+widths[w%len(widths)],len(input));SHA3.update(context,slice(input,offset,finish));offset=finish;w=w+1;}
require(SHA3.final(context)==SHA3.digest_bytes(input),"chunked digest matches one-shot digest");
let branch=SHA3.new();SHA3.update(branch,str_to_bytes("shared-prefix"));let copy=SHA3.clone(branch);SHA3.update(branch,str_to_bytes("-left"));SHA3.update(copy,str_to_bytes("-right"));
require(SHA3.final(branch)==SHA3.digest_bytes("shared-prefix-left"),"left clone branch");require(SHA3.final(copy)==SHA3.digest_bytes("shared-prefix-right"),"right clone branch");
require(branch.length==18 and len(branch.buffer)<136,"bounded context accounting");let invalid=try {SHA3.update(context,[256]);false} catch true;require(invalid,"non-byte rejected");print "sha3_incremental_pass";
