let F = import("stdlib:functional.sapp");
let P = import("stdlib:pipe.sapp");
fn expect(ok, label) { if not ok { throw "FAIL memoize-identity: " + label; } }
for factory in [F.memoize, P.memoize] {
    let calls = [0];
    let typed = factory(fn(x) { calls[0] = calls[0] + 1; return type(x); });
    expect(typed(1) == "number", "numeric input");
    expect(typed("1") == "string", "number/string must not collide");
    expect(typed(true) == "bool" and typed("true") == "string", "boolean/string must not collide");
    expect(typed(nil) == "nil" and typed("nil") == "string", "nil/string must not collide");
    expect(typed(1) == "number" and typed("1") == "string" and calls[0] == 6, "scalar cache hits preserved");

    let scalar_calls = [0];
    let echo = factory(fn(x) { scalar_calls[0] = scalar_calls[0] + 1; return x; });
    for x in ["", "α:β", "number:1", "a\u0000b", false, -7, 1.25, 1.0000000000000002] {
        expect(echo(x) == x and echo(x) == x, "exact scalar result");
    }
    expect(scalar_calls[0] == 8, "scalar repetitions hit cache");

    let nil_calls = [0];
    let nil_result = factory(fn(x) { nil_calls[0] = nil_calls[0] + 1; return nil; });
    expect(nil_result(7) == nil and nil_result(7) == nil and nil_calls[0] == 1, "nil result cached");

    let attempts = [0];
    let retry = factory(fn(x) { attempts[0] = attempts[0] + 1; if attempts[0] == 1 { throw 4; } return x; });
    let rejected = try map{ ok: true, value: retry(7) } catch map{ ok: false };
    expect(not rejected.ok, "callback exception propagates");
    expect(retry(7) == 7 and retry(7) == 7 and attempts[0] == 2, "exception not cached; success cached");

    let composite_calls = [0];
    let inspect = factory(fn(x) { composite_calls[0] = composite_calls[0] + 1; return x[0]; });
    let arr = [1];
    expect(inspect(arr) == 1, "array first read");
    arr[0] = 2;
    expect(inspect(arr) == 2 and inspect([2]) == 2 and composite_calls[0] == 3, "arrays recompute without identity guesses");
    let obj = map{ value: 1 };
    let object_read = factory(fn(x) { return x.value; });
    expect(object_read(obj) == 1, "object first read");
    obj.value = 2;
    expect(object_read(obj) == 2, "mutated object recomputed");
    let invoke = factory(fn(f) { return f(); });
    expect(invoke(fn() { return 1; }) == 1 and invoke(fn() { return 2; }) == 2, "functions do not alias");

    let zero_calls = [0];
    let zero = factory(fn(x) { zero_calls[0] = zero_calls[0] + 1; return 9; });
    expect(zero(0) == 9 and zero(parse_number("-0")) == 9 and zero_calls[0] == 2, "zero sign is not conflated by cache");
    let capacity_calls = [0];
    let bounded = factory(fn(x) { capacity_calls[0] = capacity_calls[0] + 1; return x; });
    for i in 1 to 1025 { expect(bounded(i) == i, "capacity never changes results"); }
    expect(bounded(1025) == 1025 and capacity_calls[0] == 1026, "new keys bypass full cache");
    expect(bounded(1) == 1 and capacity_calls[0] == 1026, "old entries still hit when full");
    let text = "x";
    for i 12 { text = text + text; }
    let text_calls = [0];
    let length = factory(fn(x) { text_calls[0] = text_calls[0] + 1; return len(x); });
    expect(length(text) == 4096 and length(text) == 4096 and text_calls[0] == 1, "text key at boundary caches");
    text = text + "x";
    expect(length(text) == 4097 and length(text) == 4097 and text_calls[0] == 3, "oversized text bypasses cache");
}
print "memoize_identity_pass";
