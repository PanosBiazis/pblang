// tests/semantics/render_soft_test.sapp — a NATIVE software renderer written ENTIRELY in
// pblang that rasterizes across ALL CPU cores (not one). The graphics builtins rasterize on
// a single core; this renders the frame in horizontal bands, one core per band (par_map),
// then stitches them. The parallel result must be pixel-identical to the sequential one.

let RS = import("stdlib/render_soft.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── framebuffer basics (pure pblang, single core) ───────────────────────────────────
let fb = RS.fb_new(8, 4, 0);
eq(len(fb.px), 32, "framebuffer holds w*h pixels");
eq(RS.get(fb, 0, 0), 0, "fresh framebuffer is background");
RS.fill_rect(fb, 2, 1, 3, 2, 255);            // x2..5, y1..3
eq(RS.get(fb, 2, 1), 255, "fill_rect paints inside");
eq(RS.get(fb, 4, 2), 255, "fill_rect paints inside (corner)");
eq(RS.get(fb, 0, 0), 0, "fill_rect leaves outside untouched");
eq(RS.get(fb, 5, 1), 0, "fill_rect respects right edge (exclusive)");

// out-of-bounds rects are clipped, not crashes
RS.fill_rect(fb, 6, 0, 10, 10, 99);
eq(RS.get(fb, 7, 3), 99, "clipped rect still paints the in-bounds part");

// ── the draw list both paths render ─────────────────────────────────────────────────
// each rect = [x, y, w, h, color]; later rects overwrite earlier ones (painter's order).
let W = 64; let H = 48; let BG = 7;
let rects = [
    [0, 0, 64, 48, 100],     // full background fill
    [10, 5, 20, 30, 200],    // a box spanning several bands
    [40, 40, 20, 20, 250],   // a box clipped at the bottom edge
    [0, 0, 5, 48, 175]       // a tall thin bar down the left
];

// ── sequential vs PARALLEL must be identical, pixel for pixel ───────────────────────
let seq = RS.render_seq(W, H, BG, rects);
let par = RS.render_tiles(W, H, BG, rects, 4);    // 4 cores / bands
eq(len(par.px), len(seq.px), "parallel render has the same pixel count");
let i = 0;
let diffs = 0;
while i < len(seq.px) { if seq.px[i] != par.px[i] { diffs = diffs + 1; } i = i + 1; }
eq(diffs, 0, "parallel tiled render is pixel-identical to sequential");

// spot-check known pixels (painter's order: left bar 175 wins over box 200 at x<5)
eq(RS.get(par, 2, 6), 175, "left bar drawn last wins");
eq(RS.get(par, 15, 6), 200, "inner box color");
eq(RS.get(par, 50, 45), 250, "bottom box color");
eq(RS.get(par, 35, 2), 100, "background fill color where nothing else drew");

// banding must cover every row even when H isn't divisible by the core count
let par3 = RS.render_tiles(W, H, BG, rects, 3);
let j = 0; let d3 = 0;
while j < len(seq.px) { if seq.px[j] != par3.px[j] { d3 = d3 + 1; } j = j + 1; }
eq(d3, 0, "3-band render (H not divisible) still covers every row");

// ── PPM export proves it's a real image, not just numbers ───────────────────────────
let ppm = RS.to_ppm(RS.fb_new(2, 1, 0));
if str_index_of(ppm, "P3") != 0 { fail("PPM starts with the P3 magic"); }

print "render_soft_pass";
