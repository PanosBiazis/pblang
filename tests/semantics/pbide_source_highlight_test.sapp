let H=import("editors/ide/pbide_source_highlight.sapp");
let HTML=import("stdlib:html.sapp");
fn exact(source) {
    let result=H.render(source);
    assert(HTML.unescape(HTML.strip_tags(result.html))==source,"preview preserves original source exactly");
    assert(len(str_to_bytes(result.html))<=H.MAX_RENDER_BYTES,"preview byte ceiling");
    return result;
}
for source in ["","\n\n","  let π = 0xff; // Ελληνικά 😀\n", "\"a\\n\\u{1f600}\";\nlet x=1;",
    "/* first\nsecond */\nlet x=\"α\nβ\";", "\"unfinished\nstring", "/* unfinished",
    "\t\"escaped\\\nnewline\";  ", str_repeat("é",2048)] { exact(source); }
let colored=exact("let π = 0x2a; // comment\n\"hello\";");
assert(colored.highlighted and str_contains(colored.html,"syntax-kw")
    and str_contains(colored.html,"syntax-num") and str_contains(colored.html,"syntax-comment")
    and str_contains(colored.html,"syntax-str") and str_contains(colored.html,"0x2a"),"fixed colors preserve literal spelling");
let attack="</code></pre><script>alert('private-canary')</script>&quot;";
let escaped=exact(attack);
assert(not str_contains(escaped.html,"<script>") and not str_contains(escaped.html,attack),"source cannot create HTML nodes");
let tokens=exact(str_repeat(";",512));
assert(not tokens.highlighted,"token overflow falls back without dropping source");
let crowded=exact(str_repeat("\"&&&&&\" ",511));
assert(not crowded.highlighted,"colored output overflow falls back to bounded plain text");
exact(str_repeat("\"",4096));
for invalid in [nil,42,[],map{},str_repeat("x",4097),str_repeat("é",2049),"a\rb",strfromcharcode(0)] {
    let rejected=try { H.render(invalid); false } catch true;
    assert(rejected,"invalid or oversized source is rejected");
}
print "pbide_source_highlight_pass";
