// tests/semantics/channel_close_test.sapp — T4-alpha
let ch = channel();

// Send and receive normally (use sender/receiver endpoints)
send(ch.sender, 42);
let v = recv(ch.receiver);
if v != 42 { print "fail"; }

// Close the channel (pass the sender handle number)
channel_close(ch.sender);
if channel_is_closed(ch.sender) != true { print "fail"; }

// recv on closed+empty channel returns nil
let after_close = recv(ch.receiver);
if after_close != nil { print "fail"; }

print "channel_close_semantics_pass";
