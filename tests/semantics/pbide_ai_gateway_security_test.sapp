// Test: PBIDE AI gateway is an authenticated, bounded loopback capability service.

fn fail(m) { throw "FAIL " + m; }

let src = try fs_read("editors/ide/tools/ai/gateway.sapp") catch "";

if str_contains(src, "\"Access-Control-Allow-Origin\": \"*\"") {
    fail("AI gateway must not use wildcard CORS");
}
if not str_contains(src, "PB_AI_GATEWAY_ALLOWED_ORIGINS") {
    fail("AI gateway exposes explicit allowed-origin override");
}
if not str_contains(src, "fn _origin_allowed(origin)") {
    fail("AI gateway has origin allowlist helper");
}
if not str_contains(src, "origin not allowed") {
    fail("AI gateway rejects disallowed browser origins");
}
if not str_contains(src, "\"Vary\": \"Origin\"") {
    fail("AI gateway marks CORS responses as origin-varying");
}
if str_contains(src, "o == \"null\"") or str_contains(src, "if origin == nil or origin == \"\" { return true; }") {
    fail("AI gateway must reject opaque and missing browser origins");
}
if not str_contains(src, "let BIND = \"127.0.0.1:8080\"") or str_contains(src, "PB_AI_GATEWAY_BIND") {
    fail("AI gateway has a fixed loopback bind");
}
if not str_contains(src, "PB_AI_GATEWAY_TOKEN_FILE") or not str_contains(src, "len(token) < 32 or len(token) > 512") {
    fail("AI gateway requires a bounded operator-provided token");
}
if not str_contains(src, "PB_AI_GATEWAY_MODE") or not str_contains(src, "--io-timeout-ms=1000") {
    fail("AI gateway requires explicit developer mode and a pre-handler socket deadline");
}
let gate_at = str_index_of(src, "_require_developer_mode();");
let import_at = str_index_of(src, "let pbai = import(");
if gate_at < 0 or import_at < 0 or gate_at > import_at {
    fail("AI gateway must fail closed before importing the model or server");
}
if str_contains(src, "--allow-exec") or str_contains(src, "--allow-ffi") or str_contains(src, "--ffi-profile=") {
    fail("AI gateway must not require process execution or raw FFI");
}
if not str_contains(src, "constant_time_eq(auth, \"Bearer \" + GATEWAY_TOKEN)") {
    fail("AI gateway compares bearer credentials in constant time");
}
if not str_contains(src, "let MAX_BODY_CHARS = 1000000")
   or not str_contains(src, "let MAX_PROMPT_CHARS = 65536")
   or not str_contains(src, "let MAX_SOURCE_CHARS = 262144") {
    fail("AI gateway bounds body, prompt and source input");
}
if not str_contains(src, "let ALLOWED_TOOLS = [") or not str_contains(src, "if not _tool_allowed(tool)") {
    fail("AI gateway has a closed tool allowlist");
}
if not str_contains(src, "server.mw_rate_limit(120, 60000)")
   or not str_contains(src, "server.set_max_body(MAX_BODY_CHARS)") {
    fail("AI gateway enables rate and body-size gates");
}
if not str_contains(src, "let BROWSER_NETWORK_EFFECTS_ENABLED = false")
   or str_contains(src, "browser.fetch_page") or str_contains(src, "browser.submit") {
    fail("AI gateway browser effects must fail closed until post-resolution verification exists");
}
if str_contains(src, "--allow-all") {
    fail("AI gateway documentation must not recommend allow-all");
}

print "pbide_ai_gateway_security_pass";
