let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let O=import("stdlib:compiler/optimizer.sapp");
fn check(source, expected) {
    let c=F.frontend_compile(source);assert(c.ok,"data fixture compiles: "+str(c.diagnostics));
    for code in [c.chunk,O.optimize_safe(c.chunk).chunk] {
        assert(V.run(code).output==expected,"unbounded data result");
        assert(V.run_bounded(code).output==expected,"bounded data result");
    }
}
check("print range(4);print range(1,4);print range(3,-1,-1);print range(0,1,0.25);print range(3,1);",[[0,1,2,3],[1,2,3],[3,2,1,0],[0,0.25,0.5,0.75],[]]);
check("let r=range;print r(3);print r(1,3);print r(3,0,-1);",[[0,1,2],[1,2],[3,2,1]]);
check("fn range(a,b){return a+b;}print range(2,3);",[5]);
check("print bytes_to_str([206,187,240,159,152,128]);",["λ😀"]);
check("print json_parse(\"null\");print json_parse(\"{\\\"a\\\":1,\\\"a\\\":2}\").a;",[nil,2]);
check("print json_parse(json_stringify(map{a:[1,true,nil,\"λ😀\\n\"]})).a;",[[1,true,nil,"λ😀\n"]]);
check("let j=json_stringify;print json_parse(j([2,3]));",[[2,3]]);
check("print regex_match(\"abc12\",\"[0-9]+\");print regex_replace_all(\"a12b3\",\"([0-9]+)\",\"<${1}>\");",[true,"a<12>b<3>"]);
check("print regex_replace_all(\"aa\",\"a\",\"$$\");print regex_replace_all(\"a\",\"a\",\"$0$0\");",["$$","aa"]);
check("print regex_replace_all(\"λ😀\",\"\",\"-\");print regex_replace_all(\"xy\",\"(?P<name>.)\",\"${name}${missing}\");",["-λ-😀-","xy"]);
check("print json_parse(json_stringify(map{chunk:7,__fnx:2})).chunk;",[7]);
check("let v=map{__bi:nil};print try {json_stringify(v);false} catch true;map_remove(v,\"__bi\");print json_stringify(v);",[true,"{}"]);
for source in ["range();","range(1,2,3,4);","json_stringify(1,2);"] {
    assert(not F.frontend_compile(source).ok,"static arity rejection");
}
for source in [
    "range(1,2,0);","range(9007199254740992,9007199254740994,0.1);",
    "bytes_to_str([255]);","bytes_to_str([1.5]);","json_parse(\"[\");","json_parse(\"1e999\");",
    "regex_match(\"x\",\"[\");","regex_replace_all(\"x\",\"[\",\"x\");",
    "json_stringify(range);","json_stringify(fn(){return 1;});","json_stringify(map{chunk:map{}});",
    "json_stringify(map{__bi:nil});","json_stringify(map{__fn:7});","json_stringify([map{__bi:1}]);",
    "json_stringify(json_parse(\"{\\\"__fn\\\":1}\"));"
] { check("print try {"+source+"false} catch true;",[true]); }
// Generic call admission and aliases do not index missing arguments.
for name in ["range","json_parse","json_stringify","bytes_to_str","regex_match","regex_replace_all"] {
    let c=F.frontend_compile("let f="+name+";f();");
    assert((try {V.run(c.chunk);false} catch true),"generic arity rejection");
}
check("print json_parse(json_stringify(bigint(42)));print json_parse(json_stringify(rational(1,2)));print json_parse(json_stringify(decimal(2.5)));",["42","1/2","2.5"]);
check("let r=regex_replace_all;print r(\"aa\",\"a\",\"$missing_123456789\");",[""]);
check("let called=0;let value=map{__str__:fn(){called=called+1;return \"private\";}};try json_stringify(value) catch nil;print called;",[0]);
check("let v=rational(1,2);print json_parse(json_stringify([v,[v]]) );",[["1/2",["1/2"]]]);
check("print json_parse(json_stringify(map{chunk:\"ordinary\",__binding:7})).chunk;",["ordinary"]);
for text in ["{\"__bi\":null}","{\"__fn\":7}","{\"chunk\":{}}"] {
    check("print try {json_stringify(json_parse("+json_stringify(text)+"));false}catch true;",[true]);
}
check("let f=fn(){return 1;};print try {json_stringify([f]);false}catch true;",[true]);
print "selfhost_data_builtins_pass";
