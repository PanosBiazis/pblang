let IAM = import("stdlib:iam.sapp");

fn require(condition, message) { if not condition { throw "FAIL iam: " + message; } }
fn rejected(work) { return try { work(); false } catch true; }

fn fixture() {
    let state = IAM.new_state();
    IAM.create_user(state, "alice", "Alice", 10);
    IAM.bootstrap_system_admin(state, "alice");
    IAM.create_user(state, "bob", "Bob", 11);
    IAM.create_organization(state, "alice", "acme", "Acme", 12);
    IAM.set_member(state, "alice", "acme", "bob", "viewer", 13);
    return state;
}

let state = fixture();
let self = IAM.update_user(state, "bob", "bob", "Bob Builder", 14);
require(self.changed and self.user.display_name == "Bob Builder", "self profile update");
require(rejected(fn() { IAM.update_user(state, "bob", "alice", "Forged", 15); }),
    "cross-user profile update denied");
let admin = IAM.update_user(state, "alice", "bob", "Robert", 16);
require(admin.changed and admin.user.display_name == "Robert", "system-admin profile update");
require(rejected(fn() { IAM.update_organization(state, "bob", "acme", "Taken", 17); }),
    "viewer organization update denied");
IAM.set_member(state, "alice", "acme", "bob", "admin", 18);
let organization = IAM.update_organization(state, "bob", "acme", "Acme Engineering", 19);
require(organization.changed and organization.organization.name == "Acme Engineering",
    "admin organization update");
require(IAM.validate(state).ok, "valid updated state");

IAM.create_user(state, "carol", "Carol", 20);
IAM.set_system_admin(state, "alice", "carol", true, 21);
IAM.set_member(state, "alice", "acme", "bob", "owner", 22);
IAM.issue_credential(state, "bob", "acme", "key_0123456789abcdef01234567",
    "Bob key", sha256("secret"), 23);
let execution = IAM.authorize_credential(state, "key_0123456789abcdef01234567",
    "bob", "acme", "tools.execute");
require(execution != nil and execution.principal == "bob" and
        execution.organization_id == "acme" and execution.revision == state.revision,
    "active credential is rebound to its exact principal, organization, and permission");
require(IAM.authorize_credential(state, "key_0123456789abcdef01234567",
        "alice", "acme", "tools.execute") == nil and
        IAM.authorize_credential(state, "key_0123456789abcdef01234567",
        "bob", "other", "tools.execute") == nil,
    "credential principal and organization substitution rejected");
let disabled = IAM.set_user_status(state, "alice", "bob", "disabled", 24);
require(disabled.credentials_revoked == 1 and not IAM.can(state, "bob", "acme", "tools.read") and
        IAM.authenticate_credential(state, "key_0123456789abcdef01234567", sha256("secret")) == nil and
        IAM.authorize_credential(state, "key_0123456789abcdef01234567",
            "bob", "acme", "tools.read") == nil,
    "user disable revokes credentials and authorization");
IAM.set_user_status(state, "alice", "bob", "active", 25);
require(IAM.authenticate_credential(state, "key_0123456789abcdef01234567", sha256("secret")) == nil,
    "user reactivation does not revive credentials");
let organization_disabled = IAM.set_organization_status(state, "alice", "acme", "disabled", 26);
require(organization_disabled.changed and not IAM.can(state, "alice", "acme", "tools.read"),
    "organization disable closes permission checks");
IAM.set_organization_status(state, "alice", "acme", "active", 27);
require(IAM.can(state, "alice", "acme", "tools.read"), "organization may be explicitly reactivated");
require(rejected(fn() { IAM.set_system_admin(state, "carol", "alice", false, 28);
    IAM.set_system_admin(state, "carol", "carol", false, 29); }),
    "last system administrator cannot be removed");
require(IAM.validate(state).ok, "valid lifecycle state");

let malformed = fixture(); malformed.users.bob.updated_ms = 9;
require(not IAM.validate(malformed).ok, "backward user timestamp rejected");
malformed = fixture(); malformed.organizations.acme.name = "";
require(not IAM.validate(malformed).ok, "empty persisted organization name rejected");
malformed = fixture(); malformed.memberships.acme["INVALID"] = "viewer";
require(not IAM.validate(malformed).ok, "non-canonical persisted member id rejected");
malformed = fixture(); malformed.credentials["bad"] = map{};
require(not IAM.validate(malformed).ok, "invalid persisted credential identity rejected");
malformed = fixture(); malformed.users.alice.status = "disabled";
require(not IAM.validate(malformed).ok, "disabled persisted system administrator rejected");
malformed = fixture(); malformed.organizations.acme.status = "disabled";
require(IAM.validate(malformed).ok, "disabled organization remains structurally valid for audit history");

print "iam_pass";
