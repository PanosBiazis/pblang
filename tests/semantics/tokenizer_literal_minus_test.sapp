let T = import("stdlib:compiler/tokenizer.sapp");
let P = import("stdlib:compiler/parser.sapp");
let A = import("stdlib:compiler/source_analysis.sapp");
fn shape(source) {
    let tokens = T.tokenize(source);
    let result = [];
    for token in tokens {
        if token.kind != "comment" { array_push(result, [token.kind, token.text]); }
    }
    return json_stringify(result);
}
for literal in ["nil", "true", "false", "7", "name", "\"x\"", "(7)", "[7][0]"] {
    for suffix in ["1", "0xF", "1e2"] {
        let compact = literal + "-" + suffix;
        assert(shape(compact) == shape(literal + " - " + suffix), "binary minus spacing parity");
        assert(shape(literal + "/* comment */-" + suffix) == shape(compact), "comments preserve binary context");
        let ast = P.parse(T.tokenize("let value=" + compact + ";"));
        assert(len(ast.errors) == 0 and len(ast.stmts) == 1, "subtraction is one initializer");
        assert(ast.stmts[0].value.kind == "binary" and ast.stmts[0].value.op == "-", "subtraction AST");
    }
}
for prefix in ["return ", "throw ", "=", "(", "[", ",", "+", "not ", "and "] {
    let tokens = T.tokenize(prefix + "-12");
    assert(tokens[len(tokens)-2].kind == "number" and tokens[len(tokens)-2].text == "-12", "unary literal preserved");
}
for source in ["let n=nil-1;", "print nil-1;", "let n=nil/*c*/-0x1;", "let n=nil-1e2;"] {
    let result = A.analyze(source);
    assert(not result.ok and result.diagnostics[0].code == "nil-arithmetic", "unannotated nil arithmetic rejected");
}
for keyword in ["let", "nil", "false", "return", "and"] { assert(T.is_keyword(keyword), "keyword lookup"); }
for name in ["value", "λ", "spawn", "", "LET"] { assert(not T.is_keyword(name), "identifier lookup"); }
print "tokenizer_literal_minus_pass";
