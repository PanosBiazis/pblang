let C = import("stdlib:embedded_circuit.sapp");

let circuit = C.new(map{name:"Workshop",mode:"emulator"});
let uno = C.add_device(circuit, "uno-led", "arduino-uno");
let esp = C.add_device(circuit, "esp-led", "esp32-devkitc-v4",
    map{position:map{x:400,y:30}});
assert(uno.ok and esp.ok, "portable board instances");
assert(not C.add_device(circuit, "uno-led", "arduino-uno").ok, "duplicate ids rejected");
assert(not C.add_device(circuit, "bad id", "arduino-uno").ok, "unsafe ids rejected");
assert(not C.add_device(circuit, "bad-pin", "esp32-devkitc-v4",
    map{pin:"GPIO34"}).ok, "input-only LED pin rejected");

let on = C.set_led(circuit, "uno-led", true);
assert(on.ok and on.applied and C.snapshot(circuit).devices[0].observed_on,
       "emulator LED state applies immediately");
assert(C.toggle_led(circuit, "uno-led").ok and not C.snapshot(circuit).devices[0].desired_on,
       "LED toggle");

let blink = C.set_blink(circuit, "uno-led", true, 100, 350);
assert(blink.ok and blink.applied, "bounded blink starts");
C.tick(circuit, 99);
assert(C.snapshot(circuit).devices[0].observed_on, "phase remains on before interval");
C.tick(circuit, 1);
assert(not C.snapshot(circuit).devices[0].observed_on, "phase toggles exactly at interval");
C.tick(circuit, 250);
assert(not C.snapshot(circuit).devices[0].blink.enabled
       and not C.snapshot(circuit).devices[0].observed_on,
       "finite blink stops off at exact duration");
assert(not C.tick(circuit, 60001).ok, "oversized scheduler tick rejected");
assert(not C.set_blink(circuit, "uno-led", true, 9, 10).ok,
       "unsafe high-frequency blink rejected");

let wired = C.new(map{name:"Wired",mode:"wired"});
let physical = C.add_device(wired, "physical-uno", "arduino-uno",
    map{port:"/dev/ttyUSB0"});
assert(physical.ok and not physical.device.state_verified,
       "wired state starts unverified");
let pending = C.set_led(wired, "physical-uno", true);
assert(pending.ok and pending.pending and not pending.applied,
       "wired mutation does not claim unverified actuation");
let ack = C.acknowledge(wired, pending.intent.id, true, true);
assert(ack.ok and ack.state_verified and C.snapshot(wired).devices[0].observed_on,
       "transport acknowledgement verifies observed state");
assert(not C.acknowledge(wired, pending.intent.id, true, true).ok,
       "replayed acknowledgement rejected");
let observed = C.observe(wired, "physical-uno", map{on:false,blinking:true,
    interval_ms:250,remaining_ms:1000});
assert(observed.ok and observed.state_verified
    and C.snapshot(wired).devices[0].blink.enabled,
    "read-only status observation updates verified circuit state");

let discovered = C.new(map{mode:"wired"});
let inventory = map{ok:true,devices:[
    map{port:"/dev/ttyUSB7",candidates:[map{board:"esp32-devkitc-v4",confidence:"board-specific"}]},
    map{port:"/dev/ttyUSB8",candidates:[map{board:"arduino-uno"},map{board:"esp32-devkitc-v4"}]},
    map{port:"/dev/ttyUSB9",candidates:[]}
]};
let auto = C.auto_discover(discovered, map{inventory:inventory});
assert(auto.ok and len(auto.added) == 1 and len(auto.ambiguous) == 1
       and len(auto.skipped) == 1, "auto-discovery is deterministic and ambiguity-safe");
assert(C.snapshot(discovered).devices[0].port == "/dev/ttyUSB7",
       "discovered wired mapping retained without serial identity");

let manual = C.move_device(circuit, "esp-led", map{x:22,y:44});
assert(manual.ok and manual.position.x == 22 and manual.position.y == 44,
       "programmer placement override");
assert(C.remove_device(circuit, "esp-led").ok and C.snapshot(circuit).device_count == 1,
       "device removal");

print "embedded_circuit_pass";
