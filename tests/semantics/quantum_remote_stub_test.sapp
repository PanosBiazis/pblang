// tests/semantics/quantum_remote_stub_test.sapp
// Verifies submit_remote and poll_remote are exported by quantum_protocol.sapp.
// Does NOT make real network calls — just confirms the contract exists.

let qp = import("stdlib:quantum_protocol.sapp");

if type(qp.submit_remote) != "function" {
    print "fail";
}
if type(qp.poll_remote) != "function" {
    print "fail";
}

print "quantum_remote_stub_contract_pass";
