// tests/semantics/matrix_enrich_test.sapp — enrichment for stdlib/matrix.sapp
// Adds hadamard, power, diag/diagonal, is_symmetric, equals_approx, row/col,
// map_elements.

let mat = import("stdlib/matrix.sapp");

fn fail(m) { throw "FAIL " + m; }
fn meq(a, b, m) { if not mat.equals(a, b) { fail(m + " got=" + mat.to_string(a)); } }
fn aeq(a, b, m) {
    if len(a) != len(b) { fail(m + " len"); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " @" + str(i)); } i = i + 1; }
}

// ── base still works ─────────────────────────────────────────────────────────────
meq(mat.mul([[1, 2], [3, 4]], mat.identity(2)), [[1, 2], [3, 4]], "mul identity");

// ── ENRICH: hadamard ─────────────────────────────────────────────────────────────
meq(mat.hadamard([[1, 2], [3, 4]], [[5, 6], [7, 8]]), [[5, 12], [21, 32]], "hadamard");

// ── ENRICH: power ────────────────────────────────────────────────────────────────
meq(mat.power([[2, 0], [0, 2]], 3), [[8, 0], [0, 8]], "power 3");
meq(mat.power([[1, 2], [3, 4]], 0), mat.identity(2), "power 0 = identity");

// ── ENRICH: diag / diagonal ──────────────────────────────────────────────────────
meq(mat.diag([1, 2, 3]), [[1, 0, 0], [0, 2, 0], [0, 0, 3]], "diag builds diagonal matrix");
aeq(mat.diagonal([[1, 9, 9], [9, 2, 9], [9, 9, 3]]), [1, 2, 3], "diagonal extracts");

// ── ENRICH: is_symmetric ─────────────────────────────────────────────────────────
if not mat.is_symmetric([[1, 2], [2, 1]]) { fail("symmetric matrix"); }
if mat.is_symmetric([[1, 2], [3, 4]]) { fail("non-symmetric matrix"); }

// ── ENRICH: equals_approx ────────────────────────────────────────────────────────
if not mat.equals_approx([[1, 2]], [[1.0000001, 2]], 0.001) { fail("equals_approx within eps"); }

// ── ENRICH: row / col ────────────────────────────────────────────────────────────
aeq(mat.row([[1, 2], [3, 4]], 1), [3, 4], "row");
aeq(mat.col([[1, 2], [3, 4]], 0), [1, 3], "col");

// ── ENRICH: map_elements ─────────────────────────────────────────────────────────
meq(mat.map_elements([[1, 2], [3, 4]], fn(x) { return x * 10; }), [[10, 20], [30, 40]], "map_elements");

print "matrix_enrich_pass";
