let T=import("editors/ide/pbide_text.sapp");
fn rejects(f) { let failed=false; try { f(); } catch { failed=true; } return failed; }
let original=T.selection("abcd",1,3);
let changed=T.replace(original,"X");
assert(changed.text=="aXd" and changed.start==2 and changed.end==2,"replace selected range");
assert(original.text=="abcd" and original.start==1,"original state stays detached");
assert(T.tab(original).text=="a    d","legacy Tab replaces selection with four spaces");
for open in ["(","[","{","\"","'"] {
    let wrapped=T.pair(original,open);
    assert(wrapped.start==2 and wrapped.end==4 and str_slice(wrapped.text,2,4)=="bc","pairs retain inner selection");
    let empty=T.pair(T.selection("",0,0),open);
    assert(len(empty.text)==2 and empty.start==1 and empty.end==1,"empty pair places caret inside");
}
let unicode=T.from_browser("a😀β\nx",3,4);
assert(unicode.start==2 and unicode.end==3,"browser UTF-16 maps to scalar positions");
let browser=T.to_browser(T.pair(unicode,"("));
assert(browser.text=="a😀(β)\nx" and browser.start==4 and browser.end==5,"browser range survives emoji prefix");
assert(rejects(fn(){T.from_browser("😀",1,2);}),"split surrogate rejected");
let info=T.status(T.selection("α😀\nx",3,4));
assert(info.line==2 and info.column==1 and info.lines==2 and info.characters==4 and info.selected==1,"scalar status after newline");
assert(T.status(T.selection("",0,0)).lines==1,"empty document has one line");
assert(T.status(T.selection("x\n",2,2)).line==2,"trailing newline retains empty line");
for invalid in [-1,0.5,100,"1",nil] {
    assert(rejects(fn(){T.selection("abc",invalid,0);}),"invalid position rejected");
}
assert(rejects(fn(){T.selection("abc",2,1);}),"reversed range rejected");
assert(rejects(fn(){T.pair(original,"<");}),"unsupported pair rejected");
let full=str_repeat("a",T.MAX_CHARS);
assert(T.status(T.selection(full,len(full),len(full))).column==8193,"maximum buffer status");
assert(rejects(fn(){T.tab(T.selection(full,0,0));}),"overflow rejected");
assert(T.replace(T.selection(full,0,len(full)),"x").text=="x","replacement can shrink a full buffer");
assert(rejects(fn(){T.selection(str_repeat("😀",4097),0,0);}),"byte limit enforced independently");
assert(T.replace(original,"</textarea><script>x</script>").text=="a</textarea><script>x</script>d","core treats markup as inert text");
print "pbide_text_pass";
