// Test: cache.sapp module
import "stdlib:cache.sapp";

// Basic set/get
let c = cache.new(0);
cache.set(c, "key1", "hello");
if cache.get(c, "key1") != "hello" { throw "FAIL basic get"; }
if cache.has(c, "key1") == false { throw "FAIL has existing"; }
if cache.has(c, "nope") != false { throw "FAIL has missing"; }

// delete
cache.delete(c, "key1");
if cache.get(c, "key1") != nil { throw "FAIL after delete"; }

// clear
cache.set(c, "a", 1);
cache.set(c, "b", 2);
cache.clear(c);
if cache.size(c) != 0 { throw "FAIL clear size"; }

// get_or_set
let c2 = cache.new(0);
let computed = false;
let v = cache.get_or_set(c2, "lazy", fn() {
    computed = true;
    return 42;
});
if v != 42 { throw "FAIL get_or_set value"; }
if computed == false { throw "FAIL get_or_set computed"; }

// Second call should hit cache (not recompute)
let computed2 = false;
let v2 = cache.get_or_set(c2, "lazy", fn() {
    computed2 = true;
    return 99;
});
if v2 != 42 { throw "FAIL get_or_set cached value"; }

// size
cache.set(c2, "x", 1);
cache.set(c2, "y", 2);
if cache.size(c2) < 2 { throw "FAIL size"; }

print "cache_stdlib_pass";
