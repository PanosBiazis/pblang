// Test: cache.sapp module
import "stdlib:cache.sapp";

// Basic set/get
let c = cache.new(0);
cache.set(c, "key1", "hello");
if cache.get(c, "key1") != "hello" { throw "FAIL basic get"; }
if cache.has(c, "key1") == false { throw "FAIL has existing"; }
if cache.has(c, "nope") != false { throw "FAIL has missing"; }

// delete
cache.delete(c, "key1");
if cache.get(c, "key1") != nil { throw "FAIL after delete"; }

// clear
cache.set(c, "a", 1);
cache.set(c, "b", 2);
cache.clear(c);
if cache.size(c) != 0 { throw "FAIL clear size"; }

// get_or_set
let c2 = cache.new(0);
let computed = false;
let v = cache.get_or_set(c2, "lazy", fn() {
    computed = true;
    return 42;
});
if v != 42 { throw "FAIL get_or_set value"; }
if computed == false { throw "FAIL get_or_set computed"; }

// Second call should hit cache (not recompute)
let computed2 = false;
let v2 = cache.get_or_set(c2, "lazy", fn() {
    computed2 = true;
    return 99;
});
if v2 != 42 { throw "FAIL get_or_set cached value"; }

// size
cache.set(c2, "x", 1);
cache.set(c2, "y", 2);
if cache.size(c2) < 2 { throw "FAIL size"; }

// A nil value is still a present cache entry and must not be recomputed.
let nil_calls = 0;
cache.set(c2, "nil-value", nil);
let nil_value = cache.get_or_set(c2, "nil-value", fn() { nil_calls = nil_calls + 1; return "wrong"; });
if nil_value != nil or nil_calls != 0 or cache.has(c2, "nil-value") != true { throw "FAIL cached nil"; }
let nil_entry = cache.get_entry(c2, "nil-value");
if nil_entry.found != true or nil_entry.value != nil { throw "FAIL nil entry state"; }

// Replacing a temporary entry with ttl=0 makes it permanent and removes the
// old deadline instead of allowing that deadline to expire the new value.
cache.set_ttl(c2, "ttl-reset", "temporary", 1000);
cache.set_ttl(c2, "ttl-reset", "permanent", 0);
if map_has(c2.__expiry, "ttl-reset") or cache.get(c2, "ttl-reset") != "permanent" { throw "FAIL ttl reset"; }

let ttl_calls = 0;
let ttl_value = cache.get_or_set_ttl(c2, "ttl-lazy", 1000, fn() { ttl_calls = ttl_calls + 1; return 7; });
let ttl_value2 = cache.get_or_set_ttl(c2, "ttl-lazy", 1000, fn() { ttl_calls = ttl_calls + 1; return 8; });
if ttl_value != 7 or ttl_value2 != 7 or ttl_calls != 1 { throw "FAIL get_or_set_ttl"; }
if cache.touch(c2, "ttl-lazy", 0) != true or map_has(c2.__expiry, "ttl-lazy") { throw "FAIL touch permanent"; }
if cache.touch(c2, "missing", 1) != false { throw "FAIL touch missing"; }

print "cache_stdlib_pass";
