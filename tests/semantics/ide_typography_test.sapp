let Strings=import("stdlib:strings.sapp");
let T=import("stdlib:ide_typography.sapp");
let GUI=import("stdlib:gui.sapp");
let GP=import("stdlib:gui_parse.sapp");
let FE=import("stdlib/compiler/selfhost_frontend.sapp");
let UI=import("stdlib:modern_ui.sapp");
let App=import("stdlib:app.sapp");
let w=GUI.label("title",10,20,"Hello α");
assert(not T.cycle(map{kind:"button"},"type"),"Designer ignores non-label selections");
assert(T.cycle(w,"type") and w.font_size==16,"first click applies body preset");
assert(T.cycle(w,"align") and w.text_align=="center","alignment control");
assert(T.cycle(w,"type") and w.font_size==20 and w.text_align=="center","type changes preserve alignment");
assert(w.h>=25 and w.manual_size,"Designer reserves new text geometry");
let original_x=w.x;w.x="0); print 99; (0";
assert((try T.native_source(w) catch nil)==nil,"source generation rejects executable geometry strings");
w.x=original_x;
let expr=T.native_source(w);
let src="let gui=import(\"stdlib/gui.sapp\");fn build(){let form=gui.form(\"Type\",640,480);gui.add(form,"+expr+");return form;}";
assert(FE.frontend_parse_safe(src).ok,"Designer typography source parses");
let parsed=GP.parse_strict(src);
assert(parsed.ok and len(parsed.widgets)==1,"styled label imports into Designer");
let recovered=parsed.widgets[0];
assert(recovered.w==w.w and recovered.h==w.h and recovered.props.font_size==20
    and recovered.props.font_weight=="bold" and recovered.props.text_align=="center"
    and recovered.props.text=="Hello α","text, geometry and typography round-trip");
let bad=Strings.replace_all(src,"font_size: 20","font_size: 900");
assert(not GP.parse_strict(bad).ok,"Designer import rejects oversized typography");
assert(not GP.parse_strict(Strings.replace_all(src,"font_size: 20","font_size: nil")).ok,"Designer cannot silently drop invalid style values");
let opts=T.options(w);opts.name="title";
let tree=UI.screen([UI.heading(w.text,opts)]);
let preview=App.surface("Type",tree,map{mode:"desktop",operation:"preview"});
assert(preview.preview and GUI.get(preview.form,"title").font_size==20,"app.surface desktop facade preserves styles");
let web=App.surface("Type",tree,map{mode:"web",operation:"preview"});
assert(web.preview and str_contains(web.generated.css,"font-size:20px"),"app.surface Web facade preserves styles");
let native=GUI.styled_label("direct",0,0,100,30,"Text",T.options(w));
assert(native.font_size==20 and native.w==100,"direct GUI constructor supports the same style");
assert((try GUI.styled_label("bad",0,0,9000,30,"Bad",map{}) catch nil)==nil,"direct style dimensions bounded");
let observed=map{clears:0,calls:0,size:0};
let canvas=map{clear:fn(color){observed.clears=observed.clears+1;},rect:fn(x,y,w,h,c){},line:fn(a,b,c,d,e){},
    textAA:fn(x,y,text,color,size,advance){observed.calls=observed.calls+1;observed.size=size;return map{ok:true};}};
T.draw_preview(canvas,w,[23,32,51]);
assert(observed.clears==0 and observed.calls==2 and observed.size==20,"Designer uses real typography without clearing its canvas");
print "ide_typography_pass";
