let M=import("stdlib:text_metrics.sapp");let T=import("stdlib:text_document.sapp");
fn reference(text){let words=0;let inside=false;let nonspace=0;for i in range(0,len(text)){let c=str_slice(text,i,i+1);let space=c==" " or c=="\t" or c=="\n" or c=="\r";if not space{nonspace=nonspace+1;if not inside{words=words+1;}}inside=not space;}return map{characters:len(text),nonspace_characters:nonspace,words:words};}
for text in [""," \r\n\t","a b\tc\nd\re","λέξη λέξη","é 👩‍💻","one,two ONE one", "a\u00a0b",str_repeat("α β ",1000)]{assert(M.count(text)==reference(text),"legacy ASCII whitespace metrics");assert(len(M.tokens(text))==M.count(text).words,"same token meaning");}
assert(M.tokens("Α α Α!")==["Α","α","Α!"],"exact forms");assert(M.count(str_repeat("x",65536)).characters==65536,"max bytes");assert((try M.count(str_repeat("x",65537)) catch nil)==nil,"byte bound");assert((try M.count(2) catch nil)==nil,"bad type");
let doc=T.from_text("α β\nabc\tdef","title excluded");let stats=T.statistics(doc);assert(stats.body_words==4 and stats.body_characters==10,"Writer statistics compatibility");print "text_metrics_pass";
