// tests/semantics/bootstrap_selftest_test.sapp
//
// The self-hosted compiler's own self-test harness (stdlib/compiler/bootstrap.sapp)
// was itself UNTESTED, and 6 of its 9 functions THREW (not "failed" — crashed)
// because of latent bugs in typeck.sapp and semantic.sapp that only the harness
// exercised:
//   * typeck infer_expr / semantic walk_expr treated a map-literal entry's KEY
//     (a raw string) as an expression node -> "string index must be number" /
//     "member access only supported on modules/maps".
//   * semantic walk_expr ran a try-expression's body/handler (bare expressions)
//     through walk_block -> "undefined key 'stmts'".
//   * semantic table_symbol_count / table_exported_symbols used RECURSIVE NESTED
//     named fns, unsupported in pblang -> "undefined global 'count_scope'".
//
// This test pins the underlying fixes (fast, direct) and runs the quick bootstrap
// harness functions end-to-end so the harness can't silently rot again.

let tok = import("stdlib/compiler/tokenizer.sapp");
let par = import("stdlib/compiler/parser.sapp");
let tck = import("stdlib/compiler/typeck.sapp");
let sem = import("stdlib/compiler/semantic.sapp");
let boot = import("stdlib/compiler/bootstrap.sapp");

fn fail(m) { throw "FAIL " + m; }
fn ast_of(src) { return par.parse(tok.tokenize(src)); }

// 1. typeck must not crash on a map literal (key is a string, not a node).
let td = try tck.type_check(ast_of("let m = map{ a: 1, b: 2 };").stmts) catch "THREW";
if td == "THREW" { fail("typeck threw on a map literal"); }

// 2. semantic analysis must not crash on a map literal or a try-expression.
if (try sem.analyze(ast_of("let m = map{ a: 1 };")) catch "THREW") == "THREW" { fail("semantic threw on a map literal"); }
if (try sem.analyze(ast_of("let y = try foo() catch 0;")) catch "THREW") == "THREW" { fail("semantic threw on a try-expression"); }
if (try sem.analyze(ast_of("let z = try bar(1) catch baz();")) catch "THREW") == "THREW" { fail("semantic threw on try with call handler"); }

// 3. The recursive table helpers (were broken nested fns) work.
let tbl = sem.analyze(ast_of("fn f() { return 1; } fn g() { return 2; } export f;"));
let n = try sem.table_symbol_count(tbl) catch "THREW";
if n == "THREW" { fail("table_symbol_count threw (nested-fn recursion?)"); }
if n < 2 { fail("table_symbol_count too low: " + str(n)); }
let ex = try sem.table_exported_symbols(tbl) catch "THREW";
if ex == "THREW" { fail("table_exported_symbols threw (nested-fn recursion?)"); }

// 4. The quick bootstrap harness functions run end-to-end with zero failures and
//    without throwing.
fn run_boot(label, f) {
    let r = try f() catch "THREW";
    if r == "THREW" { fail(label + " threw"); }
    if r.failed != 0 { fail(label + " had " + str(r.failed) + " failures"); }
    if r.passed != r.total { fail(label + " passed != total"); }
}
run_boot("bootstrap_test", boot.bootstrap_test);
run_boot("guard_preprocessor_test", boot.guard_preprocessor_test);
run_boot("semantic_analyzer_test", boot.semantic_analyzer_test);
run_boot("compiler_edge_case_tests", boot.compiler_edge_case_tests);

print "bootstrap_selftest_pass";
