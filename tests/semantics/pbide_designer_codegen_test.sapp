// Test: native IDE Designer generated-code contract.
// The IDE itself launches a window at top level, so this locks the generated source
// shape through the self-host parser and gui_parse round-trip instead of importing pbide.

let FE = import("stdlib/compiler/selfhost_frontend.sapp");
let GP = import("stdlib:gui_parse.sapp");

let src = "// generated by pblang native IDE Designer - app target: both
let gui = import(\"stdlib/gui.sapp\");

fn app_target() {
    return \"both\";
}

fn build() {
    let form = gui.form(\"Designed UI\", 800, 600);
    gui.add(form, gui.label(\"lbl1\", 40, 50, \"π label\"));
    gui.add(form, gui.button(\"btn1\", 40, 90, 120, 32, \"Run\", nil));
    gui.add(form, gui.textbox(\"txt1\", 40, 140, 160, 28, \"hello\"));
    gui.add(form, gui.checkbox(\"chk1\", 40, 190, \"Check\", false, nil));
    gui.add(form, gui.radio(\"rad1\", 40, 230, \"Radio\", \"group1\", false, nil));
    gui.add(form, gui.select(\"sel1\", 40, 270, 160, 28, [\"One\", \"Two\"], 0, nil));
    gui.add(form, gui.slider(\"sld1\", 40, 320, 180, 28, 50, 0, 100, nil));
    gui.add(form, gui.cube3d(\"cube1\", 40, 370, 96, 120, \"Cube\"));
    gui.add(form, gui.sphere3d(\"ball1\", 170, 370, 84, 108, \"Ball\"));
    gui.fit_form(form, 800, 600, 80);
    return form;
}

fn preview() {
    print \"Designer app target: \" + app_target();
    print \"Designer preview: \" + str(9) + \" item(s)\";
    print \"widget: label lbl1 @ 40,50 π label\";
    print \"widget: button btn1 @ 40,90 Run\";
    print \"widget: textbox txt1 @ 40,140 hello\";
    print \"widget: checkbox chk1 @ 40,190 Check\";
    print \"widget: radio rad1 @ 40,230 Radio\";
    print \"widget: select sel1 @ 40,270 sel1\";
    print \"widget: slider sld1 @ 40,320 sld1\";
    print \"3d: cube cube1 @ 40,370 Cube\";
    print \"3d: sphere ball1 @ 170,370 Ball\";
    print \"Both target keeps GUI runnable now and carries web metadata for export.\";
    print \"To open the real GUI window, call run_gui() from this file.\";
}

fn run_gui() {
    gui.run(build());
}

fn main() {
    preview();
}
main();
";

let parsed = FE.frontend_parse_safe(src);
assert(parsed.ok, "designer-generated GUI app parses safely");

let design = GP.parse(src);
assert(design.form.title == "Designed UI", "gui_parse recovers generated form");
assert(len(design.widgets) == 9, "gui_parse recovers generated widgets");
assert(design.widgets[0].props.text == "π label", "generated strings preserve symbols");
assert(design.widgets[1].w == 120 and design.widgets[1].h == 32, "button size round-trips");
assert(design.widgets[5].kind == "select", "select widget round-trips");
assert(design.widgets[6].kind == "slider", "slider widget round-trips");
assert(design.widgets[7].kind == "cube3d" and design.widgets[7].props.text == "Cube", "cube preview is generated as runnable 3D widget");
assert(design.widgets[7].w == 96 and design.widgets[7].h == 120, "cube preview size round-trips");
assert(design.widgets[8].kind == "sphere3d" and design.widgets[8].props.text == "Ball", "sphere preview is generated as runnable 3D widget");

let strict_design = GP.parse_strict(src);
assert(strict_design.ok and strict_design.format == "pbide.designer.import.v1"
    and strict_design.widget_count == 9, "strict Designer import accepts the supported generated desktop subset");
assert(json_stringify(strict_design.widgets) == json_stringify(GP.parse_strict(src).widgets),
    "strict Designer import is deterministic");
let binding_source = "let gui = import(\"stdlib/gui.sapp\"); fn build() { let form = gui.form(\"Bound\", 480, 320); gui.add(form, gui.bind(gui.textbox(\"name\", 10, 10, 120, 24, \"\"), \"person_name\")); return form; }";
let binding_design = GP.parse_strict(binding_source);
assert(binding_design.ok and binding_design.widgets[0].bind == "person_name",
    "strict Designer import preserves bounded data bindings");
assert(not GP.parse_strict("fn broken(").ok, "malformed Designer source fails closed");
let unsupported_source = "let gui = import(\"stdlib/gui.sapp\"); fn build() { let form = gui.form(\"Unsupported\", 480, 320); gui.add(form, gui.image(\"img\", 1, 1, 10, 10, nil)); return form; }";
let unsupported = GP.parse_strict(unsupported_source);
assert(not unsupported.ok and unsupported.error == "unsupported-widget"
    and len(unsupported.unsupported) == 1, "unknown GUI constructors fail with structured diagnostics");
let duplicate_source = "let gui = import(\"stdlib/gui.sapp\"); fn build() { let form = gui.form(\"Duplicate\", 480, 320); gui.add(form, gui.label(\"same\", 1, 1, \"a\")); gui.add(form, gui.button(\"same\", 1, 20, 80, 24, \"b\", nil)); return form; }";
assert(not GP.parse_strict(duplicate_source).ok, "duplicate widget names fail closed");
assert(not GP.parse_strict(str_repeat(" ", GP.MAX_SOURCE_CHARS + 1)).ok,
    "oversized Designer source is rejected before parsing");

let gui = import("stdlib:gui.sapp");
let f = gui.form("Fit", 120, 80);
gui.add(f, gui.cube3d("cube", 300, 220, 96, 120, "Cube"));
gui.fit_form(f, 200, 160, 50);
assert(f.w >= 446 and f.h >= 390, "fit_form grows around 3D elements");

let run = FE.frontend_run(src);
assert(run.ok, "designer-generated default preview runs in IDE runner");
let saw_target = false;
let saw_cube = false;
let saw_sphere = false;
for line in run.output {
    if str_contains(str(line), "Designer app target: both") { saw_target = true; }
    if str_contains(str(line), "3d: cube") { saw_cube = true; }
    if str_contains(str(line), "3d: sphere") { saw_sphere = true; }
}
assert(saw_target, "designer preview prints app target mode");
assert(saw_cube and saw_sphere, "designer preview prints 3D items without opening GUI");

let doc_src = "// generated by pblang native IDE Designer - app target: doc
let gui = import(\"stdlib/gui.sapp\");

fn app_target() {
    return \"doc\";
}

fn build() {
    let form = gui.form(\"Designed UI\", 800, 600);
    gui.add(form, gui.panel(\"page1\", 40, 40, 260, 340, \"DOCUMENT PAGE: Document page\"));
    gui.add(form, gui.panel(\"rich1\", 60, 80, 220, 72, \"RICH TEXT: Rich text paragraph\"));
    gui.add(form, gui.panel(\"image1\", 60, 170, 180, 120, \"IMAGE PLACEHOLDER: Image placeholder\"));
    gui.add(form, gui.panel(\"table1\", 60, 310, 220, 120, \"TABLE PLACEHOLDER: Table 3x3\"));
    gui.add(form, gui.panel(\"media1\", 320, 80, 210, 110, \"MEDIA PLACEHOLDER: Audio/video placeholder\"));
    gui.fit_form(form, 800, 600, 80);
    return form;
}

fn preview() {
    print \"Designer app target: \" + app_target();
    print \"Designer preview: \" + str(5) + \" item(s)\";
    print \"doc: docpage page1 @ 40,40 Document page\";
    print \"doc: doctext rich1 @ 60,80 Rich text paragraph\";
    print \"doc: docimage image1 @ 60,170 Image placeholder\";
    print \"doc: doctable table1 @ 60,310 Table 3x3\";
    print \"doc: docmedia media1 @ 320,80 Audio/video placeholder\";
    print \"Designer document plan\";
    print \"exports: txt, doc, docx, odt, rtf, pdf, ppt, pptx, xls, xlsx, csv\";
    print \"Document export engines attach here: txt/doc/docx/odt/rtf/pdf/ppt/pptx/xls/xlsx/csv.\";
}

fn run_gui() {
    gui.run(build());
}

fn main() {
    preview();
}
main();
";

let doc_parsed = FE.frontend_parse_safe(doc_src);
assert(doc_parsed.ok, "designer-generated document app parses safely");
let doc_run = FE.frontend_run(doc_src);
assert(doc_run.ok, "designer-generated document preview runs");
let saw_doc_page = false;
let saw_doc_export = false;
for line in doc_run.output {
    if str_contains(str(line), "doc: docpage") { saw_doc_page = true; }
    if str_contains(str(line), "Document export engines attach here") { saw_doc_export = true; }
}
assert(saw_doc_page and saw_doc_export, "designer document preview prints document items and export boundary");

print "pbide_designer_codegen_pass";
