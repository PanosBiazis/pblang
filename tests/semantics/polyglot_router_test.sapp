let ROUTER = import("stdlib:polyglot_router.sapp");
let REGISTRY = import("stdlib:polyglot_registry.sapp");

fn require(ok, message) { if not ok { throw "FAIL " + message; } }

let direct = ROUTER.resolve("python");
require(direct.ok and direct.language == "python" and direct.source == "language", "canonical language");

let alias = ROUTER.resolve("C++");
require(alias.ok and alias.language == "cpp" and alias.source == "alias", "case-insensitive alias");

let filename = ROUTER.resolve("src/worker.ts");
require(filename.ok and filename.language == "typescript" and filename.source == "extension", "filename extension");

let extension = ROUTER.resolve(".rs");
require(extension.ok and extension.language == "rust", "bare extension");

let fallback = ROUTER.route("unknown.target", "data science statistics");
require(fallback.ok and fallback.language != nil and fallback.source == "task", "task fallback");

let safe = ROUTER.plan("py", "print('ok')", "secure");
require(safe.ok and not safe.allowed and safe.scan.safe and safe.reason == "sandbox_required",
    "secure plan requires an explicit sandbox");
let sandboxed_safe = ROUTER.plan("py", "print('ok')", "secure", nil, true);
require(not sandboxed_safe.allowed and not sandboxed_safe.executable
    and sandboxed_safe.policy_permits and sandboxed_safe.sandbox_declared
    and not sandboxed_safe.sandbox_verified and not sandboxed_safe.sandbox_ready
    and sandboxed_safe.reason == "execution_authority_required",
    "caller sandbox declaration cannot become execution authority");

let blocked = ROUTER.plan("py", "import os\nos.system('rm -rf /')", "secure");
require(blocked.ok and not blocked.allowed and not blocked.scan.safe, "secure unsafe block");

let report = ROUTER.plan("py", "eval(payload)", "report");
require(report.ok and not report.allowed and report.analyzed and not report.executable
    and report.reason == "report_only" and not report.scan.safe,
    "report-only analysis must never be represented as executable authorization");

let sandbox_missing = ROUTER.plan("py", "print(1)", "sandbox");
require(not sandbox_missing.allowed and not sandbox_missing.executable
    and sandbox_missing.reason == "sandbox_required",
    "sandbox plan must fail closed without concrete sandbox readiness");
let unsafe_sandbox_missing = ROUTER.plan("py", "eval(payload)", "sandbox");
require(not unsafe_sandbox_missing.allowed and unsafe_sandbox_missing.reason == "sandbox_required",
    "unsafe sandbox plan without readiness must report the missing sandbox prerequisite");
let sandbox_ready = ROUTER.plan("py", "print(1)", "sandbox", nil, true);
require(not sandbox_ready.allowed and not sandbox_ready.executable
    and sandbox_ready.policy_permits and sandbox_ready.sandbox_declared
    and not sandbox_ready.sandbox_verified
    and sandbox_ready.reason == "execution_authority_required",
    "sandbox declaration remains analysis metadata rather than authorization");
let fake_sandbox = ROUTER.plan("py", "print(1)", "sandbox", nil, "yes");
require(not fake_sandbox.sandbox_declared and not fake_sandbox.policy_permits
    and fake_sandbox.reason == "sandbox_required",
    "non-boolean sandbox declarations fail closed");

require(not ROUTER.plan("py", "print(1)", "invalid-mode").ok, "invalid mode rejected");

let oversized = ROUTER.plan("py", str_repeat("x", 1048577), "secure");
require(oversized.ok and not oversized.allowed and not oversized.scan.safe
    and not oversized.scan.complete and oversized.scan.bounded,
    "oversized source fails closed inside the bounded guard");
let structured_task = ROUTER.route("unknown", map{ task: "web" });
require(not structured_task.ok and structured_task.reason == "invalid_task",
    "structured tasks are rejected before conversion");
let structured_code = ROUTER.plan("python", map{ source: "print(1)" }, "secure", nil, true);
require(not structured_code.ok and not structured_code.allowed
    and structured_code.reason == "invalid_code",
    "structured code is rejected before guard conversion");

let db1 = REGISTRY._lang_db();
let db2 = REGISTRY._lang_db();
require(len(map_keys(db1)) == len(map_keys(db2)), "registry cache stable size");
require(REGISTRY.lang_for_ext("py") == "python", "extension index python");
require(REGISTRY.lang_for_ext("not-real") == nil, "unknown extension");
require(len(REGISTRY.extensions()) > 20, "extension index populated");

print "polyglot_router_pass";
