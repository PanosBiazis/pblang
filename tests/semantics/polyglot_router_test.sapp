let ROUTER = import("stdlib:polyglot_router.sapp");
let REGISTRY = import("stdlib:polyglot_registry.sapp");

fn require(ok, message) { if not ok { throw "FAIL " + message; } }

let direct = ROUTER.resolve("python");
require(direct.ok and direct.language == "python" and direct.source == "language", "canonical language");

let alias = ROUTER.resolve("C++");
require(alias.ok and alias.language == "cpp" and alias.source == "alias", "case-insensitive alias");

let filename = ROUTER.resolve("src/worker.ts");
require(filename.ok and filename.language == "typescript" and filename.source == "extension", "filename extension");

let extension = ROUTER.resolve(".rs");
require(extension.ok and extension.language == "rust", "bare extension");

let fallback = ROUTER.route("unknown.target", "data science statistics");
require(fallback.ok and fallback.language != nil and fallback.source == "task", "task fallback");

let safe = ROUTER.plan("py", "print('ok')", "secure");
require(safe.ok and safe.allowed and safe.scan.safe, "secure safe plan");

let blocked = ROUTER.plan("py", "import os\nos.system('rm -rf /')", "secure");
require(blocked.ok and not blocked.allowed and not blocked.scan.safe, "secure unsafe block");

let report = ROUTER.plan("py", "eval(payload)", "report");
require(report.ok and report.allowed and not report.scan.safe, "report-only unsafe analysis");

let invalid = ROUTER.plan("py", "print(1)", "invalid-mode");
require(not invalid.ok and not invalid.allowed, "invalid mode rejected");

let db1 = REGISTRY._lang_db();
let db2 = REGISTRY._lang_db();
require(len(map_keys(db1)) == len(map_keys(db2)), "registry cache stable size");
require(REGISTRY.lang_for_ext("py") == "python", "extension index python");
require(REGISTRY.lang_for_ext("not-real") == nil, "unknown extension");
require(len(REGISTRY.extensions()) > 20, "extension index populated");

print "polyglot_router_pass";
