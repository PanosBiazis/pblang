let UI=import("stdlib:modern_ui.sapp");let GUI=import("stdlib:gui.sapp");
let Web=import("stdlib:modern_ui_web.sapp");let Android=import("stdlib:modern_ui_android.sapp");
fn tree(shortcut) {
    let action=UI.action_set_text("status","Changed");
    let toggle=UI.toggle("Notify",false,nil,map{name:"notify",action:action});
    if shortcut {toggle=UI.toggle("Notify",false,action,map{name:"notify"});}
    return UI.screen([toggle,UI.toggle("Locked",false,action,map{name:"locked",enabled:false}),UI.text("Ready",map{name:"status"}),UI.button("Reset",UI.action_set_text("status","Ready"),map{name:"reset"})]);
}
fn key(form,k) {GUI.handle_event(form,map{type:"keydown",key:k});GUI.handle_event(form,map{type:"keyup",key:k});}
let source=tree(true);let form=UI.build("Toggle actions",source);
let executions=0;let disabled_executions=0;
let observed_notify=GUI.get(form,"notify");let original=observed_notify.onchange;observed_notify.onchange=fn(f){executions=executions+1;original(f);};
let observed_locked=GUI.get(form,"locked");let blocked=observed_locked.onchange;observed_locked.onchange=fn(f){disabled_executions=disabled_executions+1;blocked(f);};
GUI.focus_next(form);assert(form.focus=="notify","toggle focus");
key(form,"Space");assert(GUI.get(form,"notify").checked and GUI.get(form,"status").text=="Changed","Space changes state and executes portable action");assert(executions==1,"Space executes once");
let status_widget=GUI.get(form,"status");status_widget.text="Ready";key(form,"Enter");
assert(not GUI.get(form,"notify").checked and GUI.get(form,"status").text=="Changed","Enter toggles back with action");assert(executions==2,"Enter adds exactly one execution");
GUI.focus_next(form);assert(form.focus=="reset","disabled checkbox skipped");key(form,"Enter");
assert(GUI.get(form,"status").text=="Ready","button still executes alongside toggles");
form.focus="locked";key(form,"Space");assert(not GUI.get(form,"locked").checked and GUI.get(form,"status").text=="Ready","disabled forced focus cannot execute action");
let locked=GUI.get(form,"locked");GUI.handle_event(form,map{type:"mousedown",x:locked.x+4,y:locked.y+4,button:"Left"});GUI.handle_event(form,map{type:"mouseup",x:locked.x+4,y:locked.y+4,button:"Left"});
assert(not locked.checked and GUI.get(form,"status").text=="Ready","disabled pointer activation ignored");
let notify=GUI.get(form,"notify");GUI.handle_event(form,map{type:"mousedown",x:notify.x+4,y:notify.y+4,button:"Left"});GUI.handle_event(form,map{type:"mouseup",x:notify.x+4,y:notify.y+4,button:"Left"});
assert(notify.checked and GUI.get(form,"status").text=="Changed","native pointer executes portable action");assert(executions==3 and disabled_executions==0,"pointer adds exactly one action; disabled events add zero");
assert(not source.children[0].checked and source.children[2].text=="Ready","caller view unchanged");
let calls=0;let observed=false;
let explicit=UI.build("Callback precedence",UI.screen([UI.toggle("Native",false,fn(f){calls=calls+1;observed=GUI.get(f,"native").checked;},map{name:"native",action:UI.action_message("must not run")})]));
GUI.focus_next(explicit);key(explicit,"Space");assert(calls==1 and observed,"existing callback runs once after state update");
assert((try explicit.last_message catch nil)==nil,"explicit callback wins over options.action on native");
GUI.set_enabled(explicit,"native",false);explicit.focus="native";key(explicit,"Space");
assert(calls==1 and GUI.get(explicit,"native").checked,"disabled Space adds zero callback executions");
let no_action=UI.build("No action",UI.screen([UI.toggle("Plain",false,nil,map{name:"plain"})]));
GUI.focus_next(no_action);key(no_action,"Space");assert(GUI.get(no_action,"plain").checked,"native toggle without action retains behavior");
let old=tree(false);let modern=tree(true);
let wo=Web.generate("Toggles",UI.compile(old,map{target:"web"}));let wn=Web.generate("Toggles",UI.compile(modern,map{target:"web"}));
assert(wo.digest==wn.digest,"shortcut matches established options.action output");
assert(str_contains(wn.runtime_js,"input[type=checkbox]") and str_contains(wn.runtime_js,"t.disabled") and str_contains(wn.runtime_js,"button[data-pb-action]"),"toggle runtime guards disabled inputs and separates button clicks");
let plain=Web.generate("Plain",UI.compile(UI.screen([UI.toggle("No action")]),map{target:"web"}));
assert(not str_contains(plain.runtime_js,"input[type=checkbox]"),"non-action checkbox retains legacy runtime");
assert(Android.activity_class(UI.compile(old,map{target:"android"}))==Android.activity_class(UI.compile(modern,map{target:"android"})),"Android shortcut retains existing class generation");
assert(UI.compile(modern,map{target:"ios"}).view.children[0].action.kind=="set_text","portable contract retains action");
for invalid in [map{},map{format:"pblang.modern-ui.action.v1",kind:"unknown"},42,"callback"] {
    let bad=UI.toggle("Bad",false,invalid);assert(not UI.validate(bad).ok,"malformed action/callback rejected");
    assert((try UI.compile(bad) catch nil)==nil,"invalid shortcut cannot compile");
}
let invalid_target=UI.screen([UI.toggle("Bad",false,UI.action_set_text("missing","Changed"))]);
assert((try Web.generate("Bad",UI.compile(invalid_target,map{target:"web"})) catch nil)==nil,"Web rejects absent action target");
assert((try Android.activity_class(UI.compile(invalid_target,map{target:"android"})) catch nil)==nil,"Android rejects absent action target");
print "ui_toggle_actions_pass";
