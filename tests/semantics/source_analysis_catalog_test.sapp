let A=import("stdlib:source_analysis.sapp");
fn expect(ok,label) {if not ok {throw "FAIL analysis-catalog: "+label;}}
let canonical=["security","quality","performance","completeness","roadmap"];
let source="eval(\"1\");";
let prior=A.analyze("","catalog.sapp",map{analyses:["all"]});
prior.analyses[0]="performance";
let next=A.analyze(source,"catalog.sapp",map{analyses:["all"]});
expect(next.ok and not next.passed and next.security!=nil,"changing prior selected list cannot remove security");
expect(json_stringify(next.analyses)==json_stringify(canonical),"next selection remains canonical");
expect(json_stringify(prior.available)==json_stringify(canonical),"selected and available lists are independent");
prior.available[0]="performance";
let invalid=A.analyze("","catalog.sapp",map{analyses:["unknown"]});
invalid.available[0]="performance";
A.AVAILABLE[0]="performance";
push(A.AVAILABLE,"private-catalog-marker");
for names in [["security"],["all"],[]] {
    let result=A.analyze(source,"catalog.sapp",map{analyses:names});
    expect(result.ok and not result.passed and result.security!=nil,"public catalogs cannot disable security selection");
    expect(json_stringify(result.available)==json_stringify(canonical),"fresh canonical report catalog");
}
expect(json_stringify(next.available)==json_stringify(canonical),"older independent report unchanged");
expect((try A._AVAILABLE catch nil)==nil,"internal catalog not exported");
print "source_analysis_catalog_pass";
