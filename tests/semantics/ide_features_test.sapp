// ── terminal command history helpers ─────────────────────────────────────────
let th = [];
th = ide.terminal_history_push(th, "ls", 3);
th = ide.terminal_history_push(th, "pwd", 3);
th = ide.terminal_history_push(th, "ls", 3);
if len(th) != 2 or th[0] != "ls" or th[1] != "pwd" { fail("terminal_history_push dedupes newest first"); }
th = ide.terminal_history_push(th, "echo hi", 2);
if len(th) != 2 or th[0] != "echo hi" or th[1] != "ls" { fail("terminal_history_push obeys limit"); }
let tm_up = ide.terminal_history_move(th, len(th), "up", "", "draft command");
if tm_up.pos != 0 or tm_up.input != "echo hi" or tm_up.draft != "draft command" or not tm_up.active { fail("terminal_history_move up recalls newest and saves draft"); }
let tm_older = ide.terminal_history_move(th, tm_up.pos, "up", tm_up.draft, tm_up.input);
if tm_older.pos != 1 or tm_older.input != "ls" { fail("terminal_history_move up walks older commands"); }
let tm_newer = ide.terminal_history_move(th, tm_older.pos, "down", tm_older.draft, tm_older.input);
if tm_newer.pos != 0 or tm_newer.input != "echo hi" { fail("terminal_history_move down walks newer commands"); }
let tm_draft = ide.terminal_history_move(th, tm_newer.pos, "down", tm_newer.draft, tm_newer.input);
if tm_draft.pos != len(th) or tm_draft.input != "draft command" or tm_draft.active { fail("terminal_history_move down restores draft"); }
let ths = ide.terminal_history_status(th, 0);
if not str_contains(ths, "2 command") or not str_contains(ths, "sel 1/2") { fail("terminal_history_status shows selection"); }
if not str_contains(ide.terminal_history_status(th, len(th)), "draft") { fail("terminal_history_status shows draft state"); }

// ── AI prompt history helpers ────────────────────────────────────────────────
let ah = [];
ah = ide.ai_prompt_history_push(ah, "explain loops", 3);
ah = ide.ai_prompt_history_push(ah, "find bugs", 3);
ah = ide.ai_prompt_history_push(ah, "explain loops", 3);
if len(ah) != 2 or ah[0] != "explain loops" or ah[1] != "find bugs" { fail("ai_prompt_history_push dedupes newest first"); }
ah = ide.ai_prompt_history_push(ah, "improve this", 2);
if len(ah) != 2 or ah[0] != "improve this" or ah[1] != "explain loops" { fail("ai_prompt_history_push obeys limit"); }
let am_up = ide.ai_prompt_history_move(ah, len(ah), "up", "", "draft prompt");
if am_up.pos != 0 or am_up.input != "improve this" or am_up.draft != "draft prompt" or not am_up.active { fail("ai_prompt_history_move up recalls newest and saves draft"); }
let am_old = ide.ai_prompt_history_move(ah, am_up.pos, "up", am_up.draft, am_up.input);
if am_old.pos != 1 or am_old.input != "explain loops" { fail("ai_prompt_history_move walks older prompts"); }
let am_draft = ide.ai_prompt_history_move(ah, 0, "down", am_up.draft, am_up.input);
if am_draft.pos != len(ah) or am_draft.input != "draft prompt" or am_draft.active { fail("ai_prompt_history_move restores draft"); }
let ahs = ide.ai_prompt_history_status(ah, 0);
if not str_contains(ahs, "2 saved") or not str_contains(ahs, "sel 1/2") { fail("ai_prompt_history_status shows selection"); }
if not str_contains(ide.ai_prompt_history_status(ah, len(ah)), "draft") { fail("ai_prompt_history_status shows draft state"); }

