// tests/semantics/ide_features_test.sapp
// Web-IDE-style editor features (outline, find-all, find&replace, status bar) as pure logic.
let ide = import("stdlib:ide_features.sapp");

fn fail(m) { throw "FAIL " + m; }

let code = "let x = 1;\nfn add(a, b) {\n    return a + b;\n}\nconst PI = 3;\nexport add, x;\n";

// ── outline ──────────────────────────────────────────────────────────────────
let o = ide.outline(code);
if len(o) != 4 { fail("outline should find 4 symbols (got " + str(len(o)) + ")"); }
if o[0].kind != "let" or o[0].name != "x" or o[0].line != 1 { fail("outline let x line 1"); }
if o[1].kind != "fn" or o[1].name != "add" or o[1].line != 2 { fail("outline fn add line 2"); }
if o[2].kind != "const" or o[2].name != "PI" { fail("outline const PI"); }
if o[3].kind != "export" { fail("outline export"); }

// ── find_all ─────────────────────────────────────────────────────────────────
let hits = ide.find_all(code, "a");
if len(hits) < 3 { fail("find_all should find multiple 'a' (got " + str(len(hits)) + ")"); }
if hits[0].line != 2 { fail("first 'a' is on line 2 (fn add)"); }
if len(ide.find_all(code, "zzz")) != 0 { fail("find_all of missing -> empty"); }
if len(ide.find_all(code, "")) != 0 { fail("find_all of empty query -> empty"); }
// two matches on one line
let two = ide.find_all("aa bb aa", "aa");
if len(two) != 2 or two[0].col != 1 or two[1].col != 7 { fail("find_all two-per-line cols"); }

// ── replace_all ──────────────────────────────────────────────────────────────
let r = ide.replace_all(code, "add", "sum");
if r.count != 2 { fail("replace_all count (got " + str(r.count) + ")"); }
if str_contains(r.code, "fn add") { fail("replace_all should have replaced 'add'"); }
if not str_contains(r.code, "fn sum") { fail("replace_all should produce 'fn sum'"); }
if ide.replace_all(code, "", "x").count != 0 { fail("replace empty find -> no-op"); }

// ── status_text ──────────────────────────────────────────────────────────────
let st = ide.status_text(map{ path: "demo.sapp", modified: true, line: 12, col: 5, lines: 40 });
if not str_contains(st, "demo.sapp *") { fail("status shows modified marker"); }
if not str_contains(st, "Ln 12, Col 5") { fail("status shows line/col"); }
if not str_contains(st, "40 lines") { fail("status shows line count"); }

print "ide_features_pass";
