let delete_plan = ide.file_explorer_operation_plan("delete", "/repo/manual.pdf", "");
if delete_plan.destructive != true or not str_contains(str_join(delete_plan.requires, ","), "destructive confirmation") { fail("file_explorer_operation_plan marks delete destructive"); }
if not str_contains(ide.file_explorer_operation_summary(upload_plan), "upload") or not str_contains(ide.file_explorer_operation_summary(upload_plan), "manual.pdf") { fail("file_explorer_operation_summary formats transfer plan"); }
let crumbs = ide.file_explorer_breadcrumbs("/repo/src/main.sapp");
if len(crumbs) != 4 or crumbs[0].label != "/" or crumbs[1].path != "/repo" or crumbs[3].label != "main.sapp" { fail("file_explorer_breadcrumbs returns clickable path segments"); }
