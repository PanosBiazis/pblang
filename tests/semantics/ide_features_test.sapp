let cli_profile = ide.app_run_profile("print 1 + 1;", "demo.sapp");
if cli_profile.kind != "cli" or cli_profile.can_native_run != false or not str_contains(ide.app_run_profile_summary(cli_profile), "selfhost-headless") { fail("app_run_profile keeps plain scripts headless"); }
if cli_profile.safety.launch_mode != "headless" or cli_profile.safety.watchdog != false { fail("app_run_profile attaches headless safety profile"); }
if cli_profile.capabilities.grants_all != false or cli_profile.capabilities.grants_exec != false or cli_profile.capabilities.grants_ffi != false { fail("cli app_run_profile does not grant all/exec/ffi"); }
let gui_profile = ide.app_run_profile("let gui = import(\"stdlib/gui.sapp\"); fn run_gui() { gui.run(build()); }", "designer.sapp");
if gui_profile.kind != "gui" or gui_profile.can_native_run != true or gui_profile.run_method != "pblang-native-gui" { fail("app_run_profile detects native GUI apps"); }
if gui_profile.safety.launch_mode != "detached-guarded" or gui_profile.safety.watchdog != true or gui_profile.safety.target_fps != 30 or gui_profile.safety.max_frames < 60 { fail("gui app_run_profile attaches guarded child safety limits"); }
if gui_profile.capabilities.grants_all != false or len(gui_profile.capabilities.cli_args) != 0 or not str_contains(gui_profile.capabilities.summary, "exec=false") { fail("gui app_run_profile uses least-privilege child capabilities"); }
if gui_profile.capabilities.env_overrides["PBLANG_ALLOW_ALL"] != "0" or gui_profile.capabilities.env_overrides["PBLANG_ALLOW_EXEC"] != "0" or gui_profile.capabilities.env_overrides["PBLANG_ALLOW_FFI"] != "0" { fail("gui app_run_profile clears inherited unsafe child capability env vars"); }
if gui_profile.capabilities.env_overrides["PBIDE_CHILD_CAPS"] != "least-privilege" or not str_contains(gui_profile.capabilities.summary, "env-guard=true") { fail("gui app_run_profile exposes child env guard status"); }
let gfx_profile = ide.app_run_profile("let gfx = import(\"stdlib/graphics.sapp\"); let w = gfx.Window(320, 240, \"x\");", "graphics.sapp");
if gfx_profile.kind != "gui" or gfx_profile.has_gui != true { fail("app_run_profile detects graphics Window apps"); }
let web_profile = ide.app_run_profile("let http = import(\"stdlib/http_server.sapp\"); http.serve_forever(\"127.0.0.1:8080\", fn(req){ return http.res_html(\"ok\"); });", "web.sapp");
if web_profile.kind != "web" or web_profile.has_web_runtime != true or web_profile.run_method != "pblang-native-web-server" { fail("app_run_profile detects runnable web apps"); }
if web_profile.safety.timeout_ms < 300000 or web_profile.safety.target_fps != 10 or not str_contains(str_join(web_profile.safety.gates, "\n"), "local web server") { fail("web app_run_profile attaches web watchdog limits"); }
if not str_contains(str_join(web_profile.capabilities.needed, ","), "http") or web_profile.capabilities.grants_all != false { fail("web app_run_profile records needed web caps without granting all"); }
let custom_safety = ide.app_run_safety_profile(gui_profile, map{ timeout_ms: 7000 });
if custom_safety.timeout_ms != 7000 or custom_safety.max_frames != 210 or not str_contains(ide.app_run_safety_summary(custom_safety), "detached-guarded") { fail("app_run_safety_profile honors bounded custom timeout"); }
if custom_safety.resource_budget.limits.elapsed_ms != 7000 or custom_safety.resource_budget.limits.frames != 210 { fail("app_run_safety_profile publishes child resource limits"); }
if not custom_safety.resource_runtime.ready or custom_safety.resource_runtime.product != "pbide" { fail("app_run_safety_profile uses the shared product runtime guard"); }
if custom_safety.resilience_policy.timeout_ms != 7000 or custom_safety.resilience_policy.max_attempts != 2 or custom_safety.resilience_state.status != "closed" { fail("app_run_safety_profile publishes bounded child resilience lifecycle"); }
let app_resource_ok = ide.app_run_resource_report(custom_safety, map{ elapsed_ms: 1000, frames: 20, frame_ms: 10, workers: 1 });
if not app_resource_ok.allowed or app_resource_ok.evaluation.pressure != "nominal" { fail("app_run_resource_report admits bounded GUI preview"); }
let app_resource_blocked = ide.app_run_resource_report(custom_safety, map{ elapsed_ms: 8000, frames: 300, frame_ms: 80, workers: 4 });
if app_resource_blocked.allowed or app_resource_blocked.evaluation.pressure != "blocked" or len(app_resource_blocked.adaptive.actions) < 2 { fail("app_run_resource_report blocks runaway GUI preview"); }
let cap_plan = ide.app_run_capability_plan(web_profile);
if cap_plan.grants_all != false or cap_plan.grants_exec != false or not str_contains(cap_plan.policy, "least privilege") { fail("app_run_capability_plan blocks all/exec grants"); }
if cap_plan.env_overrides["PBLANG_ALLOW_ALL"] != "0" or not str_contains(cap_plan.policy, "clear inherited PBLANG_ALLOW_*") { fail("app_run_capability_plan clears inherited allow env grants"); }
if not str_contains(ide.app_run_profile_summary(gui_profile), "safety=detached-guarded") or not str_contains(ide.app_run_profile_summary(gui_profile), "caps=") { fail("app_run_profile_summary includes safety and capability contracts"); }
let web_meta = ide.app_run_profile("// generated by pblang native IDE Designer - app target: web\nfn app_target(){ return \"web\"; }\nfn preview(){ print \"web\"; }", "web_meta.sapp");
if web_meta.kind != "web-metadata" or web_meta.can_native_run != false or web_meta.preview_method != "headless preview()" { fail("app_run_profile keeps metadata-only web target as preview-only"); }

// ── Designer status helpers ─────────────────────────────────────────────────
let dstatus_empty = ide.designer_status(map{ target: "gui", layout: "free", tool: "button", widgets: [], sel: 0 - 1 });
if not str_contains(dstatus_empty, "app gui") or not str_contains(dstatus_empty, "tool button") or not str_contains(dstatus_empty, "no selection") { fail("designer_status handles empty canvas"); }
let dstatus_sel = ide.designer_status(map{
    target: "both",
    layout: "grid",
    tool: "cube3d",
    sel: 0,
    widgets: [map{ kind: "cube", name: "cube1", x: 10, y: 20, w: 72, h: 72 }]
});
if not str_contains(dstatus_sel, "app both") or not str_contains(dstatus_sel, "layout grid") or not str_contains(dstatus_sel, "sel 1/1 cube cube1 @ 10,20 72x72") { fail("designer_status summarizes selected widget"); }
let prop_fields = ide.designer_property_fields(map{ kind: "button", name: "btn1", x: 10, y: 20, w: 120, h: 32, text: "Run" });
if len(prop_fields) < 7 or prop_fields[0].name != "kind" or prop_fields[6].name != "text" or not str_contains(ide.designer_property_summary(map{ kind: "button", name: "btn1", x: 10, y: 20, w: 120, h: 32, text: "Run" }), "text=Run") { fail("designer_property_fields summarizes selected widget fields"); }
let slider_fields = ide.designer_property_fields(map{ kind: "slider", name: "sld1", x: 1, y: 2, w: 180, h: 28, value: 50, min: 0, max: 100 });
if len(slider_fields) < 9 or slider_fields[6].name != "value" or slider_fields[8].name != "max" { fail("designer_property_fields exposes slider numeric fields"); }
let comps = ide.filter_designer_components("camera", 10);
if len(comps) < 1 or comps[0].kind != "camera" { fail("filter_designer_components finds camera component"); }
let comp_lines = ide.designer_component_lines(comps, 2);
if len(comp_lines) < 1 or not str_contains(comp_lines[0], "3D camera") { fail("designer_component_lines renders component records"); }
if len(ide.designer_component_library()) < 9 { fail("designer_component_library exposes reusable templates"); }
if ide.designer_component_default_id("camera") != "scene_camera" { fail("designer_component_default_id chooses matching preset"); }
if ide.designer_component_default_id("calculator") != "safe_calculator" { fail("designer_component_default_id finds safe calculator preset"); }
let form_preset = ide.designer_component_preset("form_stack", 10, 20);
if form_preset.ok != true or form_preset.item_count < 3 or form_preset.items[0].kind != "label" or form_preset.items[1].kind != "textbox" or form_preset.items[2].kind != "button" { fail("designer_component_preset builds form stack items"); }
if form_preset.items[0].x != 10 or form_preset.items[0].y != 20 { fail("designer_component_preset keeps requested origin"); }
let calc_preset = ide.designer_component_preset("safe_calculator", 12, 24);
if calc_preset.ok != true or calc_preset.item_count < 56 or calc_preset.items[0].name != "calc_shell" { fail("designer_component_preset builds full safe calculator items"); }
if calc_preset.items[0].w != 860 or calc_preset.items[0].h != 820 { fail("safe calculator preset mirrors native calculator window size"); }
if not preset_has_item(calc_preset, "calc_history_panel", "History") or not preset_has_item(calc_preset, "calc_memory", "M=0") { fail("safe calculator preset includes history and memory surfaces"); }
if not preset_has_item(calc_preset, "calc_mc", "MC") or not preset_has_item(calc_preset, "calc_sqrt", "sqrt") or not preset_has_item(calc_preset, "calc_log10", "log10") or not preset_has_item(calc_preset, "calc_fact", "fact") { fail("safe calculator preset includes memory and scientific button rows"); }
if not preset_has_item(calc_preset, "calc_clear_history", "Clear History") or not preset_has_item(calc_preset, "calc_close", "Close") { fail("safe calculator preset includes bottom action row"); }
let calc_summary = str_join(ide.designer_component_preset_summary(calc_preset), "\n");
if not str_contains(calc_summary, "Safe calculator") or not str_contains(calc_summary, "panel calc_shell") { fail("safe calculator preset summary renders"); }
let scene_preset = ide.designer_component_preset("scene_camera", 4, 8);
let scene_kinds = str_join([scene_preset.items[0].kind, scene_preset.items[1].kind, scene_preset.items[2].kind], ",");
if not str_contains(scene_kinds, "camera") or not str_contains(scene_kinds, "light") or not str_contains(scene_kinds, "material") { fail("designer_component_preset builds 3d rig"); }
let missing_preset = ide.designer_component_preset("missing_component", 0, 0);
if missing_preset.ok != false or len(missing_preset.items) != 0 or not str_contains(missing_preset.summary, "not found") { fail("designer_component_preset rejects unknown presets"); }
let preset_summary = str_join(ide.designer_component_preset_summary(form_preset), "\n");
if not str_contains(preset_summary, "Form stack") or not str_contains(preset_summary, "textbox form_input") { fail("designer_component_preset_summary renders preset lines"); }
let doc_plan = ide.designer_document_plan(map{ target: "doc", widgets: [map{ kind: "label", name: "title", x: 10, y: 20, w: 120, h: 24 }, map{ kind: "docimage", name: "hero", x: 20, y: 80, w: 220, h: 120 }] });
let doc_plan_text = str_join(doc_plan, "\n");
if not str_contains(doc_plan_text, "exports: txt, docx, doc, odt, rtf, pdf, ppt, pptx, xls, xlsx, csv") or not str_contains(doc_plan_text, "label title") or not str_contains(doc_plan_text, "docimage hero") { fail("designer_document_plan summarizes document exports and items"); }
let doc_export = str_join(ide.designer_document_export_plan(map{ target: "doc", widgets: [map{ kind: "doctable", name: "table1", x: 0, y: 0, w: 100, h: 60 }] }, "xlsx"), "\n");
if not str_contains(doc_export, "Designer export plan: xlsx") or not str_contains(doc_export, "supported: true") or not str_contains(doc_export, "doctable table1") { fail("designer_document_export_plan describes export target and items"); }
let bad_export = str_join(ide.designer_document_export_plan(map{ target: "doc", widgets: [] }, "exe"), "\n");
if not str_contains(bad_export, "supported: false") { fail("designer_document_export_plan rejects unsupported formats"); }

// ── shared bounded execution pipeline ────────────────────────────────────────
let execution_safety = ide.ide_execution_safety();
if execution_safety.native_execution != "disabled-by-default" or execution_safety.syscalls != "deny-by-default" {
    fail("IDE execution is fail-closed by default");
}
let execution_plan = ide.ide_execution_plan("windows", "11", "x86_64");
if execution_plan.target != "c99" or execution_plan.direct_native != false {
    fail("IDE must not present ELF as native Windows output");
}
let execution_preview = ide.ide_execution_preview([
    ["seti", 0, 4], ["seti", 1, 2], ["mul", 0, 1]
]);
if execution_preview.evaluation.value != 8 or execution_preview.executed != true {
    fail("IDE bounded register-IR preview");
}

// ── build profiles + IDE watcher state ───────────────────────────────────────
let dbg = ide.build_profile("debug");
if dbg.mode != "debug" or dbg.lint_before_run != true { fail("debug profile checks before run"); }
let rel = ide.build_profile("release");
if rel.mode != "release" or rel.lint_before_run != false or rel.optimize != "speed" { fail("release profile is fast run mode"); }
if ide.next_build_mode("debug") != "release" or ide.next_build_mode("release") != "debug" { fail("build mode toggles"); }
if not str_contains(ide.build_mode_summary("debug"), "Debug") { fail("build mode summary names mode"); }

let w = ide.watcher_new("demo.sapp", code);
if w.revision != 0 or w.dirty != false or w.symbols != 4 { fail("watcher_new captures clean code state"); }
if len(w.events) != 1 or not str_contains(w.events[0], "watcher initialized") { fail("watcher_new starts event log"); }
if w.diagnostics_state != "unchecked" or w.diagnostics_stale != false { fail("watcher_new starts with unchecked diagnostics"); }
let woff = ide.watcher_action(nil);
if woff.severity != "off" or woff.command != "watch" { fail("watcher_action handles disabled watcher"); }
if ide.watcher_badge(nil) != "watch off" { fail("watcher_badge handles disabled watcher"); }
if ide.watcher_toolbar_label(nil, false) != "NoWatch" { fail("watcher_toolbar_label handles disabled watcher"); }
let wunchecked = ide.watcher_action(w);
if wunchecked.severity != "info" or wunchecked.command != "check" { fail("watcher_action recommends check before diagnostics exist"); }
if ide.watcher_badge(w) != "watch unchecked" { fail("watcher_badge marks unchecked diagnostics"); }
if ide.watcher_toolbar_label(w, true) != "Unchk" { fail("watcher_toolbar_label marks unchecked diagnostics"); }
let wc = ide.watcher_update(w, "demo.sapp", code, false, [], "check");
if wc.diagnostics_state != "fresh" or wc.diagnostics_stale != false { fail("watcher_check marks diagnostics fresh"); }
let wc_action = ide.watcher_action(wc);
if wc_action.severity != "ok" or wc_action.command != "none" { fail("watcher_action reports clean fresh buffer ok"); }
if ide.watcher_badge(wc) != "watch ok" { fail("watcher_badge marks clean fresh state"); }
if ide.watcher_toolbar_label(wc, true) != "Watch" { fail("watcher_toolbar_label marks clean fresh state"); }
let w2 = ide.watcher_update(wc, "demo.sapp", code + "\nprint x;\n", true, [nd], "type");
if w2.revision != 1 or w2.dirty != true or w2.diagnostics != 1 { fail("watcher_update tracks changed dirty diagnostics"); }
if w2.line_delta <= 0 or w2.diagnostic_delta != 1 { fail("watcher_update records deltas"); }
if w2.diagnostics_state != "stale" or w2.diagnostics_stale != true { fail("watcher marks diagnostics stale after edit"); }
if len(w2.events) < 2 or not str_contains(w2.events[0], "type changed") { fail("watcher_update records newest event"); }
let ws = ide.watcher_summary(w2);
if not str_contains(ws, "watch: on") or not str_contains(ws, "diagnostics 1 stale") or not str_contains(ws, "last type") { fail("watcher_summary is readable"); }
let wa = ide.watcher_action(w2);
if wa.severity != "warn" or wa.command != "check" or not str_contains(wa.message, "F6 Check") { fail("watcher_action recommends check for stale diagnostics"); }
if ide.watcher_badge(w2) != "watch stale" { fail("watcher_badge marks stale diagnostics"); }
if ide.watcher_toolbar_label(w2, true) != "Stale" { fail("watcher_toolbar_label marks stale diagnostics"); }
let health_stale = ide.ide_health_line(w2, "debug", ui_snap);
if not str_contains(health_stale, "health WARN") or not str_contains(health_stale, "Debug") or not str_contains(health_stale, "watch stale") or not str_contains(health_stale, "ui 100/100") { fail("ide_health_line summarizes stale watcher and ui quality"); }
let health_off = ide.ide_health_line(nil, "release", nil);
if not str_contains(health_off, "health OFF") or not str_contains(health_off, "Release") or not str_contains(health_off, "watch off") or not str_contains(health_off, "ui ?") { fail("ide_health_line handles disabled watcher"); }
let health_ui_warn = ide.ide_health_line(wc, "debug", bad_ui);
if not str_contains(health_ui_warn, "health WARN") or not str_contains(health_ui_warn, "issue(s)") { fail("ide_health_line promotes ui observer issues"); }
let wui = ide.watcher_update(ide.watcher_new("demo.sapp", code), "demo.sapp", code, false, [], "check");
wui.ui_snapshot = bad_ui;
let ui_action = ide.watcher_action(wui);
if ui_action.severity != "warn" or ui_action.command != "ui_snapshot" or not str_contains(ui_action.message, "ui observer") { fail("watcher_action opens UI snapshot when UI observer has issues"); }
if ide.watcher_badge(wui) != "watch ui " + str(bad_ui.issue_count) { fail("watcher_badge marks UI observer issues"); }
if ide.watcher_toolbar_label(wui, true) != "Ui" + str(bad_ui.issue_count) { fail("watcher_toolbar_label marks UI observer issues"); }
let ui_watch_lines = ide.watcher_lines(wui, 4);
if len(ui_watch_lines) != 4 or not str_contains(ui_watch_lines[1], "ui observer") { fail("watcher_lines exposes UI observer suggested action"); }
if not str_contains(ui_watch_lines[2], "ui issue:") or not str_contains(ui_watch_lines[2], "bad-size") { fail("watcher_lines previews first UI observer issue"); }
let wl = ide.watcher_lines(w2, 4);
if len(wl) != 4 or not str_contains(wl[1], "action: diagnostics stale") { fail("watcher_lines exposes action row"); }
if not str_contains(wl[2], "type changed") or not str_contains(wl[2], "diagnostics stale") { fail("watcher_lines exposes event log"); }
let before_events = len(w2.events);
let before_last = w2.last_event;
let w3 = ide.watcher_update(w2, "demo.sapp", code + "\nprint x;\n", true, [nd], "draw");
if len(w3.events) != before_events or w3.last_event != before_last { fail("watcher draw refresh does not spam unchanged events"); }
let w4 = ide.watcher_update(w3, "demo.sapp", code + "\nprint x;\n", true, [nd], "check");
if w4.diagnostics_state != "fresh" or w4.diagnostics_stale != false { fail("watcher check refresh clears stale diagnostics"); }
let wa4 = ide.watcher_action(w4);
if wa4.severity != "error" or wa4.command != "diagnostic_next" { fail("watcher_action points to diagnostics when fresh issues remain"); }
if ide.watcher_badge(w4) != "watch err 1" { fail("watcher_badge marks fresh diagnostics count"); }
if ide.watcher_toolbar_label(w4, true) != "Err1" { fail("watcher_toolbar_label marks fresh diagnostics count"); }
w4.ui_snapshot = bad_ui;
let wa4_ui_priority = ide.watcher_action(w4);
if wa4_ui_priority.command != "diagnostic_next" { fail("watcher_action keeps diagnostics ahead of UI observer issues"); }
if ide.watcher_badge(w4) != "watch err 1" { fail("watcher_badge keeps diagnostics ahead of UI observer issues"); }
if ide.watcher_toolbar_label(w4, true) != "Err1" { fail("watcher_toolbar_label keeps diagnostics ahead of UI observer issues"); }

print "ide_features_pass";
