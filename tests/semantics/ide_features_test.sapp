// tests/semantics/ide_features_test.sapp
// Web-IDE-style editor features (outline, find-all, find&replace, status bar) as pure logic.
let ide = import("stdlib:ide_features.sapp");

fn fail(m) { throw "FAIL " + m; }

let code = "let x = 1;\nfn add(a, b) {\n    return a + b;\n}\nconst PI = 3;\nexport add, x;\n";

// ── outline ──────────────────────────────────────────────────────────────────
let o = ide.outline(code);
if len(o) != 4 { fail("outline should find 4 symbols (got " + str(len(o)) + ")"); }
if o[0].kind != "let" or o[0].name != "x" or o[0].line != 1 { fail("outline let x line 1"); }
if o[1].kind != "fn" or o[1].name != "add" or o[1].line != 2 { fail("outline fn add line 2"); }
if o[2].kind != "const" or o[2].name != "PI" { fail("outline const PI"); }
if o[3].kind != "export" { fail("outline export"); }

// ── find_all ─────────────────────────────────────────────────────────────────
let hits = ide.find_all(code, "a");
if len(hits) < 3 { fail("find_all should find multiple 'a' (got " + str(len(hits)) + ")"); }
if hits[0].line != 2 { fail("first 'a' is on line 2 (fn add)"); }
if len(ide.find_all(code, "zzz")) != 0 { fail("find_all of missing -> empty"); }
if len(ide.find_all(code, "")) != 0 { fail("find_all of empty query -> empty"); }
// two matches on one line
let two = ide.find_all("aa bb aa", "aa");
if len(two) != 2 or two[0].col != 1 or two[1].col != 7 { fail("find_all two-per-line cols"); }

// ── replace_all ──────────────────────────────────────────────────────────────
let r = ide.replace_all(code, "add", "sum");
if r.count != 2 { fail("replace_all count (got " + str(r.count) + ")"); }
if str_contains(r.code, "fn add") { fail("replace_all should have replaced 'add'"); }
if not str_contains(r.code, "fn sum") { fail("replace_all should produce 'fn sum'"); }
if ide.replace_all(code, "", "x").count != 0 { fail("replace empty find -> no-op"); }

// ── examples catalog filtering ─────────────────────────────────────────────────
let catalog = [
    map{ title: "Hello + math", code: "print 1 + 1;" },
    map{ title: "Arrays + loops", code: "for x in [1, 2] { print x; }" },
    map{ title: "Maps + branches", code: "let user = map{ name: \"Ada\" };" },
];
let all_ex = ide.filter_examples(catalog, "", 10);
if len(all_ex) != 3 { fail("empty examples query returns all examples"); }
let loop_ex = ide.filter_examples(catalog, "LOOP", 10);
if len(loop_ex) != 1 or loop_ex[0].index != 1 { fail("examples filter matches title case-insensitively"); }
let code_ex = ide.filter_examples(catalog, "ada", 10);
if len(code_ex) != 1 or code_ex[0].index != 2 { fail("examples filter matches code case-insensitively"); }
let limited_ex = ide.filter_examples(catalog, "", 2);
if len(limited_ex) != 2 { fail("examples filter obeys limit"); }

// ── diagnostics ────────────────────────────────────────────────────────────────
let bad_code = "let x = missing;\nprint x;\n";
let nd = ide.normalize_diagnostic(bad_code, map{ kind: "error", message: "undefined name 'missing'" }, 0);
if nd.kind != "error" or nd.line != 1 { fail("diagnostic infers undefined-name line"); }
if nd.col != 9 { fail("diagnostic infers undefined-name column (got " + str(nd.col) + ")"); }
if not str_contains(nd.source, "missing") { fail("diagnostic includes source line"); }
let ndiags = ide.normalize_diagnostics(bad_code, [map{ kind: "warning", message: "unreachable code after return", line: 2 }]);
if len(ndiags) != 1 or ndiags[0].line != 2 { fail("normalize_diagnostics keeps explicit line"); }
let ds = ide.diagnostic_summary([nd], 5);
if not str_contains(ds[0], "ERROR L1:C9") { fail("diagnostic summary includes location"); }
if len(ide.diagnostic_summary([], 5)) != 1 { fail("empty diagnostic summary is helpful"); }

// ── status_text ──────────────────────────────────────────────────────────────
let st = ide.status_text(map{ path: "demo.sapp", modified: true, line: 12, col: 5, lines: 40 });
if not str_contains(st, "demo.sapp *") { fail("status shows modified marker"); }
if not str_contains(st, "Ln 12, Col 5") { fail("status shows line/col"); }
if not str_contains(st, "40 lines") { fail("status shows line count"); }

// ── history records ───────────────────────────────────────────────────────────────
let hist = [];
hist = ide.push_history(hist, "run", true, "run: ok\n> 3", "print 3;", 2);
hist = ide.push_history(hist, "check", false, "check: 1 problem(s)", "let x = missing;", 2);
hist = ide.push_history(hist, "run", true, "run: ok\n> newest", "print \"newest\";", 2);
if len(hist) != 2 { fail("history is bounded to limit"); }
if hist[0].action != "run" or not hist[0].ok { fail("newest history record first"); }
if hist[1].action != "check" or hist[1].ok { fail("older failed check retained"); }
let hs = ide.history_summary(hist, 10);
if len(hs) != 2 { fail("history_summary emits rows"); }
if not str_contains(hs[0], "RUN OK") { fail("history summary shows action/status"); }
if not str_contains(hs[1], "CHECK FAIL") { fail("history summary shows failure"); }
if len(ide.history_summary([], 10)) < 2 { fail("empty history has helpful placeholder lines"); }

// ── build profiles + IDE watcher state ───────────────────────────────────────
let dbg = ide.build_profile("debug");
if dbg.mode != "debug" or dbg.lint_before_run != true { fail("debug profile checks before run"); }
let rel = ide.build_profile("release");
if rel.mode != "release" or rel.lint_before_run != false or rel.optimize != "speed" { fail("release profile is fast run mode"); }
if ide.next_build_mode("debug") != "release" or ide.next_build_mode("release") != "debug" { fail("build mode toggles"); }
if not str_contains(ide.build_mode_summary("debug"), "Debug") { fail("build mode summary names mode"); }

let w = ide.watcher_new("demo.sapp", code);
if w.revision != 0 or w.dirty != false or w.symbols != 4 { fail("watcher_new captures clean code state"); }
let w2 = ide.watcher_update(w, "demo.sapp", code + "\nprint x;\n", true, [nd], "type");
if w2.revision != 1 or w2.dirty != true or w2.diagnostics != 1 { fail("watcher_update tracks changed dirty diagnostics"); }
let ws = ide.watcher_summary(w2);
if not str_contains(ws, "watch: on") or not str_contains(ws, "diagnostics 1") { fail("watcher_summary is readable"); }

print "ide_features_pass";
