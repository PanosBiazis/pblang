let frame_plan = ide.ide_render_frame_plan(1280, 720,
    map{ format: "pblang.graphics.backend.profile.v1", backend: "sdl2", present: "gpu-assisted-texture-present", gpu_present: true, cpu_raster_ui: true, idle_present_skip: true },
    [map{ x: 0, y: 0, w: 320, h: 180 }],
    [map{ op: "box", x: 0, y: 0, w: 120, h: 32 }, map{ op: "text", x: 8, y: 8, text: "PBIDE" }],
    map{ target_fps: 60, parallel: true, perf: map{ avg_draw_ms: 35, last_draw_ms: 35, text_calls: 1100, text_skips: 4, text_aa: 1100, text_bitmap: 0 } });
if frame_plan.format != "pbide.render.frame_plan.v1" or not frame_plan.gpu_present or frame_plan.dirty_mode != "partial" or not frame_plan.parallel_prepare or frame_plan.pressure != "critical" or frame_plan.recommended_fps != 30 or frame_plan.quality_pressure != "critical" or frame_plan.quality_recommended_fps != 24 or frame_plan.runtime_throttle != "critical" or frame_plan.runtime_idle_ms < 1500 { fail("ide_render_frame_plan exposes GPU-present partial adaptive frame schedule and render quality/runtime policy"); }
let frame_lines = ide.ide_render_frame_lines(frame_plan, 4);
if len(frame_lines) < 2 or not str_contains(frame_lines[0], "Render frame") or not str_contains(frame_lines[1], "batch=") or not str_contains(frame_lines[1], "pressure=") { fail("ide_render_frame_lines summarizes schedule"); }
let quality = ide.ide_render_quality_policy(map{ avg_draw_ms: 38, last_draw_ms: 42, draws: 3, skips: 30, text_calls: 1200, text_skips: 2, text_aa: 1200, text_bitmap: 0 }, nil, map{ target_fps: 60 });
if quality.format != "pbide.render.quality_policy.v1" or quality.pressure != "critical" or quality.text_mode != "adaptive-aa-or-bitmap" or quality.recommended_fps != 24 or len(quality.actions) < 4 { fail("ide_render_quality_policy protects slow/heavy frames"); }
let quality_lines = ide.ide_render_quality_policy_lines(quality, 4);
if len(quality_lines) < 3 or not str_contains(quality_lines[0], "Render quality") or not str_contains(quality_lines[1], "critical") { fail("ide_render_quality_policy_lines reports readable policy"); }
let runtime = ide.ide_render_runtime_plan(quality, map{ target_fps: 60, idle_ms: 500 });
if runtime.format != "pbide.render.runtime_plan.v1" or runtime.throttle != "critical" or runtime.idle_ms < 1500 or runtime.min_draw_gap_ms < 40 or runtime.input_grace_ms < 100 { fail("ide_render_runtime_plan protects PBIDE with adaptive non-input throttling"); }
let runtime_lines = ide.ide_render_runtime_plan_lines(runtime, 4);
if len(runtime_lines) < 3 or not str_contains(runtime_lines[0], "Render runtime") or not str_contains(runtime_lines[1], "critical") { fail("ide_render_runtime_plan_lines reports readable runtime throttle"); }
let cache_first = ide.ide_render_runtime_cache_policy(0, 0, 0, 0, map{ initialized: false, interval_ms: 1000 });
if cache_first.format != "pbide.render.runtime_cache_policy.v1" or not cache_first.refresh or cache_first.reason != "uninitialized" or cache_first.bounded_entries != 1 { fail("render runtime cache initializes one bounded policy entry"); }
let cache_idle = ide.ide_render_runtime_cache_policy(1000, 5000, 7, 7, map{ initialized: true, interval_ms: 1000 });
if cache_idle.refresh or cache_idle.reason != "reuse-unchanged-sample" or cache_idle.next_in_ms != 1000 { fail("render runtime cache does no work for unchanged idle samples"); }
let cache_coalesce = ide.ide_render_runtime_cache_policy(1000, 1500, 7, 8, map{ initialized: true, interval_ms: 1000 });
if cache_coalesce.refresh or cache_coalesce.reason != "coalesce-new-sample" or cache_coalesce.next_in_ms != 500 { fail("render runtime cache coalesces rapid draw samples"); }
let cache_due = ide.ide_render_runtime_cache_policy(1000, 2000, 7, 8, map{ initialized: true, interval_ms: 1000 });
if not cache_due.refresh or cache_due.reason != "new-draw-sample" { fail("render runtime cache refreshes changed samples at the bounded cadence"); }
let cache_reset = ide.ide_render_runtime_cache_policy(3000, 2000, 8, 8, map{ initialized: true, interval_ms: 1 });
if not cache_reset.refresh or cache_reset.reason != "clock-reset" or cache_reset.interval_ms != 100 { fail("render runtime cache handles clock rollback and clamps short intervals"); }
