// tests/semantics/ide_features_test.sapp
// Web-IDE-style editor features (outline, find-all, find&replace, status bar) as pure logic.
let ide = import("stdlib:ide_features.sapp");
let uio = import("stdlib:ui_observer.sapp");

fn fail(m) { throw "FAIL " + m; }

let code = "let x = 1;\nfn add(a, b) {\n    return a + b;\n}\nconst PI = 3;\nexport add, x;\n";

// ── outline ──────────────────────────────────────────────────────────────────
let o = ide.outline(code);
if len(o) != 4 { fail("outline should find 4 symbols (got " + str(len(o)) + ")"); }
if o[0].kind != "let" or o[0].name != "x" or o[0].line != 1 { fail("outline let x line 1"); }
if o[1].kind != "fn" or o[1].name != "add" or o[1].line != 2 { fail("outline fn add line 2"); }
if o[2].kind != "const" or o[2].name != "PI" { fail("outline const PI"); }
if o[3].kind != "export" { fail("outline export"); }
let of = ide.filter_outline(code, "add", 10);
if len(of) != 2 or of[0].kind != "fn" or of[1].kind != "export" { fail("filter_outline finds matching symbols"); }
let of_limited = ide.filter_outline(code, "", 2);
if len(of_limited) != 2 { fail("filter_outline obeys limit"); }
let ofs = ide.outline_filter_status(code, "add", 0);
if not str_contains(ofs, "2/4") or not str_contains(ofs, "sel 1/2") { fail("outline_filter_status shows filtered count"); }
let ofs_all = ide.outline_filter_status(code, "", 99);
if not str_contains(ofs_all, "all 4") or not str_contains(ofs_all, "sel 4/4") { fail("outline_filter_status clamps selected"); }
let ofs_none = ide.outline_filter_status(code, "missing", 0);
if not str_contains(ofs_none, "0/4") or str_contains(ofs_none, "sel") { fail("outline_filter_status handles empty hits"); }
let ranges = ide.outline_ranges(code);
if len(ranges) != 4 { fail("outline_ranges mirrors outline count"); }
if ranges[1].kind != "fn" or ranges[1].line != 2 or ranges[1].end_line != 4 or ranges[1].lines != 3 { fail("outline_ranges computes function span"); }
if not str_contains(ranges[1].label, "fn add L2-L4") { fail("outline_ranges labels spans"); }
let of_range = ide.filter_outline(code, "4", 10);
if len(of_range) < 1 or of_range[0].end_line != 4 { fail("filter_outline can match symbol ranges"); }
let sym0 = ide.current_symbol(code, 0);
if sym0.kind != "file" or sym0.label != "top-level" { fail("current_symbol handles before first symbol"); }
let sym_fn = ide.current_symbol(code, 3);
if sym_fn.kind != "fn" or sym_fn.name != "add" or sym_fn.end_line != 4 or not str_contains(sym_fn.label, "fn add L2-L4") { fail("current_symbol finds enclosing function span"); }
let sym_export = ide.current_symbol(code, 99);
if sym_export.kind != "export" or sym_export.line != 6 { fail("current_symbol picks nearest previous symbol"); }

// ── find_all ─────────────────────────────────────────────────────────────────
let hits = ide.find_all(code, "a");
if len(hits) < 3 { fail("find_all should find multiple 'a' (got " + str(len(hits)) + ")"); }
if hits[0].line != 2 { fail("first 'a' is on line 2 (fn add)"); }
if len(ide.find_all(code, "zzz")) != 0 { fail("find_all of missing -> empty"); }
if len(ide.find_all(code, "")) != 0 { fail("find_all of empty query -> empty"); }
// two matches on one line
let two = ide.find_all("aa bb aa", "aa");
if len(two) != 2 or two[0].col != 1 or two[1].col != 7 { fail("find_all two-per-line cols"); }
let fs = ide.find_status(code, "add", false, "find", "");
if not str_contains(fs, "2 matches") or not str_contains(fs, "Enter=next") { fail("find_status shows count and next hint"); }
let fs0 = ide.find_status(code, "missing", false, "find", "");
if not str_contains(fs0, "0 matches") { fail("find_status shows zero matches"); }
let rs = ide.find_status(code, "add", true, "replace", "sum");
if not str_contains(rs, "REPLACE [replace]") or not str_contains(rs, "2 matches") or not str_contains(rs, "sum") { fail("replace find_status shows focus/count/replacement"); }
let fps = ide.find_position_status(code, "add", 2, 4);
if not str_contains(fps, "match 1/2") or not str_contains(fps, "L2:C4") { fail("find_position_status reports exact match ordinal"); }
let fps2 = ide.find_position_status(code, "add", 6, 8);
if not str_contains(fps2, "match 2/2") or not str_contains(fps2, "L6:C8") { fail("find_position_status reports later exact match"); }
let fps_near = ide.find_position_status(code, "add", 5, 1);
if not str_contains(fps_near, "match 1/2") { fail("find_position_status keeps nearest previous match before target"); }
let fps0 = ide.find_position_status(code, "missing", 1, 1);
if fps0 != "match 0/0" { fail("find_position_status handles no matches"); }

// ── replace_all ──────────────────────────────────────────────────────────────
let r = ide.replace_all(code, "add", "sum");
if r.count != 2 { fail("replace_all count (got " + str(r.count) + ")"); }
if str_contains(r.code, "fn add") { fail("replace_all should have replaced 'add'"); }
if not str_contains(r.code, "fn sum") { fail("replace_all should produce 'fn sum'"); }
if ide.replace_all(code, "", "x").count != 0 { fail("replace empty find -> no-op"); }

// ── examples catalog filtering ─────────────────────────────────────────────────
let catalog = [
    map{ title: "Hello + math", code: "print 1 + 1;" },
    map{ title: "Arrays + loops", code: "for x in [1, 2] { print x; }" },
    map{ title: "Maps + branches", code: "let user = map{ name: \"Ada\" };" },
];
let all_ex = ide.filter_examples(catalog, "", 10);
if len(all_ex) != 3 { fail("empty examples query returns all examples"); }
let loop_ex = ide.filter_examples(catalog, "LOOP", 10);
if len(loop_ex) != 1 or loop_ex[0].index != 1 { fail("examples filter matches title case-insensitively"); }
let code_ex = ide.filter_examples(catalog, "ada", 10);
if len(code_ex) != 1 or code_ex[0].index != 2 { fail("examples filter matches code case-insensitively"); }
let limited_ex = ide.filter_examples(catalog, "", 2);
if len(limited_ex) != 2 { fail("examples filter obeys limit"); }
let ex_status = ide.examples_filter_status(catalog, "loop", 0);
if not str_contains(ex_status, "1/3") or not str_contains(ex_status, "sel 1/1") { fail("examples_filter_status shows filtered count"); }
let ex_status_all = ide.examples_filter_status(catalog, "", 99);
if not str_contains(ex_status_all, "all 3") or not str_contains(ex_status_all, "sel 3/3") { fail("examples_filter_status clamps selected"); }
let ex_status_none = ide.examples_filter_status(catalog, "missing", 0);
if not str_contains(ex_status_none, "0/3") or str_contains(ex_status_none, "sel") { fail("examples_filter_status handles empty matches"); }

// ── command palette catalog/filter ───────────────────────────────────────────
let cmds = ide.command_catalog();
if len(cmds) < 10 { fail("command catalog exposes IDE commands"); }
if len(ide.command_catalog_issues(cmds)) != 0 { fail("command catalog has no duplicate/malformed commands"); }
if not ide.command_catalog_has("run", cmds) or ide.command_catalog_has("missing_command", cmds) { fail("command_catalog_has checks ids"); }
let toolbar_action_ids = ["run", "check", "format", "fix", "examples", "save", "open", "mode", "watch", "style", "theme"];
let missing_toolbar_ids = ide.command_catalog_missing(toolbar_action_ids, cmds);
if len(missing_toolbar_ids) != 0 { fail("all visible toolbar actions are in the command catalog"); }
if ide.panel_command_id("code") != "panel_code" or ide.panel_command_id("panel_web") != "panel_web" { fail("panel_command_id normalizes panel ids"); }
let visible_panel_ids = ["code", "term", "ai", "design", "web", "files", "outline", "problems", "hist"];
let visible_panel_commands = ide.panel_command_ids(visible_panel_ids);
if len(visible_panel_commands) != len(visible_panel_ids) or visible_panel_commands[1] != "panel_term" or visible_panel_commands[8] != "panel_hist" { fail("panel_command_ids maps visible tabs"); }
let missing_panel_ids = ide.command_catalog_missing(visible_panel_commands, cmds);
if len(missing_panel_ids) != 0 { fail("all visible panel tabs are in the command catalog"); }
let missing_probe = ide.command_catalog_missing(["run", "not_real_command"], cmds);
if len(missing_probe) != 1 or missing_probe[0] != "not_real_command" { fail("command_catalog_missing reports missing ids only"); }
let cmd_dupes = ide.command_catalog_issues([
    map{ id: "run", title: "Run", group: "Code", shortcut: "F5" },
    map{ id: "run", title: "", group: "", shortcut: "" }
]);
if len(cmd_dupes) < 4 { fail("command_catalog_issues detects duplicate and missing fields"); }
let cmd_bad_id = ide.command_catalog_issues([
    map{ id: "Bad Id", title: "Bad", group: "Code", shortcut: "" }
]);
if len(cmd_bad_id) < 2 { fail("command_catalog_issues detects malformed ids and missing shortcuts"); }
let group_counts = ide.command_catalog_group_counts([
    map{ id: "a", title: "A", group: "Code", shortcut: "A" },
    map{ id: "b", title: "B", group: "Code", shortcut: "B" },
    map{ id: "c", title: "C", group: "View", shortcut: "C" }
]);
if len(group_counts) != 2 or group_counts[0].group != "Code" or group_counts[0].count != 2 or group_counts[1].group != "View" { fail("command_catalog_group_counts counts groups in order"); }
let cmd_summary = ide.command_catalog_summary([
    map{ id: "a", title: "A", group: "Code", shortcut: "A" },
    map{ id: "b", title: "B", group: "Code", shortcut: "B" },
    map{ id: "c", title: "C", group: "View", shortcut: "C" }
]);
if not str_contains(cmd_summary, "3 commands") or not str_contains(cmd_summary, "2 groups") or not str_contains(cmd_summary, "largest Code 2") { fail("command_catalog_summary describes command surface"); }
let group_code_cmds = ide.filter_commands("group:code", 100);
if len(group_code_cmds) < 5 or group_code_cmds[0].group != "Code" { fail("command filter supports group:code browsing"); }
let group_browser_cmds = ide.filter_commands("group=browser source", 20);
if len(group_browser_cmds) < 1 or group_browser_cmds[0].id != "browser_source" { fail("command filter combines group= and text tokens"); }
let source_ranked_cmd = ide.filter_commands("source", 1);
if len(source_ranked_cmd) != 1 or source_ranked_cmd[0].id != "browser_source" { fail("command filter ranks id matches above earlier broad title matches"); }
let browser_source_limited = ide.filter_commands("group=browser source", 1);
if len(browser_source_limited) != 1 or browser_source_limited[0].id != "browser_source" { fail("command filter ranking works with group filters and small limits"); }
let id_run_cmd = ide.filter_commands("id:run", 10);
if len(id_run_cmd) != 1 or id_run_cmd[0].id != "run" { fail("command filter supports id: scoped filter"); }
let cmd_alias_open = ide.filter_commands("cmd=open", 10);
if len(cmd_alias_open) != 1 or cmd_alias_open[0].id != "open" { fail("command filter supports cmd= alias"); }
let title_browser_cmds = ide.filter_commands("title:browser", 10);
if len(title_browser_cmds) < 1 or title_browser_cmds[0].id != "panel_web" { fail("command filter supports title: scoped filter with ranking"); }
let shortcut_ctrl6 = ide.filter_commands("shortcut:ctrl+6", 10);
if len(shortcut_ctrl6) != 1 or shortcut_ctrl6[0].id != "panel_files" { fail("command filter supports shortcut: scoped filter"); }
let key_f5 = ide.filter_commands("key:f5", 10);
if len(key_f5) != 1 or key_f5[0].id != "run" { fail("command filter supports key: alias"); }
let scoped_combo_cmd = ide.filter_commands("group=browser id:source", 10);
if len(scoped_combo_cmd) != 1 or scoped_combo_cmd[0].id != "browser_source" { fail("command filter combines group and id scopes"); }
let command_not_browser = ide.filter_commands("source not:browser", 10);
if len(command_not_browser) < 1 { fail("command filter keeps non-excluded text results"); }
let cnb_i = 0;
while cnb_i < len(command_not_browser) {
    if str_contains(str_lower(command_not_browser[cnb_i].group), "browser") or str_contains(str_lower(command_not_browser[cnb_i].id), "browser") { fail("command filter supports not: exclusion filters"); }
    cnb_i = cnb_i + 1;
}
let command_exclude_ai = ide.filter_commands("group:code exclude:ai", 100);
if len(command_exclude_ai) < 1 { fail("command filter keeps non-excluded scoped results"); }
let cea_i = 0;
while cea_i < len(command_exclude_ai) {
    if str_contains(str_lower(command_exclude_ai[cea_i].title), "ai") or str_contains(str_lower(command_exclude_ai[cea_i].id), "ai") { fail("command filter supports exclude: alias"); }
    cea_i = cea_i + 1;
}
let hint_empty = ide.command_filter_hint("");
if not str_contains(hint_empty, "group:code") or not str_contains(hint_empty, "group:browser") { fail("command_filter_hint teaches empty group filters"); }
let hint_text = ide.command_filter_hint("source");
if not str_contains(hint_text, "id:run") or not str_contains(hint_text, "shortcut:ctrl+6") or not str_contains(hint_text, "not:browser") { fail("command_filter_hint suggests scoped filters for text filters"); }
let hint_group = ide.command_filter_hint("group:browser");
if not str_contains(hint_group, "group browser active") { fail("command_filter_hint reports active group"); }
let hint_combo = ide.command_filter_hint("group=browser source");
if not str_contains(hint_combo, "group browser") or not str_contains(hint_combo, "source") { fail("command_filter_hint reports group plus text"); }
let hint_scoped = ide.command_filter_hint("group=browser id:source");
if not str_contains(hint_scoped, "group browser") or not str_contains(hint_scoped, "id source") { fail("command_filter_hint reports scoped command filters"); }
let hint_exclude = ide.command_filter_hint("group=code not:browser source");
if not str_contains(hint_exclude, "group code") or not str_contains(hint_exclude, "not browser") or not str_contains(hint_exclude, "source") { fail("command_filter_hint reports exclusion filters"); }
let command_examples = ide.command_filter_examples(3);
if len(command_examples) != 3 or command_examples[0] != "group:code" or command_examples[2] != "id:run" { fail("command_filter_examples returns stable examples"); }
let command_examples_line = ide.command_filter_examples_line(6);
if not str_contains(command_examples_line, "filters:") or not str_contains(command_examples_line, "title:browser") or not str_contains(command_examples_line, "shortcut:ctrl+6") or not str_contains(command_examples_line, "not:browser") { fail("command_filter_examples_line formats visible examples"); }
let run_cmd = ide.filter_commands("run", 10);
if len(run_cmd) < 1 or run_cmd[0].id != "run" { fail("command filter finds run command"); }
let new_cmd = ide.filter_commands("new buffer", 10);
if len(new_cmd) < 1 or new_cmd[0].id != "new" { fail("command filter finds new buffer command"); }
let save_as_cmd = ide.filter_commands("save as path", 10);
if len(save_as_cmd) < 1 or save_as_cmd[0].id != "save_as" { fail("command filter finds save as command"); }
let revert_cmd = ide.filter_commands("revert disk", 10);
if len(revert_cmd) < 1 or revert_cmd[0].id != "revert" { fail("command filter finds revert command"); }
let clear_cmd = ide.filter_commands("clear output", 10);
if len(clear_cmd) < 1 or clear_cmd[0].id != "clear" { fail("command filter finds clear output command"); }
let restore_cmd = ide.filter_commands("restore starter", 10);
if len(restore_cmd) < 1 or restore_cmd[0].id != "restore" { fail("command filter finds restore starter command"); }
let dup_line_cmd = ide.filter_commands("duplicate current line", 10);
if len(dup_line_cmd) < 1 or dup_line_cmd[0].id != "line_duplicate" { fail("command filter finds duplicate line command"); }
let del_line_cmd = ide.filter_commands("delete current line", 10);
if len(del_line_cmd) < 1 or del_line_cmd[0].id != "line_delete" { fail("command filter finds delete line command"); }
let move_line_up_cmd = ide.filter_commands("move line up", 10);
if len(move_line_up_cmd) < 1 or move_line_up_cmd[0].id != "line_move_up" { fail("command filter finds move line up command"); }
let move_line_down_cmd = ide.filter_commands("alt+down", 10);
if len(move_line_down_cmd) < 1 or move_line_down_cmd[0].id != "line_move_down" { fail("command filter finds move line down command"); }
let comment_line_cmd = ide.filter_commands("toggle line comment", 10);
if len(comment_line_cmd) < 1 or comment_line_cmd[0].id != "line_comment_toggle" { fail("command filter finds toggle line comment command"); }
let indent_cmd = ide.filter_commands("indent selected lines", 10);
if len(indent_cmd) < 1 or indent_cmd[0].id != "line_indent" { fail("command filter finds indent lines command"); }
let outdent_cmd = ide.filter_commands("shift+tab", 10);
if len(outdent_cmd) < 1 or outdent_cmd[0].id != "line_outdent" { fail("command filter finds outdent lines command"); }
let trim_ws_cmd = ide.filter_commands("trim trailing whitespace", 10);
if len(trim_ws_cmd) < 1 or trim_ws_cmd[0].id != "trim_trailing_ws" { fail("command filter finds trim whitespace command"); }
let find_cmd = ide.filter_commands("find current buffer", 10);
if len(find_cmd) < 1 or find_cmd[0].id != "find" { fail("command filter finds find command"); }
let replace_cmd = ide.filter_commands("replace current buffer", 10);
if len(replace_cmd) < 1 or replace_cmd[0].id != "replace" { fail("command filter finds replace command"); }
let panel_cmd = ide.filter_commands("browser", 10);
if len(panel_cmd) < 1 or panel_cmd[0].id != "panel_web" { fail("command filter finds browser panel"); }
let outline_cmd = ide.filter_commands("outline", 10);
if len(outline_cmd) < 1 or outline_cmd[0].id != "panel_outline" { fail("command filter finds outline panel"); }
let files_cmd = ide.filter_commands("files", 10);
if len(files_cmd) < 1 or files_cmd[0].id != "panel_files" { fail("command filter finds files panel"); }
let files_recent_cmd = ide.filter_commands("files recent", 10);
if len(files_recent_cmd) < 1 or files_recent_cmd[0].id != "files_recent" { fail("command filter finds files recent view"); }
let files_tree_cmd = ide.filter_commands("files tree", 10);
if len(files_tree_cmd) < 1 or files_tree_cmd[0].id != "files_tree" { fail("command filter finds files tree view"); }
let files_reveal_cmd = ide.filter_commands("reveal current file", 10);
if len(files_reveal_cmd) < 1 or files_reveal_cmd[0].id != "files_reveal" { fail("command filter finds reveal current file"); }
let files_clear_recent_cmd = ide.filter_commands("clear recent", 10);
if len(files_clear_recent_cmd) < 1 or files_clear_recent_cmd[0].id != "files_clear_recent" { fail("command filter finds clear recent files"); }
let terminal_clear_cmd = ide.filter_commands("terminal clear", 10);
if len(terminal_clear_cmd) < 1 or terminal_clear_cmd[0].id != "terminal_clear" { fail("command filter finds terminal clear"); }
let ctrl6_cmd = ide.filter_commands("ctrl+6", 10);
if len(ctrl6_cmd) < 1 or ctrl6_cmd[0].id != "panel_files" { fail("command filter finds panel shortcut"); }
let multi_field_cmd = ide.filter_commands("panel ctrl+6", 10);
if len(multi_field_cmd) < 1 or multi_field_cmd[0].id != "panel_files" { fail("command filter matches query tokens across fields"); }
let panel_next_cmd = ide.filter_commands("ctrl+tab", 10);
if len(panel_next_cmd) < 1 or panel_next_cmd[0].id != "panel_next" { fail("command filter finds next panel shortcut"); }
let panel_prev_cmd = ide.filter_commands("pageup", 10);
if len(panel_prev_cmd) < 1 or panel_prev_cmd[0].id != "panel_prev" { fail("command filter finds previous panel shortcut"); }
let panel_prev_tokens = ide.filter_commands("previous ctrl+pageup", 10);
if len(panel_prev_tokens) < 1 or panel_prev_tokens[0].id != "panel_prev" { fail("command filter matches previous panel tokens"); }
let watch_action_cmd = ide.filter_commands("suggested", 10);
if len(watch_action_cmd) < 1 or watch_action_cmd[0].id != "watch_action" { fail("command filter finds watcher suggested action"); }
let problems_cmd = ide.filter_commands("problems", 10);
if len(problems_cmd) < 1 or problems_cmd[0].id != "problems" { fail("command filter finds problems command"); }
let goto_cmd = ide.filter_commands("go to line", 10);
if len(goto_cmd) < 1 or goto_cmd[0].id != "goto_line" { fail("command filter finds go to line"); }
let nav_back_cmd = ide.filter_commands("alt+left", 10);
if len(nav_back_cmd) < 1 or nav_back_cmd[0].id != "navigate_back" { fail("command filter finds navigate back"); }
let nav_forward_cmd = ide.filter_commands("navigate forward", 10);
if len(nav_forward_cmd) < 1 or nav_forward_cmd[0].id != "navigate_forward" { fail("command filter finds navigate forward"); }
let problems_panel_cmd = ide.filter_commands("problems panel", 10);
if len(problems_panel_cmd) < 1 or problems_panel_cmd[0].id != "panel_problems" { fail("command filter finds problems panel"); }
let history_clear_cmd = ide.filter_commands("clear history", 10);
if len(history_clear_cmd) < 1 or history_clear_cmd[0].id != "history_clear" { fail("command filter finds history clear"); }
let next_diag_cmd = ide.filter_commands("next diagnostic", 10);
if len(next_diag_cmd) < 1 or next_diag_cmd[0].id != "diagnostic_next" { fail("command filter finds next diagnostic"); }
let prev_diag_cmd = ide.filter_commands("previous diagnostic", 10);
if len(prev_diag_cmd) < 1 or prev_diag_cmd[0].id != "diagnostic_prev" { fail("command filter finds previous diagnostic"); }
let browser_tor_cmd = ide.filter_commands("browser tor toggle", 10);
if len(browser_tor_cmd) < 1 or browser_tor_cmd[0].id != "browser_tor_toggle" { fail("command filter finds browser tor toggle"); }
let browser_safe_cmd = ide.filter_commands("browser safe", 10);
if len(browser_safe_cmd) < 1 or browser_safe_cmd[0].id != "browser_security_safe" { fail("command filter finds browser safe profile"); }
let browser_trusted_cmd = ide.filter_commands("browser trusted", 10);
if len(browser_trusted_cmd) < 1 or browser_trusted_cmd[0].id != "browser_security_trusted" { fail("command filter finds browser trusted profile"); }
let browser_source_cmd = ide.filter_commands("browser source", 10);
if len(browser_source_cmd) < 1 or browser_source_cmd[0].id != "browser_source" { fail("command filter finds browser source view"); }
let browser_inspect_cmd = ide.filter_commands("f12 details", 10);
if len(browser_inspect_cmd) < 1 or browser_inspect_cmd[0].id != "browser_inspect" { fail("command filter finds browser inspect details"); }
let ai_explain_cmd = ide.filter_commands("ai explain", 10);
if len(ai_explain_cmd) < 1 or ai_explain_cmd[0].id != "ai_explain" { fail("command filter finds AI explain"); }
let ai_bugs_cmd = ide.filter_commands("find bugs code", 10);
if len(ai_bugs_cmd) < 1 or ai_bugs_cmd[0].id != "ai_bugs" { fail("command filter finds AI bugs"); }
let ai_diag_cmd = ide.filter_commands("ai diagnostics", 10);
if len(ai_diag_cmd) < 1 or ai_diag_cmd[0].id != "ai_diag" { fail("command filter finds AI diagnostics"); }
let ai_insert_cmd = ide.filter_commands("ai insert last answer", 10);
if len(ai_insert_cmd) < 1 or ai_insert_cmd[0].id != "ai_insert" { fail("command filter finds AI insert"); }
let ai_clear_cmd = ide.filter_commands("ai clear", 10);
if len(ai_clear_cmd) < 1 or ai_clear_cmd[0].id != "ai_clear" { fail("command filter finds AI clear"); }
let design_code_cmd = ide.filter_commands("designer code", 10);
if len(design_code_cmd) < 1 or design_code_cmd[0].id != "design_codegen" { fail("command filter finds Designer codegen"); }
let design_layout_cmd = ide.filter_commands("designer layout", 10);
if len(design_layout_cmd) < 1 or design_layout_cmd[0].id != "design_layout_next" { fail("command filter finds Designer layout"); }
let design_target_cmd = ide.filter_commands("designer target", 10);
if len(design_target_cmd) < 1 or design_target_cmd[0].id != "design_target_next" { fail("command filter finds Designer target"); }
let design_duplicate_cmd = ide.filter_commands("designer duplicate", 10);
if len(design_duplicate_cmd) < 1 or design_duplicate_cmd[0].id != "design_duplicate" { fail("command filter finds Designer duplicate"); }
let design_layer_cmd = ide.filter_commands("designer bring front", 10);
if len(design_layer_cmd) < 1 or design_layer_cmd[0].id != "design_layer_top" { fail("command filter finds Designer layer front"); }
let style_cmd = ide.filter_commands("visual style", 10);
if len(style_cmd) < 1 or style_cmd[0].id != "style" { fail("command filter finds visual style command"); }
let theme_cmd = ide.filter_commands("light dark theme", 10);
if len(theme_cmd) < 1 or theme_cmd[0].id != "theme" { fail("command filter finds light/dark theme command"); }
let ui_snapshot_cmd = ide.filter_commands("ui snapshot", 10);
if len(ui_snapshot_cmd) < 1 or ui_snapshot_cmd[0].id != "ui_snapshot" { fail("command filter finds UI observer snapshot"); }
let limited_cmd = ide.filter_commands("", 3);
if len(limited_cmd) != 3 { fail("command filter obeys limit"); }
let cmd_status = ide.command_filter_status("ai", 0);
if not str_contains(cmd_status, "commands:") or not str_contains(cmd_status, "sel 1/") or not str_contains(cmd_status, "panel_ai") or not str_contains(cmd_status, "Panels") { fail("command_filter_status shows filtered selection and command metadata"); }
let cmd_status_all = ide.command_filter_status("", 999);
if not str_contains(cmd_status_all, "commands: all") or not str_contains(cmd_status_all, "sel") or not str_contains(cmd_status_all, "help") { fail("command_filter_status shows all commands and clamps selection metadata"); }
let cmd_status_source = ide.command_filter_status("source", 0);
if not str_contains(cmd_status_source, "browser_source") or not str_contains(cmd_status_source, "Browser") { fail("command_filter_status follows ranked selected command"); }
let cmd_status_none = ide.command_filter_status("definitely_missing_command", 0);
if not str_contains(cmd_status_none, "0/") or str_contains(cmd_status_none, "sel") { fail("command_filter_status handles empty matches"); }
let cmd_empty = ide.command_empty_message("definitely_missing_command");
if not str_contains(cmd_empty, "No matching commands for `definitely_missing_command`") or not str_contains(cmd_empty, "group:code") or not str_contains(cmd_empty, "run/save/open") { fail("command_empty_message gives recovery guidance"); }
let cmd_empty_group = ide.command_empty_message("group:browser definitely_missing_command");
if not str_contains(cmd_empty_group, "group browser") or not str_contains(cmd_empty_group, "exact command ids") { fail("command_empty_message preserves active group guidance"); }

// ── browser toolbar layout / hit zones ───────────────────────────────────────
let bm = ide.browser_bar_metrics(8, 4);
if bm.button_h != 20 or bm.summary_h != 12 or bm.total_h != 32 { fail("browser bar metrics match native button + summary rows"); }
if ide.browser_bar_zone(9, 10, 8, 4) != "above" { fail("browser bar zone detects above toolbar"); }
if ide.browser_bar_zone(10, 10, 8, 4) != "buttons" { fail("browser bar zone detects first button pixel"); }
if ide.browser_bar_zone(29, 10, 8, 4) != "buttons" { fail("browser bar zone keeps final button pixel clickable"); }
if ide.browser_bar_zone(30, 10, 8, 4) != "summary" { fail("browser bar zone starts security summary after buttons"); }
if ide.browser_bar_zone(41, 10, 8, 4) != "summary" { fail("browser security summary row is not button-clickable"); }
if ide.browser_bar_zone(42, 10, 8, 4) != "body" { fail("browser body starts after security summary"); }

// ── problems panel hit zones ─────────────────────────────────────────────────
let ph0 = ide.problems_panel_hit(99, 100, 8, 4, 2);
if ph0.kind != "above" { fail("problems hit detects area above action row"); }
let ph1 = ide.problems_panel_hit(100, 100, 8, 4, 2);
if ph1.kind != "action" or ph1.index != 0 { fail("problems hit maps action row"); }
let phGap = ide.problems_panel_hit(108, 100, 8, 4, 2);
if phGap.kind != "gap" { fail("problems hit does not map action/diagnostic padding to action"); }
let ph2 = ide.problems_panel_hit(112, 100, 8, 4, 2);
if ph2.kind != "diagnostic" or ph2.index != 0 { fail("problems hit maps first diagnostic after padding"); }
let ph3 = ide.problems_panel_hit(120, 100, 8, 4, 2);
if ph3.kind != "diagnostic" or ph3.index != 1 { fail("problems hit maps second diagnostic"); }
let ph4 = ide.problems_panel_hit(136, 100, 8, 4, 2);
if ph4.kind != "below" { fail("problems hit detects area below diagnostics"); }

// ── UI observer snapshots ───────────────────────────────────────────────────
let ui_regions = [
    uio.region("toolbar", 0, 0, 800, 32, "toolbar", map{}),
    uio.region("editor", 0, 32, 560, 520, "editor", map{}),
    uio.region("sidepane", 560, 32, 240, 520, "sidepane", map{})
];
let ui_snap = uio.surface_snapshot("pbide", "test surface", map{ w: 800, h: 600 }, "code", ui_regions, ["panel=code", "event=mouse 10,10"]);
if ui_snap.format != "pblang.ui.snapshot.v1" or ui_snap.region_count != 3 { fail("ui snapshot records format and region count"); }
if ui_snap.issue_count != 0 { fail("ui snapshot has no issues for clean regions"); }
if ui_snap.quality_score != 100 or uio.snapshot_score(ui_snap) != 100 { fail("ui observer scores clean layout at 100"); }
let ui_lines = uio.snapshot_lines(ui_snap, 5);
if len(ui_lines) != 5 or not str_contains(ui_lines[0], "ui: pbide") or not str_contains(ui_lines[0], "quality=100/100") or not str_contains(ui_lines[1], "signal: panel=code") or not str_contains(ui_lines[2], "event=mouse") or not str_contains(ui_lines[3], "toolbar") { fail("ui snapshot lines are readable"); }
let bad_ui = uio.surface_snapshot("pbide", "bad surface", map{ w: 100, h: 100 }, "code", [
    uio.region("bad-size", 0, 0, 0, 10, "panel", map{}),
    uio.region("offscreen", 90, 90, 30, 30, "panel", map{}),
    uio.region("a", 10, 10, 50, 50, "panel", map{}),
    uio.region("b", 30, 30, 50, 50, "panel", map{}),
    uio.region("modal", 0, 0, 100, 100, "modal", map{ overlay: true })
], []);
if bad_ui.issue_count < 3 { fail("ui observer detects size/offscreen/overlap issues"); }
if bad_ui.quality_score >= 100 or uio.snapshot_score(bad_ui) != bad_ui.quality_score { fail("ui observer lowers quality score for layout issues"); }
let bad_lines = uio.snapshot_lines(bad_ui, 5);
if not str_contains(bad_lines[1], "issue:") { fail("ui observer reports issues first"); }

// ── quick-open file filtering ─────────────────────────────────────────────────
let files = [
    map{ name: "stdlib", path: "stdlib", kind: "dir" },
    map{ name: "pbide.sapp", path: "editors/ide/pbide.sapp", kind: "file" },
    map{ name: "PB_IDE.md", path: "docs/PB_IDE.md", kind: "file" },
    map{ name: "tests", path: "tests", kind: "dir" },
];
let qopen_all = ide.quick_open_candidates(files, "", 10);
if len(qopen_all) != 4 { fail("quick open returns all candidates"); }
if qopen_all[0].kind != "dir" or qopen_all[1].kind != "dir" { fail("quick open lists directories first"); }
let qopen_pbide = ide.quick_open_candidates(files, "pbide", 10);
if len(qopen_pbide) != 1 or qopen_pbide[0].path != "editors/ide/pbide.sapp" { fail("quick open filters by file path/name"); }
let qopen_doc = ide.quick_open_candidates(files, "docs", 10);
if len(qopen_doc) != 1 or qopen_doc[0].name != "PB_IDE.md" { fail("quick open filters by path text"); }
let ranked_files = [
    map{ name: "notes.sapp", path: "docs/pbide/notes.sapp", kind: "file" },
    map{ name: "pbide.sapp", path: "editors/ide/pbide.sapp", kind: "file" },
    map{ name: "pbide_extra.sapp", path: "scratch/pbide_extra.sapp", kind: "file" },
];
let qopen_ranked = ide.quick_open_candidates(ranked_files, "pbide", 10);
if len(qopen_ranked) != 3 or qopen_ranked[0].name != "pbide.sapp" or qopen_ranked[1].name != "pbide_extra.sapp" { fail("quick open ranks exact and prefix filename matches first"); }
let qopen_ranked_limited = ide.quick_open_candidates(ranked_files, "pbide", 1);
if len(qopen_ranked_limited) != 1 or qopen_ranked_limited[0].name != "pbide.sapp" { fail("quick open ranking considers later exact matches before applying limit"); }
let qopen_ranked_name = ide.quick_open_candidates(ranked_files, "name:pbide", 10);
if len(qopen_ranked_name) != 2 or qopen_ranked_name[0].name != "pbide.sapp" { fail("quick open ranks scoped filename matches"); }
let qopen_ranked_name_limited = ide.quick_open_candidates(ranked_files, "name:pbide", 1);
if len(qopen_ranked_name_limited) != 1 or qopen_ranked_name_limited[0].name != "pbide.sapp" { fail("quick open scoped ranking considers later exact matches before applying limit"); }
let qopen_multi = ide.quick_open_candidates(files, "pb ide", 10);
if len(qopen_multi) != 2 or qopen_multi[0].kind != "file" or qopen_multi[1].kind != "file" { fail("quick open supports multi-word AND search"); }
let qopen_multi_path = ide.quick_open_candidates(files, "editors pbide", 10);
if len(qopen_multi_path) != 1 or qopen_multi_path[0].path != "editors/ide/pbide.sapp" { fail("quick open multi-word search matches across path and name"); }
let qopen_multi_missing = ide.quick_open_candidates(files, "pb missing", 10);
if len(qopen_multi_missing) != 0 { fail("quick open multi-word search requires every token"); }
let qopen_limited = ide.quick_open_candidates(files, "", 2);
if len(qopen_limited) != 2 { fail("quick open obeys limit"); }
let qopen_dirs = ide.quick_open_candidates(files, "kind:dir", 10);
if len(qopen_dirs) != 2 or qopen_dirs[0].kind != "dir" or qopen_dirs[1].kind != "dir" { fail("quick open supports kind:dir filter"); }
let qopen_files = ide.quick_open_candidates(files, "kind=file", 10);
if len(qopen_files) != 2 or qopen_files[0].kind != "file" or qopen_files[1].kind != "file" { fail("quick open supports kind=file filter"); }
let qopen_folder_alias = ide.quick_open_candidates(files, "type:folder stdlib", 10);
if len(qopen_folder_alias) != 1 or qopen_folder_alias[0].path != "stdlib" { fail("quick open supports folder alias plus text"); }
let qopen_file_text = ide.quick_open_candidates(files, "type=file pbide", 10);
if len(qopen_file_text) != 1 or qopen_file_text[0].path != "editors/ide/pbide.sapp" { fail("quick open supports file kind plus text"); }
let qopen_ext_sapp = ide.quick_open_candidates(files, "ext:sapp", 10);
if len(qopen_ext_sapp) != 1 or qopen_ext_sapp[0].path != "editors/ide/pbide.sapp" { fail("quick open supports ext:sapp filter"); }
let qopen_ext_md = ide.quick_open_candidates(files, "extension=.md", 10);
if len(qopen_ext_md) != 1 or qopen_ext_md[0].name != "PB_IDE.md" { fail("quick open supports extension=.md filter"); }
let qopen_ext_combo = ide.quick_open_candidates(files, "kind=file ext=sapp pbide", 10);
if len(qopen_ext_combo) != 1 or qopen_ext_combo[0].path != "editors/ide/pbide.sapp" { fail("quick open combines kind, extension, and text filters"); }
let qopen_name_pbide = ide.quick_open_candidates(files, "name:pbide", 10);
if len(qopen_name_pbide) != 1 or qopen_name_pbide[0].name != "pbide.sapp" { fail("quick open supports name: scoped filter"); }
let qopen_path_editors = ide.quick_open_candidates(files, "path:editors", 10);
if len(qopen_path_editors) != 1 or qopen_path_editors[0].path != "editors/ide/pbide.sapp" { fail("quick open supports path: scoped filter"); }
let qopen_scoped_combo = ide.quick_open_candidates(files, "kind=file ext=sapp name=pbide path=editors", 10);
if len(qopen_scoped_combo) != 1 or qopen_scoped_combo[0].path != "editors/ide/pbide.sapp" { fail("quick open combines kind/ext/name/path filters"); }
let qopen_not_tests = ide.quick_open_candidates(files, "not:tests", 10);
if len(qopen_not_tests) != 3 or qopen_not_tests[0].path == "tests" or qopen_not_tests[1].path == "tests" or qopen_not_tests[2].path == "tests" { fail("quick open supports not: exclusion filters"); }
let qopen_exclude_docs = ide.quick_open_candidates(files, "exclude:docs", 10);
if len(qopen_exclude_docs) != 3 or qopen_exclude_docs[2].path == "docs/PB_IDE.md" { fail("quick open supports exclude: alias"); }
let qopen_exclude_combo = ide.quick_open_candidates(files, "kind=file not:pbide", 10);
if len(qopen_exclude_combo) != 1 or qopen_exclude_combo[0].name != "PB_IDE.md" { fail("quick open combines kind filter and exclusion filter"); }
let qopen_exclude_multi = ide.quick_open_candidates(files, "not:docs not:tests", 10);
if len(qopen_exclude_multi) != 2 or qopen_exclude_multi[0].path == "tests" or qopen_exclude_multi[1].path == "docs/PB_IDE.md" { fail("quick open supports multiple exclusions"); }
let qopen_multi_filter_combo = ide.quick_open_candidates(files, "kind=file pb ide not:docs", 10);
if len(qopen_multi_filter_combo) != 1 or qopen_multi_filter_combo[0].path != "editors/ide/pbide.sapp" { fail("quick open combines multi-word search with filters and exclusions"); }
let qopen_line_search = ide.quick_open_candidates(files, ide.quick_open_search_query("pbide:25:3"), 10);
if len(qopen_line_search) != 1 or qopen_line_search[0].path != "editors/ide/pbide.sapp" { fail("quick open search strips numeric line/col suffix for matching"); }
let qopen_line_token_search = ide.quick_open_candidates(files, ide.quick_open_search_query("kind=file pbide line:25 col:3"), 10);
if len(qopen_line_token_search) != 1 or qopen_line_token_search[0].path != "editors/ide/pbide.sapp" { fail("quick open search strips line/col tokens but keeps filters"); }
let qopen_keep_colon = ide.quick_open_search_query("data:latest");
if qopen_keep_colon != "data:latest" { fail("quick open search keeps nonnumeric colon queries"); }
let qopen_apply_target = ide.quick_open_apply_target("editors/ide/pbide.sapp", "pbide:25:3");
if qopen_apply_target != "editors/ide/pbide.sapp:25:3" { fail("quick open applies typed line/col target to selected hit"); }
let qopen_apply_line_tokens = ide.quick_open_apply_target("editors/ide/pbide.sapp", "kind=file pbide line=25 column=3");
if qopen_apply_line_tokens != "editors/ide/pbide.sapp:25:3" { fail("quick open applies line/column tokens to selected hit"); }
let qopen_apply_plain = ide.quick_open_apply_target("editors/ide/pbide.sapp", "pbide");
if qopen_apply_plain != "editors/ide/pbide.sapp" { fail("quick open leaves selected hit path unchanged without target suffix"); }
let qopen_target_label = ide.quick_open_target_label("pbide:25:3");
if not str_contains(qopen_target_label, "L25:C3") or not str_contains(qopen_target_label, "search 'pbide'") { fail("quick open target label explains line/column search"); }
let qopen_target_label_tokens = ide.quick_open_target_label("pbide line:25 col:3");
if not str_contains(qopen_target_label_tokens, "L25:C3") or not str_contains(qopen_target_label_tokens, "search 'pbide'") { fail("quick open target label explains line/column tokens"); }
let qopen_status = ide.quick_open_status("pbide", 0, qopen_pbide, "/repo", 2);
if not str_contains(qopen_status, "quick open: /repo") or not str_contains(qopen_status, "recent 2") or not str_contains(qopen_status, "results 1") or not str_contains(qopen_status, "sel 1/1") or not str_contains(qopen_status, "editors/ide/pbide.sapp") { fail("quick_open_status shows selected hit context"); }
let qopen_status_target = ide.quick_open_status("pbide:25:3", 0, qopen_line_search, "/repo", 2);
if not str_contains(qopen_status_target, "target L25:C3") or not str_contains(qopen_status_target, "search 'pbide'") or not str_contains(qopen_status_target, "opens editors/ide/pbide.sapp:25:3") { fail("quick_open_status shows selected line/column target"); }
let qopen_status_token_target = ide.quick_open_status("pbide line:25 col:3", 0, qopen_line_search, "/repo", 2);
if not str_contains(qopen_status_token_target, "target L25:C3") or not str_contains(qopen_status_token_target, "opens editors/ide/pbide.sapp:25:3") { fail("quick_open_status shows effective open path for line/column tokens"); }
let qopen_status_clamped = ide.quick_open_status("", 999, qopen_all, "/repo", 0);
if not str_contains(qopen_status_clamped, "sel 4/4") { fail("quick_open_status clamps selected row"); }
let qopen_status_empty = ide.quick_open_status("missing.sapp", 0, [], "/repo", 1);
if not str_contains(qopen_status_empty, "results 0") or not str_contains(qopen_status_empty, "Enter tries typed path") { fail("quick_open_status explains typed-path fallback"); }
let qopen_hint_empty = ide.quick_open_hint("");
if not str_contains(qopen_hint_empty, "kind:dir") or not str_contains(qopen_hint_empty, "kind=file") { fail("quick_open_hint teaches empty kind filters"); }
let qopen_hint_text = ide.quick_open_hint("pbide");
if not str_contains(qopen_hint_text, "multi-word search is AND") or not str_contains(qopen_hint_text, "kind:dir") or not str_contains(qopen_hint_text, "ext:sapp") or not str_contains(qopen_hint_text, "type:folder") or not str_contains(qopen_hint_text, "name:main") or not str_contains(qopen_hint_text, "path:src") { fail("quick_open_hint suggests scoped filters for text search"); }
let qopen_hint_target = ide.quick_open_hint("pbide:25:3");
if not str_contains(qopen_hint_target, "target L25:C3") or not str_contains(qopen_hint_target, "Enter opens selected file") { fail("quick_open_hint explains line/column target"); }
let qopen_hint_line_tokens = ide.quick_open_hint("pbide line:25 col:3");
if not str_contains(qopen_hint_line_tokens, "target L25:C3") or not str_contains(qopen_hint_line_tokens, "search 'pbide'") { fail("quick_open_hint explains line/column token target"); }
let qopen_hint_kind = ide.quick_open_hint("kind:dir");
if not str_contains(qopen_hint_kind, "kind dir active") { fail("quick_open_hint reports active kind"); }
let qopen_hint_combo = ide.quick_open_hint("type=file pbide");
if not str_contains(qopen_hint_combo, "kind file") or not str_contains(qopen_hint_combo, "pbide") { fail("quick_open_hint reports kind plus text"); }
let qopen_hint_ext = ide.quick_open_hint("ext:sapp");
if not str_contains(qopen_hint_ext, "ext sapp active") { fail("quick_open_hint reports active extension"); }
let qopen_hint_ext_combo = ide.quick_open_hint("kind=file ext=sapp pbide");
if not str_contains(qopen_hint_ext_combo, "kind file") or not str_contains(qopen_hint_ext_combo, "ext sapp") or not str_contains(qopen_hint_ext_combo, "pbide") { fail("quick_open_hint reports kind plus extension plus text"); }
let qopen_hint_scoped = ide.quick_open_hint("kind=file ext=sapp name=pbide path=editors");
if not str_contains(qopen_hint_scoped, "kind file") or not str_contains(qopen_hint_scoped, "ext sapp") or not str_contains(qopen_hint_scoped, "name pbide") or not str_contains(qopen_hint_scoped, "path editors") { fail("quick_open_hint reports scoped filters"); }
let qopen_hint_exclude = ide.quick_open_hint("kind=file not:tests exclude:docs pbide");
if not str_contains(qopen_hint_exclude, "kind file") or not str_contains(qopen_hint_exclude, "not tests/docs") or not str_contains(qopen_hint_exclude, "pbide") { fail("quick_open_hint reports exclusion filters"); }
let filter_examples = ide.file_filter_examples(3);
if len(filter_examples) != 3 or filter_examples[0] != "kind:dir" or filter_examples[2] != "ext:sapp" { fail("file_filter_examples returns stable examples"); }
let filter_examples_line = ide.file_filter_examples_line(6);
if not str_contains(filter_examples_line, "filters:") or not str_contains(filter_examples_line, "name:main") or not str_contains(filter_examples_line, "path:src") or not str_contains(filter_examples_line, "not:test") { fail("file_filter_examples_line formats visible examples"); }
let qopen_empty_msg = ide.quick_open_empty_message("ext:zig missing");
if not str_contains(qopen_empty_msg, "No match for `ext:zig missing`") or not str_contains(qopen_empty_msg, "Enter tries typed path") or not str_contains(qopen_empty_msg, "ext zig") { fail("quick_open_empty_message includes typed-path and filter guidance"); }
let files_status = ide.files_panel_status("ext:sapp", 0, qopen_ext_sapp, "/repo", "flat");
if not str_contains(files_status, "files flat: /repo") or not str_contains(files_status, "results 1") or not str_contains(files_status, "sel 1/1") or not str_contains(files_status, "editors/ide/pbide.sapp") { fail("files_panel_status shows selected file context"); }
let files_status_clamped = ide.files_panel_status("", 999, qopen_all, "/repo", "tree");
if not str_contains(files_status_clamped, "files tree") or not str_contains(files_status_clamped, "sel 4/4") { fail("files_panel_status clamps selected row"); }
let files_hint = ide.files_panel_hint("kind=file ext=sapp pbide");
if not str_contains(files_hint, "files filter: kind file") or not str_contains(files_hint, "ext sapp") or not str_contains(files_hint, "pbide") { fail("files_panel_hint reuses quick-open filter language"); }
let files_empty_msg = ide.files_panel_empty_message("kind=file ext=zig", "flat");
if not str_contains(files_empty_msg, "No matching files for `kind=file ext=zig`") or not str_contains(files_empty_msg, "files filter: kind file") or not str_contains(files_empty_msg, "ext zig") { fail("files_panel_empty_message includes filter guidance"); }
let files_recent_empty = ide.files_panel_empty_message("", "recent");
if not str_contains(files_recent_empty, "No recent files yet") or not str_contains(files_recent_empty, "files hint:") { fail("files_panel_empty_message handles recent mode"); }
let qopen_tree = ide.quick_open_candidates([
    map{ name: "child.sapp", path: "src/child.sapp", kind: "file", display: "  child.sapp" }
], "src", 10);
if len(qopen_tree) != 1 or qopen_tree[0].label != "  child.sapp" { fail("quick open preserves tree display labels"); }
let qopen_tree_order = ide.quick_open_candidates([
    map{ name: "root.sapp", path: "root.sapp", kind: "file", display: "root.sapp", tree: true },
    map{ name: "src", path: "src", kind: "dir", display: "src", tree: true }
], "", 10);
if qopen_tree_order[0].name != "root.sapp" { fail("quick open preserves tree row order"); }

// ── project roots / multi-root files panel helpers ───────────────────────────
let roots = ide.project_roots("/repo", "/repo/src/main.sapp", ["/repo", "/other"]);
if len(roots) != 3 or roots[0] != "/repo" or roots[1] != "/repo/src" or roots[2] != "/other" { fail("project_roots dedupes cwd/file/extras"); }
if ide.project_root_index(roots, "/other") != 2 { fail("project_root_index finds current root"); }
let cyc = ide.project_root_cycle(roots, "/other", 1);
if cyc.index != 0 or cyc.path != "/repo" { fail("project_root_cycle wraps forward"); }
let cyc2 = ide.project_root_cycle(roots, "/repo", 0 - 1);
if cyc2.index != 2 or cyc2.path != "/other" { fail("project_root_cycle wraps backward"); }
let tree_settings = ide.project_tree_settings(20, 999999);
if tree_settings.depth != 8 or tree_settings.max_items != 5000 { fail("project_tree_settings clamps high values"); }
let tree_settings_low = ide.project_tree_settings(0, 1);
if tree_settings_low.depth != 1 or tree_settings_low.max_items != 50 { fail("project_tree_settings clamps low values"); }
if ide.project_tree_depth_delta(3, 1) != 4 or ide.project_tree_depth_delta(1, 0 - 5) != 1 { fail("project_tree_depth_delta adjusts and clamps depth"); }
let recent = ide.recent_files_push(["/repo/old.sapp", "/repo/main.sapp"], "/repo/main.sapp", 5);
if len(recent) != 2 or recent[0] != "/repo/main.sapp" or recent[1] != "/repo/old.sapp" { fail("recent_files_push dedupes newest first"); }
let recent_limited = ide.recent_files_push(["a", "b", "c"], "d", 2);
if len(recent_limited) != 2 or recent_limited[0] != "d" or recent_limited[1] != "a" { fail("recent_files_push obeys limit"); }
let recent_removed = ide.recent_files_remove(recent, "/repo/main.sapp");
if len(recent_removed) != 1 or recent_removed[0] != "/repo/old.sapp" { fail("recent_files_remove removes by path"); }
let recent_remove_missing = ide.recent_files_remove(recent, "/repo/missing.sapp");
if len(recent_remove_missing) != 2 { fail("recent_files_remove keeps list when path missing"); }
let recent_entries = ide.recent_files_entries(recent, 10);
if len(recent_entries) != 2 or recent_entries[0].name != "main.sapp" or recent_entries[0].display != "[recent] main.sapp" { fail("recent_files_entries builds display rows"); }
let recent_hits = ide.quick_open_candidates(recent_entries, "old", 10);
if len(recent_hits) != 1 or recent_hits[0].path != "/repo/old.sapp" { fail("recent file entries work with quick-open filtering"); }
let qopen_recent = ide.quick_open_with_recent(files, ["/repo/recent.sapp", "editors/ide/pbide.sapp"], "", 10);
if len(qopen_recent) < 4 or qopen_recent[0].label != "[recent] recent.sapp" { fail("quick_open_with_recent prepends recent files"); }
let dup_count = 0;
let qi = 0;
while qi < len(qopen_recent) {
    if qopen_recent[qi].path == "editors/ide/pbide.sapp" { dup_count = dup_count + 1; }
    qi = qi + 1;
}
if dup_count != 1 { fail("quick_open_with_recent dedupes normal/recent paths"); }
let qopen_recent_filter = ide.quick_open_with_recent(files, ["/repo/recent.sapp"], "stdlib", 10);
if len(qopen_recent_filter) < 1 or qopen_recent_filter[0].kind != "dir" or qopen_recent_filter[0].path != "stdlib" { fail("quick_open_with_recent falls back to directory hits"); }

// ── diagnostics ────────────────────────────────────────────────────────────────
let bad_code = "let x = missing;\nprint x;\n";
let nd = ide.normalize_diagnostic(bad_code, map{ kind: "error", message: "undefined name 'missing'" }, 0);
if nd.kind != "error" or nd.line != 1 { fail("diagnostic infers undefined-name line"); }
if nd.col != 9 { fail("diagnostic infers undefined-name column (got " + str(nd.col) + ")"); }
if not str_contains(nd.source, "missing") { fail("diagnostic includes source line"); }
let ndiags = ide.normalize_diagnostics(bad_code, [map{ kind: "warning", message: "unreachable code after return", line: 2 }]);
if len(ndiags) != 1 or ndiags[0].line != 2 { fail("normalize_diagnostics keeps explicit line"); }
let ds = ide.diagnostic_summary([nd], 5);
if not str_contains(ds[0], "ERROR L1:C9") { fail("diagnostic summary includes location"); }
if len(ide.diagnostic_summary([], 5)) != 1 { fail("empty diagnostic summary is helpful"); }
let mixed_diags = [nd, map{ kind: "warning", message: "second issue", line: 1, col: 1 }, map{ kind: "info", message: "note", line: 2, col: 1 }];
let dcounts = ide.diagnostic_counts(mixed_diags);
if dcounts.total != 3 or dcounts.errors != 1 or dcounts.warnings != 1 or dcounts.info != 1 { fail("diagnostic_counts groups severities"); }
let dlabel = ide.diagnostic_counts_label(mixed_diags);
if not str_contains(dlabel, "1 error") or not str_contains(dlabel, "1 warning") or not str_contains(dlabel, "1 info") { fail("diagnostic_counts_label summarizes mixed severities"); }
if ide.diagnostic_counts_label([]) != "diagnostics: clean" { fail("diagnostic_counts_label handles clean state"); }
let filtered_error = ide.filter_diagnostics(mixed_diags, "error", 10);
if len(filtered_error) != 1 or filtered_error[0].index != 0 or filtered_error[0].kind != "error" { fail("filter_diagnostics filters severity and preserves original index"); }
let filtered_source = ide.filter_diagnostics(mixed_diags, "let x", 10);
if len(filtered_source) != 1 or filtered_source[0].index != 0 { fail("filter_diagnostics matches source text"); }
let filtered_loc = ide.filter_diagnostics(mixed_diags, "l2", 10);
if len(filtered_loc) != 1 or filtered_loc[0].index != 2 { fail("filter_diagnostics matches line token"); }
let filtered_limited = ide.filter_diagnostics(mixed_diags, "", 2);
if len(filtered_limited) != 2 { fail("filter_diagnostics obeys limit"); }
let filter_status = ide.diagnostic_filter_status(mixed_diags, "warning", 0);
if not str_contains(filter_status, "1/3") or not str_contains(filter_status, "sel 1/1") { fail("diagnostic_filter_status shows filtered count and selection"); }
let filter_all = ide.diagnostic_filter_status(mixed_diags, "", 99);
if not str_contains(filter_all, "all 3") or not str_contains(filter_all, "sel 3/3") { fail("diagnostic_filter_status clamps selected index"); }
let filter_none = ide.diagnostic_filter_status(mixed_diags, "nomatch", 0);
if not str_contains(filter_none, "0/3") or str_contains(filter_none, "sel") { fail("diagnostic_filter_status handles empty hits"); }
if ide.selection_move(2, 5, "home", 10) != 0 { fail("selection_move home"); }
if ide.selection_move(2, 5, "end", 10) != 4 { fail("selection_move end"); }
if ide.selection_move(4, 5, "next", 10) != 4 { fail("selection_move clamps next"); }
if ide.selection_move(0, 5, "previous", 10) != 0 { fail("selection_move clamps previous"); }
if ide.selection_move(1, 20, "page_down", 10) != 11 { fail("selection_move page down"); }
if ide.selection_move(5, 20, "page_up", 10) != 0 { fail("selection_move page up clamps"); }
let line_hits = ide.diagnostics_at_line([nd, map{ kind: "warning", message: "second issue", line: 1, col: 1 }], 1);
if len(line_hits) != 2 or line_hits[0].kind != "error" { fail("diagnostics_at_line filters current line"); }
if len(ide.diagnostics_at_line([nd], 2)) != 0 { fail("diagnostics_at_line ignores other lines"); }
let line_status = ide.diagnostic_line_status([nd, map{ kind: "warning", message: "second issue", line: 1, col: 1 }], 1);
if not str_contains(line_status, "line error:") or not str_contains(line_status, "missing") or not str_contains(line_status, "+1") { fail("diagnostic_line_status summarizes caret line issues"); }
if ide.diagnostic_line_status([nd], 2) != "" { fail("diagnostic_line_status stays quiet on clean line"); }
let line_marker = ide.diagnostic_line_marker([map{ kind: "warning", message: "warn", line: 1 }, nd], 1);
if line_marker.marker != "E" or line_marker.severity != "error" or line_marker.count != 2 or not str_contains(line_marker.label, "x2") { fail("diagnostic_line_marker gives error precedence and count"); }
let warn_marker = ide.diagnostic_line_marker([map{ kind: "warning", message: "warn", line: 2 }], 2);
if warn_marker.marker != "W" or warn_marker.severity != "warning" { fail("diagnostic_line_marker handles warning"); }
if ide.diagnostic_line_marker([nd], 2).marker != "" { fail("diagnostic_line_marker stays empty on clean line"); }
let detail_lines = ide.diagnostic_detail_lines(nd, 3);
if len(detail_lines) != 3 or not str_contains(detail_lines[0], "ERROR L1:C9") or not str_contains(detail_lines[1], "missing") or not str_contains(detail_lines[2], "source:") { fail("diagnostic_detail_lines shows location, message, source"); }
let detail_nil = ide.diagnostic_detail_lines(nil, 3);
if len(detail_nil) != 1 or not str_contains(detail_nil[0], "No diagnostic") { fail("diagnostic_detail_lines handles empty selection"); }

// ── status_text ──────────────────────────────────────────────────────────────
let st = ide.status_text(map{ path: "demo.sapp", modified: true, line: 12, col: 5, lines: 40 });
if not str_contains(st, "demo.sapp *") { fail("status shows modified marker"); }
if not str_contains(st, "Ln 12, Col 5") { fail("status shows line/col"); }
if not str_contains(st, "40 lines") { fail("status shows line count"); }
let st2 = ide.status_text(map{ path: "demo.sapp", modified: false, line: 1, col: 2, lines: 3, chars: 22, diagnostics: 4, selection_chars: 5 });
if not str_contains(st2, "22 chars") { fail("status shows char count"); }
if not str_contains(st2, "diagnostics: 4") { fail("status shows diagnostic count"); }
if not str_contains(st2, "sel 5 chars") { fail("status shows selection count"); }
let gt = ide.goto_line_target("12", 40);
if gt.line != 12 or gt.row != 11 or gt.col != 0 { fail("goto_line_target returns 1-based line and 0-based row"); }
let gt_low = ide.goto_line_target("0", 40);
if gt_low.line != 1 or gt_low.row != 0 { fail("goto_line_target clamps low values"); }
let gt_high = ide.goto_line_target("999", 40);
if gt_high.line != 40 or gt_high.row != 39 { fail("goto_line_target clamps high values"); }
let gt_bad = ide.goto_line_target("not a number", 40);
if gt_bad.line != 1 { fail("goto_line_target defaults invalid input to line 1"); }
let opt_plain = ide.open_path_target("src/main.sapp");
if opt_plain.path != "src/main.sapp" or opt_plain.has_line { fail("open_path_target keeps plain paths"); }
let opt_line = ide.open_path_target("src/main.sapp:12");
if opt_line.path != "src/main.sapp" or opt_line.line != 12 or opt_line.col != 1 or not opt_line.has_line or opt_line.has_col { fail("open_path_target parses path:line"); }
let opt_col = ide.open_path_target("src/main.sapp:12:4");
if opt_col.path != "src/main.sapp" or opt_col.line != 12 or opt_col.col != 4 or not opt_col.has_line or not opt_col.has_col { fail("open_path_target parses path:line:col"); }
let opt_win = ide.open_path_target("C:/repo/main.sapp:7:2");
if opt_win.path != "C:/repo/main.sapp" or opt_win.line != 7 or opt_win.col != 2 { fail("open_path_target keeps drive-like colon paths"); }
let opt_text = ide.open_path_target("src/data:latest.sapp");
if opt_text.path != "src/data:latest.sapp" or opt_text.has_line { fail("open_path_target ignores nonnumeric suffixes"); }
let opt_status = ide.open_path_target_status(opt_col);
if opt_status != "src/main.sapp:12:4" { fail("open_path_target_status formats target"); }
let loc1 = map{ path: "demo.sapp", line: 2, col: 1, label: "start" };
let loc2 = map{ path: "demo.sapp", line: 8, col: 4, label: "jump" };
let nav_stack = ide.navigation_push([], loc1, 10);
let nav_stack2 = ide.navigation_push(nav_stack, loc1, 10);
if len(nav_stack2) != 1 { fail("navigation_push suppresses duplicate top location"); }
let nav_stack3 = ide.navigation_push(nav_stack2, loc2, 10);
if len(nav_stack3) != 2 or nav_stack3[0].line != 8 { fail("navigation_push adds newest first"); }
let nav_step = ide.navigation_step(nav_stack3, [], map{ path: "demo.sapp", line: 12, col: 1 }, 10);
if not nav_step.ok or nav_step.target.line != 8 or len(nav_step.source) != 1 or len(nav_step.other) != 1 { fail("navigation_step moves target and current between stacks"); }
let nav_empty = ide.navigation_step([], [], loc1, 10);
if nav_empty.ok { fail("navigation_step reports empty source"); }

// ── history records ───────────────────────────────────────────────────────────────
let hist = [];
hist = ide.push_history(hist, "run", true, "run: ok\n> 3", "print 3;", 2);
hist = ide.push_history(hist, "check", false, "check: 1 problem(s)", "let x = missing;", 2);
hist = ide.push_history(hist, "run", true, "run: ok\n> newest", "print \"newest\";", 2);
if len(hist) != 2 { fail("history is bounded to limit"); }
if hist[0].action != "run" or not hist[0].ok { fail("newest history record first"); }
if hist[1].action != "check" or hist[1].ok { fail("older failed check retained"); }
let hs = ide.history_summary(hist, 10);
if len(hs) != 2 { fail("history_summary emits rows"); }
if not str_contains(hs[0], "RUN OK") { fail("history summary shows action/status"); }
if not str_contains(hs[1], "CHECK FAIL") { fail("history summary shows failure"); }
if len(ide.history_summary([], 10)) < 2 { fail("empty history has helpful placeholder lines"); }
let hf_run = ide.filter_history(hist, "run", 10);
if len(hf_run) != 1 or hf_run[0].index != 0 or hf_run[0].action != "run" { fail("filter_history filters action and preserves original index"); }
let hf_fail = ide.filter_history(hist, "fail", 10);
if len(hf_fail) != 1 or hf_fail[0].index != 1 or hf_fail[0].action != "check" { fail("filter_history filters status"); }
let hf_code = ide.filter_history(hist, "missing", 10);
if len(hf_code) != 1 or hf_code[0].index != 1 { fail("filter_history searches code/output text"); }
let hf_limited = ide.filter_history(hist, "", 1);
if len(hf_limited) != 1 { fail("filter_history obeys limit"); }
let hfs = ide.history_filter_status(hist, "run", 0);
if not str_contains(hfs, "1/2") or not str_contains(hfs, "sel 1/1") { fail("history_filter_status shows filtered count"); }
let hfs_all = ide.history_filter_status(hist, "", 99);
if not str_contains(hfs_all, "all 2") or not str_contains(hfs_all, "sel 2/2") { fail("history_filter_status clamps selected"); }
let hfs_none = ide.history_filter_status(hist, "nomatch", 0);
if not str_contains(hfs_none, "0/2") or str_contains(hfs_none, "sel") { fail("history_filter_status handles empty matches"); }

// ── terminal command history helpers ─────────────────────────────────────────
let th = [];
th = ide.terminal_history_push(th, "ls", 3);
th = ide.terminal_history_push(th, "pwd", 3);
th = ide.terminal_history_push(th, "ls", 3);
if len(th) != 2 or th[0] != "ls" or th[1] != "pwd" { fail("terminal_history_push dedupes newest first"); }
th = ide.terminal_history_push(th, "echo hi", 2);
if len(th) != 2 or th[0] != "echo hi" or th[1] != "ls" { fail("terminal_history_push obeys limit"); }
let tm_up = ide.terminal_history_move(th, len(th), "up", "", "draft command");
if tm_up.pos != 0 or tm_up.input != "echo hi" or tm_up.draft != "draft command" or not tm_up.active { fail("terminal_history_move up recalls newest and saves draft"); }
let tm_older = ide.terminal_history_move(th, tm_up.pos, "up", tm_up.draft, tm_up.input);
if tm_older.pos != 1 or tm_older.input != "ls" { fail("terminal_history_move up walks older commands"); }
let tm_newer = ide.terminal_history_move(th, tm_older.pos, "down", tm_older.draft, tm_older.input);
if tm_newer.pos != 0 or tm_newer.input != "echo hi" { fail("terminal_history_move down walks newer commands"); }
let tm_draft = ide.terminal_history_move(th, tm_newer.pos, "down", tm_newer.draft, tm_newer.input);
if tm_draft.pos != len(th) or tm_draft.input != "draft command" or tm_draft.active { fail("terminal_history_move down restores draft"); }
let ths = ide.terminal_history_status(th, 0);
if not str_contains(ths, "2 command") or not str_contains(ths, "sel 1/2") { fail("terminal_history_status shows selection"); }
if not str_contains(ide.terminal_history_status(th, len(th)), "draft") { fail("terminal_history_status shows draft state"); }

// ── AI prompt history helpers ────────────────────────────────────────────────
let ah = [];
ah = ide.ai_prompt_history_push(ah, "explain loops", 3);
ah = ide.ai_prompt_history_push(ah, "find bugs", 3);
ah = ide.ai_prompt_history_push(ah, "explain loops", 3);
if len(ah) != 2 or ah[0] != "explain loops" or ah[1] != "find bugs" { fail("ai_prompt_history_push dedupes newest first"); }
ah = ide.ai_prompt_history_push(ah, "improve this", 2);
if len(ah) != 2 or ah[0] != "improve this" or ah[1] != "explain loops" { fail("ai_prompt_history_push obeys limit"); }
let am_up = ide.ai_prompt_history_move(ah, len(ah), "up", "", "draft prompt");
if am_up.pos != 0 or am_up.input != "improve this" or am_up.draft != "draft prompt" or not am_up.active { fail("ai_prompt_history_move up recalls newest and saves draft"); }
let am_old = ide.ai_prompt_history_move(ah, am_up.pos, "up", am_up.draft, am_up.input);
if am_old.pos != 1 or am_old.input != "explain loops" { fail("ai_prompt_history_move walks older prompts"); }
let am_draft = ide.ai_prompt_history_move(ah, 0, "down", am_up.draft, am_up.input);
if am_draft.pos != len(ah) or am_draft.input != "draft prompt" or am_draft.active { fail("ai_prompt_history_move restores draft"); }
let ahs = ide.ai_prompt_history_status(ah, 0);
if not str_contains(ahs, "2 saved") or not str_contains(ahs, "sel 1/2") { fail("ai_prompt_history_status shows selection"); }
if not str_contains(ide.ai_prompt_history_status(ah, len(ah)), "draft") { fail("ai_prompt_history_status shows draft state"); }

// ── Designer status helpers ─────────────────────────────────────────────────
let dstatus_empty = ide.designer_status(map{ target: "gui", layout: "free", tool: "button", widgets: [], sel: 0 - 1 });
if not str_contains(dstatus_empty, "app gui") or not str_contains(dstatus_empty, "tool button") or not str_contains(dstatus_empty, "no selection") { fail("designer_status handles empty canvas"); }
let dstatus_sel = ide.designer_status(map{
    target: "both",
    layout: "grid",
    tool: "cube3d",
    sel: 0,
    widgets: [map{ kind: "cube", name: "cube1", x: 10, y: 20, w: 72, h: 72 }]
});
if not str_contains(dstatus_sel, "app both") or not str_contains(dstatus_sel, "layout grid") or not str_contains(dstatus_sel, "sel 1/1 cube cube1 @ 10,20 72x72") { fail("designer_status summarizes selected widget"); }

// ── build profiles + IDE watcher state ───────────────────────────────────────
let dbg = ide.build_profile("debug");
if dbg.mode != "debug" or dbg.lint_before_run != true { fail("debug profile checks before run"); }
let rel = ide.build_profile("release");
if rel.mode != "release" or rel.lint_before_run != false or rel.optimize != "speed" { fail("release profile is fast run mode"); }
if ide.next_build_mode("debug") != "release" or ide.next_build_mode("release") != "debug" { fail("build mode toggles"); }
if not str_contains(ide.build_mode_summary("debug"), "Debug") { fail("build mode summary names mode"); }

let w = ide.watcher_new("demo.sapp", code);
if w.revision != 0 or w.dirty != false or w.symbols != 4 { fail("watcher_new captures clean code state"); }
if len(w.events) != 1 or not str_contains(w.events[0], "watcher initialized") { fail("watcher_new starts event log"); }
if w.diagnostics_state != "unchecked" or w.diagnostics_stale != false { fail("watcher_new starts with unchecked diagnostics"); }
let woff = ide.watcher_action(nil);
if woff.severity != "off" or woff.command != "watch" { fail("watcher_action handles disabled watcher"); }
if ide.watcher_badge(nil) != "watch off" { fail("watcher_badge handles disabled watcher"); }
let wunchecked = ide.watcher_action(w);
if wunchecked.severity != "info" or wunchecked.command != "check" { fail("watcher_action recommends check before diagnostics exist"); }
if ide.watcher_badge(w) != "watch unchecked" { fail("watcher_badge marks unchecked diagnostics"); }
let wc = ide.watcher_update(w, "demo.sapp", code, false, [], "check");
if wc.diagnostics_state != "fresh" or wc.diagnostics_stale != false { fail("watcher_check marks diagnostics fresh"); }
let wc_action = ide.watcher_action(wc);
if wc_action.severity != "ok" or wc_action.command != "none" { fail("watcher_action reports clean fresh buffer ok"); }
if ide.watcher_badge(wc) != "watch ok" { fail("watcher_badge marks clean fresh state"); }
let w2 = ide.watcher_update(wc, "demo.sapp", code + "\nprint x;\n", true, [nd], "type");
if w2.revision != 1 or w2.dirty != true or w2.diagnostics != 1 { fail("watcher_update tracks changed dirty diagnostics"); }
if w2.line_delta <= 0 or w2.diagnostic_delta != 1 { fail("watcher_update records deltas"); }
if w2.diagnostics_state != "stale" or w2.diagnostics_stale != true { fail("watcher marks diagnostics stale after edit"); }
if len(w2.events) < 2 or not str_contains(w2.events[0], "type changed") { fail("watcher_update records newest event"); }
let ws = ide.watcher_summary(w2);
if not str_contains(ws, "watch: on") or not str_contains(ws, "diagnostics 1 stale") or not str_contains(ws, "last type") { fail("watcher_summary is readable"); }
let wa = ide.watcher_action(w2);
if wa.severity != "warn" or wa.command != "check" or not str_contains(wa.message, "F6 Check") { fail("watcher_action recommends check for stale diagnostics"); }
if ide.watcher_badge(w2) != "watch stale" { fail("watcher_badge marks stale diagnostics"); }
let health_stale = ide.ide_health_line(w2, "debug", ui_snap);
if not str_contains(health_stale, "health WARN") or not str_contains(health_stale, "Debug") or not str_contains(health_stale, "watch stale") or not str_contains(health_stale, "ui 100/100") { fail("ide_health_line summarizes stale watcher and ui quality"); }
let health_off = ide.ide_health_line(nil, "release", nil);
if not str_contains(health_off, "health OFF") or not str_contains(health_off, "Release") or not str_contains(health_off, "watch off") or not str_contains(health_off, "ui ?") { fail("ide_health_line handles disabled watcher"); }
let health_ui_warn = ide.ide_health_line(wc, "debug", bad_ui);
if not str_contains(health_ui_warn, "health WARN") or not str_contains(health_ui_warn, "issue(s)") { fail("ide_health_line promotes ui observer issues"); }
let wl = ide.watcher_lines(w2, 4);
if len(wl) != 4 or not str_contains(wl[1], "action: diagnostics stale") { fail("watcher_lines exposes action row"); }
if not str_contains(wl[2], "type changed") or not str_contains(wl[2], "diagnostics stale") { fail("watcher_lines exposes event log"); }
let before_events = len(w2.events);
let before_last = w2.last_event;
let w3 = ide.watcher_update(w2, "demo.sapp", code + "\nprint x;\n", true, [nd], "draw");
if len(w3.events) != before_events or w3.last_event != before_last { fail("watcher draw refresh does not spam unchanged events"); }
let w4 = ide.watcher_update(w3, "demo.sapp", code + "\nprint x;\n", true, [nd], "check");
if w4.diagnostics_state != "fresh" or w4.diagnostics_stale != false { fail("watcher check refresh clears stale diagnostics"); }
let wa4 = ide.watcher_action(w4);
if wa4.severity != "error" or wa4.command != "diagnostic_next" { fail("watcher_action points to diagnostics when fresh issues remain"); }
if ide.watcher_badge(w4) != "watch err 1" { fail("watcher_badge marks fresh diagnostics count"); }

print "ide_features_pass";
