if db_restore_ro.ok != false or db_restore_ro.destructive != true or not str_contains(str_join(db_restore_ro.requires, ","), "backup before mutation") { fail("database_action_plan blocks destructive readonly profile"); }
let mgmt = ide.management_records(map{ database_status: db_state.status, database_detail: db_state.summary, history_status: hstate_saved.status, history_detail: "history saved", browser_status: bstate.route, browser_detail: ide.browser_management_summary(bstate), browser_data_status: bstate.status, browser_data_detail: "bookmarks 1 downloads 1", asset_status: "planned", asset_detail: "asset backend: document decode planned / export planned", graphics_status: "sdl2/gpu-assisted-texture-present", graphics_detail: "gfx sdl2 gpu-present · events pblang.graphics.events.v1 [resize,mouse-xy,scroll] · route cpu-raster-gpu-present device cpu+gpu-present", runtime_budget: map{ status: "active", detail: "bounded child-app time workers output frames" }, project_portfolio: portfolio_board, project_product_health: product_health_board, project_action: action_board, project_category_health: category_health_board, project_aap_status: map{ status: "on-demand", detail: "bounded AAP status" }, project_improvement: project_board, project_gaps: gap_board, project_text_audit: text_audit_board });
if len(mgmt) < 17 or mgmt[0].id != "database" or mgmt[1].id != "history" or mgmt[4].id != "browser_data" or mgmt[5].id != "asset_backends" or mgmt[len(mgmt) - 1].id != "project_text_audit" { fail("management_records exposes database, history, browser data, asset backend, graphics, runtime budgets, ecosystem health, AAP status, portfolio action, project improvement, and text audit areas"); }
