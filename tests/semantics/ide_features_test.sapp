if upload_plan.ok != true or upload_plan.read_only != false or upload_plan.destructive != false or not str_contains(str_join(upload_plan.requires, ","), "remote profile") { fail("file_explorer_operation_plan describes non-destructive upload requirements"); }
let inspect_plan = ide.file_explorer_operation_plan("inspect", "/repo/manual.pdf", "");
