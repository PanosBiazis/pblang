// tests/semantics/ide_features_test.sapp
// Web-IDE-style editor features (outline, find-all, find&replace, status bar) as pure logic.
let ide = import("stdlib:ide_features.sapp");
let uio = import("stdlib:ui_observer.sapp");

fn fail(m) { throw "FAIL " + m; }

fn preset_has_item(preset, name, text) {
    let items = try preset.items catch [];
    let i = 0;
    while i < len(items) {
        let it = items[i];
        if str(try it.name catch "") == name {
            if text == nil or text == "" or str(try it.text catch "") == text {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

let code = "let x = 1;\nfn add(a, b) {\n    return a + b;\n}\nconst PI = 3;\nexport add, x;\n";

// ── outline ──────────────────────────────────────────────────────────────────
let o = ide.outline(code);
if len(o) != 4 { fail("outline should find 4 symbols (got " + str(len(o)) + ")"); }
if o[0].kind != "let" or o[0].name != "x" or o[0].line != 1 { fail("outline let x line 1"); }
if o[1].kind != "fn" or o[1].name != "add" or o[1].line != 2 { fail("outline fn add line 2"); }
if o[2].kind != "const" or o[2].name != "PI" { fail("outline const PI"); }
if o[3].kind != "export" { fail("outline export"); }
let of = ide.filter_outline(code, "add", 10);
if len(of) != 2 or of[0].kind != "fn" or of[1].kind != "export" { fail("filter_outline finds matching symbols"); }
let of_limited = ide.filter_outline(code, "", 2);
if len(of_limited) != 2 { fail("filter_outline obeys limit"); }
let ofs = ide.outline_filter_status(code, "add", 0);
if not str_contains(ofs, "2/4") or not str_contains(ofs, "sel 1/2") { fail("outline_filter_status shows filtered count"); }
let ofs_all = ide.outline_filter_status(code, "", 99);
if not str_contains(ofs_all, "all 4") or not str_contains(ofs_all, "sel 4/4") { fail("outline_filter_status clamps selected"); }
let ofs_none = ide.outline_filter_status(code, "missing", 0);
if not str_contains(ofs_none, "0/4") or str_contains(ofs_none, "sel") { fail("outline_filter_status handles empty hits"); }
let ranges = ide.outline_ranges(code);
if len(ranges) != 4 { fail("outline_ranges mirrors outline count"); }
if ranges[1].kind != "fn" or ranges[1].line != 2 or ranges[1].end_line != 4 or ranges[1].lines != 3 { fail("outline_ranges computes function span"); }
if not str_contains(ranges[1].label, "fn add L2-L4") { fail("outline_ranges labels spans"); }
let of_range = ide.filter_outline(code, "4", 10);
if len(of_range) < 1 or of_range[0].end_line != 4 { fail("filter_outline can match symbol ranges"); }
let sym0 = ide.current_symbol(code, 0);
if sym0.kind != "file" or sym0.label != "top-level" { fail("current_symbol handles before first symbol"); }
let sym_fn = ide.current_symbol(code, 3);
if sym_fn.kind != "fn" or sym_fn.name != "add" or sym_fn.end_line != 4 or not str_contains(sym_fn.label, "fn add L2-L4") { fail("current_symbol finds enclosing function span"); }
let sym_export = ide.current_symbol(code, 99);
if sym_export.kind != "export" or sym_export.line != 6 { fail("current_symbol picks nearest previous symbol"); }

// ── find_all ─────────────────────────────────────────────────────────────────
let hits = ide.find_all(code, "a");
if len(hits) < 3 { fail("find_all should find multiple 'a' (got " + str(len(hits)) + ")"); }
if hits[0].line != 2 { fail("first 'a' is on line 2 (fn add)"); }
if len(ide.find_all(code, "zzz")) != 0 { fail("find_all of missing -> empty"); }
if len(ide.find_all(code, "")) != 0 { fail("find_all of empty query -> empty"); }
// two matches on one line
let two = ide.find_all("aa bb aa", "aa");
if len(two) != 2 or two[0].col != 1 or two[1].col != 7 { fail("find_all two-per-line cols"); }
let fs = ide.find_status(code, "add", false, "find", "");
if not str_contains(fs, "2 matches") or not str_contains(fs, "Enter=next") { fail("find_status shows count and next hint"); }
let fs0 = ide.find_status(code, "missing", false, "find", "");
if not str_contains(fs0, "0 matches") { fail("find_status shows zero matches"); }
let rs = ide.find_status(code, "add", true, "replace", "sum");
if not str_contains(rs, "REPLACE [replace]") or not str_contains(rs, "2 matches") or not str_contains(rs, "sum") { fail("replace find_status shows focus/count/replacement"); }
let fps = ide.find_position_status(code, "add", 2, 4);
if not str_contains(fps, "match 1/2") or not str_contains(fps, "L2:C4") { fail("find_position_status reports exact match ordinal"); }
let fps2 = ide.find_position_status(code, "add", 6, 8);
if not str_contains(fps2, "match 2/2") or not str_contains(fps2, "L6:C8") { fail("find_position_status reports later exact match"); }
let fps_near = ide.find_position_status(code, "add", 5, 1);
if not str_contains(fps_near, "match 1/2") { fail("find_position_status keeps nearest previous match before target"); }
let fps0 = ide.find_position_status(code, "missing", 1, 1);
if fps0 != "match 0/0" { fail("find_position_status handles no matches"); }

// ── replace_all ──────────────────────────────────────────────────────────────
let r = ide.replace_all(code, "add", "sum");
if r.count != 2 { fail("replace_all count (got " + str(r.count) + ")"); }
if str_contains(r.code, "fn add") { fail("replace_all should have replaced 'add'"); }
if not str_contains(r.code, "fn sum") { fail("replace_all should produce 'fn sum'"); }
if ide.replace_all(code, "", "x").count != 0 { fail("replace empty find -> no-op"); }
// multi-line find: count must equal what str_replace_all actually replaces (was reported as 0 while
// still editing the text — the status overlay would lie "0 matches"). Regression guard.
let ml = ide.replace_all("foo\nbar\nfoo\nbar", "foo\nbar", "Z");
if ml.count != 2 { fail("replace_all multi-line count (got " + str(ml.count) + ", want 2)"); }
if ml.code != "Z\nZ" { fail("replace_all multi-line result (got '" + ml.code + "')"); }

// ── examples catalog filtering ─────────────────────────────────────────────────
let catalog = [
    map{ title: "Hello + math", code: "print 1 + 1;" },
    map{ title: "Arrays + loops", code: "for x in [1, 2] { print x; }" },
    map{ title: "Maps + branches", code: "let user = map{ name: \"Ada\" };" },
    map{ title: "Safe calculator", code: "print \"calc\";", main_path: "examples/safe_calculator/main.sapp", run_path: "examples/safe_calculator/gui.sapp", project_root: "examples/safe_calculator", files: ["examples/safe_calculator/main.sapp", "examples/safe_calculator/lib.sapp", "examples/safe_calculator/gui.sapp", "examples/safe_calculator/README.md"] },
    map{ title: "Code Designer Browser starter", code: "print \"composite\";", main_path: "examples/fullstack_designer_browser/main.sapp", project_root: "examples/fullstack_designer_browser", browser_urls: ["example.com", "https://www.iana.org/domains/example"], files: ["examples/fullstack_designer_browser/main.sapp", "examples/fullstack_designer_browser/web.sapp"] },
];
let all_ex = ide.filter_examples(catalog, "", 10);
if len(all_ex) != 5 { fail("empty examples query returns all examples"); }
let loop_ex = ide.filter_examples(catalog, "LOOP", 10);
if len(loop_ex) != 1 or loop_ex[0].index != 1 { fail("examples filter matches title case-insensitively"); }
let code_ex = ide.filter_examples(catalog, "ada", 10);
if len(code_ex) != 1 or code_ex[0].index != 2 { fail("examples filter matches code case-insensitively"); }
let path_ex = ide.filter_examples(catalog, "gui.sapp", 10);
if len(path_ex) != 1 or path_ex[0].index != 3 { fail("examples filter matches project file paths"); }
let root_ex = ide.filter_examples(catalog, "safe_calculator", 10);
if len(root_ex) != 1 or root_ex[0].index != 3 { fail("examples filter matches project roots"); }
let browser_ex = ide.filter_examples(catalog, "iana.org", 10);
if len(browser_ex) != 1 or browser_ex[0].index != 4 { fail("examples filter matches browser URLs"); }
let limited_ex = ide.filter_examples(catalog, "", 2);
if len(limited_ex) != 2 { fail("examples filter obeys limit"); }
let ex_status = ide.examples_filter_status(catalog, "loop", 0);
if not str_contains(ex_status, "1/5") or not str_contains(ex_status, "sel 1/1") { fail("examples_filter_status shows filtered count"); }
let ex_status_all = ide.examples_filter_status(catalog, "", 99);
if not str_contains(ex_status_all, "all 5") or not str_contains(ex_status_all, "sel 5/5") { fail("examples_filter_status clamps selected"); }
let ex_status_none = ide.examples_filter_status(catalog, "missing", 0);
if not str_contains(ex_status_none, "0/5") or str_contains(ex_status_none, "sel") { fail("examples_filter_status handles empty matches"); }

// ── Designer project screen tabs ─────────────────────────────────────────────
let screen_tabs = ide.designer_screen_tabs_from_files([
    "app/main.sapp",
    "app/screens/login.sapp",
    "app/screens/settings_page.sapp",
    "app/lib.sapp",
    "README.md",
    "app/screens/login.sapp"
], "app/screens/settings_page.sapp");
if len(screen_tabs) != 4 { fail("designer screen tabs include unique pblang source files only"); }
if screen_tabs[0].kind != "entry" or screen_tabs[1].kind != "screen" or screen_tabs[2].kind != "screen" or screen_tabs[3].kind != "source" { fail("designer screen tabs classify entry/screen/source files"); }
if screen_tabs[2].title != "settings_page" or not (try screen_tabs[2].active catch false) { fail("designer screen tabs mark active screen path"); }
let scratch_tabs = ide.designer_screen_tabs_from_files([], "untitled.sapp");
if len(scratch_tabs) != 1 or scratch_tabs[0].kind != "source" or scratch_tabs[0].title != "untitled" { fail("designer screen tabs create a current-file fallback"); }
if ide.designer_screen_kind("docs/README.md") != "" { fail("designer screen tabs ignore non-pblang files"); }
if ide.designer_screen_kind("ui/dialog.pb") != "source" { fail("designer screen tabs accept pblang-compatible extensions"); }

// ── command palette catalog/filter ───────────────────────────────────────────
let cmds = ide.command_catalog();
if len(cmds) < 10 { fail("command catalog exposes IDE commands"); }
if len(ide.command_catalog_issues(cmds)) != 0 { fail("command catalog has no duplicate/malformed commands"); }
if not ide.command_catalog_has("run", cmds) or ide.command_catalog_has("missing_command", cmds) { fail("command_catalog_has checks ids"); }
if not ide.command_catalog_has("browser_search_next", cmds) or not ide.command_catalog_has("browser_bookmarks", cmds) or not ide.command_catalog_has("browser_forward", cmds) or not ide.command_catalog_has("browser_find", cmds) or not ide.command_catalog_has("browser_stats", cmds) or not ide.command_catalog_has("files_inspect", cmds) or not ide.command_catalog_has("files_root_label", cmds) or not ide.command_catalog_has("files_root_group_next", cmds) or not ide.command_catalog_has("design_component_library", cmds) or not ide.command_catalog_has("design_component_insert", cmds) { fail("new Browser/Files/Designer commands are discoverable"); }
if not ide.command_catalog_has("panel_manage", cmds) or not ide.command_catalog_has("panel_settings", cmds) or not ide.command_catalog_has("history_toggle_store", cmds) or not ide.command_catalog_has("history_save", cmds) or not ide.command_catalog_has("history_delete_selected", cmds) { fail("management/settings/history storage commands are discoverable"); }
let toolbar_action_ids = ["run", "check", "format", "fix", "examples", "save", "open", "mode", "watch", "style", "theme"];
let missing_toolbar_ids = ide.command_catalog_missing(toolbar_action_ids, cmds);
if len(missing_toolbar_ids) != 0 { fail("all visible toolbar actions are in the command catalog"); }
if ide.panel_command_id("code") != "panel_code" or ide.panel_command_id("panel_web") != "panel_web" { fail("panel_command_id normalizes panel ids"); }
let visible_panel_ids = ["code", "term", "ai", "design", "web", "files", "outline", "problems", "hist", "manage", "settings"];
let visible_panel_commands = ide.panel_command_ids(visible_panel_ids);
if len(visible_panel_commands) != len(visible_panel_ids) or visible_panel_commands[1] != "panel_term" or visible_panel_commands[8] != "panel_hist" or visible_panel_commands[9] != "panel_manage" or visible_panel_commands[10] != "panel_settings" { fail("panel_command_ids maps visible tabs"); }
let missing_panel_ids = ide.command_catalog_missing(visible_panel_commands, cmds);
if len(missing_panel_ids) != 0 { fail("all visible panel tabs are in the command catalog"); }
let missing_probe = ide.command_catalog_missing(["run", "not_real_command"], cmds);
if len(missing_probe) != 1 or missing_probe[0] != "not_real_command" { fail("command_catalog_missing reports missing ids only"); }
let browser_cmds = ide.filter_commands("group:browser search", 10);
if len(browser_cmds) < 1 or browser_cmds[0].id != "browser_search_next" { fail("command filtering finds browser search command"); }
let command_scroll_pool = ide.filter_commands("", 200);
if len(command_scroll_pool) <= 12 { fail("command filter can return more than one visible command-palette page"); }
let cmd_dupes = ide.command_catalog_issues([
    map{ id: "run", title: "Run", group: "Code", shortcut: "F5" },
    map{ id: "run", title: "", group: "", shortcut: "" }
]);
if len(cmd_dupes) < 4 { fail("command_catalog_issues detects duplicate and missing fields"); }
let cmd_bad_id = ide.command_catalog_issues([
    map{ id: "Bad Id", title: "Bad", group: "Code", shortcut: "" }
]);
if len(cmd_bad_id) < 2 { fail("command_catalog_issues detects malformed ids and missing shortcuts"); }
let group_counts = ide.command_catalog_group_counts([
    map{ id: "a", title: "A", group: "Code", shortcut: "A" },
    map{ id: "b", title: "B", group: "Code", shortcut: "B" },
    map{ id: "c", title: "C", group: "View", shortcut: "C" }
]);
if len(group_counts) != 2 or group_counts[0].group != "Code" or group_counts[0].count != 2 or group_counts[1].group != "View" { fail("command_catalog_group_counts counts groups in order"); }
let cmd_summary = ide.command_catalog_summary([
    map{ id: "a", title: "A", group: "Code", shortcut: "A" },
    map{ id: "b", title: "B", group: "Code", shortcut: "B" },
    map{ id: "c", title: "C", group: "View", shortcut: "C" }
]);
if not str_contains(cmd_summary, "3 commands") or not str_contains(cmd_summary, "2 groups") or not str_contains(cmd_summary, "largest Code 2") { fail("command_catalog_summary describes command surface"); }
let group_code_cmds = ide.filter_commands("group:code", 100);
if len(group_code_cmds) < 5 or group_code_cmds[0].group != "Code" { fail("command filter supports group:code browsing"); }
let group_browser_cmds = ide.filter_commands("group=browser source", 20);
if len(group_browser_cmds) < 1 or group_browser_cmds[0].id != "browser_source" { fail("command filter combines group= and text tokens"); }
let source_ranked_cmd = ide.filter_commands("source", 1);
if len(source_ranked_cmd) != 1 or source_ranked_cmd[0].id != "browser_source" { fail("command filter ranks id matches above earlier broad title matches"); }
let browser_source_limited = ide.filter_commands("group=browser source", 1);
if len(browser_source_limited) != 1 or browser_source_limited[0].id != "browser_source" { fail("command filter ranking works with group filters and small limits"); }
let id_run_cmd = ide.filter_commands("id:run", 10);
if len(id_run_cmd) != 1 or id_run_cmd[0].id != "run" { fail("command filter supports id: scoped filter"); }
let cmd_alias_open = ide.filter_commands("cmd=open", 10);
if len(cmd_alias_open) != 1 or cmd_alias_open[0].id != "open" { fail("command filter supports cmd= alias"); }
let title_browser_cmds = ide.filter_commands("title:browser", 10);
if len(title_browser_cmds) < 1 or title_browser_cmds[0].id != "panel_web" { fail("command filter supports title: scoped filter with ranking"); }
let shortcut_ctrl6 = ide.filter_commands("shortcut:ctrl+6", 10);
if len(shortcut_ctrl6) != 1 or shortcut_ctrl6[0].id != "panel_files" { fail("command filter supports shortcut: scoped filter"); }
let key_f5 = ide.filter_commands("key:f5", 10);
if len(key_f5) != 1 or key_f5[0].id != "run" { fail("command filter supports key: alias"); }
let scoped_combo_cmd = ide.filter_commands("group=browser id:source", 10);
if len(scoped_combo_cmd) != 1 or scoped_combo_cmd[0].id != "browser_source" { fail("command filter combines group and id scopes"); }
let command_not_browser = ide.filter_commands("source not:browser", 10);
if len(command_not_browser) < 1 { fail("command filter keeps non-excluded text results"); }
let cnb_i = 0;
while cnb_i < len(command_not_browser) {
    if str_contains(str_lower(command_not_browser[cnb_i].group), "browser") or str_contains(str_lower(command_not_browser[cnb_i].id), "browser") { fail("command filter supports not: exclusion filters"); }
    cnb_i = cnb_i + 1;
}
let command_exclude_ai = ide.filter_commands("group:code exclude:ai", 100);
if len(command_exclude_ai) < 1 { fail("command filter keeps non-excluded scoped results"); }
let cea_i = 0;
while cea_i < len(command_exclude_ai) {
    if str_contains(str_lower(command_exclude_ai[cea_i].title), "ai") or str_contains(str_lower(command_exclude_ai[cea_i].id), "ai") { fail("command filter supports exclude: alias"); }
    cea_i = cea_i + 1;
}
let hint_empty = ide.command_filter_hint("");
if not str_contains(hint_empty, "group:code") or not str_contains(hint_empty, "group:browser") { fail("command_filter_hint teaches empty group filters"); }
let hint_text = ide.command_filter_hint("source");
if not str_contains(hint_text, "id:run") or not str_contains(hint_text, "shortcut:ctrl+6") or not str_contains(hint_text, "not:browser") { fail("command_filter_hint suggests scoped filters for text filters"); }
let hint_group = ide.command_filter_hint("group:browser");
if not str_contains(hint_group, "group browser active") { fail("command_filter_hint reports active group"); }
let hint_combo = ide.command_filter_hint("group=browser source");
if not str_contains(hint_combo, "group browser") or not str_contains(hint_combo, "source") { fail("command_filter_hint reports group plus text"); }
let hint_scoped = ide.command_filter_hint("group=browser id:source");
if not str_contains(hint_scoped, "group browser") or not str_contains(hint_scoped, "id source") { fail("command_filter_hint reports scoped command filters"); }
let hint_exclude = ide.command_filter_hint("group=code not:browser source");
if not str_contains(hint_exclude, "group code") or not str_contains(hint_exclude, "not browser") or not str_contains(hint_exclude, "source") { fail("command_filter_hint reports exclusion filters"); }
let command_examples = ide.command_filter_examples(3);
if len(command_examples) != 3 or command_examples[0] != "group:code" or command_examples[2] != "id:run" { fail("command_filter_examples returns stable examples"); }
let command_examples_line = ide.command_filter_examples_line(6);
if not str_contains(command_examples_line, "filters:") or not str_contains(command_examples_line, "title:browser") or not str_contains(command_examples_line, "shortcut:ctrl+6") or not str_contains(command_examples_line, "not:browser") { fail("command_filter_examples_line formats visible examples"); }
let run_cmd = ide.filter_commands("run", 10);
if len(run_cmd) < 1 or run_cmd[0].id != "run" { fail("command filter finds run command"); }
let new_cmd = ide.filter_commands("new buffer", 10);
if len(new_cmd) < 1 or new_cmd[0].id != "new" { fail("command filter finds new buffer command"); }
let save_as_cmd = ide.filter_commands("save as path", 10);
if len(save_as_cmd) < 1 or save_as_cmd[0].id != "save_as" { fail("command filter finds save as command"); }
let revert_cmd = ide.filter_commands("revert disk", 10);
if len(revert_cmd) < 1 or revert_cmd[0].id != "revert" { fail("command filter finds revert command"); }
let clear_cmd = ide.filter_commands("clear output", 10);
if len(clear_cmd) < 1 or clear_cmd[0].id != "clear" { fail("command filter finds clear output command"); }
let restore_cmd = ide.filter_commands("restore starter", 10);
if len(restore_cmd) < 1 or restore_cmd[0].id != "restore" { fail("command filter finds restore starter command"); }
let dup_line_cmd = ide.filter_commands("duplicate current line", 10);
if len(dup_line_cmd) < 1 or dup_line_cmd[0].id != "line_duplicate" { fail("command filter finds duplicate line command"); }
let del_line_cmd = ide.filter_commands("delete current line", 10);
if len(del_line_cmd) < 1 or del_line_cmd[0].id != "line_delete" { fail("command filter finds delete line command"); }
let move_line_up_cmd = ide.filter_commands("move line up", 10);
if len(move_line_up_cmd) < 1 or move_line_up_cmd[0].id != "line_move_up" { fail("command filter finds move line up command"); }
let move_line_down_cmd = ide.filter_commands("alt+down", 10);
if len(move_line_down_cmd) < 1 or move_line_down_cmd[0].id != "line_move_down" { fail("command filter finds move line down command"); }
let comment_line_cmd = ide.filter_commands("toggle line comment", 10);
if len(comment_line_cmd) < 1 or comment_line_cmd[0].id != "line_comment_toggle" { fail("command filter finds toggle line comment command"); }
let indent_cmd = ide.filter_commands("indent selected lines", 10);
if len(indent_cmd) < 1 or indent_cmd[0].id != "line_indent" { fail("command filter finds indent lines command"); }
let outdent_cmd = ide.filter_commands("shift+tab", 10);
if len(outdent_cmd) < 1 or outdent_cmd[0].id != "line_outdent" { fail("command filter finds outdent lines command"); }
let trim_ws_cmd = ide.filter_commands("trim trailing whitespace", 10);
if len(trim_ws_cmd) < 1 or trim_ws_cmd[0].id != "trim_trailing_ws" { fail("command filter finds trim whitespace command"); }
let find_cmd = ide.filter_commands("find current buffer", 10);
if len(find_cmd) < 1 or find_cmd[0].id != "find" { fail("command filter finds find command"); }
let replace_cmd = ide.filter_commands("replace current buffer", 10);
if len(replace_cmd) < 1 or replace_cmd[0].id != "replace" { fail("command filter finds replace command"); }
let panel_cmd = ide.filter_commands("browser", 10);
if len(panel_cmd) < 1 or panel_cmd[0].id != "panel_web" { fail("command filter finds browser panel"); }
let outline_cmd = ide.filter_commands("outline", 10);
if len(outline_cmd) < 1 or outline_cmd[0].id != "panel_outline" { fail("command filter finds outline panel"); }
let files_cmd = ide.filter_commands("files", 10);
if len(files_cmd) < 1 or files_cmd[0].id != "panel_files" { fail("command filter finds files panel"); }
let files_recent_cmd = ide.filter_commands("files recent", 10);
if len(files_recent_cmd) < 1 or files_recent_cmd[0].id != "files_recent" { fail("command filter finds files recent view"); }
let files_tree_cmd = ide.filter_commands("files tree", 10);
if len(files_tree_cmd) < 1 or files_tree_cmd[0].id != "files_tree" { fail("command filter finds files tree view"); }
let files_reveal_cmd = ide.filter_commands("reveal current file", 10);
if len(files_reveal_cmd) < 1 or files_reveal_cmd[0].id != "files_reveal" { fail("command filter finds reveal current file"); }
let files_clear_recent_cmd = ide.filter_commands("clear recent", 10);
if len(files_clear_recent_cmd) < 1 or files_clear_recent_cmd[0].id != "files_clear_recent" { fail("command filter finds clear recent files"); }
let terminal_clear_cmd = ide.filter_commands("terminal clear", 10);
if len(terminal_clear_cmd) < 1 or terminal_clear_cmd[0].id != "terminal_clear" { fail("command filter finds terminal clear"); }
let ctrl6_cmd = ide.filter_commands("ctrl+6", 10);
if len(ctrl6_cmd) < 1 or ctrl6_cmd[0].id != "panel_files" { fail("command filter finds panel shortcut"); }
let multi_field_cmd = ide.filter_commands("panel ctrl+6", 10);
if len(multi_field_cmd) < 1 or multi_field_cmd[0].id != "panel_files" { fail("command filter matches query tokens across fields"); }
let panel_next_cmd = ide.filter_commands("ctrl+tab", 10);
if len(panel_next_cmd) < 1 or panel_next_cmd[0].id != "panel_next" { fail("command filter finds next panel shortcut"); }
let panel_prev_cmd = ide.filter_commands("pageup", 10);
if len(panel_prev_cmd) < 1 or panel_prev_cmd[0].id != "panel_prev" { fail("command filter finds previous panel shortcut"); }
let panel_prev_tokens = ide.filter_commands("previous ctrl+pageup", 10);
if len(panel_prev_tokens) < 1 or panel_prev_tokens[0].id != "panel_prev" { fail("command filter matches previous panel tokens"); }
let watch_action_cmd = ide.filter_commands("suggested", 10);
if len(watch_action_cmd) < 1 or watch_action_cmd[0].id != "watch_action" { fail("command filter finds watcher suggested action"); }
let problems_cmd = ide.filter_commands("problems", 10);
if len(problems_cmd) < 1 or problems_cmd[0].id != "problems" { fail("command filter finds problems command"); }
let goto_cmd = ide.filter_commands("go to line", 10);
if len(goto_cmd) < 1 or goto_cmd[0].id != "goto_line" { fail("command filter finds go to line"); }
let nav_back_cmd = ide.filter_commands("alt+left", 10);
if len(nav_back_cmd) < 1 or nav_back_cmd[0].id != "navigate_back" { fail("command filter finds navigate back"); }
let nav_forward_cmd = ide.filter_commands("navigate forward", 10);
if len(nav_forward_cmd) < 1 or nav_forward_cmd[0].id != "navigate_forward" { fail("command filter finds navigate forward"); }
let problems_panel_cmd = ide.filter_commands("problems panel", 10);
if len(problems_panel_cmd) < 1 or problems_panel_cmd[0].id != "panel_problems" { fail("command filter finds problems panel"); }
let history_clear_cmd = ide.filter_commands("clear history", 10);
if len(history_clear_cmd) < 1 or history_clear_cmd[0].id != "history_clear" { fail("command filter finds history clear"); }
let next_diag_cmd = ide.filter_commands("next diagnostic", 10);
if len(next_diag_cmd) < 1 or next_diag_cmd[0].id != "diagnostic_next" { fail("command filter finds next diagnostic"); }
let prev_diag_cmd = ide.filter_commands("previous diagnostic", 10);
if len(prev_diag_cmd) < 1 or prev_diag_cmd[0].id != "diagnostic_prev" { fail("command filter finds previous diagnostic"); }
let browser_tor_cmd = ide.filter_commands("browser tor toggle", 10);
if len(browser_tor_cmd) < 1 or browser_tor_cmd[0].id != "browser_tor_toggle" { fail("command filter finds browser tor toggle"); }
let browser_safe_cmd = ide.filter_commands("browser safe", 10);
if len(browser_safe_cmd) < 1 or browser_safe_cmd[0].id != "browser_security_safe" { fail("command filter finds browser safe profile"); }
let browser_trusted_cmd = ide.filter_commands("browser trusted", 10);
if len(browser_trusted_cmd) < 1 or browser_trusted_cmd[0].id != "browser_security_trusted" { fail("command filter finds browser trusted profile"); }
let browser_source_cmd = ide.filter_commands("browser source", 10);
if len(browser_source_cmd) < 1 or browser_source_cmd[0].id != "browser_source" { fail("command filter finds browser source view"); }
let browser_inspect_cmd = ide.filter_commands("f12 details", 10);
if len(browser_inspect_cmd) < 1 or browser_inspect_cmd[0].id != "browser_inspect" { fail("command filter finds browser inspect details"); }
let ai_explain_cmd = ide.filter_commands("ai explain", 10);
if len(ai_explain_cmd) < 1 or ai_explain_cmd[0].id != "ai_explain" { fail("command filter finds AI explain"); }
let ai_bugs_cmd = ide.filter_commands("find bugs code", 10);
if len(ai_bugs_cmd) < 1 or ai_bugs_cmd[0].id != "ai_bugs" { fail("command filter finds AI bugs"); }
let ai_diag_cmd = ide.filter_commands("ai diagnostics", 10);
if len(ai_diag_cmd) < 1 or ai_diag_cmd[0].id != "ai_diag" { fail("command filter finds AI diagnostics"); }
let ai_insert_cmd = ide.filter_commands("ai insert last answer", 10);
if len(ai_insert_cmd) < 1 or ai_insert_cmd[0].id != "ai_insert" { fail("command filter finds AI insert"); }
let ai_clear_cmd = ide.filter_commands("ai clear", 10);
if len(ai_clear_cmd) < 1 or ai_clear_cmd[0].id != "ai_clear" { fail("command filter finds AI clear"); }
let design_code_cmd = ide.filter_commands("designer code", 10);
if len(design_code_cmd) < 1 or design_code_cmd[0].id != "design_codegen" { fail("command filter finds Designer codegen"); }
let design_layout_cmd = ide.filter_commands("designer layout", 10);
if len(design_layout_cmd) < 1 or design_layout_cmd[0].id != "design_layout_next" { fail("command filter finds Designer layout"); }
let design_target_cmd = ide.filter_commands("designer target", 10);
if len(design_target_cmd) < 1 or design_target_cmd[0].id != "design_target_next" { fail("command filter finds Designer target"); }
let design_duplicate_cmd = ide.filter_commands("designer duplicate", 10);
if len(design_duplicate_cmd) < 1 or design_duplicate_cmd[0].id != "design_duplicate" { fail("command filter finds Designer duplicate"); }
let design_layer_cmd = ide.filter_commands("designer bring front", 10);
if len(design_layer_cmd) < 1 or design_layer_cmd[0].id != "design_layer_top" { fail("command filter finds Designer layer front"); }
let style_cmd = ide.filter_commands("visual style", 10);
if len(style_cmd) < 1 or style_cmd[0].id != "style" { fail("command filter finds visual style command"); }
let theme_cmd = ide.filter_commands("light dark theme", 10);
if len(theme_cmd) < 1 or theme_cmd[0].id != "theme" { fail("command filter finds light/dark theme command"); }
let density_smaller_cmd = ide.filter_commands("density smaller", 10);
if len(density_smaller_cmd) < 1 or density_smaller_cmd[0].id != "density_smaller" { fail("command filter finds density smaller command"); }
let density_larger_cmd = ide.filter_commands("density larger", 10);
if len(density_larger_cmd) < 1 or density_larger_cmd[0].id != "density_larger" { fail("command filter finds density larger command"); }
let density_auto_cmd = ide.filter_commands("density auto", 10);
if len(density_auto_cmd) < 1 or density_auto_cmd[0].id != "density_auto" { fail("command filter finds density auto command"); }
let density_refresh_cmd = ide.filter_commands("density refresh", 10);
if len(density_refresh_cmd) < 1 or density_refresh_cmd[0].id != "density_refresh" { fail("command filter finds density refresh command"); }
let vt = ide.ide_visual_tokens("smooth", "light");
if vt.format != "pbide.visual.tokens.v1" or vt.style != "smooth" or vt.theme != "light" { fail("visual tokens expose normalized style/theme contract"); }
if vt.chrome != "frosted-studio" or vt.density != "comfortable" or vt.focus != "active-glow" { fail("visual tokens describe smooth studio design"); }
let vt_crystal = ide.ide_visual_tokens("crystal", "dark");
if vt_crystal.chrome != "crystal-studio" or vt_crystal.density != "compact-comfort" or vt_crystal.focus != "crystal-focus" { fail("visual tokens describe crystal studio design"); }
if not str_contains(vt.usability, "clean") or not str_contains(vt.usability, "futuristic") { fail("visual tokens preserve redesign goals"); }
let vt_bad = ide.ide_visual_tokens("unknown-style", "unknown-theme");
if vt_bad.style != "web" or vt_bad.theme != "dark" { fail("visual tokens normalize unknown values safely"); }
if ide.ide_visual_style_next("web") != "smooth" or ide.ide_visual_style_next("smooth") != "crystal" or ide.ide_visual_style_next("crystal") != "contrast" or ide.ide_visual_style_next("contrast") != "web" or ide.ide_visual_style_next("pixel") != "web" { fail("visual style cycle is shared and stable"); }
let vc = ide.ide_visual_chrome("smooth", "dark");
if vc.format != "pbide.visual.chrome.v1" or vc.sidepane != "stacked-section-cards" or vc.statusbar != "health-led-context-strip" or vc.modals != "centered-card-focus-ring" { fail("visual chrome contract covers sidepane/status/modal surfaces"); }
if vc.overdraw_policy != "opaque-replace-legacy" or vc.legacy_layer_visible != false { fail("visual chrome contract hides previous design layers"); }
if vc.section_gap < 1 or vc.row_gap < 1 or vc.radius < 1 { fail("visual chrome contract exposes usable spacing/radius values"); }
let dens_small = ide.ide_responsive_density(1280, 760, nil);
if dens_small.scale != 1 or dens_small.source != "auto" or dens_small.density != "compact" { fail("responsive density keeps laptop windows compact"); }
let dens_4k = ide.ide_responsive_density(3840, 2160, nil);
if dens_4k.scale != 2 or dens_4k.source != "auto" or dens_4k.density != "comfortable" { fail("responsive density scales 4K-class windows"); }
let dens_manual = ide.ide_responsive_density(800, 600, 3);
if dens_manual.scale != 3 or dens_manual.source != "manual" or dens_manual.density != "manual" { fail("responsive density honors manual override"); }
let vp_small = ide.ide_viewport_layout(900, 700, 1);
if vp_small.format != "pbide.viewport.layout.v1" or vp_small.class != "small" or vp_small.panel_tabs != "compact" or vp_small.side_chars != 22 or vp_small.content_cols != 1 { fail("viewport layout compacts small windows"); }
let vp_wide = ide.ide_viewport_layout(1920, 1080, 1);
if vp_wide.class != "wide" or vp_wide.side_chars < 34 or vp_wide.content_cols != 3 or vp_wide.rounded != true { fail("viewport layout expands wide windows"); }
let vp_huge = ide.ide_viewport_layout(2560, 1440, 2);
if vp_huge.class != "huge" or vp_huge.content_cols != 4 or vp_huge.gap != 8 or vp_huge.crystal_ready != true { fail("viewport layout handles huge/crystal-ready screens"); }
let pm_hist = ide.ide_panel_metrics(1280, 760, 1, 8, 16, 8, 48, 24, "history");
if pm_hist.format != "pbide.panel.metrics.v1" or pm_hist.kind != "history" or pm_hist.rows < 1 or pm_hist.max_chars < 8 { fail("panel metrics exposes usable history layout"); }
if pm_hist.search_y <= pm_hist.header_h or pm_hist.body_top <= pm_hist.search_y or pm_hist.footer_y <= pm_hist.body_top { fail("panel metrics orders header/search/body/footer"); }
let pm_files = ide.ide_panel_metrics(1280, 760, 1, 8, 16, 8, 48, 24, "files");
if pm_files.body_top <= pm_hist.body_top or pm_files.row_h != 16 { fail("panel metrics gives files extra status rows"); }
let pm_manage = ide.ide_panel_metrics(900, 700, 1, 8, 16, 8, 48, 24, "manage");
if pm_manage.viewport_class != "small" or pm_manage.hint_mode != "compact" or pm_manage.row_h != 32 { fail("panel metrics compacts small management panels"); }
let pm_problems = ide.ide_panel_metrics(1280, 760, 1, 8, 16, 8, 48, 24, "problems");
if pm_problems.detail_h <= 0 or pm_problems.detail_y >= pm_problems.footer_y or pm_problems.rows < 1 { fail("panel metrics reserves responsive diagnostics detail area"); }
let vs = ide.ide_visual_summary("contrast", "dark");
if not str_contains(vs, "contrast/dark") or not str_contains(vs, "high-contrast-studio") or not str_contains(vs, "futuristic") { fail("visual summary describes the active design system"); }
let ui_snapshot_cmd = ide.filter_commands("ui snapshot", 10);
if len(ui_snapshot_cmd) < 1 or ui_snapshot_cmd[0].id != "ui_snapshot" { fail("command filter finds UI observer snapshot"); }
let limited_cmd = ide.filter_commands("", 3);
if len(limited_cmd) != 3 { fail("command filter obeys limit"); }
let cmd_status = ide.command_filter_status("ai", 0);
if not str_contains(cmd_status, "commands:") or not str_contains(cmd_status, "sel 1/") or not str_contains(cmd_status, "panel_ai") or not str_contains(cmd_status, "Panels") { fail("command_filter_status shows filtered selection and command metadata"); }
let cmd_status_all = ide.command_filter_status("", 999);
if not str_contains(cmd_status_all, "commands: all") or not str_contains(cmd_status_all, "sel") or not str_contains(cmd_status_all, "help") { fail("command_filter_status shows all commands and clamps selection metadata"); }
let cmd_status_source = ide.command_filter_status("source", 0);
if not str_contains(cmd_status_source, "browser_source") or not str_contains(cmd_status_source, "Browser") { fail("command_filter_status follows ranked selected command"); }
let cmd_status_none = ide.command_filter_status("definitely_missing_command", 0);
if not str_contains(cmd_status_none, "0/") or str_contains(cmd_status_none, "sel") { fail("command_filter_status handles empty matches"); }
let cmd_empty = ide.command_empty_message("definitely_missing_command");
if not str_contains(cmd_empty, "No matching commands for `definitely_missing_command`") or not str_contains(cmd_empty, "group:code") or not str_contains(cmd_empty, "run/save/open") { fail("command_empty_message gives recovery guidance"); }
let cmd_empty_group = ide.command_empty_message("group:browser definitely_missing_command");
if not str_contains(cmd_empty_group, "group browser") or not str_contains(cmd_empty_group, "exact command ids") { fail("command_empty_message preserves active group guidance"); }

// ── browser toolbar layout / hit zones ───────────────────────────────────────
let bm = ide.browser_bar_metrics(8, 4);
if bm.button_h != 20 or bm.summary_h != 24 or bm.total_h != 44 { fail("browser bar metrics match native button + policy/interaction summary rows"); }
if ide.browser_bar_zone(9, 10, 8, 4) != "above" { fail("browser bar zone detects above toolbar"); }
if ide.browser_bar_zone(10, 10, 8, 4) != "buttons" { fail("browser bar zone detects first button pixel"); }
if ide.browser_bar_zone(29, 10, 8, 4) != "buttons" { fail("browser bar zone keeps final button pixel clickable"); }
if ide.browser_bar_zone(30, 10, 8, 4) != "summary" { fail("browser bar zone starts security summary after buttons"); }
if ide.browser_bar_zone(53, 10, 8, 4) != "summary" { fail("browser security/interaction summary rows are not button-clickable"); }
if ide.browser_bar_zone(54, 10, 8, 4) != "body" { fail("browser body starts after security and interaction summaries"); }
let bh_full = ide.browser_header_layout(1280, 6, 4);
if bh_full.format != "pbide.browser.header.layout.v1" or bh_full.compact != false or len(bh_full.modes) != 7 or bh_full.modes[1].label != "Reader" or bh_full.url_w <= 0 { fail("browser header layout keeps full labels on wide windows"); }
let bh_small = ide.browser_header_layout(720, 12, 8);
if bh_small.compact != true or bh_small.reload.label != "Load" or bh_small.modes[0].label != "Lv" or bh_small.security.w != 8 * 12 { fail("browser header layout compacts labels and controls on narrow/manual-scaled windows"); }
if bh_small.url_w < 0 or bh_small.tor.x + bh_small.tor.w > 720 { fail("browser compact header keeps controls inside the viewport"); }

// ── problems panel hit zones ─────────────────────────────────────────────────
let ph0 = ide.problems_panel_hit(99, 100, 8, 4, 2);
if ph0.kind != "above" { fail("problems hit detects area above action row"); }
let ph1 = ide.problems_panel_hit(100, 100, 8, 4, 2);
if ph1.kind != "action" or ph1.index != 0 { fail("problems hit maps action row"); }
let phGap = ide.problems_panel_hit(108, 100, 8, 4, 2);
if phGap.kind != "gap" { fail("problems hit does not map action/diagnostic padding to action"); }
let ph2 = ide.problems_panel_hit(112, 100, 8, 4, 2);
if ph2.kind != "diagnostic" or ph2.index != 0 { fail("problems hit maps first diagnostic after padding"); }
let ph3 = ide.problems_panel_hit(120, 100, 8, 4, 2);
if ph3.kind != "diagnostic" or ph3.index != 1 { fail("problems hit maps second diagnostic"); }
let ph4 = ide.problems_panel_hit(136, 100, 8, 4, 2);
if ph4.kind != "below" { fail("problems hit detects area below diagnostics"); }

// ── UI observer snapshots ───────────────────────────────────────────────────
let ui_regions = [
    uio.region("toolbar", 0, 0, 800, 32, "toolbar", map{}),
    uio.region("editor", 0, 32, 560, 520, "editor", map{}),
    uio.region("sidepane", 560, 32, 240, 520, "sidepane", map{})
];
let ui_snap = uio.surface_snapshot("pbide", "test surface", map{ w: 800, h: 600 }, "code", ui_regions, ["panel=code", "event=mouse 10,10"]);
if ui_snap.format != "pblang.ui.snapshot.v1" or ui_snap.region_count != 3 { fail("ui snapshot records format and region count"); }
if ui_snap.focus != "code" { fail("ui snapshot preserves focus name"); }
if ui_snap.issue_count != 0 { fail("ui snapshot has no issues for clean regions"); }
if ui_snap.quality_score != 100 or uio.snapshot_score(ui_snap) != 100 { fail("ui observer scores clean layout at 100"); }
let ui_lines = uio.snapshot_lines(ui_snap, 5);
if len(ui_lines) != 5 or not str_contains(ui_lines[0], "ui: pbide") or not str_contains(ui_lines[0], "quality=100/100") or not str_contains(ui_lines[1], "signal: panel=code") or not str_contains(ui_lines[2], "event=mouse") or not str_contains(ui_lines[3], "toolbar") { fail("ui snapshot lines are readable"); }
let bad_ui = uio.surface_snapshot("pbide", "bad surface", map{ w: 100, h: 100 }, "code", [
    uio.region("bad-size", 0, 0, 0, 10, "panel", map{}),
    uio.region("offscreen", 90, 90, 30, 30, "panel", map{}),
    uio.region("a", 10, 10, 50, 50, "panel", map{}),
    uio.region("b", 30, 30, 50, 50, "panel", map{}),
    uio.region("modal", 0, 0, 100, 100, "modal", map{ overlay: true })
], []);
if bad_ui.issue_count < 3 { fail("ui observer detects size/offscreen/overlap issues"); }
if bad_ui.quality_score >= 100 or uio.snapshot_score(bad_ui) != bad_ui.quality_score { fail("ui observer lowers quality score for layout issues"); }
let bad_lines = uio.snapshot_lines(bad_ui, 5);
if not str_contains(bad_lines[1], "issue:") { fail("ui observer reports issues first"); }
let text_region = uio.region("toolbar-label", 0, 0, 80, 20, "toolbar", map{ text: "Run Check", char_w: 8, pad: 4 });
if uio.text_capacity(text_region) != 9 { fail("ui observer computes text capacity from width/char/pad"); }
let text_ok = uio.surface_snapshot("pbide", "text ok", map{ w: 120, h: 40 }, "code", [text_region], []);
if text_ok.issue_count != 0 { fail("ui observer accepts labels that fit their region"); }
let text_bad = uio.surface_snapshot("pbide", "text bad", map{ w: 80, h: 40 }, "code", [
    uio.region("tiny-status", 0, 0, 40, 20, "statusbar", map{ text: "this label is too long", char_w: 8, pad: 4 })
], []);
if text_bad.issue_count != 1 or not str_contains(text_bad.issues[0].message, "text clipped") { fail("ui observer detects clipped text"); }
let text_bad_lines = uio.snapshot_lines(text_bad, 3);
if not str_contains(text_bad_lines[1], "tiny-status") or not str_contains(text_bad_lines[1], "text clipped") { fail("ui observer reports clipped text in readable lines"); }
let missing_regions = uio.required_region_issues(ui_regions, ["toolbar", "editor", "missing-action"]);
if len(missing_regions) != 1 or missing_regions[0].target != "missing-action" or not str_contains(missing_regions[0].message, "required region missing") { fail("ui observer detects missing required regions"); }
let checked_ui = uio.surface_snapshot_checked("pbide", "checked surface", map{ w: 800, h: 600 }, "code", ui_regions, [], ["toolbar", "editor", "sidepane"]);
if checked_ui.issue_count != 0 or checked_ui.quality_score != 100 { fail("checked ui snapshot accepts complete required regions"); }
let checked_missing = uio.surface_snapshot_checked("pbide", "checked missing", map{ w: 800, h: 600 }, "code", [ui_regions[0]], [], ["toolbar", "editor"]);
if checked_missing.issue_count != 1 or checked_missing.issues[0].target != "editor" or checked_missing.quality_score >= 100 { fail("checked ui snapshot reports missing required regions"); }
let action_regions = [
    uio.region("toolbar", 0, 0, 800, 32, "toolbar", map{ actions: ["run", "check"], panel_actions: ["panel_code", "panel_web"] })
];
let missing_actions = uio.required_action_issues(action_regions, ["run", "panel_web", "save"]);
if len(missing_actions) != 1 or missing_actions[0].target != "action:save" or not str_contains(missing_actions[0].message, "required action missing") { fail("ui observer detects missing required actions"); }
let action_ok = uio.surface_snapshot_contract("pbide", "actions ok", map{ w: 800, h: 80 }, "code", action_regions, [], ["toolbar"], ["run", "check", "panel_code", "panel_web"]);
if action_ok.issue_count != 0 or action_ok.quality_score != 100 { fail("ui observer accepts complete required actions"); }
let action_bad = uio.surface_snapshot_contract("pbide", "actions missing", map{ w: 800, h: 80 }, "code", action_regions, [], ["toolbar"], ["run", "save"]);
if action_bad.issue_count != 1 or action_bad.issues[0].target != "action:save" or action_bad.quality_score >= 100 { fail("ui observer checked snapshot reports missing required actions"); }
if uio.action_target_capacity(action_regions[0]) != 200 { fail("ui observer computes action target capacity across actions and panel actions"); }
let cramped_actions = [
    uio.region("toolbar", 0, 0, 100, 32, "toolbar", map{ actions: ["run", "check"], panel_actions: ["panel_code", "panel_web"], min_action_w: 40 })
];
let cramped_ui = uio.surface_snapshot_contract("pbide", "cramped actions", map{ w: 120, h: 80 }, "code", cramped_actions, [], ["toolbar"], ["run", "check", "panel_code"]);
if cramped_ui.issue_count != 1 or not str_contains(cramped_ui.issues[0].message, "action targets cramped") { fail("ui observer detects cramped action click targets"); }
let cramped_lines = uio.snapshot_lines(cramped_ui, 3);
if not str_contains(cramped_lines[1], "toolbar") or not str_contains(cramped_lines[1], "action targets cramped") { fail("ui observer reports cramped action targets in readable lines"); }
let action_meta_regions = [
    uio.region("toolbar", 0, 0, 800, 32, "toolbar", map{ actions: [
        map{ id: "run", label: "Run" },
        map{ id: "run", label: "Run Again" },
        map{ id: "save", label: "" }
    ] })
];
let action_meta_issues = uio.action_metadata_issues(action_meta_regions);
if len(action_meta_issues) != 2 or not str_contains(action_meta_issues[0].message, "duplicate action id run") or action_meta_issues[1].target != "action:save" { fail("ui observer detects duplicate and unlabeled action metadata"); }
let action_meta_snapshot = uio.surface_snapshot("pbide", "action metadata", map{ w: 800, h: 80 }, "code", action_meta_regions, []);
if action_meta_snapshot.issue_count != 2 or action_meta_snapshot.quality_score >= 100 { fail("ui observer includes action metadata issues in snapshot analysis"); }
let focus_ok_regions = [
    uio.region("toolbar", 0, 0, 800, 32, "toolbar", map{}),
    uio.region("code-editor", 0, 32, 560, 520, "editor", map{ focused: true, focus_required: true })
];
let focus_ok = uio.surface_snapshot_contract("pbide", "focus ok", map{ w: 800, h: 600 }, "code", focus_ok_regions, [], ["toolbar", "code-editor"], []);
if focus_ok.issue_count != 0 { fail("ui observer accepts one focused required region"); }
let focus_missing = uio.surface_snapshot("pbide", "focus missing", map{ w: 800, h: 80 }, "code", [
    uio.region("code-editor", 0, 0, 300, 60, "editor", map{ focus_required: true })
], []);
if focus_missing.issue_count != 1 or not str_contains(focus_missing.issues[0].message, "required focus missing") { fail("ui observer detects missing required focus"); }
let focus_multi = uio.surface_snapshot("pbide", "focus multi", map{ w: 800, h: 80 }, "code", [
    uio.region("code-editor", 0, 0, 300, 60, "editor", map{ focused: true }),
    uio.region("modal-help", 10, 10, 300, 60, "modal", map{ focused: true, overlay: true })
], []);
if focus_multi.issue_count != 1 or not str_contains(focus_multi.issues[0].message, "multiple focused regions") { fail("ui observer detects multiple focused regions"); }
let identity_regions = [
    map{ name: "", x: 0, y: 0, w: 10, h: 10, role: "panel", state: map{} },
    uio.region("toolbar", 20, 0, 80, 20, "toolbar", map{}),
    uio.region("toolbar", 110, 0, 80, 20, "toolbar", map{})
];
let identity_issues = uio.region_identity_issues(identity_regions);
if len(identity_issues) != 2 or not str_contains(identity_issues[0].message, "empty name") or not str_contains(identity_issues[1].message, "duplicate region name") { fail("ui observer detects empty and duplicate region names"); }
let identity_snapshot = uio.surface_snapshot("pbide", "identity", map{ w: 800, h: 100 }, "code", identity_regions, []);
if identity_snapshot.issue_count != 2 or identity_snapshot.quality_score >= 100 { fail("ui snapshot includes region identity issues"); }
let hidden_required_regions = [
    uio.region("toolbar", 0, 0, 800, 32, "toolbar", map{ visible: false, visibility_required: true })
];
let hidden_required_issues = uio.visibility_issues(hidden_required_regions);
if len(hidden_required_issues) != 1 or hidden_required_issues[0].target != "toolbar" or not str_contains(hidden_required_issues[0].message, "required region hidden") { fail("ui observer detects hidden required regions"); }
let hidden_focus = uio.surface_snapshot("pbide", "hidden focus", map{ w: 800, h: 100 }, "code", [
    uio.region("code-editor", 0, 0, 300, 60, "editor", map{ visible: false, focused: true })
], []);
if hidden_focus.issue_count != 1 or not str_contains(hidden_focus.issues[0].message, "hidden region is focused") { fail("ui observer detects hidden focused regions"); }
let hidden_action_regions = [
    uio.region("toolbar", 0, 0, 800, 32, "toolbar", map{ actions: [
        map{ id: "run", label: "Run", visible: false }
    ] })
];
let hidden_action_missing = uio.required_action_issues(hidden_action_regions, ["run"]);
if len(hidden_action_missing) != 1 or hidden_action_missing[0].target != "action:run" { fail("hidden actions do not satisfy required actions"); }
let hidden_action_contract = uio.surface_snapshot_contract("pbide", "hidden action", map{ w: 800, h: 100 }, "code", hidden_action_regions, [], ["toolbar"], ["run"]);
if hidden_action_contract.issue_count < 2 { fail("ui observer reports hidden action and missing required action"); }
let has_hidden_action = false;
let hai = 0;
while hai < len(hidden_action_contract.issues) {
    if hidden_action_contract.issues[hai].target == "action:run" and str_contains(hidden_action_contract.issues[hai].message, "action hidden") { has_hidden_action = true; }
    hai = hai + 1;
}
if not has_hidden_action { fail("ui observer surfaces hidden action issue in snapshots"); }

// ── quick-open file filtering ─────────────────────────────────────────────────
