if not str_contains(file_action, "Space preview") or not str_contains(file_action, "Ctrl+C copy") or not str_contains(file_action, "Ctrl+X cut") or not str_contains(file_action, "Ctrl+V paste") or not str_contains(file_action, "Ctrl+I inspect") or not str_contains(file_action, "Ctrl+U transfer") or not str_contains(file_action, "document/pdf") { fail("file_explorer_action_line describes selected file actions and profile"); }
let dir_action = ide.file_explorer_action_line(map{ name: "src", path: "/repo/src", kind: "dir" });
if not str_contains(dir_action, "Enter open") or not str_contains(dir_action, "Ctrl+B bookmark root") or not str_contains(dir_action, "Ctrl+C copy") { fail("file_explorer_action_line describes selected directory actions"); }
