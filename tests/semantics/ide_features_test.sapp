let qopen_tree_order = ide.quick_open_candidates([
    map{ name: "root.sapp", path: "root.sapp", kind: "file", display: "root.sapp", tree: true },
    map{ name: "src", path: "src", kind: "dir", display: "src", tree: true }
], "", 10);
if qopen_tree_order[0].name != "root.sapp" { fail("quick open preserves tree row order"); }

// ── project roots / multi-root files panel helpers ───────────────────────────
let roots = ide.project_roots("/repo", "/repo/src/main.sapp", ["/repo", "/other"]);
if len(roots) != 3 or roots[0] != "/repo" or roots[1] != "/repo/src" or roots[2] != "/other" { fail("project_roots dedupes cwd/file/extras"); }
if ide.project_root_index(roots, "/other") != 2 { fail("project_root_index finds current root"); }
let cyc = ide.project_root_cycle(roots, "/other", 1);
if cyc.index != 0 or cyc.path != "/repo" { fail("project_root_cycle wraps forward"); }
let cyc2 = ide.project_root_cycle(roots, "/repo", 0 - 1);
if cyc2.index != 2 or cyc2.path != "/other" { fail("project_root_cycle wraps backward"); }
let root_text = ide.project_roots_to_text(["/repo", "/repo", "", "/other"]);
if root_text != "/repo\n/other\n" { fail("project_roots_to_text dedupes and serializes roots"); }
let parsed_roots = ide.project_roots_from_text("# pbide\n/repo\n\n/other\n/repo\n", []);
if len(parsed_roots) != 2 or parsed_roots[0] != "/repo" or parsed_roots[1] != "/other" { fail("project_roots_from_text parses saved root file"); }
let fallback_roots = ide.project_roots_from_text("\n# none\n", ["/fallback"]);
if len(fallback_roots) != 1 or fallback_roots[0] != "/fallback" { fail("project_roots_from_text uses fallback when empty"); }
let no_saved_roots = ide.project_roots_from_text("\n# none\n", []);
if len(no_saved_roots) != 0 { fail("project_roots_from_text keeps empty saved roots empty without fallback"); }
let merged_roots = ide.project_roots_merge_saved("/cwd", "/cwd/src/main.sapp", "/saved\n/cwd\n");
if len(merged_roots) != 3 or merged_roots[0] != "/cwd" or merged_roots[1] != "/cwd/src" or merged_roots[2] != "/saved" { fail("project_roots_merge_saved keeps cwd/file roots before saved roots"); }
if ide.project_root_label("/media/panosboy/ExtHD/panag") != "panag" { fail("project_root_label uses basename"); }
if ide.project_root_group("/media/panosboy/ExtHD/panag") != "drive" or ide.project_root_group("/home/panosboy/repos") != "home" or ide.project_root_group("relative") != "project" { fail("project_root_group classifies useful root groups"); }
let root_records = ide.project_root_records(["/home/panosboy/repos", "/media/panosboy/ExtHD/panag"], "/media/panosboy/ExtHD/panag");
if len(root_records) != 2 or root_records[0].label != "repos" or root_records[1].group != "drive" or root_records[1].current != true { fail("project_root_records builds named grouped roots"); }
let root_status = ide.project_root_status(["/home/panosboy/repos", "/media/panosboy/ExtHD/panag"], "/media/panosboy/ExtHD/panag");
if not str_contains(root_status, "root 2/2 panag [drive]") { fail("project_root_status shows named grouped active root"); }
let meta0 = ide.project_root_meta_set([], "/media/panosboy/ExtHD/panag", "AAP Drive", "code");
let meta_rec = ide.project_root_meta_get(meta0, "/media/panosboy/ExtHD/panag");
if meta_rec.label != "AAP Drive" or meta_rec.group != "code" or meta_rec.edited != true { fail("project_root_meta_set stores edited label/group"); }
let meta_records = ide.project_root_records_with_meta(["/home/panosboy/repos", "/media/panosboy/ExtHD/panag"], "/media/panosboy/ExtHD/panag", meta0);
if meta_records[1].label != "AAP Drive" or meta_records[1].group != "code" or meta_records[1].edited != true { fail("project_root_records_with_meta applies edited metadata"); }
let meta_status = ide.project_root_status_with_meta(["/home/panosboy/repos", "/media/panosboy/ExtHD/panag"], "/media/panosboy/ExtHD/panag", meta0);
if not str_contains(meta_status, "AAP Drive* [code]") { fail("project_root_status_with_meta marks edited root metadata"); }
let meta1 = ide.project_root_meta_next_group(meta0, "/media/panosboy/ExtHD/panag");
if ide.project_root_meta_get(meta1, "/media/panosboy/ExtHD/panag").group == "code" { fail("project_root_meta_next_group changes group"); }
let meta_text = ide.project_root_meta_to_text(meta0);
if not str_contains(meta_text, "#meta|/media/panosboy/ExtHD/panag|AAP Drive|code") { fail("project_root_meta_to_text serializes metadata comments"); }
let meta_parsed = ide.project_root_meta_from_text(meta_text + "/media/panosboy/ExtHD/panag\n");
if ide.project_root_meta_get(meta_parsed, "/media/panosboy/ExtHD/panag").label != "AAP Drive" { fail("project_root_meta_from_text parses metadata comments"); }
let roots_file = ide.project_roots_file_to_text(["/repo"], ide.project_root_meta_set([], "/repo", "Main Repo", "favorite"));
if not str_contains(roots_file, "#meta|/repo|Main Repo|favorite") or not str_contains(roots_file, "/repo\n") { fail("project_roots_file_to_text keeps metadata and roots together"); }
let tree_settings = ide.project_tree_settings(20, 999999);
if tree_settings.depth != 8 or tree_settings.max_items != 5000 { fail("project_tree_settings clamps high values"); }
let tree_settings_low = ide.project_tree_settings(0, 1);
if tree_settings_low.depth != 1 or tree_settings_low.max_items != 50 { fail("project_tree_settings clamps low values"); }
if ide.project_tree_depth_delta(3, 1) != 4 or ide.project_tree_depth_delta(1, 0 - 5) != 1 { fail("project_tree_depth_delta adjusts and clamps depth"); }
let recent = ide.recent_files_push(["/repo/old.sapp", "/repo/main.sapp"], "/repo/main.sapp", 5);
if len(recent) != 2 or recent[0] != "/repo/main.sapp" or recent[1] != "/repo/old.sapp" { fail("recent_files_push dedupes newest first"); }
let recent_limited = ide.recent_files_push(["a", "b", "c"], "d", 2);
if len(recent_limited) != 2 or recent_limited[0] != "d" or recent_limited[1] != "a" { fail("recent_files_push obeys limit"); }
let recent_removed = ide.recent_files_remove(recent, "/repo/main.sapp");
if len(recent_removed) != 1 or recent_removed[0] != "/repo/old.sapp" { fail("recent_files_remove removes by path"); }
let recent_remove_missing = ide.recent_files_remove(recent, "/repo/missing.sapp");
if len(recent_remove_missing) != 2 { fail("recent_files_remove keeps list when path missing"); }
let recent_entries = ide.recent_files_entries(recent, 10);
if len(recent_entries) != 2 or recent_entries[0].name != "main.sapp" or recent_entries[0].display != "[recent] main.sapp" { fail("recent_files_entries builds display rows"); }
let recent_hits = ide.quick_open_candidates(recent_entries, "old", 10);
if len(recent_hits) != 1 or recent_hits[0].path != "/repo/old.sapp" { fail("recent file entries work with quick-open filtering"); }
let qopen_recent = ide.quick_open_with_recent(files, ["/repo/recent.sapp", "editors/ide/pbide.sapp"], "", 10);
if len(qopen_recent) < 4 or qopen_recent[0].label != "[recent] recent.sapp" { fail("quick_open_with_recent prepends recent files"); }
let dup_count = 0;
let qi = 0;
while qi < len(qopen_recent) {
    if qopen_recent[qi].path == "editors/ide/pbide.sapp" { dup_count = dup_count + 1; }
    qi = qi + 1;
}
if dup_count != 1 { fail("quick_open_with_recent dedupes normal/recent paths"); }
let qopen_recent_filter = ide.quick_open_with_recent(files, ["/repo/recent.sapp"], "stdlib", 10);
if len(qopen_recent_filter) < 1 or qopen_recent_filter[0].kind != "dir" or qopen_recent_filter[0].path != "stdlib" { fail("quick_open_with_recent falls back to directory hits"); }
let many_files = [];
let mi = 0;
while mi < 32 {
    array_push(many_files, map{ name: "file" + str(mi) + ".sapp", path: "/repo/file" + str(mi) + ".sapp", kind: "file" });
    mi = mi + 1;
}
let qopen_many = ide.quick_open_with_recent(many_files, [], "", 30);
if len(qopen_many) != 30 { fail("quick_open_with_recent supports more than one visible quick-open page"); }

// ── diagnostics ────────────────────────────────────────────────────────────────
let bad_code = "let x = missing;\nprint x;\n";
let nd = ide.normalize_diagnostic(bad_code, map{ kind: "error", message: "undefined name 'missing'" }, 0);
if nd.kind != "error" or nd.line != 1 { fail("diagnostic infers undefined-name line"); }
if nd.col != 9 { fail("diagnostic infers undefined-name column (got " + str(nd.col) + ")"); }
if not str_contains(nd.source, "missing") { fail("diagnostic includes source line"); }
let ndiags = ide.normalize_diagnostics(bad_code, [map{ kind: "warning", message: "unreachable code after return", line: 2 }]);
if len(ndiags) != 1 or ndiags[0].line != 2 { fail("normalize_diagnostics keeps explicit line"); }
let ds = ide.diagnostic_summary([nd], 5);
if not str_contains(ds[0], "ERROR L1:C9") { fail("diagnostic summary includes location"); }
if len(ide.diagnostic_summary([], 5)) != 1 { fail("empty diagnostic summary is helpful"); }
let mixed_diags = [nd, map{ kind: "warning", message: "second issue", line: 1, col: 1 }, map{ kind: "info", message: "note", line: 2, col: 1 }];
let dcounts = ide.diagnostic_counts(mixed_diags);
if dcounts.total != 3 or dcounts.errors != 1 or dcounts.warnings != 1 or dcounts.info != 1 { fail("diagnostic_counts groups severities"); }
let dlabel = ide.diagnostic_counts_label(mixed_diags);
if not str_contains(dlabel, "1 error") or not str_contains(dlabel, "1 warning") or not str_contains(dlabel, "1 info") { fail("diagnostic_counts_label summarizes mixed severities"); }
if ide.diagnostic_counts_label([]) != "diagnostics: clean" { fail("diagnostic_counts_label handles clean state"); }
let filtered_error = ide.filter_diagnostics(mixed_diags, "error", 10);
if len(filtered_error) != 1 or filtered_error[0].index != 0 or filtered_error[0].kind != "error" { fail("filter_diagnostics filters severity and preserves original index"); }
let filtered_source = ide.filter_diagnostics(mixed_diags, "let x", 10);
if len(filtered_source) != 1 or filtered_source[0].index != 0 { fail("filter_diagnostics matches source text"); }
let filtered_loc = ide.filter_diagnostics(mixed_diags, "l2", 10);
if len(filtered_loc) != 1 or filtered_loc[0].index != 2 { fail("filter_diagnostics matches line token"); }
let filtered_limited = ide.filter_diagnostics(mixed_diags, "", 2);
if len(filtered_limited) != 2 { fail("filter_diagnostics obeys limit"); }
let filter_status = ide.diagnostic_filter_status(mixed_diags, "warning", 0);
if not str_contains(filter_status, "1/3") or not str_contains(filter_status, "sel 1/1") { fail("diagnostic_filter_status shows filtered count and selection"); }
let filter_all = ide.diagnostic_filter_status(mixed_diags, "", 99);
if not str_contains(filter_all, "all 3") or not str_contains(filter_all, "sel 3/3") { fail("diagnostic_filter_status clamps selected index"); }
let filter_none = ide.diagnostic_filter_status(mixed_diags, "nomatch", 0);
if not str_contains(filter_none, "0/3") or str_contains(filter_none, "sel") { fail("diagnostic_filter_status handles empty hits"); }
if ide.selection_move(2, 5, "home", 10) != 0 { fail("selection_move home"); }
if ide.selection_move(2, 5, "end", 10) != 4 { fail("selection_move end"); }
if ide.selection_move(4, 5, "next", 10) != 4 { fail("selection_move clamps next"); }
if ide.selection_move(0, 5, "previous", 10) != 0 { fail("selection_move clamps previous"); }
if ide.selection_move(1, 20, "page_down", 10) != 11 { fail("selection_move page down"); }
if ide.selection_move(5, 20, "page_up", 10) != 0 { fail("selection_move page up clamps"); }
let line_hits = ide.diagnostics_at_line([nd, map{ kind: "warning", message: "second issue", line: 1, col: 1 }], 1);
if len(line_hits) != 2 or line_hits[0].kind != "error" { fail("diagnostics_at_line filters current line"); }
if len(ide.diagnostics_at_line([nd], 2)) != 0 { fail("diagnostics_at_line ignores other lines"); }
let line_status = ide.diagnostic_line_status([nd, map{ kind: "warning", message: "second issue", line: 1, col: 1 }], 1);
if not str_contains(line_status, "line error:") or not str_contains(line_status, "missing") or not str_contains(line_status, "+1") { fail("diagnostic_line_status summarizes caret line issues"); }
if ide.diagnostic_line_status([nd], 2) != "" { fail("diagnostic_line_status stays quiet on clean line"); }
let line_marker = ide.diagnostic_line_marker([map{ kind: "warning", message: "warn", line: 1 }, nd], 1);
if line_marker.marker != "E" or line_marker.severity != "error" or line_marker.count != 2 or not str_contains(line_marker.label, "x2") { fail("diagnostic_line_marker gives error precedence and count"); }
let warn_marker = ide.diagnostic_line_marker([map{ kind: "warning", message: "warn", line: 2 }], 2);
if warn_marker.marker != "W" or warn_marker.severity != "warning" { fail("diagnostic_line_marker handles warning"); }
if ide.diagnostic_line_marker([nd], 2).marker != "" { fail("diagnostic_line_marker stays empty on clean line"); }
let detail_lines = ide.diagnostic_detail_lines(nd, 3);
if len(detail_lines) != 3 or not str_contains(detail_lines[0], "ERROR L1:C9") or not str_contains(detail_lines[1], "missing") or not str_contains(detail_lines[2], "source:") { fail("diagnostic_detail_lines shows location, message, source"); }
let detail_nil = ide.diagnostic_detail_lines(nil, 3);
if len(detail_nil) != 1 or not str_contains(detail_nil[0], "No diagnostic") { fail("diagnostic_detail_lines handles empty selection"); }

// ── status_text ──────────────────────────────────────────────────────────────
let st = ide.status_text(map{ path: "demo.sapp", modified: true, line: 12, col: 5, lines: 40 });
if not str_contains(st, "demo.sapp *") { fail("status shows modified marker"); }
if not str_contains(st, "Ln 12, Col 5") { fail("status shows line/col"); }
if not str_contains(st, "40 lines") { fail("status shows line count"); }
let st2 = ide.status_text(map{ path: "demo.sapp", modified: false, line: 1, col: 2, lines: 3, chars: 22, diagnostics: 4, selection_chars: 5 });
if not str_contains(st2, "22 chars") { fail("status shows char count"); }
if not str_contains(st2, "diagnostics: 4") { fail("status shows diagnostic count"); }
if not str_contains(st2, "sel 5 chars") { fail("status shows selection count"); }
let gt = ide.goto_line_target("12", 40);
if gt.line != 12 or gt.row != 11 or gt.col != 0 { fail("goto_line_target returns 1-based line and 0-based row"); }
let gt_low = ide.goto_line_target("0", 40);
if gt_low.line != 1 or gt_low.row != 0 { fail("goto_line_target clamps low values"); }
let gt_high = ide.goto_line_target("999", 40);
if gt_high.line != 40 or gt_high.row != 39 { fail("goto_line_target clamps high values"); }
let gt_bad = ide.goto_line_target("not a number", 40);
if gt_bad.line != 1 { fail("goto_line_target defaults invalid input to line 1"); }
let opt_plain = ide.open_path_target("src/main.sapp");
if opt_plain.path != "src/main.sapp" or opt_plain.has_line { fail("open_path_target keeps plain paths"); }
let opt_line = ide.open_path_target("src/main.sapp:12");
if opt_line.path != "src/main.sapp" or opt_line.line != 12 or opt_line.col != 1 or not opt_line.has_line or opt_line.has_col { fail("open_path_target parses path:line"); }
let opt_col = ide.open_path_target("src/main.sapp:12:4");
if opt_col.path != "src/main.sapp" or opt_col.line != 12 or opt_col.col != 4 or not opt_col.has_line or not opt_col.has_col { fail("open_path_target parses path:line:col"); }
let opt_win = ide.open_path_target("C:/repo/main.sapp:7:2");
if opt_win.path != "C:/repo/main.sapp" or opt_win.line != 7 or opt_win.col != 2 { fail("open_path_target keeps drive-like colon paths"); }
let opt_text = ide.open_path_target("src/data:latest.sapp");
if opt_text.path != "src/data:latest.sapp" or opt_text.has_line { fail("open_path_target ignores nonnumeric suffixes"); }
let opt_status = ide.open_path_target_status(opt_col);
if opt_status != "src/main.sapp:12:4" { fail("open_path_target_status formats target"); }
let loc1 = map{ path: "demo.sapp", line: 2, col: 1, label: "start" };
let loc2 = map{ path: "demo.sapp", line: 8, col: 4, label: "jump" };
let nav_stack = ide.navigation_push([], loc1, 10);
let nav_stack2 = ide.navigation_push(nav_stack, loc1, 10);
if len(nav_stack2) != 1 { fail("navigation_push suppresses duplicate top location"); }
let nav_stack3 = ide.navigation_push(nav_stack2, loc2, 10);
if len(nav_stack3) != 2 or nav_stack3[0].line != 8 { fail("navigation_push adds newest first"); }
let nav_step = ide.navigation_step(nav_stack3, [], map{ path: "demo.sapp", line: 12, col: 1 }, 10);
if not nav_step.ok or nav_step.target.line != 8 or len(nav_step.source) != 1 or len(nav_step.other) != 1 { fail("navigation_step moves target and current between stacks"); }
let nav_empty = ide.navigation_step([], [], loc1, 10);
if nav_empty.ok { fail("navigation_step reports empty source"); }

// ── history records ───────────────────────────────────────────────────────────────
let hist = [];
hist = ide.push_history(hist, "run", true, "run: ok\n> 3", "print 3;", 2);
hist = ide.push_history(hist, "check", false, "check: 1 problem(s)", "let x = missing;", 2);
hist = ide.push_history(hist, "run", true, "run: ok\n> newest", "print \"newest\";", 2);
if len(hist) != 2 { fail("history is bounded to limit"); }
if hist[0].action != "run" or not hist[0].ok { fail("newest history record first"); }
if hist[1].action != "check" or hist[1].ok { fail("older failed check retained"); }
let hs = ide.history_summary(hist, 10);
if len(hs) != 2 { fail("history_summary emits rows"); }
if not str_contains(hs[0], "RUN OK") { fail("history summary shows action/status"); }
if not str_contains(hs[1], "CHECK FAIL") { fail("history summary shows failure"); }
if len(ide.history_summary([], 10)) < 2 { fail("empty history has helpful placeholder lines"); }
let hf_run = ide.filter_history(hist, "run", 10);
if len(hf_run) != 1 or hf_run[0].index != 0 or hf_run[0].action != "run" { fail("filter_history filters action and preserves original index"); }
let hf_fail = ide.filter_history(hist, "fail", 10);
if len(hf_fail) != 1 or hf_fail[0].index != 1 or hf_fail[0].action != "check" { fail("filter_history filters status"); }
let hf_code = ide.filter_history(hist, "missing", 10);
if len(hf_code) != 1 or hf_code[0].index != 1 { fail("filter_history searches code/output text"); }
let hf_limited = ide.filter_history(hist, "", 1);
if len(hf_limited) != 1 { fail("filter_history obeys limit"); }
let removed_hist = ide.history_delete_selected(hist, hf_fail, 0);
if not removed_hist.ok or len(removed_hist.history) != 1 or removed_hist.removed.action != "check" { fail("history_delete_selected removes selected filtered original row"); }
let removed_direct = ide.history_remove_index(hist, 0);
if not removed_direct.ok or removed_direct.removed.action != "run" or len(removed_direct.history) != 1 { fail("history_remove_index removes direct original row"); }
let removed_none = ide.history_delete_selected(hist, [], 0);
if removed_none.ok or len(removed_none.history) != len(hist) { fail("history_delete_selected handles no hits"); }
let hfs = ide.history_filter_status(hist, "run", 0);
if not str_contains(hfs, "1/2") or not str_contains(hfs, "sel 1/1") { fail("history_filter_status shows filtered count"); }
let hfs_all = ide.history_filter_status(hist, "", 99);
if not str_contains(hfs_all, "all 2") or not str_contains(hfs_all, "sel 2/2") { fail("history_filter_status clamps selected"); }
let hfs_none = ide.history_filter_status(hist, "nomatch", 0);
if not str_contains(hfs_none, "0/2") or str_contains(hfs_none, "sel") { fail("history_filter_status handles empty matches"); }
if ide.history_mode_next("temporary") != "permanent" or ide.history_mode_next("permanent") != "temporary" { fail("history_mode_next toggles storage mode"); }
let hp = ide.push_history_with_mode([], "run", true, "run: ok", "print 1;", 3, "permanent");
if len(hp) != 1 or hp[0].storage != "permanent" or hp[0].stored != false { fail("push_history_with_mode records permanent unsaved entries"); }
let saved_hp = ide.history_mark_stored(hp, true);
if saved_hp[0].stored != true or saved_hp[0].storage != "permanent" { fail("history_mark_stored records saved permanent entries"); }
let hstate_temp = ide.history_storage_state(hist, "temporary", false, "/tmp/hist.json");
if hstate_temp.status != "memory-only" or hstate_temp.has_rows != true { fail("history_storage_state reports temporary memory-only rows"); }
let hstate_unsaved = ide.history_storage_state(hp, "permanent", false, "/tmp/hist.json");
if hstate_unsaved.status != "needs-save" { fail("history_storage_state reports permanent unsaved rows"); }
let hstate_saved = ide.history_storage_state(saved_hp, "permanent", true, "/tmp/hist.json");
if hstate_saved.status != "saved" or not str_contains(ide.history_storage_summary(saved_hp, "permanent", true, "/tmp/hist.json"), "saved") { fail("history_storage_state reports saved permanent rows"); }
let bstate = ide.browser_management_state([map{ url: "https://example.com", title: "Example" }], [map{ url: "https://example.com/file.txt", ok: true }], "safe", false, "duckduckgo");
if bstate.status != "active" or bstate.bookmarks != 1 or bstate.downloads != 1 or not str_contains(ide.browser_management_summary(bstate), "downloads 1") { fail("browser_management_state summarizes bookmark/download data"); }
let browserecs = ide.browser_management_records(bstate);
if len(browserecs) != 4 or browserecs[0].id != "browser_bookmarks" or browserecs[1].id != "browser_downloads" { fail("browser_management_records exposes browser subareas"); }
