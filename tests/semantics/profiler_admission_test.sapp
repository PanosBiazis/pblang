let P=import("stdlib:profiler.sapp");
fn expect(ok,label) {if not ok {throw "FAIL profiler-admission: "+label;}}
let calls=0;let work=fn(){calls=calls+1;return calls;};
for value in [nil,true,false,"private-profiler-marker",[],map{},fn(){return 0;},
    parse_number("NaN"),parse_number("inf"),parse_number("-inf"),-1,0.5,1000001,
    bigint(1),rational("1/1"),decimal("1")] {
    let a=try {P.benchmark("fixture",work,value);true} catch false;
    let b=try {P.warmup(work,value);true} catch false;
    expect(not a and not b and calls==0,"invalid iteration rejected before callback");
}
for value in [nil,true,1,"private-profiler-marker",[],map{}] {
    for iterations in [0,1] {
        let a=try {P.benchmark("fixture",value,iterations);true} catch false;
        let b=try {P.warmup(value,iterations);true} catch false;
        expect(not a and not b,"callback shape includes zero case");
    }
}
let result=P.benchmark("fixture",work,4);
expect(calls==4 and result.result==4 and result.iterations==4,"exact calls and last result");
expect(result.name=="fixture" and len(map_keys(result))==7,"legacy result schema");
P.warmup(work,0);expect(calls==4,"zero warmup");
P.warmup(work,3);expect(calls==7,"warmup count");
expect(type(P.benchmark("builtin",now_ms,1).result)=="number","builtin callback");
let boundary_calls=0;
let boundary=P.benchmark("upper-bound",fn(){boundary_calls=boundary_calls+1;return 9;},1000000);
expect(boundary_calls==1000000 and boundary.iterations==1000000 and boundary.result==9,"inclusive upper bound");
P.warmup(fn(){boundary_calls=boundary_calls+1;},1000000);
expect(boundary_calls==2000000,"warmup inclusive upper bound");
let failed=try P.benchmark("throws",fn(){throw "expected-profiler-fixture-error";},1) catch "caught";
expect(failed=="caught","benchmark callback exceptions propagate");
expect(json_stringify(P.clock_info())==json_stringify(map{source:"now_ms",monotonic:false,unit:"ms"}),"clock capability disclosure");
P.reset();P.disable();
P.trace(fn(){P.enable();return 1;});expect(len(P.trace_log())==0,"disabled at entry remains unrecorded");
P.trace(fn(){P.disable();return 1;});expect(len(P.trace_log())==1,"enabled at entry retains completed record");
P.reset();
print "profiler_admission_pass";
