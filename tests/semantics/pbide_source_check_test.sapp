let C=import("editors/ide/pbide_source_check.sapp");
let W=import("editors/ide/pbide_text_web.sapp");
fn first(source) { return C.check(source).diagnostics[0].message; }
for source in ["", "let n=3; print n;", "throw \"must not execute\";",
    "let absent=import(\"/missing/private-source-marker\");", "print \"(((([[[{{{\"; // }}}]]]))))\n"] {
    assert(C.check(source).ok,"analysis-only valid input");
}
assert(not C.check("let x=;").ok and not C.check("print missing;").ok,"syntax and names checked");
for value in [nil,false,3,[],map{},str_repeat("a",4097),str_repeat("😀",1025)] {
    assert(first(value)=="Source check limit exceeded.","direct source bound");
}
assert(C.check("print "+str_repeat("(",64)+"1"+str_repeat(")",64)+";").ok,"inclusive depth bound");
assert(first(str_repeat("(",65)+"1")=="Source nesting limit exceeded.","excess depth rejected");
assert(first(")"+str_repeat("(",65))=="Unbalanced source delimiters.","negative depth cannot mask nesting");
assert(C.check(str_repeat("1;",1023)+"1").ok,"inclusive token cap including EOF");
assert(first(str_repeat(";",2048))=="Source token limit exceeded.","token overflow before parser");
let rows=[];
for _i 40 { array_push(rows,map{kind:"<script>",message:str_repeat("<script>&",80)}); }
let rendered=C.render(map{ok:false,diagnostics:rows});
assert(len(str_to_bytes(rendered))<=C.MAX_RENDER_BYTES and not str_contains(rendered,"<script>")
    and str_contains(rendered,"&lt;script&gt;") and str_contains(rendered,"Additional diagnostics omitted"),"escaped aggregate output bound");
let source="let x=;";
let body="source="+url_encode(source)+"&start=0&end=0&insert=&op=check&pair=round";
let request=map{method:"POST",path:"/edit",body:body,headers:map{host:"127.0.0.1:18771",
    origin:"http://127.0.0.1:18771","content-type":"application/x-www-form-urlencoded",
    "content-length":str(len(str_to_bytes(body)))}};
let reply=W.handle(request,18771);
assert(reply.status==200 and str_contains(reply.body,"Source check") and str_contains(reply.body,"error:")
    and str_contains(reply.body,source) and W.parse_form(body).text==source,"Check preserves submitted source and exposes diagnostics");
assert(str_contains(reply.headers["Content-Security-Policy"],"script-src 'none'"),"Check keeps no-script policy");
print "pbide_source_check_pass";
