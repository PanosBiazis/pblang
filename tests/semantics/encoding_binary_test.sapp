// tests/semantics/encoding_binary_test.sapp — differential test of the
// pure-pblang reference encoders in stdlib/encoding.sapp against the native
// Rust builtins. This is Bootstrap_safety Layer 2 (differential testing):
// the self-hosted reference implementation must agree with the reference
// runtime for every input, including multi-byte UTF-8.
import "stdlib:encoding.sapp";

let samples = ["", "A", "hello", "héllo wörld", "日本語", "mixed: café ☕"];

for i in 0 to len(samples) - 1 {
    let s = samples[i];

    // hex_encode must match the native builtin byte-for-byte.
    let ref_hex = encoding.hex_encode(s);
    let nat_hex = hex_encode(s);
    if ref_hex != nat_hex {
        throw "FAIL hex_encode drift for '" + s + "': ref=" + ref_hex + " nat=" + nat_hex;
    }

    // hex_decode(hex_encode(s)) must round-trip back to s.
    let rt = encoding.hex_decode(ref_hex);
    if rt != s {
        throw "FAIL hex round-trip for '" + s + "': got '" + str(rt) + "'";
    }
}

// url_encode/url_decode round-trip, including multi-byte (per-byte %escapes).
let urls = ["hello world", "a+b=c & d/e?f", "café ☕", "日本語"];
for i in 0 to len(urls) - 1 {
    let u = urls[i];
    let rt = encoding.url_decode(encoding.url_encode(u));
    if rt != u {
        throw "FAIL url round-trip for '" + u + "': got '" + str(rt) + "'";
    }
}

// csv_encode/csv_decode round-trip (exercises string indexing in the parser).
let rows = [["a", "b,c", "d"], ["1", "2", "with \"quote\""]];
let csv = encoding.csv_encode(rows);
let parsed = encoding.csv_decode(csv);
if len(parsed) != 2 or parsed[0][1] != "b,c" or parsed[1][2] != "with \"quote\"" {
    throw "FAIL csv round-trip: " + str(parsed);
}

print "encoding_binary_pass";
