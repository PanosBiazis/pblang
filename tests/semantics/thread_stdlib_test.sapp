// tests/semantics/thread_stdlib_test.sapp — stdlib:thread.sapp wrapper (updated for v0.5)
let thread = import("stdlib:thread.sapp");

// Single worker drains jobs until nil (deterministic; avoids multi-worker races).
let jobs = thread.channel_new();
let results = thread.channel_new();

// Factory function: captures only channel handles (numbers) — safe to spawn.
fn make_worker(jr, rs) {
    return fn() {
        let job = recv(jr);
        while job != nil {
            send(rs, job * 2);
            job = recv(jr);
        }
    };
}

let worker_fn = make_worker(jobs.receiver, results.sender);
let worker = thread.thread_spawn(worker_fn);

thread.send_value(jobs.sender, 1);
thread.send_value(jobs.sender, 2);
thread.send_value(jobs.sender, 3);
thread.send_value(jobs.sender, 4);
thread.send_value(jobs.sender, nil);

thread.thread_join(worker);

let total = 0;
let i = 0;
while i < 4 {
    total = total + thread.recv_value(results.receiver);
    i = i + 1;
}

if total != 20 {
    print "FAIL thread_stdlib_total";
}

thread.channel_close_sender(results);
if thread.channel_is_done(results) == false {
    print "FAIL thread_stdlib_close";
}

print "thread_stdlib_test: pass";
