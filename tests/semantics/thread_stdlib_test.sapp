// tests/semantics/thread_stdlib_test.sapp — T5-alpha thread stdlib wrapper test
import "stdlib:thread.sapp";

// Test basic spawn and join
let results = thread.channel_new();

let worker1 = thread.spawn(fn() {
    thread.send_value(results.sender, 5);
});

let worker2 = thread.spawn(fn() {
    thread.send_value(results.sender, 15);
});

thread.join(worker1);
thread.join(worker2);

let r1 = thread.recv_value(results.receiver);
let r2 = thread.recv_value(results.receiver);
let total = r1 + r2;

// total should be 20 (5 + 15)
if total == 20 {
    print "thread_channel_sum: ok";
} else {
    print "thread_channel_sum: FAIL total=" + total;
}

// Test channel_close and channel_is_closed
let ch = thread.channel_new();
let closed_before = thread.channel_is_closed_wrapper(ch.sender);
thread.channel_close_wrapper(ch.sender);
let closed_after = thread.channel_is_closed_wrapper(ch.sender);

if closed_before == false and closed_after == true {
    print "channel_close: ok";
} else {
    print "channel_close: FAIL";
}

print "thread_stdlib_test: pass";
