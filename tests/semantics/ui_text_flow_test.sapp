let UI=import("stdlib:modern_ui.sapp");
let GUI=import("stdlib:gui.sapp");
let Flow=import("stdlib:text_flow.sapp");
let Web=import("stdlib:modern_ui_web.sapp");
let Android=import("stdlib:modern_ui_android.sapp");
let Design=import("stdlib:ide_typography.sapp");
let Parse=import("stdlib:gui_parse.sapp");
let text="Readable text adapts to the available width and stays above the following control.";
let tree=UI.screen([UI.text(text,map{name:"copy",wrap:true,font_size:12}),UI.button("Next",nil,map{name:"next"})],map{padding:10,gap:8});
let form=UI.build("Flow",tree,map{width:360,height:600});
let copy=GUI.get(form,"copy");let next=GUI.get(form,"next");
let expected=Flow.layout(text,copy.w/form.viewport.ui_scale,copy);
assert(copy.h==len(expected.lines)*expected.metrics.line_height*form.viewport.ui_scale,"measurement reserves all rows");
assert(next.y>=copy.y+copy.h,"following widget never overlaps auto-height text");
let before=copy.h;GUI.relayout(form,720,600);
assert(copy.h<=before,"wider layout reflows text");
let css=Web.generate("Flow",UI.compile(tree,map{target:"web"})).css;
assert(str_contains(css,"white-space:pre-line") and str_contains(css,"-webkit-line-clamp:64"),"Web wrapping emitted");
let compiled=UI.compile(tree,map{target:"android"});let bytes=Android.activity_class(compiled);
tree.children[0].max_lines=2;
assert(bytes!=Android.activity_class(compiled),"Android line limit reaches bytecode");
tree.children[0].wrap=false;
assert(str_contains(Web.generate("Flow",UI.compile(tree,map{target:"web"})).css,"white-space:nowrap"),"explicit false selects single line Web");
for bad in ["true",1,nil,[]] {assert(not UI.validate(UI.screen([UI.text("x",map{wrap:bad})])).ok,"invalid wrap rejected");}
for bad in [0,65,1.5,"3"] {assert(not UI.validate(UI.screen([UI.text("x",map{max_lines:bad})])).ok,"invalid line limit rejected");}
let label=GUI.styled_label("flow",0,0,120,60,text,map{wrap:true,max_lines:3});
let source="let gui=import(\"stdlib:gui.sapp\");fn build(){let f=gui.form(\"Flow\",200,200);gui.add(f,"+Design.native_source(label)+");return f;}";
let parsed=Parse.parse_strict(source);
assert(parsed.ok and parsed.widgets[0].props.wrap and parsed.widgets[0].props.max_lines==3,"Designer round-trip retains flow");
assert(Design.cycle(label,"wrap") and not label.wrap and label.max_lines==3,"toggle retains chosen line limit");
assert(Design.cycle(label,"wrap") and label.wrap,"toggle restores wrapping");
let small=GUI.label("small",0,0,"one two three");small.w=60;
assert(Design.cycle(small,"wrap") and small.h>=69,"Designer toggle reserves wrapped rows for a default label");
for scale in [1,1.5,2] {
    let f=GUI.form("Flow",300,200);GUI.set_text_render(f,"auto");f.viewport.ui_scale=scale;
    let w=GUI.styled_label("copy",10,10,120*scale,30*scale,"one two three four five six seven eight nine ten",map{wrap:true,font_size:12,max_lines:4});
    GUI.add(f,w);let calls=[];
    let win=map{clear:fn(c){},rect:fn(a,b,c,d,e){},line:fn(a,b,c,d,e){},textAA:fn(x,y,t,c,h,a){array_push(calls,map{x:x,y:y,text:t,h:h,a:a});return map{ok:true};}};
    GUI.draw(win,f);
    assert(len(calls)==2,"explicit height caps visible rows at every scale");
    assert(str_contains(calls[1].text,"..."),"height clipping signals missing text");
    for call in calls {assert(call.x+len(call.text)*call.a<=w.x+w.w and call.y>=w.y and call.y+call.h<=w.y+w.h,"scaled text stays inside label");}
}
let dynamic=UI.screen([UI.text("Short",map{name:"status",wrap:true}),
    UI.button("Expand",nil,map{name:"expand",action:UI.action_set_text("status",text)})]);
let dynamic_form=UI.build("Dynamic",dynamic,map{width:360,height:600});
let status=GUI.get(dynamic_form,"status");let short_h=status.h;
GUI.get(dynamic_form,"expand").onclick(dynamic_form);
assert(status.h>short_h and GUI.get(dynamic_form,"expand").y>=status.y+status.h,"text action reflows before drawing");
assert(dynamic.children[0].text=="Short","reflow leaves caller tree intact");
print "ui_text_flow_pass";
