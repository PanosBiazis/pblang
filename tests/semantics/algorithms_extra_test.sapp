// tests/semantics/algorithms_extra_test.sapp
// Borůvka MST ("babuska"), onion-peeling/convex-layers ("onion"), plus union-find,
// Kruskal, convex hull, Kadane, KMP, Floyd–Warshall.
let alg = import("stdlib:algorithms_extra.sapp");

fn fail(m) { throw "FAIL " + m; }

// ── union-find ───────────────────────────────────────────────────────────────
let uf = alg.uf_new(5);
if not alg.uf_union(uf, 0, 1) { fail("uf_union 0,1"); }
if not alg.uf_union(uf, 1, 2) { fail("uf_union 1,2"); }
if alg.uf_union(uf, 0, 2) { fail("uf_union 0,2 should already be connected"); }
if alg.uf_find(uf, 0) != alg.uf_find(uf, 2) { fail("uf 0 and 2 same root"); }
if alg.uf_find(uf, 3) == alg.uf_find(uf, 0) { fail("uf 3 separate"); }

// ── Borůvka & Kruskal MST (weight 6 on this graph) ───────────────────────────
let edges = [
    map{ from: 0, to: 1, weight: 1 }, map{ from: 1, to: 2, weight: 2 },
    map{ from: 2, to: 3, weight: 3 }, map{ from: 0, to: 3, weight: 4 },
    map{ from: 0, to: 2, weight: 5 }
];
let bv = alg.boruvka(4, edges);
if bv.weight != 6 { fail("boruvka weight (got " + str(bv.weight) + ")"); }
if len(bv.edges) != 3 { fail("boruvka edge count"); }
let kr = alg.kruskal(4, edges);
if kr.weight != 6 { fail("kruskal weight"); }

// ── convex hull (interior point excluded) ────────────────────────────────────
let hull = alg.convex_hull([[0,0],[4,0],[4,4],[0,4],[2,2]]);
if len(hull) != 4 { fail("convex_hull corners (got " + str(len(hull)) + ")"); }

// ── onion peeling (outer + inner square -> 2 layers) ─────────────────────────
let layers = alg.onion_peeling([[0,0],[6,0],[6,6],[0,6],[2,2],[4,2],[4,4],[2,4]]);
if len(layers) != 2 { fail("onion layers (got " + str(len(layers)) + ")"); }
if len(layers[0]) != 4 or len(layers[1]) != 4 { fail("onion layer sizes"); }

// ── Kadane max subarray ──────────────────────────────────────────────────────
let kd = alg.kadane([0-2, 1, 0-3, 4, 0-1, 2, 1, 0-5, 4]);
if kd.sum != 6 { fail("kadane sum (got " + str(kd.sum) + ")"); }

// ── KMP search ───────────────────────────────────────────────────────────────
if alg.kmp_search("abxabcabcaby", "abcaby") != 6 { fail("kmp_search index"); }
if alg.kmp_search("aaa", "bb") != 0 - 1 { fail("kmp_search not found -> -1"); }
let allm = alg.kmp_search_all("ababab", "ab");
if len(allm) != 3 or allm[0] != 0 or allm[2] != 4 { fail("kmp_search_all"); }

// ── Floyd–Warshall (0->1->2 = 3 beats direct 10) ─────────────────────────────
let INF = 1000000000;
let d = alg.floyd_warshall([[0,1,10],[INF,0,2],[INF,INF,0]]);
if d[0][2] != 3 { fail("floyd_warshall 0->2 (got " + str(d[0][2]) + ")"); }

print "algorithms_extra_pass";
