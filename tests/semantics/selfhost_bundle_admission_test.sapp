// The linker must never report success while retaining a source import.
let B = import("stdlib:selfhost_bundle.sapp");
let VM = import("stdlib:compiler/vm.sapp");
let N = import("stdlib:compiler/native_bundle.sapp");
let calls = [];
fn resolve(path) {
    array_push(calls, path);
    if path == "leaf" { return "fn answer(){return 7;} export answer;"; }
    if path == "branch" { return "let leaf_mod = import /*gap*/ ( \"leaf\" ); fn branch_answer(){return leaf_mod.answer();} export branch_answer;"; }
    if path == "stdlib/leaf" { return "fn canonical(){return 17;} export canonical;"; }
    return nil;
}
fn valid(source, expected, count) {
    calls = [];
    let b = B.bundle(source, resolve);
    assert(b.ok and b.modules == count, "accepted static graph");
    assert(VM.run(b.chunk).output[0] == expected, "linked output");
    assert(len(calls) == count, "each dependency resolved once");
}
valid("let m=import /*gap*/ (\"leaf\"); print m.answer();", 7, 1);
valid("let m=import(\"le\\u0061f\"); print m.answer();", 7, 1);
valid("let m=import(\"branch\");print m.branch_answer();",7,2);
valid("let a=import(\"stdlib:leaf\");let b=import (\"stdlib/leaf\");print a.canonical()+b.canonical();",34,1);
valid("// import(\"missing\")\nprint 42;",42,0);
for source in [
    "let path=\"leaf\"; let m=import(path);",
    "let load=import; let m=load(\"leaf\");",
    "fn load(){return import (\"leaf\");} print 1;",
    "print (try import (\"leaf\") catch nil);",
    "let m=import(7);",
    "let m=import(\"\");",
    "let m=import(\"a\\u0000b\");",
    "let __bundle_0=7;print __bundle_0;",
    "let n:number=nil-1; let m=import(\"leaf\");",
    "let m=import(\"private_fixture_path\");print 1e;",
    "/* private_fixture_literal",
    str_repeat(" ",8388608)+str_repeat(" ",8388609)
] {
    calls=[];
    let rejected=B.bundle(source,resolve);
    assert(not rejected.ok and len(calls)==0,"invalid main refused before resolver");
    assert(not str_contains(rejected.reason,"private_fixture"),"diagnostic excludes source/path");
}
let oversized=B.bundle("let m=import(\"x\");",fn(path){return str_repeat(" ",1048577)+"print 1;";});
assert(not oversized.ok,"module byte admission bound");
let nested = B.bundle("let m=import(\"x\");", fn(path){return "fn f(){return import (\"leaf\");} export f;";});
assert(not nested.ok,"nested module import rejected");
let escaped = B.bundle("let m=import(\"private_fixture_path\");",fn(path){throw "private_fixture_resolver_error";});
assert(not escaped.ok and not str_contains(escaped.reason,"private_fixture"),"resolver diagnostics private");
let cycle=B.bundle("let m=import(\"cycle\");",fn(path){return "let c=import (\"cycle\");print 1;";});
assert(not cycle.ok,"cycle refused");
let nodes=0;
let depth=B.bundle("let m=import(\"0\");",fn(path){
    nodes=nodes+1;
    return "let dep"+path+"=import(\""+str(nodes)+"\");print 1;";
});
assert(not depth.ok and nodes==32,"depth bound before extra resolver");
let many="";
for i 65 {many=many+"let m"+str(i)+"=import(\""+str(i)+"\");";}
nodes=0;
let wide=B.bundle(many,fn(path){nodes=nodes+1;return "let v"+path+"=1;";});
assert(not wide.ok and nodes==64,"module count bound before extra resolver");
assert((try {N.compile_bundle("let p=\"leaf\";import(p);",resolve);false} catch true),"native bridge fails closed");
// Bounds are inclusive, and one rejected graph cannot poison later calls.
nodes=0;
let allowed=B.bundle("let m=import(\"0\");",fn(path){
    nodes=nodes+1;
    if nodes==32 {return "let leaf_value=7;";}
    return "let dep"+path+"=import(\""+str(nodes)+"\");print 1;";
});
assert(allowed.ok and allowed.modules==32,"depth boundary admitted");
let bad_module=B.bundle("let m=import(\"private_fixture_path\");",fn(path){return "print private_fixture_undefined;";});
assert(not bad_module.ok and not str_contains(bad_module.reason,"private_fixture"),"module diagnostic private");
valid("let m=import (\"leaf\");print m.answer();",7,1);
print "selfhost_bundle_admission_pass";
