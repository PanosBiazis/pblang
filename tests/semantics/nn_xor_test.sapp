// Test: stdlib/nn.sapp — a trainable neural network learns XOR (pbAI foundation).
// XOR is NOT linearly separable, so a model that solves it must have a hidden
// layer AND must actually train via backprop. This proves pblang can train models
// from scratch, not just call external ones.

let nn = import("stdlib:nn.sapp");

let net = nn.mlp_new(2, 4, 1, 42);
let data = [
    nn.sample([0, 0], [0]),
    nn.sample([0, 1], [1]),
    nn.sample([1, 0], [1]),
    nn.sample([1, 1], [0]),
];

// Loss before training (random-ish init) vs after.
let loss_before = 0;
let i = 0;
while i < len(data) {
    let y = nn.predict(net, data[i].x)[0];
    let e = y - data[i].y[0];
    loss_before = loss_before + e * e;
    i = i + 1;
}

let final_loss = nn.train(net, data, 2500, 0.7);

// After training, predictions must be on the correct side of 0.5 for all 4 cases.
let p00 = nn.predict(net, [0, 0])[0];
let p01 = nn.predict(net, [0, 1])[0];
let p10 = nn.predict(net, [1, 0])[0];
let p11 = nn.predict(net, [1, 1])[0];

assert(p00 < 0.5, "XOR(0,0) -> 0 learned (got " + str(p00) + ")");
assert(p01 > 0.5, "XOR(0,1) -> 1 learned (got " + str(p01) + ")");
assert(p10 > 0.5, "XOR(1,0) -> 1 learned (got " + str(p10) + ")");
assert(p11 < 0.5, "XOR(1,1) -> 0 learned (got " + str(p11) + ")");

// Training must have reduced the loss substantially.
assert(final_loss < loss_before, "training reduced loss (before " + str(loss_before) + " -> after " + str(final_loss) + ")");
assert(final_loss < 0.1, "final loss is small (converged): " + str(final_loss));

// argmax helper sanity
assert(nn.argmax([0.1, 0.9, 0.3]) == 1, "argmax picks the max index");

print "nn_xor_pass";
