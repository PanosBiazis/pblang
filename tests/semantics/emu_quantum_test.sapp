// emu_quantum_test.sapp — a verified QUANTUM state-vector simulator in pblang (the "most futuristic" end).
//
// pblang already has a QASM backend (stdlib/codegen_qasm.sapp) that emits OpenQASM. This is the execution model
// for it: a real state-vector simulator over 2^n complex amplitudes. X/H/Z/CNOT on a |0..0> input keep every
// amplitude REAL, so real arithmetic is exact here — and results are checked against the known quantum answers
// (deterministic gates, superposition probabilities, and genuine two-qubit ENTANGLEMENT). Same standard as the
// classical emulators: run the circuit, verify the computed state — no quantum hardware needed.

fn fail(m) { throw "FAIL emu-quantum: " + m; }
fn _pow2(n) { let r = 1; let i = 0; while i < n { r = r * 2; i = i + 1; } return r; }
fn _bit(i, q) { return num_floor(i / _pow2(q)) % 2; }
fn approx(got, want, m) { let d = got - want; if d < 0 { d = 0 - d; } if d > 0.000000001 { fail(m + ": got " + str(got) + " want " + str(want)); } }

// ── state-vector engine ──  a register of n qubits initialised to |0..0>.
fn qnew(nq) { let dim = _pow2(nq); let s = []; let i = 0; while i < dim { push(s, 0); i = i + 1; } s[0] = 1; return map{ n: nq, amp: s }; }
fn gate_x(st, q) {          // Pauli-X (NOT): |0>↔|1> on qubit q
    let dim = _pow2(st.n); let a = st.amp; let p = _pow2(q); let i = 0;
    while i < dim { if _bit(i, q) == 0 { let j = i + p; let t = a[i]; a[i] = a[j]; a[j] = t; } i = i + 1; }
}
fn gate_z(st, q) {          // Pauli-Z: phase flip on |1>
    let dim = _pow2(st.n); let a = st.amp; let i = 0;
    while i < dim { if _bit(i, q) == 1 { a[i] = 0 - a[i]; } i = i + 1; }
}
fn gate_h(st, q) {          // Hadamard: creates/removes superposition
    let h = 0.7071067811865476; let dim = _pow2(st.n); let a = st.amp; let p = _pow2(q); let i = 0;
    while i < dim { if _bit(i, q) == 0 { let j = i + p; let x = a[i]; let y = a[j]; a[i] = (x + y) * h; a[j] = (x - y) * h; } i = i + 1; }
}
fn gate_cnot(st, c, t) {    // controlled-NOT: flip target t when control c is |1>
    let dim = _pow2(st.n); let a = st.amp; let p = _pow2(t); let i = 0;
    while i < dim { if _bit(i, c) == 1 and _bit(i, t) == 0 { let j = i + p; let tmp = a[i]; a[i] = a[j]; a[j] = tmp; } i = i + 1; }
}
fn prob1(st, q) { let dim = _pow2(st.n); let a = st.amp; let pr = 0; let i = 0; while i < dim { if _bit(i, q) == 1 { pr = pr + a[i] * a[i]; } i = i + 1; } return pr; }
fn pstate(st, idx) { return st.amp[idx] * st.amp[idx]; }   // probability of basis state |idx>

// ── verified quantum circuits ──
// X|0> = |1>  (deterministic NOT)
let q = qnew(1); gate_x(q, 0);
approx(prob1(q, 0), 1, "X|0> -> |1>");

// X;X = identity
q = qnew(1); gate_x(q, 0); gate_x(q, 0);
approx(prob1(q, 0), 0, "X;X|0> -> |0>");

// H|0> = (|0>+|1>)/sqrt2 : each outcome is 50%
q = qnew(1); gate_h(q, 0);
approx(pstate(q, 0), 0.5, "H|0> P(0)=1/2");
approx(pstate(q, 1), 0.5, "H|0> P(1)=1/2");

// H;Z;H|0> = |1>  (Z between Hadamards is a NOT in the computational basis)
q = qnew(1); gate_h(q, 0); gate_z(q, 0); gate_h(q, 0);
approx(prob1(q, 0), 1, "H;Z;H|0> -> |1>");

// Bell state: H(q0) then CNOT(q0->q1) = (|00>+|11>)/sqrt2 — genuine entanglement
q = qnew(2); gate_h(q, 0); gate_cnot(q, 0, 1);
approx(pstate(q, 0), 0.5, "Bell P(00)=1/2");   // |00>
approx(pstate(q, 3), 0.5, "Bell P(11)=1/2");   // |11>
approx(pstate(q, 1), 0,   "Bell P(01)=0");     // |01> impossible — correlated
approx(pstate(q, 2), 0,   "Bell P(10)=0");     // |10> impossible

// GHZ state on 3 qubits: H(0), CNOT(0,1), CNOT(1,2) = (|000>+|111>)/sqrt2
q = qnew(3); gate_h(q, 0); gate_cnot(q, 0, 1); gate_cnot(q, 1, 2);
approx(pstate(q, 0), 0.5, "GHZ P(000)=1/2");   // |000>
approx(pstate(q, 7), 0.5, "GHZ P(111)=1/2");   // |111>

print "emu_quantum: state-vector simulator — X/H/Z/CNOT, superposition, Bell & GHZ entanglement all correct";
