let GP = import("stdlib:compiler/guard_preprocessor.sapp");
let F = import("stdlib:compiler/selfhost_frontend.sapp");
let VM = import("stdlib:compiler/vm.sapp");
fn expect(value, message) { if not value { throw "FAIL guard_preprocessor_strings: " + message; } }

// Compare runtime values, not merely parse success. Type-only legacy result
// diagnostics remain a separate issue; run only these fixed synthetic chunks.
fn value(source) {
    let compiled = F.frontend_compile_with_guard_prep(source);
    expect(len(compiled.ast.errors) == 0, "complete source remains parseable");
    expect(len(compiled.chunk.instructions) > 0, "complete source has inspectable code");
    let run = VM.run_bounded(compiled.chunk, map{ max_steps: 2000, max_frames: 8 });
    return run.globals.result;
}

expect(value("let result = match 1 { case n if n > 0 ~ \"a\\\";b\"; else: \"z\"; };") == "a\";b",
    "escaped quote and semicolon in selected arm");
expect(value("let result = match 0 { case n if n > 0 ~ \"x\"; else: \"a\\\";b\"; };") == "a\";b",
    "escaped quote and semicolon in default arm");
expect(value("let result = match \"a\\\"{b\" { case n if true ~ \"ok\"; else: \"bad\"; };") == "ok",
    "escaped quote and brace in scrutinee");
expect(value("let result = match \"a~b\" { case n if n == \"a~b\" ~ \"ok\"; else: \"bad\"; };") == "ok",
    "guard string separator is not syntax");
expect(value("let result = match \"n\" { case n if n == \"n\" ~ \"ok\"; else: \"bad\"; };") == "ok",
    "guard identifier replacement does not rewrite string literal");
expect(value("let result = match \"a#b\" { case n if n == \"a#b\" # \"ok\"; else: \"bad\"; };") == "ok",
    "legacy hash separator outside string");
expect(value("let result = match 1 { case n if true ~ \"λ😀\\\\\"; else: \"bad\"; };") == "λ😀\\",
    "even backslash sequence closes string");
expect(GP.replace_ident("n == \"n\\\";n\" and nn == n", "n", "value")
    == "value == \"n\\\";n\" and nn == value", "identifier replacement preserves quoted bytes and whole names");

let prefix = "\"escaped \\\" match { ~ }\"; ";
expect(GP.find_next_match(prefix + "match 1 {}", 0) == len(prefix), "skip quoted match keyword");
let brace = "{ \"escaped \\\" }\" }";
expect(GP.find_matching_brace(brace, 0) == len(brace) - 1, "skip quoted closing brace");

expect(GP.replace_ident("n + 1", "", "value") == "n + 1", "empty identifier replacement is a no-op");
for text in ["\"unfinished", "\"trailing\\", "\"odd\\\\\\\""] {
    expect(GP.find_next_match(text, 0) == -1, "unfinished literal does not expose match");
    expect(GP.find_matching_brace("{ " + text, 0) == -1, "unfinished literal has no closing brace");
    expect(GP.replace_ident("n == " + text, "n", "value") == "n == " + text,
        "unfinished replacement input remains unchanged");
    let source = "match 1 { case n if true ~ " + text;
    expect(GP.transform_match(source, 0) == nil, "unfinished match transformation fails");
    expect(GP.preprocess(source) == source, "unfinished source remains available for diagnostics");
}
expect(value("let result = match \"a\\\";~#b\" { case n if n == \"a\\\";~#b\" ~ \"ok\"; else: \"bad\"; };") == "ok",
    "escaped guard literal preserves delimiters and bytes");
expect(value("let result = match 1 { case n if true ~ \"\\\";~#{} match n\"; else: \"bad\"; };") == "\";~#{} match n",
    "syntax-looking arm value stays literal");
expect(value("let result = match 0 { case n if n > 0 ~ \"bad\"; else: \"\\\";~#{} match n\"; };") == "\";~#{} match n",
    "syntax-looking default value stays literal");
print "guard_preprocessor_strings_pass";
