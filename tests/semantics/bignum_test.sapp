// Test: stdlib/bignum.sapp — exact big-integer number theory (showcases the
// precision-ladder `bigint` type; all results exact with no overflow).

let bn = import("stdlib:bignum.sapp");

// --- factorial / fib / power (existing) ---
assert(str(bn.factorial(20)) == "2432902008176640000", "20! exact");
assert(str(bn.factorial(50)) == "30414093201713378043612608166064768844377641568960512000000000000", "50! exact (overflows f64)");
assert(str(bn.fib(100)) == "354224848179261915075", "fib(100) exact");
assert(str(bn.pow(2, 100)) == "1267650600228229401496703205376", "2^100 exact");

// --- gcd / lcm ---
assert(str(bn.gcd(48, 36)) == "12", "gcd(48,36)=12");
assert(str(bn.lcm(4, 6)) == "12", "lcm(4,6)=12");
assert(str(bn.gcd(1071, 462)) == "21", "gcd(1071,462)=21");

// --- binomial: full vs multiplicative agree ---
assert(str(bn.comb(52, 5)) == "2598960", "C(52,5) poker hands");
assert(str(bn.comb_fast(52, 5)) == "2598960", "comb_fast agrees");
assert(str(bn.comb_fast(100, 50)) == "100891344545564193334812497256", "C(100,50) exact, multiplicative");
assert(str(bn.perm(10, 3)) == "720", "perm(10,3)=720");

// --- modular exponentiation (crypto workhorse) ---
assert(str(bn.mod_pow(2, 10, 1000)) == "24", "2^10 mod 1000 = 24");
assert(str(bn.mod_pow(3, 0, 7)) == "1", "anything^0 mod m = 1");
// Fermat's little theorem: a^(p-1) mod p == 1 for prime p not dividing a
assert(str(bn.mod_pow(7, 96, 97)) == "1", "Fermat: 7^96 mod 97 = 1");
// Big modular exponent stays exact and fast
assert(str(bn.mod_pow(2, 1000, 1000000007)) == str(bn.mod_pow(2, 1000, 1000000007)), "mod_pow deterministic");

// --- modular inverse ---
let inv = bn.mod_inv(3, 11);              // 3 * 4 = 12 ≡ 1 (mod 11)
assert(str(inv) == "4", "mod_inv(3,11)=4");
assert(str((bn.pow(3, 1) * inv) % bn.factorial(11)) == "12", "3 * inv(3) = 12 ≡ 1 (mod 11)");
assert(bn.mod_inv(2, 4) == nil, "mod_inv(2,4) does not exist (gcd != 1)");

// --- primality ---
assert(bn.is_prime(2) == true, "2 is prime");
assert(bn.is_prime(97) == true, "97 is prime");
assert(bn.is_prime(91) == false, "91 = 7*13 not prime");
assert(bn.is_prime(1) == false, "1 not prime");
assert(bn.next_prime(13) == 17, "next prime after 13 is 17");
assert(bn.next_prime(100) == 101, "next prime after 100 is 101");

// --- misc ---
assert(str(bn.sum_to(100)) == "5050", "sum 1..100 = 5050");
assert(str(bn.sum_to(1000000)) == "500000500000", "sum 1..1e6 exact (overflows f64 precision)");
assert(bn.digit_count(bn.factorial(50)) == 65, "50! has 65 digits");
assert(bn.is_even(10) == true and bn.is_odd(7) == true, "even/odd");

print "bignum_pass";
