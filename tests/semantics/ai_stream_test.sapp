// ai_stream_test.sapp
// Verify parse_sse_line and get_stream shim work correctly.
import "stdlib:http.sapp";

let r1 = http.parse_sse_line("data: {\"token\": \"hello\"}");
if r1.kind != "data" { print "FAIL parse_sse_line kind"; }
if r1.value != "{\"token\": \"hello\"}" { print "FAIL parse_sse_line value"; }

let r2 = http.parse_sse_line("event: token");
if r2.kind != "event" { print "FAIL parse_sse_line event kind"; }

let r3 = http.parse_sse_line("   ");
if r3 != nil { print "FAIL parse_sse_line empty"; }

print "ai_stream_test: pass";
