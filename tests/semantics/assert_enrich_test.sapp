// tests/semantics/assert_enrich_test.sapp — enrichment for stdlib/assert.sapp
// Exercises only the PASSING path (assert prints "FAIL" on failure, which would trip the
// harness); verifies return values + the pass tally.

let A = import("stdlib/assert.sapp");

fn fail(m) { throw "FAIL_TEST " + m; }
fn t(v, m) { if v != true { fail(m); } }

A.reset();

// comparison (true branch returns true)
t(A.gt(3, 2, nil), "gt");
t(A.lt(1, 2, nil), "lt");
t(A.gte(2, 2, nil), "gte");
t(A.lte(2, 2, nil), "lte");

// boolean
t(A.is_true(true, nil), "is_true");
t(A.is_false(false, nil), "is_false");

// approx
t(A.approx(1.0, 1.0005, 0.01, nil), "approx within eps");

// contains: array + string
t(A.contains([1, 2, 3], 2, nil), "array contains");
t(A.contains("hello world", "world", nil), "string contains substring");

// len_eq
t(A.len_eq([1, 2, 3], 3, nil), "len_eq");

// all 10 were passing assertions; failed tally must be 0
if A.passed() != 10 { fail("expected 10 passed, got " + str(A.passed())); }
if A.failed() != 0 { fail("expected 0 failed, got " + str(A.failed())); }
if not A.summary() { fail("summary should report all passed"); }

print "assert_enrich_pass";
