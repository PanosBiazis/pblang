// tests/semantics/pbai_knowledge_enrich_test.sapp — pbAI's pblang knowledge base.
// knowledge(prompt) answers a pblang question directly (the _general skill), so we can
// test topic routing without depending on the neural intent classifier.

let pbai = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }
fn has(s, sub, m) { if str_index_of(str_lower(s), str_lower(sub)) < 0 { fail(m + " : <<" + s + ">>"); } }

// existing topics still answer
has(pbai.knowledge("how do maps work in pblang"), "map_has", "maps topic");
has(pbai.knowledge("tell me about strings"), "strcharcodeat", "strings topic");

// new topics
has(pbai.knowledge("how do I open a window and draw graphics"), "graphics", "graphics topic");
has(pbai.knowledge("how do I get the real window size after resize"), "window_probe", "window-size topic");
has(pbai.knowledge("how do I run unit tests"), "test_", "testing topic");
has(pbai.knowledge("how do packages and dependencies work"), "pblang.toml", "packages topic");

// native codegen + devices/HAL (the new capabilities)
has(pbai.knowledge("how do I compile pblang to native machine code"), "codegen", "native codegen topic");
has(pbai.knowledge("how do I generate a native binary or exe"), "native", "native binary topic");
has(pbai.knowledge("how do I talk to a device driver or gpio"), "device", "device/driver topic");
has(pbai.knowledge("what is the HAL and how do I use ioctl"), "hal", "HAL topic");

print "pbai_knowledge_enrich_pass";
