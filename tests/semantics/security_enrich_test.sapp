// tests/semantics/security_enrich_test.sapp — fix + enrichment for stdlib/security.sapp
//
// FIX: create_jwt/verify_jwt called hmac_sha256(secret, data) — args swapped
//   (builtin is hmac_sha256(message, key)), so the public header/body was used as
//   the HMAC KEY and the secret as the message (cryptographically unsound). Now
//   keyed by the secret. ENRICH: mask_secret, password_strength_score, random_pin.

let sec = import("stdlib/security.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── password hashing still round-trips ───────────────────────────────────────────
let h = sec.hash_password("pw1234");
eq(sec.verify_password("pw1234", h), true, "verify_password"); eq(sec.verify_password("x", h), false, "verify wrong");

// ── FIX: JWT round-trips and rejects a wrong secret ──────────────────────────────
let tok = sec.create_jwt(map{ sub: "user1" }, "topsecret");
eq(sec.verify_jwt(tok, "topsecret").sub, "user1", "jwt round-trip after arg-order fix");
eq(sec.verify_jwt(tok, "wrong"), nil, "jwt wrong secret -> nil");

// ── ENRICH: mask_secret ──────────────────────────────────────────────────────────
eq(sec.mask_secret("supersecret"), "*******cret", "mask shows last 4");
eq(sec.mask_secret("abc"), "***", "short secret fully masked");

// ── ENRICH: password_strength_score (0..5) ───────────────────────────────────────
eq(sec.password_strength_score("abc"), 1, "short lower-only -> 1 (only has_lower)");
eq(sec.password_strength_score("Abcd123!"), 5, "strong password -> 5 (length+upper+lower+digit+special)");

// ── ENRICH: random_pin ───────────────────────────────────────────────────────────
let pin = sec.random_pin(6);
eq(len(pin), 6, "pin length");
let j = 0; while j < len(pin) { if str_index_of("0123456789", str_slice(pin, j, j + 1)) < 0 { fail("pin must be digits"); } j = j + 1; }
let bad_pin_length = try { sec.random_pin(0); false } catch true;
eq(bad_pin_length, true, "pin rejects invalid length");

print "security_enrich_pass";
