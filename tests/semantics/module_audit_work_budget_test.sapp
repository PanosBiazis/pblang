let C = import("stdlib:module_audit_contract.sapp");
let T = import("stdlib:project_text_audit.sapp");
fn expect(ok, label) { if not ok { throw "FAIL audit work budget: " + label; } }
fn module(root, rows) {
    let n = len(rows);
    return map{format:"pblang.module_audit.module.v1", root:root, complete:true,
        files_scanned:1, finding_count:n, suppressed_count:0, encoding_degraded_files:0,
        finding_index_truncated:false, findings:rows,
        counts_kind:map{security:n}, counts_severity:map{high:n}, counts_role:map{source:n},
        counts_role_severity:map{"source:high":n}, counts_role_kind_severity:map{"source:security:high":n}};
}
let rows = []; let row = map{role:"source", kind:"security", severity:"high"};
for _i 50000 { array_push(rows, row); }
let a = module("first", rows); let b = module("second", rows);
expect(C.MAX_TOTAL_FINDING_ROWS == 100000 and C.modules_error([a,b]) == "", "exact whole-report ceiling admitted");
let c = module("third", [row]);
let error = "module audit whole-report finding budget exceeded";
expect(C.modules_error([a,b,c]) == error, "one excess row rejected across modules");
// Malformed content in an earlier module must not be inspected first.
let bad = module("bad", ["private-row-marker"]);
expect(C.modules_error([bad,a,b]) == error, "budget preflight precedes row content");
expect(C.modules_error([bad,a]) == "invalid module report at index 0", "under-budget content validation preserved");
let combined = T.combine_module_reports("fixture", [bad,a,b]);
expect(not combined.ok and combined.error == error and not map_has(combined,"quality_gate"), "combine propagates fixed rejection");
let root = "tests/fixtures/module_audit/stdlib";
let ordinary = T.audit_modules("fixture", [root], map{max_findings_per_file:16, suppress_test_fixtures:false});
let empty = T.audit_modules("fixture", [root], map{max_findings_per_file:16,
    suppress_test_fixtures:false, max_findings_per_module_index:0});
expect(ordinary.ok and ordinary.complete and ordinary.finding_count > 0, "positive scan control");
expect(empty.ok and empty.complete and empty.finding_count == ordinary.finding_count
    and empty.files_scanned == ordinary.files_scanned and len(empty.modules[0].findings) == 0
    and empty.modules[0].finding_index_truncated and empty.finding_index_truncated,
    "exhausted retention preserves scanning and exact counters");
expect(C.modules_error(empty.modules) == "", "zero retained rows remain canonical");
expect(json_stringify(empty.modules[0].counts_role_kind_severity)
    == json_stringify(ordinary.modules[0].counts_role_kind_severity), "category counts remain exact");
print "module_audit_work_budget_pass";
