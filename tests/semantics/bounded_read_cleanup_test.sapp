fn contains(values,value) {for item in values {if item==value {return true;}}return false;}
// Executed against complete copied production modules with only native-effect
// boundaries modeled by the Python harness. No production fault hooks.
fn run(D,B,R,baseline) {
 let checks=0;let rows=[];
 let modes=["normal","empty","short-copy","overflow","open-fail","create-fail",
 "copy-fail","size-fail","rewind-fail","rewind-positive","read-throw","read-type",
 "read-size","count-over","count-frac","count-nan","count-inf","size-frac",
 "size-nan","parent-fail","source-fail","snapshot-fail","parent-throw",
 "source-throw","snapshot-throw","open-fail-parent-fail","create-fail-source-fail",
 "copy-fail-source-fail-snapshot-fail","size-fail-snapshot-fail",
 "read-throw-snapshot-fail","closed","poisoned","parent-reject","open-throw","copy-throw","size-throw"];
 let normal=["normal","empty","short-copy"];
 let old_bad=["rewind-fail","rewind-positive","count-over","count-frac","count-inf",
 "parent-fail","source-fail","snapshot-fail","parent-throw","source-throw",
 "snapshot-throw","poisoned"];
 for mode in modes {
  B.configure(mode);D._test_reset(mode=="poisoned");let fs=B.root();
  if mode=="closed" {fs.closed=true;}
  let r=try D.read_bytes_relative(fs,"synthetic",4) catch map{ok:false,error:"uncaught operation exception"};
  let closed=D.close(fs);let trace=json_parse(json_stringify(B.state));
  let expected=contains(normal,mode) or (baseline and contains(old_bad,mode));
  assert(r.ok==expected,"bounded read verdict: "+mode);checks=checks+1;
  assert(closed==(mode!="closed"),"caller root cleanup: "+mode);checks=checks+1;
  if not baseline {
   for i len(trace.closes) {for j i {assert(trace.closes[i]!=trace.closes[j],"never retry fd: "+mode);checks=checks+1;}}
   let expected_fds=[1,10,20,30];
   if mode=="closed" {expected_fds=[];}
   elif mode=="poisoned" or mode=="parent-reject" {expected_fds=[1];}
   elif str_contains(mode,"open-fail") or mode=="open-throw" {expected_fds=[1,10];}
   elif str_contains(mode,"create-fail") or str_contains(mode,"parent-fail") or mode=="parent-throw" {expected_fds=[1,10,20];}
   assert(array_sort(trace.closes)==expected_fds,"every owned fd attempted: "+mode);checks=checks+1;
   if not r.ok {assert(not map_has(r,"bytes") and not map_has(r,"size"),"no failed publication");checks=checks+1;}
   if expected {
    assert(r.bytes==(if mode=="empty" {[]} else {[65,0,206,177]}),"exact result bytes");checks=checks+1;
   }
   if mode=="closed" or mode=="poisoned" {
    assert(trace.parents==0 and trace.opens==0 and trace.reads==0,"admission precedes effects");checks=checks+1;
   }
   if str_contains(mode,"parent-fail") or str_contains(mode,"parent-throw") {
    let expected_closes=if str_contains(mode,"open-fail") {[10,1]} else {[10,20,1]};
    assert(trace.closes==expected_closes and trace.reads==0,"parent-close early stop");checks=checks+1;
   }
   if str_contains(mode,"source-fail") or str_contains(mode,"source-throw") {
    assert(trace.reads==0,"source cleanup before VM read");checks=checks+1;
   }
   if str_contains(mode,"parent-fail") or str_contains(mode,"source-fail")
      or str_contains(mode,"snapshot-fail") or str_contains(mode,"parent-throw")
      or str_contains(mode,"source-throw") or str_contains(mode,"snapshot-throw") or mode=="poisoned" {
    assert(r.cleanup_failed and r.invalidate_handle and r.process_admission_poisoned
      and r.error_code=="bounded-read-cleanup-poisoned","cleanup metadata");checks=checks+1;
    B.configure("normal");let again=D.read_bytes_relative(B.root(),"synthetic",4);
    assert(not again.ok and B.state.parents==0 and B.state.reads==0,"poison blocks subsequent admission");checks=checks+1;
   }
   let primary=map{
    "open-fail-parent-fail":"file cannot be opened without following links",
    "create-fail-source-fail":"bounded snapshot is unavailable",
    "copy-fail-source-fail-snapshot-fail":"bounded file snapshot failed",
    "size-fail-snapshot-fail":"bounded snapshot size is unavailable",
    "read-throw-snapshot-fail":"path is not a readable regular file"};
   if map_has(primary,mode) {assert(r.error==primary[mode],"first known operation failure retained");checks=checks+1;}
  }
  push(rows,map{mode:mode,result:r,root_closed:closed,trace:trace});
 }
 if not baseline {
  for limit in [-1,0.5,67108865,"4",nil] {
   B.configure("normal");D._test_reset();let r=D.read_bytes(B.root(),"synthetic",limit);
   assert(not r.ok and B.state.parents==0,"invalid limit has no acquisition");checks=checks+1;
  }
  for fs in [nil,map{},map{closed:true}] {
   B.configure("normal");D._test_reset();let r=D.read_bytes(fs,"synthetic",4);
   assert(not r.ok and B.state.parents==0,"invalid/closed root has no acquisition");checks=checks+1;
  }
  B.configure("empty");D._test_reset();assert(D.read_bytes(B.root(),"synthetic",0).ok,"zero byte API limit admits empty");checks=checks+1;
  for mode in ["normal","source-fail","snapshot-fail","source-fail-root-fail"] {
   B.configure(mode);D._test_reset();let r=R.read_source("synthetic",4);
   assert(r.ok==(mode=="normal"),"facade verdict");checks=checks+1;
   assert(contains(B.state.closes,1),"facade closes caller root");checks=checks+1;
   if not r.ok {assert(not map_has(r,"source") and not map_has(r,"bytes"),"facade no failure publication");checks=checks+1;}
   if mode=="source-fail-root-fail" {assert(r.error=="bounded source descriptor cleanup failed","existing facade root-close precedence");checks=checks+1;}
   if mode=="source-fail" {assert(r.error=="bounded file source descriptor cleanup failed" and not map_has(r,"cleanup_failed"),"facade retains message, not backend metadata");checks=checks+1;}
   push(rows,map{facade_mode:mode,result:r,trace:json_parse(json_stringify(B.state))});
  }
 }
 return map{checks:checks,rows:rows,baseline:baseline,real_kernel_close_fault:false};
}
export run;
