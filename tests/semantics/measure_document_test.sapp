let M=import("stdlib:measure_document.sapp");let V=import("stdlib:measure_view.sapp");let S=import("stdlib:sheet_document.sapp");let C=import("stdlib:sheet_csv.sapp");let UI=import("stdlib:modern_ui.sapp");let G=import("stdlib:gui.sapp");let Strings=import("stdlib:strings.sapp");
let doc=M.create("Μετρήσεις");doc=M.set_row(doc,0,"Θερμοκρασία",10,"degC","degF");doc=M.append(doc);doc=M.set_row(doc,1,"Αύξηση",10,"degC","degF","difference");
let before=M.encode(doc);assert(M.encode(M.decode(before))==before,"Unicode strict roundtrip");assert(M.results(doc)==[50,18],"explicit mode preserved");
let candidate=M.set_row(doc,0,"Length",1,"m","cm");assert(M.encode(doc)==before and M.results(candidate)[0]==100,"detached update");
assert((try M.set_row(doc,0,"Wrong",1,"m","kg") catch nil)==nil and M.encode(doc)==before,"failed edit retains source");
let duplicate=Strings.replace_all(before,"\"title\":","\"title\":\"duplicate\",\"title\":");assert((try M.decode(duplicate) catch nil)==nil,"otherwise-valid duplicate field rejected");
for bad in ["{}","[]",before+"x"] {assert((try M.decode(bad) catch nil)==nil,"malformed file");}
let extra=M.copy(doc);extra.extra=true;assert((try M.validate(extra) catch nil)==nil,"unknown field");
let sheet=M.to_sheet(doc);assert(S.decode(S.encode(sheet))==sheet and C.decode(C.encode(sheet))==sheet,"office and CSV literal roundtrip");
let form=UI.build("Measure reader",V.create(doc),map{width:412,height:915});G.get(form,"select_1").onclick(form);assert(str_contains(G.get(form,"detail_6").text,"18") and G.get(form,"detail_7").text=="Mode: difference","portable result selection");
let wide=M.set_row(M.create(),0,str_repeat("界",40),1,"m","cm");let wf=UI.build("Wide",V.create(wide),map{width:412,height:915});let label="";for i in range(1,5){label=label+G.get(wf,"detail_"+str(i)).text;}assert(label==wide.rows[0].label,"wide text display retained");
let maximum=M.create();for i in range(1,31){maximum=M.append(maximum);}assert(len(M.to_sheet(maximum).cells)==32,"maximum fits office header and rows");
assert(M.decode(M.encode(maximum))==maximum,"maximum persistence");assert((try M.append(maximum) catch nil)==nil,"row limit");assert((try M.remove(M.create(),0) catch nil)==nil,"retain one row");
for target in ["native","web","android"] {assert(len(UI.compile(V.create(maximum,3),map{target:target,width:412,height:915}).records)>0,"last portable page");}
assert((try V.create(maximum,4) catch nil)==nil,"page bound");print "measure_document_pass";
