let M = import("stdlib:memory.sapp");
fn require(ok, reason) { if not ok { throw "FAIL memory_scope_cleanup: " + reason; } }
let baseline = M.stats().active_borrows;
let locations = M.stats().total_locations;
let owner = M.box(42);
let escaped = map{};
let success = M.scope_result(fn() {
    M.borrow(owner);
    escaped.handle = M.box(7);
    require(M.stats().active_borrows == baseline + 1, "borrow is active inside lifetime");
    return M.read(owner);
});
require(success.ok and success.value == 42, "scope returns successful value");
require(M.stats().active_borrows == baseline, "successful return releases scoped borrow");
require((try M.read(escaped.handle) catch "expired") == "expired", "scoped owner invalidated on return");
require(M.stats().total_locations == locations + 2, "scope invalidation does not reclaim owned storage");
M.free(escaped.handle);
require(M.stats().total_locations == locations + 1, "explicit free removes expired owner entry");
M.write(owner, 43);
let failed = M.scope_result(fn() {
    M.borrow(owner);
    escaped.handle = M.box(8);
    throw "synthetic failure";
});
require(not failed.ok and M.stats().active_borrows == baseline, "caught failure releases borrow");
require((try M.read(escaped.handle) catch "expired") == "expired", "failed scope invalidates owned allocation");
M.free(escaped.handle);
require(M.stats().total_locations == locations + 1, "failed scope owner reclaimed explicitly");
M.write(owner, 44);
M.scope(fn() {
    M.borrow(owner);
    let inner = M.scope_result(fn() { M.borrow(owner); throw "nested failure"; });
    require(not inner.ok and M.stats().active_borrows == baseline + 1, "inner cleanup preserves outer borrow");
});
require(M.stats().active_borrows == baseline, "outer lifetime also cleaned");
fn lexical_guard() {
    let guard = M.SafeRef();
    guard.acquire(guard, nil, owner, 0);
    return guard.borrow_id;
}
let manual = lexical_guard();
require(M.stats().active_borrows == baseline + 1, "SafeRef has no implicit lexical destructor");
require((try M.write(owner, 45) catch "borrowed") == "borrowed", "unreleased borrow still prevents mutation");
M.release(manual);
require(M.stats().active_borrows == baseline, "explicit release cleans manual guard borrow");
let i = 0;
while i < 100 {
    M.scope_result(fn() { M.borrow(owner); throw "repeat"; });
    require(M.stats().active_borrows == baseline, "repeated failures do not accumulate active borrows");
    i = i + 1;
}
M.free(owner);
require(M.stats().total_locations == locations, "test leaves no owned allocations");
print "memory_scope_cleanup_pass";
