// tests/semantics/new_language_features_test.sapp
// Tests for: break, continue, loop, throw, ??, f"...", **, %

// ---- break in while ----
let i = 0;
let sum = 0;
while i < 100 {
    if i == 5 { break; }
    sum = sum + i;
    i = i + 1;
}
if sum != 10 { throw "FAIL break while: expected 10 got " + str(sum); }
if i != 5 { throw "FAIL break while i: expected 5 got " + str(i); }

// ---- break in for ----
let found = -1;
for j 10 {
    if j == 4 { found = j; break; }
}
if found != 4 { throw "FAIL break for: expected 4 got " + str(found); }

// ---- continue in while ----
let evens = [];
let n = 0;
while n < 10 {
    n = n + 1;
    if num_mod(n, 2) != 0 { continue; }
    array_push(evens, n);
}
if len(evens) != 5 { throw "FAIL continue while: expected 5 got " + str(len(evens)); }
if evens[0] != 2 or evens[4] != 10 { throw "FAIL continue while values"; }

// ---- loop + break ----
let count = 0;
loop {
    count = count + 1;
    if count >= 7 { break; }
}
if count != 7 { throw "FAIL loop break: expected 7 got " + str(count); }

// ---- throw ----
let threw = false;
try {
    throw "test error";
} catch {
    threw = true;
};
if threw == false { throw "FAIL throw: should have thrown"; }

// ---- ?? null coalescing ----
let a = nil;
let b = a ?? "default";
if b != "default" { throw "FAIL ?? nil: expected default got " + str(b); }

let c = "hello";
let d = c ?? "fallback";
if d != "hello" { throw "FAIL ?? non-nil: expected hello got " + str(d); }

let e = 0;
let f = e ?? 99;
if f != 0 { throw "FAIL ?? zero (not nil): expected 0 got " + str(f); }

// ---- f"..." string interpolation ----
let name = "Alice";
let age = 30;
let msg = f"Hello {name}, you are {age} years old!";
if msg != "Hello Alice, you are 30 years old!" {
    throw "FAIL f-string: got " + str(msg);
}

let x = 5;
let y = 3;
let calc = f"{x} + {y} = {x + y}";
if calc != "5 + 3 = 8" { throw "FAIL f-string expr: got " + str(calc); }

// ---- ** power operator ----
let p1 = 2 ** 10;
if p1 != 1024 { throw "FAIL **: expected 1024 got " + str(p1); }

let p2 = 3 ** 3;
if p2 != 27 { throw "FAIL **: expected 27 got " + str(p2); }

// ---- % modulo operator ----
let m1 = 17 % 5;
if m1 != 2 { throw "FAIL %: expected 2 got " + str(m1); }

let m2 = 100 % 7;
if m2 != 2 { throw "FAIL %: expected 2 got " + str(m2); }

// ---- break in for-in ----
let first_even = -1;
for item in [1, 3, 4, 6, 7] {
    if num_mod(item, 2) == 0 { first_even = item; break; }
}
if first_even != 4 { throw "FAIL break for-in: expected 4 got " + str(first_even); }

// ---- throw with map ----
let throw_msg = nil;
try {
    throw map{ message: "structured error", code: 42 };
} catch {
    throw_msg = "caught";
};
if throw_msg != "caught" { throw "FAIL throw map"; }

print "new_language_features_pass";
