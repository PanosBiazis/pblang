let Compiler = import("stdlib/compiler/selfhost_cli.sapp");
let Loader = import("stdlib/selfhost_loader.sapp");

fn fail(message) { throw "FAIL selfhost_cli: " + message; }
fn require(condition, message) { if not condition { fail(message); } }

let compiled = Compiler.compile_source("let answer = 6 * 7; print answer;");
require(compiled.ok and compiled.byte_count > 8
    and compiled.instructions > 0 and len(compiled.digest) == 64,
    "self-host compiler emits a verified bounded artifact");
let executed = Loader.run_pbck_bytes(compiled.bytes);
require(executed.ok and executed.output[0] == 42,
    "self-host compiler artifact executes with the expected result");

let bad = Compiler.compile_source("let = ;");
require(not bad.ok and bad.stage == "compile",
    "invalid source fails closed with diagnostics");
require(not Compiler.compile_file("same", "same").ok,
    "compiler rejects identical input and output paths");

let input = "/tmp/pblang-selfhost-cli-input.sapp";
let output = "/tmp/pblang-selfhost-cli-output.pbck";
try fs_remove(input) catch nil; try fs_remove(output) catch nil;
fs_write(input, "print 40 + 2;");
let file = Compiler.compile_file(input, output);
require(file.ok and fs_exists(output) and file.bytes == nil,
    "compiler atomically publishes without retaining artifact bytes");
let loaded = Loader.run_pbck(output);
require(loaded.ok and loaded.output[0] == 42,
    "published artifact loads and executes");
fs_remove(input); fs_remove(output);

print "selfhost_cli_pass";
