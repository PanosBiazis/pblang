let W = import("stdlib:codegen_wasm.sapp");
let UUID=import("stdlib:uuid.sapp"); let OS=import("stdlib:os.sapp");
let path=path_join(OS.temp_dir(),"pblang_wasm_types_"+UUID.v4()+".wasm");
fn exercise() {
    // Source order forces string-return information to travel backward one
    // function per round. More than 200 rounds must reach the same fixed point.
    let source="";
    let i=0;
    while i<209 { source=source+"fn f"+str(i)+"(){return f"+str(i+1)+"();}"; i=i+1; }
    source=source+"fn f209(){return \"abc\";} return len(f0());";
    let strict=W.compile_wasm(source);
    let local=W.compile_wasm_local(source);
    assert(json_stringify(strict)==json_stringify(local),"admission policies share converged emitter");
    fs_write_bytes(path,local);
    let r=proc_spawn_wait("node",["-e","WebAssembly.instantiate(require('fs').readFileSync(process.argv[1]),{env:{print:()=>{},print_str:()=>{}}}).then(r=>console.log(String(r.instance.exports.main()))).catch(()=>process.exit(1));",path]);
    assert(r.exit_code==0 and r.stdout=="3\n","long inferred call chain executes correctly");
}
let passed=try {exercise();true} catch false;
try fs_remove(path) catch nil;
assert(passed,"WASM type convergence regression");
print "wasm_type_convergence_pass";
