let F = import("stdlib:functional.sapp");
fn check(ok,label) { if not ok { throw "FAIL stable-sort: " + label; } }
fn asc(a,b) { return a-b; }
check(F.stable_sort_by([3,1,2],asc) == [1,2,3],"new API sorts");
for values in [[],[7],[2,1],[3,2,1],[5,3,1,4,2],[2,2,1,3,1],[-7,0,-2]] {
    let before = slice(values,0,len(values));
    let calls = [0];
    let sorted = F.stable_sort_by(values,fn(a,b){calls[0]=calls[0]+1;return a-b;});
    check(sorted == array_sort(values) and values == before,"reference order and input preservation");
    if len(values) < 2 { check(calls[0] == 0,"no unused comparison"); }
    push(sorted,99);
    check(values == before,"result array is independent");
}
let records = [map{k:2,id:0},map{k:1,id:1},map{k:2,id:2},map{k:1,id:3},map{k:2,id:4}];
let result = F.stable_sort_by(records,fn(a,b){return a.k-b.k;});
check(F.map(result,fn(x){return x.id;}) == [1,3,0,2,4],"equal keys keep original order");
let selected = result[0]; selected.k=8;
check(records[1].k == 8,"payload references remain borrowed");
check(F.stable_sort_by([1,3,2],fn(a,b){return b-a;}) == [3,2,1],"descending comparator");
check(F.stable_sort_by([nil,true,"x"],fn(a,b){return 0;}) == [nil,true,"x"],"opaque payloads with numeric comparator");
let effects=[0];
let failure=try map{ok:true,value:F.stable_sort_by([3,2,1],fn(a,b){effects[0]=effects[0]+1;throw nil;})} catch map{ok:false};
check(not failure.ok and effects[0] == 1,"first exception stops without retry");
// Legacy comparison sequence is not redirected through the new algorithm.
let legacy=[];
check(F.sort_by([3,1,2],fn(a,b){push(legacy,[a,b]);return a-b;}) == [1,2,3],"legacy result");
check(legacy == [[3,1],[3,2],[1,2]],"legacy callback trace unchanged");
// Deterministic exhaustive short-array coverage, including duplicate ties.
let code=0;
while code < 243 {
    let n=code; let values=[];
    for i 5 { push(values,n%3); n=num_floor(n/3); }
    check(F.stable_sort_by(values,asc) == array_sort(values),"all five-element ternary arrays");
    code=code+1;
}
print "functional_stable_sort_pass";
