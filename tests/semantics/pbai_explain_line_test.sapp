// tests/semantics/pbai_explain_line_test.sapp — explain_line(prompt): a compact,
// single-line decision summary for status bars / logs (the multi-line explain_decision
// is for panels). Format: "<intent> <conf%> · <mode>/<fusion> · <winner-tally>/<total>".

let ens = import("stdlib/pbai_ensemble.sapp");

fn fail(m) { throw "FAIL " + m; }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : <<" + s + ">>"); } }

let scores = fn(p) { return map{ intent: "bugs", scores: [0.05, 0.9, 0.05, 0.05, 0.05] }; };
ens.configure(scores, ["explain", "bugs", "improve", "comment", "general"]);
ens.clear_voters();
ens.reset_stats();
ens.set_adaptive(false);
ens.set_routing(false);
ens.set_fusion("hard");

let line = ens.explain_line("this crashes");
if not is_string(line) { fail("explain_line returns a string"); }
if str_index_of(line, "\n") >= 0 { fail("explain_line is a SINGLE line"); }
has(line, "bugs", "names the decided intent");
has(line, "%", "shows a confidence percentage");
has(line, "hard", "states the fusion mode");
has(line, "static", "states the decision mode");

// reflects mode/fusion changes
ens.set_fusion("soft");
ens.set_adaptive(true);
let line2 = ens.explain_line("this crashes");
has(line2, "adaptive", "reflects adaptive mode");
has(line2, "soft", "reflects soft fusion");

ens.set_fusion("hard");
ens.set_adaptive(false);

// ── escalation reason surfaced in the one-liner ────────────────────────────────────
// a 2-way tie: winner-share 0.5, high disagreement. explain_line notes WHY it escalates.
ens.reset_stats();
ens.register_voter_weighted("M", fn(x) { return "improve"; }, 1);
let el = ens.explain_line("this crashes", 0.6, 0.3);   // conf 0.5<0.6 AND uncertain
has(el, "escalate", "escalation is flagged");
has(el, "low_confidence", "names the escalation reason");
// when disagreement (not low confidence) is the trigger, say "uncertain"
let el2 = ens.explain_line("this crashes", 0.4, 0.3);  // conf 0.5>=0.4, uncertainty>0.3
has(el2, "uncertain", "uncertainty escalation named");
// within both thresholds -> no escalate tag
let el3 = ens.explain_line("this crashes", 0.4, 0.9);
if str_index_of(el3, "escalate") >= 0 { fail("no escalation -> no escalate tag: " + el3); }

ens.clear_voters();
ens.reset_stats();
print "pbai_explain_line_pass";
