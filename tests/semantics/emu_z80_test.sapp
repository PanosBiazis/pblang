// emu_z80_test.sapp — a verified Zilog Z80 execution model in pblang (retro 8-bit CISC).
//
// The Z80 (1976) ran the Game Boy, ZX Spectrum, MSX, TRS-80, and every CP/M machine — still shipping today in
// embedded/industrial parts. Unlike the 6502's single accumulator, it's a register-rich 8-bit CISC (A,B,C,D,E,
// H,L + flags), variable-length opcodes. A different flavor of "oldest device" so the suite isn't monotone.
// Verified by COMPUTED RESULT; HALT exits with A.

fn fail(m) { throw "FAIL emu-z80: " + m; }
fn _cat(a, b) { let i = 0; while i < len(b) { push(a, b[i]); i = i + 1; } return a; }
fn _u8(v) { let r = v % 256; if r < 0 { r = r + 256; } return r; }

// ── encoder ──
fn LD_A(n) { return [62, _u8(n)]; }  fn LD_B(n) { return [6, _u8(n)]; }  fn LD_C(n) { return [14, _u8(n)]; }
fn LD_A_B() { return [120]; }        fn ADD_B() { return [128]; }        fn ADD_C() { return [129]; }
fn ADD_n(n) { return [198, _u8(n)]; }   fn SUB_n(n) { return [214, _u8(n)]; }
fn INC_A() { return [60]; }  fn INC_B() { return [4]; }   fn DEC_A() { return [61]; }  fn DEC_B() { return [5]; }  fn DEC_C() { return [13]; }
fn CP_n(n) { return [254, _u8(n)]; }
fn JR(d) { return [24, _u8(d)]; }    fn JR_NZ(d) { return [32, _u8(d)]; }   fn JR_Z(d) { return [40, _u8(d)]; }
fn HALT() { return [118]; }

// ── interpreter ──
fn _z(v) { if v == 0 { return 1; } return 0; }
fn _w8(v) { let r = v % 256; if r < 0 { r = r + 256; } return r; }
fn _s8(b) { if b >= 128 { return b - 256; } return b; }
fn z80_run(code) {
    let A = 0; let B = 0; let C = 0; let D = 0; let E = 0; let zf = 0; let cf = 0;
    let pc = 0; let guard = 0; let halted = false;
    while pc >= 0 and pc < len(code) and guard < 1000000 and not halted {
        guard = guard + 1;
        let op = code[pc];
        if op == 62 { A = code[pc + 1]; pc = pc + 2; }                                    // LD A,n
        else if op == 6  { B = code[pc + 1]; pc = pc + 2; }                               // LD B,n
        else if op == 14 { C = code[pc + 1]; pc = pc + 2; }                               // LD C,n
        else if op == 120 { A = B; pc = pc + 1; }                                         // LD A,B
        else if op == 128 { let t = A + B; cf = 0; if t > 255 { cf = 1; } A = _w8(t); zf = _z(A); pc = pc + 1; } // ADD A,B
        else if op == 129 { let t = A + C; cf = 0; if t > 255 { cf = 1; } A = _w8(t); zf = _z(A); pc = pc + 1; } // ADD A,C
        else if op == 198 { let t = A + code[pc + 1]; cf = 0; if t > 255 { cf = 1; } A = _w8(t); zf = _z(A); pc = pc + 2; } // ADD A,n
        else if op == 214 { let t = A - code[pc + 1]; cf = 0; if t < 0 { cf = 1; } A = _w8(t); zf = _z(A); pc = pc + 2; }   // SUB n
        else if op == 60 { A = _w8(A + 1); zf = _z(A); pc = pc + 1; }                     // INC A
        else if op == 4  { B = _w8(B + 1); zf = _z(B); pc = pc + 1; }                     // INC B
        else if op == 61 { A = _w8(A - 1); zf = _z(A); pc = pc + 1; }                     // DEC A
        else if op == 5  { B = _w8(B - 1); zf = _z(B); pc = pc + 1; }                     // DEC B
        else if op == 13 { C = _w8(C - 1); zf = _z(C); pc = pc + 1; }                     // DEC C
        else if op == 254 { zf = _z(_w8(A - code[pc + 1])); pc = pc + 2; }                // CP n
        else if op == 24 { pc = pc + 2 + _s8(code[pc + 1]); }                             // JR d
        else if op == 32 { let nx = pc + 2; if zf == 0 { nx = nx + _s8(code[pc + 1]); } pc = nx; }  // JR NZ,d
        else if op == 40 { let nx = pc + 2; if zf == 1 { nx = nx + _s8(code[pc + 1]); } pc = nx; }  // JR Z,d
        else if op == 118 { halted = true; }                                             // HALT -> exit A
        else { throw "z80_run: unmodeled opcode " + str(op); }
    }
    if not halted { if guard >= 1000000 { fail("instruction budget exceeded"); } fail("ran off the end without HALT"); }
    return A;
}

fn prog(insns) { let c = []; let i = 0; while i < len(insns) { _cat(c, insns[i]); i = i + 1; } return c; }
fn eq(g, w, m) { if g != w { fail(m + ": got " + str(g) + " want " + str(w)); } }

eq(z80_run(prog([LD_A(42), HALT()])),                                    42, "LD A,n");
eq(z80_run(prog([LD_A(5), ADD_n(7), HALT()])),                           12, "ADD A,7");
eq(z80_run(prog([LD_A(5), LD_B(7), ADD_B(), HALT()])),                   12, "ADD A,B");
eq(z80_run(prog([LD_A(20), SUB_n(8), HALT()])),                          12, "SUB 8");
eq(z80_run(prog([LD_A(250), ADD_n(20), HALT()])),                        14, "ADD wraps 270&255");
// loop: A += 3 for B=5 iterations -> 15.  JR NZ d=-5 (back to ADD A,3)
eq(z80_run(prog([LD_A(0), LD_B(5),
                 ADD_n(3), DEC_B(), JR_NZ(0 - 5),
                 HALT()])),                                              15, "loop 3*5 via ADD/DEC/JR NZ");

print "emu_z80: 8-bit register CISC — LD/ADD(A,n and A,B)/SUB/wrap/JR NZ loop all computed correctly";
