let Z80 = import("stdlib:emulator_z80.sapp");

fn value(instructions) {
    let result = Z80.run(Z80.program(instructions));
    if not result.ok { throw result.error; }
    return result.value;
}

assert(value([Z80.ld_a(42), Z80.halt()]) == 42, "LD A,n");
assert(value([Z80.ld_a(5), Z80.add_imm(7), Z80.halt()]) == 12, "ADD A,n");
assert(value([Z80.ld_a(5), Z80.ld_b(7), Z80.add_b(), Z80.halt()]) == 12, "ADD A,B");
assert(value([Z80.ld_a(20), Z80.sub_imm(8), Z80.halt()]) == 12, "SUB n");
assert(value([Z80.ld_a(250), Z80.add_imm(20), Z80.halt()]) == 14, "ADD wraps");
assert(value([Z80.ld_a(0), Z80.ld_b(5), Z80.add_imm(3), Z80.dec_b(),
              Z80.jump_relative_nz(-5), Z80.halt()]) == 15, "bounded loop");

let state = Z80.run(Z80.program([Z80.ld_a(255), Z80.add_imm(1), Z80.halt()]));
assert(state.ok and state.flags.zero == 1 and state.flags.carry == 1, "observable flags");
assert(not Z80.run([62]).ok, "truncated immediate fails closed");
assert(not Z80.run([24, 127]).ok, "out-of-range branch fails closed");
assert(not Z80.run([0]).ok, "unknown opcode fails closed");
assert(not Z80.run([300]).ok, "invalid byte fails closed");
assert(not Z80.run([24, 254], map{ instruction_budget: 5 }).ok, "loop budget enforced");
assert((try Z80.program([[62, 1], "bad"]) catch nil) == nil, "invalid instruction rejected");

print "emu_z80: reusable bounded subset passed arithmetic, flags, malformed-code, branch, and budget checks";
