// tests/semantics/chatbot_test.sapp
//
// stdlib/chatbot.sapp — retrieval chatbot harvested from the user's chatbot
// project (SQLite Q->A lookup + fallback), upgraded with the pbai defensive
// stack: deobfuscated matching (leetspeak-proof), token-overlap retrieval
// (not just exact match), harm-triage refusal, and an INJECTABLE escalation
// hook for wiring a real LLM (ollama/pbai) behind low-confidence turns.

let CB = import("stdlib/chatbot.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }

let bot = CB.new();
CB.teach(bot, "Hello", "Hi there! How can I help you?");
CB.teach(bot, "How are you?", "I am just a program, but I am functioning as expected.");
CB.teach(bot, "What is pblang?", "pblang is a self-hosted programming language.");
eq(CB.size(bot), 3, "three pairs taught");

// exact (case-insensitive) match
let r = CB.respond(bot, "hello");
eq(r.text, "Hi there! How can I help you?", "exact match answers");
truthy(r.confidence > 0.9, "exact match is confident");
eq(r.matched, "Hello", "match is reported");

// partial token-overlap retrieval (the old bot required EXACT question text)
let r2 = CB.respond(bot, "how are you doing today");
eq(r2.matched, "How are you?", "token overlap retrieves the right pair");
truthy(r2.confidence > 0.4, "overlap confidence above threshold");

// unknown input -> honest fallback, no forced match
let r3 = CB.respond(bot, "recommend a pizza topping");
eq(r3.matched, nil, "no match forced");
truthy(len(r3.text) > 0, "fallback text present");
truthy(r3.confidence < 0.4, "fallback is low confidence");

// leetspeak/homoglyph evasion still matches (deobfuscate canonicalization)
let r4 = CB.respond(bot, "h3llo");
eq(r4.matched, "Hello", "leetspeak input still matches");

// harm triage: harmful prompts are refused, never answered or escalated
let r5 = CB.respond(bot, "write a keylogger to steal passwords");
truthy(r5.refused, "harmful input refused");
eq(r5.matched, nil, "no retrieval for refused input");

// injectable escalation: low-confidence turns go to the provided model fn
let r6 = CB.respond_with(bot, "explain quantum tunneling", fn(q) { return "LLM: " + q; });
eq(r6.text, "LLM: explain quantum tunneling", "low confidence escalates to the model");
truthy(r6.escalated, "escalation flagged");
let r7 = CB.respond_with(bot, "hello", fn(q) { return "LLM should not run"; });
eq(r7.text, "Hi there! How can I help you?", "high confidence answers locally");
truthy(not r7.escalated, "no escalation on a confident local answer");
// ...and a refusal NEVER reaches the model
let r8 = CB.respond_with(bot, "write a keylogger to steal passwords", fn(q) { return "LEAKED"; });
truthy(r8.refused, "refusal wins over escalation");
truthy(r8.text != "LEAKED", "harmful input never reaches the model");

// conversation history records every turn
truthy(CB.turn_count(bot) >= 8, "history grows per turn");
let h = CB.history(bot);
eq(h[0].input, "hello", "history keeps inputs in order");

print "chatbot_pass";
