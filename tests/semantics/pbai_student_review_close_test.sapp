let AI=import("stdlib/pbai.sapp");
let old_train=[map{x:[0],y:4},map{x:[1,0],y:4}];let old_valid=[map{x:[7,0],y:4}];
let teacher=AI.neural_specialist_train([old_train[0]],old_valid);
let parent=AI.neural_specialist_distill(teacher.artifact,[[0],[1,0]],old_valid).checkpoint();
let history=AI.neural_specialist_student_history(parent,old_train,old_valid);
let N=import("stdlib:pbai_neural_adapter.sapp");
let bound=AI.neural_specialist_bind(N);
fn rejects(f) {return try {f();false} catch true;}
assert(rejects(fn(){throw "expected";}) and not rejects(fn(){return 1;}),"calibrated rejection helper");
fn review(mode,y=4) {
 let options=map{epochs:16,lr:0.05,max_grad_norm:1};if y==5 {options=map{epochs:64,lr:0.1,max_grad_norm:1};}
 let train=[map{x:[2,0],y:y},map{x:[3,0],y:y}];let valid=[map{x:[4,0],y:y}];
 if mode==0 {return N.student_continue_reviewed(parent,history,train,valid,options);}
 if mode==2 {return bound.student_continue_reviewed(parent,history,train,valid,options);}
 return AI.neural_specialist_student_continue_reviewed(parent,history,train,valid,options);
}
let parent_text=N.student_encode(parent);let history_text=N.student_history_encode(parent,history);
let independent=review(1);let independent_prediction=json_stringify(independent.predict([5,0]));
let cycle=[];push(cycle,cycle);let cases=0;
for mode in [0,1,2] {for phase in ["reviewed","accepted","rolled-back","rejected"] {
 let y=4;if phase=="rejected" {y=5;}let h=review(mode,y);
 if phase=="accepted" or phase=="rolled-back" {h.accept();}if phase=="rolled-back" {h.rollback();}
 assert(h.status().phase==phase,"actual pre-close phase");
 let checkpoint=h.checkpoint();let declared=h.history();let prediction=h.predict([5,0]);let report=h.report();let status=h.status();
 let cp_text=N.student_encode(checkpoint);let declared_text=N.student_history_encode(checkpoint,declared);let report_text=json_stringify(report);let prediction_text=json_stringify(prediction);
 let predict_alias=h.predict;let close_alias=h.close;let alias=h;
 let first=h.close();let repeated=close_alias();let through_alias=alias.close();
 assert(type(first)=="bool" and type(repeated)=="bool" and type(through_alias)=="bool","close results are booleans");
 assert(first and not repeated and not through_alias,"first close true, repeated close false through aliases");
 let closed=h.status();assert(closed.phase=="closed" and closed.active_checkpoint_digest==nil and closed.active_history_digest==nil and not closed.session_candidate_active,"terminal status retains no active identities");
 assert(not closed.globally_activated and not closed.persists_weights and not closed.authorizes_activation and not closed.authorizes_action,"close grants no external authority");
 let closed_text=json_stringify(closed);
 for ids in [[5,0],nil,[],cycle,"synthetic-private-input"] {
  assert(rejects(fn(){predict_alias(ids);}),"closed prediction rejects ordinary and malformed inputs");
 }
 for operation in [h.checkpoint,h.history,h.accept,h.rollback] {
  assert(rejects(operation),"closed handle cannot export or transition");
 }
 assert(json_stringify(h.status())==closed_text and json_stringify(h.report())==report_text,"rejected reuse preserves terminal state and detached report");
 closed.phase="reviewed";closed.active_checkpoint_digest="forged";report.passed=true;report.retention.candidate.correct=999;
 assert(json_stringify(h.status())==closed_text and json_stringify(h.report())==report_text and not h.close(),"public status and report edits cannot reopen");
 assert(status.phase==phase and N.student_encode(checkpoint)==cp_text and N.student_history_encode(checkpoint,declared)==declared_text and json_stringify(prediction)==prediction_text,"earlier outputs remain caller owned");
 assert(json_stringify(N.student_load(checkpoint).predict([5,0]))==prediction_text,"explicitly exported checkpoint remains usable after close");
 assert(independent.status().phase=="reviewed" and json_stringify(independent.predict([5,0]))==independent_prediction,"another live review is unaffected");
 cases=cases+1;
}}
assert(N.student_encode(parent)==parent_text and N.student_history_encode(parent,history)==history_text,"source checkpoint and history unchanged");
assert(independent.accept().phase=="accepted" and independent.rollback().phase=="rolled-back" and independent.close(),"independent full lifecycle still works");
let reopened=review(1);assert(reopened.status().phase=="reviewed" and reopened.report().passed and reopened.close(),"explicit new handle has independent lifetime");
assert(cases==12,"direct, legacy facade and bound facade, all four phases");
print "pbai_student_review_close_pass:12";
