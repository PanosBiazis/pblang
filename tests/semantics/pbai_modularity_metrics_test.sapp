let AI=import("stdlib/pbai.sapp");
let SENSOR=import("stdlib:pbai_sensor.sapp");
let STUDENT=import("stdlib:pbai_neural_adapter.sapp");
let RESOLVER=import("stdlib:controlled_modularity.sapp");
let bound=AI.modular_bind("sensor-v1",SENSOR,RESOLVER);
let initial=bound.metrics();
assert(initial.observed_calls==0 and initial.executed_calls==0 and initial.duration.samples==0,"probe excluded from measured calls");
assert(initial.duration.min_ms==nil and initial.duration.max_ms==nil,"absence is not a zero duration");
assert(not initial.duration.monotonic and not initial.persistence and not initial.retains_payloads,"honest clock and retention contract");
let request=map{values:[2,4,6,100],period_seconds:1,sigma:3,absolute_tolerance:1};
assert(json_stringify(bound.run(request).output)==json_stringify(SENSOR.analyze(request)),"instrumentation preserves numerical result");
assert(bound.run(map{values:"synthetic-private-marker"}).output.status=="error","invalid request remains provider error");
let observed=bound.metrics();
assert(observed.observed_calls==2 and observed.executed_calls==2 and observed.provider_results==1 and observed.provider_errors==1,"actual call categories");
assert(observed.execution_errors==0 and observed.rejected_calls==0 and observed.unclassified_replies==0,"no invented failures");
assert(observed.duration.samples+observed.duration.invalid_samples==2,"each execution has a valid or unavailable measurement");
if observed.duration.samples>0 {assert(observed.duration.min_ms>=0 and observed.duration.max_ms>=observed.duration.min_ms and observed.duration.total_ms>=observed.duration.max_ms,"bounded measured duration aggregate");}
assert(not str_contains(json_stringify(observed),"synthetic-private-marker"),"no rejected input in metrics");
observed.duration.samples=999;observed.provider_results=999;
assert(bound.metrics().provider_results==1 and bound.metrics().duration.samples!=999,"nested snapshots detached");
bound.clear_metrics();assert(bound.metrics().observed_calls==0 and bound.report().ok,"clear has no admission effect");
assert(initial.observed_calls==0,"old snapshot unchanged");
// Fixed state does not grow after the window fills; execution keeps working.
let calls=0;while calls<1024 {assert(bound.run(request).output.status=="result","real repeated calls");calls=calls+1;}
let full=bound.metrics();
assert(full.observed_calls==1024 and full.provider_results==1024 and full.window_full and not full.observations_dropped,"exact window boundary");
assert(bound.run(request).output.status=="result","full monitor cannot disable execution");
let dropped=bound.metrics();
assert(dropped.observations_dropped and dropped.observed_calls==1024 and dropped.executed_calls==1024,"explicitly incomplete aggregate after saturation");
dropped.observations_dropped=false;
assert(bound.metrics().observations_dropped,"snapshot cannot erase loss indication");
bound.clear_metrics();assert(bound.metrics().duration.min_ms==nil and not bound.metrics().window_full,"clear removes aggregates");
let refused=AI.modular_bind("sensor-v1",nil,RESOLVER);
let cyclic=[];push(cyclic,cyclic);
assert(refused.run(cyclic).error=="invalid_binding","denied request is never inspected");
let denied=refused.metrics();
assert(denied.observed_calls==1 and denied.rejected_calls==1 and denied.executed_calls==0 and denied.duration.samples==0,"refusal is not provider execution or latency");
denied.authorizes_action=true;refused.clear_metrics();
assert(not refused.report().ok and refused.run(nil).error=="invalid_binding","clear and metadata cannot activate refused binding");
let student=AI.modular_bind("student-v1",STUDENT,RESOLVER);
student.run(map{op:"capabilities"});student.run(map{op:"train"});
assert(student.metrics().provider_results==1 and student.metrics().provider_errors==1,"student status classification without training");
assert(bound.metrics().observed_calls==0,"bindings have private counters");
assert(bound.run(request).output.status=="result" and bound.metrics().observed_calls==1 and bound.metrics().provider_results==1,"reset restarts real observation");
print "pbai_modularity_metrics_pass";
