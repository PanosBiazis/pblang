let FEED = import("stdlib:feed.sapp");

fn expect(value, message) { if not value { throw "FAIL feed: " + message; } }
fn rejected(work) { return try { work(); false } catch true; }

let rss = FEED.parse("<?xml version='1.0'?><rss version='2.0'><channel>" +
    "<title>Engineering &amp; Research</title>" +
    "<item><title>First &lt;release&gt;</title><link>https://example.com/1</link>" +
    "<guid>one</guid><pubDate>Thu, 13 Aug 2026 10:00:00 GMT</pubDate>" +
    "<description><![CDATA[<p>Hello <b>world</b></p>]]></description></item>" +
    "<item><title>Second</title><link>https://example.com/2</link></item>" +
    "</channel></rss>", 10);
expect(rss.kind == "rss" and rss.title == "Engineering & Research" and
       rss.item_count == 2 and rss.items[0].title == "First <release>" and
       rss.items[0].summary == "Hello world" and not rss.truncated,
    "RSS fields, CDATA, entities, and markup parse deterministically");

let atom = FEED.parse("<feed xmlns='http://www.w3.org/2005/Atom'><title>Atoms</title>" +
    "<entry><id>a1</id><updated>2026-08-13T12:00:00Z</updated><title>Paper &#x3B1;</title>" +
    "<link rel='self' href='https://example.com/api/a1'/><link rel='alternate' href='https://example.com/a1'/>" +
    "<summary>Bounded &amp; safe</summary></entry></feed>", 10);
expect(atom.kind == "atom" and atom.item_count == 1 and
       atom.items[0].link == "https://example.com/a1" and
       atom.items[0].title == "Paper α" and atom.items[0].summary == "Bounded & safe",
    "Atom alternate links and Unicode numeric entities parse");

let limited = FEED.parse("<rss><channel><item><title>A</title></item>" +
    "<item><title>B</title></item></channel></rss>", 1);
expect(limited.item_count == 1 and limited.truncated, "item count is bounded and reports truncation");
expect(rejected(fn() { FEED.parse("<!DOCTYPE rss [<!ENTITY x SYSTEM 'file:///etc/passwd'>]>" +
    "<rss><channel><item><title>&x;</title></item></channel></rss>"); }),
    "DTD and external entities fail closed");
expect(rejected(fn() { FEED.parse("<rss><channel><item><title>broken</title></channel></rss>"); }),
    "unterminated item fails closed");
expect(rejected(fn() { FEED.parse(str_repeat("x", 524289)); }), "oversized feeds fail closed");

print "feed_pass";
