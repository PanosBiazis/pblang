let M=import("stdlib:measure_document.sapp");let S=import("stdlib:measure_smoothing.sapp");
fn rejects(f){assert((try f() catch nil)==nil,"reject incompatible series");}
let doc=map{format:M.FORMAT,title:"Ordered length samples",rows:[map{label:"A",value:20,from:"mm",to:"cm",mode:"absolute"},map{label:"B",value:4,from:"cm",to:"cm",mode:"absolute"},map{label:"C",value:60,from:"mm",to:"cm",mode:"absolute"}]};let before=M.encode(doc);let report=S.create(doc,2);assert(report.document.cells[1]==["1","2","A","B","3","cm","absolute"] and report.document.cells[2][4]=="5","recomputed unit conversions before averaging");assert(M.encode(doc)==before,"worksheet preserved");
let mixed=M.copy(doc);mixed.rows[1].to="m";rejects(fn(){S.create(mixed,2);});mixed=M.copy(doc);mixed.rows[1].mode="difference";rejects(fn(){S.create(mixed,2);});mixed=M.copy(doc);mixed.rows[1].value=10000000000;rejects(fn(){S.create(mixed,2);});
let temp=M.create("Temperature samples");temp=M.set_row(temp,0,"a",0,"degC","degF","absolute");temp=M.append(temp);temp=M.set_row(temp,1,"b",10,"degC","degF","absolute");assert(parse_number(S.create(temp,2).document.cells[1][4])==41,"absolute temperature mean in selected unit");print "measure_smoothing_pass";
