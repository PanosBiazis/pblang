// Test: the pblang security layer (stdlib/securelayer.sapp), §89.
//
// Authenticated encryption over any protocol (encrypt-then-MAC with sha256 keystream +
// hmac_sha256 tag, nonce, version+sequence bound into the tag). Runs in the VM.

let s = import("stdlib/securelayer.sapp");
let key = "correct horse battery staple";

// round-trip recovers the plaintext (full Unicode)
let env = s.seal(key, "attack at dawn 🔒 — ναι", 7);
assert(s.open(key, env, 7) == "attack at dawn 🔒 — ναι", "seal/open round-trips, Unicode-safe");

// confidentiality: the plaintext does not appear in the envelope
assert(not str_contains(env, "attack"), "ciphertext does not leak the plaintext");

// integrity / authenticity: a tampered envelope fails to open
let tampered = str_slice(env, 0, len(env) - 2) + "00";   // mangle the tag's last byte
assert(s.open(key, tampered, 7) == nil, "tampered envelope is rejected");

// wrong key fails (authentication)
assert(s.open("wrong-key", env, 7) == nil, "wrong key is rejected");

// replay protection: the sequence number is authenticated, so a different seq fails
assert(s.open(key, env, 8) == nil, "sequence mismatch (replay) is rejected");

// downgrade protection: the version prefix is part of the tag — flipping it fails
let downgraded = "v9" + str_slice(env, 2, len(env));
assert(s.open(key, downgraded, 7) == nil, "version/downgrade tamper is rejected");

// distinct nonces: sealing the same message twice yields different envelopes
assert(s.seal(key, "x", 0) != s.seal(key, "x", 0), "fresh nonce per seal (no deterministic ciphertext)");

print "securelayer_pass";
