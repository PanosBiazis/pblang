// tests/semantics/diagnostics_test.sapp — smart diagnostics engine (stdlib/diagnostics.sapp)
// Rust-style "did you mean", unused detection, severity + fix-it, and autofix.

let D = import("stdlib/diagnostics.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : <<" + s + ">>"); } }

// ── edit_distance ──────────────────────────────────────────────────────────────────
eq(D.edit_distance("kitten", "kitten"), 0, "same string -> 0");
eq(D.edit_distance("kitten", "sitten"), 1, "one substitution");
eq(D.edit_distance("abc", "abd"), 1, "one sub");
eq(D.edit_distance("", "abc"), 3, "all insertions");

// ── suggest_name: closest candidate within threshold ──────────────────────────────
eq(D.suggest_name("valeu", ["value", "color", "len"]), "value", "suggests value");
eq(D.suggest_name("zzzzzz", ["value", "color"]), nil, "no close match -> nil");

// ── diagnose: undefined name gets a did-you-mean + fix ────────────────────────────
let r = D.diagnose("let value = 1;\nprint valeu;");
if r.ok { fail("undefined name should make ok=false"); }
let und = nil;
let i = 0;
while i < len(r.diagnostics) { if r.diagnostics[i].code == "undefined-name" { und = r.diagnostics[i]; } i = i + 1; }
if und == nil { fail("should report undefined-name"); }
eq(und.severity, "error", "undefined is an error");
eq(und.suggestion, "value", "suggests value");
has(und.help, "did you mean", "help text");
eq(und.fix.kind, "replace_identifier", "fix kind");
eq(und.fix.to, "value", "fix target");

// ── diagnose: clean code -> ok, no errors ─────────────────────────────────────────
let clean = D.diagnose("let x = 1;\nprint x;");
if not clean.ok { fail("clean code should be ok, got: " + str(clean.diagnostics)); }

// ── diagnose: BUILTINS are known names, not undefined (the pbide-109-errors bug) ──
let bi = D.diagnose("let a = len(str_slice(\"hey\", 0, 2)) + num_floor(1.5);\nprint a;");
if not bi.ok { fail("builtin calls must not be undefined-name: " + str(bi.errors)); }
// ...but a typo'd builtin still errors (and suggests the real one)
let bt = D.diagnose("let a = str_slcie(\"hey\", 0, 2);\nprint a;");
if bt.ok { fail("typo'd builtin should still be an error"); }
let bs = nil;
let bk = 0;
while bk < len(bt.diagnostics) { if bt.diagnostics[bk].code == "undefined-name" { bs = bt.diagnostics[bk]; } bk = bk + 1; }
if bs == nil { fail("typo'd builtin reports undefined-name"); }
eq(bs.suggestion, "str_slice", "typo'd builtin suggests the real builtin");

// ── diagnose: TOP-LEVEL forward fn references are legal (globals resolve at call time) ──
let fwd = D.diagnose("fn a() { return b(); }\nfn b() { return 1; }\nprint a();");
if not fwd.ok { fail("forward top-level fn reference should be ok: " + str(fwd.errors)); }
// nested fns are NOT hoisted by the VM — a forward ref inside a block stays an error
let fwd2 = D.diagnose("fn outer() { fn x() { return y(); } fn y() { return 2; } return x(); }\nprint outer();");
if fwd2.ok { fail("nested forward fn reference should still be flagged"); }

// ── diagnose: KEYWORD field names after `.` are valid (the VM allows m.fn/m.type) ──
let kwf = D.diagnose("let m = map{ fn: 5, type: 9 };\nprint m.fn;\nprint m.type;");
if not kwf.ok { fail("keyword field access must parse cleanly: " + str(kwf.errors)); }
let kwo = D.diagnose("let m = map{ fn: 5 };\nlet a = m?.fn;\nprint a;");
if not kwo.ok { fail("optional keyword field access must parse cleanly: " + str(kwo.errors)); }

// ── diagnose: unused variable -> warning ──────────────────────────────────────────
let u = D.diagnose("let unusedvar = 5;\nprint 1;");
let foundu = false;
let j = 0;
while j < len(u.diagnostics) { if u.diagnostics[j].code == "unused-variable" { foundu = true; } j = j + 1; }
if not foundu { fail("should warn about unused variable: " + str(u.diagnostics)); }

// unused warnings must carry the LINE of the declaration (was always 0,
// which made large-file cleanups a manual hunt)
let ul = D.diagnose("print 1;\nprint 2;\nlet lonely = 5;\nprint 3;");
let k1 = 0;
let lonely_line = 0;
while k1 < len(ul.diagnostics) {
    if ul.diagnostics[k1].code == "unused-variable" { lonely_line = ul.diagnostics[k1].line; }
    k1 = k1 + 1;
}
if lonely_line != 3 { fail("unused warning should point at line 3, got " + str(lonely_line)); }

// underscore-prefixed names are the DECLARED way to say "intentionally unused"
// (the warning's own help text) — they must not warn.
let uu = D.diagnose("let _ = 5;\nlet _scratch = 6;\nprint 1;");
let k2 = 0;
while k2 < len(uu.diagnostics) {
    if uu.diagnostics[k2].code == "unused-variable" {
        fail("underscore-prefixed binding must not warn: " + str(uu.diagnostics[k2]));
    }
    k2 = k2 + 1;
}

// ── autofix: rename undefined -> suggestion ───────────────────────────────────────
let fx = D.autofix("let value = 1;\nprint valeu;");
has(fx.fixed, "print value", "autofix renames valeu -> value");
if len(fx.applied) < 1 { fail("autofix should report applied fixes"); }
// re-diagnosing the fixed source should clear the undefined-name error
let after = D.diagnose(fx.fixed);
let still = false;
let k = 0;
while k < len(after.diagnostics) { if after.diagnostics[k].code == "undefined-name" { still = true; } k = k + 1; }
if still { fail("autofixed source should have no undefined-name"); }

print "diagnostics_pass";
