let A=import("stdlib:codegen_arm64_ast.sapp");
let S=import("tests/fixtures/arm64_wide_sources.sapp");
let rows=[
    map{source:S.call_source(172),bytes:5192,sha256:"03f3337c998906b1d198fcdad26b46506d3b917e2569b3139f0f0057905231ce"},
    map{source:S.array_source(511),bytes:14328,sha256:"c8b5b2011cc2c8f0b59c1ccda16dd417f61ba389ac4cbafe2407e0ac38ac5cee"},
    map{source:S.map_source(255),bytes:18272,sha256:"14671e0213d9b414d4f7d6ff99a825a6b702beb3401b763695941ebee63daa21"}
];
for row in rows {let code=A.compile_elf(row.source);assert(len(code)==row.bytes and sha256(json_stringify(code))==row.sha256,"old compact boundary artifact unchanged");}
// First former rejection: call cleanup, array bump, map bump respectively.
for source in [S.call_source(173),S.array_source(512),S.map_source(256)] {
    assert(len(A.compile_elf(source))>120,"wide immediate is expanded, not rejected");
}
print "arm64_wide_encoding_pass";
