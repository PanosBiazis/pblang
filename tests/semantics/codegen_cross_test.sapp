// tests/semantics/codegen_cross_test.sapp — cross-platform codegen: the SAME machine code
// wrapped in the right OS container — ELF (Linux), Mach-O (macOS), PE (Windows). ELF is
// run-verified here; Mach-O/PE are format-verified (this Linux host can't execute them, and
// modern macOS needs code-signing / a runnable PE needs an import table).

let C = import("stdlib/codegen_cross.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let sumir = [["seti", 0, 0], ["seti", 1, 10], ["loop", 1, [["add", 0, 1]]]];   // 55

// ── format detection ────────────────────────────────────────────────────────────────
let elf = C.build("linux", "x86_64", sumir);
let macho = C.build("macos", "x86_64", sumir);
let pe = C.build("windows", "x86_64", sumir);
eq(C.format_of(elf), "elf", "linux build is ELF");
eq(C.format_of(macho), "macho", "macos build is Mach-O");
eq(C.format_of(pe), "pe", "windows build is PE");

// ── Mach-O identity: magic CF FA ED FE, cputype x86_64 (0x01000007) ─────────────────
eq(macho[0], 0xCF, "macho magic b0"); eq(macho[3], 0xFE, "macho magic b3");
eq(macho[4], 0x07, "macho cputype low byte (x86_64)");
eq(macho[7], 0x01, "macho cputype high byte");
eq(macho[12], 2, "macho filetype MH_EXECUTE");

// ── PE identity: MZ, then PE\0\0 at e_lfanew(0x40), Machine 0x8664, PE32+ magic 0x20B ─
eq(pe[0], 0x4D, "pe MZ M"); eq(pe[1], 0x5A, "pe MZ Z");
eq(pe[0x40], 0x50, "PE sig P"); eq(pe[0x41], 0x45, "PE sig E");
eq(pe[0x44], 0x64, "PE machine low (0x8664)"); eq(pe[0x45], 0x86, "PE machine high");
eq(pe[0x58], 0x0B, "PE32+ optional magic low (0x20B)"); eq(pe[0x59], 0x02, "PE32+ optional magic high");

// ── the Linux/ELF build still RUNS and returns the right value ──────────────────────
let path = "pbcross.bin";
fs_write_bytes(path, elf);
proc_spawn_wait("bash", ["-c", "chmod +x " + path]);
let r = proc_spawn_wait("bash", ["-c", "./" + path + "; echo RC=$?"]);
proc_spawn_wait("bash", ["-c", "rm -f " + path]);
let out = try r.stdout catch "";
let idx = str_index_of(out, "RC=");
eq(parse_number(str_trim(str_slice(out, idx + 3, len(out)))), 55, "ELF cross build runs = 55");

// ── platform registry lists all three OSes ──────────────────────────────────────────
let ps = C.platforms();
let oses = "";
let i = 0;
while i < len(ps) { oses = oses + ps[i].os + " "; i = i + 1; }
if str_index_of(oses, "linux") < 0 { fail("platforms lists linux"); }
if str_index_of(oses, "macos") < 0 { fail("platforms lists macos"); }
if str_index_of(oses, "windows") < 0 { fail("platforms lists windows"); }

print "codegen_cross_pass";
