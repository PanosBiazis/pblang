let Inspector = import("stdlib:embedded_inspector.sapp");

let manual = Inspector.inspect(map{board:"arduino-uno"});
assert(manual.ok and manual.format == "pblang.embedded-technical-manual.v1",
       "board-only inspection is portable");
assert(manual.compiler.native_only and not manual.compiler.c_fallback,
       "manual publishes native-only compiler status");

let pin = Inspector.inspect(map{board:"esp32-devkitc-v4",pin:"GPIO23"});
assert(pin.ok and pin.pin.gpio == 23 and pin.pin.operations["digital-write"].native,
       "pin inspection separates hardware and experimental native support");

let missing = Inspector.inspect(map{board:"arduino-uno",pin:"D99"});
assert(not missing.ok and missing.error == "unknown board pin alias",
       "unknown pin fails closed");

let backends = Inspector.platform_backends();
assert(backends[0].platform == "linux" and backends[0].discovery == "implemented",
       "platform discovery status is explicit");
assert(backends[1].discovery == "incomplete", "unsupported platform discovery is not implied");

print "embedded_inspector_pass";
