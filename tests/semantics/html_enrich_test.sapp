// tests/semantics/html_enrich_test.sapp — fix + enrichment for stdlib/html.sapp
//
// BUG: unescape decoded &amp; FIRST, so "&amp;lt;" double-decoded to "<" instead
//   of "&lt;". Fixed by decoding &amp; LAST. ENRICH: strip_tags, div/span/p/br.

let html = import("stdlib/html.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base escape/tag still work ───────────────────────────────────────────────────
eq(html.escape("<b>"), "&lt;b&gt;", "escape");
eq(html.tag("h1", "Hi", nil), "<h1>Hi</h1>", "tag");

// ── FIX: unescape does not double-decode ─────────────────────────────────────────
eq(html.unescape("&amp;lt;"), "&lt;", "unescape no double-decode");
eq(html.unescape(html.escape("a < b & c")), "a < b & c", "escape/unescape round-trip");

// ── ENRICH: strip_tags ───────────────────────────────────────────────────────────
eq(html.strip_tags("<p>Hi <b>there</b></p>"), "Hi there", "strip_tags");

// ── ENRICH: convenience tags ─────────────────────────────────────────────────────
eq(html.div("x", nil), "<div>x</div>", "div"); eq(html.p("y", nil), "<p>y</p>", "p");
eq(html.span("z", nil), "<span>z</span>", "span"); eq(html.br(), "<br />", "br");

print "html_enrich_pass";
