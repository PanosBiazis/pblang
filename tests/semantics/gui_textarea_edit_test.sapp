// Multiline editor contract: Unicode scalars, bounded commits, visible caret.
let G=import("stdlib:gui.sapp");let checks=0;
fn check(ok,message){assert(ok,message);checks=checks+1;}
fn fixture(value=""){
 let f=G.form("textarea",400,220);let w=G.textarea("area",10,10,84,44,value);
 G.add(f,G.bind(w,"text"));f.model.text=value;f.focus="area";return f;
}
fn key(f,k,text="",shift=false,ctrl=false){
 G.handle_event(f,map{type:"keydown",key:k,text:text,shift:shift,ctrl:ctrl});G.handle_event(f,map{type:"keyup",key:k});
}
fn field(f){return G.get(f,"area");}
let f=fixture();let w=field(f);
key(f,"Q","αβ");key(f,"Enter");key(f,"Q","γδ");key(f,"Left");key(f,"Q","X");
check(w.value=="αβ\nγXδ" and f.model.text==w.value,"mid-line insertion and binding");
key(f,"Home");check(w.caret==3,"Home targets current logical line");
key(f,"Delete");check(w.value=="αβ\nXδ","Delete removes next scalar");
key(f,"Backspace");check(w.value=="αβXδ" and w.caret==2,"Backspace joins logical lines");
key(f,"End");check(w.caret==4,"End targets current logical line end");
key(f,"A","",false,true);key(f,"Q","Ω");check(w.value=="Ω","Ctrl+A replaces all lines");
key(f,"Home");key(f,"Backspace");check(w.value=="Ω" and w.caret==0,"Backspace at zero");
key(f,"Left");check(w.caret==0,"Left at zero");key(f,"End");key(f,"Right");key(f,"Delete");check(w.value=="Ω" and w.caret==1,"right/delete at end");
// Ordered Greek layouts retain their keysym name for command chords.
let greek=fixture("old");key(greek,"Greek_alpha","α");check(field(greek).value=="oldα","unmodified Greek alpha is text");
key(greek,"Greek_alpha","α",false,true);key(greek,"Q","Ω");check(field(greek).value=="Ω","Greek Ctrl+A selects all");
let textbox_greek=fixture("old");let tgw=field(textbox_greek);tgw.kind="textbox";key(textbox_greek,"Greek_alpha","",false,true);key(textbox_greek,"Q","Ω");check(tgw.value=="Ω","Greek shortcut also works in textbox");
let gw=field(greek);gw.readonly=true;key(greek,"Greek_alpha","α",false,true);key(greek,"Q","β");check(gw.value=="Ω","Greek shortcut respects readonly");
let blank=fixture("\n\n");key(blank,"Home");check(field(blank).caret==2,"trailing empty line Home");
key(blank,"Left");key(blank,"Home");check(field(blank).caret==1,"middle empty line Home");
key(blank,"Delete");check(field(blank).value=="\n","Delete newline");
let select=fixture("α🙂\nβΩ");let sw=field(select);key(select,"Home");key(select,"Left","",true);key(select,"Left","",true);
check(sw.selection_anchor==3 and sw.caret==1,"Shift+Left spans newline and supplementary scalar");
key(select,"Q","é");check(sw.value=="αéβΩ" and sw.caret==2,"replace selection preserves scalar boundaries");
key(select,"Home");key(select,"Right","",true);key(select,"Right","",true);key(select,"Backspace");check(sw.value=="βΩ" and sw.caret==0,"Backspace selection");
key(select,"End");key(select,"Home","",true);key(select,"Right");check(sw.caret==2 and sw.selection_anchor==2,"Right collapses selection at right edge");
key(select,"Home","",true);key(select,"Left");check(sw.caret==0 and sw.selection_anchor==0,"Left collapses selection at left edge");
let limit=fixture("αβ\nγ");let lw=field(limit);lw.max_chars=4;
key(limit,"Q","δ");check(lw.value=="αβ\nγ","full capacity rejects commit");key(limit,"A","",false,true);key(limit,"Q","🙂🙂🙂🙂🙂");check(lw.value=="αβ\nγ" and lw.selection_anchor==0,"oversized replacement preserves selection");
key(limit,"Q","🙂β\n");check(lw.value=="αβ\nγ","embedded control commit rejected");key(limit,"Q","🙂βγδ");check(lw.value=="🙂βγδ","replacement capacity excludes selection");
for bad in [nil,1,[],map{},"\n","\t",str_repeat("a",257)] {let before=lw.value;key(limit,"A",bad);check(lw.value==before,"invalid committed text cannot fall back");}
for prop in ["readonly","enabled","visible"] {
 let locked=fixture("keep");let locked_field=field(locked);locked_field[prop]=if prop=="readonly" {true} else {false};
 key(locked,"A","",false,true);key(locked,"Q","changed");key(locked,"Backspace");check(field(locked).value=="keep","protected field "+prop);
}
let external=fixture("original");key(external,"Home");external.model.text="β";G.sync(external);key(external,"Q","Ω");check(field(external).value=="βΩ","external binding resets stale caret");
for bad in [-1,1.5,"bad",nil,999] {let ew=field(external);ew.caret=bad;ew.selection_anchor=bad;key(external,"Q","X");check(str_ends_with(ew.value,"X"),"invalid positions reset to end");}
let repeated=fixture();G.handle_event(repeated,map{type:"keydown",key:"Q",text:"α"});G.handle_event(repeated,map{type:"keydown",key:"Q",text:"β"});G.handle_event(repeated,map{type:"keyup",key:"Q"});check(field(repeated).value=="αβ","repeated commits exactly once");
// A recording canvas proves viewport and caret coordinates, not font aesthetics.
let lines=[];let rects=[];
let canvas=map{clear:fn(c){},rect:fn(x,y,w,h,c){push(rects,[x,y,w,h,c]);},line:fn(x,y,a,b,c){push(lines,[x,y,a,b,c]);},circle:fn(x,y,r,c){}};
let empty_view=fixture();G.draw(canvas,empty_view);check(field(empty_view).caret==0 and field(empty_view).text_row==0 and field(empty_view).text_offset==0,"empty viewport starts at origin");
let newline_view=fixture("\n\n\n");G.draw(canvas,newline_view);check(field(newline_view).caret==3 and field(newline_view).text_row==2 and field(newline_view).text_offset==0,"newline-only viewport follows trailing caret");
lines=[];rects=[];
let visual=fixture("one\ntwo\nαβγδεζηθ");let vw=field(visual);G.draw(canvas,visual);
check(vw.text_row==1 and vw.text_offset==3,"viewport follows last line and long column");
let carets=0;for l in lines {if l[0]==76 and l[1]==32 and l[2]==76 and l[3]==46 {carets=carets+1;}}
check(carets==1,"visible caret occupies last column in second row");
key(visual,"Home");G.draw(canvas,visual);check(vw.text_offset==0 and vw.text_row==1,"Home restores visible line start");
key(visual,"A","",false,true);G.draw(canvas,visual);let painted=false;for r in rects {if r[0]==16 and r[1]==32 and r[2]>0 and r[3]==14 and r[4]==visual.palette.accent {painted=true;}}
check(painted,"selection receives visible highlight");
vw.w=36;vw.h=28;G.draw(canvas,visual);check(vw.text_row==2 and vw.text_offset==7,"resize adjusts both viewport axes");
vw.w=8;vw.h=8;G.draw(canvas,visual);check(vw.value=="one\ntwo\nαβγδεζηθ","zero interior draw is safe");
print "gui_textarea_edit_pass checks="+str(checks);
