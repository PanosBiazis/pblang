let B = import("stdlib:ai_turn_budget.sapp");
let checks = 0;
fn demand(ok, message) { checks = checks + 1; assert(ok, message); }
let maximum = 9007199254740991;
let p = B.rates(3, 7, 1, 4);
let u = B.usage(10, 5, 20, 2);
let c = B.cost(p, u);
demand(c.categories == map{ input: 30, output: 35, cache_read: 20, cache_write: 8 }, "disjoint categories");
demand(c.total_units == 93, "exact integer sum");
demand(B.cost(B.rates(0, 0, 0, 0), B.usage(1000000000, 1000000000, 1000000000, 1000000000)).total_units == 0, "zero rates at count limit");
demand(B.cost(B.rates(1000000000, 0, 0, 0), B.usage(1)).total_units == 1000000000, "rate boundary");
demand(B.limits() == map{ max_tokens: 1000000000, max_rate: 1000000000, max_units: maximum }, "public limits");
let limits = B.limits(); limits.max_units = 0;
demand(B.limits().max_units == maximum, "limits are independent copies");

let f = B.forecast(p, u, 93);
demand(f.kind == "forecast" and f.allowed and f.remaining_units == 0 and f.shortfall_units == 0, "exact forecast fit");
f = B.forecast(p, u, 92);
demand(not f.allowed and f.remaining_units == 0 and f.shortfall_units == 1, "forecast one below cost");
demand(B.forecast(p, u, 94).remaining_units == 1, "forecast remainder");
let prompt = B.usage(10, 0, 20, 2);
let a = B.affordable_output(p, prompt, 93, 100);
demand(a.allowed and a.output_tokens == 5 and a.total_units == 93 and a.remaining_units == 0, "affordable output after all prompt categories");
a = B.affordable_output(p, prompt, 92, 100);
demand(a.output_tokens == 4 and a.total_units == 86 and a.remaining_units == 6, "integer output floor");
demand(B.affordable_output(p, prompt, 93, 2).output_tokens == 2, "explicit output cap");
demand(B.affordable_output(p, prompt, 93, 0).output_tokens == 0, "zero output cap");
a = B.affordable_output(p, prompt, 58, 100);
demand(a.allowed and a.output_tokens == 0, "exact prompt fit differs from rejection");
a = B.affordable_output(p, prompt, 57, 100);
demand(not a.allowed and a.output_tokens == 0 and a.shortfall_units == 1, "prompt alone unaffordable");
a = B.affordable_output(B.rates(1, 0, 0, 0), B.usage(5), 5, 1000000000);
demand(a.allowed and a.output_tokens == 1000000000 and a.total_units == 5, "free output remains capped");
demand(not B.affordable_output(B.rates(1, 0, 0, 0), B.usage(5), 4, 100).allowed, "free output cannot rescue denied prompt");

let actual = B.account(p, u, 100);
demand(actual.kind == "actual" and actual.within_budget and actual.spent_units == 93 and actual.remaining_units == 7, "actual accounting");
actual = B.account(p, B.usage(0, 2), 100, actual.spent_units);
demand(not actual.within_budget and actual.spent_units == 107 and actual.excess_units == 7 and actual.remaining_units == 0, "actual overspend is recorded");
actual = B.account(p, B.usage(), 100, 107);
demand(not actual.within_budget and actual.spent_units == 107 and actual.excess_units == 7, "existing overspend survives empty usage");
demand(B.account(p, B.usage(), 0).within_budget, "empty zero budget");
// A permitted estimate does not authorize discarding a larger actual charge.
demand(B.forecast(p, B.usage(1), 3).allowed, "small estimate admitted");
demand(B.account(p, B.usage(2), 3).excess_units == 3, "larger actual charge reported");

// Exact MAX_SAFE factorization uses valid counts and rates below 1e9.
let edge_rates = B.rates(20394401, 1, 0, 0);
let edge_usage = B.usage(441650591);
demand(B.cost(edge_rates, edge_usage).total_units == maximum, "maximum exact product");
demand(B.account(edge_rates, edge_usage, maximum).spent_units == maximum, "maximum exact accounting");
demand(try { B.cost(edge_rates, B.usage(441650591, 1)); false } catch true, "sum overflow by one rejects");
demand(try { B.account(edge_rates, edge_usage, maximum, 1); false } catch true, "existing spend overflow rejects");
demand(try { B.cost(B.rates(67108864, 0, 0, 0), B.usage(134217728)); false } catch true, "2^53 product rejects");
demand(try { B.cost(B.rates(1000000000, 0, 0, 0), B.usage(1000000000)); false } catch true, "large product rejects");
let output_edge = B.rates(0, 20394401, 0, 0);
demand(B.affordable_output(output_edge, B.usage(), maximum, 1000000000).output_tokens == 441650591, "maximum budget exact division");
a = B.affordable_output(output_edge, B.usage(), maximum - 1, 1000000000);
demand(a.output_tokens == 441650590 and a.remaining_units == 20394400, "one below exact divisibility");
a = B.affordable_output(B.rates(0, 67108864, 0, 0), B.usage(), maximum, 1000000000);
demand(a.output_tokens == 134217727 and a.remaining_units == 67108863, "binary quotient near safe boundary");
demand(B.account(B.rates(0, 0, 0, 0), B.usage(), 0, maximum).excess_units == maximum, "maximum existing overspend retained");

// Construct runtime nonfinite fixtures without a statically invalid expression.
fn ratio(numerator, denominator) { return numerator / denominator; }
let nan = ratio(0, 0);
let infinity = ratio(1, 0);
let bad_numbers = [nil, true, false, "1", -1, 0.5, 1000000001, 9007199254740992,
    nan, infinity, -infinity, bigint("1"), decimal("1"), rational(1, 1), [], map{}];
for bad in bad_numbers {
    demand(try { B.rates(bad, 0, 0, 0); false } catch true, "strict rate validation");
    demand(try { B.usage(0, 0, bad, 0); false } catch true, "strict usage validation");
    demand(try { B.cost(p, map{ input: 0, output: bad, cache_read: 0, cache_write: 0 }); false } catch true, "raw usage validation");
    demand(try { B.cost(map{ input: 0, output: 0, cache_read: 0, cache_write: bad }, u); false } catch true, "raw price validation");
    demand(try { B.affordable_output(p, B.usage(), 100, bad); false } catch true, "strict output cap");
}
for bad in [nil, false, "1", -1, 0.5, 9007199254740992, nan, infinity, -infinity, bigint("1"), map{}] {
    demand(try { B.forecast(p, u, bad); false } catch true, "strict forecast budget");
    demand(try { B.affordable_output(p, B.usage(), bad, 1); false } catch true, "strict affordable budget");
    demand(try { B.account(p, u, bad); false } catch true, "strict actual budget");
    demand(try { B.account(p, u, 100, bad); false } catch true, "strict prior spend");
}
let shapes = [nil, [], false, "private synthetic text", map{},
    map{ input: 0, output: 0, cache_read: 0 },
    map{ input: 0, output: 0, cache_read: 0, typo: 0 },
    map{ input: 0, output: 0, cache_read: 0, cache_write: 0, extra: 0 }];
for bad in shapes {
    demand(try { B.cost(bad, u); false } catch true, "malformed price map");
    demand(try { B.cost(p, bad); false } catch true, "malformed usage map");
    demand(try { B.forecast(p, bad, 100); false } catch true, "forecast validates record");
    demand(try { B.account(p, bad, 100); false } catch true, "actual validates record");
}
demand(try { B.affordable_output(p, u, 100, 10); false } catch true, "nonzero prompt output not ignored");
demand(try { B.rates(1, 2, 3); false } catch true, "missing cache-write rate rejects");
demand(try { B.cost(p); false } catch true, "missing usage rejects");
demand(try { B.forecast(p, u); false } catch true, "missing forecast budget rejects");
demand(try { B.affordable_output(p, prompt, 100); false } catch true, "missing explicit output cap rejects");
demand(try { B.account(p, u); false } catch true, "missing actual budget rejects");
let cyclic = map{ input: 0, output: 0, cache_read: 0, cache_write: nil };
// Hostile runtime records need not satisfy the source checker's inferred map type.
fn attach_cycle(record) { record.cache_write = record; }
attach_cycle(cyclic);
demand(try { B.cost(p, cyclic); false } catch true, "cyclic value rejected without traversal");
cyclic.cache_write = 0;
let before = json_stringify([p, u, prompt]);
B.cost(p, u); B.forecast(p, u, 1); B.account(p, u, 1); B.affordable_output(p, prompt, 1, 1);
demand(json_stringify([p, u, prompt]) == before, "accepted and denied calls never mutate callers");
c.categories.input = 999;
demand(B.cost(p, u).categories.input == 30, "results do not alias inputs or future results");

// Independent small-domain oracle: repeated addition, no division/multiplication.
for rate 7 {
    for budget 20 {
        for cap 6 {
            let expected = 0;
            let spent = 0;
            while expected < cap and spent + rate <= budget {
                expected = expected + 1; spent = spent + rate;
            }
            let result = B.affordable_output(B.rates(0, rate, 0, 0), B.usage(), budget, cap);
            demand(result.output_tokens == expected and result.total_units == spent and
                result.remaining_units == budget - spent, "independent affordable-output oracle");
        }
    }
}
print "ai_turn_budget_pass " + str(checks);
