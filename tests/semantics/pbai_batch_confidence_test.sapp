// tests/semantics/pbai_batch_confidence_test.sapp — the batch path carries CONFIDENCE too.
// classify_batch_confident() fans out across all cores and returns {intent, confidence} per
// item (native softmax confidence, matching the single-prompt confidence()). ensemble_batch()
// applies the weighted ensemble (incl. registered LLM voters) per item with an escalation flag.

let pbai = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let prompts = [
    "explain this code", "find the bug here", "optimize this loop", "add comments to this",
    "how does pblang work", "make this faster", "what is wrong with this", "document this function"
];

// ── classify_batch_confident: intent matches the plain batch, confidence matches single ──
pbai.clear_voters();
let plain = pbai.classify_batch(prompts);
let conf = pbai.classify_batch_confident(prompts);
eq(len(conf), len(prompts), "confident batch length");
let i = 0;
while i < len(prompts) {
    if not map_has(conf[i], "intent") or not map_has(conf[i], "confidence") { fail("item shape " + str(i)); }
    eq(conf[i].intent, plain[i], "confident batch intent[" + str(i) + "] matches plain batch");
    approx(conf[i].confidence, pbai.confidence(prompts[i]), "confidence[" + str(i) + "] matches single-prompt");
    if conf[i].confidence <= 0 or conf[i].confidence > 1 { fail("confidence must be in (0,1] at " + str(i)); }
    i = i + 1;
}

// ── ensemble_batch with no voters == native intents, all fully confident (no escalation) ─
let eb = pbai.ensemble_batch(prompts, 0.5);
eq(len(eb), len(prompts), "ensemble batch length");
let j = 0;
while j < len(prompts) {
    eq(eb[j].intent, plain[j], "ensemble_batch intent[" + str(j) + "] == native (no voters)");
    approx(eb[j].confidence, 1.0, "no-voter ensemble is unanimous at " + str(j));
    eq(eb[j].escalate, false, "confident item does not escalate at " + str(j));
    j = j + 1;
}

// ── a strong voter swings the whole batch, and low agreement flags escalation ───────────
pbai.register_voter_weighted("boss", fn(x) { return map{ intent: "bugs", confidence: 0.9 }; }, 4);
pbai.register_voter("dissent", fn(x) { return map{ intent: "improve", confidence: 0.9 }; });
let eb2 = pbai.ensemble_batch(prompts, 0.99);   // strict threshold -> split items escalate
let k = 0;
while k < len(prompts) {
    eq(eb2[k].intent, "bugs", "strong voter wins item[" + str(k) + "]");
    eq(eb2[k].escalate, true, "split batch escalates under strict threshold at " + str(k));
    k = k + 1;
}
pbai.clear_voters();

print "pbai_batch_confidence_pass";
