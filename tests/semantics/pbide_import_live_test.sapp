// Disposable loopback upload tests, with no filesystem writes or execution of source.
let W=import("editors/ide/pbide_text_web.sapp");
let HTTP=import("stdlib:http_server.sapp");
let TCP=import("stdlib:native_tcp.sapp");
let D=import("editors/ide/pbide_tabs_wire.sapp");
let H=import("editors/ide/pbide_text_history.sapp");
let T=import("editors/ide/pbide_text.sapp");
if not TCP.available().ok { print "pbide_import_live_unsupported"; return; }
fn exchange(kind) {
    let listener=TCP.listen_ipv4("127.0.0.1",0,8); assert(listener.ok,"listener opened");
    let port=listener.port; let host=W.endpoint(port);
    let workspace=D.encode(D.create(H.create(T.selection("original"),8192)));
    let body="--PB_live\r\nContent-Disposition: form-data; name=\"workspace\"\r\n\r\n"+workspace
        +"\r\n--PB_live\r\nContent-Disposition: form-data; name=\"upload\"; filename=\"private-canary.sapp\"\r\nContent-Type: text/plain\r\n\r\n"
        +strfromcharcode(65279)+"let π=\"😀\";\r\n<script>literal</script>\r\n--PB_live--\r\n";
    let bytes=str_to_bytes(body); if kind=="utf8" { bytes[0]=255; }
    let count=len(bytes); if kind=="oversize" { count=24577; bytes=[]; }
    let origin="http://"+host; if kind=="origin" { origin="https://foreign.invalid"; }
    let request_host=host; if kind=="host" { request_host="foreign.invalid"; }
    let headers="POST /import HTTP/1.1\r\nHost: "+request_host+"\r\nOrigin: "+origin
        +"\r\nContent-Type: multipart/form-data; boundary=PB_live\r\nContent-Length: "+str(count)
        +"\r\nConnection: close\r\n\r\n";
    let wire=str_to_bytes(headers); for byte in bytes { push(wire,byte); }
    let marker="</html>";
    if kind=="utf8" { marker="valid UTF-8"; }
    if kind=="oversize" or kind=="origin" or kind=="host" { marker="local editor."; }
    let done=channel();
    let worker=spawn(fn(){
        let N=import("stdlib:native_tcp.sapp");
        let client=N.connect_ipv4("127.0.0.1",port,1000);
        let written=N.write_bytes(client,wire,1000);
        let reply=N.read_until(client,marker,W.MAX_RESPONSE,1500); N.close(client);
        assert(client.ok and written.ok and reply.ok,"bounded client completed");
        send(done.sender,reply.text);
    });
    let calls=0; let policy=W.options(port); policy.max_connections=1;
    let served=HTTP.serve_bounded_listener(listener,fn(req){calls=calls+1;return W.handle(req,port);},policy);
    TCP.close(listener); let reply=recv_timeout(done.receiver,2000); join(worker);
    assert(served.completed==1,"connection completed");
    return map{reply:reply,calls:calls};
}
let good=exchange("valid");
assert(good.calls==1 and str_contains(good.reply,"200 OK")
    and str_contains(good.reply,"Draft2 history position 1 of 1")
    and str_contains(good.reply,"let π=&quot;😀&quot;;\n&lt;script&gt;literal&lt;/script&gt;")
    and not str_contains(good.reply,"private-canary")
    and str_contains(good.reply,"script-src 'none'"),"actual UTF-8 multipart import, normalized escaped source and private metadata");
let utf8=exchange("utf8");
assert(utf8.calls==0 and str_contains(utf8.reply,"400 Bad Request"),"invalid UTF-8 rejected before handler");
for kind in ["oversize","host","origin"] {
    let denied=exchange(kind);
    assert(denied.calls==0 and str_contains(denied.reply,"403 Forbidden")
        and not str_contains(denied.reply,"private-canary"),"preflight rejects without reading upload body or calling handler");
}
print "pbide_import_live_pass";
