let BUNDLE = import("stdlib:immutable_broker_bundle.sapp");
let SHA256 = import("stdlib:sha256_pb.sapp");

fn require(value, message) { if not value { throw "FAIL immutable broker bundle: " + message; } }
fn tree_digest(items) {
    let by_path = map{}; let paths = [];
    for item in items { by_path[item.path] = item.bytes; array_push(paths, item.path); }
    let hash = SHA256.new();
    for path in array_sort(paths) {
        SHA256.update(hash, str_to_bytes(path)); SHA256.update(hash, [0]);
        SHA256.update(hash, by_path[path]); SHA256.update(hash, [0]);
    }
    return SHA256.finish(hash);
}

if platform() == "linux" {
    let root = "/tmp/pblang_broker_bundle_" + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 16);
    let dep = root + "/dep"; fs_mkdirs(dep);
    let dep_bytes = str_to_bytes("fn value() { return 7; }\nexport value;\n");
    fs_write_bytes(dep + "/value.sapp", dep_bytes);
    let manifest = "[package]\nname = \"bundle-fixture\"\nversion = \"1.0.0\"\nentry = \"main.sapp\"\n\n"
        + "[dependencies]\ndep = { path = \"dep\" }\n";
    fs_write(root + "/pblang.toml", manifest);
    fs_write(root + "/main.sapp", "let D = import(\"dep:value.sapp\");\nprint D.value();\n");
    let lock = "manifest_sha256 = \"" + SHA256.sha256_hex_bytes(str_to_bytes(manifest)) + "\"\n"
        + "content_hash_algorithm = \"pblang-package-tree-v2\"\n\n"
        + "[dependencies.dep]\npath = \"dep\"\nsha256 = \"" + tree_digest([
            map{ path: "value.sapp", bytes: dep_bytes }]) + "\"\n";
    fs_write(root + "/pblang.lock", lock);

    let first = BUNDLE.build("main.sapp", root);
    let second = BUNDLE.build("main.sapp", root);
    require(first.ok and second.ok and first.closure_sha256 == second.closure_sha256
        and first.source_sha256 == sha256(first.source), "deterministic exact closure binding");
    require(first.lock_verified and first.immutable_snapshot and first.in_memory_only
        and first.descriptor_confined_snapshot and first.content_hash_algorithm_verified
        and first.content_hash_algorithm == "pblang-package-tree-v2"
        and not first.executable and not first.executed and not first.effects_applied,
        "bundle grants no execution authority");

    fs_write(root + "/pblang.lock", str_replace_all(lock,
        "content_hash_algorithm = \"pblang-package-tree-v2\"\n", ""));
    require(not BUNDLE.build("main.sapp", root).ok, "missing hash algorithm fails closed");
    fs_write(root + "/pblang.lock", str_replace_all(lock,
        "pblang-package-tree-v2", "pblang-package-tree-v1"));
    require(not BUNDLE.build("main.sapp", root).ok, "legacy hash algorithm fails closed");
    fs_write(root + "/pblang.lock", lock);
    require(not first.immutable_runtime_handoff_verified
        and not first.runtime_identity_verified and not first.production_execution_ready,
        "missing runtime handoff remains fail closed");

    fs_write(dep + "/value.sapp", "fn value() { return 8; }\nexport value;\n");
    require(not BUNDLE.build("main.sapp", root).ok, "dependency mutation fails its lock");
    fs_write_bytes(dep + "/value.sapp", dep_bytes);
    fs_write(root + "/main.sapp", "fn load() { let D = import(\"dep:value.sapp\"); return D.value(); }\n");
    require(not BUNDLE.build("main.sapp", root).ok, "nested dynamic import fails closed");
    require(not BUNDLE.build("../main.sapp", root).ok, "entry traversal fails closed");

    try fs_remove(root + "/pblang.lock") catch nil;
    try fs_remove(root + "/pblang.toml") catch nil;
    try fs_remove(root + "/main.sapp") catch nil;
    try fs_remove(dep + "/value.sapp") catch nil;
}

let state = BUNDLE.status();
require(not state.immutable_runtime_handoff_verified
    and not state.runtime_identity_verified
    and not state.pathname_publication_allowed
    and not state.production_execution_ready, "status preserves the execution boundary");

print "immutable_broker_bundle_pass";
