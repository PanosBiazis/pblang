let R=import("stdlib:subtitle_reading.sapp");let S=import("stdlib:subtitles.sapp");
let doc=S.parse_srt("1\n00:00:00,000 --> 00:00:01,000\nα β\n\n2\n00:00:01,000 --> 00:00:01,100\n1234\n");let before=S.to_srt(doc);let r=R.analyze(doc,2);assert(r.cues[0].characters==3 and r.cues[0].nonspace_characters==2 and r.cues[0].words==2,"literal metrics");assert(not r.cues[0].above_limit and r.cues[1].characters_per_second==40,"exact boundary");assert(r.above_limit==1 and R.next_above(doc,0,2)==1 and R.next_above(doc,1,2)==1,"wrap selection");assert(R.next_above(doc,0,40)==nil,"strict greater than");assert((try R.analyze(doc,-1) catch nil)==nil and (try R.analyze(doc,"20") catch nil)==nil and (try R.analyze(doc,1000001) catch nil)==nil,"limit validation");assert((try R.next_above(doc,2,20) catch nil)==nil,"index validation");r.cues[0].words=100;assert(S.to_srt(doc)==before,"source retained");let one=S.set_cue(doc,0,0,1,"é");assert(R.analyze(one).cues[0].characters_per_second==2000,"code points not graphemes");print "subtitle_reading_pass";
