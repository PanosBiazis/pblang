let Web=import("../../examples/uno_r4_led_studio/web.sapp");let Model=import("../../examples/uno_r4_led_studio/model.sapp");
fn req(method,path="/",body="") {return map{method:method,path:path,body:body,headers:map{host:"127.0.0.1:8768",origin:"http://127.0.0.1:8768","content-type":"application/x-www-form-urlencoded"}};}
fn hidden(page,key) {return str_split(str_split(page.body,"name=\""+key+"\" value=\"")[1],"\"")[0];}
fn body(page,action,text="PB",duration="250") {return "csrf="+hidden(page,"csrf")+"&revision="+hidden(page,"revision")+"&action="+action+"&f_text="+url_encode(text)+"&f_duration="+duration;}
let app=Web.create(8768,map{hide_source_names:false,discourage_scraping:false,throttle_rejected_requests:false});
let first=app.handle(req("GET"));assert(first.status==200 and str_contains(first.body,"Pixel 1, 1: off"),"accessible 96-pixel editor");assert(not str_contains(first.body,"<set "),"opening does not start motion");
let request=body(first,"pixel_0");let edited=app.handle(req("POST","/action",request));
assert(edited.status==200 and app.state.document.frames[0].pixels[0]==1 and str_contains(edited.body,"Pixel 1, 1: on"),"real bound pixel action updates render");
assert(app.handle(req("POST","/action",request)).status==403,"old form token revoked after redraw");
let p=app.handle(req("POST","/action",body(edited,"do_border")));assert(app.state.document.frames[0].pixels[95]==1,"preset action");
p=app.handle(req("POST","/action",body(p,"do_add")));assert(len(app.state.document.frames)==2 and app.state.index==1,"web duplicate timeline");
p=app.handle(req("POST","/action",body(p,"do_duration","PB","100")));assert(app.state.document.frames[1].duration_ms==100,"web timing edit");
p=app.handle(req("POST","/action",body(p,"do_text","πΩ")));assert(len(app.state.document.frames)==25,"web text glyph rendering");
let snapshot=Model.export_document(app.state);
p=app.handle(req("POST","/action",body(p,"do_text","漢")));assert(Model.export_document(app.state)==snapshot and not str_contains(p.body,"<script>"),"unsupported input atomic and escaped");
let hostile=req("POST","/action",body(p,"pixel_1"));hostile.headers.origin="https://invalid.example";
assert(app.handle(hostile).status==403 and Model.export_document(app.state)==snapshot,"foreign origin rejected");
let unknown=app.handle(req("POST","/action",body(p,"not_bound")));assert(unknown.status==400,"unknown actions rejected");
let output=app.handle(req("GET","/frames.json"));
assert(output.status==200 and output.headers["Content-Disposition"]=="attachment; filename=uno-r4-frames.json" and output.body==snapshot,"validated JSON download");
assert(str_contains(output.headers["Content-Security-Policy"],"default-src 'none'") and not map_has(output.headers,"Set-Cookie"),"existing guarded transport retained");
p=app.handle(req("POST","/action",body(p,"do_text","<script>")));
assert(p.status==200 and app.state.text=="<script>" and not str_contains(p.body,"<script>") and str_contains(p.body,"&lt;script&gt;"),"supported literal markup remains escaped text after download");
let css=app.handle(req("GET","/style.css"));assert(str_contains(css.body,"repeat(12,minmax(0,1fr))"),"fixed physical pixel grid at narrow viewport");assert(str_contains(css.body,"prefers-reduced-motion:reduce"),"static reduced-motion style supplied");
let source=Model.export_document(app.state);
p=app.handle(req("POST","/action",body(p,"do_import")+"&animation="+url_encode(source)));
assert(p.status==200 and app.state.index==0 and not app.state.playing and Model.export_document(app.state)==source,"exported animation imports through guarded form");assert(not str_contains(p.body,"<set "),"import does not start motion");
p=app.handle(req("POST","/action",body(p,"do_play")));
assert(app.state.playing and str_contains(p.body,"id=\"led-playback\"") and str_contains(p.body,"Stop playback") and not str_contains(p.body,"<script"),"Web play emits finite declarative preview");
let playing=Model.export_document(app.state);let started=app.state.started;
p=app.handle(req("POST","/action",body(p,"do_import")+"&animation=%7Bbad"));
assert(app.state.playing and app.state.started==started and Model.export_document(app.state)==playing,"malformed import preserves existing playback/document");
p=app.handle(req("POST","/action",body(p,"do_stop")));
assert(not app.state.playing and not str_contains(p.body,"id=\"led-playback\""),"Stop removes complete animation tree");
p=app.handle(req("POST","/action",body(p,"do_play")));
p=app.handle(req("POST","/action",body(p,"do_border")));
assert(not app.state.playing and not str_contains(p.body,"<set "),"editing removes animation elements");
let preserved=Model.export_document(app.state);
let invalid=req("POST","/action",body(p,"do_import")+"&animation="+url_encode(source));invalid.headers.origin="https://invalid.example";
assert(app.handle(invalid).status==403 and Model.export_document(app.state)==preserved,"cross-origin import rejected before model change");
assert(app.handle(req("POST","/action",body(p,"do_import")+"&animation=x&animation=y")).status==400,"duplicate payload rejected");
assert(app.handle(req("POST","/action",body(p,"do_import")+"&animation="+str_repeat("x",131073))).status==400,"oversize payload rejected");
p=app.handle(req("POST","/action",body(p,"do_import")+"&animation="+url_encode(source)));
assert(Model.export_document(app.state)==source,"rejected imports did not consume legitimate token");
p=app.handle(req("POST","/action",body(p,"do_play")));
app.close();assert(not app.state.playing,"close stops playback");assert(app.handle(req("GET")).status==503,"close revokes editor");
let defaults=Web.create();let dp=defaults.handle(req("GET"));
fn opaque_body(page,action) {return "csrf="+hidden(page,"csrf")+"&revision="+hidden(page,"revision")+"&action="+action+"&f_99=PB&f_100=250";}
dp=defaults.handle(req("POST","/action",opaque_body(dp,"a_112")));
let stop_value=str_split(str_split(dp.body,"form=\"led-editor\" type=\"submit\" name=\"action\" value=\"")[1],"\"")[0];
dp=defaults.handle(req("POST","/action",opaque_body(dp,stop_value)));
assert(not defaults.state.playing and not str_contains(dp.body,"<set "),"visible Stop uses generated default action identity");defaults.close();
let limited=Web.create();let lp=limited.handle(req("GET"));
let edit="csrf="+hidden(lp,"csrf")+"&revision=0&action=a_2&f_99=PB&f_100=250";
assert(limited.handle(req("POST","/action",edit)).status==200,"default opaque actions work");
for _i 118 {assert(limited.handle(req("GET","/robots.txt")).status==200,"within persistent request budget");}
assert(limited.handle(req("GET","/robots.txt")).status==429,"redraw does not reset request budget");limited.close();
print "uno_r4_led_studio_web_pass";
