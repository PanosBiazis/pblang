// tests/semantics/poly_interop_enrich_test.sapp — enrichment for polyglot_registry +
// ffi_universal + interop (pure helpers).

let R = import("stdlib/polyglot_registry.sapp");
let FU = import("stdlib/ffi_universal.sapp");
let IO = import("stdlib/interop.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn contains(arr, v) { let i = 0; while i < len(arr) { if arr[i] == v { return true; } i = i + 1; } return false; }

// ── registry pure lookups ───────────────────────────────────────────────────────────
if not R.is_supported("rust") { fail("rust supported"); }
if R.is_supported("notalang_xyz") { fail("unknown lang not supported"); }
eq(R.lang_for_ext("rs"), "rust", "ext rs -> rust");
eq(R.category_of("rust"), "compiled", "rust is compiled");
eq(R.category_of("notalang_xyz"), nil, "unknown -> nil category");

// ── ffi_universal type helpers ────────────────────────────────────────────────────
eq(FU.sizeof("int"), FU.type_size("int"), "sizeof == type_size");
if not FU.is_type("int64_t") { fail("int64_t is a type"); }
if FU.is_type("notatype_xyz") { fail("unknown type"); }
eq(FU.type_size("notatype_xyz"), 8, "unknown type defaults to 8 (no throw)");
eq(FU.struct_size([map{ name: "a", type: "int32_t" }, map{ name: "b", type: "int64_t" }]),
   FU.type_size("int32_t") + FU.type_size("int64_t"), "struct_size sums field sizes");

// ── interop formats + to_json ───────────────────────────────────────────────────────
let f = IO.formats();
if not contains(f, "lua") { fail("formats has lua"); }
if not contains(f, "json") { fail("formats has json"); }
let j = IO.to_json(map{ a: 1 });
if str_index_of(j, "a") < 0 { fail("to_json includes the key: " + j); }

print "poly_interop_enrich_pass";
