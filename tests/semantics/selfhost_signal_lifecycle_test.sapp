let FE=import("stdlib:compiler/selfhost_frontend.sapp");
let source="let S=import(\"stdlib:signal.sapp\");let src=S.new();let d=S.distinct_signal(src);let seen=[];"
 +"S.subscribe(d,fn(v){push(seen,v);if len(seen)<3 {S.emit(src,v);}});S.emit(src,7);S.disconnect(d);"
 +"let result=[seen,S.count(src),S.count(d)];";
let run=FE.frontend_run_bounded(source,map{max_steps:100000,max_frames:32,max_modules:8,max_source_bytes:65536});
assert(run.ok,"selfhost signal execution");
assert(run.globals.result==[[7],0,1],"selfhost lifecycle and reentrant distinct");
print "selfhost_signal_lifecycle_pass";
