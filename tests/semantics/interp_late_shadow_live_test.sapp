// Exercise the public driver in a bounded local child process.
if platform() != "linux" { print "interp_late_shadow_live_skip_linux_required"; os_exit(0); }
let compiler = env_get("PBLANG_BIN") ?? path_join(cwd(), "target/release/pblang");
let result = proc_spawn_wait("/usr/bin/timeout", ["-k", "1s", "8s", compiler, "run",
    "tools/pbi.sapp", "--allow-all", "--", "tests/fixtures/interp_late_shadow_program.sapp"]);
assert(result.exit_code == 0 and result.stderr == "", "pbi driver completed normally");
assert(result.stdout == "1\n3\n2\n4\n3\n", "pbi preserves dynamic captured lookup");
print "interp_late_shadow_live_pass";
