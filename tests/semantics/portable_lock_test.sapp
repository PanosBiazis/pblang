let LOCK = import("stdlib:portable_lock.sapp");

fn require(value, message) { if not value { throw "portable_lock_test: " + message; } }

let manifest = "[package]\nname = \"demo\"\nversion = \"1.0.0\"\n\n[dependencies]\nstdlib = { path = \"../pblang/stdlib\", paths = [\"fallback\"] }\n";
let digest = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
let lock = "manifest_sha256 = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n\n[dependencies.stdlib]\npath = \"/workspace/products/pblang/stdlib\"\nsha256 = \"" + digest + "\"\n";
let result = LOCK.normalize_text(manifest, lock, "/workspace/products/pb-mcp-server");
require(result.ok and result.rewritten == 1, "one local dependency must be rewritten");
require(str_contains(result.text, "path = \"../pblang/stdlib\""), "relative manifest path must be published");
require(str_contains(result.text, "sha256 = \"" + digest + "\""), "content digest must be preserved");
let again = LOCK.normalize_text(manifest, result.text, "/workspace/products/pb-mcp-server");
require(again.text == result.text, "normalization must be idempotent");

let absolute_rejected = try {
    LOCK.manifest_paths("[dependencies]\nstdlib = { path = \"/private/build/stdlib\" }\n");
    false
} catch true;
require(absolute_rejected, "absolute manifest dependency paths must fail closed");

let mismatch_rejected = try {
    LOCK.normalize_text(manifest,
        str_replace_all(lock, "/workspace/products/pblang/stdlib", "/different/stdlib"),
        "/workspace/products/pb-mcp-server");
    false
} catch true;
require(mismatch_rejected, "a lock pointing at another dependency root must fail closed");

let temporary_root = try env_get("TMPDIR") catch nil;
if temporary_root == nil or temporary_root == "" { temporary_root = "/tmp"; }
let temp = path_join(temporary_root, "pblang-portable-lock-test-" + str(now_ms()));
fs_mkdirs(temp);
fs_write(path_join(temp, "pblang.toml"), "[dependencies]\nstdlib = { path = \"stdlib\" }\n");
fs_mkdirs(path_join(temp, "stdlib"));
fs_write(path_join(temp, "pblang.lock"),
    "manifest_sha256 = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n\n"
    + "[dependencies.stdlib]\npath = \"" + path_join(temp, "stdlib") + "\"\nsha256 = \"" + digest + "\"\n");
let published = LOCK.publish(temp);
require(published.ok and published.rewritten == 1, "file publication must succeed");
let published_text = fs_read(path_join(temp, "pblang.lock"));
require(str_contains(published_text, "path = \"stdlib\""), "published file must contain the relative path");
fs_remove(path_join(temp, "pblang.lock"));
fs_remove(path_join(temp, "pblang.toml"));
fs_remove(path_join(temp, "stdlib"));
fs_remove(temp);

print "portable_lock_pass";
