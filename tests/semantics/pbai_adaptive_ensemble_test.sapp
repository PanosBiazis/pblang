// tests/semantics/pbai_adaptive_ensemble_test.sapp — the ensemble LEARNS who to trust. Feeding
// outcomes via record_outcome() tracks each voter's reliability; with set_adaptive(true) the
// effective vote weight scales by that measured reliability — so a proven-accurate voter beats a
// heavy-but-wrong one, even against a higher static weight. This is calibrated multi-LLM voting.

let pbai = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── reliability tracking: a consistently-correct voter outranks a wrong one ─────────────
pbai.clear_voters();
pbai.reset_stats();
pbai.register_voter("good", fn(x) { return "bugs"; });
pbai.register_voter("bad", fn(x) { return "explain"; });
let i = 0;
while i < 6 {
    pbai.ensemble_detail("x");        // records this round's votes
    pbai.record_outcome("bugs");      // truth = bugs -> good right, bad wrong
    i = i + 1;
}
if pbai.reliability("good") <= pbai.reliability("bad") { fail("good voter must be more reliable"); }
if pbai.reliability("good") < 0.7 { fail("consistently-right voter should be ~1"); }
if pbai.reliability("bad") > 0.3 { fail("consistently-wrong voter should be ~0"); }
// an unseen voter starts neutral (no cold-start bias)
eq(pbai.reliability("never-seen"), 0.5, "unknown voter is neutral 0.5");

// ── adaptive weighting overrides a heavy-but-unreliable voter ───────────────────────────
pbai.clear_voters();
pbai.reset_stats();
pbai.register_voter_weighted("light_right", fn(x) { return "bugs"; }, 1);
pbai.register_voter_weighted("heavy_wrong", fn(x) { return "improve"; }, 5);
// train: truth is always bugs
let j = 0;
while j < 8 {
    pbai.ensemble_detail("x");
    pbai.record_outcome("bugs");
    j = j + 1;
}
// static weighting: the heavy (weight 5) but wrong voter wins
pbai.set_adaptive(false);
eq(pbai.ensemble("x"), "improve", "static weights let the heavy wrong voter win");
// adaptive weighting: reliability re-weights, the light-but-right voter wins
pbai.set_adaptive(true);
eq(pbai.ensemble("x"), "bugs", "adaptive weighting trusts the proven-reliable voter");

pbai.set_adaptive(false);
pbai.clear_voters();
pbai.reset_stats();
print "pbai_adaptive_ensemble_pass";
