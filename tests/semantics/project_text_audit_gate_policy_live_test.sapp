if platform()!="linux" {print "text_gate_live_skip_linux_required";os_exit(0);}
let SECURE=import("stdlib:secure_file.sapp");
// Syscall tracing is opt-in per case; ordinary suites run only three children.
let trace_mode=env_get("PB_TEXT_GATE_TRACE") ?? "";
if trace_mode!="" and trace_mode!="roots" and trace_mode!="modules" and trace_mode!="combine" {throw "invalid text gate trace selection";}
if trace_mode!="" and (not fs_exists("/usr/bin/strace") or not fs_exists("/usr/bin/prlimit")) {print "text_gate_live_skip_strace_prlimit_required";os_exit(0);}
let compiler=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let root="tests/fixtures/text-gate-live-"+str_slice(sha256(str(now_ms())+str(random_bytes(8))),0,16);
let source="let T=import(\"stdlib:project_text_audit.sapp\");\nlet args=os_args();let mode=args[len(args)-1];\nif mode==\"control\" {fs_read(\"tests/fixtures/module_audit/tools/todo.sapp\");print \"trace_control\";os_exit(0);}\nlet o=map{max_high:\"private-policy-marker\"};\nif mode==\"combine\" {T.combine_module_reports(\"fixture\",[map{format:\"pblang.module_audit.module.v1\",root:\"fixture\",counts_kind:42}],o);}\nelse if mode==\"modules\" {T.audit_modules(\"fixture\",[\"tests/fixtures/module_audit/tools\"],o);}\nelse {T.audit_roots(\"fixture\",[\"tests/fixtures/module_audit/tools\"],o);}\n";
let failure="unexpected exception";
fn expect(ok,label){if not ok {failure=label;throw "FAIL text-gate-live: "+label;}}
fn traced(mode,log) {
    let target=path_join(cwd(),"tests/fixtures/module_audit/tools");
    return proc_spawn_wait("/usr/bin/timeout",["-k","1s","20s","/usr/bin/prlimit","--fsize=1048576:1048576","--","/usr/bin/strace","-f","-qq","-yy","-e","trace=%file","-P",target,"-P",target+"/todo.sapp","-o",log,compiler,root+"/main.sapp","--allow-all","--",mode]);
}
fn exercise(){
    fs_mkdirs(root);fs_write(root+"/main.sapp",source);
    if trace_mode!="" {
        let control=traced("control",root+"/control.log");
        expect(control.exit_code==0 and control.stdout=="trace_control\n","trace positive control completed");
        let trace=SECURE.read_text(root+"/control.log",1048576,false);
        expect(trace.ok and str_contains(trace.text,"module_audit/tools/todo.sapp"),"trace filter detects a known file access");
    }
    for mode in ["roots","modules","combine"] {
        let log=root+"/"+mode+".log";
        let r=nil;
        if trace_mode==mode {r=traced(mode,log);}
        else {r=proc_spawn_wait("/usr/bin/timeout",["-k","1s","5s",compiler,root+"/main.sapp","--allow-all","--",mode]);}
        expect(r.exit_code==1 and r.stdout=="" and str_contains(r.stderr,"]: project audit gate numeric limits must be finite integers in 0..9007199254740991\n"),"fixed admission error precedes work; exit="+str(r.exit_code));
        expect(not str_contains(r.stderr,"private-policy-marker"),"no supplied value echo");
        if trace_mode==mode {
            let trace=SECURE.read_text(log,1048576,false);
            expect(trace.ok,"bounded trace read succeeded");
            expect(not str_contains(trace.text,"module_audit/tools"),"no file operation on audited root");
        }
    }
    return true;
}
let ok=try exercise() catch false;
for name in ["roots.log","modules.log","combine.log","control.log","main.sapp"] {if fs_exists(root+"/"+name){fs_remove(root+"/"+name);}}
if fs_exists(root){fs_remove(root);}
if not ok {throw "FAIL text-gate-live: "+failure;}
print "project_text_audit_gate_policy_live_pass";
