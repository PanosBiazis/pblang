// C1: optimizations preserve control flow, value types and overloaded effects.
let F = import("stdlib/compiler/selfhost_frontend.sapp");
let V = import("stdlib/compiler/vm.sapp");
let O = import("stdlib/compiler/optimizer.sapp");
fn demand(ok, message) { if not ok { throw "FAIL optimizer-strength: " + message; } }
fn outcome(chunk) { return V.run_bounded(chunk, map{ max_steps: 10000 }); }
fn compare(source, expected, output) {
    let compiled = F.frontend_compile(source);
    demand(compiled.ok, "fixture must compile");
    let original = str(compiled.chunk);
    let chunks = [compiled.chunk, O.optimize_safe(compiled.chunk).chunk, O.optimize(compiled.chunk).chunk];
    demand(str(compiled.chunk) == original, "optimization mutated input");
    let i = 0;
    while i < len(chunks) {
        let result = outcome(chunks[i]);
        demand(type(result.globals.y) == type(expected) and result.globals.y == expected, "value/type lane " + str(i));
        demand(len(result.output) == len(output), "output count");
        let j = 0;
        while j < len(output) {
            demand(type(result.output[j]) == type(output[j]) and result.output[j] == output[j], "output value/type");
            j = j + 1;
        }
        i = i + 1;
    }
}
compare("let x = 1; let y = 0; if false { x = x + 0; } y = 7;", 7, []);
compare("let x = 1; let y = 0; if true { x = x - 0; } y = 8;", 8, []);
compare("let x = 1; let y = 0; while y < 3 { x = x + 0; y = y + 1; } y = y + 4;", 7, []);
compare("let x = map{__mul__: fn(self, n) { print 23; return 42; }}; let y = x * 0;", 42, [23]);
compare("let x = map{__add__: fn(self, n) { print 24; return 43; }}; let y = x + 0;", 43, [24]);
compare("let x = map{__sub__: fn(self, n) { print 25; return 44; }}; let y = x - 0;", 44, [25]);
compare("let y = \"THREW\";", "THREW", []);

fn inst(op, operand) { return map{op: op, operand: operand}; }
// Jump-to-end must be remapped when the literal triple becomes one instruction.
let literal = map{constants: [3, 0], instructions: [inst(0, 0), inst(0, 1), inst(1, 0), inst(20, 4)]};
demand(O.strength_reduction_pass(literal) == 1, "literal reduction missing");
demand(len(literal.instructions) == 2 and literal.instructions[1].operand == 2, "jump remap");
demand(literal.constants[literal.instructions[0].operand] == 3, "literal result");
// An incoming edge into the middle of a triple invalidates straight-line folding.
let split = map{constants: [3, 0], instructions: [inst(20, 2), inst(0, 0), inst(0, 1), inst(3, 0)]};
let before = str(split);
demand(O.strength_reduction_pass(split) == 0 and str(split) == before, "fold crossed jump target");
let text = map{constants: ["text", 0], instructions: [inst(0, 0), inst(0, 1), inst(1, 0)]};
before = str(text);
demand(O.strength_reduction_pass(text) == 0 and str(text) == before, "non-numeric fold");
print "selfhost_optimizer_strength_pass";
