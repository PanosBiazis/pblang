// tests/semantics/img_load_enrich2_test.sapp — wave 2 for stdlib/img_load.sapp
// Magic-byte format detection + aspect ratio.

let L = import("stdlib/img_load.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let png = [137, 80, 78, 71, 13, 10, 26, 10];
let jpeg = [255, 216, 255, 224];
let gif = [71, 73, 70, 56, 57, 97];
let bmp = [66, 77, 0, 0];
let ppm = [80, 54, 10];   // "P6\n"

if not L.is_png(png) { fail("png magic"); }
if L.is_png(jpeg) { fail("jpeg is not png"); }
if not L.is_jpeg(jpeg) { fail("jpeg magic"); }

eq(L.format_of(png), "png", "format png");
eq(L.format_of(jpeg), "jpeg", "format jpeg");
eq(L.format_of(gif), "gif", "format gif");
eq(L.format_of(bmp), "bmp", "format bmp");
eq(L.format_of(ppm), "ppm", "format ppm");
eq(L.format_of([0, 1, 2, 3]), "unknown", "format unknown");

// aspect_ratio of a 4-wide, 2-tall image grid = 2.0
let img = [[0,0,0,0], [0,0,0,0]];
eq(L.aspect_ratio(img), 2, "aspect 4x2");
eq(L.aspect_ratio([]), 0, "aspect empty -> 0");

print "img_load_enrich2_pass";
