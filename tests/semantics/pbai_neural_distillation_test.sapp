let AI=import("stdlib/pbai.sapp");
fn rejects(f) {return try {f();false} catch true;}
assert(not rejects(fn(){return 1;}) and rejects(fn(){throw "expected rejection";}),"rejection helper distinguishes success from failure");
let teacher=AI.neural_specialist_train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let contexts=[[0],[1,0]];let validation=[map{x:[7,0],y:4}];let test=[map{x:[6,0],y:4}];
let saved=json_stringify([teacher.artifact,contexts,validation]);
let student=AI.neural_specialist_distill(teacher.artifact,contexts,validation);
assert(saved==json_stringify([teacher.artifact,contexts,validation]),"distillation inputs unchanged");
assert(student.report.student_trainable_parameters==16 and student.report.teacher_trainable_parameters==32,"half the adapter parameters");
assert(student.report.steps==128 and not student.report.accepted_for_merge and not student.report.persists_weights,"bounded real in-memory training");
let metrics=student.evaluate(test);
assert(metrics.student.loss<metrics.initial_student.loss and metrics.teacher_student_kl<metrics.initial_teacher_student_kl,"held-out loss and teacher divergence improve");
assert(student.predict([6,0]).token==4 and metrics.student.correct==1,"student inference uses learned weights");
assert(not metrics.teacher_training_overlap_checked and not metrics.independent_provenance_verified,"honest evaluation scope");
assert(json_stringify(student.report)==json_stringify(AI.neural_specialist_distill(teacher.artifact,contexts,validation).report),"deterministic distillation");
assert(rejects(fn(){student.evaluate(validation);}) and rejects(fn(){student.evaluate([map{x:[0],y:4}]);}),"test disjoint from student train and validation");
assert(rejects(fn(){AI.neural_specialist_distill(teacher.artifact,[[0],[0]],validation);}),"duplicate contexts");
assert(rejects(fn(){AI.neural_specialist_distill(teacher.artifact,[[7,0]],validation);}),"validation leakage");
let zero=len([]);
for contexts_bad in [nil,[],[[8]],[[true]],[[0/zero]],[[1/zero]],[[0,0,0,0,0]]] {
 assert(rejects(fn(){AI.neural_specialist_distill(teacher.artifact,contexts_bad,validation);}),"malformed contexts");
}
let many=[];for i 33 {push(many,[i%8]);}
assert(rejects(fn(){AI.neural_specialist_distill(teacher.artifact,many,validation);}),"context count bound");
for opts in [map{},map{epochs:0,lr:0.1,temperature:2},map{epochs:129,lr:0.1,temperature:2},
 map{epochs:1,lr:0.3,temperature:2},map{epochs:1,lr:0.1,temperature:0},map{epochs:1,lr:0.1,temperature:9},
 map{epochs:0/zero,lr:0.1,temperature:2},map{epochs:1,lr:1/zero,temperature:2}] {
 assert(rejects(fn(){AI.neural_specialist_distill(teacher.artifact,contexts,validation,opts);}),"training options bounded");
}
let before=json_stringify(student.predict([6,0]));
contexts[0][0]=7;validation[0].x[0]=6;teacher.artifact.a[0][0]=0;student.report.steps=0;
let prediction=student.predict([6,0]);prediction.logits[0]=999;metrics.student.loss=-1;
assert(before==json_stringify(student.predict([6,0])) and student.evaluate(test).student.loss>=0,"caller mutations cannot alter trained handle");
assert(rejects(fn(){student.predict([8]);}) and rejects(fn(){student.evaluate([]);}),"prediction and evaluation input contract");
assert(rejects(fn(){AI.neural_specialist_distill(map{},[[0]],[map{x:[1],y:4}]);}),"malformed teacher");
print "pbai_neural_distillation_pass";

let signed_zero=0/(0-1);
assert(rejects(fn(){student.evaluate([map{x:[signed_zero],y:4}]);})
 and rejects(fn(){student.evaluate([map{x:[7,signed_zero],y:4}]);}),"signed-zero distillation holdout identity");

// Perfect imitation can still be a wrong answer against the supplied label.
let wrong_label=student.evaluate([map{x:[6,0],y:3}]);
assert(wrong_label.teacher_agreement==1 and wrong_label.teacher.correct==0 and wrong_label.student.correct==0,"agreement does not establish correctness");
assert(wrong_label.teacher_and_student_wrong==1 and wrong_label.teacher_wrong_student_correct==0,"joint teacher/student errors remain visible");
let sums=student.evaluate([map{x:[6,0],y:4},map{x:[5,0],y:3}]);
assert(sums.student.correct==sums.teacher.correct-sums.teacher_correct_student_wrong+sums.teacher_wrong_student_correct,"paired outcome counts reconcile exact accuracy");
assert(sums.teacher_and_student_wrong+sums.teacher.correct+sums.teacher_wrong_student_correct==sums.examples,"paired outcomes cover every example");
let wide=map{};for i 1025 {wide["field-"+str(i)]=i;}
assert(rejects(fn(){AI.neural_specialist_distill(wide,[[0]],[map{x:[1],y:4}]);}),"wide teacher rejected before serialization");
let cyclic=[];push(cyclic,cyclic);
assert(rejects(fn(){AI.neural_specialist_distill(AI.neural_specialist_train([map{x:[0],y:4}],[map{x:[7,0],y:4}],map{epochs:1,lr:0.1}).artifact,[cyclic],[map{x:[1],y:4}]);}),"cyclic context fails scalar shape");

let original_token=AI.neural_specialist_run(teacher.initial_artifact,[6,0]).token;
let forgotten=student.evaluate([map{x:[6,0],y:original_token}]);
assert(forgotten.initial_student.correct==1 and forgotten.initial_student_correct_regressions==1,"student baseline regressions counted independently of teacher agreement");
let fresh_teacher=AI.neural_specialist_train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let weak=AI.neural_specialist_distill(fresh_teacher.artifact,[[0]],[map{x:[7,0],y:4}],map{epochs:1,lr:0.000001,temperature:2});
let weak_label=weak.predict([6,0]).token;
let correction=weak.evaluate([map{x:[6,0],y:weak_label}]);
assert(correction.teacher.correct==0 and correction.student.correct==1 and correction.teacher_wrong_student_correct==1,"student corrections distinguished from imitation");
