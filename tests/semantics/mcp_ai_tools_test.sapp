// tests/semantics/mcp_ai_tools_test.sapp — pb_mcp "ai" profile tools (cycle-free:
// they use stdlib/sampling_tune + stdlib/text_normalize directly, not pbai).

let M = import("stdlib/pb_mcp.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }

// both tools are advertised in the catalog under the "ai" profile
truthy(M.has_tool("pbai_recommend_sampling"), "catalog has pbai_recommend_sampling");
truthy(M.has_tool("pbai_normalize_reply"), "catalog has pbai_normalize_reply");

// executable via call(): sampling recommendation for a coding prompt
let rs = M.call("pbai_recommend_sampling", map{ prompt: "write a python function to sort a list" });
eq(rs.context, "code", "sampling tool classifies code");
truthy(map_has(rs.params, "temperature"), "sampling tool returns params");

// executable via call(): reply normalization
eq(M.call("pbai_normalize_reply", map{ text: "Sure! I think it is 42. I hope this helps!" }), "it is 42.", "normalize tool strips filler");

// executable via call(): adversarial input obfuscation detection
truthy(M.has_tool("pbai_detect_obfuscation"), "catalog has pbai_detect_obfuscation");
let det = M.call("pbai_detect_obfuscation", map{ text: "h4ck3r" });
truthy(det.score > 0.0, "obfuscation tool flags leetspeak");
eq(det.canonical, "hacker", "obfuscation tool returns canonical form");

// discoverable via suggest_tool
let sug = M.suggest_tool("sampling temperature for a prompt", 5);
truthy(len(sug) > 0, "suggest_tool returns candidates");

print "mcp_ai_tools_pass";
