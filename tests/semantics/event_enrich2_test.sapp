// tests/semantics/event_enrich2_test.sapp — wave 2 for stdlib/event.sapp
// listeners (getter) + forward (re-emit to another bus).

let E = import("stdlib/event.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── listeners getter ────────────────────────────────────────────────────────────────
let bus = E.new();
eq(len(E.listeners(bus, "x")), 0, "no listeners yet");
E.on(bus, "x", fn(d) { });
E.on(bus, "x", fn(d) { });
eq(len(E.listeners(bus, "x")), 2, "two listeners");
eq(len(E.listeners(bus, "missing")), 0, "unknown event -> empty");

// ── forward: re-emit an event onto another bus ────────────────────────────────────
let src = E.new();
let dst = E.new();
let received = [];
E.on(dst, "ping", fn(d) { array_push(received, d); });
E.forward(src, "ping", dst);
E.emit(src, "ping", 42);
eq(len(received), 1, "forwarded once");
eq(received[0], 42, "forwarded payload");
// emitting an un-forwarded event does nothing on dst
E.emit(src, "other", 99);
eq(len(received), 1, "only forwarded events propagate");

print "event_enrich2_pass";
