let S=import("stdlib:slide_document.sapp"); let V=import("stdlib:slide_view.sapp"); let Study=import("stdlib:study_cards.sapp"); let Cards=import("stdlib:study_view.sapp");
let UI=import("stdlib:modern_ui.sapp"); let W=import("stdlib:modern_ui_web.sapp"); let A=import("stdlib:modern_ui_android.sapp"); let G=import("stdlib:gui.sapp");
let deck=S.create(); for i in range(1,8) {deck=S.insert(deck,i);}
let pairs=[];for i in range(0,8) {array_push(pairs,map{prompt:"Question "+str(i+1),answer:"Answer "+str(i+1)});}
let cards=Cards.reader(Study.create("All cards",pairs,"2026-09-27"),"2026-09-27");
for view in [V.create(deck),cards] {
 let web=W.generate("Full reader",UI.compile(view,map{target:"web",width:412,height:915}));
 let android=A.generate("Full reader",UI.compile(view,map{target:"android",width:412,height:915}));
 assert(web.actions>0 and android.actions>0,"full-bound reader generates executable portable actions");
}
let form=UI.build("Cards",cards,map{width:1100,height:1000});
for w in form.widgets {assert(w.x+w.w<=form.w and w.y+w.h<=form.h,"all eight question/answer choices fit native reader");}
G.get(form,"show_answer_8").onclick(form);assert(G.get(form,"reader_question").value=="Question 8" and G.get(form,"reader_answer").value=="Answer 8","eighth answer reachable");
G.get(form,"question_1").onclick(form);assert(G.get(form,"reader_answer").value=="Answer hidden.","question resets revealed answer");
print "portable_lesson_views_pass";
