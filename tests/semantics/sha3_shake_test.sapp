let SHA3 = import("stdlib:sha3.sapp");

if SHA3.shake256_hex([], 64) !=
   "46b9dd2b0ba88d13233b3feb743eeb24" +
   "3fcd52ea62b81b82b50c27646ed5762f" +
   "d75dc4ddd8c0f200cb05019d67b592f6" +
   "fc821c49479ab48640292eacb3b7c4be" {
    throw "FAIL SHAKE256 empty FIPS 202 vector";
}

if len(SHA3.shake256_bytes(str_to_bytes("abc"), 272)) != 272 {
    throw "FAIL SHAKE256 multi-block output length";
}

let rejected = false;
try { SHA3.shake256_bytes([], 16777217); } catch { rejected = true; }
if not rejected { throw "FAIL SHAKE256 oversized output accepted"; }

print "sha3_shake_pass";
