let A = import("stdlib:project_audit.sapp");
let L = map{numeric_error:A.pbaudit_numeric_error};
fn expect(ok,label) { if not ok { throw "FAIL pbaudit-limits: " + label; } }
let fields = [["max-depth",0,32,32],["max-entries",1,50000,50000],
    ["max-children",1,4096,4096],["max-files",1,10000,100000],
    ["max-file-bytes",1000,1048576,16777216],["max-runtime-ms",10,300000,300000],
    ["backlog-limit",1,9007199254740991,9007199254740991],
    ["lines",1,9007199254740991,9007199254740991]];
let invalid = [nil,true,false,"private-number-marker",[],map{},fn(){return 1;},
    bigint(1),rational("1/1"),decimal("1"),parse_number("NaN"),
    parse_number("inf"),parse_number("-inf"),1.5];
for field in fields {
    for mode in [false,true] {
        let maximum = if mode {field[3]} else {field[2]};
        let message = field[0]+" must be a finite integer in "+str(field[1])+".."+str(maximum);
        for value in invalid {
            expect(L.numeric_error(field[0],value,mode)==message,"fixed malformed diagnostic");
        }
        for value in [field[1]-1,maximum+1] {
            expect(L.numeric_error(field[0],value,mode)==message,"out-of-range rejection");
        }
        for value in [field[1],maximum] {
            expect(L.numeric_error(field[0],value,mode)=="","inclusive boundaries");
        }
    }
}
for name in [nil,[],map{},true,"private-name-marker","MAX-FILES","max-findings"] {
    expect(L.numeric_error(name,1)=="invalid numeric option","unknown name is not echoed");
}
for mode in [nil,1,"true",[],map{}] {
    expect(L.numeric_error("max-files",1,mode)=="invalid numeric option","exact boolean mode");
}
expect(L.numeric_error("max-files",10001)!="","default is ordinary mode");
expect(L.numeric_error("max-files",10001,true)=="","module mode keeps larger files bound");
expect(L.numeric_error("max-file-bytes",1048577,true)=="","module mode keeps larger bytes bound");
print "pbaudit_limits_pass";
