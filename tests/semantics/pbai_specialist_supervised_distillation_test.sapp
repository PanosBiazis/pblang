let AI=import("stdlib/pbai.sapp");
fn rejects(f) {return try {f();false} catch true;}
assert(not rejects(fn(){return 1;}) and rejects(fn(){throw "expected";}),"calibrated rejection helper");
let teacher=AI.neural_specialist_train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let training=[map{x:[0],y:5},map{x:[1,0],y:5}];let valid=[map{x:[7,0],y:5}];
let test=[map{x:[6,0],y:5}];let saved=json_stringify([teacher,training,valid]);
let hard=map{epochs:64,lr:0.1,temperature:2,hard_weight:1,max_grad_norm:1};
let student=AI.neural_specialist_distill_supervised(teacher.artifact,training,valid,hard);
let evaluated=student.evaluate(test);
assert(evaluated.teacher.correct==0 and evaluated.student.correct==1 and evaluated.teacher_wrong_student_correct==1,"explicit labels correct an incorrect teacher prediction");
assert(student.predict([6,0]).token==5 and student.report.steps==128,"real bounded training");
assert(not student.report.training_labels_authenticated and not student.report.persists_weights and not student.report.authorizes_activation,"caller labels and weights do not grant authority");
assert(saved==json_stringify([teacher,training,valid]),"inputs unchanged");
let changed_validation=[map{x:[7,0],y:2}];
let alternate=AI.neural_specialist_distill_supervised(teacher.artifact,training,changed_validation,hard);
assert(alternate.report.student_digest==student.report.student_digest,"validation labels never influence training");
let changed_training=[map{x:[0],y:4},map{x:[1,0],y:4}];
let learned=AI.neural_specialist_distill_supervised(teacher.artifact,changed_training,valid,hard);
assert(learned.predict([6,0]).token==4 and learned.report.student_digest!=student.report.student_digest,"training labels actually influence private weights");
let soft=map{epochs:4,lr:0.1,temperature:2,hard_weight:0,max_grad_norm:1000};
let without_labels=AI.neural_specialist_distill(teacher.artifact,[[0],[1,0]],valid,map{epochs:4,lr:0.1,temperature:2});
let with_labels=AI.neural_specialist_distill_supervised(teacher.artifact,training,valid,soft);
assert(without_labels.report.student_digest==with_labels.report.student_digest,"weight zero and nonbinding clipping preserve original soft weights exactly");
assert(with_labels.report.online_combined_loss==with_labels.report.online_soft_loss,"soft endpoint report");
assert(student.report.online_combined_loss==student.report.online_hard_loss,"hard endpoint report");
let mixed=AI.neural_specialist_distill_supervised(teacher.artifact,training,valid);
let error=mixed.report.online_combined_loss-0.5*(mixed.report.online_soft_loss+mixed.report.online_hard_loss);
assert(error*error<0.000000000001 and mixed.report.hard_weight==0.5,"mixed objective correctly reported");
assert(json_stringify(mixed.report)==json_stringify(AI.neural_specialist_distill_supervised(teacher.artifact,training,valid).report),"repeatable defaults");
for bad in [nil,[],[map{x:[0],y:8}],[map{x:[0],y:4,extra:1}],[map{x:[0],y:4},map{x:[0/(0-1)],y:5}]] {
 assert(rejects(fn(){AI.neural_specialist_distill_supervised(teacher.artifact,bad,valid);}),"strict training and duplicate normalization");
}
let many=[];for i 33 {push(many,map{x:[i%8],y:4});}
assert(rejects(fn(){AI.neural_specialist_distill_supervised(teacher.artifact,many,valid);}),"bounded training count");
let cycle=[];push(cycle,cycle);
assert(rejects(fn(){AI.neural_specialist_distill_supervised(teacher.artifact,[map{x:cycle,y:4}],valid);}),"cyclic scalar shape rejected");
let zero=len([]);
for key in ["hard_weight","max_grad_norm","epochs","lr","temperature"] {
 for value in [nil,true,"1",-1,0/zero,1/zero] {
  let opts=json_parse(json_stringify(hard));opts[key]=value;
  assert(rejects(fn(){AI.neural_specialist_distill_supervised(teacher.artifact,training,valid,opts);}),"invalid scalar option");
 }
}
for opts in [map{},map{epochs:64,lr:0.1,temperature:2},map{epochs:1,lr:0.1,temperature:2,hard_weight:1.1,max_grad_norm:1},
 map{epochs:1,lr:0.1,temperature:2,hard_weight:0.5,max_grad_norm:1001}] {
 assert(rejects(fn(){AI.neural_specialist_distill_supervised(teacher.artifact,training,valid,opts);}),"exact options and upper bounds");
}
assert(rejects(fn(){AI.neural_specialist_distill_supervised(map{},training,valid,hard);}),"invalid teacher");
assert(rejects(fn(){AI.neural_specialist_distill_supervised(teacher.artifact,training,training,hard);}),"validation overlap rejected");
assert(rejects(fn(){student.evaluate(training);}) and rejects(fn(){student.evaluate(valid);}),"test overlap rejected");
assert(rejects(fn(){student.evaluate([map{x:[0/(0-1)],y:5}]);}),"signed-zero heldout identity");
let before=json_stringify(student.predict([6,0]));
training[0].x[0]=7;training[0].y=0;valid[0].y=0;hard.hard_weight=0;teacher.artifact.a[0][0]=0;
student.report.student_digest="modified";student.report.validation.student.loss=-1;
let prediction=student.predict([6,0]);prediction.logits[0]=999;evaluated.student.loss=-1;
assert(before==json_stringify(student.predict([6,0])) and student.evaluate(test).student.loss>=0,"caller mutation cannot change trained private weights");
assert(not map_has(student,"promote") and not map_has(student,"save"),"diagnostic handle cannot activate or persist");
print "pbai_specialist_supervised_distillation_pass";
