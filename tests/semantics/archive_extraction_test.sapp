let A=import("stdlib:secure_archive.sapp");
let P=import("stdlib:archive_publication.sapp");
let OS=import("stdlib:os.sapp");
let root=OS.script_args()[0];
let files=[map{name:"folder/",data:[]},map{name:"folder/binary.bin",data:[0,128,255]},map{name:"empty",data:[]},map{name:"last",data:[7]}];
for mode in ["store","fast","auto"] {
 let bytes=A.pack(files,mode);let path=root+"/"+mode+".bin";
 let member=A.read_member(bytes,"folder/binary.bin");
 assert(member.data==[0,128,255] and member.verified and not member.truncated and not member.directory,"complete verified member");
 let saved=P.extract_member(path,bytes,"folder/binary.bin");
 assert(saved.ok and saved.format=="pblang.archive-extraction.v1" and saved.written and saved.durability_verified and saved.wrapper_handles_closed,"extracted complete new file");
 assert(fs_read_bytes(path)==[0,128,255],"exact bytes, no embedded directory creation");
 let again=P.extract_member(path,bytes,"folder/binary.bin");
 assert(not again.ok and again.output_may_exist and not again.publication_confirmed and not map_has(again,"written"),"no replacement");
 for name in ["missing","../last","FOLDER/binary.bin",nil] {
  let r=P.extract_member(root+"/rejected",bytes,name);
  assert(r.code=="invalid_selection" and not r.publication_attempted,"invalid selector never writes");
 }
 for name in ["empty","folder/"] {
  let r=P.extract_member(root+"/rejected",bytes,name);
  assert(r.code=="unsupported_member" and not r.publication_attempted,"empty and directory explicitly unsupported");
 }
 for options in [map{unknown:true},map{max_total_bytes:3},map{max_file_bytes:2},map{max_entries:3}] {
  let r=P.extract_member(root+"/rejected",bytes,"folder/binary.bin",options);
  assert(r.code=="invalid_selection" and not r.publication_attempted,"all limits before effects");
 }
 if str_contains(json_stringify(saved),root) or str_contains(json_stringify(saved),"folder/binary.bin") {throw "private output exposed";}
}
let good=A.pack(files,"store");
for path in [nil,"",root+"/",root+"/a\\b",root+"/nul"+strfromcharcode(0)] {
 assert(P.extract_member(path,good,"last").code=="invalid_output","invalid output");
}
assert(not fs_exists(root+"/rejected") and not fs_exists(root+"/folder"),"no implicit extracted tree");
assert(A.view(good,"folder/binary.bin",2).truncated,"preview keeps its cap");
print "archive_extraction_pass";
