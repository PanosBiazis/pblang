// Test: event.sapp module
import "stdlib:event.sapp";

let bus = event.new();

// on + emit
let received = [];
event.on(bus, "data", fn(d) {
    array_push(received, d);
});
event.emit(bus, "data", "hello");
event.emit(bus, "data", "world");
if len(received) != 2 { print "FAIL on+emit count"; }
if received[0] != "hello" { print "FAIL emit value 0"; }
if received[1] != "world" { print "FAIL emit value 1"; }

// listener_count
if event.listener_count(bus, "data") != 1 { print "FAIL listener_count"; }
if event.listener_count(bus, "missing") != 0 { print "FAIL listener_count missing"; }

// off
event.off(bus, "data");
if event.listener_count(bus, "data") != 0 { print "FAIL off"; }
event.emit(bus, "data", "after_off");
if len(received) != 2 { print "FAIL emit after off"; }

// event_names
event.on(bus, "click", fn(d) {});
event.on(bus, "hover", fn(d) {});
let names = event.event_names(bus);
if len(names) < 2 { print "FAIL event_names count"; }

// once
let once_count = 0;
event.once(bus, "tick", fn(d) {
    once_count = once_count + 1;
});
event.emit(bus, "tick", nil);
event.emit(bus, "tick", nil);
event.emit(bus, "tick", nil);
// once should only fire once (count stays 1)
if once_count != 1 { print "FAIL once fires " + str(once_count) + " times (expected 1)"; }

print "event_stdlib_pass";
