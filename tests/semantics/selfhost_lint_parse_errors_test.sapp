let FE=import("stdlib:compiler/selfhost_frontend.sapp");

fn assert_rejected(source,code) {
    let report=FE.frontend_lint(source);
    assert(not report.ok and report.count>0,"invalid source cannot lint clean");
    assert(report.count==len(report.diagnostics) and len(map_keys(report))==3,
        "existing result shape stays consistent");
    for diagnostic in report.diagnostics {
        assert(diagnostic.kind=="error" and diagnostic.code==code,
            "syntax/input errors are not unrelated semantic warnings");
        assert(type(diagnostic.message)=="string" and diagnostic.message!="",
            "diagnostics have useful text");
    }
}

for source in ["let value = ;", "fn bad( {", "fn bad() { print missing;",
    "let text=\"unfinished", "/* unfinished", "let x=1; /* unfinished"] {
    assert_rejected(source,"parse-error");
}
for value in [nil,42,false,[],map{}] { assert_rejected(value,"invalid-source"); }
let valid_index=0;
for source in ["", " \n\t", "// only a comment\n", "/* complete comment */",
    "let n=3; print n;", "throw \"must not execute\";"] {
    let report=FE.frontend_lint(source);
    assert(report.ok and report.count==0 and len(report.diagnostics)==0,
        "valid/empty editor buffer case "+str(valid_index)+": "+json_stringify(report));
    valid_index=valid_index+1;
}
let unknown=FE.frontend_lint("print missing_name;");
assert(not unknown.ok and unknown.diagnostics[0].code=="undefined-name",
    "well-parsed source still receives semantic diagnostics");
let after=FE.frontend_lint("let valid=1; print valid;");
assert(after.ok,"parser failure does not contaminate later calls");
print "selfhost_lint_parse_errors_pass";
