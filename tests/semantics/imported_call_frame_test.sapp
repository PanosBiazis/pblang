let Calls = import("./fixtures/imported_call_frame.sapp");

fn fail(message) { throw "FAIL imported_call_frame: " + message; }

if Calls.fourth(1, 2, 3, 4) != 4 { fail("fourth positional argument"); }
if Calls.fifth(1, 2, 3, 4, 5) != 5 { fail("fifth positional argument"); }
if Calls.packed(map{ bias: 6 }, [1, 2, 3, 4, 5]) != 15 {
    fail("packed compatibility frame");
}

print "imported_call_frame_pass";
