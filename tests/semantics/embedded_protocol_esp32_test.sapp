let Wire=import("stdlib:embedded_protocol_esp32.sapp");
let ESP=import("stdlib:codegen_esp32_embedded.sapp");

let artifact=Wire.compile();let parsed=ESP.parse_image(artifact.image);
assert(artifact.ok and artifact.board=="esp32-devkitc-v4"
       and artifact.protocol=="pblang.embedded-wire.v1"
       and artifact.persistent_command_loop and artifact.ram_loadable
       and artifact.flash_bootable and artifact.persistent_flash_ready,
       "ESP32 controller publishes the shared persistent protocol contract");
assert(parsed.ok and parsed.load_address==Wire.IRAM_ADDRESS
       and parsed.entry_address==Wire.ENTRY_ADDRESS and parsed.segment==artifact.binary,
       "ESP32 controller image roundtrips with exact entry and segment");
assert(artifact.image_bytes<=Wire.MAX_IMAGE_BYTES and artifact.bytes%4==0
       and not artifact.c_fallback and not artifact.assembler_dependency
       and artifact.native_source_language=="pblang",
    "controller stays within its protected boot region and has no source fallback");
assert(artifact.loopback.output=="GPIO25" and artifact.loopback.input=="GPIO33"
       and artifact.loopback.expected_result_bits==3,
       "ESP32 image publishes the physical digital loopback contract");
assert(artifact.adc.pin=="GPIO34" and artifact.adc.unit==1 and artifact.adc.channel==6
       and artifact.adc.bits==12 and artifact.adc.maximum==4095
       and artifact.adc.data_inverted and artifact.adc.rtc_analog_mux
       and artifact.adc.adjacent_pad_preserved and artifact.adc.sar_clock_div==1
       and artifact.adc.hall_disabled and artifact.adc.amp_disabled,
       "ESP32 image publishes the hardware-corrected RTC ADC1 channel 6 contract");
assert(artifact.analog_follow.enabled_at_boot and artifact.analog_follow.input=="GPIO34"
       and artifact.analog_follow.output=="GPIO25"
       and artifact.analog_follow.method=="dac1-8bit"
       and artifact.analog_follow.adc_dac_sync_disabled
       and artifact.analog_follow.cw_generator_disabled,
       "ESP32 image publishes low-overhead ADC1 to DAC1 following");
assert(Wire.RTC_IO_ADC34_CONFIG==0x20000000
       and Wire.RTC_IO_ADC34_CLEAR_MASK==0x707fffff
       and Wire.SENS_SAR_READ_CTRL_CONFIG==0x10070901
       and Wire.SENS_SAR_AMP_WAIT_CONFIG==0x00010001
       and Wire.SENS_SAR_MEAS_WAIT2_AMP_CLEAR_MASK==0xfffc0000
       and Wire.SENS_SAR_MEAS_WAIT2_AMP_DISABLED==0x00020001
       and Wire.SENS_SAR_MEAS_CTRL_AMP_CLEAR_MASK==0xffff000f,
       "ESP32 ADC setup matches the bounded classic ESP-IDF register contract");
assert(Wire.RTC_IO_DAC1_CLEAR_MASK==0xc00001ff
       and Wire.RTC_IO_DAC1_ANALOG_CONFIG==0x00060400
       and Wire.RTC_IO_DAC1_DIGITAL_CONFIG==0
       and Wire.RTC_IO_DAC1_DATA_CLEAR_MASK==0xf807ffff
       and Wire.SENS_DAC_CW_EN1_CLEAR_MASK==0xfeffffff
       and Wire.SENS_SAR1_DAC_SYNC_CLEAR_MASK==0xfffffffe,
       "ESP32 DAC setup retains unrelated register fields and disables competing sources");
assert(artifact.button.pin=="GPIO27" and artifact.button.input_mask==0x08000000
       and artifact.button.read_strategy=="rtc-digital-mux+gpio-in-mask"
       and artifact.button.rtc_digital_mux
       and artifact.button.rtc_mux_operation=="clear-bit-19"
       and artifact.button.debounce_ticks==12
       and artifact.button.release_debounce_ticks==12
       and artifact.button.symmetric_debounce
       and artifact.button.self_test=="input-only-output-disable-verification"
       and not artifact.button.self_test_drives_pin,
       "ESP32 image publishes its mask-based active-high debounced button contract");

print "embedded_protocol_esp32_pass";
