// tests/semantics/codegen_cond_test.sapp — conditionals in the IR (ifnz). Run-verified on
// x86-64 and i386 (exit code), evaluated portably, lowered to C, and arm64 encoding-checked.

let X64 = import("stdlib/codegen_x64.sapp");
let X86 = import("stdlib/codegen_x86.sapp");
let A64 = import("stdlib/codegen_arm64.sapp");
let IR = import("stdlib/codegen_ir.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

fn run_rc(elf, tag) {
    let path = "pbcond_" + tag + ".bin";
    fs_write_bytes(path, elf);
    let r = proc_spawn_wait("bash", ["-c", "chmod +x " + path + " && ./" + path + "; rc=$?; rm -f " + path + "; echo RC=$rc"]);
    let out = try r.stdout catch "";
    let idx = str_index_of(out, "RC=");
    if idx < 0 { fail(tag + ": no rc"); }
    return parse_number(str_trim(str_slice(out, idx + 3, len(out))));
}

// if r1 != 0 -> r0=100 else r0=200
fn prog(cond) { return [["seti", 0, 0], ["seti", 1, cond], ["ifnz", 1, [["seti", 0, 100]], [["seti", 0, 200]]]]; }

// ── portable eval ───────────────────────────────────────────────────────────────────
eq(IR.eval(prog(5)), 100, "eval: taken branch");
eq(IR.eval(prog(0)), 200, "eval: else branch");

// ── x86-64 native ─────────────────────────────────────────────────────────────────
eq(run_rc(X64.compile_program(prog(5)), "x64t"), 100, "x64: then branch");
eq(run_rc(X64.compile_program(prog(0)), "x64e"), 200, "x64: else branch");

// ── i386 native ──────────────────────────────────────────────────────────────────
eq(run_rc(X86.compile_program(prog(5)), "x86t"), 100, "i386: then branch");
eq(run_rc(X86.compile_program(prog(0)), "x86e"), 200, "i386: else branch");

// ── arm64 encoding: aligned + valid ELF ────────────────────────────────────────────
let code = A64.compile_ir(prog(5));
if num_mod(len(code), 4) != 0 { fail("arm64 ifnz not 4-byte aligned"); }
let elf = A64.compile_program(prog(0));
if elf[18] != 0xB7 { fail("arm64 ifnz ELF machine"); }

// ── C backend lowers ifnz to if/else ────────────────────────────────────────────────
if str_index_of(IR.emit_c(prog(1)), "if (r1)") < 0 { fail("C lowers ifnz"); }

print "codegen_cond_pass";
