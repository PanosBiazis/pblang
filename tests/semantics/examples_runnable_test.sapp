// tests/semantics/examples_runnable_test.sapp — examples must actually RUN.
//
// Locks three real bugs `pblang check` surfaced in examples/ plus the stdlib
// gap underneath one of them:
//
//   1. os.sapp had no way to get SCRIPT arguments: os_args() returns the raw
//      CLI argv (["run", "x.sapp", "--allow-all", "list"]), so tutorial_cli's
//      `args[0]` was always "run" and no subcommand ever matched.
//      → new os.script_args()/script_args_from(argv).
//   2. tutorial_cli used `catch e { ... }` — pblang catch binds NO name, so the
//      handler body threw "undefined global 'e'" whenever fs_read failed
//      (i.e. on the very first run, before notes.txt exists).
//   3. ai_chat_toolcall called the nonexistent `map.has` and never invoked
//      main() — running the example produced NO output at all.

let os = import("stdlib:os.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }

// ── 1. os.script_args_from (pure argv → script args) ─────────────────────────
eq(os.script_args_from(["run", "m.sapp", "--allow-all", "list"]), ["list"],
   "flags before user args are stripped");
eq(os.script_args_from(["run", "m.sapp", "list", "add note"]), ["list", "add note"],
   "plain user args pass through");
eq(os.script_args_from(["run", "m.sapp"]), [], "no user args -> empty");
eq(os.script_args_from(["run", "m.sapp", "--allow-all", "--", "--weird"]), ["--weird"],
   "-- separator protects dash-leading user args");
eq(os.script_args_from(["repl"]), [], "no script in argv -> empty");
eq(os.script_args_from(["run", "app.pbck", "x"]), ["x"], ".pbck counts as the script");

// ── 2. tutorial_cli end-to-end via subprocess ────────────────────────────────
let PB = "target/release/pblang";
proc_spawn_wait("bash", ["-c", "rm -f notes.txt"]);

// first run with NO notes.txt: `list` must print empty notes, not crash
let r1 = proc_spawn_wait(PB, ["run", "examples/tutorial_cli/main.sapp", "--allow-all", "list"]);
let out1 = str(try r1.stdout catch "") + str(try r1.stderr catch "");
if str_contains(out1, "undefined global") { fail("tutorial_cli catch handler crashed: " + out1); }
if str_contains(out1, "commands:") { fail("tutorial_cli did not route 'list' (script args broken): " + out1); }

// add + list roundtrip
let r2 = proc_spawn_wait(PB, ["run", "examples/tutorial_cli/main.sapp", "--allow-all", "add", "milk"]);
if not str_contains(str(try r2.stdout catch ""), "added") { fail("tutorial_cli add failed: " + str(try r2.stdout catch "") + str(try r2.stderr catch "")); }
let r3 = proc_spawn_wait(PB, ["run", "examples/tutorial_cli/main.sapp", "--allow-all", "list"]);
if not str_contains(str(try r3.stdout catch ""), "milk") { fail("tutorial_cli list lost the note: " + str(try r3.stdout catch "")); }
proc_spawn_wait("bash", ["-c", "rm -f notes.txt"]);

// ── 3. ai_chat_toolcall produces its simulated flow ──────────────────────────
let r4 = proc_spawn_wait(PB, ["run", "examples/ai_chat_toolcall/main.sapp", "--allow-all"]);
let out4 = str(try r4.stdout catch "");
if not str_contains(out4, "Sunny") { fail("ai_chat_toolcall get_weather(Tokyo) path broken (map.has / main() not called): " + out4 + str(try r4.stderr catch "")); }
if not str_contains(out4, "Flow Complete") { fail("ai_chat_toolcall main() did not finish"); }

// ── 4. micro_gui_counter produces a compact GUI render plan without opening a window ─
let r5 = proc_spawn_wait(PB, ["run", "examples/micro_gui_counter/main.sapp", "--allow-all"]);
let out5 = str(try r5.stdout catch "") + str(try r5.stderr catch "");
if not str_contains(out5, "commands=") or not str_contains(out5, "hits=") { fail("micro_gui_counter did not print render-plan counts: " + out5); }
if not str_contains(out5, "route=low-memory-rects") and not str_contains(out5, "route=cpu-framebuffer") { fail("micro_gui_counter did not print device route: " + out5); }
if not str_contains(out5, "name=Ada") or not str_contains(out5, "action=inc") { fail("micro_gui_counter interaction flow broken: " + out5); }

// ── 5. safe_calculator ports the PyCalculator idea without eval or credentials ─
let r6 = proc_spawn_wait(PB, ["run", "examples/safe_calculator/main.sapp", "--allow-all"]);
let out6 = str(try r6.stdout catch "") + str(try r6.stderr catch "");
if not str_contains(out6, "calculator_ui commands=") { fail("safe_calculator did not print its UI plan: " + out6); }
if not str_contains(out6, "(7 + 3) * 2 = 20") { fail("safe_calculator precedence path broken: " + out6); }
if not str_contains(out6, "2 ^ 8 = 256") { fail("safe_calculator power operator broken: " + out6); }
if not str_contains(out6, "10 mod 3 = 1") { fail("safe_calculator modulo path broken: " + out6); }
if not str_contains(out6, "sqrt(16) + fact(5) = 124") { fail("safe_calculator scientific function path broken: " + out6); }
if not str_contains(out6, "8 / 0 -> Error: division by zero") { fail("safe_calculator divide-by-zero guard broken: " + out6); }
if not str_contains(out6, "sqrt(0 - 1) -> Error: sqrt domain error") { fail("safe_calculator domain guard broken: " + out6); }
if not str_contains(out6, "history_count=8") { fail("safe_calculator history count broken: " + out6); }

let r7 = proc_spawn_wait(PB, ["--check", "--via-pblang", "examples/safe_calculator/gui.sapp"]);
let out7 = str(try r7.stdout catch "") + str(try r7.stderr catch "");
if not str_contains(out7, "self-hosted check ok") { fail("safe_calculator GUI syntax check failed: " + out7); }
let calc_gui_src = fs_read("examples/safe_calculator/gui.sapp");
if not str_contains(calc_gui_src, "Theme") or not str_contains(calc_gui_src, "state.theme") { fail("safe_calculator GUI light/dark theme toggle missing"); }
if not str_contains(calc_gui_src, "if len(events) == 0 and not (try state.redraw catch true) { return false; }") { fail("safe_calculator GUI must skip idle redraws"); }
if not str_contains(calc_gui_src, "gfx.run(win, state, update, draw, 30);") { fail("safe_calculator GUI must not run a heavy 60fps loop"); }
if not str_contains(calc_gui_src, "press Esc again to close") { fail("safe_calculator GUI must expose an emergency keyboard close path"); }

// ── 6. PBIDE project examples combine Code, Designer and Browser contexts ───────
let r8 = proc_spawn_wait(PB, ["run", "examples/gui_dashboard/main.sapp", "--allow-all"]);
let out8 = str(try r8.stdout catch "") + str(try r8.stderr catch "");
if not str_contains(out8, "dashboard=PBIDE Dashboard") or not str_contains(out8, "widgets=10") or not str_contains(out8, "route=") { fail("gui_dashboard example did not produce a render plan: " + out8); }

let r9 = proc_spawn_wait(PB, ["run", "examples/gui_dashboard/screens.sapp", "--allow-all"]);
let out9 = str(try r9.stdout catch "") + str(try r9.stderr catch "");
if not str_contains(out9, "screen_count=3") or not str_contains(out9, "Settings -> form_stack") { fail("gui_dashboard screen metadata broken: " + out9); }

let r10 = proc_spawn_wait(PB, ["run", "examples/web_notes_app/main.sapp", "--allow-all"]);
let out10 = str(try r10.stdout catch "") + str(try r10.stderr catch "");
if not str_contains(out10, "notes=3") or not str_contains(out10, "html_chars=") { fail("web_notes_app example did not build preview HTML: " + out10); }

let r11 = proc_spawn_wait(PB, ["run", "examples/fullstack_designer_browser/main.sapp", "--allow-all"]);
let out11 = str(try r11.stdout catch "") + str(try r11.stderr catch "");
if not str_contains(out11, "composite_widgets=5") or not str_contains(out11, "browser_tabs=3") { fail("fullstack_designer_browser example did not report composite context: " + out11); }

print "examples_runnable_pass";
