let ISO = import("stdlib:polyglot_isolate.sapp");

fn require(value, message) { if not value { throw "FAIL " + message; } }

let readiness = ISO.status();
require(readiness.format == "pblang.polyglot-isolate.status.v1"
    and readiness.supported_languages == ["python"]
    and not readiness.production_untrusted_ready
    and not readiness.runtime_identity_verified
    and not readiness.bwrap_descriptor_held_on_launch
    and not readiness.seccomp_filtered and not readiness.cgroup_enforced,
    "status separates configured controls from verified production guarantees");

require(not ISO.run("python", map{ source: "print(1)" })["ok"],
    "structured source is rejected before conversion");
require(not ISO.run("python", str_repeat("x", 3585))["ok"],
    "oversized source is rejected before launch");
require(not ISO.run("javascript", "console.log(1)")["ok"],
    "languages without fixed request-file wrappers fail closed");
require(not ISO.run("python", "print(1)", "", map{ timeout_sec: 1 })["ok"],
    "misspelled options fail closed");

if readiness.available {
    let run = ISO.run("python",
        "import os,sys\nprint('%d|%s|%d|%s' % (os.getuid(),os.getcwd(),len(os.listdir('/home')),sys.stdin.read()))",
        "bounded-input");
    require(run.ok and run.complete and not run.executed
        and not run.execution_confirmed and run.command_ok
        and run.process_completed and run.source_dispatch_reached
        and run.bounded and not run.sandbox_verified
        and run.namespace_configuration_requested
        and not run.namespace_isolated and not run.runtime_identity_verified
        and run.process_group_terminated and run.bwrap_descriptor_held
        and not run.bwrap_check_then_exec_race
        and str_trim(run.stdout) == "65534|/tmp|0|bounded-input",
        "bounded execution succeeds without overstating sandbox attestation: "
            + json_stringify(run));

    let selftest = ISO.isolation_selftest();
    require(selftest.ok and selftest.selftest_complete
        and not selftest.sandbox_verified and not selftest.namespace_isolated
        and not selftest.user_namespace_independently_verified
        and not selftest.ipc_namespace_independently_verified
        and not selftest.mount_namespace_independently_verified
        and selftest.private_uid_gid_observed
        and selftest.tmp_path_write_observed
        and selftest.scratch_size_bounded_observed
        and selftest.home_and_media_paths_absent_observed
        and selftest.selected_host_path_descriptors_absent_observed
        and selftest.usr_write_denied_as_nobody_observed
        and selftest.nested_userns_denied_observed
        and selftest.network_only_loopback_observed
        and selftest.environment_allowlist_exact_observed
        and selftest.capability_sets_empty_observed
        and selftest.no_new_privileges_observed
        and selftest.uts_hostname_observed and selftest.payload_pid_observed == 2
        and selftest.source_absent_from_runtime_argv_observed
        and not selftest.runtime_identity_verified,
        "live probes remain granular and retain unmeasured namespace and runtime limits: "
            + json_stringify(selftest));

    let syntax_error = ISO.run("python", "not valid python !!");
    require(syntax_error.process_completed and not syntax_error.executed
        and not syntax_error.source_dispatch_reached,
        "bootstrap completion is not reported as caller-source execution");

    let tiny = ISO.run("python", "print('ok')", "",
        map{ max_output_bytes: 1, timeout_secs: 5,
            max_memory_bytes: 67108864 });
    require(tiny.ok and tiny.source_dispatch_reached
        and not tiny.execution_confirmed
        and len(str_to_bytes(tiny.stdout)) + len(str_to_bytes(tiny.stderr)) <= 1
        and tiny.output_truncated,
        "control evidence has reserved capacity while application output keeps its exact bound");

    let clipped = ISO.run("python", "print('x'*4096)", "",
        map{ max_output_bytes: 128, timeout_secs: 5, max_memory_bytes: 67108864 });
    require(clipped.output_truncated and len(str_to_bytes(clipped.stdout)) <= 128,
        "output remains bounded before returning to the caller");
}

print "polyglot_isolate_pass";
