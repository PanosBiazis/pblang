// tests/semantics/nn_graph_comm_test.sapp — three ways graph nodes communicate:
// (1) WIRED along bonds, (2) WIRELESS broadcast on a shared channel (no bond needed),
// (3) QUANTUM entanglement (measuring one node instantly fixes its partner).

let G = import("stdlib/nn_graph.sapp");
let C = import("stdlib/nn_graph_comm.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let g = G.graph_new();
G.add_node(g, 0, "linear"); G.add_node(g, 0, "linear");
G.add_node(g, 0, "linear"); G.add_node(g, 0, "linear");

// ── (1) WIRED: a signal travels along bonds, scaled by combined bond strength ──────
G.add_bond(g, 0, 1, 2);
G.add_bond(g, 0, 1, 3);                 // parallel channel
eq(C.transmit(g, 0, 1, 5), 25, "wired signal = value * total bond strength (5*(2+3))");
eq(C.transmit(g, 0, 3, 5), 0, "no bond -> no wired signal");

// ── (2) WIRELESS: broadcast reaches every node tuned to the same channel ──────────
C.tune(g, 0, "A"); C.tune(g, 1, "A"); C.tune(g, 2, "A"); C.tune(g, 3, "B");
let rec = C.broadcast(g, 0, 10);        // node 0 emits on channel A
eq(len(rec), 2, "two receivers on channel A (nodes 1,2)");
eq(C.received(g, 1), 10, "node 1 received the broadcast");
eq(C.received(g, 3), 0, "node 3 (channel B) heard nothing");
C.broadcast(g, 0, 5);
eq(C.received(g, 1), 15, "broadcasts accumulate");
C.clear_received(g, 1);
eq(C.received(g, 1), 0, "inbox cleared");

// ── (3) QUANTUM: entangle pairs; measuring one collapses the other instantly ──────
C.entangle(g, 0, 1, "same");
C.entangle(g, 2, 3, "anti");
let aff = C.collapse(g, 0, 1);          // measure node 0 as 1
eq(C.node_value(g, 1), 1, "entangled partner correlates (same)");
eq(len(aff), 1, "one partner affected");
C.collapse(g, 2, 1);                    // measure node 2 as 1
eq(C.node_value(g, 3), 0 - 1, "anti-entangled partner anticorrelates");
let ew = C.entangled_with(g, 0);
eq(len(ew), 1, "node 0 is entangled with one partner");
eq(ew[0].id, 1, "node 0 entangled with node 1");

print "nn_graph_comm_pass";
