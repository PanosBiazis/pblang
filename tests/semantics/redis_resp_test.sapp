// Pure protocol tests: no external Redis service is required.
let R = import("stdlib:redis.sapp");

fn fail(message) { throw "FAIL " + message; }
fn eq(actual, expected, message) {
    if actual != expected { fail(message + " got=" + str(actual) + " want=" + str(expected)); }
}
fn ok(result, message) { if not result.ok { fail(message + ": " + str(try result.error catch "")); } }

eq(R.encode(["PING"]), "*1\r\n$4\r\nPING\r\n", "single command encoding");
eq(R.encode(["SET", "unicode", "λ"]),
   "*3\r\n$3\r\nSET\r\n$7\r\nunicode\r\n$2\r\nλ\r\n",
   "bulk lengths count UTF-8 bytes");
eq(R.encode_value(["zero", 7, nil]), "*3\r\n$4\r\nzero\r\n:7\r\n$-1\r\n",
   "server-side RESP value encoder");
eq(R.encode_value(map{ __redis_error: true, message: "ERR denied" }), "-ERR denied\r\n",
   "typed Redis error encoding");

let simple = R.parse("+OK\r\n"); ok(simple, "simple string"); eq(simple.value, "OK", "simple value");
let integer = R.parse(":42\r\n"); ok(integer, "integer"); eq(integer.value, 42, "integer value");
let bulk = R.parse("$5\r\nhello\r\n"); ok(bulk, "bulk"); eq(bulk.value, "hello", "bulk value");
let unicode = R.parse("$2\r\nλ\r\n"); ok(unicode, "unicode bulk"); eq(unicode.value, "λ", "unicode bulk value");
let null_bulk = R.parse("$-1\r\n"); ok(null_bulk, "null bulk"); eq(null_bulk.value, nil, "null bulk value");

let array = R.parse("*3\r\n:1\r\n$3\r\ntwo\r\n*2\r\n+X\r\n$-1\r\n");
ok(array, "nested array");
eq(len(array.value), 3, "array count"); eq(array.value[0], 1, "array integer");
eq(array.value[1], "two", "array bulk"); eq(array.value[2][0], "X", "nested value");
eq(array.value[2][1], nil, "nested null");

let redis_error = R.parse("-WRONGTYPE bad value\r\n"); ok(redis_error, "Redis error frame parses");
eq(redis_error.value.__redis_error, true, "Redis errors remain typed");
eq(redis_error.value.message, "WRONGTYPE bad value", "Redis error text");

eq(R.parse("$5\r\nabc").ok, false, "truncated bulk rejected");
eq(R.parse("+OK\r\nextra").ok, false, "trailing data rejected");
eq(R.parse("$6\r\n123456\r\n", map{ max_bulk_bytes: 5 }).ok, false, "bulk quota enforced");
eq(R.parse("*2\r\n+one\r\n+two\r\n", map{ max_array_items: 1 }).ok, false, "array quota enforced");
eq(R.parse("*1\r\n*1\r\n*1\r\n+deep\r\n", map{ max_depth: 2 }).ok, false, "depth quota enforced");
eq((try { R.encode(["SET", []]); false } catch true), true, "complex command argument rejected");
eq(R.connect(map{ host: "bad host", port: 6379 }).ok, false, "whitespace host rejected before network access");
eq(R.connect(map{ host: "127.0.0.1", port: "not-a-port" }).ok, false, "malformed port rejected instead of defaulted");
eq(R.connect(map{ host: "127.0.0.1", port: 0 }).ok, false, "out-of-range port rejected");

print "redis_resp_pass";
