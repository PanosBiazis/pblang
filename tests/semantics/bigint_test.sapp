// tests/semantics/bigint_test.sapp — arbitrary-precision integers (bigint).

// Construction from a decimal string (beyond f64's exact range).
let a = bigint("123456789012345678901234567890");
if str(a) != "123456789012345678901234567890" { throw "FAIL bigint parse"; }
if type(a) != "bigint" { throw "FAIL bigint type: " + type(a); }

// Exact addition / multiplication.
if str(a + bigint(10)) != "123456789012345678901234567900" { throw "FAIL bigint add"; }
if str(bigint(2) * bigint(3)) != "6" { throw "FAIL bigint mul"; }

// Exponentiation stays exact (2^64 is past f64's 2^53 integer limit).
if str(bigint(2) ** 64) != "18446744073709551616" { throw "FAIL bigint pow"; }

// Truncated integer division + modulo.
if str(bigint(100) / bigint(7)) != "14" { throw "FAIL bigint div"; }
if str(bigint(100) % bigint(7)) != "2" { throw "FAIL bigint mod"; }

// Negation.
if str(bigint(0) - bigint(5)) != "-5" { throw "FAIL bigint neg"; }

// Comparisons (including against plain numbers).
if not (bigint(1000000000000) > bigint(999999999999)) { throw "FAIL bigint gt"; }
if not (bigint(5) == 5) { throw "FAIL bigint == number"; }
if bigint(5) == 6 { throw "FAIL bigint != wrong number"; }

// Exact factorial of 25 — far beyond what f64 can represent exactly.
let n = bigint(1);
let i = bigint(1);
while i <= bigint(25) {
    n = n * i;
    i = i + 1;
}
if str(n) != "15511210043330985984000000" { throw "FAIL bigint 25! = " + str(n); }

// Mixing a bigint with a fractional float demotes to f64 (documented behaviour).
let mixed = bigint(10) + 0.5;
if mixed != 10.5 { throw "FAIL bigint mixed float: " + str(mixed); }

// Truthiness: zero is falsy, nonzero truthy.
if bigint(0) { throw "FAIL bigint(0) should be falsy"; }
if not bigint(7) { throw "FAIL bigint(7) should be truthy"; }

print "bigint_pass";
