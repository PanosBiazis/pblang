// tests/semantics/stdlib_unused_warning_bugs_test.sapp
//
// The unused-variable sweep exposed REAL behavior bugs (each "unused" binding
// was a broken error path, all from the catch-binds-no-name quirk):
//
//   - result.from_try declared a sentinel it never used and ALWAYS returned
//     Ok — a throwing fn came back as Ok(nil), never Err.
//   - testing.expect_no_throw checked an `err` variable that nothing ever
//     assigned — a THROWING fn PASSED the assertion.
//   - http_client.retry treated a legitimate nil return as failure (and kept
//     an unused last_error); stdlib/retry.sapp semantics: nil-return=success.
//   - registry_server.registry_init ignored both fs_mkdirs results and
//     returned true even when the data dir could not be created.

let R = import("stdlib:result.sapp");
let T = import("stdlib:testing.sapp");
let H = import("stdlib:http_client.sapp");
let RS = import("stdlib:registry_server.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }

// ── result.from_try ──────────────────────────────────────────────────────────
fn boom() { throw "boom"; }
fn gives_nil() { return nil; }
fn gives_5() { return 5; }
eq(R.is_err(R.from_try(boom)), true, "throwing fn -> Err");
eq(R.is_ok(R.from_try(gives_nil)), true, "nil-returning fn -> Ok");
eq(R.unwrap_or(R.from_try(gives_5), 0), 5, "value survives from_try");

// ── testing.expect_no_throw ──────────────────────────────────────────────────
eq(T.expect_no_throw(gives_5), true, "non-throwing fn passes");
// error() raises, so a failing assertion THROWS — that throw is the contract.
let en = try map{ ok: true, value: T.expect_no_throw(boom) } catch map{ ok: false, value: nil };
if en.ok and en.value == true { fail("throwing fn must NOT pass expect_no_throw"); }

// ── http_client.retry ────────────────────────────────────────────────────────
let calls = atomic_new(0);
fn nil_once() { atomic_add(calls, 1); return nil; }
eq(H.retry(nil_once, 3, 1), nil, "legit nil return is SUCCESS, not retried");
eq(atomic_get(calls), 1, "nil success used exactly one attempt");

let calls2 = atomic_new(0);
fn flaky() {
    atomic_add(calls2, 1);
    if atomic_get(calls2) < 3 { throw "down"; }
    return "up";
}
eq(H.retry(flaky, 5, 1), "up", "throws are retried until success");
eq(atomic_get(calls2), 3, "retry stopped as soon as it succeeded");

// ── registry_server.registry_init ────────────────────────────────────────────
let good = RS.RegistryConfig("tests_tmp_registry_init");
eq(RS.registry_init(good), true, "creatable data dir -> true");
proc_spawn_wait("bash", ["-c", "rm -rf tests_tmp_registry_init"]);

let bad = RS.RegistryConfig("/dev/null/registry");  // mkdirs under a file must fail
eq(RS.registry_init(bad), false, "uncreatable data dir -> false, not silent true");

print "stdlib_unused_warning_bugs_pass";
