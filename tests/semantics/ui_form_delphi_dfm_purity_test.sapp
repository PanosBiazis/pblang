let source = fs_read("stdlib/ui_form_delphi_dfm.sapp");

fn occurrences(text, needle) {
    let count = 0; let rest = text;
    while str_contains(rest, needle) {
        let position = str_index_of(rest, needle);
        count = count + 1; rest = str_slice(rest, position + len(needle), len(rest));
    }
    return count;
}

assert(occurrences(source, "import(") == 1
    and str_contains(source, "import(\"stdlib:ui_document.sapp\")"),
    "the DFM importer has exactly one canonical-model dependency");
for forbidden in ["fs_read(", "fs_write(", "http_get(", "http_post(", "tcp_connect(",
    "proc_spawn", "polyglot_exec", "ffi_load(", "ffi_call(", "env_get("] {
    assert(not str_contains(source, forbidden), "DFM importer purity boundary changed");
}
assert(str_contains(source, "effects:false") and str_contains(source, "handlers_executed:false")
    and str_contains(source, "external_reference_present"),
    "effect and external-reference contracts remain explicit in source");
print "ui_form_delphi_dfm_purity_pass";
