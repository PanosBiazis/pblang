let UI = import("stdlib/modern_ui.sapp");
let Android = import("stdlib/modern_ui_android.sapp");

fn fail(message) { throw "FAIL modern_ui_android: " + message; }
fn require(value, message) { if not value { fail(message); } }
fn contains_ascii(bytes, text) {
    let i = 0;
    while i + len(text) <= len(bytes) {
        let matched = true; let j = 0;
        while j < len(text) {
            if bytes[i + j] != strcharcodeat(text, j) { matched = false; }
            j = j + 1;
        }
        if matched { return true; }
        i = i + 1;
    }
    return false;
}

let view = UI.screen([
    UI.heading("PBLang \u03c3\u03b5 Android", map{ name: "status" }),
    UI.card([
        UI.input("", map{ name: "device", placeholder: "Device name" }),
        UI.area("", map{ name: "notes", placeholder: "Notes" }),
        UI.choice(["USB", "Wi-Fi", "Tor"], 1, nil, map{ name: "transport" }),
        UI.slider(35, 0, 100, nil, map{ name: "quality" }),
        UI.progress(0.7, map{ name: "progress" }),
        UI.toggle("Remember device", true, nil, map{ name: "remember",
            action: UI.action_set_text("status", "Preference changed") }),
        UI.button("Connect", UI.action_sequence([
            UI.action_set_text("status", "\u03a3\u03c5\u03bd\u03b4\u03ad\u03b8\u03b7\u03ba\u03b5"),
            UI.action_message("Ready")
        ]), map{ name: "connect", fill_width: true, variant: "primary" }),
        UI.button("Disconnect", UI.action_message("Stopped"),
            map{ name: "disconnect", fill_width: true, variant: "danger" })
    ], map{ title: "Connection", fill_width: true })
]);

let bundle = UI.compile(view, map{ target: "android", width: 412, height: 915 });
let generated = Android.generate("Modern PBLang", bundle, map{
    package: "org.pblang.modernuitest", min_sdk: 21, target_sdk: 34,
    version:"2.3.4",version_code:23
});
require(generated.format == "pblang.modern-ui.android.v1", "generation format");
require(generated.version=="2.3.4" and generated.version_code==23,
    "version metadata is retained for packaging");
require(generated.class_bytes[0] == 202 and generated.class_bytes[1] == 254
    and generated.class_bytes[2] == 186 and generated.class_bytes[3] == 190,
    "JVM class magic");
require(len(generated.class_bytes) > 500, "generated Activity contains real widget bytecode");
require(generated.actions == 3,
    "generated Activity includes portable button and toggle actions");
require(generated.responsive.runtime_screen_width_dp
    and generated.responsive.compact_breakpoint_dp == 600
    and generated.responsive.minimum_touch_target_dp == 48
    and generated.responsive.orientation_recreates_layout
    and contains_ascii(generated.class_bytes, "screenWidthDp"),
    "generated Activity uses the actual device width for responsive layout");
require(contains_ascii(generated.class_bytes, "android/view/ViewGroup$LayoutParams")
    and contains_ascii(generated.class_bytes, "setLayoutParams")
    and contains_ascii(generated.class_bytes, "android/content/res/ColorStateList")
    and contains_ascii(generated.class_bytes, "setBackgroundTintList"),
    "opt-in full-width and semantic action styles compile to native Android APIs");
require(str_contains(generated.manifest, "android:hardwareAccelerated=\"true\""),
    "hardware acceleration manifest policy");
require(str_contains(generated.manifest, "android:usesCleartextTraffic=\"false\""),
    "cleartext disabled");
require(str_contains(generated.manifest,
    "android:theme=\"@android:style/Theme.Material.NoActionBar\""),
    "dark component palette uses a matching Android platform theme");
require(str_contains(generated.manifest, "android:screenOrientation=\"unspecified\"")
    and str_contains(generated.manifest, "android:windowSoftInputMode=\"adjustResize\""),
    "orientation and keyboard resizing remain responsive");

let tablet = Android.generate("Modern PBLang", bundle, map{
    package: "org.pblang.modernuitablet", compact_breakpoint_dp: 720, theme: "light"
});
require(tablet.responsive.compact_breakpoint_dp == 720,
    "application can tune the bounded responsive breakpoint");
require(str_contains(tablet.manifest,
    "android:theme=\"@android:style/Theme.Material.Light.NoActionBar\""),
    "light component palette keeps the light Android platform theme");

let nightly = Android.generate("Modern Nightly", bundle, map{
    package:"org.pblang.modernnightly", version:"2.3.4",
    release_channel:"nightly.20260828", show_release_channel:true
});
require(nightly.version == "2.3.4" and nightly.display_version == "2.3.4-nightly.20260828"
    and str_contains(nightly.manifest, "android:versionName=\"2.3.4-nightly.20260828\""),
    "Android display version includes a channel only when requested");

let callback_rejected = false;
let callback_view = UI.screen([
    UI.button("Unsafe", fn(form) { return form; }, map{ name: "unsafe" })
]);
try {
    Android.generate("Rejected", UI.compile(callback_view, map{ target: "android" }),
        map{ package: "org.pblang.rejected" });
} catch { callback_rejected = true; }
require(callback_rejected, "host callback rejected instead of silently omitted");

let missing_target_rejected = false;
let missing_view = UI.screen([
    UI.button("Broken", UI.action_set_text("missing", "x"), map{ name: "broken" })
]);
try {
    Android.generate("Rejected", UI.compile(missing_view, map{ target: "android" }),
        map{ package: "org.pblang.missingtarget" });
} catch { missing_target_rejected = true; }
require(missing_target_rejected, "missing action target rejected");

print "modern_ui_android_pass";
