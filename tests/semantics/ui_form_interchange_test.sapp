let Forms = import("stdlib:ui_form_interchange.sapp");
fn fail(message) { throw "FAIL ui_form_interchange: " + message; }

let status = Forms.status();
if status.adapter_count < 20 or status.roundtrip_tested != 1 or status.preview < 2
   or status.production_ready { fail("truthful adapter status mismatch"); }
for required in ["delphi-dfm", "generic-xml", "android-xml", "kotlin-compose", "android-java",
    "qt-ui", "unreal-umg", "godot-scene", "unity-ui-toolkit", "swiftui", "web-form", "web-template"] {
    if Forms.get(required) == nil { fail("missing required adapter " + required); }
}
let android = Forms.detect("res/layout/main.xml", "<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\">");
if not android.ok or android.selected != "android-xml" { fail("Android XML detection mismatch"); }
let pblang = Forms.detect("screen.sapp", "let GUI = import(\"stdlib:gui.sapp\"); let form = GUI.form(640, 480, \"Demo\");");
if not pblang.ok or pblang.selected != "pblang-gui" { fail("PBLang GUI detection mismatch"); }
let dfm_source = "object Form1: TForm1\n Caption = 'Demo'\nend\n";
let dfm = Forms.detect("/private/work/forms/main.dfm", dfm_source);
if not dfm.ok or dfm.selected != "delphi-dfm" or dfm.path != "main.dfm" {
    fail("DFM content signature or path privacy mismatch");
}
let binary_dfm = Forms.detect("main.dfm", "TPF0binary");
if binary_dfm.ok or binary_dfm.selected != nil or binary_dfm.error != "binary-dfm-unsupported" {
    fail("binary DFM must not be selected by extension");
}
let unsigned_dfm = Forms.detect("main.dfm", "not a form");
if unsigned_dfm.ok or unsigned_dfm.error != "content-signature-mismatch" {
    fail("DFM extension without text signature must fail closed");
}
let blocked = Forms.conversion_plan("delphi-dfm", "pblang-gui");
if not blocked.ok or blocked.executable or len(blocked.blockers) == 0 { fail("contract-only conversion must fail closed"); }
let native = Forms.conversion_plan("pblang-gui", "pblang-gui");
if not native.ok or not native.executable or not native.atomic_destination { fail("tested native round-trip plan mismatch"); }
let engine = Forms.conversion_plan("pblang-gui", "unreal-umg");
if engine.executable or not str_contains(str(engine.blockers), "engine project") { fail("engine SDK boundary missing"); }
print "ui_form_interchange_pass";
