// Deterministic rapid-click, stale-page and asynchronous Stop regressions.
let W=import("../../examples/uno_r4_led_studio/web.sapp");
let M=import("../../examples/uno_r4_led_studio/model.sapp");
let D=import("../../examples/uno_r4_led_studio/device_export.sapp");
let C=import("../../examples/uno_r4_led_studio/device_control.sapp");
fn req(method,path="/",body=""){return map{method:method,path:path,body:body,headers:map{host:"127.0.0.1:8768",origin:"http://127.0.0.1:8768","content-type":"application/x-www-form-urlencoded"}};}
fn hidden(p,key){return str_split(str_split(p,"name=\""+key+"\" value=\"")[1],"\"")[0];}
fn button(page,key){
    let ordinals=map{device_status:1,device_play:2,device_stop:3,device_upload:4};
    for chunk in str_split(page.body,"class=\"device-controls\"") {
        let form=str_split(chunk,"</form>")[0];if not str_contains(form,"/"+str(ordinals[key])+"#") {continue;}
        return req("POST",str_split(str_split(form,"action=\"")[1],"#")[0],"csrf="+hidden(form,"csrf")+"&revision="+hidden(form,"revision")+"&action="+key);
    }throw "Missing control.";
}
let effects=[];let busy=false;
let app=W.create(8768,map{hide_source_names:false,discourage_scraping:false,throttle_rejected_requests:false},map{
    supports_upload:true,status:fn(){return map{busy:busy,uncertain:false,stop_pending:false};},
    action:fn(doc,cmd){push(effects,cmd);return map{ok:true,message:cmd};}});
let page=app.handle(req("GET"));let play=button(page,"device_play");let stop=button(page,"device_stop");
assert(app.handle(play).status==303 and len(effects)==1,"Play redirects after one action");
assert(app.handle(play).status==303 and len(effects)==1,"duplicate Play refreshes controls without replay");
assert(app.handle(stop).status==303 and len(effects)==2 and effects[1]=="STOP","rapid Stop from same rendered page survives Play");
assert(app.handle(stop).status==303 and len(effects)==2,"duplicate Stop is not re-executed");
page=app.handle(req("GET"));let older_play=button(page,"device_play");let older_upload=button(page,"device_upload");
let newer=app.handle(req("GET"));app.handle(button(newer,"device_stop"));
let before=len(effects);assert(app.handle(older_play).status==303 and app.handle(older_upload).status==303 and len(effects)==before,"newer Stop invalidates delayed older Play and Upload");
page=app.handle(req("GET"));assert(str_contains(page.body,"older request did not run"),"stale intent notice reaches current editor");
assert(app.handle(button(page,"device_play")).status==303 and effects[len(effects)-1]=="PLAY","fresh explicit Play after Stop still works");
// Cross-action forgery cannot turn a Check token into a hardware command.
page=app.handle(req("GET"));let forged=button(page,"device_status");forged.body=str_join(str_split(forged.body,"action=device_status"),"action=device_play");before=len(effects);
assert(app.handle(forged).status==400 and len(effects)==before,"token is bound to one command");
let check=button(page,"device_status");assert(app.handle(check).status==303 and effects[len(effects)-1]=="STATUS","malformed request did not consume valid control");
check.headers.origin="https://invalid.example";before=len(effects);assert(app.handle(check).status==403 and len(effects)==before,"used control still rejects foreign origin");
busy=true;page=app.handle(req("GET"));assert(len(str_split(page.body,"disabled aria-disabled"))==3,"only Play and Send disabled during transfer");app.close();
// Controller: Stop survives cancellation and is completed by a later Check.
let initial=M.create();let changed=M.create();M.apply(changed,"preset","border");let plan=D.plan(initial.document,1);
let s=map{calls:[],phase:"idle",complete:false,upload:false,running:false,stops_fail:false,starts:0,cancels:0};
fn progress(){return map{ok:false,complete:s.complete,cleanup_confirmed:s.complete,upload_attempted:s.upload,phase:s.phase,message:s.phase};}
let uploader=map{start:fn(p,stopped){s.starts=s.starts+1;s.phase="compiling";return progress();},cancel:fn(){s.cancels=s.cancels+1;s.phase="cancelling";return progress();},poll:fn(){return progress();}};
let runner=fn(p,port,cmd,confirmed){push(s.calls,cmd);if cmd=="STOP" and s.stops_fail{return map{ok:false};}if cmd=="PLAY"{s.running=true;}if cmd=="STOP"{s.running=false;}return map{ok:true,reply:map{state:if s.running{"running"}else{"idle"},frame:0,remaining_ms:0}};};
let controller=C.create(plan,"/dev/ttyACM0",true,runner,uploader);
assert(controller.action(initial.document,"UPLOAD").ok and s.starts==0,"same installed project is verified without another compile/flash");
assert(controller.action(initial.document,"PLAY").ok,"first Play works");before=len(s.calls);
assert(controller.action(initial.document,"PLAY").ok and len(s.calls)==before+1 and s.calls[before]=="STATUS","repeated Play checks state without restarting running board");
controller.action(initial.document,"STOP");controller.action(changed.document,"UPLOAD");controller.action(changed.document,"STOP");
assert(controller.status().stop_pending and controller.status().busy,"pending Stop retained across asynchronous cancellation");
s.complete=true;s.phase="failed";s.stops_fail=true;
assert(not controller.action(changed.document,"STATUS").ok and s.calls[len(s.calls)-1]=="STOP" and controller.status().stop_pending,"Check finishes cancellation and attempts original Stop; failure retains intent");
before=len(s.calls);assert(not controller.action(initial.document,"PLAY").ok and len(s.calls)==before,"unconfirmed Stop blocks Play");
s.stops_fail=false;assert(controller.action(changed.document,"STATUS").ok and not controller.status().stop_pending,"later Check confirms pending Stop");
print "uno_r4_led_studio_repeat_pass";
