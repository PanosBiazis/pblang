// Opt-in physical Windows fixture. No personal files, desktop, credentials or network.
let W=import("stdlib:windows_dirfs.sapp");
if platform()!="windows" {print "windows_dirfs_publication_skip_non_windows";}
else {
    let bridge=env_get("PBLANG_WINDOWS_ABI_BRIDGE");
    let base=".pb-publication-"+str_slice(sha256(base64_encode_bytes(random_bytes(16))),0,12);
    fs_mkdirs(base+"/inside");fs_mkdirs(base+"/outside");
    let fs=W.open(base+"/inside",false,bridge);assert(fs.ok,"held fixture root");
    for bytes in [[256],[-1],[0.5],[nil],["x"],nil,"x"] {
        assert(not W.write_new_exclusive(fs,"bad/file.bin",bytes,true).ok,"invalid exclusive payload rejected");
        assert(not W.write_atomic(fs,"bad/file.bin",bytes,true).ok,"invalid atomic payload rejected");
        assert(not fs_exists(base+"/inside/bad"),"invalid input creates no parent or file");
    }
    assert(W.write_new_exclusive(fs,"source.bin",[10],false).ok,"source fixture");
    fs_write_bytes(base+"/outside/keep.bin",[77]);
    let made=proc_spawn_wait("cmd.exe",["/D","/C","mklink /J "+base+"\\inside\\jump "+base+"\\outside"]);
    assert(made.exit_code==0,"owned junction fixture required");
    assert(not W.move(fs,"source.bin","jump/keep.bin",true).ok,"destination junction rejected");
    assert(not W.move(fs,"source.bin","jump/missing.bin",false).ok,"new destination through junction rejected");
    assert(W.read_bytes(fs,"source.bin",1).bytes==[10],"failed moves preserve source");
    assert(fs_read_bytes(base+"/outside/keep.bin")==[77],"outside destination preserved");
    assert(not fs_exists(base+"/outside/missing.bin"),"outside entry not created");
    assert(not W.write_atomic(fs,"jump/keep.bin",[88],false).ok,"atomic write rejects junction");
    assert(W.mkdir(fs,"nested").ok,"normal directory fixture");
    assert(W.move(fs,"source.bin","nested/value.bin",false).ok,"held normal parent supports move");
    assert(W.write_atomic(fs,"nested/value.bin",[11],false).ok,"normal atomic replacement");
    assert(W.read_bytes(fs,"nested/value.bin",1).bytes==[11],"replacement bytes");
    // 'root' is a list alias, but a literal component in an explicit destination.
    fs_mkdirs(base+"/inside/root");
    assert(W.move(fs,"nested/value.bin","root/value.bin",false).ok,"literal root destination component");
    assert(fs_read_bytes(base+"/inside/root/value.bin")==[11],"literal parent used");
    assert(not fs_exists(base+"/inside/value.bin"),"root alias does not redirect rename");
    assert(W.close(fs),"fixture closed");
    let removed=proc_spawn_wait("cmd.exe",["/D","/C","rmdir "+base+"\\inside\\jump"]);
    assert(removed.exit_code==0,"junction removed without traversing target");
    for name in ["inside/root/value.bin","outside/keep.bin"] {fs_remove(base+"/"+name);}
    for name in ["inside/root","inside/nested","inside","outside"] {fs_remove(base+"/"+name);}
    fs_remove(base);
    print "windows_dirfs_publication_live_pass";
}
