let PROCESS = import("stdlib:process.sapp");

fn require(condition, message) {
    if not condition { throw "FAIL bounded process facade: " + message; }
}

fn rejected(work) { return try { work(); false } catch true; }

let status = PROCESS.bounded_status();
require(not status.raw_fallback, "bounded facade never enables raw fallback");

if status.available {
    let started = PROCESS.start_fixed_bounded(["/usr/bin/printf"],
        ["%s", "opaque-lifecycle"], map{ timeout_secs: 3,
            max_output_bytes: 4096, max_file_bytes: 4096,
            max_memory_bytes: 67108864, max_open_files: 32,
            max_processes: 2048 });
    require(started.ok and started.started and started.bounded
        and started.format == PROCESS.BOUNDED_HANDLE_FORMAT
        and not started.raw_fallback and not started.raw_state_exposed
        and not map_has(started, "raw") and not map_has(started, "fs"),
        "start returns only an opaque lifecycle handle");

    let forged = map{ format: started.format, id: sha256("not-a-process-handle") };
    require(rejected(fn() { PROCESS.poll_bounded(forged); }),
        "forged lifecycle handle is rejected");
    started.extra = map{ raw: "attacker-state" };
    let observed = PROCESS.poll_bounded(started);
    require(observed.ok and not observed.raw_state_exposed
        and observed.race_resistant_identity
        and not map_has(observed, "raw") and not map_has(observed, "fs"),
        "public handle mutation cannot expose or replace supervisor state");

    let result = PROCESS.finish_bounded(started, 3000);
    require(result.ok and result.command_ok and result.stdout == "opaque-lifecycle"
        and result.process_group_terminated and result.handle_closed
        and not result.requires_recovery and result.bounded
        and result.race_resistant_identity
        and not result.raw_fallback and not result.raw_state_exposed,
        "normal finish returns bounded output and verified terminal cleanup");
    require(rejected(fn() { PROCESS.poll_bounded(started); }),
        "terminal finish invalidates the lifecycle handle");

    let abandoned = PROCESS.start_fixed_bounded(["/usr/bin/printf"],
        ["%s", "auto-reap"], map{ timeout_secs: 2,
            max_output_bytes: 128, max_file_bytes: 128,
            max_memory_bytes: 67108864, max_open_files: 32,
            max_processes: 2048 });
    require(abandoned.ok, "automatic-recovery fixture starts");
    let waiter = channel(); recv_timeout(waiter.receiver, 50);
    let maintenance = PROCESS.maintain_bounded();
    require(maintenance.format == "pblang.process.bounded-maintenance.v1"
        and maintenance.closed >= 1 and maintenance.results_cached >= 1
        and maintenance.terminal_cached_bytes <= maintenance.terminal_cache_limit_bytes
        and not maintenance.raw_state_exposed,
        "maintenance closes process resources while retaining bounded claimable output");
    let cached_poll = PROCESS.poll_bounded(abandoned);
    require(cached_poll.complete and cached_poll.terminal_cached,
        "maintenance preserves the terminal result behind the opaque handle");
    let cached_result = PROCESS.finish_bounded(abandoned, 0);
    require(cached_result.handle_closed and cached_result.result_was_cached
        and cached_result.stdout == "auto-reap",
        "the caller can claim output after opportunistic process cleanup");
    require(rejected(fn() { PROCESS.poll_bounded(abandoned); }),
        "claimed terminal handle cannot be reused");

    for _attempt 132 {
        let failed_launch = PROCESS.start_fixed_bounded(
            ["/definitely/missing/pblang-process-fixture"], [], map{});
        require(not failed_launch.ok and not failed_launch.started,
            "failed launch does not become a live lifecycle handle");
    }
    let capacity_after_failures = PROCESS.maintain_bounded();
    require(capacity_after_failures.active == 0,
        "failed launches release their pre-launch reservations");

    let sleeping = PROCESS.start_fixed_bounded(["/usr/bin/sleep"], ["30"],
        map{ timeout_secs: 30, max_output_bytes: 128,
            max_file_bytes: 128, max_memory_bytes: 67108864,
            max_open_files: 32, max_processes: 2048 });
    require(sleeping.ok, "cancellation fixture starts");
    let requested = PROCESS.request_cancel_bounded(sleeping, 50);
    require(requested.ok and requested.requested,
        "nonblocking cancellation is requested through the opaque handle");
    let cancelled = PROCESS.finish_bounded(sleeping, 2500);
    require(cancelled.handle_closed and not cancelled.requires_recovery
        and (try cancelled.process_group_terminated catch false),
        "cancelled process remains owned until group termination is verified: "
            + json_stringify(cancelled));
    require(rejected(fn() { PROCESS.finish_bounded(sleeping, 0); }),
        "cancelled terminal handle cannot be reused");
} else {
    let unavailable = PROCESS.start_fixed_bounded(["/usr/bin/printf"], [], map{});
    require(not unavailable.ok and unavailable.unsupported
        and not unavailable.raw_fallback,
        "unsupported platform fails closed without fallback");
}

print "process_bounded_async_pass";
