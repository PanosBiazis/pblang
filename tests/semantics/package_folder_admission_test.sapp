let Package=import("stdlib:package_folder.sapp");
// Admission runs before any source traversal/output initialization.
for args in [[nil,"/tmp/new-output","/tmp/runtime"],["/tmp/source",false,"/tmp/runtime"],
             ["/tmp/source","/tmp/new-output",[]],["","/tmp/new-output","/tmp/runtime"],
             ["/tmp/source","/tmp/source","/tmp/runtime"],
             ["/tmp/source","/tmp/source/new","/tmp/runtime"],
             ["/tmp/source/sub","/tmp/source","/tmp/runtime"],
             ["/","/tmp/new-output","/tmp/runtime"],
             ["/tmp/source","/tmp/source/../source/new","/tmp/runtime"],
             ["/tmp/source\\other","/tmp/new-output","/tmp/runtime"]] {
    let result=Package.bundle(args[0],args[1],args[2]);
    assert(not result.ok and not result.complete and not result.output_created,"invalid admission rejects");
    assert(not result.output_may_exist and not result.publication_attempted,"no output operation attempted");
    assert(result.owned_handles_closed and not result.native_bundle_invoked,"no owned handle escapes");
}
// Repeated failed initialization must not accumulate held directory descriptors.
let before=len(fs_listdir("/proc/self/fd"));
for i 20 {
    let result=Package.bundle("/proc/pblang-package-nonexistent", "/tmp/pblang-package-new", "/tmp/runtime");
    assert(not result.ok and result.owned_handles_closed and not result.output_may_exist,"failed init stays closed");
}
assert(len(fs_listdir("/proc/self/fd"))==before,"no descriptor growth after failed initialization");
print "package_folder_admission_pass";
