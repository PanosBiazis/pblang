let O=import("stdlib:orm.sapp");
fn require(ok,message){if not ok {throw "FAIL: "+message;}}
let calls=0;
let captured="";
let recorder=map{query:fn(sql,params){calls=calls+1;captured=sql;return [];}};
for clause in ["id", "id ASC", "id desc", " name DESC, id ASC ", " _value , id"] {
 let before=calls;
 O.find(recorder,"items",map{order:clause,limit:1});
 require(calls==before+1,"valid order dispatched once");
 require(captured=="SELECT * FROM items ORDER BY "+clause+" LIMIT 1","valid SQL byte parity");
}
for clause in ["id ASC LIMIT 0", "id ASC --", "id ASC NULLS FIRST", "id ASC ; DROP TABLE items", "id ASC /* private-marker */", "id ASC UNION SELECT 1", "id ASC COLLATE NOCASE", "id\u0000ASC", "id  ASC", "id\tASC", "id ASC\nLIMIT 0", "id SIDEWAYS", ",id", "id,", "id,,name", " ", "id;", "id ASC extra", "é", 1, true, [], map{}] {
 let before=calls;
 let rejected=try [false,O.find(recorder,"items",map{order:clause})] catch [true,nil];
 require(rejected[0],"invalid order rejected");
 require(calls==before,"invalid order never reaches connection");
}
for absent in [nil,""] {
 O.find(recorder,"items",map{order:absent});
 require(captured=="SELECT * FROM items","absent order unchanged");
}
let c=O.connect(":memory:");
c.exec("create table items(id integer, name text)",[]);
c.exec("insert into items values (1, 'b'), (2, 'a'), (3, 'a')",[]);
let rows=O.find(c,"items",map{order:"name ASC, id DESC",limit:1});
require(len(rows)==1 and rows[0].id==3,"SQLite ordering and limit");
require((try O.find(c,"items",map{order:"id ASC --",limit:1}) catch "rejected")=="rejected","comment cannot override limit");
require(O.count(c,"items")==3,"data unchanged");
c.close();
print "orm_order_pass";
