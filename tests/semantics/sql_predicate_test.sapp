let P=import("stdlib:sql_predicate.sapp");
fn require(ok,message){if not ok {throw "FAIL: "+message;}}
for pair in [["eq","="],["ne","<>"],["lt","<"],["le","<="],["gt",">"],["ge",">="],["like","LIKE"]] {
 let p=P.compile_all([["value",pair[0],"sample"]]);
 require(p.sql=="([value] "+pair[1]+" ?)" and p.params==["sample"],"operator mapping");
}
let n=P.compile_all([["a","eq",nil],["b","ne",nil],["c","eq",false],["d","ge",1.5]]);
require(n.sql=="([a] IS NULL) AND ([b] IS NOT NULL) AND ([c] = ?) AND ([d] >= ?)","null SQL");
require(n.params==[false,1.5],"null parameter ordering");
for v in [true,false,0,-2,1.5,parse_number("1e100"),"", "quote'; --", "text\u0000tail"] {
 let p=P.compile_all([["select","eq",v]]);
 require(p.sql=="([select] = ?)" and p.params==[v],"scalar values bound with quoted identifier");
}
for invalid in [nil,true,"sql",map{},[],[nil],[[]],[["a","eq"]],[["a","eq",1,2]],[["a; DROP","eq",1]],[["1bad","eq",1]],[["é","eq",1]],[["","eq",1]],[["a\u0000","eq",1]],[[1,"eq",1]],[["a",nil,1]],[["a","EQ",1]],[["a","= ? OR 1=1",1]],[["a","eq",[]]],[["a","eq",map{}]],[["a","eq",fn(){return 1;}]],[["a","like",1]],[["a","like",true]],[["a","eq",1],["b","invalid",2]]] {
 require((try P.compile_all(invalid) catch "rejected")=="rejected","malformed request rejected");
}
for op in ["lt","le","gt","ge","like"] {
 require((try P.compile_all([["a",op,nil]]) catch "rejected")=="rejected","unsupported null comparison");
}
for text in ["NaN","inf","-inf"] {
 let value=parse_number(text);
 require(type(value)=="number","nonfinite test setup");
 require((try P.compile_all([["a","eq",value]]) catch "rejected")=="rejected","nonfinite values rejected");
}
let name=str_repeat("a",64);
require(len(P.compile_all([[name,"eq",1]]).params)==1,"existing identifier boundary");
require((try P.compile_all([[name+"a","eq",1]]) catch "rejected")=="rejected","oversized identifier");
let cycle=[];array_push(cycle,cycle);
require((try P.compile_all(cycle) catch "rejected")=="rejected","cycle rejected without traversal");
let input=[["x","eq",1]];let one=P.compile_all(input);let two=P.compile_all(input);
one.params[0]=99;one.sql="changed";
require(two.params==[1] and input==[["x","eq",1]],"results and input independent");
let many=[];for i 4096 {array_push(many,["x","eq",i]);}
let large=P.compile_all(many);
require(len(large.params)==4096 and large.params[4095]==4095,"wide flat filter without count cap");
require(len(large.sql)==4096*9+4095*5,"wide SQL length");
let members=[1,"x' OR 1=1 --",nil,true,parse_number("1e100"),"text\u0000tail"];
let mixed=P.compile_all([["a","in",members],["b","eq",9],["c","not_in",[false,2]],["d","in",[]]]);
require(mixed.sql=="([a] IN (?, ?, ?, ?, ?, ?)) AND ([b] = ?) AND ([c] NOT IN (?, ?)) AND ([d] IN (SELECT 1 WHERE 0))","membership SQL");
require(mixed.params==[1,"x' OR 1=1 --",nil,true,parse_number("1e100"),"text\u0000tail",9,false,2],"membership parameter ordering");
for pair in [["in","IN"],["not_in","NOT IN"]] {
 let empty=P.compile_all([["select",pair[0],[]]]);
 require(empty.sql=="([select] "+pair[1]+" (SELECT 1 WHERE 0))" and empty.params==[],"empty set keeps column reference");
 let single=P.compile_all([["a",pair[0],[nil]]]);
 require(single.sql=="([a] "+pair[1]+" (?))" and single.params==[nil],"list nil remains bound");
 for bad in [nil,1,true,"x",map{},fn(){return 1;}] {
  require((try P.compile_all([["a",pair[0],bad]]) catch "rejected")=="rejected","membership requires array");
 }
 for bad in [[],map{},fn(){return 1;},cycle,parse_number("NaN"),parse_number("inf"),parse_number("-inf")] {
  let error=try P.compile_all([["a",pair[0],[1,bad]]]) catch "rejected";
  require(error=="rejected","invalid membership member rejected");
 }
 require((try P.compile_all([["bad;",pair[0],[]]]) catch "rejected")=="rejected","empty list validates identifier");
}
for op in ["IN","NOT IN","not in","NOT_IN","in ? OR 1=1"] {
 require((try P.compile_all([["a",op,[1]]]) catch "rejected")=="rejected","exact membership operators only");
}
let duplicates=P.compile_all([["a","in",[-2,1.5,"",0,-2]]]);
require(duplicates.params==[-2,1.5,"",0,-2] and duplicates.sql=="([a] IN (?, ?, ?, ?, ?))","finite members and duplicates preserved");
let first=P.compile_all([["a","in",members]]);let second=P.compile_all([["a","in",members]]);
first.params[0]=99;members[1]="changed";
require(second.params[0]==1 and second.params[1]=="x' OR 1=1 --" and members[0]==1,"membership results do not alias input or each other");
let values=[];for i 4096 {array_push(values,i);}
let wide=P.compile_all([["x","in",values]]);
require(len(wide.params)==4096 and wide.params[4095]==4095 and len(wide.sql)==12+4095*3,"large membership has no new count cap");
let reuse=P.compile_all([["a","ge",1],["a","le",9],["b","in",[2]],["b","not_in",[]],["a","ne",nil]]);
require(reuse.sql=="([a] >= ?) AND ([a] <= ?) AND ([b] IN (?)) AND ([b] NOT IN (SELECT 1 WHERE 0)) AND ([a] IS NOT NULL)" and reuse.params==[1,9,2],"adjacent repeated and alternating names retain output order");
let hooks=0;
let evil=map{__eq__:fn(other){hooks=hooks+1;return true;},__ne__:fn(other){hooks=hooks+1;return false;}};
let cycle_map=map{};cycle_map.self=cycle_map;
for bad in [evil,cycle,cycle_map,nil,1,true,fn(){hooks=hooks+1;return "a";},"","a;","a\u0000",str_repeat("a",65)] {
 require((try P.compile_all([["a","eq",1],[bad,"eq",2]]) catch "rejected")=="rejected","invalid column after valid seed rejected");
 require(hooks==0,"column comparison never executes overloaded operators");
}
for invalid in [[["a","eq",1],["a","EQ",2]],[["a","eq",1],["a","in",[map{}]]],[["a","eq",1],["a","lt",nil]]] {
 require((try P.compile_all(invalid) catch "rejected")=="rejected","column reuse never bypasses operator or value validation");
}
let reused_input=[["a","eq",1],["a","ne",2]];let prior_result=P.compile_all(reused_input);
reused_input[1][0]="b";let next_result=P.compile_all(reused_input);
require(prior_result.sql=="([a] = ?) AND ([a] <> ?)" and next_result.sql=="([a] = ?) AND ([b] <> ?)","input changes between calls do not reuse stale names");
print "sql_predicate_pass";
