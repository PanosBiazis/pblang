let P=import("stdlib:sql_predicate.sapp");
fn require(ok,message){if not ok {throw "FAIL: "+message;}}
for pair in [["eq","="],["ne","<>"],["lt","<"],["le","<="],["gt",">"],["ge",">="],["like","LIKE"]] {
 let p=P.compile_all([["value",pair[0],"sample"]]);
 require(p.sql=="([value] "+pair[1]+" ?)" and p.params==["sample"],"operator mapping");
}
let n=P.compile_all([["a","eq",nil],["b","ne",nil],["c","eq",false],["d","ge",1.5]]);
require(n.sql=="([a] IS NULL) AND ([b] IS NOT NULL) AND ([c] = ?) AND ([d] >= ?)","null SQL");
require(n.params==[false,1.5],"null parameter ordering");
for v in [true,false,0,-2,1.5,parse_number("1e100"),"", "quote'; --", "text\u0000tail"] {
 let p=P.compile_all([["select","eq",v]]);
 require(p.sql=="([select] = ?)" and p.params==[v],"scalar values bound with quoted identifier");
}
for invalid in [nil,true,"sql",map{},[],[nil],[[]],[["a","eq"]],[["a","eq",1,2]],[["a; DROP","eq",1]],[["1bad","eq",1]],[["é","eq",1]],[["","eq",1]],[["a\u0000","eq",1]],[[1,"eq",1]],[["a",nil,1]],[["a","EQ",1]],[["a","= ? OR 1=1",1]],[["a","eq",[]]],[["a","eq",map{}]],[["a","eq",fn(){return 1;}]],[["a","like",1]],[["a","like",true]],[["a","eq",1],["b","invalid",2]]] {
 require((try P.compile_all(invalid) catch "rejected")=="rejected","malformed request rejected");
}
for op in ["lt","le","gt","ge","like"] {
 require((try P.compile_all([["a",op,nil]]) catch "rejected")=="rejected","unsupported null comparison");
}
for text in ["NaN","inf","-inf"] {
 let value=parse_number(text);
 require(type(value)=="number","nonfinite test setup");
 require((try P.compile_all([["a","eq",value]]) catch "rejected")=="rejected","nonfinite values rejected");
}
let name=str_repeat("a",64);
require(len(P.compile_all([[name,"eq",1]]).params)==1,"existing identifier boundary");
require((try P.compile_all([[name+"a","eq",1]]) catch "rejected")=="rejected","oversized identifier");
let cycle=[];array_push(cycle,cycle);
require((try P.compile_all(cycle) catch "rejected")=="rejected","cycle rejected without traversal");
let input=[["x","eq",1]];let one=P.compile_all(input);let two=P.compile_all(input);
one.params[0]=99;one.sql="changed";
require(two.params==[1] and input==[["x","eq",1]],"results and input independent");
let many=[];for i 4096 {array_push(many,["x","eq",i]);}
let large=P.compile_all(many);
require(len(large.params)==4096 and large.params[4095]==4095,"wide flat filter without count cap");
require(len(large.sql)==4096*9+4095*5,"wide SQL length");
print "sql_predicate_pass";
