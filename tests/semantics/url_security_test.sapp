// tests/semantics/url_security_test.sapp
//
// URL parsing security hardening (SSRF / host-confusion / credential leaking):
//
//   BUG: in special schemes (http/https/ws/wss) a backslash acts as a path
//   separator per WHATWG, so `http://evil.com\@google.com/` connects to
//   evil.com — but the parser split userinfo at the LAST '@' and reported
//   host=google.com. A security allow-list using parse().host would trust
//   google.com while a browser/fetcher hits evil.com. Classic SSRF bypass.
//
//   ENRICH: is_special_scheme, strip_credentials (avoid leaking user:pass in
//   logs/redirects), same_origin, and origin serialization hardened to lower
//   the host and drop default ports (WHATWG origin form).

let url = import("stdlib:url.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }
fn falsy(c, m) { if c != false { fail(m); } }

// ── backslash host-confusion (the SSRF bug) ───────────────────────────────────
eq(url.parse("http://evil.com\\@google.com/").host, "evil.com",
   "special scheme: backslash ends the authority -> real host is evil.com");
eq(url.parse("http://evil.com\\@google.com/").path, "/@google.com/",
   "the @google.com part becomes the path, not the host");
eq(url.parse("https://a.com\\.evil.com/").host, "a.com",
   "backslash truncates the host in https too");
eq(url.parse("wss://h1\\h2/x").host, "h1", "ws/wss are special schemes too");
// a forward slash already terminated the authority (regression guard)
eq(url.parse("http://evil.com/@google.com").host, "evil.com", "forward slash still wins");
// non-special (custom) scheme: backslash is NOT special -> last-@ userinfo split
eq(url.parse("customx://evil.com\\@google.com/").host, "google.com",
   "non-special scheme keeps literal backslash (no WHATWG rule)");

// ── is_special_scheme ─────────────────────────────────────────────────────────
truthy(url.is_special_scheme("https"), "https is special");
truthy(url.is_special_scheme("WS"), "scheme check is case-insensitive");
falsy(url.is_special_scheme("customx"), "custom scheme is not special");

// ── strip_credentials ─────────────────────────────────────────────────────────
eq(url.strip_credentials("http://user:pass@h.com/p?q=1#f"), "http://h.com/p?q=1#f",
   "userinfo removed, everything else preserved");
eq(url.strip_credentials("https://h.com/x"), "https://h.com/x", "no-op when no credentials");

// ── same_origin (scheme + host + effective port) ──────────────────────────────
truthy(url.same_origin("https://x.com", "https://x.com:443/other?a=1"),
       "explicit default port == implicit");
truthy(url.same_origin("http://x.com/a", "http://x.com/b"), "path differs, same origin");
falsy(url.same_origin("http://x.com", "https://x.com"), "scheme differs");
falsy(url.same_origin("https://x.com", "https://y.com"), "host differs");
falsy(url.same_origin("https://x.com:8443", "https://x.com"), "explicit non-default port differs");
truthy(url.same_origin("https://X.com", "https://x.com"), "host compare is case-insensitive");

// ── origin serialization hardened (lowercase host, drop default port) ─────────
eq(url.origin("https://User:pw@Host.com:443/p?q"), "https://host.com",
   "origin lowercases the host and drops the default port");
eq(url.origin("http://h.com:8080/a"), "http://h.com:8080", "non-default port kept");

print "url_security_pass";
