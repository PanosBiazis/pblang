// tests/semantics/selfhost_tokenizer_unicode_test.sapp
//
// Parity: the SELF-HOSTED tokenizer (stdlib/compiler/tokenizer.sapp) must accept
// Unicode-letter identifiers, matching the Rust lexer (parser.rs uident). Without
// this the self-hosted compiler would reject café/変数/αβγ that `pblang run`
// accepts — a Rust<->pblang drift. Policy mirrors stdlib/unicode_ident.sapp.

let tok = import("stdlib/compiler/tokenizer.sapp");

fn fail(m) { throw "FAIL " + m; }
fn has_ident(ts, name) {
    for t in ts { if t.kind == "ident" and t.text == name { return true; } }
    return false;
}

let ts = tok.tokenize("let café = 1;");
if not has_ident(ts, "café") { fail("café must tokenize as a single ident"); }

let ts2 = tok.tokenize("let 変数 = αβγ;");
if not has_ident(ts2, "変数") { fail("CJK 変数 must be one ident"); }
if not has_ident(ts2, "αβγ") { fail("Greek αβγ must be one ident"); }

// digits valid in continue position
let ts3 = tok.tokenize("let café9 = 2;");
if not has_ident(ts3, "café9") { fail("café9 (letter+digit) must be one ident"); }

// ASCII still tokenizes correctly
let ts4 = tok.tokenize("let x = add(a, b);");
if not has_ident(ts4, "x") { fail("ascii ident x"); }
if not has_ident(ts4, "add") { fail("ascii ident add"); }

// keyword still recognized as keyword, not ident
let ts5 = tok.tokenize("let y = 1;");
let saw_let_kw = false;
for t in ts5 { if t.kind == "keyword" and t.text == "let" { saw_let_kw = true; } }
if not saw_let_kw { fail("'let' must remain a keyword"); }

print "selfhost_tokenizer_unicode_pass";
