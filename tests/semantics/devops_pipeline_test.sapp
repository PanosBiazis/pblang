let Ops=import("stdlib:devops_pipeline.sapp");
let jobs=[map{id:"build",needs:[]},map{id:"test",needs:["build"]},
    map{id:"deploy",needs:["test"]},map{id:"docs",needs:[]}];
let seen=[];
let runner=fn(id){array_push(seen,id);return map{ok:id!="test"};};
let result=Ops.run(jobs,runner,true);
assert(not result.ok and result.callbacks_invoked==3,"failed test skips deployment, independent job continues");
assert(str_join(seen,",")=="build,docs,test","stable topological callback order");
assert(result.jobs[3].status=="skipped","dependent deployment skipped");
assert(not result.hard_timeout_enforced and not result.rollback_performed,"no fictitious runtime guarantees");
fn blocked(value) {
    let calls=0;
    let rejected=try {Ops.run(value,fn(id){calls=calls+1;return map{ok:true};},true);false} catch true;
    assert(rejected and calls==0,"whole graph validated before callbacks");
}
blocked([map{id:"a",needs:["b"]},map{id:"b",needs:["a"]}]);
blocked([map{id:"a",needs:["missing"]}]);
blocked([map{id:"a",needs:[]},map{id:"a",needs:[]}]);
blocked([map{id:"a",needs:[],command:"untrusted"}]);
blocked([map{id:"a",needs:[]},map{id:"b",needs:["a","a"]}]);
blocked([]); blocked(nil);
let many=[]; for i in range(0,33) {array_push(many,map{id:"job_"+str(i),needs:[]});} blocked(many);
let denied=try Ops.run(jobs,runner) catch nil;
assert(denied==nil and len(seen)==3,"callbacks disabled by default");
let forged=Ops.run([map{id:"a",needs:[]}],fn(id){return map{ok:"true"};},true);
assert(not forged.ok,"truthy non-boolean result is not success");
let secret=Ops.run([map{id:"a",needs:[]}],fn(id){throw "synthetic-sensitive-message";},true);
assert(not secret.ok and not str_contains(json_stringify(secret),"synthetic-sensitive-message"),"exceptions do not leak job output");
let mutated=[map{id:"a",needs:[]},map{id:"b",needs:["a"]}];
let safe=Ops.run(mutated,fn(id){mutated[1].needs=["missing"];return map{ok:true};},true);
assert(safe.ok and safe.callbacks_invoked==2,"callbacks cannot mutate the prepared dependency snapshot");
print "devops_pipeline_pass";
