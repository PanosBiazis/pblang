// Literal grammar and diagnostic propagation; submitted programs have no host effects.
let T=import("stdlib:compiler/tokenizer.sapp");
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let P=import("stdlib:compiler/parser.sapp");
let Check=import("editors/ide/pbide_source_check.sapp");
let Preview=import("editors/ide/pbide_source_highlight.sapp");
let malformed=["0x","0X","-0b","0B","0o","0O","0b2","0b102","0o8","0o78",
    "0xG","0x1private_canary","0xπ","1e","1.e+","1E+","-2.5e-","1e+private_canary"];
for literal in malformed {
    let source="let x="+literal+";";
    let tokens=T.tokenize(source,true); let invalid=nil;
    for t in tokens { if t.kind=="invalid" { invalid=t; } }
    assert(invalid!=nil and invalid.text=="invalid number literal" and invalid.line==1 and invalid.col==7,
        "invalid number has a fixed diagnostic and physical position");
    assert(not str_contains(json_stringify(tokens),"private_canary"),"invalid numeric spelling not copied into token diagnostics");
    let bounded=T.tokenize_bounded(source,len(tokens),true);
    assert(bounded.ok and json_stringify(bounded.tokens)==json_stringify(tokens),"bounded token schema parity");
    assert(not T.tokenize_bounded(source,len(tokens)-1,true).ok,"invalid token counts toward allocation cap");
    assert(len(P.parse(tokens).errors)>0,"raw parser cannot treat invalid number as zero");
    let parsed=F.frontend_parse_safe(source);
    assert(not parsed.ok and parsed.reason=="parser_reported_errors","safe parser reports instead of throwing");
    let compiled=F.frontend_compile(source);
    assert(not compiled.ok and len(compiled.chunk.instructions)==0,"malformed source never reaches codegen");
    let guarded=F.frontend_compile_with_guard_prep(source);
    assert(not guarded.ok and len(guarded.chunk.instructions)==0 and guarded.preprocess_stats.source==source,
        "preprocessing cannot rewrite away the lexical failure");
    assert(not F.frontend_lint(source).ok and not Check.check(source).ok,"lint and PBIDE Check reject consistently");
    let run=F.frontend_run_bounded(source);
    assert(not run.ok and len(run.output)==0,"run returns a compilation failure without execution");
    assert(not str_contains(json_stringify(compiled.diagnostics),"private_canary"),"fixed diagnostics do not echo malformed suffix");
}
let cases=[map{literal:"0xFF",value:255},map{literal:"0Xff",value:255},map{literal:"-0xF",value:-15},
    map{literal:"0b1010",value:10},map{literal:"0B11",value:3},map{literal:"-0o17",value:-15},
    map{literal:"0O10",value:8},map{literal:"0",value:0},map{literal:"42",value:42},
    map{literal:"3.5",value:3.5},map{literal:"1e2",value:100},map{literal:"1E+2",value:100},
    map{literal:"-2.5e-1",value:-0.25},map{literal:"1e0",value:1}];
for entry in cases {
    let r=F.frontend_run("let x="+entry.literal+";");
    assert(r.ok and r.globals.x==entry.value,"valid radix/decimal/exponent value preserved");
}
let positioned=T.tokenize("\"😀\";\n  0b102 /* gap */ + 7;",true);
assert(positioned[2].kind=="invalid" and positioned[2].line==2 and positioned[2].col==3,
    "invalid span starts at original Unicode source position");
assert(positioned[3].kind=="comment" and positioned[3].col==9 and positioned[4].text=="+",
    "invalid radix scan preserves following comment and operator");
let inert="let s=\"0x 1e+\"; /* 0b2 */ // 0o8\n";
assert(F.frontend_lint(inert).ok,"numeric-looking strings/comments remain inert");
let rendered=Preview.render("let x=0b102;");
assert(not rendered.highlighted and str_contains(rendered.html,"let x=0b102;"),"preview falls back to exact original source");
let mixed=F.frontend_compile_many(["let a=1;","let b=0x;","let c=2;"]);
assert(mixed[0].ok and not mixed[1].ok and mixed[2].ok,"batch preserves results around rejected source");
let legacy="let result=match 1 { case n if n>0 ~ 0x; else: 0; };";
let guarded=F.frontend_compile_with_guard_prep(legacy);
assert(not guarded.ok and not guarded.preprocess_stats.changed and len(guarded.chunk.instructions)==0,
    "legacy match rewrite cannot erase invalid numbers");
let path="tests/fixtures/frontend_lexical/invalid_number.txt";
let file=F.frontend_compile_file(path);
assert(not file.ok and len(file.chunk.instructions)==0 and file.symbol_table==nil,"file compilation has no code or semantic table");
assert(not F.frontend_analyze_file(path).ok and not F.frontend_run_file(path).ok,"file analysis and execution reject");
let CLI=import("stdlib:compiler/selfhost_cli.sapp");
let serialized=CLI.compile_source("let x=0x;");
assert(not serialized.ok and not map_has(serialized,"bytes"),"CLI emits no serialized artifact");
print "selfhost_numeric_literals_pass";
