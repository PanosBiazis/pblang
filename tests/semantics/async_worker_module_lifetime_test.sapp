// The temporary child must not retain an unused launcher closure -> module cycle.
// Declare the probe name for checking; the worker resolves its copied module binding.
let launch:any=nil;
let W=import("stdlib:async_worker.sapp");
fn run(work) {
    let f=W.launch(work);
    let msg=recv(f.channel.receiver);
    join(f.worker);channel_close(f.channel.sender);
    return msg;
}
for i 3 {
    let message=run(fn(){return type(launch);});
    assert(message.ok and message.value=="builtin","unused child launcher binding released");
    assert(type(W.launch)=="closure","parent launcher remains callable");
    let captured=i;fn close_value(v){return fn(){return v;};}
    assert(run(close_value(captured)).value==i,"closed captures preserved");
}
// Imported modules in the child keep their own launcher, supporting nesting.
let nested=run(fn(){let A=import("stdlib:async.sapp");return A.await(A.go(fn(){return 17;}));});
assert(nested.ok and nested.value==17,"nested worker imports remain usable");
assert(not run(fn(){throw "test failure";}).ok,"exception envelope preserved");
assert(not run(fn(){return fn(){return 1;};}).ok,"transfer failure envelope preserved");
assert(run(fn(){return false;}).value==false,"parent remains reusable after failures");
print "async_worker_module_lifetime_pass";
