let S=import("stdlib:set.sapp");let Old=import("../../bench/fixtures/set_before_queries.sapp");
fn eq(a,b,label){assert(a==b,label+" actual="+str(a)+" expected="+str(b));}
fn rejected(f){let result=try f() catch "error";eq(result,"error","rejected input");}
let cases=0;
// Independently count overlap from bit membership in a five-element universe.
for left 32 {for right 32 {
 let a=S.new();let b=S.new();let common=0;let na=0;let nb=0;let weight=1;
 for i 5 {let ina=num_floor(left/weight)%2==1;let inb=num_floor(right/weight)%2==1;
  if ina {S.add(a,i);na=na+1;}if inb {S.add(b,i);nb=nb+1;}if ina and inb {common=common+1;}weight=weight*2;
 }
 eq(S.intersection_size(a,b),common,"independent intersection count");
 eq(S.is_subset(a,b),common==na,"subset oracle");
 eq(S.is_proper_subset(a,b),common==na and na<nb,"proper subset oracle");
 eq(S.is_proper_superset(a,b),common==nb and nb<na,"proper superset oracle");
 eq(S.size(S.intersection(a,b)),common,"intersection result agreement");
 let calls=0;let parts=S.partition(a,fn(v){calls=calls+1;return v%2==0;});
 eq(calls,na,"one callback per member");eq(S.size(parts.matched)+S.size(parts.rejected),na,"partition coverage");
 for v in S.to_array(parts.matched) {assert(v%2==0,"matched partition");}
 for v in S.to_array(parts.rejected) {assert(v%2!=0,"rejected partition");}
 eq(S.equals(S.union(parts.matched,parts.rejected),a),true,"partition union");
 eq(S.is_disjoint(parts.matched,parts.rejected),true,"partition disjoint");cases=cases+1;
}}
// Keep the legacy string-key contract, including replacement and nil presence.
let collision=S.from_array([1,"1",true,"true",nil]);eq(S.size(collision),3,"legacy key identity");
eq(S.has(collision,1),true,"numeric key alias");eq(S.has(collision,"1"),true,"text key alias");
let cp=S.partition(collision,fn(v){return v==nil;});eq(S.has(cp.matched,nil),true,"nil in partition");eq(S.to_array(cp.rejected),["1","true"],"legacy representatives preserved");
let payload=map{x:1};let source=S.from_array([payload]);let parts=S.partition(source,fn(v){return true;});
payload.x=2;eq(S.to_array(parts.matched)[0].x,2,"borrowed payload identity");S.clear(parts.matched);eq(S.size(source),1,"independent output slots");

// Snapshot keys, live membership: removed future keys are skipped, new keys deferred.
for call in [S.map,S.filter,S.each,S.retain] {
 let s=S.from_array([1,2,3]);let seen=[];
 call(s,fn(v){push(seen,v);if v==1 {S.remove(s,2);S.add(s,4);}return true;});
 eq(seen,[1,3],"callback removal/addition semantics");
 let clear=S.from_array([1,2,3]);let count=0;
 call(clear,fn(v){count=count+1;S.clear(clear);return true;});eq(count,1,"clear skips remaining keys");
 let failing=S.from_array([1,2]);let errors=map{n:0};
 let callback=fn(v){errors.n=errors.n+1;throw "callback";};
 let failure=try call(failing,callback) catch "error";eq(failure,"error","callback error propagated");eq(errors.n,1,"errors stop callbacks");
}
let replacement=S.from_array([1,2,3]);let replaced=[];
S.each(replacement,fn(v){push(replaced,v);if v==1 {S.add(replacement,"2");}});
eq(replaced,[1,"2",3],"replacement of an existing key is observed");
let retain_key=S.from_array([1]);S.retain(retain_key,fn(v){S.add(retain_key,"1");return false;});
eq(S.size(retain_key),0,"retain false removes the key after callback");
let mutation=S.from_array([1,2,3]);let visited=[];
let split=S.partition(mutation,fn(v){push(visited,v);if v==1 {S.remove(mutation,2);S.add(mutation,4);}return v==1;});
eq(visited,[1,3],"partition mutation semantics");eq(S.to_array(split.matched),[1],"partition matched snapshot");eq(S.to_array(split.rejected),[3],"partition rejected snapshot");
let emptycalls=0;S.partition(S.new(),fn(v){emptycalls=emptycalls+1;return true;});eq(emptycalls,0,"empty partition");
let pf=map{n:0};rejected(fn(){return S.partition(S.from_array([1,2]),fn(v){pf.n=pf.n+1;throw "callback";});});eq(pf.n,1,"partition propagates error immediately");
for call in [Old.map,Old.filter,Old.each,Old.retain] {
 let before=Old.from_array([1,2]);let failed=try call(before,fn(v){Old.clear(before);return true;}) catch "old failure";
 eq(failed,"old failure","old callback invalidation reproduced");
}
let maximum=S.new();for i 65536 {S.add(maximum,i);}
eq(S.intersection_size(maximum,maximum),65536,"max intersection scan");let maxcalls=0;
let maxparts=S.partition(maximum,fn(v){maxcalls=maxcalls+1;return false;});eq(maxcalls,65536,"max partition scan");eq(S.size(maxparts.rejected),65536,"max partition size");
S.add(maximum,65536);let forbidden=0;
rejected(fn(){return S.partition(maximum,fn(v){forbidden=forbidden+1;return true;});});eq(forbidden,0,"limit before callbacks");
rejected(fn(){return S.intersection_size(maximum,maximum);});eq(S.intersection_size(maximum,S.from_array([1])),1,"small scan against large set");
print "set_queries_pass cases="+str(cases);
