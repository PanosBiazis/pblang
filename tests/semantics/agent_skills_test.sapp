let SKILLS = import("stdlib:agent_skills.sapp");

fn expect(condition, message) {
    if not condition { throw "FAIL agent_skills: " + message; }
}

fn rejects(work, message) {
    if not (try { work(); false } catch true) { throw "FAIL agent_skills: " + message; }
}

let portable = "---\nname: safe-review\ndescription: Review bounded source changes\nlicense: MIT\nmetadata:\n  audience: developers\n---\n\nRead the owning module and run focused tests.";
let parsed = SKILLS.parse_document(portable, "safe-review");
expect(parsed.valid and parsed.name == "safe-review" and parsed.body_chars > 10
    and parsed.metadata.audience == "developers", "portable document did not parse");

let compatibility = SKILLS.compatibility_matrix(portable, "safe-review");
expect(compatibility.valid and len(compatibility.platforms) == 4
    and compatibility.platforms[0].lossless
    and compatibility.platforms[2].loads, "portable compatibility matrix is wrong");

let claude = "---\nname: deploy-check\ndescription: Check a deployment\ndisable-model-invocation: true\nallowed-tools: Bash(git status *)\ncontext: fork\n---\n\n!`git status`\nReview credentials before deployment.";
let review = SKILLS.security_review(claude, "deploy-check");
expect(review.risk == "high" and review.high >= 2 and review.medium >= 1
    and not review.safe_to_auto_load and review.analysis == "bounded-pattern"
    and not review.semantic_complete, "effectful skill was not flagged");
let matrix = SKILLS.compatibility_matrix(claude, "deploy-check");
expect(matrix.platforms[2].lossless and not matrix.platforms[3].lossless
    and len(matrix.platforms[3].ignored_fields) == 3,
    "vendor-only fields were not reported as lossy");

let bundle = SKILLS.bundle_generate(map{
    name: "portable-review", description: "Review a change safely",
    compatibility: "Codex, Claude Code, and OpenCode",
    metadata: map{ owner: "local" }
}, "Inspect the relevant files.\nDo not expose credentials.", ["codex", "claude-code", "opencode"]);
expect(bundle.file_count == 3 and bundle.writes_performed == 0
    and str_contains(bundle.files[0].content, "name: \"portable-review\"")
    and str_contains(bundle.files[0].path, "$CODEX_HOME/skills/")
    and str_contains(bundle.files[2].path, ".opencode/skills/"),
    "portable bundle generation failed");

let invalid_name = SKILLS.parse_document("---\nname: Bad--Name\ndescription: bad\n---\nbody", "Bad--Name");
expect(not invalid_name.valid and len(invalid_name.errors) >= 1,
    "invalid skill name was accepted");
let missing_close = SKILLS.parse_document("---\nname: missing\ndescription: missing\nbody", "");
expect(map_has(missing_close, "valid") and not missing_close.valid,
    "unterminated frontmatter was accepted");
rejects(fn() { SKILLS.parse_document("", ""); }, "empty document was accepted");
rejects(fn() { SKILLS.bundle_generate(map{ name: "x", description: "x" }, "body", ["unknown"]); },
    "unknown bundle target was accepted");

print "agent_skills_pass";
