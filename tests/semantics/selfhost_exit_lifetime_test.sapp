let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let P=import("stdlib:selfhost_pbck.sapp");
fn check(ok,label){if not ok {throw "FAIL exit-lifetime: "+label;}}
fn chunk(source){let c=F.frontend_compile(source);check(c.ok,"compile "+str(c.diagnostics));return c.chunk;}
fn run(source,want){
    let c=chunk(source);
    let a=V.run(c);
    let b=F.frontend_run(source);
    let d=V.run(P.deserialize_chunk(P.serialize_chunk(c)));
    check(a.globals.result==want and b.globals.result==want and d.globals.result==want,"result parity");
}
// An uncaught explicit throw clears an externally inspectable frame.
let c=chunk("if true {let a=[1,2];let b=map{n:3};throw a;}");
let frame=[];
let failed=try (if true {V.exec(c,frame,map{},[],[]);false;} else {false;}) catch true;
check(failed and len(frame)==2 and frame[0]==nil and frame[1]==nil,"uncaught local cleanup");
// Serialization keeps cleanup instructions; skipped declarations add no slots.
frame=[];
c=chunk("if true {throw 1;let never=[9];}");
failed=try V.exec(P.deserialize_chunk(P.serialize_chunk(c)),frame,map{},[],[]) catch true;
check(failed==true and len(frame)==0,"unreached declarations");
// An escaped closure and global alias survive a failed owning block.
let globals=map{};
frame=[];
c=chunk("let saved=fn(){return [0];};let alias=[0];if true {let a=[7];alias=a;saved=fn(){return a;};let b=[8];throw b;}");
failed=try V.exec(c,frame,globals,[],[]) catch true;
check(failed==true and frame[0]==[7] and frame[1]==nil and globals.alias==[7],"capture and alias retained");
let defined=V.run(chunk("fn f(x){let a=[2];return x;}"));
let fnvalue=defined.globals.f;
let argument=[5];
frame=[argument];
let returned=V.exec(fnvalue.__fn.chunk,frame,fnvalue.__globals,[],fnvalue.__upvalues);
check(returned==[5] and argument==[5] and frame[0]==nil and frame[1]==nil,"return clears frame and preserves payload");
run("fn f(x){let a=[1];return x;}let result=f([8]);",[8]);
run("fn f(){let a=[9];return fn(){return a;};}let g=f();let result=g();",[9]);
run("fn f(x){let a=[2];let r=try (if true {let b=[3];throw b;} else {[];}) catch x;return [a,r];}let result=f([7]);",[[2],[7]]);
run("fn f(x){let r=try (if true {let a=[1];throw a;} else {[];}) catch (if true {let b=[2];return x;} else {[];});return [x,r];}let result=f([7]);",[[7],[7]]);
run("fn f(x){let r=try (try (if true {let a=[1];throw a;} else {[];}) catch (if true {let b=[2];throw b;} else {[];})) catch x;return r;}let result=f([6]);",[6]);
run("let count=0;fn payload(){count=count+1;return [count];}fn f(){let a=[2];return payload();}let result=[f(),count];",[[1],1]);
// A capture found after an earlier exit patches that exit's cleanup too.
run("fn f(x){let a=[4];if x {return a;}return fn(){return a;};}let g=f(false);let result=[f(true),g()];",[[4],[4]]);
print "selfhost_exit_lifetime_pass";
