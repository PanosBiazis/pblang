let L=import("stdlib:uno_r4_led_matrix.sapp");
fn denied(f) {return try {f();false;} catch true;}
let empty=L.blank();assert(len(empty)==96 and L.pack(empty)==[0,0,0],"blank frame");
assert(L.pack(L.blank(1))==[4294967295,4294967295,4294967295],"unsigned high bits stay exact");
for i 96 {
    let p=L.blank();p[i]=1;let packed=L.pack(p);let expected=[0,0,0];expected[num_floor(i/32)]=num_pow(2,31-i%32);
    assert(packed==expected and L.unpack(packed)==p,"all 96 independent MSB-first positions");
}
let corner=L.pixel(empty,11,7,1);assert(corner[95]==1 and empty[95]==0,"detached coordinates");
// Independent Arduino gallery fixture, decoded as literal row strings.
let rows=["001100011000","010010100100","010001000100","010000000100","001000001000","000100010000","000010100000","000001000000"];
let heart=[];for row in rows {for i 12 {push(heart,if row[i]=="1" {1} else {0});}}
assert(L.pack(heart)==[830776388,1141121153,269090880],"Arduino LEDMATRIX_HEART_BIG fixture");
let doc=L.animation([map{pixels:empty,duration_ms:50},map{pixels:corner,duration_ms:100}]);
assert(doc.total_ms==150 and L.arduino_sequence(doc)==[[0,0,0,50],[0,0,1,100]],"stable sequence and duration order");
assert(L.decode(L.encode(doc))==doc,"validated document roundtrip");
assert(L.sample(doc,49).index==0 and L.sample(doc,50).index==1 and not L.sample(doc,149).finished and L.sample(doc,150).finished,"exact playback boundaries");
doc.frames[0].pixels[0]=1;assert(empty[0]==0,"caller arrays detached");
for invalid in [[],[0],nil,true,"0",[0,0,0,0]] {assert(denied(fn(){L.frame(invalid);}),"malformed frame");}
for invalid in [true,false,"1",-1,2,0.5,nil] {let p=L.blank();p[0]=invalid;assert(denied(fn(){L.frame(p);}),"strict binary pixels");}
for words in [[-1,0,0],[4294967296,0,0],[0.5,0,0],[true,0,0],[0,0]] {assert(denied(fn(){L.unpack(words);}),"strict uint32 input");}
assert(denied(fn(){L.pixel(empty,12,0,1);}) and denied(fn(){L.pixel(empty,0,-1,1);}),"coordinates bounded");
for ms in [0,49,5001,0.5,"100",true] {assert(denied(fn(){L.animation([map{pixels:empty,duration_ms:ms}]);}),"durations bounded");}
assert(denied(fn(){L.animation([]);}),"empty animation rejected");
let many=[];for _i 65 {push(many,map{pixels:empty,duration_ms:50});}assert(denied(fn(){L.animation(many);}),"frame budget");
let slow=[];for _i 13 {push(slow,map{pixels:empty,duration_ms:5000});}assert(denied(fn(){L.animation(slow);}),"cumulative time budget");
let extra=map{pixels:empty,duration_ms:100,code:"ignored"};assert(denied(fn(){L.animation([extra]);}),"unknown record keys rejected");
assert(denied(fn(){L.decode(str_repeat(" ",65537));}) and denied(fn(){L.decode("{}");}),"bounded malformed import");
let text=L.text_animation("PB",100);assert(len(text.frames)==25 and text.total_ms==2500,"bounded scrolling text");
assert(text.frames[0].pixels==empty and text.frames[24].pixels==empty,"text enters and leaves viewport");
assert(len(L.text_animation("πΩ",100).frames)==25,"existing Greek subset reused");
for s in ["","123456789","漢","ά"] {assert(denied(fn(){L.text_animation(s);}),"unsupported text never silently replaced");}
print "uno_r4_led_matrix_pass";
