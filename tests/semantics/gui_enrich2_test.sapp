// tests/semantics/gui_enrich2_test.sapp — wave 2 for stdlib/gui.sapp
// New widgets (divider, spacer, textarea) + form helpers (has_widget, set_prop, widget_kinds).

let G = import("stdlib/gui.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn contains(arr, v) { let i = 0; while i < len(arr) { if arr[i] == v { return true; } i = i + 1; } return false; }

// ── new widgets carry their kind/name ─────────────────────────────────────────────
eq(G.divider("d1", 0, 10, 200).kind, "divider", "divider kind");
eq(G.spacer("s1", 0, 0, 50, 20).kind, "spacer", "spacer kind");
let ta = G.textarea("notes", 0, 0, 100, 60, "hi");
eq(ta.kind, "textarea", "textarea kind");
eq(ta.value, "hi", "textarea value");

// ── form integration ────────────────────────────────────────────────────────────
let f = G.form("T", 300, 200);
G.add(f, G.label("title", 0, 0, "Hello"));
G.add(f, G.divider("div", 0, 20, 280));
G.add(f, G.textarea("body", 0, 30, 280, 100, ""));

// has_widget
if not G.has_widget(f, "title") { fail("has title"); }
if G.has_widget(f, "ghost") { fail("no ghost"); }

// set_prop mutates an existing widget, returns true; false on missing
if not G.set_prop(f, "body", "value", "edited") { fail("set_prop returns true"); }
eq(G.get(f, "body").value, "edited", "set_prop applied");
if G.set_prop(f, "ghost", "value", "x") { fail("set_prop on missing -> false"); }

// widget_kinds: distinct kinds present
let kinds = G.widget_kinds(f);
if not contains(kinds, "label") { fail("kinds has label"); }
if not contains(kinds, "divider") { fail("kinds has divider"); }
if not contains(kinds, "textarea") { fail("kinds has textarea"); }
eq(len(kinds), 3, "three distinct kinds");

// Responsive layout selection and callback are deterministic at all supported sizes.
let layout_calls = map{ n: 0 };
fn on_layout(form, profile) {
    layout_calls.n = layout_calls.n + 1;
    let body = G.get(form, "body");
    body.x = profile.padding;
    body.y = profile.padding + 30;
    body.w = profile.content_width;
    body.h = profile.content_height - 30;
}
G.set_layout(f, on_layout);
let phone = G.relayout(f, 360, 640);
eq(phone.orientation, "portrait", "phone layout is portrait");
eq(phone.columns, 1, "phone uses one column");
eq(G.get(f, "body").w, phone.content_width, "layout callback fills compact width");
let desktop = G.relayout(f, 1920, 1080);
eq(desktop.orientation, "landscape", "desktop layout is landscape");
eq(desktop.columns, 2, "wide desktop uses two columns");
eq(layout_calls.n, 2, "each relayout invokes callback once");

// DPI-aware scaling is discrete and opt-in. Logical layout callbacks retain
// stable coordinates while GUI converts the final geometry to device pixels.
let laptop_profile = G.layout_profile(1366, 768, map{ auto_scale: true });
eq(laptop_profile.ui_scale, 1, "laptop resolution keeps 1x density");
eq(laptop_profile.breakpoint, "large", "laptop width receives large layout breakpoint");
let four_k_profile = G.layout_profile(3840, 2160, map{ auto_scale: true });
eq(four_k_profile.ui_scale, 2, "4K display selects bounded 2x density");
eq(four_k_profile.logical_width, 1920, "4K layout retains 1920 logical columns");
eq(four_k_profile.font_pixel_scale, 4, "4K text doubles the base bitmap scale");
let eight_k_profile = G.layout_profile(7680, 4320, map{ auto_scale: true });
eq(eight_k_profile.ui_scale, 3, "8K-class display selects bounded 3x density");
eq(eight_k_profile.logical_width, 2560, "8K-class layout remains bounded");
let explicit_profile = G.layout_profile(1280, 720,
    map{ auto_scale: true, ui_scale: 2 });
eq(explicit_profile.ui_scale, 2, "explicit density overrides resolution fallback");
eq(explicit_profile.scale_source, "explicit", "explicit density source is visible");

let scaled_form = G.form("Scaled", 3840, 2160);
let scaled_calls = map{ width: 0, height: 0 };
G.add(scaled_form, G.button("scaled_action", 0, 0, 10, 10, "Action", nil));
G.set_layout(scaled_form, fn(form, profile) {
    scaled_calls.width = profile.width; scaled_calls.height = profile.height;
    let action = G.get(form, "scaled_action");
    action.x = 20; action.y = 30; action.w = 200; action.h = profile.control_height;
}, map{ auto_scale: true, logical_layout: true });
let scaled_profile = G.relayout(scaled_form, 3840, 2160);
eq(scaled_calls.width, 1920, "logical callback receives 4K-independent width");
eq(scaled_calls.height, 1080, "logical callback receives 4K-independent height");
eq(G.get(scaled_form, "scaled_action").x, 40,
    "logical x coordinate converts to physical pixels");
eq(G.get(scaled_form, "scaled_action").h, 56,
    "logical control height converts to a 4K touch target");
eq(scaled_profile.minimum_target, 88, "physical target size tracks 2x density");

// Native graphics backends emit this record after resizing their live
// framebuffer. GUI consumes it once and preserves explicit layout options.
let resize_calls = map{ n: 0 };
G.set_layout_options(f, map{ density: "compact" });
G.set_resize_handler(f, fn(form, profile) { resize_calls.n = resize_calls.n + 1; });
G.handle_event(f, map{ type: "resize", w: 412, h: 915 });
eq(f.w, 412, "resize event updates form width");
eq(f.h, 915, "resize event updates form height");
eq(f.viewport.orientation, "portrait", "resize event updates viewport profile");
eq(f.viewport.density, "compact", "resize event preserves layout options");
eq(f.resize_count, 1, "real size change counted once");
eq(resize_calls.n, 1, "resize handler called once");
G.handle_event(f, map{ type: "resize", w: 412, h: 915 });
eq(f.resize_count, 1, "duplicate resize is idempotent");
G.handle_event(f, map{ type: "resize", w: 0, h: 915 });
eq(f.resize_count, 1, "invalid resize is ignored");

// Background work is integrated through a deterministic, non-blocking poll
// callback. The GUI controls when it runs and redraws only after real changes.
let tick_calls = map{ n: 0 };
G.set_tick_handler(f, fn(form) {
    tick_calls.n = tick_calls.n + 1;
    return tick_calls.n == 1;
}, 25);
if not G.poll_tick(f, 1000) { fail("first due tick reports a change"); }
eq(tick_calls.n, 1, "due tick runs once");
if G.poll_tick(f, 1024) { fail("early tick must not run"); }
eq(tick_calls.n, 1, "early poll does not invoke handler");
if G.poll_tick(f, 1025) { fail("second tick reports no model change"); }
eq(tick_calls.n, 2, "next due tick runs");
G.set_tick_handler(f, nil);
if G.poll_tick(f, 2000) { fail("disabled tick must not run"); }
let bad_tick = try { G.set_tick_handler(f, fn(form) { return false; }, 1); false } catch true;
G.set_tick_handler(f, fn(form) { return false; }, 25);
if G.poll_tick(f) { fail("implicit runtime-clock tick reports no model change"); }
let fractional_tick = try { G.poll_tick(f, 2000.5); false } catch true;
if not fractional_tick { fail("explicit fractional tick time must remain rejected"); }
G.set_tick_handler(f, nil);
if not bad_tick { fail("unsafe tick interval rejected"); }

// Text widgets now have explicit memory limits and multi-line binding support.
eq(G.textbox("limited", 0, 0, 100, 20, "").max_chars, 4096, "textbox has bounded input");
eq(G.textarea("bounded", 0, 0, 100, 60, "").max_chars, 65536, "textarea has bounded input");

let hidden = G.button("hidden", 10, 10, 100, 30, "Hidden", nil);
G.add(f, hidden);
if not G.set_visible(f, "hidden", false) { fail("hide existing widget"); }
if G.hit_test(f, 20, 20) == hidden { fail("hidden widget must not receive input"); }
let read_only = G.textarea("log", 0, 0, 200, 80, "audit");
read_only.readonly = true;
G.add(f, read_only);
f.focus = "log";
G.handle_event(f, map{ type: "keydown", key: "A" });
eq(read_only.value, "audit", "readonly textarea rejects keyboard edits");

print "gui_enrich2_pass";
