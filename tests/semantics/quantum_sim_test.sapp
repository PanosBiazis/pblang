// tests/semantics/quantum_sim_test.sapp
// Run with: sapphire run tests/semantics/quantum_sim_test.sapp (from project root)

let sim = import("stdlib:quantum_sim.sapp");

// Test 1: |0> state — measure must always return 0
let s0 = sim.zero_state(1);
let m0 = sim.measure(s0, 0);
print m0;

// Test 2: X gate flips |0> to |1> — measure must always return 1
let s1 = sim.zero_state(1);
s1 = sim.x_gate(s1, 0);
let m1 = sim.measure(s1, 0);
print m1;

// Test 3: H gate — outcome must be 0 or 1 (superposition)
let s2 = sim.zero_state(1);
s2 = sim.h_gate(s2, 0);
let m2 = sim.measure(s2, 0);
print m2;

// Test 4: Bell state — CNOT after H on 2 qubits; both measures must agree
let s3 = sim.zero_state(2);
s3 = sim.h_gate(s3, 0);
s3 = sim.cnot_gate(s3, 0, 1);
let m3a = sim.measure(s3, 0);
let m3b = sim.measure(s3, 1);
print m3a;
print m3b;

print "quantum_sim_tests_pass";
