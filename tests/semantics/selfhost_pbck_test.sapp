// tests/semantics/selfhost_pbck_test.sapp
//
// stdlib/selfhost_pbck.sapp — a pblang-side bytecode container for the
// SELF-HOSTED compiler's chunk-maps ({instructions:[{op,operand}], constants}).
// Lets the pblang toolchain compile, PERSIST bytecode to bytes, reload, and run
// — entirely in pblang, independent of the Rust front-end. (Distinct from the
// Rust .pbck format, which uses the Rust VM's opcode numbering.)

let pbck = import("stdlib/selfhost_pbck.sapp");

fn fail(m) { throw "FAIL " + m; }
fn expect(c, m) { if not c { fail(m); } }

// A hand-built chunk-map in the self-hosted IR shape, incl. a nested function
// constant {arity, chunk, upvalues} so recursion is covered.
fn sample_chunk() {
    let inner = map{
        instructions: [ map{op: 0, operand: 0}, map{op: 19, operand: 0} ],
        constants: [ 42 ],
    };
    return map{
        instructions: [
            map{op: 0, operand: 0},    // OP_CONSTANT 0
            map{op: 1, operand: 0},    // OP_ADD
            map{op: 24, operand: 1},   // OP_CLOSURE -> const 1
            map{op: 12, operand: 0},   // OP_PRINT
        ],
        constants: [
            3.5,
            map{ arity: 2, chunk: inner, upvalues: [ map{index: 0, is_local: true} ] },
            "hello",
            true,
            nil,
        ],
    };
}

let chunk = sample_chunk();
let bytes = pbck.serialize_chunk(chunk);
expect(len(bytes) > 8, "serialized bytes present");

let restored = pbck.deserialize_chunk(bytes);

// instructions preserved
expect(len(restored.instructions) == 4, "4 instructions");
expect(restored.instructions[2].op == 24 and restored.instructions[2].operand == 1, "OP_CLOSURE op/operand");

// constants preserved (number/string/bool/nil + nested function)
expect(restored.constants[0] == 3.5, "float constant round-trips");
expect(restored.constants[2] == "hello", "string constant");
expect(restored.constants[3] == true, "bool constant");
expect(restored.constants[4] == nil, "nil constant");

let f = restored.constants[1];
expect(f.arity == 2, "function arity preserved");
expect(len(f.upvalues) == 1, "function upvalues preserved");
expect(f.upvalues[0].index == 0 and f.upvalues[0].is_local == true, "upvalue fields");
expect(len(f.chunk.instructions) == 2, "nested function chunk instructions");
expect(f.chunk.constants[0] == 42, "nested function constant");

// byte-stability: re-serializing the restored chunk yields identical bytes
let bytes2 = pbck.serialize_chunk(restored);
expect(len(bytes) == len(bytes2), "round-trip byte length stable");
let i = 0;
while i < len(bytes) {
    if bytes[i] != bytes2[i] { fail("byte mismatch at " + str(i)); }
    i = i + 1;
}

// bad magic rejected
let bad = try pbck.deserialize_chunk([1,2,3,4,5]) catch "ERR";
expect(bad == "ERR", "bad magic must throw/reject");

// ── THE milestone: self-hosted compile -> serialize -> deserialize -> run,
//    entirely in pblang, no Rust front-end. The pblang compiler produces a
//    chunk-map, we persist+reload it through this container, then the
//    self-hosted VM executes the reloaded bytecode. ──────────────────────────
let fe = import("stdlib/compiler/selfhost_frontend.sapp");
let vm = import("stdlib/compiler/vm.sapp");
let cr = fe.frontend_compile("let a = 6; let b = 7; let answer = a * b;");
expect(cr.ok, "self-hosted compile must succeed");
let blob = pbck.serialize_chunk(cr.chunk);
let chunk3 = pbck.deserialize_chunk(blob);
let res = vm.run_seeded(chunk3, map{});
expect(res.globals["answer"] == 42, "reloaded bytecode runs: 6 * 7 == 42");

print "selfhost_pbck_pass";
