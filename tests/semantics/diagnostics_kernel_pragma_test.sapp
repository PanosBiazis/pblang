// tests/semantics/diagnostics_kernel_pragma_test.sapp
//
// Kernel-aware diagnostics. stdlib/kernel modules are lowered by the
// ctranspiler whose freestanding preamble PROVIDES the OS intrinsics
// (outb/kmalloc/poke32/...), and multiple modules are concatenated into one
// translation unit (gc.sapp uses heap.sapp's heap_alloc at "link" time). The
// generic checker knows neither, so every kernel file was a false error.
//
// Opt-in pragmas keep the checker sound elsewhere:
//   // pblang:target=kernel      -> ctranspile intrinsics are defined names
//   // pblang:extern a b c       -> declared cross-unit symbols are defined
// A typo (kmaloc) must STILL be flagged even with the pragma.

let dx = import("stdlib:diagnostics.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }

fn undef_count(src) {
    let r = dx.diagnose(src);
    let n = 0;
    let i = 0;
    while i < len(r.diagnostics) {
        if r.diagnostics[i].code == "undefined-name" { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// ── 1. intrinsics allowed ONLY under the kernel pragma ───────────────────────
let body = "fn tick(p) { outb(32, 32); poke32(p, peek32(p) + 1); return kmalloc(8); }\n";
eq(undef_count("// pblang:target=kernel\n" + body), 0, "kernel pragma defines intrinsics");
if undef_count(body) < 3 { fail("without the pragma the intrinsics must stay undefined"); }

// ── 2. typos still flagged under the pragma ──────────────────────────────────
let typo = "// pblang:target=kernel\nfn f() { return kmaloc(8); }\n";
if undef_count(typo) != 1 { fail("kmaloc typo must still be an error under the pragma"); }

// ── 3. declared externs (cross-unit names) ───────────────────────────────────
let x = "// pblang:extern heap_alloc heap_free\nfn g(c) { let p = heap_alloc(c, 8); heap_free(c, p); return p; }\n";
eq(undef_count(x), 0, "declared externs are defined");
if undef_count("fn g(c) { return heap_alloc(c, 8); }\n") != 1 {
    fail("undeclared cross-unit name must stay an error");
}

print "diagnostics_kernel_pragma_pass";
