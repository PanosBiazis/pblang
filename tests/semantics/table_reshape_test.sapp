let R=import("stdlib:table_reshape.sapp");let S=import("stdlib:sheet_document.sapp");let C=import("stdlib:sheet_csv.sapp");
fn rejects(f){assert((try f() catch nil)==nil,"must reject malformed or over-budget reshape");}
let doc=C.decode("ID,A,B\n001,12,\n001,=1+1,α");let before=S.encode(doc);
let long=R.unpivot(doc,[2,1]);assert(long.cells==[["ID","Variable","Value"],["001","B",""],["001","A","12"],["001","B","α"],["001","A","=1+1"]],"stable row/selection order, repeats, literal formulas, blank and Unicode");
long.cells[1][0]="edited";assert(S.encode(doc)==before,"detached source");
assert(R.unpivot(C.decode("ID,A,B"),[1,2]).cells==[["ID","Variable","Value"]],"header-only output");
assert(R.unpivot(C.decode("ID,Region,A,B\nx,y,1,2"),[3,2]).cells==[["ID","Region","Variable","Value"],["x","y","B","2"],["x","y","A","1"]],"multiple identifiers remain ordered");
for columns in [[],[0,1,2],[1,1],[3],[-1],[1.5],["1"],nil] {rejects(fn(){R.unpivot(doc,columns);});}
for source in [C.decode("ID,A,A\nx,1,2"),C.decode("ID, ,B\nx,1,2"),C.decode("Value,A,B\nx,1,2")] {rejects(fn(){R.unpivot(source,[1,2]);});}
rejects(fn(){R.apply(doc,"pivot",[]);});rejects(fn(){R.apply(doc,"transpose",[1]);});rejects(fn(){R.transpose(S.create(9,1));});rejects(fn(){R.transpose(map{format:S.FORMAT,cells:[["x"],["y","z"]]});});
for rows in range(1,9) {for columns in range(1,9) {
 let source=S.create(rows,columns);for r in range(0,rows){for c in range(0,columns){source.cells[r][c]=str(r)+":"+str(c);}}
 let transposed=R.transpose(source);assert(len(transposed.cells)==columns and len(transposed.cells[0])==rows,"transposed dimensions");
 assert(R.transpose(transposed).cells==source.cells,"64 rectangular involution cases");transposed.cells[0][0]="changed";assert(source.cells[0][0]=="0:0","transpose detached");
}}
let max=S.create(32,2);max.cells[0]=["ID","A"];assert(len(R.unpivot(max,[1]).cells)==32,"31 expanded rows accepted");
let expanded=S.create(17,3);expanded.cells[0]=["ID","A","B"];rejects(fn(){R.unpivot(expanded,[1,2]);});
let wide=S.create(2,8);wide.cells[0]=["ID","A","B","C","D","E","F","G"];rejects(fn(){R.unpivot(wide,[7]);});
let bytes=S.create(16,3);bytes.cells[0]=["ID",str_repeat("a",256),str_repeat("b",256)];for r in range(1,16){bytes.cells[r][0]=str_repeat("α",128);}S.validate(bytes);rejects(fn(){R.unpivot(bytes,[1,2]);});
let special=map{format:S.FORMAT,cells:[["ID","Line","Quoted"],["001","first\nsecond","a,\"b\""]]};let output=R.unpivot(special,[1,2]);assert(C.decode(C.encode(output)).cells==output.cells,"CSV escaped literal roundtrip");
print "table_reshape_pass";
