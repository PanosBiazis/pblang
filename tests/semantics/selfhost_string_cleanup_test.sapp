let V=import("stdlib:compiler/vm.sapp");
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let P=import("stdlib:selfhost_pbck.sapp");
let O=import("stdlib:compiler/optimizer.sapp");
fn compiled(source){let r=F.frontend_compile(source);assert(r.ok,"fixture compile: "+str(r.diagnostics));return r.chunk;}
let setup=compiled("memory_alloc(7);push_lifetime();borrow_immutable(1);memory_alloc(9);");
fn prepare(automatic){let c=V.execution_context(automatic);V.run_seeded(setup,map{},c);return c;}
fn run(code,bounded,c){if bounded {return V.run_seeded_bounded(code,map{},nil,c);}return V.run_seeded(code,map{},c);}
let unary=["str_upper","str_lower","str_trim"];
let binary=["str_split","str_contains","str_starts_with","str_ends_with","str_index_of"];
let cases=[];
for name in unary {array_push(cases,"fn call(f,a){return f(a);}call("+name+",nil);");}
for name in binary {
 array_push(cases,"fn call(f,a,b){return f(a,b);}call("+name+",nil,\"x\");");
 array_push(cases,"fn call(f,a,b){return f(a,b);}call("+name+",\"x\",nil);");
 array_push(cases,"let obj=map{__add__:"+name+"};obj+\"x\";");
}
let handler=compiled("print memory_get(1);");
for source in cases {
 let code=compiled(source);
 for bounded in [false,true] {
  for automatic in [false,true] {
   let c=prepare(automatic);let m=c.memory;
   assert((try {run(code,bounded,c);false} catch true),"string call rejects");
   assert(m.closed==automatic,"escaping error respects ownership: "+source);
   if automatic {assert(c.memory==nil and m.reclaimed==2 and len(m.owners)==0 and len(m.borrows)==0,"all private scopes released");}
   else {assert(c.memory==m and len(m.owners)==2 and len(m.borrows)==1,"borrowed state unchanged");}
   V.close_execution(c);V.close_execution(c);assert(m.reclaimed==2,"idempotent close");
  }
  let c=prepare(true);let m=c.memory;
  let caught=map{constants:[map{try_chunk:code,catch_chunk:handler}],instructions:[map{op:35,operand:0}]};
  assert(run(caught,bounded,c).output==[7],"guest handler can use memory");
  assert(c.memory==m and not m.closed and c.handlers==0,"handler ownership restored");V.close_execution(c);
 }
}
// In particular, is_string's boxed-object classification is not string admission.
for value in [true,7,[],map{},bigint("7"),rational("1/2"),decimal("7")] {
 for name in unary {
  let code=map{constants:[map{__bi:name},value],instructions:[map{op:0,operand:0},map{op:0,operand:1},map{op:18,operand:1}]};
  let c=prepare(true);let m=c.memory;assert((try {run(code,true,c);false} catch true),"unsupported unary value");assert(m.closed and m.reclaimed==2,"unary typed failure cleanup");
 }
 for name in binary {
  for values in [[value,"x"],["x",value],[value,nil]] {
   let code=map{constants:[map{__bi:name},values[0],values[1]],instructions:[map{op:0,operand:0},map{op:0,operand:1},map{op:0,operand:2},map{op:18,operand:2}]};
   let c=prepare(true);let m=c.memory;assert((try {run(code,true,c);false} catch true),"unsupported binary value");assert(m.closed and m.reclaimed==2,"binary typed failure cleanup");
  }
 }
}
let effects=compiled("let calls=[];fn arg(n){array_push(calls,n);return nil;}fn invoke(f,a,b){return f(a,b);}invoke(str_contains,arg(1),arg(2));");
for code in [effects,O.optimize_safe(effects).chunk,P.deserialize_chunk(P.serialize_chunk(effects))] {
 for bounded in [false,true] {
  let c=prepare(true);let m=c.memory;let g=map{};let failed=false;
  if bounded {try V.run_seeded_bounded(code,g,nil,c) catch {failed=true;};}
  else {try V.run_seeded(code,g,c) catch {failed=true;};}
  assert(failed and m.closed and g.calls==[1,2],"arguments evaluated once in order");
 }
}
// Unicode, empty strings, false/not-found results and successful owners survive.
let accepted=compiled("let h=memory_alloc(11);print str_upper(\"Straße\");print str_lower(\"ΑΒ\");print str_trim(\" α😀β \");"
 +"print str_split(\"α😀\",\"\");print str_split(\"\",\",\");print str_contains(\"α😀β\",\"😀\");"
 +"print str_starts_with(\"α😀β\",\"α\");print str_ends_with(\"α😀β\",\"β\");print str_index_of(\"α😀β\",\"β\");"
 +"print str_contains(\"abc\",\"z\");print str_index_of(\"abc\",\"z\");print str_contains(\"\",\"\");print memory_get(h);");
for bounded in [false,true] {
 let c=V.execution_context(true);let result=run(accepted,bounded,c);
 assert(result.output==["STRASSE","αβ","α😀β",["α","😀"],[""],true,true,true,2,false,-1,true,11],"Unicode and valid results");
 assert(not c.memory.closed,"successful operations retain owners");V.close_execution(c);
}
for source in ["print str_trim(\" x \");memory_alloc(3);fail(str_upper,nil);",
 "memory_alloc(3);print try fail(str_upper,nil) catch 7;fail(str_lower,nil);",
 "memory_alloc(3);try fail(str_upper,nil) catch fail(str_trim,nil);"] {
 let code=compiled("fn fail(f,x){return f(x);}"+source);
 for bounded in [false,true] {let c=V.execution_context(true);assert((try {run(code,bounded,c);false} catch true),"escaping late/handler failure");assert(c.memory==nil and c.handlers==0,"late/handler state closed");}
}
let shadowed=compiled("fn str_upper(x){return x;}print str_upper(nil);");
let c=prepare(true);assert(run(shadowed,true,c).output==[nil] and not c.memory.closed,"shadowed builtin unchanged");V.close_execution(c);
print "selfhost_string_cleanup_pass";
