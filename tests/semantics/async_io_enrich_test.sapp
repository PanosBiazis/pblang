// tests/semantics/async_io_enrich_test.sapp — fix + enrichment for stdlib/async_io.sapp
//
// BUG: retry_backoff's success check was `if try result.error catch nil == nil`,
//   which parses as `try result.error catch (nil == nil)` -> catch true, so it
//   returned on the FIRST attempt even when result.error was set (never retried a
//   map-with-error). Fixed by binding the error to a variable first.
// ENRICH: resolved(v) — an already-resolved promise.

let aio = import("stdlib/async_io.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── FIX: retry_backoff actually retries a result that carries .error ─────────────
let st = map{ n: 0 };
let flaky = fn() {
    st.n = st.n + 1;
    if st.n < 3 { return map{ error: "transient" }; }
    return map{ value: 42 };
};
let r = aio.retry_backoff(flaky, 5, 1);
eq(st.n, 3, "retry_backoff retried until success (was: returned on attempt 1)");
eq(r.value, 42, "retry_backoff returned the successful result");

// retry_backoff exhausts and reports when it never succeeds
let st2 = map{ n: 0 };
let always = fn() { st2.n = st2.n + 1; return map{ error: "nope" }; };
let r2 = aio.retry_backoff(always, 3, 1);
eq(st2.n, 3, "retry_backoff tried max_retries times");
if map_has(r2, "error") == false { fail("exhausted retry should report an error"); }

// ── ENRICH: resolved() is an already-resolved promise ────────────────────────────
eq(aio.await_promise(aio.resolved(99)), 99, "resolved promise awaits to its value");
eq(aio.await_promise(aio.then(aio.resolved(5), fn(x) { return x + 1; })), 6, "then on a resolved promise");

print "async_io_enrich_pass";
