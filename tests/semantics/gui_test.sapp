// Test: desktop GUI toolkit (stdlib/gui.sapp) — Visual_Designer D3, §96.
// Exercises the window-free interactive core (hit-test, click dispatch, textbox typing,
// checkbox toggle, focus). draw/run are display-only and not exercised here. Runs in the VM.
let gui = import("stdlib/gui.sapp");

let clicks = map{ n: 0 };
let toggles = map{ n: 0 };
fn on_ok(ctx) { clicks["n"] = clicks.n + 1; }
fn on_chk(ctx) { toggles["n"] = toggles.n + 1; }

let f = gui.form("T", 360, 240);
gui.add(f, gui.label("lbl", 20, 16, "Name:"));
gui.add(f, gui.textbox("name", 20, 44, 220, 26, ""));
gui.add(f, gui.button("ok", 20, 84, 120, 30, "OK", on_ok));
gui.add(f, gui.checkbox("agree", 20, 130, "I agree", false, on_chk));
assert(gui.get(f, "ok").variant == "primary", "buttons retain the compatible primary default");
gui.set_prop(f, "ok", "variant", "secondary");
assert(gui.get(f, "ok").variant == "secondary", "semantic button variant retained");
let styled = gui.custom_palette("light", map{ selected: [8, 127, 115],
    danger: [180, 35, 24], focus: [0, 95, 204], on_accent: [255, 255, 255] });
assert(styled.selected[1] == 127 and styled.danger[0] == 180,
    "extended semantic palette roles retained");

// hit-testing
assert(gui.hit_test(f, 25, 90).name == "ok", "hit button");
assert(gui.hit_test(f, 25, 50).name == "name", "hit textbox");
assert(gui.hit_test(f, 300, 300) == nil, "miss empty space -> nil");

// Idle pointer polling does not dirty the framebuffer; state changes do.
f.dirty = false;
gui.handle_event(f, map{ type: "mousemove", x: 25, y: 90 });
assert(f.dirty == false, "idle pointer movement avoids full-frame redraw");

// clicking a button fires its handler (mousedown carries no coords -> move first)
gui.handle_event(f, map{ type: "mousedown", button: "Left" });
assert(clicks.n == 1, "button handler fired on click");
assert(f.dirty == true, "interactive state change dirties the framebuffer");

// Disabled controls remain visible but do not receive input or retain focus.
assert(gui.set_enabled(f, "ok", false), "button disabled");
gui.handle_event(f, map{ type: "mousedown", button: "Left" });
assert(clicks.n == 1, "disabled button cannot fire its handler");
assert(gui.get(f, "ok").enabled == false, "disabled state retained");
assert(gui.set_enabled(f, "ok", true), "button re-enabled");
gui.set_prop(f, "ok", "selected", true);
assert(gui.get(f, "ok").selected == true, "active visual state retained");

// focusing a textbox and typing (shift-aware; Backspace deletes)
gui.handle_event(f, map{ type: "mousemove", x: 30, y: 50 });
gui.handle_event(f, map{ type: "mousedown", button: "Left" });
assert(f.focus == "name", "textbox focused on click");
assert(gui.set_enabled(f, "name", false), "textbox disabled");
assert(f.focus == nil, "disabling focused textbox clears focus");
gui.handle_event(f, map{ type: "keydown", key: "A" });
assert(gui.get(f, "name").value == "", "disabled textbox rejects typing");
gui.set_enabled(f, "name", true);
gui.handle_event(f, map{ type: "mousedown", button: "Left" });
assert(f.focus == "name", "textbox refocused after enabling");
gui.handle_event(f, map{ type: "keydown", key: "LShift" });
gui.handle_event(f, map{ type: "keydown", key: "H" });          // shift -> "H"
gui.handle_event(f, map{ type: "keyup",   key: "LShift" });
gui.handle_event(f, map{ type: "keydown", key: "I" });          // no shift -> "i"
gui.handle_event(f, map{ type: "keydown", key: "Num1" });       // "1"
gui.handle_event(f, map{ type: "keydown", key: "Backspace" });  // removes "1"
assert(gui.get(f, "name").value == "Hi", "typed text -> 'Hi'");

// right-click is ignored (Left only)
gui.handle_event(f, map{ type: "mousemove", x: 25, y: 90 });
gui.handle_event(f, map{ type: "mousedown", button: "Right" });
assert(clicks.n == 1, "right-click does not fire handler");

// toggling a checkbox flips state and fires onchange
gui.handle_event(f, map{ type: "mousemove", x: 25, y: 135 });
gui.handle_event(f, map{ type: "mousedown", button: "Left" });
assert(gui.get(f, "agree").checked == true, "checkbox toggled on");
assert(toggles.n == 1, "checkbox onchange fired");

// clicking empty space clears focus
gui.handle_event(f, map{ type: "mousemove", x: 320, y: 220 });
gui.handle_event(f, map{ type: "mousedown", button: "Left" });
assert(f.focus == nil, "empty click clears focus");

// ── extended widgets (§98): radio / select / slider ──────────────────────────────────
let f2 = gui.form("T2", 400, 300);
gui.add(f2, gui.radio("r1", 20, 20, "A", "grp", true, on_chk));
gui.add(f2, gui.radio("r2", 20, 50, "B", "grp", false, on_chk));
gui.add(f2, gui.select("sel", 20, 90, 160, 26, ["one", "two", "three"], 0, nil));
gui.add(f2, gui.slider("sld", 20, 130, 200, 20, 50, 0, 100, nil));

// radio group is mutually exclusive
gui.handle_event(f2, map{ type: "mousemove", x: 25, y: 55 });
gui.handle_event(f2, map{ type: "mousedown", button: "Left" });
gui.handle_event(f2, map{ type: "mouseup", button: "Left" });
assert(gui.get(f2, "r2").selected == true and gui.get(f2, "r1").selected == false, "radio group exclusive");

// select cycles through options on click (wraps)
gui.handle_event(f2, map{ type: "mousemove", x: 30, y: 100 });
gui.handle_event(f2, map{ type: "mousedown", button: "Left" });
gui.handle_event(f2, map{ type: "mouseup", button: "Left" });
assert(gui.get(f2, "sel").selected == 1, "select cycles to next option");

// slider: press then drag sets value from cursor x; release stops tracking
gui.handle_event(f2, map{ type: "mousemove", x: 20, y: 140 });
gui.handle_event(f2, map{ type: "mousedown", button: "Left" });
assert(gui.get(f2, "sld").value == 0, "slider press at left edge -> min");
gui.handle_event(f2, map{ type: "mousemove", x: 120, y: 140 });
assert(gui.get(f2, "sld").value == 50, "slider drag to middle -> 50");
gui.handle_event(f2, map{ type: "mouseup", button: "Left" });
gui.handle_event(f2, map{ type: "mousemove", x: 200, y: 140 });
assert(gui.get(f2, "sld").value == 50, "slider ignores movement after release");

// Keyboard navigation skips non-interactive/hidden/disabled widgets, wraps,
// prevents key-repeat activation and supports the standard control keys.
let fk = gui.form("Keyboard", 400, 300);
gui.add(fk, gui.label("heading", 0, 0, "Controls"));
gui.add(fk, gui.button("action", 20, 30, 100, 28, "Action", on_ok));
gui.add(fk, gui.button("hidden", 20, 65, 100, 28, "Hidden", on_ok));
gui.add(fk, gui.checkbox("check", 20, 100, "Check", false, on_chk));
gui.add(fk, gui.select("choice", 20, 135, 140, 28, ["a", "b", "c"], 0, nil));
gui.add(fk, gui.slider("range", 20, 170, 160, 20, 5, 0, 10, nil));
gui.set_visible(fk, "hidden", false);
gui.handle_event(fk, map{ type: "keydown", key: "Tab" });
assert(fk.focus == "action", "Tab focuses first interactive control");
gui.handle_event(fk, map{ type: "keyup", key: "Tab" });
gui.handle_event(fk, map{ type: "keydown", key: "Enter" });
assert(clicks.n == 2, "Enter activates focused button");
gui.handle_event(fk, map{ type: "keydown", key: "Enter" });
assert(clicks.n == 2, "held key does not repeat destructive activation");
gui.handle_event(fk, map{ type: "keyup", key: "Enter" });
gui.handle_event(fk, map{ type: "keydown", key: "Tab" });
assert(fk.focus == "check", "Tab skips hidden control");
gui.handle_event(fk, map{ type: "keyup", key: "Tab" });
gui.handle_event(fk, map{ type: "keydown", key: "Space" });
assert(gui.get(fk, "check").checked, "Space toggles focused checkbox");
gui.handle_event(fk, map{ type: "keyup", key: "Space" });
gui.handle_event(fk, map{ type: "keydown", key: "Tab" });
gui.handle_event(fk, map{ type: "keyup", key: "Tab" });
assert(fk.focus == "choice", "Tab reaches select");
gui.handle_event(fk, map{ type: "keydown", key: "End" });
assert(gui.get(fk, "choice").selected == 2, "End selects final option");
gui.handle_event(fk, map{ type: "keyup", key: "End" });
gui.handle_event(fk, map{ type: "keydown", key: "Left" });
assert(gui.get(fk, "choice").selected == 1, "Left selects previous option");
gui.handle_event(fk, map{ type: "keyup", key: "Left" });
gui.handle_event(fk, map{ type: "keydown", key: "Tab" });
gui.handle_event(fk, map{ type: "keyup", key: "Tab" });
assert(fk.focus == "range", "Tab reaches slider");
gui.handle_event(fk, map{ type: "keydown", key: "Home" });
assert(gui.get(fk, "range").value == 0, "Home moves slider to minimum");
gui.handle_event(fk, map{ type: "keyup", key: "Home" });
gui.handle_event(fk, map{ type: "keydown", key: "LShift" });
gui.handle_event(fk, map{ type: "keydown", key: "Tab" });
assert(fk.focus == "choice", "Shift+Tab navigates backwards");
gui.handle_event(fk, map{ type: "keyup", key: "Tab" });
gui.handle_event(fk, map{ type: "keyup", key: "LShift" });
gui.set_enabled(fk, "choice", false);
assert(fk.focus == nil, "disabling the focused control clears focus");
gui.handle_event(fk, map{ type: "keydown", key: "Tab" });
assert(fk.focus == "action", "navigation wraps and skips disabled control");
gui.handle_event(fk, map{ type: "keyup", key: "Tab" });
gui.handle_event(fk, map{ type: "keydown", key: "Escape" });
assert(fk.focus == nil, "Escape clears keyboard focus");
gui.handle_event(fk, map{ type: "keyup", key: "Escape" });

// Text editing preserves normal OS key-repeat while discrete controls stay
// single-shot until keyup.
let ft = gui.form("Typing repeat", 240, 100);
gui.add(ft, gui.textbox("field", 10, 10, 180, 28, ""));
gui.handle_event(ft, map{ type: "keydown", key: "Tab" });
gui.handle_event(ft, map{ type: "keyup", key: "Tab" });
gui.handle_event(ft, map{ type: "keydown", key: "A" });
gui.handle_event(ft, map{ type: "keydown", key: "A" });
assert(gui.get(ft, "field").value == "aa", "held character repeats in text field");
gui.handle_event(ft, map{ type: "keyup", key: "A" });
gui.handle_event(ft, map{ type: "keydown", key: "Backspace" });
gui.handle_event(ft, map{ type: "keydown", key: "Backspace" });
assert(gui.get(ft, "field").value == "", "held Backspace repeats in text field");

// ── data-binding (§99): model is the source of truth, two-way for inputs ───────────────
let f3 = gui.form("Bind", 400, 300);
gui.add(f3, gui.bind(gui.textbox("name", 20, 20, 200, 26, ""), "name"));
gui.add(f3, gui.bind(gui.checkbox("agree", 20, 60, "Agree", false, nil), "agree"));
gui.add(f3, gui.bind(gui.slider("vol", 20, 100, 200, 20, 0, 0, 100, nil), "vol"));
gui.add(f3, gui.bind(gui.label("status", 20, 140, "init"), "status"));

// set_model pulls initial values into the bound widgets
gui.set_model(f3, map{ name: "Ada", agree: true, vol: 70, status: "ready" });
assert(gui.get(f3, "name").value == "Ada" and gui.get(f3, "agree").checked == true, "bound widgets pull from model");
assert(gui.get(f3, "vol").value == 70 and gui.get(f3, "status").text == "ready", "slider + label pull from model");

// user interaction pushes widget value back into the model
gui.handle_event(f3, map{ type: "mousemove", x: 30, y: 30 });
gui.handle_event(f3, map{ type: "mousedown", button: "Left" });
gui.handle_event(f3, map{ type: "keydown", key: "Backspace" });
assert(f3.model.name == "Ad", "typing pushes to model");
gui.handle_event(f3, map{ type: "mousemove", x: 25, y: 65 });
gui.handle_event(f3, map{ type: "mousedown", button: "Left" });
gui.handle_event(f3, map{ type: "mouseup", button: "Left" });
assert(f3.model.agree == false, "checkbox toggle pushes to model");

// a handler mutating the model + sync reflects in the bound widget
f3.model["status"] = "saved";
gui.sync(f3);
assert(gui.get(f3, "status").text == "saved", "model change reflects in widget after sync");

print "gui_pass";
