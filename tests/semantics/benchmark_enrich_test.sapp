// tests/semantics/benchmark_enrich_test.sapp — enrichment for stdlib/benchmark.sapp
// Pure stats (deterministic) + ops_per_sec/fastest/format.

let B = import("stdlib/benchmark.sapp");

fn fail(m) { throw "FAIL " + m; }
fn approx(a, b, m) { if (a - b) > 0.01 or (b - a) > 0.01 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : " + s); } }

// times = [10,20,30,40,50]
let s = B.stats("t", [10, 20, 30, 40, 50]);
eq(s.iterations, 5, "n");
approx(s.avg_ms, 30, "mean");
approx(s.median_ms, 30, "median (integer index)");
approx(s.min_ms, 10, "min");
approx(s.max_ms, 50, "max");
approx(s.stddev_ms, 14.1421, "stddev");
approx(s.p90_ms, 46, "interpolated p90");
approx(s.p95_ms, 48, "interpolated p95");
approx(s.p99_ms, 49.6, "interpolated p99");
approx(s.mad_ms, 10, "median absolute deviation");
approx(s.iqr_ms, 20, "interquartile range");
eq(s.outlier_count, 0, "no IQR outliers");
eq(s.stability, "unstable", "high CV is explicit");

// Even-sample median averages the two center values.
let se = B.stats("e", [4, 2, 8, 6]);
approx(se.median_ms, 5, "even-n median");
approx(B.percentile([2, 4, 6, 8], 95), 7.7, "public percentile");

let stable = B.stats("stable", [100, 101, 99, 100, 100]);
eq(stable.stability, "excellent", "low CV is excellent");
let one_outlier = B.stats("outlier", [10, 10, 10, 10, 100]);
eq(one_outlier.outlier_count, 1, "IQR outlier is reported");
eq(B.stats("empty", []).stability, "insufficient", "empty evidence is insufficient");

// ops_per_sec
approx(B.ops_per_sec(s), 33.3333, "ops/sec from 30ms avg");
eq(B.ops_per_sec(map{ avg_ms: 0 }), 0, "zero avg -> 0 ops");

// fastest
let f = B.fastest([map{ label: "a", avg_ms: 30 }, map{ label: "b", avg_ms: 10 }, map{ label: "c", avg_ms: 20 }]);
eq(f.label, "b", "fastest is b");

// format
has(B.format(s), "avg", "format mentions avg");
has(B.format(s), "p95", "format mentions p95");
has(B.format(s), "unstable", "format includes evidence quality");
has(B.format(map{ label: "old", avg_ms: 1, min_ms: 1, max_ms: 1, p95_ms: 1, iterations: 1 }), "n=1", "format remains backward compatible");

print "benchmark_enrich_pass";
