// tests/semantics/const_fold_try_test.sapp
// Regression: the bytecode constant-folder must not fold across a basic-block boundary.
// `(try X catch <num>) <op> <num>` previously folded the catch constant with the RHS
// (e.g. 1 != 0 -> true), discarding the try and silently producing the wrong value.
fn fail(m) { throw "FAIL " + m; }

let ok = map{ exit_code: 0 };
let bad = map{ exit_code: 5 };

// numeric catch + numeric comparison (the buggy shape) — must reflect the real value
if ((try ok.exit_code catch 1) != 0) { fail("(try 0 catch 1) != 0 must be false"); }
if not ((try bad.exit_code catch 1) != 0) { fail("(try 5 catch 1) != 0 must be true"); }
if not ((try ok.missing catch 1) != 0) { fail("missing -> catch 1 -> 1 != 0 must be true"); }
if not ((try ok.exit_code catch 1) == 0) { fail("(try 0 catch 1) == 0 must be true"); }
if ((try ok.exit_code catch 7) < 0) { fail("0 < 0 must be false"); }

// numeric catch + arithmetic
if ((try ok.exit_code catch 0) + 1) != 1 { fail("0 + 1 must be 1"); }
let m5 = map{ n: 5 };
if ((try m5.n catch 0) + 1) != 6 { fail("5 + 1 must be 6"); }
if ((try m5.n catch 0) * 2) != 10 { fail("5 * 2 must be 10"); }

// legitimate constant folding must STILL work (the fix must not disable it)
if (1 + 2 * 3) != 7 { fail("1 + 2*3 must still fold to 7"); }
if (10 - 4) != 6 { fail("10 - 4 must fold to 6"); }
if not (2 < 3) { fail("2 < 3 must fold to true"); }

print "const_fold_try_pass";
