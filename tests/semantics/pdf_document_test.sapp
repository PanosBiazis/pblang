let PDF = import("stdlib:pdf_document.sapp");

fn require(value, message) {
    if not value { throw "pdf_document_test: " + message; }
}

fn rejected(callable) { return (try { callable(); false } catch true); }

let image = map{
    width: 2, height: 2,
    rgb: [0, 126, 112, 204, 91, 48, 204, 91, 48, 0, 126, 112]
};
let made = PDF.create(map{
    title: "Document Composer",
    heading: "Hello, PBLang!",
    summary: "A deterministic native PDF document.",
    rows: [["Column 1", "Column 2"], ["Row 1", "Row 2"]],
    image: image,
    link: map{ label: "Open the safe reference", url: "https://example.com/docs?id=1" }
});

require(made.pages == 1 and made.image_embedded and made.link_count == 1,
    "writer must report its generated document features");
require(not made.privacy.author_embedded and not made.privacy.creator_embedded
    and not made.privacy.source_path_embedded,
    "writer must omit identity and source-path metadata");
let inspected = PDF.inspect(made.bytes);
require(inspected.ok and inspected.pages == 1 and inspected.objects == 8,
    "generated bytes must contain the expected page and object graph");
require(inspected.title == "Document Composer" and inspected.images == 1 and inspected.links == 1,
    "inspector must recover title, image and link structure");
require(len(inspected.rendered_text) == 8
    and inspected.rendered_text[0] == "Hello, PBLang!"
    and inspected.rendered_text[7] == "Open the safe reference",
    "inspector must recover rendered text in document order");
require(not inspected.encrypted and inspected.xref_offset > 0,
    "generated subset must have a valid classic xref and no implicit encryption");

let tampered = [];
for byte in made.bytes { array_push(tampered, byte); }
tampered[inspected.xref_offset] = 88;
require(not PDF.inspect(tampered).ok, "xref tampering must fail closed");
require(rejected(fn() { PDF.create(map{ title: "bad\nline" }); }),
    "control characters must be rejected");
require(rejected(fn() { PDF.create(map{
    title: "bad link", link: map{ label: "unsafe", url: "http://example.com" }
}); }), "plain HTTP links must be rejected");
require(rejected(fn() { PDF.create(map{
    title: "bad image", image: map{ width: 2, height: 2, rgb: [0, 1, 2] }
}); }), "malformed image data must be rejected");
require(not PDF.inspect([37, 80, 68, 70, 45, 49, 46, 52]).ok,
    "truncated documents must be rejected");

let caps = PDF.capabilities();
require(caps.native_writer and caps.native_inspector and caps.rgb_image
    and not caps.author_metadata and not caps.creator_metadata
    and not caps.encryption and not caps.object_streams,
    "capabilities must distinguish implemented and unsupported features");

print "pdf_document_pass";
