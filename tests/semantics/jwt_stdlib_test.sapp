let jwt = import("stdlib:jwt.sapp");

let secret = "test-secret-key-for-jwt";
let payload = map{ sub: "user123", role: "admin", iss: "pblang" };

// Sign
let token = jwt.sign(payload, secret);
assert(type(token) == "string", "token should be string");
assert(str_contains(token, "."), "JWT must contain dots");

// Count the dots (should be exactly 2)
let parts = str_split(token, ".");
assert(len(parts) == 3, "JWT must have exactly 3 parts, got: " + str(len(parts)));

// Verify
let verified = jwt.verify(token, secret);
assert(verified != nil, "verified should not be nil");
assert(verified.sub == "user123", "sub should match");
assert(verified.role == "admin", "role should match");

// Wrong secret should fail
let bad = try jwt.verify(token, "wrong-secret") catch "invalid";
assert(bad == "invalid", "wrong secret should fail");

// Decode without verification
let decoded = jwt.decode(token);
assert(decoded.payload.sub == "user123", "decoded sub should match");
assert(decoded.header.alg == "HS256", "alg should be HS256");

// Expiry - expired token
let expired_payload = map{ sub: "user", exp: 1 };  // exp = 1 (year 1970)
let expired_token = jwt.sign(expired_payload, secret);
let exp_result = try jwt.verify(expired_token, secret) catch "expired";
assert(exp_result == "expired", "expired token should fail: " + str(exp_result));

// expiry helper
let future_exp = jwt.expiry(3600);
assert(future_exp > clock(), "expiry should be in the future");

print "jwt_stdlib_pass";
