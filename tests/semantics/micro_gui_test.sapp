// tests/semantics/micro_gui_test.sapp -- tiny GUI render-plan foundation.
let UI = import("stdlib/micro_gui.sapp");

fn fail(m) { throw "FAIL " + m; }
fn assert_ok(v, m) { if not v { fail(m); } }

let app = UI.app("Small", 320, 220);
UI.add(app, UI.label("title", "Small fast GUI"));
UI.add(app, UI.field("name", "", "type name"));
UI.add(app, UI.checkbox("agree", "Agree", false));
UI.add(app, UI.progress("load", 0.5));
UI.add(app, UI.button("ok", "OK"));
UI.layout_column(app, 12, 12, 180, 6, 6, 8, 4);

let p = UI.plan(app, 6, 8, 4);
assert_ok(p.format == "pblang.micro_gui.plan.v1", "plan format");
assert_ok(p.command_count == len(p.commands) and p.hit_count == len(p.hits), "plan counts match arrays");
assert_ok(p.command_count <= 12, "simple GUI produces a compact render plan");
assert_ok(p.hit_count == 3, "field checkbox button are hit targets");
assert_ok(str_contains(p.signature, "field:name"), "signature includes widget state");

let h0 = UI.hit_test(app, 20, 40);
assert_ok(h0 != nil and h0.id == "name", "hit field");
let ev0 = UI.handle_click(app, 20, 40);
assert_ok(ev0.id == "name" and app.focus == "name", "click focuses field");
UI.handle_key(app, "A");
UI.handle_key(app, "d");
UI.handle_key(app, "a");
assert_ok(app.widgets[1].value == "Ada", "field accepts typed characters");
UI.handle_key(app, "Backspace");
assert_ok(app.widgets[1].value == "Ad", "field handles backspace");

let before = UI.plan(app, 6, 8, 4).signature;
app.dirty = false;
assert_ok(not UI.should_replan(app, before), "unchanged clean app skips replan");
UI.handle_click(app, 20, 70);
assert_ok(app.widgets[2].checked == true, "checkbox toggles");
assert_ok(UI.should_replan(app, before), "state change needs replan");

let ev1 = UI.handle_click(app, 20, 100);
assert_ok(ev1.id == "ok" and app.last_action == "ok", "button click returns action");
let miss = UI.handle_click(app, 300, 200);
assert_ok(miss == nil and app.focus == "", "miss clears focus without action");

print "micro_gui_pass";
