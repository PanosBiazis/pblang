// tests/semantics/set_hotpath_test.sapp — allocation-free set algebra and batches.

let S = import("stdlib/set.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn even(v) { return v % 2 == 0; }
fn twice(v) { return v * 2; }

let a = S.from_array([1, 2, 3, 4]);
let b = S.from_array([3, 4, 5]);
eq(S.size(S.union(a, b)), 5, "union size");
eq(S.size(S.intersection(a, b)), 2, "intersection size");
eq(S.has(S.intersection(a, b), 3), true, "intersection member");
eq(S.size(S.difference(a, b)), 2, "difference size");
eq(S.size(S.symmetric_difference(a, b)), 3, "symmetric difference size");
eq(S.is_subset(S.of(3, 4), a), true, "subset");
eq(S.is_disjoint(S.of(8, 9), a), true, "disjoint");

let batch = S.new();
S.add_all(batch, [1, 2, 3, 4, 4]);
eq(S.size(batch), 4, "add_all deduplicates");
S.remove_all(batch, [1, 9]);
eq(S.has(batch, 1), false, "remove_all existing");
eq(S.size(batch), 3, "remove_all absent is no-op");
S.retain(batch, even);
eq(S.size(batch), 2, "retain size");
eq(S.has(batch, 2), true, "retain member");
eq(S.size(S.map(batch, twice)), 2, "map size");
eq(S.size(S.filter(a, even)), 2, "filter size");
eq(S.to_string(S.from_array([1, 2])), "{1, 2}", "to_string");

print "set_hotpath_pass";
