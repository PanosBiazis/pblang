let I=import("stdlib:interval_analysis.sapp");
fn interval(a,b) { return map{start_ms:a,end_ms:b}; }
fn rejected(value) { return (try I.analyze(value) catch nil)==nil; }
let empty=I.analyze([]); assert(empty.span_ms==0 and empty.peak_concurrency==0 and empty.gaps==[],"empty timeline");
let input=[interval(10,30),interval(0,20),interval(20,25),interval(40,50)]; let before=json_stringify(input); let r=I.analyze(input);
assert(r.overlap_pairs==2 and r.overlaps_by_index==[2,1,1,0],"unsorted nesting and touching boundaries");
assert(r.occupied_ms==40 and r.span_ms==50 and r.gap_ms==10 and r.overlap_ms==15 and r.duration_sum_ms==55,"duration definitions");
assert(r.peak_concurrency==2 and r.gaps==[interval(30,40)],"peak and bounded internal gap");
assert(json_stringify(input)==before,"caller order unchanged");
let touching=I.analyze([interval(0,10),interval(10,20)]); assert(touching.overlap_pairs==0 and touching.gap_ms==0 and touching.peak_concurrency==1,"half-open boundary");
let nested=I.analyze([interval(0,100),interval(20,30),interval(20,30)]); assert(nested.overlap_pairs==3 and nested.overlaps_by_index==[2,2,2] and nested.overlap_ms==10 and nested.peak_concurrency==3,"duplicate spans and containment");
for value in [nil,map{},[nil],[map{start_ms:1}],[map{start_ms:1,end_ms:2,extra:0}], [interval(1,1)],[interval(2,1)],[interval(-1,3)],[interval(0,1.5)],[interval("0",2)],[interval(false,2)],[interval(0,I.MAX_TIME_MS+1)]] { assert(rejected(value),"malformed interval rejected"); }
// Differential oracle: all pairs plus a discrete unit-time coverage model.
for seed in range(0,40) {
    let data=[]; let count=1+num_mod(seed,19);
    for j in range(0,count) { let start=num_mod(seed*7+j*11,31); array_push(data,interval(start,start+1+num_mod(seed+j*3,12))); }
    let result=I.analyze(data); let expected_pairs=0; let expected_counts=[];
    for a in range(0,count) {
        let hits=0;
        for b in range(0,count) { if a!=b and data[a].start_ms<data[b].end_ms and data[b].start_ms<data[a].end_ms { hits=hits+1; if a<b {expected_pairs=expected_pairs+1;} } }
        array_push(expected_counts,hits);
    }
    let occupied=0; let overlap=0; let peak=0;
    for t in range(0,44) {
        let active=0; for item in data { if item.start_ms<=t and t<item.end_ms {active=active+1;} }
        if active>0 {occupied=occupied+1;} if active>1 {overlap=overlap+1;} peak=num_max(peak,active);
    }
    assert(result.overlap_pairs==expected_pairs and result.overlaps_by_index==expected_counts,"pair oracle");
    assert(result.occupied_ms==occupied and result.overlap_ms==overlap and result.peak_concurrency==peak,"coverage oracle");
}
let maximum=[];for j in range(0,I.MAX_INTERVALS) {array_push(maximum,interval(0,I.MAX_TIME_MS));}
let max_result=I.analyze(maximum);assert(max_result.overlap_pairs==130816 and max_result.peak_concurrency==512,"maximum overlap without pair-list expansion");
array_push(maximum,interval(0,1)); assert(rejected(maximum),"interval count bound");
print "interval_analysis_pass";
