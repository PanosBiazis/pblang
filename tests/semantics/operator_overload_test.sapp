// Test: operator overloading (dunder methods on user types)
// `a OP b` keeps the native numeric/string/bigint fast path; only when that
// fails does the VM look for an overload: forward `a.__op__(a, b)`, else
// reflected `b.__rop__(b, a)` (Python-style). Lets vectors/matrices/complex/money
// use natural `+ - * / % **` at ZERO cost to ordinary numeric code.
//
// Operators → dunders: + __add__/__radd__, - __sub__/__rsub__, * __mul__/__rmul__,
// / __div__/__rdiv__, % __mod__/__rmod__, ** __pow__/__rpow__.
// Unary `-x` desugars to `0 - x`, so it dispatches `x.__rsub__(x, 0)`.

// --- Plain-map vector type ---
fn vec(x, y) {
    return map{
        x: x, y: y,
        __add__: fn(self, o) { return vec(self.x + o.x, self.y + o.y); },
        __sub__: fn(self, o) { return vec(self.x - o.x, self.y - o.y); },
        __mul__: fn(self, o) { return vec(self.x * o, self.y * o); },   // vec * scalar
        __rmul__: fn(self, o) { return vec(self.x * o, self.y * o); },  // scalar * vec
        __rsub__: fn(self, o) { return vec(o - self.x, o - self.y); },  // scalar - vec  (and -vec)
    };
}

let a = vec(1, 2);
let b = vec(3, 4);

let s = a + b;
assert(s.x == 4 and s.y == 6, "vec + vec via __add__");

let d = b - a;
assert(d.x == 2 and d.y == 2, "vec - vec via __sub__");

let m = a * 10;
assert(m.x == 10 and m.y == 20, "vec * scalar via forward __mul__");

let r = 10 * a;
assert(r.x == 10 and r.y == 20, "scalar * vec via reflected __rmul__");

let neg = -a;
assert(neg.x == 0 - 1 and neg.y == 0 - 2, "unary -vec via __rsub__ (0 - vec)");

// --- Native class instance: operators dispatch through the __class table ---
class Money {
    fn init(self, cents) { self.cents = cents; }
    fn __add__(self, o) { return Money(self.cents + o.cents); }
    fn __sub__(self, o) { return Money(self.cents - o.cents); }
    fn __mul__(self, k) { return Money(self.cents * k); }
}
let p = Money(150);
let q = Money(99);
let sum = p + q;
assert(sum.cents == 249, "Money + Money via __class method dispatch");
let diff = p - q;
assert(diff.cents == 51, "Money - Money via __class method dispatch");
let scaled = p * 3;
assert(scaled.cents == 450, "Money * scalar via __class method dispatch");

// --- % and ** overloads ---
fn modnum(v) {
    return map{
        v: v,
        __mod__: fn(self, o) { return modnum(self.v % o); },
        __pow__: fn(self, o) { return modnum(self.v ** o); },
        __div__: fn(self, o) { return modnum(self.v / o); },
    };
}
assert((modnum(17) % 5).v == 2, "overloaded % ");
assert((modnum(2) ** 8).v == 256, "overloaded ** ");
assert((modnum(20) / 4).v == 5, "overloaded / ");

// --- Numeric / string fast paths are completely unaffected ---
assert(2 + 3 == 5, "numeric + fast path intact");
assert(10 - 4 == 6, "numeric - fast path intact");
assert(6 * 7 == 42, "numeric * fast path intact");
assert(20 / 5 == 4, "numeric / fast path intact");
assert(17 % 5 == 2, "numeric % fast path intact");
assert(2 ** 10 == 1024, "numeric ** fast path intact");
assert(("ab" + "cd") == "abcd", "string + concat intact");

// --- A map with NO matching dunder still errors (overloading is opt-in) ---
let plain = map{ x: 1 };
let threw = false;
try { let bad = plain + 5; } catch { threw = true; }
assert(threw == true, "map without __add__ must still raise, not silently pass");

print "operator_overload_pass";
