let P = import("stdlib:embedded_protocol.sapp");

fn command(sequence, opcode, value = 0, interval = 500, duration = 0) {
    return map{sequence:sequence, opcode:opcode, value:value,
        interval_ms:interval, duration_ms:duration};
}

let encoded = P.encode_command(command(7, P.OP_BLINK, 0, 250, 1500));
assert(len(encoded) == P.FRAME_BYTES, "fixed command frame");
let decoded = P.decode_command(encoded);
assert(decoded.ok and decoded.sequence == 7 and decoded.opcode == P.OP_BLINK
    and decoded.interval_ms == 250 and decoded.duration_ms == 1500,
    "command roundtrip");

let broken = []; for i len(encoded) { array_push(broken, encoded[i]); }
broken[8] = broken[8] + 1;
assert(not P.decode_command(broken).ok, "checksum corruption rejected");
let reserved = []; for i len(encoded) { array_push(reserved, encoded[i]); }
reserved[10] = 1;
reserved[11] = 0; let sum = 0; for i 11 { sum = (sum + reserved[i]) % 256; } reserved[11] = sum;
assert(not P.decode_command(reserved).ok, "reserved byte rejected");

let decoder = P.new_decoder("command");
let first = P.feed(decoder, [9, 8, encoded[0]]);
assert(first.ok and len(first.frames) == 0 and first.buffered_bytes == 1,
    "stream keeps only possible split magic");
let tail = []; let i = 1; while i < len(encoded) { array_push(tail, encoded[i]); i = i + 1; }
let second = P.feed(decoder, tail);
assert(second.ok and len(second.frames) == 1 and second.frames[0].sequence == 7,
    "chunked command resynchronizes");

let mixed = [];
for j len(broken) { array_push(mixed, broken[j]); }
for j len(encoded) { array_push(mixed, encoded[j]); }
let recovered = P.feed(P.new_decoder("command"), mixed);
assert(recovered.ok and len(recovered.frames) == 1 and recovered.rejected >= 1
    and recovered.buffered_bytes < P.FRAME_BYTES,
    "corrupt frame cannot grow decoder or hide following frame");

let device = P.new_device();
let denied = P.execute(device, P.decode_command(P.encode_command(command(10, P.OP_SET, 1))));
assert(denied.response.status == P.STATUS_NOT_SYNCHRONIZED and not denied.applied,
    "mutation requires status synchronization");
let hello = P.execute(device, P.decode_command(P.encode_command(command(10, P.OP_STATUS))));
assert(hello.ok and hello.response.status == P.STATUS_OK and device.expected_sequence == 11,
    "status establishes sequence");
let on = P.execute(device, P.decode_command(P.encode_command(command(11, P.OP_SET, 1))));
assert(on.applied and on.response.on and device.expected_sequence == 12,
    "ordered set applies");
let replay = P.execute(device, P.decode_command(P.encode_command(command(11, P.OP_SET, 0))));
assert(not replay.applied and replay.response.status == P.STATUS_DUPLICATE and device.on,
    "duplicate cannot replay mutation");
let skipped = P.execute(device, P.decode_command(P.encode_command(command(14, P.OP_TOGGLE))));
assert(not skipped.applied and skipped.response.status == P.STATUS_OUT_OF_ORDER and device.on,
    "out-of-order mutation rejected");
let blink = P.execute(device, P.decode_command(P.encode_command(command(12, P.OP_BLINK, 0, 100, 350))));
assert(blink.applied and device.blinking and device.on, "finite blink starts");
P.tick(device, 100); assert(not device.on and device.blinking, "first phase toggles");
P.tick(device, 250); assert(not device.on and not device.blinking and device.remaining_ms == 0,
    "finite blink finishes off");

let capabilities = P.execute(device,
    P.decode_command(P.encode_command(command(13, P.OP_CAPABILITIES))));
assert(not capabilities.applied and capabilities.response.status == P.STATUS_OK
    and capabilities.response.result_bits == (P.CAP_DIGITAL_LOOPBACK | P.CAP_ADC_READ)
    and capabilities.response.payload0 == (P.CAP_DIGITAL_LOOPBACK | P.CAP_ADC_READ | P.CAP_ANALOG_FOLLOW)
    and device.expected_sequence == 14,
    "capability negotiation advances sequence without claiming a mutation");
let loopback = P.execute(device,
    P.decode_command(P.encode_command(command(14, P.OP_LOOPBACK))));
assert(loopback.applied and loopback.response.result_bits == 3
    and not device.on and not device.blinking,
    "deterministic loopback reports both phases without changing LED state");

let adc = P.execute(device,
    P.decode_command(P.encode_command(command(15, P.OP_ADC_READ))));
assert(not adc.applied and adc.response.status == P.STATUS_OK
    and adc.response.payload0 == 512 and adc.response.payload1 == 1023,
    "ADC query returns bounded raw value and explicit converter maximum");
let adc_wire = P.decode_response(P.encode_response(adc.response));
assert(adc_wire.ok and adc_wire.payload0 == 512 and adc_wire.payload1 == 1023,
    "generic response payload preserves ADC values without changing frame size");
device.button_pressed = true;
let button = P.execute(device,
    P.decode_command(P.encode_command(command(16, P.OP_BUTTON_READ))));
assert(not button.applied and button.response.status == P.STATUS_OK
    and button.response.result_bits == 1 and button.response.payload0 == 1,
    "button query reports a read-only active-high sample");
let outputs = P.execute(device,
    P.decode_command(P.encode_command(command(17, P.OP_OUTPUT_TEST, 1))));
assert(outputs.applied and outputs.response.status == P.STATUS_OK
    and outputs.response.on and device.test_outputs_on,
    "diagnostic output command is ordered and preserves its boolean value");
device.gpio_input_low=0x1234;device.gpio_input_high=0x0800;
let gpio_snapshot=P.execute(device,
    P.decode_command(P.encode_command(command(18,P.OP_GPIO_SNAPSHOT))));
assert(not gpio_snapshot.applied and gpio_snapshot.response.status==P.STATUS_OK
    and gpio_snapshot.response.payload0==0x1234 and gpio_snapshot.response.payload1==0x0800,
    "GPIO snapshot preserves a bounded read-only 32-bit input register");
let gpio27_self_test=P.execute(device,
    P.decode_command(P.encode_command(command(19,P.OP_GPIO27_SELF_TEST))));
assert(not gpio27_self_test.applied and gpio27_self_test.response.status==P.STATUS_OK
    and gpio27_self_test.response.result_bits==3,
    "bounded GPIO27 self-test reports its input-only safety contract");
let analog_off=P.execute(device,
    P.decode_command(P.encode_command(command(20,P.OP_ANALOG_FOLLOW,0))));
assert(analog_off.applied and analog_off.response.status==P.STATUS_OK
    and not device.analog_follow and analog_off.response.payload0==0,
    "analog-follow mode can be disabled explicitly");
let analog_on=P.execute(device,
    P.decode_command(P.encode_command(command(21,P.OP_ANALOG_FOLLOW,1))));
assert(analog_on.applied and analog_on.response.status==P.STATUS_OK
    and device.analog_follow and analog_on.response.payload0==1,
    "analog-follow mode can be restored explicitly");

let response_bytes = P.encode_response(loopback.response);
let response = P.decode_response(response_bytes);
assert(response.ok and response.sequence == 14 and response.status == P.STATUS_OK
    and response.result_bits == 3, "response result-bit roundtrip");

let rollover=P.new_device();
assert(P.execute(rollover,P.decode_command(P.encode_command(command(255,P.OP_STATUS)))).response.status
    == P.STATUS_OK and rollover.expected_sequence==1,"status 255 wraps expected sequence to one");
assert(P.execute(rollover,P.decode_command(P.encode_command(command(1,P.OP_STOP)))).response.status
    == P.STATUS_OK and rollover.expected_sequence==2,"command one applies after rollover");

print "embedded_protocol_pass";
