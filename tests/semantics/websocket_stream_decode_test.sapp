// tests/semantics/websocket_stream_decode_test.sapp
//
// stream_decode(buffer_bytes) — the pure streaming decoder that a WebSocket
// client's recv loop uses: parse whole frames out of a carry-over byte buffer,
// reassemble a fragmented data message (respecting FIN), collect ping payloads
// to pong back, surface a close frame, and report how many bytes were consumed
// so the caller can keep the trailing partial frame buffered.
//
// This is what the old networking.sapp recv got wrong: it returned raw
// unparsed bytes and had no framing at all.

let ws = import("stdlib/websocket.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }

// server frames are UNMASKED — build them via a tiny unmasked encoder helper.
fn srv_text(s) { return ws.server_frame(1, s); }   // opcode 1, fin=1, no mask

// ── single complete text frame ───────────────────────────────────────────────
let one = srv_text("hello");
let r1 = ws.stream_decode(one);
eq(r1.message, "hello", "single frame decodes");
eq(r1.consumed, len(one), "consumed the whole frame");
eq(r1.close, nil, "no close");

// ── two frames back-to-back: first message returned, remainder left ───────────
let two = [];
let a = srv_text("aa");
let b = srv_text("bb");
let i = 0; while i < len(a) { array_push(two, a[i]); i = i + 1; }
i = 0; while i < len(b) { array_push(two, b[i]); i = i + 1; }
let r2 = ws.stream_decode(two);
eq(r2.message, "aa", "first message returned");
eq(r2.consumed, len(a), "only the first frame consumed");

// ── partial trailing frame: nothing consumed past the complete prefix ─────────
let partial = [];
i = 0; while i < len(a) { array_push(partial, a[i]); i = i + 1; }
array_push(partial, 129); array_push(partial, 5);   // header of an incomplete next frame
let r3 = ws.stream_decode(partial);
eq(r3.message, "aa", "complete leading frame still returned");
eq(r3.consumed, len(a), "the incomplete trailing frame is NOT consumed");

// ── incomplete first frame: no message, nothing consumed ──────────────────────
let r4 = ws.stream_decode([129, 5, 104]);   // says len 5, only 1 payload byte present
eq(r4.message, nil, "incomplete frame yields no message");
eq(r4.consumed, 0, "incomplete frame consumes nothing");

// ── fragmented message: opcode 1 fin=0 then continuation opcode 0 fin=1 ────────
let frag = [];
let f1 = ws.server_frame_frag(1, "Hel", false);   // fin=0
let f2 = ws.server_frame_frag(0, "lo!", true);     // continuation, fin=1
i = 0; while i < len(f1) { array_push(frag, f1[i]); i = i + 1; }
i = 0; while i < len(f2) { array_push(frag, f2[i]); i = i + 1; }
let r5 = ws.stream_decode(frag);
eq(r5.message, "Hello!", "fragments reassemble across FIN");
eq(r5.consumed, len(frag), "both fragment frames consumed");

// ── interleaved ping before the data message is collected as a pong-payload ───
let mixed = [];
let png = ws.server_frame(9, "hi");   // ping
let txt = srv_text("data");
i = 0; while i < len(png) { array_push(mixed, png[i]); i = i + 1; }
i = 0; while i < len(txt) { array_push(mixed, txt[i]); i = i + 1; }
let r6 = ws.stream_decode(mixed);
eq(r6.message, "data", "data after ping still returned");
eq(len(r6.pings), 1, "the ping was captured for a pong reply");
eq(r6.pings[0], "hi", "ping payload preserved");

// ── close frame surfaces code + reason ────────────────────────────────────────
let cl = ws.close(1001, "bye");     // close() masks, but decode handles masked too via parse
// build an UNMASKED close for the server direction
let cls = ws.server_close(1001, "bye");
let r7 = ws.stream_decode(cls);
truthy(r7.close != nil, "close surfaced");
eq(r7.close.code, 1001, "close code");
eq(r7.close.reason, "bye", "close reason");

print "websocket_stream_decode_pass";
