// tests/semantics/selfhost_to_pbck_test.sapp
//
// THE bootstrap close: the SELF-HOSTED (pblang-written) compiler emits bytecode,
// stdlib/selfhost_to_pbck.sapp translates it into the Rust .pbck container, and
// the NATIVE Rust VM (`pblang run file.pbck`) executes it. No Rust front-end is
// involved in producing the runnable artifact — pblang compiles pblang, the
// native kernel just runs the result.

let fe = import("stdlib/compiler/selfhost_frontend.sapp");
let xl = import("stdlib/selfhost_to_pbck.sapp");

fn fail(m) { throw "FAIL " + m; }

fn run_self(src, expected) {
    let r = fe.frontend_compile(src);
    if not r.ok { fail("self-hosted compile failed: " + src); }
    let path = "/tmp/sx_" + str(num_floor(now_ms())) + "_" + str(len(src)) + ".pbck";
    xl.write_file(path, r.chunk);
    let res = proc_spawn_wait("pblang", ["run", path, "--allow-all"]);
    let got = str_trim(res.stdout);
    if got != expected {
        fail("expected '" + expected + "' got '" + got + "' for: " + src);
    }
}

// Core constructs the self-hosted compiler emits and the Rust VM must run:
run_self("let answer = 6 * 7; print answer;", "42");
run_self("let s = 0; let i = 0; while i < 5 { s = s + i; i = i + 1; } print s;", "10");
run_self("let g = 0; let x = 7; if x > 5 { g = 100; } else { g = 200; } print g;", "100");
run_self("let a = [10, 20, 30]; print a[1];", "20");
run_self("let m = map{ a: 3, b: 4 }; print m.a + m.b;", "7");

// Functions and closures: the self-hosted compiler emits OP_CLOSURE + function
// constants, and (since codegen now shares the Rust VM's calling convention) the
// translator threads them into the native VM as real Function/Closure values.
run_self("fn f(x) { return x * 2; } print f(5);", "10");                                   // plain call
run_self("fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } print fib(10);", "55"); // recursion
run_self("fn outer(a, b) { let g = fn() { return a + b; }; return g(); } print outer(10, 20);", "30");  // capture two params
run_self("fn adder(n) { return fn(x) { return x + n; }; } let a = adder(5); print a(100);", "105");     // returned closure retains n
run_self("fn make() { let n = 0; return fn() { n = n + 1; return n; }; } let c = make(); c(); c(); print c();", "3"); // upvalue write persists

// Short-circuit and/or (self-hosted *_PEEK jumps emulated with OpDup+OpJumpIf*
// on the native VM) and modulo (OP_MOD). These expand one self-hosted op into
// several Rust ops, exercising the translator's two-pass jump-target remap.
run_self("let x = true and 5; print x;", "5");          // and returns 2nd when 1st truthy
run_self("let y = false and 5; print y;", "false");     // and short-circuits to 1st
run_self("let z = false or 9; print z;", "9");          // or returns 2nd when 1st falsy
run_self("let w = true or 7; print w;", "true");        // or short-circuits to 1st
run_self("print 17 % 5;", "2");                          // OP_MOD
run_self("fn f(a) { let b = a and 2; return b; } print f(true);", "2"); // short-circuit inside a fn (pad + expansion)

// for-loops desugar through OP_LEN (no native opcode) — emulated as a scratch
// local + the `len` builtin. Also exercises GET_INDEX/locals end to end.
run_self("let s = 0; for x in [1, 2, 3, 4] { s = s + x; } print s;", "10");                  // sum via for
run_self("print len([10, 20, 30]);", "3");                                                    // OP_LEN at top level
run_self("fn total(xs) { let t = 0; for v in xs { t = t + v; } return t; } print total([5, 6, 7]);", "18"); // for inside a fn

// try/catch (OP_TRY): the body and handler sub-chunks are inlined into the same
// frame as the Rust VM's OpTry/OpEndTry, with the error string popped on the catch
// path. The label-based IR makes this compose with nesting and loops.
run_self("let r = try 5 catch 9; print r;", "5");                                  // success path
run_self("let r = try boom() catch 42; print r;", "42");                           // catch on undefined callee
run_self("let r = try t() catch 99; fn t() { throw \"x\"; } print r;", "99");      // catch on explicit throw
run_self("let r = try (try bad() catch 7) catch 8; print r;", "7");                // nested try
run_self("let s = 0; for i in [1, 2, 3] { s = s + (try i catch 0); } print s;", "6"); // try inside a for-loop

print "selfhost_to_pbck_pass";
