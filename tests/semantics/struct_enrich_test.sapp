// tests/semantics/struct_enrich_test.sapp — enrichment for stdlib/struct.sapp
//
// Adds default field values, field introspection, an is_struct predicate,
// to_string(), and validate() — without changing the existing strict new()
// behavior (a missing field with no default still throws).

let s = import("stdlib/struct.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let Point = s.define("Point", ["x", "y"]);
let p = s.new(Point, map{ x: 3, y: 4 });
eq(p.x, 3, "base new still works");

// ── ENRICH: defaults ─────────────────────────────────────────────────────────────
let Cfg = s.define("Cfg", ["host", "port", "tls"], map{ port: 8080, tls: false });
let c = s.new(Cfg, map{ host: "localhost" });
eq(c.host, "localhost", "provided field"); eq(c.port, 8080, "default port"); eq(c.tls, false, "default tls");
let c2 = s.new(Cfg, map{ host: "h", port: 443 });
eq(c2.port, 443, "explicit overrides default");
// a field with NO default is still required
let missing = try s.new(Cfg, map{ port: 1 }) catch "THREW";
eq(missing, "THREW", "missing field without default still throws");

// ── ENRICH: introspection ────────────────────────────────────────────────────────
let f = s.fields(Point);
eq(len(f), 2, "fields count"); eq(f[0], "x", "fields order");
eq(s.is_struct(p), true, "is_struct true"); eq(s.is_struct(map{ a: 1 }), false, "is_struct false on plain map");

// ── ENRICH: to_string ────────────────────────────────────────────────────────────
eq(s.to_string(p), "Point { x: 3, y: 4 }", "to_string");

// ── ENRICH: validate ─────────────────────────────────────────────────────────────
let v1 = s.validate(Point, map{ x: 1, y: 2 });
eq(v1.ok, true, "validate ok");
let v2 = s.validate(Point, map{ x: 1 });
eq(v2.ok, false, "validate detects missing"); eq(v2.missing[0], "y", "validate lists missing field");

print "struct_enrich_pass";
