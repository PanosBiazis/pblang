// tests/semantics/math_enrich_test.sapp — enrichment for stdlib/math.sapp
// Adds factorial, hypot, cbrt, is_close, round_to, copysign, fmod, wrap.

let math = import("stdlib/math.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.000001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base still works ─────────────────────────────────────────────────────────────
near(math.sin(0), 0, "sin"); near(math.log2(8), 3, "log2");

// ── ENRICH ───────────────────────────────────────────────────────────────────────
near(math.factorial(5), 120, "factorial 5");
near(math.factorial(0), 1, "factorial 0");
near(math.hypot(3, 4), 5, "hypot");
near(math.cbrt(27), 3, "cbrt 27");
near(math.cbrt(0 - 8), 0 - 2, "cbrt -8 = -2");
if not math.is_close(0.1 + 0.2, 0.3, 0.000000001) { fail("is_close 0.1+0.2 ~ 0.3"); }
if math.is_close(1, 2, 0.1) { fail("is_close should be false for 1 vs 2"); }
near(math.round_to(3.14159, 2), 3.14, "round_to 2 decimals");
near(math.copysign(3, 0 - 1), 0 - 3, "copysign negative");
near(math.copysign(0 - 3, 1), 3, "copysign positive");
near(math.fmod(7, 3), 1, "fmod 7,3");
near(math.fmod(0 - 7, 3), 0 - 1, "fmod -7,3 (C-style)");
near(math.wrap(370, 0, 360), 10, "wrap 370 into [0,360)");
near(math.wrap(0 - 10, 0, 360), 350, "wrap -10 into [0,360)");

print "math_enrich_pass";
