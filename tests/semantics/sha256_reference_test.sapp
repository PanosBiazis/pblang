// Reference digests generated independently with Python hashlib/OpenSSL.
// Exercise carry-heavy unsigned words, padding boundaries and chunking.
let SHA=import("stdlib:sha256_pb.sapp");
let cases=[
    map{size:0,digest:"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},
    map{size:1,digest:"4a64a107f0cb32536e5bce6c98c393db21cca7f4ea187ba8c4dca8b51d4ea80a"},
    map{size:2,digest:"b27fc04e05a940672b77fb0d1aaf6a1f6e3675603da78e6791a66b6523c46fd4"},
    map{size:3,digest:"abf0f7ab4223b86bbafb06e42d0caf0e889d27619b946d440a128bb405b7c5a3"},
    map{size:31,digest:"6ea6885aff3c2e1f196ab8148e50e24b0262bcabafac4c84d3c64c79eecc2019"},
    map{size:55,digest:"59aaae80b8e7958f5757b4ac9274f1fd57ec0dc7aa8349319102316781b92006"},
    map{size:56,digest:"dca902d31487ffab357ce36cc5abc6947fbb69127ec04c468ba5687268c4bf7c"},
    map{size:57,digest:"ca0042f1f8b6a02ba5a30af121a9b69daa34b07bb22b2b320c05abe21df875a0"},
    map{size:63,digest:"b8e655e9e7ad413b96f0a371eb1d6db71dcca27f4eee35892517cbe4bfaa6f9a"},
    map{size:64,digest:"e5146be62accc56709594cb45c651b361df94f622cbb09b91ea3ca7a2060bd53"},
    map{size:65,digest:"4b6c6774f0cbcd776a90e187b9494e04ca880c0afe3ea1c5cad51c8bbcb41f74"},
    map{size:111,digest:"e10996bd86a024f96eeb80e4881768a8b13419689a0590b83dd8557380ffa513"},
    map{size:119,digest:"3244509f8746f6fb511ca8a72a292a4d7d12e456cce283c03f169dbbcb0d512e"},
    map{size:120,digest:"c5236e50172da3b69c903dcd3b3bb8ce855182f79364d1b59ed36367aa25e468"},
    map{size:127,digest:"b4f5398bf618d741f2ab0f6e2fcde06f4949c20d476b5f6e1d4bf8618bc8973a"},
    map{size:128,digest:"ed045c7c319e0c9286e1dea21c80bfd4a08eca43e02e13ee8a7a2c8b4b2baec9"},
    map{size:129,digest:"d6f2fca0407b3f98c9ce29ae92a6cdf489506450fdbb29172f6b18987bc685db"},
    map{size:255,digest:"2bfae287351d36c18acee2355b16e41065e5735735d019ccc823aefcb23e67d5"},
    map{size:256,digest:"118b38101a6d90a15bec907a04acac42e0f213be5dd3f0731967e0349a3d2b27"},
    map{size:257,digest:"4c3b4cec288f9b9433a40411c9fd1aa609b65c736b9e85f021ad29a225d1999a"},
    map{size:511,digest:"ea0ba67098f6480671bdfc8e1a5856973b7d5764ee17a2e5ce47479c7ed6e04b"},
    map{size:512,digest:"2ef02ebdb78dc5c7af2a6e09ce3296cc75a57ca4c880ddededf4cb356e5fea82"},
    map{size:513,digest:"f2a4a4f8145239356da9466c8be0ef3f65ce6113473f4f55d014048089bd5405"},
    map{size:1024,digest:"575383deff0775797e1ff4c82da069141937c843a81cbe50959a96bcfa88140e"},
    map{size:4096,digest:"c741eee93580a334bae702208e5c0595d8e32eb07d562c52d56ca5f86e78f8a8"}];
for sample in cases {
    let bytes=[];for i sample.size {push(bytes,(i*131+17)%256);}
    assert(SHA.sha256_hex_bytes(bytes)==sample.digest,"independent binary digest");
    for chunk_size in [1,7,63,64,65] {
        let ctx=SHA.new();let chunk=[];
        for byte in bytes {
            push(chunk,byte);
            if len(chunk)==chunk_size {SHA.update(ctx,chunk);chunk=[];}
        }
        SHA.update(ctx,chunk);assert(SHA.finish(ctx)==sample.digest,"chunk boundary digest");
    }
}
fn rejected(action){let failed=false;try action() catch {failed=true;};return failed;}
assert(not rejected(fn(){return true;}),"test helper");
for bad in [[-1],[256],[1.5],[nil],["0"],"abc",nil] {
    assert(rejected(fn(){SHA.sha256_hex_bytes(bad);}),"invalid input remains rejected");
}
let done=SHA.new();SHA.update(done,[255]);SHA.finish(done);
assert(rejected(fn(){SHA.update(done,[1]);}),"finished update denied");
assert(rejected(fn(){SHA.finish(done);}),"second finish denied");
print "sha256_reference_pass: 150 digest comparisons";
