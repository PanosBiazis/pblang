let E = import("stdlib:product_release_evidence.sapp");

let A = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
let B = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
let C = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc";
let D = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd";
let COMMIT = "0123456789abcdef0123456789abcdef01234567";

fn complete_source() {
    return E.source("demo", "1.2.3", "stable", "0.6.0-alpha", A, B, C, COMMIT,
        map{clean_tree:true, reproducible_inputs:true});
}

fn complete_artifact(source) {
    return E.artifact(source, "demo-linux", B, 4096, A, "1.2.3", "stable",
        ["linux:x86_64", "linux:aarch64"], map{
            signed_artifact:true, signature_sha256:C, sbom_sha256:D, attestation_sha256:A,
            install_verified:true, upgrade_verified:true, rollback_verified:true, uninstall_verified:true
        });
}

fn linux_policy(require_arm = false) {
    let targets = [E.target_requirement("demo-linux", "linux", "x86_64",
        ["install", "start", "rollback", "uninstall"])];
    if require_arm {
        array_push(targets, E.target_requirement("demo-linux", "linux", "aarch64", ["start"]));
    }
    return E.policy("demo-stable", 7, ["demo-linux"], ["full"], targets);
}

fn main() {
    let source = complete_source(); let artifact = complete_artifact(source);
    let report = E.test_report(source, artifact, "full", C, A, B, 120, 0, 0, ["linux:x86_64"],
        map{complete_suite:true, process_isolated:true});
    let platform = E.platform_evidence(source, artifact, "linux", "x86_64", "physical-lab",
        D, B, ["install", "start", "rollback", "uninstall"], map{physical:true});
    let gate = E.evaluate(source, linux_policy(), [artifact], [report], [platform]);
    assert(gate.structurally_complete and len(gate.blockers) == 0,
        "fully bound synthetic claims are structurally consistent");
    assert(not gate.trust_verified and not gate.production_ready,
        "synthetic claims can never authorize publication or installation");

    let stale_test_rejected = false;
    try { E.test_report(source, artifact, "stale", C, B, B, 1, 0, 0, ["linux:x86_64"]); }
    catch { stale_test_rejected = true; }
    assert(stale_test_rejected, "test evidence from another source digest fails closed");

    let old_test_rejected = false;
    try { E.test_report(source, artifact, "old-apk", C, A, C, 1, 0, 0, ["linux:x86_64"]); }
    catch { old_test_rejected = true; }
    assert(old_test_rejected, "test evidence from another artifact digest fails closed");

    let drift_rejected = false;
    try { E.artifact(source, "old", B, 1, A, "1.2.2", "stable", ["linux:x86_64"]); }
    catch { drift_rejected = true; }
    assert(drift_rejected, "artifact version drift fails closed");

    let old_device_rejected = false;
    try { E.platform_evidence(source, artifact, "linux", "x86_64", "lab", D, C, ["start"]); }
    catch { old_device_rejected = true; }
    assert(old_device_rejected, "physical evidence for an older artifact digest fails closed");

    let unsigned = E.artifact(source, "preview", B, 4096, A, "1.2.3", "stable", ["linux:x86_64"]);
    let preview_policy = E.policy("preview", 1, ["preview"], ["preview-full"], [
        E.target_requirement("preview", "linux", "x86_64", ["start"])
    ]);
    let preview_report = E.test_report(source, unsigned, "preview-full", C, A, B, 1, 0, 0,
        ["linux:x86_64"], map{complete_suite:true, process_isolated:true});
    let blocked = E.evaluate(source, preview_policy, [unsigned], [preview_report], []);
    assert(not blocked.structurally_complete and not blocked.production_ready and len(blocked.blockers) >= 8,
        "missing signing, provenance, lifecycle, and physical evidence stays blocked");

    let empty_policy_rejected = false;
    try { E.policy("weak", 1, ["demo-linux"], ["full"], []); }
    catch { empty_policy_rejected = true; }
    assert(empty_policy_rejected, "callers cannot omit all platform requirements");

    let dirty = E.source("demo", "1.2.3", "NIGHTLY", "0.6.0-alpha", A, B, C, COMMIT);
    assert(dirty.release_channel == "nightly", "release channels are validated and canonicalized");
    let dirty_artifact = E.artifact(dirty, "nightly", B, 1, A, "1.2.3", "nightly", ["linux:x86_64"]);
    let dirty_report = E.test_report(dirty, dirty_artifact, "full", C, A, B, 1, 0, 0,
        ["linux:x86_64"]);
    let dirty_gate = E.evaluate(dirty, linux_policy(), [dirty_artifact], [dirty_report], []);
    assert(not dirty_gate.ok and str_contains(dirty_gate.blockers[0], "not clean"),
        "dirty or unlocked sources cannot become structurally complete");

    let duplicate_rejected = false;
    try { E.evaluate(source, linux_policy(), [artifact, artifact], [report], [platform]); }
    catch { duplicate_rejected = true; }
    assert(duplicate_rejected, "duplicate artifact identities fail closed");

    let tampered = complete_artifact(source); tampered.signed_artifact = "yes";
    let tampered_rejected = false;
    try { E.evaluate(source, linux_policy(), [tampered], [report], [platform]); }
    catch { tampered_rejected = true; }
    assert(tampered_rejected, "mutable artifact records are revalidated at the final gate");

    let tampered_platform = E.platform_evidence(source, artifact, "linux", "x86_64", "lab",
        D, B, ["start"], map{physical:true});
    tampered_platform.artifact_sha256 = C;
    let platform_tamper_rejected = false;
    try { E.evaluate(source, linux_policy(), [artifact], [report], [tampered_platform]); }
    catch { platform_tamper_rejected = true; }
    assert(platform_tamper_rejected, "mutable platform evidence remains bound to the exact artifact digest");

    let arm_platform = E.platform_evidence(source, artifact, "linux", "aarch64", "arm-lab",
        C, B, ["start"], map{physical:true});
    let multi_arch = E.evaluate(source, linux_policy(true), [artifact], [report], [platform, arm_platform]);
    assert(multi_arch.structurally_complete and multi_arch.platform_evidence_count == 2,
        "policy can require independently bound evidence for multiple architectures");

    let weak_checks = E.platform_evidence(source, artifact, "linux", "x86_64", "lab",
        D, B, ["start"], map{physical:true});
    let weak_gate = E.evaluate(source, linux_policy(), [artifact], [report], [weak_checks]);
    assert(not weak_gate.structurally_complete and str_contains(str_join(weak_gate.blockers, "\n"), "missing check"),
        "policy-required checks cannot be weakened by evidence claims");
    print "product_release_evidence_pass";
}

main();
