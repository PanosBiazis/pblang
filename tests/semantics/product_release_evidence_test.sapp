let E = import("stdlib:product_release_evidence.sapp");

let A = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
let B = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
let C = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc";
let D = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd";
let COMMIT = "0123456789abcdef0123456789abcdef01234567";

fn complete_source() {
    return E.source("demo", "1.2.3", "stable", "0.6.0-alpha", A, B, C, COMMIT,
        map{clean_tree:true, reproducible_inputs:true});
}

fn complete_artifact(source) {
    return E.artifact(source, "demo-linux", B, 4096, A, "1.2.3", "stable",
        ["linux:x86_64", "linux:aarch64"], map{
            signed_artifact:true, signature_sha256:C, sbom_sha256:D, attestation_sha256:A,
            install_verified:true, upgrade_verified:true, rollback_verified:true, uninstall_verified:true
        });
}

fn linux_policy(require_arm = false) {
    let targets = [E.target_requirement("demo-linux", "linux", "x86_64",
        ["install", "start", "rollback", "uninstall"])];
    if require_arm {
        array_push(targets, E.target_requirement("demo-linux", "linux", "aarch64", ["start"]));
    }
    return E.policy("demo-stable", 7, ["demo-linux"], ["full"], targets);
}

fn runtime_results(value = true) {
    let out = map{};
    for check in E.runtime_security_checks() { out[check] = value; }
    return out;
}

fn main() {
    let source = complete_source(); let artifact = complete_artifact(source);
    let report = E.test_report(source, artifact, "full", C, A, B, 120, 0, 0, ["linux:x86_64"],
        map{complete_suite:true, process_isolated:true});
    let platform = E.platform_evidence(source, artifact, "linux", "x86_64", "physical-lab",
        D, B, ["install", "start", "rollback", "uninstall"], map{physical:true});
    let gate = E.evaluate(source, linux_policy(), [artifact], [report], [platform]);
    assert(gate.structurally_complete and len(gate.blockers) == 0,
        "fully bound synthetic claims are structurally consistent");
    assert(not gate.trust_verified and not gate.production_ready,
        "synthetic claims can never authorize publication or installation");

    let stale_test_rejected = false;
    try { E.test_report(source, artifact, "stale", C, B, B, 1, 0, 0, ["linux:x86_64"]); }
    catch { stale_test_rejected = true; }
    assert(stale_test_rejected, "test evidence from another source digest fails closed");

    let old_test_rejected = false;
    try { E.test_report(source, artifact, "old-apk", C, A, C, 1, 0, 0, ["linux:x86_64"]); }
    catch { old_test_rejected = true; }
    assert(old_test_rejected, "test evidence from another artifact digest fails closed");

    let drift_rejected = false;
    try { E.artifact(source, "old", B, 1, A, "1.2.2", "stable", ["linux:x86_64"]); }
    catch { drift_rejected = true; }
    assert(drift_rejected, "artifact version drift fails closed");

    let old_device_rejected = false;
    try { E.platform_evidence(source, artifact, "linux", "x86_64", "lab", D, C, ["start"]); }
    catch { old_device_rejected = true; }
    assert(old_device_rejected, "physical evidence for an older artifact digest fails closed");

    let unsigned = E.artifact(source, "preview", B, 4096, A, "1.2.3", "stable", ["linux:x86_64"]);
    let preview_policy = E.policy("preview", 1, ["preview"], ["preview-full"], [
        E.target_requirement("preview", "linux", "x86_64", ["start"])
    ]);
    let preview_report = E.test_report(source, unsigned, "preview-full", C, A, B, 1, 0, 0,
        ["linux:x86_64"], map{complete_suite:true, process_isolated:true});
    let blocked = E.evaluate(source, preview_policy, [unsigned], [preview_report], []);
    assert(not blocked.structurally_complete and not blocked.production_ready and len(blocked.blockers) >= 8,
        "missing signing, provenance, lifecycle, and physical evidence stays blocked");

    let empty_policy_rejected = false;
    try { E.policy("weak", 1, ["demo-linux"], ["full"], []); }
    catch { empty_policy_rejected = true; }
    assert(empty_policy_rejected, "callers cannot omit all platform requirements");

    let dirty = E.source("demo", "1.2.3", "NIGHTLY", "0.6.0-alpha", A, B, C, COMMIT);
    assert(dirty.release_channel == "nightly", "release channels are validated and canonicalized");
    let dirty_artifact = E.artifact(dirty, "nightly", B, 1, A, "1.2.3", "nightly", ["linux:x86_64"]);
    let dirty_report = E.test_report(dirty, dirty_artifact, "full", C, A, B, 1, 0, 0,
        ["linux:x86_64"]);
    let dirty_gate = E.evaluate(dirty, linux_policy(), [dirty_artifact], [dirty_report], []);
    assert(not dirty_gate.ok and str_contains(dirty_gate.blockers[0], "not clean"),
        "dirty or unlocked sources cannot become structurally complete");

    let duplicate_rejected = false;
    try { E.evaluate(source, linux_policy(), [artifact, artifact], [report], [platform]); }
    catch { duplicate_rejected = true; }
    assert(duplicate_rejected, "duplicate artifact identities fail closed");

    let tampered = complete_artifact(source); tampered.signed_artifact = "yes";
    let tampered_rejected = false;
    try { E.evaluate(source, linux_policy(), [tampered], [report], [platform]); }
    catch { tampered_rejected = true; }
    assert(tampered_rejected, "mutable artifact records are revalidated at the final gate");

    let tampered_platform = E.platform_evidence(source, artifact, "linux", "x86_64", "lab",
        D, B, ["start"], map{physical:true});
    tampered_platform.artifact_sha256 = C;
    let platform_tamper_rejected = false;
    try { E.evaluate(source, linux_policy(), [artifact], [report], [tampered_platform]); }
    catch { platform_tamper_rejected = true; }
    assert(platform_tamper_rejected, "mutable platform evidence remains bound to the exact artifact digest");

    let arm_platform = E.platform_evidence(source, artifact, "linux", "aarch64", "arm-lab",
        C, B, ["start"], map{physical:true});
    let multi_arch = E.evaluate(source, linux_policy(true), [artifact], [report], [platform, arm_platform]);
    assert(multi_arch.structurally_complete and multi_arch.platform_evidence_count == 2,
        "policy can require independently bound evidence for multiple architectures");

    let weak_checks = E.platform_evidence(source, artifact, "linux", "x86_64", "lab",
        D, B, ["start"], map{physical:true});
    let weak_gate = E.evaluate(source, linux_policy(), [artifact], [report], [weak_checks]);
    assert(not weak_gate.structurally_complete and str_contains(str_join(weak_gate.blockers, "\n"), "missing check"),
        "policy-required checks cannot be weakened by evidence claims");

    let malformed_digest_rejected = false;
    try { E.source("demo", "1.2.3", "stable", "0.6.0-alpha", "not-a-digest", B, C, COMMIT); }
    catch { malformed_digest_rejected = true; }
    assert(malformed_digest_rejected, "non-hexadecimal source digests fail closed");

    let zero_report = E.test_report(source, artifact, "full", C, A, B, 0, 0, 0,
        ["linux:x86_64"], map{complete_suite:true, process_isolated:true});
    let zero_gate = E.evaluate(source, linux_policy(), [artifact], [zero_report], [platform]);
    assert(not zero_gate.structurally_complete
        and str_contains(str_join(zero_gate.blockers, "\n"), "tests did not pass"),
        "a zero-test report cannot satisfy a required suite");

    let unisolated = E.test_report(source, artifact, "full", C, A, B, 1, 0, 0,
        ["linux:x86_64"], map{complete_suite:true, process_isolated:false});
    let unisolated_gate = E.evaluate(source, linux_policy(), [artifact], [unisolated], [platform]);
    assert(not unisolated_gate.structurally_complete
        and str_contains(str_join(unisolated_gate.blockers, "\n"), "process isolation"),
        "successful tests without process-isolation evidence stay blocked");

    let unknown_field = complete_artifact(source); unknown_field.untrusted_note = "ignore me";
    let unknown_field_rejected = false;
    try { E.evaluate(source, linux_policy(), [unknown_field], [report], [platform]); }
    catch { unknown_field_rejected = true; }
    assert(unknown_field_rejected, "unknown mutable evidence fields are rejected rather than ignored");

    let duplicate_suite_rejected = false;
    try { E.evaluate(source, linux_policy(), [artifact], [report, report], [platform]); }
    catch { duplicate_suite_rejected = true; }
    assert(duplicate_suite_rejected, "duplicate suite identities cannot double-count evidence");

    let too_many_artifacts = []; let i = 0;
    while i < 65 { array_push(too_many_artifacts, artifact); i = i + 1; }
    let artifact_limit_rejected = false;
    try { E.evaluate(source, linux_policy(), too_many_artifacts, [report], [platform]); }
    catch { artifact_limit_rejected = true; }
    assert(artifact_limit_rejected, "artifact collection limit rejects max plus one before traversal");

    let zero_bytes_rejected = false;
    try { E.artifact(source, "empty", B, 0, A, "1.2.3", "stable", ["linux:x86_64"]); }
    catch { zero_bytes_rejected = true; }
    assert(zero_bytes_rejected, "empty release artifacts cannot carry structural evidence");

    let portable = E.artifact(source, "demo-portable", B, 4096, A, "1.2.3", "stable",
        ["windows:x86_64", "macos:aarch64"], map{
            signed_artifact:true, signature_sha256:C, sbom_sha256:D, attestation_sha256:A,
            install_verified:true, upgrade_verified:true, rollback_verified:true,
            uninstall_verified:true
        });
    let runtime = E.runtime_security_evidence(source, portable, C, B,
        "independent-runtime-lab", 1000, 1600, runtime_results());
    let runtime_policy = E.runtime_security_policy("portable-runtime", 1,
        "demo-portable", "aarch64");
    let windows = E.runtime_platform_evidence(source, portable, runtime_policy,
        runtime, "windows", "x86_64", C, "physical-windows-lab",
        1050, 1500, runtime_results());
    let macos = E.runtime_platform_evidence(source, portable, runtime_policy,
        runtime, "macos", "aarch64", D, "physical-macos-lab",
        1050, 1500, runtime_results());
    let runtime_gate = E.evaluate_runtime_security(source, portable, runtime_policy,
        runtime, [windows, macos], 1200);
    assert(runtime_gate.structurally_complete and len(runtime_gate.blockers) == 0,
        "all mandatory runtime claims and current physical targets satisfy the structural gate");
    assert(not runtime_gate.evidence_authenticity_verified and not runtime_gate.trust_verified
        and not runtime_gate.authorizes_execution and not runtime_gate.production_ready,
        "synthetic runtime claims never become execution or production authority");

    let missing_heap = runtime_results(); missing_heap.cumulative_heap_enforcement = false;
    let weak_runtime = E.runtime_security_evidence(source, portable, C, B,
        "independent-runtime-lab", 1000, 1600, missing_heap);
    let weak_windows = E.runtime_platform_evidence(source, portable, runtime_policy,
        weak_runtime, "windows", "x86_64", C, "physical-windows-lab",
        1050, 1500, missing_heap);
    let weak_macos = E.runtime_platform_evidence(source, portable, runtime_policy,
        weak_runtime, "macos", "aarch64", D, "physical-macos-lab",
        1050, 1500, missing_heap);
    let weak_runtime_gate = E.evaluate_runtime_security(source, portable, runtime_policy,
        weak_runtime, [weak_windows, weak_macos], 1200);
    assert(not weak_runtime_gate.structurally_complete
        and str_contains(str_join(weak_runtime_gate.blockers, "\n"),
            "cumulative_heap_enforcement"),
        "one missing production guarantee blocks the entire runtime gate");

    let missing_macos = E.evaluate_runtime_security(source, portable, runtime_policy,
        runtime, [windows], 1200);
    assert(not missing_macos.structurally_complete
        and str_contains(str_join(missing_macos.blockers, "\n"), "macos:aarch64"),
        "Windows evidence cannot substitute for physical macOS evidence");

    let stale_runtime = E.evaluate_runtime_security(source, portable, runtime_policy,
        runtime, [windows, macos], 1600);
    assert(not stale_runtime.structurally_complete
        and str_contains(stale_runtime.blockers[0], "not currently valid"),
        "expired runtime evidence fails closed at the exact boundary");

    let forged_runtime = E.runtime_security_evidence(source, portable, C, B,
        "independent-runtime-lab", 1000, 1600, runtime_results());
    forged_runtime.results.publisher_authenticity = false;
    let forged_runtime_rejected = false;
    try { E.evaluate_runtime_security(source, portable, runtime_policy,
        forged_runtime, [windows, macos], 1200); }
    catch { forged_runtime_rejected = true; }
    assert(forged_runtime_rejected,
        "mutable runtime results cannot drift from their evidence digest");

    let weak_policy = E.runtime_security_policy("portable-runtime", 1,
        "demo-portable", "aarch64");
    array_pop(weak_policy.required_checks);
    let weak_policy_rejected = false;
    try { E.evaluate_runtime_security(source, portable, weak_policy,
        runtime, [windows, macos], 1200); }
    catch { weak_policy_rejected = true; }
    assert(weak_policy_rejected,
        "a caller cannot remove production checks from the canonical runtime policy");

    let exposed_checks = E.runtime_security_checks(); array_pop(exposed_checks);
    assert(len(exposed_checks) == 7 and len(E.runtime_security_checks()) == 8,
        "mutating an API-returned check list cannot poison the private canonical list");
    array_pop(runtime_gate.required_checks);
    assert(len(E.runtime_security_policy("fresh", 1, "demo-portable").required_checks) == 8,
        "mutating a gate result cannot weaken a later policy");

    let generic_windows = E.platform_evidence(source, portable, "windows", "x86_64",
        "generic-lab", C, B, ["install"], map{physical:true});
    let generic_platform_rejected = false;
    try { E.evaluate_runtime_security(source, portable, runtime_policy,
        runtime, [generic_windows, macos], 1200); }
    catch { generic_platform_rejected = true; }
    assert(generic_platform_rejected,
        "generic physical metadata cannot substitute for dedicated runtime evidence");

    let stale_windows = E.runtime_platform_evidence(source, portable, runtime_policy,
        runtime, "windows", "x86_64", C, "physical-windows-lab",
        1000, 1100, runtime_results());
    let stale_platform = E.evaluate_runtime_security(source, portable, runtime_policy,
        runtime, [stale_windows, macos], 1200);
    assert(not stale_platform.structurally_complete
        and str_contains(str_join(stale_platform.blockers, "\n"),
            "windows:x86_64: runtime platform evidence is not currently valid"),
        "expired physical runtime evidence cannot satisfy a current platform lane");

    let other_runtime = E.runtime_security_evidence(source, portable, D, B,
        "independent-runtime-lab", 1000, 1600, runtime_results());
    let swapped_runtime_rejected = false;
    try { E.evaluate_runtime_security(source, portable, runtime_policy,
        other_runtime, [windows, macos], 1200); }
    catch { swapped_runtime_rejected = true; }
    assert(swapped_runtime_rejected,
        "platform reports cannot be replayed against a different runtime evidence digest");

    let spoofed_windows = E.runtime_platform_evidence(source, portable, runtime_policy,
        runtime, "windows", "x86_64", C, "physical-windows-lab",
        1050, 1500, runtime_results());
    spoofed_windows.physical_authenticity_verified = true;
    let spoofed_physical_rejected = false;
    try { E.evaluate_runtime_security(source, portable, runtime_policy,
        runtime, [spoofed_windows, macos], 1200); }
    catch { spoofed_physical_rejected = true; }
    assert(spoofed_physical_rejected,
        "caller-forged physical authenticity flags fail closed");

    let extra_result = runtime_results(); extra_result.claimed_safe = true;
    let extra_result_rejected = false;
    try { E.runtime_security_evidence(source, portable, C, B,
        "independent-runtime-lab", 1000, 1600, extra_result); }
    catch { extra_result_rejected = true; }
    assert(extra_result_rejected,
        "unknown runtime result fields fail the exact schema instead of being ignored");

    let nul_runtime = E.runtime_security_evidence(source, portable, C, B,
        "lab" + strfromcharcode(0) + "suffix", 1000, 1600, runtime_results());
    let plain_runtime = E.runtime_security_evidence(source, portable, C, B,
        "labsuffix", 1000, 1600, runtime_results());
    assert(nul_runtime.evidence_sha256 != plain_runtime.evidence_sha256,
        "byte-length framing keeps embedded separators inside their original field");

    let non_bool_runtime = E.runtime_security_evidence(source, portable, C, B,
        "independent-runtime-lab", 1000, 1600, runtime_results());
    non_bool_runtime.trusted_clock_verified = 0;
    let non_bool_runtime_rejected = false;
    try { E.evaluate_runtime_security(source, portable, runtime_policy,
        non_bool_runtime, [windows, macos], 1200); }
    catch { non_bool_runtime_rejected = true; }
    assert(non_bool_runtime_rejected,
        "fixed runtime trust fields require exact boolean types");

    let non_bool_platform = E.runtime_platform_evidence(source, portable, runtime_policy,
        runtime, "windows", "x86_64", C, "physical-windows-lab",
        1050, 1500, runtime_results());
    non_bool_platform.physical_claimed = 1;
    let non_bool_platform_rejected = false;
    try { E.evaluate_runtime_security(source, portable, runtime_policy,
        runtime, [non_bool_platform, macos], 1200); }
    catch { non_bool_platform_rejected = true; }
    assert(non_bool_platform_rejected,
        "fixed runtime-platform trust fields require exact boolean types");
    print "product_release_evidence_pass";
}

main();
