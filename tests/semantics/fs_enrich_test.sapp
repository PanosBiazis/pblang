// tests/semantics/fs_enrich_test.sapp — enrichment for stdlib/fs.sapp
// Uses relative paths under tests/fixtures (fs.sapp blocks absolute/.. by default).

let F = import("stdlib/fs.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let p = "tests/fixtures/_fs_enrich_tmp.txt";
if F.exists(p) == true { F.remove(p); }   // start clean

// ── touch creates an empty file ────────────────────────────────────────────────────
F.touch(p);
if F.exists(p) != true { fail("touch creates file"); }
if not F.is_empty(p) { fail("touched file is empty"); }
eq(F.count_lines(p), 0, "empty file has 0 lines");

// ── append_line ─────────────────────────────────────────────────────────────────────
F.append_line(p, "alpha");
F.append_line(p, "beta");
if F.is_empty(p) { fail("not empty after append"); }
eq(F.count_lines(p), 2, "two lines");
let lines = F.read_lines(p);
eq(lines[0], "alpha", "line 0");
eq(lines[1], "beta", "line 1");

// ── read_or ─────────────────────────────────────────────────────────────────────────
eq(F.read_or("tests/fixtures/_does_not_exist_xyz.txt", "DEFAULT"), "DEFAULT", "missing -> default");

// cleanup
F.remove(p);
if F.exists(p) == true { fail("cleanup removed file"); }

print "fs_enrich_pass";
