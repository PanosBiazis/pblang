// tests/semantics/loop_range_continue_test.sapp — range-for syntax and
// continue/break correctness across all loop forms.
//
// Two bugs this codifies:
//  1. `for i in A to B { }` (inclusive integer range) must parse and run.
//  2. `continue` in index loops (count-for, for-in, range-for, for-in-kv) must
//     advance the index, not jump before the increment (which spun forever).

// ── range-for: basic inclusive sum 0..4 == 10 ─────────────────────────────────
let s1 = 0;
for i in 0 to 4 {
    s1 = s1 + i;
}
if s1 != 10 { throw "FAIL range-for basic sum: " + str(s1); }

// ── range-for: non-zero start collects [2,3,4,5] ──────────────────────────────
let collected = [];
for i in 2 to 5 {
    push(collected, i);
}
if len(collected) != 4 or collected[0] != 2 or collected[3] != 5 {
    throw "FAIL range-for non-zero start: " + str(collected);
}

// ── range-for + continue: skip 2, sum == 8 ────────────────────────────────────
let s2 = 0;
for i in 0 to 4 {
    if i == 2 { continue; }
    s2 = s2 + i;
}
if s2 != 8 { throw "FAIL range-for continue sum: " + str(s2); }

// ── range-for + continue + local declared AFTER continue (slot-leak guard) ────
let s3 = 0;
for i in 0 to 3 {
    if i == 1 { continue; }
    let doubled = i * 2;
    s3 = s3 + doubled;
}
if s3 != 10 { throw "FAIL range-for continue with trailing local: " + str(s3); }

// ── range-for + break ─────────────────────────────────────────────────────────
let s4 = 0;
for i in 0 to 100 {
    if i == 5 { break; }
    s4 = s4 + i;
}
if s4 != 10 { throw "FAIL range-for break: " + str(s4); }

// ── count-for + continue (was infinite loop) ──────────────────────────────────
let s5 = 0;
for i 5 {
    if i == 2 { continue; }
    s5 = s5 + i;
}
if s5 != 8 { throw "FAIL count-for continue: " + str(s5); }

// ── for-in array + continue (was infinite loop) ───────────────────────────────
let s6 = 0;
for x in [0, 1, 2, 3, 4] {
    if x == 2 { continue; }
    s6 = s6 + x;
}
if s6 != 8 { throw "FAIL for-in continue: " + str(s6); }

// ── for-in-kv + continue ──────────────────────────────────────────────────────
let m = map{ a: 1, b: 2, c: 3 };
let kv_sum = 0;
for k, v in m {
    if v == 2 { continue; }
    kv_sum = kv_sum + v;
}
if kv_sum != 4 { throw "FAIL for-in-kv continue: " + str(kv_sum); }

// ── nested range-for ──────────────────────────────────────────────────────────
let grid = 0;
for a in 0 to 2 {
    for b in 0 to 2 {
        grid = grid + 1;
    }
}
if grid != 9 { throw "FAIL nested range-for: " + str(grid); }

// ── while + continue regression (must still work) ─────────────────────────────
let w = 0;
let wi = 0;
while wi < 5 {
    wi = wi + 1;
    if wi == 3 { continue; }
    w = w + wi;
}
if w != 12 { throw "FAIL while continue regression: " + str(w); }

print "loop_range_continue_pass";
