// tests/semantics/gpu2d_shader_test.sapp — stdlib/gpu2d_shader.sapp
//
// pblang EMITS the GPU shader program for the 2D UI pipeline (WGSL for wgpu/WebGPU, GLSL
// for OpenGL) plus the vertex-buffer LAYOUT that binds gpu2d's 14-float instance buffer to
// the shader's attributes. Same idea as codegen_qasm emitting OpenQASM: the shader is real
// source a GPU toolchain compiles; here we assert its structure is well-formed.

let S = import("stdlib/gpu2d_shader.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn has(hay, needle, m) { if not str_contains(hay, needle) { fail(m + " (missing '" + needle + "')"); } }

// ── vertex layout: the contract between gpu2d's f32 buffer and the shader attributes ──
// gpu2d bakes [x,y,w,h, rad, r,g,b,a, u0,v0,u1,v1, kind] = 14 floats = 56 bytes.
let vl = S.vertex_layout();
eq(vl.stride, 56, "stride = 14 floats * 4 bytes");
eq(len(vl.attributes), 5, "five attributes: rect, rad, color, uv, kind");
eq(vl.attributes[0].offset, 0, "rect at 0");
eq(vl.attributes[1].offset, 16, "rad at 16 (after vec4 rect)");
eq(vl.attributes[2].offset, 20, "color at 20");
eq(vl.attributes[3].offset, 36, "uv at 36");
eq(vl.attributes[4].offset, 52, "kind at 52");

// ── WGSL: a real vertex+fragment module with the SDF corner + atlas sampling ─────────
let w = S.wgsl();
has(w, "@vertex", "wgsl vertex stage");
has(w, "fn vs_main", "wgsl vertex entry");
has(w, "@fragment", "wgsl fragment stage");
has(w, "fn fs_main", "wgsl fragment entry");
has(w, "sd_round_box", "wgsl rounded-rect SDF");
has(w, "viewport", "wgsl viewport uniform (pixels -> NDC)");
has(w, "atlas", "wgsl glyph atlas binding");

// ── GLSL: version + the same three kinds ────────────────────────────────────────────
let gv = S.glsl_vertex();
has(gv, "#version", "glsl vertex version");
has(gv, "gl_Position", "glsl vertex writes gl_Position");
let gf = S.glsl_fragment();
has(gf, "#version", "glsl fragment version");
has(gf, "sd_round_box", "glsl rounded-rect SDF");
has(gf, "texture(", "glsl atlas sample for glyphs");

// ── the three draw kinds are branchable in the fragment shader ───────────────────────
has(w, "kind", "wgsl branches on kind");

// ── mesh pipeline (gpu2d_tess triangles): 24-byte pos+color layout + shaders ─────────
let ml = S.mesh_vertex_layout();
eq(ml.stride, 24, "mesh stride = 6 floats * 4");
eq(len(ml.attributes), 2, "mesh: pos + color");
eq(ml.attributes[0].offset, 0, "pos at 0");
eq(ml.attributes[1].offset, 8, "color at 8 (after vec2 pos)");
let mw = S.mesh_wgsl();
has(mw, "@vertex", "mesh wgsl vertex"); has(mw, "@fragment", "mesh wgsl fragment");
has(mw, "viewport", "mesh wgsl viewport uniform");
has(S.mesh_glsl_vertex(), "gl_Position", "mesh glsl vertex");
has(S.mesh_glsl_fragment(), "fragColor", "mesh glsl fragment");

print "gpu2d_shader_pass";
