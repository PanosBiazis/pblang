// Test: designer round-trip parser (stdlib/ui_parse.sapp) — Visual_Designer D1, §92.
// Reads generated pblang web code back into the designer's component tree (inverse of
// the codegen) via the self-hosted parser. Runs in the VM.
let U = import("stdlib/ui_parse.sapp");

let code = "let html = import(\"x\");\nfn render() { return html.tag(\"h1\", \"Hi\", map{}) + html.tag(\"p\", \"Body\", map{}) + html.a(\"/x\", \"link\", map{}) + html.img(\"s.png\", \"alt\", map{}); }\nmain();";
let tree = U.parse(code);
assert(len(tree) == 4, "four top-level nodes parsed");
assert(tree[0].type == "heading" and tree[0].props.text == "Hi" and tree[0].props.level == "1", "h1 -> heading");
assert(tree[1].type == "text" and tree[1].props.text == "Body", "p -> text");
assert(tree[2].type == "link" and tree[2].props.href == "/x" and tree[2].props.text == "link", "a -> link");
assert(tree[3].type == "image" and tree[3].props.src == "s.png", "img -> image");

// nested container round-trip
let code2 = "fn render() { return html.tag(\"section\", html.tag(\"button\", \"Go\", map{}) + html.tag(\"p\", \"in\", map{}), map{}); }";
let t2 = U.parse(code2);
assert(t2[0].type == "section", "section container");
assert(len(t2[0].children) == 2, "two nested children");
assert(t2[0].children[0].type == "button" and t2[0].children[0].props.text == "Go", "nested button parsed");

// no render() -> empty tree (graceful)
assert(len(U.parse("fn main() { print 1; }")) == 0, "no render() -> empty");
assert(len(U.parse("not valid pblang {{{")) == 0, "parse error -> empty (no crash)");

print "ui_parse_pass";
