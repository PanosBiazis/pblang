let VM = import("stdlib:host_pbck_vm.sapp");

fn fail(message) { throw "FAIL host_pbck_vm_full: " + message; }

fn program(instructions, constants) {
    return map{
        format: "host-pbck-v1", version: 1,
        chunk: map{ instructions: instructions, constants: constants, source_name: nil }
    };
}

fn guest_function(name, instructions, constants) {
    return map{
        __pbck_function: true, name: name, arity: 0, min_arity: 0,
        defaults: [], is_vararg: false, parameter_types_present: false,
        parameter_types: [],
        chunk: map{ instructions: instructions, constants: constants, source_name: nil }
    };
}

if len(VM.SUPPORTED_OPCODES) != 48 { fail("opcode registry is not complete"); }
let opcode_i = 0;
while opcode_i < 48 {
    if VM.SUPPORTED_OPCODES[opcode_i] != opcode_i {
        fail("opcode registry is not canonical at " + str(opcode_i));
    }
    opcode_i = opcode_i + 1;
}

let exported = VM.run_decoded(program([
    map{ op: 0, operand: 0 }, map{ op: 13, operand: 1 },
    map{ op: 18, operand: 1 }, map{ op: 0, operand: 2 }, map{ op: 33 }
], [42, "answer", "done"]));
if exported.value != "done" or exported.exports.answer != 42 {
    fail("export semantics mismatch");
}
if not (try {
    VM.run_decoded(program([map{ op: 18, operand: 0 }], ["missing"]));
    false
} catch true) { fail("undefined export did not fail closed"); }

let power = VM.run_decoded(program([
    map{ op: 0, operand: 0 }, map{ op: 0, operand: 1 },
    map{ op: 41 }, map{ op: 33 }
], [2, 8]));
if power.value != 256 { fail("power semantics mismatch"); }

fn safe_attr(value, name) {
    return VM.run_decoded(program([
        map{ op: 0, operand: 0 }, map{ op: 42, operand: 1 }, map{ op: 33 }
    ], [value, name])).value;
}
if safe_attr(map{ value: 7 }, "value") != 7 { fail("safe attribute hit mismatch"); }
if safe_attr(map{}, "missing") != nil or safe_attr(nil, "missing") != nil {
    fail("safe attribute miss mismatch");
}
if not (try { safe_attr(7, "value"); false } catch true) {
    fail("safe attribute accepted a non-map target");
}

fn safe_index(value, index) {
    return VM.run_decoded(program([
        map{ op: 0, operand: 0 }, map{ op: 0, operand: 1 },
        map{ op: 43 }, map{ op: 33 }
    ], [value, index])).value;
}
if safe_index([3, 5], 1) != 5 or safe_index([3, 5], 1.9) != 5
    or safe_index("abc", 2) != "c" or safe_index("abc", 1.9) != "b" {
    fail("safe sequential index mismatch");
}
if safe_index(map{ key: 9 }, "key") != 9 or safe_index([1], 4) != nil {
    fail("safe map/index miss mismatch");
}
if safe_index(nil, 0) != nil or safe_index(42, 0) != nil {
    fail("safe non-indexable fallback mismatch");
}
if not (try { safe_index([1], "0"); false } catch true) {
    fail("safe array index accepted a non-number");
}
if not (try { safe_index(map{}, 0); false } catch true) {
    fail("safe map index accepted a non-string");
}

fn unwrap(value) {
    return VM.run_decoded(program([
        map{ op: 0, operand: 0 }, map{ op: 44 }, map{ op: 33 }
    ], [value])).value;
}
if unwrap(map{ ok: true, value: 11 }) != 11 or unwrap(map{ ok: true }) != nil {
    fail("successful result unwrap mismatch");
}
let passthrough = map{ value: 12 };
if unwrap(passthrough).value != 12 { fail("non-result unwrap passthrough mismatch"); }

let caught_unwrap = VM.run_decoded(program([
    map{ op: 23, operand: 4 }, map{ op: 0, operand: 0 },
    map{ op: 44 }, map{ op: 24 }, map{ op: 33 }
], [map{ ok: false, error: "expected-result-error" }]));
if caught_unwrap.value != "expected-result-error" {
    fail("result unwrap did not enter the guest exception path");
}
if not (try { unwrap(nil); false } catch true) { fail("nil result unwrap did not fail"); }

fn recorder_function(label) {
    return guest_function("record_" + label, [
        map{ op: 14, operand: 0 }, map{ op: 0, operand: 1 },
        map{ op: 31, operand: 1 }, map{ op: 33 }
    ], ["record", label]);
}

let first_cleanup = recorder_function("first");
let second_cleanup = recorder_function("second");
let cleanup_log = [];
let deferred = VM.run_decoded(program([
    map{ op: 27, fn_const: 0, captures: [] }, map{ op: 34 },
    map{ op: 27, fn_const: 1, captures: [] }, map{ op: 34 },
    map{ op: 0, operand: 2 }, map{ op: 33 }
], [first_cleanup, second_cleanup, 42]), map{ adapters: map{
    record: fn(args) { array_push(cleanup_log, args[0]); return nil; }
} });
if deferred.value != 42 or len(cleanup_log) != 2
    or cleanup_log[0] != "second" or cleanup_log[1] != "first" {
    fail("defer LIFO or return-value preservation mismatch");
}

let target = guest_function("target", [
    map{ op: 0, operand: 0 }, map{ op: 33 }
], [7]);
let tail_cleanup = recorder_function("tail-cleanup");
let tail_log = [];
let guarded_tail = VM.run_decoded(program([
    map{ op: 27, fn_const: 0, captures: [] }, map{ op: 34 },
    map{ op: 27, fn_const: 1, captures: [] }, map{ op: 32, operand: 0 },
    map{ op: 33 }
], [tail_cleanup, target]), map{ adapters: map{
    record: fn(args) { array_push(tail_log, args[0]); return nil; }
} });
if guarded_tail.value != 7 or guarded_tail.runtime.tail_calls != 0
    or len(tail_log) != 1 or tail_log[0] != "tail-cleanup" {
    fail("defer-aware tail call fallback mismatch");
}

let failing_cleanup = guest_function("failing_cleanup", [
    map{ op: 14, operand: 0 }, map{ op: 31, operand: 0 }, map{ op: 33 }
], ["fail_cleanup"]);
if not (try {
    VM.run_decoded(program([
        map{ op: 27, fn_const: 0, captures: [] }, map{ op: 34 },
        map{ op: 0, operand: 1 }, map{ op: 33 }
    ], [failing_cleanup, 1]), map{ adapters: map{
        fail_cleanup: fn(_args) { throw "private-cleanup-detail"; }
    } });
    false
} catch true) { fail("failing deferred call did not fail closed"); }

print "host_pbck_vm_full_pass";
