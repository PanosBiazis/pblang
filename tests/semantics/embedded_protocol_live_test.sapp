let Live = import("stdlib:embedded_protocol_live.sapp");
let P = import("stdlib:embedded_protocol.sapp");

let fixtures=Live.cases();
if P.decode_command(fixtures.invalid_opcode).ok{throw "unsupported opcode fixture";}
if P.decode_command(fixtures.invalid_interval).ok{throw "invalid interval fixture";}
if P.decode_command(fixtures.corrupt_checksum).ok{throw "corrupt checksum fixture";}
let overlap=P.feed(P.new_decoder("command"),fixtures.overlapping_magic);
if not overlap.ok or len(overlap.frames)!=1 or overlap.frames[0].sequence!=200{
    throw "overlapping magic fixture";
}
let denied=Live.verify("/dev/ttyUSB1",true,50);
if denied.ok or denied.code!="permission"{throw "live test defaults to denied";}
let failed=Live.conformance_report(
    map{board:"arduino-uno",artifact_sha256:"expected-only"},
    map{ok:true,mcu:"atmega328p",exact_mcu:true},
    [map{name:"digital-loopback",pass:false},map{name:"safe-final-state",pass:true},
     map{name:"termios-restored",pass:true}],"digital loopback failed");
if failed.ok or failed.protocol_conformance or failed.passed!=2
   or not failed.safe_final_state or not failed.termios_restored{
    throw "failed checks must never report protocol conformance";
}
print "embedded_protocol_live_pass";
