// tests/semantics/quantum_sim_enrich_test.sapp — enrichment for stdlib/quantum_sim.sapp
// Adds s_gate/t_gate/phase_gate, swap_gate, probabilities, expectation_z.

let q = import("stdlib/quantum_sim.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.000001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── ENRICH: probabilities ────────────────────────────────────────────────────────
let p0 = q.probabilities(q.zero_state(2));
near(p0[0], 1, "|00> prob 1"); near(p0[1], 0, "|00> others 0");

// ── ENRICH: expectation_z ────────────────────────────────────────────────────────
near(q.expectation_z(q.zero_state(1), 0), 1, "<Z> of |0> = +1");
let hplus = q.h_gate(q.zero_state(1), 0);
near(q.expectation_z(hplus, 0), 0, "<Z> of |+> = 0");

// ── ENRICH: s_gate applies an i phase to |1> (prob unchanged) ─────────────────────
let s1 = q.s_gate(hplus, 0);
let ps = q.probabilities(s1);
near(ps[0], 0.5, "s_gate keeps prob[0]"); near(ps[1], 0.5, "s_gate keeps prob[1]");
near(s1[1][0], 0, "s_gate: |1> amp real part -> 0"); near(s1[1][1], 0.7071067811865476, "s_gate: |1> amp imag part");

// ── ENRICH: phase_gate(pi/2) == s_gate ───────────────────────────────────────────
let pg = q.phase_gate(hplus, 0, 1.5707963267948966);
near(pg[1][0], s1[1][0], "phase(pi/2) re matches s_gate"); near(pg[1][1], s1[1][1], "phase(pi/2) im matches s_gate");

// ── ENRICH: t_gate applied twice == s_gate (T^2 = S) ─────────────────────────────
let tt = q.t_gate(q.t_gate(hplus, 0), 0);
let y0 = q.y_gate(q.zero_state(1), 0);
near(y0[0][0], 0, "Y|0> zero amplitude real"); near(y0[0][1], 0, "Y|0> zero amplitude imag");
near(y0[1][0], 0, "Y|0> output real"); near(y0[1][1], 1, "Y|0> = i|1>");
let y1 = q.y_gate(q.x_gate(q.zero_state(1), 0), 0);
near(y1[0][0], 0, "Y|1> output real"); near(y1[0][1], -1, "Y|1> = -i|0>");
near(tt[1][0], s1[1][0], "T^2 re = S"); near(tt[1][1], s1[1][1], "T^2 im = S");

// ── ENRICH: swap_gate ────────────────────────────────────────────────────────────
let st = q.x_gate(q.zero_state(2), 0);   // |..> with qubit0 set -> index 1
let sw = q.swap_gate(st, 0, 1);          // move the set bit to qubit1 -> index 2
let psw = q.probabilities(sw);
near(psw[2], 1, "swap moved amplitude to index 2");

print "quantum_sim_enrich_pass";
