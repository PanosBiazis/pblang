// tests/semantics/pbz_test.sapp — LZSS codec: correctness (round-trip) + it compresses.
let z = import("stdlib:pbz.sapp");

fn fail(m) { throw "FAIL " + m; }
fn rt(s) {
    let c = z.compress_str(s);
    let back = z.decompress_str(c);
    if back != s { fail("round-trip mismatch for len " + str(len(s))); }
    return len(c);
}

// round-trip across shapes
rt("");
rt("a");
rt("ab");
rt("abc");
rt("hello world");
rt("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");          // long run
rt("abcabcabcabcabcabcabcabcabcabcabc");          // periodic
rt("fn add(a, b) { return a + b; } let x = add(1, 2); print x;");

// a realistic repetitive payload compresses (compressed < original)
let big = "";
let i = 0;
while i < 80 { big = big + "the quick brown fox jumps over the lazy dog. "; i = i + 1; }
let orig = len(str_to_bytes(big));
let comp = len(z.compress_str(big));
if comp >= orig { fail("repetitive data should shrink (orig " + str(orig) + " comp " + str(comp) + ")"); }
if z.decompress_str(z.compress_str(big)) != big { fail("big round-trip"); }
print "pbz ratio on sample: " + str(z.ratio(orig, comp)) + "x (" + str(orig) + " -> " + str(comp) + ")";

// binary bytes (incl. 0 and 255) round-trip
let bytes = [];
let b = 0;
while b < 256 { array_push(bytes, b); b = b + 1; }
let cb = z.compress(bytes);
let rb = z.decompress(cb);
if len(rb) != 256 { fail("binary length"); }
let k = 0;
while k < 256 { if rb[k] != bytes[k] { fail("binary byte " + str(k)); } k = k + 1; }

// ── Huffman stage directly ───────────────────────────────────────────────────
let hb = str_to_bytes("aaaaaaaabbbbccd");   // skewed distribution
let he = z.huffman_encode(hb);
if he == nil { fail("huffman_encode bailed unexpectedly"); }
let hd = z.huffman_decode(he, 0);
if len(hd) != len(hb) { fail("huffman round-trip length"); }
let q = 0;
while q < len(hb) { if hd[q] != hb[q] { fail("huffman byte " + str(q)); } q = q + 1; }

// Huffman+LZSS (level 1) is never worse than LZSS-only (level 0) for our sample
let c1 = z.compress(str_to_bytes(big), 1);
let c0 = z.compress(str_to_bytes(big), 0);
if len(c1) > len(c0) { fail("level-1 should not be larger than level-0"); }
if z.decompress_str(c1) != big or z.decompress_str(c0) != big { fail("both levels round-trip"); }
print "pbz level0=" + str(len(c0)) + " level1=" + str(len(c1));

print "pbz_pass";
