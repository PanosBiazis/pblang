// The current self-hosted VM represents callables as ordinary maps. Do not
// accept forgeable map markers as a substitute for runtime callable types.
// This is refusal coverage, not a claim of active-backend compatibility.
let Frontend = import("stdlib:compiler/selfhost_frontend.sapp");
let source = "let S=import(\"stdlib:implementation_switch.sapp\"); let c=map{calls:0}; let factory=fn(){c.calls=c.calls+1;return 42;}; let registry=map{pblang:factory}; print (try S.open(false,\"pblang\",registry) catch \"disabled\"); print (try S.bind(false,\"pblang\",registry) catch \"disabled\"); print (try S.open(true,\"pblang\",registry) catch \"unsupported\"); print (try S.bind(true,\"pblang\",registry) catch \"unsupported\"); print c.calls; print type(factory);";
let result = Frontend.frontend_run(source);
if not result.ok or result.output != ["disabled","disabled","unsupported","unsupported",0,"map"] {
    throw "selfhost implementation selection boundary changed; review callable support";
}
print "selfhost_implementation_switch_boundary_pass";
