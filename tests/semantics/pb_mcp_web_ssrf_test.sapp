// tests/semantics/pb_mcp_web_ssrf_test.sapp — lock the pb-mcp-server SSRF
// private-host guard (web_tools.sapp _private_host).
//
// Bug this locks: the 172.16-31.x branch called the NONEXISTENT builtin
// `int(...)`, so any 172.x URL made the guard THROW instead of returning a
// clean deny — web_api_call/web_download_file crashed on exactly the hosts
// they exist to reject.

let web = import("editors/ide/tools/mcpservers/pb-mcp-server/src/web_tools.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

fn probe(url) {
    // sentinel: nil = the call THREW (the bug); a map = clean result
    return try web.web_api_call(map{ url: url }) catch nil;
}

// ── 172.16-31.x is RFC1918 private: clean deny, NO throw ────────────────────
let r = probe("http://172.20.1.5/admin");
if r == nil { fail("172.20.x guard threw instead of denying"); }
eq(r.ssrf_private_host, true, "172.20.x flagged private");
eq(r.ok, false, "172.20.x denied");

// boundary octets
eq(probe("http://172.16.0.1/").ssrf_private_host, true, "172.16 lower bound private");
eq(probe("http://172.31.9.9/").ssrf_private_host, true, "172.31 upper bound private");

// ── 172.x OUTSIDE 16-31 is public ────────────────────────────────────────────
eq(probe("http://172.15.0.1/").ssrf_private_host, false, "172.15 is public");
eq(probe("http://172.32.0.1/").ssrf_private_host, false, "172.32 is public");

// malformed second octet must not crash the guard either
let m = probe("http://172.bad.0.1/");
if m == nil { fail("non-numeric 172.x octet crashed the guard"); }

// ── other private families still flagged ─────────────────────────────────────
eq(probe("http://10.0.0.8/").ssrf_private_host, true, "10.x private");
eq(probe("http://192.168.1.1/").ssrf_private_host, true, "192.168.x private");
eq(probe("http://localhost/").ssrf_private_host, true, "localhost private");
eq(probe("https://example.com/").ssrf_private_host, false, "example.com public");

print "pb_mcp_web_ssrf_pass";
