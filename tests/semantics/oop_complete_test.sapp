// Test: the completed pblang OOP system (stdlib/class.sapp).
// Covers inheritance + super, mixins, static methods, bound methods, operator
// overloading bridged onto instances, deep instanceof, and introspection — all
// implemented in pblang (no Rust changes).

let oop = import("stdlib:class.sapp");

// --- Inheritance + super ---
let Animal = oop.define("Animal", ["name"], map{
    speak: fn(self) { return self.name + " makes a sound"; },
    describe: fn(self) { return "I am " + self.name; }
});

let Dog = oop.extend(Animal, "Dog", [], map{
    // override speak, but reuse the parent's via super
    speak: fn(self) { return oop.super_call(self, "speak") + " (woof)"; }
});

let d = oop.new(Dog, map{ name: "Rex" });
assert(oop.call(d, "speak") == "Rex makes a sound (woof)", "super_call reuses parent method");
assert(oop.call(d, "describe") == "I am Rex", "inherited method works");
assert(oop.instanceof(d, Dog) == true, "instanceof Dog");
assert(oop.instanceof(d, Animal) == true, "instanceof Animal (inherited)");
assert(oop.class_name(d) == "Dog", "class_name is Dog");

// --- super with an argument ---
let Shape = oop.define("Shape", ["name"], map{
    area: fn(self, scale) { return 10 * scale; }
});
let Big = oop.extend(Shape, "Big", [], map{
    area: fn(self, scale) { return oop.super1(self, "area", scale) * 2; }
});
let big = oop.new(Big, map{ name: "b" });
assert(oop.call1(big, "area", 3) == 60, "super1 passes arg to parent (10*3*2)");

// --- Mixins (trait-style composition) ---
let Walks = map{ walk: fn(self) { return self.name + " walks"; } };
let Swims = map{ swim: fn(self) { return self.name + " swims"; } };
let Amphibian = oop.mixin(oop.mixin(oop.define("Amphibian", ["name"], map{}), Walks), Swims);
let frog = oop.new(Amphibian, map{ name: "Kermit" });
assert(oop.call(frog, "walk") == "Kermit walks", "mixin Walks");
assert(oop.call(frog, "swim") == "Kermit swims", "mixin Swims");

// --- Static (class-level) methods ---
let Counter = oop.define("Counter", ["n"], map{});
oop.define_static(Counter, "zero", fn() { return 0; });
oop.define_static(Counter, "of", fn(v) { return v; });
assert(oop.call_static(Counter, "zero") == 0, "static zero()");
assert(oop.call_static1(Counter, "of", 42) == 42, "static of(42)");

// --- Bound methods ---
let greet_d = oop.bind0(d, "describe");
assert(greet_d() == "I am Rex", "bind0 produces a callable bound method");
let area_big = oop.bind1(big, "area");
assert(area_big(5) == 100, "bind1 carries instance, takes 1 arg");

// --- Operator overloading bridged onto class.sapp instances ---
let Vec = oop.define("Vec", ["x", "y"], map{
    __add__: fn(self, o) { return oop.new(Vec, map{ x: self.x + o.x, y: self.y + o.y }); },
    __eq__:  fn(self, o) { return self.x == o.x and self.y == o.y; },
    __lt__:  fn(self, o) { return (self.x * self.x + self.y * self.y) < (o.x * o.x + o.y * o.y); }
});
let v1 = oop.new(Vec, map{ x: 1, y: 2 });
let v2 = oop.new(Vec, map{ x: 3, y: 4 });
let v3 = v1 + v2;                       // native + dispatches the bridged __add__
assert(v3.x == 4 and v3.y == 6, "operator + works on class.sapp instance");
assert((v1 == oop.new(Vec, map{ x: 1, y: 2 })) == true, "operator == bridged");
assert((v1 < v2) == true, "operator < bridged (magnitude order)");

// --- Inherited operators: a subclass keeps the parent's dunders ---
let Vec3ish = oop.extend(Vec, "Vec3ish", [], map{});
let w1 = oop.new(Vec3ish, map{ x: 2, y: 2 });
let w2 = oop.new(Vec3ish, map{ x: 5, y: 5 });
let w3 = w1 + w2;
assert(w3.x == 7 and w3.y == 7, "subclass inherits __add__ operator");

// --- Introspection ---
assert(len(oop.field_names(Animal)) == 1, "field_names");
assert(oop.parent_of(Dog) == Animal, "parent_of");

print "oop_complete_pass";
