let F = import("stdlib:compiler/selfhost_frontend.sapp");
let V = import("stdlib:compiler/vm.sapp");
fn expect(ok, message) { if not ok { throw "FAIL numeric-loop: " + message; } }
fn run(source) {
    let compiled = F.frontend_compile(source);
    expect(compiled.ok and len(compiled.diagnostics) == 0, "checked compilation");
    let plain = V.run_bounded(compiled.chunk, map{ max_steps: 5000, max_frames: 12 });
    let optimized = F.frontend_run_bounded(source, map{ max_steps: 5000, max_frames: 12 });
    expect(optimized.ok and plain.globals.result == optimized.globals.result, "plain/optimized agree");
    return plain.globals.result;
}
expect(run("let x = 99; for x in 1 to 2 { } let result = x;") == 99, "outer global restored");
expect(run("fn f(x) { for x in 1 to 2 { } return x; } let result = f(99);") == 99, "outer local restored");
expect(run("let x = 99; for x in 3 to 2 { } let result = x;") == 99, "empty range");
expect(run("let x = 2; let seen = []; for x in x to x + 1 { array_push(seen, x); } let result = [x, seen];") == [2, [2, 3]], "both bounds resolve outer binder");
expect(run("let seen = []; fn bound(n) { array_push(seen, n); return n; } for x in bound(1) to bound(2) { array_push(seen, x + 10); } let result = seen;") == [1, 2, 11, 12], "left-to-right once-only bounds");
expect(run("let end = 3; let seen = []; for x in 1 to end { array_push(seen, x); end = 0; } let result = seen;") == [1, 2, 3], "end value retained");
expect(run("let seen = []; for x in 1 to 3 { array_push(seen, x); x = 100; } let result = seen;") == [1, 2, 3], "binder does not change internal counter");
expect(run("let x = 99; let seen = []; for x in 1 to 2 { for x in 3 to 3 { array_push(seen, x); } array_push(seen, x); } let result = [x, seen];") == [99, [3, 1, 3, 2]], "nested binders");
expect(run("let x = 99; let seen = []; for x in 0 to 3 { if x == 0 { continue; } let y = x; array_push(seen, y); if x == 2 { break; } } let result = [x, seen];") == [99, [1, 2]], "continue and break");
expect(run("let x = 99; let seen = []; for x in 1 to 1 { array_push(seen, x); } for x in 2 to 2 { array_push(seen, x); } let result = [x, seen];") == [99, [1, 2]], "sibling binders");
expect(run("let π = 99; for π in -2 to -1 { } let result = π;") == 99, "Unicode and negative range");
expect(run("fn f(x) { let out = []; for x in 1 to 2 { array_push(out, fn() { return x; }); } return [out[0](), out[1](), x]; } let result = f(99);") == [1, 2, 99], "by-value closures");
expect(run("let __for_bound_x = 2; let __for_i_x = 9; let seen = []; for x in 1 to __for_bound_x { array_push(seen, __for_i_x); } let result = seen;") == [9, 9], "helper-like source names");
expect(run("fn f() { for x in 7 to 8 { return x; } return 0; } let result = f();") == 7, "early return");
expect(not F.frontend_compile("for x in 1 to 2 { } let result = x;").ok, "binder does not leak into outer checked scope");
expect(run("let seen = []; fn bound(n) { array_push(seen, n); return n; } for x in bound(3) to bound(2) { array_push(seen, 9); } let result = seen;") == [3, 2], "empty range evaluates both bounds once");
expect(run("let seen = []; fn boom() { array_push(seen, 9); throw 4; } fn finish() { array_push(seen, 8); return 2; } fn f() { for x in boom() to finish() { array_push(seen, 1); } return 0; } let result = [try f() catch 5, seen];") == [5, [9]], "start exception skips end and body");
expect(run("let seen = []; fn start() { array_push(seen, 8); return 1; } fn boom() { array_push(seen, 9); throw 4; } fn f() { for x in start() to boom() { array_push(seen, 1); } return 0; } let result = [try f() catch 5, seen];") == [5, [8, 9]], "end exception follows start and skips body");
expect(not F.frontend_compile("for x in absent to 2 { }").ok, "undefined start rejected");
expect(not F.frontend_compile("for x in 1 to absent { }").ok, "undefined end rejected");
expect(not F.frontend_compile("for x in 1 to { }").ok, "malformed range rejected");
print "selfhost_range_scope_pass";
