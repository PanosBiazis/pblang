let T=import("stdlib:compiler/tokenizer.sapp");
fn expect(ok,label) {if not ok {throw "FAIL tokenizer-bounds: "+label;}}
let sources=[""," \r\n\t","x","let π=\"😀\\n\";", "a-1; -2; 0xff; 0b10; 0o7; 1.2e-3;",
    "a?.b ?? a?[0]; a<<2; a>>1; a+=2;", "// text\n/* block */ x", "\"unclosed", "/* unclosed"];
for source in sources {
    for spans in [false,true] {
        let legacy=T.tokenize(source,spans);let count=len(legacy);
        let exact=T.tokenize_bounded(source,count,spans);
        expect(exact.ok and exact.token_count==count and not exact.limit_exceeded,"exact cap including EOF");
        expect(json_stringify(exact.tokens)==json_stringify(legacy),"legacy token schema/text/positions parity");
        expect(exact.tokens[count-1].kind=="eof","EOF retained");
        if count>1 {
            let small=T.tokenize_bounded(source,count-1,spans);
            expect(not small.ok and small.limit_exceeded and small.token_count==0
                and len(small.tokens)==0,"no partial token stream");
        }
    }
    expect(json_stringify(T.tokenize(source))==json_stringify(T.tokenize(source,false)),"legacy default arity");
}
for bad in [nil,true,"private-token-marker",[],map{},-1,0,1.5,1048577,
    parse_number("NaN"),parse_number("inf"),parse_number("-inf"),bigint(2),decimal("2"),rational("2/1")] {
    let result=T.tokenize_bounded("private-token-marker",bad);
    expect(not result.ok and not result.limit_exceeded and len(result.tokens)==0,"invalid cap");
    expect(not str_contains(json_stringify(result),"private-token-marker"),"invalid value privacy");
}
expect(T.tokenize_bounded("",1048576).ok,"hard maximum accepted");
expect(not T.tokenize_bounded(42,2).ok,"invalid source type");
expect(not T.tokenize_bounded("x",2,nil).ok,"invalid spans type");
let early=T.tokenize_bounded("\"private-token-marker",1);
expect(not early.ok and early.error=="token limit exceeded"
    and not str_contains(json_stringify(early),"private-token-marker"),"reject before constructing next string token");
print "selfhost_tokenizer_bounds_pass";
