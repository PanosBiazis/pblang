let POLY = import("stdlib:polyglot.sapp");

let denied = POLY.run_block("python3", "print('must not execute')");
if denied.ok or denied.executed or denied.raw_fallback {
    throw "polyglot run_block must fail closed without trusted_source";
}

let unknown = POLY.run_block("not-a-language", "print(1)", map{ trusted_source: true });
if unknown.ok or unknown.executed {
    throw "unknown polyglot language must fail before execution";
}

print "polyglot_exec_python_pass";
