// tests/semantics/polyglot_exec_test.sapp — PL1-alpha: polyglot execution bridge test
import "stdlib:polyglot.sapp";

// Test run_block with python (skip if not available)
let result = try polyglot.run_block("python3", "print('hello from python')") catch map{ ok: false, stdout: "", stderr: "not available", exit_code: -1 };

if result.ok {
    let has_hello = str_contains(result.stdout, "hello from python");
    if has_hello {
        print "polyglot_python_exec: ok";
    } else {
        print "polyglot_python_exec: FAIL stdout=" + result.stdout;
    }
} else {
    // Python not available - acceptable skip
    print "polyglot_python_exec: skipped (python not found)";
}

// Test that run_block returns correct structure
let r2 = try polyglot.run_block("bash", "echo test") catch map{ ok: false, stdout: "", stderr: "not available", exit_code: -1 };
let has_fields = r2 != nil;
if has_fields {
    print "polyglot_struct_ok: ok";
} else {
    print "polyglot_struct_ok: FAIL";
}

print "polyglot_exec_python_pass";
