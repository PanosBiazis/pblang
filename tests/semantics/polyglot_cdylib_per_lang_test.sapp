// tests/semantics/polyglot_cdylib_per_lang_test.sapp — PL2-beta
//
// Per-toolchain cdylib roundtrip: for every language pblang.compile_cached
// supports, try to build a tiny `pblang_add(i64, i64) -> i64` shared
// library, load it, and call it with (40, 2) expecting 42.
//
// Every block is gated on `polyglot.detect()` so the test passes cleanly on
// any host — present toolchains run for real, absent ones report "skipped".
// This is the same pattern used by polyglot_cached_test for the existing C
// path; here we cover all 16 cdylib languages.

import "stdlib:polyglot.sapp";

let langs = polyglot.detect();

fn lang_available(name) {
    if langs == nil or langs == map{} {
        return false;
    }
    let info = try langs[name] catch nil;
    if info == nil {
        return false;
    }
    return info.available;
}

fn try_cdylib(label, lang, code) {
    let h = try polyglot.compile_cached(lang, code) catch -1;
    if h == -1 {
        print "polyglot_cdylib_" + label + ": FAIL (compile_cached returned error)";
        return;
    }
    let r = try ffi_call_typed(h, "pblang_add", "i64,i64->i64", [40, 2]) catch -1;
    if r == 42 {
        print "polyglot_cdylib_" + label + ": ok";
    } else {
        print "polyglot_cdylib_" + label + ": FAIL r=" + str(r);
    }
    try ffi_close(h) catch nil;
}

// ── Rust ────────────────────────────────────────────────────────────────────
if lang_available("rust") {
    try_cdylib("rust", "rust",
        "#[no_mangle]\npub extern \"C\" fn pblang_add(a: i64, b: i64) -> i64 { a + b }\n");
} else {
    print "polyglot_cdylib_rust: skipped (rustc not found)";
}

// ── C ────────────────────────────────────────────────────────────────────────
if lang_available("c") {
    try_cdylib("c", "c",
        "long pblang_add(long a, long b) { return a + b; }\n");
} else {
    print "polyglot_cdylib_c: skipped (no C compiler)";
}

// ── C++ ──────────────────────────────────────────────────────────────────────
if lang_available("cpp") {
    try_cdylib("cpp", "cpp",
        "extern \"C\" long pblang_add(long a, long b) { return a + b; }\n");
} else {
    print "polyglot_cdylib_cpp: skipped (no C++ compiler)";
}

// ── Go ───────────────────────────────────────────────────────────────────────
if lang_available("go") {
    try_cdylib("go", "go",
        "package main\n\nimport \"C\"\n\n//export pblang_add\nfunc pblang_add(a, b C.long) C.long { return a + b }\n\nfunc main() {}\n");
} else {
    print "polyglot_cdylib_go: skipped (go not found)";
}

// ── Pascal ───────────────────────────────────────────────────────────────────
if lang_available("pascal") {
    try_cdylib("pascal", "pascal",
        "library prog;\nfunction pblang_add(a, b: Int64): Int64; cdecl; export;\nbegin\n  pblang_add := a + b;\nend;\nexports pblang_add;\nbegin\nend.\n");
} else {
    print "polyglot_cdylib_pascal: skipped (fpc not found)";
}

// ── C# (NativeAOT) ───────────────────────────────────────────────────────────
// Requires .NET SDK 8+ AND the NativeAOT workload installed.
if lang_available("csharp") {
    try_cdylib("csharp", "csharp",
        "using System.Runtime.InteropServices;\n\npublic static class Native {\n  [UnmanagedCallersOnly(EntryPoint = \"pblang_add\")]\n  public static long Add(long a, long b) => a + b;\n}\n");
} else {
    print "polyglot_cdylib_csharp: skipped (dotnet not found)";
}

// ── F# (NativeAOT) ───────────────────────────────────────────────────────────
if lang_available("fsharp") {
    try_cdylib("fsharp", "fsharp",
        "module Native\n\nopen System.Runtime.InteropServices\n\n[<UnmanagedCallersOnly(EntryPoint = \"pblang_add\")>]\nlet pblangAdd (a: int64) (b: int64) : int64 = a + b\n");
} else {
    print "polyglot_cdylib_fsharp: skipped (dotnet not found)";
}

// ── Zig ──────────────────────────────────────────────────────────────────────
if lang_available("zig") {
    try_cdylib("zig", "zig",
        "export fn pblang_add(a: i64, b: i64) callconv(.C) i64 {\n    return a + b;\n}\n");
} else {
    print "polyglot_cdylib_zig: skipped (zig not found)";
}

// ── D ────────────────────────────────────────────────────────────────────────
if lang_available("d") {
    try_cdylib("d", "d",
        "extern (C) export long pblang_add(long a, long b) {\n    return a + b;\n}\n");
} else {
    print "polyglot_cdylib_d: skipped (no D compiler)";
}

// ── Nim ──────────────────────────────────────────────────────────────────────
if lang_available("nim") {
    try_cdylib("nim", "nim",
        "proc pblang_add(a: int64, b: int64): int64 {.exportc, dynlib, cdecl.} =\n  result = a + b\n");
} else {
    print "polyglot_cdylib_nim: skipped (nim not found)";
}

// ── Swift ────────────────────────────────────────────────────────────────────
if lang_available("swift") {
    try_cdylib("swift", "swift",
        "@_cdecl(\"pblang_add\")\npublic func pblangAdd(_ a: Int64, _ b: Int64) -> Int64 { return a + b }\n");
} else {
    print "polyglot_cdylib_swift: skipped (swiftc not found)";
}

// ── Haskell ──────────────────────────────────────────────────────────────────
if lang_available("haskell") {
    try_cdylib("haskell", "haskell",
        "module Src where\n\nimport Foreign.C.Types\n\npblang_add :: CLong -> CLong -> CLong\npblang_add a b = a + b\n\nforeign export ccall pblang_add :: CLong -> CLong -> CLong\n");
} else {
    print "polyglot_cdylib_haskell: skipped (ghc not found)";
}

// ── Fortran ──────────────────────────────────────────────────────────────────
if lang_available("fortran") {
    try_cdylib("fortran", "fortran",
        "function pblang_add(a, b) result(c) bind(c, name=\"pblang_add\")\n  use iso_c_binding, only: c_long\n  integer(c_long), value :: a, b\n  integer(c_long) :: c\n  c = a + b\nend function pblang_add\n");
} else {
    print "polyglot_cdylib_fortran: skipped (no Fortran compiler)";
}

// ── Objective-C ──────────────────────────────────────────────────────────────
if lang_available("objc") {
    try_cdylib("objc", "objc",
        "long pblang_add(long a, long b) { return a + b; }\n");
} else {
    print "polyglot_cdylib_objc: skipped (no Obj-C-capable compiler)";
}

// ── OCaml ────────────────────────────────────────────────────────────────────
// OCaml's shared-lib FFI requires registering callbacks via Caml/CFunction
// and initializing the runtime. A simple C-ABI smoke-test like the others
// doesn't apply directly without runtime bootstrap — report "available, smoke
// skipped" so the matrix is honest about coverage.
if lang_available("ocaml") {
    print "polyglot_cdylib_ocaml: skipped (smoke pattern not portable to OCaml runtime; build works, exports require Caml callbacks)";
} else {
    print "polyglot_cdylib_ocaml: skipped (ocamlopt not found)";
}

// ── Java (GraalVM native-image) ──────────────────────────────────────────────
// GraalVM @CEntryPoint requires an IsolateThread first parameter — to call
// it from pblang FFI you must first call graal_create_isolate(). The build
// side is what compile_cached covers; the call side needs an isolate setup
// that's out of scope for this smoke test. Report "build path supported,
// invocation requires isolate bootstrap".
let java_native = false;
if langs != nil and langs != map{} {
    let ni_info = try langs["native-image"] catch nil;
    if ni_info != nil {
        java_native = ni_info.available;
    }
}
if java_native {
    print "polyglot_cdylib_java: skipped (build path supported; smoke invocation needs graal_create_isolate)";
} else {
    print "polyglot_cdylib_java: skipped (native-image not found)";
}

// ── Kotlin (Kotlin/Native) ───────────────────────────────────────────────────
let kn_present = false;
if langs != nil and langs != map{} {
    let kn_info = try langs["kotlin-native"] catch nil;
    if kn_info != nil {
        kn_present = kn_info.available;
    }
}
if kn_present {
    try_cdylib("kotlin", "kotlin",
        "import kotlinx.cinterop.*\n\n@CName(\"pblang_add\")\nfun pblangAdd(a: Long, b: Long): Long = a + b\n");
} else {
    print "polyglot_cdylib_kotlin: skipped (kotlinc-native not found)";
}

print "polyglot_cdylib_per_lang_pass";
