let POLY = import("stdlib:polyglot.sapp");
if POLY.language_count() < 1 { throw "polyglot catalog is unavailable"; }

let languages = ["c", "cpp", "rust", "go", "d", "java", "kotlin"];
let i = 0;
while i < len(languages) {
    if not (try { POLY.compile_cached(languages[i], "foreign source"); false } catch true) {
        throw "legacy in-process cdylib loading must stay disabled";
    }
    i = i + 1;
}

print "polyglot_cdylib_legacy: blocked";
print "polyglot_cdylib_per_lang_pass";
