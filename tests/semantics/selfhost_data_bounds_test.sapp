let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
fn execute(code,ctx,bounded) {
    return if bounded {V.run_seeded_bounded(code,map{},nil,ctx)} else {V.run_seeded(code,map{},ctx)};
}
fn rejects(source,options) {
    let c=F.frontend_compile(source);assert(c.ok,"bounds fixture compiles");
    assert((try {V.run_bounded(c.chunk,options);false} catch true),"bounded operation rejects");
}
rejects("let a=try range(100) catch [];print 99;",map{max_value_items:64});
rejects("print range(1000);",map{max_steps:100});
rejects("print json_stringify(str_repeat(\"x\",20));",map{max_value_items:64});
rejects("print json_parse(str_repeat(\" \",60)+\"[1,2]\");",map{max_value_items:64});
rejects("print regex_replace_all(\"xxxxxxxx\",\"x\",\"12345678\");",map{max_value_items:64});
rejects("print regex_match(\"xxxxxxxx\",\"x+\");",map{max_steps:20});
rejects("let a=[];push(a,a);print try json_stringify(a) catch 7;",map{});
rejects("let a=map{};a.next=a;print try json_stringify(a) catch 7;",map{});
rejects("let a:any=[1];for i 12 {a=[a,a];}print json_stringify(a);",map{max_value_items:1024});
rejects("print json_parse(str_repeat(\"[\",129)+\"0\"+str_repeat(\"]\",129));",map{});
rejects("print json_stringify(bigint(str_repeat(\"9\",100)));",map{max_value_items:128});
// Ordinary errors caught in a guest preserve owned state; escapes reclaim it.
for source in ["json_parse(\"[\");","bytes_to_str([255]);","regex_match(\"x\",\"[\");","json_stringify(map{__bi:nil});","range(1,2,0);"] {
    let c=F.frontend_compile(source);assert(c.ok,"cleanup fixture compiles");
    for bounded in [false,true] {
        let ctx=V.execution_context(true);
        let setup=F.frontend_compile("memory_alloc(7);").chunk;
        V.run_seeded(setup,map{},ctx);let memory=ctx.memory;
        assert((try {execute(c.chunk,ctx,bounded);false} catch true),"error escapes");
        assert(memory.closed and ctx.memory==nil,"owned state reclaimed");
        let caught=F.frontend_compile("let h=memory_alloc(7);print try {"+source+"0} catch memory_get(h);");
        assert(execute(caught.chunk,V.execution_context(true),bounded).output==[7],"guest handler keeps live state");
    }
}
let cycle=F.frontend_compile("let h=memory_alloc(7);let a=[];push(a,a);print try json_stringify(a) catch memory_get(h);");
assert(V.run(cycle.chunk).output==[7],"unbounded caught admission retains ownership");
// Inject IEEE754 values as raw constants; never call the native range oracle
// with inputs that could hang its retained unbounded loop.
let nan=num_from_le_bytes([0,0,0,0,0,0,248,127]);
let inf=num_from_le_bytes([0,0,0,0,0,0,240,127]);
for args in [[nan],[inf],[0,nan],[0,inf],[0,1,nan],[0,1,inf]] {
    let constants=[map{__bi:"range"}];let instructions=[map{op:0,operand:0}];
    for arg in args {push(constants,arg);push(instructions,map{op:0,operand:len(constants)-1});}
    push(instructions,map{op:18,operand:len(args)});
    let code=map{constants:constants,instructions:instructions};
    assert((try {V.run(code);false}catch true),"nonfinite range rejects without native oracle");
    assert((try {V.run_bounded(code);false}catch true),"bounded nonfinite range rejects");
}
print "selfhost_data_bounds_pass";
