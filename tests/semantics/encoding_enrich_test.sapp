// tests/semantics/encoding_enrich_test.sapp — enrichment for stdlib/encoding.sapp
//
// Adds base64url (URL-safe, unpadded), a base32 bridge, query-string
// encode/decode, and HTML entity escaping (XSS-relevant).

let enc = import("stdlib/encoding.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base behavior unchanged ──────────────────────────────────────────────────────
eq(enc.hex_encode("Hi"), "4869", "hex_encode"); eq(enc.hex_decode("4869"), "Hi", "hex_decode");

// ── ENRICH: base64url (URL-safe, no padding) ─────────────────────────────────────
let u = enc.base64url_encode("Hello, World!?>");
if str_index_of(u, "=") >= 0 { fail("base64url must be unpadded, got: " + u); }
if str_index_of(u, "+") >= 0 or str_index_of(u, "/") >= 0 { fail("base64url must not contain +//"); }
eq(enc.base64url_decode(u), "Hello, World!?>", "base64url round-trip");

// ── ENRICH: base32 bridge ────────────────────────────────────────────────────────
eq(enc.base32_encode("hi"), "NBUQ====", "base32_encode"); eq(enc.base32_decode("NBUQ===="), "hi", "base32_decode");

// ── ENRICH: query strings ────────────────────────────────────────────────────────
eq(enc.query_encode(map{ a: "1", b: "x y" }), "a=1&b=x+y", "query_encode (keys sorted, space->+)");
let q = enc.query_decode("a=1&b=x+y&c=%2F");
eq(q.a, "1", "query_decode a"); eq(q.b, "x y", "query_decode + -> space"); eq(q.c, "/", "query_decode %2F");

// ── ENRICH: HTML entity escaping ─────────────────────────────────────────────────
let h = enc.html_encode("<a href=\"x\">'&'</a>");
eq(h, "&lt;a href=&quot;x&quot;&gt;&#39;&amp;&#39;&lt;/a&gt;", "html_encode escapes all 5");
eq(enc.html_decode(h), "<a href=\"x\">'&'</a>", "html_decode round-trip");

print "encoding_enrich_pass";
