let D=import("stdlib:device_evidence_contract.sapp");
fn require(v,m){if not v{throw "FAIL device evidence: "+m;}}
fn base(){return map{format:D.FORMAT,evidence_id:"alcatel-api28-aggregate",
    artifact_sha256:str_repeat("b",64),device_class:"android-phone",platform:"android",
    api_level:28,capabilities:["camera","location","bluetooth","telephony","sensors"],
    product_scopes:["pblang","pbremote","pbspotit"],physical:true,attended:true,
    consent_confirmed:true,observed_ms:1000,expires_ms:2000};}
let admitted=D.admit(base(),1500);
require(admitted.ok and admitted.schema_eligible_for_review and not admitted.evidence_usable
    and not admitted.physical_verified and not admitted.freshness_verified
    and admitted.explicit_serial_or_network_fields_absent
    and not admitted.semantic_identifier_verification and not admitted.identifier_free_verified
    and not admitted.serial_recorded and not admitted.network_address_recorded
    and not admitted.authority_granted and not admitted.remote_control_allowed
    and not admitted.safe_to_log and not admitted.caller_metadata_returned,
    "device claim is identifier-unverified and grants no authority");
require(D.admit(base(),2000).error=="evidence-expired-or-clock-invalid","expired evidence rejected");
let unattended=base(); unattended.attended=false;
require(D.admit(unattended,1500).error=="physical-attended-consent-required","unattended evidence rejected");
let leaked=base(); leaked.serial="private-device-serial";
require(D.admit(leaked,1500).error=="exact-schema-required","identifier field rejected");
let mismatch=base(); mismatch.platform="linux";
require(D.admit(mismatch,1500).error=="device-platform-mismatch","device/platform mismatch rejected");
print "device_evidence_contract_pass";
