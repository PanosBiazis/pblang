let G=import("stdlib:table_group.sapp");let S=import("stdlib:sheet_document.sapp");let CSV=import("stdlib:sheet_csv.sapp");
let doc=CSV.decode("Team,State\nα,Open\nβ,Done\nα,Done\nα,Open\n,Open\nα ,Open\n");let before=S.encode(doc);let groups=G.group_rows(doc,0,true);assert(groups.labels==["α","β","","α "] and groups.rows==[[1,3,4],[2],[5],[6]],"literal stable groups");assert(groups.membership==[0,1,0,0,2,3],"record membership");groups.rows[0][0]=99;assert(S.encode(doc)==before,"detached");
let counts=G.counts(doc,0,true);assert(counts.cells==[["Group","Count"],["α","3"],["β","1"],["","1"],["α ","1"]],"counts preserve empty and whitespace categories");let cross=G.cross(doc,0,1,true);assert(cross.cells==[["Row / Column","Open","Done"],["α","2","1"],["β","0","1"],["","1","0"],["α ","1","0"]],"exact cross-tab and zeros");assert(CSV.decode(CSV.encode(cross)).cells==cross.cells,"CSV roundtrip");cross.cells[1][1]="bad";assert(S.encode(doc)==before,"output independent");
let empty=S.create(1,2);assert(G.counts(empty,0,true).cells==[["Group","Count"]],"header only counts");assert(G.cross(empty,0,1,true).cells==[["Row / Column"]],"header only cross");assert(G.counts(empty,0,false).cells[1]==["","1"],"blank data counts");
for bad in [-1,2,0.5,"0",nil]{assert((try G.counts(doc,bad,true) catch nil)==nil,"bad column");}assert((try G.counts(doc,0,"header") catch nil)==nil,"explicit header");assert((try G.cross(doc,0,8,true) catch nil)==nil,"bad second axis");
let maximum=S.create(32,2);maximum.cells[0]=["Rows","Columns"];for i in range(1,32){maximum.cells[i]=["row"+str(i),"col"+str(num_mod(i,7))];}let matrix=G.cross(maximum,0,1,true);assert(len(matrix.cells)==32 and len(matrix.cells[0])==8,"maximum 31 x 7 categories");let total=0;for r in range(1,32){for c in range(1,8){total=total+parse_number(matrix.cells[r][c]);}}assert(total==31,"all source records counted exactly once");let too=S.copy(maximum);too.cells[1][1]="eighth";assert((try G.cross(too,0,1,true) catch nil)==nil,"too many column categories");assert((try G.counts(maximum,0,false) catch nil)==nil,"32 groups cannot silently truncate");
let diagonal=G.cross(doc,0,0,true);assert(diagonal.cells[1][1]=="3" and diagonal.cells[1][2]=="0","same column diagonal");let key=CSV.decode("x,y\n__proto__,a\n__proto__,b\n");assert(G.counts(key,0,true).cells[1][1]=="2","literal map keys");print "table_group_pass";
