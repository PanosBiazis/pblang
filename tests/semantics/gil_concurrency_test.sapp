// tests/semantics/gil_concurrency_test.sapp
// Concurrency must be correct and deadlock-free whether the optional Global
// Interpreter Lock is OFF (default) or ON (PBLANG_GIL=1). This file runs in the suite
// with the GIL off; it is also run manually with PBLANG_GIL=1 to prove the GIL path
// neither deadlocks nor corrupts results. The cross-thread channel producer/consumer
// below is the deadlock-prone case: under a GIL, recv/send must release the lock while
// waiting, or the producer and consumer would wedge.

fn fail(m) { throw "FAIL " + m; }

// gil_enabled() reports the mode (bool in both); behavior below must be correct either way.
if type(gil_enabled()) != "bool" { fail("gil_enabled() should return a bool"); }

// ── spawn + join_all: independent compute ────────────────────────────────────
let data = [3, 4, 5, 6];
let hs = [];
let i = 0;
while i < len(data) {
    let idx = i;
    array_push(hs, spawn(fn() { return data[idx] * data[idx]; }));
    i = i + 1;
}
let sq = join_all(hs);
if len(sq) != 4 { fail("join_all length"); }
if sq[0] != 9 or sq[1] != 16 or sq[2] != 25 or sq[3] != 36 { fail("join_all squares " + str(sq)); }

// ── parent spawns child then joins (must not self-deadlock under GIL) ─────────
let child = spawn(fn() { let s = 0; let k = 0; while k < 1000 { s = s + k; k = k + 1; } return s; });
if join(child) != 499500 { fail("parent/child join"); }

// ── channel producer/consumer across threads (recv/send release-on-block) ────
let ch = channel();
let tx = ch.sender;
let rx = ch.receiver;
let n = 50;
let producer = spawn(fn() {
    let p = 0;
    while p < n { send(tx, p); p = p + 1; }
    channel_close(tx);
    return true;
});
let total = 0;
let got = 0;
while got < n {
    let v = recv(rx);
    if v == nil { break; }   // channel closed
    total = total + v;
    got = got + 1;
}
join(producer);
if total != 1225 { fail("channel sum (got " + str(total) + ", want 1225)"); }

print "gil_concurrency_pass";
