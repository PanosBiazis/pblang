// tests/semantics/gpio_test.sapp
//
// stdlib/gpio.sapp — Linux sysfs GPIO driver in pure pblang, harvested from the
// LightLedRasPi project. The filesystem backend is INJECTABLE (same pattern as
// ollama's transport), so the protocol logic is unit-testable on a machine with
// no GPIO hardware; the real sysfs backend is a thin fs_read/fs_write shim.

let GP = import("stdlib/gpio.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if not c { fail(m); } }

// fake in-memory sysfs
let store = map{};
let be = map{
    read: fn(p) { if map_has(store, p) { return store[p]; } throw "gpio_test: no " + p; },
    write: fn(p, t) { store[p] = t; return nil; },
};
let g = GP.new(be);

// export / direction / write follow the sysfs protocol exactly
GP.export_pin(g, 17);
eq(store["/sys/class/gpio/export"], "17", "export writes the pin number");
GP.set_direction(g, 17, "out");
eq(store["/sys/class/gpio/gpio17/direction"], "out", "direction file");
GP.write_pin(g, 17, 1);
eq(store["/sys/class/gpio/gpio17/value"], "1", "value high");
GP.write_pin(g, 17, 0);
eq(store["/sys/class/gpio/gpio17/value"], "0", "value low");

// read parses the value file (tolerating a trailing newline, as sysfs emits)
store["/sys/class/gpio/gpio17/value"] = "1\n";
eq(GP.read_pin(g, 17), 1, "read high");
store["/sys/class/gpio/gpio17/value"] = "0";
eq(GP.read_pin(g, 17), 0, "read low");

GP.unexport_pin(g, 17);
eq(store["/sys/class/gpio/unexport"], "17", "unexport writes the pin number");

// validation: only 0/1 values, only in/out directions, non-negative pins
eq(try GP.write_pin(g, 17, 5) catch "bad", "bad", "non-binary value refused");
eq(try GP.set_direction(g, 17, "sideways") catch "bad", "bad", "bad direction refused");
eq(try GP.export_pin(g, 0 - 3) catch "bad", "bad", "negative pin refused");
eq(try GP.export_pin(g, 1000001) catch "bad", "bad", "unbounded pin refused");

// blink_plan is PURE: a [{pin, value, ms}] schedule any executor can replay
let plan = GP.blink_plan(17, 2, 100);
eq(len(plan), 4, "2 blinks = 4 steps");
eq(plan[0].value, 1, "step 1 on"); eq(plan[0].ms, 100, "step 1 hold");
eq(plan[1].value, 0, "step 2 off");
eq(plan[3].value, 0, "plan ends off");
eq(plan[2].pin, 17, "steps carry the pin");
eq(try GP.blink_plan(17, 2049, 1) catch "bad", "bad", "blink plan is bounded");
eq(try GP.blink_plan(17, 1, 0) catch "bad", "bad", "blink duration must be positive");

let pwm = GP.pwm_plan(18, 25, 20, 2);
eq(len(pwm), 4, "two PWM cycles produce four bounded steps");
eq(pwm[0].ms, 5, "25 percent of 20ms is 5ms on");
eq(try GP.pwm_plan(18, 101, 20, 1) catch "bad", "bad", "invalid PWM duty refused");
eq(try GP.pwm_plan(18, 50, 20, 2049) catch "bad", "bad", "PWM plan is bounded");

// the real backend exists and has the right shape (not executed here — no GPIO on this host)
let real = GP.sysfs_backend();
truthy(map_has(real, "read") and map_has(real, "write"), "sysfs backend shape");

// ── debounce: a pure state machine — flickers shorter than stable_ms are ignored ──
let st = GP.debounce_new(0, 50);
st = GP.debounce_step(st, 1, 1000);
eq(st.value, 0, "press seen but not yet stable");
st = GP.debounce_step(st, 1, 1030);
eq(st.value, 0, "still inside the stable window");
st = GP.debounce_step(st, 1, 1051);
eq(st.value, 1, "held 51ms >= 50ms -> registered");
st = GP.debounce_step(st, 0, 1060);
eq(st.value, 1, "release flicker not yet stable");
st = GP.debounce_step(st, 1, 1070);
eq(st.value, 1, "flicker ignored, still pressed");
eq(try GP.debounce_new(2, 50) catch "bad", "bad", "non-binary initial level refused");
eq(try GP.debounce_new(0, 0) catch "bad", "bad", "non-positive debounce window refused");
eq(try GP.debounce_step(st, 2, 1080) catch "bad", "bad", "non-binary raw level refused");
eq(try GP.debounce_step(st, 1, 1069) catch "bad", "bad", "non-monotonic time refused");

// ── servo: 50Hz frames, 1ms=0deg .. 2ms=180deg ────────────────────────────────
let sv = GP.servo_plan(12, 90, 3);
eq(len(sv), 6, "3 frames = 6 steps");
eq(sv[0].value, 1, "pulse first");
eq(sv[0].ms, 1.5, "90deg = 1.5ms pulse");
eq(sv[1].ms, 18.5, "rest of the 20ms frame");
eq(try GP.servo_plan(12, 200, 1) catch "bad", "bad", "angle > 180 refused");
eq(try GP.servo_plan(12, 90, 2049) catch "bad", "bad", "servo plan is bounded");

print "gpio_pass";
