let W = import("stdlib:windows_unicode_input.sapp");
let PE = import("stdlib:windows_pe.sapp");

fn fail(message) { throw "FAIL windows_unicode_input: " + message; }
fn contains_bytes(haystack, needle) {
    let i = 0;
    while i + len(needle) <= len(haystack) {
        let ok = true; let j = 0;
        while j < len(needle) and ok { if haystack[i + j] != needle[j] { ok = false; } j = j + 1; }
        if ok { return true; } i = i + 1;
    }
    return len(needle) == 0;
}

let plan = W.text_plan("Aα😀\t\n");
if not plan.ok or plan.scalar_count != 5 or plan.utf16_units != 6
    or not plan.layout_independent { fail("Unicode scalar/UTF-16 accounting"); }
if plan.strokes[0].scan != 65 or plan.strokes[0].flags != 4
    or plan.strokes[1].scan != 945 or plan.strokes[1].flags != 4
    or plan.strokes[2].scan != 0xD83D or plan.strokes[3].scan != 0xDE00 {
    fail("BMP or surrogate lowering");
}
if plan.strokes[4].vk != 9 or plan.strokes[4].flags != 0
    or plan.strokes[5].vk != 13 or plan.strokes[5].flags != 0 {
    fail("semantic control-key lowering");
}
if W.text_plan("bad\x00text").ok { fail("NUL accepted"); }

let artifact = W.artifact("Aα😀");
if not artifact.ok or artifact.scalar_count != 3 or artifact.utf16_units != 4
    or artifact.input_events != 8 or artifact.send_input_calls != 1
    or artifact.code_bytes < 40 or artifact.code_bytes > 96
    or artifact.artifact_bytes != len(artifact.bytes)
    or not artifact.partial_injection_fails_closed
    or artifact.source_language != "pblang" { fail("artifact metadata"); }
if not PE.inspect_x64(artifact.bytes).ok
    or not contains_bytes(artifact.bytes, str_to_bytes("SendInput"))
    or not contains_bytes(artifact.bytes, str_to_bytes("ExitProcess")) {
    fail("generated PE imports");
}
let long_text = ""; let n = 0;
while n < 128 { long_text = long_text + "😀"; n = n + 1; }
let long_artifact = W.artifact(long_text);
if not long_artifact.ok or long_artifact.utf16_units != 256
    or long_artifact.input_events != 512 or long_artifact.input_data_bytes != 20480
    or long_artifact.code_bytes > long_artifact.data_rva - long_artifact.text_rva {
    fail("long Unicode artifact section separation");
}
let caps = W.capabilities();
if not caps.text_unicode_layout_independent or not caps.supplementary_planes
    or not caps.partial_injection_fails_closed or caps.external_tool_required {
    fail("capability contract");
}
if platform() != "windows" and W.available().ok { fail("non-Windows host reported available"); }
let denied = W.execute(map{ format: "pblang.input.event.v1", kind: "type", text: "hello" });
if platform() != "windows" and denied.ok { fail("non-Windows execution did not fail closed"); }

print "windows_unicode_input_pass";
