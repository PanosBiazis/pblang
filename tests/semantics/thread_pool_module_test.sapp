// stdlib/thread_pool.sapp — in-process task pool (run_all path, no spawn)
import "stdlib:thread_pool.sapp";

let pool = thread_pool.new_thread_pool(2);
let _id = thread_pool.submit(pool, fn() { return 21; });
let out = thread_pool.run_all(pool);

if out.completed != 1 { throw "FAIL thread_pool completed"; }
if len(out.results) != 1 { throw "FAIL thread_pool results len"; }
if out.results[0] != 21 { throw "FAIL thread_pool result value"; }

let st = thread_pool.stats(pool);
if st.total != 1 { throw "FAIL thread_pool stats total"; }
if st.done != 1 { throw "FAIL thread_pool stats done"; }

print "thread_pool_module_pass";
