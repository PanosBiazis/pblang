let BUILD = import("stdlib:build.sapp");
let DIST = import("stdlib:dist.sapp");
let PROCESS = import("stdlib:process.sapp");

fn fail(message) { throw "FAIL aes_gcm_c99: " + message; }

let stamp = str_slice(sha256(str(now_ms()) + str(random_bytes(12))), 0, 20);
let output = "/tmp/pblang_aes_gcm_c99_" + stamp;
let snapshot_output = output + "_snapshot";
let snapshot_sentinel = snapshot_output + "_sentinel";
fs_write(snapshot_sentinel, "sentinel-safe");
let snapshot_link = try proc_spawn_wait("/bin/ln",
    ["-s", snapshot_sentinel, snapshot_output]) catch nil;
if snapshot_link == nil or snapshot_link.exit_code != 0 {
    fail("C99 symlink attack fixture creation failed");
}
let snapshot = BUILD.smart_build("tests/fixtures/check_good.sapp", snapshot_output, map{
    backend: "c99", goal: "speed", fallback: false, security_mode: "protect"
});
let process = PROCESS.bounded_status();
if process.available {
    if not snapshot.ok or snapshot.backend != "c99" or not fs_exists(snapshot_output)
        or snapshot.source_transport != "private-stdin" or not snapshot.bounded_process
        or not snapshot.execution_admitted or not snapshot.executed
        or snapshot.raw_fallback or not snapshot.process_status.available
        or not (str_starts_with(snapshot.compiler, "/usr/bin/")
            or str_starts_with(snapshot.compiler, "/bin/")
            or str_starts_with(snapshot.compiler, "/usr/local/bin/")) {
        fail("immutable PBLang C99 transport failed: " + str(try snapshot.error catch "unknown"));
    }
    if fs_read(snapshot_sentinel) != "sentinel-safe" or not snapshot.atomic_publication {
        fail("C99 publication followed a preplanted output symlink");
    }
    let snapshot_run = proc_spawn_wait(snapshot_output, []);
    try fs_remove(snapshot_output) catch nil;
    if snapshot_run.exit_code != 0 or snapshot_run.stdout != "1\n" {
        fail("immutable C99 snapshot execution failed");
    }
} else {
    if snapshot.ok or snapshot.publication_attempted or snapshot.execution_admitted
        or snapshot.executed or snapshot.raw_fallback or not snapshot.stage_cleanup_verified
        or snapshot.error == "" or snapshot.process_status.available
        or fs_read(snapshot_sentinel) != "sentinel-safe" {
        fail("unverified process backend did not fail closed with cleanup evidence");
    }
    try fs_remove(snapshot_output) catch nil;
}
try fs_remove(snapshot_sentinel) catch nil;

// The self-hosted C transpiler does not yet cover the complete AES module.
// Keep the broader known-answer differential on the explicit retained-bootstrap
// compatibility API; secure smart_build never falls back to this path.
if process.available {
    let built = DIST.native("tests/fixtures/aes_gcm_c99_entry.sapp", output,
        DIST.default_opts(), "linux-x64");
    if not built.ok or not fs_exists(output) {
        fail("retained-bootstrap C99 crypto fixture build failed: "
            + str(try built.reason catch (try built.stderr catch "unknown")));
    }
    let ran = proc_spawn_wait(output, []);
    try fs_remove(output) catch nil;
    if ran.exit_code != 0 or ran.stdout != "hmac_pass\npbkdf2_round_1_pass\npbkdf2_round_2_pass\n" {
        fail("native known-answer differential failed: " + ran.stdout + ran.stderr);
    }
} else {
    print "aes_gcm_c99_differential_skip: canonical bounded process backend unavailable";
}
print "aes_gcm_c99_pass";
