let BUILD = import("stdlib:build.sapp");

fn fail(message) { throw "FAIL aes_gcm_c99: " + message; }

let stamp = str_slice(sha256(str(now_ms()) + str(random_bytes(12))), 0, 20);
let output = "/tmp/pblang_aes_gcm_c99_" + stamp;
let built = BUILD.smart_build("tests/fixtures/aes_gcm_c99_entry.sapp", output, map{
    backend: "c99", goal: "speed", fallback: false, security_mode: "protect"
});
if not built.ok or built.backend != "c99" or not fs_exists(output) {
    fail("PBLang C99 crypto fixture build failed: " + str(try built.error catch "unknown"));
}
let ran = proc_spawn_wait(output, []);
try fs_remove(output) catch nil;
if ran.exit_code != 0 or ran.stdout != "hmac_pass\npbkdf2_round_1_pass\npbkdf2_round_2_pass\n" {
    fail("native known-answer differential failed: " + ran.stdout + ran.stderr);
}
print "aes_gcm_c99_pass";
