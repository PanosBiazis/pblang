let CSV=import("stdlib:sheet_csv.sapp");
let Sheet=import("stdlib:sheet_document.sapp");
fn rejects(text) {
    let failed=false; try { CSV.decode(text); } catch { failed=true; }
    assert(failed,"unsupported CSV rejected");
}
fn same(text,rows) {
    let result=CSV.decode(text);
    assert(Sheet.encode(result)==Sheet.encode(map{format:Sheet.FORMAT,cells:rows}),"exact cells and dimensions");
}
same("a,b\r\nc,d\n",[["a","b"],["c","d"]]);
same("\"a\"\r\n\"b\"\n",[["a"],["b"]]);
same("a,,c",[["a","","c"]]); same(",a",[["","a"]]);
same("\"say \"\"hi\"\"\",\"comma,here\"",[["say \"hi\"","comma,here"]]);
same("\"line1\nline2\",\"a\r\nb\rc\"",[["line1\nline2","a\r\nb\rc"]]);
same("a,\n,",[["a",""],["",""]]);
same("\n\n",[[""],[""]]); same("\"\"",[[""]]);
same(" \n\nend\n",[[" "],[""],["end"]]);
same("001,true,=cmd(),+1,-2,@x,\"<script>\",Ελληνικά",[["001","true","=cmd()","+1","-2","@x","<script>","Ελληνικά"]]);
same("\ufeffa,b",[["a","b"]]);
same("\ufeff\ufeffa",[["\ufeffa"]]); same("\"\ufeffa\"",[["\ufeffa"]]);
same("\ufeff\n",[[""]]);
for text in ["",nil,true,1,[],map{},"\ufeff","\"x","x\"y","\"x\"z","\"x\" ",
    "x\r","x\ry","a,b\nx","a,b\n\n","\u0000","\"\u0000\"",
    "a,b,c,d,e,f,g,h,i",str_repeat("x\n",33),str_repeat("x",257),str_repeat("é",129),
    str_repeat("x",65537),str_repeat("é",32769)] { rejects(text); }
same(str_repeat("é",128),[[str_repeat("é",128)]]);
same("\""+str_repeat("\"\"",256)+"\"",[[str_repeat("\"",256)]]);
rejects("\""+str_repeat("\"\"",257)+"\"");
let maximum=str_repeat(str_repeat("x",256)+"\n",32);
assert(Sheet.validate(CSV.decode(maximum)).text_bytes==8192,"exact aggregate byte bound");
let over=str_repeat(str_repeat("x",256)+",\n",31)+str_repeat("x",256)+",x";
rejects(over);
let full=CSV.decode(str_repeat("a,b,c,d,e,f,g,h\r\n",32));
assert(len(full.cells)==32 and len(full.cells[31])==8 and full.cells[31][7]=="h","maximum dimensions");
full.cells[0][0]="changed";
assert(full.cells[1][0]=="a" and CSV.decode("a").cells[0][0]=="a","independent rows and results");
print "sheet_csv_pass";
