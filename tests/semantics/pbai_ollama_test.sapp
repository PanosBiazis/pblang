// tests/semantics/pbai_ollama_test.sapp — pbAI's ensemble wired to a REAL local ollama model.
// ollama_voter() builds an ensemble voter backed by a local model; use_ollama() plugs it into
// the ensemble in one call. Logic is tested with an injected transport; a guarded live block
// exercises the real daemon when it's actually running.

let pbai = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── ollama_voter maps a (mocked) local-model reply onto an intent ──────────────────────
let v = pbai.ollama_voter("llama3", fn(u, b) { return "{\"response\":\"improve\"}"; });
let r = v("please refactor this loop");
if not map_has(r, "intent") { fail("ollama voter returns a vote"); }
eq(r.intent, "improve", "ollama voter maps the model reply to an intent");

// ── a down daemon -> the voter abstains (nil), ensemble falls back to native ───────────
let down = pbai.ollama_voter("llama3", fn(u, b) { return "error: connection refused"; });
eq(down("x"), nil, "ollama voter abstains when the daemon is down");

// ── ollama_voter plugs into the ensemble and actually swings it ────────────────────────
pbai.clear_voters();
pbai.register_voter_weighted("oll", pbai.ollama_voter("llama3", fn(u, b) { return "{\"response\":\"bugs\"}"; }), 5);
eq(pbai.ensemble("explain this function"), "bugs", "a strong ollama voter swings the ensemble");
pbai.clear_voters();

// ── LIVE: only when a real ollama daemon is up on this machine ─────────────────────────
if pbai.ollama_available() {
    pbai.clear_voters();
    let ok = pbai.use_ollama();               // registers a live local-model voter
    eq(ok, true, "use_ollama registers a live voter when the daemon is up");
    if len(pbai.voters()) < 1 { fail("live ollama voter should be registered"); }
    // it must actually produce a decision without crashing
    let d = pbai.ensemble_decide("find the null-pointer bug in this code", 0.5);
    if not map_has(d, "intent") { fail("live ensemble_decide shape"); }
    pbai.clear_voters();
} else {
    // no daemon -> use_ollama honestly reports it couldn't register
    eq(pbai.use_ollama(), false, "use_ollama returns false when no daemon");
}

print "pbai_ollama_pass";
