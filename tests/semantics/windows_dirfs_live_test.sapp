// Physical Windows release lane. Non-Windows hosts skip without supplying
// evidence; the dual-readiness generator requires the separately published
// Windows report before it can mark this backend ready.
let W = import("stdlib:windows_dirfs.sapp");

fn fail(message) { throw "FAIL windows_dirfs_live: " + message; }
fn contains(values, wanted) { let i = 0; while i < len(values) { if values[i] == wanted { return true; } i = i + 1; } return false; }

if platform() != "windows" {
    print "windows_dirfs_live_skip_non_windows";
} else {
    let token = str_slice(sha256(base64_encode_bytes(random_bytes(24))), 0, 20);
    let bridge = try env_get("PBLANG_WINDOWS_ABI_BRIDGE") catch nil;
    if type(bridge) != "string" or bridge == "" {
        fail("ACL-protected packaged bridge is not configured");
    }
    let root = ".pblang-win-dirfs-live-" + token;
    fs_mkdirs(root);
    let fs = W.open(root, false, bridge);
    if not fs.ok { fail("root handle open: " + str(try fs.error catch "")); }

    let first = W.write_new_exclusive(fs, "data\\value.bin", [0,1,2,127,128,254,255], true);
    if not first.ok or first.size != 7 { fail("exclusive binary write"); }
    if W.write_new_exclusive(fs, "data\\value.bin", [9], true).ok { fail("exclusive collision"); }
    let loaded = W.read_bytes(fs, "data\\value.bin", 7);
    if not loaded.ok or loaded.bytes != [0,1,2,127,128,254,255] { fail("binary roundtrip"); }
    if W.read_bytes(fs, "data\\value.bin", 6).ok { fail("bounded exact read"); }
    let prefix = W.read_prefix_bytes(fs, "data\\value.bin", 3);
    if not prefix.ok or prefix.bytes != [0,1,2] or not prefix.truncated { fail("bounded prefix read"); }
    let range = W.read_range_bytes(fs, "data\\value.bin", 2, 3);
    if not range.ok or range.bytes != [2,127,128] or not range.truncated
        or range.offset != 2 or range.source_size != 7 { fail("bounded range read"); }
    let past_end = W.read_range_bytes(fs, "data\\value.bin", 12, 3);
    if not past_end.ok or len(past_end.bytes) != 0 or not past_end.offset_past_end
        or past_end.offset != 7 or past_end.truncated { fail("past-end bounded range read"); }
    let replaced = W.write_atomic(fs, "data\\value.bin", [65,66,67], true);
    if not replaced.ok or not replaced.atomic { fail("atomic replacement"); }
    let meta = W.metadata(fs, "data\\value.bin");
    if not meta.ok or meta.kind != "file" or meta.size != 3 { fail("held metadata"); }
    let listed = W.list(fs, "data", 16);
    if not listed.ok or not contains(try listed.entries catch [], "value.bin") {
        fail("handle directory listing: " + str(try listed.error catch "missing entry")
            + " (code " + str(try listed.os_error catch "unavailable")
            + ", entries " + str(try listed.entries catch []) + ")");
    }
    let moved = W.move(fs, "data\\value.bin", "data\\moved.bin", false);
    if not moved.ok or W.read_bytes(fs, "data\\value.bin", 16).ok
        or not W.read_bytes(fs, "data\\moved.bin", 16).ok {
        fail("handle-relative no-replace move");
    }
    if not W.write_new_exclusive(fs, "data\\occupied.bin", [9], false).ok {
        fail("move collision fixture");
    }
    if W.move(fs, "data\\moved.bin", "data\\occupied.bin", false).ok {
        fail("no-replace move accepted a collision");
    }
    if not W.move(fs, "data\\moved.bin", "data\\occupied.bin", true).ok {
        fail("replace move");
    }
    let lock = W.acquire_lock(fs, "data\\writer.lock", 1000, 10);
    if not lock.ok or not W.release_lock(fs, lock) { fail("persistent descriptor lock"); }
    if W.read_bytes(fs, "..\\escape", 16).ok or W.read_bytes(fs, "C:\\escape", 16).ok {
        fail("path confinement");
    }

    // Directory junctions are reparse points and do not require arbitrary
    // command input. A normal Windows release runner must be able to create
    // this local fixture; otherwise the security gate fails rather than
    // silently omitting reparse verification.
    fs_mkdirs(root + "\\outside");
    fs_write_bytes(root + "\\outside\\secret.bin", [42]);
    let junction = proc_spawn_wait("cmd.exe", ["/D", "/C",
        "mklink /J " + root + "\\jump " + root + "\\outside"]);
    if junction.exit_code != 0 {
        fail("junction fixture creation (exit " + str(junction.exit_code)
            + ", error " + str(try junction.error catch "unavailable") + ")");
    }
    if W.read_bytes(fs, "jump\\secret.bin", 16).ok { fail("reparse traversal accepted"); }

    if not W.remove_file(fs, "data\\occupied.bin").ok { fail("handle-relative file remove"); }
    if not W.mkdir(fs, "empty").ok or not W.remove(fs, "empty").ok {
        fail("handle-relative empty-directory remove");
    }
    if not W.close(fs) { fail("root close"); }
    try fs_remove(root + "\\jump") catch nil;
    try fs_remove(root + "\\outside\\secret.bin") catch nil;
    try fs_remove(root + "\\outside") catch nil;
    try fs_remove(root + "\\data\\writer.lock") catch nil;
    try fs_remove(root + "\\data") catch nil;
    try fs_remove(root) catch nil;
    print "windows_dirfs_live_pass";
}
