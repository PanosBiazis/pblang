// emu_6502_test.sapp — a verified MOS 6502 execution model in pblang (the "oldest device" end of the suite).
//
// The 6502 (1975) powered the Apple II, Commodore 64, NES, BBC Micro, Atari — an 8-bit ACCUMULATOR machine, a
// completely different paradigm from the RISC register machines: one accumulator A, index registers X/Y, status
// flags (carry, zero), variable-length instructions. Modeling it proves the emulator-suite approach spans the
// whole computing timeline, so a future pblang 6502 backend (retro/embedded) can be RUN-tested here too.

fn fail(m) { throw "FAIL emu-6502: " + m; }
fn _cat(a, b) { let i = 0; while i < len(b) { push(a, b[i]); i = i + 1; } return a; }
fn _u8(v) { let r = v % 256; if r < 0 { r = r + 256; } return r; }

// ── encoder (canonical 6502 opcodes) ──
fn LDA(i) { return [169, _u8(i)]; }   fn LDX(i) { return [162, _u8(i)]; }   fn LDY(i) { return [160, _u8(i)]; }
fn ADC(i) { return [105, _u8(i)]; }   fn SBC(i) { return [233, _u8(i)]; }
fn CLC()  { return [24]; }            fn SEC()  { return [56]; }
fn INX()  { return [232]; }           fn DEX()  { return [202]; }           fn INY() { return [200]; } fn DEY() { return [136]; }
fn CPX(i) { return [224, _u8(i)]; }   fn CMP(i) { return [201, _u8(i)]; }
fn BNE(rel) { return [208, _u8(rel)]; }   fn BEQ(rel) { return [240, _u8(rel)]; }
fn BRK()  { return [0]; }

// ── interpreter ──  A/X/Y are 8-bit; C carry, Z zero. BRK halts → exit code = A.
fn m6502_run(code) {
    let a = 0; let x = 0; let y = 0; let cf = 0; let zf = 0;
    let pc = 0; let guard = 0; let halted = false;
    while pc >= 0 and pc < len(code) and guard < 1000000 and not halted {
        guard = guard + 1;
        let op = code[pc];
        if op == 169 { a = code[pc + 1]; zf = _z(a); pc = pc + 2; }                         // LDA #
        else if op == 162 { x = code[pc + 1]; zf = _z(x); pc = pc + 2; }                     // LDX #
        else if op == 160 { y = code[pc + 1]; zf = _z(y); pc = pc + 2; }                     // LDY #
        else if op == 24  { cf = 0; pc = pc + 1; }                                           // CLC
        else if op == 56  { cf = 1; pc = pc + 1; }                                           // SEC
        else if op == 105 { let t = a + code[pc + 1] + cf; cf = 0; if t > 255 { cf = 1; } a = t % 256; zf = _z(a); pc = pc + 2; }   // ADC #
        else if op == 233 { let t = a - code[pc + 1] - (1 - cf); cf = 1; if t < 0 { cf = 0; } a = _wrap(t); zf = _z(a); pc = pc + 2; } // SBC #
        else if op == 232 { x = (x + 1) % 256; zf = _z(x); pc = pc + 1; }                    // INX
        else if op == 202 { x = _wrap(x - 1); zf = _z(x); pc = pc + 1; }                     // DEX
        else if op == 200 { y = (y + 1) % 256; zf = _z(y); pc = pc + 1; }                    // INY
        else if op == 136 { y = _wrap(y - 1); zf = _z(y); pc = pc + 1; }                     // DEY
        else if op == 224 { let d = x - code[pc + 1]; cf = 0; if x >= code[pc + 1] { cf = 1; } zf = _z(_wrap(d)); pc = pc + 2; }     // CPX #
        else if op == 201 { let d = a - code[pc + 1]; cf = 0; if a >= code[pc + 1] { cf = 1; } zf = _z(_wrap(d)); pc = pc + 2; }     // CMP #
        else if op == 208 { let nx = pc + 2; if zf == 0 { nx = nx + _s8(code[pc + 1]); } pc = nx; }   // BNE
        else if op == 240 { let nx = pc + 2; if zf == 1 { nx = nx + _s8(code[pc + 1]); } pc = nx; }   // BEQ
        else if op == 0   { halted = true; }                                                // BRK → exit A
        else { throw "m6502_run: unmodeled opcode " + str(op); }
    }
    if not halted { if guard >= 1000000 { fail("instruction budget exceeded"); } fail("ran off the end without BRK"); }
    return a;
}
fn _z(v) { if v == 0 { return 1; } return 0; }
fn _wrap(v) { let r = v % 256; if r < 0 { r = r + 256; } return r; }
fn _s8(b) { if b >= 128 { return b - 256; } return b; }

fn prog(insns) { let c = []; let i = 0; while i < len(insns) { _cat(c, insns[i]); i = i + 1; } return c; }
fn eq(g, w, m) { if g != w { fail(m + ": got " + str(g) + " want " + str(w)); } }

eq(m6502_run(prog([LDA(42), BRK()])),                                        42, "LDA const");
eq(m6502_run(prog([LDA(5), CLC(), ADC(7), BRK()])),                          12, "ADC 5+7");
eq(m6502_run(prog([SEC(), LDA(20), SBC(8), BRK()])),                         12, "SBC 20-8");
eq(m6502_run(prog([LDA(200), CLC(), ADC(100), BRK()])),                      44, "ADC wraps 300&255");
// multiply-by-repeated-add: A=0, X=5, loop { ADC #3; DEX; BNE loop } → 3*5 = 15. BNE rel = -5 (back over ADC/DEX).
eq(m6502_run(prog([LDA(0), LDX(5), CLC(),
                   ADC(3), DEX(), BNE(0 - 5),   // bytes 5.. ; after BNE (pc=10) target = 10-5 = 5 = ADC
                   BRK()])),                                                 15, "loop 3*5 via ADC");
// count up with INX/CPX/BNE: A += 2 for X=1..5 → 10
eq(m6502_run(prog([LDA(0), LDX(0),
                   INX(), CLC(), ADC(2), CPX(5), BNE(0 - 8),
                   BRK()])),                                                 10, "loop INX/CPX 5*(+2)");

print "emu_6502: 8-bit accumulator machine — all programs (arithmetic, carry-wrap, loops) computed correctly";
