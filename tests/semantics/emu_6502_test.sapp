let CPU = import("stdlib:emulator_6502.sapp");

fn value(instructions) {
    let result = CPU.run(CPU.program(instructions));
    if not result.ok { throw result.error; }
    return result.value;
}

assert(value([CPU.load_a(42), CPU.break_instruction()]) == 42, "LDA immediate");
assert(value([CPU.load_a(5), CPU.clear_carry(), CPU.add_carry(7), CPU.break_instruction()]) == 12, "ADC");
assert(value([CPU.set_carry(), CPU.load_a(20), CPU.subtract_carry(8), CPU.break_instruction()]) == 12, "SBC");
assert(value([CPU.load_a(200), CPU.clear_carry(), CPU.add_carry(100), CPU.break_instruction()]) == 44, "ADC wraps");
assert(value([CPU.load_a(0), CPU.load_x(5), CPU.clear_carry(), CPU.add_carry(3),
              CPU.decrement_x(), CPU.branch_not_equal(-5), CPU.break_instruction()]) == 15, "ADC loop");
assert(value([CPU.load_a(0), CPU.load_x(0), CPU.increment_x(), CPU.clear_carry(),
              CPU.add_carry(2), CPU.compare_x(5), CPU.branch_not_equal(-8),
              CPU.break_instruction()]) == 10, "CPX loop");

let flags = CPU.run(CPU.program([CPU.load_a(255), CPU.clear_carry(), CPU.add_carry(1), CPU.break_instruction()]));
assert(flags.ok and flags.flags.zero == 1 and flags.flags.carry == 1, "observable status flags");
assert(not CPU.run([169]).ok, "truncated immediate fails closed");
assert(not CPU.run([208, 127]).ok, "out-of-range branch fails closed");
assert(not CPU.run([255]).ok, "unknown opcode fails closed");
assert(not CPU.run([256]).ok, "invalid byte fails closed");
assert(not CPU.run([208, 254], map{ instruction_budget: 5 }).ok, "loop budget enforced");

print "emu_6502: reusable bounded subset passed arithmetic, flags, malformed-code, branch, and budget checks";
