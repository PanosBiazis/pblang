// tests/semantics/pb_mcp_router_enrich_test.sapp — new pb_mcp core tools + hardened guard.

let M = import("stdlib/pb_mcp.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn threw(f_ok, m) { if f_ok != nil { fail(m + " should have thrown, got " + str(f_ok)); } }

// ── file_exists ───────────────────────────────────────────────────────────────────
if not M.file_exists("stdlib/pb_mcp.sapp") { fail("file_exists existing"); }
if M.file_exists("does/not/exist.zzz") { fail("file_exists missing -> false"); }

// ── head_file: first N lines ──────────────────────────────────────────────────────
let head = M.head_file("stdlib/pb_mcp.sapp", 1);
if str_index_of(head, "pb_mcp") < 0 { fail("head_file first line: " + head); }

// ── list_dirs: immediate subdirectories ───────────────────────────────────────────
let dirs = M.list_dirs(".");
let has_stdlib = false;
let i = 0;
while i < len(dirs) { if dirs[i] == "stdlib" or dirs[i] == "./stdlib" { has_stdlib = true; } i = i + 1; }
if not has_stdlib { fail("list_dirs includes stdlib: " + str(dirs)); }

// ── grep_count / grep_files over a small directory ────────────────────────────────
let n = M.grep_count("fn", "stdlib/ai/pbai/demo", false);
if n < 1 { fail("grep_count found matches: " + str(n)); }
let gf = M.grep_files("fn", "stdlib/ai/pbai/demo", false);
if len(gf) < 1 { fail("grep_files found files"); }
// grep_files returns DISTINCT paths
let j = 0;
while j < len(gf) {
    let k = j + 1;
    while k < len(gf) { if gf[j] == gf[k] { fail("grep_files has duplicate: " + gf[j]); } k = k + 1; }
    j = j + 1;
}

// ── outline: top-level symbols of a pblang file ───────────────────────────────────
let ol = M.outline("stdlib/pb_mcp.sapp");
if len(ol) < 5 { fail("outline found symbols: " + str(len(ol))); }
let found_read = false;
let oi = 0;
while oi < len(ol) {
    if ol[oi].kind == "fn" and ol[oi].name == "read_file" { found_read = true; }
    if ol[oi].line < 1 { fail("outline line numbers are 1-based"); }
    oi = oi + 1;
}
if not found_read { fail("outline includes fn read_file"); }

// ── catalog helpers ───────────────────────────────────────────────────────────────
eq(M.tools_count(), len(M.tool_catalog()), "tools_count matches catalog");
if str_index_of(M.tool_desc("read_file"), "read") < 0 { fail("tool_desc read_file"); }
if M.tool_desc("nonexistent_tool") != nil { fail("tool_desc unknown -> nil"); }

// ── security: workspace guard refuses unix-absolute reads (meaningful on Linux) ────
threw(try M.read_file("/etc/hostname") catch nil, "read_file unix-absolute refused");
threw(try M.file_stats("/etc/hostname") catch nil, "file_stats unix-absolute refused");
threw(try M.read_file("../../../etc/passwd") catch nil, "read_file traversal refused");

print "pb_mcp_router_enrich_pass";
