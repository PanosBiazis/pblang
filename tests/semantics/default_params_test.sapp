// Test: default parameter values
// fn foo(x, y = 10, msg = "hello") — y and msg are optional

fn greet(name, greeting = "Hello") {
    return greeting + ", " + name + "!";
}

// Call with both args
let r1 = greet("Alice", "Hi");
assert(r1 == "Hi, Alice!", "both args: " + r1);

// Call with just required arg — uses default
let r2 = greet("Bob");
assert(r2 == "Hello, Bob!", "default used: " + r2);

// Multiple defaults
fn config(host = "localhost", port = 8080, debug = false) {
    return str(host) + ":" + str(port) + " debug=" + str(debug);
}

let c1 = config();
assert(c1 == "localhost:8080 debug=false", "all defaults: " + c1);

let c2 = config("example.com");
assert(c2 == "example.com:8080 debug=false", "one override: " + c2);

let c3 = config("example.com", 443);
assert(c3 == "example.com:443 debug=false", "two overrides: " + c3);

let c4 = config("example.com", 443, true);
assert(c4 == "example.com:443 debug=true", "all overrides: " + c4);

// Default nil + nil check pattern (for complex defaults)
fn connect(url, options = nil) {
    if options == nil { options = map{ timeout: 5000, retry: 3 }; }
    return map{ url: url, timeout: options.timeout, retry: options.retry };
}

let conn1 = connect("https://example.com");
assert(conn1.timeout == 5000, "nil default: timeout should be 5000");

let conn2 = connect("https://api.com", map{ timeout: 1000, retry: 1 });
assert(conn2.timeout == 1000, "override: timeout should be 1000");

// Default in anonymous function
let add = fn(a, b = 1) { return a + b; };
assert(add(5) == 6, "anon fn default: " + str(add(5)));
assert(add(5, 10) == 15, "anon fn override: " + str(add(5, 10)));

print "default_params_pass";
