let S=import("stdlib:subtitles.sapp");let R=import("stdlib:subtitle_review.sapp");
let doc=map{format:S.FORMAT,cues:[map{start_ms:0,end_ms:2000,text:"abcd"},map{start_ms:1000,end_ms:3000,text:"efghij"},map{start_ms:4000,end_ms:5000,text:"k"}]};
let before=json_stringify(doc);let r=R.analyze(doc,2);
assert(r.cue_count==3 and r.above_reading_limit==1 and r.attention_count==2,"union of reading and timing warnings");
assert(r.cues[0].reasons==["overlap"] and r.cues[1].reasons==["reading_rate","overlap"] and r.cues[2].reasons==[],"stable reasons");
assert(r.timing.overlap_ms==1000 and r.timing.gap_ms==1000 and r.timing.overlap_pairs==1,"timeline metrics");
assert(not r.source_text_included and not r.human_readability_verified and not str_contains(json_stringify(r),"efghij"),"no cue text or readability certification");
let clipped=R.clip_review(doc,1500,2500,2);assert(clipped.source_indices==[0,1],"source mapping");
assert(clipped.report.cues[0].duration_ms==500 and clipped.report.cues[0].characters_per_second==8,"recompute on shortened cue");
assert(clipped.report.cues[1].characters_per_second==6 and clipped.report.above_reading_limit==2,"clip density");
let absolute=R.clip_review(doc,1500,2500,2,false);assert(absolute.report.cues[0].start_ms==1500 and absolute.report.cues[1].end_ms==2500,"original time axis");
assert(absolute.report.cues[0].characters_per_second==clipped.report.cues[0].characters_per_second,"axis invariant rate");
assert(R.clip_review(doc,2000,4000,2).source_indices==[1],"half-open boundaries");
assert((try R.clip_review(doc,3000,4000) catch nil)==nil,"empty clip rejected");
let unicode=map{format:S.FORMAT,cues:[map{start_ms:0,end_ms:1000,text:"é α"}]};
assert(R.analyze(unicode,3).cues[0].nonspace_codepoints==3 and R.analyze(unicode,3).above_reading_limit==0,"code points not graphemes, exact boundary");
for limit in [-1,true,"20",1000001] {assert((try R.analyze(doc,limit) catch nil)==nil,"invalid reading limit");}
for bounds in [[-1,20],[0,0],[10,9],[0,0.5]] {assert((try R.clip_review(doc,bounds[0],bounds[1]) catch nil)==nil,"invalid clip bounds");}
assert((try R.clip_review(doc,0,1000,20,1) catch nil)==nil,"strict zero mode");
let invalid=S.copy(doc);invalid.cues[2].text="";assert((try R.clip_review(invalid,0,1000) catch nil)==nil,"validate excluded cues too");
r.cues[0].start_ms=99;clipped.source_indices[0]=99;assert(json_stringify(doc)==before,"source immutable");
let many=map{format:S.FORMAT,cues:[]};for i in range(0,128) {array_push(many.cues,map{start_ms:i*1000,end_ms:i*1000+1000,text:"x"});}
assert(R.analyze(many,1).attention_count==0,"max cues and adjacent boundaries");
print "subtitle_review_pass";
