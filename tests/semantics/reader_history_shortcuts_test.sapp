let App=import("../../examples/declarative_browser/app.sapp");let GUI=import("stdlib:gui.sapp");
let D=import("stdlib:browser_document.sapp");
let n=0;fn check(ok,label) {assert(ok,label);n=n+1;}
fn event(c,t,k) {App.update(c,[map{type:t,key:k}]);}
fn key(c,k) {event(c,"keydown",k);event(c,"keyup",k);}
fn act(c,name) {GUI.get(c.form,name).onclick(c.form);App.update(c,[]);}
let source=D.export_html(D.create("Shortcuts",[map{tag:"p",text:str_repeat("Readable words. ",15)},map{tag:"a",text:"Guide",href:"pb://guide"}]));
fn make() {let c=App.create("local","dark",map{body_size:20,font_scale:1.5},source);c.width=320;c.height=480;App.refresh(c);return c;}
fn follow(c) {key(c,"End");act(c,"block1");key(c,"End");}
fn chord(c,k) {App.update(c,[map{type:"keydown",key:k,alt:true},map{type:"keyup",key:k}]);}
let c=make();key(c,"End");let anchor=c.reading_anchor;follow(c);let guide=c.reading_anchor;
chord(c,"Left");check(c.session.snapshot().url=="pb://home" and c.reading_anchor==anchor,"Alt+Left returns to saved source anchor");
chord(c,"Right");check(c.session.snapshot().url=="pb://guide" and c.reading_anchor==guide,"Alt+Right restores guide anchor");
let count=c.navigations;key(c,"Left");key(c,"Right");check(c.navigations==count,"bare arrows unchanged");
for name in ["ctrl","meta","shift"] {let e=map{type:"keydown",key:"Left",alt:true};e[name]=true;App.update(c,[e,map{type:"keyup",key:"Left"}]);check(c.navigations==count,"extra modifier ignored "+name);}
// Explicit native snapshot flags take precedence over edge ordering and stale held state.
event(c,"keydown","LAlt");App.update(c,[map{type:"keydown",key:"Left",alt:false},map{type:"keyup",key:"Left"}]);check(c.navigations==count,"explicit false overrides tracked Alt");
App.update(c,[map{type:"keydown",key:"Left",alt:"invalid"},map{type:"keyup",key:"Left"}]);check(c.navigations==count+1,"malformed flag falls back to tracked Alt");event(c,"keyup","LAlt");
chord(c,"Right");event(c,"keydown","LShift");App.update(c,[map{type:"keydown",key:"Left",alt:true,shift:false},map{type:"keyup",key:"Left"}]);check(c.session.snapshot().url=="pb://home","explicit false also overrides tracked Shift");event(c,"keyup","LShift");
for alias in ["LAlt","RAlt","LeftAlt","RightAlt","AltLeft","AltRight","Alt"] {
    event(c,"keydown",alias);key(c,"Right");check(c.session.snapshot().url=="pb://guide","legacy Alt alias forward "+alias);key(c,"Left");check(c.session.snapshot().url=="pb://home","legacy Alt alias back "+alias);event(c,"keyup",alias);
}
for alias in ["LCtrl","RControl","ControlRight","MetaLeft","Command","RShift"] {
    chord(c,"Right");event(c,"keydown",alias);count=c.navigations;chord(c,"Left");check(c.navigations==count,"tracked conflicting modifier "+alias);event(c,"keyup",alias);chord(c,"Left");
}
// No available history is a true no-op, including focus and current position.
c.form.focus="appearance";let history=json_stringify(c.reading_history);count=c.navigations;chord(c,"Left");
check(c.form.focus=="appearance" and c.reading_anchor==anchor and c.navigations==count and json_stringify(c.reading_history)==history,"unavailable back preserves visible state");
chord(c,"Right");count=c.navigations;chord(c,"Right");check(c.navigations==count and c.reading_anchor==guide,"unavailable forward preserves position");
// A held arrow cannot walk multiple history entries, even across form replacement.
act(c,"home");follow(c);event(c,"keydown","LAlt");event(c,"keydown","Left");let held=c.navigations;
for i 8 {event(c,"keydown","Left");check(c.navigations==held,"held arrow ignored "+str(i));}
event(c,"keyup","Left");key(c,"Left");check(c.navigations==held+1,"separate press advances once");event(c,"keyup","LAlt");
// Opt-out is independent of toolbar, document page keys and position policy.
check(App.history_shortcuts(c,false) and not App.history_shortcuts(c,false),"disable is idempotent");count=c.navigations;chord(c,"Right");check(c.navigations==count,"disabled shortcuts ignored");
act(c,"forward");check(c.navigations==count+1,"toolbar still works when disabled");key(c,"Home");check(c.reading_page==0,"page Home is unchanged");
let rejected=try App.history_shortcuts(c,"yes") catch "rejected";check(rejected=="rejected" and not c.history_shortcuts,"nonboolean policy rejected without mutation");
check(App.history_shortcuts(c) and c.remember_positions,"enable leaves position policy intact");
// Preferences are never abandoned by a history shortcut; no implicit Save or Reload.
let calls=map{save:0,reload:0};App.enable_preferences(c,nil,fn(style){calls.save=calls.save+1;return map{ok:true};},"Ready",fn(){calls.reload=calls.reload+1;return map{ok:false};});App.refresh(c);
act(c,"appearance");act(c,"font_family");let draft=c.preferences.draft;let before=c.session.snapshot();let focus=c.form.focus;
chord(c,"Left");chord(c,"Right");check(c.settings and c.preferences.draft==draft and c.session.snapshot()==before and c.form.focus==focus,"Style retains draft focus and history");check(calls.save==0 and calls.reload==0,"shortcuts never save or reload");key(c,"Escape");check(not c.settings and c.form.focus=="appearance","Escape still dismisses preferences");c.session.close();
// Resize plus navigation and subsequent page key in a single poll use the new document.
let batch=make();follow(batch);App.update(batch,[map{type:"resize",w:390,h:600},map{type:"keydown",key:"Left",alt:true},map{type:"keyup",key:"Left"},map{type:"keydown",key:"Home"},map{type:"keyup",key:"Home"}]);
check(batch.session.snapshot().url=="pb://home" and batch.width==390 and batch.height==600 and batch.reading_page==0,"same-batch page key targets returned document at new size");batch.session.close();
for kind in ["close","quit"] {let closing=make();follow(closing);count=closing.navigations;App.update(closing,[map{type:kind},map{type:"keydown",key:"Left",alt:true}]);check(closing.form.close_requested and closing.graphics_stop and closing.navigations==count,"close wins before shortcut "+kind);closing.session.close();}
let denied=make();follow(denied);history=json_stringify(denied.reading_history);count=denied.navigations;denied.session.back=fn(){throw "Denied";};chord(denied,"Left");
check(denied.navigations==count and json_stringify(denied.reading_history)==history,"denied navigation keeps history");check(GUI.get(denied.form,"destination").text=="Destination denied by this session","denial uses existing visible error");denied.session.close();
print "reader_history_shortcuts_pass checks="+str(n);
