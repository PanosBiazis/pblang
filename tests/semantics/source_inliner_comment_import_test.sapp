// tests/semantics/source_inliner_comment_import_test.sapp
//
// The source-level linker (stdlib/source_inliner.sapp) detected import sites with
// _find_import_bindings, a RAW text scan that is NOT comment/string-aware (unlike
// the _transform pass). So an `import("...")` written inside a // or /* */ comment
// (extremely common in doc comments / examples) was mistaken for a real import:
// the inliner tried to RESOLVE that path and falsely REJECTED the whole program
// ("cannot resolve import: bar"), or — if the path happened to exist — wrongly
// inlined an unrelated module. Comments (and strings) must be inert to import
// detection.

let inl = import("stdlib/source_inliner.sapp");

fn fail(m) { throw "FAIL " + m; }
fn mk(mods) { fn r(p) { return try mods[p] catch nil; } return r; }

fn run_inlined(res) {
    let path = "/tmp/inlci_" + str(num_floor(now_ms())) + ".sapp";
    fs_write_bytes(path, str_to_bytes(res.source));
    let rr = proc_spawn_wait("pblang", ["run", path]);
    return str_trim(rr.stdout);
}

// 1. A // comment that mentions import("...") must NOT be treated as a real import.
let r1 = inl.inline_source("// example: import(\"bar\")\nprint 7;", mk(map{}));
if not r1.ok { fail("line-comment import() must be ignored, got reject: " + r1.reason); }
if run_inlined(r1) != "7" { fail("comment-import program must still run to 7"); }

// 2. A /* block comment */ mentioning import("...") is likewise inert.
let r2 = inl.inline_source("/* see import(\"baz\") */\nprint 9;", mk(map{}));
if not r2.ok { fail("block-comment import() must be ignored, got reject: " + r2.reason); }
if run_inlined(r2) != "9" { fail("block-comment-import program must still run to 9"); }

// 3. A comment that mentions a path which DOES resolve must not pull that module
//    in (no extra top-level defs leak from a commented example).
let mods3 = map{ "/tmp/sireal.sapp": "fn sneaky() { return 1; } export sneaky;" };
let r3 = inl.inline_source("// usage: import(\"/tmp/sireal.sapp\")\nprint 3;", mk(mods3));
if not r3.ok { fail("commented real path must be ignored, got reject: " + r3.reason); }
if r3.modules != 0 { fail("commented import must inline 0 modules, got " + str(r3.modules)); }
if str_index_of(r3.source, "sneaky") >= 0 { fail("commented module must NOT be inlined"); }

// 4. Regression: a REAL import still resolves and inlines correctly.
let mods4 = map{ "/tmp/sireal2.sapp": "fn sq(x) { return x * x; } export sq;" };
let r4 = inl.inline_source("let m = import(\"/tmp/sireal2.sapp\"); print m.sq(8);", mk(mods4));
if not r4.ok { fail("real import must inline: " + r4.reason); }
if r4.modules != 1 { fail("real import must inline 1 module"); }
if run_inlined(r4) != "64" { fail("real import must run to 64"); }

print "source_inliner_comment_import_pass";
