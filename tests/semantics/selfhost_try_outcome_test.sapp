let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let P=import("stdlib:selfhost_pbck.sapp");
fn compile(source){let c=F.frontend_compile(source);assert(c.ok,"compile");return c.chunk;}
// Every body value is legitimate, including the former sentinel and values
// resembling internal wrappers. Handler side effects distinguish true failures.
for literal in ["nil","false","0","\"__pblang_selfhost_try_sentinel__\"","[]","map{v:nil}","map{failed:true}"] {
    let c=compile("let handled=0;let result=try "+literal+" catch (if true {handled=handled+1;99;} else {99;});print handled;");
    for chunk in [c,P.deserialize_chunk(P.serialize_chunk(c))] {
        assert(V.run(chunk).output==[0],"success does not enter handler");
        assert(V.run_bounded(chunk).output==[0],"bounded success does not enter handler");
    }
}
let source="let failed=true;let count=0;let a=map{n:1};let b=try a catch map{n:99};b.n=7;"
    +"for i 10 {let x=try (if i%2==0 {throw nil;nil;} else {nil;}) catch (if true {count=count+1;nil;} else {nil;});}"
    +"print a.n;print count;print failed;";
let c=compile(source);
assert(V.run(c).output==[7,5,true],"alias preserved and failure state resets each iteration");
assert(V.run_bounded(c).output==[7,5,true],"bounded parity");
source="fn f(n){if n==0 {return try nil catch 99;}return try f(n-1) catch 77;}"
    +"print f(8);print try (try (if true {throw 1;0;} else {0;}) catch (if true {throw 2;0;} else {0;})) catch 42;";
assert(V.run(compile(source)).output==[nil,42],"nested calls and throwing handlers");
// A handler error must leave the VM, without accidentally being caught by the
// body's host try. Later output must not execute.
c=compile("print 1;let x=try (if true {throw 1;0;} else {0;}) catch (if true {print 2;throw \"handler-original\";0;} else {0;});print 3;");
let out=[];let context=V.execution_context();
let result=try map{v:V.exec(c,[],map{},out,[],nil,0,context)} catch nil;
V.close_execution(context);
assert(result==nil and out==[1,2],"handler propagates and stops execution");
// The shared runtime cannot be reset by catching an exhausted body.
let global=map{};
result=try V.run_seeded_bounded(compile("let x=try (if true {while true {} 0;} else {0;}) catch 9;let escaped=true;"),global,map{max_steps:20}) catch nil;
assert(result==nil and not map_has(global,"escaped"),"quota remains sticky across catch");
print "selfhost_try_outcome_pass";
