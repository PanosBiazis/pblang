// Test: the pblang-native IDE editor model (stdlib/editor_model.sapp), §90.
//
// The text-editor core of the browser-free pblang IDE — line buffer + cursor + edits.
// Pure pblang, no UI dependency, so it runs in the VM.

let E = import("stdlib/editor_model.sapp");

// typing across newlines builds the right buffer + cursor
let ed = E.new("");
E.insert_text(ed, "fn main() {");
E.newline(ed);
E.insert_text(ed, "  print 1;");
assert(E.line_count(ed) == 2, "two lines after a newline");
assert(ed.row == 1 and ed.col == 10, "cursor at end of the typed second line");
assert(E.text(ed) == "fn main() {\n  print 1;", "buffer reconstructed");

// cursor movement + in-line backspace
E.move_up(ed); E.end(ed);
assert(ed.row == 0 and ed.col == 11, "moved to end of line 0");
E.backspace(ed);
assert(E.current_line(ed) == "fn main() ", "backspace removed the '{'");

// insert in the middle of a line
E.home(ed); E.move_right(ed); E.move_right(ed);
E.insert_char(ed, "X");
assert(E.current_line(ed) == "fnX main() ", "insert at column 2");

// line join via backspace at column 0
let ed2 = E.new("ab\ncd");
ed2.row = 1; ed2.col = 0;
E.backspace(ed2);
assert(E.line_count(ed2) == 1 and E.text(ed2) == "abcd", "backspace at col 0 joins lines");
assert(ed2.row == 0 and ed2.col == 2, "cursor lands at the join point");

// line operations for IDE-grade editing
let lo = E.new("one\ntwo\nthree");
lo.row = 1; lo.col = 2;
E.duplicate_line(lo);
assert(E.text(lo) == "one\ntwo\ntwo\nthree", "duplicate_line copies current line below");
assert(lo.row == 2 and lo.col == 2, "duplicate_line moves cursor to duplicated line");
E.delete_line(lo);
assert(E.text(lo) == "one\ntwo\nthree", "delete_line removes current line");
assert(lo.row == 2 and lo.col == 2, "delete_line keeps cursor near deleted row and clamps col");
let lo2 = E.new("solo");
lo2.col = 4;
E.delete_line(lo2);
assert(E.text(lo2) == "" and lo2.row == 0 and lo2.col == 0, "delete_line leaves one empty line for single-line buffer");
let lm = E.new("one\ntwo\nthree");
lm.row = 1; lm.col = 2;
assert(E.move_line_up(lm), "move_line_up reports movement");
assert(E.text(lm) == "two\none\nthree", "move_line_up swaps with previous line");
assert(lm.row == 0 and lm.col == 2, "move_line_up moves cursor with line");
assert(not E.move_line_up(lm), "move_line_up reports top edge");
assert(E.move_line_down(lm), "move_line_down reports movement");
assert(E.text(lm) == "one\ntwo\nthree", "move_line_down swaps with next line");
assert(lm.row == 1 and lm.col == 2, "move_line_down moves cursor with line");
lm.row = 2;
assert(not E.move_line_down(lm), "move_line_down reports bottom edge");
let cm = E.new("let x = 1;\nprint x;");
cm.row = 0; cm.col = 4;
let cmr = E.toggle_line_comment(cm, "//");
assert(cmr.commented and cmr.lines == 1, "toggle_line_comment comments current line");
assert(E.text(cm) == "// let x = 1;\nprint x;", "toggle_line_comment inserts line comment");
assert(cm.col == 7, "toggle_line_comment moves cursor past inserted prefix");
let cmr2 = E.toggle_line_comment(cm, "//");
assert(not cmr2.commented, "toggle_line_comment uncomments already-commented line");
assert(E.text(cm) == "let x = 1;\nprint x;" and cm.col == 4, "toggle_line_comment restores line and cursor");
let cms = E.new("  let x = 1;\n  print x;\nreturn x;");
cms.row = 0; cms.col = 0; E.set_anchor(cms); cms.row = 2; cms.col = 0;
let cmsr = E.toggle_line_comment(cms, "//");
assert(cmsr.commented and cmsr.lines == 2, "toggle_line_comment treats selection ending at col 0 as previous line");
assert(E.text(cms) == "  // let x = 1;\n  // print x;\nreturn x;", "toggle_line_comment comments selected lines with indentation");
let ind = E.new("a\nb\n c");
ind.row = 1; ind.col = 1;
let indr = E.indent_lines(ind, "    ");
assert(indr.lines == 1 and E.text(ind) == "a\n    b\n c", "indent_lines indents current line");
assert(ind.row == 1 and ind.col == 5, "indent_lines moves cursor with inserted spaces");
let outr = E.outdent_lines(ind, "    ");
assert(outr.changed == 1 and E.text(ind) == "a\nb\n c", "outdent_lines removes one indent prefix");
assert(ind.col == 1, "outdent_lines restores cursor after prefix removal");
let inds = E.new("a\nb\nc");
inds.row = 0; inds.col = 0; E.set_anchor(inds); inds.row = 2; inds.col = 0;
let indsr = E.indent_lines(inds, "  ");
assert(indsr.lines == 2 and E.text(inds) == "  a\n  b\nc", "indent_lines selected span excludes final col-0 line");
inds.row = 0; inds.col = 0; E.set_anchor(inds); inds.row = 2; inds.col = 0;
let outs = E.outdent_lines(inds, "  ");
assert(outs.changed == 2 and E.text(inds) == "a\nb\nc", "outdent_lines selected span removes indentation");
let out_partial = E.new("  x");
out_partial.row = 0; out_partial.col = 2;
let outp = E.outdent_lines(out_partial, "    ");
assert(outp.changed == 1 and E.text(out_partial) == "x" and out_partial.col == 0, "outdent_lines removes partial leading spaces");
let tw = E.new("a   \nb\t\t\nc");
tw.row = 0; tw.col = 9;
let twr = E.trim_trailing_whitespace(tw);
assert(twr.lines == 2 and twr.removed == 5, "trim_trailing_whitespace reports changed lines and removed chars");
assert(E.text(tw) == "a\nb\nc" and tw.col == 1, "trim_trailing_whitespace trims whole buffer and clamps cursor");
let tws = E.new("a   \nb   \nc   ");
tws.row = 0; tws.col = 0; E.set_anchor(tws); tws.row = 2; tws.col = 0;
let twsr = E.trim_trailing_whitespace(tws);
assert(twsr.lines == 2 and E.text(tws) == "a\nb\nc   ", "trim_trailing_whitespace trims selected span only");

// movement clamps at buffer edges (no crash / no negative)
let ed3 = E.new("x");
E.move_up(ed3); E.move_left(ed3); E.move_left(ed3);
assert(ed3.row == 0 and ed3.col == 0, "cursor clamps at the top-left");
E.move_down(ed3); E.move_right(ed3); E.move_right(ed3);
assert(ed3.row == 0 and ed3.col == 1, "cursor clamps at the end");

// scrolling viewport: keep the cursor row on screen
let ed4 = E.new("l0\nl1\nl2\nl3\nl4\nl5");   // 6 lines
ed4.row = 5;
E.ensure_visible(ed4, 3);
assert(ed4.scroll == 3, "scroll so row 5 is visible in a 3-row viewport");
ed4.row = 0;
E.ensure_visible(ed4, 3);
assert(ed4.scroll == 0, "scroll back to show row 0");
E.page_down(ed4, 4);
assert(ed4.row == 4, "page_down moves down 4 (clamped to buffer)");
E.page_up(ed4, 10);
assert(ed4.row == 0, "page_up clamps at the top");

// selection + clipboard
let s = E.new("hello world");
E.set_anchor(s); s.col = 5;
assert(E.has_selection(s) and E.selection_text(s) == "hello", "selection text");
E.copy(s);
assert(s.clipboard == "hello", "copy to clipboard");
E.delete_selection(s);
assert(E.text(s) == " world", "delete selection");
E.home(s); E.paste(s);
assert(E.text(s) == "hello world", "paste restores it");
let lineclip = E.new("alpha\nbeta\ngamma");
lineclip.row = 1; lineclip.col = 2;
assert(E.copy_line(lineclip) == "beta\n", "copy_line copies current line with newline");
assert(lineclip.clipboard == "beta\n" and E.text(lineclip) == "alpha\nbeta\ngamma", "copy_line leaves buffer unchanged");
let cutline = E.new("alpha\nbeta\ngamma");
cutline.row = 1; cutline.col = 2;
assert(E.cut_line(cutline) == "beta\n", "cut_line returns current line with newline");
assert(cutline.clipboard == "beta\n" and E.text(cutline) == "alpha\ngamma", "cut_line removes current line and stores clipboard");
assert(cutline.row == 1 and cutline.col == 2, "cut_line keeps cursor near deleted row");

// multi-line selection text
let s2 = E.new("ab\ncd\nef");
s2.row = 0; s2.col = 1; E.set_anchor(s2); s2.row = 2; s2.col = 1;
assert(E.selection_text(s2) == "b\ncd\ne", "multi-line selection spans rows");

// typing replaces a selection
let r = E.new("hello");
E.set_anchor(r); r.col = 5;
E.insert_text(r, "hi");
assert(E.text(r) == "hi", "typing replaces the selection");

// undo / redo
let u = E.new("abc");
E.snapshot(u); E.insert_text(u, "X");
assert(E.text(u) == "Xabc", "edit applied");
E.undo(u); assert(E.text(u) == "abc", "undo restores");
E.redo(u); assert(E.text(u) == "Xabc", "redo re-applies");

// find (forward, wrapping; selects the match)
let f = E.new("foo bar foo");
f.row = 0; f.col = 0;
assert(E.find_next(f, "foo"), "find_next reports a hit");
assert(f.anchor.col == 8, "found the second 'foo' (after the cursor)");
assert(E.selection_text(f) == "foo", "the match is selected");

// set_cursor (§101) — absolute caret placement for mouse click, clamped to the buffer
let edm = E.new("hello\nworld foo\nx");
E.set_cursor(edm, 1, 6);   assert(edm.row == 1 and edm.col == 6, "set_cursor places mid-line");
E.set_cursor(edm, 1, 999); assert(edm.col == 9, "set_cursor clamps col to line length");
E.set_cursor(edm, 99, 2);  assert(edm.row == 2 and edm.col == 1, "set_cursor clamps row + col");
E.set_cursor(edm, -5, -5); assert(edm.row == 0 and edm.col == 0, "set_cursor clamps negatives");
E.set_cursor(edm, 1.9, 4.8); assert(edm.row == 1 and edm.col == 4, "set_cursor floors fractional mouse coordinates");
E.set_cursor(edm, 0, 1); E.set_anchor(edm); E.set_cursor(edm, 0, 4);
let rng = E.selection_range(edm);
assert(rng != nil and rng.start.col == 1 and rng.end.col == 4, "set_cursor + anchor drag selection");

// word-wise movement (Ctrl+Left / Ctrl+Right) — skip non-word runs then the word
let wm = E.new("foo_bar  baz(qux)");
wm.row = 0; wm.col = 0;
E.move_word_right(wm); assert(wm.col == 7, "word-right stops after 'foo_bar'");
E.move_word_right(wm); assert(wm.col == 12, "word-right skips spaces, stops after 'baz'");
E.move_word_left(wm);  assert(wm.col == 9, "word-left lands at start of 'baz'");
E.move_word_left(wm);  assert(wm.col == 0, "word-left skips back over '  ' to 'foo_bar' start");
let wm2 = E.new("ab\ncd");
wm2.row = 1; wm2.col = 0; E.move_word_left(wm2);
assert(wm2.row == 0 and wm2.col == 2, "word-left at col 0 crosses to previous line");

// revision metadata: PBIDE uses this to avoid full-buffer hashing on every repaint
let rev = E.new("abc");
assert(rev.rev == 0, "new editor starts at revision zero");
E.copy_line(rev);
assert(rev.rev == 0, "copy_line does not mutate revision");
E.insert_char(rev, "x");
assert(rev.rev > 0 and E.text(rev) == "xabc", "insert_char bumps revision");
let rev_after_insert = rev.rev;
E.snapshot(rev);
E.backspace(rev);
assert(rev.rev > rev_after_insert, "backspace bumps revision");
let rev_after_backspace = rev.rev;
E.undo(rev);
assert(rev.rev > rev_after_backspace and E.text(rev) == "xabc", "undo bumps revision after restoring text");
let no_trim = E.new("abc");
let no_trim_rev = no_trim.rev;
E.trim_trailing_whitespace(no_trim);
assert(no_trim.rev == no_trim_rev, "no-op trim does not bump revision");

print "editor_model_pass";
