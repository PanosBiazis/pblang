let D = import("stdlib:diagnostics.sapp");
fn has_code(result, code) {
    for item in result.diagnostics { if item.code == code { return true; } }
    return false;
}
for source in ["fn f(x:number){return x;} f();", "let unused=nil-1;", "let x:number=\"bad\";"] {
    let lint = D.diagnose(source);
    assert(lint.ok, "legacy lint remains separate from type checking");
    let result = D.diagnose_checked(source);
    assert(not result.ok and result.type_checked and result.counts.error > 0, "checked diagnostics reject type failures");
    assert(len(result.errors) == result.counts.error, "error count matches array");
    assert(result.counts.warning == lint.counts.warning, "warnings retained alongside errors");
    assert(str_contains(D.format(result), "error["), "format includes type diagnostics");
}
assert(has_code(D.diagnose_checked("fn f(x){return x;} f();"), "arity"), "stable arity code");
assert(has_code(D.diagnose_checked("let n=nil-1;"), "nil-arithmetic"), "stable operand code");
for source in ["let = ;", "/* unclosed", "print absent;"] {
    let old = D.diagnose(source); let checked = D.diagnose_checked(source);
    assert(not checked.ok and not checked.type_checked, "existing error skips type checking");
    assert(json_stringify(old.diagnostics) == json_stringify(checked.diagnostics), "no duplicated parser/name errors");
}
for source in [nil, "", "  ", "/* comment only */"] {
    let result = D.diagnose_checked(source);
    assert(not result.ok and result.counts.error > 0 and not result.type_checked, "empty source fails closed");
}
for source in ["let n=1; print n;", "fn f(x:number=2){return x;} f();", "throw \"not executed\";"] {
    let result = D.diagnose_checked(source);
    assert(result.ok and result.type_checked, "valid or throwing program is checked without execution");
}
let line = D.diagnose_checked("\nlet x:number=\"bad\";");
assert(line.errors[0].line == 2 and line.errors[0].span.line == 2, "type diagnostic location preserved");
let first = D.diagnose_checked("let n=1; print n;"); array_push(first.errors, map{message:"injected"});
assert(D.diagnose_checked("let n=1; print n;").counts.error == 0, "results isolated");
assert(not D.diagnose_checked("print n;").ok, "scope does not leak");
print "diagnostics_checked_pass";
