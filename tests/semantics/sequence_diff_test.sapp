let D=import("stdlib:sequence_diff.sapp");
fn lcs(a,b,i=0,j=0){if i==len(a) or j==len(b){return 0;}if a[i]==b[j]{return 1+lcs(a,b,i+1,j+1);}return num_max(lcs(a,b,i+1,j),lcs(a,b,i,j+1));}
fn check(a,b){let before=json_stringify([a,b]);let d=D.compare(a,b);let left=[];let right=[];let li=0;let ri=0;
    for op in d.operations {
        assert(op.kind=="equal" or op.kind=="delete" or op.kind=="insert","known op");
        if op.kind!="insert"{assert(op.left==li,"left ordering");array_push(left,a[op.left]);li=li+1;} else {assert(op.left==nil,"insert lacks left");}
        if op.kind!="delete"{assert(op.right==ri,"right ordering");array_push(right,b[op.right]);ri=ri+1;} else {assert(op.right==nil,"delete lacks right");}
        if op.kind=="equal"{assert(a[op.left]==b[op.right],"equal content");}
    }
    assert(left==a and right==b,"both sequences reconstructed");assert(d.equal==lcs(a,b),"minimum insertion/deletion distance");
    assert(d.inserted==len(b)-d.equal and d.deleted==len(a)-d.equal,"counts");assert(json_stringify([a,b])==before,"sources preserved");
}
let cases=[[]];for size in range(1,4){let previous=[];for seq in cases{if len(seq)==size-1{array_push(previous,seq);}}for seq in previous{for token in ["a","b"]{let next=[];for s in seq{array_push(next,s);}array_push(next,token);array_push(cases,next);}}}
for a in cases{for b in cases{check(a,b);}}check(["α","界",""],["α","new","界",""]);
let maximum=[];for i in range(0,128){array_push(maximum,str(i));}let same=D.compare(maximum,maximum);assert(same.equal==128 and same.inserted==0,"maximum identity");
let changed=[];for i in range(0,128){array_push(changed,"x"+str(i));}assert(D.compare(maximum,changed).deleted==128,"maximum disjoint");
for bad in [nil,1,"a",[1],[str_repeat("é",1025)]]{assert((try D.compare(bad,[]) catch nil)==nil,"malformed input");}
array_push(maximum,"extra");assert((try D.compare(maximum,[]) catch nil)==nil,"item count");let large=[];for i in range(0,33){array_push(large,str_repeat("x",2048));}assert((try D.compare(large,[]) catch nil)==nil,"total bytes");
print "sequence_diff_pass";
