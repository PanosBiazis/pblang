let ecs = import("stdlib:ecs.sapp");
let world = ecs.create_world();
let player = ecs.spawn(world, map{ position: map{x: 0, y: 0}, health: 100, name: "Player" });
let enemy = ecs.spawn(world, map{ position: map{x: 5, y: 5}, health: 50 });
let wall = ecs.spawn(world, map{ position: map{x: 2, y: 2}, solid: true });
assert(ecs.entity_count(world) == 3, "should have 3 entities");
assert(ecs.has_component(world, player, "health") == true, "player should have health");
assert(ecs.has_component(world, wall, "health") == false, "wall should not have health");
let hp = ecs.get_component(world, player, "health");
assert(hp == 100, "player health should be 100");
ecs.set_component(world, player, "health", 80);
assert(ecs.get_component(world, player, "health") == 80, "health should be 80 after set");
let living = ecs.query(world, ["position", "health"]);
assert(len(living) == 2, "query should find 2 entities with position+health");
ecs.despawn(world, enemy);
assert(ecs.entity_count(world) == 2, "should have 2 after despawn");
print "ecs_stdlib_pass";
