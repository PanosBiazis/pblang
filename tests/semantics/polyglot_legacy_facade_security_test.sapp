let POLY = import("stdlib:polyglot.sapp");

fn expect(value, message) {
    if not value { throw "FAIL polyglot legacy facade security: " + message; }
}

fn denied(result) {
    return not result.ok and not result.executed and not result.raw_fallback;
}

expect(denied(POLY.run_block("python3", "print(1)")),
    "run_block must not infer trust");
expect(denied(POLY.exec("node", "console.log(1)")),
    "exec must not infer trust");
expect(denied(POLY.run("bash", "echo nope")),
    "run must not infer trust");
expect(denied(POLY.exec_with_input("bash", "cat", str_repeat("x", 1048577),
    map{ trusted_source: true })),
    "oversized stdin must fail before execution");
expect(denied(POLY.exec_compiled("c", "int main(void){return 0;}",
    map{ trusted_source: true })),
    "compile-and-run must remain disabled");

let load_blocked = try { POLY.compile_cached("c", "int f(void){return 1;}"); false }
    catch true;
expect(load_blocked, "legacy in-process compilation and loading must throw");

let clear = POLY.cache_clear();
expect(not clear.ok and clear.removed == 0 and not clear.raw_fallback,
    "legacy cache clearing must not touch native cache paths");

let first = POLY.detect();
first.python.command = "poisoned";
let second = POLY.detect();
expect(second.python.command != "poisoned" and not second.python.execution_authorized,
    "detection results must be detached and non-authorizing");

print "polyglot_legacy_facade_security_pass";
