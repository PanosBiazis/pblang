let App=import("../../examples/declarative_browser/app.sapp");let GUI=import("stdlib:gui.sapp");let D=import("stdlib:browser_document.sapp");
let n=0;fn check(ok,label){assert(ok,label);n=n+1;}
fn key(c,k){App.update(c,[map{type:"keydown",key:k},map{type:"keyup",key:k}]);}
for size in [map{w:320,h:240},map{w:320,h:480},map{w:390,h:600}] {
 for target in ["block2","block3"] {
  let c=App.create();let original=c.session.snapshot();let content=D.export_html(original.document);let appearance=c.appearance;
  c.form.focus=target;App.update(c,[map{type:"resize",w:size.w,h:size.h}]);
  check(c.form.focus==target and GUI.get(c.form,target)!=nil,"resize keeps the focused link visible");
  check(c.session.snapshot()==original and D.export_html(c.session.snapshot().document)==content and c.appearance==appearance,"resize changes no document, navigation or appearance");
  check(c.navigations==0 and c.reading_anchor.kind=="link","resize anchors to the actual link without activating it");
  App.update(c,[map{type:"resize",w:800,h:816}]);check(c.form.focus==target,"expansion retains focused link");
  App.update(c,[map{type:"resize",w:320,h:240},map{type:"keydown",key:"Enter"},map{type:"keydown",key:"Enter"},map{type:"keyup",key:"Enter"}]);
  check(c.session.snapshot().url==(if target=="block2" {"pb://guide"}else{"pb://about"}) and c.navigations==1,"same-batch resize/held Enter follows exactly one link");c.session.close();
 }
}
// Existing position semantics remain for no focus, toolbar focus, disabled or hidden links.
for focus in [nil,"appearance","missing","page_title","disabled","hidden"] {
 let c=App.create();let anchor=c.reading_anchor;
 if focus=="disabled" or focus=="hidden" {c.form.focus="block2";let w=GUI.get(c.form,"block2");if focus=="disabled" {w.enabled=false;} if focus=="hidden" {w.visible=false;}}
 if focus!="disabled" and focus!="hidden" {c.form.focus=focus;}
 App.update(c,[map{type:"resize",w:320,h:240}]);check(c.reading_anchor==anchor,"only an enabled visible document link changes resize anchor");c.session.close();
}
// Ordinary paging after resize still leaves the link page; it must not snap back.
let c=App.create();c.form.focus="block3";App.update(c,[map{type:"resize",w:320,h:240}]);let page=c.reading_page;key(c,"Home");check(c.reading_page==0 and page>0,"explicit Home paging wins over prior link focus");c.session.close();
let style=App.create();GUI.get(style.form,"appearance").onclick(style.form);App.update(style,[]);style.form.focus="font_scale";let anchor=style.reading_anchor;App.update(style,[map{type:"resize",w:320,h:240}]);check(style.form.focus=="font_scale" and style.reading_anchor==anchor,"Style resize stays in existing preference focus flow");style.session.close();
let unchanged=App.create();unchanged.form.focus="block2";let prior=unchanged.reading_anchor;App.update(unchanged,[map{type:"resize",w:800,h:816}]);check(unchanged.reading_anchor==prior,"same-size event keeps the existing anchor");unchanged.session.close();
let changed=App.create();changed.form.focus="block2";changed.session.navigate("pb://guide");App.update(changed,[map{type:"resize",w:320,h:240}]);check(changed.reading_anchor.block==-1 and changed.session.snapshot().url=="pb://guide","stale focus from an externally replaced document is ignored");changed.session.close();
let closing=App.create();closing.form.focus="block2";prior=closing.reading_anchor;App.update(closing,[map{type:"close"},map{type:"resize",w:320,h:240}]);check(closing.form.close_requested and closing.reading_anchor==prior and closing.width==800,"close prevents resize focus work");closing.session.close();
let source=D.export_html(D.create("Link position",[map{tag:"p",text:"Read the link below"},map{tag:"a",text:str_repeat("Long link label ",4),href:"pb://guide"}]));
let long=App.create("local","dark",nil,source);long.form.focus="block1";App.update(long,[map{type:"resize",w:320,h:240}]);check(long.form.focus=="block1" and GUI.get(long.form,"block1")!=nil,"long link label anchors its button, not an earlier label row");check(long.reading_anchor.kind=="link" and long.reading_anchor.offset==63,"typed link anchor follows normalized label text");key(long,"Enter");check(long.session.snapshot().url=="pb://guide","long-label link still opens");long.session.close();
print "reader_resize_focus_pass checks="+str(n);
