// tests/semantics/selfhost_loader_runtime_error_test.sapp
//
// The .pbck loader (stdlib/selfhost_loader.sapp) must CONTAIN execution failures.
// run_pbck/run_pbck_seeded/run_pbck_bytes/cli_run are documented to return a
// structured result, and cli_run is "pure ... directly testable" — but _run_chunk
// called vm.run_seeded WITHOUT a try/catch, so a .pbck that loaded fine yet threw
// at RUNTIME (an uncaught throw / undefined global) crashed the loader (and pbrun)
// instead of reporting {ok:false}. A loader runs arbitrary bytecode; an error in
// that bytecode must not take down the host.

let fe = import("stdlib/compiler/selfhost_frontend.sapp");
let pb = import("stdlib/selfhost_pbck.sapp");
let ld = import("stdlib/selfhost_loader.sapp");

fn fail(m) { throw "FAIL " + m; }

fn write(src) {
    let p = "/tmp/ldre_" + str(num_floor(now_ms())) + "_" + str(len(src)) + ".pbcs";
    pb.write_file(p, fe.frontend_compile(src).chunk);
    return p;
}

// 1. A program that throws at runtime: run_pbck returns {ok:false}, does NOT crash.
let p_throw = write("let x = 1; throw \"boom\"; print x;");
let r = try ld.run_pbck(p_throw) catch "THREW";
if r == "THREW" { fail("run_pbck must not crash on a runtime-throwing program"); }
if r.ok { fail("run_pbck must report ok:false for a throwing program"); }

// 2. An undefined-global call also raises at runtime -> contained.
let p_undef = write("print not_a_real_fn();");
let r2 = try ld.run_pbck(p_undef) catch "THREW";
if r2 == "THREW" { fail("run_pbck must not crash on an undefined-global program"); }
if r2.ok { fail("run_pbck must report ok:false for an undefined-global program"); }

// 3. cli_run returns a structured failure with exit_code 1 (its documented contract).
let c = try ld.cli_run([p_throw]) catch "THREW";
if c == "THREW" { fail("cli_run must not crash on a throwing program (pbrun would die)"); }
if c.ok or c.exit_code != 1 { fail("cli_run must return ok:false, exit_code 1 for a runtime error"); }

// 4. run_pbck_bytes (the .pbself path) also contains runtime throws.
let bytes = pb.serialize_chunk(fe.frontend_compile("throw \"x\";").chunk);
let rb = try ld.run_pbck_bytes(bytes) catch "THREW";
if rb == "THREW" { fail("run_pbck_bytes must not crash on a throwing payload"); }
if rb.ok { fail("run_pbck_bytes must report ok:false for a throwing payload"); }

// 5. Regression: a NORMAL program still runs and reports ok:true with output.
let p_ok = write("print 6 * 7;");
let ro = ld.run_pbck(p_ok);
if not ro.ok { fail("normal program must run ok"); }
if ro.output[0] != 42 { fail("normal program output, got " + str(ro.output[0])); }
let co = ld.cli_run([p_ok]);
if not co.ok or co.exit_code != 0 { fail("cli_run on a normal program must be ok exit 0"); }
if co.output[0] != 42 { fail("cli_run output, got " + str(co.output[0])); }

// 6. Regression: a missing path still returns the structured load failure.
let rm = ld.run_pbck("/tmp/definitely_missing_" + str(num_floor(now_ms())) + ".pbcs");
if rm.ok { fail("missing path must be ok:false"); }

// 7. The pbrun CLI tool propagates the failure to the PROCESS exit code (so shell
//    scripts can detect a failed run) and does not crash.
let pr_throw = proc_spawn_wait("pblang", ["run", "tools/pbrun.sapp", "--allow-all", p_throw]);
if pr_throw.exit_code == 0 { fail("pbrun must exit nonzero on a runtime-throwing program"); }
if not str_contains(pr_throw.stdout + pr_throw.stderr, "runtime error") { fail("pbrun must report the runtime error"); }
let pr_ok = proc_spawn_wait("pblang", ["run", "tools/pbrun.sapp", "--allow-all", p_ok]);
if pr_ok.exit_code != 0 { fail("pbrun must exit 0 on a normal program"); }
if str_trim(pr_ok.stdout) != "42" { fail("pbrun normal output, got '" + str_trim(pr_ok.stdout) + "'"); }

print "selfhost_loader_runtime_error_pass";
