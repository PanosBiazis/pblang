let P=import("stdlib:offer_plan.sapp");
fn rejects(f) {let rejected=false;try {f();} catch {rejected=true;}assert(rejected,"invalid scenario rejected");}
fn offer() {return map{id:"test",price_cents:14900,unit_cost_cents:500,fee_bps:1000,fee_fixed_cents:50,units:17,minutes_per_sale:20};}
fn plan() {return map{target_cents:200000,fixed_cost_cents:10000,fixed_minutes:600,available_minutes:1200,offers:[offer()]};}
let source=plan();let original=json_stringify(source);let r=P.calculate(source);
assert(r.gross_cents==253300 and r.fees_cents==26180 and r.variable_cost_cents==8500,"entered unit economics");
assert(r.contribution_after_fixed_cents==208620 and r.target_met and r.shortfall_cents==0,"contribution after fixed costs");
assert(r.workload_minutes==940 and r.time_fits and r.offers[0].solo_units_for_target==17,"sales and time required");
assert(json_stringify(source)==original,"input preserved");r.offers[0].id="changed";assert(source.offers[0].id=="test","detached output");
assert(P.parse_amount("0.01")==1 and P.parse_amount("1.2")==120 and P.parse_amount("10000000.00")==1000000000,"exact cent parsing");
for text in ["",".50","1.","1.001","1e2","-1","+1","1,00"," 1","1 ","NaN","10000000.01","１２","1.2.3"] {rejects(fn(){P.parse_amount(text);});}
for text in ["1.0","-1","+1","true","1e3"," ","10000000000"] {rejects(fn(){P.parse_integer(text);});}
rejects(fn(){P.parse_amount(nil);});rejects(fn(){P.parse_integer("1",-1);});
let tiny=plan();tiny.target_cents=1;tiny.fixed_cost_cents=0;tiny.offers[0].price_cents=1;tiny.offers[0].unit_cost_cents=0;tiny.offers[0].fee_fixed_cents=0;tiny.offers[0].fee_bps=1;
let t=P.calculate(tiny);assert(t.offers[0].fee_per_sale_cents==1 and t.offers[0].solo_units_for_target==nil,"percentage rounds up per sale; zero contribution unreachable");
tiny.offers[0].fee_bps=0;tiny.offers[0].units=0;assert(P.calculate(tiny).fees_cents==0,"zero sales pay no per-sale fee");
tiny.target_cents=100001;assert(P.calculate(tiny).offers[0].solo_target_status=="exceeds_unit_limit","unit cap explicit");
tiny.target_cents=0;tiny.offers[0].unit_cost_cents=2;tiny.offers[0].units=1;
t=P.calculate(tiny);assert(t.offers[0].solo_units_for_target==0 and not t.target_met and t.contribution_after_fixed_cents==-1,"zero sales meet zero target but entered loss does not");
let workload=plan();workload.available_minutes=939;assert(not P.calculate(workload).time_fits,"one minute overload");
workload.available_minutes=940;assert(P.calculate(workload).time_fits,"exact time boundary");
workload.offers[0].minutes_per_sale=0;workload.available_minutes=600;assert(P.calculate(workload).offers[0].solo_fits_time,"zero incremental time still includes fixed work");
for price in [1,7,100,14900] {for target in [0,1,10,999] {
    let p=plan();p.target_cents=target;p.fixed_cost_cents=11;p.offers[0].price_cents=price;p.offers[0].fee_bps=0;p.offers[0].fee_fixed_cents=0;p.offers[0].unit_cost_cents=0;
    let n=P.calculate(p).offers[0].solo_units_for_target;
    assert(n*price>=target+11 and (n-1)*price<target+11,"required count is minimal integer");
}}
for name in ["target_cents","fixed_cost_cents","available_minutes","fixed_minutes"] {
    for value in [-1,0.1,true,"1",nil,1000000001] {let p=plan();p[name]=value;rejects(fn(){P.calculate(p);});}
}
for name in ["price_cents","unit_cost_cents","fee_fixed_cents","fee_bps","units","minutes_per_sale"] {
    for value in [-1,0.5,true,"1",nil,100000001] {let p=plan();p.offers[0][name]=value;rejects(fn(){P.calculate(p);});}
}
let duplicate=plan();array_push(duplicate.offers,offer());rejects(fn(){P.calculate(duplicate);});
let extra=plan();extra.extra=1;rejects(fn(){P.calculate(extra);});
let missing=plan();map_remove(missing,"target_cents");rejects(fn(){P.calculate(missing);});
let invalid=plan();invalid.offers[0].id="private name";rejects(fn(){P.calculate(invalid);});
invalid=plan();invalid.offers=[];rejects(fn(){P.calculate(invalid);});
let maximum=plan();maximum.offers=[];
for i in range(0,16) {let o=offer();o.id="offer-"+str(i);o.price_cents=100000000;o.unit_cost_cents=0;o.fee_fixed_cents=0;o.fee_bps=10000;o.units=100000;o.minutes_per_sale=10000;array_push(maximum.offers,o);}
let m=P.calculate(maximum);assert(m.gross_cents==160000000000000 and m.fees_cents==m.gross_cents and m.workload_minutes==16000000600,"bounded aggregate arithmetic exact");
array_push(maximum.offers,offer());rejects(fn(){P.calculate(maximum);});
assert(not m.demand_verified and not m.tax_included and not m.safe_to_log and m.scenario_only,"scope is explicit");
print "offer_plan_pass";
