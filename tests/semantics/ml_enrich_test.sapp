// tests/semantics/ml_enrich_test.sapp — enrichment for stdlib/ml.sapp
// ml.sapp had metrics/preprocessing but no learners. Adds linear regression,
// k-NN classification, and k-means clustering.

let ml = import("stdlib/ml.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base metric still works ──────────────────────────────────────────────────────
near(ml.accuracy([1, 0, 1], [1, 0, 0]), 2 / 3, "accuracy");

// ── ENRICH: linear regression (y = 2x + 1) ───────────────────────────────────────
let model = ml.linreg_fit([1, 2, 3, 4], [3, 5, 7, 9]);
near(model.slope, 2, "linreg slope"); near(model.intercept, 1, "linreg intercept");
near(ml.linreg_predict(model, 10), 21, "linreg predict");

// ── ENRICH: k-NN classification ──────────────────────────────────────────────────
let X = [[0, 0], [0, 1], [10, 10], [10, 11]];
let y = ["a", "a", "b", "b"];
if ml.knn_classify(X, y, [0, 0.5], 2) != "a" { fail("knn near cluster a -> a"); }
if ml.knn_classify(X, y, [10, 10.5], 2) != "b" { fail("knn near cluster b -> b"); }

// ── ENRICH: k-means clustering (two well-separated clusters) ──────────────────────
let pts = [[0, 0], [0, 1], [10, 10], [10, 11]];
let km = ml.kmeans(pts, 2, 10);
let a = km.assignments;
if a[0] != a[1] { fail("kmeans: points 0,1 should share a cluster"); }
if a[2] != a[3] { fail("kmeans: points 2,3 should share a cluster"); }
if a[0] == a[2] { fail("kmeans: the two clusters must differ"); }

print "ml_enrich_pass";
