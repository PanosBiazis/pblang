let API=import("stdlib:ops_services.sapp");
let ngrok=API.request("ngrok");
assert(ngrok.url=="https://api.ngrok.com/endpoints" and ngrok.headers["Ngrok-Version"]=="2","ngrok request recipe");
assert(API.request("netlify").url=="https://api.netlify.com/api/v1/sites?page=1&per_page=100","bounded Netlify first page");
assert(API.request("tailscale",map{tailnet:"example.com"}).url=="https://api.tailscale.com/api/v2/tailnet/example.com/devices","Tailscale request recipe");
let calls=0;
let transport=fn(plan){calls=calls+1;assert(plan.method=="GET" and not plan.follow_redirects,"read-only no redirects requested");return map{status:200,body:"{\"items\":[]}"};};
assert(not API.fetch("ngrok",nil,transport).ok and calls==0,"no network callback by default");
let good=API.fetch("ngrok",nil,transport,true);
assert(good.ok and calls==1 and not good.complete_inventory and not good.transport_verified,"callback invoked once, no fake inventory/transport proof");
for body in ["{\"a\":1,\"a\":2}", "not json", str_repeat("é",32769)] {
    let bad=API.fetch("netlify",nil,fn(plan){return map{status:200,body:body};},true);
    assert(not bad.ok and bad.data==nil,"invalid/oversized JSON response rejected");
}
for status in [301,401,429,500] {
    let bad=API.fetch("ngrok",nil,fn(plan){return map{status:status,body:"synthetic-sensitive-response"};},true);
    assert(not bad.ok and not str_contains(json_stringify(bad),"synthetic-sensitive-response"),"HTTP errors neither retry nor leak response text");
}
let thrown=API.fetch("ngrok",nil,fn(plan){throw "synthetic-sensitive-exception";},true);
assert(not str_contains(json_stringify(thrown),"synthetic-sensitive-exception"),"adapter exception masked");
fn reject(service,params) {let bad=try API.request(service,params) catch nil;assert(bad==nil,"unknown or injected parameter rejected");}
reject("unknown",nil); reject("ngrok",map{url:"https://example.invalid"});
for tailnet in ["", ".", "..", "../devices", "x?admin=1", "x\r\nHost: bad", str_repeat("x",129)] {reject("tailscale",map{tailnet:tailnet});}
assert(not map_has(ngrok.headers,"Authorization") and ngrok.authentication=="adapter-owned","no embedded credentials");
let exact=API.fetch("netlify",nil,fn(plan){return map{status:200,body:"\""+str_repeat("é",32767)+"\""};},true);
assert(exact.ok and len(exact.data)==32767,"exact 65536 UTF-8 response bytes accepted");
assert(not API.fetch("ngrok",nil,transport,"true").ok and calls==1,"truthy non-boolean opt-in rejected");
let extra=API.fetch("ngrok",nil,fn(plan){return map{status:200,body:"[]",extra:true};},true);
assert(not extra.ok,"unknown adapter response fields rejected");
print "ops_services_pass";
