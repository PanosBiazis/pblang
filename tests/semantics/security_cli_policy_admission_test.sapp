// Run each CLI in a separately supervised process using PB_POLICY_CLI_TOOL.
let OS=import("stdlib:os.sapp");
let failure_label="unexpected exception";
fn expect(ok,label) {if not ok {failure_label=label;throw label;}}
let tool=env_get("PB_POLICY_CLI_TOOL") ?? "pbsecure";
expect(tool=="pbsecure" or tool=="pbanalyze","known tool");
let compiler=env_get("PBLANG_BIN") ?? (if fs_exists("/proc/self/exe") {"/proc/self/exe"} else {"pblang"});
let root=path_join(OS.temp_dir(),"pblang_policy_"+str_slice(sha256(str(now_ms())+str(random_bytes(8))),0,16));
let source=root+".sapp";let config=root+".json";let output=root+".report.json";
fn invoke(extra) {
    let args=["tools/"+tool+".sapp","--allow-all","--",source,"--config="+config];
    for arg in extra {push(args,arg);}
    return proc_spawn_wait(compiler,args);
}
fn reject(extra,expected) {
    let run=invoke(extra);expect(run.exit_code==2,"configuration error exit status");
    let report=json_parse(str_trim(run.stdout));
    expect(not report.ok and str_starts_with(report.error,expected),"policy rejection before missing source");
    expect(not str_contains(run.stdout,source) and not str_contains(run.stdout,"private-policy-marker"),"no source or policy-value echo");
}
fn exercise() {
    fs_write(config,json_stringify(map{taint_sinks:map{unused:map{severity:"HIGH",class:"fixture",args:[0]}}}));
    reject([],"invalid taint sink policy");
    if tool=="pbsecure" {reject(["--mode=audit"],"invalid taint sink policy");reject(["--mode=protect"],"invalid taint sink policy");}
    else {reject(["--analysis=all"],"invalid taint sink policy");}
    fs_write(config,json_stringify(map{custom_rules:[map{id:"bad id",needle:"private-policy-marker"}]}));
    reject([],"invalid security analysis configuration");
    reject(["--entry-only"],"invalid security analysis configuration");
    if tool=="pbsecure" {
        let published=invoke(["--json-output="+output]);
        expect(published.exit_code==2 and published.stdout=="","invalid config file report is silent");
        let saved=fs_read(output);let report=json_parse(saved);
        expect(not report.ok and report.config_snapshot_verification.ok and report.config_snapshot_verification.stable,"early rejection retains config snapshot");
        expect(not map_has(report,"snapshot_verification") and not str_contains(saved,source),"no claim of source snapshot or path");
        let repeated=invoke(["--json-output="+output]);
        expect(repeated.exit_code==2 and repeated.stdout=="" and fs_read(output)==saved,"existing output preserved");
        let before=fs_read(config);let collision=invoke(["--json-output="+config]);
        expect(collision.exit_code==2 and collision.stdout=="" and fs_read(config)==before,"config collision preserved");
    }
    fs_write(config,json_stringify(map{max_taint_tokens:0}));
    reject([],"max_taint_tokens");
    fs_write(config,json_stringify(map{disabled_rule_ids:42}));
    reject([],"invalid security analysis configuration");
    fs_write(source,"let value=1;\n");
    fs_write(config,json_stringify(map{taint_sources:[nil]}));
    expect(invoke(["--entry-only"]).exit_code==0,"entry-only ignores unused taint options");
    if tool=="pbanalyze" {expect(invoke(["--analysis=performance"]).exit_code==0,"non-security selection ignores unused policy");}
    fs_write(config,json_stringify(map{disabled_rule_ids:nil,custom_rules:nil,taint_sources:nil}));
    expect(invoke([]).exit_code==0,"dependency nil-as-unset remains valid");
    reject(["--entry-only"],"invalid security analysis configuration");
    if tool=="pbsecure" {
        fs_write(config,json_stringify(map{disabled_rule_ids:nil,custom_rules:[map{id:"fixture.rule",needle:"value",severity:"high"}]}));
        expect(invoke([]).exit_code==1,"nil disabled list does not suppress rule");
        expect(invoke(["--disable-rule=fixture.rule"]).exit_code==0,"CLI disable merges with dependency nil");
    }
    return true;
}
let succeeded=try exercise() catch false;
for path in [source,config,output] {if fs_exists(path) {fs_remove(path);}}
if not succeeded {throw "FAIL security-cli-policy: "+failure_label;}
print "security_cli_policy_admission_"+tool+"_pass";
