let A = import("stdlib:async.sapp");
fn value_task(value) { return fn(){ return value; }; }
fn slow_task(sender) { return fn(){ sleep_ms(40); send(sender, true); return 17; }; }
fn verify_failure(task) {
    let signal = channel_buffered(1);
    let failed = A.go(task);
    let slow = A.go(slow_task(signal.sender));
    let last = A.go(fn(){ return false; });
    let futures = [failed, slow, last, failed];
    let threw = try { A.await_all(futures); false } catch true;
    let all_done = failed.resolved and slow.resolved and last.resolved;
    let closed = channel_is_closed(slow.channel.receiver) and channel_is_closed(last.channel.receiver);
    // Reap even when testing the previous implementation, before assertions.
    let states = A.all_settled(futures);
    let delivered = recv_timeout(signal.receiver, 0);
    channel_close(signal.sender);
    assert(threw, "failure must propagate");
    assert(all_done and closed, "await_all must settle later siblings before throwing");
    assert(delivered == true, "later sibling completed its effect exactly once");
    assert(not states[0].ok and states[1].value == 17 and states[2].value == false, "cached terminal states");
    assert((try { A.await_all(futures); false } catch true), "repeated failure remains cached");
    assert(channel_size(slow.channel.receiver) == 0, "result payload consumed");
}
verify_failure(fn(){ throw "task failed"; });
verify_failure(fn(){ return fn(){ return 1; }; });
assert(len(A.await_all([])) == 0, "empty set");
let futures = [];
let values = [nil, false, 0, "", [], map{ok:false,value:nil}];
for value in values { array_push(futures, A.go(value_task(value))); }
assert(json_stringify(A.await_all(futures)) == json_stringify(values), "ordered ordinary values");
assert(json_stringify(A.await_all(futures)) == json_stringify(values), "cached success");
let repeated = A.go(fn(){return 42;});
assert(A.await_all([repeated,repeated]) == [42,42], "repeated future");
let signal = channel_buffered(1);
let failed = try { A.gather([fn(){throw "fail";}, slow_task(signal.sender)]); false } catch true;
let delivered = recv_timeout(signal.receiver, 0);
channel_close(signal.sender);
assert(failed and delivered == true, "gather preserves sibling settlement");
print "async_await_all_ownership_pass";
