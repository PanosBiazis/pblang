// tests/semantics/llm_weights_enrich_test.sapp — enrichment for stdlib/llm_weights.sapp
// Adds param_bytes; covers estimate_params + split/join round-trip (in-memory).

let w = import("stdlib/llm_weights.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let model = map{
    format: "t", config: map{},
    token_embedding: [[0.1, 0.2]], pos_embedding: [[0.0]],
    lm_head: [[0.1, 0.2]], lm_bias: [0.0],
    layers: []
};

// ── estimate_params (2 + 1 + 2 + 1) ──────────────────────────────────────────────
eq(w.estimate_params(model), 6, "estimate_params");

// ── ENRICH: param_bytes ──────────────────────────────────────────────────────────
eq(w.param_bytes(model, 16), 12, "param_bytes @16-bit = 6*2");
eq(w.param_bytes(model, 8), 6, "param_bytes @8-bit = 6*1");

// ── split/join round-trip reconstructs the model ─────────────────────────────────
let shards = w.split_model(model);
let man = w.manifest(model, map{}, "m", "tiny");
let rebuilt = w.join_model(man, shards);
eq(rebuilt.token_embedding[0][1], 0.2, "roundtrip token_embedding");
eq(len(rebuilt.lm_bias), 1, "roundtrip lm_bias");
eq(rebuilt.format, "t", "roundtrip format from manifest");

print "llm_weights_enrich_pass";
