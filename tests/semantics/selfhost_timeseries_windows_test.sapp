let FE=import("stdlib:compiler/selfhost_frontend.sapp");
let src="let T=import(\"stdlib:timeseries.sapp\");let a=[];for i 24 {push(a,i);}"
 +"let s=T.rolling_sum(a,8);let m=T.sma(a,8);let result=[s[0],s[16],m[0],T.rolling_min([3,1,2],2),T.rolling_max([3,1,2],2)];";
let result=FE.frontend_run_bounded(src,map{max_steps:100000,max_frames:32,max_modules:8,max_source_bytes:65536});
assert(result.ok,"bounded selfhost execution");
assert(result.globals.result==[28,156,3.5,[1,1],[3,2]],"selfhost windows");
print "selfhost_timeseries_windows_pass";
