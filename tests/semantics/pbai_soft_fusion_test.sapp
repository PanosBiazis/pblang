// tests/semantics/pbai_soft_fusion_test.sapp — SOFT VOTING (score-vector fusion).
// Hard voting throws away everything but each model's top pick; soft fusion sums the
// full weighted score DISTRIBUTIONS, so a model's strong second choice still counts.
// Classic ensemble result: soft voting beats hard voting when models are calibrated.

let ens = import("stdlib/pbai_ensemble.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// native: weak explain (0.40 explain / 0.35 bugs / 0.25 improve)
let scores = fn(p) { return map{ intent: "explain", scores: [0.4, 0.35, 0.25, 0, 0] }; };
ens.configure(scores, ["explain", "bugs", "improve", "comment", "general"]);
ens.clear_voters();
ens.reset_stats();
ens.set_adaptive(false);
ens.set_parallel(false);
ens.set_fusion("hard");

// model M: improve on top (0.45) but explain is a strong runner-up (0.40)
ens.register_model("M", fn(p) { return map{ intent: "improve", scores: [0.4, 0.15, 0.45, 0, 0] }; });

// HARD voting: only the argmaxes compete -> improve (0.45) beats explain (0.40)
eq(ens.ensemble("q"), "improve", "hard voting follows the strongest single pick");

// SOFT fusion: distributions sum -> explain 0.8 beats improve 0.7
ens.set_fusion("soft");
ens.clear_native_cache();
eq(ens.ensemble("q"), "explain", "soft fusion lets strong runner-ups win");
let det = ens.ensemble_detail("q");
if det.tally["explain"] < 0.79 or det.tally["explain"] > 0.81 { fail("explain mass ~0.8 got=" + str(det.tally["explain"])); }
if det.tally["bugs"] < 0.49 or det.tally["bugs"] > 0.51 { fail("bugs mass ~0.5 got=" + str(det.tally["bugs"])); }

// label-only voters still work under soft fusion (one-hot * confidence fallback)
ens.register_voter_weighted("plain", fn(p) { return "comment"; }, 1);
let det2 = ens.ensemble_detail("q2");
eq(det2.tally["comment"], 1, "label-only voter contributes one-hot confidence");

// explain_decision: a human-readable trace of who voted what and why
let ex = ens.explain_decision("q3");
if not is_string(ex.intent) { fail("explanation carries the decision"); }
if len(ex.lines) < 3 { fail("explanation has per-model lines"); }
let joined = "";
let i = 0;
while i < len(ex.lines) { joined = joined + ex.lines[i] + "\n"; i = i + 1; }
if str_index_of(joined, "native") < 0 { fail("explanation mentions native"); }
if str_index_of(joined, "M") < 0 { fail("explanation mentions voter M"); }
if str_index_of(joined, "soft") < 0 { fail("explanation states the fusion mode"); }

ens.set_fusion("hard");
ens.clear_voters();
ens.reset_stats();
print "pbai_soft_fusion_pass";
