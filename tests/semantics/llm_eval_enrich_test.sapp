// tests/semantics/llm_eval_enrich_test.sapp — enrichment for stdlib/llm_eval.sapp
// Adds pure, model-free metrics: top_k_accuracy, exact_match, char_overlap_f1.

let ev = import("stdlib/llm_eval.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── ENRICH: top_k_accuracy ───────────────────────────────────────────────────────
near(ev.top_k_accuracy([[3, 1, 2]], [2], 1), 0, "target not in top-1");
near(ev.top_k_accuracy([[3, 1, 2]], [2], 2), 1, "target in top-2");
near(ev.top_k_accuracy([[0.1, 0.9, 0.2], [0.5, 0.1, 0.4]], [1, 0], 1), 1, "both argmax correct");

// ── ENRICH: exact_match ──────────────────────────────────────────────────────────
if not ev.exact_match("hello", "hello") { fail("exact_match identical"); }
if ev.exact_match("hello", "world") { fail("exact_match different"); }

// ── ENRICH: char_overlap_f1 ──────────────────────────────────────────────────────
near(ev.char_overlap_f1("abc", "abc"), 1, "identical f1 = 1");
near(ev.char_overlap_f1("abc", "abd"), 2 / 3, "two of three chars overlap");
near(ev.char_overlap_f1("", ""), 1, "both empty -> 1");

print "llm_eval_enrich_pass";
