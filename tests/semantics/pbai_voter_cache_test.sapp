// tests/semantics/pbai_voter_cache_test.sapp — voter response caching. Slow/expensive voters
// (LLMs) shouldn't be re-queried for a prompt already seen. memoize_voter(name, f) wraps a voter
// so repeat prompts are served from cache; failures (nil/abstain) are NOT cached (retryable).

let pbai = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

pbai.clear_voter_cache();

// ── cache hit avoids re-calling the underlying voter ────────────────────────────────────
let c1 = map{ n: 0 };
let base = fn(x) { c1.n = c1.n + 1; return "bugs"; };
let mv = pbai.memoize_voter("m", base);
eq(mv("p1"), "bugs", "first call returns result");
eq(c1.n, 1, "underlying voter called once");
eq(mv("p1"), "bugs", "repeat returns cached result");
eq(c1.n, 1, "repeat served from cache, no re-call");
eq(mv("p2"), "bugs", "different prompt is a miss");
eq(c1.n, 2, "new prompt re-calls the voter");

let st = pbai.voter_cache_stats();
eq(st.hits, 1, "one cache hit");
eq(st.misses, 2, "two cache misses");
eq(st.size, 2, "two distinct entries cached");

// ── abstain (nil) is NOT cached, so a transient failure can be retried ──────────────────
let c2 = map{ n: 0 };
let flaky = fn(x) { c2.n = c2.n + 1; return nil; };
let mf = pbai.memoize_voter("z", flaky);
eq(mf("q"), nil, "abstains");
eq(mf("q"), nil, "still abstains");
eq(c2.n, 2, "abstentions are not cached (voter retried)");

// ── clear empties the cache ─────────────────────────────────────────────────────────────
pbai.clear_voter_cache();
eq(pbai.voter_cache_stats().size, 0, "cache cleared");

print "pbai_voter_cache_pass";
