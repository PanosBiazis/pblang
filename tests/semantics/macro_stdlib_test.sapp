let M = import("stdlib:macro.sapp");

let reg = M.registry();
assert(len(M.macro_names(reg)) == 0, "empty registry");

let first = M.gensym(reg, "__tmp");
let second = M.gensym(reg, "__tmp");
assert(first != second, "gensym should be unique");
assert(str_starts_with(first, "__tmp_"), "gensym prefix");

let rendered = M.expand_template(
    "let {{ name }} = {{value}};",
    map{ name: "answer", value: "42" },
);
assert(rendered == "let answer = 42;", "template expansion");

let args = M.parse_args("x, add(1, 2), \"a,b\", map{k: [1, 2]}");
assert(len(args) == 4, "parse nested args");
assert(args[0] == "x", "arg 0");
assert(args[1] == "add(1, 2)", "arg 1");
assert(args[2] == "\"a,b\"", "arg 2");
assert(args[3] == "map{k: [1, 2]}", "arg 3");

M.define_template(
    reg,
    "getter",
    ["name", "field"],
    "fn {{name}}(obj) {\n  return obj.{{field}};\n}",
);
assert(M.has_macro(reg, "getter"), "registered macro");

let getter = M.expand_call(reg, "getter", ["get_x", "x"]);
assert(str_contains(getter, "fn get_x(obj)"), "expanded function name");
assert(str_contains(getter, "return obj.x;"), "expanded field access");

M.define_template(
    reg,
    "repeat",
    ["count", "body"],
    "let {{gensym}} = 0;\nwhile {{gensym}} < {{count}} {\n  {{body}}\n  {{gensym}} = {{gensym}} + 1;\n}",
);
let repeat = M.expand_call(reg, "repeat", ["3", "print \"tick\";"]);
assert(str_contains(repeat, "while __pb_macro_"), "generated loop variable");
assert(str_contains(repeat, "print \"tick\";"), "generated body");

let source = "@getter(get_y, y);\nlet p = map{y: 9};";
let expanded = M.expand_source(reg, source);
assert(str_contains(expanded, "fn get_y(obj)"), "source macro expands call line");
assert(str_contains(expanded, "let p = map{y: 9};"), "source macro keeps normal lines");

let analysis = M.analyze_generated(expanded);
assert(analysis.ok == true, "generated source should parse");

// Crystal-inspired custom compile-time expanders and record convenience.
M.install_record_macro(reg);
let record_source = M.expand_source(reg, "@record(person, name, age);\nlet p = person(\"Ada\", 36);\nprint p.name;");
assert(str_contains(record_source, "fn person(name, age)"), "record constructor generated");
assert(str_contains(record_source, "__type: \"person\""), "record carries stable type tag");
assert(M.analyze_generated(record_source).ok == true, "record-generated source parses");

M.define_expander(reg, "twice", 1, 1, fn(args, ctx) {
    return "print " + args[0] + ";\nprint " + args[0] + ";";
});
let custom = M.expand_call(reg, "twice", ["21"]);
assert(custom == "print 21;\nprint 21;", "custom expander receives source args");

M.define_template(reg, "outer", ["value"], "@twice({{value}});");
let recursive = M.expand_source_bounded(reg, "@outer(7);", map{ max_passes: 4, max_output_bytes: 4096 });
assert(recursive.stable and recursive.expansions == 2 and recursive.source == "print 7;\nprint 7;",
    "bounded recursive macro composition reaches a stable result");

let invalid_record = try M.expand_call(reg, "record", ["bad-name", "x"]) catch nil;
assert(type(invalid_record) != "string", "record generation rejects invalid identifiers");

print "macro_stdlib_pass";
