let VISION = import("stdlib:vision_ledger.sapp");

fn fail(message) { throw "FAIL vision_ledger: " + message; }
fn eq(actual, expected, message) {
    if actual != expected { fail(message + " got=" + str(actual) + " want=" + str(expected)); }
}

let report = VISION.summary();
eq(report.format, "pblang.vision.ledger.v1", "stable format");
eq(report.total, 17, "all ordered requirements remain represented");
eq(report.current.id, "selfhost-parity", "next active work item is explicit");
eq(report.blocked, 0, "ledger has no invented blocker");
if len(VISION.lines()) < 36 { fail("human report must include evidence and exit criteria"); }

let all = VISION.items(); let i = 0;
while i < len(all) {
    eq(all[i].order, i + 1, "orders are contiguous");
    if len(all[i].evidence) == 0 or len(all[i].exit_criterion) == 0 { fail("empty evidence/exit criterion"); }
    i = i + 1;
}

print "vision_ledger_pass";
