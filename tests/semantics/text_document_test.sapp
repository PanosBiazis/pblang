let Doc=import("stdlib:text_document.sapp");
fn rejects(f) { let bad=false; try { f(); } catch { bad=true; } assert(bad,"invalid document rejected"); }
let original=Doc.create("Ελληνικά");
let doc=Doc.set_block(original,0,"heading","Question?");
doc=Doc.insert_block(doc,1,"paragraph","Μια απάντηση.\nSecond line.");
doc=Doc.insert_block(doc,2,"bullet","one one");
assert(original.blocks[0].text=="","document operations are detached");
assert(Doc.encode(Doc.decode(Doc.encode(doc)))==Doc.encode(doc),"serialization preserves Unicode and kinds");
assert(Doc.find(doc,"one")==[2],"search returns matching block indices");
let replacement=Doc.replace_all(doc,"one","one one");
assert(replacement.replacements==2 and replacement.document.blocks[2].text=="one one one one",
    "replacement never rescans inserted text");
assert(doc.blocks[2].text=="one one","replacement retains source");
assert(Doc.remove_block(doc,1).blocks[1].kind=="bullet","remove preserves order");
let stats=Doc.statistics(doc); assert(stats.body_words==7,"ASCII-whitespace token word count");
assert(Doc.to_text(Doc.from_text("a\r\nb\n"))=="a\nb\n","plain text normalizes CRLF and retains final empty block");
assert(Doc.set_block(original,0,"paragraph",str_repeat("é",512)).blocks[0].text==str_repeat("é",512),"UTF-8 boundary");
rejects(fn(){Doc.set_block(original,0,"paragraph",str_repeat("é",513));});
rejects(fn(){Doc.replace_all(doc,"","");});
rejects(fn(){Doc.replace_all(Doc.set_block(original,0,"paragraph",str_repeat("a",1024)),"a","aa");});
rejects(fn(){Doc.remove_block(original,0);}); rejects(fn(){Doc.set_block(doc,0.5,"paragraph","x");});
rejects(fn(){Doc.set_block(doc,0,"script","x");}); rejects(fn(){Doc.from_text("\u0000");});
rejects(fn(){Doc.decode("{\"format\":\"pblang.text-document.v1\",\"title\":\"a\",\"title\":\"b\",\"blocks\":[]}");});
rejects(fn(){Doc.decode(Doc.encode(doc)+" garbage");});
let full=Doc.create(); for i in range(1,64) { full=Doc.insert_block(full,i); }
rejects(fn(){Doc.insert_block(full,64);});
let copy=Doc.copy(doc); copy.blocks[0].text="changed"; assert(doc.blocks[0].text=="Question?","no alias");
print "text_document_pass";
