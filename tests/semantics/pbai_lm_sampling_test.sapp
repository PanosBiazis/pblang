// tests/semantics/pbai_lm_sampling_test.sapp — temperature + top-k sampling for the
// pbAI char-LM. The probability primitives are pure (no training needed); generation is
// checked on a fresh (untrained) model purely for determinism + greedy-equivalence.

let LM = import("stdlib/pbai_lm.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn sumv(v) { let s = 0; let i = 0; while i < len(v) { s = s + v[i]; i = i + 1; } return s; }
fn argmaxv(v) { let bi = 0; let i = 1; while i < len(v) { if v[i] > v[bi] { bi = i; } i = i + 1; } return bi; }

// ── softmax_temp: valid distribution; low temp sharpens toward the argmax ──────────
let p = LM.softmax_temp([1, 2, 3], 1);
approx(sumv(p), 1, "softmax sums to 1");
eq(argmaxv(p), 2, "softmax keeps the argmax");
let sharp = LM.softmax_temp([1, 2, 3], 0.01);
if sharp[2] < 0.99 { fail("low temperature -> near one-hot at argmax: " + str(sharp)); }

// ── top_k_filter: keep top-k, zero the rest, renormalize ──────────────────────────
let f1 = LM.top_k_filter([0.1, 0.2, 0.7], 1);
eq(f1[0], 0, "top1 zeros others"); eq(f1[1], 0, "top1 zeros others");
approx(f1[2], 1, "top1 keeps max -> 1");
let f2 = LM.top_k_filter([0.1, 0.2, 0.7], 2);
eq(f2[0], 0, "top2 drops the smallest");
approx(sumv(f2), 1, "top2 renormalizes to 1");

// ── sample_from: cumulative inverse-CDF pick ──────────────────────────────────────
eq(LM.sample_from([0, 0, 1], 0.5), 2, "sample picks the only mass");
eq(LM.sample_from([0.5, 0.5], 0.4), 0, "sample lower half");
eq(LM.sample_from([0.5, 0.5], 0.6), 1, "sample upper half");

// ── generation on a fresh model: top_k=1 == greedy; same seed == reproducible ──────
let vocab = LM.vocab_build("hello world pblang sampling");
let m = LM.model_new(LM.vocab_size(vocab), 6, 8, 2, 7);
let greedy = LM.generate(m, vocab, "he", 6);
let s_greedy = LM.generate_sampled(m, vocab, "he", 6, 1.0, 1, 999);
eq(s_greedy, greedy, "top_k=1 sampling equals greedy generation");
let s1 = LM.generate_sampled(m, vocab, "he", 6, 0.9, 3, 123);
let s2 = LM.generate_sampled(m, vocab, "he", 6, 0.9, 3, 123);
eq(s1, s2, "same seed -> reproducible");
eq(len(s1), len("he") + 6, "generated length");

print "pbai_lm_sampling_pass";
