// tests/semantics/accelerator_test.sapp — detect CPU/GPU/NPU(AI accelerator incl. Intel GNA),
// report present-vs-usable honestly, route to the best usable device with CPU fallback, and
// plug a native (FFI) runtime in via a hook. Deterministic regardless of the host's hardware.

let A = import("stdlib/accelerator.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : <<" + s + ">>"); } }

A.clear_runtimes();

// ── detection enumerates cpu / gpu / npu, each with present + usable flags ───────────
let devs = A.detect();
let kinds = "";
let i = 0; let cpu_ok = false;
while i < len(devs) {
    kinds = kinds + devs[i].kind + " ";
    if devs[i].kind == "cpu" { if devs[i].present and devs[i].usable { cpu_ok = true; } }
    i = i + 1;
}
if not cpu_ok { fail("cpu present+usable"); }
has(kinds, "gpu", "enumerates gpu"); has(kinds, "npu", "enumerates npu/AI-accelerator");

// ── routing: with no native runtime, the best USABLE device is the CPU ───────────────
eq(A.best(), "cpu", "default best is cpu (gpu not enabled, npu no runtime)");
eq(A.usable("cpu"), true, "cpu always usable");

// ── plug a native NPU runtime (the FFI/vendor-stack hook) -> it becomes usable+best ──
A.register_runtime("npu", fn(payload) { return "ran-on-npu"; });
eq(A.usable("npu"), true, "npu usable once a runtime is registered");
eq(A.best(), "npu", "best routes to the npu when a runtime exists");
eq(A.run("npu", "x"), "ran-on-npu", "run dispatches to the registered runtime");
A.clear_runtimes();
eq(A.best(), "cpu", "back to cpu after clearing the runtime");
eq(A.run("npu", "x"), nil, "run returns nil when no runtime (caller falls back)");

// ── summary string for diagnostics ──────────────────────────────────────────────────
has(A.summary(), "cpu", "summary mentions cpu");

print "accelerator_pass";
