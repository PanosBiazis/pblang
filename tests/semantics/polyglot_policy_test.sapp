// tests/semantics/polyglot_policy_test.sapp — stdlib/polyglot_policy.sapp
//
// Execution MODES for the polyglot boundary, layered on polyglot_guard:
//   secure       — scan; run ONLY if safe, else block (the default, malicious-code-proof)
//   sandbox      — scan; run everything, but through a caller-supplied isolated runner
//   audit        — run everything, attach the findings (run-but-record)
//   unrestricted — run everything with NO scan (fast + dangerous; safe AND unsafe)
//   report       — never run; return the scan only (dry-run analysis of any code)
// The module NEVER executes anything itself — it delegates to runners you pass in, so the
// dangerous modes stay explicit and caller-controlled.

let X = import("stdlib/polyglot_policy.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }
fn falsy(c, m) { if c != false { fail(m); } }

let SAFE = "import moderngl\nprint('ok')\n";
let EVIL = "import os\nos.system('rm -rf /')\n";
fn runner(lang, code) { return "RAN:" + lang; }
fn sandbox_runner(lang, code) { return "SANDBOXED:" + lang; }

eq(len(X.modes()), 5, "five execution modes");

// ── secure: runs safe code, BLOCKS malicious code ───────────────────────────────────
let s1 = X.execute(X.new("secure", runner), "python", SAFE);
truthy(s1.ran, "secure runs safe code"); falsy(s1.blocked, "safe not blocked");
eq(s1.result, "RAN:python", "secure returns the runner result");
let s2 = X.execute(X.new("secure", runner), "python", EVIL);
falsy(s2.ran, "secure does NOT run malicious code");
truthy(s2.blocked, "malicious code blocked");
falsy(s2.safe, "flagged unsafe");
truthy(len(s2.findings) >= 1, "findings explain the block");
eq(s2.result, nil, "no result when blocked");

// ── unrestricted: runs EVERYTHING, safe and unsafe, no scan ─────────────────────────
let u = X.execute(X.new("unrestricted", runner), "python", EVIL);
truthy(u.ran, "unrestricted runs even malicious code"); falsy(u.blocked, "never blocks");
eq(u.result, "RAN:python", "unrestricted returns result");

// ── audit: runs everything but records the risk ─────────────────────────────────────
let a = X.execute(X.new("audit", runner), "python", EVIL);
truthy(a.ran, "audit runs"); falsy(a.safe, "audit records it was unsafe");
truthy(len(a.findings) >= 1, "audit keeps the findings");

// ── sandbox: runs everything through the isolated runner ────────────────────────────
let sb = X.execute(X.with_sandbox(X.new("sandbox", runner), sandbox_runner), "python", EVIL);
truthy(sb.ran, "sandbox runs"); truthy(sb.sandboxed, "flagged sandboxed");
eq(sb.result, "SANDBOXED:python", "used the sandbox runner, not the raw one");
let noSbx = (try X.execute(X.new("sandbox", runner), "python", SAFE) catch "NOSANDBOX");
eq(noSbx, "NOSANDBOX", "sandbox mode requires an isolated runner");

// ── report: analyzes without running ────────────────────────────────────────────────
let r = X.execute(X.new("report", runner), "python", EVIL);
falsy(r.ran, "report never runs"); falsy(r.blocked, "report is analysis, not a block");
truthy(len(r.findings) >= 1, "report returns findings");

// convenience one-shots + validation
truthy(X.secure(runner, "python", SAFE).ran, "secure() helper");
truthy(X.unrestricted(runner, "python", EVIL).ran, "unrestricted() helper");
let badmode = (try X.execute(X.new("bogus", runner), "python", SAFE) catch "BADMODE");
eq(badmode, "BADMODE", "unknown mode rejected");

print "polyglot_policy_pass";
