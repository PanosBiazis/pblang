// tests/semantics/compute_test.sapp — heterogeneous compute scheduler: detect every
// device (CPU cores / GPU / NPU / RAM / storage), plan work across them, run the CPU
// share truly multi-core, chunk for RAM, and parallelize storage I/O.

let CP = import("stdlib/compute.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── device detection ──────────────────────────────────────────────────────────────
if CP.cpu_cores() < 1 { fail("at least one CPU core"); }
let devs = CP.devices();
let kinds = "";
let i = 0;
let cpu_ok = false;
while i < len(devs) {
    kinds = kinds + devs[i].kind + " ";
    if devs[i].kind == "cpu" and devs[i].available and devs[i].units >= 1 { cpu_ok = true; }
    i = i + 1;
}
if not cpu_ok { fail("cpu device detected"); }
// every named resource is enumerated (cpu/gpu/npu/ram/storage)
if str_index_of(kinds, "gpu") < 0 { fail("gpu enumerated: " + kinds); }
if str_index_of(kinds, "npu") < 0 { fail("npu enumerated"); }
if str_index_of(kinds, "ram") < 0 { fail("ram enumerated"); }
if str_index_of(kinds, "storage") < 0 { fail("storage enumerated"); }

// ── plan: distribute N tasks across available compute devices (sums to N) ──────────
let p = CP.plan(8, devs);
let total = 0;
let j = 0;
while j < len(p) { total = total + p[j].count; j = j + 1; }
eq(total, 8, "plan distributes all tasks");

// ── run: real multi-core execution (worker is self-contained) ─────────────────────
let r = CP.run([1, 2, 3, 4], fn(x) { return x * x; });
eq(r[0], 1, "run r0"); eq(r[1], 4, "run r1"); eq(r[3], 16, "run r3");

// ── RAM-budgeted chunking ─────────────────────────────────────────────────────────
let chunks = CP.chunk([1, 2, 3, 4, 5], 2);
eq(len(chunks), 3, "chunk into ceil(5/2)=3");
eq(len(chunks[0]), 2, "first chunk size"); eq(len(chunks[2]), 1, "last chunk remainder");

// ── storage parallelism: read files concurrently ──────────────────────────────────
let contents = CP.storage_read_parallel(["stdlib/nn_graph_comm.sapp", "stdlib/compute.sapp"]);
eq(len(contents), 2, "read two files in parallel");
if str_index_of(contents[0], "transmit") < 0 { fail("file content read in parallel"); }

// ── native execution mode: the scheduler can run an integer kernel as real machine code ──
if CP.native_available() {
    eq(CP.native_run([["seti", 0, 0], ["seti", 1, 9], ["loop", 1, [["add", 0, 1]]]]), 45, "compute.native_run sum 1..9");
}

print "compute_pass";
