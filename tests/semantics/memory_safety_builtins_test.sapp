// Runtime memory safety builtins: allocate, borrow, load/store, lifetimes

// allocate + load + store
let h = allocate(42, true);
if load(h) != 42 { throw "FAIL allocate/load"; }
store(h, 99);
if load(h) != 99 { throw "FAIL store"; }

// immutable allocation cannot be stored
let imm = allocate("hello", false);
let imm_err = try store(imm, "world") catch "immutable_ok";
if imm_err != "immutable_ok" { throw "FAIL immutable store guard"; }

// multiple immutable borrows allowed
let b1 = borrow_immutable(h);
let b2 = borrow_immutable(h);
if load(h) != 99 { throw "FAIL load with imm borrows"; }
release_borrow(b1);
release_borrow(b2);

// mutable borrow is exclusive
let mb = borrow_mutable(h);
let conflict = try borrow_mutable(h) catch "conflict_ok";
if conflict != "conflict_ok" { throw "FAIL double mutable borrow"; }
release_borrow(mb);
store(h, 100);
if load(h) != 100 { throw "FAIL after mutable release"; }

// store blocked while immutable borrow active
let ib = borrow_immutable(h);
let store_err = try store(h, 1) catch "store_blocked";
if store_err != "store_blocked" { throw "FAIL store during borrow"; }
release_borrow(ib);

// unique borrow (move) prevents further load
let uh = allocate(7, true);
let ub = borrow_unique(uh);
let moved = try load(uh) catch "use_after_move";
if moved != "use_after_move" { throw "FAIL use-after-move"; }
release_borrow(ub);

// lifetime scope expiry
push_lifetime();
let inner = allocate(55, true);
pop_lifetime();
let expired = try load(inner) catch "lifetime_expired";
if expired != "lifetime_expired" { throw "FAIL lifetime pop"; }

// deallocate while borrowed
let dh = allocate(1, true);
let db = borrow_immutable(dh);
let dealloc_err = try deallocate(dh) catch "dealloc_blocked";
if dealloc_err != "dealloc_blocked" { throw "FAIL deallocate while borrowed"; }
release_borrow(db);
deallocate(dh);

// memory_stats smoke
let stats = memory_stats();
if type(stats) != "map" { throw "FAIL stats type"; }
if stats.total_locations < 1 { throw "FAIL stats locations"; }

print "memory_safety_builtins_pass";
