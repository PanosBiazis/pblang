// tests/semantics/bitmap_font_enrich_test.sapp — enrichment for stdlib/bitmap_font.sapp
// Adds text measurement: text_width, text_height, measure_text.

let f = import("stdlib/bitmap_font.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base char metrics still work ─────────────────────────────────────────────────
eq(f.char_width(), 6, "char_width"); eq(f.char_height(), 8, "char_height");

// ── ENRICH: text measurement ─────────────────────────────────────────────────────
eq(f.text_width("abc"), 18, "text_width 3*6");
eq(f.text_width(""), 0, "empty width");
eq(f.text_height(), 8, "text_height");
let m = f.measure_text("hello");
eq(m.width, 30, "measure width"); eq(m.height, 8, "measure height");

print "bitmap_font_enrich_pass";
