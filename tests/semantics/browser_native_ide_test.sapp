// Test: pblang-native browser reader parser used by editors/ide/pbide.sapp.
// Locks the screenshot fixes: HTML entities decode, adjacent links are separated,
// relative links resolve, and forms are extracted for the native Browser panel.

let B = import("stdlib/browser.sapp");

assert(B.url_policy("https://example.com").ok, "https URL is allowed by browser policy");
assert(B.url_policy("http://example.com/path").ok, "http URL is allowed by browser policy");
assert(not B.url_policy("file:///etc/passwd").ok, "file URL is blocked by browser policy");
assert(not B.url_policy("javascript:alert(1)").ok, "javascript URL is blocked by browser policy");
assert(not B.url_policy("data:text/html,hi").ok, "data URL is blocked by browser policy");
assert(not B.url_policy("https://user:pass@example.com").ok, "credential URLs are blocked");
assert(not B.url_policy("https://example.com/%0d%0aX:bad").ok, "CRLF-encoded URLs are blocked");
assert(not B.url_policy("http://example.com:22").ok, "non-web service ports are blocked");
assert(not B.url_policy("https://www.google-analytics.com/collect").ok, "tracker URLs are blocked");
assert(not B.url_policy("https://ads.example.com/ads/banner.js").ok, "ad URLs are blocked");
assert(not B.url_policy("https://example.com/malware/payload.js").ok, "malicious-looking URLs are blocked");
assert(not B.url_policy("http://127.0.0.1:8080").ok, "loopback is blocked by default");
assert(not B.url_policy("http://192.168.1.1").ok, "private LAN is blocked by default");
assert(B.url_policy("http://127.0.0.1:8080", true).ok, "private hosts can be explicit opt-in");
assert(B.security_profile("safe").forms == false, "safe browser profile disables form submits");
assert(B.security_profile("live").forms == true, "live browser profile enables interactive forms");
assert(B.security_profile("trusted").allow_private == true, "trusted browser profile opts into private/local hosts");
assert(B.security_profile("tor").tor == true and B.security_profile("tor").forms == false, "tor browser profile routes through Tor and disables form submits");
assert(str_contains(B.security_summary("safe"), "forms:off") and str_contains(B.security_summary("safe"), "ads:blocked"), "safe security summary shows blocked interaction/protection");
assert(str_contains(B.security_summary("live"), "forms:on") and str_contains(B.security_summary("live"), "private:off"), "live security summary shows interactive but non-private browsing");
assert(str_contains(B.security_summary("trusted"), "private:on") and str_contains(B.security_summary("trusted"), "js/dom:off"), "trusted security summary keeps pblang no-DOM/no-JS boundary visible");
assert(str_contains(B.security_summary("tor"), "tor:on") and str_contains(B.security_summary("tor"), "forms:off"), "tor security summary shows tor route and no form submits");
assert(B.url_policy_mode("http://127.0.0.1:8080", "safe").ok == false, "safe mode blocks private hosts");
assert(B.url_policy_mode("http://127.0.0.1:8080", "trusted").ok == true, "trusted mode allows private hosts");
assert(B.next_security_mode("safe") == "live" and B.next_security_mode("live") == "trusted", "security modes cycle toward interaction intentionally");

let html = "<html><head><title>&#917;&#953;&#954;&#972;&#957;&#949;&#962; &amp; Links</title><style>.x{}</style><script>bad()</script></head><body><h1>Main headline</h1><h2>Section title</h2><a href='/mail?x=1&amp;y=2'>Google</a><a href=\"/intl/el/about\">About</a><p>Hello&nbsp;world &mdash; ok</p><img src='/hero.png' alt='Hero image'><form action='/search' method='GET'><input name='q' value='pblang'><textarea name='notes'></textarea></form></body></html>";

let text = B.strip_tags(html);
assert(str_contains(text, "Google About"), "reader inserts spaces between adjacent anchors");
assert(str_contains(text, "Hello world"), "reader decodes nbsp and collapses whitespace");
assert(not str_contains(text, "bad()"), "reader removes script blocks");
assert(not str_contains(text, ".x"), "reader removes style blocks");

let page = B.fetch_page_from_html("https://example.com/root/page.html", html);
assert(page.title == "Εικόνες & Links", "numeric entities and ampersand decode in title");
assert(len(page.links) == 2, "two links extracted");
assert(page.links[0] == "https://example.com/mail?x=1&y=2", "root-relative link resolves and decodes ampersand");
assert(page.links[1] == "https://example.com/intl/el/about", "double-quoted href resolves");
assert(len(page.images) == 1, "image extracted");
assert(page.images[0].src == "https://example.com/hero.png", "image src resolves");
assert(page.images[0].alt == "Hero image", "image alt extracts");
assert(len(page.forms) == 1, "form extracted");
assert(page.forms[0].action == "https://example.com/search", "form action resolves");
assert(page.forms[0].method == "get", "form method lowercases");
assert(len(page.forms[0].fields) == 2, "input and textarea fields extracted");
let form_vals = B.form_values(page.forms[0]);
assert(form_vals.q == "pblang" and form_vals.notes == "", "form_values extracts default field values");
let form_vals2 = B.form_update_value(form_vals, "q", "native ide");
assert(form_vals.q == "pblang" and form_vals2.q == "native ide", "form_update_value returns an updated copy");
let preview = B.form_preview_url(page.forms[0], form_vals2);
assert(str_contains(preview, "https://example.com/search?") and str_contains(preview, "q=native+ide"), "form_preview_url builds GET submit URL");
let safe_submit = B.form_submit_mode(page.forms[0], form_vals2, "safe");
assert(safe_submit.ok == false and str_contains(safe_submit.error, "blocked"), "safe profile blocks form submit");

let controls = B.fetch_page_from_html("https://example.com", "<form action='/prefs'><input type='checkbox' name='tos' value='yes' checked><input type='checkbox' name='ads' value='yes'><input type='radio' name='mode' value='basic'><select name='color'><option value='red'>Red</option><option value='blue' selected>Blue</option></select></form>");
assert(len(controls.forms[0].fields) == 4, "checkbox/radio/select fields are extracted");
let cvals = B.form_values(controls.forms[0]);
assert(cvals.tos == "yes" and cvals.ads == "" and cvals.mode == "" and cvals.color == "blue", "form_values preserves checkbox/select defaults");
let payload = B.form_payload_values(controls.forms[0], cvals);
assert(payload.tos == "yes" and not map_has(payload, "ads") and not map_has(payload, "mode") and payload.color == "blue", "form_payload_values omits unchecked checkbox/radio controls");
let cvals2 = B.form_cycle_value(controls.forms[0], cvals, "ads", 1);
assert(cvals2.ads == "yes", "form_cycle_value toggles checkbox on");
let cvals3 = B.form_cycle_value(controls.forms[0], cvals2, "ads", 1);
assert(cvals3.ads == "", "form_cycle_value toggles checkbox off");
let cvals4 = B.form_cycle_value(controls.forms[0], cvals, "color", 1);
assert(cvals4.color == "red", "form_cycle_value cycles select choices");

let enc = B.urlencode(map{ q: "α β", page: "1" });
assert(str_contains(enc, "%CE%B1+%CE%B2"), "urlencode UTF-8 encodes Greek form text");

let blocks = B.page_blocks(page);
assert(len(blocks) >= 5, "page_blocks extracts visible structure");
assert(blocks[0].kind == "title", "page_blocks starts with title");
assert(blocks[1].kind == "h1" and blocks[1].text == "Main headline", "page_blocks extracts h1");
assert(blocks[2].kind == "h2" and blocks[2].text == "Section title", "page_blocks extracts h2");
let has_img = false;
let has_link_block = false;
for b in blocks {
    if b.kind == "img" and b.src == "https://example.com/hero.png" { has_img = true; }
    if b.kind == "link" { has_link_block = true; }
}
assert(has_img, "page_blocks includes image block");
assert(not has_link_block, "page_blocks leaves raw URLs for Links mode, not Page mode");

let src_lines = B.source_lines(page, 80, 20);
let src_has_number = false;
let src_has_html = false;
for ln in src_lines {
    if str_contains(ln, "1 |") { src_has_number = true; }
    if str_contains(ln, "<html>") { src_has_html = true; }
}
assert(src_has_number and src_has_html, "source_lines exposes numbered webpage source");

let inspect = B.inspector_lines(page, 90);
let has_devtools = false;
let has_counts = false;
let has_form_detail = false;
for ln in inspect {
    if str_contains(ln, "pblang DevTools") { has_devtools = true; }
    if str_contains(ln, "Links: 2") and str_contains(ln, "Images: 1") and str_contains(ln, "Forms: 1") { has_counts = true; }
    if str_contains(ln, "GET https://example.com/search") { has_form_detail = true; }
}
assert(has_devtools and has_counts and has_form_detail, "inspector_lines exposes F12-style details");

let noisy = B.fetch_page_from_html("https://example.com", "<html><head><title>Clean</title></head><body><h1>Clean heading</h1><p>Privacy Policy cookies newsletter facebook linkedin</p><p>AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA</p><p>Useful readable paragraph.</p><a href='/raw'>raw link</a></body></html>");
let nb = B.page_blocks(noisy);
let has_useful = false;
let has_noise = false;
for b in nb {
    if b.text == "Useful readable paragraph." { has_useful = true; }
    if str_contains(b.text, "AAAAAAAA") or str_contains(str_lower(b.text), "privacy policy") { has_noise = true; }
}
assert(has_useful, "page_blocks keeps useful reader content");
assert(not has_noise, "page_blocks filters noisy/corrupt page text");

print "browser_native_ide_pass";
