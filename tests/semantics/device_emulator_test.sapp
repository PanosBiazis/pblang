let D = import("stdlib:device_emulator.sapp");
let E = import("stdlib:input_events.sapp");
let P = import("stdlib:platform_emulator.sapp");

let phone = D.resolve("smartphone", "android", "34", "arm64");
assert(phone.ok and phone.input and phone.platform.mobile, "Android smartphone contract");
let desktop = D.resolve("desktop", "windows", "11", "x86_64");
assert(desktop.ok and desktop.width == 1920, "Windows desktop contract");
let mcu = D.resolve("microcontroller", "freertos", "11", "avr", map{ memory_bytes: 32768 });
assert(mcu.ok and mcu.platform.realtime and mcu.isa.verified, "FreeRTOS AVR microcontroller contract");
let satellite = D.resolve("satellite", "vxworks", "7", "sparc-v8");
assert(satellite.ok and satellite.isa.verified, "VxWorks SPARC satellite contract");
let calculator = D.resolve("calculator", "cpm", "2.2", "z80");
assert(calculator.ok and calculator.isa.verified, "CP/M Z80 calculator contract");
let browser = D.resolve("browser", "wasi", "1", "wasm32");
assert(browser.ok and browser.platform.sandboxed, "WASI browser contract");
assert(not D.resolve("smartphone", "dos", "6.22", "x86").ok, "impossible phone/OS pairing rejected");
assert(not D.resolve("unknown-device", "linux", "6", "x86_64").ok, "unknown device rejected");

let dm = D.machine(phone, map{ max_input_events: 8, max_signal_updates: 4 });
assert(D.input_apply(dm, E.pointer_event(100, 200).event).ok, "device absolute input");
assert(D.input_apply(dm, E.pointer_delta_event(5, -10).event).ok, "device relative input");
assert(D.input_apply(dm, E.type_event("hello").event).ok, "device text input");
assert(D.stats(dm).input.x == 105 and D.stats(dm).input.y == 190, "device input state");
assert(D.signal_write(dm, "accelerometer-x", 0.25).ok, "sensor signal write");
assert(D.signal_read(dm, "accelerometer-x").value == 0.25, "sensor signal read");
assert(D.signal_write(dm, "screen-on", true).ok and D.signal_read(dm, "screen-on").value == true,
       "boolean device signal uses the canonical bool runtime type");
assert(D.tick(dm, 10) == 10, "deterministic device clock");
assert(D.signal_write(dm, "accelerometer-x", 0.5).ok, "sensor update");
assert(D.signal_read(dm, "accelerometer-x").updated_ms == 10, "sensor timestamp");
assert(not D.signal_write(dm, "oversized", str_repeat("x", 4097)).ok, "oversized signal rejected");
assert(not D.signal_write(dm, "bad\x00name", 1).ok, "NUL signal name rejected");
assert(not D.signal_write(dm, "nonfinite", parse_number("Infinity")).ok, "non-finite signal rejected");

let quota_profile = D.resolve("sensor", "freertos", "11", "avr", map{ max_signals: 2 });
let quota_machine = D.machine(quota_profile);
assert(D.signal_write(quota_machine, "a", 1).ok and D.signal_write(quota_machine, "b", 2).ok, "signal quota exact fit");
assert(not D.signal_write(quota_machine, "c", 3).ok, "signal channel quota enforced");

assert(not D.input_apply(D.machine(mcu), E.key_event("Enter").event).ok, "headless MCU input fails closed");

let custom_platform = P.custom_profile(map{ os: "research-os", version: "0.1", arch: "rv64", abi: "cap",
    executable_format: "elf", syscall_model: "capability" });
let custom = D.custom_profile(map{ kind: "protein-controller", sensors: ["optical"], accelerators: ["cpu"], memory_bytes: 1024 }, custom_platform);
assert(custom.ok and str_contains(custom.boundary, "unverified"), "future custom substrate remains explicit and unverified");

print "device_emulator_pass";
