// tests/semantics/codegen_ir_test.sapp — the retargetable layer: ONE IR, many backends.
// eval (portable, runs anywhere pblang runs), a constant-folding optimizer, a portable C
// emitter (reaches the OLDEST and future classical devices via any C compiler), and a target
// registry. The native x86-64 backend lives in codegen_x64; quantum (QASM) in codegen_qasm.

let IR = import("stdlib/codegen_ir.sapp");
let X = import("stdlib/codegen_x64.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : <<" + s + ">>"); } }

let arith = [
    ["seti", 0, 2], ["seti", 1, 3], ["add", 0, 1],
    ["seti", 1, 4], ["mul", 0, 1],
    ["seti", 1, 1], ["sub", 0, 1]
];
let loopsum = [
    ["seti", 0, 0], ["seti", 1, 10],
    ["loop", 1, [["add", 0, 1]]]
];

// ── portable evaluator (reference / runs on every device) ───────────────────────────
eq(IR.eval(arith), 19, "eval arithmetic");
eq(IR.eval(loopsum), 55, "eval loop sum 1..10");
eq(IR.eval([["seti", 0, 7], ["seti", 1, 0], ["loop", 1, [["addi", 0, 5]]]]), 7, "eval loop-zero skips body");

// ── optimizer: loop-free programs fold to a single constant (compile-time eval) ──────
let opt = IR.optimize(arith);
eq(len(opt), 1, "loop-free program folds to one instruction");
eq(opt[0][0], "seti", "folded instruction is a seti");
eq(opt[0][2], 19, "folded constant equals the result");
eq(IR.eval(opt), 19, "optimized program evaluates identically");
// the optimized IR must still compile + run natively to the same value
eq(X.compile_program(opt)[0], 0x7F, "optimized IR still produces a valid ELF");
// programs with loops are preserved (can't be folded blindly)
eq(len(IR.optimize(loopsum)), 3, "loop program is preserved");
eq(IR.eval(IR.optimize(loopsum)), 55, "optimized loop program still correct");

// ── portable C backend (any C compiler = oldest..future classical devices) ──────────
let c = IR.emit_c(arith);
has(c, "int main", "C has a main");
has(c, "r0 = 2;", "C lowers seti");
has(c, "r0 *= r1;", "C lowers mul");
has(c, "return (int)(r0 & 0xff);", "C returns r0 as exit code");
has(IR.emit_c(loopsum), "while (r1)", "C lowers loop to while");

// ── target registry: honest about what's implemented vs roadmap ─────────────────────
let ts = IR.targets();
let names = "";
let i = 0;
while i < len(ts) { names = names + ts[i].name + " "; i = i + 1; }
has(names, "x86_64", "registry lists the native x86-64 target");
has(names, "c", "registry lists the portable C target");
has(names, "qasm", "registry lists the quantum target");

// ── safety: validation rejects malformed IR ─────────────────────────────────────────
let bad = try IR.eval([["seti", 5, 1]]) catch nil;
if bad != nil { fail("eval must reject out-of-range register"); }

print "codegen_ir_pass";
