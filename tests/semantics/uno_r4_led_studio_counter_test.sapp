let C=import("../../examples/uno_r4_led_studio/counter.sapp");let M=import("../../examples/uno_r4_led_studio/model.sapp");let X=import("../../examples/uno_r4_led_studio/exchange.sapp");let LED=import("stdlib:uno_r4_led_matrix.sapp");
let checks=0;fn check(value,label) {assert(value,label);checks=checks+1;}
fn denied(f) {return try {f();false;} catch true;}
fn config(start=0,end=9,interval=1000) {return map{kind:"counter",start:start,end:end,interval_ms:interval};}
let state=M.create();M.apply(state,"add");M.apply(state,"preset","border");let authored=M.export_document(state);let index=state.index;
M.apply(state,"counter_settings",config());let saved=M.export_project(state);
check(not state.playing and state.source=="frames" and M.export_document(state)==authored and state.index==index,"settings preserve authored document and selection");
M.apply(state,"counter_start",config(),10000);
for item in [map{time:10000,value:0,running:true},map{time:10999,value:0,running:true},map{time:11000,value:1,running:true},map{time:13900,value:3,running:true},map{time:19999,value:9,running:true},map{time:20000,value:9,running:false}] {
    M.tick(state,item.time);check(state.counter_value==item.value and state.playing==item.running,"counter derives current value from elapsed time including skipped ticks");
    check(M.export_document(state)==authored and M.export_project(state)==saved and state.index==index,"ticks never append frames or alter exported settings/document");
}
check(state.source=="frames" and M.current(state)==LED.preset("border"),"completion returns authored frame editor");
M.apply(state,"counter_start",config(12,9),30000);M.tick(state,32000);
check(state.counter_value==10 and M.preview(state)==C.frame(10),"descending counter uses current elapsed value");M.apply(state,"stop",nil,32999);
check(not state.playing and state.source=="frames" and state.counter_value==10 and M.export_document(state)==authored,"Stop freezes last sample and returns authored frame");
M.apply(state,"counter_capture");check(state.document.frames[1].pixels==C.frame(10) and state.document.frames[0].pixels==LED.preset("heart") and state.document.frames[1].duration_ms==250,"capture explicitly changes current pixels only");
M.apply(state,"play",2,40000);check(state.source=="frames" and state.repeat_count==2 and state.generator.start==12,"sequence preview independent of saved generator");M.apply(state,"counter_start",config(5,5,10000),41000);
check(state.playing and state.source=="counter" and state.counter_value==5,"counter can replace sequence preview without replacing frames");
M.apply(state,"counter_start",config(),50000);let snapshot=json_stringify(state);
let invalid=[nil,map{},map{kind:"sensor",start:0,end:9,interval_ms:1000},config(-1),config(0,100),config(0,30),config(0,9,999),config(0,9,1500),config(0,9,10001),config(0,9,7000),config(0,0,0),config(true,9)];
let extra=config();extra.url="https://invalid.example";push(invalid,extra);
for value in invalid {check(denied(fn(){M.apply(state,"counter_start",value,52000);}) and json_stringify(state)==snapshot,"invalid settings cannot replace running preview or advance clocks");}
check(denied(fn(){M.apply(state,"counter_start",config(),9007199254740991);}) and json_stringify(state)==snapshot,"unsafe clock rejected atomically");
M.tick(state,49999);check(not state.playing and state.source=="frames" and M.export_document(state)!= "","backward clock safely stops local generator");
let project=M.export_project(state);let imported=M.create();M.apply(imported,"import",project);
check(not imported.playing and imported.source=="frames" and imported.counter_value==0 and imported.generator==config() and M.export_project(imported)==project,"project roundtrip restores config without restoring running timer");
let legacy=M.export_document(imported);M.apply(imported,"import",legacy);check(imported.generator==nil and imported.counter_value==nil and M.export_document(imported)==legacy,"legacy import remains byte compatible and clears absent generator");
check(denied(fn(){X.decode(project);}),"legacy decoder cannot silently discard project generator");
let bad=json_parse(project);bad.generator.interval_ms=1500;snapshot=json_stringify(state);
check(denied(fn(){M.apply(state,"import",json_stringify(bad));}) and json_stringify(state)==snapshot,"invalid project generator leaves all state unchanged");
bad=json_parse(project);bad.arduino_frames[0][0]=0;
check(denied(fn(){M.apply(state,"import",json_stringify(bad));}) and json_stringify(state)==snapshot,"project still checks exact Arduino words");
let duplicate=str_join(str_split(project,"\"generator\":"),"\"generator\":null,\"generator\":");check(denied(fn(){M.apply(state,"import",duplicate);}) and json_stringify(state)==snapshot,"duplicate project fields rejected");
M.apply(state,"counter_clear");check(state.generator==nil and not state.playing and state.source=="frames","clear generator explicit and bounded");snapshot=json_stringify(state);check(denied(fn(){M.apply(state,"counter_capture");}) and json_stringify(state)==snapshot,"capture without source rejected");
check(C.sample(config(0,29,2000),60000).finished and C.duration(config(0,29,2000))==60000,"maximum30 samples and60 seconds admitted");
check(C.label(0)=="00" and C.label(99)=="99" and not str_contains(C.svg(8),"<set "),"counter values fit2glyphs and render as current static sample, not sequence animation");
print "uno_r4_led_studio_counter_pass checks="+str(checks);
