// tests/semantics/serialization_xml_test.sapp
// xml_escape/xml_unescape must work and round-trip. Regression: xml_unescape called the
// non-existent bare `str_replace` builtin (real one is str_replace_all) and always threw.
let s = import("stdlib:serialization.sapp");

let raw = "a < b & c > d \"q\" 'p'";
let esc = s.xml_escape(raw);
if not str_contains(esc, "&lt;") or not str_contains(esc, "&amp;") { throw "FAIL xml_escape"; }
if s.xml_unescape(esc) != raw { throw "FAIL xml round-trip"; }

print "serialization_xml_pass";
