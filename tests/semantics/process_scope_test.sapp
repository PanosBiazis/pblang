let Scoped = import("stdlib:process_scope.sapp");
let Process = import("stdlib:process.sapp");
fn check(value, message) { if not value { throw "FAIL process scope: " + message; } }
fn rejected(work) { return try {work(); false} catch true; }
let options = map{timeout_secs:3,max_output_bytes:1024,max_file_bytes:1024,
    max_memory_bytes:67108864,max_open_files:32,max_processes:2048};
let called = false;
for policy in [false, map{on_exit:"detach"}, map{on_exit:false},
               map{wait_ms:-1}, map{wait_ms:0.5}, map{grace_ms:10001}, map{typo:1}] {
    check(rejected(fn() {
        Scoped.with_process(["/usr/bin/printf"], [], options,
            fn(child) {called=true; return map{ok:true,value:nil};}, policy);
    }), "invalid cleanup policy rejected before launch");
}
check(not called, "invalid policy never invokes work");
check(rejected(fn() {Scoped.with_process([], [], options, 7);}), "nonfunction body rejected");
let ready = Process.bounded_status().available;
if ready {
    let escaped = nil;
    let result = Scoped.with_process(["/usr/bin/sleep"], ["30"], options, fn(child) {
        escaped = child;
        return map{ok:true,value:42};
    });
    check(result.ok and result.value==42 and result.cleanup_ok
        and result.cleanup_policy.on_exit=="cancel"
        and result.process_result.handle_closed and not result.recovery_required,
        "default closes a still-running child after a successful body");
    check(rejected(fn(){escaped.poll();}) and rejected(fn(){escaped.finish(0);})
        and rejected(fn(){escaped.cancel();}), "escaped controller cannot reopen ownership");
    for mode in ["returned", "exception", "malformed"] {
        result = Scoped.with_process(["/usr/bin/sleep"], ["30"], options, fn(child) {
            if mode=="exception" {throw "synthetic body failure";}
            if mode=="malformed" {return nil;}
            return map{ok:false,error:"original failure"};
        }, map{on_exit:"wait",grace_ms:50,wait_ms:2500});
        check(not result.ok and result.cleanup_ok and not result.recovery_required
            and result.process_result.handle_closed, "failed work cleans even under wait policy");
        if mode=="returned" {
            check(result.error=="original failure" and result.original_error_available,
                "returned primary error remains distinct");
        }
        if mode=="exception" {
            check(result.body_status=="exception" and not result.original_error_available,
                "host exception message limitation is explicit");
        }
    }
    result = Scoped.with_process(["/usr/bin/printf"], ["%s","waited"], options,
        fn(child){return map{ok:true,value:nil};}, map{on_exit:"wait",wait_ms:3000});
    check(result.ok and result.process_result.command_ok
        and result.process_result.stdout=="waited", "wait mode retains final output");
    result = Scoped.with_process(["/usr/bin/printf"], ["%s","finished"], options, fn(child) {
        let completed=child.finish(3000);
        return map{ok:completed.command_ok,value:completed.stdout};
    });
    check(result.ok and result.value=="finished" and result.cleanup_ok,
        "explicit finish inside scope is not closed twice");
    result = Scoped.with_process(["/definitely/missing/pblang-scope-fixture"], [], options,
        fn(child){called=true;return map{ok:true,value:nil};});
    check(not result.ok and result.cleanup_ok and not result.recovery_required and not called,
        "failed launch does not call body or leave ownership");
    check(Process.maintain_bounded().active==0, "all scoped registry ownership released");
    print "process_scope_native_pass";
} else {
    let result=Scoped.with_process([], [], options, fn(child){called=true;return map{ok:true,value:nil};});
    check(not result.ok and result.error.unsupported and not called
        and not result.recovery_required, "unsupported backend has no fallback");
    print "process_scope_unsupported_pass";
}
