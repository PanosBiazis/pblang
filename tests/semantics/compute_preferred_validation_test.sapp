let CP = import("stdlib:compute.sapp");
let kinds = ["auto", "cpu", "sequential", "gpu", "npu", "simd", "distributed"];
let i = 0;
while i < len(kinds) {
    let kind = kinds[i];
    let opts = map{ preferred_device: str_upper(kind), devices: [], max_workers: 1 };
    let cfg = CP.policy(opts);
    assert(cfg.preferred_device == kind, "every supported kind normalizes");
    let expected = CP.select_device(2, [], cfg);
    let actual = CP.run_controlled([2, 3], fn(x) { return x * x; }, opts);
    assert(actual.route == expected and actual.results == [4, 9], "route and results preserved");
    let bad_option = try CP.policy(map{ preferred_device: kind, max_workers: 0 }) catch "rejected";
    assert(bad_option == "rejected", "matched kind still validates later policy fields");
    cfg.min_accelerator_items = 0;
    let bad_threshold = try CP.select_device(2, [], cfg) catch "rejected";
    assert(bad_threshold == "rejected", "matched kind still validates selector threshold");
    cfg.min_accelerator_items = 256;
    cfg.max_accelerator_transfer_bytes = -1;
    let bad_transfer = try CP.select_device(2, [], cfg) catch "rejected";
    assert(bad_transfer == "rejected", "matched kind still validates transfer limit");
    i = i + 1;
}
let invalid = ["", "cpu-extra", "distributed-extra", "GPU ", "other"];
i = 0;
while i < len(invalid) {
    let bad_policy = try CP.policy(map{ preferred_device: invalid[i] }) catch "rejected";
    assert(bad_policy == "rejected", "unknown policy kind rejected");
    let mutated = CP.policy(map{ preferred_device: "cpu" });
    mutated.preferred_device = invalid[i];
    let bad_selector = try CP.select_device(2, [], mutated) catch "rejected";
    assert(bad_selector == "rejected", "unknown mutated policy kind rejected");
    i = i + 1;
}
let raw = CP.policy();
raw.preferred_device = "CPU";
let raw_rejected = try CP.select_device(2, [], raw) catch "rejected";
assert(raw_rejected == "rejected", "selector requires already normalized policy");
let omitted = CP.policy(map{ preferred_device: "cpu" });
let explicit_nil = CP.policy(map{ preferred_device: "cpu", max_workers: nil });
assert(omitted == explicit_nil, "nil preserves detected default workers");
let counts = [1, 2, 64];
i = 0;
while i < len(counts) {
    let opts = map{ max_workers: counts[i], preferred_device: "cpu", devices: [] };
    assert(CP.policy(opts).max_workers == counts[i], "explicit workers preserved, independent of core count");
    let empty_storage = CP.storage_read_controlled([], opts);
    assert(empty_storage.results == [] and empty_storage.workers == 0, "explicit workers preserve empty storage behavior");
    i = i + 1;
}
let invalid_workers = [0, -1, 65, 1.5, "2", false, [], map{}];
i = 0;
while i < len(invalid_workers) {
    let opts = map{ max_workers: invalid_workers[i] };
    let rejected_compute = try CP.policy(opts) catch "rejected";
    let rejected_storage = try CP.storage_read_controlled([], opts) catch "rejected";
    assert(rejected_compute == "rejected" and rejected_storage == "rejected", "invalid explicit workers rejected");
    i = i + 1;
}
assert(CP.storage_read_controlled([], map{ max_workers: nil }) == CP.storage_read_controlled([]),
    "nil preserves storage defaults");
print "compute_preferred_validation_pass";
