let AD=import("stdlib:llm_adapters.sapp");
let ATT=import("stdlib:llm_attention.sapp");
let CORE=import("stdlib:llm_core.sapp");
fn same(a,b) { return json_stringify(a)==json_stringify(b); }
let model=ATT.model_new(ATT.config(8,4,8,16,1,1,77));
let baseline=AD.lm_head_adapter(model,2,4.0,1901);
let training=[]; for i 4 {push(training,map{x:[i],y:i+4});}
let candidate=AD.train_epochs(model,baseline,ATT.adapter_hidden,training,12,0.1).adapter;
let saved=json_stringify([model,baseline,candidate,training]);
let calls=map{count:0};
let counted=fn(model,ids) {calls.count=calls.count+1;return ATT.adapter_hidden(model,ids);};
for examples in [training,[map{x:[7,0],y:4}],[map{x:[6,0],y:CORE.argmax(ATT.logits(model,[6,0]))},map{x:[6,1],y:5}]] {
    calls.count=0;
    let paired=AD.evaluate_pair(model,baseline,candidate,counted,examples);
    assert(calls.count==len(examples),"one frozen-base forward pass per example");
    assert(same(paired.baseline,AD.evaluate(model,baseline,ATT.adapter_hidden,examples)),"baseline metric bit parity");
    assert(same(paired.candidate,AD.evaluate(model,candidate,ATT.adapter_hidden,examples)),"candidate metric bit parity");
    let regressions=0;
    for ex in examples {
        let h=ATT.head_hidden(model,ex.x);
        if CORE.argmax(AD.logits(model,h,baseline))==ex.y and CORE.argmax(AD.logits(model,h,candidate))!=ex.y {regressions=regressions+1;}
    }
    assert(paired.baseline_correct_regressions==regressions,"independently counted answer regressions");
}
assert(saved==json_stringify([model,baseline,candidate,training]),"comparison never mutates inputs");
let equal=AD.evaluate_pair(model,baseline,baseline,ATT.adapter_hidden,training);
assert(same(equal.baseline,equal.candidate) and equal.baseline_correct_regressions==0,"identical heads have identical metrics");
let rejected=try {AD.evaluate_pair(model,baseline,candidate,counted,[]);false} catch true;
assert(rejected,"empty evaluation rejected");
print "llm_adapter_pair_eval_pass";
