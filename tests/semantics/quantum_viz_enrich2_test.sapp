// tests/semantics/quantum_viz_enrich2_test.sapp — wave 2 for stdlib/quantum_viz.sapp
// bloch_label (nearest cardinal state) + prob_bars (ASCII histogram).

let V = import("stdlib/quantum_viz.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let inv2 = 0.7071067811865476;

// ── bloch_label: nearest cardinal state ───────────────────────────────────────────
eq(V.bloch_label([[1.0, 0.0], [0.0, 0.0]]), "|0>", "label |0>");
eq(V.bloch_label([[0.0, 0.0], [1.0, 0.0]]), "|1>", "label |1>");
eq(V.bloch_label([[inv2, 0.0], [inv2, 0.0]]), "|+>", "label |+>");
eq(V.bloch_label([[inv2, 0.0], [0.0 - inv2, 0.0]]), "|->", "label |->");
eq(V.bloch_label([[inv2, 0.0], [0.0, inv2]]), "|i+>", "label |i+>");

// ── prob_bars: ASCII histogram, one line per basis state ──────────────────────────
let bars = V.prob_bars([1.0, 0.0]);
if type(bars) != "string" { fail("prob_bars returns string"); }
let lines = str_split(bars, "\n");
eq(len(lines), 2, "one line per probability");
if str_index_of(bars, "#") < 0 { fail("prob_bars draws bars"); }
// the |0> line (full prob) should have more bar chars than the |1> line (zero prob)
if str_index_of(lines[1], "#") >= 0 { fail("zero-prob line should have no bar"); }

print "quantum_viz_enrich2_pass";
