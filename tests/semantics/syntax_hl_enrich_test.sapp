// tests/semantics/syntax_hl_enrich_test.sapp — enrichment for stdlib/syntax_hl.sapp
// Adds highlight (tokens + colors combined) and themes().

let hl = import("stdlib/syntax_hl.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base color mapping still works ───────────────────────────────────────────────
let kc = hl.kind_color("keyword");
eq(len(kc), 3, "kind_color is rgb");

// ── ENRICH: themes ───────────────────────────────────────────────────────────────
let th = hl.themes();
eq(len(th), 2, "two themes"); eq(th[0], "dark", "dark theme listed");

// ── ENRICH: highlight produces colored tokens ────────────────────────────────────
let spans = hl.highlight("let x = 5;", "dark");
if len(spans) < 3 { fail("highlight should produce several tokens, got " + str(len(spans))); }
// every span carries a 3-component color and a kind
let i = 0;
while i < len(spans) {
    if len(spans[i].color) != 3 { fail("span missing rgb color @" + str(i)); }
    i = i + 1;
}
// dark vs light themes differ for keywords
let dk = hl.highlight("let x = 1;", "dark")[0].color;
let lt = hl.highlight("let x = 1;", "light")[0].color;
if dk[0] == lt[0] and dk[1] == lt[1] and dk[2] == lt[2] { fail("dark and light keyword colors should differ"); }

print "syntax_hl_enrich_pass";
