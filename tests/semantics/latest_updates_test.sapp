let L=import("stdlib:latest_updates.sapp");
fn check(ok,label){if not ok {throw "FAIL latest_updates: "+label;}}
let q=L.new_buffer();
let writes=[];
let apply=fn(key,value){array_push(writes,[key,value]);return true;};
check(q.submit("screen",1) and q.submit("led",2) and not q.submit("screen",3),"submission identity");
check(q.pending()==2,"bounded by pending keys");
let r=q.flush(apply);
check(r.ok and r.applied==2 and r.coalesced==1 and writes==[["screen",3],["led",2]],"last value first-key order");
r=q.flush(apply);
check(r.ok and r.attempted==0 and len(writes)==2,"idle does no consumer work");
let work=map{count:0};
fn producer(value){return fn(){work.count=work.count+1;return value;};}
for i 1000 {q.submit_lazy(str(num_mod(i,16)),producer(i));}
check(work.count==0 and q.pending()==16,"lazy work deferred");
writes=[];
r=q.flush(apply);
check(r.ok and r.applied==16 and r.coalesced==984 and work.count==16,"obsolete computations skipped");
for pair in writes {check(pair[1]>=984 and pair[1]<=999,"latest payload");}
q.submit_lazy("bad",fn(){throw "producer";});
q.submit("denied",1);q.submit("throwing",2);q.submit("good",3);
r=q.flush(fn(key,value){if key=="throwing" {throw "consumer";}return key=="good";});
check(not r.ok and r.attempted==4 and r.applied==1 and len(r.failures)==3,"independent failure reporting");
check(q.pending()==0,"failed updates are not implicitly retried");
q.submit("first",1);
r=q.flush(fn(key,value){q.submit("next",value+1);return true;});
check(r.ok and r.attempted==1 and q.pending()==1,"new work belongs to next pass");
writes=[];r=q.flush(apply);
check(r.ok and writes==[["next",2]],"next pass retained");
q.submit("recursive",1);q.submit("survivor",2);
r=q.flush(fn(key,value){if key=="recursive" {q.flush(apply);}return true;});
check(not r.ok and r.applied==1 and q.pending()==0,"recursive flush rejected without losing pass");
q.submit("discard",1);q.submit("survivor",2);
r=q.flush(fn(key,value){if key=="discard" {q.discard();}return true;});
check(not r.ok and r.applied==1,"discard during flush rejected");
q.submit_lazy("drop",producer(9));
check(q.discard()==1 and q.pending()==0 and work.count==16,"discard without computation");
let rejected=try q.submit(1,7) catch -1;
check(rejected==-1 and q.pending()==0,"invalid key cannot mutate queue");
q.submit("nil",nil);q.submit("false",false);
writes=[];r=q.flush(apply);
check(r.ok and writes==[["nil",nil],["false",false]],"nil and false payloads");
q.submit("bad_ack",1);r=q.flush(fn(key,value){return 1;});
check(not r.ok and r.failures[0].stage=="not_acknowledged","strict boolean acknowledgement");
q.submit_lazy("mixed",producer(7));q.submit("mixed",[4]);
writes=[];r=q.flush(apply);
check(r.ok and writes==[["mixed",[4]]] and work.count==16,"eager value replaces lazy computation");
q.submit("same",1);
r=q.flush(fn(key,value){q.submit(key,2);return true;});
writes=[];r=q.flush(apply);
check(r.ok and writes==[["same",2]],"same-key callback submission is not lost");
let other=L.new_buffer();other.submit("own",1);
check(q.pending()==0 and other.pending()==1,"independent buffers");
other.discard();
print "latest_updates_pass";
