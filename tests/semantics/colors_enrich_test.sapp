// tests/semantics/colors_enrich_test.sapp — enrichment for stdlib/colors.sapp
// Adds the documented-but-missing HSV + CMYK conversions, WCAG luminance/contrast,
// and a triadic palette.

let C = import("stdlib/colors.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.01 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn rgbeq(c, r, g, b, m) { if c.r != r or c.g != g or c.b != b { fail(m + " got=" + str(c.r) + "," + str(c.g) + "," + str(c.b)); } }

let red = map{ r: 255, g: 0, b: 0 };
let white = map{ r: 255, g: 255, b: 255 };
let black = map{ r: 0, g: 0, b: 0 };

// ── base still works ─────────────────────────────────────────────────────────────
rgbeq(C.hex_to_rgb("#ff0000"), 255, 0, 0, "hex_to_rgb");

// ── ENRICH: HSV round-trip ───────────────────────────────────────────────────────
let hsv = C.rgb_to_hsv(red);
near(hsv.h, 0, "red hue 0"); near(hsv.s, 1, "red sat 1"); near(hsv.v, 1, "red val 1");
rgbeq(C.hsv_to_rgb(C.rgb_to_hsv(map{ r: 0, g: 128, b: 200 })), 0, 128, 200, "hsv round-trip");

// ── ENRICH: CMYK round-trip ──────────────────────────────────────────────────────
let cmyk = C.rgb_to_cmyk(red);
near(cmyk.c, 0, "red cyan 0"); near(cmyk.m, 1, "red magenta 1"); near(cmyk.k, 0, "red key 0");
rgbeq(C.cmyk_to_rgb(C.rgb_to_cmyk(map{ r: 10, g: 200, b: 100 })), 10, 200, 100, "cmyk round-trip");

// ── ENRICH: WCAG luminance + contrast ────────────────────────────────────────────
near(C.luminance(white), 1, "white luminance ~1");
near(C.luminance(black), 0, "black luminance 0");
near(C.contrast_ratio(white, black), 21, "white/black contrast = 21:1");

// ── ENRICH: triadic palette ──────────────────────────────────────────────────────
let tri = C.triadic(red);
if len(tri) != 3 { fail("triadic returns 3 colors"); }
near(C.rgb_to_hsv(tri[1]).h, 120, "triadic +120 deg");

print "colors_enrich_pass";
