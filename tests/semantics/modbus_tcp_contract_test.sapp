let MODBUS = import("stdlib:modbus_tcp.sapp");

fn expect(value, message) { if not value { throw "FAIL Modbus TCP: " + message; } }
fn rejected(work) { return try { work(); false } catch true; }

let frame = MODBUS.request(0x1234, 7, "holding", 0x0102, 2);
expect(frame == [0x12,0x34,0,0,0,6,7,3,1,2,0,2], "read request wire bytes");
expect(rejected(fn() { MODBUS.request(1, 0, "holding", 0, 1); })
    and rejected(fn() { MODBUS.request(1, 1, "write", 0, 1); })
    and rejected(fn() { MODBUS.request(1, 1, "holding", 0, 126); })
    and rejected(fn() { MODBUS.request(1, 1, "coil", 0, 2001); }),
    "unit, function, register and bit count bounds");

let registers = MODBUS.parse_response([0x12,0x34,0,0,0,7,7],
    [3,4,0x12,0x34,0xab,0xcd], 0x1234, 7, "holding", 2);
expect(registers.ok and registers.values == [0x1234,0xabcd],
    "holding register response parsing");
let coils = MODBUS.parse_response([0,1,0,0,0,4,1], [1,1,0b00000101],
    1, 1, "coil", 3);
expect(coils.ok and coils.values == [true,false,true], "LSB-first coil parsing");
let exception = MODBUS.parse_response([0,1,0,0,0,3,1], [0x83,2],
    1, 1, "holding", 1);
expect(not exception.ok and exception.exception and exception.exception_code == 2,
    "exception response is typed");
expect(not MODBUS.parse_response([0,2,0,0,0,5,1], [3,2,0,1],
        1, 1, "holding", 1).ok
    and not MODBUS.parse_response([0,1,0,1,0,5,1], [3,2,0,1],
        1, 1, "holding", 1).ok
    and not MODBUS.parse_response([0,1,0,0,0,5,2], [3,2,0,1],
        1, 1, "holding", 1).ok,
    "transaction, protocol and unit mismatches fail closed");

if platform() == "linux" {
    let TCP = import("stdlib:native_tcp.sapp");
    let PROCESS = import("stdlib:linux_process.sapp");
    let listener = TCP.listen_ipv4("127.0.0.1", 0, 4);
    expect(listener.ok, "loopback Modbus listener");
    let child_state = PROCESS.start(path_join(cwd(), "target/release/pblang"), ["run",
        "tests/fixtures/modbus_tcp_client_fixture.sapp", "--allow-all"], map{
        timeout_secs: 10, startup_timeout_ms: 5000, max_output_bytes: 65536,
        max_memory_bytes: 805306368, inherit_environment: false,
        environment: map{ PB_MODBUS_TEST_PORT: str(listener.port) }
    });
    expect(child_state.ok, "isolated bounded client starts: "
        + str(try child_state.error catch ""));
    let peer = TCP.accept_bounded(listener, 5000);
    if not peer.ok {
        TCP.close(listener);
        let failed_child = PROCESS.finish(child_state, 7000);
        throw "FAIL Modbus TCP: loopback client accepted: "
            + str(try peer.error catch "") + "; child exit="
            + str(try failed_child.exit_code catch -1) + "; stdout="
            + str(try failed_child.stdout catch "") + "; stderr="
            + str(try failed_child.stderr catch "");
    }
    let request_bytes = TCP.read_exact_bytes(peer, 12, 2000);
    expect(request_bytes.ok and request_bytes.bytes == frame,
        "client sends exact bounded request frame");
    let sent = TCP.write_bytes(peer,
        [0x12,0x34,0,0,0,7,7,3,4,0x12,0x34,0xab,0xcd], 2000);
    expect(sent.ok and sent.count == 13, "device response written exactly");
    TCP.close(peer); TCP.close(listener);
    let child = PROCESS.finish(child_state, 7000);
    expect(child.ok and child.exit_code == 0 and child.process_group_terminated,
        "isolated client exits successfully: " + child.stderr);
    let live = json_parse(str_trim(child.stdout));
    expect(live.ok and live.values == [0x1234,0xabcd]
        and live.native_nonblocking and live.deadline_bounded and not live.shell_used,
        "native Modbus client round trip");
}

print "modbus_tcp_contract_pass";
