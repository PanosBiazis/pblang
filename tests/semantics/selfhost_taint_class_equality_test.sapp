let F=import("stdlib:compiler/selfhost_frontend.sapp");
let source="let first=\"label\"; let equal=first==\"la\"+\"bel\";"
    +"let nul_equal=first==\"label\\x00suffix\"; let other_equal=first==\"labeL\";"
    +"let prior=first; first=first+\"changed\"; let retained=prior==\"label\";"
    +"let unicode_equal=\"α😀\"==\"α\"+\"😀\";";
let r=F.frontend_run_bounded(source,map{max_steps:3000,max_frames:8,max_source_bytes:4096});
assert(r.ok,"bounded PBLang VM string equality probe");
assert(r.globals.equal and r.globals.unicode_equal,"independently built equal string values");
assert(not r.globals.nul_equal and not r.globals.other_equal,"NUL suffix and case remain distinct");
assert(r.globals.retained,"assignment creates a new value rather than mutating prior string");
print "selfhost_taint_class_equality_pass";
