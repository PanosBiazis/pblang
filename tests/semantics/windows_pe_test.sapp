let PE = import("stdlib:windows_pe.sapp");

fn fail(message) { throw "FAIL windows_pe: " + message; }
fn contains_bytes(haystack, needle) {
    if len(needle) == 0 { return true; }
    let i = 0;
    while i + len(needle) <= len(haystack) {
        let ok = true; let j = 0;
        while j < len(needle) and ok { if haystack[i + j] != needle[j] { ok = false; } j = j + 1; }
        if ok { return true; } i = i + 1;
    }
    return false;
}
fn build_overlap(layout) {
    let too_large = []; let i = 0;
    while i <= layout.data_rva - layout.text_rva { array_push(too_large, 0x90); i = i + 1; }
    PE.assemble_x64(too_large, layout);
}

let imports = [
    map{ dll: "USER32.dll", symbols: ["SendInput"] },
    map{ dll: "KERNEL32.dll", symbols: ["ExitProcess", "GetLastError"] },
];
let layout = PE.layout_x64(imports, 3);
if layout.format != "pblang.windows.pe64-layout.v1" or layout.extra_len != 3
    or layout.idt_size != 60 or layout.iat_size != 40 {
    fail("multi-DLL layout metadata");
}
let send = PE.iat_rva(layout, "user32.DLL", "SendInput");
let exit = PE.iat_rva(layout, "kernel32.dll", "ExitProcess");
if send == exit or send < 0x2000 or exit < 0x2000 { fail("distinct bounded IAT RVAs"); }
let call = PE.call_iat_x64(layout, "USER32.dll", "SendInput", 0);
if len(call) != 6 or call[0] != 0xFF or call[1] != 0x15 { fail("RIP-relative IAT call"); }

let binary = PE.assemble_x64([0x31, 0xC9, 0xC3], layout, [1, 2, 3]);
let inspected = PE.inspect_x64(binary);
if not inspected.ok or inspected.format != "pe32+" or inspected.machine != "x86_64"
    or not inspected.wx_split or not inspected.nx_compatible { fail("PE32+ inspection"); }
if not contains_bytes(binary, str_to_bytes("USER32.dll"))
    or not contains_bytes(binary, str_to_bytes("SendInput"))
    or not contains_bytes(binary, str_to_bytes("KERNEL32.dll"))
    or not contains_bytes(binary, str_to_bytes("ExitProcess")) {
    fail("import names missing from artifact");
}

let duplicate_denied = try {
    PE.layout_x64([map{ dll: "USER32.dll", symbols: ["SendInput", "SendInput"] }]); false
} catch true;
if not duplicate_denied { fail("duplicate symbol accepted"); }
let path_denied = try {
    PE.layout_x64([map{ dll: "../USER32.dll", symbols: ["SendInput"] }]); false
} catch true;
if not path_denied { fail("path-like DLL name accepted"); }
let undeclared_denied = try { PE.iat_rva(layout, "USER32.dll", "MessageBoxW"); false } catch true;
if not undeclared_denied { fail("undeclared import lookup accepted"); }
let mismatch_denied = try { PE.assemble_x64([0xC3], layout, []); false } catch true;
if not mismatch_denied { fail("extra-data mismatch accepted"); }
let large_layout = PE.layout_x64(imports, 0, 9000);
if large_layout.data_rva < large_layout.text_rva + 9000
    or num_mod(large_layout.data_rva, 4096) != 0 { fail("dynamic section separation"); }
let overlap_denied = try { build_overlap(large_layout); false } catch true;
if not overlap_denied { fail("code/data overlap accepted"); }

print "windows_pe_pass";
