// tests/semantics/math_symbols_enrich_test.sapp — enrichment for stdlib/math_symbols.sapp
// Adds superscript_to_pow, to_symbols (ASCII->pretty), and latex_expand.

let ms = import("stdlib/math_symbols.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base still works ─────────────────────────────────────────────────────────────
eq(ms.normalize_expr("2 × π"), "2 * PI", "normalize_expr");

// ── ENRICH: superscript_to_pow ───────────────────────────────────────────────────
eq(ms.superscript_to_pow("x²"), "x**2", "superscript squared");
eq(ms.superscript_to_pow("a³ + b²"), "a**3 + b**2", "superscript cubed+squared");

// ── ENRICH: to_symbols (ASCII -> pretty for display) ─────────────────────────────
eq(ms.to_symbols("a <= b"), "a ≤ b", "to_symbols <=");
eq(ms.to_symbols("2 ** 3"), "2 ^ 3", "to_symbols power -> caret (not ××)");
eq(ms.to_symbols("3 * 4"), "3 × 4", "to_symbols multiply");

// ── ENRICH: latex_expand (longer commands first so \le doesn't corrupt \left) ────
eq(ms.latex_expand("\\pi + \\sqrt"), "π + √", "latex_expand pi+sqrt");
eq(ms.latex_expand("\\left \\le"), "← ≤", "latex_expand orders by length (\\left before \\le)");

print "math_symbols_enrich_pass";
