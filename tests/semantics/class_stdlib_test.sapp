let oop = import("stdlib:class.sapp");

// Define Animal class
let Animal = oop.define("Animal", ["name", "sound"], map{
    speak: fn(self) { return self.name + " says " + self.sound; },
    to_string: fn(self) { return "Animal(" + self.name + ")"; }
});

// Create instance
let a = oop.new(Animal, map{ name: "Cat", sound: "meow" });
assert(a.name == "Cat", "name should be Cat");
assert(a.sound == "meow", "sound should be meow");
assert(oop.instanceof(a, Animal), "should be instanceof Animal");
assert(oop.class_name(a) == "Animal", "class name should be Animal");

// Method call via class.call
let speech = oop.call(a, "speak");
assert(speech == "Cat says meow", "speak should work: " + str(speech));

// Extend: Dog extends Animal
let Dog = oop.extend(Animal, "Dog", [], map{
    fetch: fn(self) { return self.name + " fetches!"; },
    speak: fn(self) { return self.name + " says WOOF!"; }  // override
});

let d = oop.new(Dog, map{ name: "Rex", sound: "woof" });
assert(d.name == "Rex", "dog name should be Rex");
assert(oop.instanceof(d, Dog), "should be instanceof Dog");
assert(oop.instanceof(d, Animal), "should also be instanceof Animal");

// Overridden method
let dog_speech = oop.call(d, "speak");
assert(dog_speech == "Rex says WOOF!", "dog speak should be overridden: " + str(dog_speech));

// New method
let fetch_result = oop.call(d, "fetch");
assert(fetch_result == "Rex fetches!", "fetch should work: " + str(fetch_result));

// is_class
assert(oop.is_class(Animal) == true, "Animal should be a class");
assert(oop.is_class(a) == false, "instance should not be a class");

// has_method
assert(oop.has_method(a, "speak") == true, "should have speak method");
assert(oop.has_method(a, "nonexistent") == false, "should not have nonexistent method");

// Missing field should error
let err_result = try oop.new(Animal, map{ name: "Cow" }) catch "caught";
assert(err_result == "caught", "missing field should error");

print "class stdlib tests passed";
