// The same literal-default fixture must pass through both public local routes.
if platform() != "linux" { print "interp_defaults_live_skip_linux_required"; os_exit(0); }
let compiler = env_get("PBLANG_BIN") ?? path_join(cwd(), "target/release/pblang");
let fixture = "tests/fixtures/interp_defaults_program.sapp";
let host = proc_spawn_wait("/usr/bin/timeout", ["-k", "1s", "8s", compiler, "run", fixture, "--allow-all"]);
let interpreted = proc_spawn_wait("/usr/bin/timeout", ["-k", "1s", "8s", compiler, "run",
    "tools/pbi.sapp", "--allow-all", "--", fixture]);
assert(host.exit_code == 0 and host.stderr == "", "retained host positive control");
assert(interpreted.exit_code == 0 and interpreted.stderr == "", "pbi driver completed normally");
assert(host.stdout == "interp_defaults_program_pass\n" and interpreted.stdout == host.stdout,
    "literal default fixture passes on both routes");
let rejected = proc_spawn_wait("/usr/bin/timeout", ["-k", "1s", "8s", compiler, "run",
    "tests/fixtures/interp_default_probe.sapp", "--allow-all"]);
assert(rejected.exit_code == 1 and rejected.stdout == "", "computed default causes no print effect");
assert(str_contains(rejected.stderr, "]: interp: invalid parameter default\n"), "fixed default diagnostic");
assert(not str_contains(rejected.stderr, "private_default_canary"), "default diagnostic does not echo supplied AST");
print "interp_defaults_live_pass";
