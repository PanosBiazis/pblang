// Test: structural interfaces (the `interface` keyword)
// `interface Name { member; method(args); }` desugars to a predicate function
// `Name(x)` returning whether `x` structurally conforms — `x` is a map (or class
// instance) that has every required member. This gives pblang Go/TS/Python-
// `Protocol`-style structural typing with zero runtime/VM/import cost.
//
// `has_member` (the backing builtin) checks instance keys AND the `__class`
// table chain, so plain maps, `struct` values, and native-`class` instances all
// conform when they have the required names.

// --- Plain map conformance (method members) ---
interface Shape { area(); perimeter(); }

let circle = map{
    r: 5,
    area: fn() { return 3 * 5 * 5; },
    perimeter: fn() { return 2 * 3 * 5; },
};
assert(Shape(circle) == true, "circle with area+perimeter conforms to Shape");

let half = map{ area: fn() { return 0; } };
assert(Shape(half) == false, "map missing perimeter does NOT conform");

// --- Bare members = field requirements ---
interface Point2 { x; y; }
assert(Point2(map{ x: 1, y: 2 }) == true, "map with x,y conforms to Point2");
assert(Point2(map{ x: 1 }) == false, "map missing y does NOT conform");
assert(Point2(circle) == false, "circle has no x/y");

// --- struct values conform (fields are map keys) ---
struct Vec2 { x: number, y: number }
let v = Vec2(3, 4);
assert(Point2(v) == true, "struct Vec2 conforms to Point2 by its fields");

// --- Native class instances conform via the __class method table ---
interface Drawable { draw(); resize(w, h); }

class Button {
    fn init(self, label) { self.label = label; }
    fn draw(self) { return "[" + self.label + "]"; }
    fn resize(self, w, h) { return w * h; }
}
let b = Button("OK");
assert(Drawable(b) == true, "Button instance conforms to Drawable via __class");
assert(b:draw() == "[OK]", "method still callable after interface check");

class TextLabel {
    fn init(self, t) { self.t = t; }
    fn draw(self) { return self.t; }
}
assert(Drawable(TextLabel("hi")) == false, "Label lacks resize, does NOT conform");

// --- Non-map values are never conformant (total predicate, no error) ---
assert(Drawable(42) == false, "number does not conform");
assert(Drawable("str") == false, "string does not conform");
assert(Shape([1, 2, 3]) == false, "array does not conform");

// --- Empty interface: only requires being a map ---
interface AnyMap {}
assert(AnyMap(map{ z: 1 }) == true, "empty interface conforms for any map");
assert(AnyMap(7) == false, "empty interface rejects non-maps");

// --- Usable as a guard / assertion contract ---
if Drawable(b) {
    let rendered = b:draw();
    assert(rendered == "[OK]", "guarded use renders correctly");
}

// --- has_member is also directly callable as a reflection primitive ---
assert(has_member(circle, "area") == true, "has_member sees instance key");
assert(has_member(b, "draw") == true, "has_member sees __class method");
assert(has_member(b, "missing") == false, "has_member false for absent member");
assert(has_member(99, "x") == false, "has_member false for non-map");

print "interface_pass";
