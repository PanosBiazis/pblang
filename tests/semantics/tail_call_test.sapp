// Test: tail-call optimization (TCO)
// A `return f(args)` in tail position reuses the current call frame instead of
// growing the native stack. This lets deep/mutual tail recursion run in O(1)
// stack space — a competitive parity feature with Scheme, Lua, and Scala.
//
// The VM only reuses a frame when the callee is a user closure/function AND the
// current frame has no pending defers. Otherwise it falls back to a normal call,
// so correctness is preserved in every case; these asserts pin both paths.

// --- Deep self tail recursion: would blow a non-TCO stack at this depth ---
fn count_down(n) {
    if n == 0 { return 0; }
    return count_down(n - 1);
}
assert(count_down(500000) == 0, "deep tail self-recursion should not overflow");

// --- Tail recursion carrying an accumulator (classic sum) ---
fn sum_to(n, acc) {
    if n == 0 { return acc; }
    return sum_to(n - 1, acc + n);
}
assert(sum_to(100000, 0) == 5000050000, "accumulator tail recursion should be exact");

// --- Mutual tail recursion: is_even / is_odd ping-pong, deep ---
fn is_even(n) {
    if n == 0 { return true; }
    return is_odd(n - 1);
}
fn is_odd(n) {
    if n == 0 { return false; }
    return is_even(n - 1);
}
assert(is_even(200000) == true, "mutual tail recursion even should hold");
assert(is_odd(200001) == true, "mutual tail recursion odd should hold");

// --- Non-tail recursion must still work (fib is not in tail position) ---
fn fib(n) {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}
assert(fib(20) == 6765, "non-tail recursion (fib) still correct");

// --- Defer fallback: a frame with a pending defer must NOT be frame-reused,
//     and the defer must still fire. Result and side effect both checked. ---
let defer_hits = [0];
fn with_defer(n) {
    defer { defer_hits[0] = defer_hits[0] + 1; }
    if n == 0 { return 42; }
    return with_defer(n - 1);
}
assert(with_defer(3) == 42, "defer-guarded tail call returns correct value");
assert(defer_hits[0] == 4, "each defer-guarded frame must run its defer (4 calls)");

// --- Builtin in tail position falls back to a plain call and returns right ---
fn tail_to_builtin(x) {
    return num_abs(x);
}
assert(tail_to_builtin(0 - 7) == 7, "tail call into a builtin returns correctly");

print "tail_call_pass";
