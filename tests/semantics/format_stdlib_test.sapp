// tests/semantics/format_stdlib_test.sapp
let fmt = import("stdlib:format.sapp");

// table
let tbl = fmt.table([
    ["Name", "Age", "City"],
    ["Alice", 30, "NYC"],
    ["Bob", 25, "LA"]
]);
if str_contains(tbl, "Name") == false { throw "FAIL table header"; }
if str_contains(tbl, "Alice") == false { throw "FAIL table row1"; }
if str_contains(tbl, "Bob") == false { throw "FAIL table row2"; }
if str_contains(tbl, "+") == false { throw "FAIL table borders"; }

// progress bar
let pb = fmt.progress(50, 100);
if str_contains(pb, "50%") == false { throw "FAIL progress 50%: " + str(pb); }

let pb0 = fmt.progress(0, 100);
if str_contains(pb0, "0%") == false { throw "FAIL progress 0%"; }

let pb100 = fmt.progress(100, 100);
if str_contains(pb100, "100%") == false { throw "FAIL progress 100%"; }

// center
let c = fmt.center("hi", 10, "-");
if len(c) != 10 { throw "FAIL center len: " + str(len(c)); }
if str_contains(c, "hi") == false { throw "FAIL center content"; }

// truncate
let tr = fmt.truncate("Hello World this is long text", 15, "...");
if len(tr) != 15 { throw "FAIL truncate len: " + str(len(tr)); }
if str_contains(tr, "...") == false { throw "FAIL truncate suffix"; }

// number_format
let nf = fmt.number_format(1234567.89, 2, ",", ".");
if str_contains(nf, "1,234,567") == false { throw "FAIL number_format: " + str(nf); }

// bytes_human
let bh1 = fmt.bytes_human(500);
if str_contains(bh1, "B") == false { throw "FAIL bytes B"; }
let bh2 = fmt.bytes_human(1536);
if str_contains(bh2, "KB") == false { throw "FAIL bytes KB: " + str(bh2); }
let bh3 = fmt.bytes_human(1048576);
if str_contains(bh3, "MB") == false { throw "FAIL bytes MB: " + str(bh3); }

print "format_stdlib_pass";
