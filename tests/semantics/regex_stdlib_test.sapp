// tests/semantics/regex_stdlib_test.sapp
let re = import("stdlib:regex.sapp");

// regex_match (builtin)
if regex_match("hello world", "\\w+") == false { throw "FAIL regex_match true"; }
if regex_match("hello world", "\\d+") { throw "FAIL regex_match false"; }

// regex_find
let found = regex_find("price: $42.50", "\\d+");
if found != "42" { throw "FAIL regex_find: expected 42 got " + str(found); }

let missing_match = regex_find("abc", "\\d+");
if missing_match != nil { throw "FAIL regex_find nil"; }

// regex_find_all
let digits = regex_find_all("a1b2c3d4", "\\d");
if len(digits) != 4 { throw "FAIL regex_find_all len: expected 4 got " + str(len(digits)); }
if digits[0] != "1" or digits[3] != "4" { throw "FAIL regex_find_all values"; }

// regex_replace
let r1 = regex_replace("foo bar baz", "\\s+", "_");
if r1 != "foo_bar baz" { throw "FAIL regex_replace: expected foo_bar baz got " + str(r1); }

// regex_replace_all
let r2 = regex_replace_all("foo bar baz", "\\s+", "_");
if r2 != "foo_bar_baz" { throw "FAIL regex_replace_all: expected foo_bar_baz got " + str(r2); }

// regex_split
let parts = regex_split("one,two,,three", ",+");
if len(parts) != 3 { throw "FAIL regex_split len: expected 3 got " + str(len(parts)); }

// regex_capture
let caps = regex_capture("2024-01-15", "(\\d{4})-(\\d{2})-(\\d{2})");
if caps == nil { throw "FAIL regex_capture nil"; }
if len(caps) != 4 { throw "FAIL regex_capture len: expected 4 got " + str(len(caps)); }
if caps[1] != "2024" { throw "FAIL regex_capture group1: expected 2024 got " + str(caps[1]); }
if caps[2] != "01" { throw "FAIL regex_capture group2"; }

// stdlib wrapper
if re.match("test@example.com", re.EMAIL) == false { throw "FAIL re.match email"; }
if re.count("aaabbbccc", "[a-c]") != 9 { throw "FAIL re.count"; }
if re.is_valid("\\w+") == false { throw "FAIL re.is_valid good"; }
if re.is_valid("[invalid") { throw "FAIL re.is_valid bad"; }

// str_format
let msg = str_format("Hello %s, you are %d years old!", "Alice", 30);
if msg != "Hello Alice, you are 30 years old!" {
    throw "FAIL str_format: got " + str(msg);
}

let pct = str_format("100%% done");
if pct != "100% done" { throw "FAIL str_format %%: got " + str(pct); }

print "regex_stdlib_pass";
