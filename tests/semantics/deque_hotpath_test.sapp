let D = import("stdlib:deque.sapp");

fn fail(message) { throw "FAIL deque: " + message; }
fn eq(actual, expected, message) { if actual != expected { fail(message + " got=" + str(actual)); } }

let dq = D.from_array([1, 2, 3]);
D.push_front(dq, 0);
D.push_back(dq, 4);
eq(D.to_string(dq), "Deque[0, 1, 2, 3, 4]", "double ended order");
eq(D.pop_front(dq), 0, "pop front");
eq(D.pop_back(dq), 4, "pop back");
eq(D.peek_front(dq), 1, "peek front");
eq(D.peek_back(dq), 3, "peek back");
eq(D.size(dq), 3, "size");

// Objects created by the pre-indexed implementation upgrade on first use.
let legacy = map{ data: ["a", "b"] };
eq(D.pop_front(legacy), "a", "legacy migration pop");
D.push_front(legacy, "z");
eq(D.to_string(legacy), "Deque[z, b]", "legacy migration order");

D.clear(dq);
eq(D.is_empty(dq), true, "clear");
eq(D.pop_front(dq), nil, "empty pop");

print "deque_hotpath_pass";
