// tests/semantics/ctranspile_cident_test.sapp
//
// The self-hosted pblang->C transpiler (stdlib/compiler/ctranspile.sapp) emitted
// pblang identifiers VERBATIM as C identifiers. pblang identifiers like `int`,
// `void`, `default`, `register` are perfectly valid (the Rust VM runs them) but
// are C RESERVED WORDS, so the generated C failed to compile ("two or more data
// types", "redefinition"). A self-hosted backend must produce C that actually
// compiles, so identifiers colliding with C keywords are mangled to a safe form
// CONSISTENTLY at every emission site (declaration, use, params, function names,
// for-loop variables) -- and intrinsic/runtime symbols (outb, kmalloc, ...) are
// left untouched because they are not C keywords.
//
// Unlike the substring-only ctranspile_test, this test COMPILES and RUNS the
// generated C with the host C compiler, so it can only pass on valid C.

let ct = import("stdlib/compiler/ctranspile.sapp");

fn fail(m) { throw "FAIL " + m; }

// Find a C compiler; skip (pass) if none is available on this host.
fn find_cc() {
    let cands = ["cc", "gcc", "clang"];
    let i = 0;
    while i < len(cands) {
        let probe = try proc_spawn_wait(cands[i], ["--version"]) catch nil;
        if probe != nil and probe.exit_code == 0 { return cands[i]; }
        i = i + 1;
    }
    return nil;
}

let cc = find_cc();
if cc == nil { print "ctranspile_cident_pass"; }
else {

// 1. Pure-keyword identifiers as a param + locals. The Rust VM computes f(21)=42.
let src = "fn f(register) { let int = register; let default = int * 2; return default; }";
let c = ct.transpile(src);

// The generated C must mangle the keyword identifiers (not emit `double int = ...`).
if str_contains(c, "double int ") or str_contains(c, "double void ") or str_contains(c, "double default ") {
    fail("C keyword emitted verbatim as an identifier: " + c);
}

// Compile + run: write the unit + a main() that calls f(21), expect exit 42.
let stamp = str(num_floor(now_ms()));
let cpath = "/tmp/pbct_" + stamp + ".c";
let bpath = "/tmp/pbct_" + stamp + ".bin";
let full = c + "\nint main(void){ return (int)f(21); }\n";
fs_write_bytes(cpath, str_to_bytes(full));

let comp = proc_spawn_wait(cc, ["-w", cpath, "-o", bpath]);
if comp.exit_code != 0 { fail("generated C must compile, gcc said: " + comp.stderr); }

let run = proc_spawn_wait(bpath, []);
if run.exit_code != 42 { fail("compiled program must return 42, got " + str(run.exit_code)); }

// 2. Intrinsic/runtime symbols must NOT be mangled (they are not C keywords): a
//    freestanding unit calling outb must still reference `outb`.
let fc = ct.transpile_freestanding("fn poke(p, v) { outb(p, v); }");
if not str_contains(fc, "outb(p, v)") { fail("intrinsic call name must be preserved, got: " + fc); }

print "ctranspile_cident_pass";
}
