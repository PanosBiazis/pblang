let F=import("stdlib/compiler/selfhost_frontend.sapp");
let V=import("stdlib/compiler/vm.sapp");
fn inst(op,arg){return map{op:op,operand:arg};}
fn chunk(count){
    let code=[];let values=[];
    for i count {array_push(values,i+10);array_push(code,inst(0,i));}
    array_push(code,inst(25,count));array_push(code,inst(19,0));
    return map{constants:values,instructions:code};
}
for count in [0,1,2,3,4,8,64] {
    let c=chunk(count);let result=V.run_bounded(c);
    assert(result.value==c.constants,"array source order");
    assert(result.runtime.steps==count+2,"array instruction accounting");
    assert(result.runtime.peak_stack==num_max(1,count),"array peak stack accounting");
    let second=V.run_bounded(c).value;
    array_push(result.value,99);
    assert(len(second)==count,"each execution owns its array");
}
let shared=map{n:1};let c=map{constants:[shared],instructions:[inst(0,0),inst(0,0),inst(25,2),inst(19,0)]};
let pair=V.run_bounded(c).value;pair[0].n=7;
assert(pair[1].n==7 and shared.n==7,"element references are not cloned");
for count in [1,2,3,4] {
    let insufficient=map{constants:[],instructions:[inst(25,count),inst(19,0)]};
    // Raw VM pop on an empty stack historically yields nil. Serialized IR
    // validation remains a separate boundary; this fast path cannot redefine it.
    let value=V.run_bounded(insufficient).value;
    assert(len(value)==count,"raw stack underflow keeps the array shape");
    for item in value {assert(item==nil,"raw stack underflow preserves nil fill");}
}
for count in [2,3,4] {
    assert((try {V.run_bounded(chunk(count),map{max_value_items:1});false;} catch true),"array admission limit");
}
for count in [bigint(1),decimal(2),rational(3)] {
    let exact=map{constants:[8],instructions:[inst(0,0),inst(25,count),inst(19,0)]};
    assert((try {V.run(exact);false;} catch true),"raw exact-count index errors are preserved");
}
// Argument arrays and array literals must be fresh across calls and activations.
let source="fn f(a=1,b=2,c=3){return [a,b,c];}"
    +"let a=f();let b=f(4);let c=f(5,6);let d=f(7,8,9);a[0]=99;"
    +"print b;print c;print d;"
    +"fn make(x){return fn(){x=x+1;return x;};}"
    +"let p=make(2);let q=make(8);print p();print q();print p();";
let compiled=F.frontend_compile(source);assert(compiled.ok,"compile frame isolation case");
assert(V.run(compiled.chunk).output==[[4,2,3],[5,6,3],[7,8,9],3,9,4],"independent argument arrays and capture cells");
assert(V.run_bounded(compiled.chunk).output==[[4,2,3],[5,6,3],[7,8,9],3,9,4],"bounded frame isolation");
// A fresh capture vector is distinct even when the closure body is reused.
fn capture(descriptors,locals,upvalues){
    let fnc=map{arity:0,min_arity:0,upvalues:descriptors,
        chunk:map{constants:[],instructions:[inst(38,0),inst(19,0)]}};
    return V.exec(map{constants:[fnc],instructions:[inst(24,0),inst(19,0)]},locals,map{},[],upvalues);
}
let desc=[map{is_local:true,index:0}];
let first=capture(desc,[1],[]);let second=capture(desc,[2],[]);
first.__upvalues[0]=9;
assert(second.__upvalues==[2],"capture vectors are independent");
assert(capture([map{is_local:false,index:0}],[],[7]).__upvalues==[7],"single transitive capture");
assert(capture([map{is_local:true,index:3}],[],[]).__upvalues==[nil],"missing local capture");
assert(capture([],[],[]).__upvalues==[],"fresh empty capture vector");
assert(capture([map{is_local:true,index:0},map{is_local:false,index:0}],[3],[4]).__upvalues==[3,4],"generic capture order");
print "selfhost_small_arrays_pass";
