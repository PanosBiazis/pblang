let T = import("stdlib:thread.sapp");

fn task(value) { return fn(){ return value; }; }
fn expect_settled(future, value) {
    assert(future.__resolved, "future settled");
    assert(channel_is_closed(future.__ch.receiver), "result channel closed");
    assert(channel_size(future.__ch.receiver) == 0, "result queue drained");
    assert((try {join(future.__handle); false} catch true), "worker already reaped");
    assert(json_stringify(T.await(future)) == json_stringify(value), "await cached");
    assert(T.is_ready(future), "readiness cached");
    assert(json_stringify(T.try_await(future)) == json_stringify(value), "poll cached");
    let state = T.await_timeout(future, 0);
    assert(state.ok and json_stringify(state.value) == json_stringify(value), "timeout cached");
}

for value in [nil, false, 0, "", [], map{ok:false,value:nil}, map{__go:true}] {
    let future = T.go(task(value));
    let state = T.await_timeout(future, 1000);
    assert(state.ok and json_stringify(state.value) == json_stringify(value), "nil is completion");
    expect_settled(future, value);
}

for work in [fn(){throw "task";}, fn(){return fn(){return 1;};},
             fn(){return map{nested:[fn(){return 2;}]};},
             fn(){let cycle=[]; array_push(cycle,cycle); return cycle;}] {
    let future = T.go(work);
    assert(T.await_timeout(future, 1000).ok, "failed task is terminal");
    expect_settled(future, nil);
}

// Deterministically complete before polling without consuming the result.
for mode in ["ready", "poll", "await"] {
    let future = T.go(task(nil));
    let deadline = clock() + 2;
    while channel_size(future.__ch.receiver) == 0 and clock() < deadline { sleep_ms(1); }
    assert(channel_size(future.__ch.receiver) > 0, "nil result queued");
    if mode == "ready" { assert(T.is_ready(future), "nil ready"); }
    elif mode == "poll" { assert(T.try_await(future) == nil, "nil poll"); }
    else { assert(T.await(future) == nil, "nil await"); }
    expect_settled(future, nil);
}

let slow = T.go(fn(){sleep_ms(150); return 7;});
assert(not T.await_timeout(slow, 0).ok, "deadline preserves ownership");
assert(not slow.__resolved, "pending future remains pending");
assert(T.await(slow) == 7, "eventual result");
expect_settled(slow, 7);
let eager = T.promise(fn(){return nil;});
assert(T.is_ready(eager) and T.await_timeout(eager, 0).ok, "eager nil unchanged");
assert((try {T.promise(fn(){throw "eager";}); false} catch true), "eager errors unchanged");
let invalid = T.go(123);
assert(T.await_timeout(invalid, 1000).ok, "invalid task resolves as failure");
expect_settled(invalid, nil);
print "thread_future_lifecycle_pass";
