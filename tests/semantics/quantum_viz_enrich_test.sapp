// tests/semantics/quantum_viz_enrich_test.sapp — enrichment for stdlib/quantum_viz.sapp
// bloch_vector (Cartesian), prob_pair, state_to_svg.

let V = import("stdlib/quantum_viz.sapp");

fn fail(m) { throw "FAIL " + m; }
fn approx(a, b, m) { if (a - b) > 0.01 or (b - a) > 0.01 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let inv2 = 0.7071067811865476;

// ── bloch_vector: |0> -> +Z, |1> -> -Z, |+> -> +X ─────────────────────────────────
let z0 = V.bloch_vector([[1.0, 0.0], [0.0, 0.0]]);
approx(z0.z, 1.0, "|0> z=+1"); approx(z0.x, 0.0, "|0> x=0"); approx(z0.y, 0.0, "|0> y=0");

let z1 = V.bloch_vector([[0.0, 0.0], [1.0, 0.0]]);
approx(z1.z, -1.0, "|1> z=-1");

let plus = V.bloch_vector([[inv2, 0.0], [inv2, 0.0]]);
approx(plus.x, 1.0, "|+> x=+1"); approx(plus.z, 0.0, "|+> z=0");

// ── prob_pair ──────────────────────────────────────────────────────────────────────
let pp = V.prob_pair([[inv2, 0.0], [inv2, 0.0]]);
approx(pp[0], 0.5, "p0"); approx(pp[1], 0.5, "p1");

// ── state_to_svg: convenience that returns an SVG string ──────────────────────────
let svg = V.state_to_svg([[1.0, 0.0], [0.0, 0.0]]);
if type(svg) != "string" { fail("state_to_svg returns string"); }
if str_index_of(svg, "<svg") < 0 { fail("state_to_svg has <svg"); }

print "quantum_viz_enrich_pass";
