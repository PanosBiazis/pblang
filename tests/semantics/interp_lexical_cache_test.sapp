let INT = import("stdlib/compiler/interp.sapp");

fn require(condition, message) {
    if not condition { throw "interp lexical cache: " + message; }
}

// Prepared identifiers start unresolved, resolve on first execution, and keep
// the same lexical depth when a reusable AST receives a fresh environment.
let local_ast = INT.compile_program("let x = 41; x; x = x + 1; if x != 42 { missing(); }");
let read_x = local_ast.stmts[1].expr;
let assign_x = local_ast.stmts[2].expr;
require(read_x["@ed"] == -1, "identifier should start unresolved");
require(assign_x["@ed"] == -1, "assignment should start unresolved");
require(INT.eval_ast(local_ast), "first local execution failed");
require(read_x["@ed"] == 0, "local identifier depth should be zero");
require(assign_x["@ed"] == 0, "local assignment depth should be zero");
require(INT.eval_ast(local_ast), "cached local execution failed");

// Closure reads and writes cross multiple lexical environments. Repeated
// calls verify that depth caching preserves captured-state mutation.
let closure_ast = INT.compile_program(
    "fn counter(start) { let value = start; return fn(step) { value = value + step; return value; }; } "
    + "let c = counter(10); if c(2) != 12 { missing(); } if c(3) != 15 { missing(); }"
);
require(INT.eval_ast(closure_ast), "captured assignment failed");
require(INT.eval_ast(closure_ast), "reusable captured assignment failed");

// Shadowing and recursive parent lookup must continue to select the nearest
// lexical binding after cache warmup.
let recursive_ast = INT.compile_program(
    "let n = 99; fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } "
    + "if fib(10) != 55 { missing(); } if n != 99 { missing(); }"
);
require(INT.eval_ast(recursive_ast), "recursive shadowing failed");
require(INT.eval_ast(recursive_ast), "cached recursive shadowing failed");

let undefined_result = try INT.eval_program("missing_name;") catch "undefined";
require(undefined_result == "undefined", "undefined identifier must still throw");

let bad_assign_result = try INT.eval_program("missing_name = 1;") catch "undefined";
require(bad_assign_result == "undefined", "undefined assignment must still throw");

print "interp_lexical_cache_pass";
