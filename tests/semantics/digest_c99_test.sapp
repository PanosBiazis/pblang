let BUILD=import("stdlib:build.sapp");
let DIST=import("stdlib:dist.sapp");
let PROCESS=import("stdlib:process.sapp");
let stamp=str_slice(sha256(str(now_ms())+str(random_bytes(12))),0,20);
let output="/tmp/pblang_digest_c99_"+stamp;
let snapshot_output=output+"_snapshot";
let snapshot=BUILD.smart_build("tests/fixtures/check_good.sapp",snapshot_output,
    map{backend:"c99",goal:"speed",fallback:false,security_mode:"protect"});
let process=PROCESS.bounded_status();
if process.available {
    if not snapshot.ok or snapshot.backend!="c99" or not fs_exists(snapshot_output)
        or snapshot.source_transport!="private-stdin" or not snapshot.atomic_publication {
        throw "digest secure C99 transport failed: "+str(try snapshot.error catch "unknown");
    }
    if not snapshot.execution_admitted or not snapshot.executed
        or snapshot.raw_fallback or not snapshot.process_status.available {
        throw "digest secure C99 transport dropped its admission snapshot";
    }
    let snapshot_run=proc_spawn_wait(snapshot_output,[]); try fs_remove(snapshot_output) catch nil;
    if snapshot_run.exit_code!=0 or snapshot_run.stdout!="1\n" { throw "digest secure C99 transport execution failed"; }
} else {
    if snapshot.ok or snapshot.publication_attempted or snapshot.execution_admitted
        or snapshot.executed or snapshot.raw_fallback or not snapshot.stage_cleanup_verified
        or snapshot.error=="" or snapshot.process_status.available or fs_exists(snapshot_output) {
        throw "digest C99 transport did not fail closed with canonical evidence";
    }
}

let unsupported=DIST.compile_source_c99_blob(
    "let values=[1,2]; for value in values { print value; }",
    "linux-x64",DIST.default_opts());
if unsupported.ok or not unsupported.stage_cleanup_verified
    or type(unsupported.stage_entries_removed)!="number" {
    throw "failed C99 compilation did not verify private-stage cleanup";
}
let unsupported_source=output+"_unsupported.sapp";
let unsupported_output=output+"_unsupported";
fs_write(unsupported_source,"let values=[1,2]; for value in values { print value; }");
let unsupported_smart=BUILD.smart_build(unsupported_source,unsupported_output,
    map{backend:"c99",goal:"speed",fallback:false,security_mode:"protect"});
try fs_remove(unsupported_source) catch nil;
if unsupported_smart.ok or unsupported_smart.publication_attempted
    or not unsupported_smart.stage_cleanup_verified
    or type(unsupported_smart.stage_entries_removed)!="number"
    or fs_exists(unsupported_output) {
    throw "smart C99 failure dropped private-stage cleanup evidence";
}

// The self-hosted hosted-numeric C99 subset does not yet implement the dynamic
// strings, for-in lowering, and exception semantics used by digest.sapp. Keep
// the full known-answer differential on the explicit retained compatibility
// path; smart_build never falls back to it.
if process.available {
    let built=DIST.native("tests/fixtures/digest_c99_entry.sapp",output,
        DIST.default_opts(),"linux-x64");
    if type(built)!="map" or not built.ok or not fs_exists(output){throw "digest retained C99 build failed: "+str(try built.stderr catch "unknown");}
    let ran=proc_spawn_wait(output,[]);try fs_remove(output) catch nil;
    if ran.exit_code!=0 or ran.stdout!="digest_c99_pass\n"{throw "digest C99 differential failed: "+ran.stdout+ran.stderr;}
} else {
    print "digest_c99_differential_skip: canonical bounded process backend unavailable";
}
print "digest_c99_test_pass";
