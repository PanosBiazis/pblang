// tests/semantics/codegen_float_test.sapp — floating-point (SSE2 double) native codegen for
// scientific kernels. Run-verified by emitting a binary that prints f0 as a raw double.

let X = import("stdlib/codegen_x64.sapp");

fn fail(m) { throw "FAIL " + m; }
fn close(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.000001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

fn run_f(ir, tag) {
    let path = "pbf_" + tag + ".bin";
    fs_write_bytes(path, X.build_value_f(ir));
    let r = proc_spawn_wait("bash", ["-c", "chmod +x " + path + " && ./" + path + " | LC_ALL=C od -An -tf8; rm -f " + path]);
    return parse_number(str_trim(try r.stdout catch ""));
}

// (1.5 + 2.5) * 2.0 = 8.0
close(run_f([["fseti", 0, 1.5], ["fseti", 1, 2.5], ["fadd", 0, 1], ["fseti", 1, 2.0], ["fmul", 0, 1]], "a"), 8.0, "float (1.5+2.5)*2");
// 10.0 / 4.0 = 2.5  (real division, the thing integer IR can't do)
close(run_f([["fseti", 0, 10.0], ["fseti", 1, 4.0], ["fdiv", 0, 1]], "b"), 2.5, "float 10/4");
// 3.0 * 0.5 - 0.25 = 1.25
close(run_f([["fseti", 0, 3.0], ["fseti", 1, 0.5], ["fmul", 0, 1], ["fseti", 1, 0.25], ["fsub", 0, 1]], "c"), 1.25, "float 3*0.5-0.25");
// pi-ish constant round-trips through the constant pool
close(run_f([["fseti", 0, 3.14159], ["fseti", 1, 2.0], ["fmul", 0, 1]], "d"), 6.28318, "float pi*2");

print "codegen_float_pass";
