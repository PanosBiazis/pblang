let Broker = import("stdlib:pbide_file_broker_core.sapp");

fn require(value, message) { if not value { throw "FAIL pbide_file_broker_core: " + message; } }
fn hex(ch) { return str_repeat(ch, 64); }

fn request(operation = "save", path = "src/main.sapp") {
    return map{
        format:Broker.REQUEST_FORMAT, request_id:"request-001", operation:operation,
        workspace_handle:"workspace-001", state_handle:"state-001", relative_path:path,
        payload_algorithm:Broker.RAW_SHA256_ALGORITHM, payload_sha256:hex("1"),
        expected_kind:"present", expected_algorithm:Broker.RAW_SHA256_ALGORITHM,
        expected_sha256:hex("2"), input_bytes:32, max_output_bytes:0,
        runtime_algorithm:Broker.RAW_SHA256_ALGORITHM, runtime_sha256:hex("3"),
        bundle_algorithm:Broker.RAW_SHA256_ALGORITHM, bundle_sha256:hex("4"),
        publisher_id:"publisher-001", publisher_key_id:hex("5"), nonce:hex("6"),
        issued_epoch:1000, expires_epoch:1060
    };
}

let save = Broker.plan(request());
require(save.ok and save.operation == "save" and save.relative_path == "src/main.sapp",
    "a bounded save request produces an exact normalized plan");
require(save.request_digest_algorithm == "sha256(raw-bytes)"
    and len(save.request_sha256) == 64 and save.exact_schema and save.digest_algorithms_bound,
    "the plan binds its canonical request to one unambiguous digest contract");
require(not save.execution_enabled and not save.file_effect_enabled
    and save.external_broker_required and not save.production_ready,
    "request planning never grants authority inside the PBIDE VM");

let open = request("open", "notes/today.pb");
open.input_bytes = 0; open.max_output_bytes = 4096;
let open_plan = Broker.plan(open);
require(open_plan.ok and open_plan.operation == "open", "bounded open request is planned");

for operation in ["run", "terminal", "network", "ffi", "overwrite", "delete"] {
    let denied = request(operation);
    require(not Broker.plan(denied).ok, "non-file operation is denied: " + operation);
}

for path in ["/etc/passwd", "../escape", "a/../b", "a//b", "a\\b", "C:/boot.ini",
             "src/maіn.sapp", "same/same/file"] {
    require(not Broker.plan(request("save", path)).ok, "unsafe or ambiguous path is denied");
}
let deep_parts = []; for i 65 { array_push(deep_parts, "d" + str(i)); }
require(not Broker.plan(request("save", str_join(deep_parts, "/"))).ok,
    "path depth is bounded before an external broker can resolve it");

let extra = request(); extra.operator_approved = true;
require(not Broker.plan(extra).ok, "unknown fields cannot smuggle ambient authority");
let forged = request(); forged.publisher_authenticity_verified = true;
require(not Broker.plan(forged).ok, "caller-provided verification claims are outside the schema");
let substituted = request(); substituted.payload_algorithm = "sha256(base64(bytes))";
require(not Broker.plan(substituted).ok, "digest algorithm substitution is denied");
let upper = request(); upper.payload_sha256 = str_repeat("A", 64);
require(not Broker.plan(upper).ok, "non-canonical uppercase digests are denied");

let missing_open = request("open");
missing_open.input_bytes = 0; missing_open.max_output_bytes = 64;
missing_open.expected_kind = "missing"; missing_open.expected_algorithm = "none";
missing_open.expected_sha256 = "";
require(not Broker.plan(missing_open).ok, "open requires a compare-and-swap identity");
let invalid_save_output = request(); invalid_save_output.max_output_bytes = 1;
require(not Broker.plan(invalid_save_output).ok, "save cannot request unrelated output bytes");
let invalid_open_input = request("open"); invalid_open_input.max_output_bytes = 64;
require(not Broker.plan(invalid_open_input).ok, "open cannot carry a write payload");
let expired = request(); expired.expires_epoch = expired.issued_epoch;
require(not Broker.plan(expired).ok, "zero-lifetime requests are denied");
let long_lived = request(); long_lived.expires_epoch = long_lived.issued_epoch + 301;
require(not Broker.plan(long_lived).ok, "request lifetime is capped");
let oversized = request(); oversized.input_bytes = Broker.MAX_INPUT_BYTES + 1;
require(not Broker.plan(oversized).ok, "input size is capped");

let status = Broker.status();
require(status.request_planning and status.open_save_only and status.run_denied
    and not status.execution_enabled and not status.production_ready,
    "status distinguishes a verified planner from an executable broker");
print "pbide_file_broker_core_pass";
