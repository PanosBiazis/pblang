// tests/semantics/formatter_comments_test.sapp
//
// A formatter must NEVER change program meaning. The self-hosted formatter
// (stdlib/compiler/formatter.sapp) ran its operator- and comma-spacing passes
// over comment text too, so it rewrote `//` into `/ /` and `/*` into `/ *` --
// turning comments into (broken) code. This is a semantic-preservation bug.
//
// After formatting:
//   * a `//` line/trailing comment must stay a `//` comment (never `/ /`),
//   * a `/* ... */` block comment (incl. multi-line) must stay intact,
//   * operator/comma normalization of the CODE must still happen, and
//   * the formatted source must still PARSE and RUN to the same result.

let fmt = import("stdlib/compiler/formatter.sapp");
let fe  = import("stdlib/compiler/selfhost_frontend.sapp");

fn fail(m) { throw "FAIL " + m; }

// First printed value of running `src` on the self-hosted VM, or "THREW".
fn runval(src) {
    let r = try fe.frontend_run(src) catch "THREW";
    if r == "THREW" { return "THREW"; }
    if len(r.output) == 0 { return "NOOUT"; }
    return r.output[0];
}

// 1. A trailing line comment must survive and the code must still be normalized.
let f1 = fmt.format_source("let x = 1+2; // sum a+b\nprint x;\n", nil);
if str_contains(f1, "/ /") { fail("line comment '//' was split into '/ /': " + f1); }
if not str_contains(f1, "// sum a+b") { fail("comment text must be preserved verbatim: " + f1); }
if not str_contains(f1, "1 + 2") { fail("code operators must still be normalized: " + f1); }
if runval(f1) != 3 { fail("formatted code must still run to 3, got " + str(runval(f1))); }

// 2. A full-line comment must survive untouched.
let f2 = fmt.format_source("// header: x*y, z-1\nlet y = 5;\nprint y;\n", nil);
if str_contains(f2, "/ /") { fail("full-line comment split: " + f2); }
if not str_contains(f2, "// header: x*y, z-1") { fail("full-line comment text changed: " + f2); }
if runval(f2) != 5 { fail("f2 must run to 5"); }

// 3. An inline block comment must survive; surrounding code still normalized.
let f3 = fmt.format_source("let z = 4 /* a+b,c */ + 6;\nprint z;\n", nil);
if str_contains(f3, "/ *") or str_contains(f3, "* /") { fail("block comment delimiters split: " + f3); }
if not str_contains(f3, "/* a+b,c */") { fail("block comment text changed: " + f3); }
if runval(f3) != 10 { fail("f3 must run to 10, got " + str(runval(f3))); }

// 4. A MULTI-LINE block comment: interior operators must not be rewritten.
let src4 = "/* multi\n line a+b\n done */\nlet w = 7+1;\nprint w;\n";
let f4 = fmt.format_source(src4, nil);
if str_contains(f4, "a + b") { fail("multi-line block comment interior was normalized: " + f4); }
if str_contains(f4, "* /") { fail("multi-line block comment close split: " + f4); }
if runval(f4) != 8 { fail("f4 must run to 8, got " + str(runval(f4))); }

// 5. Idempotence: formatting twice equals formatting once.
let once = fmt.format_source("let a=1+2; // c\nlet b = a*2; /* x-y */ print b;\n", nil);
let twice = fmt.format_source(once, nil);
if once != twice { fail("formatter not idempotent:\nonce=" + once + "\ntwice=" + twice); }

print "formatter_comments_pass";
