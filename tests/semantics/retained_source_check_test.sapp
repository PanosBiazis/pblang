let C=import("stdlib:compiler/retained_source_check.sapp");
for source in ["print 7;","let p=map{run:fn(self){return 7;}};print p:run();",
    "print (try 7 catch 9);","// try import\nprint \"try {p:run()} catch 9 import\";",
    "fn add(x){return x+1;}print add(6);"] {
    assert(C.check(source).ok,"supported source profile");
}
for source in ["for i 1 {let p=map{run:fn(self){return 7;}};print (try {p:run()} catch 9);}",
    "fn f(){let p=map{run:fn(self){return 7;}};return try p.run(p) catch 9;}",
    "fn f(x){return try {try x catch 8} catch 9;}",
    "let f=fn(x){return try x catch 9;};", "if true {print (try 7 catch 9);}",
    "for i 1 {print (try 7 catch {throw 9;});}"] {
    let result=C.check(source);assert(not result.ok and result.code=="retained-nested-try","known and conservative nested try refusal");
}
for source in ["let x=import(\"private_canary\");","let loader=import;","fn f(){return import(\"private_canary\");}"] {
    let result=C.check(source);assert(not result.ok and result.code=="retained-unchecked-import","dependency coverage fails closed");
    assert(not str_contains(result.message,"private_canary"),"no source text in diagnostic");
}
for source in [nil,7,"","print 7; /* secret",str_repeat(" ",1048577)] {
    let result=C.check(source);assert(not result.ok and result.code=="retained-invalid-source","invalid source admission");
}
let deep="0";for _i 140 {deep="["+deep+"]";}
assert(C.check("let nested="+deep+";").code=="retained-scan-limit","iterative scan depth budget");
print "retained_source_check_pass";
