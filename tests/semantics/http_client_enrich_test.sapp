// tests/semantics/http_client_enrich_test.sapp — fixes + enrichment for http_client
//
// FIXES:
//  * build_query_string did NOT url-encode (k + "=" + v) -> parameter INJECTION
//    and broken queries on &, =, space (same class as the http.sapp fix).
//  * parse_response split the raw response on EVERY "\r\n\r\n", so a body that
//    itself contains a blank line was TRUNCATED to the first chunk.
// ENRICHMENT:
//  * list-valued query params, encode_form / post_form (x-www-form-urlencoded),
//    case-insensitive header_get, and status_text on the parsed response.

let hc = import("stdlib/http_client.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── FIX: query encoding (no injection) ──────────────────────────────────────────
let qs = hc.build_query_string(map{ q: "a b&x=1" });
if not str_starts_with(qs, "?") { fail("query string keeps leading '?': " + qs); }
if str_contains(qs, "&x=1") { fail("parameter injection in query: " + qs); }
if str_index_of(qs, "%26") < 0 { fail("'&' must be encoded: " + qs); }
if str_index_of(qs, "%20") < 0 { fail("space must be encoded: " + qs); }
eq(hc.build_query_string(nil), "", "nil params -> empty");
eq(hc.build_query_string(map{}), "", "empty params -> empty");

// ── ENRICH: encode_form + list values ───────────────────────────────────────────
let form = hc.encode_form(map{ name: "a b", tag: ["x", "y"] });
if str_contains(form, "a b") { fail("form value must be encoded: " + form); }
// two "tag=" occurrences (list value)
fn count_sub(s, sub) {
    let n = 0; let start = 0;
    while true {
        let rest = str_slice(s, start, len(s));
        let j = str_index_of(rest, sub);
        if j < 0 { break; }
        n = n + 1; start = start + j + len(sub);
    }
    return n;
}
eq(count_sub(form, "tag="), 2, "list value -> repeated keys");

// ── FIX: parse_response keeps a body containing blank lines intact ──────────────
let raw = "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n\r\n<html>\r\n\r\nmore</html>";
let resp = hc.parse_response(raw);
eq(resp.status, 200, "status parsed");
eq(resp.body, "<html>\r\n\r\nmore</html>", "body with blank line not truncated");
eq(resp.ok, true, "2xx is ok");

// ── ENRICH: status_text ─────────────────────────────────────────────────────────
eq(hc.parse_response("HTTP/1.1 404 Not Found\r\n\r\nx").status_text, "Not Found", "status_text parsed");

// ── ENRICH: case-insensitive header_get ─────────────────────────────────────────
eq(hc.header_get(resp, "content-type"), "text/html", "header_get is case-insensitive");
eq(hc.header_get(resp, "X-Missing"), nil, "missing header -> nil");

print "http_client_enrich_pass";
