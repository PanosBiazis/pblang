let sci = import("stdlib:science.sapp");

let km = sci.convert(2, "km", "m");
assert(km.ok and km.value == 2000, "km to m conversion");

let ev = sci.convert(1, "eV", "J");
assert(ev.ok and ev.value == sci.E_CHARGE, "eV to J conversion");

assert(sci.vector.dot([1, 2, 3], [4, 5, 6]) == 32, "vector dot product");
assert(sci.vector.distance([0, 0], [3, 4]) == 5, "vector distance");

let mot = sci.physics.linear_motion(0, 10, 2, 3);
assert(mot.x == 39 and mot.v == 16, "linear motion");
assert(sci.physics.kinetic_energy(2, 3) == 9, "kinetic energy");
assert(sci.physics.wavelength(299792458) == 1, "light wavelength");

assert(sci.chemistry.moles_from_mass(18, 18) == 1, "moles from mass");
assert(sci.chemistry.concentration_molar(2, 4) == 0.5, "molar concentration");
assert(sci.chemistry.h_from_ph(7) == 0.0000001, "hydrogen concentration from pH");

let c = sci.geometry.centroid([[0, 0], [2, 2], [4, 4]]);
assert(c[0] == 2 and c[1] == 2, "centroid");
let bb = sci.geometry.bounding_box([[2, 5], [-1, 3], [4, 9]]);
assert(bb.min[0] == -1 and bb.max[1] == 9, "bounding box");

let ma = sci.signal.moving_average([1, 2, 3, 4], 2);
assert(ma[0] == 1 and ma[1] == 1.5 and ma[3] == 3.5, "moving average");
let der = sci.signal.derivative([1, 4, 9], 1);
assert(der[0] == 3 and der[1] == 5, "derivative");
assert(sci.signal.integrate_trapezoid([0, 2, 4], 1) == 4, "trapezoid integration");

let exp = sci.experiment("fall", ["t", "x"], [[0, 0], [1, 4.9], [2, 19.6]]);
let xs = sci.column(exp, "x");
assert(len(xs) == 3 and xs[2] == 19.6, "experiment column extraction");

print "science_stdlib_pass";
