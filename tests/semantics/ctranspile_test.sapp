// Test: stdlib/compiler/ctranspile.sapp — the self-hosted pblang→C transpiler
// (seed of the freestanding/OS-dev backend). Verifies the generated C for the
// supported numeric subset (functions, arithmetic, comparison, if/while, return).

let ct = import("stdlib/compiler/ctranspile.sapp");

// --- A simple arithmetic function ---
let c1 = ct.transpile("fn add(a, b) { return a + b; }");
assert(str_contains(c1, "double add(double a, double b)"), "function signature with double params/return");
assert(str_contains(c1, "return (a + b);"), "arithmetic return lowered to C");

// --- Recursion + if ---
let c2 = ct.transpile("fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); }");
assert(str_contains(c2, "double fib(double n)"), "fib signature");
assert(str_contains(c2, "if ((n < 2))"), "if condition lowered");
assert(str_contains(c2, "return (fib((n - 1)) + fib((n - 2)));"), "recursive call lowered");

// --- while loop + local vars + assignment ---
let c3 = ct.transpile("fn count(n) { let s = 0; let i = 0; while i < n { s = s + i; i = i + 1; } return s; }");
assert(str_contains(c3, "double s = 0;"), "local declared as double");
assert(str_contains(c3, "while ((i < n))"), "while condition lowered");
assert(str_contains(c3, "s = (s + i);"), "assignment lowered");
assert(str_contains(c3, "i = (i + 1);"), "increment lowered");

// --- Comparison + boolean ---
let c4 = ct.transpile("fn cmp(a, b) { if a > b { return 1; } return 0; }");
assert(str_contains(c4, "if ((a > b))"), "greater-than lowered");

// --- The output is a valid C translation unit (header comment, brace-balanced) ---
assert(str_contains(c1, "generated by"), "header comment present");

// --- Expression-level lowering directly ---
let e = ct.transpile_expr(map{ kind: "binary", op: "*", left: map{ kind: "ident", name: "x" }, right: map{ kind: "number", value: 3 } });
assert(e == "(x * 3)", "transpile_expr lowers a binary node");

// --- Deepened subset: logical operators ---
let c5 = ct.transpile("fn both(a, b) { if a > 0 and b > 0 { return 1; } return 0; }");
assert(str_contains(c5, "((a > 0) && (b > 0))"), "logical 'and' lowers to C &&");
let c5b = ct.transpile("fn either(a, b) { if a > 0 or b > 0 { return 1; } return 0; }");
assert(str_contains(c5b, "||"), "logical 'or' lowers to C ||");

// --- Bitwise operators lower to C integer ops (essential for OS code) ---
let c6 = ct.transpile("fn mask(a, b) { return (a & 240) | b; }");
assert(str_contains(c6, "(long)a & (long)240"), "bitwise & lowers with long casts");
assert(str_contains(c6, "| (long)b"), "bitwise | lowers");
let c6b = ct.transpile("fn shifted(x) { return x << 4; }");
assert(str_contains(c6b, "<< (long)4"), "shift lowers");
let c6c = ct.transpile("fn modulo(a, b) { return a % b; }");
assert(str_contains(c6c, "(long)a % (long)b"), "modulo lowers to integer %");

// --- for-count loop lowers to a C for-loop ---
let c7 = ct.transpile("fn sumloop(n) { let s = 0; for i n { s = s + i; } return s; }");
assert(str_contains(c7, "for (double i = 0; i < (n); i = i + 1)"), "for-count lowers to C for");

// --- else-if chain ---
let c8 = ct.transpile("fn cls(x) { if x < 0 { return 0; } else if x == 0 { return 1; } else { return 2; } }");
assert(str_contains(c8, "(x == 0)"), "else-if branch lowered");

// --- Freestanding profile: no-libc preamble with OS intrinsics ---
let kc = ct.transpile_freestanding("fn putc(c) { outb(1016, c); } fn khalt() { cli(); hlt(); }");
assert(str_contains(kc, "ffreestanding"), "freestanding header notes the compile flags");
assert(str_contains(kc, "outb") and str_contains(kc, "__asm__ volatile"), "inline-asm port-I/O intrinsic present");
assert(str_contains(kc, "hlt") and str_contains(kc, "cli") and str_contains(kc, "sti"), "halt/interrupt intrinsics present");
assert(str_contains(kc, "double putc(double c)"), "kernel function transpiled into the unit");
assert(not str_contains(kc, "#include"), "freestanding output has NO libc includes");

// --- Bootable kernel profile: multiboot header + _start + GC-free allocator ---
// (The generated kernel is validated by an actual QEMU boot offline: it computes
//  40+2 through the bump allocator/memory/arith and exits QEMU with code 85.)
let kern = ct.transpile_kernel("fn kmain() { let p = kmalloc(64); poke8(p, 65); outb(244, peek8(p)); while 1 > 0 { hlt(); } }");
assert(str_contains(kern, "0x1BADB002"), "multiboot magic header present");
assert(str_contains(kern, "section(\".multiboot\")"), "multiboot section attribute present");
assert(str_contains(kern, "_start") and str_contains(kern, "call kmain"), "_start entry calls kmain");
assert(str_contains(kern, "kmalloc") and str_contains(kern, "_kheap"), "GC-free bump allocator over a static heap");
assert(str_contains(kern, "poke8") and str_contains(kern, "peek8"), "raw memory access intrinsics");
assert(str_contains(kern, "outb") and str_contains(kern, "hlt"), "OS port-I/O + halt intrinsics");
assert(str_contains(kern, "double kmain(") , "user kmain transpiled into the kernel unit");
assert(not str_contains(kern, "#include"), "kernel output has NO libc includes");

// --- Linker script ---
let ld = ct.kernel_linker_script();
assert(str_contains(ld, "ENTRY(_start)"), "linker script sets the entry point");
assert(str_contains(ld, ". = 1M;"), "kernel loaded at 1 MiB");
assert(str_contains(ld, "*(.multiboot)"), "multiboot header placed first");

// --- Data structures lowered onto the bump allocator (QEMU-validated offline) ---
// Array literal → length-prefixed kmalloc'd block; index read/write; len; strings.
let arrk = ct.transpile_kernel("fn kmain() { let a = [10, 20, 12]; let s = 0; let i = 0; while i < len(a) { s = s + a[i]; i = i + 1; } a[0] = 99; outb(244, s); }");
assert(str_contains(arrk, "kmalloc(32)"), "array literal [10,20,12] allocates (3+1)*8 bytes");
assert(str_contains(arrk, "_a[0]=3"), "array stores its length in slot 0");
assert(str_contains(arrk, "_a[1]=10"), "array stores element 0 after the length prefix");
assert(str_contains(arrk, "((double*)(u64)(a))[1 + (long)(i)]"), "index read offsets past the length prefix");
assert(str_contains(arrk, "((double*)(u64)(a))[0]"), "len(a) reads the length prefix");
assert(str_contains(arrk, "((double*)(u64)(a))[1 + (long)(0)] = 99"), "index write lowered");

// String literal → null-terminated char block on the allocator.
let strk = ct.transpile_kernel("fn kmain() { let m = \"OK\"; outb(1016, peek8(m)); }");
assert(str_contains(strk, "char* _s = (char*)(u64)kmalloc(3)"), "string 'OK' allocates len+1 bytes");
assert(str_contains(strk, "_s[0]=79") and str_contains(strk, "_s[1]=75"), "string chars stored (O=79, K=75)");
assert(str_contains(strk, "_s[2]=0"), "string is null-terminated");

// --- Struct/map field-layout pass (QEMU-validated offline: Pt(3,4).x+.y → exit 85) ---
let structk = ct.transpile_kernel("struct Pt { x: number, y: number } fn kmain() { let p = Pt(3, 4); let s = p.x + p.y; p.x = 100; outb(244, s); }");
assert(str_contains(structk, "double* _m = (double*)(u64)kmalloc"), "struct/map literal allocates a block");
assert(str_contains(structk, "((double*)(u64)(p))["), "member access reads a fixed slot");
assert(str_contains(structk, "] = 100;"), "member assignment lowered to a slot store");
// member-read consistency: p.x and p.y use distinct, stable slots
assert(str_contains(structk, "((double*)(u64)(p))[1]") or str_contains(structk, "((double*)(u64)(p))[2]"), "fields map to distinct slots");

print "ctranspile_pass";
