// tests/semantics/selfhost_loop_kw_test.sapp
//
// `loop` in the self-hosted frontend, matching the Rust grammar:
//
//   1. `loop { ... }` statement — infinite loop, `break` exits (parser.rs:605).
//      Desugars here to `while true { ... }` (same semantics, no new VM node).
//   2. `loop` as a contextual IDENTIFIER when NOT followed by `{` — the Rust
//      frontend accepts `let loop = ...; loop.x = ...; return loop;` (pbai.sapp
//      think() binds its brain-loop result to `loop`), verified against the
//      Rust VM which runs that shape today.

let fe = import("stdlib/compiler/selfhost_frontend.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }
fn errs(r) { return try str(r.errors) catch "(no errors key)"; }

// ── 1. loop statement with break ─────────────────────────────────────────────
let src1 = ""
    + "let n = 0;\n"
    + "loop {\n"
    + "    n = n + 1;\n"
    + "    if n >= 5 { break; }\n"
    + "}\n";
let r1 = try fe.frontend_run(src1) catch map{ ok: false, errors: ["frontend threw"] };
truthy(r1.ok, "loop stmt parses and runs: " + errs(r1));
eq(r1.globals["n"], 5, "loop counts to 5 then breaks");

// Rust-VM reference for the same shape (differential guard):
let ref_n = 0;
loop {
    ref_n = ref_n + 1;
    if ref_n >= 5 { break; }
}
eq(r1.globals["n"], ref_n, "self-host loop agrees with the Rust VM");

// ── 2. loop as identifier (pbai.sapp think() shape) ──────────────────────────
let src2 = ""
    + "fn think() {\n"
    + "    let loop = map{ answer: 0 };\n"
    + "    loop.answer = 41;\n"
    + "    loop = map{ answer: loop.answer + 1 };\n"
    + "    return loop;\n"
    + "}\n"
    + "let got = think().answer;\n";
let r2 = try fe.frontend_run(src2) catch map{ ok: false, errors: ["frontend threw"] };
truthy(r2.ok, "let loop / loop.x = / loop = parse and run: " + errs(r2));
eq(r2.globals["got"], 42, "loop-named binding works end to end");

// ── 3. print statement inside a bare block expression ────────────────────────
// examples/thread_pool/main.sapp wraps its whole body in `{ ... }` so spawned
// workers capture upvalues; `print` inside that block must parse as the print
// STATEMENT (the Rust frontend runs the example today).
let src3 = ""
    + "let seen = 0;\n"
    + "{\n"
    + "    let x = 40 + 2;\n"
    + "    print \"block says \" + str(x);\n"
    + "    seen = x;\n"
    + "}\n";
let r3 = try fe.frontend_run(src3) catch map{ ok: false, errors: ["frontend threw"] };
truthy(r3.ok, "print inside block-expr parses: " + errs(r3));
eq(r3.globals["seen"], 42, "block body after print still runs");

print "selfhost_loop_kw_pass";
