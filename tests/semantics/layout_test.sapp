// tests/semantics/layout_test.sapp — pblang-native browser flow-layout engine.

let L = import("stdlib/layout.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── wrap_text: greedy word wrap to a char budget ──────────────────────────────────
let lines = L.wrap_text("the quick brown fox", 9);
eq(lines[0], "the quick", "wrap line 0");           // "the quick" = 9 chars
if len(lines) < 2 { fail("should wrap to >=2 lines"); }
eq(len(L.wrap_text("", 10)), 0, "empty -> no lines");
eq(len(L.wrap_text("supercalifragilistic", 5)), 1, "oversized word keeps its own line");

// ── flow: vertical block layout with positioned boxes ─────────────────────────────
let blocks = [
    map{ kind: "title", text: "Hello" },
    map{ kind: "p", text: "the quick brown fox jumps over the lazy dog again" },
    map{ kind: "img", text: "a picture", src: "pic.png" },
];
let r = L.flow(blocks, map{ width: 120, pad: 4, gap: 4 });
eq(len(r.boxes), 3, "three boxes");
eq(r.boxes[0].kind, "title", "first box is title");
eq(r.boxes[0].x, 4, "left = pad");
eq(r.boxes[0].y, 4, "top = pad");

// blocks stack downward
if r.boxes[1].y <= r.boxes[0].y { fail("p below title"); }
if r.boxes[2].y <= r.boxes[1].y { fail("img below p"); }

// the paragraph wrapped into multiple lines (content width 112, char_w 6 -> ~18 chars)
if len(r.boxes[1].lines) < 2 { fail("paragraph wrapped: " + str(r.boxes[1].lines)); }
eq(r.boxes[1].h, len(r.boxes[1].lines) * r.boxes[1].line_h, "p height = lines * line_h");

// image box: fixed height, carries src
eq(r.boxes[2].kind, "img", "img box");
eq(r.boxes[2].src, "pic.png", "img src preserved");

// total height reaches past the last box
if r.height < r.boxes[2].y + r.boxes[2].h { fail("height covers all boxes"); }

// ── hit_test: which box contains a point ──────────────────────────────────────────
let hit = L.hit_test(r.boxes, 10, r.boxes[1].y + 1);
eq(hit.kind, "p", "hit-test lands on the paragraph box");
eq(L.hit_test(r.boxes, 9999, 9999), nil, "miss -> nil");

print "layout_pass";
