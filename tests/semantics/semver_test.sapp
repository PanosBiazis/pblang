// tests/semantics/semver_test.sapp — stdlib/semver.sapp
import "stdlib:semver.sapp";
let sv = semver;

// parse
let v = sv.parse("1.4.2-rc.1+build.9");
if v.major != 1 or v.minor != 4 or v.patch != 2 { throw "FAIL parse core: " + str(v); }
if v.prerelease != "rc.1" { throw "FAIL parse pre: " + v.prerelease; }
if v.build != "build.9" { throw "FAIL parse build: " + v.build; }
if sv.parse("v2.0.0").major != 2 { throw "FAIL parse v-prefix"; }
if sv.parse("1.2") != nil { throw "FAIL parse incomplete should be nil"; }
if sv.parse("1.2.x") != nil { throw "FAIL parse non-numeric should be nil"; }
if sv.valid("1.0.0") == false { throw "FAIL valid"; }
if sv.valid("nope") { throw "FAIL valid negative"; }

// format round-trip
if sv.format(sv.parse("1.4.2-rc.1+build.9")) != "1.4.2-rc.1+build.9" { throw "FAIL format"; }

// compare: numeric not lexical (1.2.0 < 1.10.0)
if sv.compare("1.2.0", "1.10.0") != 0 - 1 { throw "FAIL compare numeric"; }
if sv.compare("2.0.0", "1.9.9") != 1 { throw "FAIL compare major"; }
if sv.compare("1.2.3", "1.2.3") != 0 { throw "FAIL compare eq"; }

// prerelease precedence: 1.0.0-alpha < 1.0.0-alpha.1 < 1.0.0-beta < 1.0.0
if sv.lt("1.0.0-alpha", "1.0.0-alpha.1") == false { throw "FAIL pre alpha<alpha.1"; }
if sv.lt("1.0.0-alpha.1", "1.0.0-beta") == false { throw "FAIL pre alpha.1<beta"; }
if sv.lt("1.0.0-beta", "1.0.0") == false { throw "FAIL pre beta<release"; }
// numeric identifier < alphanumeric
if sv.lt("1.0.0-1", "1.0.0-alpha") == false { throw "FAIL pre numeric<alpha"; }

// helpers
if sv.gt("1.2.4", "1.2.3") == false { throw "FAIL gt"; }
if sv.gte("1.2.3", "1.2.3") == false { throw "FAIL gte"; }
if sv.eq("1.0.0", "1.0.0") == false { throw "FAIL eq"; }

// inc
if sv.format(sv.inc("1.2.3", "minor")) != "1.3.0" { throw "FAIL inc minor"; }
if sv.format(sv.inc("1.2.3", "major")) != "2.0.0" { throw "FAIL inc major"; }
if sv.format(sv.inc("1.2.3", "patch")) != "1.2.4" { throw "FAIL inc patch"; }

// satisfies
if sv.satisfies("1.4.2", "^1.2.0") == false { throw "FAIL ^ in range"; }
if sv.satisfies("2.0.0", "^1.2.0") { throw "FAIL ^ out of range"; }
if sv.satisfies("0.2.5", "^0.2.0") == false { throw "FAIL ^0.2 in range"; }
if sv.satisfies("0.3.0", "^0.2.0") { throw "FAIL ^0.2 out of range"; }
if sv.satisfies("1.2.9", "~1.2.0") == false { throw "FAIL ~ in range"; }
if sv.satisfies("1.3.0", "~1.2.0") { throw "FAIL ~ out of range"; }
if sv.satisfies("1.5.0", ">=1.2.0") == false { throw "FAIL >="; }
if sv.satisfies("1.1.0", ">=1.2.0") { throw "FAIL >= negative"; }
if sv.satisfies("1.2.0", ">1.2.0") { throw "FAIL > strict"; }
if sv.satisfies("1.0.0", "<2.0.0") == false { throw "FAIL <"; }
if sv.satisfies("1.2.3", "1.2.3") == false { throw "FAIL exact"; }
if sv.satisfies("1.2.4", "1.2.3") { throw "FAIL exact negative"; }
if sv.satisfies("9.9.9", "*") == false { throw "FAIL wildcard"; }

print "semver_pass";
