let B = import("stdlib:resource_budget.sapp");

assert(len(B.metrics()) == 13, "stable known resource metrics");
let interactive = B.profile("interactive");
let normal = B.evaluate(interactive, B.usage(map{ elapsed_ms: 1000, memory_bytes: 1048576, workers: 2, frame_ms: 10 }));
assert(normal.allowed and normal.pressure == "nominal", "normal interactive workload admitted");

let hot = B.evaluate(interactive, B.usage(map{ frame_ms: 32 }));
assert(hot.allowed and hot.pressure == "critical", "near-limit frame time creates critical backpressure");

let denied = B.evaluate(B.profile("untrusted"), B.usage(map{ network_bytes: 1, workers: 99 }));
assert(not denied.allowed and denied.pressure == "blocked", "untrusted network and worker overflow denied");
assert(len(denied.violations) == 2, "all violated metrics are reported");
let actions = B.adaptive_plan(denied).actions;
assert(str_contains(str_join(actions, "\n"), "workers") and str_contains(str_join(actions, "\n"), "output"), "adaptive actions cover worker and byte pressure");
let typo = B.evaluate(interactive, B.usage(map{ memroy_bytes: 1 }));
assert(not typo.allowed and str_starts_with(typo.violations[0].metric, "unknown-usage:"), "unknown usage metric fails closed instead of being ignored");
let bad_limit = B.evaluate(B.budget("bad", map{ itemz: 5 }), B.usage(map{}));
assert(not bad_limit.allowed and bad_limit.pressure == "blocked", "unknown budget limit fails closed");

let b = B.budget("queue", map{ items: 10, output_bytes: 100 });
let accepted = B.reserve(b, B.usage(map{ items: 4 }), B.usage(map{ items: 5 }));
assert(accepted.accepted and accepted.next.items == 9, "transactional reservation accepted within budget");
let rejected = B.reserve(b, B.usage(map{ items: 9 }), B.usage(map{ items: 2 }));
assert(not rejected.accepted and rejected.next.items == 9, "rejected reservation leaves current usage unchanged");
let unknown_reservation = B.reserve(b, B.usage(map{}), B.usage(map{ itemz: 1 }));
assert(not unknown_reservation.accepted, "reservation preserves unknown-metric rejection");

let measured = B.measure("small", B.budget("measurement", map{ elapsed_ms: 1000, allocations: 10000 }), fn() { return [1, 2, 3]; });
assert(measured.format == "pblang.resource_budget.measurement.v1", "resource measurement is versioned");
assert(measured.evaluation.allowed, "small measured operation fits budget");
print "resource_budget_pass";
