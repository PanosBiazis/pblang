// Slot allocation counts unique names before adding private compiler metadata.
let A=import("stdlib:codegen_arm64_ast.sapp");
let R=import("tests/fixtures/arm64_execution_reference.sapp");
let cases=[
    "fn f(x){let y=1;if x {let z=2;}else{let z=3;}return x+y+z;}return f(1);",
    "fn f(x){let x=7;let y=0;while y<2{let z=3;y=y+1;}return x+y+z;}return f(1);",
    "fn f(a,b,c,d,e,f,g,h,i){let z=1;if i{let q=2;}return a+i+z+q;}return f(1,2,3,4,5,6,7,8,9);"
];
let expected=[4,12,13];
for i in range(0,len(cases)) {
    let result=R.arm64_run(A.compile_ast(cases[i]));
    assert(result.exit==expected[i] and result.out=="","unique slots across parameters and nested declarations");
}
print "arm64_slot_identity_pass";
