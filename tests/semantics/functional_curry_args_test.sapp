let F = import("stdlib:functional.sapp");
let G = import("stdlib:generics.sapp");
let C = import("stdlib:class.sapp");
fn expect(ok, label) { if not ok { throw "FAIL curry-args: " + label; } }
let effects = [0];
let callback = fn(args) { effects[0] = effects[0] + 1; return args; };
for n in [-1, 0.5, 257, "5", true, nil, [], map{}] {
    let r = try map{ ok: true, value: F.curry_args(callback, n) } catch map{ ok: false };
    expect(not r.ok and effects[0] == 0, "invalid vector arity rejected before effects");
}
expect(F.curry_args(callback, 0) == [] and effects[0] == 1, "zero arity passes empty vector immediately");
let pending = F.curry_args(callback, 5)(1)(2)(3)(4);
expect(effects[0] == 1, "callback deferred until final argument");
expect(pending(5) == [1, 2, 3, 4, 5] and effects[0] == 2, "all arguments preserved in order");
let branch = F.curry_args(callback, 3)(1);
let first = branch(2)(3);
first[0] = 99;
expect(branch(4)(5) == [1, 4, 5], "returned vector mutation cannot overwrite saved prefix");
let mixed = F.curry_args(callback, 5)(nil)(true)("π")([7])(map{ x: 8 });
expect(mixed == [nil, true, "π", [7], map{ x: 8 }], "heterogeneous arguments preserved");
let full = F.curry_args(fn(xs) { return [len(xs), xs[0], xs[255]]; }, 256);
for i 256 { full = full(i); }
expect(full == [256, 0, 255], "256 argument boundary");

let calls = [0];
let retry = F.curry_args(fn(xs) { calls[0] = calls[0] + 1; if calls[0] == 1 { throw 4; } return xs; }, 2)(7);
let rejected = try map{ ok: true, value: retry(8) } catch map{ ok: false };
expect(not rejected.ok and retry(9) == [7, 9], "throw propagates without consuming saved prefix");

let Reducer = C.define("Reducer", [], map{
    apply: fn(self, xs) { return F.sum(G.assert_type(G.T_list_of(G.T_number()), xs)); }
});
let obj = C.new(Reducer);
let reduce = F.curry_args(C.bind1(obj, "apply"), 5);
expect(reduce(1)(2)(3)(4)(5) == 15, "object bound method plus generic validation and functional reduction");
let invalid = try map{ ok: true, value: reduce(1)(2)("bad")(4)(5) } catch map{ ok: false };
expect(not invalid.ok, "mixed composition rejects invalid element type");
print "functional_curry_args_pass";
