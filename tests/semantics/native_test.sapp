// tests/semantics/native_test.sapp — the "native mode" facility any pblang library can call:
// pick the host-arch backend, compile the IR to a real binary, run it, get the result. This
// is how libraries opt into native execution on the actual hardware instead of the VM.

let NA = import("stdlib/native.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

eq(NA.supported(), true, "host arch has a native backend");
let a = NA.host_arch();
if a != "x86_64" and a != "i386" and a != "arm64" { fail("host_arch unexpected: " + a); }

// a library computing on the bare CPU: sum 1..10 = 55, run as native machine code
eq(NA.run([["seti", 0, 0], ["seti", 1, 10], ["loop", 1, [["add", 0, 1]]]]), 55, "native loop sum");
// arithmetic
eq(NA.run([["seti", 0, 7], ["addi", 0, 35]]), 42, "native arithmetic");

print "native_pass";
