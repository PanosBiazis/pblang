// tests/semantics/nn_topology_test.sapp — structural NN ideas:
//   onion (nested wrap/peel), matryoshka/babuska (nested-capacity views),
//   jenga (safe neuron pruning), origami (fold = inverse of split),
//   nail shells (protective snapshots you can restore / roll back).

let nn = import("stdlib/nn.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.00001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn veq(a, b, m) { if len(a) != len(b) { fail(m + " length"); } let i = 0; while i < len(a) { approx(a[i], b[i], m + "[" + str(i) + "]"); i = i + 1; } }

let data = [ nn.sample([0, 0], [0]), nn.sample([0, 1], [1]), nn.sample([1, 0], [1]), nn.sample([1, 1], [0]) ];
let x = [1, 0];
let net = nn.mlp_new(2, 5, 1, 7);
let y0 = nn.predict(net, x);

// ── ONION: nested wrap / peel, immutable ──────────────────────────────────────────
let o1 = nn.onion_new("core");
let o2 = nn.onion_wrap(o1, "a");
let o3 = nn.onion_wrap(o2, "b");
eq(nn.onion_depth(o3), 3, "onion depth after two wraps");
eq(nn.onion_core(o3), "core", "onion core is the innermost");
eq(nn.onion_depth(o1), 1, "wrap did not mutate the original onion");
let pl = nn.onion_peel(o3);
eq(pl.removed, "b", "peel returns the outermost");
eq(nn.onion_depth(pl.onion), 2, "peel reduces depth by one");

// ── MATRYOSHKA (babuska): nested-capacity sub-models ──────────────────────────────
veq(nn.predict(nn.matryoshka(net, 5), x), y0, "matryoshka at full size == original");
let mk = nn.matryoshka(net, 2);
eq(mk.l1.n_out, 2, "matryoshka shrinks the hidden layer");
eq(mk.l2.n_in, 2, "matryoshka shrinks l2 input");
eq(len(nn.predict(mk, x)), 1, "matryoshka sub-model still predicts");
let sizes = nn.matryoshka_sizes(net, 2);
eq(sizes[len(sizes) - 1], 5, "matryoshka_sizes ends at full size");

// ── JENGA: pull the least-important neuron without toppling ────────────────────────
let imp = nn.neuron_importance(net);
eq(len(imp), 5, "importance has one score per hidden neuron");
let jp = nn.jenga_pull(net);
eq(jp.net.l1.n_out, 4, "jenga_pull removes one neuron");
// it removes the MINIMUM-importance neuron
let mini = 0; let i = 1; while i < len(imp) { if imp[i] < imp[mini] { mini = i; } i = i + 1; }
eq(jp.removed, mini, "jenga_pull removes the least-important neuron");
// safe pull never raises loss beyond tolerance
let sp = nn.jenga_safe_pull(net, data, 0.05);
if nn.loss(sp.net, data) > nn.loss(net, data) + 0.05 + 0.00001 { fail("jenga_safe_pull stays within tolerance"); }

// ── ORIGAMI: fold inverts split (function-preserving round trip) ──────────────────
let widened = nn.split_neuron(net, 0);                       // 6 neurons, neuron 0 duplicated at the end
let folded = nn.origami_fold(widened, 0, widened.l1.n_out - 1);
eq(folded.l1.n_out, net.l1.n_out, "origami fold restores the original size");
veq(nn.predict(folded, x), y0, "origami fold(split(net)) preserves the function");

// ── NAIL SHELLS: protective snapshots + restore / roll back ────────────────────────
let snap = nn.nail(net);
let work = nn.clone(net);
nn.train(work, data, 40, 0.5);                              // work drifts away
veq(nn.predict(nn.restore(snap), x), y0, "restore returns to the nailed state");
let shells = nn.drive(nn.drive(nn.nails_new(), net), work);
eq(nn.shell_depth(shells), 2, "two protective shells driven");
let popped = nn.pull(shells);
eq(nn.shell_depth(popped.nails), 1, "pull removes the outer shell");
veq(nn.predict(popped.shell, x), nn.predict(work, x), "pulled shell is the last driven state");

print "nn_topology_pass";
