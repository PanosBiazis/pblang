let A = import("stdlib:async.sapp");
let tasks = [
    fn(){ return fn(){return 1;}; },
    fn(){ return map{nested:[fn(){return 2;}]}; },
    fn(){ let cycle=[]; array_push(cycle,cycle); return cycle; }
];
for task in tasks {
    let future = A.go(task);
    let start = clock();
    let state = A.await_timeout(future, 1000);
    assert(state.ready and not state.ok, "transfer failure is terminal");
    assert((clock()-start)*1000 < 900, "no wait for an absent result");
    assert(future.resolved, "failed worker joined");
    assert(channel_is_closed(future.channel.receiver), "failed channel closed");
    assert(channel_size(future.channel.receiver) == 0, "no queued payload");
    assert((try { A.await(future); false } catch true), "failure cached");
    assert(not A.all_settled([future,future])[1].ok, "repeated settled failure");
}
let direct = A.go(tasks[0]);
let start = clock();
assert((try { A.await(direct); false } catch true), "direct await failure");
assert((clock()-start)*1000 < 900, "direct await wakes promptly");
let failed = A.go(tasks[0]);
let slow = A.go(fn(){sleep_ms(600);return 9;});
start = clock();
assert((try { A.await_race([slow,failed]); false } catch true), "race surfaces failure");
assert((clock()-start)*1000 < 500, "race does not wait for unrelated slow work");
assert(A.await(slow) == 9, "caller reaps race loser");
assert((try { A.gather(tasks); false } catch true), "gather drains transfer failures");
for value in [nil,false,0,"",[],map{ok:false,value:nil}] {
    fn make_task(v) { return fn(){return v;}; }
    let f=A.go(make_task(value));
    assert(json_stringify(A.await(f)) == json_stringify(value), "valid values unchanged");
}
print "async_transfer_failure_pass";
