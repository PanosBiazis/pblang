let WebView = import("stdlib:android_webview.sapp");

let generated = WebView.generate("Loopback Test", map{
    package:"org.pblang.loopbacktest", url:"http://127.0.0.1:8766/",
    min_sdk:21, target_sdk:34, version:"1.0.0", version_code:1
});
assert(generated.format == "pblang.modern-ui.android.v1", "WebView generator integrates with the Android toolchain");
assert(generated.runtime == "pblang-loopback-webview" and generated.url == "http://127.0.0.1:8766/", "WebView runtime remains loopback-bound");
assert(len(generated.class_bytes) > 256 and generated.class_bytes[0] == 202 and generated.class_bytes[1] == 254, "WebView generator emits a JVM class file");
assert(str_contains(generated.manifest, "android.permission.INTERNET"), "WebView app requests only the required network permission");
assert(str_contains(generated.manifest, "android:allowBackup=\"false\""), "WebView manifest disables backup");
let beta = WebView.generate("Beta", map{package:"org.pblang.betaview", url:"http://127.0.0.1:8766/",
    version:"2.0.0", release_channel:"beta", show_release_channel:true});
assert(beta.version == "2.0.0" and beta.display_version == "2.0.0 [beta]"
    and str_contains(beta.manifest, "android:versionName=\"2.0.0 [beta]\""),
    "WebView version channel is included only after explicit UI opt-in");
assert((try WebView.generate("Bad", map{package:"org.pblang.bad",url:"http://example.com/"}) catch nil) == nil, "remote plaintext WebView origins fail closed");
assert((try WebView.generate("Bad", map{package:"org.pblang.bad",url:"http://127.0.0.1:80/"}) catch nil) == nil, "privileged loopback ports fail closed");
print "android_webview_pass";
