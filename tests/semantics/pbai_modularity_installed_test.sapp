// Actual installed facades from foreign cwd; original source checkouts hidden by bwrap.
if platform()!="linux" {print "pbai_modularity_installed_skip_linux_required";os_exit(0);}
let U=import("stdlib:uuid.sapp");let parent=path_dirname(cwd());
let exe=env_get("PBLANG_BIN");assert(type(exe)=="string" and len(exe)>0,"set trusted PBLANG_BIN");
let root=path_join("/tmp","pbai-installed-"+U.v4());let caller=path_join(root,"caller");
let shared=path_join(root,"pblang");let standalone=path_join(root,"pbai");let step=["setup"];
let completed=[0];let outputs=[];
fn process(command,args) {
 let argv=["-k","1s","30s",command];for arg in args {push(argv,arg);}
 return proc_spawn_wait("/usr/bin/timeout",argv);
}
fn runtime(at,args) {
 let argv=["-C",at,exe];for arg in args {push(argv,arg);}
 return process("/usr/bin/env",argv);
}
fn hidden(at,file) {
 let argv=["--die-with-parent","--unshare-net","--ro-bind","/","/",
  "--tmpfs",path_join(parent,"pblang"),"--tmpfs",path_join(parent,"pbai")];
 let extra=env_get("PBAI_SOURCE_HIDE_ROOT");if type(extra)=="string" and len(extra)>0 {push(argv,"--tmpfs");push(argv,extra);}
 for value in ["--chdir",at,exe,"run",file,"--deny-net","--deny-http","--deny-exec","--deny-ffi","--deny-spawn","--deny-sqlite"] {push(argv,value);}
 return process("/usr/bin/bwrap",argv);
}
fn exercise() {
 fs_mkdirs(root);assert(process("/bin/chmod",["700",root]).exit_code==0,"private fixture root");
 fs_mkdirs(caller);fs_mkdirs(shared);fs_mkdirs(standalone);
 for name in ["pblang","pbai"] {
  step[0]="copy "+name;let source=path_join(parent,name);let installed=path_join(root,name);
  assert(process("/bin/cp",["-R",path_join(source,"stdlib"),path_join(installed,"stdlib")]).exit_code==0,"copy packaged library");
  let example=if name=="pblang" {"examples/pbai_modularity.sapp"} else {"demo/pbai_modularity.sapp"};
  fs_write(path_join(installed,"example.sapp"),fs_read(path_join(source,example)));
  let dep=if name=="pblang" {"stdlib"} else {"../pblang/stdlib"};
  fs_write(path_join(installed,"pblang.toml"),"[package]\nname=\"pbai-installed-fixture\"\nversion=\"0.1.0\"\nentry=\"example.sapp\"\n[dependencies]\nstdlib={path="+json_stringify(dep)+"}\n");
  fs_write(path_join(installed,"legacy.sapp"),"let AI=import(\"stdlib/pbai.sapp\");print AI.modular_probe(\"sensor-v1\").code;");
 }
 // Selected sensor must still work when the unselected student module is absent.
 fs_remove(path_join(shared,"stdlib/pbai_neural_adapter.sapp"));
 // A caller-owned decoy must neither execute nor replace the installed dependency.
 fs_mkdirs(path_join(caller,"stdlib"));
 fs_write(path_join(caller,"stdlib/pbai_sensor.sapp"),"print \"DECOY_EXECUTED\";throw \"caller decoy\";");
 for name in ["pblang","pbai"] {
  let at=path_join(root,name);step[0]="build "+name;
  assert(runtime(at,["build"]).exit_code==0,"materialize local fixture lock");
  let locked=fs_read(path_join(at,"pblang.lock"));assert(not str_contains(locked,parent),"installed lock has no source checkout path");
  step[0]="foreign source-hidden binding "+name;let result=hidden(caller,path_join(at,"example.sapp"));
  assert(result.exit_code==0 and not str_contains(result.stdout,"DECOY_EXECUTED"),"foreign source-hidden example");
  let value=json_parse(result.stdout);assert(value.probe.ok and value.result.output.value.outlier,"actual bound numeric result");
  push(outputs,result.stdout);completed[0]=completed[0]+1;
  step[0]="project cwd legacy "+name;let legacy=hidden(at,path_join(at,"legacy.sapp"));
  assert(legacy.exit_code==0 and legacy.stdout=="ok\n","legacy convenience wrapper works from installed project");
  step[0]="known foreign cwd limit "+name;legacy=hidden(caller,path_join(at,"legacy.sapp"));
  assert(legacy.exit_code==0 and legacy.stdout=="dependency_unavailable\n","retained lazy origin limit remains explicit");
 }
 // Even a valid caller-owned dependency lock cannot redirect explicit top-level imports.
 fs_write(path_join(caller,"pblang.toml"),"[package]\nname=\"caller-decoy\"\nversion=\"0.1.0\"\nentry=\"main.sapp\"\n[dependencies]\nstdlib={path=\"stdlib\"}\n");
 fs_write(path_join(caller,"main.sapp"),"print 0;");
 assert(runtime(caller,["build"]).exit_code==0,"valid caller decoy lock");
 for name in ["pblang","pbai"] {
  step[0]="locked caller decoy "+name;let result=hidden(caller,path_join(path_join(root,name),"example.sapp"));
  assert(result.exit_code==0 and result.stdout==outputs[0],"caller manifest cannot redirect bound example");
 }
 assert(outputs[0]==outputs[1],"installed facade byte parity");
}
let passed=try {exercise();true} catch false;
let removed=process("/bin/rm",["-rf","--",root]);
assert(passed,"pbai installed binding: "+step[0]);assert(removed.exit_code==0,"owned fixture cleanup");
assert(completed[0]==2,"both installed facades executed");
print "pbai_modularity_installed_foreign_cwd_pass";
