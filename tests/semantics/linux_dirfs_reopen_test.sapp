let DIRFS = import("stdlib:linux_dirfs.sapp");

fn expect(value, message) {
    if not value { throw "FAIL linux dirfs reopen: " + message; }
}

let suffix = str_slice(sha256(str(now_ms()) + base64_encode_bytes(random_bytes(8))), 0, 16);
let root_path = "/tmp/pblang-dirfs-reopen-" + suffix;

let i = 0;
while i < 64 {
    let root = DIRFS.open_absolute(root_path, true, true);
    expect(root.ok, "open iteration " + str(i) + ": " + str(try root.error catch "unknown"));
    expect(DIRFS.close(root), "close iteration " + str(i));
    i = i + 1;
}

try fs_remove(root_path) catch nil;
print "linux_dirfs_reopen_pass";
