// Test: tools/pbaudit.sapp CLI contract for bounded backlog depth.

fn fail(m) { throw "FAIL " + m; }

let src = try fs_read("tools/pbaudit.sapp") catch "";

if not str_contains(src, "--backlog-limit=") {
    fail("pbaudit exposes --backlog-limit option");
}
if not str_contains(src, "let backlog_limit = 12;") {
    fail("pbaudit has stable default backlog limit");
}
if not str_contains(src, "backlog_limit: backlog_limit") {
    fail("pbaudit forwards backlog limit into project_text_audit");
}
if str_contains(src, "--allow-all") {
    fail("pbaudit help/examples should not recommend full capability escalation");
}
if not str_contains(src, "does not echo raw lines") and not str_contains(src, "without echoing raw lines") {
    fail("pbaudit documents redacted output behavior");
}

print "pbaudit_cli_pass";
