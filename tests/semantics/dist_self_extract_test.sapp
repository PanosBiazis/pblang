// tests/semantics/dist_self_extract_test.sapp
//
// Self-extracting single-file artifact (PBSELF). dist.self_extract links a
// program into ONE valid-pblang file = [tiny launcher] + [//PBSELF1: sentinel] +
// [base64 of the optimized PBCS bundle]. Running it with `pblang run app.pbself`
// makes the launcher read its own source, slice the payload after the sentinel,
// base64-decode it, and run it on the self-hosted VM — pure pblang, no Rust, the
// bundle embedded in the file itself.

let fe     = import("stdlib/compiler/selfhost_frontend.sapp");
let pbck   = import("stdlib/selfhost_pbck.sapp");
let dist   = import("stdlib/dist.sapp");
let loader = import("stdlib/selfhost_loader.sapp");

fn fail(m) { throw "FAIL " + m; }
fn expect(c, m) { if not c { fail(m); } }

fn uniq(tag) { return "/tmp/pbself_" + tag + "_" + str(num_floor(now_ms())); }

// ── Piece 1: run_pbck_bytes — run a PBCS chunk from in-memory bytes ─────────────
let cr = fe.frontend_compile("let a = 8; let b = 9; let p = a * b; print p;");
expect(cr.ok, "compile ok");
let bytes = pbck.serialize_chunk(cr.chunk);
let r1 = loader.run_pbck_bytes(bytes);
expect(r1.ok, "run_pbck_bytes runs in-memory PBCS bytes");
expect(r1.globals["p"] == 72, "8 * 9 == 72 from bytes");
expect(r1.output[0] == 72, "print output from in-memory bytes");

// ── Pieces 2+3: dist.self_extract writes a single self-extracting file; the
//    embedded payload extracts (sentinel + base64) and runs to the same result.
let lib_path  = uniq("lib") + ".sapp";
let main_path = uniq("main") + ".sapp";
let out_path  = uniq("app") + ".pbself";

fs_write_bytes(lib_path, str_to_bytes("fn cube(x){ return x * x * x; } export cube;"));
fs_write_bytes(main_path, str_to_bytes("let m = import(\"" + lib_path + "\"); let k = 1 + 1; let answer = m.cube(3) + k; print answer;"));

let se = dist.self_extract(main_path, out_path);
expect(se.ok, "self_extract must succeed");
expect(se.out == out_path, "report carries the output path");
expect(se.bytes > 0, "artifact has bytes");
expect(se.modules >= 1, "report counts bundled modules");

// The artifact is a single text file containing the sentinel.
let src = bytes_to_str(fs_read_bytes(out_path));
expect(str_index_of(src, "//PBSELF1:") >= 0, "artifact embeds the PBSELF sentinel");

// The artifact must itself be VALID pblang source (so `pblang run` can parse it).
let parsed = fe.frontend_parse_safe(src);
expect(parsed.ok, "the self-extracting artifact is valid pblang source");

// Extract the embedded payload and run it -> same result as the program.
let payload = loader.extract_payload(src);
expect(payload != nil, "extract_payload recovers the embedded bytes");
let r2 = loader.run_pbck_bytes(payload);
expect(r2.ok, "embedded payload runs");
expect(r2.globals["answer"] == 29, "cube(3) + 2 == 27 + 2 == 29");
expect(r2.output[0] == 29, "embedded program's print output");

// Self-contained: delete sources, payload still runs.
fs_remove(lib_path);
fs_remove(main_path);
let r3 = loader.run_pbck_bytes(loader.extract_payload(bytes_to_str(fs_read_bytes(out_path))));
expect(r3.globals["answer"] == 29, "artifact runs after its sources are deleted");
fs_remove(out_path);

// extract_payload on text with no sentinel -> nil (graceful).
expect(loader.extract_payload("just some code; print 1;") == nil, "no sentinel -> nil");

print "dist_self_extract_pass";
