// tests/semantics/ecs_enrich2_test.sapp — wave 2 for stdlib/ecs.sapp
// Set-complement queries + introspection: entity_exists, components_of, query_without, query_any.

let E = import("stdlib/ecs.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn contains(arr, v) { let i = 0; while i < len(arr) { if arr[i] == v { return true; } i = i + 1; } return false; }

let w = E.create_world();
let a = E.spawn(w, map{ position: 1, health: 100 });   // pos + health
let b = E.spawn(w, map{ position: 1, frozen: true });   // pos + frozen
let c = E.spawn(w, map{ name: "rock" });                 // name only

// ── entity_exists ─────────────────────────────────────────────────────────────────
if not E.entity_exists(w, a) { fail("a exists"); }
E.despawn(w, c);
if E.entity_exists(w, c) { fail("c despawned -> not exists"); }

// ── components_of ──────────────────────────────────────────────────────────────────
let comps = E.components_of(w, a);
eq(len(comps), 2, "a has 2 components");
if not contains(comps, "position") { fail("a has position"); }
if not contains(comps, "health") { fail("a has health"); }
eq(len(E.components_of(w, 999)), 0, "missing entity -> []");

// ── query_without: has position but NOT frozen -> only a ────────────────────────────
let movable = E.query_without(w, ["position"], ["frozen"]);
eq(len(movable), 1, "one movable (a)");
eq(movable[0].id, a, "movable is a");

// ── query_any: has health OR frozen -> a and b ──────────────────────────────────────
let any = E.query_any(w, ["health", "frozen"]);
eq(len(any), 2, "two with health-or-frozen");

print "ecs_enrich2_pass";
