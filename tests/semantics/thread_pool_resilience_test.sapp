import "stdlib:thread.sapp";

// thread_pool should preserve nil tasks via wrapped messages.
let tasks_with_nil = [1, nil, 3];
let got_nil = false;
let sum_non_nil = 0;
let out1 = thread.thread_pool(2, tasks_with_nil, fn(x) {
    return x;
});
let i = 0;
while i < len(out1) {
    if out1[i] == nil { got_nil = true; }
    if out1[i] != nil { sum_non_nil = sum_non_nil + out1[i]; }
    i = i + 1;
}
if got_nil != true { throw "FAIL thread_pool nil task lost"; }
if sum_non_nil != 4 { throw "FAIL thread_pool nil task sum"; }

print "thread_pool_resilience_pass";
