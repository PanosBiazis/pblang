let Bundle = import("stdlib:linux_memfd_bundle.sapp");
let X = import("stdlib:codegen_x64.sapp");

fn fail(message) { throw "FAIL linux_memfd_bundle: " + message; }
fn eq(actual, expected, message) {
    if actual != expected { fail(message + " got=" + str(actual) + " expected=" + str(expected)); }
}

let tiny_runtime = X.build_print_exit("runtime\n");
let tiny_core = [80, 66, 67, 75, 1];
let artifact = Bundle.build(tiny_runtime, tiny_core);

if len(artifact) <= len(tiny_runtime) + len(tiny_core) { fail("launcher does not wrap both payloads"); }
eq(artifact[0], 0x7F, "ELF magic byte 0");
eq(artifact[1], 0x45, "ELF magic byte 1");
eq(artifact[2], 0x4C, "ELF magic byte 2");
eq(artifact[3], 0x46, "ELF magic byte 3");
eq(artifact[4], 2, "launcher is ELF64");
eq(artifact[18], 0x3E, "launcher targets x86-64");
eq(artifact[24], 120, "entry starts after ELF headers");
eq(artifact[68], 5, "load segment is read-execute, never writable");

let bad_runtime = try Bundle.build([1, 2, 3, 4], tiny_core) catch nil;
eq(bad_runtime, nil, "non-ELF runtime fails closed");
let bad_core = try Bundle.build(tiny_runtime, [1, 2, 3, 4, 5]) catch nil;
eq(bad_core, nil, "non-PBCK core fails closed");
