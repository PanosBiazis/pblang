let Link = import("stdlib:host_pbck_link.sapp");

fn fail(message) { throw "FAIL host_pbck_link: " + message; }

let nested = map{
    __pbck_function: true, name: "nested", arity: 0, min_arity: 0,
    defaults: [], is_vararg: false, parameter_types_present: false,
    parameter_types: [], chunk: map{
        instructions: [
            map{ op: 14, operand: 0 }, map{ op: 0, operand: 1 },
            map{ op: 31, operand: 1 }, map{ op: 33 }
        ], constants: ["custom_io", "payload"], source_name: nil
    }
};
let decoded = map{
    format: "host-pbck-v1", version: 1,
    chunk: map{
        instructions: [
            map{ op: 0, operand: 0 }, map{ op: 13, operand: 1 },
            map{ op: 14, operand: 2 }, map{ op: 0, operand: 3 },
            map{ op: 31, operand: 1 }, map{ op: 11 }, map{ op: 33 }
        ], constants: [nested, "local_fn", "len", [1, 2, 3]], source_name: nil
    }
};

let missing = Link.analyze_decoded(decoded);
if missing.chunks != 2 or missing.functions != 1 or missing.instructions != 11 {
    fail("recursive artifact inventory mismatch");
}
if len(missing.required_host_adapters) != 2
    or missing.required_host_adapters[0] != "custom_io"
    or missing.required_host_adapters[1] != "len"
    or missing.link_ready {
    fail("unresolved adapter inventory mismatch: " + json_stringify(missing));
}
if len(missing.unresolved_host_adapters) != 1
    or missing.unresolved_host_adapters[0] != "custom_io" {
    fail("missing adapter was not reported deterministically");
}

let ready = Link.analyze_decoded(decoded, map{ custom_io: fn(_args) { return nil; } });
if not ready.link_ready or len(ready.unresolved_host_adapters) != 0
    or len(ready.required_host_adapters) != 2 {
    fail("provided adapter did not satisfy the static link contract");
}

let pure = map{
    format: "host-pbck-v1", version: 1,
    chunk: map{
        instructions: [
            map{ op: 14, operand: 0 }, map{ op: 11 },
            map{ op: 14, operand: 1 }, map{ op: 11 }, map{ op: 33 }
        ], constants: ["json_parse", "str_split"], source_name: nil
    }
};
let pure_link = Link.analyze_decoded(pure);
if not pure_link.link_ready or len(pure_link.unresolved_host_adapters) != 0 {
    fail("pure runtime adapters were not linked automatically");
}

if not (try { Link.analyze_decoded(decoded, [42]); false } catch true) {
    fail("invalid provided adapter name did not fail closed");
}

print "host_pbck_link_pass";
