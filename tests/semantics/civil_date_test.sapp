let Date=import("stdlib:civil_date.sapp");
fn rejects(f) { let bad=false; try { f(); } catch { bad=true; } assert(bad,"invalid date rejected"); }
assert(Date.ordinal("0001-01-01")==0 and Date.ordinal("9999-12-31")==3652058,"ordinal endpoints");
assert(Date.add_days("2000-02-28",1)=="2000-02-29","400-year leap day");
assert(Date.add_days("1900-02-28",1)=="1900-03-01","century is not automatically leap");
assert(Date.add_days("1970-01-01",-1)=="1969-12-31","pre-epoch dates need no clock");
for date in ["0001-01-01","0004-02-29","0400-12-31","1900-03-01","2000-02-29","2026-09-27","9999-12-31"] {
    assert(Date.from_ordinal(Date.ordinal(date))==date,"calendar roundtrip");
}
for date in [nil,1,"2026-2-03","2026-02-29","1900-02-29","0000-01-01","2026-00-01","2026-13-01","2026-04-31","2026-01-00","2026-01-01Z"] {
    rejects(fn(){Date.parse(date);});
}
rejects(fn(){Date.from_ordinal(-1);}); rejects(fn(){Date.from_ordinal(0.5);});
rejects(fn(){Date.add_days("9999-12-31",1);});
print "civil_date_pass";
