let AVR = import("stdlib:emulator_avr.sapp");

fn word(bytes) { return bytes[0] + bytes[1] * 256; }
fn value(instructions) {
    let result = AVR.run(AVR.program(instructions));
    if not result.ok { throw result.error; }
    return result.value;
}

assert(word(AVR.load_immediate(16, 255)) == 61199, "canonical LDI encoding");
assert(word(AVR.add(16, 17)) == 3841, "canonical ADD encoding");
assert(value([AVR.load_immediate(24, 42), AVR.halt()]) == 42, "LDI");
assert(value([AVR.load_immediate(24, 5), AVR.load_immediate(25, 7), AVR.add(24, 25), AVR.halt()]) == 12, "ADD");
assert(value([AVR.load_immediate(24, 20), AVR.load_immediate(25, 8), AVR.subtract(24, 25), AVR.halt()]) == 12, "SUB");
assert(value([AVR.load_immediate(24, 250), AVR.load_immediate(25, 20), AVR.add(24, 25), AVR.halt()]) == 14, "ADD wraps");
assert(value([AVR.load_immediate(24, 6), AVR.load_immediate(25, 7), AVR.multiply(24, 25), AVR.move(24, 0), AVR.halt()]) == 42, "MUL");
assert(value([AVR.load_immediate(24, 0), AVR.load_immediate(18, 3), AVR.load_immediate(16, 5),
              AVR.add(24, 18), AVR.decrement(16), AVR.branch_not_equal(-3), AVR.halt()]) == 15, "loop");

assert(not AVR.run([152]).ok, "odd truncated word fails closed");
assert(not AVR.run([255, 255]).ok, "unknown word fails closed");
assert(not AVR.run(AVR.program([AVR.jump_relative(-1)]), map{ instruction_budget: 4 }).ok, "loop budget enforced");
assert((try AVR.load_immediate(15, 1) catch nil) == nil, "invalid LDI register rejected");
assert((try AVR.branch_not_equal(64) catch nil) == nil, "invalid branch displacement rejected");

let linked = AVR.run(AVR.program([
    AVR.set_io_bit(11, 6), AVR.load_direct(24, 41), AVR.halt()
]), map{gpio_links:[map{output_io:11,output_bit:6,input_data:41,input_bit:2}]});
assert(linked.ok and linked.value == 4,
    "declared GPIO wire propagates output into the linked input register");
assert(not AVR.run(AVR.program([AVR.halt()]),
    map{gpio_links:[map{output_io:64,output_bit:0,input_data:41,input_bit:2}]}).ok,
    "malformed GPIO links fail closed");

print "emu_avr: reusable bounded subset passed encodings, arithmetic, malformed-code, register, branch, and budget checks";
