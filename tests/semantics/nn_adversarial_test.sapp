// tests/semantics/nn_adversarial_test.sapp — self-adversarial robustness: contained
// attacks (noise / infected node / poisoned data / adversarial examples) and a SAFE
// defense (harden) that can never destroy the original network (rollback on regression).

let nn = import("stdlib/nn.sapp");
let adv = import("stdlib/nn_adversarial.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.00001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn veq(a, b, m) { let i = 0; while i < len(a) { approx(a[i], b[i], m); i = i + 1; } }

let data = [ nn.sample([0, 0], [0]), nn.sample([0, 1], [1]), nn.sample([1, 0], [1]), nn.sample([1, 1], [0]) ];
let net = nn.mlp_new(2, 4, 1, 7);
nn.train(net, data, 200, 0.5);                       // a trained baseline
let x = [1, 0];
let y0 = nn.predict(net, x);

// ── attacks operate on CLONES — the original is never mutated ──────────────────────
let noisy = adv.noise_weights(net, 0.3, 11);
veq(nn.predict(net, x), y0, "noise_weights leaves the original untouched");
let infected = adv.corrupt_neuron(net, 0, 5);
veq(nn.predict(net, x), y0, "corrupt_neuron leaves the original untouched");

// ── poisoned data: corrupt a fraction of the labels ───────────────────────────────
let allp = adv.poison_data(data, 1, 3);
eq(len(allp), len(data), "poison keeps the dataset size");
approx(allp[0].y[0], 1 - data[0].y[0], "poison(frac=1) flips every label");
let nonep = adv.poison_data(data, 0, 3);
approx(nonep[1].y[0], data[1].y[0], "poison(frac=0) changes nothing");

// ── adversarial example raises loss (it attacks, by construction) ──────────────────
let clean = nn.loss(net, data);
let robust = adv.robustness(net, data, 0.2);
if robust < clean - 0.0001 { fail("adversarial loss should be >= clean loss"); }

// ── harden: SAFE defense — never worse than baseline on clean data (rollback) ──────
let h = adv.harden(net, data, 60, 0.5, 0.2, 0.02);
if nn.loss(h.net, data) > h.clean_before + 0.02 + 0.00001 { fail("harden must not destroy clean performance"); }
if h.hardened != true and h.hardened != false { fail("harden reports a decision flag"); }
veq(nn.predict(net, x), y0, "harden leaves the original net intact (works on a clone)");

print "nn_adversarial_pass";
