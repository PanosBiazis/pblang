let Config = import("stdlib:config.sapp");

fn require(value, message) {
    if not value { throw "config strict test failed: " + message; }
}

let parsed = Config.parse_dotenv_strict(
    "DEBUG=true\nDATABASE_URL=postgres://db.invalid/app\nAPI_KEY=sample-value\nPORT=8080\n");
require(parsed.ok and parsed.entries == 4 and parsed.sensitive_entries == 2,
    "valid bounded dotenv input must parse and classify sensitive fields");
require(parsed.values.DEBUG == "true" and parsed.values.PORT == "8080",
    "non-sensitive values must remain available to the application");

let safe = Config.redacted_values(parsed.values);
let serialized = json_stringify(safe);
require(safe.redacted_count == 2 and not safe.sensitive_values_exposed,
    "redacted snapshot must report its privacy contract");
require(safe.values.API_KEY == "[redacted]"
    and safe.values.DATABASE_URL == "[redacted]",
    "sensitive configuration fields must be fully redacted");
require(str_index_of(serialized, "sample-value") < 0
    and str_index_of(serialized, "postgres://") < 0,
    "serialized diagnostics must not retain sensitive values");
require(safe.values.DEBUG == "true" and safe.values.PORT == "8080",
    "safe non-sensitive values must remain useful");

let duplicate = Config.parse_dotenv_strict("PORT=8080\nPORT=9090\n");
require(not duplicate.ok and len(duplicate.errors) == 1
    and duplicate.values.PORT == "8080",
    "duplicate keys must fail without silently replacing the first value");
require(not Config.parse_dotenv_strict("BAD-KEY=value\n").ok,
    "non-portable keys must fail");
require(not Config.parse_dotenv_strict("MISSING_EQUALS\n").ok,
    "malformed lines must fail");
require(not Config.parse_dotenv_strict("NAME=\"unterminated\n").ok,
    "unterminated quoted values must fail");
require(not Config.parse_dotenv_strict(7).ok,
    "non-text input must fail without throwing");

let oversized = "";
let oversized_index = 0;
while oversized_index < 5000 {
    oversized = oversized + "x";
    oversized_index = oversized_index + 1;
}
require(not Config.parse_dotenv_strict("VALUE=" + oversized).ok,
    "oversized values must fail within the documented bound");

let invalid_values = map{};
invalid_values["BAD-KEY"] = "x";
let rejected = try map{ ok: true, value: Config.redacted_values(invalid_values) }
    catch map{ ok: false, value: nil };
require(rejected.value == nil, "invalid diagnostic keys must fail closed");

print "config_strict_pass";
