// tests/semantics/parallel_enrich2_test.sapp — wave 2 for stdlib/parallel.sapp

let P = import("stdlib/parallel.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn arreq(a, b, m) {
    if len(a) != len(b) { fail(m + " len " + str(a)); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " [" + str(i) + "] " + str(a)); } i = i + 1; }
}

// ── par_partition: [matching, non-matching] preserving order ──────────────────────
let pt = P.par_partition([1, 2, 3, 4, 5, 6], fn(x) { return x % 2 == 0; });
arreq(pt[0], [2, 4, 6], "evens");
arreq(pt[1], [1, 3, 5], "odds");

// ── par_find: first element matching the predicate, nil if none ───────────────────
eq(P.par_find([1, 2, 3, 4], fn(x) { return x > 2; }), 3, "first > 2");
eq(P.par_find([1, 2], fn(x) { return x > 9; }), nil, "no match -> nil");

// ── par_mean ──────────────────────────────────────────────────────────────────────
eq(P.par_mean([2, 4, 6]), 4, "mean");
eq(P.par_mean([]), 0, "empty mean -> 0");

print "parallel_enrich2_pass";
