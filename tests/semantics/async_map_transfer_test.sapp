let A=import("stdlib:async.sapp");
let items=[];
for i 128 { array_push(items,map{idx:i,values:[nil,false,i]}); }
for size in [1,2,8,160] {
    let out=A.map_parallel(items,fn(x){return x.values;},size);
    for i 128 {
        assert(out[i][0]==nil and out[i][1]==false and out[i][2]==i,"ordered data");
    }
}
// Mutating the worker's data must not mutate the caller's input.
let out=A.map_parallel(items,fn(x){x.idx=999;return x.idx;});
for i 128 { assert(out[i]==999 and items[i].idx==i,"copied data isolation"); }
out=A.map_parallel(items,fn(x){if x.idx==7 {throw "task";} return x.idx;});
assert(out[7]==nil and out[8]==8,"mapper failures remain nil");

// A late function requires capture transfer. No mapper runs before fallback,
// and each task is executed exactly once after selecting the compatible path.
fn value_task(v){return fn(){return v;};}
let functions=[];
for i 64 { array_push(functions,value_task(i)); }
out=A.map_parallel(functions,fn(f){return f();},4);
for i 64 { assert(out[i]==i,"function input compatibility"); }
let mixed=[];
for i 63 { array_push(mixed,map{value:i}); }
array_push(mixed,map{value:value_task(63)});
let effects=channel_buffered(64);
fn counting_mapper(sender){return fn(x){send(sender,true);return if is_number(x.value){x.value}else{x.value()};};}
out=A.map_parallel(mixed,counting_mapper(effects.sender),4);
assert(channel_size(effects.receiver)==64,"fallback does not replay effects");
for i 64 { assert(out[i]==i,"late unsupported input falls back"); recv(effects.receiver); }
channel_close(effects.sender);

// JSON channels must not silently replace non-finite mapper inputs with nil.
let special=[];
for i 64 {array_push(special,[num_exp(1000),num_sqrt(-1)]);}
out=A.map_parallel(special,fn(row){return is_number(row[0]) and is_number(row[1]);},4);
for value in out {assert(value,"non-finite inputs keep capture semantics");}
let exact=[];for i 64 {array_push(exact,[bigint("9007199254740993")]);}
out=A.map_parallel(exact,fn(row){return type(row[0])+":"+str(row[0]);},4);
for value in out {assert(value=="string:9007199254740993","retained exact numeric capture conversion");}
let text=str_repeat("x",300);
let strings=[];for i 64 {array_push(strings,text);}
out=A.map_parallel(strings,fn(x){return map{supported:false,values:[len(x),nil]};},4);
assert(out[63].supported==false and out[63].values[0]==300,"long strings and result envelopes");
let cycle=[];array_push(cycle,cycle);
let cyclic=[];for i 64 {array_push(cyclic,cycle);}
assert((try {A.map_parallel(cyclic,fn(x){return nil;},2);false} catch true),"cycles rejected without mapper execution");

// Untransferable output still throws after sibling completion.
let done=channel_buffered(128);
fn bad_result(sender){return fn(x){
    if x.idx==0 {return fn(){return 0;};}
    if x.idx==127 {sleep_ms(50);send(sender,true);}
    return x.idx;
};}
assert((try {A.map_parallel(items,bad_result(done.sender),2);false} catch true),"bad result fails pool");
assert(recv_timeout(done.receiver,0)==true,"all started workers joined before error");
channel_close(done.sender);
assert(A.map_parallel(items,fn(x){return x.idx;})[127]==127,"reuse after failure");
print "async_map_transfer_pass";
