let Doc=import("stdlib:ui_document.sapp");
let O=import("stdlib:ui_form_overlay.sapp");
fn denied(action){let failed=false;try action() catch {failed=true;};return failed;}
let doc=Doc.from_design(map{form:map{title:"Source", w:400, h:300}, model:map{value:"old"}, widgets:[
    map{name:"Panel", kind:"panel", x:0, y:0, w:400, h:300, props:map{title:"Group"}},
    map{name:"Input", kind:"textbox", parent:"Panel", x:1, y:2, w:100, h:30, props:map{value:"old"}, bind:"value"}
    ]});
let original=json_stringify(doc);
let patch=map{id:"Input", set:map{props:map{value:"new", hint:"Friendly label"}, x:5}};
let changed=O.apply(doc, [patch]);
assert(changed.widgets[1].props.value == "new" and changed.widgets[1].props.hint == "Friendly label" and changed.widgets[1].x == 5, "patch");
assert(json_stringify(doc) == original, "source untouched");
patch.set.props.value="later";assert(changed.widgets[1].props.value == "new", "patch detached");
changed.widgets[0].props.title="different";assert(doc.widgets[0].props.title == "Group", "nested source detached");
assert(denied(fn(){O.apply(doc, [map{id:"Input", set:map{props:map{value:"partial"}}}, map{id:"missing", set:map{}}]);}), "atomic invalid patch");
assert(json_stringify(doc) == original, "failure leaves source untouched");
for key in ["id", "kind", "parent", "code"] {
    let fields=map{};fields[key]="x";
    assert(denied(fn(){O.apply(doc, [map{id:"Input", set:fields}]);}), "reject structural or executable patch");
}
assert(denied(fn(){O.apply(doc, [map{id:"Input", set:map{events:map{click:"eval()"}}}]);}), "no event code");
assert(denied(fn(){O.apply(doc, [map{id:"Input", set:map{w: - 1}}]);}), "geometry validation");
let merged=O.compose([map{prefix:"one", document:doc}, map{prefix:"two", document:doc}], "Combined");
assert(len(merged.widgets) == 6 and merged.widgets[2].parent == "one.Panel" and merged.widgets[5].parent == "two.Panel", "namespace ownership");
assert(merged.widgets[2].bind == "one.value" and merged.model["two.value"] == "old", "namespace bindings");
merged.widgets[2].props.value="modified";assert(json_stringify(doc) == original, "composition detached");
assert(denied(fn(){O.compose([map{prefix:"one", document:doc}, map{prefix:"one", document:doc}]);}), "duplicate namespace");
assert(denied(fn(){O.compose([map{prefix:"a.b", document:doc}]);}), "ambiguous namespace rejected");
assert(denied(fn(){O.compose([]);}), "empty composition");
print "ui_form_overlay_pass";
