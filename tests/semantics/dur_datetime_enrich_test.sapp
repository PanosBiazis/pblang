// tests/semantics/dur_datetime_enrich_test.sapp — enrichment for duration.sapp + datetime.sapp

let D = import("stdlib/duration.sapp");
let DT = import("stdlib/datetime.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── duration extras ─────────────────────────────────────────────────────────────────
eq(D.as_weeks(D.weeks(2)), 2, "as_weeks");
if not D.is_zero(0) { fail("is_zero(0)"); }
if D.is_zero(D.seconds(1)) { fail("is_zero(1s) false"); }
eq(D.min_dur(D.seconds(5), D.seconds(3)), 3, "min_dur");
eq(D.max_dur(D.seconds(5), D.seconds(3)), 5, "max_dur");
eq(D.clamp(D.seconds(10), D.seconds(0), D.seconds(5)), 5, "clamp high");

// ── datetime weekday (1970-01-01 was a Thursday) ──────────────────────────────────
let epoch = DT.from_ymd(1970, 1, 1);
eq(DT.weekday(epoch), 4, "epoch is Thursday (4)");
eq(DT.weekday_name(epoch), "Thursday", "epoch weekday name");
if DT.is_weekend(epoch) { fail("Thursday is not weekend"); }

// 2000-01-01 was a Saturday
let y2k = DT.from_ymd(2000, 1, 1);
eq(DT.weekday_name(y2k), "Saturday", "2000-01-01 Saturday");
if not DT.is_weekend(y2k) { fail("Saturday is weekend"); }

// ── ranges ────────────────────────────────────────────────────────────────────────
eq(DT.clamp_dt(100, 200, 300), 200, "clamp_dt low");
eq(DT.clamp_dt(250, 200, 300), 250, "clamp_dt mid");
if not DT.is_between(250, 200, 300) { fail("250 in [200,300]"); }
if DT.is_between(150, 200, 300) { fail("150 not in range"); }
if DT.end_of_day(epoch) <= DT.start_of_day(epoch) { fail("end_of_day after start_of_day"); }

print "dur_datetime_enrich_pass";
