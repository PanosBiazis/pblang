let log = import("stdlib:log.sapp");

log.set_level("debug");
log.set_format("json");
log.use_memory_output();

log.info("hello", map{ request_id: "r1" });
assert(len(log.memory_entries()) == 1, "memory sink should capture log");
assert(log.memory_entries()[0].message == "hello", "memory entry message");

let c1 = log.counter("requests", 1, nil);
let c2 = log.counter("requests", 2, nil);
assert(c1 == 1, "counter first");
assert(c2 == 3, "counter second");
assert(log.counter_value("requests") == 3, "counter value");

log.timer_start("work");
let elapsed = log.timer_stop("work", map{ ok: true });
assert(elapsed != nil, "timer stop returns elapsed");

let result = log.span("calc", map{ route: "/x" }, fn() { return 7; });
assert(result == 7, "span returns result");

let base = log.new_logger("svc", "json");
let ctx = log.with_fields(base, map{ service: "api" });
ctx.warn("slow", map{ ms: 12 });
let entries = log.memory_entries();
assert(len(entries) >= 5, "memory entries include metrics and context");
assert(entries[len(entries) - 1].fields.service == "api", "context field merged");
assert(entries[len(entries) - 1].fields.ms == 12, "call field merged");

log.clear_memory();
assert(len(log.memory_entries()) == 0, "clear memory");
log.set_output("stdout");
log.set_format("text");

print "log_metrics_stdlib_pass";
