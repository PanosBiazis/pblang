// Compile the trusted repository module as one unit; no module-loader parity claim.
let F = import("stdlib:compiler/selfhost_frontend.sapp");
let V = import("stdlib:compiler/vm.sapp");
let P = import("stdlib:selfhost_pbck.sapp");
fn expect(ok, label) { if not ok { throw "FAIL selfhost-memoize: " + label; } }
let module_source = fs_read("stdlib/functional_memo.sapp");
expect(len(str_to_bytes(module_source)) < 8192, "reviewed module remains small");
let source = module_source
    + "\nlet calls = [0]; let m = memoize(fn(x) { calls[0] = calls[0] + 1; return type(x); });"
    + "let a = [m(1), m(\"1\"), m(1), m(true), m(\"true\"), m(nil), m(\"nil\")];"
    + "let objects = [0]; let read = memoize(fn(x) { objects[0] = objects[0] + 1; return x.value; });"
    + "let obj = map{ value: 7 }; let first = read(obj); obj.value = 8; let second = read(obj);"
    + "let result = [a, calls[0], first, second, objects[0]];";
let compiled = F.frontend_compile(source);
expect(compiled.ok and len(compiled.diagnostics) == 0, "checked compilation");
let limits = map{ max_steps: 10000, max_frames: 16 };
let plain = V.run_bounded(compiled.chunk, limits);
let optimized = F.frontend_run_bounded(source, limits);
let restored = V.run_bounded(P.deserialize_chunk(P.serialize_chunk(compiled.chunk)), limits);
let wanted = [["number", "string", "number", "bool", "string", "nil", "string"], 6, 7, 8, 2];
expect(plain.globals.result == wanted, "plain exact values and callback counts");
expect(optimized.ok and optimized.globals.result == wanted, "optimized exact values");
expect(restored.globals.result == wanted, "in-memory bytecode round-trip");
print "selfhost_memoize_identity_pass";
