// Test: embedded native-IDE examples run through the same self-hosted frontend as F5.

let FE = import("stdlib/compiler/selfhost_frontend.sapp");

let examples = [
    "// pblang IDE - Smart Code Editor\n// One programming language to create anything\n\nfn greet(name) {\n    return \"Hello, \" + name + \"! Welcome to pblang!\";\n}\n\nprint greet(\"Developer\");\nprint \"2^10 = \" + str(2 ** 10);\n",
    "// Arrays, loops, and functions\nfn sum(xs) {\n    let total = 0;\n    for x in xs {\n        total = total + x;\n    }\n    return total;\n}\n\nlet nums = [1, 2, 3, 4, 5];\nprint \"sum = \" + str(sum(nums));\n",
    "// Maps and if expressions\nlet user = map{ name: \"Ada\", score: 98 };\nlet grade = if user.score >= 90 { \"A\" } else { \"B\" };\nprint user.name + \" grade \" + grade;\n",
    "// Strings and exact big integers\nlet words = str_split(\"pblang native ide\", \" \");\nlet title = str_upper(str_join(words, \"-\"));\nlet big = bigint(\"12345678901234567890\") + bigint(\"10\");\nprint title;\nprint str(big);\n",
    "// While loop and map updates\nlet stats = map{ total: 0, count: 0 };\nlet i = 1;\nwhile i <= 5 {\n    stats.total = stats.total + i;\n    stats.count = stats.count + 1;\n    i = i + 1;\n}\nprint \"count = \" + str(stats.count);\nprint \"total = \" + str(stats.total);\n",
    "// Functions and return values\nfn add(a, b) {\n    return a + b;\n}\n\nfn twice(x) {\n    return add(x, x);\n}\n\nprint \"twice(21) = \" + str(twice(21));\n",
    "// for i N loops from 0 to N-1\nlet total = 0;\nfor i 6 {\n    total = total + i;\n    print \"i=\" + str(i) + \" total=\" + str(total);\n}\n",
    "// Nested maps and field reads\nlet app = map{ name: \"pbIDE\", stats: map{ runs: 2, checks: 3 } };\nlet stats = app.stats;\nstats.runs = stats.runs + 1;\nprint app.name + \" runs=\" + str(stats.runs);\nprint \"checks=\" + str(stats.checks);\n",
    "// Build an array with push\nlet xs = [];\nfor i 5 {\n    push(xs, i * i);\n}\nprint \"squares=\" + str(xs);\n",
    "// Simple text processing\nlet text = \"pblang native ide\";\nlet parts = str_split(text, \" \");\nlet upper = [];\nfor p in parts {\n    push(upper, str_upper(p));\n}\nprint str_join(upper, \" / \");\n",
    "// Classic branch exercise\nfor i 16 {\n    if i == 0 {\n        print \"start\";\n    } elif i % 15 == 0 {\n        print \"fizzbuzz\";\n    } elif i % 3 == 0 {\n        print \"fizz\";\n    } elif i % 5 == 0 {\n        print \"buzz\";\n    } else {\n        print str(i);\n    }\n}\n",
    "// Array of maps as table rows\nlet rows = [\n    map{ name: \"Ada\", lang: \"math\" },\n    map{ name: \"Grace\", lang: \"compiler\" },\n    map{ name: \"Linus\", lang: \"kernel\" }\n];\n\nfor row in rows {\n    print row.name + \" -> \" + row.lang;\n}\n"
];

for i len(examples) {
    let r = FE.frontend_run(examples[i]);
    assert(r.ok, "IDE example " + str(i) + " should compile and run: " + str(try r.error catch ""));
    assert(len(r.output) > 0, "IDE example " + str(i) + " should print output");
}

print "pbide_examples_pass";
