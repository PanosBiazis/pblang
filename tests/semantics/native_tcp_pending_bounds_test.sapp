let TCP=import("stdlib:native_tcp.sapp");
fn buffered(bytes){return map{format:TCP.FORMAT,closed:false,fd:-1,pending_bytes:bytes};}
// No OS handles: each successful branch must use only pending bytes.
let first=buffered([65,66,10,67,68,10]);
let narrow=TCP.read_until_bytes(first,[10],2);
assert(not narrow.ok and first.pending_bytes==[65,66,10,67,68,10],"delimiter outside smaller bound is not returned or lost");
let exact=TCP.read_until_bytes(first,[10],3);
assert(exact.ok and exact.bytes==[65,66,10] and first.pending_bytes==[67,68,10],"delimiter ending at bound");
let second=TCP.read_available_bytes(first,2);
assert(second.ok and second.bytes==[67,68] and second.truncated and not second.timed_out,"available read respects smaller bound");
assert(first.pending_bytes==[10],"available read retains tail");
let tail=TCP.read_exact_bytes(first,1);
assert(tail.ok and tail.bytes==[10] and first.pending_bytes==[],"tail available to next operation");
let split=buffered([65,13,10,66]);
assert(not TCP.read_until_bytes(split,[13,10],2).ok and len(split.pending_bytes)==4,"whole delimiter must fit");
assert(TCP.read_until_bytes(split,[13,10],3).bytes==[65,13,10],"split delimiter retry preserves bytes");
let early=buffered([10,65,66]);assert(TCP.read_until_bytes(early,[10],1).bytes==[10] and early.pending_bytes==[65,66],"early delimiter with excess pending tail");
let failure=buffered([65]);
let failed=TCP.read_available_bytes(failure,2,1,1);
assert(not failed.ok and failure.pending_bytes==[65],"poll failure retains existing bytes");
print "native_tcp_pending_bounds_pass";
