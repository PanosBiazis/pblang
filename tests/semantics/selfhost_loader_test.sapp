// tests/semantics/selfhost_loader_test.sapp
//
// stdlib/selfhost_loader.sapp — the .pbck LOADER. Closes the self-hosting loop:
// compile a program with the self-hosted frontend, PERSIST its bytecode to a real
// file on disk, then in a separate step LOAD that file and EXECUTE it on the
// self-hosted VM — all in pblang, with no Rust front-end re-parsing the source.
//
// This is the piece that turns "self-hosting in principle" into "independent in
// practice": an artifact emitted by pblang can be loaded and run by pblang.

let fe     = import("stdlib/compiler/selfhost_frontend.sapp");
let pbck   = import("stdlib/selfhost_pbck.sapp");
let loader = import("stdlib/selfhost_loader.sapp");

fn fail(m) { throw "FAIL " + m; }
fn expect(c, m) { if not c { fail(m); } }

fn uniq(tag) { return "/tmp/pbld_" + tag + "_" + str(num_floor(now_ms())) + ".pbck"; }

// ── 1. THE end-to-end disk loop: compile -> emit to FILE -> load+run from FILE ──
// The program prints a value AND sets a global, so we can prove both the captured
// output stream and the final VM state survive the disk round-trip.
let src = "let a = 6; let b = 7; let answer = a * b; print answer;";
let cr = fe.frontend_compile(src);
expect(cr.ok, "self-hosted compile must succeed");

let path = uniq("loop");
pbck.write_file(path, cr.chunk);              // emit bytecode to a real file

let res = loader.run_pbck(path);              // load from disk + execute on the VM
expect(res.ok, "run_pbck must succeed on a valid .pbck file");
expect(res.globals["answer"] == 42, "reloaded-from-disk bytecode runs: 6 * 7 == 42");
expect(len(res.output) == 1 and res.output[0] == 42, "print output survives the disk round-trip");
fs_remove(path);

// ── 2. load_pbck returns the chunk WITHOUT executing (read + deserialize only) ──
let path2 = uniq("load");
pbck.write_file(path2, cr.chunk);
let chunk = loader.load_pbck(path2);
expect(len(chunk.instructions) == len(cr.chunk.instructions), "load_pbck rebuilds the instruction stream");
expect(len(chunk.constants) == len(cr.chunk.constants), "load_pbck rebuilds the constant pool");
fs_remove(path2);

// ── 3. a function-bearing program round-trips and runs (closures/recursion) ────
let src2 = "fn fib(n){ if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } let r = fib(10); print r;";
let cr2 = fe.frontend_compile(src2);
expect(cr2.ok, "recursive program compiles");
let path3 = uniq("fib");
pbck.write_file(path3, cr2.chunk);
let res2 = loader.run_pbck(path3);
expect(res2.ok, "run_pbck runs a recursive program from disk");
expect(res2.globals["r"] == 55, "fib(10) == 55 after disk round-trip");
expect(res2.output[0] == 55, "fib print output survives");
fs_remove(path3);

// ── 4. graceful failure: a missing file yields ok:false, not a thrown crash ─────
let bad = loader.run_pbck("/tmp/pbld_does_not_exist_zzz.pbck");
expect(bad.ok == false, "missing file -> ok:false");
expect(len(try bad.error catch "") > 0, "missing file -> error message present");

print "selfhost_loader_pass";
