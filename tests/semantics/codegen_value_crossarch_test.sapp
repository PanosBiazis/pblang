// tests/semantics/codegen_value_crossarch_test.sapp — native value-return on every backend.
// x86-64 (8-byte) and i386 (4-byte) are run here; arm64 is encoding-verified.

let X64 = import("stdlib/codegen_x64.sapp");
let X86 = import("stdlib/codegen_x86.sapp");
let A64 = import("stdlib/codegen_arm64.sapp");

fn fail(m) { throw "FAIL " + m; }
fn run_val(elf, od, tag) {
    let path = "pbval_" + tag + ".bin";
    fs_write_bytes(path, elf);
    let r = proc_spawn_wait("bash", ["-c", "chmod +x " + path + " && ./" + path + " | od -An " + od + "; rm -f " + path]);
    return parse_number(str_trim(try r.stdout catch ""));
}

let sum = [["seti", 0, 0], ["seti", 1, 100], ["loop", 1, [["add", 0, 1]]]];   // 5050

// x86-64: 64-bit result
let g64 = run_val(X64.build_value(sum), "-td8", "x64");
if g64 != 5050 { fail("x86-64 value got " + str(g64)); }

// i386: 32-bit result (runs on this host's 32-bit support)
let g86 = run_val(X86.build_value(sum), "-td4", "x86");
if g86 != 5050 { fail("i386 value got " + str(g86)); }

// arm64: encoding-verified (valid ELF, 4-byte aligned, has the write(64) + exit(93) svc tail)
let elf = A64.build_value(sum);
if elf[0] != 0x7F or elf[18] != 0xB7 { fail("arm64 value ELF invalid"); }
if num_mod(len(elf) - 120 - 8, 4) != 0 { fail("arm64 value code not 4-byte aligned"); }

print "codegen_value_crossarch_pass";
