let Translate = import("stdlib:selfhost_to_pbck.sapp");
let VM = import("stdlib:host_pbck_vm.sapp");

fn fail(message) { throw "FAIL selfhost_to_pbck_branch_stack: " + message; }

fn run(instructions, constants) {
    return VM.run_bytes(Translate.translate(map{
        instructions: instructions, constants: constants
    }), map{ max_steps: 200, max_stack: 32 });
}

// Ordinary self-hosted branches consume the condition on both paths.
let false_taken = run([
    map{ op: 0, operand: 0 }, map{ op: 21, operand: 4 },
    map{ op: 0, operand: 1 }, map{ op: 19, operand: 0 },
    map{ op: 0, operand: 2 }, map{ op: 19, operand: 0 }
], [false, 99, 7]);
// Translation reserves one scratch local in the root frame, so a single guest
// value produces peak_stack=2. A leaked condition would raise it to 3.
if false_taken.value != 7 or false_taken.runtime.peak_stack != 2 {
    fail("consuming false/taken branch leaked its condition");
}

let true_fallthrough = run([
    map{ op: 0, operand: 0 }, map{ op: 21, operand: 4 },
    map{ op: 0, operand: 1 }, map{ op: 19, operand: 0 },
    map{ op: 0, operand: 2 }, map{ op: 19, operand: 0 }
], [true, 7, 99]);
if true_fallthrough.value != 7 or true_fallthrough.runtime.peak_stack != 2 {
    fail("consuming false/fallthrough branch leaked its condition");
}

// Short-circuit peek branches retain exactly one original value.
let peek_taken = run([
    map{ op: 0, operand: 0 }, map{ op: 33, operand: 4 },
    map{ op: 0, operand: 1 }, map{ op: 19, operand: 0 },
    map{ op: 19, operand: 0 }
], [false, 99]);
if peek_taken.value != false or peek_taken.runtime.peak_stack != 2 {
    fail("false-peek branch did not preserve exactly one value");
}

let peek_fallthrough = run([
    map{ op: 0, operand: 0 }, map{ op: 33, operand: 5 },
    map{ op: 11, operand: 0 }, map{ op: 0, operand: 1 },
    map{ op: 19, operand: 0 }, map{ op: 19, operand: 0 }
], [true, 7]);
if peek_fallthrough.value != 7 or peek_fallthrough.runtime.peak_stack != 2 {
    fail("false-peek fallthrough duplicated its condition");
}

// Nil-peek lowering must discard its temporary predicate but retain the value.
let nil_taken = run([
    map{ op: 0, operand: 0 }, map{ op: 36, operand: 4 },
    map{ op: 0, operand: 1 }, map{ op: 19, operand: 0 },
    map{ op: 19, operand: 0 }
], [nil, 99]);
if nil_taken.value != nil or nil_taken.runtime.peak_stack != 3 {
    fail("nil-peek branch returned its temporary predicate");
}

let non_nil_taken = run([
    map{ op: 0, operand: 0 }, map{ op: 37, operand: 4 },
    map{ op: 0, operand: 1 }, map{ op: 19, operand: 0 },
    map{ op: 19, operand: 0 }
], [42, 99]);
if non_nil_taken.value != 42 or non_nil_taken.runtime.peak_stack != 3 {
    fail("not-nil-peek branch returned its temporary predicate");
}

print "selfhost_to_pbck_branch_stack_pass";
