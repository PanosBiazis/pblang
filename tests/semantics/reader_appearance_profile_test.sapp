let P=import("../../examples/declarative_browser/appearance_profile.sapp");let App=import("../../examples/declarative_browser/app.sapp");
let GUI=import("stdlib:gui.sapp");let S=import("../../examples/declarative_browser/settings_layout.sapp");let n=0;
fn check(ok,label) {assert(ok,label);n=n+1;}
let original=P.defaults();let text=P.encode(original);check(P.decode(text).appearance==original,"roundtrip");
for bad in ["", "{}", "[]", str_repeat("x",4097),str_repeat("[",300)+"0"+str_repeat("]",300),str_replace_all(text,"\"version\":1.0","\"version\":2.0"),str_replace_all(text,"1.0,","2.0,"),
    str_replace_all(text,"\"version\":1.0","\"version\":1.0,\"version\":1.0"),
    str_replace_all(text,"\"body_size\":16.0","\"body_size\":true"),
    str_replace_all(text,"\"body_size\":16.0","\"body_size\":1000.0"),
    str_replace_all(text,"\"appearance\":{","\"appearance\":{\"unknown\":1,"),
    str_replace_all(text,"\"font_family\":\"sans\"","\"font_family\":\"../font\"") ] {
    let parsed=P.decode(bad);check(not parsed.ok and parsed.appearance==original,"invalid profile falls back");
}
fn press(c,key) {App.update(c,[map{type:"keydown",key:key}]);App.update(c,[map{type:"keyup",key:key}]);}
fn act(c,name) {c.form.focus=name;press(c,"Enter");}
let saved=[];let c=App.create();App.enable_preferences(c,nil,fn(style){push(saved,P.encode(style));return map{ok:true};});App.refresh(c);
act(c,"appearance");act(c,"font_family");check(c.preferences.draft.font_family=="serif" and c.appearance.font_family=="sans","draft separate");
act(c,"style_apply");check(c.appearance.font_family=="serif" and len(saved)==0,"Apply session only");
act(c,"style_save");check(len(saved)==1 and P.decode(saved[0]).appearance.font_family=="serif","Save explicit");
act(c,"font_family");act(c,"appearance");act(c,"appearance");check(c.preferences.draft.font_family=="serif","Done discards draft");
act(c,"style_reset");check(c.appearance==original and len(saved)==2,"Reset saves defaults");
let count_saved=len(saved);c.form.focus="style_save";
App.update(c,[map{type:"keydown",key:"Enter"}]);App.update(c,[map{type:"keydown",key:"Enter"}]);App.update(c,[map{type:"keyup",key:"Enter"}]);
check(len(saved)==count_saved+1,"held Save key only invokes once");
for height in [240,320,480,816] {
    App.update(c,[map{type:"resize",w:320,h:height}]);let seen=map{};let count=if c.settings_layout==nil {1} else {c.settings_layout.count};
    for page count {
        App.settings_page(c,page);App.update(c,[]);
        for w in c.form.widgets {check(w.x>=0 and w.y>=0 and w.x+w.w<=c.width and w.y+w.h<=c.height,"controls fit");}
        for key in S.names(true) {if GUI.get(c.form,key)!=nil {seen[key]=true;}}
    }
    check(len(seen)==9,"all choices/actions reachable");
}
let before=c.appearance;App.enable_preferences(c,nil,fn(style){return map{ok:false,attempted:true};});App.refresh(c);
act(c,"appearance");act(c,"appearance");App.settings_page(c,0);App.update(c,[]);act(c,"font_family");
App.settings_page(c,1);App.update(c,[]); // At 816px all nine controls can be on one compact page.
act(c,"style_save");check(c.appearance==before and c.preferences.save==nil,"uncertain save leaves applied style and disables retry");
c.session.close();print "reader_appearance_profile_pass checks="+str(n);
