// tests/semantics/quantum_circuit_builder_test.sapp — Q2-gamma
let q = import("stdlib:quantum.sapp");

// Build a Bell-state circuit
let circ = q.circuit(2);
circ = q.apply_h(circ, 0);
circ = q.apply_cnot(circ, 0, 1);
circ = q.measure_all(circ);

if circ["n_qubits"] != 2 { throw "fail"; }
if len(circ["ops"]) != 4 { throw "fail"; }

if circ["ops"][0]["gate"] != "h" { throw "fail"; }
if circ["ops"][0]["q"] != 0 { throw "fail"; }
if circ["ops"][1]["gate"] != "cx" { throw "fail"; }
if circ["ops"][1]["c"] != 0 { throw "fail"; }
if circ["ops"][1]["t"] != 1 { throw "fail"; }
if circ["ops"][2]["gate"] != "measure" { throw "fail"; }
if circ["ops"][3]["gate"] != "measure" { throw "fail"; }

let qasm = q.to_qasm(circ);
if str_contains(qasm, "OPENQASM 2.0") == false { throw "fail"; }
if str_contains(qasm, "qreg q") == false { throw "fail"; }
if str_contains(qasm, "h q") == false { throw "fail"; }
if str_contains(qasm, "cx q") == false { throw "fail"; }
if str_contains(qasm, "measure q") == false { throw "fail"; }

print "quantum_circuit_builder_pass";
