// Test: the pblang FREE-LIST allocator (stdlib/kernel/heap.sapp), PrjAnalysis §74.
//
// Improves on the §69 bump allocator (no-op free) with a real reclaiming allocator
// written in pblang: first-fit + block splitting + LIFO free list, threading the
// free-list head through an explicit `ctrl` cell (no globals). Lowered with the §73
// integer codegen mode so the whole memory manager is float-free.
//
// poke32/peek32 are kernel intrinsics (defined only in the emitted C preamble, not
// pblang VM builtins), so the allocator can't execute in the pblang test runner —
// we assert the codegen contract here. Behaviour is proven by an actual QEMU boot: a
// self-proving kernel allocs a,b, frees a, allocs c, and exits 85 (= (42<<1)|1) iff
// c reused a's exact block — confirming heap_free reclaims (see §74).

let ct = import("stdlib/compiler/ctranspile.sapp");
let heap = fs_read("stdlib/kernel/heap.sapp");

let src = "fn kmain() { let ctrl = kmalloc(8); let region = kmalloc(4096); "
    + "heap_init(ctrl, region, 4096); let a = heap_alloc(ctrl, 100); "
    + "heap_free(ctrl, a); let c = heap_alloc(ctrl, 100); outb(244, 42); "
    + "while 1 > 0 { hlt(); } }";

let c = ct.transpile_kernel_int(heap + src);

// ── The allocator transpiles, in integer (float-free) mode ──────────────────────────
assert(str_contains(c, "long heap_init(long ctrl, long base, long size)"), "heap_init transpiled (long-typed)");
assert(str_contains(c, "long heap_alloc(long ctrl, long n)"), "heap_alloc transpiled (long-typed)");
assert(str_contains(c, "long heap_free(long ctrl, long p)"), "heap_free transpiled (long-typed)");
assert(not str_contains(c, "double"), "allocator is float-runtime-free (int codegen mode)");

// ── The free-list mechanics are present ─────────────────────────────────────────────
assert(str_contains(c, "peek32"), "reads block headers / free-list links via peek32");
assert(str_contains(c, "poke32"), "writes block headers / free-list links via poke32");
// _align8 lowers to a bitwise round-up (integer in any mode), not a float divide.
assert(str_contains(c, "long _align8(long x)"), "_align8 helper transpiled");
assert(str_contains(c, "& (long)(~(long)7)"), "_align8 uses a bitwise mask (no float divide)");

// ── Coalescing free (§77): address-ordered insert that merges adjacent neighbours ───
// Distinctive fragments only the coalescing heap_free emits (forward + backward merge).
assert(str_contains(c, "(block + bsize)"), "coalescing: tests whether the block ends where a neighbour begins");
assert(str_contains(c, "peek32(prev)"), "coalescing: backward-merge with the predecessor block");
assert(str_contains(c, "peek32((nxt + 4))"), "coalescing: forward-merge relinks past the absorbed successor");

// ── It's a complete bootable unit ───────────────────────────────────────────────────
assert(str_contains(c, "0x1BADB002"), "multiboot header present");
assert(str_contains(c, "static long kmalloc(long n)"), "arena backing store from the bump allocator");

print "kernel_heap_pass";
