// tests/semantics/datetime_test.sapp — stdlib/datetime.sapp
import "stdlib:datetime.sapp";
let dt = datetime;

// from_ymd → unix ts; component accessors round-trip
let t = dt.from_ymd(2024, 3, 15, 10, 30, 45);
if dt.year(t) != 2024 { throw "FAIL year: " + str(dt.year(t)); }
if dt.month(t) != 3 { throw "FAIL month: " + str(dt.month(t)); }
if dt.day(t) != 15 { throw "FAIL day: " + str(dt.day(t)); }
if dt.hour(t) != 10 { throw "FAIL hour: " + str(dt.hour(t)); }
if dt.minute(t) != 30 { throw "FAIL minute: " + str(dt.minute(t)); }
if dt.second(t) != 45 { throw "FAIL second: " + str(dt.second(t)); }

// format
if dt.format(t, "%Y-%m-%d") != "2024-03-15" { throw "FAIL format: " + dt.format(t, "%Y-%m-%d"); }
if dt.to_iso(t) != "2024-03-15T10:30:45" { throw "FAIL to_iso: " + dt.to_iso(t); }

// arithmetic with durations (re-exposed as dt.dur)
let later = dt.add(t, dt.dur.hours(2));
if dt.hour(later) != 12 { throw "FAIL add hours: " + str(dt.hour(later)); }
if dt.diff(t, later) != 7200 { throw "FAIL diff: " + str(dt.diff(t, later)); }
let earlier = dt.sub(t, dt.dur.days(1));
if dt.day(earlier) != 14 { throw "FAIL sub day: " + str(dt.day(earlier)); }

// comparison
if dt.is_before(t, later) == false { throw "FAIL is_before"; }
if dt.is_after(later, t) == false { throw "FAIL is_after"; }
if dt.is_same(t, t) == false { throw "FAIL is_same"; }
if dt.max_dt(t, later) != later { throw "FAIL max_dt"; }
if dt.min_dt(t, later) != t { throw "FAIL min_dt"; }

// start_of_day
let sod = dt.start_of_day(t);
if dt.hour(sod) != 0 or dt.minute(sod) != 0 or dt.second(sod) != 0 { throw "FAIL start_of_day: " + dt.to_iso(sod); }
if dt.day(sod) != 15 { throw "FAIL start_of_day day: " + str(dt.day(sod)); }

// relative / ago (deterministic with explicit ref)
let ref = t;
if dt.relative(t - 7200, ref) != "2 hours ago" { throw "FAIL relative past: " + dt.relative(t - 7200, ref); }
if dt.relative(t + 259200, ref) != "in 3 days" { throw "FAIL relative future: " + dt.relative(t + 259200, ref); }
if dt.relative(t - 60, ref) != "1 minute ago" { throw "FAIL relative singular: " + dt.relative(t - 60, ref); }
if dt.relative(t, ref) != "just now" { throw "FAIL relative now: " + dt.relative(t, ref); }

// parse_iso round-trip
let p = dt.parse_iso("2024-03-15T10:30:45Z");
if dt.year(p) != 2024 or dt.day(p) != 15 or dt.hour(p) != 10 { throw "FAIL parse_iso: " + dt.to_iso(p); }

print "datetime_pass";
