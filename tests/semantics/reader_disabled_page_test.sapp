let App=import("../../examples/declarative_browser/app.sapp");let GUI=import("stdlib:gui.sapp");let S=import("../../examples/declarative_browser/settings_layout.sapp");
let checks=0;fn check(ok,label){assert(ok,label);checks=checks+1;}
fn key(c,k){App.update(c,[map{type:"keydown",key:k},map{type:"keyup",key:k}]);}
fn focus(c,name){c.focus_target=name;App.refresh(c);}
fn make(height,reload=false,save=false){let c=App.create();App.enable_preferences(c,nil,if save {fn(style){return map{ok:true};}}else{nil},"Read only",if reload {fn(){return map{ok:false};}}else{nil});c.width=320;c.height=height;c.settings=true;focus(c,"style_apply");return c;}
for reload in [false,true] {
 let c=make(240,reload);let anchor=c.reading_anchor;let style=c.appearance;let message=c.preferences.message;
 key(c,"PageDown");check(c.form.focus=="style_reset","Forward skips disabled Save to Reset");check(c.settings_layout.page==8,"Reset page revealed");
 key(c,"PageUp");check(c.form.focus=="style_apply" and c.settings_layout.page==6,"Backward skips disabled Save to Apply");
 check(c.appearance==style and c.preferences.draft==style and c.preferences.message==message and c.reading_anchor==anchor,"paging has no preference or document effects");
 check(App.settings_page(c,7),"explicit disabled page resolves forward");App.update(c,[]);check(c.form.focus=="style_reset","helper reveals Reset");
 check(App.settings_page(c,7),"explicit disabled page resolves backward");App.update(c,[]);check(c.form.focus=="style_apply","helper reveals Apply");
 App.update(c,[map{type:"keydown",key:"Next"},map{type:"keydown",key:"Next"}]);check(c.form.focus=="style_reset","held next moves once across skipped page");App.update(c,[map{type:"keyup",key:"Next"}]);
 key(c,"Prior");c.form.focus="settings_next";key(c,"Enter");check(c.form.focus=="style_reset","next button skips disabled-only page");c.form.focus="settings_previous";key(c,"Enter");check(c.form.focus=="style_apply","previous button skips disabled-only page");
 key(c,"End");check(c.form.focus==(if reload {"style_reload"}else{"style_reset"}),"last action remains reachable");key(c,"Home");check(c.form.focus=="font_family","first choice remains reachable");
 c.form.probe="kept";check(not App.settings_page(c,-10) and c.form.probe=="kept","unchanged clamped page is a no-op");
 c.session.close();
}
// Mixed pages and a seven-row page starting at Save must keep enabled rows reachable.
for height in [288,336,384,480,528] {for reload in [false,true] {for save in [false,true] {
 let c=make(height,reload,save);let keys=S.names(true,reload);key(c,"Home");let visited=map{};
 for turn 10 {
  let layout=c.settings_layout;let target=GUI.get(c.form,c.form.focus);check(target!=nil and target.enabled,"every destination is actionable");
  for i len(keys) {if GUI.get(c.form,keys[i])!=nil {visited[keys[i]]=true;}}
  if layout.page+1>=layout.count {break;}let before=layout.page;key(c,"PageDown");check(c.settings_layout.page>before,"forward paging progresses "+str(turn));
 }
 for name in keys {if name!="style_save" or save {check(map_has(visited,name),"available control reachable "+name);}}
 for turn 10 {let before=c.settings_layout.page;if before==0 {break;}key(c,"PageUp");check(c.settings_layout.page<before,"backward paging progresses "+str(turn));}
 c.session.close();
}}}
let enabled=make(240,true,true);key(enabled,"PageDown");check(enabled.form.focus=="style_save","enabled Save is not skipped");enabled.session.close();
let actions=map{reloads:0,saves:0};let c=make(240,true);c.preferences.reload=fn(){actions.reloads=actions.reloads+1;return map{ok:false};};
c.preferences.draft.font_family="serif";App.update(c,[map{type:"keydown",key:"PageDown"},map{type:"keyup",key:"PageDown"},map{type:"keydown",key:"Enter"},map{type:"keyup",key:"Enter"}]);
check(c.appearance.font_family=="sans" and c.preferences.draft.font_family=="sans" and c.preferences.message=="Applied for this session","batched next and Enter resets session");check(actions.reloads==0,"paging and Reset never invoke Reload");
c.preferences.save=fn(style){actions.saves=actions.saves+1;return map{ok:false,attempted:true};};focus(c,"style_save");key(c,"Enter");check(c.form.focus=="style_reload" and actions.saves==1,"failed Save retains explicit recovery focus");
key(c,"Prior");check(c.form.focus=="style_reset","Reset remains reachable after failure");key(c,"Prior");check(c.form.focus=="style_apply","Apply remains reachable after failure");c.session.close();
let plain=App.create();plain.width=320;plain.height=240;plain.settings=true;focus(plain,"font_family");for name in S.names(){check(plain.form.focus==name,"legacy six-choice sequence unchanged");key(plain,"PageDown");}plain.session.close();
print "reader_disabled_page_pass checks="+str(checks);
