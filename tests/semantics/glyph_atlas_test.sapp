// tests/semantics/glyph_atlas_test.sapp — stdlib/glyph_atlas.sapp
//
// Shelf/next-fit rectangle packer for a texture atlas — the data structure every GPU
// text renderer needs (glyphs packed into one texture, sampled by UV) and that a parallel
// CPU rasterizer reuses. pblang's answer to stb_rect_pack / etagere. Pure + deterministic.

let A = import("stdlib/glyph_atlas.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.0001 { fail(m + " got=" + str(a)); } }
fn truthy(c, m) { if c != true { fail(m); } }

let at = A.new(100, 100);

// first glyph packs at the origin
let ra = A.pack(at, "a", 10, 10);
eq(ra.x, 0, "a.x"); eq(ra.y, 0, "a.y"); eq(ra.w, 10, "a.w"); eq(ra.h, 10, "a.h");

// second fits on the same shelf, to the right
let rb = A.pack(at, "b", 20, 10);
eq(rb.x, 10, "b.x"); eq(rb.y, 0, "b.y");

// a taller glyph won't fit the shelf's height -> opens a new shelf below
let rc = A.pack(at, "c", 10, 30);
eq(rc.x, 0, "c.x"); eq(rc.y, 10, "c on new shelf below the 10px-tall first shelf");

// a short glyph reuses the first shelf (next-fit scans shelves in order)
let rd = A.pack(at, "d", 10, 10);
eq(rd.x, 30, "d reuses shelf 0 at cursor 30"); eq(rd.y, 0, "d.y");

// lookups + normalized UVs
eq(A.rect_for(at, "b").w, 20, "rect_for b");
let uv = A.uv(at, "a");
approx(uv.u0, 0.0, "uv u0"); approx(uv.v0, 0.0, "uv v0");
approx(uv.u1, 0.1, "uv u1 = 10/100"); approx(uv.v1, 0.1, "uv v1");

// occupancy = packed area / atlas area
approx(A.occupancy(at), (10 * 10 + 20 * 10 + 10 * 30 + 10 * 10) / (100.0 * 100.0), "occupancy");

// overflow: a full tiny atlas returns nil rather than throwing
let small = A.new(10, 10);
truthy(A.pack(small, "x", 10, 10) != nil, "x fits");
eq(A.pack(small, "y", 10, 10), nil, "y overflows a full atlas -> nil");

// pack_all reports placed vs overflow
let at2 = A.new(30, 20);
let res = A.pack_all(at2, [map{ id: "g1", w: 10, h: 10 }, map{ id: "g2", w: 10, h: 10 },
    map{ id: "g3", w: 10, h: 10 }, map{ id: "big", w: 40, h: 10 }]);
eq(len(res.placed), 3, "three small glyphs placed");
eq(len(res.overflow), 1, "the 40-wide glyph overflows a 30-wide atlas");
eq(res.overflow[0], "big", "overflow id");

print "glyph_atlas_pass";
