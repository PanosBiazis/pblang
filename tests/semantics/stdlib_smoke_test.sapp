// tests/semantics/stdlib_smoke_test.sapp — exercises stdlib modules that use
// range-for / push / string indexing, which were silently broken until those
// primitives landed. Verifies the public APIs actually run and return sane
// values.
import "stdlib:functional.sapp";
import "stdlib:colors.sapp";
import "stdlib:math.sapp";
import "stdlib:serialization.sapp";

// ── functional ────────────────────────────────────────────────────────────────
let dbl = fn(x) { return x * 2; };
let is_even = fn(x) { return num_mod(x, 2) == 0; };

let m = functional.map([1, 2, 3], dbl);
if len(m) != 3 or m[0] != 2 or m[2] != 6 { throw "FAIL functional.map: " + str(m); }

let f = functional.filter([1, 2, 3, 4], is_even);
if len(f) != 2 or f[0] != 2 or f[1] != 4 { throw "FAIL functional.filter: " + str(f); }

let t = functional.take([10, 20, 30, 40], 2);
if len(t) != 2 or t[0] != 10 or t[1] != 20 { throw "FAIL functional.take: " + str(t); }

let d = functional.drop([10, 20, 30, 40], 2);
if len(d) != 2 or d[0] != 30 or d[1] != 40 { throw "FAIL functional.drop: " + str(d); }

let z = functional.zip([1, 2, 3], [4, 5, 6]);
if len(z) != 3 or z[0][0] != 1 or z[0][1] != 4 or z[2][1] != 6 { throw "FAIL functional.zip: " + str(z); }

let u = functional.unique([1, 1, 2, 3, 3, 3]);
if len(u) != 3 { throw "FAIL functional.unique: " + str(u); }

let fl = functional.flatten([[1, 2], [3], [4, 5]]);
if len(fl) != 5 or fl[0] != 1 or fl[4] != 5 { throw "FAIL functional.flatten: " + str(fl); }

let r = functional.reduce([1, 2, 3, 4], fn(a, b) { return a + b; }, 0);
if r != 10 { throw "FAIL functional.reduce: " + str(r); }

// ── colors (RGB maps {r,g,b}; exercises slice syntax h[1..] + string index) ─────
let rgb = colors.hex_to_rgb("#ff8800");
if rgb.r != 255 or rgb.g != 136 or rgb.b != 0 { throw "FAIL colors.hex_to_rgb: " + str(rgb); }

let hex = colors.rgb_to_hex(rgb);
if hex != "#ff8800" { throw "FAIL colors.rgb_to_hex: " + str(hex); }

// shorthand hex (#abc) exercises the h[1..] slice + char-doubling path
let short = colors.hex_to_rgb("#f80");
if short.r != 255 or short.g != 136 or short.b != 0 { throw "FAIL colors.hex_to_rgb short: " + str(short); }

let ana = colors.analogous(rgb, 3);
if len(ana) != 3 { throw "FAIL colors.analogous: " + str(ana); }

let mono = colors.monochromatic(rgb, 4);
if len(mono) != 4 { throw "FAIL colors.monochromatic: " + str(mono); }

// ── math (public API: abs/max/min) ──────────────────────────────────────────────
if math.abs(-5) != 5 { throw "FAIL math.abs"; }
if math.max(3, 7) != 7 { throw "FAIL math.max"; }
if math.min(3, 7) != 3 { throw "FAIL math.min"; }

// ── serialization (format helpers + nested output) ────────────────────────────
if serialization.json_validate("{bad") != false { throw "FAIL serialization.json_validate invalid"; }
let jd = serialization.json_validate_detail("{\"ok\":true}");
if jd.ok != true or jd.value.ok != true { throw "FAIL serialization.json_validate_detail"; }

let nested = map{ name: "pb", version: 1, flags: [true, false], pkg: map{ entry: "main.sapp" } };
let toml = serialization.toml_stringify(nested);
if not str_contains(toml, "[pkg]") or not str_contains(toml, "entry = \"main.sapp\"") {
    throw "FAIL serialization.toml_stringify nested: " + toml;
}
let toml_back = serialization.toml_parse(toml);
if toml_back.pkg.entry != "main.sapp" or toml_back.version != 1 {
    throw "FAIL serialization.toml_parse roundtrip";
}

let yaml = serialization.yaml_stringify(nested);
if not str_contains(yaml, "pkg:") or not str_contains(yaml, "entry: \"main.sapp\"") {
    throw "FAIL serialization.yaml_stringify nested: " + yaml;
}
let yaml_back = serialization.yaml_parse(yaml);
if yaml_back.pkg.entry != "main.sapp" or yaml_back.name != "pb" {
    throw "FAIL serialization.yaml_parse roundtrip";
}

let csv_rows = serialization.csv_parse("name,note\r\nAlice,\"x,y\"\r\nBob,\"line1\nline2\"\r\n", ",");
if len(csv_rows) != 2 or csv_rows[0].note != "x,y" or csv_rows[1].note != "line1\nline2" {
    throw "FAIL serialization.csv_parse quoted";
}
let csv_out = serialization.csv_stringify(csv_rows, ["name", "note"]);
if not str_contains(csv_out, "\"x,y\"") { throw "FAIL serialization.csv_stringify quoted: " + csv_out; }

if serialization.detect_format("{\"a\":1}") != "json" { throw "FAIL serialization.detect_format json"; }
let as_yaml = serialization.convert("{\"a\":1}", "json", "yaml");
if not str_contains(as_yaml, "a: 1") { throw "FAIL serialization.convert json yaml: " + as_yaml; }

print "stdlib_smoke_pass";
