let R=import("stdlib:study_revision.sapp");let S=import("stdlib:study_cards.sapp");let D=import("stdlib:text_document.sapp");
fn notes(pairs,title="Notes") {let d=D.create(title);d.blocks=[];for p in pairs {array_push(d.blocks,map{kind:"heading",text:p.prompt});array_push(d.blocks,map{kind:"paragraph",text:p.answer});}D.validate(d);return d;}
fn rejects(f) {assert((try f() catch nil)==nil,"invalid revision rejected");}
let pairs=[map{prompt:"One?",answer:"First"},map{prompt:"Two?",answer:"Second"},map{prompt:"Three?",answer:"Third"}];
let original=S.create("Old",pairs,"2026-09-27");original=S.review(original,2,"good","2026-09-27");
let before=S.encode(original);let updated=notes([pairs[1],map{prompt:"One?",answer:"Revised"},map{prompt:"Four?",answer:"Fourth"}],"New");let input=D.encode(updated);
let r=R.from_document(original,updated,"2026-09-28");
assert(r.preserved==1 and r.added==2 and r.removed==2 and r.removed_ids==[1,3] and r.title_changed and r.changed,"revision counts");
assert(r.deck.cards[0]==original.cards[1] and r.deck.cards[0].id==2,"reorder retains complete progress and identity");
assert(r.deck.cards[1].id==1 and r.deck.cards[2].id==3,"new cards use smallest available IDs");
assert(r.deck.cards[1].due=="2026-09-28" and r.deck.cards[1].reviews==0 and r.deck.cards[1].last_review==nil,"changed answer starts fresh");
assert(r.rows[0].position==1 and r.rows[0].status=="preserved","report records new positions");
r.deck.cards[0].stage=0;assert(S.encode(original)==before and D.encode(updated)==input,"results detached from both sources");
let same=R.from_document(original,notes(pairs,"Old"),"2026-10-01");assert(not same.changed and S.encode(same.deck)==before,"unchanged cards ignore new initial date");
let reordered=R.from_document(original,notes([pairs[2],pairs[0],pairs[1]],"Old"),"2026-09-28");assert(reordered.preserved==3 and reordered.changed and reordered.deck.cards[2].reviews==1,"order itself is an explicit change");
let ambiguous=notes([pairs[0],pairs[0]]);rejects(fn(){R.from_document(original,ambiguous,"2026-09-28");});
let duplicates=S.create("Dup",[pairs[0],pairs[0]],"2026-09-27");rejects(fn(){R.from_document(duplicates,notes(pairs),"2026-09-28");});
let distinct=[map{prompt:"Same",answer:"A"},map{prompt:"Same",answer:"B"}];assert(R.from_document(S.create("X",distinct,"2026-09-27"),notes([distinct[1],distinct[0]]),"2026-09-28").preserved==2,"same prompt different answers is unambiguous");
rejects(fn(){R.from_document(original,updated,"2026-02-30");});rejects(fn(){R.from_document(map{},updated,"2026-09-28");});rejects(fn(){R.from_document(original,D.from_text("orphan"),"2026-09-28");});
let all=[];for i in range(0,64) {array_push(all,map{prompt:"Q"+str(i),answer:"A"+str(i)});}let maximum=S.create("Max",all,"2026-09-27");
let kept=[];for i in range(33,64) {array_push(kept,all[i]);}array_push(kept,map{prompt:"Added",answer:"New"});
let max_result=R.from_document(maximum,notes(kept),"2026-09-28");assert(max_result.preserved==31 and max_result.added==1 and max_result.removed==33 and max_result.deck.cards[31].id==1,"sparse high IDs plus additions fit bounded identity space");
assert(S.decode(S.encode(max_result.deck))==max_result.deck,"revised deck roundtrip");
print "study_revision_pass";
