// tests/semantics/harden_test.sapp — defensive app hardening: leave no secret in memory
// ("no clues"), compare secrets without timing leaks, detect tampering, and confirm the
// native binaries ship with no symbols/sections for RE tools to chew on.

let H = import("stdlib/harden.sapp");
let X = import("stdlib/codegen_x64.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── scrub: wipe a secret byte buffer in place (no lingering clues) ──────────────────
let secret = [115, 101, 99, 114, 101, 116];   // "secret"
let n = H.scrub(secret);
eq(n, 6, "scrub reports bytes wiped");
eq(secret[0], 0, "byte 0 wiped");
eq(secret[5], 0, "last byte wiped");

// with_secret runs a function then scrubs the buffer afterward
let buf = [9, 9, 9];
let saw = H.with_secret(buf, fn(b) { return b[0] + b[1] + b[2]; });
eq(saw, 27, "with_secret exposes the secret to the callback");
eq(buf[0], 0, "with_secret scrubs the buffer after use");

// ── constant-time comparison (no early-exit timing side channel) ────────────────────
eq(H.constant_time_eq([1, 2, 3, 4], [1, 2, 3, 4]), true, "equal buffers compare equal");
eq(H.constant_time_eq([1, 2, 3, 4], [1, 2, 9, 4]), false, "differing buffers compare unequal");
eq(H.constant_time_eq([1, 2, 3], [1, 2, 3, 4]), false, "different lengths are unequal");

// ── integrity / tamper detection ────────────────────────────────────────────────────
let tag = H.integrity_tag("important config v1");
eq(len(tag), 64, "integrity tag is a sha256 hex digest");
eq(H.verify_integrity("important config v1", tag), true, "unmodified payload verifies");
eq(H.verify_integrity("important config v2", tag), false, "tampered payload fails verification");

// ── native anti-clue: generated ELF has no section headers / symbol table ────────────
let elf = X.build_print_exit("x");
eq(H.native_is_stripped(elf), true, "generated ELF carries no section/symbol clues");

print "harden_pass";
