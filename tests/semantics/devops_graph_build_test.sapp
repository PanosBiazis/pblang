let Ops=import("stdlib:devops_pipeline.sapp");let Before=import("../../bench/fixtures/devops_pipeline_before_graph_build.sapp");
// Every forward-edge DAG on four vertices, in several non-topological orders.
for mask in range(0,64) {
    let graph=[];for i in range(0,4) {array_push(graph,map{id:"n"+str(i),needs:[]});}
    let bit=1;
    for child in range(1,4) {for parent in range(0,child) {
        if num_floor(mask/bit)%2==1 {array_push(graph[child].needs,"n"+str(parent));}bit=bit*2;
    }}
    for permutation in [[0,1,2,3],[3,2,1,0],[2,0,3,1]] {
        let jobs=[];for index in permutation {array_push(jobs,graph[index]);}
        let original=json_stringify(jobs);
        assert(Ops.order(jobs)==Before.order(jobs),"exact stable order parity");
        assert(Ops.select_jobs(jobs,["n3"])==Before.select_jobs(jobs,["n3"]),"target closure parity");
        assert(json_stringify(jobs)==original,"input graph unchanged");
    }
}
let dense=[];for child in range(0,32) {
    let needs=[];for parent in range(num_max(0,child-16),child) {array_push(needs,"n"+str(parent));}
    array_push(dense,map{id:"n"+str(child),needs:needs});
}
assert(Ops.order(dense)==Before.order(dense),"maximum dense graph parity");
for jobs in [nil,[],[map{id:"a",needs:[],extra:1}],[map{id:"a",needs:["missing"]}],[map{id:"a",needs:["a"]}],[map{id:"a",needs:[]},map{id:"b",needs:["a","a"]}],[map{id:"a",needs:["b"]},map{id:"b",needs:["a"]}]] {
    assert((try Ops.order(jobs) catch nil)==nil and (try Before.order(jobs) catch nil)==nil,"unchanged malformed graph rejection");
}
print "devops_graph_build_pass";
