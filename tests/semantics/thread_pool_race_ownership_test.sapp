// Observe real futures even when testing the earlier broken implementation.
let source=fs_read("stdlib/thread_pool.sapp");
source=str_replace_all(source,"thread_lib.go(","_go_injected(thread_lib,");
source=str_replace_all(source,"try _race_select(","try _select_injected(");
source=source+"\nlet injected=map{calls:0,fail:0,handles:[]};"
    +"fn _go_injected(lib,task){injected.calls=injected.calls+1;if injected.calls==injected.fail {throw \"injected launch\";}let h=lib.go(task);array_push(injected.handles,h);return h;}"
    +"fn _select_injected(lib,handles,ms){if injected.fail==-1 {throw \"injected selection\";}return _race_select(lib,handles,ms);}"
    +"fn reset(n){injected=map{calls:0,fail:n,handles:[]};}"
    +"fn snapshot(){return injected;} export reset,snapshot;";
let path=cwd()+"/.thread_pool_race_"+sha256(str(random_bytes(16)))+".sapp";
fs_write_bytes(path,str_to_bytes(source));
fn task(ms,value) { return fn(){sleep_ms(ms);return value;}; }
fn verify(P) {
    let T=import("stdlib:thread.sapp");
    let failures=[];
    for mode in ["winner","timeout","invalid","launch","firstlaunch","selection"] {
        let fail_at=0;
        if mode=="launch" {fail_at=2;}
        if mode=="firstlaunch" {fail_at=1;}
        if mode=="selection" {fail_at=-1;}
        P.reset(fail_at);
        let fns=[task(5,7),task(150,9)];
        if mode=="invalid" { fns=[task(5,7),false]; }
        let deadline=if mode=="timeout" {0} else {1000};
        let answer=try map{ok:true,value:P.race(fns,deadline)} catch map{ok:false,value:nil};
        let snapshot=P.snapshot();
        let settled=true;
        for handle in snapshot.handles {
            if not handle.__resolved {settled=false;}
            // Always join before assertions, even on a broken baseline.
            T.await(handle);
        }
        if not settled { array_push(failures,mode+" left an owned future unresolved"); }
        if mode=="invalid" and snapshot.calls!=0 {array_push(failures,"invalid tasks started work");}
        if mode=="winner" {assert(answer.ok and answer.value==7,"first success value");}
        if mode=="launch" or mode=="firstlaunch" or mode=="selection" or mode=="invalid" {assert(not answer.ok,"bad launch/input reported");}
    }
    assert(len(failures)==0,str(failures));
    return true;
}
let passed=try verify(import(path)) catch false;
fs_remove(path);
assert(passed,"thread_pool race ownership (all observed workers reaped)");
print "thread_pool_race_ownership_pass";
