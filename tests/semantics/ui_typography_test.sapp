let T=import("stdlib:ui_typography.sapp");
let UI=import("stdlib:modern_ui.sapp");
let Web=import("stdlib:modern_ui_web.sapp");
let Android=import("stdlib:modern_ui_android.sapp");
let GUI=import("stdlib:gui.sapp");
let a=T.preset("display",map{text_align:"center",name:"title"});
assert(a.font_size==40 and a.font_weight=="bold" and a.text_align=="center","simple display preset");
a.font_size=64;assert(T.preset("display").font_size==40,"presets return independent maps");
let overrides=map{font_size:24};let b=T.preset("body",overrides);b.font_size=30;
assert(overrides.font_size==24,"caller override map is unchanged");
for name in ["display","title","subtitle","body","caption"] {assert(T.validate(T.preset(name)),"valid preset");}
assert((try T.preset("unknown") catch nil)==nil,"unknown preset fails");
assert((try T.preset("body",[]) catch nil)==nil,"override map required");
for field in ["font_size","font_weight","text_align"] {
    let invalids=[nil,true,[],map{},"x;color:red",-1,0,7,65,16.5];
    for value in invalids {
        let opts=map{};opts[field]=value;
        assert((try T.validate(opts) catch false)==false,"invalid typography fails closed");
        assert(not UI.validate(UI.screen([UI.text("Bad",opts)])).ok,"shared UI validation");
    }
}
let view=UI.screen([UI.heading("Hello",T.preset("display",map{name:"title",text_align:"center"})),UI.text("World",T.preset("body",map{name:"body",text_align:"right"}))]);
let web=Web.generate("Type",UI.compile(view,map{target:"web"}));
assert(str_contains(web.css,"font-size:40px;font-weight:bold;text-align:center;"),"Web display typography");
assert(str_contains(web.css,"font-size:16px;font-weight:normal;text-align:right;"),"independent Web body typography");
let f=UI.build("Type",view);let title=GUI.get(f,"title");let body=GUI.get(f,"body");
assert(title.font_size==40 and title.font_weight=="bold" and title.text_align=="center","native options survive compilation");
assert(title.h>=50 and body.y>=title.y+title.h,"native layout reserves typography height");
GUI.relayout(f,420,800);assert(title.font_size==40 and title.text_align=="center","resize retains presentation");
let android=UI.compile(view,map{target:"android"});let bytes=Android.activity_class(android);
view.children[0].font_weight="normal";
assert(bytes!=Android.activity_class(android),"Android emits weight, not only metadata");
view.children[0].font_weight="bold";view.children[0].font_size=32;
assert(bytes!=Android.activity_class(android),"Android emits text size");
view.children[0].font_size=40;view.children[0].text_align="right";
assert(bytes!=Android.activity_class(android),"Android emits text alignment");
view.children[0].font_size="40px;color:red";
assert((try Android.activity_class(android) catch nil)==nil,"Android revalidates mutated source");
assert((try Web.generate("Type",UI.compile(view,map{target:"web"})) catch nil)==nil,"Web rejects invalid CSS values");
print "ui_typography_pass";
