// tests/semantics/gui_enrich_test.sapp — enrichment for stdlib/gui.sapp
// Adds a progress_bar widget plus widget_count and remove_widget form helpers.

let gui = import("stdlib/gui.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let f = gui.form("Demo", 400, 300);
gui.add(f, gui.label("lbl", 10, 10, "Hello"));
gui.add(f, gui.button("ok", 10, 40, 80, 24, "OK", nil));

// ── ENRICH: widget_count ─────────────────────────────────────────────────────────
eq(gui.widget_count(f), 2, "two widgets added");

// ── ENRICH: progress_bar widget ──────────────────────────────────────────────────
let pb = gui.progress_bar("load", 10, 80, 200, 16, 0.5);
eq(pb.kind, "progress", "progress kind"); eq(pb.value, 0.5, "progress value");
gui.add(f, pb);
eq(gui.widget_count(f), 3, "progress added");

// ── ENRICH: remove_widget ────────────────────────────────────────────────────────
gui.remove_widget(f, "ok");
eq(gui.widget_count(f), 2, "removed button");
if gui.get(f, "ok") != nil { fail("removed widget should not be found"); }
if gui.get(f, "lbl") == nil { fail("other widgets remain"); }

print "gui_enrich_pass";
