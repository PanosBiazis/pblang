// tests/semantics/encoding_base64_test.sapp
// encoding.base64_encode/decode must work and round-trip (regression: they called a
// non-existent base64_encode_builtin and always threw).
let enc = import("stdlib:encoding.sapp");

if enc.base64_encode("Hello") != "SGVsbG8=" { throw "FAIL base64_encode known vector"; }
if enc.base64_decode("SGVsbG8=") != "Hello" { throw "FAIL base64_decode known vector"; }

let msg = "pblang base64 round-trip 123!";
if enc.base64_decode(enc.base64_encode(msg)) != msg { throw "FAIL base64 round-trip"; }

print "encoding_base64_pass";
