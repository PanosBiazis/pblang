let WASM = import("stdlib:codegen_wasm.sapp");
let ARM = import("stdlib:codegen_arm64_ast.sapp");
let Pipeline = import("stdlib:execution_pipeline.sapp");

fn rejects(work) { return try { work(); false } catch true; }
fn expect_failure(source) {
    let result = Pipeline.build_source(source, "wasm32");
    assert(result.ok == false and result.target == "wasm32", "structured WASM rejection");
    assert(result.error == "WASM compilation rejected source" and len(result.diagnostics) == 0, "fixed pipeline error");
    assert(not map_has(result, "artifact") and not map_has(result, "artifact_bytes"), "no partial output on failure");
}
for source in ["return 7; /* private_canary", "fn main(){return 7;",
    "fn f(x=){return 1;} return f(2);", "let private_canary:=1;return private_canary;",
    "return 7; let s=\"private_canary", "fn f(x=0x){return 1;} return f(2);",
    "return 7; @private_canary"] {
    for compile in [WASM.compile_wasm, ARM.compile_ast, ARM.compile_elf] {
        assert(rejects(fn() { compile(source); }), "direct backends require checked AST");
    }
    expect_failure(source);
}
// A widened facade option cannot widen the backend's immutable source cap.
let oversized = "/*" + str_repeat(" ", 1048576 - 4) + "*/return 7;";
for compile in [WASM.compile_wasm, ARM.compile_ast, ARM.compile_elf] {
    assert(rejects(fn() { compile(oversized); }), "direct source cap");
}
let limited = Pipeline.build_source(oversized, "wasm32", map{ max_source_bytes: 2097152 });
assert(not limited.ok and not map_has(limited, "artifact"), "backend byte cap survives wider pipeline option");
let too_many_tokens = str_repeat("//\n", 65536) + "return 7;";
for compile in [WASM.compile_wasm, ARM.compile_ast, ARM.compile_elf] {
    assert(rejects(fn() { compile(too_many_tokens); }), "direct token cap");
}
expect_failure(too_many_tokens);
// Backend-specific rejection uses the same pipeline result contract.
expect_failure("import \"private_canary.sapp\"; return 7;");
for source in ["return 7;", "fn main(){return 7;}", "let x=1 return x;",
    "/* complete */ return 7;", "fn f(x=2){return x;} return f(2);", "let x:number=1;return x;"] {
    assert(len(WASM.compile_wasm(source)) > 8, "valid WASM after rejection");
    assert(len(ARM.compile_ast(source)) > 0 and len(ARM.compile_elf(source)) > 64, "valid ARM and ELF after rejection");
    assert(Pipeline.build_source(source, "wasm32").ok, "valid pipeline after rejection");
}
print "backend_source_admission_pass";
