if platform() != "linux" { print "wasm_local_cli_live_skip_linux_required"; os_exit(0); }
let UUID=import("stdlib:uuid.sapp"); let OS=import("stdlib:os.sapp");
let compiler=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let base=path_join(OS.temp_dir(),"pblang_wasm_cli_"+UUID.v4());
let source=base+".sapp"; let output=base+".wasm";
fn child(flags, legacy=false) {
    let args=["-k","1s","35s",compiler,"run","tools/pbc.sapp","--allow-all"];
    if not legacy { array_push(args,"--"); }
    for arg in [source,"--out",output] { array_push(args,arg); }
    for flag in flags { array_push(args,flag); }
    return proc_spawn_wait("/usr/bin/timeout",args);
}
fn preserved(flags, code) {
    let r=child(flags);
    assert(r.exit_code==code and fs_read(output)=="previous artifact","failure preserves output");
    assert(not str_contains(r.stdout+r.stderr,"private_canary"),"fixed rejection does not echo source");
}
fn exercise() {
    // Option preflight must finish even when the source file does not exist.
    fs_write(output,"previous artifact");
    for flags in [["--local-source"],["--target","arm64","--local-source"],
        ["--target","wasm","--max-tokens=4"],["--target","wasm","--local-source","--max-tokens=0"],
        ["--target","wasm","--local-source","--max-tokens=1e3"],
        ["--target","wasm","--local-source","--max-tokens=4","--max-tokens=5"],
        ["--target","wasm","--local-source","--local-source"],["--unknown"],
        ["--target"],["--out"],["--out","--local-source"],["--target","wasm","--target","arm64"]] { preserved(flags,2); }
    fs_write(source,str_repeat(" ",1048576)+str_repeat("0;",33000)+"return 42;");
    preserved(["--target","wasm"],1);
    preserved(["--target","wasm","--local-source","--max-source-bytes=1048576"],1);
    preserved(["--target","wasm","--local-source","--max-tokens=65536"],1);
    let good=child(["--target","wasm","--local-source"]);
    assert(good.exit_code==0,"large local CLI build");
    let run=proc_spawn_wait("node",["-e","WebAssembly.instantiate(require('fs').readFileSync(process.argv[1])).then(r=>console.log(String(r.instance.exports.main()))).catch(()=>process.exit(1));",output]);
    assert(run.exit_code==0 and run.stdout=="42\n","actual CLI artifact executes");
    fs_write(output,"previous artifact");
    fs_write(source,str_repeat(" ",1048576)+"return 42; /* private_canary");
    preserved(["--target","wasm","--local-source"],1);
    fs_write(source,"return 42;");
    let exact=child(["--target","wasm","--local-source","--max-source-bytes=10","--max-tokens=4"]);
    assert(exact.exit_code==0,"exact inclusive CLI budgets");
    assert(child(["--target","wasm"],true).exit_code==0,"legacy trailing source arguments");
}
let passed=try { exercise(); true } catch false;
for path in [source,output] {try fs_remove(path) catch nil;}
assert(passed,"local WASM CLI regression");
print "wasm_local_cli_live_pass";
