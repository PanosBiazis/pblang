let S=import("stdlib:security_analysis.sapp");
fn expect(ok,label) {if not ok {throw "FAIL dynamic-eval: "+label;}}
fn scan(source,options=nil) {return S.analyze(source,"fixture.sapp",options);}
for source in ["// constant fold: eval(a op b)\nlet x=1;",
    "/* eval(payload) */ let x=1;",
    "let text=\"eval(payload)\";",
    "try_eval_binary(1); self_eval(2);",
    "let eval=1;let value=eval;"] {
    let result=scan(source);
    expect(result.ok and result.passed and result.finding_count==0,"inert source");
}
for source in ["eval(payload);","eval /* gap */\n(payload);",
    "IR.eval(payload);","IR?.eval(payload);","eval\n(payload);",
    "IR.eval /* gap */ (payload);"] {
    let result=scan(source);
    expect(result.ok and not result.passed and result.finding_count==1,"call detected");
    expect(result.findings[0].id=="code.dynamic-eval" and result.findings[0].line==1,"stable rule and callee line");
}
let multiple=scan("eval(a); eval(b);\neval(c);");
expect(multiple.finding_count==2,"one finding per source line");
let scoped=scan("// pblang-security-ignore-next-line: code.dynamic-eval reason=trusted fixture\neval /* gap */\n(payload);\neval(other);");
expect(not scoped.passed and scoped.suppression_count==1 and scoped.finding_count==2,"suppression bound to callee line only");
let shifted=scan("let text=\"first\nsecond\";\neval(payload);");
expect(not shifted.passed and shifted.findings[0].line==3,"multiline string does not shift finding");
let escaped=scan("let text=\"first\\\nsecond\";\neval(payload);");
expect(not escaped.passed and escaped.findings[0].line==3,"physical escaped newline counted");
let control=scan("// pblang-security-ignore-next-line: code.dynamic-eval reason=only next line\nlet text=\"first\nsecond\";\neval(payload);");
expect(not control.passed and control.suppression_count==0 and control.findings[0].line==4,"multiline string cannot redirect suppression");
let after=scan("let text=\"first\nsecond\";\n// pblang-security-ignore-next-line: code.dynamic-eval reason=trusted fixture\neval(payload);");
expect(after.passed and after.suppression_count==1 and after.findings[0].line==4,"real directive after multiline string remains effective");
let preceding=scan("eval(payload);\nlet text=\"first\nsecond\";\n// pblang-security-ignore-next-line: code.dynamic-eval reason=later fixture\nlet clean=1;");
expect(not preceding.passed and preceding.suppression_count==0 and preceding.findings[0].line==1,"later directive cannot suppress earlier call");
for source in ["let text=\"eval(payload);","/* eval(payload);"] {
    let result=scan(source);
    expect(not result.passed and not result.mandatory_complete and result.mandatory_blocking>=1,"unterminated lexical input fails closed");
}
let custom=scan("// eval(payload);",map{custom_rules:[
    map{id:"project.literal",severity:"high",needle:"eval(",message:"literal policy"}]});
expect(not custom.passed and custom.finding_count==1 and custom.findings[0].id=="project.literal","different ID keeps literal policy");
let replaced=scan("// execute(payload);",map{custom_rules:[
    map{id:"code.dynamic-eval",severity:"high",needle:"execute(",message:"replacement policy"}]});
expect(not replaced.passed and replaced.findings[0].severity=="high","replacement needle keeps literal policy");
let disabled=scan("eval(payload);",map{disabled_rule_ids:["code.dynamic-eval"]});
expect(disabled.passed,"configured disable remains supported");
let protect=scan("eval(payload);",map{minimum_blocking_severity:"high"});
expect(protect.passed and protect.medium==1,"protect still reports medium");
let private_report=scan("eval(\"dynamic-eval-private-payload-marker\");");
expect(not str_contains(json_stringify(private_report),"dynamic-eval-private-payload-marker"),"finding does not echo payload");
let raw=scan("let text=\"first\nsecond\";\npolyglot_exec(\"x\");");
expect(not raw.passed and raw.mandatory_violation_count==1
    and raw.findings[0].line==3,"mandatory builtin survives physical line repair");
print "security_dynamic_eval_pass";
