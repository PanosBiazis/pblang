// Inject failures into a temporary copy of the real implementation; real
// channels verify that cleanup closes ownership and drains queued indices.
let source = fs_read("stdlib/async_pool_worker.sapp");
source = str_replace_all(source, "channel_buffered(n)", "_allocate(n)");
source = str_replace_all(source, "send(work.sender, i)", "_enqueue(work.sender, i)");
source = str_replace_all(source, "send(sender, i)", "_enqueue(sender, i)");
source = source + "\nlet state=map{allocation:0,sending:0,fail_allocation:0,fail_send:0,channels:[]};"
    + "fn _allocate(n){state.allocation=state.allocation+1;if state.allocation==state.fail_allocation {throw \"injected allocation\";}let ch=channel_buffered(n);array_push(state.channels,ch);return ch;}"
    + "fn _enqueue(sender,value){state.sending=state.sending+1;if state.sending==state.fail_send {throw \"injected enqueue\";}return send(sender,value);}"
    + "fn reset(a,s){state=map{allocation:0,sending:0,fail_allocation:a,fail_send:s,channels:[]};}"
    + "fn snapshot(){return state;} export reset,snapshot;";
let path = cwd() + "/.async_pool_initialization_" + sha256(str(random_bytes(16))) + ".sapp";
fs_write_bytes(path, str_to_bytes(source));
fn verify(W) {
    for failure in [[1,0],[2,0],[0,1],[0,3]] {
        W.reset(failure[0], failure[1]);
        let rejected = try { W.run_pool(2, [1,2,3,4], fn(x){ return x; }, false); false } catch true;
        assert(rejected, "injected failure is reported");
        let state = W.snapshot();
        assert(state.allocation == (if failure[0] == 1 {1} else {2}), "injection reached");
        for queue in state.channels {
            assert(channel_is_closed(queue.receiver), "every created queue is closed");
            assert(channel_size(queue.receiver) == 0, "abandoned input drained");
        }
        if failure[1] == 3 { assert(state.sending == 3, "partial queue exercised"); }
    }
    return true;
}
let passed = try verify(import(path)) catch false;
fs_remove(path);
assert(passed, "async pool initialization ownership");
// Ordinary task errors remain nil values; no change to successful call order.
let A = import("stdlib:async.sapp");
assert(A.pool(2,[fn(){return 7;},fn(){throw "task";},fn(){return nil;}]) == [7,nil,nil], "task contract");
print "async_pool_initialization_pass";
