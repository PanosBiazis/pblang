// tests/semantics/selfhost_typeck_test.sapp
//
// The self-hosted type checker was written against a different AST shape than the
// parser actually emits: it looked for "var" (parser: "ident"), call field "fn"
// (parser: "func"), array field "elements" (parser: "items"), and treated
// fn/if/while bodies as lists when they are "block" nodes — so it THREW on any
// real program with an array, call, or function. This locks it to the real AST:
// it must traverse without throwing and detect a basic scalar type mismatch
// without false positives.

let par = import("stdlib/compiler/parser.sapp");
let tok = import("stdlib/compiler/tokenizer.sapp");
let tc = import("stdlib/compiler/typeck.sapp");

fn fail(m) { throw "FAIL " + m; }
fn check(src) {
    let ast = par.parse(tok.tokenize(src));
    return tc.type_check(ast.stmts);
}
fn saw_mismatch(diags) {
    for d in diags { if str_contains(d.message, "mismatch") { return true; } }
    return false;
}

// Must NOT throw on a program using arrays, calls, functions, if and while.
let d1 = check("let a = [1, 2, 3]; let b = f(1, 2); fn g(n) { if n > 0 { return n; } while n < 5 { n = n + 1; } return n; }");
// Reaching here at all means it traversed the real AST without throwing.

// Detects a concrete scalar mismatch: declared number, value is a string.
if not saw_mismatch(check("let x: number = \"hello\";")) {
    fail("must detect number-vs-string mismatch");
}

// No false positive when the annotation matches the value.
if saw_mismatch(check("let y: number = 42;")) {
    fail("matching annotation must not be flagged");
}

// No false positive for an untyped let or one whose value type is unknown (any).
if saw_mismatch(check("let z = somethingFree[0];")) {
    fail("untyped let must not be flagged");
}
if saw_mismatch(check("let w: number = somethingFree;")) {
    fail("annotation vs unknown (any) value must not be flagged");
}

print "selfhost_typeck_pass";
