// Exercise the real polyglot facade without authorizing foreign execution.
let L=import("stdlib:latest_updates.sapp");
let P=import("stdlib:polyglot.sapp");
let q=L.new_buffer();
let languages=["python","javascript","c","rust","sql","html","future-format"];
for language in languages {
    q.submit(language,map{language:language,source:"obsolete",options:nil});
    q.submit(language,map{language:language,source:"latest",options:nil});
}
let state=map{calls:0,denied:0};
let report=q.flush(fn(key,job){
    if job.source!="latest" {throw "obsolete source reached dispatch";}
    state.calls=state.calls+1;
    let result=P.run_block(job.language,job.source,job.options);
    if not result.ok and not result.executed {state.denied=state.denied+1;}
    // Acknowledge handling the refusal, not successful foreign execution.
    return not result.executed;
});
if not report.ok or state.calls!=len(languages) or state.denied!=len(languages)
    or report.coalesced!=len(languages) {
    throw "FAIL polyglot coalescing must preserve refusal";
}
print "latest_updates_polyglot_pass";
