let S = import("stdlib:compiler/checked_source.sapp");
let T = import("stdlib:compiler/tokenizer.sapp");
let C = import("stdlib:compiler/ctranspile.sapp");
let I = import("stdlib:compiler/interp.sapp");
fn rejects(work) { return try { work(); false } catch true; }
let large = str_repeat(" ", 1048576) + "print 42;";
assert(rejects(fn() { S.parse_source(large); }), "strict source cap unchanged");
assert(len(S.parse_local_source(large).stmts) == 1, "local source above 1 MiB");
assert(rejects(fn() { S.parse_local_source(large, map{max_source_bytes:1048576}); }), "explicit local byte budget");
let many = str_repeat("//\n", 65536) + "let x = 7;";
assert(rejects(fn() { S.parse_source(many); }), "strict token cap unchanged");
assert(len(S.parse_local_source(many).stmts) == 1, "local source above strict token cap");
assert(rejects(fn() { S.parse_local_source(many, map{max_tokens:65536}); }), "explicit local token budget");
assert(T.tokenize_local("", 1048577).ok and not T.tokenize_bounded("", 1048577).ok,
    "local token budget does not inherit service ceiling");
assert(T.tokenize_local("", 1).token_count == 1 and not T.tokenize_local("1", 1).ok,
    "EOF included in budget");
assert(len(S.parse_local_source("\"😀\";", map{max_source_bytes:7,max_tokens:3}).stmts) == 1, "inclusive UTF-8 byte and token budgets");
assert(rejects(fn() { S.parse_local_source("\"😀\";", map{max_source_bytes:6}); }), "bytes rather than characters");
for bad in [0,-1,0.5,true,"10",[],map{},parse_number("NaN"),parse_number("inf"),9007199254740992] {
    assert(rejects(fn() { S.parse_local_source("", map{max_tokens:bad}); }), "invalid local token budget");
    assert(rejects(fn() { S.parse_local_source("", map{max_source_bytes:bad}); }), "invalid local byte budget");
    assert(not T.tokenize_local("", bad).ok, "invalid tokenizer budget");
}
assert(rejects(fn() { S.parse_local_source("", map{max_token:10}); }), "unknown option rejected");
assert(rejects(fn() { S.parse_local_source("", 7); }), "budget must be map");
for input in [nil,false,1,[],map{}] { assert(rejects(fn(){ S.parse_local_source(input); }), "nontext source rejected"); }
for suffix in ["/* private_canary", "let s=\"private_canary", "fn f(){", "let x=0x;"] {
    assert(rejects(fn() { S.parse_local_source("print 42;" + suffix); }), "local parsing cannot accept recovered AST");
}
let options = map{max_tokens:20}; S.parse_local_source("let x=1;", options);
assert(len(map_keys(options))==1, "caller budget not mutated");
let ast = I.compile_local_program("let n=40;n=n+2;if n!=42{missing();}");
assert(I.eval_ast(ast) and I.eval_ast(ast), "local prepared AST reuse");
assert(rejects(fn(){ I.compile_program(large); }), "strict interpreter entry unchanged");
assert(rejects(fn(){ C.transpile_program_local("import \"missing.sapp\"; print 1;", nil, "integer"); }),
    "local integer emission failure rejects");
let floating = C.transpile_program("print 7 / 2;");
assert(str_contains(floating,"double") and not str_contains(floating,"%lld"),
    "strict float translation after local integer emission failure");
print "local_source_admission_pass";
