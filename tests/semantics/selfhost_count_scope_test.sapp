let F = import("stdlib:compiler/selfhost_frontend.sapp");
let V = import("stdlib:compiler/vm.sapp");
fn expect(ok, message) { if not ok { throw "FAIL numeric-loop: " + message; } }
fn run(source) {
    let compiled = F.frontend_compile(source);
    expect(compiled.ok and len(compiled.diagnostics) == 0, "checked compilation");
    let plain = V.run_bounded(compiled.chunk, map{ max_steps: 5000, max_frames: 12 });
    let optimized = F.frontend_run_bounded(source, map{ max_steps: 5000, max_frames: 12 });
    expect(optimized.ok and plain.globals.result == optimized.globals.result, "plain/optimized agree");
    return plain.globals.result;
}
expect(run("let x = 99; for x 2 { } let result = x;") == 99, "outer global restored");
expect(run("fn f(x) { for x 2 { } return x; } let result = f(99);") == 99, "outer local restored");
expect(run("let x = 99; for x 0 { } for x -2 { } let result = x;") == 99, "empty and negative counts");
expect(run("let x = 3; let seen = []; for x x { array_push(seen, x); } let result = [x, seen];") == [3, [0, 1, 2]], "bound reads outer binder");
expect(run("let seen = []; fn bound() { array_push(seen, 9); return 2; } for x bound() { array_push(seen, x); } let result = seen;") == [9, 0, 1], "bound evaluated once");
expect(run("let n = 3; let seen = []; for x n { array_push(seen, x); n = 0; } let result = seen;") == [0, 1, 2], "bound value retained");
expect(run("let seen = []; for x 3 { array_push(seen, x); x = 100; } let result = seen;") == [0, 1, 2], "binder does not change internal counter");
expect(run("let x = 99; let seen = []; for x 2 { for x 1 { array_push(seen, x); } array_push(seen, x); } let result = [x, seen];") == [99, [0, 0, 0, 1]], "nested binders");
expect(run("let x = 99; let seen = []; for x 4 { if x == 0 { continue; } let y = x; array_push(seen, y); if x == 2 { break; } } let result = [x, seen];") == [99, [1, 2]], "continue and break");
expect(run("let x = 99; let seen = []; for x 1 { array_push(seen, x); } for x 2 { array_push(seen, x); } let result = [x, seen];") == [99, [0, 0, 1]], "sibling binders");
expect(run("let π = 99; for π 2 { } let result = π;") == 99, "Unicode binder");
expect(run("fn f(x) { let out = []; for x 2 { array_push(out, fn() { return x; }); } return [out[0](), out[1](), x]; } let result = f(99);") == [0, 1, 99], "by-value closures");
expect(run("let __for_bound_x = 2; let __for_i_x = 9; let seen = []; for x __for_bound_x { array_push(seen, __for_i_x); } let result = seen;") == [9, 9], "helper-like source names");
expect(run("fn f() { for x 2 { return x + 7; } return 0; } let result = f();") == 7, "early return");
expect(not F.frontend_compile("for x 1 { } let result = x;").ok, "binder does not leak into outer checked scope");
expect(run("let seen = []; fn bound() { array_push(seen, 9); return 0; } for x bound() { array_push(seen, 1); } let result = seen;") == [9], "empty count still evaluates bound once");
expect(run("let seen = []; fn boom() { array_push(seen, 9); throw 4; } fn f() { for x boom() { array_push(seen, 1); } return 0; } let result = [try f() catch 5, seen];") == [5, [9]], "bound exception skips body");
expect(not F.frontend_compile("for x absent { }").ok, "undefined bound rejected");
expect(not F.frontend_compile("for x 2 {").ok, "malformed loop rejected");
print "selfhost_count_scope_pass";
