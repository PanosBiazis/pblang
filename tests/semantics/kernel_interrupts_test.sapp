// Test: language readiness for INTERRUPT-DRIVEN kernel code (IDT + handlers +
// keyboard), via the C transpiler. Verifies the transpiler emits correct native
// C for: GCC interrupt handlers (functions named `isr...`), `addr_of` (handler
// addresses), the `lidt` intrinsic, and the IDT/PIC/keyboard primitives in
// stdlib/kernel/interrupts.sapp. (Offline, the generated kernel compiles to a
// native object with `gcc -m32 -ffreestanding -mgeneral-regs-only -c`. A full
// boot of an interrupt FIRING additionally needs a float-runtime-free codegen
// mode or 32-bit libgcc — see PrjAnalysis §72.)

let ct = import("stdlib/compiler/ctranspile.sapp");
let intr = fs_read("stdlib/kernel/interrupts.sapp");

let src = "fn isr_kbd() { let sc = kbd_scancode(); pic_eoi(); } "
    + "fn kmain() { let idt = kmalloc(2048); pic_remap(); "
    + "idt_set_gate(idt, 33, addr_of(\"isr_kbd\"), 8, 142); idt_load(idt); sti(); "
    + "while 1 > 0 { hlt(); } }";
let c = ct.transpile_kernel(intr + src);

// --- Interrupt-handler codegen: `isr*` → GCC interrupt attribute ---
assert(str_contains(c, "__attribute__((interrupt)) void isr_kbd(void* _frame)"), "isr function -> GCC interrupt handler (correct prologue/epilogue + iret)");
assert(not str_contains(c, "double isr_kbd"), "an interrupt handler is NOT emitted as a normal double-returning fn");

// --- addr_of: a function's address as a number (to install into an IDT gate) ---
assert(str_contains(c, "(double)(u64)&isr_kbd"), "addr_of(\"isr_kbd\") -> &isr_kbd");

// --- lidt intrinsic to load the IDT register ---
assert(str_contains(c, "lidt (%0)"), "lidt intrinsic present in the kernel preamble");
assert(str_contains(c, "static inline u32 peek32"), "peek32 (32-bit MMIO read) present");

// --- IDT/PIC/keyboard primitives transpiled ---
assert(str_contains(c, "double idt_set_gate("), "idt_set_gate transpiled");
assert(str_contains(c, "double idt_load("), "idt_load transpiled");
assert(str_contains(c, "double pic_remap("), "pic_remap transpiled");
assert(str_contains(c, "inb(96)"), "kbd_scancode reads keyboard data port 0x60");
assert(str_contains(c, "inb(100)"), "kbd_status reads keyboard status port 0x64");
assert(str_contains(c, "outb(32, 32)"), "pic_eoi sends End-Of-Interrupt to the PIC");

// --- It's a complete bootable unit ---
assert(str_contains(c, "0x1BADB002"), "multiboot header present");
assert(not str_contains(c, "#include"), "freestanding (no libc)");

print "kernel_interrupts_pass";
