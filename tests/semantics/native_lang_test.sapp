// tests/semantics/native_lang_test.sapp — a front end: lower real arithmetic expression ASTs
// to the register IR and run them as native machine code. This is "ordinary code -> native".

let L = import("stdlib/native_lang.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// AST: ["lit", n] | ["+"/"-"/"*", left, right]
let e1 = ["*", ["+", ["lit", 2], ["lit", 3]], ["+", ["lit", 4], ["lit", 5]]];   // (2+3)*(4+5)=45
let e2 = ["-", ["lit", 100], ["lit", 58]];                                       // 42
let e3 = ["+", ["lit", 1000], ["*", ["lit", 7], ["lit", 6]]];                    // 1042

// lowering produces valid IR that leaves the result in r0
let ir = L.compile_expr(e1);
if len(ir) < 1 { fail("compile_expr produced no IR"); }

// evaluated by the portable interpreter (always available)
eq(L.eval_const(e1), 45, "const eval (2+3)*(4+5)");
eq(L.eval_const(e2), 42, "const eval 100-58");
eq(L.eval_const(e3), 1042, "const eval 1000+7*6");

// and compiled to NATIVE machine code + run (where the host supports it)
if L.native_available() {
    eq(L.eval_expr(e1), 45, "native (2+3)*(4+5)");
    eq(L.eval_expr(e2), 42, "native 100-58");
    eq(L.eval_expr(e3), 1042, "native 1000+7*6");
}

// ── DEPTH LIMIT LIFTED: deep right-nested trees now compile via the value stack ──────
let deep = ["+", ["lit", 1], ["+", ["lit", 1], ["+", ["lit", 1], ["+", ["lit", 1], ["lit", 1]]]]];
eq(L.eval_const(deep), 5, "deep expression const-evals");
if L.native_available() { eq(L.eval_expr(deep), 5, "deep expression compiles to native (no depth limit)"); }

// ── VARIABLES + assignment: a real program compiles to native ───────────────────────
// x=10; y=20; return x*y + x  -> 210
let prog = [
    ["set", "x", ["lit", 10]],
    ["set", "y", ["lit", 20]],
    ["ret", ["+", ["*", ["var", "x"], ["var", "y"]], ["var", "x"]]]
];
eq(L.eval_program_const(prog), 210, "program const-eval x*y+x");
if L.native_available() { eq(L.eval_program(prog), 210, "program compiles to native"); }

// a variable reused in a bigger expression (depth + multiple vars)
let prog2 = [
    ["set", "a", ["lit", 7]],
    ["set", "b", ["+", ["var", "a"], ["lit", 3]]],   // b = 10
    ["ret", ["*", ["var", "b"], ["+", ["var", "a"], ["var", "b"]]]]   // 10*(7+10)=170
];
eq(L.eval_program_const(prog2), 170, "program2 const");
if L.native_available() { eq(L.eval_program(prog2), 170, "program2 native"); }

// ── FLOAT expressions (scientific) compile to native SSE2 ───────────────────────────
let fe = ["f*", ["f+", ["flit", 1.5], ["flit", 2.5]], ["flit", 2.0]];   // (1.5+2.5)*2 = 8.0
let fd = ["f/", ["flit", 22.0], ["flit", 7.0]];                          // 22/7 ≈ 3.142857
fn fclose(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.000001 { fail(m + " got=" + str(a)); } }
fclose(L.eval_fconst(fe), 8.0, "float const (1.5+2.5)*2");
if L.native_available() {
    fclose(L.eval_fexpr(fe), 8.0, "native float (1.5+2.5)*2");
    fclose(L.eval_fexpr(fd), 22.0 / 7.0, "native float 22/7 (real division)");
}

print "native_lang_pass";
