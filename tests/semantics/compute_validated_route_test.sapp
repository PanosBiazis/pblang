let CP = import("stdlib:compute.sapp");
let A = import("stdlib:accelerator.sapp");
fn square(items) {
    let out = []; let i = 0;
    while i < len(items) { array_push(out, items[i] * items[i]); i = i + 1; }
    return out;
}
A.clear_runtimes();
let hooks = ["gpu", "npu", "simd", "distributed"];
let h = 0;
while h < len(hooks) { A.register_runtime(hooks[h], square); h = h + 1; }
let kinds = ["auto", "cpu", "sequential", "gpu", "npu", "simd", "distributed"];
let workloads = ["generic", "numeric", "tensor", "inference", "batch"];
let sizes = [0, 1, 2, 31, 32, 256];
let device_sets = [[], [map{ kind: "gpu", usable: true }, map{ kind: "npu", usable: true },
    map{ kind: "simd", usable: true }, map{ kind: "distributed", usable: true }]];
let records = []; let k = 0;
while k < len(kinds) {
    let w = 0;
    while w < len(workloads) {
        let n = 0;
        while n < len(sizes) {
            let items = []; let i = 0;
            while i < sizes[n] { array_push(items, i); i = i + 1; }
            let d = 0;
            while d < len(device_sets) {
                let opts = map{ preferred_device: kinds[k], workload: workloads[w], devices: device_sets[d],
                    max_workers: 1, min_accelerator_items: 1 };
                let expected = CP.select_device(len(items), device_sets[d], CP.policy(opts));
                let actual = CP.run_controlled(items, fn(x) { return x * x; }, opts);
                assert(actual.route == expected and actual.results == square(items), "internal/public route and output parity");
                array_push(records, actual.route);
                d = d + 1;
            }
            n = n + 1;
        }
        w = w + 1;
    }
    k = k + 1;
}
A.clear_runtimes();
let fields = ["max_workers", "min_parallel_items", "min_accelerator_items", "work_units_per_item",
    "transfer_bytes_per_item", "parallel_overhead_units", "min_work_units_per_worker",
    "gpu_overhead_units", "npu_overhead_units", "simd_overhead_units", "distributed_overhead_units",
    "transfer_bytes_per_work_unit", "max_accelerator_transfer_bytes"];
let invalid = [-1, 0.5, "1", [], map{}, true, 9007199254740992];
let f = 0;
while f < len(fields) {
    let i = 0;
    while i < len(invalid) {
        let opts = map{ preferred_device: "cpu", devices: [], max_workers: 1, validated: true,
            format: "pblang.compute.policy.v1" };
        opts[fields[f]] = invalid[i];
        let calls = map{ n: 0 };
        let worker = fn(x) { calls.n = calls.n + 1; return x; };
        assert((try CP.run_controlled([], worker, opts) catch "rejected") == "rejected", "empty input still validates every field");
        assert((try CP.run_controlled([1], worker, opts) catch "rejected") == "rejected", "format/validated fields cannot skip policy checks");
        assert(calls.n == 0, "invalid policy never invokes worker");
        let cfg = CP.policy(map{ max_workers: 1 }); cfg[fields[f]] = invalid[i];
        assert((try CP.select_device(256, [], cfg) catch "rejected") == "rejected", "public selector revalidates mutated policy");
        i = i + 1;
    }
    let opts = map{ max_workers: 1, devices: [] }; opts[fields[f]] = nil;
    assert(CP.run_controlled([2], fn(x) { return x*x; }, opts).route == CP.select_device(1, [], CP.policy(opts)),
        "nil scalar options retain defaults");
    f = f + 1;
}
let opts = map{ devices: [], preferred_device: "cpu", max_workers: 1 };
let first = CP.run_controlled([2], fn(x) { opts.work_units_per_item = -1; return x; }, opts);
assert(first.ok and first.route.estimate.work_units == 1, "worker cannot change the current private policy");
assert((try CP.run_controlled([2], fn(x) { return x; }, opts) catch "rejected") == "rejected", "next request observes changed options");
opts = map{ devices: [map{ kind: "gpu", usable: true }], preferred_device: "gpu",
    workload: "tensor", max_workers: 1, min_accelerator_items: 1 };
A.register_runtime("gpu", fn(_payload) { opts.max_workers = 0; throw "expected hook failure"; });
let fallback = CP.run_controlled([2,3], fn(x) { return x*x; }, opts);
assert(fallback.ok and fallback.route.fallback_used and fallback.results == [4,9], "fallback owns a policy snapshot before hook invocation");
assert((try CP.run_controlled([2], fn(x) { return x; }, opts) catch "rejected") == "rejected", "hook changes checked on next call");
A.clear_runtimes();
assert((try CP._select_device catch "private") == "private" and (try CP._estimate_values catch "private") == "private", "private path is not exported");
print "compute_validated_route_pass|" + str(len(records)) + "|" + sha256(json_stringify(records));
