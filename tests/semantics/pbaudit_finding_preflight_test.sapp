let OS=import("stdlib:os.sapp");
if platform()!="linux" {print "pbaudit_finding_preflight_skip_linux_required";os_exit(0);}
let compiler=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let fixture=path_join(cwd(),"tests/fixtures/finding-preflight-"+str_slice(sha256(str(now_ms())+str(random_bytes(8))),0,16));
let output=path_join(OS.temp_dir(),path_basename(fixture)+".json");let marker="preserve-private-report-marker";
let failure="unexpected exception";
fn expect(ok,label) {if not ok {failure=label;throw label;}}
fn invoke(flags) {
    let args=["-k","1s","8s",compiler,"tools/pbaudit.sapp","--allow-all","--","--json-output="+output,fixture];
    for flag in flags {push(args,flag);}
    return proc_spawn_wait("/usr/bin/timeout",args);
}
fn exercise() {
    // Invalid requests must preserve even an unreadable-as-JSON old report.
    fs_write(output,marker);
    for mode in [[],["--module-by-module"],["--module-by-module","--resume"]] {
        for value in ["private-limit-marker","NaN","inf","-inf","1.5","0","4097",""] {
            let flags=[];for flag in mode {push(flags,flag);}push(flags,"--max-findings="+value);
            let result=invoke(flags);
            expect(result.exit_code==2 and str_trim(result.stdout)=="pbaudit: max_findings must be a finite integer in 1..4096","exact preflight diagnostic in every mode");
            expect(str_trim(result.stderr)=="" and fs_exists(output) and fs_read(output)==marker,"old report preserved and private values not echoed");
        }
    }
    let reverse=invoke(["--max-findings=1","--max-findings=invalid"]);
    expect(reverse.exit_code==2 and fs_read(output)==marker,"invalid final duplicate preserves report");
    fs_mkdirs(fixture);fs_write(fixture+"/main.sapp","let value=1;\n");
    for flags in [[],["--max-findings=1.0"],["--max-findings=4096"],["--max-findings=invalid","--max-findings=1"]] {
        let result=invoke(flags);
        expect(result.exit_code==0,"valid defaults/integral syntax and last-option-wins");
        let report=json_parse(fs_read(output));
        expect(report.complete and report.quality_gate.passed and report.collected.record_count==1,"normal report remains valid");
    }
    return true;
}
let succeeded=try exercise() catch false;
if fs_exists(fixture+"/main.sapp") {fs_remove(fixture+"/main.sapp");}
if fs_exists(fixture) {fs_remove(fixture);}
if fs_exists(output) {fs_remove(output);}
if not succeeded {throw "FAIL pbaudit-finding-preflight: "+failure;}
print "pbaudit_finding_preflight_pass";
