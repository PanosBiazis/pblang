let Assembly = import("stdlib:mips_assembly.sapp");

fn require(value, message) {
    if not value { throw "mips assembly test failed: " + message; }
}

let source = "addi $t0,$t0,10\naddi $t1,$t1,15\nadd $s0,$t0,$t1\nsw $s0,0x0($t2)\nadd $s2,$s0,$t2\n";
let result = Assembly.execute(source);
require(result.ok and result.assembled.instruction_count == 5,
    "reference snippet must assemble and execute");
require(result.execution.registers[8] == 10 and result.execution.registers[9] == 15
    and result.execution.registers[16] == 25 and result.execution.registers[18] == 25,
    "reference arithmetic registers must match");
require(result.execution.memory["0"] == 25 and result.execution.memory_writes == 1,
    "reference SW must write one aligned word");
require(not result.assembled.source_retained and len(result.assembled.warnings) == 0,
    "strict parse must retain no source and emit no warning");

let legacy = Assembly.execute("addi $s0,4\naddi $s1,5\naddi $s3,$zero\nadd $s3,$s0,$s1\n",
    map{ legacy_shorthand: true });
require(legacy.ok and legacy.execution.registers[19] == 9
    and len(legacy.assembled.warnings) == 3,
    "explicit legacy shorthand must normalize with one warning per line");
require(not Assembly.assemble("addi $s0,4").ok,
    "strict mode must reject legacy shorthand");
require(not Assembly.assemble("jump nowhere").ok,
    "unsupported opcode must fail closed");
require(Assembly.assemble("sw $s0,2($zero)").ok,
    "aligned-address validity is an execution concern after successful assembly");
require(not Assembly.execute("sw $s0,2($zero)").ok,
    "unaligned SW must fail at execution");
require(not Assembly.assemble(42).ok, "non-string source must fail closed");
require(not Assembly.assemble("", map{ max_lines: 1 }).ok,
    "empty source must fail closed");
require(not Assembly.assemble("nop\nnop", map{ max_instructions: 1 }).ok,
    "instruction ceiling must fail closed");
require(Assembly.register_number("$ra") == 31 and Assembly.register_number("16") == 16
    and Assembly.register_number("$unknown") == nil, "register aliases and numbers");

print "mips_assembly_pass";
