// quantum_run_test.sapp — Q3-alpha: run(circ) returns array of measurements; measurement helpers.
import "stdlib:quantum.sapp";

let circ = quantum.circuit(2);
circ = quantum.apply_h(circ, 0);
circ = quantum.apply_cnot(circ, 0, 1);
circ = quantum.measure_all(circ);

let results = quantum.run(circ);
if len(results) != 2 { print "FAIL run len"; }
if results[0] != 0 and results[0] != 1 { print "FAIL run qubit 0"; }
if results[1] != 0 and results[1] != 1 { print "FAIL run qubit 1"; }

let s = quantum.measurements_to_string(results);
if len(s) != 2 { print "FAIL measurements_to_string len"; }
let n = quantum.measurements_to_int(results);
if n < 0 or n > 3 { print "FAIL measurements_to_int range"; }

print "quantum_run_test: pass";
