let Switch = import("stdlib:implementation_switch.sapp");
fn check(ok, note) { if not ok { throw "implementation switch: " + note; } }
let calls = map{retained: 0, replacement: 0, failed: 0};
let retained = fn() { calls.retained = calls.retained + 1; return "retained"; };
let replacement = fn() { calls.replacement = calls.replacement + 1; return "replacement"; };
let choices = map{polyglot: retained, pblang: replacement};
let selected = Switch.bind(true, "pblang", choices);
check(calls.retained == 0 and calls.replacement == 0, "bind has no constructor effect");
choices.pblang = retained;
check(selected() == "replacement" and calls.retained == 0, "bound selection survives registry mutation");
check(Switch.open(true, "pblang", choices) == "retained", "a new explicit selection sees registry mutation");
choices.pblang = replacement;
for operation in [Switch.bind, Switch.open] {
    let before = calls.retained + calls.replacement;
    for disabled in [false, nil, "false", 0, 1, [], map{}] {
        check((try operation(disabled, "polyglot", choices) catch "rejected") == "rejected", "exact enablement required");
    }
    for name in ["missing", "", "../polyglot", "POLYGLOT", "a-b", "λ", "a b", nil, 5, [], map{}] {
        check((try operation(true, name, choices) catch "rejected") == "rejected", "invalid or unavailable selection");
    }
    let longest = ""; let n = 0;
    while n < 64 { longest = longest + "a"; n = n + 1; }
    let registry = map{}; registry[longest] = replacement;
    let valid = operation(true, longest, registry);
    if type(valid) == "closure" { check(valid() == "replacement", "maximum identifier callable"); }
    check((try operation(true, longest + "a", registry) catch "rejected") == "rejected", "identifier length bound");
    for registry_value in [nil, [], false, 0, "pblang"] {
        check((try operation(true, "pblang", registry_value) catch "rejected") == "rejected", "registry must be map");
    }
    for value in [nil, map{}, [], true, 1, "callable"] {
        check((try operation(true, "pblang", map{pblang:value}) catch "rejected") == "rejected", "factory must be callable");
    }
    check(calls.retained + calls.replacement == before + 1, "rejected policies have no constructor effects");
}
let failed = fn() { calls.failed = calls.failed + 1; throw "fixture failure"; };
check((try Switch.open(true, "pblang", map{pblang:failed, polyglot:retained}) catch "rejected") == "rejected", "selected failure propagates");
check(calls.failed == 1 and calls.retained == 1, "failure neither retries nor falls back");
let dormant = fn() { throw "must remain dormant"; };
check(Switch.open(true, "pblang", map{pblang:replacement, polyglot:dormant}) == "replacement", "inactive throwing code retained");
for value in [nil, false, 0, "", [], map{}] {
    check(Switch.open(true, "pblang", map{pblang:fn() { return value; }}) == value, "false-like result never triggers fallback");
}
let identity = fn(value) { return value; };
let bound = Switch.bind(true, "pblang", map{pblang:identity});
check(bound("argument") == "argument", "bind preserves callable arguments");
let length = Switch.bind(true, "pblang", map{pblang:len});
check(length([1,2,3]) == 3, "builtin callable supported");
check((try Switch.open(false, nil, nil) catch "rejected") == "rejected", "disabled selection needs no registry");
print "implementation_switch_pass";
