// Test: stdlib/blocks.sapp -- block programming + mixed code/block programming.

let B = import("stdlib:blocks.sapp");
let F = import("stdlib/compiler/selfhost_frontend.sapp");

let ws = B.workspace();
B.set_code(ws, "fn square(x) { return x * x; }\n");
B.add(ws, B.raw("let from_raw = 3;"));
B.add(ws, B.fn_block("main", [], [
    B.let_stmt("x", B.call("square", [B.num(6)])),
    B.if_stmt(
        B.binop(">", B.var("x"), B.num(20)),
        [B.print_stmt(B.text("big"))],
        [B.print_stmt(B.text("small"))]
    ),
    B.print_stmt(B.binop("+", B.var("x"), B.var("from_raw"))),
]));

let code = B.to_code(ws);
assert(str_contains(code, "fn square"), "workspace keeps handwritten code");
assert(str_contains(code, "let from_raw = 3;"), "raw code block is included");
assert(str_contains(code, "fn main()"), "function block generates a function");
assert(str_contains(code, "if (x > 20)"), "if block renders condition");

let check = B.validate(ws);
assert(check.ok, "valid block workspace has no diagnostics");

let bad = B.validate(B.block("unknown_kind", map{}, []));
assert(not bad.ok and bad.count == 1, "unknown block kind is diagnosed");

let generated = B.compose("let greeting = \"hello\";", [
    B.print_stmt(B.var("greeting")),
    B.print_stmt(B.map_expr([
        B.map_entry("answer", B.num(42)),
        B.map_entry("label", B.text("life")),
    ])),
]);
assert(str_contains(generated, "let greeting"), "compose keeps code prefix");
assert(str_contains(generated, "map{answer: 42"), "map expression renders");

let run = F.frontend_run(code + "\nmain();");
assert(run.ok, "generated block program compiles and runs");
assert(run.output[0] == "big", "generated branch output");
assert(run.output[1] == 39, "generated expression used handwritten code");

print "blocks_programming_pass";
