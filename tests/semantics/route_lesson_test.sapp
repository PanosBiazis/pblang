let Route=import("stdlib:route_lesson.sapp");
fn edge(a,b,c) {return map{from:a,to:b,cost:c};}
fn rejects(f) {let rejected=false;try {f();} catch {rejected=true;}assert(rejected,"invalid graph rejected");}
let spec=map{nodes:["A","B","C","D","Z"],edges:[edge("A","B",8),edge("A","C",2),edge("C","B",1),edge("B","D",2),edge("C","D",9)]};
let r=Route.analyze(spec,"A","D");assert(r.path==["A","C","B","D"] and r.cost==5,"weighted path, not fewest hops");
let sum=0;for e in r.edges {if e.on_path {sum=sum+e.cost;}}assert(sum==r.cost,"selected edges explain cost");
assert(not r.nodes[4].reachable and r.nodes[4].distance==nil,"unreachable is not sentinel distance");
let no=Route.analyze(spec,"D","A");assert(not no.reachable and no.cost==nil and no.path==[],"edges are directed");
let same=Route.analyze(spec,"Z","Z");assert(same.path==["Z"] and same.cost==0,"source is target");
r.edges[0].cost=42;r.nodes[0].id="changed";assert(spec.edges[0].cost==8 and spec.nodes[0]=="A","detached report");
let tie=map{nodes:["A","B","C","D"],edges:[edge("A","B",1),edge("A","C",1),edge("C","D",1),edge("B","D",1),edge("B","A",1)]};
assert(Route.analyze(tie,"A","D").path==["A","C","D"],"first declared shortest predecessor, cycle terminates");
let large=map{nodes:[],edges:[]};for i in range(0,32) {array_push(large.nodes,"N"+str(i));if i>0 {array_push(large.edges,edge("N"+str(i-1),"N"+str(i),1000000));}}
let chain=Route.analyze(large,"N0","N31");assert(chain.cost==31000000 and len(chain.path)==32,"maximum chain with exact cost");
let image=Route.diagram(spec,"A","D");assert(image.report==Route.analyze(spec,"A","D") and str_contains(image.svg,"unreachable") and str_contains(image.svg,"#4ade80"),"diagram uses same report");
assert(not str_contains(image.svg,"<script") and not image.report.network_access_performed,"passive supplied-graph diagram");
for bad in [0,-1,1.5,1000001,"1",nil] {rejects(fn(){Route.analyze(map{nodes:["A","B"],edges:[edge("A","B",bad)]},"A","B");});}
for bad in [map{nodes:[],edges:[]},map{nodes:["A","A"],edges:[]},map{nodes:["A"],edges:[edge("A","B",1)]},map{nodes:["A"],edges:[edge("A","A",1)]},map{nodes:["A","B"],edges:[edge("A","B",1),edge("A","B",2)]},map{nodes:["<script>"],edges:[]},map{nodes:["A"],edges:[],extra:true}] {rejects(fn(){Route.analyze(bad,"A","A");});}
rejects(fn(){Route.analyze(spec,"missing","A");});
let dense=map{nodes:[],edges:[]};for i in range(0,16) {array_push(dense.nodes,"N"+str(i));}
for i in range(0,16) {for j in range(0,16) {if i!=j and len(dense.edges)<129 {array_push(dense.edges,edge("N"+str(i),"N"+str(j),1));}}}
rejects(fn(){Route.analyze(dense,"N0","N15");});array_pop(dense.edges);
assert(Route.analyze(dense,"N0","N15").cost==1,"128 edges accepted, 129 rejected");
rejects(fn(){Route.analyze(map{nodes:["abcdefghijklmnopq"],edges:[]},"abcdefghijklmnopq","abcdefghijklmnopq");});
array_push(large.nodes,"N32");rejects(fn(){Route.analyze(large,"N0","N31");});
print "route_lesson_pass";
