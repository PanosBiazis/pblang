// Test: fs.sapp security validation and convenience helpers
let fs = import("stdlib:fs.sapp");

// Safe paths should work
let ok1 = type(fs.read("pblang.toml")) == "string";
assert(ok1, "fs.read should read a real file");

// Absolute path should be blocked by default
let err1 = try fs.read("/etc/passwd") catch "blocked";
assert(err1 == "blocked", "fs.read should block absolute paths");

// Path traversal should be blocked
let err2 = try fs.read("../../etc/passwd") catch "blocked";
assert(err2 == "blocked", "fs.read should block path traversal");

// Nested traversal
let err3 = try fs.read("docs/../../../etc/passwd") catch "blocked";
assert(err3 == "blocked", "fs.read should block nested traversal");

// read_json and write_json round-trip
let test_path = "target/fs_test_tmp.json";
let data = map{ x: 42, name: "test" };
fs.write_json(test_path, data);
let read_back = fs.read_json(test_path);
assert(read_back.x == 42, "read_json should preserve values");
assert(read_back.name == "test", "read_json should preserve string values");
fs.remove(test_path);

// read_lines / write_lines round-trip
let lines_path = "target/fs_lines_tmp.txt";
let lines = ["line1", "line2", "line3"];
fs.write_lines(lines_path, lines);
let read_lines = fs.read_lines(lines_path);
assert(len(read_lines) >= 3, "read_lines should return lines");
fs.remove(lines_path);

print "fs stdlib tests passed";
