// tests/semantics/frame_gate_test.sapp — stdlib/frame_gate.sapp
//
// Pure frame-gate policy for a CPU-rasterized UI (PBIDE): decide whether to repaint
// this tick. An input event always repaints (no visible regression); otherwise we only
// repaint at the idle cadence AND only if the visual-state signature changed — so an
// idle window stops burning CPU on periodic full redraws. No graphics, fully testable.

let G = import("stdlib/frame_gate.sapp");

fn fail(m) { throw "FAIL " + m; }
fn draws(c, m) { if c.draw != true { fail(m + " expected DRAW"); } }
fn skips(c, m) { if c.draw != false { fail(m + " expected SKIP"); } }

// decide(redraw, now_ms, idle_ms, last_present_ms, sig, last_sig)

// an event always repaints, even if the signature is unchanged
draws(G.decide(true, 100, 500, 50, "a", "a"), "event forces draw");

// no event, idle cadence NOT elapsed -> skip
skips(G.decide(false, 100, 500, 50, "a", "a"), "not due yet");

// no event, idle cadence elapsed, signature UNCHANGED -> skip (the CPU win)
skips(G.decide(false, 600, 500, 50, "a", "a"), "idle no-op is skipped");

// no event, idle cadence elapsed, signature CHANGED -> draw (e.g. live resize)
draws(G.decide(false, 600, 500, 50, "b", "a"), "idle repaint when state changed");

// idle disabled (idle_ms <= 0) -> never repaints without an event
skips(G.decide(false, 999999, 0, 50, "b", "a"), "idle redraw disabled");

// first present (last_present_ms == 0) counts as due
draws(G.decide(false, 100, 500, 0, "b", "a"), "first present is due");

// clock unavailable (now == 0) is due, but an unchanged signature still skips
skips(G.decide(false, 0, 500, 50, "a", "a"), "no clock + no change = skip");
draws(G.decide(false, 0, 500, 50, "b", "a"), "no clock + change = draw");

print "frame_gate_pass";
