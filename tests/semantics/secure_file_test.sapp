let S = import("stdlib:secure_file.sapp");

fn fail(message) { throw "FAIL secure_file: " + message; }
fn require(value, message) { if value != true { fail(message); } }

if platform() == "linux" {
    let root = "/tmp/pblang-secure-file-" + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 16);
    let outside = root + "-outside";
    try proc_spawn_wait("/bin/rm", ["-rf", "--", root, outside]) catch nil;
    fs_mkdirs(outside);

    let path = root + "/nested/value.txt";
    require(S.write_text_atomic(path, "safe", true).ok, "secure atomic text publication");
    let create_once = root + "/nested/create-once.txt";
    require(S.write_text_new_exclusive(create_once, "first", true).ok,
        "secure exclusive no-replace text creation");
    require(not S.write_text_new_exclusive(create_once, "second", true).ok and
            S.read_text(create_once, 16).text == "first",
        "secure exclusive no-replace creation preserves existing content");
    let loaded = S.read_text(path, 16);
    require(loaded.ok and loaded.text == "safe" and loaded.size == 4,
        "secure descriptor-relative bounded read reports snapshot size");

    let linked = try proc_spawn_wait("/bin/ln", ["-s", outside, root + "/escape"]) catch nil;
    if linked != nil and linked.exit_code == 0 {
        require(not S.write_text_atomic(root + "/escape/owned", "no", true).ok,
            "intermediate symlink write is rejected");
        require(not (try fs_exists(outside + "/owned") catch false),
            "rejected write does not touch symlink target");
    }
    require(S.remove(path).ok, "secure removal");
    require(S.remove(create_once).ok, "secure no-replace fixture removal");
    try proc_spawn_wait("/bin/rm", ["-rf", "--", root, outside]) catch nil;
}

require(S.status().path_fallback_on_linux == false, "Linux failures never downgrade to path I/O");
print "secure_file_pass";
