let S = import("stdlib:secure_file.sapp");
let D = import("stdlib:linux_dirfs.sapp");

fn fail(message) { throw "FAIL secure_file: " + message; }
fn require(value, message) { if not value { fail(message); } }

if platform() == "linux" {
    let root = "/tmp/pblang-secure-file-" + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 16);
    let outside = root + "-outside";
    try proc_spawn_wait("/bin/rm", ["-rf", "--", root, outside]) catch nil;
    fs_mkdirs(outside);

    let path = root + "/nested/value.txt";
    require(S.write_text_atomic(path, "safe", true).ok, "secure atomic text publication");
    let create_once = root + "/nested/create-once.txt";
    require(S.write_text_new_exclusive(create_once, "first", true).ok,
        "secure exclusive no-replace text creation");
    require(not S.write_text_new_exclusive(create_once, "second", true).ok and
            S.read_text(create_once, 16).text == "first",
        "secure exclusive no-replace creation preserves existing content");
    let loaded = S.read_text(path, 16);
    require(loaded.ok and loaded.text == "safe" and loaded.size == 4,
        "secure descriptor-relative bounded read reports snapshot size");

    let live_root = root + "/private-live";
    let capped_live = live_root + "/capped.txt";
    let tmp_mode_before = try proc_spawn_wait("/usr/bin/stat", ["-c", "%a", "/tmp"]) catch nil;
    let shared_parent_probe = "/tmp/pblang-private-parent-refusal-" +
        str_slice(sha256(base64_encode_bytes(random_bytes(24))), 0, 24) + ".txt";
    require(not S.append_text_bounded_locked(shared_parent_probe, "no", 64, 100).ok
        and not (try fs_exists(shared_parent_probe) catch false),
        "locked append refuses an existing shared parent without creating a target");
    let tmp_mode_after = try proc_spawn_wait("/usr/bin/stat", ["-c", "%a", "/tmp"]) catch nil;
    require(tmp_mode_before != nil and tmp_mode_after != nil
        and str_trim(tmp_mode_before.stdout) == str_trim(tmp_mode_after.stdout),
        "private-state refusal never chmods an arbitrary operator path");
    require(not S.append_text_bounded_locked(capped_live, "", 2, 100).ok,
        "locked append rejects empty records before creating state");
    require(S.append_text_bounded_locked(capped_live, "a", 2, 100).ok
        and S.append_text_bounded_locked(capped_live, "b", 2, 100).ok,
        "locked append admits cap-1 and exact-cap publications");
    require(not S.append_text_bounded_locked(capped_live, "c", 2, 100).ok
        and S.read_text(capped_live, 2, true).text == "ab",
        "locked append rejects cap overflow without changing the old state");
    require(try fs_exists(capped_live + ".lock") catch false,
        "the stable sibling lock file is retained to prevent split-lock races");
    let live_root_status = S.private_directory_status(live_root);
    require(live_root_status.ok and live_root_status.ready
        and live_root_status.owned_by_current_uid and live_root_status.mode == "700",
        "private state root becomes usable only after ownership and mode verification");

    let concurrent_live = live_root + "/concurrent.txt";
    let first = spawn(fn() {
        let secure = import("stdlib:secure_file.sapp");
        return secure.append_text_bounded_locked(concurrent_live, "writer-one\n", 1024, 2000);
    });
    let second = spawn(fn() {
        let secure = import("stdlib:secure_file.sapp");
        return secure.append_text_bounded_locked(concurrent_live, "writer-two\n", 1024, 2000);
    });
    let first_result = join(first); let second_result = join(second);
    let concurrent_text = S.read_text(concurrent_live, 1024, true);
    require(first_result.ok and second_result.ok and concurrent_text.ok
        and len(str_split(concurrent_text.text, "writer-one")) == 2
        and len(str_split(concurrent_text.text, "writer-two")) == 2,
        "cooperating concurrent writers are each retained exactly once");

    let held = D.open_absolute(live_root, false, true);
    require(held.ok, "private live root can be held for lock contention test");
    let busy_lock = D.acquire_lock(held, "busy.txt.lock", 100, 10);
    require(busy_lock.ok, "contention fixture owns the sibling lock");
    let busy_result = S.append_text_bounded_locked(live_root + "/busy.txt", "blocked", 64, 0);
    require(not busy_result.ok and busy_result.timeout and busy_result.target_unchanged
        and not (try fs_exists(live_root + "/busy.txt") catch false),
        "pre-held lock timeout creates or modifies no target");
    require(D.release_lock(held, busy_lock) and D.close(held),
        "contention fixture releases its descriptor-bound lock");

    let external_hardlink = outside + "/hardlink-source.txt";
    fs_write(external_hardlink, "outside-unchanged");
    let hardlink_path = live_root + "/hardlink.txt";
    let hardlinked = try proc_spawn_wait("/bin/ln", [external_hardlink, hardlink_path]) catch nil;
    if hardlinked != nil and hardlinked.exit_code == 0 {
        require(not S.append_text_bounded_locked(hardlink_path, "no", 64, 100).ok
            and fs_read(external_hardlink) == "outside-unchanged",
            "pre-planted hard link is rejected without mutating its external inode");
    }
    let final_symlink = live_root + "/final-link.txt";
    let final_linked = try proc_spawn_wait("/bin/ln", ["-s", external_hardlink, final_symlink]) catch nil;
    if final_linked != nil and final_linked.exit_code == 0 {
        require(not S.append_text_bounded_locked(final_symlink, "no", 64, 100).ok
            and fs_read(external_hardlink) == "outside-unchanged",
            "final symlink is rejected without following or replacing its target");
    }

    let binary = [];
    let binary_index = 0;
    while binary_index < 8195 {
        array_push(binary, (binary_index * 41 + 9) % 256);
        binary_index = binary_index + 1;
    }
    let binary_path = root + "/nested/source.bin";
    let range_path = root + "/nested/range.bin";
    let collision_path = root + "/nested/collision.bin";
    let private_output_root = root + "/private-output";
    let private_range_path = private_output_root + "/range.bin";
    let temporary_private_root = "/tmp/pblang-secure-temp-"
        + str_slice(sha256(base64_encode_bytes(random_bytes(24))), 0, 24);
    require(S.write_atomic(binary_path, binary, true, false).ok,
        "immutable-reader source publication");
    let reader = S.open_immutable_reader(binary_path, 16384, false);
    require(reader.ok and reader.immutable and reader.size == len(binary),
        "immutable reader opens a bounded sealed snapshot");
    let binary_digest = S.immutable_reader_base64_sha256(reader, 0, len(binary));
    let probe = S.immutable_reader_range(reader, 17, 5);
    require(binary_digest.ok and binary_digest.sha256 == sha256(base64_encode_bytes(binary)),
        "immutable reader preserves the canonical binary digest contract");
    require(probe.ok and probe.bytes == slice(binary, 17, 22),
        "immutable reader returns an exact descriptor-bound range");
    let published = S.publish_immutable_reader_range(reader, range_path,
        3, len(binary) - 6, false, true);
    require(published.ok and published.atomic and published.no_replace
        and published.durability_verified and published.executable
        and published.anonymous_stage and published.exact_inode_publication,
        "immutable range publication links the exact anonymous inode durably");
    require(S.write_text_new_exclusive(collision_path, "keep", false, false).ok,
        "collision fixture creation");
    require(not S.publish_immutable_reader_range(reader, collision_path,
        0, 16, false, false).ok and S.read_text(collision_path, 16).text == "keep",
        "immutable range publication never replaces an existing destination");
    let private_root = S.create_private_directory_new(private_output_root);
    require(private_root.ok and private_root.owned_by_current_uid
        and private_root.mode == "700" and private_root.exclusive_create,
        "private publication root is current-UID-owned mode 0700");
    require(not S.create_private_directory_new(private_output_root).ok,
        "private directory creation never changes an existing directory");
    let temporary_private = S.create_private_temporary_directory_new(temporary_private_root);
    require(temporary_private.ok and temporary_private.exclusive_create
        and temporary_private.owned_by_current_uid and temporary_private.mode == "700"
        and temporary_private.sticky_temporary_container_verified
        and temporary_private.temporary_container_owner_verified
        and temporary_private.post_return_other_uid_replacement_blocked,
        "temporary private root verifies the sticky container and exclusive child");
    require(not S.create_private_temporary_directory_new("/tmp").ok
        and not S.create_private_temporary_directory_new(root + "/not-temp").ok,
        "temporary private root rejects the container itself and non-temp parents");
    let private_published = S.publish_immutable_reader_range_private(reader,
        private_range_path, 7, 32, false);
    require(private_published.ok and private_published.private_parent_verified
        and private_published.parent_owned_by_current_uid
        and private_published.parent_mode == "700",
        "private immutable publication verifies its held output parent");
    let shared_output = "/tmp/pblang-shared-parent-refusal-" +
        str_slice(sha256(base64_encode_bytes(random_bytes(24))), 0, 24);
    require(not S.publish_immutable_reader_range_private(reader,
        shared_output, 0, 16, false).ok,
        "private immutable publication rejects a shared output parent");
    let closed_reader = S.close_immutable_reader(reader);
    require(closed_reader.ok and not S.immutable_reader_base64_sha256(reader, 0, 1).ok,
        "closed immutable readers cannot be reused");
    let range = S.read_bytes(range_path, 16384, false);
    require(range.ok and range.bytes == slice(binary, 3, len(binary) - 3),
        "published immutable range contains exactly the selected bytes");

    let linked = try proc_spawn_wait("/bin/ln", ["-s", outside, root + "/escape"]) catch nil;
    if linked != nil and linked.exit_code == 0 {
        require(not S.write_text_atomic(root + "/escape/owned", "no", true).ok,
            "intermediate symlink write is rejected");
        require(not (try fs_exists(outside + "/owned") catch false),
            "rejected write does not touch symlink target");
    }
    let dangling = root + "/nested/dangling";
    let dangling_link = try proc_spawn_wait("/bin/ln",
        ["-s", root + "/missing-target", dangling]) catch nil;
    if dangling_link != nil and dangling_link.exit_code == 0 {
        require(not fs_exists(dangling), "fixture is a dangling symlink");
        let removed = S.remove_file(dangling, false);
        require(removed.ok and removed.namespace_absent
            and removed.absence_evidence == "descriptor-held file-only unlink",
            "file-only unlink proves dangling namespace entry removal");
        require(not S.remove_file(dangling, false).ok,
            "already-absent entry is not reported as newly removed");
    }
    require(S.remove(path).ok, "secure removal");
    require(S.remove(create_once).ok, "secure no-replace fixture removal");
    require(S.remove(binary_path).ok and S.remove(range_path).ok
        and S.remove(collision_path).ok and S.remove(private_range_path).ok
        and S.remove(private_output_root).ok and S.remove(temporary_private_root).ok,
        "immutable-reader fixture removal");
    try proc_spawn_wait("/bin/rm", ["-rf", "--", root, outside]) catch nil;
}

require(not S.status().path_fallback_on_linux, "Linux failures never downgrade to path I/O");
print "secure_file_pass";
