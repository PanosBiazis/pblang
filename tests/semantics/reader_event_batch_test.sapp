let App=import("../../examples/declarative_browser/app.sapp");let Profile=import("../../examples/declarative_browser/appearance_profile.sapp");
let n=0;fn check(ok,label){assert(ok,label);n=n+1;}
fn press(k){return [map{type:"keydown",key:k},map{type:"keyup",key:k}];}
fn keys(c,names){let events=[];for name in names {for e in press(name){push(events,e);}}App.update(c,events);}
fn make(height=240){let c=App.create();App.enable_preferences(c);c.width=320;c.height=height;c.settings=true;c.focus_target="font_family";App.refresh(c);return c;}
let c=make();keys(c,["PageDown","Enter"]);
check(c.form.focus=="body_size" and c.preferences.draft.body_size==18 and c.preferences.draft.font_family=="sans","page then Enter edits new visible choice");
check(c.appearance==Profile.defaults(),"batched choice still only a draft");c.session.close();
let resized=make();let resize_events=[map{type:"resize",w:800,h:816}];for e in press("Tab"){push(resize_events,e);}for e in press("Enter"){push(resize_events,e);}App.update(resized,resize_events);
check(resized.settings and resized.form.focus=="body_size" and resized.preferences.draft.body_size==18,"resize then Tab/Enter follows expanded focus order");check(resized.width==800 and resized.height==816 and resized.settings_layout==nil,"expanded layout ready for same-batch input");resized.session.close();
let opening=App.create();App.enable_preferences(opening);App.update(opening,[]);opening.form.focus="appearance";keys(opening,["Enter","Enter"]);
check(opening.settings and opening.form.focus=="font_family" and opening.preferences.draft.font_family=="serif","open then separate Enter edits first choice, not stale opener");
let family=opening.preferences.draft.font_family;App.update(opening,[map{type:"keydown",key:"Enter"},map{type:"keydown",key:"Enter"},map{type:"keydown",key:"Enter"}]);
check(opening.preferences.draft.font_family!=family,"fresh Enter cycles once");let changed=opening.preferences.draft.font_family;
App.update(opening,[map{type:"keydown",key:"Enter"}]);check(opening.preferences.draft.font_family==changed,"held key survives intermediate rebuild");App.update(opening,[map{type:"keyup",key:"Enter"}]);opening.session.close();
for height in [240,288,480] {
 let paged=make(height);let cap=paged.settings_layout.capacity;
 keys(paged,["PageDown","PageUp","Enter"]);check(paged.settings_layout.page==0 and paged.form.focus=="font_family" and paged.preferences.draft.font_family=="serif","page transitions ordered at "+str(height));
 if cap==1 {keys(paged,["PageDown","PageDown"]);check(paged.settings_layout.page==2 and paged.form.focus=="title_size","separate page presses accumulate");}
 let draft=paged.preferences.draft;keys(paged,["Escape","Enter"]);check(paged.settings and paged.form.focus=="font_family" and paged.preferences.draft==paged.appearance,"dismiss then reopen uses document opener");check(draft!=paged.preferences.draft,"dismiss still discards draft");paged.session.close();
}
// Blocked Save followed by a distinct press must target the recovery action.
let state=map{save:0,reload:0};let saved=Profile.defaults();saved.body_size=20;
let saver=fn(style){state.save=state.save+1;return map{ok:false,reload:true};};
let loader=fn(){state.reload=state.reload+1;return map{ok:true,appearance:saved,save:saver};};
let recovering=make();App.enable_preferences(recovering,nil,saver,"Ready",loader);recovering.focus_target="style_save";App.refresh(recovering);
keys(recovering,["Enter","Enter"]);check(state.save==1 and state.reload==1 and recovering.appearance==saved,"same-batch explicit second press reloads exactly once");check(recovering.form.focus=="style_reload","recovery focus kept");recovering.session.close();
// Programmatic pending changes must settle before events, including an empty batch.
let pending=make();App.close_preferences(pending);keys(pending,["Enter"]);check(pending.settings and pending.form.focus=="font_family","pending dismissal settles before next input");pending.session.close();
let layout=make();App.update(layout,[map{type:"resize",w:390,h:600}]);check(layout.width==390 and layout.form.w==390 and not layout.pending,"last resize settles without another event");layout.session.close();
// Once a close is requested, neither deferred rebuilds nor later keys can revive it.
for kind in ["close","quit"] {
 for first in [true,false] {
  let closing=make();let events=[];
  if first {push(events,map{type:kind});}
  for e in press("PageDown"){push(events,e);}if not first {push(events,map{type:kind});}
  for e in press("Enter"){push(events,e);}App.update(closing,events);
  check(closing.graphics_stop and closing.form.close_requested,"terminal close retained "+kind+" / "+str(first));
  check(closing.preferences.draft==closing.appearance,"no callback after terminal close");closing.session.close();
 }
}
let idle=make();idle.form.probe="kept";App.update(idle,[]);
check((try idle.form.probe catch "")=="kept","idle does not rebuild");
App.update(idle,[map{type:"keyup",key:"Enter"},map{type:"mousemove",x:10,y:10}]);
check((try idle.form.probe catch "")=="kept","release and pointer move do not rebuild");idle.session.close();
print "reader_event_batch_pass checks="+str(n);
