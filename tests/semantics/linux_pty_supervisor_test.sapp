let PTY = import("stdlib:linux_pty_supervisor.sapp");
let Process = import("stdlib:process.sapp");

fn require(condition, message) { if not condition { throw "FAIL linux_pty_supervisor: " + message; } }

let token = str_trim(fs_read("/proc/sys/kernel/random/uuid"));
let root = "/tmp/pblang-pty-test-" + token;
let fifo = root + "/input.fifo";
let pid_file = root + "/pid";
let status_file = root + "/status";
let output = root + "/output.log";
let helper = root + "/supervisor";
let stop_helper = root + "/stop";
let continue_helper = root + "/continue";
fs_mkdirs(root);
require(Process.run("/usr/bin/chmod", ["0700", root]).ok, "private directory");
require(Process.run("/usr/bin/mkfifo", ["-m", "0600", fifo]).ok, "private fifo");
let bytes = PTY.build(map{ fifo: fifo, pid_file: pid_file, status_file: status_file, output: output,
    shell: "/bin/sh", max_seconds: 5, max_output_bytes: 4096 });
require(len(bytes) > 512 and bytes[0] == 0x7F and bytes[1] == 0x45, "ELF encoding");
fs_write_bytes(helper, bytes);
require(Process.run("/usr/bin/chmod", ["0700", helper]).ok, "executable mode");

require(Process.run("/usr/bin/setsid", ["--fork", helper]).ok, "detached session launch");
let wait = channel(); let deadline = now_ms() + 3000;
while not fs_exists(pid_file) and now_ms() < deadline { recv_timeout(wait.receiver, 10); }
require(fs_exists(pid_file), "readiness pid file");
require(not fs_exists(pid_file + ".pending"), "pid staging file is atomically retired");
let pid_text = str_trim(fs_read(pid_file));
require(len(pid_text) == 10 and parse_number(pid_text) > 1, "fixed-width process id");
let pgid = parse_number(pid_text);
fs_write_bytes(stop_helper, PTY.build_group_signal(pgid, "STOP"));
fs_write_bytes(continue_helper, PTY.build_group_signal(pgid, "CONT"));
require(Process.run("/usr/bin/chmod", ["0700", stop_helper]).ok, "stop helper mode");
require(Process.run("/usr/bin/chmod", ["0700", continue_helper]).ok, "continue helper mode");
let writer = root + "/writer-before";
fs_write_bytes(writer, PTY.build_writer(fifo, "printf 'PBREMOTE_PTY_BEFORE\\n'\n"));
require(Process.run("/usr/bin/chmod", ["0700", writer]).ok, "writer executable mode");
require(Process.run(writer, []).ok, "nonblocking writer sends PTY input");
deadline = now_ms() + 3000;
while (not fs_exists(output) or not str_contains(fs_read(output), "PBREMOTE_PTY_BEFORE"))
    and now_ms() < deadline { recv_timeout(wait.receiver, 10); }
require(fs_exists(output) and str_contains(fs_read(output), "PBREMOTE_PTY_BEFORE"),
    "process group runs before suspension");
require(Process.run(stop_helper, []).ok, "native process-group STOP signal");
deadline = now_ms() + 1000;
let stopped = false;
while not stopped and now_ms() < deadline {
    let state = try fs_read("/proc/" + str(pgid) + "/status") catch "";
    stopped = str_contains(state, "State:\tT") or str_contains(state, "State:\tt");
    if not stopped { recv_timeout(wait.receiver, 10); }
}
require(stopped, "process-group leader enters a kernel stopped state");
let during_writer = root + "/writer-during";
fs_write_bytes(during_writer, PTY.build_writer(fifo, "printf 'PBREMOTE_PTY_AFTER\\n'; exit\n"));
require(Process.run("/usr/bin/chmod", ["0700", during_writer]).ok, "during writer mode");
require(Process.run(during_writer, []).ok, "input can queue while process group is stopped");
recv_timeout(wait.receiver, 100);
require(not str_contains(fs_read(output), "PBREMOTE_PTY_AFTER"),
    "stopped process group makes no transcript progress");
require(Process.run(continue_helper, []).ok, "native process-group CONT signal");
deadline = now_ms() + 5000;
while not fs_exists(status_file) and now_ms() < deadline { recv_timeout(wait.receiver, 10); }
require(fs_exists(status_file), "bounded PTY completion status");
require(not fs_exists(status_file + ".pending"), "status staging file is atomically retired");
let status = fs_read_bytes(status_file);
require(len(status) == 4 and status[0] == 0 and status[1] == 0, "zero child wait status");
require(fs_exists(output) and str_contains(fs_read(output), "PBREMOTE_PTY_AFTER"),
    "continued process group consumes queued input and exits");

try fs_remove(writer) catch nil; try fs_remove(helper) catch nil; try fs_remove(pid_file) catch nil;
try fs_remove(during_writer) catch nil; try fs_remove(stop_helper) catch nil;
try fs_remove(continue_helper) catch nil;
try fs_remove(status_file) catch nil; try fs_remove(output) catch nil;
try fs_remove(fifo) catch nil; try fs_remove(root) catch nil;

let rejected = try { PTY.build(map{ fifo: "relative", pid_file: "/tmp/p", status_file: "/tmp/s", output: "/tmp/o" }); false } catch true;
require(rejected, "relative paths fail closed");

let sentinel_root = "/tmp/pblang-pty-sentinel-" + token;
fs_mkdirs(sentinel_root);
require(Process.run("/usr/bin/chmod", ["0700", sentinel_root]).ok,
    "sentinel private directory");
let sentinel_pid = sentinel_root + "/legacy-error-pid";
let sentinel_helper = sentinel_root + "/legacy-error-helper";
let sentinels = [sentinel_pid + ".limits", sentinel_pid + ".limits.pending",
    sentinel_pid + ".ready", sentinel_pid + ".ready.pending"];
for i len(sentinels) { fs_write(sentinels[i], "keep"); }
fs_write_bytes(sentinel_helper, PTY.build(map{
    fifo: sentinel_root + "/missing.fifo", pid_file: sentinel_pid,
    status_file: sentinel_root + "/legacy-error-status",
    output: sentinel_root + "/legacy-error-output",
    command: "/bin/echo must-not-run", max_seconds: 1, max_output_bytes: 32
}));
require(Process.run("/usr/bin/chmod", ["0700", sentinel_helper]).ok,
    "legacy error helper mode");
require(Process.run("/usr/bin/setsid", ["--fork", sentinel_helper]).ok,
    "legacy error helper launch");
recv_timeout(wait.receiver, 100);
for i len(sentinels) {
    require(fs_exists(sentinels[i]) and fs_read(sentinels[i]) == "keep",
        "opt-out startup errors preserve adjacent sidecars");
    try fs_remove(sentinels[i]) catch nil;
}
try fs_remove(sentinel_helper) catch nil;
try fs_remove(sentinel_root) catch nil;
require((try { PTY.build_group_signal(1, "STOP"); false } catch true),
    "unsafe process-group id fails closed");
require((try { PTY.build_group_signal(2, "USR1"); false } catch true),
    "unapproved signal fails closed");
let command_helper = PTY.build(map{ fifo: "/tmp/pblang-command.fifo",
    pid_file: "/tmp/pblang-command.pid", status_file: "/tmp/pblang-command.status",
    output: "/tmp/pblang-command.log", command: "/bin/echo bounded-command" });
require(len(command_helper) > 512, "allowlisted absolute command is encoded");
require((try { PTY.build(map{ fifo: "/tmp/f", pid_file: "/tmp/p",
    status_file: "/tmp/s", output: "/tmp/o",
    command: "/bin/echo unsafe;touch /tmp/x" }); false } catch true),
    "shell metacharacters fail closed");

let env_helper = PTY.build_argv_exec_env("/usr/bin/env", [],
    map{ DISPLAY: ":77", PB_SCREEN_TEST: "bounded" }, -1, -1);
require(len(env_helper) > 128 and env_helper[0] == 0x7F and env_helper[1] == 0x45,
    "explicit environment argv trampoline is encoded");
require((try { PTY.build_argv_exec_env("/usr/bin/env", [],
    map{ "BAD-NAME": "x" }, -1, -1); false } catch true),
    "invalid environment names fail before executable publication");

let orphan_root = "/tmp/pblang-pty-writer-test-" + token;
let orphan_fifo = orphan_root + "/input.fifo"; let orphan_writer = orphan_root + "/writer";
fs_mkdirs(orphan_root); require(Process.run("/usr/bin/chmod", ["0700", orphan_root]).ok, "orphan private directory");
require(Process.run("/usr/bin/mkfifo", ["-m", "0600", orphan_fifo]).ok, "orphan fifo");
fs_write_bytes(orphan_writer, PTY.build_writer(orphan_fifo, "x"));
require(Process.run("/usr/bin/chmod", ["0700", orphan_writer]).ok, "orphan writer mode");
let orphan = Process.run(orphan_writer, []);
require(not orphan.ok and orphan.exit_code == 75, "writer without reader fails immediately");
try fs_remove(orphan_writer) catch nil; try fs_remove(orphan_fifo) catch nil; try fs_remove(orphan_root) catch nil;

let command_root = "/tmp/pblang-command-test-" + token;
let command_fifo = command_root + "/input.fifo";
let command_pid = command_root + "/pid";
let command_status = command_root + "/status";
let command_output = command_root + "/output.log";
let command_supervisor = command_root + "/supervisor";
fs_mkdirs(command_root);
require(Process.run("/usr/bin/chmod", ["0700", command_root]).ok, "command private directory");
require(Process.run("/usr/bin/mkfifo", ["-m", "0600", command_fifo]).ok, "command private fifo");
fs_write_bytes(command_supervisor, PTY.build(map{
    fifo: command_fifo, pid_file: command_pid, status_file: command_status,
    output: command_output, command: "/bin/echo bounded-command",
    max_seconds: 5, max_output_bytes: 4096
}));
require(Process.run("/usr/bin/chmod", ["0700", command_supervisor]).ok,
    "command supervisor mode");
require(Process.run("/usr/bin/setsid", ["--fork", command_supervisor]).ok,
    "bounded command detached launch");
deadline = now_ms() + 5000;
while not fs_exists(command_status) and now_ms() < deadline {
    recv_timeout(wait.receiver, 10);
}
require(fs_exists(command_status), "bounded command completion status");
let command_wait = fs_read_bytes(command_status);
require(len(command_wait) == 4 and command_wait[0] == 0 and command_wait[1] == 0,
    "bounded command exits successfully");
require(fs_exists(command_output)
    and str_contains(fs_read(command_output), "bounded-command"),
    "bounded command output is privately captured");
try fs_remove(command_supervisor) catch nil; try fs_remove(command_pid) catch nil;
try fs_remove(command_status) catch nil; try fs_remove(command_output) catch nil;
try fs_remove(command_fifo) catch nil; try fs_remove(command_root) catch nil;
print "linux_pty_supervisor_pass";
