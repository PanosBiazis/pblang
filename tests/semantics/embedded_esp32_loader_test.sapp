let Loader=import("stdlib:embedded_esp32_loader.sapp");
fn expect(value,message){if not value{throw "FAIL embedded ESP32 loader: "+message;}}

let payload=[0,Loader.SLIP_END,1,Loader.SLIP_ESC,255];
let wire=Loader.slip_encode(payload);
expect(wire==[0xc0,0,0xdb,0xdc,1,0xdb,0xdd,255,0xc0],"SLIP escapes reserved bytes");
let decoder=Loader.new_decoder();
let first=Loader.slip_feed(decoder,[99,0xc0,0,0xdb]);
expect(first.ok and len(first.frames)==0 and first.discarded==1,"chunked decoder bounds noise");
let second=Loader.slip_feed(decoder,[0xdc,1,0xdb,0xdd,255,0xc0]);
expect(second.ok and second.frames==[payload],"chunked SLIP roundtrip");

let sync=Loader.sync_payload();
expect(len(sync)==36 and sync[0]==7 and sync[3]==32 and sync[35]==0x55,"official sync payload");
let command=Loader.command_packet(Loader.OP_SYNC,sync,0);
expect(len(command)==44 and command[0]==0 and command[1]==Loader.OP_SYNC
    and command[2]==36 and command[3]==0,"ROM command header");

let block=[1,2,0xc0,0xdb,255];
expect(Loader.align_ram_data(block)==[1,2,0xc0,0xdb,255,0,0,0],"RAM transport is word aligned");
let data=Loader.mem_data_payload(block,3);
expect(len(data)==21 and data[0]==5 and data[4]==3 and data[16]==1,"MEM_DATA body");
expect(Loader.checksum(block)==bit_xor(bit_xor(bit_xor(bit_xor(bit_xor(0xef,1),2),0xc0),0xdb),255),
    "ROM XOR checksum");

let response=[1,Loader.OP_SYNC,4,0,0,0,0,0,0,0,0,0];
let parsed=Loader.parse_response(response,Loader.OP_SYNC);
expect(parsed.ok and parsed.status==0 and parsed.rom_error==0,"four-byte ROM status");
parsed=Loader.parse_response([1,Loader.OP_SYNC,4,0,0,0,0,0,1,7,0,0],Loader.OP_SYNC);
expect(not parsed.ok and parsed.rom_error==7,"ROM checksum error preserved");
expect(not Loader.load_ram(map{},map{}).ok,"physical load is deny-by-default");

print "embedded_esp32_loader_pass";
