// tests/semantics/nanoid_test.sapp — compact URL-safe ID library.

let N = import("stdlib/nanoid.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

eq(len(N.new()), 21, "default size 21");
eq(len(N.new(10)), 10, "custom size");
if not N.is_valid(N.new()) { fail("new() is valid"); }
if N.is_valid("has space") { fail("space not in alphabet"); }
if N.new() == N.new() { fail("two ids should differ"); }

// custom alphabet stays within the alphabet
let code = N.custom("0123456789", 6);
eq(len(code), 6, "numeric code length");
let i = 0;
while i < len(code) {
    if str_index_of("0123456789", str_slice(code, i, i + 1)) < 0 { fail("digit only: " + code); }
    i = i + 1;
}
eq(N.custom("", 5), "", "empty alphabet -> empty");

print "nanoid_pass";
