let Check=import("stdlib:ui_form_check.sapp");let Web=import("stdlib:ui_form_web.sapp");
let source="object PrivateName: TForm1\n Caption = 'PRIVATE_TITLE'\n ClientWidth = 300\n ClientHeight = 200\n object PrivateButton: TButton\n Caption = 'PRIVATE_LABEL'\n Width = 100\n Height = 30\n OnClick = PrivateHandler\n end\nend\n";
let result=Check.analyze_dfm(source);let encoded=json_stringify(result);
assert(result.ok and result.renderable and result.widgets == 1 and result.buttons == 1 and result.requires_explicit_actions, "structured preflight");
assert(not result.conversion_complete and not result.production_ready and not result.source_executed, "truthful scope");
assert(not str_contains(encoded, "PRIVATE") and not str_contains(encoded, "Private"), "no source names or content");
assert(not Check.analyze_dfm("TPF0binary").ok, "binary rejected");
assert(not Check.analyze_dfm("object A: TForm1\nobject X: TTimer\nend\nend").ok, "unsupported effects rejected");
let omitted="object A: TForm1\n Caption = 'x'\n ClientWidth = 300\n ClientHeight = 200\n OnCreate = PrivateHandler\nend";
let partial=Check.analyze_dfm(omitted);assert(partial.ok and partial.import_lossy and partial.unmapped_events == 1 and partial.requires_explicit_actions, "lifecycle loss visible");
assert(not Web.inspect(map{}).ok, "invalid canonical input");
print "ui_form_check_pass";
