let Pure = import("stdlib:host_pbck_pure.sapp");

fn fail(message) { throw "FAIL host_pbck_pure: " + message; }

let cases = [
    map{ name: "array_flatten", args: [[[1], [2, [3]]]] },
    map{ name: "array_pop", args: [[1]] },
    map{ name: "array_push", args: [[1], 2] },
    map{ name: "array_sort", args: [[3, 1, 2]] },
    map{ name: "push", args: [[1], 2] },
    map{ name: "base64_decode", args: ["SGVsbG8="] },
    map{ name: "base64_decode_bytes", args: ["SGVsbG8="] },
    map{ name: "base64_encode", args: ["Hello"] },
    map{ name: "base64_encode_bytes", args: [[72, 105]] },
    map{ name: "bigint", args: ["9007199254740993"] },
    map{ name: "bit_and", args: [6, 3] },
    map{ name: "bit_not", args: [5] },
    map{ name: "bit_or", args: [4, 1] },
    map{ name: "bit_shl", args: [1, 3] },
    map{ name: "bit_shr", args: [8, 3] },
    map{ name: "bit_xor", args: [7, 3] },
    map{ name: "bytes_to_str", args: [[72, 105]] },
    map{ name: "constant_time_eq", args: ["same", "same"] },
    map{ name: "hmac_sha256", args: ["message", "key"] },
    map{ name: "http_parse_request", args: ["GET / HTTP/1.1\r\nHost: local\r\n\r\n"] },
    map{ name: "http_response", args: [200, "ok"] },
    map{ name: "http_response_ct", args: [200, "text/plain", "ok"] },
    map{ name: "http_response_json", args: [200, map{ ok: true }] },
    map{ name: "is_array", args: [[]] },
    map{ name: "is_map", args: [map{}] },
    map{ name: "is_number", args: [1] },
    map{ name: "is_string", args: ["x"] },
    map{ name: "json_parse", args: ["{\"ok\":true}"] },
    map{ name: "json_stringify", args: [map{ ok: true }] },
    map{ name: "len", args: [[1, 2]] },
    map{ name: "map_has", args: [map{ x: 1 }, "x"] },
    map{ name: "map_keys", args: [map{ x: 1 }] },
    map{ name: "map_remove", args: [map{ x: 1 }, "x"] },
    map{ name: "num_abs", args: [-2] },
    map{ name: "num_floor", args: [2.5] },
    map{ name: "num_max", args: [2, 3] },
    map{ name: "num_min", args: [2, 3] },
    map{ name: "num_mod", args: [7, 3] },
    map{ name: "num_sqrt", args: [9] },
    map{ name: "num_to_le_bytes", args: [42] },
    map{ name: "parse_number", args: ["42"] },
    map{ name: "range", args: [3] },
    map{ name: "regex_replace_all", args: ["a  b", " +", "-"] },
    map{ name: "sha256", args: ["abc"] },
    map{ name: "slice", args: [[1, 2, 3], 0, 2] },
    map{ name: "str", args: [42] },
    map{ name: "str_contains", args: ["abc", "b"] },
    map{ name: "str_ends_with", args: ["abc", "c"] },
    map{ name: "str_from_char_code", args: [65] },
    map{ name: "str_index_of", args: ["abc", "b"] },
    map{ name: "str_join", args: [["a", "b"], ","] },
    map{ name: "str_lower", args: ["ABC"] },
    map{ name: "str_pad_left", args: ["x", 3, "0"] },
    map{ name: "str_pad_right", args: ["x", 3, "0"] },
    map{ name: "str_repeat", args: ["ab", 2] },
    map{ name: "str_replace_all", args: ["a b", " ", "-"] },
    map{ name: "str_slice", args: ["abc", 0, 2] },
    map{ name: "str_split", args: ["a,b", ","] },
    map{ name: "str_starts_with", args: ["abc", "a"] },
    map{ name: "str_to_bytes", args: ["Hi"] },
    map{ name: "str_trim", args: [" x "] },
    map{ name: "str_upper", args: ["abc"] },
    map{ name: "strcharcodeat", args: ["A", 0] },
    map{ name: "strfromcharcode", args: [65] },
    map{ name: "type", args: [1] },
    map{ name: "url_encode", args: ["a b"] }
];

if len(cases) + 1 != len(Pure.NAMES) { fail("registry and test inventory differ"); }
let seen = map{};
let i = 0;
while i < len(cases) {
    let item = cases[i];
    if not Pure.has(item.name) or map_has(seen, item.name) {
        fail("invalid registry entry " + item.name);
    }
    seen[item.name] = true;
    try Pure.call(item.name, item.args, 4096) catch {
        fail("dispatch failed for " + item.name);
    };
    i = i + 1;
}

if not Pure.has("error") or not (try { Pure.call("error", ["expected"], 4096); false } catch true) {
    fail("error adapter must raise");
}
if len(map_keys(seen)) + 1 != len(Pure.NAMES) { fail("duplicate or untested registry entry"); }

if not (try { Pure.call("range", [100], 16); false } catch true) {
    fail("range allocation limit did not fail closed");
}
if not (try { Pure.call("str_repeat", ["abcd", 5], 16); false } catch true) {
    fail("string expansion limit did not fail closed");
}
if not (try { Pure.call("len", [], 16); false } catch true) {
    fail("arity mismatch did not fail closed");
}
if Pure.call("bigint", ["9007199254740993"], 64) != bigint("9007199254740993") {
    fail("bigint lost integer precision");
}
if Pure.call("bit_not", [5], 16) != bit_not(5) {
    fail("bit_not result differs from the language builtin");
}
if not (try { Pure.call("bigint", [[1]], 16); false } catch true) {
    fail("bigint accepted a non-scalar input");
}
if not (try { Pure.call("bigint", ["12345678901234567"], 16); false } catch true) {
    fail("bigint input limit did not fail closed");
}
if not (try { Pure.call("bit_not", ["5"], 16); false } catch true) {
    fail("bit_not accepted a non-numeric input");
}

print "host_pbck_pure_pass";
