let F = import("stdlib:compiler/selfhost_frontend.sapp");
let V = import("stdlib:compiler/vm.sapp");
let P = import("stdlib:selfhost_pbck.sapp");
fn expect(ok, label) { if not ok { throw "FAIL try-context: " + label; } }
fn run(source) {
    let c = F.frontend_compile(source);
    expect(c.ok and len(c.diagnostics) == 0, "checked compilation: " + str(c.diagnostics));
    let limits = map{ max_steps: 6000, max_frames: 16 };
    let plain = V.run_bounded(c.chunk, limits);
    let optimized = F.frontend_run_bounded(source, limits);
    let restored = V.run_bounded(P.deserialize_chunk(P.serialize_chunk(c.chunk)), limits);
    expect(optimized.ok and plain.globals.result == optimized.globals.result, "optimized values agree");
    expect(plain.globals.result == restored.globals.result, "in-memory bytecode round-trip values agree");
    return plain.globals.result;
}
expect(run("fn f(x) { let y = try (if true { let inner = 7; inner; } else { 0; }) catch 0; return [x, y]; } let result = f(99);") == [99, 7], "try local cannot overwrite parameter");
expect(run("fn f(x) { let y = try (match 2 { case n: n + 1; }) catch 0; return [x, y]; } let result = f(99);") == [99, 3], "match temporary cannot overwrite parameter");
expect(run("fn boom() { throw 4; } fn f(x) { let y = try boom() catch (if true { let inner = 8; inner; } else { 0; }); return [x, y]; } let result = f(99);") == [99, 8], "catch local cannot overwrite parameter");
expect(run("fn f(x) { let y = try (if true { let a = 7; let b = try (if true { let a = 8; a; } else { 0; }) catch 0; [a, b]; } else { []; }) catch []; return [x, y]; } let result = f(99);") == [99, [7, 8]], "nested try slots stay distinct");
expect(run("fn f(x) { let y = try (if true { let x = 7; throw 4; x; } else { 0; }) catch x; return [x, y]; } let result = f(99);") == [99, 99], "failed body name cannot leak into handler");
expect(run("fn f(x) { let a = try (if true { let n = 7; n; } else { 0; }) catch 0; let b = try (if true { let n = 8; n; } else { 0; }) catch 0; return [x, a, b]; } let result = f(99);") == [99, 7, 8], "sibling temporaries preserve prior locals");
expect(run("let seen = []; fn boom() { array_push(seen, 1); throw 4; } fn f(x) { let y = try boom() catch (if true { array_push(seen, 2); let z = 7; z; } else { 0; }); return [x, y]; } let result = [f(99), seen];") == [[99, 7], [1, 2]], "ordered body and handler effects");
expect(run("fn f(x) { let y = try (if true { let x = 7; (fn() { return x; }); } else { (fn() { return 0; }); }) catch fn() { return 0; }; let z = 8; return [x, y(), z]; } let result = f(99);") == [99, 7, 8], "body local captured by returned closure");
expect(run("fn f(x) { let seen = []; for i 2 { let y = try (if true { let z = i + 7; z; } else { 0; }) catch 0; array_push(seen, [i, y]); } return [x, seen]; } let result = f(99);") == [99, [[0, 7], [1, 8]]], "try allocation inside count loop");
expect(run("let result = [try nil catch 9, try \"__pblang_selfhost_try_sentinel__\" catch \"wrong\"];") == [nil, "__pblang_selfhost_try_sentinel__"], "successful values are not exception sentinels");
expect(not F.frontend_compile("let result = absent;").ok, "undefined outer reference is rejected");
expect(not F.frontend_compile("let result = try (if true { let a = 7; a; } else { 0; }) catch a;").ok, "body-only name is unavailable in handler");
print "selfhost_try_scope_pass";
