let A=import("stdlib:timeline_adapters.sapp");let S=import("stdlib:slide_document.sapp");let T=import("stdlib:timeline_document.sapp");let Subs=import("stdlib:subtitles.sapp");
let slides=S.insert(S.create("Workshop"),1);let before=S.encode(slides);let timeline=A.from_slides(slides,90000);
assert(timeline.entries[1].start_ms==90000 and timeline.entries[1].end_ms==180000 and T.analyze(timeline).overlap_pairs==0,"consecutive explicit slide durations");
assert(S.encode(slides)==before,"source slide deck retained");
for ms in [0,-1,1.5,nil,"100",359999999] {assert((try A.from_slides(slides,ms) catch nil)==nil,"invalid duration and cumulative overflow");}
let cues=Subs.parse_srt("1\n00:00:01,000 --> 00:00:04,000\nOriginal text\n\n2\n00:00:03,000 --> 00:00:05,000\nAnother line\n");let source=Subs.to_srt(cues);let imported=A.from_subtitles(cues);
assert(imported.entries[0].label=="Cue 1" and imported.entries[0].start_ms==1000 and T.analyze(imported).overlap_pairs==1,"cue times preserve overlap");
assert(not str_contains(T.encode(imported),"Original text") and Subs.to_srt(cues)==source,"timing-only import and unchanged SRT");
let too_many=Subs.copy(cues);while len(too_many.cues)<65 {array_push(too_many.cues,map{start_ms:3000,end_ms:5000,text:"Example"});}
assert((try A.from_subtitles(too_many) catch nil)==nil,"no silent cue truncation");print "timeline_adapters_pass";
