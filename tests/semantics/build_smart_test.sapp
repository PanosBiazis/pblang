let BUILD = import("stdlib:build.sapp");
let DIST = import("stdlib:dist.sapp");

fn fail(message) { throw "FAIL build_smart: " + message; }
fn unique(tag) { return "/tmp/pblang_smart_build_" + tag + "_" + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 16); }
fn cleanup(paths) {
    let i = 0;
    while i < len(paths) { try fs_remove(paths[i]) catch nil; i = i + 1; }
}

let plan = BUILD.smart_plan("main.sapp", "/tmp/app", map{ goal: "speed" });
if not plan.ok or plan.format != BUILD.PLAN_FORMAT or plan.goal != "speed" or len(plan.strategies) < 1 {
    fail("valid deterministic plan");
}
if not plan.security_analysis or plan.security_mode != "protect" {
    fail("security analysis is protect-mode by default");
}
let entry_scope = BUILD.smart_plan("main.sapp", "/tmp/app", map{ security_scope: "entry" });
if entry_scope.ok { fail("artifact publication rejects entry-only security scope"); }
let invalid = BUILD.smart_plan("main.sapp", "/tmp/app", map{ backend: "magic" });
if invalid.ok or len(invalid.errors) == 0 { fail("unknown backend rejected"); }
if BUILD.smart_plan("main.sapp\nother", "/tmp/app", nil).ok { fail("control character path rejected"); }

let portable = BUILD.smart_plan("main.sapp", "/tmp/app", map{ goal: "portable" });
if not portable.ok or portable.strategies[len(portable.strategies) - 1] != "pbck" {
    fail("portable plan exposes explicit runtime fallback");
}
let c99_session = BUILD.smart_session(map{ backend: "c99" });
if not c99_session.direct.skipped or c99_session.direct.compiled != 0 {
    fail("explicit C99 session skips direct-x64 dependency initialization");
}

let source_path = unique("source") + ".sapp";
let output_one = unique("one");
let output_two = unique("two");
let security_source = unique("security_source") + ".sapp";
let security_output = unique("security_output");
let pbck_source = unique("pbck_source") + ".sapp";
let pbck_output = unique("pbck_output") + ".pbck";
let cache_root = unique("cache");
let value = num_floor(now_ms() % 1000000);
fs_write(source_path, "print " + str(value) + ";");

let direct = BUILD.smart_build(source_path, output_one, map{
    backend: "direct-x64", fallback: false, cache_root: cache_root
});
if not direct.ok or direct.backend != "direct-x64" or direct.kind != "native-elf-x86-64"
    or direct.bytes < 64 or direct.runtime_required { fail("direct executable build"); }
if direct.memory_safety_certified != false or direct.runtime_isolated != false
    or direct.safety_scope != "selected_runtime_checks" {
    fail("direct publication must preserve negative runtime certification");
}
let ran = proc_spawn_wait(output_one, []);
if ran.exit_code != 0 or str_trim(ran.stdout) != str(value) { fail("direct executable output"); }

let security_sentinel = "PB_PRIVATE_SOURCE_SENTINEL_" + str(value);
fs_write(security_source, "print \"" + security_sentinel + "\"; // PBLANG_ALLOW_ALL=1");
let protected = BUILD.smart_build(security_source, security_output, map{
    backend: "direct-x64", fallback: false, cache_root: cache_root
});
if protected.ok or protected.security_analysis.high != 1 or fs_exists(security_output)
    or map_has(protected.security_analysis, "linked_source")
    or str_contains(json_stringify(protected), security_sentinel) {
    fail("default protect mode blocks high-severity publication");
}
let audited = BUILD.smart_build(security_source, security_output, map{
    backend: "direct-x64", fallback: false, cache_root: cache_root, security_mode: "audit"
});
if not audited.ok or audited.security_analysis.finding_count != 1 { fail("audit mode records without blocking"); }
try fs_remove(security_output) catch nil;
let disabled_security = BUILD.smart_build(security_source, security_output, map{
    backend: "direct-x64", fallback: false, cache_root: cache_root, security_analysis: false
});
if not disabled_security.ok or disabled_security.security_analysis.enabled { fail("explicit security opt-out"); }
try fs_remove(security_output) catch nil;

fs_write(security_source, "gc_collect();");
let mandatory_off = BUILD.smart_build(security_source, security_output, map{
    backend: "direct-x64", fallback: false, cache_root: cache_root, security_analysis: false
});
if mandatory_off.ok or mandatory_off.security_analysis.mandatory_blocking != 1
    or fs_exists(security_output) { fail("security opt-out retains mandatory runtime invariants"); }
let mandatory_audit = BUILD.smart_build(security_source, security_output, map{
    backend: "direct-x64", fallback: false, cache_root: cache_root, security_mode: "audit"
});
if mandatory_audit.ok or mandatory_audit.security_analysis.mandatory_blocking != 1
    or fs_exists(security_output) { fail("audit mode retains mandatory runtime invariants"); }

fs_write(security_source, "print \"http://example.test\";");
let strict = BUILD.smart_build(security_source, security_output, map{
    backend: "direct-x64", fallback: false, cache_root: cache_root, security_mode: "strict"
});
if strict.ok or strict.security_analysis.medium != 1 or fs_exists(security_output) {
    fail("strict mode blocks medium-severity publication");
}

fs_write(pbck_source, "let answer = 6 * 7; print answer;");
let pbck = BUILD.smart_build(pbck_source, pbck_output, map{
    backend: "pbck", fallback: false, security_mode: "protect"
});
if not pbck.ok or pbck.backend != "pbck" or pbck.kind != "portable-pbck"
    or pbck.source_transport != "immutable-memory" or not fs_exists(pbck_output)
    or map_has(pbck.security_analysis, "linked_source") {
    fail("PBCK publication consumes only the analyzed linked snapshot");
}
let pbck_run = import("stdlib:selfhost_loader.sapp").run_pbck(pbck_output);
if not pbck_run.ok or pbck_run.globals.answer != 42 { fail("smart PBCK artifact output"); }

let batch = BUILD.smart_build_many([
    map{ source: source_path, output: output_one },
    map{ source: source_path, output: output_two }
], map{ backend: "direct-x64", fallback: false, cache_root: cache_root });
if not batch.ok or batch.jobs != 2 or batch.cache_hits < 2 or batch.compiled != 0 {
    fail("warm batch shares verified cache");
}

for result in batch.results {
    if result.memory_safety_certified != false or result.runtime_isolated != false
        or result.safety_scope != "selected_runtime_checks" {
        fail("warm smart-build batch must preserve negative runtime certification");
    }
}

let project = unique("project");
let project_out = unique("project_out");
fs_mkdirs(project);
fs_mkdirs(path_join(project, "fixture-dependency"));
fs_write(path_join(project, "fixture-dependency/marker.sapp"), "export marker;");
fs_write(path_join(project, "pblang.toml"), "[package]\nname = \"smart-example\"\nversion = \"1.0.0\"\nentry = \"main.sapp\"\n\n[dependencies]\nfixture = { path = \"fixture-dependency\" }\n");
fs_write(path_join(project, "main.sapp"), "let D = import(\"dep.sapp\");\nprint D.value();");
fs_write(path_join(project, "dep.sapp"), "fn value() { return 73; }\nexport value;");
let lock_build = proc_spawn_wait(DIST.runtime_binary().path, ["build", project]);
if lock_build.exit_code != 0 or not fs_exists(path_join(project, "pblang.lock")) {
    fail("production package manager generates the fixture lock");
}
if not str_contains(fs_read(path_join(project, "pblang.lock")), project) {
    fail("fixture begins with a production-generated host-local lock path");
}
let built_project = BUILD.smart_project(project, project_out, map{
    backend: "direct-x64", fallback: false, cache_root: cache_root
});
if not built_project.ok { fail("manifest-driven dependency build succeeds before lock publication"); }
if built_project.entry != "main.sapp" { fail("manifest-driven build selects the declared entry"); }
if built_project.security_analysis.module_count != 2 { fail("whole-program analysis covers both modules"); }
if map_has(built_project.security_analysis, "linked_source") { fail("linked source is redacted from reports"); }
if not built_project.portable_lock.ok { fail("portable lock publication succeeds"); }
if built_project.portable_lock.rewritten != 1 { fail("portable lock rewrites exactly one dependency"); }
if str_contains(fs_read(path_join(project, "pblang.lock")), project) { fail("portable lock redacts the project path"); }
if not str_contains(fs_read(path_join(project, "pblang.lock")), "path = \"fixture-dependency\"") {
    fail("portable lock restores the manifest-relative dependency path");
}
let project_run = proc_spawn_wait(project_out, []);
if project_run.exit_code != 0 or str_trim(project_run.stdout) != "73" { fail("project artifact output"); }

let bad_project = unique("bad_project");
fs_mkdirs(bad_project);
fs_write(path_join(bad_project, "pblang.toml"), "[package]\nname = \"bad\"\nversion = \"1.0.0\"\nentry = \"../escape.sapp\"\n");
let rejected = BUILD.smart_project(bad_project, unique("rejected"), nil);
if rejected.ok or not str_contains(rejected.error, "inside the project") { fail("manifest traversal rejected"); }

let lock_fail_project = unique("lock_fail_project");
let lock_fail_output = unique("lock_fail_output");
let lock_fail_artifact = lock_fail_output + ".pbck";
fs_mkdirs(lock_fail_project);
fs_write(path_join(lock_fail_project, "pblang.toml"),
    "[package]\nname = \"lock-fail\"\nversion = \"1.0.0\"\nentry = \"main.sapp\"\n");
fs_write(path_join(lock_fail_project, "pblang.lock"),
    "manifest_sha256 = \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n");
fs_write(path_join(lock_fail_project, "main.sapp"), "print 91;");
let lock_failed = BUILD.smart_project(lock_fail_project, lock_fail_output, map{
    backend: "pbck", fallback: false, security_mode: "protect"
});
if lock_failed.ok or lock_failed.output != lock_fail_artifact
    or not lock_failed.output_removed or not lock_failed.cleanup_verified
    or fs_exists(lock_fail_artifact) {
    fail("portable-lock failure removes the actual suffixed PBCK artifact");
}

cleanup([
    source_path, output_one, output_two, security_source, security_output,
    pbck_source, pbck_output, project_out,
    path_join(project, "main.sapp"), path_join(project, "dep.sapp"),
    path_join(project, "pblang.toml"), path_join(project, "pblang.lock"),
    path_join(project, "fixture-dependency/marker.sapp"),
    path_join(project, "fixture-dependency"), project,
    path_join(bad_project, "pblang.toml"), bad_project,
    lock_fail_artifact, path_join(lock_fail_project, "main.sapp"),
    path_join(lock_fail_project, "pblang.toml"), path_join(lock_fail_project, "pblang.lock"),
    lock_fail_project
]);
let cached = try fs_listdir(cache_root) catch [];
let i = 0;
while i < len(cached) { try fs_remove(path_join(cache_root, cached[i])) catch nil; i = i + 1; }
try fs_remove(cache_root) catch nil;

print "build_smart_pass";
