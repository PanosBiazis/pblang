// tests/semantics/gpu2d_test.sapp — stdlib/gpu2d.sapp
//
// The 2D draw-command IR + instanced-quad batcher: the CPU-side half of a GPU UI
// rasterizer. You build a draw list (rect / rounded-rect / glyph), then bake it into a
// flat f32 instance buffer that a GPU (via the emitted host in gpu2d_host.sapp) uploads
// and draws in ONE instanced call. Pure + deterministic; the bake also has a parallel
// path (stdlib/parallel). Same philosophy as codegen_x64: pblang produces the payload.

let D = import("stdlib/gpu2d.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.0001 { fail(m + " got=" + str(a)); } }

let dl = D.new();
D.rect(dl, 10, 20, 30, 40, map{ r: 255, g: 0, b: 0, a: 255 });
D.rrect(dl, 0, 0, 100, 50, 8, map{ r: 0, g: 128, b: 255, a: 255 });
D.glyph(dl, 5, 5, 12, 16, map{ u0: 0.0, v0: 0.0, u1: 0.1, v1: 0.2 }, map{ r: 255, g: 255, b: 255, a: 255 });
eq(D.count(dl), 3, "three commands");

// ── instances: normalized colors, kind tags, geometry preserved ────────────────────
let ins = D.to_instances(dl);
eq(len(ins), 3, "three instances");
eq(ins[0].kind, 0, "rect kind 0");
eq(ins[1].kind, 1, "rrect kind 1");
eq(ins[2].kind, 2, "glyph kind 2");
eq(ins[0].x, 10, "rect x"); eq(ins[0].w, 30, "rect w");
approx(ins[0].r, 1.0, "255 -> 1.0"); approx(ins[0].a, 1.0, "alpha 255 -> 1.0");
approx(ins[1].rad, 8, "rrect radius"); approx(ins[1].g, 128 / 255.0, "green 128 normalized");
approx(ins[2].u1, 0.1, "glyph uv u1"); approx(ins[2].v1, 0.2, "glyph uv v1");

// ── flat vertex/instance buffer: 14 floats per instance, fixed layout ──────────────
// [x, y, w, h, rad, r, g, b, a, u0, v0, u1, v1, kind]
let vb = D.to_vertex_f32(dl);
eq(len(vb), 3 * 14, "14 floats per instance");
approx(vb[0], 10, "vb[0]=x"); approx(vb[2], 30, "vb[2]=w"); approx(vb[3], 40, "vb[3]=h");
approx(vb[5], 1.0, "vb[5]=r"); approx(vb[13], 0, "vb[13]=kind(rect)");
approx(vb[14 + 4], 8, "second instance rad = 8");
approx(vb[28 + 13], 2, "third instance kind = glyph");

// ── the parallel bake matches the sequential one exactly ───────────────────────────
let vbp = D.to_vertex_f32_par(dl);
eq(len(vbp), len(vb), "parallel bake same length");
approx(vbp[0], vb[0], "parallel bake same data[0]");
approx(vbp[28 + 13], vb[28 + 13], "parallel bake same data[last kind]");

// ── stats: one instanced draw call regardless of command count ─────────────────────
let st = D.stats(dl);
eq(st.commands, 3, "commands"); eq(st.rects, 1, "rects"); eq(st.rrects, 1, "rrects");
eq(st.glyphs, 1, "glyphs"); eq(st.instances, 3, "instances");
eq(st.triangles, 6, "2 triangles per quad"); eq(st.draw_calls, 1, "single instanced draw call");

print "gpu2d_pass";
