// tests/semantics/pb_mcp_smart_test.sapp — smarter/faster pb_mcp bridge:
// suggest_tool (keyword tool discovery), call_batch (one round-trip, per-call
// fault isolation), call_stats (usage observability), memoized catalog.

let M = import("stdlib/pb_mcp.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── suggest_tool: rank catalog tools by query keywords ─────────────────────────────
let s1 = M.suggest_tool("search text in files", 3);
if len(s1) < 1 { fail("suggest returns candidates"); }
eq(s1[0].name, "grep_code", "text search suggests grep_code first");
let s2 = M.suggest_tool("cpu gpu hardware survey", 2);
eq(s2[0].name, "watch_hardware", "hardware query suggests watch_hardware");
eq(len(M.suggest_tool("zzz qqq xyzzy", 3)), 0, "no keyword overlap -> empty");

// ── call_batch: many tools in one call, failures isolated per entry ────────────────
let rb = M.call_batch([
    map{ tool: "file_exists", args: map{ path: "stdlib/pb_mcp.sapp" } },
    map{ tool: "no_such_tool", args: map{} },
    map{ tool: "tools_count_is_not_a_tool" }
]);
eq(len(rb), 3, "batch returns one result per call");
eq(rb[0].ok, true, "first call succeeded");
if rb[0].result != true { fail("file_exists true for real file"); }
eq(rb[1].ok, false, "unknown tool -> ok=false");
if not is_string(rb[1].error) { fail("unknown tool carries error text"); }
eq(rb[2].ok, false, "unknown tool without args -> isolated failure");

// ── call_stats: per-tool usage counters ────────────────────────────────────────────
M.reset_call_stats();
M.call("file_exists", map{ path: "stdlib/pb_mcp.sapp" });
M.call("file_exists", map{ path: "stdlib/pb_mcp.sapp" });
M.call("tool_catalog");
let st = M.call_stats();
eq(st.total, 3, "three calls recorded");
eq(st.by_tool["file_exists"], 2, "file_exists counted twice");
eq(st.by_tool["tool_catalog"], 1, "tool_catalog counted once");
M.reset_call_stats();
eq(M.call_stats().total, 0, "reset clears stats");

// ── memoized catalog: same array object semantics (stable, cheap repeated access) ──
eq(len(M.tool_catalog()), M.tools_count(), "catalog and count agree");
if not M.has_tool("grep_code") { fail("has_tool still works"); }
eq(M.tool_desc("outline") != nil, true, "tool_desc still works");

// ── the smart tools are in the CATALOG (external agents get them, not just callers) ──
if not M.has_tool("suggest_tool") { fail("suggest_tool is a catalog tool"); }
if not M.has_tool("call_batch") { fail("call_batch is a catalog tool"); }
if not M.has_tool("call_stats") { fail("call_stats is a catalog tool"); }
// ...and reachable through the generic call() dispatch
let s3 = M.call("suggest_tool", map{ query: "search text in files", k: 2 });
eq(s3[0].name, "grep_code", "call('suggest_tool') routes correctly");
M.reset_call_stats();
let rb2 = M.call("call_batch", map{ calls: [ map{ tool: "file_exists", args: map{ path: "stdlib/pb_mcp.sapp" } } ] });
eq(rb2[0].ok, true, "call('call_batch') runs a batch");
let cs2 = M.call("call_stats");
if cs2.total < 1 { fail("call('call_stats') reports usage"); }

print "pb_mcp_smart_pass";
