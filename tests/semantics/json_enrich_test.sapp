// tests/semantics/json_enrich_test.sapp — enrichment for stdlib/json.sapp
//
// json.sapp was a 16-line wrapper over the json_parse/json_stringify builtins.
// This adds a real toolkit: pretty(), is_valid(), parse_or(), dotted-path
// get()/has(), deep merge()/clone()/equal() (all non-mutating + depth-guarded),
// flatten(), and JSON Lines (ndjson) parse_lines()/stringify_lines().

let J = import("stdlib/json.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base wrappers still work ──────────────────────────────────────────────────────
eq(J.parse("{\"a\":1}").a, 1, "parse"); eq(J.stringify(map{ a: 1 }), "{\"a\":1.0}", "stringify");
eq(J.try_parse("{bad"), nil, "try_parse bad -> nil");

// ── ENRICH: pretty() — reuses builtin scalar escaping, adds indentation ──────────
let pj = J.pretty(map{ name: "Jo", tags: ["x", "y"] }, 2);
let want = "{\n  \"name\": \"Jo\",\n  \"tags\": [\n    \"x\",\n    \"y\"\n  ]\n}";
eq(pj, want, "pretty nested");
eq(J.pretty(map{}, 2), "{}", "pretty empty map");
eq(J.pretty([], 2), "[]", "pretty empty array");

// ── ENRICH: is_valid / parse_or ──────────────────────────────────────────────────
eq(J.is_valid("{\"a\":1}"), true, "is_valid true"); eq(J.is_valid("{bad"), false, "is_valid false");
eq(J.parse_or("{bad", map{ d: 9 }).d, 9, "parse_or fallback"); eq(J.parse_or("[1,2]", nil)[0], 1, "parse_or ok");

// ── ENRICH: dotted-path get() / has() (maps + array indices) ─────────────────────
let obj = J.parse("{\"a\": {\"b\": [10, 20, {\"c\": 7}]}}");
eq(J.get(obj, "a.b.2.c"), 7, "get nested array+map");
eq(J.get(obj, "a.b.1"), 20, "get array index");
eq(J.get(obj, "a.x.y", "def"), "def", "get missing -> default");
eq(J.get(obj, "a.b.99", nil), nil, "get out-of-range -> default");
eq(J.has(obj, "a.b.0"), true, "has true"); eq(J.has(obj, "a.z"), false, "has false");

// ── ENRICH: deep merge() — b wins, inputs NOT mutated ────────────────────────────
let a = map{ x: 1, nested: map{ p: 1, q: 2 } };
let b = map{ y: 2, nested: map{ q: 9, r: 3 } };
let m = J.merge(a, b);
eq(m.x, 1, "merge keeps a"); eq(m.y, 2, "merge adds b");
eq(m.nested.p, 1, "merge keeps nested a"); eq(m.nested.q, 9, "merge b overrides"); eq(m.nested.r, 3, "merge adds nested b");
eq(a.nested.q, 2, "merge does NOT mutate a"); eq(J.has(a, "y"), false, "merge does NOT add to a");

// ── ENRICH: deep clone() — independent copy ──────────────────────────────────────
let c = J.clone(a);
c.nested.p = 99;
eq(a.nested.p, 1, "clone is independent");

// ── ENRICH: deep equal() — order-independent for maps ────────────────────────────
eq(J.equal(J.parse("{\"a\":1,\"b\":2}"), J.parse("{\"b\":2,\"a\":1}")), true, "equal map order-independent");
eq(J.equal([1, 2, 3], [1, 2, 3]), true, "equal arrays");
eq(J.equal([1, 2], [2, 1]), false, "equal arrays are order-sensitive");
eq(J.equal(map{ a: 1 }, map{ a: 1, b: 2 }), false, "equal different sizes");

// ── ENRICH: flatten() nested maps to dotted keys ─────────────────────────────────
let fl = J.flatten(map{ a: map{ b: map{ c: 1 } }, d: 2 });
eq(fl["a.b.c"], 1, "flatten deep key"); eq(fl["d"], 2, "flatten shallow key");

// ── ENRICH: JSON Lines (ndjson) round-trip ───────────────────────────────────────
let rows = [map{ n: 1 }, map{ n: 2 }, map{ n: 3 }];
let nd = J.stringify_lines(rows);
eq(nd, "{\"n\":1.0}\n{\"n\":2.0}\n{\"n\":3.0}", "stringify_lines");
let parsed = J.parse_lines(nd + "\n");   // trailing newline + blank line tolerated
eq(len(parsed), 3, "parse_lines count"); eq(J.equal(parsed, rows), true, "parse_lines round-trip");

print "json_enrich_pass";
