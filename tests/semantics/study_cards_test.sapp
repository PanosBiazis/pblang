let Study=import("stdlib:study_cards.sapp");
let Doc=import("stdlib:text_document.sapp");
fn rejects(f) { let bad=false; try { f(); } catch { bad=true; } assert(bad,"invalid review rejected"); }
let notes=Doc.set_block(Doc.create("Study"),0,"heading","Τι είναι η PBLang;");
notes=Doc.insert_block(notes,1,"paragraph","Μια γλώσσα προγραμματισμού.");
notes=Doc.insert_block(notes,2,"heading","One plus one?");
notes=Doc.insert_block(notes,3,"paragraph","Two.");
let deck=Study.from_document(notes,"2026-09-27");
assert(len(deck.cards)==2 and len(Study.due(deck,"2026-09-27"))==2,"headings become review cards");
let reviewed=Study.review(deck,1,"good","2026-09-27");
assert(reviewed.cards[0].due=="2026-09-28" and reviewed.cards[0].stage==1,"first good review is tomorrow");
assert(deck.cards[0].reviews==0,"review does not mutate source deck");
reviewed=Study.review(reviewed,1,"good","2026-09-28");
assert(reviewed.cards[0].due=="2026-10-01" and reviewed.cards[0].stage==2,"second good review uses three days");
reviewed=Study.review(reviewed,1,"again","2026-10-01");
assert(reviewed.cards[0].due=="2026-10-02" and reviewed.cards[0].stage==0,"again resets interval");
assert(Study.encode(Study.decode(Study.encode(reviewed)))==Study.encode(reviewed),"native deck roundtrip");
assert(Study.due(reviewed,"2026-10-02")[0].id==2,"oldest due first");
rejects(fn(){Study.review(reviewed,1,"good","2026-10-01");});
rejects(fn(){Study.review(deck,3,"good","2026-09-27");});
rejects(fn(){Study.review(deck,1,"easy","2026-09-27");});
rejects(fn(){Study.from_document(Doc.from_text("orphan"),"2026-09-27");});
rejects(fn(){Study.from_document(Doc.set_block(Doc.create(),0,"heading","No answer"),"2026-09-27");});
rejects(fn(){Study.review(deck,1,"good","9999-12-31");});
let bad=Study.copy(deck); bad.cards[1].id=1; rejects(fn(){Study.validate(bad);});
let due=Study.due(deck,"2026-09-27"); due[0].answer="changed";
assert(deck.cards[0].answer!="changed","due cards detached");
print "study_cards_pass";
