// tests/semantics/decimal_test.sapp — arbitrary-precision base-10 decimals.

// Construction + type.
if str(decimal("3.14")) != "3.14" { throw "FAIL decimal parse"; }
if type(decimal("3.14")) != "decimal" { throw "FAIL decimal type"; }
if str(decimal("5")) != "5" { throw "FAIL decimal integer"; }
if str(decimal("-0.001")) != "-0.001" { throw "FAIL decimal negative"; }

// The headline: exact base-10 sums (floats give 0.30000000000000004).
if str(decimal("0.1") + decimal("0.2")) != "0.3" { throw "FAIL decimal add: " + str(decimal("0.1") + decimal("0.2")); }

// Money: exact products / sums.
if str(decimal("19.99") * decimal("3")) != "59.97" { throw "FAIL decimal mul"; }
if str(decimal("0.10") + decimal("0.20") + decimal("0.05")) != "0.35" { throw "FAIL decimal money"; }

// Division rounds to a fixed scale (terminates, unlike a rational fraction).
if str(decimal("10") / decimal("4")) != "2.5" { throw "FAIL decimal exact div"; }
let third = decimal("1") / decimal("3");
if str(third) != "0.33333333333333333333333333333333333333333333333333" { throw "FAIL decimal div scale: " + str(third); }

// Exponentiation (integer exponent, incl. negative).
if str(decimal("2.5") ** 2) != "6.25" { throw "FAIL decimal pow"; }
if str(decimal("2") ** -2) != "0.25" { throw "FAIL decimal negative pow"; }

// Normalization: trailing zeros dropped; 0.30 == 0.3.
if not (decimal("0.30") == decimal("0.3")) { throw "FAIL decimal normalize"; }
if str(decimal("1.50") - decimal("0.50")) != "1" { throw "FAIL decimal sub to int"; }

// Comparisons, incl. against plain numbers and across exact types.
if not (decimal("1.5") > decimal("1.49")) { throw "FAIL decimal gt"; }
if not (decimal("0.1") == 0.1) { throw "FAIL decimal == float"; }
if not (decimal("0.5") == rational("1/2")) { throw "FAIL decimal == rational"; }

// Cross-type: a decimal + bigint stays exact decimal.
if str(decimal("0.5") + bigint(2)) != "2.5" { throw "FAIL decimal + bigint"; }

// decimal -> rational conversion is exact.
if str(rational(decimal("0.25"))) != "1/4" { throw "FAIL decimal -> rational"; }

print "decimal_pass";
