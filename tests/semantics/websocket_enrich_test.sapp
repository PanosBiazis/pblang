// tests/semantics/websocket_enrich_test.sapp — fixes + enrichment for websocket
//
// FIXES:
//  * write_frame masked the payload by CODEPOINT (strcharcodeat) and used the
//    codepoint count as the length, so a non-ASCII text frame went on the wire as
//    invalid UTF-8 (e.g. "café" -> 4 bytes [..,0xE9] instead of the 5-byte UTF-8
//    [..,0xC3,0xA9]) — a real peer would reject it. Now framed from str_to_bytes.
//  * the parsed text payload decoded per-byte (strfromcharcode), corrupting
//    multi-byte UTF-8; now decoded with bytes_to_str.
// SECURITY: parse now rejects a frame whose declared payload exceeds a configurable
//    max_payload (memory-exhaustion guard).
// ENRICH + PERF: bit_xor builtin (was a hand-rolled XOR), write_text/write_binary,
//    ping/pong/close, decode_close.

let ws = import("stdlib/websocket.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn bytes_eq(a, b, m) {
    if len(a) != len(b) { fail(m + " len " + str(len(a)) + " vs " + str(len(b))); }
    let i = 0;
    while i < len(a) { if a[i] != b[i] { fail(m + " @" + str(i)); } i = i + 1; }
}

// ── FIX: a text frame carries correct UTF-8 bytes ───────────────────────────────
let f = ws.write_frame(1, "café");
let parsed = ws.parse_frame(f);
let want = str_to_bytes("café");                 // [0x63,0x61,0x66,0xC3,0xA9]
eq(parsed.payload_len, len(want), "declared length is the UTF-8 byte count");
bytes_eq(parsed.payload_bytes, want, "unmasked payload is valid UTF-8");
eq(ws.parse_message(f).payload, "café", "round-trips to the original text");

// ── ASCII round-trip still works ────────────────────────────────────────────────
eq(ws.parse_message(ws.write_frame(1, "hello")).payload, "hello", "ascii round-trip");

// ── ENRICH: binary frames (byte arrays) ─────────────────────────────────────────
let bf = ws.write_binary([1, 2, 3, 255, 0]);
let bp = ws.parse_frame(bf);
eq(bp.opcode, 2, "binary opcode 2");
bytes_eq(bp.payload_bytes, [1, 2, 3, 255, 0], "binary payload preserved incl. >=128 and 0");

// ── ENRICH: control-frame helpers ───────────────────────────────────────────────
eq(ws.parse_frame(ws.ping("hi")).opcode, 9, "ping opcode");
eq(ws.parse_frame(ws.pong("hi")).opcode, 10, "pong opcode");
let cf = ws.close(1000, "bye");
let cp = ws.parse_frame(cf);
eq(cp.opcode, 8, "close opcode");
let dc = ws.decode_close(cp.payload_bytes);
eq(dc.code, 1000, "close code decoded");
eq(dc.reason, "bye", "close reason decoded");

// ── SECURITY: oversized declared payload is rejected ────────────────────────────
ws.set_max_payload(8);
eq(ws.get_max_payload(), 8, "max_payload configurable");
// Build a 126-extended-length frame claiming 1000 bytes but only a few present.
let big = [129, 254, 3, 232];   // FIN+text, len=126, 16-bit length 0x03E8 = 1000
let r = ws.parse_frame(big);
if (try r.error catch nil) == nil { fail("oversized payload must error"); }
ws.set_max_payload(16777216);   // restore

print "websocket_enrich_pass";
