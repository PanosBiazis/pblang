// Test: thread stdlib — pipeline pattern
import "stdlib:thread.sapp";

// Pipeline: [1..5] → double → filter evens → collect
let source = thread.pipeline_source([1, 2, 3, 4, 5]);
let doubled = thread.pipeline_stage(source, fn(x) { return x * 2; });
let evens = thread.pipeline_stage(doubled, fn(x) {
    if x - num_floor(x / 4) * 4 == 0 { return x; }
    return nil;  // nil values are filtered out by pipeline_stage
});
let result = thread.pipeline_collect(evens);

// doubled: [2,4,6,8,10], filter multiples of 4: [4,8]
if len(result) != 2 { print "FAIL pipeline result length: " + str(len(result)); }
if result[0] != 4 { print "FAIL pipeline result[0]: " + str(result[0]); }
if result[1] != 8 { print "FAIL pipeline result[1]: " + str(result[1]); }

print "pipeline_pass";
