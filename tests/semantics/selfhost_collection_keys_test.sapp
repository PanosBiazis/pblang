let FE = import("stdlib:compiler/selfhost_frontend.sapp");
let source = "let F = import(\"stdlib:functional.sapp\"); let A = import(\"stdlib:array.sapp\");"
    + "let mixed = F.unique([1,\"1\",true,\"true\",nil,\"nil\",1]);"
    + "let rows = [map{id:1},map{id:\"1\"},map{id:1}]; let seen = [];"
    + "let distinct = A.distinct_by(rows,fn(x){push(seen,x.id);return x.id;});"
    + "let grouped = F.group_by_entries(rows,fn(x){return x.id;});"
    + "let bad = try map{ok:true,value:F.unique([map{x:1}])} catch map{ok:false};"
    + "let result = [mixed,len(distinct),seen,grouped[0].key,len(grouped[0].items),grouped[1].key,len(grouped[1].items),bad.ok,A.unique([1,\"1\",1])];";
let run = FE.frontend_run_bounded(source,map{max_steps:30000,max_frames:32,max_modules:8,max_source_bytes:32768});
if not run.ok { throw "FAIL selfhost-collection-keys: library import/run"; }
if run.globals.result != [[1,"1",true,"true",nil,"nil"],2,[1,"1",1],1,2,"1",1,false,[1,"1"]] {
    throw "FAIL selfhost-collection-keys: exact typed result";
}
print "selfhost_collection_keys_pass";
