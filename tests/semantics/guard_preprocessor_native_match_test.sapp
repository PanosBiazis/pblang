// tests/semantics/guard_preprocessor_native_match_test.sapp
//
// The guard preprocessor (stdlib/compiler/guard_preprocessor.sapp) existed to
// work around an OLD parser that couldn't handle match guards. The self-hosted
// parser now handles `match` natively, including `case PAT if GUARD : BODY` and
// literal patterns. But `preprocess` ran UNCONDITIONALLY (the file/module-import
// paths in selfhost_frontend call it on every source), and it rewrote a NATIVE
// match's literal-pattern arms (`case 1 :`, `case 2 :`) into `if (true)` /
// `else if (true)` -- so the FIRST arm always won and every native match with
// literal patterns returned the wrong value.
//
// Fix: preprocess only transforms sources that actually use the LEGACY guard
// separators (` ~ ` / ` # `, detected by has_guards). Native colon-syntax matches
// are left untouched for the real parser to handle.

let gp = import("stdlib/compiler/guard_preprocessor.sapp");
let fe = import("stdlib/compiler/selfhost_frontend.sapp");
let vm = import("stdlib/compiler/vm.sapp");

fn fail(m) { throw "FAIL " + m; }

// Compile (via guard preprocess, like the file/module paths do) and run; return
// the first printed value.
fn pp_run(src) {
    let processed = gp.preprocess(src);
    let ch = fe.frontend_compile(processed).chunk;
    let out = vm.run(ch).output;
    if len(out) == 0 { return "NOOUT"; }
    return out[0];
}

// 1. has_guards distinguishes native colon-syntax from legacy ~/# syntax.
let native = "let x = 2; let r = match x { case 1 : \"one\"; case 2 : \"two\"; else : \"other\"; }; print r;";
if gp.has_guards(native) { fail("native colon-match must NOT be flagged as guarded"); }

// 2. preprocess must NOT alter a native match (no legacy separators present).
if gp.preprocess(native) != native { fail("native match was rewritten by preprocess:\n" + gp.preprocess(native)); }

// 3. The native match must select the matching arm, not the first one.
let r2 = pp_run(native);
if r2 != "two" { fail("native literal-pattern match must return \"two\" for x=2, got " + str(r2)); }

// 3b. A different scrutinee selects a different arm (proves it's not always-first).
let r0 = pp_run("let x = 9; let r = match x { case 1 : \"one\"; case 2 : \"two\"; else : \"other\"; }; print r;");
if r0 != "other" { fail("native match else-arm must fire for x=9, got " + str(r0)); }

// 3c. A native match with a GUARD (colon syntax) still works through preprocess.
let rg = pp_run("let x = 7; let r = match x { case n if n > 5 : \"big\"; case n : \"small\"; }; print r;");
if rg != "big" { fail("native guarded colon-match must return \"big\" for x=7, got " + str(rg)); }

// 4. LEGACY ~-guard syntax is still transformed and still runs correctly.
let legacy = "let x = -5; let r = match x { case n if n > 0 ~ \"pos\"; case n if n < 0 ~ \"neg\"; else: \"zero\"; }; print r;";
if not gp.has_guards(legacy) { fail("legacy ~-guard must be flagged as guarded"); }
if gp.preprocess(legacy) == legacy { fail("legacy ~-guard must still be transformed"); }
if pp_run(legacy) != "neg" { fail("legacy ~-guard must return \"neg\" for x=-5, got " + str(pp_run(legacy))); }

print "guard_preprocessor_native_match_pass";
