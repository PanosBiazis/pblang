// tests/semantics/security_token_test.sapp
// Token generation must work: generate_token base64-encodes RANDOM BYTES, so it must use
// the byte-array base64 builtin (regression: it used the string variant and always threw).
let sec = import("stdlib:security.sapp");

let t = sec.generate_token(16);
if t == nil or len(t) == 0 { throw "FAIL generate_token(16) empty"; }

// length omitted -> defaults to 32 bytes of entropy (optional-arg path)
let t2 = sec.generate_token();
if t2 == nil or len(t2) == 0 { throw "FAIL generate_token() default length"; }

let key = sec.generate_api_key();
if key == nil or not str_starts_with(key, "pbl_") { throw "FAIL generate_api_key prefix"; }

let csrf = sec.generate_csrf_token();
if csrf == nil or len(csrf) == 0 { throw "FAIL generate_csrf_token empty"; }

print "security_token_pass";
