let T=import("stdlib:pipeline_timing.sapp");
let jobs=[map{id:"a",needs:[]},map{id:"b",needs:["a"]},map{id:"c",needs:["a"]},map{id:"d",needs:["b","c"]}];
let durations=map{a:10,b:20,c:5,d:3}; let r=T.analyze(jobs,durations,true);
assert(r.lower_bound_ms==33 and r.serial_duration_ms==38 and r.critical_job_count==3,"diamond critical path");
assert(r.jobs[2].id=="c" and r.jobs[2].slack_ms==15 and r.jobs[3].earliest_start_ms==30,"slack and join timing");
let masked=T.analyze(jobs,durations); assert(not masked.contains_job_ids and not map_has(masked.jobs[0],"id"),"masked default");
assert(durations.c==5 and len(jobs[0].needs)==0,"inputs unchanged");
let source=json_stringify(map{format:"pblang.pipeline-estimate.v1",jobs:jobs,durations_ms:durations});
assert(T.inspect_text(source).lower_bound_ms==33,"strict document inspector");
for source in [nil,"", "{\"format\":1,\"format\":2}",str_repeat("x",65537)] { let bad=T.inspect_text(source); assert(not bad.ok and bad.jobs==[],"invalid buffer failure"); }
for d in [map{a:10,b:20,c:5},map{a:10,b:20,c:5,d:3,extra:1},map{a:10,b:20,c:-1,d:3},map{a:10,b:20,c:0.5,d:3},map{a:10,b:20,c:86400001,d:3}] {
 assert((try T.analyze(jobs,d) catch "bad")=="bad","duration validation");
}
let parallel=T.analyze([map{id:"a",needs:[]},map{id:"b",needs:[]}],map{a:5,b:10});
assert(parallel.lower_bound_ms==10 and parallel.jobs[0].slack_ms==5,"disconnected branches share completion deadline");
assert(T.analyze([map{id:"a",needs:[]}],map{a:0}).lower_bound_ms==0,"zero duration");
assert((try T.analyze([map{id:"a",needs:["b"]},map{id:"b",needs:["a"]}],map{a:1,b:1}) catch "bad")=="bad","cycles rejected");
print "pipeline_timing_pass";
