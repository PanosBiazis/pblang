// Test: stdlib/complex.sapp operator overloading — complex numbers now support
// natural `+ - * /`, unary `-`, and `==` (alongside the add/sub/mul function API),
// handling both complex and scalar operands. Showcases operator overloading.

let cx = import("stdlib:complex.sapp");

let a = cx.new(1, 2);
let b = cx.new(3, 4);

// Addition / subtraction
let s = a + b;
assert(cx.re(s) == 4 and cx.im(s) == 6, "complex a + b = (4,6)");
let d = b - a;
assert(cx.re(d) == 2 and cx.im(d) == 2, "complex b - a = (2,2)");

// Multiplication: (1+2i)(3+4i) = 3+4i+6i+8i^2 = -5+10i
let m = a * b;
assert(cx.re(m) == 0 - 5 and cx.im(m) == 10, "complex a * b = (-5,10)");

// Scalar multiply (forward and reflected)
let sc = a * 10;
assert(cx.re(sc) == 10 and cx.im(sc) == 20, "complex * scalar = (10,20)");
let rsc = 10 * a;
assert(cx.re(rsc) == 10 and cx.im(rsc) == 20, "scalar * complex via __rmul__ = (10,20)");

// Unary minus (via __rsub__, since -z == 0 - z)
let neg = -a;
assert(cx.re(neg) == 0 - 1 and cx.im(neg) == 0 - 2, "-complex = (-1,-2)");

// Complex + scalar / scalar + complex (real-axis add)
let ar = a + 5;
assert(cx.re(ar) == 6 and cx.im(ar) == 2, "complex + scalar = (6,2)");
let ra = 5 + a;
assert(cx.re(ra) == 6 and cx.im(ra) == 2, "scalar + complex = (6,2)");

// Division: complex / complex and complex / scalar
let q = b / a;            // (3+4i)/(1+2i) = (11 - 2i)/5 = 2.2 - 0.4i
assert(cx.re(q) == 2.2 and cx.im(q) == 0 - 0.4, "complex / complex");
let qs = b / 2;
assert(cx.re(qs) == 1.5 and cx.im(qs) == 2, "complex / scalar = (1.5,2)");

// Equality (by value, ignoring the dunder closures)
assert((a == cx.new(1, 2)) == true, "complex == equal value");
assert((a == b) == false, "complex == distinct");
assert((cx.new(7, 0) == 7) == true, "real complex == matching scalar");

// Function API still works alongside operators
assert(cx.abs(b) == 5, "cx.abs((3,4)) == 5");
assert(cx.re(cx.add(a, b)) == 4, "cx.add still works");

// A small computation reading like ordinary math
let z = (a + b) * cx.new(2, 0) - a;   // ((4,6)*2) - (1,2) = (8,12)-(1,2) = (7,10)
assert(cx.re(z) == 7 and cx.im(z) == 10, "mixed expression (a+b)*2 - a = (7,10)");

print "complex_operators_pass";
