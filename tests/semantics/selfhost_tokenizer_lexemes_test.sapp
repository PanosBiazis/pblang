let T=import("stdlib:compiler/tokenizer.sapp");
fn expect(ok,label) {if not ok {throw "FAIL tokenizer-lexemes: "+label;}}
fn token(kind,text,line,col) {return map{kind:kind,text:text,line:line,col:col};}
fn check(source,expected) {
    let actual=T.tokenize(source);
    expect(json_stringify(actual)==json_stringify(expected),"exact independent lexical fixture");
    let bounded=T.tokenize_bounded(source,len(expected));
    expect(bounded.ok and json_stringify(bounded.tokens)==json_stringify(expected),"bounded parity");
}
check("n-1",[token("ident","n",1,1),token("operator","-",1,2),token("number","1",1,3),token("eof","",1,4)]);
check("1..3",[token("number","1",1,1),token("operator","..",1,2),token("number","3",1,4),token("eof","",1,5)]);
for text in ["-1.20E+03","1.e+2","01.0e-2","1.","-0","123"] {
    check(text,[token("number",text,1,1),token("eof","",1,len(text)+1)]);
}
check("1.e+",[token("invalid","invalid number literal",1,1),token("eof","",1,5)]);
check("-0x10",[token("number","-16",1,1),token("eof","",1,6)]);
check("//π\r\nx",[token("comment","π\r",1,1),token("ident","x",2,1),token("eof","",2,2)]);
check("/*a\nπ*/x",[token("comment","a\nπ",1,1),token("ident","x",2,4),token("eof","",2,5)]);
check("/**/",[token("comment","",1,1),token("eof","",1,5)]);
let unfinished=token("comment","a\nπ",1,1);unfinished.unterminated=true;
check("/*a\nπ",[unfinished,token("eof","",2,2)]);
let slash=token("comment","/",1,1);slash.unterminated=true;
check("/*/",[slash,token("eof","",1,4)]);
for word in ["café9","é","変数","π",str_repeat("a",4096)] {
    let expected=token("ident",word,1,1);expected.source_start=0;expected.source_end=len(word);
    expect(json_stringify(T.tokenize(word,true))==json_stringify([expected,token("eof","",1,len(word)+1)]),"Unicode scalar spans");
}
let long=str_repeat("π",4096);
check("/*"+long+"*/",[token("comment",long,1,1),token("eof","",1,len(long)+5)]);
let denied=T.tokenize_bounded("/*private-lexeme-marker*/",1);
expect(not denied.ok and len(denied.tokens)==0 and not str_contains(json_stringify(denied),"private-lexeme-marker"),"budget before lexeme join");
print "selfhost_tokenizer_lexemes_pass";
