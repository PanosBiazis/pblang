// Test: thread stdlib — Actor model
import "stdlib:thread.sapp";

// Counter actor: state is a number, messages are "inc" or "dec"
let counter_actor = thread.actor(0, fn(state, msg) {
    if msg == "inc" { return state + 1; }
    if msg == "dec" { return state - 1; }
    return state;
});

// Send messages
thread.actor_send(counter_actor, "inc");
thread.actor_send(counter_actor, "inc");
thread.actor_send(counter_actor, "inc");
thread.actor_send(counter_actor, "dec");

// Stop the actor and get the final state
thread.actor_stop(counter_actor);
let final_state = thread.actor_get_result(counter_actor);

if final_state != 2 { throw "FAIL actor final state: " + str(final_state); }

// Accumulator actor: builds a list
let acc_actor = thread.actor([], fn(state, msg) {
    array_push(state, msg);
    return state;
});
thread.actor_send(acc_actor, "a");
thread.actor_send(acc_actor, "b");
thread.actor_send(acc_actor, "c");
thread.actor_stop(acc_actor);
let acc_result = thread.actor_get_result(acc_actor);
if len(acc_result) != 3 { throw "FAIL actor accumulator len: " + str(len(acc_result)); }
if acc_result[0] != "a" { throw "FAIL actor accumulator[0]"; }

print "actor_pass";
