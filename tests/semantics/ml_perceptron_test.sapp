let ML = import("stdlib:ml.sapp");

fn require(condition, message) {
    if not condition { throw "FAIL ml_perceptron: " + message; }
}

fn rejected(action) {
    let result = try action() catch nil;
    return result == nil;
}

let samples = [[0, 0], [0, 1], [1, 0], [1, 1]];
let and_labels = [0, 0, 0, 1];
let initial = ML.perceptron_create([0.2, 0.3], 0.1);
require(initial.format == "pblang.ml.perceptron.v1" and initial.feature_count == 2,
    "created models must publish the stable format and feature contract");
let trained = ML.perceptron_train(initial, samples, and_labels,
    map{ learning_rate: 0.1, max_epochs: 100, early_stop: true });
let evaluated = ML.perceptron_evaluate(trained.model, samples, and_labels);

require(trained.converged and evaluated.accuracy == 1 and evaluated.mistakes == 0,
    "AND must converge with exact predictions");
require(trained.model.bias != initial.bias and initial.bias == 0.1,
    "bias updates must persist without mutating the input model");
require(trained.epochs_run <= 100 and trained.training_steps <= 400
    and trained.bounded and not trained.input_model_mutated,
    "training must publish bounded execution evidence");
require(ML.perceptron_predict(trained.model, [1, 1]) == 1
    and ML.perceptron_predict(trained.model, [1, 0]) == 0,
    "single-row prediction must use the trained state");

let xor_labels = [0, 1, 1, 0];
let xor_result = ML.perceptron_train(initial, samples, xor_labels,
    map{ learning_rate: 0.1, max_epochs: 40 });
require(not xor_result.converged
    and ML.perceptron_evaluate(xor_result.model, samples, xor_labels).accuracy < 1,
    "single perceptron must not claim convergence on XOR");

require(rejected(fn() { return ML.perceptron_create([], 0); }),
    "empty models must be rejected");
require(rejected(fn() { return ML.perceptron_predict(initial, [1]); }),
    "feature dimension mismatch must be rejected");
require(rejected(fn() { return ML.perceptron_train(initial, samples, [0, 1], nil); }),
    "label count mismatch must be rejected");
require(rejected(fn() { return ML.perceptron_train(initial, samples, [0, 1, 1, 2], nil); }),
    "non-binary labels must be rejected");
require(rejected(fn() { return ML.perceptron_train(initial, samples, and_labels,
    map{ max_epocs: 10 }); }), "unknown options must fail closed");
require(rejected(fn() { return ML.perceptron_train(initial, samples, and_labels,
    map{ max_epochs: 10001 }); }), "epoch bounds must be enforced");

let wide_weights = [];
let wide_row = [];
let wide_index = 0;
while wide_index < 4096 {
    array_push(wide_weights, 0);
    array_push(wide_row, 0);
    wide_index = wide_index + 1;
}
let oversized_rows = [];
let oversized_labels = [];
let row_index = 0;
while row_index < 489 {
    array_push(oversized_rows, wide_row);
    array_push(oversized_labels, 0);
    row_index = row_index + 1;
}
let wide_model = ML.perceptron_create(wide_weights, 0);
require(rejected(fn() { return ML.perceptron_evaluate(
    wide_model, oversized_rows, oversized_labels); }),
    "aggregate dataset values must be rejected before defensive copying");

print "ml_perceptron_pass";
