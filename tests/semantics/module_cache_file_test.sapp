// Fixture preparation and FFI grants: tests/tooling/module_cache_file_check.py.
let C = import("stdlib:compiler/module_cache_file.sapp");
fn require(value, message) { if not value { throw "module_cache_file: " + message; } }
let initial_descriptors = len(fs_listdir("/proc/self/fd"));
let results = [];
fn record(label, value) { array_push(results, map{ label: label, result: value }); }

let written = C.write_text_atomic("new/value", "α😀");
require(written.ok and written.atomic and written.durability_verified, "new private parent publication: " + json_stringify(written));
record("new", written);
let loaded = C.read_text("new/value", 6);
require(loaded.ok and loaded.text == "α😀" and loaded.size == 6, "UTF-8 exact boundary");
record("exact", loaded);
let short = C.read_text("new/value", 5);
require(not short.ok, "bounded snapshot rejects overflow"); record("short", short);
let empty = C.write_atomic("new/empty", []);
require(empty.ok and C.read_bytes("new/empty", 0).ok, "empty bytes"); record("empty", empty);
require(C.write_atomic("new/invalid-utf8", [255]).ok, "invalid UTF-8 fixture");
let invalid = C.read_text("new/invalid-utf8", 1);
require(not invalid.ok, "invalid UTF-8 rejection"); record("utf8", invalid);
for path in [nil, 7, "", ".", "..", "new/", "new/a\\b", "new/" + strfromcharcode(0)] {
    let value = C.read_bytes(path, 8); require(not value.ok, "invalid path"); record("path", value);
}
for limit in [nil, "8", -1, 0.5, 67108865] {
    let value = C.read_bytes("new/value", limit); require(not value.ok, "invalid limit"); record("limit", value);
}
for path in ["shared/file", "parent-link/file", "missing/deep/file"] {
    let value = C.write_text_atomic(path, "denied");
    require(not value.ok, "parent policy"); record("parent", value);
}
for path in ["private/final-link", "private/fifo", "private/folder", "private/absent"] {
    let value = C.read_bytes(path, 8); require(not value.ok, "unsafe/missing read"); record("read", value);
}
// Atomic replacement replaces the entry, without following final links.
// This is the existing cache contract, not exclusive no-overwrite publication.
for path in ["private/final-link", "private/hardlink"] {
    let value = C.write_text_atomic(path, "new"); require(value.ok, "atomic replacement"); record("replace", value);
}
require(C.read_text("outside", 16).text == "outside", "external inode unchanged");
let absolute = cwd() + "/private/absolute";
require(C.write_text_atomic(absolute, "abs").ok, "absolute private parent");
require(C.read_text(absolute, 3).text == "abs", "absolute read");
require(C.remove(absolute).ok, "absolute cleanup");
let removed = C.remove("new/value"); require(removed.ok, "remove"); record("remove", removed);
let absent = C.remove("new/value"); require(not absent.ok, "missing remove"); record("absent", absent);
for i in range(0, 8) {
    let text = "value" + str(i);
    require(C.write_text_atomic("new/repeated", text).ok, "repeated write");
    require(C.read_text("new/repeated", 6).text == text, "repeated read");
    require(C.remove("new/repeated").ok, "repeated remove");
}
require(len(fs_listdir("/proc/self/fd")) == initial_descriptors, "held descriptors closed");
print json_stringify(results);
print "module_cache_file_pass";
