// Test: testing.sapp framework
let t = import("stdlib:testing.sapp");

// Test the expect builder
let e = t.expect(42);
e.to_equal(42);
e.not_to_equal(99);
e.to_be_type("number");

let e2 = t.expect("hello");
e2.to_contain("ell");
e2.to_have_length(5);

let e3 = t.expect([1, 2, 3]);
e3.to_contain(2);
e3.to_have_length(3);

// Test expect_throws
t.expect_throws(fn() { return error("boom"); });

// Test assert helpers
t.assert_equal(1 + 1, 2);
t.assert_true(true);
t.assert_false(false);
t.assert_nil(nil);
t.assert_not_nil(42);

print "testing stdlib tests passed";
