let Catalog = import("stdlib:file_catalog.sapp");

fn require(value, message) { if not value { throw "FAIL file_catalog: " + message; } }
fn rejected(callable) { return (try { callable(); false } catch true); }

require(Catalog.classify("MAIN.SAPP").label == "PBLang Source",
    "classification is case insensitive");
require(Catalog.classify("archive.tar.gz").suffix == ".tar.gz",
    "multipart suffix wins before gzip fallback");
require(Catalog.classify("interop.h").label == "C/C++ Header",
    "ambiguous C-family header is explicit");
require(Catalog.classify("mobile.apk").label == "Android Package",
    "APK is not misclassified as a generic executable");
require(Catalog.classify("module.mod").label == "Module File",
    "ambiguous module suffix is not falsely claimed as Go or Fortran");
require(Catalog.classify(".gitignore").family == "configuration",
    "well-known extensionless metadata is classified");
require(not Catalog.classify("README").known,
    "unknown extensionless names remain unknown");
require(rejected(fn() { Catalog.classify(42); }), "non-string path fails");

let names = ["main.sapp", "photo.PNG", "manual.pdf", "archive.tar.gz",
    "records.sqlite3", "README"];
let before = str(names);
let report = Catalog.summarize(names);
require(report.total_files == 6 and report.known_files == 5 and report.unknown_files == 1,
    "summary counts known and unknown files");
require(report.by_family.source == 1 and report.by_family.image == 1
    and report.by_family.document == 1 and report.by_family.archive == 1
    and report.by_family.database == 1 and report.by_family.unknown == 1,
    "family histogram is deterministic");
require(not report.names_included and len(report.classified_items) == 0
    and str_contains(report.privacy, "aggregate counts only"),
    "summary is private by default");
require(str(names) == before, "summary does not mutate caller input");

let disclosed = Catalog.summarize(["nested/private-name.py"], map{ include_names: true });
require(disclosed.names_included and len(disclosed.classified_items) == 1
    and disclosed.classified_items[0].name == "private-name.py"
    and not str_contains(str(disclosed.classified_items), "nested/"),
    "explicit disclosure includes basename but not directory path");

let plan = Catalog.visualization_plan(report, 640, 360);
require(len(plan.bars) == 6 and len(plan.donut_sectors) == 6
    and len(plan.radial_columns) == 6 and len(plan.accessible_rows) == 6,
    "all portable visualization views cover every family");
require(plan.donut_sectors[len(plan.donut_sectors) - 1].end_degrees == 360,
    "donut sectors cover one complete circle");
require(rejected(fn() { Catalog.visualization_plan(report, 100, 360); }),
    "undersized visualization fails");

let ROOT = "tests/fixtures/_file_catalog";
fn cleanup() {
    try fs_remove(ROOT + "/main.sapp") catch nil;
    try fs_remove(ROOT + "/image.png") catch nil;
    try fs_remove(ROOT + "/notes.txt") catch nil;
    try fs_remove(ROOT + "/nested/ignored.py") catch nil;
    try fs_remove(ROOT + "/nested") catch nil;
    try fs_remove(ROOT) catch nil;
}
cleanup();
fs_mkdirs(ROOT + "/nested");
fs_write(ROOT + "/main.sapp", "print 1;");
fs_write(ROOT + "/image.png", "fixture");
fs_write(ROOT + "/notes.txt", "fixture");
fs_write(ROOT + "/nested/ignored.py", "print(1)");
let scanned = Catalog.scan_directory(ROOT);
require(scanned.total_files == 3 and scanned.scanned_entries == 4,
    "scan covers only immediate files while observing the nested directory");
require(not scanned.names_included and scanned.scan_scope == "one directory level, metadata only",
    "scan preserves privacy and bounded scope");
require(rejected(fn() { Catalog.scan_directory(ROOT + "/notes.txt"); }),
    "scan_directory rejects a file path");
cleanup();

let oversized = [];
let i = 0;
while i < 4097 { array_push(oversized, "x.txt"); i = i + 1; }
require(rejected(fn() { Catalog.summarize(oversized); }), "oversized input fails");

let caps = Catalog.capabilities();
require(caps.rule_count > 100 and caps.maximum_items == 4096,
    "capabilities publish useful bounds");
require(not caps.content_detection and not caps.magic_byte_detection and not caps.recursive_scan,
    "unsupported deep inspection remains explicit");

print "file_catalog_pass";
