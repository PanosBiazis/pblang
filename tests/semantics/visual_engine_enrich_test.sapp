// tests/semantics/visual_engine_enrich_test.sapp — enrichment for stdlib/visual_engine.sapp
// Adds node_count and interpolate_at (linear keyframe interpolation).

let V = import("stdlib/visual_engine.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let sc = V.scene(640, 360, nil);
V.add(sc, V.rect("bg", 0, 0, 640, 360, [0, 0, 0, 255]));
V.add(sc, V.circle2d("dot", 50, 50, 8));

// ── ENRICH: node_count ───────────────────────────────────────────────────────────
eq(V.node_count(sc), 2, "two nodes in the scene");

// ── ENRICH: interpolate_at (keyframe animation) ──────────────────────────────────
V.add_key(sc, "dot", 0, map{ x: 0 });
V.add_key(sc, "dot", 10, map{ x: 100 });
eq(V.interpolate_at(sc, "dot", "x", 5), 50, "midpoint interpolation");
eq(V.interpolate_at(sc, "dot", "x", 0), 0, "at first keyframe");
eq(V.interpolate_at(sc, "dot", "x", 10), 100, "at last keyframe");
eq(V.interpolate_at(sc, "dot", "x", 0 - 5), 0, "before first clamps to first");
eq(V.interpolate_at(sc, "dot", "x", 20), 100, "after last clamps to last");
eq(V.interpolate_at(sc, "dot", "y", 5), nil, "no keys for prop -> nil");

print "visual_engine_enrich_pass";
