// tests/semantics/systems_enrich2_test.sapp — wave 2 for stdlib/systems.sapp
// big-endian pack/unpack + buffer_fill/buffer_equal.

let S = import("stdlib/systems.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn arreq(a, b, m) {
    if len(a) != len(b) { fail(m + " len " + str(a)); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " [" + str(i) + "] " + str(a)); } i = i + 1; }
}

// ── 16-bit BE ───────────────────────────────────────────────────────────────────────
arreq(S.pack_u16_be(4660), [18, 52], "pack_u16_be 0x1234 = [0x12,0x34]");
eq(S.unpack_u16_be([18, 52]), 4660, "unpack_u16_be");
// endianness differs from LE
arreq(S.pack_u16_le(4660), [52, 18], "LE is reversed");

// ── 32-bit BE ───────────────────────────────────────────────────────────────────────
arreq(S.pack_u32_be(305419896), [18, 52, 86, 120], "pack_u32_be 0x12345678 MSB-first");
eq(S.unpack_u32_be(S.pack_u32_be(305419896)), 305419896, "u32 BE round-trip");
eq(S.unpack_u32_be(S.pack_u32_be(4294967295)), 4294967295, "u32 BE max round-trip");

// ── buffer_fill / buffer_equal ──────────────────────────────────────────────────────
arreq(S.buffer_fill(3, 7), [7, 7, 7], "fill");
arreq(S.buffer_fill(0, 5), [], "fill 0 -> empty");
if not S.buffer_equal([1, 2, 3], [1, 2, 3]) { fail("equal buffers"); }
if S.buffer_equal([1, 2], [1, 3]) { fail("differing byte -> not equal"); }
if S.buffer_equal([1], [1, 2]) { fail("different length -> not equal"); }

print "systems_enrich2_pass";
