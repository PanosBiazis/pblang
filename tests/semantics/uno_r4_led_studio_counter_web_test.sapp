let Web=import("../../examples/uno_r4_led_studio/web.sapp");let M=import("../../examples/uno_r4_led_studio/model.sapp");
fn req(method,path="/",body="") {return map{method:method,path:path,body:body,headers:map{host:"127.0.0.1:18773",origin:"http://127.0.0.1:18773","content-type":"application/x-www-form-urlencoded"}};}
fn hidden(page,key) {return str_split(str_split(page.body,"name=\""+key+"\" value=\"")[1],"\"")[0];}
fn body(page,action,start="0",end="3",seconds="10") {return "csrf="+hidden(page,"csrf")+"&revision="+hidden(page,"revision")+"&action="+action+"&f_text=PB&f_duration=250&workspace=dynamic&counter_start="+url_encode(start)+"&counter_end="+url_encode(end)+"&counter_seconds="+url_encode(seconds);}
let app=Web.create(18773,map{hide_source_names:false,discourage_scraping:false,throttle_rejected_requests:false});
M.apply(app.state,"add");M.apply(app.state,"preset","border");let original=M.export_document(app.state);let p=app.handle(req("GET"));
assert(str_contains(p.body,"workspace-dynamic") and not str_contains(p.body,"http-equiv=\"refresh\""),"opening never starts automatic updates");
p=app.handle(req("POST","/action",body(p,"do_counter_start")));let project=M.export_project(app.state);
assert(app.state.playing and app.state.source=="counter" and str_contains(p.body,"Counter 00") and str_contains(p.body,"http-equiv=\"refresh\"") and not str_contains(p.body,"<set "),"Start runs current time source without authored SVG sequence");
let stop_token=hidden(p,"csrf");app.state.started=num_floor(now_ms())-11000;app.state.last_time=app.state.started;
p=app.handle(req("GET"));assert(app.state.counter_value==1 and str_contains(p.body,"Counter 01") and hidden(p,"csrf")==stop_token,"automatic sample update keeps Stop token valid");
assert(app.handle(req("GET","/frames.json")).body==original and app.handle(req("GET","/project.json")).body==project,"both exports remain deterministic while generator runs");
let before=json_stringify(app.state);let bad=req("POST","/action",body(p,"do_counter_settings","9","0","1"));bad.headers.origin="https://invalid.example";
assert(app.handle(bad).status==403 and json_stringify(app.state)==before,"origin guard before generator changes");
p=app.handle(req("POST","/action",body(p,"do_stop")));
assert(not app.state.playing and app.state.source=="frames" and not str_contains(p.body,"http-equiv=\"refresh\"") and M.export_document(app.state)==original,"Stop removes refresh and preserves full authored document");
p=app.handle(req("POST","/action",body(p,"do_counter_settings","<bad>","3","10")));
assert(str_contains(p.body,"&lt;bad&gt;") and str_contains(p.body,"Counter: values 0–99") and str_contains(p.body,"value=\"dynamic\" form=\"led-editor\" checked") and M.export_project(app.state)==project,"invalid draft retained and escaped, workspace/config/document unchanged");
let stale=body(p,"do_counter_start");p=app.handle(req("POST","/action",stale));
assert(app.handle(req("POST","/action",stale)).status==403,"repeated Start from stale form cannot restart clock");
app.state.started=num_floor(now_ms())-45000;app.state.last_time=app.state.started;p=app.handle(req("GET"));
assert(not app.state.playing and app.state.counter_value==3 and str_contains(p.body,"Counter complete at 03") and not str_contains(p.body,"http-equiv=\"refresh\"") and M.export_document(app.state)==original,"finite deadline restores editor and leaves original frames");
p=app.handle(req("POST","/action",body(p,"do_counter_start")));
p=app.handle(req("POST","/action",body(p,"do_import")+"&animation="+url_encode(project)));
assert(not app.state.playing and app.state.generator.start==0 and app.state.counter_value==0 and app.state.index==0 and M.export_project(app.state)==project,"project import during counter restores stopped source config");
p=app.handle(req("POST","/action",body(p,"do_counter_start")));let started=app.state.started;let imported=M.export_project(app.state);
p=app.handle(req("POST","/action",body(p,"do_import")+"&animation=%7Bbad"));
assert(app.state.playing and app.state.started==started and M.export_project(app.state)==imported,"invalid import preserves running generator");
p=app.handle(req("POST","/action",body(p,"do_import")+"&animation="+url_encode(original)));
assert(app.state.generator==nil and not app.state.playing and M.export_document(app.state)==original,"legacy import clears absent config and stops updates");
for extra in ["&counter_start=1", "&counter_seconds=%00"] {let before=json_stringify(app.state);assert(app.handle(req("POST","/action",body(p,"do_counter_start")+extra)).status==400 and json_stringify(app.state)==before,"duplicate/malformed generator transport fails before action");}
app.close();assert(app.handle(req("GET")).status==503 and not app.state.playing,"closed source cannot keep refreshing valid pages");
print "uno_r4_led_studio_counter_web_pass";
