let LINK = import("stdlib:source_inliner.sapp");
let FRONT = import("stdlib:compiler/selfhost_frontend.sapp");

fn fail(message) { throw "FAIL source_linker_bounded: " + message; }
fn expect(condition, message) { if not condition { fail(message); } }

let modules = map{
    "lib/math.sapp": "const B = import(\"../shared/base.sapp\"); const Factor = 2; fn scaled(x) { return B.base(x) * Factor; } export scaled;",
    "shared/base.sapp": "fn base(x) { return x + 1; } export base;"
};
let main_source = "const M = import(\"../lib/math.sapp\"); let answer = M.scaled(20); print answer;";
let linked = LINK.link_modules(main_source, modules, map{ entry_path: "app/main.sapp" });
expect(linked.ok, "relative transitive link failed: " + str(try linked.reason catch ""));
expect(linked.modules == 2, "reachable module count mismatch");
expect(linked.module_order[0] == "shared/base.sapp" and linked.module_order[1] == "lib/math.sapp",
    "dependency order is not deterministic/deps-first");
expect(not str_contains(linked.source, "import("), "linked source retained import");
expect(not str_contains(linked.source, "export "), "linked source retained export");
expect(str_contains(linked.source, "__pbi"), "module namespace prefix missing");
let run = FRONT.frontend_run(linked.source);
expect(run.ok and run.globals.answer == 42 and run.output[0] == 42,
    "linked source did not preserve behavior");

// Identical top-level names in independent modules are isolated by prefixes.
let collisions = map{
    "a.sapp": "fn value() { return 19; } export value;",
    "b.sapp": "fn value() { return 23; } export value;"
};
let collision_main = "let A = import(\"a.sapp\"); let B = import(\"b.sapp\"); print A.value() + B.value();";
let collision_link = LINK.link_modules(collision_main, collisions);
expect(collision_link.ok, "prefixed collision link rejected");
let collision_run = FRONT.frontend_run(collision_link.source);
expect(collision_run.ok and collision_run.output[0] == 42, "prefixed collision behavior mismatch");

let traversal = LINK.link_modules("let X = import(\"../../escape.sapp\");", map{}, map{ entry_path: "app/main.sapp" });
expect(not traversal.ok and str_contains(traversal.reason, "escaping"), "root traversal was accepted");
let absolute = LINK.link_modules("let X = import(\"/etc/passwd\");", map{});
expect(not absolute.ok, "absolute import was accepted");
let backslash = LINK.link_modules("let X = import(\"..\\escape.sapp\");", map{});
expect(not backslash.ok, "backslash import was accepted");
let control_path = LINK.link_modules("print 1;", map{ "bad\tpath.sapp": "print 2;" });
expect(not control_path.ok, "control byte in module path was accepted");

let cyclic = map{
    "a.sapp": "let B = import(\"b.sapp\"); fn a() { return B.b(); } export a;",
    "b.sapp": "let A = import(\"a.sapp\"); fn b() { return A.a(); } export b;"
};
let cycle = LINK.link_modules("let A = import(\"a.sapp\"); print A.a();", cyclic);
expect(not cycle.ok and str_contains(cycle.reason, "cycle"), "import cycle was accepted");

let duplicate = LINK.link_modules("print 1;", map{ "a/../x.sapp": "print 1;", "x.sapp": "print 2;" });
expect(not duplicate.ok and str_contains(duplicate.reason, "duplicate canonical"), "canonical duplicate was accepted");
let reserved = LINK.link_modules("let X = import(\"x.sapp\"); print X.value();",
    map{ "x.sapp": "fn __pbi0_hidden() { return 1; } fn value() { return __pbi0_hidden(); } export value;" });
expect(not reserved.ok and str_contains(reserved.reason, "reserved"), "reserved linker namespace was accepted");
let bare = LINK.link_modules("let X = import(\"x.sapp\"); print X;",
    map{ "x.sapp": "fn value() { return 1; } export value;" });
expect(not bare.ok and str_contains(bare.reason, "without .member"), "bare module binding was accepted");

let count_limited = LINK.link_modules(collision_main, collisions, map{ max_modules: 1 });
expect(not count_limited.ok and str_contains(count_limited.reason, "count"), "module count limit was ignored");
let source_limited = LINK.link_modules("let X = import(\"x.sapp\"); print X.value();",
    map{ "x.sapp": "fn value() { return 42; } export value;" }, map{ max_module_source_bytes: 8 });
expect(not source_limited.ok and str_contains(source_limited.reason, "source limit"), "module source limit was ignored");
let total_limited = LINK.link_modules(collision_main, collisions, map{ max_total_source_bytes: 100 });
expect(not total_limited.ok and str_contains(total_limited.reason, "total"), "total source limit was ignored");
let unused_limited = LINK.link_modules("print 1;", map{ "unused.sapp": "fn unused() { return 123456789; } export unused;" },
    map{ max_total_source_bytes: 32 });
expect(not unused_limited.ok and str_contains(unused_limited.reason, "supplied"),
    "unused supplied module bytes escaped the project budget");
let output_limited = LINK.link_modules(collision_main, collisions, map{ max_linked_source_bytes: 32 });
expect(not output_limited.ok and str_contains(output_limited.reason, "linked source"), "linked output limit was ignored");

let bad_limit = try LINK.link_modules("print 1;", map{}, map{ max_modules: 0 }) catch "caught";
expect(bad_limit == "caught", "invalid hard limit did not throw");

print "source_linker_bounded_pass";
