// Physical Windows lane: fixed call schema reuse, no filesystem/input effects.
let ABI=import("stdlib:windows_native_abi.sapp");
if platform()!="windows" {print "windows_abi_schema_skip_non_windows";}
else {
    let state=ABI.load_packaged(env_get("PBLANG_WINDOWS_ABI_BRIDGE"));assert(state.ok,"packaged ABI");
    assert(ABI.open_dirfs_api(state).ok,"fixed schema resolved");
    let modules=len(state.modules);
    for i 100 {
        assert(ABI.call_dirfs(state,"GetLastError",[]).ok,"fixed scalar query remains usable");
        assert(not ABI.call_dirfs(state,"GetLastError",[1]).ok,"argument count checked on every call");
        assert(not ABI.call_dirfs(state,"LoadLibraryA",[0]).ok,"unlisted symbol still refused");
        assert(len(state.modules)==modules and len(map_keys(state.allocations))==0,"no module or argument-buffer accumulation");
    }
    let view=ABI.capabilities();view.fixed_dirfs_symbol_count=999;
    assert(ABI.capabilities().fixed_dirfs_symbol_count==16,"public metadata cannot mutate schema");
    assert(ABI.close(state),"ABI closed");
    assert(not ABI.call_dirfs(state,"GetLastError",[]).ok,"schema reuse cannot reactivate closed state");
    print "windows_abi_schema_live_pass";
}
