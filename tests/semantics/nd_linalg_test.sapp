// tests/semantics/nd_linalg_test.sapp — G3-gamma: mat_inv and mat_solve tests
import "stdlib:nd.sapp";

// Test 2x2 matrix inverse
// [[2, 1], [5, 3]] -> inv = [[3, -1], [-5, 2]]
let A2 = [2, 1, 5, 3];
let inv2 = nd.mat_inv(A2);
let ok_inv2 = inv2 != nil
    and inv2[0] == 3 and inv2[1] == -1
    and inv2[2] == -5 and inv2[3] == 2;
assert(ok_inv2, "mat_inv_2x2");

// Test 2x2 solve: Ax = b where A = [[2,1],[5,3]], b = [4,7]
// Solution: x = [5, -6]
let b2 = [4, 7];
let x2 = nd.mat_solve(A2, b2);
let ok_solve2 = x2 != nil and x2[0] == 5 and x2[1] == -6;
assert(ok_solve2, "mat_solve_2x2");

// Test singular matrix returns nil
let Asing = [1, 2, 2, 4]; // det = 0
let inv_sing = nd.mat_inv(Asing);
assert(inv_sing == nil, "mat_inv_singular");

// Test 3x3 inverse of identity
let I3 = [1, 0, 0, 0, 1, 0, 0, 0, 1];
let inv_I3 = nd.mat_inv(I3);
let ok_I3 = inv_I3 != nil
    and inv_I3[0] == 1 and inv_I3[4] == 1 and inv_I3[8] == 1
    and inv_I3[1] == 0 and inv_I3[3] == 0;
assert(ok_I3, "mat_inv_3x3_identity");

// Test 3x3 solve: A=[[2,1,0],[1,3,1],[0,1,2]], b=[1,4,3]
// Solution: x = [0, 1, 1]
let A3 = [2, 1, 0, 1, 3, 1, 0, 1, 2];
let b3 = [1, 4, 3];
let x3 = nd.mat_solve(A3, b3);
let eps = 0.0001;
fn approx(a, b) { return (a - b) < eps and (b - a) < eps; }
let ok_solve3 = x3 != nil
    and approx(x3[0], 0)
    and approx(x3[1], 1)
    and approx(x3[2], 1);
assert(ok_solve3, "mat_solve_3x3 x=" + json_stringify(x3));

print "nd_linalg_inv_solve_pass";
