let off = import("stdlib:llm_offload.sapp");

let layers = [
    off.layer("embed", 100, 10, "cpu"),
    off.layer("block0", 180, 20, "gpu"),
    off.layer("block1", 180, 20, "gpu"),
    off.layer("block2", 180, 20, "gpu"),
    off.layer("head", 90, 10, "cpu")
];

let kv = off.kv_cache_bytes(8, 5, 2, 4, 2);
assert(kv == 1280, "KV cache estimate accounts for key and value tensors");
let qkv = off.kv_cache_bytes_quantized(8, 5, 2, 4, 4, 0);
assert(qkv == 320, "quantized KV cache estimate packs low-bit key/value tensors");
let kvc = off.kv_compression_plan(8, 5, 2, 4, 2, 4, 0);
assert(kvc.format == "pblang.llm.kv_compression_plan.v1" and kvc.compression_ratio == 4, "KV compression plan reports baseline-to-quantized ratio");

let cfg = off.config(1800, kv, 1, 1, 1);
let resident = off.choose_resident_layers(layers, cfg);
assert(len(resident.resident) == 2, "resident selection keeps first and last layers when they fit");
assert(resident.resident[0] == 0 and resident.resident[1] == 4, "resident indices are deterministic");

let p = off.plan(layers, cfg);
assert(p.format == "pblang.llm.offload.plan.v1", "offload plan is versioned");
assert(p.streamed_layers == 3, "non-resident layers stream layer by layer");
assert(p.fits_budget, "planner leaves headroom for one streamed layer");
assert(p.events[0].action == "use_resident", "resident layer is reused without load/release");
assert(p.events[1].action == "prefetch_hint", "planner emits prefetch hints for near-future streamed layers");
assert(p.events[2].action == "load_layer", "streamed layer starts with a load event");
assert(p.events[4].action == "release_layer", "streamed layer is released after compute");

let roomy = off.config(1900, kv, 2, 1, 1);
let p2 = off.plan(layers, roomy);
assert(p2.fits_budget, "slightly larger budget fits one streamed layer plus resident window");
let s = off.summarize(p2);
assert(s.resident_layers == 3 and s.streamed_layers == 2, "summary reports resident and streamed layer counts");

let mb = off.microbatch_capacity(roomy, 100, 1, 16);
assert(mb == 6, "microbatch capacity is capped by available non-KV memory");

let man = off.manifest(p2, "pbAI-Max-low-memory");
assert(man.format == "pblang.llm.offload.manifest.v1", "offload manifest is versioned");
assert(man.summary.fits_budget, "manifest embeds plan summary");

print "llm_offload_pass";
