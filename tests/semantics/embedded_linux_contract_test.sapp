let E = import("stdlib:embedded.sapp");
let L = import("stdlib:embedded_linux.sapp");

let doctor = L.doctor();
assert(doctor.format == L.FORMAT and doctor.platform == platform(), "doctor contract");
assert(type(doctor.devices) == "array", "doctor publishes bounded device inventory");

let artifact = E.build(E.blink("status-led-test", 5), "arduino-uno");
assert(artifact.ok, "test AVR artifact");
let path = "build/embedded-contract/firmware.hex";
let published = L.publish_artifact(artifact, path);
assert(published.ok and fs_exists(path), "atomic firmware publication");
assert(fs_read(path) == artifact.intel_hex, "published Intel HEX matches artifact");
fs_remove(path);

assert(not L.flash(artifact, map{confirm_device_write:true,confirm_board:"arduino-uno",port:"/dev/ttyUSB0"}).ok,
       "flashing defaults denied");
assert(not L.monitor("/dev/ttyUSB0").ok, "monitoring defaults denied");
assert(not L.inspect_port("/dev/ttyUSB9999").ok, "missing port rejected");

if fs_exists("/dev/ttyUSB0") {
    let uno_transport = L.inspect_port("/dev/ttyUSB0");
    assert(uno_transport.ok and uno_transport.serial_redacted and uno_transport.serial == ""
           and uno_transport.stable_path_redacted and uno_transport.stable_path == "",
           "USB0 inspection keeps serial and by-id path private by default");
    assert(L.resolve_mapping("arduino-uno", "/dev/ttyUSB0").ok,
           "explicit UNO transport mapping validated");
}
if fs_exists("/dev/ttyUSB1") {
    let esp_transport = L.inspect_port("/dev/ttyUSB1");
    assert(esp_transport.ok and esp_transport.vid == "10c4" and esp_transport.pid == "ea60",
           "current CP2102 transport inspected");
    assert(L.resolve_mapping("esp32-devkitc-v4", "/dev/ttyUSB1").ok,
           "explicit ESP32 transport mapping validated");
    assert(not L.resolve_mapping("arduino-uno", "/dev/ttyUSB1").ok,
           "wrong-board USB mapping rejected");
}

print "embedded_linux_contract_pass";
