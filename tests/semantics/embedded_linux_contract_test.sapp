let E = import("stdlib:embedded.sapp");
let L = import("stdlib:embedded_linux.sapp");

let doctor = L.doctor();
assert(doctor.format == L.FORMAT and doctor.platform == platform(), "doctor contract");
assert(type(doctor.devices) == "array", "doctor publishes bounded device inventory");

let artifact = E.build(E.blink("status-led-test", 5), "arduino-uno");
assert(artifact.ok, "test AVR artifact");
// Keep parallel and cached test workers from publishing/removing the same file.
let run_id = str_slice(sha256(str(now_ms()) + ":" + base64_encode_bytes(random_bytes(16))), 0, 20);
let path = "build/embedded-contract/firmware-" + run_id + ".hex";
let published = L.publish_artifact(artifact, path);
assert(published.ok and fs_exists(path), "atomic firmware publication");
assert(fs_read(path) == artifact.intel_hex, "published Intel HEX matches artifact");
fs_remove(path);

assert(not L.flash(artifact, map{confirm_device_write:true,confirm_board:"arduino-uno",port:"/dev/ttyUSB0"}).ok,
       "flashing defaults denied");
assert(not L.monitor("/dev/ttyUSB0").ok, "monitoring defaults denied");
assert(not L.inspect_port("/dev/ttyUSB9999").ok, "missing port rejected");

let ports = ["/dev/ttyUSB0", "/dev/ttyUSB1"];
for port_index len(ports) {
    let port = ports[port_index];
    if fs_exists(port) {
        let transport = L.inspect_port(port);
        assert(transport.ok and transport.serial_redacted and transport.serial == ""
               and transport.stable_path_redacted and transport.stable_path == "",
               "inspection keeps serial and by-id path private by default");
        if transport.vid == "10c4" and transport.pid == "ea60" {
            assert(L.resolve_mapping("esp32-devkitc-v4", port).ok,
                   "CP2102 ESP32 transport mapping validated independent of tty number");
            assert(not L.resolve_mapping("arduino-uno", port).ok,
                   "CP2102 transport cannot be mislabeled as UNO");
        } elif transport.vid == "1a86" and transport.pid == "7523" {
            assert(L.resolve_mapping("arduino-uno", port).ok,
                   "CH340 UNO-compatible transport mapping validated independent of tty number");
        }
    }
}

print "embedded_linux_contract_pass";
