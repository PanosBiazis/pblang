let W=import("stdlib:workflow.sapp");
let graph=W.new(); let calls=map{n:0};
W.register(graph,"id",fn(input,params){calls.n=calls.n+1;return input;});
for id in ["a","b","c","d","e"] { W.add_node(graph,id,"id",nil); }
W.connect(graph,"a","d"); W.connect(graph,"a","c"); W.connect(graph,"a","c"); W.connect(graph,"b","e");
assert(W.topo_order(graph)==["a","b","d","c","e"],"entry insertion order, edge insertion order and repeated edges preserved");
let out=W.run(graph,7); assert(out.c==[7,7] and out.d==7 and calls.n==5,"duplicate fan-in retained");
W.connect(graph,"c","a"); calls.n=0;
assert((try W.run(graph,0) catch "cycle")=="cycle" and calls.n==0,"cycle discovered before callbacks");
assert(W.topo_order(W.new())==[],"empty graph");
print "workflow_ordering_pass";
