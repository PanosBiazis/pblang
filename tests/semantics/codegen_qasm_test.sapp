// tests/semantics/codegen_qasm_test.sapp — the quantum backend: a gate IR -> OpenQASM 2.0,
// the "machine code" real quantum devices/simulators run. Honest scope: pblang GENERATES
// the quantum program; executing it is the QPU's/simulator's job (the repo's quantum_sim can
// run it). Same spirit as the classical backends: pblang emits, the device runs.

let Q = import("stdlib/codegen_qasm.sapp");

fn fail(m) { throw "FAIL " + m; }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : <<" + s + ">>"); } }

// a Bell pair: H on q0, CNOT q0->q1, then measure.
let bell = [["h", 0], ["cx", 0, 1], ["measure"]];
let src = Q.qasm(bell, 2);
has(src, "OPENQASM 2.0;", "QASM header");
has(src, "include \"qelib1.inc\";", "QASM stdgates include");
has(src, "qreg q[2];", "2-qubit register");
has(src, "creg c[2];", "2-bit classical register");
has(src, "h q[0];", "hadamard gate");
has(src, "cx q[0],q[1];", "cnot gate");
has(src, "measure q -> c;", "measurement");

// single-qubit gates
has(Q.qasm([["x", 0]], 1), "x q[0];", "x gate");
has(Q.qasm([["z", 0]], 1), "z q[0];", "z gate");

// gate_count helper
fn cnt(g) { return Q.gate_count(g); }
if cnt(bell) != 3 { fail("gate_count"); }

// safety: a qubit index outside the register is rejected
let bad = try Q.qasm([["h", 5]], 2) catch nil;
if bad != nil { fail("qasm must reject out-of-range qubit"); }

print "codegen_qasm_pass";
