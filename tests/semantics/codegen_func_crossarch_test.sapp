// tests/semantics/codegen_func_crossarch_test.sapp — functions (call/ret + recursion) on every
// backend. x86-64 and i386 run the recursive factorial; arm64 is encoding-verified (bl/ret).

let X64 = import("stdlib/codegen_x64.sapp");
let X86 = import("stdlib/codegen_x86.sapp");
let A64 = import("stdlib/codegen_arm64.sapp");

fn fail(m) { throw "FAIL " + m; }
fn run_rc(elf, tag) {
    let path = "pbfca_" + tag + ".bin";
    fs_write_bytes(path, elf);
    let r = proc_spawn_wait("bash", ["-c", "chmod +x " + path + " && ./" + path + "; rc=$?; rm -f " + path + "; echo RC=$rc"]);
    let out = try r.stdout catch "";
    let idx = str_index_of(out, "RC=");
    return parse_number(str_trim(str_slice(out, idx + 3, len(out))));
}

let fact = [map{ name: "fact", body: [
    ["ifnz", 0, [
        ["seti", 2, 1], ["seti", 1, 0], ["add", 1, 0], ["sub", 0, 2], ["call", "fact"], ["mul", 0, 1]
    ], [
        ["seti", 0, 1]
    ]]
] }];
let main = [["seti", 0, 5], ["call", "fact"]];   // 120

// ── x86-64: recursion runs ──────────────────────────────────────────────────────────
let g64 = run_rc(X64.compile_unit(fact, main), "x64");
if g64 != 120 { fail("x86-64 factorial got " + str(g64)); }

// ── i386: recursion runs ────────────────────────────────────────────────────────────
let g86 = run_rc(X86.compile_unit(fact, main), "x86");
if g86 != 120 { fail("i386 factorial got " + str(g86)); }

// A call relocation nested after a near conditional branch must retain the
// correct dynamic body offset (short/near selection changes prefix lengths).
let filler = [];
let fi = 0; while fi < 50 { push(filler, ["addi", 2, 0]); fi = fi + 1; }
push(filler, ["call", "seven"]);
let branch_funcs = [
    map{ name: "seven", body: [["seti", 0, 7]] },
    map{ name: "branch_call", body: [["ifnz", 1, filler, [["seti", 0, 3]]]] }
];
let branch_main = [["seti", 1, 1], ["call", "branch_call"]];
let nested86 = run_rc(X86.compile_unit(branch_funcs, branch_main), "x86nested");
if nested86 != 7 { fail("i386 nested near-branch call relocation got " + str(nested86)); }

// ── arm64: encoding-verified (valid ELF, 4-byte aligned, contains bl + ret) ──────────
let elf = A64.compile_unit(fact, main);
if elf[0] != 0x7F or elf[18] != 0xB7 { fail("arm64 unit not a valid AArch64 ELF"); }
// scan the code region for a `ret` (D6 5F 03 C0 -> LE C0 03 5F D6) and a bl (opcode bits 100101)
let has_ret = false; let has_bl = false;
let i = 120;
while i + 4 <= len(elf) {
    if elf[i] == 0xC0 and elf[i + 1] == 0x03 and elf[i + 2] == 0x5F and elf[i + 3] == 0xD6 { has_ret = true; }
    if num_floor(elf[i + 3] / 4) == 37 { has_bl = true; }   // top 6 bits 100101 -> 0x94..0x97 -> /4 == 37
    i = i + 4;
}
if not has_ret { fail("arm64 unit missing ret"); }
if not has_bl { fail("arm64 unit missing bl"); }

print "codegen_func_crossarch_pass";
