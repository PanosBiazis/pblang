let F=import("stdlib:compiler/selfhost_frontend.sapp");
let V=import("stdlib:compiler/vm.sapp");
let PB=import("stdlib:selfhost_pbck.sapp");
fn expect(ok,label) {if not ok {throw "FAIL match-member: "+label;}}
fn check(source,expected) {
    let parsed=F.frontend_parse_safe(source);
    expect(parsed.ok,"checked parse");
    let compiled=F.frontend_compile(source);
    expect(compiled.ok and len(compiled.diagnostics)==0,"checked compilation");
    let limits=map{max_steps:4000,max_frames:16};
    let plain=V.run_bounded(compiled.chunk,limits);
    let optimized=F.frontend_run_bounded(source,limits);
    let restored=V.run_bounded(PB.deserialize_chunk(PB.serialize_chunk(compiled.chunk)),limits);
    expect(plain.globals.result==expected,"plain value");
    expect(optimized.ok and optimized.globals.result==expected,"optimized value");
    expect(restored.globals.result==expected,"serialized value");
}
check("let match=map{admitted:true,mount_id:7};let result=map{ok:true,admitted:match.admitted,mount_id:match.mount_id};",
    map{ok:true,admitted:true,mount_id:7});
check("let match=map{value:2};match.value=5;let result=match.value;",5);
check("let match=map{nested:map{value:9}};let result=match.nested.value;",9);
check("let match=map{value:3};let result=match?.value;",3);
check("let match=nil;let result=match?.value;",nil);
check("let match=[4,5];let result=match?[1];",5);
check("let match=nil;let result=match?[0];",nil);
check("let match=map{fn:8};let result=match.fn;",8);
check("let match=map{value:6};let result=match /* gap */ .value;",6);
check("let match=map{value:6};let result=match // gap\n .value;",6);
check("fn read(match) {return match.value;}let result=read(map{value:11});",11);
check("fn match(x) {return x+1;}let result=match(4);",5);
check("let match=map{value:2};let result=match match.value {case 2:7;else:9;};",7);
check("let value=map{value:2};let result=match value.value {case 2:7;else:9;};",7);
check("let result=match 2 {case 2:7;else:9;};",7);
// Existing ambiguity is recorded, not silently broadened by the postfix fix.
expect(not F.frontend_parse_safe("let result=match (2) {case 2:7;else:9;};").ok,
    "parenthesized scrutinee remains unsupported");
for source in ["let result=match.;","let result=match?.;",
    "let result=match?[;","let result=match 2 {case 2 7;};",
    "let result=match 2 {case 2:7;",
    "let match=map{value:1};let result=match /* unterminated"] {
    let parsed=F.frontend_parse_safe(source);
    expect(not parsed.ok and len(parsed.errors)>0,"malformed source rejects");
    expect(not F.frontend_compile(source).ok,"malformed source cannot compile");
}
let missing=F.frontend_compile("let result=match.value;");
expect(not missing.ok,"missing binding remains an error");
// Trusted repository source: parse only, never import or run device operations.
// Post-read assertion is a fixture cap, not a pre-allocation filesystem bound.
let source=fs_read("stdlib/linux_dirfs.sapp");
expect(len(str_to_bytes(source))<262144,"repository fixture size");
expect(F.frontend_parse_safe(source).ok,"whole linux_dirfs parses");
print "selfhost_match_member_pass";
