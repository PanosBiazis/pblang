if platform() != "linux" { print "native_bundle_cli_skip_linux_required"; os_exit(0); }
let UUID=import("stdlib:uuid.sapp");
let compiler=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
// Relative paths deliberately qualify the documented working-directory resolver.
let base="bundle_cli_"+UUID.v4();
let source=base+".sapp"; let module=base+"_module.sapp"; let leaf=base+"_leaf.sapp"; let output=base+".pbck";
fn child(flags) {
    let args=["-k","1s","20s",compiler,"run","tools/pbc.sapp","--allow-all","--",source,"--out",output];
    for flag in flags {array_push(args,flag);}
    return proc_spawn_wait("/usr/bin/timeout",args);
}
fn run_artifact() {return proc_spawn_wait("/usr/bin/timeout",["-k","1s","5s",compiler,"run",output,"--sandbox"]);}
fn exercise() {
    fs_write(output,"previous artifact");
    for flags in [["--bundle"],["--target","wasm","--bundle"],["--target","pbck","--bundle","--bundle"],
        ["--target","pbck","--bundle","--entry","work","--cleanup","release"],
        ["--target","pbck","--bundle","--safe"],["--target","pbck","--bundle","--local-source"]] {
        assert(child(flags).exit_code==2,"incompatible flags rejected before reading absent entry");
        assert(fs_read(output)=="previous artifact","option failure preserves output");
    }
    let flags=["--target","pbck","--bundle"];
    assert(child(flags).exit_code!=0,"missing entry rejected");
    assert(fs_read(output)=="previous artifact","missing entry preserves output");
    for invalid in ["let n:number=nil-1;", "let p=\"private_canary\";let m=import(p);", "let m=import(\"private_canary\");"] {
        fs_write(source,invalid);let result=child(flags);
        assert(result.exit_code!=0 and fs_read(output)=="previous artifact","invalid graph preserves output");
        assert(not str_contains(result.stdout+result.stderr,"private_canary"),"no source/path disclosure");
    }
    fs_write(leaf,"fn leaf_value(){return 7;}export leaf_value;");
    fs_write(module,"let leaf_api=import(\""+leaf+"\");fn nested(){for i 1 {let p=map{run:fn(self){return leaf_api.leaf_value();}};return (try {p:run()} catch 9);}return 0;}export nested;");
    fs_write(source,"let api=import /* comment */ (\""+module+"\");print api.nested();");
    assert(child(flags).exit_code==0,"transitive static compilation");
    for path in [source,module,leaf] {fs_remove(path);}
    let result=run_artifact();
    assert(result.exit_code==0 and result.stdout=="7\n","artifact runs after deleting all source dependencies");
    fs_write(module,"fn denied(){return fs_read(\"private_canary\");}export denied;");
    fs_write(source,"let api=import(\""+module+"\");api.denied();");
    assert(child(flags).exit_code==0,"capability call compiles");
    result=run_artifact();
    assert(result.exit_code!=0 and str_contains(result.stderr,"fs access denied"),"linking does not grant filesystem access");
}
let passed=try {exercise();true} catch false;
for path in [source,module,leaf,output] {try fs_remove(path) catch nil;}
assert(passed,"native bundle CLI regression");
print "native_bundle_cli_pass";
