let W = import("stdlib:codegen_wasm.sapp");
let UUID = import("stdlib:uuid.sapp");
let OS = import("stdlib:os.sapp");
fn rejects(work) { return try { work(); false } catch true; }
let path = path_join(OS.temp_dir(), "pblang_wasm_local_" + UUID.v4() + ".wasm");
let runner = "const fs=require('fs');WebAssembly.instantiate(fs.readFileSync(process.argv[1]),{env:{print:()=>{},print_str:()=>{}}}).then(r=>console.log(String(r.instance.exports.main())+':'+(r.instance.exports.memory?r.instance.exports.memory.buffer.byteLength/65536:0))).catch(()=>process.exit(1));";
fn execute(bytes, expected) {
    fs_write_bytes(path, bytes);
    let run = proc_spawn_wait("node", ["-e", runner, path]);
    assert(run.exit_code == 0 and str_trim(run.stdout) == expected, "real WASM output and initial pages");
}
fn exercise() {
    let big = str_repeat(" ", 1048576) + str_repeat("0;", 33000) + "return 42;";
    assert(rejects(fn(){ W.compile_wasm(big); }), "strict byte ceiling unchanged");
    assert(rejects(fn(){ W.compile_wasm(str_repeat("0;",33000)+"return 42;"); }), "strict token ceiling unchanged");
    execute(W.compile_wasm_local(big), "42:0");
    for budget in [map{max_source_bytes:1048576},map{max_tokens:65536}] {
        assert(rejects(fn(){ W.compile_wasm_local(big,budget); }), "explicit exhausted local budget");
    }
    for suffix in ["/* private_canary", "let x=\"private_canary", "fn broken(){", "let x=0x;"] {
        assert(rejects(fn(){ W.compile_wasm_local(big+suffix); }), "large invalid suffix rejects");
    }
    let budget = map{max_source_bytes:17,max_tokens:5};
    execute(W.compile_wasm_local("//😀\nreturn 42;",budget),"42:0");
    assert(budget.max_source_bytes==17 and budget.max_tokens==5 and len(map_keys(budget))==2,"caller budget unchanged");
    assert(rejects(fn(){ W.compile_wasm_local("//😀\nreturn 42;",map{max_source_bytes:16}); }),"UTF-8 bytes");
    assert(rejects(fn(){ W.compile_wasm_local("return 42;",map{max_tokens:3}); }),"EOF included");
    for bad in [map{max_tokens:0},map{max_tokens:parse_number("NaN")},map{typo:4},7] {
        assert(rejects(fn(){ W.compile_wasm_local("return 42;",bad); }),"invalid local budget");
    }
    assert(rejects(fn(){ W.compile_wasm_local("return []; "); }),"unsupported emitter construct rejects");
    execute(W.compile_wasm("return 42;"),"42:0");
    // Static data fits exactly 16 pages, then crosses by one byte. The second
    // source reaches the strict byte cap, but its data needs another page.
    let exact = "return len(\"" + str_repeat("x",1048560) + "\");";
    execute(W.compile_wasm_local(exact),"1048560:16");
    let over = "return len(\"" + str_repeat("x",1048561) + "\");";
    execute(W.compile_wasm_local(over),"1048561:17");
    execute(W.compile_wasm("return len(\"ok\");"),"2:16");
}
let passed = try { exercise(); true } catch false;
try fs_remove(path) catch nil;
assert(passed,"local WASM regression");
print "wasm_local_pass";
