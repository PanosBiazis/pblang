// Bounded, deterministic diagnostics shared by the self-hosted compiler tools.
let T = import("stdlib/compiler/tokenizer.sapp");
let P = import("stdlib/compiler/parser.sapp");
let C = import("stdlib/compiler/typeck.sapp");
let D = import("stdlib/compiler/diagnostic_suggestions.sapp");
let FE = import("stdlib/compiler/selfhost_frontend.sapp");

fn fail(message) { throw "selfhost diagnostic suggestions: " + message; }
fn check(source, options = nil) {
    let ast = P.parse(T.tokenize(source));
    if len(ast.errors) != 0 { fail("fixture did not parse"); }
    return C.type_check(ast.stmts, options);
}
fn code(diags, wanted) {
    let i = 0;
    while i < len(diags) {
        if diags[i].code == wanted { return diags[i]; }
        i = i + 1;
    }
    return nil;
}

let unknown = code(check("let value = 1; let total = valeu + 1;"), "undefined-name");
if unknown == nil or unknown.suggestion != "value"
   or not str_contains(unknown.help, "did you mean") { fail("identifier suggestion missing"); }

let builtin = code(check("let value = str_trm(\" x \" );"), "undefined-name");
if builtin == nil or builtin.suggestion != "str_trim" { fail("builtin suggestion missing"); }

let field = code(check("struct Point { x: number, label: string } "
    + "let point = Point(1, \"p\"); let text = point.lable;"), "unknown-field");
if field == nil or field.suggestion != "label" { fail("struct field suggestion missing"); }

let variant = code(check("enum Shape { Empty, Circle(number) } let shape = Shape.Circl(1);"), "unknown-variant");
if variant == nil or variant.suggestion != "Circle" { fail("enum variant suggestion missing"); }

if len(check("fn first(x) { return second(x); } fn second(x) { return str_trim(str(x)); }")) != 0 {
    fail("valid forward function or builtin was rejected");
}
let disabled = code(check("let x = valeu;", map{ suggestions: false }), "undefined-name");
if disabled == nil or map_has(disabled, "suggestion") { fail("suggestion option was ignored"); }
if len(check("let value = external_value + 1;", map{ extern_names: ["external_value"] })) != 0 {
    fail("declared external symbol was rejected");
}
if code(check("let value = external_value + 1;"), "undefined-name") == nil {
    fail("undeclared external symbol was accepted");
}
if len(check("let value = try optional_provider() catch nil;")) != 0 {
    fail("catchable runtime name probe was rejected");
}
if code(check("let value = optional_provider();"), "undefined-name") == nil {
    fail("uncaught runtime name probe was accepted");
}
if len(check("class Counter { fn init(self, value) { self.value = value; } "
    + "fn next(self) { return Counter:new(self.value + 1); } } "
    + "let counter = Counter:new(1);")) != 0 {
    fail("recursive class-table name was not hoisted");
}
if code(check("let value = 1;", map{ extern_names: map{ bad: true } }), "invalid-option") == nil {
    fail("invalid external symbol option was accepted");
}

let tie_a = D.suggest_name("dat", ["cat", "bat"]);
let tie_b = D.suggest_name("dat", ["bat", "cat"]);
if tie_a != "bat" or tie_b != "bat" { fail("tie-break is not deterministic"); }
let duplicate = D.suggest("valeu", ["value", "value"]);
if duplicate.value != "value" or duplicate.considered != 1 { fail("candidates were not de-duplicated"); }
let capped = D.suggest("value", ["other", "valu"], map{ max_candidates: 1 });
if capped.value != nil or capped.considered != 1 or not capped.truncated { fail("candidate cap was not enforced"); }
if D.suggest_name(str_repeat("a", D.MAX_NAME_LENGTH + 1), ["a"]) != nil {
    fail("oversized diagnostic name was accepted");
}

let lint = FE.frontend_lint("fn total(value) { return valeu + 1; }");
let lint_diag = nil; let i = 0;
while i < len(lint.diagnostics) {
    if (try lint.diagnostics[i].code catch "") == "undefined-name" { lint_diag = lint.diagnostics[i]; }
    i = i + 1;
}
if lint_diag == nil or lint_diag.suggestion != "value" or lint_diag.fix.to != "value" {
    fail("frontend lint did not use shared local-name suggestions");
}

print "selfhost_diagnostic_suggestions_pass";
