// tests/semantics/llm_attention_enrich_test.sapp — enrichment for stdlib/llm_attention.sapp
// Adds causal_mask (additive attention mask) and frequency_penalty_logits.

let at = import("stdlib/llm_attention.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── ENRICH: causal_mask (lower triangular = 0 allowed, upper = -inf) ─────────────
let m = at.causal_mask(3);
near(m[0][0], 0, "mask[0][0] allowed");
if m[0][1] > 0 - 1000000 { fail("mask[0][1] (future) should be masked"); }
near(m[1][0], 0, "mask[1][0] allowed"); near(m[1][1], 0, "mask[1][1] allowed");
if m[1][2] > 0 - 1000000 { fail("mask[1][2] (future) should be masked"); }
near(m[2][2], 0, "mask[2][2] allowed");

// ── ENRICH: frequency_penalty_logits ─────────────────────────────────────────────
let fp = at.frequency_penalty_logits([1, 1, 1], [0, 0, 1], 0.5);
near(fp[0], 0, "token 0 appears 2x -> 1 - 1.0");
near(fp[1], 0.5, "token 1 appears 1x -> 1 - 0.5");
near(fp[2], 1, "token 2 appears 0x -> unchanged");

print "llm_attention_enrich_pass";
