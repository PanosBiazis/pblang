let A=import("stdlib:android_emulator.sapp");
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let P=import("stdlib:selfhost_pbck.sapp");
let package_name="org.example.cleanup";
fn ready() {
 let em=A.new(34,"arm64");
 assert(A.install(em,map{package:package_name,activities:[map{name:".Main",exported:false}],main_activity:".Main"}).ok,"install");
 assert(A.start_activity(em,"system",package_name).ok,"start");return em;
}
fn payload(source) {
 let c=F.frontend_compile(source);assert(c.ok,"compile fixture");return P.serialize_chunk(c.chunk);
}
fn failed(result) {
 assert(not result.ok and result.error=="PBCS execution failed or exceeded its runtime budget","stable failure");
 assert(len(map_keys(result))==2,"no output, globals, context or exception disclosure");
}
let em=ready();let events=len(em.events);
let owners="let h=memory_alloc(1);borrow_immutable(h);push_lifetime();let x=memory_alloc(2);borrow_mutable(x);";
let bytes=payload(owners+"print \"private partial output\";throw \"private error\";");
failed(A.run_pbcs(em,package_name,bytes));assert(len(em.events)==events,"failure emits no success event");
let fresh=payload("print memory_stats().total_locations;print memory_stats().active_borrows;");
assert(A.run_pbcs(em,package_name,fresh).output==[0,0],"next execution starts clean");
failed(A.run_pbcs(em,package_name,payload(owners+"while true {}"),nil,map{max_steps:100}));
failed(A.run_pbcs(em,package_name,bytes,nil,map{max_steps:0}));
let success=A.compile_and_run(em,package_name,owners+"print 42;nil;");
assert(success.ok and success.compiled and success.output==[42] and success.value==nil,"compile success preserved");
assert(success.runtime.steps>0 and success.artifact_bytes==len(success.artifact),"execution metadata preserved");
assert(not map_has(success.globals,"execution") and not map_has(success.globals,"memory"),"private context not exposed");
let compile_failure=A.compile_and_run(em,package_name,owners+"throw \"stop\";");
assert(not compile_failure.ok and compile_failure.compiled and is_array(compile_failure.artifact),"compile failure contract");
// Compile emits bytecode despite the deliberately undefined seeded name.
let seeded_chunk=F.frontend_compile("marker.count=marker.count+1;throw \"stop\";").chunk;
let globals=map{marker:map{count:0},android_api:0};
failed(A.run_pbcs(em,package_name,P.serialize_chunk(seeded_chunk),globals));
assert(globals.marker.count==1 and globals.android_api==0,"one attempt, nested mutation retained, top-level seed copied");
let full=ready();full.limits.max_events=len(full.events);
let queue=A.run_pbcs(full,package_name,payload(owners+"print 42;"));
assert(not queue.ok and queue.error=="event queue limit exceeded","event failure preserved");
assert(len(full.events)==full.limits.max_events,"no extra event");
full.limits.max_events=full.limits.max_events+1;
assert(A.run_pbcs(full,package_name,fresh).output==[0,0],"fresh execution after event failure");
assert(not A.run_pbcs(em,package_name,[1,2,3,4,5,6,7,8,9]).ok,"malformed artifact rejected");
print "android_emulator_cleanup_pass";
