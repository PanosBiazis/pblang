// Simulated close outcomes, never real OS-descriptor invalidation or retries.
let U=import("stdlib:uuid.sapp");let parent=path_dirname(cwd());
let exe=env_get("PBLANG_BIN");assert(type(exe)=="string" and exe!="","trusted runtime required");
let base=env_get("PBAI_STATE_ROOT");assert(type(base)=="string" and base!="","private state required");
let root=path_join(base,"close-fixture-"+U.v4());let step=["setup"];
fn run(args) {let argv=["-k","1s","30s","/usr/bin/env","-C",root,exe];for arg in args {push(argv,arg);}return proc_spawn_wait("/usr/bin/timeout",argv);}
fn exercise() {
 fs_mkdirs(path_join(root,"stdlib"));
 let owner=fs_read(path_join(parent,"pblang/stdlib/llm_tiered_store.sapp"));fs_write(path_join(root,"stdlib/llm_tiered_store.sapp"),owner);
 assert(fs_read(path_join(root,"stdlib/llm_tiered_store.sapp"))==owner,"exact current owner copied");
 fs_write(path_join(root,"stdlib/linux_dirfs.sapp"),fs_read("tests/fixtures/pbai_close_dirfs.sapp"));
 fs_write(path_join(root,"streaming.sapp"),fs_read(path_join(parent,"pbai/stdlib/pbai_streaming.sapp")));
 fs_write(path_join(root,"main.sapp"),fs_read("tests/fixtures/pbai_close_case.sapp"));
 fs_write(path_join(root,"pblang.toml"),"[package]\nname=\"close-fixture\"\nversion=\"0.1.0\"\nentry=\"main.sapp\"\n[dependencies]\nstdlib={path=\"stdlib\"}\n");
 step[0]="build";let built=run(["build"]);if built.exit_code!=0 {print built.stdout;print built.stderr;}assert(built.exit_code==0,"fixture builds");
 step[0]="fault cases";let result=run(["run","main.sapp","--deny-net","--deny-http","--deny-ffi","--deny-exec","--deny-spawn"]);
 if result.exit_code!=0 {print result.stdout;print result.stderr;}
 assert(result.exit_code==0 and result.stdout=="pbai_close_fault_cases_pass:14\n","all fourteen exact-source cases return their explicit success marker");
}
let passed=try {exercise();true} catch false;
let removed=proc_spawn_wait("/bin/rm",["-rf","--",root]);
assert(passed,"close fault fixture: "+step[0]);assert(removed.exit_code==0,"owned fixture cleaned");
print "pbai_close_faults_pass:14";
