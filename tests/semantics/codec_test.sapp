// tests/semantics/codec_test.sapp — pluggable codec round-trip + honest benchmark.
let C = import("stdlib:codec.sapp");

fn fail(m) { throw "FAIL " + m; }

let av = C.available();
if av.pbz != true { fail("pbz must always be available"); }

// realistic corpus: a real source file (falls back to generated text if unreadable)
let corpus = try fs_read("stdlib/math.sapp") catch "";
if len(corpus) < 200 {
    corpus = "";
    let r = 0;
    while r < 200 { corpus = corpus + "the quick brown fox jumps over the lazy dog 1234567890\n"; r = r + 1; }
}
let cbytes = str_to_bytes(corpus);
let orig = len(cbytes);

fn rt(backend, expect_name) {
    let blob = C.compress(corpus, backend);
    let name = C.backend_name(blob);
    if name != expect_name { fail(backend + " produced backend " + name); }
    let back = C.decompress(blob);
    if back == nil or len(back) != orig { fail(backend + " round-trip length"); }
    let i = 0;
    while i < orig { if back[i] != cbytes[i] { fail(backend + " mismatch at " + str(i)); } i = i + 1; }
    return len(blob);
}

// Round-trip every present backend; build the benchmark table as we go.
print "== codec benchmark on stdlib/math.sapp (" + str(orig) + " bytes) ==";
let backends = ["pbz"];
if av.gzip { array_push(backends, "gzip"); }
if av.zstd { array_push(backends, "zstd"); }
if av.xz { array_push(backends, "xz"); }

let bi = 0;
while bi < len(backends) {
    let bk = backends[bi];
    let t0 = now_ms();
    let csize = rt(bk, bk);
    let dt = now_ms() - t0;
    let ratio = 0;
    if csize > 0 { ratio = orig / csize; }
    print "  " + bk + ": " + str(csize) + " bytes  ratio " + str(ratio) + "x  (round-trip " + str(dt) + " ms)";
    bi = bi + 1;
}

// unknown/absent backend falls back to pbz (still decodable)
let fb = C.compress(corpus, "doesnotexist");
if C.backend_name(fb) != "pbz" { fail("unknown backend should fall back to pbz"); }
if len(C.decompress(fb)) != orig { fail("fallback round-trip"); }

// binary round-trip (default pbz)
let bin = [];
let b = 0;
while b < 256 { array_push(bin, b); b = b + 1; }
let bb = C.decompress(C.compress(bin, "pbz"));
if len(bb) != 256 or bb[255] != 255 { fail("binary round-trip"); }

print "codec_pass";
