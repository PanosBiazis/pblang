let GP = import("stdlib:compiler/guard_preprocessor.sapp");
let F = import("stdlib:compiler/selfhost_frontend.sapp");
let VM = import("stdlib:compiler/vm.sapp");
fn expect(value, message) { if not value { throw "FAIL guard_preprocessor_results: " + message; } }
fn run(source) {
    let compiled = F.frontend_compile_with_guard_prep(source);
    expect(compiled.ok and len(compiled.diagnostics) == 0, "valid legacy source compiles without diagnostics");
    return VM.run_bounded(compiled.chunk, map{ max_steps: 4000, max_frames: 12 }).globals;
}
expect(run("let result = match 2 { case n if n > 0 ~ 42; else: 0; };").result == 42, "numeric result");
expect(run("let result = match 2 { case n if n > 0 ~ \"ok\"; else: \"bad\"; };").result == "ok", "string result");
expect(run("let result = match 2 { case n if n > 0 ~ n + 1; else: 0; };").result == 3, "bound identifier in body");
expect(run("let result = match 2 { case n if n > 0 ~ true; else: false; };").result == true, "boolean result");
expect(run("let result = match 0 { case n if n > 0 ~ 7; };").result == nil, "missing default returns nil");
expect(run("let result = match 0 { case n if n > 0 ~ 7; else: \"fallback\"; };").result == "fallback", "fallback may have different type");
expect(run("let result = match 1 { case n if n > 0 ~ [n, n + 1]; else: []; };").result == [1, 2], "array result");
let outer = run("let n = 99; let result = match 2 { case n if n > 0 ~ n; else: n; }; let after = n;");
expect(outer.result == 2 and outer.after == 99, "arm binding does not leak");
expect(run("let n = 99; let result = match 0 { case n if n > 0 ~ n; else: n; };").result == 99, "default sees outer name");
let order = run("let seen = []; fn mark(x) { array_push(seen, x); return x; } let result = match mark(2) { case n if mark(0) > 0 ~ mark(8); case m if mark(1) > 0 # mark(m + 3); case z if mark(9) > 0 ~ mark(7); else: mark(6); };");
expect(order.result == 5 and order.seen == [2, 0, 1, 5], "subject once, guards in order, only selected body");
let member = run("let item = map{ n: 2 }; let result = match 2 { case n if item.n == n ~ item.n; else: 0; };");
expect(member.result == 2, "binding must not replace member names");
let named = run("let _guard_tmp = 8; let _guard_val = 9; let result = match _guard_tmp { case n if n == 8 ~ _guard_val; else: 0; };");
expect(named.result == 9, "generated locals do not capture former helper names");
let collision = "let __pb_guard_subject_0 = 8; let __pb_guard_subject_1 = 9; let result = match __pb_guard_subject_0 { case __pb_guard_subject_1 if __pb_guard_subject_1 == 8 ~ __pb_guard_subject_1 + 1; else: __pb_guard_subject_1; }; let after = __pb_guard_subject_1;";
let captured = run(collision);
expect(captured.result == 9 and captured.after == 9, "fresh name skips subject and binder identifiers");
expect(str_contains(GP.preprocess(collision), "let __pb_guard_subject_2 = __pb_guard_subject_0;"), "bounded candidate collision search");
expect(run("let __pb_guard_subject_0 = 99; let result = match 0 { case n if n > 0 ~ n; else: __pb_guard_subject_0; };").result == 99, "default identifier protected from capture");
expect(run("let result = match 2 { case n if n < 0 ~ n; case n if n > 0 # n + 1; else: 0; };").result == 3, "repeated arm names use isolated scopes");
let siblings = "let a = match 2 { case n if n > 0 ~ n; else: 0; }; let result = match 3 { case n if n > a # n + a; else: 0; };";
expect(run(siblings).result == 5, "independent matches retain separate subjects");
expect(GP.preprocess(siblings) == GP.preprocess(siblings), "deterministic rewrite");
expect(GP.preprocess(GP.preprocess(siblings)) == GP.preprocess(siblings), "rewrite is idempotent");
let optimized = F.frontend_run_bounded(GP.preprocess(siblings), map{ max_steps: 4000, max_frames: 12 });
expect(optimized.ok and optimized.globals.result == 5, "optimized frontend preserves direct returns and scope");
expect(run("fn fail() { throw 7; } let result = match 1 { case n if n > 0 ~ n; case n if fail() # fail(); else: fail(); };").result == 1, "unselected guards and bodies do not throw");
expect(run("fn fail() { throw 7; } let result = try (match 1 { case n if n > 0 ~ fail(); else: 0; }) catch 9;").result == 9, "selected body exception reaches caller");
let failure = F.frontend_compile_with_guard_prep("let result = match 2 { case n if true ~ missing_name; else: 0; };");
expect(not failure.ok and len(failure.diagnostics) > 0, "real name errors remain diagnosed");
print "guard_preprocessor_results_pass";
