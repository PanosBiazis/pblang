// Trusted local probe executable; rejected source must not even discover it.
if platform() != "linux" { print "c99_admission_effects_skip_linux_required"; os_exit(0); }
let C = import("stdlib:compiler/ctranspile.sapp");
let OS = import("stdlib:os.sapp");
let UUID = import("stdlib:uuid.sapp");
let base = path_join(OS.temp_dir(), "pblang_admission_" + UUID.v4());
let cc = base + ".sh";
let output = base + ".out"; let cpath = output + ".c";
fn cleanup() { for path in [cc, cc + ".marker", output, cpath] { try fs_remove(path) catch nil; } }
fn exercise() {
    // A fixed shell body uses its own generated path, never interpolated source.
    fs_write(cc, "#!/bin/sh\nprintf probe > \"$0.marker\"\nexit 0\n");
    let permission = proc_spawn_wait("chmod", ["700", cc]);
    assert(permission.exit_code==0, "probe permission");
    assert(C.find_c_compiler(cc)==cc and fs_exists(cc + ".marker"), "positive compiler-discovery control");
    fs_remove(cc + ".marker");
    fs_write(output, "old executable"); fs_write(cpath, "old C source");
    for source in ["print 7; /* unfinished", "let s=\"unfinished", "fn f(){return 7;", "let x=0x;"] {
        let rejected = C.build_program(source, output, map{compiler:cc});
        assert(not rejected.ok and not fs_exists(cc + ".marker"), "invalid source causes no compiler probe");
        assert(fs_read(output)=="old executable" and fs_read(cpath)=="old C source", "old outputs preserved");
    }
    let bad_project = C.build_program("let m=import(\"m.sapp\");", output,
        map{compiler:cc, modules:map{"m.sapp":"/* unfinished"}});
    assert(not bad_project.ok and not fs_exists(cc + ".marker"), "invalid module causes no compiler probe");
    for timeout in [nil, true, "100", 0, -1, 300001, parse_number("NaN"), parse_number("inf")] {
        let result = C.run_program("print 7;", map{compiler:cc, timeout_ms:timeout});
        assert(not result.ok and result.error=="timeout_ms must be between 1 and 300000", "invalid timeout rejected");
        assert(not fs_exists(cc + ".marker"), "invalid timeout cannot start compilation");
    }
    fs_remove(output); fs_remove(cpath);
    assert(not C.build_program("/* unfinished", output, map{compiler:cc}).ok, "absent output rejection");
    assert(not fs_exists(output) and not fs_exists(cpath), "no new artifact");
}
let passed = try { exercise(); true } catch false;
cleanup();
assert(passed, "C99 effect ordering regression");
print "c99_admission_effects_pass";
