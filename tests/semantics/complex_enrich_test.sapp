// tests/semantics/complex_enrich_test.sapp — enrichment for stdlib/complex.sapp
// Adds complex log/pow, polar conversion, and complex trig (sin/cos/tan).

let cx = import("stdlib/complex.sapp");

fn fail(m) { throw "FAIL " + m; }
fn approx(z, re, im, m) {
    if not cx.equals_approx(z, cx.new(re, im), 0.000001) {
        fail(m + " got=" + cx.to_string(z) + " want=" + str(re) + "+" + str(im) + "i");
    }
}
fn near(a, b, m) { if num_abs(a - b) > 0.000001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base still works ─────────────────────────────────────────────────────────────
approx(cx.mul(cx.new(1, 2), cx.new(3, 4)), -5, 10, "mul");
near(cx.abs(cx.new(3, 4)), 5, "abs");

// ── ENRICH: log (ln|z| + i·arg) ──────────────────────────────────────────────────
approx(cx.log(cx.new(num_exp(1), 0)), 1, 0, "log(e) = 1");

// ── ENRICH: pow (complex^complex and complex^scalar) ─────────────────────────────
approx(cx.pow(cx.new(0, 1), cx.new(2, 0)), -1, 0, "i^2 = -1");
approx(cx.pow(cx.new(2, 0), 10), 1024, 0, "2^10 (scalar exponent)");

// ── ENRICH: to_polar ─────────────────────────────────────────────────────────────
let p = cx.to_polar(cx.new(3, 4));
near(p.r, 5, "to_polar r"); near(p.theta, num_atan2(4, 3), "to_polar theta");

// ── ENRICH: complex trig ─────────────────────────────────────────────────────────
approx(cx.sin(cx.new(0, 0)), 0, 0, "sin(0)=0");
approx(cx.cos(cx.new(0, 0)), 1, 0, "cos(0)=1");
near(cx.re(cx.sin(cx.new(1.5707963267948966, 0))), 1, "sin(pi/2) re ~ 1");
// tan = sin/cos
approx(cx.tan(cx.new(0, 0)), 0, 0, "tan(0)=0");

print "complex_enrich_pass";
