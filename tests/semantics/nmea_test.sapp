let NMEA = import("stdlib:nmea.sapp");

fn close(left, right, tolerance = 0.000001) {
    return num_abs(left - right) <= tolerance;
}

let gga_text = "$GPGGA,123519,4807.038,N,01131.000,E,1,08,0.9,545.4,M,46.9,M,,*47";
let gga = NMEA.parse(gga_text);
assert(gga.ok and gga.sentence_type == "GGA" and gga.checksum.verified,
    "known GGA sentence verifies");
assert(close(gga.position.latitude, 48.1173)
    and close(gga.position.longitude, 11.5166666667),
    "GGA degrees/minutes convert to decimal degrees");
assert(gga.fix.valid and gga.fix.quality == 1 and gga.fix.satellites == 8
    and gga.altitude.available and close(gga.altitude_m, 545.4),
    "GGA fix metadata parses");

let rmc_text = "$GPRMC,225446,A,4916.45,N,12311.12,W,000.5,054.7,191194,020.3,E*68";
let rmc = NMEA.parse(rmc_text);
assert(rmc.ok and rmc.sentence_type == "RMC" and rmc.fix.valid,
    "known RMC sentence verifies");
assert(close(rmc.position.latitude, 49.2741666667)
    and close(rmc.position.longitude, -123.1853333333),
    "RMC signed coordinates convert correctly");
assert(rmc.date.year == 1994 and rmc.date.month == 11 and rmc.date.day == 19,
    "RMC date validates and expands deterministically");

let check = NMEA.checksum("GPGGA,123519,4807.038,N,01131.000,E,1,08,0.9,545.4,M,46.9,M,,");
assert(check.ok and check.hex == "47", "NMEA checksum matches the reference vector");
let gn = NMEA.frame("GNGGA,123519,4807.038,N,01131.000,E,1,08,0.9,545.4,M,46.9,M,,");
assert(gn.ok and NMEA.parse(gn.sentence).ok, "GN multi-constellation talker is accepted");

let no_fix_frame = NMEA.frame("GPGGA,123520,,,,,0,00,99.9,,,,,,");
let no_fix = NMEA.parse(no_fix_frame.sentence);
assert(no_fix.ok and not no_fix.fix.valid and not no_fix.position.available,
    "GGA no-fix state does not manufacture a 0,0 position");

assert(not NMEA.parse("$GPGGA,123519,4807.038,N,01131.000,E,1,08,0.9,545.4,M,46.9,M,,*00").ok,
    "checksum mismatch fails closed");
assert(not NMEA.parse("GPGGA,123519*00").ok, "missing start marker fails closed");
assert(not NMEA.parse(NMEA.frame(
    "GPGGA,123519,9100.000,N,01131.000,E,1,08,0.9,0,M,0,M,,").sentence).ok,
    "out-of-range latitude is rejected");
assert(not NMEA.parse(NMEA.frame(
    "GPRMC,225446,A,4916.45,N,12311.12,W,0.5,54.7,310294,,").sentence).ok,
    "impossible calendar date is rejected");
assert(not NMEA.parse(NMEA.frame(
    "GPVTG,054.7,T,034.4,M,005.5,N,010.2,K").sentence).ok,
    "unsupported sentence type fails explicitly");

let batch = NMEA.parse_batch([gga_text, rmc_text, "$bad*00"], 3);
assert(batch.ok and batch.count == 3 and batch.valid == 2 and batch.invalid == 1,
    "bounded batch retains valid and invalid results");
assert(not NMEA.parse_batch([gga_text, rmc_text], 1).ok,
    "batch work limit is enforced");

let private = NMEA.privacy_view(rmc, 2);
assert(private.ok and private.location.latitude == 49.27
    and private.location.longitude == -123.19,
    "privacy view rounds exact coordinates");
assert(not private.exact_position_exposed and not private.raw_sentence_included
    and not private.device_identifier_included,
    "privacy view excludes exact/raw/device identifiers");
assert(not NMEA.adapter_status().live_ble_ready
    and NMEA.adapter_status().fail_closed,
    "unimplemented live adapters remain fail-closed");

print "nmea_pass";
