// tests/semantics/pbai_ensemble_cache_test.sapp — speed: the shared MLLM engine caches the
// native model's scores per prompt, so ensemble()/ensemble_confidence()/ensemble_decide() on
// the same prompt run the (possibly heavy) classifier ONCE, not three times.

let ens = import("stdlib/pbai_ensemble.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let calls = map{ n: 0 };
let scores = fn(p) { calls.n = calls.n + 1; return map{ intent: "bugs", scores: [0.1, 0.9, 0.1, 0.1, 0.1] }; };
ens.configure(scores, ["explain", "bugs", "improve", "comment", "general"]);
ens.clear_voters();
ens.reset_stats();
ens.clear_native_cache();

// three decisions on the SAME prompt -> classifier evaluated once
ens.ensemble("p1");
ens.ensemble_confidence("p1");
ens.ensemble_decide("p1");
eq(calls.n, 1, "native model computed once for a repeated prompt");

// a new prompt is a cache miss
ens.ensemble("p2");
eq(calls.n, 2, "different prompt recomputes");

// clearing the cache forces recompute
ens.clear_native_cache();
ens.ensemble("p1");
eq(calls.n, 3, "after clear_native_cache, recomputed");

// reconfigure must drop the stale cache (new model => new scores)
ens.configure(scores, ["explain", "bugs", "improve", "comment", "general"]);
ens.ensemble("p1");
eq(calls.n, 4, "reconfigure invalidates the native cache");

print "pbai_ensemble_cache_pass";
