// tests/semantics/serialization_enrich_test.sapp — fix + enrichment for stdlib/serialization.sapp
//
// BUG: xml_unescape replaced &amp; FIRST, so "&amp;lt;" double-decoded to "<"
// instead of "&lt;". Fixed by decoding &amp; LAST.
// ENRICH: validate(text, format), and round-trip coverage for TOML/YAML.

let s = import("stdlib/serialization.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── BUG FIX: nested-entity unescape is correct ───────────────────────────────────
eq(s.xml_unescape("&amp;lt;"), "&lt;", "xml_unescape does not double-decode");
eq(s.xml_unescape(s.xml_escape("x &lt; y & z")), "x &lt; y & z", "xml round-trip with literal entity");
// original plain round-trip still works
eq(s.xml_unescape(s.xml_escape("a < b & c > d")), "a < b & c > d", "xml plain round-trip");

// ── TOML round-trip ──────────────────────────────────────────────────────────────
let tdoc = "name = \"app\"\nport = 8080\n\n[db]\nhost = \"localhost\"\n";
let tparsed = s.toml_parse(tdoc);
eq(tparsed.name, "app", "toml scalar"); eq(tparsed.port, 8080, "toml number"); eq(tparsed.db.host, "localhost", "toml nested");

// ── YAML round-trip ──────────────────────────────────────────────────────────────
let yparsed = s.yaml_parse("name: app\nport: 8080\ntags:\n  - a\n  - b\n");
eq(yparsed.name, "app", "yaml scalar"); eq(yparsed.port, 8080, "yaml number");
eq(len(yparsed.tags), 2, "yaml list len"); eq(yparsed.tags[0], "a", "yaml list item");

// ── ENRICH: validate(text, format) ───────────────────────────────────────────────
eq(s.validate("{\"a\":1}", "json"), true, "validate json ok");
eq(s.validate("{bad", "json"), false, "validate json bad");
eq(s.validate("[1,2,3]", "auto"), true, "validate auto-detect json");

// ── convert across formats ───────────────────────────────────────────────────────
let asyaml = s.convert("{\"x\": 1, \"y\": 2}", "json", "yaml");
if str_index_of(asyaml, "x: 1") < 0 { fail("convert json->yaml: " + asyaml); }

print "serialization_enrich_pass";
