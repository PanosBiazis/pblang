let WASM = import("stdlib:wasm_module.sapp");

fn require(value, message) {
    if not value { throw "wasm_module test failed: " + message; }
}

fn rejected(callable) { return (try { callable(); false } catch true); }

let report = WASM.addition(20, 22);
require(report.value == 42 and report.modeled_value == 42 and report.cross_checked,
    "addition must agree with the bounded instruction model");
require(report.module.envelope_valid and report.module.has_main_function,
    "generated module must expose main through a bounded envelope");
require(report.module.bytes == len(report.artifact) and len(report.module.sha256) == 64,
    "artifact size and digest must be complete");
require(report.module.digest_format == "sha256-bytes-v1" and report.module.section_order_valid,
    "digest and section ordering contracts must be explicit");
require(report.artifact[0] == 0 and report.artifact[1] == 97
    and report.artifact[2] == 115 and report.artifact[3] == 109,
    "generated binary must carry WebAssembly magic");

let negative = WASM.addition(-20, 7);
require(negative.value == -13 and negative.modeled_value == -13,
    "signed operands must remain correct");

require(rejected(fn() { WASM.inspect([0, 97, 115]); }),
    "truncated headers must fail");
require(rejected(fn() { WASM.inspect([0, 97, 115, 109, 2, 0, 0, 0]); }),
    "unknown module versions must fail");
require(rejected(fn() { WASM.inspect([0, 97, 115, 109, 1, 0, 0, 0, 1, 2, 0]); }),
    "truncated section payloads must fail");
require(rejected(fn() { WASM.inspect([0, 97, 115, 109, 1, 0, 0, 0, 1, 0, 1, 0]); }),
    "duplicate non-custom sections must fail");
require(rejected(fn() { WASM.inspect([0, 97, 115, 109, 1, 0, 0, 0, 14, 0]); }),
    "unknown section identifiers must fail");
require(rejected(fn() { WASM.inspect([0, 97, 115, 109, 1, 0, 0, 0, 10, 0, 1, 0]); }),
    "out-of-order non-custom sections must fail");
require(rejected(fn() { WASM.inspect([0, 97, 115, 109, 1, 0, 0, 0, 0.5]); }),
    "non-byte values must fail");
require(rejected(fn() { WASM.addition(2147483647, 1); }),
    "signed overflow must fail before code generation");
require(rejected(fn() { WASM.compile("fn main() { return 1; }", map{ max_source_bytes: 4 }); }),
    "source budgets must be enforced before parsing");
require(rejected(fn() { WASM.addition(1, 2, map{ max_module_bytes: 8 }); }),
    "artifact budgets must be enforced after generation");

print "wasm_module_pass";
