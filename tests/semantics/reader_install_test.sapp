let I=import("../../examples/declarative_browser/install_manager.sapp");let n=0;
fn check(ok,label) {assert(ok,label);n=n+1;}
for version in ["0.1.0","0.1.0-recovery","v2_20261004"] {check(I.valid_version(version),"valid version");}
for version in ["","..","../other","a/b","a\nb","-option","a..b",str_repeat("a",65)] {check(not I.valid_version(version),"invalid version");}
let root="/home/test/reader's files";let text=I.launcher(root,"v2","v1");
check(I.selection(text,root)==map{current:"v2",previous:"v1"},"selection and quoted path roundtrip");
check(str_contains(text,"'\\''"),"shell quote preserves literal apostrophe");
for bad in [text+"echo injected\n",str_replace_all(text,"v2","../bad"),"#!/bin/sh\necho foreign\n"] {
    check(try {I.selection(bad,root);false} catch true,"foreign/modified launcher rejected");
}
check(try {I.selection(text,"/different-root");false} catch true,"launcher owner root is exact");
let one=map{"a.sapp":str_repeat("a",64),"b.sapp":str_repeat("b",64)};let two=map{"b.sapp":str_repeat("b",64),"a.sapp":str_repeat("a",64)};
check(I.fingerprint("v1",one)==I.fingerprint("v1",two),"order independent pin");
check(I.fingerprint("v1",one)!=I.fingerprint("v2",one),"version bound pin");
two["b.sapp"]=str_repeat("c",64);check(I.fingerprint("v1",one)!=I.fingerprint("v1",two),"content bound pin");
print "reader_install_pass checks="+str(n);
