let App=import("../../examples/declarative_browser/app.sapp");let GUI=import("stdlib:gui.sapp");
fn event(c,kind,key) {App.update(c,[map{type:kind,key:key}]);}
fn press(c,key) {event(c,"keydown",key);event(c,"keyup",key);}
let c=App.create();c.width=390;c.height=844;c.session.navigate("pb://guide");App.refresh(c);
c.form.focus="appearance";
event(c,"keydown","Enter");
assert(c.settings and c.form.focus=="font_family","opening preferences focuses its first setting");
event(c,"keydown","Enter");
assert(c.appearance.font_family=="sans","held opening Enter never activates the first preference");
event(c,"keyup","Enter");press(c,"Enter");
assert(c.appearance.font_family=="serif" and c.form.focus=="font_family","font update preserves focus");
press(c,"Enter");assert(c.appearance.font_family=="monospace","successive Enter changes the same setting");
press(c,"Tab");assert(c.form.focus=="body_size","Tab continues to the next preference");
event(c,"keydown","Enter");
event(c,"keydown","Enter");
assert(c.appearance.body_size==18 and c.form.focus=="body_size","repeat cannot cycle size twice across rebuild");
event(c,"keyup","Enter");
// A modifier held during a programmatic update remains live, but maps are detached.
event(c,"keydown","LShift");let older=c.form;
App.configure(c,map{line_height:1.75});App.update(c,[]);
assert(c.form.shift and map_has(c.form.pressed_keys,"LShift"),"held modifier survives preference refresh");
map_remove(older.pressed_keys,"LShift");
assert(map_has(c.form.pressed_keys,"LShift"),"new form does not alias the old key map");
press(c,"Tab");assert(c.form.focus=="font_family","Shift+Tab goes backwards after refresh");
event(c,"keyup","LShift");assert(not c.form.shift,"modifier release clears rebuilt form state");
let original=c.appearance;let current=c.form;
assert((try App.configure(c,map{body_size:999}) catch nil)==nil,"invalid preference rejected");
assert(c.appearance==original and c.form==current and c.form.focus=="font_family" and not c.pending,"invalid update preserves focus and preferences atomically");
event(c,"keydown","LShift");press(c,"Tab");event(c,"keyup","LShift");
assert(c.form.focus=="appearance","Done remains reachable by reverse navigation");
event(c,"keydown","Enter");
assert(not c.settings and c.form.focus=="appearance" and c.session.snapshot().url=="pb://guide","Done returns to the same page and opener");
event(c,"keydown","Enter");assert(not c.settings,"held Done Enter cannot reopen settings");
event(c,"keyup","Enter");press(c,"Tab");
assert(c.form.focus=="block2","next Tab continues to document links");
// Navigation from settings returns to its destination and uses existing fresh-page focus.
c.form.focus="appearance";press(c,"Enter");
GUI.get(c.form,"home").onclick(c.form);App.update(c,[]);
assert(not c.settings and c.session.snapshot().url=="pb://home" and c.form.focus==nil,"Home leaves preferences for its actual destination");
assert(c.appearance.font_family=="monospace" and c.appearance.body_size==18,"navigation retains accepted preferences");
press(c,"Tab");assert(c.form.focus=="back","available history stays in keyboard order");
let locked=App.create("locked");locked.form.focus="back";App.refresh(locked);
assert(locked.form.focus==nil,"disabled controls cannot acquire restored focus");
locked.form.focus="missing";App.refresh(locked);assert(locked.form.focus==nil,"removed control is not restored");
locked.form.focus="page_title";App.refresh(locked);assert(locked.form.focus==nil,"non-interactive text is not restored");
locked.session.close();c.session.close();print "reader_preferences_focus_pass";
