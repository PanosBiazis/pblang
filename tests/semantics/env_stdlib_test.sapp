// Test: env.sapp
let env = import("stdlib:env.sapp");

// Basic get/set
env.set("TEST_VAR", "hello");
assert(env.get("TEST_VAR") == "hello", "env.get should return set value");

// Default value
let missing = env.get_default("MISSING_VAR_12345", "default");
assert(missing == "default", "get_default should return default for missing var");

// int coercion
env.set("MY_PORT", "9090");
let port = env.int("MY_PORT", 8080);
assert(port == 9090, "env.int should parse integer");

// bool coercion
env.set("DEBUG_MODE", "true");
let debug = env.bool("DEBUG_MODE", false);
assert(debug == true, "env.bool should parse true");

env.set("DEBUG_MODE", "0");
let debug2 = env.bool("DEBUG_MODE", true);
assert(debug2 == false, "env.bool should parse 0 as false");

// list coercion
env.set("MY_LIST", "a,b,c");
let items = env.list("MY_LIST", ",", []);
assert(len(items) == 3, "env.list should split by comma");
assert(items[0] == "a", "first item should be a");

// validate
env.set("REQUIRED_VAR", "present");
let result = env.validate(map{
    REQUIRED_VAR: map{ required: true, type: "string" }
});
assert(result.ok == true, "validate should pass for present required var");

let result2 = env.validate(map{
    TOTALLY_MISSING: map{ required: true }
});
assert(result2.ok == false, "validate should fail for missing required var");
assert(len(result2.errors) > 0, "validate should report errors");

print "env stdlib tests passed";
