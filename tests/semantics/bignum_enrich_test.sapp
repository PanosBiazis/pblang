// tests/semantics/bignum_enrich_test.sapp — enrichment for stdlib/bignum.sapp
// Adds Miller-Rabin primality (works on bigints), integer sqrt, factorization,
// divisors, and digit_sum.

let bn = import("stdlib/bignum.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn arr_eq(a, b, m) {
    if len(a) != len(b) { fail(m + " len " + str(len(a)) + " : " + str(a)); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " @" + str(i) + " : " + str(a)); } i = i + 1; }
}

// ── base still works ─────────────────────────────────────────────────────────────
eq(bn.gcd(48, 36), bigint(12), "gcd"); eq(bn.fib(10), bigint(55), "fib");

// ── ENRICH: Miller-Rabin probable prime (handles big numbers) ────────────────────
eq(bn.is_probable_prime(97), true, "97 prime");
eq(bn.is_probable_prime(1763), false, "1763 = 41*43 composite");
eq(bn.is_probable_prime(1789), true, "1789 prime");
// big Mersenne prime 2^61-1
eq(bn.is_probable_prime(bigint("2305843009213693951")), true, "Mersenne 2^61-1 is prime");

// ── ENRICH: integer square root ──────────────────────────────────────────────────
eq(bn.isqrt(bigint(100)), bigint(10), "isqrt 100"); eq(bn.isqrt(bigint(99)), bigint(9), "isqrt 99 floors");
eq(bn.isqrt(bigint(0)), bigint(0), "isqrt 0");

// ── ENRICH: factorize ────────────────────────────────────────────────────────────
arr_eq(bn.factorize(360), [2, 2, 2, 3, 3, 5], "factorize 360");
arr_eq(bn.factorize(97), [97], "factorize a prime");

// ── ENRICH: divisors (sorted) ────────────────────────────────────────────────────
arr_eq(bn.divisors(12), [1, 2, 3, 4, 6, 12], "divisors 12");

// ── ENRICH: digit_sum ────────────────────────────────────────────────────────────
eq(bn.digit_sum(12345), 15, "digit_sum"); eq(bn.digit_sum(bigint("999999999999999999")), 162, "digit_sum bigint");

print "bignum_enrich_pass";
