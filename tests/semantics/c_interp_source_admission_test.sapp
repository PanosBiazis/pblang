let C = import("stdlib:compiler/ctranspile.sapp");
let I = import("stdlib:compiler/interp.sapp");
let P = import("stdlib:execution_pipeline.sapp");
fn rejects(work) { return try { work(); false } catch true; }
let routes = [C.transpile, C.transpile_program, C.transpile_program_int,
    C.transpile_freestanding, C.transpile_freestanding_int, C.transpile_kernel,
    C.transpile_kernel_int, I.compile_program, I.eval_program];
let valid = "fn f(){return 7;}";
for source in [valid + " /* private_canary", valid + " let s=\"private_canary",
    "fn f(){return 7;", "fn f(x=){return 7;}", "fn f(){return 0x;}",
    "fn f(){return 0b102;}", "fn f(){return 1e+;}", "fn f(){return @private_canary;}"] {
    for compile in routes { assert(rejects(fn(){ compile(source); }), "all source routes reject partial programs"); }
    let result = P.build_source(source, "c99-hosted");
    assert(not result.ok and not map_has(result, "artifact") and not map_has(result, "artifact_bytes"), "no pipeline artifact");
}
for value in [nil, false, 7, [], map{}] {
    for compile in routes { assert(rejects(fn(){ compile(value); }), "non-text source rejected"); }
}
let exact = "/*" + str_repeat(" ", 1048576 - 4 - len(valid)) + "*/" + valid;
for compile in routes {
    compile(exact);
    assert(rejects(fn(){ compile(exact + " "); }), "hard byte cap");
    assert(rejects(fn(){ compile("/*" + str_repeat("😀", 262144) + "*/" + valid); }), "UTF-8 bytes not scalars");
}
let tokens = str_repeat("//\n", 65536);
for compile in routes { assert(rejects(fn(){ compile(tokens); }), "comments count toward token cap"); }
assert(str_contains(C.transpile_program("print 7 / 2;"), "double"), "float mode restored");
assert(str_contains(C.transpile_program_int("print 7 / 2;"), "long"), "integer mode remains explicit");
let ast = I.compile_program("let n=40; n=n+2; if n!=42 { missing(); }");
assert(I.eval_ast(ast) and I.eval_ast(ast), "prepared AST reuse after rejected source");
print "c_interp_source_admission_pass";
