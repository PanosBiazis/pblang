// tests/semantics/websocket_server_handshake_test.sapp
//
// Server side of the RFC 6455 opening handshake. websocket.sapp had
// upgrade_response(key) but no way to EXTRACT the client's key from the raw
// GET request, nor to validate that the request is a real websocket upgrade —
// so a pblang WS server had to hand-parse the request. These close that gap
// symmetrically with the client helpers.

let ws = import("stdlib/websocket.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }
fn falsy(c, m) { if c != false { fail(m); } }

// a real client request (as client_handshake_request produces it)
let key = "dGhlIHNhbXBsZSBub25jZQ==";
let req = ws.client_handshake_request("example.com", "/chat", key);

// ── request_key: pull the client's Sec-WebSocket-Key ─────────────────────────
eq(ws.request_key(req), key, "extracts the client key (case-insensitive header)");
eq(ws.request_key("GET / HTTP/1.1\r\nsec-websocket-key: abc123\r\n\r\n"), "abc123",
   "lowercase header name still found");
eq(ws.request_key("GET / HTTP/1.1\r\nHost: x\r\n\r\n"), nil, "no key header -> nil");

// ── is_upgrade_request: true only for a valid websocket upgrade ───────────────
truthy(ws.is_upgrade_request(req), "a real client request is an upgrade");
falsy(ws.is_upgrade_request("GET / HTTP/1.1\r\nHost: x\r\n\r\n"), "a plain GET is not");
// Upgrade token is case-insensitive per RFC 7230
truthy(ws.is_upgrade_request("GET / HTTP/1.1\r\nUpgrade: WebSocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: k\r\n\r\n"),
       "Upgrade token compared case-insensitively");

// ── server_accept: end-to-end handshake response for a request ────────────────
let resp = ws.server_accept(req);
truthy(str_starts_with(resp, "HTTP/1.1 101 Switching Protocols\r\n"), "101 response");
truthy(str_contains(resp, "Sec-WebSocket-Accept: " + ws.client_accept_for(key) + "\r\n"),
       "accept derived from the request's key");

// a client would then VERIFY that exact response against its key -> full loop
truthy(ws.verify_handshake(resp, key), "server_accept response verifies on the client");

// a non-upgrade request yields no accept
eq(ws.server_accept("GET / HTTP/1.1\r\nHost: x\r\n\r\n"), nil, "non-upgrade -> nil");

print "websocket_server_handshake_pass";
