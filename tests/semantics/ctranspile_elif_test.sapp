// Real parser -> PBLang C emitter -> native C execution, not C-string matches alone.
let C99 = import("stdlib/compiler/ctranspile.sapp");
fn require(ok, message) { if not ok { throw "ctranspile elif: " + message; } }
let compiler = C99.find_c_compiler();
require(compiler != nil, "a C compiler is required for this executable regression");
let cases = [
    map{ name: "single", source: "fn branch_pick(x) { if x == 0 { return 10; } elif x == 1 { return 21; } else { return 32; } } print branch_pick(0); print branch_pick(1); print branch_pick(2);", expected: "10\n21\n32\n" },
    map{ name: "chain-and-fallthrough", source: "fn branch_pick(x) { let y = 7; if x == 0 { y = 10; } elif x == 1 { y = 21; } elif x == 2 { y = 32; } return y; } print branch_pick(0); print branch_pick(1); print branch_pick(2); print branch_pick(3);", expected: "10\n21\n32\n7\n" },
    map{ name: "nested-and-else-if", source: "fn branch_pick(x,y) { if x == 0 { return 10; } elif x == 1 { if y == 0 { return 20; } elif y == 1 { return 31; } else { return 42; } } else if x == 2 { return 53; } return 64; } print branch_pick(1,0); print branch_pick(1,1); print branch_pick(1,2); print branch_pick(2,0); print branch_pick(3,0);", expected: "20\n31\n42\n53\n64\n" },
    map{ name: "loop-control", source: "fn count() { let n = 0; let total = 0; while n < 8 { n = n + 1; if n == 1 { total = total + 10; } elif n == 2 { continue; } elif n == 4 { break; } else { total = total + n; } } return total; } print count();", expected: "13\n" },
    map{ name: "capture-only-in-elif", source: "fn make(base) { return fn(x) { if x == 0 { return 10; } elif x == 1 { base = base + 1; return base; } else { return 30; } }; } let f = make(40); print f(0); print f(1); print f(1); print f(2);", expected: "10\n41\n42\n30\n" },
    map{ name: "lambda-inside-elif", source: "fn make(base,x) { if x == 0 { return fn(y) { return y; }; } elif x == 1 { let step = 2; return fn(y) { return base + step + y; }; } else { return fn(y) { return 0; }; } } let f = make(40,1); print f(3);", expected: "45\n" },
    map{ name: "named-value-inside-elif", source: "fn add(x) { return x + 1; } fn choose(x) { if x == 0 { return fn(y) { return y; }; } elif x == 1 { return add; } else { return fn(y) { return 0; }; } } let f = choose(1); print f(41);", expected: "42\n" },
    map{ name: "condition-order", source: "let checks = 0; fn check(x) { checks = checks + 1; return x; } if check(0) { print 10; } elif check(1) { print 21; } elif check(1) { print 32; } else { print 43; } print checks;", expected: "21\n2\n" },
    map{ name: "empty-body", source: "fn branch_pick(x) { let y = 7; if x == 0 { y = 10; } elif x == 1 {} else { y = 21; } return y; } print branch_pick(1); print branch_pick(2);", expected: "7\n21\n" }
];
let executions = 0;
for item in cases {
    for mode in ["float", "integer"] {
        let result = C99.run_program(item.source, map{ compiler: compiler, profile: "portable", numeric: mode, timeout_ms: 2000 });
        require(result.ok, item.name + "/" + mode + " compilation or execution failed: " + str(result));
        require(result.stdout == item.expected, item.name + "/" + mode + " output mismatch: " + result.stdout);
        require(not fs_exists(result.build.output), "native runner left output behind");
        executions = executions + 1;
    }
}
// The direct AST API retains the legacy .block/.then aliases. Canonical .body
// takes precedence, including an explicitly empty body.
let n = map{ kind: "number", value: 1 };
let b = map{ kind: "block", stmts: [map{ kind: "return", value: map{ kind: "number", value: 21 } }] };
for field in ["body", "block", "then"] {
    let branch = map{ cond: n }; branch[field] = b;
    let text = C99.transpile_stmt(map{ kind: "if", cond: n, then: nil, elifs: [branch], else: nil }, 0);
    require(str_contains(text, "return 21;"), "direct AST alias was lost: " + field);
}
let canonical_empty = C99.transpile_stmt(map{ kind: "if", cond: n, then: nil,
    elifs: [map{ cond: n, body: map{ kind: "block", stmts: [] }, block: b }], else: nil }, 0);
if str_contains(canonical_empty, "return 21;") { throw "legacy alias replaced canonical empty body"; }
// Unsupported statements cannot disappear merely because they live in elif.
let rejected = false;
try { C99.transpile_program("if false {} elif true { throw 7; }"); } catch { rejected = true; }
require(rejected, "unsupported elif body was silently omitted");
let no_hosted = false;
try { C99.transpile("fn f(x) { if x == 0 { return 1; } elif x == 1 { print 2; } return 3; }"); } catch { no_hosted = true; }
require(no_hosted, "functions-only profile silently omitted unsupported print");
print "ctranspile_elif_pass " + str(executions);
