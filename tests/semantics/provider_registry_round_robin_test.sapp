import "stdlib:provider_registry.sapp";

provider_registry.clear();
provider_registry.register("p1", "https://example.invalid/one", "tok1");
provider_registry.register("p2", "https://example.invalid/two", "tok2");
provider_registry.register("p3", "https://example.invalid/three", "tok3");

let a = provider_registry.next_provider_name();
let b = provider_registry.next_provider_name();
let c = provider_registry.next_provider_name();
let d = provider_registry.next_provider_name();

if a != "p1" { throw "FAIL a"; }
if b != "p2" { throw "FAIL b"; }
if c != "p3" { throw "FAIL c"; }
if d != "p1" { throw "FAIL d"; }

provider_registry.unregister("p1");
let e = provider_registry.next_provider_name();
if e != "p2" and e != "p3" {
    throw "FAIL e";
}

provider_registry.clear();
let z = provider_registry.next_provider_name();
if z != nil {
    throw "FAIL z";
}

print "provider_registry_round_robin_test: pass";
