// tests/semantics/scheduler_enrich_test.sapp — enrichment for stdlib/scheduler.sapp
// Adds set_immediate, clear_all, is_active, and run_pending() (count of fired timers).

let sched = import("stdlib/scheduler.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

sched.clear_all();
let hits = map{ n: 0 };

// ── ENRICH: set_immediate runs on the next pending pass ──────────────────────────
sched.set_immediate(fn() { hits.n = hits.n + 1; });
eq(sched.run_pending(), 1, "run_pending fired the immediate timer");
eq(hits.n, 1, "immediate handler ran");
eq(sched.run_pending(), 0, "one-shot does not fire again");

// ── set_interval repeats across pending passes ───────────────────────────────────
sched.clear_all();
let iv = map{ n: 0 };
let id = sched.set_interval(fn() { iv.n = iv.n + 1; }, 0);
sched.run_pending(); sched.run_pending();
eq(iv.n, 2, "interval fired on each pending pass");

// ── ENRICH: is_active + clear_timer ──────────────────────────────────────────────
eq(sched.is_active(id), true, "interval is active");
sched.clear_timer(id);
eq(sched.is_active(id), false, "cleared timer is inactive");
let before = iv.n;
sched.run_pending();
eq(iv.n, before, "cleared interval no longer fires");

// ── ENRICH: clear_all ────────────────────────────────────────────────────────────
sched.set_immediate(fn() {}); sched.set_immediate(fn() {});
sched.clear_all();
eq(sched.active_timers(), 0, "clear_all cancels everything");

print "scheduler_enrich_pass";
