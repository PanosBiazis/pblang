let S=import("stdlib:serialization.sapp");
let checks=0;
fn require(value,label) {checks=checks+1;if not value {throw "FAIL serialization quoted keys: "+label;}}
for quote in ["\"", "'"] {
    let key=quote+"value"+quote;
    let good=S.parse_safe(key+" = 42\n","toml");
    require(good.ok and good.value.value==42,"quoted scalar key");
    let table=S.parse_safe("["+quote+"dependencies"+quote+"."+quote+"demo"+quote+"]\n"+key+"=42\n","toml");
    require(table.ok and table.value.dependencies.demo.value==42,"quoted table parts");
    require(not S.parse_safe("value=1\n"+key+"=2\n","toml").ok,"bare then quoted duplicate");
    require(not S.parse_safe(key+"=1\nvalue=2\n","toml").ok,"quoted then bare duplicate");
    require(not S.parse_safe("[demo]\nvalue=1\n["+quote+"demo"+quote+"]\nvalue=2\n","toml").ok,"quoted table collision");
    require(not S.parse_safe("demo=1\n["+quote+"demo"+quote+"]\nvalue=2\n","toml").ok,"quoted table type conflict");
}
for key in ["\"a.b\"", "\"\"", "\"with space\"", "\"bad\\u0061\"", "\"mismatch'", "\"a\"\"b\""] {
    require(not S.parse_safe(key+"=1\n","toml").ok,"unsupported or malformed quoted identifier");
}
require(not S.parse_safe("\"value\"=1\n'value'=2\n","toml").ok,"different quoting same key");
require(not S.parse_safe("\"value\": 42\n","yaml").ok,"YAML quoted-key admission stays unchanged");
require(S.parse_safe("value: 42\n","yaml").ok,"YAML bare keys stay accepted");
print "serialization_quoted_keys_pass "+str(checks);
