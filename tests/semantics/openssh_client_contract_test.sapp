let SSH = import("stdlib:openssh_client.sapp");

fn require(value, message) { if not value { throw "FAIL openssh_client: " + message; } }
fn rejected(work) { return try { work(); false } catch true; }

let status = SSH.status();
require(status.strict_host_key_verification and status.dns_pin_required
    and status.anonymous_credential_storage and status.passwords_disabled
    and status.agents_disabled and status.proxies_disabled and status.forwarding_disabled
    and status.process_group_bounds_required and status.output_bounds_required
    and status.download_file_size_bounded and not status.raw_fallback
    and status.temporary_cleanup_verified and status.sftp_not_scp,
    "static hardened adapter policy");

if status.available {
    require(status.execution_admitted and status.process_group_bounded
        and status.output_bounded and status.ffi_symbol_contract_verified
        and status.operationally_verified,
        "available adapter must be admitted by the canonical process contract");
} else {
    require(not status.execution_admitted and not status.process_group_bounded
        and not status.output_bounded and not status.ffi_symbol_contract_verified
        and not status.operationally_verified,
        "unverified FFI process support must keep OpenSSH unavailable");
}

let base = map{ host: "localhost", pinned_address: "127.0.0.1", user: "tester",
    key_bytes: [1], known_hosts_bytes: [1] };
require(rejected(fn(){ let bad = map{}; let keys = map_keys(base); for i len(keys){bad[keys[i]]=base[keys[i]];}
    bad.pinned_address="127.00.0.1"; bad.command="true"; SSH.execute(bad); })
    and rejected(fn(){ let bad=map{};let keys=map_keys(base);for i len(keys){bad[keys[i]]=base[keys[i]];}
        bad.command="";SSH.execute(bad); })
    and rejected(fn(){ let bad=map{};let keys=map_keys(base);for i len(keys){bad[keys[i]]=base[keys[i]];}
        bad.remote_path="bad\nput";SSH.upload(bad,[1]); }),
    "canonical IP, command and batch separators fail closed");

if not status.available {
    base.command = "true";
    let denied = SSH.execute(base);
    require(not denied.ok and not denied.executed and not denied.execution_admitted
        and not denied.raw_fallback and not denied.credential_material_opened
        and not denied.process_status.available,
        "unavailable process backend must be rejected before credential material is opened");
}

print "openssh_client_contract_pass";
