// Discovery may be skipped only when it cannot change the execution route.
let CP = import("stdlib:compute.sapp");
let A = import("stdlib:accelerator.sapp");
let usable = [map{ kind: "gpu", usable: true, available: true, units: 1 }];
let cases = [
    map{ preferred_device: "cpu" },
    map{ preferred_device: "sequential" },
    map{ allow_accelerators: false },
    map{ min_accelerator_items: 3 },
    map{ preferred_device: "gpu", workload: "tensor", min_accelerator_items: 3 },
    map{ preferred_device: "gpu", workload: "tensor", fallback_to_cpu: false },
    map{ preferred_device: "gpu", allow_accelerators: false, fallback_to_cpu: false },
];
let i = 0;
while i < len(cases) {
    let opts = cases[i];
    let result = CP.run_controlled([2, 3], fn(x) { return x * x; }, opts);
    let expected = CP.select_device(2, usable, CP.policy(opts));
    assert(result.route == expected, "discovery-independent route preserves all diagnostics");
    if result.ok { assert(result.results == [4, 9], "CPU result order and values"); }
    else { assert(result.results == nil, "strict blocked request has no results"); }
    let empty = CP.run_controlled([], fn(_x) { throw "must not execute"; }, opts);
    assert(empty.ok and empty.results == [] and empty.route.reason == "empty_workload", "empty batch");
    i = i + 1;
}

let bad_type = try CP.run_controlled([], fn(x) { return x; }, map{ devices: "bad" }) catch "rejected";
assert(bad_type == "rejected", "empty batch still validates supplied devices");
let oversized = [];
i = 0;
while i < 65 { array_push(oversized, map{ kind: "cpu" }); i = i + 1; }
let bad_size = try CP.run_controlled([1], fn(x) { return x; }, map{
    devices: oversized, preferred_device: "cpu",
}) catch "rejected";
assert(bad_size == "rejected", "explicit CPU still validates supplied device count");
let bad_threshold = try CP.run_controlled([], fn(x) { return x; }, map{
    min_accelerator_items: 0,
}) catch "rejected";
assert(bad_threshold == "rejected", "empty batch still validates policy");
let worker_error = try CP.run_controlled([1], fn(_x) { throw "worker failed"; }) catch "caught";
assert(worker_error == "caught", "worker errors still propagate");

// No device snapshot is cached: runtime registration and removal are observed
// on consecutive eligible calls. This is a mock executor, not GPU acceleration.
A.clear_runtimes();
let eligible = map{
    preferred_device: "gpu", workload: "tensor", min_accelerator_items: 2,
    fallback_to_cpu: false,
};
let missing = CP.run_controlled([2, 3], fn(x) { return x * x; }, eligible);
assert(not missing.ok and missing.route.reason == "runtime_unavailable", "missing runtime");
A.register_runtime("gpu", fn(values) { return [values[0] * values[0], values[1] * values[1]]; });
let present = CP.run_controlled([2, 3], fn(x) { return x * x; }, eligible);
assert(present.ok and present.route.device == "gpu" and present.results == [4, 9], "fresh runtime registration");
A.clear_runtimes();
let removed = CP.run_controlled([2, 3], fn(x) { return x * x; }, eligible);
assert(not removed.ok and removed.route.reason == "runtime_unavailable", "fresh runtime removal");
print "compute_discovery_pass";
