// tests/semantics/fuzzy_match_test.sapp
//
// stdlib/fuzzy_match.sapp — fzf-style fuzzy matching for pbide's command
// palette / file picker (adoptable module: pbide WIP is not touched). Greedy
// subsequence scoring with consecutive-run and word-boundary bonuses, plus
// ranking and a highlighter for rendering matches.

let FZ = import("stdlib/fuzzy_match.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }

// subsequence scoring: consecutive + boundary beats scattered
truthy(FZ.score("gp", "gpio.sapp") > FZ.score("gp", "grep_code"), "consecutive start ranks higher");
eq(FZ.score("xyz", "abc"), 0 - 1, "non-subsequence scores -1");
truthy(FZ.score("GP", "gpio.sapp") == FZ.score("gp", "gpio.sapp"), "case-insensitive");
// word boundaries (after _ - . / space) earn a bonus
truthy(FZ.score("rc", "read_config") > FZ.score("rc", "circle"), "boundary hits beat mid-word");

// positions for highlight rendering
let pos = FZ.match_positions("gp", "gpio");
eq(len(pos), 2, "two positions");
eq(pos[0], 0, "g at 0"); eq(pos[1], 1, "p at 1");
eq(FZ.match_positions("zz", "gpio"), nil, "no positions when no match");

// ranking filters non-matches and sorts by score
let r = FZ.rank("cfg", ["pbconfig.sapp", "chatbot.sapp", "gpu2d_shader.sapp"], 5);
eq(len(r), 1, "only real subsequence matches survive");
eq(r[0].text, "pbconfig.sapp", "pbconfig matches c-f-g");
let r2 = FZ.rank("gp", ["grep_code", "gpio.sapp"], 5);
eq(r2[0].text, "gpio.sapp", "best match first");
eq(len(FZ.rank("gp", ["grep_code", "gpio.sapp"], 1)), 1, "k caps results");

// highlighter wraps matched chars
eq(FZ.highlight("gp", "gpio", "[", "]"), "[g][p]io", "highlight wraps matches");
eq(FZ.highlight("zz", "gpio", "[", "]"), "gpio", "no match -> unchanged");

print "fuzzy_match_pass";
