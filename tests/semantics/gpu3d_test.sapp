// tests/semantics/gpu3d_test.sapp — stdlib/gpu3d.sapp
//
// The 3D extension of the GPU stack: a triangle-mesh IR with auto-computed face normals,
// box/quad primitives, a 10-float vertex [x,y,z, nx,ny,nz, r,g,b,a], MVP+lighting shaders
// (mat4 from mat4.sapp), and a parallel bake. Pure + deterministic.

let G3 = import("stdlib/gpu3d.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "]"); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.001 { fail(m + " got=" + str(a)); } }
fn truthy(c, m) { if c != true { fail(m); } }

let RED = map{ r: 255, g: 0, b: 0, a: 255 };

// ── a triangle in the XY plane gets a +Z face normal ────────────────────────────────
let m = G3.new();
G3.tri(m, map{ x: 0, y: 0, z: 0 }, map{ x: 1, y: 0, z: 0 }, map{ x: 0, y: 1, z: 0 }, RED);
eq(G3.vertices(m), 3, "tri -> 3 verts");
let vb = G3.to_vertex_f32(m);
eq(len(vb), 3 * 10, "10 floats per vertex");
approx(vb[0], 0, "p0.x"); approx(vb[3], 0, "nx"); approx(vb[4], 0, "ny"); approx(vb[5], 1, "nz = +Z");
approx(vb[6], 1.0, "r normalized");

// ── a box is 6 faces = 12 triangles = 36 vertices ───────────────────────────────────
let mb = G3.new();
G3.box(mb, 0, 0, 0, 2, 2, 2, RED);
eq(G3.triangles(mb), 12, "box -> 12 tris");
eq(G3.vertices(mb), 36, "box -> 36 verts");

// ── parallel bake matches sequential ────────────────────────────────────────────────
eq(len(G3.to_vertex_f32_par(m)), len(vb), "parallel bake same length");

// ── vertex layout + shader ──────────────────────────────────────────────────────────
let vl = G3.vertex_layout();
eq(vl.stride, 40, "40-byte stride (10 f32)");
eq(len(vl.attributes), 3, "pos / normal / color");
eq(vl.attributes[1].offset, 12, "normal after vec3 pos");
eq(vl.attributes[2].offset, 24, "color after two vec3");
let w = G3.wgsl();
truthy(str_contains(w, "@vertex"), "wgsl vertex"); truthy(str_contains(w, "@fragment"), "wgsl fragment");
truthy(str_contains(w, "mvp"), "wgsl MVP uniform"); truthy(str_contains(w, "dot("), "wgsl lambert lighting");
truthy(str_contains(G3.glsl_vertex(), "gl_Position"), "glsl vertex");

let st = G3.stats(mb);
eq(st.triangles, 12, "stats triangles"); eq(st.draw_calls, 1, "one mesh draw");

// ── plane: 1 quad = 2 triangles, normal +Y ──────────────────────────────────────────
let mp = G3.new();
G3.plane(mp, 0, 0, 0, 4, 4, RED);
eq(G3.triangles(mp), 2, "plane -> 2 tris");
let pv = G3.to_vertex_f32(mp);
approx(pv[4], 1, "plane normal +Y");

// ── sphere: (segments) x (rings) grid; every vertex ~radius from center ─────────────
let ms = G3.new();
G3.sphere(ms, 0, 0, 0, 2, 8, 6, RED);
truthy(G3.triangles(ms) > 0, "sphere has triangles");
let sv = G3.to_vertex_f32(ms);
// first vertex distance from origin ~= radius 2
let d0 = num_sqrt(sv[0] * sv[0] + sv[1] * sv[1] + sv[2] * sv[2]);
approx(d0, 2, "sphere vertex on radius");

// ── cylinder: side quads (+ optional caps) ──────────────────────────────────────────
let mc = G3.new();
G3.cylinder(mc, 0, 0, 0, 1, 4, 8, RED);
truthy(G3.triangles(mc) >= 16, "cylinder has side triangles");

print "gpu3d_pass";
