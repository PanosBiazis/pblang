// Actual bound facades with original source trees hidden; synthetic caller decoys.
if platform()!="linux" {print "pbai_specialist_installed_skip_linux_required";os_exit(0);}
let U=import("stdlib:uuid.sapp");let parent=path_dirname(cwd());
let exe=env_get("PBLANG_BIN");assert(type(exe)=="string" and exe!="","set trusted PBLANG_BIN");
let phase=env_get("PBAI_BINDING_TEST_PHASE");if phase==nil or phase=="" {phase="installed";}
assert(phase=="installed" or phase=="unavailable" or phase=="surface","select a bounded acceptance phase");
let root=path_join("/tmp","pbai-specialist-origin-installed-"+U.v4());
let caller=path_join(root,"caller");let state=path_join(root,"state");let step=["setup"];let completed=[0];
fn process(command,args) {
 let argv=["-k","1s","35s",command];for arg in args {push(argv,arg);}
 return proc_spawn_wait("/usr/bin/timeout",argv);
}
fn build(at) {return process("/usr/bin/env",["-C",at,exe,"build"]);}
fn hidden(at,file) {
 let argv=["--die-with-parent","--unshare-net","--ro-bind","/","/","--bind",root,root,
  "--tmpfs",path_join(parent,"pblang"),"--tmpfs",path_join(parent,"pbai")];
 let extra=env_get("PBAI_SOURCE_HIDE_ROOT");if type(extra)=="string" and extra!="" {push(argv,"--tmpfs");push(argv,extra);}
 for value in ["--setenv","PBAI_STATE_ROOT",state,"--chdir",at,exe,"run",file,
  "--allow-all","--deny-net","--deny-http","--deny-exec","--deny-spawn","--deny-ffi","--deny-sqlite"] {push(argv,value);}
 return process("/usr/bin/bwrap",argv);
}
fn result(output) {
 assert(output.exit_code==0 and not str_contains(output.stdout,"DECOY_EXECUTED"),"bound example executes without caller provider");
 let value=json_parse(output.stdout);
 assert(value.format=="pbai.student-review-close.example.v1" and value.phase=="closed" and value.inference_refused
  and value.export_usable and value.report_available and not value.globally_activated,"actual bound lifecycle result");
 return output.stdout;
}
fn lock_caller() {
 fs_write(path_join(caller,"main.sapp"),"print 0;\n");
 fs_write(path_join(caller,"pblang.toml"),"[package]\nname=\"caller-decoy\"\nversion=\"0.1.0\"\nentry=\"main.sapp\"\n[dependencies]\nstdlib={path=\"stdlib\"}\n");
 assert(build(caller).exit_code==0,"valid caller manifest and lock");
}
fn exercise() {
 fs_mkdirs(root);assert(process("/bin/chmod",["700",root]).exit_code==0,"private fixture root");
 fs_mkdirs(caller);fs_mkdirs(state);fs_mkdirs(path_join(caller,"stdlib"));
 for name in ["pbai_neural_adapter.sapp","pbai_specialist_binding.sapp","serialization.sapp","json.sapp","csv.sapp"] {
  fs_write(path_join(path_join(caller,"stdlib"),name),"print \"DECOY_EXECUTED\";throw \"caller decoy\";\n");
 }
 for name in ["pblang","pbai"] {
  let source=path_join(parent,name);let installed=path_join(root,name);fs_mkdirs(installed);step[0]="copy "+name;
  assert(process("/bin/cp",["-R",path_join(source,"stdlib"),path_join(installed,"stdlib")]).exit_code==0,"copy library");
  let example=if name=="pblang" {"examples/pbai_student_review_close.sapp"} else {"demo/pbai_student_review_close.sapp"};
  let source_text=fs_read(path_join(source,example));fs_write(path_join(installed,"example.sapp"),source_text);
  fs_write(path_join(installed,"binding.sapp"),fs_read(path_join(source,"tests/semantics/pbai_specialist_binding_test.sapp")));
  fs_mkdirs(path_join(installed,"tests/fixtures"));
  for fixture in ["pbai_specialist_noncallable.sapp","pbai_specialist_bind_no_calls.sapp"] {
   fs_write(path_join(path_join(installed,"tests/fixtures"),fixture),fs_read(path_join(path_join(source,"tests/fixtures"),fixture)));
  }
  let parts=str_split(source_text,"let refused=");assert(len(parts)==2,"closed error fixture prefix is exact");
  fs_write(path_join(installed,"closed-error.sapp"),parts[0]+"h.predict(nil);\n");
  fs_write(path_join(installed,"legacy.sapp"),"let AI=import(\"stdlib/pbai.sapp\");AI.neural_specialist_train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);print \"legacy-specialist-ok\";\n");
  fs_write(path_join(installed,"optional.sapp"),"let AI=import(\"stdlib/pbai.sapp\");let refused=try {AI.neural_specialist_bind(nil);false} catch true;assert(refused and len(AI.modular_catalog().adapters)==2,\"missing optional neural provider does not break facade or permit binding\");print \"optional-specialist-refused\";\n");
  let dep=if name=="pblang" {"stdlib"} else {"../pblang/stdlib"};
  fs_write(path_join(installed,"pblang.toml"),"[package]\nname=\"specialist-installed-fixture\"\nversion=\"0.1.0\"\nentry=\"example.sapp\"\n[dependencies]\nstdlib={path="+json_stringify(dep)+"}\n");
 }
 if phase=="surface" {
  lock_caller();
  for name in ["pblang","pbai"] {
   let at=path_join(root,name);step[0]="full bound surface from locked foreign cwd "+name;
   assert(build(at).exit_code==0,"materialize full-surface fixture lock");
   let checked=hidden(caller,path_join(at,"binding.sapp"));
   assert(checked.exit_code==0 and checked.stdout=="pbai_specialist_binding_pass:14:22\n","all bound operations and codecs survive foreign cwd without decoy execution");
   completed[0]=completed[0]+1;
  }
  return nil;
 }
 if phase=="unavailable" {
  lock_caller();let provider=path_join(root,"pblang/stdlib/pbai_neural_adapter.sapp");fs_remove(provider);
  for unavailable in ["missing","broken"] {
   if unavailable=="broken" {fs_write(provider,"throw \"synthetic provider initialization failure\";\n");}
   for name in ["pblang","pbai"] {
    let at=path_join(root,name);step[0]=unavailable+" "+name;
    assert(build(at).exit_code==0,"materialize unavailable-provider fixture lock");
    let optional=hidden(caller,path_join(at,"optional.sapp"));
    assert(optional.exit_code==0 and optional.stdout=="optional-specialist-refused\n","facade remains usable without loading optional provider");
    let failed=hidden(caller,path_join(at,"example.sapp"));
    assert(failed.exit_code!=0 and not str_contains(failed.stdout,"DECOY_EXECUTED")
     and not str_contains(failed.stdout,"pbai.student-review-close.example.v1"),"missing or broken selected provider cannot fall back to caller decoy");
    completed[0]=completed[0]+1;
   }
  }
  return nil;
 }
 let expected="";
 for name in ["pblang","pbai"] {
  let at=path_join(root,name);step[0]="build "+name;assert(build(at).exit_code==0,"build installed fixture");
  assert(not str_contains(fs_read(path_join(at,"pblang.lock")),parent),"lock excludes checkout roots");
  step[0]="unlocked foreign cwd "+name;let output=result(hidden(caller,path_join(at,"example.sapp")));
  if expected!="" {assert(output==expected,"actual facade byte parity");}expected=output;
 }
 lock_caller();
 for name in ["pblang","pbai"] {
  let at=path_join(root,name);step[0]="trusted installed cwd "+name;
  assert(result(hidden(at,path_join(at,"example.sapp")))==expected,"trusted installed cwd parity");
  step[0]="locked caller decoy "+name;
  assert(result(hidden(caller,path_join(at,"example.sapp")))==expected,"caller lock cannot redirect bound example");
  step[0]="closed error guard from foreign cwd "+name;
  let guard=hidden(caller,path_join(at,"closed-error.sapp"));
  assert(str_contains(guard.stderr,"student review is closed") and not str_contains(guard.stdout,"DECOY_EXECUTED"),"closed guard remains before malformed input");
  step[0]="legacy foreign cwd limit "+name;let legacy=hidden(caller,path_join(at,"legacy.sapp"));
  assert(legacy.stdout=="DECOY_EXECUTED\n" and str_contains(legacy.stderr,"caller decoy"),"legacy lazy wrapper remains outside supported foreign-cwd route");
  completed[0]=completed[0]+1;
 }
}
let passed=try {exercise();true} catch false;
let removed=process("/bin/rm",["-rf","--",root]);
assert(passed,"specialist installed acceptance: "+step[0]);assert(removed.exit_code==0,"owned fixture cleanup");
assert(completed[0]==if phase=="unavailable" {4} else {2},"all selected product cases checked");
print "pbai_specialist_origin_"+phase+"_pass";
