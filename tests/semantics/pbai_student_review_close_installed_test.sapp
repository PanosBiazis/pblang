// Copied actual facades: trusted project cwd acceptance and known foreign-cwd limit.
if platform()!="linux" {print "pbai_student_review_close_installed_skip_linux_required";os_exit(0);}
let U=import("stdlib:uuid.sapp");let parent=path_dirname(cwd());
let exe=env_get("PBLANG_BIN");assert(type(exe)=="string" and exe!="","set trusted PBLANG_BIN");
let root=path_join("/tmp","pbai-review-close-installed-"+U.v4());
let caller=path_join(root,"caller");let state=path_join(root,"state");let step=["setup"];let completed=[0];
fn process(command,args) {
 let argv=["-k","1s","40s",command];for arg in args {push(argv,arg);}
 return proc_spawn_wait("/usr/bin/timeout",argv);
}
fn build(at) {return process("/usr/bin/env",["-C",at,exe,"build"]);}
fn hidden(at,file) {
 let argv=["--die-with-parent","--unshare-net","--ro-bind","/","/","--bind",root,root,
  "--tmpfs",path_join(parent,"pblang"),"--tmpfs",path_join(parent,"pbai")];
 let extra=env_get("PBAI_SOURCE_HIDE_ROOT");if type(extra)=="string" and extra!="" {push(argv,"--tmpfs");push(argv,extra);}
 for value in ["--setenv","PBAI_STATE_ROOT",state,"--chdir",at,exe,"run",file,
  "--allow-all","--deny-net","--deny-http","--deny-exec","--deny-spawn"] {push(argv,value);}
 return process("/usr/bin/bwrap",argv);
}
fn exercise() {
 fs_mkdirs(root);assert(process("/bin/chmod",["700",root]).exit_code==0,"private root");
 fs_mkdirs(caller);fs_mkdirs(state);
 for name in ["pblang","pbai"] {
  let source=path_join(parent,name);let installed=path_join(root,name);fs_mkdirs(installed);
  step[0]="copy "+name;
  assert(process("/bin/cp",["-R",path_join(source,"stdlib"),path_join(installed,"stdlib")]).exit_code==0,"copy library");
  let example=if name=="pblang" {"examples/pbai_student_review_close.sapp"} else {"demo/pbai_student_review_close.sapp"};
  let source_text=fs_read(path_join(source,example));
  fs_write(path_join(installed,"example.sapp"),source_text);
  let prefix=str_split(source_text,"let refused=")[0];
  fs_write(path_join(installed,"closed-error.sapp"),prefix+"h.predict(nil);\n");
  let dep=if name=="pblang" {"stdlib"} else {"../pblang/stdlib"};
  fs_write(path_join(installed,"pblang.toml"),"[package]\nname=\"review-close-installed-fixture\"\nversion=\"0.1.0\"\nentry=\"example.sapp\"\n[dependencies]\nstdlib={path="+json_stringify(dep)+"}\n");
  assert(build(installed).exit_code==0,"build installed fixture");
  assert(not str_contains(fs_read(path_join(installed,"pblang.lock")),parent),"lock excludes checkout roots");
 }
 fs_mkdirs(path_join(caller,"stdlib"));
 fs_write(path_join(caller,"stdlib/pbai_neural_adapter.sapp"),"print \"DECOY_EXECUTED\";throw \"caller decoy\";");
 fs_write(path_join(caller,"main.sapp"),"print 0;");
 fs_write(path_join(caller,"pblang.toml"),"[package]\nname=\"caller-decoy\"\nversion=\"0.1.0\"\nentry=\"main.sapp\"\n[dependencies]\nstdlib={path=\"stdlib\"}\n");
 assert(build(caller).exit_code==0,"caller lock exists");
 let expected="";
 for name in ["pblang","pbai"] {
  step[0]="source-hidden "+name;let at=path_join(root,name);let output=hidden(at,path_join(at,"example.sapp"));
  assert(output.exit_code==0 and not str_contains(output.stdout,"DECOY_EXECUTED"),"installed example executes");
  let value=json_parse(output.stdout);
  assert(value.format=="pbai.student-review-close.example.v1" and value.phase=="closed" and value.inference_refused and value.export_usable and value.report_available and not value.globally_activated,"actual installed lifecycle result");
  if expected!="" {assert(output.stdout==expected,"shared and facade results match");}expected=output.stdout;
  step[0]="closed error guard "+name;
  let guard=hidden(at,path_join(at,"closed-error.sapp"));
  assert(str_contains(guard.stderr,"student review is closed") and not str_contains(guard.stderr,"invalid token context"),"fixed closed error precedes malformed input validation");
  // Retained runtime lazy imports resolve at cwd; do not promise foreign-cwd safety.
  step[0]="known foreign cwd limit "+name;
  let foreign=hidden(caller,path_join(at,"example.sapp"));
  assert(foreign.stdout=="DECOY_EXECUTED\n" and str_contains(foreign.stderr,"caller decoy"),"known runtime origin limit remains explicit");
  completed[0]=completed[0]+1;
 }
}
let passed=try {exercise();true} catch false;
let removed=process("/bin/rm",["-rf","--",root]);
assert(passed,"review close installed example: "+step[0]);assert(removed.exit_code==0,"owned fixture cleanup");
assert(completed[0]==2,"both copied examples checked");
print "pbai_student_review_close_installed_project_cwd_pass";
