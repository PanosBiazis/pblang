let App=import("../../examples/declarative_browser/app.sapp");let GUI=import("stdlib:gui.sapp");
let D=import("stdlib:browser_document.sapp");let P=import("../../examples/declarative_browser/pagination.sapp");
let checks=0;fn check(value,label) {assert(value,label);checks=checks+1;}
let source=D.export_html(D.create("Remember my place — Θέση",[
    map{tag:"p",text:str_repeat("Reading words. ",16)},map{tag:"p",text:str_repeat("Ελληνικό κείμενο. ",12)},
    map{tag:"a",text:"Guide",href:"pb://guide"}]));
fn make() {let c=App.create("local","dark",map{body_size:20,font_scale:1.5},source);c.width=320;c.height=480;App.refresh(c);return c;}
fn action(c,name) {let button=GUI.get(c.form,name);assert(button!=nil,"Test action exists: "+name);button.onclick(c.form);App.update(c,[]);}
fn end(c) {App.read_page(c,len(c.reading_plan.pages)-1);App.update(c,[]);}
let c=make();end(c);let home=c.reading_anchor;let home_page=c.reading_page;
check((try home.kind catch nil)!=nil,"test exercises typed text/link anchor");
action(c,"block2");check(c.session.snapshot().url=="pb://guide" and c.reading_anchor.block==-1,"new link starts first");
App.read_page(c,1);App.update(c,[]);let guide=c.reading_anchor;
action(c,"back");check(c.reading_anchor==home and c.reading_page==home_page,"Back restores exact source place");
action(c,"forward");check(c.reading_anchor==guide,"Forward restores guide place");
App.configure(c,map{body_size:18,title_size:40});c.width=390;c.height=600;App.refresh(c);
action(c,"back");check(c.reading_anchor==home and c.reading_page==P.locate(c.reading_plan,home),"Back relocates after reflow");
// The same URL can occupy multiple history entries, each with its own position.
end(c);let branch_home=c.reading_anchor;action(c,"block2");check(not c.session.snapshot().can_forward,"new link truncates forward history");
end(c);action(c,"block3");check(c.session.snapshot().url=="pb://home" and c.reading_page==0,"fresh home link starts first");
App.read_page(c,1);App.update(c,[]);let second_home=c.reading_anchor;
action(c,"back");action(c,"back");check(c.reading_anchor==branch_home,"earlier home entry retains its own place");
action(c,"forward");action(c,"forward");check(c.reading_anchor==second_home,"later home entry has independent place");
action(c,"home");check(c.reading_anchor.block==-1 and c.reading_page==0,"Home on current home deliberately starts first");
end(c);let same=c.reading_anchor;
check(App.remember_positions(c,false),"developer can disable restoration");
check(c.reading_anchor==same and not App.remember_positions(c,false),"policy does not move current page; repeat is no-op");
action(c,"block2");action(c,"back");check(c.reading_anchor.block==-1,"opt-out preserves previous first-page behavior");
check((try App.remember_positions(c,1) catch nil)==nil and not c.remember_positions,"invalid policy rejected unchanged");
check(App.remember_positions(c),"developer can re-enable restoration");
c.session.close();
// A failed navigation must not save, pop or move any presentation state.
let locked=App.create("locked","dark",map{body_size:20,font_scale:1.5},source);locked.width=320;locked.height=480;App.refresh(locked);end(locked);
let position=locked.reading_anchor;let signature=json_stringify(locked.reading_history);action(locked,"block2");
check(locked.reading_anchor==position and json_stringify(locked.reading_history)==signature,"denied destination preserves position history");locked.session.close();
// More than32 successful navigations keep the session's existing bounded history.
let bounded=make();for _i 40 {
    end(bounded);action(bounded,"block2");end(bounded);action(bounded,"block3");
    check(len(bounded.reading_history.back)+len(bounded.reading_history.forward)<=31,"position history bounded");
}
check(bounded.session.snapshot().history_count==32,"session cap unchanged");
for _i 31 {action(bounded,"back");check(len(bounded.reading_history.back)+len(bounded.reading_history.forward)==31,"Back keeps bounded slots");}
let at_start=bounded.reading_anchor;action(bounded,"back");check(bounded.reading_anchor==at_start,"unavailable Back is no-op");
for _i 31 {action(bounded,"forward");check(len(bounded.reading_history.forward)==30-_i,"Forward consumes exactly one remembered position");}
check(not bounded.session.snapshot().can_forward,"forward reaches current history end");bounded.session.close();
// A new controller never inherits an earlier controller's positions.
let fresh=make();check(fresh.reading_page==0 and len(fresh.reading_history.back)==0,"fresh session has no saved places");fresh.session.close();
let recovery=make();end(recovery);let recover_anchor=recovery.reading_anchor;action(recovery,"block2");
App.configure(recovery,map{title_size:40,font_scale:1.5,line_height:2.5});recovery.height=240;App.refresh(recovery);action(recovery,"back");
check(not recovery.reading_plan.available and recovery.reading_anchor==recover_anchor,"unavailable layout retains restored anchor");
recovery.height=480;App.configure(recovery,map{title_size:28,line_height:1.45});App.refresh(recovery);
check(recovery.reading_plan.available and recovery.reading_page==P.locate(recovery.reading_plan,recover_anchor),"larger layout recovers restored position");recovery.session.close();
print "reader_history_position_pass checks="+str(checks);
