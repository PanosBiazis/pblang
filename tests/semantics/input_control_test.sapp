// tests/semantics/input_control_test.sapp
// Keyboard/mouse input carries STRICTER gates than perception: a separate enable flag
// (PB_INPUT_CONTROL), a key allowlist, a text-length cap, plus the master-control
// deny-ceiling, unlock and approval. With nothing enabled, everything is refused.
let ic = import("stdlib:input_control.sapp");
let x11_native = import("stdlib:x11_input.sapp");
let windows_native = import("stdlib:windows_unicode_input.sapp");
let wayland_native = import("stdlib:wayland_unicode_input.sapp");
let macos_native = import("stdlib:macos_unicode_input.sapp");

fn fail(m) { throw "FAIL " + m; }

// backends() reports availability + that input is NOT enabled by default
let b = ic.backends();
if b.enabled != false { fail("input must be disabled by default"); }
if type(b.available) != "bool" { fail("backends.available should be bool"); }
if b.available and (b.selected == nil or b.selection_error != nil) {
    fail("available backend selection must identify the executable backend");
}
if b.pblang_x11_layout_independent_unicode !=
    (x11_native.available().ok and x11_native.capabilities().text_unicode_layout_independent) {
    fail("input-control Unicode capability must match the X11 semantic backend");
}
if b.pblang_x11_semantic_text_boundary != "X11/XTest+xmodmap+flock" {
    fail("semantic text boundary must be explicit");
}
if b.pblang_windows_semantic != windows_native.available().ok
    or b.pblang_windows_layout_independent_unicode !=
        (windows_native.available().ok and windows_native.capabilities().text_unicode_layout_independent)
    or not str_contains(b.pblang_windows_semantic_text_boundary, "SendInput") {
    fail("Windows semantic input capability mismatch");
}
if type(b.pblang_wayland_candidate) != "bool"
    or type(b.pblang_wayland_semantic) != "bool"
    or b.pblang_wayland_layout_independent_unicode != b.pblang_wayland_semantic
    or not str_contains(b.pblang_wayland_semantic_text_boundary, "virtual-keyboard-v1") {
    fail("Wayland semantic input capability mismatch");
}

// Explicit backend selection is deterministic and invalid policy fails closed.
let invalid = ic.select_backend("not-a-backend");
if invalid.ok or not str_contains(invalid.error, "unsupported PB_INPUT_BACKEND") {
    fail("invalid explicit backend must fail closed");
}
let x11 = ic.select_backend("x11");
if x11.ok and (x11.selected != "pblang-x11-xtest" or not x11.explicit) {
    fail("X11 alias must resolve to the PBLang-native XTest backend");
}
if not x11.ok and (x11.selected != "pblang-x11-xtest" or not x11.explicit) {
    fail("unavailable explicit X11 selection must remain attributable");
}
let forced = ic.backends("x11");
if forced.available != x11.ok or forced.selected != "pblang-x11-xtest"
    or not forced.explicit_selection {
    fail("backend report must match explicit selection");
}
let windows = ic.select_backend("windows");
if windows.selected != "pblang-windows-sendinput" or not windows.explicit {
    fail("Windows alias must remain deterministic and attributable");
}
if windows.ok != windows_native.available().ok { fail("Windows availability mismatch"); }
let wayland = ic.select_backend("wayland");
if wayland.selected != "pblang-wayland-virtual-keyboard" or not wayland.explicit {
    fail("Wayland alias must remain deterministic and attributable");
}
if wayland.ok and not wayland_native.probe(150).ok {
    fail("Wayland selector accepted a compositor without the privileged protocol");
}
let wayland_key = ic.select_event_backend(map{
    format: "pblang.input.event.v1", kind: "key", key: "Enter"
}, "wayland");
if wayland_key.ok or wayland_key.selected != "pblang-wayland-virtual-keyboard" {
    fail("Wayland semantic backend must reject non-text input");
}
let macos = ic.select_backend("macos");
if macos.selected != "pblang-macos-coregraphics" or not macos.explicit {
    fail("macOS alias must remain deterministic and attributable");
}
if macos.ok != macos_native.available().ok { fail("macOS availability mismatch"); }
if b.pblang_macos_semantic != macos_native.available().ok
    or b.pblang_macos_layout_independent_unicode != macos_native.available().ok
    or not str_contains(b.pblang_macos_semantic_text_boundary, "CGEvent") {
    fail("macOS semantic input capability mismatch");
}
let absolute_plan = x11_native.plan(map{
    format: "pblang.input.event.v1", kind: "pointer", x: 320, y: 240
});
if not absolute_plan.ok
    or absolute_plan.absolute_strategy != "bounded-relative-origin-anchor"
    or not str_contains(str(absolute_plan.calls), "XTestFakeRelativeMotionEvent")
    or not x11_native.capabilities().absolute_pointer {
    fail("PBLang-native X11 must support bounded absolute pointer actuation");
}

let text_event = map{ format: "pblang.input.event.v1", kind: "type", text: "A\u03bb\u4e2d" };
let automatic_text = ic.select_event_backend(text_event);
if x11_native.available().ok and (not automatic_text.ok
    or automatic_text.selected != "pblang-x11-xtest") {
    fail("automatic text must prefer the keysym-aware native X11 backend: " + str(automatic_text));
}
let forced_uinput_text = ic.select_event_backend(text_event, "uinput");
if forced_uinput_text.ok or forced_uinput_text.selected != "pblang-uinput" {
    fail("explicit uinput Unicode text must fail closed instead of corrupting characters");
}

// safe-key allowlist exists and excludes risky keys
let sk = ic.safe_keys();
if len(sk) < 5 { fail("safe key allowlist too small"); }
if ic.key("F1").status != "denied" { fail("non-allowlisted key must be denied"); }
let allowed_key = ic.key("Return");   // allowlisted, but input not enabled -> denied at gate
if allowed_key.status != "denied" { fail("allowlisted key still denied while input disabled"); }
if not str_contains(allowed_key.reason, "not enabled") { fail("reason should cite input not enabled (got " + allowed_key.reason + ")"); }

// type_text: validation happens before the gate
if ic.type_text(12345).status != "denied" { fail("non-string text denied"); }
let toolong = "";
let i = 0;
while i < 5000 { toolong = toolong + "x"; i = i + 1; }
if ic.type_text(toolong).status != "denied" { fail("over-length text denied"); }

// a normal type request is still denied because input control is disabled
let t = ic.type_text("hello world");
if t.status != "denied" or not str_contains(t.reason, "not enabled") { fail("type denied while disabled"); }

// mouse + click likewise gated
if ic.mouse_move(10, 10).status != "denied" { fail("mouse_move denied while disabled"); }
if ic.click(1).status != "denied" { fail("click denied while disabled"); }

// run() without a pending approved action is refused
if ic.run(1, "x").ok != false { fail("run refused without approval"); }

print "input_control_pass";
