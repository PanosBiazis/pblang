// Test: tools/pbmigrate.sapp remains a PBLang-only, shell-free manifest gate.

fn fail(message) { throw "FAIL " + message; }

let source = try fs_read("tools/pbmigrate.sapp") catch "";
if source == "" { fail("pbmigrate source is readable"); }
if not str_contains(source, "stdlib:migration_policy.sapp") { fail("CLI uses migration policy module"); }
if not str_contains(source, "--json") or not str_contains(source, "--lines=") { fail("CLI exposes stable output controls"); }
if not str_contains(source, "FS.read_json") { fail("CLI reads a structured manifest"); }
if str_contains(source, "proc_spawn") or str_contains(source, "shell") or str_contains(source, "bash") or str_contains(source, "git ") {
    fail("CLI must not invoke shell, git, or host process helpers");
}
if str_contains(source, "--allow-all") { fail("CLI must not recommend capability escalation"); }
if not str_contains(source, "os_exit(1)") { fail("CLI returns nonzero when policy blocks"); }

print "PASS pbmigrate_cli";
