let A=import("stdlib:study_agenda.sapp");let S=import("stdlib:study_cards.sapp");let D=import("stdlib:civil_date.sapp");
let deck=S.create("Επανάληψη",[map{prompt:"Α",answer:"Πρώτο"},map{prompt:"Β",answer:"Δεύτερο"},map{prompt:"Γ",answer:"Τρίτο"},map{prompt:"Δ",answer:"Τέταρτο"}],"2024-02-28");
deck.cards[0].id=64;deck.cards[1].id=12;deck.cards[2].id=8;deck.cards[3].id=2;
deck.cards[1].due="2024-02-29";deck.cards[2].due="2024-03-01";deck.cards[3].due="2024-03-05";
let original=S.encode(deck);let plan=A.plan(deck,"2024-02-29",2);
assert(plan.overdue==1 and plan.later==1 and plan.total_cards==4,"partition of stored dates");assert(plan.entries==[map{date:"2024-02-29",scheduled:1,due_by:2},map{date:"2024-03-01",scheduled:1,due_by:3}],"leap-day and cumulative backlog");
assert(plan.assumes_no_reviews and not plan.contains_card_text and not plan.safe_to_log,"honest metadata contract");assert(not str_contains(json_stringify(plan),"Πρώτο") and not str_contains(json_stringify(plan),"Επανάληψη"),"report excludes content/title");
let selected=A.select_due(deck,"2024-02-29");assert(selected.cards==[deck.cards[0],deck.cards[1]] and selected.title==deck.title,"sparse IDs preserved in due order");selected.cards[0].answer="Changed";assert(S.encode(deck)==original,"detached selection");
let reviewed=S.review(deck,64,"good","2024-02-28");let due=A.select_due(reviewed,"2024-02-29");assert(due.cards[0].id==64 and due.cards[0].reviews==1 and due.cards[0].last_review=="2024-02-28","progress and stable ties retained");
assert((try A.select_due(deck,"2024-01-01") catch nil)==nil,"no empty deck fabricated");
for days in [0,32,-1,1.5,true,nil,"7"] {assert((try A.plan(deck,"2024-02-29",days) catch nil)==nil,"invalid horizon");}
for date in ["2023-02-29","2024-2-29","0000-01-01",nil] {assert((try A.plan(deck,date) catch nil)==nil,"invalid dates");}
assert(A.plan(deck,"9999-12-31",1).overdue==4,"final civil day");assert((try A.plan(deck,"9999-12-31",2) catch nil)==nil,"calendar overflow");assert(A.plan(deck,"0001-01-01",1).later==4,"first civil day");
let pairs=[];for i in range(0,64) {array_push(pairs,map{prompt:str(i),answer:"Answer"});}let maximum=S.create("Maximum",pairs,"2026-01-01");for i in range(0,64) {maximum.cards[i].due=D.add_days("2026-01-01",i-10);}
let report=A.plan(maximum,"2026-01-01",31);assert(report.overdue==10 and report.later==23 and len(report.entries)==31,"maximum deck/horizon");
for entry in report.entries {let scheduled=0;let backlog=0;for card in maximum.cards {if card.due==entry.date {scheduled=scheduled+1;}if D.ordinal(card.due)<=D.ordinal(entry.date) {backlog=backlog+1;}}assert(entry.scheduled==scheduled and entry.due_by==backlog,"independent per-day oracle");}
assert(S.encode(deck)==original,"planning unchanged");print "study_agenda_pass";
