let F = import("stdlib:compiler/selfhost_frontend.sapp");
let V = import("stdlib:compiler/vm.sapp");
fn expect(ok, message) { if not ok { throw "FAIL match-scope: " + message; } }
fn run(source) {
    let compiled = F.frontend_compile(source);
    expect(compiled.ok and len(compiled.diagnostics) == 0, "fixture passes checked compilation");
    let plain = V.run_bounded(compiled.chunk, map{ max_steps: 4000, max_frames: 12 });
    let optimized = F.frontend_run_bounded(source, map{ max_steps: 4000, max_frames: 12 });
    expect(optimized.ok and plain.globals.result == optimized.globals.result, "plain and optimized scope agree");
    return plain.globals.result;
}
expect(run("let n = 99; let result = match 2 { case n if false: n; else: n; };") == 99, "failed binding does not capture default");
expect(run("let n = 99; let result = match 2 { case n if false: n; case 2 if n == 99: n; else: 0; };") == 99, "later literal guard and body see outer name");
expect(run("let n = 99; let result = match 2 { case n if false: n; case _ if n == 99: n; else: 0; };") == 99, "wildcard does not inherit previous binding");
expect(run("let n = 99; let result = match 2 { case n if false: n; case m if m == 2: n + m; else: 0; };") == 101, "different bind names are isolated");
expect(run("let n = 99; let result = match 2 { case n if false: n; case n if n == 2: n; else: n; };") == 2, "repeated binder shadows outer only in its own arm");
expect(run("fn outer(n) { let value = match 2 { case n if false: n; else: n; }; return [value, n]; } let result = outer(99);") == [99, 99], "local parameter restored for default and after match");
expect(run("let __match_scrut = 99; let result = match 2 { case n if __match_scrut == 99: __match_scrut; else: 0; };") == 99, "temporary slot cannot capture source identifier");
expect(run("let __match_scrut = 99; let result = match 2 { case __match_scrut if false: __match_scrut; else: __match_scrut; };") == 99, "former helper name is a valid scoped binder");
expect(run("let __match_scrut = 7; let result = match __match_scrut { case n if n == 7: n + __match_scrut; else: 0; };") == 14, "subject expression and body retain outer helper-like name");
expect(run("let result = match 2 { case n: (match 3 { case n if false: n; else: n; }); };") == 2, "nested fallback sees enclosing arm binding");
expect(run("let n = 99; let f = match 2 { case n: (fn() { return n; }); }; let result = [f(), n];") == [2, 99], "selected closure keeps its bound slot");
expect(run("let n = 99; let f = match 2 { case n if false: (fn() { return n; }); else: fn() { return n; }; }; let result = f();") == 99, "fallback closure captures outer binding");
expect(run("fn collect() { let out = []; for i 3 { let f = match i { case n: (fn() { return n; }); }; array_push(out, f); } return [out[0](), out[1](), out[2]()]; } let result = collect();") == [0, 1, 2], "closure capture remains stable across iterations");
expect(run("let a = match 1 { case n: n; }; let b = match 2 { case n: n; }; let result = [a, b];") == [1, 2], "sibling matches retain separate slots");
expect(run("let π = 99; let result = match 2 { case π if false: π; else: π; };") == 99, "Unicode binding follows the same lexical rule");
// `match (` is currently parsed as a call to the contextual name `match`.
expect(run("let result = match match 2 { case n: n + 1; } { case m: m + 1; };") == 4, "nested subject reserves distinct storage");
expect(run("fn outer(__match_scrut) { let f = match 2 { case n: (fn() { return n + __match_scrut; }); }; return f(); } let result = outer(99);") == 101, "closure captures both binder and outer helper-like name");
let bad = F.frontend_compile("let result = match 2 { case n if false: n; else: n; };");
expect(not bad.ok, "missing outer binding remains a real diagnostic");
print "selfhost_match_scope_pass";
