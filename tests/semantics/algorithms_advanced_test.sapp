let algo = import("stdlib/algorithms_advanced.sapp");

fn eq(actual, expected, label) {
    if actual != expected {
        throw "FAIL " + label + ": got=" + str(actual) + " expected=" + str(expected);
    }
}

eq(algo.binary_search([1, 3, 5, 7], 5), 2, "binary search hit");
eq(algo.binary_search([1, 3, 5, 7], 2), -1, "binary search miss");

let quick = algo.quick_sort([5, 1, 4, 2, 3]);
let merged = algo.merge_sort([8, 3, 7, 1, 2]);
eq(str(quick), "[1, 2, 3, 4, 5]", "quick sort");
eq(str(merged), "[1, 2, 3, 7, 8]", "merge sort");
eq(str(algo.quick_sort([3, 3, 1, 3, 2, 1])), "[1, 1, 2, 3, 3, 3]", "three-way duplicate sort");
eq(algo.levenshtein("kitten", "sitting"), 3, "Levenshtein distance");
eq(len(algo.lcs("ABCBDAB", "BDCABA")), 4, "LCS length");

let graph = map{
    A: ["B", "C"],
    B: ["D"],
    C: ["D"],
    D: ["A"]
};
eq(str(algo.bfs(graph, "A")), "[A, B, C, D]", "BFS order and cycle handling");
eq(str(algo.dfs(graph, "A")), "[A, B, D, C]", "DFS preorder and cycle handling");

// A referenced leaf does not need a redundant empty adjacency entry.
eq(str(algo.bfs(map{root: ["leaf"]}, "root")), "[root, leaf]", "BFS missing leaf adjacency");
eq(str(algo.dfs(map{root: ["leaf"]}, "root")), "[root, leaf]", "DFS missing leaf adjacency");

let chain = map{};
let ci = 0;
while ci < 512 { chain[str(ci)] = [str(ci + 1)]; ci = ci + 1; }
let deep_dfs = algo.dfs(chain, "0");
eq(len(deep_dfs), 513, "iterative DFS depth");
eq(deep_dfs[512], "512", "iterative DFS reaches final leaf");

eq(algo.fibonacci_dp(10), 55, "dynamic-programming Fibonacci");
eq(algo.knapsack_01([1, 3, 4, 5], [1, 4, 5, 7], 7), 9, "0/1 knapsack");
eq(try algo.knapsack_01([1], [], 2) catch "caught", "caught", "knapsack length validation");
eq(try algo.knapsack_01([1], [2], 1.5) catch "caught", "caught", "knapsack capacity validation");

let weighted = map{
    A: [map{to: "B", weight: 10}, map{to: "C", weight: 1}],
    B: [],
    C: [map{to: "B", weight: 1}]
};
let dist = algo.dijkstra(weighted, "A");
eq(dist.A, 0, "Dijkstra source distance");
eq(dist.B, 2, "Dijkstra relaxes a previously discovered node");
eq(dist.C, 1, "Dijkstra direct distance");

let negative = try algo.dijkstra(map{A: [map{to: "B", weight: -1}]}, "A") catch "caught";
eq(negative, "caught", "Dijkstra rejects negative edge weights");
let malformed = try algo.dijkstra(map{A: [map{to: "B"}]}, "A") catch "caught";
eq(malformed, "caught", "Dijkstra rejects malformed edges");

print "algorithms_advanced_pass";
