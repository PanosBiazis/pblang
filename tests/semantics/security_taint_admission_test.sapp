let T=import("stdlib:security_taint.sapp");
fn expect(ok,label) {if not ok {throw "FAIL taint-admission: "+label;}}
let cases=[
    map{name:"max_taint_findings",min:1,max:2048},
    map{name:"max_taint_steps",min:100,max:2000000},
    map{name:"max_call_expansions",min:1,max:200000}
];
let invalid=[parse_number("NaN"),parse_number("inf"),parse_number("-inf"),
    nil,true,"100","taint-private-option-marker",[],map{},fn(){return 1;},
    bigint(100),rational("100/1"),decimal("100")];
for item in cases {
    let values=[];for value in invalid {push(values,value);}
    push(values,item.min-1);push(values,item.max+1);push(values,item.min+0.5);
    for value in values {
        let options=map{};options[item.name]=value;
        let report=T.analyze("let value=1;","fixture.sapp",options);
        expect(not report.ok and not report.passed,"invalid budget rejected");
        expect(not str_contains(json_stringify(report),"taint-private-option-marker"),"invalid option not echoed");
    }
    for value in [item.min,item.max] {
        let options=map{};options[item.name]=value;
        let report=T.analyze("let value=1;","fixture.sapp",options);
        expect(report.ok and report.passed and report.interprocedural_complete,"valid boundary accepted");
    }
}
expect(T.analyze("let value=1;").passed,"omitted budgets retain defaults");
for source in ["let text=\"private-unclosed-token","let value=1; /* private-unclosed-token"] {
    let report=T.analyze(source,"fixture.sapp");
    expect(not report.ok and not report.passed,"unterminated lexical input rejected");
    expect(not str_contains(json_stringify(report),"private-unclosed-token"),"lexical failure does not echo source");
}
print "security_taint_admission_pass";
