// Test: iter.sapp module
import "stdlib:iter.sapp";

// from_array + collect
let it1 = iter.from_array([1, 2, 3]);
let a1 = iter.collect(it1);
if len(a1) != 3 { throw "FAIL collect length"; }
if a1[0] != 1 { throw "FAIL collect[0]"; }
if a1[2] != 3 { throw "FAIL collect[2]"; }

// map_iter
let it2 = iter.from_array([1, 2, 3]);
let doubled = iter.collect(iter.map_iter(it2, fn(x) { return x * 2; }));
if doubled[0] != 2 { throw "FAIL map_iter[0]"; }
if doubled[2] != 6 { throw "FAIL map_iter[2]"; }

// filter_iter
let it3 = iter.from_array([1, 2, 3, 4, 5]);
let evens = iter.collect(iter.filter_iter(it3, fn(x) { return num_mod(x, 2) == 0; }));
if len(evens) != 2 { throw "FAIL filter_iter length"; }

// take
let it4 = iter.from_array([10, 20, 30, 40, 50]);
let taken = iter.collect(iter.take(it4, 3));
if len(taken) != 3 { throw "FAIL take length"; }
if taken[2] != 30 { throw "FAIL take[2]"; }

// skip
let it5 = iter.from_array([1, 2, 3, 4, 5]);
let skipped = iter.collect(iter.skip(it5, 2));
if len(skipped) != 3 { throw "FAIL skip length"; }
if skipped[0] != 3 { throw "FAIL skip[0]"; }

// from_range
let it6 = iter.from_range(0, 5, 1);
let range_arr = iter.collect(it6);
if len(range_arr) != 5 { throw "FAIL from_range length"; }
if range_arr[0] != 0 { throw "FAIL from_range[0]"; }
if range_arr[4] != 4 { throw "FAIL from_range[4]"; }

// enumerate
let it7 = iter.from_array(["a", "b", "c"]);
let pairs = iter.collect(iter.enumerate(it7));
if pairs[0][0] != 0 { throw "FAIL enumerate index 0"; }
if pairs[1][1] != "b" { throw "FAIL enumerate value 1"; }

// reduce_iter
let it8 = iter.from_array([1, 2, 3, 4]);
let total = iter.reduce_iter(it8, fn(acc, x) { return acc + x; }, 0);
if total != 10 { throw "FAIL reduce_iter"; }

// any_iter
let it9 = iter.from_array([1, 2, 3]);
if iter.any_iter(it9, fn(x) { return x == 2; }) == false { throw "FAIL any_iter true"; }
let it10 = iter.from_array([1, 3, 5]);
if iter.any_iter(it10, fn(x) { return x == 2; }) != false { throw "FAIL any_iter false"; }

// chain
let it11 = iter.chain(iter.from_array([1, 2]), iter.from_array([3, 4]));
let chained = iter.collect(it11);
if len(chained) != 4 { throw "FAIL chain length"; }
if chained[3] != 4 { throw "FAIL chain[3]"; }

print "iter_stdlib_pass";
