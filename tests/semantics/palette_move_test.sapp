let P=import("stdlib:palette_document.sapp");let Old=import("../../bench/fixtures/palette_document_before_strip.sapp");let C=import("stdlib:colors.sapp");let V=import("stdlib:palette_view.sapp");let UI=import("stdlib:modern_ui.sapp");let G=import("stdlib:gui.sapp");
let cases=0;let hexes=["#000000","#ffffff","#123456","#abcdef","#777777","#7357e8","#00ff00","#ff0000"];
for size in range(1,9){let doc=P.create("Ordered palette");for i in range(1,size){doc=P.append(doc,"Color "+str(i),hexes[i]);}let before=P.encode(doc);assert(P.strip(doc)==Old.strip(doc),"exact previous pixels");
 for source in range(0,size){for target in range(0,size){let moved=P.move_swatch(doc,source,target);let expected=[];for i in range(0,size){if i!=source{array_push(expected,doc.swatches[i]);}}let final=[];let offset=0;for i in range(0,size){if i==target{array_push(final,doc.swatches[source]);} else {array_push(final,expected[offset]);offset=offset+1;}}
  assert(moved.swatches==final and moved.title==doc.title and moved.background==doc.background,"stable move contract");assert(P.encode(doc)==before,"source unchanged");assert(P.move_swatch(moved,target,source)==doc,"inverse move");assert(P.decode(P.encode(moved))==moved,"saved order roundtrip");cases=cases+1;
  moved.swatches[0].label="Changed";assert(P.encode(doc)==before,"all output swatches detached");
 }}
 let image=P.strip(doc);image[0][0][0]=99;assert(image[0][1][0]==0 and image[1][0][0]==0,"pixels and rows independent");assert(P.encode(doc)==before,"strip does not mutate source");
}
let doc=P.append(P.create(),"Accent","#f00");for bad in [-1,2,0.5,"0",nil,true]{assert((try P.move_swatch(doc,bad,0) catch nil)==nil,"bad source");assert((try P.move_swatch(doc,0,bad) catch nil)==nil,"bad target");}
assert((try P.move_swatch(map{},0,0) catch nil)==nil,"invalid document");let moved=P.move_swatch(doc,1,0);assert(P.to_sheet(moved).cells[1][1]=="#ff0000","sheet order");assert(P.strip(moved)[0][0]==[255,0,0,255],"strip order");assert(P.analyze(moved)[0].hex=="#ff0000","analysis order");let expected_colors=[C.hex_checked("#ff0000"),C.hex_checked("#000000"),C.hex_checked(moved.background)];assert(P.matrix(moved)==C.contrast_matrix_checked(expected_colors),"matrix order");
let view=V.create(moved);for target in ["native","web","android"]{assert(len(UI.compile(view,map{target:target,width:412,height:915}).records)>0,"portable reordered reader");}let f=UI.build("Moved palette",view,map{width:412,height:915});assert(G.get(f,"detail_4").text=="Color: #ff0000","first moved reader color");G.get(f,"select_1").onclick(f);assert(G.get(f,"detail_4").text=="Color: #000000","second moved reader color");
print "palette_move_pass cases="+str(cases);
