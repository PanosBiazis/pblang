let logic = import("stdlib:logic.sapp");

let db = logic.db();
logic.fact(db, "parent", ["alice", "bob"]);
logic.fact(db, "parent", ["bob", "carol"]);
logic.fact(db, "parent", ["bob", "dave"]);
logic.fact(db, "likes", ["carol", "math"]);
logic.fact(db, "likes", ["dave", "music"]);

let X = logic.var("X");
let Y = logic.var("Y");
let Z = logic.var("Z");

let children = logic.ask(db, "parent", ["bob", X]);
let selected_children = logic.select(children, [X]);
assert(selected_children == [["carol"], ["dave"]], "fact query with variable");

logic.add_rule(db, logic.rule(
    logic.pred("grandparent", [X, Z]),
    [
        logic.pred("parent", [X, Y]),
        logic.pred("parent", [Y, Z]),
    ],
));

let grandparents = logic.ask(db, "grandparent", ["alice", X]);
let grandchild_names = logic.select(grandparents, [X]);
assert(grandchild_names == [["carol"], ["dave"]], "derived rule query");

let rows = logic.where(db, [
    logic.pred("parent", ["bob", X]),
    logic.pred("likes", [X, Y]),
]);
let pairs = logic.select(rows, [X, Y]);
assert(pairs == [["carol", "math"], ["dave", "music"]], "conjunctive query");

let first = logic.first(db, logic.pred("likes", [X, "math"]));
assert(first != nil, "first solution");
assert(logic.select([first], [X]) == [["carol"]], "first selected");

assert(logic.has_solution(db, logic.pred("parent", ["alice", "bob"])), "known fact");
assert(logic.has_solution(db, logic.pred("parent", ["carol", "alice"])) == false, "unknown fact");

print "logic_stdlib_pass";
