// tests/semantics/codegen_func_test.sapp — functions compile to native (x86-64): named
// subroutines with call/ret, resolved by a relocation pass. Run-verified by exit code.

let X = import("stdlib/codegen_x64.sapp");

fn fail(m) { throw "FAIL " + m; }

fn run_rc(elf, tag) {
    let path = "pbfn_" + tag + ".bin";
    fs_write_bytes(path, elf);
    let r = proc_spawn_wait("bash", ["-c", "chmod +x " + path + " && ./" + path + "; rc=$?; rm -f " + path + "; echo RC=$rc"]);
    let out = try r.stdout catch "";
    let idx = str_index_of(out, "RC=");
    return parse_number(str_trim(str_slice(out, idx + 3, len(out))));
}
fn eqrc(elf, want, tag) { let g = run_rc(elf, tag); if g != want { fail(tag + " got " + str(g) + " want " + str(want)); } }

// "double": r0 += r0 ; ret. main: r0=21; call double -> 42
let funcs = [map{ name: "double", body: [["add", 0, 0]] }];
eqrc(X.compile_unit(funcs, [["seti", 0, 21], ["call", "double"]]), 42, "call_once");

// calling it twice: 10 -> 20 -> 40
eqrc(X.compile_unit(funcs, [["seti", 0, 10], ["call", "double"], ["call", "double"]]), 40, "call_twice");

// call inside a conditional (fixup must thread through ifnz)
let f2 = [map{ name: "set42", body: [["seti", 0, 42]] }];
eqrc(X.compile_unit(f2, [["seti", 0, 0], ["seti", 1, 1], ["ifnz", 1, [["call", "set42"]], [["seti", 0, 7]]]]), 42, "call_in_then");
eqrc(X.compile_unit(f2, [["seti", 0, 0], ["seti", 1, 0], ["ifnz", 1, [["call", "set42"]], [["seti", 0, 7]]]]), 7, "else_no_call");

// one function calling another
let chain = [
    map{ name: "inc", body: [["addi", 0, 1]] },
    map{ name: "inc2", body: [["call", "inc"], ["call", "inc"]] }
];
eqrc(X.compile_unit(chain, [["seti", 0, 40], ["call", "inc2"]]), 42, "fn_calls_fn");

// undefined function is rejected
let threw = false;
let r = try X.compile_unit([], [["call", "nope"]]) catch nil;
if r == nil { threw = true; }
if not threw { fail("undefined call must be rejected"); }

print "codegen_func_pass";
