// Raw AST consumers must never compile a valid prefix of a numerically invalid source.
let T=import("stdlib:compiler/tokenizer.sapp");
let P=import("stdlib:compiler/parser.sapp");
let W=import("stdlib:codegen_wasm.sapp");
let A=import("stdlib:codegen_arm64_ast.sapp");
let sources=["fn f(x=0x){return 1;} return f(2);","let x:0x=1;return x;",
    "fn main():0x{return 7;}","export 0x;","let 0x=1;","import 0x;","fn 0x(){return 1;}",
    "let good=1; export 0x; let later=2;","fn main(){return 7;} export 0x;",
    "let before=1; let bad=1e2name; let after=2;", "fn main(){let bad=123name;return 7;}"];
for source in sources {
    let parsed=P.parse(T.tokenize(source));
    assert(len(parsed.stmts)==0 and len(parsed.errors)==1
        and str_starts_with(parsed.errors[0],"invalid number literal at line 1:"),"no partial AST in expression or name positions");
    assert((try {W.compile_wasm(source);false;} catch true),"WASM emits no partial module");
    assert((try {A.compile_ast(source);false;} catch true),"ARM64 emits no partial program");
    let clean=P.parse(T.tokenize("let good=1;"));
    assert(len(clean.errors)==0 and len(clean.stmts)==1,"failure does not poison subsequent parser state");
}
let first=P.parse(T.tokenize("\n  0x; 1e+;"));
assert(first.errors==["invalid number literal at line 2:3"] and len(first.stmts)==0,"first lexical error is deterministic and bounded");
let forged=T.tokenize("0x;");forged[0].text="private_canary";
assert(not str_contains(json_stringify(P.parse(forged)),"private_canary"),"parser uses fixed diagnostic, not invalid token payload");
let ordinary=P.parse(T.tokenize("let valid=1; let broken=;"));
assert(len(ordinary.errors)>0 and len(ordinary.stmts)>0,"ordinary syntax recovery unchanged");
let wasm=W.compile_wasm("return 7;");let arm=A.compile_ast("return 7;");
assert(len(wasm)>8 and wasm[0]==0 and wasm[1]==97 and wasm[2]==115 and wasm[3]==109
    and len(arm)>0,"valid code still reaches both backends");
print "selfhost_invalid_ast_pass";
