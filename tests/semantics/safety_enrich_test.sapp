// tests/semantics/safety_enrich_test.sapp — fix + enrichment for stdlib/safety.sapp
//
// FIX: coerce_number's `if n == nil` was dead code — parse_number THROWS on bad
//   input, so it never returned nil. Now guarded with try/catch. ENRICH: try_number
//   (non-throwing), unwrap_or, and Result helpers (ok/err/is_ok/unwrap_result).

let s = import("stdlib/safety.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base still works ─────────────────────────────────────────────────────────────
eq(s.bounds_check([10, 20], 1), 20, "bounds_check"); eq(s.clamp(15, 0, 10), 10, "clamp");
eq(s.coerce_number("42", "x"), 42, "coerce_number good");

// ── ENRICH: try_number (non-throwing) ────────────────────────────────────────────
eq(s.try_number("42"), 42, "try_number numeric string");
eq(s.try_number(3.5), 3.5, "try_number passthrough number");
eq(s.try_number("abc"), nil, "try_number bad -> nil (no throw)");

// ── ENRICH: unwrap_or ────────────────────────────────────────────────────────────
eq(s.unwrap_or(nil, 9), 9, "unwrap_or nil -> default");
eq(s.unwrap_or(5, 9), 5, "unwrap_or value");

// ── ENRICH: Result helpers ───────────────────────────────────────────────────────
eq(s.is_ok(s.ok(7)), true, "ok is_ok"); eq(s.is_ok(s.err("bad")), false, "err not ok");
eq(s.ok(7).value, 7, "ok carries value"); eq(s.err("bad").error, "bad", "err carries error");
eq(s.unwrap_result(s.ok(7), 0 - 1), 7, "unwrap_result ok -> value");
eq(s.unwrap_result(s.err("bad"), 0 - 1), 0 - 1, "unwrap_result err -> default");

print "safety_enrich_pass";
