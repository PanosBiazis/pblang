let T=import("stdlib:table_transform.sapp");let Sheet=import("stdlib:sheet_document.sapp");let CSV=import("stdlib:sheet_csv.sapp");
fn rejects(f) {let bad=false;try {f();} catch {bad=true;}assert(bad,"invalid pipeline rejected");}
let source=CSV.decode(" label ,value\n β ,2\nα,10\n β ,2\nother,3");let original=Sheet.encode(source);
let steps=[map{op:"trim"},map{op:"deduplicate"},map{op:"filter",column:0,query:""},map{op:"select",columns:[1,0]},map{op:"sort",column:0,descending:false}];
let result=T.apply(source,steps,true);
assert(result.cells==[["value"," label "],["10","α"],["2","β"],["3","other"]],"combined pipeline preserves semantics");
result.cells[0][0]="changed";result.cells[1][1]="changed";
assert(Sheet.encode(source)==original,"pipeline never exposes input rows");
let no_steps=T.apply(source,[],true);no_steps.cells[1][0]="changed";assert(Sheet.encode(source)==original,"empty pipeline detaches too");
let repeated=[];for i in range(0,16) {array_push(repeated,map{op:"trim"});}
assert(T.apply(source,repeated,true)==T.trim_cells(source,true),"maximum steps keep valid model");
let bad=[map{op:"bad"},map{op:"select",columns:[8]},map{op:"select",columns:[0,0]},map{op:"sort",column:0,descending:1},map{op:"filter",column:1,query:str_repeat("é",129)},map{op:"trim",extra:true}];
for step in bad {
    rejects(fn(){T.apply(source,[map{op:"trim"},step],true);});
    assert(Sheet.encode(source)==original,"failure after private mutation leaves source intact");
}
let aliased=[" α ","1"];let shared=map{format:Sheet.FORMAT,cells:[aliased,aliased]};
let detached=T.apply(shared,[map{op:"trim"}]);detached.cells[0][0]="change";
assert(detached.cells[1][0]=="α" and aliased[0]==" α ","shared input row aliases are detached separately");
let header=CSV.decode("a,b");assert(T.apply(header,steps,true).cells==[["b","a"]],"header-only pipeline");
let max=Sheet.create(32,8);for r in range(0,32) {for c in range(0,8) {max.cells[r][c]=str_repeat("é",16);}}
let limit=T.apply(max,[map{op:"trim"},map{op:"deduplicate"}]);assert(len(limit.cells)==1 and Sheet.validate(limit).text_bytes==256,"maximum UTF-8 input remains valid");
rejects(fn(){T.apply(map{format:Sheet.FORMAT,cells:[["a"],["a","b"]]},[map{op:"trim"}]);});
print "table_pipeline_ownership_pass";
