// tests/semantics/pbai_enrich2_test.sapp — wave 2 for stdlib/pbai.sapp (intent ranking)

let AI = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let prompt = "fix this bug in my pblang code";

// ── top_intents: ranked, descending, valid intent names ───────────────────────────
let tp = AI.top_intents(prompt, 3);
eq(len(tp), 3, "top 3");
if tp[0].score < tp[1].score { fail("sorted desc 0>=1"); }
if tp[1].score < tp[2].score { fail("sorted desc 1>=2"); }
if not AI.is_intent(tp[0].intent) { fail("top intent is a real intent"); }

// the #1 ranked intent equals the classifier's argmax pick
eq(tp[0].intent, AI.intents()[AI.classify(prompt)], "top_intents[0] == classify()");

// k larger than #intents clamps to all
let all = AI.top_intents(prompt, 999);
eq(len(all), len(AI.intents()), "k clamps to number of intents");

// ── is_intent ─────────────────────────────────────────────────────────────────────
if not AI.is_intent(AI.intents()[0]) { fail("known intent"); }
if AI.is_intent("definitely_not_an_intent") { fail("unknown intent -> false"); }

print "pbai_enrich2_pass";
