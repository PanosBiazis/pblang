// tests/semantics/pbai_llm_voter_test.sapp — a REAL external-LLM voter. llm_voter() builds a
// voter fn that asks an external model (via provider_registry -> ollama / OpenAI-compatible
// endpoint) to classify the request, then maps its free-text reply onto a pbAI intent. The
// HTTP transport is injectable so the parse/map/abstain logic is tested without a network.

let pbai = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let p = "please add explanatory comments to this function";

// ── the voter maps the model's reply onto an intent, weighted into the ensemble ────────
// A fake transport standing in for the HTTP call to the external model.
let say_bugs = fn(msg) { return "This looks like a BUGS request."; };
let v = pbai.llm_voter("mymodel", nil, say_bugs);
let r = v(p);
if not map_has(r, "intent") { fail("voter returns {intent,...}"); }
eq(r.intent, "bugs", "voter parses the model reply to an intent");

// exact one-word reply -> higher confidence than a chatty reply
let one_word = pbai.llm_voter("m", nil, fn(msg) { return "improve"; });
let chatty = pbai.llm_voter("m", nil, fn(msg) { return "I think you should improve it"; });
if one_word(p).confidence <= chatty(p).confidence { fail("exact reply should be more confident"); }

// ── unparseable reply -> abstain (nil), so the ensemble ignores it ─────────────────────
let junk = pbai.llm_voter("m", nil, fn(msg) { return "hello there friend"; });
eq(junk(p), nil, "unparseable reply abstains");

// ── transport error / unavailable provider -> abstain gracefully ──────────────────────
let broken = pbai.llm_voter("m", nil, fn(msg) { throw "connection refused"; });
eq(broken(p), nil, "transport failure abstains, never crashes");

// ── default transport with NO provider registered -> abstains (no network needed) ──────
let PR = import("stdlib/provider_registry.sapp");
PR.clear();
let real = pbai.llm_voter("does-not-exist");
eq(real(p), nil, "no configured provider -> abstain");

// ── it plugs into the real ensemble and actually votes ────────────────────────────────
pbai.clear_voters();
pbai.register_voter_weighted("llm-bugs", pbai.llm_voter("m", nil, fn(msg) { return "bugs"; }), 5);
eq(pbai.ensemble(p), "bugs", "a strong LLM voter swings the ensemble");
pbai.clear_voters();

print "pbai_llm_voter_pass";
