let ms = import("stdlib:math_symbols.sapp");

assert(ms.has_symbol("π × r^2"), "has_symbol detects mathematical notation");

let expr = ms.normalize_expr("π × r^2 ≤ τ ∧ √(x) ≠ ∞");
assert(str_contains(expr, "PI * r**2 <= TAU"), "normalize_expr converts constants/operators/power");
assert(str_contains(expr, "and"), "normalize_expr converts logical and");
assert(str_contains(expr, "num_sqrt(x)"), "normalize_expr converts sqrt");
assert(str_contains(expr, "!=") and str_contains(expr, "(1 / 0)"), "normalize_expr converts inequality/infinity");

let code = ms.normalize_code("let area = π × r × r;\nif area ≥ 10 ∧ area ≠ ∞ { print(area); }");
assert(str_contains(code, "let area = PI * r * r;"), "normalize_code converts math constants/operators");
assert(str_contains(code, "area >= 10  and  area != (1 / 0)"), "normalize_code converts comparisons/logic");
assert(not str_contains(code, "×"), "normalize_code removes multiplication symbol");

let shortcuts = ms.shortcuts();
assert(shortcuts.PI > 3 and shortcuts.sqrt(9) == 3, "math shortcuts expose constants/functions");
assert(shortcuts.product([2, 3, 4]) == 24, "math shortcuts expose product function");
assert(ms.expand_shortcut("\\pi") == "π", "compose shortcut expands pi");
assert(ms.expand_shortcut("\\Pi") == "∏", "compose shortcut expands capital Pi as product");
assert(ms.expand_shortcut("\\prod") == "∏", "compose shortcut expands product");
assert(ms.expand_shortcut("\\GreekPi") == "Π", "compose shortcut expands Greek capital pi");
assert(ms.expand_shortcut("\\sqrt") == "√", "compose shortcut expands sqrt");
assert(ms.expand_shortcut("\\Omega") == "Ω", "compose shortcut expands uppercase omega");
assert(ms.expand_shortcut("\\right") == "→", "compose shortcut expands right arrow");
assert(ms.expand_shortcut("\\unknown") == nil, "unknown compose shortcut returns nil");

let pi = ms.explain_symbol("π");
assert(pi.ascii == "PI" and pi.kind == "constant", "explain_symbol returns metadata");
let prod = ms.explain_symbol("∏");
assert(prod.ascii == "product" and prod.kind == "function", "explain_symbol returns product metadata");

let prod_expr = ms.normalize_expr("Π([2, 3, 4]) == ∏([1, 2, 3])");
assert(str_contains(prod_expr, "product([2, 3, 4])"), "normalize_expr converts uppercase pi to product");
assert(str_contains(prod_expr, "product([1, 2, 3])"), "normalize_expr converts product symbol");

print "math_symbols_pass";
