if platform()!="linux" {print "native_lifecycle_cli_skip_linux_required";os_exit(0);}
let UUID=import("stdlib:uuid.sapp");
let runtime=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let base=path_join(cwd(),".native_lifecycle_cli_"+UUID.v4());
let source=base+".sapp";let output=base+".pbck";let resource=base+".owned";
fn compile(flags) {
    let args=["-k","1s","20s",runtime,"run","tools/pbc.sapp","--allow-all","--",source,"--out",output];
    for flag in flags {push(args,flag);}
    return proc_spawn_wait("/usr/bin/timeout",args);
}
fn execute(permission="--sandbox") {return proc_spawn_wait("/usr/bin/timeout",["-k","1s","5s",runtime,"run",output,permission]);}
let flags=["--target","pbck","--initialize","init","--entry","work","--cleanup","release"];
fn exercise() {
    fs_write(output,"old artifact");
    for invalid in [["--initialize","init"],["--target","pbck","--initialize"],
        ["--target","pbck","--initialize","init","--entry","work"],
        ["--target","pbck","--initialize","init","--cleanup","release"],
        ["--target","wasm","--initialize","init","--entry","work","--cleanup","release"],
        ["--target","pbck","--bundle","--initialize","init","--entry","work","--cleanup","release"],
        ["--target","pbck","--initialize","init","--initialize","again","--entry","work","--cleanup","release"]] {
        assert(compile(invalid).exit_code==2,"invalid options fail before missing source read");
        assert(fs_read(output)=="old artifact","option failure preserves output");
    }
    fs_write(source,"let owned=[];fn init(){push(owned,7);}fn work(){for i 1 {let p=map{run:fn(self){return owned[0];}};print (try {p:run()} catch 9);}}fn release(){array_pop(owned);print len(owned);}");
    let original=fs_read(source);assert(compile(flags).exit_code==0,"lifecycle CLI compiles");
    let result=execute();assert(result.exit_code==0 and result.stdout=="7\n0\n","nested method and release");
    assert(fs_read(source)==original,"source unchanged");
    // Real file ownership: partial initialization is cleaned; entry never runs.
    let literal=json_stringify(resource);
    fs_write(source,"fn init(){fs_write("+literal+",\"owned\");throw \"INITIAL\";}fn work(){print \"WRONG\";}fn release(){fs_remove("+literal+");print \"CLEAN\";throw \"SECONDARY\";}");
    assert(compile(flags).exit_code==0 and not fs_exists(resource),"compilation never executes initialization");
    result=execute("--allow-all");assert(result.exit_code!=0 and result.stdout=="CLEAN\n" and str_contains(result.stderr,"INITIAL") and not str_contains(result.stderr,"SECONDARY"),"initial error retained after cleanup failure");
    assert(not fs_exists(resource),"owned file actually released");
    // Capability denial occurs in initialization and still reaches cleanup.
    fs_write(source,"fn init(){fs_read(\"private_canary\");}fn work(){print \"WRONG\";}fn release(){print \"CLEAN\";}");
    assert(compile(flags).exit_code==0,"denied operation compiles");result=execute();
    assert(result.exit_code!=0 and result.stdout=="CLEAN\n" and str_contains(result.stderr,"fs access denied"),"permissions remain separate");
    fs_write(output,"old artifact");
    for invalid in ["fn init(x){}fn work(){}fn release(){}","fn init(){}fn work(){}fn release(){} /* private_canary","fn init(){}fn work(){}fn release(){} // __pb_lifecycle_secret"] {
        fs_write(source,invalid);result=compile(flags);
        assert(result.exit_code!=0 and fs_read(output)=="old artifact","compile failure preserves artifact");
        assert(not str_contains(result.stderr,"private_canary") and not str_contains(result.stderr,"__pb_lifecycle_secret"),"fixed diagnostics protect source text");
    }
}
let passed=try {exercise();true} catch false;
for path in [source,output,resource] {try fs_remove(path) catch nil;}
assert(passed,"native lifecycle CLI regression");print "native_lifecycle_cli_pass";
