// tests/semantics/selfhost_parser_depth_test.sapp
//
// The self-hosted parser must bound expression-nesting recursion: a
// pathologically deep expression should produce a CLEAN recorded error (parity
// with the Rust frontend's MAX_NESTING_DEPTH), not recurse until the VM's stack
// limit throws an uncatchable-by-contract exception out of frontend_parse_full.
// And frontend_parse_full's `ok` must be false when there are parse errors.

let fe = import("stdlib/compiler/selfhost_frontend.sapp");

fn fail(m) { throw "FAIL " + m; }
fn rep(s, n) { let out = ""; let i = 0; while i < n { out = out + s; i = i + 1; } return out; }
fn has_err(r, needle) {
    for e in r.errors { if str_contains(e, needle) { return true; } }
    return false;
}

// Deeply nested parens: must return gracefully (no throw out of parse_full) with
// a nesting-depth error and ok=false.
let depth = 1500;
let src = "let x = " + rep("(", depth) + "1" + rep(")", depth) + ";";
let r = fe.frontend_parse_full(src); // must NOT throw
if r.ok { fail("deeply nested expression must not parse as ok"); }
if not (has_err(r, "deeply nested") or has_err(r, "too deep")) {
    fail("must report a nesting-depth error");
}

// `ok` must reflect parse errors (was true even for broken input).
let bad = fe.frontend_parse_full("fn f() {"); // unclosed block
if bad.ok { fail("unclosed block must make ok false"); }

// Normal (shallow) nested expressions must still parse cleanly.
let good = fe.frontend_parse_full("let y = ((1 + 2) * 3); print y;");
if not good.ok { fail("normal nested expression must parse ok"); }
if len(good.errors) != 0 { fail("clean source must have no errors"); }

print "selfhost_parser_depth_pass";
