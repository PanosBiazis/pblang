// tests/semantics/selfhost_loader_inspect_test.sapp
//
// loader.inspect_pbck(path) — introspect a .pbck artifact WITHOUT executing it
// (objdump-style). Returns { ok, bytes, instructions, constants, functions } with
// instruction/constant/function counts summed recursively over nested function
// bodies. Powers `pbrun --info` and lets the toolchain MEASURE artifacts — e.g.
// prove the optimizer shrinks a bundle structurally (fewer instructions), not
// just in bytes.

let fe     = import("stdlib/compiler/selfhost_frontend.sapp");
let pbck   = import("stdlib/selfhost_pbck.sapp");
let dist   = import("stdlib/dist.sapp");
let loader = import("stdlib/selfhost_loader.sapp");

fn fail(m) { throw "FAIL " + m; }
fn expect(c, m) { if not c { fail(m); } }

fn uniq(tag) { return "/tmp/pblins_" + tag + "_" + str(num_floor(now_ms())); }

// A program with a nested function so the recursive function count is exercised.
let cr = fe.frontend_compile("fn sq(x){ return x * x; } let v = sq(7); print v;");
expect(cr.ok, "compile ok");
let path = uniq("a") + ".pbck";
pbck.write_file(path, cr.chunk);

let info = loader.inspect_pbck(path);
expect(info.ok, "inspect_pbck ok on a valid file");
expect(info.bytes > 0, "reports byte size");
expect(info.instructions > 0, "reports a positive instruction count");
expect(info.constants > 0, "reports a positive constant count");
expect(info.functions >= 1, "counts the nested sq function");

// Inspecting must NOT execute the program (no observable run): it only reads
// structure. (If it ran, it would be via the VM; here we just trust the contract
// and confirm the counts are structural — the file still loads+runs separately.)
let res = loader.run_pbck(path);
expect(res.globals["v"] == 49, "the same artifact still runs: sq(7) == 49");
fs_remove(path);

// ── benchmark/optimization proof: the OPTIMIZED dist artifact has structurally
//    fewer instructions than the unoptimized bundle for foldable input. ─────────
let lib_path  = uniq("lib") + ".sapp";
let main_path = uniq("main") + ".sapp";
fs_write_bytes(lib_path, str_to_bytes("fn id(x){ return x; } export id;"));
fs_write_bytes(main_path, str_to_bytes("let m = import(\"" + lib_path + "\"); let k = 1 + 2 + 3 + 4 + 5; print m.id(k);"));

let opt_base   = uniq("opt");
let unopt_base = uniq("unopt");
let rep_opt   = dist.bundle_pbck(main_path, opt_base, map{ optimize: true });
let rep_unopt = dist.bundle_pbck(main_path, unopt_base, map{ optimize: false });
expect(rep_opt.ok and rep_unopt.ok, "both artifacts build");

let info_opt   = loader.inspect_pbck(rep_opt.out);
let info_unopt = loader.inspect_pbck(rep_unopt.out);
expect(info_opt.instructions < info_unopt.instructions, "optimized artifact has fewer instructions (constant folding)");
expect(info_opt.bytes < info_unopt.bytes, "optimized artifact is smaller on disk");

// and it still computes correctly
let r = loader.run_pbck(rep_opt.out);
expect(r.output[0] == 15, "optimized artifact prints 1+2+3+4+5 == 15");

fs_remove(lib_path); fs_remove(main_path);
fs_remove(rep_opt.out); fs_remove(rep_unopt.out);
print "selfhost_loader_inspect_pass";
