let b = import("stdlib/browser.sapp");
let html = "<html><head><title> My Page </title><style>x{color:red}</style></head><body><h1>Hi there</h1><script>var a=1;</script><a href=\"https://a.com\">A</a> <a href=\"/b\">B</a></body></html>";
assert(b.title(html) == "My Page", "title extraction");
let txt = b.strip_tags(html);
assert(str_contains(txt, "Hi there"), "text keeps visible content");
assert(not str_contains(txt, "var a"), "script content stripped");
assert(not str_contains(txt, "color:red"), "style content stripped");
let ls = b.links(html);
assert(len(ls) == 2, "two links extracted");
assert(ls[0] == "https://a.com", "first link correct");

// URL resolution — relative hrefs are absolutized against the page URL (engine work)
assert(b.resolve("http://site.com/a/b.html", "c.html") == "http://site.com/a/c.html", "relative path resolves against the directory");
assert(b.resolve("http://site.com/a/b.html", "/x") == "http://site.com/x", "root-relative resolves against the host");
assert(b.resolve("https://site.com/a/", "//cdn.com/y") == "https://cdn.com/y", "protocol-relative inherits the scheme");
assert(b.resolve("http://site.com/a/b", "https://other.com/z") == "https://other.com/z", "absolute href passes through");
assert(b.resolve("http://site.com/a/", "#frag") == "#frag", "fragment href is left alone");

// form parsing — action absolutized, method lowercased, fields extracted (both quotes)
let fhtml = "<form action='/login' method='POST'><input name=\"user\" value=\"alice\" type=\"text\"><input name='pw' type='password'><textarea name='bio'></textarea></form>";
let frms = b.forms("http://site.com/page/x", fhtml);
assert(len(frms) == 1, "one form parsed");
assert(frms[0].method == "post", "form method lowercased");
assert(frms[0].action == "http://site.com/login", "form action absolutized");
assert(len(frms[0].fields) == 3, "three controls (2 input + 1 textarea)");
assert(frms[0].fields[0].name == "user" and frms[0].fields[0].value == "alice", "input name/value extracted");

// form encoding (application/x-www-form-urlencoded), pblang UTF-8 percent-encoder
assert(b.percent_encode("a b&c") == "a+b%26c", "space -> +, reserved -> %XX");
assert(b.urlencode(map{ q: "hi there" }) == "q=hi+there", "urlencode key=value");

print "browser_pass";
