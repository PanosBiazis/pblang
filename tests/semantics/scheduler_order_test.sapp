// Model-based intrusive-list coverage: head, tail, middle, pause/resume and clear.
let S=import("stdlib:scheduler.sapp");
fn check(ok,msg){if not ok {throw "FAIL "+msg;}}
let state=map{events:[]};
fn callback(n){return fn(){array_push(state.events,n);};}
let records=[];
let order=[];
let seed=117;
for step 800 {
    seed=(seed*16807)%2147483647;
    let op=seed%7;
    if op==0 or len(records)==0 {
        let n=len(records);
        let id=S.set_interval(callback(n),0);
        array_push(records,map{id:id,status:"active"});
        array_push(order,n);
    } else {
        let n=seed%len(records);
        let r=records[n];
        if op==1 {
            S.clear_timer(r.id);
            r.status="gone";
        } else if op==2 {
            let expected=r.status=="active";
            check(S.pause_timer(r.id)==expected,"pause state");
            if expected {r.status="paused";}
        } else if op==3 {
            let expected=r.status=="paused";
            check(S.resume_timer(r.id)==expected,"resume state");
            if expected {r.status="active";array_push(order,n);}
        } else if op==4 {
            S.clear_all();
            for entry in records {entry.status="gone";}
        }
        // Maintain registration/resume order with no duplicate memberships.
        let next=[];
        for j len(order) {
            let item=order[j];
            let last=true;
            let k=j+1;
            while k<len(order) {if order[k]==item {last=false;} k=k+1;}
            if records[item].status=="active" and last {array_push(next,item);}
        }
        order=next;
    }
    let active=0;
    let paused=0;
    for r in records {
        if r.status=="active" {active=active+1;}
        if r.status=="paused" {paused=paused+1;}
    }
    check(S.active_timers()==active,"active count");
    check(S.paused_timers()==paused,"paused count");
    check(S.retained_timers()==active+paused,"no retired records");
    state.events=[];
    check(S.run_pending()==active,"dispatch count");
    check(state.events==order,"dispatch order");
}
S.clear_all();
print "scheduler_order_pass";
