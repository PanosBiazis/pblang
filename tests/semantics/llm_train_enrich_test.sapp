// tests/semantics/llm_train_enrich_test.sapp — enrichment for stdlib/llm_train.sapp
// Adds learning-rate schedulers: lr_constant, lr_linear_warmup, lr_cosine_decay, lr_step_decay.

let tr = import("stdlib/llm_train.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.0005 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── lr_constant ──────────────────────────────────────────────────────────────────
near(tr.lr_constant(0.1, 99), 0.1, "constant");

// ── lr_linear_warmup ─────────────────────────────────────────────────────────────
near(tr.lr_linear_warmup(0.1, 0, 10), 0, "warmup step 0");
near(tr.lr_linear_warmup(0.1, 5, 10), 0.05, "warmup midpoint");
near(tr.lr_linear_warmup(0.1, 10, 10), 0.1, "warmup complete");
near(tr.lr_linear_warmup(0.1, 50, 10), 0.1, "after warmup stays at base");

// ── lr_cosine_decay ──────────────────────────────────────────────────────────────
near(tr.lr_cosine_decay(0.1, 0, 10), 0.1, "cosine start = base");
near(tr.lr_cosine_decay(0.1, 5, 10), 0.05, "cosine half = base/2");
near(tr.lr_cosine_decay(0.1, 10, 10), 0, "cosine end = 0");

// ── lr_step_decay ────────────────────────────────────────────────────────────────
near(tr.lr_step_decay(0.1, 0, 5, 0.5), 0.1, "step decay 0 periods");
near(tr.lr_step_decay(0.1, 5, 5, 0.5), 0.05, "step decay 1 period");
near(tr.lr_step_decay(0.1, 12, 5, 0.5), 0.025, "step decay 2 periods");

print "llm_train_enrich_pass";
