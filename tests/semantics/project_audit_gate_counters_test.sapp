let A = import("stdlib:project_audit.sapp");
fn expect(ok, label) { if not ok { throw "FAIL gate-counters: " + label; } }
fn rejects(action) { return try { action(); false } catch true; }
let fields = [["", "finding_count"],
    ["counts_severity", "high"], ["counts_severity", "medium"],
    ["counts_severity", "low"], ["counts_severity", "info"],
    ["counts_kind", "security"], ["counts_kind", "reliability"],
    ["counts_kind", "performance"], ["counts_kind", "incomplete"],
    ["counts_kind", "roadmap"],
    ["counts_role", "source"], ["counts_role", "docs"],
    ["counts_role", "test"], ["counts_role", "config"],
    ["counts_role_severity", "source:high"], ["counts_role_severity", "source:medium"],
    ["counts_role_kind_severity", "source:security:high"],
    ["counts_role_kind_severity", "source:reliability:high"],
    ["counts_role_kind_severity", "source:performance:high"]];
fn one_count(field, value) {
    let report = map{};
    if field[0] == "" { report[field[1]] = value; }
    else { let counts = map{}; counts[field[1]] = value; report[field[0]] = counts; }
    return report;
}
let invalid = [nil, true, false, "private-counter-marker", [], map{}, fn() { return 1; },
    bigint(1), rational("1/1"), decimal("1"), parse_number("NaN"),
    parse_number("inf"), parse_number("-inf"), -1, 0.5, 9007199254740992];
expect(len(fields) == 19, "all consumed counters are covered");
for field in fields {
    for value in invalid {
        let report = one_count(field, value);
        expect(rejects(fn() { A.quality_gate(report); }), "invalid direct counter rejects");
        expect(rejects(fn() { A.quality_gate(map{report: report}, map{source_only_blockers: true}); }),
            "wrapper and inactive policy branches still validate");
    }
    for value in [0, 1, 9007199254740991] {
        expect(type(A.quality_gate(one_count(field, value))) == "map", "inclusive valid scalar domain");
    }
}
for value in [nil, true, 0, "private-report-marker", [], fn() { return 1; }] {
    expect(rejects(fn() { A.quality_gate(value); }), "outer shape");
    expect(rejects(fn() { A.quality_gate(map{report: value}); }), "nested shape including explicit nil");
}
for container in ["counts_severity", "counts_kind", "counts_role",
    "counts_role_severity", "counts_role_kind_severity"] {
    for value in [nil, false, 1, "private-container-marker", [], fn() { return 1; }] {
        let report = map{}; report[container] = value;
        expect(rejects(fn() { A.quality_gate(report); }), "present container must be map");
    }
}
for value in [nil, false, 2, "private-findings-marker", map{}] {
    expect(rejects(fn() { A.quality_gate(map{findings: value}); }), "fallback requires array");
}
let empty = A.quality_gate(map{});
expect(empty.passed and empty.status == "passed" and empty.counts.total == 0, "legacy sparse empty report");
expect(A.quality_gate(map{report: map{}}).passed, "sparse project wrapper");
let fallback = A.quality_gate(map{findings: [map{}, map{}]});
expect(fallback.counts.total == 2 and fallback.status == "needs-review", "legacy array length fallback");
let high = map{finding_count: 1, counts_severity: map{high: 1}};
expect(not A.quality_gate(high).passed, "valid high counter still blocks");
high.counts_severity.high = parse_number("NaN");
expect(rejects(fn() { A.quality_gate(high); }), "mutating high to NaN cannot pass");
let ceiling = 9007199254740991;
let exact = map{counts_role_severity: map{"source:high": ceiling - 1, "source:medium": 1}};
expect(A.quality_gate(exact).counts.source_blocking == ceiling, "exact inclusive source sum");
exact.counts_role_severity["source:high"] = ceiling;
expect(rejects(fn() { A.quality_gate(exact); }), "source sum overflow rejects before addition");
expect(rejects(fn() { A.quality_gate(exact, map{source_only_blockers: true}); }), "source policy overflow");

// Public/module reports may retain only a small index of all counted findings.
let indexed = map{findings: [map{}], finding_count: 9, counts_severity: map{low: 9},
    counts_role: map{docs: 9}, counts_kind: map{security: 9}};
let original = json_stringify(indexed);
let gate = A.quality_gate(indexed);
expect(gate.passed and gate.counts.total == 9 and gate.counts.low == 9, "full counts survive bounded index");
expect(json_stringify(indexed) == original, "report input remains unchanged");
gate.counts.total = 99;
expect(indexed.finding_count == 9 and A.quality_gate(indexed).counts.total == 9, "gate output does not alias report");
indexed.counts_severity.low = -1;
expect(rejects(fn() { A.quality_gate(indexed); }), "previously accepted mutable reports are revalidated");

// This contract validates consumed counters only; extra metadata is not traversed.
expect(A.quality_gate(map{extra: fn() { throw "must not run"; },
    counts_kind: map{extension: "uninterpreted"}}).passed, "unrelated metadata compatibility");
let clean = A.scan_records([], 16);
expect(A.quality_gate(clean).passed, "generated clean report");
let readiness = A.release_readiness("fixture", [map{path: "src/review.sapp", text: "// slow path"}]);
expect(readiness.quality_gate.counts.medium == 1, "readiness uses admitted generated counters");
print "project_audit_gate_counters_pass";
