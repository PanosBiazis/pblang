// stdlib/build.sapp — target triple helper (no exec / fs side effects)
import "stdlib:build.sapp";

let t = build.target_triple();
if type(t) != "string" { throw "FAIL build target type"; }
if len(t) < 3 { throw "FAIL build target len"; }
if not str_contains(t, "-") { throw "FAIL build target format"; }

print "build_stdlib_pass";
