// Test: proptest.sapp — property-based testing (QuickCheck-style).
//
// Pins: seeded reproducible runs, failure detection (false return AND throw),
// greedy shrinking to the minimal counterexample, all generator kinds, and
// check() raising with the seed in the message.

let P = import("stdlib:proptest.sapp");

fn eq(a, b, msg) {
    if a != b { return error("FAIL " + msg + ": got " + str(a) + ", want " + str(b)); }
}

// ── passing property ──────────────────────────────────────────────────────────
let ok1 = P.for_all_seeded([P.int(0, 100)], fn(a) { return a[0] >= 0; }, 50, 42);
eq(ok1.ok, true, "tautology passes");
eq(ok1.cases, 50, "ran all cases");

// ── failing property shrinks to the minimal counterexample ──────────────────
// a[0] < 100 fails for any v >= 100; the smallest failing value is exactly 100.
let bad = P.for_all_seeded([P.int(0, 1000)], fn(a) { return a[0] < 100; }, 200, 7);
eq(bad.ok, false, "violation found");
eq(bad.shrunk[0], 100, "shrunk to minimal counterexample");
eq(bad.seed, 7, "failure reports the seed");

// ── reproducibility: same seed → same shrunk result ─────────────────────────
let bad2 = P.for_all_seeded([P.int(0, 1000)], fn(a) { return a[0] < 100; }, 200, 7);
eq(bad2.shrunk[0], bad.shrunk[0], "same seed reproduces");

// ── throwing property counts as failure ─────────────────────────────────────
let thr = P.for_all_seeded([P.int(0, 1000)], fn(a) {
    if a[0] > 50 { return error("boom"); }
    return true;
}, 200, 3);
eq(thr.ok, false, "throwing property is a failure");
eq(thr.shrunk[0], 51, "throw shrinks to minimal trigger");

// ── array generator + length shrinking ───────────────────────────────────────
let arr = P.for_all_seeded([P.array_of(P.int(0, 100), 20)], fn(a) {
    return len(a[0]) < 5;
}, 200, 11);
eq(arr.ok, false, "long array found");
eq(len(arr.shrunk[0]), 5, "array shrunk to minimal failing length");

// ── multi-argument properties ────────────────────────────────────────────────
let two = P.for_all_seeded([P.int(0, 50), P.int(0, 50)], fn(a) {
    return a[0] + a[1] == a[1] + a[0];
}, 100, 99);
eq(two.ok, true, "commutativity holds");

// ── remaining generators produce sane values ─────────────────────────────────
let kinds = P.for_all_seeded(
    [P.bool(), P.float(0.0, 1.0), P.string_of(8), P.one_of(["a", "b", "c"]),
     P.map_of(map{ n: P.int(1, 9), s: P.string_of(4) })],
    fn(a) {
        if type(a[0]) != "bool" { return false; }
        if a[1] < 0.0 or a[1] > 1.0 { return false; }
        if type(a[2]) != "string" or len(a[2]) > 8 { return false; }
        if a[3] != "a" and a[3] != "b" and a[3] != "c" { return false; }
        if type(a[4]) != "map" { return false; }
        if a[4].n < 1 or a[4].n > 9 { return false; }
        return true;
    }, 100, 5);
eq(kinds.ok, true, "all generator kinds in range");

// ── string shrinking ─────────────────────────────────────────────────────────
let s = P.for_all_seeded([P.string_of(12)], fn(a) { return len(a[0]) < 3; }, 200, 13);
eq(s.ok, false, "long string found");
eq(len(s.shrunk[0]), 3, "string shrunk to minimal failing length");

// ── check() raises on failure, passes through on success ────────────────────
let c1 = P.check([P.int(0, 10)], fn(a) { return a[0] <= 10; }, 50, 1);
eq(c1.ok, true, "check passes clean property");
let c2 = try map{ ok: true, value: P.check([P.int(0, 10)], fn(a) { return a[0] < 5; }, 50, 1) }
         catch map{ ok: false, value: nil };
eq(c2.ok, false, "check raises on violation");

// ── for_all (auto seed) still detects violations ─────────────────────────────
let auto = P.for_all([P.int(0, 1000)], fn(a) { return a[0] < 100; });
eq(auto.ok, false, "for_all with auto seed finds violation");
eq(auto.shrunk[0], 100, "auto-seed run still shrinks fully");

print "proptest_pass";
