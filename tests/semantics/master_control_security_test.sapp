// tests/semantics/master_control_security_test.sapp — deny-ceiling path-traversal fix.

let MC = import("stdlib/master_control.sapp");

fn fail(m) { throw "FAIL " + m; }
fn deny(action, m) { if MC.classify(action).allowed { fail(m + " should be DENIED"); } }
fn allow(action, m) { if not MC.classify(action).allowed { fail(m + " should be allowed: " + str(MC.classify(action))); } }

// ── baseline: direct system path is denied; ordinary path is allowed ───────────────
deny(map{ kind: "delete", path: "/etc/passwd" }, "direct /etc");
deny(map{ kind: "delete", path: "/" }, "root");
allow(map{ kind: "delete", path: "/tmp/myfile" }, "ordinary temp file");

// ── FIX: traversal that RESOLVES into a system path must still be denied ───────────
deny(map{ kind: "delete", path: "/var/../etc/passwd" }, "traversal into /etc");
deny(map{ kind: "overwrite", path: "/home/user/../../etc/shadow" }, "traversal up into /etc");
deny(map{ kind: "delete", path: "/usr/local/../../boot/grub" }, "traversal into /boot");

// ── normalization both ways: traversal OUT of a system path into temp is allowed ──
allow(map{ kind: "delete", path: "/etc/../tmp/ok" }, "resolves to /tmp");

// ── would_allow convenience ────────────────────────────────────────────────────────
if MC.would_allow(map{ kind: "delete", path: "/var/../etc/passwd" }) { fail("would_allow mirrors classify (deny)"); }
if not MC.would_allow(map{ kind: "delete", path: "/tmp/x" }) { fail("would_allow mirrors classify (allow)"); }

print "master_control_security_pass";
