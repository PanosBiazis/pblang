// tests/semantics/path_enrich2_test.sapp — wave 2 for stdlib/path.sapp
// Path relationship helpers (lexical): relative_to, common_prefix, is_subpath.

let P = import("stdlib/path.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── relative_to(base, target) ───────────────────────────────────────────────────────
eq(P.relative_to("/a/b", "/a/b/c/d"), "c/d", "child path");
eq(P.relative_to("/a/b", "/a/b"), ".", "same path -> .");
eq(P.relative_to("/a/b", "/a/c"), "../c", "sibling needs ..");
eq(P.relative_to("/a/b/c", "/a"), "../..", "ancestor");

// ── common_prefix(paths) ────────────────────────────────────────────────────────────
eq(P.common_prefix(["/a/b/c", "/a/b/d", "/a/b/e/f"]), "/a/b", "shared prefix");
eq(P.common_prefix(["/a/b", "/x/y"]), "/", "no shared dir -> root");
eq(P.common_prefix(["a/b/c", "a/b/d"]), "a/b", "relative shared prefix");

// ── is_subpath(parent, child) ───────────────────────────────────────────────────────
if not P.is_subpath("/a/b", "/a/b/c") { fail("c is under b"); }
if not P.is_subpath("/a/b", "/a/b") { fail("a path is its own subpath"); }
if P.is_subpath("/a/b", "/a/c") { fail("sibling is not a subpath"); }
if P.is_subpath("/a/b", "/a/bc") { fail("prefix-string but not path-component subpath"); }

print "path_enrich2_pass";
