let app = import("stdlib/app.sapp");

fn eq(actual, expected, label) {
    if actual != expected { throw "FAIL " + label + ": got " + str(actual) + ", expected " + str(expected); }
}

let ks = app.kinds();
eq(len(ks), 13, "thirteen application kinds");

let cli = app.run(map{
    kind: "cli", name: "one-line-cli", args: ["greet", "Ada"], quiet: true,
    commands: map{ greet: fn(ctx) { return "Hello " + ctx.args[1]; } }
});
eq(cli.kind, "cli", "cli kind");
eq(cli.command, "greet", "cli command dispatch");
eq(cli.value, "Hello Ada", "cli command result");

let gui = app.run(map{
    kind: "gui", name: "one-line-gui", preview: true,
    model: map{ username: "Ada" },
    widgets: [
        map{ kind: "label", name: "title", text: "Account" },
        map{ kind: "textbox", name: "name", bind: "username" },
        map{ kind: "button", name: "save", text: "Save" }
    ]
});
eq(gui.kind, "gui", "gui kind");
eq(gui.widgets, 3, "declarative widgets built");
eq(gui.form.model.username, "Ada", "gui model retained");
eq(gui.form.widgets[1].value, "Ada", "gui binding pulled into textbox");

let web = app.run(map{
    kind: "web", name: "one-line-web", preview: true,
    routes: [
        map{ method: "GET", path: "/health", handler: fn(ctx) { return ctx.json(map{ status: "ok" }); } }
    ],
    request: map{ method: "GET", path: "/health", headers: map{ "user-agent": "Mozilla/5.0 test" }, body: "" }
});
eq(web.kind, "web", "web kind");
eq(web.response.status, 200, "web route status");
eq(web.response.json.status, "ok", "web JSON response");
if not map_has(web.response.headers, "Content-Security-Policy") { throw "FAIL web security headers"; }
if not map_has(web.response.headers, "X-Content-Type-Options") { throw "FAIL web nosniff header"; }

let p = app.plan(map{ kind: "web", preview: true });
eq(p.ok, true, "web plan valid");
eq(p.blocking, false, "preview is non-blocking");
eq(p.capabilities[0], "net", "web plan net capability");

let bad_kind = app.validate(map{ kind: "desktop-magic" });
eq(bad_kind.ok, false, "unknown kind rejected");
eq(app.validate(map{ kind: "cli", args: "not-an-array" }).ok, false, "invalid CLI args rejected");
eq(app.validate(map{ kind: "gui", widgets: [map{ kind: "unknown-widget" }] }).ok, false, "invalid widget kind rejected");
eq(app.validate(map{ kind: "gui", width: 99999 }).ok, false, "oversized GUI rejected");
let bad_bind = app.validate(map{ kind: "web", host: "0.0.0.0" });
eq(bad_bind.ok, false, "public bind denied by default");
let allowed_bind = app.validate(map{ kind: "web", host: "0.0.0.0", allow_public: true });
eq(allowed_bind.ok, true, "explicit public bind allowed");
let bad_route = app.validate(map{ kind: "web", routes: [map{ path: "relative", method: "GET" }] });
eq(bad_route.ok, false, "relative route rejected");

let full = app.run(map{
    kind: "fullstack", name: "workspace", preview: true, start: "web",
    cli: map{ args: ["status"], commands: map{ status: fn(ctx) { return "ready"; } } },
    gui: map{ model: map{ status: "ready" }, widgets: [map{ kind: "label", name: "status", bind: "status" }] },
    web: map{ routes: [map{ method: "GET", path: "/api/status", handler: fn(ctx) { return ctx.json(map{ status: "ready" }); } }],
              request: map{ method: "GET", path: "/api/status", headers: map{ "user-agent": "Mozilla/5.0 test" }, body: "" } }
});
eq(full.kind, "fullstack", "fullstack kind");
eq(full.cli.value, "ready", "fullstack CLI component");
eq(full.gui.form.widgets[0].text, "ready", "fullstack GUI binding");
eq(full.web.response.json.status, "ready", "fullstack web component");
let full_plan = app.plan(map{ kind: "fullstack", preview: true, start: "web", gui: map{}, web: map{} });
eq(full_plan.ok, true, "fullstack plan valid");
eq(len(full_plan.capabilities), 3, "fullstack capability union");
eq(full_plan.blocking, false, "fullstack preview non-blocking");
let bad_full = app.validate(map{ kind: "fullstack", start: "web", gui: map{} });
eq(bad_full.ok, false, "missing selected fullstack component rejected");

let pbide_source = fs_read("editors/ide/pbide.sapp");
if not str_contains(pbide_source, "examples/one_line_apps/gui_live.sapp") { throw "FAIL PBIDE one-line GUI catalog integration"; }
if not str_contains(pbide_source, "examples/one_line_apps/web_live.sapp") { throw "FAIL PBIDE one-line web catalog integration"; }
if not str_contains(pbide_source, "examples/one_line_apps/fullstack.sapp") { throw "FAIL PBIDE fullstack catalog integration"; }
if not str_contains(pbide_source, "examples/one_line_apps/domains.sapp") { throw "FAIL PBIDE domain catalog integration"; }
let app_bench = fs_read("bench/app_facade_stages.sapp");
if not str_contains(app_bench, "APP_PHASE_SUITE|ok") { throw "FAIL app facade benchmark contract"; }
let domain_bench = fs_read("bench/app_domain_stages.sapp");
if not str_contains(domain_bench, "APP_DOMAIN_PHASE_SUITE|ok") { throw "FAIL app domain benchmark contract"; }

let quick_cli = app.cli("compact", map{ quiet: true, args: [] });
eq(quick_cli.value, "compact", "compact one-line CLI");
let quick_gui = app.gui("Compact GUI", [map{ kind: "label", text: "Ready" }], map{ preview: true });
eq(quick_gui.widgets, 1, "compact one-line GUI preview");
let quick_web = app.web("Compact web", fn(ctx) { return ctx.json(map{ ok: true }); }, map{ preview: true });
eq(quick_web.response.json.ok, true, "compact one-line web preview");
let quick_full = app.fullstack("Compact fullstack", map{
    preview: true, start: "web",
    cli: map{ message: "ready" }, gui: map{ widgets: [map{ kind: "label", text: "Ready" }] },
    web: map{ handler: fn(ctx) { return ctx.text("ready"); } }
});
eq(quick_full.web.response.body, "ready", "compact one-line fullstack preview");

let universal = app.universal("Universal app", fn(request) { return "surface=" + request.surface; }, map{ preview: true, start: "web" });
eq(universal.kind, "fullstack", "universal app uses the fullstack runtime");
eq(universal.cli.value, "surface=cli", "universal action reaches CLI");
eq(universal.gui.widgets, 8, "universal action receives a complete native GUI");
eq(universal.web.response.status, 200, "universal action receives a hardened web home");
if not map_has(universal.web.response.headers, "Content-Security-Policy") { throw "FAIL universal web security headers"; }
if not str_contains(pbide_source, "examples/one_line_apps/universal.sapp") { throw "FAIL PBIDE universal app catalog integration"; }

print "app_pass";
