let S=import("stdlib:llm_tiered_store.sapp");
let root=env_get("PBAI_STATE_ROOT");assert(type(root)=="string" and root!="","private state required");
let dir=path_join(root,"byte-ownership");fs_mkdirs(dir);
let a=[1,2,3,4];let b=[5,6,7,8];
fn digest(bytes) {return sha256(base64_encode_bytes(bytes));}
fs_write_bytes(path_join(dir,"a.bin"),a);fs_write_bytes(path_join(dir,"b.bin"),b);fs_write_bytes(path_join(dir,"empty.bin"),[]);
let parts=[S.model_part("a","a.bin",4,digest(a),"expert",0,0),S.model_part("b","b.bin",4,digest(b),"expert",0,1)];
let options=map{ram_budget_bytes:4,max_cache_entries:1,prefetch_capacity:2};
let session=S.create(dir,parts,S.config(options.ram_budget_bytes,options));assert(session.ok,"real session opened");
let miss=S.load(session,"a");let hit=S.load(session,"a");
assert(miss.ok and miss.cached and not miss.cache_hit and hit.cache_hit and hit.verified,"actual miss then hit");
miss.bytes[0]=99;push(miss.bytes,255);push(miss.bytes,miss.bytes);
assert(hit.bytes==a,"miss output cannot mutate previously returned hit");
hit.bytes[1]=77;array_pop(hit.bytes);hit.size=999;hit.verified=false;
let intact=S.load(session,"a");
assert(intact.bytes==a and intact.size==4 and intact.verified and digest(intact.bytes)==digest(a),"mutated values, length and cyclic caller output cannot poison cache");
let reads=S.status(session).stats.verified_reads;
fs_write_bytes(path_join(dir,"a.bin"),[0,0,0,0]);
let cached=S.load(session,"a");
assert(cached.cache_hit and cached.bytes==a and S.status(session).stats.verified_reads==reads,"hit returns independent verified resident bytes without disk reread");
assert(S.record_routes(session,0,[1,1,1,1,1,1,1,1]).ok and S.queue_expert_prefetch(session,0,1).ok,"queue real second expert");
let prefetched=S.run_prefetch(session,1);assert(prefetched.ok and prefetched.completed==["b"],"prefetch evicts unpinned first expert");
let from_prefetch=S.load(session,"b");assert(from_prefetch.cache_hit and from_prefetch.bytes==b,"real prefetched hit");
from_prefetch.bytes[0]=200;push(from_prefetch.bytes,201);
let kept_b=S.load(session,"b");assert(kept_b.bytes==b and kept_b.size==4,"prefetched storage is detached too");
assert(intact.bytes==a and cached.bytes==a,"eviction does not alter retained prior results");
let failed=S.load(session,"a");
assert(not failed.ok and failed.code=="integrity" and not map_has(failed,"bytes"),"corrupt reread returns error without bytes");
assert(S.status(session).resident_bytes==4 and S.load(session,"b").bytes==b,"failed read cannot replace healthy cached expert");
fs_write_bytes(path_join(dir,"a.bin"),a);
assert(S.load(session,"a").bytes==a and kept_b.bytes==b,"recovered read preserves previous caller output");
assert(S.close(session),"session closes");
assert(intact.bytes==a and kept_b.bytes==b,"close preserves caller-owned outputs");
assert(S.load(session,"a").code=="closed","closed session cannot be revived by old outputs");
let bypass=S.create(dir,parts,S.config(0));
let first_bypass=S.load(bypass,"a");assert(first_bypass.ok and not first_bypass.cached,"zero budget bypass");
first_bypass.bytes[0]=9;let second_bypass=S.load(bypass,"a");
assert(second_bypass.bytes==a and not second_bypass.cached and S.status(bypass).resident_bytes==0,"bypass results remain independent without cache allocation");
assert(S.close(bypass),"bypass session closes");
let pinned=S.create(dir,parts,S.config(options.ram_budget_bytes,options));let pinned_a=S.load(pinned,"a",true);
let displaced=S.load(pinned,"b");assert(not displaced.cached,"pinned cache forces bypass");
displaced.bytes[0]=100;pinned_a.bytes[0]=101;
assert(S.load(pinned,"a").bytes==a and S.status(pinned).pinned_shards==1,"caller mutation cannot alter pinned resident data");assert(S.close(pinned),"pinned session closes");
let empty=S.create(dir,[S.model_part("empty","empty.bin",0,digest([]))],S.config(0));
let empty_first=S.load(empty,"empty");assert(empty_first.cached and empty_first.size==0,"zero-length shard is cached");
push(empty_first.bytes,123);let empty_hit=S.load(empty,"empty");
assert(empty_hit.cache_hit and empty_hit.bytes==[] and empty_hit.size==0 and S.status(empty).resident_bytes==0,"empty result growth cannot grow resident data");assert(S.close(empty),"empty session closes");
print "llm_tiered_store_byte_ownership_pass";
