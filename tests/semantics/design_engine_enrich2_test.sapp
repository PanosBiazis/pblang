// tests/semantics/design_engine_enrich2_test.sapp — wave 2 for stdlib/design_engine.sapp
// rect = map{x,y,w,h} (floored). Area, inset, translate, aspect_fit/fill.

let D = import("stdlib/design_engine.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn eqr(r, x, y, w, h, m) {
    if r.x != x or r.y != y or r.w != w or r.h != h { fail(m + " got=" + str(r)); }
}

eq(D.rect_area(D.rect(0, 0, 4, 5)), 20, "area");

eqr(D.rect_inset(D.rect(0, 0, 10, 10), 2, 1), 2, 1, 6, 8, "inset");
eqr(D.rect_translate(D.rect(1, 2, 3, 4), 5, 6), 6, 8, 3, 4, "translate");

// aspect_fit: 100x50 into 50x50 -> scaled to 50x25, centered vertically (y=12)
eqr(D.aspect_fit(100, 50, D.rect(0, 0, 50, 50)), 0, 12, 50, 25, "aspect_fit");

// aspect_fill: 100x50 into 50x50 -> scaled to cover 100x50, centered (x=-25)
eqr(D.aspect_fill(100, 50, D.rect(0, 0, 50, 50)), -25, 0, 100, 50, "aspect_fill");

print "design_engine_enrich2_pass";
