// Test: keyboard input facilities (stdlib/kernel/keyboard.sapp) + an interactive shell
// composed under the preemptive scheduler, §80.
//
// Composes every kernel primitive built this session: keyboard IRQ1 + scancode ring
// buffer + US keymap + serial console + heap + the timer-preemptive scheduler. The
// shell runs as a scheduled TASK; isr_kbd buffers scancodes, isr_timer drives the
// scheduler. Proven END-TO-END in QEMU with LIVE injected keystrokes: typing "ok"+Enter
// makes the shell task match the command -> exit 85. (Single-threaded shell also proven
// separately.) We assert the codegen contract here.
//
// BUG FIXED this session: a kernel that doesn't handle every unmasked IRQ triple-faults
// when a stray IRQ (the free-running PIT on IRQ0) hits an uninstalled IDT gate — so
// `pic_mask` must disable the IRQs without handlers. See §80.

let ct = import("stdlib/compiler/ctranspile.sapp");
let intr = fs_read("stdlib/kernel/interrupts.sapp");
let con = fs_read("stdlib/kernel/console.sapp");
let kbd = fs_read("stdlib/kernel/keyboard.sapp");
let timer = fs_read("stdlib/kernel/timer.sapp");
let sched = fs_read("stdlib/kernel/sched.sapp");

let src = "fn isr_kbd() { kbd_push(peek32(37120), kbd_scancode()); pic_eoi(); } "
    + "fn isr_timer() { pic_eoi(); sched_yield(peek32(37128)); } "
    + "fn shell_task() { sti(); serial_puts(\"pblang> \"); let n = 0; "
    + "while 1 > 0 { let sc = kbd_pop(peek32(37120)); if sc > 0 - 1 { "
    + "let ch = kbd_ascii(peek32(37124), sc); if ch > 0 { serial_putc(ch); } } } } "
    + "fn idle_task() { sti(); while 1 > 0 { hlt(); } } "
    + "fn kmain() { serial_init(); poke32(37120, kbd_buf_new(64)); poke32(37124, kbd_keymap_new()); "
    + "let s = sched_new(8); poke32(37128, s); "
    + "task_add(s, kmalloc(8192), 8192, addr_of(\"shell_task\")); "
    + "task_add(s, kmalloc(8192), 8192, addr_of(\"idle_task\")); "
    + "let idt = kmalloc(2048); pic_remap(); pic_mask(252, 255); "
    + "idt_set_gate(idt, 32, addr_of(\"isr_timer\"), 8, 142); "
    + "idt_set_gate(idt, 33, addr_of(\"isr_kbd\"), 8, 142); idt_load(idt); "
    + "pit_init(1193); sched_start(s); while 1 > 0 { hlt(); } }";

let c = ct.transpile_kernel_int(intr + con + kbd + timer + sched + src);

// ── Keyboard input facilities ────────────────────────────────────────────────────────
assert(str_contains(c, "long kbd_buf_new(long capacity)"), "scancode ring buffer constructor");
assert(str_contains(c, "long kbd_push(long b, long sc)"), "ISR-side enqueue");
assert(str_contains(c, "long kbd_pop(long b)"), "consumer-side dequeue");
assert(str_contains(c, "long kbd_keymap_new()"), "US scancode->ASCII keymap");
assert(str_contains(c, "long kbd_ascii(long t, long sc)"), "scancode translation (ignores releases)");

// ── The triple-fault fix: mask IRQs without handlers ────────────────────────────────
assert(str_contains(c, "long pic_mask(long master, long slave)"), "pic_mask present (prevents stray-IRQ triple faults)");

// ── Both interrupt sources + the scheduler, composed ────────────────────────────────
assert(str_contains(c, "__attribute__((interrupt)) void isr_kbd(void* _frame)"), "keyboard ISR (IRQ1)");
assert(str_contains(c, "__attribute__((interrupt)) void isr_timer(void* _frame)"), "timer ISR (IRQ0) drives the scheduler");
assert(str_contains(c, "long shell_task("), "the shell is a scheduled task");
assert(str_contains(c, "sched_yield("), "preempted from the timer ISR");
assert(str_contains(c, "(long)(u64)&shell_task"), "shell task installed via addr_of");

assert(not str_contains(c, "double"), "the whole interactive kernel is float-runtime-free");
assert(str_contains(c, "0x1BADB002"), "multiboot header present");

print "kernel_shell_pass";
