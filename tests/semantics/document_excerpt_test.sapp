let E=import("stdlib:document_excerpt.sapp");let D=import("stdlib:text_document.sapp");let doc=D.from_text("Κεφάλαιο\nFirst\nΔεύτερο\nLast","Επιλογή");doc.blocks[0].kind="heading";doc.blocks[2].kind="bullet";let before=D.encode(doc);let out=E.select(doc,[0,2]);assert(out.title==doc.title and out.blocks==[doc.blocks[0],doc.blocks[2]],"source order and kinds");out.blocks[0].text="changed";assert(D.encode(doc)==before,"detached output");assert(E.parse_indices("1,3")==[0,2],"one-based CLI");for bad in [[],[1,1],[2,0],[-1],[4],[0.5],[true],nil,"1"]{assert((try E.select(doc,bad) catch nil)==nil,"reject invalid selection");}for bad in ["","1,","0","65","1.0","1 2","1, 3",str_repeat("1",193)]{assert((try E.parse_indices(bad) catch nil)==nil,"reject invalid list");}let max=D.create();max.blocks=[];let indices=[];for i in range(0,64){array_push(max.blocks,map{kind:"paragraph",text:str(i)});array_push(indices,i);}assert(E.select(max,indices)==max,"maximum selection");assert(D.decode(D.encode(E.select(doc,[1])))==E.select(doc,[1]),"Writer roundtrip");print "document_excerpt_pass";
