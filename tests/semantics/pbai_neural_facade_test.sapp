let AI=import("stdlib/pbai.sapp");
let r=AI.neural_specialist_train([map{x:[0],y:4}],[map{x:[7,0],y:4}],map{epochs:16,lr:0.1});
let pred=AI.neural_specialist_run(r.artifact,[0]);
assert(r.candidate_improved and pred.artifact_digest==r.artifact.digest,"facade trains and invokes same candidate");
assert(not pred.globally_activated and not pred.authorizes_action,"no implicit activation");
print "pbai_neural_facade_pass";

let session=AI.neural_specialist_session([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let before=session.predict([0]);let evaluation=session.evaluate([map{x:[6,0],y:4}]);
assert(evaluation.passed,"facade candidate gate");
assert(session.promote().session_adapter_active,"facade explicit promotion");
assert(session.predict([0]).artifact_digest != before.artifact_digest,"facade uses learned artifact");
session.rollback();assert(session.predict([0]).artifact_digest==before.artifact_digest,"facade rollback");
assert(session.close() and not session.close(),"facade exposes explicit close");
print "pbai_neural_session_facade_pass";
