// tests/semantics/nn_parallel_test.sapp — data-parallel inference/eval across CPU cores
// (pblang parallel levels) for both the layered MLP and the free-form graph network.

let nn = import("stdlib/nn.sapp");
let G = import("stdlib/nn_graph.sapp");
let NP = import("stdlib/nn_parallel.sapp");

fn fail(m) { throw "FAIL " + m; }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.00001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── parallel batch predict matches sequential predict ─────────────────────────────
let net = nn.mlp_new(2, 4, 1, 7);
let xs = [ [0, 0], [0, 1], [1, 0], [1, 1] ];
let par = NP.batch_predict(net, xs);
let i = 0;
while i < len(xs) { approx(par[i][0], nn.predict(net, xs[i])[0], "batch_predict matches sequential"); i = i + 1; }

// ── parallel per-sample losses sum to the sequential dataset loss ─────────────────
let data = [ nn.sample([0, 0], [0]), nn.sample([0, 1], [1]), nn.sample([1, 0], [1]), nn.sample([1, 1], [0]) ];
let losses = NP.par_losses(net, data);
let total = 0; let j = 0;
while j < len(losses) { total = total + losses[j]; j = j + 1; }
approx(total / len(data), nn.loss(net, data), "par_losses average == nn.loss");

// ── parallel graph forward over a batch matches sequential forward ────────────────
let g = G.graph_new();
G.add_node(g, 0, "linear"); G.add_node(g, 0, "tanh");
G.add_bond(g, 0, 1, 0.5);
let ins = [ [1], [2], [0 - 1] ];
let gb = NP.graph_batch(g, ins, 1);
let k = 0;
while k < len(ins) {
    let seq = G.forward(g, ins[k], 1);
    approx(gb[k][1], seq[1], "graph_batch matches sequential forward");
    k = k + 1;
}

print "nn_parallel_pass";
