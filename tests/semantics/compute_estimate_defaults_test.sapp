let CP = import("stdlib:compute.sapp");
let profiles = [
    ["generic",1,8], ["numeric",16,16], ["vector",32,16],
    ["matmul",4096,16], ["tensor",4096,16], ["image",64,8],
    ["training",8192,16], ["inference",4096,8], ["onnx",4096,8],
    ["distributed",64,64], ["batch",64,64], ["unknown",1,8],
];
let records = []; let p = 0;
while p < len(profiles) {
    // Absent, explicit nil, and explicit numeric values are independent fields.
    let w = 0;
    while w < 3 {
        let t = 0;
        while t < 3 {
            let cfg = map{ format: "pblang.compute.policy.v1", workload: profiles[p][0] };
            if w == 1 { cfg.work_units_per_item = nil; }
            if w == 2 { cfg.work_units_per_item = 7; }
            if t == 1 { cfg.transfer_bytes_per_item = nil; }
            if t == 2 { cfg.transfer_bytes_per_item = 0; }
            let work = if w == 2 { 7 } else { profiles[p][1] };
            let transfer = if t == 2 { 0 } else { profiles[p][2] };
            let estimate = CP.estimate_work(3, cfg);
            assert(estimate.work_units == 3 * work and estimate.transfer_bytes == 3 * transfer,
                "independent defaults and explicit zero retained");
            array_push(records, estimate);
            t = t + 1;
        }
        w = w + 1;
    }
    p = p + 1;
}
let cfg = map{ format: "pblang.compute.policy.v1" };
assert(CP.estimate_work(2, cfg).work_units == 2, "missing workload defaults to generic");
let unusual = [nil, true, 9, [], map{}, "NUMERIC"];
p = 0;
while p < len(unusual) {
    cfg.workload = unusual[p];
    assert(CP.estimate_work(2, cfg).transfer_bytes == 16, "raw unknown workload retains generic defaults");
    p = p + 1;
}
let infinity = num_pow(2.0, 1100.0);
let invalid = [-1, 0.5, "7", [], map{}, false, infinity, infinity - infinity, 1000000001];
p = 0;
while p < len(invalid) {
    cfg = map{ format: "pblang.compute.policy.v1", work_units_per_item: invalid[p], transfer_bytes_per_item: 0 };
    assert((try CP.estimate_work(0, cfg) catch "rejected") == "rejected", "even empty estimates validate explicit work");
    cfg.work_units_per_item = 1; cfg.transfer_bytes_per_item = invalid[p];
    assert((try CP.estimate_work(0, cfg) catch "rejected") == "rejected", "even empty estimates validate explicit transfer");
    p = p + 1;
}
cfg = CP.policy(map{ preferred_device: "cpu", max_workers: 1 });
let first = CP.estimate_work(2, cfg);
cfg.work_units_per_item = nil; cfg.transfer_bytes_per_item = nil; cfg.workload = "training";
let second = CP.select_device(2, [], cfg).estimate;
assert(first.work_units == 2 and second.work_units == 16384, "changed workload defaults are fresh");
second.work_units = 0;
assert(CP.estimate_work(2, cfg).work_units == 16384, "returned estimates are detached");
assert(cfg.work_units_per_item == nil and cfg.transfer_bytes_per_item == nil, "caller policy remains unchanged");
print "compute_estimate_defaults_pass|" + str(len(records)) + "|" + sha256(json_stringify(records));
