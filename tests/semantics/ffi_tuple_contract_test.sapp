let FFI = import("stdlib:ffi_tuple_contract.sapp");

fn require(value, message) { if not value { throw "FAIL ffi tuple contract: " + message; } }

fn rejected(row, reason) {
    let result = FFI.build([row]);
    require(not result.ok and result.error == reason, reason);
}

fn base() {
    return map{ format: FFI.FORMAT, method_id: "math.add", library_id: "math.fixed",
        library_sha256: str_repeat("a", 64), symbol: "pb_math_add",
        library_digest_algorithm: "sha256-raw-library-bytes-v1",
        signature: "i64,i64->i64", call_mode: "c", platform: "linux",
        architecture: "x86_64", max_args: 2, max_input_bytes: 64,
        max_output_bytes: 32 };
}

let first = base();
let registry = FFI.build([first]);
require(registry.ok and registry.method_count == 1 and registry.exact_schema
    and not registry.grants_capability and not registry.loads_libraries
    and not registry.calls_symbols, "valid metadata contract is effect-free");
let ready = FFI.readiness(registry);
require(ready.contract_shape_valid and not ready.runtime_signature_tuple_enforced
    and not ready.raw_ffi_builtin_bypass_blocked
    and not ready.immutable_library_identity_enforced
    and not ready.production_execution_ready,
    "raw FFI bypass keeps runtime readiness false");

let reordered = base(); reordered.method_id = "alpha.sum";
let second = base(); second.method_id = "zeta.sum"; second.symbol = "pb_math_sum";
require(FFI.build([second, reordered]).registry_sha256
    == FFI.build([reordered, second]).registry_sha256,
    "registry digest is independent of declaration order");

let extra = base(); extra.untrusted = true; rejected(extra, "exact-schema-required");
let bad_digest = base(); bad_digest.library_sha256 = str_repeat("A", 64); rejected(bad_digest, "invalid-library-digest");
let bad_algorithm = base(); bad_algorithm.library_digest_algorithm = "sha256-file-v0"; rejected(bad_algorithm, "unsupported-library-digest-algorithm");
let bad_symbol = base(); bad_symbol.symbol = "pb-math"; rejected(bad_symbol, "invalid-symbol");
let pointer = base(); pointer.signature = "ptr,i64->i64"; rejected(pointer, "unsafe-or-invalid-signature");
let callback = base(); callback.signature = "callback->i64"; callback.max_args = 1; rejected(callback, "unsafe-or-invalid-signature");
let variadic = base(); variadic.signature = "i64,...->i64"; rejected(variadic, "unsafe-or-invalid-signature");
let mode = base(); mode.call_mode = "stdcall"; rejected(mode, "unsupported-call-mode");
let system = base(); system.platform = "android"; rejected(system, "unsupported-platform");
let arch = base(); arch.architecture = "armv7"; rejected(arch, "unsupported-architecture");
let args = base(); args.max_args = 1; rejected(args, "argument-bound-mismatch");
let duplicate = FFI.build([base(), base()]);
require(not duplicate.ok and duplicate.error == "duplicate-method-id", "duplicate IDs fail closed");
let alias = base(); alias.method_id = "math.alias";
let tuple_duplicate = FFI.build([base(), alias]);
require(not tuple_duplicate.ok and tuple_duplicate.error == "duplicate-ffi-tuple",
    "duplicate tuples fail closed even under another method ID");
let confusable = base(); confusable.method_id = "math.\u0430dd";
rejected(confusable, "invalid-method-id");

print "ffi_tuple_contract_pass";
