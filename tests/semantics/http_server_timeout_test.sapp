// http_server_timeout_test.sapp
// Verify serve_once_timeout and SSE helpers are exported (timeout_ms=0 = no-op timeout).
import "stdlib:http_server.sapp";

if type(http_server.serve_once_timeout) != "function" {
    print "FAIL serve_once_timeout not a function";
}
if type(http_server.serve_forever_timeout) != "function" {
    print "FAIL serve_forever_timeout not a function";
}
if type(http_server.sse_event) != "function" {
    print "FAIL sse_event not a function";
}
let h = http_server.res_sse_headers();
if h.content_type != "text/event-stream" {
    print "FAIL res_sse_headers content_type";
}
let frame = http_server.sse_event("ping", "hello");
if str_index_of(frame, "event: ping") < 0 or str_index_of(frame, "data: hello") < 0 {
    print "FAIL sse_event format";
}
print "http_server_timeout_pass";
