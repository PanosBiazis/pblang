// http_server_timeout_test.sapp
// Verify bounded timeout APIs and SSE helpers are exported.
// NOTE: pblang's `type()` returns "closure" / "fn" / "builtin" for the three
// distinct callable kinds; `is_fn(x)` is the right callable-check primitive.
import "stdlib:http_server.sapp";

if is_fn(http_server.serve_once_timeout) == false {
    throw "FAIL serve_once_timeout not a function";
}
if is_fn(http_server.serve_forever_timeout) == false {
    throw "FAIL serve_forever_timeout not a function";
}
if is_fn(http_server.serve_bounded_listener) == false {
    throw "FAIL serve_bounded_listener not a function";
}
if is_fn(http_server.bounded_server_policy) == false {
    throw "FAIL bounded_server_policy not a function";
}
if is_fn(http_server.sse_event) == false {
    throw "FAIL sse_event not a function";
}
let h = http_server.res_sse_headers();
if h.content_type != "text/event-stream" {
    throw "FAIL res_sse_headers content_type";
}
let frame = http_server.sse_event("ping", "hello");
if str_index_of(frame, "event: ping") < 0 or str_index_of(frame, "data: hello") < 0 {
    throw "FAIL sse_event format";
}
print "http_server_timeout_pass";
