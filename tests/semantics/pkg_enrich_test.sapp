// tests/semantics/pkg_enrich_test.sapp — enrichment for stdlib/pkg.sapp

let K = import("stdlib/pkg.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── semver_inc ──────────────────────────────────────────────────────────────────────
eq(K.semver_inc("1.2.3", "patch"), "1.2.4", "bump patch");
eq(K.semver_inc("1.2.3", "minor"), "1.3.0", "bump minor resets patch");
eq(K.semver_inc("1.2.3", "major"), "2.0.0", "bump major resets minor+patch");

// ── semver_valid ──────────────────────────────────────────────────────────────────
if not K.semver_valid("1.2.3") { fail("1.2.3 valid"); }
if K.semver_valid("1.2") { fail("1.2 invalid (needs 3)"); }
if K.semver_valid("1.2.x") { fail("non-numeric invalid"); }
if K.semver_valid("1.2.3.4") { fail("four parts invalid"); }
if K.semver_valid("") { fail("empty invalid"); }

// ── semver_max ──────────────────────────────────────────────────────────────────────
eq(K.semver_max(["1.0.0", "2.3.1", "2.3.0", "0.9.9"]), "2.3.1", "max version");
eq(K.semver_max([]), nil, "empty -> nil");

print "pkg_enrich_pass";
