let IDE = import("stdlib:ide_features.sapp");

fn fail(message) { throw "FAIL ide_source_build: " + message; }

let found = false;
let targets = IDE.ide_execution_targets(); let i = 0;
while i < len(targets) {
    if targets[i].name == "c99-hosted" and targets[i].input == "pblang-source" { found = true; }
    i = i + 1;
}
if not found { fail("PBIDE target catalog does not expose c99-hosted"); }

let built = IDE.ide_source_build("fn main() { return 42; }", "c99-hosted");
if not built.ok or built.kind != "portable-c-source" { fail("PBIDE C99 source build failed"); }
if not str_contains(built.artifact, "double pb_main(") { fail("PBIDE C99 artifact missing pblang main"); }

let closure = IDE.ide_source_build(
    "fn outer(x) { return fn(y) { return x + y; }; } let f = outer(40); print f(2);",
    "c99-hosted");
if not closure.ok or not str_contains(closure.artifact, "pb_closure_new(pb_lambda_") {
    fail("PBIDE C99 source build did not convert a numeric closure");
}
let rejected = IDE.ide_source_build("import \"missing.sapp\"; print 1;", "c99-hosted");
if rejected.ok { fail("PBIDE C99 source build accepted an unresolved import"); }

let project_modules = map{
    "ui/math.sapp": "const VALUE = 42; fn answer() { return VALUE; } export answer;",
    "ui/screen.sapp": "let M = import(\"math.sapp\"); fn render() { return M.answer(); } export render;"
};
let project = IDE.ide_source_build("let Screen = import(\"../ui/screen.sapp\"); print Screen.render();",
    "c99-hosted", map{ modules: project_modules, entry_path: "app/main.sapp" });
if not project.ok or project.link.modules != 2 or str_contains(project.artifact, "import(")
    or not str_contains(project.artifact, "static double __pbi0_VALUE = 0;") {
    fail("PBIDE did not build the complete in-memory project snapshot");
}
let escaped = IDE.ide_source_build("let X = import(\"../../outside.sapp\");", "c99-hosted",
    map{ modules: map{}, entry_path: "app/main.sapp" });
if escaped.ok { fail("PBIDE project build accepted an escaping import"); }

print "ide_source_build_pass";
