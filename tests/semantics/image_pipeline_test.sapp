let IMAGE = import("stdlib:image_pipeline.sapp");

fn fail(message) { throw "FAIL image_pipeline: " + message; }
fn expect(condition, message) { if not condition { fail(message); } }
fn rejects(callable, message) {
    let rejected = try { callable(); false } catch true;
    expect(rejected, message);
}

let source = [
    [[255, 0, 0, 255], [0, 255, 0, 128], [0, 0, 255, 64]],
    [[255, 255, 255, 255], [0, 0, 0, 0], [20, 40, 60, 200]]
];

let encoded = IMAGE.encode_png(source);
let decoded = IMAGE.decode_png(encoded);
expect(decoded.width == 3 and decoded.height == 2, "PNG dimensions round trip");
expect(decoded.image == source, "PNG RGBA and alpha round trip exactly");

let gray = IMAGE.grayscale(source);
expect(gray[0][0] == [76, 76, 76, 255], "grayscale uses bounded luminance");
expect(gray[0][1][3] == 128 and gray[1][1][3] == 0,
    "grayscale preserves alpha");

let rotated = IMAGE.rotate(source, 270);
expect(len(rotated) == 3 and len(rotated[0]) == 2,
    "270-degree rotation swaps dimensions");
expect(rotated[0][0] == source[0][2], "270-degree orientation is deterministic");

let arbitrary = IMAGE.rotate(source, 45);
let arbitrary_size = IMAGE.dimensions(arbitrary);
expect(arbitrary_size.width == 4 and arbitrary_size.height == 4,
    "arbitrary rotation publishes bounded transparent canvas");

let cropped = IMAGE.crop(source, 1, 0, 99, 99);
expect(cropped.width == 2 and cropped.height == 2,
    "crop clips to source bounds");
expect(cropped.image[0][0] == source[0][1], "crop preserves source pixels");

let thumb = IMAGE.thumbnail(source, 2);
expect(len(thumb) == 1 and len(thumb[0]) == 2,
    "thumbnail preserves aspect ratio and never upscales");

let histogram = IMAGE.histogram(source);
expect(histogram.pixels == 6 and len(histogram.red) == 256,
    "histogram has exact RGBA bins");
expect(histogram.red[255] == 2 and histogram.alpha[255] == 2,
    "histogram counts exact channel values");

let same = IMAGE.compare(source, source);
expect(same.comparable and same.identical and same.similarity == 1,
    "exact compare identifies equal images");
let changed = IMAGE.compare(source, IMAGE.flip(source, true));
expect(changed.comparable and not changed.identical and changed.differing_pixels > 0,
    "compare reports changed pixels");

let marked = IMAGE.watermark(source, "PB", "center");
expect(IMAGE.dimensions(marked.image).pixels == 6,
    "watermark preserves bounded dimensions");

rejects(fn() { IMAGE.resize(source, 0, 1); }, "zero-width resize fails closed");
rejects(fn() { IMAGE.crop(source, 9, 0, 1, 1); }, "out-of-range crop fails closed");
rejects(fn() { IMAGE.rotate(source, 0.0 / 0.0); }, "non-finite rotation fails closed");
rejects(fn() { IMAGE.watermark(source, "", "center"); }, "empty watermark fails closed");

print "image_pipeline_test: 18 checks passed";
