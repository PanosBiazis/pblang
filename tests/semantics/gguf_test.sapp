let GGUF = import("stdlib:gguf.sapp");
let FLOAT = import("stdlib:floatn.sapp");

fn fail(message) { throw "FAIL " + message; }
fn expect(value, message) { if not value { fail(message); } }
fn rejects(callable, message) { let rejected = false; try { callable(); } catch { rejected = true; } expect(rejected, message); }
fn append(out, values) { for i len(values) { out[len(out)] = values[i]; } return out; }
fn u64(value) { let out = []; let n = value; for i 8 { out[i] = n % 256; n = num_floor(n / 256); } return out; }
fn f32le(value) { let b = FLOAT.pack([value], "f32"); return [b[3], b[2], b[1], b[0]]; }
fn fixture(overlap = false) {
    let second_start = if overlap { 4 } else { 8 };
    let header = json_stringify(map{
        "z.bias": map{ dtype: "F32", shape: [2], data_offsets: [second_start, second_start + 8] },
        "a.weight": map{ dtype: "F32", shape: [2], data_offsets: [0, 8] },
        "__metadata__": map{ format: "pt" }
    });
    let raw = str_to_bytes(header); let out = u64(len(raw)); append(out, raw);
    let values = [1.0, 2.0, 3.0, 4.0];
    for i len(values) { append(out, f32le(values[i])); }
    return out;
}

fn test_safetensors_to_gguf_v3() {
    let first = GGUF.convert_safetensors(fixture(), map{
        architecture: "pblang-test", model_name: "tiny-linear",
        metadata: map{ "general.description": "PBLang fixture", "tokenizer.ggml.tokens": ["a", "b"] },
        tensor_name_map: map{ "a.weight": "block.weight", "z.bias": "block.bias" }
    });
    let second = GGUF.convert_safetensors(fixture(), map{
        architecture: "pblang-test", model_name: "tiny-linear",
        metadata: map{ "general.description": "PBLang fixture", "tokenizer.ggml.tokens": ["a", "b"] },
        tensor_name_map: map{ "a.weight": "block.weight", "z.bias": "block.bias" }
    });
    let info = GGUF.inspect(first.bytes);
    expect(info.valid_header and info.valid_directory and info.valid_data_ranges
        and info.version == 3 and info.tensor_count == 2 and len(info.tensors) == 2,
        "output has a fully validated GGUF v3 directory and tensor ranges");
    expect(first.bytes == second.bytes and first.deterministic,
        "conversion ordering and bytes are deterministic");
    expect(first.data_offset % 32 == 0 and first.output_bytes == len(first.bytes),
        "tensor data starts at the advertised alignment");
}

fn test_gguf_conversion_boundaries() {
    let defaults = GGUF.convert_safetensors(fixture(), map{ architecture: "x" });
    expect(defaults.model_name == "x" and defaults.metadata_count == 4,
        "omitted optional conversion settings use deterministic defaults");
    rejects(fn() { GGUF.parse_safetensors(fixture(true)); }, "overlapping tensor ranges are rejected");
    rejects(fn() { GGUF.convert_safetensors(fixture(), map{ architecture: "x", model_name: "x", tensor_name_map: map{ missing: "x" } }); },
        "unknown tensor renames are rejected");
    rejects(fn() { GGUF.convert_safetensors(fixture(), map{ architecture: "x", model_name: "x", tensor_name_map: map{ "a.weight": "same", "z.bias": "same" } }); },
        "duplicate destination tensor names are rejected");
}
