// Run from an isolated repository fixture. Replace only its native dependency;
// the subject is the actual owning module, not a copied publication algorithm.
let subject="tests/fixtures/.windows_dirfs_fault_subject.sapp";
assert(not fs_exists(subject),"fresh fixture subject required");
let source=fs_read("stdlib/windows_dirfs.sapp");
let patched=str_replace_all(source,"import(\"stdlib:windows_native_abi.sapp\")",
    "import(\"tests/fixtures/windows_dirfs_fault_abi.sapp\")");
assert(patched!=source,"exact native boundary substituted");fs_write(subject,patched);
let Mock=import("tests/fixtures/windows_dirfs_fault_abi.sapp");
let W=import("tests/fixtures/.windows_dirfs_fault_subject.sapp");
let fs=map{abi:map{},root_handle:10,closed:false};
Mock.reset(true,false);
let published=W.write_atomic(fs,"nested/value.bin",[1,2,3],false);
assert(not published.ok and published.published,"publication survives cleanup failure evidence");
assert(not published.destination_parent_closed,"failed parent close is visible");
assert(Mock.counts().renames==1 and Mock.counts().deletes==0,"never delete already published file");
Mock.reset(true,false);
let moved=W.move(fs,"source.bin","nested/value.bin",true);
assert(not moved.ok and moved.published and Mock.counts().deletes==0,"move reports completed effect on cleanup failure");
Mock.reset(false,true);
let rejected=W.write_atomic(fs,"nested/value.bin",[1,2,3],false);
assert(not rejected.ok and not (try rejected.published catch false),"failed rename is not publication");
assert(Mock.counts().deletes==1,"unpublished stage removed");
Mock.reset(false,false);
assert(W.write_atomic(fs,"nested/value.bin",[1,2,3],false).ok,"normal publication still succeeds");
assert(Mock.counts().buffers==0,"modeled buffers released");
fs_remove(subject);print "windows_dirfs_publication_fault_pass";
