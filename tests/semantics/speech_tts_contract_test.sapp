let TTS=import("stdlib:speech_tts.sapp");
let PCM=import("stdlib:audio_pcm.sapp");
fn expect(value,message){if not value{throw "FAIL speech TTS: "+message;}}
fn rejected(work){return try { work(); false } catch true;}

let captured=map{};let fixture=PCM.encode_wav(map{format:PCM.FORMAT,sample_rate:16000,
    channels:1,samples:[0,1000,0,-1000]});
let backend=map{run:fn(argv,stdin_bytes){captured.argv=argv;captured.stdin=stdin_bytes;
    return map{ok:true,command_ok:true,completed:true,stdout_bytes:fixture,output_truncated:false,
        executable_descriptor_held:true,process_group_terminated:true,memory_limit_enforced:true};}};
let result=TTS.synthesize_with_backend("hello","default",175,50,false,backend);
expect(result.ok and result.executed and result.voice=="en" and result.frames==4
    and result.descriptor_bound_executable and result.process_group_terminated,
    "validated PCM16 WAV is returned from a supervised fixed engine");
expect(bytes_to_str(captured.stdin)=="hello" and not str_contains(str(captured.argv),"hello"),
    "caller text is stdin-only");
let ssml=TTS.synthesize_with_backend("<speak>Hello</speak>","en",180,45,true,backend);
expect(ssml.ok and ssml.ssml and captured.argv[len(captured.argv)-1]=="-m",
    "bounded SSML mode is explicit");
expect(rejected(fn(){TTS.validate_ssml("<!DOCTYPE x><speak>x</speak>");})
    and rejected(fn(){TTS.synthesize_with_backend("", "en",175,50,false,backend);})
    and rejected(fn(){TTS.synthesize_with_backend("hello","../voice",175,50,false,backend);}),
    "declarations, empty text, and path-like voices fail closed");
print "speech_tts_contract_pass";
