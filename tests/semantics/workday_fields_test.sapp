let F=import("stdlib:workday_fields.sapp");assert(F.parse(" 1, 3,7 ","2026-09-28\n2026-10-01")==map{weekdays:[0,2,6],closed:["2026-09-28","2026-10-01"]},"human fields to strict calendar");assert(F.parse("1","").closed==[],"empty closure list");for args in [["", ""],["1,1",""],["0",""],["8",""],["1.0",""],["1,",""],["1","2026-02-30"],["1","2026-09-28,"],["1","2026-09-28,2026-09-28"],[nil,""],["1",str_repeat("a",4097)]]{assert((try F.parse(args[0],args[1]) catch nil)==nil,"malformed fields reject");}print "workday_fields_pass";
