// provider_registry_test.sapp
// Behavior for stdlib:provider_registry.sapp (A4-beta+).

import "stdlib:provider_registry.sapp";

// Empty registry → error map
let r0 = provider_registry.call_best("hello", "gpt-4o");
if r0.error != "no providers registered" {
    throw "FAIL empty registry";
}

// All providers fail → call_with_fallback returns aggregate error.
// The underlying http.post_auth calls may error or return nil; call_with_fallback
// treats non-nil maps with `error` as failure and falls through to the final error.
provider_registry.register("p1", "https://example.invalid/one", "test-api-key-fake-1");
provider_registry.register("p2", "https://example.invalid/two", "test-api-key-fake-2");
let rf = provider_registry.call_with_fallback("hello", "gpt-4o");
if rf.error != "all providers failed" {
    throw "FAIL all providers failed";
}

print "provider_registry_test: pass";
