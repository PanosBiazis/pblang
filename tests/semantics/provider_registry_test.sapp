// tests/semantics/provider_registry_test.sapp — A4-beta provider registry test
import "stdlib:provider_registry.sapp";

// Register a mock provider with a chat method
let my_provider = map{
    chat: fn(args) { return "response:" + str(args); }
};
provider_registry.register("openai", my_provider);

// get returns the registered provider
let p = provider_registry.get("openai");
if p == nil { print "get_nil FAIL"; }

// list returns names
let names = provider_registry.list();
if len(names) != 1 { print "list_len FAIL: " + str(len(names)); }

// call_provider invokes the method
let result = provider_registry.call_provider("openai", "chat", "hello");
if str_contains(result, "response") != true { print "call_provider FAIL: " + str(result); }

// get on missing name returns nil
let missing = provider_registry.get("anthropic");
if missing != nil { print "missing_not_nil FAIL"; }

// call_provider on missing name returns nil
let nil_result = provider_registry.call_provider("missing", "chat", "x");
if nil_result != nil { print "call_missing_not_nil FAIL"; }

print "provider_registry_test: pass";
