// tests/semantics/native_value_test.sapp — native mode returning ARBITRARY integers (not just
// a 0..255 exit code): the generated binary writes its 64-bit result to stdout and pblang
// reads it back. This is what makes native mode actually usable by libraries.

let NA = import("stdlib/native.sapp");
let CP = import("stdlib/compute.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

if NA.host_arch() == "x86_64" {
    // sum 1..1000 = 500500 (far beyond an exit code's 0..255)
    eq(NA.run_value([["seti", 0, 0], ["seti", 1, 1000], ["loop", 1, [["add", 0, 1]]]]), 500500, "native value sum 1..1000");
    // big arithmetic: 123456 + 654321 = 777777
    eq(NA.run_value([["seti", 0, 123456], ["seti", 1, 654321], ["add", 0, 1]]), 777777, "native value add");
    // a library (compute) exposing the same capability
    eq(CP.native_value([["seti", 0, 1000000], ["seti", 1, 1], ["add", 0, 1]]), 1000001, "compute.native_value");
}

print "native_value_pass";
