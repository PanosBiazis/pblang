let F=import("stdlib:compiler/selfhost_frontend.sapp");
// Assert output only: frontend result graphs include closures and globals.
let source="let C=import(\"stdlib:file_catalog.sapp\"); print C.classify(\"C:\\\\private\\\\main.py\").name; print C.classify(\"x.tar.gz\").suffix; print C.classify(\".sapp\").label; print C.classify(\"README\").known;";
let result=F.frontend_run(source);
assert(result.ok and result.output==["main.py",".tar.gz","PBLang Source",false],"selfhost classifier parity");
print "selfhost_file_catalog_pass";
let contract=fs_read("tests/fixtures/selfhost_file_catalog_summary.sapp");
let summary=F.frontend_run(contract);
assert(summary.ok and summary.output==["file_catalog_summary_contract_pass"],"selfhost summary contract");
print "selfhost_file_catalog_summary_pass";
