let Web=import("../../examples/uno_r4_led_studio/web.sapp");
let Model=import("../../examples/uno_r4_led_studio/model.sapp");
let Upload=import("../../examples/uno_r4_led_studio/web_upload.sapp");
fn req(method,path="/",body="",content_type="application/x-www-form-urlencoded") {return map{method:method,path:path,body:body,headers:map{host:"127.0.0.1:8768",origin:"http://127.0.0.1:8768","content-type":content_type}};}
fn hidden(page,key) {return str_split(str_split(page.body,"name=\""+key+"\" value=\"")[1],"\"")[0];}
fn multipart(page,payload,action="do_import",text_field="f_text",duration_field="f_duration") {
    let values=map{csrf:hidden(page,"csrf"),revision:hidden(page,"revision"),action:action};values[text_field]="PB";values[duration_field]="250";
    let body="";
    for key in ["csrf","revision","action",text_field,duration_field] {body=body+"--led-boundary\r\nContent-Disposition: form-data; name=\""+key+"\"\r\n\r\n"+values[key]+"\r\n";}
    return body+"--led-boundary\r\nContent-Disposition: form-data; name=\"file\"; filename=\"../ignored.json\"\r\nContent-Type: application/json\r\n\r\n"+payload+"\r\n--led-boundary--\r\n";
}
let mime="multipart/form-data; boundary=led-boundary";
let app=Web.create(8768,map{hide_source_names:false,discourage_scraping:false,throttle_rejected_requests:false});
let first=app.handle(req("GET"));
assert(str_contains(first.body,"type=\"file\"") and str_contains(first.body,"form=\"led-file-import\"") and str_contains(first.body,"Import selected file"),"native file picker and explicit confirmation supplied");
assert(not str_contains(first.body,"<script") and str_contains(first.headers["Content-Security-Policy"],"default-src 'none'"),"script-free CSP preserved");
let css=app.handle(req("GET","/style.css"));assert(str_contains(css.body,":placeholder-shown") and str_contains(css.body,".import-file{display:none}"),"empty paste opens picker; nonempty paste takes priority");
let source=Model.create();Model.apply(source,"preset","heart");let project=Model.export_project(source);
let wire=multipart(first,project);let decoded=Upload.decode(wire,mime,"f_text","f_duration","do_import");assert(decoded.payload==project,"strict multipart preserves exact export bytes");
let wrong=req("POST","/import-file",wire,mime);wrong.headers.origin="https://invalid.example";
let snapshot=Model.export_project(app.state);assert(app.handle(wrong).status==403 and Model.export_project(app.state)==snapshot,"foreign upload rejected atomically");
wrong=req("POST","/import-file",wire,mime);wrong.headers["Content-Type"]=mime;assert(app.handle(wrong).status==400,"case variant duplicate header rejected before normalization");
wrong=req("POST","/import-file",str_join(str_split(wire,hidden(first,"csrf")),str_repeat("0",64)),mime);assert(app.handle(wrong).status==403 and Model.export_project(app.state)==snapshot,"bad token cannot mutate project");
wrong=req("POST","/import-file",str_join(str_split(wire,"name=\"revision\"\r\n\r\n0"),"name=\"revision\"\r\n\r\n999"),mime);assert(app.handle(wrong).status==409,"stale revision rejected");
wrong=req("POST","/import-file",wire,mime);wrong.headers=map{host:"127.0.0.1:8768","content-type":mime};assert(app.handle(wrong).status==403 and Model.export_project(app.state)==snapshot,"missing origin cannot mutate project");
let oversized=multipart(first,str_repeat("x",Upload.MAX_BODY));assert(app.handle(req("POST","/import-file",oversized,mime)).status==400 and Model.export_project(app.state)==snapshot,"total body budget enforced");
let good=app.handle(req("POST","/import-file",wire,mime));assert(good.status==200 and Model.export_project(app.state)==project and not app.state.playing,"uploaded project imported stopped");
assert(app.handle(req("POST","/import-file",wire,mime)).status==403,"upload replay rejected");
for payload in ["","{bad","{\"format\":\"unknown\"}"] {
    let page=app.handle(req("GET"));let old=Model.export_project(app.state);let result=app.handle(req("POST","/import-file",multipart(page,payload),mime));
    assert(result.status==200 and Model.export_project(app.state)==old and str_contains(result.body,"Import rejected: use a validated LED Studio JSON export"),"empty or invalid file gives helpful atomic rejection");
}
let page=app.handle(req("GET"));wire=multipart(page,project);
let malformed=[str_join(str_split(wire,"name=\"file\""),"name=\"action\""),wire+"epilogue",str_join(str_split(wire,"\r\n--led-boundary--\r\n"),"\r\n--led-boundary"),multipart(page,str_repeat("x",131073)),multipart(page,"a"+strfromcharcode(0)),multipart(page,project,"pixel_0")];
for bad in malformed {let before=Model.export_project(app.state);assert(app.handle(req("POST","/import-file",bad,mime)).status==400 and Model.export_project(app.state)==before,"malformed duplicate oversized or wrong-action upload atomic");}
assert(Upload.decode(wire,"multipart/form-data; boundary=\"led-boundary\"","f_text","f_duration","do_import").payload==project,"quoted boundary supported");
assert((try Upload.decode(wire,mime+"; extra=x","f_text","f_duration","do_import") catch nil)==nil,"ambiguous boundary rejected");
assert(app.handle(req("POST","/import-file",wire,mime)).status==200,"malformed requests do not consume valid token");
page=app.handle(req("GET"));let stale_wire=multipart(page,project);
let edit="csrf="+hidden(page,"csrf")+"&revision="+hidden(page,"revision")+"&action=pixel_0&f_text=PB&f_duration=250";
assert(app.handle(req("POST","/action",edit)).status==200,"intervening editor change succeeds");
let edited=Model.export_project(app.state);assert(app.handle(req("POST","/import-file",stale_wire,mime)).status==403 and Model.export_project(app.state)==edited,"stale file form cannot overwrite newer edits");app.close();
assert(app.handle(req("POST","/import-file",wire,mime)).status==503,"closed upload surface revoked");
let defaults=Web.create();page=defaults.handle(req("GET"));let action_parts=str_split(str_split(page.body,"class=\"import-paste\"")[0],"value=\"");let action=str_split(action_parts[len(action_parts)-1],"\"")[0];
let result=defaults.handle(req("POST","/import-file",multipart(page,project,action,"f_99","f_100"),mime));assert(result.status==200 and Model.export_project(defaults.state)==project,"default opaque field and action identities supported");defaults.close();
print "uno_r4_led_studio_upload_pass";
