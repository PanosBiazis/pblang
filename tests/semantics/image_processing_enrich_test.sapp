// tests/semantics/image_processing_enrich_test.sapp — enrichment for stdlib/image_processing.sapp
// Adds sepia, gamma_correct, posterize, rotate180.

let img = import("stdlib/image_processing.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base invert still works (scalar pixels) ──────────────────────────────────────
let inv = img.invert_colors([[0, 255]]);
eq(inv[0][0], 255, "invert 0->255"); eq(inv[0][1], 0, "invert 255->0");

// ── ENRICH: rotate180 (scalar pixel grid) ────────────────────────────────────────
let r = img.rotate180([[1, 2], [3, 4]]);
eq(r[0][0], 4, "rotate180 [0][0]"); eq(r[0][1], 3, "rotate180 [0][1]");
eq(r[1][0], 2, "rotate180 [1][0]"); eq(r[1][1], 1, "rotate180 [1][1]");

// ── ENRICH: posterize (2 levels snaps to 0/255) ──────────────────────────────────
let po = img.posterize([[100, 200]], 2);
eq(po[0][0], 0, "posterize 100 -> 0"); eq(po[0][1], 255, "posterize 200 -> 255");

// ── ENRICH: gamma_correct (gamma 1 = identity) ───────────────────────────────────
let gc = img.gamma_correct([[128]], 1);
eq(gc[0][0], 128, "gamma 1 is identity");

// ── ENRICH: sepia (RGB pixel) ────────────────────────────────────────────────────
let sp = img.sepia([[[100, 150, 200]]]);
let px = sp[0][0];
if type(px) != "array" or len(px) != 3 { fail("sepia returns rgb pixel"); }
eq(px[0], 192, "sepia red channel (0.393*100+0.769*150+0.189*200)");

print "image_processing_enrich_pass";
