let A=import("stdlib:source_analysis.sapp");
fn expect(ok,label) {if not ok {throw "FAIL source-analysis-limits: "+label;}}
let message="max_findings must be a finite integer in 1..1024";
let source="let strategy=\"slow path\";\nlet other=\"slow path\";\n";
let rejection=map{ok:false,passed:false,format:A.FORMAT,error:message};
// Regression first: old code accepts a fractional cap and can retain two rows.
expect(json_stringify(A.analyze(source,"limit-fixture.sapp",map{analyses:["performance"],max_findings:1.5}))==json_stringify(rejection),"fractional cap rejected");
let default_limit=map{ok:true,max_findings:256};
expect(json_stringify(A.limits())==json_stringify(default_limit),"exact default schema");
expect(json_stringify(A.limits(nil))==json_stringify(default_limit),"nil options default");
let detached_default=A.limits();detached_default.max_findings=0;
expect(json_stringify(A.limits())==json_stringify(default_limit),"default fast path returns independent result");
let invalid=[nil,true,false,"private-limit-marker",[],map{},fn(){return 1;},
    parse_number("NaN"),parse_number("inf"),parse_number("-inf"),
    bigint(1),rational("1/1"),decimal("1"),0,-1,1025,1.5];
for value in invalid {
    let options=map{max_findings:value,analyses:["performance"]};
    expect(json_stringify(A.limits(options))==json_stringify(map{ok:false,error:message}),"value-free admission error");
    expect(json_stringify(A.analyze(source,"private-source-marker",options))==json_stringify(rejection),"structured analysis error without source or value");
    // Even a malformed trusted report must not be accessed before limit admission.
    expect(json_stringify(A.analyze(source,"private-source-marker",map{max_findings:value,security_report:map{}}))==json_stringify(rejection),"limits before analyzer work");
}
for value in [1,256,1024] {
    let options=map{max_findings:value,unrelated:"untouched"};let before=json_stringify(options);
    let result=A.limits(options);
    expect(result.ok and result.max_findings==value and len(map_keys(result))==2,"valid boundaries and schema");
    result.max_findings=0;
    expect(json_stringify(options)==before and A.limits(options).max_findings==value,"no input mutation or result alias");
    let report=A.analyze(source,"limit-fixture.sapp",map{analyses:["performance"],max_findings:value,fail_on_findings:true});
    expect(report.ok and not report.passed and report.finding_count==if value==1 {1} else {2},"exact retained finding cap");
}
for options in [true,1,"private-limit-marker",[],fn(){return 1;}] {
    expect(json_stringify(A.limits(options))==json_stringify(map{ok:false,error:"source analysis limits require map options"}),"non-map options rejected");
}
let unknown=A.analyze(source,"private-source-marker",map{analyses:["unknown"],max_findings:parse_number("NaN")});
expect(not unknown.ok and unknown.error=="no valid analysis category selected","category error precedence unchanged");
let bad_source=A.analyze(nil,"private-source-marker",map{max_findings:0});
expect(not bad_source.ok and bad_source.error=="source analysis requires text and map options","source type precedence unchanged");
let blocking=A.analyze("danger_accept_invalid_certs();","limit-fixture.sapp",map{max_findings:1});
expect(blocking.ok and not blocking.passed and blocking.finding_count==1,"small cap does not suppress blocking security");
print "source_analysis_limits_pass";
