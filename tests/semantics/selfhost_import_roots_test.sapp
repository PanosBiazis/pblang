let R=import("stdlib:compiler/import_roots.sapp");
let M=import("stdlib:compiler/module_cache.sapp");
let F=import("stdlib:compiler/selfhost_frontend.sapp");
let good=R.from_manifest("[package]\nname=\"test\"\n[dependencies]\nstdlib = {path=\"../pb/stdlib\", paths=[\"stdlib\"]} # comment\n");
assert(good.selected and R.resolve("stdlib:json.sapp",good)=="../pb/stdlib/json.sapp","declared sibling root");
assert(R.resolve("stdlib/json.sapp",good)=="../pb/stdlib/json.sapp","legacy spelling follows same root");
assert(R.resolve("src/a.sapp",good)=="src/a.sapp","local import contract");
assert(not R.from_manifest("[package]\nname=\"test\"\n").selected,"legacy absence");
for text in [
    "[dependencies]\nstdlib=\"1.0\"", "[dependencies]\nstdlib={git=\"x\"}",
    "[dependencies]\nstdlib={path=\"a\",path=\"b\"}",
    "[dependencies]\nstdlib={path=\"a\"}\nstdlib={path=\"b\"}",
    "[dependencies]\n[dependencies]\n", "[dependencies.stdlib]\npath=\"a\"",
    "[dependencies]\n\"stdlib\"={path=\"a\"}","dependencies.stdlib.path=\"a\"",
    "[dependencies]\nstdlib={path=\"a\\b\"}","[dependencies]\nstdlib={path=\"a\"} junk"
] {assert((try {R.from_manifest(text);false}catch true),"unsupported explicit declaration rejects");}
for suffix in ["", "../x", "/x", "a//b", "a/./b", "a\\b"] {
    assert((try {R.resolve("stdlib:"+suffix,good);false}catch true),"suffix cannot escape declared root");
}
let a=M.default_dependency_paths();let b=M.default_dependency_paths();a[0]="changed";
assert(b[0]!="changed","fresh fingerprint path lists");
fs_mkdirs("/tmp/root-a");fs_mkdirs("/tmp/root-b");
fs_write("/tmp/root-a/value.sapp","let value=11;export value;");
fs_write("/tmp/root-b/value.sapp","let value=22;export value;");
let source="let m=import(\"stdlib:value.sapp\");print m.value;";
assert(F.frontend_run(source,map{stdlib_root:"/tmp/root-a"}).output==[11],"explicit root A");
assert(F.frontend_run(source,map{stdlib_root:"/tmp/root-b"}).output==[22],"separate explicit root B");
let missing=F.frontend_run("let m=import(\"stdlib:json.sapp\");print len(map_keys(m));",map{stdlib_root:"/tmp/root-b"});
assert(missing.output==[0],"selected missing import never loads cwd shadow");
for root in ["/tmp/root-a","/tmp/root-b","stdlib"] {
    let options=map{stdlib_root:root,module_cache_root:"/tmp/rejected-cache"};
    assert((try {F.frontend_run_bounded(source,options);false}catch true),"unproven compiler identity rejects cache");
    assert(not fs_exists("/tmp/rejected-cache"),"cache rejection precedes publication");
}
fs_write("/tmp/root-a/value.sapp","let value=33;export value;");
assert((try {F.frontend_run_bounded(source,map{stdlib_root:"/tmp/root-b",module_cache:true});false}catch true),"root change cannot forge compiler fingerprint");
let noimports=try {F.frontend_run_bounded("print 1;",map{stdlib_root:"/tmp/root-b",module_cache:true,module_cache_root:"/tmp/noimport-cache"});false} catch true;
assert(noimports,"explicit root cache rejects without imports");
assert(not fs_exists("/tmp/noimport-cache"),"no-import rejection before cache publication");
print "selfhost_import_roots_pass";
