let W=import("editors/ide/pbide_text_web.sapp");
let H=import("editors/ide/pbide_text_history.sapp");
let C=import("editors/ide/pbide_history_wire.sapp");
let T=import("editors/ide/pbide_text.sapp");
fn form(source,start,end,op,history=nil,insert="") {
    let body="source="+url_encode(source)+"&start="+str(start)+"&end="+str(end)
        +"&insert="+url_encode(insert)+"&op="+op+"&pair=round";
    if history!=nil { body=body+"&history="+url_encode(C.encode(history)); }
    return body;
}
fn rejects(f) { let failed=false; try { f(); } catch { failed=true; } return failed; }
let initial=H.create(T.selection("α😀β",1,2),C.BUDGET);
let edited=W.parse_history(form("α😀β",1,2,"pair",initial));
assert(H.current(edited).text=="α(😀)β" and len(edited.frames)==2,"Web edit retained in history");
let undone=W.parse_history(form("α(😀)β",2,3,"undo",edited));
assert(H.current(undone).text=="α😀β" and H.current(undone).start==1,"Web undo restores text and selection");
let redone=W.parse_history(form("α😀β",1,2,"redo",undone));
assert(H.current(redone).text=="α(😀)β","Web redo restores operation");
let draft=W.parse_history(form("new typed draft",0,0,"undo",initial));
assert(H.current(draft).text=="α😀β" and H.availability(draft).redo,"manual textarea typing becomes undoable");
let branched=W.parse_history(form("branch",0,0,"redo",undone));
assert(H.current(branched).text=="branch" and not H.availability(branched).redo,"new typing invalidates stale redo before dispatch");
let cleared=W.parse_history(form("α(😀)β",2,3,"clear-history",edited));
assert(len(cleared.frames)==1 and H.current(cleared).text=="α(😀)β","clear history preserves current buffer");
for op in ["undo","redo","clear-history"] {
    assert(rejects(fn(){W.parse_history(form("a",0,0,op));}),"history actions reject legacy form without history");
}
assert(len(W.parse_history(form("a",0,0,"tab")).frames)==2,"legacy edit creates fresh valid history");
let legacy=form("a",0,0,"status");
assert(rejects(fn(){W.parse_history(str_repeat("&",W.MAX_BODY));}),"delimiter flood rejected before token-array allocation");
for bad in [legacy+"&history=",legacy+"&history=wrong",legacy+"&history=x&history=y",
    str_replace_all(legacy,"insert=","%73ource=")+"&history=x"] {
    assert(rejects(fn(){W.parse_history(bad);}),"malformed history/decoded duplicates fail closed");
}
let payload="</textarea><script>synthetic-marker</script>";
let injected=H.create(T.selection(payload),C.BUDGET);
injected=H.commit(injected,T.selection("safe"));
let inert=W.parse_history(form("safe",0,0,"undo",injected));
let html=W.render(H.current(inert),inert);
assert(not str_contains(html,payload) and str_contains(html,"&lt;script&gt;"),"forged valid history is escaped inert text, not trusted provenance");
let maximum=H.create(T.selection(str_repeat("\"",4096)),C.BUDGET);
maximum=H.commit(maximum,T.selection(str_repeat("'",4096)));
let body=form(str_repeat("'",4096),0,0,"status",maximum,str_repeat("&",4096));
assert(len(str_to_bytes(body))<=W.MAX_BODY,"worst escaped form plus full history fits wire limit");
let bounded=W.parse_history(body);
assert(len(str_to_bytes(W.render(H.current(bounded),bounded)))<60000,"escaped maximum page fits response bound with header margin");
let denied_body=legacy+"&history=synthetic-private-marker";
let req=map{method:"POST",path:"/edit",body:denied_body,headers:map{host:"127.0.0.1:18771",
    origin:"http://127.0.0.1:18771","content-type":"application/x-www-form-urlencoded",
    "content-length":str(len(denied_body))}};
let denied=W.handle(req,18771);
assert(denied.status==400 and not str_contains(denied.body,"synthetic-private-marker"),"history errors do not echo input");
print "pbide_web_history_pass";
