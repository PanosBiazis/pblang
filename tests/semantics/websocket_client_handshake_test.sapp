// tests/semantics/websocket_client_handshake_test.sapp
//
// websocket.sapp had the SERVER side of the RFC 6455 opening handshake
// (upgrade_response) and correct framing, but NO client side — so
// networking.sapp reimplemented a WebSocket client badly (hardcoded key,
// no accept verification, unframed raw text on the wire). This locks the
// real client handshake: random key, canonical Sec-WebSocket-Accept, and
// strict verification of the server's 101 response.

let ws = import("stdlib/websocket.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }
fn falsy(c, m) { if c != false { fail(m); } }

// ── client_key(): fresh, valid 16-byte base64 nonce each call ─────────────────
let k1 = ws.client_key();
let k2 = ws.client_key();
eq(len(k1), 24, "16 random bytes base64-encode to 24 chars");
truthy(str_ends_with(k1, "=="), "16-byte base64 ends in == padding");
if k1 == k2 { fail("client_key must be random per call"); }

// ── client_accept_for(key): canonical RFC 6455 §1.3 example ───────────────────
eq(ws.client_accept_for("dGhlIHNhbXBsZSBub25jZQ=="), "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=",
   "accept for the RFC sample nonce");

// ── client_handshake_request(host, path, key): required upgrade headers ───────
let req = ws.client_handshake_request("example.com", "/chat", "dGhlIHNhbXBsZSBub25jZQ==");
truthy(str_starts_with(req, "GET /chat HTTP/1.1\r\n"), "request line");
truthy(str_contains(req, "Host: example.com\r\n"), "Host header");
truthy(str_contains(req, "Upgrade: websocket\r\n"), "Upgrade header");
truthy(str_contains(req, "Connection: Upgrade\r\n"), "Connection header");
truthy(str_contains(req, "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n"), "key header");
truthy(str_contains(req, "Sec-WebSocket-Version: 13\r\n"), "version 13");
truthy(str_ends_with(req, "\r\n\r\n"), "blank line terminates the request");

// ── verify_handshake(response, key): only a correct 101 accept passes ─────────
let key = "dGhlIHNhbXBsZSBub25jZQ==";
let accept = ws.client_accept_for(key);
let good = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\n"
    + "Connection: Upgrade\r\nSec-WebSocket-Accept: " + accept + "\r\n\r\n";
truthy(ws.verify_handshake(good, key), "correct 101 + accept verifies");

// header names are case-insensitive on the wire
let good_lc = "HTTP/1.1 101 Switching Protocols\r\nsec-websocket-accept: " + accept + "\r\n\r\n";
truthy(ws.verify_handshake(good_lc, key), "lowercase accept header still verifies");

// wrong accept value → reject (would mean a broken/hostile peer)
let bad_accept = "HTTP/1.1 101 Switching Protocols\r\nSec-WebSocket-Accept: AAAAwrongAAAA=\r\n\r\n";
falsy(ws.verify_handshake(bad_accept, key), "wrong accept is rejected");

// non-101 status → reject even if an accept header is present
let not_101 = "HTTP/1.1 200 OK\r\nSec-WebSocket-Accept: " + accept + "\r\n\r\n";
falsy(ws.verify_handshake(not_101, key), "non-101 status is rejected");

// missing accept header → reject
let no_accept = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\n\r\n";
falsy(ws.verify_handshake(no_accept, key), "missing accept header is rejected");

print "websocket_client_handshake_pass";
