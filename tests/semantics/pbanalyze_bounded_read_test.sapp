// Linux integration coverage; foreign backends require separate host evidence.
let OS=import("stdlib:os.sapp");
let S=import("stdlib:secure_file.sapp");
if platform()!="linux" {print "pbanalyze_bounded_read_skip_linux_required";os_exit(0);}
let failure_label="unexpected exception";
fn expect(value,label) {if not value {failure_label=label;throw label;}}
// timeout is the immediate parent of the child; /proc/self/exe would name it.
let compiler=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let root=path_join(OS.temp_dir(),"pblang_analysis_read_"+str_slice(sha256(str(now_ms())+str(random_bytes(8))),0,16));
let source=root+".sapp";let link=root+".link.sapp";let fifo=root+".fifo";
let large=root+".large.sapp";let invalid=root+".invalid.sapp";
let parent_link=root+".parent";let config=root+".json";
fn invoke(path,extra) {
    let args=["-k","1s","8s",compiler,"tools/pbanalyze.sapp","--allow-all","--",path,"--analysis=performance"];
    for arg in extra {push(args,arg);}
    return proc_spawn_wait("/usr/bin/timeout",args);
}
fn rejected(path,message) {
    let run=invoke(path,[]);expect(run.exit_code==2,"read rejection is status 2, not timeout/crash");
    let report=json_parse(str_trim(run.stdout));
    expect(len(report)==2 and report.ok==false and report.error==message,"stable minimal error schema");
    expect(not str_contains(run.stdout,root) and not str_contains(run.stdout,"private-source-marker"),"no path or source leakage");
}
fn exercise() {
    fs_write(source,"let value=1; // private-source-marker α\n");
    expect(proc_spawn_wait("/bin/ln",["-s",source,link]).exit_code==0,"symlink fixture created");
    // The old CLI follows this link and incorrectly succeeds.
    rejected(link,"source is unavailable or exceeds byte limit");
    expect(invoke(source,[]).exit_code==0,"valid UTF-8 source accepted");
    expect(invoke("tests/semantics/source_analysis_test.sapp",[]).exit_code==0,"reviewed relative source accepted");
    expect(proc_spawn_wait("/bin/ln",["-s",OS.temp_dir(),parent_link]).exit_code==0,"parent symlink created");
    rejected(parent_link+"/"+path_basename(source),"source is unavailable or exceeds byte limit");
    expect(proc_spawn_wait("/usr/bin/mkfifo",[fifo]).exit_code==0,"FIFO fixture created");
    rejected(fifo,"source is unavailable or exceeds byte limit");
    rejected(root+".absent","source is unavailable or exceeds byte limit");
    rejected(OS.temp_dir(),"source is unavailable or exceeds byte limit");
    expect(S.write_new_exclusive(invalid,[255],false,false).ok,"invalid UTF-8 fixture created");
    expect(S.read_bytes(invalid,1,false).ok and not S.read_bytes(invalid,0,false).ok,"tiny exact-cap success and cap-plus-one rejection");
    rejected(invalid,"source is not valid UTF-8");
    expect(proc_spawn_wait("/usr/bin/truncate",["-s","16777217",large]).exit_code==0,"sparse over-cap fixture created");
    rejected(large,"source is unavailable or exceeds byte limit");
    fs_write(config,json_stringify(map{custom_rules:[nil]}));
    let bad=invoke(link,["--analysis=security","--config="+config]);
    expect(bad.exit_code==2 and json_parse(str_trim(bad.stdout)).error=="invalid security analysis configuration","policy admission still precedes read");
    expect(fs_read(source)=="let value=1; // private-source-marker α\n","source unchanged");
    return true;
}
let succeeded=try exercise() catch false;
for path in [link,parent_link,fifo,large,invalid,source,config] {
    if fs_exists(path) {fs_remove(path);}
}
if not succeeded {throw "FAIL pbanalyze-bounded-read: "+failure_label;}
print "pbanalyze_bounded_read_pass";
