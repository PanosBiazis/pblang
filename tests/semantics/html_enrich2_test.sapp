// tests/semantics/html_enrich2_test.sapp — wave 2 for stdlib/html.sapp
// SECURITY: safe_url neutralizes javascript:/data:/vbscript: URLs (XSS).
// Plus builders: nl2br, heading, option, select.

let H = import("stdlib/html.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : " + s); } }
fn hasnt(s, sub, m) { if str_index_of(s, sub) >= 0 { fail(m + " UNEXPECTEDLY contains " + sub + " : " + s); } }

// ── safe_url: dangerous schemes are neutralized to "#" ────────────────────────────
eq(H.safe_url("https://example.com"), "https://example.com", "https allowed");
eq(H.safe_url("/local/path"), "/local/path", "relative allowed");
eq(H.safe_url("#anchor"), "#anchor", "anchor allowed");
eq(H.safe_url("mailto:a@b.com"), "mailto:a@b.com", "mailto allowed");
eq(H.safe_url("javascript:alert(1)"), "#", "javascript blocked");
eq(H.safe_url("JaVaScRiPt:alert(1)"), "#", "case-insensitive block");
eq(H.safe_url("  javascript:alert(1)"), "#", "leading-space block");
eq(H.safe_url("data:text/html,<script>"), "#", "data: blocked");

// ── a() is hardened: a javascript href must not survive ───────────────────────────
hasnt(H.a("javascript:alert(1)", "click", nil), "javascript:", "a() strips javascript href");
hasnt(H.img("data:text/html,<script>", "x", nil), "data:", "img() strips dangerous src");

// ── nl2br ──────────────────────────────────────────────────────────────────────────
has(H.nl2br("a\nb"), "<br />", "nl2br inserts break");

// ── heading ──────────────────────────────────────────────────────────────────────
eq(H.heading(2, "Hi", nil), "<h2>Hi</h2>", "heading 2");
has(H.heading(9, "Hi", nil), "<h6>", "heading level clamps to 6");

// ── option / select ────────────────────────────────────────────────────────────────
has(H.option("v", "Label", true), "selected", "option selected");
let sel = H.select("color", [map{ value: "r", label: "Red" }, map{ value: "g", label: "Green", selected: true }]);
has(sel, "<select name=\"color\">", "select open tag");
has(sel, "<option value=\"g\" selected>Green</option>", "selected option rendered");

let tbl = H.table(["name", "value"], [["<x>", 1], ["y", "&"]]);
has(tbl, "<th>name</th>", "table header");
has(tbl, "<td>&lt;x&gt;</td>", "table escapes cells");
has(tbl, "<td>&amp;</td>", "table escapes ampersand");

print "html_enrich2_pass";
