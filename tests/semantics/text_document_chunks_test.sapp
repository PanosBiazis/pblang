let D=import("stdlib:text_document.sapp");
fn reject(work){let failed=false;try {work();} catch {failed=true;}assert(failed,"reject invalid chunk request");}
for text in ["","abc","Ελληνικά 😊 é\nline\tend",str_repeat("α😊",500),str_repeat("x",32768)] {
 for limit in [4,7,1024] {
  if len(str_to_bytes(text))>limit*64 {continue;}
  let parts=D.split_text(text,limit);assert(str_join(parts,"")==text,"exact content order");assert(len(parts)>=1 and len(parts)<=64,"bounded chunks");
  for part in parts{assert(len(str_to_bytes(part))<=limit,"byte limit");}
 }
}
assert(D.split_text("αβγ",4)==["αβ","γ"],"greek byte boundaries");
assert(D.split_text("😊a",4)==["😊","a"],"whole Unicode code point");
assert(D.split_text("",1)==[""],"empty block");
for limit in [0,1.5,1025,"4",nil] {reject(fn(){D.split_text("test",limit);});}
reject(fn(){D.split_text("😊",3);});reject(fn(){D.split_text(str_repeat("a",65),1);});reject(fn(){D.split_text(str_repeat("a",32769));});reject(fn(){D.split_text("a\u0000b");});reject(fn(){D.split_text(nil);});
print "text_document_chunks_pass";
