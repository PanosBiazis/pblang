let F = import("stdlib:compiler/selfhost_frontend.sapp");
let V = import("stdlib:compiler/vm.sapp");
fn expect(ok, message) { if not ok { throw "FAIL literal-match-guard: " + message; } }
fn run(source) {
    let compiled = F.frontend_compile(source);
    expect(compiled.ok, "fixture compiles");
    let plain = V.run_bounded(compiled.chunk, map{ max_steps: 3000, max_frames: 8 });
    let optimized = F.frontend_run_bounded(source, map{ max_steps: 3000, max_frames: 8 });
    expect(optimized.ok and plain.globals.result == optimized.globals.result, "optimized and plain values agree");
    return plain.globals.result;
}
expect(run("let result = match 1 { case 1 if false: 7; else: 9; };") == 9, "matching literal still requires its guard");
for literal in ["1", "\"Red\"", "true", "nil"] {
    expect(run("let result = match " + literal + " { case " + literal + " if true: 7; else: 9; };") == 7, "true guard selects literal");
    expect(run("let result = match " + literal + " { case " + literal + " if false: 7; case " + literal + ": 8; else: 9; };") == 8, "false guard advances to next literal");
}
expect(run("let result = match 1 { case 1 if false: 7; };") == nil, "false guard without fallback returns nil");
expect(run("fn boom() { throw 4; } let result = match 1 { case 2 if boom(): 7; else: 9; };") == 9, "mismatching pattern skips guard");
expect(run("fn boom() { throw 4; } let result = try (match 1 { case 1 if boom(): 7; else: 9; }) catch 5;") == 5, "matching guard exception propagates");
// Parenthesized bodies avoid the parser's colon-method-call ambiguity.
expect(run("fn boom() { throw 4; } let result = match 1 { case 1 if false: (boom()); else: 9; };") == 9, "failed guard skips body");
let ordered = "let seen = []; fn mark(x) { array_push(seen, x); return x; } let value = match mark(1) { case 2 if mark(8): (mark(9)); case 1 if mark(0): (mark(7)); case 1 if mark(2): (mark(3)); case _ if mark(4): (mark(5)); else: mark(6); }; let result = [value, seen];";
expect(run(ordered) == [3, [1, 0, 2, 3]], "subject once, guard order, selected body only");
expect(run("let result = match 2 { case n if n < 0: 7; case _ if false: 8; else: 9; };") == 9, "bind and wildcard guards unchanged");
print "selfhost_literal_match_guard_pass";
