let C=import("editors/ide/pbide_history_wire.sapp");
let H=import("editors/ide/pbide_text_history.sapp");
let T=import("editors/ide/pbide_text.sapp");
fn rejects(f) { let failed=false; try { f(); } catch { failed=true; } return failed; }
let h=H.create(T.selection("\nα😀β\n",2,3),C.BUDGET);
h=H.commit(h,T.pair(H.current(h),"("));
let wire=C.encode(H.undo(h)); let back=C.decode(wire);
assert(C.encode(back)==wire and H.availability(back).redo,"canonical Unicode history with redo roundtrips");
assert(H.current(H.redo(back)).text=="\nα(😀)β\n","Unicode selection restored");
let prefix=H.FORMAT+"|0|1|0|0|";
for bad in ["",prefix+"a",prefix+"FF",prefix+"ff",prefix+"20 ",prefix+"00",prefix+"0d",
    prefix+"c080",H.FORMAT+"|00|1|0|0|",H.FORMAT+"|1|1|0|0|",
    H.FORMAT+"|0|2|0|0|",H.FORMAT+"|0|1|1|0|61",str_repeat("|",31),
    str_repeat("a",C.MAX_ENCODED+1),prefix+str_repeat("61",4097)] {
    assert(rejects(fn(){C.decode(bad);}),"malformed wire rejected");
}
assert(rejects(fn(){C.decode(str_repeat("a",C.MAX_ENCODED));}),"maximum-size no-separator input rejected");
let largest=H.create(T.selection(str_repeat("a",4096)),C.BUDGET);
largest=H.commit(largest,T.selection(str_repeat("b",4096)));
assert(len(C.encode(largest))<=C.MAX_ENCODED and H.current(C.decode(C.encode(largest))).text==str_repeat("b",4096),"exact aggregate budget roundtrip");
let over=H.FORMAT+"|0|3|0|0|"+str_repeat("61",4096)+"|0|0|"+str_repeat("62",4096)+"|0|0|61";
assert(rejects(fn(){C.decode(over);}),"aggregate byte cap enforced before third decode");
assert(rejects(fn(){C.encode(H.create(T.selection("a")));}),"default core budget is not implicitly accepted on wire");
print "pbide_history_wire_pass";
