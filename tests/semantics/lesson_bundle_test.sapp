let L=import("stdlib:lesson_bundle.sapp"); let D=import("stdlib:text_document.sapp"); let S=import("stdlib:study_cards.sapp");
let d=D.set_block(D.create("Lesson"),0,"heading","Question?"); d=D.insert_block(d,1,"paragraph","Answer.");
let b=L.create(d,"2026-09-27"); d.blocks[1].text="Edited original";
assert(L.cards(b).cards[0].answer=="Answer." and L.slides(b).slides[0].lines==["Answer."],"detached common source");
assert(L.encode(L.decode(L.encode(b)))==L.encode(b),"lesson roundtrip");
let cards=L.cards(b); cards.cards[0].answer="changed"; assert(L.cards(b).cards[0].answer=="Answer.","derived cards detached");
let reviewed=S.review(L.cards(b),1,"good","2026-09-27"); assert(reviewed.cards[0].reviews==1 and L.cards(b).cards[0].reviews==0,"bundle represents initial material, reviews belong to exported deck");
for input in [nil,"",str_repeat("x",262145),"{\"format\":1,\"format\":2}"] { assert((try L.decode(input) catch "bad")=="bad","malformed and bounded input"); }
assert((try L.create(b.document,"invalid") catch "bad")=="bad","date validation");
let incomplete=D.set_block(D.create(),0,"heading","No answer"); assert((try L.create(incomplete,"2026-09-27") catch "bad")=="bad","all derived formats validated before acceptance");
print "lesson_bundle_pass";
