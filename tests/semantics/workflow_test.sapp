// tests/semantics/workflow_test.sapp — stdlib/workflow.sapp
//
// A node-based workflow engine in the spirit of n8n (~/n8n-codex): register node
// TYPES (functions), wire NODES into a directed graph, and execute in topological
// order with each node receiving its predecessors' outputs. Pure + deterministic:
// the node functions decide what happens; the engine handles ordering, data flow,
// and cycle safety. No side effects of its own.

let W = import("stdlib/workflow.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }
fn falsy(c, m) { if c != false { fail(m); } }

// ── a simple linear pipeline: add 5, then double ───────────────────────────────────
let wf = W.new();
W.register(wf, "add", fn(input, params) { return input + params.n; });
W.register(wf, "double", fn(input, params) { return input * 2; });
W.add_node(wf, "a", "add", map{ n: 5 });
W.add_node(wf, "b", "double", map{});
W.connect(wf, "a", "b");

eq(W.node_count(wf), 2, "two nodes");
eq(W.edge_count(wf), 1, "one edge");
let ord = W.topo_order(wf);
eq(ord[0], "a", "topo: a first");
eq(ord[1], "b", "topo: b second");
falsy(W.has_cycle(wf), "acyclic");

// run: entry node 'a' is seeded with 10 -> a=15 -> b=30
let out = W.run(wf, 10);
eq(out.a, 15, "a = 10 + 5");
eq(out.b, 30, "b = 15 * 2");

// ── fan-in: a node with multiple predecessors receives a LIST of their outputs ─────
let wf2 = W.new();
W.register(wf2, "const", fn(input, params) { return params.v; });
W.register(wf2, "sum", fn(input, params) { let s = 0; for i len(input) { s = s + input[i]; } return s; });
W.add_node(wf2, "x", "const", map{ v: 1 });
W.add_node(wf2, "y", "const", map{ v: 2 });
W.add_node(wf2, "z", "sum", map{});
W.connect(wf2, "x", "z");
W.connect(wf2, "y", "z");
let o2 = W.run(wf2, 0);
eq(o2.z, 3, "z = sum of predecessors [1,2]");

// ── validation: unknown node type is rejected ──────────────────────────────────────
let wfb = W.new();
let bad = (try W.add_node(wfb, "n", "nope", map{}) catch "ERR");
eq(bad, "ERR", "unknown type rejected");
// duplicate id rejected
W.register(wfb, "id", fn(input, params) { return input; });
W.add_node(wfb, "n", "id", map{});
let dup = (try W.add_node(wfb, "n", "id", map{}) catch "DUP");
eq(dup, "DUP", "duplicate node id rejected");
// connecting an unknown node rejected
let badedge = (try W.connect(wfb, "n", "ghost") catch "NOEDGE");
eq(badedge, "NOEDGE", "edge to unknown node rejected");

// ── cycle safety: a->b->a must be caught, not executed ─────────────────────────────
let wf3 = W.new();
W.register(wf3, "id", fn(input, params) { return input; });
W.add_node(wf3, "a", "id", map{});
W.add_node(wf3, "b", "id", map{});
W.connect(wf3, "a", "b");
W.connect(wf3, "b", "a");
truthy(W.has_cycle(wf3), "cycle detected");
let cyc = (try W.run(wf3, 0) catch "CYCLE");
eq(cyc, "CYCLE", "run refuses a cyclic workflow");

print "workflow_pass";
