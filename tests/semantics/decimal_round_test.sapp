// tests/semantics/decimal_round_test.sapp — banking/trading-grade decimal rounding.
//
// pblang's `decimal` type is already EXACT (0.1+0.2 == 0.3, no summation drift,
// 1.005*100 == 100.5). This library adds the controlled ROUNDING MODES finance
// needs — especially banker's rounding (round half to even, the IEEE-754/GAAP
// default) — plus penny-perfect allocation where the parts MUST sum to the total.

let dr = import("stdlib/decimal_round.sapp");

// ── the foundation: exact decimal arithmetic (no IEEE-754 drift) ──
let s = decimal("0.1") + decimal("0.2");
assert(s == decimal("0.3"), "exact decimal add: 0.1 + 0.2 == 0.3");
assert(dr.quantize(s, 2) == decimal("0.30"), "quantize 0.3 to 2dp");

// ── banker's rounding (round half to even) ──
assert(dr.bankers(decimal("2.5"), 0) == decimal("2"), "bankers 2.5 -> 2 (even)");
assert(dr.bankers(decimal("3.5"), 0) == decimal("4"), "bankers 3.5 -> 4 (even)");
assert(dr.bankers(decimal("0.5"), 0) == decimal("0"), "bankers 0.5 -> 0 (even)");
assert(dr.bankers(decimal("1.5"), 0) == decimal("2"), "bankers 1.5 -> 2 (even)");
assert(dr.bankers(decimal("2.345"), 2) == decimal("2.34"), "bankers 2.345 -> 2.34 (4 even)");
assert(dr.bankers(decimal("2.355"), 2) == decimal("2.36"), "bankers 2.355 -> 2.36 (5 odd)");
// a non-exact half must round up regardless of even/odd
assert(dr.bankers(decimal("2.351"), 2) == decimal("2.35"), "bankers 2.351 -> 2.35");
assert(dr.bankers(decimal("2.356"), 2) == decimal("2.36"), "bankers 2.356 -> 2.36");

// ── other modes ──
assert(dr.half_up(decimal("2.5"), 0) == decimal("3"), "half_up 2.5 -> 3");
assert(dr.half_down(decimal("2.5"), 0) == decimal("2"), "half_down 2.5 -> 2");
assert(dr.half_down(decimal("2.51"), 0) == decimal("3"), "half_down 2.51 -> 3");

// ── directed rounding, including negatives (carry + sign correctness) ──
assert(dr.floor_to(decimal("2.9"), 0) == decimal("2"), "floor 2.9 -> 2");
assert(dr.floor_to(decimal("-2.1"), 0) == decimal("-3"), "floor -2.1 -> -3");
assert(dr.ceil_to(decimal("2.1"), 0) == decimal("3"), "ceil 2.1 -> 3");
assert(dr.ceil_to(decimal("-2.9"), 0) == decimal("-2"), "ceil -2.9 -> -2");
assert(dr.truncate_to(decimal("-2.9"), 0) == decimal("-2"), "truncate -2.9 -> -2");
// rounding that carries across the decimal point
assert(dr.bankers(decimal("9.999"), 2) == decimal("10.00"), "bankers 9.999 -> 10.00 (carry)");

// ── no drift over many adds ──
let acc = decimal("0");
let i = 0;
while i < 1000 { acc = acc + decimal("0.01"); i = i + 1; }
assert(acc == decimal("10"), "1000 * 0.01 == 10 exactly (no IEEE drift)");

// ── penny-perfect allocation: parts MUST sum to the total exactly ──
let parts = dr.allocate(decimal("100"), [1, 1, 1], 2);
assert(len(parts) == 3, "allocate 3 ways");
let tot = decimal("0");
let j = 0;
while j < 3 { tot = tot + parts[j]; j = j + 1; }
assert(tot == decimal("100"), "allocated parts sum EXACTLY to the total (no lost penny)");
assert(parts[0] == decimal("33.34"), "largest-remainder gives the extra cent to part 0");
assert(parts[1] == decimal("33.33"), "part 1 = 33.33");

// weighted allocation also sums exactly
let w = dr.allocate(decimal("10.00"), [1, 3], 2);
assert((w[0] + w[1]) == decimal("10"), "weighted allocation sums to the total");
assert(w[1] == decimal("7.50"), "weight 3/4 of 10.00 = 7.50");

print "decimal_round_pass";
