// tests/semantics/graphics_enrich2_test.sapp — wave 2 for stdlib/graphics.sapp
// Points are [x,y]; rects are flat (x,y,w,h). New pure geometry helpers.

let G = import("stdlib/graphics.sapp");

fn fail(m) { throw "FAIL " + m; }
fn approx(a, b, m) { if (a - b) > 0.001 or (b - a) > 0.001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

approx(G.clamp(12, 0, 10), 10, "clamp");
approx(G.lerp(0, 8, 0.25), 2, "lerp");
approx(G.manhattan([0, 0], [3, 4]), 7, "manhattan");

let c = G.rect_center(0, 0, 10, 20);   // -> [5, 10]
approx(c[0], 5, "rect_center.x"); approx(c[1], 10, "rect_center.y");

// union of (0,0,2,2) and (4,4,2,2) -> bounding box (0,0,6,6)
let u = G.rect_union(0, 0, 2, 2, 4, 4, 2, 2);
approx(u[0], 0, "union.x"); approx(u[1], 0, "union.y");
approx(u[2], 6, "union.w"); approx(u[3], 6, "union.h");

// point_in_polygon: unit square, center inside, far point outside
let square = [[0, 0], [4, 0], [4, 4], [0, 4]];
if not G.point_in_polygon(2, 2, square) { fail("center inside square"); }
if G.point_in_polygon(9, 9, square) { fail("far point outside square"); }

print "graphics_enrich2_pass";
