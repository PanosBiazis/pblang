// tests/semantics/pbai_uncertainty_test.sapp — vote-distribution UNCERTAINTY (normalized
// Shannon entropy of the tally). This is distinct from top-1 confidence: two decisions can
// share the same winner-share yet differ in how the *rest* of the mass is spread. High
// entropy = genuine disagreement among models -> a reason to escalate even when the winner
// share alone would pass. Normalized to [0,1] by log2(#configured intents): 0 = unanimous,
// 1 = uniform across all intents.

let ens = import("stdlib/pbai_ensemble.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let scores = fn(p) { return map{ intent: "explain", scores: [1, 0, 0, 0, 0] }; };
ens.configure(scores, ["explain", "bugs", "improve", "comment", "general"]);
ens.clear_voters();
ens.reset_stats();
ens.set_adaptive(false);
ens.set_routing(false);
ens.set_parallel(false);
ens.set_fusion("hard");

// unanimous (native only, all mass on one intent) -> uncertainty 0
approx(ens.uncertainty("q"), 0, "unanimous decision has zero uncertainty");

// even 2-way split among 5 intents: native "explain" (mass 1) vs a voter "bugs" (mass 1)
ens.register_voter_weighted("M", fn(x) { return "bugs"; }, 1);
// H = 1 bit; normalized by log2(5) = 2.3219 -> 0.4307
approx(ens.uncertainty("q"), 0.430677, "even 2-way split -> log2(2)/log2(5)");

// add two more voters on two more intents -> 4-way even split, higher uncertainty
ens.register_voter_weighted("N", fn(x) { return "improve"; }, 1);
ens.register_voter_weighted("O", fn(x) { return "comment"; }, 1);
// H = 2 bits over 4 equal; normalized by log2(5) -> 2/2.3219 = 0.8614
approx(ens.uncertainty("q"), 0.861353, "even 4-way split -> log2(4)/log2(5)");
// strictly more uncertain than the 2-way case
if ens.uncertainty("q") <= 0.4307 { fail("4-way must exceed 2-way uncertainty"); }

// decide() now carries the uncertainty field alongside confidence
let d = ens.ensemble_decide("q");
if (try d.uncertainty catch nil) == nil { fail("decide reports uncertainty"); }
approx(d.uncertainty, 0.861353, "decide.uncertainty matches");

// decide_ex(prompt, conf_threshold, uncertainty_threshold): escalate on EITHER low
// confidence OR high disagreement. Here confidence passes but disagreement is high.
ens.clear_voters();
ens.register_voter_weighted("M", fn(x) { return "bugs"; }, 1);   // 2-way tie, winner-share 0.5
let dx = ens.decide_ex("q", 0.4, 0.3);   // conf 0.5 >= 0.4 (ok) but uncertainty 0.43 > 0.3
if not dx.escalate { fail("high disagreement must escalate even when confidence passes"); }
eq(dx.reason, "uncertain", "escalation reason is the uncertainty");
let dy = ens.decide_ex("q", 0.4, 0.9);   // both thresholds satisfied -> no escalation
if dy.escalate { fail("within both thresholds -> no escalation"); }
let dz = ens.decide_ex("q", 0.9, 0.9);   // confidence 0.5 < 0.9 -> escalate on confidence
if not dz.escalate { fail("low confidence still escalates"); }
eq(dz.reason, "low_confidence", "confidence escalation reason");

ens.clear_voters();
ens.reset_stats();
print "pbai_uncertainty_pass";
