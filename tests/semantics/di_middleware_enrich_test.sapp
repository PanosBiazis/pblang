// tests/semantics/di_middleware_enrich_test.sapp — enrichment for di.sapp + middleware_chain.sapp

let DI = import("stdlib/di.sapp");
let MW = import("stdlib/middleware_chain.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── di: unregister / count ──────────────────────────────────────────────────────────
let c = DI.create();
DI.value(c, "x", 5);
DI.singleton(c, "y", fn() { return 9; });
eq(DI.count(c), 2, "two services");
eq(DI.resolve(c, "x"), 5, "resolve value");
DI.unregister(c, "x");
if DI.has(c, "x") { fail("x removed"); }
eq(DI.count(c), 1, "one after unregister");

// ── middleware_chain: prepend (runs first) / clear ────────────────────────────────
let p = MW.create();
MW.add(p, fn(ctx, next) { ctx.order = ctx.order + "a"; return next(ctx); });
MW.prepend(p, fn(ctx, next) { ctx.order = ctx.order + "b"; return next(ctx); });
let r = MW.run(p, map{ order: "" });
eq(r.order, "ba", "prepended handler runs before existing");
MW.clear(p);
eq(MW.length(p), 0, "cleared");

print "di_middleware_enrich_pass";
