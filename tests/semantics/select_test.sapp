// tests/semantics/select_test.sapp
// select() picks the first ready channel from an array of receiver handles.
// Single-threaded test: pre-load channels before calling select.

let ch_a = channel();
let ch_b = channel();
let ch_c = channel();

// Only ch_b has a value
send(ch_b.sender, "from_b");

let result = select([ch_a.receiver, ch_b.receiver, ch_c.receiver]);
if result["index"] != 1 { print "fail"; }
if result["value"] != "from_b" { print "fail"; }

// Both ch_a and ch_c now get values; select should return index 0 (first ready)
send(ch_a.sender, "from_a");
send(ch_c.sender, "from_c");
let r2 = select([ch_a.receiver, ch_b.receiver, ch_c.receiver]);
if r2["index"] != 0 { print "fail"; }
if r2["value"] != "from_a" { print "fail"; }

// All closed and empty → nil
channel_close(ch_a.sender);
channel_close(ch_b.sender);
channel_close(ch_c.sender);
let r3 = select([ch_a.receiver, ch_b.receiver, ch_c.receiver]);
if r3 != nil { print "fail"; }

print "select_multi_channel_pass";
