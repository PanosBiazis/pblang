// tests/semantics/networking_enrich_test.sapp — fixes + enrichment for networking
//
// FIXES:
//  * build_query_string did NOT url-encode -> parameter injection / broken queries.
//  * check_port / ping_host / websocket_connect called the NON-EXISTENT builtin
//    tcp_connect (only tcp_connect_tls existed) -> they threw "undefined global".
//    This adds a real `tcp_connect` builtin AND wraps the calls so a refused
//    connection degrades to false/error instead of throwing.
//  * url_parse was a buggy hand-rolled parser; now delegates to stdlib/url.sapp.

let net = import("stdlib/networking.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn count_sub(s, sub) {
    let n = 0; let start = 0;
    while true {
        let rest = str_slice(s, start, len(s));
        let j = str_index_of(rest, sub);
        if j < 0 { break; }
        n = n + 1; start = start + j + len(sub);
    }
    return n;
}

// ── FIX: query encoding (no injection) ──────────────────────────────────────────
let qs = net.build_query_string(map{ q: "a b&x=1" });
if str_contains(qs, "&x=1") { fail("parameter injection: " + qs); }
if str_index_of(qs, "%26") < 0 { fail("'&' must be encoded: " + qs); }
if str_index_of(qs, "%20") < 0 { fail("space must be encoded: " + qs); }
eq(count_sub(net.build_query_string(map{ tag: ["x", "y"] }), "tag="), 2, "list value -> repeated keys");

// ── FIX: check_port to a closed port returns false (was a crash on tcp_connect) ──
let cp = try net.check_port("127.0.0.1", 1) catch "THREW";
if cp == "THREW" { fail("check_port must not throw on a refused connection"); }
eq(cp, false, "closed port -> false");

// ── FIX: ping_host degrades gracefully (no crash), returns one result per count ──
let pings = try net.ping_host("127.0.0.1", 2) catch "THREW";
if pings == "THREW" { fail("ping_host must not throw"); }
eq(len(pings), 2, "ping_host returns `count` results");
if not map_has(pings[0], "ok") { fail("ping result has ok field"); }

// ── the new tcp_connect builtin exists (refused connection throws an ERROR, not
//    'undefined global'); check_port proving it is sufficient above. ─────────────

// ── FIX: url_parse delegates to the correct URL parser ──────────────────────────
let u = net.url_parse("https://user@example.com:8443/path?x=1");
eq(u.scheme, "https", "url_parse scheme");
eq(u.host, "example.com", "url_parse host (userinfo stripped)");
eq(u.port, 8443, "url_parse port is the number");
eq(u.path, "/path", "url_parse path");

// ── http status helpers still work ──────────────────────────────────────────────
if not net.http_status_ok(204) { fail("204 ok"); }
if not net.http_status_client_error(404) { fail("404 client error"); }
if not net.http_status_server_error(503) { fail("503 server error"); }

print "networking_enrich_pass";
