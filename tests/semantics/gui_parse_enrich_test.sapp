// tests/semantics/gui_parse_enrich_test.sapp — enrichment for stdlib/gui_parse.sapp
// Adds find_widgets (by kind), widget_names, count_by_kind.

let G = import("stdlib/gui_parse.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let code = "fn build() {\n"
    + "  let form = gui.form(\"T\", 100, 100);\n"
    + "  gui.add(form, gui.label(\"l1\", 0, 0, \"hi\"));\n"
    + "  gui.add(form, gui.button(\"b1\", 0, 0, 10, 10, \"OK\", on_click));\n"
    + "  gui.add(form, gui.label(\"l2\", 0, 20, \"yo\"));\n"
    + "}\n";
let d = G.parse(code);

// ── base parse still works ───────────────────────────────────────────────────────
eq(len(d.widgets), 3, "three widgets parsed");

// ── ENRICH: find_widgets by kind ─────────────────────────────────────────────────
eq(len(G.find_widgets(d, "label")), 2, "two labels");
eq(len(G.find_widgets(d, "button")), 1, "one button");
eq(len(G.find_widgets(d, "slider")), 0, "no sliders");

// ── ENRICH: count_by_kind ────────────────────────────────────────────────────────
let cb = G.count_by_kind(d);
eq(cb["label"], 2, "count labels"); eq(cb["button"], 1, "count buttons");

// ── ENRICH: widget_names ─────────────────────────────────────────────────────────
let names = G.widget_names(d);
eq(len(names), 3, "three names"); eq(names[0], "l1", "first name");

print "gui_parse_enrich_pass";
