let W=import("editors/ide/pbide_text_web.sapp");
let T=import("editors/ide/pbide_text.sapp");
let H=import("editors/ide/pbide_text_history.sapp");
let C=import("editors/ide/pbide_history_wire.sapp");
let D=import("editors/ide/pbide_tabs_wire.sapp");
fn history(text) { return H.create(T.selection(text),C.BUDGET); }
fn body(source,workspace=nil,op="download") {
    let result="source="+url_encode(source)+"&start=0&end=0&insert=&pair=round&op="+op;
    if workspace!=nil {
        result=result+"&history="+url_encode(C.encode(D.current(workspace)))
            +"&workspace="+url_encode(D.encode(workspace));
    }
    return result;
}
fn request(form) {
    return map{method:"POST",path:"/edit",body:form,headers:map{
        host:"127.0.0.1:18771",origin:"http://127.0.0.1:18771",
        "content-type":"application/x-www-form-urlencoded",
        "content-length":str(len(str_to_bytes(form)))}};
}
let source="\nlet π=\"😀\";\n</textarea><script>private-canary</script>";
let reply=W.handle(request(body(source)),18771);
assert(reply.status==200 and reply.body==source and reply.content_type=="text/plain; charset=utf-8",
    "download returns exact visible Unicode source as plain text");
assert(reply.headers["Content-Disposition"]=="attachment; filename=\"Draft1.sapp\""
    and reply.headers["X-Content-Type-Options"]=="nosniff"
    and reply.headers["Cache-Control"]=="no-store"
    and not str_contains(json_stringify(reply.headers),"private-canary"),"fixed attachment headers never contain source");
let normalized=W.handle(request(body("a\r\nb\r\n")),18771);
assert(normalized.body=="a\nb\n","browser newlines are exported as LF");
let full=D.restore(2,[map{id:1,history:history(str_repeat("a",4096))},
    map{id:2,history:history(str_repeat("b",4096))}]);
let original=D.encode(full); let changed=str_repeat("c",4096);
let downloaded=W.handle(request(body(changed,full)),18771);
assert(downloaded.status==200 and downloaded.body==changed and D.encode(full)==original
    and downloaded.headers["Content-Disposition"]=="attachment; filename=\"Draft2.sapp\"",
    "download at full shared history capacity exports edits without committing or mutating drafts");
let four=D.add(D.add(D.add(D.create(history("")))));
for id in [1,2,3,4] {
    let selected=D.select(four,id);
    let exported=W.handle(request(body("visible",selected)),18771);
    assert(exported.headers["Content-Disposition"]=="attachment; filename=\"Draft"+str(id)+".sapp\"",
        "only canonical draft IDs determine filenames");
}
let malformed=body(source,full)+"&filename=private-canary";
let spliced=str_replace_all(body(source,full),"history="+url_encode(C.encode(D.current(full))),
    "history="+url_encode(C.encode(history("different"))));
for invalid in [malformed,spliced,body(str_repeat("x",4097)),
    str_replace_all(body(source),"start=0","start=999"),
    str_replace_all(body(source),"pair=round","pair=private-canary")] {
    let denied=W.handle(request(invalid),18771);
    assert(denied.status==400 and not str_contains(denied.body,"private-canary"),"bad exports reject without echo");
}
for header in ["host","origin"] {
    let foreign=request(body(source)); foreign.headers[header]="https://foreign.invalid";
    let denied=W.handle(foreign,18771);
    assert(denied.status==403 and not str_contains(denied.body,"private-canary"),"exports retain origin gate");
}
let preview=W.handle(request(body("let π=42;",nil,"highlight")),18771);
assert(preview.status==200 and str_contains(preview.body,"syntax-kw\">let ")
    and str_contains(preview.body,"syntax-num\">42"),"highlight action is connected");
let worst_history=H.commit(history(str_repeat("\"",4096)),T.selection(str_repeat("'",4096)));
let frames=[]; for i H.MAX_FRAMES { push(frames,T.selection("")); }
let empty=H.restore(frames,H.MAX_FRAMES-1,C.BUDGET);
let worst=D.restore(1,[map{id:1,history:worst_history},map{id:2,history:empty},
    map{id:3,history:empty},map{id:4,history:empty}]);
let diagnostics=map{ok:false,diagnostics:[]};
for i 32 { push(diagnostics.diagnostics,map{kind:"error",message:str_repeat("<",512)}); }
let page=W.render(H.current(worst_history),worst_history,diagnostics,worst,true);
assert(len(str_to_bytes(page))+1024<W.MAX_RESPONSE,"worst history, escaped preview, diagnostics and headers fit transport");
print "pbide_web_export_pass";
