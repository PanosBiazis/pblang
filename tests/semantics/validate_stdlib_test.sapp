// Test: validate.sapp module
import "stdlib:validate.sapp";

// Basic schema
let s = validate.schema(map{
    name:  map{ type: "string", required: true, min: 1, max: 50 },
    age:   map{ type: "number", min: 0, max: 150 },
    email: map{ type: "string", pattern: "@" }
});

// Valid input
let r1 = validate.check(s, map{ name: "Alice", age: 30, email: "alice@example.com" });
if r1.ok == false { throw "FAIL valid input"; }
if len(r1.errors) != 0 { throw "FAIL valid input has errors"; }

// Missing required field
let r2 = validate.check(s, map{ age: 30, email: "alice@example.com" });
if r2.ok == true { throw "FAIL missing required"; }
if len(r2.errors) == 0 { throw "FAIL missing required no errors"; }

// Age out of range
let r3 = validate.check(s, map{ name: "Bob", age: 200 });
if r3.ok == true { throw "FAIL age out of range"; }

// Email pattern
let r4 = validate.check(s, map{ name: "Carla", email: "notanemail" });
if r4.ok == true { throw "FAIL email pattern"; }

// Helper functions
if validate.is_email("test@example.com") == false { throw "FAIL is_email true"; }
if validate.is_email("notanemail") != false { throw "FAIL is_email false"; }
if validate.is_url("https://example.com") == false { throw "FAIL is_url true"; }
if validate.is_url("ftp://bad") != false { throw "FAIL is_url false"; }
if validate.is_int(42) == false { throw "FAIL is_int true"; }
if validate.is_int(3.14) != false { throw "FAIL is_int false"; }
if validate.in_range(5, 1, 10) == false { throw "FAIL in_range true"; }
if validate.in_range(15, 1, 10) != false { throw "FAIL in_range false"; }

let strict_schema = validate.schema(map{
    id: map{ type: "number", integer: true, multiple_of: 2, required: true },
    role: map{ type: "string", enum: ["admin", "user"], default: "user" },
    profile: map{
        type: "map",
        required: true,
        strict: true,
        fields: map{
            email: map{ type: "string", format: "email", required: true },
            tags: map{ type: "array", min: 1, items: map{ type: "string", min: 2 } }
        }
    }
}, map{ strict: true });

let with_defaults = validate.check_with_defaults(strict_schema, map{
    id: 4,
    profile: map{ email: "a@b.com", tags: ["ok"] }
});
if with_defaults.ok == false { throw "FAIL check_with_defaults valid: " + validate.explain(with_defaults); }
if with_defaults.value.role != "user" { throw "FAIL default role"; }

let strict_bad = validate.check(strict_schema, map{
    id: 3,
    role: "root",
    extra: true,
    profile: map{ email: "bad", tags: ["x"], nope: 1 }
});
if strict_bad.ok != false { throw "FAIL strict_bad should fail"; }
let strict_msg = validate.explain(strict_bad);
if not str_contains(strict_msg, "id must be a multiple of 2") { throw "FAIL multiple_of error: " + strict_msg; }
if not str_contains(strict_msg, "role must be one of the allowed values") { throw "FAIL enum error: " + strict_msg; }
if not str_contains(strict_msg, "profile.email must be an email") { throw "FAIL nested email error: " + strict_msg; }
if not str_contains(strict_msg, "profile.tags[0] must be at least 2 chars") { throw "FAIL array item error: " + strict_msg; }
if not str_contains(strict_msg, "extra is not allowed") { throw "FAIL strict extra error: " + strict_msg; }
if not str_contains(strict_msg, "profile.nope is not allowed") { throw "FAIL nested strict error: " + strict_msg; }

let batch = validate.validate_all(strict_schema, [
    map{ id: 2, role: "admin", profile: map{ email: "ok@example.com", tags: ["aa"] } },
    map{ id: 4, role: "user", profile: map{ email: "ok2@example.com", tags: ["bb"] } }
]);
if batch.ok != true or batch.count != 2 { throw "FAIL validate_all valid"; }

let assert_result = try validate.assert_valid(strict_schema, map{}) catch "assert_failed";
if assert_result != "assert_failed" { throw "FAIL assert_valid should throw"; }

print "validate_stdlib_pass";
