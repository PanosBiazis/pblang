// Test: validate.sapp module
import "stdlib:validate.sapp";

// Basic schema
let s = validate.schema(map{
    name:  map{ type: "string", required: true, min: 1, max: 50 },
    age:   map{ type: "number", min: 0, max: 150 },
    email: map{ type: "string", pattern: "@" }
});

// Valid input
let r1 = validate.check(s, map{ name: "Alice", age: 30, email: "alice@example.com" });
if r1.ok == false { print "FAIL valid input"; }
if len(r1.errors) != 0 { print "FAIL valid input has errors"; }

// Missing required field
let r2 = validate.check(s, map{ age: 30, email: "alice@example.com" });
if r2.ok == true { print "FAIL missing required"; }
if len(r2.errors) == 0 { print "FAIL missing required no errors"; }

// Age out of range
let r3 = validate.check(s, map{ name: "Bob", age: 200 });
if r3.ok == true { print "FAIL age out of range"; }

// Email pattern
let r4 = validate.check(s, map{ name: "Carla", email: "notanemail" });
if r4.ok == true { print "FAIL email pattern"; }

// Helper functions
if validate.is_email("test@example.com") == false { print "FAIL is_email true"; }
if validate.is_email("notanemail") != false { print "FAIL is_email false"; }
if validate.is_url("https://example.com") == false { print "FAIL is_url true"; }
if validate.is_url("ftp://bad") != false { print "FAIL is_url false"; }
if validate.is_int(42) == false { print "FAIL is_int true"; }
if validate.is_int(3.14) != false { print "FAIL is_int false"; }
if validate.in_range(5, 1, 10) == false { print "FAIL in_range true"; }
if validate.in_range(15, 1, 10) != false { print "FAIL in_range false"; }

print "validate_stdlib_pass";
