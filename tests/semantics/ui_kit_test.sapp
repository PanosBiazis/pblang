// tests/semantics/ui_kit_test.sapp — modern UI widget geometry (pure, renderer-agnostic).
//
// ui_kit turns a widget rectangle into a list of axis-aligned sub-rects that a backend
// fills with win.rect(...). This gives the IDE rounded cards, pill buttons, elevation
// shadows and dividers without any per-pixel work in the hot draw loop.

let UI = import("stdlib/ui_kit.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn area(rs) { let a = 0; let i = 0; while i < len(rs) { a = a + rs[i].w * rs[i].h; i = i + 1; } return a; }
fn within(rs, x, y, w, h, m) {
    let i = 0;
    while i < len(rs) {
        let r = rs[i];
        if r.x < x or r.y < y or r.x + r.w > x + w or r.y + r.h > y + h { fail(m + " rect out of bounds: " + str(r)); }
        if r.w <= 0 or r.h <= 0 { fail(m + " degenerate rect: " + str(r)); }
        i = i + 1;
    }
}

// ── rounded_rect: r=0 is a plain rect ────────────────────────────────────────────
let a0 = UI.rounded_rect(0, 0, 10, 10, 0);
eq(len(a0), 1, "r=0 -> single rect");
eq(a0[0].w, 10, "r=0 width"); eq(a0[0].h, 10, "r=0 height");

// ── rounded_rect: SMOOTH quarter-circle corners (per-scanline spans) ───────────────
// The corner rows follow a circle, so the cut per corner is LESS than the old square
// notch (w*h - 4r^2) but the shape still stays strictly inside the box.
fn row_width(rs, yy) {
    let ww = 0; let i = 0;
    while i < len(rs) {
        let r = rs[i];
        if yy >= r.y and yy < r.y + r.h { ww = ww + r.w; }
        i = i + 1;
    }
    return ww;
}
let a1 = UI.rounded_rect(0, 0, 20, 12, 3);
eq(len(a1), 7, "smooth rounded -> 2r+1 bands");
if area(a1) <= 20 * 12 - 4 * 3 * 3 { fail("circle corners cut less than square notches"); }
if area(a1) >= 20 * 12 { fail("corners are actually cut"); }
within(a1, 0, 0, 20, 12, "rounded bands in bounds");
// circle shape: rows widen monotonically toward the middle and are top/bottom symmetric
if row_width(a1, 0) > row_width(a1, 1) { fail("row 0 wider than row 1"); }
if row_width(a1, 1) > row_width(a1, 2) { fail("row 1 wider than row 2"); }
if row_width(a1, 2) > row_width(a1, 5) { fail("corner row wider than middle"); }
eq(row_width(a1, 0), row_width(a1, 11), "top/bottom rows symmetric");
eq(row_width(a1, 1), row_width(a1, 10), "second rows symmetric");
eq(row_width(a1, 5), 20, "middle band spans full width");

let a2 = UI.rounded_rect(0, 0, 12, 12, 3);
if area(a2) <= 12 * 12 - 4 * 3 * 3 { fail("square: circle cut less than notch cut"); }
within(a2, 0, 0, 12, 12, "square rounded in bounds");

// ── rounded_rect: oversized radius is clamped, never escapes the box ──────────────
let a3 = UI.rounded_rect(5, 5, 12, 12, 999);
within(a3, 5, 5, 12, 12, "clamped radius stays in bounds");

// ── pill: rounded with a generous (but safe) radius ──────────────────────────────
let p = UI.pill(0, 0, 30, 10);
within(p, 0, 0, 30, 10, "pill in bounds");
if len(p) < 1 { fail("pill produced rects"); }

// ── inset: shrink a rect symmetrically ───────────────────────────────────────────
let inr = UI.inset(map{ x: 10, y: 10, w: 20, h: 8 }, 2);
eq(inr.x, 12, "inset x"); eq(inr.y, 12, "inset y");
eq(inr.w, 16, "inset w"); eq(inr.h, 4, "inset h");

// ── elevation: a soft shadow as bottom + right edges, offset by t ─────────────────
let el = UI.elevation(0, 0, 10, 6, 2);
eq(len(el), 2, "elevation -> 2 edges");

// ── dividers: 1-axis separators ──────────────────────────────────────────────────
let dh = UI.divider_h(0, 0, 100, 2);
eq(dh.w, 100, "hdiv width"); eq(dh.h, 2, "hdiv thickness");
let dv = UI.divider_v(0, 0, 40, 2);
eq(dv.h, 40, "vdiv height"); eq(dv.w, 2, "vdiv thickness");

// ── contains: half-open hit test ─────────────────────────────────────────────────
let box = map{ x: 0, y: 0, w: 10, h: 10 };
if not UI.contains(box, 5, 5) { fail("contains center"); }
if UI.contains(box, 10, 5) { fail("contains is half-open on right edge"); }
if UI.contains(box, 5, 10) { fail("contains is half-open on bottom edge"); }

// ── progress: a track + a fill clamped to [0,1] ──────────────────────────────────
let pr = UI.progress(0, 0, 100, 10, 0.5);
eq(pr.fill.w, 50, "progress 50%");
eq(UI.progress(0, 0, 100, 10, 2).fill.w, 100, "progress clamps >1");
eq(UI.progress(0, 0, 100, 10, 0 - 1).fill.w, 0, "progress clamps <0");
eq(pr.track.w, 100, "progress track full width");

// ── segmented: n equal segments split across a width ─────────────────────────────
let sg = UI.segmented(0, 0, 100, 10, 2, 0);
eq(len(sg), 2, "segmented count");
eq(sg[0].w, 50, "segment width");
eq(sg[1].x, 50, "segment 2 offset");

// ── scrollbar: track + proportional thumb ────────────────────────────────────────
let sb = UI.scrollbar(0, 0, 100, 200, 100, 0, 4);
eq(sb.thumb.h, 50, "thumb height = h*visible/total");
eq(sb.thumb.y, 0, "thumb at top for offset 0");
let sb2 = UI.scrollbar(0, 0, 100, 200, 100, 100, 4);
eq(sb2.thumb.y, 50, "thumb at bottom for max offset");
let sb3 = UI.scrollbar(0, 0, 100, 100, 200, 0, 4);
eq(sb3.thumb.h, 100, "no-scroll thumb fills track");

// ── badge_width: text-sized chip width ───────────────────────────────────────────
eq(UI.badge_width("ok", 6, 4), 2 * 6 + 8, "badge width = len*cw + 2*pad");

// ── grid_cells: rows*cols of equal cells ─────────────────────────────────────────
let g = UI.grid_cells(0, 0, 100, 100, 2, 2, 0);
eq(len(g), 4, "grid cell count");
eq(g[0].w, 50, "grid cell width");
eq(g[0].h, 50, "grid cell height");

// ── tag: a text chip rect sized to its content ───────────────────────────────────
let tg = UI.tag(10, 5, 3, 6, 4, 12);
eq(tg.x, 10, "tag x"); eq(tg.y, 5, "tag y");
eq(tg.w, 3 * 6 + 2 * 4, "tag width = len*cw + 2*pad"); eq(tg.h, 12, "tag height");

// ── clamp: bound a value ─────────────────────────────────────────────────────────
eq(UI.clamp(5, 0, 10), 5, "clamp in range");
eq(UI.clamp(0 - 1, 0, 10), 0, "clamp low");
eq(UI.clamp(20, 0, 10), 10, "clamp high");

// ── center: offset to vertically/horizontally center inner within outer ───────────
eq(UI.center(20, 8), 6, "center = floor((outer-inner)/2)");
eq(UI.center(8, 20), 0, "center never negative");

// ── zebra: alternating row flag ──────────────────────────────────────────────────
if UI.zebra(0) { fail("zebra row 0 is even"); }
if not UI.zebra(1) { fail("zebra row 1 is odd"); }

print "ui_kit_pass";
