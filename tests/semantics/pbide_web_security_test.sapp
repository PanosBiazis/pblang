// Test: the PBIDE web surface keeps credentials and untrusted markup contained.

fn fail(m) { throw "FAIL " + m; }

let web = fs_read("editors/ide/index.html");
let backend = fs_read("src/main.rs");

if str_contains(web, "searchParams.get('backend')")
   or str_contains(web, "localStorage.getItem('pblang.ide.backend')") {
    fail("PBIDE backend cannot be redirected by URL or browser storage");
}
if not str_contains(web, "return window.location.origin;") {
    fail("served PBIDE uses a same-origin backend");
}
if str_contains(web, "token: (aiEl('ai-token').value")
   or str_contains(web, "token: aiConfig.token") {
    fail("pbAI bearer token must never enter persistent AI configuration");
}
if not str_contains(web, "let aiToken = ''")
   or not str_contains(web, "if (aiToken) headers['Authorization']") {
    fail("pbAI bearer token is an explicit memory-only credential");
}
if not str_contains(web, "function safeLoopbackEndpoint(value)")
   or not str_contains(web, "not an exact loopback origin") {
    fail("pbAI endpoint is normalized to an exact loopback origin");
}
if str_contains(web, "render: n => n.props.html")
   or not str_contains(web, "sandbox=\"\" title=\"Sandboxed custom-element preview\"")
   or not str_contains(web, "srcdoc=\"${dzEsc(n.props.html)}\"") {
    fail("custom designer markup must render only in an escaped sandboxed iframe");
}
if not str_contains(backend, "content-security-policy")
   or not str_contains(backend, "object-src 'none'")
   or not str_contains(backend, "frame-ancestors 'none'")
   or not str_contains(backend, "x-content-type-options")
   or not str_contains(backend, "permissions-policy") {
    fail("PBIDE server supplies browser security headers");
}

print "pbide_web_security_pass";
