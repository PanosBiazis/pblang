let C = import("stdlib:command_argv.sapp");

fn expect(value, message) { if not value { throw "FAIL command argv: " + message; } }

let basic = C.parse("printf '%s %s' hello\\ world \"safe value\"");
expect(basic.ok and len(basic.argv) == 4 and basic.argv[0] == "printf"
       and basic.argv[1] == "%s %s" and basic.argv[2] == "hello world"
       and basic.argv[3] == "safe value" and not basic.shell_evaluated,
    "quotes and conservative escaping produce literal argv");

let empty = C.parse("printf '' \"\"");
expect(empty.ok and len(empty.argv) == 3 and empty.argv[1] == "" and empty.argv[2] == "",
    "quoted empty arguments are retained");

for unsafe in ["echo x | sh", "echo $(id)", "echo `id`", "echo x > out",
               "echo x; id", "echo x # comment", "echo x\necho y",
               "echo \\q", "echo 'unterminated"] {
    expect(not C.parse(unsafe).ok, "unsafe command text must fail: " + unsafe);
}

expect(C.validate(["printf", "%s", "ok"]).ok,
    "structured argv validates without interpretation");
expect(not C.validate(["/bin/sh", "-c", "id"]).ok
       and not C.validate(["-program"]).ok and not C.validate([]).ok,
    "structured argv rejects path-selected, option-selected, and empty programs");

print "command_argv_pass";
