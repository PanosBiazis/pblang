// tests/semantics/browser_enrich2_test.sapp — wave 2 for stdlib/browser.sapp
// Pure HTML metadata extractors: lang, canonical, meta_property (OpenGraph), text_excerpt.

let B = import("stdlib/browser.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=<<" + str(a) + ">> want=<<" + str(b) + ">>"); } }

// ── lang: <html lang="..."> ────────────────────────────────────────────────────────
eq(B.lang("<!DOCTYPE html><html lang=\"en-US\"><head></head></html>"), "en-US", "lang en-US");
eq(B.lang("<html><head></head></html>"), "", "no lang -> empty");

// ── canonical: <link rel=canonical href=...> in either attribute order ─────────────
eq(B.canonical("<link rel=\"canonical\" href=\"https://x.com/p\">"), "https://x.com/p", "canonical rel-first");
eq(B.canonical("<link href=\"https://y.com\" rel=\"canonical\">"), "https://y.com", "canonical href-first");
eq(B.canonical("<head></head>"), "", "no canonical -> empty");

// ── meta_property: OpenGraph property=... content=... ──────────────────────────────
eq(B.meta_property("<meta property=\"og:title\" content=\"Hello\">", "og:title"), "Hello", "og:title");
eq(B.meta_property("<meta property=\"og:type\" content=\"website\">", "og:image"), "", "missing prop -> empty");

// ── text_excerpt: stripped + whitespace-collapsed, truncated ──────────────────────
eq(B.text_excerpt("<p>Hello   world\nfrom pblang</p>", 5), "Hello", "excerpt truncates to 5");
eq(B.text_excerpt("<p>hi</p>", 50), "hi", "short text unchanged");

print "browser_enrich2_pass";
