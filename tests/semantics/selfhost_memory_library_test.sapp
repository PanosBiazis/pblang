let F=import("stdlib:compiler/selfhost_frontend.sapp");
let before=memory_stats();
for name in ["memory_owned_callback", "memory_safe_ref"] {
    let result=F.frontend_run(fs_read("tests/semantics/"+name+"_test.sapp"));
    if not result.ok or result.output != [name+"_pass"] { throw "FAIL selfhost_memory_library: "+name; }
}
let rejected=F.frontend_run("let M=import(\"stdlib:memory_owned.sapp\"); let r=M.with_box_result([],fn(h){return 1;}); print r.allocation_ok; print r.body_ok; print r.cleanup_ok; print memory_stats().total_locations;");
if not rejected.ok or rejected.output != [false,false,true,0] { throw "FAIL selfhost_memory_library: unsupported allocation"; }
let bounded=F.frontend_run_bounded("let O=import(\"stdlib:memory_owned.sapp\"); print O.with_box(4,fn(h){return memory_get(h);}); print memory_stats().total_locations;", map{max_steps:10000});
if not bounded.ok or bounded.output != [4,0] { throw "FAIL selfhost_memory_library: bounded callback"; }
if memory_stats().total_locations != before.total_locations or memory_stats().active_borrows != before.active_borrows { throw "FAIL selfhost_memory_library: host ownership calls"; }
print "selfhost_memory_library_pass";
