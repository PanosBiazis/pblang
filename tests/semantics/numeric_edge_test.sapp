// Numeric edge case tests for the pblang VM.
// Each check prints a WARN or passes silently; the last print is the pass marker.

// Infinity and NaN are representable
let inf = 1.0 / 0.0;
let nan = 0.0 / 0.0;
if type(inf) == "number" { } else { print "WARN: inf not a number"; }
if type(nan) == "number" { } else { print "WARN: nan not a number"; }

// Integer-like floats print without decimals
let x = 42.0;
if str(x) == "42" { } else { print "WARN: str(42.0) != '42'"; }

// Arithmetic precision
let y = 0.1 + 0.2;
if y > 0.29 and y < 0.31 { } else { print "WARN: 0.1+0.2 out of range"; }

// Negative zero is equal to zero
let nz = -0.0;
if nz == 0.0 { } else { print "WARN: -0.0 != 0.0"; }

print "numeric_edge_test: pass";
