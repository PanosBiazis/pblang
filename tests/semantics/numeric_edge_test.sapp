// numeric_edge_test.sapp
// Numeric edge cases: NaN, Infinity, overflow behavior.

// Division by zero → Infinity or implementation-defined error.
let inf = 1.0 / 0.0;
if str(inf) != "Infinity" and str(inf) != "inf" {
    print "WARN inf representation: " + str(inf);
}

// NaN propagation
let nan = 0.0 / 0.0;
// NaN != NaN is a standard property
if nan == nan { print "WARN nan equality should be false"; }

// Large integer: pblang uses f64 internally — values > 2^53 lose precision
let big = 9007199254740993.0; // 2^53 + 1
// Just document: print actual value
print "big int repr: " + str(big);

print "numeric_edge_test: pass";
