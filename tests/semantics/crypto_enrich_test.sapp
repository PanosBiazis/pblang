// tests/semantics/crypto_enrich_test.sapp — enrichment for stdlib/crypto.sapp
// Adds hmac/verify_hmac, random_token (hex), and ct_equal_bytes (constant-time
// byte-array compare).

let c = import("stdlib/crypto.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base chacha still works ──────────────────────────────────────────────────────
let key = []; let i = 0; while i < 32 { array_push(key, i); i = i + 1; }
let nonce = []; i = 0; while i < 12 { array_push(nonce, 0); i = i + 1; }
eq(bytes_to_str(c.chacha20_decrypt(c.chacha20_encrypt("hi", key, nonce), key, nonce)), "hi", "chacha round-trip");

// ── ENRICH: hmac + verify_hmac ───────────────────────────────────────────────────
eq(c.hmac("hi", "key"), "1c9dc82e5f8e5ed5a0180aad33b8204dea12fde2fb62ffb5e963035bf324a7a4", "hmac-sha256 vector");
eq(c.verify_hmac("hi", "key", c.hmac("hi", "key")), true, "verify_hmac valid");
eq(c.verify_hmac("hi", "key", "deadbeef"), false, "verify_hmac wrong tag");
eq(c.verify_hmac("hi", "wrongkey", c.hmac("hi", "key")), false, "verify_hmac wrong key");

// ── ENRICH: random_token ─────────────────────────────────────────────────────────
let tok = c.random_token(16);
eq(len(tok), 32, "random_token(16) -> 32 hex chars");
let j = 0; while j < len(tok) { if str_index_of("0123456789abcdef", str_slice(tok, j, j + 1)) < 0 { fail("non-hex char in token"); } j = j + 1; }

// ── ENRICH: ct_equal_bytes (constant-time byte compare) ──────────────────────────
eq(c.ct_equal_bytes([1, 2, 3], [1, 2, 3]), true, "equal byte arrays");
eq(c.ct_equal_bytes([1, 2, 3], [1, 2, 4]), false, "differing byte arrays");
eq(c.ct_equal_bytes([1, 2], [1, 2, 3]), false, "different lengths");

print "crypto_enrich_pass";
