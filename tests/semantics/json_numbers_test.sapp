let J=import("stdlib:json.sapp");
let D=import("stdlib:json_decode.sapp");
let S=import("stdlib:serialization.sapp");
let n=parse_number("9007199254740991");
for text in ["9007199254740991","9007199254740991.0","9007199254740991.00","9007199254740991e0","90071992547409910e-1"] {
    assert(J.parse(text)==n and D.parse(text)==n,"boundary spelling");
    assert(J.parse("-"+text)==-n,"negative boundary");
    assert(J.parse_exact(text)==n,"exact boundary");
}
assert(J.parse("9007199254740990.0")!=J.parse("9007199254740991.0"),"adjacent supported values distinct");
assert(num_to_le_bytes(J.parse("-0"))==[0,0,0,0,0,0,0,128],"negative integer zero");
assert(num_to_le_bytes(J.parse("-1e-400"))==[0,0,0,0,0,0,0,128],"negative underflow zero");
assert(J.parse("1e-400")==0 and J.parse("0.1")==parse_number("0.1"),"ordinary f64 rounding remains");
for text in ["0","-0.0","0.5","-2.5e-1","5e-1","-5e-1","125e-3","1.25e2","9007199254740992"] { J.parse_exact(text); }
for text in ["0.1","1e-1","9007199254740993","1e-400","5e-324","0e-4097"] {
    assert((try {J.parse_exact(text);false} catch true),"exact mode rejects unsupported precision or scale: "+text);
}
assert((try {J.parse_exact("0."+str_repeat("0",1023));false} catch true),"exact token limit");
assert(J.parse_exact("{\"x\":0.1,\"x\":0.5}").x==0.5,"exact mode checks surviving values");
for text in ["{\"x\":1e9999,\"x\":1}","{1:2}","{-1.2e2:0}","[1,]","01","1e+"] {
    assert((try {J.parse(text);false} catch true),"original full admission including discarded values");
}
for bad in [nil,true,7,[],map{},bigint("1")] {
    assert((try {J.parse(bad);false} catch true),"non-string input rejected");
}
// String/key tagging has no user-visible sentinel and does not rewrite digits
// inside escaped strings, including quotes, backslashes and Unicode surrogates.
let value=map{"":",",",":",9007199254740991.0",",1":"1,","1,":",1", "α😀,":"1e9999", "a,b":[], "a,b,":false};
assert(J.equal(J.parse(J.stringify(value)),value),"comma and number-like key/value collisions");
let escaped=J.parse("{\"a\\\"b\":\"x\\\\y\",\"\\ud83d\\ude00\":\"\\u03b1\\n\\t\\u0000\",\"cash\":\"$1${2},\"}");
assert(escaped["a\"b"]=="x\\y" and escaped["😀"]=="α\n\t\u0000" and escaped.cash=="$1${2},","escaping preserved");
assert(J.parse("{\"a\":1,\"\\u0061\":2}").a==2,"escaped duplicate keys preserve last wins");
let operators=J.parse("{\"__eq__\":1,\"__ne__\":2,\"__getitem__\":3,\"__call__\":4,\"n\":9007199254740991.0}");
assert(operators.n==n and operators["__eq__"]==1,"operator-like data stays inert during decode");
let nested=map{a:[n,-n,0.1,nil,true,"9007199254740991.0"],b:map{"n,":n}};
assert(J.equal(J.parse(J.stringify(nested)),nested),"nested roundtrip");
assert(J.try_parse("9007199254740991.0")==n and J.parse_or("9007199254740991.0",7)==n,"facade helpers fixed");
assert(J.try_parse("[")==nil and J.parse_or("[",7)==7,"facade error contracts");
assert(J.parse_lines("9007199254740991.0\n-9007199254740991.0\n")==[n,-n],"JSON lines fixed");
assert(J.parse_lines_limit("9007199254740991.0",1,32)==[n],"limited JSON lines fixed");
let bounded=S.parse_safe("{\"n\":9007199254740991.0}","json");
assert(bounded.ok and bounded.value.n==n,"bounded serialization integration");
assert(S.parse_format("9007199254740991.0","json")==n,"format integration");
assert(not S.parse_safe("{\"a\":1,\"a\":2}","json").ok,"duplicate guard unchanged");
assert(S.parse_safe("{\"a\":1,\"a\":2}","json",map{reject_duplicate_keys:false}).value.a==2,"duplicate opt-out unchanged");
assert(not S.parse_safe("[1,]","json").ok,"structured diagnostics unchanged");
assert(not S.parse_safe("[1,2,3]","json",map{max_items:2}).ok,"item budget retained");
// The retained builtin is deliberately not replaced by a global monkey patch.
assert(json_parse("9007199254740991.0")==n-1,"native limitation remains explicit");
// Repeated scalar restoration is local to adjacent entries of one array.
let runs=J.parse("[0.5,0.5,\"0.5\",\"0.5\",null,0.5,0.5,{},0.5,0.5,[],0.5,0.5]");
assert(runs[0]==0.5 and runs[1]==0.5 and runs[2]=="0.5" and runs[3]=="0.5" and runs[5]==0.5 and runs[6]==0.5 and runs[8]==0.5 and runs[9]==0.5 and runs[11]==0.5 and runs[12]==0.5,"mixed runs and container boundaries");
let zeros=J.parse("[0.0,0.0,-0.0,-0.0,0e0,-0e0,-1e-400,-1e-400,1e-400,1e-400]");
for i in [0,1,4,8,9] { assert(num_to_le_bytes(zeros[i])==[0,0,0,0,0,0,0,0],"positive zero run"); }
for i in [2,3,5,6,7] { assert(num_to_le_bytes(zeros[i])==[0,0,0,0,0,0,0,128],"negative zero run"); }
assert(J.parse_exact("[0.5,0.5,1.25,1.25]")==[0.5,0.5,1.25,1.25],"exact repeated accepted values");
for text in ["[0.1,0.1]","[0.5,0.5,0.1,0.1]","[0.1,0.1,0.5,0.5]","[1e-400,1e-400]","[0e-4097,0e-4097]"] {
    assert((try {J.parse_exact(text);false} catch true),"strict repeated rejection stays sticky");
}
assert(J.parse("[0.1,0.1]")==[parse_number("0.1"),parse_number("0.1")],"ordinary mode unaffected after strict rejection");
let independent=J.parse("[[0.5,0.5],[0.5,0.5],{\"x\":0.5},{\"x\":0.5}]");
independent[0][0]=9;independent[2].x=9;
assert(independent[1][0]==0.5 and independent[3].x==0.5,"repeated containers never alias");
let texts=J.parse("[\"\",\"\",\" ,0.5\",\" ,0.5\",\"α😀,\",\"α😀,\",\"x\\\\y\",\"x\\\\y\",0.5]");
assert(texts[0]=="" and texts[1]=="" and texts[2]==" ,0.5" and texts[3]==texts[2] and texts[4]=="α😀," and texts[5]==texts[4] and texts[6]=="x\\y" and texts[7]==texts[6] and texts[8]==0.5,"empty, marker-like and escaped repeated strings");
print "json_numbers_pass";
