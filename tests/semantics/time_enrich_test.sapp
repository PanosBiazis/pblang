// tests/semantics/time_enrich_test.sapp — enrichment for stdlib/time.sapp

let T = import("stdlib/time.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── format_clock (deterministic) ───────────────────────────────────────────────────
eq(T.format_clock(3661000), "01:01:01", "1h1m1s");
eq(T.format_clock(0), "00:00:00", "zero");
eq(T.format_clock(59000), "00:00:59", "59s");
eq(T.format_clock(3600000), "01:00:00", "1h");

// ── now_unix is roughly now_ms/1000 ────────────────────────────────────────────────
let u = T.now_unix();
if u <= 0 { fail("now_unix positive"); }

// ── deadline / is_expired / remaining ──────────────────────────────────────────────
let d = T.deadline(100000);          // far future
if T.is_expired(d) { fail("future deadline not expired"); }
if T.remaining(d) <= 0 { fail("future deadline has remaining time"); }

let past = T.now_ms() - 5000;        // 5s ago
if not T.is_expired(past) { fail("past deadline is expired"); }
eq(T.remaining(past), 0, "expired deadline -> 0 remaining");

print "time_enrich_pass";
