// tests/semantics/gpu2d_host_test.sapp — stdlib/gpu2d_host.sapp
//
// The POLYGLOT half: pblang emits the host-language glue that creates the GPU pipeline,
// uploads gpu2d's instance buffer, binds the glyph atlas, and issues ONE instanced draw —
// in Rust (wgpu), C (OpenGL), Python (moderngl), and JS (WebGPU). Each embeds the shader
// from gpu2d_shader and the 56-byte vertex layout. These are runnable via stdlib/polyglot
// where a GPU + toolchain exists; here we assert the generated source is well-formed.

let H = import("stdlib/gpu2d_host.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn has(hay, needle, m) { if not str_contains(hay, needle) { fail(m + " (missing '" + needle + "')"); } }

// four polyglot targets, dispatchable by name
let t = H.targets();
eq(len(t), 4, "four host targets");

// ── Rust / wgpu ─────────────────────────────────────────────────────────────────────
let r = H.emit_rust_wgpu();
has(r, "wgpu", "rust uses wgpu");
has(r, "create_shader_module", "rust compiles the shader");
has(r, "draw", "rust issues a draw");
has(r, "56", "rust knows the 56-byte instance stride");

// ── C / OpenGL ──────────────────────────────────────────────────────────────────────
let c = H.emit_c_opengl();
has(c, "glDrawArraysInstanced", "c instanced draw");
has(c, "glCreateShader", "c compiles shaders");
has(c, "GL_", "c uses GL enums");

// ── Python / moderngl ───────────────────────────────────────────────────────────────
let py = H.emit_python_moderngl();
has(py, "moderngl", "python uses moderngl");
has(py, "vertex_array", "python builds a VAO");
has(py, "instances", "python instanced render");

// ── JS / WebGPU ─────────────────────────────────────────────────────────────────────
let js = H.emit_js_webgpu();
has(js, "createRenderPipeline", "js builds a pipeline");
has(js, "createShaderModule", "js compiles the shader");

// ── dispatch by target name ─────────────────────────────────────────────────────────
eq(H.emit("rust-wgpu"), r, "emit('rust-wgpu') dispatches");
eq(H.emit("python-moderngl"), py, "emit('python-moderngl') dispatches");
let bad = (try H.emit("nope") catch "ERR");
eq(bad, "ERR", "unknown target throws");

print "gpu2d_host_pass";
