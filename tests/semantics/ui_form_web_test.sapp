let Doc=import("stdlib:ui_document.sapp");let Web=import("stdlib:ui_form_web.sapp");let Overlay=import("stdlib:ui_form_overlay.sapp");
fn create(document, actions, port=8766){return Web.create(document, actions, port, map{discourage_scraping:false, hide_source_names:false, throttle_rejected_requests:false});}

fn denied(action){let failed=false;try action() catch {failed=true;};return failed;}

fn widget(id, kind, props){return map{name:id, kind:kind, x:0, y:0, w:100, h:30, props:props};}

fn req(method, path, body=""){return map{method:method, path:path, body:body, headers:map{host:"127.0.0.1:8766", origin:"http://127.0.0.1:8766", "content-type":"application/x-www-form-urlencoded"}};}

fn hidden(page, name){return str_split(str_split(page.body, "name=\"" + name + "\" value=\"")[1], "\"")[0];}
let doc=Doc.from_design(map{form:map{title:"<script>Source</script>", w:500, h:400}, model:map{private:"DO_NOT_RENDER_MODEL"}, widgets:[
    widget("Text", "textbox", map{value:"<script>alert(1)</script>", hint:"Name"}),
    widget("Notes", "textarea", map{value:"</textarea><script>bad</script>"}),
    widget("Check", "checkbox", map{text:"Accept", checked:true}),
    widget("Choice", "select", map{options:["First", "Second"], selected:1}),
    widget("Fixed", "textbox", map{value:"fixed", read_only:true}),
    widget("Inactive", "textbox", map{value:"inactive", enabled:false}),
    widget("Hidden", "textbox", map{value:"PRIVATE_HIDDEN", visible:false}),
    widget("Save", "button", map{text:"Save"}), widget("Unbound", "button", map{text:"Unbound"})
    ]});
doc.widgets[7].events.click="ForeignHandler";
let calls=map{count:0, values:nil};
let actions=map{Save:fn(values){calls.count=calls.count + 1;calls.values=values;return "<img src=x onerror=bad()>";}};
let app=create(doc, actions);actions.Save=fn(values){throw "mutated";};doc.widgets[0].props.value="changed";
let page=app.handle(req("GET", "/"));let token=hidden(page, "csrf");
assert(page.headers["Cross-Origin-Opener-Policy"] == "same-origin" and page.headers["Cross-Origin-Resource-Policy"] == "same-origin" and page.headers["Cross-Origin-Embedder-Policy"] == "require-corp", "cross-origin isolation headers");
assert(page.headers["X-Frame-Options"] == "DENY" and page.headers["X-Content-Type-Options"] == "nosniff", "frame and MIME protection");
assert(not str_contains(page.headers["Content-Security-Policy"], "unsafe-inline") and str_contains(page.headers["Content-Security-Policy"], "trusted-types 'none'"), "script-free strict CSP");
assert(not map_has(page.headers, "Access-Control-Allow-Origin") and not map_has(page.headers, "Set-Cookie"), "no CORS grant or tracking cookie");
assert(not map_has(page.headers, "Strict-Transport-Security"), "no fake HTTPS guarantee on HTTP preview");
assert(page.status == 200 and not str_contains(page.body, "<script>") and str_contains(page.body, "&lt;script&gt;"), "escape imported markup");
assert(not str_contains(page.body, "DO_NOT_RENDER_MODEL") and not str_contains(page.body, "PRIVATE_HIDDEN"), "no hidden model rendering");
assert(str_contains(page.body, "readonly disabled") and str_contains(page.body, "value=\"Unbound\" disabled"), "inactive controls");
assert(app.imported_handlers == 1 and not app.foreign_handlers_executed and not app.layout_preserved, "explicit fidelity limits");
let body="csrf=" + token + "&revision=0&action=Save&f_Text=hello&f_Notes=note&f_Choice=1&f_Check=1";
let result=app.handle(req("POST", "/action", body));
assert(result.status == 200 and calls.count == 1 and calls.values.Text == "hello" and calls.values.Choice == "Second" and calls.values.Check, "real action mapping");
assert(str_contains(result.body, "value=\"hello\"") and str_contains(result.body, ">note</textarea>"), "submitted values retained only in response");
assert(str_contains(result.body, "&lt;img") and not str_contains(result.body, "<img"), "escape trusted action output as text");
assert(app.handle(req("POST", "/action", body)).status == 409 and calls.count == 1, "no stale replay");
let fresh="csrf=" + token + "&revision=1&action=Save&f_Text=hello&f_Notes=note&f_Choice=";
let missing=app.handle(req("POST", "/action", fresh));assert(missing.status == 200 and calls.values.Choice == nil and not calls.values.Check, "unchecked and empty choices");
for bad in [fresh + "&f_Text=duplicate", fresh + "&unknown=x", fresh + "&f_Fixed=changed", fresh + "&f_Hidden=leak", fresh + "&f_Inactive=x", fresh + "&x=%GG", fresh + "&x=%00"] {
    assert(app.handle(req("POST", "/action", bad)).status == 400, "invalid or unauthorized fields");
}
for escape in ["%GG", "%", "%0", "%00", "%FF"] {
    let malformed="csrf=" + token + "&revision=2&action=Save&f_Text=" + escape + "&f_Notes=y&f_Choice=0";
    assert(app.handle(req("POST", "/action", malformed)).status == 400, "malformed field encoding");
}
let invalid="csrf=" + token + "&revision=2&action=Save&f_Text=x&f_Notes=y&f_Choice=999";
assert(app.handle(req("POST", "/action", invalid)).status == 400, "selection range");
let cross=req("POST", "/action", fresh);cross.headers.origin="https://example.invalid";
assert(app.handle(cross).status == 403, "foreign origin");
let host=req("GET", "/");host.headers.host="example.invalid";assert(app.handle(host).status == 403, "foreign host");
let dup=req("GET", "/");dup.headers.Host="127.0.0.1:8766";assert(app.handle(dup).status == 400, "case duplicate header");
let ct=req("POST", "/action", fresh);ct.headers["content-type"]="text/plain";assert(app.handle(ct).status == 415, "content type");
assert(calls.count == 2, "rejections have no effects");
app.close();app.close();assert(app.handle(req("GET", "/")).status == 503, "close revokes preview");
let clean=Doc.from_design(map{form:map{title:"Actions", w:300, h:200}, model:map{}, widgets:[widget("Go", "button", map{text:"Go"})]});
let state=map{count:0};let fail=create(clean, map{Go:fn(values){state.count=state.count + 1;throw "PRIVATE_ERROR";}});
let fp=fail.handle(req("GET", "/"));let fb="csrf=" + hidden(fp, "csrf") + "&revision=0&action=Go";
let fr=fail.handle(req("POST", "/action", fb));assert(fr.status == 500 and not str_contains(fr.body, "PRIVATE_ERROR"), "private exception");
assert(fail.handle(req("POST", "/action", fb)).status == 409 and state.count == 1, "failed effect not replayed");fail.close();
assert(denied(fn(){create(clean, map{Missing:fn(v){return "x";}});}), "unknown action");
assert(denied(fn(){create(clean, map{Go:"ForeignHandler"});}), "handler string not code");
let unsupported=Overlay.apply(clean, [map{id:"Go", set:map{props:map{url:"file:///private"}}}]);
assert(denied(fn(){create(unsupported, map{});}), "unhandled property rejected");
let input=Doc.from_design(map{form:map{title:"Password", w:300, h:200}, model:map{}, widgets:[widget("Secret", "textbox", map{input_type:"password", value:"PRIVATE"})]});
assert(denied(fn(){create(input, map{});}), "password controls require dedicated authenticated adapter");
let mixed=Overlay.compose([map{prefix:"a", document:clean}, map{prefix:"b", document:clean}]);
let combined=create(mixed, map{"a.Go":fn(v){return "A";}, "b.Go":fn(v){return "B";}});
assert(str_contains(combined.handle(req("GET", "/")).body, "value=\"b.Go\""), "composed actions");combined.close();
let holder=map{app:nil, status:0};
let reentrant=create(clean, map{Go:fn(v){holder.status=holder.app.handle(req("GET", "/")).status;return "done";}});holder.app=reentrant;
let rp=reentrant.handle(req("GET", "/"));
assert(reentrant.handle(req("POST", "/action", "csrf=" + hidden(rp, "csrf") + "&revision=0&action=Go")).status == 200 and holder.status == 409, "reentrant action blocked");reentrant.close();holder.app=nil;
let closed=map{app:nil};let closer=create(clean, map{Go:fn(v){closed.app.close();return "done";}});closed.app=closer;
let cp=closer.handle(req("GET", "/"));
assert(closer.handle(req("POST", "/action", "csrf=" + hidden(cp, "csrf") + "&revision=0&action=Go")).status == 503, "close during callback");closed.app=nil;
let default_app=Web.create(clean, map{Go:fn(v){return "ok";}});
let default_page=default_app.handle(req("GET", "/"));
assert(default_page.headers["Referrer-Policy"] == "same-origin", "native form origin survives privacy policy");
assert(map_has(default_page.headers, "X-Robots-Tag") and str_contains(default_page.body, "value=\"a_1\"") and not str_contains(default_page.body, "value=\"Go\""), "both policies default on");
assert(default_app.handle(req("GET", "/robots.txt")).body == "User-agent: *\nDisallow: /\n", "crawler instruction");
let db="csrf=" + hidden(default_page, "csrf") + "&revision=0&action=a_1";
assert(default_app.handle(req("POST", "/action", db)).status == 200, "opaque action maps to PBLang");
for i 117 {assert(default_app.handle(req("GET", "/")).status == 200, "within request budget");}
assert(default_app.handle(req("GET", "/")).status == 429, "request budget applied");default_app.close();
let optout=Web.create(clean, map{}, 8766, map{discourage_scraping:false, hide_source_names:false, throttle_rejected_requests:false});
let op=optout.handle(req("GET", "/"));assert(not map_has(op.headers, "X-Robots-Tag") and str_contains(op.body, "value=\"Go\""), "explicit independent opt out");
let oc=req("POST", "/action", "");oc.headers.origin="null";assert(optout.handle(oc).status == 403, "opt out keeps origin guard");optout.close();
let name_only=Web.create(clean, map{}, 8766, map{discourage_scraping:false});assert(not map_has(name_only.handle(req("GET", "/")).headers, "X-Robots-Tag"), "crawler opt out independent");name_only.close();
let crawler_only=Web.create(clean, map{}, 8766, map{hide_source_names:false});assert(map_has(crawler_only.handle(req("GET", "/")).headers, "X-Robots-Tag"), "name opt out independent");crawler_only.close();
assert(denied(fn(){Web.create(clean, map{}, 8766, map{hide_source_names:"false"});}), "policy is boolean");
assert(denied(fn(){Web.create(clean, map{}, 8766, map{unsafe:true});}), "no silent global unsafe bypass");
print "ui_form_web_pass";
