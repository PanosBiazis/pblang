let O = import("../../stdlib/pbai_optimization.sapp");

fn require(ok, message) { if not ok { throw "pbai_optimization_test: " + message; } }

fn report(backend, latency, quality = 0.99) {
    return map{
        format: O.BENCHMARK_FORMAT,
        backend: backend,
        workload: "tensor-matmul-inference",
        model_digest: sha256("same-model-artifact"),
        identical_workload: true,
        warmups: 2,
        samples: 7,
        median_latency_ms: latency,
        p95_latency_ms: latency * 1.2,
        throughput_per_second: 1000 / latency,
        peak_memory_bytes: 1048576,
        artifact_bytes: 524288,
        quality_score: quality,
        baseline_quality_score: 0.99,
        parity_passed: true,
        artifact_verified: true,
        runtime_verified: true,
        operator_coverage_passed: true,
        deterministic_fallback: backend == "cpu",
        precision: if backend == "gpu" { "f32" } else { "f64" },
        runtime: if backend == "gpu" { "pblang-wgpu-matmul-v1" } else { "portable-pblang-cpu" }
    };
}

let cpu = report("cpu", 10);
let gpu = report("gpu", 5);
let selected = O.select_backend("tensor-matmul-inference", [cpu, gpu]);
require(selected.ok and selected.selected == "gpu" and selected.measured_speedup_over_cpu == 2,
    "a compatible verified GPU route is selected only after measured parity and speedup");

let inventory_gpu = report("gpu", 2);
inventory_gpu.runtime_verified = false;
let fallback = O.select_backend("tensor-matmul-inference", [cpu, inventory_gpu]);
require(fallback.ok and fallback.selected == "cpu",
    "hardware inventory without a verified runtime remains on the CPU fallback");

let npu = report("npu", 1);
npu.precision = "int8";
npu.runtime = "future-npu";
let no_npu = O.select_backend("tensor-matmul-inference", [cpu, npu]);
require(no_npu.selected == "cpu" and not no_npu.npu_inventory_is_compute,
    "NPU detection cannot become compute before a real PBLang backend exists");

let bad_quality = report("gpu", 2, 0.90);
require(O.select_backend("tensor-matmul-inference", [cpu, bad_quality]).selected == "cpu",
    "speed never overrides the quality-loss gate");

require(not O.select_backend("tensor-matmul-inference", [gpu]).ok,
    "an accelerator cannot replace the required deterministic CPU baseline");

let deployment = O.deployment_plan("pbAI-Mini", 1000000, 4096, 134217728, 2500000);
require(deployment.ok and deployment.precision_candidate == "f16"
    and not deployment.precision_committed and deployment.accuracy_gate_required,
    "memory/storage planning proposes but does not silently commit precision");

let training = O.training_plan(8, 100000, 3, 1000000);
require(training.ok and training.strategy == "adapter-and-small-specialist-first"
    and not training.live_chat_training and not training.launches_training,
    "fast training reuses bounded assets and gates without silently training");

let status = O.status();
require(status.ok and not status.performs_benchmark and not status.trains_model
    and not status.universal_best_claimed,
    "status distinguishes the optimization contract from measured execution");

print "pbai_optimization_pass";
