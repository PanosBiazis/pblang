// tests/semantics/codegen_callconv_test.sapp — a real calling convention on x86-64: functions
// take ARGUMENTS (in r0..r3, captured into a per-call stack frame) and RETURN a value (r0).
// Frame-based locals make calls reentrant, so recursion with arguments works. Run-verified.

let X = import("stdlib/codegen_x64.sapp");

fn fail(m) { throw "FAIL " + m; }
fn run_rc(elf, tag) {
    let path = "pbcc2_" + tag + ".bin";
    fs_write_bytes(path, elf);
    let r = proc_spawn_wait("bash", ["-c", "chmod +x " + path + " && ./" + path + "; rc=$?; rm -f " + path + "; echo RC=$rc"]);
    let out = try r.stdout catch "";
    let idx = str_index_of(out, "RC=");
    return parse_number(str_trim(str_slice(out, idx + 3, len(out))));
}
fn eqrc(elf, want, tag) { let g = run_rc(elf, tag); if g != want { fail(tag + " got " + str(g) + " want " + str(want)); } }

// madd(a,b,c) = a*b + c   (3 args, 3 locals). a=r0,b=r1,c=r2 on entry; result in r0.
let madd = map{ name: "madd", nparams: 3, nlocals: 3, body: [
    ["lget", 0], ["pushr", 0], ["lget", 1], ["movr", 1, 0], ["popr", 0], ["mul", 0, 1],   // a*b
    ["pushr", 0], ["lget", 2], ["movr", 1, 0], ["popr", 0], ["add", 0, 1]                  // + c
] };
eqrc(X.compile_call_unit([madd], map{ nlocals: 0, body: [["seti", 0, 6], ["seti", 1, 7], ["seti", 2, 0], ["call", "madd"]] }), 42, "madd_6_7_0");
eqrc(X.compile_call_unit([madd], map{ nlocals: 0, body: [["seti", 0, 3], ["seti", 1, 4], ["seti", 2, 30], ["call", "madd"]] }), 42, "madd_3_4_30");

// sumto(n) = n==0 ? 0 : n + sumto(n-1)   (1 arg, recursion — needs reentrant frame for n)
let sumto = map{ name: "sumto", nparams: 1, nlocals: 1, body: [
    ["lget", 0],
    ["ifnz", 0, [
        ["lget", 0], ["seti", 1, 1], ["sub", 0, 1], ["call", "sumto"],   // r0 = sumto(n-1)
        ["movr", 1, 0], ["lget", 0], ["add", 0, 1]                        // r0 = n + sumto(n-1)
    ], [
        ["seti", 0, 0]
    ]]
] };
eqrc(X.compile_call_unit([sumto], map{ nlocals: 0, body: [["seti", 0, 5], ["call", "sumto"]] }), 15, "sumto_5");
eqrc(X.compile_call_unit([sumto], map{ nlocals: 0, body: [["seti", 0, 10], ["call", "sumto"]] }), 55, "sumto_10");

// one function calling another, passing the return value as the next argument
let inc = map{ name: "inc", nparams: 1, nlocals: 1, body: [["lget", 0], ["seti", 1, 1], ["add", 0, 1]] };
let dbl = map{ name: "dbl", nparams: 1, nlocals: 1, body: [["lget", 0], ["movr", 1, 0], ["add", 0, 1]] };
eqrc(X.compile_call_unit([inc, dbl], map{ nlocals: 0, body: [["seti", 0, 20], ["call", "dbl"], ["call", "inc"], ["call", "inc"]] }), 42, "chain_dbl_inc_inc");

print "codegen_callconv_pass";
