// Test: destructuring assignment
// let [a, b, c] = array;   — array destructuring
// let {x, y} = map;        — map destructuring

// Basic array destructuring
let [first, second, third] = [10, 20, 30];
assert(first == 10, "first should be 10");
assert(second == 20, "second should be 20");
assert(third == 30, "third should be 30");

// Array destructuring from function return
fn get_point() {
    return [3, 4];
}
let [px, py] = get_point();
assert(px == 3, "px should be 3");
assert(py == 4, "py should be 4");

// Basic map destructuring
let point = map{ x: 100, y: 200, z: 300 };
let {x, y} = point;
assert(x == 100, "x should be 100");
assert(y == 200, "y should be 200");

// Map destructuring with rename: {key: alias}
let person = map{ name: "Alice", age: 30, city: "Athens" };
let {name: person_name, age: person_age} = person;
assert(person_name == "Alice", "person_name should be Alice");
assert(person_age == 30, "person_age should be 30");

// Map destructuring from function return
fn get_config() {
    return map{ host: "localhost", port: 8080 };
}
let {host, port} = get_config();
assert(host == "localhost", "host should be localhost");
assert(port == 8080, "port should be 8080");

// Array destructuring with rest (...)
let [head, ...tail] = [1, 2, 3, 4, 5];
assert(head == 1, "head should be 1");
assert(len(tail) == 4, "tail should have 4 elements, got: " + str(len(tail)));
assert(tail[0] == 2, "tail[0] should be 2");
assert(tail[3] == 5, "tail[3] should be 5");

// Destructuring in a loop (common pattern)
let pairs = [[1, "a"], [2, "b"], [3, "c"]];
let sum = 0;
for pair in pairs {
    let [num, letter] = pair;
    sum += num;
}
assert(sum == 6, "sum from destructuring in loop should be 6");

print "destructuring_pass";
