let D=import("stdlib:task_plan.sapp");
fn rejects(f) {let bad=false;try {f();}catch {bad=true;}assert(bad,"invalid task plan rejected");}
let doc=D.edit(D.create("Leap plan","2024-02-28"),"task_1","First",2,[]);doc=D.append(doc);doc=D.edit(doc,"task_2","Second",3,["task_1"]);doc=D.append(doc);doc=D.edit(doc,"task_3","Independent",1,[]);
fn task(schedule,id) {for row in schedule.tasks {if row.id==id {return row;}}throw "missing task";}
let s=D.schedule(doc);assert(s.days==5 and s.due=="2024-03-03","calendar schedule");assert(task(s,"task_2").start=="2024-03-01" and task(s,"task_2").status=="blocked","prerequisites constrain start and status");assert(D.decode(D.encode(doc))==doc,"strict roundtrip");let copy=D.copy(doc);copy.tasks[1].needs[0]="different";assert(doc.tasks[1].needs[0]=="task_1","detached copy");
rejects(fn(){D.complete(doc,"task_2");});let done=D.complete(doc,"task_1");assert(task(D.schedule(done),"task_2").status=="ready" and D.schedule(done).due==s.due,"completion opens dependency without silently rescheduling");done=D.complete(done,"task_2");rejects(fn(){D.complete(done,"task_1",false);});assert(D.window(done,"2024-02-28",7).inside==1,"only unfinished tasks in calendar");assert(doc.tasks[0].done==false,"source unchanged");
for f in [fn(){D.edit(doc,"task_1","First",1,["task_2"]);},fn(){D.edit(doc,"task_2","Second",1,["unknown"]);},fn(){D.remove(doc,"task_1");},fn(){D.remove(D.create(),"task_1");},fn(){D.edit(doc,"task_1","First",0,[]);},fn(){D.edit(doc,"task_1","First",366,[]);},fn(){D.edit(doc,"task_1","First",1.5,[]);},fn(){D.create(" ");},fn(){D.metadata(doc,"Okay","9999-12-31");},fn(){D.decode("{\"format\":1,\"format\":2}");},fn(){D.decode(str_repeat(" ",32769));}] {rejects(f);}
let many=D.create();for i in range(1,32) {many=D.append(many);}assert(len(D.decode(D.encode(many)).tasks)==32,"max tasks");rejects(fn(){D.append(many);});let malformed=D.copy(doc);malformed.tasks[0].extra=1;rejects(fn(){D.validate(malformed);});print "task_plan_pass";
