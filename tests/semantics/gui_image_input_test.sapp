let Gui = import("stdlib:gui.sapp");

fn fail(message) { throw "FAIL gui_image_input: " + message; }
fn truthy(value, message) { if value != true { fail(message); } }

let clicked = map{ count: 0, x: -1, y: -1 };
fn image_click(form, x, y) {
    clicked.count = clicked.count + 1;
    clicked.x = x; clicked.y = y;
}

let form = Gui.form("image input", 200, 120);
Gui.add(form, Gui.image("remote", 20, 30, 100, 60, nil, image_click));
Gui.handle_event(form, map{ type: "mousemove", x: 45, y: 50 });
Gui.handle_event(form, map{ type: "mousedown", button: "Left" });
truthy(clicked.count == 1 and clicked.x == 25 and clicked.y == 20,
    "image callback receives widget-local click coordinates");

Gui.set_enabled(form, "remote", false);
Gui.handle_event(form, map{ type: "mousedown", button: "Left" });
truthy(clicked.count == 1, "disabled image ignores pointer input");

Gui.set_visible(form, "remote", false);
truthy(Gui.hit_test(form, 45, 50) == nil,
    "hidden image is absent from hit testing");

print "gui_image_input_test: 3 checks passed";
