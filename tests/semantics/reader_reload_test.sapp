let App=import("../../examples/declarative_browser/app.sapp");let Profile=import("../../examples/declarative_browser/appearance_profile.sapp");
let GUI=import("stdlib:gui.sapp");let Settings=import("../../examples/declarative_browser/settings_layout.sapp");let n=0;
fn check(ok,label) {assert(ok,label);n=n+1;}
fn key(c,k) {App.update(c,[map{type:"keydown",key:k}]);App.update(c,[map{type:"keyup",key:k}]);}
fn act(c,name) {c.form.focus=name;key(c,"Enter");}
let c=App.create();App.enable_preferences(c);App.refresh(c);act(c,"appearance");
check(GUI.get(c.form,"style_reload")==nil and not App.reload_preferences(c),"legacy/session-only has no reload");
let state=map{reads:0,writes:0,stale:true,result:nil};let style=Profile.defaults();style.font_family="serif";
let saver=fn(value) {state.writes=state.writes+1;return map{ok:not state.stale,reload:state.stale};};
let loader=fn() {state.reads=state.reads+1;return state.result;};
App.enable_preferences(c,style,saver,"Ready",loader);App.refresh(c);act(c,"font_family");
let draft=c.preferences.draft;let applied=c.appearance;act(c,"style_save");
check(state.writes==1 and c.preferences.save==nil,"conflict blocks saver");
check(c.preferences.draft==draft and c.appearance==applied,"conflict keeps both styles");
for bad in [nil,map{},map{ok:false},map{ok:true,appearance:map{},save:saver},map{ok:true,appearance:style,save:nil}] {
    state.result=bad;check(not App.reload_preferences(c),"malformed or unavailable reload rejected");
    check(c.preferences.draft==draft and c.appearance==applied and c.preferences.save==nil,"failed reload preserves styles and blocking");
}
let invalid=Profile.defaults();invalid.body_size=999;state.result=map{ok:true,appearance:invalid,save:saver};
check(not App.reload_preferences(c) and c.appearance==applied,"invalid appearance rejected");
let saved=Profile.defaults();saved.font_family="monospace";state.result=map{ok:true,appearance:saved,save:saver};
check(App.reload_preferences(c),"explicit valid reload accepted");App.refresh(c);
check(c.preferences.draft==saved and c.appearance==saved and c.preferences.save!=nil,"reload replaces draft/applied and restores saver");
check(state.writes==1,"reload never saves");
state.stale=false;act(c,"font_family");act(c,"style_save");check(state.writes==2 and c.appearance.font_family=="system","save after reload succeeds");
let before=state.reads;c.form.focus="style_reload";App.update(c,[map{type:"keydown",key:"Enter"}]);App.update(c,[map{type:"keydown",key:"Enter"}]);App.update(c,[map{type:"keyup",key:"Enter"}]);
check(state.reads==before+1,"held reload invokes once");
for i 12 {
    state.stale=true;act(c,"style_save");check(c.preferences.save==nil,"churn conflict blocks");
    let writes=state.writes;App.update(c,[]);App.update(c,[]);check(state.writes==writes,"no automatic retry");
    state.result=map{ok:false};check(not App.reload_preferences(c) and c.preferences.save==nil,"churn bad reload stays blocked");
    state.result=map{ok:true,appearance:saved,save:saver};check(App.reload_preferences(c),"churn explicit recovery");App.refresh(c);
}
let reads=state.reads;for i 20 {App.update(c,[]);}check(state.reads==reads,"no background polling");
for height in [240,320,480,816] {
    App.update(c,[map{type:"resize",w:320,h:height}]);let seen=map{};let count=if c.settings_layout==nil {1} else {c.settings_layout.count};
    for page count {
        App.settings_page(c,page);App.update(c,[]);
        for w in c.form.widgets {check(w.x>=0 and w.y>=0 and w.x+w.w<=c.width and w.y+w.h<=c.height,"controls stay in viewport");}
        for name in Settings.names(true,true) {if GUI.get(c.form,name)!=nil {seen[name]=true;}}
    }
    check(len(seen)==10,"all ten choices/actions reachable");
}
let stable=c.appearance;let stable_draft=c.preferences.draft;
App.enable_preferences(c,nil,saver,"Ready",fn(){throw "synthetic unavailable";});
check(not App.reload_preferences(c) and c.appearance==stable and c.preferences.draft==stable_draft,"throwing reload preserves styles");
check(try {App.enable_preferences(c,nil,saver,"Ready",42);false} catch true,"noncallable loader rejected");
c.session.close();print "reader_reload_pass checks="+str(n);
