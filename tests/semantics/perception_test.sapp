// tests/semantics/perception_test.sapp
// Perception (screen/OCR/audio) must be gated by Master Control: while locked, every
// capture request is denied; nothing captures without a human unlock + approval.
let p = import("stdlib:perception.sapp");

fn fail(m) { throw "FAIL " + m; }

// backends() reports tool availability as booleans (no capture performed)
let b = p.backends();
if type(b.screenshot) != "bool" or type(b.ocr) != "bool" or type(b.audio) != "bool" {
    fail("backends() should report booleans (got " + str(b) + ")");
}

// Master control is locked by default in a fresh run -> every request is denied.
let s = p.screen();
if s.status != "denied" { fail("screen() must be denied while locked (got " + str(s.status) + ")"); }
let o = p.ocr("/tmp/whatever.png");
if o.status != "denied" { fail("ocr() must be denied while locked"); }
let a = p.audio(2);
if a.status != "denied" { fail("audio() must be denied while locked"); }
let ss = p.screen_sampling(3, 100, map{});
if ss.status != "denied" { fail("screen_sampling() must be denied while locked"); }

// run() with no approval / no pending executor is refused.
let r = p.run(1, "no-nonce");
if r.ok != false { fail("run() must refuse without unlock/approval"); }

print "perception_pass";
