let Analysis = import("stdlib:pbck_analysis.sapp");
let PBCK = import("stdlib:selfhost_pbck.sapp");

fn fail(message) { throw "FAIL pbck_analysis: " + message; }

let body = map{
    instructions: [map{ op: 16, operand: 7 }, map{ op: 19, operand: 0 }],
    constants: []
};
let handler = map{ instructions: [map{ op: 0, operand: 0 }], constants: [false] };
let root = map{
    instructions: [
        map{ op: 0, operand: 0 }, map{ op: 24, operand: 1 },
        map{ op: 18, operand: 3 }, map{ op: 35, operand: 2 },
        map{ op: 25, operand: 4 }
    ],
    constants: ["name", map{ arity: 2, chunk: body, upvalues: [map{ index: 0, is_local: true }] },
        map{ try_chunk: body, catch_chunk: handler }]
};
let report = Analysis.analyze_bytes(PBCK.serialize_chunk(root));
if report.instructions != 10 or report.chunks != 4 or report.functions != 1
    or report.try_blocks != 1 or report.max_depth != 1 or report.max_arity != 2
    or report.max_upvalues != 1 or report.max_slot != 7 or report.max_call_arity != 3
    or report.max_collection_items != 4 or report.constant_kinds.string != 1
    or report.constant_kinds.function != 1 or report.constant_kinds.try != 1
    or len(report.opcodes) != 7 {
    fail("recursive requirement report mismatch");
}
let rejected = try { Analysis.analyze(map{ instructions: [map{ op: 99, operand: 0 }], constants: [] }); false } catch true;
if not rejected { fail("invalid bytecode was accepted"); }

print "pbck_analysis_pass";
