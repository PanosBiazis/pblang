let T=import("stdlib:security_taint.sapp");
fn expect(ok,label) {if not ok {throw "FAIL taint-limits-contract: "+label;}}
let specs=[
    ["max_taint_tokens",1,1048576,65536],
    ["max_taint_source_bytes",1,134217728,1048576],
    ["max_taint_findings",1,2048,256],
    ["max_taint_steps",100,2000000,200000],
    ["max_call_expansions",1,200000,20000]
];
let expected=map{ok:true,max_taint_tokens:65536,max_taint_source_bytes:1048576,
    max_taint_findings:256,max_taint_steps:200000,max_call_expansions:20000};
expect(json_stringify(T.limits())==json_stringify(expected),"exact default schema");
expect(json_stringify(T.limits(nil))==json_stringify(expected),"nil options default");
let invalid=[nil,true,false,"private-limit-marker",[],map{},fn(){return 1;},
    parse_number("NaN"),parse_number("inf"),parse_number("-inf"),bigint(100),rational("100/1"),decimal("100")];
let all_bad=map{};
for spec in specs {all_bad[spec[0]]=nil;}
for spec in specs {
    let error=spec[0]+" must be a finite integer in "+str(spec[1])+".."+str(spec[2]);
    expect(json_stringify(T.limits(all_bad))==json_stringify(map{ok:false,error:error}),"first invalid field wins");
    all_bad[spec[0]]=spec[3];
    let values=[];for value in invalid {push(values,value);}
    for value in [spec[1]-1,spec[2]+1,spec[1]+0.5] {push(values,value);}
    for value in values {
        let options=map{};options[spec[0]]=value;
        expect(json_stringify(T.limits(options))==json_stringify(map{ok:false,error:error}),"exact value-free error");
    }
    for value in [spec[1],spec[2]] {
        let options=map{unrelated:"untouched"};options[spec[0]]=value;
        let before=json_stringify(options);let result=T.limits(options);
        expect(result.ok and result[spec[0]]==value and len(map_keys(result))==6,"boundary and schema");
        result[spec[0]]=0;
        expect(json_stringify(options)==before,"input is not mutated or aliased");
        expect(T.limits(options)[spec[0]]==value,"result maps are independent");
    }
}
for options in [true,1,"private-limit-marker",[],fn(){return 1;}] {
    expect(json_stringify(T.limits(options))==json_stringify(map{ok:false,error:"taint limits require map options"}),"non-map rejected");
}
expect(json_stringify(T.limits(all_bad))==json_stringify(expected),"all repaired fields pass");
print "security_taint_limits_contract_pass";
