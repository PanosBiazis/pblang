let Circuit = import("stdlib:embedded_circuit.sapp");
let Controller = import("stdlib:embedded_controller.sapp");

let circuit = Circuit.new(map{name:"Controller test", mode:"emulator"});
assert(Circuit.add_device(circuit, "uno", "arduino-uno").ok, "emulated UNO added");
let session = Controller.connect(circuit, "uno", map{timeout_ms:100,retries:1,reset_wait_ms:0});
assert(session.ok and session.connected and session.synchronized,
    "controller performs status handshake");
let status = Controller.status(session);
assert(status.ok and not status.applied and status.circuit.state_verified,
    "status observes state without claiming a mutation");

let on = Controller.set_led(session, true);
assert(on.ok and on.response.on and Circuit.snapshot(circuit).devices[0].observed_on,
    "controller applies on through shared protocol");
let toggled = Controller.toggle_led(session);
assert(toggled.ok and not toggled.response.on,
    "controller applies toggle");
let blink = Controller.set_blink(session, true, 100, 350);
assert(blink.ok and blink.response.blinking and blink.response.on,
    "controller starts bounded finite blink");
let tick = Controller.tick(session, 100);
assert(tick.ok and not session.protocol_device.on
    and not Circuit.snapshot(circuit).devices[0].observed_on,
    "protocol and circuit emulators advance together");
Controller.tick(session, 250);
assert(not session.protocol_device.blinking
    and not Circuit.snapshot(circuit).devices[0].blink.enabled,
    "both emulators finish finite blink off");

let stopped = Controller.set_blink(session, false, 500, 0);
assert(stopped.ok and not stopped.response.blinking and not stopped.response.on,
    "explicit stop is idempotent");
assert(not Controller.set_blink(session, true, 9, 100).ok,
    "unsafe high-frequency blink rejected before transport");
assert(Controller.close(session).ok and session.closed,
    "session closes deterministically");
assert(not Controller.set_led(session, true).ok,
    "closed session rejects mutation");

let wired = Circuit.new(map{mode:"wired"});
assert(Circuit.add_device(wired, "uno", "arduino-uno", map{port:"/dev/ttyUSB99"}).ok,
    "wired contract accepts bounded USB TTY namespace");
let unavailable = Controller.connect(wired, "uno", map{reset_wait_ms:0,timeout_ms:20,retries:1});
assert(not unavailable.ok and unavailable.code == "serial-open",
    "missing physical port fails closed without state acknowledgement");

print "embedded_controller_pass";
