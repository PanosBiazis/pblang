// tests/semantics/llm_core_enrich_test.sapp — enrichment for stdlib/llm_core.sapp
// Adds activation vectors (sigmoid/tanh/gelu) and training utils (l2_norm, clip_grad).

let core = import("stdlib/llm_core.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn aeq(v, w, m) {
    if len(v) != len(w) { fail(m + " len"); }
    let i = 0; while i < len(v) { if num_abs(v[i] - w[i]) > 0.0001 { fail(m + " @" + str(i) + " : " + str(v)); } i = i + 1; }
}

// ── base softmax still works ─────────────────────────────────────────────────────
let sm = core.softmax([1, 2, 3]);
near(sm[0] + sm[1] + sm[2], 1, "softmax sums to 1");

// ── ENRICH: activation vectors ───────────────────────────────────────────────────
near(core.sigmoid_vec([0])[0], 0.5, "sigmoid(0)=0.5");
near(core.tanh_vec([0])[0], 0, "tanh(0)=0");
near(core.gelu_vec([0])[0], 0, "gelu(0)=0");
if core.tanh_vec([5])[0] <= 0.99 { fail("tanh(5) should be near 1"); }

// ── ENRICH: l2_norm + clip_grad ──────────────────────────────────────────────────
near(core.l2_norm([3, 4]), 5, "l2_norm");
aeq(core.clip_grad([3, 4], 10), [3, 4], "clip_grad under threshold unchanged");
aeq(core.clip_grad([6, 8], 5), [3, 4], "clip_grad scales to max_norm");

print "llm_core_enrich_pass";
