let AI=import("stdlib/pbai.sapp");let S=import("stdlib:pbai_sensor.sapp");let R=import("stdlib:controlled_modularity.sapp");
let request=map{values:[2,4,6,100],period_seconds:1,sigma:3,absolute_tolerance:1};
let empty=AI.modular_bind("sensor-v1",S,R).metrics();
let expected_empty=map{format:"pbai.modular.metrics.v1",scope:"binding-since-clear",limit:1024,
 observed_calls:0,window_full:false,observations_dropped:false,rejected_calls:0,executed_calls:0,
 provider_results:0,provider_errors:0,execution_errors:0,unclassified_replies:0,
 duration:map{source:"now_ms",unit:"ms",monotonic:false,max_valid_ms:86400000,
 samples:0,invalid_samples:0,total_ms:0,min_ms:nil,max_ms:nil},
 includes_probe:false,persistence:false,retains_payloads:false,artifact_authenticated:false,authorizes_action:false};
assert(json_stringify(empty)==json_stringify(expected_empty),"snapshot preserves the complete public metrics schema");
let retained=[];let cycle=0;
while cycle<32 {
 let b=AI.modular_bind_limited("sensor-v1",S,R,map{max_calls:2});
 let result=b.run(request);let completed=b.metrics();let completed_json=json_stringify(completed);
 b.run(nil);let failed=b.metrics();let failed_json=json_stringify(failed);
 b.cancel();assert(b.run(nil).error=="binding_cancelled","completed binding remains cancelled");
 let cancelled=b.metrics();let cancelled_json=json_stringify(cancelled);
 b.clear_metrics();assert(b.metrics().observed_calls==0 and b.status().cancelled,"clear preserves lifecycle");
 push(retained,map{completed:completed,completed_json:completed_json,failed:failed,failed_json:failed_json,
  cancelled:cancelled,cancelled_json:cancelled_json,result:result,result_json:json_stringify(result)});
 cycle=cycle+1;
}
assert(len(retained)==32,"bounded repeated lifecycle workload");
for row in retained {
 assert(json_stringify(row.completed)==row.completed_json and row.completed.executed_calls==1,"completion snapshot survives later errors and resets");
 assert(json_stringify(row.failed)==row.failed_json and row.failed.provider_errors==1,"provider error snapshot survives cancellation");
 assert(json_stringify(row.cancelled)==row.cancelled_json and row.cancelled.rejected_calls==1,"cancelled snapshot belongs to its own completed cycle");
 assert(json_stringify(row.result)==row.result_json and row.result.output.value.outlier,"original numerical result retained");
}
let active=AI.modular_bind("sensor-v1",S,R);active.run(request);
let snapshot=active.metrics();let untouched=active.metrics();let expected=json_stringify(untouched);
snapshot.format="edited";snapshot.limit=999;snapshot.authorizes_action=true;
snapshot.duration.source="edited";snapshot.duration.samples=999;snapshot.duration.total_ms=999;
assert(json_stringify(active.metrics())==expected and json_stringify(untouched)==expected,"all mutable containers detached despite shared immutable scalar values");
active.cancel();let held=[];
let before=gc_stats();let count=0;while count<100 {push(held,active.metrics());count=count+1;}let after=gc_stats();
fn counter(raw,key) {for word in str_split(raw," ") {let parts=str_split(word,"=");if len(parts)==2 and parts[0]==key {return parse_number(parts[1]);}}throw "counter unavailable";}
assert(counter(after,"map_allocs")-counter(before,"map_allocs")==200,"two independent maps per retained snapshot");
assert(counter(after,"string_allocs")-counter(before,"string_allocs")==1,"only the gc_stats probe string, no snapshot JSON roundtrip strings");
active.clear_metrics();assert(held[0].executed_calls==1 and held[99].executed_calls==1,"old snapshots outlive private reset");
held[0].duration.samples=999;assert(held[99].duration.samples!=999 and active.metrics().duration.samples==0,"snapshots never share mutable duration maps");
print "pbai_modularity_snapshot_cycles_pass";
