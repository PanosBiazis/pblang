let C = import("stdlib:crud_records.sapp");
fn denied(action) { let failed = false; try action() catch { failed = true; }; return failed; }
assert(not denied(fn(){ return true; }), "test helper accepts successful actions");
for value in [nil, [], "", "0", "01", "1e3", "1 OR 1=1", "-1", "2147483648", " 1"] {
    assert(denied(fn() { C.decimal(value, 1); }), "strict ID");
}
assert(C.decimal("2147483647", 1) == 2147483647, "maximum ID");
for value in [nil, 1, "", "bad\ntext", "bad\u0000text"] { assert(denied(fn(){ C.text(value); }), "bad text"); }
let store = C.create(2);
let row = map{ id: 2, name: "Δοκιμή <script>", country: "Example", time: "01:20" };
let inserted = store.insert(row, 0); row.name = "changed"; inserted.name = "changed";
assert(store.list().rows[0].name == "Δοκιμή <script>", "input and return detached");
assert(denied(fn(){ store.insert(row, 1); }), "duplicate");
assert(denied(fn(){ store.update(row, 0); }), "stale revision");
assert(store.info().revision == 1, "failed mutation unchanged");
store.insert(map{ id: 1, name: "Second", country: "Elsewhere", time: "01:23" }, 1);
assert(store.list().rows[0].id == 1, "numeric ID order");
assert(len(store.list(0, 1).rows) == 1 and store.list().matched == 2, "pagination");
assert(store.list(0, 25, "example").matched == 1, "search");
assert(denied(fn(){ store.insert(map{ id: 3, name: "Third", country: "Example", time: "1" }, 2); }), "capacity");
let page = store.list(); page.rows[0].name = "changed";
assert(store.list().rows[0].name == "Second", "read detached");
store.update(row, 2); assert(store.info().revision == 3, "update");
assert(denied(fn(){ store.remove(999, 3); }), "missing ID");
store.remove(1, 3); assert(store.info().count == 1, "delete");
assert(denied(fn(){ store.clear(4, "yes"); }), "typed confirmation");
store.clear(4, "DELETE ALL"); assert(store.info().count == 0, "clear");
store.close(); store.close(); assert(denied(fn(){ store.list(); }), "closed");
print "crud_records_pass";
