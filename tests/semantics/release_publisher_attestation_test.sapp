let E = import("stdlib:product_release_evidence.sapp");

let A = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
let B = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
let C = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc";
let D = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd";
let COMMIT = "0123456789abcdef0123456789abcdef01234567";
let HEX = "0123456789abcdef";

fn nibble(ch) {
    let i = 0;
    while i < 16 {
        if str_slice(HEX, i, i + 1) == str_lower(ch) { return i; }
        i = i + 1;
    }
    throw "invalid test hex";
}

fn bytes(text) {
    let out = []; let i = 0;
    while i < len(text) {
        array_push(out, nibble(str_slice(text, i, i + 1)) * 16
        + nibble(str_slice(text, i + 1, i + 2)));
        i = i + 2;
    }
    return out;
}

fn source() {
    return E.source("demo", "1.2.3", "stable", "0.6.0-alpha", A, B, C, COMMIT,
    map{clean_tree:true, reproducible_inputs:true});
}

fn artifact(source_row) {
    return E.artifact(source_row, "demo-linux", B, 4096, A, "1.2.3", "stable",
    ["linux:x86_64", "linux:aarch64"], map{
        signed_artifact:true, signature_sha256:C, sbom_sha256:D,
        attestation_sha256:A, install_verified:true, upgrade_verified:true,
        rollback_verified:true, uninstall_verified:true
    });
}

fn public_key() {
    return bytes("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a");
}

fn signature() {
    // OpenSSL 3 signature over the canonical release frame, using RFC 8032's
    // published test seed. No private production material is present here.
    return bytes("6a6cd58be58665c24739af4937b0cea5e8dbbc8ce1a87cf492d154b432821533"
    + "8524205149fdf548059edc077eced34b986ac6ca7c6a510a16c283e33f78c002");
}

fn attestation(source_row, artifact_row, policy_row) {
    return E.publisher_attestation(source_row, artifact_row, policy_row,
    "org.example.demo", 42, signature());
}

fn rejected(callable) {
    let failed = false;
    try { callable(); } catch { failed = true; }
    return failed;
}

fn not_verified(callable) {
    let verdict = nil; let failed = false;
    try { verdict = callable(); } catch { failed = true; }
    if failed { return true; }
    return not verdict.ed25519_signature_verified
    and not verdict.release_binding_verified and not verdict.authorizes_execution;
}

fn test_release_publisher_attestation_is_cryptographic_but_not_operational_trust() {
    let source_row = source(); let artifact_row = artifact(source_row);
    let key = public_key(); let policy_row = E.publisher_policy("example-publisher", 3, key);
    assert(policy_row.key_id == "21fe31dfa154a261626bf854046fd2271b7bed4b6abe45aa58877ef47f9721b9",
    "publisher key id must be SHA-256 of the raw pinned public key");

    // The policy owns a detached key copy rather than retaining caller memory.
    key[0] = key[0] + 1;
    let signed = attestation(source_row, artifact_row, policy_row);
    let verified = E.verify_publisher_attestation(source_row, artifact_row, policy_row, signed);
    assert(verified.ed25519_signature_verified and verified.release_binding_verified
    and verified.configured_publisher_key_matched,
    "independent Ed25519 fixture must authenticate the complete release binding");
    assert(not verified.operator_trust_anchor_origin_verified
    and not verified.artifact_bytes_measured
    and not verified.same_verified_artifact_handoff
    and not verified.rollback_protection_enforced
    and not verified.publisher_authenticity_verified
    and not verified.authorizes_execution and not verified.production_ready,
    "cryptographic claim verification must not become operational publisher trust");

    let message = E.publisher_attestation_message(source_row, artifact_row, policy_row,
    "org.example.demo", 42);
    let original_first = message[0]; message[0] = original_first + 1;
    assert(E.publisher_attestation_message(source_row, artifact_row, policy_row,
    "org.example.demo", 42)[0] == original_first,
    "canonical signing messages must be detached from caller mutation");

    let external_signature = signature();
    let detached = E.publisher_attestation(source_row, artifact_row, policy_row,
    "org.example.demo", 42, external_signature);
    external_signature[0] = external_signature[0] + 1;
    assert(E.verify_publisher_attestation(source_row, artifact_row, policy_row,
    detached).ed25519_signature_verified,
    "attestations must detach caller-owned signature arrays");

    let bad_signature = attestation(source_row, artifact_row, policy_row);
    bad_signature.signature[0] = bad_signature.signature[0] + 1;
    assert(not_verified(fn() { return E.verify_publisher_attestation(source_row,
        artifact_row, policy_row, bad_signature); }),
    "invalid Ed25519 signatures return a non-authorizing result");

    let scalar_mutations = map{
        publisher_id:"other-publisher", key_id:A, policy_revision:4,
        algorithm:"digest-only", product:"other-product", package_id:"org.example.other",
        application_version:"1.2.4", release_channel:"nightly", release_sequence:43,
        artifact_name:"other-artifact", artifact_sha256:C, byte_count:4097,
        source_sha256:B, manifest_sha256:C, lock_sha256:D,
        commit_id:"1123456789abcdef0123456789abcdef01234567", sbom_sha256:A
    };
    for field in map_keys(scalar_mutations) {
        let changed = attestation(source_row, artifact_row, policy_row);
        changed[field] = scalar_mutations[field];
        assert(not_verified(fn() { return E.verify_publisher_attestation(source_row,
            artifact_row, policy_row, changed); }),
        "signed field mutation must fail closed: " + field);
    }

    let reordered = attestation(source_row, artifact_row, policy_row);
    reordered.targets = ["linux:x86_64", "linux:aarch64"];
    assert(rejected(fn() { E.verify_publisher_attestation(source_row,
        artifact_row, policy_row, reordered); }),
    "unsorted target sets must not acquire an alternate canonical encoding");

    let extra = attestation(source_row, artifact_row, policy_row);
    extra.trust_verified = true;
    assert(rejected(fn() { E.verify_publisher_attestation(source_row,
        artifact_row, policy_row, extra); }),
    "caller-forged trust fields must fail the exact attestation schema");

    let tampered_policy = E.publisher_policy("example-publisher", 3, public_key());
    tampered_policy.public_key[0] = tampered_policy.public_key[0] + 1;
    assert(rejected(fn() { E.verify_publisher_attestation(source_row,
        artifact_row, tampered_policy, signed); }),
    "mutable policy keys must be revalidated against their derived key id");

    assert(rejected(fn() { E.publisher_attestation(source_row, artifact_row,
        policy_row, "org.example.demo", 42, [1, 2, 3]); }),
    "malformed signatures must fail before an attestation is constructed");
}
