let F=import("stdlib:compiler/selfhost_frontend.sapp");
let result=F.frontend_run("let P=import(\"stdlib:sql_predicate.sapp\"); let p=P.compile_all([[\"age\",\"ge\",18],[\"note\",\"eq\",nil]]); print p.sql; print p.params; print (try P.compile_all([[\"a\",\"EQ\",1]]) catch \"rejected\");");
if not result.ok or result.output != ["([age] >= ?) AND ([note] IS NULL)",[18],"rejected"] {throw "FAIL: selfhost predicate parity";}
let membership=F.frontend_run("let P=import(\"stdlib:sql_predicate.sapp\"); let p=P.compile_all([[\"a\",\"in\",[1,nil,true]],[\"b\",\"not_in\",[]]]); print p.sql; print p.params; print (try P.compile_all([[\"a\",\"in\",[map{}]]]) catch \"rejected\");");
if not membership.ok or membership.output != ["([a] IN (?, ?, ?)) AND ([b] NOT IN (SELECT 1 WHERE 0))",[1,nil,true],"rejected"] {throw "FAIL: selfhost membership parity";}
let cached=F.frontend_run("let P=import(\"stdlib:sql_predicate.sapp\"); let hooks=0; let evil=map{__eq__:fn(x){hooks=hooks+1;return true;},__ne__:fn(x){hooks=hooks+1;return false;}}; print (try P.compile_all([[\"a\",\"eq\",1],[evil,\"eq\",2]]) catch \"rejected\"); print hooks; let p=P.compile_all([[\"a\",\"ge\",1],[\"a\",\"le\",9],[\"b\",\"eq\",2]]); print p.sql; print p.params;");
if not cached.ok or cached.output != ["rejected",0,"([a] >= ?) AND ([a] <= ?) AND ([b] = ?)",[1,9,2]] {throw "FAIL: selfhost column reuse parity";}
print "selfhost_sql_predicate_pass";
