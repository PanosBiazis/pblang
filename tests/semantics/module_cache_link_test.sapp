// Link the real cache dependency closure; resolver reads only the test project.
let I=import("stdlib:source_inliner.sapp");
fn resolve(path) {
    let p=path;
    if str_starts_with(p,"stdlib:") { p="stdlib/"+str_slice(p,7,len(p)); }
    return try fs_read(p) catch nil;
}
let r=I.inline_source_prefixed("let C=import(\"stdlib:compiler/module_cache.sapp\"); print C.FORMAT;",resolve);
print json_stringify(map{ok:r.ok,reason:try r.reason catch "",modules:try r.modules catch 0});
if not r.ok { throw "cache dependency link failed"; }
print "module_cache_link_pass";
