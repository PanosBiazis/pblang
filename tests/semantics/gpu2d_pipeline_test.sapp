// tests/semantics/gpu2d_pipeline_test.sapp — stdlib/gpu2d_pipeline.sapp
//
// The capstone facade for the GPU 2D stack: build a scene (rounded panels + text as
// instanced quads, strokes + gradients as tessellated mesh), bake both buffers (parallel),
// emit the polyglot host, and — critically — run it ONLY through polyglot_guard, so
// generated or tampered host code that trips the safety scan is refused before execution.

let GP = import("stdlib/gpu2d_pipeline.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }

let RED = map{ r: 255, g: 0, b: 0, a: 255 };
let BLUE = map{ r: 0, g: 0, b: 255, a: 255 };
let PANEL = map{ r: 20, g: 22, b: 34, a: 255 };

// ── build a mixed scene ─────────────────────────────────────────────────────────────
let sc = GP.new(800, 600);
GP.rrect(sc, 10, 10, 200, 120, 8, PANEL);       // a rounded panel (quad path)
GP.rect(sc, 0, 0, 800, 30, PANEL);              // a toolbar (quad path)
GP.glyph(sc, 12, 12, 8, 12, map{ u0: 0, v0: 0, u1: 0.1, v1: 0.2 }, RED);  // text (quad path)
GP.line(sc, 0, 30, 800, 30, 2, RED);            // a divider (mesh path)
GP.gradient(sc, 0, 570, 800, 30, PANEL, BLUE, true);  // a gradient footer (mesh path)

// ── bake: two buffers, two draw calls ───────────────────────────────────────────────
let baked = GP.bake(sc);
eq(baked.quad_instances, 3, "three instanced quads");
eq(len(baked.quad_buffer), 3 * 14, "quad buffer floats");
truthy(baked.mesh_vertices > 0, "mesh has vertices");
eq(baked.draw_calls, 2, "one instanced + one mesh draw");

// parallel bake matches
eq(len(GP.bake_par(sc).quad_buffer), len(baked.quad_buffer), "parallel bake same size");

// ── program(): the generated host + its guard verdict, WITHOUT running ──────────────
let prog = GP.program(sc, "python-moderngl");
eq(prog.lang, "python", "target maps to python");
truthy(prog.safe, "generated host passes the safety scan");
truthy(str_contains(prog.code, "moderngl"), "host code is the real thing");

// ── guarded_run(): asserts safe THEN hands the host to a runner ─────────────────────
// stub runner stands in for stdlib/polyglot.run (no GPU/toolchain in the test harness).
let ran = GP.guarded_run(sc, "python-moderngl", fn(lang, code) {
    if not str_contains(code, "moderngl") { fail("runner got wrong code"); }
    return "RAN:" + lang;
});
eq(ran, "RAN:python", "safe host runs through the guard");

// every target is guardable
eq(len(GP.targets()), 4, "four polyglot targets");

print "gpu2d_pipeline_pass";
