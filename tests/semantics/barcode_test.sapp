let Barcode = import("stdlib:barcode.sapp");
let Image = import("stdlib:image_pipeline.sapp");

assert(Barcode.self_check().ok, "barcode tables pass structural checks");

let ean = Barcode.encode("400638133393", "ean13");
assert(ean.ok and ean.payload == "4006381333931" and ean.check_digit == 1,
    "EAN-13 generates the GS1 reference check digit");
assert(ean.module_count == 95 and str_starts_with(ean.modules, "101")
    and str_slice(ean.modules, 45, 50) == "01010" and str_ends_with(ean.modules, "101"),
    "EAN-13 has standard guards and 95 modules");
assert(ean.modules ==
    "10100011010100111010111101111010001001011001101010100001010000101000010111010010000101100110101",
    "EAN-13 complete module stream matches the independent reference vector");
assert(Barcode.encode("4006381333931", "ean-13").ok,
    "EAN-13 accepts an already valid check digit");
assert(not Barcode.encode("4006381333932", "ean13").ok,
    "EAN-13 rejects an invalid check digit");

let upc = Barcode.encode("03600029145", "upc");
assert(upc.ok and upc.payload == "036000291452" and upc.check_digit == 2,
    "UPC-A generates the known check digit");
assert(upc.module_count == 95 and Barcode.encode("036000291452", "upca").ok,
    "UPC-A emits the 95-module retail symbol and validates complete input");

let code = Barcode.encode("1234", "code128");
assert(code.ok and code.symbology == "code128b" and code.check_digit == 88,
    "Code 128 Set B checksum matches the independent vector");
assert(code.code_values == [104, 17, 18, 19, 20, 88, 106]
    and code.module_count == 79,
    "Code 128 Set B uses start B, data, checksum and stop values");
assert(code.modules ==
    "1101001000010011100110110011100101100101110011001001110111100100101100011101011",
    "Code 128 Set B complete module stream matches the independent reference vector");

let plan = Barcode.render_plan(ean, 3, 96);
assert(plan.ok and plan.width == 345 and plan.height == 96 and len(plan.bars) > 20,
    "portable bar plan includes quiet zones and bounded geometry");
let svg = Barcode.to_svg(code, 2, 64, "#112233", "#ffffff");
assert(str_starts_with(svg, "<svg") and str_contains(svg, "aria-label=\"Linear barcode\"")
    and not str_contains(svg, "1234"), "SVG is local, accessible and omits payload metadata");
let png = Barcode.to_png(upc, 1, 32);
let decoded = Image.decode_png(png);
assert(decoded.width == 115 and decoded.height == 32,
    "PNG output round-trips through the native image pipeline");

assert(not Barcode.encode("", "code128").ok, "empty Code 128 payload is rejected");
assert(not Barcode.encode("line\nbreak", "code128").ok,
    "Code 128 Set B rejects control characters");
assert(not Barcode.encode("12345A789012", "ean13").ok,
    "EAN-13 rejects non-digits");
assert(not Barcode.encode("123", "upca").ok, "UPC-A rejects wrong lengths");
assert(not Barcode.encode("123", "unknown").ok, "unknown symbology fails closed");
assert(not Barcode.capabilities().gs1_128 and not Barcode.capabilities().fnc1,
    "unsupported GS1-128 behavior is not advertised");

print "barcode_pass";
