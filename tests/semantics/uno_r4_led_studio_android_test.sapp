let App=import("../../examples/uno_r4_led_studio/platforms/android/config.sapp");
let WebView=import("stdlib:android_webview.sapp");
let options=App.options();
assert(not options.javascript,"Studio needs no JavaScript");
assert(options.url=="http://127.0.0.1:18774/","USB loopback endpoint");
let generated=WebView.generate(App.name(),options);
assert(generated.package==App.PACKAGE,"own application identity");
assert(str_contains(generated.manifest,"android:allowBackup=\"false\""),"no Android backup");
assert(not str_contains(generated.manifest,"CAMERA") and not str_contains(generated.manifest,"RECORD_AUDIO"),"no media permissions");
let invalid=App.options();invalid.javascript="false";
assert((try WebView.generate(App.name(),invalid) catch nil)==nil,"reject boolean lookalike");
let enabled=App.options();enabled.javascript=true;
assert(json_stringify(WebView.generate(App.name(),enabled).class_bytes)!=json_stringify(generated.class_bytes),"disabled setting changes emitted executable");
print "uno_r4_led_studio_android_pass";
