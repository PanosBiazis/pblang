// tests/semantics/nn_graph_dynamics_test.sapp — metaphor-driven graph transforms:
// black/white holes, states of matter, lockers & keys, knots/strings, push-pull fans,
// colors/shapes/scales, dimensions, tornado, tsunami, iceberg.

let G = import("stdlib/nn_graph.sapp");
let D = import("stdlib/nn_graph_dynamics.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── states of matter -> mutability temperature ────────────────────────────────────
approx(D.phase_rate("solid"), 0.1, "solid is rigid");
approx(D.phase_rate("liquid"), 1, "liquid is normal");
approx(D.phase_rate("gas"), 2, "gas diffuses faster");
approx(D.phase_rate("plasma"), 4, "plasma is most volatile");

// ── black hole absorbs neighbors; white hole emits new nodes ───────────────────────
let bh = G.graph_new();
G.add_node(bh, 0, "linear"); G.add_node(bh, 0, "linear"); G.add_node(bh, 0, "linear"); G.add_node(bh, 0, "linear");
G.fully_connect(bh, 1);
D.black_hole(bh, 0, 2);
eq(G.node_count(bh), 2, "black hole consumes 2 neighbors");
let wh = G.graph_new();
G.add_node(wh, 0, "linear");
D.white_hole(wh, 0, 3, 1);
eq(G.node_count(wh), 4, "white hole emits 3 nodes");
if G.bond_count(wh, 0, 1) < 1 { fail("white hole wires outward"); }

// ── lockers & keys: a locked bond carries nothing until unlocked with the key ─────
let lk = G.graph_new();
G.add_node(lk, 0, "linear"); G.add_node(lk, 0, "linear");
G.add_bond(lk, 0, 1, 5);
D.lock_bond(lk, 0, "secret");
if not D.is_locked(lk, 0) { fail("bond is locked"); }
approx(G.bond_strength(lk, 0, 1), 0, "locked bond carries nothing");
D.unlock_bond(lk, 0, "wrong"); if not D.is_locked(lk, 0) { fail("wrong key stays locked"); }
D.unlock_bond(lk, 0, "secret");
if D.is_locked(lk, 0) { fail("right key unlocks"); }
approx(G.bond_strength(lk, 0, 1), 5, "unlocked bond restored");

// ── knots / strings: tie a subset into a clique ───────────────────────────────────
let kn = G.graph_new();
G.add_node(kn, 0, "linear"); G.add_node(kn, 0, "linear"); G.add_node(kn, 0, "linear");
D.knot(kn, [0, 1, 2], 1);
eq(G.bond_total(kn), 6, "knot of 3 = 6 directed bonds");

// ── push / pull fans (air direction) ──────────────────────────────────────────────
let pp = G.graph_new();
G.add_node(pp, 0, "linear"); G.add_node(pp, 0, "linear");
G.add_bond(pp, 0, 1, 2);
D.push(pp, 0, 3);                       // blow OUT of node 0
approx(G.bond_strength(pp, 0, 1), 6, "push amplifies outgoing");
D.pull(pp, 1, 2);                       // suck INTO node 1
approx(G.bond_strength(pp, 0, 1), 12, "pull amplifies incoming");

// ── colors / shapes / scales (atoms↔molecules↔particles) + dimensions ─────────────
let m = G.graph_new();
G.add_node(m, 0, "linear"); G.add_node(m, 0, "linear"); G.add_node(m, 0, "linear");
D.set_color(m, 0, "red"); D.set_color(m, 2, "red"); D.set_color(m, 1, "blue");
eq(len(D.group_by_color(m, "red")), 2, "group nodes by color");
D.set_shape(m, 0, "pentagon"); eq(D.get_shape(m, 0), "pentagon", "node shape");
D.set_scale(m, 0, "atom"); D.set_scale(m, 1, "molecule");
eq(D.get_scale(m, 1), "molecule", "node scale (atom/molecule/particle)");
D.set_dim(m, 0, 1); D.set_dim(m, 1, 1); D.set_dim(m, 2, 2);
D.connect_dimension(m, 1, 1);          // wire the two dim-1 nodes together
if G.bond_count(m, 0, 1) < 1 { fail("connect_dimension wires same-dimension nodes"); }

// ── tornado swirls biases; tsunami sends a multiplying wave; iceberg hides the body ─
let tg = G.graph_new();
G.add_node(tg, 1, "linear"); G.add_node(tg, 2, "linear"); G.add_node(tg, 3, "linear");
D.tornado(tg, [0, 1, 2]);
approx(tg.nodes[0].bias, 3, "tornado rotates biases");
let ts = G.graph_new();
G.add_node(ts, 0, "linear"); G.add_node(ts, 0, "linear"); G.add_node(ts, 0, "linear");
G.add_bond(ts, 0, 1, 1); G.add_bond(ts, 1, 2, 1);
D.tsunami(ts, 0, 2);
approx(G.bond_strength(ts, 0, 1), 2, "tsunami front 1");
approx(G.bond_strength(ts, 1, 2), 2, "tsunami travels to the next front");
let ib = G.graph_new();
G.add_node(ib, 0, "linear"); G.add_node(ib, 0, "linear");
G.add_bond(ib, 0, 1, 10);
D.iceberg(ib, 0, 0.1);
approx(G.bond_strength(ib, 0, 1), 1, "iceberg leaves only the visible tip");

print "nn_graph_dynamics_pass";
