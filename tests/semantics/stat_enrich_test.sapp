// tests/semantics/stat_enrich_test.sapp — enrichment for stdlib/stat.sapp
// Adds covariance, linear_regression, geometric_mean, harmonic_mean, range,
// quartiles, weighted_mean.

let stat = import("stdlib/stat.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base still works ─────────────────────────────────────────────────────────────
near(stat.mean([1, 2, 3, 4, 5]), 3, "mean"); near(stat.median([3, 1, 4, 1, 5]), 3, "median");

// ── ENRICH: covariance + linear_regression (perfect line y = 2x + 1) ─────────────
let x = [1, 2, 3, 4, 5];
let y = [3, 5, 7, 9, 11];
let lr = stat.linear_regression(x, y);
near(lr.slope, 2, "regression slope"); near(lr.intercept, 1, "regression intercept"); near(lr.r2, 1, "regression r2");
near(stat.covariance(x, y), 4, "covariance");      // pop cov of this set

// ── ENRICH: geometric / harmonic mean ────────────────────────────────────────────
near(stat.geometric_mean([1, 2, 4]), 2, "geometric_mean 1,2,4 = 2");
near(stat.harmonic_mean([1, 2, 4]), 3 / 1.75, "harmonic_mean");

// ── ENRICH: range / quartiles / weighted_mean ────────────────────────────────────
near(stat.range([3, 1, 4, 1, 5]), 4, "range = max-min");
let q = stat.quartiles([1, 2, 3, 4, 5]);
near(q.q2, 3, "quartile median");
near(stat.weighted_mean([1, 2, 3], [1, 1, 2]), 2.25, "weighted_mean (1+2+6)/4");

print "stat_enrich_pass";
