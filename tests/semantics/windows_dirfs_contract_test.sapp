let W = import("stdlib:windows_dirfs.sapp");
let ABI = import("stdlib:windows_native_abi.sapp");
let PE = import("stdlib:windows_pe.sapp");

fn fail(message) { throw "FAIL windows_dirfs: " + message; }

let profile = W.profile();
if profile.platform != "windows" or profile.architecture != "x86_64"
    or profile.root_api != "CreateFileW" or profile.relative_api != "NtCreateFile"
    or profile.object_attributes != 0x1040 or profile.open_options != 0x200000
    or profile.max_bytes != 67108864 or len(profile.bridge_sha256) != 64 {
    fail("profile constants");
}
let status = W.status();
if not status.root_handle or not status.root_relative_ntcreatefile
    or not status.obj_dont_reparse or not status.component_nofollow
    or not status.bounded_snapshot_reads or not status.bounded_range_snapshot_reads
    or not status.descriptor_advisory_locks
    or not status.atomic_handle_relative_rename or not status.exclusive_no_replace_create
    or status.pathname_fallback or not status.generated_pblang_abi_bridge
    or status.physical_windows_verified {
    fail("security boundary contract");
}
if platform() != "windows" {
    if W.available().ok { fail("non-Windows host reported available"); }
    if W.open(".").ok { fail("non-Windows open did not fail closed"); }
}

let artifact = ABI.artifact();
if not PE.inspect_dll_x64(artifact.bytes).ok or artifact.sha256 != profile.bridge_sha256 {
    fail("bridge artifact identity");
}
let path = ".pblang-win64-abi-package-test.dll";
let written = ABI.write_package_artifact(path);
if not written.ok or written.sha256 != artifact.sha256 or written.bytes != len(artifact.bytes)
    or not written.package_acl_required or written.runtime_staging {
    try fs_remove(path) catch nil; fail("package artifact generation");
}
let roundtrip = try fs_read_bytes(path) catch nil; try fs_remove(path) catch nil;
if roundtrip == nil or sha256(base64_encode_bytes(roundtrip)) != artifact.sha256 {
    fail("package artifact roundtrip");
}

print "windows_dirfs_contract_pass";
