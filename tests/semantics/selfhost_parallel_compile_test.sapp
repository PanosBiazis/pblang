// tests/semantics/selfhost_parallel_compile_test.sapp
// frontend_compile_many(sources) must compile a batch of independent sources and
// return results identical (order + ok flag + instruction count) to compiling each
// one sequentially. Parallelism is an implementation detail; correctness is the
// contract. Distinct sources catch loop-closure capture bugs (each spawn must see
// its OWN source, not a shared loop variable's final value).
let fe = import("stdlib:compiler/selfhost_frontend.sapp");

fn fail(m) { throw "FAIL " + m; }

// Distinct sources with distinct shapes so a capture bug would mismatch.
let sources = [
    "let a = 1;",
    "fn f(x) { return x + 1; } let b = f(2);",
    "let c = 0; let i = 0; while i < 3 { c = c + i; i = i + 1; }",
    "fn g(x, y) { return x * y; } let d = g(3, 4); let e = g(5, 6);"
];

// Reference: sequential per-source compile.
let expected = [];
let i = 0;
while i < len(sources) { array_push(expected, fe.frontend_compile(sources[i])); i = i + 1; }

let got = fe.frontend_compile_many(sources);

if len(got) != len(expected) { fail("length mismatch: got " + str(len(got)) + " want " + str(len(expected))); }

let j = 0;
while j < len(expected) {
    if got[j].ok != expected[j].ok { fail("ok mismatch at " + str(j)); }
    if len(got[j].chunk.instructions) != len(expected[j].chunk.instructions) {
        fail("instr count mismatch at " + str(j) + ": got " + str(len(got[j].chunk.instructions)) + " want " + str(len(expected[j].chunk.instructions)));
    }
    j = j + 1;
}

// Empty batch -> empty result.
if len(fe.frontend_compile_many([])) != 0 { fail("empty batch should return empty"); }

// ── frontend_compile_file_many: parallel file compile must match sequential ──────
let paths = [
    "stdlib/encoding.sapp",
    "stdlib/security.sapp",
    "stdlib/serialization.sapp",
    "stdlib/algorithms_extra.sapp"
];
let exp_files = [];
let p = 0;
while p < len(paths) { array_push(exp_files, fe.frontend_compile_file(paths[p])); p = p + 1; }

let got_files = fe.frontend_compile_file_many(paths);
if len(got_files) != len(exp_files) { fail("file_many length mismatch"); }
let q = 0;
while q < len(exp_files) {
    if got_files[q].ok != exp_files[q].ok { fail("file_many ok mismatch at " + str(q) + " (" + paths[q] + ")"); }
    if got_files[q].path != exp_files[q].path { fail("file_many path mismatch at " + str(q)); }
    if len(got_files[q].chunk.instructions) != len(exp_files[q].chunk.instructions) {
        fail("file_many instr mismatch at " + str(q));
    }
    q = q + 1;
}

print "selfhost_parallel_compile_pass";
