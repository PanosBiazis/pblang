// tests/semantics/bitmap_font_enrich2_test.sapp — wave 2 for stdlib/bitmap_font.sapp
// Word-wrap to a pixel width + multi-line measurement. char advance = 6px, height = 8px.

let F = import("stdlib/bitmap_font.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// "aa" = 12px, "aaa" = 18px. max width 13px fits "aa" but not "aa aa" (30px).
let lines = F.wrap_text("aa aa aa", 13);
eq(len(lines), 3, "wraps to 3 lines at 13px");
eq(lines[0], "aa", "line 0");

// a single word longer than the limit still gets its own line (never dropped)
let big = F.wrap_text("aaaaaa", 6);
eq(len(big), 1, "oversized word stays on one line");
eq(big[0], "aaaaaa", "oversized word preserved");

// empty string -> no lines
eq(len(F.wrap_text("", 100)), 0, "empty -> []");

// two words that fit together stay on one line
let one = F.wrap_text("hi yo", 100);
eq(len(one), 1, "fits on one line");
eq(one[0], "hi yo", "joined with space");

// measure_wrapped
let m = F.measure_wrapped("aa aa aa", 13);
eq(m.height, 24, "3 lines * 8px");
eq(m.width, 12, "widest line = 'aa' = 12px");

print "bitmap_font_enrich2_pass";
