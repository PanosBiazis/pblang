// Test: stdlib/project_audit.sapp project gap/security marker audit.

let A = import("stdlib:project_audit.sapp");

fn fail(m) { throw "FAIL " + m; }
fn has_kind(rows, kind) {
    let i = 0;
    while i < len(rows) {
        if rows[i].kind == kind { return true; }
        i = i + 1;
    }
    return false;
}

fn count_severity(rows, severity) {
    let n = 0;
    let i = 0;
    while i < len(rows) {
        if rows[i].severity == severity { n = n + 1; }
        i = i + 1;
    }
    return n;
}

fn has_text(rows, fragment) {
    let f = str_lower(fragment);
    let i = 0;
    while i < len(rows) {
        if str_contains(str_lower(rows[i].text), f) { return true; }
        i = i + 1;
    }
    return false;
}

let text = "fn demo() { return 1; }\n" +
    "// TODO: replace placeholder renderer\n" +
    "// not implemented: DOM mutation\n" +
    "let token = \"ghp_1234567890abcdefghijklmnopqrstuvwx\";\n" +
    "panic!(\"boom\");\n" +
    "// OOM risk: unbounded bins can hang\n";

let findings = A.scan_text("demo.sapp", text, 20);
if len(findings) < 5 { fail("scan_text finds multiple project markers"); }
if not has_kind(findings, "incomplete") { fail("scan_text detects incomplete markers"); }
if not has_kind(findings, "security") { fail("scan_text detects security markers"); }
if not has_kind(findings, "reliability") { fail("scan_text detects reliability markers"); }
if not has_kind(findings, "performance") { fail("scan_text detects performance markers"); }

let factorial_fn = A.scan_text("stdlib/algo.sapp", "// factorial(n) -> n!\nfn factorial(n) { return 1; }\nexport factorial;", 20);
if len(factorial_fn) != 0 { fail("factorial function names are not factorial-time performance findings"); }

let benign_fallbacks = A.scan_text("stdlib/async_io.sapp", "// poll a file for changes.\nlet value = try maybe_read() catch nil;", 20);
if len(benign_fallbacks) != 0 { fail("benign changes/catch-nil text should not be noisy audit findings"); }

let benign_timeout_docs = A.scan_text("src/resilience/timeout.rs", "//! Timeout pattern for preventing hanging operations\n//! Provides timeout enforcement for operations that may hang or take too long.", 20);
if len(benign_timeout_docs) != 0 { fail("defensive timeout documentation is not a performance finding"); }

let benign_style_docs = A.scan_text("CONTRIBUTING.md",
    "- Prefer explicit error handling over `.unwrap()` in library code\n" +
    "- Thread pool stdlib with deadlock diagnostics\n" +
    "- SafeChannel: Bounded/unbounded channels with backpressure handling\n", 20);
if len(benign_style_docs) != 0 { fail("style/concurrency guidance docs are not active reliability/performance findings"); }

let benign_historical_and_limits = A.scan_text("stdlib/concurrency.sapp",
    "// This module previously held Rust-style pseudocode.\n" +
    "// `ThreadPool::new`, `move ||`, `.unwrap()` did not parse as pblang.\n" +
    "// max instructions is used to prevent infinite loops.\n" +
    "// deadlock diagnostic returns a clear error instead of hanging forever.\n", 20);
if len(benign_historical_and_limits) != 0 { fail("historical pseudocode and defensive limits are not active findings"); }

let benign_memmap_docs = A.scan_text("memmap.sapp",
    "// reports free gaps between memory regions\n" +
    "fn gaps(mm, limit) { return []; }\n", 20);
if len(benign_memmap_docs) != 0 { fail("memory-map free gap terminology is not roadmap debt"); }

let benign_stub_names = A.scan_text("STRUCTURE.md",
    "`pblang-stub` is the self-extracting bundle launcher\n" +
    "The boot stub sets up the machine before kernel entry\n", 20);
if len(benign_stub_names) != 0 { fail("boot/pblang-stub names are not incomplete implementation findings"); }

let benign_security_words = A.scan_text("docs/pbai.md", "tokenizer tokens are model vocabulary pieces\nFilter secrets before learning.\nfs:/etc/passwd is a capability resource example\nskip appsettings api_key access_key filenames", 20);
if len(benign_security_words) != 0 { fail("tokenizer/docs/resource examples and safe key-name policy are not leaked-secret findings"); }

let benign_detector_literals = A.scan_text("src/security.sapp",
    "map{ name: \"private-key\", needle: \"BEGIN PRIVATE KEY\" }\n" +
    "if str_contains(s, \"BEGIN PRIVATE KEY\") { return true; }\n" +
    "if _contains(diff, \"unwrap()\") or _contains(diff, \"panic!\") { return map{ risk: \"high\" }; }\n", 20);
if len(benign_detector_literals) != 0 { fail("security and reliability detector literals are not active findings"); }

let benign_ui_runtime = A.scan_text("pbai_server.sapp", "headroom stays available\n<button title=\"Zoom in\">+</button>\nlet token = _server_token();\nreturn auth == \"Bearer \" + token;", 20);
if len(benign_ui_runtime) != 0 { fail("headroom, Zoom, and runtime token variables are not audit findings"); }

let benign_policy_docs = A.scan_text("docs/Embedding.md", "- `allow_all: true` -- no allowlist\n- When `allow_all` is false, only listed libs/symbols are allowed.", 20);
if len(benign_policy_docs) != 0 { fail("FFI policy field documentation is not a capability escalation finding"); }

let benign_policy_source = A.scan_records([
    map{ path: "src/vm.rs", text: "/// least privilege. Set `allow_all: true` only for trusted embedding contexts." },
    map{ path: "src/net.rs", text: ".ok_or_else(|| host.err(\"tcp: no private key found in PEM file\".into()))?;" }
], 20);
if benign_policy_source.finding_count != 0 or benign_policy_source.suppressed_count != 2 {
    fail("deny-by-default policy docs and missing-key errors are suppression evidence, not embedded secrets");
}

let benign_safety_expect = A.scan_text("docs/Safety.md", "let name = safety.expect(user?.name, \"user.name is required\");", 20);
if len(benign_safety_expect) != 0 { fail("documented safety.expect helper is not a Rust .expect finding"); }

let benign_status_label = A.scan_text("stdlib/aap_status.sapp", "return \"Finish partial or placeholder implementation work\";", 20);
if len(benign_status_label) != 0 { fail("status labels about implementation work are not incomplete source findings"); }

let benign_status_policy_labels = A.scan_text("stdlib/browser_render.sapp",
    "if not pol.ok { return map{ ok: false, error: \"blocked by browser policy: \" + pol.reason, policy: pol }; }\n" +
    "source_only_blockers: try options.source_only_blockers catch true,\n" +
    "if category == \"roadmap\" { return \"Convert roadmap gaps into tested exit tasks\"; }\n" +
    "let blockers = 0;\n" +
    "blocker_count: blockers,\n" +
    "\" blockers=\" + str(summary.blocker_count)\n", 20);
if len(benign_status_policy_labels) != 0 { fail("status/policy labels and blocker counters are not roadmap findings"); }

let benign_pbos_gap_plumbing = A.scan_text("project_intake.sapp",
    "if sev == \"blocker\" { return \"blocked\"; }\n" +
    "rule: \"phase-2 bootability waits on all phase-0 blocker contracts\"\n" +
    "\"Add every low-level pblang blocker as a separate, testable contract before claiming bootability.\"\n" +
    "rule: \"roadmap/blocker findings do not make pbOS unimplemented core fail; they keep boot/kernel claims honest until exit tests exist\"\n" +
    "rule: \"pbOS roadmap/core changes must reduce or hold audit risk; new blockers keep boot/kernel claims gated\"\n", 20);
if len(benign_pbos_gap_plumbing) != 0 { fail("pbOS gap-contract plumbing is not active roadmap debt"); }

let benign_parallel_bounds = A.scan_text("stdlib/bend.sapp",
    "// spawn work so a small input cannot create unbounded threads.\n" +
    "let safety = \"parallel_depth and grain prevent unbounded thread creation\";", 20);
if len(benign_parallel_bounds) != 0 { fail("defensive unbounded-thread bounds are not performance findings"); }

let benign_partial_results = A.scan_text("stdlib/bend.sapp", "// combines two partial results.", 20);
if len(benign_partial_results) != 0 { fail("partial results wording is not incomplete work"); }

let benign_cache_eviction = A.scan_text("stdlib/cache.sapp", "// size(cache) -- entries may include expired entries not yet evicted", 20);
if len(benign_cache_eviction) != 0 { fail("cache eviction wording is not a not-yet implementation finding"); }

let markers = A.security_policy_markers();
if len(markers) < 7 { fail("security policy marker catalog is exposed"); }
if not str_contains(str_join([markers[0].marker, markers[1].marker, markers[2].marker], "\n"), "PBLANG_ALLOW") { fail("capability marker catalog includes PBLANG env gates"); }

let boundary_findings = A.scan_text("editors/ide/pbide.sapp",
    "PBLANG_ALLOW_ALL=1\n" +
    "let r = proc_spawn_wait(\"bash\", [\"-lc\", cmd]);\n" +
    "fs_write(\"/media/Ventoy/pbos.img\", image);\n" +
    "// external browser process fallback\n", 20);
if len(boundary_findings) < 4 { fail("security boundary markers are detected"); }
if not has_text(boundary_findings, "PBLANG_ALLOW_ALL=1") { fail("capability escalation marker detected"); }
if not has_text(boundary_findings, "proc_spawn_wait") { fail("host shell process marker detected"); }
if not has_text(boundary_findings, "Ventoy") { fail("external boot media write marker detected"); }
if not has_text(boundary_findings, "external browser process") { fail("host renderer fallback marker detected"); }
if count_severity(boundary_findings, "high") < 2 { fail("capability and Ventoy write markers are high severity"); }
if count_severity(boundary_findings, "medium") < 2 { fail("host process and renderer markers are medium severity"); }

let benign_html_placeholder = A.scan_text("website/index.html", "<textarea placeholder=\"Ask pbAI about pblang\"></textarea>\n<input placeholder = 'Local path'>", 20);
if len(benign_html_placeholder) != 0 { fail("HTML placeholder attributes are not incomplete implementation findings"); }

let benign_partialeq = A.scan_text("src/network_profile.rs", "#[derive(Clone, Copy, Debug, PartialEq, Eq)]", 20);
if len(benign_partialeq) != 0 { fail("Rust PartialEq derive is not a partial-implementation finding"); }

let bench_suppressed = A.scan_records([
    map{ path: "benches/bus_performance.rs", text: "let tmp = TempDir::new().unwrap();\nwriteln!(f, \"{}\", line).unwrap();" }
], 20, map{ suppress_test_fixtures: true });
if bench_suppressed.finding_count != 0 or bench_suppressed.suppressed_count < 2 { fail("benchmark unwraps are suppressible fixture/bench findings"); }

let demo_and_policy_suppressed = A.scan_records([
    map{ path: "demo/pbai_demo.sapp", text: "pblang run demo/pbai_demo.sapp --allow-all\nprivate keys must be filtered" }
], 20, map{ suppress_test_fixtures: true });
if demo_and_policy_suppressed.finding_count != 0 or demo_and_policy_suppressed.suppressed_count < 2 { fail("demo allow-all and policy fixture strings are suppressible fixture findings"); }

let boundary_fixture_suppressed = A.scan_records([
    map{ path: "tests/security_boundary_fixture.sapp", text: "PBLANG_ALLOW_ALL=1\nfs_write(\"/mnt/Ventoy/pbos.img\", image);\nlet r = proc_spawn_wait(\"bash\", [\"-lc\", cmd]);" }
], 20, map{ suppress_test_fixtures: true });
if boundary_fixture_suppressed.finding_count != 0 or boundary_fixture_suppressed.suppressed_count < 3 { fail("security boundary fixture markers are suppressible in explicit fixtures"); }

let todo_colon_suppressed = A.scan_records([
    map{ path: "tests/fixture_test.sapp", text: "// TODO: placeholder synthetic audit case\nlet s = \"panic!(\\\"bad\\\")\";" }
], 20, map{ suppress_test_fixtures: true });
if todo_colon_suppressed.finding_count != 0 or todo_colon_suppressed.suppressed_count < 2 { fail("TODO colon and escaped panic fixtures are suppressible"); }

let rust_test_region = A.scan_records([
    map{ path: "src/gateway/auth.rs", text: "#[cfg(test)]\nmod tests {\n    #[test]\n    fn accepts_header() {\n        let v = \"Bearer test\".parse().unwrap();\n    }\n}" }
], 20, map{ suppress_test_fixtures: true });
if rust_test_region.finding_count != 0 or rust_test_region.suppressed_count < 1 { fail("Rust cfg(test) regions are suppressible source test findings"); }

let doc_examples = A.scan_records([
    map{ path: "docs/usage.md", text: "pblang run demo.sapp --allow-all\nAuthorization: Bearer <token>" }
], 20);
if doc_examples.finding_count != 2 or (try doc_examples.counts_severity.low catch 0) != 2 { fail("documentation auth/allow-all examples are low-severity review items"); }

let resolved_docs = A.scan_records([
    map{ path: "docs/PrjAnalysis.md", text: "| Consensus handlers used `lock().unwrap()` | **Fixed** | uses poison recovery |" }
], 20);
if resolved_docs.finding_count != 0 or resolved_docs.suppressed_count != 1 { fail("resolved historical fixed findings are suppressed"); }

let defensive_docs = A.scan_records([
    map{ path: "docs/Crash_resistance.md", text: "`frames.pop().unwrap()` was replaced with `if let Some(frame)` so corrupted state does not panic the host." },
    map{ path: "docs/Fuzzing.md", text: "a `panic!` / `unwrap` failure / arithmetic overflow is a fuzzing finding." },
    map{ path: "docs/Embedding_lifecycle.md", text: "Don't .unwrap() vm.run() in production embeddings — every script error is recoverable.\nNo limits = an infinite loop in the script will pin the host thread." },
    map{ path: "CHANGELOG.md", text: "`DANGEROUS_COMMAND_PATTERNS` blocks command substitution.\n`sh -c`) and previously slipped past the phrase-based denylist. Added the test." }
], 20);
if defensive_docs.finding_count != 0 or defensive_docs.suppressed_count < 3 { fail("defensive docs are suppressible evidence, not active findings"); }

let report = A.scan_records([
    map{ path: "pbide.sapp", text: text },
    map{ path: "docs/PLAN.md", text: "roadmap gap: blocked by freestanding backend" }
], 50);
if report.format != "pblang.project_audit.report.v1" { fail("report format"); }
if report.finding_count < 6 { fail("scan_records aggregates findings"); }
if (try report.counts_kind.security catch 0) < 1 { fail("report counts security findings"); }
if (try report.counts_kind.roadmap catch 0) < 1 { fail("report counts roadmap findings"); }
if (try report.counts_role.source catch 0) < 5 or (try report.counts_role.docs catch 0) < 1 { fail("report counts source/docs roles"); }
if (try report.findings[0].role catch "") != "source" { fail("findings include path role metadata"); }
if report.findings[0].score < report.findings[len(report.findings) - 1].score { fail("findings are priority sorted"); }
if report.passed { fail("report with findings does not pass"); }

let clean = A.scan_records([map{ path: "ok.sapp", text: "fn ok() { return 1; }" }], 10);
if not clean.passed or clean.finding_count != 0 { fail("clean report passes"); }

let defensive_source = A.scan_records([
    map{ path: "stdlib/parser.sapp", text: "// stop to avoid an infinite loop\n// worker failures cannot deadlock collection" },
    map{ path: "stdlib/codegen.sapp", text: "fputs(\"out of memory\", stderr);" },
    map{ path: "stdlib/project_audit.sapp", text: "let patterns = [\"private key\", \"infinite loop\"];" },
    map{ path: "generated_catalog.sapp", text: "map{ description: \"Audit private key permissions.\" }" }
], 20);
if defensive_source.finding_count != 0 or defensive_source.suppressed_count < 2 {
    fail("defensive source and detector/catalog literals do not become vulnerabilities");
}
let actual_risk = A.scan_records([
    map{ path: "src/worker.rs", text: "worker.join().expect(\"worker must finish\");" },
    map{ path: "src/config.sapp", text: "PBLANG_ALLOW_ALL=1" },
    map{ path: "src/key.sapp", text: "let material = \"BEGIN PRIVATE KEY\";" }
], 20);
if actual_risk.finding_count < 3 or (try actual_risk.counts_severity.high catch 0) < 3 {
    fail("real reliability, capability escalation, and private-key markers remain high severity");
}

let suppressed = A.scan_records([
    map{ path: "tests/fixture_test.sapp", text: "// TODO placeholder project-audit:ignore\nlet token = \"ghp_1234567890abcdefghijklmnopqrstuvwx\";" }
], 20, map{ suppress_test_fixtures: true });
if suppressed.finding_count != 0 or suppressed.suppressed_count < 2 { fail("explicit suppressions are counted instead of blocking"); }
if len(A.explain_suppressions(suppressed)) < 2 { fail("suppression explanations are exposed"); }
let suppressed_gate = A.quality_gate(suppressed, nil);
if not suppressed_gate.passed or suppressed_gate.status != "passed" { fail("suppressed fixture report passes gate"); }

let strict_fixture = A.scan_records([
    map{ path: "tests/fixture_test.sapp", text: "let token = \"ghp_1234567890abcdefghijklmnopqrstuvwx\";" }
], 20);
if strict_fixture.finding_count < 1 or strict_fixture.suppressed_count != 0 { fail("strict default does not suppress fixture secrets"); }

let gate = A.quality_gate(report, map{ max_high: 0, max_medium: 10, max_total: 50 });
if gate.format != "pblang.project_audit.quality_gate.v1" { fail("quality gate format"); }
if gate.passed or gate.status != "blocked" { fail("quality gate blocks high-risk reports"); }
if len(gate.blockers) < 1 or gate.counts.high < 1 { fail("quality gate reports blockers and high counts"); }
if gate.counts.source < 1 or gate.counts.docs < 1 { fail("quality gate exposes role counts"); }

let docs_only = A.scan_records([map{ path: "docs/ROADMAP.md", text: "// TODO placeholder future work" }], 20);
let docs_source_gate = A.quality_gate(docs_only, map{ source_only_blockers: true, max_source_high: 0, max_source_medium: 0, max_source_total: 0 });
if not docs_source_gate.passed or docs_source_gate.status != "needs-review" { fail("source-only gate does not block docs-only backlog"); }
let docs_strict_gate = A.quality_gate(docs_only, map{ source_only_blockers: false, max_medium: 0 });
if docs_strict_gate.passed or docs_strict_gate.status != "blocked" { fail("strict gate can block docs backlog"); }

let source_low_only = A.scan_records([map{ path: "tools/demo.sapp", text: "// pblang run demo.sapp --allow-all" }], 20);
let source_low_gate = A.quality_gate(source_low_only, map{ source_only_blockers: true, max_source_high: 0, max_source_medium: 0, max_source_total: 0 });
if not source_low_gate.passed or source_low_gate.status != "needs-review" or source_low_gate.counts.source_blocking != 0 { fail("source-only gate reviews but does not block low-severity source notes"); }

let clean_gate = A.quality_gate(clean, nil);
if not clean_gate.passed or clean_gate.status != "passed" { fail("clean quality gate passes"); }

let tasks = A.backlog(report, 3);
if tasks.format != "pblang.project_audit.backlog.v1" or tasks.task_count != 3 { fail("backlog format and limit"); }
if tasks.tasks[0].severity != "high" or tasks.tasks[0].status != "open" { fail("backlog keeps priority-sorted open tasks"); }

let before_bad = A.scan_records([map{ path: "pbide.sapp", text: "// TODO placeholder renderer\npanic!(\"bad\");" }], 20);
let after_clean = A.scan_records([map{ path: "pbide.sapp", text: "fn ok() { return 1; }" }], 20);
let improved = A.compare_reports(before_bad, after_clean, nil);
if improved.format != "pblang.project_audit.compare.v1" or improved.status != "improved" or not improved.passed { fail("compare reports improved cleanup"); }
if improved.fixed_count < 2 or improved.new_count != 0 { fail("compare counts fixed findings"); }
let progress = A.progress_gate(before_bad, after_clean, nil);
if progress.format != "pblang.project_audit.progress_gate.v1" or not progress.passed { fail("progress gate passes cleanup"); }

let after_regress = A.scan_records([map{ path: "pbide.sapp", text: "// TODO placeholder renderer\npanic!(\"bad\");\nlet token = \"ghp_1234567890abcdefghijklmnopqrstuvwx\";" }], 20);
let regressed = A.compare_reports(before_bad, after_regress, nil);
if regressed.status != "regressed" or regressed.passed { fail("compare blocks new findings by default"); }
if regressed.new_count < 1 or len(regressed.blockers) < 1 { fail("compare exposes new blockers"); }
let lenient_cmp = A.compare_reports(before_bad, after_regress, map{ max_new_total: 10, max_new_high: 10, max_new_medium: 10, block_new_security: false });
if not lenient_cmp.passed or lenient_cmp.status != "needs-review" { fail("compare supports explicit lenient thresholds"); }

let pbide = A.audit_project("pbide", [map{ path: "pbide.sapp", text: text }], 20);
let recs = str_join(pbide.recommendations, "\n");
if not str_contains(recs, "Security first") { fail("project recommendations include security priority"); }
if not str_contains(recs, "renderer/input") { fail("PBIDE recommendations include renderer/input guidance"); }

let pbos = A.audit_project("pbos", [map{ path: "PBLANG_GAPS.md", text: "blocked by freestanding backend gap" }], 20);
if not str_contains(str_join(pbos.recommendations, "\n"), "bootability") { fail("pbOS recommendations keep bootability honest"); }

let ready = A.release_readiness("pbai", [
    map{ path: "docs/pbAI.md", text: text }
], map{ max_high: 0, max_medium: 10, max_total: 50, backlog_limit: 2 });
if ready.format != "pblang.project_audit.release_readiness.v1" { fail("release readiness format"); }
if ready.quality_gate.status != "blocked" or ready.backlog.task_count != 2 { fail("release readiness returns gate and bounded backlog"); }
if not str_contains(str_join(ready.recommendations, "\n"), "Do not train") { fail("release readiness preserves project recommendations"); }

let expired = A.scan_text_report("large.sapp", "let value = 1;\nlet other = 2;", 20,
    map{ deadline_ms: now_ms() - 1 });
if not expired.timed_out or not expired.truncated or expired.finding_count != 0 {
    fail("expired per-file deadline stops analysis explicitly without fabricated findings");
}

print "project_audit_pass";
