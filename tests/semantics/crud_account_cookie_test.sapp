// The fast path trusts only exact tokens issued into the private session map.
let A=import("stdlib:crud_accounts.sapp");
let hash="$2b$12$B7w/XX4A/.4otknYJe0OOu69/Zr7IM3viqeA4Jl/tgB9GIcM/mPn.";
fn req(path,cookie="",method="GET") {
    return map{method:method,path:path,body:"",headers:map{host:"127.0.0.1:8765",cookie:cookie}};
}
let app=A.create(map{editor:hash},8765,900,2);
let first=app.gate(req("/login"));
let cookie=str_split(first.headers["Set-Cookie"],";")[0];
let token=str_split(cookie,"=")[1];
for i 10 {
    let reused=app.gate(req("/login",cookie));
    assert(reused.status==200 and not map_has(reused.headers,"Set-Cookie"),"issued anonymous session reused");
}
assert(app.gate(req("/",cookie)).status==303,"known anonymous token does not grant access");
assert(app.gate(req("/create",cookie,"POST")).status==403,"anonymous mutation denied");
for value in [cookie+"; "+cookie,"other=value; "+cookie+"; "+cookie,
    cookie+"; pbcrud_session="+str_repeat("g",64),
    "pbcrud_session="+str_repeat("g",64)+"; "+cookie,
    cookie+"=extra","pbcrud_session="+token+"x","pbcrud_session="+str_slice(token,0,63),
    "pbcrud_session="+str_repeat("A",64),"pbcrud_session="+str_repeat("é",64),
    "pbcrud_session="+str_repeat("0",63)+"\n",str_repeat("x",4097)] {
    assert(app.gate(req("/",value)).status==400,"malformed cookies still rejected");
}
assert(app.gate(req("/","pbcrud_session="+str_repeat("0",64))).status==303,"unknown canonical token not trusted");
assert(app.gate(req("/","pbcrud_session="+str_repeat("0123456789abcdef",4))).status==303,"canonical unknown syntax retained");
let with_other=app.gate(req("/login","other=value; "+cookie));
assert(with_other.status==200 and not map_has(with_other.headers,"Set-Cookie"),"unrelated cookie allowed");
let duplicate=req("/",cookie);duplicate.headers["Cookie"]=cookie;
assert(app.gate(duplicate).status==400,"case duplicate header rejected");
app.close();app.close();
assert(app.gate(req("/login",cookie)).status==503,"closed map cannot authorize cached token");
print "crud_account_cookie_pass";
