let B=import("../../examples/declarative_browser/package_builder.sapp");
let count=0;fn check(ok,label) {assert(ok,label);count=count+1;}
check(B.imports("// import(\"ignored\")\nlet x=import(\"./app.sapp\");")==["./app.sapp"],"comments excluded");
check(B.imports("let text=\"import(\\\"ignored\\\")\"; /* import(\"ignored\") */")==[],"strings and block comments excluded");
check(B.imports("let x=import /* gap */ ( \"stdlib:text_flow.sapp\" );")==["stdlib:text_flow.sapp"],"tokenized spacing/comments");
for source in ["let x=import(path);","let x=import(\"a\"+suffix);","let x=import(\"a\",42);","let x=import \"a\";","/* unterminated"] {
    check(try {B.imports(source);false} catch true,"unsupported or malformed import rejected");
}
check(B.resolve("stdlib:text_flow.sapp","examples/declarative_browser/main.sapp")=="stdlib/text_flow.sapp","stdlib namespace");
check(B.resolve("stdlib/gui.sapp","stdlib/graphics.sapp")=="stdlib/gui.sapp","legacy namespace");
check(B.resolve("./text_fit.sapp","examples/declarative_browser/pagination.sapp")=="examples/declarative_browser/text_fit.sapp","sibling module");
for path in ["/tmp/out.sapp","../../../secret.sapp","stdlib:../private.sapp","stdlib:.hidden.sapp","stdlib:test.txt","bad\\path.sapp"] {
    check(try {B.resolve(path,"examples/declarative_browser/main.sapp");false} catch true,"outside profile rejected");
}
let entries=map{
    "stdlib":map{kind:"d",bytes:[]},"stdlib/a.sapp":map{kind:"f",bytes:str_to_bytes("print 1;")},
    "stdlib/empty":map{kind:"d",bytes:[]},"stdlib/nested":map{kind:"d",bytes:[]},
    "stdlib/nested/b.sapp":map{kind:"f",bytes:str_to_bytes("print \"Ελλάδα\";")},
    "examples/main.sapp":map{kind:"f",bytes:str_to_bytes("excluded")}};
check(B.tree_digest(entries)=="c27e60b6d21f847d4c828a5518cada88de406fd1d6720815e42063ea7044bce8","canonical v2 UTF-8/file/empty-directory digest");
print "reader_package_builder_pass checks="+str(count);
