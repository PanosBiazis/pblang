let P=import("stdlib:project_discovery_progress.sapp");
let H=import("stdlib:project_marker_hints.sapp");
let fields=["format","ok","error","observation_status","root_count","roots","state_counts","source_counts",
    "input_count","unique_name_count_sum","recognized_marker_count","family_counts","metadata_only",
    "contains_names","contains_paths","contains_digests","content_read","execution_performed",
    "coverage_verified","live_existence_verified","index_freshness_verified","absence_verified",
    "root_identity_verified","idea_admission_eligible","implementation_allowed","training_allowed",
    "external_effects_allowed","safe_to_log","production_ready"];
let states=["completed","truncated","timeout","unavailable","excluded","error"];
fn entry(names,state="completed",source="direct") {
    return map{names:names,observation:map{source:source,state:state,depth:0}};
}
fn schema(value) {
    assert(len(value)==29,"exact outer field count");
    for field in fields { assert(map_has(value,field),"required field"); }
    for field in ["contains_names","contains_paths","contains_digests","content_read","execution_performed",
        "coverage_verified","live_existence_verified","index_freshness_verified","absence_verified",
        "root_identity_verified","idea_admission_eligible","implementation_allowed","training_allowed",
        "external_effects_allowed","safe_to_log","production_ready"] { assert(value[field]==false,"no authority"); }
    assert(value.format=="pblang.project-discovery-progress.v1" and value.metadata_only,"format");
    assert(len(value.state_counts)==6 and len(value.source_counts)==2 and len(value.family_counts)==20,"exact count maps");
    let count=0; for state in states { count=count+value.state_counts[state]; }
    assert(count==value.root_count and value.source_counts.direct+value.source_counts.index==count
        and len(value.roots)==count,"root count invariants");
    let recognized=0;
    for family in map_keys(H.summarize([]).family_counts) { recognized=recognized+value.family_counts[family]; }
    assert(recognized==value.recognized_marker_count and recognized<=value.unique_name_count_sum
        and value.unique_name_count_sum<=value.input_count and value.input_count<=1024,"name count invariants");
    let i=0; for root in value.roots {
        assert(len(root)==2 and root.slot==i and len(root.scan)==26,"exact ordinal root/scan shape"); i=i+1;
    }
    assert(not str_contains(json_stringify(value),"private-marker"),"no supplied names echoed");
}
let neutral=P.describe(nil); schema(neutral);
fn rejected(entries) {
    let value=P.describe(entries); schema(value);
    assert(json_stringify(value)==json_stringify(neutral),"every failure completely neutral");
}
assert(not neutral.ok and neutral.error=="invalid-input" and neutral.observation_status=="none","failure status");
let empty=P.describe([]); schema(empty);
assert(empty.ok and empty.error=="" and empty.observation_status=="caller-claimed" and empty.root_count==0,"empty is not coverage proof");
let matrix=[];
for source in ["direct","index"] { for state in states {
    let names=[];
    if state=="completed" or state=="truncated" or state=="timeout" { names=["private-marker.lpi","private-marker.lpi","Cargo.toml"]; }
    array_push(matrix,entry(names,state,source));
} }
let snapshot=json_stringify(matrix); let result=P.describe(matrix); schema(result);
assert(result.root_count==12 and result.input_count==18 and result.unique_name_count_sum==12
    and result.recognized_marker_count==12 and result.family_counts.lazarus_project==6,"per-root, not global dedup");
for state in states { assert(result.state_counts[state]==2,"all states retained"); }
for i in range(0,12) {
    assert(json_stringify(result.roots[i].scan)==json_stringify(H.describe_scan(matrix[i].names,matrix[i].observation)),"unchanged canonical leaf");
}
result.roots[0].scan.report.family_counts.lazarus_project=999; result.state_counts.completed=99;
assert(P.describe(matrix).state_counts.completed==2 and P.describe(matrix).family_counts.lazarus_project==6
    and json_stringify(matrix)==snapshot,"detached outputs and preserved inputs");
for bad in [nil,true,1,"private-marker",map{},[nil],[map{}],[map{names:[]}],
    [map{names:[],observation:map{},path:"private-marker"}],
    [entry(["x"]),entry(["private-marker/x.lpi"])],
    [entry(["x"]),entry(["private-marker.lpi"],"excluded")],
    [entry(["x"]),entry([],"unknown")],
    [entry(["x"]),map{names:[],observation:map{source:"index",state:"completed",depth:1}}],
    [map{names:[],observation:map{source:"direct",state:"completed",depth:0,coverage_verified:true}}],
    [map{names:[],observation:H.describe_scan([],map{source:"direct",state:"completed",depth:0})}]] { rejected(bad); }
for name in [nil,true,1,[],map{},"",str_repeat("x",256),str_repeat("é",128),"x\u0000.lpi","x\u202e.lpi","C:x.lpi"] {
    rejected([entry(["pblang.toml"]),entry([name])]);
}
let roots=[]; for _i in range(0,32) { array_push(roots,entry([])); }
let local_boundary=P.describe([entry([str_repeat("x",251)+".lpi",str_repeat("é",125)+"x.lpi"])]);
schema(local_boundary);
assert(local_boundary.ok and local_boundary.recognized_marker_count==2,"255-byte ASCII and UTF8 names accepted");
let maximum=P.describe(roots); schema(maximum); assert(maximum.ok and maximum.root_count==32,"32 slots accepted");
array_push(roots,entry([])); rejected(roots);
let names=[]; for _i in range(0,256) { array_push(names,"x"); }
let global=[entry(names),entry(names),entry(names),entry(names)];
let full=P.describe(global); schema(full); assert(full.ok and full.input_count==1024 and full.unique_name_count_sum==4,"global input boundary before dedup");
array_push(global,entry(["x"])); rejected(global);
array_push(names,"x"); rejected([entry(names)]);
let bytes=[]; for _i in range(0,128) { array_push(bytes,str_repeat("é",64)); }
let byte_batch=[entry(bytes),entry(bytes)];
assert(P.describe(byte_batch).ok,"32768 aggregate UTF8 bytes accepted");
array_push(byte_batch,entry(["x"])); rejected(byte_batch);
print "project_discovery_progress_pass";
