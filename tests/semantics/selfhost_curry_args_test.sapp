let F = import("stdlib:compiler/selfhost_frontend.sapp");
fn expect(ok, label) { if not ok { throw "FAIL selfhost-curry: " + label; } }
let source = "let C = import(\"stdlib:functional.sapp\");"
    + "let collected = C.curry_args(fn(xs) { return xs; }, 5)(1)(2)(3)(4)(5);"
    + "let prefix = C.curry_args(fn(xs) { return xs; }, 3)(7);"
    + "let first = prefix(8)(9); let second = prefix(10)(11);"
    + "let legacy = C.curry(fn(a, b, c, d) { return a + b + c + d; }, 4)(1)(2)(3)(4);"
    + "let rejected = try C.curry(fn(a) { return a; }, 5) catch \"rejected\";"
    + "let zero = C.curry_args(fn(xs) { return len(xs); }, 0);"
    + "let result = [collected, first, second, legacy, rejected, zero];";
let result = F.frontend_run_bounded(source, map{ max_steps: 15000, max_frames: 24, max_modules: 8, max_source_bytes: 32768 });
expect(result.ok, "checked frontend/import execution");
expect(result.globals.result == [[1, 2, 3, 4, 5], [7, 8, 9], [7, 10, 11], 10, "rejected", 0], "exact imported-library results");
print "selfhost_curry_args_pass";
