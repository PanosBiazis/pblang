let P=import("stdlib:task_plan.sapp");let W=import("stdlib:task_workdays.sapp");let Date=import("stdlib:civil_date.sapp");let Text=import("stdlib:text_document.sapp");
fn rejects(f){assert((try f() catch nil)==nil,"unsupported scenario rejected");}
let p=P.create("Scenario","2026-09-25");p=P.edit(p,"task_1","Prepare",2,[]);p=P.append(p);p=P.edit(p,"task_2","Review",1,["task_1"]);let original=P.encode(p);let r=W.schedule(p);assert(r.tasks[0].due=="2026-09-28" and r.tasks[1].start=="2026-09-29" and r.due=="2026-09-29" and r.workdays==3 and r.calendar_days==5,"inclusive duration and next-workday dependency");assert(P.schedule(p).due=="2026-09-27","old calendar semantics retained");assert(W.schedule(p,nil,["2026-09-28"]).due=="2026-09-30","explicit closure");assert(W.schedule(p,[6]).start=="2026-09-27" and W.schedule(p,[6]).due=="2026-10-11","custom one-day week");
let parallel=P.append(p);parallel=P.edit(parallel,"task_3","Parallel",4,[]);parallel=P.append(parallel);parallel=P.edit(parallel,"task_4","Join",1,["task_2","task_3"]);let result=W.schedule(parallel);assert(result.tasks[3].start=="2026-10-01" and result.workdays==5,"wait for latest prerequisite; independent overlap");
let week=[0,1,2,3,4];let closed=["2026-09-28"];let detached=W.schedule(p,week,closed);detached.weekdays[0]=6;detached.closed[0]="2026-10-01";detached.tasks[0].label="changed";assert(week[0]==0 and closed[0]=="2026-09-28" and P.encode(p)==original,"detached report and source retained");
assert(W.schedule(P.create("Leap","2024-02-29")).due=="2024-02-29","one workday inclusive leap date");rejects(fn(){W.schedule(P.create("Overflow","9999-12-31"),[6]);});rejects(fn(){W.schedule(p,[]);});rejects(fn(){W.schedule(p,nil,["2026-09-28","2026-09-28"]);});
let doc=W.writer(p);Text.validate(doc);assert(len(doc.blocks)==4 and str_contains(doc.blocks[1].text,"interpreted as workdays"),"Writer assumptions");let many=P.create("Long chain","2026-01-01");many=P.edit(many,"task_1","One",365,[]);for i in range(2,33){many=P.append(many);many=P.edit(many,"task_"+str(i),"Task",365,["task_"+str(i-1)]);}let maximum=W.schedule(many,[6]);assert(maximum.total==32 and maximum.workdays==11680 and maximum.calendar_days==81754,"full 32-task horizon; no 366-day truncation");assert(len(W.writer(many).blocks)==64,"full Writer block budget");let exclusions=[];for i in range(0,100){array_push(exclusions,Date.add_days("2025-01-01",i));}rejects(fn(){W.writer(p,nil,exclusions);});print "task_workdays_pass";
