let Scheduler = import("stdlib:test_scheduler.sapp");

fn require(value, message) { if not value { throw "FAIL test_scheduler: " + message; } }

let large = Scheduler.plan(map{ profile: "large-product", cpu_count: 8,
    available_mb: 6982, reserve_mb: 1024, worker_mb: 1536 });
require(large.jobs == 3 and large.memory_limited, "large suite exceeded memory budget");

let bounded = Scheduler.plan(map{ profile: "standard", cpu_count: 32,
    max_jobs: 5, available_mb: 32768, reserve_mb: 1024, worker_mb: 512 });
require(bounded.jobs == 5 and not bounded.memory_limited, "explicit job cap was ignored");

let constrained = Scheduler.plan(map{ profile: "large-product", cpu_count: 16,
    available_mb: 1024, reserve_mb: 1024, worker_mb: 1536 });
require(constrained.jobs == 1, "low-memory host did not fall back to one worker");

let physical = Scheduler.plan(map{ profile: "physical-device", cpu_count: 16,
    available_mb: 32768 });
require(physical.jobs == 1 and physical.device_lane_serialized
    and physical.target_cpu_percent == 40,
    "physical-device access was not serialized or resource bounded");

let normal = Scheduler.device_policy(map{ temperature_c: 31, battery_percent: 80,
    pss_kib: 36000, powered: false });
require(normal.allowed and normal.pressure == "normal"
    and normal.health_probe_interval_ms == 2000 and normal.host_poll_batch == 32,
    "normal physical-device pacing is not efficient");

let warm = Scheduler.device_policy(map{ temperature_c: 41, battery_percent: 60,
    pss_kib: 36000, powered: true });
require(warm.allowed and warm.pressure == "elevated"
    and warm.loop_pause_ms == 20 and warm.health_probe_interval_ms == 5000,
    "warm devices were not adaptively throttled");

let hot = Scheduler.device_policy(map{ temperature_c: 45, battery_percent: 60,
    pss_kib: 36000, powered: true });
let low = Scheduler.device_policy(map{ temperature_c: 30, battery_percent: 10,
    pss_kib: 36000, powered: false });
let memory = Scheduler.device_policy(map{ temperature_c: 30, battery_percent: 60,
    pss_kib: 131073, powered: true });
require(not hot.allowed and hot.reason == "temperature-limit"
    and not low.allowed and low.reason == "battery-limit"
    and not memory.allowed and memory.reason == "memory-limit",
    "unsafe physical-device samples did not fail closed");

let bad_profile = try { Scheduler.plan(map{ profile: "unknown" }); false } catch true;
let bad_worker = try { Scheduler.plan(map{ worker_mb: 0 }); false } catch true;
require(bad_profile and bad_worker, "invalid scheduler options were accepted");

print "test_scheduler_pass";
