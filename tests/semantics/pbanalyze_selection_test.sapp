let OS=import("stdlib:os.sapp");
if platform()!="linux" {print "pbanalyze_selection_skip_linux_required";os_exit(0);}
let compiler=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let source=path_join(OS.temp_dir(),"pblang_selection_"+str_slice(sha256(str(now_ms())+str(random_bytes(8))),0,16)+".sapp");
let failure="unexpected exception";
fn expect(ok,label) {if not ok {failure=label;throw label;}}
fn invoke(selection,entry_only) {
    let args=["-k","1s","10s",compiler,"tools/pbanalyze.sapp","--allow-all","--",source,"--analysis="+selection];
    if entry_only {push(args,"--entry-only");}
    return proc_spawn_wait("/usr/bin/timeout",args);
}
fn exercise() {
    // High-severity fixture: the CLI intentionally does not block medium eval
    // findings in protect mode, unlike the library's default info threshold.
    fs_write(source,"danger_accept_invalid_certs();\n");
    let canonical=["security","quality","performance","completeness","roadmap"];
    for entry_only in [true,false] {
        for selection in ["all","ALL,performance","AlL"] {
            let run=invoke(selection,entry_only);
            expect(run.exit_code==1,"security finding rejects all spelling variants");
            let report=json_parse(str_trim(run.stdout));
            expect(report.ok and not report.passed and report.security!=nil,"security result retained");
            expect(json_stringify(report.analyses)==json_stringify(canonical),"same canonical CLI selection");
        }
    }
    let control=invoke("performance",true);
    expect(control.exit_code==0 and json_parse(str_trim(control.stdout)).security==nil,"explicit non-security selection unchanged");
    return true;
}
let succeeded=try exercise() catch false;
if fs_exists(source) {fs_remove(source);}
if not succeeded {throw "FAIL pbanalyze-selection: "+failure;}
print "pbanalyze_selection_pass";
