// Test: rwlock builtins (read-write lock)
// rwlock_new, rwlock_read, rwlock_write, rwlock_unlock

let rw = rwlock_new();

// Multiple concurrent reads are allowed (acquire 2 read locks, then release)
rwlock_read(rw);
rwlock_read(rw);
rwlock_unlock(rw);  // release reader 1
rwlock_unlock(rw);  // release reader 2

// Write lock when no readers
rwlock_write(rw);
rwlock_unlock(rw);

// Read → write pattern
rwlock_read(rw);
rwlock_unlock(rw);
rwlock_write(rw);
rwlock_unlock(rw);

// Multiple write locks (sequential)
rwlock_write(rw);
rwlock_unlock(rw);
rwlock_write(rw);
rwlock_unlock(rw);

print "rwlock_builtins_pass";
