// Isolated fixture only: substitute the process boundary, retain real scope code.
let subject="tests/fixtures/.process_scope_fault_subject.sapp";
assert(not fs_exists(subject),"fresh fixture required");
let source=fs_read("stdlib/process_scope.sapp");
let patched=str_replace_all(source,"import(\"stdlib:process.sapp\")",
    "import(\"tests/fixtures/process_scope_backend.sapp\")");
assert(patched!=source,"process boundary substituted");fs_write(subject,patched);
let Scoped=import("tests/fixtures/.process_scope_fault_subject.sapp");
let Backend=import("tests/fixtures/process_scope_backend.sapp");
for mode in ["pending","throws"] {
    Backend.reset(mode);
    let result=Scoped.with_process([],[],map{},fn(child){return map{ok:false,error:"primary"};});
    assert(not result.ok and result.error=="primary" and not result.cleanup_ok
        and result.recovery_required and Backend.counts().live,"uncertain cleanup retains owner and primary error");
    assert(Backend.recover(result.recovery_handle).handle_closed,"returned ownership permits deliberate recovery");
}
Backend.reset("recovery_start");let called=false;
let result=Scoped.with_process([],[],map{},fn(child){called=true;return map{ok:true,value:nil};});
assert(not result.ok and not called and result.cleanup_ok and not result.recovery_required
    and Backend.counts().closes==1,"partially started child still cleaned without calling body");
Backend.reset("pending");
result=Scoped.with_process([],[],map{},fn(child){return map{ok:true,value:17};},
    map{on_exit:"wait",wait_ms:0});
assert(not result.ok and result.value==17 and result.body_result.ok
    and result.recovery_required and Backend.counts().closes==0,
    "unfinished wait preserves successful work and explicit recovery ownership");
assert(Backend.recover(result.recovery_handle).handle_closed,"wait recovery closes owned child");
Backend.reset("launch_failed");
result=Scoped.with_process([],[],map{},fn(child){called=true;return map{ok:true,value:nil};});
assert(not called and result.cleanup_ok and not result.recovery_required
    and Backend.counts().closes==0,"failed launch owns no child");
Backend.reset("normal");
result=Scoped.with_process([],[],map{},fn(child){
    child.finish=fn(){throw "replaced method";};
    child.cancel=fn(){throw "replaced method";};
    return map{ok:true,value:nil};
});
assert(result.ok and Backend.counts().closes==1,"public controller mutation cannot disable cleanup");
Backend.reset("normal");
result=Scoped.with_process([],[],map{},fn(child){
    let terminal=child.finish(0);terminal.handle_closed=false;
    return map{ok:true,value:nil};
});
assert(result.ok and Backend.counts().finishes==1 and Backend.counts().closes==0,
    "returned result mutation does not cause double close");
Backend.reset("normal");
result=Scoped.with_process([],[],map{},fn(child){return map{ok:true};},map{on_exit:"wait"});
assert(not result.ok and result.cleanup_ok and Backend.counts().closes==1,
    "malformed success uses cancellation, not wait");
fs_remove(subject);print "process_scope_fault_pass";
