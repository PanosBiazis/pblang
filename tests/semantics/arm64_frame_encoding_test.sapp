let A=import("stdlib:codegen_arm64_ast.sapp");
fn word(code,at){return code[at]+256*code[at+1]+65536*code[at+2]+16777216*code[at+3];}
fn locals(count){let source="";for i in range(0,count){source=source+"let v"+str(i)+"=0;";}return source;}
let small=A.compile_ast(locals(510)+"return 42;");
assert(word(small,16)==0xD13FC3FF,"4080-byte frame retains single unshifted sub");
let exact=A.compile_ast(locals(512)+"return 42;");
assert(word(exact,16)==0xD14007FF,"4096-byte frame uses shifted imm12=1");
let split=A.compile_ast(locals(513)+"return 42;");
assert(word(split,16)==0xD14007FF and word(split,20)==0xD10043FF,"4112-byte frame high and low immediate parts");
print "arm64_frame_encoding_pass";
