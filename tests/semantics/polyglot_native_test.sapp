// tests/semantics/polyglot_native_test.sapp — PL1-beta: native polyglot bridge
//
// Exercises the in-VM polyglot_detect / polyglot_exec / polyglot_exec_compiled
// / polyglot_exec_with_input builtins through stdlib/polyglot.sapp wrappers.
// All assertions are skip-on-missing-toolchain so the test passes on any host
// without coupling to specific compilers/interpreters being installed.

import "stdlib:polyglot.sapp";

// ── 1. Detection ─────────────────────────────────────────────────────────────
let langs = polyglot.detect();
let detect_ok = langs != nil and langs != map{};
if detect_ok {
    print "polyglot_detect: ok";
} else {
    print "polyglot_detect: FAIL";
}

// ── 2. Interpreted: exec ─────────────────────────────────────────────────────
// Use bash since it's ubiquitous on Unix CI; skip if not present.
let bash_present = false;
if langs != nil and langs != map{} {
    let bash_info = try langs.bash catch nil;
    if bash_info != nil {
        bash_present = bash_info.available;
    }
}
if bash_present {
    let r = polyglot.exec("bash", "echo hello-from-bash");
    if r.ok and str_contains(r.stdout, "hello-from-bash") {
        print "polyglot_exec_bash: ok";
    } else {
        print "polyglot_exec_bash: FAIL stdout=" + r.stdout + " stderr=" + r.stderr;
    }
} else {
    print "polyglot_exec_bash: skipped (bash not found)";
}

// ── 3. stdin filter: exec_with_input ─────────────────────────────────────────
if bash_present {
    let r2 = polyglot.exec_with_input("bash", "cat", "piped-input-bytes\n");
    if r2.ok and str_contains(r2.stdout, "piped-input-bytes") {
        print "polyglot_exec_stdin: ok";
    } else {
        print "polyglot_exec_stdin: FAIL stdout=" + r2.stdout;
    }
} else {
    print "polyglot_exec_stdin: skipped (bash not found)";
}

// ── 4. Compiled: exec_compiled ───────────────────────────────────────────────
// Try C since cc/gcc/clang is widespread on dev hosts; gracefully skip otherwise.
let c_present = false;
if langs != nil and langs != map{} {
    let c_info = try langs.c catch nil;
    if c_info != nil {
        c_present = c_info.available;
    }
}
if c_present {
    let c_src = "#include <stdio.h>\nint main(void){ printf(\"compiled-hi\\n\"); return 0; }\n";
    let r3 = polyglot.exec_compiled("c", c_src);
    if r3.ok and str_contains(r3.stdout, "compiled-hi") {
        print "polyglot_exec_compiled_c: ok";
    } else {
        print "polyglot_exec_compiled_c: FAIL stdout=" + r3.stdout + " stderr=" + r3.stderr;
    }
} else {
    print "polyglot_exec_compiled_c: skipped (no C compiler)";
}

// ── 5. Auto-routing: polyglot.run ────────────────────────────────────────────
if bash_present {
    let r4 = polyglot.run("bash", "echo auto-route");
    if r4.ok and str_contains(r4.stdout, "auto-route") {
        print "polyglot_run_auto: ok";
    } else {
        print "polyglot_run_auto: FAIL";
    }
} else {
    print "polyglot_run_auto: skipped";
}

// ── 6. Language matrix ──────────────────────────────────────────────────────
let matrix = polyglot.supported_languages();
let matrix_ok = matrix != nil and len(matrix.interpreted) > 10 and len(matrix.compiled) > 10;
if matrix_ok {
    print "polyglot_matrix: ok";
} else {
    print "polyglot_matrix: FAIL";
}

// ── 7. Cache info is well-formed even when cache is empty ───────────────────
let info = polyglot.cache_info();
let info_ok = info != nil and info.count >= 0 and info.size_bytes >= 0;
if info_ok {
    print "polyglot_cache_info: ok";
} else {
    print "polyglot_cache_info: FAIL";
}

print "polyglot_native_pass";
