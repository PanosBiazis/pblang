let POLY = import("stdlib:polyglot.sapp");
let BUILD = import("stdlib:polyglot_build.sapp");

fn require(value, message) { if not value { throw "polyglot native: " + message; } }
fn denied(result) { return not result.ok and not result.executed and not result.raw_fallback; }

let langs = POLY.detect();
require(langs != nil and langs != map{}, "detection must return a catalog");
let tcl = try langs.tcl catch nil;
require(tcl != nil and tcl.kind == "interpreter" and tcl.probe == "discovery-only"
    and not tcl.execution_authorized,
    "detection must remain non-executing inventory");

langs.tcl.command = "poisoned";
let fresh = POLY.detect();
require(fresh.tcl.command != "poisoned", "detection cache must be detached");

require(denied(POLY.exec("bash", "echo must-not-run")),
    "execution must require explicit source trust");

require(denied(POLY.exec_compiled("c", "int main(void){return 0;}",
        map{ trusted_source: true })),
    "legacy compile-and-run must fail closed");

let process = BUILD.process_status();
let bash = try fresh.bash catch nil;
if process.available and bash != nil and bash.available {
    let direct = POLY.exec("bash", "printf bounded-ok",
        map{ trusted_source: true, timeout_secs: 5 });
    require(direct.ok and direct.bounded and direct.executable_descriptor_held
        and str_contains(direct.stdout, "bounded-ok"),
        "trusted execution must use the bounded fixed backend");

    let filtered = POLY.exec_with_input("bash", "cat", "private-input\n",
        map{ trusted_source: true, timeout_secs: 5 });
    require(filtered.ok and filtered.bounded and filtered.stdin_bounded
        and filtered.input_bytes == 14 and str_contains(filtered.stdout, "private-input"),
        "stdin must travel through the bounded descriptor path");
}

let info = POLY.cache_info();
require(info.ok and not info.enabled and info.count == 0 and not info.raw_fallback,
    "legacy native cache must be reported disabled");

print "polyglot_native_pass";
