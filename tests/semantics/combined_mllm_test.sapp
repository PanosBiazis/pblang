// tests/semantics/combined_mllm_test.sapp — one call wires BOTH pbai brains (canonical native +
// project brain as a voter) and (optionally) live ollama into the single shared MLLM engine.
// HEAVY: co-loads the full project brain (+ a live ollama call) — run on a release/native build
//   (target-native/release/pblang or target-gpu/release/pblang); the debug VM may time out.

let m = import("stdlib/combined_mllm.sapp");

fn fail(s) { throw "FAIL " + s; }
fn eq(a, b, s) { if a != b { fail(s + " got=" + str(a) + " want=" + str(b)); } }
fn has(list, v) { let i = 0; while i < len(list) { if list[i] == v { return true; } i = i + 1; } return false; }

// ── wire() combines both brains; offline (no ollama) for a deterministic check ───────────
let info = m.wire(map{ use_ollama: false, adaptive: false, parallel: false });
if not map_has(info, "models") { fail("wire returns model list"); }
if not has(info.models, "pbai-project") { fail("project brain registered as a voter"); }

let p = "explain what this function does";
let d = m.decide(p, 0.5);
if not map_has(d, "intent") or not map_has(d, "confidence") or not map_has(d, "escalate") { fail("decide shape"); }

// classify returns a valid intent from the shared engine's intent set
let ci = m.classify(p);
if not has(m.engine().intents(), ci) { fail("classify returns a known intent"); }

// batch works through the combined MLLM
let b = m.batch([p, "find the bug here"], 0.5);
eq(len(b), 2, "batch length");
if not map_has(b[0], "intent") { fail("batch item shape"); }

// ── parallel + adaptive combined ────────────────────────────────────────────────────────
m.wire(map{ use_ollama: false, adaptive: true, parallel: true });
let d2 = m.decide(p, 0.5);
if not map_has(d2, "intent") { fail("parallel+adaptive decide works"); }
m.record_outcome(d2.intent);            // feedback loop is wired
if m.reliability("pbai-project") < 0 { fail("reliability tracked"); }

// ── LIVE: with ollama when the daemon is up (no crash either way) ────────────────────────
let info3 = m.wire(map{ use_ollama: true, parallel: true });
if info3.ollama == true { if not has(m.engine().voters(), "pbai-project") { fail("project still a voter with ollama"); } }
let d3 = m.decide("find the null pointer bug in this function", 0.5);
if not map_has(d3, "intent") { fail("live combined decide works"); }

print "combined_mllm_pass";
