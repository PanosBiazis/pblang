let Policy = import("stdlib:machine_code_policy.sapp");

fn require(value, message) { if not value { throw "machine_code_policy test failed: " + message; } }
fn rejected(action) { let failed = false; try { action(); } catch { failed = true; } return failed; }

let decoded = Policy.inspect_hex("48 C7 c0 2A000000 C3\n");
require(decoded.ok and decoded.size == 8 and decoded.bytes[3] == 42,
    "strict decoder accepts bounded mixed-case hexadecimal text");
require(not Policy.inspect_hex("ABC").ok, "odd digit count is rejected");
require(not Policy.inspect_hex("48GG").ok, "non-hex input is rejected");
require(rejected(fn() { Policy.decode_hex(7); }), "non-text decode fails closed");

let unsafe = Policy.review_recipe(map{
    id:"memory-return", executes_raw_bytes:true, memory_mode:"rwx",
    shell_or_script:true, temporary_executable:false, hex:"48C7C02A000000C3",
    declared_arch:"x86_64", container_arch:"x86_64"
});
require(not unsafe.accepted and not unsafe.safe_to_execute and unsafe.high == 2 and unsafe.medium == 1,
    "raw RWX shell recipe is classified without execution");

let malformed = Policy.review_recipe(map{
    id:"broken-pe", executes_raw_bytes:true, memory_mode:"rx",
    shell_or_script:true, temporary_executable:true, hex:"50450000L01",
    declared_arch:"x86_64", container_arch:"i386"
});
require(malformed.high == 3 and malformed.medium == 2 and malformed.decoded_size == 0,
    "malformed hexadecimal and architecture mismatch remain explicit");

let dos = Policy.review_recipe(map{
    id:"dos-int20", executes_raw_bytes:true, memory_mode:"rx", shell_or_script:true,
    temporary_executable:true, hex:"B02AB44CCD20", declared_length:6,
    declared_arch:"x86", container_arch:"x86", claims_exit_code:true, dos_interrupt:0x20
});
require(dos.high == 2 and dos.medium == 2,
    "INT 20h recipe cannot claim a DOS return-code contract");

for id in ["return-42", "return-100", "add-5-5"] {
    let verified = Policy.verify_blueprint(id);
    require(verified.ok and verified.evaluated == verified.blueprint.expected,
        "portable oracle verifies " + id);
    require(len(verified.artifacts) == 3 and verified.artifacts[0].artifact_format == "com"
        and verified.artifacts[1].artifact_format == "elf"
        and verified.artifacts[2].artifact_format == "pe",
        "DOS, Linux and Windows artifacts are generated for " + id);
    require(not verified.raw_execution_used and not verified.shell_used
        and not verified.writable_executable_memory_used and not verified.foreign_source_used,
        "replacement avoids historical execution mechanics");
}

require(rejected(fn() { Policy.blueprint("arbitrary-bytes"); }), "unknown blueprint is rejected");
require(rejected(fn() { Policy.build_artifact("return-42", "android", "21", "arm64"); }),
    "unsupported native artifact target fails closed");

print "machine_code_policy_pass";
