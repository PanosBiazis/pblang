let F=import("stdlib:functional.sapp");
fn check(ok,label) {if not ok {throw "FAIL stable-sort-bounds: "+label;}}
fn rejects(arr,cmp) {
    let result=try map{ok:true,value:F.stable_sort_by(arr,cmp)} catch map{ok:false};
    check(not result.ok,"invalid input or comparator rejected");
}
let calls=[0];
let cmp=fn(a,b){calls[0]=calls[0]+1;return a-b;};
for invalid in [nil,true,1,"private-marker",map{},fn(x){return x;}] {rejects(invalid,cmp);}
rejects(F.repeat(0,4097),cmp);
check(calls[0]==0,"bad input rejected before callback");
let data=[]; let i=4096;
while i>0 {push(data,i);i=i-1;}
let sorted=F.stable_sort_by(data,cmp);
check(len(sorted)==4096 and sorted[0]==1 and sorted[4095]==4096,"exact boundary accepted");
check(data[0]==4096 and data[4095]==1 and calls[0]<=49152,"input unchanged and comparison bound");
i=0;
while i<4096 {check(sorted[i]==i+1 and data[i]==4096-i,"every boundary slot and original slot");i=i+1;}
for order in [nil,true,"private-marker",[],map{secret:"private-marker"},fn(x){return x;},
    bigint(1),rational("1/2"),decimal("0.5"),parse_number("NaN"),parse_number("inf"),parse_number("-inf")] {
    calls[0]=0;
    rejects([2,1],fn(a,b){calls[0]=calls[0]+1;return order;});
    check(calls[0]==1,"bad comparator result checked immediately");
}
rejects([2,1],nil);
rejects([parse_number("1e308"),parse_number("-1e308")],fn(a,b){return a-b;});
// Empty/singleton returns a copy without invoking or validating a callback.
check(F.stable_sort_by([],nil)==[] and F.stable_sort_by([1],nil)==[1],"no comparison needed");
// Captured source-array mutation cannot change the private slot snapshot.
let original=[3,2,1]; calls[0]=0;
let changed=F.stable_sort_by(original,fn(a,b){calls[0]=calls[0]+1;if calls[0]==1 {push(original,0);}return a-b;});
check(changed==[1,2,3] and original==[3,2,1,0],"callback effects are not rolled back");
print "functional_stable_sort_bounds_pass";
