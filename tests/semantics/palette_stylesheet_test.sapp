let CSS=import("stdlib:palette_stylesheet.sapp");let P=import("stdlib:palette_document.sapp");let C=import("stdlib:colors.sapp");
let p=P.create("Example","#fff");let before=P.encode(p);
assert(CSS.encode(p)==":root {\n  --pb-background: #ffffff;\n  --pb-on-background: #000000;\n  --pb-color-1: #000000;\n  --pb-on-color-1: #ffffff;\n}\n","exact one-color CSS");
let t=CSS.tokens(p);t[2].value="#123456";assert(P.encode(p)==before and CSS.tokens(p)[2].value=="#000000","detached tokens and source");
let named=P.configure(p,"</style><script>alert(1)</script>","#fff");named=P.set_swatch(named,0,"x; } @import url(x); /*","#000");assert(CSS.encode(named)==CSS.encode(p),"labels/title never enter stylesheet");
let full=P.create("Maximum","#123456");for i in range(1,8) {full=P.append(full,"Color "+str(i),C.rgb_to_hex(map{r:i*29,g:i*19,b:i*7}));}
let tokens=CSS.tokens(full);assert(len(tokens)==18 and len(str_to_bytes(CSS.encode(full)))<=CSS.MAX_CSS_BYTES,"maximum bounded output");let names=map{};
for item in tokens {assert(not map_has(names,item.name),"unique token names");names[item.name]=true;assert(C.rgb_to_hex(C.hex_checked(item.value))==item.value,"canonical literal colors");}
for i in range(0,8) {assert(tokens[2+i*2].value==full.swatches[i].hex,"original order");let bg=C.hex_checked(tokens[2+i*2].value);let text=C.hex_checked(tokens[3+i*2].value);let black=C.contrast_checked(C.hex_checked("#000"),bg).ratio;let white=C.contrast_checked(C.hex_checked("#fff"),bg).ratio;assert(C.contrast_checked(text,bg).ratio==num_max(black,white),"independent black white choice");}
let moved=P.move_swatch(full,7,0);assert(CSS.tokens(moved)[2].value==full.swatches[7].hex and CSS.tokens(full)[2].value=="#000000","tokens follow order without mutation");
for gray in range(0,256) {let hex=C.rgb_to_hex(map{r:gray,g:gray,b:gray});let q=P.set_swatch(p,0,"Gray",hex);let rows=CSS.tokens(q);assert(rows[2].value==hex and rows[3].value==C.best_text_checked(C.hex_checked(hex)).hex,"all grayscale choices retain library parity");}
for bad in [nil,map{},map{format:P.FORMAT,title:"Bad",background:"#fff",swatches:[map{label:"a",hex:"#000000"}]}] {assert((try CSS.encode(bad) catch nil)==nil,"malformed/noncanonical rejection");}
let injected=P.copy(p);injected.swatches[0].hex="#000000; color:red";assert((try CSS.encode(injected) catch nil)==nil,"non-hex syntax refused");
print "palette_stylesheet_pass";
