// The retained bootstrap's catch expression cannot access the caught error.
// Use real child diagnostics rather than accidentally inspecting builtin error.
if platform() != "linux" { print "c_interp_diagnostics_live_skip_linux_required"; os_exit(0); }
let compiler = env_get("PBLANG_BIN") ?? path_join(cwd(), "target/release/pblang");
fn child(backend, mode) {
    return proc_spawn_wait("/usr/bin/timeout", ["-k", "1s", "8s", compiler, "run",
        "tests/fixtures/backend_admission_probe.sapp", "--allow-all", "--", backend, mode]);
}
for backend in ["interp", "ieval", "c99", "c99int"] {
    let valid = child(backend, "valid");
    assert(valid.exit_code == 0 and valid.stdout == "backend_admission_probe_pass\n", "real child positive control");
    for mode in ["comment", "string", "syntax", "numeric"] {
        let rejected = child(backend, mode);
        let message = if mode == "syntax" { "syntax error" } else { "invalid or unterminated token" };
        let expected = "checked_source: " + message;
        if backend == "c99" { expected = "hosted C99: translation rejected source"; }
        elif backend == "c99int" { expected = "hosted C99 integer: translation rejected source"; }
        assert(rejected.exit_code == 1 and str_contains(rejected.stderr, "]: " + expected + "\n"),
            "actual fixed backend diagnostic");
        assert(not str_contains(rejected.stderr + rejected.stdout, "private_canary"), "no rejected source in child output");
    }
}
let effect = child("ieval", "effects");
assert(effect.exit_code == 1 and effect.stdout == "", "interpreter rejects before first print effect");
assert(str_contains(effect.stderr, "checked_source: invalid or unterminated token"), "effect case admission error");
assert(not str_contains(effect.stderr, "private_canary"), "effect source remains data");
print "c_interp_diagnostics_live_pass";
