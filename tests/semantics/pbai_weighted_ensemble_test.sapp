// tests/semantics/pbai_weighted_ensemble_test.sapp — CONFIDENCE-WEIGHTED ensemble voting.
// Plain majority voting lets many weak models outvote one strong, confident model. A real
// multi-LLM router weights each vote by (per-voter reliability weight) * (self-reported
// confidence). This test pins that behavior: one strong/confident voter must beat two weak ones.

let pbai = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let p = "explain what this function does";

// ── string voters still count as full confidence (backward compatible) ────────────────
pbai.clear_voters();
pbai.register_voter("a", fn(x) { return "improve"; });
pbai.register_voter("b", fn(x) { return "improve"; });
eq(pbai.ensemble(p), "improve", "two full-confidence string voters override native");

// ── confidence-weighted: one STRONG voter beats TWO WEAK voters ───────────────────────
// Two weak voters say "bugs" with tiny confidence; one strong, high-weight voter says
// "improve". Under plain majority, "bugs" (2 votes) would win. Weighted, "improve" wins.
pbai.clear_voters();
pbai.register_voter("weak1", fn(x) { return map{ intent: "bugs", confidence: 0.15 }; });
pbai.register_voter("weak2", fn(x) { return map{ intent: "bugs", confidence: 0.15 }; });
pbai.register_voter_weighted("strong", fn(x) { return map{ intent: "improve", confidence: 0.95 }; }, 3);
eq(pbai.ensemble(p), "improve", "one strong confident voter beats two weak ones");

// ensemble_detail still exposes intent + tally, and tally is now weighted (floats)
let det = pbai.ensemble_detail(p);
if not map_has(det, "tally") or not map_has(det, "intent") { fail("ensemble_detail shape"); }
approx(det.tally["bugs"], 0.30, "bugs weighted score = 0.15 + 0.15");
if det.tally["improve"] < 2.8 { fail("improve weighted score should be ~2.85"); }
if not map_has(det, "native_confidence") { fail("detail exposes native_confidence"); }

// ── a voter can abstain (return nil) and is simply skipped ────────────────────────────
pbai.clear_voters();
pbai.register_voter("abstain", fn(x) { return nil; });
eq(pbai.ensemble(p), pbai.classify_scores(p).intent, "abstaining voter leaves native decision");

pbai.clear_voters();
print "pbai_weighted_ensemble_pass";
