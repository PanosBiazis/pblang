let tmpl = import("stdlib:template.sapp");

// Test 1: Basic variable substitution
let r1 = tmpl.render("Hello, {{ name }}!", map{ name: "World" });
assert(r1 == "Hello, World!", "basic substitution failed: " + r1);

// Test 2: Dotted access
let r2 = tmpl.render("{{ user.name }}", map{ user: map{ name: "Alice" } });
assert(r2 == "Alice", "dotted access failed: " + r2);

// Test 3: Upper filter
let r3 = tmpl.render("{{ name | upper }}", map{ name: "hello" });
assert(r3 == "HELLO", "upper filter failed: " + r3);

// Test 4: Lower filter
let r4 = tmpl.render("{{ name | lower }}", map{ name: "WORLD" });
assert(r4 == "world", "lower filter failed: " + r4);

// Test 5: Comment stripping
let r5 = tmpl.render("before {# this is a comment #} after", map{});
assert(r5 == "before  after", "comment failed: " + r5);

// Test 6: HTML escape
let r6 = tmpl.escape_html("<script>alert('xss')</script>");
assert(str_contains(r6, "&lt;"), "escape_html should escape <");
assert(str_contains(r6, "&gt;"), "escape_html should escape >");
assert(str_contains(r6, "&#x27;"), "escape_html should escape '");

// Test 7: Missing variable renders as empty
let r7 = tmpl.render("{{ missing_var }}", map{});
assert(r7 == "", "missing var should render as empty: " + r7);

// Test 8: Multiple substitutions
let r8 = tmpl.render("{{ a }} + {{ b }} = {{ c }}", map{ a: "1", b: "2", c: "3" });
assert(r8 == "1 + 2 = 3", "multiple subs failed: " + r8);

// Test 9: Chained filters and default values
let r9 = tmpl.render("{{ name | trim | upper }} {{ missing | default:\"Guest\" }}", map{ name: " pb " });
assert(r9 == "PB Guest", "chained/default filters failed: " + r9);

// Test 10: Join filter
let r10 = tmpl.render("{{ items | join:\"/\" }}", map{ items: ["a", "b", "c"] });
assert(r10 == "a/b/c", "join filter failed: " + r10);

// Test 11: If comparisons and not
let r11 = tmpl.render("{% if user.role == \"admin\" %}A{% else %}B{% endif %}", map{ user: map{ role: "admin" } });
assert(r11 == "A", "if equality failed: " + r11);
let r12 = tmpl.render("{% if not enabled %}off{% else %}on{% endif %}", map{ enabled: false });
assert(r12 == "off", "if not failed: " + r12);

// Test 12: For loops recurse through render and do not leak item vars into ctx
let ctx = map{ items: [map{ name: "a" }, map{ name: "b" }] };
let r13 = tmpl.render("{% for item in items %}{{ loop_number }}:{{ item.name | upper }};{% endfor %}{{ item | default:\"none\" }}", ctx);
assert(r13 == "1:A;2:B;none", "for recursion/default failed: " + r13);
assert((try ctx.item catch nil) == nil, "for loop should not leak item var into original context");

// Test 13: Map iteration exposes key and key_value
let r14 = tmpl.render("{% for key in attrs %}{{ key }}={{ key_value }};{% endfor %}", map{ attrs: map{ x: 1 } });
assert(str_contains(r14, "x=1;"), "map iteration failed: " + r14);

// Test 14: Missing variable inspection and strict rendering
let miss = tmpl.missing_vars("{{ user.name }} {{ ok }} {{ ok }}", map{ ok: true });
assert(len(miss) == 1 and miss[0] == "user.name", "missing_vars failed: " + str(miss));
let strict = try tmpl.render_strict("{{ nope }}", map{}) catch "strict_failed";
assert(strict == "strict_failed", "render_strict should error on missing vars");

print "template_stdlib_pass";
