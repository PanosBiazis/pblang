let tmpl = import("stdlib:template.sapp");

// Test 1: Basic variable substitution
let r1 = tmpl.render("Hello, {{ name }}!", map{ name: "World" });
assert(r1 == "Hello, World!", "basic substitution failed: " + r1);

// Test 2: Dotted access
let r2 = tmpl.render("{{ user.name }}", map{ user: map{ name: "Alice" } });
assert(r2 == "Alice", "dotted access failed: " + r2);

// Test 3: Upper filter
let r3 = tmpl.render("{{ name | upper }}", map{ name: "hello" });
assert(r3 == "HELLO", "upper filter failed: " + r3);

// Test 4: Lower filter
let r4 = tmpl.render("{{ name | lower }}", map{ name: "WORLD" });
assert(r4 == "world", "lower filter failed: " + r4);

// Test 5: Comment stripping
let r5 = tmpl.render("before {# this is a comment #} after", map{});
assert(r5 == "before  after", "comment failed: " + r5);

// Test 6: HTML escape
let r6 = tmpl.escape_html("<script>alert('xss')</script>");
assert(str_contains(r6, "&lt;"), "escape_html should escape <");
assert(str_contains(r6, "&gt;"), "escape_html should escape >");
assert(str_contains(r6, "&#x27;"), "escape_html should escape '");

// Test 7: Missing variable renders as empty
let r7 = tmpl.render("{{ missing_var }}", map{});
assert(r7 == "", "missing var should render as empty: " + r7);

// Test 8: Multiple substitutions
let r8 = tmpl.render("{{ a }} + {{ b }} = {{ c }}", map{ a: "1", b: "2", c: "3" });
assert(r8 == "1 + 2 = 3", "multiple subs failed: " + r8);

print "template_stdlib_pass";
