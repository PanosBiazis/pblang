let Artifacts = import("stdlib:x64_message_artifact.sapp");

fn require(value, message) { if not value { throw "x64 message artifact test failed: " + message; } }
fn rejected(callable) { return (try { callable(); false } catch true); }

fn contains_bytes(haystack, needle) {
    if len(needle) == 0 { return true; }
    let i = 0;
    while i + len(needle) <= len(haystack) {
        let equal = true; let j = 0;
        while j < len(needle) and equal {
            if haystack[i + j] != needle[j] { equal = false; }
            j = j + 1;
        }
        if equal { return true; }
        i = i + 1;
    }
    return false;
}

let pair = Artifacts.build_pair("Hello from PBLang\n");
require(pair.ok and pair.linux.inspection.ok and pair.linux.inspection.segment_rx
    and not pair.linux.inspection.writable_code, "Linux artifact must be ELF64 with RX code");
require(pair.windows.inspection.ok and pair.windows.inspection.format == "pe32+"
    and pair.windows.wx_split and pair.windows.nx_compatible,
    "Windows artifact must be bounded PE32+ with W/X separation");
require(pair.windows.shadow_space_bytes == 32 and pair.windows.stack_allocation_bytes == 40
    and pair.windows.stack_aligned, "Windows call frame must satisfy x64 shadow/alignment contract");
require(contains_bytes(pair.linux.bytes, str_to_bytes("Hello from PBLang\n"))
    and contains_bytes(pair.windows.bytes, str_to_bytes("Hello from PBLang\n")),
    "both artifacts must contain the requested bounded message");
require(contains_bytes(pair.windows.bytes, str_to_bytes("GetStdHandle"))
    and contains_bytes(pair.windows.bytes, str_to_bytes("WriteFile"))
    and contains_bytes(pair.windows.bytes, str_to_bytes("ExitProcess")),
    "Windows artifact must declare only the required output and exit imports");

let linux_review = Artifacts.review_abi(map{
    platform: "linux-x86_64-syscall", calls: ["write", "exit"],
    argument_1_register: "rdi", shadow_space_bytes: 0, stack_aligned: true,
    direct_syscalls: true, external_calls: false
});
require(linux_review.ok and linux_review.compatible, "canonical Linux syscall ABI must pass");
let mixed_review = Artifacts.review_abi(map{
    platform: "windows-x86_64", calls: ["printf", "ExitProcess"],
    argument_1_register: "rdi", shadow_space_bytes: 0, stack_aligned: false,
    direct_syscalls: false, external_calls: true
});
require(mixed_review.ok and not mixed_review.compatible and mixed_review.finding_count == 3,
    "SysV register plus missing Windows frame requirements must be diagnosed");
let windows_review = Artifacts.review_abi(map{
    platform: "windows-x86_64", calls: ["GetStdHandle", "WriteFile", "ExitProcess"],
    argument_1_register: "rcx", shadow_space_bytes: 32, stack_aligned: true,
    direct_syscalls: false, external_calls: true
});
require(windows_review.ok and windows_review.compatible, "canonical Windows x64 ABI must pass");

require(not Artifacts.linux_artifact("").ok, "empty messages must fail closed");
require(not Artifacts.windows_artifact("bad" + strfromcharcode(0) + "message").ok,
    "NUL-bearing messages must fail closed");
require(not Artifacts.linux_artifact(str_repeat("x", Artifacts.MAX_MESSAGE_BYTES + 1)).ok,
    "oversized messages must fail closed");
require(not Artifacts.review_abi(map{}).ok, "unknown ABI profiles must fail closed");
require(not Artifacts.review_abi(map{
    platform: "windows-x86_64", calls: [], argument_1_register: "rcx",
    shadow_space_bytes: 32, stack_aligned: true, direct_syscalls: false, external_calls: true
}).ok, "empty call sets must fail closed");
require(Artifacts.build_pair("deterministic\n").linux.bytes
    == Artifacts.build_pair("deterministic\n").linux.bytes,
    "artifact generation must be deterministic");

print "x64_message_artifact_pass";
