let S=import("stdlib:speech_catalog.sapp");
fn expect(v,m){if not v{throw "FAIL speech catalog: "+m;}}
let models=S.list_models();expect(models.ok and models.executed and models.known_count==5
    and not models.model_contents_exposed and not models.absolute_paths_exposed,"model inventory");
let voices=S.list_voices();expect(voices.ok and voices.executed and voices.count<=S.MAX_ENTRIES
    and not voices.file_contents_exposed and not voices.absolute_paths_exposed,"voice inventory");
for i len(voices.voices){expect(regex_match(voices.voices[i].id,"^[A-Za-z0-9_.!+/-]{1,132}$"),"sanitized voice id");}
print "speech_catalog_pass";
