// tests/semantics/map_extended_test.sapp
let map = import("stdlib:map.sapp");

let m = map{ a: 1, b: 2, c: 3 };

// size and is_empty
if map.size(m) != 3 { throw "FAIL size: expected 3"; }
if map.is_empty(m) { throw "FAIL is_empty false"; }
if map.is_empty(map{}) == false { throw "FAIL is_empty true"; }

// copy/defaults/merge_all
let copied = map.copy(m);
copied.a = 99;
if m.a != 1 or copied.a != 99 { throw "FAIL copy"; }
let with_defaults = map.defaults(map{ a: 10 }, map{ a: 1, b: 2 });
if with_defaults.a != 10 or with_defaults.b != 2 { throw "FAIL defaults"; }
let merged_all = map.merge_all([map{ a: 1 }, map{ b: 2 }, map{ a: 3 }]);
if merged_all.a != 3 or merged_all.b != 2 { throw "FAIL merge_all"; }

// pick
let picked = map.pick(m, ["a", "c"]);
if map.has(picked, "a") == false or map.has(picked, "c") == false { throw "FAIL pick has"; }
if map.has(picked, "b") { throw "FAIL pick excludes"; }

// omit
let omitted = map.omit(m, ["b"]);
if map.has(omitted, "b") { throw "FAIL omit b"; }
if map.has(omitted, "a") == false { throw "FAIL omit keeps a"; }
if map.has_all(m, ["a", "b"]) == false { throw "FAIL has_all true"; }
if map.has_all(m, ["a", "z"]) { throw "FAIL has_all false"; }
if map.has_any(m, ["z", "b"]) == false { throw "FAIL has_any true"; }
if map.has_any(m, ["x", "z"]) { throw "FAIL has_any false"; }
if map.contains_value(m, 2) == false { throw "FAIL contains_value true"; }
if map.contains_value(m, 9) { throw "FAIL contains_value false"; }

// invert
let inv = map.invert(map{ x: "foo", y: "bar" });
if inv["foo"] != "x" { throw "FAIL invert: expected x got " + str(inv["foo"]); }

// zip_map
let zipped = map.zip_map(["k1", "k2", "k3"], [10, 20, 30]);
if zipped["k1"] != 10 or zipped["k3"] != 30 { throw "FAIL zip_map"; }

let from_arr_entries = map.from_entries([["x", 1], ["y", 2]]);
if from_arr_entries.x != 1 or from_arr_entries.y != 2 { throw "FAIL from_entries array pairs"; }

let only_big = map.filter_values(m, fn(v) { return v > 1; });
if map.has(only_big, "a") or only_big.b != 2 or only_big.c != 3 { throw "FAIL filter_values"; }
let remapped = map.map_entries(map{ a: 1, b: 2 }, fn(k, v) { return [k + "_x", v * 10]; });
if remapped.a_x != 10 or remapped.b_x != 20 { throw "FAIL map_entries"; }

let sorted_keys = map.keys_sorted(map{ b: 2, a: 1 });
if sorted_keys[0] != "a" or sorted_keys[1] != "b" { throw "FAIL keys_sorted"; }
let sorted_vals = map.values_by_sorted_keys(map{ b: 2, a: 1 });
if sorted_vals[0] != 1 or sorted_vals[1] != 2 { throw "FAIL values_by_sorted_keys"; }

let updated = map.update(map{ count: 2 }, "count", fn(v) { return v + 1; }, 0);
if updated.count != 3 { throw "FAIL update existing"; }
let updated_missing = map.update(map{}, "count", fn(v) { return v + 1; }, 0);
if updated_missing.count != 1 { throw "FAIL update missing"; }
let renamed = map.rename_key(map{ old: 7, keep: 1 }, "old", "new");
if map.has(renamed, "old") or renamed.new != 7 or renamed.keep != 1 { throw "FAIL rename_key"; }

// group_by
let nums = [1, 2, 3, 4, 5, 6];
fn parity(n) { if num_mod(n, 2) == 0 { return "even"; } return "odd"; }
let groups = map.group_by(nums, parity);
if len(groups["even"]) != 3 { throw "FAIL group_by even"; }
if len(groups["odd"]) != 3 { throw "FAIL group_by odd"; }

// count_by
let words = ["cat", "dog", "cat", "bird", "dog", "cat"];
fn first_char(s) { return str_slice(s, 0, 1); }
let counts = map.count_by(words, fn(w) { return w; });
if counts["cat"] != 3 { throw "FAIL count_by cat: expected 3 got " + str(counts["cat"]); }
if counts["dog"] != 2 { throw "FAIL count_by dog"; }

print "map_extended_pass";
