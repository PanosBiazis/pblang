// tests/semantics/map_extended_test.sapp
let map = import("stdlib:map.sapp");

let m = map{ a: 1, b: 2, c: 3 };

// size and is_empty
if map.size(m) != 3 { throw "FAIL size: expected 3"; }
if map.is_empty(m) { throw "FAIL is_empty false"; }
if map.is_empty(map{}) == false { throw "FAIL is_empty true"; }

// pick
let picked = map.pick(m, ["a", "c"]);
if map.has(picked, "a") == false or map.has(picked, "c") == false { throw "FAIL pick has"; }
if map.has(picked, "b") { throw "FAIL pick excludes"; }

// omit
let omitted = map.omit(m, ["b"]);
if map.has(omitted, "b") { throw "FAIL omit b"; }
if map.has(omitted, "a") == false { throw "FAIL omit keeps a"; }

// invert
let inv = map.invert(map{ x: "foo", y: "bar" });
if inv["foo"] != "x" { throw "FAIL invert: expected x got " + str(inv["foo"]); }

// zip_map
let zipped = map.zip_map(["k1", "k2", "k3"], [10, 20, 30]);
if zipped["k1"] != 10 or zipped["k3"] != 30 { throw "FAIL zip_map"; }

// group_by
let nums = [1, 2, 3, 4, 5, 6];
fn parity(n) { if num_mod(n, 2) == 0 { return "even"; } return "odd"; }
let groups = map.group_by(nums, parity);
if len(groups["even"]) != 3 { throw "FAIL group_by even"; }
if len(groups["odd"]) != 3 { throw "FAIL group_by odd"; }

// count_by
let words = ["cat", "dog", "cat", "bird", "dog", "cat"];
fn first_char(s) { return str_slice(s, 0, 1); }
let counts = map.count_by(words, fn(w) { return w; });
if counts["cat"] != 3 { throw "FAIL count_by cat: expected 3 got " + str(counts["cat"]); }
if counts["dog"] != 2 { throw "FAIL count_by dog"; }

print "map_extended_pass";
