// tests/semantics/crypto_quantum_enrich_test.sapp — enrichment for stdlib/crypto_quantum.sapp
// Adds BB84 QKD key sifting + QBER (quantum bit error rate / eavesdrop detection).

let q = import("stdlib/crypto_quantum.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn aeq(a, b, m) {
    if len(a) != len(b) { fail(m + " len : " + str(a)); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " @" + str(i)); } i = i + 1; }
}

// ── base PQC name selection still works ──────────────────────────────────────────
eq(q.kem_name(1), "Kyber-512", "kem_name level 1");

// ── ENRICH: bb84_sift keeps bits where the bases agree ───────────────────────────
aeq(q.bb84_sift([1, 0, 1, 1], [0, 1, 0, 1], [0, 0, 0, 1]), [1, 1, 1], "bb84 sift matching bases");

// ── ENRICH: qber (quantum bit error rate) ────────────────────────────────────────
eq(q.qber([1, 0, 1], [1, 1, 1]), 1 / 3, "qber one of three differs");
eq(q.qber([1, 0, 1], [1, 0, 1]), 0, "qber identical = 0 (no eavesdropper)");
eq(q.qber([], []), 0, "qber empty = 0");

print "crypto_quantum_enrich_pass";
