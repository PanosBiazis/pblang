let CP = import("stdlib:compute.sapp");
let input = [1,2,3,4,5];
let observed = CP.run_chunked(input, fn(x) {
    if x == 1 { input[2] = 99; }
    return x;
}, 2);
assert(input[2] == 99 and observed == [1,2,3,4,5], "workers retain input-slot snapshot semantics");
let shared = map{ value: 1 };
let aliases = CP.run_chunked([shared,shared,shared], fn(x) { x.value = x.value + 1; return x; }, 1);
assert(shared.value == 4 and aliases[0].value == 4 and aliases[2].value == 4,
    "cleanup preserves reachable shared results");
shared.value = 9;
assert(aliases[1].value == 9, "returned aliases remain live after cleanup");
let closures = CP.run_chunked([10,20,30], fn(x) { return fn() { return x; }; }, 1);
assert(closures[0]() == 10 and closures[2]() == 30, "returned closures keep captured inputs");
let calls = 0;
let empty = CP.run_chunked([], fn(x) { calls = calls + 1; return x; }, 2);
assert(empty == [] and calls == 0, "empty batch does not call worker");
assert(CP.run_chunked([1,2], fn(x) { return x + 1; }, 0) == [2,3], "legacy minimum chunk size");
let failed = try CP.run_chunked([1,2,3], fn(x) {
    calls = calls + 1;
    if x == 2 { throw "chunk-worker-original-error"; }
    return x;
}, 1) catch "caught";
assert(failed == "caught" and calls == 2,
    "failure propagates without retry or later worker execution");
assert(CP.chunk([1,2,3],2) == [[1,2],[3]], "public chunk API still returns all batches");
print "compute_chunk_lifetime_pass";
