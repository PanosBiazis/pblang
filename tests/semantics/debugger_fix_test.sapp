// tests/semantics/debugger_fix_test.sapp — missing-key-throw fixes in stdlib/debugger.sapp

let D = import("stdlib/debugger.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

D.clear_all_breakpoints();

// ── BUG FIX: breakpoint() on a fresh file used to THROW (read _breakpoints[file]
//    before the nil-check) ───────────────────────────────────────────────────────
if not D.breakpoint("fresh_file.sapp", 10).ok { fail("breakpoint on fresh file succeeds"); }
eq(len(D.breakpoints("fresh_file.sapp")), 1, "one breakpoint recorded");

// breakpoints() / clear_breakpoint() on an unknown file must not throw
eq(len(D.breakpoints("never_seen.sapp")), 0, "unknown file -> []");
D.clear_breakpoint("never_seen.sapp", 5);   // no-op, must not throw

// inspect() of an untracked variable returns nil (was a throw)
eq(D.inspect("no_such_var"), nil, "inspect unknown -> nil");

// watched() with a watch on an unset variable doesn't throw
D.watch("undefined_var");
let w = D.watched();
if len(w) < 1 { fail("watched returns entries"); }

// The old gc_stats wrapper called itself recursively. Both debugger GC APIs now
// return bounded, explicit host-runtime status without invoking collection.
let gs = D.gc_stats();
eq(gs.format, "pblang.debugger.gc-stats.v2", "debugger GC status is versioned");
if gs.runtime.owner_isolation or gs.runtime.collection_allowed {
    fail("debugger must disclose unisolated retained host GC");
}
let forced = D.gc_collect_force();
if forced.performed or forced.allowed { fail("debugger collection fails closed"); }

print "debugger_fix_pass";
