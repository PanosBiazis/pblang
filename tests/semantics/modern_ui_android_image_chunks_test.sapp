let Images=import("stdlib:modern_ui_android_image.sapp");
let UI=import("stdlib:modern_ui.sapp");let Android=import("stdlib:modern_ui_android.sapp");
let rows=[];let random=12345;
for y in range(0,64) {let row=[];for x in range(0,64) {let pixel=[];
    for c in range(0,3) {random=num_mod(random*1664525+1013904223,4294967296);array_push(pixel,num_floor(random/16777216));}
    array_push(pixel,255);array_push(row,pixel);
}array_push(rows,row);}
let image=Images.prepare(rows);assert(len(image.chunks)>1,"large image crosses string chunks");
for chunk in image.chunks {assert(len(chunk)<=Images.CHUNK_SIZE,"bounded constants");}
let b=UI.compile(UI.screen([UI.image(rows,map{fit:"contain",h:120})]),map{target:"android"});
let bytes=Android.activity_class(b,map{android_images:true,package:"org.pblang.imagechunks"});
let Pipeline=import("stdlib:image_pipeline.sapp");
assert(Pipeline.decode_png(base64_decode_bytes(str_join(image.chunks,""))).image==rows,"chunked payload preserves all pixels");
assert(len(bytes)>0,"chunked payload generates a class");
print "modern_ui_android_image_chunks_pass";
