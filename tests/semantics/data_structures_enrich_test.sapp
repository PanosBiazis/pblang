// tests/semantics/data_structures_enrich_test.sapp — fixes + enrichment for
// stdlib/data_structures.sapp
//
// BUG FIXES:
//  - stack_pop / queue_dequeue / pq_extract_min built a trimmed array into a
//    local and discarded it, so the structure never actually shrank.
//  - trie/lru used `{}` (an empty BLOCK -> nil at runtime, not a map) and indexed
//    missing keys (which throws). Rebuilt with map{} + map_has.
//  - pq_insert used a float parent index (i-1)/2.
// ENRICH: set + counter (multiset), pq_peek/pq_size, queue_clear, lru_has.

let D = import("stdlib/data_structures.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── stack actually shrinks ───────────────────────────────────────────────────────
let s = D.stack_new();
D.stack_push(s, 1); D.stack_push(s, 2); D.stack_push(s, 3);
eq(D.stack_size(s), 3, "stack size 3");
eq(D.stack_pop(s), 3, "stack pop returns top");
eq(D.stack_size(s), 2, "stack shrank after pop");
eq(D.stack_peek(s), 2, "stack peek");

// ── queue actually shrinks (FIFO) ────────────────────────────────────────────────
let q = D.queue_new();
D.queue_enqueue(q, "a"); D.queue_enqueue(q, "b"); D.queue_enqueue(q, "c");
eq(D.queue_dequeue(q), "a", "queue FIFO front");
eq(D.queue_size(q), 2, "queue shrank");
eq(D.queue_front(q), "b", "queue new front");

// ── priority queue extracts min and shrinks ──────────────────────────────────────
let pq = D.pq_new();
D.pq_insert(pq, "x", 3); D.pq_insert(pq, "y", 1); D.pq_insert(pq, "z", 2);
eq(D.pq_extract_min(pq).val, "y", "pq min is y (prio 1)");
eq(D.pq_extract_min(pq).val, "z", "pq next is z (prio 2)");
eq(D.pq_size(pq), 1, "pq shrank to 1");

// ── linked list ──────────────────────────────────────────────────────────────────
let ll = D.ll_new();
D.ll_append(ll, 1); D.ll_append(ll, 2); D.ll_prepend(ll, 0);
let arr = D.ll_to_array(ll);
eq(len(arr), 3, "ll length"); eq(arr[0], 0, "ll head"); eq(arr[2], 2, "ll tail");
eq(D.ll_find(ll, 2), true, "ll find"); eq(D.ll_find(ll, 9), false, "ll not found");

// ── trie ─────────────────────────────────────────────────────────────────────────
let t = D.trie_new();
D.trie_insert(t, "cat"); D.trie_insert(t, "car");
eq(D.trie_search(t, "cat"), true, "trie search hit");
eq(D.trie_search(t, "ca"), false, "trie search non-terminal");
eq(D.trie_starts_with(t, "ca"), true, "trie prefix");
eq(D.trie_starts_with(t, "dog"), false, "trie no prefix");

// ── LRU cache evicts least-recently-used ─────────────────────────────────────────
let c = D.lru_new(2);
D.lru_put(c, "a", 1); D.lru_put(c, "b", 2);
D.lru_get(c, "a");                 // touch a -> b is now LRU
D.lru_put(c, "c", 3);              // evicts b
eq(D.lru_get(c, "b"), nil, "lru evicted b");
eq(D.lru_get(c, "a"), 1, "lru kept a"); eq(D.lru_get(c, "c"), 3, "lru kept c");
eq(D.lru_has(c, "b"), false, "lru_has reflects eviction");
eq(D.lru_size(c), 2, "lru size remains bounded");
eq(D.lru_remove(c, "a"), true, "lru remove existing");
eq(D.lru_remove(c, "a"), false, "lru remove missing");
eq(D.lru_size(c), 1, "lru size after remove");
D.lru_clear(c); eq(D.lru_size(c), 0, "lru clear");
let zero = D.lru_new(0); D.lru_put(zero, "x", 1);
eq(D.lru_has(zero, "x"), false, "zero-capacity lru stores nothing");

// ── union-find ───────────────────────────────────────────────────────────────────
let ds = D.ds_new(5);
D.ds_union(ds, 0, 1); D.ds_union(ds, 1, 2);
eq(D.ds_find(ds, 0), D.ds_find(ds, 2), "union-find connected");
if D.ds_find(ds, 0) == D.ds_find(ds, 3) { fail("0 and 3 must be disjoint"); }

// ── ENRICH: set ──────────────────────────────────────────────────────────────────
let st = D.set_new();
D.set_add(st, "x"); D.set_add(st, "y"); D.set_add(st, "x");
eq(D.set_has(st, "x"), true, "set has x"); eq(D.set_size(st), 2, "set dedupes");
D.set_remove(st, "x");
eq(D.set_has(st, "x"), false, "set remove");

// ── ENRICH: counter (multiset) ───────────────────────────────────────────────────
let cnt = D.counter_new();
D.counter_add(cnt, "apple"); D.counter_add(cnt, "apple"); D.counter_add(cnt, "pear");
eq(D.counter_get(cnt, "apple"), 2, "counter apple"); eq(D.counter_get(cnt, "pear"), 1, "counter pear");
eq(D.counter_get(cnt, "none"), 0, "counter missing -> 0");

print "data_structures_enrich_pass";
