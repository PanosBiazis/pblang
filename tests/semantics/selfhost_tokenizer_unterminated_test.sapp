// tests/semantics/selfhost_tokenizer_unterminated_test.sapp
//
// The self-hosted tokenizer must FLAG an unterminated string or block comment
// instead of silently accepting it as a complete token (the same silent
// data-loss class the Rust frontend was hardened against). Consumers (parser /
// frontend) can then surface a real error rather than mis-tokenizing.

let tok = import("stdlib/compiler/tokenizer.sapp");

fn fail(m) { throw "FAIL " + m; }
fn unterm(t) { return (try t.unterminated catch nil) == true; }
fn find_kind(ts, k) {
    for t in ts { if t.kind == k { return t; } }
    return nil;
}

// unterminated string → flagged
let a = tok.tokenize("let x = \"oops");
let s = find_kind(a, "string");
if s == nil { fail("expected a string token for unterminated input"); }
if not unterm(s) { fail("unterminated string must be flagged"); }

// properly closed string → NOT flagged
let b = tok.tokenize("let x = \"ok\";");
let s2 = find_kind(b, "string");
if s2 == nil { fail("expected a string token for closed input"); }
if unterm(s2) { fail("closed string must not be flagged"); }

// unterminated block comment → flagged
let c = tok.tokenize("a /* oops");
let cm = find_kind(c, "comment");
if cm == nil { fail("expected a comment token for unterminated block comment"); }
if not unterm(cm) { fail("unterminated block comment must be flagged"); }

// properly closed block comment → NOT flagged
let d = tok.tokenize("a /* ok */ b");
let cm2 = find_kind(d, "comment");
if cm2 == nil { fail("expected a comment token for closed block comment"); }
if unterm(cm2) { fail("closed block comment must not be flagged"); }

// a // line comment is never "unterminated" (ends at newline or EOF)
let e = tok.tokenize("x // trailing");
let lc = find_kind(e, "comment");
if lc == nil { fail("expected a line comment token"); }
if unterm(lc) { fail("line comment must not be flagged unterminated"); }

// The frontend must SURFACE the flag as an error (not silently parse).
let fe = import("stdlib/compiler/selfhost_frontend.sapp");
fn has_unterm_error(res) {
    for e in res.errors { if str_contains(e, "unterminated") { return true; } }
    return false;
}

let r1 = fe.frontend_parse_full("let x = \"oops");
if not has_unterm_error(r1) { fail("frontend must report an unterminated string error"); }
if r1.ok { fail("frontend ok must be false for an unterminated string"); }

let r2 = fe.frontend_parse_full("let x = 1; print x;");
if has_unterm_error(r2) { fail("clean source must not report unterminated errors"); }

print "selfhost_tokenizer_unterminated_pass";
