// Test: mock.sapp — test doubles (spies, mocks, stubs) for the pblang QA stack.
//
// pblang has no variadic fns and arity mismatch throws, so callables are
// fixed-arity (fn0..fn4, sharing one recording state). Argument records are
// arrays, compared with pblang's deep `==`.

let M = import("stdlib:mock.sapp");

fn eq(a, b, msg) {
    if a != b { return error("FAIL " + msg + ": got " + str(a) + ", want " + str(b)); }
}

// ── a fresh mock records calls and returns nil by default ────────────────────
let m = M.mock();
eq(m.called(), false, "not called yet");
eq(m.call_count(), 0, "zero calls");
let r0 = m.fn1(7);
eq(r0, nil, "default return is nil");
eq(m.called(), true, "called after invoke");
eq(m.call_count(), 1, "one call");
eq(m.called_once(), true, "called exactly once");

// records the arguments (as an array)
eq(m.last_call()[0], 7, "last call arg recorded");
eq(m.called_with([7]), true, "called_with matches");
eq(m.called_with([8]), false, "called_with rejects non-match");

// ── programmed default return ────────────────────────────────────────────────
let m2 = M.mock();
m2.returns(42);
eq(m2.fn0(), 42, "returns() default");
eq(m2.fn1("x"), 42, "returns() applies to any arity");
eq(m2.call_count(), 2, "both calls recorded");

// ── returns_once queue (FIFO), then falls back to default ────────────────────
let m3 = M.mock();
m3.returns(0);
m3.returns_once(10);
m3.returns_once(20);
eq(m3.fn0(), 10, "first queued value");
eq(m3.fn0(), 20, "second queued value");
eq(m3.fn0(), 0, "falls back to default after queue drains");

// ── throws() ─────────────────────────────────────────────────────────────────
let m4 = M.mock();
m4.throws("boom");
let tr = try map{ ok: true, value: m4.fn1(1) } catch map{ ok: false, value: nil };
eq(tr.ok, false, "throws() makes the mock throw");
eq(m4.call_count(), 1, "throwing call still recorded");

// ── calls_fake(impl) — impl receives the args array ──────────────────────────
let m5 = M.mock();
m5.calls_fake(fn(args) { return args[0] + args[1]; });
eq(m5.fn2(3, 4), 7, "calls_fake computes from args");
eq(m5.last_call()[1], 4, "args recorded under calls_fake");

// ── multiple arities share one recording state ───────────────────────────────
let m6 = M.mock();
m6.fn0();
m6.fn2("a", "b");
m6.fn3(1, 2, 3);
eq(m6.call_count(), 3, "all arities recorded together");
eq(m6.nth_call(1)[0], "a", "nth_call indexes recorded calls");
eq(len(m6.calls()), 3, "calls() returns all records");
eq(len(m6.nth_call(2)), 3, "3-arg call recorded with 3 args");

// callable(n) returns the n-arity callable
let c2 = m6.callable(2);
c2("p", "q");
eq(m6.call_count(), 4, "callable(n) shares state");
eq(m6.last_call()[1], "q", "callable(n) records args");

// ── reset() clears history but keeps behavior; reset_all() clears both ───────
let m7 = M.mock();
m7.returns(99);
m7.fn0();
m7.fn0();
eq(m7.call_count(), 2, "two calls before reset");
m7.reset();
eq(m7.call_count(), 0, "reset clears history");
eq(m7.fn0(), 99, "reset keeps programmed return");
m7.reset_all();
eq(m7.fn0(), nil, "reset_all clears behavior back to nil");

// ── spy(realfn, arity): passes through AND records ───────────────────────────
fn add(a, b) { return a + b; }
let s = M.spy(add, 2);
let sc = s.callable(2);
eq(sc(2, 5), 7, "spy passes through to the real fn");
eq(s.call_count(), 1, "spy recorded the call");
eq(s.called_with([2, 5]), true, "spy recorded real args");
eq(s.return_values()[0], 7, "spy recorded the real return value");

// ── passing a mock callable into code under test ─────────────────────────────
// A retry-like consumer that calls its fn arg until it returns non-nil.
fn drive(f) {
    let i = 0;
    let out = nil;
    while i < 3 {
        out = f(i);
        if out != nil { return out; }
        i = i + 1;
    }
    return out;
}
let m8 = M.mock();
m8.returns_once(nil);
m8.returns_once(nil);
m8.returns_once("done");
let dv = drive(m8.callable(1));
eq(dv, "done", "consumer drove the mock to success");
eq(m8.call_count(), 3, "consumer called it three times");
eq(m8.nth_call(2)[0], 2, "third attempt used index 2");

// ── stub(obj, method, replacement) returns a restore fn ──────────────────────
let obj = map{ greet: fn(name) { return "hi " + name; } };
eq(obj.greet("ana"), "hi ana", "original method works");
let restore = M.stub(obj, "greet", fn(name) { return "STUB " + name; });
eq(obj.greet("ana"), "STUB ana", "method stubbed");
restore();
eq(obj.greet("ana"), "hi ana", "restore puts the original back");

// ── ANY matcher for called_with_match ────────────────────────────────────────
let m9 = M.mock();
m9.fn2("user", 500);
eq(m9.called_with_match(["user", M.ANY]), true, "ANY wildcard matches");
eq(m9.called_with_match([M.ANY, 500]), true, "ANY in first position");
eq(m9.called_with_match(["user", 999]), false, "concrete mismatch rejected");

print "mock_pass";
