assert(str_contains(pbide_src, "while i < len(rs) { let b = rs[i]; win.rect(b.x, b.y, b.w, b.h, color);"), "PBIDE keeps per-rect fallback for older runtimes");
assert(str_contains(pbide_src, "fn _fill_round(win, x, y, w, h, color, r) {\n    let rs = _round_rect_cached(x, y, w, h, r);\n    _draw_rects(win, rs, color);"), "PBIDE rounded fills reuse batched rect drawing");
assert(str_contains(pbide_src, "_draw_rects(win, sh, GUTTERBG);"), "PBIDE legacy cards batch shadow elevation rects");
assert(str_contains(pbide_src, "fn _box(win, x, y, w, h, c) {\n    if w <= 0 or h <= 0 { return 0; }\n    _draw_rects(win, ["), "PBIDE border boxes route through batched rect drawing");
assert(str_contains(pbide_src, "map{ x: x + w - SCALE, y: y, w: SCALE, h: h }"), "PBIDE border batching keeps all four box edges");
assert(str_contains(pbide_src, "let DESIGN_GRID_CACHE = map{};"), "PBIDE Designer grid has a bounded geometry cache");
assert(str_contains(pbide_src, "fn _design_grid_rects(sz_w, canvTop, canvBot)"), "PBIDE Designer grid builds cached rect batches");
