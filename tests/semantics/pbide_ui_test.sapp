// Test: pblang-native IDE UI logic — keymap + syntax highlighting (§91).
// Pure pblang (keymap.sapp, syntax_hl.sapp over the self-hosted tokenizer); runs in the VM.

let K = import("stdlib/keymap.sapp");
let backslash = str_from_char_code(92);
if K.key_to_char(backslash, false) != backslash
    or K.key_to_char("Backslash", false) != backslash
    or K.key_to_char("IntlBackslash", true) != "|" {
    fail("keymap backslash construction/regression");
}
let H = import("stdlib/syntax_hl.sapp");

// ── keymap: key name + shift -> character ─────────────────────────────────────────────
assert(K.key_to_char("A", false) == "a", "letter -> lowercase");
assert(K.key_to_char("A", true) == "A", "shift+letter -> uppercase");
assert(K.key_to_char("Num1", false) == "1", "digit key");
assert(K.key_to_char("Num1", true) == "!", "shift+digit -> symbol");
assert(K.key_to_char("1", false) == "1", "direct digit key");
assert(K.key_to_char("1", true) == "!", "shift+direct digit -> symbol");
assert(K.key_to_char("Digit2", true) == "@", "browser-style digit key");
assert(K.key_to_char("Key3", false) == "3", "alternate key digit name");
assert(K.key_to_char("Numpad4", true) == "4", "numpad digit ignores shifted punctuation");
assert(K.key_to_char("KeyA", false) == "a", "browser-style letter key");
assert(K.key_to_char("Equals", true) == "+", "shift+= -> +");
assert(K.key_to_char("NumpadAdd", false) == "+", "numpad add key");
assert(K.key_to_char("LeftBracket", true) == "{", "shift+[ -> {");
assert(K.key_to_char("/", true) == "?", "direct slash key supports shifted punctuation");
assert(K.key_to_char("Apostrophe", true) == "\"", "apostrophe key alias supports quotes");
assert(K.key_to_char("GraveAccent", true) == "~", "grave accent alias supports tilde");
assert(K.key_to_char("π", false) == "π", "direct unicode text-input character is accepted");
assert(K.key_to_char("≤", false) == "≤", "direct unicode symbol character is accepted");
assert(K.key_to_char("😀", false) == "😀", "direct emoji text-input character is accepted");
assert(K.key_to_char("Space", false) == " ", "space");
assert(K.key_to_char("F5", false) == "", "non-typing key -> empty");
assert(K.is_shift("LShift") and K.is_shift("RShift"), "shift keys detected");
assert(K.is_shift("LeftShift") and K.is_shift("ShiftLeft") and K.is_shift("Shift"), "shift key aliases detected");
assert(K.is_ctrl("LCtrl") and K.is_ctrl("RCtrl"), "ctrl keys detected");
assert(K.is_ctrl("LeftCtrl") and K.is_ctrl("RightCtrl"), "minifb ctrl key aliases detected");
assert(K.is_ctrl("ControlLeft") and K.is_ctrl("ControlRight") and K.is_ctrl("Control"), "browser/SDL ctrl aliases detected");
assert(K.is_alt("LeftAlt") and K.is_alt("AltRight") and K.is_alt("Alt"), "alt key aliases detected");
assert(K.is_meta("MetaLeft") and K.is_meta("Command") and K.is_meta("Super"), "meta/super key aliases detected");

// ── syntax highlighting: uses the self-hosted tokenizer ───────────────────────────────
let toks = H.tokens("fn add(a, b) { return a + 1; }");
assert(toks[0].kind == "keyword" and toks[0].text == "fn", "tokenizes 'fn' as keyword");
assert(toks[1].kind == "ident" and toks[1].text == "add", "tokenizes identifier");
// numbers are highlighted distinctly from keywords
let kkw = H.kind_color("keyword");
let knum = H.kind_color("number");
assert(len(kkw) == 3 and len(knum) == 3, "kind_color returns an [r,g,b] triple");
assert(kkw[0] != knum[0] or kkw[1] != knum[1], "keyword and number get different colours");
let lkw = H.kind_color_theme("keyword", "light");
let dkw = H.kind_color_theme("keyword", "dark");
let ltxt = H.kind_color_theme("ident", "light");
assert(len(lkw) == 3 and len(dkw) == 3, "theme syntax colours return triples");
assert(lkw[0] != dkw[0] or lkw[1] != dkw[1], "light and dark syntax colours differ");
assert(ltxt[0] < 80 and ltxt[1] < 90, "light default syntax text is dark enough");
assert(H.kind_color_theme("keyword", "unknown")[0] == dkw[0], "unknown theme falls back to dark colours");

// ── PBIDE renderer guard: shared panel chrome must not recurse into itself ─────────────
let pbide_src = fs_read("editors/ide/pbide.sapp");
assert(not str_contains(pbide_src, "fn _panel_header_chrome(state, win, sz, m) {\n    _panel_header_chrome(state, win, sz, m);"), "panel header chrome must draw directly, not recurse");
assert(not str_contains(pbide_src, "fn _panel_footer_chrome(state, win, sz, footerY) {\n    _panel_footer_chrome(state, win, sz, footerY);"), "panel footer chrome must draw directly, not recurse");
assert(str_contains(pbide_src, "fn _ui_snapshot_cached(state, sz)"), "PBIDE caches UI observer snapshots");
assert(not str_contains(pbide_src, "state.ui_snapshot = _ui_snapshot(state, sz);\n    _refresh_watcher_draw(state);"), "draw loop must not rebuild UI observer snapshots every frame");
assert(str_contains(pbide_src, "let syntax_rev = try ed.rev catch 0;"), "PBIDE syntax cache follows editor revision metadata");
assert(not str_contains(pbide_src, "let src_hash = IDE.code_hash(src_now);"), "draw loop must not hash the whole editor buffer every frame");
assert(str_contains(pbide_src, "fn _text_needs_shape(raw)"), "PBIDE has a text-shaping fast path");
assert(str_contains(pbide_src, "if not _text_needs_shape(raw) { return raw; }"), "plain ASCII text must bypass expensive shaping");
assert(str_contains(pbide_src, "fn _text_is_blank(raw)"), "PBIDE has a blank-text fast skip");
assert(str_contains(pbide_src, "if _text_is_blank(raw)"), "PBIDE skips empty/whitespace-only text before shaping or rasterizing");
assert(str_contains(pbide_src, "TEXT_FRAME_CALLS = 0;"), "PBIDE resets per-frame text counters before drawing");
assert(str_contains(pbide_src, "state.perf.text_calls = TEXT_FRAME_CALLS;"), "PBIDE records per-frame text call count");
assert(str_contains(pbide_src, "gfx.text_render_plan(TEXT_PROFILE"), "PBIDE exposes a graphics text-render policy plan");
assert(str_contains(pbide_src, "_text_render_status_for_state(state)"), "PBIDE reports text renderer status in Management");
assert(str_contains(pbide_src, "gfx.cpu_render_status(gp)"), "PBIDE reports CPU render health in Graphics/Settings surfaces");
assert(str_contains(pbide_src, "gfx.render_device_policy(gp"), "PBIDE reports the graphics render device policy");
assert(str_contains(pbide_src, "gfx.render_device_policy_status"), "PBIDE exposes readable render device policy status");
assert(str_contains(pbide_src, "gfx.render_startup_profile(\"fast\""), "PBIDE reports the fast graphics startup profile");
assert(str_contains(pbide_src, "gfx.render_startup_profile_status"), "PBIDE exposes readable graphics startup profile status");
assert(str_contains(pbide_src, "gfx.render_startup_env_lines"), "PBIDE exposes deterministic graphics startup env lines");
assert(str_contains(pbide_src, "launch env: "), "PBIDE graphics surfaces show the suggested safe launch env");
assert(str_contains(pbide_src, "startup env: "), "PBIDE graphics surfaces show restart env for fast/GPU mode");
assert(str_contains(pbide_src, "map{ id: \"settings\",label: \"Settings\" }"), "PBIDE exposes Settings as a visible panel tab");
assert(str_contains(pbide_src, "fn _draw_settings(state, win, sz)"), "PBIDE has a native Settings panel renderer");
assert(str_contains(pbide_src, "fn _settings_metrics(sz)"), "PBIDE gives Settings its own non-overlapping layout metrics");
assert(str_contains(pbide_src, "m.row_h = CH * 3 + PAD;"), "Settings rows reserve title plus detail text space");
assert(str_contains(pbide_src, "fn _settings_detail_lines(text, maxchars)"), "Settings details wrap instead of being covered by title text");
assert(str_contains(pbide_src, "let m = _settings_metrics(sz);"), "Settings drawing uses the Settings-specific metrics");
assert(str_contains(pbide_src, "let m = _settings_metrics(state.winsz);"), "Settings clicks use the same metrics as drawing");
assert(str_contains(pbide_src, "else if s.panel == \"settings\" { _settings_key(s, e.key, s.shift); }"), "PBIDE routes Settings keyboard input");
assert(str_contains(pbide_src, "else if s.panel == \"settings\" { _settings_click(s, dx, dy); }"), "PBIDE routes Settings mouse input");
assert(str_contains(pbide_src, "if id == \"panel_settings\" { _panel_by_index(state, 10); return 0; }"), "PBIDE command palette can open Settings");
assert(str_contains(pbide_src, "let ROUND_RECT_CACHE = map{};"), "PBIDE caches rounded-rectangle geometry for repeated chrome");
assert(str_contains(pbide_src, "fn _round_rect_cached(x, y, w, h, r)"), "PBIDE has a cached rounded-rect helper");
assert(str_contains(pbide_src, "ROUND_RECT_CACHE[key] = UIK.rounded_rect(0, 0, w, h, r);"), "rounded-rect cache stores origin-relative geometry");
assert(str_contains(pbide_src, "let ELEVATION_CACHE = map{};"), "PBIDE caches elevation geometry for repeated card shadows");
assert(str_contains(pbide_src, "fn _elevation_cached(x, y, w, h, t)"), "PBIDE has a cached elevation helper");
