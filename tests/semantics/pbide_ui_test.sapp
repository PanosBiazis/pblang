assert(str_contains(pbide_src, "_draw_rects(win, grid_rs, _design_grid_dot(state));"), "PBIDE Designer grid uses batched rect drawing");
assert(str_contains(pbide_src, "let BADGE_CARD_SPECS = map{"), "PBIDE Designer badge specs are a stable table, not per-widget draw allocations");
assert(str_contains(pbide_src, "fn _designer_chart_bar_rects(w)"), "PBIDE Designer chart bars have a batch-rect helper");
assert(str_contains(pbide_src, "_draw_rects(win, _designer_chart_bar_rects(w), accent);"), "PBIDE Designer chart bars draw through rect batching");
assert(str_contains(pbide_src, "fn _designer_table_grid_rects(w)"), "PBIDE Designer table placeholders build one rect batch");
assert(str_contains(pbide_src, "_draw_rects(win, _designer_table_grid_rects(w), muted);"), "PBIDE Designer table placeholders draw through rect batching");
assert(str_contains(pbide_src, "return old_row != ed.row or old_col != ed.col"), "mouse placement reports whether the caret/selection actually changed");
assert(str_contains(pbide_src, "if _mouse_place(s, e.x, e.y, true) { s.redraw = true; }"), "drag selection repaints only when the mapped editor cell changes");
assert(str_contains(pbide_src, "let had_capture = s.mdown or s.split_drag or s.design.drag"), "mouseup avoids unconditional redraws");
assert(str_contains(pbide_src, "fn _toolbar_layout(state, sz)"), "PBIDE caches toolbar layout records");
assert(str_contains(pbide_src, "state.toolbar_layout = out;"), "toolbar layout cache is stored on PBIDE state");
assert(str_contains(pbide_src, "fn _toolbar_hit(state, mx, my, sz)"), "toolbar hit testing uses state-aware cached layout");
assert(str_contains(pbide_src, "_toolbar_hit(s, e.x, e.y, s.winsz)"), "mousemove hover uses cached toolbar hit layout");
assert(str_contains(pbide_src, "fn _toolbar_hit_best(items, mx, my, slop)"), "toolbar overlapping hit zones choose the nearest target");
assert(str_contains(pbide_src, "let score = dx + dy;"), "toolbar hit ranking uses distance to button center");
assert(str_contains(pbide_src, "fn _perf_record_draw(state, ms)"), "PBIDE records draw timing");
assert(str_contains(pbide_src, "fn _perf_record_skip(state)"), "PBIDE records skipped idle frames");
assert(str_contains(pbide_src, "_perf_summary(state)"), "PBIDE exposes frame performance summary");
assert(str_contains(pbide_src, "policy=\" + str(try state.render_runtime_refreshes catch 0)"), "PBIDE exposes render-policy cache telemetry");
assert(str_contains(pbide_src, "fn _render_runtime_for_state(state, gp = nil)"), "PBIDE computes render runtime policy from frame quality");
