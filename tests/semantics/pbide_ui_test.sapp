assert(not str_contains(pbide_src, "if not s.redraw and not GATE.due(now, idle_ms, (try s.last_present_ms catch 0)) {\n                _perf_record_skip(s);"), "PBIDE early idle skip path must not mutate performance counters every loop tick");
assert(str_contains(pbide_src, "fn _token_lines_index(toks)"), "PBIDE indexes syntax tokens by line");
