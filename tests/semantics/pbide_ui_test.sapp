assert(str_contains(pbide_src, "IDE.ide_render_runtime_cache_policy("), "PBIDE uses the tested bounded runtime cache policy");
assert(str_contains(pbide_src, "let runtime = try _render_runtime_current(s)"), "PBIDE idle ticks reuse the cached runtime plan");
assert(not str_contains(pbide_src, "let runtime = try _render_runtime_for_state(s)"), "PBIDE idle ticks must not rebuild render plans");
assert(str_contains(pbide_src, "_render_runtime_refresh(s, draw1, false);"), "PBIDE refreshes runtime policy after measured draws");
assert(str_contains(pbide_src, "fn _adaptive_idle_redraw_interval_ms(state)"), "PBIDE has adaptive idle redraw cadence");
