// Test: pblang-native IDE UI logic — keymap + syntax highlighting (§91).
// Pure pblang (keymap.sapp, syntax_hl.sapp over the self-hosted tokenizer); runs in the VM.

let K = import("stdlib/keymap.sapp");
let H = import("stdlib/syntax_hl.sapp");

// ── keymap: key name + shift -> character ─────────────────────────────────────────────
assert(K.key_to_char("A", false) == "a", "letter -> lowercase");
assert(K.key_to_char("A", true) == "A", "shift+letter -> uppercase");
assert(K.key_to_char("Num1", false) == "1", "digit key");
assert(K.key_to_char("Num1", true) == "!", "shift+digit -> symbol");
assert(K.key_to_char("1", false) == "1", "direct digit key");
assert(K.key_to_char("1", true) == "!", "shift+direct digit -> symbol");
assert(K.key_to_char("Digit2", true) == "@", "browser-style digit key");
assert(K.key_to_char("Key3", false) == "3", "alternate key digit name");
assert(K.key_to_char("Numpad4", true) == "4", "numpad digit ignores shifted punctuation");
assert(K.key_to_char("KeyA", false) == "a", "browser-style letter key");
assert(K.key_to_char("Equals", true) == "+", "shift+= -> +");
assert(K.key_to_char("NumpadAdd", false) == "+", "numpad add key");
assert(K.key_to_char("LeftBracket", true) == "{", "shift+[ -> {");
assert(K.key_to_char("/", true) == "?", "direct slash key supports shifted punctuation");
assert(K.key_to_char("Apostrophe", true) == "\"", "apostrophe key alias supports quotes");
assert(K.key_to_char("GraveAccent", true) == "~", "grave accent alias supports tilde");
assert(K.key_to_char("π", false) == "π", "direct unicode text-input character is accepted");
assert(K.key_to_char("≤", false) == "≤", "direct unicode symbol character is accepted");
assert(K.key_to_char("😀", false) == "😀", "direct emoji text-input character is accepted");
assert(K.key_to_char("Space", false) == " ", "space");
assert(K.key_to_char("F5", false) == "", "non-typing key -> empty");
assert(K.is_shift("LShift") and K.is_shift("RShift"), "shift keys detected");

// ── syntax highlighting: uses the self-hosted tokenizer ───────────────────────────────
let toks = H.tokens("fn add(a, b) { return a + 1; }");
assert(toks[0].kind == "keyword" and toks[0].text == "fn", "tokenizes 'fn' as keyword");
assert(toks[1].kind == "ident" and toks[1].text == "add", "tokenizes identifier");
// numbers are highlighted distinctly from keywords
let kkw = H.kind_color("keyword");
let knum = H.kind_color("number");
assert(len(kkw) == 3 and len(knum) == 3, "kind_color returns an [r,g,b] triple");
assert(kkw[0] != knum[0] or kkw[1] != knum[1], "keyword and number get different colours");

print "pbide_ui_pass";
