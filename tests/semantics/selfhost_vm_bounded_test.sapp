let FE = import("stdlib/compiler/selfhost_frontend.sapp");
let VM = import("stdlib/compiler/vm.sapp");

fn fail(message) { throw "FAIL selfhost_vm_bounded: " + message; }
fn expect_caught(value, message) { if value != "caught" { fail(message); } }

let source = "fn sum(n) { let i = 0; let total = 0; while i < n { total = total + i; i = i + 1; } return total; } let answer = sum(100);";
let run = FE.frontend_run_bounded(source, map{ max_steps: 10000, max_frames: 8 });
if not run.ok or run.globals.answer != 4950 { fail("bounded program result"); }
if run.runtime.steps < 1 or run.runtime.steps > 10000 { fail("step accounting"); }
if run.runtime.peak_frames != 2 { fail("frame accounting"); }
if run.optimization.locals_fused < 2 { fail("nested local superinstructions were not emitted"); }

let infinite = try FE.frontend_run_bounded(
    "let i = 0; while true { i = i + 1; }",
    map{ max_steps: 100 }
) catch "caught";
expect_caught(infinite, "infinite loop must hit step limit");

// Runtime-budget failures are sticky: language try/catch cannot swallow a frame
// limit and continue execution inside the same budget.
let recursive_catch = try FE.frontend_run_bounded(
    "fn dive(n) { return dive(n + 1); } let x = try dive(0) catch 7;",
    map{ max_steps: 10000, max_frames: 8 }
) catch "caught";
expect_caught(recursive_catch, "try/catch must not bypass frame limit");

let output_cap = try FE.frontend_run_bounded(
    "print 1; print 2; print 3;",
    map{ max_output: 2 }
) catch "caught";
expect_caught(output_cap, "output cap");

let locals_cap = try FE.frontend_run_bounded(
    "fn f(a, b) { return a + b; } let x = f(1, 2);",
    map{ max_locals: 1 }
) catch "caught";
expect_caught(locals_cap, "locals cap");
let locals_catch = try FE.frontend_run_bounded(
    "fn f(a, b) { return a + b; } let x = try f(1, 2) catch 7;",
    map{ max_locals: 1 }
) catch "caught";
expect_caught(locals_catch, "try/catch must not bypass locals cap");

let raw_stack = map{
    constants: [1, 2, 3],
    instructions: [map{op: 0, operand: 0}, map{op: 0, operand: 1}, map{op: 0, operand: 2}]
};
let stack_cap = try VM.run_bounded(raw_stack, map{ max_stack: 2 }) catch "caught";
expect_caught(stack_cap, "stack cap on fall-through chunk");

let repeat_cap = try FE.frontend_run_bounded(
    "let huge = str_repeat(\"x\", 1000);",
    map{ max_value_items: 100 }
) catch "caught";
expect_caught(repeat_cap, "string allocation is rejected before str_repeat");

let container_cap = try FE.frontend_run_bounded(
    "let a = []; array_push(a, 1); array_push(a, 2); array_push(a, 3); array_push(a, 4);",
    map{ max_value_items: 3 }
) catch "caught";
expect_caught(container_cap, "array growth is rejected before allocation");

print "selfhost_vm_bounded_pass";
