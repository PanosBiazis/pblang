let FE=import("stdlib:compiler/selfhost_frontend.sapp");
let program="let F=import(\"stdlib:functional.sapp\");let rows=[map{k:2,id:0},map{k:1,id:1},map{k:2,id:2}];let calls=[];let sorted=F.stable_sort_by_key(rows,fn(x){push(calls,x.id);return x.k;},fn(a,b){return a-b;});let indices=F.stable_argsort_by_key(rows,fn(x){return x.k;},fn(a,b){return a-b;});let ids=[];for x in sorted {push(ids,x.id);}let result=[ids,indices,calls];";
let run=FE.frontend_run_bounded(program,map{max_steps:100000,max_frames:32,max_modules:10,max_source_bytes:65536});
assert(run.ok,"selfhost cached key sorting");assert(run.globals.result==[[1,0,2],[1,0,2],[0,1,2]],"selfhost order and callback count");
print "selfhost_key_sort_pass";
// Also execute the actual helper through plain and serialized bytecode.
let VM=import("stdlib:compiler/vm.sapp");let PB=import("stdlib:selfhost_pbck.sapp");
let helper=fs_read("stdlib/functional_sort.sapp");
assert(len(str_to_bytes(helper))<=8192,"bounded trusted helper fixture");
let source=helper+"\nlet values=[3,1,2,1];let keys=[];let comparisons=[];let key=fn(v){push(keys,v);return v;};let cmp=fn(a,b){push(comparisons,[a,b]);return a-b;};let sorted=stable_sort_by_key(values,key,cmp);let indices=stable_argsort_by_key(values,fn(v){return v;},cmp);let failed=try map{ok:true,value:stable_sort_by_key(values,key,fn(a,b){return nil;})} catch map{ok:false};let result=[sorted,indices,values,keys,failed.ok];";
let compiled=FE.frontend_compile(source);assert(compiled.ok and len(compiled.diagnostics)==0,"key helper compiles");
let limits=map{max_steps:30000,max_frames:32};
let plain=VM.run_bounded(compiled.chunk,limits);
let restored=VM.run_bounded(PB.deserialize_chunk(PB.serialize_chunk(compiled.chunk)),limits);
let optimized=FE.frontend_run_bounded(source,limits);
let expected=[[1,1,2,3],[1,3,2,0],[3,1,2,1],[3,1,2,1,3,1,2,1],false];
assert(plain.globals.result==expected and restored.globals.result==expected and optimized.ok and optimized.globals.result==expected,"cached key plain optimized serialized parity");
assert(plain.globals.comparisons==restored.globals.comparisons and plain.globals.comparisons==optimized.globals.comparisons,"serialized callback trace parity");
assert(plain.runtime.steps==restored.runtime.steps,"serialized instruction accounting");
print "selfhost_key_sort_serialized_pass";
