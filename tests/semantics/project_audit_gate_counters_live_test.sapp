// Trusted-checkout child-process diagnostic test; fixtures contain no real secrets.
if platform() != "linux" { print "gate_counters_live_skip_linux_required"; os_exit(0); }
let compiler = env_get("PBLANG_BIN") ?? path_join(cwd(), "target/release/pblang");
let root = "tests/fixtures/gate-counters-" + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 16);
let source = "let A=import(\"stdlib:project_audit.sapp\");\n"
    + "let args=os_args();let mode=args[len(args)-1];\n"
    + "let report=map{finding_count:\"private-counter-marker\"};let options=nil;\n"
    + "if mode==\"nan\" {report=map{finding_count:1,counts_severity:map{high:parse_number(\"NaN\")}};}\n"
    + "if mode==\"container\" {report=map{counts_role:\"private-container-marker\"};}\n"
    + "if mode==\"shape\" {report=map{report:\"private-report-marker\"};}\n"
    + "if mode==\"fallback\" {report=map{findings:\"private-findings-marker\"};}\n"
    + "if mode==\"overflow\" {report=map{counts_role_severity:map{\"source:high\":9007199254740991,\"source:medium\":1}};}\n"
    + "if mode==\"policy\" {options=map{max_high:\"private-policy-marker\"};}\n"
    + "A.quality_gate(report,options);\n";
let failure = "unexpected exception";
fn expect(ok, label) { if not ok { failure = label; throw label; } }
fn exercise() {
    fs_mkdirs(root); fs_write(root + "/main.sapp", source);
    let numeric = "project audit gate counters must be finite integers in 0..9007199254740991";
    for row in [["number", numeric], ["nan", numeric], ["overflow", numeric],
        ["container", "project audit gate counter containers must be maps"],
        ["shape", "project audit gate report must be a map"],
        ["fallback", "project audit gate findings fallback must be an array"],
        ["policy", "project audit gate numeric limits must be finite integers in 0..9007199254740991"]] {
        let result = proc_spawn_wait("/usr/bin/timeout", ["-k", "1s", "5s",
            compiler, root + "/main.sapp", "--allow-all", "--", row[0]]);
        expect(result.exit_code == 1 and result.stdout == ""
            and str_contains(result.stderr, "]: " + row[1] + "\n"), "fixed diagnostic and failure status");
        expect(not str_contains(result.stderr, "private-")
            and not str_contains(result.stderr, "len expects"), "no supplied value or incidental error leakage");
    }
    return true;
}
let ok = try exercise() catch false;
if fs_exists(root + "/main.sapp") { fs_remove(root + "/main.sapp"); }
if fs_exists(root) { fs_remove(root); }
if not ok { throw "FAIL gate-counters-live: " + failure; }
print "project_audit_gate_counters_live_pass";
