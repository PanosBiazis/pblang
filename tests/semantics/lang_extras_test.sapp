// tests/semantics/lang_extras_test.sapp
let lx = import("stdlib:lang_extras.sapp");

let r = lx.range(0, 5, 2);
if len(r) != 3 or r[0] != 0 or r[1] != 2 or r[2] != 4 {
    throw "FAIL range positive";
}

let r2 = lx.range(3, nil, nil);
if len(r2) != 3 or r2[0] != 0 or r2[2] != 2 {
    throw "FAIL range single argument";
}

let r3 = lx.range(5, 1, -2);
if len(r3) != 2 or r3[0] != 5 or r3[1] != 3 {
    throw "FAIL range negative";
}

// Python-style optional arguments: range(n) and range(start, end) must work without
// passing explicit nils for the trailing parameters.
let r1arg = lx.range(5);
if len(r1arg) != 5 or r1arg[0] != 0 or r1arg[4] != 4 {
    throw "FAIL range single positional argument";
}

let r2arg = lx.range(2, 6);
if len(r2arg) != 4 or r2arg[0] != 2 or r2arg[3] != 5 {
    throw "FAIL range two positional arguments";
}

let en = lx.enumerate(["a", "b"]);
if en[1][0] != 1 or en[1][1] != "b" { throw "FAIL enumerate"; }

let zipped = lx.zip([1, 2], ["x"]);
if len(zipped) != 1 or zipped[0][0] != 1 or zipped[0][1] != "x" {
    throw "FAIL zip";
}

let rev = lx.reversed([1, 2, 3]);
if rev[0] != 3 or rev[2] != 1 { throw "FAIL reversed"; }

let obj = map{
    user: map{ name: "Ada", stats: map{ score: 42 } },
    lang: "pblang"
};
if lx.get_path(obj, ["user", "stats", "score"], 0) != 42 {
    throw "FAIL get_path hit";
}
if lx.get_path(obj, ["user", "missing"], "fallback") != "fallback" {
    throw "FAIL get_path fallback";
}
// fallback is optional: omitting it returns nil on a miss, value on a hit.
if lx.get_path(obj, ["user", "missing"]) != nil {
    throw "FAIL get_path optional fallback (miss -> nil)";
}
if lx.get_path(obj, ["user", "stats", "score"]) != 42 {
    throw "FAIL get_path optional fallback (hit)";
}

let picked = lx.pick(obj, ["lang"]);
if picked.lang != "pblang" or map_has(picked, "user") {
    throw "FAIL pick";
}

let omitted = lx.omit(obj, ["user"]);
if omitted.lang != "pblang" or map_has(omitted, "user") {
    throw "FAIL omit";
}

let pairs = lx.entries(map{ a: 1, b: 2 });
if len(pairs) != 2 { throw "FAIL entries"; }
let back = lx.from_entries([["x", 9], ["y", 10]]);
if back.x != 9 or back.y != 10 { throw "FAIL from_entries"; }

if lx.unwrap_or(nil, "fallback") != "fallback" { throw "FAIL unwrap_or nil"; }
if lx.unwrap_or("value", "fallback") != "value" { throw "FAIL unwrap_or value"; }
if lx.expect("ok", "missing") != "ok" { throw "FAIL expect"; }

fn inc(x) { return x + 1; }
fn times10(x) { return x * 10; }
let piped = lx.pipe(3, [inc, times10]);
if piped != 40 { throw "FAIL pipe"; }

let tapped = 0;
fn remember(x) { tapped = x; return nil; }
let tv = lx.tap(9, remember);
if tv != 9 or tapped != 9 { throw "FAIL tap"; }

fn is_big(x) { return x > 5; }
if lx.take_if(7, is_big) != 7 { throw "FAIL take_if hit"; }
if lx.take_if(3, is_big) != nil { throw "FAIL take_if miss"; }
if lx.take_unless(3, is_big) != 3 { throw "FAIL take_unless hit"; }
if lx.take_unless(7, is_big) != nil { throw "FAIL take_unless miss"; }

fn square_index(i) { return i * i; }
let repeated = lx.repeat(4, square_index);
if len(repeated) != 4 or repeated[3] != 9 { throw "FAIL repeat"; }

if lx.clamp(12, 0, 10) != 10 { throw "FAIL clamp high"; }
if lx.clamp(-2, 0, 10) != 0 { throw "FAIL clamp low"; }
if lx.clamp(5, 0, 10) != 5 { throw "FAIL clamp middle"; }

print "lang_extras_pass";
