let F = import("stdlib:functional.sapp");
fn expect(ok, label) { if not ok { throw "FAIL functional-iterate: " + label; } }
let visited = [];
let next = fn(x) { push(visited,x); return x + 1; };
expect(F.iterate(next,7,0) == [] and visited == [], "empty sequence has no callback");
expect(F.iterate(next,7,1) == [7] and visited == [], "singleton does not compute unused successor");
expect(F.iterate(next,7,4) == [7,8,9,10] and visited == [7,8,9], "exact left-to-right callback order");
// The final value may be terminal: no callback is needed on that value.
let terminal = F.iterate(fn(x) { if x == 3 { throw "terminal value"; } return x+1; },1,3);
expect(terminal == [1,2,3], "terminal callback must not be evaluated");
expect(F.iterate(fn(x) { throw "unused"; },7,1) == [7], "singleton callback cannot throw");
let invalid = try map{ok:true,value:F.iterate(7,1,2)} catch map{ok:false};
expect(not invalid.ok, "non-callable successor rejects when needed");
let first_calls = [0];
let first_failed = try map{ok:true,value:F.iterate(fn(x) { first_calls[0] = first_calls[0]+1; throw nil; },1,3)} catch map{ok:false};
expect(not first_failed.ok and first_calls[0] == 1, "first failure including nil is not mistaken for success");
let effects = [];
let failed = try map{ok:true,value:F.iterate(fn(x) { push(effects,x); if x == 2 { throw 17; } return x+1; },1,5)} catch map{ok:false};
expect(not failed.ok and effects == [1,2], "required callback failure stops immediately");
let nil_calls = [0];
let nils = F.iterate(fn(x) { nil_calls[0] = nil_calls[0]+1; return nil; },nil,3);
expect(nils == [nil,nil,nil] and nil_calls[0] == 2, "nil is a sequence value");
let seed = map{count:0};
let borrowed = F.iterate(fn(x) { x.count = x.count+1; return x; },seed,4);
expect(seed.count == 3 and len(borrowed) == 4, "no extra mutation of borrowed seed");
borrowed[0].count = 9;
expect(borrowed[3].count == 9 and seed.count == 9, "reference semantics retained, no deep copy");
let values = F.iterate(F.compose(fn(x) { return x+1; },fn(x) { return x*2; }),1,4);
expect(values == [1,3,7,15], "composed callback");
let many_calls = [0];
let many = F.iterate(fn(x) { many_calls[0] = many_calls[0]+1; return x+1; },0,256);
expect(len(many) == 256 and many[255] == 255 and many_calls[0] == 255, "longer sequence count");
print "functional_iterate_pass";
