// tests/semantics/codec_enrich_test.sapp — enrichment for stdlib/codec.sapp
// Adds string convenience + best-backend selection + a size-ratio helper.

let C = import("stdlib/codec.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let text = "the quick brown fox the quick brown fox the quick brown fox";

// ── ENRICH: string round-trip via decompress_str ─────────────────────────────────
let blob = C.compress(text, "pbz");
eq(C.decompress_str(blob), text, "decompress_str round-trips a string");

// ── ENRICH: compress_best picks an available backend and stays decodable ─────────
let best = C.compress_best(text);
eq(C.decompress_str(best), text, "compress_best round-trips");

// ── ENRICH: ratio helper ─────────────────────────────────────────────────────────
let r = C.ratio(str_to_bytes(text), blob);
if r <= 0 { fail("ratio should be positive, got " + str(r)); }

// backend tag is still readable
eq(C.backend_name(blob), "pbz", "backend_name pbz");

print "codec_enrich_pass";
