// tests/semantics/llm_stream_enrich_test.sapp — enrichment for stdlib/llm_stream.sapp
// Adds collect_chunks (drain all chunks) and reset (rewind the iterator).

let st = import("stdlib/llm_stream.sapp");

fn fail(m) { throw "FAIL " + m; }
fn aeq(a, b, m) {
    if len(a) != len(b) { fail(m + " len : " + str(a)); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " @" + str(i) + " : " + str(a)); } i = i + 1; }
}

let recs = [map{ path: "p", text: "abcdef" }];

// ── ENRICH: collect_chunks (chunk 3, stride 3) ───────────────────────────────────
let s1 = st.from_records(recs, 3, 3);
aeq(st.collect_chunks(s1), ["abc", "def"], "collect_chunks stride 3");

// ── overlapping chunks (chunk 3, stride 2) ───────────────────────────────────────
let s2 = st.from_records(recs, 3, 2);
aeq(st.collect_chunks(s2), ["abc", "cde", "ef"], "collect_chunks stride 2");

// ── ENRICH: reset rewinds the iterator ───────────────────────────────────────────
let s3 = st.from_records(recs, 3, 3);
st.collect_chunks(s3);
st.reset(s3);
aeq(st.collect_chunks(s3), ["abc", "def"], "reset replays from the start");

print "llm_stream_enrich_pass";
