let RUNTIME = import("stdlib:product_runtime.sapp");
let MEMORY = import("stdlib:memory_safety.sapp");

let unknown = RUNTIME.runtime("unknown", "work");
assert(not unknown.ready and not RUNTIME.admit(unknown, map{ items: 1 }).accepted,
       "unknown products fail closed");

let expanded = RUNTIME.runtime("pb-mcp-server", "request", map{
    limits: map{ memory_bytes: 999999999999 }
});
assert(not expanded.ready and len(expanded.profile.refused_adjustments) == 1,
       "product limit overrides cannot expand defaults");
let nonfinite = RUNTIME.runtime("pbai", "inference", map{ limits: map{ tokens: "NaN" } });
assert(not nonfinite.ready, "non-finite product limits fail closed");

let narrowed = RUNTIME.runtime("pbai", "inference", map{
    limits: map{ tokens: 10, workers: 1 }
});
assert(narrowed.ready, "valid tighter profile is ready");
let accepted = RUNTIME.admit(narrowed, map{ tokens: 8, workers: 1 });
assert(accepted.accepted and narrowed.ledger.usage.values.tokens == 8,
       "bounded request is admitted and accounted");
let denied = RUNTIME.admit(narrowed, map{ tokens: 3 });
assert(not denied.accepted and narrowed.ledger.usage.values.tokens == 8,
       "rejected admission is transactional");
assert(RUNTIME.release(narrowed, map{ tokens: 8, workers: 1 }), "release succeeds");

let guarded = RUNTIME.runtime("pblang", "compile", map{ limits: map{ items: 2 } });
let before = MEMORY.stats().lifetime_depth;
let ok = RUNTIME.run(guarded, map{ items: 1 }, fn() { return 42; });
assert(ok.ok and ok.value == 42 and ok.released, "guarded work returns its value and releases budget");
assert((try guarded.ledger.usage.values.items catch 0) == 0, "successful work leaves no reservation");
let failed = RUNTIME.run(guarded, map{ items: 1 }, fn() { throw "boom"; });
assert(not failed.ok and failed.admitted and failed.released, "failed callback still releases admission");
assert(MEMORY.stats().lifetime_depth == before, "guarded work always restores memory lifetime");

RUNTIME.cancel(guarded, "operator stop");
assert(not RUNTIME.try_admit(guarded, map{ items: 1 }), "cancelled runtime rejects hot-path admission");
let snap = RUNTIME.snapshot(guarded);
assert(snap.cancelled and snap.completed == 1 and snap.failed == 1 and snap.denied >= 1,
       "snapshot reports lifecycle counters without callback data");
let stable = RUNTIME.runtime("pb-mcp-server", "request");
assert(RUNTIME.try_admit(stable, map{ workers: 1 }), "snapshot alias test admission");
let stable_snapshot = RUNTIME.snapshot(stable);
assert(RUNTIME.release(stable, map{ workers: 1 }), "snapshot alias test release");
assert(stable_snapshot.usage.workers == 1 and stable_snapshot.limits.workers == 4,
       "snapshot defensively copies mutable runtime maps");

print "product_runtime_pass";
