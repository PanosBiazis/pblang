let P=import("stdlib:word_profile.sapp");let T=import("stdlib:text_document.sapp");let V=import("stdlib:word_profile_view.sapp");let UI=import("stdlib:modern_ui.sapp");let G=import("stdlib:gui.sapp");let CSV=import("stdlib:sheet_csv.sapp");
let doc=T.from_text("beta alpha beta\nα α beta Alpha alpha!","not counted");let before=T.encode(doc);let r=P.analyze(doc);assert(r.total==8 and r.unique==5,"counts");assert(r.entries[0]==map{token:"beta",count:3,blocks:[0,1]},"locations");assert(r.entries[1].token=="α" and r.entries[2].token=="alpha","stable frequency order");r.entries[0].blocks[0]=50;assert(T.encode(doc)==before,"detached");
assert(P.analyze(T.create()).pages==1 and len(P.page(T.create()).entries)==0,"empty report");assert((try P.page(doc,0.5) catch nil)==nil and (try P.page(doc,-1) catch nil)==nil and (try P.page(doc,1) catch nil)==nil,"page bounds");
let many=T.create();many.blocks=[];for b in range(0,32){let terms=[];for j in range(0,8){array_push(terms,"term"+str(b*8+j));}array_push(many.blocks,map{kind:"paragraph",text:str_join(terms," ")});}assert(P.analyze(many).unique==256 and P.analyze(many).pages==32,"maximum distinct forms");assert(P.page(many,31).entries[7].token=="term255","last token available");assert(P.to_sheet(many,31).cells[8][0]=="term255","last token exported");let too=T.copy(many);too.blocks[0].text=too.blocks[0].text+" extra";assert((try P.analyze(too) catch nil)==nil,"unique budget");
let long=T.from_text(str_repeat("x",256));assert(P.analyze(long).unique==1,"token max");assert((try P.analyze(T.from_text(str_repeat("x",257))) catch nil)==nil,"token bytes");let unicode=T.from_text(str_repeat("α",128));assert(P.analyze(unicode).unique==1,"Unicode byte boundary");
let table=P.to_sheet(doc);assert(CSV.decode(CSV.encode(table)).cells==table.cells,"CSV roundtrip");let view=V.create(many,31);for target in ["native","web","android"]{assert(len(UI.compile(view,map{target:target,width:412,height:915}).records)>0,"portable page");}
let f=UI.build("words",V.create(doc),map{width:800,height:900});G.get(f,"select_1").onclick(f);assert(G.get(f,"detail_0").text=="α","portable select action");
let blocks=T.create();blocks.blocks=[];for i in range(0,64){array_push(blocks.blocks,map{kind:"paragraph",text:"x"});}assert(len(P.analyze(blocks).entries[0].blocks)==64,"all block locations");P.to_sheet(blocks);assert(P.analyze(T.from_text("__proto__ map keys __proto__")).entries[0].count==2,"literal map keys");print "word_profile_pass";
