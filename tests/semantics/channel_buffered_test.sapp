// Test: buffered channels
// channel_buffered, channel_size, send/recv with capacity

// Buffered channel of capacity 3
let ch = channel_buffered(3);
if ch.capacity != 3 { throw "FAIL capacity field: " + str(ch.capacity); }

// Send 3 items without blocking (buffer has space)
send(ch.sender, "a");
send(ch.sender, "b");
send(ch.sender, "c");

// Channel size should be 3
let sz = channel_size(ch.receiver);
if sz != 3 { throw "FAIL channel_size after 3 sends: " + str(sz); }

// Receive all 3
let v1 = recv(ch.receiver);
let v2 = recv(ch.receiver);
let v3 = recv(ch.receiver);
if v1 != "a" { throw "FAIL recv [0]: " + str(v1); }
if v2 != "b" { throw "FAIL recv [1]: " + str(v2); }
if v3 != "c" { throw "FAIL recv [2]: " + str(v3); }

// Channel should be empty now
let sz2 = channel_size(ch.receiver);
if sz2 != 0 { throw "FAIL channel_size after draining: " + str(sz2); }

// recv_timeout on empty channel returns nil
let nv = recv_timeout(ch.receiver, 10);
if nv != nil { throw "FAIL recv_timeout on empty should be nil"; }

// Close and recv returns nil
channel_close(ch.sender);
let closed_val = recv(ch.receiver);
if closed_val != nil { throw "FAIL recv on closed buffered channel"; }

print "channel_buffered_pass";
