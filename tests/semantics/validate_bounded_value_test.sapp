let V = import("stdlib:validate.sapp");

fn require(condition, message) {
    if not condition { throw "FAIL " + message; }
}

fn content_free(report, first, second) {
    return not str_contains(json_stringify(report), first)
        and not str_contains(json_stringify(report), second);
}

let valid = map{ name: "pbAI", flags: [true, false, nil], metrics: map{ loss: 0.25 } };
let before = json_stringify(valid);
let report = V.inspect_bounded(valid);
require(report.ok and report.maps == 2 and report.arrays == 1
    and report.keys == 4 and report.nodes == 12,
    "bounded inspection counts every key and value occurrence");
require(json_stringify(valid) == before and not report.input_returned
    and not report.content_hashed and not report.safe_for_public_logging,
    "inspection is non-mutating and never returns or hashes content");

let exact = V.exact_map_bounded(map{ b: 2, a: 1 }, ["a", "b"]);
require(exact.ok and exact.exact, "exact map matching is insertion-order independent");
require(not V.exact_map_bounded(map{ a: 1 }, ["a", "b"]).ok,
    "missing exact-map field fails closed");
require(not V.exact_map_bounded(map{ a: 1, extra: 2 }, ["a"]).ok,
    "extra exact-map field fails closed");
require(V.exact_map_bounded(map{ a: 1, extra: 2 }, ["a"]).reason == "exact-map-mismatch",
    "exact-map failures use fixed content-free reasons");
require(V.exact_map_bounded(map{ a: 1 }, ["a", "a"]).reason == "invalid-schema-keys",
    "duplicate schema keys are rejected");
require(V.exact_map_bounded(map{ a: 1 }, ["a\n"]).reason == "invalid-schema-keys",
    "control-bearing schema keys are rejected");
require(not V.exact_map_bounded(map{ role: 1 }, ["rоle"]).ok,
    "Unicode homoglyph schema names do not match ASCII fields");

let chars_pass_bytes_fail = V.inspect_bounded("α", map{
    max_string_chars: 1, max_string_bytes: 1
});
require(chars_pass_bytes_fail.reason == "string-byte-limit",
    "UTF-8 byte caps remain distinct from character caps");
require(V.inspect_bounded("aa", map{ max_string_chars: 1 }).reason == "string-char-limit",
    "individual string character cap is enforced");
require(V.inspect_bounded(["aa", "bb"], map{
    max_total_string_bytes: 3
}).reason == "total-string-byte-limit",
    "many small strings cannot exceed the cumulative byte budget");
require(V.inspect_bounded(map{ abc: "x" }, map{
    max_total_string_bytes: 3
}).reason == "total-string-byte-limit",
    "map key bytes count toward the cumulative budget");

require(V.inspect_bounded([1, 2], map{ max_array_items: 1 }).reason == "array-item-limit",
    "array width is checked before traversal");
let wide = map{};
let i = 0;
while i < 1025 { wide["k" + str(i)] = i; i = i + 1; }
require(V.inspect_bounded(wide, map{ max_map_entries: 1024 }).reason == "map-entry-limit",
    "map width over the hard boundary is rejected before key enumeration");

let depth32 = map{};
let depth_cursor = depth32;
i = 0;
while i < 32 {
    depth_cursor.next = map{};
    depth_cursor = depth_cursor.next;
    i = i + 1;
}
require(V.inspect_bounded(depth32, map{ max_depth: 32 }).ok,
    "maximum configured depth is accepted");
let depth33 = map{ next: depth32 };
require(V.inspect_bounded(depth33, map{ max_depth: 32 }).reason == "depth-limit",
    "depth plus one fails closed");
let self_array = json_parse("[]");
push(self_array, self_array);
require(V.inspect_bounded(self_array, map{ max_depth: 4 }).reason == "depth-limit",
    "self-referential arrays terminate at the depth budget");
let self_map = map{};
self_map.loop = self_map;
require(V.inspect_bounded(self_map, map{ max_depth: 4 }).reason == "depth-limit",
    "self-referential maps terminate at the depth budget");
let shared = [1];
require(V.inspect_bounded([shared, shared, shared], map{ max_nodes: 6 }).reason == "node-limit",
    "shared aliases count once per occurrence");

let zero = len(map{});
fn divide(a, b) { return a / b; }
require(V.inspect_bounded(divide(1, zero)).reason == "nonfinite-number",
    "infinite numbers are rejected before serialization");
require(V.inspect_bounded(divide(zero, zero)).reason == "nonfinite-number",
    "NaN numbers are rejected before serialization");
require(V.inspect_bounded(fn(x) { return x; }).reason == "unsupported-type",
    "closures are not JSON-like values");
require(V.inspect_bounded(bigint(1)).reason == "unsupported-type"
    and V.inspect_bounded(rational(1, 3)).reason == "unsupported-type"
    and V.inspect_bounded(decimal("1.25")).reason == "unsupported-type",
    "extended numeric types are rejected rather than silently stringified");

require(V.bounded_limits(map{ max_depth: true }).reason == "invalid-options",
    "boolean options are not accepted as integers");
require(V.bounded_limits(map{ max_depth: 2.5 }).reason == "invalid-options",
    "fractional options fail closed");
require(V.bounded_limits(map{ unknown: 1 }).reason == "invalid-options",
    "unknown options fail closed");
let wide_options = map{};
i = 0; while i < 10 { wide_options["x" + str(i)] = i; i = i + 1; }
require(V.bounded_limits(wide_options).reason == "invalid-options",
    "wide options fail before key enumeration");

let sentinel = "private-secret-sentinel-/tmp/example";
require(content_free(V.inspect_bounded(sentinel, map{ max_string_chars: 1 }),
    sentinel, "/tmp/example"),
    "failure reports never echo inspected content");

let status = V.bounded_value_status();
require(status.ok and status.pre_enumeration_map_width_gate
    and status.bounded_depth_nodes_arrays_maps_strings_and_keys
    and status.post_materialization_only and not status.bounds_parsing
    and not status.remote_hostile_ready and status.outer_serialized_request_cap_required
    and not status.canonicalizes_for_hashing and not status.content_safe
    and not status.authorizes_effects,
    "status separates structural inspection from parsing, canonicalization and effects");
print "validate_bounded_value_pass";
