let F = import("stdlib:functional.sapp");
let A = import("stdlib:array.sapp");
fn expect(ok,label) { if not ok { throw "FAIL collection-key-bounds: " + label; } }
fn rejects(f,input) {
    let outcome = try map{ok:true,value:f(input)} catch map{ok:false};
    expect(not outcome.ok,"unsupported input rejects");
}
for value in [nil,true,7,"not-array",map{}] { rejects(F.unique,value); }
let cycle = []; push(cycle,cycle);
for key in [[],map{private_marker:"do-not-render"},fn(x){return x;},cycle] {
    rejects(F.unique,[key]);
    rejects(A.unique,[key]);
    rejects(fn(xs) { return A.distinct_by(xs,F.identity); },[key]);
    rejects(fn(xs) { return F.group_by_entries(xs,F.identity); },[key]);
}
for key in [parse_number("NaN"),parse_number("inf"),parse_number("-inf")] {
    expect(type(key) == "number","nonfinite numeric fixture");
    rejects(F.unique,[key]);
}
for key in [bigint(1),rational("1/2"),decimal("0.5")] { rejects(F.unique,[key]); }
expect(F.unique(F.repeat(0,4096)) == [0],"item boundary accepts");
let attempts = [0];
let oversized = F.repeat(0,4097);
rejects(fn(xs) { return F.unique_by(xs,fn(x) { attempts[0] = attempts[0]+1; return x; }); },oversized);
expect(attempts[0] == 0,"oversized input rejected before callback");
let text = "α";
for i 12 { text = text + text; }
expect(len(text) == 4096 and F.unique([text,text]) == [text],"text character boundary accepts");
rejects(F.unique,[text+"α"]);
let budget_key = slice(text,0,4094);
expect(F.unique(F.repeat(budget_key,16)) == [budget_key],"aggregate bucket character boundary accepts");
rejects(F.unique,F.repeat(budget_key,17));
let changing = [1,2];
rejects(fn(xs) { return F.unique_by(xs,fn(x) { push(xs,3); return x; }); },changing);
expect(changing == [1,2,3],"callback length mutation is detected, not rolled back");
print "collection_keys_bounds_pass";
