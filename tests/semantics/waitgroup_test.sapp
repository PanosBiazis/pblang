// Test: thread stdlib — WaitGroup pattern
import "stdlib:thread.sapp";

// Spawn 3 workers, each signals done; main waits for all.
let wg = thread.wait_group(3);
let results_ch = channel_buffered(3);

let make_worker = fn(id) {
    let wg_ref = wg;
    let ch_ref = results_ch;
    return fn() {
        send(ch_ref.sender, id);
        thread.wg_done(wg_ref);
    };
};

spawn(make_worker(1));
spawn(make_worker(2));
spawn(make_worker(3));

// Wait for all 3 to signal done
thread.wg_wait(wg);

// Collect results (all 3 must be done)
let seen = [];
let i = 0;
while i < 3 {
    let v = recv_timeout(results_ch.receiver, 100);
    if v == nil { print "FAIL wg_wait: not all workers finished before wg_wait returned"; }
    array_push(seen, v);
    i = i + 1;
}

if len(seen) != 3 { print "FAIL waitgroup: expected 3 results, got " + str(len(seen)); }

// wg_wait_timeout: create a new wg and let it complete immediately
let wg2 = thread.wait_group(1);
let fast_worker = fn() { thread.wg_done(wg2); };
spawn(fast_worker);
let ok = thread.wg_wait_timeout(wg2, 3000);
if ok == false { print "FAIL wg_wait_timeout should succeed"; }

print "waitgroup_pass";
