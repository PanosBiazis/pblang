let Binary = import("stdlib:host_pbck_frame_binary.sapp");
let FrameVM = import("stdlib:host_pbck_frame_vm.sapp");
let Plan = import("stdlib:host_pbck_frame_plan.sapp");
let VM = import("stdlib:host_pbck_vm.sapp");

fn fail(message) { throw "FAIL host_pbck_frame_vm: " + message; }
fn rejects(work, message) { if not (try { work(); false } catch true) { fail(message); } }

let child = map{
    __pbck_function: true, name: "double", arity: 1, min_arity: 1,
    defaults: [], is_vararg: false, parameter_types: [0],
    chunk: map{ instructions: [
        map{ op: 25, operand: 0 }, map{ op: 0, operand: 0 },
        map{ op: 3 }, map{ op: 33 }
    ], constants: [2], source_name: nil }
};
let executable = map{
    format: "host-pbck-v1", version: 1, artifact_bytes: 123,
    chunk: map{ instructions: [
        map{ op: 27, fn_const: 0, captures: [] },
        map{ op: 0, operand: 1 }, map{ op: 31, operand: 1 },
        map{ op: 14, operand: 2 }, map{ op: 0, operand: 3 },
        map{ op: 31, operand: 1 }, map{ op: 1 }, map{ op: 33 }
    ], constants: [child, 20, "offset", 1], source_name: nil }
};
let plan = Plan.build_decoded(executable);
let bytes = Binary.encode_plan(plan);
let adapter_calls = 0;
let options = map{ max_steps: 100, adapters: map{ offset: fn(args) {
    adapter_calls = adapter_calls + 1;
    if len(args) != 1 { throw "private adapter detail"; }
    return args[0] + 1;
} } };
let result = FrameVM.run_bytes(bytes, options);
let direct = VM.run_decoded(executable, options);
if result.value != 42 or direct.value != result.value
    or result.runtime.steps != direct.runtime.steps or result.runtime.host_calls != 1
    or adapter_calls != 2 {
    fail("PBFP execution or generic VM parity mismatch");
}

let prepared = FrameVM.prepare(plan);
if prepared.format != FrameVM.FORMAT or prepared.functions != 2
    or prepared.instructions != 12 or prepared.artifact_bytes != 123
    or FrameVM.run_prepared(prepared, options).value != 42 {
    fail("prepared execution mismatch");
}

// Every canonical opcode and operand shape must survive flat reconstruction.
let all = []; let op = 0;
while op < 48 {
    if op == 27 {
        array_push(all, map{ op: op, fn_const: 1,
            captures: [map{ is_local: true, index: 0 }] });
    } elif op == 0 or (op >= 13 and op <= 18) or op == 42 {
        array_push(all, map{ op: op, operand: 0 });
    } elif (op >= 19 and op <= 20) or op == 23 or op == 25 or op == 26
        or op == 28 or op == 29 or op == 31 or op == 32
        or (op >= 35 and op <= 37) {
        let operand = 0;
        if op == 23 or (op >= 35 and op <= 37) { operand = 48; }
        array_push(all, map{ op: op, operand: operand });
    } else { array_push(all, map{ op: op }); }
    op = op + 1;
}
let leaf = map{
    __pbck_function: true, name: "leaf", arity: 1, min_arity: 0,
    defaults: [map{ __pbck_numeric: "bigint", text: "7" }],
    is_vararg: false, parameter_types: [2],
    chunk: map{ instructions: [map{ op: 0, operand: 0 }, map{ op: 33 }],
        constants: [map{ __pbck_numeric: "rational", text: "1/3" }], source_name: nil }
};
let all_function = map{
    __pbck_function: true, name: "all_opcodes", arity: 1, min_arity: 0,
    defaults: [true], is_vararg: false, parameter_types: [0],
    chunk: map{ instructions: all, constants: ["name", leaf], source_name: nil }
};
let exhaustive = map{ format: "host-pbck-v1", version: 1, artifact_bytes: 999,
    chunk: map{ instructions: [
        map{ op: 0, operand: 0 },
        map{ op: 27, fn_const: 1, captures: [map{ is_local: true, index: 0 }] },
        map{ op: 33 }
    ], constants: [0, all_function], source_name: nil } };
let exhaustive_plan = Plan.build_decoded(exhaustive);
let rebuilt = Plan.build_decoded(FrameVM.prepare(exhaustive_plan).decoded);
if Binary.encode_plan(rebuilt) != Binary.encode_plan(exhaustive_plan) {
    fail("48-opcode frame reconstruction is not canonical");
}

rejects(fn() { FrameVM.prepare(plan, map{ max_functions: 1 }); },
    "function budget ignored");
let foreign = Plan.build_decoded(executable);
foreign.operands[foreign.functions[0].instruction_start + 1]
    = foreign.constant_slots[foreign.functions[1].constant_start];
rejects(fn() { FrameVM.prepare(foreign); }, "foreign constant slot accepted");

let cyclic = Plan.build_decoded(executable);
let child_slot = cyclic.constant_slots[cyclic.functions[0].constant_start];
cyclic.constant_functions[child_slot] = 0;
rejects(fn() { FrameVM.prepare(cyclic); }, "cyclic function graph accepted");
rejects(fn() { FrameVM.run_prepared(map{}); }, "invalid prepared program accepted");

let failed = try {
    FrameVM.run(plan, map{ max_steps: 100, adapters: map{
        offset: fn(args) { throw "secret host path /private/token"; }
    } });
    "not rejected"
} catch str(error);
if str_contains(failed, "/private/token") { fail("adapter exception detail leaked"); }

print "host_pbck_frame_vm_pass";
