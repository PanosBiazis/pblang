// Creates and removes its own private synthetic fixture; never touches user records.
let P = import("stdlib:crud_persistent.sapp");
let S = import("stdlib:secure_file.sapp");
let Web = import("stdlib:crud_preview.sapp");
fn denied(action) { let failed=false; try action() catch {failed=true;}; return failed; }
fn exercise(root) {
let path=root+"/records.pbcrud";
assert(P.initialize(path,3,2048),"exclusive initialization");
assert(denied(fn(){P.initialize(path,3,2048);}),"initialization never overwrites");
let a=P.open(path,3,2048); let b=P.open(path,3,2048);
let row=map{id:1,name:"Synthetic <script>",country:"Example",time:"01:20"};
a.insert(row,0);a.close();
assert(denied(fn(){b.insert(row,0);}),"stale process cannot overwrite");
assert(denied(fn(){b.info();}),"unconfirmed write blocks cached reads");
assert(b.refresh() and b.info().revision==1 and b.info().count==1,"refresh authoritative state");
assert(denied(fn(){b.update(row,0);}),"stale form denied before publication");
assert(b.info().revision==1,"validation failure leaves usable store");
row.name="Updated"; b.update(row,1); b.close();
let reopened=P.open(path,3,2048);
assert(reopened.info().revision==2 and reopened.list().rows[0].name=="Updated","restart keeps committed data");
reopened.remove(1,2);reopened.clear(3,"DELETE ALL");reopened.close();
let empty=P.open(path,3,2048);assert(empty.info().revision==4 and empty.info().count==0,"empty snapshot retains revision");empty.close();
assert(denied(fn(){empty.refresh();}),"closed refresh rejected");
let capped=P.open(path,3,64);let before=fs_read(path);
assert(denied(fn(){capped.insert(map{id:1,name:str_repeat("x",80),country:"Test",time:"1"},4);}),"oversized mutation rejected");
assert(capped.info().revision==4 and fs_read(path)==before,"budget failure preserves disk and memory");capped.close();

fn request(method,path,body="") {return map{method:method,path:path,body:body,headers:map{
    host:"127.0.0.1:8765",origin:"http://127.0.0.1:8765","content-type":"application/x-www-form-urlencoded"}};}
let app=Web.create_persistent(path);let home=app.handle(request("GET","/"));
assert(home.status==200 and str_contains(home.body,"Saved on this device"),"persistent UI label");
assert(not str_contains(home.body,root),"private path never rendered");
let token=str_split(str_split(home.body,"name=\"csrf\" value=\"")[1],"\"")[0];
let body="csrf="+token+"&revision=4&id=9&name=Browser&country=Test&time=1";
assert(app.handle(request("POST","/create",body)).status==303,"persistent form saves");app.close();
let app2=Web.create_persistent(path);assert(str_contains(app2.handle(request("GET","/")).body,"Browser"),"new app reads saved row");
let editor=P.open(path);editor.update(map{id:9,name:"Another process",country:"Test",time:"2"},5);editor.close();
assert(str_contains(app2.handle(request("GET","/")).body,"Another process"),"GET refreshes other process changes");

let original=fs_read(path);assert(S.write_text_atomic(path,"corrupt",false,true).ok,"corruption fixture");
assert(app2.handle(request("GET","/")).status==503,"corruption visible as unavailable");app2.close();
assert(denied(fn(){P.open(path);}),"corrupt state never reset to empty");
assert(fs_read(path)=="corrupt","failed open preserves damaged evidence");
assert(S.write_text_atomic(path,original,false,true).ok,"restore synthetic fixture");

assert(proc_spawn_wait("/bin/ln",["-s",path,root+"/symbolic"]).exit_code==0,"symlink fixture");
assert(denied(fn(){P.open(root+"/symbolic");}),"symlink rejected");
assert(proc_spawn_wait("/bin/ln",[path,root+"/hard"]).exit_code==0,"hardlink fixture");
assert(denied(fn(){P.open(path);}),"multiply linked file rejected");fs_remove(root+"/hard");
assert(proc_spawn_wait("/bin/chmod",["0644",path]).exit_code==0,"mode fixture");
assert(denied(fn(){P.open(path);}),"public file rejected");
assert(proc_spawn_wait("/bin/chmod",["0600",path]).exit_code==0,"restore mode");
let blocked=P.open(path);fs_remove(path+".lock");fs_mkdirs(path+".lock");
assert(denied(fn(){blocked.remove(9,6);}),"lock failure rejected");
assert(fs_read(path)==original,"lock failure preserves disk");blocked.close();
}
if platform() == "linux" {
    let root = "/tmp/pblang-crud-test-" + str_slice(sha256(json_stringify(random_bytes(16))),0,24);
    assert(S.create_private_directory_new(root).ok,"private fixture root");
    let failed=false; try exercise(root) catch {failed=true;};
    for name in ["symbolic","hard","records.pbcrud"] { try fs_remove(root+"/"+name) catch nil; }
    // A failure may leave either the regular lock file or the injected directory.
    try fs_remove(root+"/records.pbcrud.lock") catch nil;
    try S.remove(root+"/records.pbcrud.lock") catch nil;
    let cleaned = S.remove(root);
    assert(cleaned.ok,"remove private fixture directory");
    assert(not failed,"persistent workflow failed; fixture cleaned");
    print "crud_persistent_live_pass";
} else { print "crud_persistent_live_skip: Linux private CAS required"; }
