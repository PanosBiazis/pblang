// tests/semantics/signal_stdlib_test.sapp
let signal = import("stdlib:signal.sapp");

// Basic subscribe/emit
let sig = signal.new();
let received = [];

let unsub1 = signal.subscribe(sig, fn(data) {
    array_push(received, data);
});
let unsub2 = signal.subscribe(sig, fn(data) {
    array_push(received, data * 2);
});

signal.emit(sig, 5);
if len(received) != 2 { print "FAIL subscribe count: expected 2 got " + str(len(received)); }
if received[0] != 5 or received[1] != 10 {
    print "FAIL emit values: got " + str(received[0]) + " and " + str(received[1]);
}

// Unsubscribe
unsub1();
signal.emit(sig, 3);
if len(received) != 3 { print "FAIL after unsub: expected 3 got " + str(len(received)); }
if received[2] != 6 { print "FAIL unsub1 still active"; }

// Count
if signal.count(sig) != 1 { print "FAIL count: expected 1 got " + str(signal.count(sig)); }

// Clear
signal.clear(sig);
if signal.count(sig) != 0 { print "FAIL clear"; }

// once
let once_count = 0;
let sig2 = signal.new();
signal.once(sig2, fn(d) { once_count = once_count + 1; });
signal.emit(sig2, "a");
signal.emit(sig2, "b");
if once_count != 1 { print "FAIL once: expected 1 got " + str(once_count); }

// map_signal
let sig3 = signal.new();
let mapped_vals = [];
let mapped = signal.map_signal(sig3, fn(x) { return x * 3; });
signal.subscribe(mapped, fn(v) { array_push(mapped_vals, v); });
signal.emit(sig3, 4);
if len(mapped_vals) != 1 or mapped_vals[0] != 12 {
    print "FAIL map_signal: expected 12 got " + str(mapped_vals[0]);
}

// filter_signal
let sig4 = signal.new();
let filtered = [];
let fsig = signal.filter_signal(sig4, fn(x) { return x > 5; });
signal.subscribe(fsig, fn(v) { array_push(filtered, v); });
signal.emit(sig4, 3);   // filtered out
signal.emit(sig4, 7);   // passes
signal.emit(sig4, 2);   // filtered out
if len(filtered) != 1 or filtered[0] != 7 {
    print "FAIL filter_signal: expected [7] got " + str(len(filtered));
}

print "signal_stdlib_pass";
