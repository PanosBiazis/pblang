let Cap = import("stdlib:tool_result_cap.sapp");
let assertions = 0;
fn check(condition, message) {
    assertions = assertions + 1;
    assert(condition, message);
}
fn bytes(text) { return len(str_to_bytes(text)); }
fn check_bound(receipt, cap) {
    check(receipt.output_bytes <= cap, "wire output never exceeds cap");
    if receipt.output == nil {
        check(receipt.output_bytes == 0, "absent output has zero bytes");
    } else {
        check(bytes(receipt.output) == receipt.output_bytes, "exact output UTF-8 receipt");
    }
}
let samples = ["null", "true", "0", "{\"x\":1}", "\"Ελλάδα\"", "\"🙂\"",
    "\"é漢🙂\"", "{\"line\":\"a\\nb\\\"c\"}", " \n[1,2]\t",
    "1234567890123456789012345678901234567890", "1.234567890123456789e+200",
    "{\"n\":9007199254740993}", "\"\\u03b1\""];
for source in samples {
    let size = bytes(source);
    let exact = Cap.bound_prevalidated_json(source, size);
    check(exact.ok and exact.accepted and not exact.capped, "exact boundary accepted");
    check(exact.output == source and exact.input_bytes == size, "original lexemes and whitespace retained");
    check_bound(exact, size);
    let below = Cap.bound_prevalidated_json(source, size - 1);
    check(below.ok and not below.accepted and below.capped, "one-byte over cap rejects whole input");
    check(below.output == nil or below.output == Cap.replacement_json(), "only fixed whole replacement or no output");
    check_bound(below, size - 1);
}
check(bytes("\"Ελλάδα\"") > len("\"Ελλάδα\""), "Greek bytes differ from scalar count");
check(bytes("\"🙂\"") == 6, "emoji is four UTF-8 bytes plus quotes");
let replacement = Cap.replacement_json();
check(json_parse(replacement).error == "tool_result_too_large", "replacement is complete valid JSON");
let replacement_bytes = bytes(replacement);
let marker = "SYNTHETIC_PRIVATE_MARKER_684913";
let oversized = "{\"" + marker + "\":\"" + str_repeat("x", 512) + "\"}";
for cap in [0, 1, replacement_bytes - 1, replacement_bytes, replacement_bytes + 1, 128] {
    let result = Cap.bound_prevalidated_json(oversized, cap);
    check(result.ok and result.capped and not result.accepted, "oversize receipt flags");
    check(result.input_bytes == bytes(oversized), "measured oversized byte count");
    check(not str_contains(json_stringify(result), marker), "no source marker in ANY receipt field");
    if cap < replacement_bytes { check(result.output == nil, "tiny cap emits nothing"); }
    else { check(result.output == replacement, "entire fixed replacement fits"); }
    check_bound(result, cap);
}
let invalid_limits = [-1, 0.5, "64", true, nil, [], map{secret:marker},
    1048577, 9007199254740991, 9007199254740992,
    parse_number("NaN"), parse_number("Infinity"), parse_number("-Infinity")];
for cap in invalid_limits {
    let rejected = Cap.bound_prevalidated_json(oversized, cap);
    check(not rejected.ok and not rejected.accepted and not rejected.capped, "malformed or unsupported limit rejected");
    check(rejected.output == nil and rejected.output_bytes == 0 and rejected.input_bytes == nil, "invalid limit emits no payload");
    check(not str_contains(json_stringify(rejected), marker), "invalid limit does not reflect arguments");
}
for source in [nil, false, 42, [], map{secret:marker}] {
    let rejected = Cap.bound_prevalidated_json(source);
    check(not rejected.ok and rejected.reason == "invalid_source_type", "no source coercion");
    check(rejected.output == nil and rejected.output_bytes == 0, "wrong type has no output");
    check(not str_contains(json_stringify(rejected), marker), "wrong type contains no reflected content");
}
// Explicitly prove the opaque precondition: admission is NOT JSON validation.
for malformed in ["", "{", "[[", "{\"x\":]", "not-json"] {
    let result = Cap.bound_prevalidated_json(malformed, 64);
    check(result.accepted and result.output == malformed, "opaque text is not parsed or repaired");
}
let defaults = Cap.bound_prevalidated_json("null");
check(defaults.accepted and defaults.output_bytes == 4, "default cap works");
let limit = Cap.limits();
check(limit.default_bytes == 65536 and limit.max_bytes == 1048576, "declared limits");
limit.max_bytes = 0;
check(Cap.limits().max_bytes == 1048576, "limits metadata is caller-owned");
let maximum = "\"" + str_repeat("a", 1048574) + "\"";
check(Cap.bound_prevalidated_json(maximum, 1048576).accepted, "maximum ASCII input and output exact fit");
let beyond = maximum + " ";
let bounded = Cap.bound_prevalidated_json(beyond, 1048576);
check(bounded.capped and bounded.input_bytes == nil and bounded.reason == "input_scalar_limit", "scalar ceiling stops byte measurement");
check_bound(bounded, 1048576);
let unicode_max = "\"" + str_repeat("🙂", 262143) + "\"";
let unicode_result = Cap.bound_prevalidated_json(unicode_max, 1048576);
check(unicode_result.accepted and unicode_result.input_bytes == 1048574, "large multibyte exact measurement");
let final_wrapper = "{\"result\":" + "\"Ελλάδα🙂\"" + "}";
let wrapped = Cap.bound_prevalidated_json(final_wrapper, bytes(final_wrapper));
check(wrapped.accepted and wrapped.output == final_wrapper, "cap includes final caller wrapper");
let wrapper_rejected = Cap.bound_prevalidated_json(final_wrapper, bytes("\"Ελλάδα🙂\""));
check(wrapper_rejected.capped, "body-only budget does not admit final wrapper");
check(Cap.bound_prevalidated_json("null", 4).accepted, "recovery after rejected input");
print "tool_result_cap_pass assertions=" + str(assertions);
