let Privacy=import("stdlib:privacy_guard.sapp");
let safe=Privacy.sanitize("Public documentation text.");
if not safe.ok or safe.redacted { throw "privacy guard changed safe text"; }
let sensitive="Authorization: Bearer ghp_abcdefghijklmnopqrstuvwxyz123456\n/home/local-user/private.txt";
let blocked=Privacy.sanitize(sensitive);
if blocked.ok or blocked.finding_count<2 or map_has(blocked,"text") { throw "privacy guard did not fail closed"; }
let redacted=Privacy.sanitize(sensitive,map{mode:"redact"});
if not redacted.ok or not redacted.redacted or str_contains(redacted.text,"ghp_")
    or str_contains(redacted.text,"/home/") or (try redacted.values_exposed catch true) {
    throw "privacy guard redaction leaked sensitive content";
}
let custom=Privacy.sanitize("Internal alias: BlueProject",map{mode:"block",custom_sensitive_terms:["BlueProject"]});
if custom.ok { throw "privacy guard ignored a custom sensitive term"; }
print "privacy_guard_pass";
