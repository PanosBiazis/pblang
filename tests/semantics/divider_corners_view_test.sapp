let V=import("stdlib:divider_corners_view.sapp");let UI=import("stdlib:modern_ui.sapp");let G=import("stdlib:gui.sapp");
let f=V.build();for w in f.widgets {assert(w.x+w.w<=f.w and w.y+w.h<=f.h,"controls fit");}assert(str_contains(G.get(f,"rows").value,"8. high / high / high"),"all corners visible");
let vin=G.get(f,"vin");vin.value="6";let tp=G.get(f,"tp");let bp=G.get(f,"bp");let lp=G.get(f,"lp");tp.value="0";bp.value="0";lp.value="0";V.calculate(f);assert(str_contains(G.get(f,"output").text,"Nominal: 2 V"),"native recalculation");lp.value="21";V.calculate(f);assert(G.get(f,"rows").value=="" and G.get(f,"output").text=="","invalid clears stale values");
for target in ["native","web","android"] {let c=UI.compile(V.view(),map{target:target,width:412,height:915});assert(len(c.records)>0,"portable snapshot");}print "divider_corners_view_pass";
