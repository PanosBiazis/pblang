let S = import("stdlib:secure_file.sapp");

fn require(value, message) {
    if not value { throw "secure_file_capability_test: " + message; }
}

let state = S.status();
if platform() == "linux" and not state.available {
    require(not state.ffi_symbol_contract_verified,
        "status must not claim that a symbol/signature contract was verified");
    let path = "/tmp/pblang-secure-file-denied-" +
        str_slice(sha256(base64_encode_bytes(random_bytes(24))), 0, 24) + ".txt";
    let result = S.write_text_atomic(path, "must-not-exist", false, false);
    if not state.operations_attemptable {
        require(not state.ffi_library_authority
            and state.unavailable_reason == "ffi-library-authority-unavailable",
            "default-denied FFI is reported as missing library authority");
        require(not result.ok
            and str_contains(result.error, "ffi-library-authority-unavailable")
            and not fs_exists(path),
            "missing library authority fails closed without pathname fallback");
    } else {
        require(state.ffi_library_authority
            and state.unavailable_reason == "ffi-symbol-contract-unverified",
            "a library grant is distinct from an operational symbol contract");
        if result.ok { require(S.remove_file(path, false).ok, "probe cleanup failed"); }
        else { require(not fs_exists(path), "partial authority created a file"); }
    }
}

print "secure_file_capability_pass";
