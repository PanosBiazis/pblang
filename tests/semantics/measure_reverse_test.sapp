let M=import("stdlib:measure_document.sapp");let U=import("stdlib:units.sapp");let Before=import("../../bench/fixtures/measure_document_before_results.sapp");
fn rejects(f) {let bad=false;try {f();} catch {bad=true;}assert(bad,"invalid operation rejected");}
let doc=M.set_row(M.create("Synthetic"),0,"Resistance",2.2,"kohm","ohm");doc=M.append(doc);let encoded=M.encode(doc);
let reverse=M.reverse_row(doc,0);assert(reverse.rows[0].value==2200 and reverse.rows[0].from=="ohm" and reverse.rows[0].to=="kohm","reverse carries result as input");
assert(num_abs(M.results(reverse)[0]-2.2)<0.000000000001 and reverse.rows[0].label=="Resistance","same quantity and label");
reverse.rows[1].label="Detached";assert(doc.rows[1].label=="New conversion" and M.encode(doc)==encoded,"all rows detached, source retained");
for mode in ["absolute","difference"] {
 let t=M.set_row(M.create(),0,"Temperature",10,"degC","degF",mode);let reversed=M.reverse_row(t,0);
 assert(reversed.rows[0].value==(if mode=="absolute" {50} else {18}) and reversed.rows[0].mode==mode,"temperature modes retained");
 assert(num_abs(M.results(reversed)[0]-10)<0.0000000001,"inverse temperature result");
 assert(M.decode(M.encode(reversed))==reversed,"reverse persistence");
}
let checked=0;
for a in U.catalog() {for b in U.catalog(a.category) {
 for mode in ["absolute","difference"] {
  let source=try M.set_row(M.create(),0,"Synthetic",25,a.symbol,b.symbol,mode) catch nil;
  if source==nil {continue;}
  let old=M.encode(source);let values=M.results(source);assert(values==Before.results(source),"exact old/new results");
  let twice=M.reverse_row(M.reverse_row(source,0),0);
  assert(num_abs(twice.rows[0].value-25)<0.00000001 and twice.rows[0].from==a.symbol and twice.rows[0].to==b.symbol,"all admitted pairs reverse twice");
  assert(M.encode(source)==old,"input unchanged");checked=checked+1;
 }
}}
for index in [-1,2,0.5,"0",nil,true] {rejects(fn(){M.reverse_row(doc,index);});}
let bad=M.copy(doc);bad.rows[1].value="bad";rejects(fn(){M.results(bad);});rejects(fn(){Before.results(bad);});rejects(fn(){M.reverse_row(bad,0);});
let malformed=M.copy(doc);malformed.rows[0].extra=true;rejects(fn(){M.results(malformed);});rejects(fn(){Before.results(malformed);});
let max=M.create();for i in range(1,31) {max=M.append(max);}assert(M.results(max)==Before.results(max) and M.to_sheet(max)==Before.to_sheet(max),"31-row table exact parity");
print "measure_reverse_pass pairs="+str(checked);

let negative=M.set_row(M.create(),0,"Signed difference",-10,"degC","degF","difference");assert(M.reverse_row(negative,0).rows[0].value==-18,"signed difference retained");
let V=import("stdlib:measure_view.sapp");let UI=import("stdlib:modern_ui.sapp");let G=import("stdlib:gui.sapp");
let converted=M.reverse_row(doc,0);let form=UI.build("Reversed reader",V.create(converted),map{width:412,height:915});
assert(G.get(form,"detail_5").text=="Input: 2200 ohm" and G.get(form,"detail_6").text=="Result: 2.2 kohm","saved reverse visible in portable reader");
for target in ["native","web","android"] {assert(len(UI.compile(V.create(converted),map{target:target,width:412,height:915}).records)>0,"reversed cross-target compilation");}
