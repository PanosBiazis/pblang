// Execute only trusted synthetic boundary programs in bounded local children.
if platform()!="linux" { print "native_type_bounds_skip_linux_required"; os_exit(0); }
let X = import("stdlib/native/codegen_x64.sapp");
let UUID = import("stdlib:uuid.sapp");
let OS = import("stdlib:os.sapp");
let path=path_join(OS.temp_dir(),"pblang_type_bounds_"+UUID.v4()+".elf");
let original=X.heap_reserve_bytes();
fn exercise() {
    for reserve in [1048576,16777217,1073741824] {
        let actual=X.set_heap_reserve(reserve);
        let base=70368744177664; let end=base+actual;
        let source="fn kinds(v){return is_string(v)+2*is_array(v)+4*is_map(v);}";
        let expected="";
        // Inclusive last readable tag start, seven unreadable starts, and both
        // sides of the mapping. Empty mapped bytes are not object tags.
        for address in [base-8,base-1,end-8,end-7,end-6,end-5,end-4,end-3,end-2,end-1,end,end+1] {
            source=source+"print kinds("+str(address)+");";
            expected=expected+"0\n";
        }
        source=source+"print kinds(-1);print kinds(nil);print kinds(false);print kinds(true);print kinds(0);print kinds(1);";
        expected=expected+str_repeat("0\n",6);
        source=source+"print kinds(\"text\");print kinds([]);print kinds(map{});print kinds(fn(){return 1;});";
        expected=expected+"1\n2\n4\n0\n";
        source=source+"let s=\"a\";s=s+\"b\";print kinds(s);let a=[1];push(a,2);print kinds(a);let m=map{};m.x=1;print kinds(m);";
        expected=expected+"1\n2\n4\n";
        let result=X.compile_safe(source);
        assert(result.memory_safety_certified==false and result.runtime_isolated==false,"bounded reads are not isolation");
        fs_write_bytes(path,result.binary);
        let permissions=proc_spawn_wait("chmod",["700",path]);
        assert(permissions.exit_code==0,"local executable permission");
        let child=proc_spawn_wait("/usr/bin/timeout",["-k","1s","5s",path]);
        assert(child.exit_code==0 and child.stdout==expected and child.stderr=="","native type probes respect complete tag-read bounds");
        fs_remove(path);
    }
}
let passed=try {exercise();true} catch false;
try fs_remove(path) catch nil;
X.set_heap_reserve(original);
assert(passed,"native type boundary regression");
print "native_type_bounds_pass";
