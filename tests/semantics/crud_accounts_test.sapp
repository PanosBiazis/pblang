let P=import("stdlib:crud_preview.sapp");
let B=import("stdlib:password_bcrypt_linux.sapp");
fn denied(action){let failed=false;try action() catch {failed=true;};return failed;}
let provider=B.open();let password="Synthetic password 123!";let encoded=provider.hash(password);
assert(B.valid_hash(encoded) and provider.verify(password, encoded), "bcrypt roundtrip");
assert(not provider.verify("wrong", encoded), "wrong password");
assert(provider.hash(password) != encoded, "independent salts");
for bad in ["", "short", "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "valid password here" + strfromcharcode(0)] {
    assert(denied(fn(){provider.hash(bad);}), "reject password before native call");
}
assert(denied(fn(){provider.verify(password, "$2b$04$" + str_slice(encoded, 7, 60));}), "cost downgrade");
let oversized_utf8=""; for count 37 { oversized_utf8=oversized_utf8+strfromcharcode(233); }
assert(denied(fn(){provider.verify(oversized_utf8, encoded);}), "byte limit no truncation");
provider.close();provider.close();assert(denied(fn(){provider.hash(password);}), "closed provider");
let catalog=map{editor:encoded};
let app=P.create_accounts(catalog, 8765, 10, 900, 4);
catalog.editor="changed";

fn req(method, path, body="", cookie=""){
    return map{method:method, path:path, body:body, headers:map{host:"127.0.0.1:8765", origin:"http://127.0.0.1:8765", "content-type":"application/x-www-form-urlencoded", cookie:cookie}};
}

fn csrf(response){return str_split(str_split(response.body, "name=\"csrf\" value=\"")[1], "\"")[0];}

fn cookie(response){return str_split(response.headers["Set-Cookie"], ";")[0];}

fn login_body(token, pwd="Synthetic password 123!"){return "username=editor&password=" + url_encode(pwd) + "&csrf=" + token;}
assert(app.handle(req("GET", "/")).status == 303, "protected home");
assert(app.handle(req("POST", "/create")).status == 403, "protected mutation");
let page=app.handle(req("GET", "/login"));let anon=cookie(page);let token=csrf(page);
assert(str_contains(page.headers["Set-Cookie"], "HttpOnly; SameSite=Strict"), "cookie flags");
assert(app.handle(req("POST", "/login", login_body(token))).status == 403, "cookie binding");
assert(app.handle(req("POST", "/login", login_body("bad"), anon)).status == 403, "login CSRF");
let cross=req("POST", "/login", login_body(token), anon);cross.headers.origin="https://example.invalid";
assert(app.handle(cross).status == 403, "cross-origin login");
let dup=req("GET", "/", "", anon);dup.headers["Cookie"]=anon;
assert(app.handle(dup).status == 400, "case-duplicate headers");
assert(app.handle(req("GET", "/", "", anon + "; " + anon)).status == 400, "duplicate cookie");
assert(app.handle(req("POST", "/login", login_body(token) + "&username=x", anon)).status == 400, "duplicate form");
assert(app.handle(req("POST", "/login", login_body(token, "wrong"), anon)).status == 401, "wrong login");
let success=app.handle(req("POST", "/login", login_body(token), anon));assert(success.status == 303, "login");
let sid=cookie(success);assert(sid != anon, "rotation");
assert(app.handle(req("GET", "/", "", anon)).status == 303, "old session invalid");
let home=app.handle(req("GET", "/", "", sid));let guard=csrf(home);
assert(home.status == 200 and guard != token and str_contains(home.body, "Sign out"), "authenticated home");
let change="csrf=" + guard + "&revision=0&id=1&name=%3Cscript%3E&country=Example&time=1";
assert(app.handle(req("POST", "/create", change, sid)).status == 303, "authenticated create");
assert(app.handle(req("POST", "/create", change, sid)).status == 400, "revision still enforced");
assert(str_contains(app.handle(req("GET", "/", "", sid)).body, "&lt;script&gt;"), "escaped account output");
assert(app.handle(req("POST", "/logout", "csrf=bad", sid)).status == 403, "logout CSRF");
let logout=app.handle(req("POST", "/logout", "csrf=" + guard, sid));
assert(logout.status == 303 and str_contains(logout.headers["Set-Cookie"], "Max-Age=0"), "logout cookie removal");
assert(app.handle(req("GET", "/", "", sid)).status == 303, "revocation");
assert(app.handle(req("POST", "/delete", "csrf=" + guard + "&revision=1&id=1", sid)).status == 403, "revoked mutation");
app.close();app.close();assert(app.handle(req("GET", "/")).status == 503, "closed account app");
let limited=P.create_accounts(map{editor:encoded}, 8765, 10, 900, 1);
let first=limited.handle(req("GET", "/login"));let lc=cookie(first);let lt=csrf(first);
assert(limited.handle(req("GET", "/login")).status == 503, "session capacity");
for i 10 {assert(limited.handle(req("POST", "/login", login_body(lt, "wrong"), lc)).status == 401, "limited verification");}
assert(limited.handle(req("POST", "/login", login_body(lt), lc)).status == 429, "global rate limit even correct password");
limited.close();
let short=P.create_accounts(map{editor:encoded}, 8765, 10, 1, 1);
let expired=short.handle(req("GET", "/login"));sleep_ms(1100);
assert(short.handle(req("POST", "/login", login_body(csrf(expired)), cookie(expired))).status == 403, "expired login");
assert(short.handle(req("GET", "/login")).status == 200, "expired capacity reused");short.close();
let expiry=P.create_accounts(map{editor:encoded},8765,10,1,1);
let ep=expiry.handle(req("GET","/login"));
let auth=expiry.handle(req("POST","/login",login_body(csrf(ep)),cookie(ep)));
assert(auth.status==303,"short authenticated login");
sleep_ms(1100);
assert(expiry.handle(req("GET","/","",cookie(auth))).status==303,"authenticated expiry");
expiry.close();
print "crud_accounts_pass";
