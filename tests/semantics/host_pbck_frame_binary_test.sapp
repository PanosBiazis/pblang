let Binary = import("stdlib:host_pbck_frame_binary.sapp");
let Plan = import("stdlib:host_pbck_frame_plan.sapp");
let Translate = import("stdlib:selfhost_to_pbck.sapp");

fn fail(message) { throw "FAIL host_pbck_frame_binary: " + message; }
fn rejects(work, message) { if not (try { work(); false } catch true) { fail(message); } }

let child = map{
    arity: 1, min_arity: 1,
    chunk: map{
        instructions: [
            map{ op: 38, operand: 0 }, map{ op: 16, operand: 0 },
            map{ op: 1, operand: 0 }, map{ op: 39, operand: 0 },
            map{ op: 38, operand: 0 }, map{ op: 19, operand: 0 }
        ], constants: []
    },
    upvalues: [map{ index: 0, is_local: true }]
};
let root = map{
    instructions: [
        map{ op: 0, operand: 0 }, map{ op: 17, operand: 0 },
        map{ op: 24, operand: 1 }, map{ op: 17, operand: 1 },
        map{ op: 16, operand: 1 }, map{ op: 0, operand: 2 },
        map{ op: 18, operand: 1 }, map{ op: 19, operand: 0 }
    ], constants: [40, child, 2]
};

let pbck = Translate.translate(root);
let original = Plan.build_bytes(pbck);
let encoded = Binary.encode_plan(original);
let decoded = Binary.decode(encoded);
let report = Binary.inspect(encoded);
if not Plan.validate(decoded).ok or report.format != Binary.FORMAT
    or report.functions != 2 or report.instructions != 18 or report.captures != 1
    or report.artifact_bytes != len(pbck) {
    fail("round-trip totals mismatch");
}
if Binary.encode_plan(decoded) != encoded { fail("encoding is not deterministic"); }
if Plan.constant_at(decoded, 0, 2) != 40 or Plan.constant_at(decoded, 0, 4) != 2 {
    fail("constant slot mapping changed");
}
let closure = nil; let i = 0;
while i < decoded.functions[0].instruction_count {
    let instruction = Plan.instruction_at(decoded, 0, i);
    if instruction.op == 27 { closure = instruction; }
    i = i + 1;
}
if closure == nil or closure.operand != 1 or len(closure.captures) != 1
    or not closure.captures[0].is_local or closure.captures[0].index != 0 {
    fail("closure capture mapping changed");
}

let rich_child = map{
    __pbck_function: true, name: "typed", arity: 4, min_arity: 0,
    defaults: [true, nil, "default", map{ __pbck_numeric: "bigint", text: "12345678901234567890" }],
    is_vararg: false, parameter_types: [0, 1, 2, 0],
    chunk: map{ instructions: [map{ op: 33 }],
        constants: [false, "text", map{ __pbck_numeric: "bigint", text: "99" },
            map{ __pbck_numeric: "rational", text: "22/7" }, 1.25], source_name: nil }
};
let rich = Plan.build_decoded(map{ format: "host-pbck-v1", version: 1,
    artifact_bytes: 321,
    chunk: map{ instructions: [map{ op: 33 }], constants: [rich_child], source_name: nil } });
let rich_bytes = Binary.encode_plan(rich);
let rich_roundtrip = Binary.decode(rich_bytes);
if Binary.encode_plan(rich_roundtrip) != rich_bytes
    or rich_roundtrip.functions[1].name != "typed"
    or rich_roundtrip.functions[1].parameter_count != 4
    or rich_roundtrip.functions[1].default_count != 4
    or rich_roundtrip.artifact_bytes != 321 {
    fail("rich metadata round trip mismatch");
}
let kinds = map{}; i = 0;
while i < len(rich_roundtrip.constant_kinds) {
    kinds[str(rich_roundtrip.constant_kinds[i])] = true; i = i + 1;
}
i = 0;
while i < len([0, 1, 2, 3, 4, 5, 7]) {
    if not map_has(kinds, str([0, 1, 2, 3, 4, 5, 7][i])) {
        fail("constant kind coverage is incomplete");
    }
    i = i + 1;
}

let tampered = []; i = 0;
while i < len(encoded) { array_push(tampered, encoded[i]); i = i + 1; }
tampered[12] = bit_xor(tampered[12], 1);
rejects(fn() { Binary.decode(tampered); }, "tampered payload accepted");

let bad_magic = []; i = 0;
while i < len(encoded) { array_push(bad_magic, encoded[i]); i = i + 1; }
bad_magic[0] = 0;
rejects(fn() { Binary.decode(bad_magic); }, "bad magic accepted");

let bad_version = []; i = 0;
while i < len(encoded) { array_push(bad_version, encoded[i]); i = i + 1; }
bad_version[4] = 2;
rejects(fn() { Binary.decode(bad_version); }, "unsupported version accepted");

let truncated = []; i = 0;
while i < len(encoded) - 1 { array_push(truncated, encoded[i]); i = i + 1; }
rejects(fn() { Binary.decode(truncated); }, "truncated asset accepted");

let trailing = []; i = 0;
while i < len(encoded) { array_push(trailing, encoded[i]); i = i + 1; }
array_push(trailing, 0);
rejects(fn() { Binary.decode(trailing); }, "trailing byte accepted");
rejects(fn() { Binary.encode_plan(original, map{ max_asset_bytes: 64 }); },
    "asset size budget ignored");
rejects(fn() { Binary.encode_plan(rich, map{ max_text_bytes: 4 }); },
    "text size budget ignored");
rejects(fn() { Binary.decode(encoded, map{ max_functions: 1 }); },
    "decode function budget ignored");
let oversized_frame = Plan.build_bytes(pbck);
oversized_frame.functions[0].max_local = 1000;
rejects(fn() { Binary.encode_plan(oversized_frame, map{ max_slots: 128 }); },
    "frame slot budget ignored");
let bad_function = Plan.build_bytes(pbck);
i = 0;
while i < len(bad_function.constant_kinds) and bad_function.constant_kinds[i] != 7 { i = i + 1; }
bad_function.constant_functions[i] = 999;
rejects(fn() { Binary.encode_plan(bad_function); },
    "out-of-range constant function accepted");

print "host_pbck_frame_binary_pass";
