// tests/semantics/signal_enrich_test.sapp — fix + enrichment for stdlib/signal.sapp
//
// FIX: emit() did not isolate handler errors (one throw aborted the rest) and
//   returned nothing — now isolates and returns the count. ENRICH: scan_signal,
//   merge_signals, distinct_signal (mirroring observable's stream operators).

let signal = import("stdlib/signal.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base subscribe/emit/unsub ────────────────────────────────────────────────────
let s = signal.new();
let hits = map{ n: 0, last: nil };
let unsub = signal.subscribe(s, fn(d) { hits.n = hits.n + 1; hits.last = d; });
eq(signal.emit(s, "a"), 1, "emit returns subscriber count"); eq(hits.last, "a", "handler got data");
unsub();
signal.emit(s, "b");
eq(hits.n, 1, "unsubscribed handler no longer fires");

// ── FIX: emit isolates handler errors ────────────────────────────────────────────
let s2 = signal.new();
let ran = map{ b: false };
signal.subscribe(s2, fn(d) { throw "boom"; });
signal.subscribe(s2, fn(d) { ran.b = true; });
signal.emit(s2, nil);
eq(ran.b, true, "second subscriber ran after first threw");

// ── ENRICH: scan_signal accumulates ──────────────────────────────────────────────
let src = signal.new();
let sums = signal.scan_signal(src, fn(acc, v) { return acc + v; }, 0);
let got = map{ vals: [] };
signal.subscribe(sums, fn(v) { array_push(got.vals, v); });
signal.emit(src, 1); signal.emit(src, 2); signal.emit(src, 3);
eq(got.vals[0], 1, "scan 1"); eq(got.vals[1], 3, "scan 1+2"); eq(got.vals[2], 6, "scan 1+2+3");

// ── ENRICH: distinct_signal drops consecutive duplicates ─────────────────────────
let src2 = signal.new();
let dgot = map{ n: 0 };
signal.subscribe(signal.distinct_signal(src2), fn(v) { dgot.n = dgot.n + 1; });
signal.emit(src2, 1); signal.emit(src2, 1); signal.emit(src2, 2); signal.emit(src2, 2);
eq(dgot.n, 2, "distinct emitted only on change");

// ── ENRICH: merge_signals forwards both sources ──────────────────────────────────
let a = signal.new();
let b = signal.new();
let merged = signal.merge_signals(a, b);
let mgot = map{ n: 0 };
signal.subscribe(merged, fn(v) { mgot.n = mgot.n + 1; });
signal.emit(a, "x"); signal.emit(b, "y");
eq(mgot.n, 2, "merge forwards from both signals");

print "signal_enrich_pass";
