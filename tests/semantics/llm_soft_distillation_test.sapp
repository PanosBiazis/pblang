let AD=import("stdlib:llm_adapters.sapp");
fn rejects(f) {return try {f();false} catch true;}
assert(not rejects(fn(){return 1;}) and rejects(fn(){throw "expected rejection";}),"rejection helper distinguishes success from failure");
let model=map{lm_head:[[0.1,-0.1],[0.2,-0.2]],lm_bias:[0.0,0.0]};
let ad=AD.lm_head_adapter(model,1,2.0,5);ad.a_matrix=[[0.3],[-0.2]];ad.b_matrix=[[0.4,-0.1]];
let hidden=[0.7,-0.5];let q=[0.25,0.75];let saved=json_stringify([model,ad,hidden,q]);
for temperature in [0.25,1,2,8] {
 let step=AD.train_soft_step(model,ad,hidden,q,0.01,temperature);let eps=0.00001;
 for kind in ["a_matrix","b_matrix"] {for row len(ad[kind]) {for col len(ad[kind][row]) {
  let plus=json_parse(json_stringify(ad));let minus=json_parse(json_stringify(ad));
  plus[kind][row][col]=plus[kind][row][col]+eps;minus[kind][row][col]=minus[kind][row][col]-eps;
  let numerical=(AD.soft_target_loss(AD.logits(model,hidden,plus),q,temperature)-AD.soft_target_loss(AD.logits(model,hidden,minus),q,temperature))/(2*eps);
  let updated=if kind=="a_matrix" {step.updated_a_matrix} else {step.updated_b_matrix};
  let analytic=(ad[kind][row][col]-updated[row][col])/0.01;let error=numerical-analytic;
  assert(error*error<0.0000000001,"temperature-scaled analytic gradient matches central finite differences");
 }}}
}
let soft=AD.train_soft_step(model,ad,hidden,[0,1]);let hard=AD.train_step(model,ad,hidden,1);
assert(json_stringify(soft.updated_a_matrix)==json_stringify(hard.updated_a_matrix)
 and json_stringify(soft.updated_b_matrix)==json_stringify(hard.updated_b_matrix),"one-hot gradients match old hard-label path");
assert(saved==json_stringify([model,ad,hidden,q]),"soft training does not mutate inputs");
assert(AD.soft_target_loss([1000000,-1000000],[0,1])==2000000,"stable extreme-logit loss without probability clipping");
assert(AD.soft_target_loss([1000000,-1000000],[1,0])==0,"zero loss with zero-probability targets");
let zero=len([]);
for target in [[],[1],[0,0],[0.4,0.4],[-1,2],[true,0],[0/zero,1],[1/zero,0]] {
 assert(rejects(fn(){AD.train_soft_step(model,ad,hidden,target);}),"invalid probability distribution rejected");
}
for temperature in [nil,true,0,0.24,8.01,1/zero,0/zero] {
 assert(rejects(fn(){AD.train_soft_step(model,ad,hidden,q,0.1,temperature);}),"temperature bounds");
}
for lr in [nil,true,0,0.251,1/zero,0/zero] {
 assert(rejects(fn(){AD.train_soft_step(model,ad,hidden,q,lr);}),"learning-rate bounds");
}
print "llm_soft_distillation_pass";
