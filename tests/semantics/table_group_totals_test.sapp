let T=import("stdlib:table_group_totals.sapp");let G=import("stdlib:table_group.sapp");let S=import("stdlib:sheet_document.sapp");let C=import("stdlib:sheet_csv.sapp");
let doc=C.decode("Team,State\nα,Open\nβ,Done\nα,Done\nα,Open\n,Open\nα ,Open");let before=S.encode(doc);
assert(T.counts(doc,0,true).cells==[["Group","Count"],["α","3"],["β","1"],["","1"],["α ","1"],["Total","6"]],"literal counts plus total");
let cross=T.cross(doc,0,1,true);assert(cross.cells==[["Row / Column","Open","Done","Total"],["α","2","1","3"],["β","0","1","1"],["","1","0","1"],["α ","1","0","1"],["Total","4","2","6"]],"exact margins and grand total");assert(C.decode(C.encode(cross)).cells==cross.cells,"CSV roundtrip");cross.cells[1][1]="changed";assert(S.encode(doc)==before,"detached result");
let collision=C.decode("a,b\nTotal,Total\nTotal [1],Total [1]\nx,x");let special=T.cross(collision,0,1,true);assert(special.cells[0][4]=="Total [2]" and special.cells[4][0]=="Total [2]" and special.cells[1][0]=="Total","computed labels do not collide with literal categories");
assert(T.counts(C.decode("id\nTotal\nTotal [1]"),0,true).cells[3][0]=="Total [2]","count label collision");
let empty=S.create(1,2);assert(T.counts(empty,0,true).cells==[["Group","Count"],["Total","0"]],"empty source explicit zero");assert(T.cross(empty,0,1,true).cells==[["Row / Column","Total"],["Total","0"]],"empty cross");assert(T.cross(empty,0,1,false).cells==[["Row / Column","","Total"],["","1","1"],["Total","1","1"]],"blank is real data");
let diagonal=T.cross(doc,0,0,true);assert(diagonal.cells[1][1]=="3" and diagonal.cells[1][2]=="0" and diagonal.cells[5][5]=="6","same-axis diagonal with margins");
let max=S.create(31,2);max.cells[0]=["Rows","Columns"];for i in range(1,31) {max.cells[i]=["row"+str(i),"col"+str(num_mod(i,6))];}
let all=T.cross(max,0,1,true);assert(len(all.cells)==32 and len(all.cells[0])==8 and all.cells[31][7]=="30","max30 by6 plus margins");assert(len(T.counts(max,0,true).cells)==32,"max30 count groups");
// Independent source scan checks each row/column margin and the grand total.
for r in range(1,31) {let count=0;for i in range(1,len(max.cells)) {if max.cells[i][0]==all.cells[r][0] {count=count+1;}}assert(all.cells[r][7]==str(count),"row margin oracle");}
for c in range(1,7) {let count=0;for i in range(1,len(max.cells)) {if max.cells[i][1]==all.cells[0][c] {count=count+1;}}assert(all.cells[31][c]==str(count),"column margin oracle");}
let overflow=S.copy(max);array_push(overflow.cells,["row31","col0"]);assert(len(G.cross(overflow,0,1,true).cells)==32,"base report still fits");assert((try T.cross(overflow,0,1,true) catch nil)==nil and (try T.counts(overflow,0,true) catch nil)==nil,"totals reject row overflow");overflow=S.copy(max);overflow.cells[1][1]="seventh";assert((try T.cross(overflow,0,1,true) catch nil)==nil,"totals reject column overflow");
let bytes=S.create(31,2);bytes.cells[0]=["R","C"];for i in range(1,31) {bytes.cells[i]=[str_repeat("x",253)+(if i<10 {"00"} else {"0"})+str(i),if i<=5 {str_repeat("c",59)+str(i)} else {""}];}let bytes_before=S.encode(bytes);assert(G.cross(bytes,0,1,true).format==S.FORMAT,"base report below byte budget");assert((try T.cross(bytes,0,1,true) catch nil)==nil and S.encode(bytes)==bytes_before,"totals reject output byte overflow without truncation");
for index in [-1,2,0.5,"0",nil] {assert((try T.counts(doc,index,true) catch nil)==nil,"invalid axis");}assert((try T.cross(doc,0,1,"header") catch nil)==nil,"header bool");
let literal=C.decode("x,y\n=1+1,2\n__proto__,2");assert(T.counts(literal,0,true).cells[3][1]=="2","formulas and special keys are literal categories");assert(S.encode(doc)==before,"source retained");print "table_group_totals_pass";
