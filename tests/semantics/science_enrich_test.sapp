// tests/semantics/science_enrich_test.sapp — enrichment for stdlib/science.sapp
// Adds gravitational/coulomb force, escape velocity, E=mc^2, lorentz factor,
// signal rms, and polygon area (shoelace).

let sci = import("stdlib/science.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn near_rel(a, b, m) { if num_abs(a - b) / num_abs(b) > 0.000001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base still works ─────────────────────────────────────────────────────────────
near(sci.force(2, 3), 6, "force"); near(sci.kinetic_energy(2, 3), 9, "kinetic_energy");

// ── ENRICH: gravitational + coulomb force ────────────────────────────────────────
near_rel(sci.gravitational_force(1, 1, 1), sci.G, "gravitational_force(1,1,1) = G");
let ev = sci.escape_velocity(5.972 * (10 ** 24), 6.371 * (10 ** 6));
if num_abs(ev - 11186) > 5 { fail("Earth escape velocity ~11186 m/s got=" + str(ev)); }

// ── ENRICH: E = mc^2 ─────────────────────────────────────────────────────────────
near_rel(sci.energy_mass(1), sci.C * sci.C, "energy_mass(1) = c^2");

// ── ENRICH: lorentz factor ───────────────────────────────────────────────────────
near(sci.lorentz_factor(0), 1, "lorentz at rest = 1");
near(sci.lorentz_factor(0.6 * sci.C), 1.25, "lorentz at 0.6c = 1.25");

// ── ENRICH: signal rms ───────────────────────────────────────────────────────────
near(sci.rms([3, 4]), num_sqrt(12.5), "rms of [3,4]");

// ── ENRICH: polygon area (shoelace) ──────────────────────────────────────────────
near(sci.polygon_area([[0, 0], [1, 0], [1, 1], [0, 1]]), 1, "unit square area = 1");
near(sci.polygon_area([[0, 0], [4, 0], [0, 3]]), 6, "right triangle area = 6");

print "science_enrich_pass";
