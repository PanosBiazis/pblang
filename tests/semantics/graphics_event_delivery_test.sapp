let G=import("stdlib:graphics.sapp");
// Run normally, and also with PBLANG_GRAPHICS_IDLE_PUMP_MS=1000 supplied
// by the caller. The runtime deliberately forbids process environment mutation.
let slowPump=(try env_get("PBLANG_GRAPHICS_IDLE_PUMP_MS") catch nil)=="1000";
fn probe(mode,resizes=false) {
    let state=map{updates:0,seen:[],graphics_stop:false};
    let io=map{polls:0,presents:0,draws:0,closed:0,width:320,sample:[]};
    let win=map{isOpen:fn(){return io.closed==0;},size:fn(){return map{w:io.width,h:200};},
        close:fn(){io.closed=io.closed+1;},
        present:fn(){io.presents=io.presents+1;if io.presents==1 {
            if resizes {io.width=640;io.sample=[map{type:"resize",w:640,h:200}];}
            else {io.sample=[map{type:"keydown",key:"A"}];}
        } else {io.sample=[];}},
        pollEvents:fn(){io.polls=io.polls+1;return io.sample;}};
    if mode!=nil {win.event_poll_mode=mode;}
    G.run(win,state,fn(current,events){
        current.updates=current.updates+1;
        for event in events {push(current.seen,event);}
        if current.updates>=6 {current.graphics_stop=true;}
        return current.updates==1;
    },fn(current,canvas){io.draws=io.draws+1;},1000);
    return map{state:state,io:io};
}
let snapshot=probe("present-snapshot");
assert(len(snapshot.state.seen)==1 and snapshot.state.seen[0].key=="A","retained key transition delivered once while idle");
assert(snapshot.io.draws==1 and snapshot.io.presents==(if slowPump {1} else {5}) and snapshot.io.closed==1,"idle rendering skipped and window released");
for mode in [nil,"drain","custom"] {
    let legacy=probe(mode);
    assert(len(legacy.state.seen)==5 and legacy.io.polls==6,"unmarked and queue adapters retain per-iteration polling");
}
let resized=probe("present-snapshot",true);
assert(resized.io.draws==2 and resized.io.presents>=2 and resized.io.width==640,"retained resize cannot restart settling indefinitely");
assert(resized.io.closed==1,"resized window released once");
print "graphics_event_delivery_pass";
