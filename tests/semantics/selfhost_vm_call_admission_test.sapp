let VM = import("stdlib:compiler/vm.sapp");
fn expect(ok, label) { if not ok { throw "FAIL vm-call-admission: " + label; } }
fn closure(arity) {
    return map{ __fn: map{ arity: arity, min_arity: arity,
        chunk: map{ constants: ["executed", 99], instructions: [
            map{op:0,operand:1}, map{op:13,operand:0}, map{op:0,operand:1}, map{op:19,operand:0}
        ] } }, __upvalues: [] };
}
fn invocation(callee, count, provided) {
    let constants = [callee, "known", 2, 3, 4];
    let instructions = [map{op:0,operand:0}];
    for i provided { push(instructions, map{op:0,operand:i+1}); }
    push(instructions, map{op:18,operand:count});
    push(instructions, map{op:12,operand:0});
    return map{constants:constants,instructions:instructions};
}
fn rejects(chunk) {
    for bounded in [false,true] {
        let globals = map{};
        let result = try map{ ok:true, value: if bounded { VM.run_seeded_bounded(chunk, globals) } else { VM.run_seeded(chunk, globals) } } catch map{ok:false};
        expect(not result.ok and not map_has(globals,"executed"), "invalid call rejects before body effects");
    }
}
for arg in [nil,true,"1",[],map{},-1,-0.5,0.5,1.5,2.5,1000000000] {
    rejects(invocation(closure(0), arg, 3));
}
rejects(map{constants:[],instructions:[map{op:18,operand:0}]});
for count in [1,2,3] { rejects(invocation(closure(count),count,count-1)); }
for count in [0,1,2,3] {
    // Both too many and too few declared parameters reject before body execution.
    rejects(invocation(closure(count+1),count,count));
    if count > 0 { rejects(invocation(closure(count-1),count,count)); }
    let good = VM.run(invocation(closure(count),count,count));
    expect(good.output == [99] and good.globals.executed == 99, "pure closure remains callable");
    let missing = map{__fn:map{arity:count,min_arity:count},__upvalues:[]};
    rejects(invocation(missing,count,count));
}
// Builtin descriptors win even if user code also installs a closure tag.
for count in [1,2,3] {
    let dual = closure(count); dual.__bi = "import";
    let globals = map{__import_cache__:map{known:88}};
    let result = VM.run_seeded_bounded(invocation(dual,count,count),globals);
    expect(result.output == [88] and not map_has(globals,"executed"), "dual-tag import keeps builtin precedence");
}
let zero_dual = closure(0); zero_dual.__bi = "import";
rejects(invocation(zero_dual,0,0));
let print_dual = closure(0); print_dual.__bi = "print";
let printed = VM.run(invocation(print_dual,0,0));
expect(printed.output == [nil] and not map_has(printed.globals,"executed"), "zero-arg builtin not converted to closure");
let raw = closure(0).__fn;
expect(VM.run(invocation(raw,0,0)).output == [99], "raw-function fallback retained");
// Small calls retain the closure's lexical namespace and only supply a missing cache.
for count in [0,1,2,3] {
    for bounded in [false,true] {
        for existing in [false,true] {
            let lexical = map{marker:73};
            if existing { lexical.__import_cache__ = map{known:17}; }
            let caller = map{marker:12,__import_cache__:map{known:88}};
            let callee = closure(count);
            callee.__globals = lexical;
            callee.__fn.chunk = map{constants:["marker"],instructions:[
                map{op:14,operand:0},map{op:19,operand:0}
            ]};
            let chunk = invocation(callee,count,count);
            let result = if bounded { VM.run_seeded_bounded(chunk,caller) } else { VM.run_seeded(chunk,caller) };
            expect(result.output == [73], "lexical globals selected");
            expect(lexical.__import_cache__.known == (if existing {17} else {88}), "cache propagated without overwrite");
            expect(caller.marker == 12, "caller namespace unchanged");
        }
    }
}
print "selfhost_vm_call_admission_pass";
