// tests/semantics/quantum_ecc_test.sapp
import "stdlib:quantum_sim.sapp";

// Encode 1, flip one bit (error), decode → still 1
let enc1 = quantum_sim.repetition_encode(1);
enc1[1] = 0; // simulate single-bit error
let dec1 = quantum_sim.repetition_decode(enc1);
if dec1 != 1 { throw "FAIL repetition decode 1"; }

// Encode 0, no error → still 0
let enc0 = quantum_sim.repetition_encode(0);
let dec0 = quantum_sim.repetition_decode(enc0);
if dec0 != 0 { throw "FAIL repetition decode 0"; }

print "quantum_ecc_test: pass";

