// Regression: lazy pbAI training must never mutate its locked bundled model.
let AI = import("stdlib:pbai.sapp");
let cache = AI.model_cache_path();
let before = fs_read("stdlib/pbai_model.json");

let intent = AI.classify("find the bugs and errors here");
assert(intent == 1, "pbAI classifier remains functional");
assert(cache != "stdlib/pbai_model.json", "writable cache is separate from bundled model");
assert(not str_contains(cache, "/stdlib/"), "writable cache is outside stdlib");
assert(fs_read("stdlib/pbai_model.json") == before, "bundled model remains read-only");
assert(fs_exists(cache), "trained model is persisted in the user cache");
