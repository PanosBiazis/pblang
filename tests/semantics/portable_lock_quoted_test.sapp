let Lock=import("stdlib:portable_lock.sapp");
let digest=str_repeat("a",64);
for declaration in [
    "demo = { path = \"../lib,a#b=c\", paths = [\"one,two\", \"#three\"] } # comment",
    "demo = { paths = ['one,two', '#three'], path = '../lib,a#b=c' } # comment",
    "\"demo\" = { \"path\" = \"../lib,a#b=c\" }",
    "'demo' = { 'path' = '../lib,a#b=c', meta = { label = 'x,y' } }"
] {
    let manifest="[dependencies]\n"+declaration+"\n";
    let paths=Lock.manifest_paths(manifest);
    assert(paths.demo=="../lib,a#b=c","quoted punctuation belongs to path");
    let lock="content_hash_algorithm = \"pblang-package-tree-v2\"\n[dependencies.demo]\npath = \"/workspace/lib,a#b=c\"\nsha256 = \""+digest+"\"\n";
    let value=Lock.normalize_text(manifest,lock,"/workspace/project");
    assert(value.rewritten==1 and str_contains(value.text,"path = \"../lib,a#b=c\""),"relative path published");
    assert(str_contains(value.text,digest) and not str_contains(value.text,"/workspace/"),"digest preserved and host root removed");
    assert(Lock.normalize_text(manifest,value.text,"/workspace/project").text==value.text,"idempotent normalization");
    assert(try {Lock.normalize_text(manifest,str_replace_all(lock,"/workspace/lib,a#b=c","/different/root"),"/workspace/project");false} catch true,"mismatch still rejected");
}
let escaped=Lock.manifest_paths("[dependencies]\ndemo = { path = \"../lib\\\"a,b#c\" }\n");
assert(escaped.demo=="../lib\"a,b#c","escaped quote does not end basic string");
for spec in [
    "{ path = '../ok', 'path' = '../other' }",
    "{ 'path' = '/absolute/root' }",
    "{ path = '../unterminated }",
    "{ path = '../ok', paths = ['broken' }",
    "{ path = '../ok', paths = ] }",
    "{ path = '../ok', paths = ['broken'} }"
] {
    assert(try {Lock.manifest_paths("[dependencies]\ndemo = "+spec+"\n");false} catch true,"malformed or unsafe dependency rejected");
}
print "portable_lock_quoted_pass";
