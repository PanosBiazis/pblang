// tests/semantics/nn_graph_test.sapp — a free-form GRAPH network: nodes joined by
// MULTIPLE parallel bonds (multi-channel connections), full multi-directed connectivity,
// dynamic node birth/kill, and per-node choices (activation + which input it listens to).

let G = import("stdlib/nn_graph.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── build nodes ───────────────────────────────────────────────────────────────────
let g = G.graph_new();
eq(G.node_count(g), 0, "empty graph");
let a = G.add_node(g, 0, "linear");
let b = G.add_node(g, 0, "linear");
eq(a, 0, "first node id"); eq(b, 1, "second node id");
eq(G.node_count(g), 2, "two nodes");

// ── MULTI-BOND: several parallel connections between the same pair ─────────────────
G.add_bond(g, 0, 1, 2);
G.add_bond(g, 0, 1, 3);                       // a second bond on the same pair
eq(G.bond_count(g, 0, 1), 2, "two parallel bonds (multi-channel)");
approx(G.bond_strength(g, 0, 1), 5, "bond strength = sum of parallel weights");
// strengthen the bond (reinforce every channel)
G.strengthen(g, 0, 1, 1);
approx(G.bond_strength(g, 0, 1), 7, "strengthen adds to each channel (2+3 + 2*1)");

// ── forward sums over ALL parallel bonds ──────────────────────────────────────────
let v = G.forward(g, [1], 1);                 // node0 clamped to 1; node1 = 3 + 4 = 7
approx(v[1], 7, "forward aggregates multi-bond communication");

// ── fully connect: every node to every other (multi-directed) ─────────────────────
let f = G.graph_new();
G.add_node(f, 0, "linear"); G.add_node(f, 0, "linear"); G.add_node(f, 0, "linear");
G.fully_connect(f, 1);
eq(G.bond_total(f), 6, "K3 directed: n*(n-1) bonds");

// ── node BIRTH: a new node wired to all existing nodes, both directions ────────────
let nb = G.birth_node(f, 0, "linear", 1);
eq(G.node_count(f), 4, "birth adds a node");
eq(nb, 3, "born node id");
if G.bond_count(f, 3, 0) < 1 { fail("born node connects outward to all"); }
if G.bond_count(f, 0, 3) < 1 { fail("born node connects inward from all"); }

// ── node KILL: remove a node and every bond touching it; reindex the rest ──────────
let before = G.node_count(f);
G.kill_node(f, 1);
eq(G.node_count(f), before - 1, "kill removes the node");
// no surviving bond references the killed id, and indices stay in range
let bb = 0;
while bb < G.bond_total(f) {
    let e = G.bond_at(f, bb);
    if e.from >= G.node_count(f) or e.to >= G.node_count(f) { fail("kill must reindex bonds"); }
    bb = bb + 1;
}

// ── CHOICES: each node chooses its activation + which input dominates ──────────────
let c = G.graph_new();
G.add_node(c, 0, "linear"); G.add_node(c, 0, "linear"); G.add_node(c, 0, "relu");
G.node_choice(c, 2, "tanh");
eq(G.get_choice(c, 2), "tanh", "node activation choice is set");
G.add_bond(c, 0, 2, 1);
G.add_bond(c, 1, 2, 5);
eq(G.dominant_input(c, 2), 1, "node listens to its strongest incoming bond");

// relu choice clamps negatives
let r = G.graph_new();
G.add_node(r, 0, "linear"); G.add_node(r, 0, "relu");
G.add_bond(r, 0, 1, 0 - 2);
let rv = G.forward(r, [1], 1);
approx(rv[1], 0, "relu node clamps negative input to 0");

print "nn_graph_pass";
