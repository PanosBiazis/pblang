// tests/semantics/flate_test.sapp — pure-pblang DEFLATE/gzip/zlib (RFC 1950/1951/1952).
//
// Reference vectors were produced with CPython's zlib/gzip (mtime=0), so passing
// gzip_decode/zlib_decode here proves interop with real-world compressors.

let F = import("stdlib:flate.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── crc32 (IEEE 802.3, reflected) ────────────────────────────────────────────
eq(F.crc32([]), 0, "crc32 empty");
eq(F.crc32(str_to_bytes("123456789")), 3421780262, "crc32 check vector 0xCBF43926");
eq(F.crc32("hello"), 907060870, "crc32 accepts string input");
eq(F.crc32(str_to_bytes("The quick brown fox jumps over the lazy dog")), 1095738169, "crc32 fox");
eq(F.crc32_range(str_to_bytes("x123456789y"), 1, 9), 3421780262,
   "crc32 range avoids copying a bounded subarray");
let bad_crc_range = try map{
    ok: true, value: F.crc32_range([1, 2, 3], 2, 2)
} catch map{ ok: false };
if bad_crc_range.ok { fail("crc32 range must reject out-of-bounds input"); }

// ── adler32 (RFC 1950) ───────────────────────────────────────────────────────
eq(F.adler32(str_to_bytes("Wikipedia")), 300286872, "adler32 Wikipedia");
eq(F.adler32("hello"), 103547413, "adler32 hello");
eq(F.adler32([]), 1, "adler32 empty is 1");
let adler_large = [];
let adler_i = 0;
while adler_i < 12000 {
    array_push(adler_large, (adler_i * 17 + 3) % 256);
    adler_i = adler_i + 1;
}
eq(F.adler32(adler_large), 472013194,
   "adler32 block reduction matches independent zlib reference");

// ── gzip_decode: real gzip output (fixed-Huffman + LZ77 matches) ─────────────
let gz = [31, 139, 8, 0, 0, 0, 0, 0, 2, 3, 43, 72, 202, 73, 204, 75, 87, 40, 64, 161,
          50, 243, 210, 114, 18, 75, 82, 21, 74, 82, 139, 75, 20, 12, 141, 140, 77, 76,
          185, 10, 168, 172, 14, 0, 10, 160, 245, 59, 120, 0, 0, 0];
let want = "";
let i = 0;
while i < 3 { want = want + "pblang pblang pblang inflate test 12345\n"; i = i + 1; }
eq(bytes_to_str(F.gzip_decode(gz)), want, "gzip_decode fixed-huffman blob");

// ── zlib_decode: dynamic-Huffman block ───────────────────────────────────────
let zdyn = [120, 218, 13, 202, 77, 14, 130, 64, 12, 6, 208, 171, 124, 68, 48, 74, 88,
            224, 63, 238, 56, 9, 73, 51, 83, 152, 38, 82, 76, 167, 104, 184, 189, 190,
            245, 139, 155, 210, 44, 1, 105, 29, 199, 153, 20, 202, 28, 51, 8, 175, 69,
            39, 182, 6, 31, 50, 225, 8, 209, 247, 234, 200, 110, 162, 19, 190, 226, 9,
            255, 188, 33, 74, 118, 209, 224, 8, 137, 140, 130, 179, 101, 180, 167, 243,
            229, 122, 187, 63, 186, 103, 209, 239, 202, 106, 216, 215, 135, 227, 15,
            130, 65, 34, 124];
eq(bytes_to_str(F.zlib_decode(zdyn)),
   "dynamic huffman needs a longer, varied input string with many distinct characters 0123456789!@#$%^&*()",
   "zlib_decode dynamic-huffman block");

// ── zlib_decode: stored (uncompressed) block ─────────────────────────────────
eq(bytes_to_str(F.zlib_decode([120, 1, 1, 3, 0, 252, 255, 97, 98, 99, 2, 77, 1, 39])),
   "abc", "zlib_decode stored block");

// ── deflate → inflate round trip ─────────────────────────────────────────────
let msg = "self-hosted deflate round trip! self-hosted deflate round trip! 0123456789 the end.";
let raw = F.deflate(str_to_bytes(msg));
eq(bytes_to_str(F.inflate(raw)), msg, "deflate->inflate round trip");

// binary round trip: all 256 byte values
let allb = [];
i = 0;
while i < 256 { array_push(allb, i); i = i + 1; }
let rawb = F.deflate(allb);
let backb = F.inflate(rawb);
eq(len(backb), 256, "binary round trip length");
i = 0;
while i < 256 { if backb[i] != i { fail("binary round trip byte " + str(i)); } i = i + 1; }

// ── gzip encode/decode round trip + header ───────────────────────────────────
let blob = F.gzip_encode(str_to_bytes(msg));
eq(blob[0], 31, "gzip magic byte 1");
eq(blob[1], 139, "gzip magic byte 2");
eq(blob[2], 8, "gzip method deflate");
eq(bytes_to_str(F.gzip_decode(blob)), msg, "gzip encode/decode round trip");
eq(bytes_to_str(F.gzip_decode(blob, len(str_to_bytes(msg)), true)), msg,
   "exact gzip decode accepts one complete member");
let gzip_trailing = slice(blob, 0, len(blob)); array_push(gzip_trailing, 0);
let gzip_exact_trailing = try map{
    ok: true, value: F.gzip_decode(gzip_trailing, len(str_to_bytes(msg)), true)
} catch map{ ok: false };
if gzip_exact_trailing.ok { fail("exact gzip decode must reject trailing data"); }
let reserved = slice(blob, 0, len(blob)); reserved[3] = 32;
let reserved_result = try map{ ok: true, value: F.gzip_decode(reserved) } catch map{ ok: false };
if reserved_result.ok { fail("gzip decode must reject reserved header flags"); }

// Optional filename/comment fields must terminate and FHCRC must verify.
let named = [31, 139, 8, 10, 0, 0, 0, 0, 0, 255, 120, 0];
let header_crc = bit_and(F.crc32_range(named, 0, len(named)), 65535);
array_push(named, bit_and(header_crc, 255)); array_push(named, bit_and(bit_shr(header_crc, 8), 255));
let named_body = F.deflate(str_to_bytes("x"));
for named_i len(named_body) { array_push(named, named_body[named_i]); }
let named_crc = F.crc32(str_to_bytes("x"));
for shift len([0, 8, 16, 24]) { array_push(named, bit_and(bit_shr(named_crc, [0, 8, 16, 24][shift]), 255)); }
array_push(named, 1); array_push(named, 0); array_push(named, 0); array_push(named, 0);
eq(bytes_to_str(F.gzip_decode(named, 1, true)), "x", "gzip FHCRC is verified");
let bad_header_crc = slice(named, 0, len(named)); bad_header_crc[12] = bit_xor(bad_header_crc[12], 1);
let fhcrc_result = try map{ ok: true, value: F.gzip_decode(bad_header_crc) } catch map{ ok: false };
if fhcrc_result.ok { fail("gzip decode must reject invalid FHCRC"); }

// corrupted CRC must be rejected
let bad = [];
i = 0;
while i < len(blob) { array_push(bad, blob[i]); i = i + 1; }
bad[len(bad) - 5] = bit_xor(bad[len(bad) - 5], 255);
let r = try map{ ok: true, v: F.gzip_decode(bad) } catch map{ ok: false };
if r.ok { fail("gzip_decode must reject corrupted CRC"); }

// ── zlib encode/decode round trip + adler check ──────────────────────────────
let zblob = F.zlib_encode(str_to_bytes(msg));
eq(bytes_to_str(F.zlib_decode(zblob)), msg, "zlib encode/decode round trip");
eq(bytes_to_str(F.zlib_decode(zblob, len(str_to_bytes(msg)), true)), msg,
   "exact zlib decode accepts one complete stream");
let ztrailing = slice(zblob, 0, len(zblob));
array_push(ztrailing, 0);
let exact_trailing = try map{
    ok: true, value: F.zlib_decode(ztrailing, len(str_to_bytes(msg)), true)
} catch map{ ok: false };
if exact_trailing.ok { fail("exact zlib decode must reject trailing data"); }
let zbad = [];
i = 0;
while i < len(zblob) { array_push(zbad, zblob[i]); i = i + 1; }
zbad[len(zbad) - 1] = bit_xor(zbad[len(zbad) - 1], 255);
let r2 = try map{ ok: true, v: F.zlib_decode(zbad) } catch map{ ok: false };
if r2.ok { fail("zlib_decode must reject corrupted adler32"); }

// ── decompression bomb guard: inflate(data, max_out) ─────────────────────────
let r3 = try map{ ok: true, v: F.inflate(raw, 5) } catch map{ ok: false };
if r3.ok { fail("inflate must honor max_out limit"); }
// gzip_decode with a limit too
let r4 = try map{ ok: true, v: F.gzip_decode(blob, 5) } catch map{ ok: false };
if r4.ok { fail("gzip_decode must honor max_out limit"); }

// truncated/garbage input must error, not crash or hang
let r5 = try map{ ok: true, v: F.inflate([7]) } catch map{ ok: false };
if r5.ok { fail("inflate must reject garbage"); }
let r6 = try map{ ok: true, v: F.gzip_decode([31, 139, 8]) } catch map{ ok: false };
if r6.ok { fail("gzip_decode must reject truncated header"); }

print "flate_pass";
