let C=import("stdlib:divider_corners.sapp");let L=import("stdlib:divider_load.sapp");
fn close(a,b){assert(num_abs(a-b)<=0.00000001*num_max(1,num_abs(b)),"independent voltage oracle");}
let cases=0;
for vin in [-1000,-5,0,5,1000]{for top in [10,1000,500000]{for bottom in [10,2000,500000]{for load in [10,3000,500000]{for ps in [[0,0,0],[1,5,20],[20,0,5]]{
 let r=C.analyze(vin,top,bottom,load,ps[0],ps[1],ps[2]);assert(len(r.rows)==8,"exactly eight rows");let low=1001;let high= -1001;let k=0;
 for t in [1-ps[0]/100,1+ps[0]/100]{for b in [1-ps[1]/100,1+ps[1]/100]{for l in [1-ps[2]/100,1+ps[2]/100]{
 let a=top*t;let c=bottom*b;let d=load*l;let effective=c*d/(c+d);let expected=vin*effective/(a+effective);let row=r.rows[k];close(row.result.loaded_vout,expected);assert(row.top_ohms==a and row.bottom_ohms==c and row.load_ohms==d,"row provenance");low=num_min(low,expected);high=num_max(high,expected);k=k+1;
 }}}
 close(r.minimum_vout,low);close(r.maximum_vout,high);close(r.rows[r.minimum_corner].result.loaded_vout,low);close(r.rows[r.maximum_corner].result.loaded_vout,high);close(r.nominal.loaded_vout,L.analyze(vin,top,bottom,load).loaded_vout);
 // Interior 3x3x3 lattice confirms the reported voltage interval also contains non-corner inputs.
 for t in [-0.5,0,0.5]{for b in [-0.5,0,0.5]{for l in [-0.5,0,0.5]{let a=top*(1+t*ps[0]/100);let c=bottom*(1+b*ps[1]/100);let d=load*(1+l*ps[2]/100);let x=vin/(1+a/c+a/d);assert(x>=low-0.00000001 and x<=high+0.00000001,"interior containment");}}}
 cases=cases+1;
}}}}}
assert(cases==405,"case count");let zero=C.analyze(0,1,1000000,1);assert(zero.minimum_corner==0 and zero.maximum_corner==0,"stable first tie");
let exact=C.analyze(6,1000,1000,1000);close(exact.minimum_vout,2);close(exact.maximum_vout,2);exact.rows[0].corner[0]=9;assert(exact.rows[1].corner[0]==0,"independent row arrays");
for a in [[1001,1000,1000,1000,0,0,0],[5,1,1000,1000,5,0,0],[5,1000,1000000,1000,0,5,0],[5,1000,1000,1,0,0,5],[5,1000,1000,1000000,0,0,5],[5,1000,1000,1000,21,0,0],[5,1000,1000,1000,0,-1,0],[5,1000,1000,1000,0,0,nil],[true,1,1,1,0,0,0],[5,"1",1,1,0,0,0]] {assert((try C.analyze(a[0],a[1],a[2],a[3],a[4],a[5],a[6]) catch nil)==nil,"invalid domain");}
let tokens=["-5","1e3","2000","3000","1","5","20"];let before=json_stringify(tokens);close(C.from_tokens(tokens).nominal.loaded_vout,-5/(1+0.5+1/3));assert(json_stringify(tokens)==before,"tokens unchanged");
for bad in [nil,[],["5","1","1","1","0","0"],["NaN","1","1","1","0","0","0"],["5junk","1","1","1","0","0","0"],[" 5","1","1","1","0","0","0"],["1e-999","1","1","1","0","0","0"],["5",1,"1","1","0","0","0"]] {assert((try C.from_tokens(bad) catch nil)==nil,"strict tokens");}
print "divider_corners_pass: 405 cases, 3240 corners, 10935 interior points";
