// tests/semantics/doc_export_test.sapp — pblang-native document exporter backend.

let D = import("stdlib/doc_export.sapp");

fn fail(m) { throw "FAIL " + m; }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : <<" + s + ">>"); } }

let blocks = [
    map{ kind: "title", text: "My Title" },
    map{ kind: "h2", text: "A Section" },
    map{ kind: "p", text: "Some body text." },
    map{ kind: "img", text: "alt words", src: "pic.png" },
    map{ kind: "hr" },
];

// ── Markdown ──────────────────────────────────────────────────────────────────────
let md = D.to_markdown(blocks);
has(md, "# My Title", "md title -> h1");
has(md, "## A Section", "md h2");
has(md, "Some body text.", "md paragraph");
has(md, "![alt words](pic.png)", "md image");
has(md, "---", "md hr");

// ── plain text ──────────────────────────────────────────────────────────────────────
let txt = D.to_text(blocks);
has(txt, "My Title", "text title");
has(txt, "Some body text.", "text body");
has(txt, "alt words", "text image alt");

// ── HTML (escaped, via html.sapp) ────────────────────────────────────────────────
let html = D.to_html(blocks);
has(html, "<h1>My Title</h1>", "html title");
has(html, "<h2>A Section</h2>", "html h2");
has(html, "<p>Some body text.</p>", "html para");
has(html, "<hr", "html hr");
// HTML special chars in content are escaped
let esc = D.to_html([map{ kind: "p", text: "a < b & c" }]);
has(esc, "&lt;", "html escapes <");
has(esc, "&amp;", "html escapes &");

print "doc_export_pass";
