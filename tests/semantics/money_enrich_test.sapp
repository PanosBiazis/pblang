// tests/semantics/money_enrich_test.sapp — enrichment for stdlib/money.sapp
// Comparison + sign over EXACT decimal arithmetic.

let M = import("stdlib/money.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── exact compare (no float drift): 0.10 + 0.20 == 0.30 ───────────────────────────
eq(M.compare(M.add("0.10", "0.20"), "0.30"), 0, "0.10+0.20 == 0.30 exactly");
if not M.eq(M.add("0.10", "0.20"), "0.30") { fail("eq exact"); }
if not M.lt("1.00", "2.00") { fail("1 < 2"); }
if M.gt("1.00", "2.00") { fail("1 not > 2"); }
if not M.gte("2.00", "2.00") { fail("2 >= 2"); }
if not M.lte("2.00", "2.00") { fail("2 <= 2"); }

// ── sign predicates ─────────────────────────────────────────────────────────────────
if not M.is_zero("0") { fail("0 is zero"); }
if not M.is_zero("0.00") { fail("0.00 is zero"); }
if M.is_zero("0.01") { fail("0.01 not zero"); }
if not M.is_negative("-5") { fail("-5 negative"); }
if not M.is_positive("5") { fail("5 positive"); }
if M.is_negative("5") { fail("5 not negative"); }

// ── negate / abs / min / max (compare results exactly) ────────────────────────────
eq(M.compare(M.negate("5"), "-5"), 0, "negate 5 == -5");
eq(M.compare(M.abs("-5"), "5"), 0, "abs(-5) == 5");
eq(M.compare(M.abs("5"), "5"), 0, "abs(5) == 5");
eq(M.compare(M.min("3", "7"), "3"), 0, "min");
eq(M.compare(M.max("3", "7"), "7"), 0, "max");

print "money_enrich_pass";
