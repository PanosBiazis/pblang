// tests/semantics/timeseries_stdlib_test.sapp
// Time-series toolkit: smoothing, differencing, autocorrelation, EWMA volatility.
let ts = import("stdlib:timeseries.sapp");

fn _close(a, b, eps) { let d = a - b; if d < 0 { d = 0 - d; } return d <= eps; }
fn _ck(name, a, b, eps) {
    if _close(a, b, eps) == false { throw "FAIL " + name + ": expected ~" + str(b) + " got " + str(a); }
}

// --- simple moving average ---
let s = ts.sma([1, 2, 3, 4, 5], 3);
if len(s) != 3 { throw "FAIL sma length: " + str(len(s)); }
_ck("sma[0]", s[0], 2, 0.0000001);
_ck("sma[1]", s[1], 3, 0.0000001);
_ck("sma[2]", s[2], 4, 0.0000001);

// --- exponential moving average ---
let e = ts.ema([2, 4], 0.5);
if len(e) != 2 { throw "FAIL ema length"; }
_ck("ema[0] seeds with data[0]", e[0], 2, 0.0000001);
_ck("ema[1]", e[1], 3, 0.0000001);   // 0.5*4 + 0.5*2
let ec = ts.ema([1, 1, 1, 1], 0.5);
_ck("ema constant stays constant", ec[3], 1, 0.0000001);

// --- first differences ---
let d = ts.diff([1, 3, 6, 10]);
if len(d) != 3 { throw "FAIL diff length"; }
_ck("diff[0]", d[0], 2, 0.0000001);
_ck("diff[2]", d[2], 4, 0.0000001);

// --- autocorrelation ---
_ck("acf lag 0 = 1", ts.autocorr([1, 2, 3, 4, 5], 0), 1, 0.0000001);
_ck("acf lag 1", ts.autocorr([1, 2, 3, 4, 5], 1), 0.4, 0.0000001);

// --- rolling standard deviation (sample) ---
let rs = ts.rolling_std([2, 4, 6], 2);
if len(rs) != 2 { throw "FAIL rolling_std length"; }
_ck("rolling_std[0]", rs[0], 1.4142136, 0.000001);
_ck("rolling_std[1]", rs[1], 1.4142136, 0.000001);

// --- EWMA volatility (RiskMetrics): constant returns -> constant vol ---
let vol = ts.ewma_vol([0.1, 0.1, 0.1, 0.1], 0.94);
_ck("ewma_vol constant", vol[3], 0.1, 0.0000001);

print "timeseries_stdlib_pass";
