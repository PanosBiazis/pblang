let DIST = import("stdlib:dist.sapp");

fn fail(message) { throw "FAIL dist_path_isolation: " + message; }

if platform() == "linux" {
    let DIRFS = import("stdlib:linux_dirfs.sapp");
    let token = str_slice(sha256(str(now_ms()) + str(random_bytes(16))), 0, 20);
    let root = "/tmp/pblang-dist-path-" + token;
    let marker = root + "/ambient-helper-executed";
    let probe = root + "/probe.sapp";
    let output = root + "/artifact";
    let source = root + "/source.sapp";
    let c_output = root + "/source.c";
    fs_mkdirs(root);

    let helper = "#!/bin/sh\nprintf executed > \"" + marker + "\"\nexit 97\n";
    let poisoned = ["which", "uname", "cc", "pblang"];
    for name in poisoned {
        fs_write(root + "/" + name, helper);
        let mode = proc_spawn_wait("/bin/chmod", ["700", root + "/" + name]);
        if mode.exit_code != 0 { fail("cannot prepare PATH poison fixture"); }
    }

    let repository = cwd();
    let runtime = path_join(repository, "target/release/pblang");
    if not fs_exists(runtime) { fail("verified test runtime is unavailable"); }
    fs_write(source, "print 19;");
    let script = "let D=import(\"" + path_join(repository, "stdlib/dist.sapp") + "\");\n"
        + "let B=import(\"" + path_join(repository, "stdlib/build.sapp") + "\");\n"
        + "if B.host_arch()!=\"x86_64\" and B.host_arch()!=\"aarch64\" { throw \"arch\"; }\n"
        + "let t=D.transpile(\"" + source + "\",\"" + c_output + "\");\n"
        + "if not t.ok { throw \"transpile\"; }\n"
        + "let r=D.native_source(\"print 17;\",\"" + output
        + "\",D.default_opts(),nil);\n"
        + "if not r.ok { throw \"build\"; }\n";
    fs_write(probe, script);
    let child = proc_spawn_wait("/usr/bin/env",
        ["PATH=" + root, "PBLANG_BIN=pblang", runtime, "run", probe, "--allow-all"]);
    if child.exit_code != 0 or fs_exists(marker) or not fs_exists(output)
        or not fs_exists(c_output) {
        fail("ambient PATH helper executed or fixed-tool build failed");
    }

    {
        let admitted = DIST.c99_source_admission(str_repeat("x", 10485760));
        if not admitted.ok or admitted.bytes != 10485760 or admitted.limit != 10485760 {
            fail("exact C99 source bound rejected");
        }
    }
    if DIST.c99_source_admission(["not", "source"]).ok {
        fail("non-text C99 source admitted");
    }

    let fixture = DIRFS.open_absolute(root, false, false);
    if not fixture.ok { fail("cannot reopen fixture for verified cleanup"); }
    let entries = DIRFS.list(fixture, "root", 16);
    if not entries.ok or entries.truncated { DIRFS.close(fixture); fail("fixture cleanup inventory"); }
    let entry_index = 0;
    while entry_index < len(entries.entries) {
        if not DIRFS.remove_file(fixture, entries.entries[entry_index]).ok {
            DIRFS.close(fixture); fail("fixture entry cleanup");
        }
        entry_index = entry_index + 1;
    }
    DIRFS.close(fixture);
    let temporary = DIRFS.open_absolute("/tmp", false, false);
    if not temporary.ok or not DIRFS.remove(temporary, path_basename(root)).ok {
        if temporary.ok { DIRFS.close(temporary); }
        fail("fixture directory cleanup");
    }
    DIRFS.close(temporary);
}

print "dist_path_isolation_pass";
