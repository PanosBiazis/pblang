// Phase 1: basic break/continue
let i = 0;
while i < 100 {
    if i == 5 { break; }
    i = i + 1;
}
if i != 5 { throw "FAIL while break"; }
print "phase1 ok";

// Phase 2: for break
let found = -1;
for j 10 {
    if j == 4 { found = j; break; }
}
if found != 4 { throw "FAIL for break"; }
print "phase2 ok";

// Phase 3: continue
let evens = [];
let n = 0;
while n < 10 {
    n = n + 1;
    if num_mod(n, 2) != 0 { continue; }
    array_push(evens, n);
}
if len(evens) != 5 { throw "FAIL continue"; }
print "phase3 ok";

// Phase 4: loop + break
let count = 0;
loop {
    count = count + 1;
    if count >= 7 { break; }
}
if count != 7 { throw "FAIL loop"; }
print "phase4 ok";

// Phase 5: throw
let threw = false;
try { throw "test"; } catch { threw = true; };
if threw == false { throw "FAIL throw"; }
print "phase5 ok";

// Phase 6: ??
let a = nil;
let b = a ?? "default";
if b != "default" { throw "FAIL ?? nil: " + str(b); }
let c = "hello";
let d = c ?? "fallback";
if d != "hello" { throw "FAIL ?? non-nil: " + str(d); }
print "phase6 ok";

// Phase 7: f-string
let name = "Alice";
let msg = f"Hello {name}!";
if msg != "Hello Alice!" { throw "FAIL f-string: " + str(msg); }
print "phase7 ok";

// Phase 8: ** and %
let p = 2 ** 10;
if p != 1024 { throw "FAIL **: " + str(p); }
let m = 17 % 5;
if m != 2 { throw "FAIL %: " + str(m); }
print "phase8 ok";

// Phase 9: break in for-in
let first_even = -1;
for item in [1, 3, 4, 6, 7] {
    if num_mod(item, 2) == 0 { first_even = item; break; }
}
if first_even != 4 { throw "FAIL for-in break: " + str(first_even); }
print "phase9 ok";

print "all_phases_pass";
