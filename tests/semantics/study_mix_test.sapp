let M=import("stdlib:study_mix.sapp");let S=import("stdlib:study_cards.sapp");let R=import("stdlib:random.sapp");let pairs=[];for i in range(1,65){array_push(pairs,map{prompt:"Question "+str(i),answer:"Answer "+str(i)});}let deck=S.create("Synthetic progress",pairs,"2026-09-27");deck=S.review(deck,1,"good","2026-09-27");let before=S.encode(deck);let g=R.seed(99);let state=g.s;let cases=0;
for count in range(1,65){for seed in [0,1,42,4294967295]{let a=M.create(deck,count,seed);let b=M.create(deck,count,seed);assert(a==b and len(a.deck.cards)==count,"repeatable count");let seen=map{};for i in range(0,count){let c=a.deck.cards[i];assert(not map_has(seen,str(c.id)),"no duplicate selection");seen[str(c.id)]=true;assert(c==deck.cards[a.source_positions[i]-1] and a.ids[i]==c.id,"exact metadata and content retained");}cases=cases+1;}}
assert(cases==256 and S.encode(deck)==before and g.s==state,"source and unrelated generator retained");let a=M.create(deck,64,42);a.deck.cards[0].prompt="Changed copy";assert(S.encode(deck)==before,"detached cards");let due=S.due(M.create(deck,64,42).deck,"2026-09-28");assert(due[63].id==1,"older due dates retain review priority");
for count in [0,65,1.5,nil,true]{assert((try M.create(deck,count,42) catch nil)==nil,"invalid count");}
for text in ["-1","1.5","1e2"," 1","1 ","",nil,"4294967296","00000000000"]{assert((try M.parse_seed(text) catch nil)==nil,"strict seed text");}assert(M.parse_seed("4294967295")==4294967295 and M.parse_seed("000")==0,"seed endpoints");assert((try M.parse_count("0") catch nil)==nil and (try M.parse_count("65") catch nil)==nil,"count limits");
let bad=S.copy(deck);bad.cards[63].answer="";assert((try M.create(bad,1,42) catch nil)==nil,"validate even unselected source cards");print "study_mix_pass: 256 count/seed cases";
