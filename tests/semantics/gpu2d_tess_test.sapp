// tests/semantics/gpu2d_tess_test.sapp — stdlib/gpu2d_tess.sapp
//
// The mesh/tessellation path of the GPU 2D stack (lyon-style), complementing gpu2d's
// instanced quads: arbitrary-angle thick lines, polylines, convex fills, and GRADIENTS
// (per-vertex colour interpolation). Emits a flat triangle vertex buffer of 6 floats each
// [x, y, r, g, b, a], drawn by the mesh pipeline in gpu2d_shader. Pure + deterministic.

let TS = import("stdlib/gpu2d_tess.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let RED = map{ r: 255, g: 0, b: 0, a: 255 };
let BLUE = map{ r: 0, g: 0, b: 255, a: 255 };

// ── a filled rect = one quad = 2 triangles = 6 vertices ────────────────────────────
let m = TS.new();
TS.rect(m, 0, 0, 10, 10, RED);
eq(TS.vertices(m), 6, "rect -> 6 verts");
eq(TS.triangles(m), 2, "rect -> 2 tris");
let vb = TS.to_vertex_f32(m);
eq(len(vb), 6 * 6, "6 floats per vertex");
approx(vb[0], 0, "v0.x"); approx(vb[1], 0, "v0.y");
approx(vb[2], 1.0, "v0.r normalized"); approx(vb[5], 1.0, "v0.a normalized");

// ── a thick line becomes a rotated quad (what instanced axis-aligned quads can't do) ─
let ml = TS.new();
TS.line(ml, 0, 0, 0, 10, 2, RED);   // vertical segment, width 2 -> bar x in [-1, 1]
eq(TS.vertices(ml), 6, "line -> 6 verts");
let lb = TS.to_vertex_f32(ml);
// the four corners sit at x = -1 or x = +1
let sawNeg = false;
let sawPos = false;
let i = 0;
while i < 6 {
    let x = lb[i * 6];
    if x < 0 - 0.5 { sawNeg = true; }
    if x > 0.5 { sawPos = true; }
    i = i + 1;
}
eq(sawNeg, true, "line has a corner at x=-1"); eq(sawPos, true, "line has a corner at x=+1");

// ── gradient rect: top vertices red, bottom vertices blue (per-vertex colour) ────────
let mg = TS.new();
TS.gradient_rect(mg, 0, 0, 100, 50, RED, BLUE, true);   // vertical gradient
let gb = TS.to_vertex_f32(mg);
// scan vertices: a vertex at y=0 must be red (r=1,b=0); a vertex at y=50 must be blue
let topRed = false;
let botBlue = false;
let j = 0;
while j < TS.vertices(mg) {
    let y = gb[j * 6 + 1];
    let r = gb[j * 6 + 2];
    let b = gb[j * 6 + 4];
    if y < 0.5 and r > 0.9 and b < 0.1 { topRed = true; }
    if y > 49.5 and b > 0.9 and r < 0.1 { botBlue = true; }
    j = j + 1;
}
eq(topRed, true, "gradient top is red"); eq(botBlue, true, "gradient bottom is blue");

// ── convex fill = triangle fan ──────────────────────────────────────────────────────
let mf = TS.new();
TS.fill_convex(mf, [map{ x: 0, y: 0 }, map{ x: 10, y: 0 }, map{ x: 10, y: 10 }, map{ x: 0, y: 10 }], RED);
eq(TS.triangles(mf), 2, "quad fan -> 2 tris");

// polyline = a line per segment
let mp = TS.new();
TS.polyline(mp, [map{ x: 0, y: 0 }, map{ x: 10, y: 0 }, map{ x: 10, y: 10 }], 2, RED);
eq(TS.triangles(mp), 4, "2 segments -> 4 tris");

let st = TS.stats(m);
eq(st.vertices, 6, "stats vertices"); eq(st.triangles, 2, "stats triangles"); eq(st.floats, 36, "stats floats");

print "gpu2d_tess_pass";
