let T=import("stdlib:ui_typography.sapp");let UI=import("stdlib:modern_ui.sapp");
let GUI=import("stdlib:gui.sapp");let Flow=import("stdlib:text_flow.sapp");
let Web=import("stdlib:modern_ui_web.sapp");let Android=import("stdlib:modern_ui_android.sapp");
let App=import("../../examples/declarative_browser/app.sapp");let V=import("stdlib:browser_view.sapp");
for family in ["system","sans","serif","monospace"] {assert(T.validate(map{font_family:family}),"known font families");}
for field in ["font_family","text_spacing","line_height"] {
    for value in [nil,true,[],map{},"x;url(https://invalid.test)",-1,0,3] {
        let option=map{};option[field]=value;
        assert((try T.validate(option) catch false)==false,"invalid presentation rejected");
        assert(not UI.validate(UI.screen([UI.button("bad",nil,option)])).ok,"buttons share validation");
    }
}
let raw=UI.screen([UI.heading("Title",map{font_size:28}),UI.text("Body"),UI.input("Editable")]);
let view=T.apply(raw,map{font_size:16,font_family:"serif",line_height:1.5,text_spacing:"natural"});
assert(view.children[0].font_size==28 and view.children[1].font_size==16,"per-element values outrank common defaults");
assert(not map_has(raw.children[1],"font_size") and not map_has(view.children[2],"font_size"),"caller tree and caret geometry preserved");
assert((try T.apply(raw,map{font_path:"arbitrary.ttf"}) catch nil)==nil,"no arbitrary path propagation");
let deep=UI.text("leaf");for _i 26 {deep=UI.column([deep]);}
assert((try T.apply(deep,map{}) catch nil)==nil,"bounded recursion");
assert(Flow.metrics(map{font_size:20,line_height:1.75}).line_height==35,"line height participates in measurement");
let styled=UI.screen([UI.button("Read",nil,map{name:"button",font_size:24,font_family:"serif",line_height:1.5}),view]);
let web=Web.generate("Reader",UI.compile(styled,map{target:"web"}));
assert(str_contains(web.css,"font-family:serif;") and str_contains(web.css,"line-height:1.5;"),"actual Web family and spacing output");
let bytes=Android.activity_class(UI.compile(styled,map{target:"android"}));
let baseline=Android.activity_class(UI.compile(raw,map{target:"android"}));
assert(len(bytes)>len(baseline),"Android family and line spacing produce bytecode");
let form=UI.build("Type",styled);let button=GUI.get(form,"button");
assert(button.font_size==24 and button.font_family=="serif" and button.h>=52,"button typography and minimum height");
// Deterministic renderer spy proves measured alignment, fallback and bounded fitting.
let f=GUI.form("Native",240,120);GUI.set_text_render(f,"auto");
let label=GUI.styled_label("label",10,10,80,40,"iiiWWW",map{font_size:18,font_family:"serif",text_spacing:"natural",text_align:"right"});GUI.add(f,label);
let calls=[];let rects=[];
let canvas=map{clear:fn(c){},line:fn(a,b,c,d,e){},rect:fn(x,y,w,h,c){push(rects,[x,y,w,h]);},
    textMeasure:fn(text,size,cell,family){return map{ok:true,width:len(text)*7};},
    textStyled:fn(x,y,text,color,size,cell,family){push(calls,map{x:x,y:y,text:text,size:size,cell:cell,family:family});return map{ok:true,font:"test-serif",renderer:"test-aa"};}};
GUI.draw(canvas,f);
assert(calls[0].x==48 and calls[0].cell==0 and calls[0].family=="serif","native alignment uses actual measured width");
label.text=str_repeat("W",100);calls=[];GUI.draw(canvas,f);
assert(len(calls[0].text)*7<=80 and str_contains(calls[0].text,"..."),"broad text fits with ellipsis");
GUI.set_text_render(f,"bitmap");calls=[];GUI.draw(canvas,f);
assert(len(calls)==0 and len(rects)>0,"forced bitmap bypasses all AA entry points");
let c=App.create();let original=c.appearance;
assert((try App.configure(c,map{font_scale:9}) catch nil)==nil and c.appearance==original,"invalid settings are atomic");
for option in [map{font_family:"remote"},map{body_size:0},map{title_size:80},map{line_height:0.5},map{density:"tiny"},map{unknown:1}] {
    assert((try V.appearance(option) catch nil)==nil,"bounded reader options");
}
for size in [map{w:800,h:816},map{w:390,h:844}] {
    c.width=size.w;c.height=size.h;c.session.navigate("pb://guide");App.refresh(c);
    let back=GUI.get(c.form,"back");let forward=GUI.get(c.form,"forward");let home=GUI.get(c.form,"home");
    assert(back.y==forward.y and home.y==back.y and home.x>forward.x,"one compact navigation row at both widths");
    let bottom=0;
    for widget in c.form.widgets {
        assert(widget.x>=0 and widget.y>=0 and widget.x+widget.w<=size.w and widget.y+widget.h<=size.h,"default reader fits viewport");
        bottom=num_max(bottom,widget.y+widget.h);
    }
    assert(GUI.get(c.form,"page_title").y<160,"title no longer below three stacked buttons");
}
GUI.get(c.form,"appearance").onclick(c.form);App.update(c,[]);
assert(c.settings and GUI.get(c.form,"font_family")!=nil,"separate appearance screen");
GUI.get(c.form,"font_family").onclick(c.form);App.update(c,[]);
assert(c.appearance.font_family=="serif","family control changes persistent session preference");
GUI.get(c.form,"appearance").onclick(c.form);App.update(c,[]);
assert(not c.settings and GUI.get(c.form,"page_title").font_family=="serif" and c.session.snapshot().url=="pb://guide","settings preserve current document");
c.session.close();print "readable_typography_pass";
