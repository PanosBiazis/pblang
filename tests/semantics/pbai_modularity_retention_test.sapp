let AI=import("stdlib/pbai.sapp");let S=import("stdlib:pbai_sensor.sapp");let R=import("stdlib:controlled_modularity.sapp");
let request=map{values:[2,4,6,100],period_seconds:1,sigma:3,absolute_tolerance:1};
let request_before=json_stringify(request);
let b=AI.modular_bind_limited("sensor-v1",S,R,map{max_calls:2});
let empty=json_stringify(b.metrics());let report=json_stringify(b.report());
let result=b.run(request);let result_before=json_stringify(result);
let first=b.metrics();let first_before=json_stringify(first);
let error=b.run(map{values:"synthetic-private-marker"});let error_before=json_stringify(error);
let second=b.metrics();let second_before=json_stringify(second);let exhausted=json_stringify(b.status());
assert(first.provider_results==1 and first.provider_errors==0 and second.provider_errors==1,"distinct caller snapshots");
assert(b.clear_metrics()==nil and json_stringify(b.metrics())==empty,"reset restores complete empty schema");
assert(json_stringify(b.status())==exhausted and json_stringify(b.report())==report,"reset preserves admission report and exhausted quota");
assert(json_stringify(result)==result_before and json_stringify(error)==error_before,"reset does not alter success or error output");
assert(json_stringify(first)==first_before and json_stringify(second)==second_before,"old nested snapshots remain intact");
assert(json_stringify(request)==request_before,"caller input preserved");
second.duration.samples=999;second.execution_errors=999;
assert(json_stringify(b.metrics())==empty,"old snapshot edits cannot change reused private maps");
b.cancel();let cancelled=json_stringify(b.status());
assert(b.run(nil).error=="binding_cancelled","no result replay after cancellation");
let denied=b.metrics();assert(denied.rejected_calls==1 and denied.executed_calls==0,"fresh refusal observed");
// Measure only the reset loop: gc_stats reports cumulative allocations, not live RAM.
fn map_allocations() {
 let fields=str_split(gc_stats()," ");
 for entry in fields {let pair=str_split(entry,"=");if len(pair)==2 and pair[0]=="map_allocs" {return parse_number(pair[1]);}}
 throw "map allocation counter unavailable";
}
let allocations_before=map_allocations();
let count=0;while count<1000 {b.clear_metrics();count=count+1;}
let allocations_after=map_allocations();
assert(allocations_after==allocations_before,"idle reset allocates no replacement maps on retained runtime");
assert(json_stringify(b.metrics())==empty and json_stringify(b.status())==cancelled,"repeated reset preserves cancelled lifetime state");
assert(denied.rejected_calls==1 and json_stringify(result)==result_before,"retained snapshot and numeric result survive repeated reset");
let active=AI.modular_bind("sensor-v1",S,R);
let old=active.run(request);let old_json=json_stringify(old);
active.clear_metrics();assert(active.run(request).output.value.outlier and json_stringify(old)==old_json,"new execution does not overwrite caller-held prior result");
let failed=AI.modular_bind_limited("sensor-v1",S,R,map{max_calls:"invalid"});
failed.run(request);failed.clear_metrics();
assert(failed.run(request).error=="invalid_limits" and failed.metrics().executed_calls==0,"clearing failed binding cannot start provider");
assert(not str_contains(json_stringify(b.metrics()),"synthetic-private-marker"),"no payload retention in reset state");
print "pbai_modularity_retention_pass";
