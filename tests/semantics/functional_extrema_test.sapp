let F = import("stdlib:functional.sapp");
let C = import("stdlib:class.sapp");
let G = import("stdlib:generics.sapp");
fn expect(ok, label) { if not ok { throw "FAIL functional-extrema: " + label; } }

for select in [F.max_by, F.min_by] {
    let visited = [];
    let singleton = select([7], fn(x) { push(visited, x); return x; });
    expect(singleton == 7 and visited == [7], "singleton key evaluated exactly once");
    let empty = select([], fn(x) { throw "empty callback must not run"; });
    expect(type(empty) == "nil", "empty input does not invoke callback");
    let values = [4, 2, 9, 2];
    visited = [];
    select(values, fn(x) { push(visited, x); return x; });
    expect(visited == values and values == [4, 2, 9, 2], "one left-to-right visit per element without input mutation");
    let calls = [0];
    let failed = try map{ ok: true, value: select([1, 2, 3], fn(x) {
        calls[0] = calls[0] + 1;
        if x == 2 { throw "callback failure"; }
        return x;
    }) } catch map{ ok: false };
    expect(not failed.ok and calls[0] == 2, "callback failure propagates without later visits");
    calls[0] = 0;
    let first_failed = try map{ ok: true, value: select([1, 2], fn(x) {
        calls[0] = calls[0] + 1; throw "first failure";
    }) } catch map{ ok: false };
    expect(not first_failed.ok and calls[0] == 1, "first callback failure stops immediately");
}

let rows = [map{ id: "first", score: 5 }, map{ id: "second", score: 5 }];
let high = F.max_by(rows, fn(row) { return row.score; });
let low = F.min_by(rows, fn(row) { return row.score; });
expect(high.id == "first" and low.id == "first", "ties preserve first element");
high.score = 8;
expect(rows[0].score == 8, "selected value retains original reference");
expect(F.max_by([-8, -2, -5], F.identity) == -2, "negative maximum");
expect(F.min_by([-8, -2, -5], F.identity) == -8, "negative minimum");
expect(F.max_by(["a", "long", "bb"], len) == "long", "text values with numeric key");
expect(F.min_by(["a", "long", "bb"], len) == "a", "text values with numeric key");
for select in [F.max_by, F.min_by] {
    let bad_key = try map{ ok: true, value: select(["a", "z"], F.identity) } catch map{ ok: false };
    expect(not bad_key.ok, "non-numeric comparison retains existing rejection");
}

let order = [0];
let increasing = fn(x) { order[0] = order[0] + 1; return order[0]; };
expect(F.max_by(["first", "last"], increasing) == "last" and order[0] == 2, "stateful maximum selects using first evaluation only");
order[0] = 0;
expect(F.min_by(["first", "last"], increasing) == "first" and order[0] == 2, "stateful minimum evaluates once");
let scores = [10, 100, 20];
order[0] = 0;
let changing = fn(x) { let score = scores[order[0]]; order[0] = order[0] + 1; return score; };
expect(F.max_by(["first", "last"], changing) == "last", "duplicate first evaluation cannot change winner");

let Scorer = C.define("Scorer", ["visits"], map{
    score: fn(self, row) {
        push(self.visits, row.id);
        return G.assert_type(G.T_number(), row.score);
    }
});
let scorer = C.new(Scorer, map{ visits: [] });
let score = C.bind1(scorer, "score");
let candidates = [map{ id: "a", score: 2 }, map{ id: "b", score: 9 }, map{ id: "c", score: 4 }];
expect(F.max_by(candidates, score).id == "b" and scorer.visits == ["a", "b", "c"], "object-bound generic scorer composes with selection");
scorer.visits = [];
let invalid = try map{ ok: true, value: F.min_by([map{ id: "bad", score: "wrong" }], score) } catch map{ ok: false };
expect(not invalid.ok and scorer.visits == ["bad"], "generic key validation failure propagates");
print "functional_extrema_pass";
