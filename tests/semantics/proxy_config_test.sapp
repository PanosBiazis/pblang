let Proxy=import("stdlib:proxy_config.sapp");
let config=Proxy.create(8080,[map{id:"one",port:8081},map{id:"two",port:8082}]);
let one=Proxy.select(config,[true,true]);
let two=Proxy.select(config,[true,true],one.next_cursor);
assert(one.upstream.id=="one" and two.upstream.id=="two" and two.next_cursor==0,"round-robin selection");
assert(Proxy.select(config,[false,true]).upstream.id=="two","unhealthy upstream skipped");
assert(not Proxy.select(config,[false,false]).available,"no fallback to unhealthy upstream");
let nginx=Proxy.nginx(config); let haproxy=Proxy.haproxy(config);
assert(nginx==Proxy.nginx(config) and haproxy==Proxy.haproxy(config),"deterministic config export");
assert(str_contains(nginx,"listen 127.0.0.1:8080;") and str_contains(haproxy,"bind 127.0.0.1:8080"),"loopback listeners only");
assert(str_contains(nginx,"server 127.0.0.1:8082;") and str_contains(haproxy,"server two 127.0.0.1:8082"),"both backends emitted");
assert(not str_contains(nginx,"Authorization") and not str_contains(haproxy,"/home/"),"no credentials or personal paths in fixture export");
fn rejects(f) { let fail=try {f();false} catch true; assert(fail,"unsupported input rejected"); }
rejects(fn(){Proxy.create(80,[map{id:"one",port:8081}]);});
rejects(fn(){Proxy.create(8080,[map{id:"one",port:8080}]);});
rejects(fn(){Proxy.create(8080,[map{id:"one",port:8081},map{id:"two",port:8081}]);});
rejects(fn(){Proxy.create(8080,[map{id:"one",port:8081},map{id:"one",port:8082}]);});
for id in ["bad;", "x\nfrontend injected", "x}", "x\u0000", "../x", str_repeat("x",33)] {
    rejects(fn(){Proxy.create(8080,[map{id:id,port:8081}]);});
}
rejects(fn(){Proxy.create(8080,[map{id:"one",port:"8081"}]);});
rejects(fn(){Proxy.select(config,[true,"true"]);});
rejects(fn(){Proxy.select(config,[true,true],0.5);});
rejects(fn(){Proxy.select(config,[true]);});
let invalid=Proxy.create(8080,[map{id:"one",port:8081}]); invalid.raw="injected";
rejects(fn(){Proxy.nginx(invalid);}); rejects(fn(){Proxy.haproxy(invalid);});
let source=[map{id:"one",port:8081}]; let copied=Proxy.create(8080,source); source[0].port=1;
assert(copied.upstreams[0].port==8081,"constructor copies caller configuration");
one.upstream.port=1; assert(config.upstreams[0].port==8081,"selection does not expose mutable config");
let maximum=[]; for i in range(0,16) {array_push(maximum,map{id:"app_"+str(i),port:9000+i});}
assert(Proxy.validate(Proxy.create(8080,maximum)),"sixteen backends accepted");
array_push(maximum,map{id:"extra",port:9016}); rejects(fn(){Proxy.create(8080,maximum);});
let timeout_config=Proxy.create(8080,[map{id:"one",port:8081}]);
timeout_config.io_timeout_ms=60001; rejects(fn(){Proxy.validate(timeout_config);});
print "proxy_config_pass";
