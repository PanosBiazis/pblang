// tests/semantics/image_processing_enrich2_test.sapp — wave 2 for stdlib/image_processing.sapp
// pixelate, tint, solarize, channel_extract, crop_center. Pixels are [r,g,b(,a)] arrays.

let IP = import("stdlib/image_processing.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn eqpx(p, r, g, b, m) { if p[0] != r or p[1] != g or p[2] != b { fail(m + " got=" + str(p)); } }

// ── pixelate: 2x2 block collapses to the block's top-left pixel ───────────────────
let img = [
    [[0,0,0],   [100,100,100]],
    [[200,200,200], [255,255,255]],
];
let px = IP.pixelate(img, 2);
eqpx(px[0][0], 0, 0, 0, "pixelate tl");
eqpx(px[1][1], 0, 0, 0, "pixelate br same as tl");

// ── tint: strength 1 -> the target color; strength 0 -> unchanged ─────────────────
let t1 = IP.tint([[[100,100,100]]], [255,255,255], 1.0);
eqpx(t1[0][0], 255, 255, 255, "tint full -> white");
let t0 = IP.tint([[[100,100,100]]], [0,0,0], 0.0);
eqpx(t0[0][0], 100, 100, 100, "tint zero -> unchanged");

// ── solarize: invert channels above threshold ─────────────────────────────────────
let s = IP.solarize([[[200,100,50]]], 128);
eqpx(s[0][0], 55, 100, 50, "solarize threshold 128");

// ── channel_extract: build grayscale from one channel ─────────────────────────────
let g = IP.channel_extract([[[10,20,30]]], "g");
eqpx(g[0][0], 20, 20, 20, "extract green");

// ── alpha preserved by tint ────────────────────────────────────────────────────────
let ta = IP.tint([[[100,100,100,42]]], [0,0,0], 0.0);
eq(ta[0][0][3], 42, "tint preserves alpha");

// ── crop_center: center 2x2 of a 4x4 where pixel = [x,y,0] ────────────────────────
let big = [];
let yy = 0;
while yy < 4 {
    let row = [];
    let xx = 0;
    while xx < 4 { array_push(row, [xx, yy, 0]); xx = xx + 1; }
    array_push(big, row);
    yy = yy + 1;
}
let cc = IP.crop_center(big, 2, 2);
eq(len(cc), 2, "crop_center height");
eq(len(cc[0]), 2, "crop_center width");
eqpx(cc[0][0], 1, 1, 0, "crop_center origin = (1,1)");

print "image_processing_enrich2_pass";
