let W = import("stdlib:wayland_unicode_input.sapp");

fn require(value, message) { if not value { throw "FAIL wayland-unicode-input: " + message; } }
fn app(dst, src) { let i = 0; while i < len(src) { array_push(dst, src[i]); i = i + 1; } return dst; }
fn u32(value) { return [value % 256, num_floor(value / 256) % 256,
    num_floor(value / 65536) % 256, num_floor(value / 16777216) % 256]; }
fn string_arg(value) {
    let raw = str_to_bytes(value); let out = []; app(out, u32(len(raw) + 1));
    app(out, raw); array_push(out, 0); while len(out) % 4 != 0 { array_push(out, 0); }
    return out;
}
fn message(id, opcode, body) {
    let out = []; app(out, u32(id)); app(out, u32((8 + len(body)) * 65536 + opcode));
    app(out, body); return out;
}
fn global(name, interface, version) {
    let body = []; app(body, u32(name)); app(body, string_arg(interface)); app(body, u32(version));
    return message(2, 0, body);
}

let plan = W.text_plan("Aα中😀\t\nA");
require(plan.ok and plan.scalar_count == 7 and plan.batch_count == 1
    and plan.layout_independent_unicode, "multi-script plan mismatch");
require(len(plan.batches[0].assignments) == 6 and len(plan.batches[0].keys) == 7,
    "unique scalar compaction mismatch");
require(str_contains(plan.batches[0].keymap, "U03B1")
    and str_contains(plan.batches[0].keymap, "U1F600")
    and str_contains(plan.batches[0].keymap, "Tab")
    and str_contains(plan.batches[0].keymap, "Return"),
    "generated XKB keymap omits semantic symbols");

let many = ""; let i = 0;
while i < 260 { many = many + strfromcharcode(0x400 + i); i = i + 1; }
let batched = W.text_plan(many);
require(batched.ok and batched.scalar_count == 260 and batched.batch_count == 2
    and len(batched.batches[0].assignments) == 247
    and len(batched.batches[1].assignments) == 13,
    "bounded keymap batching mismatch");
require(not W.text_plan("").ok and not W.text_plan("\x1b").ok,
    "empty or unsupported control text accepted");

let wire = []; app(wire, global(17, "wl_seat", 9));
app(wire, global(23, "zwp_virtual_keyboard_manager_v1", 1));
app(wire, message(3, 0, u32(42)));
let parsed = W.parse_registry(wire);
require(parsed.ok and parsed.complete and parsed.seat_name == 17
    and parsed.seat_version == 9 and parsed.manager_name == 23
    and parsed.manager_version == 1 and parsed.consumed == len(wire),
    "registry discovery mismatch");
let partial = W.parse_registry([]);
require(partial.ok and not partial.complete and partial.consumed == 0,
    "empty fragmented registry state mismatch");
let truncated = []; i = 0; while i + 2 < len(wire) { array_push(truncated, wire[i]); i = i + 1; }
let waiting = W.parse_registry(truncated);
require(waiting.ok and not waiting.complete and waiting.consumed < len(wire),
    "truncated message was consumed");
let malformed = [2, 0, 0, 0, 7, 0, 4, 0];
let malformed_result = W.parse_registry(malformed);
if malformed_result.ok { throw "FAIL wayland-unicode-input: invalid wire size accepted"; }

let caps = W.capabilities();
require(caps.text_unicode_layout_independent and caps.native_pblang_wire_client
    and caps.privileged_protocol_fail_closed and not caps.external_tool_required,
    "capability contract mismatch");
let candidate = W.candidate();
require(type(candidate.ok) == "bool"
    and candidate.backend == caps.backend and candidate.layout_independent_unicode,
    "candidate must be total");
require(not W.probe(1).ok, "invalid probe deadline accepted");
print "wayland_unicode_input_pass";
