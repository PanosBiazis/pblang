let W=import("stdlib:word_workbook.sapp");let T=import("stdlib:text_document.sapp");let P=import("stdlib:word_profile.sapp");let CSV=import("stdlib:csv.sapp");
let doc=T.from_text("beta alpha beta\nα α beta Alpha alpha!","title excluded");let before=T.encode(doc);
let r=W.report(doc);assert(r.format==W.FORMAT and r.total==8 and r.unique==5,"whole body counts");
assert(r.entries[0]==map{rank:1,token:"beta",count:3,blocks:[1,2]},"one-based ranks and block locations");
assert(r.entries[1].token=="α" and r.entries[2].token=="alpha","stable frequency ties");
assert(json_parse(W.encode(doc,"json"))==r,"lossless JSON");r.entries[0].blocks[0]=999;assert(T.encode(doc)==before,"detached and read-only");
let many=T.create();many.blocks=[];for b in range(0,32){let terms=[];for j in range(0,8){array_push(terms,"term"+str(b*8+j));}array_push(many.blocks,map{kind:"paragraph",text:str_join(terms," ")});}
let csv=CSV.parse(W.encode(many));assert(len(csv)==257 and csv[256]==["256","'term255","1","32"],"all 256 entries in one export");
let full=json_parse(W.encode(many,"json"));let profile=P.analyze(many);for i in range(0,256){assert(full.entries[i].token==profile.entries[i].token and full.entries[i].count==profile.entries[i].count,"profile parity");}
assert(len(str_to_bytes(W.encode(many,"json")))<=W.MAX_OUTPUT_BYTES,"output bounded");
let blocks=T.create();blocks.blocks=[];for b in range(0,64){array_push(blocks.blocks,map{kind:"paragraph",text:"repeat"});}let last=W.report(blocks).entries[0];assert(last.count==64 and last.blocks[0]==1 and last.blocks[63]==64,"all locations");
let literals=T.from_text("=1+1 +2 -3 @x 'quoted a,b a\"b 😀 λέξη\u00a0λέξη");let raw=W.report(literals);let encoded=CSV.parse(W.encode(literals));
for i in range(0,raw.unique){assert(encoded[i+1][1]=="'"+raw.entries[i].token,"CSV text marker and quoting");}
assert(json_parse(W.encode(literals,"json")).entries==raw.entries,"literal Unicode and punctuation in JSON");
assert(len(CSV.parse(W.encode(T.create())))==1 and W.report(T.create()).entries==[],"empty document exports header and empty entries");
let too=T.copy(many);too.blocks[0].text=too.blocks[0].text+" overflow";assert((try W.encode(too) catch nil)==nil,"no partial unique overflow");
assert((try W.encode(T.from_text(str_repeat("α",129))) catch nil)==nil,"UTF-8 token bound");
assert((try W.encode(map{}) catch nil)==nil and (try W.encode(doc,"sheet") catch nil)==nil and (try W.encode(doc,nil) catch nil)==nil,"invalid input and format");
assert(T.encode(doc)==before,"original unchanged");print "word_workbook_pass entries=256 blocks=64";
