// Test: orm.sapp
let orm = import("stdlib:orm.sapp");

let db = orm.connect("target/orm_test.db");

// Clean up from any previous test run
try orm.raw_exec(db, "DROP TABLE IF EXISTS Person", []) catch nil;

// Define model
orm.define_model(db, "Person", [
    "id INTEGER PRIMARY KEY AUTOINCREMENT",
    "name TEXT NOT NULL",
    "age INTEGER"
]);

// Insert
let id1 = orm.insert(db, "Person", map{ name: "Alice", age: 30 });
let id2 = orm.insert(db, "Person", map{ name: "Bob", age: 25 });
assert(id1 > 0, "insert should return row id");
assert(id2 > id1, "second insert id should be greater");

// find_by_id
let alice = orm.find_by_id(db, "Person", id1);
assert(alice != nil, "find_by_id should return a row");
assert(alice.name == "Alice", "found name should be Alice");
assert(alice.age == 30, "found age should be 30");

// find_where
let results = orm.find_where(db, "Person", "age > ?", [20]);
assert(len(results) == 2, "find_where should return both people");

// count
let total = orm.count(db, "Person");
assert(total == 2, "count should be 2");

// update
orm.update(db, "Person", id1, map{ age: 31 });
let alice2 = orm.find_by_id(db, "Person", id1);
assert(alice2.age == 31, "age should be updated");

// delete
orm.delete(db, "Person", id2);
let remaining = orm.count(db, "Person");
assert(remaining == 1, "count after delete should be 1");

// paginate
let page = orm.paginate(db, "Person", 1, 10);
assert(page.total == 1, "paginate total should be 1");

// Cleanup
orm.raw_exec(db, "DROP TABLE Person", []);
print "ORM tests passed";
