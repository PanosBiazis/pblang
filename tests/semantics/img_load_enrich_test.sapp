// tests/semantics/img_load_enrich_test.sapp — enrichment for stdlib/img_load.sapp
// Adds is_ppm (magic-byte sniff) and dimensions (of a parsed image grid).

let il = import("stdlib/img_load.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── ENRICH: is_ppm (P6 magic = bytes 80,54) ──────────────────────────────────────
eq(il.is_ppm([80, 54, 10, 49]), true, "P6 magic -> true");
eq(il.is_ppm([137, 80, 78, 71]), false, "PNG magic -> false");
eq(il.is_ppm([80]), false, "too short -> false");

// ── ENRICH: dimensions of a 2D image grid ────────────────────────────────────────
let d = il.dimensions([[1, 2, 3], [4, 5, 6]]);
eq(d.width, 3, "dimensions width"); eq(d.height, 2, "dimensions height");
let e = il.dimensions([]);
eq(e.width, 0, "empty width"); eq(e.height, 0, "empty height");

print "img_load_enrich_pass";
