// tests/semantics/uuid_enrich2_test.sapp — wave 2 for stdlib/uuid.sapp (v7, time-ordered)

let U = import("stdlib/uuid.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let u = U.v7();
if not U.is_valid(u) { fail("v7 is a valid uuid: " + u); }
eq(U.version(u), 7, "v7 version is 7");
eq(U.variant(u), "rfc4122", "v7 variant is rfc4122");
if U.is_nil(u) { fail("v7 is not nil"); }

// two v7s are distinct
if U.v7() == U.v7() { fail("v7 values should differ"); }

print "uuid_enrich2_pass";
