// tests/semantics/stdlib_undefined_names_fix_test.sapp
//
// Locks fixes for REAL latent bugs found by `pblang check` undefined-name
// diagnostics (each of these threw at first call before the fix):
//
//   - functional.sapp curry()/sort_by() called the nonexistent `array_copy`
//   - game.sapp vec2_from_angle()/vec2_rotate() used `math.cos` with NO math
//     import in the module
//
// (machine_opt.sapp's `_num_or` used the nonexistent `num()` — internal, its
// fix is covered by `pblang check` going clean + numeric-string coercion.)

let F = import("stdlib:functional.sapp");
let G = import("stdlib:game.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn approx(a, b, m) {
    let d = a - b;
    if d < 0 { d = 0 - d; }
    if d > 0.000001 { fail(m + " got=[" + str(a) + "] want~[" + str(b) + "]"); }
}

// ── functional.curry ─────────────────────────────────────────────────────────
fn add3(a, b, c) { return a + b + c; }
let c1 = F.curry(add3, 3);
eq(c1(1)(2)(3), 6, "curry chains one arg at a time");
fn mul2(a, b) { return a * b; }
eq(F.curry(mul2)(6)(7), 42, "curry defaults to arity 2");

// ── functional.sort_by ───────────────────────────────────────────────────────
fn asc(a, b) { if a < b { return 0 - 1; } if a > b { return 1; } return 0; }
let src = [3, 1, 2];
eq(F.sort_by(src, asc), [1, 2, 3], "sort_by sorts a copy");
eq(src, [3, 1, 2], "sort_by does NOT mutate its input");

// ── game vec2 angle helpers ──────────────────────────────────────────────────
let v0 = G.vec2_from_angle(0, 5);
approx(v0.x, 5, "vec2_from_angle(0) points along +x");
approx(v0.y, 0, "vec2_from_angle(0) has no y component");

let right = G.vec2(1, 0);
let up = G.vec2_rotate(right, 3.14159265358979 / 2);
approx(up.x, 0, "rotating +x by 90deg zeroes x");
approx(up.y, 1, "rotating +x by 90deg points +y");

print "stdlib_undefined_names_fix_pass";
