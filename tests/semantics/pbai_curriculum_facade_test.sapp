let AI=import("stdlib/pbai.sapp");let C=import("stdlib:pbai_curriculum.sapp");
let groups=[map{family:"copy",split:"training",examples:[map{x:[0],y:0}]},
 map{family:"copy",split:"validation",examples:[map{x:[1],y:1}]},map{family:"copy",split:"test",examples:[map{x:[2],y:2}]}];
assert(json_stringify(AI.neural_task_curriculum_split(8,3,groups))==json_stringify(C.prepare_known_tasks(8,3,groups)),"known-task facade parity");
groups[1].family="sum";groups[2].family="difference";
assert(json_stringify(AI.neural_curriculum_split(8,3,groups))==json_stringify(C.prepare(8,3,groups)),"transfer facade parity");
print "pbai_curriculum_facade_pass";
