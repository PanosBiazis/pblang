// tests/semantics/pbai_review_enrich_test.sapp — direct pbAI code-skill APIs + the
// pblang-aware bug detector's new gotcha rules. These are pure (no neural model needed),
// so they run fast and deterministically.

let pbai = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : <<" + s + ">>"); } }

// ── direct skill entry points (bypass intent classification) ──────────────────────
let rv = pbai.review("fn f() { let x = 1 }");
has(rv, "pbAI: review", "review returns the reviewer report");
let ex = pbai.explain_code("fn f() { return 1; }");
has(ex, "pbAI: code overview", "explain_code returns an overview");
let sg = pbai.suggest("fn f() { while true { } }");
has(sg, "pbAI: suggestions", "suggest returns improvement notes");

// ── new pblang-gotcha detection rules ─────────────────────────────────────────────
has(pbai.review("if a { } elif b { }"), "else if", "flags elif");
has(pbai.review("foreach x in xs { print x; }"), "for v in", "flags foreach");
has(pbai.review("let i = 0; i++;"), "i = i + 1", "flags ++ increment");
has(pbai.review("exit(0);"), "exit", "flags exit() call");
has(pbai.review("if a === b { print a; }"), "===", "flags === strict equality");
has(pbai.review("console.log(x);"), "print", "flags console.log");

// ── cross-language gotchas (mistakes a JS/Python/C-trained model makes) ────────────
// each expected substring is DISTINCTIVE to its rule's message (not the generic fallback).
has(pbai.review("if a && b || c { print a; }"), "`and` / `or`", "flags && / || logical operators");
has(pbai.review("let x = null;"), "use `nil`", "flags null literal");
has(pbai.review("let x = None;"), "use `nil`", "flags Python None");
has(pbai.review("let ok = True;"), "`true`/`false`", "flags capitalized True");
has(pbai.review("function foo() { return 1; }"), "no `function`", "flags JS function keyword");
has(pbai.review("let f = (x) => x + 1;"), "`fn(x)", "flags => arrow function");
has(pbai.review("var x = 1;"), "no `var`", "flags var declaration");
has(pbai.review("let n = arr.length;"), "len(x)", "flags .length property");
has(pbai.review("let s = `hi ${name}`;"), "concatenate", "flags string interpolation");
has(pbai.review("let f = lambda x: x + 1;"), "no `lambda`", "flags python lambda");
has(pbai.review("if !x { print x; }"), "`not x`", "flags ! negation operator");

// ── autofix: the suggested-fix preview actually rewrites unambiguous swaps ──────────
has(pbai.review("if a && b { print(x); }"), "if a and b", "autofix rewrites && to and");
has(pbai.review("if a || b { print(x); }"), "a or b", "autofix rewrites || to or");
has(pbai.review("let r = a === b; print(x);"), "a == b", "autofix rewrites === to ==");
has(pbai.review("let x = null; print(x);"), "= nil;", "autofix rewrites null to nil");

// ── existing gotchas still caught (no regression) ─────────────────────────────────
has(pbai.review("print(x);"), "print x", "still flags print(x)");

print "pbai_review_enrich_pass";
