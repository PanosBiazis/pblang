// tests/semantics/dataframe_enrich_test.sapp — fixes + enrichment for stdlib/dataframe.sapp
//
// BUG FIXES:
//  - add_column(df, name, fn): pblang functions are type "closure" (not
//    "function"), so the function was stored verbatim instead of being called
//    per row. Now detects closures/builtins and computes the value.
//  - sort_by on a string column threw ("comparison expects numbers") because
//    pblang has no string ordering. Sorting now uses a type-aware comparator
//    (numbers numerically, everything else lexicographically via bytes) and is
//    a stable insertion sort.
// ENRICH: apply, sort_values (multi-key), left_join, concat, agg, dropna, and
//    scalar column stats (sum_col/mean_col/min_col/max_col/median_col).

let df = import("stdlib/dataframe.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let data = df.from_rows([
    map{ name: "alice", city: "NYC", age: 30 },
    map{ name: "bob", city: "LA", age: 25 },
    map{ name: "carol", city: "NYC", age: 40 }
]);

// ── FIX: add_column with a function computes per row ──────────────────────────────
let withcol = df.add_column(data, "decade", fn(row) { return row.age / 10; });
eq(withcol.rows[0].decade, 3, "add_column fn computes (alice 30/10)");
eq(withcol.rows[1].decade, 2.5, "add_column fn computes (bob 25/10)");

// ── FIX: sort_by on a STRING column no longer throws ─────────────────────────────
let by_name = df.sort_by(data, "name", "asc");
eq(by_name.rows[0].name, "alice", "string sort asc first");
eq(by_name.rows[2].name, "carol", "string sort asc last");
let by_name_d = df.sort_by(data, "name", "desc");
eq(by_name_d.rows[0].name, "carol", "string sort desc first");
// numeric sort still works
eq(df.sort_by(data, "age", "asc").rows[0].age, 25, "numeric sort still works");

// ── ENRICH: apply transforms a single column ─────────────────────────────────────
let upped = df.apply(data, "age", fn(v) { return v + 1; });
eq(upped.rows[0].age, 31, "apply increments age"); eq(upped.rows[0].name, "alice", "apply leaves others");

// ── ENRICH: sort_values multi-key (city asc, then age desc) ──────────────────────
let multi = df.sort_values(data, ["city", "age"], ["asc", "desc"]);
eq(multi.rows[0].city, "LA", "multi-sort city asc");           // LA before NYC
eq(multi.rows[1].name, "carol", "multi-sort NYC by age desc -> carol(40) first");
eq(multi.rows[2].name, "alice", "multi-sort NYC by age desc -> alice(30) second");

// ── ENRICH: left_join keeps unmatched left rows ──────────────────────────────────
let left = df.from_rows([map{ id: 1, x: "a" }, map{ id: 2, x: "b" }]);
let right = df.from_rows([map{ id: 1, y: "Y1" }]);
let lj = df.left_join(left, right, "id");
eq(df.nrows(lj), 2, "left_join keeps all left rows");
eq(lj.rows[0].y, "Y1", "left_join fills matched"); eq(lj.rows[1].y, nil, "left_join unmatched -> nil");

// ── ENRICH: concat unions rows ───────────────────────────────────────────────────
let c = df.concat(left, df.from_rows([map{ id: 3, x: "c" }]));
eq(df.nrows(c), 3, "concat row count"); eq(c.rows[2].x, "c", "concat appended row");

// ── ENRICH: agg over the whole frame ─────────────────────────────────────────────
let a = df.agg(data, map{ age: "sum" });
eq(a.age, 95, "agg sum age (30+25+40)");
let a2 = df.agg(data, map{ age: "avg" });
eq(a2.age, 95 / 3, "agg avg age");

// ── ENRICH: scalar column stats ──────────────────────────────────────────────────
eq(df.sum_col(data, "age"), 95, "sum_col");
eq(df.mean_col(data, "age"), 95 / 3, "mean_col");
eq(df.min_col(data, "age"), 25, "min_col"); eq(df.max_col(data, "age"), 40, "max_col");
eq(df.median_col(data, "age"), 30, "median_col odd");
eq(df.median_col(df.from_rows([map{ v: 1 }, map{ v: 2 }, map{ v: 3 }, map{ v: 4 }]), "v"), 2.5, "median_col even");

// ── ENRICH: dropna removes rows with nil cells ───────────────────────────────────
let holes = df.from_rows([map{ a: 1, b: 2 }, map{ a: 3 }, map{ a: 5, b: 6 }]);
let clean = df.dropna(holes);
eq(df.nrows(clean), 2, "dropna removes the row missing b");

print "dataframe_enrich_pass";
