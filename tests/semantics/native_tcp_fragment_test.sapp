let TCP=import("stdlib:native_tcp.sapp");
let Net=import("stdlib:net.sapp");
if platform()!="linux" or not TCP.available().ok {print "native_tcp_fragment_unsupported";return;}
let listener=TCP.listen_ipv4("127.0.0.1",0,4);assert(listener.ok,"listener");
let done=channel();let worker=spawn(fn(){
    let client=Net.connect("127.0.0.1:"+str(listener.port));
    tcp_write(client,str_repeat("a",4095)+"\r");
    let pause=channel();recv_timeout(pause.receiver,20);
    tcp_write(client,"\n\r\nZ");tcp_close(client);send(done.sender,true);
});
let peer=TCP.accept_bounded(listener,1000);assert(peer.ok,"accept");
let result=TCP.read_until(peer,"\r\n\r\n",4099,2000);
let tail=TCP.read_exact_text(peer,1,1000);
TCP.close(peer);TCP.close(listener);recv_timeout(done.receiver,2000);join(worker);
assert(result.ok and result.text==str_repeat("a",4095)+"\r\n\r\n","delimiter across native chunk boundary at exact limit");
assert(tail.ok and tail.text=="Z","following byte retained or read separately");
print "native_tcp_fragment_pass";
