// Actual copied bundled providers, with source-hidden failure injection. No net.
if platform()!="linux" {print "pbai_tool_lifetime_skip_linux";os_exit(0);}
let U=import("stdlib:uuid.sapp");let parent=path_dirname(cwd());let exe=env_get("PBLANG_BIN");
let product=env_get("PBAI_RELOAD_PRODUCT");let phase=env_get("PBAI_TOOL_LIFETIME_PHASE");
assert(product=="pblang" or product=="pbai","select product");
assert(type(exe)=="string" and exe!="","trusted runtime required");
if phase!="baseline" {phase="fixed";}
let root=path_join("/tmp","pbai-tool-owned-"+U.v4());
fn process(cmd,args){let argv=["-s","INT","-k","2s","20s",cmd];for x in args {push(argv,x);}return proc_spawn_wait("/usr/bin/timeout",argv);}
fn must(cmd,args){let out=process(cmd,args);assert(out.exit_code==0,"private fixture operation");return out;}
fn build(at){let out=must("/usr/bin/env",["-C",at,exe,"build"]);assert(str_contains(out.stdout,"build ok"),"fixture build");}
fn exercise(){
 fs_mkdirs(root);must("/bin/chmod",["700",root]);
 let fixture=path_join(parent,"pblang/tests/fixtures");
 for repo in ["pblang","pbai"] {
  let at=path_join(root,repo);fs_mkdirs(at);
  must("/bin/cp",["-R",path_join(parent,path_join(repo,"stdlib")),path_join(at,"stdlib")]);
  fs_write(path_join(at,"main.sapp"),fs_read(path_join(fixture,"pbai_student_tool_lifetime_scenario.sapp")));
  let dep=if repo=="pblang" {"stdlib"} else {"../pblang/stdlib"};
  fs_write(path_join(at,"pblang.toml"),"[package]\nname=\"tool-lifetime-fixture\"\nversion=\"0.1.0\"\nentry=\"main.sapp\"\n[dependencies]\nstdlib={path="+json_stringify(dep)+"}\n");
 }
 let owner=path_join(root,"pblang/stdlib/pbai_neural_adapter.sapp");let source=fs_read(owner);
 let signature="fn student_load(artifact) {";let exports="export valid_student_artifact, student_encode, student_decode, student_load;";
 assert(len(str_split(source,signature))==2 and len(str_split(source,exports))==2 and not str_contains(source,"tool_probe_mode"),"exact constructor instrumentation anchors");
 let hooks=fs_read(path_join(fixture,"pbai_student_tool_lifetime_hooks.sapp"))+"\nfn student_load(artifact){return _tool_probe_wrap(_tool_original_student_load(artifact),tool_probe.mode,artifact); }\n";
 fs_write(owner,str_replace_all(str_replace_all(source,signature,"fn _tool_original_student_load(artifact) {"),exports,hooks+"\n"+exports));
 build(path_join(root,"pblang"));build(path_join(root,"pbai"));
 let args=["--die-with-parent","--unshare-net","--ro-bind","/","/","--dev","/dev","--bind",root,root,
  "--tmpfs",path_join(parent,"pblang"),"--tmpfs",path_join(parent,"pbai")];
 let extra=env_get("PBAI_SOURCE_HIDE_ROOT");if type(extra)=="string" and extra!="" {push(args,"--tmpfs");push(args,extra);}
 for x in ["--setenv","PBAI_TOOL_LIFETIME_PHASE",phase,"--setenv","PBAI_STATE_ROOT",path_join(root,"state"),
  "--chdir",path_join(root,product),exe,"run",path_join(root,path_join(product,"main.sapp")),"--allow-all","--deny-net","--deny-http","--deny-sqlite"] {push(args,x);}
 let out=process("/usr/bin/bwrap",args);
 if out.exit_code!=0 {print out.stdout;print str_replace_all(out.stderr,root,"<fixture>");}
 assert(out.exit_code==0 and out.stderr=="" and not str_contains(out.stdout,"synthetic private"),"real tool lifecycle scenario");
 let value=json_parse(out.stdout);assert(value.format=="pbai.student-tool.lifetime.v1" and value.phase==phase and value.cases==24,"complete lifecycle scenario");
 print json_stringify(map{product:product,phase:phase,result:value});
 fs_write(owner,source);assert(fs_read(owner)==source,"private instrumentation restored");
}
let passed=try {exercise();true} catch false;let removed=process("/bin/rm",["-rf","--",root]);
assert(passed and removed.exit_code==0,"private fixture cleanup and lifecycle acceptance");
print "pbai_tool_lifetime_"+product+"_"+phase+"_pass";
