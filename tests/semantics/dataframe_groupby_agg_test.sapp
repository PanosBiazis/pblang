// tests/semantics/dataframe_groupby_agg_test.sapp
//
// dataframe group_by/aggregation completeness:
//   BUG: group_by(df, col, spec_map) silently produced BROKEN rows (only the
//   group key, no aggregates) because group_by only accepted a STRING op
//   applied to all numeric columns — the pandas-style per-column spec map
//   {col: "op"} was ignored.
//   ENRICH: per-column agg specs, multi-key grouping, and more ops
//   (median/std/first/last/count_distinct/mean).

let df = import("stdlib:dataframe.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.0001 { fail(m + " got=[" + str(a) + "] want~[" + str(b) + "]"); } }

fn find_row(rows, keycol, keyval) {
    let i = 0;
    while i < len(rows) {
        if str(try rows[i][keycol] catch nil) == str(keyval) { return rows[i]; }
        i = i + 1;
    }
    return nil;
}

// ── per-column spec map (the bug) ─────────────────────────────────────────────
let d = df.from_rows([
    map{ region: "east", sales: 10, qty: 1 },
    map{ region: "east", sales: 20, qty: 3 },
    map{ region: "west", sales: 5,  qty: 2 }
]);
let g = df.group_by(d, "region", map{ sales: "sum", qty: "max" });
eq(df.nrows(g), 2, "two groups");
let east = find_row(g.rows, "region", "east");
eq(east.sales, 30, "east sales summed");
eq(east.qty, 3, "east qty max");
let west = find_row(g.rows, "region", "west");
eq(west.sales, 5, "west sales summed");
eq(west.qty, 2, "west qty max");

// ── string op form still works (backward compat: all numeric cols) ────────────
let gsum = df.group_by(d, "region", "sum");
let e2 = find_row(gsum.rows, "region", "east");
eq(e2.sales, 30, "string 'sum' still sums sales");
eq(e2.qty, 4, "string 'sum' sums qty too");

// ── group key keeps its original type (numbers stay numbers) ──────────────────
let dn = df.from_rows([map{ y: 2020, v: 1 }, map{ y: 2020, v: 2 }, map{ y: 2021, v: 9 }]);
let gy = df.group_by(dn, "y", map{ v: "sum" });
let r2020 = find_row(gy.rows, "y", 2020);
eq(r2020.y, 2020, "group key stays a number, not the string '2020'");
eq(r2020.v, 3, "2020 summed");

// ── multi-key grouping (array of group columns) ───────────────────────────────
let dm = df.from_rows([
    map{ a: "x", b: "p", n: 1 },
    map{ a: "x", b: "p", n: 4 },
    map{ a: "x", b: "q", n: 2 }
]);
let gm = df.group_by(dm, ["a", "b"], map{ n: "sum" });
eq(df.nrows(gm), 2, "two composite groups");
let xp = find_row(gm.rows, "b", "p");
eq(xp.a, "x", "composite key a preserved");
eq(xp.n, 5, "x/p summed");

// ── new aggregation ops ───────────────────────────────────────────────────────
let ds = df.from_rows([map{k:"a",v:1},map{k:"a",v:2},map{k:"a",v:3},map{k:"a",v:4}]);
let gmed = df.group_by(ds, "k", map{ v: "median" });
eq(find_row(gmed.rows, "k", "a").v, 2.5, "group median");
let gcnt = df.group_by(ds, "k", map{ v: "count" });
eq(find_row(gcnt.rows, "k", "a").v, 4, "group count");
let gfirst = df.group_by(ds, "k", map{ v: "first" });
eq(find_row(gfirst.rows, "k", "a").v, 1, "group first");
let glast = df.group_by(ds, "k", map{ v: "last" });
eq(find_row(glast.rows, "k", "a").v, 4, "group last");

let dd = df.from_rows([map{k:"a",c:"x"},map{k:"a",c:"x"},map{k:"a",c:"y"}]);
eq(find_row(df.group_by(dd, "k", map{ c: "count_distinct" }).rows, "k", "a").c, 2,
   "count_distinct over non-numeric values");

// std (population? sample?) — sample stddev of [2,4,4,4,5,5,7,9] = 2.138...
let dstd = df.from_rows([map{k:"a",v:2},map{k:"a",v:4},map{k:"a",v:4},map{k:"a",v:4},
                         map{k:"a",v:5},map{k:"a",v:5},map{k:"a",v:7},map{k:"a",v:9}]);
approx(find_row(df.group_by(dstd, "k", map{ v: "std" }).rows, "k", "a").v, 2.13809, "sample std");

// ── whole-frame agg() gained the same ops ─────────────────────────────────────
let af = df.agg(ds, map{ v: "median" });
eq(af.v, 2.5, "agg() median");
let af2 = df.agg(ds, map{ v: "first" });
eq(af2.v, 1, "agg() first");

print "dataframe_groupby_agg_pass";
