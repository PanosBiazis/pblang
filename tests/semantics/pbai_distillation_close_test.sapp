// Same behavior probe before/after; default execution requires terminal close.
let AI=import("stdlib/pbai.sapp");let N=import("stdlib:pbai_neural_adapter.sapp");
let R=import("stdlib:resource_scope.sapp");let bound=AI.neural_specialist_bind(N);
let fixed=env_get("PBAI_DISTILL_LIFETIME_PHASE")!="baseline";
fn rejects(f){return try {f();false} catch true;}
fn release(closer,trace){return fn(){trace.calls=trace.calls+1;trace.value=closer();return map{ok:true,value:trace.value};};}
fn body(handle,mode,saved,trace,fixed,valid){return fn(scope){
  saved.handle=handle;saved.predict=handle.predict;saved.evaluate=handle.evaluate;saved.checkpoint=handle.checkpoint;
  assert(map_has(handle,"close")==fixed,"explicit ownership operation present only after fix");
  if fixed {saved.close=handle.close;scope.defer(release(saved.close,trace));}
  saved.report=handle.report;saved.export=handle.checkpoint();saved.prediction=handle.predict([6,0]);saved.metrics=handle.evaluate([map{x:[6,0],y:5}]);
  saved.output=json_stringify([saved.report,saved.export,saved.prediction,saved.metrics]);
  if mode=="bad_predict" {handle.predict([]);}
  if mode=="overlap_evaluate" {handle.evaluate(valid);}
  if mode=="manual_close" and fixed {assert(handle.close(),"caller early close succeeds");}
  return map{ok:true,value:saved.prediction};
 };}
assert(rejects(fn(){throw "calibration";}) and not rejects(fn(){return 1;}),"calibrated observer");
let teacher=N.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);let teacher_text=json_stringify(teacher.artifact);
let seed=N.distill(teacher.artifact,[[0]],[map{x:[7,0],y:4}],map{epochs:4,lr:0.1,temperature:2});
let source=seed.checkpoint();if fixed {assert(seed.close(),"fixture seed owned separately");}
let active=N.student_load(source);let active_prediction=json_stringify(active.predict([6,0]));
let rows=[];let cycle=[];push(cycle,cycle);
let routes=[map{name:"direct",soft:N.distill,supervised:N.distill_supervised},
 map{name:"facade",soft:AI.neural_specialist_distill,supervised:AI.neural_specialist_distill_supervised},
 map{name:"bound",soft:bound.distill,supervised:bound.distill_supervised}];
for route in routes {for supervised in [false,true] {for mode in ["success","bad_predict","overlap_evaluate","manual_close"] {
 let inputs=if supervised {[map{x:[0],y:5}]} else {[[0]]};let valid=[map{x:[7,0],y:5}];
 let options=map{epochs:4,lr:0.1,temperature:2};if supervised {options.hard_weight=1;options.max_grad_norm=1;}
 let input_text=json_stringify([teacher.artifact,inputs,valid,options]);let trace=map{calls:0,value:nil};let saved=map{};
 let handle=if supervised {route.supervised(teacher.artifact,inputs,valid,options)} else {route.soft(teacher.artifact,inputs,valid,options)};
 let result=R.with_scope(body(handle,mode,saved,trace,fixed,valid));
 let failed=mode=="bad_predict" or mode=="overlap_evaluate";
 assert(result.ok!=failed and result.cleanup_ok and result.body_status==(if failed {"exception"} else {"returned"}),"real failures preserve scope contract");
 assert(trace.calls==(if fixed {1} else {0}) and result.cleanups_attempted==trace.calls,"exactly one registered cleanup");
 if fixed {assert(trace.value==(mode!="manual_close"),"early close makes final cleanup a harmless no-op");}
 let predict_closed=rejects(fn(){saved.predict([6,0]);});let export_closed=rejects(saved.checkpoint);
 let evaluate_closed=rejects(fn(){saved.evaluate([map{x:[6,0],y:5}]);});
 assert(predict_closed==fixed and export_closed==fixed and evaluate_closed==fixed,"original aliases observed before diagnostic close");
 if fixed {
  assert(not saved.close(),"terminal repeated close");
  for ids in [nil,[],cycle,"synthetic-private-input"] {assert(rejects(fn(){saved.predict(ids);}),"closed prediction rejects malformed input too");}
  for examples in [nil,[],cycle] {assert(rejects(fn(){saved.evaluate(examples);}),"closed evaluation rejects malformed input too");}
  saved.handle.closed=false;saved.handle.close=fn(){return true;};
  assert(rejects(fn(){saved.handle.predict([6,0]);}) and not saved.close(),"public edits cannot revive original state");
 }
 assert(saved.output==json_stringify([saved.report,saved.export,saved.prediction,saved.metrics]),"detached outputs survive cleanup");
 let restored=N.student_load(saved.export);assert(restored.checkpoint().digest==saved.export.digest and restored.close(),"export stays reloadable");
 assert(json_stringify([teacher.artifact,inputs,valid,options])==input_text and json_stringify(teacher.artifact)==teacher_text,"caller inputs unchanged");
 assert(json_stringify(active.predict([6,0]))==active_prediction,"caller active model preserved across successful and failing distillation use");
 push(rows,map{route:route.name,supervised:supervised,mode:mode,output_digest:sha256(saved.output),
  closed:predict_closed and export_closed and evaluate_closed,cleanup_calls:trace.calls,body_status:result.body_status});
}}}
assert(active.close() and len(rows)==24,"bounded route/variant/failure coverage and caller cleanup");
print json_stringify(map{format:"pbai.distillation-lifetime.v1",phase:if fixed {"fixed"} else {"baseline"},
 cases:len(rows),active_preserved:true,rows:rows,physical_memory_release_verified:false});
