// Linux/x86-64 isolated operational probe. Public availability remains false:
// this test is NOT authorization to enable the production facade globally.
let Native=import("stdlib:linux_process.sapp");
let status=Native.status();
assert(status.operations_attemptable and status.descriptor_open_probe_verified
    and status.pidfd_probe_verified,"native probe prerequisites required");
let files=["tests/fixtures/.scope_native_process.sapp",
    "tests/fixtures/.scope_native_subject.sapp","tests/fixtures/.scope_native_cases.sapp"];
for file in files {assert(not fs_exists(file),"fresh native fixture required");}
let facade=fs_read("stdlib/process.sapp");
let guard="if status == nil or not (try status.available catch false) {";
assert(len(str_split(facade,guard))==2,"one exact public availability gate");
facade=str_replace_all(facade,guard,
    "if status == nil or not status.operations_attemptable or not status.pidfd_probe_verified {");
fs_write(files[0],facade);
fs_write(files[1],str_replace_all(fs_read("stdlib/process_scope.sapp"),
    "import(\"stdlib:process.sapp\")","import(\"tests/fixtures/.scope_native_process.sapp\")"));
let cases=str_replace_all(fs_read("tests/semantics/process_scope_test.sapp"),
    "import(\"stdlib:process_scope.sapp\")","import(\"tests/fixtures/.scope_native_subject.sapp\")");
cases=str_replace_all(cases,"import(\"stdlib:process.sapp\")",
    "import(\"tests/fixtures/.scope_native_process.sapp\")");
fs_write(files[2],cases);
let verified=import("tests/fixtures/.scope_native_cases.sapp");
for file in files {fs_remove(file);}
print "process_scope_isolated_native_probe_pass";
