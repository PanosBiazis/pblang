// tests/semantics/uuid_enrich_test.sapp — enrichment for stdlib/uuid.sapp

let U = import("stdlib/uuid.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let u = U.v4();
if not U.is_valid(u) { fail("v4 is valid"); }

// ── version / variant of a v4 UUID ──────────────────────────────────────────────────
eq(U.version(u), 4, "v4 version is 4");
eq(U.variant(u), "rfc4122", "v4 variant is rfc4122");

// ── is_nil ──────────────────────────────────────────────────────────────────────────
if not U.is_nil(U.nil_uuid()) { fail("nil_uuid is nil"); }
if U.is_nil(u) { fail("v4 is not nil"); }

// ── to_bytes / from_bytes round-trip (to_bytes was previously unexported) ──────────
let bytes = U.to_bytes(u);
eq(len(bytes), 16, "16 bytes");
eq(U.from_bytes(bytes), u, "from_bytes(to_bytes(u)) == u");

// ── urn ───────────────────────────────────────────────────────────────────────────
eq(U.urn(U.nil_uuid()), "urn:uuid:00000000-0000-0000-0000-000000000000", "urn form");

print "uuid_enrich_pass";
