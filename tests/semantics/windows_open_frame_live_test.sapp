// Physical Win64 test: independent held roots, Unicode names and buffer lifetime.
let W=import("stdlib:windows_dirfs.sapp");
if platform()!="windows" {print "windows_open_frame_live_skip_non_windows";}
else {
    let base=".pb-open-frame-"+str_slice(sha256(base64_encode_bytes(random_bytes(16))),0,12);
    fs_mkdirs(base+"/one");fs_mkdirs(base+"/two");
    let first=W.open(base+"/one",false,env_get("PBLANG_WINDOWS_ABI_BRIDGE"));
    let second=W.open(base+"/two",false,env_get("PBLANG_WINDOWS_ABI_BRIDGE"));
    assert(first.ok and second.ok,"two independent owned roots");
    let names=["ascii.bin","δοκιμή.bin","文書.bin","emoji-"+strfromcharcode(0x1F600)+".bin"];
    for i 12 {
        for name in names {
            let bytes=[i,0,255];let other=[255,0,i];
            assert(W.write_atomic(first,name,bytes,false).ok,"first root publication");
            assert(W.write_atomic(second,name,other,false).ok,"second root publication");
            assert(W.read_bytes(first,name,3).bytes==bytes,"first root exact bytes");
            assert(W.read_bytes(second,name,3).bytes==other,"second root exact bytes");
            assert(not W.read_bytes(first,"missing",3).ok,"native missing-file failure");
            assert(len(map_keys(first.abi.allocations))==0,"first root has no retained call buffers");
            assert(len(map_keys(second.abi.allocations))==0,"second root has no retained call buffers");
        }
    }
    for name in names {
        assert(W.remove_file(first,name).ok and W.remove_file(second,name).ok,"owned entries removed");
    }
    assert(W.close(first) and W.close(second),"roots closed");
    fs_remove(base+"/one");fs_remove(base+"/two");fs_remove(base);
    print "windows_open_frame_live_pass";
}
