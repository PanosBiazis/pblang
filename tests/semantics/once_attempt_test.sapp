let F = import("stdlib:functional.sapp");
let P = import("stdlib:pipe.sapp");
fn expect(ok,label) { if not ok { throw "FAIL once-attempt: " + label; } }
let attempts = [0];
let fail_once = F.once(fn(x) { attempts[0] = attempts[0]+1; throw 17; });
let first = try map{ok:true,value:fail_once(1)} catch map{ok:false};
let second = try map{ok:true,value:fail_once(2)} catch map{ok:false};
expect(not first.ok and not second.ok and attempts[0] == 1,"failure cannot become cached nil success");

for factory in [F.once,P.once_attempt] {
    for value in [nil,false,0,"",[1],map{n:1}] {
        let seen = [];
        let run = factory(fn(x) { push(seen,x); return value; });
        expect(run("first") == value and run("later") == value and seen == ["first"],"success cached including nil/false");
    }
    let original = map{n:0};
    let shared = factory(fn(x) { return original; });
    let reference = shared(0);
    reference.n = 9;
    expect(shared(1).n == 9 and original.n == 9,"cached references are not deep copies");
    let effects = [0];
    let nil_failure = factory(fn(x) { effects[0] = effects[0]+1; throw nil; });
    for i 2 {
        let outcome = try map{ok:true,value:nil_failure(i)} catch map{ok:false};
        expect(not outcome.ok,"throw nil remains failure");
    }
    expect(effects[0] == 1,"failed attempts are not retried");
    let holder = map{run:nil};
    let count = [0];
    holder.run = factory(fn(x) {
        count[0] = count[0]+1;
        if count[0] > 1 { throw "reentered callback"; }
        return holder.run(x);
    });
    let recursive = try map{ok:true,value:holder.run(0)} catch map{ok:false};
    let poisoned = try map{ok:true,value:holder.run(0)} catch map{ok:false};
    expect(not recursive.ok and not poisoned.ok and count[0] == 1,"uncaught reentry rejects before second callback");
    let handled = map{run:nil};
    let nested_ok = [true];
    handled.run = factory(fn(x) {
        let nested = try map{ok:true,value:handled.run(x)} catch map{ok:false};
        nested_ok[0] = nested.ok;
        return 42;
    });
    expect(handled.run(0) == 42 and handled.run(1) == 42 and not nested_ok[0],"callback may handle reentry and complete normally");
    let invalid = factory(7);
    for i 2 {
        let rejected = try map{ok:true,value:invalid(0)} catch map{ok:false};
        expect(not rejected.ok,"non-callable callback never becomes nil success");
    }
}
// Preserve the distinct legacy pipe.once retry-after-failure contract.
let retries = [0];
let legacy = P.once(fn(x) { retries[0] = retries[0]+1; if retries[0] == 1 { throw 9; } return x; });
let rejected = try map{ok:true,value:legacy(3)} catch map{ok:false};
expect(not rejected.ok and legacy(4) == 4 and legacy(5) == 4 and retries[0] == 2,"legacy retry semantics unchanged");
print "once_attempt_pass";
