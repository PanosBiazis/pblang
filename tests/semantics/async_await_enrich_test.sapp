// tests/semantics/async_await_enrich_test.sapp — enrichment for stdlib/async_await.sapp
//
// async_await is already rich (map/then/await_all/any/timeouts/from_value/first_ok).
// This adds non-raising settlement (settle / all_settled) and error recovery
// (catch_error), which compose with the existing futures.

let aa = import("stdlib/async_await.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base async_spawn + await still works ─────────────────────────────────────────
eq(aa.await(aa.async_spawn(fn() { return 6 * 7; })), 42, "async_spawn + await");

// ── ENRICH: settle never raises ──────────────────────────────────────────────────
let oks = aa.settle(aa.async_spawn(fn() { return 7; }));
eq(oks.ok, true, "settle ok flag"); eq(oks.value, 7, "settle value");
let bads = aa.settle(aa.async_spawn(fn() { throw "boom"; }));
eq(bads.ok, false, "settle reports failure without raising");

// ── ENRICH: all_settled ──────────────────────────────────────────────────────────
let r = aa.all_settled([
    aa.async_spawn(fn() { return 1; }),
    aa.async_spawn(fn() { throw "e"; }),
    aa.async_spawn(fn() { return 3; })
]);
eq(r[0].ok, true, "all_settled[0] ok"); eq(r[0].value, 1, "all_settled[0] value");
eq(r[1].ok, false, "all_settled[1] failed (not raised)");
eq(r[2].ok, true, "all_settled[2] ok"); eq(r[2].value, 3, "all_settled[2] value");

// ── ENRICH: catch_error recovers from a failed future ────────────────────────────
let recovered = aa.catch_error(aa.async_spawn(fn() { throw "boom"; }), fn(e) { return "fallback"; });
eq(aa.await(recovered), "fallback", "catch_error recovers a failure to a value");
let passed = aa.catch_error(aa.async_spawn(fn() { return 42; }), fn(e) { return -1; });
eq(aa.await(passed), 42, "catch_error passes a success through unchanged");

print "async_await_enrich_pass";
