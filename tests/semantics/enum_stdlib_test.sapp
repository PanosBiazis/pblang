let en = import("stdlib:enum.sapp");

// Define enum
let Direction = en.define("Direction", ["North", "South", "East", "West"]);

// Create variants
let north = en.variant(Direction, "North", nil);
let east = en.variant(Direction, "East", map{ degrees: 90 });

// is_variant
assert(en.is_variant(north, "North") == true, "should be North variant");
assert(en.is_variant(north, "South") == false, "should not be South");

// variant_name
assert(en.variant_name(north) == "North", "variant_name should be North");

// match
let result = en.match(north, map{
    North: fn() { return "going north"; },
    South: fn() { return "going south"; },
    East:  fn() { return "going east"; },
    West:  fn() { return "going west"; }
});
assert(result == "going north", "match should return 'going north'");

// match with wildcard
let result2 = en.match(east, map{
    North: fn() { return "north"; },
    _:     fn() { return "other"; }
});
assert(result2 == "other", "wildcard should match");

// Invalid variant error
let bad = try en.variant(Direction, "Up", nil) catch "caught";
assert(bad == "caught", "invalid variant should error");

// ── Option type ──────────────────────────────────────────────
let s = en.some(42);
assert(en.is_some(s) == true, "some should be some");
assert(en.is_none(s) == false, "some should not be none");
assert(en.unwrap(s) == 42, "unwrap should return 42");
assert(en.unwrap_or(s, 0) == 42, "unwrap_or on some should return value");

let n = en.none();
assert(en.is_none(n) == true, "none should be none");
assert(en.unwrap_or(n, 99) == 99, "unwrap_or on none should return default");

// map_opt
let doubled = en.map_opt(s, fn(v) { return v * 2; });
assert(en.unwrap(doubled) == 84, "map_opt should double value");

// ── Result type ──────────────────────────────────────────────
let ok = en.ok(100);
assert(en.is_ok(ok) == true, "ok should be ok");
assert(en.is_err(ok) == false, "ok should not be err");
assert(en.unwrap_ok(ok) == 100, "unwrap_ok should return 100");

let bad_res = en.err("something failed");
assert(en.is_err(bad_res) == true, "err should be err");
assert(en.unwrap_err(bad_res) == "something failed", "unwrap_err should return message");

print "enum stdlib tests passed";
