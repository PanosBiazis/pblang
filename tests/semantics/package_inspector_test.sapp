let Inspector = import("stdlib:package_inspector.sapp");

fn require(value, message) {
    if not value { throw "package_inspector_test: " + message; }
}

fn rejected(callable) { return (try { callable(); false } catch true); }

let catalog = [
    map{ name: "alpha", version: "1.0.0", source_kind: "local" },
    map{ name: "alpha", version: "1.2.0", source_kind: "registry" },
    map{ name: "alpha", version: "2.0.0-rc.1", source_kind: "registry" },
    map{ name: "alpha", version: "1.2.0", source_kind: "registry" },
    map{ name: "@scope/beta", version: "0.4.1", source_kind: "git" }
];
let normalized = Inspector.normalize_catalog(catalog);
require(len(normalized) == 4, "duplicate name/version records must collapse");
require(len(catalog) == 5, "normalization must not mutate caller input");
require(Inspector.latest("alpha", catalog) == "1.2.0", "stable lookup excludes prereleases");
require(Inspector.latest("alpha", catalog, map{ include_prerelease: true }) == "2.0.0-rc.1",
    "explicit prerelease lookup includes release candidates");

let update = Inspector.evaluate("alpha", "1.0.0", "^1.0.0", catalog);
require(update.status == "update-available" and update.latest_compatible == "1.2.0",
    "older compatible installations must report an update");
require(Inspector.evaluate("alpha", "1.2.0", "^1.0.0", catalog).status == "current",
    "latest compatible installation must report current");
require(Inspector.evaluate("alpha", nil, "^1.0.0", catalog).status == "missing",
    "missing installations must be explicit");
require(Inspector.evaluate("alpha", "2.0.0", "^1.0.0", catalog).status == "incompatible-installed-version",
    "installed versions outside the requirement must fail closed");

let manifest = "[package]\nname = \"demo\"\nversion = \"1.2.3\"\nentry = \"main.sapp\"\n\n"
    + "[dependencies]\nstdlib = { path = \"../../stdlib\" }\nalpha = \"^1.0.0\"\n";
let private_manifest = Inspector.inspect_manifest_text(manifest);
require(private_manifest.ok and private_manifest.dependency_count == 2,
    "valid package manifest must be summarized");
require(len(private_manifest.dependency_names) == 0
    and not private_manifest.privacy.dependency_names_included,
    "dependency names must be hidden by default");
let named_manifest = Inspector.inspect_manifest_text(manifest, map{ include_dependency_names: true });
require(len(named_manifest.dependency_names) == 2,
    "dependency names require explicit opt-in");

require(rejected(fn() { Inspector.normalize_catalog([
    map{ name: "../escape", version: "1.0.0" }
]); }), "path-like package names must fail");
require(rejected(fn() { Inspector.normalize_catalog([
    map{ name: "alpha", version: "01.0.0" }
]); }), "non-strict semantic versions must fail");
require(rejected(fn() { Inspector.evaluate("alpha", "1.0.0", "1.x", catalog); }),
    "unsupported requirements must fail");
require(not Inspector.inspect_manifest_text("[package]\nname = \"x\"\nversion = \"01.0.0\"\n").ok,
    "manifest inspection must enforce strict semantic versions");

let caps = Inspector.capabilities();
require(caps.strict_semver and not caps.process_execution and not caps.dynamic_import
    and not caps.arbitrary_path_read,
    "capabilities must expose the non-executing trust boundary");

print "package_inspector_pass";
