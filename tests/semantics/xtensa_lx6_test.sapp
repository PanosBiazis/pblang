let X = import("stdlib:xtensa_lx6.sapp");

assert(X.movi(2,0)==[0x0c,0x02] and X.movi(6,72)==[0x4c,0x86]
       and X.movi(8,96)==[0x82,0xa0,0x60], "movi encodings match Xtensa base ISA");
assert(X.l32i_n(6,7,4)==[0x68,0x17] and X.s32i_n(8,9,60)==[0x89,0xf9],
       "compact word memory encodings");
assert(X.l32i(6,7,64)==[0x62,0x27,0x10]
       and X.s32i(8,9,76)==[0x82,0x69,0x13],
       "full word memory encodings extend state access without truncation");
assert(X.l8ui(4,2,0)==[0x42,0x02,0x00] and X.s8i(8,9,255)==[0x82,0x49,0xff],
       "byte memory encodings");
assert(X.extui(10,11,31,1)==[0xb0,0xaf,0x05], "bit extraction encoding");
assert(X.add_regs(5,5,4)==[0x40,0x55,0x80]
       and X.sub_regs(5,5,4)==[0x40,0x55,0xc0]
       and X.sub_regs(2,3,4)==[0x40,0x23,0xc0]
       and X.and_regs(3,4,5)==[0x50,0x34,0x10], "register arithmetic encodings");

let a=X.assembler();
X.label(a,"start"); X.emit(a,X.movi(2,1));
X.branch_nonzero(a,2,"done"); X.emit(a,X.movi(3,2)); X.label(a,"done");
X.jump(a,"start");
let code=X.finish(a);
assert(code==[0x0c,0x12,0x56,0x12,0x00,0x0c,0x23,0x46,0xfd,0xff],
       "label fixups encode deterministic forward branch and backward jump");

print "xtensa_lx6_pass";
