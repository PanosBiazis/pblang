let T = import("stdlib:thread.sapp");
fn delayed(sender) {
    return fn() { sleep_ms(40); send(sender,true); return 7; };
}
fn failing_body(sender, handles, escaped, mode) {
    return fn(sc) {
        array_push(escaped,sc);
        if mode == "consumed" {
            let first = sc.launch(sc,fn(){return 1;});
            join(first);
        }
        let handle = sc.launch(sc,delayed(sender));
        array_push(handles,handle);
        if mode == "body" { throw "scope body fixture failure"; }
        if mode == "spawn" { sc.launch(sc,7); }
    };
}
for mode in ["body","spawn","consumed"] {
    let signal = channel_buffered(1);
    let handles = []; let escaped = [];
    let body = failing_body(signal.sender,handles,escaped,mode);
    let failed = try {T.scope(body);false} catch true;
    let settled = recv_timeout(signal.receiver,0);
    let was_joined = true;
    for handle in handles {
        // Also reap baseline workers before asserting, so a regression run is clean.
        if (try {join(handle);true} catch false) { was_joined=false; }
    }
    channel_close(signal.sender);
    assert(failed,"scope failure reported");
    assert(settled==true,"scope waits after body/spawn/aggregate failure: "+mode);
    assert(was_joined,"scope consumed all launched handles: "+mode);
    assert((try {T.scope_launch(escaped[0],fn(){return 1;});false} catch true),"failed scope is closed");
}
// Successful results retain launch order, nil/false and native error-map shape.
let out = T.scope(fn(sc){
    sc:launch(fn(){sleep_ms(15);return nil;});
    sc:launch(fn(){return false;});
    sc:launch(fn(){throw "task fixture failure";});
    sc:launch(fn(){return map{ok:false,error:"ordinary data"};});
});
assert(len(out)==4 and out[0]==nil and out[1]==false,"ordered nil/false results");
assert(out[2].ok==false and type(out[2].error)=="string","worker error result preserved");
assert(out[3].error=="ordinary data","error-shaped data preserved");
let saved=[];
fn save_scope(sc){array_push(saved,sc);}
assert(T.scope(save_scope)==[],"empty scope");
assert((try {T.scope_launch(saved[0],fn(){return 1;});false} catch true),"successful scope is closed");
// Explicit launch avoids the retained compiler's nested colon capture defect.
let recovered = T.scope(fn(sc){
    let rejected = try {T.scope_launch(sc,7);false} catch true;
    assert(rejected,"caller can recover from invalid launch");
    T.scope_launch(sc,fn(){return 9;});
});
assert(recovered==[9],"valid launch after handled failure");
for body in [nil,false,7,"body",map{}] {
    assert((try {T.scope(body);false} catch true),"invalid body rejected");
}
// Public aggregate join must also settle handles after an invalid entry.
for invalid_first in [true,false] {
    let signal=channel_buffered(1);
    let h=spawn(delayed(signal.sender));
    let handles=if invalid_first {[nil,h]} else {[h,nil]};
    let failed=try {T.thread_join_all(handles);false} catch true;
    let settled=recv_timeout(signal.receiver,0);
    let was_joined=not (try {join(h);true} catch false);
    channel_close(signal.sender);
    assert(failed and settled==true and was_joined,"aggregate joins despite invalid entry");
}
assert(T.thread_join_all([])==[],"empty aggregate");
for invalid in [nil,false,1,map{}] {
    assert((try {T.thread_join_all(invalid);false} catch true),"invalid aggregate rejected");
}
print "thread_scope_ownership_pass";
