let L=import("stdlib:table_lookup.sapp");let R=import("stdlib:table_lookup_review.sapp");let C=import("stdlib:sheet_csv.sapp");let S=import("stdlib:sheet_document.sapp");let D=import("stdlib:text_document.sapp");
fn rejects(f) {let bad=false;try {f();}catch {bad=true;}assert(bad,"invalid mapping rejected");}
let a=C.decode("id,secret-left\nA,private-alpha\nC,private-beta\nB,private-gamma\nA,private-delta");let b=C.decode("id,secret-reference\nB,\nA,private-label");let source=[S.encode(a),S.encode(b)];
let left=L.join(a,b,0,0,[1]);assert(left.reference_rows==[2,nil,1,2] and left.unmatched_source_rows==[2],"exact reference mapping, repeated left keys and missing row");assert(R.validate(left),"valid left report");
let inner=L.join(a,b,0,0,[1],"inner");assert(inner.reference_rows==[2,1,2] and inner.source_rows==[1,3,4] and inner.unmatched_source_rows==[2],"inner retains omitted row metadata");
let doc=R.to_document(inner,"Έλεγχος αντιστοίχισης");let text=D.to_text(doc);assert(len(doc.blocks)==5 and str_contains(doc.blocks[2].text,"Left data row 2: NO MATCH; omitted") and str_contains(doc.blocks[3].text,"reference data row 1; output data row 2"),"all source rows reviewed in source order");
assert(not str_contains(text,"private-") and not str_contains(text,"secret-") and str_contains(text,"MATCH can contain blank values"),"review omits input values and headers by construction");assert(D.decode(D.encode(doc))==doc,"Writer roundtrip");doc.blocks[1].text="Changed";assert([S.encode(a),S.encode(b)]==source and left.reference_rows==[2,nil,1,2],"detached Writer and retained sources");
let empty=L.join(C.decode("id"),b,0,0,[1],"inner");assert(len(R.to_document(empty).blocks)==1,"header-only input produces summary");let none=L.join(C.decode("id\nX\nY"),b,0,0,[1],"inner");assert(none.source_rows==[] and none.unmatched_source_rows==[1,2] and len(R.to_document(none).blocks)==3,"zero output retains every missing source row");
for mode in ["left","inner"] {let large=S.create(32,1);large.cells[0][0]="id";for i in range(1,32) {large.cells[i][0]=if i%2==0 {"A"} else {"X"};}let result=L.join(large,b,0,0,[1],mode);let full=R.to_document(result);assert(len(full.blocks)==32 and str_contains(full.blocks[31].text,"Left data row 31"),"maximum complete review");}
for value in [nil,[],map{},map{format:"future"}] {rejects(fn(){R.to_document(value);});}
for key in ["matched","unmatched","source_rows","reference_rows","unmatched_source_rows","row_matches","mode","document"] {let bad=L.join(a,b,0,0,[1]);bad[key]=nil;rejects(fn(){R.validate(bad);});}
for badflag in [0,1,"true",nil] {let bad=L.join(a,b,0,0,[1]);bad.row_matches[0]=badflag;rejects(fn(){R.validate(bad);});}
for rows in [[1,2,3],[1,2,3,3],[1,2,3,5],[0,2,3,4],[1,2,3,4.5]] {let bad=L.join(a,b,0,0,[1]);bad.source_rows=rows;rejects(fn(){R.validate(bad);});}
for refs in [[2,nil,1],[0,nil,1,2],[32,nil,1,2],[2,1,1,2],[nil,nil,1,2]] {let bad=L.join(a,b,0,0,[1]);bad.reference_rows=refs;rejects(fn(){R.validate(bad);});}
for missing in [[],[1],[2,2],[0],[5]] {let bad=L.join(a,b,0,0,[1]);bad.unmatched_source_rows=missing;rejects(fn(){R.validate(bad);});}
let inner_bad=L.join(a,b,0,0,[1],"inner");inner_bad.row_matches[0]=false;inner_bad.reference_rows[0]=nil;rejects(fn(){R.validate(inner_bad);});
for count in [-1,0,4,32,0.5,"3",true] {let bad=L.join(a,b,0,0,[1]);bad.matched=count;rejects(fn(){R.validate(bad);});}
for title in [""," ",nil,str_repeat("界",86),str_repeat("x",257),str_repeat(" ",65536),"bad\u0000title"] {rejects(fn(){R.to_document(left,title);});}
assert([S.encode(a),S.encode(b)]==source,"failed operations retain inputs");print "table_lookup_review_pass";

assert(R.to_document(left,str_repeat("x",256)).title==str_repeat("x",256),"256 byte title accepted");
assert(R.to_document(left,str_repeat("界",85)).title==str_repeat("界",85),"255 byte Unicode title accepted");
let snapshot=json_stringify(inner);let detached=R.to_document(inner);detached.blocks[0].text="changed";assert(json_stringify(inner)==snapshot,"review mutation leaves mapping untouched");
