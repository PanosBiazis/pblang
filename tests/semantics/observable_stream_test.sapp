let obs = import("stdlib:observable.sapp");

let count = obs.ref(0);
let seen = [];
let unwatch = obs.watch(count, fn(old_value, new_value) {
    array_push(seen, [old_value, new_value]);
});

obs.set(count, 1);
obs.update(count, fn(x) { return x + 4; });
assert(len(seen) == 2, "watch should see set and update");
assert(seen[0][0] == 0 and seen[0][1] == 1, "first watch event");
assert(obs.get(count) == 5, "update result");

unwatch();
obs.set(count, 6);
assert(len(seen) == 2, "unsubscribe should stop events");

let batched = obs.ref(10);
let batch_events = [];
obs.watch(batched, fn(old_value, new_value) {
    array_push(batch_events, [old_value, new_value]);
});
obs.batch([batched], fn() {
    obs.set(batched, 11);
    obs.set(batched, 12);
    obs.set(batched, 13);
});
assert(len(batch_events) == 1, "batch should coalesce notifications");
assert(batch_events[0][0] == 10 and batch_events[0][1] == 13, "batch old/new values");

let a = obs.ref(2);
let b = obs.ref(3);
let sum = obs.computed([a, b], fn() { return obs.get(a) + obs.get(b); });
assert(obs.get(sum) == 5, "initial computed value");
obs.set(a, 7);
assert(obs.get(sum) == 10, "computed updates");

let source = obs.subject();
let doubled = obs.map_stream(source, fn(x) { return x * 2; });
let even = obs.filter_stream(doubled, fn(x) { return x % 4 == 0; });
let totals = obs.scan_stream(even, fn(acc, x) { return acc + x; }, 0);
let stream_values = [];
obs.subscribe(totals, fn(x) { array_push(stream_values, x); });
obs.emit(source, 1);
obs.emit(source, 2);
obs.emit(source, 3);
obs.emit(source, 4);
assert(stream_values == [4, 12], "map/filter/scan stream pipeline");

let left = obs.subject();
let right = obs.subject();
let latest = obs.combine_latest(left, right, fn(x, y) { return x + y; });
let latest_values = [];
obs.subscribe(latest, fn(x) { array_push(latest_values, x); });
obs.emit(left, 10);
obs.emit(right, 1);
obs.emit(right, 2);
obs.emit(left, 20);
assert(latest_values == [11, 12, 22], "combine_latest values");

print "observable_stream_pass";
