// tests/semantics/registry_server_enrich_test.sapp — wave 2 for stdlib/registry_server.sapp

let RS = import("stdlib/registry_server.sapp");
let F = import("stdlib/fs.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let dir = "tests/fixtures/_regsrv2";
let cfg = RS.RegistryConfig(dir);
RS.registry_init(cfg);
F.write(dir + "/pkg.tar.gz", "dummy");

eq(RS.package_count(cfg), 0, "fresh registry has 0 packages");
if RS.has_package(cfg, "foo") { fail("no package yet"); }

RS.registry_add_package(cfg, "foo", "1.0.0", "d", "a", dir + "/pkg.tar.gz");
RS.registry_add_package(cfg, "bar", "2.0.0", "d", "a", dir + "/pkg.tar.gz");
eq(RS.package_count(cfg), 2, "two packages");
if not RS.has_package(cfg, "foo") { fail("foo present"); }
if RS.has_package(cfg, "missing") { fail("missing absent"); }

// cleanup
if F.exists(dir + "/pkg.tar.gz") == true { F.remove(dir + "/pkg.tar.gz"); }
if F.exists(dir + "/packages/foo-1.0.0.tar.gz") == true { F.remove(dir + "/packages/foo-1.0.0.tar.gz"); }
if F.exists(dir + "/packages/bar-2.0.0.tar.gz") == true { F.remove(dir + "/packages/bar-2.0.0.tar.gz"); }

print "registry_server_enrich_pass";
