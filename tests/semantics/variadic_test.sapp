// Test: variadic functions (...args)
// fn sum(...args) — args is an array of all passed arguments

fn sum_all(...nums) {
    let total = 0;
    for i len(nums) { total += nums[i]; }
    return total;
}

assert(sum_all() == 0, "sum() should be 0");
assert(sum_all(1) == 1, "sum(1) should be 1");
assert(sum_all(1, 2, 3) == 6, "sum(1,2,3) should be 6");
assert(sum_all(10, 20, 30, 40) == 100, "sum(10,20,30,40) should be 100");

// Variadic with required params before
fn log_message(level, ...messages) {
    let out = "[" + level + "] ";
    for i len(messages) {
        if i > 0 { out += " "; }
        out += str(messages[i]);
    }
    return out;
}

assert(log_message("INFO") == "[INFO] ", "log with no messages");
assert(log_message("ERROR", "disk full") == "[ERROR] disk full", "log with one message");
assert(log_message("WARN", "a", "b", "c") == "[WARN] a b c", "log with three messages");

// Variadic collecting args as array
fn make_list(...items) {
    return items;
}

let lst = make_list(1, 2, 3, 4, 5);
assert(len(lst) == 5, "make_list should return array of 5");
assert(lst[0] == 1, "first item should be 1");
assert(lst[4] == 5, "last item should be 5");

// Variadic with defaults
fn tagged(...tags) {
    let result = "";
    for i len(tags) {
        if i > 0 { result += ", "; }
        result += tags[i];
    }
    return result;
}

assert(tagged("rust", "python", "pblang") == "rust, python, pblang", "tagged should join");

print "variadic_pass";
