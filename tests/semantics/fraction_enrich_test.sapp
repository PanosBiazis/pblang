// tests/semantics/fraction_enrich_test.sapp — enrichment for stdlib/fraction.sapp
// Adds abs/cmp/min/max, sum/product, and floor/ceil/round (floor toward -inf).

let fr = import("stdlib/fraction.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eqf(a, b, m) { if not fr.eq(a, b) { fail(m); } }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base still works ─────────────────────────────────────────────────────────────
eqf(fr.add(fr.of(1, 3), fr.of(1, 6)), fr.of(1, 2), "add 1/3+1/6 = 1/2");

// ── ENRICH: abs / cmp / min / max ────────────────────────────────────────────────
eqf(fr.abs(fr.of(-3, 4)), fr.of(3, 4), "abs");
eq(fr.cmp(fr.of(1, 2), fr.of(1, 3)), 1, "cmp greater");
eq(fr.cmp(fr.of(1, 3), fr.of(1, 2)), -1, "cmp less");
eq(fr.cmp(fr.of(2, 4), fr.of(1, 2)), 0, "cmp equal (reduced)");
eqf(fr.min(fr.of(1, 2), fr.of(1, 3)), fr.of(1, 3), "min");
eqf(fr.max(fr.of(1, 2), fr.of(1, 3)), fr.of(1, 2), "max");

// ── ENRICH: sum / product over a list ────────────────────────────────────────────
eqf(fr.sum([fr.of(1, 2), fr.of(1, 3), fr.of(1, 6)]), fr.of(1, 1), "sum = 1");
eqf(fr.product([fr.of(2, 3), fr.of(3, 4)]), fr.of(1, 2), "product = 1/2");

// ── ENRICH: floor / ceil / round (bigint results, floor toward -inf) ─────────────
eq(fr.floor(fr.of(7, 3)), bigint(2), "floor 7/3 = 2");
eq(fr.floor(fr.of(-7, 3)), bigint(-3), "floor -7/3 = -3 (toward -inf)");
eq(fr.ceil(fr.of(7, 3)), bigint(3), "ceil 7/3 = 3");
eq(fr.ceil(fr.of(-7, 3)), bigint(-2), "ceil -7/3 = -2");
eq(fr.round(fr.of(7, 3)), bigint(2), "round 7/3 = 2");
eq(fr.round(fr.of(5, 3)), bigint(2), "round 5/3 = 2");
eq(fr.round(fr.of(1, 2)), bigint(1), "round 1/2 = 1 (half up)");

print "fraction_enrich_pass";
