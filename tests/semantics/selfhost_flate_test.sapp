// The real flate module must compile before its exports can be resolved.
let FE = import("stdlib:compiler/selfhost_frontend.sapp");
let F = import("stdlib:flate.sapp");
let checked = FE.frontend_compile(fs_read("stdlib/flate.sapp"));
assert(checked.ok, "flate must pass the self-hosted typechecker");
let typed = FE.frontend_compile("let flags:map<string,bool> = map{ready:false}; flags.ready=[1];");
assert(not typed.ok, "concrete map value types remain enforced");
let source = "let F=import(\"stdlib:flate.sapp\");"
    + "let raw=[1,2,3,1,2,3,1,2,3,0,255];"
    + "print F.crc32([49,50,51,52,53,54,55,56,57]);"
    + "print F.adler32(raw);"
    + "print F.zlib_decode(F.zlib_encode(raw),len(raw),true);"
    + "print F.zlib_decode(F.zlib_encode(raw),len(raw),true);"
    + "print F.gzip_decode(F.gzip_encode(raw),len(raw),true);"
    + "print (try F.zlib_decode([120,156,3,0,0,0,0,0],0,true) catch \"rejected\");";
let raw = [1,2,3,1,2,3,1,2,3,0,255];
let result = FE.frontend_run(source);
assert(result.ok, "self-hosted flate executes");
assert(result.output == [3421780262,F.adler32(raw),raw,raw,raw,"rejected"],
    "checksum, repeated cache use, zlib/gzip and malformed trailer parity");
print "selfhost_flate_pass";
