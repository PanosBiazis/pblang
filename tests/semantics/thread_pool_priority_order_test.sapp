let P=import("stdlib:thread_pool.sapp");
fn task(value) { return fn(){return value;}; }
fn failing_task(value) { return fn(){if value%17==0 {throw "task failed";}return value;}; }
// Independent legacy reference for stable numeric ordering.
fn expected(priorities) {
    let order=[];
    for i len(priorities) {
        array_push(order,i);
        let at=i;
        while at>0 and priorities[order[at-1]]<priorities[i] {
            order[at]=order[at-1];at=at-1;
        }
        order[at]=i;
    }
    return order;
}
let nan=num_sqrt(-1);let inf=num_exp(1000);
assert(nan!=nan and inf>1000000,"non-finite fixtures");
for count in [0,1,2,31,32,33,63,65,97,257] {
    for pattern in ["ascending","descending","equal","mixed","barriers","infinite"] {
        let priorities=[];
        for i count {
            let priority=(i*37)%19-9;
            if pattern=="ascending" {priority=i;} elif pattern=="descending" {priority=count-i;}
            elif pattern=="equal" {priority=0;}
            if pattern=="barriers" and i%13==0 {priority=nan;}
            if pattern=="infinite" {
                if i%11==0 {priority=inf;} elif i%7==0 {priority=0-inf;}
            }
            array_push(priorities,priority);
        }
        let pool=P.new_thread_pool(4);
        for i count {P.submit_priority(pool,task(i),priorities[i]);}
        if pattern=="barriers" and count>1 {
            assert((try {P.run_all(pool);false} catch true),"NaN comparison rejected");
            assert(P.stats(pool).pending==count,"NaN fails before callbacks");
            continue;
        }
        let result=P.run_all(pool);
        assert(result.results==expected(priorities),"stable ordering: "+pattern+" "+str(count));
        assert(result.completed==count and result.failed==0,"complete accounting");
        for i count {assert(pool.tasks[i].id==i+1 and pool.tasks[i].result==i,"task records unmoved");}
        assert(P.run_all(pool).completed==0,"no replay");
    }
}
// Stable collection also applies to actual parallel workers and failures.
let priorities=[];let pool=P.new_thread_pool(4);
for i 65 {let priority=(i*13)%9;array_push(priorities,priority);P.submit_priority(pool,failing_task(i),priority);}
let wanted=[];let all=[];
for i in expected(priorities) {
    if i%17!=0 {array_push(wanted,i);array_push(all,i);} else {array_push(all,nil);}
}
let result=P.run_parallel(pool);
assert(result.results==wanted and pool.results==all,"parallel result order and failures");
assert(result.completed==61 and result.failed==4,"parallel accounting");
assert(P.run_parallel(pool).completed==0,"parallel no replay");
// Previously completed tasks are excluded when a new pending batch arrives.
let repeated=P.new();P.submit(repeated,task(99));P.run_all(repeated);
for i 65 {P.submit_priority(repeated,task(i),i);}
let ranks=[];for i 65 {array_push(ranks,i);}
assert(P.run_all(repeated).results==expected(ranks),"new batch ordering");
assert(repeated.tasks_completed==66,"old task not rerun");
let rejected=P.new();
assert((try {P.submit_priority(rejected,task(1),"bad");false} catch true),"non-numeric priority rejected");
assert(len(rejected.tasks)==0,"rejection before queue mutation");
P.shutdown(rejected);
assert((try {P.run_all(rejected);false} catch true),"shutdown preserved");
print "thread_pool_priority_order_pass";
