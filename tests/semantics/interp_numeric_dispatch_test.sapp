let INT = import("stdlib/compiler/interp.sapp");

fn fail(message) { throw "FAIL interp-numeric-dispatch: " + message; }
let ast = INT.compile_program(
    "let total = 0; let i = 0; while i < 1000 { total = total + i; i = i + 1; } "
    + "if total != 499500 { missing(); }"
);
let loop = ast.stmts[2];
if loop.cond["@ip"] == nil or not loop["@wq"] { fail("plain loop was not prepared"); }
if loop["@wb"][0]["@sa"] == nil or loop["@wb"][1]["@sa"] == nil { fail("assignment fast path was not prepared"); }
if INT.eval_ast(ast) != true or INT.eval_ast(ast) != true { fail("prepared loop result mismatch"); }

// Dynamic strings still use the same `+` semantics even when the leaf plan is used.
let strings = INT.compile_program("let a = \"pb\"; let b = \"lang\"; let c = a + b; if c != \"pblang\" { missing(); }");
if INT.eval_ast(strings) != true { fail("leaf plan changed string addition semantics"); }

// Complex nested operands stay on the generic evaluator.
let nested = INT.compile_program("let a = 1; let b = 2; let c = (a + b) * 3; if c != 9 { missing(); }");
if nested.stmts[2].value["@ip"] != nil { fail("nested binary received an unsafe leaf plan"); }
if INT.eval_ast(nested) != true { fail("generic fallback mismatch"); }

// Preserve the current numeric contract for modulo by zero (a non-reflexive
// numeric result) rather than introducing an optimizer-only exception.
let bad = INT.compile_program("let a = 7; let b = 0; let c = a % b; if c == c { missing(); }");
if INT.eval_ast(bad) != true { fail("modulo-by-zero numeric parity changed"); }
print "interp_numeric_dispatch_pass";
