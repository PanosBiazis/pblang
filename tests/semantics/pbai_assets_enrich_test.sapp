// tests/semantics/pbai_assets_enrich_test.sapp — enrichment for stdlib/pbai_assets.sapp
// Adds is_available (predicate) and format_summary (pure one-line formatter).

let assets = import("stdlib/pbai_assets.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── ENRICH: is_available on a fake root is false (no filesystem dependency) ───────
eq(assets.is_available("/definitely/not/a/pbai/asset/root"), false, "is_available false for bogus root");

// ── ENRICH: format_summary (pure, works on a constructed summary map) ─────────────
eq(assets.format_summary(map{ available: false }), "pbAI assets: unavailable", "format unavailable");
let s = map{ available: true, model_type: "gpt2", layers: 12, heads: 8, embedding: 768, vocab_size: 50257 };
let line = assets.format_summary(s);
if str_index_of(line, "gpt2 12L/8H") < 0 { fail("format_summary should include arch shape, got: " + line); }
if str_index_of(line, "vocab=50257") < 0 { fail("format_summary should include vocab, got: " + line); }

print "pbai_assets_enrich_pass";
