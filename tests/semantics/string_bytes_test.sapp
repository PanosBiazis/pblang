// tests/semantics/string_bytes_test.sapp — binary string<->bytes conversion builtins.
//
// pblang strings are guaranteed UTF-8. To handle binary data correctly,
// code must round-trip through byte arrays (numbers 0..255), not through
// strfromcharcode (which treats a number as a *codepoint*, not a *byte*).
// These builtins close that gap:
//   str_to_bytes(s)         -> array<number 0..255>   (the UTF-8 bytes of s)
//   bytes_to_str(arr)       -> string                 (UTF-8 from raw bytes)
//   base64_encode_bytes(arr)-> string                 (base64 of raw bytes)

let strings = import("stdlib:strings.sapp");

// ── str_to_bytes: ASCII is one byte per char ──────────────────────────────────
let a = str_to_bytes("A");
if len(a) != 1 or a[0] != 65 {
    throw "FAIL str_to_bytes ascii: " + str(a);
}

// ── str_to_bytes: multi-byte UTF-8 expands ('é' = 0xC3 0xA9) ──────────────────
let e = str_to_bytes("é");
if len(e) != 2 or e[0] != 195 or e[1] != 169 {
    throw "FAIL str_to_bytes multibyte: " + str(e);
}

// ── bytes_to_str inverts str_to_bytes ─────────────────────────────────────────
if bytes_to_str([195, 169]) != "é" {
    throw "FAIL bytes_to_str multibyte: " + bytes_to_str([195, 169]);
}
let round = bytes_to_str(str_to_bytes("héllo wörld"));
if round != "héllo wörld" {
    throw "FAIL str<->bytes round trip: " + round;
}

// ── bytes_to_str rejects invalid UTF-8 ────────────────────────────────────────
let bad = try {
    bytes_to_str([195, 40]);
    false
} catch true;
if bad == false {
    throw "FAIL bytes_to_str should reject invalid UTF-8";
}

// ── base64_encode_bytes agrees with base64_encode for ASCII payloads ──────────
if base64_encode_bytes([72, 105]) != base64_encode("Hi") {
    throw "FAIL base64_encode_bytes ascii mismatch";
}

// ── base64_encode_bytes round-trips arbitrary bytes via base64_decode_bytes ───
let raw = [0, 1, 127, 128, 200, 255];
let b64 = base64_encode_bytes(raw);
let back = base64_decode_bytes(b64);
if len(back) != len(raw) {
    throw "FAIL base64 bytes round-trip length: " + str(back);
}
for i in 0 to len(raw) - 1 {
    if back[i] != raw[i] {
        throw "FAIL base64 bytes round-trip at " + str(i) + ": " + str(back);
    }
}

// ── stdlib:strings helpers route through native builtins where available ─────
if strings.repeat("ab", 3) != "ababab" { throw "FAIL strings.repeat"; }
if strings.pad_left("7", 3, "0") != "007" { throw "FAIL strings.pad_left"; }
if strings.pad_right("x", 3, ".") != "x.." { throw "FAIL strings.pad_right"; }

// Empty needles are no-ops for replacement/counting, avoiding split("") traps.
if strings.replace_all("abc", "", "-") != "abc" { throw "FAIL replace_all empty"; }
if strings.replace_first("abc", "", "-") != "abc" { throw "FAIL replace_first empty"; }
if strings.count("abc", "") != 0 { throw "FAIL count empty"; }
if strings.join(["a", 2, true], "|") != "a|2|true" { throw "FAIL join converts values"; }
if strings.replace_first("a-b-b", "b", "x") != "a-x-b" { throw "FAIL replace_first only first"; }
if strings.index_of("alpha beta", "beta") != 6 { throw "FAIL native index_of"; }
if strings.reverse("abcd") != "dcba" { throw "FAIL chunked reverse"; }
if strings.to_snake_case("helloWorld") != "hello_world" { throw "FAIL chunked snake case"; }
if strings.slugify("  Hello,  World!  ") != "hello-world" { throw "FAIL chunked slugify"; }

if strings.truncate("abcdef", 5, "...") != "ab..." { throw "FAIL truncate suffix"; }
if strings.truncate("abcdef", 2, "...") != ".." { throw "FAIL truncate small"; }

if strings.starts_with_any("pblang", ["py", "pb"]) == false { throw "FAIL starts_with_any"; }
if strings.ends_with_any("main.sapp", [".sap", ".sapp"]) == false { throw "FAIL ends_with_any"; }
if strings.contains_any("alpha beta", ["xxx", "bet"]) == false { throw "FAIL contains_any"; }
if strings.contains_all("alpha beta", ["alpha", "beta"]) == false { throw "FAIL contains_all"; }

if strings.normalize_space("  a\t b\nc  ") != "a b c" { throw "FAIL normalize_space"; }
if strings.collapse_blank_lines("a\n\n\nb") != "a\n\nb" { throw "FAIL collapse_blank_lines"; }
if strings.remove_empty_lines("a\n\n b \n") != "a\n b " { throw "FAIL remove_empty_lines"; }
if strings.indent("a\nb", "> ") != "> a\n> b" { throw "FAIL indent"; }
if strings.quote("x", "\"") != "\"x\"" { throw "FAIL quote"; }
if strings.unquote("'x'") != "x" { throw "FAIL unquote single"; }
if strings.unquote("\"x\"") != "x" { throw "FAIL unquote double"; }

print "string_bytes_pass";
