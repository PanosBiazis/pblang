let X = import("stdlib/native/codegen_x64.sapp");
fn rejects(work) { return try { work(); false } catch true; }
let original = X.heap_reserve_bytes();
fn exercise() {
    for invalid in [nil, true, false, "1048576", [], map{}, 0, -1, 1048575,
        1073741825, parse_number("NaN"), parse_number("inf"), parse_number("-inf")] {
        assert(rejects(fn(){X.set_heap_reserve(invalid);}), "invalid reserve rejected");
        assert(X.heap_reserve_bytes()==original, "failed configuration leaves compiler state intact");
    }
    assert(X.set_heap_reserve(1048576)==1048576, "inclusive minimum");
    assert(X.set_heap_reserve(1048576.9)==1048576, "existing floor policy retained");
    assert(X.set_heap_reserve(1048577)==1052672, "round upward to page after floor");
    assert(X.set_heap_reserve(1073741824)==1073741824, "inclusive maximum");
    assert(X.set_heap_reserve(1073741824.5)==1073741824, "existing upper fractional policy retained");
    let result=X.compile_safe("return 7;");
    assert(result.safe, "legacy compatibility flag retained");
    assert(result.memory_safety_certified==false and result.runtime_isolated==false, "no false certification");
    assert(result.safety_scope=="selected_runtime_checks" and len(result.limitations)>0, "explicit scope and limits");
    assert(not str_contains(str_join(result.guarantees,"\n"),"no raw pointer"), "no unsupported pointer claim");
}
let passed=try {exercise();true} catch false;
X.set_heap_reserve(original);
assert(passed,"heap configuration and scope regression");
print "native_heap_configuration_pass";
