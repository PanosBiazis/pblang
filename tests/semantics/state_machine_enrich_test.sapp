// tests/semantics/state_machine_enrich_test.sapp — enrichment for stdlib/state_machine.sapp

let F = import("stdlib/state_machine.sapp");

fn fail(m) { throw "FAIL " + m; }
fn contains(arr, v) { let i = 0; while i < len(arr) { if arr[i] == v { return true; } i = i + 1; } return false; }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : " + s); } }

let m = F.create("idle", map{
    idle:    map{ start: "running" },
    running: map{ stop: "idle", finish: "done" },
    done:    map{}
});

// ── states ────────────────────────────────────────────────────────────────────────
let sts = F.states(m);
if not contains(sts, "idle") { fail("states has idle"); }
if not contains(sts, "running") { fail("states has running"); }
if not contains(sts, "done") { fail("states has done"); }

// ── is_final ──────────────────────────────────────────────────────────────────────
if F.is_final(m) { fail("idle is not final"); }
F.send(m, "start");
F.send(m, "finish");   // -> done
if not F.is_final(m) { fail("done is final (no outgoing)"); }

// ── add_transition (dynamic) ──────────────────────────────────────────────────────
F.add_transition(m, "done", "restart", "idle");
if not F.can(m, "restart") { fail("restart now available from done"); }

// ── to_dot ────────────────────────────────────────────────────────────────────────
let dot = F.to_dot(m);
has(dot, "digraph", "dot header");
has(dot, "\"idle\" -> \"running\" [label=\"start\"];", "dot edge idle->running");

print "state_machine_enrich_pass";
