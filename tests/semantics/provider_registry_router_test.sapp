// tests/semantics/provider_registry_router_test.sapp — multi-model router enrichment.
// Pure selection/health logic (no network): capability matching, priority/weighted/
// least-failures strategies, health tracking, cooldown, and aggregate stats.

let P = import("stdlib/provider_registry.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

P.clear();
// register_ex carries routing metadata; plain register still works and defaults sanely.
P.register_ex("fast", "http://fast", "tok1", map{ priority: 1, weight: 1, models: ["gpt-x", "mini"] });
P.register_ex("smart", "http://smart", "tok2", map{ priority: 10, weight: 3, models: ["gpt-x"] });
P.register("legacy", "http://legacy", "");

// ── defaults + enable/disable ─────────────────────────────────────────────────────
if not P.is_enabled("legacy") { fail("register defaults to enabled"); }
P.set_enabled("legacy", false);
if P.is_enabled("legacy") { fail("set_enabled false"); }
P.set_enabled("legacy", true);

// ── capability matching (empty models = matches anything) ─────────────────────────
if not P.supports_model(P.get("fast"), "mini") { fail("fast supports mini"); }
if P.supports_model(P.get("smart"), "mini") { fail("smart does not support mini"); }
if not P.supports_model(P.get("legacy"), "anything") { fail("empty models matches any"); }
// fast + smart declare gpt-x; legacy declares no models so it serves anything too.
let m = P.providers_for_model("gpt-x");
eq(len(m), 3, "fast, smart, legacy all serve gpt-x");

// ── priority selection picks the highest-priority enabled provider ────────────────
eq(P.select("priority", nil), "smart", "priority -> smart (10)");
// with a model filter that only 'fast' serves
eq(P.select("priority", "mini"), "fast", "priority+model mini -> fast");

// ── health tracking + least-failures ──────────────────────────────────────────────
P.record_failure("smart");
P.record_failure("smart");
P.record_success("fast");
let h = P.health("smart");
eq(h.failures, 2, "smart has 2 failures");
eq(P.select("least_failures", "gpt-x"), "fast", "least_failures avoids smart");

// ── cooldown: a downed provider is unavailable until its timestamp ─────────────────
P.mark_down("smart", 1000);
if P.is_available_at("smart", 500) { fail("smart down at t=500"); }
if not P.is_available_at("smart", 1500) { fail("smart recovered at t=1500"); }
// disabled providers are never available
if P.is_available_at("legacy", 0) == false { fail("legacy enabled+available at t=0"); }

// ── round-robin among model-capable providers is deterministic ────────────────────
P.reset_round_robin();
let r1 = P.select("round_robin", "gpt-x");
let r2 = P.select("round_robin", "gpt-x");
if r1 == r2 { fail("round_robin should rotate: " + r1 + " == " + r2); }

// ── stats aggregate ───────────────────────────────────────────────────────────────
let st = P.stats();
eq(st.providers, 3, "3 providers");
if st.failures < 2 { fail("stats failures >= 2"); }
P.reset_stats();
eq(P.stats().failures, 0, "reset_stats clears failures");

// ── providers() still never leaks a token ─────────────────────────────────────────
let pv = P.providers();
let i = 0;
while i < len(pv) { if map_has(pv[i], "token") { fail("token leak in providers()"); } i = i + 1; }

P.clear();
print "provider_registry_router_pass";
