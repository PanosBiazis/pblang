let I=import("stdlib:interpolation_table.sapp");let C=import("stdlib:sheet_csv.sapp");let S=import("stdlib:sheet_document.sapp");let D=import("stdlib:measure_table.sapp");
let source=C.decode("X,Value\n0,0\n2,10\n4,0");let queries=C.decode("Query\n3\n1\n3\n0\n4");let before=json_stringify([source,queries]);let r=I.create(source,queries);assert(r.document.cells==[["Query","Value"],["3","5"],["1","5"],["3","5"],["0","0"],["4","0"]],"piecewise segments and order");r.document.cells[1][0]="changed";assert(json_stringify([source,queries])==before,"detached result");
let total=0;
for count in range(2,32){for shift in range(-8,8){let samples=S.create(count+1,2);samples.cells[0]=["X","Value"];for i in range(0,count){let x=i*i+shift;samples.cells[i+1]=[str(x),str(3*x-7)];}let end=(count-1)*(count-1)+shift;let qs=S.create(6,1);qs.cells[0]=["Query"];let points=[shift,end,(shift+end)/2,(3*shift+end)/4,shift];for i in range(0,5){qs.cells[i+1]=[str(points[i])];}let result=I.create(samples,qs);for i in range(0,5){assert(num_abs(D.parse_value(result.document.cells[i+1][1])-(3*points[i]-7))<0.0000001,"independent affine oracle");total=total+1;}}}
assert(total==2400,"oracle count");let maximum=S.create(32,1);maximum.cells[0]=["Query"];for i in range(1,32){maximum.cells[i]=["1"];}assert(I.create(source,maximum).rows==31,"maximum queries");
let spelling=C.decode("Query\n+1.00\n1e0");assert(I.create(source,spelling).document.cells[1][0]=="+1.00","query text retained");
for bad in ["X,Value\n0,1","X,Value\n1,1\n0,2","X,Value\n0,1\n0,2","X,Other\n0,1\n1,2","X,Value\n0,NaN\n1,2","X,Value\n0,1\n1000000001,2","X,Value\n0,1e-999\n1,2"] {assert((try I.create(C.decode(bad),C.decode("Query\n0")) catch nil)==nil,"bad samples reject");}
for bad in ["Query","Other\n1","Query\n-1","Query\n5","Query\n 1","Query\n1foo","Query\nNaN","Query\n1,2"] {assert((try I.create(source,C.decode(bad)) catch nil)==nil,"bad queries reject");}
let tiny=I.create(C.decode("X,Value\n0,1000000000\n1,0.000000001"),C.decode("Query\n1"));assert(D.parse_value(tiny.document.cells[1][1])==0.000000001,"endpoint through table adapter");print "interpolation_table_pass: 2400 affine oracle values";
