let mem = import("stdlib:memory_safety.sapp");

let b = mem.box_new([1, 2, 3, 4]);
assert(mem.box_read(b)[1] == 2, "Box reads through VM memory handle");
mem.box_write(b, [5, 6, 7, 8]);
assert(mem.box_read(b)[0] == 5, "Box writes through VM memory handle");

let nn = mem.non_null(b);
assert(nn.handle == b.handle, "NonNull carries a live handle");

let shared = mem.borrow_guard(b);
assert(mem.guard_read(shared)[2] == 7, "borrow guard reads live value");
let blocked = try mem.box_write(b, [0]) catch "blocked";
assert(blocked == "blocked", "active shared borrow blocks owner mutation");
mem.guard_release(shared);
mem.box_write(b, [9, 8, 7, 6]);

let view = mem.slice_ref(b, 1, 3);
assert(mem.slice_len(view) == 2, "checked slice stores length");
assert(mem.slice_get(view, 0) == 8, "checked slice reads with bounds");
mem.slice_set(view, 1, 42);
assert(mem.box_read(b)[2] == 42, "checked slice writes arrays with bounds");
let slice_err = try mem.slice_get(view, 2) catch "slice_bounds";
assert(slice_err == "slice_bounds", "checked slice rejects out-of-range access");

let pinned = mem.box_new("stable");
mem.pin(pinned);
assert(mem.is_pinned(pinned), "pin marks owner as non-movable");
let move_err = try mem.box_into_inner(pinned) catch "pinned";
assert(move_err == "pinned", "pinned owner cannot be moved");
mem.box_drop(pinned);

let rc1 = mem.rc_new("shared");
let rc2 = mem.rc_clone(rc1);
assert(mem.rc_strong_count(rc1) == 2, "Rc clone increments strong count");
let write_err = try mem.rc_write(rc1, "mutated") catch "shared_write_blocked";
assert(write_err == "shared_write_blocked", "Rc write requires unique strong owner");
let weak = mem.weak_new(rc1);
assert(mem.rc_weak_count(rc1) == 1, "Weak increments weak count");
mem.rc_release(rc2);
assert(mem.rc_strong_count(rc1) == 1, "Rc release decrements strong count");
mem.rc_write(rc1, "unique");
assert(mem.rc_read(rc1) == "unique", "Rc unique owner can write");
let up = mem.weak_upgrade(weak);
assert(up.some != nil and mem.rc_read(up.some) == "unique", "Weak can upgrade while strong owner exists");
mem.rc_release(up.some);
mem.rc_release(rc1);
let dead = mem.weak_upgrade(weak);
assert(dead.none, "Weak upgrade fails after strong owners are gone");
mem.weak_release(weak);

let arena = mem.arena_new("parser");
let a1 = mem.arena_alloc(arena, 10);
let a2 = mem.arena_alloc(arena, 20);
assert(mem.box_read(a1) + mem.box_read(a2) == 30, "arena allocations are normal boxes");
mem.arena_drop_all(arena);
let expired = try mem.box_read(a1) catch "arena_dropped";
assert(expired == "arena_dropped", "arena drop invalidates child boxes");

let moved = mem.box_new("move-me");
let mg = mem.unique_move(moved);
let moved_err = try mem.box_read(moved) catch "moved";
assert(moved_err == "moved", "unique move blocks old owner reads");
mem.guard_release(mg);

print "memory_safety_stdlib_pass";
