// tests/semantics/polyglot_db_security_test.sapp — injection hardening for polyglot_db.sapp

let DB = import("stdlib/polyglot_db.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── escape_arg: POSIX single-quote escaping (makes any string one safe shell token) ──
eq(DB.escape_arg("safe"), "'safe'", "plain string quoted");
eq(DB.escape_arg("a'b"), "'a'\\''b'", "single quote escaped");
eq(DB.escape_arg("x; rm -rf ~"), "'x; rm -rf ~'", "metachars neutralized by quoting");

// ── redis command/conn metachar guard: must reject, NOT execute ───────────────────
let r = DB.query("redis", "-h localhost", "GET k; touch /tmp/pwned_db");
eq(r.ok, false, "injection attempt rejected (ok=false)");
if str_index_of(str(r.error) + str(r.stderr), "unsafe") < 0 { fail("rejection reason mentions 'unsafe': " + str(r)); }

// a metachar in the conn is also rejected
let r2 = DB.query("redis", "-h localhost`reboot`", "GET k");
eq(r2.ok, false, "unsafe conn rejected");

print "polyglot_db_security_pass";
