let C=import("stdlib:compiler/import_origin_check.sapp");
fn accepted(source,direct=0) {
    let r=C.check(source);assert(r.ok and r.counts.direct==direct,"qualified source shape");
    assert(not r.dependencies_checked and not r.execution_performed and not r.runtime_origin_fixed,"bounded claim");
}
fn refused(source,code) {
    let r=C.check(source);assert(not r.ok and r.code=="import-origin-"+code,"origin rejection: "+code);
    assert(not str_contains(json_stringify(r),"PRIVATE_CANARY"),"no source or dependency path disclosure");
}
accepted("let value=7;print value;");
accepted("// import(\"PRIVATE_CANARY\")\nlet text=\"import(\\\"PRIVATE_CANARY\\\")\";");
accepted("let provider=import(\"PRIVATE_CANARY\");fn value(){return provider.value();}export value;",1);
accepted("import \"PRIVATE_CANARY\";",1);
accepted("if true {let p=import(\"PRIVATE_CANARY\");print p;}",1);
for source in [
    "fn lazy(){return import(\"PRIVATE_CANARY\");}export lazy;",
    "let lazy=fn(){return import(\"PRIVATE_CANARY\");};",
    "let p=try import(\"PRIVATE_CANARY\") catch nil;",
    "let p=try 1 catch import(\"PRIVATE_CANARY\");",
    "fn statement(){import \"PRIVATE_CANARY\";}",
    "class Item {fn value(self){return import(\"PRIVATE_CANARY\");}}",
    "let p={let q=import(\"PRIVATE_CANARY\");q};"
] {refused(source,"deferred");}
for source in ["let loader=import;", "fn loader(){return import;}", "let callbacks=[import];"] {
    refused(source,"escaped");
}
for source in ["let p=import(\"PRIVATE_\"+\"CANARY\");", "let p=import();", "let p=import(\"\");", "let p=import(7);", "let p=import(\"PRIVATE_CANARY\",1);"] {
    refused(source,"dynamic");
}
refused("class Item {fn value(self,p=import(\"PRIVATE_CANARY\")){return p;}}","invalid-source");
refused("fn defaults(p=import(\"PRIVATE_CANARY\")){return p;}","invalid-source");
refused("let obj=map{import:7};","unclassified");
for source in [nil,7,"","let x=;","let s=\"PRIVATE_CANARY"] {refused(source,"invalid-source");}
refused("let p=import(\""+str_repeat("x",4097)+"\");","dynamic");
refused("let s=\""+str_repeat("x",1048576)+"\";","invalid-source");
let deep="1";for _i 130 {deep="["+deep+"]";}
refused("let a="+deep+";","scan-limit");
let snapshot=C.check("let p=import(\"PRIVATE_CANARY\");");snapshot.counts.direct=99;
accepted("let p=import(\"PRIVATE_CANARY\");",1);
print "import_origin_check_pass";
