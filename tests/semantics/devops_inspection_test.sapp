let Inspect=import("stdlib:devops_inspection.sapp");
fn document(jobs) {return json_stringify(map{format:"pblang.devops-pipeline.v1",jobs:jobs});}
fn exact(value,keys) {
    assert(len(map_keys(value))==len(keys),"exact field count");
    for key in keys {assert(map_has(value,key),"required field");}
}
fn report(value) {
    exact(value,["format","ok","error","job_count","dependency_count","stage_count",
        "max_stage_width","stages","contains_job_ids","execution_performed","production_ready"]);
    assert(value.format=="pblang.devops-inspection.v1" and not value.execution_performed
        and not value.production_ready,"inspection never executes or certifies production");
    assert(value.stage_count==len(value.stages),"stage count agrees");
    let jobs=0; let width=0;
    for row in value.stages {
        exact(row,["index","job_count","job_ids"]);
        assert(row.index>=0 and row.index<value.stage_count,"bounded stage index");
        jobs=jobs+row.job_count; width=num_max(width,row.job_count);
        assert(len(row.job_ids)==if value.contains_job_ids {row.job_count} else {0},"consistent disclosure");
    }
    assert(jobs==value.job_count and width==value.max_stage_width,"aggregate invariants");
}
fn rejected(source,reveal=false) {
    let result=Inspect.inspect_text(source,reveal); report(result);
    assert(not result.ok and result.error!=nil and result.job_count==0
        and result.dependency_count==0 and result.stage_count==0 and result.max_stage_width==0
        and len(result.stages)==0 and not result.contains_job_ids,"zeroed failure");
    assert(not str_contains(json_stringify(result),"private_marker"),"failure does not expose source or identifiers");
}
let jobs=[map{id:"private_marker",needs:[]},map{id:"unit",needs:["private_marker"]},
    map{id:"lint",needs:["private_marker"]},map{id:"package",needs:["unit","lint"]}];
let source=document(jobs);
let masked=Inspect.inspect_text(source); report(masked);
assert(masked.ok and masked.job_count==4 and masked.dependency_count==4
    and masked.stage_count==3 and masked.max_stage_width==2,"diamond topology");
assert(masked.stages[0].job_count==1 and masked.stages[1].job_count==2
    and masked.stages[2].job_count==1,"earliest dependency levels");
assert(not str_contains(json_stringify(masked),"private_marker"),"default summary masks identifiers");
let revealed=Inspect.inspect_text(source,true); report(revealed);
assert(revealed.contains_job_ids and revealed.stages[0].job_ids[0]=="private_marker"
    and str_join(revealed.stages[1].job_ids,",")=="unit,lint","explicit detail has stable topological order");
assert(json_stringify(Inspect.inspect_text(source))==json_stringify(masked),"deterministic inspection");
for option in [nil,0,1,"true",[],map{}] {rejected(source,option);}
for bad in [nil,42,[],map{},"", "throw private_marker;", "{\"private_marker\":1}",
    "{\"format\":\"pblang.devops-pipeline.v1\",\"jobs\":[],\"private_marker\":true}",
    "{\"format\":\"pblang.devops-pipeline.v1\",\"jobs\":[],\"\\u006aobs\":[]}",
    "[[[[[[0]]]]]]", "["+str_repeat("0,",2048)+"0]", source+" trailing"] {rejected(bad,true);}
let called=false;
rejected(fn(){called=true;return "private_marker";});
assert(not called,"supplied callbacks are never called");
for invalid in [[],[map{id:"a",needs:["missing"]}],
    [map{id:"a",needs:["b"]},map{id:"b",needs:["a"]}],
    [map{id:"a",needs:["a"]}],[map{id:"a",needs:[]},map{id:"a",needs:[]}],
    [map{id:"private_marker",needs:[],run:"execute"}],
    [map{id:"bad/id",needs:[]}],[map{id:"a",needs:[]},map{id:"b",needs:["a","a"]}]] {
    rejected(document(invalid),true);
}
let independent=[]; let chain=[];
for i in range(0,32) {
    array_push(independent,map{id:"job_"+str(i),needs:[]});
    array_push(chain,map{id:"job_"+str(i),needs:if i==0 {[]} else {["job_"+str(i-1)]}});
}
let wide=Inspect.inspect_text(document(independent)); report(wide);
let deep=Inspect.inspect_text(document(chain)); report(deep);
assert(wide.ok and wide.max_stage_width==32 and wide.stage_count==1,"32 independent jobs");
assert(deep.ok and deep.stage_count==32 and deep.max_stage_width==1,"32 sequential jobs");
array_push(independent,map{id:"extra",needs:[]}); rejected(document(independent));
let dependency_jobs=[]; let too_many_deps=[];
for i in range(0,17) {
    let id="dep_"+str(i); array_push(dependency_jobs,map{id:id,needs:[]}); array_push(too_many_deps,id);
}
array_push(dependency_jobs,map{id:"last",needs:too_many_deps}); rejected(document(dependency_jobs));
assert(Inspect.inspect_text("[[[[[0]]]]]").error=="invalid-document","depth five reaches schema validation");
assert(Inspect.inspect_text("[[[[[[0]]]]]]").error=="invalid-json","depth six fails parsing policy");
assert(Inspect.inspect_text("["+str_repeat("0,",2047)+"0]").error=="invalid-document","2048 items reach schema validation");
assert(Inspect.inspect_text("["+str_repeat("0,",2048)+"0]").error=="invalid-json","2049 items exceed parsing policy");
let padded=source+str_repeat(" ",65536-len(str_to_bytes(source)));
assert(Inspect.inspect_text(padded).ok,"exact 65536-byte input accepted");
assert(Inspect.inspect_text(padded+" ").error=="input-limit","65537 bytes rejected");
let multibyte="\""+str_repeat("é",32767)+"\"";
assert(Inspect.inspect_text(multibyte).error=="invalid-document","65536 multibyte bytes reach schema validation");
assert(Inspect.inspect_text(multibyte+"é").error=="input-limit","multibyte cap is not character count");
print "devops_inspection_pass";
