// tests/semantics/units_enrich_test.sapp — fix + enrichment for stdlib/units.sapp
//
// BUG: in_to_cm(in) used an undefined `inn` (typo) and `in` is a reserved word ->
//   calling it threw. ENRICH: a generic factor-table convert(value, from, to)
//   plus convert_temp for the non-linear temperature scales.

let u = import("stdlib/units.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base still works ─────────────────────────────────────────────────────────────
near(u.mi_to_km(1), 1.609344, "mi_to_km"); near(u.c_to_f(100), 212, "c_to_f");

// ── FIX: in_to_cm no longer throws ───────────────────────────────────────────────
near(u.in_to_cm(1), 2.54, "in_to_cm 1in = 2.54cm");
near(u.in_to_cm(12), 30.48, "in_to_cm 12in = 30.48cm");

// ── ENRICH: generic convert (factor table) ───────────────────────────────────────
near(u.convert(1, "km", "m"), 1000, "convert km->m");
near(u.convert(1, "mi", "km"), 1.609344, "convert mi->km");
near(u.convert(1000, "g", "kg"), 1, "convert g->kg");
near(u.convert(1, "hr", "min"), 60, "convert hr->min");
near(u.convert(1, "gb", "mb"), 1024, "convert gb->mb (data)");
let bad = try u.convert(1, "km", "kg") catch "INCOMPAT";
if bad != "INCOMPAT" { fail("convert across categories must error"); }

// ── ENRICH: convert_temp (non-linear) ────────────────────────────────────────────
near(u.convert_temp(100, "C", "F"), 212, "temp C->F");
near(u.convert_temp(32, "F", "C"), 0, "temp F->C");
near(u.convert_temp(0, "C", "K"), 273.15, "temp C->K");

print "units_enrich_pass";
