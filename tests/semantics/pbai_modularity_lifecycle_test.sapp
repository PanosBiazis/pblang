let AI=import("stdlib/pbai.sapp");let S=import("stdlib:pbai_sensor.sapp");
let N=import("stdlib:pbai_neural_adapter.sapp");let R=import("stdlib:controlled_modularity.sapp");
let request=map{values:[2,4,6,100],period_seconds:1,sigma:3,absolute_tolerance:1};
let limits=map{max_calls:2};let b=AI.modular_bind_limited("sensor-v1",S,R,limits);
limits.max_calls=999;
assert(b.status().ready and b.status().max_calls==2 and b.status().remaining_calls==2,"snapshot quota without retaining caller map");
assert(json_stringify(b.run(request).output)==json_stringify(S.analyze(request)),"first admitted call preserves numerical output");
let status=b.status();status.remaining_calls=999;status.max_calls=999;status.cancelled=true;
assert(b.status().remaining_calls==1 and not b.status().cancelled,"lifecycle snapshot is detached");
b.clear_metrics();assert(b.status().remaining_calls==1,"clearing observation cannot replenish quota");
assert(b.run(map{values:"synthetic-private-marker"}).output.status=="error","provider input errors spend actual execution budget");
assert(b.status().started_calls==2 and b.status().remaining_calls==0 and b.status().code=="call_limit_reached","budget exhausted exactly");
let cyclic=[];push(cyclic,cyclic);
let stopped=b.run(cyclic);assert(stopped.error=="call_limit_reached" and stopped.output==nil,"exhausted admission before request inspection");
let metrics=b.metrics();assert(metrics.executed_calls==1 and metrics.provider_errors==1 and metrics.rejected_calls==1,"lifetime quota independent from resettable metrics");
b.clear_metrics();assert(b.run(nil).error=="call_limit_reached","clear cannot reactivate exhausted binding");
let c=AI.modular_bind("sensor-v1",S,R);assert(c.status().max_calls==nil and c.status().started_calls==nil,"legacy bind has no invented lifetime counter");
assert(c.cancel() and not c.cancel(),"cancellation is idempotent");
assert(c.run(cyclic).error=="binding_cancelled" and c.status().cancelled and not c.status().ready,"cancelled handle refuses future execution");
assert(c.metrics().executed_calls==0 and c.metrics().duration.samples==0 and c.metrics().rejected_calls==1,"cancelled attempts have no provider latency");
c.clear_metrics();let report=c.report();report.ok=false;
assert(c.report().ok and c.run(request).error=="binding_cancelled","static probe report and live cancellation have separate meanings");
let zero=AI.modular_bind_limited("sensor-v1",S,R,map{max_calls:0});
assert(zero.report().ok and zero.run(request).error=="call_limit_reached" and zero.metrics().executed_calls==0,"zero budget still checks contract but runs no requests");
let called=false;let callback=fn(){called=true;return 1;};
for invalid in [nil,true,1,"synthetic-private-marker",[],cyclic,callback,map{},map{max_calls:1,extra:true},map{max_calls:nil},map{max_calls:true},map{max_calls:"1"},map{max_calls:-1},map{max_calls:1.5},map{max_calls:1000001},map{max_calls:cyclic},map{max_calls:callback},map{max_calls:num_sqrt(-1)},map{max_calls:num_exp(1000)}] {
 let refused=AI.modular_bind_limited("sensor-v1",S,R,invalid);
 assert(refused.report().code=="invalid_limits" and refused.run(request).error=="invalid_limits","strict bounded quota options");
 refused.cancel();refused.clear_metrics();assert(refused.run(nil).error=="invalid_limits","controls cannot override initial refusal");
 assert(not str_contains(json_stringify(refused.report()),"synthetic-private-marker"),"invalid options never echoed");
}
assert(not called,"quota validation invokes no callbacks");
let max=AI.modular_bind_limited("sensor-v1",S,R,map{max_calls:1000000});
assert(max.status().remaining_calls==1000000 and max.run(request).output.status=="result" and max.status().remaining_calls==999999,"upper boundary accepted without executing million calls");
let student=AI.modular_bind_limited("student-v1",N,R,map{max_calls:1});
assert(student.run(map{op:"capabilities"}).output.status=="result" and student.run(map{op:"capabilities"}).error=="call_limit_reached","student parity and no automatic training");
assert(not b.status().in_flight and not c.status().preemption and not c.status().timeout_enforced and not c.status().global_limit,"bounded synchronous lifecycle claims");
let saturated=AI.modular_bind_limited("sensor-v1",S,R,map{max_calls:1025});
let count=0;while count<1025 {assert(saturated.run(request).output.status=="result","admitted call across observation boundary");count=count+1;}
assert(saturated.metrics().observations_dropped and saturated.status().remaining_calls==0,"quota persists beyond metric saturation");
assert(saturated.run(nil).error=="call_limit_reached" and saturated.metrics().executed_calls==1024,"execution stop independent of dropped observations");
print "pbai_modularity_lifecycle_pass";
