// tests/semantics/url_enrich2_test.sapp — round-2 enrichment for stdlib/url.sapp
//
// Round 1 (ffd864d) fixed userinfo/IPv6 parsing and added join / multi-value query.
// This adds common URL operations: default_port, is_absolute, origin, with_query,
// add_params, and normalize.

let url = import("stdlib/url.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── default_port ────────────────────────────────────────────────────────────────
eq(url.default_port("http"), 80, "http default port");
eq(url.default_port("https"), 443, "https default port");
eq(url.default_port("WSS"), 443, "scheme is case-insensitive");
eq(url.default_port("ftp"), 21, "ftp default port");
eq(url.default_port("nope"), nil, "unknown scheme -> nil");

// ── is_absolute ─────────────────────────────────────────────────────────────────
if not url.is_absolute("https://example.com/x") { fail("absolute URL"); }
if url.is_absolute("/just/a/path") { fail("path-only is not absolute"); }

// ── origin: scheme://host[:port], dropping userinfo/path/query ───────────────────
eq(url.origin("https://user:pw@h.com:8443/a/b?x=1#f"), "https://h.com:8443", "origin");
eq(url.origin("http://h.com/a"), "http://h.com", "origin without port");

// ── with_query: replace the query from a params map ─────────────────────────────
let wq = url.with_query("http://h/p?old=1&gone=2", map{ a: "b c", n: "1" });
let wqp = url.parse_query(url.parse(wq).query);
if map_has(wqp, "old") { fail("with_query replaces the old query: " + wq); }
eq(wqp.a, "b c", "with_query value (decoded)");
eq(wqp.n, "1", "with_query second value");

// ── add_params: merge into the existing query (new keys win) ─────────────────────
let ap = url.add_params("http://h/p?a=1&b=2", map{ b: "9", c: "3" });
let app = url.parse_query(url.parse(ap).query);
eq(app.a, "1", "add_params keeps existing a");
eq(app.b, "9", "add_params overrides b");
eq(app.c, "3", "add_params adds c");

// ── normalize: lowercase scheme/host, drop default port, remove dot segments ────
eq(url.normalize("HTTP://Example.COM:80/a/./b/../c"), "http://example.com/a/c", "normalize");
eq(url.normalize("https://H.com:443/x"), "https://h.com/x", "normalize drops https default port");
eq(url.normalize("http://h.com:8080/a/../"), "http://h.com:8080/", "normalize keeps non-default port + trailing slash");

print "url_enrich2_pass";
