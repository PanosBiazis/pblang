// tests/semantics/codegen_syscall_test.sapp — the syscall IR op on every backend. Syscalls
// are the device-driver escape hatch (read/write/open/ioctl/mmap). x86-64 and i386 are
// proven by RUNNING (exit via the syscall op); arm64 by encoding + valid ELF.

let X64 = import("stdlib/codegen_x64.sapp");
let X86 = import("stdlib/codegen_x86.sapp");
let A64 = import("stdlib/codegen_arm64.sapp");

fn fail(m) { throw "FAIL " + m; }

fn run_rc(elf, tag) {
    let path = "pbsc_" + tag + ".bin";
    fs_write_bytes(path, elf);
    proc_spawn_wait("bash", ["-c", "chmod +x " + path]);
    let r = proc_spawn_wait("bash", ["-c", "./" + path + "; echo RC=$?"]);
    proc_spawn_wait("bash", ["-c", "rm -f " + path]);
    let out = try r.stdout catch "";
    let idx = str_index_of(out, "RC=");
    if idx < 0 { fail(tag + ": no exit code (<<" + str(out) + ">>)"); }
    return parse_number(str_trim(str_slice(out, idx + 3, len(out))));
}

// r0 is set to 99, but the syscall op invokes exit(r1=42) FIRST — so exit code 42 proves the
// op fired (otherwise the auto-appended exit(r0) would give 99).
// ── x86-64: exit = syscall 60, arg0 in rdi ──────────────────────────────────────────
let rc64 = run_rc(X64.compile_program([["seti", 0, 99], ["seti", 1, 42], ["syscall", 60, [1]]]), "x64");
if rc64 != 42 { fail("x86-64 syscall exit got " + str(rc64)); }

// ── i386: exit = syscall 1, arg0 in ebx ─────────────────────────────────────────────
let rc86 = run_rc(X86.compile_program([["seti", 0, 99], ["seti", 1, 42], ["syscall", 1, [1]]]), "x86");
if rc86 != 42 { fail("i386 syscall exit got " + str(rc86)); }

// ── arm64: exit = syscall 93, arg0 in x0; encoding-verified ─────────────────────────
let code = A64.compile_ir([["seti", 1, 42], ["syscall", 93, [1]]]);
if num_mod(len(code), 4) != 0 { fail("arm64 syscall code not 4-byte aligned"); }
// svc #0 (0xD4000001 -> LE 01 00 00 D4) must be the last instruction of the syscall op
let n = len(code);
if code[n - 4] != 0x01 or code[n - 1] != 0xD4 { fail("arm64 syscall must end in svc #0"); }
let elf = A64.compile_program([["seti", 1, 42], ["syscall", 93, [1]]]);
if elf[0] != 0x7F or elf[18] != 0xB7 { fail("arm64 syscall program is a valid AArch64 ELF"); }

print "codegen_syscall_pass";
