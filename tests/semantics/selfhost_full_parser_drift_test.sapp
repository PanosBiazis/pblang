let FRONTEND = import("stdlib:compiler/selfhost_frontend.sapp");

fn require_parse(label, source, expected_stmts) {
    let parsed = FRONTEND.frontend_parse_full(source);
    if parsed == nil or parsed.ast == nil { throw "FAIL " + label + ": missing AST"; }
    if len(parsed.errors) != 0 { throw "FAIL " + label + ": parser diagnostics"; }
    if len(parsed.ast.stmts) != expected_stmts {
        throw "FAIL " + label + ": got " + str(len(parsed.ast.stmts)) + " statements, expected " + str(expected_stmts);
    }
}

require_parse("let_print", "let x = 1; print x;", 2);
require_parse("multi_let", "let a = 1; let b = 2; let c = a + b; print c;", 4);
require_parse("if_then", "let x = 1; if x == 1 { print x; }", 2);
require_parse("while_loop", "let i = 0; while i < 3 { i = i + 1; }", 2);
require_parse("string_lit", "let s = \"hi\"; print s;", 2);

print "selfhost_full_parser_drift_pass";
