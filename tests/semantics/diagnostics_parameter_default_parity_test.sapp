let D = import("stdlib:diagnostics.sapp");

fn require(value, message) {
    if not value { throw "diagnostics_parameter_default_parity_test: " + message; }
}

let literal = D.diagnose(
    "fn f(a = 1, b = \"x\", c = true, d = nil) { return a; }\nprint f();"
);
require(literal.counts.error == 0, "runtime-supported literal defaults must pass check");

let conditional = D.diagnose(
    "let enabled = true; let value = if enabled { 1 } else { 2 }; print value;"
);
require(conditional.counts.error == 0, "if expressions must remain supported");

let computed = D.diagnose(
    "let FALLBACK = 7; fn f(value = FALLBACK) { return value; } print f();"
);
require(computed.counts.error == 1, "computed default must fail exactly once");
require(computed.errors[0].code == "parse-error", "computed default must be a parse error");
require(str_contains(computed.errors[0].message, "Default parameter values must be"),
    "computed default must explain the literal-only runtime contract");

print "diagnostics_parameter_default_parity_pass";
