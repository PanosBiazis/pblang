let UI=import("stdlib:modern_ui.sapp");
let V=import("stdlib:modern_ui_validation.sapp");
fn rejects(f) { let failed=false; try { f(); } catch { failed=true; } return failed; }
let view=UI.screen([UI.row([UI.text("A"),UI.card([UI.column([UI.input("B")])])]),
    UI.grid([UI.button("C"),UI.screen([UI.text("D")])])]);
let bundle=UI.compile(view,map{target:"web"});
let fresh=V.renderer_bundle(bundle,"web");
assert(fresh.source_nodes==bundle.source_nodes and len(fresh.records)==len(bundle.records),"count parity");
for i in range(0,len(bundle.records)) {
    assert(fresh.records[i].name==bundle.records[i].name
        and fresh.records[i].kind==bundle.records[i].kind,"exact preorder and generated name parity");
}
let before=bundle.records;
bundle.profile="ignored"; bundle.source_nodes=-1; bundle.executable=true;
let refreshed=V.renderer_bundle(bundle,"web");
assert(len(refreshed)==5 and refreshed.source_nodes==fresh.source_nodes,"narrow result ignores metadata claims");
assert(bundle.records==before and bundle.source_nodes==-1,"incoming bundle not rewritten");
for bad in [nil,[],map{},map{format:"wrong",target:"web",view:view},
    map{format:"pblang.modern-ui.bundle.v1",target:"web",view:map{kind:"private-marker"}}] {
    assert(rejects(fn(){V.renderer_bundle(bad,"web");}),"malformed boundary rejects");
}
assert(rejects(fn(){V.renderer_bundle(bundle,"native");}),"only renderer targets accepted");
let invalid=UI.validate(map{kind:"unknown"});
assert(not invalid.ok and invalid.nodes==1 and invalid.actions==0
    and invalid.errors==["view has unsupported kind: unknown"],"public validation diagnostic contract retained");
let leaves=[]; for i in range(0,255) { push(leaves,UI.text(str(i))); }
let tree=UI.screen([UI.column(leaves),UI.column(leaves),UI.column(leaves),UI.column(leaves)]);
assert(not V.validate(tree).ok,"1025 source nodes rejected");
tree.children[3]=UI.column(slice(leaves,0,254));
let maximum=V.renderer_bundle(map{format:"pblang.modern-ui.bundle.v1",target:"web",view:tree},"web");
assert(maximum.source_nodes==1024,"exact 1024 source-node bound accepted");
print "modern_ui_validation_pass";
