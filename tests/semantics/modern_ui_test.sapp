let UI = import("stdlib/modern_ui.sapp");
let APP = import("stdlib/app.sapp");
let GUI = import("stdlib/gui.sapp");
let GFX = import("stdlib/graphics.sapp");

fn fail(message) { throw "FAIL " + message; }
fn eq(actual, expected, message) {
    if actual != expected { fail(message + ": got " + str(actual) + ", expected " + str(expected)); }
}
fn require(value, message) { if not value { fail(message); } }
fn record(bundle, name) {
    for item in bundle.records { if item.name == name { return item; } }
    return nil;
}

let view = UI.screen([
    UI.heading("Device center", map{ name: "title" }),
    UI.card([
        UI.row([
            UI.input("", map{ name: "device", bind: "device" }),
            UI.choice(["USB", "LAN", "Tor"], 1, nil, map{ name: "transport" })
        ], map{ name: "connection", responsive: true }),
        UI.grid([
            UI.button("Connect", UI.action_sequence([
                UI.action_set_text("title", "Connected"),
                UI.action_message("Secure session ready")
            ]), map{ name: "connect" }),
            UI.button("Disconnect", nil, map{ name: "disconnect" }),
            UI.toggle("Remember", true, nil, map{ name: "remember" })
        ], map{ name: "actions", columns: 3 }),
        UI.progress(0.5, map{ name: "progress" })
    ], map{ name: "card", title: "Connection" })
], map{ name: "root" });

let checked = UI.validate(view);
eq(checked.ok, true, "valid view");
require(checked.nodes >= 10, "all nested nodes counted");
eq(checked.actions, 3, "portable actions counted");
eq(UI.validate(map{ kind: "unknown" }).ok, false, "unknown node rejected");
eq(UI.validate(UI.choice("not-an-array")).ok, false, "invalid choice options rejected");
eq(UI.validate(UI.screen("not-an-array")).ok, false, "invalid children rejected");

let wide = UI.compile(view, map{ target: "desktop", width: 1200, height: 700 });
eq(wide.executable, true, "desktop bundle executable");
eq(wide.adapter, "stdlib/gui.sapp", "desktop adapter");
let wide_device = record(wide, "device");
let wide_transport = record(wide, "transport");
require(wide_device != nil and wide_transport != nil, "named responsive controls compiled");
eq(wide_device.y, wide_transport.y, "wide row remains horizontal");
require(wide_transport.x > wide_device.x, "wide row positions controls left to right");

let compact = UI.compile(view, map{ target: "android", width: 360, height: 720 });
eq(compact.target, "android", "android target retained");
eq(compact.executable, true, "android runtime adapter linked");
eq(compact.adapter, "stdlib/modern_ui_android.sapp", "android adapter named");
let compact_device = record(compact, "device");
let compact_transport = record(compact, "transport");
require(compact_transport.y > compact_device.y, "compact row stacks vertically");
eq(record(compact, "connect").x, record(compact, "disconnect").x, "compact grid becomes one column");

let duplicate_rejected = false;
try { UI.compile(UI.column([
    UI.text("one", map{ name: "same" }),
    UI.text("two", map{ name: "same" })
])); } catch { duplicate_rejected = true; }
require(duplicate_rejected, "duplicate names rejected");

let preview = APP.modern("Modern device center", view, map{
    preview: true, width: 960, height: 640, theme: "light",
    palette: map{ accent: GFX.rgb(0, 112, 184) },
    model: map{ device: "Alcatel 3X" }
});
eq(preview.kind, "modern-ui", "app.modern delegates to modern runtime");
eq(preview.preview, true, "modern preview remains headless");
eq(GUI.get(preview.form, "device").value, "Alcatel 3X", "modern data binding");
eq(preview.form.palette.accent, GFX.rgb(0, 112, 184), "custom palette applied");
eq(preview.form.palette.bg, GUI.palette("light").bg, "light theme base applied");
GUI.get(preview.form, "connect").onclick(preview.form);
eq(GUI.get(preview.form, "title").text, "Connected", "portable set-text action executes natively");
eq(preview.form.last_message, "Secure session ready", "portable message action executes natively");

GUI.relayout(preview.form, 400, 700);
let form_device = GUI.get(preview.form, "device");
let form_transport = GUI.get(preview.form, "transport");
require(form_transport.y > form_device.y, "live native resize recompiles responsive layout");
eq(preview.form.viewport.orientation, "portrait", "resize profile updated");

let non_native_rejected = false;
try { UI.build("Android", view, map{ target: "android" }); } catch { non_native_rejected = true; }
require(non_native_rejected, "unlinked target fails clearly");

print "modern_ui_pass";
