let T=import("stdlib:speech_translation.sapp");
fn expect(value,message){if not value{throw "FAIL speech translation: "+message;}}
fn rejected(work){return try { work(); false } catch true;}

let translated=T.translate("hello world!","en","el",map{hello:"γεια",world:"κόσμε"},true);
expect(translated.ok and translated.translation=="γεια κόσμε!" and translated.full_coverage
    and translated.translated_word_count==2,"Unicode glossary translation preserves punctuation");
let missing=T.translate("hello unknown","en","el",map{hello:"γεια"},true);
expect(not missing.ok and missing.unknown_words==["unknown"] and missing.coverage==0.5,
    "full-coverage mode fails explicitly on unknown words");
let partial=T.translate("hello unknown","en","el",map{hello:"γεια"},false);
expect(partial.ok and not partial.full_coverage and partial.translation=="γεια unknown",
    "opt-in partial mode reports untranslated content");
expect(rejected(fn(){T.translate("hello","bad/lang","el",map{},true);}),
    "invalid language identifiers fail closed");
print "speech_translation_contract_pass";
