let PNG = import("stdlib:png.sapp");
let Flate = import("stdlib:flate.sapp");
let Gfx = import("stdlib:graphics.sapp");

fn fail(message) { throw "FAIL png: " + message; }
fn truthy(value, message) { if value != true { fail(message); } }
fn eq(actual, expected, message) {
    if actual != expected {
        fail(message + " got=[" + str(actual) + "] want=[" + str(expected) + "]");
    }
}

fn push_u32(out, value) {
    array_push(out, bit_and(bit_shr(value, 24), 255));
    array_push(out, bit_and(bit_shr(value, 16), 255));
    array_push(out, bit_and(bit_shr(value, 8), 255));
    array_push(out, bit_and(value, 255));
}

fn chunk(out, kind, data) {
    push_u32(out, len(data));
    let checked = [];
    let i = 0;
    while i < 4 {
        array_push(out, kind[i]); array_push(checked, kind[i]); i = i + 1;
    }
    i = 0;
    while i < len(data) {
        array_push(out, data[i]); array_push(checked, data[i]); i = i + 1;
    }
    push_u32(out, Flate.crc32(checked));
}

fn fixture() {
    let out = [137, 80, 78, 71, 13, 10, 26, 10];
    let ihdr = [];
    push_u32(ihdr, 2); push_u32(ihdr, 2);
    for value in [8, 6, 0, 0, 0] { array_push(ihdr, value); }
    chunk(out, [73, 72, 68, 82], ihdr);
    // Filter 0: red, green. Filter 1: blue, then white encoded relative to blue.
    let raw = [
        0, 255, 0, 0, 255, 0, 255, 0, 255,
        1, 0, 0, 255, 255, 255, 255, 0, 0
    ];
    chunk(out, [73, 68, 65, 84], Flate.zlib_encode(raw));
    chunk(out, [73, 69, 78, 68], []);
    return out;
}

let bytes = fixture();
let decoded = PNG.decode(bytes);
truthy(decoded.ok and decoded.crc_verified and decoded.checksum_verified,
    "valid PNG verifies both integrity layers");
eq(decoded.width, 2, "source width");
eq(decoded.height, 2, "source height");
eq(decoded.image[0][0], Gfx.rgba(255, 0, 0, 255), "red pixel");
eq(decoded.image[0][1], Gfx.rgba(0, 255, 0, 255), "green pixel");
eq(decoded.image[1][0], Gfx.rgba(0, 0, 255, 255), "blue pixel");
eq(decoded.image[1][1], Gfx.rgba(255, 255, 255, 255), "sub-filter white pixel");

let thumbnail = PNG.decode(bytes, map{
    max_output_width: 1, max_output_height: 1, max_pixels: 4
});
truthy(thumbnail.ok and thumbnail.output_width == 1
    and thumbnail.output_height == 1 and len(thumbnail.image) == 1,
    "bounded thumbnail decoding avoids full output allocation");

let corrupt = slice(bytes, 0, len(bytes));
corrupt[29] = bit_xor(corrupt[29], 1);
truthy(not PNG.decode(corrupt).ok, "chunk corruption fails closed");
truthy(not PNG.decode(bytes, map{ max_pixels: 3 }).ok,
    "pixel budget rejects oversized sources");
truthy(not PNG.decode([137, 80, 78, 71]).ok,
    "truncated input returns a bounded error");

fn indexed_fixture() {
    let out = [137, 80, 78, 71, 13, 10, 26, 10];
    let ihdr = [];
    push_u32(ihdr, 2); push_u32(ihdr, 1);
    for value in [8, 3, 0, 0, 0] { array_push(ihdr, value); }
    chunk(out, [73, 72, 68, 82], ihdr);
    chunk(out, [80, 76, 84, 69], [255, 0, 0, 0, 0, 255]);
    chunk(out, [116, 82, 78, 83], [255, 128]);
    chunk(out, [73, 68, 65, 84], Flate.zlib_encode([0, 0, 1]));
    chunk(out, [73, 69, 78, 68], []);
    return out;
}

let indexed = PNG.decode(indexed_fixture());
truthy(indexed.ok and indexed.image[0][0] == Gfx.rgba(255, 0, 0, 255),
    "indexed palette pixel decodes");
truthy(indexed.image[0][1] == Gfx.rgba(0, 0, 255, 128),
    "indexed transparency decodes");

print "png_test: 14 checks passed";
