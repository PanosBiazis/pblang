let L=import("stdlib:divider_load.sapp");
fn close(a,b){assert(num_abs(a-b)<=0.00000001*num_max(1,num_abs(b)),"numeric oracle");}
let r=L.analyze(6,1000,1000,1000);close(r.loaded_vout,2);close(r.unloaded_vout,3);close(r.load_current_amperes,0.002);close(r.source_current_amperes,0.004);close(r.load_power_watts,0.004);close(r.total_power_watts,0.024);close(r.reduction_percent,100/3);
for vin in [-1000,-5,0,5,1000] {for top in [1,1000,1000000] {for bottom in [1,1000,1000000] {for load in [1,1000,1000000] {
 let x=L.analyze(vin,top,bottom,load);let effective=bottom*load/(bottom+load);let output=vin*effective/(top+effective);close(x.loaded_vout,output);close(x.load_current_amperes,output/load);close(x.source_current_amperes,(vin-output)/top);close(x.load_power_watts,output*output/load);close(x.total_power_watts,vin*x.source_current_amperes);assert(x.reduction_percent>=0 and x.reduction_percent<=100,"bounded reduction");
}}}}
let loads=[1000,100,1000];let snapshot=json_stringify(loads);let report=L.sweep(5,1000,1000,loads);assert(report.rows[0]==report.rows[2] and report.rows[1].load_ohms==100,"order and duplicates");assert(json_stringify(loads)==snapshot,"source retained");report.rows[0].load_ohms=9;assert(report.rows[2].load_ohms==1000,"independent rows");
assert(L.linear_loads(1,9,3)==[1,5,9] and L.linear_loads(2,2,2)==[2,2],"exact endpoints / equal range");let many=L.linear_loads(1,1000000,32);assert(len(many)==32 and many[31]==1000000,"maximum rows");let curve=L.sweep(5,1000,2000,many);for i in range(1,32){assert(curve.rows[i].loaded_vout>curve.rows[i-1].loaded_vout,"positive monotonic load curve");}
for args in [[0,1,2],[1,1000001,2],[2,1,2],[1,2,1],[1,2,33],[1,2,2.5],[1,2,true],["1",2,2]] {assert((try L.linear_loads(args[0],args[1],args[2]) catch nil)==nil,"invalid range rejected");}
for loads in [[],[0],[1000001],[true],["1"],[1,nil]] {assert((try L.sweep(5,1000,1000,loads) catch nil)==nil,"invalid loads rejected");}
for args in [[1001,1000,1000,1000],[5,0,1000,1000],[5,1000,1000001,1000],[nil,1,1,1]] {assert((try L.analyze(args[0],args[1],args[2],args[3]) catch nil)==nil,"invalid divider rejected");}
let csv=L.to_csv(6,1000,1000,[1000]);assert(str_starts_with(csv,"load_ohms,unloaded_vout,loaded_vout,") and len(str_split(csv,"\n"))==3,"CSV header row newline");
print "divider_load_pass";
