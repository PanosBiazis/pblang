// Test: MODULE IMPORT support in the self-hosted compiler. `frontend_run` now
// pre-resolves `import("stdlib:...")` references — each imported module is itself
// compiled + run through the self-hosted pipeline, its exports cached, and the
// main program's `import(...)` calls resolve against that cache (vm.sapp reads
// globals["__import_cache__"]). So a multi-file program (main + real stdlib
// modules) executes entirely on the pblang VM — the multi-file step toward a
// self-hosted toolchain. All pblang.

let fe = import("stdlib/compiler/selfhost_frontend.sapp");

// --- Import stdlib/functional.sapp and use map / filter / sum / reduce ---
let src1 = "let f = import(\"stdlib:functional.sapp\"); "
    + "let doubled = f.map([1, 2, 3], fn(x) { return x * 2; }); "
    + "let s = doubled[0] + doubled[1] + doubled[2]; "        // 2+4+6 = 12
    + "let total = f.sum([10, 20, 30]); "                      // 60
    + "let evens = f.filter([1,2,3,4,5,6], fn(x){ return x % 2 == 0; }); "
    + "let ec = len(evens); "                                  // 3
    + "let r = f.reduce([1,2,3,4], fn(a, x){ return a + x; }, 0);"; // 10

let r1 = fe.frontend_run(src1);
assert(r1.ok == true, "self-hosted program importing functional.sapp compiles+runs");
assert(r1.globals["s"] == 12, "self-hosted: imported f.map then sum == 12");
assert(r1.globals["total"] == 60, "self-hosted: imported f.sum == 60");
assert(r1.globals["ec"] == 3, "self-hosted: imported f.filter keeps 3 evens");
assert(r1.globals["r"] == 10, "self-hosted: imported f.reduce == 10");

// --- A higher-order import: compose + a captured closure across the boundary ---
let src2 = "let f = import(\"stdlib:functional.sapp\"); "
    + "let inc = fn(x) { return x + 1; }; "
    + "let dbl = fn(x) { return x * 2; }; "
    + "let h = f.compose(inc, dbl); "          // inc(dbl(x)) = 2x+1
    + "let y = h(10);";                        // 21
let r2 = fe.frontend_run(src2);
assert(r2.globals["y"] == 21, "self-hosted: imported f.compose(inc,dbl)(10) == 21");

// --- Real `export` semantics: only declared names are exposed ---
// A module with a private helper not in its `export` list must hide it.
let modsrc = "fn pub_fn(x) { return x * 2; } fn priv_fn(x) { return x + 100; } export pub_fn;";
fs_write("/tmp/pblang_testmod.sapp", modsrc);
let r_exp = fe.frontend_run("let m = import(\"/tmp/pblang_testmod.sapp\"); "
    + "let a = m.pub_fn(5); "
    + "let has_pub = map_has(m, \"pub_fn\"); "
    + "let has_priv = map_has(m, \"priv_fn\");");
assert(r_exp.globals["a"] == 10, "self-hosted: exported fn is callable across import");
assert(r_exp.globals["has_pub"] == true, "self-hosted: exported name is exposed");
assert(r_exp.globals["has_priv"] == false, "self-hosted: NON-exported (private) name is hidden");

// --- Program WITHOUT imports still runs unchanged (backward compatible) ---
let r3 = fe.frontend_run("let x = 2 + 3 * 4;");
assert(r3.globals["x"] == 14, "self-hosted: import-less program unaffected");

print "selfhost_modules_pass";
