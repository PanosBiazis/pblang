// Inject launch failures into a temporary copy of the real PBLang module.
// Workers and joins are real; production code contains no test switches.
let source=fs_read("stdlib/thread_pool.sapp");
assert(str_contains(source,"thread_lib.go("),"launch injection target exists");
source=str_replace_all(source,"thread_lib.go(","_go_injected(thread_lib,");
source=source+"\nlet injected=map{calls:0,fail:0,handles:[]};"
    +"fn _go_injected(lib,task){injected.calls=injected.calls+1;if injected.calls==injected.fail {throw \"injected launch\";}let h=lib.go(task);array_push(injected.handles,h);return h;}"
    +"fn reset(n){injected=map{calls:0,fail:n,handles:[]};}"
    +"fn snapshot(){return injected;} export reset,snapshot;";
let path=cwd()+"/.thread_pool_launch_"+sha256(str(random_bytes(16)))+".sapp";
fs_write_bytes(path,str_to_bytes(source));
fn invoke(P,mode,pool){
    if mode=="map" {return P.parallel_map([0,1,2,3],fn(x){sleep_ms(30);return x;},2);}
    if mode=="for" {return P.parallel_for(0,4,1,fn(i){sleep_ms(30);},2);}
    return P.run_parallel(pool);
}
fn verify(P){
    let T=import("stdlib:thread.sapp");
    for mode in ["map","for","pool"] {
        for failure in [1,2] {
            P.reset(failure);
            let pool=P.new_thread_pool(2);
            for i 4 {P.submit(pool,fn(){sleep_ms(30);return 7;});}
            let outcome=try map{ok:true,value:invoke(P,mode,pool)} catch map{ok:false,value:nil};
            let result=outcome.value;
            let threw=not outcome.ok;
            let snapshot=P.snapshot();
            let settled=true;
            for handle in snapshot.handles {
                if not handle.__resolved {settled=false;}
                // Reap even when checking a broken baseline, before assertions.
                T.await(handle);
            }
            assert(snapshot.calls==failure,"injected first/second launch reached");
            assert(settled,"previously started futures settled before return");
            if mode=="pool" {
                assert(not threw,"pool reports complete accounting");
                let completed=if failure==1 {0} else {2};
                assert(result.completed==completed and result.failed==4-completed,"started and unstarted task accounting");
                assert(P.stats(pool).pending==0,"tasks with possible effects cannot be retried implicitly");
                let again=P.run_parallel(pool);
                assert(again.completed==0 and again.failed==0,"no implicit replay after launch failure");
            } else {assert(threw,"helper reports launch failure");}
        }
    }
    return true;
}
let passed=try verify(import(path)) catch false;
fs_remove(path);
assert(passed,"thread pool launch cleanup");
print "thread_pool_launch_cleanup_pass";
