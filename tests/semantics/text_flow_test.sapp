let Flow=import("stdlib:text_flow.sapp");
fn lines(text,columns,limit=64){return json_stringify(Flow.wrap(text,columns,limit).lines);}
assert(lines("one two three",7)==json_stringify(["one two","three"]),"word boundaries");
assert(lines("abcd \n",4)==json_stringify(["abcd",""]),"newline trims horizontal whitespace");
assert(lines("abcdefghi",4)==json_stringify(["abcd","efgh","i"]),"long words");
assert(lines("  one   two  ",5)==json_stringify(["one","two"]),"horizontal whitespace collapses");
assert(lines("a\r\nb\rc\t d\n",5)==json_stringify(["a","b","c d",""]),"newlines and tabs");
assert(lines("one two three four",7,2)==json_stringify(["one two","thre..."]),"bounded rows get ellipsis");
assert(lines("áb",2)==json_stringify(["á","b"]),"combining sequence stays together");
assert(lines("👩‍💻x",3)==json_stringify(["👩‍💻","x"]),"existing ZWJ grouping stays together");
assert(lines("á",1)==json_stringify(["."]),"oversized cluster has bounded placeholder");
assert(lines("",2)==json_stringify([""]),"empty text reserves a line");
assert(len(Flow.wrap("abc",0).lines)==0,"zero width draws no text");
for bad in [-1,1.5,4097,"4",nil] {assert((try Flow.wrap("x",bad) catch nil)==nil,"invalid columns");}
for bad in [0,1.5,65,"4",nil] {assert((try Flow.wrap("x",4,bad) catch nil)==nil,"invalid rows");}
assert((try Flow.wrap(str_repeat("a",65537),4) catch nil)==nil,"bounded input");
print "text_flow_pass";
