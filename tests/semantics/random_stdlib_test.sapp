// tests/semantics/random_stdlib_test.sapp
// Seeded, deterministic PRNG (pure pblang, no Rust): reproducibility + ranges.
let rng = import("stdlib:random.sapp");

// local membership helper (avoids importing array.sapp)
fn _has(arr, v) {
    let i = 0;
    while i < len(arr) {
        if arr[i] == v { return true; }
        i = i + 1;
    }
    return false;
}

// --- reproducibility: same seed => identical stream ---
let a = rng.seed(42);
let b = rng.seed(42);
let i = 0;
while i < 20 {
    if rng.next_u32(a) != rng.next_u32(b) { throw "FAIL reproducibility at " + str(i); }
    i = i + 1;
}

// different seeds => different first draw (overwhelmingly likely)
let c = rng.seed(7);
let d = rng.seed(8);
if rng.next_u32(c) == rng.next_u32(d) { throw "FAIL distinct seeds collided"; }

// --- random() in [0,1) ---
let g = rng.seed(123);
let k = 0;
while k < 1000 {
    let r = rng.random(g);
    if r < 0 or r >= 1 { throw "FAIL random range: " + str(r); }
    k = k + 1;
}

// --- uniform(lo,hi) in [lo,hi) ---
let g2 = rng.seed(5);
let j = 0;
while j < 1000 {
    let u = rng.uniform(g2, 10, 20);
    if u < 10 or u >= 20 { throw "FAIL uniform range: " + str(u); }
    j = j + 1;
}

// --- randint(lo,hi) inclusive, integer, in range ---
let g3 = rng.seed(99);
let saw_lo = false;
let saw_hi = false;
let m = 0;
while m < 2000 {
    let n = rng.randint(g3, 1, 6);
    if n < 1 or n > 6 { throw "FAIL randint range: " + str(n); }
    if num_floor(n) != n { throw "FAIL randint not integer: " + str(n); }
    if n == 1 { saw_lo = true; }
    if n == 6 { saw_hi = true; }
    m = m + 1;
}
if saw_lo == false or saw_hi == false { throw "FAIL randint never hit endpoints"; }

// --- choice returns an element of the array ---
let g4 = rng.seed(11);
let arr = ["a", "b", "c", "d"];
let t = 0;
while t < 100 {
    let ch = rng.choice(g4, arr);
    if _has(arr, ch) == false { throw "FAIL choice not in arr: " + str(ch); }
    t = t + 1;
}

// --- shuffle is a permutation (same multiset, possibly new order) ---
let g5 = rng.seed(2024);
let base = [1, 2, 3, 4, 5, 6, 7, 8];
let sh = rng.shuffle(g5, base);
if len(sh) != len(base) { throw "FAIL shuffle length"; }
let chk = 0;
let s = 0;
while s < len(base) { chk = chk + base[s]; s = s + 1; }
let chk2 = 0;
let s2 = 0;
while s2 < len(sh) { chk2 = chk2 + sh[s2]; s2 = s2 + 1; }
if chk != chk2 { throw "FAIL shuffle changed multiset sum"; }
// original untouched
if base[0] != 1 { throw "FAIL shuffle mutated original"; }

// --- sample(k) returns k distinct elements from arr ---
let g6 = rng.seed(77);
let pool = [10, 20, 30, 40, 50];
let samp = rng.sample(g6, pool, 3);
if len(samp) != 3 { throw "FAIL sample length"; }
let di = 0;
while di < len(samp) {
    let dj = di + 1;
    while dj < len(samp) {
        if samp[di] == samp[dj] { throw "FAIL sample has duplicates"; }
        dj = dj + 1;
    }
    if _has(pool, samp[di]) == false { throw "FAIL sample element not in pool"; }
    di = di + 1;
}

// --- normal(mu,sigma): empirical mean close to mu over many draws ---
let g7 = rng.seed(31337);
let acc = 0;
let nn = 5000;
let q = 0;
while q < nn {
    acc = acc + rng.normal(g7, 100, 15);
    q = q + 1;
}
let emean = acc / nn;
if emean < 99 or emean > 101 { throw "FAIL normal mean off: " + str(emean); }

// --- from_quantile: inverse-transform sampling from ANY distribution ---
let g8 = rng.seed(555);
let qf = fn(p) { return 10 + p * 10; };   // a uniform(10,20) quantile fn
let w = 0;
while w < 1000 {
    let v = rng.from_quantile(g8, qf);
    if v < 10 or v >= 20 { throw "FAIL from_quantile range: " + str(v); }
    w = w + 1;
}

// --- poisson(lambda): non-negative integers, empirical mean ~ lambda ---
let g9 = rng.seed(2718);
let pacc = 0;
let pn = 4000;
let pi = 0;
while pi < pn {
    let k = rng.poisson(g9, 3);
    if k < 0 { throw "FAIL poisson negative: " + str(k); }
    if num_floor(k) != k { throw "FAIL poisson not integer: " + str(k); }
    pacc = pacc + k;
    pi = pi + 1;
}
let pmean = pacc / pn;
if pmean < 2.7 or pmean > 3.3 { throw "FAIL poisson mean off: " + str(pmean); }

// --- binomial(n,p): integers in [0,n], empirical mean ~ n*p ---
let g10 = rng.seed(1414);
let bacc = 0;
let bn = 4000;
let bi = 0;
while bi < bn {
    let c = rng.binomial(g10, 10, 0.3);
    if c < 0 or c > 10 { throw "FAIL binomial range: " + str(c); }
    if num_floor(c) != c { throw "FAIL binomial not integer: " + str(c); }
    bacc = bacc + c;
    bi = bi + 1;
}
let bmean = bacc / bn;
if bmean < 2.7 or bmean > 3.3 { throw "FAIL binomial mean off: " + str(bmean); }

print "random_stdlib_pass";
