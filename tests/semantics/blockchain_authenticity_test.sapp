let BLOCKCHAIN = import("stdlib:blockchain.sapp");

fn require(value, message) {
    if not value { throw "FAIL blockchain authenticity: " + message; }
}

let public_key = sha256("public fixture");
let message = "release artifact digest";
let status = BLOCKCHAIN.authenticity_status();

require(len(public_key) == 64 and len(message) > 0,
    "forgery fixture must use the legacy public-value and nonempty message shapes");
require(not BLOCKCHAIN.verify_signature(public_key, message,
    hmac_sha256(public_key, message)),
    "a public-key HMAC forgery must never authenticate a publisher");
require(BLOCKCHAIN.sign_data("private fixture", message) == nil,
    "the compatibility signer must fail closed instead of emitting a mislabeled MAC");
let wallet = BLOCKCHAIN.create_wallet();
require(not wallet.ok and wallet.private_key == nil and wallet.public_key == nil
    and wallet.address == nil,
    "wallet compatibility API must not manufacture unauthenticated key material");
let transaction = BLOCKCHAIN.create_transaction("from", "to", 1, "private fixture");
require(not transaction.ok and not transaction.signed and transaction.signature == nil,
    "transaction compatibility API must not emit a forgeable signature");
require(status.format == "pblang.blockchain-authenticity.v1"
    and not status.available and status.algorithm == "none"
    and not status.public_key_signatures_verified
    and not status.publisher_authenticity_verified
    and status.legacy_hmac_signature_scheme_rejected,
    "status must describe the fail-closed authenticity boundary exactly");

print "blockchain_authenticity_pass";
