// tests/semantics/selfhost_loader_cli_test.sapp
//
// loader.cli_run(args) — the command-line adapter behind tools/pbrun.sapp. Given
// a user-arg array, it finds the .pbck path (skipping --flags), loads + runs it on
// the self-hosted VM, and returns { ok, exit_code, output, error } so the thin
// tool script just prints and exits. Tested directly (no subprocess).

let fe     = import("stdlib/compiler/selfhost_frontend.sapp");
let pbck   = import("stdlib/selfhost_pbck.sapp");
let loader = import("stdlib/selfhost_loader.sapp");

fn fail(m) { throw "FAIL " + m; }
fn expect(c, m) { if not c { fail(m); } }

fn uniq(tag) { return "/tmp/pblcli_" + tag + "_" + str(num_floor(now_ms())) + ".pbck"; }

// Emit a .pbck to run.
let cr = fe.frontend_compile("let x = 21; let y = x * 2; print y;");
expect(cr.ok, "compile ok");
let path = uniq("ok");
pbck.write_file(path, cr.chunk);

// 1. Happy path: a bare path runs, exit_code 0, output captured.
let r = loader.cli_run([path]);
expect(r.ok, "cli_run ok on a valid file");
expect(r.exit_code == 0, "success exit code is 0");
expect(r.output[0] == 42, "program output captured (21*2 == 42)");

// 2. Flags before the path are skipped; the path is still found.
let r2 = loader.cli_run(["--allow-all", path]);
expect(r2.ok and r2.output[0] == 42, "leading --flags are ignored, path still located");
fs_remove(path);

// 3. No path argument -> usage error, non-zero exit, not a crash.
let r3 = loader.cli_run(["--allow-all"]);
expect(r3.ok == false, "no path -> not ok");
expect(r3.exit_code == 2, "usage error exit code is 2");
expect(len(r3.error) > 0, "usage error has a message");

// 4. Missing file -> run error, exit 1.
let r4 = loader.cli_run(["/tmp/pblcli_missing_zzz.pbck"]);
expect(r4.ok == false, "missing file -> not ok");
expect(r4.exit_code == 1, "run error exit code is 1");

print "selfhost_loader_cli_pass";
