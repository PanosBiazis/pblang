let E = import("stdlib:embedded.sapp");
let A = import("stdlib:codegen_avr_embedded.sapp");
let AVR = import("stdlib:emulator_avr.sapp");

fn append(target, bytes) { for i len(bytes) { array_push(target, bytes[i]); } }

assert(AVR.load_direct(16, 192) == [0,145,192,0], "LDS encoding matches AVR instruction set");
assert(AVR.store_direct(198, 16) == [0,147,198,0], "STS encoding matches AVR instruction set");
assert(AVR.and_immediate(16,128) == [0,120]
    and AVR.or_immediate(16,3) == [3,96], "logical immediate encodings");
assert(AVR.subtract_immediate(16,1) == [1,80]
    and AVR.subtract_immediate_carry(17,0) == [16,64], "carry subtraction encodings");

let peripheral = [];
append(peripheral, AVR.load_immediate(16, 65));
append(peripheral, AVR.store_direct(198, 16));
append(peripheral, AVR.load_direct(17, 192));
append(peripheral, AVR.and_immediate(17, 32));
append(peripheral, AVR.compare_immediate(17, 32));
append(peripheral, AVR.halt());
let peripheral_run = AVR.run(peripheral, map{instruction_budget:100,
    stop_after_uart_bytes:1});
assert(peripheral_run.ok and peripheral_run.uart_tx == [65],
    "execution model captures bounded USART output");

let short_program = E.blink("status-led-test", 2);
let artifact = E.build(short_program, "arduino-uno");
assert(artifact.ok and artifact.backend == "native-avr8", "native AVR artifact emitted");
assert(not artifact.c_fallback and not artifact.compiler_dependency,
       "AVR backend has no C/vendor compiler dependency");
assert(A.parse_intel_hex(artifact.intel_hex) == artifact.binary, "canonical Intel HEX roundtrip");
assert(len(artifact.binary) < 128 and artifact.bytes == len(artifact.binary), "Blink firmware is compact");
assert(artifact.binary[0] == 248 and artifact.binary[1] == 148, "firmware starts with AVR CLI");

let verified = E.simulate(short_program, "arduino-uno", map{events:3,instruction_budget:100000});
assert(verified.ok and len(verified.events) == 3, "execution model observed three PORTD transitions");
assert(verified.events[0].value == 1 and verified.events[1].value == 0 and verified.events[2].value == 1,
       "generated firmware toggles D7 high-low-high");
let high_cycles = verified.events[1].cycles - verified.events[0].cycles;
assert(high_cycles > 30000 and high_cycles < 34000, "2ms timing is cycle-bounded at 16MHz");

let physical = E.build(E.blink("status-led-test", 500), "uno");
assert(physical.ok and len(physical.timing) == 2, "500ms physical firmware builds");
for i len(physical.timing) {
    assert(num_abs(physical.timing[i].actual_ms - 500) < 0.02, "500ms delay error remains below 0.02ms");
}
let esp = E.build(E.blink(), "esp32-devkitc-v4");
assert(not esp.ok and esp.status == "incomplete" and not esp.c_fallback,
       "ESP32 refuses fake or C-fallback firmware");
print "embedded_avr_codegen_pass";
