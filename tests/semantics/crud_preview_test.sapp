let P = import("stdlib:crud_preview.sapp");
fn denied(action) { let failed = false; try action() catch { failed = true; }; return failed; }
for body in ["id=1&id=2", "csrf=x&c%73rf=y", "id=%", "id=%ZZ", "id=%FF", "unknown=x", "id", "id=1=2"] {
    assert(denied(fn(){ P.form(body); }), "malformed form");
}
assert(P.form("name=%CE%94%CE%BF%CE%BA%CE%B9%CE%BC%CE%AE+test").name == "Δοκιμή test", "UTF-8 form");
let app = P.create(8765, 2);
fn req(method, path, body = "", headers = nil) {
    if headers == nil { headers = map{ host: "127.0.0.1:8765", origin: "http://127.0.0.1:8765", "content-type": "application/x-www-form-urlencoded" }; }
    return map{ method: method, path: path, body: body, headers: headers };
}
let home = app.handle(req("GET", "/")); assert(home.status == 200, "home");
let prefix = "name=\"csrf\" value=\"";
let token = str_split(str_split(home.body, prefix)[1], "\"")[0];
assert(len(token) == 64 and home.headers["Cache-Control"] == "no-store", "token and cache");
let body = "csrf=" + token + "&revision=0&id=1&name=%3Cscript%3E&country=Example&time=01%3A23";
assert(app.handle(req("POST", "/create", body)).status == 303, "create");
assert(app.handle(req("POST", "/create", body)).status == 400, "stale duplicate");
let rendered = app.handle(req("GET", "/"));
assert(str_contains(rendered.body, "&lt;script&gt;") and not str_contains(rendered.body, "<script>"), "stored HTML escaped");
assert(app.handle(req("POST", "/delete", "csrf=bad&revision=1&id=1")).status == 403, "CSRF");
assert(app.handle(req("POST", "/delete", "", map{ host: "127.0.0.1:8765", origin: "https://example.invalid" })).status == 403, "cross-origin");
assert(app.handle(req("GET", "/", "", map{ host: "example.invalid" })).status == 403, "Host");
assert(app.handle(req("GET", "/delete")).status == 404, "GET no mutation");
assert(app.handle(req("PUT", "/create")).status == 405, "method");
assert(app.handle(req("GET", "/?page=0")).status == 400, "page bounds");
assert(app.handle(req("GET", "/?q=%3Cscript%3E")).status == 200, "search");
assert(app.handle(req("POST", "/update", "csrf="+token+"&revision=1&id=1&name=Updated&country=Test&time=2")).status == 303, "update");
assert(app.handle(req("POST", "/delete", "csrf="+token+"&revision=2&id=1")).status == 303, "delete");
assert(app.handle(req("POST", "/clear", "csrf="+token+"&revision=3&confirmation=DELETE+ALL")).status == 303, "clear");
app.close(); print "crud_preview_pass";
