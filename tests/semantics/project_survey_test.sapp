// Test: stdlib/project_survey.sapp safe path classification and project ideas.

let S = import("stdlib:project_survey.sapp");

fn fail(m) { throw "FAIL " + m; }

let paths = [
    "/media/example-user/TestDrive/workspace/Documents/projects/AAP/ai/pbai",
    "/media/example-user/TestDrive/workspace/Documents/projects/AAP/pl-dev/pblang",
    "/media/example-user/TestDrive/workspace/Documents/projects/AAP/os-dev/pbos",
    "/media/example-user/TestDrive/workspace/Documents/projects/AAP/tools/rust/pb-mcp-server",
    "/media/example-user/TestDrive/workspace/Documents/projects/AAP/products/pbremote",
    "/usr/share/vulkan",
    "/usr/share/mesa-demos",
    "/home/example-user/repos/pblang-clean/benches",
    "/home/example-user/.ssh/id_ed25519",
    "/home/example-user/.cache/Cursor/GPUCache",
    "/home/example-user/Documents/security-audit",
    "/home/example-user/Documents/books/licensed-corpus",
    "/home/example-user/Web/native-browser-lab",
    "/home/example-user/AndroidStudioProjects/mobile-app",
    "/home/example-user/database/sqlite-labs"
];

if not S.sensitive_path("/home/example-user/.ssh/id_ed25519") { fail("ssh key path is sensitive"); }
if not S.sensitive_path("/home/example-user/.cache/Cursor/GPUCache") { fail("cache path is sensitive"); }
if S.sensitive_path("/usr/share/vulkan") { fail("vulkan metadata path is not sensitive"); }

if S.path_category("/usr/share/vulkan") != "graphics" { fail("vulkan path category graphics"); }
if S.path_category("/media/example-user/TestDrive/workspace/Documents/projects/AAP/ai/pbai") != "ai" { fail("pbai path category ai"); }
if S.path_category("/media/example-user/TestDrive/workspace/Documents/projects/AAP/os-dev/pbos") != "os" { fail("pbos path category os"); }
if S.path_category("/media/example-user/TestDrive/workspace/Documents/projects/AAP/tools/rust/pb-mcp-server") != "mcp" { fail("pb-mcp path category mcp"); }

let rec = S.path_record("/home/example-user/.ssh/id_ed25519");
if rec.safe_for_ideas { fail("sensitive record is not safe for ideas"); }
if not str_contains(rec.path, "[redacted]") { fail("sensitive record path is redacted"); }

let report = S.survey_paths(paths, 100);
if report.format != "pblang.project_survey.report.v1" { fail("report format"); }
if report.skipped_sensitive != 2 { fail("survey skips two sensitive paths, got " + str(report.skipped_sensitive)); }
if (try report.counts.ai catch 0) < 1 { fail("survey counts ai paths"); }
if (try report.counts.graphics catch 0) < 1 { fail("survey counts graphics paths"); }
if (try report.counts.mcp catch 0) < 1 { fail("survey counts mcp paths"); }

let health = S.portfolio_product_health(paths, ["pblang", "pbai", "pbos", "pbide", "pb-mcp-server", "pbremote"]);
if health.format != "pblang.product_health.portfolio.v1" { fail("portfolio product health format"); }
if len(health.reports) != 6 { fail("portfolio product health includes six products"); }
if health.status == "blocked" { fail("safe AAP metadata must not produce blocked product health"); }
if len(S.portfolio_product_health_lines(health, 10)) < 7 { fail("product health lines include products"); }

let pbide = S.ideas_for_project("pbide", report.records);
let pbide_text = str_join(pbide.ideas, "\n");
if not str_contains(pbide_text, "GPU-present") { fail("pbide ideas include GPU-present rendering"); }
if not str_contains(pbide_text, "native browser") { fail("pbide ideas include native browser growth"); }

let pbai = S.ideas_for_project("pbai", report.records);
let pbai_text = str_join(pbai.ideas, "\n");
if not str_contains(pbai_text, "curated corpus") { fail("pbai ideas include curated corpus"); }
if not str_contains(pbai_text, "secrets") { fail("pbai ideas include secret filtering"); }

let mcp = S.ideas_for_project("pb-mcp-server", report.records);
let mcp_text = str_join(mcp.ideas, "\n");
if not str_contains(mcp_text, "read/write/network") { fail("mcp ideas include tool gate classification"); }

let remote = S.ideas_for_project("pbremote", report.records);
let remote_text = str_join(remote.ideas, "\n");
if not str_contains(remote_text, "peer nodes") or not str_contains(remote_text, "TLS/QUIC") { fail("pbremote ideas include peer and secure transport contracts"); }

let plan = S.cross_project_plan(paths);
if plan.format != "pblang.project_survey.plan.v1" { fail("plan format"); }
if len(plan.projects) != 16 { fail("cross-project plan covers every declared product"); }
if plan.projects[0].project != "pblang" or plan.projects[2].project != "pb-mcp-server"
    or plan.projects[3].project != "pbremote" or plan.projects[4].project != "pbspotit" { fail("cross-project project order"); }
if plan.survey.skipped_sensitive != 2 { fail("cross-project plan preserves safe survey policy"); }

let proposal_records = [];
for proposal_record in report.records { array_push(proposal_records, proposal_record); }
array_push(proposal_records, map{category:"ide",safe_for_ideas:true,path:"/example/pbide"});
let proposals = S.proposal_catalog(proposal_records);
if proposals.format != "pblang.project_survey.proposal_catalog.v1"
    or proposals.repository_creation_allowed or not proposals.deduplicated { fail("proposal catalog policy"); }
let proposal_text = str_join(S.proposal_lines(proposals, 8), "\n");
if not str_contains(proposal_text, "forms-ir") or not str_contains(proposal_text, "pbknowledge") {
    fail("metadata category combinations create existing-module and new-project review candidates: " + proposal_text);
}
for proposal in proposals.proposals {
    if proposal.status != "review-required" or proposal.repository_created
       or proposal.implementation_started or len(proposal.gates) < 5 {
        fail("proposals remain review-only and gated");
    }
}
for proposal in proposals.proposals {
    let review=S.review_proposal(proposal);
    if not review.ok or review.decision!="recommended-existing-module-first"
       or review.repository_creation_allowed or review.implementation_allowed
       or review.independent_review_verified {
        fail("reviewed proposals remain existing-module-first and repository-safe");
    }
    if (proposal.id=="pbknowledge" and review.destination!="pbai")
       or (proposal.id=="pbdevice-lab" and not str_contains(review.destination,"pbremote")) {
        fail("new-project candidates are routed into their existing owners first");
    }
}
let unknown_review=S.review_proposal(map{format:"pblang.project_survey.proposal.v1",id:"unknown"});
if unknown_review.ok or unknown_review.repository_creation_allowed {
    fail("unknown proposal cannot create a repository or start implementation");
}
let rejected_proposal_line = str_join(S.proposal_lines(map{
    format:"pblang.project_survey.proposal_catalog.v1",proposal_count:1,
    proposals:[map{format:"pblang.project_survey.proposal.v1",id:"bad",destination:"pbai",
        preferred_scope:"existing-module",title:"unsafe\nterminal",status:"review-required",
        repository_created:false}]
}, 4), "\n");
if str_contains(rejected_proposal_line, "unsafe")
   or not str_contains(rejected_proposal_line, "invalid proposal record rejected") {
    fail("proposal renderer rejects untrusted terminal text");
}
let rejected_header = str_join(S.proposal_lines(map{
    format:"pblang.project_survey.proposal_catalog.v1",proposal_count:"1\nunsafe",
    proposals:[]
}, 4), "\n");
if str_contains(rejected_header, "unsafe") or not str_contains(rejected_header, "invalid catalog") {
    fail("proposal renderer validates its header count before rendering");
}
let too_many_records = [];
for _record_index 50001 { array_push(too_many_records, map{category:"ai",safe_for_ideas:true}); }
let oversized_proposals = S.proposal_catalog(too_many_records);
if oversized_proposals.complete or oversized_proposals.proposal_count != 0 {
    fail("proposal catalog rejects oversized record input before classification");
}

let portfolio = S.portfolio_readiness(paths);
if portfolio.format != "pblang.project_survey.portfolio_readiness.v1" { fail("portfolio readiness format"); }
if len(portfolio.projects) != 16 { fail("portfolio readiness covers every declared product"); }
if portfolio.survey.skipped_sensitive != 2 { fail("portfolio readiness preserves safe skip count"); }
if portfolio.projects[0].format != "pblang.project_survey.portfolio_project.v1" { fail("portfolio project row format"); }
if portfolio.projects[0].readiness_score < 50 { fail("pblang portfolio readiness has useful score"); }
if len(portfolio.projects[0].device_routes) < 2 { fail("portfolio project row exposes device routes"); }
if not str_contains(str_join(portfolio.projects[6].next_actions, "\n"), "render/input") { fail("pbide portfolio next actions include render/input watcher rule"); }
if not str_contains(str_join(portfolio.projects[2].gates, "\n"), "read/write/network") { fail("mcp portfolio gates include tool classes"); }
if not str_contains(str_join(portfolio.projects[3].gates, "\n"), "replay protection") { fail("pbremote portfolio gates include remote authority controls"); }
if not str_contains(str_join(portfolio.projects[4].gates, "\n"), "physical evidence") { fail("pbspotit portfolio gates include Android physical evidence"); }
if len(portfolio.top_priorities) != 16 { fail("portfolio top priorities cover every project"); }
let portfolio_lines = S.portfolio_readiness_lines(portfolio, 8);
if len(portfolio_lines) < 5 or not str_contains(portfolio_lines[0], "Portfolio readiness") or not str_contains(str_join(portfolio_lines, "\n"), "pbai") { fail("portfolio readiness lines summarize projects"); }

let graphics_protocols = str_join(S.category_protocols("graphics"), "\n");
if not str_contains(graphics_protocols, "dirty-region") or not str_contains(graphics_protocols, "GPU-present") { fail("graphics protocols include dirty-region and GPU-present"); }
let security_protocols = str_join(S.category_protocols("security"), "\n");
if not str_contains(security_protocols, "deny-by-default") or not str_contains(security_protocols, "audit trail") { fail("security protocols include gates and audit trail"); }

let pbide_tasks = S.project_improvement_tasks("pbide", report.records, 6);
let pbide_task_text = str_join(S.portfolio_action_lines(map{ survey: report, projects: [pbide_tasks], top_tasks: pbide_tasks.tasks, policy: "test" }, 12), "\n");
if pbide_tasks.format != "pblang.project_survey.project_action_plan.v1" or pbide_tasks.task_count < 3 { fail("pbide project action plan format and count"); }
if not str_contains(pbide_task_text, "dirty-region GPU-present") or not str_contains(pbide_task_text, "native browser") { fail("pbide tasks include GPU rendering and browser safety"); }
if len(pbide_tasks.tasks[0].protocols) < 3 or len(pbide_tasks.tasks[0].gates) < 3 { fail("project tasks expose protocols and gates"); }

let action = S.portfolio_action_plan(paths, nil, 4);
if action.format != "pblang.project_survey.portfolio_action_plan.v1" { fail("portfolio action plan format"); }
if len(action.projects) != 16 or len(action.top_tasks) != 10 { fail("portfolio action plan covers every product and keeps a bounded top-ten queue"); }
let action_text = str_join(S.portfolio_action_lines(action, 20), "\n");
if not str_contains(action_text, "pbai/ai") or not str_contains(action_text, "curated") { fail("portfolio action plan includes pbai curated-data work"); }
if not str_contains(action_text, "pb-mcp-server") or not str_contains(action_text, "Classify every tool") { fail("portfolio action plan includes pb-mcp tool classification"); }
if not str_contains(action_text, "pbide/graphics") or not str_contains(action_text, "GPU-present") { fail("portfolio action plan includes pbide GPU-present work"); }
if not str_contains(action_text, "pbremote/security") or not str_contains(action_text, "replay rejection") { fail("portfolio action plan includes pbremote security work"); }

let pbide_health = S.project_category_health("pbide", report.records);
if pbide_health.format != "pblang.project_survey.category_health.v1" or len(pbide_health.rows) < 5 { fail("project category health format and rows"); }
if pbide_health.high_risk_missing < 1 { fail("pbide category health reports missing high-risk focus"); }
let pbide_health_text = str_join(S.portfolio_category_health_lines(map{ status: pbide_health.status, survey: report, rows: pbide_health.rows, high_risk_missing: pbide_health.high_risk_missing, policy: pbide_health.policy }, 12), "\n");
if not str_contains(pbide_health_text, "Portfolio category health") or not str_contains(pbide_health_text, "pbide/ide") or not str_contains(pbide_health_text, "GPU-present") { fail("project category health lines include pbide focus and GPU route"); }

let health = S.portfolio_category_health(paths, nil);
if health.format != "pblang.project_survey.portfolio_category_health.v1" or len(health.projects) != 16 or len(health.rows) < 70 { fail("portfolio category health covers products and rows"); }
if health.high_risk_missing < 1 { fail("portfolio category health finds high-risk missing categories"); }
let health_text = str_join(S.portfolio_category_health_lines(health, 50), "\n");
if not str_contains(health_text, "pbai/data") or not str_contains(health_text, "pb-mcp-server/security") or not str_contains(health_text, "high-risk") { fail("portfolio category health lines include AI/MCP/security category detail"); }

print "project_survey_pass";
