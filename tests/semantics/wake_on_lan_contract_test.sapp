let WOL = import("stdlib:wake_on_lan.sapp");
let UDP = import("stdlib:native_udp.sapp");
fn expect(value,message){if not value{throw "FAIL Wake-on-LAN: "+message;}}

let parsed=WOL.parse_mac("aA-bb-0C-0d-EE-ff");
expect(parsed.ok and parsed.canonical=="AA:BB:0C:0D:EE:FF"
    and parsed.bytes==[170,187,12,13,238,255],"strict canonical MAC parsing");
for invalid in ["", "aa:bb:cc:dd:ee", "aa:bb:cc:dd:ee:ff:00",
    "aa:bb:cc:dd:ee:gg", "a:bb:cc:dd:ee:ff", "aabbccddeeff"] {
    expect(not WOL.parse_mac(invalid).ok,"malformed MAC rejected: "+invalid);
}
let packet=WOL.magic_packet("01:23:45:67:89:ab");
expect(packet.ok and packet.byte_count==102 and packet.sync_bytes==6 and packet.repetitions==16,
    "canonical packet dimensions");
expect(slice(packet.bytes,0,6)==[255,255,255,255,255,255]
    and slice(packet.bytes,6,12)==[1,35,69,103,137,171]
    and slice(packet.bytes,96,102)==[1,35,69,103,137,171],"magic packet framing");

if platform()=="linux" and UDP.available().ok {
    let listener=UDP.listen_ipv4("127.0.0.1",0);expect(listener.ok,"loopback listener");
    let sent=WOL.send_ipv4("01:23:45:67:89:ab","127.0.0.1",listener.port,
        map{timeout_ms:500,broadcast:false});
    let received=UDP.receive(listener,256,500);UDP.close(listener);
    expect(sent.ok and sent.sent and sent.bytes==102 and not sent.broadcast
        and not sent.fallback_attempted and not sent.shell_used,"native exact send");
    expect(received.ok and received.count==102 and received.bytes==packet.bytes,
        "real binary datagram equals canonical magic packet");
}
print "wake_on_lan_contract_pass";
