let uni = import("stdlib:unicode.sapp");
let tok = import("stdlib/compiler/tokenizer.sapp");

let smile = "😀";
assert(len(smile) == 1, "direct emoji is one Unicode scalar");
assert(strcharcodeat(smile, 0) == 128512, "direct emoji codepoint");
assert(strfromcharcode(128512) == smile, "emoji round-trips through strfromcharcode");

let escaped = "\u{1F600}";
assert(escaped == smile, "braced unicode escape creates emoji");
let pi = strfromcharcode(960);
assert("\u03C0" == pi, "four-digit unicode escape still works");

let mixed = "pblang π ∏ ≤ 😀 🚀";
let cps = uni.codepoints(mixed);
assert(len(cps) == len(mixed), "unicode helper returns one codepoint per scalar");
assert(uni.contains_emoji(mixed), "unicode helper detects emoji");
assert(uni.classify_codepoint(128512) == "emoji", "unicode helper classifies emoji");
assert(uni.classify_codepoint(8804) == "math", "unicode helper classifies math symbol");
assert(uni.escape_codepoint(128640) == "\\u{1F680}", "unicode helper escapes rocket");
assert(uni.escape_string("A\n😀") == "A\\n😀", "unicode helper escapes control but keeps emoji");
assert(uni.classify_character("a") == "lowercase", "ASCII lowercase classification");
assert(uni.classify_character("Ω") == "uppercase", "Greek uppercase classification");
assert(uni.classify_character("λ") == "lowercase", "Greek lowercase classification");
assert(uni.classify_character("٣") == "digit", "Arabic-Indic decimal digit classification");
assert(uni.classify_character(" ") == "whitespace", "Unicode whitespace classification");
assert(uni.classify_character("😀") == "emoji", "emoji character classification");
assert(uni.classify_character("≤") == "math", "mathematical character classification");
assert(uni.classify_character("!") == "punctuation", "ASCII punctuation classification");
assert(uni.classify_character("") == "invalid", "empty character fails closed");
assert(uni.classify_character("ab") == "invalid", "multiple characters fail closed");
let classified = uni.classify_text("A٣😀");
assert(len(classified) == 3, "text classification is scalar indexed");
assert(classified[0].kind == "uppercase" and classified[1].kind == "digit"
    and classified[2].kind == "emoji", "text classification preserves order and kinds");

let tokens = tok.tokenize("let face = \"\\u{1F600}\"; // 😀 comment");
let found = false;
for t in tokens {
    if t.kind == "string" and t.text == smile { found = true; }
}
assert(found, "self-host tokenizer decodes braced unicode escape");

print "unicode_characters_pass";
