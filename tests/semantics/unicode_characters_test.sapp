let uni = import("stdlib:unicode.sapp");
let tok = import("stdlib/compiler/tokenizer.sapp");

let smile = "😀";
assert(len(smile) == 1, "direct emoji is one Unicode scalar");
assert(strcharcodeat(smile, 0) == 128512, "direct emoji codepoint");
assert(strfromcharcode(128512) == smile, "emoji round-trips through strfromcharcode");

let escaped = "\u{1F600}";
assert(escaped == smile, "braced unicode escape creates emoji");
assert("\u03C0" == "π", "four-digit unicode escape still works");

let mixed = "pblang π ∏ ≤ 😀 🚀";
let cps = uni.codepoints(mixed);
assert(len(cps) == len(mixed), "unicode helper returns one codepoint per scalar");
assert(uni.contains_emoji(mixed), "unicode helper detects emoji");
assert(uni.classify_codepoint(128512) == "emoji", "unicode helper classifies emoji");
assert(uni.classify_codepoint(8804) == "math", "unicode helper classifies math symbol");
assert(uni.escape_codepoint(128640) == "\\u{1F680}", "unicode helper escapes rocket");
assert(uni.escape_string("A\n😀") == "A\\n😀", "unicode helper escapes control but keeps emoji");

let tokens = tok.tokenize("let face = \"\\u{1F600}\"; // 😀 comment");
let found = false;
for t in tokens {
    if t.kind == "string" and t.text == smile { found = true; }
}
assert(found, "self-host tokenizer decodes braced unicode escape");

print "unicode_characters_pass";
