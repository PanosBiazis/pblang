// Test: testing.sapp runner + matcher hardening.
//
// Pins the fixes for real framework bugs:
//   - a test fn that returns nil (i.e. any normal statement-bodied test)
//     was counted as FAIL — the runner could not tell nil-return from throw;
//   - expect_throws had a false positive when the fn legitimately returned
//     the string "caught";
//   - a throwing before_each/after_each was silently swallowed and the test
//     still PASSED against broken state.
// Plus the additions: reset(), stats(), fit() focus mode, fail(),
// to_be_close_to / to_start_with / to_end_with.

let t = import("stdlib:testing.sapp");

fn eq(a, b, msg) {
    if a != b { return error("FAIL " + msg + ": got " + str(a) + ", want " + str(b)); }
}

// ── nil-returning test must PASS ─────────────────────────────────────────────
// A statement-bodied fn returns nil in pblang, so this is every normal test.
t.reset();
t.describe("nil returns pass", fn() {
    t.it("statement body", fn() { let x = 1 + 1; eq(x, 2, "inner"); });
});
let r1 = t.run_all();
eq(r1.passed, 1, "nil-return test passed");
eq(r1.failed, 0, "nil-return test not failed");

// ── throwing test must FAIL (and run_all raises) ─────────────────────────────
t.reset();
t.describe("throw fails", fn() {
    t.it("boom", fn() { return error("boom"); });
});
let r2 = try map{ ok: true, value: t.run_all() } catch map{ ok: false, value: nil };
eq(r2.ok, false, "run_all raises on failure");
let s2 = t.stats();
eq(s2.failed, 1, "throwing test counted as failed");
eq(s2.passed, 0, "throwing test not counted as passed");

// ── test returning false must FAIL (kept behavior) ───────────────────────────
t.reset();
t.describe("false fails", fn() {
    t.it("returns false", fn() { return false; });
});
let r3 = try map{ ok: true, value: t.run_all() } catch map{ ok: false, value: nil };
eq(r3.ok, false, "false-returning test fails the run");
eq(t.stats().failed, 1, "false return counted as failed");

// ── throwing before_each fails the test ──────────────────────────────────────
t.reset();
t.describe("hook throws", fn() {
    t.before_each(fn() { return error("bad setup"); });
    t.it("never trusts broken state", fn() { return true; });
});
let r4 = try map{ ok: true, value: t.run_all() } catch map{ ok: false, value: nil };
eq(r4.ok, false, "throwing before_each fails the run");
eq(t.stats().failed, 1, "before_each throw counted as failed");

// ── throwing after_each fails an otherwise-passing test ──────────────────────
t.reset();
t.describe("teardown throws", fn() {
    t.after_each(fn() { return error("bad teardown"); });
    t.it("test body ok", fn() { return true; });
});
let r5 = try map{ ok: true, value: t.run_all() } catch map{ ok: false, value: nil };
eq(r5.ok, false, "throwing after_each fails the run");
eq(t.stats().failed, 1, "after_each throw counted as failed");

// ── reset() isolates runs ─────────────────────────────────────────────────────
t.reset();
t.describe("fresh", fn() {
    t.it("one", fn() { return true; });
});
let r6 = t.run_all();
eq(r6.passed, 1, "reset cleared previous suites");

// ── fit() focus mode: only focused tests run ─────────────────────────────────
t.reset();
t.describe("focus", fn() {
    t.it("unfocused", fn() { return error("should not run"); });
    t.fit("focused", fn() { return true; });
});
let r7 = t.run_all();
eq(r7.passed, 1, "focused test ran");
eq(r7.failed, 0, "unfocused throwing test did not run");
eq(r7.skipped, 1, "unfocused test counted skipped");

// ── xit still skips ───────────────────────────────────────────────────────────
t.reset();
t.describe("skips", fn() {
    t.xit("pending", fn() { return error("never"); });
    t.it("real", fn() { return true; });
});
let r8 = t.run_all();
eq(r8.passed, 1, "real test passed");
eq(r8.skipped, 1, "xit skipped");

// ── expect_throws: no false positive on 'caught' return ─────────────────────
let fp = try map{ ok: true, value: t.expect_throws(fn() { return "caught"; }) }
         catch map{ ok: false, value: nil };
eq(fp.ok, false, "fn returning 'caught' is NOT a throw");
eq(t.expect_throws(fn() { return error("x"); }), true, "real throw detected");

// ── new matchers ──────────────────────────────────────────────────────────────
t.expect(0.1 + 0.2).to_be_close_to(0.3, 0.000000001);
let far = try map{ ok: true, value: t.expect(1.0).to_be_close_to(2.0, 0.5) }
          catch map{ ok: false, value: nil };
eq(far.ok, false, "to_be_close_to rejects out-of-tolerance");

t.expect("hello world").to_start_with("hello");
t.expect("hello world").to_end_with("world");
let sw = try map{ ok: true, value: t.expect("abc").to_start_with("b") }
         catch map{ ok: false, value: nil };
eq(sw.ok, false, "to_start_with rejects wrong prefix");

// fail() always raises
let fl = try map{ ok: true, value: t.fail("forced") } catch map{ ok: false, value: nil };
eq(fl.ok, false, "fail() raises");

// deep equality already structural: pin it so it never regresses
t.expect([1, map{ a: [2, 3] }]).to_equal([1, map{ a: [2, 3] }]);

t.reset();
print "testing_framework_pass";
