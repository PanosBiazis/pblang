let PCAP=import("stdlib:pcap_capture.sapp");
fn expect(value,message){if not value{throw "FAIL pcap capture: "+message;}}
fn rejected(work){return try { work(); false } catch true;}
let header=[212,195,178,161,2,0,4,0,0,0,0,0,0,0,0,0,96,0,0,0,1,0,0,0];
let record=[1,0,0,0,2,0,0,0,4,0,0,0,4,0,0,0,1,2,3,4];
let capture=[];for i len(header){array_push(capture,header[i]);}for i len(record){array_push(capture,record[i]);}
let parsed=PCAP.parse(capture,8);
expect(parsed.ok and parsed.version=="2.4" and parsed.byte_order=="little"
    and parsed.packet_count==1 and parsed.packets[0].captured_length==4
    and not parsed.payloads_exposed and not parsed.raw_capture_exposed,"bounded metadata parser");
let truncated=[];for i len(header){array_push(truncated,header[i]);}let tail=[1,0,0];for i len(tail){array_push(truncated,tail[i]);}
expect(not PCAP.parse(truncated,8).ok
    and not PCAP.parse([0,1,2,3],8).ok,"malformed records fail closed");
expect(rejected(fn(){PCAP.capture(map{interface:"lo;id"});})
    and rejected(fn(){PCAP.capture(map{interface:"lo",protocol:"host 1.2.3.4"});}),
    "interface and arbitrary BPF rejection");
let status=PCAP.status();expect(status.classic_pcap and status.private_descriptor_spool
    and not status.payloads_exposed and not status.arbitrary_bpf_enabled,"capture policy");
print "pcap_capture_contract_pass";
