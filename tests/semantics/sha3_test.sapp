let SHA3 = import("stdlib:sha3.sapp");

fn require(value, message) { if not value { throw "sha3_test: " + message; } }

require(SHA3.digest_hex("") == "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a", "empty FIPS 202 vector");
require(SHA3.digest_hex("abc") == "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532", "abc FIPS 202 vector");
require(SHA3.digest_hex(str_repeat("a", 200)) == "cce34485baf2bf2aca99b94833892a4f52896d3d153f7b840cc4f9fe695f1387", "multi-block vector");
require(len(SHA3.digest_bytes([0, 255, 128])) == 32, "byte-array input");
let rejected = try { SHA3.digest_bytes(42); false } catch true;
require(rejected, "invalid input rejected");

print "sha3_pass";
