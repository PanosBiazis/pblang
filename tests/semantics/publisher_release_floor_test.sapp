let ADMISSION = import("stdlib:publisher_artifact_admission.sapp");
let RELEASE = import("stdlib:product_release_evidence.sapp");
let TRUST = import("stdlib:publisher_trust_store.sapp");
let SECURE = import("stdlib:secure_file.sapp");
let SHA256 = import("stdlib:sha256_pb.sapp");

let A = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
let B = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
let C = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc";
let D = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd";
let COMMIT = "0123456789abcdef0123456789abcdef01234567";
let KEY_HEX = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a";
let KEY_ID = "21fe31dfa154a261626bf854046fd2271b7bed4b6abe45aa58877ef47f9721b9";
let ARTIFACT_DIGEST = "87c04077a5bbf4abf090f9122a5d170d411c453b98e9eb672a1b96452aa15c87";
let HEX = "0123456789abcdef";

fn require(condition, message) { if not condition { throw message; } }

fn nibble(ch) {
    let index = 0;
    while index < len(HEX) {
        if str_slice(HEX, index, index + 1) == str_lower(ch) { return index; }
        index = index + 1;
    }
    throw "invalid test hex";
}

fn bytes(text) {
    let out = []; let index = 0;
    while index < len(text) {
        array_push(out, nibble(str_slice(text, index, index + 1)) * 16
            + nibble(str_slice(text, index + 1, index + 2)));
        index = index + 2;
    }
    return out;
}

fn signature(sequence) {
    if sequence == 41 {
        return bytes("5921a92af9988684618dbf2555943d2097dfd09fb4f1551eaa5584c23fafddd4"
            + "2edd36ddaab3121bed12addaa30f3f7bc73e7b1ccf6b928ceba0a18e8e5efe08");
    }
    if sequence == 42 {
        return bytes("e96b924de1e42cc0d2c22d8c9c9ae9f8eedeb042732a921c6dfaee579aa477f2"
            + "031230fc6268b5b8fa191102f3190a132febe6c1582e78d12af6d5ce5ca0b506");
    }
    if sequence == 43 {
        return bytes("789a4477e7f1a8f90ff25ab11e8d9002972c2b1c36ecc57366dc5280023c2114"
            + "5349e22b183bf35ce2bb03f92223d4535f59b439526cd452cdf2a707744f610b");
    }
    if sequence == 44 {
        return bytes("a31e6bb641c69186cb8a72522ecf64c4ac4684e762e54c42b4dadc321f7b6166"
            + "3068f391441372d245b61525d67ee21fc491d779ad5cee47f062a16f83e2030c");
    }
    if sequence == 45 {
        return bytes("5fcad0423f0ea80eeab78353a4dc053088a3c9819adcd8094b6279861ee09eb1"
            + "032b0fe15e4c5efb92139ff8a201b400d496c17b45b5e6c76f6e9874ce0a810d");
    }
    throw "unsupported release-floor signature fixture";
}

fn source() {
    return RELEASE.source("demo", "1.2.3", "stable", "0.6.0-alpha",
        A, B, C, COMMIT, map{clean_tree:true, reproducible_inputs:true});
}

fn artifact(source_row) {
    return RELEASE.artifact(source_row, "demo.pbck", ARTIFACT_DIGEST, 26, A,
        "1.2.3", "stable", ["linux:x86_64", "linux:aarch64"], map{
            signed_artifact:true, signature_sha256:C, sbom_sha256:D,
            attestation_sha256:A, install_verified:false,
            upgrade_verified:false, rollback_verified:false,
            uninstall_verified:false});
}

fn store_text(generation) {
    return json_stringify(map{format:TRUST.FORMAT, generation:generation,
        publishers:[map{publisher_id:"example-publisher", policy_revision:3,
            key_id:KEY_ID, algorithm:"ed25519",
            public_key:base64_encode_bytes(bytes(KEY_HEX)), state:"active",
            product:"demo", package_id:"org.example.demo",
            release_channels:["stable"],
            targets:["linux:aarch64", "linux:x86_64"]}]});
}

fn framed(domain, values) {
    let out = domain + "|";
    for value in values {
        let text = str(value);
        out = out + str(len(str_to_bytes(text))) + ":" + text;
    }
    return out;
}

fn floor_name(artifact_name) {
    let targets = sha256(framed("pblang.publisher-target-scope.v1",
        ["linux:aarch64", "linux:x86_64"]));
    let scope = sha256(framed("pblang.publisher-release-floor-scope.v1",
        ["example-publisher", "demo", "org.example.demo", "stable",
         artifact_name, targets]));
    return "publisher-floor-" + scope + ".json";
}

fn legacy_floor_name_without_artifact_stream() {
    let targets = sha256(framed("pblang.publisher-target-scope.v1",
        ["linux:aarch64", "linux:x86_64"]));
    let scope = sha256(framed("pblang.publisher-release-floor-scope.v1",
        ["example-publisher", "demo", "org.example.demo", "stable", targets]));
    return "publisher-floor-" + scope + ".json";
}

fn admission_request(store_path, artifact_path, sequence) {
    let source_row = source(); let artifact_row = artifact(source_row);
    let policy = RELEASE.publisher_policy("example-publisher", 3,
        bytes(KEY_HEX));
    let attestation = RELEASE.publisher_attestation_v2(source_row, artifact_row,
        policy, "org.example.demo", sequence, signature(sequence));
    return map{format:ADMISSION.REQUEST_FORMAT,
        trust_store_path:store_path, artifact_path:artifact_path,
        source:source_row, artifact:artifact_row, attestation:attestation};
}

fn prepared_with(store_path, artifact_path, sequence, state_root, expectation) {
    return ADMISSION.prepare_with_cooperative_floor(
        admission_request(store_path, artifact_path, sequence),
        state_root, expectation);
}

fn floor_record(scope_name, key_id, policy_revision, generation, sequence,
                extra = false) {
    let record = map{format:ADMISSION.FLOOR_FORMAT,
        scope_sha256:str_slice(scope_name, len("publisher-floor-"),
            len(scope_name) - len(".json")),
        key_id:key_id, policy_revision:policy_revision,
        store_generation:generation, release_sequence:sequence,
        artifact_digest_algorithm:RELEASE.ARTIFACT_DIGEST_ALGORITHM,
        artifact_sha256:ARTIFACT_DIGEST};
    if extra { record.unexpected = true; }
    return json_stringify(record);
}

fn private_root(path) {
    require(SECURE.create_private_temporary_directory_new(path).ok,
        "private release-floor root creation failed");
    return path;
}

fn remove_root(root, names) {
    for name in names {
        try SECURE.remove_file(root + "/" + name, true) catch nil;
    }
    require(SECURE.remove(root, false).ok,
        "release-floor fixture root cleanup failed");
}

let suffix = str_slice(sha256(base64_encode_bytes(random_bytes(24))), 0, 24);
let fixture = private_root("/tmp/pblang-release-floor-fixture-" + suffix);
let state = private_root("/tmp/pblang-release-floor-state-" + suffix);
let alternate = private_root("/tmp/pblang-release-floor-alternate-" + suffix);
let wrong_mode = private_root("/tmp/pblang-release-floor-mode-" + suffix);
let symlink_root = private_root("/tmp/pblang-release-floor-symlink-" + suffix);
let hardlink_root = private_root("/tmp/pblang-release-floor-hardlink-" + suffix);
let oversized_root = private_root("/tmp/pblang-release-floor-oversized-" + suffix);
let policy_root = private_root("/tmp/pblang-release-floor-policy-" + suffix);
let key_root = private_root("/tmp/pblang-release-floor-key-" + suffix);
let canonical_root = private_root("/tmp/pblang-release-floor-canonical-" + suffix);
let existing_root = private_root("/tmp/pblang-release-floor-existing-" + suffix);
let store_path = fixture + "/trusted.json";
let old_store_path = fixture + "/old-trusted.json";
let artifact_path = fixture + "/demo.pbck";
require(SECURE.write_text_new_exclusive(store_path, store_text(7), false, true).ok
    and SECURE.write_text_new_exclusive(old_store_path, store_text(6), false, true).ok
    and SECURE.write_atomic(artifact_path,
        base64_decode_bytes("cGJsYW5nLWFydGlmYWN0LXYyLWZpeHR1cmU="), false, true).ok,
    "release-floor source fixtures could not be published");

let floor_file = floor_name("demo.pbck");
let floor_path = state + "/" + floor_file;
let floor_digest = SHA256.sha256_hex_bytes(str_to_bytes(store_text(7)));
let mismatch_floor = ADMISSION.prepare_with_expected_store_and_cooperative_floor(
    admission_request(store_path, artifact_path, 42), A, state, "missing");
require(not mismatch_floor.ok and not mismatch_floor.artifact_snapshot_opened
    and not fs_exists(floor_path), "store mismatch must not create a replay floor");
let first = ADMISSION.prepare_with_expected_store_and_cooperative_floor(
    admission_request(store_path, artifact_path, 42), floor_digest, state, "missing");
require(first.caller_expected_store_digest_matched, "floor composition preserves expected-store binding");
require(first.ok and first.artifact_snapshot_immutable
    and first.artifact_bytes_measured and first.signed_digest_matched
    and first.cooperative_floor_state == "recorded"
    and first.cooperative_floor_advanced_verified
    and first.cooperative_local_replay_floor_recorded
    and first.private_state_parent_verified
    and first.floor_durability_verified and first.floor_readback_verified
    and first.floor_lock_cleanup_verified
    and first.floor_state_root_cleanup_verified
    and first.bearer_handle_issued
    and not first.rollback_protection_enforced
    and not first.authorizes_execution and not first.production_ready,
    "floor transition must finish before the measured handle is published");
let public_initial = json_stringify(first);
require(not str_contains(public_initial, state)
    and not str_contains(public_initial, ARTIFACT_DIGEST)
    and not str_contains(public_initial, "42"),
    "release-floor evidence must expose no path, digest, or sequence");
require(ADMISSION.close(first.handle).ok,
    "initialized artifact handle cleanup failed");

let initial_bytes = SECURE.read_bytes(floor_path, ADMISSION.MAX_FLOOR_BYTES, true);
require(initial_bytes.ok, "initialized floor cannot be inspected in the test root");
require(not SECURE.read_bytes(state + "/"
    + legacy_floor_name_without_artifact_stream(),
    ADMISSION.MAX_FLOOR_BYTES, true).ok,
    "the floor scope must include the signed artifact stream identity");
for stale_sequence in [42, 41] {
    let rejected = prepared_with(store_path, artifact_path, stale_sequence,
        state, "present");
    require(not rejected.ok and rejected.handle == nil
        and rejected.artifact_snapshot_cleanup_verified
        and rejected.cooperative_floor_state == "rejected"
        and not rejected.cooperative_floor_advanced_verified
        and not rejected.rollback_protection_enforced
        and SECURE.read_bytes(floor_path, ADMISSION.MAX_FLOOR_BYTES, true).bytes
            == initial_bytes.bytes,
        "equal or lower signed release sequence must not mutate the floor");
}

let next = prepared_with(store_path, artifact_path, 43, state, "present");
require(next.ok and next.cooperative_floor_advanced_verified,
    "strictly increasing signed sequence must advance the cooperative floor");
require(ADMISSION.close(next.handle).ok,
    "advanced artifact handle cleanup failed");

let winner = prepared_with(store_path, artifact_path, 44, state, "present");
require(winner.ok, "the next signed sequence must produce one durable winner");
require(ADMISSION.close(winner.handle).ok,
    "winning floor-bound handle cleanup failed");
let duplicate = prepared_with(store_path, artifact_path, 44, state, "present");
require(not duplicate.ok and duplicate.handle == nil,
    "a second preparation at the recorded sequence must not issue a handle");

let reset = prepared_with(store_path, artifact_path, 42, alternate, "missing");
require(reset.ok and reset.cooperative_local_replay_floor_recorded
    and not reset.rollback_protection_enforced,
    "alternate caller-selected root demonstrates cooperative, not global, rollback protection");
require(ADMISSION.close(reset.handle).ok,
    "alternate-root artifact handle cleanup failed");

let generation_rejected = prepared_with(old_store_path, artifact_path, 45,
    state, "present");
require(not generation_rejected.ok
    and not generation_rejected.cooperative_floor_advanced_verified,
    "store generation rollback must be rejected without changing the floor");

let current_floor = SECURE.read_bytes(floor_path,
    ADMISSION.MAX_FLOOR_BYTES, true);
let mode_path = wrong_mode + "/" + floor_file;
require(SECURE.write_atomic(mode_path, current_floor.bytes, false, true).ok
    and proc_spawn_wait("/bin/chmod", ["0644", mode_path]).exit_code == 0,
    "wrong-mode floor fixture creation failed");
require(not prepared_with(store_path, artifact_path, 45,
    wrong_mode, "present").ok,
    "wrong-mode floor file must fail the held CAS policy");

let symlink_path = symlink_root + "/" + floor_file;
require(proc_spawn_wait("/bin/ln", ["-s", floor_path, symlink_path]).exit_code == 0,
    "symlink floor fixture creation failed");
require(not prepared_with(store_path, artifact_path, 45,
    symlink_root, "present").ok,
    "symlink floor must be rejected without following it");

let hardlink_path = hardlink_root + "/" + floor_file;
require(proc_spawn_wait("/bin/ln", [floor_path, hardlink_path]).exit_code == 0,
    "hard-link floor fixture creation failed");
require(not prepared_with(store_path, artifact_path, 45,
    hardlink_root, "present").ok,
    "multi-link floor must be rejected by the held CAS policy");

let oversized_path = oversized_root + "/" + floor_file;
require(SECURE.write_text_new_exclusive(oversized_path,
    str_repeat("x", ADMISSION.MAX_FLOOR_BYTES + 1), false, true).ok,
    "oversized floor fixture creation failed");
require(not prepared_with(store_path, artifact_path, 45,
    oversized_root, "present").ok,
    "oversized floor state must fail before parsing or mutation");

let policy_path = policy_root + "/" + floor_file;
require(SECURE.write_text_new_exclusive(policy_path,
    floor_record(floor_file, KEY_ID, 4, 7, 41), false, true).ok
    and not prepared_with(store_path, artifact_path, 42,
        policy_root, "present").ok,
    "a lower signed policy revision must not advance a newer policy floor");

let other_key = "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff";
let key_path = key_root + "/" + floor_file;
require(SECURE.write_text_new_exclusive(key_path,
    floor_record(floor_file, other_key, 3, 7, 41), false, true).ok
    and not prepared_with(store_path, artifact_path, 42,
        key_root, "present").ok,
    "a key change at the same policy revision must fail closed");

let canonical_path = canonical_root + "/" + floor_file;
require(SECURE.write_text_new_exclusive(canonical_path,
    floor_record(floor_file, KEY_ID, 3, 7, 41, true), false, true).ok
    and not prepared_with(store_path, artifact_path, 42,
        canonical_root, "present").ok,
    "extra fields must invalidate the exact canonical floor schema");

let existing_path = existing_root + "/" + floor_file;
require(SECURE.write_atomic(existing_path, current_floor.bytes, false, true).ok,
    "existing floor fixture creation failed");
let existing_before = SECURE.read_bytes(existing_path,
    ADMISSION.MAX_FLOOR_BYTES, true);
let missing_rejected = prepared_with(store_path, artifact_path, 45,
    existing_root, "missing");
require(not missing_rejected.ok and missing_rejected.handle == nil
    and SECURE.read_bytes(existing_path, ADMISSION.MAX_FLOOR_BYTES, true).bytes
        == existing_before.bytes,
    "a missing expectation must never replace an existing floor");

let accepted_claim = ADMISSION.cooperative_floor_result_policy(map{
    ok:true, published:true, effect_completed:true, retry_safe:false,
    cooperative_only:true, private_parent_verified:true,
    digest_algorithm:SECURE.RAW_SHA256_ALGORITHM,
    readback_verified:true, durability_verified:true,
    lock_released:true, root_closed:true, evidence_indeterminate:false});
let partial_claim = ADMISSION.cooperative_floor_result_policy(map{
    ok:false, published:true, effect_completed:false, retry_safe:false,
    cooperative_only:true, private_parent_verified:true,
    digest_algorithm:SECURE.RAW_SHA256_ALGORITHM,
    readback_verified:false, durability_verified:false,
    lock_released:true, root_closed:true, evidence_indeterminate:false});
let clean_rejection = ADMISSION.cooperative_floor_result_policy(map{
    ok:false, published:false, effect_completed:false, retry_safe:true,
    readback_verified:false, evidence_indeterminate:false});
require(accepted_claim.accepted and not accepted_claim.evidence_indeterminate
    and not accepted_claim.authorizes_external_effect
    and not partial_claim.accepted and partial_claim.evidence_indeterminate
    and not clean_rejection.accepted
    and not clean_rejection.evidence_indeterminate,
    "fault classification must distinguish clean rejection from possible publication");

let status = ADMISSION.status();
require(status.cooperative_floor_supported == status.available
    and status.cooperative_floor_recorded_admissions == 0
    and not status.same_vm_handle_only
    and not status.same_vm_handle_scope_verified
    and not status.rollback_enforcement_supported
    and not status.publisher_authenticity_complete
    and not status.production_ready,
    "status must preserve the cooperative floor's production boundary");

let symlink_removed = proc_spawn_wait("/bin/rm", [symlink_path]);
require(symlink_removed.exit_code == 0, "symlink floor cleanup failed");
remove_root(hardlink_root, [floor_file, floor_file + ".lock"]);
remove_root(wrong_mode, [floor_file, floor_file + ".lock"]);
remove_root(oversized_root, [floor_file, floor_file + ".lock"]);
remove_root(symlink_root, [floor_file + ".lock"]);
remove_root(policy_root, [floor_file, floor_file + ".lock"]);
remove_root(key_root, [floor_file, floor_file + ".lock"]);
remove_root(canonical_root, [floor_file, floor_file + ".lock"]);
remove_root(existing_root, [floor_file, floor_file + ".lock"]);
remove_root(alternate, [floor_file, floor_file + ".lock"]);
remove_root(state, [floor_file, floor_file + ".lock"]);
remove_root(fixture, ["trusted.json", "old-trusted.json", "demo.pbck"]);

print "publisher release floor tests passed";
