// tests/semantics/selfhost_bundle_test.sapp
//
// The pure-pblang LINKER: stdlib/selfhost_bundle.sapp links a program + its
// imported modules into ONE self-hosted chunk with no remaining import() calls,
// stdlib/selfhost_to_pbck.sapp translates it to a Rust .pbck, and the native VM
// runs the self-contained result — no dependency resolved or recompiled at load.

let bun = import("stdlib/selfhost_bundle.sapp");
let xl  = import("stdlib/selfhost_to_pbck.sapp");

fn fail(m) { throw "FAIL " + m; }

// Write `mods` (path -> source) to disk, bundle `main`, run the .pbck, expect out.
fn run_bundle(main, mods, expected) {
    let mk = map_keys(mods);
    let i = 0;
    while i < len(mk) { fs_write_bytes(mk[i], str_to_bytes(mods[mk[i]])); i = i + 1; }
    fn resolve(p) { return bytes_to_str(fs_read_bytes(p)); }
    let b = bun.bundle(main, resolve);
    if not b.ok { fail("bundle rejected: " + b.reason + " for: " + main); }
    let path = "/tmp/bndl_" + str(num_floor(now_ms())) + "_" + str(len(main)) + ".pbck";
    fs_write_bytes(path, xl.translate(b.chunk));
    let res = proc_spawn_wait("pblang", ["run", path, "--allow-all"]);
    let got = str_trim(res.stdout);
    if got != expected { fail("expected '" + expected + "' got '" + got + "' (err: " + str_trim(res.stderr) + ") for: " + main); }
}

fn expect_reject(main, mods) {
    fn resolve(p) { return try mods[p] catch nil; }
    let b = bun.bundle(main, resolve);
    if b.ok { fail("expected rejection but bundled: " + main); }
}

// --- single module: functions + a constant, accessed via the import map ---
run_bundle(
    "let geo = import(\"/tmp/bun_geo.sapp\"); print geo.area(3, 4) + geo.perimeter(3, 4) + geo.SCALE;",
    map{ "/tmp/bun_geo.sapp": "fn area(w,h){return w*h;} fn perimeter(w,h){return 2*(w+h);} let SCALE=10; export area, perimeter, SCALE;" },
    "36");   // 12 + 14 + 10

// --- module with a loop + recursion, called from main ---
run_bundle(
    "let m = import(\"/tmp/bun_math.sapp\"); print m.sumto(5) + m.fib(10);",
    map{ "/tmp/bun_math.sapp": "fn sumto(n){let s=0; for i in [1,2,3,4,5]{s=s+i;} return s;} fn fib(n){if n < 2 {return n;} return fib(n - 1) + fib(n - 2);} export sumto, fib;" },
    "70");   // 15 + 55

// --- module returning a closure (upvalue capture survives bundling) ---
run_bundle(
    "let f = import(\"/tmp/bun_clo.sapp\"); let add5 = f.adder(5); print add5(100);",
    map{ "/tmp/bun_clo.sapp": "fn adder(n){return fn(x){return x+n;};} export adder;" },
    "105");

// --- two modules, no collisions ---
run_bundle(
    "let a = import(\"/tmp/bun_a.sapp\"); let b = import(\"/tmp/bun_b.sapp\"); print a.twice(7) + b.thrice(7);",
    map{ "/tmp/bun_a.sapp": "fn twice(x){return x*2;} export twice;",
         "/tmp/bun_b.sapp": "fn thrice(x){return x*3;} export thrice;" },
    "35");   // 14 + 21

// --- a program with no imports passes straight through ---
run_bundle("print 6 * 7;", map{}, "42");

// --- TRANSITIVE imports: A imports B imports C, all bundled deps-first ---
run_bundle(
    "let a = import(\"/tmp/bun_ta.sapp\"); print a.top(5);",
    map{ "/tmp/bun_ta.sapp": "let b = import(\"/tmp/bun_tb.sapp\"); fn top(x){return b.mid(x) + 100;} export top;",
         "/tmp/bun_tb.sapp": "let c = import(\"/tmp/bun_tc.sapp\"); fn mid(x){return c.base(x) * 2;} export mid;",
         "/tmp/bun_tc.sapp": "fn base(x){return x + 1;} export base;" },
    "112");   // (5+1)*2 + 100

// --- safety: unsupported/aliasing programs are REJECTED (caller falls back to
//     runtime import), never silently mis-linked ---
expect_reject("let a=import(\"x\"); let b=import(\"y\"); print 1;",
    map{ "x": "fn helper(){return 1;} export helper;", "y": "fn helper(){return 2;} export helper;" });   // name collision
expect_reject("let a=import(\"x\"); print 1;", map{ "x": "fn len(z){return 0;} export len;" });            // builtin shadow
expect_reject("let a=import(\"x\"); print 1;", map{ "x": "let q=import(\"z\"); fn f(){return 1;} export f;" }); // nested import
expect_reject("let a=import(\"missing\"); print 1;", map{});                                                  // unresolvable
expect_reject("let a=import(\"x\"); print 1;",
    map{ "x": "let b=import(\"y\"); fn fa(){return 1;} export fa;", "y": "let a=import(\"x\"); fn fb(){return 2;} export fb;" }); // import cycle
expect_reject("fn load() { return import(\"x\"); } print 1;", map{ "x": "fn f(){return 1;} export f;" }); // import inside a function (main)
expect_reject("let m=import(\"x\"); print 1;",
    map{ "x": "fn f(){ let z = import(\"y\"); return z; } export f;", "y": "fn g(){return 2;} export g;" }); // import inside a function (module)

// --- end-to-end fs API: write_bundle reads main + deps from disk, writes .pbck ---
fs_write_bytes("/tmp/bun_wblib.sapp", str_to_bytes("fn sq(x){return x * x;} export sq;"));
fs_write_bytes("/tmp/bun_wbmain.sapp", str_to_bytes("let m = import(\"/tmp/bun_wblib.sapp\"); print m.sq(9);"));
let wbr = bun.write_bundle("/tmp/bun_wbmain.sapp", "/tmp/bun_wbout.pbck");
if not wbr.ok { fail("write_bundle: " + wbr.reason); }
if wbr.modules != 1 { fail("write_bundle module count"); }
let wbres = proc_spawn_wait("pblang", ["run", "/tmp/bun_wbout.pbck", "--allow-all"]);
if str_trim(wbres.stdout) != "81" { fail("write_bundle output: got '" + str_trim(wbres.stdout) + "'"); }

print "selfhost_bundle_pass";
