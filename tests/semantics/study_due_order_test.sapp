let S=import("stdlib:study_cards.sapp"); let D=import("stdlib:civil_date.sapp");
let pairs=[]; for i in range(0,64) {array_push(pairs,map{prompt:"Q"+str(i),answer:"A"});}
let deck=S.create("Ordering",pairs,"2026-09-27");
for i in range(0,64) {deck.cards[i].due=D.from_ordinal(730000+num_floor((63-i)/2));}
let before=S.encode(deck); let sorted=S.due(deck,"2026-09-27");
assert(len(sorted)==64 and sorted[0].id==63 and sorted[1].id==64 and sorted[62].id==1 and sorted[63].id==2,"ascending dates and stable equal-date ties at maximum size");
assert(S.due(deck,"0001-01-01")==[],"no due cards"); sorted[0].answer="changed";
assert(S.encode(deck)==before,"result detached and original unchanged");
print "study_due_order_pass";
