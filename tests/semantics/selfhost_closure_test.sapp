// Source closures use shared cells after codegen finalization. VM raw upvalue
// arrays keep their old value semantics; generated code reads/writes cell[0].
// Siblings, owners and transitive captures share the same cell. Each declaration
// in a loop gets a fresh cell. See selfhost_shared_capture_test.sapp for parity.

let fe = import("stdlib/compiler/selfhost_frontend.sapp");

// --- Basic capture of an enclosing parameter ---
let r1 = fe.frontend_run("fn outer(x) { let f = fn() { return x; }; return f(); } let r = outer(5);");
assert(r1.ok == true, "self-hosted closure program compiles+runs");
assert(r1.globals["r"] == 5, "self-hosted: inner closure captures enclosing param x");

// --- Capture of multiple params ---
let r2 = fe.frontend_run("fn outer(a, b) { let g = fn() { return a + b; }; return g(); } let v = outer(10, 20);");
assert(r2.globals["v"] == 30, "self-hosted: closure captures two params");

// --- Returned closure (currying) keeps its captured value ---
let r3 = fe.frontend_run("fn adder(n) { return fn(x) { return x + n; }; } let add5 = adder(5); let result = add5(100);");
assert(r3.globals["result"] == 105, "self-hosted: returned closure retains captured n");

// --- Transitive (multi-level) capture through intermediate closures ---
let r4 = fe.frontend_run("let nested = fn(a) { return fn(b) { return fn(c) { return a + b + c; }; }; }; let deep = nested(1)(2)(3);");
assert(r4.globals["deep"] == 6, "self-hosted: 3-level transitive upvalue capture (a+b+c)");

// --- Closure used as a higher-order map (functional style) ---
let src5 = "fn mapper(f, arr) { let out = []; for x in arr { array_push(out, f(x)); } return out; } "
    + "fn scaler(k) { return fn(x) { return x * k; }; } "
    + "let doubled = mapper(scaler(2), [1, 2, 3]); "
    + "let s = doubled[0] + doubled[1] + doubled[2];";   // 2+4+6 = 12
let r5 = fe.frontend_run(src5);
assert(r5.globals["s"] == 12, "self-hosted: closure passed to a higher-order function");

// --- Capturing async fn now EXECUTES (the §57 blocker, now unblocked) ---
let src6 = "fn spawn(f) { return f(); } fn join(x) { return x; } "
    + "async fn add(a, b) { return a + b; } "
    + "let ar = await add(10, 20);";
let r6 = fe.frontend_run(src6);
assert(r6.globals["ar"] == 30, "self-hosted: capturing async fn executes (a,b captured)");

// --- Within-closure mutation of a captured var persists across calls ---
let src7 = "fn make_counter(start) { let n = start; return fn() { n = n + 1; return n; }; } "
    + "let cnt = make_counter(10); let a = cnt(); let b = cnt(); let c = cnt();";
let r7 = fe.frontend_run(src7);
assert(r7.globals["a"] == 11, "self-hosted: counter first call");
assert(r7.globals["b"] == 12, "self-hosted: closure mutation persists across calls");
assert(r7.globals["c"] == 13, "self-hosted: counter third call");

// --- Regression: classes/methods/recursion/struct still work alongside closures ---
let src8 = "class Box { fn init(self, v) { self.v = v; } fn get(self) { return self.v; } } "
    + "let bx = Box:new(99); let bv = bx:get(); "
    + "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } let fb = fib(10);";
let r8 = fe.frontend_run(src8);
assert(r8.globals["bv"] == 99, "self-hosted: class methods unaffected by upvalue change");
assert(r8.globals["fb"] == 55, "self-hosted: recursion unaffected (fib(10)=55)");

print "selfhost_closure_pass";
