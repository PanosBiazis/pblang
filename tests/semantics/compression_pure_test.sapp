// tests/semantics/compression_pure_test.sapp — gzip works with ZERO external
// binaries: compression.sapp and codec.sapp fall back to the pure-pblang
// stdlib:flate.sapp codec, and set_pure(true) forces that path deterministically.

let C = import("stdlib:compression.sapp");
let K = import("stdlib:codec.sapp");
let F = import("stdlib:flate.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let msg = "";
let i = 0;
while i < 25 { msg = msg + "pure fallback line " + str(i) + " with some repetition repetition\n"; i = i + 1; }

// ── compression.sapp: forced pure path ───────────────────────────────────────
C.set_pure(true);
let blob = C.gzip_compress(msg);
eq(blob[0], 31, "pure gzip magic 1");
eq(blob[1], 139, "pure gzip magic 2");
eq(bytes_to_str(C.gzip_decompress(blob)), msg, "pure round trip via compression.sapp");
// pure output is standard gzip: flate must decode it, and vice versa
eq(bytes_to_str(F.gzip_decode(blob)), msg, "pure blob is standard gzip");
eq(bytes_to_str(C.gzip_decompress(F.gzip_encode(str_to_bytes(msg)))), msg,
   "compression decodes flate-encoded gzip");
// auto_decompress recognizes gzip in pure mode too
eq(bytes_to_str(C.auto_decompress(blob)), msg, "auto_decompress pure gzip");
C.set_pure(false);

// gzip is always available now (binary or pure fallback)
let av = C.available();
if av.gzip != true { fail("gzip must always be available via pure fallback"); }

// binary path (when gzip is installed) still interops with pure decode
let blob2 = C.gzip_compress(msg);
eq(bytes_to_str(F.gzip_decode(blob2)), msg, "binary/pure interop decode");

// ── codec.sapp: gzip backend never falls back to pbz anymore ─────────────────
K.set_pure(true);
let kb = K.compress(str_to_bytes(msg), "gzip");
eq(K.backend_name(kb), "gzip", "codec pure gzip keeps gzip tag");
eq(K.decompress_str(kb), msg, "codec pure gzip round trip");
K.set_pure(false);
eq(K.decompress_str(kb), msg, "pure-made blob decodable in normal mode");
let av2 = K.available();
if av2.gzip != true { fail("codec gzip must always be available"); }

print "compression_pure_pass";
