let M = import("stdlib:memory.sapp");
fn require(ok, why) { if not ok { throw "FAIL memory_tracker: " + why; } }
let before = M.stats().total_locations;
let tracker = M.MemoryTracker();
let a = tracker.alloc(tracker, 12);
let b = tracker.alloc_immutable(tracker, 34);
require(tracker.handles == [a, b], "both allocation methods record handles");
require(tracker.get(tracker, a) == 12 and tracker.get(tracker, b) == 34, "values readable");
tracker.set(tracker, a, 56);
require((try tracker.set(tracker, b, 78) catch "immutable") == "immutable", "immutable allocation enforced");
let borrow = tracker.borrow(tracker, a);
require((try tracker.free(tracker, a) catch "borrowed") == "borrowed", "active borrow prevents free");
tracker.release(tracker, borrow);
tracker.free(tracker, a);
tracker.free(tracker, b);
require(M.stats().total_locations == before, "explicit tracker cleanup restores count");
print "memory_tracker_pass";
