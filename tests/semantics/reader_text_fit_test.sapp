let Fit=import("../../examples/declarative_browser/text_fit.sapp");let P=import("../../examples/declarative_browser/pagination.sapp");let App=import("../../examples/declarative_browser/app.sapp");
let D=import("stdlib:browser_document.sapp");let V=import("stdlib:browser_view.sapp");let Flow=import("stdlib:text_flow.sapp");let GUI=import("stdlib:gui.sapp");let UI=import("stdlib:modern_ui.sapp");let Type=import("stdlib:ui_typography.sapp");
let checks=0;fn check(value,label) {assert(value,label);checks=checks+1;}
fn wide(text,size,family) {return map{ok:true,width:len(text)*size,height:size};}
let options=map{font_size:30,line_height:1.5,font_family:"sans"};let text="WWWWWWWWWW Ελληνικό κείμενο με τόνους. "+str_repeat("Πλατιά γράμματα W. ",6);
let ordinary=Flow.layout(text,296,options);let refined=Fit.lines(text,296,options,false,wide);
check(not refined.truncated and len(refined.lines)>len(ordinary.lines),"wide measured glyphs create extra lines");
check(str_replace_all(str_join(refined.lines,"")," ","")==str_replace_all(text," ",""),"all Greek and wide characters preserved");
for line in refined.lines {check(wide(line,30,"sans").width<=296,"each measured line fits");}
check(Fit.lines(text,296,options)==ordinary,"omitted measurement preserves legacy flow");
check(Fit.lines(text,296,options,false,fn(t,s,f){throw "unavailable";})==ordinary,"unavailable measurement preserves fallback");
check(Fit.lines(text,296,options,false,fn(t,s,f){return map{ok:true,width:9999,height:999};})==ordinary,"too-tall host font follows bitmap path");
let grouped="άάάά";let groups=Fit.lines(grouped,60,options,false,wide);
for line in groups.lines {check(line=="ά","combining groups not split");}
check(Fit.lines("W",20,options,false,wide).truncated,"unfittable cluster is explicit");
let link_view=UI.screen([UI.button("WWWWWWWWW",nil,map{name:"block0",font_size:40,line_height:1,h:56})],map{padding:24,gap:0});
check(not P.needs(link_view,390,844),"baseline link approximation fits");
check(P.needs(link_view,390,844,fn(t,s,f){return map{ok:true,width:len(t)*s,height:s+8};}),"button measurement uses its actual centered-label height");
let blocks=[map{tag:"p",text:text},map{tag:"p",text:str_repeat("WWWWWW ",28)},map{tag:"a",text:"Ο τελευταίος τοπικός σύνδεσμος",href:"pb://about"}];
let doc=D.create("WWWWWWWW — Οδηγός",blocks);let original=D.export_html(doc);let style=V.appearance(map{body_size:30,title_size:40,font_scale:1.5,line_height:2.5,font_family:"serif"});
for size in [map{w:320,h:240},map{w:320,h:480},map{w:640,h:720}] {
    let plan=P.plan(doc,style,size.w,size.h,wide);let covered=map{};
    for page in plan.pages {for row in page {if row.kind=="text" {covered[str(row.block)]=(try covered[str(row.block)] catch "")+str_replace_all(row.text," ","");}}}
    check(covered["-1"]==str_replace_all(P.normalized(D.inspect(doc).title)," ",""),"complete measured title");
    for i len(blocks) {check(covered[str(i)]==str_replace_all(P.normalized(blocks[i].text)," ",""),"whole document coverage across measured pages");}
    let count=if plan.available {len(plan.pages)}else{1};
    for page count {
        let view=P.view(plan,page,style,UI.row([UI.button("Style",nil,map{h:40,font_size:14})],map{h:40,padding:0}),nil,nil);
        view=Type.apply(view,map{font_family:style.font_family,line_height:style.line_height,text_spacing:"natural"});
        let bundle=UI.compile(view,map{width:size.w,height:size.h});
        for r in bundle.records {check(r.y+r.h<=size.h,"projected rows stay inside viewport");
            if r.kind=="text" or r.kind=="heading" {let m=Flow.metrics(r.source);let layout=Flow.layout(r.source.text,r.w,r.source,false,num_floor(r.h/m.line_height));check(not layout.truncated,"actual height budget never clips help, footer or document rows");}
        }
    }
}
check(D.export_html(doc)==original,"canonical document unchanged");
let c=App.create();let old=c.text_measure;check((try App.set_text_measure(c,42) catch nil)==nil and c.text_measure==old,"invalid adapter leaves controller intact");App.set_text_measure(c,wide);App.refresh(c);check(c.text_measure!=nil,"measurement opt-in accepted");App.set_text_measure(c);App.refresh(c);check(c.text_measure==nil,"measurement opt-out restores legacy path");c.session.close();
print "reader_text_fit_pass checks="+str(checks);
