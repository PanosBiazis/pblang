// Test: pbAI's GENERATIVE model — a char-level neural LM (stdlib/pbai_lm.sapp), §87.
//
// Runs in the VM (pure pblang on manual backprop + the tensor_argmax kernel). A tiny,
// fast configuration: it must (a) LEARN — cross-entropy falls after training — and
// (b) GENERATE valid in-vocabulary text autoregressively. (The richer demo in the docs
// trains longer and reproduces pblang syntax like `fn main() { let r; }`.)

let lm = import("stdlib/pbai_lm.sapp");

let corpus = "let x; let y; let z; let w; ";
let v = lm.vocab_build(corpus);
let ids = lm.encode(v, corpus);

// round-trip: encode keeps every character (all chars are in the vocab)
assert(len(ids) == len(corpus), "encode preserves length (vocab covers the corpus)");
assert(v.size > 3 and v.size < 20, "a small character vocabulary was built");

let m = lm.model_new(v.size, 4, 8, 2, 1);
let loss0 = lm.avg_loss(m, ids);
lm.train(m, ids, 25, 0.2);
let lossT = lm.avg_loss(m, ids);

// (a) it LEARNS — manual backprop reduces the loss
assert(lossT < loss0, "training reduces cross-entropy loss (the model learns)");

// (b) it GENERATES valid in-vocabulary text via the tensor_argmax inference path
let out = lm.generate(m, v, "let", 8);
assert(len(out) == 3 + 8, "generate appends exactly n characters to the seed");
assert(len(lm.encode(v, out)) == len(out), "every generated character is in the vocabulary");

// next_id uses the native tensor_argmax kernel and returns a valid token id
let nid = lm.next_id(m, [v.ch2id[str(strcharcodeat("l", 0))], v.ch2id[str(strcharcodeat("e", 0))]]);
assert(nid >= 0 and nid < v.size, "next_id (tensor_argmax kernel) returns a valid token id");

print "pbai_lm_pass";
