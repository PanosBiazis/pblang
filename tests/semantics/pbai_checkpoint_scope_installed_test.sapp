// Actual scoped file owner and both facades, copied away from source and caller decoys.
if platform()!="linux" {print "pbai_checkpoint_scope_skip_linux_required";os_exit(0);}
let U=import("stdlib:uuid.sapp");let parent=path_dirname(cwd());
let exe=env_get("PBLANG_BIN");assert(type(exe)=="string" and exe!="","set trusted PBLANG_BIN");
let phase=env_get("PBAI_SCOPE_PHASE");
assert(phase=="baseline" or phase=="real" or phase=="faults" or phase=="errors" or phase=="unavailable-scope" or phase=="unavailable-resource","bounded scope test phase required");
let root=path_join("/tmp","pbai-checkpoint-scope-installed-"+U.v4());let caller=path_join(root,"caller");
let step=["setup"];let completed=[0];
fn process(command,args){let argv=["-k","1s","12s",command];for arg in args {push(argv,arg);}return proc_spawn_wait("/usr/bin/timeout",argv);}
fn must(command,args){let value=process(command,args);assert(value.exit_code==0,"scope fixture operation");return value;}
fn build(at){let value=must("/usr/bin/env",["-C",at,exe,"build"]);assert(str_contains(value.stdout,"build ok"),"scope fixture build");}
fn hidden(at,mode,file="case.sapp"){
 let args=["--die-with-parent","--unshare-net","--ro-bind","/","/","--dev","/dev","--bind",root,root,
  "--tmpfs",path_join(parent,"pblang"),"--tmpfs",path_join(parent,"pbai")];
 let extra=env_get("PBAI_SOURCE_HIDE_ROOT");if type(extra)=="string" and extra!="" {push(args,"--tmpfs");push(args,extra);}
 for value in ["--setenv","PBAI_STATE_ROOT",path_join(root,"state"),"--setenv","PBAI_SCOPE_PHASE",mode,
  "--setenv","PBAI_CHECKPOINT_TEST_DIR",path_join(at,"private"),"--setenv","PBAI_CHECKPOINT_TEST_PHASE",mode,
  "--setenv","PBAI_CHECKPOINT_SCOPE_PHASE",mode,"--chdir",caller,exe,"run",path_join(at,file),
  "--allow-all","--deny-net","--deny-http","--deny-sqlite"] {push(args,value);}
 if phase=="faults" or str_starts_with(phase,"unavailable-") {for value in ["--deny-exec","--deny-spawn","--deny-ffi"] {push(args,value);}}
 return process("/usr/bin/bwrap",args);
}
fn exercise(){
 fs_mkdirs(root);must("/bin/chmod",["700",root]);fs_mkdirs(caller);fs_mkdirs(path_join(root,"state"));fs_mkdirs(path_join(caller,"stdlib"));
 for name in ["pbai_checkpoint_scope.sapp","resource_scope.sapp","pbai_student_checkpoint_io.sapp","secure_file.sapp","pbai_neural_adapter.sapp","pbai_specialist_binding.sapp","serialization.sapp","json.sapp"] {
  fs_write(path_join(path_join(caller,"stdlib"),name),"print \"DECOY_EXECUTED\";throw \"caller decoy\";\n");
 }
 fs_write(path_join(caller,"main.sapp"),"print 0;\n");
 fs_write(path_join(caller,"pblang.toml"),"[package]\nname=\"scope-caller\"\nversion=\"0.1.0\"\nentry=\"main.sapp\"\n[dependencies]\nstdlib={path=\"stdlib\"}\n");build(caller);
 for repo in ["pblang","pbai"] {
  let source=path_join(parent,repo);let at=path_join(root,repo);fs_mkdirs(at);
  must("/bin/cp",["-R",path_join(source,"stdlib"),path_join(at,"stdlib")]);
  fs_write(path_join(at,"case.sapp"),fs_read(path_join(source,"tests/fixtures/pbai_checkpoint_scope.sapp")));
  fs_write(path_join(at,"optional.sapp"),"let AI=import(\"stdlib/pbai.sapp\");let IO=import(\"stdlib:pbai_student_checkpoint_io.sapp\");let binding=AI.neural_specialist_checkpoint_bind(IO);assert(binding.report().operations==[\"save_new\",\"load_file\"],\"old surface unchanged\");print \"scope_optional_pass\";\n");
  let examples=if repo=="pblang" {"examples"} else {"demo"};
  fs_write(path_join(at,"write.sapp"),fs_read(path_join(source,path_join(examples,"pbai_student_checkpoint_file.sapp"))));
  fs_write(path_join(at,"example.sapp"),fs_read(path_join(source,path_join(examples,"pbai_student_checkpoint_scope.sapp"))));
  fs_mkdirs(path_join(at,"private"));must("/bin/chmod",["700",path_join(at,"private")]);
  let dep=if repo=="pblang" {"stdlib"} else {"../pblang/stdlib"};
  fs_write(path_join(at,"pblang.toml"),"[package]\nname=\"scope-installed\"\nversion=\"0.1.0\"\nentry=\"case.sapp\"\n[dependencies]\nstdlib={path="+json_stringify(dep)+"}\n");
 }
 if phase=="faults" {fs_write(path_join(root,"pblang/stdlib/pbai_student_checkpoint_io.sapp"),fs_read(path_join(parent,"pblang/tests/fixtures/pbai_checkpoint_scope_io.sapp")));}
 let expected="";
 for repo in ["pblang","pbai"] {
  let at=path_join(root,repo);build(at);step[0]=phase+" "+repo;
  if str_starts_with(phase,"unavailable-") {
   let names=if phase=="unavailable-scope" {["pbai_checkpoint_scope.sapp"]} else {["resource_scope.sapp"]};
   for name in names {
    let dependency=path_join(root,"pblang/stdlib/"+name);let original=fs_read(dependency);
    for mode in ["missing","broken"] {
     step[0]=repo+" "+name+" "+mode;
     if mode=="missing" {fs_remove(dependency);}else {fs_write(dependency,"throw \"SELECTED_SCOPE_DEPENDENCY_BROKEN\";\n");}
     // Native package hash is regenerated for each deliberate fixture tree.
     build(path_join(root,"pblang"));build(path_join(root,"pbai"));
     let optional=hidden(at,"success","optional.sapp");
     if optional.exit_code!=0 {print str_replace_all(optional.stderr,root,"<fixture>");}
     assert(optional.exit_code==0 and optional.stdout=="scope_optional_pass\n","old binding does not require the opt-in scope dependency");
     let result=hidden(at,"success","example.sapp");
     assert(result.exit_code!=0 and not str_contains(result.stdout,"DECOY_EXECUTED")
      and str_contains(result.stderr,if mode=="missing" {"import not found"} else {"SELECTED_SCOPE_DEPENDENCY_BROKEN"})
      and not str_contains(result.stdout,"pbai.checkpoint-scope.example.v1"),"missing/broken selected dependency cannot use caller fallback");
     fs_write(dependency,original);
    }
   }
  } elif phase=="faults" {
   let result=hidden(at,phase);
   if result.exit_code!=0 {print result.stdout;print str_replace_all(result.stderr,root,"<fixture>");}
   assert(result.exit_code==0 and result.stdout=="pbai_checkpoint_scope_faults_pass:40\n","fault matrix exact result");
  } else {
   let wrote=hidden(at,"write","write.sapp");assert(wrote.exit_code==0 and json_parse(wrote.stdout).saved,"real checkpoint setup");
   let path=path_join(at,"private/student.json");let original=fs_read(path);
   if phase=="errors" {
    fs_write(path_join(at,"private/corrupt.json"),"{}");
    for mode in ["error-missing","error-corrupt"] {
     let result=hidden(at,mode);let message=if mode=="error-missing" {"checkpoint could not be read within private storage bounds"} else {"invalid student checkpoint"};
     assert(result.exit_code!=0 and str_contains(result.stderr,": "+message+"\n"),"load retains its primary error before callback");
     assert(not str_contains(result.stdout,"BODY_EXECUTED") and not str_contains(result.stdout,"DECOY_EXECUTED")
      and not str_contains(result.stderr,"UNEXPECTED_SCOPE_SUCCESS"),"failed acquisition never runs body or caller module");
    }
   } else {
    let result=hidden(at,phase);let marker=if phase=="baseline" {"pbai_checkpoint_scope_unscoped_gap:1"} else {"pbai_checkpoint_scope_real_pass:40"};
    if result.exit_code!=0 {print result.stdout;print str_replace_all(result.stderr,root,"<fixture>");}
    assert(result.exit_code==0 and result.stdout==marker+"\n","real scope matrix exact result");
    if phase=="real" {
     let output=[];
     for mode in ["success","throw"] {
      let demo=hidden(at,mode,"example.sapp");assert(demo.exit_code==0,"scoped example completes");let value=json_parse(demo.stdout);
      assert(value.ok==(mode=="success") and value.cleanup_ok and value.cleanups_attempted==1 and value.saved_prediction_blocked
       and not value.globally_activated and value.token==(if mode=="success" {5} else {nil}),"scoped example success/failure is explicit");push(output,demo.stdout);
     }
     let text=json_stringify(output);if expected!="" {assert(text==expected,"exact facade example parity");}expected=text;
    }
   }
   assert(fs_read(path)==original,"scope never rewrites or removes persisted checkpoint");
  }
  completed[0]=completed[0]+1;
 }
}
let passed=try {exercise();true} catch false;let removed=process("/bin/rm",["-rf","--",root]);
assert(passed,"checkpoint scope acceptance: "+step[0]);assert(removed.exit_code==0 and completed[0]==2,"owned scope fixture cleanup");
print "pbai_checkpoint_scope_"+phase+"_pass";
