let S = import("stdlib:data_store.sapp");

fn fail(message) { throw "FAIL " + message; }
fn eq(actual, expected, message) {
    if actual != expected { fail(message + " got=" + str(actual) + " want=" + str(expected)); }
}
fn require(value, message) { if not value { fail(message); } }

// Memory: bounded LRU, namespace isolation, TTL, nil and lazy values.
let mem = S.memory(map{ namespace: "session", max_entries: 2, max_units: 10000, policy: "lru" });
require(S.set(mem, "a", 1).ok, "memory set a");
require(S.set(mem, "b", nil).ok, "memory stores nil");
let nil_entry = S.get_entry(mem, "b");
require(nil_entry.found and nil_entry.value == nil, "memory distinguishes cached nil");
eq(S.get(mem, "a"), 1, "memory get refreshes LRU");
require(S.set(mem, "c", 3).ok, "memory set c");
eq(S.has(mem, "b"), false, "memory evicts least-recent entry");
eq(S.has(mem, "a"), true, "memory retains recent entry");
let calls = 0;
eq(S.get_or_set(mem, "a", fn() { calls = calls + 1; return 99; }), 1, "lazy hit");
eq(calls, 0, "lazy hit does not recompute");
require(S.set(mem, "short", "x", map{ ttl_ms: 1 }).ok, "memory ttl set");
sleep_ms(3);
eq(S.has(mem, "short"), false, "memory ttl expires");
eq(S.stats(mem).backend, "memory", "memory stats backend");
require(S.close(mem), "memory close");

// SQLite: identical value semantics, hard quota eviction, namespace isolation,
// durable reopen, touch, and corruption-safe envelopes.
let run_id = str_slice(sha256(str(now_ms()) + str(random_bytes(16))), 0, 24);
let db_path = "/tmp/pblang-data-store-test-" + run_id + ".db";
try fs_remove(db_path) catch nil;
let sql = S.sqlite(db_path, map{ namespace: "alpha", max_entries: 2, max_units: 100000 });
require(S.set(sql, "one", map{ n: 1 }).ok, "SQLite set one");
sleep_ms(2);
require(S.set(sql, "two", nil).ok, "SQLite stores nil");
eq(S.get(sql, "one").n, 1, "SQLite structured roundtrip");
sleep_ms(2);
require(S.set(sql, "three", [1, 2, 3]).ok, "SQLite set three");
eq(S.has(sql, "two"), false, "SQLite LRU quota evicts oldest untouched row");
eq(S.get_entry(sql, "three").value[2], 3, "SQLite array roundtrip");
require(S.touch(sql, "three", 1000), "SQLite touch existing");
eq(S.stats(sql).size, 2, "SQLite hard entry quota");
require(S.close(sql), "SQLite close");

let reopened = S.sqlite(db_path, map{ namespace: "alpha", max_entries: 2, max_units: 100000 });
eq(S.get(reopened, "one").n, 1, "SQLite persists across reopen");
let other = S.sqlite(db_path, map{ namespace: "beta", max_entries: 2, max_units: 100000 });
require(S.set(other, "one", "other").ok, "second namespace write");
eq(S.clear(reopened).removed, 2, "clear removes only selected namespace");
eq(S.get(other, "one"), "other", "namespace clear leaves peer namespace");
S.close(reopened); S.close(other);
try fs_remove(db_path) catch nil;

let too_small = S.memory(map{ namespace: "limits", max_entries: 2, max_units: 32, max_value_units: 16 });
eq(S.set(too_small, "large", "this value cannot fit").ok, false, "value size admission is atomic");
eq(S.stats(too_small).size, 0, "failed admission leaves store unchanged");
S.close(too_small);

eq((try { S.memory(map{ namespace: "../unsafe" }); false } catch true), true, "unsafe namespace rejected");
eq((try { let t = S.memory(); S.set(t, "", 1); false } catch true), true, "empty key rejected");

print "data_store_pass";
