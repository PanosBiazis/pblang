let source = bytes_to_str(fs_read_bytes("bench/x64_compile_pipeline_stages.sapp"));

fn need(value) {
    if not str_contains(source, value) {
        throw "x64 compile pipeline contract missing: " + value;
    }
}

for stage in ["process_startup", "backend_import", "in_process_emit",
              "full_uncached_publish", "cache_cold_publish", "cache_warm_publish"] {
    need(stage);
}
for metric in ["cold_backend_import_overhead", "uncached_non_emitter_overhead",
               "emitter_share", "warm_cache_speedup", "cold_cache_penalty"] {
    need("X64_COMPILE_DERIVED|" + metric);
}
need("X64_COMPILE_STAGE_SUITE|ok");
print "x64_compile_pipeline_contract_pass";
