let U = import("stdlib:unicode_encoding.sapp");
let E = import("stdlib:input_events.sapp");

fn eq(actual, expected, message) { if actual != expected { throw "FAIL " + message; } }

eq(U.decode([80,66,76,97,110,103], "utf-8").text, "PBLang", "ASCII subset of UTF-8");
eq(U.decode([206,177,240,159,152,128], "utf-8").text, "α😀", "UTF-8 Greek and supplementary scalar");
assert(not U.decode([192,128], "utf-8").ok, "overlong UTF-8 rejected");
assert(not U.decode([237,160,128], "utf-8").ok, "UTF-8 surrogate rejected");
assert(not U.decode([240,159,152], "utf-8").ok, "truncated UTF-8 rejected");

eq(U.decode([255,254,177,3,61,216,0,222], "utf-16").text, "α😀", "UTF-16LE BOM and pair");
eq(U.decode([3,177,216,61,222,0], "utf-16be").text, "α😀", "UTF-16BE explicit");
assert(not U.decode([0,216,65,0], "utf-16le").ok, "unpaired UTF-16 surrogate rejected");

eq(U.decode([255,254,0,0,177,3,0,0,0,246,1,0], "utf-32").text, "α😀", "UTF-32LE BOM");
assert(not U.decode([0,216,0,0], "utf-32le").ok, "UTF-32 surrogate rejected");

eq(U.decode([128,32,147,148,151], "windows-1252").text, "€ “”—", "Windows-1252 mapping");
eq(U.decode([163], "iso-8859-1").text, "£", "Latin-1 mapping");
assert(not U.decode([255], "ascii").ok, "non-ASCII byte rejected");
assert(not U.decode([129], "windows-1252").ok, "undefined CP1252 byte rejected");
eq(U.decode([128,192,223,224,255], "cp1251").text, "ЂАЯая", "Windows-1251 Cyrillic mapping");
assert(not U.decode([152], "windows-1251").ok, "undefined Windows-1251 byte rejected");
eq(U.decode([128,179,196,218,224,234,255], "cp437").text, "Ç│─┌αΩ\u00A0", "IBM CP437 DOS mapping");
eq(U.normalize_name("OEM437"), "ibm437", "historical encoding alias normalization");
assert(U.describe("cp437").supported and U.describe("cp437").strict,
       "encoding metadata advertises strict support");
eq(U.decode_auto([255,254,177,3]).text, "α", "BOM auto-detects UTF-16LE");
eq(U.decode_auto([206,177]).text, "α", "no-BOM auto mode accepts strict UTF-8");
assert(not U.decode_auto([128]).ok, "auto mode never guesses a legacy encoding");
assert(not U.decode([65], "shift-jis").ok, "unknown legacy encoding rejected explicitly");

eq(U.encode("α😀", "utf-8").bytes, [206,177,240,159,152,128], "strict UTF-8 encoding");
eq(U.encode("α😀", "utf-16").bytes, [255,254,177,3,61,216,0,222], "UTF-16 BOM encoding");
eq(U.encode("α😀", "utf-16be").bytes, [3,177,216,61,222,0], "UTF-16BE encoding");
eq(U.encode("α😀", "utf-32").bytes, [255,254,0,0,177,3,0,0,0,246,1,0], "UTF-32 BOM encoding");
eq(U.encode("€ “”—", "windows-1252").bytes, [128,32,147,148,151], "Windows-1252 encoding");
eq(U.encode("ЂАЯая", "cp1251").bytes, [128,192,223,224,255], "Windows-1251 encoding");
eq(U.encode("Ç│─┌αΩ\u00A0", "cp437").bytes, [128,179,196,218,224,234,255], "IBM CP437 encoding");
assert(not U.encode("α", "ascii").ok, "unrepresentable ASCII scalar rejected");
assert(not U.encode("😀", "windows-1252").ok, "unrepresentable legacy scalar rejected");
for encoding in U.supported() {
    let sample = if encoding == "ascii" { "PBLang" } else { "PBLang £" };
    if encoding == "windows-1251" { sample = "PBLang Я"; }
    if encoding == "ibm437" { sample = "PBLang Ω"; }
    let encoded = U.encode(sample, encoding);
    assert(encoded.ok, "supported encoder must accept its representative sample: " + encoding);
    eq(U.decode(encoded.bytes, encoding).text, sample, "round trip " + encoding);
}

let event = E.type_encoded_event([206,177,240,159,152,128], "utf-8");
assert(event.ok and event.event.text == "α😀" and event.event.source_encoding == "utf-8",
       "encoded input becomes canonical Unicode event");

print "unicode_encoding_pass";
