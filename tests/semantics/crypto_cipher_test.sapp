// tests/semantics/crypto_cipher_test.sapp
// One-Time Pad + ChaCha20. ChaCha20 is checked against the RFC 8439 §2.4.2 known-answer
// vector (the real proof of correctness), plus round-trips for both ciphers.
let crypto = import("stdlib:crypto.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eqb(a, b) { if len(a) != len(b) { return false; } let i = 0; while i < len(a) { if a[i] != b[i] { return false; } i = i + 1; } return true; }

// ── One-Time Pad ──────────────────────────────────────────────────────────────
let msg = str_to_bytes("attack at dawn");
let zero = []; let i = 0; while i < len(msg) { array_push(zero, 0); i = i + 1; }
if not eqb(crypto.otp_xor(msg, zero), msg) { fail("OTP with zero key is identity"); }
// key == plaintext => all-zero ciphertext
let selfc = crypto.otp_xor(msg, msg);
i = 0; while i < len(selfc) { if selfc[i] != 0 { fail("OTP key==plaintext should zero out"); } i = i + 1; }
// random key round-trip, and ciphertext != plaintext
let key = crypto.otp_keygen(len(msg));
let ct = crypto.otp_encrypt(msg, key);
if eqb(ct, msg) { fail("OTP ciphertext should differ from plaintext"); }
if not eqb(crypto.otp_decrypt(ct, key), msg) { fail("OTP round-trip"); }
// key too short -> error
let threw = false;
try { crypto.otp_xor(msg, [1, 2, 3]); } catch { threw = true; }
if not threw { fail("OTP must reject a too-short key"); }

// ── ChaCha20 RFC 8439 §2.4.2 known-answer vector ──────────────────────────────
let k = []; i = 0; while i < 32 { array_push(k, i); i = i + 1; }              // key = 00..1f
let nonce = [0, 0, 0, 0, 0, 0, 0, 74, 0, 0, 0, 0];                            // 00..004a0000 0000
let pt = str_to_bytes("Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.");
let cct = crypto.chacha20_xor(pt, k, nonce, 1);
let want = [110, 46, 53, 154, 37, 104, 249, 128, 65, 186, 7, 40, 221, 13, 105, 129];   // 6e2e359a 2568f980 41ba0728 dd0d6981
let w = 0;
while w < len(want) {
    if cct[w] != want[w] { fail("ChaCha20 KAT mismatch at byte " + str(w) + " (got " + str(cct[w]) + " want " + str(want[w]) + ")"); }
    w = w + 1;
}
if len(cct) != len(pt) { fail("ChaCha20 ciphertext length"); }

// ── ChaCha20 round-trip with random key/nonce ────────────────────────────────
let rk = crypto.keygen256();
let rn = crypto.nonce96();
let secret = str_to_bytes("the launch code is 0000 - keep it safe");
let enc = crypto.chacha20_encrypt(secret, rk, rn);
if eqb(enc, secret) { fail("ChaCha20 ciphertext should differ from plaintext"); }
if not eqb(crypto.chacha20_decrypt(enc, rk, rn), secret) { fail("ChaCha20 round-trip"); }
// a different nonce must NOT decrypt to the plaintext
let rn2 = crypto.nonce96();
if eqb(crypto.chacha20_decrypt(enc, rk, rn2), secret) { fail("wrong nonce should not recover plaintext"); }

print "crypto_cipher_pass";
