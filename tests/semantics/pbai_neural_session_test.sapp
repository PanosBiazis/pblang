let N=import("stdlib:pbai_neural_adapter.sapp");
fn rejects(f) {return try {f();false} catch true;}
assert(not rejects(fn(){return 1;}) and rejects(fn(){throw "expected rejection";}),"rejection helper distinguishes success from failure");
fn equal(a,b) { return json_stringify(a)==json_stringify(b); }
let train=[];let valid=[];let test=[];
for i 4 {push(train,map{x:[i],y:i+4});push(valid,map{x:[7,i],y:i+4});push(test,map{x:[6,i],y:i+4});}
let session=N.session(train,valid);
let baseline=session.predict([0]);let initial=session.status();
assert(initial.phase=="candidate" and initial.revision==0 and not initial.session_adapter_active,"starts on baseline");
assert(rejects(fn(){session.promote();}) and rejects(fn(){session.rollback();}),"cannot skip evaluation");
assert(rejects(fn(){session.evaluate(train);}) and rejects(fn(){session.evaluate(valid);}),"train and validation input overlap rejected");
assert(rejects(fn(){session.evaluate([]);}) and rejects(fn(){session.evaluate([test[0],test[0]]);}),"invalid test shape rejected");
assert(session.status().revision==0,"malformed attempts do not evaluate");
let report=session.evaluate(test);
assert(report.passed and report.baseline_correct_regressions==0 and report.candidate.loss<report.baseline.loss,"candidate measured on disjoint inputs");
assert(not report.independent_provenance_verified and not report.authorizes_activation,"metrics are not provenance or authority");
assert(equal(baseline,session.predict([0]))==false,"prediction includes changed lifecycle revision");
assert(equal(baseline.logits,session.predict([0]).logits),"evaluation alone does not switch active weights");
report.passed=false;report.candidate.loss=999;initial.phase="promoted";
let promoted=session.promote();
assert(promoted.phase=="promoted" and promoted.revision==2 and promoted.session_adapter_active,"private decision survives report mutation");
let learned=session.predict([0]);assert(not equal(learned.logits,baseline.logits),"promotion changes actual inference");
assert(rejects(fn(){session.evaluate(test);}) and rejects(fn(){session.promote();}),"no repeated evaluation or promotion");
let rollback=session.rollback();let restored=session.predict([0]);
assert(rollback.phase=="rolled-back" and rollback.revision==3 and not rollback.session_adapter_active,"rollback terminal");
assert(equal(restored.logits,baseline.logits) and restored.artifact_digest==baseline.artifact_digest,"rollback exact weight and prediction parity");
assert(rejects(fn(){session.promote();}) and rejects(fn(){session.rollback();}),"rollback cannot replay promotion");
// Rejection cannot be turned into promotion by editing the public report.
let rejected=N.session(train,valid);let wrong=[];
for i 4 {let ids=[6,i];push(wrong,map{x:ids,y:rejected.predict(ids).token});}
let failed=rejected.evaluate(wrong);
assert(not failed.passed and failed.baseline_correct_regressions>0,"baseline-correct test regressions fail closed");
failed.passed=true;failed.candidate.accuracy=1;
assert(rejects(fn(){rejected.promote();}) and rejects(fn(){rejected.evaluate(test);}),"forged report and retest cannot revive rejected session");
// Better aggregate accuracy/loss still cannot hide a formerly correct test answer.
let swapped=N.session(train,valid);let mixed=[];
for i 4 {push(mixed,map{x:[6,i],y:if i==0 {swapped.predict([6,i]).token} else {i+4}});}
let mix=swapped.evaluate(mixed);
assert(mix.training_gate_passed and mix.candidate.accuracy>mix.baseline.accuracy
    and mix.candidate.loss<mix.baseline.loss,"mixed fixture improves aggregate quality");
assert(mix.baseline_correct_regressions==1 and not mix.passed and rejects(fn(){swapped.promote();}),"per-example regression overrides aggregate improvement");
assert(report.training_correct_regressions==0 and report.validation_correct_regressions==0,"all split retention measured");
// Validation regressions also veto promotion even when aggregate metrics improve.
let altered_valid=json_parse(json_stringify(valid));altered_valid[0].y=session.predict(valid[0].x).token;
let validation_run=N.train(train,altered_valid);
assert(validation_run.validation_after.accuracy>validation_run.validation_before.accuracy
    and validation_run.validation_after.loss<validation_run.validation_before.loss,"validation fixture passes aggregate checks");
let retained=N.session(train,altered_valid);let retention=retained.evaluate(test);
assert(retention.validation_correct_regressions==1 and retention.training_correct_regressions==0
    and retention.baseline_correct_regressions==0 and not retention.training_gate_passed
    and not retention.passed and rejects(fn(){retained.promote();}),"validation answer retention prevents misleading promotion");
// Returned results and original caller data cannot rewrite private lifecycle state.
let private=N.session(train,valid);let saved=private.predict([0]);train[0].x[0]=2;valid[0].x[0]=1;
assert(rejects(fn(){private.evaluate([map{x:[0],y:4}]);}),"original training identity retained after caller mutation");
saved.logits[0]=999;
assert(private.predict([0]).logits[0]!=999,"prediction arrays detached");
let zero=len([]);
for bad in [nil,[],[map{x:[0/zero],y:0}],[map{x:[1],y:1/zero}],[map{x:[8],y:0}]] {
    assert(rejects(fn(){private.evaluate(bad);}),"malformed and nonfinite test input rejected");
}
assert(private.status().revision==0 and session.status().revision==3,"sessions isolated");
assert(not str_contains(json_stringify(private.status()),"logits") and not map_has(private.status(),"candidate"),"status exposes no weights or training examples");

let signed_zero=0/(0-1);
assert(rejects(fn(){private.evaluate([map{x:[signed_zero],y:4}]);}),"signed-zero original training identity");
assert(rejects(fn(){private.evaluate([map{x:[7,signed_zero],y:4}]);}),"signed-zero original validation identity");

for handle in [session,rejected,swapped,retained,private] {assert(handle.close() and not handle.close(),"caller closes every acquired session");}
print "pbai_neural_session_pass";
