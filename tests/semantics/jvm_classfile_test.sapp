let JVM = import("stdlib:jvm_classfile.sapp");

fn fail(message) { throw "FAIL jvm_classfile: " + message; }
fn add(dst, src) { let i = 0; while i < len(src) { array_push(dst, src[i]); i = i + 1; } }

let c = JVM.new_class("org/pblang/Test", "java/lang/Object");
JVM.add_field(c, 2, "state", "Ljava/lang/String;");
let state_ref = JVM.field_ref(c, "org/pblang/Test", "state", "Ljava/lang/String;");
if state_ref < 1 or len(c.fields) != 1 { fail("field declaration/reference missing"); }
let large_integer = JVM.integer_ref(c, 1180761);
if large_integer < 1 or large_integer != JVM.integer_ref(c, 1180761) {
    fail("integer constants are not interned");
}
let signed_integer = JVM.integer_ref(c, -2147483648);
if signed_integer < 1 { fail("signed integer constant missing"); }
let bad_integer = try { JVM.integer_ref(c, 2147483648); false } catch true;
if not bad_integer { fail("out-of-range integer constant was accepted"); }
let listener = JVM.add_interface(c, "java/lang/Runnable");
if listener != JVM.add_interface(c, "java/lang/Runnable") or len(c.interfaces) != 1 {
    fail("interface references are not deduplicated");
}
let init = JVM.method_ref(c, "java/lang/Object", "<init>", "()V");
let code = [42]; add(code, JVM.insn_u2(183, init)); array_push(code, 177);
JVM.add_method(c, 1, "<init>", "()V", 1, 1, code);
let bytes = JVM.finish(c);

if len(bytes) < 40 { fail("class file unexpectedly small"); }
if bytes[0] != 202 or bytes[1] != 254 or bytes[2] != 186 or bytes[3] != 190 { fail("magic mismatch"); }
if bytes[6] != 0 or bytes[7] != 49 { fail("class version is not Java 5/49"); }

let unicode_text = JVM.string_ref(c, "PBLang \u03bb \u03ba\u03cc\u03c3\u03bc\u03bf\u03c2");
if unicode_text < 1 or unicode_text != JVM.string_ref(
    c, "PBLang \u03bb \u03ba\u03cc\u03c3\u03bc\u03bf\u03c2") {
    fail("Unicode modified UTF-8 constants are not accepted/interned");
}

let bad_code = false;
try { JVM.add_method(c, 1, "bad", "()V", 1, 1, [256]); } catch { bad_code = true; }
if not bad_code { fail("invalid opcode byte was accepted"); }

let bad_field = false;
try { JVM.add_field(c, -1, "bad", "I"); } catch { bad_field = true; }
if not bad_field { fail("invalid field access was accepted"); }

let assembled = JVM.code_builder();
JVM.mark(assembled, "start");
JVM.emit(assembled, [3]);
JVM.branch(assembled, 153, "done");
JVM.branch(assembled, 167, "start");
JVM.mark(assembled, "done");
JVM.emit(assembled, 177);
let assembled_bytes = JVM.finish_code(assembled);
if len(assembled_bytes) != 8 or assembled_bytes[2] != 0 or assembled_bytes[3] != 6
    or assembled_bytes[5] != 255 or assembled_bytes[6] != 252 {
    fail("forward/backward branch offsets");
}
let unresolved = JVM.code_builder(); JVM.branch(unresolved, 167, "missing");
let unresolved_failed = false;
try { JVM.finish_code(unresolved); } catch { unresolved_failed = true; }
if not unresolved_failed { fail("unresolved branch was accepted"); }
let duplicate = JVM.code_builder(); JVM.mark(duplicate, "same");
let duplicate_failed = false;
try { JVM.mark(duplicate, "same"); } catch { duplicate_failed = true; }
if not duplicate_failed { fail("duplicate label was accepted"); }
let wrong_opcode = JVM.code_builder();
let wrong_opcode_failed = false;
try { JVM.branch(wrong_opcode, 177, "not_a_branch"); } catch { wrong_opcode_failed = true; }
if not wrong_opcode_failed { fail("non-branch opcode was accepted as a branch"); }
let corrupt = JVM.code_builder(); JVM.branch(corrupt, 167, "end"); JVM.mark(corrupt, "end");
corrupt.patches[0].position = 99;
let corrupt_failed = false;
try { JVM.finish_code(corrupt); } catch { corrupt_failed = true; }
if not corrupt_failed { fail("corrupt branch patch was accepted"); }

let typed = JVM.code_builder();
JVM.emit_iload(typed, 0); JVM.emit_iload(typed, 7);
JVM.emit_istore(typed, 2); JVM.emit_istore(typed, 9);
JVM.emit_aload(typed, 3); JVM.emit_aload(typed, 12);
JVM.emit_astore(typed, 1); JVM.emit_astore(typed, 15);
JVM.emit_iinc(typed, 15, -1); JVM.emit_newarray(typed, 10);
let typed_bytes = JVM.finish_code(typed);
if typed_bytes != [26, 21, 7, 61, 54, 9, 45, 25, 12, 76, 58, 15, 132, 15, 255, 188, 10] {
    fail("typed local/array emitters produced incorrect bytes");
}
let bad_local = try { JVM.emit_iload(JVM.code_builder(), 256); false } catch true;
let bad_increment = try { JVM.emit_iinc(JVM.code_builder(), 0, -129); false } catch true;
let bad_array = try { JVM.emit_newarray(JVM.code_builder(), 12); false } catch true;
if not bad_local or not bad_increment or not bad_array { fail("typed emitters accepted invalid operands"); }

let protected_code = JVM.code_builder();
JVM.mark(protected_code, "try_start"); JVM.emit(protected_code, 1); JVM.emit(protected_code, 191);
JVM.mark(protected_code, "try_end"); JVM.emit(protected_code, 177);
JVM.mark(protected_code, "catch"); JVM.emit(protected_code, 76); JVM.emit(protected_code, 177);
let protected = JVM.finish_method_code(protected_code, [map{
    start: "try_start", end: "try_end", handler: "catch", catch_type: "java/lang/Throwable"
}]);
let protected_index = JVM.add_method(c, 9, "protectedRun", "()V", 1, 2, protected);
if len(c.methods[protected_index].exceptions) != 1
    or c.methods[protected_index].exceptions[0].catch_type < 1 {
    fail("typed exception handler was not retained");
}
let bad_handler = try {
    JVM.finish_method_code(protected_code, [map{
        start: "try_end", end: "try_start", handler: "catch", catch_type: "java/lang/Throwable"
    }]); false
} catch true;
let missing_handler = try {
    JVM.finish_method_code(protected_code, [map{
        start: "try_start", end: "missing", handler: "catch", catch_type: nil
    }]); false
} catch true;
if not bad_handler or not missing_handler { fail("invalid exception table was accepted"); }
let protected_bytes = JVM.finish(c);
if len(protected_bytes) <= len(bytes) { fail("exception table was not serialized"); }

print "jvm_classfile_pass";
