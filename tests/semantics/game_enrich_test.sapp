// tests/semantics/game_enrich_test.sapp — enrichment for stdlib/game.sapp
// Adds easing (smoothstep, ease_*), move_toward, vec2_clamp_mag.

let game = import("stdlib/game.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base vec2 still works ────────────────────────────────────────────────────────
let v = game.vec2_add(game.vec2(1, 2), game.vec2(3, 4));
near(v.x, 4, "vec2_add x"); near(v.y, 6, "vec2_add y");

// ── ENRICH: smoothstep ───────────────────────────────────────────────────────────
near(game.smoothstep(0, 1, 0.5), 0.5, "smoothstep mid");
near(game.smoothstep(0, 1, 0 - 1), 0, "smoothstep clamps low");
near(game.smoothstep(0, 1, 2), 1, "smoothstep clamps high");

// ── ENRICH: easing ───────────────────────────────────────────────────────────────
near(game.ease_in_quad(0.5), 0.25, "ease_in_quad");
near(game.ease_out_quad(0.5), 0.75, "ease_out_quad");
near(game.ease_in_out_quad(0.5), 0.5, "ease_in_out_quad mid");

// ── ENRICH: move_toward ──────────────────────────────────────────────────────────
near(game.move_toward(0, 10, 3), 3, "move_toward steps by max_delta");
near(game.move_toward(0, 10, 100), 10, "move_toward clamps to target");
near(game.move_toward(10, 0, 3), 7, "move_toward downward");

// ── ENRICH: vec2_clamp_mag ───────────────────────────────────────────────────────
let cm = game.vec2_clamp_mag(game.vec2(6, 8), 5);   // mag 10 -> clamp to 5 -> (3,4)
near(cm.x, 3, "clamp_mag x"); near(cm.y, 4, "clamp_mag y");
let un = game.vec2_clamp_mag(game.vec2(1, 0), 5);   // mag 1 <= 5 unchanged
near(un.x, 1, "clamp_mag under-limit unchanged");

print "game_enrich_pass";
