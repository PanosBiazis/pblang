let CG = import("stdlib:code_graph.sapp");
let PATHS = import("stdlib:code_graph_paths.sapp");
let KG = import("stdlib:knowledge_graph.sapp");
let LINK = import("stdlib:source_inliner.sapp");

fn require(ok, reason) { if not ok { throw "FAIL code_graph_paths: " + reason; } }
fn entry(imports) { return map{ imports: imports }; }
let modules = map{
    "main.sapp": entry(["a/util.sapp", "b/util.sapp"]),
    "a/util.sapp": entry(["./child.sapp"]),
    "a/child.sapp": entry([]),
    "b/util.sapp": entry(["../a/child.sapp"])
};
let result = PATHS.module_graph_paths(modules);
require(result.ok and result.complete and len(result.graph.order) == 4,
    "same basename in separate directories retains every module");
require(len(result.graph.edges) == 4 and len(KG.backlinks(result.graph, "a/child.sapp")) == 2,
    "both relative import edges reach the correct module");
require(len(CG.module_corpus(modules)) == 3 and map_has(CG.module_corpus(modules), "util"),
    "legacy stem-based corpus remains compatible");

let choices = map{ "util.sapp": true, "a/util.sapp": true };
require(LINK.resolve_module_identity("util.sapp", "a/main.sapp", choices) == "util.sapp",
    "rooted candidate wins when both exist");
require(LINK.resolve_module_identity("util.sapp", "a/main.sapp", map{ "a/util.sapp": true }) == "a/util.sapp",
    "legacy relative fallback only when root absent");
require(LINK.resolve_module_identity("./util.sapp", "a/main.sapp", choices) == "a/util.sapp",
    "explicit relative import");
require(LINK.resolve_module_identity("./util.sapp", "pkg:a/main.sapp", map{}) == "pkg:a/util.sapp",
    "package scheme inherited");
require(LINK.resolve_module_identity("stdlib/util.sapp", "", map{}) == "stdlib:util.sapp",
    "stdlib rooted alias");
require(LINK.resolve_module_identity("a/../util.sapp", "", map{}) == "util.sapp",
    "valid normalization");
for invalid in [nil, 12, true, [], map{}, "", "/absolute.sapp", "../escape.sapp", "a\\b.sapp", "bad\nname.sapp"] {
    require(LINK.resolve_module_identity(invalid, "", map{}) == nil, "invalid raw input returns nil");
}
for importer in [nil, 3, map{}, "a/../main.sapp", "stdlib/main.sapp", "/main.sapp", "../main.sapp"] {
    require(LINK.resolve_module_identity("util.sapp", importer, map{}) == nil,
        "malformed or noncanonical public importer rejected");
}
require(LINK.resolve_module_identity("util.sapp", "", []) == nil, "candidates must be map");
require(len(choices) == 2, "resolver does not modify candidates");

let spelled = PATHS.module_graph_paths(map{
    "main.sapp": entry(["my-lib/util-file.sapp", "My-lib/util-file.sapp", "my-lib/util-file"]),
    "my-lib/util-file.sapp": entry([])
});
require(spelled.ok and len(spelled.unresolved) == 2
    and spelled.resolutions[0].status == "resolved",
    "hyphens accepted, with no case folding or extension inference");

let external = PATHS.module_graph_paths(map{ "main.sapp": entry(["pkg:api.sapp", "stdlib/util.sapp"]) });
require(external.ok and not external.complete and len(external.unresolved) == 2,
    "valid unavailable imports explicitly unresolved");
require(len(KG.unresolved(external.graph)) == 2, "missing targets remain dangling graph nodes");
require(external.resolutions[0].status == "unresolved", "structured status retained");
let aliases = PATHS.module_graph_paths(map{ "stdlib/util.sapp": entry([]), "stdlib:util.sapp": entry([]) });
require(not aliases.ok and aliases.graph == nil and len(aliases.corpus) == 0
    and len(aliases.ambiguous) == 1 and len(aliases.ambiguous[0].candidates) == 2,
    "canonical aliases fail closed without first-file selection");
let dot_alias = PATHS.module_graph_paths(map{ "a/../util.sapp": entry([]), "util.sapp": entry([]) });
require(not dot_alias.ok and dot_alias.graph == nil, "normalized path collision");
for bad in ["a[[b]].sapp", "a#b.sapp", "a|b.sapp", "<tag>.sapp", "a b.sapp", " ../escape.sapp", "../../escape.sapp"] {
    let invalid_key = map{}; invalid_key[bad] = entry([]);
    let rejected = PATHS.module_graph_paths(invalid_key);
    require(not rejected.ok and rejected.graph == nil and len(rejected.corpus) == 0,
        "unsafe source identity rejected");
    rejected = PATHS.module_graph_paths(map{ "main.sapp": entry([bad]) });
    require(not rejected.ok and rejected.graph == nil and len(rejected.corpus) == 0,
        "unsafe import cannot inject graph edges");
}
for malformed in [nil, [], "text", map{ "main.sapp": nil }, map{ "main.sapp": map{} },
    map{ "main.sapp": entry("wrong") }, map{ "main.sapp": entry([map{}]) }] {
    let rejected = PATHS.module_graph_paths(malformed);
    require(not rejected.ok and rejected.graph == nil, "malformed analysis returns explicit failure");
}
let reversed = map{};
for path in ["b/util.sapp", "a/child.sapp", "a/util.sapp", "main.sapp"] { reversed[path] = modules[path]; }
let reverse_result = PATHS.module_resolution(reversed);
for path in map_keys(result.corpus) {
    require(reverse_result.corpus[path] == result.corpus[path], "resolution independent of supplied key order");
}
let many = map{}; let i = 0;
while i < 1200 {
    many["group" + str(i) + "/util.sapp"] = entry(["./child.sapp"]);
    many["group" + str(i) + "/child.sapp"] = entry([]);
    i = i + 1;
}
let large = PATHS.module_graph_paths(many);
require(large.ok and large.complete and len(large.graph.order) == 2400 and len(large.graph.edges) == 1200,
    "large supplied project retains every repeated basename without a project count cap");
require(PATHS.module_graph_paths(map{}).complete, "empty supplied corpus is structurally complete");
print "code_graph_paths_pass";
