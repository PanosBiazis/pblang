let P = import("stdlib:platform_emulator.sapp");

let linux = P.resolve("linux", "6.8", "amd64", map{ libc: "musl" });
assert(linux.ok and linux.arch == "x86_64" and linux.executable_format == "elf", "Linux x64 profile");
assert(linux.libc == "musl" and linux.pointer_bits == 64, "Linux profile options");

let windows = P.resolve("win64", "11", "x64");
assert(windows.ok and windows.executable_format == "pe" and windows.line_ending == "\r\n", "Windows profile");
let mac = P.resolve("darwin", "14.5", "aarch64");
assert(mac.ok and mac.executable_format == "mach-o" and mac.abi == "darwin", "macOS arm64 profile");
let android = P.resolve("android", "34", "armeabi-v7a");
assert(android.ok and android.libc == "bionic" and android.sandboxed, "Android profile");
let ios = P.resolve("ios", "17.4", "arm64-simulator");
assert(ios.ok and ios.mobile and ios.sandboxed, "iOS simulator profile");
let freebsd = P.resolve("freebsd", "14", "riscv64");
assert(freebsd.ok and freebsd.syscall_model == "freebsd", "FreeBSD profile");
assert(P.resolve("openbsd", "7.5", "arm64").ok, "OpenBSD arm64 profile");
assert(P.resolve("netbsd", "10", "sparc").ok, "NetBSD SPARC profile");
assert(P.resolve("illumos", "11.4", "x64").os == "solaris", "illumos canonical Solaris profile");
assert(P.resolve("haiku", "1", "x86_64").ok, "Haiku x64 profile");
let wasi = P.resolve("wasm", "1", "wasm32");
assert(wasi.ok and wasi.executable_format == "wasm", "WASI profile");
let dos = P.resolve("msdos", "6.22", "i386");
assert(dos.ok and dos.executable_format == "mz" and dos.pointer_bits == 32, "DOS x86 profile");
let cpm = P.resolve("cp/m", "2.2", "z80");
assert(cpm.ok and cpm.executable_format == "com" and cpm.pointer_bits == 16, "CP/M Z80 profile");
assert(P.resolve("amiga", "3.1", "68000").ok, "AmigaOS m68k profile");
assert(P.resolve("os/2", "2", "x86").ok, "OS/2 profile");
assert(P.resolve("plan9", "4", "x86_64").ok, "Plan 9 profile");
assert(P.resolve("qnx", "7", "arm64").realtime, "QNX real-time profile");
let freertos = P.resolve("free-rtos", "11", "atmega328p");
assert(freertos.ok and freertos.arch == "avr" and freertos.pointer_bits == 16 and freertos.realtime, "FreeRTOS AVR profile");
assert(P.resolve("zephyr", "3.7", "rv32").ok, "Zephyr RISC-V32 profile");
assert(P.resolve("nuttx", "12", "armv7").ok, "NuttX profile");
assert(P.resolve("vxworks", "7", "sparc").ok, "VxWorks SPARC profile");
let bare = P.resolve("baremetal", "1", "mos6502");
assert(bare.ok and bare.pointer_bits == 16 and bare.sandboxed, "bare-metal 6502 profile");
assert(P.resolve("aix", "7.3", "ppc64").ok, "AIX PowerPC64 profile");
assert(P.resolve("hpux", "11.31", "ia64").ok, "HP-UX IA64 profile");
assert(P.resolve("irix", "6.5", "mips").ok, "IRIX MIPS profile");
assert(P.resolve("chrome-os", "120", "x64").ok, "ChromeOS profile");
assert(P.resolve("fuchsia", "1", "arm64").ok, "Fuchsia profile");
assert(P.resolve("tizen", "8", "arm64").ok, "Tizen profile");
assert(P.resolve("web-os", "24", "arm64").ok, "webOS profile");

assert(not P.resolve("macos", "10.15", "arm64").ok, "reject impossible pre-Apple-Silicon profile");
assert(not P.resolve("windows", "6.1", "arm64").ok, "reject old Windows arm64");
assert(not P.resolve("ios", "17", "x86_64").ok, "reject retired iOS x64 simulator");
assert(not P.resolve("linux", "2.4", "x86").ok, "reject unverified old kernel contract");
assert(not P.resolve("linux", "4.14", "riscv64").ok, "reject Linux RISC-V before architecture floor");
assert(not P.resolve("unknownos", "1", "x86").ok, "reject unknown OS family");

assert(P.compare_versions("10.15.7", "10.15.6") > 0, "version comparison patch");
assert(P.compare_versions("11", "11.0") == 0, "version comparison normalization");
assert(P.compatible(P.resolve("windows", "11", "x86_64"), P.resolve("windows", "10", "x86")), "Windows x64 hosts x86 target");
assert(not P.compatible(linux, windows), "cross-family compatibility rejected");
assert(P.isa_model(P.resolve("linux", "6", "riscv64")).verified, "RISC-V ISA verification mapping");
assert(P.isa_model(freertos).test == "tests/semantics/emu_avr_test.sapp", "AVR ISA verification mapping");
assert(P.isa_model(cpm).test == "tests/semantics/emu_z80_test.sapp", "Z80 ISA verification mapping");
assert(P.isa_model(bare).test == "tests/semantics/emu_6502_test.sapp", "6502 ISA verification mapping");
assert(P.isa_model(P.resolve("vxworks", "7", "sparc")).module == "stdlib:emulator_sparc32.sapp", "SPARC reusable module mapping");
assert(not P.isa_model(android).verified, "armv7 remains honest until encoder model exists");

let family_only = P.release_conformance(android);
assert(family_only.ok and family_only.family_contract_verified and not family_only.exact_release_verified and not family_only.publishable,
       "family profile does not imply exact Android release verification");
let digest = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
let exact_android = P.release_conformance(android, map{
    format: "pblang.platform.release-evidence.v1", os: "android", version: "34", arch: "armv7",
    backend: "android-userspace-v1", runner: "physical-device", artifact_sha256: digest,
    test_report_sha256: digest, duration_ms: 60000,
    checks: map{ loader: true, abi: true, memory: true, filesystem: true, process: true,
                 error_paths: true, quotas: true, cleanup: true }
});
assert(exact_android.ok and exact_android.exact_release_verified and exact_android.publishable and not exact_android.full_kernel_verified,
       "exact evidence upgrades only the userspace release contract");
let mismatched_android = P.release_conformance(android, map{
    format: "pblang.platform.release-evidence.v1", os: "android", version: "28", arch: "armv7",
    backend: "android-userspace-v1", runner: "physical-device", artifact_sha256: digest,
    test_report_sha256: digest, duration_ms: 60000, checks: map{}
});
assert(not mismatched_android.ok, "mismatched exact-release evidence fails closed");

let custom = P.custom_profile(map{ os: "research-os", version: "0.1", arch: "rv64", abi: "research",
    executable_format: "elf", syscall_model: "capability", sandboxed: true, device_classes: ["research-device"] });
assert(custom.ok and custom.arch == "riscv64" and str_contains(custom.boundary, "unverified"), "validated custom profile remains explicitly unverified");
assert(not P.custom_profile(map{ os: "broken" }).ok, "incomplete custom profile rejected");

let wp = P.normalize_path(windows, "c:\\work\\.\\src\\..\\app.sapp");
assert(wp.ok and wp.path == "C:\\work\\app.sapp", "Windows path normalization");
assert(not P.normalize_path(linux, "../../etc/passwd").ok, "root traversal rejected");
let ip = P.normalize_path(ios, "/tmp/state.db");
assert(ip.ok and str_starts_with(ip.path, ios.root), "iOS path confined to sandbox");

let m = P.machine(linux, map{ memory_bytes: 64, max_files: 2, max_output_bytes: 12 });
assert(P.memory_write(m, 60, [1, 2, 3, 255]).ok, "bounded memory write");
assert(P.memory_read(m, 60, 4).bytes == [1, 2, 3, 255], "bounded memory roundtrip");
assert(not P.memory_write(m, 63, [1, 2]).ok, "memory overflow rejected");
assert(not P.memory_write(m, 0, [256]).ok, "invalid byte rejected");
assert(not P.memory_write(m, "Infinity", [1]).ok, "non-finite address rejected");
assert(not P.memory_write(m, 10, [9, 256]).ok and P.memory_read(m, 10, 1).bytes[0] == 0,
       "invalid byte batch is transactional");

let sparse = P.machine(linux, map{ memory_bytes: 1048576, memory_layout: "sparse" });
assert(P.memory_read(sparse, 500000, 4).bytes == [0, 0, 0, 0], "sparse memory is logically zero-filled");
assert(P.memory_write(sparse, 1048572, [7, 0, 8, 0]).ok, "sparse memory supports bounded high addresses");
assert(P.memory_read(sparse, 1048572, 4).bytes == [7, 0, 8, 0], "sparse memory roundtrip");
let sparse_stats = P.memory_stats(sparse);
assert(sparse_stats.layout == "sparse" and sparse_stats.logical_bytes == 1048576 and sparse_stats.resident_cells == 2, "sparse memory stores only nonzero cells");
assert(P.machine(linux, map{ memory_bytes: 1048576 }).memory_layout == "sparse", "large auto memory avoids eager allocation");
assert(P.machine(linux, map{ memory_bytes: 64 }).memory_layout == "contiguous", "small auto memory preserves contiguous compatibility");

assert(P.syscall(m, "setenv", map{ key: "MODE", value: "test" }).ok, "setenv");
assert(P.syscall(m, "getenv", map{ key: "MODE" }).value == "test", "getenv");
assert(P.syscall(m, "listenv").count == 1, "environment count is O(1) and observable");
assert(P.syscall(m, "unsetenv", map{ key: "MODE" }).found, "unsetenv releases quota");
assert(not P.syscall(m, "setenv", map{ key: "BAD\x00KEY", value: "x" }).ok,
       "environment key NUL rejected");
assert(not P.syscall(m, "setenv", map{ key: "BAD", value: "x\x00y" }).ok,
       "environment value NUL rejected");
assert(P.syscall(m, "write_file", map{ path: "/tmp/a", data: "alpha" }).ok, "virtual write file");
assert(P.syscall(m, "read_file", map{ path: "/tmp/a" }).data == "alpha", "virtual read file");
assert(P.syscall(m, "list_files").count == 1, "file count is O(1) and observable");
assert(P.machine_stats(m).file_bytes == 5, "machine stats report virtual storage");
assert(P.syscall(m, "delete_file", map{ path: "/tmp/a" }).found, "delete_file releases storage quota");
assert(not P.syscall(m, "read_file", map{ path: "/missing" }).ok, "missing file predictable error");
assert(P.syscall(m, "write", map{ text: "hello" }).ok and m.stdout == "hello", "stdout capture");
assert(not P.syscall(m, "write", map{ text: "-too-long-" }).ok, "output limit enforced");

let utf8_output = P.machine(linux, map{ memory_bytes: 64, max_output_bytes: 4 });
assert(P.syscall(utf8_output, "write", map{ text: "é" }).count == 2,
       "output counts UTF-8 bytes");
assert(P.syscall(utf8_output, "write", map{ text: "é" }).ok
       and P.machine_stats(utf8_output).output_bytes == 4,
       "UTF-8 output exact byte quota");
assert(not P.syscall(utf8_output, "write", map{ text: "x" }).ok,
       "UTF-8 output cannot bypass byte quota");

let storage = P.machine(linux, map{ memory_bytes: 64, max_storage_bytes: 8 });
assert(P.syscall(storage, "write_file", map{ path: "/a", data: "12345678" }).ok, "storage quota exact fit");
assert(not P.syscall(storage, "write_file", map{ path: "/b", data: "x" }).ok, "aggregate storage quota enforced");
assert(P.syscall(storage, "delete_file", map{ path: "/a" }).found, "storage delete succeeds");
assert(P.syscall(storage, "write_file", map{ path: "/b", data: "x" }).ok, "released storage can be reused");
assert(P.syscall(storage, "write_file", map{ path: "/b", data: "1234" }).ok and
       P.machine_stats(storage).files == 1 and P.machine_stats(storage).file_bytes == 4,
       "file overwrite adjusts bytes without increasing count");
let utf8_storage = P.machine(linux, map{ memory_bytes: 8, max_storage_bytes: 4 });
assert(P.syscall(utf8_storage, "write_file", map{ path: "/unicode", data: "éé" }).count == 4,
       "file storage counts UTF-8 bytes");
assert(not P.syscall(utf8_storage, "write_file", map{ path: "/extra", data: "x" }).ok,
       "UTF-8 storage cannot bypass aggregate byte quota");
let invalid_machine = try P.machine(linux, map{ memory_bytes: "Infinity" }) catch nil;
assert(invalid_machine == nil, "non-finite machine quota rejected");

let m2 = P.machine(linux, map{ memory_bytes: 8 });
let r1 = P.syscall(m, "random_u32").value;
let r2 = P.syscall(m2, "random_u32").value;
assert(r1 == r2, "deterministic random service");
assert(P.syscall(m, "clock_ms", map{ advance: 5 }).value == 5, "deterministic clock");
assert(not P.syscall(m, "mount_host_disk", map{}).ok, "unknown syscall fails closed");
assert(P.syscall(m, "exit", map{ code: 7 }).ok and m.exited and m.exit_code == 7, "exit state");
assert(not P.syscall(m, "write", map{ text: "after exit" }).ok, "syscalls blocked after exit");

print "platform_emulator_pass";
