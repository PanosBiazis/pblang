// Test: ring-3 USERMODE language readiness (stdlib/kernel/gdt.sapp + intrinsics), §82.
//
// This locks the LANGUAGE primitives a kernel author uses to run code unprivileged:
// GDT user code/data segments + a TSS (gdt.sapp), the `lgdt`/`ltr`/`enter_user`/`read_cs`
// intrinsics, and a DPL-3 syscall gate. (The OS itself is the author's to build — this
// is the readiness, like §72 for interrupts.) Proven END-TO-END in QEMU: kmain sets up
// GDT+TSS, installs isr_syscall on vector 0x80 with a DPL-3 gate, drops to ring 3 via
// enter_user; user_main confirms cs == 0x1B (CPL 3) and traps back via syscall to exit
// -> exit 85 (any flaw in the privilege setup -> #GP -> triple fault -> exit 0).

let ct = import("stdlib/compiler/ctranspile.sapp");
let intr = fs_read("stdlib/kernel/interrupts.sapp");
let con = fs_read("stdlib/kernel/console.sapp");
let sys = fs_read("stdlib/kernel/syscall.sapp");
let gdt = fs_read("stdlib/kernel/gdt.sapp");

let src = "fn isr_syscall() { let n = sys_num(); let a = sys_arg(); "
    + "if n == 1 { serial_putc(a); sys_return(0); } else { if n == 3 { outb(244, 42); } else { sys_return(0 - 1); } } } "
    + "fn user_main() { let mycs = read_cs(); if mycs == 27 { sys_call(3, 0); } while 1 > 0 { } } "
    + "fn kmain() { serial_init(); pic_mask(255, 255); "
    + "let gdt = kmalloc(48); let tss = kmalloc(104); let kstack = kmalloc(8192); "
    + "tss_init(tss, kstack + 8192, 16); gdt_build(gdt, tss); gdt_load(gdt, 6); tss_load(); "
    + "let idt = kmalloc(2048); idt_set_gate(idt, 128, addr_of(\"isr_syscall\"), 8, 238); idt_load(idt); "
    + "let ustack = kmalloc(8192); enter_user(addr_of(\"user_main\"), ustack + 8192); while 1 > 0 { hlt(); } }";

let c = ct.transpile_kernel_int(intr + con + sys + gdt + src);

// ── Usermode intrinsics ──────────────────────────────────────────────────────────────
assert(str_contains(c, "static inline void lgdt("), "lgdt intrinsic present");
assert(str_contains(c, "static inline void ltr("), "ltr (load task register) intrinsic present");
assert(str_contains(c, "static inline void enter_user("), "enter_user (ring0->ring3 iret) intrinsic present");
assert(str_contains(c, "pushl $0x1B"), "enter_user pushes the user code selector (RPL 3)");
assert(str_contains(c, "iret"), "enter_user drops to ring 3 via iret");
assert(str_contains(c, "static inline u32 read_cs("), "read_cs intrinsic (query privilege level)");

// ── GDT + TSS primitives ─────────────────────────────────────────────────────────────
assert(str_contains(c, "long gdt_set_entry(long gdt, long idx, long base, long limit, long access, long gran)"), "descriptor encoder");
assert(str_contains(c, "long gdt_build(long gdt, long tss_base)"), "builds kernel+user+TSS descriptors");
assert(str_contains(c, "long gdt_load(long gdt, long num_entries)"), "loads the GDTR");
assert(str_contains(c, "long tss_init(long tss, long esp0, long ss0)"), "TSS with a ring-0 stack");
assert(str_contains(c, "long tss_load()"), "ltr loads the task register");

// ── DPL-3 syscall gate (so ring 3 may int 0x80) ─────────────────────────────────────
assert(str_contains(c, ", 8, 238)"), "syscall gate installed with DPL-3 flags (0xEE = 238)");

assert(not str_contains(c, "double"), "usermode path is float-runtime-free");
assert(str_contains(c, "0x1BADB002"), "multiboot header present");

print "kernel_usermode_pass";
