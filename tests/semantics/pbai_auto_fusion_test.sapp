// tests/semantics/pbai_auto_fusion_test.sapp — auto_configure now also chooses the
// FUSION mode. It sweeps decision-mode × fusion (static/adaptive/routing × hard/soft),
// keeps the best combo, ties prefer the simplest (static + hard), and restores BOTH
// dimensions on the engine. Returns {mode, fusion, accuracy, results (per mode, best
// fusion), results_full (per "mode/fusion")}.

let ens = import("stdlib/pbai_ensemble.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// Case where FUSION is the deciding axis (no stats needed -> decision mode is neutral):
//   native: argmax "improve" (0.45), but "explain" is a strong runner-up (0.40)
//   voter M: argmax "bugs" (0.50), "explain" runner-up (0.45)
//   hard  -> argmaxes compete: improve(0.45) vs bugs(0.50) -> "bugs" (WRONG)
//   soft  -> mass sums: explain 0.85 > improve 0.75 > bugs 0.65 -> "explain" (RIGHT)
let scores = fn(p) { return map{ intent: "improve", scores: [0.4, 0.15, 0.45, 0, 0] }; };
ens.configure(scores, ["explain", "bugs", "improve", "comment", "general"]);
ens.clear_voters();
ens.reset_stats();
ens.set_adaptive(false);
ens.set_routing(false);
ens.set_parallel(false);
ens.set_fusion("hard");
ens.register_model("M", fn(p) { return map{ intent: "bugs", scores: [0.45, 0.5, 0.3, 0, 0] }; });
ens.clear_native_cache();

let examples = [ map{ prompt: "a", intent: "explain" }, map{ prompt: "b", intent: "explain" } ];

let r = ens.auto_configure(examples);
eq(r.fusion, "soft", "auto_configure picks soft fusion when it wins");
eq(r.accuracy, 1, "best combo scores 1");
ens.clear_native_cache();
eq(ens.ensemble("q"), "explain", "engine left running in the winning (soft) fusion");
if r.results_full["static/hard"] >= 1 { fail("hard fusion should not score 1 here"); }
eq(r.results_full["static/soft"], 1, "static/soft scored 1");

// tie (single trivial example, no voters) -> simplest combo: static mode + hard fusion
ens.clear_voters();
ens.reset_stats();
ens.clear_native_cache();
let r2 = ens.auto_configure([ map{ prompt: "a", intent: "improve" } ]);
eq(r2.mode, "static", "tie -> static mode");
eq(r2.fusion, "hard", "tie -> hard fusion (simplest)");

ens.set_fusion("hard");
ens.set_adaptive(false);
ens.set_routing(false);
ens.clear_voters();
ens.reset_stats();
print "pbai_auto_fusion_pass";
