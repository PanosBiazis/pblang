let LINK = import("stdlib:source_inliner.sapp");

fn require(value, message) { if not value { throw "FAIL source_inliner_package: " + message; } }

let modules = map{
    "pkg:src/api.sapp": "let INNER = import(\"./inner.sapp\");\nfn value() { return INNER.value(); }\nexport value;",
    "pkg:src/inner.sapp": "fn value() { return 9; }\nexport value;"
};
let linked = LINK.link_modules("let API = import(\"pkg:src/api.sapp\");\nprint API.value();", modules,
    map{ entry_path: "main.sapp" });
require(linked.ok, "package and package-relative imports link");
require(linked.modules == 2 and len(linked.module_order) == 2, "complete package graph");
require(type(linked.input_graph_sha256) == "string" and len(linked.input_graph_sha256) == 64,
    "immutable graph fingerprint");

let map_key = LINK.link_modules(
    "let API = import(\"pkg:src/api.sapp\");\nlet metadata = map{ API: \"schema-key\" };\nprint API.value();",
    modules, map{ entry_path: "main.sapp" });
require(map_key.ok, "import identifier remains legal as a map key");
let bare = LINK.link_modules(
    "let API = import(\"pkg:src/api.sapp\");\nlet unsupported = API;",
    modules, map{ entry_path: "main.sapp" });
require(not bare.ok, "first-class module value remains rejected");

let escaped = LINK.link_modules("let API = import(\"pkg:../outside.sapp\");", modules,
    map{ entry_path: "main.sapp" });
require(not escaped.ok, "package traversal rejected");
print "source_inliner_package_pass";
