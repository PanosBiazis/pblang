// Disposable loopback listeners only; no files, evaluator or lasting server.
let W=import("editors/ide/pbide_text_web.sapp");
let H=import("stdlib:http_server.sapp");
let TCP=import("stdlib:native_tcp.sapp");
let Hst=import("editors/ide/pbide_text_history.sapp");
let Wire=import("editors/ide/pbide_history_wire.sapp");
let Text=import("editors/ide/pbide_text.sapp");
let Drafts=import("editors/ide/pbide_tabs_wire.sapp");
if not TCP.available().ok { print "pbide_text_web_live_unsupported"; return; }
fn exchange(kind) {
    let listener=TCP.listen_ipv4("127.0.0.1",0,8);
    assert(listener.ok,"loopback listener opened");
    let port=listener.port; let host=W.endpoint(port);
    let body="source=%CE%B1%F0%9F%98%80%CE%B2&start=1&end=2&insert=&op=pair&pair=round";
    if kind=="history" {
        let original=Text.selection("α😀β",1,2);
        let history=Hst.commit(Hst.create(original,Wire.BUDGET),Text.pair(original,"("));
        body="source="+url_encode("α(😀)β")+"&start=2&end=3&insert=&op=undo&pair=round&history="+url_encode(Wire.encode(history));
    }
    if kind=="drafts" {
        let history=Hst.create(Text.selection("α😀β"),Wire.BUDGET);
        let drafts=Drafts.create(history);
        body="source="+url_encode("typed draft")+"&start=0&end=0&insert=&op=new-draft&pair=round&history="
            +url_encode(Wire.encode(history))+"&workspace="+url_encode(Drafts.encode(drafts));
    }
    let request_host=host; let origin="http://"+host;
    if kind=="host" { request_host="untrusted.invalid"; }
    if kind=="origin" { origin="https://untrusted.invalid"; }
    let wire="POST /edit HTTP/1.1\r\nHost: "+request_host+"\r\nOrigin: "+origin
        +"\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: "+str(len(body))
        +"\r\nConnection: close\r\n\r\n"+body;
    let marker="</html>"; if kind=="host" or kind=="origin" { marker="local editor."; }
    let done=channel();
    let worker=spawn(fn(){
        let Native=import("stdlib:native_tcp.sapp");
        let client=Native.connect_ipv4("127.0.0.1",port,1000);
        let written=Native.write_text(client,wire,1000);
        let reply=Native.read_until(client,marker,W.MAX_RESPONSE,1500);
        Native.close(client);
        assert(client.ok and written.ok and reply.ok,"bounded test client completed");
        send(done.sender,reply.text);
    });
    let policy=W.options(port); policy.max_connections=1;
    let served=H.serve_bounded_listener(listener,fn(req){return W.handle(req,port);},policy);
    TCP.close(listener);
    let reply=recv_timeout(done.receiver,2000); join(worker);
    assert(served.completed==1,"connection completed and listener closed");
    return reply;
}
let good=exchange("valid");
assert(str_contains(good,"200 OK") and str_contains(good,"α(😀)β"),"Unicode edit over actual bounded HTTP");
assert(str_contains(good,"Cache-Control: no-store") and str_contains(good,"script-src 'none'"),"wire security headers");
let undone=exchange("history");
assert(str_contains(undone,"200 OK") and str_contains(undone,"α😀β")
    and str_contains(undone,"history position 1 of 2"),"seven-field history undo over actual bounded HTTP");
let drafts=exchange("drafts");
assert(str_contains(drafts,"200 OK") and str_contains(drafts,"Draft2 history position 1 of 1")
    and str_contains(drafts,"name=\"workspace\""),"eight-field draft transition over actual bounded HTTP");
for kind in ["host","origin"] {
    let denied=exchange(kind);
    assert(str_contains(denied,"403 Forbidden") and not str_contains(denied,"α"),"wire gate denies foreign host/origin without echo");
}
print "pbide_text_web_live_pass";
