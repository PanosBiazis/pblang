let Game = import("stdlib:game.sapp");

fn require(value, message) {
    if not value { throw "game_fixed_step_test: " + message; }
}

fn near(actual, expected, message) {
    if num_abs(actual - expected) > 0.000001 {
        throw "game_fixed_step_test: " + message + " actual=" + str(actual)
            + " expected=" + str(expected);
    }
}

fn rejected(callable) { return (try { callable(); false } catch true); }

let ordinary = Game.fixed_step_plan(4, 27, 10, 8);
require(ordinary.steps == 3 and ordinary.dropped_steps == 0 and ordinary.bounded,
    "ordinary frame must expose all complete fixed steps");
near(ordinary.accumulator_ms, 1, "ordinary remainder");
near(ordinary.alpha, 0.1, "ordinary interpolation alpha");
near(ordinary.step_seconds, 0.01, "step duration in seconds");

let stalled = Game.fixed_step_plan(0, 100, 10, 3);
require(stalled.steps == 3 and stalled.dropped_steps == 7,
    "stalled frame must cap simulation work");
near(stalled.dropped_ms, 70, "dropped backlog duration");
near(stalled.accumulator_ms, 0, "stalled whole-step remainder");

let fractional = Game.fixed_step_plan(0, 5, 10, 3);
require(fractional.steps == 0 and fractional.dropped_steps == 0,
    "sub-step frame must preserve interpolation state without updates");
near(fractional.accumulator_ms, 5, "fractional remainder");
near(fractional.alpha, 0.5, "fractional alpha");

require(rejected(fn() { Game.fixed_step_plan(-1, 10, 10, 3); }),
    "negative accumulator must fail");
require(rejected(fn() { Game.fixed_step_plan(0, -1, 10, 3); }),
    "negative elapsed time must fail");
require(rejected(fn() { Game.fixed_step_plan(0, 10, 0, 3); }),
    "zero fixed step must fail");
require(rejected(fn() { Game.fixed_step_plan(0, 10, 10, 0); }),
    "zero work budget must fail");
require(rejected(fn() { Game.fixed_step_plan(10, 10, 10, 3); }),
    "non-normalized accumulator must fail");

print "game_fixed_step_pass";
