// tests/semantics/design_engine_enrich_test.sapp — enrichment for stdlib/design_engine.sapp
// Adds rect geometry: rect_center, rect_contains_point, rect_intersect, rect_union.

let de = import("stdlib/design_engine.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let r = de.rect(0, 0, 10, 20);

// ── ENRICH: rect_center ──────────────────────────────────────────────────────────
let c = de.rect_center(r);
eq(c.x, 5, "center x"); eq(c.y, 10, "center y");

// ── ENRICH: rect_contains_point ──────────────────────────────────────────────────
eq(de.rect_contains_point(r, 5, 5), true, "point inside");
eq(de.rect_contains_point(r, 15, 5), false, "point outside");

// ── ENRICH: rect_intersect ───────────────────────────────────────────────────────
eq(de.rect_intersect(de.rect(0, 0, 10, 10), de.rect(5, 5, 10, 10)), true, "overlapping");
eq(de.rect_intersect(de.rect(0, 0, 2, 2), de.rect(5, 5, 2, 2)), false, "disjoint");

// ── ENRICH: rect_union ───────────────────────────────────────────────────────────
let u = de.rect_union(de.rect(0, 0, 5, 5), de.rect(10, 10, 5, 5));
eq(u.x, 0, "union x"); eq(u.y, 0, "union y"); eq(u.w, 15, "union w"); eq(u.h, 15, "union h");

print "design_engine_enrich_pass";
