let bench = import("stdlib:benchmark.sapp");

// Test basic run
let result = bench.run("addition", fn() { return 1 + 1; }, 10);
assert(result.label == "addition", "label should match");
assert(result.iterations == 10, "iterations should be 10");
assert(result.total_ms >= 0.0, "total_ms should be non-negative");
assert(result.avg_ms >= 0.0, "avg_ms should be non-negative");
assert(result.min_ms >= 0.0, "min_ms should be non-negative");
assert(result.max_ms >= result.min_ms, "max_ms should >= min_ms");

// Test time()
let timed = bench.time(fn() { return 42; });
assert(timed.result == 42, "time result should be 42");
assert(timed.elapsed_ms >= 0.0, "elapsed_ms should be non-negative");

// Test warmup doesn't throw
bench.warmup(fn() { return 1 + 1; }, 5);

// Test compare
let results = bench.compare([
    map{ label: "fast", fn: fn() { return 1 + 1; }, iterations: 10 },
    map{ label: "slow", fn: fn() { return 1 + 1; }, iterations: 10 }
]);
assert(len(results) == 2, "compare should return 2 results");

print "benchmark_stdlib_pass";
