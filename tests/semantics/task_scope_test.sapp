let S=import("stdlib:task_scope.sapp");let D=import("stdlib:task_plan.sapp");
let doc=map{format:D.FORMAT,title:"Diamond plan",start:"2024-02-28",tasks:[
 map{id:"finish",label:"Finish",days:1,needs:["left","right"],done:false},map{id:"unrelated",label:"Other",days:20,needs:[],done:false},
 map{id:"right",label:"Right",days:3,needs:["root"],done:false},map{id:"root",label:"Root",days:2,needs:[],done:true},map{id:"left",label:"Left",days:1,needs:["root"],done:true}]};
let before=D.encode(doc);let scoped=S.extract(doc,["finish"]);assert(len(scoped.tasks)==4 and scoped.tasks[0].id=="finish" and scoped.tasks[1].id=="right" and scoped.tasks[2].done,"source order and completed prerequisites");assert(D.encode(doc)==before,"source immutable");
let full=D.schedule(doc);let part=D.schedule(scoped);for row in part.tasks {let matched=false;for original in full.tasks {if original.id==row.id {assert(original==row,"schedule unchanged");matched=true;}}assert(matched,"known task");}
scoped.tasks[0].needs[0]="modified";scoped.tasks[2].label="copy";assert(D.encode(doc)==before,"detached arrays and fields");
assert(len(S.extract(doc,["left","right"]).tasks)==3 and len(S.extract(doc,["root"]).tasks)==1,"shared ancestor once and exact root");
for ids in [[],["absent"],["root","root"],[nil],[1],"root"] {assert((try S.extract(doc,ids) catch nil)==nil,"invalid targets");}
for text in ["",",root","root,","root,,left","root,root","bad id",str_repeat("x",1601),nil] {assert((try S.parse_ids(text) catch nil)==nil,"invalid selector");}
assert(S.parse_ids(" left , right ")==["left","right"],"trimmed selectors");
let broken=D.copy(doc);broken.tasks[1].needs=["unrelated"];assert((try S.extract(broken,["root"]) catch nil)==nil,"excluded invalid branch still rejected");
let chain=D.create();chain.tasks=[];for i in range(0,32) {let needs=[];if i>0 {array_push(needs,"n"+str(i-1));}array_push(chain.tasks,map{id:"n"+str(i),label:"Task "+str(i),days:1,needs:needs,done:false});}
for target in range(0,32) {let cut=S.extract(chain,["n"+str(target)]);assert(len(cut.tasks)==target+1,"chain closure oracle");for i in range(0,target+1) {assert(cut.tasks[i].id=="n"+str(i),"exact chain membership");}}
let long=D.create();long.tasks[0].id=str_repeat("a",48);assert(len(S.extract(long,S.parse_ids(long.tasks[0].id)).tasks)==1,"full supported ID length");
print "task_scope_pass";
