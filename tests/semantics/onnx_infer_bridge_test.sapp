let r = onnx_infer("missing_model.onnx", "{}");
if type(r) != "map" { print "onnx_infer_type_fail"; }

let ok = try r.success catch nil;
if ok == nil { print "onnx_infer_missing_success"; }
if ok == true { print "onnx_infer_unexpected_success"; }

let err = try r.error catch "";
if len(err) == 0 { print "onnx_infer_missing_error"; }

print "onnx_infer_bridge_pass";
