let PROCESS = import("stdlib:linux_process.sapp");
let SECURE = import("stdlib:secure_file.sapp");
let DIRFS = import("stdlib:linux_dirfs.sapp");

fn expect(value, message) {
    if not value { throw "FAIL linux_process verified fixed: " + message; }
}

let candidate = "/usr/bin/printf";
let loaded = SECURE.read_bytes(candidate, 1048576);
expect(loaded.ok and loaded.size > 0, "fixed fixture must have a bounded nofollow snapshot");
let digest = sha256(base64_encode_bytes(loaded.bytes));
let options = map{
    timeout_secs: 2, max_output_bytes: 4096, max_file_bytes: 4096,
    max_memory_bytes: 134217728, max_cpu_seconds: 2,
    max_open_files: 32, max_processes: 2048, startup_timeout_ms: 2000,
    max_executable_bytes: 1048576, inherit_environment: false
};
let started = PROCESS.start_fixed_verified([candidate], digest, ["verified"], options);
expect(started.ok and started.executable_descriptor_held and
       started.executable_digest_verified and not started.check_then_exec_race,
    "matching executable must launch through its measured descriptor");
let result = PROCESS.finish(started, 4000);
expect(result.ok and result.command_ok and result.stdout == "verified" and
       result.executable_digest_verified and result.executable_sha256 == digest and
       result.process_group_terminated,
    "verified launch must preserve digest and lifecycle evidence");

let refused = PROCESS.start_fixed_verified([candidate], sha256("wrong executable"),
    ["must-not-run"], options);
expect(not refused.ok and not refused.executable_digest_verified,
    "digest mismatch must fail closed without execution");

let refused_prepared = PROCESS.prepare_fixed_verified([candidate],
    sha256("wrong prepared executable"), 1048576);
expect(not refused_prepared.ok and not refused_prepared.executable_digest_verified,
    "prepared descriptor must reject a mismatched startup digest");

let prepared = PROCESS.prepare_fixed_verified([candidate], digest, 1048576);
expect(prepared.ok and prepared.active and prepared.descriptor_bound and
       prepared.nofollow and not prepared.path_reopened and prepared.canonical_cloexec,
    "matching executable must become one startup-held descriptor");
let first = PROCESS.start_prepared_verified(prepared, ["first"], options);
let second = PROCESS.start_prepared_verified(prepared, ["second"], options);
expect(first.ok and second.ok and first.shared_preverified_descriptor and
       second.shared_preverified_descriptor and first.startup_nonblocking and
       second.startup_nonblocking and first.per_launch_descriptor_duplicate and
       second.per_launch_descriptor_duplicate and first.parent_handoff_closed and
       second.parent_handoff_closed,
    "multiple jobs must reuse a CLOEXEC canonical descriptor through private handoffs");
let first_status = PROCESS.poll(first); let second_status = PROCESS.poll(second);
expect(first_status.ok and second_status.ok,
    "deferred startup must advance only through nonblocking polls");
let first_result = PROCESS.finish(first, 4000);
let second_result = PROCESS.finish(second, 4000);
expect(first_result.ok and first_result.command_ok and first_result.stdout == "first" and
       second_result.ok and second_result.command_ok and second_result.stdout == "second",
    "reused prepared launches must retain independent supervised lifecycles");
let closed = PROCESS.close_prepared_verified(prepared);
expect(closed.ok and closed.closed and not prepared.active,
    "prepared descriptor ownership must close explicitly");
let closed_again = PROCESS.close_prepared_verified(prepared);
expect(closed_again.ok and closed_again.already_closed,
    "prepared descriptor close must be idempotent");
let launch_after_close = try {
    PROCESS.start_prepared_verified(prepared, ["must-not-run"], options); false
} catch true;
expect(launch_after_close,
    "closed prepared descriptors must never launch another process");

let sleep_path = "/usr/bin/sleep";
let sleep_loaded = SECURE.read_bytes(sleep_path, 1048576);
expect(sleep_loaded.ok, "cancellation fixture must have a bounded executable snapshot");
let sleep_digest = sha256(base64_encode_bytes(sleep_loaded.bytes));
let sleep_prepared = PROCESS.prepare_fixed_verified([sleep_path], sleep_digest, 1048576);
expect(sleep_prepared.ok, "cancellation fixture must prepare one canonical descriptor");
let pending = PROCESS.start_prepared_verified(sleep_prepared, ["2"], options);
expect(pending.ok and pending.startup_nonblocking and pending.process_group_id > 1,
    "deferred return must already own a cancellable session process group");
expect(DIRFS.remove(pending.fs, "group-probe").ok,
    "fault injection must remove only the private liveness helper");
let cancel_requested = PROCESS.request_cancel(pending, 50);
expect(cancel_requested.ok and cancel_requested.requested and
       not cancel_requested.terminated and cancel_requested.liveness == "indeterminate" and
       cancel_requested.process_group_id == pending.process_group_id and not pending.cleaned,
    "probe failure must retain lifecycle state without claiming termination");
let recovered = PROCESS.recover(pending, 3000);
expect(recovered.ok and recovered.recovered and not recovered.recovery_pending
    and recovered.process_group_terminated and recovered.state_cleaned and pending.cleaned,
    "recovery must restore private helpers, prove kernel disappearance and clean state");
expect(PROCESS.close_prepared_verified(sleep_prepared).ok,
    "cancellation fixture canonical descriptor must close cleanly");
expect(PROCESS.status().status_file_only_normal_polling,
    "normal process polling must not spawn liveness probes");
expect(PROCESS.status().tri_state_process_group_liveness,
    "lifecycle status must publish fail-closed tri-state liveness");

print "linux_process_verified_fixed_pass";
