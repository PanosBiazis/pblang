// emu_powerpc_test.sapp - verified PowerPC 32-bit execution model in pblang.
//
// PowerPC spans classic Macs, IBM systems, game consoles, networking equipment,
// embedded controllers, and radiation-tolerant space CPUs. The model uses real
// instruction words and a strict instruction budget. Linux PPC32 exit is r0=1,
// status in r3, followed by sc.

fn fail(m) { throw "FAIL emu-powerpc: " + m; }
fn _u16(v) { let r = v % 65536; if r < 0 { r = r + 65536; } return r; }
fn _sx16(v) { if v >= 32768 { return v - 65536; } return v; }

// Canonical fixed-width PowerPC encodings.
fn ADDI(rd, ra, imm) { return 14 * 67108864 + rd * 2097152 + ra * 65536 + _u16(imm); }
fn ADD(rd, ra, rb) { return 31 * 67108864 + rd * 2097152 + ra * 65536 + rb * 2048 + 266 * 2; }
fn SUBF(rd, ra, rb) { return 31 * 67108864 + rd * 2097152 + ra * 65536 + rb * 2048 + 40 * 2; }
fn MULLW(rd, ra, rb) { return 31 * 67108864 + rd * 2097152 + ra * 65536 + rb * 2048 + 235 * 2; }
fn CMPWI(ra, imm) { return 11 * 67108864 + ra * 65536 + _u16(imm); }
fn BNE(byte_disp) {
    let bd = byte_disp % 65536; if bd < 0 { bd = bd + 65536; }
    return 16 * 67108864 + 4 * 2097152 + 2 * 65536 + (bd - (bd % 4));
}
fn SC() { return 17 * 67108864 + 2; }

fn powerpc_run(code) {
    let r = []; let ri = 0; while ri < 32 { push(r, 0); ri = ri + 1; }
    let cr0eq = false; let pc = 0; let steps = 0; let halted = false; let result = 0;
    while pc >= 0 and pc < len(code) and steps < 1000000 and not halted {
        steps = steps + 1;
        let w = code[pc]; let op = num_floor(w / 67108864) % 64;
        let rd = num_floor(w / 2097152) % 32;
        let ra = num_floor(w / 65536) % 32;
        let rb = num_floor(w / 2048) % 32;
        let next = pc + 1;
        if op == 14 {
            let base = 0; if ra != 0 { base = r[ra]; }
            r[rd] = base + _sx16(w % 65536);
        } else if op == 31 {
            let xo = num_floor(w / 2) % 1024;
            if xo == 266 { r[rd] = r[ra] + r[rb]; }
            else if xo == 40 { r[rd] = r[rb] - r[ra]; }
            else if xo == 235 { r[rd] = r[ra] * r[rb]; }
            else { throw "powerpc_run: unmodeled extended opcode " + str(xo); }
        } else if op == 11 {
            cr0eq = r[ra] == _sx16(w % 65536);
        } else if op == 16 {
            let bo = num_floor(w / 2097152) % 32; let bi = num_floor(w / 65536) % 32;
            if bo != 4 or bi != 2 { throw "powerpc_run: only canonical bne is modeled"; }
            let disp = w % 65536; if disp >= 32768 { disp = disp - 65536; }
            if not cr0eq { next = pc + num_floor(disp / 4); }
        } else if op == 17 {
            if r[0] != 1 { throw "powerpc_run: unmodeled syscall " + str(r[0]); }
            result = r[3]; halted = true;
        } else { throw "powerpc_run: unmodeled primary opcode " + str(op); }
        pc = next;
    }
    if not halted { if steps >= 1000000 { fail("instruction budget exceeded"); } fail("ran off the end without sc exit"); }
    let status = result % 256; if status < 0 { status = status + 256; } return status;
}

fn eq(got, want, m) { if got != want { fail(m + ": got " + str(got) + " want " + str(want)); } }
fn EXIT() { return [ADDI(0, 0, 1), SC()]; }
fn cat(a, b) { let i = 0; while i < len(b) { push(a, b[i]); i = i + 1; } return a; }

eq(ADDI(3, 0, 42), 945815594, "addi r3,r0,42 = 0x3860002a");
eq(ADD(3, 4, 5), 2086939156, "add r3,r4,r5 = 0x7c642a14");
eq(SC(), 1140850690, "sc = 0x44000002");

eq(powerpc_run(cat([ADDI(3, 0, 42)], EXIT())), 42, "constant exit");
eq(powerpc_run(cat([ADDI(4, 0, 19), ADDI(5, 0, 23), ADD(3, 4, 5)], EXIT())), 42, "add");
eq(powerpc_run(cat([ADDI(4, 0, 50), ADDI(5, 0, 8), SUBF(3, 5, 4)], EXIT())), 42, "subf");
eq(powerpc_run(cat([ADDI(4, 0, 6), ADDI(5, 0, 7), MULLW(3, 4, 5)], EXIT())), 42, "mullw");

let loop = [ADDI(3, 0, 0), ADDI(4, 0, 5), ADD(3, 3, 4), ADDI(4, 4, 0 - 1), CMPWI(4, 0), BNE(0 - 12)];
eq(powerpc_run(cat(loop, EXIT())), 15, "bne loop sum 5..1");

print "emu_powerpc_pass: PPC32 encodings, arithmetic, multiply, branch loop, and syscall exit verified";
