let PPC = import("stdlib:emulator_powerpc32.sapp");

fn value(instructions) {
    let result = PPC.run(PPC.program(instructions));
    if not result.ok { throw result.error; }
    return result.value;
}

assert(PPC.add_immediate(3, 0, 42) == 945815594, "canonical ADDI encoding");
assert(PPC.add(3, 4, 5) == 2086939156, "canonical ADD encoding");
assert(PPC.system_call() == 1140850690, "canonical SC encoding");
assert(value([[PPC.add_immediate(3, 0, 42)], PPC.exit_sequence()]) == 42, "constant exit");
assert(value([[PPC.add_immediate(4, 0, 19)], [PPC.add_immediate(5, 0, 23)],
              [PPC.add(3, 4, 5)], PPC.exit_sequence()]) == 42, "ADD");
assert(value([[PPC.add_immediate(4, 0, 50)], [PPC.add_immediate(5, 0, 8)],
              [PPC.subtract_from(3, 5, 4)], PPC.exit_sequence()]) == 42, "SUBF");
assert(value([[PPC.add_immediate(4, 0, 6)], [PPC.add_immediate(5, 0, 7)],
              [PPC.multiply_low_word(3, 4, 5)], PPC.exit_sequence()]) == 42, "MULLW");
assert(value([[PPC.add_immediate(3, 0, 0)], [PPC.add_immediate(4, 0, 5)],
              [PPC.add(3, 3, 4)], [PPC.add_immediate(4, 4, -1)],
              [PPC.compare_word_immediate(4, 0)], [PPC.branch_not_equal(-12)],
              PPC.exit_sequence()]) == 15, "BNE loop");

assert(not PPC.run([PPC.branch_not_equal(32764)]).ok, "out-of-range branch target fails closed");
assert(not PPC.run([63 * 67108864]).ok, "unknown primary opcode fails closed");
assert(not PPC.run([PPC.branch_not_equal(0)], map{ instruction_budget: 4 }).ok, "loop budget enforced");
assert((try PPC.add(32, 0, 0) catch nil) == nil, "invalid register rejected");
assert((try PPC.branch_not_equal(2) catch nil) == nil, "unaligned branch rejected");

print "emu_powerpc: reusable bounded subset passed encodings, arithmetic, branches, malformed control, and budget checks";
