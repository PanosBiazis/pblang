let SESSION = import("stdlib/native/compile_session.sapp");
let CACHE = import("stdlib/native/artifact_cache.sapp");

fn fail(message) { throw "FAIL native_compile_session: " + message; }
fn uniq(tag) { return "/tmp/pblang_compile_session_" + tag + "_" + str_slice(sha256(str(now_ms()) + str(random_bytes(8))), 0, 16); }
fn cleanup_dir(path) {
    let entries = try fs_listdir(path) catch [];
    let i = 0;
    while i < len(entries) { try fs_remove(path_join(path, entries[i])) catch nil; i = i + 1; }
    try fs_remove(path) catch nil;
}

let root = uniq("cache");
let out1 = uniq("one") + ".elf";
let out2 = uniq("two") + ".elf";
let source = "let s = 0; let i = 0; while i < 1000 { s = s + i; i = i + 1; } print s;";
let state = SESSION.session(map{ cache_root: root });
let result = SESSION.compile_many(state, [
    map{ source: source, output: out1 },
    map{ source: source, output: out2 }
]);
if not result.ok or result.jobs != 2 or result.compiled != 1 or result.misses != 1 or result.hits != 1
    or result.cache_errors != 0 {
    fail("same-session cache reuse");
}
if result.results[0].mode != "compiled" or result.results[1].mode != "cache-hit" { fail("result modes"); }
if not CACHE.valid_x64_elf(fs_read_bytes(out1)) or not CACHE.valid_x64_elf(fs_read_bytes(out2)) {
    fail("published ELF validation");
}

let warm_state = SESSION.session(map{ cache_root: root });
let out3 = uniq("three") + ".elf";
let warm = SESSION.compile_one(warm_state, source, out3);
if not warm.ok or warm.hits != 1 or warm.compiled != 0 { fail("cross-session cache hit"); }

let duplicate = SESSION.compile_many(SESSION.session(map{ cache: false, cache_root: root }), [
    map{ source: source, output: out1 }, map{ source: source + " ", output: out1 }
]);
if duplicate.ok or duplicate.error != "duplicate output path" { fail("duplicate output was not rejected"); }

cleanup_dir(root);
try fs_remove(out1) catch nil; try fs_remove(out2) catch nil; try fs_remove(out3) catch nil;
print "native_compile_session_pass";
