// tests/semantics/browser_enrich_test.sapp — enrichment for stdlib/browser.sapp
// Adds pure HTML-summary helpers: word_count, meta_description, headings.

let B = import("stdlib/browser.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base title/strip_tags still work ─────────────────────────────────────────────
eq(B.title("<title>Hi</title>"), "Hi", "title");

// ── ENRICH: word_count (over stripped text) ──────────────────────────────────────
eq(B.word_count("<p>hello world</p><p>foo</p>"), 3, "word_count");
eq(B.word_count("<p></p>"), 0, "word_count empty");

// ── ENRICH: meta_description ─────────────────────────────────────────────────────
eq(B.meta_description("<meta name=\"description\" content=\"My page\">"), "My page", "meta description");
eq(B.meta_description("<html><head></head></html>"), "", "no meta -> empty");

// ── ENRICH: headings ─────────────────────────────────────────────────────────────
let h = B.headings("<h1>Title</h1><p>x</p><h2>Sub</h2>");
eq(len(h), 2, "two headings");
let found_h1 = false;
let i = 0;
while i < len(h) { if h[i].level == 1 and h[i].text == "Title" { found_h1 = true; } i = i + 1; }
if not found_h1 { fail("h1 'Title' should be found"); }

print "browser_enrich_pass";
