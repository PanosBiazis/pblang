let C = import("stdlib:module_audit_contract.sapp");
let T = import("stdlib:project_text_audit.sapp");
fn expect(ok, label) { if not ok { throw "FAIL module-coverage: " + label; } }
fn module(root) {
    return map{format: "pblang.module_audit.module.v1", root: root, complete: true,
        files_scanned: 1, finding_count: 0, suppressed_count: 0, encoding_degraded_files: 0,
        finding_index_truncated: false, findings: [], counts_kind: map{}, counts_severity: map{},
        counts_role: map{}, counts_role_severity: map{}, counts_role_kind_severity: map{}};
}
fn rejected(modules, roots, error) {
    let r = T.combine_module_reports("fixture", modules, map{requested_roots: roots});
    expect(not r.ok and not r.complete and r.error == error
        and not map_has(r, "quality_gate") and not map_has(r, "modules"), "fixed rejection without partial aggregate");
}
rejected([module("a"), module("a")], ["a", "b"], "duplicate module root");
rejected([module("a"), module("private-root-marker")], ["a", "b"], "module root was not requested");
rejected([module("a")], ["a", "a"], "duplicate module root");
rejected([module("a"), module("a")], [], "duplicate module root");
for value in [nil, false, 1, [], map{}, "", "bad\x00root"] {
    rejected([], [value], "invalid module root");
    expect(C.roots_error([value]) != "", "root shape rejected without coercion");
    let producer = T.audit_modules("fixture", ["tests/fixtures/module_audit/tools", value]);
    expect(not producer.ok and producer.error == "invalid module root" and not map_has(producer, "modules"), "producer admits all roots before scanning");
}
let long = ""; for i 4096 { long = long + "x"; }
expect(C.roots_error([long]) == "", "inclusive root length");
rejected([], [long + "x"], "invalid module root");
let roots = []; let modules = [];
for i 256 { array_push(roots, "module" + str(i)); array_push(modules, module("module" + str(i))); }
let maximum = T.combine_module_reports("fixture", modules, map{requested_roots: roots});
expect(maximum.ok and maximum.complete and maximum.files_scanned == 256, "inclusive unique module bound");
array_push(roots, "extra"); expect(C.roots_error(roots) != "", "root count bound");
for invalid in [nil, false, "private-roots-marker", map{}] { expect(C.roots_error(invalid) != "", "outer shape bounded"); }
let ordered = [module("b"), module("a")]; let requested = ["a", "b"];
let before = json_stringify(map{modules: ordered, requested: requested});
let full = T.combine_module_reports("fixture", ordered, map{requested_roots: requested});
expect(full.ok and full.complete and full.quality_gate.passed, "reordered full coverage valid");
expect(json_stringify(map{modules: ordered, requested: requested}) == before, "inputs unchanged");
for subset in [[], [module("b")]] {
    let r = T.combine_module_reports("fixture", subset, map{requested_roots: requested});
    expect(r.ok and not r.complete and not r.aggregate.passed and not r.quality_gate.passed, "partial coverage stays resumable and blocked");
}
let incomplete = module("b"); incomplete.complete = false;
let r = T.combine_module_reports("fixture", [module("a"), incomplete], map{requested_roots: requested});
expect(r.ok and not r.complete and not r.quality_gate.passed, "full identity does not override incomplete scan");
expect(T.combine_module_reports("fixture", []).quality_gate.passed, "legacy empty coverage convention");
expect(T.combine_module_reports("fixture", [module("a"), module("b")]).complete, "legacy unique set without requested roots");
rejected([module("./a")], ["a"], "module root was not requested");
expect(C.roots_error(["a", "A", "./a", "../a", "δοκιμή"]) == "", "pure identity is exact and does not access filesystem");
let mutable = module("a"); expect(C.coverage_error([mutable], ["a"]) == "", "initial identity valid");
mutable.root = "private-root-marker";
rejected([mutable], ["a"], "module root was not requested");
mutable.snapshot_sha256 = "unchanged-marker";
let snapshot = T.verify_module_snapshot(mutable, map{requested_roots: ["a"]});
expect(not snapshot.ok and not snapshot.stable and snapshot.error == "invalid module snapshot", "direct snapshot checks requested identity");
let duplicate = T.audit_modules("fixture", ["tests/fixtures/module_audit/tools", "tests/fixtures/module_audit/tools"]);
expect(not duplicate.ok and duplicate.error == "duplicate module root", "producer duplicate rejection");
expect(try { T.combine_module_reports("fixture", [module("a"), module("a")], map{max_high: "bad"}); false } catch true,
    "gate policy retains precedence");
print "module_audit_coverage_pass";
