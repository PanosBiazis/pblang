let S = import("stdlib:secure_file.sapp");
let INV = import("stdlib:project_inventory.sapp");
let LinuxDirFS = import("stdlib:linux_dirfs.sapp");

fn fail(message) { throw "FAIL linux_bounded_enumerator: " + message; }
fn require(value, message) { if not value { fail(message); } }

fn entry_named(entries, name) {
    let i = 0;
    while i < len(entries) {
        if (try entries[i].name catch nil) == name { return entries[i]; }
        i = i + 1;
    }
    return nil;
}

fn entry_names(entries) {
    let names = [];
    for entry in entries {
        if try entry.name_available catch false {
            array_push(names, entry.name);
        }
    }
    return array_sort(names);
}

fn open_and_list(root, maximum) {
    let handle = S.open_bounded_enumerator(root, 60000);
    require(handle.ok and not handle.contains_paths and not handle.contains_descriptors,
        "strict handle is opaque and path-free");
    let result = S.enumerate_bounded(handle, "", maximum);
    require(S.close_bounded_enumerator(handle), "strict handle closes");
    return result;
}

if platform() == "linux" {
    let large_mount_id = "9007199254740993";
    let local_mount_row = large_mount_id
        + " 1 8:1 / /scan rw - ext4 /dev/root rw\n";
    let inspected_mount = LinuxDirFS.inspect_mountinfo_policy(
        local_mount_row, large_mount_id);
    require(inspected_mount.ok and inspected_mount.matched_once
        and inspected_mount.direct_vfs_type_allowlisted
        and not inspected_mount.authorizes_scan
        and not inspected_mount.contains_paths
        and not inspected_mount.contains_mount_identity
        and not inspected_mount.contains_filesystem_type,
        "mount policy preserves split-u64 identity without publishing authorization or mount data");
    for filesystem in ["proc", "sysfs", "devtmpfs", "tmpfs", "overlay",
        "autofs", "nfs4", "cifs", "fuse.portal", "unknownfs"] {
        let row = large_mount_id + " 1 8:1 / /scan rw - "
            + filesystem + " source rw\n";
        let rejected_mount = LinuxDirFS.inspect_mountinfo_policy(row, large_mount_id);
        require(rejected_mount.ok and not rejected_mount.direct_vfs_type_allowlisted
            and not rejected_mount.authorizes_scan,
            "virtual, network, FUSE, overlay, autofs, and unknown filesystems are analysis-only rejects");
    }
    let duplicate_mount_rows = local_mount_row
        + large_mount_id + " 1 8:2 / /other rw - ext4 /dev/other rw\n";
    require(not LinuxDirFS.inspect_mountinfo_policy(
        duplicate_mount_rows, large_mount_id).ok,
        "duplicate mount identities fail closed");
    require(not LinuxDirFS.inspect_mountinfo_policy(
        large_mount_id + " 1 8:1 / /scan rw - ext4 - /dev/root rw\n",
        large_mount_id).ok,
        "duplicate mountinfo separators fail closed");
    require(not LinuxDirFS.inspect_mountinfo_policy(
        large_mount_id + " 1 8:1 / /scan\tbad rw - ext4 /dev/root rw\n",
        large_mount_id).ok,
        "literal mountinfo controls fail closed");
    require(not LinuxDirFS.inspect_mountinfo_policy(
        large_mount_id + " 1 8:1 / /scan\\999 rw - ext4 /dev/root rw\n",
        large_mount_id).ok,
        "unknown mountinfo escape sequences fail closed");
    let too_many_mount_lines = ""; let mount_line_i = 0;
    while mount_line_i < 4097 {
        too_many_mount_lines = too_many_mount_lines + "x\n";
        mount_line_i = mount_line_i + 1;
    }
    require(not LinuxDirFS.inspect_mountinfo_policy(
        too_many_mount_lines, large_mount_id).ok,
        "mountinfo line count is bounded before row parsing");
    let changed_mount_row = large_mount_id
        + " 1 8:1 / /scan ro - ext4 /dev/root ro\n";
    let unchanged_binding = LinuxDirFS.inspect_mountinfo_transition(
        local_mount_row, local_mount_row, large_mount_id);
    let changed_binding = LinuxDirFS.inspect_mountinfo_transition(
        local_mount_row, changed_mount_row, large_mount_id);
    require(unchanged_binding.ok and unchanged_binding.binding_unchanged
        and not unchanged_binding.authorizes_scan
        and changed_binding.ok and not changed_binding.binding_unchanged,
        "pre/post mount policy detects binding drift without authorizing a scan");

    require(LinuxDirFS.abort_bounded_enumeration(map{
        strict_enum_active: true, strict_enum_dir_fd: 1,
        strict_enum_snapshot_fd: 2, strict_enum_child_fd: 3,
        strict_enum_buffer: 1, strict_enum_operation_id: "forged" }),
        "forged public cleanup fields are ignored because resources live in a private registry");
    let frozen_owner = freeze(map{ closed: false, root_fd: 99 });
    let frozen_i = 0;
    while frozen_i < 20 {
        require(not LinuxDirFS.enumerate_bounded(frozen_owner, "", 1).ok,
            "frozen low-level owner fails before private operation publication");
        frozen_i = frozen_i + 1;
    }
    let root = "/tmp/pblang-bounded-enumerator-" +
        str_slice(sha256(base64_encode_bytes(random_bytes(16))), 0, 20);
    let under = root + "/under";
    let exact = root + "/exact";
    let over = root + "/over";
    let tokens = root + "/tree";
    let stability = tokens + "/stability";
    fs_mkdirs(under); fs_mkdirs(exact); fs_mkdirs(over);
    fs_mkdirs(tokens + "/child"); fs_mkdirs(tokens + "/root");
    fs_mkdirs(tokens + "/discarded");
    fs_mkdirs(tokens + "/Api_Key_Private");
    fs_mkdirs(tokens + "/ACCESS_KEY_Backup");
    fs_mkdirs(stability + "/sub");
    fs_write(under + "/a", "a");
    fs_write(exact + "/a", "a"); fs_write(exact + "/b", "b");
    fs_write(over + "/a", "a"); fs_write(over + "/b", "b"); fs_write(over + "/c", "c");
    fs_write(tokens + "/file", "f"); fs_write(tokens + "/child/nested", "n");
    fs_write(tokens + "/root/marker", "r");
    fs_write(tokens + "/Api_Key_Private/hidden", "x");
    fs_write(tokens + "/ACCESS_KEY_Backup/hidden", "x");
    fs_write(stability + "/a", "a"); fs_write(stability + "/sub/one", "1");

    let admitted_handle = S.open_admitted_scan_enumerator(root, 60000);
    require(admitted_handle.ok and admitted_handle.held_root_vfs_policy_admitted
        and not admitted_handle.mount_binding_rechecked
        and admitted_handle.direct_vfs_type_allowlisted
        and not admitted_handle.backing_storage_locality_verified
        and not admitted_handle.trusted_mount_namespace_verified
        and not admitted_handle.procfs_authenticity_verified
        and not admitted_handle.corroborating_source
        and not admitted_handle.contains_mount_identity
        and not admitted_handle.contains_filesystem_type
        and not admitted_handle.authorizes_idea_admission,
        "admitted scan handle derives a private direct-VFS policy binding from its held descriptor");
    let admitted_recheck = S.recheck_admitted_scan_enumerator(admitted_handle);
    require(admitted_recheck.ok and admitted_recheck.mount_binding_rechecked
        and not admitted_recheck.backing_storage_locality_verified
        and not admitted_recheck.trusted_mount_namespace_verified
        and not admitted_recheck.procfs_authenticity_verified
        and not admitted_recheck.corroborating_source,
        "unchanged held mount binding rechecks before scan handle closure");
    require(S.close_bounded_enumerator(admitted_handle),
        "admitted scan handle closes after recheck");
    for clean_round in range(0, 8) {
        let clean_handle = S.open_admitted_scan_enumerator(root, 60000);
        let clean_page = if clean_handle.ok {
            S.enumerate_bounded(clean_handle, "", 1)
        } else { map{ ok: false } };
        let clean_recheck = if clean_page.ok {
            S.recheck_admitted_scan_enumerator(clean_handle)
        } else { map{ ok: false } };
        let clean_closed = if clean_handle.ok {
            S.close_bounded_enumerator(clean_handle)
        } else { false };
        let clean_status = LinuxDirFS.scan_mount_admission_status();
        require(clean_page.ok and clean_recheck.ok and clean_closed
            and clean_status.ready and not clean_status.process_admission_poisoned,
            "clean admitted enumerate/recheck/close cycle remains reusable: "
                + str(clean_round));
    }
    for rejection_round in range(0, 20) {
        for rejected_root in ["/proc", "/dev"] {
            let rejected_handle = S.open_admitted_scan_enumerator(rejected_root, 60000);
            require(not rejected_handle.ok and rejected_handle.handle_invalidated
                and rejected_handle.enumerator_closed
                and not rejected_handle.held_root_vfs_policy_admitted,
                "virtual device/process roots are rejected without leaking admission capacity");
        }
    }
    let post_rejection_handle = S.open_admitted_scan_enumerator(root, 60000);
    require(post_rejection_handle.ok
        and S.recheck_admitted_scan_enumerator(post_rejection_handle).ok
        and S.close_bounded_enumerator(post_rejection_handle),
        "repeated rejected roots leave enough capacity for a later admitted root");
    let forged_handle = S.open_bounded_enumerator(root, 60000);
    forged_handle.held_root_vfs_policy_admitted = true;
    forged_handle.mount_binding_rechecked = true;
    let forged_recheck = S.recheck_admitted_scan_enumerator(forged_handle);
    require(not forged_recheck.ok and forged_recheck.handle_invalidated
        and forged_recheck.enumerator_closed,
        "caller-forged admission fields cannot upgrade a generic enumerator");

    let under_result = open_and_list(under, 2);
    require(under_result.ok and under_result.complete and not under_result.truncated
        and under_result.entry_count == 1,
        "N-1 entries are complete without truncation");
    let exact_result = open_and_list(exact, 2);
    require(exact_result.ok and exact_result.complete and not exact_result.truncated
        and exact_result.entry_count == 2,
        "exactly N entries require an EOF proof and are not truncated");
    let over_result = open_and_list(over, 2);
    require(over_result.ok and not over_result.complete and over_result.truncated
        and over_result.entry_count == 2 and over_result.observed_at_least == 3,
        "N+1 sentinel proves truncation while returning at most N entries");

    let failure_handle = S.open_bounded_enumerator(tokens, 60000);
    let failure_i = 0;
    while failure_i < 20 {
        require(not S.enumerate_bounded(failure_handle, "../invalid", 8).ok,
            "failed low-level operation rejects traversal");
        failure_i = failure_i + 1;
    }
    require(S.enumerate_bounded(failure_handle, "", 8).ok,
        "more than the operation registry capacity of failures leaves no stale slots");
    require(S.close_bounded_enumerator(failure_handle), "failure cleanup handle closes");

    let handle = S.open_bounded_enumerator(tokens, 60000);
    let top = S.enumerate_bounded(handle, "", 8);
    let child = entry_named(top.entries, "child");
    let file = entry_named(top.entries, "file");
    let literal_root = entry_named(top.entries, "root");
    let discarded = entry_named(top.entries, "discarded");
    require(top.ok and top.complete and child != nil and child.kind == "directory"
        and child.traversable and len(child.traversal_token) == 64
        and file != nil and file.kind == "file" and not file.traversable
        and file.traversal_token == "",
        "quad-state entries distinguish traversable directories from files");
    require(literal_root != nil and literal_root.traversable,
        "a literal top-level directory named root is not confused with the root sentinel");
    let root_page = S.enumerate_bounded(handle, "root", 8, literal_root.traversal_token);
    require(root_page.ok and entry_named(root_page.entries, "marker").kind == "file",
        "the literal root directory remains addressable");
    require(not S.enumerate_bounded(handle, "root", 8, child.traversal_token).ok,
        "a traversal token is bound to its expected relative path");
    let other_handle = S.open_bounded_enumerator(tokens, 60000);
    require(other_handle.ok and S.enumerate_bounded(other_handle, "", 8).ok
        and not S.enumerate_bounded(other_handle, "child", 8, child.traversal_token).ok,
        "a traversal token cannot cross opaque enumerator handles");
    require(S.close_bounded_enumerator(other_handle), "cross-handle test closes");
    let child_page = S.enumerate_bounded(handle, "child", 8, child.traversal_token);
    require(child_page.ok and child_page.complete and entry_named(child_page.entries, "nested").kind == "file",
        "one-use root-bound token authorizes the expected held child identity");
    require(not S.enumerate_bounded(handle, "child", 8, child.traversal_token).ok,
        "a consumed traversal token cannot be replayed");
    require(S.discard_bounded_traversal(handle, discarded.traversal_token)
        and not S.enumerate_bounded(handle, "discarded", 8, discarded.traversal_token).ok,
        "discarded directory capabilities cannot be consumed later");
    require(S.close_bounded_enumerator(handle), "token test handle closes");

    let restart_handle = S.open_bounded_enumerator(stability, 60000);
    let before_restart = S.enumerate_bounded(restart_handle, "", 8);
    let old_sub = entry_named(before_restart.entries, "sub");
    require(before_restart.ok and before_restart.complete and old_sub != nil
        and old_sub.traversable,
        "restart fixture obtains one generation-bound subtree token");
    let old_token = old_sub.traversal_token;
    let pending_restart = S.restart_bounded_enumerator(restart_handle);
    require(not pending_restart.ok
        and not (try pending_restart.handle_invalidated catch false),
        "restart rejects a pending traversal token without invalidating its owner");
    let old_subtree = S.enumerate_bounded(restart_handle, "sub", 8, old_token);
    require(old_subtree.ok and old_subtree.complete
        and entry_named(old_subtree.entries, "one") != nil,
        "the rejected restart leaves the pending token usable and consumes it once");
    let restarted = S.restart_bounded_enumerator(restart_handle);
    require(restarted.ok and restarted.generation_advanced
        and restarted.previous_tokens_invalidated
        and not restarted.snapshot_consistent
        and not restarted.namespace_stability_verified,
        "held-root generation restarts without claiming a namespace snapshot");
    require((try restarted.generation catch nil) == nil
        and (try restarted.token catch nil) == nil,
        "generation restart exposes neither generation secret nor token");
    require(try { fs_rename(stability + "/a", stability + "/b"); true } catch false,
        "same-count rename mutation succeeds between observations");
    require(try { fs_rename(stability + "/sub", stability + "/old-sub"); true } catch false,
        "subtree replacement moves the first observed inode");
    fs_mkdirs(stability + "/sub"); fs_write(stability + "/sub/two", "2");
    fs_remove(stability + "/old-sub/one"); fs_remove(stability + "/old-sub");
    require(not S.enumerate_bounded(restart_handle, "sub", 8, old_token).ok,
        "a discarded prior-generation token cannot replay after subtree replacement");
    let after_restart = S.enumerate_bounded(restart_handle, "", 8);
    let fresh_sub = entry_named(after_restart.entries, "sub");
    require(after_restart.ok and after_restart.complete
        and entry_names(before_restart.entries) != entry_names(after_restart.entries),
        "same-count different-name observations remain distinguishable");
    require(fresh_sub != nil, "fresh observation contains the replacement subtree");
    require(fresh_sub.kind == "directory",
        "fresh replacement subtree retains the directory quad-state");
    require(fresh_sub.traversable,
        "fresh replacement subtree publishes a traversal capability");
    require(fresh_sub.traversal_token != old_token,
        "fresh subtree receives a different generation-bound token");
    require(S.enumerate_bounded(restart_handle, "sub", 8,
        fresh_sub.traversal_token).ok,
        "fresh generation token traverses the replacement subtree");
    let repeated_restart = S.restart_bounded_enumerator(restart_handle);
    require(not repeated_restart.ok
        and not (try repeated_restart.handle_invalidated catch false),
        "one held enumerator permits exactly two cumulative observation generations");
    require(S.close_bounded_enumerator(restart_handle),
        "generation restart fixture closes its held root");

    let strict_inventory = INV.inventory_strict_root(tokens, map{
        max_depth: 3, max_entries: 32, max_children_per_dir: 8,
        include_files: true, include_dirs: true, max_runtime_ms: 30000 });
    require(strict_inventory.ok and strict_inventory.complete
        and strict_inventory.directory_enumerator_allocation_bounded
        and strict_inventory.stay_on_device_enforced
        and strict_inventory.entry_kind_tristate_enforced
        and not strict_inventory.hard_heap_bound
        and not strict_inventory.snapshot_consistent
        and len(strict_inventory.roots) == 0 and not strict_inventory.contains_absolute_paths
        and not strict_inventory.contains_traversal_tokens,
        "strict inventory consumes typed entries while keeping the approved root private");
    let strict_json = json_stringify(strict_inventory);
    require(not str_contains(strict_json, tokens) and not str_contains(strict_json, "mnt_id")
        and not str_contains(strict_json, "\"traversal_token\":")
        and not str_contains(strict_json, "root_digest")
        and not str_contains(strict_json, "Api_Key_Private")
        and not str_contains(strict_json, "ACCESS_KEY_Backup")
        and strict_inventory.skipped_count >= 2,
        "strict inventory strips roots, identities, tokens, and ordinary sensitive names");

    let stable_inventory = INV.inventory_strict_root_stability(tokens, map{
        max_depth: 3, max_entries: 32, max_children_per_dir: 8,
        include_files: true, include_dirs: true, max_runtime_ms: 5000 });
    let stable_json = json_stringify(stable_inventory);
    require(stable_inventory.ok and stable_inventory.complete
        and stable_inventory.passes_completed == 2
        and stable_inventory.two_pass_stability_observed
        and not stable_inventory.namespace_change_observed
        and not stable_inventory.observation_inconclusive
        and not stable_inventory.snapshot_consistent
        and not stable_inventory.namespace_stability_verified
        and not stable_inventory.hard_heap_bound
        and stable_inventory.enumerator_closed,
        "two complete matching observations remain explicitly weaker than a snapshot");
    require(not str_contains(stable_json, "_private_observation_keys")
        and not str_contains(stable_json, tokens)
        and not str_contains(stable_json, "Api_Key_Private")
        and not str_contains(stable_json, "ACCESS_KEY_Backup"),
        "two-pass stability report strips private comparison keys and sensitive names");
    let admitted_inventory = INV.inventory_admitted_root_stability(tokens, map{
        max_depth: 3, max_entries: 32, max_children_per_dir: 8,
        include_files: true, include_dirs: true, max_runtime_ms: 5000 });
    let admitted_json = json_stringify(admitted_inventory);
    require(admitted_inventory.ok and admitted_inventory.complete
        and admitted_inventory.two_pass_stability_observed
        and admitted_inventory.held_root_vfs_policy_admitted
        and admitted_inventory.mount_binding_rechecked
        and admitted_inventory.direct_vfs_type_allowlisted
        and admitted_inventory.direct_virtual_vfs_type_rejected
        and admitted_inventory.direct_network_vfs_type_rejected
        and admitted_inventory.direct_fuse_vfs_type_rejected
        and admitted_inventory.unknown_vfs_type_rejected
        and not admitted_inventory.backing_storage_locality_verified
        and not admitted_inventory.trusted_mount_namespace_verified
        and not admitted_inventory.procfs_authenticity_verified
        and not admitted_inventory.corroborating_source
        and not admitted_inventory.authorizes_idea_admission,
        "admitted two-pass inventory binds the same direct-VFS policy row before and after observation");
    require(not str_contains(admitted_json, "\"mount_id\":")
        and not str_contains(admitted_json, "\"filesystem\":")
        and not str_contains(admitted_json, "/dev/")
        and not str_contains(admitted_json, "ext4")
        and not str_contains(admitted_json, tokens),
        "admitted report exposes no root, mount identity, source, or filesystem type");
    let excessive_stability = INV.inventory_strict_root_stability(tokens, map{
        max_depth: 9, max_entries: 32, max_children_per_dir: 8,
        include_files: true, include_dirs: true, max_runtime_ms: 5000 });
    require(not excessive_stability.ok and excessive_stability.passes_completed == 0,
        "two-pass observation enforces its tighter dedicated depth ceiling");

    require(proc_spawn_wait("/usr/bin/mkfifo", [tokens + "/Api_Key_Error"]).exit_code == 0,
        "sensitive error-state fixture created after the complete baseline scan");
    let error_inventory = INV.inventory_strict_root(tokens, map{
        max_depth: 3, max_entries: 32, max_children_per_dir: 8,
        include_files: true, include_dirs: true, max_runtime_ms: 30000 });
    let error_json = json_stringify(error_inventory);
    require(error_inventory.ok and not error_inventory.complete
        and error_inventory.skipped_count >= 3
        and not str_contains(error_json, "Api_Key_Error"),
        "sensitive error entries preserve incomplete evidence without leaking their basename");

    let sensitive = INV.inventory_strict_root(tokens + "/.ssh", map{
        max_depth: 1, max_entries: 8, max_children_per_dir: 8,
        include_files: true, include_dirs: true, max_runtime_ms: 30000 });
    require(not sensitive.ok and not str_contains(json_stringify(sensitive), tokens),
        "sensitive roots are rejected without echoing or digesting their absolute path");
    let sensitive_api = INV.inventory_strict_root(tokens + "/Api_Key_Root", map{
        max_depth: 1, max_entries: 8, max_children_per_dir: 8,
        include_files: true, include_dirs: true, max_runtime_ms: 30000 });
    require(not sensitive_api.ok and not str_contains(json_stringify(sensitive_api), "Api_Key_Root"),
        "mixed-case API-key roots are rejected without echoing their name");
    require((try INV.idea_admission catch nil) == nil,
        "callers cannot submit forged inventory booleans to the private idea gate");

    let root_result = open_and_list("/", 4096);
    let proc_entry = entry_named(root_result.entries, "proc");
    require(root_result.ok and proc_entry != nil and proc_entry.kind == "error"
        and proc_entry.error_code == "mount-boundary" and not proc_entry.traversable,
        "stay_on_device rejects the procfs mount before traversal");
    let root_json = json_stringify(root_result);
    require(not str_contains(root_json, "mnt_id") and not str_contains(root_json, "inode"),
        "raw mount and inode identity never enters enumeration output");

    let proc_result = open_and_list("/proc", 4096);
    let self_entry = entry_named(proc_result.entries, "self");
    require(proc_result.ok and self_entry != nil and self_entry.kind == "symlink"
        and not self_entry.traversable,
        "symlinks are a distinct non-traversable state");
    let dev_result = open_and_list("/dev", 4096);
    let null_entry = entry_named(dev_result.entries, "null");
    require(dev_result.ok and null_entry != nil and null_entry.kind == "error"
        and null_entry.error_code == "unsupported-or-unknown-type",
        "special files fail closed into the error state");

    fs_remove(tokens + "/child/nested"); fs_remove(tokens + "/child");
    fs_remove(tokens + "/root/marker"); fs_remove(tokens + "/root");
    fs_remove(tokens + "/discarded");
    fs_remove(tokens + "/Api_Key_Private/hidden"); fs_remove(tokens + "/Api_Key_Private");
    fs_remove(tokens + "/ACCESS_KEY_Backup/hidden"); fs_remove(tokens + "/ACCESS_KEY_Backup");
    fs_remove(stability + "/sub/two"); fs_remove(stability + "/sub");
    fs_remove(stability + "/b"); fs_remove(stability);
    fs_remove(tokens + "/Api_Key_Error");
    fs_remove(tokens + "/file"); fs_remove(tokens);
    fs_remove(over + "/a"); fs_remove(over + "/b"); fs_remove(over + "/c"); fs_remove(over);
    fs_remove(exact + "/a"); fs_remove(exact + "/b"); fs_remove(exact);
    fs_remove(under + "/a"); fs_remove(under); fs_remove(root);
}

let status = S.bounded_enumerator_status();
require(not status.snapshot_consistent and not status.hard_heap_enforced
    and not status.vm_typed_ffi_enforced and not status.hostile_code_ready
    and status.generation_restart and status.two_pass_observation_supported
    and status.held_root_vfs_policy_admission and status.pre_post_mount_binding
    and not status.production_ready,
    "strict functional slice does not claim unresolved runtime guarantees");
print "linux_bounded_enumerator_pass";
