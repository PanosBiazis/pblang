// tests/semantics/systems_log_enrich_test.sapp — enrichment for systems.sapp + log.sapp

let S = import("stdlib/systems.sapp");
let L = import("stdlib/log.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn arreq(a, b, m) {
    if len(a) != len(b) { fail(m + " len " + str(a)); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " [" + str(i) + "] " + str(a)); } i = i + 1; }
}

// ── systems: 32-bit LE pack/unpack round-trip ─────────────────────────────────────
let packed = S.pack_u32_le(305419896);   // 0x12345678
arreq(packed, [120, 86, 52, 18], "pack_u32_le LE order");
eq(S.unpack_u32_le(packed), 305419896, "unpack_u32_le round-trip");
eq(S.unpack_u32_le(S.pack_u32_le(0)), 0, "zero round-trip");
eq(S.unpack_u32_le(S.pack_u32_le(4294967295)), 4294967295, "max u32 round-trip");

// ── systems: buffer concat / slice ────────────────────────────────────────────────
arreq(S.buffer_concat([1, 2], [3, 4]), [1, 2, 3, 4], "concat");
arreq(S.buffer_slice([10, 20, 30, 40], 1, 3), [20, 30], "slice [1,3)");

// ── log: level introspection ────────────────────────────────────────────────────────
L.set_level("warn");
eq(L.get_level(), "warn", "get_level");
if not L.is_enabled("error") { fail("error enabled at warn threshold"); }
if not L.is_enabled("warn") { fail("warn enabled at warn threshold"); }
if L.is_enabled("info") { fail("info NOT enabled at warn threshold"); }
if L.is_enabled("debug") { fail("debug NOT enabled at warn threshold"); }
arreq(L.levels(), ["trace", "debug", "info", "warn", "error", "fatal"], "levels list");
L.set_level("info");   // restore default

print "systems_log_enrich_pass";
