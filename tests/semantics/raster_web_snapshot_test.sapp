let R = import("stdlib:raster_png.sapp");
let W = import("stdlib:web_snapshot.sapp");
let PNG = import("stdlib:png.sapp");

fn expect(value, message) { if not value { throw "FAIL raster snapshot: " + message; } }
fn rejected(work) { return try { work(); false } catch true; }

let surface = R.create(64, 48, [245,247,250]);
R.fill_rect(surface, 2, 2, 20, 12, [32,113,189]);
R.stroke_rect(surface, 1, 1, 24, 16, [20,30,40], 1);
R.draw_text(surface, 4, 24, "PB", [10,20,30], 2);
let encoded = R.encode(surface);
let decoded = PNG.decode(encoded, map{ max_pixels: 4096, max_output_width: 64, max_output_height: 48 });
expect(decoded.ok and decoded.width == 64 and decoded.height == 48 and decoded.color_type == 2 and
       decoded.crc_verified and decoded.checksum_verified, "RGB drawing round-trips through strict PNG validation");

let shot = W.render_html("https://example.test/docs", "<html><head><title>Docs</title></head>" +
    "<body><h1>PBLang</h1><p>Safe native snapshot.</p><a href='/next'>Next</a></body></html>",
    map{ width: 320, height: 200 });
let verified = PNG.decode(shot.png, map{ max_pixels: 64000, max_output_width: 320, max_output_height: 200 });
expect(shot.ok and verified.ok and shot.rendered_boxes >= 2 and not shot.scripts_executed and
       not shot.subresources_fetched and not shot.css_dom_pixel_parity,
    "browser HTML becomes an honest bounded script-free PNG snapshot");
expect(rejected(fn() { W.render_html("https://example.test", str_repeat("x", 1048577)); }) and
       rejected(fn() { W.render_html("https://example.test", "ok", map{ width: 2000 }); }),
    "HTML and geometry bounds fail closed");

print "raster_web_snapshot_pass";
