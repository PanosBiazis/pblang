let L=import("stdlib:lesson_bundle.sapp");let A=import("stdlib:lesson_allocation.sapp");let T=import("stdlib:text_document.sapp");let doc=T.create("Session");doc.blocks=[map{kind:"heading",text:"Intro"},map{kind:"paragraph",text:"Explain"},map{kind:"heading",text:"Practice"},map{kind:"paragraph",text:"Try"},map{kind:"heading",text:"Review"},map{kind:"paragraph",text:"Recall"}];let bundle=L.create(doc,"2026-09-27");let before=L.encode(bundle);let r=A.create(bundle,10,[1,2,1]);assert(r.document.cells==[["Label","Weight","Minutes"],["Intro","1","3"],["Practice","2","5"],["Review","1","2"]],"explicit lesson weighting");r.document.cells[1][0]="changed";assert(L.encode(bundle)==before,"lesson and progress remain untouched");assert((try A.create(bundle,10,[1,2]) catch nil)==nil,"one weight per section");assert(A.create(bundle,1,[0,1,0]).document.cells[1][2]=="0","no implicit minimum time");print "lesson_allocation_pass";
