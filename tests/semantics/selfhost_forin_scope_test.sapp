let F = import("stdlib:compiler/selfhost_frontend.sapp");
let V = import("stdlib:compiler/vm.sapp");
fn expect(ok, message) { if not ok { throw "FAIL forin-scope: " + message; } }
fn run(source) {
    let compiled = F.frontend_compile(source);
    expect(compiled.ok and len(compiled.diagnostics) == 0, "fixture passes checked compilation");
    let plain = V.run_bounded(compiled.chunk, map{ max_steps: 5000, max_frames: 12 });
    let optimized = F.frontend_run_bounded(source, map{ max_steps: 5000, max_frames: 12 });
    expect(optimized.ok and plain.globals.result == optimized.globals.result, "plain and optimized values agree");
    return plain.globals.result;
}
expect(run("let x = 99; for x in [1, 2] { } let result = x;") == 99, "outer name restored after iteration");
expect(run("let x = 99; for x in [] { } let result = x;") == 99, "empty iteration cannot capture outer name");
expect(run("fn f(x) { for x in [1, 2] { } return x; } let result = f(99);") == 99, "local parameter restored");
expect(run("let x = [1, 2]; let seen = []; for x in x { array_push(seen, x); } let result = [x, seen];") == [[1, 2], [1, 2]], "iterable resolved before binding");
expect(run("let __forin_arr = [3, 4]; let seen = []; for x in __forin_arr { array_push(seen, x); } let result = [__forin_arr, seen];") == [[3, 4], [3, 4]], "temporary cannot capture iterable");
expect(run("let __forin_arr = 8; let __forin_idx = 9; let seen = []; for x in [1, 2] { array_push(seen, [x, __forin_arr, __forin_idx]); } let result = seen;") == [[1, 8, 9], [2, 8, 9]], "body helper-like names remain user values");
expect(run("let __forin_idx = 99; let seen = []; for __forin_idx in [1, 2] { array_push(seen, __forin_idx); } let result = [__forin_idx, seen];") == [99, [1, 2]], "helper-like binder remains legal");
expect(run("let x = 99; let seen = []; for x in [1, 2] { for x in [3] { array_push(seen, x); } array_push(seen, x); } let result = [x, seen];") == [99, [3, 1, 3, 2]], "nested loop restores enclosing binder");
expect(run("let x = 99; let seen = []; for x in [1, 2, 3] { if x == 1 { continue; } array_push(seen, x); if x == 2 { break; } } let result = [x, seen];") == [99, [2]], "continue increments and break restores scope");
expect(run("let x = 99; let seen = []; for x in [1] { array_push(seen, x); } for x in [2] { array_push(seen, x); } let result = [x, seen];") == [99, [1, 2]], "sibling loops have separate bindings");
expect(run("let π = 99; let seen = []; for π in [1, 2] { array_push(seen, π); } let result = [π, seen];") == [99, [1, 2]], "Unicode binder follows lexical rules");
expect(run("fn collect(x) { let out = []; for x in [1, 2] { array_push(out, fn() { return x; }); } return [out[0](), out[1](), x]; } let result = collect(99);") == [1, 2, 99], "by-value closure capture remains stable");
expect(run("let seen = []; fn values() { array_push(seen, 7); return [1, 2]; } for x in values() { array_push(seen, x); } let result = seen;") == [7, 1, 2], "iterable evaluated once");
expect(run("fn f() { for x in [7, 8] { return x; } return 0; } let result = f();") == 7, "return leaves enclosing function");
let missing = F.frontend_compile("for x in [1] { } let result = x;");
expect(not missing.ok, "loop binding is not an outer declaration");
print "selfhost_forin_scope_pass";
