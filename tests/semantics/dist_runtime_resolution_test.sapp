let DIST = import("stdlib:dist.sapp");

fn fail(message) { throw "FAIL dist_runtime_resolution: " + message; }

let runtime = DIST.runtime_binary();
if type(runtime.path) != "string" or runtime.path == "" { fail("runtime path"); }
let version = proc_spawn_wait(runtime.path, ["--version"]);
if version.exit_code != 0 or not str_contains(version.stdout, "pblang 0.5.7") {
    fail("resolved runtime is not the active PBLang compiler");
}
if import("stdlib:os.sapp").platform() == "linux" and runtime.source != "current-process-image"
    and runtime.source != "PBLANG_BIN" {
    fail("Linux build should not prefer a PATH installation");
}

print "dist_runtime_resolution_pass";
