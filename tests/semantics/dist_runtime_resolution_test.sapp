let DIST = import("stdlib:dist.sapp");
let MANIFEST = import("stdlib:manifest_validate.sapp");

fn fail(message) { throw "FAIL dist_runtime_resolution: " + message; }

let runtime = DIST.runtime_binary();
if type(runtime.path) != "string" or runtime.path == "" { fail("runtime path"); }
let manifest = MANIFEST.validate_manifest_file("pblang.toml");
if not manifest.ok { fail("canonical manifest must be valid"); }
let expected_version = "pblang " + manifest.package.exact_version_identity;
if manifest.package.release_channel != "alpha" or manifest.package.display_version != "0.6.0 [alpha]" {
    fail("compiler channel must remain separate from exact runtime identity");
}
let version = proc_spawn_wait(runtime.path, ["--version"]);
if version.exit_code != 0 or str_trim(version.stdout) != expected_version {
    fail("resolved runtime is not the active PBLang compiler");
}
if import("stdlib:os.sapp").platform() == "linux" and runtime.source != "current-process-image"
    and runtime.source != "PBLANG_BIN" {
    fail("Linux build should not prefer a PATH installation");
}
if import("stdlib:os.sapp").platform() == "linux" and runtime.source == "current-process-image" {
    if runtime.path == "/proc/self/exe" or not str_starts_with(runtime.path, "/proc/")
        or not str_ends_with(runtime.path, "/exe") {
        fail("Linux runtime path must remain bound to the parent process identity");
    }
    let readlink = if fs_exists("/usr/bin/readlink") { "/usr/bin/readlink" } else { "/bin/readlink" };
    let child = proc_spawn_wait(readlink, ["-f", "--", runtime.path]);
    if child.exit_code != 0 or not str_contains(child.stdout, "pblang")
        or str_contains(child.stdout, "/readlink") {
        fail("runtime identity changed when resolved by a child process");
    }
}

print "dist_runtime_resolution_pass";
