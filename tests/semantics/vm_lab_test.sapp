let V = import("stdlib:vm_lab.sapp");

fn base_guest() {
    return map{id:"debian13-x64",kind:"libvirt-ssh",os:"debian",arch:"x86_64",
        evidence:"native-vm",enabled:true,suites:["portable-smoke","emulator-matrix"],
        domain:"pblang-debian13",host:"pblang-debian13.local",pinned_address:"192.168.122.50",
        user:"pblang-test",transfer_user:"pblang-xfer",control_credential_id:"debian-control",
        transfer_credential_id:"debian-transfer",port:22,
        domain_uuid:"01234567-89ab-cdef-0123-456789abcdef",
        disk_path:"/var/lib/pblang-vm-lab/guests/debian13.qcow2",
        mac:"52:54:00:12:34:50",network_uuid:"11111111-2222-3333-4444-555555555555",
        baseline_id:"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"};
}

fn manifest(guest) { return map{format:V.FORMAT,
    execution:map{sequential:true,private_network:true,restore_policy:"shutdown-if-started"},
    guests:[guest]}; }

let checked=V.validate_manifest(manifest(base_guest()));
assert(checked.ok and len(checked.guests)==1,"valid dedicated VM manifest");
let planned=V.plan(manifest(base_guest()));
assert(planned.ok and planned.sequential and planned.parallel_guests==1,"matrix is sequential");
assert(planned.targets[0].stages[1]=="start-if-stopped","libvirt lifecycle plan");

let injected=base_guest(); injected.domain="good;touch /tmp/bad";
assert(not V.validate_manifest(manifest(injected)).ok,"domain injection rejected");
let public_ip=base_guest(); public_ip.pinned_address="8.8.8.8";
assert(not V.validate_manifest(manifest(public_ip)).ok,"public guest address rejected");
let duplicate=base_guest();
let dup_manifest=manifest(base_guest()); array_push(dup_manifest.guests,duplicate);
assert(not V.validate_manifest(dup_manifest).ok,"duplicate guest rejected");
let parallel=manifest(base_guest()); parallel.execution.sequential=false;
assert(not V.validate_manifest(parallel).ok,"parallel guests rejected");
let unknown=base_guest(); unknown.suites=["arbitrary-command"];
assert(not V.validate_manifest(manifest(unknown)).ok,"unknown suite rejected");

let android=map{id:"android-api34",kind:"android-emulator",os:"android",arch:"x86_64",
    evidence:"simulator",enabled:true,suites:["android-runtime"],avd:"PBRemote_API_34"};
let ap=V.plan(manifest(android));
assert(ap.ok and ap.targets[0].stages[1]=="start-emulator-if-needed","Android plan");

let ios=map{id:"ios-hosted",kind:"hosted-runner",os:"ios",arch:"arm64",
    evidence:"simulator",enabled:true,suites:["ios-simulator"],runner:"macos-15"};
assert(V.plan(manifest(ios)).ok,"hosted iOS simulator plan");

let pi=map{id:"raspios-arm64",kind:"qemu-reference",os:"raspberry-pi-os",arch:"arm64",
    evidence:"userspace-emulation",enabled:true,suites:["raspberry-userspace"],oracle:"qemu-aarch64"};
assert(V.plan(manifest(pi)).ok,"Raspberry Pi OS userspace plan");

let digest="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
let report=V.report(map{source_revision:"abc123",source_state_sha256:digest,
    source_bundle_sha256:digest},base_guest(),[
        map{id:"portable-smoke",ok:true,duration_ms:10,report_sha256:digest},
        map{id:"emulator-matrix",ok:false,duration_ms:20,report_sha256:digest}
    ]);
assert(not report.ok and report.passed==1 and report.total==2,"report aggregates failures");
assert(regex_match(report.report_sha256,"^[0-9a-f]{64}$"),"report is content addressed");
assert(not map_has(report.target,"user") and not map_has(report.target,"pinned_address"),
    "report excludes connection identity and address");

print "vm_lab_pass";
