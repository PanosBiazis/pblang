// tests/semantics/crypto_advanced_binary_test.sapp — encrypt/decrypt must
// round-trip binary-safely. The old XOR cipher stored bytes >=128 via
// strfromcharcode (codepoint, not byte) and re-read them with char-indexed
// str_slice + byte-indexed strcharcodeat, desyncing on any non-trivial input.
import "stdlib:crypto_advanced.sapp";

let key = "correct horse battery staple";

let messages = [
    "",
    "hello world",
    "the quick brown fox jumps over the lazy dog 0123456789",
    "héllo wörld — café ☕ 日本語",
    "binary-ish: \t\n line two \" quote"
];

for i in 0 to len(messages) - 1 {
    let msg = messages[i];
    let ct = crypto_advanced.encrypt(msg, key);
    let pt = crypto_advanced.decrypt(ct, key);
    if pt != msg {
        throw "FAIL encrypt/decrypt round-trip for message " + str(i) + ": got '" + str(pt) + "'";
    }
}

// Wrong key must fail authentication, not silently return garbage.
let ct2 = crypto_advanced.encrypt("secret", key);
let bad = crypto_advanced.decrypt(ct2, "wrong key");
if is_string(bad) and bad == "secret" {
    throw "FAIL decrypt with wrong key returned the plaintext";
}

// password_hash is deterministic and password_verify agrees.
let h = crypto_advanced.password_hash("pw", "salt", 50);
if crypto_advanced.password_hash("pw", "salt", 50) != h {
    throw "FAIL password_hash not deterministic";
}
if crypto_advanced.password_verify("pw", "salt", crypto_advanced.password_hash("pw", "salt")) == false {
    throw "FAIL password_verify rejected a correct password";
}

print "crypto_advanced_binary_pass";
