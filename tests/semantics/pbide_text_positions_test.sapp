let T=import("editors/ide/pbide_text.sapp");
fn rejects(f) { let failed=false; try { f(); } catch { failed=true; } return failed; }
// Known scalar sequence covers every UTF-8 width boundary, noncharacters,
// combining marks and ZWJ. Core strings may contain NUL/CR; Web rejects those.
let codes=[0,10,13,127,128,2047,2048,55295,57344,65535,65536,1114111,769,8205,128512,10];
let text="";
for code in codes { text=text+strfromcharcode(code); }
let units=0; let line=1; let column=1;
for offset in range(0,len(codes)+1) {
    assert(T.utf16_from_scalar(text,offset)==units,"known scalar to UTF-16 boundary");
    assert(T.scalar_from_utf16(text,units)==offset,"known UTF-16 to scalar boundary");
    let state=T.selection(text,offset,len(codes)); let info=T.status(state);
    assert(info.line==line and info.column==column and info.lines==3
        and info.characters==len(codes) and info.selected==len(codes)-offset,
        "status at every scalar boundary");
    let browser=T.to_browser(state); let restored=T.from_browser(text,browser.start,browser.end);
    assert(restored.start==offset and restored.end==len(codes),"selected range roundtrip");
    assert(state.text==text and state.start==offset,"input remains unchanged");
    if offset<len(codes) {
        let code=codes[offset];
        if code>65535 {
            assert(rejects(fn(){T.scalar_from_utf16(text,units+1);}),"every split surrogate rejected");
            units=units+2;
        } else { units=units+1; }
        if code==10 { line=line+1; column=1; } else { column=column+1; }
    }
}
for invalid in [-1,0.5,"0",nil] {
    assert(rejects(fn(){T.scalar_from_utf16(text,invalid);}),"bad UTF-16 index");
    assert(rejects(fn(){T.utf16_from_scalar(text,invalid);}),"bad scalar index");
}
assert(rejects(fn(){T.scalar_from_utf16(text,units+1);}),"past final UTF-16 unit");
assert(rejects(fn(){T.utf16_from_scalar(text,len(codes)+1);}),"past final scalar");
assert(T.scalar_from_utf16("",0)==0 and T.utf16_from_scalar("",0)==0,"empty offsets");
assert(rejects(fn(){T.scalar_from_utf16("",1);}),"empty overflow");
let maximum=str_repeat("😀",4096);
assert(T.utf16_from_scalar(maximum,2048)==4096,"maximum byte buffer midpoint");
assert(T.scalar_from_utf16(maximum,8192)==4096,"maximum byte buffer endpoint");
assert(rejects(fn(){T.scalar_from_utf16(maximum,8191);}),"maximum buffer split surrogate");
let large=T.status(T.selection(maximum,4096,4096));
assert(large.characters==4096 and large.column==4097,"maximum emoji status");
for overflow in [str_repeat("a",8193),maximum+"a"] {
    assert(rejects(fn(){T.scalar_from_utf16(overflow,0);}),"UTF-16 validation before early return");
    assert(rejects(fn(){T.utf16_from_scalar(overflow,0);}),"scalar validation before early return");
    assert(rejects(fn(){T.status(map{text:overflow,start:0,end:0});}),"status validates whole input");
}
print "pbide_text_positions_pass";
