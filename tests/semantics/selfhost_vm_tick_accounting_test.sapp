// Each tick must observe the current arrays, retain error priority and charge
// the same step even when admission fails. No limits or cleanup are disabled.
let V=import("stdlib:compiler/vm.sapp");
fn runtime(options) {
    let r=V.runtime_limits(options);
    r.steps=0;r.peak_frames=0;r.peak_stack=0;r.peak_locals=0;r.peak_output=0;
    r.tripped=false;r.reason="";return r;
}
fn inst(op,arg){return map{op:op,operand:arg};}
fn execute(instructions,constants,r,locals) {
    let e=V.execution_context();
    let result=try map{value:V.exec(map{instructions:instructions,constants:constants},locals,map{},[],[],r,0,e)} catch nil;
    V.close_execution(e);return result;
}
let r=runtime(map{});let locals=[];
assert(execute([inst(0,0),inst(17,3),inst(16,3),inst(11,0),inst(0,1),inst(17,3)], [7,nil],r,locals)!=nil,"success");
assert(r.steps==6 and r.peak_stack==1 and r.peak_locals==4,"fresh lengths after slot growth");
assert(locals==[nil,nil,nil,nil],"nil cleanup still executes");
r=runtime(map{});
assert(execute([inst(0,0),inst(0,0),inst(11,0),inst(11,0),inst(0,0),inst(11,0)],[9],r,[])!=nil,"stack varies");
assert(r.steps==6 and r.peak_stack==2 and r.peak_locals==0,"stack peak preserved after pop");
r=runtime(map{max_stack:1});
assert(execute([inst(0,0),inst(0,0),inst(11,0)],[9],r,[])==nil,"stack rejected before pop");
assert(r.steps==3 and r.reason=="stack limit exceeded" and r.peak_stack==1,"stack failure accounting");
r=runtime(map{max_steps:2,max_stack:1});
assert(execute([inst(0,0),inst(0,0),inst(11,0)],[9],r,[])==nil,"step rejected first");
assert(r.steps==2 and r.reason=="step limit exceeded","step priority");
r=runtime(map{max_value_items:2});
assert(execute([inst(0,0),inst(11,0)],[[1,2,3]],r,[])==nil,"oversized value cannot be popped past guard");
assert(r.steps==2 and r.peak_stack==1 and r.reason=="value size limit exceeded","value accounting");
r=runtime(map{max_locals:2});locals=[];
assert(execute([inst(0,0),inst(17,2)],[9],r,locals)==nil,"local admission before write");
assert(r.steps==2 and r.reason=="locals limit exceeded" and locals==[],"local failure state");
r=runtime(map{});r.tripped=true;r.reason="prior failure";
assert(execute([inst(0,0)],[9],r,[])==nil and r.steps==0 and r.reason=="prior failure","sticky refusal");
// A normal throw enters catch using the same budget. Exhaustion at catch entry
// or on return to the parent cannot reset the counter or become a guest value.
let body=map{instructions:[inst(0,0),inst(40,0)],constants:["guest error"]};
let handler=map{instructions:[inst(0,0),inst(19,0)],constants:[42]};
let tc=map{try_chunk:body,catch_chunk:handler};
r=runtime(map{});
let caught=execute([inst(35,0),inst(19,0)],[tc],r,[]);
assert(caught.value==42 and r.steps==6 and r.peak_frames==2,"shared catch budget");
for budget in [3,5] {
    r=runtime(map{max_steps:budget});
    assert(execute([inst(35,0),inst(19,0)],[tc],r,[])==nil,"catch exhaustion propagates");
    assert(r.steps==budget and r.tripped and r.reason=="step limit exceeded","catch never resets budget");
}
print "selfhost_vm_tick_accounting_pass";
