// tests/semantics/prob_stdlib_test.sapp
// Probability layer: combinatorics, gamma/erf, and 5 distributions (pure pblang).
let prob = import("stdlib:prob.sapp");

fn _close(a, b, eps) {
    let d = a - b;
    if d < 0 { d = 0 - d; }
    return d <= eps;
}
fn _ck(name, a, b, eps) {
    if _close(a, b, eps) == false {
        throw "FAIL " + name + ": expected ~" + str(b) + " got " + str(a);
    }
}

// --- combinatorics (exact) ---
if prob.factorial(0) != 1 { throw "FAIL factorial(0)"; }
if prob.factorial(5) != 120 { throw "FAIL factorial(5)"; }
if prob.perm(5, 2) != 20 { throw "FAIL perm(5,2)"; }
if prob.comb(5, 2) != 10 { throw "FAIL comb(5,2)"; }
if prob.comb(10, 3) != 120 { throw "FAIL comb(10,3)"; }
if prob.comb(10, 0) != 1 { throw "FAIL comb(10,0)"; }
if prob.comb(10, 10) != 1 { throw "FAIL comb(10,10)"; }

// --- gamma: gamma(n) = (n-1)!, gamma(1/2) = sqrt(pi) ---
_ck("gamma(5)", prob.gamma(5), 24, 0.00001);
_ck("gamma(1/2)", prob.gamma(0.5), 1.7724538509, 0.000001);

// --- erf ---
_ck("erf(0)", prob.erf(0), 0, 0.0000001);
_ck("erf(big)", prob.erf(5), 1, 0.0000001);
_ck("erf(-1)", prob.erf(-1), -0.8427007929, 0.000001);

// --- normal ---
_ck("normal_pdf(0)", prob.normal_pdf(0, 0, 1), 0.3989422804, 0.000001);
_ck("normal_cdf(mu)", prob.normal_cdf(0, 0, 1), 0.5, 0.0000001);
_ck("normal_cdf(1.96)", prob.normal_cdf(1.96, 0, 1), 0.975, 0.0001);

// --- binomial ---
_ck("binom_pmf(2;5,.5)", prob.binomial_pmf(2, 5, 0.5), 0.3125, 0.0000001);
_ck("binom_cdf(5;5,.5)", prob.binomial_cdf(5, 5, 0.5), 1, 0.0000001);
_ck("binom_cdf(2;5,.5)", prob.binomial_cdf(2, 5, 0.5), 0.5, 0.0000001);

// --- poisson ---
_ck("poisson_pmf(0;2)", prob.poisson_pmf(0, 2), 0.1353352832, 0.000001);
_ck("poisson_pmf(2;2)", prob.poisson_pmf(2, 2), 0.2706705664, 0.000001);
_ck("poisson_cdf(big;2)", prob.poisson_cdf(40, 2), 1, 0.000001);

// --- uniform ---
_ck("uniform_pdf", prob.uniform_pdf(0.5, 0, 1), 1, 0.0000001);
_ck("uniform_cdf", prob.uniform_cdf(0.5, 0, 1), 0.5, 0.0000001);
if prob.uniform_pdf(2, 0, 1) != 0 { throw "FAIL uniform_pdf out of support"; }

// --- exponential ---
_ck("exp_pdf(0;1)", prob.exp_pdf(0, 1), 1, 0.0000001);
_ck("exp_cdf(ln2;1)", prob.exp_cdf(0.6931471806, 1), 0.5, 0.000001);

// --- Shannon entropy (bits) ---
_ck("entropy(fair coin)", prob.entropy([0.5, 0.5]), 1, 0.0000001);
_ck("entropy(certain)", prob.entropy([1.0]), 0, 0.0000001);
_ck("entropy(fair die)", prob.entropy([0.25, 0.25, 0.25, 0.25]), 2, 0.0000001);

// --- quantiles (inverse CDF) ---
_ck("normal_ppf(.5)", prob.normal_ppf(0.5, 0, 1), 0, 0.0000001);
_ck("normal_ppf(.975)", prob.normal_ppf(0.975, 0, 1), 1.959964, 0.0001);
_ck("normal_ppf(.025)", prob.normal_ppf(0.025, 0, 1), -1.959964, 0.0001);
// round-trip: cdf(ppf(p)) == p
_ck("normal ppf/cdf roundtrip", prob.normal_cdf(prob.normal_ppf(0.3, 0, 1), 0, 1), 0.3, 0.0001);
// scaled quantile
_ck("normal_ppf(.975;100,15)", prob.normal_ppf(0.975, 100, 15), 129.3995, 0.01);
_ck("exp_ppf(.5;1)", prob.exp_ppf(0.5, 1), 0.6931471806, 0.000001);
_ck("uniform_ppf(.5;10,20)", prob.uniform_ppf(0.5, 10, 20), 15, 0.0000001);

// --- Value-at-Risk and Expected Shortfall (parametric, normal returns) ---
_ck("VaR(0,1,.95)", prob.value_at_risk(0, 1, 0.95), 1.6448536, 0.001);
_ck("VaR(0,1,.99)", prob.value_at_risk(0, 1, 0.99), 2.3263479, 0.001);
// CVaR (expected shortfall) is always >= VaR
let var95 = prob.value_at_risk(0, 1, 0.95);
let cvar95 = prob.conditional_value_at_risk(0, 1, 0.95);
_ck("CVaR(0,1,.95)", cvar95, 2.0627128, 0.001);
if cvar95 <= var95 { throw "FAIL CVaR must exceed VaR"; }
// a real portfolio: mu=0.01, sigma=0.05, 95% -> 1.6449*0.05 - 0.01
_ck("VaR portfolio", prob.value_at_risk(0.01, 0.05, 0.95), 0.0722427, 0.0001);

// --- special functions: incomplete gamma/beta + t & chi-square CDFs ---
// regularized lower incomplete gamma: P(1,x) = 1 - e^-x
_ck("gamma_inc_p(1,1)", prob.gamma_inc_p(1, 1), 0.6321206, 0.000001);
// chi-square CDF against the classic 0.95 critical values
_ck("chi2_cdf(3.841;1)", prob.chi2_cdf(3.8414588, 1), 0.95, 0.0001);
_ck("chi2_cdf(5.991;2)", prob.chi2_cdf(5.9914645, 2), 0.95, 0.0001);
_ck("chi2_cdf(0;3)", prob.chi2_cdf(0, 3), 0, 0.0000001);
// regularized incomplete beta: I_0.5(0.5,0.5) = 0.5
_ck("beta_inc(.5;.5,.5)", prob.beta_inc(0.5, 0.5, 0.5), 0.5, 0.000001);
// Student t CDF: F(0)=0.5; df=1 (Cauchy) F(1)=0.75; large df -> normal
_ck("t_cdf(0;5)", prob.t_cdf(0, 5), 0.5, 0.0000001);
_ck("t_cdf(1;1)", prob.t_cdf(1, 1), 0.75, 0.000001);
_ck("t_cdf(1.96;big)", prob.t_cdf(1.959964, 100000), 0.975, 0.0001);

// --- F-distribution CDF (for ANOVA) ---
// F_cdf(27;2,6): x=54/60=0.9, I_0.9(1,3)=1-(1-.9)^3=0.999
_ck("F_cdf(27;2,6)", prob.f_cdf(27, 2, 6), 0.999, 0.0001);
_ck("F_cdf(0;2,6)", prob.f_cdf(0, 2, 6), 0, 0.0000001);

// --- t quantile (inverse t CDF, via bisection) ---
// 95% two-tailed critical value for df=4 is 2.776445
_ck("t_ppf(.975;4)", prob.t_ppf(0.975, 4), 2.776445, 0.0001);
_ck("t_ppf(.5;10)", prob.t_ppf(0.5, 10), 0, 0.0001);
// round-trip: t_cdf(t_ppf(p)) == p
_ck("t ppf/cdf roundtrip", prob.t_cdf(prob.t_ppf(0.8, 7), 7), 0.8, 0.0001);

print "prob_stdlib_pass";
