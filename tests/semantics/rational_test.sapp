// tests/semantics/rational_test.sapp — exact arbitrary-precision rationals.

// Construction: fraction string, decimal string, integer string, num/den pair.
if str(rational("1/3")) != "1/3" { throw "FAIL rational frac parse"; }
if str(rational("0.1")) != "1/10" { throw "FAIL rational decimal parse: " + str(rational("0.1")); }
if str(rational(3, 4)) != "3/4" { throw "FAIL rational parts"; }
if type(rational("1/3")) != "rational" { throw "FAIL rational type"; }

// Exactness — the headline: 0.1 + 0.2 is exactly 3/10, not 0.30000000000000004.
if str(rational("0.1") + rational("0.2")) != "3/10" { throw "FAIL exact decimal add"; }

// Arithmetic (always reduced).
if str(rational("1/3") + rational("1/6")) != "1/2" { throw "FAIL rational add"; }
if str(rational("2/3") * rational("3/4")) != "1/2" { throw "FAIL rational mul"; }
if str(rational("1/2") / rational("1/4")) != "2" { throw "FAIL rational div (-> int)"; }
if str(rational("1/2") - rational("1/2")) != "0" { throw "FAIL rational sub to zero"; }

// A rational that reduces to an integer normalizes to a bigint.
if type(rational("6/3")) != "bigint" { throw "FAIL rational->bigint normalize: " + type(rational("6/3")); }

// Exponentiation with integer exponents (including negative).
if str(rational("2/3") ** 3) != "8/27" { throw "FAIL rational pow"; }
if str(rational("1/2") ** -2) != "4" { throw "FAIL rational negative pow"; }

// Comparisons (exact, and against plain numbers).
if not (rational("1/3") > rational("3/10")) { throw "FAIL rational gt"; }
if not (rational("1/2") == 0.5) { throw "FAIL rational == float"; }
if rational("1/3") == 0.333 { throw "FAIL rational must not equal rounded float"; }

// Interop with bigint: bigint promotes to rational in mixed arithmetic.
if str(bigint(2) + rational("1/2")) != "5/2" { throw "FAIL bigint + rational"; }

print "rational_pass";
