let D=import("stdlib:emulator_diff.sapp");

let same=D.compare_case("arm64-add",42,map{exit_code:12,trap:"none"},
    map{exit_code:12,trap:"none"},["exit_code","trap"]);
assert(same.ok and len(same.differences)==0,"identical snapshots pass");

let changed=D.compare_case("arm64-flags",43,map{exit_code:0,zero_flag:true},
    map{exit_code:1,zero_flag:false},["exit_code","zero_flag"]);
assert(not changed.ok and len(changed.differences)==2,"each state mismatch is retained");

let missing=D.compare_case("arm64-missing",44,map{pc:128},map{},["pc"]);
assert(not missing.ok and missing.differences[0].expected_present
    and not missing.differences[0].actual_present,"missing evidence fails closed");
let both_missing=D.compare_case("arm64-both-missing",45,map{},map{},["pc"]);
assert(not both_missing.ok and len(both_missing.differences)==1
    and not both_missing.differences[0].expected_present
    and not both_missing.differences[0].actual_present
    and both_missing.differences[0].expected==nil
    and both_missing.differences[0].actual==nil,
    "a declared field absent on both sides is missing evidence");
let explicit_nil=D.compare_case("explicit-nil",46,map{pc:nil},map{pc:nil},["pc"]);
assert(explicit_nil.ok,"explicit nil values remain distinct from absent fields");
both_missing.input_sha256=sha256("missing-input");
both_missing.artifact_sha256=sha256("missing-artifact");
both_missing.oracle_exit_code=0;
both_missing.oracle_stdout_sha256=sha256("");
both_missing.oracle_stderr_sha256=sha256("");
let missing_report=D.report(map{backend:"pblang-arm64-v1",oracle:"qemu-aarch64-static",
    platform:"linux",architecture:"arm64",abi:"sysv",source_revision:"test",
    external_execution_claimed:true,
    source_state_sha256:D.campaign_source_state([both_missing])},[both_missing]);
let missing_matrix=D.coverage_matrix([json_parse(json_stringify(missing_report))],
    ["linux-arm64-sysv"]);
assert(not missing_report.ok and missing_report.passed==0
    and not missing_matrix.structurally_complete
    and missing_matrix.missing_coverage_keys==["linux-arm64-sysv"],
    "missing evidence survives report serialization and cannot satisfy coverage");

same.artifact_sha256="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
same.input_sha256=sha256("same-input");
same.oracle_exit_code=12;
same.oracle_stdout_sha256=sha256("");
same.oracle_stderr_sha256=sha256("");
same.duration_ms=5; changed.duration_ms=6;
changed.artifact_path="target/vm-lab/arm64-flags-43.elf";
changed.oracle_exit_code=1;
changed.oracle_stdout_sha256=same.artifact_sha256;
changed.oracle_stderr_sha256=same.artifact_sha256;
let report=D.report(map{backend:"pblang-arm64-v1",oracle:"qemu-aarch64-static",
    platform:"linux",architecture:"arm64",abi:"sysv",source_revision:"test",
    external_execution_claimed:false,
    source_state_sha256:sha256("mixed")},[same,changed]);
assert(not report.ok and report.passed==1 and report.total==2,"suite aggregates all cases");
assert(not report.external_execution_claimed and not report.independent_execution_verified
    and report.structural_only and regex_match(report.report_sha256,"^[0-9a-f]{64}$"),
    "in-process reports do not manufacture an external or independent execution claim");
assert(report.cases[1].artifact_path=="target/vm-lab/arm64-flags-43.elf"
    and report.cases[1].oracle_exit_code==1,"failure diagnostics are retained");

let arm_ok=D.report(map{backend:"pblang-arm64-v1",oracle:"qemu-aarch64-static",
    platform:"linux",architecture:"arm64",abi:"sysv",source_revision:"abc",
    external_execution_claimed:true,
    source_state_sha256:D.campaign_source_state([same])},[same]);
let x86_case=json_parse(json_stringify(same));
x86_case.artifact_sha256=sha256("target-specific-x86-artifact");
let x86_ok=D.report(map{backend:"pblang-x86-v1",oracle:"qemu-x86-static",
    platform:"linux",architecture:"x86_64",abi:"sysv",source_revision:"abc",
    external_execution_claimed:true,
    source_state_sha256:D.campaign_source_state([x86_case])},[x86_case]);
let matrix=D.coverage_matrix([arm_ok,x86_ok],
    ["linux-arm64-sysv","linux-x86_64-sysv"]);
assert(not matrix.ok and not matrix.complete and matrix.structurally_complete
    and matrix.report_count==2 and matrix.digest_reverification
    and matrix.source_state_consistent
    and matrix.source_state_sha256==D.campaign_source_state([same])
    and matrix.independent_execution_required
    and not matrix.independent_execution_verified and matrix.self_reported
    and not matrix.physical_platform_evidence
    and not matrix.full_system_emulation and not matrix.production_ready,
    "coverage matrix permits target-specific artifacts for one shared input campaign");
let incomplete=D.coverage_matrix([arm_ok],
    ["linux-arm64-sysv","linux-x86_64-sysv"]);
assert(not incomplete.ok and not incomplete.complete
    and not incomplete.structurally_complete
    and incomplete.missing_coverage_keys[0]=="linux-x86_64-sysv",
    "missing platform, architecture, and ABI coverage remains explicit");
let legacy_format=json_parse(json_stringify(arm_ok));
legacy_format.format="pblang.emulator-differential.v1";
let legacy_rejected=false;
try { D.coverage_matrix([legacy_format],["linux-arm64-sysv"]); }
catch { legacy_rejected=true; }
assert(legacy_rejected,"legacy v1 reports cannot acquire v2 evidence semantics");
let tampered=json_parse(json_stringify(arm_ok)); tampered.passed=0;
let tamper_rejected=false;
try { D.coverage_matrix([tampered],["linux-arm64-sysv"]); } catch { tamper_rejected=true; }
assert(tamper_rejected,"coverage matrix re-verifies report structure and digest");
let duplicate_rejected=false;
try { D.coverage_matrix([arm_ok,arm_ok],["linux-arm64-sysv"]); } catch { duplicate_rejected=true; }
assert(duplicate_rejected,"duplicate backend/oracle/target evidence fails closed");
let forged=json_parse(json_stringify(arm_ok));
forged.cases[0].ok=false;
let forged_payload=json_parse(json_stringify(forged));
map_remove(forged_payload,"report_sha256");
forged.report_sha256=sha256(json_stringify(forged_payload));
let forged_rejected=false;
try { D.coverage_matrix([forged],["linux-arm64-sysv"]); } catch { forged_rejected=true; }
assert(forged_rejected,"a digest-consistent but internally forged pass count is rejected");
let bad_source=false;
try { D.report(map{backend:"pblang-arm64-v1",oracle:"qemu-aarch64-static",
    platform:"linux",architecture:"arm64",abi:"sysv",source_revision:"abc",
    external_execution_claimed:true,
    source_state_sha256:"caller-claim"},[same]); } catch { bad_source=true; }
assert(bad_source,"source state must be content-addressed even though it is not authenticated here");

fn local_metadata(source_digest) {
    return map{backend:"pblang-arm64-v1",oracle:"local-model",
        platform:"linux",architecture:"arm64",abi:"sysv",source_revision:"test",
        external_execution_claimed:false,source_state_sha256:source_digest};
}

fn rejects_case(row) {
    let rejected=false;
    try { D.report(local_metadata(sha256("invalid-case")),[row]); }
    catch { rejected=true; }
    return rejected;
}

let undeclared=json_parse(json_stringify(same));
undeclared.ok=false;
undeclared.differences=[map{field:"undeclared",expected_present:true,
    actual_present:true,expected:1,actual:2}];
assert(rejects_case(undeclared),"difference fields must belong to the declared field set");

let duplicate_difference=json_parse(json_stringify(same));
duplicate_difference.ok=false;
duplicate_difference.differences=[
    map{field:"exit_code",expected_present:true,actual_present:true,expected:1,actual:2},
    map{field:"exit_code",expected_present:true,actual_present:true,expected:1,actual:3}
];
assert(rejects_case(duplicate_difference),"duplicate difference fields fail closed");

let equal_difference=json_parse(json_stringify(same));
equal_difference.ok=false;
equal_difference.differences=[map{field:"exit_code",expected_present:true,
    actual_present:true,expected:12,actual:12}];
assert(rejects_case(equal_difference),"a difference row must describe a real mismatch");

let inconsistent_absence=json_parse(json_stringify(same));
inconsistent_absence.ok=false;
inconsistent_absence.differences=[map{field:"exit_code",expected_present:false,
    actual_present:true,expected:12,actual:1}];
assert(rejects_case(inconsistent_absence),"absent values must be represented canonically as nil");

let duplicate_case_rejected=false;
try { D.report(local_metadata(sha256("duplicate")),[same,same]); }
catch { duplicate_case_rejected=true; }
assert(duplicate_case_rejected,"duplicate id and seed pairs cannot inflate report totals");

let missing_external=D.compare_case("missing-external",9,map{exit_code:0},
    map{exit_code:0},["exit_code"]);
let missing_external_rejected=false;
try { D.report(map{backend:"pblang-arm64-v1",oracle:"qemu-aarch64-static",
    platform:"linux",architecture:"arm64",abi:"sysv",source_revision:"test",
    external_execution_claimed:true,source_state_sha256:sha256("unbound")},
    [missing_external]); } catch { missing_external_rejected=true; }
assert(missing_external_rejected,"external claims require complete per-case evidence");

let huge_scalar_rejected=false;
try { D.compare_case("huge-scalar",10,map{value:str_repeat("€",1025)},
    map{value:"small"},["value"]); } catch { huge_scalar_rejected=true; }
assert(huge_scalar_rejected,"multibyte scalar strings obey the byte ceiling");
let exact_multibyte=str_repeat("é",512);
let exact_multibyte_case=D.compare_case("exact-multibyte",12,
    map{value:exact_multibyte},map{value:exact_multibyte},["value"]);
assert(exact_multibyte_case.ok,"an exact 1024-byte multibyte scalar is admitted");
let multibyte_overflow_rejected=false;
try { D.compare_case("multibyte-overflow",13,
    map{value:exact_multibyte+"a"},map{value:"small"},["value"]); }
catch { multibyte_overflow_rejected=true; }
assert(multibyte_overflow_rejected,"a 1025-byte multibyte scalar is rejected");
let character_ceiling_rejected=false;
try { D.compare_case("character-ceiling",14,
    map{value:str_repeat("x",4097)},map{value:"small"},["value"]); }
catch { character_ceiling_rejected=true; }
assert(character_ceiling_rejected,"large character counts fail before byte conversion");
let runtime_zero=len([]);
let nonfinite=0.0/runtime_zero;
let nan_rejected=false;
try { D.compare_case("nan",11,map{value:nonfinite},map{value:0},["value"]); }
catch { nan_rejected=true; }
assert(nan_rejected,"non-finite comparison values fail closed");

let bad_duration=json_parse(json_stringify(same));
bad_duration.duration_ms=1.5;
assert(rejects_case(bad_duration),"fractional durations fail closed");
bad_duration.duration_ms=1.0/runtime_zero;
assert(rejects_case(bad_duration),"non-finite durations fail closed");

let long_component=str_repeat("a",40);
let composite_rejected=false;
try { D.report(map{backend:"pblang-arm64-v1",oracle:"local-model",
    platform:long_component,architecture:long_component,abi:long_component,
    source_revision:"test",external_execution_claimed:false,
    source_state_sha256:sha256("long-composite")},[same]); }
catch { composite_rejected=true; }
assert(composite_rejected,"a producer cannot emit an oversized composite coverage key");

let alternate=json_parse(json_stringify(same));
alternate.input_sha256=sha256("alternate-input");
let alternate_report=D.report(map{backend:"pblang-x86-v2",oracle:"qemu-x86-static",
    platform:"linux",architecture:"x86_64",abi:"sysv",source_revision:"abc",
    external_execution_claimed:true,
    source_state_sha256:D.campaign_source_state([alternate])},[alternate]);
let mixed_source_rejected=false;
try { D.coverage_matrix([arm_ok,alternate_report],
    ["linux-arm64-sysv","linux-x86_64-sysv"]); }
catch { mixed_source_rejected=true; }
assert(mixed_source_rejected,"one matrix cannot combine different campaign source states");

let nested=json_parse(json_stringify(arm_ok));
nested.cases[0].ok=false;
nested.cases[0].differences=[map{field:"exit_code",expected_present:true,
    actual_present:true,expected:map{nested:[[[[1]]]]},actual:2}];
let nested_rejected=false;
try { D.coverage_matrix([nested],["linux-arm64-sysv"]); }
catch { nested_rejected=true; }
assert(nested_rejected,"nested hostile case values are rejected before report hashing");

print "emulator_diff_pass";
