// tests/semantics/llm_tokenizer_train_enrich_test.sapp — enrichment for stdlib/llm_tokenizer_train.sapp
// Adds train_char_records (char tokenizer from a corpus) and corpus_char_count.

let tt = import("stdlib/llm_tokenizer_train.sapp");
let tk = import("stdlib/llm_tokenizer.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let recs = [map{ path: "doc1.txt", text: "hello" }, map{ path: "doc2.txt", text: " world" }];

// ── base collect_text still works ────────────────────────────────────────────────
let c = tt.collect_text(recs, 100);
eq(c.text, "hello world", "collect_text concatenates"); eq(c.chars, 11, "collect_text char count");
eq(tt.collect_text(recs, 3).text, "hel", "collect_text truncates to max_chars");

// ── ENRICH: corpus_char_count ────────────────────────────────────────────────────
eq(tt.corpus_char_count(recs), 11, "corpus_char_count");

// ── ENRICH: train_char_records produces a usable char tokenizer ──────────────────
let run = tt.train_char_records(recs, 100);
eq(run.summary.kind, "char", "char tokenizer kind");
if run.summary.vocab_size < 5 { fail("char vocab should include specials + chars"); }
eq(tk.decode(run.tokenizer, tk.encode(run.tokenizer, "hello")), "hello", "char tokenizer round-trips");

// ── BPE training still works ─────────────────────────────────────────────────────
let bpe = tt.train_bpe_records(recs, 64, 1, 100);
eq(bpe.summary.kind, "bpe", "bpe tokenizer kind");

print "llm_tokenizer_train_enrich_pass";
