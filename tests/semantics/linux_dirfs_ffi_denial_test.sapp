let LinuxDirFS = import("stdlib:linux_dirfs.sapp");

fn require(value, message) {
    if not value { throw "FAIL linux_dirfs FFI denial: " + message; }
}

fn denial_probe(libc, omitted) {
    let fixture = path_join(cwd(), "tests/fixtures/linux_dirfs_ffi_denial_probe.sapp");
    let runtime = path_join(cwd(), "target/release/pblang");
    let args = ["run", fixture, "--allow-ffi", "--ffi-lib=" + libc];
    let symbols = ["strdup", "free", "openat", "close", "dup", "calloc",
        "read", "memfd_create", "ftruncate", "lseek", "write", "getdents64",
        "getpid"];
    for symbol in symbols {
        if symbol != omitted { array_push(args, "--ffi-symbol=" + symbol); }
    }
    let child = proc_spawn_wait(runtime, args);
    require(child.exit_code == 0,
        "omitting " + omitted + " must return normally instead of signaling or crashing: "
        + str(try child.stderr catch ""));
    let evidence = try json_parse(str_trim(child.stdout)) catch nil;
    require(type(evidence) == "map"
        and evidence.format == "pblang.linux-dirfs.ffi-denial-probe.v1"
        and evidence.structured_completion and evidence.attempts == 20
        and evidence.failures == 20 and evidence.successes == 0
        and evidence.open_successes + evidence.open_failures == 20
        and evidence.enumerate_successes + evidence.enumerate_failures
            == evidence.open_successes
        and evidence.close_successes + evidence.close_failures
            == evidence.open_successes
        and not evidence.capacity_error,
        "omitting " + omitted + " must fail closed without capacity or cleanup leakage");
    require(evidence.cleanup_failures == 0 and evidence.invalidated_results == 0,
        "denied symbols must fail before an unverified cleanup state is acquired");
    if omitted == "calloc" {
        require(evidence.open_successes == 20 and evidence.open_failures == 0
            and evidence.enumerate_failures == 20
            and evidence.enumerate_successes == 0
            and evidence.close_successes == 20 and evidence.close_failures == 0,
            "omitting calloc must reach bounded enumeration and close every root");
    } else {
        require(evidence.open_successes == 0 and evidence.open_failures == 20
            and evidence.enumerate_failures == 0
            and evidence.enumerate_successes == 0
            and evidence.close_successes == 0 and evidence.close_failures == 0,
            "omitting " + omitted + " must fail before descriptor or allocation acquisition");
        if omitted == "free" or omitted == "close" {
            require(evidence.last_error_code == "native-cleanup-authority-unavailable",
                "omitting " + omitted + " must be rejected by cleanup preflight");
        } else {
            require(evidence.last_error_code == "",
                "omitting strdup must remain distinct from cleanup preflight rejection");
        }
    }
}

fn cleanup_poison_probe(libc, mode) {
    let fixture = path_join(cwd(),
        "tests/fixtures/linux_dirfs_mount_cleanup_poison_probe.sapp");
    let runtime = path_join(cwd(), "target/release/pblang");
    let args = ["run", fixture, "--allow-ffi", "--ffi-lib=" + libc];
    for symbol in ["strdup", "free", "openat", "close", "dup", "calloc",
        "read", "memfd_create", "ftruncate", "lseek", "write",
        "getdents64", "getpid"] {
        array_push(args, "--ffi-symbol=" + symbol);
    }
    array_push(args, "--"); array_push(args, mode);
    let child = proc_spawn_wait(runtime, args);
    require(child.exit_code == 0,
        "mount cleanup poison probe must return normally: "
            + str(try child.stderr catch ""));
    let evidence = try json_parse(str_trim(child.stdout)) catch nil;
    require(type(evidence) == "map"
        and evidence.format == "pblang.linux-dirfs.mount-cleanup-poison-probe.v1"
        and evidence.mode == mode
        and evidence.initially_ready and evidence.injection_verified
        and evidence.cleanup_failed and evidence.registry_cleared
        and evidence.process_admission_poisoned
        and evidence.later_admission_denied
        and evidence.later_admission_not_started
        and evidence.later_enumerator_closed
        and evidence.injection_error_code == "scan-mount-cleanup-poisoned"
        and evidence.admission_error_code == "scan-mount-cleanup-poisoned"
        and not evidence.authorizes_scan,
        mode + " ambiguity must clear operation state and deny later admission before acquisition");
}

if platform() == "linux" {
    let status = LinuxDirFS.available();
    if status.library_ready and type(try status.libc catch nil) == "string" {
        for omitted in ["strdup", "calloc", "free", "close"] {
            denial_probe(status.libc, omitted);
        }
        cleanup_poison_probe(status.libc, "abort-resource");
        cleanup_poison_probe(status.libc, "incoming-cleanup");
    } else {
        print "linux_dirfs_ffi_denial_skip: libc unavailable";
    }
}

print "linux_dirfs_ffi_denial_pass";
