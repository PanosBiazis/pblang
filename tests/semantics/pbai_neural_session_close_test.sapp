// One bounded fixture in baseline/fixed modes; no physical memory claim.
let AI=import("stdlib/pbai.sapp");let N=import("stdlib:pbai_neural_adapter.sapp");
let R=import("stdlib:resource_scope.sapp");let bound=AI.neural_specialist_bind(N);
let fixed=env_get("PBAI_SESSION_LIFETIME_PHASE")!="baseline";
fn rejects(f){return try {f();false} catch true;}
fn release(closer,trace){return fn(){trace.calls=trace.calls+1;trace.value=closer();return map{ok:true,value:trace.value};};}
fn use(handle,mode,trace,fixed){return fn(scope){
 if fixed {scope.defer(release(handle.close,trace));}
 if mode=="bad_predict" {handle.predict([]);}
 if mode=="overlap_evaluate" {handle.evaluate([map{x:[0],y:4}]);}
 if mode=="manual_close" and fixed {assert(handle.close(),"early close");}
 return map{ok:true,value:true};
};}
assert(rejects(fn(){throw "calibration";}) and not rejects(fn(){return 1;}),"calibrated observer");
let training=[map{x:[0],y:4}];let validation=[map{x:[7,0],y:4}];let test=[map{x:[6,0],y:4}];
let input_text=json_stringify([training,validation,test]);let cycle=[];push(cycle,cycle);
let active=N.session(training,validation);let active_text=json_stringify(active.predict([6,0]));
let routes=[map{name:"direct",create:N.session},map{name:"facade",create:AI.neural_specialist_session},map{name:"bound",create:bound.session}];
let rows=[];
for route in routes {for phase in ["candidate","evaluated","promoted","rolled-back","rejected"] {
 let handle=route.create(training,validation);let exported=[handle.status(),handle.predict([6,0])];
 if phase=="rejected" {
  let report=handle.evaluate([map{x:[6,0],y:exported[1].token}]);assert(not report.passed,"real quality rejection");push(exported,report);
 }else {if phase!="candidate" {
  let report=handle.evaluate(test);assert(report.passed,"fixture passes existing quality gate");push(exported,report);
  if phase=="promoted" or phase=="rolled-back" {push(exported,handle.promote());push(exported,handle.predict([6,0]));}
  if phase=="rolled-back" {push(exported,handle.rollback());}
 }}
 assert(handle.status().phase==phase,"actual reachable phase");push(exported,handle.status());push(exported,handle.predict([6,0]));
 let output=json_stringify(exported);
 let status=handle.status;let predict=handle.predict;let evaluate=handle.evaluate;let promote=handle.promote;let rollback=handle.rollback;
 assert(map_has(handle,"close")==fixed,"additive close operation");
 if fixed {assert(handle.close(),"first close in every phase");}
 let status_closed=rejects(status);let prediction_closed=rejects(fn(){predict([6,0]);});
 assert(status_closed==fixed and prediction_closed==fixed,"saved original methods observed before diagnostic cleanup");
 if fixed {
  assert(rejects(fn(){evaluate(test);}) and rejects(promote) and rejects(rollback),"all saved operations reject after close");
  assert(not handle.close(),"second close is a no-op");let closer=handle.close;
  for bad in [nil,[],cycle,"synthetic-private-input"] {assert(rejects(fn(){predict(bad);}) and rejects(fn(){evaluate(bad);}),"closed methods reject malformed/cyclic inputs");}
  handle.phase="candidate";handle.close=fn(){return true;};
  assert(rejects(status) and rejects(fn(){predict([6,0]);}),"public edits cannot reopen private state");
  if closer() {throw "public edits revived the saved closer";}
  exported[0].phase="forged";assert(rejects(status),"export mutation cannot reopen state");exported[0].phase="candidate";
 }
 assert(json_stringify(exported)==output,"all exported results survive close byte for byte");
 assert(json_stringify(active.predict([6,0]))==active_text,"independent caller session stays usable");
 push(rows,map{route:route.name,phase:phase,output_digest:sha256(output),closed:status_closed and prediction_closed});
}}
let scopes=[];
for route in routes {for mode in ["success","bad_predict","overlap_evaluate","manual_close"] {
 let handle=route.create(training,validation);let saved=handle.predict;let status=handle.status;let trace=map{calls:0,value:nil};
 let result=R.with_scope(use(handle,mode,trace,fixed));let failed=mode=="bad_predict" or mode=="overlap_evaluate";
 assert(result.ok!=failed and result.cleanup_ok and result.body_status==(if failed {"exception"} else {"returned"}),"scope preserves real failure result");
 assert(trace.calls==(if fixed {1} else {0}) and result.cleanups_attempted==trace.calls,"exactly one registered cleanup");
 let closed=rejects(fn(){saved([6,0]);});assert(closed==fixed and rejects(status)==fixed,"scope retires captured methods");
 if fixed {assert(trace.value==(mode!="manual_close") and not handle.close(),"manual close plus cleanup is idempotent");}
 assert(json_stringify(active.predict([6,0]))==active_text,"caller state survives failed use");
 push(scopes,map{route:route.name,mode:mode,closed:closed,cleanup_calls:trace.calls,body_status:result.body_status});
}}
assert(json_stringify([training,validation,test])==input_text,"caller datasets unchanged");
if fixed {assert(active.close(),"independent caller cleanup");}
assert(len(rows)==15 and len(scopes)==12,"bounded phase and failure coverage");
print json_stringify(map{format:"pbai.session-lifetime.v1",phase:if fixed {"fixed"} else {"baseline"},
 cases:27,rows:rows,scopes:scopes,active_preserved:true,physical_memory_release_verified:false});
