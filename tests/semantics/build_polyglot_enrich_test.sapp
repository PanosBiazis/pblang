// tests/semantics/build_polyglot_enrich_test.sapp — enrichment for build.sapp + polyglot.sapp

let B = import("stdlib/build.sapp");
let PG = import("stdlib/polyglot.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn contains(arr, v) { let i = 0; while i < len(arr) { if arr[i] == v { return true; } i = i + 1; } return false; }

// ── build.arch ──────────────────────────────────────────────────────────────────────
eq(B.arch(), "x86_64", "arch from target triple");

// ── polyglot language registry (pure) ────────────────────────────────────────────────
let all = PG.all_languages();
if not contains(all, "python") { fail("python supported"); }
if not contains(all, "rust") { fail("rust supported"); }
if PG.language_count() < 30 { fail("expected many languages, got " + str(PG.language_count())); }
if not PG.is_supported("python") { fail("is_supported python"); }
if not PG.is_supported("rust") { fail("is_supported rust"); }
if PG.is_supported("notalang_xyz") { fail("unknown lang not supported"); }

print "build_polyglot_enrich_pass";
