// tests/semantics/datetime_enrich2_test.sapp — wave 2 for stdlib/datetime.sapp

let DT = import("stdlib/datetime.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── is_leap_year ────────────────────────────────────────────────────────────────────
if not DT.is_leap_year(2000) { fail("2000 leap (div 400)"); }
if DT.is_leap_year(1900) { fail("1900 not leap (div 100 not 400)"); }
if not DT.is_leap_year(2004) { fail("2004 leap"); }
if DT.is_leap_year(2001) { fail("2001 not leap"); }

// ── days_in_month ────────────────────────────────────────────────────────────────────
eq(DT.days_in_month(2000, 2), 29, "Feb 2000 leap");
eq(DT.days_in_month(1900, 2), 28, "Feb 1900");
eq(DT.days_in_month(2021, 2), 28, "Feb 2021");
eq(DT.days_in_month(2021, 4), 30, "Apr");
eq(DT.days_in_month(2021, 1), 31, "Jan");
eq(DT.days_in_month(2021, 12), 31, "Dec");

// ── add_* (unix seconds) ──────────────────────────────────────────────────────────
eq(DT.add_days(0, 1), 86400, "add 1 day");
eq(DT.add_hours(0, 2), 7200, "add 2 hours");
eq(DT.add_minutes(0, 3), 180, "add 3 minutes");
eq(DT.add_seconds(10, 5), 15, "add seconds");

// ── days_between ─────────────────────────────────────────────────────────────────────
eq(DT.days_between(0, 86400 * 5), 5, "5 days apart");
eq(DT.days_between(100, 100), 0, "same -> 0");

print "datetime_enrich2_pass";
