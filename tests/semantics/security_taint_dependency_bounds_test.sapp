let D=import("stdlib:security_dependency_analysis.sapp");
fn expect(ok,label) {if not ok {throw "FAIL taint-dependency-bounds: "+label;}}
// In-memory entry source, no fixture files created and no source code executed.
fn analyze(source,mode,policy=nil) {
    return D.analyze_entry("taint-bound-fixture.sapp",map{
        entry_source:source,security_mode:mode,security:policy});
}
for mode in ["protect","strict","audit"] {
    let truncated=analyze("let value=env_get(\"INPUT\");\nhttp_get(value);\nfs_write(value,\"fixed\");",
        mode,map{max_taint_findings:1});
    expect(truncated.ok and not truncated.passed and not truncated.semantic_complete,
        "lost taint evidence blocks every mode");
    expect(truncated.modules[0].taint.truncated and truncated.whole_program_taint.truncated,
        "both source and linked finding caps exercised");
    let malformed=analyze("let value=;",mode);
    expect(malformed.ok and not malformed.passed and malformed.parser_incomplete_count==1,
        "parser failure cannot become success in protect mode");
    let bad_policy=analyze("let value=1;",mode,map{taint_sources:"invalid"});
    expect(not bad_policy.passed,"taint configuration failure blocks");
    for name in ["max_taint_findings","max_taint_steps","max_call_expansions"] {
        for value in [parse_number("NaN"),parse_number("inf"),0,100.5,"bad-limit-marker"] {
            let policy=map{};policy[name]=value;
            let invalid=analyze("let value=1;",mode,policy);
            expect(not invalid.ok and not invalid.passed,"invalid nested limit rejected before traversal");
            expect(not str_contains(json_stringify(invalid),"bad-limit-marker"),"invalid limit privacy");
        }
    }
}
let top=D.analyze_entry("taint-bound-fixture.sapp",map{
    entry_source:"let value=1;",security_mode:"protect",max_taint_steps:100.5});
expect(not top.ok and not top.passed,"top-level limits share admission");
let clean=analyze("let value=1;","protect");
expect(clean.ok and clean.passed and clean.semantic_complete,"default valid source unchanged");
print "security_taint_dependency_bounds_pass";
