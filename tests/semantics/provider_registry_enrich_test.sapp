// tests/semantics/provider_registry_enrich_test.sapp — enrichment for provider_registry.sapp

let P = import("stdlib/provider_registry.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

P.clear();
P.register("a", "http://a", "");
P.register("b", "http://b", "secret-token");

// ── has / count ─────────────────────────────────────────────────────────────────────
if not P.has("a") { fail("has a"); }
if P.has("zzz") { fail("missing provider -> false"); }
eq(P.count(), 2, "two providers");

// ── providers() returns records WITHOUT tokens ────────────────────────────────────
let pv = P.providers();
eq(len(pv), 2, "two records");
eq(pv[0].name, "a", "record name");
eq(pv[0].url, "http://a", "record url");
if map_has(pv[1], "token") { fail("providers() must not leak tokens"); }

P.clear();
eq(P.count(), 0, "cleared");

print "provider_registry_enrich_pass";
