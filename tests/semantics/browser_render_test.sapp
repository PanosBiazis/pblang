// Test: host browser snapshot bridge used by the native IDE Render tab.
// This stays deterministic: no installed browser is required.

let R = import("stdlib:browser_render.sapp");

let args = R.render_args("https://example.com", "/tmp/pbide-test.png", 640, 480);
let has_size = false;
let has_shot = false;
let has_headless = false;
let i = 0;
while i < len(args) {
    if args[i] == "--window-size=640,480" { has_size = true; }
    if args[i] == "--screenshot=/tmp/pbide-test.png" { has_shot = true; }
    if str_starts_with(args[i], "--headless") { has_headless = true; }
    i = i + 1;
}
assert(has_size and has_shot and has_headless, "render_args builds bounded Chromium screenshot args");
assert(args[len(args) - 1] == "https://example.com", "render_args keeps URL as final argument");

let ff = R.render_args("https://example.com", "/tmp/pbide-test-firefox.png", 800, 600, "firefox");
assert(ff[0] == "--headless", "firefox renderer uses headless mode");
assert(ff[1] == "--screenshot" and ff[2] == "/tmp/pbide-test-firefox.png", "firefox renderer passes screenshot output path");
assert(ff[3] == "--window-size" and ff[4] == "800,600", "firefox renderer passes bounded window size");
assert(ff[len(ff) - 1] == "https://example.com", "firefox render args keep URL as final argument");

let cs = R.candidates();
assert(cs[len(cs) - 1] == "firefox", "renderer candidates include firefox fallback");

let blocked = R.render_plan("file:///etc/passwd", "/tmp/blocked.png", 640, 480);
assert(not blocked.ok, "render_plan blocks file URLs before renderer lookup");
assert(str_contains(blocked.error, "blocked by browser policy"), "render_plan reports policy block");

let blocked_port = R.render_plan("http://example.com:22", "/tmp/blocked.png", 640, 480);
assert(not blocked_port.ok, "render_plan blocks non-web service ports before renderer lookup");

print "browser_render_pass";
