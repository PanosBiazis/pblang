let A = import("stdlib:compiler/source_analysis.sapp");
for source in [nil, "", " ", "// comment", "let = ;", "/* unclosed", "let n=0x;",
    "let n=nil-1;", "print absent;", "let n:number=\"x\";", "fn f(x){return x;}f();",
    "let text=\"λ😀\";print text;", "throw \"not executed\";"] {
    let full = A.analyze(source); let expected = map{};
    for key in map_keys(full) { if key != "tokens" { expected[key] = full[key]; } }
    let compact = A.analyze(source, false);
    assert(json_stringify(compact) == json_stringify(expected), "only token payload differs");
    assert(not map_has(compact, "tokens"), "compact result owns no token payload");
}
for flag in [nil, 0, "false", [], map{}] {
    assert(try { A.analyze("print 1;", flag); false } catch true, "reject ambiguous option");
}
let full = A.analyze("print 1;"); let saved = json_stringify(full);
A.analyze("print 2;", false);
assert(json_stringify(full) == saved, "compact checking preserves previous token results");
print "source_analysis_compact_pass";
