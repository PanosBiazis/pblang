// Child callbacks resolve these names in the worker's copied module, not here.
// Declare them for static checking; none is captured as a local by the callback.
let _queue:any=nil;
let _queue_indices:any=nil;
let _launch:any=nil;
let run:any=nil;
let run_pool:any=nil;
let A=import("stdlib:async_pool_worker.sapp");
let M=import("stdlib:async_map_worker.sapp");
let T=import("stdlib:thread_pool_worker.sapp");
fn inspect_async(x){return [x,type(_queue_indices),type(run_pool)];}
fn inspect_map(x){return [x,type(_queue),type(_launch),type(run)];}
fn inspect_thread(x){return [x,type(_queue),type(run)];}
for repetition 3 {
    let a=A.run_pool(2,[1,2,3],inspect_async,false);
    let m=M.run(2,[1,2,3],inspect_map);
    let t=T.run(2,[1,2,3],inspect_thread);
    assert(a==[[1,"builtin","builtin"],[2,"builtin","builtin"],[3,"builtin","builtin"]],"async child helpers released");
    assert(m.supported and m.values==[[1,"builtin","builtin","builtin"],[2,"builtin","builtin","builtin"],[3,"builtin","builtin","builtin"]],"map child helpers released");
    assert(len(t)==3,"thread count");
    for row in t {assert(row[1]=="builtin" and row[2]=="builtin","thread child helpers released");}
    assert(type(A.run_pool)=="closure" and type(M.run)=="closure" and type(T.run)=="closure","parent launchers intact");
}
// Actual captures survive, including mutable parent data copied into a child.
fn mapper(offset){return fn(x){return x+offset;};}
assert(A.run_pool(2,[1,2],mapper(10),false)==[11,12],"async captures");
assert(M.run(2,[1,2],mapper(20)).values==[21,22],"map captures");
assert(T.run(1,[1,2],mapper(30))==[31,32],"thread captures");
assert(A.run_pool(2,[fn(){return false;},fn(){throw "synthetic";}],nil,true)==[false,nil],"task-mode compatibility");
fn maybe_fail(x){if x==2 {throw "synthetic";} return x;}
assert(A.run_pool(2,[1,2],maybe_fail,false)==[1,nil],"async task failures stay nil");
assert(M.run(2,[1,2],maybe_fail).values==[1,nil],"map task failures stay nil");
assert((try {T.run(2,[1,2],maybe_fail);false} catch true),"thread task failure propagates after join");
fn bad_result(x){return fn(){return x;};}
assert((try {A.run_pool(2,[1,2],bad_result,false);false} catch true),"async transfer failure");
assert((try {M.run(2,[1,2],bad_result);false} catch true),"map transfer failure");
assert((try {T.run(2,[1,2],bad_result);false} catch true),"thread transfer failure");
// A fresh nested import owns its own live module, not the retired snapshot.
fn nested(x){
    let inner=import("stdlib:async.sapp");
    return inner.map_parallel([x],fn(y){return y*2;},1)[0];
}
assert(A.run_pool(1,[3],nested,false)==[6],"nested async");
assert(M.run(1,[4],nested).values==[8],"nested map");
assert(T.run(1,[5],nested)==[10],"nested thread");
// Every public route reaches the repaired boundary; values and reuse persist.
let Async=import("stdlib:async.sapp");
let Thread=import("stdlib:thread.sapp");
assert(Async.pool(1,[fn(){return 7;}])==[7],"public task pool");
assert(Async.map_parallel([nil,false],fn(x){return x;},2)==[nil,false],"public small map");
let large=[];for i 64 {array_push(large,map{v:i});}
let mapped=Async.map_parallel(large,fn(x){return x.v+1;},2);
assert(len(mapped)==64 and mapped[0]==1 and mapped[63]==64,"public queued map");
assert(Thread.thread_pool(1,[2,3],mapper(1))==[3,4],"public thread pool");
let p=Thread.pipeline([map{workers:1,process:mapper(2)}]);
assert(Thread.pipeline_run(p,[1,2])==[3,4],"public pipeline");
assert(A.run_pool(1,[1],mapper(1),false)==[2],"parent reuse after failures");
assert(M.run(1,[1],mapper(2)).values==[3],"map parent reuse");
assert(T.run(1,[1],mapper(3))==[4],"thread parent reuse");
print "pool_worker_module_lifetime_pass";
