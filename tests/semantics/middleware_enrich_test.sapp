// tests/semantics/middleware_enrich_test.sapp — enrichment for stdlib/middleware.sapp
//
// The module only had request-phase guards (mw(req) -> res|nil). This adds the
// missing pieces of a real middleware toolkit: compose (combine guards), after
// (response-phase transform), cors (preflight + response headers), security_headers,
// header-based bearer auth, and response normalization helpers.

let mw = import("stdlib/middleware.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

fn ok_handler(req) { return map{ status: 200, body: "ok" }; }
fn str_handler(req) { return "plain"; }

// ── existing contract preserved ─────────────────────────────────────────────────
let wrapped = mw.wrap(ok_handler, mw.mw_require_auth("s3cret"));
eq(wrapped(map{ auth: "s3cret" }).body, "ok", "wrap passes through on auth");
eq(wrapped(map{ auth: "x" }).status, 401, "wrap blocks on bad auth");

// ── ENRICH: compose combines several guards into one middleware ─────────────────
let blocker = fn(req) { if req.deny == true { return map{ status: 403, body: "no" }; } return nil; };
let passer = fn(req) { return nil; };
let combined = mw.compose([passer, blocker, passer]);
if combined(map{ deny: false }) != nil { fail("compose continues when all pass"); }
eq(combined(map{ deny: true }).status, 403, "compose short-circuits on a blocker");

// ── ENRICH: after() runs a response-phase transform ─────────────────────────────
let timed = mw.after(ok_handler, fn(req, res) { res.headers = map{ "X-Time": "1ms" }; return nil; });
eq(timed(map{}).headers["X-Time"], "1ms", "after transforms the response");
// after normalizes a string handler result into a response map
let normed = mw.after(str_handler, fn(req, res) { return nil; });
eq(normed(map{}).body, "plain", "after normalizes a string body");
eq(normed(map{}).status, 200, "normalized status defaults to 200");

// ── ENRICH: cors handles preflight + injects the allow-origin header ─────────────
let corsed = mw.cors(ok_handler, map{ origin: "https://app.test" });
let pre = corsed(map{ method: "OPTIONS" });
eq(pre.status, 204, "CORS preflight -> 204");
eq(pre.headers["Access-Control-Allow-Origin"], "https://app.test", "preflight origin header");
let normal = corsed(map{ method: "GET" });
eq(normal.headers["Access-Control-Allow-Origin"], "https://app.test", "response carries CORS origin");
eq(normal.body, "ok", "handler still runs for non-OPTIONS");

// ── ENRICH: security_headers ────────────────────────────────────────────────────
let secured = mw.security_headers(ok_handler);
eq(secured(map{}).headers["X-Content-Type-Options"], "nosniff", "nosniff header added");

// ── ENRICH: header-based bearer auth ────────────────────────────────────────────
let auth = mw.mw_bearer_auth("tok123");
eq(auth(map{ headers: map{} }).status, 401, "missing Authorization -> 401");
eq(auth(map{ headers: map{ "Authorization": "Bearer wrong" } }).status, 403, "wrong token -> 403");
if auth(map{ headers: map{ "Authorization": "Bearer tok123" } }) != nil { fail("valid bearer continues"); }

// ── ENRICH: response helpers ────────────────────────────────────────────────────
let r = mw.as_response("hi");
eq(r.body, "hi", "as_response wraps a string");
mw.set_header(r, "X-A", "1");
eq(r.headers["X-A"], "1", "set_header adds a header");

print "middleware_enrich_pass";
