let A=import("stdlib:sensor_acquisition.sapp");
fn near(a,b) {return num_abs(a-b)<0.000000001;}
let f=A.frontend(5,1000,1000,0.000001);
assert(near(f.steady_volts,2.5) and near(f.thevenin_ohms,500) and near(f.tau_seconds,0.0005),"divider and Thevenin RC");
assert(near(f.cutoff_hz,318.3098861837907),"single-pole corner");
assert(A.frontend(-5,1000,1000,0).steady_volts==-2.5 and A.frontend(5,1000,1000,0).cutoff_hz==nil,"signed source and no capacitor");
let q=A.quantize(1.5,3,2);assert(q.code==2 and q.error_volts==0.5,"half-step ties upward");
assert(A.quantize(0,3,2).code==0 and A.quantize(3,3,2).code==3,"rails map exactly");
for bits in [1,2,8,12,24] {for k in range(0,101) {let v=3.3*k/100;let r=A.quantize(v,3.3,bits);assert(r.code>=0 and r.code<=r.max_code and num_abs(r.error_volts)<=r.step_volts/2+0.000000001,"bounded quantization error");}}
let s=A.stream(1000,3,12,60);
assert(s.frames==60000 and s.samples==180000 and s.packed_frame_bytes==5 and s.aligned_frame_bytes==6,"byte rounding per frame versus per sample");
assert(s.packed_total_bytes==300000 and s.aligned_total_bytes==360000 and s.packed_bytes_per_second==5000 and s.aligned_bytes_per_second==6000,"rate and total consistency");
assert(A.stream(1,1,1,1).packed_total_bytes==1,"frame byte padding");
let maximum=A.stream(1000000,256,32,86400);assert(maximum.aligned_total_bytes==88473600000000 and maximum.packed_total_bytes==maximum.aligned_total_bytes,"maximum exact counts");
assert(not s.transport_overhead_included and not s.physical_verified and not f.physical_verified and not q.physical_verified,"explicit model boundaries");
for value in [nil,true,"PRIVATE_ACQUISITION_SENTINEL",[],map{},parse_number("NaN"),parse_number("inf"),parse_number("-inf")] {
 assert((try A.frontend(value,1,1,0) catch nil)==nil and (try A.frontend(1,value,1,0) catch nil)==nil and (try A.frontend(1,1,value,0) catch nil)==nil and (try A.frontend(1,1,1,value) catch nil)==nil,"frontend strict numeric inputs");
 assert((try A.quantize(value,3,8) catch nil)==nil and (try A.quantize(1,value,8) catch nil)==nil and (try A.quantize(1,3,value) catch nil)==nil,"quantizer strict numeric inputs");
 assert((try A.stream(value,1,8,1) catch nil)==nil and (try A.stream(1,value,8,1) catch nil)==nil and (try A.stream(1,1,value,1) catch nil)==nil and (try A.stream(1,1,8,value) catch nil)==nil,"stream strict numeric inputs");
}
for value in [0,-1,1.5,1000001] {assert((try A.stream(value,1,8,1) catch nil)==nil,"sample rate bounds");}
for value in [0,257,1.5] {assert((try A.stream(1,value,8,1) catch nil)==nil,"channel bounds");}
for value in [0,33,1.5] {assert((try A.stream(1,1,value,1) catch nil)==nil,"storage bit bounds");}
for value in [0,86401,1.5] {assert((try A.stream(1,1,8,value) catch nil)==nil,"duration bounds");}
for value in [0,25,1.5] {assert((try A.quantize(1,3,value) catch nil)==nil,"ADC bit bounds");}
assert((try A.quantize(-0.1,3,8) catch nil)==nil and (try A.quantize(3.1,3,8) catch nil)==nil and (try A.quantize(0,0,8) catch nil)==nil,"reject overrange instead of silent clamping");
assert((try A.frontend(1001,1,1,0) catch nil)==nil and (try A.frontend(1,0,1,0) catch nil)==nil and (try A.frontend(1,1,1000001,0) catch nil)==nil and (try A.frontend(1,1,1,-1) catch nil)==nil,"frontend bounds");
assert((try A.frontend(1,1,1,0.000000000000000001) catch nil)==nil,"extreme cutoff rejected");
print "sensor_acquisition_pass";
