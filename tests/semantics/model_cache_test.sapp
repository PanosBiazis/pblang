// Regression: model caches are bounded, validated, and published outside stdlib.
let MC = import("stdlib:model_cache.sapp");
let OS = import("stdlib:os.sapp");
let UUID = import("stdlib:uuid.sapp");

fn layer(n_in, n_out) {
    let w = [];
    let b = [];
    let row = 0;
    while row < n_out {
        let values = [];
        let col = 0;
        while col < n_in { array_push(values, (row + col) / 10); col = col + 1; }
        array_push(w, values);
        array_push(b, 0);
        row = row + 1;
    }
    return map{ w: w, b: b, n_in: n_in, n_out: n_out };
}

let root = path_join(OS.temp_dir(), "pblang_model_cache_test_" + UUID.v4());
let filename = path_join(root, "model.json");
let model = map{ l1: layer(3, 2), l2: layer(2, 1), pbai_version: 7 };

assert(MC.valid_mlp(model, 3, 2, 1, 7), "valid model accepted");
assert(not MC.valid_mlp(model, 4, 2, 1, 7), "input dimension mismatch rejected");
assert(not MC.valid_mlp(model, 3, 2, 1, 8), "version mismatch rejected");

let malformed = map{ l1: layer(3, 2), l2: layer(2, 1), pbai_version: 7 };
malformed.l1.w[0] = [1];
assert(not MC.valid_mlp(malformed, 3, 2, 1, 7), "short weight row rejected");

let stored = MC.store_json(filename, model);
assert(stored.ok, "cache is published");
let loaded = MC.load_mlp(filename, 3, 2, 1, 7);
assert(loaded != nil and loaded.pbai_version == 7, "published model round-trips");

fs_write(filename, "{broken");
assert(MC.load_mlp(filename, 3, 2, 1, 7) == nil, "malformed JSON is a cache miss");

let default_path = MC.path("safe-model.json", "PBLANG_MODEL_CACHE_TEST_UNSET");
assert(not str_contains(default_path, "stdlib/"), "default cache never points into stdlib");
try fs_remove(filename) catch nil;
try fs_remove(root) catch nil;
