let H = import("stdlib:product_health.sapp");

fn main() {
    let fast = H.check("parser", "ok", "incremental parser ready", map{ category: "language", latency_ms: 3, budget_ms: 10 });
    let slow = H.check("index", "ready", "index exceeded latency budget", map{ required: false, latency_ms: 15, budget_ms: 10 });
    assert(fast.status == "ready", "ready aliases normalize");
    assert(slow.status == "degraded", "budget overrun degrades a check");
    assert(slow.within_budget == false, "budget result is explicit");

    let good = H.report("pblang", "1", [fast, slow], map{ minimum_score: 70, capabilities: ["vm", "native"] });
    assert(good.format == "pblang.product_health.report.v1", "versioned report");
    assert(good.status == "degraded", "optional degradation reaches report");
    assert(good.score == 80, "deterministic score");
    assert(H.release_gate(good, 80).passed == true, "degraded optional check may pass threshold");
    assert(len(H.report_lines(good, 8)) == 4, "report lines are bounded and include checks");

    let secret = H.check("credentials", "ready", "redacted policy", map{ security_sensitive: true, evidence: ["must-not-escape"] });
    assert(len(secret.evidence) == 0, "security-sensitive checks suppress evidence");

    let failed = H.report("pblang", "2", [
        H.check("parser", "failed", "parser unavailable", map{ required: true }),
        H.check("docs", "ready", "current", map{ required: false })
    ]);
    assert(failed.status == "blocked", "required failure blocks report");
    assert(failed.required_failed == 1, "required failures counted");
    assert(H.release_gate(failed, 40).passed == false, "blocked report cannot release");

    let change = H.transition(good, failed);
    assert(change.direction == "regressed", "score regression is detected");
    assert(len(change.changed_checks) >= 1, "changed checks should be reported");

    let ecosystem = H.portfolio([good, H.report("pbide", "1", [H.check("render", "ready", "bounded")])]);
    assert(ecosystem.format == "pblang.product_health.portfolio.v1", "versioned portfolio");
    assert(ecosystem.status == "degraded", "portfolio reflects product degradation");
    assert(len(H.portfolio_lines(ecosystem, 8)) == 4, "portfolio lines are bounded");
    assert(H.dependency("compiler", good, true).status == "degraded", "dependency adapter preserves status");

    let duplicate_failed = false;
    try {
        H.report("bad", "1", [H.check("same", "ready"), H.check("same", "ready")]);
    } catch { duplicate_failed = true; }
    assert(duplicate_failed, "duplicate checks must fail closed");
    print "product_health: ok";
}

main();
