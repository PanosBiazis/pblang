// tests/semantics/source_inliner_test.sapp
//
// stdlib/source_inliner.sapp — a SOURCE-level linker. Unlike selfhost_bundle
// (which links bytecode chunks), this inlines a multi-module program's import()ed
// modules into ONE self-contained pblang SOURCE string with no remaining import()
// or export statements, so the result can be fed to the C transpiler -> a true
// native binary for multi-file projects.
//
// Strategy mirrors the bytecode bundler: SHARED namespace. Each module's
// top-level defs are concatenated (deps-first), `m.member` references become bare
// `member`, and name collisions / builtin shadowing / cycles are REJECTED.

let inl = import("stdlib/source_inliner.sapp");
let fe  = import("stdlib/compiler/selfhost_frontend.sapp");

fn fail(m) { throw "FAIL " + m; }
fn expect(c, m) { if not c { fail(m); } }

// In-memory module resolver.
fn mk_resolve(mods) {
    return fn(p) { return try mods[p] catch nil; };
}

// ── 1. basic single import: m.sq(9) -> inlined, runs, no import() remains ───────
let mods1 = map{
    "lib.sapp": "fn sq(x){ return x * x; } export sq;"
};
let main1 = "let m = import(\"lib.sapp\"); let answer = m.sq(9) + 1; print answer;";
let r1 = inl.inline_source(main1, mk_resolve(mods1));
expect(r1.ok, "basic inline succeeds");
expect(str_index_of(r1.source, "import(") < 0, "no import() remains in the inlined source");
let run1 = fe.frontend_run(r1.source);
expect(run1.ok, "inlined source compiles + runs");
expect(run1.globals["answer"] == 82, "m.sq(9)+1 == 81+1 == 82 after inlining");
expect(run1.output[0] == 82, "inlined program prints 82");

// ── 2. transitive: main -> a -> b, deps-first, all inlined ─────────────────────
let mods2 = map{
    "a.sapp": "let b = import(\"b.sapp\"); fn mid(x){ return b.base(x) * 2; } export mid;",
    "b.sapp": "fn base(x){ return x + 1; } export base;"
};
let main2 = "let a = import(\"a.sapp\"); print a.mid(4);";
let r2 = inl.inline_source(main2, mk_resolve(mods2));
expect(r2.ok, "transitive inline succeeds");
expect(str_index_of(r2.source, "import(") < 0, "no import() remains (transitive)");
let run2 = fe.frontend_run(r2.source);
expect(run2.output[0] == 10, "a.mid(4) == (4+1)*2 == 10 across two inlined modules");

// ── 3. multiple exports incl. a constant ───────────────────────────────────────
let mods3 = map{
    "u.sapp": "fn dbl(x){ return x + x; } let K = 100; export dbl, K;"
};
let main3 = "let u = import(\"u.sapp\"); print u.dbl(3) + u.K;";
let r3 = inl.inline_source(main3, mk_resolve(mods3));
expect(r3.ok, "multi-export inline succeeds");
let run3 = fe.frontend_run(r3.source);
expect(run3.output[0] == 106, "u.dbl(3) + u.K == 6 + 100 == 106");

// ── 4. REJECT a name collision between two modules (shared namespace) ───────────
let mods4 = map{
    "x.sapp": "fn helper(){ return 1; } fn val(){ return 10; } export val;",
    "y.sapp": "fn helper(){ return 2; } fn val2(){ return 20; } export val2;"
};
let main4 = "let x = import(\"x.sapp\"); let y = import(\"y.sapp\"); print x.val() + y.val2();";
let r4 = inl.inline_source(main4, mk_resolve(mods4));
expect(r4.ok == false, "colliding top-level name 'helper' must be rejected");
expect(str_index_of(r4.reason, "helper") >= 0 or str_index_of(r4.reason, "collision") >= 0,
       "rejection names the collision");

// ── 5. REJECT an unresolvable import ───────────────────────────────────────────
let r5 = inl.inline_source("let z = import(\"missing.sapp\"); print z.f();", mk_resolve(map{}));
expect(r5.ok == false, "unresolvable import rejected");

// ── 6. a program with NO imports passes through unchanged + runs ────────────────
let r6 = inl.inline_source("let v = 5; print v * 2;", mk_resolve(map{}));
expect(r6.ok, "no-import program is accepted");
let run6 = fe.frontend_run(r6.source);
expect(run6.output[0] == 10, "passthrough program still runs");

print "source_inliner_pass";
