// Test: stdlib/project_text_audit.sapp bounded safe-text project audit.

let TA = import("stdlib:project_text_audit.sapp");

fn fail(m) { throw "FAIL " + m; }

let ROOT = "tests/fixtures/_project_text_audit";

fn cleanup() {
    try fs_remove(ROOT + "/src/app.sapp") catch nil;
    try fs_remove(ROOT + "/src") catch nil;
    try fs_remove(ROOT + "/docs/History.md") catch nil;
    try fs_remove(ROOT + "/docs/Plan.md") catch nil;
    try fs_remove(ROOT + "/docs") catch nil;
    try fs_remove(ROOT + "/target/generated.sapp") catch nil;
    try fs_remove(ROOT + "/target") catch nil;
    try fs_remove(ROOT + "/.ssh/id_ed25519") catch nil;
    try fs_remove(ROOT + "/.ssh") catch nil;
    try fs_remove(ROOT + "/.claude/settings.local.json") catch nil;
    try fs_remove(ROOT + "/.claude") catch nil;
    try fs_remove(ROOT + "/graphify-out/.graphify_labels.json") catch nil;
    try fs_remove(ROOT + "/graphify-out") catch nil;
    try fs_remove(ROOT) catch nil;
}

cleanup();
fs_mkdirs(ROOT + "/src");
fs_mkdirs(ROOT + "/docs");
fs_mkdirs(ROOT + "/target");
fs_mkdirs(ROOT + "/.ssh");
fs_mkdirs(ROOT + "/.claude");
fs_mkdirs(ROOT + "/graphify-out");
fs_write(ROOT + "/src/app.sapp", "fn main() {\n    // TODO placeholder renderer\n    panic!(\"bad\");\n}\n");
fs_write(ROOT + "/docs/Plan.md", "# Plan\nblocked by GPU-present gap\nlet token = \"ghp_1234567890abcdefghijklmnopqrstuvwx\";\n");
fs_write(ROOT + "/docs/History.md", "# Old Plan\n\n> Historical snapshot. This old report is kept for history only.\n\nTODO stale roadmap panic unwrap performance\n");
fs_write(ROOT + "/target/generated.sapp", "// TODO should be skipped");
fs_write(ROOT + "/.ssh/id_ed25519", "PRIVATE KEY");
fs_write(ROOT + "/.claude/settings.local.json", "{\"permissions\":{\"allow\":[\"Bash(xargs -I {} bash -c bad)\"]}}");
fs_write(ROOT + "/graphify-out/.graphify_labels.json", "{\"0\":\"TODO generated graph label\"}");

if not TA.text_like_path("main.sapp") { fail("sapp is text-like"); }
if not TA.text_like_path("README.md") { fail("markdown is text-like"); }
if not TA.text_like_path("MainActivity.kt") or not TA.text_like_path("build.gradle")
    or not TA.text_like_path("schema.sql") or not TA.text_like_path("Dockerfile") {
    fail("cross-platform source, build, database, and container text formats are audited");
}
if TA.text_like_path("image.png") { fail("binary image is not text-like"); }

let policy = TA.audit_policy();
if policy.format != "pblang.project_text_audit.policy.v1" { fail("audit policy format"); }
if not str_contains(policy.write_scope, "none") { fail("text audit is write-free"); }
if not str_contains(policy.external_disk_policy, "read-only") or not str_contains(policy.external_disk_policy, "Ventoy") { fail("external disk policy is explicit"); }

let collected = TA.collect_text_records([ROOT], map{ max_depth: 4, max_entries: 100, max_files: 20, max_file_bytes: 2000 });
if collected.format != "pblang.project_text_audit.records.v1" { fail("collected format"); }
if not str_contains(collected.policy, "read-only") { fail("collection policy states read-only behavior"); }
if not str_contains(collected.policy, "generated-output") { fail("collection policy mentions generated-output pruning"); }
if collected.policy_contract.write_scope != policy.write_scope { fail("collected report carries policy contract"); }
if collected.timed_out or collected.duration_ms < 0 { fail("small text audit completes within cooperative deadline"); }
if collected.record_count != 2 { fail("only active src/docs records should be read, got " + str(collected.record_count)); }
let paths = str_join([collected.records[0].path, collected.records[1].path], "\n");
if not str_contains(paths, "app.sapp") or not str_contains(paths, "Plan.md") { fail("safe source/docs are collected"); }
if str_contains(paths, "History.md") or str_contains(paths, "target") or str_contains(paths, "id_ed25519") or str_contains(paths, "settings.local") or str_contains(paths, "graphify-out") { fail("skipped paths leaked into records"); }
let collected_with_history = TA.collect_text_records([ROOT], map{ max_depth: 4, max_entries: 100, max_files: 20, max_file_bytes: 2000, skip_historical_snapshots: false });
if collected_with_history.record_count != 3 { fail("historical snapshot opt-out includes historical docs"); }

let default_report = TA.audit_roots("pbide", [ROOT], map{ max_depth: 4, max_entries: 100, max_files: 20, max_file_bytes: 2000, max_findings: 20 });
if default_report.status == "blocked" or not default_report.quality_gate.passed { fail("default fixture suppression should avoid blockers"); }
if default_report.audit.report.finding_count != 1 { fail("default fixture mode should leave only the roadmap review finding"); }
if default_report.audit.report.suppressed_count < 3 { fail("default fixture suppression should count suppressed findings"); }

let report = TA.audit_roots("pbide", [ROOT], map{ max_depth: 4, max_entries: 100, max_files: 20, max_file_bytes: 2000, max_findings: 20, suppress_test_fixtures: false, source_only_blockers: false });
if report.format != "pblang.project_text_audit.report.v1" { fail("audit report format"); }
if report.policy_contract.external_disk_policy != policy.external_disk_policy { fail("audit report carries read-only external-disk policy"); }
if report.status != "blocked" or report.quality_gate.passed { fail("findings should block by default"); }
if report.audit.report.finding_count < 4 { fail("audit should find TODO, panic, roadmap, and secret"); }
let lines = str_join(TA.audit_lines(report, 12), "\n");
if not str_contains(lines, "Project text audit: pbide") or not str_contains(lines, "renderer/input") { fail("audit lines summarize project recommendations"); }
if str_contains(lines, "ghp_1234567890") { fail("audit lines must not print raw secret values"); }

cleanup();
print "project_text_audit_pass";
