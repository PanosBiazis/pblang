let T=import("stdlib:compiler/tokenizer.sapp");
fn expect(ok,label) {if not ok {throw "FAIL string-position: "+label;}}
let prefixes=[
    "\"first\nsecond\"; ",
    "\"first\r\nsecond\"; ",
    "\"first\\\nsecond\"; ",
    "\"first\\\r\nsecond\"; ",
    "\"first\\nsecond\"; ",
    "\"first\\u{a}second\"; ",
    "\"π\nκόσμος\"; ",
    "\"a\nb\nc\"; ",
    "\"a\\\nb\nc\"; "
];
let values=["first\nsecond","first\r\nsecond","first\nsecond","first\r\nsecond",
    "first\nsecond","first\nsecond","π\nκόσμος","a\nb\nc","a\nb\nc"];
let case_index=0;
for prefix in prefixes {
    let source=prefix+"eval(payload);";
    let lines=str_split(prefix,"\n");
    let expected_line=len(lines);let expected_col=len(lines[len(lines)-1])+1;
    let tokens=T.tokenize(source,true);
    expect(tokens[0].kind=="string" and tokens[0].text==values[case_index],"decoded value unchanged");
    expect(tokens[0].line==1 and tokens[0].col==1,"string starts at original location");
    let found=false;
    for token in tokens {
        if token.kind=="ident" and token.text=="eval" {
            expect(token.line==expected_line and token.col==expected_col,"physical source position");
            expect(token.source_start==len(prefix) and token.source_end==len(prefix)+4,"scalar span unchanged");
            found=true;
        }
    }
    expect(found,"following identifier exists");
    let commented=T.tokenize(prefix+"// comment");
    let comment=commented[len(commented)-2];
    expect(comment.kind=="comment" and comment.line==expected_line
        and comment.col==expected_col,"following comment physical position");
    let end=tokens[len(tokens)-1];
    expect(end.line==expected_line and end.col==expected_col+14,"EOF physical position");
    case_index=case_index+1;
}
let unterminated=T.tokenize("\"a\nb");
expect(unterminated[0].unterminated==true,"unterminated flag remains");
expect(unterminated[len(unterminated)-1].line==2,"unterminated EOF line");
print "selfhost_tokenizer_string_positions_pass";
