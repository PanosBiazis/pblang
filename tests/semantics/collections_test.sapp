// tests/semantics/collections_test.sapp — stack, queue, and set helpers (G3-alpha)
let collections = import("stdlib:collections.sapp");

// Stack: LIFO push/pop/peek
let st = collections.stack_new();
collections.stack_push(st, 1);
collections.stack_push(st, 2);
collections.stack_push(st, 3);
if collections.stack_peek(st) != 3 {
    print "FAIL stack_peek";
}
let spop = collections.stack_pop(st);
if spop != 3 or len(st) != 2 or collections.stack_peek(st) != 2 {
    print "FAIL stack_pop";
}

// Queue: FIFO enqueue/dequeue
let q = collections.queue_new();
collections.queue_enqueue(q, "a");
collections.queue_enqueue(q, "b");
collections.queue_enqueue(q, "c");
let q1 = collections.queue_dequeue(q);
let q2 = collections.queue_dequeue(q);
if q1 != "a" or q2 != "b" or len(q) != 1 or q[0] != "c" {
    print "FAIL queue";
}

// Set: add/has/remove/union/intersect
let s1 = collections.set_new();
collections.set_add(s1, "x");
collections.set_add(s1, "y");
if (collections.set_has(s1, "x") == false) or (collections.set_has(s1, "y") == false) {
    print "FAIL set_has";
}

let s2 = collections.set_new();
collections.set_add(s2, "y");
collections.set_add(s2, "z");

let su = collections.set_union(s1, s2);
if (collections.set_has(su, "x") == false) or (collections.set_has(su, "y") == false) or (collections.set_has(su, "z") == false) {
    print "FAIL set_union";
}

let si = collections.set_intersect(s1, s2);
if collections.set_has(si, "x") or (collections.set_has(si, "y") == false) or collections.set_has(si, "z") {
    print "FAIL set_intersect";
}

collections.set_remove(s1, "x");
if collections.set_has(s1, "x") {
    print "FAIL set_remove";
}

print "collections_test: pass";
