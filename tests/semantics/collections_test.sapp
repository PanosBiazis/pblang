// tests/semantics/collections_test.sapp — G3-alpha collections stdlib test
import "stdlib:collections.sapp";

// --- Stack ---
let s = collections.stack_new();
collections.stack_push(s, 1);
collections.stack_push(s, 2);
collections.stack_push(s, 3);

let peeked = collections.stack_peek(s);
let popped  = collections.stack_pop(s);
let sz      = collections.stack_size(s);
let empty   = collections.stack_is_empty(s);

if peeked != 3    { print "stack_peek FAIL: " + str(peeked); }
if popped != 3    { print "stack_pop FAIL: "  + str(popped); }
if sz != 2        { print "stack_size FAIL: " + str(sz); }
if empty != false { print "stack_is_empty FAIL"; }

// empty the rest, check is_empty becomes true
collections.stack_pop(s);
collections.stack_pop(s);
if collections.stack_is_empty(s) != true { print "stack_empty_after_drain FAIL"; }

// --- Queue ---
let q = collections.queue_new();
collections.queue_enqueue(q, "a");
collections.queue_enqueue(q, "b");
collections.queue_enqueue(q, "c");

let qpeeked = collections.queue_peek(q);
let qdq     = collections.queue_dequeue(q);
let qsz     = collections.queue_size(q);
let qempty  = collections.queue_is_empty(q);

if qpeeked != "a" { print "queue_peek FAIL: " + str(qpeeked); }
if qdq != "a"     { print "queue_dequeue FAIL: " + str(qdq); }
if qsz != 2       { print "queue_size FAIL: " + str(qsz); }
if qempty != false { print "queue_is_empty FAIL"; }

// drain queue
collections.queue_dequeue(q);
collections.queue_dequeue(q);
if collections.queue_is_empty(q) != true { print "queue_empty_after_drain FAIL"; }

// dequeue on empty returns nil
let nil_val = collections.queue_dequeue(q);
if nil_val != nil { print "queue_dequeue_empty FAIL"; }

// --- Set ---
let st = collections.set_new();
collections.set_add(st, "x");
collections.set_add(st, "y");
collections.set_add(st, "x");   // duplicate; should not grow

let has_x  = collections.set_has(st, "x");
let has_z  = collections.set_has(st, "z");
let ssz    = collections.set_size(st);

if has_x != true  { print "set_has FAIL"; }
if has_z != false { print "set_has_neg FAIL"; }
if ssz != 2       { print "set_size FAIL: " + str(ssz); }

collections.set_remove(st, "x");
if collections.set_size(st) != 1 { print "set_remove FAIL"; }
if collections.set_has(st, "x") != false { print "set_has_after_remove FAIL"; }

print "collections_test: pass";
