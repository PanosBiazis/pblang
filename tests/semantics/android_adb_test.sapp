let ADB = import("stdlib:android_adb.sapp");

fn require(condition, message) { if not condition { throw "FAIL android_adb: " + message; } }

let devices = ADB.parse_devices("List of devices attached\n"
    + "abc-123\tdevice product:p model:Pixel_8 device:husky transport_id:4\n"
    + "locked\tunauthorized usb:3-4 transport_id:5\n");
require(len(devices) == 2, "device count");
require(devices[0].serial == "abc-123" and devices[0].model == "Pixel_8", "device fields");
let chosen = ADB.select_device(devices, "abc-123");
require(chosen.ok and chosen.device.state == "device", "explicit selection");
let denied = ADB.select_device(devices, "locked");
require(not denied.ok and str_contains(denied.error, "authorization"), "unauthorized rejection");
let automatic = ADB.select_device(devices);
require(automatic.ok and automatic.device.serial == "abc-123", "single authorized selection");
let automatic_nil = ADB.select_device(devices, nil);
require(automatic_nil.ok and automatic_nil.device.serial == "abc-123",
    "unset selector uses single authorized device");

let start = ADB.parse_start_wait("Status: ok\nActivity: org.pblang.pbremote/.MainActivity\n"
    + "ThisTime: 184\nTotalTime: 231\nWaitTime: 239\nComplete\n");
require(start.ok and start.total_time_ms == 231 and start.wait_time_ms == 239, "startup metrics");
require(not ADB.parse_start_wait("Status: timeout\nTotalTime: 5\nWaitTime: 6\n").ok, "startup failure");

require(ADB.parse_meminfo(" TOTAL PSS: 8,058 TOTAL RSS: 31,109\n") == 8058, "memory parse");
require(ADB.parse_meminfo(" TOTAL: 41,313 TOTAL SWAP PSS: 124\n") == 41313,
    "legacy Android memory parse");
require(ADB.parse_meminfo("no summary\n") == nil, "missing memory summary");
let battery = ADB.parse_battery("AC powered: false\nUSB powered: true\nlevel: 90\nscale: 100\n"
    + "voltage: 4427\ntemperature: 350\nstatus: 2\nhealth: 2\n");
require(battery.available and battery.level_percent == 90 and battery.temperature_c == 35
    and battery.usb_powered and battery.powered, "battery and temperature parse");
let thermal = ADB.parse_thermal_status("Thermal Status: 2\n");
require(thermal.available and thermal.status == 2 and thermal.pressure == "moderate", "thermal parse");
require(not ADB.parse_thermal_status("").available, "missing thermal service");
let storage = ADB.parse_storage("Filesystem 1K-blocks Used Available Use% Mounted on\n"
    + "/dev/block/dm-2 54766572 14427552 40339020 27% /data\n");
require(storage.available and storage.available_kib == 40339020 and storage.used_percent == 27,
    "storage parse");
let device_memory = ADB.parse_device_memory("MemTotal: 3926036 kB\nMemAvailable: 2403052 kB\n");
require(device_memory.available and device_memory.total_kib == 3926036
    and device_memory.available_kib == 2403052, "device memory parse");
let display = ADB.parse_display("Physical size: 720x1600\n", "Physical density: 320\n");
require(display.available and display.width_px == 720 and display.height_px == 1600
    and display.density_dpi == 320, "display parse");
let scroll = ADB.scroll_plan(display.width_px, display.height_px);
require(scroll.ok and scroll.center_x == 360 and scroll.start_y == 1248
    and scroll.end_y == 448 and scroll.duration_ms == 250,
    "display-bounded accessibility scroll plan");
require(not ADB.scroll_plan(0, 1600).ok and not ADB.scroll_plan(720, 99999).ok,
    "unsafe accessibility scroll dimensions rejected");
let horizontal = ADB.horizontal_navigation_plan(display.width_px, display.height_px);
require(horizontal.ok and horizontal.start_x == 619 and horizontal.end_x == 100
    and horizontal.center_y == 160 and horizontal.duration_ms == 250,
    "display-bounded horizontal navigation plan");
require(not ADB.horizontal_navigation_plan(200, 1600).ok,
    "unsafe horizontal navigation dimensions rejected");
let activation = ADB.navigation_activation_plan();
require(activation.max_taps == 2 and activation.polls_per_tap == 4
    and activation.base_delay_ms == 150,
    "navigation activation retry must remain bounded");
let legacy_hierarchy = ADB.ui_hierarchy_plan(28);
let modern_hierarchy = ADB.ui_hierarchy_plan(34);
require(legacy_hierarchy.ok and legacy_hierarchy.attempts == 6
    and not legacy_hierarchy.compressed and legacy_hierarchy.read_attempts == 4,
    "legacy OEM hierarchy recovery plan");
require(modern_hierarchy.ok and modern_hierarchy.attempts == 3
    and modern_hierarchy.compressed and modern_hierarchy.read_attempts == 4,
    "modern hierarchy plan");
require(not ADB.ui_hierarchy_plan(19).ok,
    "unsupported Android hierarchy plan must fail closed");
let legacy_install = ADB.install_plan(28, "org.pblang.pbremote");
let modern_install = ADB.install_plan(34, "org.pblang.pbremote");
require(legacy_install.mode == "staged-pm" and legacy_install.staged, "legacy staged install");
require(modern_install.mode == "streaming-adb" and not modern_install.staged, "modern streaming install");
require(str_contains(ADB.result_error(map{ exit_code: 124, stdout: "", stderr: "" }, "install"),
    "timed out"), "empty timeout gains diagnostic");
let bounds = ADB.find_accessibility_bounds("<node content-desc=\"Run check\" clickable=\"true\" bounds=\"[32,546][1048,678]\" />", "Run check");
require(bounds.ok and bounds.center_x == 540 and bounds.center_y == 612, "accessibility bounds");
require(not ADB.find_accessibility_bounds("<node bounds=\"[0,0][1,1]\" />", "missing").ok,
    "missing accessibility node");
let text_bounds = ADB.find_text_bounds(
    "<node text=\"pbremote-transfer.bin\" bounds=\"[24,420][696,516]\" />",
    "pbremote-transfer.bin");
require(text_bounds.ok and text_bounds.center_x == 360
    and text_bounds.center_y == 468, "document text bounds");
require(not ADB.find_text_bounds(
    "<node text=\"safe\" bounds=\"[0,0][1,1]\" />", "bad&amp;value").ok,
    "unsafe XML text lookup accepted");
require(ADB.ui_has_action_result("<node text=\"All checks passed\" />", "All checks passed"),
    "bounded action result is detected");
require(not ADB.ui_has_action_result("<node text=\"All checks passed\" />", ""),
    "empty action result is rejected");
require(ADB.valid_action_result_log_marker("runtime_host_pbck_probe_passed_v1"),
    "bounded package log marker rejected");
require(not ADB.valid_action_result_log_marker("bad\nmarker"),
    "multiline package log marker accepted");
require(not ADB.valid_action_result_log_marker(
    "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"),
    "oversized package log marker accepted");
let gfx = ADB.parse_gfxinfo("Total frames rendered: 20\nJanky frames: 2 (10.00%)\n"
    + "50th percentile: 6ms\n90th percentile: 12ms\n95th percentile: 18ms\n99th percentile: 25ms\n");
require(gfx.available and gfx.total_frames == 20 and gfx.janky_frames == 2
    and gfx.p50_ms == 6 and gfx.p99_ms == 25 and gfx.janky_percent == 10, "graphics metrics");
require(ADB.scan_crashes("I/PBRemote: ready", "org.pblang.pbremote").ok, "clean log");
require(ADB.scan_crashes("FATAL EXCEPTION: main Process: org.pblang.pbremote", "org.pblang.pbremote").crashed,
    "package crash detection");
require(ADB.scan_crashes("FATAL EXCEPTION: main Process: other.app", "org.pblang.pbremote").ok,
    "unrelated crash ignored");

let ready = ADB.parse_device_state("mWakefulness=Awake\n", "KeyguardServiceDelegate\n showing=false\n");
require(ready.ok and ready.awake and not ready.keyguard_showing, "awake unlocked device state");
let asleep = ADB.parse_device_state("mWakefulness=Asleep\n", "showing=false\n");
require(not asleep.ok and str_contains(asleep.error, "asleep"), "asleep device rejection");
let locked_state = ADB.parse_device_state("mWakefulness=Awake\n", "KeyguardServiceDelegate\n showing=true\n");
require(not locked_state.ok and str_contains(locked_state.error, "locked"), "locked device rejection");
let occluded = ADB.parse_device_state("mWakefulness=Awake\n",
    "mKeyguardOccluded=true\nKeyguardServiceDelegate\n showing=true\n");
require(occluded.ok, "keyguard occluded by verified foreground Activity");

require(len(ADB.parse_devices("../bad\tdevice\n")) == 0, "unsafe serial ignored");
print "android_adb_pass";
