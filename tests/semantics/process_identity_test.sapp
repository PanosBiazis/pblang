let I=import("stdlib:process_identity.sapp");
assert(I.plan("my-app").linux_name=="my-app","short labels preserved");
assert(not I.plan("123456789012345").truncated,"15 bytes fit exactly");
assert(I.plan("1234567890123456").linux_name=="123456789012345","kernel byte limit explicit");
let greek=I.plan("αβγδεζηθ");
assert(greek.linux_name=="αβγδεζη" and greek.truncated,"UTF-8 not split");
assert(I.plan("😀😀😀😀").linux_name=="😀😀😀","four-byte characters not split");
for value in [nil,17,""," padded","path/app","path\\app","bad\nname","bad\u0000name"] {
    assert(not I.plan(value).ok,"invalid labels refused");
}
assert(I.from_path("/private/project/my-app.pbck")=="my-app","only filename becomes label");
assert(I.from_path("C:\\private\\MyApp.EXE")=="MyApp","Windows path handled on all hosts");
assert(I.from_path("/project/αβ.sapp")=="αβ","Unicode filename preserved");
assert(I.from_path("/project/")=="" and I.from_path(nil)=="","missing filename not guessed");
assert(I.apply(nil,"keep").reason=="kept","keep mode requires no OS access");
assert(not I.apply("demo","invalid").ok,"unknown mode refused");
print "process_identity_pass";
