let DB = import("stdlib:polyglot_db.sapp");

fn fail(message) { throw "FAIL " + message; }

if fs_exists("/usr/bin/sqlite3") or fs_exists("/bin/sqlite3") {
    let result = DB.query("sqlite", ":memory:", "SELECT 42 AS answer;");
    if not result.ok { fail("bounded SQLite query failed: " + str(result.error)); }
    if not result.bounded { fail("SQLite query bypassed bounded process supervision"); }
    if result.shell_used { fail("SQLite query used a shell"); }
    if result.output_truncated { fail("small SQLite result was truncated"); }
    if result.data == nil or len(result.data) != 1 or result.data[0].answer != 42 {
        fail("unexpected SQLite JSON result: " + str(result));
    }
    print "polyglot_db_bounded_pass";
} else {
    print "polyglot_db_bounded_skip: fixed sqlite3 executable unavailable";
}
