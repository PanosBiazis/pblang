let A=import("stdlib:source_analysis.sapp");
fn expect(ok,label) {if not ok {throw "FAIL analysis-selection: "+label;}}
let canonical=["security","quality","performance","completeness","roadmap"];
let source="eval(\"1\");";
let options=map{analyses:["ALL","performance"]};
let first=A.analyze(source,"selection.sapp",options);
expect(first.ok and not first.passed and first.security!=nil,"mixed ALL keeps security");
for names in [["all"],["ALL"],["AlL"],["performance","ALL"],["unknown","aLl"],["all","ALL"]] {
    let before=json_stringify(names);
    let result=A.analyze(source,"selection.sapp",map{analyses:names});
    expect(result.ok and not result.passed and result.security!=nil,"all spellings retain security rejection");
    expect(json_stringify(result.analyses)==json_stringify(canonical),"canonical all order without duplicates");
    expect(json_stringify(names)==before,"caller selection unchanged");
}
let selected=A.analyze("let value=1;","selection.sapp",map{analyses:["Quality","PERFORMANCE","quality","unknown"]});
expect(json_stringify(selected.analyses)==json_stringify(["quality","performance"]),"known selection order and deduplication");
for value in [nil,[],false,"performance"] {
    let result=A.analyze(source,"selection.sapp",map{analyses:value});
    expect(result.ok and not result.passed and json_stringify(result.analyses)=="[\"security\"]","legacy default for empty/non-array selection");
}
let bad=A.analyze("","selection.sapp",map{analyses:["private-selection-marker"]});
expect(not bad.ok and not bad.passed and not str_contains(json_stringify(bad),"private-selection-marker"),"unknown-only fails without selection echo");
print "source_analysis_selection_pass";
