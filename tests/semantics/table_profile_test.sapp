let Profile=import("stdlib:table_profile.sapp");
let CSV=import("stdlib:sheet_csv.sapp");
fn rejects(f) { let bad=false; try { f(); } catch { bad=true; } assert(bad,"invalid profile rejected"); }
let doc=CSV.decode("name,value,optional\na,1,\nb,2, \na,1,\nc,=1+1,x\nd,1e3,y\n");
let report=Profile.describe(doc,true);
assert(report.rows==5 and report.duplicate_rows==1,"header excluded, full duplicate row counted once");
assert(report.columns[1].numeric==3 and report.columns[1].text==2,"formulas and exponents stay text");
assert(report.columns[1].sum==4 and report.columns[1].min==1 and report.columns[1].max==2,"numeric statistics");
assert(num_abs(report.columns[1].population_variance-2/9)<0.0000001,"Welford population variance");
assert(report.columns[2].empty==2 and report.columns[2].text==3,"whitespace is not missing");
assert(report.columns[0].distinct_nonempty==4,"literal distinct categories");
assert(Profile.select_rows(doc,0,"a",true)==[1,3],"stable row filter");
assert(not report.contains_cell_text and not report.contains_headers and not report.safe_to_log,"aggregate-only report is still private");
let empty=Profile.describe(CSV.decode("head"),true);
assert(empty.rows==0 and empty.columns[0].mean==nil,"header-only input explicitly has no numeric sample");
rejects(fn(){Profile.describe(doc,"true");}); rejects(fn(){Profile.select_rows(doc,-1,"a");});
rejects(fn(){Profile.describe(CSV.decode("1000000000001"));});
print "table_profile_pass";
