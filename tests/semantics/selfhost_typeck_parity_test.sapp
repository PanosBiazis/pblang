// Core parity and fail-closed guards for the pblang-written type checker.
let T = import("stdlib/compiler/tokenizer.sapp");
let P = import("stdlib/compiler/parser.sapp");
let C = import("stdlib/compiler/typeck.sapp");
let F = import("stdlib/compiler/selfhost_frontend.sapp");

fn fail(message) { throw "FAIL selfhost-typeck-parity: " + message; }
fn check(source, options = nil) {
    let ast = P.parse(T.tokenize(source));
    if len(ast.errors) != 0 { fail("fixture parse error: " + str(ast.errors)); }
    return C.type_check(ast.stmts, options);
}
fn has(diags, needle) {
    let i = 0;
    while i < len(diags) {
        if str_contains(diags[i].message, needle) { return true; }
        i = i + 1;
    }
    return false;
}
fn has_code(diags, code) {
    let i = 0;
    while i < len(diags) {
        if map_has(diags[i], "code") and diags[i].code == code { return true; }
        i = i + 1;
    }
    return false;
}

// Lexical bindings retain inferred and declared types across assignments.
if not has(check("let x: number = 1; x = \"bad\";"), "assignment type mismatch") {
    fail("declared assignment mismatch was not diagnosed");
}
if not has(check("let x = 1; x = \"bad\";"), "assignment type mismatch") {
    fail("inferred assignment mismatch was not diagnosed");
}
if len(check("let x: number = 1; if true { let x: string = \"ok\"; x = \"next\"; } x = 2;")) != 0 {
    fail("lexical shadowing produced a false positive");
}

// Signatures are hoisted, calls honor defaults, and concrete arguments are checked.
let good = "let before: number = add(3); fn add(a: number, b: number = 2): number { return a + b; } let after: number = add(4, 5);";
if len(check(good)) != 0 { fail("valid hoisted/default-argument function was rejected"); }
if not has(check("fn f(a: number): number { return a; } let x = f(\"bad\");"), "argument 1 type mismatch") {
    fail("function argument mismatch was not diagnosed");
}
if not has_code(check("fn f(a, b = 2) { return a; } f();"), "arity") {
    fail("too-few-arguments call was not diagnosed");
}
if not has_code(check("fn f(a) { return a; } f(1, 2);"), "arity") {
    fail("too-many-arguments call was not diagnosed");
}
if len(check("fn f(a, b = 2) { return a + b; } f(1); f(1, 3);")) != 0 {
    fail("valid default arities were rejected");
}

// Declared returns and default values are checked inside the function scope.
if not has(check("fn f(x: number): string { return x; }"), "return type mismatch") {
    fail("return mismatch was not diagnosed");
}
if not has(check("fn f(x: number = \"bad\") { return x; }"), "default value type mismatch") {
    fail("default value mismatch was not diagnosed");
}
if not has_code(check("const x = nil;"), "const-nil") {
    fail("nil const was not diagnosed");
}

// Container annotations and indexing preserve the element type.
if len(check("let xs: [number] = [1, 2, 3]; let first: number = xs[0];")) != 0 {
    fail("array annotation/index inference produced a false positive");
}

// Malformed caller-provided AST and resource exhaustion are diagnostics, not crashes.
if not has_code(C.type_check(nil), "malformed-ast") { fail("nil AST did not fail closed"); }
if not has_code(C.type_check([map{}]), "malformed-ast") { fail("malformed node did not fail closed"); }
let malformed_shapes = [
    map{ kind: "let" },
    map{ kind: "fn", name: "f", params: "not-an-array", body: map{ kind: "block", stmts: [] }, ret: nil },
    map{ kind: "fn", name: "f", params: [map{}], body: map{ kind: "block", stmts: [] }, ret: nil },
    map{ kind: "if", cond: map{ kind: "bool", value: true }, then: map{ kind: "block", stmts: [] }, elifs: [map{}], else: nil },
    map{ kind: "expr_stmt", expr: map{ kind: "call" } },
    map{ kind: "expr_stmt", expr: map{ kind: "map", entries: [map{}] } },
    map{ kind: "expr_stmt", expr: map{ kind: "match", scrutinee: map{ kind: "number", value: 1 }, arms: [map{}], melse: nil } },
];
let malformed_i = 0;
while malformed_i < len(malformed_shapes) {
    if not has_code(C.type_check([malformed_shapes[malformed_i]]), "malformed-ast") {
        fail("incomplete AST shape " + str(malformed_i) + " did not fail closed");
    }
    malformed_i = malformed_i + 1;
}
let limited = check("let a = 1; let b = 2; let c = 3; let d = 4;", map{ max_nodes: 2 });
if not has_code(limited, "resource-limit") { fail("AST node budget was not enforced"); }

// The frontend must surface checker diagnostics instead of swallowing them.
let compiled_bad = F.frontend_compile("let x: number = \"bad\";");
if not has(compiled_bad.diagnostics, "type mismatch") { fail("frontend hid type diagnostics"); }

print "selfhost_typeck_parity_pass";
