let B = import("stdlib:language_benchmark.sapp");

assert(len(B.languages()) == 15, "language benchmark exposes 15 runtimes");
assert(B.categories() == ["startup", "recursion", "integer_loop", "array", "string", "hash_map"], "stable benchmark categories");
assert(B.expected("recursion") == "17711", "recursion checksum");
assert(B.expected("string") == "10000", "string checksum");

let langs = B.languages(); let cats = B.categories(); let li = 0;
while li < len(langs) {
    let ci = 0;
    while ci < len(cats) {
        let src = B.source(langs[li].id, cats[ci]);
        assert(len(src) > 5, "non-empty source for " + langs[li].id + "/" + cats[ci]);
        ci = ci + 1;
    }
    li = li + 1;
}

let pb = langs[0];
let startup = B.run_once(pb, "startup", 10);
assert(startup.ok and startup.stdout == "1", "pblang subprocess fixture runs");
let recursion = B.run_once(pb, "recursion", 10);
assert(recursion.ok and recursion.stdout == "17711", "pblang recursive fixture runs");
assert(B.run_once(map{ id: "python", commands: ["rm"] }, "startup", 0).status == "invalid-timeout", "timeout bounds fail closed");
assert(B.run_once(map{ id: "not-registered", commands: ["sh"] }, "startup", 10).status == "unsupported-language", "caller cannot inject process specs");
assert(B.benchmark(pb, "startup", 21, 10).status == "invalid-repetitions", "sample count is bounded");
let measured = B.benchmark(pb, "startup", 3, 10);
assert(measured.status == "ok", "pblang benchmark completes");
assert(len(measured.samples_ms) == 3, "raw samples are retained");
assert(measured.p95_ms >= measured.median_ms, "p95 is reported");
assert(measured.stddev_ms >= 0 and measured.mad_ms >= 0 and measured.iqr_ms >= 0, "dispersion metrics are reported");
assert(measured.stability != "insufficient", "three samples receive a stability classification");

print "language_benchmark_pass";
