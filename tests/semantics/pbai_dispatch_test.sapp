let D = import("stdlib:pbai_dispatch.sapp");

fn fail(message) { throw "FAIL " + message; }
fn eq(actual, expected, message) { if actual != expected { fail(message + " got=" + str(actual) + " expected=" + str(expected)); } }
fn truthy(value, message) { if not value { fail(message); } }

let embedded = D.plan("Explain this pblang function", 0.92, map{ profile: "embedded" });
truthy(embedded.admitted, "grounded embedded request admitted");
eq(embedded.selected_lane, "embedded", "smallest grounded lane selected");
truthy(not embedded.parallel and embedded.max_active_experts == 1, "one expert runs at a time");

let nano = D.plan("Generate pblang code", 0.9, map{ profile: "embedded" });
eq(nano.selected_lane, "nano", "embedded generation uses Nano");
truthy(nano.requires_independent_verifier, "generated output requires an independent verifier");

let embedded_generation = D.plan("Generate pblang code", 0.9, map{ profile: "embedded" });
truthy(embedded_generation.requires_independent_verifier and not embedded_generation.parallel,
    "embedded generation publishes verification without parallel execution");

let thought = D.plan("Think through this failure", 0.9, map{ profile: "external" });
eq(thought.selected_lane, "brain", "reasoning activates the cognitive loop");

let low = D.plan("ambiguous request", 0.2, map{ profile: "external" });
eq(low.selected_lane, "brain", "low confidence escalates exactly once");

let max = D.plan("Generate pblang code", 0.9, map{ profile: "external", quality: "high", allow_max: true, max_available: true });
eq(max.selected_lane, "max", "Max requires explicit high-quality opt-in and availability");
truthy(not max.parallel and max.fallbacks[0] == "brain", "Max fallbacks stay serial");

let tool_denied = D.plan("Use tool to inspect this", 0.9, map{ profile: "external" });
truthy(not tool_denied.admitted and tool_denied.selected_lane == "none", "tool use is denied without an explicit grant");
let tool_allowed = D.plan("Use tool to inspect this", 0.9, map{ profile: "external", allow_tools: true });
truthy(tool_allowed.admitted and tool_allowed.selected_lane == "tool", "tool lane needs explicit permission");

truthy(not D.plan("learn: this local fact", 0.9, map{ profile: "external" }).admitted,
    "plain chat cannot silently persist learning");
truthy(not D.plan("learn this local fact", 0.9, map{ profile: "external" }).admitted,
    "space-form learning commands cannot fall through to the embedded response lane");
truthy(not D.plan("teach this local fact", 0.9, map{ profile: "external" }).admitted,
    "space-form teaching commands require the explicit learning grant");

let security = D.plan("Review this security capability", 0.9, map{ profile: "external" });
truthy(security.advisory_only and security.requires_independent_verifier, "AI security output never becomes sole authority");

let side_effect = D.plan("change setting", 0.9, map{ profile: "pbos", task: "system", side_effect: true });
truthy(not side_effect.admitted and side_effect.requires_approval, "side effects require local approval");

truthy(not D.plan("12345", 1, map{ max_prompt_chars: 4 }).ok,
    "oversized prompts fail closed");

print "pbai_dispatch_pass";
