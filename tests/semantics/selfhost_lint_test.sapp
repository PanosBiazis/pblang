// Test: the self-hosted static linter (frontend_lint) — a step toward static
// safety + tooling (and the basis for IDE diagnostics), written in pblang.
// Detects unreachable code (sound, no builtin allowlist needed) plus the
// semantic analyzer's warnings.

let fe = import("stdlib/compiler/selfhost_frontend.sapp");

// --- Unreachable code after `return` ---
let r1 = fe.frontend_lint("fn f(x) { return x; let y = 5; }");
assert(r1.ok == false, "unreachable-after-return is flagged");
assert(r1.count >= 1, "at least one diagnostic for dead code");
assert(r1.diagnostics[0].kind == "warning", "dead code is a warning");

// --- Unreachable after `break`/`continue` inside a loop ---
let r2 = fe.frontend_lint("fn h() { for i 10 { break; let q = 1; } }");
assert(r2.count >= 1, "unreachable after break flagged");
let r3 = fe.frontend_lint("fn h2() { for i 10 { continue; let q = 1; } }");
assert(r3.count >= 1, "unreachable after continue flagged");

// --- Clean code produces NO diagnostics (no false positives) ---
let clean = fe.frontend_lint("fn g(x) { if x > 0 { return 1; } return 0; } "
    + "let a = [1, 2, 3]; let s = 0; for v in a { s = s + v; } let z = g(s);");
assert(clean.ok == true, "well-formed program lints clean");
assert(clean.count == 0, "no false-positive diagnostics on clean code");

// --- Nested unreachable (dead code in an if-branch) ---
let r4 = fe.frontend_lint("fn k(x) { if x { return 1; let dead = 2; } return 0; }");
assert(r4.count >= 1, "dead code inside an if-branch flagged");

// --- A return as the LAST statement is NOT unreachable (no false positive) ---
let r5 = fe.frontend_lint("fn ok_last(x) { let y = x + 1; return y; }");
assert(r5.count == 0, "trailing return is fine");

// --- Undefined-name detection (sound: builtins/forward-refs/closures not flagged) ---
let u1 = fe.frontend_lint("fn f(x) { return undefnedvar + x; }");
assert(u1.count >= 1, "genuine typo (undefined name) is flagged");
assert(u1.diagnostics[u1.count - 1].kind == "error", "undefined name is an error");

let u2 = fe.frontend_lint("fn a(x) { return b(x); } fn b(x) { return x * 2; } let z = a(5);");
assert(u2.count == 0, "forward reference to a later-declared fn is NOT undefined");

let u3 = fe.frontend_lint("fn g(arr) { let s = 0; for v in arr { s = s + len(str(v)); } push(arr, s); return num_sqrt(s); }");
assert(u3.count == 0, "host builtins (len/str/push/num_sqrt) are not flagged undefined");

let u4 = fe.frontend_lint("fn mk(n) { return fn(x) { return x + n; }; } let h = mk(3);");
assert(u4.count == 0, "closure capturing an enclosing param is not undefined");

print "selfhost_lint_pass";
