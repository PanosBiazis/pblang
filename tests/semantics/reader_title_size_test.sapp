// Reader-owned title control uses the existing eight-field appearance contract.
let App=import("../../examples/declarative_browser/app.sapp");let Profile=import("../../examples/declarative_browser/appearance_profile.sapp");
let S=import("../../examples/declarative_browser/settings_layout.sapp");
let GUI=import("stdlib:gui.sapp");let D=import("stdlib:browser_document.sapp");let n=0;
fn check(ok,label) {assert(ok,label);n=n+1;}
fn act(c,name) {
    if c.settings and c.settings_layout!=nil {
        let index=S.index(name,true,c.preferences.reload!=nil);
        if index>=0 {App.settings_page(c,num_floor(index/c.settings_layout.capacity));App.update(c,[]);}
    }
    let w=GUI.get(c.form,name);check(w!=nil and w.enabled,"control available: "+name);
    c.form.focus=name;App.update(c,[map{type:"keydown",key:"Enter"}]);App.update(c,[map{type:"keyup",key:"Enter"}]);
}
let source="<article><h1>Imported title — Τίτλος</h1><p>"+str_repeat("Reading text. ",18)+"</p><a href=\"pb://guide\">Guide</a></article>";
let state=map{saved:Profile.encode(Profile.defaults()),writes:0};
let saver=fn(style){state.saved=Profile.encode(style);state.writes=state.writes+1;return map{ok:true};};
let loader=fn(){return map{ok:true,appearance:Profile.decode(state.saved).appearance,save:saver};};
let c=App.create("local","dark",nil,source);App.enable_preferences(c,nil,saver,"Ready",loader);App.refresh(c);
let doc=D.inspect(c.session.snapshot().document);act(c,"appearance");act(c,"title_size");
check(c.preferences.draft.title_size==32 and c.appearance.title_size==28 and state.writes==0,"title draft does not apply or write");
check(c.preferences.draft.body_size==16 and c.preferences.draft.font_scale==1,"title independent of body and scale");
act(c,"appearance");act(c,"appearance");check(c.preferences.draft.title_size==28,"Done discards title draft");
act(c,"title_size");act(c,"style_apply");check(c.appearance.title_size==32 and state.writes==0,"Apply changes title without saving");
act(c,"appearance");check(GUI.get(c.form,"page_title").font_size==32,"native form gets new title size");
check(D.inspect(c.session.snapshot().document)==doc,"appearance preserves imported content");
act(c,"appearance");act(c,"style_save");let saved=Profile.decode(state.saved);check(saved.ok and saved.appearance.title_size==32 and state.writes==1,"v1 saves title");
act(c,"title_size");check(c.preferences.draft.title_size==36,"next title preset");act(c,"style_reload");check(c.preferences.draft.title_size==32 and c.appearance.title_size==32 and state.writes==1,"Reload restores saved title without write");
act(c,"appearance");act(c,"block1");check(c.appearance.title_size==32,"local navigation preserves title");act(c,"home");check(D.inspect(c.session.snapshot().document)==doc and c.appearance.title_size==32,"Home restores imported document with title style");
// A new imported session accepts the same old-schema saved style.
let other=App.create("local","light",saved.appearance,"<article><h1>Second document</h1><p>New content.</p></article>");
check(other.appearance.title_size==32 and GUI.get(other.form,"page_title").font_size==32,"new document uses saved title");other.session.close();
App.update(c,[map{type:"resize",w:320,h:240}]);App.read_page(c,2);App.update(c,[]);let anchor=c.reading_anchor;
act(c,"appearance");act(c,"title_size");act(c,"style_apply");check(c.reading_anchor==anchor,"Style preserves reading anchor");act(c,"appearance");
check(c.reading_anchor==anchor and c.reading_plan.available,"reflow keeps anchor and remains available");
for row in c.reading_plan.rows {if row.kind=="text" and row.block==-1 {check(row.size==36,"paginated title uses chosen size");}}
act(c,"appearance");act(c,"style_reset");check(c.appearance==Profile.defaults() and Profile.decode(state.saved).appearance==Profile.defaults(),"Reset restores and saves all defaults");
// Non-preset developer values remain exact until the control is explicitly used.
App.configure(c,map{title_size:27});act(c,"appearance");act(c,"appearance");check(c.preferences.draft.title_size==27,"custom title retained");
act(c,"title_size");check(c.preferences.draft.title_size==20,"custom value enters documented preset sequence");
for size in [24,28,32,36,40,20] {act(c,"title_size");check(c.preferences.draft.title_size==size,"bounded title preset cycle");}
App.enable_preferences(c,nil,nil);App.refresh(c);act(c,"style_reset");check(c.appearance==Profile.defaults() and state.writes==2,"session reset does not save");
c.session.close();print "reader_title_size_pass checks="+str(n);
