// tests/semantics/selfhost_module_differential_test.sapp
//
// docs/CURRENT_STATUS.md "Recommended Next Steps" item 1: run REAL stdlib
// modules through the self-hosted compiler and DIFF against the Rust VM.
// (selfhost_differential_test covers language constructs; THIS test drives
// real, untouched stdlib/option.sapp + stdlib/result.sapp through the
// self-hosted import cache exactly as a user program would.)

let fe = import("stdlib/compiler/selfhost_frontend.sapp");
let OPT = import("stdlib/option.sapp");
let RES = import("stdlib/result.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }

let src = ""
    + "let O = import(\"stdlib/option.sapp\");\n"
    + "let R = import(\"stdlib/result.sapp\");\n"
    + "let a = O.unwrap_or(O.some(5), 0);\n"
    + "let b = O.unwrap_or(O.none(), 42);\n"
    + "let c = O.is_some(O.of(nil));\n"
    + "let d = O.unwrap_or_else(O.none(), fn() { return 7 * 3; });\n"
    + "let e = R.unwrap_or(R.ok(10), 0);\n"
    + "let f = R.unwrap_or(R.err(\"boom\"), 99);\n"
    + "let g = R.is_ok(R.ok(1));\n"
    + "let h = R.is_err(R.err(\"x\"));\n";

let r = fe.frontend_run(src);
truthy(r.ok, "self-hosted compile+run of real stdlib modules succeeds");

// diff every global against the Rust VM computing the SAME expressions
eq(r.globals["a"], OPT.unwrap_or(OPT.some(5), 0), "option.some/unwrap_or agrees");
eq(r.globals["b"], OPT.unwrap_or(OPT.none(), 42), "option.none default agrees");
eq(r.globals["c"], OPT.is_some(OPT.of(nil)), "option.of(nil) agrees");
eq(r.globals["d"], OPT.unwrap_or_else(OPT.none(), fn() { return 7 * 3; }), "unwrap_or_else closure agrees");
eq(r.globals["e"], RES.unwrap_or(RES.ok(10), 0), "result.ok agrees");
eq(r.globals["f"], RES.unwrap_or(RES.err("boom"), 99), "result.err default agrees");
eq(r.globals["g"], RES.is_ok(RES.ok(1)), "result.is_ok agrees");
eq(r.globals["h"], RES.is_err(RES.err("x")), "result.is_err agrees");

// sanity: the differential values are also the CORRECT values
eq(r.globals["a"], 5, "a = 5");
eq(r.globals["b"], 42, "b = 42");
eq(r.globals["d"], 21, "d = 21");
eq(r.globals["f"], 99, "f = 99");

print "selfhost_module_differential_pass";
