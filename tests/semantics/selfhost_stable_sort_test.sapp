let FE=import("stdlib:compiler/selfhost_frontend.sapp");
let VM=import("stdlib:compiler/vm.sapp");
let PB=import("stdlib:selfhost_pbck.sapp");
let program="let input=[map{k:2,id:0},map{k:1,id:1},map{k:2,id:2},map{k:1,id:3},map{k:0,id:4}];"
    + "let output=S.stable_sort_by(input,fn(a,b){return a.k-b.k;});"
    + "let ids=[];for row in output {push(ids,row.id);}"
    + "let bad=try map{ok:true,value:S.stable_sort_by([2,1],fn(a,b){return nil;})} catch map{ok:false};"
    + "let empty=S.stable_sort_by([],fn(a,b){throw nil;});"
    + "let result=[ids,input[0].id,bad.ok,empty];";
let expected=[[4,1,3,0,2],0,false,[]];
let imported=FE.frontend_run_bounded("let S=import(\"stdlib:functional.sapp\");"+program,
    map{max_steps:30000,max_frames:24,max_modules:10,max_source_bytes:32768});
if not imported.ok or imported.globals.result != expected {throw "FAIL selfhost-stable-sort: actual import";}
// Trusted test source read; the assertion is not a pre-allocation I/O bound.
let helper=fs_read("stdlib/functional_sort.sapp");
if len(str_to_bytes(helper))>8192 {throw "FAIL selfhost-stable-sort: helper fixture size";}
let source=helper+"\nlet S=map{stable_sort_by:stable_sort_by};"+program;
let compiled=FE.frontend_compile(source);
if not compiled.ok or len(compiled.diagnostics)!=0 {throw "FAIL selfhost-stable-sort: compile";}
let limits=map{max_steps:12000,max_frames:24};
let plain=VM.run_bounded(compiled.chunk,limits);
let optimized=FE.frontend_run_bounded(source,limits);
let restored=VM.run_bounded(PB.deserialize_chunk(PB.serialize_chunk(compiled.chunk)),limits);
if plain.globals.result != expected or not optimized.ok or optimized.globals.result != expected or restored.globals.result != expected {
    throw "FAIL selfhost-stable-sort: plain/optimized/serialized result";
}
if plain.runtime.steps != restored.runtime.steps {throw "FAIL selfhost-stable-sort: instruction accounting";}
print "selfhost_stable_sort_pass";
