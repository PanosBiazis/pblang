let App=import("../../examples/declarative_browser/app.sapp");let S=import("../../examples/declarative_browser/settings_layout.sapp");let GUI=import("stdlib:gui.sapp");
let checks=0;fn check(value,label) {assert(value,label);checks=checks+1;}
fn press(c,key) {App.update(c,[map{type:"keydown",key:key}]);App.update(c,[map{type:"keyup",key:key}]);}
fn bounds(c) {for w in c.form.widgets {check(w.x>=0 and w.y>=0 and w.x+w.w<=c.width and w.y+w.h<=c.height,"settings stay inside viewport");}}
for height in [240,288,320,480,844] {
    let c=App.create();c.width=320;c.height=height;App.refresh(c);c.form.focus="appearance";press(c,"Enter");bounds(c);
    check(c.form.focus=="font_family","first choice focused");
    let seen=map{};let count=if c.settings_layout==nil {1}else{c.settings_layout.count};
    for page count {
        if page>0 {press(c,"PageDown");}bounds(c);
        for name in S.names() {let w=GUI.get(c.form,name);if w!=nil {seen[name]=true;c.form.focus=name;press(c,"Enter");check(c.form.focus==name,"changed choice remains focused");}}
    }
    check(len(map_keys(seen))==6,"all six choices reachable");
    c.form.focus="appearance";press(c,"Enter");check(not c.settings and c.form.focus=="appearance","Done returns to reading");c.session.close();
}
let c=App.create();c.width=320;c.height=240;App.refresh(c);c.form.focus="appearance";press(c,"Enter");
let before=c.reading_anchor;App.update(c,[map{type:"keydown",key:"PageDown"}]);check(c.settings_layout.page==1,"next option page");App.update(c,[map{type:"keydown",key:"PageDown"}]);check(c.settings_layout.page==1,"held page key not repeated");App.update(c,[map{type:"keyup",key:"PageDown"}]);
press(c,"End");check(c.form.focus=="density" and c.settings_layout.page==5,"End focuses last option");
App.update(c,[map{type:"resize",w:390,h:844}]);check(c.form.focus=="density" and c.settings_layout==nil,"expanded view retains option");
App.update(c,[map{type:"resize",w:320,h:240}]);check(c.form.focus=="density" and c.settings_layout.page==5,"shrinking keeps focused option visible");bounds(c);
App.configure(c,map{font_family:"monospace",button_size:40,font_scale:1.5,line_height:2.5});App.update(c,[]);bounds(c);check(c.form.focus=="density","extreme document style cannot hide control");
press(c,"Home");check(c.form.focus=="font_family","Home focuses first choice");
c.form.focus="settings_next";App.update(c,[map{type:"keydown",key:"Enter"}]);check(c.form.focus=="body_size","page button focuses new choice");let size=c.appearance.body_size;App.update(c,[map{type:"keydown",key:"Enter"}]);check(c.appearance.body_size==size,"held page button cannot activate new choice");App.update(c,[map{type:"keyup",key:"Enter"}]);
c.form.focus="settings_next";App.update(c,[map{type:"resize",w:390,h:844}]);
// Extreme styling can retain compact mode; disappearing/disabled page controls fall back to the remembered option.
App.configure(c,map{font_family:"sans",button_size:15,font_scale:1,line_height:1.45});App.update(c,[]);
check(c.form.focus=="body_size" and c.settings_layout==nil,"removed pager restores remembered choice");
App.configure(c,map{button_size:40,font_scale:1.5});App.update(c,[map{type:"resize",w:320,h:4320}]);
check(c.settings_layout!=nil and c.settings_layout.capacity==6,"tall narrow windows also protect enlarged choice labels");bounds(c);
check(c.reading_anchor==before,"settings paging never moves document anchor");check((try App.settings_page(c,1.5) catch nil)==nil,"fractional page rejected");
c.session.close();print "reader_compact_settings_pass checks="+str(checks);
