let GUI=import("stdlib:gui.sapp");let checks=0;
fn check(value,message) {assert(value,message);checks=checks+1;}
fn form(kind="textbox") {
    let f=GUI.form("Committed text",400,200);
    let widget=if kind=="textbox" {GUI.textbox("entry",0,0,200,32,"")} else {GUI.textarea("entry",0,0,200,100,"")};
    GUI.add(f,widget);f.focus="entry";return f;
}
fn send(f,key,text=nil,explicit=true,ctrl=false,shift=false) {
    let event=map{type:"keydown",key:key,ctrl:ctrl,shift:shift};if explicit {event.text=text;}
    GUI.handle_event(f,event);GUI.handle_event(f,map{type:"keyup",key:key});
}
fn value(f) {return GUI.get(f,"entry").value;}
let f=form();send(f,"A",nil,false);check(value(f)=="a","legacy physical text retained");
send(f,"A","Α");send(f,"B","β");check(value(f)=="aΑβ","committed Greek case preserved independently of key");
send(f,"Unknown","🙂é");check(value(f)=="aΑβ🙂é","multi scalar committed text");
for bad in ["",nil,123,true,[],map{},"\n","\t",strfromcharcode(0),strfromcharcode(127),strfromcharcode(159)] {
    let old=value(f);send(f,"A",bad);check(value(f)==old,"invalid or empty explicit text must not fall back to A");
}
let too_long="";for i in range(0,257) {too_long=too_long+"a";}send(f,"A",too_long);check(value(f)=="aΑβ🙂é","bounded committed event");
send(f,"A","q",true,true);check(value(f)=="aΑβ🙂é","control shortcut never inserts text");
send(f,"Q","Ω");check(value(f)=="Ω","Ctrl+A selection replaced exactly");
send(f,"Backspace","");check(value(f)=="","navigation edits are still physical");
let w=GUI.get(f,"entry");w.max_chars=3;
send(f,"Q","αβ");send(f,"Q","γδ");check(value(f)=="αβ","textbox rejects whole over-budget commit");
send(f,"Q","γ");check(value(f)=="αβγ","textbox exact limit");
GUI.handle_event(f,map{type:"keydown",key:"A",ctrl:true,text:""});GUI.handle_event(f,map{type:"keyup",key:"A"});
send(f,"Q","κλμ");check(value(f)=="κλμ","replacement capacity excludes selected text");
let area=form("textarea");let area_widget=GUI.get(area,"entry");area_widget.max_chars=3;
send(area,"Q","αβ");send(area,"Q","γδ");check(value(area)=="αβ","textarea rejects whole over-budget commit");
send(area,"Enter","");check(value(area)=="αβ\n","textarea Enter retained");
send(area,"Q","x");check(value(area)=="αβ\n","textarea exact capacity retained");
send(area,"Backspace","");send(area,"Q","γ");check(value(area)=="αβγ","textarea delete and refill");
let repeat=form();GUI.handle_event(repeat,map{type:"keydown",key:"A",text:"α"});GUI.handle_event(repeat,map{type:"keydown",key:"A",text:"β"});
check(value(repeat)=="αβ","ordered repeated commits each applied once");
GUI.handle_event(repeat,map{type:"keyup",key:"A"});check(len(map_keys(repeat.pressed_keys))==0,"release clears key identity");
print "gui_committed_text_pass checks="+str(checks);
