// tests/semantics/codegen_device_native_test.sapp — a kernel device driver driven by GENERATED
// NATIVE machine code (no Rust): open + SIZED read + write, all via syscalls. The sized read
// is the fix for the unbounded-device gotcha — reading exactly N bytes from /dev/urandom
// never blocks on EOF the way fs_read_bytes would.

let X = import("stdlib/codegen_x64.sapp");

fn fail(m) { throw "FAIL " + m; }

// generate a native binary that reads 16 bytes from /dev/urandom and writes them to stdout
let elf = X.build_read_device("/dev/urandom", 16);
let path = "pbdev_read.bin";
fs_write_bytes(path, elf);
proc_spawn_wait("bash", ["-c", "chmod +x " + path]);

// it must emit exactly 16 bytes and NOT hang (sized read) — count via wc -c
let r = proc_spawn_wait("bash", ["-c", "./" + path + " | wc -c"]);
let cnt = parse_number(str_trim(try r.stdout catch ""));
if cnt != 16 { fail("native device read should output 16 bytes, got " + str(cnt)); }

// it reads the RNG driver, so two runs differ (md5 of the 16 bytes)
let h1 = proc_spawn_wait("bash", ["-c", "./" + path + " | md5sum"]);
let h2 = proc_spawn_wait("bash", ["-c", "./" + path + " | md5sum"]);
proc_spawn_wait("bash", ["-c", "rm -f " + path]);
if (try h1.stdout catch "a") == (try h2.stdout catch "b") { fail("RNG device reads should differ between runs"); }

print "codegen_device_native_pass";
