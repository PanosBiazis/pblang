// tests/semantics/nn_enrich_test.sapp — fix + enrichment for stdlib/nn.sapp
//
// BUG: argmax initialized best=0, so a vector of all-negative values wrongly
//   returned index 0. ENRICH: softmax, mse_loss, predict_batch, accuracy.

let nn = import("stdlib/nn.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn near(a, b, m) { if num_abs(a - b) > 0.000001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── FIX: argmax handles all-negative vectors ─────────────────────────────────────
eq(nn.argmax([0 - 3, 0 - 1, 0 - 2]), 1, "argmax of all-negative -> least negative");
eq(nn.argmax([0.1, 0.9, 0.3]), 1, "argmax positive");

// ── ENRICH: softmax ──────────────────────────────────────────────────────────────
let s = nn.softmax([1, 2, 3]);
let total = s[0] + s[1] + s[2];
near(total, 1, "softmax sums to 1");
if s[2] <= s[0] { fail("softmax should be monotonic with input"); }

// ── ENRICH: mse_loss ─────────────────────────────────────────────────────────────
near(nn.mse_loss([1, 2], [1, 3]), 0.5, "mse_loss");

// ── XOR still trains (regression on the core network) ────────────────────────────
let net = nn.mlp_new(2, 4, 1, 42);
let data = [nn.sample([0, 0], [0]), nn.sample([0, 1], [1]), nn.sample([1, 0], [1]), nn.sample([1, 1], [0])];
nn.train(net, data, 3000, 0.5);
if nn.predict(net, [1, 0])[0] < 0.8 { fail("XOR [1,0] should predict ~1"); }
if nn.predict(net, [1, 1])[0] > 0.2 { fail("XOR [1,1] should predict ~0"); }

// ── ENRICH: predict_batch ────────────────────────────────────────────────────────
let preds = nn.predict_batch(net, [[0, 0], [1, 0]]);
eq(len(preds), 2, "predict_batch length");

print "nn_enrich_pass";
