// tests/semantics/pb_mcp_extended_test.sapp
// New pb_mcp tools: find_files (search by filename, case-insensitive) and a
// case-insensitive option for grep_code. Both reachable via call().
let mcp = import("stdlib:pb_mcp.sapp");

fn fail(m) { throw "FAIL " + m; }

// ── find_files: locate files by name fragment ────────────────────────────────
let found = mcp.find_files("pb_mcp", "stdlib");
if len(found) == 0 { fail("find_files should locate pb_mcp.sapp"); }
let any = false;
for i len(found) { if str_contains(found[i], "pb_mcp.sapp") { any = true; } }
if not any { fail("find_files result should include pb_mcp.sapp"); }

// case-insensitive name match
let found_ci = mcp.find_files("PB_MCP", "stdlib");
let any_ci = false;
for i len(found_ci) { if str_contains(found_ci[i], "pb_mcp.sapp") { any_ci = true; } }
if not any_ci { fail("find_files should be case-insensitive"); }

// ── grep_code case-insensitive option ────────────────────────────────────────
// Uppercase pattern, lowercase in source: only matches when ignore_case = true.
let sensitive = mcp.grep_code("WORKSPACE_CONTEXT", "stdlib", 20, false);
if len(sensitive) != 0 { fail("case-sensitive grep should not match different case"); }
let insensitive = mcp.grep_code("WORKSPACE_CONTEXT", "stdlib", 20, true);
if len(insensitive) == 0 { fail("case-insensitive grep should match"); }

// existing 3-arg grep_code still works (default case-sensitive)
let basic = mcp.grep_code("workspace_context", "stdlib", 20);
if len(basic) == 0 { fail("3-arg grep_code regression"); }

// ── reachable through the call() dispatcher ──────────────────────────────────
let via_call = mcp.call("find_files", map{ name: "pb_mcp", dir: "stdlib" });
if len(via_call) == 0 { fail("call(find_files) should work"); }
let in_catalog = false;
let cat = mcp.tool_catalog();
for i len(cat) { if cat[i].name == "find_files" { in_catalog = true; } }
if not in_catalog { fail("find_files should be in tool_catalog"); }

// ── file_stats: read-only metrics for a workspace file ───────────────────────
let st = mcp.file_stats("stdlib/pb_mcp.sapp");
if st.lines <= 0 { fail("file_stats lines"); }
if st.bytes <= 0 { fail("file_stats bytes"); }
if st.non_empty_lines <= 0 or st.non_empty_lines > st.lines { fail("file_stats non_empty_lines"); }
// path traversal must stay blocked on the new tool too
let blocked = try mcp.file_stats("../Cargo.toml") catch "blocked";
if blocked != "blocked" { fail("file_stats must block path traversal"); }
// reachable via call() and present in catalog
let st2 = mcp.call("file_stats", map{ path: "stdlib/pb_mcp.sapp" });
if st2.lines <= 0 { fail("call(file_stats)"); }

print "pb_mcp_extended_pass";
