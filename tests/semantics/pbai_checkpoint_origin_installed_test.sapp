// Copied real facades and explicit private storage; no original source visibility.
if platform()!="linux" {print "pbai_checkpoint_origin_skip_linux_required";os_exit(0);}
let U=import("stdlib:uuid.sapp");let parent=path_dirname(cwd());
let exe=env_get("PBLANG_BIN");assert(type(exe)=="string" and exe!="","set trusted PBLANG_BIN");
let phase=env_get("PBAI_CHECKPOINT_ORIGIN_PHASE");if phase==nil or phase=="" {phase="files";}
let allowed=["files","trusted","decoy","guards","unavailable-io","unavailable-storage","unavailable-neural"];
let valid_phase=false;for candidate in allowed {if phase==candidate {valid_phase=true;}}
assert(valid_phase,"select a bounded phase");
let root=path_join("/tmp","pbai-checkpoint-origin-installed-"+U.v4());
let caller=path_join(root,"caller");let state=path_join(root,"state");let step=["setup"];let completed=[0];
fn process(command,args) {
 let argv=["-k","1s","15s",command];for arg in args {push(argv,arg);}
 return proc_spawn_wait("/usr/bin/timeout",argv);
}
fn must(command,args) {let value=process(command,args);assert(value.exit_code==0,"fixture operation");return value;}
fn build(at) {let result=must("/usr/bin/env",["-C",at,exe,"build"]);assert(str_contains(result.stdout,"build ok"),"fixture build marker");}
fn private_dir(path) {fs_mkdirs(path);must("/bin/chmod",["700",path]);}
fn hidden(at,file,directory,action,denial="") {
 let argv=["--die-with-parent","--unshare-net","--ro-bind","/","/","--dev","/dev","--bind",root,root,
  "--tmpfs",path_join(parent,"pblang"),"--tmpfs",path_join(parent,"pbai")];
 let extra=env_get("PBAI_SOURCE_HIDE_ROOT");if type(extra)=="string" and extra!="" {push(argv,"--tmpfs");push(argv,extra);}
 for value in ["--setenv","PBAI_STATE_ROOT",state,"--setenv","PBAI_CHECKPOINT_TEST_DIR",directory,
  "--setenv","PBAI_CHECKPOINT_TEST_PHASE",action,"--chdir",at,exe,"run",file,
  "--allow-all","--deny-net","--deny-http","--deny-sqlite"] {push(argv,value);}
 if denial!="" {push(argv,denial);}
 return process("/usr/bin/bwrap",argv);
}
fn checked(result,marker) {
 if result.exit_code!=0 {print str_replace_all(result.stderr,root,"<fixture>");}
 assert(result.exit_code==0 and result.stdout==marker+"\n" and not str_contains(result.stderr,"error["),"exact child success without decoy");
}
fn example(at,file,directory,action) {
 let output=hidden(at,file,directory,action);if output.exit_code!=0 {print str_replace_all(output.stderr,root,"<fixture>");}assert(output.exit_code==0,"example success");
 let value=json_parse(output.stdout);
 assert(value.format=="pbai.checkpoint-file.example.v1" and value.phase==action and not value.globally_activated,"example contract");
 if action=="write" {assert(value.saved,"saved");} else {assert(value.token==5,"restored prediction");}
 return output.stdout;
}
fn fixture(directory) {
 private_dir(directory);fs_write(path_join(directory,"existing.json"),"unchanged-sentinel");
 fs_write(path_join(directory,"oversized.json"),str_repeat(" ",4097));
 fs_write_bytes(path_join(directory,"invalid-utf8.json"),[255]);
 fs_write(path_join(directory,"duplicate.json"),"{\"format\":0,\"format\":1}");
 fs_mkdirs(path_join(directory,"public"));must("/bin/chmod",["755",path_join(directory,"public")]);
 must("/bin/ln",["-s","student.json",path_join(directory,"link.json")]);
 must("/bin/ln",["-s",directory,path_join(directory,"parent-link")]);
 must("/usr/bin/mkfifo",[path_join(directory,"pipe.json")]);
}
fn exercise() {
 private_dir(root);fs_mkdirs(caller);fs_mkdirs(state);fs_mkdirs(path_join(caller,"stdlib"));
 for name in ["pbai_student_checkpoint_io.sapp","secure_file.sapp","linux_dirfs.sapp","linux_dirfs_read_core.sapp",
  "pbai_neural_adapter.sapp","pbai_specialist_binding.sapp","serialization.sapp","json.sapp","csv.sapp"] {
  fs_write(path_join(path_join(caller,"stdlib"),name),"print \"DECOY_EXECUTED\";throw \"caller decoy\";\n");
 }
 for name in ["pblang","pbai"] {
  let source=path_join(parent,name);let installed=path_join(root,name);fs_mkdirs(installed);step[0]="copy "+name;
  must("/bin/cp",["-R",path_join(source,"stdlib"),path_join(installed,"stdlib")]);
  let examples=if name=="pblang" {"examples"} else {"demo"};
  fs_write(path_join(installed,"example.sapp"),fs_read(path_join(source,examples+"/pbai_student_checkpoint_file.sapp")));
  fs_write(path_join(installed,"bound.sapp"),fs_read(path_join(source,"tests/fixtures/pbai_checkpoint_bound_file.sapp")));
  fs_write(path_join(installed,"legacy.sapp"),fs_read(path_join(source,"tests/fixtures/pbai_student_checkpoint_file.sapp")));
  fs_write(path_join(installed,"direct.sapp"),"let IO=import(\"stdlib:pbai_student_checkpoint_io.sapp\");assert(IO.load_file(env_get(\"PBAI_CHECKPOINT_TEST_DIR\")+\"/student.json\").predict([6,0]).token==5,\"direct selected owner\");print \"direct_checkpoint_pass\";\n");
  fs_write(path_join(installed,"optional.sapp"),"let AI=import(\"stdlib/pbai.sapp\");let refused=try {AI.neural_specialist_checkpoint_bind(nil);false} catch true;assert(refused and len(AI.modular_catalog().adapters)==2,\"facade and optional storage separation\");print \"optional_checkpoint_pass\";\n");
  let dep=if name=="pblang" {"stdlib"} else {"../pblang/stdlib"};
  fs_write(path_join(installed,"pblang.toml"),"[package]\nname=\"checkpoint-installed-fixture\"\nversion=\"0.1.0\"\nentry=\"example.sapp\"\n[dependencies]\nstdlib={path="+json_stringify(dep)+"}\n");
 }
 if phase!="files" {
  fs_write(path_join(caller,"main.sapp"),"print 0;\n");
  fs_write(path_join(caller,"pblang.toml"),"[package]\nname=\"caller-decoy\"\nversion=\"0.1.0\"\nentry=\"main.sapp\"\n[dependencies]\nstdlib={path=\"stdlib\"}\n");build(caller);
 }
 if str_starts_with(phase,"unavailable-") {
  let name="pbai_neural_adapter.sapp";if phase=="unavailable-io" {name="pbai_student_checkpoint_io.sapp";} elif phase=="unavailable-storage" {name="secure_file.sapp";}
  let selected=path_join(root,"pblang/stdlib/"+name);fs_remove(selected);
  for mode in ["missing","broken"] {
   if mode=="broken" {fs_write(selected,"throw \"synthetic selected dependency failure\";\n");}
   for repo in ["pblang","pbai"] {
    step[0]=phase+" "+mode+" "+repo;let at=path_join(root,repo);build(at);let dir=path_join(root,mode+repo);private_dir(dir);
    let optional=hidden(caller,path_join(at,"optional.sapp"),dir,"read","--deny-ffi");
    if phase=="unavailable-storage" {
     // secure_file also belongs to the facade's pre-existing compiler dependencies.
     assert(optional.exit_code!=0 and not str_contains(optional.stdout,"DECOY_EXECUTED")
      and str_contains(optional.stderr,if mode=="missing" {"import not found"} else {"synthetic selected dependency failure"}),"required facade dependency fails without caller substitution");
    } else {checked(optional,"optional_checkpoint_pass");}
    let failed=hidden(caller,path_join(at,"example.sapp"),dir,"write");
    assert(failed.exit_code!=0 and not str_contains(failed.stdout,"DECOY_EXECUTED")
     and not str_contains(failed.stdout,"pbai.checkpoint-file.example.v1") and not fs_exists(path_join(dir,"student.json")),"selected dependency failure never substitutes caller or writes checkpoint");
    completed[0]=completed[0]+1;
   }
  }
  return nil;
 }
 let expected_write="";let expected_read="";let expected_checkpoint="";
 for repo in ["pblang","pbai"] {
  let at=path_join(root,repo);build(at);step[0]=phase+" "+repo;
  assert(not str_contains(fs_read(path_join(at,"pblang.lock")),parent),"copied lock excludes original checkout");
  if phase=="guards" {
   let dir=path_join(root,repo+"-guard");fixture(dir);
   checked(hidden(caller,path_join(at,"bound.sapp"),dir,"write"),"checkpoint_write_pass");
   let artifact=fs_read(path_join(dir,"student.json"));let tampered=json_parse(artifact);tampered.steps=tampered.steps+1;
   fs_write(path_join(dir,"tampered.json"),json_stringify(tampered));fs_write(path_join(dir,"public/student.json"),artifact);
   checked(hidden(caller,path_join(at,"bound.sapp"),dir,"read"),"checkpoint_read_pass");
   for denial in ["--deny-ffi","--deny-exec"] {
    checked(hidden(caller,path_join(at,"bound.sapp"),dir,"denied",denial),"checkpoint_denied_capability_pass");
    assert(not fs_exists(path_join(dir,"denied.json")),"denied save creates no output");
   }
   assert(fs_read(path_join(dir,"student.json"))==artifact and fs_read(path_join(dir,"existing.json"))=="unchanged-sentinel"
    and not fs_exists(path_join(dir,"invalid.json")) and not fs_exists(path_join(dir,"public/other.json")),"rejected destinations and parent checkpoint unchanged");
   assert(str_trim(must("/usr/bin/stat",["-c","%a",path_join(dir,"student.json")]).stdout)=="600","new file mode 0600");
  } else {
   let modes=["decoy"];if phase=="files" {modes=["foreign"];} elif phase=="trusted" {modes=["trusted"];}
   for mode in modes {
    step[0]=repo+" "+mode;let dir=path_join(root,repo+"-"+mode);private_dir(dir);
    let origin=if mode=="trusted" {at} else {caller};let app=path_join(at,"example.sapp");
    let wrote=example(origin,app,dir,"write");let read=example(origin,app,dir,"read");let checkpoint=fs_read(path_join(dir,"student.json"));
    if expected_write!="" {assert(wrote==expected_write and read==expected_read and checkpoint==expected_checkpoint,"both facades and directories have identical results and bytes");}
    expected_write=wrote;expected_read=read;expected_checkpoint=checkpoint;
    checked(hidden(origin,path_join(at,"direct.sapp"),dir,"read"),"direct_checkpoint_pass");
    if mode=="trusted" {
     let legacy_dir=path_join(root,repo+"-legacy");fixture(legacy_dir);
     checked(hidden(at,path_join(at,"legacy.sapp"),legacy_dir,"write"),"checkpoint_write_pass");
     checked(hidden(at,path_join(at,"legacy.sapp"),legacy_dir,"read"),"checkpoint_read_pass");
    }
   }
  }
  completed[0]=completed[0]+1;
 }
}
let passed=try {exercise();true} catch false;
let removed=process("/bin/rm",["-rf","--",root]);
assert(passed,"checkpoint installed acceptance: "+step[0]);assert(removed.exit_code==0,"owned fixture cleanup");
assert(completed[0]==if str_starts_with(phase,"unavailable-") {4} else {2},"all product cases checked");
print "pbai_checkpoint_origin_"+phase+"_pass";
