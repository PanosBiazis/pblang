// tests/semantics/tls_stub_test.sapp — W4-gamma: TLS stub exports test
import "stdlib:tls.sapp";

// Verify all exports exist and are functions
if type(tls.listen_tls) == "closure" or type(tls.listen_tls) == "fn" {
    print "tls.listen_tls: exported";
} else {
    throw "FAIL: tls.listen_tls not a function type=" + type(tls.listen_tls);
}

if type(tls.serve_once_tls) == "closure" or type(tls.serve_once_tls) == "fn" {
    print "tls.serve_once_tls: exported";
} else {
    throw "FAIL: tls.serve_once_tls not a function";
}

// Calling stub returns error map (not nil, not crash)
let result = tls.listen_tls("127.0.0.1:8443", "/etc/ssl/cert.pem", "/etc/ssl/key.pem");
if result != nil and type(result) == "map" {
    print "tls.listen_tls stub: ok (returns error map)";
} else {
    throw "FAIL: tls.listen_tls should return error map";
}

print "tls_stub_test: pass";
