let img = import("stdlib:image_processing.sapp");

let rgb = [
    [[0, 0, 0], [255, 255, 255]],
    [[255, 0, 0], [0, 0, 255]]
];

let gray = img.to_grayscale_image(rgb);
assert(img.width(gray) == 2, "width should be 2");
assert(img.height(gray) == 2, "height should be 2");
assert(gray[0][0] == 0, "black should map to 0");
assert(gray[0][1] == 255, "white should map to 255");

let hist = img.histogram(gray);
assert(hist[0] == 1, "histogram should count black pixel");
assert(hist[255] == 1, "histogram should count white pixel");

let resized = img.resize_nearest(gray, 4, 4);
assert(img.width(resized) == 4, "nearest resize width");
assert(img.height(resized) == 4, "nearest resize height");

let crop = img.crop(gray, 1, 0, 1, 2);
assert(crop[0][0] == 255, "crop should keep right column top");

let flipped = img.flip_horizontal(gray);
assert(flipped[0][0] == 255, "horizontal flip should swap columns");

let rot = img.rotate90([[1, 2], [3, 4]]);
assert(rot[0][0] == 3, "rotate90 first value");
assert(rot[1][0] == 4, "rotate90 second row first value");

let edges = img.edge_detect_sobel([[0, 0, 0], [0, 255, 0], [0, 0, 0]]);
assert(img.width(edges) == 3, "sobel keeps width");
assert(img.height(edges) == 3, "sobel keeps height");

let bw = img.threshold([[10, 200]], 128);
assert(bw[0][0] == 0, "threshold low");
assert(bw[0][1] == 255, "threshold high");

print "image_processing_stdlib_pass";
