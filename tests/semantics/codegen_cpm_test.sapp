let C = import("stdlib:codegen_cpm.sapp");

fn fail(m) { throw "FAIL codegen_cpm: " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn u16(n) { n = n % 65536; if n < 0 { n = n + 65536; } return n; }

// Bounded execution model for the exact Z80 subset emitted by codegen_cpm.
fn run_com(code) {
    let mem = []; let i = 0; while i < 65536 { array_push(mem, 0); i = i + 1; }
    i = 0; while i < len(code) { mem[0x100 + i] = code[i]; i = i + 1; }
    let a = 0; let b = 0; let c = 0; let d = 0; let e = 0; let h = 0; let l = 0;
    let zf = false; let carry = false; let pc = 0x100; let steps = 0;
    fn rd16(m, p) { return m[p] + m[p + 1] * 256; }
    fn wr16(m, p, n) { n = u16(n); m[p] = n % 256; m[p + 1] = num_floor(n / 256); }
    while true {
        steps = steps + 1; if steps > 2000000 { fail("execution step limit"); }
        let op = mem[pc]; pc = pc + 1;
        if op == 0x21 { let n = rd16(mem, pc); pc = pc + 2; h = num_floor(n / 256); l = n % 256; }
        elif op == 0x11 { let n = rd16(mem, pc); pc = pc + 2; d = num_floor(n / 256); e = n % 256; }
        elif op == 0x2A { let p = rd16(mem, pc); pc = pc + 2; let n = rd16(mem, p); h = num_floor(n / 256); l = n % 256; }
        elif op == 0x22 { let p = rd16(mem, pc); pc = pc + 2; wr16(mem, p, h * 256 + l); }
        elif op == 0xED {
            let sub = mem[pc]; pc = pc + 1;
            if sub == 0x4B { let p = rd16(mem, pc); pc = pc + 2; let n = rd16(mem, p); b = num_floor(n / 256); c = n % 256; }
            elif sub == 0x5B { let p = rd16(mem, pc); pc = pc + 2; let n = rd16(mem, p); d = num_floor(n / 256); e = n % 256; }
            elif sub == 0x52 {
                let n = u16((h * 256 + l) - (d * 256 + e) - (if carry { 1 } else { 0 }));
                h = num_floor(n / 256); l = n % 256; zf = n == 0;
            } else { fail("unknown ED opcode " + str(sub)); }
        } elif op == 0x7C { a = h; }
        elif op == 0x7A { a = d; }
        elif op == 0xB5 { a = bit_or(a, l); zf = a == 0; carry = false; }
        elif op == 0xB3 { a = bit_or(a, e); zf = a == 0; carry = false; }
        elif op == 0xB7 { zf = a == 0; carry = false; }
        elif op == 0x19 {
            let n = (h * 256 + l) + (d * 256 + e); carry = n > 65535; n = u16(n);
            h = num_floor(n / 256); l = n % 256;
        } elif op == 0x09 {
            let n = (h * 256 + l) + (b * 256 + c); carry = n > 65535; n = u16(n);
            h = num_floor(n / 256); l = n % 256;
        } elif op == 0x1B {
            let n = u16(d * 256 + e - 1); d = num_floor(n / 256); e = n % 256;
        } elif op == 0x2B {
            let n = u16(h * 256 + l - 1); h = num_floor(n / 256); l = n % 256;
        } elif op == 0xC3 {
            let target = rd16(mem, pc); pc = target;
            if target == 0 { return map{ result: h * 256 + l, steps: steps }; }
        } elif op == 0xCA {
            let target = rd16(mem, pc); pc = pc + 2; if zf { pc = target; }
        } else { fail("unknown opcode " + str(op) + " at " + str(pc - 1)); }
        if pc < 0 or pc > 65535 { fail("branch outside address space"); }
    }
}

fn verify(ir, expected, tag) { eq(run_com(C.compile_program(ir)).result, expected % 65536, tag); }

eq(C.metadata().os_min, "2.2", "CP/M version floor");
eq(C.metadata().exit, "jp-0000h", "CP/M termination contract");
verify([["seti",0,2],["seti",1,3],["add",0,1],["seti",1,4],["mul",0,1],["seti",1,1],["sub",0,1]], 19, "arithmetic");
verify([["seti",0,0],["seti",1,10],["loop",1,[["add",0,1]]]], 55, "loop sum");
verify([["seti",0,3],["seti",1,4],["seti",2,9],["mul",1,0],["add",0,2]], 12, "multiply preserves virtual registers");
verify([["seti",0,1],["seti",1,0],["ifnz",1,[["seti",0,99]],[["addi",0,6]]]], 7, "if else");

let nested = [["seti",0,0],["seti",1,3],["loop",1,[["seti",2,2],["loop",2,[["addi",0,1]]]]]];
verify(nested, 6, "nested loops");

let rejected = false;
try { C.compile_program([["seti",0,65536]]); } catch { rejected = true; }
if not rejected { fail("reject unrepresentable immediate"); }

print "codegen_cpm_pass";
