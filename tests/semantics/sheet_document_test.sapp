let Sheet=import("stdlib:sheet_document.sapp");
fn rejects(action) { let failed=false; try { action(); } catch { failed=true; } assert(failed,"invalid sheet rejected"); }
let original=Sheet.create(2,2);
let edited=Sheet.edit(original,[map{row:0,column:0,value:"12.5"},map{row:1,column:0,value:"7.5"},
    map{row:0,column:1,value:"=not_executed()"}]);
assert(original.cells[0][0]=="" and edited.cells[0][0]=="12.5","edits do not mutate the source");
assert(Sheet.sum_column(edited,0).value==20 and Sheet.sum_column(edited,1).numeric_cells==0,
    "numeric literals sum; formula-looking strings are inert");
assert(Sheet.encode(Sheet.decode(Sheet.encode(edited)))==Sheet.encode(edited),"native format roundtrip");
let reordered=Sheet.decode(" { \"cells\": [[\"\",\"\"],[\"\",\"\"]], \"format\": \"pblang.sheet-document.v1\" } ");
assert(Sheet.encode(reordered)==Sheet.encode(original),"key order and whitespace normalize identically");
let unicode=Sheet.edit(original,[map{row:0,column:0,value:str_repeat("é",128)}]);
assert(Sheet.validate(unicode).text_bytes==256,"exact UTF-8 cell boundary");
rejects(fn(){ Sheet.edit(original,[map{row:0,column:0,value:str_repeat("é",129)}]); });
rejects(fn(){ Sheet.edit(original,[map{row:0,column:0,value:"new"},map{row:1,column:1,value:str_repeat("x",257)}]); });
assert(original.cells[0][0]=="","failed transaction leaves original unchanged");
rejects(fn(){ Sheet.edit(original,[map{row:0,column:0,value:"a"},map{row:0,column:0,value:"b"}]); });
rejects(fn(){ Sheet.create(33,1); }); rejects(fn(){ Sheet.create(1,9); });
rejects(fn(){ Sheet.create(0,1); }); rejects(fn(){ Sheet.create(1.5,1); });
rejects(fn(){ Sheet.decode("{\"format\":\"pblang.sheet-document.v1\",\"cells\":[[\"x\"]],\"cells\":[[\"y\"]]}"); });
rejects(fn(){ Sheet.decode("{\"format\":\"pblang.sheet-document.v1\",\"cells\":[[\"x\"]],\"extra\":1}"); });
rejects(fn(){ Sheet.decode("{\"format\":\"pblang.sheet-document.v1\",\"cells\":[[\"x\"],[]]}"); });
rejects(fn(){ Sheet.decode("[[[[[0]]]]]"); });
rejects(fn(){ Sheet.decode(Sheet.encode(original)+" junk"); });
let full=Sheet.create(32,8);
for r in range(0,32) { full.cells[r][0]=str_repeat("x",256); }
assert(Sheet.validate(full).text_bytes==8192 and Sheet.decode(Sheet.encode(full)).cells[31][0]==full.cells[31][0],
    "maximum total bytes remain serializable");
rejects(fn(){ Sheet.edit(full,[map{row:0,column:1,value:"x"}]); });
let escaped=Sheet.edit(original,[map{row:0,column:0,value:"comma, quote\" newline\n Ελληνικά"}]);
assert(Sheet.decode(Sheet.encode(escaped)).cells[0][0]==escaped.cells[0][0],"text preserved exactly");
let numbers=Sheet.create(8,1);
let literals=[" +12.5 ","-.5","1e3","NaN","inf",".","+","=1+1"];
for i in range(0,8) { numbers.cells[i][0]=literals[i]; }
let sum=Sheet.sum_column(numbers,0);
assert(sum.value==12 and sum.numeric_cells==2,"only finite plain signed decimals contribute");
numbers.cells[0][0]="1000000000001";
rejects(fn(){ Sheet.sum_column(numbers,0); });
rejects(fn(){ Sheet.edit(original,[map{row:0,column:0,value:"\u0000"}]); });
print "sheet_document_pass";
