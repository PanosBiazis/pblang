// tests/semantics/new_builtins_test.sapp
// Tests for str_repeat, str_pad_left, str_pad_right, str_upper, str_lower
// array_unique, array_zip, array_chunk, array_flatten, array_take, array_drop

// String builtins
let r = str_repeat("ab", 3);
if r != "ababab" { print "FAIL str_repeat: expected ababab got " + str(r); }

let pl = str_pad_left("5", 4, "0");
if pl != "0005" { print "FAIL str_pad_left: expected 0005 got " + str(pl); }

let pr = str_pad_right("hi", 5, ".");
if pr != "hi..." { print "FAIL str_pad_right: expected hi... got " + str(pr); }

let up = str_upper("hello World");
if up != "HELLO WORLD" { print "FAIL str_upper: expected HELLO WORLD got " + str(up); }

let lo = str_lower("Hello WORLD");
if lo != "hello world" { print "FAIL str_lower: expected hello world got " + str(lo); }

// Array builtins
let u = array_unique([1, 2, 1, 3, 2, 4]);
if len(u) != 4 { print "FAIL array_unique len: expected 4 got " + str(len(u)); }
if u[0] != 1 or u[1] != 2 or u[2] != 3 or u[3] != 4 { print "FAIL array_unique values"; }

let z = array_zip([1, 2, 3], ["a", "b", "c"]);
if len(z) != 3 { print "FAIL array_zip len"; }
if z[0][0] != 1 or z[0][1] != "a" { print "FAIL array_zip values"; }

let c = array_chunk([1, 2, 3, 4, 5], 2);
if len(c) != 3 { print "FAIL array_chunk len: expected 3 got " + str(len(c)); }
if len(c[0]) != 2 or len(c[2]) != 1 { print "FAIL array_chunk sizes"; }

let f = array_flatten([[1, 2], [3, 4], [5]]);
if len(f) != 5 { print "FAIL array_flatten len: expected 5 got " + str(len(f)); }
if f[0] != 1 or f[4] != 5 { print "FAIL array_flatten values"; }

let t = array_take([10, 20, 30, 40, 50], 3);
if len(t) != 3 { print "FAIL array_take len: expected 3 got " + str(len(t)); }
if t[2] != 30 { print "FAIL array_take value"; }

let d = array_drop([10, 20, 30, 40, 50], 2);
if len(d) != 3 { print "FAIL array_drop len: expected 3 got " + str(len(d)); }
if d[0] != 30 { print "FAIL array_drop value"; }

print "new_builtins_pass";
