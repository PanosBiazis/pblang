// Late declarations must change the binding observed by an existing closure.
let I = import("stdlib/compiler/interp.sapp");
fn require(ok, label) { if not ok { throw "interp late shadow: " + label; } }
fn run(source, label) {
    let ast = I.compile_program(source);
    require(I.eval_ast(ast), label);
    require(I.eval_ast(ast), label + " reused AST");
}
run("let x = 1; fn outer() { let read = fn() { return x; }; "
    + "if read() != 1 { missing(); } let x = 2; "
    + "if read() != 2 { missing(); } } outer(); outer();", "read after declaration");
run("let x = 1; fn outer() { let write = fn(v) { x = v; }; "
    + "write(3); let x = 2; write(4); if x != 4 { missing(); } } "
    + "outer(); if x != 3 { missing(); }", "assignment after declaration");
run("let x = 1; fn make(early) { let read = fn() { return x + 0; }; "
    + "if early { return read; } let x = 2; return read; } "
    + "let a = make(true); let b = make(false); "
    + "if a() != 1 or b() != 2 or a() != 1 { missing(); }", "shared closure AST leaf plan");
run("let x = 1; fn make(early) { let write = fn(v) { x = v; }; "
    + "if early { return write; } let x = 2; return write; } "
    + "let a = make(true); let b = make(false); "
    + "a(3); b(4); a(5); if x != 5 { missing(); }", "shared closure AST assignment");
run("fn f() { return 1; } fn outer() { let call = fn() { return f(); }; "
    + "if call() != 1 { missing(); } fn f() { return 2; } "
    + "if call() != 2 { missing(); } } outer();", "named function declaration");
run("let x = 1; fn outer() { let read = fn() { return x; }; "
    + "if read() != 1 { missing(); } const x = nil; "
    + "if read() != nil { missing(); } } outer();", "nil const shadow");
run("let x = 1; fn make(early) { let read = fn() { return (x + 0) * 1; }; "
    + "if early { return read; } let x = 2; return read; } "
    + "let a = make(true); let b = make(false); "
    + "if b() != 2 or a() != 1 or b() != 2 { missing(); }", "reverse warmup generic expression");
run("let x = 1; fn outer() { let write = fn(v) { let i = 0; "
    + "while i < 1 { x = v; i = i + 1; } }; "
    + "write(3); let x = 2; write(4); if x != 4 { missing(); } } "
    + "outer(); if x != 3 { missing(); }", "plain loop assignment path");

// A previous prepared AST may already contain a stale resolved depth. Version
// migration must rebuild it, including cached leaf plans and assignment nodes.
let stale = I.compile_program("let x = 1; fn outer() { let read = fn() { return x; }; "
    + "if read() != 1 { missing(); } let x = 2; "
    + "if read() != 2 { missing(); } } outer();");
let captured = stale.stmts[1].body.stmts[0].value.body.stmts[0].value;
captured["@ed"] = 2;
stale["@interp_prepared"] = 2;
require(I.eval_ast(stale), "version two cached AST migration");
require(stale["@interp_prepared"] == 3, "prepared version migration");
require(captured["@ed"] == -2, "shadowed name retained a fixed depth");
let bad_assign = try I.eval_program("missing_value = 1;") catch "caught";
require(bad_assign == "caught", "undefined assignment still fails");
let rejected = try I.eval_program("fn make() { let read = fn() { return absent; }; return read; } make()();") catch "caught";
require(rejected == "caught", "undefined name still fails");
print "interp_late_shadow_pass";
