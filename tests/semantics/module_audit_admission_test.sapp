let C = import("stdlib:module_audit_contract.sapp");
let T = import("stdlib:project_text_audit.sapp");
fn expect(ok, label) { if not ok { throw "FAIL module-admission: " + label; } }
fn fixture(total = 1) {
    let rows = if total > 0 { [map{role: "source", kind: "security", severity: "high"}] } else { [] };
    return map{format: "pblang.module_audit.module.v1", root: "fixture", complete: true,
        files_scanned: 1, finding_count: total, suppressed_count: 0, encoding_degraded_files: 0,
        finding_index_truncated: total > len(rows), findings: rows,
        counts_kind: map{security: total}, counts_severity: map{high: total}, counts_role: map{source: total},
        counts_role_severity: map{"source:high": total},
        counts_role_kind_severity: map{"source:security:high": total}};
}
fn rejected(module) {
    let result = T.combine_module_reports("fixture", [module]);
    return not result.ok and not result.complete and result.error == "invalid module report at index 0"
        and not map_has(result, "quality_gate") and not map_has(result, "modules");
}
let invalid = [nil, true, false, "private-value-marker", [], map{}, fn() { return 1; },
    bigint(1), rational("1/1"), decimal("1"), parse_number("NaN"),
    parse_number("inf"), parse_number("-inf"), -1, 0.5, 9007199254740992];
for field in ["files_scanned", "finding_count", "suppressed_count", "encoding_degraded_files"] {
    for value in invalid { let m = fixture(); m[field] = value; expect(rejected(m), "scalar admission"); }
}
let maps = [["counts_kind", "security"], ["counts_severity", "high"], ["counts_role", "source"],
    ["counts_role_severity", "source:high"], ["counts_role_kind_severity", "source:security:high"]];
for entry in maps {
    for value in invalid { let m = fixture(); m[entry[0]][entry[1]] = value; expect(rejected(m), "map scalar admission"); }
    for value in [nil, false, 1, [], "private-map-marker"] {
        let m = fixture(); m[entry[0]] = value; expect(rejected(m), "map shape");
    }
    let missing = fixture(); missing[entry[0]] = map{}; expect(rejected(missing), "count-map totals must agree");
    let unknown = fixture(); unknown[entry[0]]["unsupported"] = 0; expect(rejected(unknown), "unknown counter taxonomy");
    let oversized = fixture(); let wide = map{};
    for i 101 { wide["entry" + str(i)] = 0; }
    oversized[entry[0]] = wide; expect(rejected(oversized), "width rejected before key enumeration");
}
for field in ["complete", "finding_index_truncated"] {
    for value in [nil, 0, 1, "false", [], map{}] { let m = fixture(); m[field] = value; expect(rejected(m), "exact flags"); }
}
for value in [nil, false, 1, "", [], map{}, "bad\x00root"] {
    let m = fixture(); m.root = value; expect(rejected(m), "root shape");
}
for value in [nil, false, 1, "private-row-marker", map{}] {
    let m = fixture(); m.findings = value; expect(rejected(m), "row-array shape");
}
let missing = map{format: "pblang.module_audit.module.v1", root: "fixture"};
expect(rejected(missing), "missing canonical counters and flags reject");
for value in [nil, true, 1, "private-module-marker", []] { expect(rejected(value), "module shape"); }
let overlong = fixture(); let path = ""; for i 4097 { path = path + "x"; }
overlong.root = path; expect(rejected(overlong), "root bound");
let too_many = fixture(); let many = []; for i 100001 { array_push(many, 0); }
too_many.findings = many; expect(rejected(too_many), "row width bound");
let dishonest = fixture(0); dishonest.findings = fixture().findings;
expect(rejected(dishonest), "retained rows cannot exceed reported total");
let unmarked = fixture(9); unmarked.finding_index_truncated = false;
expect(rejected(unmarked), "omitted findings require explicit truncated-index flag");
let crossed = fixture(); crossed.counts_severity = map{low: 1};
expect(rejected(crossed), "equal totals do not hide inconsistent marginal counts");
let hidden = fixture(); hidden.findings[0].severity = "medium";
expect(rejected(hidden), "retained row categories cannot exceed complete counters");
let duplicate = fixture(); array_push(duplicate.findings, duplicate.findings[0]);
expect(rejected(duplicate), "repeated retained categories cannot exceed count");
let malformed_row = fixture(); malformed_row.findings = [map{role: "source", kind: "security"}];
expect(rejected(malformed_row), "row categories are required");
let degraded = fixture(); degraded.encoding_degraded_files = 2;
expect(rejected(degraded), "degraded files cannot exceed scanned files");

let positive = fixture(); let negative = fixture(); negative.finding_count = -1;
for entry in maps { negative[entry[0]][entry[1]] = -1; }
negative.findings = [];
let cancelled = T.combine_module_reports("fixture", [positive, negative]);
expect(not cancelled.ok and cancelled.error == "invalid module report at index 1", "negative cancellation rejected before aggregation");
let ceiling = fixture(9007199254740991);
expect(C.module_error(ceiling) == "", "inclusive safe total with bounded index");
let next_module = fixture(); next_module.root = "second";
let overflow = T.combine_module_reports("fixture", [ceiling, next_module]);
expect(not overflow.ok and overflow.error == "module audit aggregate counter overflow", "safe operands with unsafe aggregate reject");
let map_overflow = fixture(); map_overflow.counts_severity = map{high: 9007199254740991, medium: 1};
expect(rejected(map_overflow), "counter-map sum cannot overflow");
for field in ["files_scanned", "suppressed_count", "encoding_degraded_files"] {
    let first = fixture(0); let second = fixture(0); second.root = "second";
    first[field] = 9007199254740991; second[field] = 1;
    if field == "encoding_degraded_files" { first.files_scanned = 9007199254740991; }
    let r = T.combine_module_reports("fixture", [first, second]);
    expect(not r.ok and r.error == "module audit aggregate counter overflow", "summary scalar checked sums");
}

let bounded = fixture(9); let original = json_stringify(bounded);
let combined = T.combine_module_reports("fixture", [bounded], map{max_finding_index: 1});
expect(combined.ok and combined.complete and combined.finding_count == 9
    and combined.finding_index_count == 1 and combined.finding_index_truncated, "valid truncated-index compatibility");
expect(json_stringify(bounded) == original, "admission and aggregation do not mutate module");
bounded.counts_kind.security = -1; expect(rejected(bounded), "mutable module is revalidated");
let unknown_role = fixture(); unknown_role.findings[0].role = "unknown";
unknown_role.counts_role = map{unknown: 1}; unknown_role.counts_role_severity = map{"unknown:high": 1};
unknown_role.counts_role_kind_severity = map{"unknown:security:high": 1};
expect(C.module_error(unknown_role) == "", "canonical unknown path role supported");
let zeros = fixture(0); expect(C.module_error(zeros) == "", "explicit zero category entries supported");
for entry in maps { zeros[entry[0]] = map{}; }
expect(C.module_error(zeros) == "", "empty sparse maps supported for zero findings");
let incomplete = fixture(0); incomplete.complete = false;
let result = T.combine_module_reports("fixture", [incomplete]);
expect(result.ok and not result.complete and result.status == "incomplete"
    and not result.aggregate.passed and not result.quality_gate.passed
    and result.quality_gate.status == "blocked", "incomplete coverage cannot pass nested gate");
let partial = T.combine_module_reports("fixture", [], map{requested_roots: ["fixture"]});
expect(partial.ok and not partial.complete and not partial.quality_gate.passed, "initial partial checkpoint blocked");
expect(T.combine_module_reports("fixture", []).quality_gate.passed, "legacy empty batch without requested coverage");
for value in invalid {
    let r = T.combine_module_reports("fixture", [], map{max_finding_index: value});
    expect(not r.ok and r.error == "invalid aggregate finding index bound", "exact index bound");
}
let snapshot = fixture(); snapshot.finding_count = -1; snapshot.snapshot_sha256 = "private-snapshot-marker";
let check = T.verify_module_snapshot(snapshot);
expect(not check.ok and not check.stable and check.error == "invalid module snapshot", "snapshot rejects malformed module before inventory");
expect(try { T.combine_module_reports("fixture", [missing], map{max_high: "private-policy-marker"}); false } catch true,
    "policy admission retains precedence over module admission");
print "module_audit_admission_pass";
