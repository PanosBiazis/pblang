let DIRFS = import("stdlib:linux_dirfs.sapp");

fn fail(message) { throw "FAIL linux_dirfs_publication_cleanup: " + message; }
fn require(value, message) { if value { return; } fail(message); }
fn owned_descriptor_count(fd_directory, root) {
    let count = 0;
    let entries = fs_listdir(fd_directory);
    for entry_index len(entries) {
        let probe = try proc_spawn_wait("/usr/bin/readlink",
            [fd_directory + "/" + entries[entry_index]]) catch nil;
        if probe != nil and probe.exit_code == 0 {
            let target = str_trim(probe.stdout);
            if str_starts_with(target, root) or str_contains(target, "pblang-rename-noreplace") {
                count = count + 1;
            }
        }
    }
    return count;
}

let root = "/tmp/pblang-dirfs-publication-cleanup-" +
    str_slice(sha256(str(now_ms()) + str(random_bytes(16))), 0, 20);
try proc_spawn_wait("/bin/rm", ["-rf", "--", root]) catch nil;
let fs = DIRFS.open_absolute(root, true, true);
require(fs.ok, "private test root opens");
require(DIRFS.mkdir(fs, "out").ok, "output directory opens");
let root_descriptor = DIRFS.descriptor_path(fs);
require(root_descriptor.ok, "test root exposes its process descriptor directory");
let fd_directory = path_dirname(root_descriptor.path);
let descriptor_count_before_success = owned_descriptor_count(fd_directory, root);
require(DIRFS.write_new_atomic(fs, "out/artifact.bin", [6, 7, 8]).ok,
    "initial atomic publication succeeds");
require(owned_descriptor_count(fd_directory, root) == descriptor_count_before_success,
    "successful atomic publication does not leak process descriptors");

let descriptor_count_before = owned_descriptor_count(fd_directory, root);
for collision_round 16 {
    let collision = DIRFS.write_new_atomic(fs, "out/artifact.bin", [collision_round]);
    if collision.ok { fail("repeated atomic-new collision must fail closed"); }
}

let listing = DIRFS.list(fs, "out", 32);
require(listing.ok, "output directory remains listable after collisions");
for entry_index len(listing.entries) {
    if str_starts_with(listing.entries[entry_index], ".pblang-stage-") {
        fail("failed publication left a private stage entry");
    }
}
require(DIRFS.read_bytes(fs, "out/artifact.bin", 16).bytes == [6, 7, 8],
    "collisions preserve the existing destination bytes");
let descriptor_count_after = owned_descriptor_count(fd_directory, root);
require(descriptor_count_after == descriptor_count_before,
    "repeated collisions do not leak process descriptors");

require(DIRFS.remove_file(fs, "out/artifact.bin").ok, "artifact cleanup succeeds");
require(DIRFS.remove(fs, "out").ok, "output directory cleanup succeeds");
require(DIRFS.close(fs), "test root closes cleanly");
try proc_spawn_wait("/bin/rm", ["-rf", "--", root]) catch nil;

print "linux_dirfs_publication_cleanup_pass";
