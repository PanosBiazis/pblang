let K=import("stdlib:table_key_quality.sapp");let Q=import("stdlib:table_quality.sapp");let C=import("stdlib:sheet_csv.sapp");let S=import("stdlib:sheet_document.sapp");
let doc=C.decode("code,value\nΑ1,first\nΒ2,unique\nΑ1,different\n ,missing\nΑ1,third\nΑ1 ,literal");let before=S.encode(doc);let q=K.inspect(doc,0,true);
assert(q.rows_checked==6 and q.duplicate_keys==2 and q.missing_keys==1 and q.flagged_rows==3 and q.review_rows==4,"key diagnostics");
assert(q.rows==[map{row:3,missing_key:false,duplicate_of:1},map{row:4,missing_key:true,duplicate_of:nil},map{row:5,missing_key:false,duplicate_of:1}],"first occurrence retained");
assert(q.review_indices==[1,3,4,5],"source order, first reference once");
assert(Q.inspect(doc,true).duplicate_rows==0,"key duplicates differ from repeated full rows");
assert(not str_contains(json_stringify(q),"Α1") and not str_contains(json_stringify(q),"first") and not q.safe_to_log,"no source text, positions still sensitive");
q.review_indices=[2];let selected=K.select_review(doc,0,true);assert(selected.cells==[doc.cells[0],doc.cells[1],doc.cells[3],doc.cells[4],doc.cells[5]],"selection recomputed");selected.cells[1][0]="changed";assert(S.encode(doc)==before,"source detached");
assert(K.inspect(C.decode("x,a\nx,b"),0).rows[0].duplicate_of==0,"row zero reference");
assert(K.inspect(C.decode("x\nx"),0,true).flagged_rows==0,"header excluded");
assert(K.inspect(C.decode("x"),0,true).rows_checked==0,"header only");
let blanks=K.inspect(S.create(32,8),7);assert(blanks.missing_keys==32 and blanks.duplicate_keys==0 and blanks.review_rows==32,"blanks are missing, not duplicate keys");
let full=S.create(32,1);for r in range(0,32) {full.cells[r][0]=str_repeat("z",256);}assert(K.inspect(full,0).duplicate_keys==31 and K.select_review(full,0)==full,"maximum byte budget");
assert(K.inspect(C.decode("x\nX\n x\nx "),0).flagged_rows==0,"literal spaces and case");
assert(K.inspect(C.decode("__proto__\n=1+1\n__proto__\n=1+1"),0).duplicate_keys==2,"literal map and formula-shaped strings");
for bad in [nil,true,"0",-1,0.5,2,[],map{}] {assert((try K.inspect(doc,bad,true) catch nil)==nil,"strict key column");}
for bad in [nil,1,"true"] {assert((try K.inspect(doc,0,bad) catch nil)==nil,"strict header");}
for bad in [nil,map{},map{format:S.FORMAT,cells:[["a"],["b","c"]]}] {assert((try K.inspect(bad,0) catch nil)==nil,"invalid sheet");}
assert((try K.select_review(C.decode("a\nb"),0) catch nil)==nil,"no invented review table");
// Independent pairwise oracle: no reuse of the implementation's map index.
for seed in range(0,16) {
 let t=S.create(10,2);for r in range(0,10) {t.cells[r][0]=[""," ","α","α ","b","__proto__"][(r+seed)%6];t.cells[r][1]=str(r);}
 let actual=K.inspect(t,0,seed%2==0);let start=if seed%2==0 {1} else {0};let expected=[];let wanted=[];
 for r in range(start,10) {
  let blank=str_trim(t.cells[r][0])=="";let first=-1;
  if not blank {for p in range(start,r) {if first<0 and t.cells[p][0]==t.cells[r][0] {first=p;}}}
  if blank or first>=0 {array_push(expected,map{row:r,missing_key:blank,duplicate_of:if first<0 {nil} else {first}});}
  let include=blank;
  if not blank {for p in range(start,10) {if p!=r and t.cells[p][0]==t.cells[r][0] {include=true;}}}
  if include {array_push(wanted,r);}
 }
 assert(actual.rows==expected and actual.review_indices==wanted,"independent oracle");
}
print "table_key_quality_pass";
