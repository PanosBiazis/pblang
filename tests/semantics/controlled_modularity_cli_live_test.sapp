if platform()!="linux" {print "controlled_modularity_cli_skip_linux_required";os_exit(0);}
let U=import("stdlib:uuid.sapp");let exe=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let root=path_join(cwd(),"target/module-cli-"+U.v4());fs_mkdirs(root);
let contract=path_join(root,"contract.json");let source=path_join(root,"source.sapp");let output=path_join(root,"result.pbck");
let provider=path_join(root,"provider.sapp");
let stage=["setup"];
fn child(args) {let a=["-k","1s","12s",exe];for arg in args {push(a,arg);}return proc_spawn_wait("/usr/bin/timeout",a);}
fn compile() {return child(["run","tools/pbc.sapp","--allow-all","--",source,"--target","pbck","--bundle","--out",output,"--module-contract",contract,"--module-root","example_app"]);}
fn exercise() {
    let valid=fs_read("examples/controlled_modularity/contract.json");
    fs_write(output,"previous artifact");fs_write(contract,str_replace_all(valid,"1.0.0","invalid_private_canary"));
    stage[0]="preflight before missing source";let result=compile();
    assert(result.exit_code==2 and str_contains(result.stdout,"invalid_contract"),"bad contract rejects before missing source");
    assert(not str_contains(result.stdout+result.stderr,"invalid_private_canary") and fs_read(output)=="previous artifact","diagnostic privacy and prior artifact preserved");
    fs_write(contract,valid);fs_write(provider,"fn value(){return 7;}export value;");
    fs_write(source,"let p=import(\""+provider+"\");print p.value();");
    stage[0]="actual compilation";result=compile();assert(result.exit_code==0,"admitted tool integration");
    fs_remove(source);fs_remove(contract);fs_remove(provider);
    result=child(["run",output,"--sandbox"]);assert(result.exit_code==0 and result.stdout=="7\n","artifact independent from contract and source after compilation");
    stage[0]="CLI mismatch";let doc=json_parse(valid);doc.modules[1].version="2.0.0";fs_write(contract,json_stringify(doc));
    result=child(["run","tools/pbmodules.sapp","--allow-all","--",contract,"example_app"]);
    assert(result.exit_code==1 and str_contains(result.stdout,"package_version_mismatch"),"diagnostic CLI nonzero incompatible");
    stage[0]="CLI argument requirements";
    for flags in [["--module-root","example_app"],["--module-contract",contract],["--module-capability","cpu"],["--module-contract",contract,"--module-contract",contract],["--module-root","example_app","--module-root","example_app"]] {
        let args=["run","tools/pbc.sapp","--allow-all","--",source,"--target","pbck","--out",output];
        for flag in flags {push(args,flag);}assert(child(args).exit_code==2,"module flag contract before source read");
    }
    stage[0]="symlink and authority";fs_remove(contract);fs_write(path_join(root,"actual.json"),valid);
    assert(proc_spawn_wait("/usr/bin/ln",["-s","actual.json",contract]).exit_code==0,"symlink fixture");
    result=child(["run","tools/pbmodules.sapp","--allow-all","--",contract,"example_app"]);
    assert(result.exit_code==1 and str_contains(result.stdout,"contract_unavailable"),"symlink contract rejected");
    fs_remove(contract);fs_write(contract,valid);
    result=child(["run","tools/pbmodules.sapp","--allow-import","--deny-ffi","--",contract,"example_app"]);
    assert(result.exit_code!=0,"missing secure backend authority fails closed");
    stage[0]="standalone and integrated example";
    result=child(["run","tools/pbc.sapp","--allow-all","--","examples/controlled_modularity/integrated.sapp","--target","pbck","--bundle","--out",output,"--module-contract",contract,"--module-root","example_app"]);
    assert(result.exit_code==0,"static integrated example admitted");
    result=child(["run",output,"--sandbox"]);assert(result.exit_code==0 and result.stdout=="7\n","integrated example executes");
    result=child(["run","tools/pbmodules.sapp","--allow-all","--",contract,"value_provider"]);
    let plan=json_parse(result.stdout);assert(result.exit_code==0 and plan.order==["value_provider"] and len(plan.bindings)==0,"same provider planned standalone");
}
let ok=try {exercise();true} catch false;
let removed=proc_spawn_wait("/bin/rm",["-rf","--",root]);
assert(ok,"controlled modularity CLI: "+stage[0]);assert(removed.exit_code==0,"fixture cleanup");
print "controlled_modularity_cli_pass";
