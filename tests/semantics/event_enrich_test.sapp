// tests/semantics/event_enrich_test.sapp — fix + enrichment for stdlib/event.sapp
//
// FIX: emit() did not isolate handler errors (one throwing listener aborted the
//   rest). ENRICH: off() can now remove a SINGLE handler (3rd arg); remove_all,
//   has_listeners.

let event = import("stdlib/event.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let bus = event.new();
let hits = map{ n: 0, last: nil };
event.on(bus, "click", fn(d) { hits.n = hits.n + 1; hits.last = d; });
eq(event.emit(bus, "click", "X"), 1, "emit returns count");
eq(hits.last, "X", "handler got data");

// ── FIX: a throwing listener doesn't stop the others ─────────────────────────────
let b2 = event.new();
let ran = map{ b: false };
event.on(b2, "e", fn(d) { throw "boom"; });
event.on(b2, "e", fn(d) { ran.b = true; });
event.emit(b2, "e", nil);
eq(ran.b, true, "second listener ran after first threw");

// ── ENRICH: off a SINGLE handler (3-arg) vs all (2-arg) ──────────────────────────
let b3 = event.new();
let c = map{ a: 0, b: 0 };
let ha = fn(d) { c.a = c.a + 1; };
let hb = fn(d) { c.b = c.b + 1; };
event.on(b3, "t", ha); event.on(b3, "t", hb);
event.off(b3, "t", ha);          // remove only ha
event.emit(b3, "t", nil);
eq(c.a, 0, "removed handler did not run"); eq(c.b, 1, "other handler still ran");
event.off(b3, "t");              // remove all (2-arg, unchanged behavior)
eq(event.listener_count(b3, "t"), 0, "off with no handler removes all");

// ── ENRICH: remove_all + has_listeners ───────────────────────────────────────────
let b4 = event.new();
event.on(b4, "a", fn(d) {}); event.on(b4, "b", fn(d) {});
eq(event.has_listeners(b4, "a"), true, "has_listeners true");
eq(event.has_listeners(b4, "zzz"), false, "has_listeners false");
event.remove_all(b4);
eq(len(event.event_names(b4)), 0, "remove_all clears everything");

print "event_enrich_pass";
