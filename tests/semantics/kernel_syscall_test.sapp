// Test: the system-call trap mechanism (stdlib/kernel/syscall.sapp), §81.
//
// `int 0x80` traps from caller into the kernel; an isr_syscall handler reads the
// request (num/arg from fixed ABI cells), services it, and writes the result back. The
// user/kernel boundary primitive. Proven END-TO-END in QEMU: sys_call(2,6) dispatches
// a "square" syscall returning 36 (-> exit 85), and sys_call(1,c) prints via a "putc"
// syscall ("OK" on serial). Memory-based ABI sidesteps the GCC interrupt handler's
// hidden register frame. We assert the codegen contract here.

let ct = import("stdlib/compiler/ctranspile.sapp");
let intr = fs_read("stdlib/kernel/interrupts.sapp");
let con = fs_read("stdlib/kernel/console.sapp");
let sys = fs_read("stdlib/kernel/syscall.sapp");

let src = "fn isr_syscall() { let n = sys_num(); let a = sys_arg(); "
    + "if n == 1 { serial_putc(a); sys_return(0); } "
    + "else { if n == 2 { sys_return(a * a); } else { sys_return(0 - 1); } } } "
    + "fn kmain() { serial_init(); pic_mask(255, 255); let idt = kmalloc(2048); "
    + "idt_set_gate(idt, 128, addr_of(\"isr_syscall\"), 8, 142); idt_load(idt); "
    + "let r = sys_call(2, 6); if r == 36 { outb(244, 42); } while 1 > 0 { hlt(); } }";

let c = ct.transpile_kernel_int(intr + con + sys + src);

// ── The trap intrinsic + ABI ────────────────────────────────────────────────────────
assert(str_contains(c, "static inline void swint80(void){ __asm__ volatile(\"int $0x80\"); }"), "int 0x80 trap intrinsic in the preamble");
assert(str_contains(c, "long sys_call(long num, long arg)"), "sys_call (userside trap) transpiled");
assert(str_contains(c, "long sys_num()"), "handler reads the syscall number from the ABI cell");
assert(str_contains(c, "long sys_arg()"), "handler reads the argument");
assert(str_contains(c, "long sys_return(long v)"), "handler writes the result");
assert(str_contains(c, "swint80()"), "sys_call traps via int 0x80");

// ── The handler is a real interrupt routine installed on vector 0x80 ─────────────────
assert(str_contains(c, "__attribute__((interrupt)) void isr_syscall(void* _frame)"), "isr_syscall is a GCC interrupt handler");
assert(str_contains(c, "(long)(u64)&isr_syscall"), "installed into IDT vector 0x80 via addr_of");

assert(not str_contains(c, "double"), "syscall path is float-runtime-free");
assert(str_contains(c, "0x1BADB002"), "multiboot header present");

print "kernel_syscall_pass";
