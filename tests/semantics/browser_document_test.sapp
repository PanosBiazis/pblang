let D=import("stdlib:browser_document.sapp");
let source="<article><h1>PB &amp; Ελληνικά</h1><h2>Start</h2><p>Literal &lt;script&gt; stays text</p><a href=\"pb://guide\">Read guide</a></article>";
let doc=D.import_html(source);
assert(doc.format=="pblang.ui-document.v1" and len(doc.widgets)==3,"canonical UI is reused");
assert(doc.form.title=="PB & Ελληνικά" and doc.widgets[2].props.href=="pb://guide","UTF8 title and link");
assert(D.export_html(doc)==source,"HTML UI HTML exact canonical roundtrip");
assert(D.import_html(D.export_html(doc))==doc,"UI HTML UI roundtrip");
let page=D.page(doc);assert(not str_contains(page,"href=\"pb:") and str_contains(page,"button disabled"),"export cannot dispatch OS schemes");
let linked=D.page(doc,map{"pb://guide":"guide.html"});assert(str_contains(linked,"href=\"guide.html\""),"explicit local bundle target");
for bad in [nil,0,"","<article><h1></h1></article>","<article><h1>x</h1><script>x</script></article>","<article><h1>x</h1><p onclick=\"x\">x</p></article>","<article><h1>x</h1><p><b>x</b></p></article>","<article><h1>x</h1><a href=\"https://example.com\">x</a></article>","<article><h1>x</h1><p>&#65;</p></article>","<article><h1>x</h1><p>x</h2></article>",source+"tail",str_repeat("x",16385)] {
    assert((try D.import_html(bad) catch nil)==nil,"unsupported markup rejected");
}
for url in ["file:///tmp/x","javascript:x","data:x","pb://../x","pb://Guide","pb://home?x","pb://a/b","pb://home#x","pb://a"+strfromcharcode(0)] {assert((try D.address(url) catch nil)==nil,"strict local addresses");}
for targets in [map{"pb://guide":"../guide.html"},map{"pb://guide":"https://example.com/a.html"},map{"pb://guide":"file.html?x"}] {assert((try D.page(doc,targets) catch nil)==nil,"export path traversal denied");}
let mutated=D.import_html(source);mutated.widgets[0].x=99;assert((try D.export_html(mutated) catch nil)==nil,"unsupported layout never silently lost");
mutated=D.import_html(source);mutated.widgets[0].events=map{click:"Execute"};assert((try D.export_html(mutated) catch nil)==nil,"handlers never silently lost");
mutated=D.import_html(source);mutated.widgets[0].props.extra="x";assert((try D.export_html(mutated) catch nil)==nil,"unknown props rejected");
mutated=D.import_html(source);mutated.widgets[0].onclick="x";assert((try D.export_html(mutated) catch nil)==nil,"unknown widget property rejected");
let blocks=[];for _i 8 {push(blocks,map{tag:"p",text:str_repeat("λ",256)});}
assert(len(D.create("Max",blocks).widgets)==8,"maximum blocks and UTF8 supported");
push(blocks,map{tag:"p",text:"extra"});assert((try D.create("Max",blocks) catch nil)==nil,"block budget");
assert((try D.create("x",[map{tag:"p",text:str_repeat("x",257)}]) catch nil)==nil,"text budget");
let wrong=D.import_html(source);wrong.format="pblang.ui-document.v2";assert((try D.export_html(wrong) catch nil)==nil,"unknown version rejected");
assert((try D.create("control"+strfromcharcode(8238),[]) catch nil)==nil,"bidi control rejected");
assert((try D.create("x",[map{tag:"p",text:fn(){return "x";}}]) catch nil)==nil,"executable values rejected");
print "browser_document_pass";
