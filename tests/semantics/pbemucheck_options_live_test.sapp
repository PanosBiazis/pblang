// Trusted Linux maintenance: rejected oracle choices must never execute.
if platform()!="linux" { print "pbemucheck_options_skip_linux_required"; os_exit(0); }
let compiler=path_join(cwd(),"target/release/pblang");
let invalid="pbemucheck: oracle override requires an absolute path and lowercase sha256(base64(bytes)) digest";
let digest=str_repeat("a",64);
for pair in [["/private-oracle-marker",""],["",digest],["relative-oracle-marker",digest],
    ["/private-oracle-marker","private-digest-marker"]] {
    let result=proc_spawn_wait("/usr/bin/env",["PBLANG_QEMU_AARCH64="+pair[0],
        "PBLANG_QEMU_BASE64_SHA256="+pair[1],"/usr/bin/timeout","-k","1s","10s",
        compiler,"run","tools/pbemucheck.sapp","--allow-all"]);
    assert(result.exit_code==1 and result.stdout=="" and str_contains(result.stderr,invalid),"invalid pair preflight");
    for marker in ["private-oracle-marker","relative-oracle-marker","private-digest-marker",digest] {
        assert(not str_contains(result.stderr,marker),"fixed errors do not echo oracle input");
    }
}
let rejected=proc_spawn_wait("/usr/bin/env",["PBLANG_QEMU_AARCH64=/usr/bin/printf",
    "PBLANG_QEMU_BASE64_SHA256="+digest,"/usr/bin/timeout","-k","1s","10s",
    compiler,"run","tools/pbemucheck.sapp","--allow-all"]);
assert(rejected.exit_code==1 and rejected.stdout==""
    and str_contains(rejected.stderr,"pbemucheck: campaign or private cleanup failed safely"),"wrong executable digest rejects before fixture execution");
print "pbemucheck_options_live_pass";
