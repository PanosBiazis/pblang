let V = import("stdlib:visual_engine.sapp");

let caps = V.capabilities();
assert(caps.graph and caps.web_scene, "visual engine capabilities expose graph/web scene");
assert(caps.custom_components and caps.imported_components, "visual engine supports custom/imported component contracts");
assert(caps.ecs and caps.physics_particles_terrain, "visual engine supports engine-style ECS/physics scene contracts");
assert(caps.ellipse_arc_nodes, "visual engine advertises ellipse and arc node contracts");

assert(V.validate_source("https://example.com/image.png").ok, "network https source allowed");
assert(not V.validate_source("https://www.google-analytics.com/collect").ok, "tracker URL source blocked");
assert(not V.validate_source("file:///tmp/x.png").ok, "file URL source blocked");
assert(not V.validate_source("javascript:alert(1)").ok, "script URL source blocked");
assert(not V.validate_source("http://127.0.0.1:8080/a.png").ok, "private network source blocked by default");
assert(V.validate_source("http://127.0.0.1:8080/a.png", true).ok, "private network source opt-in");

let sc = V.scene(640, 360, map{ title: "visual test" });
let img = V.asset("image", "https://example.com/hero.png", map{ alt: "Hero" });
V.add(sc, V.rect("bg", 0, 0, 640, 360, [0, 0, 0, 255]));
V.add(sc, V.text("title", 20, 20, "Hello", [255, 255, 255, 255], 24));
V.add(sc, V.image("hero", img, 20, 60, 320, 160));
V.add(sc, V.line2d("line", 0, 0, 10, 10));
V.add(sc, V.circle2d("dot", 50, 50, 8));
let oval = V.ellipse2d("oval", 60, 50, 12, 8, [20, 120, 240, 255], true);
let arc = V.arc2d("arc", 60, 50, 12, 8, 0, 3.141592653589793,
    [180, 80, 220, 255], 3);
assert(oval.kind == "ellipse2d" and oval.rx == 12 and oval.ry == 8,
    "ellipse node retains independent radii");
assert(arc.kind == "arc2d" and arc.width == 3 and not arc.fill,
    "arc node retains bounded span and stroke metadata");
assert((try { V.ellipse2d("bad", 0, 0, 0, 1); false } catch true),
    "ellipse rejects a non-positive radius");
assert((try { V.arc2d("bad", 0, 0, 1, 1, 2, 2); false } catch true),
    "arc rejects a zero span");
let invalid_nan = num_sqrt(-1);
let invalid_infinity = num_exp(1000000);
assert((try { V.ellipse2d("bad-nan", 0, 0, invalid_nan, 1); false } catch true),
    "ellipse rejects NaN geometry");
assert((try { V.arc2d("bad-inf", 0, 0, 1, 1, 0, invalid_infinity); false } catch true),
    "arc rejects infinite angles");
V.add(sc, oval);
V.add(sc, arc);
V.add(sc, V.polygon2d("tri", [[0,0],[10,0],[5,10]]));
V.add(sc, V.path2d("path", [["M", 0, 0], ["L", 10, 10]]));
V.add(sc, V.cube3d("cube", 0, 0, 0, 10));
V.add(sc, V.sphere3d("sphere", 1, 2, 3, 4));
V.add(sc, V.camera3d("cam", 0, 2, 5, [0, 0, 0]));
V.add(sc, V.light3d("sun", "directional", 10, 20, 30));
V.add(sc, V.material("mat", "pbr-lite", [108, 92, 231, 255], map{ roughness: 0.4 }));
V.add(sc, V.shader_program("shader", "glsl", "void main(){}", "void main(){}"));
V.add(sc, V.physics_body("body", "dynamic", "box", 2));
V.add(sc, V.terrain("terrain", 64, 64, []));
V.add(sc, V.particle_system("sparks", 0, 0, 0, 64));
V.add(sc, V.skybox("sky", nil, [13, 17, 23, 255]));
V.add(sc, V.point_nd("latent", [1, 2, 3, 4]));
V.add(sc, V.item_nd("ideal", [1, 2, 3, 4, 5], "pca-preview", map{ label: "Ideal NN" }));
V.add(sc, V.cloud_nd("cloud", [[1,2,3],[4,5,6]]));
V.add(sc, V.tensor_item("tensor", [2, 2], [1, 2, 3, 4]));
V.add(sc, V.line_chart("loss", [[0, 5.0], [1, 3.0]], map{ title: "Loss" }));
V.add(sc, V.custom_component("custom1", "Imported button", 10, 10, 120, 32, map{ source: "external-ide" }));
V.add(sc, V.web_component("web1", "<button>Run</button>", "button{}", "alert(1)", 20, 20, 160, 80));
V.add(sc, V.scanned_component("scan1", "3d-scan", "scanner://pending", 0, 0, 200, 120, map{ format_hint: "stl" }));
let ent = V.entity("player", "Player", V.transform3d(1, 2, 3), []);
V.attach_component(ent, V.component_ref("mesh", "cube"));
V.attach_component(ent, V.component_ref("physics", "body"));
V.add(sc, ent);
V.add(sc, V.prefab("prefab1", "Player prefab", [ent], map{ engine_hint: "godot/unity/unreal" }));
V.add(sc, V.render_backend("vk", "vulkan", map{ target: "plan-only" }));
V.add_key(sc, "hero", 0.5, map{ opacity: 0.5 });

let p = V.compile(sc);
assert(p.format == "pblang.visual.plan.v1", "compile returns visual plan");
assert(len(p.assets) == 1, "asset deduplicated into scene asset table");
assert(p.render.backend == "native", "compile keeps render backend metadata");
assert(len(p.draw) == 30, "draw plan includes visual/component/engine nodes");
assert(len(p.timeline) == 1, "timeline key stored");

let sum = V.summarize(sc);
assert(sum.draw_nodes == 30 and sum.assets == 1, "summary counts nodes/assets");

print "visual_engine_pass";
