// tests/semantics/dashboard_test.sapp
// The GUI dashboard builds headlessly, populates its labels from the live Watchers +
// Master Control subsystems, and its buttons are wired to the real subsystems.
let d = import("stdlib:dashboard.sapp");
let gui = import("stdlib:gui.sapp");

fn fail(m) { throw "FAIL " + m; }

let f = d.build();

// panels exist
if gui.get(f, "p_sys") == nil or gui.get(f, "p_watch") == nil or gui.get(f, "p_mc") == nil { fail("dashboard panels missing"); }

// labels populated from live watcher data
if not str_contains(gui.get(f, "l_cpu").text, "CPU threads") { fail("compute label not populated"); }
if not str_contains(gui.get(f, "l_heap").text, "Heap:") { fail("heap label not populated"); }
if not str_contains(gui.get(f, "l_probes").text, "probes") { fail("probes label not populated"); }

// master control shows the locked default
if not str_contains(gui.get(f, "l_mc_status").text, "LOCKED") { fail("mc status should show LOCKED by default"); }

// refresh re-reads without error
d.refresh(f);
if not str_contains(gui.get(f, "l_time").text, "ms") { fail("refresh did not update time"); }

// the KILL button is wired to master control: invoking its handler latches the kill switch
let killbtn = gui.get(f, "b_kill");
if killbtn == nil or killbtn.onclick == nil { fail("kill button missing handler"); }
killbtn.onclick(f);
if not str_contains(gui.get(f, "l_mc_status").text, "KILLED") { fail("kill button did not engage master control"); }

// perception panel: backends shown, and the capture button routes through master
// control (locked by default -> request is denied, not executed)
if gui.get(f, "p_percept") == nil { fail("perception panel missing"); }
if not str_contains(gui.get(f, "l_percept").text, "backends") { fail("perception backends not shown"); }
let scrbtn = gui.get(f, "b_screen");
if scrbtn == nil or scrbtn.onclick == nil { fail("screen-capture button missing handler"); }
scrbtn.onclick(f);
if not str_contains(gui.get(f, "l_percept_status").text, "denied") { fail("locked capture request must be denied"); }

// input-control panel: backends shown, capture button routes through gates
if gui.get(f, "p_input") == nil { fail("input panel missing"); }
if not str_contains(gui.get(f, "l_input").text, "enabled") { fail("input backends not shown"); }
let typebtn = gui.get(f, "b_type");
if typebtn == nil or typebtn.onclick == nil { fail("type button missing handler"); }
typebtn.onclick(f);
// input disabled by default (no PB_INPUT_CONTROL) -> request denied
if not str_contains(gui.get(f, "l_input_status").text, "denied") { fail("locked input request must be denied"); }

// approval widget: nonce field + Approve button exist; with no pending request it
// reports "no pending"
if gui.get(f, "nonce") == nil { fail("nonce textbox missing"); }
let apv = gui.get(f, "b_approve");
if apv == nil or apv.onclick == nil { fail("approve button missing handler"); }
apv.onclick(f);
if not str_contains(gui.get(f, "l_approve").text, "no pending") { fail("approve with no pending should say so"); }

// live-preview panel: frame strip + sample button; sampling gated (denied while locked)
if gui.get(f, "p_preview") == nil { fail("preview panel missing"); }
if gui.get(f, "l_frame_0") == nil { fail("frame strip missing"); }
let smp = gui.get(f, "b_sample");
if smp == nil or smp.onclick == nil { fail("sample button missing handler"); }
smp.onclick(f);
if not str_contains(gui.get(f, "l_preview_status").text, "denied") { fail("locked sampling must be denied"); }

// real pixel preview: an image widget exists (nil img -> placeholder)
let pimg = gui.get(f, "preview_img");
if pimg == nil or pimg.kind != "image" { fail("preview image widget missing"); }

print "dashboard_pass";
