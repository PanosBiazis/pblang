// tests/semantics/dashboard_test.sapp
// The GUI dashboard builds headlessly, populates its labels from the live Watchers +
// Master Control subsystems, and its buttons are wired to the real subsystems.
let d = import("stdlib:dashboard.sapp");
let gui = import("stdlib:gui.sapp");

fn fail(m) { throw "FAIL " + m; }

let f = d.build();

// panels exist
if gui.get(f, "p_sys") == nil or gui.get(f, "p_watch") == nil or gui.get(f, "p_mc") == nil { fail("dashboard panels missing"); }

// labels populated from live watcher data
if not str_contains(gui.get(f, "l_cpu").text, "CPU threads") { fail("compute label not populated"); }
if not str_contains(gui.get(f, "l_heap").text, "Heap:") { fail("heap label not populated"); }
if not str_contains(gui.get(f, "l_probes").text, "probes") { fail("probes label not populated"); }

// master control shows the locked default
if not str_contains(gui.get(f, "l_mc_status").text, "LOCKED") { fail("mc status should show LOCKED by default"); }

// refresh re-reads without error
d.refresh(f);
if not str_contains(gui.get(f, "l_time").text, "ms") { fail("refresh did not update time"); }

// the KILL button is wired to master control: invoking its handler latches the kill switch
let killbtn = gui.get(f, "b_kill");
if killbtn == nil or killbtn.onclick == nil { fail("kill button missing handler"); }
killbtn.onclick(f);
if not str_contains(gui.get(f, "l_mc_status").text, "KILLED") { fail("kill button did not engage master control"); }

print "dashboard_pass";
