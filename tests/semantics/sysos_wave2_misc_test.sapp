// tests/semantics/sysos_wave2_misc_test.sapp — wave 2: duration/env/os/fs additions

let D = import("stdlib/duration.sapp");
let E = import("stdlib/env.sapp");
let OS = import("stdlib/os.sapp");
let F = import("stdlib/fs.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn contains(arr, v) { let i = 0; while i < len(arr) { if arr[i] == v { return true; } i = i + 1; } return false; }

// ── duration: round_to / from_parts ────────────────────────────────────────────────
eq(D.round_to(D.seconds(95), 60), 120, "round 95s up to 120s");
eq(D.round_to(D.seconds(85), 60), 60, "round 85s down to 60s");
eq(D.from_parts(1, 2, 3, 4), 93784, "from_parts 1d2h3m4s");

// ── env: prefix / load_or ───────────────────────────────────────────────────────────
E.set("APP_DB", "pg");
E.set("APP_PORT", "8080");
E.set("OTHER_X", "z");
let p = E.prefix("APP_");
eq(p["DB"], "pg", "prefix strips namespace (DB)");
eq(p["PORT"], "8080", "prefix strips namespace (PORT)");
if (try p["X"] catch "MISS") != "MISS" { fail("prefix excludes non-APP keys"); }
eq(E.load_or("tests/fixtures/_no_such.env"), 0, "load_or missing -> 0");

// ── os: cpu_count ────────────────────────────────────────────────────────────────────
if OS.cpu_count() < 1 { fail("cpu_count >= 1"); }

// ── fs: walk / read_json_or (build a small tree, then clean up) ───────────────────
let base = "tests/fixtures/_wtree";
F.mkdirs(base + "/sub");
F.write(base + "/a.txt", "x");
F.write(base + "/sub/b.txt", "y");
F.write(base + "/c.json", "{\"k\": 5}");

let files = F.walk(base);
if not contains(files, base + "/a.txt") { fail("walk finds a.txt: " + str(files)); }
if not contains(files, base + "/sub/b.txt") { fail("walk recurses into sub: " + str(files)); }

eq(F.read_json_or(base + "/c.json", map{ k: 0 }).k, 5, "read_json_or parses");
eq(F.read_json_or(base + "/missing.json", map{ def: 1 }).def, 1, "read_json_or default");

// cleanup (try-guarded; remove files then dirs)
let _ = try F.remove(base + "/a.txt") catch nil;
let _ = try F.remove(base + "/sub/b.txt") catch nil;
let _ = try F.remove(base + "/c.json") catch nil;
let _ = try F.remove(base + "/sub") catch nil;
let _ = try F.remove(base) catch nil;

print "sysos_wave2_misc_pass";
