let Forms=import("editors/ide/pbide_form_check.sapp");
let Web=import("editors/ide/pbide_text_web.sapp");
let source="object PrivateForm: TForm1\nCaption = 'PRIVATE_TITLE'\nClientWidth = 300\nClientHeight = 200\nobject PrivateButton: TButton\nCaption = 'PRIVATE_VALUE'\nOnClick = PrivateHandler\nend\nend";
let report=Forms.check(source);assert(report.ok and not report.report.conversion_complete,"preflight not migration");
assert(not str_contains(json_stringify(report),"PRIVATE") and not str_contains(json_stringify(report),"Private"),"diagnostic privacy");
for value in [nil,true,[],"TPF0binary",str_repeat("a",65537),str_repeat("😀",16385)] {assert(not Forms.check(value).ok,"invalid source bounded");}
let body="source="+url_encode(source)+"&start=0&end=0&insert=&op=check-form&pair=round";
let req=map{method:"POST",path:"/edit",body:body,headers:map{host:"127.0.0.1:18771",origin:"http://127.0.0.1:18771","content-type":"application/x-www-form-urlencoded","content-length":str(len(str_to_bytes(body)))}};
let response=Web.handle(req,18771);
assert(response.status==200 and str_contains(response.body,"Web structure supported") and str_contains(response.body,"conversion is incomplete"),"web action visible");
assert(Web.parse_form(body).text==source,"check leaves draft unchanged");
assert(str_contains(response.body,"Check DFM form"),"control available");
req.headers.origin="http://foreign.invalid";assert(Web.handle(req,18771).status==403,"origin gate unchanged");
print "pbide_form_check_pass";
