// tests/semantics/securelayer_enrich_test.sapp — enrichment for stdlib/securelayer.sapp
// Adds replay_guard/accept/next_seq (completes the replay-protection story) and
// is_valid_envelope.

let s = import("stdlib/securelayer.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let key = "0123456789abcdef0123456789abcdef";

// ── base seal/open round-trip + tamper/seq rejection ─────────────────────────────
let env = s.seal(key, "secret", 7);
eq(s.open(key, env, 7), "secret", "seal/open round-trip");
eq(s.open(key, env, 8), nil, "wrong sequence -> nil (replay/seq mismatch)");
eq(s.open("wrongkeywrongkeywrongkeywrongkey", env, 7), nil, "wrong key -> nil");

// ── ENRICH: is_valid_envelope ────────────────────────────────────────────────────
eq(s.is_valid_envelope(env), true, "valid envelope"); eq(s.is_valid_envelope("not.an.envelope"), false, "bad envelope (3 parts)");
eq(s.is_valid_envelope("garbage"), false, "garbage envelope");

// ── ENRICH: replay_guard rejects reused sequence numbers ─────────────────────────
let g = s.replay_guard();
eq(s.accept(g, 1), true, "first seq accepted");
eq(s.accept(g, 1), false, "replayed seq rejected");
eq(s.accept(g, 2), true, "new seq accepted");

// ── ENRICH: next_seq for senders ─────────────────────────────────────────────────
let g2 = s.replay_guard();
s.accept(g2, 5);
eq(s.next_seq(g2), 6, "next_seq after highest seen");

print "securelayer_enrich_pass";
