// Test: stdlib/project_inventory.sapp metadata-only bounded filesystem survey.

let INV = import("stdlib:project_inventory.sapp");

fn fail(m) { throw "FAIL " + m; }

let ROOT = "tests/fixtures/_project_inventory";

fn cleanup() {
    try fs_remove(ROOT + "/pl-dev/pblang/editors/ide/pbide.sapp") catch nil;
    try fs_remove(ROOT + "/pl-dev/pblang/editors/ide") catch nil;
    try fs_remove(ROOT + "/pl-dev/pblang/editors") catch nil;
    try fs_remove(ROOT + "/pl-dev/pblang") catch nil;
    try fs_remove(ROOT + "/pl-dev") catch nil;
    try fs_remove(ROOT + "/ai/pbai/docs/pbAI.md") catch nil;
    try fs_remove(ROOT + "/ai/pbai/docs") catch nil;
    try fs_remove(ROOT + "/ai/pbai") catch nil;
    try fs_remove(ROOT + "/ai") catch nil;
    try fs_remove(ROOT + "/os-dev/pbos/README.md") catch nil;
    try fs_remove(ROOT + "/os-dev/pbos") catch nil;
    try fs_remove(ROOT + "/os-dev") catch nil;
    try fs_remove(ROOT + "/tools/rust/pb-mcp-server/README.md") catch nil;
    try fs_remove(ROOT + "/tools/rust/pb-mcp-server") catch nil;
    try fs_remove(ROOT + "/tools/rust") catch nil;
    try fs_remove(ROOT + "/tools") catch nil;
    try fs_remove(ROOT + "/.ssh/id_ed25519") catch nil;
    try fs_remove(ROOT + "/.ssh") catch nil;
    try fs_remove(ROOT + "/.claude/settings.local.json") catch nil;
    try fs_remove(ROOT + "/.claude") catch nil;
    try fs_remove(ROOT + "/.codex/state.json") catch nil;
    try fs_remove(ROOT + "/.codex") catch nil;
    try fs_remove(ROOT + "/graphify-out/.graphify_labels.json") catch nil;
    try fs_remove(ROOT + "/graphify-out") catch nil;
    try fs_remove(ROOT + "/tool-venv/lib/python3.12/site-packages/dependency.py") catch nil;
    try fs_remove(ROOT + "/tool-venv/lib/python3.12/site-packages") catch nil;
    try fs_remove(ROOT + "/tool-venv/lib/python3.12") catch nil;
    try fs_remove(ROOT + "/tool-venv/lib") catch nil;
    try fs_remove(ROOT + "/tool-venv") catch nil;
    try fs_remove(ROOT + "/target/cache.bin") catch nil;
    try fs_remove(ROOT + "/target") catch nil;
    try fs_remove(ROOT) catch nil;
}

cleanup();

fs_mkdirs(ROOT + "/pl-dev/pblang/editors/ide");
fs_mkdirs(ROOT + "/ai/pbai/docs");
fs_mkdirs(ROOT + "/os-dev/pbos");
fs_mkdirs(ROOT + "/tools/rust/pb-mcp-server");
fs_mkdirs(ROOT + "/.ssh");
fs_mkdirs(ROOT + "/.claude");
fs_mkdirs(ROOT + "/.codex");
fs_mkdirs(ROOT + "/graphify-out");
fs_mkdirs(ROOT + "/tool-venv/lib/python3.12/site-packages");
fs_mkdirs(ROOT + "/target");
fs_write(ROOT + "/pl-dev/pblang/editors/ide/pbide.sapp", "fn main(){ print \"ide\"; }");
fs_write(ROOT + "/ai/pbai/docs/pbAI.md", "# pbAI");
fs_write(ROOT + "/os-dev/pbos/README.md", "# pbOS");
fs_write(ROOT + "/tools/rust/pb-mcp-server/README.md", "# MCP");
fs_write(ROOT + "/.ssh/id_ed25519", "PRIVATE");
fs_write(ROOT + "/.claude/settings.local.json", "{\"permissions\":{\"allow\":[\"Bash(xargs -I {} bash -c bad)\"]}}");
fs_write(ROOT + "/.codex/state.json", "{\"local\":\"state\"}");
fs_write(ROOT + "/graphify-out/.graphify_labels.json", "{\"0\":\"TODO generated graph label\"}");
fs_write(ROOT + "/tool-venv/lib/python3.12/site-packages/dependency.py", "panic!(\"third party\")");
fs_write(ROOT + "/target/cache.bin", "CACHE");

if not INV.should_skip_path(ROOT + "/.ssh/id_ed25519") { fail("ssh key path should be skipped"); }
if not INV.should_skip_path(ROOT + "/.claude/settings.local.json") { fail("local Claude settings should be skipped"); }
if not INV.should_skip_path(ROOT + "/.codex/state.json") { fail("local Codex state should be skipped"); }
if not INV.should_skip_path(ROOT + "/graphify-out/.graphify_labels.json") { fail("generated graphify output should be skipped"); }
if not INV.should_skip_path(ROOT + "/target/cache.bin") { fail("target cache path should be skipped"); }
if not INV.should_skip_path(ROOT + "/tool-venv/lib/python3.12/site-packages/dependency.py") { fail("vendored virtual environment should be skipped"); }
if INV.should_skip_path(ROOT + "/pl-dev/pblang") { fail("pblang path should be safe for metadata"); }
if INV.should_skip_path(".") or INV.should_skip_path("..") { fail("caller-approved current/parent roots should not be pruned as hidden names"); }

let inv = INV.inventory_roots([ROOT], map{ max_depth: 7, max_entries: 200, max_children_per_dir: 80 });
if inv.format != "pblang.project_inventory.report.v1" { fail("inventory report format"); }
if inv.record_count < 8 { fail("inventory should collect project metadata records"); }
if inv.skipped_count < 5 { fail("inventory should skip .ssh, local assistant, generated output, and target paths"); }
if not str_contains(inv.policy, "no file contents") { fail("inventory policy is metadata-only"); }
if not str_contains(inv.policy, "generated-output") { fail("inventory policy mentions generated-output pruning"); }
if inv.timed_out or inv.duration_ms < 0 { fail("small inventory completes within cooperative deadline"); }
let paths = str_join(INV.inventory_paths(inv), "\n");
if not str_contains(paths, "pbide.sapp") { fail("inventory includes safe IDE file path metadata"); }
if not str_contains(paths, "pb-mcp-server") { fail("inventory includes safe pb-mcp path metadata"); }
if str_contains(paths, "id_ed25519") or str_contains(paths, "settings.local") or str_contains(paths, "state.json") or str_contains(paths, "graphify-out") or str_contains(paths, "cache.bin") or str_contains(paths, "tool-venv") { fail("inventory leaked skipped sensitive/local/generated/build/vendor paths"); }

let lines = str_join(INV.inventory_lines(inv, 10), "\n");
if not str_contains(lines, "Project inventory") or not str_contains(lines, "metadata") { fail("inventory lines summarize metadata policy"); }

let dot_inv = INV.inventory_roots(["."], map{ max_depth: 0, max_entries: 5, max_children_per_dir: 5 });
if dot_inv.record_count < 1 { fail("inventory_roots accepts current-directory root"); }

let deadline_inv = INV.inventory_roots([ROOT], map{ max_depth: 7, max_entries: 200,
    max_children_per_dir: 80, max_runtime_ms: 10 });
if deadline_inv.duration_ms > 1000 or not map_has(deadline_inv, "timed_out") {
    fail("inventory exposes a cooperative runtime budget");
}

let result = INV.portfolio_action_from_roots([ROOT], map{ max_depth: 7, max_entries: 200, limit_per_project: 4, line_limit: 16 });
if result.format != "pblang.project_inventory.portfolio_action.v1" { fail("portfolio action result format"); }
if result.proposals.format != "pblang.project_survey.proposal_catalog.v1"
   or result.proposals.repository_creation_allowed { fail("inventory emits review-only project proposals"); }
if len(result.action_plan.projects) != 16 or len(result.action_plan.top_tasks) != 10 { fail("portfolio action from roots covers every declared product with a bounded top-ten queue"); }
let action_text = str_join(result.lines, "\n");
if not str_contains(action_text, "pbide/graphics") { fail("portfolio action includes PBIDE graphics task"); }
if not str_contains(action_text, "pbai/ai") { fail("portfolio action includes pbAI task"); }
if not str_contains(action_text, "pb-mcp-server") { fail("portfolio action includes pb-mcp task"); }
if not str_contains(action_text, "pbremote") { fail("portfolio action includes PBRemote task"); }

cleanup();
print "project_inventory_pass";
