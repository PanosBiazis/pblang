// tests/semantics/pbai_lm_decode_test.sapp — nucleus (top-p) sampling + repetition
// penalty for the pbAI char-LM. Pure primitives (no training); generation determinism
// checked on a fresh model.

let LM = import("stdlib/pbai_lm.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn sumv(v) { let s = 0; let i = 0; while i < len(v) { s = s + v[i]; i = i + 1; } return s; }

// ── top_p_filter: keep the smallest set whose cumulative mass >= p, renormalize ────
let f = LM.top_p_filter([0.6, 0.3, 0.1], 0.8);
eq(f[2], 0, "top_p drops the tail beyond p");
if f[0] <= 0 or f[1] <= 0 { fail("top_p keeps the nucleus"); }
approx(sumv(f), 1, "top_p renormalizes to 1");
// p=1 keeps everything
let fall = LM.top_p_filter([0.5, 0.3, 0.2], 1);
if fall[2] <= 0 { fail("top_p p=1 keeps all"); }
// always keeps at least the top-1, even if it alone exceeds p
let f1 = LM.top_p_filter([0.9, 0.07, 0.03], 0.5);
if f1[0] <= 0 { fail("top_p keeps at least the argmax"); }
eq(f1[1], 0, "top_p drops the rest when top1 covers p");

// ── apply_repetition_penalty: discourage already-seen ids ──────────────────────────
let lg = LM.apply_repetition_penalty([1, 2, 3], [2], 2);
approx(lg[0], 1, "unseen logit unchanged");
approx(lg[1], 2, "unseen logit unchanged");
approx(lg[2], 1.5, "seen positive logit divided by penalty");
// negative logits are multiplied (pushed further down)
let lg2 = LM.apply_repetition_penalty([0 - 2, 1], [0], 2);
approx(lg2[0], 0 - 4, "seen negative logit multiplied by penalty");

// ── generate_decode: runs, correct length, reproducible, greedy-equivalent ─────────
let vocab = LM.vocab_build("hello world pblang decoding nucleus");
let m = LM.model_new(LM.vocab_size(vocab), 6, 8, 2, 11);
let g = LM.generate_decode(m, vocab, "he", 6, map{ temperature: 0.9, top_k: 0, top_p: 0.9, repetition_penalty: 1.2, seed: 7 });
eq(len(g), len("he") + 6, "generate_decode length");
let g2 = LM.generate_decode(m, vocab, "he", 6, map{ temperature: 0.9, top_k: 0, top_p: 0.9, repetition_penalty: 1.2, seed: 7 });
eq(g, g2, "generate_decode reproducible for same seed");
// greedy config (top_k=1) matches plain greedy generate
let gg = LM.generate_decode(m, vocab, "he", 6, map{ temperature: 1, top_k: 1, top_p: 1, repetition_penalty: 1, seed: 1 });
eq(gg, LM.generate(m, vocab, "he", 6), "top_k=1 decode equals greedy");

print "pbai_lm_decode_pass";
