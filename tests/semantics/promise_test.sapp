// Test: thread stdlib — Promise / Future pattern
import "stdlib:thread.sapp";

// promise that returns quickly
let p1 = thread.promise(fn() {
    return 42;
});

// is_ready may be false immediately (race), but await must work
let val1 = thread.await(p1);
if val1 != 42 { print "FAIL promise basic value: " + str(val1); }

// await_timeout — should succeed because computation finishes fast
let p2 = thread.promise(fn() {
    return "hello";
});
let r2 = thread.await_timeout(p2, 5000);
if r2.ok == false { print "FAIL promise await_timeout ok"; }
if r2.value != "hello" { print "FAIL promise await_timeout value: " + str(r2.value); }

// is_ready after await should be true
thread.await(thread.promise(fn() { return 1; }));
// (is_ready checks are timing-sensitive; skip here)

// Multiple promises
let p3 = thread.promise(fn() { return 10; });
let p4 = thread.promise(fn() { return 20; });
let v3 = thread.await(p3);
let v4 = thread.await(p4);
if v3 != 10 { print "FAIL parallel promise p3: " + str(v3); }
if v4 != 20 { print "FAIL parallel promise p4: " + str(v4); }

print "promise_pass";
