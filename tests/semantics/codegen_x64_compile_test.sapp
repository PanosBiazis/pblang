// tests/semantics/codegen_x64_compile_test.sapp — compile a small register-IR (arithmetic
// + counted loops) to NATIVE x86-64 and prove it by RUNNING the binary and reading its exit
// code. Registers r0..r3 -> rax/rcx/rdx/rbx; the program's result (r0) becomes the exit code
// (mod 256). Zero Rust in the codegen path.

let CG = import("stdlib/codegen_x64.sapp");

fn fail(m) { throw "FAIL " + m; }

// compile `ir`, run the native binary, return its exit code.
fn run_rc(ir, tag) {
    let elf = CG.compile_program(ir);
    let path = "pbcc_" + tag + ".bin";
    fs_write_bytes(path, elf);
    proc_spawn_wait("bash", ["-c", "chmod +x " + path]);
    let r = proc_spawn_wait("bash", ["-c", "./" + path + "; echo RC=$?"]);
    proc_spawn_wait("bash", ["-c", "rm -f " + path]);
    let out = try r.stdout catch "";
    let idx = str_index_of(out, "RC=");
    if idx < 0 { fail(tag + ": no exit code (<<" + str(out) + ">>)"); }
    let rest = str_slice(out, idx + 3, len(out));
    return parse_number(str_trim(rest));
}
fn eqrc(ir, want, tag) {
    let got = run_rc(ir, tag);
    if got != want { fail(tag + " exit got=" + str(got) + " want=" + str(want)); }
}

// ── pure arithmetic:  (2+3)*4 - 1 = 19 ──────────────────────────────────────────────
eqrc([
    ["seti", 0, 2], ["seti", 1, 3], ["add", 0, 1],   // r0 = 5
    ["seti", 1, 4], ["mul", 0, 1],                    // r0 = 20
    ["seti", 1, 1], ["sub", 0, 1]                     // r0 = 19
], 19, "arith");

// ── add-immediate ───────────────────────────────────────────────────────────────────
eqrc([["seti", 0, 100], ["addi", 0, 23]], 123, "addi");

// ── counted loop: sum 1..10 = 55 ────────────────────────────────────────────────────
eqrc([
    ["seti", 0, 0],                  // acc = 0
    ["seti", 1, 10],                 // counter = 10
    ["loop", 1, [["add", 0, 1]]]     // acc += counter, 10 down to 1
], 55, "loop_sum");

// ── loop guard: counter 0 runs the body ZERO times (no runaway) ─────────────────────
eqrc([
    ["seti", 0, 7], ["seti", 1, 0],
    ["loop", 1, [["addi", 0, 5]]]    // body skipped entirely
], 7, "loop_zero");

// ── nested loops: 3 * 4 done as loops = 12 ──────────────────────────────────────────
eqrc([
    ["seti", 0, 0],                  // acc
    ["seti", 1, 3],                  // outer counter
    ["loop", 1, [
        ["seti", 2, 4],              // inner counter reset each outer iter
        ["loop", 2, [["addi", 0, 1]]]
    ]]
], 12, "nested");

// ── safety: the generator REJECTS malformed IR (out-of-range register) ──────────────
let threw = false;
let chk = try CG.compile_program([["seti", 9, 1]]) catch nil;
if chk == nil { threw = true; }
if not threw { fail("compile_program must reject an out-of-range register"); }

print "codegen_x64_compile_pass";
