let Native=import("stdlib:native_crypto_accel.sapp");
let AES=import("stdlib:aes_gcm.sapp");
let session=Native.open();
if not session.ok { print "native_crypto_accel_skip"; return nil; }
let digest=Native.digest(session,512,str_to_bytes("abc"));
if not digest.ok or AES.bytes_hex(digest.bytes)!="ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f" {
    let detail=json_stringify(digest); Native.close(session); throw "native SHA-512 vector mismatch: "+detail;
}
let key=AES.hex_bytes("2b7e151628aed2a6abf7158809cf4f3c");
let iv=AES.hex_bytes("000102030405060708090a0b0c0d0e0f");
let plain=AES.hex_bytes("6bc1bee22e409f96e93d7e117393172a");
let encrypted=Native.aes_cbc_encrypt_blocks(session,plain,key,iv);
if not encrypted.ok or AES.bytes_hex(encrypted.bytes)!="7649abac8119b246cee98e9b12e9197d" {
    let detail=json_stringify(encrypted); Native.close(session); throw "native AES-CBC vector mismatch: "+detail;
}
Native.close(session); print "native_crypto_accel_pass";
