let Native=import("stdlib:native_crypto_accel.sapp");
let AES=import("stdlib:aes_gcm.sapp");
let DIRFS=import("stdlib:linux_dirfs.sapp");
let session=Native.open();
if not session.ok { print "native_crypto_accel_skip"; return nil; }
let digest=Native.digest(session,512,str_to_bytes("abc"));
if not digest.ok or AES.bytes_hex(digest.bytes)!="ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f" {
    let detail=json_stringify(digest); Native.close(session); throw "native SHA-512 vector mismatch: "+detail;
}
let key=AES.hex_bytes("2b7e151628aed2a6abf7158809cf4f3c");
let iv=AES.hex_bytes("000102030405060708090a0b0c0d0e0f");
let plain=AES.hex_bytes("6bc1bee22e409f96e93d7e117393172a");
let encrypted=Native.aes_cbc_encrypt_blocks(session,plain,key,iv);
if not encrypted.ok or AES.bytes_hex(encrypted.bytes)!="7649abac8119b246cee98e9b12e9197d" {
    let detail=json_stringify(encrypted); Native.close(session); throw "native AES-CBC vector mismatch: "+detail;
}

let root="/tmp/pblang-native-crypto-stream-"+
    str_slice(sha256(base64_encode_bytes(random_bytes(24))),0,24);
let files=DIRFS.open_absolute(root,true,true);
if not files.ok { Native.close(session); throw "streaming digest fixture root failed"; }
let payload=[];
let i=0;
while i<Native.STREAM_CHUNK_BYTES+3 {
    array_push(payload,(i*29+17)%256); i=i+1;
}
let marker=[222,173,190,239];
for marker_index len(marker) {
    payload[101+marker_index]=marker[marker_index];
    payload[Native.SCAN_CHUNK_BYTES-2+marker_index]=marker[marker_index];
}
let written=DIRFS.write_new_exclusive(files,"payload.bin",payload,false);
let held=if written.ok { DIRFS.child_file_descriptor(files,"payload.bin") }
    else { map{ok:false}; };
if not held.ok {
    DIRFS.close(files); Native.close(session); throw "streaming digest fixture descriptor failed";
}
let streamed=Native.sha256_base64_fd_range(session,held.fd,0,len(payload));
let range=Native.sha256_base64_fd_range(session,held.fd,1,len(payload)-2);
let overrun=Native.sha256_base64_fd_range(session,held.fd,0,len(payload)+1);
let scan=Native.scan_fd_magic(session,held.fd,len(payload),marker,4);
let scan_budget=Native.scan_fd_magic(session,held.fd,len(payload),marker,1);
let expected=sha256(base64_encode_bytes(payload));
let expected_range=sha256(base64_encode_bytes(slice(payload,1,len(payload)-1)));
if not streamed.ok or streamed.sha256!=expected or not streamed.bounded_memory
    or not range.ok or range.sha256!=expected_range or overrun.ok
    or not scan.ok or scan.offsets!=[101,Native.SCAN_CHUNK_BYTES-2]
    or scan_budget.ok {
    let detail=json_stringify(map{streamed:streamed,range:range,overrun:overrun,
        scan:scan,scan_budget:scan_budget});
    DIRFS.close_child_descriptor(files,held); DIRFS.remove_file(files,"payload.bin");
    DIRFS.close(files); Native.close(session);
    throw "streaming base64 SHA-256 mismatch: "+detail;
}
DIRFS.close_child_descriptor(files,held); DIRFS.remove_file(files,"payload.bin");
DIRFS.close(files);
let tmp=DIRFS.open_absolute("/tmp",false,false);
if tmp.ok { DIRFS.remove(tmp,path_basename(root)); DIRFS.close(tmp); }
Native.close(session); print "native_crypto_accel_pass";
