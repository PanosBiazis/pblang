// tests/semantics/syntax_hl_enrich2_test.sapp — wave 2 for stdlib/syntax_hl.sapp
// to_html renderer (escaped spans) + legend color key.

let S = import("stdlib/syntax_hl.sapp");

fn fail(m) { throw "FAIL " + m; }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : <<" + s + ">>"); } }

let html = S.to_html("let x = 1", "dark");
has(html, "<pre", "to_html wraps in <pre>");
has(html, "</pre>", "to_html closes <pre>");
has(html, "<span", "to_html emits spans");
has(html, "rgb(", "to_html sets css color");
has(html, "let", "to_html keeps source text");

// HTML metacharacters in the source must be escaped, never emitted raw as markup.
let esc = S.to_html("a < b", "dark");
has(esc, "&lt;", "to_html escapes < to &lt;");

// legend: a color key for the token kinds
let leg = S.legend("dark");
if len(leg) < 6 { fail("legend should list >=6 kinds, got " + str(len(leg))); }
let found_kw = false;
let i = 0;
while i < len(leg) { if leg[i].kind == "keyword" { found_kw = true; } i = i + 1; }
if not found_kw { fail("legend includes keyword"); }

print "syntax_hl_enrich2_pass";
