// Run only in a dedicated test process: this changes and restores its own label.
let I=import("stdlib:process_identity.sapp");
assert(platform()=="linux","Linux live identity test");
let previous=str_trim(fs_read("/proc/self/comm"));
let named=I.apply("pb-name-test");
let actual=str_trim(fs_read("/proc/self/comm"));
let repeated=I.apply("pb-name-test");
let unicode=I.apply("αβγδεζηθ");
let observed=str_trim(fs_read("/proc/self/comm"));
let restored=I.apply(previous);
assert(restored.ok,"original label restored");
assert(named.ok and named.applied and actual=="pb-name-test","kernel label changed");
assert(repeated.ok and not repeated.applied and repeated.reason=="already-set","idempotent request");
assert(unicode.ok and unicode.truncated and observed=="αβγδεζη","actual UTF-8 label verified");
assert(not named.identity_verified,"label is not authenticated identity");
print "process_identity_live_pass";
