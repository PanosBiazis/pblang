let V=import("stdlib:table_cell_view.sapp");let S=import("stdlib:sheet_document.sapp");let UI=import("stdlib:modern_ui.sapp");let d=S.create(1,2);d.cells[0]=[str_repeat("x",256),"μικρό"];for target in ["native","web","android"]{let plan=UI.compile(V.create(d,0,"PBJoin table reader"),map{target:target,width:412,height:915});assert(str_contains(json_stringify(plan),"PBJoin table reader"),"custom heading");}for title in ["",nil,str_repeat("a",65),"a\u0000b"]{assert((try V.create(d,0,title) catch nil)==nil,"invalid heading");}assert(str_contains(json_stringify(V.create(d)),"PBTally table reader"),"old default retained");print "table_reader_title_pass";
