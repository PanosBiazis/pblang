// tests/semantics/pkg_enrich2_test.sapp — wave 2 for stdlib/pkg.sapp
// Full semver parse incl. prerelease/build metadata.

let K = import("stdlib/pkg.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let f = K.semver_parse_full("1.2.3-alpha.1+build.5");
eq(f.major, 1, "major"); eq(f.minor, 2, "minor"); eq(f.patch, 3, "patch");
eq(f.prerelease, "alpha.1", "prerelease");
eq(f.build, "build.5", "build metadata");

let g = K.semver_parse_full("2.0.0");
eq(g.major, 2, "plain major");
eq(g.prerelease, "", "no prerelease");
eq(g.build, "", "no build");

let h = K.semver_parse_full("1.0.0+meta");
eq(h.prerelease, "", "build only -> no prerelease");
eq(h.build, "meta", "build only");

if not K.semver_is_prerelease("1.0.0-rc1") { fail("rc1 is prerelease"); }
if K.semver_is_prerelease("1.0.0") { fail("plain is not prerelease"); }
if K.semver_is_prerelease("1.0.0+meta") { fail("build-only is not prerelease"); }

print "pkg_enrich2_pass";
