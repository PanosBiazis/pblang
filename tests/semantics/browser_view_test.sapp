let D=import("stdlib:browser_document.sapp");let V=import("stdlib:browser_view.sapp");
let UI=import("stdlib:modern_ui.sapp");let GUI=import("stdlib:gui.sapp");
let Web=import("stdlib:modern_ui_web.sapp");let Android=import("stdlib:modern_ui_android.sapp");
let App=import("../../examples/declarative_browser/app.sapp");
let doc=D.import_html("<article><h1>Shared — Κοινό</h1><p>Literal &lt;script&gt;</p><a href=\"pb://guide\">Guide</a></article>");
let view=V.create(doc);let expected=[];
for target in ["desktop","web","android","ios"] {
    let plan=V.plan(doc,target);let values=[];
    for item in plan.bundle.records {push(values,map{name:item.name,text:try item.source.text catch "",action:try item.source.action catch nil});}
    if len(expected)==0 {expected=values;}else {assert(expected==values,"same content and portable link-inspection action across targets");}
    assert(not plan.navigation and not plan.network and len(plan.native_permissions)==0,"representation grants no device or network authority");
    if target=="ios" {assert(not plan.linked,"iOS is an explicit unlinked contract");}
}
let form=UI.build("Shared",view);GUI.get(form,"block1").onclick(form);
assert(GUI.get(form,"destination").text=="pb://guide","portable native action reveals destination only");
let generated=Web.generate("Shared",UI.compile(view,map{target:"web"}));
assert(str_contains(generated.html,"&lt;script&gt;") and not str_contains(generated.html,"href=\"pb:"),"Web escapes text and never dispatches OS schemes");
let bytes=Android.activity_class(UI.compile(view,map{target:"android"}));
assert(len(bytes)>100 and bytes[0]==202 and bytes[1]==254,"actual Android JVM class generation");
let manifest=Android.manifest("PB Reader",map{package:"org.pblang.reader"});
assert(not str_contains(manifest,"uses-permission"),"preview declares no native permissions");
let c=App.create();GUI.get(c.form,"block2").onclick(c.form);App.update(c,[]);
assert(c.session.snapshot().url=="pb://guide","native binding performs admitted navigation");
GUI.get(c.form,"block2").onclick(c.form);App.update(c,[]);
assert(c.session.snapshot().url=="pb://about","different links retain their own index");
GUI.get(c.form,"back").onclick(c.form);App.update(c,[]);assert(c.session.snapshot().url=="pb://guide","native back");
GUI.get(c.form,"forward").onclick(c.form);App.update(c,[]);assert(c.session.snapshot().url=="pb://about","native forward");
GUI.get(c.form,"home").onclick(c.form);App.update(c,[]);assert(c.session.snapshot().url=="pb://home","native home");
let locked=App.create("locked");GUI.get(locked.form,"block2").onclick(locked.form);App.update(locked,[]);
assert(locked.session.snapshot().url=="pb://home" and str_contains(GUI.get(locked.form,"destination").text,"denied"),"native denied link leaves session intact");
c.session.close();locked.session.close();
assert((try V.plan(doc,"unknown-os") catch nil)==nil,"unsupported targets do not silently fall back");
print "browser_view_pass";
