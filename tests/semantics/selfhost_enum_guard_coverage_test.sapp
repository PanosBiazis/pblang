let T = import("stdlib:compiler/tokenizer.sapp");
let P = import("stdlib:compiler/parser.sapp");
let C = import("stdlib:compiler/typeck.sapp");
let F = import("stdlib:compiler/selfhost_frontend.sapp");
fn expect(ok, message) { if not ok { throw "FAIL enum-guard-coverage: " + message; } }
fn source(arms) {
    return "enum Color { Red, Blue } fn code(c: Color, allowed: bool): number { return match c.__variant { " + arms + " }; }";
}
fn check(arms) {
    let ast = P.parse(T.tokenize(source(arms)));
    expect(len(ast.errors) == 0, "fixture parses");
    return C.type_check(ast.stmts);
}
fn coverage(diags) {
    let out = [];
    for d in diags { if d.code == "non-exhaustive-match" { array_push(out, d); } }
    return out;
}
for arm in ["case n if false: 1;", "case _ if false: 1;", "case n if allowed: 1;",
            "case _ if allowed: 1;", "case \"Blue\" if allowed: 1;", "case \"Blue\" if false: 1;"] {
    let arms = "case \"Red\": 0; " + arm;
    let missing = coverage(check(arms));
    expect(len(missing) == 1 and str_contains(missing[0].message, "Blue"), "guarded arm cannot guarantee Blue coverage");
    expect(not str_contains(missing[0].message, "Red"), "unguarded Red remains covered");
    expect(not F.frontend_compile(source(arms)).ok, "checked compile rejects missing coverage");
}
for arms in [
    "case \"Red\": 0; case \"Blue\": 1;",
    "case \"Red\": 0; case n: 1;",
    "case \"Red\": 0; case _: 1;",
    "case \"Red\": 0; case n if true: 1;",
    "case \"Red\": 0; case _ if true: 1;",
    "case \"Red\": 0; case \"Blue\" if true: 1;",
    "case \"Blue\" if allowed: 2; case \"Red\": 0; case \"Blue\": 1;",
    "case \"Blue\" if allowed: 2; case \"Red\": 0; else: 1;"
] { expect(len(check(arms)) == 0, "unconditional fallback remains valid"); }
let dynamic_true = "enum Color { Red, Blue } fn always() { return true; } fn code(c: Color): number { return match c.__variant { case n if always(): 1; }; }";
expect(len(coverage(F.frontend_compile(dynamic_true).diagnostics)) == 1, "function call is not static coverage proof");
let duplicate = coverage(check("case \"Red\" if allowed: 0; case \"Red\" if not allowed: 1;"));
expect(len(duplicate) == 1 and str_contains(duplicate[0].message, "Red") and str_contains(duplicate[0].message, "Blue"), "no theorem proving for complementary guards");
let unknown = check("case n if missing_guard: 0; else: 1;");
expect(len(unknown) > 0 and unknown[0].code == "undefined-name", "fallback does not hide guard errors");
let valid = F.frontend_run_bounded(source("case \"Red\" if allowed: 2; case \"Red\": 3; case \"Blue\": 4;")
    + "let a = code(Color.Red, true); let b = code(Color.Red, false); let c = code(Color.Blue, true);", map{ max_steps: 2000, max_frames: 8 });
expect(valid.ok and valid.globals.a == 2 and valid.globals.b == 3 and valid.globals.c == 4, "guard and fallback runtime behavior unchanged");
let rejected = F.frontend_run_bounded("print 123; " + source("case n if false: 1;"), map{ max_steps: 2000, max_frames: 8 });
expect(not rejected.ok and len(rejected.output) == 0, "rejected program produces no output");
// Ordinary non-enum match remains outside enum coverage checking.
expect(F.frontend_compile("let result = match 2 { case n if false: 1; };").ok, "non-enum match remains supported");
let malformed = P.parse(T.tokenize(source("case _: 1;")));
malformed.stmts[1].body.stmts[0].value.arms = [map{ pattern: map{ ptype: "wildcard" }, body: map{ kind: "number", value: "1" } }];
let bad = C.type_check(malformed.stmts);
let shape_error = false;
for d in bad { if d.code == "malformed-ast" { shape_error = true; } }
expect(shape_error and len(coverage(bad)) == 1, "missing guard metadata is not unconditional coverage");
let corrupt = P.parse(T.tokenize(source("case _ if true: 1;")));
corrupt.stmts[1].body.stmts[0].value.arms[0].guard.value = "true";
expect(len(coverage(C.type_check(corrupt.stmts))) == 1, "string metadata is not literal boolean true");
print "selfhost_enum_guard_coverage_pass";
