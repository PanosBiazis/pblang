// Test: stdlib/floatn.sapp -- arbitrary-width float (fN) engine.
// Verifies metadata, quantization against known IEEE/OCP reference values, exact
// round-trips, packing, tiny formats, and the honest f64-ceiling limits.

let F = import("stdlib:floatn.sapp");

fn approx(a, b, tol) { let d = a - b; if d < 0 { d = 0 - d; } return d <= tol; }

// ---- metadata --------------------------------------------------------------
let i16 = F.info("f16");
assert(i16.bits == 16 and i16.exp == 5 and i16.mant == 10, "f16 field split e5m10");
assert(i16.max_finite == 65504, "f16 max finite is 65504");
assert(i16.eps == 0.0009765625, "f16 eps is 2^-10");
assert(i16.min_normal == 0.00006103515625, "f16 min normal is 2^-14");

assert(F.info("f32").exp == 8 and F.info("f32").mant == 23, "f32 is e8m23");
assert(F.info("f64").exp == 11 and F.info("f64").mant == 52, "f64 is e11m52");
assert(F.info("bf16").exp == 8 and F.info("bf16").mant == 7, "bf16 is e8m7");
assert(F.info("f8e4m3").max_finite == 448, "f8e4m3 max finite is 448");
assert(F.info("f8e5m2").max_finite == 57344, "f8e5m2 max finite is 57344");

// ---- quantize: exact representables -----------------------------------------
assert(F.quantize(1.0, "f16") == 1.0, "f16 quantizes 1.0 exactly");
assert(F.quantize(0.5, "f16") == 0.5, "f16 quantizes 0.5 exactly");
assert(F.quantize(0 - 2.0, "f16") == (0 - 2.0), "f16 quantizes -2.0 exactly");
assert(F.quantize(65504, "f16") == 65504, "f16 quantizes its max exactly");

// ---- quantize: known rounding ----------------------------------------------
assert(F.quantize(3.14159, "bf16") == 3.140625, "bf16 rounds pi to 3.140625 (7 mantissa bits)");
assert(approx(F.quantize(0.1, "f16"), 0.0999755859375, 0.0000000001), "f16 rounds 0.1 to 0.0999755859375");

// ---- overflow saturates to inf ---------------------------------------------
let big = F.quantize(1000000000, "f16");
assert(big == big * 2.0 and big > 0, "f16 overflow -> +inf");
let nbig = F.quantize(0 - 1000000000, "f16");
assert(nbig == nbig * 2.0 and nbig < 0, "f16 negative overflow -> -inf");

// ---- f64 path is exact (compute precision == storage precision) -------------
assert(F.quantize(0.1, "f64") == 0.1, "f64 stores 0.1 exactly");
assert(F.quantize(3.14159, "f64") == 3.14159, "f64 stores pi exactly");

// ---- code / bits round-trips equal the quantized value ----------------------
let xs = [0.0, 1.0, 0.5, 0 - 1.5, 0.1, 3.14159, 100.0, 0 - 0.001, 0 - 0.0];
let k = 0;
while k < len(xs) {
    let q = F.quantize(xs[k], "f16");
    assert(F.decode_code(F.code(xs[k], "f16"), "f16") == q, "f16 code round-trip @" + str(k));
    assert(F.decode_bits(F.encode_bits(xs[k], "f16"), "f16") == q, "f16 bits round-trip @" + str(k));
    k = k + 1;
}
assert(len(F.encode_bits(1.0, "f16")) == 16, "f16 encodes to 16 bits");
assert(len(F.encode_bits(1.0, "f8e4m3")) == 8, "f8e4m3 encodes to 8 bits");

// f8e4m3 / f8e5m2 round-trips
let ys = [0.0, 1.0, 0.5, 0 - 1.0, 0.25, 448, 0 - 256, 0.015625];
let j = 0;
while j < len(ys) {
    let q = F.quantize(ys[j], "f8e4m3");
    assert(F.decode_code(F.code(ys[j], "f8e4m3"), "f8e4m3") == q, "e4m3 round-trip @" + str(j));
    j = j + 1;
}

// ---- pack / unpack ----------------------------------------------------------
let vals = [1.0, 0.5, 0 - 2.0, 0.1, 0 - 0.25, 3.0];
let packed = F.pack(vals, "f8e5m2");
let un = F.unpack(packed, len(vals), "f8e5m2");
let p = 0;
while p < len(vals) {
    assert(un[p] == F.quantize(vals[p], "f8e5m2"), "e5m2 pack/unpack @" + str(p));
    p = p + 1;
}

// ---- tiny formats (f0/f1/f2) are real, not crashes --------------------------
let i0 = F.info("f0");
assert(i0.bits == 0 and i0.max_finite == 0, "f0 represents only zero");
assert(F.quantize(5.0, "f0") == 0, "f0 quantizes everything to 0");
assert(len(F.encode_bits(1.0, "f2")) == 2, "f2 encodes to 2 bits");
assert(F.decode_bits(F.encode_bits(1.0, "f2"), "f2") == F.quantize(1.0, "f2"), "f2 round-trip");
assert(F.decode_bits(F.encode_bits(0.0, "f1"), "f1") == F.quantize(0.0, "f1"), "f1 round-trip");

// ---- bare fN derivation matches IEEE where defined --------------------------
assert(F.info("f16").exp == F.info("f16").exp, "f16 resolves");
let bareInfo = F.info("f32");
assert(bareInfo.exp == 8, "bare f32 derives IEEE e8");

// ---- f128: described, but honestly not exactly encodable in f64 -------------
let i128 = F.info("f128");
assert(i128.bits == 128 and i128.exp == 15 and i128.mant == 112, "f128 is e15m112");
assert(i128.encodable == false, "f128 reports it is not exactly encodable in f64");
assert(i128.faithful == false, "f128 reports it exceeds f64 precision");
let enc128 = try F.encode_bits(1.0, "f128") catch "ERR";
assert(enc128 == "ERR", "f128 encode_bits raises an honest error");

// ---- quant_error -----------------------------------------------------------
assert(F.quant_error(0.1, "f16") == 0.1 - F.quantize(0.1, "f16"), "quant_error = x - quantize(x)");

// ---- Phase 2: emulated arithmetic ------------------------------------------
// exact small-integer ops survive any reasonable format
assert(F.mul(2.0, 3.0, "f16") == 6.0, "f16 mul 2*3 = 6");
assert(F.add(2.0, 3.0, "f16") == 5.0, "f16 add 2+3 = 5");
assert(F.sub(5.0, 3.0, "f16") == 2.0, "f16 sub 5-3 = 2");
assert(F.neg(2.0, "f16") == (0 - 2.0), "f16 neg 2 = -2");

// result is rounded to the format (matches quantize of the f64 result)
assert(F.add(0.1, 0.2, "f16") == F.quantize(F.quantize(0.1, "f16") + F.quantize(0.2, "f16"), "f16"),
    "f16 add rounds the f64 result");

// low precision swallows tiny addends: f16 ulp at 1.0 is 2^-10, so +0.0001 rounds away
assert(F.add(1.0, 0.0001, "f16") == 1.0, "f16 add(1, 0.0001) -> 1.0 (below half ulp)");
// f32 keeps it
assert(F.add(1.0, 0.0001, "f32") != 1.0, "f32 add(1, 0.0001) keeps the addend");

// dot product
assert(F.dot([1.0, 2.0, 3.0], [1.0, 1.0, 1.0], "f16") == 6.0, "f16 dot = 6");
assert(F.dot([1.0, 2.0], [3.0, 4.0], "f16") == 11.0, "f16 dot [1,2].[3,4] = 11");

// matmul: A x I = A
let A = [[1.0, 2.0], [3.0, 4.0]];
let I = [[1.0, 0.0], [0.0, 1.0]];
let P = F.matmul(A, I, "f16");
assert(P[0][0] == 1.0 and P[0][1] == 2.0 and P[1][0] == 3.0 and P[1][1] == 4.0, "f16 matmul A*I = A");

// matmul general: [[1,2],[3,4]] x [[5,6],[7,8]] = [[19,22],[43,50]]
let B2 = [[5.0, 6.0], [7.0, 8.0]];
let Q = F.matmul(A, B2, "f16");
assert(Q[0][0] == 19.0 and Q[0][1] == 22.0 and Q[1][0] == 43.0 and Q[1][1] == 50.0, "f16 matmul general");

// quantize_array rounds a whole vector
let qa = F.quantize_array([0.1, 0.2, 1.0], "f16");
assert(qa[0] == F.quantize(0.1, "f16") and qa[2] == 1.0, "quantize_array rounds elementwise");

print "floatn_test_pass";
