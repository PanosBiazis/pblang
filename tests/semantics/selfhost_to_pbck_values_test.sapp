// tests/semantics/selfhost_to_pbck_values_test.sapp
//
// Value-serialization coverage for the self-hosted -> Rust .pbck writer
// (stdlib/selfhost_to_pbck.sapp). The existing selfhost_to_pbck_test is
// integer/structure-focused; this locks the byte-level encoding of value kinds it
// doesn't exercise: NON-integer floats and special f64s (inf / -inf / NaN), UTF-8
// strings, nil, bitwise builtins, nested closures, string escapes, and nested
// maps. Each program is compiled by the self-hosted frontend, translated to a Rust
// .pbck, run on the native VM, and its output checked against the expected value.
//
// Expected values are HARDCODED (not compared to running the same source on the
// Rust frontend) on purpose: the two frontends differ on scientific-notation
// literals (the self-hosted tokenizer reads `1e308`, the Rust one reads `1`), which
// would be a confound here — this test isolates the TRANSLATOR's encoding.

let fe = import("stdlib/compiler/selfhost_frontend.sapp");
let xl = import("stdlib/selfhost_to_pbck.sapp");

fn fail(m) { throw "FAIL " + m; }

fn pbck_out(name, src) {
    let chunk = fe.frontend_compile(src).chunk;
    let bytes = xl.translate(chunk);
    let path = "/tmp/sxv_" + name + "_" + str(num_floor(now_ms())) + ".pbck";
    fs_write_bytes(path, bytes);
    let res = proc_spawn_wait("pblang", ["run", path, "--allow-all"]);
    let got = str_trim(res.stdout);
    if got == "" { return "ERR:" + str_trim(res.stderr); }
    return got;
}

fn want(name, src, expected) {
    let got = pbck_out(name, src);
    if got != expected { fail(name + ": expected '" + expected + "' got '" + got + "'"); }
}

// ── non-integer floats + special f64 values (exercise _w_f64 / num_to_le_bytes) ──
want("float", "print 3.14;", "3.14");
want("float_precise", "print 0.1 + 0.2;", "0.30000000000000004");
want("float_div", "print 7.0 / 2.0;", "3.5");
want("inf", "print 1.0 / 0.0;", "inf");
want("neg_inf", "print 0.0 - (1.0 / 0.0);", "-inf");
want("nan", "print 0.0 / 0.0;", "NaN");

// ── strings: UTF-8 and escapes (_w_str byte length must be the UTF-8 byte count) ─
want("unicode", "print \"caf\u{e9}\";", "café");
want("emoji_len", "let s = \"a\u{1F600}b\"; print len(s);", "3");
want("escape_len", "let s = \"a\\\"b\\\\c\nd\"; print len(s);", "7");

// ── nil constant ─────────────────────────────────────────────────────────────
want("nil", "let x = nil; print x;", "nil");

// ── bitwise builtins (lowered as GET_GLOBAL + CALL) ──────────────────────────
want("bit_and", "print bit_and(12, 10);", "8");
want("bit_or", "print bit_or(12, 10);", "14");
want("bit_xor", "print bit_xor(12, 10);", "6");

// ── nested closures / transitive upvalue capture ─────────────────────────────
want("nested_closure", "fn a(){ let x=1; return fn(){ let y=2; return fn(){ return x+y; }; }; } print a()()();", "3");

// ── nested map field access ──────────────────────────────────────────────────
want("nested_map", "let m = map{ a: map{ b: 5 } }; print m.a.b;", "5");

print "selfhost_to_pbck_values_pass";
