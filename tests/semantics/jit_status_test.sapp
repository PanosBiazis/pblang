let jit = import("stdlib:jit.sapp");

let mode = jit.runtime_mode();
assert(mode.mode == "transparent-vm-jit", "jit runtime mode is documented");
assert(mode.enable == "PBLANG_JIT=1", "jit enable flag is documented");
assert(mode.direct_compile_api == false, "direct jit compile API is not exposed");

let compiled = jit.compile_fn("demo", nil);
assert(compiled.compiled == false, "direct compile fails softly");
assert(str_contains(compiled.reason, "PBLANG_JIT=1"), "direct compile points to real JIT path");

print "jit_status_pass";
