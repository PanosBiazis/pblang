// tests/semantics/config_enrich_test.sapp — enrichment for stdlib/config.sapp
//
// Adds .env (dotenv) parsing/loading/dumping and JSON value access.

let config = import("stdlib/config.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base behavior unchanged ──────────────────────────────────────────────────────
let cfg = config.new();
config.set(cfg, "port", "8080");
eq(config.get_int(cfg, "port", 0), 8080, "base get_int");

// ── ENRICH: parse_dotenv ─────────────────────────────────────────────────────────
let env = config.parse_dotenv("# a comment\nHOST=localhost\nexport PORT=9090\nNAME=\"My App\"\nEMPTY=\n");
eq(env.HOST, "localhost", "dotenv plain"); eq(env.PORT, "9090", "dotenv export prefix");
eq(env.NAME, "My App", "dotenv quoted value with space"); eq(env.EMPTY, "", "dotenv empty value");

// ── ENRICH: load_dotenv merges into a config ─────────────────────────────────────
let c2 = config.new();
config.merge(c2, env);
eq(config.get(c2, "HOST", nil), "localhost", "merged dotenv into config");

// ── ENRICH: dump_dotenv round-trips ──────────────────────────────────────────────
let dumped = config.dump_dotenv(c2);
let reparsed = config.parse_dotenv(dumped);
eq(reparsed.NAME, "My App", "dump_dotenv quotes values with spaces -> round-trip");
eq(reparsed.HOST, "localhost", "dump_dotenv round-trip plain");

// ── ENRICH: get_json parses a JSON value ─────────────────────────────────────────
config.set(cfg, "tags", "[\"a\",\"b\",\"c\"]");
let tags = config.get_json(cfg, "tags", []);
eq(len(tags), 3, "get_json array len"); eq(tags[1], "b", "get_json element");
eq(config.get_json(cfg, "missing", map{ d: 1 }).d, 1, "get_json fallback");

print "config_enrich_pass";
