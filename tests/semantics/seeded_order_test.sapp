let O=import("stdlib:seeded_order.sapp");
assert(O.permutation(1,0)==[0],"independent integer shuffle oracle");
assert(O.permutation(1,1)==[0],"independent integer shuffle oracle");
assert(O.permutation(1,42)==[0],"independent integer shuffle oracle");
assert(O.permutation(1,4294967295)==[0],"independent integer shuffle oracle");
assert(O.permutation(2,0)==[1, 0],"independent integer shuffle oracle");
assert(O.permutation(2,1)==[1, 0],"independent integer shuffle oracle");
assert(O.permutation(2,42)==[1, 0],"independent integer shuffle oracle");
assert(O.permutation(2,4294967295)==[1, 0],"independent integer shuffle oracle");
assert(O.permutation(8,0)==[2, 0, 5, 6, 3, 4, 7, 1],"independent integer shuffle oracle");
assert(O.permutation(8,1)==[4, 6, 7, 0, 5, 3, 2, 1],"independent integer shuffle oracle");
assert(O.permutation(8,42)==[5, 7, 6, 4, 1, 3, 0, 2],"independent integer shuffle oracle");
assert(O.permutation(8,4294967295)==[5, 6, 4, 2, 3, 0, 7, 1],"independent integer shuffle oracle");
assert(O.permutation(31,0)==[17, 6, 9, 2, 21, 27, 20, 1, 3, 19, 5, 30, 13, 4, 26, 24, 0, 28, 22, 14, 25, 12, 11, 15, 29, 16, 10, 18, 23, 8, 7],"independent integer shuffle oracle");
assert(O.permutation(31,1)==[20, 16, 18, 25, 30, 23, 21, 10, 22, 26, 2, 6, 24, 4, 12, 17, 3, 15, 29, 8, 5, 28, 0, 13, 27, 9, 1, 19, 14, 11, 7],"independent integer shuffle oracle");
assert(O.permutation(31,42)==[30, 5, 19, 3, 25, 8, 24, 14, 4, 22, 27, 28, 18, 13, 23, 1, 26, 15, 12, 9, 17, 21, 20, 29, 11, 0, 10, 6, 16, 2, 7],"independent integer shuffle oracle");
assert(O.permutation(31,4294967295)==[15, 2, 29, 28, 20, 23, 14, 18, 6, 10, 21, 9, 26, 4, 8, 0, 13, 16, 12, 1, 30, 11, 24, 27, 25, 22, 19, 17, 3, 5, 7],"independent integer shuffle oracle");
assert(O.permutation(64,0)==[21, 6, 30, 8, 12, 9, 24, 55, 42, 32, 63, 38, 2, 20, 35, 26, 7, 57, 3, 56, 27, 13, 1, 5, 46, 48, 34, 61, 18, 44, 51, 47, 52, 11, 4, 41, 22, 37, 60, 49, 10, 16, 53, 59, 29, 62, 14, 33, 25, 0, 45, 54, 39, 43, 31, 28, 58, 19, 36, 23, 40, 50, 17, 15],"independent integer shuffle oracle");
assert(O.permutation(64,1)==[32, 36, 1, 20, 6, 33, 28, 18, 12, 24, 16, 29, 55, 50, 19, 54, 47, 8, 58, 38, 7, 59, 57, 25, 17, 37, 34, 40, 46, 49, 51, 10, 39, 45, 26, 43, 14, 52, 27, 5, 53, 2, 4, 9, 62, 56, 63, 41, 48, 11, 60, 30, 22, 13, 35, 0, 61, 44, 21, 3, 42, 31, 23, 15],"independent integer shuffle oracle");
assert(O.permutation(64,42)==[9, 49, 28, 47, 57, 14, 58, 19, 45, 27, 15, 51, 50, 3, 39, 12, 59, 60, 21, 8, 55, 34, 53, 41, 38, 36, 18, 61, 11, 20, 31, 52, 17, 0, 2, 63, 30, 62, 32, 37, 10, 23, 7, 24, 40, 42, 44, 56, 4, 29, 43, 33, 26, 46, 54, 48, 6, 25, 1, 22, 13, 35, 5, 16],"independent integer shuffle oracle");
assert(O.permutation(64,4294967295)==[61, 16, 27, 19, 49, 22, 6, 29, 1, 37, 40, 24, 44, 59, 58, 63, 56, 12, 45, 50, 5, 0, 4, 62, 10, 48, 9, 21, 20, 17, 39, 46, 54, 25, 53, 23, 31, 14, 32, 35, 7, 30, 42, 36, 34, 3, 13, 26, 57, 60, 47, 33, 2, 18, 28, 55, 41, 52, 51, 43, 38, 8, 11, 15],"independent integer shuffle oracle");
for count in [1,64,4096]{let a=O.permutation(count,42);let seen=map{};for i in a{assert(i>=0 and i<count and not map_has(seen,str(i)),"permutation bounds and uniqueness");seen[str(i)]=true;}assert(len(a)==count,"size");}
for a in [[0,1],[4097,1],[1.5,1],[1,-1],[1,4294967296],[1,1.5],[1,true],[nil,0],[1,"0"]]{assert((try O.permutation(a[0],a[1]) catch nil)==nil,"invalid order inputs");}print "seeded_order_pass: 20 independent fixtures plus 4096 elements";
