// tests/semantics/selfhost_semantic_walk_test.sapp
//
// The self-hosted semantic analyzer must traverse EVERY expression/statement
// kind the parser emits. It was skipping index/member/optional-chaining/
// coalesce/if-expr and the print/throw/try/for-range/assign-to statements, so
// free-variable (undeclared-name) detection silently ignored anything used
// inside `a[i]`, `a.b`, `a?.b`, `a ?? b`, `if c {..} else {..}` (as an expr),
// `throw x`, `print x`, `try {..}`, `for i n {..}`, and `t[i] = v`.

let sem = import("stdlib/compiler/semantic.sapp");
let fe = import("stdlib/compiler/selfhost_frontend.sapp");

fn fail(m) { throw "FAIL " + m; }
fn fvars(src) { let r = fe.frontend_parse_full(src); return sem.analyze(r.ast).free_variables; }
fn has(arr, name) { for v in arr { if v == name { return true; } } return false; }
fn need(src, name) { if not has(fvars(src), name) { fail(name + " must be detected in: " + src); } }

// index — both the object and the index expression
need("let a = freeArr[freeIdx];", "freeArr");
need("let a = freeArr[freeIdx];", "freeIdx");

// member — the object (the field name is not an expression)
need("let a = freeObj.field;", "freeObj");

// optional chaining
need("let a = freeOpt?.x;", "freeOpt");
need("let a = freeOptI?[freeKey];", "freeOptI");
need("let a = freeOptI?[freeKey];", "freeKey");

// null-coalescing
need("let a = freeL ?? freeR;", "freeL");
need("let a = freeL ?? freeR;", "freeR");

// if-expression (ternary)
need("let a = if freeCond { freeThen } else { freeElse };", "freeCond");
need("let a = if freeCond { freeThen } else { freeElse };", "freeThen");

// statements
need("throw freeThrow;", "freeThrow");
need("print freePrint;", "freePrint");
need("for i in freeIter { }", "freeIter");

// assign-to an index/member lvalue
need("someArr[someIdx] = freeAssignVal;", "freeAssignVal");
need("someArr[someIdx] = freeAssignVal;", "someArr");

// A locally-declared variable must NOT be flagged free (no false positives).
let fv = fvars("let local = 1; let b = local[0];");
if has(fv, "local") { fail("a declared local must not be reported as free"); }

print "selfhost_semantic_walk_pass";
