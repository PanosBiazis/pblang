let T = import("stdlib:target_artifact.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let ir = [["seti",0,7]];
let targets = [
    ["dos","2.0","x86","com"],
    ["cpm","2.2","z80","com"],
    ["linux","2.6","x86","elf"],
    ["linux","2.6","x86_64","elf"],
    ["linux","3.7","arm64","elf"],
    ["freebsd","12","x86_64","elf"],
    ["windows","5.2","x86_64","pe"],
    ["windows","5.1","x86","pe"],
    ["macos","10.6","x86_64","macho"]
];
let i = 0;
while i < len(targets) {
    let row = targets[i]; let p = T.plan(row[0], row[1], row[2]);
    if not p.ok { fail("expected plan for " + str(row) + ": " + p.error); }
    let a = T.build_ir(p, ir);
    eq(a.detected_format, row[3], "artifact format " + row[0]);
    if a.size < 4 or len(a.sha256) != 64 { fail("artifact integrity metadata " + row[0]); }
    i = i + 1;
}

let wasm_plan = T.plan("wasi", "1", "wasm32");
let wasm = T.build_source(wasm_plan, "print 7;");
eq(wasm.detected_format, "wasm", "WASM source backend");

let old_windows = T.plan("windows", "5.1", "x86_64");
if old_windows.ok or not str_contains(old_windows.error, "5.2") { fail("Windows x64 version floor"); }
let no_android = T.plan("android", "21", "arm64");
if no_android.ok or not str_contains(no_android.error, "no verified native") { fail("unsupported backend must fail closed"); }
if len(no_android.portable_fallbacks) != 1 or no_android.portable_fallbacks[0] != "c99-source" { fail("portable fallback"); }

let bad = false;
try { T.build_ir(wasm_plan, ir); } catch { bad = true; }
if not bad { fail("input-kind mismatch must be rejected"); }

if not T.emit_c99(ir).ok or not str_contains(T.emit_c99(ir).source, "int main") { fail("C99 fallback"); }

let coverage = T.coverage();
eq(coverage.native_backend_pairs, 10, "backend pair count");
if coverage.complete or len(coverage.missing_families) == 0 { fail("coverage must remain honest"); }

print "target_artifact_pass";
