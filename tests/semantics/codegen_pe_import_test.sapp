// tests/semantics/codegen_pe_import_test.sapp — a RUNNABLE Windows PE: the IR result is passed
// to kernel32!ExitProcess through a real PE import table. No wine here to execute it, so the
// import table is verified by objdump -x parsing it (DLL + symbol), plus byte structure. On
// Windows this exits with the computed value.

let C = import("stdlib/codegen_cross.sapp");

fn fail(m) { throw "FAIL " + m; }

let pe = C.build("windows", "x86_64", [["seti", 0, 0], ["seti", 1, 7], ["add", 0, 1]]);  // 7
let path = "pbpe_test.exe";
fs_write_bytes(path, pe);

// still a valid PE32+ at the byte level (headers unchanged)
if C.format_of(pe) != "pe" { fail("not a PE"); }
if pe[0x44] != 0x64 or pe[0x45] != 0x86 { fail("machine not x86-64"); }

// objdump parses the import table → kernel32.dll + ExitProcess
let r = proc_spawn_wait("bash", ["-c", "objdump -x " + path + " 2>/dev/null"]);
let out = try r.stdout catch "";
proc_spawn_wait("bash", ["-c", "rm -f " + path]);
if str_index_of(str_lower(out), "kernel32") < 0 { fail("import table missing kernel32 (<<" + str_slice(out, 0, 400) + ">>)"); }
if str_index_of(out, "ExitProcess") < 0 { fail("import table missing ExitProcess"); }

print "codegen_pe_import_pass";
