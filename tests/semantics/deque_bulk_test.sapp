let D=import("stdlib:deque.sapp");let Old=import("../../bench/fixtures/deque_before_bulk.sapp");
fn eq(a,b,label){assert(a==b,label);}
fn rejected(f){let value=try f() catch "rejected";eq(value,"rejected","bad batch rejected");}
let payload=map{v:3};let input=[nil,false,0,payload];let dq=D.from_array(input);
input[0]="changed";eq(D.to_array(dq),[nil,false,0,payload],"independent slots");
payload.v=4;eq(D.to_array(dq)[3].v,4,"shared payload");
D.extend_front(dq,["x","y"]);D.extend_back(dq,["z"]);
eq(D.to_array(dq),["x","y",nil,false,0,payload,"z"],"bulk order");
D.compact(dq);eq(dq.head,0,"compact head");eq(dq.tail,7,"compact tail");
eq(D.to_array(dq),["x","y",nil,false,0,payload,"z"],"compact values");
D.compact(dq);eq(D.size(dq),7,"repeat compact");
D.clear(dq);D.compact(dq);eq(D.size(dq),0,"compact empty");
let legacy=map{data:[1,2]};let alias=legacy.data;D.extend_front(legacy,alias);
eq(D.to_array(legacy),[1,2,1,2],"legacy migration and batch alias");
let bad=map{data:[1,2]};rejected(fn(){return D.extend_back(bad,"no");});eq(map_has(bad,"head"),false,"validate before legacy mutation");
let boundary=[];for i 65536 {push(boundary,i);}
let big=D.new();D.extend_back(big,boundary);eq(D.size(big),65536,"maximum batch accepted");eq(D.peek_back(big),65535,"last batch value");
push(boundary,7);let saved=D.to_array(big);
rejected(fn(){return D.extend_back(big,boundary);});rejected(fn(){return D.extend_front(big,boundary);});eq(D.to_array(big),saved,"oversize leaves deque unchanged");
for values in [nil,42,map{},"abc"] {rejected(fn(){return D.extend_front(big,values);});}

// Construct valid tiny sparse queues at the exact-index boundary.
fn near(head,values){let slots=map{};let i=0;while i<len(values){slots[str(head+i)]=values[i];i=i+1;}return map{data:slots,head:head,tail:head+len(values)};}
let high=near(9007199254740989,["a","b"]);D.push_back(high,"c");D.push_back(high,"d");
eq(D.to_array(high),["a","b","c","d"],"back precision boundary");
let low=near(-9007199254740991,["a","b"]);D.push_front(low,"c");D.push_front(low,"d");
eq(D.to_array(low),["d","c","a","b"],"front precision boundary");
let hb=near(9007199254740989,[1,2]);D.extend_back(hb,[3,4,5]);eq(D.to_array(hb),[1,2,3,4,5],"batch upper boundary");
let lb=near(-9007199254740990,[1,2]);D.extend_front(lb,[3,4,5]);eq(D.to_array(lb),[3,4,5,1,2],"batch lower boundary");
let oldhigh=near(9007199254740989,[1,2]);Old.push_back(oldhigh,3);Old.push_back(oldhigh,4);
eq(Old.size(oldhigh),3,"old fourth insertion lost from logical size");
let oldlow=near(-9007199254740991,[1,2]);Old.push_front(oldlow,3);let oldhead=oldlow.head;Old.push_front(oldlow,4);
eq(oldlow.head,oldhead,"old front index stopped advancing");

let zero=0;let inf=1/zero;let nan=zero*inf;
for index in [inf,nan,0.5,"0",9007199254740992] {
 let broken=map{data:map{},head:index,tail:index};rejected(fn(){return D.compact(broken);});
}
let reversed=map{data:map{},head:1,tail:0};rejected(fn(){return D.compact(reversed);});
let missing=map{data:map{"5":"kept"},head:5,tail:7};
rejected(fn(){return D.compact(missing);});eq(missing.head,5,"failed compact keeps head");eq(missing.tail,7,"failed compact keeps tail");eq(missing.data["5"],"kept","failed compact keeps old storage");
// Deterministic operation sequences checked against a plain-array model.
let checks=0;
for seed in [1,7,19,83] {
 let q=D.new();let model=[];let state=seed;
 for _step 500 {
  state=(state*37+11)%1009;let op=state%8;let v=state%17;
  if op==0 {D.push_back(q,v);push(model,v);}
  elif op==1 {D.push_front(q,v);let next=[v];for x in model {push(next,x);}model=next;}
  elif op==2 {let expected=nil;if len(model)>0 {expected=model[0];let next=[];let j=1;while j<len(model){push(next,model[j]);j=j+1;}model=next;}eq(D.pop_front(q),expected,"model front pop");}
  elif op==3 {let expected=nil;if len(model)>0 {expected=array_pop(model);}eq(D.pop_back(q),expected,"model back pop");}
  elif op==4 {D.extend_back(q,[v,nil]);push(model,v);push(model,nil);}
  elif op==5 {D.extend_front(q,[v,nil]);let next=[v,nil];for x in model {push(next,x);}model=next;}
  elif op==6 {D.compact(q);}
  else {D.extend_back(q,[]);D.extend_front(q,[]);}
  eq(D.to_array(q),model,"model sequence order");eq(D.size(q),len(model),"model size");checks=checks+1;
 }
}
print "deque_bulk_pass checks="+str(checks);
