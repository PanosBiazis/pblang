// tests/semantics/parallel_enrich_test.sapp — enrichment for stdlib/parallel.sapp
// Adds par_max/par_min (numeric reductions), par_some/par_every (parallel
// quantifiers), par_flat_map.

let p = import("stdlib/parallel.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn arr_eq(a, b, m) {
    if len(a) != len(b) { fail(m + " len"); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " @" + str(i)); } i = i + 1; }
}

// ── base still works ─────────────────────────────────────────────────────────────
arr_eq(p.par_map([1, 2, 3, 4], fn(x) { return x * x; }), [1, 4, 9, 16], "par_map");
eq(p.par_sum([1, 2, 3, 4, 5]), 15, "par_sum");

// ── ENRICH: par_max / par_min ────────────────────────────────────────────────────
eq(p.par_max([3, 1, 4, 1, 5, 9, 2, 6]), 9, "par_max");
eq(p.par_min([3, 1, 4, 1, 5, 9, 2, 6]), 1, "par_min");
eq(p.par_max([]), nil, "par_max empty -> nil");

// ── ENRICH: par_some / par_every ─────────────────────────────────────────────────
eq(p.par_some([1, 2, 3], fn(x) { return x > 2; }), true, "par_some true");
eq(p.par_some([1, 2, 3], fn(x) { return x > 9; }), false, "par_some false");
eq(p.par_every([2, 4, 6], fn(x) { return x % 2 == 0; }), true, "par_every true");
eq(p.par_every([2, 3, 4], fn(x) { return x % 2 == 0; }), false, "par_every false");

// ── ENRICH: par_flat_map ─────────────────────────────────────────────────────────
arr_eq(p.par_flat_map([1, 2, 3], fn(x) { return [x, x * 10]; }), [1, 10, 2, 20, 3, 30], "par_flat_map");

print "parallel_enrich_pass";
