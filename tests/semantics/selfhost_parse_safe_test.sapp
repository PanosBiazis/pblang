let F = import("stdlib/compiler/selfhost_frontend.sapp");

let ok = F.frontend_parse_safe("let x = 1; print x;");
assert(ok.format == "pblang.frontend.parse_safe.v1", "parse_safe format is versioned");
assert(ok.ok and ok.reason == "parsed", "parse_safe accepts simple pblang");
assert(ok.tokens_count > 0, "parse_safe reports tokens");

let empty = F.frontend_parse_safe("");
assert(not empty.ok and empty.reason == "empty_source", "parse_safe handles empty source without throwing");
assert(len(empty.errors) > 0, "parse_safe returns empty-source diagnostics");

let bad = F.frontend_parse_safe("fn bad( {");
assert(bad.format == "pblang.frontend.parse_safe.v1", "parse_safe bad-source format is versioned");
assert(not bad.ok, "parse_safe rejects broken source without throwing");
assert(len(bad.errors) > 0, "parse_safe returns diagnostics for parser failure");

print "selfhost_parse_safe_pass";
