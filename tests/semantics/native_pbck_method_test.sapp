// Execute PBLang-compiled method calls on the retained VM, not only an emulator.
if platform() != "linux" { print "native_pbck_method_skip_linux_required"; os_exit(0); }
let FE=import("stdlib:compiler/selfhost_frontend.sapp");
let XL=import("stdlib:selfhost_to_pbck.sapp");
let SH=import("stdlib:selfhost_pbck.sapp");
let NATIVE=import("stdlib:compiler/native_pbck.sapp");
let UUID=import("stdlib:uuid.sapp");
let compiler=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let output=path_join(cwd(),".pblang_method_"+UUID.v4()+".pbck");
fn run(bytes, expected) {
    fs_write_bytes(output,bytes);
    let result=proc_spawn_wait("/usr/bin/timeout",["-k","1s","15s",compiler,"run",output,"--allow-all"]);
    fs_remove(output);
    assert(result.exit_code==0 and result.stdout==expected,"native method output: "+result.stdout+result.stderr);
}
fn check(source, expected) {
    let compiled=FE.frontend_compile(source);
    assert(compiled.ok,"method fixture compiles");
    run(NATIVE.compile_source(source),expected);
    run(XL.translate_optimized(compiled.chunk),expected);
    run(XL.translate(SH.deserialize_chunk(SH.serialize_chunk(compiled.chunk))),expected);
}
fn exercise() {
    check("for i 2 {let p=map{run:fn(self){return 7;}};print (try p:run() catch 9);"
        +"print (try {p:run()} catch 9);print (try {p.run(p)} catch 9);}","7\n7\n7\n7\n7\n7\n");
    check("fn outer(n){for i 2 {let p=map{value:n+i,run:fn(self){return self.value;}};"
        +"print (try {try {p:run()} catch 8} catch 9);}}outer(10);","10\n11\n");
    check("let calls=0;fn make(){calls=calls+1;return map{value:calls,run:fn(self,x){return self.value+x;}};}"
        +"print make():run(10);print calls;","11\n1\n");
    check("let calls=0;let C=map{run:fn(self,x){return self.value+x;}};"
        +"fn make(){calls=calls+1;return map{value:calls,__class:C};}print make():run(10);print calls;","11\n1\n");
    check("fn join(a,b){return a+b;}let p=map{run:fn(self){return 7;}};print join(40,p:run());","47\n");
    check("let p=map{__class:nil,run:fn(self){return 7;}};print p:run();","7\n");
    check("let p=map{__class:false,run:fn(self){return 7;}};print (try p:run() catch 9);","9\n");
    check("let order=[];let p=map{run:fn(self,a,b){array_push(order,4);return a+b;}};"
        +"fn index(){array_push(order,1);return 0;}fn arg(n){array_push(order,n);return n;}"
        +"print [p][index()]:run(arg(2),arg(3));print order;","5\n[1, 2, 3, 4]\n");
    check("let calls=0;fn arg(){calls=calls+1;return 1;}let p=map{};"
        +"print (try p:missing(arg()) catch 9);print calls;","9\n0\n");
    check("let calls=0;fn make(){calls=calls+1;throw 7;}print (try make():run() catch 9);print calls;","9\n1\n");
    check("let p=map{run:fn(self){throw 7;}};for i 10 {print (try p:run() catch 9);}print 42;",str_repeat("9\n",10)+"42\n");
    check("let T=import(\"stdlib:thread.sapp\");for i 3 {let p=T.pipeline([map{process:fn(x){return x+1;}}]);"
        +"print (try {p:run([6])} catch [9]);}","[7]\n[7]\n[7]\n");
    for invalid in ["", " ", "let n:number=nil-1;", "print missing_name;", "print 7; /* private_canary", "print 1e;",
        str_repeat(" ",1048577)+"print 1;"] {
        assert((try {NATIVE.compile_source(invalid);false} catch true),"invalid source refused before emission");
    }
}
let passed=try {exercise();true} catch false;
try fs_remove(output) catch nil;
assert(passed,"native PBCK method regression");
print "native_pbck_method_pass";
