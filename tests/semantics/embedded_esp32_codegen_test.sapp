let Targets = import("stdlib:embedded_targets.sapp");
let IR = import("stdlib:embedded_ir.sapp");
let ESP = import("stdlib:codegen_esp32_embedded.sapp");

let board = Targets.board("esp32-devkitc-v4");
let lowered = IR.lower(IR.blink("status-led-test", 500), board);
let artifact = ESP.compile(lowered);
assert(artifact.ok and artifact.ram_only and not artifact.persistent_flash_ready,
       "ESP32 artifact remains RAM-only until hardware validation");
assert(artifact.backend == "native-xtensa-lx6-experimental"
       and artifact.native_source_language == "pblang",
       "PBLang-native Xtensa validation backend");
assert(not artifact.assembler_dependency and not artifact.compiler_dependency
       and not artifact.c_fallback, "no source fallback or compiler dependency");
assert(artifact.bytes == 117 and artifact.image_bytes == 160,
       "compact deterministic ESP32 image");

let parsed = ESP.parse_image(artifact.image);
assert(parsed.ok and parsed.entry_address == ESP.ENTRY_ADDRESS
       and parsed.load_address == ESP.IRAM_ADDRESS and parsed.segment == artifact.binary,
       "strict ESP image roundtrip");

let corrupt = [];
for i len(artifact.image) { array_push(corrupt, artifact.image[i]); }
corrupt[len(corrupt) - 1] = bit_xor(corrupt[len(corrupt) - 1], 1);
let rejected = false;
try { ESP.parse_image(corrupt); } catch { rejected = true; }
assert(rejected, "corrupt ESP image rejected");

let wrong_delay = IR.lower(IR.blink("status-led-test", 250), board);
rejected = false;
try { ESP.compile(wrong_delay); } catch { rejected = true; }
assert(rejected, "unsupported timing fails closed");

print "embedded_esp32_codegen_pass";
