// tests/semantics/stdlib_warning_sweep_test.sapp — behavior locked while
// driving stdlib `pblang check` warnings to zero:
//
//   - assert.throws ran the probed fn TWICE (a dead `let err = try f()...`
//     line before the real sentinel) — side-effecting probes fired twice.
//   - compiler/optimizer grew opcode_name(op) so its full opcode table is a
//     real debugging surface instead of dead constants.
//   - compiler/codegen disasm named ops via a 31-entry array — any chunk with
//     MOD/PEEK opcodes (31..34) CRASHED disasm; op_display covers them all
//     with a safe fallback.
//   - polyglot_build.build_sql validated SQL against sqlite3 then IGNORED the
//     result and returned ok:true always; sql_result_ok is the honest check.
//   - config.require_bool still throws for a missing key (its `let v =` was
//     only there for the throw side effect).

let A = import("stdlib:assert.sapp");
let OPT = import("stdlib/compiler/optimizer.sapp");
let CG = import("stdlib/compiler/codegen.sapp");
let PB = import("stdlib:polyglot_build.sapp");
let C = import("stdlib:config.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }

// ── assert.throws calls the fn exactly once ──────────────────────────────────
let n = atomic_new(0);
fn probe_side_effect() { atomic_add(n, 1); throw "boom"; }
A.throws(probe_side_effect, "raising fn satisfies throws()");
eq(atomic_get(n), 1, "assert.throws must run the probed fn exactly once");

// ── optimizer opcode names ───────────────────────────────────────────────────
eq(OPT.opcode_name(18), "OpCall", "opcode_name knows OpCall");
eq(OPT.opcode_name(34), "OpJumpIfTruePeek", "opcode_name covers the peek jumps");
eq(OPT.opcode_name(999), "Op?999", "unknown opcodes degrade gracefully");

// ── codegen op_display covers every emitted opcode ───────────────────────────
eq(CG.op_display(22), "OpJumpIfTrue", "op_display knows OpJumpIfTrue");
eq(CG.op_display(34), "OpJumpIfTruePeek", "op_display covers ops the old array crashed on");
eq(CG.op_display(99), "Op?99", "unknown opcodes degrade gracefully");

// ── polyglot_build sql validation honesty ────────────────────────────────────
eq(PB.sql_result_ok(map{ exit_code: 0, stdout: "", stderr: "" }), true, "clean sqlite run is ok");
eq(PB.sql_result_ok(map{ exit_code: 1, stdout: "", stderr: "syntax error" }), false, "sqlite failure is NOT ok");
eq(PB.sql_result_ok(map{ exit_code: 0 - 1, stdout: "", stderr: "sqlite3 not found" }), true,
   "missing sqlite3 skips validation (still ok, tool absence is not a code error)");

// ── config.require_bool keeps its missing-key throw ──────────────────────────
let cfg = C.new();
C.set(cfg, "flag", "true");
eq(C.require_bool(cfg, "flag"), true, "present bool parses");
let rb = try map{ ok: true, value: C.require_bool(cfg, "absent") } catch map{ ok: false, value: nil };
eq(rb.ok, false, "missing required key still throws");

print "stdlib_warning_sweep_pass";
