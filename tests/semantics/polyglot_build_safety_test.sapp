let PB = import("stdlib:polyglot_build.sapp");

fn expect(value, message) {
    if not value { throw "FAIL polyglot build safety: " + message; }
}

let valid = PB.validate_build_request("block_12", "print(1)", "build/polyglot output");
expect(valid.ok and not valid.shell_evaluated,
    "valid requests must retain literal argv execution");

for name in ["../escape", "bad-name", "x;touch", "x$(id)", "", "9starts_with_digit"] {
    expect(not PB.validate_build_request(name, "source", "build").ok,
        "unsafe block name must fail closed: " + name);
}

expect(not PB.validate_build_request("safe", "source", "bad\npath").ok,
    "control characters in output paths must fail closed");

let process = PB.process_status();
expect(not process.raw_fallback,
    "polyglot compilation must never silently use the raw blocking process path");

let legacy_load = PB.load_artifact("/tmp/pblang-untrusted-artifact.so");
expect(not legacy_load.ok and not legacy_load.executed and legacy_load.policy_required,
    "artifact loading without an exact policy must fail closed");

let blocks = PB.extract_blocks("@c {\nint main(void) { return 0; }\n}\n@python {\nprint('ok')\n}\n");
expect(len(blocks) == 2 and blocks[0].language == "c"
       and blocks[1].language == "python",
    "bounded extraction must preserve multiple blocks and nested braces");

let malformed = try PB.extract_blocks("@c {\nint main(void) {\n") catch nil;
expect(malformed == nil, "unterminated blocks must fail closed");

let qsharp = PB.build_qsharp("bounded_qsharp", "Message(\"not executed\");", "/tmp");
expect(qsharp.ok and not qsharp.build_ok and qsharp.status == "fallback"
       and qsharp.artifact_kind == "source" and not qsharp.compiled
       and not qsharp.executed,
    "source-only fallback must never claim compilation or execution");
try fs_remove(qsharp.artifact) catch nil;
let qsharp_session = path_dirname(qsharp.artifact);
try fs_remove(qsharp_session + "/.session") catch nil;
try fs_remove(qsharp_session) catch nil;

let sql_marker = "/tmp/pblang-polyglot-sql-side-effect";
try fs_remove(sql_marker) catch nil;
let sql = PB.build_sql("bounded_sql",
    "ATTACH DATABASE '" + sql_marker + "' AS p; CREATE TABLE p.injected(value TEXT);", "/tmp");
expect(sql.ok and not sql.build_ok and sql.status == "fallback"
       and not sql.compiled and not sql.executed and not fs_exists(sql_marker),
    "SQL build must publish source without evaluating filesystem-affecting statements");
try fs_remove(sql.artifact) catch nil;

let aggregate_root = "/tmp/pblang-polyglot-aggregate-" + str(now_ms());
fs_mkdirs(aggregate_root);
let aggregate_source = aggregate_root + "/main.sapp";
fs_write(aggregate_source, "@sql {\nSELECT 1;\n}\n");
let aggregate = PB.build_file(aggregate_source);
expect(aggregate.ok and not aggregate.complete and aggregate.fallbacks == 1
       and aggregate.failed == 0,
    "aggregate report must expose source-only unvalidated artifacts");
try fs_remove(aggregate.artifacts[0].artifact) catch nil;
let aggregate_session = path_dirname(aggregate.artifacts[0].artifact);
try fs_remove(aggregate_session + "/.session") catch nil;
try fs_remove(aggregate_session) catch nil;
try fs_remove(aggregate.output_dir) catch nil;
try fs_remove(aggregate_root + "/.pblang_polyglot") catch nil;
try fs_remove(aggregate_source) catch nil;
try fs_remove(aggregate_root) catch nil;

// A project-controlled symlink must not redirect the private output root.
if platform() == "linux" and fs_exists("/usr/bin/ln") {
    let link_root = "/tmp/pblang-polyglot-link-" + str(now_ms());
    let escape_root = "/tmp/pblang-polyglot-escape-" + str(now_ms());
    fs_mkdirs(link_root); fs_mkdirs(escape_root);
    let linked_source = link_root + "/main.sapp";
    fs_write(linked_source, "@sql {\nSELECT 1;\n}\n");
    let linked = proc_spawn_wait("/usr/bin/ln", ["-s", escape_root, link_root + "/.pblang_polyglot"]);
    expect(linked.exit_code == 0, "symlink fixture must be created");
    let redirected = try PB.build_file(linked_source) catch nil;
    expect(redirected == nil, "symlinked output root must fail closed");
    expect(len(fs_listdir(escape_root)) == 0,
        "rejected output root must not publish outside the source directory");
    try fs_remove(link_root + "/.pblang_polyglot") catch nil;
    try fs_remove(linked_source) catch nil;
    try fs_remove(link_root) catch nil;
    try fs_remove(escape_root) catch nil;
}

if process.available {
    let c_out = "/tmp/pblang-polyglot-bounded-build-" + str(now_ms());
    fs_mkdirs(c_out);
    let planted_target = c_out + "/outside-target";
    fs_write(planted_target, "unchanged");
    if platform() == "linux" and fs_exists("/usr/bin/ln") {
        let planted = proc_spawn_wait("/usr/bin/ln",
            ["-s", planted_target, c_out + "/libbounded.so"]);
        expect(planted.exit_code == 0, "direct-builder symlink fixture must be created");
    }
    let c = PB.build_c("bounded", "int pblang_bounded(void) { return 7; }", c_out);
    expect(try c.ok catch false, "representative C build must complete through the bounded process facade: "
        + (try c.error catch "unknown build error"));
    expect(c.artifact != c_out + "/libbounded.so" and fs_read(planted_target) == "unchanged",
        "direct builder must isolate output from a planted caller-directory symlink");
    try fs_remove(c.artifact) catch nil;
    let c_session = path_dirname(c.artifact);
    try fs_remove(c_session + "/bounded.c") catch nil;
    try fs_remove(c_session + "/.session") catch nil;
    try fs_remove(c_session) catch nil;
    try fs_remove(c_out + "/libbounded.so") catch nil;
    try fs_remove(planted_target) catch nil;
    try fs_remove(c_out) catch nil;
}

print "polyglot_build_safety_pass";
