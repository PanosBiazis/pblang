// Invoked by tooling/secure_file_exclusive_close_check.py with private copies
// of the complete facade and a counted, resource-free backend model.
fn run(S, B, baseline = false) {
    let count = 0;
    for api in ["bytes", "text"] {
        for success in [true, false] {
            for closed in [true, false, nil, 1] {
                B.configure(success, closed);
                let result = nil;
                if api == "bytes" {
                    result = S.write_new_exclusive("owned/value", [206, 177], false, false);
                } else { result = S.write_text_new_exclusive("owned/value", "α", false, false); }
                assert(B.state.writes == 1 and B.state.closes == 1, "one write and close");
                assert(B.state.bytes == [206, 177] and not B.state.create, "exact payload and backend options");
                assert(B.state.result.ok == success, "backend map is not mutated");
                let confirmed = type(closed) == "bool" and closed;
                if baseline or confirmed {
                    assert(result == B.state.result, "unchanged return on confirmed close");
                } else {
                    assert(not result.ok and result.cleanup_uncertain
                        and not result.parent_close_confirmed, "unconfirmed cleanup cannot succeed");
                    for key in map_keys(B.state.result) {
                        if key != "ok" and (not success or key != "error") {
                            assert(result[key] == B.state.result[key], "original metadata retained");
                        }
                    }
                    if success {
                        assert(result.write_backend_succeeded and result.publication_may_have_occurred,
                            "written output may remain despite cleanup failure");
                    } else {
                        assert(result.error == "αρχικό σφάλμα" and not map_has(result, "write_backend_succeeded"),
                            "primary error retained without invented completion");
                    }
                }
                count = count + 1;
            }
        }
    }
    B.configure(false, false);
    B.state.object_error = true;
    let error_result = S.write_new_exclusive("owned/value", [], false, false);
    assert(error_result.error == map{kind:"synthetic",code:7}, "error values are not stringified");
    assert(B.state.writes == 1 and B.state.closes == 1, "object error close counted");
    B.configure(true, true);
    assert(not S.write_new_exclusive("owned/value", "not bytes", false).ok, "reject invalid bytes");
    assert(not S.write_text_new_exclusive("owned/value", [], false).ok, "reject invalid text");
    assert(not S.write_new_exclusive("", [], false).ok, "reject empty path");
    assert(B.state.opens == 0 and B.state.writes == 0 and B.state.closes == 0,
        "argument rejection has no backend effects");
    B.configure(true, true);
    B.state.admit = false;
    assert(not S.write_new_exclusive("owned/value", [], false).ok, "parent admission rejection");
    assert(B.state.opens == 1 and B.state.writes == 0 and B.state.closes == 0,
        "failed admission never writes or closes an unowned parent");
    return map{ok:true,matrix_cases:count,additional_cases:5};
}
export run;
