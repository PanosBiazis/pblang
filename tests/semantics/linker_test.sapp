let linker = import("stdlib/linker.sapp");

let main_obj = linker.object(
    "main.o",
    [linker.section(".text", [1, 2, 3, 4], ["alloc", "exec"], 16)],
    [linker.symbol("_start", ".text", 0, true)],
    [linker.relocation(".text", 2, "helper", "abs64", 0)]
);

let helper_obj = linker.object(
    "helper.o",
    [linker.section(".text", [9, 9], ["alloc", "exec"], 16)],
    [linker.symbol("helper", ".text", 0, true)],
    []
);

let image = linker.link([main_obj, helper_obj], map{base: 4096, entry: "_start", target: "portable"});
assert(image.ok == true, "valid objects link");
assert(image.symbols["_start"].address == 4096, "entry symbol placed at image base");
assert(image.symbols.helper.address == 4112, "helper object is aligned after main text");
assert(len(image.relocations) == 1, "relocation collected");

let manifest = linker.emit_manifest(image);
assert(str_contains(manifest, "format=pbai.linker.image.v1"), "manifest has format");
assert(str_contains(manifest, "helper addr=4112"), "manifest includes sorted symbol");

let bad = linker.link([main_obj], map{base: 4096});
assert(bad.ok == false, "undefined relocation fails link");
assert(str_contains(bad.diagnostics[0], "undefined symbol"), "undefined diagnostic is clear");

print "linker_pass";
