// tests/semantics/nn_graph_train_test.sapp — Hebbian self-wiring + developmental graph:
// bonds that fire together strengthen together; the graph BIRTHS a node when it stays
// curious and KILLS idle nodes (with a floor so it can't erase itself).

let G = import("stdlib/nn_graph.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── Hebbian: a bond between co-active nodes gets stronger ──────────────────────────
let g = G.graph_new();
G.add_node(g, 0, "linear");            // 0 input
G.add_node(g, 0, "linear");            // 1
G.add_bond(g, 0, 1, 0.5);
let s0 = G.bond_strength(g, 0, 1);
G.hebbian_step(g, [1], 1, 0.2);        // both nodes positive -> strengthen
if G.bond_strength(g, 0, 1) <= s0 { fail("hebbian strengthens co-active bonds"); }

// graph_curiosity is non-negative
if G.graph_curiosity(g, [1], 1) < 0 { fail("curiosity non-negative"); }

// ── BIRTH-when-curious: low threshold -> grows every epoch ─────────────────────────
let b = G.graph_new();
G.add_node(b, 0, "linear");
G.add_node(b, 0, "tanh");
G.add_bond(b, 0, 1, 0.5);
let before = G.node_count(b);
let r = G.graph_train(b, [[1]], map{ epochs: 3, steps: 2, rate: 0.05, birth_threshold: 0 });
if r.births < 1 { fail("graph_train births when curious"); }
if G.node_count(b) <= before { fail("birth grows the graph"); }

// ── KILL-when-idle keeps a floor (never erases the input + at least one node) ──────
let k = G.graph_new();
G.add_node(k, 0, "linear");            // input 0
G.add_node(k, 0, "tanh");             // 1
G.add_node(k, 0, "tanh");             // 2
G.add_bond(k, 0, 1, 0.3);
let rk = G.graph_train(k, [[1]], map{ epochs: 4, steps: 2, rate: 0.01, kill_threshold: 1000 });
if rk.kills < 0 { fail("kills reported"); }
if G.node_count(k) < 2 { fail("kill keeps a floor (input + >=1 node)"); }

print "nn_graph_train_pass";
