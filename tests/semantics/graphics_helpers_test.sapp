// tests/semantics/graphics_helpers_test.sapp
let gfx = import("stdlib:graphics.sapp");

let p0 = gfx.bezier_point(0, 0, 10, 0, 10, 10, 20, 10, 0);
assert(p0[0] == 0 and p0[1] == 0, "bezier t=0 starts at first point");

let p1 = gfx.bezier_point(0, 0, 10, 0, 10, 10, 20, 10, 1);
assert(p1[0] == 20 and p1[1] == 10, "bezier t=1 ends at last point");

let mid = gfx.bezier_point(0, 0, 10, 0, 10, 10, 20, 10, 0.5);
assert(mid[0] == 10 and mid[1] == 5, "bezier midpoint should follow cubic curve");

let pts = gfx.bezier_points(0, 0, 10, 0, 10, 10, 20, 10, 4);
assert(len(pts) == 5, "bezier_points includes both endpoints");
assert(pts[0][0] == 0 and pts[4][0] == 20, "bezier_points endpoints preserved");

let one = gfx.bezier_points(0, 0, 1, 0, 1, 1, 2, 1, 0);
assert(len(one) == 2, "segment count is clamped to at least one");

let many = gfx.bezier_points(0, 0, 1, 0, 1, 1, 2, 1, 999);
assert(len(many) == 513, "segment count is capped");

let c = gfx.lerpColor(gfx.RED, gfx.BLUE, 0.5);
assert(c[0] == 127.5 and c[1] == 0 and c[2] == 127.5, "lerpColor still works");

let txt = type(gfx.draw_text);
assert(txt == "closure" or txt == "fn" or txt == "builtin", "draw_text is exported as callable");
let rects = type(gfx.draw_rects);
assert(rects == "closure" or rects == "fn" or rects == "builtin", "draw_rects batch wrapper is exported as callable");
assert(type(gfxdrawrects) == "builtin", "gfxdrawrects VM batch primitive is registered");
let graphics_src = fs_read("stdlib/graphics.sapp");
assert(str_contains(graphics_src, "PBLANG_GRAPHICS_MAX_MS"), "graphics.run exposes a max runtime guard for child GUI apps");
assert(str_contains(graphics_src, "PBLANG_GRAPHICS_MAX_FRAMES"), "graphics.run exposes a max frame guard for child GUI apps");
assert(str_contains(graphics_src, "if updateResult == false { shouldDraw = false; }"), "graphics.run lets idle apps skip draw/present before heavy rendering");
let font_candidates = gfx.text_font_candidates();
assert(len(font_candidates) >= 8, "graphics exposes a portable UI font candidate stack");
assert(str_contains(str_join(font_candidates, "\n"), "Noto") or str_contains(str_join(font_candidates, "\n"), "Segoe"), "font stack prefers readable UI fonts");
assert(not str_contains(str(font_candidates[0]), "Mono"), "font stack starts with a standard UI Sans family, not a mono fallback");
let font_path_text = str(gfx.text_font_path());
assert(font_path_text == "" or len(font_path_text) > 0, "graphics exposes resolved text font path");
let tp = gfx.text_profile();
assert((try tp.font_cache_size catch 0) >= 0 and (try tp.font_cache_hits catch 0) >= 0 and (try tp.font_cache_loads catch 0) >= 0, "text profile exposes native font cache stats");
assert((try tp.glyph_cache_size catch 0) >= 0 and (try tp.glyph_cache_hits catch 0) >= 0 and (try tp.glyph_cache_loads catch 0) >= 0, "text profile exposes native glyph cache stats");
let text_plan = gfx.text_render_plan(tp, map{ avg_draw_ms: 40, text_calls: 240, shape_cache: 12 }, map{ mode: "auto", target_fps: 60 });
assert(text_plan.format == "pblang.graphics.text_render_plan.v1", "text render plan has stable format");
assert(text_plan.decision == "bitmap-hot-path" or text_plan.decision == "bitmap-fallback" or text_plan.decision == "native-aa", "text render plan chooses a supported decision");
assert((try text_plan.font_cache_size catch 0) >= 0 and (try text_plan.font_cache_hits catch 0) >= 0 and (try text_plan.font_cache_loads catch 0) >= 0, "text render plan carries font cache stats");
assert((try text_plan.glyph_cache_size catch 0) >= 0 and (try text_plan.glyph_cache_hits catch 0) >= 0 and (try text_plan.glyph_cache_loads catch 0) >= 0, "text render plan carries glyph cache stats");
let bitmap_plan = gfx.text_render_plan(gfx.text_profile(), map{ avg_draw_ms: 1, text_calls: 4 }, map{ mode: "bitmap", target_fps: 60 });
assert(bitmap_plan.decision == "bitmap-forced" and bitmap_plan.safe_fallback == "bitmap-font", "text render plan honors forced bitmap fallback");
let text_status = gfx.text_render_status(text_plan);
assert(str_contains(text_status, "text ") and str_contains(text_status, "budget=") and str_contains(text_status, "calls=") and str_contains(text_status, "font-cache=") and str_contains(text_status, "glyph-cache="), "text render status is readable");

let bp = gfx.backend_profile();
assert(bp.format == "pblang.graphics.backend.profile.v1", "backend profile exposes stable format");
assert(bp.backend == "minifb" or bp.backend == "sdl2", "backend profile names known graphics backend");
assert(bp.cpu_raster_ui == true and bp.idle_present_skip == true, "backend profile states PBIDE raster/present behavior");
assert(str(try bp.present_copy catch "") != "", "backend profile reports present copy strategy");
assert((try bp.present_resize_sync catch false) == true, "CPU framebuffer present synchronizes live resize before blitting");
assert((try bp.max_framebuffer_dim catch 0) >= 8192, "backend profile reports a bounded framebuffer dimension guard");
assert(str(try bp.event_pump catch "") != "", "backend profile reports event pump strategy");
assert(str(try bp.rect_fill catch "") != "", "backend profile reports rect fill strategy");
assert(type(try bp.compiled_sdl2 catch false) == "bool", "backend profile reports whether SDL2 was compiled in");
assert(bp.event_contract == "pblang.graphics.events.v1", "backend profile exposes stable input event contract");
assert(bp.resize_events == true and bp.mouse_xy_events == true and bp.scroll_events == true, "backend profile reports resize/mouse/scroll event support");
assert(bp.scroll_event == "scroll", "backend profile names the wheel event type");
let bs = gfx.backend_status();
assert(str_contains(bs, "gfx ") and (str_contains(bs, "cpu") or str_contains(bs, "gpu-present")), "backend status summarizes renderer path");
let bes = gfx.backend_event_status();
assert(str_contains(bes, "pblang.graphics.events.v1") and str_contains(bes, "scroll") and str_contains(bes, "pump="), "backend event status summarizes input contract");
let rp = gfx.render_route_plan(bp);
assert(rp.format == "pblang.graphics.render_route.v1", "render route plan has stable format");
assert(rp.route == "cpu-framebuffer" or rp.route == "cpu-raster-gpu-present" or rp.route == "software-forced", "render route names supported device path");
assert(rp.device == "cpu" or rp.device == "cpu+gpu-present", "render route names effective device class");
assert(str(try rp.present_copy catch "") != "", "render route carries present copy strategy");
let rs = gfx.render_route_status(bp);
assert(str_contains(rs, "route ") and str_contains(rs, "device ") and str_contains(rs, "present ") and str_contains(rs, "copy "), "render route status is human-readable");
let cpu_rs = gfx.cpu_render_status(bp);
assert(str_contains(cpu_rs, "cpu-render") and str_contains(cpu_rs, "rect-fill=") and str_contains(cpu_rs, "route="), "CPU render status exposes framebuffer health");
let ap = gfx.render_acceleration_plan(bp);
assert(ap.format == "pblang.graphics.acceleration.plan.v1", "graphics acceleration plan has stable format");
assert(ap.cpu_raster_ui == true and ap.idle_present_skip == true, "graphics acceleration plan exposes current raster/present boundary");
assert(str_contains(ap.parallel_safe_path, "background") and str_contains(ap.polyglot_safe_path, "native graphics"), "graphics acceleration plan names safe parallel/polyglot paths");
assert(str(try ap.rect_fill catch "") != "", "graphics acceleration plan carries rect fill strategy");
assert(len(ap.steps) >= 4, "graphics acceleration plan includes actionable optimization steps");
let dp_cpu = gfx.render_device_policy(map{ format: "pblang.graphics.backend.profile.v1", backend: "minifb", present: "cpu-framebuffer", gpu_present: false, cpu_raster_ui: true, idle_present_skip: true }, map{ target_fps: 60 });
assert(dp_cpu.format == "pblang.graphics.render_device_policy.v1", "render device policy has stable format");
assert(dp_cpu.status == "gpu-present-recommended" and dp_cpu.gpu_raster_ui == false and dp_cpu.cpu_raster_ui == true, "render device policy recommends GPU-present without claiming GPU UI rasterization");
assert((try dp_cpu.env["PBLANG_GFX"] catch "") == "sdl2" and (try dp_cpu.env["PBLANG_GFX_SOFTWARE"] catch "") == "0", "render device policy exposes safe restart env for GPU-present");
let dp_gpu = gfx.render_device_policy(map{ format: "pblang.graphics.backend.profile.v1", backend: "sdl2", present: "gpu-assisted-texture-present", gpu_present: true, cpu_raster_ui: true, idle_present_skip: true }, map{ target_fps: 60, pressure: "critical" });
assert(dp_gpu.status == "gpu-present-active" and dp_gpu.recommended_fps == 30 and dp_gpu.safe == true and dp_gpu.backward_compatible == true, "render device policy keeps active GPU-present path and lowers pressure");
let dp_soft = gfx.render_device_policy(map{ format: "pblang.graphics.backend.profile.v1", backend: "minifb", present: "cpu-framebuffer", gpu_present: false, cpu_raster_ui: true, idle_present_skip: true, software_forced: true }, nil);
assert(dp_soft.status == "software-forced" and (try dp_soft.env["PBLANG_GFX_SOFTWARE"] catch "") == "0", "render device policy detects forced software mode");
let dp_status = gfx.render_device_policy_status(dp_gpu);
assert(str_contains(dp_status, "device-policy") and str_contains(dp_status, "ui-raster=cpu") and str_contains(dp_status, "launch="), "render device policy status is readable and honest");
let startup_fast = gfx.render_startup_profile("fast", map{ format: "pblang.graphics.backend.profile.v1", backend: "minifb", present: "cpu-framebuffer", gpu_present: false, compiled_sdl2: false, cpu_raster_ui: true, idle_present_skip: true }, map{ target_fps: 60 });
assert(startup_fast.format == "pblang.graphics.render_startup_profile.v1" and startup_fast.mode == "fast", "render startup profile has stable fast mode");
assert((try startup_fast.env["PBLANG_GFX"] catch "") == "sdl2" and (try startup_fast.env["PBIDE_GPU_BUILD"] catch "") == "1", "fast startup profile prefers SDL2 GPU-present build/run env");
assert(startup_fast.can_attempt_gpu_build == true and startup_fast.prefer_gpu_present == true, "fast startup profile can attempt GPU-present build when SDL2 is not compiled");
let startup_cpu = gfx.render_startup_profile("cpu", dp_cpu, nil);
assert(startup_cpu.mode == "cpu" and (try startup_cpu.env["PBLANG_GFX"] catch "") == "minifb" and startup_cpu.prefer_gpu_present == false, "cpu startup profile keeps portable framebuffer route");
let startup_retro = gfx.render_startup_profile("retro", dp_cpu, nil);
assert(startup_retro.mode == "retro" and (try startup_retro.env["PBIDE_TEXT_RENDER"] catch "") == "bitmap" and (try startup_retro.env["PBIDE_WINDOW_PROBE"] catch "") == "0", "retro startup profile forces low-cost diagnostic settings");
let startup_lines = gfx.render_startup_env_lines(startup_fast);
assert(str_contains(str_join(startup_lines, " "), "PBIDE_RENDER_PROFILE=fast") and str_contains(str_join(startup_lines, " "), "PBLANG_GFX=sdl2"), "startup env lines are deterministic and readable");
let startup_status = gfx.render_startup_profile_status(startup_fast);
assert(str_contains(startup_status, "startup fast") and str_contains(startup_status, "env=["), "startup profile status is readable");

let dirty = gfx.dirty_region_plan(map{ w: 1280, h: 720 }, [map{ x: 10, y: 10, w: 120, h: 80 }], 64, 100);
assert(dirty.format == "pblang.graphics.dirty_region_plan.v1", "dirty region plan has stable format");
assert(dirty.mode == "partial" and dirty.tile_count > 0 and dirty.coverage_percent < 70, "small dirty region stays partial");
let full_dirty = gfx.dirty_region_plan(map{ w: 320, h: 200 }, [map{ x: 0, y: 0, w: 320, h: 200 }], 64, 100);
assert(full_dirty.mode == "full-frame", "large dirty coverage becomes full frame");
let clean_dirty = gfx.dirty_region_plan(map{ w: 320, h: 200 }, [], 64, 100);
assert(clean_dirty.mode == "skip-present" and clean_dirty.tile_count == 0, "empty dirty region skips present");

let batch = gfx.render_batch_plan([
    map{ op: "box", x: 0, y: 0, w: 100, h: 24 },
    map{ op: "box", x: 0, y: 24, w: 100, h: 24 },
    map{ op: "text", x: 8, y: 8, text: "hello" }
], nil);
assert(batch.format == "pblang.graphics.render_batch_plan.v1", "render batch plan has stable format");
assert(batch.native_rect_batch == true and batch.text_cache_recommended == true and batch.weight > 0, "render batch plan detects rect batching and text cache");

let sched_cmds = [
    map{ op: "box", x: 0, y: 0, w: 100, h: 24 },
    map{ op: "text", x: 8, y: 8, text: "hello" }
];
let sched = gfx.frame_schedule(map{ format: "pblang.graphics.backend.profile.v1", backend: "sdl2", present: "gpu-assisted-texture-present", gpu_present: true, cpu_raster_ui: true, idle_present_skip: true, text_renderer: "fontdue", text_antialias: true }, map{ w: 1280, h: 720 }, [map{ x: 10, y: 10, w: 120, h: 80 }], sched_cmds, map{ target_fps: 60, parallel: true });
assert(sched.format == "pblang.graphics.frame_schedule.v1", "frame schedule has stable format");
assert(str_contains(sched.present, "gpu") and sched.parallel_prepare == true and sched.safe == true and sched.backward_compatible == true, "frame schedule prefers GPU-present and safe parallel prep");
assert(sched.adaptive.format == "pblang.graphics.frame_adaptive.v1" and sched.adaptive.pressure == "ok" and sched.adaptive.action == "steady", "frame schedule carries adaptive frame-budget metadata");
let sched_status = gfx.frame_schedule_status(sched);
assert(str_contains(sched_status, "frame ") and str_contains(sched_status, "route=") and str_contains(sched_status, "batch=") and str_contains(sched_status, "pressure="), "frame schedule status is readable");
let skip_sched = gfx.frame_schedule(bp, map{ w: 800, h: 600 }, [], [], nil);
assert(skip_sched.present == "skip" and skip_sched.dirty.mode == "skip-present", "frame schedule skips unchanged frames");
let slow_sched = gfx.frame_schedule(bp, map{ w: 800, h: 600 }, [map{ x: 0, y: 0, w: 100, h: 100 }], sched_cmds, map{ target_fps: 60, perf: map{ avg_draw_ms: 40, last_draw_ms: 45, skips: 3 } });
assert(slow_sched.adaptive.pressure == "critical" and slow_sched.adaptive.recommended_fps == 30 and str_contains(str_join(slow_sched.warnings, "\n"), "2x frame budget"), "frame schedule recommends lower pressure when draws are too slow");
assert(gfx.idle_frame_delay(1000 / 30, 0) == 1000 / 30, "active frame keeps target input rate");
assert(gfx.idle_frame_delay(1000 / 30, 3) == 80, "idle frame pacing caps polling delay at 80ms");
assert(gfx.idle_frame_delay(10, 4) == 30, "high-fps idle pacing reduces CPU without exceeding cap");
assert(not gfx.idle_event_pump_due(119, 120), "idle event pump skips early framebuffer copies");
assert(gfx.idle_event_pump_due(120, 120), "idle event pump keeps native window events responsive");
assert(gfx.idle_event_pump_due(16, 1), "idle event pump clamps unsafe high-frequency configuration");

assert(not gfx.window_size_changed(map{ w: 800, h: 600 }, map{ w: 800, h: 600 }), "equal live window sizes stay stable");
assert(gfx.window_size_changed(map{ w: 800, h: 600 }, map{ w: 1920, h: 1080 }) == true, "maximize geometry invalidates the framebuffer");
let resize_burst = gfx.coalesce_resize_events([
    map{ type: "mousemove", x: 10, y: 12 },
    map{ type: "resize", w: 1280, h: 720 },
    map{ type: "keydown", key: "A" },
    map{ type: "resize", w: 1600, h: 900 }
], map{ w: 1920, h: 1080 }, false);
assert(len(resize_burst) == 3, "resize bursts collapse to one authoritative event");
assert(resize_burst[0].type == "mousemove" and resize_burst[1].type == "keydown", "resize coalescing preserves non-resize event order");
assert(resize_burst[2].type == "resize" and resize_burst[2].w == 1920 and resize_burst[2].h == 1080, "live framebuffer geometry wins over stale resize records");
let synthesized_resize = gfx.coalesce_resize_events([], map{ w: 1366, h: 768 }, true);
assert(len(synthesized_resize) == 1 and synthesized_resize[0].type == "resize", "a resize consumed during present is restored on the next frame");

print "graphics_helpers_pass";
