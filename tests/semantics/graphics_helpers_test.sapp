// tests/semantics/graphics_helpers_test.sapp
let gfx = import("stdlib:graphics.sapp");

let p0 = gfx.bezier_point(0, 0, 10, 0, 10, 10, 20, 10, 0);
assert(p0[0] == 0 and p0[1] == 0, "bezier t=0 starts at first point");

let p1 = gfx.bezier_point(0, 0, 10, 0, 10, 10, 20, 10, 1);
assert(p1[0] == 20 and p1[1] == 10, "bezier t=1 ends at last point");

let mid = gfx.bezier_point(0, 0, 10, 0, 10, 10, 20, 10, 0.5);
assert(mid[0] == 10 and mid[1] == 5, "bezier midpoint should follow cubic curve");

let pts = gfx.bezier_points(0, 0, 10, 0, 10, 10, 20, 10, 4);
assert(len(pts) == 5, "bezier_points includes both endpoints");
assert(pts[0][0] == 0 and pts[4][0] == 20, "bezier_points endpoints preserved");

let one = gfx.bezier_points(0, 0, 1, 0, 1, 1, 2, 1, 0);
assert(len(one) == 2, "segment count is clamped to at least one");

let many = gfx.bezier_points(0, 0, 1, 0, 1, 1, 2, 1, 999);
assert(len(many) == 513, "segment count is capped");

let c = gfx.lerpColor(gfx.RED, gfx.BLUE, 0.5);
assert(c[0] == 127.5 and c[1] == 0 and c[2] == 127.5, "lerpColor still works");

let txt = type(gfx.draw_text);
assert(txt == "closure" or txt == "fn" or txt == "builtin", "draw_text is exported as callable");

let bp = gfx.backend_profile();
assert(bp.format == "pblang.graphics.backend.profile.v1", "backend profile exposes stable format");
assert(bp.backend == "minifb" or bp.backend == "sdl2", "backend profile names known graphics backend");
assert(bp.cpu_raster_ui == true and bp.idle_present_skip == true, "backend profile states PBIDE raster/present behavior");
let bs = gfx.backend_status();
assert(str_contains(bs, "gfx ") and (str_contains(bs, "cpu") or str_contains(bs, "gpu-present")), "backend status summarizes renderer path");

print "graphics_helpers_pass";
