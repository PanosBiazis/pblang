let S=import("stdlib:snapshot_compare.sapp");
let a=str_repeat("a",64);let b=str_repeat("0",64);
fn entry(id,digest,size) {return map{id:id,digest:digest,size:size};}
fn doc(entries) {return map{format:S.FORMAT,entries:entries};}
fn bad(value) {return (try S.validate(value) catch nil)==nil;}
let before=doc([entry("same",a,0),entry("changed",a,1),entry("removed",b,2),entry("conflict",a,3)]);
let after=doc([entry("conflict",a,4),entry("added",b,5),entry("changed",b,1),entry("same",a,0)]);
let saved_before=json_stringify(before);let saved_after=json_stringify(after);
assert(S.validate(json_parse(saved_before)),"trusted JSON roundtrip");
let report=S.compare(before,after);
for status in ["unchanged","modified","added","removed","inconsistent"] {assert(report.counts[status]==1,"all five outcomes");}
assert(report.entries[0].id=="same" and report.entries[1].id=="changed" and report.entries[4].id=="added","deterministic ordering independent of after order");
assert(report.entries[2].before_size==2 and report.entries[2].after_size==nil and report.entries[4].before_size==nil,"missing sizes explicitly nil");
assert(report.metadata_is_caller_supplied and not report.contents_verified and not report.merge_performed and not report.digests_included,"evidence boundary");
assert(not str_contains(json_stringify(report),a) and not str_contains(json_stringify(report),b),"no input digest in output");
report.entries[0].id="mutated";report.counts.unchanged=99;
assert(json_stringify(before)==saved_before and json_stringify(after)==saved_after,"detached result and unchanged inputs");
assert(S.compare(before,after).counts.unchanged==1,"fresh result");
assert(len(S.compare(doc([]),doc([])).entries)==0,"empty snapshots");
assert(S.compare(doc([]),before).counts.added==4 and S.compare(before,doc([])).counts.removed==4,"one empty snapshot");
assert(S.compare(doc([entry("x",a,1)]),doc([entry("x",b,2)])).counts.modified==1,"size and digest both changed");
assert(S.compare(doc([entry("old",a,1)]),doc([entry("new",a,1)])).counts.added==1,"identical metadata does not infer rename");
for value in [nil,[],map{},map{format:S.FORMAT,entries:[],extra:0},map{format:"wrong",entries:[]},doc(nil),doc([nil]),doc([map{id:"x",digest:a}]),doc([map{id:"x",digest:a,size:0,extra:1}]),doc([entry("x",a,0),entry("x",b,1)])] {assert(bad(value),"malformed manifest");assert((try S.compare(doc([]),value) catch nil)==nil,"after validation");assert((try S.compare(value,doc([])) catch nil)==nil,"before validation");}
for id in [nil,1,true,"","../x","a/b","a.b","a-b","0x","α",str_repeat("x",33)] {assert(bad(doc([entry(id,a,0)])),"logical identifier bounds");}
for digest in [nil,1,true,"",str_repeat("a",63),str_repeat("a",65),str_repeat("A",64),str_repeat("g",64),str_repeat("α",64)] {assert(bad(doc([entry("x",digest,0)])),"lowercase SHA256 shape");}
for size in [nil,true,false,"0",[],map{},-1,0.5,1000000000001,parse_number("NaN"),parse_number("inf"),parse_number("-inf")] {assert(bad(doc([entry("x",a,size)])),"exact bounded integer size");}
assert(S.validate(doc([entry(str_repeat("x",32),"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",1000000000000)])),"inclusive identifier, digest and size boundaries");
let left=[];let right=[];for i in range(0,256) {array_push(left,entry("l"+str(i),a,i));array_push(right,entry("r"+str(i),b,i));}
let max=S.compare(doc(left),doc(right));assert(len(max.entries)==512 and max.counts.removed==256 and max.counts.added==256,"bounded maximum union");
array_push(left,entry("overflow",a,0));assert(bad(doc(left)),"257 rejected");
print "snapshot_compare_pass";
