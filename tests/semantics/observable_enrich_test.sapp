// tests/semantics/observable_enrich_test.sapp — enrichment for stdlib/observable.sapp
// Adds stream operators: distinct, tap, skip, take_while, buffer, and collect.

let obs = import("stdlib/observable.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn arr_eq(a, b, m) {
    if len(a) != len(b) { fail(m + " len " + str(len(a)) + " vs " + str(len(b)) + " : " + str(a)); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " @" + str(i)); } i = i + 1; }
}

// ── base ref/watch still works ───────────────────────────────────────────────────
let r = obs.ref(0);
let seen = map{ v: nil };
obs.watch(r, fn(o, n) { seen.v = n; });
obs.set(r, 5);
eq(seen.v, 5, "watch fires on set");

// ── ENRICH: collect gathers emissions ────────────────────────────────────────────
let src = obs.stream();
let got = obs.collect(src);
obs.emit(src, "a"); obs.emit(src, "b");
arr_eq(got, ["a", "b"], "collect accumulates emissions");

// ── ENRICH: distinct ─────────────────────────────────────────────────────────────
let s1 = obs.stream();
let d = obs.collect(obs.distinct_stream(s1));
let vals = [1, 1, 2, 2, 2, 3, 1];
let i = 0; while i < len(vals) { obs.emit(s1, vals[i]); i = i + 1; }
arr_eq(d, [1, 2, 3, 1], "distinct drops consecutive duplicates");

// ── ENRICH: tap (side effect, value passes through) ──────────────────────────────
let s2 = obs.stream();
let tapped = map{ n: 0 };
let t = obs.collect(obs.tap_stream(s2, fn(v) { tapped.n = tapped.n + 1; }));
obs.emit(s2, "x"); obs.emit(s2, "y");
eq(tapped.n, 2, "tap ran the side effect"); arr_eq(t, ["x", "y"], "tap passes values through");

// ── ENRICH: skip ─────────────────────────────────────────────────────────────────
let s3 = obs.stream();
let sk = obs.collect(obs.skip_stream(s3, 2));
i = 1; while i <= 5 { obs.emit(s3, i); i = i + 1; }
arr_eq(sk, [3, 4, 5], "skip drops the first n");

// ── ENRICH: take_while ───────────────────────────────────────────────────────────
let s4 = obs.stream();
let tw = obs.collect(obs.take_while_stream(s4, fn(v) { return v < 3; }));
i = 1; while i <= 5 { obs.emit(s4, i); i = i + 1; }
arr_eq(tw, [1, 2], "take_while stops at first false");

// ── ENRICH: buffer ───────────────────────────────────────────────────────────────
let s5 = obs.stream();
let bufs = obs.collect(obs.buffer_stream(s5, 2));
i = 1; while i <= 5 { obs.emit(s5, i); i = i + 1; }
eq(len(bufs), 2, "buffer emits full chunks only");
arr_eq(bufs[0], [1, 2], "buffer chunk 0"); arr_eq(bufs[1], [3, 4], "buffer chunk 1");

print "observable_enrich_pass";
