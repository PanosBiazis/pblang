let P=import("stdlib:thread_pool.sapp");
fn task(i) {return fn(){if i%7==0 {throw "test task";}return i;};}
fn expected(priorities) {
    let order=[];
    for i len(priorities) {
        array_push(order,i);let at=i;
        while at>0 and priorities[order[at-1]]<priorities[i] {order[at]=order[at-1];at=at-1;}
        order[at]=i;
    }
    let ok=[];let all=[];
    for i in order {
        if i%7==0 {array_push(all,nil);} else {array_push(ok,i);array_push(all,i);}
    }
    return map{ok:ok,all:all};
}
for workers in [1,3,4,8] {
    for count in [0,1,2,5,9,17,33] {
        let pool=P.new_thread_pool(workers);
        // Completed history means task index, ID and pending-batch rank differ.
        P.submit(pool,fn(){return "old";});P.run_parallel(pool);
        let priorities=[];let ids=[];
        for i count {let rank=(i*13)%9;array_push(priorities,rank);array_push(ids,P.submit_priority(pool,task(i),rank));}
        let want=expected(priorities);let got=P.run_parallel(pool);
        assert(got.results==want.ok,"uneven chunks collect in stable priority order");
        assert(got.completed==len(want.ok) and got.failed==count-len(want.ok),"exact accounting");
        assert(len(pool.results)==count+1 and pool.results[0]=="old","completed history survives");
        for i count {
            assert(pool.results[i+1]==want.all[i],"history slots");
            let state="done";if i%7==0 {state="failed";}
            assert(P.get_status(pool,ids[i])==state,"original ID status");
            if state=="done" {assert(P.get_result(pool,ids[i])==i,"original ID result");}
        }
        assert(P.run_parallel(pool).completed==0,"no replay");P.shutdown(pool);
    }
}
// The public generic splitter retains its API and round-robin layout.
assert(P.split_tasks([0,1,2,3,4],3)==[[0,3],[1,4],[2]],"public splitter unchanged");
print "thread_pool_chunk_layout_pass";
