// tests/semantics/pbp_enrich_test.sapp — enrichment for stdlib/pbp.sapp

let P = import("stdlib/pbp.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn contains(arr, v) { let i = 0; while i < len(arr) { if arr[i] == v { return true; } i = i + 1; } return false; }

// ── encode/decode round-trip (baseline of the new validators) ─────────────────────
let f = P.encode_frame("DATA", 3, "hello");
let d = P.decode_frame(f);
eq(d.type, "DATA", "decoded type"); eq(d.seq, 3, "decoded seq"); eq(d.payload, "hello", "decoded payload");

// ── is_valid_frame ──────────────────────────────────────────────────────────────────
if not P.is_valid_frame(f) { fail("a real frame is valid"); }
if P.is_valid_frame("not a pbp frame") { fail("garbage is not a valid frame"); }

// ── frame_types / is_frame_type ───────────────────────────────────────────────────
let ts = P.frame_types();
if not contains(ts, "DATA") { fail("types include DATA"); }
if not contains(ts, "HELLO") { fail("types include HELLO"); }
eq(len(ts), 5, "five frame types");
if not P.is_frame_type("ACK") { fail("ACK is a frame type"); }
if P.is_frame_type("NOPE") { fail("NOPE is not a frame type"); }

print "pbp_enrich_pass";
