let P=import("stdlib:profiler.sapp");
fn expect(ok,label) {if not ok {throw "FAIL profiler-memory: "+label;}}
fn check(a,b,allocations,borrows) {
    let saved_a=json_stringify(a);let saved_b=json_stringify(b);
    expect(json_stringify(P.mem_diff(a,b))==json_stringify(map{allocations_delta:allocations,borrows_delta:borrows}),"delta schema and values");
    expect(json_stringify(a)==saved_a and json_stringify(b)==saved_b,"no input mutation");
}
check(map{allocations:10,borrows:2},map{allocations:14,borrows:1},4,-1);
check(map{total_allocs:10,active_borrows:2},map{total_allocs:14,active_borrows:1},4,-1);
check(map{total_allocs:10,active_borrows:2,allocations:100,borrows:100},
    map{total_allocs:14,active_borrows:1,allocations:0,borrows:0},4,-1);
check(map{},map{},nil,nil);
check(map{total_locations:10},map{total_locations:100},nil,nil);
check(map{total_allocs:10,active_borrows:2},map{allocations:14,borrows:1},nil,nil);
check(map{total_allocs:10,allocations:5,active_borrows:2,borrows:1},map{allocations:9,borrows:2},nil,nil);
for key in ["total_allocs","active_borrows","allocations","borrows"] {
    for value in [nil,true,-1,"private-memory-marker",[],map{},fn(){return 0;},
        parse_number("NaN"),parse_number("inf"),parse_number("-inf"),bigint(1),rational("1/1"),decimal("1")] {
        let bad=map{};bad[key]=value;let good=map{};good[key]=1;
        expect(not (try {P.mem_diff(bad,good);true} catch false),"invalid before metric");
        expect(not (try {P.mem_diff(good,bad);true} catch false),"invalid after metric");
        expect(not (try {P.mem_diff(bad,map{});true} catch false),"invalid present metric cannot fall back");
    }
}
for bad in [nil,true,1,"private-memory-marker",[]] {
    expect(not (try {P.mem_diff(bad,map{});true} catch false),"before shape");
    expect(not (try {P.mem_diff(map{},bad);true} catch false),"after shape");
}
let raw=P.mem_snapshot();let same=P.mem_diff(raw,raw);
expect(same.allocations_delta==nil and same.borrows_delta==0,"raw memory tracker is not allocation accounting");
print "profiler_memory_pass";
