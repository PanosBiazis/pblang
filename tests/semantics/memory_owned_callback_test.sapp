let M = import("stdlib:memory.sapp");
let Owned = import("stdlib:memory_owned.sapp");
fn require(ok, why) { if not ok { throw "FAIL memory_owned_callback: " + why; } }
let initial = M.stats();
for value in [nil, false, true, 42, "text"] {
    let result = Owned.with_box_result(value, fn(h) { M.borrow(h); return M.read(h); });
    require(result.ok and result.value == value and result.cleanup_ok, "normal return including nil/false");
    require(M.stats().total_locations == initial.total_locations, "normal owner removed");
}
let admission = map{called:false};
for value in [[], map{}, fn(){return 1;}] {
    let rejected=Owned.with_box_result(value, fn(h){admission.called=true;return 1;});
    require(not rejected.ok and not rejected.allocation_ok and not rejected.body_ok and rejected.cleanup_ok, "unsupported value rejected before acquisition");
}
require(not admission.called and M.stats().total_locations == initial.total_locations, "rejection runs no callback and allocates nothing");
let escaped = map{handle:0};
let failed = Owned.with_box_result(1, fn(h) { escaped.handle=h; M.borrow(h); throw "private callback payload"; });
require(not failed.ok and not failed.body_ok and failed.cleanup_ok, "callback failure cleaned");
require(failed.error == "memory: owned callback failed" and failed.value == nil, "fixed error has no callback content");
require((try M.read(escaped.handle) catch "freed") == "freed", "escaped handle invalid");
require((try Owned.with_box(1, fn(h){throw "failure";}) catch "raised") == "raised", "throwing wrapper reports failure");
require(Owned.with_box(10, fn(h){M.write(h,12);return M.read(h);}) == 12, "mutable owner supports writes before borrowing");
let immutable = Owned.with_box_immutable_result(15, fn(h){ M.write(h,16); });
require(not immutable.ok and immutable.cleanup_ok, "immutable write fails and cleans");
require(Owned.with_box_immutable(17, fn(h){return M.read(h);}) == 17, "immutable read");
let nested = Owned.with_box(2, fn(outer){
    M.borrow(outer);
    let n=Owned.with_box(3, fn(inner){M.borrow(inner);return M.read(inner);});
    return M.read(outer)+n;
});
require(nested == 5, "nested cleanup preserves outer owner and borrow");
let manually_freed = Owned.with_box_result(5, fn(h){M.free(h);return 6;});
require(manually_freed.ok and manually_freed.value == 6, "manual free remains idempotent");
let not_callable = Owned.with_box_result(5, nil);
require(not not_callable.ok and not_callable.cleanup_ok, "invalid callback still releases allocation");
// Depth checks must not pop a caller scope after early callback scope removal.
push_lifetime(); let caller_depth=M.stats().lifetime_depth; let caller=M.box(55);
let premature = Owned.with_box_result(6, fn(h){pop_lifetime();return 7;});
require(not premature.ok and not premature.cleanup_ok and premature.value == nil, "premature pop not successful cleanup");
require(M.stats().lifetime_depth == caller_depth and M.read(caller) == 55, "caller lifetime preserved");
M.free(caller); pop_lifetime();
// Same depth is insufficient: replacing the helper lifetime changes its token.
let replaced=Owned.with_box_result(7, fn(h){pop_lifetime();push_lifetime();return 8;});
require(not replaced.ok and not replaced.cleanup_ok, "replacement token detected");
// Extra raw scopes are not unwound speculatively. The test owns and repairs them.
let extra=Owned.with_box_result(8, fn(h){push_lifetime();return 9;});
require(not extra.ok and not extra.cleanup_ok, "extra scope reported");
require(M.stats().lifetime_depth == initial.lifetime_depth+2, "unexpected scopes left visible");
pop_lifetime(); pop_lifetime();
let i=0;
while i<100 {
    Owned.with_box_result(i, fn(h){M.borrow(h);throw "repeat";});
    i=i+1;
}
let final=M.stats();
require(final.total_locations == initial.total_locations and final.active_borrows == initial.active_borrows and final.lifetime_depth == initial.lifetime_depth, "no accumulation after repeated failures");
print "memory_owned_callback_pass";
