// Linux-only live descriptor regression. No nonzero signal is sent by this test.
let P=import("stdlib:linux_pidfd.sapp");
fn rejects(body) {return try {body();false} catch true;}
assert(platform()=="linux","Linux pidfd regression requires Linux");
let current=P.current_pid();assert(current.ok,"current process identity available");
let before=len(fs_listdir("/proc/self/fd"));
for i 32 {
    for signal in ["USR1",nil,7,"", "TERM\u0000"] {
        assert(rejects(fn(){P.signal_once(current.pid,signal);}),"unsupported signal rejected");
    }
}
assert(len(fs_listdir("/proc/self/fd"))==before,"rejected one-shot requests leak no descriptors");
for i 32 {
    let held=P.open(current.pid);assert(held.ok and P.exists(held),"own identity opened");
    assert(P.close(held),"both resources released");
    assert(held.fd==-1 and not P.close(held) and not P.exists(held),
        "retired identity cannot be reused");
}
assert(len(fs_listdir("/proc/self/fd"))==before,"normal lifecycle leaks no descriptors");
print "linux_pidfd_lifetime_pass";
