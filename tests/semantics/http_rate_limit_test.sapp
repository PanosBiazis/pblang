// http_rate_limit_test.sapp
// Verify that http_server.mw_rate_limit blocks after max_requests per window.

import "stdlib:http_server.sapp";

let app = http_server.app_new();
// Allow at most 2 requests per large window so all three calls are inside it.
let app = http_server.app_use(app, http_server.mw_rate_limit(60000, 2));
let app = http_server.app_get(app, "/hi", fn(req) {
    return map{ status: 200, body: "ok", content_type: "text/plain" };
});

let req = http_parse_request("GET /hi HTTP/1.1\r\nHost: example\r\n\r\n");

let r1 = http_server.app_handle(app, req);
print r1.status;

let r2 = http_server.app_handle(app, req);
print r2.status;

let r3 = http_server.app_handle(app, req);
print r3.status;

print "http_rate_limit_pass";

