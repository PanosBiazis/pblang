let C = import("stdlib:class.sapp");
let F = import("stdlib:functional.sapp");
fn expect(ok, label) { if not ok { throw "FAIL class-super-owner: " + label; } }

let visits = [];
let Base = C.define("Base", [], map{
    speak: fn(self) { push(visits, "base"); return "base"; },
    scale: fn(self, x) { return x * 2; },
    combine: fn(self, x, y) { return x + y; },
    fail: fn(self) { throw "base failure"; },
    reflect: fn(self) { return [C.class_name(self), C.call1(self, "scale", 3)]; }
});
let Middle = nil;
Middle = C.extend(Base, "Middle", [], map{
    speak: fn(self) {
        push(visits, "middle");
        if len(visits) > 5 { throw "unexpected repeated dispatch"; }
        return C.super_call(self, "speak", Middle) + ":middle";
    },
    scale: fn(self, x) { return C.super1(self, "scale", x, Middle) + 1; },
    combine: fn(self, x, y) { return C.super2(self, "combine", x, y, Middle) * 2; },
    fail: fn(self) { return C.super_call(self, "fail", Middle); },
    reflect: fn(self) { return C.super_call(self, "reflect", Middle); }
});
let Leaf = nil;
Leaf = C.extend(Middle, "Leaf", [], map{
    speak: fn(self) { push(visits, "leaf"); return C.super_call(self, "speak", Leaf) + ":leaf"; }
});
let Deeper = C.extend(Leaf, "Deeper");
let obj = C.new(Deeper);
expect(C.call(obj, "speak") == "base:middle:leaf", "four-level explicit owner dispatch");
expect(visits == ["leaf", "middle", "base"], "each method called once in order");
expect(C.class_name(obj) == "Deeper", "dispatch preserves dynamic class");
expect(C.call(obj, "reflect") == ["Deeper", 7], "parent sees dynamic class and can dispatch back into override");
expect(C.super_method(obj, "speak", Middle)(obj) == "base", "raw parent method selection");
expect(C.call1(obj, "scale", 3) == 7, "one argument through inherited override");
expect(C.call2(obj, "combine", 3, 4) == 14, "two arguments through inherited override");
expect(F.map([1, 2, 3], C.bind1(obj, "scale")) == [3, 5, 7], "bound method and functional composition");
let Mixed = C.mixin(Deeper, map{ extra: fn(self) { return 9; } });
expect(C.call1(C.new(Mixed), "scale", 4) == 9, "mixed class keeps explicit method owner");
let failed = try map{ ok: true, value: C.call(obj, "fail") } catch map{ ok: false };
expect(not failed.ok and C.class_name(obj) == "Deeper", "throw leaves dynamic class unchanged");
expect(C.call1(obj, "scale", 5) == 11, "dispatch remains usable after throw");
for owner in [false, 1, "Middle", [], map{}] {
    let invalid = try map{ ok: true, value: C.super_method(obj, "speak", owner) } catch map{ ok: false };
    expect(not invalid.ok, "malformed explicit owner rejected");
}
let missing_parent = try map{ ok: true, value: C.super_method(obj, "speak", Base) } catch map{ ok: false };
let missing_method = try map{ ok: true, value: C.super_method(obj, "absent", Middle) } catch map{ ok: false };
let missing_instance = try map{ ok: true, value: C.super_method(map{}, "speak", Middle) } catch map{ ok: false };
expect(not missing_parent.ok and not missing_method.ok and not missing_instance.ok, "missing parent/method/instance reject");
// Legacy omitted/nil owner remains rooted at the dynamic class's parent.
expect(C.super1(C.new(Middle), "scale", 6) == 12, "legacy omitted owner");
expect(C.super2(C.new(Middle), "combine", 6, 7, nil) == 13, "explicit nil preserves default");
print "class_super_owner_pass";
