let App=import("../../examples/declarative_browser/app.sapp");let GUI=import("stdlib:gui.sapp");let D=import("stdlib:browser_document.sapp");
let n=0;fn check(ok,label){assert(ok,label);n=n+1;}
fn key(c,k){App.update(c,[map{type:"keydown",key:k},map{type:"keyup",key:k}]);}
fn act(c,name){GUI.get(c.form,name).onclick(c.form);App.update(c,[]);}
fn focus(c,name){c.focus_target=name;App.refresh(c);}
fn make(width,height,operation){let c=App.create();c.width=width;c.height=height;c.session.navigate("pb://guide");c.session.navigate("pb://about");if operation=="forward" {c.session.back();}App.refresh(c);return c;}
for size in [map{w:320,h:240},map{w:320,h:480},map{w:800,h:816}] {for operation in ["home","back","forward"] {for dirty in [true,false] {
 let c=make(size.w,size.h,operation);let reference=make(size.w,size.h,operation);let calls=map{save:0,reload:0};
 let save=fn(style){calls.save=calls.save+1;return map{ok:true};};let reload=fn(){calls.reload=calls.reload+1;return map{ok:false};};
 App.enable_preferences(c,nil,save,"Saved appearance loaded",reload);App.update(c,[]);act(c,"appearance");if dirty {act(c,"font_family");}
 let applied=c.appearance;let message="Saved appearance loaded";if dirty {message="Unapplied changes discarded";}let document=D.export_html(c.session.snapshot().document);
 focus(c,operation);App.update(c,[map{type:"keydown",key:"Enter"},map{type:"keydown",key:"Enter"}]);
 check(c.preferences.draft==applied,"Navigation discards unapplied draft immediately");check(not c.settings and c.appearance==applied,"navigation keeps applied appearance");
 check(c.preferences.message==message,"navigation reports only a real discard");
 check(c.form.focus==nil and not c.form.close_requested and map_has(c.form.pressed_keys,"Enter"),"fresh-page focus and held key retained");
 App.update(c,[map{type:"keyup",key:"Enter"}]);act(reference,operation);
 check(c.session.snapshot()==reference.session.snapshot(),"document and session match navigation without Style");
 check(c.reading_anchor==reference.reading_anchor and c.reading_page==reference.reading_page and c.reading_history==reference.reading_history,"reading position and history unchanged by discard");
 check(c.navigations==reference.navigations and calls.save==0 and calls.reload==0,"held navigation occurs once with no storage calls");
 let destination=D.export_html(c.session.snapshot().document);act(c,"appearance");check(c.preferences.draft==applied and c.form.focus=="font_family","reopened Style is consistent");
 check(D.export_html(c.session.snapshot().document)==destination and len(document)>0,"Style never changes reading content");
 check(c.preferences.save==save and c.preferences.reload==reload,"callbacks retained");c.session.close();reference.session.close();
}}}
// An applied or explicitly saved choice survives; only a later draft is discarded.
for action in ["style_apply","style_save"] {
 let c=make(320,240,"home");let state=map{writes:0,style:nil};let saver=fn(style){state.writes=state.writes+1;state.style=style;return map{ok:true};};
 App.enable_preferences(c,nil,saver);App.update(c,[]);act(c,"appearance");act(c,"font_family");focus(c,action);act(c,action);let accepted=c.appearance;let writes=state.writes;
 focus(c,"font_family");act(c,"font_family");act(c,"home");
 check(c.appearance==accepted and c.preferences.draft==accepted and accepted.font_family=="serif","accepted choice survives later draft discard");check(state.writes==writes,"navigation never retries Save");c.session.close();
}
// An unavailable navigation button and an actual close must not dismiss Style.
let blocked=App.create();App.enable_preferences(blocked);App.update(blocked,[]);act(blocked,"appearance");act(blocked,"font_family");let draft=blocked.preferences.draft;blocked.form.focus="back";key(blocked,"Enter");
check(blocked.settings and blocked.preferences.draft==draft and blocked.preferences.message=="Changes not applied","disabled Back preserves draft");blocked.session.close();
let closing=make(800,816,"home");App.enable_preferences(closing);App.update(closing,[]);act(closing,"appearance");act(closing,"font_family");focus(closing,"home");let before=closing.session.snapshot();
App.update(closing,[map{type:"close"},map{type:"keydown",key:"Enter"}]);check(closing.form.close_requested and closing.session.snapshot()==before and closing.preferences.draft!=closing.appearance,"close prevents later navigation");closing.session.close();
// Read-only profile failure stays read-only; clean messages are not replaced.
let read_only=make(320,240,"home");App.enable_preferences(read_only,nil,nil,"Reload failed; current style kept",fn(){throw "Must not reload";});App.update(read_only,[]);act(read_only,"appearance");act(read_only,"home");
check(read_only.preferences.save==nil and read_only.preferences.message=="Reload failed; current style kept","clean failure status remains");act(read_only,"appearance");act(read_only,"font_family");act(read_only,"home");check(read_only.preferences.save==nil and read_only.preferences.draft==read_only.appearance,"discard cannot restore write capability");read_only.session.close();
let legacy=make(320,240,"home");act(legacy,"appearance");act(legacy,"font_family");act(legacy,"home");check(legacy.appearance.font_family=="serif" and legacy.preferences==nil,"legacy immediate setting survives navigation");legacy.session.close();
print "reader_navigation_draft_pass checks="+str(n);
