// tests/semantics/knowledge_base_test.sapp — a growing non-parametric memory: store
// experiences and recall the nearest ones (knowledge capacity that grows with data).

let kb = import("stdlib/knowledge_base.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let m = kb.kb_new();
eq(kb.kb_density(m), 0, "empty knowledge base");
kb.kb_learn(m, [0, 0], [0]);
kb.kb_learn(m, [1, 1], [1]);
kb.kb_learn(m, [0, 1], [2]);
eq(kb.kb_density(m), 3, "density grows as it learns");

// recall: nearest stored experience first
let near = kb.kb_recall(m, [0.95, 0.95], 1);
eq(near[0].y[0], 1, "recall returns the nearest exemplar");
eq(len(kb.kb_recall(m, [0, 0], 2)), 2, "recall k items");

// predict: 1-NN over memory
eq(kb.kb_predict(m, [0.1, 0.1])[0], 0, "predict from nearest memory (origin)");
eq(kb.kb_predict(m, [0.1, 0.9])[0], 2, "predict from nearest memory ([0,1])");

// merge two knowledge bases -> combined capacity
let m2 = kb.kb_new();
kb.kb_learn(m2, [5, 5], [9]);
let big = kb.kb_merge(m, m2);
eq(kb.kb_density(big), 4, "merge sums knowledge density");
eq(kb.kb_predict(big, [5, 5])[0], 9, "merged knowledge is recallable");

print "knowledge_base_pass";
