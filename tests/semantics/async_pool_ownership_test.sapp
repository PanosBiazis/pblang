let A = import("stdlib:async.sapp");
fn job(value) { return fn(){ return value; }; }
let items = [];
let tasks = [];
for i 40 { array_push(items, i); array_push(tasks, job(i)); }
for size in [1, 4, 12, 60] {
    let p = A.pool(size, tasks);
    let m = A.map_parallel(items, fn(x){ return x * 2; }, size);
    assert(len(p) == 40 and len(m) == 40, "all jobs complete");
    for i 40 { assert(p[i] == i and m[i] == i * 2, "ordered results"); }
}
let automatic = A.map_parallel(items, fn(x){ return x + 1; });
for i 40 { assert(automatic[i] == i + 1, "default reuses workers"); }
let mixed = A.pool(2, [fn(){return nil;}, fn(){throw "task";}, fn(){return false;}, fn(){return map{idx:99,value:7};}]);
assert(mixed[0] == nil and mixed[1] == nil and mixed[2] == false, "task compatibility");
assert(mixed[3].idx == 99 and mixed[3].value == 7, "result envelope cannot collide");
let m = A.map_parallel([0, 1, 2], fn(x){ if x == 1 {throw "task";} return x; });
assert(m[0] == 0 and m[1] == nil and m[2] == 2, "mapper failure compatibility");
assert(len(A.map_parallel([], fn(x){return x;})) == 0, "no empty workers");
for i 5 { assert(A.pool(1, [job(i)])[0] == i, "repeated use after joins"); }
print "async_pool_ownership_pass";
