// tests/semantics/pbai_host_answer_test.sapp — the canonical pbai brain wires its own
// grounded skills as the ensemble responder at import time, so answer() returns a FULL
// text answer (skill output), not just an intent label. Kept separate from the engine
// tests: imports are hoisted, so an engine test reconfiguring the shared engine would
// clobber this host wiring.

let AI = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }

let ha = AI.answer("why does this crash: fn f(x) { return m[x]; }");
if not is_string(try ha.text catch nil) { fail("pbai answer produces text"); }
if len(ha.text) < 10 { fail("pbai answer text non-trivial"); }
if not is_string(try ha.intent catch nil) { fail("pbai answer has intent"); }
if (try ha.confidence catch nil) == nil { fail("pbai answer has confidence"); }

// auto_configure is reachable through the host too (no voters -> static wins, all right)
let r = AI.auto_configure([ map{ prompt: "explain fn f(){}", intent: AI.classify_scores("explain fn f(){}").intent } ]);
if r.accuracy != 1 { fail("auto_configure on self-labeled example scores 1"); }

print "pbai_host_answer_pass";
