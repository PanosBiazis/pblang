// tests/semantics/llm_data_enrich_test.sapp — enrichment for stdlib/llm_data.sapp
// Adds dedupe, token_frequencies, unique_token_count.

let d = import("stdlib/llm_data.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn aeq(a, b, m) {
    if len(a) != len(b) { fail(m + " len : " + str(a)); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " @" + str(i)); } i = i + 1; }
}

// ── base chunk_ids still works ───────────────────────────────────────────────────
eq(len(d.chunk_ids([1, 2, 3, 4], 2)), 2, "chunk_ids count");

// ── ENRICH: dedupe ───────────────────────────────────────────────────────────────
aeq(d.dedupe([1, 2, 2, 3, 1]), [1, 2, 3], "dedupe primitives");
eq(len(d.dedupe([map{ x: 1 }, map{ x: 1 }, map{ x: 2 }])), 2, "dedupe records by content");

// ── ENRICH: token_frequencies ────────────────────────────────────────────────────
let tf = d.token_frequencies([1, 1, 2, 1]);
eq(tf["1"], 3, "freq of 1"); eq(tf["2"], 1, "freq of 2");

// ── ENRICH: unique_token_count ───────────────────────────────────────────────────
eq(d.unique_token_count([1, 1, 2, 3, 3]), 3, "unique token count");

print "llm_data_enrich_pass";
