// tests/semantics/selfhost_slice_test.sapp
//
// Self-host breadth gap: the runtime (Rust) parser accepts the range-slice
// sugar `a[lo..hi]` (desugaring to slice(a, lo, hi)), but the SELF-HOSTED
// parser did not — so `pblang check` reported hundreds of false parse errors
// across stdlib modules that use `s[i..j]` (url, path, regex, ...). This test
// pins the self-hosted frontend to the same behavior as the Rust VM, all four
// bound forms, on both strings and arrays.

let fe = import("stdlib/compiler/selfhost_frontend.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }

// native (Rust VM) reference values
let arr = [10, 20, 30, 40, 50];
let s = "hello world";

let src = ""
    + "let arr = [10, 20, 30, 40, 50];\n"
    + "let s = \"hello world\";\n"
    + "let a = arr[1..3];\n"       // [20, 30]
    + "let b = arr[2..];\n"        // [30, 40, 50]
    + "let c = arr[..2];\n"        // [10, 20]
    + "let d = arr[..];\n"         // full copy
    + "let e = s[0..5];\n"         // "hello"
    + "let f = s[6..];\n"          // "world"
    + "let g = arr[len(arr) - 2 .. len(arr)];\n";  // expression bounds -> [40, 50]

let r = fe.frontend_run(src);
truthy(r.ok, "self-hosted parser now accepts range-slice sugar");

eq(r.globals["a"], arr[1..3], "arr[1..3] agrees with Rust VM");
eq(r.globals["b"], arr[2..], "arr[2..] agrees");
eq(r.globals["c"], arr[..2], "arr[..2] agrees");
eq(r.globals["d"], arr[..], "arr[..] full copy agrees");
eq(r.globals["e"], s[0..5], "string slice agrees");
eq(r.globals["f"], s[6..], "open-ended string slice agrees");
eq(r.globals["g"], arr[len(arr) - 2 .. len(arr)], "expression bounds agree");

// concrete sanity
eq(r.globals["a"], [20, 30], "a = [20, 30]");
eq(r.globals["e"], "hello", "e = hello");
eq(r.globals["f"], "world", "f = world");

print "selfhost_slice_pass";
