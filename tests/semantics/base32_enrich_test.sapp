// tests/semantics/base32_enrich_test.sapp — enrichment for stdlib/base32.sapp
//
// base32.sapp was a correct RFC 4648 standard-alphabet codec. This adds the
// base32hex variant (RFC 4648 §7), unpadded encoding, and validation.

let b32 = import("stdlib/base32.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base behavior unchanged ──────────────────────────────────────────────────────
eq(b32.encode("foobar"), "MZXW6YTBOI======", "standard encode");
eq(b32.decode("MY======"), "f", "standard decode");
eq(b32.decode(b32.encode("Hello, World!")), "Hello, World!", "round-trip");

// ── ENRICH: base32hex variant (RFC 4648 §7) round-trips ──────────────────────────
eq(b32.decode_hex(b32.encode_hex("foobar")), "foobar", "base32hex round-trip");
// base32hex uses the 0-9A-V alphabet -> different output from standard base32
if b32.encode_hex("foobar") == b32.encode("foobar") { fail("base32hex must differ from standard"); }

// ── ENRICH: unpadded encoding ────────────────────────────────────────────────────
eq(b32.encode_nopad("foobar"), "MZXW6YTBOI", "encode_nopad drops '='");
eq(b32.decode("MZXW6YTBOI"), "foobar", "decode tolerates missing padding");

// ── ENRICH: validation ───────────────────────────────────────────────────────────
eq(b32.is_valid("MZXW6YTBOI======"), true, "is_valid true");
eq(b32.is_valid("mzxw6ytboi"), true, "is_valid lowercase ok");
eq(b32.is_valid("0189!!!"), false, "is_valid rejects out-of-alphabet chars");

print "base32_enrich_pass";
