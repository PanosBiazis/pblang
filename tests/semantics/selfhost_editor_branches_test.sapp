let F=import("stdlib:compiler/selfhost_frontend.sapp");
fn warnings(source) {
    let report=F.frontend_lint(source); let count=0;
    for row in report.diagnostics {
        assert(row.kind!="error","valid branch fixture has no semantic errors");
        if row.message=="unreachable code after return/break/continue" { count=count+1; }
    }
    return count;
}
let branch="fn choose(n) { if n==0 {return 0;} elif n==1 {return 1; print 99;} else {return 2;} }";
assert(warnings(branch)==1,"elif dead code is visited");
assert(warnings(str_replace_all(branch,"elif","else if"))==1,"else-if spelling is equivalent");
assert(warnings("fn f() {return 1; return 2; print 3; return 4;}")==1,"one warning for one dead region");
assert(warnings("fn f(n) {if n==0 {return 0;} elif n==1 {return 1;} print n;}")==0,"branch termination does not terminate enclosing block");
fn undefined(source,name) {
    let report=F.frontend_lint(source);
    for row in report.diagnostics {
        if (try row.code catch "")=="undefined-name" and (try row.name catch "")==name { return true; }
    }
    return false;
}
assert(undefined("let c=false; let n=3; let r=if true {1} elif c {n} else {missing_tail}; print r;","missing_tail"),
    "nested final arm name is analyzed");
assert(undefined("let r=if false {let local=1; local} elif false {local} else {2}; print r;","local"),
    "sibling branches cannot share local declarations");
assert(F.frontend_lint("let n=8; let r=if false {1} elif false {2} elif true {n} else {3}; print r;").ok,
    "valid nested branch reference remains accepted");
print "selfhost_editor_branches_pass";
