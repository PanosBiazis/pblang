let C = import("stdlib:module_audit_contract.sapp");
let T = import("stdlib:project_text_audit.sapp");
fn expect(ok, label) { if not ok { throw "FAIL module-bounds: " + label; } }
let fields = [["max_files_per_module", 10000, 1, 100000], ["max_file_bytes", 1048576, 1000, 16777216],
    ["max_depth", 32, 0, 32], ["max_entries_per_module", 50000, 1, 50000],
    ["max_children_per_dir", 4096, 1, 4096], ["max_runtime_ms_per_module", 300000, 10, 300000],
    ["max_findings_per_file", 256, 1, 4096], ["max_finding_index", 20000, 1, 100000],
    ["max_findings_per_module_index", 20000, 1, 100000], ["max_suppressed_per_module_index", 1000, 1, 10000]];
let invalid = [nil, true, false, "private-bound-marker", [], map{}, fn() { return 1; },
    bigint(1), rational("1/1"), decimal("1"), parse_number("NaN"), parse_number("inf"), parse_number("-inf"), -1, 1.5, 9007199254740992];
let root = "private-root-marker";
let module = map{format: "pblang.module_audit.module.v1", root: root, complete: true,
    files_scanned: 1, finding_count: 0, suppressed_count: 0, encoding_degraded_files: 0,
    finding_index_truncated: false, findings: [], counts_kind: map{}, counts_severity: map{},
    counts_role: map{}, counts_role_severity: map{}, counts_role_kind_severity: map{}, snapshot_sha256: "fixture"};
let producer_error = json_stringify(map{ok: false, complete: false, format: "pblang.module_audit.v1", error: "invalid module audit bounds"});
let snapshot_error = json_stringify(map{ok: false, stable: false, error: "invalid module snapshot"});
let i = 0;
for field in fields {
    for value in invalid {
        let options = map{}; options[field[0]] = value;
        expect(C.bounds_error(options) == "invalid module audit bounds", "numeric domain rejected");
        expect(json_stringify(T.audit_modules("fixture", [root], options)) == producer_error, "fixed preflight result without source values or partial modules");
        if i < 6 {
            expect(C.bounds_error(options, true) != "", "snapshot consumed domain rejected");
            expect(json_stringify(T.verify_module_snapshot(module, options)) == snapshot_error, "snapshot fixed error before filesystem work");
        } else { expect(C.bounds_error(options, true) == "", "snapshot ignores scan-only budgets"); }
    }
    for value in [field[2] - 1, field[3] + 1] {
        let options = map{}; options[field[0]] = value;
        expect(C.bounds_error(options) != "", "outside inclusive bounds rejected");
    }
    for value in [field[1], field[2], field[3]] {
        let options = map{}; options[field[0]] = value; let before = json_stringify(options);
        expect(C.bounds_error(options) == "" and C.bounds_error(options, true) == "", "default and endpoints admitted without executing maximum workloads");
        expect(json_stringify(options) == before, "validation does not mutate options");
    }
    i = i + 1;
}
for options in [nil, map{}, map{unrelated: "kept", source_only_blockers: true}] {
    expect(C.bounds_error(options) == "" and C.bounds_error(options, true) == "", "whole nil and omission defaults and unrelated fields preserved");
}
for options in [false, 1, "private-options-marker", [], fn() { return 1; }] {
    expect(C.bounds_error(options) != "", "options must be a map");
    expect(json_stringify(T.audit_modules("fixture", [root], options)) == producer_error, "producer rejects nonmap options");
    expect(json_stringify(T.verify_module_snapshot(module, options)) == snapshot_error, "snapshot rejects nonmap options");
}
expect(C.bounds_error(map{}, "false") != "", "snapshot selector exact bool");
let changed = map{max_depth: 1}; expect(C.bounds_error(changed) == "", "initial mutable options");
changed.max_depth = nil; expect(C.bounds_error(changed) != "", "mutable options revalidated");
expect(T.audit_modules("fixture", [], changed).error == "roots must contain 1..256 modules", "outer roots precedence");
expect(T.audit_modules("fixture", [root], map{max_files_per_module: 1.5, max_high: "bad"}).error == "invalid module audit bounds", "numeric precedence over gate policy");
expect(T.module_audit_engine_revision() == "pblang.module-audit.engine.v8", "valid checkpoint identity preserved");
let valid = T.audit_modules("fixture", ["tests/fixtures/module_audit/tools"], map{
    max_files_per_module: 1, max_file_bytes: 1000, max_finding_index: 1,
    max_findings_per_module_index: 1, max_suppressed_per_module_index: 1});
expect(valid.ok and valid.complete and valid.files_scanned == 1, "valid low bounds reach bounded scan");
let snapshot = T.verify_module_snapshot(valid.modules[0], map{max_files_per_module: 1, max_file_bytes: 1000,
    max_findings_per_file: nil, max_finding_index: "unused"});
expect(snapshot.ok and snapshot.stable and snapshot.files_checked == 1, "valid snapshot ignores scan-only fields end-to-end");
print "module_audit_bounds_pass";
