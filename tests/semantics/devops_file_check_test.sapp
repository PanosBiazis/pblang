let Check=import("stdlib:devops_file_check.sapp");
fn args(path) { return ["run","tools/pbopscheck.sapp","--allow-all","--",path]; }
fn bad(value) {
    let result=Check.parse_argv(value);
    assert(len(result)==2 and not result.ok and result.path==nil,"invalid framing keeps no path");
}
for path in ["pipeline.json","./file with spaces.json","-file.json","pipeline","δοκιμή.json"] {
    let result=Check.parse_argv(args(path));
    assert(result.ok and result.path==path,"one exact path, no trimming or extension guessing");
}
assert(Check.parse_argv(["run","/opt/project/tools/pbopscheck.sapp","--allow-all","--","a"]).ok,"absolute tool identity");
for value in [nil,"private_marker",[],[1,2,3,4,5],
    ["run","tools/pbopscheck.sapp","--allow-all","a"],
    ["run","tools/pbopscheck.sapp","--allow-all","--","a","b"],
    ["run","tools/pbopscheck.sapp","--allow-all","--","--","a"],
    ["run","tools/pbopscheck.sapp","--allow-net","--","a"],
    ["run","tools/other.sapp","--allow-all","--","a"],
    ["run","tools/pbopscheck.sapp","--allow-all","a","--"],
    ["eval","tools/pbopscheck.sapp","--allow-all","--","a"]] { bad(value); }
for path in [nil,42,[],map{},"",".","..","dir/","dir\\","dir/.."] {
    bad(args(path));
    let result=Check.check_file(path);
    assert(result.status=="invalid_arguments" and result.exit_code==2 and len(result)==14
        and not result.read_attempted and not result.file_read_claimed and result.report==nil,
        "invalid direct path rejected before read");
}
for cp in [0,10,31,127,159,1564,8206,8207,8232,8238,8294,8303,65279] {
    let control=strfromcharcode(cp);
    bad(args("a"+control+".json"));
    bad(["run","prefix"+control+"/tools/pbopscheck.sapp","--allow-all","--","a"]);
}
assert(Check.parse_argv(args(str_repeat("a",4096))).ok,"4096 bytes accepted by framing, not filesystem proof");
bad(args(str_repeat("a",4097)));
assert(Check.parse_argv(args(str_repeat("é",2048))).ok,"4096 UTF8 bytes");
bad(args(str_repeat("é",2048)+"a"));
print "devops_file_check_pass";
