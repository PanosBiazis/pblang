// tests/semantics/config_stdlib_test.sapp
let config = import("stdlib:config.sapp");
let validate = import("stdlib:validate.sapp");

// Basic create/set/get
let cfg = config.new();
config.set(cfg, "host", "localhost");
config.set(cfg, "port", "8080");

let h = config.get(cfg, "host", "default");
if h != "localhost" { throw "FAIL get host: expected localhost got " + str(h); }

let p = config.get(cfg, "port", "3000");
if p != "8080" { throw "FAIL get port: expected 8080 got " + str(p); }

// Fallback
let missing = config.get(cfg, "nonexistent", "fallback_val");
if missing != "fallback_val" { throw "FAIL get fallback"; }

// Typed getters
let port_num = config.get_int(cfg, "port", 3000);
if port_num != 8080 { throw "FAIL get_int: expected 8080 got " + str(port_num); }

// Defaults
config.set_default(cfg, "debug", "false");
let dbg = config.get_bool(cfg, "debug", true);
if dbg != false { throw "FAIL get_bool false"; }

config.set(cfg, "active", "true");
let act = config.get_bool(cfg, "active", false);
if act != true { throw "FAIL get_bool true"; }

// List getter
config.set(cfg, "tags", "web,api,v2");
let tags = config.get_list(cfg, "tags", ",", []);
if len(tags) != 3 { throw "FAIL get_list len: expected 3 got " + str(len(tags)); }
if tags[0] != "web" { throw "FAIL get_list values"; }

// Merge
config.merge(cfg, map{ extra: "123", flag: "on" });
let extra = config.get(cfg, "extra", nil);
if extra != "123" { throw "FAIL merge extra"; }

// to_map includes defaults and data
let m = config.to_map(cfg);
if map_has(m, "host") == false { throw "FAIL to_map host"; }
if map_has(m, "debug") == false { throw "FAIL to_map debug (default)"; }

// Bulk construction/defaults and key helpers
let cfg2 = config.from_map(map{ port: 8080, debug: "yes", ratio: "0.5", tags: " a, b ,c " }, map{ host: "127.0.0.1", mode: "dev" });
if config.get(cfg2, "host", nil) != "127.0.0.1" { throw "FAIL from_map default"; }
if config.get_bool(cfg2, "debug", false) != true { throw "FAIL get_bool yes"; }
if config.get_float(cfg2, "ratio", 0) != 0.5 { throw "FAIL get_float"; }
let tags2 = config.get_list(cfg2, "tags", ",", []);
if len(tags2) != 3 or tags2[0] != "a" or tags2[1] != "b" or tags2[2] != "c" { throw "FAIL get_list trim"; }
if config.has(cfg2, "mode") != true { throw "FAIL has default"; }
config.unset(cfg2, "port");
if config.has(cfg2, "port") != false { throw "FAIL unset"; }
config.set_many(cfg2, map{ port: 9090, workers: 4 });
config.set_defaults(cfg2, map{ retries: 3 });
if len(config.keys(cfg2)) < 6 { throw "FAIL keys"; }

// Integer getter rejects fractional values.
config.set(cfg2, "bad_int", "3.14");
if config.get_int(cfg2, "bad_int", 7) != 7 { throw "FAIL get_int fractional fallback"; }
if config.require_int(cfg2, "workers") != 4 { throw "FAIL require_int"; }
if config.require_bool(cfg2, "debug") != true { throw "FAIL require_bool"; }

// Schema bridge produces typed values before validation.
let schema = validate.schema(map{
    port: map{ type: "number", min: 1, max: 9999, required: true },
    debug: map{ type: "bool" },
    tags: map{ type: "array", items: map{ type: "string", min: 1 } },
    mode: map{ type: "string", enum: ["dev", "prod"], default: "prod" }
}, map{ strict: false });
let typed = config.typed_map(cfg2, schema);
if typed.port != 9090 or typed.debug != true or len(typed.tags) != 3 { throw "FAIL typed_map"; }
let cr = config.validate(cfg2, schema);
if cr.ok != true { throw "FAIL config.validate: " + validate.explain(cr); }

let cfg3 = config.from_map(map{ port: "10000" }, map{});
let bad = config.validate(cfg3, schema);
if bad.ok != false { throw "FAIL config.validate bad"; }

let cfg4 = config.from_map(map{ port: 1234 }, map{});
let with_defaults = config.validate_with_defaults(cfg4, schema);
if with_defaults.ok != true or with_defaults.value.mode != "prod" { throw "FAIL validate_with_defaults"; }

print "config_stdlib_pass";
