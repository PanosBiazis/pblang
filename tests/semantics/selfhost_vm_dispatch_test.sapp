// Raw VM callers retain numeric opcode equality, mutation ordering and tick
// accounting when dispatch is grouped. Serialized readers reject malformed IR.
let V=import("stdlib/compiler/vm.sapp");
fn inst(op,arg){return map{op:op,operand:arg};}
fn rt(options){
    let r=V.runtime_limits(options);
    r.steps=0;r.peak_frames=0;r.peak_stack=0;r.peak_locals=0;r.peak_output=0;
    r.tripped=false;r.reason="";return r;
}
fn converted(op,kind){
    if kind==1 {return bigint(op);}
    if kind==2 {return decimal(op);}
    if kind==3 {return rational(op);}
    return op;
}
fn program(kind){
    let instructions=[];
    // Store/read an upvalue cell, then add and return across dispatch groups.
    for pair in [[38,0],[0,0],[0,1],[28,0],[38,0],[0,0],[27,0],[0,1],[1,0],[19,0]] {
        array_push(instructions,inst(converted(pair[0],kind),pair[1]));
    }
    return map{instructions:instructions,constants:[0,7]};
}
for kind 4 {
    let cell=[2];let r=rt(map{});let e=V.execution_context();
    let value=V.exec(program(kind),[],map{},[],[cell],r,0,e);
    V.close_execution(e);
    assert(value==14 and cell==[7],"numeric opcode compatibility");
    assert(r.steps==10 and r.peak_stack==3 and r.peak_frames==1,"unchanged accounting");
}
// Limit refusal occurs before mutation, even when the setter is dispatched early.
let cell=[2];let r=rt(map{max_stack:2});let e=V.execution_context();
let failed=try {V.exec(program(0),[],map{},[],[cell],r,0,e);false;} catch true;
V.close_execution(e);
assert(failed and cell==[2] and r.steps==4 and r.reason=="stack limit exceeded","refuse before mutation");
// Non-numeric/unknown raw opcodes were no-ops; grouping must not compare them
// numerically or reinterpret a string spelling as an instruction.
for op in [nil,true,false,"38",map{},[],43,0-1,18.5,decimal("38.5")] {
    let c=map{constants:[9],instructions:[inst(op,0),inst(0,0),inst(19,0)]};
    let result=V.run_bounded(c);
    assert(result.value==9 and result.runtime.steps==3,"legacy unknown opcode behavior");
}
// SET_UPVALUE remains a raw slot write; it does not implicitly box a scalar.
let up=[1];e=V.execution_context();
let c=map{constants:[8],instructions:[inst(0,0),inst(39,0),inst(38,0),inst(19,0)]};
assert(V.exec(c,[],map{},[],up,nil,0,e)==8 and up==[8],"legacy upvalue setter");
V.close_execution(e);
print "selfhost_vm_dispatch_pass";
