// tests/semantics/circuits_test.sapp — digital logic + analog electrical circuits, plus
// a lightweight single-qubit gate toy. (Full multi-qubit simulation lives in quantum.sapp.)

let C = import("stdlib/circuits.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── digital logic gates ───────────────────────────────────────────────────────────
eq(C.gate_and(1, 1), 1, "and"); eq(C.gate_and(1, 0), 0, "and0");
eq(C.gate_or(0, 0), 0, "or0"); eq(C.gate_or(1, 0), 1, "or1");
eq(C.gate_not(0), 1, "not"); eq(C.gate_xor(1, 1), 0, "xor same"); eq(C.gate_xor(1, 0), 1, "xor diff");
eq(C.gate_nand(1, 1), 0, "nand"); eq(C.gate_nor(0, 0), 1, "nor"); eq(C.gate_xnor(1, 1), 1, "xnor");
eq(C.mux2(0, 7, 9), 7, "mux sel0"); eq(C.mux2(1, 7, 9), 9, "mux sel1");

// ── adders ────────────────────────────────────────────────────────────────────────
let ha = C.half_adder(1, 1);
eq(ha.sum, 0, "half adder sum"); eq(ha.carry, 1, "half adder carry");
let fa = C.full_adder(1, 1, 1);
eq(fa.sum, 1, "full adder sum"); eq(fa.carry, 1, "full adder carry");
// 5 (101) + 1 (001) = 6 (110), LSB-first lists
let r = C.ripple_add([1, 0, 1], [1, 0, 0]);
eq(r.bits[0], 0, "ripple b0"); eq(r.bits[1], 1, "ripple b1"); eq(r.bits[2], 1, "ripple b2"); eq(r.carry, 0, "ripple carry");

// ── analog electrical ───────────────────────────────────────────────────────────────
eq(C.series_resistance([10, 20, 30]), 60, "series R");
approx(C.parallel_resistance([10, 10]), 5, "parallel R");
approx(C.voltage_divider(10, 1, 1), 5, "voltage divider");
approx(C.ohm_current(10, 2), 5, "ohm current"); approx(C.ohm_voltage(5, 2), 10, "ohm voltage");
approx(C.ohm_power(10, 2), 20, "ohm power");
approx(C.rc_tau(1000, 0.000001), 0.001, "RC time constant");
eq(C.cap_parallel([1, 2, 3]), 6, "caps in parallel add");
approx(C.cap_series([2, 2]), 1, "caps in series");

// ── single-qubit gate toy (real amplitudes) ───────────────────────────────────────
let s = C.qstate0();
eq(s[0], 1, "|0> amplitude"); eq(s[1], 0, "|0> amplitude");
let xs = C.q_x(s);
eq(xs[0], 0, "X flips"); eq(xs[1], 1, "X flips");
let hs = C.q_h(s);
approx(hs[0], 0.70710678, "H -> 1/sqrt2"); approx(hs[1], 0.70710678, "H -> 1/sqrt2");
let pr = C.q_prob([0.6, 0.8]);
approx(pr.p0, 0.36, "P(0)=a^2"); approx(pr.p1, 0.64, "P(1)=b^2");

print "circuits_pass";
