// tests/semantics/net_enrich_test.sapp — enrichment for stdlib/net.sapp
//
// net.sapp was a 13-line re-export of the TCP builtins. This adds address helpers
// (parse_addr / host_port, IPv6-aware), high-level read helpers (read_n/read_all/
// read_line), generic accept loops (serve/serve_once/with_listener), and re-exports
// the TLS builtins — all built on the existing tcp_* primitives.

let net = import("stdlib/net.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── parse_addr: host:port, IPv6, and port-less forms ────────────────────────────
let a = net.parse_addr("example.com:8080");
eq(a.host, "example.com", "host"); eq(a.port, 8080, "port");
let v = net.parse_addr("[::1]:9000");
eq(v.host, "[::1]", "ipv6 host keeps brackets"); eq(v.port, 9000, "ipv6 port");
let h = net.parse_addr("host");
eq(h.host, "host", "host only"); eq(h.port, nil, "no port -> nil");
let v2 = net.parse_addr("[2001:db8::1]");
eq(v2.host, "[2001:db8::1]", "ipv6 no port host"); eq(v2.port, nil, "ipv6 no port");
let bad = net.parse_addr("host:notaport");
eq(bad.port, nil, "non-numeric port -> nil (no crash)");

// ── host_port: brackets a bare IPv6, omits nil port ─────────────────────────────
eq(net.host_port("h", 80), "h:80", "host:port");
eq(net.host_port("::1", 80), "[::1]:80", "bare ipv6 gets bracketed");
eq(net.host_port("[::1]", 80), "[::1]:80", "already-bracketed ipv6 unchanged");
eq(net.host_port("h", nil), "h", "nil port -> host only");

// ── read_n edge: n<=0 returns "" without touching the handle ─────────────────────
eq(net.read_n(nil, 0), "", "read_n(0) -> empty, no read");
eq(net.read_n(nil, 0 - 5), "", "read_n(negative) -> empty");

// ── the new helpers and re-exports are present ──────────────────────────────────
fn is_fn(v) { return type(v) == "fn" or type(v) == "closure" or type(v) == "builtin"; }
if not is_fn(net.read_all) { fail("read_all exported"); }
if not is_fn(net.read_line) { fail("read_line exported"); }
if not is_fn(net.serve) { fail("serve exported"); }
if not is_fn(net.serve_once) { fail("serve_once exported"); }
if not is_fn(net.with_listener) { fail("with_listener exported"); }
// existing TCP re-exports still there
if not is_fn(net.tcp_listen) { fail("tcp_listen still exported"); }
if not is_fn(net.tcp_accept) { fail("tcp_accept still exported"); }
// TLS builtins now re-exported too
if not is_fn(net.tcp_connect_tls) { fail("tcp_connect_tls re-exported"); }
if not is_fn(net.tcp_listen_tls) { fail("tcp_listen_tls re-exported"); }

print "net_enrich_pass";
