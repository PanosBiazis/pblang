// Test: PBP — pblang's own secure protocol (stdlib/pbp.sapp), §89.
//
// Compact framing + built-in authenticated encryption + replay-protected sessions.
// Runs in the VM (the codec/session/security path is complete; a live TCP client needs
// a plain tcp_connect builtin — see docs/Protocols.md).

let p = import("stdlib/pbp.sapp");

// frame codec round-trips
let fr = p.encode_frame("DATA", 5, "hello-payload");
let d = p.decode_frame(fr);
assert(d.magic == "PBP1" and d.type == "DATA" and d.seq == 5, "frame header decodes");
assert(d.payload == "hello-payload", "frame payload decodes (length-prefixed)");
assert(p.decode_frame("not a pbp frame") == nil, "malformed frame rejected");

// a full secure exchange between two sessions over a shared key
let key = "shared-pbp-key";
let cs = p.session_new(key);
let ss = p.session_new(key);
let f1 = p.seal_frame(cs, "DATA", "GET /status");
assert(p.open_frame(ss, f1) == "GET /status", "server opens the sealed client frame");
let f2 = p.seal_frame(ss, "DATA", "200 OK");
assert(p.open_frame(cs, f2) == "200 OK", "client opens the sealed server reply");

// replay protection: re-delivering an earlier frame is rejected
assert(p.open_frame(ss, f1) == nil, "replayed frame rejected (sequence not increasing)");

// the payload is encrypted on the wire
assert(not str_contains(f1, "GET /status"), "frame payload is encrypted (not plaintext)");

// efficiency: PBP framing overhead is much smaller than the HTTP equivalent
let pbp = p.frame_overhead("DATA", 3, 64);
let http = p.http_overhead_estimate(64);
assert(pbp < http, "PBP framing overhead < HTTP");
assert(pbp * 4 < http, "PBP framing overhead is several times leaner than HTTP");

print "pbp_pass";
