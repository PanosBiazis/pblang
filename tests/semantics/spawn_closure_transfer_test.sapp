// Verify spawn/join can transfer closures/functions through wire format.

let runner_factory = fn(mult) {
    let worker_fn = fn(x) { return x * mult; };
    return fn() {
        return worker_fn(7);
    };
};

let run_worker = runner_factory(3);
let h1 = spawn(run_worker);
let v1 = join(h1);
if v1 != 21 {
    throw "FAIL spawn closure capture";
}

let make_adder = fn() {
    return fn(x) { return x + 5; };
};

let h2 = spawn(make_adder);
let add5 = join(h2);
let v2 = add5(10);
if v2 != 15 {
    throw "FAIL spawn returned closure";
}

print "spawn_closure_transfer_pass";
