// tests/semantics/pbai_calibration_test.sapp — calibration_report(examples): does the
// ensemble's stated confidence match its real accuracy? A well-calibrated model that says
// "80%" is right ~80% of the time. Returns the Brier score (lower = better; 0 = perfect)
// and confidence-vs-accuracy bins. This is the standard way to judge whether an MLLM's
// confidence is trustworthy, not just whether its top pick is right.

let ens = import("stdlib/pbai_ensemble.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// A perfectly confident + perfectly correct native model: confidence 1.0, always right.
let scores = fn(p) { return map{ intent: "bugs", scores: [0, 1, 0, 0, 0] }; };
ens.configure(scores, ["explain", "bugs", "improve", "comment", "general"]);
ens.clear_voters();
ens.reset_stats();
ens.set_adaptive(false);
ens.set_routing(false);
ens.set_parallel(false);
ens.set_fusion("hard");

// all labeled "bugs" -> model always right AND always confident -> Brier 0
let allbugs = [ map{ prompt: "a", intent: "bugs" }, map{ prompt: "b", intent: "bugs" },
                map{ prompt: "c", intent: "bugs" }, map{ prompt: "d", intent: "bugs" } ];
let c1 = ens.calibration_report(allbugs);
eq(c1.n, 4, "counted all examples");
eq(c1.accuracy, 1, "always right");
approx(c1.mean_confidence, 1, "always fully confident");
approx(c1.brier, 0, "perfectly calibrated + correct -> Brier 0");

// Confident but WRONG: model says "bugs" @1.0 but truth is "explain" -> Brier near worst (1)
let allwrong = [ map{ prompt: "a", intent: "explain" }, map{ prompt: "b", intent: "explain" } ];
let c2 = ens.calibration_report(allwrong);
eq(c2.accuracy, 0, "always wrong");
approx(c2.brier, 1, "confident-and-wrong -> Brier ~1 (worst)");
// over-confidence gap: says 100% but is 0% right
approx(c2.mean_confidence - c2.accuracy, 1, "large over-confidence gap");

// bins: each entry {lo, hi, n, confidence, accuracy} for occupied confidence ranges
if len(c1.bins) < 1 { fail("calibration bins present"); }
let b = c1.bins[len(c1.bins) - 1];
if b.n <= 0 { fail("top bin populated"); }
approx(b.accuracy, 1, "top-confidence bin is 100% accurate here");

ens.clear_voters();
ens.reset_stats();
print "pbai_calibration_pass";
