// tests/semantics/path_enrich_test.sapp — bug fix + enrichment for stdlib/path.sapp

let P = import("stdlib/path.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn arreq(a, b, m) {
    if len(a) != len(b) { fail(m + " len " + str(a)); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " [" + str(i) + "] " + str(a)); } i = i + 1; }
}

// ── BUG FIX: a leading dot is part of a dotfile name, not an extension ─────────────
eq(P.extension(".bashrc"), "", "dotfile has no extension");
eq(P.extension("foo.txt"), "txt", "normal extension");
eq(P.extension("archive.tar.gz"), "gz", "last extension");
eq(P.extension("foo"), "", "no dot -> no extension");
eq(P.extension("foo."), "", "trailing dot -> empty");

// ── stem: basename without extension ──────────────────────────────────────────────
eq(P.stem("foo.txt"), "foo", "stem");
eq(P.stem("a.tar.gz"), "a.tar", "stem keeps inner dots");
eq(P.stem(".bashrc"), ".bashrc", "dotfile stem unchanged");

// ── with_extension ──────────────────────────────────────────────────────────────────
eq(P.with_extension("foo.txt", "md"), "foo.md", "swap ext");
eq(P.with_extension("foo", "md"), "foo.md", "add ext");

// ── split into components ──────────────────────────────────────────────────────────
arreq(P.split("/a/b/c"), ["a", "b", "c"], "split absolute");
arreq(P.split("a/b"), ["a", "b"], "split relative");

// ── is_absolute ─────────────────────────────────────────────────────────────────────
if not P.is_absolute("/etc/hosts") { fail("/ is absolute"); }
if P.is_absolute("rel/path") { fail("relative is not absolute"); }

// ── normalize: resolve . and .. lexically ─────────────────────────────────────────
eq(P.normalize("/a/b/../c"), "/a/c", "normalize ..");
eq(P.normalize("a/./b"), "a/b", "normalize .");
eq(P.normalize("/a/../.."), "/", "normalize .. at root");

// ── parent (alias of dirname) ──────────────────────────────────────────────────────
eq(P.parent("/a/b/c"), P.dirname("/a/b/c"), "parent == dirname");

print "path_enrich_pass";
