let A = import("stdlib:source_analysis.sapp");

fn fail(message) { throw "FAIL source_analysis: " + message; }
fn require(value, message) { if value != true { fail(message); } }

let source = "// TODO: replace temporary branch\nlet strategy = \"slow path\";\nlet endpoint = \"http://example.test\";";
let security = A.analyze(source, "sample.sapp", map{
    analyses: ["security"], security: map{ minimum_blocking_severity: "high" }
});
require(security.ok and security.passed and security.finding_count >= 1,
    "selective security analysis reports without unrelated categories");

let performance = A.analyze(source, "sample.sapp", map{ analyses: ["performance"] });
require(performance.ok and performance.finding_count == 1 and performance.findings[0].analysis == "performance",
    "selective performance analysis");

let all = A.analyze(source, "sample.sapp", map{ analyses: ["all"],
    security: map{ minimum_blocking_severity: "high" } });
require(all.ok and len(all.analyses) == len(A.AVAILABLE) and all.finding_count >= 2,
    "all analysis categories compose into one bounded report");

let invalid = A.analyze(source, "sample.sapp", map{ analyses: ["unknown"] });
require(not invalid.ok and not invalid.passed, "unknown-only selection fails closed");

print "source_analysis_pass";
