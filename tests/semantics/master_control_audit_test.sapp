fn check(value, why) { if not value { throw "audit profile: " + why; } }
let directory = cwd() + "/.master-audit-test-" + str_slice(sha256(str(random_bytes(16))), 0, 20);
check(proc_spawn_wait("/bin/mkdir", ["-m", "0700", "--", directory]).exit_code == 0, "private directory");
let results = [];
for profile in ["events", "detailed", "", "unsupported"] {
    let result = try proc_spawn_wait("/usr/bin/env", ["-i", "PATH=/usr/bin:/bin",
        "PB_MASTER_CONTROL=1", "PB_MASTER_CONTROL_HOME=" + directory,
        "PB_MASTER_CONTROL_AUDIT=" + profile, cwd() + "/target/release/pblang",
        "run", "tests/fixtures/master_control_audit_active.sapp",
        "--allow-fs", "--allow-env", "--allow-import", "--deny-exec", "--deny-net",
        "--deny-http", "--deny-ffi", "--deny-spawn", "--deny-gfx", "--deny-sqlite"
    ]) catch nil;
    array_push(results, map{ profile: profile, result: result });
    try fs_remove(directory + "/.pb_master_control_unlock") catch nil;
    try fs_remove(directory + "/.pb_master_control_audit.log") catch nil;
}
check(proc_spawn_wait("/bin/rmdir", ["--", directory]).exit_code == 0, "cleanup");
for item in results {
    check(item.result != nil, "child failed to start");
    if item.profile == "unsupported" {
        check(item.result.exit_code != 0 and str_contains(item.result.stderr, "unsupported master-control audit profile"),
            "unknown profile was not rejected explicitly");
    }
    else { check(item.result.exit_code == 0 and str_contains(item.result.stdout, "master_control_audit_pass"),
        "isolated audit fixture failed: " + str(item.result.stderr)); }
}
print "master_control_audit_profiles_pass";
