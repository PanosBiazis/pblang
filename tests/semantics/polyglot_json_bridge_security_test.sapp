let REG = import("stdlib:polyglot_registry.sapp");

fn require(condition, message) {
    if not condition { throw "FAIL polyglot JSON bridge: " + message; }
}
fn rejected(result) { return not result.ok and not result.executed; }

let TRUSTED = map{ trusted_source: true };
require(rejected(REG.json_bridge("python", "__result__ = input_data", "null")),
    "JSON execution requires an explicit trust decision");
require(rejected(REG.json_bridge("python", "__result__ = input_data", "null",
    map{ trusted_source: false })), "false trust is rejected");
require(rejected(REG.json_bridge("python", "__result__ = input_data", "null",
    map{ trusted_source: "yes" })), "string trust is rejected");
require(rejected(REG.json_bridge("python", "__result__ = input_data", "null",
    map{ trusted_source: 1 })), "numeric trust is rejected");

let marker = "''');open('/tmp/pblang-json-bridge-injection','w').write('bad')#";
let hostile_json = json_stringify(map{ payload: marker, quote: "\\\"", line: "a\nb" });
let python = REG.prepare_json_bridge("python", "__result__ = input_data", hostile_json);
require(python.ok and python.transport == "stdin" and not python.input_embedded_in_source,
    "Python bridge must use stdin data transport");
require(not str_contains(python.wrapper, marker),
    "caller JSON must never appear in generated Python source");

let javascript = REG.prepare_json_bridge("js", "const __result__ = input_data;", hostile_json);
require(javascript.ok and javascript.language == "javascript"
    and not str_contains(javascript.wrapper, marker),
    "JavaScript aliases must use the same non-interpolating wrapper");

let ruby = REG.prepare_json_bridge("ruby", "__result__ = input_data", hostile_json);
require(ruby.ok and not str_contains(ruby.wrapper, marker),
    "Ruby bridge must not interpolate caller JSON");

let malformed = REG.prepare_json_bridge("python", "__result__ = input_data", "{broken");
require(rejected(malformed),
    "malformed JSON must fail before foreign execution");
let authorized_malformed = REG.json_bridge("python", "__result__ = input_data", "{broken",
    TRUSTED);
require(rejected(authorized_malformed) and authorized_malformed.trusted_source_acknowledged
    and not authorized_malformed.trusted_source_authorized
    and authorized_malformed.trust_is_acknowledgement,
    "JSON bridge records caller acknowledgement without claiming runtime authority");

let valid_null = REG.prepare_json_bridge("python", "__result__ = input_data", "null");
require(valid_null.ok and not valid_null.executed and valid_null.input_bytes == 4,
    "valid JSON null must not be confused with parse failure");

let oversized = REG.prepare_json_bridge("python", "__result__ = input_data",
    "\"" + str_repeat("x", 1048577) + "\"");
require(rejected(oversized),
    "oversized JSON must fail before foreign execution");

let oversized_code = REG.prepare_json_bridge("python", str_repeat("x", 3585), "null");
require(rejected(oversized_code),
    "registry planner and bounded executor share the same source byte limit");

let unsupported = REG.prepare_json_bridge("bash", "cat", "{}");
require(rejected(unsupported),
    "unsupported JSON bridge languages must fail closed instead of ignoring input");

if REG.is_available("python") {
    let bounded_write = REG.run("python", "print('registry-write-ok')",
        map{ trusted_source: true, timeout_secs: 5 });
    require(bounded_write.ok and bounded_write.bounded
        and bounded_write.executable_descriptor_held
        and str_contains(bounded_write.stdout, "registry-write-ok")
        and bounded_write.trusted_source_acknowledged
        and not bounded_write.trusted_source_authorized,
        "explicit trusted source must execute only through the bounded registry runner");

    try fs_remove("/tmp/pblang-json-bridge-injection") catch nil;
    let roundtrip = REG.json_bridge("python", "__result__ = input_data", hostile_json, TRUSTED);
    require(roundtrip.ok and not fs_exists("/tmp/pblang-json-bridge-injection")
        and roundtrip.trusted_source_acknowledged and not roundtrip.trusted_source_authorized
        and roundtrip.execution_capability_observed,
        "hostile JSON must round-trip without executing injected source");
    let parsed = json_parse(str_trim(roundtrip.output));
    require(parsed.payload == marker and parsed.quote == "\\\"" and parsed.line == "a\nb",
        "JSON values must preserve quotes, slashes, and control characters");
}

if REG.is_available("javascript") {
    let js_roundtrip = REG.json_bridge("javascript", "const __result__ = input_data;", hostile_json,
        TRUSTED);
    require(js_roundtrip.ok and json_parse(str_trim(js_roundtrip.output)).payload == marker,
        "JavaScript planner and executor expose the same input_data contract");
}

print "polyglot_json_bridge_security_pass";
