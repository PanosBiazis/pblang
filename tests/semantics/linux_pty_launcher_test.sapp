let PTY = import("stdlib:linux_pty_supervisor.sapp");
let Process = import("stdlib:process.sapp");

fn require(condition, message) {
    if not condition { throw "FAIL linux_pty_launcher: " + message; }
}

let token = str_trim(fs_read("/proc/sys/kernel/random/uuid"));
let root = "/tmp/pblang-pty-launcher-test-" + token;
let pid = root + "/pid"; let ack = root + "/ack";
let launcher = root + "/launcher";
let ack_writer = root + "/ack-writer";
fs_mkdirs(root);
require(Process.run("/usr/bin/chmod", ["0700", root]).ok,
    "private launcher root");
fs_write_bytes(launcher, PTY.build_session_launcher("/bin/true", pid, ack));
fs_write_bytes(ack_writer, PTY.build_ownership_ack_writer(ack));
require(Process.run("/usr/bin/chmod", ["0700", launcher]).ok,
    "launcher executable mode");
require(Process.run("/usr/bin/chmod", ["0700", ack_writer]).ok,
    "atomic ACK publisher executable mode");
let wait = channel(); let deadline = now_ms() + 3000;
let launched = Process.run(launcher, []);
require(launched.ok, "launcher coordinator returns: " + str(launched));
require(fs_exists(pid), "launcher publishes stopped child PID");
let text = str_trim(fs_read(pid));
require(len(text) == 10 and parse_number(text) > 1,
    "launcher PID record is fixed-width");
require(Process.run(ack_writer, []).ok, "atomic ownership ACK publication");
let child = parse_number(text); deadline = now_ms() + 1000;
require(Process.run("/usr/bin/kill", ["-CONT", "--", "-" + str(child)]).ok,
    "registered process group resumes");
while fs_exists("/proc/" + str(child)) and now_ms() < deadline {
    recv_timeout(wait.receiver, 10);
}
require(not fs_exists("/proc/" + str(child)), "acknowledged child exits");

let timeout_pid = root + "/timeout-pid";
let timeout_ack = root + "/timeout-ack";
let timeout_launcher = root + "/timeout-launcher";
fs_write_bytes(timeout_launcher,
    PTY.build_session_launcher("/bin/true", timeout_pid, timeout_ack));
require(Process.run("/usr/bin/chmod", ["0700", timeout_launcher]).ok,
    "timeout launcher executable mode");
let timeout_started = Process.run(timeout_launcher, []);
require(timeout_started.ok, "timeout launcher coordinator returns");
require(fs_exists(timeout_pid), "timeout launcher publishes stopped child PID");
let timeout_child = parse_number(str_trim(fs_read(timeout_pid)));
deadline = now_ms() + 6000;
while fs_exists("/proc/" + str(timeout_child)) and now_ms() < deadline {
    recv_timeout(wait.receiver, 10);
}
require(not fs_exists("/proc/" + str(timeout_child)), "missing ACK reaps exact child");
require(not fs_exists(timeout_pid) and not fs_exists(timeout_ack),
    "missing ACK removes private handshake records");

let invalid_pid = root + "/invalid-pid";
let invalid_ack = root + "/invalid-ack";
let invalid_launcher = root + "/invalid-launcher";
fs_write_bytes(invalid_launcher,
    PTY.build_session_launcher("/bin/true", invalid_pid, invalid_ack));
require(Process.run("/usr/bin/chmod", ["0700", invalid_launcher]).ok,
    "invalid-ACK launcher executable mode");
require(Process.run(invalid_launcher, []).ok,
    "invalid-ACK launcher coordinator returns");
let invalid_child = parse_number(str_trim(fs_read(invalid_pid)));
fs_write(invalid_ack, "wrong");
deadline = now_ms() + 2000;
while fs_exists("/proc/" + str(invalid_child)) and now_ms() < deadline {
    recv_timeout(wait.receiver, 10);
}
require(not fs_exists("/proc/" + str(invalid_child)),
    "invalid ACK content kills and reaps exact child");
require(not fs_exists(invalid_pid) and not fs_exists(invalid_ack),
    "invalid ACK records are removed");

let typed_pid = root + "/typed-pid";
let typed_ack = root + "/typed-ack";
let typed_launcher = root + "/typed-launcher";
fs_write_bytes(typed_launcher,
    PTY.build_session_launcher("/bin/true", typed_pid, typed_ack));
require(Process.run("/usr/bin/chmod", ["0700", typed_launcher]).ok,
    "wrong-type launcher executable mode");
require(Process.run(typed_launcher, []).ok,
    "wrong-type launcher coordinator returns");
let typed_child = parse_number(str_trim(fs_read(typed_pid)));
fs_mkdirs(typed_ack);
deadline = now_ms() + 2000;
while fs_exists("/proc/" + str(typed_child)) and now_ms() < deadline {
    recv_timeout(wait.receiver, 10);
}
require(not fs_exists("/proc/" + str(typed_child)),
    "wrong ACK file type kills and reaps exact child");
try fs_remove(typed_ack) catch nil; try fs_remove(typed_launcher) catch nil;
try fs_remove(invalid_launcher) catch nil;
try fs_remove(timeout_launcher) catch nil;
try fs_remove(ack_writer) catch nil; try fs_remove(launcher) catch nil;
try fs_remove(root) catch nil;
print "linux_pty_launcher_pass";
