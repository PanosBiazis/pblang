let SCREEN = import("stdlib:screen_capture.sapp");
let IMAGE = import("stdlib:image_pipeline.sapp");

fn require(condition, message) { if not condition { throw "FAIL screen_capture: " + message; } }

let image = [
    [[10, 20, 30, 255], [40, 50, 60, 255], [70, 80, 90, 255], [100, 110, 120, 255]],
    [[1, 2, 3, 255], [4, 5, 6, 255], [7, 8, 9, 255], [10, 11, 12, 255]],
    [[20, 21, 22, 255], [23, 24, 25, 255], [26, 27, 28, 255], [29, 30, 31, 255]],
    [[32, 33, 34, 255], [35, 36, 37, 255], [38, 39, 40, 255], [41, 42, 43, 255]]
];
let sampled = IMAGE.pixel(image, 1, 0);
require(sampled.hex == "#28323C" and sampled.r == 40 and sampled.a == 255,
    "native RGBA pixel sampling");
let annotated = IMAGE.annotate(image, [map{
    text: "", x: 0, y: 0, width: 4, height: 4, color: "red"
}]);
require(annotated.annotation_count == 1 and annotated.image[0][0][0] == 239
    and annotated.image[0][0][1] == 68,
    "native bounded annotation rendering");
let encoded = IMAGE.encode_png(annotated.image);
let decoded = IMAGE.decode_png(encoded);
require(decoded.width == 4 and decoded.height == 4,
    "annotated PNG roundtrip");
require((try { IMAGE.pixel(image, 4, 0); false } catch true),
    "out-of-range pixel fails closed");
require((try { IMAGE.annotate(image, [map{
    text: "x", x: 0, y: 0, width: 0, height: 1
}]); false } catch true), "zero-size annotation fails closed");
require((try { SCREEN.region(0, 0, 0, 1, map{}); false } catch true),
    "zero-size capture region fails before host execution");
require((try { SCREEN.ocr_png(encoded, "eng;touch", map{}); false } catch true),
    "OCR language cannot inject arguments");
let status = SCREEN.status();
require(status.shell_free and status.fixed_executables and status.explicit_environment
    and status.process_group_supervision,
    "screen adapter publishes hardened process contract");

print "screen_capture_pass";
