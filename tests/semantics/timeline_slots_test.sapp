let T=import("stdlib:timeline_document.sapp");let S=import("stdlib:timeline_slots.sapp");let V=import("stdlib:timeline_slots_view.sapp");let UI=import("stdlib:modern_ui.sapp");
let doc=V.sample();let before=T.encode(doc);let result=S.to_timeline(doc,0,600000,60000);assert(len(result.entries)==3 and result.title=="Available time slots" and result.entries[0].label=="Free slot 1","generic labels");assert(result.entries[2].start_ms==300000 and result.entries[2].end_ms==600000,"last free slot");assert(not str_contains(json_stringify(S.find(doc,0,600000,60000)),"Synthetic") and not str_contains(T.encode(result),"Discussion"),"source text omitted");result.entries[0].label="Modified";assert(T.encode(doc)==before,"independent output");
assert(S.to_timeline(doc,0,600000,60000,2).entries[0].label=="Free slot 3","selected slot preserves ordinal");for bad in [-1,3,0.5,"0"]{assert((try S.to_timeline(doc,0,600000,60000,bad) catch nil)==nil,"invalid selected index");}
assert((try S.to_timeline(doc,60000,120000,1) catch nil)==nil,"empty result cannot invent activity");
let big=T.create("Synthetic maximum");big.entries=[];for i in range(0,64){array_push(big.entries,map{label:"Busy",start_ms:i*2+1,end_ms:i*2+2});}assert(len(S.find(big,0,129,1).slots)==65,"all 65 matches reported");assert((try S.to_timeline(big,0,129,1) catch nil)==nil,"cannot silently truncate 65 matches into 64-entry format");assert(S.to_timeline(big,0,129,1,64).entries[0].start_ms==128,"last of 65 individually exportable");
for target in ["native","web","android"]{for view in [V.view(doc,0,600000,60000,2),V.view(doc,60000,120000,1,0),V.view(big,0,129,1,64)]{assert(len(UI.compile(view,map{target:target,width:412,height:915}).records)>0,"portable last/empty/max views");}}
assert((try V.view(doc,0,600000,60000,3) catch nil)==nil,"portable index bound");print "timeline_slots_pass";
