let fsm = import("stdlib:state_machine.sapp");
let machine = fsm.create("idle", map{
    idle: map{ start: "running", reset: "idle" },
    running: map{ pause: "paused", stop: "idle" },
    paused: map{ resume: "running", stop: "idle" }
});
assert(fsm.current(machine) == "idle", "initial state should be idle");
fsm.send(machine, "start");
assert(fsm.current(machine) == "running", "should be running after start");
fsm.send(machine, "pause");
assert(fsm.current(machine) == "paused", "should be paused");
assert(fsm.can(machine, "resume") == true, "should be able to resume");
assert(fsm.can(machine, "start") == false, "should not be able to start from paused");
fsm.send(machine, "resume");
assert(fsm.current(machine) == "running", "should be running after resume");
let hist = fsm.history(machine);
assert(len(hist) == 4, "history should have 4 states: " + str(len(hist)));
let events = fsm.available_events(machine);
assert(len(events) == 2, "running should have 2 available events: " + str(len(events)));
// Invalid transition should error
let err = try fsm.send(machine, "invalid_event") catch "caught";
assert(err == "caught", "invalid transition should error");
print "state_machine_pass";
