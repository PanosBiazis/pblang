let Plot=import("stdlib:ui_scatter_plot.sapp");let Doc=import("stdlib:ui_document.sapp");let Web=import("stdlib:ui_form_web_document.sapp");
fn reject(work){let failed=false;try work() catch {failed=true;};assert(failed,"invalid plot rejected");}
let svg=Plot.render([[1,2],[3,4]],"<script>alert(1)</script>","\"X\"","Y & Z");
assert(not str_contains(svg,"<script>") and str_contains(svg,"&lt;script&gt;"),"escaped caption");
assert(str_contains(svg,"role=\"img\"") and str_contains(svg,"<table") and str_contains(svg,"Point values"),"accessible plot and values");
assert(str_contains(svg,"cx=\"48\"") and str_contains(svg,"cy=\"312\"") and str_contains(svg,"cx=\"612\"") and str_contains(svg,"cy=\"24\""),"extrema geometry");
let flat=Plot.render([[1,1],[1,1]]);assert(str_contains(flat,"cx=\"330\" cy=\"168\""),"degenerate axes centered");
for points in [[],[[1]],[[1,2,3]],[[true,2]],[["bad",2]],[[parse_number("1e13"),0]]] {reject(fn(){Plot.render(points);});}
let many=[];for i 257 {push(many,[i,i]);}reject(fn(){Plot.render(many);});
reject(fn(){Plot.render([[1,2]],str_repeat("x",4097));});
let document=Doc.from_design(map{form:map{title:"Projection",w:800,h:500},model:map{},widgets:[map{name:"Plot",kind:"scatter",x:0,y:0,w:600,h:400,props:map{points:[[1,2],[3,4]],title:"Public title"}}]});
let prepared=Web.prepare(document,map{});document.widgets[0].props.points[0][0]=999;
let page=Web.page(map{schema:prepared.schema,csrf:str_repeat("0",64),revision:0});
assert(str_contains(page,"<svg") and not str_contains(page,">999<"),"cached plot detached from original");
assert(Web.inspect(document).renderable,"canonical plot preflight");
document.widgets[0].web_plot="<script>injected()</script>";
let safe=Web.prepare(document,map{});
assert(not str_contains(Web.page(map{schema:safe.schema,csrf:str_repeat("0",64),revision:0}),"injected()"),"untrusted cached markup discarded");
document.widgets[0].props.visible=false;document.widgets[0].props.title="Hidden fixture data";
let hidden=Web.prepare(document,map{});
assert(not str_contains(Web.page(map{schema:hidden.schema,csrf:str_repeat("0",64),revision:0}),"Hidden fixture data"),"hidden plot not disclosed");
document.widgets[0].props.script="alert(1)";assert(not Web.inspect(document).ok,"unknown active properties rejected");
print "ui_scatter_plot_pass";
