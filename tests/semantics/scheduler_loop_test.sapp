// Local host sleep required. Timing checks use wide margins, not real-time guarantees.
let S = import("stdlib/scheduler.sapp");
fn check(value, label) { if not value { throw "FAIL " + label; } }
S.clear_all();
let hit = map{ n: 0, nested: false };
let timer = S.set_timeout(fn() { hit.n = hit.n + 1; }, 150);
S.pause_timer(timer);
sleep_ms(180);
check(S.run_pending() == 0, "pause prevents execution");
S.resume_timer(timer);
check(S.next_delay() > 50, "remaining delay preserved");
S.run_loop(220);
check(hit.n == 1, "deadline wake fires once");
S.set_immediate(fn() {
    hit.nested = try { S.run_loop(1); false } catch true;
    S.stop();
});
let start = clock() * 1000;
S.run_loop();
check(hit.nested, "nested loop rejected");
check(clock() * 1000 - start < 500, "stop avoids idle sleep");
start = clock() * 1000;
S.run_loop(40);
check(clock() * 1000 - start >= 35, "finite idle loop waits");
check(clock() * 1000 - start < 500, "duration caps idle sleep");
let id = S.set_interval(fn() { hit.n = hit.n + 1; }, 0);
let before = hit.n;
S.run_loop(35);
check(hit.n - before >= 2 and hit.n - before < 15, "zero interval paced");
S.clear_timer(id);
check(S.retained_timers() == 0, "loop cleaned up");
print "scheduler_loop_pass";
