// tests/semantics/vector_enrich_test.sapp — enrichment for stdlib/vector.sapp
// Adds equals_approx, abs, angle, reflect, clamp_norm, manhattan_distance,
// max_component/min_component.

let vec = import("stdlib/vector.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.000001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn veq(a, b, m) { if not vec.equals(a, b) { fail(m + " got=" + vec.to_string(a)); } }

// ── base still works ─────────────────────────────────────────────────────────────
near(vec.norm([3, 4]), 5, "norm"); near(vec.dot([1, 2, 3], [4, 5, 6]), 32, "dot");

// ── ENRICH: equals_approx ────────────────────────────────────────────────────────
if not vec.equals_approx([1, 2], [1.0000001, 2], 0.001) { fail("equals_approx within eps"); }
if vec.equals_approx([1, 2], [1.5, 2], 0.001) { fail("equals_approx outside eps"); }

// ── ENRICH: abs (element-wise) ───────────────────────────────────────────────────
veq(vec.abs([-1, 2, -3]), [1, 2, 3], "abs");

// ── ENRICH: angle (radians) ──────────────────────────────────────────────────────
near(vec.angle([1, 0], [0, 1]), 1.5707963267948966, "angle perpendicular = pi/2");
near(vec.angle([1, 0], [1, 0]), 0, "angle parallel = 0");

// ── ENRICH: reflect ──────────────────────────────────────────────────────────────
veq(vec.reflect([1, -1], [0, 1]), [1, 1], "reflect off horizontal plane");

// ── ENRICH: clamp_norm ───────────────────────────────────────────────────────────
veq(vec.clamp_norm([3, 4], 10), [3, 4], "clamp_norm under limit unchanged");
veq(vec.clamp_norm([6, 8], 5), [3, 4], "clamp_norm scales down to limit");

// ── ENRICH: manhattan_distance + components ──────────────────────────────────────
near(vec.manhattan_distance([0, 0], [3, 4]), 7, "manhattan distance");
near(vec.max_component([1, 5, 3]), 5, "max_component");
near(vec.min_component([1, 5, 3]), 1, "min_component");

print "vector_enrich_pass";
