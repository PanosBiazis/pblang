let AI=import("stdlib/pbai.sapp");
fn near(a,b) {assert(num_abs(a-b)<0.0000001,"numeric oracle");}
fn run(values,period=1,sigma=3,tolerance=1) {
 return AI.sensor_analyze(map{values:values,period_seconds:period,sigma:sigma,absolute_tolerance:tolerance});
}
let caps=AI.sensor_contract();assert(caps.max_samples==256 and not caps.trained_model and not caps.device_access,"bounded diagnostic descriptor");
caps.max_samples=999;assert(AI.sensor_contract().max_samples==256,"descriptor detached");
let linear=run([2,4,6,8],2).value;
near(linear.expected_last,8);near(linear.slope_per_second,1);near(linear.residual_sd,0);
assert(not linear.outlier and linear.baseline_samples==3,"linear series is retained");
let high=run([2,4,6,100]).value;near(high.expected_last,8);near(high.deviation,92);
assert(high.outlier and high.direction=="above","last observation excluded from fit");
assert(run([2,4,6,-100]).value.direction=="below","negative anomaly");
assert(not run([5,5,5,6]).value.outlier and run([5,5,5,6.001]).value.outlier,"strict threshold and zero variance");
let noisy=run([0,1,0,1],1,2,0.5).value;
near(noisy.baseline_mean,1/3);near(noisy.slope_per_second,0);
near(noisy.residual_sd,num_sqrt(2/3));near(noisy.threshold,0.5+2*num_sqrt(2/3));
near(noisy.deviation,2/3);assert(not noisy.confidence_calibrated,"no probability claim");
let down=run([6,4,2,0]).value;near(down.slope_per_second,-2);near(down.expected_last,0);
let many=[];for i 256 {push(many,i*2-200);}
assert(not run(many).value.outlier,"maximum linear window");push(many,0);assert(run(many).status=="error","window limit");
let extremes=[];for i 256 {push(extremes,if i%2==0 {-1000000} else {1000000});}
let edge=run(extremes,86400,10,1000000);
assert(edge.status=="result" and edge.value.threshold<100000000,"bounded extreme values finite");
let zero=len([]);let cycle=[];push(cycle,cycle);let called=false;
let callback=fn(){called=true;return 0;};
for bad in [nil,[],[1,2,3],[1,2,3,"private-marker"],[1,2,3,true],[1,2,3,nil],[1,2,3,callback],cycle,[1,2,3,cycle],[1,2,3,0/zero],[1,2,3,1/zero],[1,2,3,-1/zero],[1,2,3,1000001]] {
 let error=run(bad);assert(error.status=="error" and error.value==nil and error.error=="invalid_request","malformed samples rejected");
 assert(not str_contains(json_stringify(error),"private-marker"),"invalid values not echoed");
}
assert(not called,"input callbacks never invoked");
for bad in [nil,[],map{},map{values:[1,2,3,4]},map{values:[1,2,3,4],period_seconds:1,sigma:3,absolute_tolerance:1,secret:"private-marker"}] {
 assert(AI.sensor_analyze(bad).status=="error","exact request fields");
}
for bad in [0,-1,1.5,86401,true,"1",0/zero,1/zero] {assert(run([1,2,3,4],bad).status=="error","period bounds");}
for bad in [0,10.1,true,nil,0/zero,1/zero] {assert(run([1,2,3,4],1,bad).status=="error","sigma bounds");}
for bad in [0,-1,0.0000001,1000001,true,nil,0/zero,1/zero] {assert(run([1,2,3,4],1,3,bad).status=="error","tolerance bounds");}
assert(run([0,0,0,0],1,1,0.000001).status=="result","inclusive minimum bounds");
let request=map{values:[1,2,3,4],period_seconds:1,sigma:3,absolute_tolerance:1};
let original=json_stringify(request);let result=AI.sensor_analyze(request);
assert(json_stringify(request)==original,"input remains unchanged");
assert(not map_has(result.value,"values") and not result.authorizes_action and not result.external_effects,"no series echo or effects authority");
result.value.expected_last=999;request.values[3]=99;
assert(run([1,2,3,4]).value.expected_last==4,"no retained request or result state");
print "pbai_sensor_pass";
