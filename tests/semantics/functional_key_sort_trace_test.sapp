let New=import("stdlib:functional_sort.sapp");
let Old=import("../../bench/fixtures/functional_sort_before_pairs.sapp");
fn record(call,input,fail_at,invalid) {
    let keys=[];let comparisons=[];
    let project=fn(v){push(keys,v);return v;};
    let compare=fn(a,b){
        push(comparisons,[a,b]);
        if len(comparisons)==fail_at {throw "comparator failure";}
        if invalid {return map{private_marker:"must not become output"};}
        return a-b;
    };
    let result=try map{ok:true,value:call(input,project,compare)} catch map{ok:false};
    return [result,keys,comparisons,input];
}
let pairs=[[Old.stable_sort_by_key,New.stable_sort_by_key],
           [Old.stable_argsort_by_key,New.stable_argsort_by_key]];
for pair in pairs {
    for code 243 {
        let rest=code;let input=[];
        for _i 5 {push(input,rest%3);rest=num_floor(rest/3);}
        let original=slice(input,0,len(input));
        assert(record(pair[0],input,0,false)==record(pair[1],input,0,false),"exact baseline callback and result parity");
        assert(input==original,"source slots unchanged");
    }
    for fail_at in [1,2,3] {
        let before=record(pair[0],[5,4,3,2,1],fail_at,false);
        let after=record(pair[1],[5,4,3,2,1],fail_at,false);
        assert(after==before,"failure trace matches baseline");
        assert(not after[0].ok and after[1]==[5,4,3,2,1] and len(after[2])==fail_at,"all keys then immediate comparator failure");
    }
    let rejected=record(pair[1],[3,2,1],0,true);
    assert(not rejected[0].ok and rejected[1]==[3,2,1] and len(rejected[2])==1,"invalid comparator stops without partial output");
    assert(rejected==record(pair[0],[3,2,1],0,true),"invalid return baseline parity");
}
// Comparator mutation must not expose/reorder private snapshot slots.
fn mutate(call) {
    let source=[3,1,2];let calls=[0];let trace=[];
    let key=fn(v){return [v];};
    let compare=fn(a,b){
        push(trace,[a[0],b[0]]);calls[0]=calls[0]+1;
        if calls[0]==1 {source[0]=99;array_pop(source);push(source,88);}
        return a[0]-b[0];
    };
    let result=call(source,key,compare);
    return [result,source,trace];
}
assert(mutate(New.stable_sort_by_key)==mutate(Old.stable_sort_by_key),"values preserve comparator mutation semantics");
assert(mutate(New.stable_argsort_by_key)==mutate(Old.stable_argsort_by_key),"indices preserve comparator mutation semantics");
assert(mutate(New.stable_sort_by_key)[0]==[1,2,3],"values use original snapshot after comparator mutation");
assert(mutate(New.stable_argsort_by_key)[0]==[1,2,0],"indices use original snapshot after comparator mutation");
print "functional_key_sort_trace_pass cases=486";
