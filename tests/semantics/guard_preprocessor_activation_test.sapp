let GP = import("stdlib:compiler/guard_preprocessor.sapp");
let F = import("stdlib:compiler/selfhost_frontend.sapp");
let VM = import("stdlib:compiler/vm.sapp");
fn expect(value, message) { if not value { throw "FAIL guard_preprocessor_activation: " + message; } }
let native = "let result = match 2 { case 1: \"one\"; case 2: \"two\"; else: \"other\"; };";
for suffix in ["let note = \" ~ \";", "let note = \" # \";", "// ~ in a comment",
    "/* # in a comment */"] {
    expect(GP.preprocess(native + suffix) == native + suffix, "non-code separators leave native match byte-identical");
}
let legacy = "let old = match 1 { case n if n > 0 ~ nil; else: nil; };";
for source in [native + legacy, legacy + native] {
    let processed = GP.preprocess(source);
    expect(str_contains(processed, native), "unrelated native match stays intact");
    expect(not str_contains(processed, " ~ "), "actual legacy match is transformed");
    let compiled = F.frontend_compile(processed);
    expect(compiled.ok, "mixed independent expressions compile");
    let run = VM.run_bounded(compiled.chunk, map{ max_steps: 2000, max_frames: 8 });
    expect(run.globals.result == "two", "native branch selection is preserved");
}
let guarded = "let result = match 2 { case n if n > 1: \"two\"; else: \"other\"; };";
expect(GP.preprocess(guarded + legacy) != guarded + legacy, "legacy sibling still transforms");
expect(str_contains(GP.preprocess(guarded + legacy), guarded), "native guarded expression stays intact");
expect(GP.transform_match("match 2 { case 1: nil; else: nil; }", 0) == nil,
    "direct transform refuses native literal patterns");

// Decline entire expressions with native/mixed arms, unsupported nested syntax,
// comments, keyword prefixes, or missing/mismatched delimiters.
for source in [
    "match 2 { case n: nil; }",
    "match 2 { case n if n > 1: nil; case m if true ~ nil; }",
    "match 2 { case n if true ~ nil; case 2: nil; }",
    "match 2 { case n if true ~ nil; case m: nil; }",
    "match 2 { case n if (n # 1) ~ nil; }",
    "match 2 { case n if call(\" ~ \"): nil; }",
    "match 2 { case n if true /* ~ misleading */ : nil; }",
    "match 2 { /* case n if true ~ nil; } */ case 2: nil; }",
    "match 2 { case n if true ~ (fn() { return nil; })(); }",
    "match 2 { casey n if true ~ nil; }",
    "match 2 { case n if true ~ nil; elsewhere: nil; }",
    "match 2 { case n iffy true ~ nil; }",
    "match 2 { case 1n if true ~ nil; }",
    "match 2 { case true if true ~ nil; }",
    "match 2 { case π if true ~ nil; }",
    "match 2 { case n if (true] ~ nil; }",
    "match 2 { case n if true ~ nil }",
    "match 2 { case n if true ~ nil; else: nil; case m if true ~ nil; }",
    "match 2 { case n if true ~ nil; /* unfinished"
] {
    expect(GP.transform_match(source, 0) == nil, "unsupported transform emits no partial arms");
    expect(GP.preprocess(source) == source, "unsupported expression stays byte-identical");
}
let nested_native = "let result = match 2 { case n if (match n { case 2: true; else: false; }): \"two\"; else: \"other\"; };";
expect(GP.preprocess(nested_native + legacy) == nested_native + GP.preprocess(legacy),
    "nested native matches are not admitted by sibling legacy separators");
for identifier in ["mismatch", "rematch", "πmatch", "matchπ", "matchy"] {
    let source = "let " + identifier + " = 1; " + legacy;
    expect(GP.find_next_match(source, 0) == len("let " + identifier + " = 1; let old = "), "match keyword has full boundaries");
}
let comment = "/* } match 2 { case n if true ~ nil; } */";
expect(GP.find_matching_brace("{ " + comment + " }", 0) == len("{ " + comment + " }") - 1,
    "discovery ignores complete comment braces");
expect(GP.find_next_match("/* match 1 {} ~ ", 0) == -1, "unterminated comment hides keywords");
expect(GP.find_matching_brace("{ /* }", 0) == -1, "unterminated comment hides close brace");
let multi = "let old = match 2 { case n if (n < 0) # nil; case n if ([1,2][1] == n) ~ nil; else: nil; };";
let combined = F.frontend_compile(GP.preprocess(native + multi));
expect(combined.ok, "multiple complete tilde/hash arms with balanced groups compile");
expect(VM.run_bounded(combined.chunk, map{ max_steps: 2000, max_frames: 8 }).globals.result == "two",
    "multiple legacy arms preserve sibling native result");

let at_depth = "match 1 { case n if " + str_repeat("(", 64) + "true" + str_repeat(")", 64) + " ~ nil; }";
expect(GP.transform_match(at_depth, 0) != nil, "64 delimiter levels admitted");
let over_depth = "match 1 { case n if " + str_repeat("(", 65) + "true" + str_repeat(")", 65) + " ~ nil; }";
expect(GP.transform_match(over_depth, 0) == nil, "65 delimiter levels declined");

expect(GP.replace_ident("πn + n + nπ + cafe\u0301n", "n", "value") == "πn + value + nπ + cafe\u0301n",
    "bind substitution does not split Unicode or combining-mark identifiers");
let unicode_guard = "let πn = true; let old = match 1 { case n if πn ~ nil; else: nil; };";
expect(F.frontend_compile(GP.preprocess(unicode_guard)).ok, "guard preserves unrelated Unicode variable");
print "guard_preprocessor_activation_pass";
