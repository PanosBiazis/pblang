// DataFrame algorithmic hot paths: stable merge sort, indexed joins/pivot,
// linear rolling windows, and linear column discovery/drop filtering.
let DF = import("stdlib:dataframe.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let unsorted = [];
for i in 0 to 999 { unsorted[len(unsorted)] = map{ key: 999 - i, original: i }; }
let sorted = DF.sort_by(DF.from_rows(unsorted), "key", "asc");
eq(sorted.rows[0].key, 0, "merge sort first");
eq(sorted.rows[999].key, 999, "merge sort last");

let stable = DF.sort_by(DF.from_rows([
    map{ key: 2, id: "a" }, map{ key: 1, id: "b" }, map{ key: 2, id: "c" }, map{ key: 1, id: "d" }
]), "key", "asc");
eq(stable.rows[0].id, "b", "stable sort first equal");
eq(stable.rows[1].id, "d", "stable sort second equal");
eq(stable.rows[2].id, "a", "stable sort later group");
eq(stable.rows[3].id, "c", "stable sort preserves later group");

let left = DF.from_rows([map{ id: 1, l: "L1" }, map{ id: 2, l: "L2" }]);
let right = DF.from_rows([
    map{ id: 1, r: "R1" }, map{ id: 1, r: "R2" }, map{ id: 3, r: "R3" }
]);
let inner = DF.join(left, right, "id");
eq(DF.nrows(inner), 2, "indexed join keeps duplicate matches");
eq(inner.rows[0].r, "R1", "indexed join preserves right order");
eq(inner.rows[1].r, "R2", "indexed join second duplicate");
let outer = DF.left_join(left, right, "id");
eq(outer.rows[0].r, "R1", "left join preserves first-match contract");
eq(outer.rows[1].r, nil, "left join unmatched remains nil");

let rolling = DF.rolling_mean(DF.from_rows([
    map{ v: 1 }, map{ v: 2 }, map{ v: nil }, map{ v: 4 }, map{ v: 5 }
]), "v", 2);
eq(rolling[0], nil, "rolling warmup");
eq(rolling[1], 1.5, "rolling first full window");
eq(rolling[2], nil, "rolling gap enters window");
eq(rolling[3], nil, "rolling gap remains in window");
eq(rolling[4], 4.5, "rolling recovers after gap leaves");
if (try DF.rolling_mean(left, "id", 0) catch "blocked") != "blocked" { fail("rolling window guard"); }

let pivoted = DF.pivot(DF.from_rows([
    map{ region: "east", quarter: "Q1", amount: 10 },
    map{ region: "east", quarter: "Q1", amount: 5 },
    map{ region: "west", quarter: "Q2", amount: 7 }
]), "region", "quarter", "amount", "sum");
eq(pivoted.rows[0].Q1, 15, "indexed pivot aggregate");
eq(pivoted.rows[1].Q2, 7, "indexed pivot second cell");

print "dataframe_hotpath_pass";
