let W=import("stdlib:research_windows.sapp");
let R=import("stdlib:research_observations.sapp");
let spec=map{value_unit:"cm",summary_unit:"m",value_mode:"absolute",time_unit:"min",timebase:"relative"};
let rows=[map{subject:1,time:0,value:10},map{subject:1,time:1,value:20},map{subject:1,time:2,value:nil},
    map{subject:1,time:4,value:40},map{subject:2,time:4,value:nil},map{subject:1,time:5,value:50}];
let grid=map{start:1,duration:1,count:4};let snapshot=json_stringify([spec,rows,grid]);
let out=W.review(spec,rows,grid);
assert(out.included_rows==4 and out.before_rows==1 and out.after_rows==1,"partition includes start and excludes final end");
assert(out.included_rows+out.before_rows+out.after_rows==out.overall.row_count,"row conservation");
assert(out.grid.start_seconds==60 and out.grid.duration_seconds==60,"grid units converted");
let expected=["observed","all_missing","empty","partial"];
let subsets=[[rows[1]],[rows[2]],[],[rows[3],rows[4]]];
for i in range(0,4) {
    assert(out.windows[i].slot==i and out.windows[i].state==expected[i] and out.state_counts[expected[i]]==1,"all four states");
    assert(out.windows[i].start_seconds==(i+1)*60 and out.windows[i].end_seconds==(i+2)*60,"contiguous boundaries");
    let canonical=R.summarize(spec,subsets[i]);
    for key in map_keys(out.windows[i].metrics) {assert(out.windows[i].metrics[key]==canonical[key],"canonical summary reuse");}
}
assert(out.windows[0].metrics.mean==0.2 and out.windows[3].metrics.mean==0.4,"unit conversion per window");
assert(out.windows[1].metrics.missing_fraction==1 and out.windows[2].metrics.missing_fraction==nil,"all missing versus absent rows");
assert(out.windows[3].metrics.missing_fraction==0.5,"partial missingness");
for flag in ["contains_rows","contains_subject_ids","contains_observation_times","expected_cadence_verified","coverage_verified","scientific_validity_verified","acquisition_performed","monitoring_started","safe_to_log"] {assert(not out[flag],"no identity, observation timestamps or authority");}
out.windows[0].metrics.mean=99;out.overall.method.summary_unit="changed";
assert(json_stringify([spec,rows,grid])==snapshot and W.review(spec,rows,grid).windows[0].metrics.mean==0.2,"inputs preserved and outputs detached");
let empty=W.review(spec,[],grid);assert(empty.state_counts.empty==4 and empty.included_rows==0 and empty.overall.mean==nil,"empty grid review");
fn rejected(configuration,observations,window_grid) {
    assert((try W.review(configuration,observations,window_grid) catch nil)==nil,"invalid input rejects entire review");
}
for bad in [nil,true,[],map{},map{start:0,duration:1,count:1,path:"private"},map{start:0,duration:0,count:1},map{start:-1,duration:1,count:1},map{start:0,duration:1,count:0},map{start:0,duration:1,count:33},map{start:0,duration:1,count:1.5}] {rejected(spec,rows,bad);}
for field in ["start","duration","count"] {
    for bad in [nil,true,false,"1",[],map{},parse_number("NaN"),parse_number("inf"),parse_number("-inf")] {
        let broken=json_parse(json_stringify(grid));broken[field]=bad;rejected(spec,rows,broken);
    }
}
rejected(spec,[map{subject:1,time:0,value:"private"}],grid);
rejected(spec,[map{subject:1,time:6,value:parse_number("NaN")}],grid);
rejected(spec,[map{subject:1,time:6,value:1},map{subject:1,time:5,value:2}],grid);
let broken=json_parse(json_stringify(spec));broken.summary_unit="s";rejected(broken,[],grid);
let seconds=json_parse(json_stringify(spec));seconds.time_unit="s";
rejected(seconds,[],map{start:1000000000,duration:0.000000000001,count:1});
let days=json_parse(json_stringify(spec));days.time_unit="day";
rejected(days,[],map{start:1000000000,duration:1,count:1});
rejected(days,[],map{start:0,duration:1000000,count:32});
let many=[];for i in range(0,256) {array_push(many,map{subject:1,time:i,value:i});}
let maximum=W.review(seconds,many,map{start:0,duration:8,count:32});
assert(maximum.state_counts.observed==32 and maximum.included_rows==256,"row and window maxima");
for window in maximum.windows {assert(window.metrics.row_count==8,"maximum partition size");}
array_push(many,map{subject:1,time:256,value:0});rejected(seconds,many,grid);
let exact=W.review(seconds,[map{subject:64,time:0,value:0},map{subject:64,time:1,value:nil}],map{start:0,duration:1,count:1});
assert(exact.included_rows==1 and exact.after_rows==1 and exact.windows[0].metrics.mean==0,"zero observed, final edge outside");
let fractional=W.review(seconds,[map{subject:1,time:0.25,value:1},map{subject:1,time:0.5,value:2},map{subject:1,time:0.75,value:3}],map{start:0.25,duration:0.25,count:2});
assert(fractional.included_rows==2 and fractional.after_rows==1 and fractional.windows[1].metrics.row_count==1,"representable fractional boundaries");
print "research_windows_pass";
