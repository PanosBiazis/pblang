let Gui = import("stdlib:gui.sapp");

fn require(value, message) { if not value { throw "FAIL gui_close_request: " + message; } }

let form = Gui.form("Close contract", 320, 240);
require(not form.close_requested, "new forms must remain open");
require(Gui.request_close(form) and form.close_requested and form.dirty,
    "request_close must publish a deterministic event-loop shutdown request");

let window_form = Gui.form("Window close contract", 320, 240);
Gui.handle_event(window_form, map{type:"close"});
require(window_form.close_requested,
    "native window close events must request cooperative shutdown");
require(window_form.native_window_closed,
    "native close events must prevent a second backend close request");

let escape_form = Gui.form("Escape close contract", 320, 240);
Gui.handle_event(escape_form, map{type:"keydown",key:"Escape"});
require(escape_form.close_requested,
    "Escape without an active field must request cooperative shutdown");

print "gui_close_request_pass";
