let Gui = import("stdlib:gui.sapp");

fn require(value, message) { if not value { throw "FAIL gui_close_request: " + message; } }

let form = Gui.form("Close contract", 320, 240);
require(not form.close_requested, "new forms must remain open");
require(Gui.request_close(form) and form.close_requested and form.dirty,
    "request_close must publish a deterministic event-loop shutdown request");

print "gui_close_request_pass";
