let DSP=import("stdlib:speech_dsp.sapp");
let PCM=import("stdlib:audio_pcm.sapp");
fn expect(value,message){if not value{throw "FAIL speech diarization: "+message;}}
fn rejected(work){return try { work(); false } catch true;}

let samples=[];for i 32000{let period=if i<16000{80}else{20};
    array_push(samples,if num_mod(i,period)<period/2{8000}else{-8000});}
let audio=map{format:PCM.FORMAT,sample_rate:16000,channels:1,samples:samples};
let result=DSP.diarize(audio,4,250,125,-60,0.05);
expect(result.ok and result.executed and result.turn_count>=1 and result.speaker_count>=1
    and result.speaker_count<=4 and not result.identity_recognition,
    "bounded clustering emits labeled turns without identity claims");
for i len(result.turns){expect(result.turns[i].start_secs>=0
    and result.turns[i].end_secs<=2 and result.turns[i].duration_secs>0,
    "turn timestamps stay inside input duration");}
expect(rejected(fn(){DSP.diarize(audio,0,500,250,-48,0.12);})
    and rejected(fn(){DSP.diarize(audio,4,50,25,-48,0.12);}),
    "unsafe cluster and window parameters fail closed");
print "speech_diarization_contract_pass";
