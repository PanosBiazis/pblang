let D=import("stdlib:digest.sapp");
fn require(c,m){if not c{throw m;}}
require(D.sha1_hex_bytes([])=="da39a3ee5e6b4b0d3255bfef95601890afd80709","sha1 empty");
require(D.sha1_hex_bytes(str_to_bytes("abc"))=="a9993e364706816aba3e25717850c26c9cd0d89d","sha1 abc");
require(D.md5_hex_bytes([])=="d41d8cd98f00b204e9800998ecf8427e","md5 empty");
require(D.md5_hex_bytes(str_to_bytes("abc"))=="900150983cd24fb0d6963f7d28e17f72","md5 abc");
require(D.blake3_hex_bytes([])=="af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262","blake3 empty");
require(D.blake3_hex_bytes(str_to_bytes("abc"))=="6437b3ac38465133ffb63b75273a8db548c558465d79db03fd359c6cd5bd9d85","blake3 abc");
fn vector(n){let out=[];for i n{array_push(out,i%251);}return out;}
require(D.sha1_hex_bytes(vector(130))=="6981ed7d97ffca517d531cd3d1874b43e11f1b46","sha1 multi-block");
require(D.md5_hex_bytes(vector(130))=="7c05c285d0263c40a0437421b387a2a1","md5 multi-block");
require(D.blake3_hex_bytes(vector(1024))=="42214739f095a406f3fc83deb889744ac00df831c10daa55189b5d121c855af7","blake3 1024");
require(D.blake3_hex_bytes(vector(1025))=="d00278ae47eb27b34faecf67b4fe263f82d5412916c1ffd97c8cb7fb814b8444","blake3 1025");
require(D.blake3_hex_bytes(vector(2048))=="e776b6028c7cd22a4d0ba182a8bf62205d2ef576467e838ed6f2529b85fba24a","blake3 2048");
require(D.blake3_hex_bytes(vector(3072))=="b98cb0ff3623be03326b373de6b9095218513e64f1ee2edd2525c7ad1e5cffd2","blake3 3072");
require(D.blake3_hex_bytes(vector(4096))=="015094013f57a5277b59d8475c0501042c0b642e531b0a1c8f58d2163229e969","blake3 4096");
require(D.hash_hex_bytes("sha256",str_to_bytes("abc"))=="ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad","sha256 dispatch");
let invalid=try D.hash_hex_bytes("rot13",[]) catch "blocked"; require(invalid=="blocked","unsupported digest rejected");
print "digest_pass";
