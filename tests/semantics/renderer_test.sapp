// tests/semantics/renderer_test.sapp — pblang-level renderer choice + status + live UI scaling,
// so an app (e.g. PBIDE) has UX controls around the backend and DPI without native edits.

let R = import("stdlib/renderer.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : <<" + s + ">>"); } }

// ── backends catalog ────────────────────────────────────────────────────────────────
let bs = R.backends();
let names = "";
let i = 0; while i < len(bs) { names = names + bs[i].name + " "; i = i + 1; }
has(names, "minifb", "lists minifb"); has(names, "sdl2", "lists sdl2"); has(names, "software", "lists software");

// ── selecting a backend yields the env settings to apply (process can't hot-swap) ────
let sel = R.select("sdl2");
has(str(sel.env), "PBLANG_GFX", "sdl2 selection sets PBLANG_GFX");
let soft = R.select("software");
has(str(soft.env), "PBLANG_GFX_SOFTWARE", "software selection sets the software flag");

// ── live UI scaling by resolution (the 4K auto-scale UX) ────────────────────────────
eq(R.scale_for(1280, 720), 1, "720p -> 1x");
if R.scale_for(2560, 1440) < 2 { fail("1440p should be >=2x"); }
if R.scale_for(3840, 2160) < 3 { fail("4K should be >=3x"); }

// ── status + recommendation ─────────────────────────────────────────────────────────
let st = R.status(3840, 2160);
if not map_has(st, "backend") or not map_has(st, "scale") { fail("status shape"); }
eq(st.scale, R.scale_for(3840, 2160), "status scale matches scale_for");
let rec = R.recommend();
has(names, rec, "recommend returns a known backend");

print "renderer_pass";
