// Test 1: Basic try/catch
let result = try error("fail") catch "caught";
assert(result == "caught", "try/catch should catch errors");

// Test 2: Nested try/catch
let outer = try {
    let inner = try error("inner") catch "inner_caught";
    inner
} catch "outer_caught";
assert(outer == "inner_caught", "nested try should catch inner error");

// Test 3: try with no error
let no_err = try { 1 + 1 } catch "never";
assert(no_err == 2, "try with no error should return value");

// Test 4: throw statement
let thrown = try { throw "custom error"; "unreachable" } catch "caught_throw";
assert(thrown == "caught_throw", "throw should be catchable: " + str(thrown));

// Test 5: defer runs on normal return (LIFO order)
let defer_log = [];
fn test_defer_normal() {
    defer { array_push(defer_log, "last_defer"); }
    defer { array_push(defer_log, "first_defer"); }
    array_push(defer_log, "body");
    return "done";
}
let r = test_defer_normal();
assert(r == "done", "function should return done");
assert(len(defer_log) == 3, "defer log should have 3 entries, got: " + str(len(defer_log)));
assert(defer_log[0] == "body", "body should run first");

// Test 6: catch catches and converts to value
let err_converted = try error("boom") catch "got_error";
assert(err_converted == "got_error", "error should be caught");
assert(type(err_converted) == "string", "caught error should be string");

// Test 7: error propagation through function calls
fn thrower() {
    throw "propagated";
}
let propagated = try thrower() catch "caught_propagated";
assert(propagated == "caught_propagated", "error should propagate: " + str(propagated));

// Test 8: multiple try/catch in sequence
let a = try error("err_a") catch "ca";
let b = try { 10 * 2 } catch "cb";
let c = try error("err_c") catch "cc";
assert(a == "ca", "first catch should work");
assert(b == 20, "successful try should return value");
assert(c == "cc", "third catch should work");

print "try_catch_defer_pass";
