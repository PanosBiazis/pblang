let STT=import("stdlib:speech_stt.sapp");
let PCM=import("stdlib:audio_pcm.sapp");
fn expect(value,message){if not value{throw "FAIL speech STT: "+message;}}

let stereo=map{format:PCM.FORMAT,sample_rate:8000,channels:2,samples:[100,-100,200,0,300,100,400,200]};
let normalized=STT.normalize_audio(stereo);
expect(normalized.sample_rate==16000 and normalized.channels==1 and len(normalized.samples)==8,
    "input is deterministically downmixed and resampled to 16 kHz mono");
let seen=map{};let backend=map{decode:fn(audio,model){seen.audio=audio;seen.model=model;
    return map{ok:true,executed:true,transcript:"hello world",words:[map{word:"hello",start_secs:0,end_secs:0.5}],
        word_count:1,probability:-12};}};
let model=map{acoustic_model:"held-hmm",language_model:"held-lm",dictionary:"held-dict",language:"en"};
let result=STT.transcribe_with_backend(stereo,model,backend);
expect(result.ok and result.format==STT.FORMAT and result.transcript=="hello world"
    and seen.model.language=="en","backend transcript and word timing remain structured");
expect(not STT.native_decode(stereo,map{acoustic_model:"/tmp/model",language_model:"/tmp/lm",
    dictionary:"/tmp/dict"}).ok,"native decoder rejects namespace paths instead of held descriptors");
print "speech_stt_contract_pass";
