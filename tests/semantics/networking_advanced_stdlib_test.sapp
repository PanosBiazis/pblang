let net = import("stdlib:networking_advanced.sapp");

let u = net.url_parse("https://example.com:8443/a/b?x=1&name=panos#frag");
assert(u.scheme == "https", "scheme");
assert(u.host == "example.com", "host");
assert(u.port == 8443, "port");
assert(u.path == "/a/b", "path");
assert(u.query_params.x == "1", "query param x");
assert(u.query_params.name == "panos", "query param name");
assert(u.fragment == "frag", "fragment");

assert(net.url_decode(net.url_encode("a b&c=d")) == "a b&c=d", "url encode/decode roundtrip");
assert(net.is_ipv4("192.168.1.10"), "valid ipv4");
assert(not net.is_ipv4("999.1.1.1"), "invalid ipv4");
assert(net.ipv4_to_int("0.0.1.0") == 256, "ipv4 to int");
assert(net.int_to_ipv4(256) == "0.0.1.0", "int to ipv4");

let range = net.cidr_to_range("192.168.1.0/24");
assert(range.ok, "cidr ok");
assert(range.first == "192.168.1.0", "cidr first");
assert(range.last == "192.168.1.255", "cidr last");
assert(net.cidr_contains("192.168.1.0/24", "192.168.1.42"), "cidr contains");
assert(not net.cidr_contains("192.168.1.0/24", "192.168.2.1"), "cidr excludes");
assert(net.subnet_mask(24) == "255.255.255.0", "subnet mask");

let req = net.build_http_request("POST", "https://example.com/path?q=1", map{ "Content-Type": "text/plain" }, "hello");
assert(str_contains(req, "POST /path?q=1 HTTP/1.1"), "request line");
assert(str_contains(req, "Host: example.com"), "host header");
assert(str_contains(req, "Content-Length: 5"), "content length");

let res = net.parse_http_response("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\n\r\nbody");
assert(res.status == 200, "response status");
assert(res.headers["content-type"] == "text/plain", "response header");
assert(res.body == "body", "response body");

let flags = net.decode_tcp_flags(18);
assert(len(flags) == 2, "SYN ACK flag count");
assert(flags[0] == "SYN", "SYN flag");
assert(flags[1] == "ACK", "ACK flag");

print "networking_advanced_stdlib_pass";
