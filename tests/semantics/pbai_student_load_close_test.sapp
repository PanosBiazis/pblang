let AI=import("stdlib/pbai.sapp");let N=import("stdlib:pbai_neural_adapter.sapp");
let bound=AI.neural_specialist_bind(N);
let teacher=bound.train([map{x:[0],y:4}],[map{x:[7,0],y:4}]);
let artifact=bound.distill_supervised(teacher.artifact,[map{x:[0],y:5}],[map{x:[7,0],y:5}],
 map{epochs:64,lr:0.1,temperature:2,hard_weight:1,max_grad_norm:1}).checkpoint();
let source=N.student_encode(artifact);let independent=bound.student_load(artifact);
let expected=json_stringify(independent.predict([6,0]));let cycle=[];push(cycle,cycle);
fn rejects(operation) {return try {operation();false} catch true;}
assert(rejects(fn(){throw "expected";}) and not rejects(fn(){return 1;}),"calibrated helper");
fn load(mode) {
 if mode==0 {return N.student_load(artifact);}
 if mode==1 {return AI.neural_specialist_student_load(artifact);}
 return bound.student_load(artifact);
}
let cases=0;
for mode in [0,1,2] {for usage in ["idle","predicted","evaluated","exported"] {
 let handle=load(mode);assert(map_has(handle,"close"),"loaded checkpoint needs explicit close");
 if usage=="predicted" {handle.predict([6,0]);}
 elif usage=="evaluated" {handle.evaluate([map{x:[6,0],y:5}]);}
 elif usage=="exported" {handle.checkpoint();}
 let report=handle.report;let report_text=json_stringify(report);
 let checkpoint=handle.checkpoint();let checkpoint_text=N.student_encode(checkpoint);
 let prediction=handle.predict([6,0]);let prediction_text=json_stringify(prediction);
 let evaluation=handle.evaluate([map{x:[6,0],y:5}]);let evaluation_text=json_stringify(evaluation);
 let alias=handle;let predict=handle.predict;let evaluate=handle.evaluate;
 let export_checkpoint=handle.checkpoint;let close=handle.close;
 let first=close();let second=alias.close();
 assert(type(first)=="bool" and type(second)=="bool" and first and not second,"close is terminal and idempotent through aliases");
 for ids in [[6,0],nil,[],cycle,"synthetic-private-input"] {
  assert(rejects(fn(){predict(ids);}),"saved prediction methods cannot reuse a closed handle");
 }
 for examples in [[map{x:[6,0],y:5}],nil,[],cycle] {
  assert(rejects(fn(){evaluate(examples);}),"saved evaluation methods cannot reuse a closed handle");
 }
 assert(rejects(export_checkpoint) and not close(),"checkpoint export cannot reopen a closed handle");
 assert(json_stringify(report)==report_text and json_stringify(prediction)==prediction_text
  and json_stringify(evaluation)==evaluation_text and N.student_encode(checkpoint)==checkpoint_text,"earlier exports remain caller owned");
 handle.closed=false;report.artifact_digest="changed";report.steps=0;
 assert(rejects(fn(){alias.predict([6,0]);}) and not close(),"public fields cannot reopen private state");
 let restored=bound.student_load(checkpoint);
 assert(json_stringify(restored.predict([6,0]))==expected and restored.close(),"previously exported checkpoint remains reloadable");
 assert(json_stringify(independent.predict([6,0]))==expected,"independent live handle unaffected");
 cases=cases+1;
}}
assert(N.student_encode(artifact)==source and independent.close(),"input artifact and independent ownership retained");
assert(cases==12,"direct, legacy and bound facade across four prior uses");
print "pbai_student_load_close_pass:12";
