// tests/semantics/dist_native_comment_import_test.sapp
//
// dist.native decides whether to run the multi-module source inliner with the
// naive check `str_index_of(src, "import(") >= 0`, which is comment/string-blind.
// A SINGLE-FILE program whose only `import(` is inside a comment was therefore
// run through the inliner, written to a spurious `*.inlined.sapp`, and reported
// with `inlined: true` even though nothing was actually inlined. The `inlined`
// flag must reflect reality (real modules linked), so callers/reports are honest.

let dist = import("stdlib/dist.sapp");

fn fail(m) { throw "FAIL " + m; }

// Skip cleanly if this host has no C toolchain (native builds need a compiler).
if len(dist.available_targets()) == 0 {
    print "dist_native_comment_import_pass";
} else {

let ts = str(num_floor(now_ms()));
let prog = "/tmp/dnci_" + ts + ".sapp";
let out = "/tmp/dnci_bin_" + ts;

// Single-file program, NO real import, but a comment that mentions import(...).
fs_write_bytes(prog, str_to_bytes(
    "// usage: import(\"helpers.sapp\")\nfn fib(n){ if n < 2 { return n; } return fib(n-1)+fib(n-2); } print fib(12);"));

let r = dist.native(prog, out);
if not r.ok { fail("native build of a comment-import single-file program must succeed: " + str(try r.reason catch r.stderr)); }
if r.inlined { fail("inlined must be false: the only import() is in a comment (nothing real to link)"); }
if fs_exists(out + ".inlined.sapp") { fail("no .inlined.sapp must be written when there are no real imports"); }
let run = proc_spawn_wait(r.output, []);
if str_trim(run.stdout) != "144" { fail("the native binary must run: fib(12)=144, got " + str_trim(run.stdout)); }

// Regression: a plain single-file program (no import text at all) stays inlined:false.
let prog2 = "/tmp/dnci2_" + ts + ".sapp";
let out2 = "/tmp/dnci2_bin_" + ts;
fs_write_bytes(prog2, str_to_bytes("fn sq(x){ return x*x; } print sq(9);"));
let r2 = dist.native(prog2, out2);
if not r2.ok { fail("plain single-file native build must succeed"); }
if r2.inlined { fail("plain single-file must report inlined:false"); }

print "dist_native_comment_import_pass";
}
