// tests/semantics/crypto_advanced_enrich_test.sapp — enrichment for stdlib/crypto_advanced.sapp
// Adds aead_encrypt/aead_decrypt: a REAL cipher (ChaCha20 from crypto.sapp) with
// encrypt-then-MAC authentication, replacing the need for the educational XOR path.

let ca = import("stdlib/crypto_advanced.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let key = []; let i = 0; while i < 32 { array_push(key, i); i = i + 1; }
let nonce = []; i = 0; while i < 12 { array_push(nonce, i * 2); i = i + 1; }

// ── base password hashing still works ────────────────────────────────────────────
let h = ca.password_hash("pw", "salt");
eq(ca.password_verify("pw", "salt", h), true, "password_verify");
eq(ca.password_verify("wrong", "salt", h), false, "password_verify wrong");

// ── ENRICH: AEAD round-trip (ChaCha20 + HMAC) ────────────────────────────────────
let blob = ca.aead_encrypt("secret message", key, nonce);
eq(ca.aead_decrypt(blob, key), "secret message", "aead round-trip");

// ── AEAD rejects wrong key and tampered/garbage input ────────────────────────────
let badkey = []; i = 0; while i < 32 { array_push(badkey, 99); i = i + 1; }
eq(ca.aead_decrypt(blob, badkey), nil, "wrong key -> nil (authentication fails)");
eq(ca.aead_decrypt("not-a-valid-blob", key), nil, "garbage -> nil");

// ── binary-safe: plaintext with bytes that stress encoding ───────────────────────
eq(ca.aead_decrypt(ca.aead_encrypt("café ☕ \n\t end", key, nonce), key), "café ☕ \n\t end", "aead utf-8 round-trip");

print "crypto_advanced_enrich_pass";
