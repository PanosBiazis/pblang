let Plan = import("stdlib:host_pbck_frame_plan.sapp");
let Translate = import("stdlib:selfhost_to_pbck.sapp");

fn fail(message) { throw "FAIL host_pbck_frame_plan: " + message; }

// add(delta) captures local 0. The translated PBCK contains one nested
// function, mutable upvalue instructions and one closure capture descriptor.
let add_chunk = map{
    instructions: [
        map{ op: 38, operand: 0 }, map{ op: 16, operand: 0 },
        map{ op: 1, operand: 0 }, map{ op: 39, operand: 0 },
        map{ op: 38, operand: 0 }, map{ op: 19, operand: 0 }
    ], constants: []
};
let add_function = map{
    arity: 1, min_arity: 1, chunk: add_chunk,
    upvalues: [map{ index: 0, is_local: true }]
};
let root = map{
    instructions: [
        map{ op: 0, operand: 0 }, map{ op: 17, operand: 0 },
        map{ op: 24, operand: 1 }, map{ op: 17, operand: 1 },
        map{ op: 16, operand: 1 }, map{ op: 0, operand: 2 },
        map{ op: 18, operand: 1 }, map{ op: 19, operand: 0 }
    ], constants: [40, add_function, 2]
};

let bytes = Translate.translate(root);
let plan = Plan.build_bytes(bytes);
let report = Plan.stats(plan);
if report.functions != 2 or report.instructions != 18 or report.captures != 1
    or report.max_depth != 1 or not Plan.validate(plan).ok {
    fail("flat plan totals mismatch");
}
if Plan.constant_at(plan, 0, 2) != 40 or Plan.constant_at(plan, 0, 4) != 2 {
    fail("root scalar constant mapping mismatch");
}
let function_value = Plan.constant_at(plan, 0, 3);
if not is_map(function_value) or function_value.__pbck_function_id != 1 {
    fail("function constant was not normalized to a flat id");
}

let closure = nil;
let closure_index = 0 - 1;
let ii = 0;
while ii < plan.functions[0].instruction_count {
    let instruction = Plan.instruction_at(plan, 0, ii);
    if instruction.op == 27 { closure = instruction; closure_index = ii; }
    ii = ii + 1;
}
if closure == nil or closure.operand != 1 or len(closure.captures) != 1
    or not closure.captures[0].is_local or closure.captures[0].index != 0 {
    fail("closure lowering or capture metadata mismatch");
}
let child_frame = Plan.function_at(plan, 1);
if child_frame.arity != 1 or child_frame.max_local != 1
    or child_frame.max_upvalue != 1 {
    fail("child frame metadata mismatch");
}
let closure_capture = Plan.capture_at(plan, 0, closure_index, 0);
if not closure_capture.is_local or closure_capture.index != 0 {
    fail("bounded capture lookup mismatch");
}

let decoded = map{
    format: "host-pbck-v1", version: 1,
    chunk: map{
        instructions: [map{ op: 0, operand: 0 }, map{ op: 33 }],
        constants: [42], source_name: nil
    }
};
let direct = Plan.build_decoded(decoded);
if Plan.constant_at(direct, 0, 0) != 42
    or Plan.instruction_at(direct, 0, 0).operand != direct.constant_slots[0] {
    fail("decoded plan parity mismatch");
}

if not (try { Plan.build_bytes(bytes, map{ max_functions: 1 }); false } catch true) {
    fail("function budget did not fail closed");
}
fn nested_program() {
    let leaf = map{
        __pbck_function: true, arity: 0, min_arity: 0,
        chunk: map{ instructions: [map{ op: 33 }], constants: [], source_name: nil }
    };
    let parent = map{
        __pbck_function: true, arity: 0, min_arity: 0,
        chunk: map{ instructions: [map{ op: 33 }], constants: [leaf], source_name: nil }
    };
    return map{
        format: "host-pbck-v1", version: 1,
        chunk: map{ instructions: [map{ op: 33 }], constants: [parent], source_name: nil }
    };
}
if not (try { Plan.build_decoded(nested_program(), map{ max_depth: 1 }); false } catch true) {
    fail("invalid nesting budget accepted");
}

let broken_closure = Plan.build_bytes(bytes);
let bi = 0;
while bi < len(broken_closure.opcodes) and broken_closure.opcodes[bi] != 27 { bi = bi + 1; }
broken_closure.operands[bi] = 999;
if Plan.validate(broken_closure).ok { fail("invalid closure function id accepted"); }

let broken_capture = Plan.build_bytes(bytes);
bi = 0;
while bi < len(broken_capture.opcodes) and broken_capture.opcodes[bi] != 27 { bi = bi + 1; }
broken_capture.instruction_capture_counts[bi] = 999;
if Plan.validate(broken_capture).ok { fail("invalid capture range accepted"); }

let missing_capture = Plan.build_bytes(bytes);
bi = 0;
while bi < len(missing_capture.opcodes) and missing_capture.opcodes[bi] != 27 { bi = bi + 1; }
missing_capture.instruction_capture_counts[bi] = 0;
if Plan.validate(missing_capture).ok { fail("missing required upvalue capture accepted"); }

let broken_constant = Plan.build_bytes(bytes);
let root_start = broken_constant.functions[0].instruction_start;
broken_constant.operands[root_start] = 999999;
if Plan.validate(broken_constant).ok { fail("invalid constant slot accepted"); }

if not (try { Plan.instruction_at(plan, 0, 999); false } catch true) {
    fail("out-of-range instruction lookup accepted");
}
if not (try { Plan.function_at(plan, "0"); false } catch true)
    or not (try { Plan.capture_at(plan, 0, closure_index, 1); false } catch true)
    or not (try { Plan.value_at(plan, 999999); false } catch true) {
    fail("bounded frame access accepted an invalid index");
}

let typed = Plan.build_decoded(map{ format: "host-pbck-v1", version: 1,
    chunk: map{ instructions: [map{ op: 33 }], constants: [map{
        __pbck_function: true, name: "typed", arity: 2, min_arity: 0,
        defaults: [42, "fallback"], is_vararg: false, parameter_types: [0, 2],
        chunk: map{ instructions: [map{ op: 33 }], constants: [], source_name: nil }
    }], source_name: nil } });
if Plan.default_at(typed, 1, 0) != 42 or Plan.default_at(typed, 1, 1) != "fallback"
    or Plan.parameter_type_at(typed, 1, 0) != 0
    or Plan.parameter_type_at(typed, 1, 1) != 2 {
    fail("default or parameter metadata lookup mismatch");
}
if not (try { Plan.default_at(typed, 1, 2); false } catch true)
    or not (try { Plan.parameter_type_at(typed, 1, 2); false } catch true) {
    fail("default or parameter bounds were not enforced");
}

print "host_pbck_frame_plan_pass";
