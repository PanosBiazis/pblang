// tests/semantics/polyglot_cached_test.sapp — PL2-alpha: cached cdylib loader
//
// Exercises polyglot.compile_cached + ffi_call_typed roundtrip with C, which
// is the most-likely-available toolchain on a Linux CI/dev host. Skips
// cleanly if cc/gcc/clang isn't installed.

import "stdlib:polyglot.sapp";

let langs = polyglot.detect();
let c_present = false;
if langs != nil and langs != map{} {
    let c_info = try langs.c catch nil;
    if c_info != nil {
        c_present = c_info.available;
    }
}

if c_present {
    // Two trivial C functions: add and multiply two i64.
    let csrc = "long pblang_add(long a, long b) { return a + b; }\nlong pblang_mul(long a, long b) { return a * b; }\n";

    // Warm cache miss → compile and load.
    let h = try polyglot.compile_cached("c", csrc) catch -1;
    if h == -1 {
        print "polyglot_cached_compile: FAIL (compile_cached returned error)";
    } else {
        let sum = try ffi_call_typed(h, "pblang_add", "i64,i64->i64", [10, 32]) catch -1;
        let prod = try ffi_call_typed(h, "pblang_mul", "i64,i64->i64", [6, 7]) catch -1;
        if sum == 42 and prod == 42 {
            print "polyglot_cached_compile: ok";
        } else {
            print "polyglot_cached_compile: FAIL sum=" + str(sum) + " prod=" + str(prod);
        }

        // Warm cache hit → same library handle slot semantics; just check it
        // doesn't error.
        let h2 = try polyglot.compile_cached("c", csrc) catch -1;
        if h2 != -1 {
            print "polyglot_cached_hit: ok";
            try ffi_close(h2) catch nil;
        } else {
            print "polyglot_cached_hit: FAIL";
        }

        try ffi_close(h) catch nil;
    }

    // Cache info should show our entry.
    let info = polyglot.cache_info();
    if info.count >= 1 and info.size_bytes > 0 {
        print "polyglot_cached_info: ok";
    } else {
        print "polyglot_cached_info: FAIL count=" + str(info.count);
    }
} else {
    print "polyglot_cached_compile: skipped (no C compiler)";
    print "polyglot_cached_hit: skipped";
    print "polyglot_cached_info: skipped";
}

print "polyglot_cached_pass";
