let POLY = import("stdlib:polyglot.sapp");

if not (try { POLY.compile_cached("c", "int value(void){return 1;}"); false } catch true) {
    throw "legacy compile_cached must fail closed";
}

let denied = POLY.compile("c", "int value(void){return 1;}", "/tmp");
if denied.ok or denied.executed or denied.raw_fallback {
    throw "artifact compilation must require explicit source and toolchain approval";
}

let info = POLY.cache_info();
if not info.ok or info.enabled or info.count != 0 or info.size_bytes != 0 {
    throw "disabled native cache status is malformed";
}

print "polyglot_cached_pass";
