let App=import("../../examples/declarative_browser/app.sapp");let GUI=import("stdlib:gui.sapp");let Profile=import("../../examples/declarative_browser/appearance_profile.sapp");
let n=0;fn check(ok,label){assert(ok,label);n=n+1;}
fn key(c,k){App.update(c,[map{type:"keydown",key:k},map{type:"keyup",key:k}]);}
fn make(height=816,prefs=true){let c=App.create();if prefs {App.enable_preferences(c);}c.width=320;c.height=height;c.settings=true;c.focus_target="font_scale";App.refresh(c);return c;}
let first=make();key(first,"Left");check(first.preferences.draft.font_scale==0.95,"Left reaches intermediate text scale");check(first.appearance.font_scale==1,"ratio edit remains draft");first.session.close();
for field in ["font_scale","line_height"] {
 let low=if field=="font_scale" {0.75}else{1};let high=if field=="font_scale" {1.5}else{2.5};let count=if field=="font_scale" {15}else{30};
 let c=make();c.preferences.draft[field]=low;c.focus_target=field;App.refresh(c);c.form.probe="kept";key(c,"Left");check(c.preferences.draft[field]==low and c.form.probe=="kept","minimum neither wraps nor rebuilds");
 for i count {key(c,"Right");check(c.preferences.draft[field]==(low*20+i+1)/20,"ascending grid "+field);}
 c.form.probe="kept";key(c,"Right");check(c.preferences.draft[field]==high and c.form.probe=="kept","maximum neither wraps nor rebuilds");
 for i count {key(c,"Left");check(c.preferences.draft[field]==(high*20-i-1)/20,"descending grid "+field);}
 for value in [1.123,1.25,1.2499999999999998] {
  c.preferences.draft[field]=value;App.refresh(c);key(c,"Right");check(c.preferences.draft[field]==(if value<1.2 {1.15}else{1.3}),"off-grid or floating point neighbor forward");
  c.preferences.draft[field]=value;App.refresh(c);key(c,"Left");check(c.preferences.draft[field]==(if value<1.2 {1.1}else{1.2}),"off-grid or floating point neighbor backward");
 }
 c.session.close();
}
for height in [240,288,480,816] {
 let c=make(height);key(c,"Right");check(c.preferences.draft.font_scale==1.05 and c.form.focus=="font_scale","scale/focus at "+str(height));
 c.focus_target="line_height";App.refresh(c);App.update(c,[map{type:"keydown",key:"Right"},map{type:"keydown",key:"Right"}]);check(c.preferences.draft.line_height==1.5 and c.form.focus=="line_height","held spacing changes once");App.update(c,[map{type:"keydown",key:"Right"}]);check(c.preferences.draft.line_height==1.5,"held key retained after rebuild");App.update(c,[map{type:"keyup",key:"Right"}]);
 key(c,"Left");check(c.preferences.draft.line_height==1.45,"backward spacing");key(c,"Escape");check(c.preferences.draft==c.appearance,"Escape discards ratios");c.session.close();
}
let mods=make();for field in ["font_scale","line_height"] {
 mods.focus_target=field;App.refresh(mods);let value=mods.preferences.draft[field];
 for name in ["ctrl","alt","meta","shift"] {let ev=map{type:"keydown",key:"Right"};ev[name]=true;App.update(mods,[ev,map{type:"keyup",key:"Right"}]);check(mods.preferences.draft[field]==value,"modified ratio ignored");}
 App.update(mods,[map{type:"keydown",key:"LCtrl"}]);key(mods,"Right");check(mods.preferences.draft[field]==value,"held modifier ignored");App.update(mods,[map{type:"keyup",key:"LCtrl"}]);
 let widget=GUI.get(mods.form,field);widget.enabled=false;key(mods,"Right");check(mods.preferences.draft[field]==value,"disabled choice ignored");widget.enabled=true;widget.visible=false;key(mods,"Right");check(mods.preferences.draft[field]==value,"hidden choice ignored");widget.visible=true;
}
mods.form.focus="style_apply";key(mods,"Right");check(mods.appearance==Profile.defaults(),"arrow never applies");mods.session.close();
let immediate=make(240,false);key(immediate,"Right");check(immediate.appearance.font_scale==1.05,"session mode applies directly");immediate.session.close();
let api=make();check(App.adjust_text_ratio(api,"line_height",1) and api.preferences.draft.line_height==1.5,"developer helper");check((try {App.adjust_text_ratio(api,"body_size",1);false} catch true),"wrong metric refused");check((try {App.adjust_text_ratio(api,"font_scale",2);false} catch true),"nonunit step refused");key(api,"Escape");check(not App.adjust_text_ratio(api,"font_scale",1),"inactive outside Style");api.settings=true;api.form.close_requested=true;check(not App.adjust_text_ratio(api,"font_scale",1),"inactive after close");api.session.close();
let state=map{count:0,value:nil};let saver=fn(style){state.count=state.count+1;state.value=Profile.decode(Profile.encode(style)).appearance;return map{ok:true};};let saved=make();App.enable_preferences(saved,nil,saver);App.update(saved,[]);key(saved,"Right");saved.focus_target="line_height";App.refresh(saved);key(saved,"Right");check(state.count==0,"editing does not save");saved.focus_target="style_save";App.refresh(saved);key(saved,"Enter");check(state.count==1 and state.value.font_scale==1.05 and state.value.line_height==1.5,"explicit Save and canonical profile retain ratios");saved.session.close();
let legacy=make();key(legacy,"Enter");check(legacy.preferences.draft.font_scale==1.25,"scale presets retained");legacy.focus_target="line_height";App.refresh(legacy);key(legacy,"Enter");check(legacy.preferences.draft.line_height==1.75,"spacing presets retained");legacy.session.close();
print "reader_text_ratio_pass checks="+str(n);
