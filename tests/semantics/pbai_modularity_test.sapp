let AI=import("stdlib/pbai.sapp");
let direct_sensor=import("stdlib:pbai_sensor.sapp");
let catalog=AI.modular_catalog();
assert(not catalog.runtime_checked and len(catalog.adapters)==2 and catalog.workers_per_call==1 and not catalog.launches_workers,"static bounded serial declarations");
catalog.adapters[0].contract.max_samples=999;
assert(AI.modular_catalog().adapters[0].contract.max_samples==256,"catalog mutation confers no authority");
let sensor=AI.modular_probe("sensor-v1");assert(sensor.ok and sensor.code=="ok","actual sensor contract and synthetic probe");
assert(sensor.plan.ok and sensor.plan.bindings[0].status=="primary" and sensor.plan.bindings[0].provider=="sensor-v1","shared resolver binding");
assert(not sensor.plan.execution_performed and not sensor.authorizes_action,"planning does not grant runtime authority");
let student=AI.modular_probe("student-v1");assert(student.ok and student.probe_kind=="capability-and-error-contract","actual student bounded contract probe");
assert(not student.trained_during_probe and not student.spawns_workers,"probe performs no training or spawning");
let input=map{values:[2,4,6,100],period_seconds:1,sigma:3,absolute_tolerance:1};let before=json_stringify(input);
let executed=AI.modular_run("sensor-v1",input);
assert(executed.status=="result" and json_stringify(executed.output)==json_stringify(direct_sensor.analyze(input)),"same sensor result through admitted runtime");
assert(json_stringify(input)==before,"caller request unchanged");
let declared=AI.modular_run("student-v1",map{op:"capabilities"});
assert(json_stringify(declared.output)==json_stringify(AI.neural_specialist_student_tool(map{op:"capabilities"})),"student facade parity");
// Explicit synthetic model construction only in this test, never in a probe.
let training=[map{x:[0],y:4}];let validation=[map{x:[7,0],y:4}];
let teacher=AI.neural_specialist_train(training,validation);
let checkpoint=AI.neural_specialist_distill(teacher.artifact,[[0],[1,0]],validation).checkpoint();
let predict=map{op:"predict_batch",checkpoint:checkpoint,contexts:[[0],[1,0]],include_logits:true};
assert(json_stringify(AI.modular_run("student-v1",predict).output)==json_stringify(AI.neural_specialist_student_tool(predict)),"actual student inference and logit parity");
let malformed=AI.modular_run("sensor-v1",map{values:"synthetic-private-marker"});
assert(malformed.output.status=="error" and not str_contains(json_stringify(malformed),"synthetic-private-marker"),"provider input error retained without leaking input");
assert(AI.modular_run("student-v1",map{op:"train"}).output.status=="error","bridge cannot add training authority");
let cycle=[];push(cycle,cycle);let called=false;let callback=fn(){called=true;return "sensor-v1";};
for bad in [nil,true,7,[],map{},cycle,callback,"../private-marker","sensor-v2","gpu","npu"] {
 let result=AI.modular_probe(bad);assert(not result.ok and result.code=="invalid_adapter" and result.adapter==nil,"adapter allowlist is exact");
 let out=AI.modular_run(bad,input);assert(out.status=="error" and out.output==nil,"invalid adapter cannot execute");
 assert(not str_contains(json_stringify(result),"private-marker"),"unrecognized adapter not echoed");
}
assert(not called,"caller callbacks never invoked");
sensor.plan.bindings[0].provider="gpu";
assert(AI.modular_probe("sensor-v1").plan.bindings[0].provider=="sensor-v1","returned plan has no retained activation state");
print "pbai_modularity_pass";
