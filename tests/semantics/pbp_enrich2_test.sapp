// tests/semantics/pbp_enrich2_test.sapp — wave 2 for stdlib/pbp.sapp (typed frame builders)

let P = import("stdlib/pbp.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// each builder produces a frame of the right type, decodable back
let h = P.hello(0, "hi");
let dh = P.decode_frame(h);
eq(dh.type, "HELLO", "hello type"); eq(dh.seq, 0, "hello seq"); eq(dh.payload, "hi", "hello payload");

let d = P.data(7, "payload");
eq(P.decode_frame(d).type, "DATA", "data type");
eq(P.decode_frame(d).payload, "payload", "data payload");

eq(P.decode_frame(P.ack(3)).type, "ACK", "ack type");
eq(P.decode_frame(P.ack(3)).seq, 3, "ack seq");
eq(P.decode_frame(P.bye(9)).type, "BYE", "bye type");

let e = P.err(2, "boom");
eq(P.decode_frame(e).type, "ERR", "err type");
eq(P.decode_frame(e).payload, "boom", "err payload");

// builders produce valid frames
if not P.is_valid_frame(h) { fail("hello is a valid frame"); }
if not P.is_valid_frame(e) { fail("err is a valid frame"); }

print "pbp_enrich2_pass";
