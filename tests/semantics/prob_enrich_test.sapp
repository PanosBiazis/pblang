// tests/semantics/prob_enrich_test.sapp — enrichment for stdlib/prob.sapp
// Adds geometric_pmf/cdf, bernoulli_pmf, kl_divergence, cross_entropy, normalize_probs.

let prob = import("stdlib/prob.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.000001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base still works ─────────────────────────────────────────────────────────────
near(prob.comb(10, 3), 120, "comb"); near(prob.normal_cdf(0, 0, 1), 0.5, "normal_cdf median");

// ── ENRICH: geometric ────────────────────────────────────────────────────────────
near(prob.geometric_pmf(1, 0.5), 0.5, "geometric pmf k=1");
near(prob.geometric_pmf(2, 0.5), 0.25, "geometric pmf k=2");
near(prob.geometric_cdf(2, 0.5), 0.75, "geometric cdf k=2");

// ── ENRICH: bernoulli_pmf ────────────────────────────────────────────────────────
near(prob.bernoulli_pmf(1, 0.3), 0.3, "bernoulli pmf 1"); near(prob.bernoulli_pmf(0, 0.3), 0.7, "bernoulli pmf 0");

// ── ENRICH: kl_divergence / cross_entropy ────────────────────────────────────────
near(prob.kl_divergence([0.5, 0.5], [0.5, 0.5]), 0, "KL of identical = 0");
near(prob.kl_divergence([1, 0], [0.5, 0.5]), num_ln(2), "KL [1,0]||[.5,.5] = ln2");
near(prob.cross_entropy([1, 0], [0.5, 0.5]), num_ln(2), "cross_entropy = -ln(0.5)");

// ── ENRICH: normalize_probs ──────────────────────────────────────────────────────
let p = prob.normalize_probs([1, 1, 2]);
near(p[0], 0.25, "normalize 0"); near(p[2], 0.5, "normalize 2");

print "prob_enrich_pass";
