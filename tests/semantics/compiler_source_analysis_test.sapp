let A = import("stdlib:compiler/source_analysis.sapp");
fn expect(value, message) { if not value { throw "source_analysis: " + message; } }
for source in ["let n=1; print n;", "fn f(x:number){return x;} print f(2);",
               "let s=\"λ😀 /* quoted */\"; print s;", "// complete comment\nlet n=1;"] {
    expect(A.analyze(source).ok, "valid input");
}
for source in [nil, "", "   ", "/* comment only */", "let = ;", "let n=0x;",
               "fn f(x:number){return x;} f();", "let n=nil-1;", "print absent;"] {
    expect(not A.analyze(source).ok, "reject invalid input");
}
let bad = A.analyze("let n=1;\n/* unfinished");
expect(not bad.ok and bad.errors[0] == "unterminated comment starting at line 2", "stable comment error");
let text = A.analyze("let s=\"unfinished");
expect(not text.ok and text.errors[0] == "unterminated string starting at line 1", "stable string error");
let arity = A.analyze("fn f(x:number){return x;} f();");
expect(arity.diagnostics[0].code == "arity", "structured type diagnostic");
// Analysis must neither execute source nor reuse mutable results across calls.
expect(A.analyze("throw \"not executed\";").ok, "analysis never executes source");
let first = A.analyze("let n=1; print n;");
first.tokens[0].kind = "corrupted"; array_push(first.errors, "injected");
let next = A.analyze("let n=1; print n;");
expect(next.ok and len(next.errors) == 0 and next.tokens[0].kind != "corrupted", "result isolation");
expect(not A.analyze("print n;").ok, "declarations do not leak between requests");
print "source_analysis_pass";
