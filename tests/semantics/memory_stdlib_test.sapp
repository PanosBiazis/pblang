// stdlib/memory.sapp — convenience wrappers over VM memory_* builtins
import "stdlib:memory.sapp";

let h = memory.box(42);
if memory.read(h) != 42 { throw "FAIL memory box/read"; }
memory.write(h, 99);
if memory.read(h) != 99 { throw "FAIL memory write"; }

let b = memory.borrow(h);
if memory.read(h) != 99 { throw "FAIL memory read during borrow"; }
memory.release(b);

memory.free(h);
let s = memory.stats();
if type(s) != "map" { throw "FAIL memory stats type"; }

print "memory_stdlib_pass";
