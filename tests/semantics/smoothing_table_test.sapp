let S=import("stdlib:smoothing_table.sapp");let Sheet=import("stdlib:sheet_document.sapp");let C=import("stdlib:sheet_csv.sapp");let D=import("stdlib:measure_table.sapp");
fn rejects(f){assert((try f() catch nil)==nil,"reject invalid smoothing");}
let input=C.decode("Label,Value\n001,2\n001,4\n,6");let before=Sheet.encode(input);let r=S.from_sheet(input,2);assert(r.document.cells==[["First","Last","From label","To label","Mean"],["1","2","001","001","3"],["2","3","001","","5"]],"ordered complete windows, literal duplicate/blank labels");r.document.cells[1][2]="changed";assert(Sheet.encode(input)==before,"detached result");
assert(S.window(" 03 ")==3 and D.parse_value("1.2e2")==120,"explicit numeric grammar");
for text in ["0","32","1.5","1e1","+2","",nil,str_repeat("1",17)]{rejects(fn(){S.window(text);});}
for text in ["nan","inf"," 2","1,5","1e-999","1e999","=1+1","1 2"]{rejects(fn(){D.parse_value(text);});}
for f in [fn(){S.create(["a"],[1000000001],1);},fn(){S.create(["a"],["1"],1);},fn(){S.create(["a"],[1],0);},fn(){S.create(["a"],[1],2);},fn(){S.create(["a"],[1],1.5);},fn(){S.create([],[],1);},fn(){S.create(["a"],[1,2],1);},fn(){S.from_sheet(C.decode("label,Value\nx,1"),1);},fn(){S.from_sheet(C.decode("Label,Value"),1);},fn(){S.create([str_repeat("α",129)],[1],1);}] {rejects(f);}
let cases=0;for n in range(1,32){let values=[];let labels=[];for i in range(0,n){array_push(values,if i%2==0 {i*3} else {-i*2});array_push(labels,str(i));}for width in range(1,n+1){let report=S.create(labels,values,width);assert(report.rows==n-width+1,"output length");for at in range(0,report.rows){let total=0;for j in range(at,at+width){total=total+values[j];}let expected=total/width;let actual=parse_number(report.document.cells[at+1][4]);assert(num_abs(actual-expected)<0.000000001,"496 naive-sum oracle cases");}cases=cases+1;}}assert(cases==496,"oracle case count");
let labels=[];let values=[];for i in range(0,31){array_push(labels,str_repeat("α",128));array_push(values,1);}rejects(fn(){S.create(labels,values,1);});print "smoothing_table_pass";
