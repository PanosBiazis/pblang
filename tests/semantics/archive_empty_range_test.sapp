let A=import("stdlib:secure_archive.sapp");
let P=import("stdlib:archive_publication.sapp");
let D=import("stdlib:linux_dirfs.sapp");
let OS=import("stdlib:os.sapp");
let root=OS.script_args()[0];let fs=D.open_absolute(root,false,false);
assert(fs.ok,"private scratch held");
let empty=D.sealed_child_bytes(fs,"empty",[]);let data=D.sealed_child_bytes(fs,"nonempty",[1,2]);
assert(empty.ok and empty.size==0 and empty.immutable and data.ok,"immutable snapshots");
assert(not D.copy_held_range_new_atomic(fs,empty,fs,"legacy",0,0,false,false).ok,"default still rejects zero");
for request in [map{held:empty,offset:0,count:-1,exec:false,allow:true},map{held:empty,offset:1,count:0,exec:false,allow:true},map{held:empty,offset:0,count:0,exec:true,allow:true},map{held:empty,offset:0,count:0,exec:false,allow:1},map{held:data,offset:0,count:0,exec:false,allow:true}] {
 let rejected=D.copy_held_range_new_atomic(fs,request.held,fs,"invalid",request.offset,request.count,false,request.exec,request.allow);
 assert(rejected.ok==false and not fs_exists(root+"/invalid"),"invalid empty publication fails before output");
}
let published=D.copy_held_range_new_atomic(fs,empty,fs,"empty",0,0,false,false,true);
assert(published.ok and published.size==0 and published.durability_verified and published.anonymous_stage and published.exact_inode_publication,"explicit empty publication");
assert(fs_read_bytes(root+"/empty")==[],"zero bytes");
assert(not D.copy_held_range_new_atomic(fs,empty,fs,"empty",0,0,false,false,true).ok,"empty no replace");
let nonempty=D.copy_held_range_new_atomic(fs,data,fs,"data",0,2,false,false);
assert(nonempty.ok and fs_read_bytes(root+"/data")==[1,2],"positive range unchanged");
assert(D.close(fs),"wrapper handles consumed");
let zip=A.pack([map{name:"empty",data:[]}],"store");
let zero=P.extract_member(root+"/zero-limits",zip,"empty",map{max_total_bytes:0,max_file_bytes:0});
assert(zero.ok and fs_read_bytes(root+"/zero-limits")==[],"valid zero resource budgets");
let mixed=A.pack([map{name:"empty",data:[]},map{name:"other",data:[1]}],"store");
let invalid=P.extract_member(root+"/not-created",mixed,"empty",map{max_total_bytes:0});
assert(invalid.ok==false and not invalid.publication_attempted and not fs_exists(root+"/not-created"),"unselected total budget before effects");
print "archive_empty_range_pass";
