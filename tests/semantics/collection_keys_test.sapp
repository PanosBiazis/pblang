let F = import("stdlib:functional.sapp");
let A = import("stdlib:array.sapp");
fn expect(ok,label) { if not ok { throw "FAIL collection-keys: " + label; } }
let values = [1,"1",true,"true",nil,"nil",1,"1",false,"false",0,parse_number("-0")];
let expected = [1,"1",true,"true",nil,"nil",false,"false",0];
expect(F.unique(values) == expected, "mixed scalar types remain distinct");
expect(A.unique(values) == expected, "array and functional unique agree");
let negative_zero = parse_number("-0");
expect(len(F.unique([negative_zero,0])) == 1 and str(F.unique([negative_zero,0])[0]) == str(negative_zero), "zero group retains first representative");
let near = 1.0000000000000002;
expect(near != 1, "numeric fixture has distinct values");
expect(F.unique([1,near,1,near]) == [1,near], "numeric rendering cannot prove equality");
expect(A.distinct_by([1,near,1,near],F.identity) == [1,near], "array projection verifies numeric equality");
let words = ["", "α:β", "s:1", "a\u0000b", "a", "α:β", ""];
expect(F.unique(words) == ["", "α:β", "s:1", "a\u0000b", "a"], "exact text on retained host");
let rows = [map{id:1,name:"first"},map{id:"1",name:"text"},map{id:1,name:"duplicate"}];
let seen = [];
let key = fn(row) { push(seen,row.name); return row.id; };
let distinct = F.unique_by(rows,key);
expect(distinct == [rows[0],rows[1]] and seen == ["first","text","duplicate"], "one ordered projection per item");
distinct[0].name = "updated";
expect(rows[0].name == "updated", "first original object retained by reference");
let groups = F.group_by_entries(rows,fn(row) { return row.id; });
expect(len(groups) == 2 and groups[0].key == 1 and groups[1].key == "1", "typed groups preserve encounter order");
expect(groups[0].items == [rows[0],rows[2]] and groups[1].items == [rows[1]], "typed groups preserve member order");
expect(F.group_by([1,"1"],F.identity)["1"] == [1,"1"], "legacy string map grouping unchanged");
expect(F.frequencies([1,"1"])["1"] == 2, "legacy frequencies unchanged");
expect(F.unique([]) == [] and F.group_by_entries([],nil) == [], "empty input does not invoke projection");
let effects = [];
let failed = try map{ok:true,value:F.unique_by([1,2,3],fn(x) { push(effects,x); if x == 2 { throw nil; } return x; })} catch map{ok:false};
expect(not failed.ok and effects == [1,2], "callback failure stops without later effects");
print "collection_keys_pass";
