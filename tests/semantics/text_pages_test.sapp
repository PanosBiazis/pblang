let P=import("stdlib:text_pages.sapp");
assert(P.wrap("abcdef",3)==["abc","def"],"hard wrap without lost characters");
assert(P.wrap("a\n\nb\n",4)==["a","","b",""],"blank lines and trailing newline retained");
assert(P.wrap("e\u0301x",1)==["e\u0301","x"],"combining mark stays with base");
assert(P.wrap("👩‍💻a",1)==["👩‍💻","a"],"existing ZWJ cluster kept intact");
assert(P.paginate("a\nb\nc",4,2)==[["a","b"],["c"]],"page boundaries");
assert(P.wrap("a\r\nb\rc\td",120)==["a","b","c    d"],"display whitespace normalization");
for text in [nil,42,str_repeat("α",4097)] { assert((try P.wrap(text) catch "bad")=="bad","input bytes bounded"); }
for n in [0,121,1.5,"40"] { assert((try P.wrap("x",n) catch "bad")=="bad","column bounds"); }
assert((try P.paginate(str_repeat("x",257),1,1) catch "bad")=="bad","page limit");
print "text_pages_pass";
