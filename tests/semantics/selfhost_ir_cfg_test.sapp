// tests/semantics/selfhost_ir_cfg_test.sapp
//
// The self-hosted IR CFG/dominator/loop analysis (stdlib/compiler/ir.sapp) must
// run on REAL compiled chunks without crashing and produce a correct graph.
// It was unusable: find_leaders/sets_equal/intersect_sets/compute_idom/
// detect_loops/natural_loop_for read missing map keys (`m[k] != nil` instead of
// map_has → throws), compute_idom indexed the `doms` array by a string key, and
// find_leaders/build_cfg didn't mark the fall-through after a CONDITIONAL jump as
// a block leader (so conditional edges were lost). Proven: build_cfg on a simple
// while-loop chunk threw "undefined key".

let ir = import("stdlib/compiler/ir.sapp");
let fe = import("stdlib/compiler/selfhost_frontend.sapp");

fn fail(m) { throw "FAIL " + m; }
fn cfg_of(src) { return ir.build_cfg(fe.frontend_compile(src).chunk); }

// 1. A while-loop must build a CFG, dominators, and detect its loop -- no crash.
let wc = cfg_of("let x = 0; let i = 0; while i < 5 { x = x + i; i = i + 1; }");
if len(wc.blocks) < 2 { fail("while CFG should have multiple blocks"); }
let wdoms = ir.compute_dominators(wc);
if len(wdoms.idom) != len(wc.blocks) { fail("idom length must equal block count"); }
if wdoms.idom[0] != 0 - 1 { fail("entry block must have no immediate dominator"); }
let wloops = ir.detect_loops(wc, wdoms);
if wloops.count < 1 { fail("the while loop must be detected (back-edge)"); }

// 2. An if/else must split into multiple blocks and dominate from the entry.
let ic = cfg_of("let x = 0; if x < 1 { x = 10; } else { x = 20; } let y = x;");
if len(ic.blocks) < 3 { fail("if/else CFG should have then/else/merge blocks"); }
let idoms = ir.compute_dominators(ic);
if len(idoms.idom) != len(ic.blocks) { fail("if/else idom length mismatch"); }

// 3. Short-circuit and/or (peek jumps) must not crash the CFG builder.
let sc = cfg_of("let a = true; let b = false; let x = a and b; let y = a or b;");
let sdoms = ir.compute_dominators(sc);
let sloops = ir.detect_loops(sc, sdoms);
// (no assertion on counts — the point is no crash on peek-jump control flow)

// 4. A straight-line program: one or more blocks, no loops.
let lc = cfg_of("let x = 1 + 2; let y = x * 3;");
let ldoms = ir.compute_dominators(lc);
let lloops = ir.detect_loops(lc, ldoms);
if lloops.count != 0 { fail("straight-line code must have no loops"); }

print "selfhost_ir_cfg_pass";
