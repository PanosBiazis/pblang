// tests/semantics/window_probe_test.sapp — parse real OS window geometry (pblang-only).
// The live probe shells out to the window manager (xwininfo/xdotool); here we test the
// PURE parser on captured tool output (no window/display needed).

let WP = import("stdlib/window_probe.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── xwininfo block: Width / Height lines (ignores "Border width:") ────────────────
let xwininfo = "xwininfo: Window id: 0x3a00007 \"pblang IDE - Smart Code Editor\"\n"
    + "  Absolute upper-left X:  120\n"
    + "  Absolute upper-left Y:  80\n"
    + "  Border width: 0\n"
    + "  Width: 1920\n"
    + "  Height: 1040\n"
    + "  Depth: 24\n";
let a = WP.parse_geometry(xwininfo);
eq(a.w, 1920, "xwininfo width"); eq(a.h, 1040, "xwininfo height");

// ── xdotool getwindowgeometry: "Geometry: WxH" ────────────────────────────────────
let xdotool = "Window 62914567\n  Position: 120,80 (screen: 0)\n  Geometry: 2560x1380\n";
let b = WP.parse_geometry(xdotool);
eq(b.w, 2560, "xdotool width"); eq(b.h, 1380, "xdotool height");

// ── no geometry present -> nil ────────────────────────────────────────────────────
if WP.parse_geometry("no size information here at all") != nil { fail("nil when absent"); }

// ── Geometry preferred when both forms appear ─────────────────────────────────────
let both = "  Width: 100\n  Height: 200\n  Geometry: 1366x768\n";
let c = WP.parse_geometry(both);
eq(c.w, 1366, "prefers Geometry: line"); eq(c.h, 768, "prefers Geometry: line");

// changed(prev, cur) helper: detect a resize
if WP.changed(map{ w: 100, h: 100 }, map{ w: 100, h: 100 }) { fail("same size -> not changed"); }
if not WP.changed(map{ w: 100, h: 100 }, map{ w: 120, h: 100 }) { fail("different size -> changed"); }
if not WP.changed(nil, map{ w: 100, h: 100 }) { fail("nil prev -> changed"); }

let win_sz = map{ w: 1280, h: 760 };
let mon_sz = map{ w: 3840, h: 2160 };
let basis_a = WP.display_size_for_window(win_sz, mon_sz);
eq(basis_a.w, 3840, "monitor size preferred for density basis");
eq(basis_a.h, 2160, "monitor height preferred for density basis");
let basis_b = WP.display_size_for_window(win_sz, nil);
eq(basis_b.w, 1280, "window size fallback for density basis");
eq(basis_b.h, 760, "window height fallback for density basis");

print "window_probe_pass";
