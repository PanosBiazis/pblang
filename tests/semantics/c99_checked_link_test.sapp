let C = import("stdlib:compiler/ctranspile.sapp");
let L = import("stdlib:source_inliner.sapp");
let S = import("stdlib:compiler/checked_source.sapp");
fn rejects(work) { return try { work(); false } catch true; }
let root = "let a=import(\"a.sapp\"); let b=import(\"b.sapp\");";
// A generic concatenation can heal broken raw files. Compiler linking cannot.
for modules in [map{ "a.sapp": "/* open", "b.sapp": "*/ fn value(){return 7;}" },
    map{ "a.sapp": "fn value(){", "b.sapp": "return 7;}" }] {
    let generic = L.link_modules(root, modules);
    assert(generic.ok and len(S.parse_linked_source(generic.source).errors)==0, "positive control: flattened source heals raw syntax");
    let checked = C.transpile_program_linked(root, modules);
    assert(not checked.ok and not map_has(checked, "source"), "raw module rejection precedes concatenation");
}
for text in ["fn f(){return 7;", "/* unfinished", "let s=\"unfinished", "let x=0x;"] {
    assert(not C.transpile_program_linked(text, map{}).ok, "raw main admission");
    assert(not C.transpile_program_linked("let m=import(\"m.sapp\");", map{"m.sapp":text}).ok, "raw reachable module admission");
}
let good = map{"m.sapp":"fn value(){return 42;} export value;", "unused.sapp":"/* unfinished"};
let main = "let m=import(\"m.sapp\"); print m.value();";
assert(C.transpile_program_linked(main, good).ok, "unreachable syntax does not block build");
let generic = L.link_modules(main, good);
assert(C.transpile_program_linked(main, good, map{max_linked_source_bytes:generic.output_bytes}).ok, "inclusive output byte cap");
assert(not C.transpile_program_linked(main, good, map{max_linked_source_bytes:generic.output_bytes-1}).ok, "lower output byte cap enforced");
assert(L.link_modules("", map{}, map{max_linked_source_bytes:134217728}).ok, "generic linker ceiling unchanged");
assert(not C.transpile_program_linked("", map{}, map{max_linked_source_bytes:16777217}).ok, "C checked ceiling cannot widen");
for cap in [nil, true, "large", 0, -1, 1.5, parse_number("NaN"), parse_number("inf")] {
    assert(not C.transpile_program_linked("", map{}, map{max_linked_source_bytes:cap}).ok, "malformed link cap fails closed");
    assert(rejects(fn(){ S.parse_linked_source("", cap); }), "malformed helper byte cap");
    assert(rejects(fn(){ S.parse_linked_source("", 100, cap); }), "malformed helper token cap");
}
assert(len(S.parse_linked_source("return 7;", 9, 4).stmts)==1, "exact linked helper caps");
assert(rejects(fn(){ S.parse_linked_source("return 7;", 8, 4); }), "linked byte overflow");
assert(rejects(fn(){ S.parse_linked_source("return 7;", 9, 3); }), "linked token overflow");
assert(rejects(fn(){ S.parse_linked_source("", 16777217); }), "hard linked byte cap");
assert(rejects(fn(){ S.parse_linked_source("", 100, 1048577); }), "hard linked token cap");
// Two individually small modules can exceed the direct 1 MiB profile together.
let padding = "/*" + str_repeat(" ", 530000) + "*/";
let large = map{"a.sapp":padding + "fn value(){return 40;} export value;",
    "b.sapp":padding + "fn value(){return 2;} export value;"};
let large_main = root + "print a.value()+b.value();";
let combined = L.link_modules(large_main, large);
assert(combined.ok and combined.output_bytes>1048576, "large linked control");
assert(rejects(fn(){ C.transpile_program(combined.source); }), "direct cap unchanged");
for numeric in ["float", "integer"] {
    assert(C.transpile_program_linked(large_main, large, map{numeric:numeric}).ok, "linked profile above direct cap");
}
print "c99_checked_link_pass";
