// Test: pblang pb-mcp-server HTTP API uses scoped CORS, not wildcard CORS.

let srv = import("editors/ide/tools/mcpservers/pb-mcp-server/src/server.sapp");

fn fail(m) { throw "FAIL " + m; }

let src = try fs_read("editors/ide/tools/mcpservers/pb-mcp-server/src/server.sapp") catch "";
if str_contains(src, "\"Access-Control-Allow-Origin\": \"*\"") {
    fail("pb-mcp pblang server must not use wildcard CORS");
}
if not str_contains(src, "PB_MCP_ALLOWED_ORIGINS") or not str_contains(src, "\"Vary\": \"Origin\"") {
    fail("pb-mcp pblang server exposes explicit CORS policy");
}

let loopback = srv.handler(map{
    method: "OPTIONS",
    path: "/tools",
    headers: map{ "Origin": "http://localhost:8090" },
    body: ""
});
if loopback.status != 200 or loopback.headers["Access-Control-Allow-Origin"] != "http://localhost:8090" {
    fail("loopback browser origin is allowed");
}

let file_origin = srv.handler(map{
    method: "GET",
    path: "/health",
    headers: map{ "Origin": "null" },
    body: ""
});
if file_origin.status != 200 or file_origin.headers["Access-Control-Allow-Origin"] != "null" {
    fail("file/null IDE origin is allowed");
}

let denied = srv.handler(map{
    method: "POST",
    path: "/call",
    headers: map{ "Origin": "https://evil.example" },
    body: "{\"tool\":\"workspace_context\",\"args\":{}}"
});
if denied.status != 403 { fail("non-allowlisted browser origin is rejected"); }
let denied_acao = try denied.headers["Access-Control-Allow-Origin"] catch nil;
if denied_acao != nil {
    fail("denied origin must not receive Access-Control-Allow-Origin");
}

let network_disabled = try {
    srv.serve("127.0.0.1:0");
    false;
} catch true;
if not network_disabled {
    fail("embedded snapshot must not expose its effectful router as a network service");
}

print "pb_mcp_server_cors_pass";
