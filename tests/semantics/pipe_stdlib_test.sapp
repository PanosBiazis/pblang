// tests/semantics/pipe_stdlib_test.sapp
let pipe = import("stdlib:pipe.sapp");

// chain
fn add1(x) { return x + 1; }
fn double(x) { return x * 2; }

let r = pipe.chain(3, [add1, double, add1]);
if r != 9 { throw "FAIL chain: expected 9 got " + str(r); }

// compose: f(g(x))
let add1_then_double = pipe.compose(double, add1);
let r2 = add1_then_double(4);
if r2 != 10 { throw "FAIL compose: expected 10 got " + str(r2); }

// pipe_fns
let pipeline = pipe.pipe_fns([add1, double]);
let r3 = pipeline(5);
if r3 != 12 { throw "FAIL pipe_fns: expected 12 got " + str(r3); }

// partial
fn add(a, b) { return a + b; }
let add10 = pipe.partial(add, 10);
let r4 = add10(5);
if r4 != 15 { throw "FAIL partial: expected 15 got " + str(r4); }

// identity
let r5 = pipe.identity(42);
if r5 != 42 { throw "FAIL identity"; }

// const_fn
let always5 = pipe.const_fn(5);
if always5(999) != 5 { throw "FAIL const_fn"; }

// memoize
let call_count = 0;
fn expensive(x) {
    call_count = call_count + 1;
    return x * x;
}
let memo_sq = pipe.memoize(expensive);
let m1 = memo_sq(7);
let m2 = memo_sq(7);  // should use cache
if m1 != 49 or m2 != 49 { throw "FAIL memoize result"; }
if call_count != 1 { throw "FAIL memoize cache"; }

// map_fn, filter_fn, reduce_fn
let arr = [1, 2, 3, 4, 5];
let doubled = pipe.map_fn(double, arr);
if doubled[2] != 6 { throw "FAIL map_fn"; }

fn is_even(x) { return num_mod(x, 2) == 0; }
let evens = pipe.filter_fn(is_even, arr);
if len(evens) != 2 { throw "FAIL filter_fn"; }

fn sum_fn(acc, x) { return acc + x; }
let total = pipe.reduce_fn(sum_fn, 0, arr);
if total != 15 { throw "FAIL reduce_fn: expected 15 got " + str(total); }

print "pipe_stdlib_pass";
