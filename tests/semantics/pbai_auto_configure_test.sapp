// tests/semantics/pbai_auto_configure_test.sapp — auto mode selection. The engine can
// run in three decision modes (static weights / adaptive global reliability / per-
// category routing). auto_configure(examples) measures ensemble accuracy under each on
// a labeled set, keeps the best mode, and reports all scores — no more guessing which
// weighting strategy fits the current voter pool.

let ens = import("stdlib/pbai_ensemble.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let scores = fn(p) { return map{ intent: "bugs", scores: [0.05, 0.9, 0.05, 0.05, 0.05] }; };
ens.configure(scores, ["explain", "bugs", "improve", "comment", "general"]);
ens.clear_voters();
ens.reset_stats();
ens.set_adaptive(false);
ens.set_routing(false);
ens.set_parallel(false);
ens.set_native_weight(1);

// a heavy but always-wrong voter dominates in static mode
ens.register_voter_weighted("bad", fn(x) { return "explain"; }, 3);

let examples = [ map{ prompt: "a", intent: "bugs" }, map{ prompt: "b", intent: "bugs" },
                 map{ prompt: "c", intent: "bugs" }, map{ prompt: "d", intent: "bugs" } ];

// teach the stats who is trustworthy (adaptive modes need history)
let i = 0;
while i < len(examples) { ens.ensemble_detail(examples[i].prompt); ens.record_outcome(examples[i].intent); i = i + 1; }

// static mode is wrong on these examples...
eq(ens.ensemble("x"), "explain", "static mode follows the heavy wrong voter");

// ...so auto_configure must pick an adaptive mode and leave the engine in it
let r = ens.auto_configure(examples);
if r.mode == "static" { fail("auto_configure should not keep the losing static mode"); }
eq(r.accuracy, 1, "best mode gets all examples right");
eq(r.results["static"], 0, "static scored 0 on the set");
eq(ens.ensemble("y"), "bugs", "engine left running in the winning mode");

// ties prefer the simplest mode: with no voters every mode scores 1 -> static wins
ens.clear_voters();
ens.reset_stats();
let r2 = ens.auto_configure(examples);
eq(r2.mode, "static", "tie -> simplest mode (static)");
eq(ens.ensemble("z"), "bugs", "static engine still right");

ens.set_adaptive(false);
ens.set_routing(false);
ens.clear_voters();
ens.reset_stats();
print "pbai_auto_configure_pass";
