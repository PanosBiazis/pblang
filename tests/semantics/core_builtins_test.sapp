// tests/semantics/core_builtins_test.sapp
// Tests for: range, enumerate, sum, min_of, max_of, product, clamp,
//            is_number, is_string, is_array, is_map, is_bool, is_fn, is_nil

// ---- range ----
let r1 = range(5);
if len(r1) != 5 { throw "FAIL range(5) len: " + str(len(r1)); }
if r1[0] != 0 or r1[4] != 4 { throw "FAIL range(5) values"; }

let r2 = range(2, 7);
if len(r2) != 5 { throw "FAIL range(2,7) len: " + str(len(r2)); }
if r2[0] != 2 or r2[4] != 6 { throw "FAIL range(2,7) values"; }

let r3 = range(0, 10, 2);
if len(r3) != 5 { throw "FAIL range step len: " + str(len(r3)); }
if r3[2] != 4 { throw "FAIL range step value: " + str(r3[2]); }

// ---- enumerate ----
let e = enumerate(["a", "b", "c"]);
if len(e) != 3 { throw "FAIL enumerate len"; }
if e[0][0] != 0 or e[0][1] != "a" { throw "FAIL enumerate[0]"; }
if e[2][0] != 2 or e[2][1] != "c" { throw "FAIL enumerate[2]"; }

// ---- sum, min_of, max_of, product ----
let nums = [3, 1, 4, 1, 5, 9, 2, 6];
if sum(nums) != 31 { throw "FAIL sum: " + str(sum(nums)); }
if min_of(nums) != 1 { throw "FAIL min_of: " + str(min_of(nums)); }
if max_of(nums) != 9 { throw "FAIL max_of: " + str(max_of(nums)); }
if product([1, 2, 3, 4]) != 24 { throw "FAIL product"; }

// empty arrays
if min_of([]) != nil { throw "FAIL min_of empty"; }
if max_of([]) != nil { throw "FAIL max_of empty"; }
if sum([]) != 0 { throw "FAIL sum empty"; }

// ---- clamp ----
if clamp(5, 0, 10) != 5 { throw "FAIL clamp mid"; }
if clamp(-5, 0, 10) != 0 { throw "FAIL clamp below"; }
if clamp(15, 0, 10) != 10 { throw "FAIL clamp above"; }

// ---- type predicates ----
if is_number(42) == false { throw "FAIL is_number 42"; }
if is_number("x") { throw "FAIL is_number string"; }
if is_number(nil) { throw "FAIL is_number nil"; }

if is_string("hello") == false { throw "FAIL is_string"; }
if is_string(42) { throw "FAIL is_string num"; }

if is_array([1,2]) == false { throw "FAIL is_array"; }
if is_array(map{}) { throw "FAIL is_array map"; }

if is_map(map{}) == false { throw "FAIL is_map"; }
if is_map([]) { throw "FAIL is_map array"; }

if is_bool(true) == false { throw "FAIL is_bool true"; }
if is_bool(false) == false { throw "FAIL is_bool false"; }
if is_bool(0) { throw "FAIL is_bool num"; }

fn myf() { return 1; }
if is_fn(myf) == false { throw "FAIL is_fn"; }
if is_fn(42) { throw "FAIL is_fn num"; }

if is_nil(nil) == false { throw "FAIL is_nil nil"; }
if is_nil(0) { throw "FAIL is_nil 0"; }
if is_nil("") { throw "FAIL is_nil empty str"; }

// ---- for x in range(n) pattern ----
let total = 0;
for i in range(1, 6) {
    total = total + i;
}
if total != 15 { throw "FAIL for-in range: " + str(total); }

// ---- enumerate in for-in ----
let pairs = [];
for pair in enumerate(["x", "y", "z"]) {
    array_push(pairs, pair[0]);
}
if pairs[0] != 0 or pairs[2] != 2 { throw "FAIL enumerate for-in"; }

print "core_builtins_pass";
