// tests/semantics/pbai_parallel_voters_test.sapp — query all voters CONCURRENTLY. A multi-LLM
// ensemble shouldn't be gated by the slowest model: with set_parallel(true) each voter runs in
// its own thread (fork/join, shared heap) and results are combined identically to sequential.

let pbai = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

pbai.clear_voters();
pbai.reset_stats();
pbai.set_adaptive(false);
pbai.register_voter("a", fn(x) { return "bugs"; });
pbai.register_voter("b", fn(x) { return "improve"; });
pbai.register_voter("c", fn(x) { return map{ intent: "bugs", confidence: 0.8 }; });
pbai.register_voter("d", fn(x) { return nil; });                 // abstains (tests nil join)
let p = "explain this function";

// sequential baseline
pbai.set_parallel(false);
let dseq = pbai.ensemble_detail(p);

// parallel must be identical (same winner, same weighted tally, same voter count)
pbai.set_parallel(true);
let dpar = pbai.ensemble_detail(p);

eq(dpar.intent, dseq.intent, "parallel winner == sequential");
eq(dpar.voters, dseq.voters, "same voter count");
eq(dpar.voters, 5, "native + 4 registered");
let keys = map_keys(dseq.tally);
eq(len(map_keys(dpar.tally)), len(keys), "same set of tallied intents");
let i = 0;
while i < len(keys) { approx(dpar.tally[keys[i]], dseq.tally[keys[i]], "tally[" + keys[i] + "] matches"); i = i + 1; }

// ensemble() top-level also equivalent
pbai.set_parallel(false);
let seq_win = pbai.ensemble(p);
pbai.set_parallel(true);
eq(pbai.ensemble(p), seq_win, "ensemble() parallel == sequential");

pbai.set_parallel(false);
pbai.clear_voters();
pbai.reset_stats();
print "pbai_parallel_voters_pass";
