// tests/semantics/option_result_enrich_test.sapp — enrichment for option.sapp + result.sapp

let O = import("stdlib/option.sapp");
let R = import("stdlib/result.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── option.contains ─────────────────────────────────────────────────────────────────
if not O.contains(O.some(5), 5) { fail("Some(5) contains 5"); }
if O.contains(O.some(5), 6) { fail("Some(5) not contains 6"); }
if O.contains(O.none(), 5) { fail("None contains nothing"); }

// ── option.to_result <-> result.to_option round trips ─────────────────────────────
let r1 = O.to_result(O.some(42), "missing");
if not R.is_ok(r1) { fail("Some -> Ok"); }
eq(R.unwrap(r1), 42, "Ok value preserved");
let r2 = O.to_result(O.none(), "missing");
if not R.is_err(r2) { fail("None -> Err"); }
eq(R.unwrap_err(r2), "missing", "Err carries the supplied value");

let o1 = R.to_option(R.ok(7));
if not O.is_some(o1) { fail("Ok -> Some"); }
eq(O.unwrap(o1), 7, "Some value preserved");
let o2 = R.to_option(R.err("boom"));
if not O.is_none(o2) { fail("Err -> None"); }

// ── result.unwrap_err / expect ────────────────────────────────────────────────────
eq(R.unwrap_err(R.err("boom")), "boom", "unwrap_err");
eq(R.expect(R.ok(9), "should be ok"), 9, "expect returns Ok value");

print "option_result_enrich_pass";
