let S=import("stdlib:strings.sapp");
let A=import("stdlib:algorithms_advanced.sapp");
let E=import("stdlib:edit_distance.sapp");
fn eq(a,b,label) { if a!=b {throw "FAIL edit_distance: "+label+" got="+str(a)+" expected="+str(b);} }

// Independent full matrix oracle, without trimming, banding or row reuse.
fn oracle(a,b) {
    let table=[];
    for i len(a)+1 {
        let row=[];
        for _j len(b)+1 {push(row,0);}
        row[0]=i;push(table,row);
    }
    for j len(b)+1 {table[0][j]=j;}
    for oi len(a) {
        let i=oi+1;
        for oj len(b) {
            let j=oj+1;
            let cost=1;if a[i-1]==b[j-1] {cost=0;}
            let best=table[i-1][j]+1;
            if table[i][j-1]+1<best {best=table[i][j-1]+1;}
            if table[i-1][j-1]+cost<best {best=table[i-1][j-1]+cost;}
            table[i][j]=best;
        }
    }
    return table[len(a)][len(b)];
}
let samples=[""]; let level=[""];
for _depth 3 {
    let next=[];
    for s in level {for c in ["a","β"] {push(next,s+c);push(samples,s+c);}}
    level=next;
}
for extra in ["🙂","a🙂β","é","é","東京","a\nβ"] {push(samples,extra);}
let pairs=0;
for a in samples {
    for b in samples {
        let expected=oracle(a,b);
        eq(S.levenshtein(a,b),expected,"strings oracle");
        eq(A.levenshtein(a,b),expected,"algorithms oracle");
        for k 4 {
            let clipped=expected;if clipped>k {clipped=k+1;}
            eq(E.within(a,b,k),clipped,"band oracle");
        }
        pairs=pairs+1;
    }
}
eq(pairs,441,"exhaustive pair count");
eq(S.levenshtein("kitten","sitting"),3,"known distance");
eq(S.levenshtein("ab","ba"),2,"transposition costs two");
eq(S.levenshtein("é","é"),2,"no Unicode normalization");
eq(S.levenshtein_within("kitten","sitting",2),3,"strings facade");
eq(A.levenshtein_within("kitten","sitting",3),3,"algorithms facade");
let x=[1,nil,true,"β"];let y=[1,false,"β"];
eq(A.levenshtein(x,y),2,"array compatibility");
eq(S.levenshtein(x,y),2,"strings legacy array compatibility");
eq(x,[1,nil,true,"β"],"input unchanged");eq(y,[1,false,"β"],"second input unchanged");
eq(S.levenshtein("aβ",["a","β"]),0,"mixed sequence compatibility");
let prefix=str_repeat("🙂α",300);let suffix=str_repeat("β",300);
eq(E.distance(prefix+"xyz"+suffix,prefix+"xQz"+suffix),1,"large common ends");
eq(E.within(prefix+"xyz"+suffix,prefix+"xQz"+suffix,1),1,"trimmed band");
eq(E.within(str_repeat("a",4096),"",4096),4096,"length limit accepted");
eq(E.within("",str_repeat("a",4096),0),1,"length difference rejection");
eq(E.within("a",str_repeat("b",4096),4096),4096,"wide band asymmetric");
for invalid in [-1,0.5,4097,nil,"1",true,[],map{}] {
    eq(try {E.within("a","a",invalid);false} catch true,true,"invalid limit");
}
eq(try {E.within(str_repeat("a",4097),"",0);false} catch true,true,"oversize text");
eq(try {E.within([],"",1);false} catch true,true,"within requires strings");
eq(try {E.within("",[],1);false} catch true,true,"second input type");
let nan=parse_number("NaN");let inf=parse_number("inf");
if nan!=nil {eq(try {E.within("","",nan);false} catch true,true,"NaN limit");}
if inf!=nil {eq(try {E.within("","",inf);false} catch true,true,"infinite limit");}
print "edit_distance_pass";
