let Binary = import("stdlib:host_pbck_frame_binary.sapp");
let Dynamic = import("stdlib:host_pbck_frame_dynamic_lowering.sapp");
let FrameVM = import("stdlib:host_pbck_frame_vm.sapp");
let Plan = import("stdlib:host_pbck_frame_plan.sapp");

fn fail(message) { throw "FAIL host_pbck_frame_dynamic_lowering: " + message; }
fn rejects(work, message) { if not (try { work(); false } catch true) { fail(message); } }
fn mutable_image(image) {
    let encoded = json_stringify(image);
    encoded = str_replace_all(encoded, "\"__frozen\":true,", "");
    encoded = str_replace_all(encoded, ",\"__frozen\":true", "");
    return json_parse(encoded);
}

let child = map{
    __pbck_function: true, name: "dynamic_child", arity: 1, min_arity: 0,
    defaults: [true], is_vararg: false, parameter_types: [2],
    chunk: map{ instructions: [map{ op: 25, operand: 0 }, map{ op: 33 }],
        constants: [], source_name: nil }
};
let decoded = map{
    format: "host-pbck-v1", version: 1, artifact_bytes: 4096,
    chunk: map{
        instructions: [
            map{ op: 0, operand: 0 }, map{ op: 0, operand: 1 },
            map{ op: 20, operand: 1 }, map{ op: 0, operand: 0 },
            map{ op: 21 }, map{ op: 26, operand: 0 },
            map{ op: 23, operand: 11 }, map{ op: 0, operand: 2 },
            map{ op: 47 }, map{ op: 24 }, map{ op: 35, operand: 12 },
            map{ op: 11 }, map{ op: 14, operand: 3 },
            map{ op: 25, operand: 0 }, map{ op: 31, operand: 1 },
            map{ op: 33 }
        ],
        constants: ["key", 41, "guest failure", "increment", false, nil,
            map{ __pbck_numeric: "bigint", text: "9007199254740993" },
            map{ __pbck_numeric: "rational", text: "22/7" }, child],
        source_name: nil
    }
};

let plan = Plan.build_decoded(decoded);
let image = Dynamic.build(plan);
let report = Dynamic.validate(image);
if not report.ok or report.format != Dynamic.FORMAT or report.version != 1
    or not report.dynamic_values or not report.exceptions
    or report.canonical_opcodes != 48 or report.functions != 2
    or report.instructions != 18 or report.constants != 10
    or report.sha256 != image.sha256 or len(image.sha256) != 64 {
    fail("dynamic lowering descriptor mismatch: " + str(report));
}

let rebuilt = Dynamic.to_plan(image);
if Binary.encode_plan(rebuilt) != Binary.encode_plan(plan) {
    fail("dynamic lowering did not round-trip canonically");
}
let calls = 0;
let options = map{ max_steps: 100, adapters: map{ increment: fn(args) {
    calls = calls + 1;
    if len(args) != 1 or not is_number(args[0]) { throw "private provider detail"; }
    return args[0] + 1;
} } };
let lowered = Dynamic.run(image, options);
let direct = FrameVM.run(plan, options);
if lowered.value != 42 or direct.value != 42
    or lowered.runtime.steps != direct.runtime.steps or calls != 2 {
    fail("dynamic execution parity mismatch");
}

// The image must retain every canonical instruction shape even when a fixture
// is intentionally not executable as one linear program.
let instructions = []; let op = 0;
while op < 48 {
    if op == 27 {
        array_push(instructions, map{ op: op, fn_const: 1,
            captures: [map{ is_local: true, index: 0 }] });
    } elif op == 0 or (op >= 13 and op <= 18) or op == 42 {
        array_push(instructions, map{ op: op, operand: 0 });
    } elif (op >= 19 and op <= 20) or op == 23 or op == 25 or op == 26
        or op == 28 or op == 29 or op == 31 or op == 32
        or (op >= 35 and op <= 37) {
        let operand = 0;
        if op == 23 or (op >= 35 and op <= 37) { operand = 48; }
        array_push(instructions, map{ op: op, operand: operand });
    } else { array_push(instructions, map{ op: op }); }
    op = op + 1;
}
let exhaustive_child = map{
    __pbck_function: true, name: "all", arity: 1, min_arity: 1,
    defaults: [], is_vararg: false, parameter_types: [0],
    chunk: map{ instructions: instructions, constants: ["name", child], source_name: nil }
};
let exhaustive = Plan.build_decoded(map{
    format: "host-pbck-v1", version: 1,
    chunk: map{ instructions: [map{ op: 0, operand: 0 }, map{ op: 11 },
        map{ op: 0, operand: 1 }, map{ op: 11 }, map{ op: 0, operand: 2 },
        map{ op: 33 }], constants: [false, exhaustive_child, nil], source_name: nil }
});
let exhaustive_image = Dynamic.build(exhaustive);
if exhaustive_image.instruction_count != 56
    or Binary.encode_plan(Dynamic.to_plan(exhaustive_image)) != Binary.encode_plan(exhaustive) {
    fail("48-opcode dynamic lowering mismatch");
}

let tampered = mutable_image(Dynamic.build(plan));
tampered.operands[0] = 999999;
rejects(fn() { Dynamic.validate(tampered); }, "tampered operand accepted");
tampered = mutable_image(Dynamic.build(plan)); tampered.sha256 = str_repeat("0", 64);
rejects(fn() { Dynamic.validate(tampered); }, "tampered digest accepted");
tampered = mutable_image(Dynamic.build(plan)); tampered.function_is_vararg[0] = 1;
rejects(fn() { Dynamic.validate(tampered); }, "invalid dynamic metadata accepted");

let provider_failure = try {
    Dynamic.run(image, map{ max_steps: 100, adapters: map{
        increment: fn(args) { throw "secret /data/user/0/token"; }
    } });
    "not rejected"
} catch str(error);
if str_contains(provider_failure, "/data/user/0/token") {
    fail("provider exception detail leaked");
}

print "host_pbck_frame_dynamic_lowering_pass";
