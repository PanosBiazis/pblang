if platform() != "linux" {print "native_static_bundle_skip_linux_required";os_exit(0);}
let Native=import("stdlib:compiler/native_bundle.sapp");
let UUID=import("stdlib:uuid.sapp");
let exe=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let output=path_join(cwd(),".bundle_"+UUID.v4()+".pbck");
let source="fn exercise(){for i 2 {let p=map{run:fn(self){return 7;}};print (try {p:run()} catch 9);}}export exercise;";
let blob=Native.compile_bundle("let m=import /*gap*/ (\"virtual-dependency\");m.exercise();",fn(path){
    if path == "virtual-dependency" {return source;} return nil;
});
// No source dependency exists on disk. Deny filesystem/process/network grants
// during execution, proving the import was linked and not runtime-resolved.
fs_write_bytes(output,blob);
let result=try proc_spawn_wait("/usr/bin/timeout",["-k","1s","15s",exe,"run",output,"--sandbox"]) catch nil;
fs_remove(output);
assert(result != nil and result.exit_code==0 and result.stdout=="7\n7\n","sandbox executes corrected imported methods");
print "native_static_bundle_pass";
