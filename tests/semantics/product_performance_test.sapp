let P = import("stdlib:product_performance.sapp");

let self = P.self_check("pblang");
assert(self.ok and not self.sampled, "contract self-check is deterministic and unsampled");
assert(len(self.checks) == 4, "standard contract covers latency, memory, artifact size, and throughput");

let measured = P.resolve("pbide", map{
    baseline: map{ latency_ms: 10, memory_bytes: 1000, artifact_bytes: 500, throughput_per_second: 100 },
    candidate: map{ latency_ms: 9, memory_bytes: 1020, artifact_bytes: 490, throughput_per_second: 110 },
    budgets: P.standard_budgets(), source: "semantic-test"
});
assert(measured.ok and measured.sampled, "measured multi-category contract passes");
assert(P.health_check("performance_budget", measured, true).status == "ready", "performance result adapts to product health");

let failed = P.resolve("pbai", map{
    baseline: map{ throughput_per_second: 100 }, candidate: map{ throughput_per_second: 90 },
    budgets: [map{ metric: "throughput_per_second", max_regression_percent: 5, lower_is_better: false }]
});
assert(not failed.ok and P.health_check("performance_budget", failed, true).status == "blocked", "throughput regression fails closed");
let suite = P.suite([self, measured, failed]);
assert(not suite.ok and suite.passed == 2 and suite.failed == 1 and suite.sampled == 2, "suite aggregates product contracts");
print "product_performance_pass";
