// Complete hosted C99 path: pblang source -> C -> bounded native process.
let C99 = import("stdlib/compiler/ctranspile.sapp");

fn fail(message) { throw "FAIL " + message; }

let source = "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } print fib(10); print \"done\";";
let generated = C99.transpile_program(source);
if not str_contains(generated, "int main(void)") { fail("hosted unit has no C main"); }
if not str_contains(generated, "printf(\"%.17g\\n\"") { fail("numeric print was not lowered"); }
if not str_contains(generated, "puts((const char*)(uintptr_t)") { fail("string print was not lowered"); }
let freestanding_print = false;
try { C99.transpile("fn f() { print 1; }"); } catch { freestanding_print = true; }
if not freestanding_print { fail("freestanding print must fail instead of disappearing"); }

let unknown_expr = false;
try { C99.transpile_expr(map{ kind: "future_expr" }); } catch { unknown_expr = true; }
if not unknown_expr { fail("unknown expression must fail closed"); }
let unknown_stmt = false;
try { C99.transpile_stmt(map{ kind: "future_stmt" }, 0); } catch { unknown_stmt = true; }
if not unknown_stmt { fail("unknown statement must fail closed"); }
let unresolved_import = false;
try { C99.transpile_program("import \"missing.sapp\"; print 1;"); } catch { unresolved_import = true; }
if not unresolved_import { fail("unresolved hosted import must fail closed"); }

let conditional = C99.transpile_program("let x = 1; let y = (x = 41) + 1; print x > 40 ? y : 0;");
if not str_contains(conditional, "? y : 0") or not str_contains(conditional, "(x = 41)") {
    fail("if-expression or assignment-expression lowering missing");
}

// A failed integer translation must restore both numeric and hosted mode.
let failed_integer = false;
try { C99.transpile_program_int("import \"missing.sapp\"; print 1;"); } catch { failed_integer = true; }
if not failed_integer { fail("unsupported import must be rejected by integer C99"); }
let recovered_mode = C99.transpile_program("print 1;");
if not str_contains(recovered_mode, "double") or str_contains(recovered_mode, "printf(\"%ld") {
    fail("C99 mode leaked after rejected integer translation");
}

let closure_source = "fn apply(f, x) { return f(x); } "
    + "fn inc(x) { return x + 1; } "
    + "fn scale(k) { return fn(x) { return x * k; }; } "
    + "fn counter(start) { let n = start; return fn(step) { n = n + step; return n; }; } "
    + "fn nested(a) { return fn(b) { return fn(c) { return a + b + c; }; }; } "
    + "let c = counter(10); print apply(scale(6), 7); print apply(inc, 41); print c(1); print c(2); "
    + "let n1 = nested(1); let n2 = n1(2); print n2(3);";
let closure_c = C99.transpile_program(closure_source);
if not str_contains(closure_c, "struct pb_closure")
    or not str_contains(closure_c, "pb_closure_new(pb_lambda_")
    or not str_contains(closure_c, "pb_named_value_inc()")
    or not str_contains(closure_c, "pb_closure_call(_pb_fn") {
    fail("hosted closure conversion/runtime missing");
}
let closure_int_c = C99.transpile_program_int("fn outer(x) { return fn(y) { return x + y; }; } let f = outer(40); print f(2);");
if str_contains(closure_int_c, "double") or not str_contains(closure_int_c, "struct pb_closure") {
    fail("integer closure conversion did not remain float-free");
}
let freestanding_closure = false;
try { C99.transpile("fn outer(x) { return fn(y) { return x + y; }; }"); } catch { freestanding_closure = true; }
if not freestanding_closure { fail("freestanding closure must fail until a bounded no-libc lifetime policy exists"); }

let renamed = C99.transpile_program("fn main() { return 42; }");
if not str_contains(renamed, "double pb_main(") or not str_contains(renamed, "return (int)pb_main();") {
    fail("pblang main must be renamed and called by the hosted entry");
}

let integer_c = C99.transpile_program_int("fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } print fib(10);");
if str_contains(integer_c, "double") or not str_contains(integer_c, "long fib(long n)") or not str_contains(integer_c, "printf(\"%ld\\n\"") {
    fail("explicit integer hosted profile was not lowered as long");
}

let project_modules = map{
    "lib/math.sapp": "const BASE = 40; fn add(a, b) { return BASE + a + b; } export add;",
    "lib/factory.sapp": "let M = import(\"math.sapp\"); const OFFSET = 2; let OP = fn(x) { return M.add(x, OFFSET); }; let CALLS = 0; fn answer() { CALLS = CALLS + 1; return OP(0) + CALLS - 1; } export answer;"
};
let project_main = "let F = import(\"../lib/factory.sapp\"); print F.answer();";
let linked_c = C99.transpile_program_linked(project_main, project_modules, map{ entry_path: "app/main.sapp" });
if not linked_c.ok or linked_c.link.modules != 2 or not str_contains(linked_c.source, "pb_closure_new(pb_lambda_")
    or not str_contains(linked_c.source, "static double __pbi0_BASE = 0;")
    or not str_contains(linked_c.source, "static double __pbi1_OP = 0;") {
    fail("linked hosted C99 project did not lower modules and closure");
}
let linked_integer_c = C99.transpile_program_linked(project_main, project_modules,
    map{ entry_path: "app/main.sapp", numeric: "integer" });
if not linked_integer_c.ok or not str_contains(linked_integer_c.source, "static long __pbi0_BASE = 0;")
    or str_contains(linked_integer_c.source, "static double __pbi0_BASE") {
    fail("linked integer C99 globals did not remain float-free");
}
let global_linked = C99.transpile_program_linked("let X = import(\"x.sapp\"); print X.value();",
    map{ "x.sapp": "const K = 42; fn value() { return K; } export value;" });
if not global_linked.ok or not str_contains(global_linked.source, "static double __pbi0_K = 0;")
    or not str_contains(global_linked.source, "__pbi0_K = 42;") {
    fail("module global storage or ordered initialization is missing");
}
let ordinary_globals = C99.transpile_program(
    "let counter = 40; fn bump() { counter = counter + 1; return counter; } print bump(); print bump();");
if not str_contains(ordinary_globals, "static double counter = 0;")
    or not str_contains(ordinary_globals, "counter = 40;") {
    fail("ordinary hosted globals were not lowered to translation-unit storage");
}
let traversal_rejected = C99.transpile_program_linked("let X = import(\"../../x.sapp\"); print X.value();",
    map{}, map{ entry_path: "app/main.sapp" });
if traversal_rejected.ok { fail("linked hosted C99 accepted root traversal"); }
let runtime_collision = false;
try { C99.transpile_program("fn kmalloc(n) { return n; } print kmalloc(1);"); } catch { runtime_collision = true; }
if not runtime_collision { fail("hosted runtime symbol collision did not fail closed"); }
let lowered_collision = false;
try { C99.transpile_program("fn main() { return 1; } fn pb_main() { return 2; }"); } catch { lowered_collision = true; }
if not lowered_collision { fail("two source names lowering to one C symbol were accepted"); }
let generated_collision = false;
try { C99.transpile_program("fn pb_lambda_0() { return 1; }"); } catch { generated_collision = true; }
if not generated_collision { fail("generated lambda namespace collision was accepted"); }

if C99.build_program("print 1;", "bad\npath", nil).ok { fail("control character in output path accepted"); }
if C99.build_program("print 1;", "/tmp/pbct_bad_cpath", map{ c_path: "-include" }).ok {
    fail("option-like C path accepted");
}
if C99.build_program("print 1;", "/tmp/pbct_bad_profile", map{ profile: "turbo-magic" }).ok {
    fail("unknown build profile accepted");
}

let cc = C99.find_c_compiler();
if cc != nil {
    let run = C99.run_program(source, map{ timeout_ms: 5000, compiler: cc });
    if not run.ok { fail("hosted compile/run failed: " + str(try run.error catch run.stderr)); }
    if run.stdout != "55\ndone\n" { fail("hosted output mismatch: " + run.stdout); }
    if fs_exists(run.build.output) { fail("run_program left its executable behind"); }

    let irun = C99.run_program("fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } print fib(10);",
        map{ timeout_ms: 5000, compiler: cc, numeric: "integer" });
    if not irun.ok or irun.stdout != "55\n" or irun.build.numeric != "integer" {
        fail("integer hosted compile/run mismatch");
    }

    let crun = C99.run_program("let x = 1; let y = (x = 41) + 1; print x > 40 ? y : 0;",
        map{ timeout_ms: 5000, compiler: cc });
    if not crun.ok or crun.stdout != "42\n" { fail("conditional/assignment native result mismatch"); }

    let array_run = C99.run_program(
        "let a = [10, 20, 30]; print a[1]; a[0] = 42; print a[0]; print len(a);",
        map{ timeout_ms: 5000, compiler: cc });
    if not array_run.ok or array_run.stdout != "20\n42\n3\n" {
        fail("checked hosted array result mismatch: " + str(array_run));
    }
    for bad_source in [
        "let a = [1]; print a[-1];",
        "let a = [1]; print a[1];",
        "let a = [1]; print a[0.5];",
        "let a = [1]; a[2] = 9;",
        "print len(0);"
    ] {
        let bad_index = C99.run_program(bad_source, map{ timeout_ms: 5000, compiler: cc });
        if bad_index.ok or bad_index.exit_code != 74
            or not str_contains(bad_index.stderr, "array index out of bounds") {
            fail("invalid hosted array access was not rejected safely: " + str(bad_index));
        }
    }

    let closure_run = C99.run_program(closure_source, map{ timeout_ms: 5000, compiler: cc });
    if not closure_run.ok or closure_run.stdout != "42\n42\n11\n13\n6\n" {
        fail("closure native result mismatch: " + str(try closure_run.stderr catch closure_run.stdout));
    }
    let closure_int_run = C99.run_program(
        "fn outer(x) { return fn(y) { return x + y; }; } let f = outer(40); print f(2);",
        map{ timeout_ms: 5000, compiler: cc, numeric: "integer" });
    if not closure_int_run.ok or closure_int_run.stdout != "42\n" {
        fail("integer closure native result mismatch");
    }

    let project_run = C99.run_program(project_main,
        map{ timeout_ms: 5000, compiler: cc, modules: project_modules, entry_path: "app/main.sapp" });
    if not project_run.ok or project_run.stdout != "42\n" or project_run.build.link.modules != 2 {
        fail("linked hosted project native result mismatch: " + str(try project_run.stderr catch project_run.stdout));
    }

    let globals_run = C99.run_program(
        "let counter = 40; fn bump() { counter = counter + 1; return counter; } print bump(); print bump();",
        map{ timeout_ms: 5000, compiler: cc });
    if not globals_run.ok or globals_run.stdout != "41\n42\n" {
        fail("hosted global mutation/order mismatch: " + str(try globals_run.stderr catch globals_run.stdout));
    }
    let project_integer_run = C99.run_program(project_main,
        map{ timeout_ms: 5000, compiler: cc, numeric: "integer",
            modules: project_modules, entry_path: "app/main.sapp" });
    if not project_integer_run.ok or project_integer_run.stdout != "42\n" {
        fail("linked integer project native result mismatch");
    }

    let named_global_run = C99.run_program(
        "fn inc(x) { return x + 1; } let OP = inc; fn invoke(x) { return OP(x); } print invoke(41);",
        map{ timeout_ms: 5000, compiler: cc });
    if not named_global_run.ok or named_global_run.stdout != "42\n" {
        fail("named function stored in global did not use checked dynamic call");
    }

    let forged = C99.run_program("let f = 999; f();", map{ timeout_ms: 5000, compiler: cc });
    if forged.ok or forged.exit_code != 72 or not str_contains(forged.stderr, "invalid closure handle") {
        fail("forged closure handle was not rejected safely: " + str(forged));
    }
    let forged_global_call = C99.run_program("let f = 999; fn invoke() { return f(); } print invoke();",
        map{ timeout_ms: 5000, compiler: cc });
    if forged_global_call.ok or forged_global_call.exit_code != 72
        or not str_contains(forged_global_call.stderr, "invalid closure handle") {
        fail("global forged closure call bypassed checked runtime");
    }
    let bad_arity = C99.run_program("let f = fn(x) { return x; }; f();", map{ timeout_ms: 5000, compiler: cc });
    if bad_arity.ok or bad_arity.exit_code != 72 or not str_contains(bad_arity.stderr, "arity mismatch") {
        fail("closure arity mismatch was not rejected safely");
    }

    let rejected_build = C99.build_program("import \"missing.sapp\"; print 1;", "/tmp/pbct_rejected", map{ compiler: cc });
    if rejected_build.ok or fs_exists("/tmp/pbct_rejected") or fs_exists("/tmp/pbct_rejected.c") {
        fail("rejected C99 build wrote an artifact");
    }

    let bounded = C99.run_program("while 1 > 0 { let x = 1; }", map{ timeout_ms: 100, compiler: cc });
    if not bounded.timed_out { fail("infinite hosted program was not stopped by the watchdog"); }
    if fs_exists(bounded.build.output) { fail("timed-out executable was not cleaned"); }
}

print "ctranspile_hosted_pass";
