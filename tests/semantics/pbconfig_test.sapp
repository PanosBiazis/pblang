// tests/semantics/pbconfig_test.sapp — stdlib/pbconfig.sapp
//
// One place for pblang's scattered env vars/flags. Every setting is catalogued with a TIER
// (beginner/intermediate/pro) so newcomers see only what matters, and PROFILES (beginner /
// pro / secure / fast) set many at once — so a user picks ONE thing (PBLANG_PROFILE) instead
// of ten env vars. Resolution precedence: an explicitly-set env var > the profile preset >
// the built-in default. The env getter is injectable, so this is testable without real env.

let C = import("stdlib/pbconfig.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn truthy(c, m) { if c != true { fail(m); } }

fn no_env(name) { return nil; }                       // nothing set
fn env_gpu_on(name) { if name == "PBLANG_GPU" { return "on"; } return nil; }

// ── catalog + tiers ─────────────────────────────────────────────────────────────────
truthy(len(C.catalog()) >= 8, "settings are catalogued");
eq(len(C.tiers()), 3, "beginner / intermediate / pro tiers");
truthy(map_has(C.explain("allow_all"), "env"), "explain gives the spec");
eq(C.explain("allow_all").env, "PBLANG_ALLOW_ALL", "allow_all maps to the real env var");
// a beginner only needs a handful of settings
truthy(len(C.by_tier("beginner")) >= 1, "beginner-tier settings exist");
truthy(len(C.by_tier("beginner")) < len(C.catalog()), "beginner sees fewer than everything");

// ── profiles set many at once ───────────────────────────────────────────────────────
eq(len(C.profiles()), 4, "four profiles");
// beginner favours safety: full-power switch OFF (least privilege)
eq(C.resolve("allow_all", no_env, "beginner"), "0", "beginner: allow_all off (safe default)");
// pro enables advanced rendering but does not silently grant host capabilities
eq(C.resolve("allow_all", no_env, "pro"), "0", "pro: allow_all remains off");
// secure locks the network to local + no full power
eq(C.resolve("allow_all", no_env, "secure"), "0", "secure: allow_all off");
eq(C.resolve("network", no_env, "secure"), "local", "secure: network local");
// fast favours GPU
eq(C.resolve("gpu", no_env, "fast"), "on", "fast: gpu on");
eq(C.resolve("allow_all", no_env, "fast"), "0", "fast: performance does not escalate capabilities");

// ── precedence: an explicit env var overrides the profile ───────────────────────────
// secure profile would set gpu auto/off, but the user explicitly set PBLANG_GPU=on
eq(C.resolve("gpu", env_gpu_on, "secure"), "on", "explicit env beats the profile preset");
// with nothing set and no profile match, fall back to the catalogued default
eq(C.resolve("idle_redraw_ms", no_env, "beginner"), C.explain("idle_redraw_ms").default, "default fallback");

// ── effective(): the whole resolved config in one map ───────────────────────────────
let eff = C.effective(no_env, "pro");
truthy(map_has(eff, "allow_all"), "effective has allow_all");
eq(eff.allow_all, "0", "effective pro remains least privilege");
truthy(map_has(eff, "gpu"), "effective has gpu");

// unknown setting / profile are rejected
let bad = (try C.resolve("nope", no_env, "pro") catch "ERR");
eq(bad, "ERR", "unknown setting rejected");
let badp = (try C.resolve("gpu", no_env, "nope") catch "ERRP");
eq(badp, "ERRP", "unknown profile rejected");

print "pbconfig_pass";
