// Test: thread stdlib — Structured Concurrency (scope)
import "stdlib:thread.sapp";

// scope launches workers and joins them all before returning
let results = thread.scope(fn(sc) {
    sc:launch(fn() { return 10; });
    sc:launch(fn() { return 20; });
    sc:launch(fn() { return 30; });
});

if len(results) != 3 { throw "FAIL scope result count: " + str(len(results)); }

let sum = 0;
let i = 0;
while i < len(results) {
    sum = sum + results[i];
    i = i + 1;
}
if sum != 60 { throw "FAIL scope sum: " + str(sum); }

// scope with no tasks
let empty_results = thread.scope(fn(sc) {});
if len(empty_results) != 0 { throw "FAIL scope empty"; }

print "structured_concurrency_pass";
