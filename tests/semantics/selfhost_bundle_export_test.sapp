// tests/semantics/selfhost_bundle_export_test.sapp
//
// The self-hosted bytecode linker (stdlib/selfhost_bundle.sapp) must honor a
// module's `export` list the SAME way runtime import does. It didn't: the bundle's
// per-module exports map was synthesized from ALL the module's defined globals, so
// a bundled program could reach a module's NON-exported (private) functions, while
// the same program run via runtime import correctly hides them. That's both a
// semantic divergence (bundle != runtime) and an encapsulation leak.

let bun = import("stdlib/selfhost_bundle.sapp");
let vm  = import("stdlib/compiler/vm.sapp");

fn fail(m) { throw "FAIL " + m; }

fn bundle_run(main, mods) {
    fn resolve(p) { return try mods[p] catch nil; }
    let b = bun.bundle(main, resolve);
    if not b.ok { fail("bundle rejected: " + b.reason); }
    return vm.run(b.chunk).output;
}

// 1. A module that exports only `pub` (and has internal `priv`): the bundle must
//    expose `pub` but HIDE `priv` (accessing it throws -> caught), matching runtime.
let mods1 = map{ "L": "fn pub(x){ return x + 1; } fn priv(x){ return x + 999; } export pub;" };
let o1 = bundle_run(
    "let m = import(\"L\"); print m.pub(10); print (try m.priv(1) catch \"HIDDEN\");",
    mods1);
if o1[0] != 11 { fail("exported pub must work: got " + str(o1[0])); }
if o1[1] != "HIDDEN" { fail("non-exported priv must be hidden in the bundle, got " + str(o1[1])); }

// 2. An exported function may still call its module's PRIVATE helper internally
//    (private globals remain in the shared namespace, just not on the exports map).
let mods2 = map{ "L2": "fn helper(x){ return x * 2; } fn api(x){ return helper(x) + 1; } export api;" };
let o2 = bundle_run("let m = import(\"L2\"); print m.api(5);", mods2);
if o2[0] != 11 { fail("exported api calling a private helper must work: got " + str(o2[0])); }

// 3. A module with NO export statement still exposes all its globals (matches the
//    runtime "no __exports__ -> expose everything" fallback).
let mods3 = map{ "L3": "fn a(x){ return x; } fn b(x){ return x + 1; }" };
let o3 = bundle_run("let m = import(\"L3\"); print m.a(7); print m.b(7);", mods3);
if o3[0] != 7 or o3[1] != 8 { fail("no-export module must expose all globals: got " + str(o3[0]) + "," + str(o3[1])); }

print "selfhost_bundle_export_pass";
