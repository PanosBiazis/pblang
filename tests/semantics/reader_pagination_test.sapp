let P=import("../../examples/declarative_browser/pagination.sapp");let App=import("../../examples/declarative_browser/app.sapp");
let D=import("stdlib:browser_document.sapp");let View=import("stdlib:browser_view.sapp");let GUI=import("stdlib:gui.sapp");let S=import("stdlib:browser_session.sapp");
let blocks=[];for i 7 {push(blocks,map{tag:"p",text:"Section "+str(i)+". Ελληνικό κείμενο με τόνους. Read every sentence, even with large letters and a narrow window. "+str_repeat("More readable words. ",5)});}
push(blocks,map{tag:"a",text:"Read the final destination after the full document",href:"pb://about"});
let document=D.create("A complete reader — Οδηγός",blocks);let original=D.export_html(document);let style=View.appearance(map{body_size:20,font_scale:1.5});
let checks=0;fn check(value,label) {assert(value,label);checks=checks+1;}
for size in [map{w:390,h:844},map{w:320,h:480},map{w:800,h:600}] {
    let plan=P.plan(document,style,size.w,size.h);check(plan.available and len(plan.pages)>1,"multiple bounded pages");
    let covered=map{};let links=0;for page in plan.pages {let used=0;for i len(page) {let row=page[i];used=used+row.h;if i>0 {used=used+row.gap;}
        if row.kind=="text" {let key=str(row.block);covered[key]=(try covered[key] catch "")+str_replace_all(row.text," ","");}
        else {links=links+1;check(row.block==7 and row.href=="pb://about","exact local link index");}
    }check(used<=plan.content_height,"page fits content bounds");}
    check(links==1,"link appears once");check(covered["-1"]==str_replace_all(P.normalized("A complete reader — Οδηγός")," ",""),"complete title");
    for i len(blocks) {check(covered[str(i)]==str_replace_all(P.normalized(blocks[i].text)," ",""),"complete paragraph and link label");}
    for i len(plan.pages) {check(P.locate(plan,P.anchor(plan,i))==i,"stable page anchor");}
}
// Blank labels still have distinct text/button anchors when split across pages.
let blank=D.create(" ",[map{tag:"a",text:" ",href:"pb://about"}]);
let blank_plan=P.plan(blank,style,320,240);
for i len(blank_plan.pages) {check(P.locate(blank_plan,P.anchor(blank_plan,i))==i,"blank label anchor stays distinct");}
let label_doc=D.create("Links",[map{tag:"a",text:"Read this complete destination label in a narrow window",href:"pb://about"}]);
let label_view=View.create(label_doc);check(P.needs(label_view,320,844),"long link label triggers readable projection");
check(D.export_html(document)==original,"canonical source unchanged");
check(not P.plan(document,View.appearance(map{title_size:40,font_scale:1.5,line_height:2.5}),320,240).available,"explicit too-small layout");
check((try P.plan(document,style,100,480) catch nil)==nil,"invalid viewport rejected");
let c=App.create();let local=App.pages();local["pb://guide"]=original;c.session.close();c.session=S.create(local);c.session.navigate("pb://guide");c.width=390;c.height=844;App.configure(c,style);App.refresh(c);
check(c.reading_plan!=nil and c.reading_plan.available,"reader uses paged projection");
for widget in c.form.widgets {check(widget.y+widget.h<=c.height,"native widget within viewport");}
fn press(c,key) {App.update(c,[map{type:"keydown",key:key}]);App.update(c,[map{type:"keyup",key:key}]);}
let before=c.reading_page;App.update(c,[map{type:"keydown",key:"PageDown"}]);check(c.reading_page==before+1,"page-down keyboard");
App.update(c,[map{type:"keydown",key:"PageDown"}]);check(c.reading_page==before+1,"held key not replayed");App.update(c,[map{type:"keyup",key:"PageDown"}]);
let anchor=c.reading_anchor;App.configure(c,map{body_size:18});App.update(c,[]);check(c.reading_anchor==anchor and c.reading_page==P.locate(c.reading_plan,anchor),"font change keeps text anchor");
App.update(c,[map{type:"resize",w:320,h:480}]);check(c.reading_anchor==anchor and c.width==320,"resize keeps text anchor");
press(c,"End");check(c.reading_page==len(c.reading_plan.pages)-1,"End reaches last page");
check(GUI.get(c.form,"block7")!=nil,"last link reachable");GUI.get(c.form,"block7").onclick(c.form);App.update(c,[]);
check(c.session.snapshot().url=="pb://about" and c.reading_anchor.block==-1,"local link uses canonical index and resets position");
c.session.close();print "reader_pagination_pass checks="+str(checks);
