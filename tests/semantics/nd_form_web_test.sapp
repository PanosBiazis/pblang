let Example=import("../../examples/nd_forms/document.sapp");let Web=import("stdlib:ui_form_web.sapp");
let called=0;let document=Example.build().document;
let app=Web.create(document,map{Explain:fn(values){called=called+1;return "<script>inert output</script>";}},8768);
fn request(method,path,body="") {
    // pblang-security-ignore-next-line: network.plaintext-http reason=in-process loopback form fixture, no listener
    return map{method:method,path:path,body:body,headers:map{host:"127.0.0.1:8768",origin:"http://127.0.0.1:8768","content-type":"application/x-www-form-urlencoded"}};
}
let home=app.handle(request("GET","/"));assert(home.status==200,"two diagrams rendered");
assert(len(str_split(home.body,"<svg"))==3,"two SVG plots");
assert(not str_contains(home.headers["Content-Security-Policy"],"unsafe-inline") and home.headers["Cross-Origin-Embedder-Policy"]=="require-corp","protections retained");
assert(home.headers["X-Robots-Tag"]=="noindex, nofollow, noarchive, nosnippet","default crawler policy retained");
let token=str_split(str_split(home.body,"name=\"csrf\" value=\"")[1],"\"")[0];
let body="csrf="+token+"&revision=0&action=a_4";
assert(app.handle(request("POST","/action",body+"&points=malicious")).status==400,"plot geometry not a submitted field");
let bad=request("POST","/action",body);bad.headers.origin="https://example.invalid";
assert(app.handle(bad).status==403 and called==0,"origin guard before action");
let action=app.handle(request("POST","/action",body));assert(action.status==200 and called==1,"PBLang action");
assert(str_contains(action.body,"&lt;script&gt;inert output&lt;/script&gt;"),"action output stays text");
assert(app.handle(request("POST","/action",body)).status==409 and called==1,"stale action not replayed");
app.close();assert(app.handle(request("GET","/")).status==503,"closed preview");
print "nd_form_web_pass";
