let A=import("stdlib:project_audit.sapp");
let OS=import("stdlib:os.sapp");
let args=OS.script_args();
if len(args)==2 and args[0]=="child" {
    let limit=try parse_number(args[1]) catch args[1];
    A.scan_records([map{path:"private-path-marker",text:"private-source-marker"}],limit);
    print "unexpected admission";os_exit(3);
}
if platform()!="linux" {print "project_audit_limits_live_skip_linux_required";os_exit(0);}
let compiler=env_get("PBLANG_BIN") ?? path_join(cwd(),"target/release/pblang");
let expected="project audit max_findings must be a finite integer in 1..4096";
for value in ["private-limit-marker","NaN","inf","1.5","4097"] {
    let result=proc_spawn_wait("/usr/bin/timeout",["-k","1s","8s",compiler,
        "tests/semantics/project_audit_limits_live_test.sapp","--allow-all","--","child",value]);
    if result.exit_code!=1 or str_trim(result.stdout)!="" or not str_contains(result.stderr,expected) {
        throw "FAIL project-audit-limits-live: expected controlled limit diagnostic";
    }
    for marker in ["private-limit-marker","private-path-marker","private-source-marker"] {
        if str_contains(result.stderr,marker) {throw "FAIL project-audit-limits-live: caller data in diagnostic";}
    }
}
print "project_audit_limits_live_pass";
