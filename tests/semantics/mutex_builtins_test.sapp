// Test: mutex builtins (mutual exclusion)
// mutex_new, mutex_lock, mutex_try_lock, mutex_unlock

let m = mutex_new();

// Basic lock/unlock cycle
mutex_lock(m);
mutex_unlock(m);

// try_lock on unlocked mutex — should succeed
let got = mutex_try_lock(m);
if got == false { print "FAIL try_lock on unlocked"; }

// try_lock on locked mutex — should fail
let got2 = mutex_try_lock(m);
if got2 != false { print "FAIL try_lock on locked should return false"; }

// unlock the first lock
mutex_unlock(m);

// Nested lock/unlock
let m2 = mutex_new();
mutex_lock(m2);
let inner = mutex_try_lock(m2);
if inner != false { print "FAIL nested try_lock should fail"; }
mutex_unlock(m2);

// After unlock, try_lock should succeed again
let after = mutex_try_lock(m2);
if after == false { print "FAIL try_lock after unlock"; }
mutex_unlock(m2);

print "mutex_builtins_pass";
