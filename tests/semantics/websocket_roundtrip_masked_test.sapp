// websocket_roundtrip_masked_test.sapp
// Ensure write_frame() + parse_frame() roundtrip masked payloads.
import "stdlib:websocket.sapp";

let input = "hello websocket";
let frame = websocket.write_frame(1, input);
let parsed = websocket.parse_frame(frame);

if parsed["fin"] != 1 { print "FAIL fin"; }
if parsed["opcode"] != 1 { print "FAIL opcode"; }
if parsed["masked"] != 1 { print "FAIL masked"; }
if parsed["payload"] != input { print "FAIL payload"; }

print "websocket_roundtrip_masked_pass";
