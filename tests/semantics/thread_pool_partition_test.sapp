let P=import("stdlib:thread_pool.sapp");
for n in [0,1,2,3,5,6,7,17] {
    let input=[];for i n {array_push(input,i);}
    for workers in [1,2,3,4,8,64] {
        let got=P.parallel_map(input,fn(x){return x;},workers);
        assert(got==input,"each element exactly once in input order");
    }
}
// Preserve the observed index as text; retained numeric channel JSON has
// a separate large-number round-trip limitation, outside this partition test.
fn record(sender){return fn(i){send(sender,str(i));};}
for bounds in [[0,6,1],[0,9,2],[-7,8,3],[2,4,9],[0,0,1],[5,1,1],[0,4,0],[0,4,-2],[0,4,nil],[-9007199254740991,-9007199254740988,1],[0,9007199254740991,9007199254740990]] {
    let step=bounds[2];if step==nil or step<=0 {step=1;}
    let expected=[];let i=bounds[0];while i<bounds[1] {array_push(expected,i);i=i+step;}
    for workers in [1,2,3,4,8] {
        let ch=channel_buffered(32);
        P.parallel_for(bounds[0],bounds[1],bounds[2],record(ch.sender),workers);
        channel_close(ch.sender);
        let counts=map{};let count=0;
        while true {
            let value=recv_timeout(ch.receiver,0);if value==nil {break;}
            let key=str(value);counts[key]=(try counts[key] catch 0)+1;count=count+1;
        }
        assert(count==len(expected),"range visit count");
        for value in expected {assert(counts[str(value)]==1,"range index visited exactly once");}
    }
}
for n in [0,1,3,5,9,130] {
    let pool=P.new();for i n {P.submit(pool,fn(){return 1;});}
    let size=P.auto_size(pool);
    assert(size>=1 and size<=64 and size==num_floor(size),"integer automatic size");
    assert(len(P.split_tasks([1,2,3],size))<=3,"automatic size accepted by partitioner");
    P.shutdown(pool);
}
for bad in [num_sqrt(-1),num_exp(1000),-1,0,1.5,"2",false,65] {
    assert((try {P.parallel_map([],fn(x){return x;},bad);false} catch true),"invalid worker count on empty map");
    assert((try {P.parallel_for(0,0,1,fn(i){return nil;},bad);false} catch true),"invalid count on empty range");
}
for bad in [num_sqrt(-1),num_exp(1000),1.5,"2",false,9007199254740992] {
    assert((try {P.parallel_for(bad,10,1,fn(i){return nil;});false} catch true),"invalid range start");
    assert((try {P.parallel_for(0,bad,1,fn(i){return nil;});false} catch true),"invalid range end");
    assert((try {P.parallel_for(0,10,bad,fn(i){return nil;});false} catch true),"invalid range step");
}
assert((try {P.parallel_for(-9007199254740991,9007199254740991,1,fn(i){return nil;});false} catch true),"range span must be exact");
for bad in [nil,false,1,"x",map{}] {
    assert((try {P.parallel_map(bad,fn(x){return x;});false} catch true),"array required");
}
assert((try {P.parallel_map([],nil);false} catch true),"callable required even when empty");
print "thread_pool_partition_pass";
