let PIDFD = import("stdlib:linux_pidfd.sapp");
let PROCESS = import("stdlib:linux_process.sapp");
fn expect(value, message) { if not value { throw "FAIL linux pidfd: " + message; } }
fn rejects(callable) { return try { callable(); false } catch true; }

let current = PIDFD.current_pid();
expect(current.ok and current.pid > 1, "current process identity is available");
let held = PIDFD.open(current.pid);
expect(held.ok and held.race_resistant_identity and PIDFD.exists(held),
    "pidfd holds the current process identity without signalling it");
expect(rejects(fn() { PIDFD.send(held, "USR1"); }) and rejects(fn() { PIDFD.open(1); }),
    "unsupported signals and PID 1 fail closed");
expect(PIDFD.close(held) and not PIDFD.exists(held), "pidfd closes deterministically");
let child = PROCESS.start("/usr/bin/sleep", ["30"], map{ timeout_secs: 35, max_output_bytes: 1024 });
expect(child.ok, "bounded child process starts for the signal test");
// Exercise the exact held leader identity without stealing group lifecycle
// ownership from linux_process. TERM here can exit the leader before the
// supervisor pins it, correctly making descendant-group liveness indeterminate.
let signalled = PIDFD.signal_once(child.process_group_id, "CONT");
let cancelled = PROCESS.cancel(child, 250); let finished = PROCESS.finish(child, 3000);
expect(signalled.signal_sent and signalled.handle_closed and signalled.process_still_exists
    and cancelled.terminated and finished.completed and finished.process_group_terminated,
    "pidfd signals the exact live identity while the owning supervisor terminates the full group");
print "linux_pidfd_pass";
