// tests/semantics/state_machine_enrich2_test.sapp — wave 2 for stdlib/state_machine.sapp
// on_exit hooks, can_reach, to_mermaid, validate.

let F = import("stdlib/state_machine.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : " + s); } }
fn contains(arr, v) { let i = 0; while i < len(arr) { if arr[i] == v { return true; } i = i + 1; } return false; }

let m = F.create("idle", map{
    idle:    map{ start: "running" },
    running: map{ finish: "done" },
    done:    map{}
});

// ── on_exit hook fires when leaving a state ───────────────────────────────────────
let exited = [];
F.on(m, "exit:idle", fn(prev, next) { array_push(exited, prev); });
F.send(m, "start");
eq(len(exited), 1, "exit:idle fired once");
eq(exited[0], "idle", "exit hook saw prev=idle");

// ── can_reach (BFS over transitions) ──────────────────────────────────────────────
// current is now "running"; done is reachable, idle is NOT (no path back)
if not F.can_reach(m, "done") { fail("done reachable from running"); }
if F.can_reach(m, "idle") { fail("idle not reachable from running (one-way)"); }
if not F.can_reach(m, "running") { fail("current state reaches itself"); }

// ── to_mermaid ────────────────────────────────────────────────────────────────────
let mer = F.to_mermaid(m);
has(mer, "stateDiagram-v2", "mermaid header");
has(mer, "idle --> running : start", "mermaid edge");

// ── validate: clean machine ───────────────────────────────────────────────────────
let v = F.validate(m);
if not v.ok { fail("clean machine validates: " + str(v)); }

// ── validate: undefined target + unreachable state ────────────────────────────────
let bad = F.create("a", map{
    a:      map{ go: "ghost" },   // ghost is not a defined state
    b:      map{},                 // b unreachable from a
    orphan: map{ x: "a" }          // orphan unreachable from a
});
let vb = F.validate(bad);
if vb.ok { fail("bad machine should not validate"); }
if not contains(vb.undefined_targets, "ghost") { fail("ghost flagged as undefined target"); }
if not contains(vb.unreachable, "b") { fail("b flagged unreachable"); }
if not contains(vb.unreachable, "orphan") { fail("orphan flagged unreachable"); }

print "state_machine_enrich2_pass";
