// tests/semantics/pbai_tensor_batch_test.sapp — batch inference expressed as TENSOR MATMULS.
// This is the honest "use the GPU" path: tensor.dot auto-offloads large matmuls to the GPU on a
// `--features gpu` build (and runs multi-threaded on CPU otherwise). Results must equal the
// scalar classifier exactly (same sigmoid(Wx+b) forward), so accuracy is identical either way.

let pbai = import("stdlib/pbai.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.01 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let prompts = [
    "explain this code", "find the bug here", "optimize this loop", "add comments to this",
    "how does pblang work", "make this faster", "what is wrong with this", "document this function"
];

// tensor forward == scalar forward (intents) and confidences track the single-prompt path
let plain = pbai.classify_batch(prompts);
let tb = pbai.classify_batch_tensor(prompts);
eq(len(tb), len(prompts), "tensor batch length");
let i = 0;
while i < len(prompts) {
    if not map_has(tb[i], "intent") or not map_has(tb[i], "confidence") { fail("item shape " + str(i)); }
    eq(tb[i].intent, plain[i], "tensor batch intent[" + str(i) + "] matches scalar classifier");
    approx(tb[i].confidence, pbai.confidence(prompts[i]), "tensor confidence[" + str(i) + "] matches single");
    if tb[i].confidence <= 0 or tb[i].confidence > 1 { fail("confidence in (0,1] at " + str(i)); }
    i = i + 1;
}

// smart batch still returns plain intent strings and still equals the sequential result here
// (CPU build); on a --features gpu build it routes through the tensor/GPU path transparently.
eq(pbai.classify_batch_smart(prompts), plain, "smart batch == sequential intents on CPU build");

print "pbai_tensor_batch_pass";
