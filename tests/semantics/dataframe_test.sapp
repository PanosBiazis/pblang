let df = import("stdlib:dataframe.sapp");
let data = df.from_rows([
    map{ name: "Alice", age: 30, city: "NY" },
    map{ name: "Bob", age: 25, city: "LA" },
    map{ name: "Charlie", age: 35, city: "NY" },
    map{ name: "Diana", age: 28, city: "LA" }
]);
assert(df.nrows(data) == 4, "should have 4 rows");
assert(df.ncols(data) == 3, "should have 3 cols");
let filtered = df.filter(data, fn(row) { return row.age > 27; });
assert(df.nrows(filtered) == 3, "filter should keep 3");
let sorted = df.sort_by(data, "age", "asc");
assert(sorted.rows[0].name == "Bob", "youngest should be Bob");
let ages = df.column(data, "age");
assert(len(ages) == 4, "column should return 4 values");
let grouped = df.group_by(data, "city", "count");
assert(df.nrows(grouped) == 2, "should have 2 city groups");
let stats = df.describe(data);
assert(stats.age.count == 4, "age count should be 4");
assert(stats.age.mean == 29.5, "age mean should be 29.5");
let head = df.head(data, 2);
assert(df.nrows(head) == 2, "head 2 should return 2");
let csv = df.to_csv(data);
assert(str_contains(csv, "Alice"), "CSV should contain Alice");

let uneven = df.from_rows([
    map{ a: 1 },
    map{ b: 2, a: 3 }
]);
assert(df.ncols(uneven) == 2, "from_rows should infer columns across all rows");
assert(uneven.rows[0].b == nil, "missing inferred column should be nil");

let quoted = df.from_csv_string("name,note,score\r\nAlice,\"line1\nline2\",10\r\nBob,\"x,y\",20\r\n");
assert(df.nrows(quoted) == 2, "quoted CSV should have 2 rows");
assert(quoted.rows[0].note == "line1\nline2", "quoted newline should stay in field");
assert(quoted.rows[1].note == "x,y", "quoted comma should stay in field");
assert(quoted.rows[1].score == 20, "CSV numeric cells should coerce");

let quoted_round = df.to_csv(quoted);
let quoted_again = df.from_csv_string(quoted_round);
assert(quoted_again.rows[0].note == "line1\nline2", "to_csv should quote newline cells");
assert(quoted_again.rows[1].note == "x,y", "to_csv should quote comma cells");

let sliced = df.slice(data, 1, 3);
assert(df.nrows(sliced) == 2 and sliced.rows[0].name == "Bob", "slice should return clamped row range");
let tail_neg = df.tail(data, -2);
assert(df.nrows(tail_neg) == 0, "negative tail should clamp to empty");

let renamed = df.rename_column(data, "city", "town");
assert(renamed.rows[0].town == "NY" and df.ncols(renamed) == 3, "rename_column should preserve values");
let dropped = df.drop_columns(renamed, ["town"]);
assert(df.ncols(dropped) == 2 and dropped.rows[0].name == "Alice", "drop_columns should remove selected names");

let filled = df.fill_missing(uneven, map{ b: 0 });
assert(filled.rows[0].b == 0 and filled.rows[1].b == 2, "fill_missing should use per-column defaults");
let sch = df.schema(filled);
assert(sch.a.number == 2 and sch.b.number == 2, "schema should count column types");
let check = df.validate(filled);
assert(check.ok == true and check.rows == 2 and check.columns == 2, "validate should accept normalized dataframe");

print "dataframe_stdlib_pass";
