let P = import("stdlib:tool_probe.sapp");
fn fail(m) { throw "FAIL tool_probe: " + m; }

let daemon = P.describe("ydotoold");
if daemon.kind != "daemon" or daemon.executed or daemon.version_available { fail("ydotoold must be metadata-only"); }
if not str_contains(daemon.reason, "unsafe") { fail("daemon reason explains unsafe execution probe"); }

let skipped = P.version_probe("ydotoold");
if skipped.ok or not skipped.skipped or skipped.executed { fail("version probe must fail closed without execution"); }

let command = P.describe("xdotool");
if command.kind != "command" or command.executed { fail("regular command detection remains non-executing"); }

let invalid = P.describe("../ydotoold");
if invalid.valid or invalid.installed or invalid.path != nil { fail("path traversal in tool name must be rejected"); }
if P.trusted_path("x;sh") != nil { fail("shell syntax in tool name must be rejected"); }

let dirs = P.trusted_dirs();
if len(dirs) != 4 or dirs[0] != "/usr/bin" { fail("trusted path order"); }

print "tool_probe_pass";
