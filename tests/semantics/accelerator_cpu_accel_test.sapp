// tests/semantics/accelerator_cpu_accel_test.sapp — detect the ON-CPU AI accelerator: Intel DL
// Boost (AVX-512 VNNI) / AVX-VNNI, the driver-free successor to the (dead) GNA. cpu_accel()
// parses CPU flags (injectable for portable tests) into {avx2, avx512, vnni, dl_boost, ...}.

let ACC = import("stdlib/accelerator.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── a VNNI-capable CPU (like this i7-1195G7) is recognized as DL Boost ──────────────────
let vnni = ACC.cpu_accel("fpu vme de avx2 avx512f avx512bw avx512_vnni f16c");
eq(vnni.avx2, true, "avx2 detected");
eq(vnni.avx512, true, "avx512 detected");
eq(vnni.vnni, true, "avx512_vnni detected");
eq(vnni.dl_boost, true, "dl_boost = has VNNI");
eq(vnni.usable, true, "on-CPU accelerator is driver-free -> usable");
if not map_has(vnni, "name") or not map_has(vnni, "note") { fail("cpu_accel exposes name+note"); }

// AVX-VNNI (client, non-512) also counts as DL Boost
eq(ACC.cpu_accel("sse2 avx2 avx_vnni").dl_boost, true, "avx_vnni also = dl_boost");

// ── an older CPU with no VNNI: reported honestly, still a usable (SIMD) CPU ─────────────
let old = ACC.cpu_accel("fpu de sse sse2 avx");
eq(old.vnni, false, "no vnni on an old CPU");
eq(old.dl_boost, false, "no dl_boost without vnni");
eq(old.avx2, false, "no avx2 here");
eq(old.usable, true, "cpu accel path is always usable");

// ── detect() now surfaces the CPU's AI features on the cpu entry ────────────────────────
let d = ACC.detect();
if not map_has(d[0], "ai_features") { fail("cpu entry exposes ai_features"); }
if not map_has(d[0].ai_features, "dl_boost") { fail("ai_features has dl_boost"); }

// ── the real machine: cpu_accel() with no override reads /proc/cpuinfo and is usable ────
let real = ACC.cpu_accel();
eq(real.usable, true, "live cpu_accel usable");
if not map_has(real, "vnni") { fail("live cpu_accel has vnni field"); }

print "accelerator_cpu_accel_pass";
