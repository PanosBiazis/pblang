// tests/semantics/pbai_routing_test.sapp — per-category routing. A model isn't uniformly good:
// it may be reliable when it says "bugs" but useless when it says "explain". With set_routing(true)
// each vote is weighted by the model's reliability FOR THE INTENT IT IS VOTING, not a global average.

let ens = import("stdlib/pbai_ensemble.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// native model: always votes "improve" (weak generalist here)
let scores = fn(p) { return map{ intent: "improve", scores: [0.1, 0.1, 0.9, 0.1, 0.1] }; };
ens.configure(scores, ["explain", "bugs", "improve", "comment", "general"]);
ens.clear_voters();
ens.reset_stats();

// specialist "M": says "bugs" on bug prompts (right), "explain" otherwise (wrong on improve-type)
ens.register_voter_weighted("M", fn(x) { if str_index_of(x, "bug") >= 0 { return "bugs"; } return "explain"; }, 2);

// train: M is accurate WHEN it says bugs, wrong WHEN it says explain
let train = [
    map{ prompt: "bug1", intent: "bugs" }, map{ prompt: "bug2", intent: "bugs" },
    map{ prompt: "bug3", intent: "bugs" }, map{ prompt: "bug4", intent: "bugs" },
    map{ prompt: "imp1", intent: "improve" }, map{ prompt: "imp2", intent: "improve" },
    map{ prompt: "imp3", intent: "improve" }, map{ prompt: "imp4", intent: "improve" }
];
let i = 0;
while i < len(train) { ens.ensemble_detail(train[i].prompt); ens.record_outcome(train[i].intent); i = i + 1; }

// per-intent reliability learned: M trustworthy on "bugs", not on "explain"
if ens.reliability_for("M", "bugs") <= ens.reliability_for("M", "explain") { fail("M should be more reliable when voting bugs"); }
if ens.reliability_for("M", "bugs") < 0.7 { fail("M@bugs ~ high"); }
if ens.reliability_for("M", "explain") > 0.3 { fail("M@explain ~ low"); }

ens.set_adaptive(true);

// decision prompt "q" (not a bug prompt) -> M votes "explain"
// GLOBAL adaptive: M's global reliability ~0.5 (neutral) -> its heavy "explain" vote wins
ens.set_routing(false);
eq(ens.ensemble("q"), "explain", "global weighting follows M's heavy but context-wrong vote");
// PER-CATEGORY routing: M's "explain" vote is down-weighted (M is bad at explain) -> native wins
ens.set_routing(true);
eq(ens.ensemble("q"), "improve", "routing ignores M's unreliable explain vote");

ens.set_routing(false);
ens.set_adaptive(false);
ens.clear_voters();
ens.reset_stats();
print "pbai_routing_pass";
