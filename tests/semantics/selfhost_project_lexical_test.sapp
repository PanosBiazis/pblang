let F = import("stdlib:compiler/selfhost_frontend.sapp");
// Exactly two repository-owned files; bounded by the targeted test harness.
// The project compiler may start at most two compile workers for this fixture.
let result = F.frontend_compile_project("tests/fixtures/frontend_lexical_project");
let rejected_consumer = false;
for item in result.results {
    if item.file == "consumer.sapp" {
        for diagnostic in item.diagnostics {
            if (try diagnostic.code catch "") == "undefined-name" { rejected_consumer = true; }
        }
    }
}
assert(rejected_consumer, "recovered declarations must not authorize cross-file names");
print "selfhost_project_lexical_pass";
