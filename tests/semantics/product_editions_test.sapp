let Editions = import("stdlib:product_editions.sapp");
let PBIDE = import("stdlib:pbide_product.sapp");
let Surface = import("../../editors/ide/pbide_surface.sapp");

let status = PBIDE.status();
assert(status.version == "0.5.7" and status.built_with_pblang == "0.6.0"
    and status.version_is_independent, "application and toolchain versions remain independent");
assert(status.contract.canonical_language == "pblang" and status.contract.surface_count == 5,
    "PBIDE declares the canonical multi-surface PBLang family");
assert(len(status.polyglot_editions) == 10 and status.polyglot_editions[0].separate_artifact,
    "PBIDE exposes bounded separate polyglot edition contracts");
assert(len(PBIDE.form_formats()) >= 20 and len(status.polyglot_editions[0].ui_form_formats) == 2,
    "polyglot editions carry their matching UI/form adapter contracts");
assert(not PBIDE.form_conversion_plan("delphi-dfm", "pblang-gui").executable,
    "contract-only form conversion fails closed");
assert(not status.production_ready and len(status.blockers) == 6
    and status.blockers[5] == "pbide-effect-broker-required",
    "contracts/previews/implementations cannot be mislabeled as release evidence");
assert(status.effect_admission.default_mode == "untrusted"
    and status.effect_admission.external_broker_required
    and not status.effect_admission.same_vm_authorization,
    "PBIDE product status exposes fail-closed effect admission");
assert(status.file_broker.request_planning and status.file_broker.open_save_only
    and not status.file_broker.execution_enabled
    and not status.file_broker.publisher_authenticity_verified,
    "PBIDE publishes the exact but deliberately non-executable file-broker contract");
assert(status.parity.complete, "implemented PBIDE surfaces provide the declared core parity baseline");
for target in ["web", "native", "android"] {
    let manifest = Surface.surface_manifest(target);
    assert(manifest.action_count == len(PBIDE.actions())
        and manifest.panel_count == len(PBIDE.panels())
        and manifest.shared_action_model and manifest.shared_panel_model,
        "every PBIDE target projects the complete shared action/panel model");
    assert(not manifest.effects_enabled and not manifest.production_ready,
        "surface parity never grants broker effects or release readiness");
    let preview = Surface.preview(target, "print 42;");
    assert(preview.target == target and len(preview.records) > 0,
        "one PBLang PBIDE view compiles for " + target);
}
let native_manifest = Surface.surface_manifest("native");
let web_manifest = Surface.surface_manifest("web");
let android_manifest = Surface.surface_manifest("android");
assert(native_manifest.actions[0].id == "run" and native_manifest.actions[0].declared_available,
    "native manifest exposes its declared run capability");
assert(web_manifest.actions[0].id == "run" and web_manifest.actions[0].declared_available,
    "web manifest maps run-token to the shared Run action");
assert(android_manifest.actions[0].id == "run" and not android_manifest.actions[0].declared_available,
    "Android keeps Run visible but unavailable while its edition remains contract-only");
assert(native_manifest.panels[0].id == web_manifest.panels[0].id
    and web_manifest.panels[0].id == android_manifest.panels[0].id,
    "target manifests retain stable panel identity and order");
let bad_target = false;
try { Surface.surface_manifest("console"); } catch { bad_target = true; }
assert(bad_target, "unknown PBIDE targets fail closed");
assert(not Surface.status().effects_enabled and not Surface.status().production_ready,
    "renderer-neutral preview never claims brokered effects or release readiness");
assert(Surface.status().workspace_contract.strict_decode
    and not Surface.status().workspace_contract.effects,
    "every renderer advertises the same strict effect-free workspace contract");

let false_release = Editions.contract("demo", "1.0.0", "stable", "0.6.0-alpha", [
    Editions.surface("gui", "pblang", ["linux"], "release", ["edit"], map{})
]);
let gate = Editions.release_gate(false_release);
assert(not gate.ok and str_contains(gate.blockers[0], "lacks digest"),
    "a release label alone cannot bypass artifact/signing/platform evidence");

let rejected = false;
try { Editions.surface("bad", "pblang", ["linux"], "ready-ish", [], map{}); }
catch { rejected = true; }
assert(rejected, "unknown readiness labels fail closed");
let bad_bool = false;
try { Editions.surface("bad-bool", "pblang", ["linux"], "release", [], map{signed_artifact:"yes"}); }
catch { bad_bool = true; }
assert(bad_bool, "release evidence booleans require boolean types");
let missing_surface = Editions.parity_subset(false_release, ["does-not-exist"], ["edit"]);
assert(not missing_surface.complete and missing_surface.matched_surfaces == 0,
    "parity cannot pass for a nonexistent selected surface");
print "product_editions_pass";
