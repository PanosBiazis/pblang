let Editions = import("stdlib:product_editions.sapp");
let PBIDE = import("stdlib:pbide_product.sapp");
let Surface = import("../../editors/ide/pbide_surface.sapp");

let status = PBIDE.status();
assert(status.version == "0.5.7" and status.built_with_pblang == "0.6.0-alpha"
    and status.version_is_independent, "application and toolchain versions remain independent");
assert(status.contract.canonical_language == "pblang" and status.contract.surface_count == 5,
    "PBIDE declares the canonical multi-surface PBLang family");
assert(len(status.polyglot_editions) == 10 and status.polyglot_editions[0].separate_artifact,
    "PBIDE exposes bounded separate polyglot edition contracts");
assert(len(PBIDE.form_formats()) >= 20 and len(status.polyglot_editions[0].ui_form_formats) == 2,
    "polyglot editions carry their matching UI/form adapter contracts");
assert(not PBIDE.form_conversion_plan("delphi-dfm", "pblang-gui").executable,
    "contract-only form conversion fails closed");
assert(not status.production_ready and len(status.blockers) == 5,
    "contracts/previews/implementations cannot be mislabeled as release evidence");
assert(status.parity.complete, "implemented PBIDE surfaces provide the declared core parity baseline");
for target in ["web", "native", "android"] {
    let preview = Surface.preview(target, "print 42;");
    assert(preview.target == target and len(preview.records) > 0,
        "one PBLang PBIDE view compiles for " + target);
}
assert(not Surface.status().effects_enabled and not Surface.status().production_ready,
    "renderer-neutral preview never claims brokered effects or release readiness");

let false_release = Editions.contract("demo", "1.0.0", "stable", "0.6.0-alpha", [
    Editions.surface("gui", "pblang", ["linux"], "release", ["edit"], map{})
]);
let gate = Editions.release_gate(false_release);
assert(not gate.ok and str_contains(gate.blockers[0], "lacks digest"),
    "a release label alone cannot bypass artifact/signing/platform evidence");

let rejected = false;
try { Editions.surface("bad", "pblang", ["linux"], "ready-ish", [], map{}); }
catch { rejected = true; }
assert(rejected, "unknown readiness labels fail closed");
let bad_bool = false;
try { Editions.surface("bad-bool", "pblang", ["linux"], "release", [], map{signed_artifact:"yes"}); }
catch { bad_bool = true; }
assert(bad_bool, "release evidence booleans require boolean types");
let missing_surface = Editions.parity_subset(false_release, ["does-not-exist"], ["edit"]);
assert(not missing_surface.complete and missing_surface.matched_surfaces == 0,
    "parity cannot pass for a nonexistent selected surface");
print "product_editions_pass";
