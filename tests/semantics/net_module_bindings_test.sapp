let Net = import("stdlib:net.sapp");

fn require(value, message) {
    if not value { throw "FAIL net-module-bindings: " + message; }
}

fn callable(value) {
    return type(value) == "fn" or type(value) == "closure" or type(value) == "builtin";
}
require(callable(Net.listen) and callable(Net.connect)
    and callable(Net.accept) and callable(Net.read_until)
    and callable(Net.write) and callable(Net.close),
    "raw TCP module members are callable functions");

let listener = Net.listen("127.0.0.1:0");
let address = Net.local_addr(listener);
require(type(address) == "string" and str_starts_with(address, "127.0.0.1:"),
    "module listener exposes its inspected loopback address");

let server = spawn(fn() {
    let socket = Net.accept(listener);
    let request = Net.read_until(socket, "\n", 128);
    Net.write(socket, "pong:" + request);
    Net.close(socket);
});
let client = Net.connect(address);
Net.write(client, "ping\n");
let response = Net.read_until(client, "\n", 128);
Net.close(client);
join(server);
Net.close(listener);

require(response == "pong:ping\n",
    "module exports call the native TCP builtins instead of self-binding nil");
print "pblang_net_module_bindings_pass";
