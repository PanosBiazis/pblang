// Synthetic private state only. No listener or remote system used.
let C=import("stdlib:crud_account_catalog.sapp");let P=import("stdlib:crud_persistent.sapp");let W=import("stdlib:crud_preview.sapp");let S=import("stdlib:secure_file.sapp");
let hash="$2b$12$B7w/XX4A/.4otknYJe0OOu69/Zr7IM3viqeA4Jl/tgB9GIcM/mPn.";
fn req(method,path,body="",cookie=""){return map{method:method,path:path,body:body,headers:map{host:"127.0.0.1:8765",origin:"http://127.0.0.1:8765","content-type":"application/x-www-form-urlencoded",cookie:cookie}};}
fn csrf(page){return str_split(str_split(page.body,"name=\"csrf\" value=\"")[1],"\"")[0];}
fn cookie(page){return str_split(page.headers["Set-Cookie"],";")[0];}
fn login(app,name){let page=app.handle(req("GET","/login"));return app.handle(req("POST","/login","username="+name+"&password=Synthetic+password+123%21&csrf="+csrf(page),cookie(page)));}
fn rejects(work){let failed=false;try work() catch {failed=true;};return failed;}
fn exercise(root){
    let path=root+"/accounts.pbauth";let records=root+"/records.pbcrud";
    C.initialize(path,map{editor:hash});P.initialize(records,10,2048);
    assert(rejects(fn(){C.initialize(path,map{other:hash});}),"existing catalog never overwritten");
    assert(C.read(path).revision==0,"read-only catalog load");
    let a=C.open(path);let b=C.open(path);let snapshot=a.snapshot();snapshot.accounts.injected=hash;
    assert(not map_has(a.snapshot().accounts,"injected"),"snapshot detached");
    assert(a.save(map{editor:hash,reviewer:hash},0)==1,"persist provisioned accounts");
    assert(rejects(fn(){b.save(map{loser:hash},0);}),"concurrent snapshot CAS conflict");
    assert(rejects(fn(){b.snapshot();}),"uncertain state requires refresh");
    assert(b.refresh()==1 and map_has(b.snapshot().accounts,"reviewer"),"refresh winner");a.close();b.close();
    let app=W.create_saved_accounts(records,path,8765,10,2048);
    let signed=login(app,"editor");assert(signed.status==303,"saved catalog login");let old=cookie(signed);
    let home=app.handle(req("GET","/","",old));assert(home.status==200,"authenticated records");
    let body="csrf="+csrf(home)+"&revision=0&id=1&name=Persisted&country=Test&time=1";
    assert(app.handle(req("POST","/create",body,old)).status==303,"authenticated save");app.close();
    let restarted=W.create_saved_accounts(records,path,8765,10,2048);
    assert(restarted.handle(req("GET","/","",old)).status==303,"sessions not persisted");
    let fresh=cookie(login(restarted,"editor"));
    let writer=C.open(path);assert(writer.save(map{reviewer:hash},1)==2,"remove account durably");writer.close();
    assert(restarted.reload_accounts()==2,"trusted explicit catalog reload");
    assert(restarted.handle(req("GET","/","",fresh)).status==303,"reload revokes all sessions");
    assert(login(restarted,"editor").status==401,"deleted account cannot sign in");
    let reviewer=login(restarted,"reviewer");assert(reviewer.status==303,"retained account login");
    let content=restarted.handle(req("GET","/","",cookie(reviewer)));
    assert(content.status==200 and str_contains(content.body,"Persisted") and not str_contains(content.body,hash) and not str_contains(content.body,root),"saved records without catalog exposure");
    let valid=fs_read(path);fs_write(path,"malformed");
    assert(rejects(fn(){restarted.reload_accounts();}),"malformed reload fails closed");
    assert(restarted.handle(req("GET","/","",cookie(reviewer))).status==503,"old sessions cannot survive failed reload");
    fs_write(path,valid);assert(restarted.reload_accounts()==2,"recover after trusted repair");
    assert(restarted.handle(req("GET","/","",cookie(reviewer))).status==303,"repair does not resurrect sessions");
    restarted.close();assert(rejects(fn(){restarted.reload_accounts();}),"closed guard never reopened");
    assert(proc_spawn_wait("/bin/chmod",["0644",path]).exit_code==0,"wrong mode fixture");
    assert(rejects(fn(){C.open(path);}),"readable-by-others catalog rejected");
    assert(proc_spawn_wait("/bin/chmod",["0600",path]).exit_code==0,"restore private mode");
    let link=root+"/alias.pbauth";
    assert(proc_spawn_wait("/bin/ln",[path,link]).exit_code==0,"hard link fixture");
    assert(rejects(fn(){C.open(path);}),"multiply linked catalog rejected");fs_remove(link);
    assert(proc_spawn_wait("/bin/ln",["-s",path,link]).exit_code==0,"symlink fixture");
    assert(rejects(fn(){C.open(link);}),"symlink catalog rejected");fs_remove(link);
    let closed=C.open(path);closed.close();assert(rejects(fn(){closed.refresh();}),"closed catalog never reopened");
}
if platform()=="linux" {
    let root="/tmp/pblang-saved-accounts-"+str_slice(sha256(json_stringify(random_bytes(16))),0,24);
    assert(S.create_private_directory_new(root).ok,"private fixture");
    let error=try {exercise(root);nil} catch "saved account workflow failed";
    for name in ["alias.pbauth","accounts.pbauth","accounts.pbauth.lock","records.pbcrud","records.pbcrud.lock"] {try fs_remove(root+"/"+name) catch nil;}
    assert(S.remove(root).ok,"fixture removed");assert(error==nil,"saved accounts workflow");
    print "crud_saved_accounts_live_pass";
} else {print "crud_saved_accounts_live_skip: Linux required";}
