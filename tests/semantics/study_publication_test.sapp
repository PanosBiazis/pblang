let P=import("stdlib:study_publication.sapp");let F=import("stdlib:study_files.sapp");let S=import("stdlib:study_cards.sapp");let OS=import("stdlib:os.sapp");
let root=OS.script_args()[0];let deck=S.create("Synthetic",[map{prompt:"Question",answer:"Answer"}],"2026-10-03");let text=S.encode(deck);let path=root+"/saved.pbdeck";
let saved=F.save_copy(path,deck);assert(saved.ok and saved.publication_confirmed and saved.written and saved.atomic_visibility and saved.durability_verified and saved.owned_handles_closed and not saved.partial_output_possible,"confirmed anonymous publication "+json_stringify(saved));assert(F.open_deck(path).deck==deck,"canonical roundtrip");
let collision=F.save_copy(path,deck);assert(not collision.ok and collision.publication_attempted and collision.output_may_exist and not collision.partial_output_possible and not map_has(collision,"written") and collision.owned_handles_closed,"collision does not invent publication evidence");assert(fs_read(path)==text,"existing output unchanged");
for bad in [root+"/missing/output.pbdeck",root+"/bad.txt",root+"/nul"+strfromcharcode(0)+".pbdeck"] {let r=P.save(bad,text);assert(not r.ok and not r.publication_attempted and not r.written and not r.partial_output_possible,"invalid target fails before publication");}
for badtext in [nil,"",str_repeat("x",262145)] {let r=P.save(root+"/invalid.pbdeck",badtext);assert(not r.ok and not r.written and not fs_exists(root+"/invalid.pbdeck"),"bounded content rejection");}
let invalid=F.save_copy(root+"/invalid-deck.pbdeck",map{});assert(not invalid.ok and not fs_exists(root+"/invalid-deck.pbdeck"),"canonical validation before publication");
let encoded=json_stringify(saved)+json_stringify(collision);for secret in [root,"Synthetic","Question","Answer","/proc/",".pblang-stage-"] {assert(not str_contains(encoded,secret),"no private paths/content/handles in reports");}
print "study_anonymous_publication_pass";
