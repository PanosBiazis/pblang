let S=import("stdlib:ui_spacing.sapp");
let UI=import("stdlib:modern_ui.sapp");
let GUI=import("stdlib:gui.sapp");
let Web=import("stdlib:modern_ui_web.sapp");
let Android=import("stdlib:modern_ui_android.sapp");
let compact=S.preset("compact");let roomy=S.preset("spacious");
assert(compact.gap==6 and compact.padding==12 and roomy.gap==20 and roomy.padding==28,"density presets");
compact.gap=100;assert(S.preset("compact").gap==6,"fresh independent presets");
let override=map{gap:0,name:"card"};let custom=S.preset("comfortable",override);
assert(custom.padding==20 and custom.gap==0 and custom.name=="card","ordinary option overrides");
custom.gap=4;assert(override.gap==0,"caller map preserved");
for bad in [-1,8193,1.5,nil,true,"12px",[]] {
    assert((try S.preset("compact",map{gap:bad}) catch nil)==nil,"bounded gap");
    assert((try S.preset("compact",map{padding:bad}) catch nil)==nil,"bounded padding");
}
assert((try S.preset("unknown") catch nil)==nil,"unknown density rejected");
assert((try S.preset("compact",[]) catch nil)==nil,"override map required");
let tree=UI.screen([UI.text("First",map{name:"first"}),UI.text("Second",map{name:"second"})],S.preset());
let f=UI.build("Space",tree,map{width:400,height:600,ui_scale:1});
let first=GUI.get(f,"first");let second=GUI.get(f,"second");
assert(first.x==20 and first.y==20 and second.y-first.y-first.h==12,"native uses shared spacing");
let web=Web.generate("Space",UI.compile(tree,map{target:"web"}));
assert(str_contains(web.css,"gap:12px") and str_contains(web.css,"padding:20px"),"Web uses shared spacing");
let bundle=UI.compile(tree,map{target:"android"});let original=Android.activity_class(bundle);
tree.gap=20;assert(original!=Android.activity_class(bundle),"root Android gap changes generated behavior");
tree.gap=12;tree.padding=0;assert(original!=Android.activity_class(bundle),"root Android padding honored including zero");
tree.gap="12px;bad";assert((try Android.activity_class(bundle) catch nil)==nil,"renderer revalidates mutated spacing");
for kind in ["column","row","grid","card"] {
    let node=map{kind:kind,children:[UI.text("A"),UI.text("B"),UI.text("C")],gap:12,padding:0};
    let view=UI.screen([node]);let compiled=UI.compile(view,map{target:"android"});
    let bytes=Android.activity_class(compiled);node.gap=0;
    assert(bytes!=Android.activity_class(compiled),"every Android container emits explicit gap");
    node.gap=12;node.padding=24;
    assert(bytes!=Android.activity_class(compiled),"every Android container emits explicit padding");
    if kind=="row" {node.padding=0;node.responsive=false;assert(bytes!=Android.activity_class(compiled),"fixed rows retain horizontal spacing");}
}
let old=UI.screen([UI.text("A"),UI.text("B")]);let old_bytes=Android.activity_class(UI.compile(old,map{target:"android"}));
old.gap=0;assert(old_bytes==Android.activity_class(UI.compile(old,map{target:"android"})),"zero gap adds no layout calls");
print "ui_spacing_pass";
