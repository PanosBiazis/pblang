// tests/semantics/compression_enrich_test.sapp — fix + enrichment for stdlib/compression.sapp
//
// BUG FIX: the old module captured the compressor's BINARY stdout as a string
// via exec(...) — any byte >= 128 was corrupted (UTF-8 re-encoding) — and built
// temp paths from str(random_bytes(4)) (spaces/brackets break the shell command).
// Rewritten to be byte-safe: temp files + fs_read_bytes (no stdout capture),
// operating on byte arrays throughout. ENRICH: xz, available(), auto_decompress
// by magic bytes.

let C = import("stdlib/compression.sapp");

fn fail(m) { throw "FAIL " + m; }
fn arr_eq(a, b, m) {
    if len(a) != len(b) { fail(m + " len " + str(len(a)) + " vs " + str(len(b))); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " @" + str(i) + " " + str(a[i]) + "!=" + str(b[i])); } i = i + 1; }
}

// Binary payload including bytes >= 128 — the exact data the old version corrupted.
let data = [0, 1, 127, 128, 200, 255, 72, 101, 108, 108, 111, 255, 0, 254];

let avail = C.available();
if not avail.gzip { fail("gzip should be available on this system"); }

// ── gzip byte-exact round-trip ───────────────────────────────────────────────────
let gz = C.gzip_compress(data);
if type(gz) != "array" { fail("gzip_compress must return a byte array, got " + type(gz)); }
arr_eq(C.gzip_decompress(gz), data, "gzip round-trip is byte-exact");

// ── zstd + xz round-trips (present on this system) ───────────────────────────────
if avail.zstd { arr_eq(C.zstd_decompress(C.zstd_compress(data)), data, "zstd round-trip"); }
if avail.xz   { arr_eq(C.xz_decompress(C.xz_compress(data)), data, "xz round-trip"); }

// ── ENRICH: auto_decompress detects the format from magic bytes ──────────────────
arr_eq(C.auto_decompress(C.gzip_compress(data)), data, "auto_decompress gzip");
if avail.zstd { arr_eq(C.auto_decompress(C.zstd_compress(data)), data, "auto_decompress zstd"); }

print "compression_enrich_pass";
