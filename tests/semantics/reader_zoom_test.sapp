let App=import("../../examples/declarative_browser/app.sapp");let GUI=import("stdlib:gui.sapp");let D=import("stdlib:browser_document.sapp");
let count=0;fn check(ok,label){assert(ok,label);count=count+1;}
fn press(c,key,options=nil){let event=map{type:"keydown",key:key,ctrl:true};if options!=nil {for name in map_keys(options){event[name]=options[name];}}App.update(c,[event,map{type:"keyup",key:key}]);}
let c=App.create();let document=D.export_html(c.session.snapshot().document);let history=c.session.snapshot();let saves=0;
App.enable_preferences(c,nil,fn(style){saves=saves+1;return map{ok:true};});App.update(c,[]);c.form.focus="block2";
press(c,"Equal");check(c.appearance.font_scale==1.05,"Ctrl+Equal zooms in");check(c.form.focus=="block2","focused link survives zoom");
check(c.preferences.draft.font_scale==1.05 and saves==0,"session zoom synchronizes draft without saving");check(c.session.snapshot()==history and D.export_html(c.session.snapshot().document)==document,"zoom preserves document and navigation");
press(c,"Minus");check(c.appearance.font_scale==1,"Ctrl+Minus zooms out");
press(c,"Equal",map{shift:true});check(c.appearance.font_scale==1.05,"Ctrl+Shift+Equal supports plus");
press(c,"Key0");check(c.appearance.font_scale==1,"Ctrl+0 resets scale");
App.configure(c,map{font_family:"serif",body_size:19,title_size:35,line_height:1.7,font_scale:1.3});App.update(c,[]);press(c,"Key0");
check(c.appearance.font_scale==1 and c.appearance.font_family=="serif" and c.appearance.body_size==19 and c.appearance.title_size==35 and c.appearance.line_height==1.7,"reset only changes scale");
for key in ["Equal","Equals","=","+","NumpadAdd","NumPadPlus"] {App.configure(c,map{font_scale:1});App.update(c,[]);press(c,key);check(c.appearance.font_scale==1.05,"zoom-in key alias");}
for key in ["Minus","-","NumpadSubtract","NumPadMinus"] {App.configure(c,map{font_scale:1});App.update(c,[]);press(c,key);check(c.appearance.font_scale==0.95,"zoom-out key alias");}
for key in ["0","Key0","Digit0","Num0","Numpad0","NumPad0"] {App.configure(c,map{font_scale:1.2});App.update(c,[]);press(c,key);check(c.appearance.font_scale==1,"zoom-reset key alias");}
for opts in [map{ctrl:false},map{alt:true},map{meta:true},map{ctrl:false,alt:true}] {press(c,"Equal",opts);check(c.appearance.font_scale==1,"unmodified or conflicting shortcut ignored");}
press(c,"Minus",map{shift:true});press(c,"Key0",map{shift:true});check(c.appearance.font_scale==1,"shifted minus and zero ignored");
press(c,"Equal",map{ctrl:false,meta:true});check(c.appearance.font_scale==1.05,"Meta modifier contract");
App.update(c,[map{type:"keydown",key:"LeftCtrl"},map{type:"keydown",key:"Minus"},map{type:"keyup",key:"Minus"},map{type:"keyup",key:"LeftCtrl"}]);check(c.appearance.font_scale==1,"pressed modifier fallback");
App.update(c,[map{type:"keydown",key:"Equal",ctrl:true},map{type:"keydown",key:"Equal",ctrl:true}]);check(c.appearance.font_scale==1.05,"held key changes once");App.update(c,[map{type:"keyup",key:"Equal"}]);
check(App.zoom_shortcuts(c,false) and not App.zoom_shortcuts(c,false),"embedder opt-out is idempotent");press(c,"Equal");check(c.appearance.font_scale==1.05,"disabled shortcut does not zoom");check(App.zoom(c,-1) and c.appearance.font_scale==1,"direct zoom API remains available");App.zoom_shortcuts(c,true);
App.configure(c,map{font_scale:1.234});App.zoom(c,1);check(c.appearance.font_scale==1.25,"off-grid zoom up");App.configure(c,map{font_scale:1.234});App.zoom(c,-1);check(c.appearance.font_scale==1.2,"off-grid zoom down");
App.configure(c,map{font_scale:1.5});check(not App.zoom(c,1) and c.appearance.font_scale==1.5,"upper bound stable");App.configure(c,map{font_scale:0.75});check(not App.zoom(c,-1) and c.appearance.font_scale==0.75,"lower bound stable");
for invalid in [nil,"1",2,0.5] {check((try App.zoom(c,invalid) catch "rejected")=="rejected","invalid zoom step rejected");}
check((try App.zoom_shortcuts(c,1) catch "rejected")=="rejected","invalid shortcut policy rejected");
App.configure(c,map{font_scale:1});App.update(c,[]);GUI.get(c.form,"appearance").onclick(c.form);App.update(c,[]);let draft=c.preferences.draft;
press(c,"Equal");check(c.settings and c.preferences.draft==draft and c.appearance.font_scale==1,"Style draft owns its keyboard controls");check(not App.zoom(c,1),"direct zoom unavailable in Style");
App.close_preferences(c);App.update(c,[]);c.form.focus="block2";
App.update(c,[map{type:"keydown",key:"Equal",ctrl:true},map{type:"keyup",key:"Equal"},map{type:"keydown",key:"Enter"},map{type:"keyup",key:"Enter"}]);check(c.session.snapshot().url=="pb://guide" and c.navigations==1,"same-batch Enter targets refreshed focused link");
App.update(c,[map{type:"close"}]);check(not App.zoom(c,1),"closed controller cannot zoom");check(saves==0,"no zoom action invoked saver");c.session.close();
let small=App.create("local","dark",map{title_size:40,font_scale:1.5});App.update(small,[map{type:"resize",w:320,h:240}]);
check(not small.reading_plan.available,"large-text compact fixture is unavailable");
for i 15 {press(small,"Minus");}
check(small.appearance.font_scale==0.75 and small.appearance.title_size==40 and small.reading_plan.available,"keyboard zoom recovers compact reading without resetting title size");small.session.close();
print "reader_zoom_pass checks="+str(count);
