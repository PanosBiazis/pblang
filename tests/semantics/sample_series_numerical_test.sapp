let S=import("stdlib:sample_series.sapp");
// Width one copies each binary64 sample, including sign of zero and subnormals.
let identity=[1000000000,0.000000001,-1000000000,-0.000000001,parse_number("-0"),parse_number("5e-324")];
let copied=S.moving_mean(identity,1);
assert(copied.format=="pblang.moving-mean.v1" and copied.window==1 and copied.first_source_index==0,"metadata unchanged");
for at in range(0,len(identity)) {assert(num_to_le_bytes(copied.values[at])==num_to_le_bytes(identity[at]),"width one exact binary64 identity");}
copied.values[1]=9;assert(identity[1]==0.000000001,"width one result detached");
assert(S.moving_mean([1000000000,0.000000001,0.000000001],2).values[1]==0.000000001,"expired large sample cannot erase small pair");
assert(S.moving_mean([-1000000000,-0.000000001,-0.000000001],2).values[1]==-0.000000001,"negative expired large sample");
assert(S.moving_mean([1000000000,0.000000001,-1000000000],3).values[0]==0.000000001/3,"positive residual within cancellation window");
assert(S.moving_mean([-1000000000,-0.000000001,1000000000],3).values[0]==-0.000000001/3,"negative residual within cancellation window");
assert(S.moving_mean([0.000000001,1000000000,-1000000000],3).values[0]==0.000000001/3,"correction when new sample exceeds sum");
// Independent fixed-point oracle: integer coefficients summed afresh, then scaled.
// Powers of two keep the reference's additions exact, with several signs/scales.
let cases=0;
for scale in [0.0000000000009094947017729282,0.0009765625,1,32768] {
    let values=[];let coefficients=[];
    let index=0;while index<31 {let coefficient=(index*7919)%32749-16374;array_push(coefficients,coefficient);array_push(values,coefficient*scale);index=index+1;}
    for width in range(1,32) {
        let report=S.moving_mean(values,width);
        assert(len(report.values)==32-width and report.first_source_index==width-1,"all complete windows aligned");
        for start in range(0,32-width) {
            let integer_total=0;for j in range(start,start+width) {integer_total=integer_total+coefficients[j];}
            assert(report.values[start]==integer_total*scale/width,"fresh fixed-point oracle");cases=cases+1;
        }
    }
}
assert(cases==1984,"fixed-point oracle output count");
// Maximum length and full window remain accepted; no narrower numeric range.
let maximum=[];let position=0;while position<4096 {array_push(maximum,if position%2==0 {1000000000} else {-1000000000});position=position+1;}
assert(S.moving_mean(maximum,4096).values==[0],"full maximum cancellation window");
assert(len(S.moving_mean(maximum,1).values)==4096,"maximum identity length");
let tiny=parse_number("1e-30");
let layered=S.moving_mean([1000000000,0.000000001,tiny,tiny,tiny],2).values;
assert(layered[2]==tiny and layered[3]==tiny,"expired contributions across three scales");
for sign in [-1,1] {
    let residual=S.moving_mean([sign*tiny,sign*1000000000,sign*0.000000001,-sign*1000000000,-sign*0.000000001],5).values[0];
    assert(residual==sign*tiny/5,"retain three scales within one cancellation window");
}
// Repeated ring values and non-power-of-two windows preserve every output.
let periodic=[1000000000,0.000000001,-1000000000,1000000000,0.000000001,-1000000000,1000000000,0.000000001,-1000000000];
let periodic_result=S.moving_mean(periodic,3).values;
for mean in periodic_result {assert(mean==0.000000001/3,"unchanged ring replacement preserves residual");}
assert(len(periodic_result)==7,"unchanged replacements still emit aligned outputs");
let zero_pairs=S.moving_mean([parse_number("-0"),0,0,parse_number("-0"),0],2).values;
for mean in zero_pairs {assert(num_to_le_bytes(mean)==num_to_le_bytes(0),"wider-window signed zero unchanged");}
let repeated=S.moving_mean([1,2,3,1,2,9,1,2,9],3).values;
assert(repeated==[2,2,2,4,4,4,4],"no-op ring followed by changed and repeated leaves");
assert(periodic[0]==1000000000 and periodic[8]==-1000000000,"ring never changes input");
print "sample_series_numerical_pass";
