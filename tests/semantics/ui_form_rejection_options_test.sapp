let D=import("stdlib:ui_document.sapp");let W=import("stdlib:ui_form_web.sapp");let P=import("stdlib:ui_form_web_document.sapp");
let doc=D.from_design(map{form:map{title:"Test",w:300,h:200},widgets:[],model:map{}});
fn req(path="/"){return map{method:"GET",path:path,body:"",headers:map{host:"127.0.0.1:8766"}};}
let opts=map{discourage_scraping:false,rejected_request_limit:2,rejection_window_ms:200,rejection_cooldown_ms:200};
let app=W.create(doc,map{},8766,opts);opts.rejected_request_limit=100;
assert(app.handle(req("/unknown")).status==404,"first rejection");
sleep_ms(250);
assert(app.handle(req("/unknown")).status==404 and app.handle(req()).status==200,"window expiry independent of crawler window");
assert(app.handle(req("/unknown")).status==404,"second rejection");
let blocked=app.handle(req());assert(blocked.status==429 and blocked.headers["Retry-After"]=="1","detached settings and rounded retry");
sleep_ms(250);assert(app.handle(req()).status==200,"configured cooldown expires");app.close();
let defaults=P.prepare(doc,map{}).policy;assert(defaults.throttle_rejected_requests and defaults.rejected_request_limit==8 and defaults.rejection_window_ms==60000 and defaults.rejection_cooldown_ms==30000,"defaults preserved");
for invalid in [map{rejected_request_limit:0},map{rejected_request_limit:true},map{rejected_request_limit:1.5},map{rejected_request_limit:10001},map{rejection_window_ms:99},map{rejection_cooldown_ms:3600001},map{rejection_window_ms:nil},map{unsafe:true}] {
    let failed=false;try W.create(doc,map{},8766,invalid) catch {failed=true;};assert(failed,"invalid policy rejected");
}
let off=W.create(doc,map{},8766,map{discourage_scraping:false,throttle_rejected_requests:false,rejected_request_limit:1});
for i 3 {assert(off.handle(req("/unknown")).status==404,"explicit opt out");}
let bad=req();bad.headers.host="foreign.invalid";assert(off.handle(bad).status==403,"core protection retained");off.close();
print "ui_form_rejection_options_pass";
