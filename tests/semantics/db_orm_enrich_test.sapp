// tests/semantics/db_orm_enrich_test.sapp — enrichment for stdlib/db.sapp + stdlib/orm.sapp
//
// db:  query_one / query_value (scalar/row convenience), quote_ident (safe
//      dynamic identifiers).
// orm: find (where/order/limit/offset options), update_where (bulk), pluck
//      (single column), upsert (insert-or-replace by id).

let db = import("stdlib/db.sapp");
let orm = import("stdlib/orm.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let c = db.sqlite.open(":memory:");
c.exec("create table t(id integer primary key, name text, age integer)", []);
c.exec("insert into t(name, age) values (?,?)", ["alice", 30]);
c.exec("insert into t(name, age) values (?,?)", ["bob", 25]);
c.exec("insert into t(name, age) values (?,?)", ["carol", 40]);

// ── db.query_one / query_value ───────────────────────────────────────────────────
let one = db.query_one(c, "select * from t where name = ?", ["bob"]);
eq(one.age, 25, "query_one returns the row");
eq(db.query_one(c, "select * from t where name = ?", ["nobody"]), nil, "query_one nil when no match");
eq(db.query_value(c, "select count(*) from t", []), 3, "query_value scalar");

// ── db.quote_ident — safe dynamic identifier ─────────────────────────────────────
eq(db.quote_ident("my_table"), "\"my_table\"", "quote_ident wraps in double quotes");
eq(db.quote_ident("a\"b"), "\"a\"\"b\"", "quote_ident doubles internal quotes");

// ── orm.find with options ────────────────────────────────────────────────────────
let oldest = orm.find(c, "t", map{ order: "age DESC", limit: 1 });
eq(len(oldest), 1, "find limit 1"); eq(oldest[0].name, "carol", "find order age DESC -> carol");
let adults = orm.find(c, "t", map{ where: "age >= ?", params: [30], order: "age ASC" });
eq(len(adults), 2, "find where age>=30"); eq(adults[0].name, "alice", "find order asc first");

// ── orm.pluck — single column as array ───────────────────────────────────────────
let names = orm.pluck(c, "t", "name", map{ order: "id ASC" });
eq(len(names), 3, "pluck count"); eq(names[0], "alice", "pluck first"); eq(names[2], "carol", "pluck last");

// ── orm.update_where — bulk update ───────────────────────────────────────────────
orm.update_where(c, "t", map{ age: 99 }, "name = ?", ["bob"]);
eq(orm.find_one(c, "t", "name = ?", ["bob"]).age, 99, "update_where applied");

// ── orm.upsert — insert or replace by id ─────────────────────────────────────────
orm.upsert(c, "t", map{ id: 1, name: "alice2", age: 31 });
eq(orm.find_by_id(c, "t", 1).name, "alice2", "upsert replaced existing id");
eq(orm.count(c, "t"), 3, "upsert did not add a row");

c.close();
print "db_orm_enrich_pass";
