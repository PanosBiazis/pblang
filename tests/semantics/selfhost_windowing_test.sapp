let FE=import("stdlib:compiler/selfhost_frontend.sapp");
let source="let F=import(\"stdlib:functional.sapp\");"
    + "let bad=[];for operation in [F.chunk,F.windows] {"
    + "for size in [1.5,-0.5,nil,true,\"2\",[],parse_number(\"NaN\"),parse_number(\"inf\"),parse_number(\"-inf\")] {"
    + "let outcome=try map{ok:true,value:operation([],size)} catch map{ok:false};push(bad,outcome.ok);}}"
    + "let input=[1,2,3,4,5];let chunks=F.chunk(input,2);let windows=F.windows(input,3);"
    + "let part=chunks[0];part[0]=9;"
    + "let result=[bad,chunks,windows,input,F.windows(input,0),F.windows(input,-2),F.chunk([],2)];";
let run=FE.frontend_run_bounded(source,map{max_steps:30000,max_frames:24,max_modules:10,max_source_bytes:32768});
if not run.ok {throw "FAIL selfhost-windowing: actual library import/execution";}
let expected=[[false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false,false],
    [[9,2],[3,4],[5]],[[1,2,3],[2,3,4],[3,4,5]],[1,2,3,4,5],[],[],[]];
if run.globals.result!=expected {throw "FAIL selfhost-windowing: shape, validation or aliasing";}
print "selfhost_windowing_pass";
