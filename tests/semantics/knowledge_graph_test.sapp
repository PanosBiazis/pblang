// knowledge_graph_test.sapp — behavior for stdlib:knowledge_graph.sapp
// (graphify + Obsidian: wikilinks, backlinks, communities, queries, vault output).

import "stdlib:knowledge_graph.sapp";

let fails = 0;
fn check(cond, msg) { if not cond { print "FAIL " + msg; fails = fails + 1; } }
fn _has(s, sub) { return len(str_split(s, sub)) > 1; }   // substring test without importing strings

// ── wikilink parsing (incl. alias + section suffixes) ──
let ls = knowledge_graph.parse_links("a [[Foo]] b [[Bar Baz#Sec|alias]] c [[Foo]]");
check(len(ls) == 3, "parse_links count");
check(ls[0] == "Foo", "parse_links plain");
check(ls[1] == "Bar Baz", "parse_links strips #section and |alias");

// ── build + backlinks + degree ──
let g = knowledge_graph.build(map{
  "Auth":     "uses [[Database]] and [[Crypto]], see [[Session]]",
  "Database": "encrypted via [[Crypto]]",
  "Crypto":   "hashing and [[Keys]]",
  "Session":  "built on [[Auth]]",
  "Keys":     "managed by [[Crypto]]",
  "Lonely":   "no links here"
});
let bc = knowledge_graph.backlinks(g, "Crypto");
check(len(bc) == 3, "backlinks(Crypto) = Auth,Database,Keys");
check(len(knowledge_graph.outlinks(g, "Auth")) == 3, "outlinks(Auth) = 3");
check(knowledge_graph.degree(g, "Crypto") == 4, "degree(Crypto) = 4");

// ── communities: the linked cluster vs the lonely note ──
let cm = knowledge_graph.communities(g);
check(cm.count == 2, "two communities (cluster + Lonely)");
check(cm.assign["Auth"] != cm.assign["Lonely"], "Lonely in its own community");

// ── query neighbourhood + shortest path ──
let q = knowledge_graph.query(g, "Auth", 1);
check(len(q) >= 3, "query depth 1 reaches direct links");
let sp = knowledge_graph.shortest_path(g, "Keys", "Session");
check(sp != nil, "path Keys→Session exists");
check(sp[0] == "Keys" and sp[len(sp) - 1] == "Session", "path endpoints correct");

// ── hubs + orphans ──
let h = knowledge_graph.hubs(g, 2);
check(h[0].degree >= h[1].degree, "hubs sorted by degree descending");
check(h[0].degree == 4, "top hub degree is 4 (Auth/Crypto tie)");
let orph = knowledge_graph.orphans(g);
check(len(orph) == 1 and orph[0] == "Lonely", "Lonely is the only orphan");

// ── outputs: markdown backlinks section + JSON ──
let md = knowledge_graph.note_markdown(g, "Crypto");
check(_has(md, "## Backlinks"), "note markdown has Backlinks section");
let js = knowledge_graph.to_json(g);
check(_has(js, "\"nodes\"") and _has(js, "\"edges\""), "to_json has nodes and edges");

if fails == 0 { print "knowledge_graph_test: pass"; }
