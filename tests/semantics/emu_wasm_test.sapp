let WASM = import("stdlib:emulator_wasm.sapp");

fn value(instructions, locals = 0) {
    let result = WASM.run(WASM.program(instructions), locals);
    if not result.ok { throw result.error; }
    return result.value;
}

let constant = WASM.i32_const(5);
assert(constant[0] == 65 and constant[1] == 5, "canonical i32.const encoding");
assert(value([WASM.i32_const(42), WASM.return_instruction()]) == 42, "const");
assert(value([WASM.i32_const(5), WASM.i32_const(7), WASM.add_i32(), WASM.return_instruction()]) == 12, "add");
assert(value([WASM.i32_const(20), WASM.i32_const(8), WASM.subtract_i32(), WASM.return_instruction()]) == 12, "subtract");
assert(value([WASM.i32_const(6), WASM.i32_const(7), WASM.multiply_i32(), WASM.return_instruction()]) == 42, "multiply");
assert(value([WASM.i32_const(5), WASM.local_set(0), WASM.i32_const(0), WASM.local_set(1),
              WASM.block(), WASM.loop(), WASM.local_get(0), WASM.equal_zero_i32(), WASM.branch_if(1),
              WASM.local_get(1), WASM.local_get(0), WASM.add_i32(), WASM.local_set(1),
              WASM.local_get(0), WASM.i32_const(1), WASM.subtract_i32(), WASM.local_set(0),
              WASM.branch(0), WASM.end(), WASM.end(), WASM.local_get(1), WASM.return_instruction()], 2) == 15,
    "structured loop");

assert(not WASM.run([65, 128], 0).ok, "truncated LEB128 fails closed");
assert(not WASM.run([2, 64, 15], 0).ok, "unterminated block fails closed");
assert(not WASM.run([11], 0).ok, "unmatched end fails closed");
assert(not WASM.run(WASM.program([WASM.local_get(1), WASM.return_instruction()]), 1).ok, "local bounds enforced");
assert(not WASM.run(WASM.program([WASM.add_i32(), WASM.return_instruction()]), 0).ok, "stack underflow fails closed");
assert(not WASM.run(WASM.program([WASM.loop(), WASM.branch(0), WASM.end()]), 0,
    map{ instruction_budget: 5 }).ok, "loop budget enforced");

print "emu_wasm: reusable bounded subset passed LEB128, i32, structured control, malformed-code, and budget checks";
