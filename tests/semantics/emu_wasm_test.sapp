// emu_wasm_test.sapp — a verified WebAssembly execution model in pblang (the universal / browser target).
//
// WASM is how pblang reaches EVERY browser and many edge/serverless runtimes — one compile target, runs anywhere
// a wasm engine exists. It's also the 4th CPU paradigm in the suite: a STACK machine with STRUCTURED control flow
// (block / loop / br / br_if / end), not flat branches — and it uses real LEB128 variable-length integers. This
// models a faithful subset (real opcodes, real LEB128, real branch-to-label semantics) and verifies by COMPUTED
// RESULT, so a future pblang→wasm backend can be RUN-tested here with no browser.

fn fail(m) { throw "FAIL emu-wasm: " + m; }
fn _cat(a, b) { let i = 0; while i < len(b) { push(a, b[i]); i = i + 1; } return a; }

// ── LEB128 (the variable-length integer encoding WASM uses everywhere) ──
fn _elu(n) { let out = []; let v = n; let cont = true;                         // encode unsigned
    while cont { let b = v % 128; v = num_floor(v / 128); if v != 0 { push(out, b + 128); } else { push(out, b); cont = false; } } return out; }
fn _els(n) { let out = []; let v = n; let cont = true;                         // encode signed
    while cont { let b = v % 128; if b < 0 { b = b + 128; } v = num_floor(v / 128); let sign = num_floor(b / 64) % 2;
        if (v == 0 and sign == 0) or (v == (0 - 1) and sign == 1) { push(out, b); cont = false; } else { push(out, b + 128); } } return out; }
fn _dlu(code, pc) { let result = 0; let shift = 1; let p = pc; let cont = true; // decode unsigned -> [val, next]
    while cont { let b = code[p]; p = p + 1; result = result + (b % 128) * shift; if b < 128 { cont = false; } else { shift = shift * 128; } } return [result, p]; }
fn _dls(code, pc) { let result = 0; let shift = 1; let p = pc; let cont = true; let last = 0;  // decode signed
    while cont { let b = code[p]; p = p + 1; last = b; result = result + (b % 128) * shift; shift = shift * 128; if b < 128 { cont = false; } }
    if last % 128 >= 64 { result = result - shift; } return [result, p]; }

// ── encoder (real WASM opcodes) ──  void blocktype = 0x40 = 64
fn I32_CONST(n) { let o = [65]; return _cat(o, _els(n)); }
fn LOCAL_GET(i) { let o = [32]; return _cat(o, _elu(i)); }
fn LOCAL_SET(i) { let o = [33]; return _cat(o, _elu(i)); }
fn BLOCK() { return [2, 64]; }   fn LOOP() { return [3, 64]; }   fn END() { return [11]; }
fn BR(d) { let o = [12]; return _cat(o, _elu(d)); }   fn BR_IF(d) { let o = [13]; return _cat(o, _elu(d)); }
fn ADD() { return [106]; }   fn SUB() { return [107]; }   fn MUL() { return [108]; }
fn EQZ() { return [69]; }    fn NE() { return [71]; }     fn RETURN() { return [15]; }

// ── decode one instruction -> [op, imm, next_pc] ──
fn _ins(code, pc) {
    let op = code[pc];
    if op == 2 or op == 3 or op == 4 { return [op, code[pc + 1], pc + 2]; }        // block/loop/if + blocktype
    if op == 12 or op == 13 { let d = _dlu(code, pc + 1); return [op, d[0], d[1]]; } // br / br_if
    if op == 32 or op == 33 or op == 34 { let d = _dlu(code, pc + 1); return [op, d[0], d[1]]; } // local.*
    if op == 65 { let d = _dls(code, pc + 1); return [op, d[0], d[1]]; }            // i32.const
    return [op, 0, pc + 1];                                                         // end/return/arith (no imm)
}

// ── match each block/loop opener to its END (forward scan) ──
fn _match_ends(code) {
    let ends = []; let i = 0; while i < len(code) { push(ends, 0 - 1); i = i + 1; }
    let stack = []; let ssp = 0; let pc = 0;
    while pc < len(code) {
        let ins = _ins(code, pc); let op = ins[0];
        if op == 2 or op == 3 or op == 4 { if ssp == len(stack) { push(stack, pc); } else { stack[ssp] = pc; } ssp = ssp + 1; }
        else if op == 11 { if ssp > 0 { ssp = ssp - 1; ends[stack[ssp]] = pc; } }
        pc = ins[1 + 1];
    }
    return ends;
}

// ── interpreter ──  a single function body with `nlocals` locals; result = top of stack at return / fall-off.
fn wasm_run(code, nlocals) {
    let ends = _match_ends(code);
    let loc = []; let i = 0; while i < nlocals { push(loc, 0); i = i + 1; }
    let st = []; let sp = 0;                                    // operand stack
    let ck = []; let cc = []; let ch = []; let csp = 0;         // control: kind, continuation-pc, entry-height
    let pc = 0; let guard = 0; let halted = false; let result = 0;
    while pc < len(code) and guard < 1000000 and not halted {
        guard = guard + 1;
        let ins = _ins(code, pc); let op = ins[0]; let imm = ins[1]; let nx = ins[2];
        if op == 65 { if sp == len(st) { push(st, imm); } else { st[sp] = imm; } sp = sp + 1; pc = nx; }        // i32.const
        else if op == 32 { let v = loc[imm]; if sp == len(st) { push(st, v); } else { st[sp] = v; } sp = sp + 1; pc = nx; }  // local.get
        else if op == 33 { sp = sp - 1; loc[imm] = st[sp]; pc = nx; }                                          // local.set
        else if op == 106 { sp = sp - 1; let b = st[sp]; sp = sp - 1; st[sp] = st[sp] + b; sp = sp + 1; pc = nx; } // add
        else if op == 107 { sp = sp - 1; let b = st[sp]; sp = sp - 1; st[sp] = st[sp] - b; sp = sp + 1; pc = nx; } // sub
        else if op == 108 { sp = sp - 1; let b = st[sp]; sp = sp - 1; st[sp] = st[sp] * b; sp = sp + 1; pc = nx; } // mul
        else if op == 69 { let v = 0; if st[sp - 1] == 0 { v = 1; } st[sp - 1] = v; pc = nx; }                  // eqz
        else if op == 71 { sp = sp - 1; let b = st[sp]; let v = 0; if st[sp - 1] != b { v = 1; } st[sp - 1] = v; pc = nx; } // ne
        else if op == 2 or op == 3 {                                                                           // block / loop
            let kind = op; let cont = 0;
            if op == 3 { cont = nx; } else { cont = ends[pc] + 1; }   // loop -> re-enter body; block -> after END
            if csp == len(ck) { push(ck, kind); push(cc, cont); push(ch, sp); } else { ck[csp] = kind; cc[csp] = cont; ch[csp] = sp; }
            csp = csp + 1; pc = nx;
        }
        else if op == 11 { if csp > 0 { csp = csp - 1; } pc = nx; }                                            // end -> pop label
        else if op == 12 or op == 13 {                                                                        // br / br_if
            let doit = true;
            if op == 13 { sp = sp - 1; if st[sp] == 0 { doit = false; } }
            if doit {
                let target = csp - 1 - imm;
                let kind = ck[target]; let cont = cc[target]; let h = ch[target];
                sp = h;                          // unwind operand stack to the label's entry height (void labels)
                if kind == 3 { csp = target + 1; } else { csp = target; }   // loop: keep frame; block: pop it
                pc = cont;
            } else { pc = nx; }
        }
        else if op == 15 { halted = true; if sp > 0 { result = st[sp - 1]; } }                                 // return
        else { throw "wasm_run: unmodeled opcode " + str(op); }
    }
    if guard >= 1000000 { fail("instruction budget exceeded"); }
    if not halted { if sp > 0 { result = st[sp - 1]; } }    // fall-off end returns top of stack
    return result;
}

// ── encoder spec-check (canonical) + programs verified by result ──
fn prog(insns) { let c = []; let i = 0; while i < len(insns) { _cat(c, insns[i]); i = i + 1; } return c; }
fn eq(g, w, m) { if g != w { fail(m + ": got " + str(g) + " want " + str(w)); } }
eq(I32_CONST(5)[0] * 256 + I32_CONST(5)[1], 65 * 256 + 5, "i32.const 5 = 0x41 0x05");

eq(wasm_run(prog([I32_CONST(42), RETURN()]), 0),                                          42, "const");
eq(wasm_run(prog([I32_CONST(5), I32_CONST(7), ADD(), RETURN()]), 0),                      12, "5+7");
eq(wasm_run(prog([I32_CONST(20), I32_CONST(8), SUB(), RETURN()]), 0),                     12, "20-8");
eq(wasm_run(prog([I32_CONST(6), I32_CONST(7), MUL(), RETURN()]), 0),                      42, "6*7");
// structured loop: locals [0]=i, [1]=acc ; sum i=5..1 -> 15
//   i=5; acc=0; block{ loop{ get i; eqz; br_if 1; get acc; get i; add; set acc; get i; const 1; sub; set i; br 0 } }; get acc
eq(wasm_run(prog([I32_CONST(5), LOCAL_SET(0), I32_CONST(0), LOCAL_SET(1),
                  BLOCK(), LOOP(),
                    LOCAL_GET(0), EQZ(), BR_IF(1),
                    LOCAL_GET(1), LOCAL_GET(0), ADD(), LOCAL_SET(1),
                    LOCAL_GET(0), I32_CONST(1), SUB(), LOCAL_SET(0),
                    BR(0),
                  END(), END(),
                  LOCAL_GET(1), RETURN()]), 2),                                           15, "structured loop sum 5..1");
// nested: multiply 4*3 by repeated add in a loop -> 12
eq(wasm_run(prog([I32_CONST(4), LOCAL_SET(0), I32_CONST(0), LOCAL_SET(1),
                  BLOCK(), LOOP(),
                    LOCAL_GET(0), EQZ(), BR_IF(1),
                    LOCAL_GET(1), I32_CONST(3), ADD(), LOCAL_SET(1),
                    LOCAL_GET(0), I32_CONST(1), SUB(), LOCAL_SET(0),
                    BR(0),
                  END(), END(),
                  LOCAL_GET(1), RETURN()]), 2),                                           12, "loop 4*3 via repeated add");

print "emu_wasm: stack machine w/ real LEB128 + structured control (block/loop/br/br_if) — all results correct";
