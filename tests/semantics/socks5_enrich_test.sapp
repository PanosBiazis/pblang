// tests/semantics/socks5_enrich_test.sapp — fixes + enrichment for stdlib/socks5
//
// FIX: messages were carried as UTF-8 string code points, so any byte >= 128 (e.g.
//   port 443's low byte 0xBB) was re-encoded multi-byte and corrupted on the wire.
//   They are now BYTE ARRAYS, sent verbatim by the (newly byte-array-capable)
//   tcp_write builtin.
// ENRICH: IPv4-literal targets (atyp 1), username/password auth (RFC 1929), and a
//   high-level connect()/handshake() that runs the full flow over tcp_connect.

let S = import("stdlib/socks5.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn arr_eq(a, b, m) {
    if len(a) != len(b) { fail(m + " len " + str(len(a)) + " vs " + str(len(b)) + " : " + str(a)); }
    let i = 0; while i < len(a) { if a[i] != b[i] { fail(m + " @" + str(i)); } i = i + 1; }
}

// ── byte-array messages (binary-correct) ────────────────────────────────────────
arr_eq(S.greeting(), [5, 1, 0], "no-auth greeting");
let req = S.connect_request("example.com", 443);
eq(req[3], 3, "domain atyp");
eq(req[4], 11, "domain length");
eq(req[5 + 11], 1, "port 443 hi = 1");
eq(req[5 + 11 + 1], 187, "port 443 lo = 187 (0xBB) — a real byte, not corrupted");

// ── ENRICH: IPv4-literal target uses atyp 1 ─────────────────────────────────────
let r4 = S.connect_request("1.2.3.4", 80);
arr_eq([r4[3], r4[4], r4[5], r4[6], r4[7], r4[8], r4[9]], [1, 1, 2, 3, 4, 0, 80], "IPv4 atyp + addr + port");

// ── ENRICH: username/password auth (RFC 1929) ───────────────────────────────────
arr_eq(S.greeting_auth(), [5, 2, 0, 2], "auth greeting offers no-auth + userpass");
arr_eq(S.userpass_auth_request("u", "pw"), [1, 1, 117, 2, 112, 119], "userpass auth request");
eq(S.auth_ok(S.parse_auth_reply([1, 0])), true, "auth success");
eq(S.auth_ok(S.parse_auth_reply([1, 1])), false, "auth failure");

// ── parsers accept byte arrays (and still strings) ──────────────────────────────
eq(S.method_ok(S.parse_method_reply([5, 0])), true, "method ok (array)");
eq(S.method_ok(S.parse_method_reply(strfromcharcode(5) + strfromcharcode(0))), true, "method ok (string compat)");
let cr = S.parse_connect_reply([5, 0, 0, 1]);
eq(cr.rep, 0, "connect rep"); eq(cr.atyp, 1, "connect atyp");
eq(S.connect_ok(cr), true, "connect ok");
eq(S.rep_text(8), "address type not supported", "extended rep text");

// ── ENRICH: connect() degrades gracefully when the proxy is unreachable ──────────
let c = try S.connect("127.0.0.1:1", "example.com", 443) catch "THREW";
if c == "THREW" { fail("connect must not throw on an unreachable proxy"); }
eq(c.ok, false, "unreachable proxy -> ok:false");
if not map_has(c, "error") { fail("unreachable proxy -> error message"); }

print "socks5_enrich_pass";
