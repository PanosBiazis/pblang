let R = import("stdlib:repro_benchmark.sapp");

fn require(ok, message) { if not ok { throw "FAIL " + message; } }
fn eq(actual, expected, message) {
    if actual != expected { throw "FAIL " + message + " got=" + str(actual) + " expected=" + str(expected); }
}

eq(len(R.languages()), 12, "fixed competitor registry");
eq(R.workloads(), ["startup", "integer_kernel"], "stable workload order");
eq(len(R.coverage()), 22, "every requested benchmark category is represented");
eq(R.expected("startup"), "1", "startup checksum");
require(len(R.expected("integer_kernel")) > 0, "kernel checksum exists");

let seen = map{}; let coverage = R.coverage(); let i = 0;
while i < len(coverage) {
    let c = coverage[i];
    require(not map_has(seen, c.category), "coverage categories are unique");
    require(c.status == "runnable" or c.status == "partial" or
            c.status == "conditional" or c.status == "not-comparable",
            "coverage status is explicit");
    if c.status != "runnable" { require(map_has(c, "reason"), "non-runnable coverage explains boundary"); }
    seen[c.category] = true;
    i = i + 1;
}

let langs = R.languages(); i = 0;
while i < len(langs) {
    let startup = R.source(langs[i].id, "startup");
    let kernel = R.source(langs[i].id, "integer_kernel");
    require(len(startup) > 5 and len(kernel) > 20, "every language has both fixed fixtures");
    i = i + 1;
}

eq(R.benchmark_language("unknown", "startup").status, "unsupported-language",
   "caller cannot inject a language command");
eq(R.benchmark_language("python", "unknown").status, "unsupported-workload",
   "caller cannot inject source workload");
eq(R.benchmark_language("python", "startup", 11, 7, 30).status,
   "invalid-compile-repetitions", "compile sample cap");
eq(R.benchmark_language("python", "startup", 3, 2, 30).status,
   "invalid-run-repetitions", "run sample lower bound");
eq(R.benchmark_language("python", "startup", 3, 7, 301).status,
   "invalid-timeout", "timeout cap");

let measured = R.benchmark_language("pblang-interpreter", "startup", 1, 3, 15);
require(measured.status == "ok", "PBLang startup row executes");
eq(measured.checksum, "1", "PBLang startup checksum");
eq(len(measured.run_samples_ms), 3, "raw warm samples retained");
require(measured.run_warm.p95_ms >= measured.run_warm.median_ms, "p95 reported");
require(measured.rss_warm.median_ms > 0, "peak RSS captured");
require(measured.cpu_warm.median_ms >= 0, "CPU utilization captured");

if R.available("pblang-codegen-x64") {
    let native = R.benchmark_language("pblang-codegen-x64", "integer_kernel", 1, 3, 30);
    require(native.status == "ok", "direct x86-64 codegen row compiles and executes");
    eq(native.mode, "compiled", "direct codegen is a compiled mode");
    eq(native.checksum, R.expected("integer_kernel"), "direct codegen checksum");
    require(native.compile_cold_ms > 0, "direct codegen cold compile captured");
    require(native.compile_warm.median_ms > 0, "direct codegen warm compile captured");
    require(native.artifact_size_bytes >= 120, "direct codegen emitted a complete ELF");
}

let example = proc_spawn_wait("target/release/pblang",
    ["run", "examples/repro_codegen_benchmark/main.sapp", "--allow-all"]);
require((try example.exit_code catch 1) == 0, "direct-codegen benchmark example executes");
require(str_contains(try example.stdout catch "", "codegen_benchmark status="),
        "direct-codegen benchmark example reports status");

let package_entry = proc_spawn_wait("target/release/pblang",
    ["run", ".", "--allow-all", "--", "benchmark-codegen"]);
require((try package_entry.exit_code catch 1) == 0, "workspace package entry executes");
require(str_contains(try package_entry.stdout catch "", "codegen_benchmark status=ok"),
        "package-directory script arguments reach the PBLang entrypoint");

print "repro_benchmark_pass";
