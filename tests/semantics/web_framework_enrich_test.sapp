// tests/semantics/web_framework_enrich_test.sapp — fixes + enrichment for
// stdlib/web_framework.sapp (the batteries-included Express/Flask-style framework).
//
// The framework only exposed get/post even though http_server gained
// put/delete/patch/route + :id params. This adds the full verb set, a generic
// route(), any() (all methods), prefixed route groups, an in-process handle()
// (testable dispatch with no TCP), configurable CORS (opts + with_cors response
// helper), and richer ctx helpers (case-insensitive header(), body_json,
// no_content). auth_bearer now also checks the "Bearer" scheme.

let web = import("stdlib/web_framework.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

fn req_of(method, path) { return map{ method: method, path: path, headers: map{}, body: "" }; }

// ── base: GET dispatch still works, via the new in-process handle() ──────────────
let app = web.create_app(map{ port: 9091 });
web.get(app, "/", fn(ctx) { return ctx.json(map{ ok: true }); });
let r = web.handle(app, req_of("GET", "/"));
eq(r.status, 200, "GET / status"); eq(r.json.ok, true, "GET / json body");

// ── params: :id captured into ctx.params ─────────────────────────────────────────
web.get(app, "/users/:id", fn(ctx) { return ctx.text("U" + ctx.params.id); });
let ru = web.handle(app, req_of("GET", "/users/42"));
eq(ru.body, "U42", "path param captured");

// ── ENRICH: full verb set (put / patch / delete) ────────────────────────────────
web.put(app, "/item", fn(ctx) { return ctx.text("put"); });
web.patch(app, "/item", fn(ctx) { return ctx.text("patch"); });
web.delete(app, "/item", fn(ctx) { return ctx.text("del"); });
eq(web.handle(app, req_of("PUT", "/item")).body, "put", "PUT verb");
eq(web.handle(app, req_of("PATCH", "/item")).body, "patch", "PATCH verb");
eq(web.handle(app, req_of("DELETE", "/item")).body, "del", "DELETE verb");

// ── ENRICH: generic route() + any() (matches every method) ───────────────────────
web.route(app, "HEAD", "/h", fn(ctx) { return ctx.text("head"); });
eq(web.handle(app, req_of("HEAD", "/h")).body, "head", "generic route()");
web.any(app, "/ping", fn(ctx) { return ctx.text("pong"); });
eq(web.handle(app, req_of("GET", "/ping")).body, "pong", "any() matches GET");
eq(web.handle(app, req_of("POST", "/ping")).body, "pong", "any() matches POST");

// ── ENRICH: prefixed route groups ───────────────────────────────────────────────
let api = web.group(app, "/api/v1");
web.get(api, "/health", fn(ctx) { return ctx.json(map{ up: true }); });
let rh = web.handle(app, req_of("GET", "/api/v1/health"));
eq(rh.status, 200, "group route status"); eq(rh.json.up, true, "group route body");

// ── ENRICH: configurable CORS + with_cors response helper ───────────────────────
let pre = web.cors(map{ origin: "https://app.example.com" });
let opt_res = pre(req_of("OPTIONS", "/anything"));
eq(opt_res.status, 204, "cors preflight 204");
eq(opt_res.headers["Access-Control-Allow-Origin"], "https://app.example.com", "cors custom origin");
let wrapped = web.with_cors(map{ status: 200, body: "x" }, map{ origin: "*" });
eq(wrapped.headers["Access-Control-Allow-Origin"], "*", "with_cors attaches ACAO to a real response");

// ── ENRICH: ctx.header() case-insensitive + body_json + no_content ───────────────
web.post(app, "/echo", fn(ctx) {
    let ua = ctx.header("user-agent");          // header lookup is case-insensitive
    return ctx.json(map{ ua: ua, n: ctx.body_json.n });
});
let er = web.handle(app, map{ method: "POST", path: "/echo",
    headers: map{ "User-Agent": "pbtest" }, body: "{\"n\": 7}" });
eq(er.json.ua, "pbtest", "case-insensitive header"); eq(er.json.n, 7, "body_json parsed");

web.get(app, "/nc", fn(ctx) { return ctx.no_content(); });
eq(web.handle(app, req_of("GET", "/nc")).status, 204, "no_content -> 204");

// ── auth_bearer: scheme + token validation ───────────────────────────────────────
let guard = web.auth_bearer(fn(t) { return t == "good"; });
eq(guard(req_of("GET", "/x")).status, 401, "missing auth -> 401");
let bad_scheme = map{ method: "GET", path: "/x", headers: map{ "Authorization": "Basic good" }, body: "" };
eq(guard(bad_scheme).status, 401, "wrong scheme -> 401");
let bad_tok = map{ method: "GET", path: "/x", headers: map{ "Authorization": "Bearer nope" }, body: "" };
eq(guard(bad_tok).status, 403, "bad token -> 403");
let ok_tok = map{ method: "GET", path: "/x", headers: map{ "Authorization": "Bearer good" }, body: "" };
eq(guard(ok_tok), nil, "valid bearer -> passes (nil)");

// Plain HTTP is safe by default: loopback works, remote binds require an
// explicit application-level opt-in. These checks do not open a socket.
let loopback_app = web.create_app(map{ host: "127.0.0.1" });
eq(web.plaintext_policy(loopback_app).allowed, true, "loopback plaintext is allowed");
let remote_app = web.create_app(map{ host: "0.0.0.0" });
eq(web.plaintext_policy(remote_app).allowed, false, "remote plaintext defaults closed");
let opted_in_app = web.create_app(map{ host: "0.0.0.0", allow_plaintext: true });
eq(web.plaintext_policy(opted_in_app).allowed, true, "remote plaintext requires explicit opt-in");

print "web_framework_enrich_pass";
