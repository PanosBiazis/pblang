let DB = import("stdlib/db.sapp");
fn require(ok, message) { if not ok { throw "FAIL: " + message; } }
fn legacy(n) {
    let s = "";
    for i n { if i == 0 { s = "?"; } else { s = s + ",?"; } }
    return s;
}
for n in [0, 1, 2, 3, 4, 7, 8, 9, 15, 16, 17, 31, 32, 33, 127, 256, 1023, -1, 0.1, 1.1, 2.9] {
    require(DB.sql_placeholders(n) == legacy(n), "legacy output parity");
}
for n in [nil, true, false, "3", "bad", [], map{}] {
    require((try DB.sql_placeholders(n) catch "rejected") == "rejected", "legacy malformed input rejection");
}
require((try DB.sql_placeholders(9007199254740992) catch "rejected") == "rejected", "inexact count rejected before allocation");
// This exceeds str_repeat's existing 10 MiB envelope; no new result-size cap.
let count = 5300000;
let large = DB.sql_placeholders(count);
require(len(large) == count * 2 - 1, "large output length");
require(str_starts_with(large, "?,?,?") and str_ends_with(large, "?,?,?"), "large output edges");
let c = DB.sqlite.open(":memory:");
let row = c.query("select " + DB.sql_placeholders(3), [11, 22, 33]);
require(len(row) == 1, "valid SQLite placeholder syntax");
c.close();
print "db_placeholders_pass";
