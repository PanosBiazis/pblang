// tests/semantics/sha256_pb_test.sapp — the pure-pblang SHA-256 (stdlib/sha256_pb.sapp).
//
// A from-scratch SHA-256 built only on pblang's 32-bit bitwise builtins + str_to_bytes — no
// dependency on the native `sha256` builtin. This asserts it matches the reference builtin
// byte-for-byte across empty input, the classic "abc"/"hello" vectors, the 55/56/64-byte block
// and padding boundaries, and a multi-block input. (A correct SHA-256 must agree on all of these;
// the boundaries around 56 bytes exercise the extra-block padding rule, and 300 bytes exercises
// multi-chunk processing + the message schedule.)

let S = import("stdlib:sha256_pb.sapp");

fn fail(m) { throw "FAIL " + m; }
fn same(s, label) {
    let mine = S.sha256_hex(s);
    let ref = sha256(s);
    if mine != ref { fail(label + " len=" + str(len(s)) + " mine=" + mine + " ref=" + ref); }
}

same("", "empty");
same("abc", "abc");
same("hello", "hello");
same("The quick brown fox jumps over the lazy dog", "fox");
same("1234567890123456789012345678901234567890123456789012345", "len55");
same("12345678901234567890123456789012345678901234567890123456", "len56-padding-boundary");
same("1234567890123456789012345678901234567890123456789012345678901234", "len64-full-block");
same("pbos:audit_log:genesis:v1", "pbos-genesis");

// multi-block (300 bytes) exercises several chunks + the schedule extension.
let long = "";
let k = 0;
while k < 300 { long = long + "z"; k = k + 1; }
same(long, "len300-multiblock");

// digest is exactly 64 lowercase hex chars.
let d = S.sha256_hex("x");
if len(d) != 64 { fail("digest is 64 hex chars, got " + str(len(d))); }

print "sha256_pb_pass";
