// Self-hosted lifecycle works without host sleep support.
let F = import("stdlib:compiler/selfhost_frontend.sapp");
let source = "let S=import(\"stdlib/scheduler.sapp\"); let h=map{n:0}; "
    + "let id=S.set_immediate(fn(){h.n=h.n+1;}); "
    + "print S.pause_timer(id); print S.run_pending(); print S.resume_timer(id); "
    + "print S.run_pending(); print h.n; print S.retained_timers(); ";
// Use an explicitly caught sleep failure, then check that loop state was reset.
source = source + "print try {S.run_loop(10); false} catch true; "
    + "S.set_immediate(fn(){S.stop();}); print S.run_loop(10);";
let result = F.frontend_run(source);
if not result.ok or result.output != [true, 0, true, 1, 1, 0, true, nil] {
    throw "FAIL selfhost scheduler lifecycle";
}
print "scheduler_selfhost_pass";
