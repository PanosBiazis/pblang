let TCP = import("stdlib:native_tcp.sapp");

fn expect(value, message) { if not value { throw "FAIL native TCP EOF: " + message; } }

if platform() != "linux" or not TCP.available().ok {
    print "native_tcp_eof_contract_skipped";
    return;
}

fn serve(payload) {
    let listener = TCP.listen_ipv4("127.0.0.1", 0, 4);
    if not listener.ok { throw "listener unavailable"; }
    let ready = channel();
    let worker = spawn(fn() {
        let client = tcp_connect("127.0.0.1:" + str(listener.port));
        tcp_write(client, payload); tcp_close(client); send(ready.sender, true);
    });
    let peer = TCP.accept_bounded(listener, 500);
    if not peer.ok { TCP.close(listener); throw "accept failed"; }
    let result = TCP.read_to_eof(peer, 64, 500);
    TCP.close(peer); TCP.close(listener); recv_timeout(ready.receiver, 1000); join(worker);
    return result;
}

let exact = serve("WHOIS response\r\n");
expect(exact.ok and exact.eof and exact.text == "WHOIS response\r\n"
    and not exact.output_truncated, "EOF returns the complete bounded UTF-8 payload");
let excessive = serve(str_repeat("x", 65));
expect(not excessive.ok and excessive.output_truncated,
    "response exceeding the byte ceiling fails closed");

let listener = TCP.listen_ipv4("127.0.0.1", 0, 4); expect(listener.ok,"available-byte listener");
let ready = channel(); let worker = spawn(fn(){
    let client=tcp_connect("127.0.0.1:"+str(listener.port));tcp_write(client,"SSH-2.0-PBLang\r\n");
    send(ready.sender,true);let pause=channel();recv_timeout(pause.receiver,200);tcp_close(client);
});
let peer=TCP.accept_bounded(listener,500);expect(peer.ok,"available-byte accept");
let available=TCP.read_available_bytes(peer,64,500,10);
expect(available.ok and bytes_to_str(available.bytes)=="SSH-2.0-PBLang\r\n"
    and not available.timed_out and not available.truncated,
    "available-byte read returns partial banner before peer closes");
TCP.close(peer);TCP.close(listener);recv_timeout(ready.receiver,1000);join(worker);

print "native_tcp_eof_contract_pass";
