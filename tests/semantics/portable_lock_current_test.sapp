let PORTABLE = import("stdlib:portable_lock.sapp");

fn require(value, message) { if value { return; } throw "FAIL portable_lock_current: " + message; }

let manifest = fs_read("pblang.toml");
let lock = fs_read("pblang.lock");
let normalized = PORTABLE.normalize_text(manifest, lock, ".");

require(normalized.ok and normalized.rewritten == 1,
    "current workspace lock normalizes exactly one local dependency");
require(str_contains(normalized.text, "path = \"../pblang/stdlib\""),
    "current workspace lock publishes the manifest-relative stdlib path");
require(not str_contains(normalized.text, "/home/") and
        not str_contains(normalized.text, "/media/"),
    "portable lock output does not disclose host-specific roots");

print "portable_lock_current_pass";
