let s = import("stdlib:struct.sapp");

// Define struct
let Point = s.define("Point", ["x", "y"]);
let Color = s.define("Color", ["r", "g", "b"]);

// Create instances
let p = s.new(Point, map{ x: 3, y: 4 });
assert(p.x == 3, "x should be 3");
assert(p.y == 4, "y should be 4");

// instanceof
assert(s.instanceof(p, Point) == true, "should be instanceof Point");
assert(s.instanceof(p, Color) == false, "should not be instanceof Color");

// with — non-destructive update
let p2 = s.with(p, map{ x: 10 });
assert(p2.x == 10, "updated x should be 10");
assert(p2.y == 4, "y should still be 4");
assert(p.x == 3, "original should be unchanged");

// to_map
let m = s.to_map(p);
assert(m.x == 3, "map.x should be 3");
assert(map_has(m, "__struct_name") == false, "meta should be removed");

// from_map
let p3 = s.from_map(Point, map{ x: 1, y: 2 });
assert(p3.x == 1, "from_map x should be 1");

// eq
let p4 = s.new(Point, map{ x: 3, y: 4 });
assert(s.eq(p, p4) == true, "equal structs should be eq");
assert(s.eq(p, p2) == false, "different structs should not be eq");

// Missing field error
let err = try s.new(Point, map{ x: 5 }) catch "caught";
assert(err == "caught", "missing field should error");

print "struct stdlib tests passed";
