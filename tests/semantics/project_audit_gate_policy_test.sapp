let A=import("stdlib:project_audit.sapp");
fn expect(ok,label) {if not ok {throw "FAIL gate-policy: "+label;}}
fn rejects(action) { return try { action(); false } catch true; }
let clean=A.scan_records([],16);
expect(rejects(fn(){A.release_readiness("fixture",42,map{max_findings:0,max_high:parse_number("NaN")});}),"release finding-budget precedence");
let report=A.scan_records([map{path:"src/review.sapp",text:"// TODO placeholder"}],16);
let quality_fields=["max_high","max_medium","max_total","max_source_high","max_source_medium","max_source_total"];
let compare_fields=["max_new_total","max_new_high","max_new_medium"];
let invalid=[true,false,"private-policy-marker",[],map{},fn(){return 1;},
    bigint(1),rational("1/1"),decimal("1"),parse_number("NaN"),parse_number("inf"),parse_number("-inf"),-1,0.5,9007199254740992];
for field in quality_fields {
    for value in invalid {
        let options=map{};options[field]=value;
        expect(rejects(fn(){A.quality_gate(report,options);}),"quality fixed numeric rejection");
        expect(rejects(fn(){A.release_readiness("fixture",42,options);}),"policy precedes invalid record traversal");
    }
}
for field in compare_fields {
    for value in invalid {
        let options=map{};options[field]=value;
        expect(rejects(fn(){A.compare_reports(map{findings:42},map{findings:42},options);}),"compare policy before row traversal");
        expect(rejects(fn(){A.progress_gate(clean,report,options);}),"progress propagates");
    }
}
for field in ["allow_roadmap","source_only_blockers","block_new_security","block_new_reliability","block_new_performance"] {
    for value in [0,1,"false","private-policy-marker",[],map{},parse_number("NaN")] {
        let options=map{};options[field]=value;
        if field=="allow_roadmap" or field=="source_only_blockers" {
            expect(rejects(fn(){A.quality_gate(report,options);}),"quality exact bool");
        } else {
            expect(rejects(fn(){A.compare_reports(clean,report,options);}),"compare exact bool");
        }
    }
}
for options in [false,1,"private-options-marker",[]] {
    expect(rejects(fn(){A.quality_gate(clean,options);}),"quality options shape");
    expect(rejects(fn(){A.progress_gate(clean,report,options);}),"progress options shape");
}
for value in [0,1,9007199254740991,nil] {
    let q=map{};for field in quality_fields {q[field]=value;}
    let c=map{};for field in compare_fields {c[field]=value;}
    expect(type(A.quality_gate(report,q))=="map","valid numeric quality bounds");
    expect(type(A.compare_reports(clean,report,c))=="map","valid numeric comparison bounds");
}
let options=map{max_high:2,max_medium:3,max_total:4,max_source_high:nil,source_only_blockers:nil,unrelated:"preserved"};
let snapshot=json_stringify(options);
let gate=A.quality_gate(report,options);
expect(gate.thresholds.max_source_high==2 and gate.thresholds.max_source_medium==3 and gate.thresholds.max_source_total==4,"inherited nil defaults");
expect(not gate.thresholds.source_only_blockers and gate.thresholds.allow_roadmap,"boolean nil defaults");
expect(json_stringify(options)==snapshot,"options not mutated");
options.max_high=99;expect(gate.thresholds.max_high==2,"returned policy is independent");
gate.thresholds.max_medium=999;expect(options.max_medium==3,"returned policy does not alias input");
expect(A.quality_gate(clean).passed,"legacy clean default");
let default_gate=A.quality_gate(clean);default_gate.thresholds.max_high=99;
expect(A.quality_gate(clean).thresholds.max_high==0,"default policy is fresh per call");
let security_report=map{findings:[map{path:"src/review.sapp",line:1,kind:"security",severity:"low",text:"synthetic security row"}]};
expect(not A.compare_reports(clean,security_report,map{max_new_total:1}).passed,"security flag blocks independently of numeric ceiling");
expect(A.compare_reports(clean,security_report,map{max_new_total:1,block_new_security:false}).passed,"exact false intentionally permits security row");
expect(rejects(fn(){A.compare_reports(clean,security_report,map{max_new_total:1,block_new_security:0});}),"numeric zero cannot disable security flag");
expect(not A.compare_reports(clean,report).passed,"new finding blocks by default");
expect(A.compare_reports(clean,report,map{max_new_total:1,max_new_medium:1}).passed,"explicit lenience remains available");
print "project_audit_gate_policy_pass";
