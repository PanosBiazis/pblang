// tests/semantics/url_enrich_test.sapp — bug fixes + enrichment for stdlib/url.sapp
//
// Fixes: url.parse threw on userinfo (user:pass@host) and IPv6 ([::1]) authorities
// (parse_number on a non-numeric port string), and on any non-numeric port.
// Enrichment: userinfo/username/password components, multi-value query
// (parse_query_all + build_query with list values), and join() (relative-URL
// resolution, RFC 3986 subset).

let url = import("stdlib/url.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── FIX 1: userinfo authority must parse (was a crash) ──────────────────────────
let u = url.parse("https://user:pass@example.com:8080/path?x=1#f");
eq(u.host, "example.com", "userinfo host");
eq(u.port, 8080, "userinfo port");
eq(u.username, "user", "username");
eq(u.password, "pass", "password");
eq(u.userinfo, "user:pass", "userinfo");
eq(u.path, "/path", "userinfo path");

// ── FIX 2: IPv6 host must parse (was a crash) ───────────────────────────────────
let v = url.parse("http://[::1]:9000/x");
eq(v.host, "[::1]", "ipv6 host keeps brackets");
eq(v.port, 9000, "ipv6 port");
let v2 = url.parse("http://[2001:db8::1]/y");
eq(v2.host, "[2001:db8::1]", "ipv6 no-port host");
eq(v2.port, nil, "ipv6 no-port port");

// ── FIX 3: non-numeric port -> nil, no crash ────────────────────────────────────
let w = url.parse("http://host:abc/p");
eq(w.port, nil, "non-numeric port is nil");
eq(w.host, "host", "non-numeric port host");

// ── FIX 4: userinfo round-trips through build ───────────────────────────────────
eq(url.build(u), "https://user:pass@example.com:8080/path?x=1#f", "build with userinfo");

// ── ENRICH 1: multi-value query ─────────────────────────────────────────────────
let m = url.parse_query_all("a=1&a=2&b=3&a=4");
eq(len(m.a), 3, "parse_query_all collects repeated keys");
eq(m.a[0], "1", "first a"); eq(m.a[2], "4", "third a");
eq(m.b[0], "3", "b list");
// last-wins parse_query preserved
eq(url.parse_query("a=1&a=2").a, "2", "parse_query last-wins preserved");

// ── ENRICH 2: build_query with a list value emits repeated keys ─────────────────
let bq = url.build_query(map{ tag: ["x", "y"], n: "1" });
let rt = url.parse_query_all(bq);
eq(len(rt.tag), 2, "build_query list -> repeated keys");
eq(rt.n[0], "1", "build_query scalar still works");

// ── ENRICH 3: join() relative-URL resolution ────────────────────────────────────
let base = "http://h.com/a/b/c?old#frag";
eq(url.join(base, "d"), "http://h.com/a/b/d", "relative path replaces last segment");
eq(url.join(base, "/x/y"), "http://h.com/x/y", "absolute path");
eq(url.join(base, "../e"), "http://h.com/a/e", "dot-dot segment");
eq(url.join(base, "./f"), "http://h.com/a/b/f", "dot segment");
eq(url.join(base, "?q=2"), "http://h.com/a/b/c?q=2", "query-only ref");
eq(url.join(base, "#top"), "http://h.com/a/b/c?old#top", "fragment-only ref");
eq(url.join(base, "https://other.com/z"), "https://other.com/z", "absolute ref wins");
eq(url.join(base, "//cdn.com/p"), "http://cdn.com/p", "scheme-relative ref");
eq(url.join("http://h.com/a/b/", "x/y"), "http://h.com/a/b/x/y", "relative under dir");

print "url_enrich_pass";
