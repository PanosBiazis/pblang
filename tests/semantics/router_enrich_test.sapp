// tests/semantics/router_enrich_test.sapp — enrichment for stdlib/router.sapp
//
// Adds real HTTP routing behavior the minimal router lacked:
//   * 405 Method Not Allowed (with an `allow` list) when the PATH matches a route
//     but no registered METHOD does — previously a plain 404 (wrong status).
//   * catch-all wildcard segments (`*name`) for static-file / proxy routes.
//   * HEAD requests fall back to a GET route (HTTP semantics).
// Existing behavior (exact match, :params, 404) is preserved.

let r = import("stdlib/router.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

fn ok_handler(req) { return map{ status: 200, body: "ok", seen: req }; }

let routes = r.route_map();
r.add_route(routes, "GET", "/users/:id", ok_handler);
r.add_route(routes, "POST", "/users", ok_handler);
r.add_route(routes, "GET", "/static/*path", ok_handler);

// ── existing behavior preserved ─────────────────────────────────────────────────
let m1 = r.dispatch(routes, "GET", "/users/42", map{});
eq(m1.status, 200, "param route matches");
eq(m1.seen.params.id, "42", ":id param captured");
eq(r.dispatch(routes, "GET", "/nope", map{}).status, 404, "unknown path is 404");

// ── 405 Method Not Allowed (path matches, method doesn't) ───────────────────────
let m2 = r.dispatch(routes, "DELETE", "/users/42", map{});
eq(m2.status, 405, "wrong method on a matching path is 405 (not 404)");
let has_get = false;
let i = 0;
while i < len(m2.allow) { if m2.allow[i] == "GET" { has_get = true; } i = i + 1; }
if not has_get { fail("405 must list the allowed method(s): " + str(m2.allow)); }

// ── catch-all wildcard ──────────────────────────────────────────────────────────
let m3 = r.dispatch(routes, "GET", "/static/css/app.css", map{});
eq(m3.status, 200, "wildcard route matches a deep path");
eq(m3.seen.params.path, "css/app.css", "wildcard binds the remaining path");
let m3b = r.dispatch(routes, "GET", "/static", map{});
eq(m3b.status, 200, "wildcard also matches the bare prefix");
eq(m3b.seen.params.path, "", "wildcard binds empty remainder");

// ── HEAD falls back to a GET route ──────────────────────────────────────────────
let m4 = r.dispatch(routes, "HEAD", "/users/42", map{});
eq(m4.status, 200, "HEAD matches a GET route");

print "router_enrich_pass";
