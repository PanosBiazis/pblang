let A=import("stdlib:array.sapp");
let W=import("stdlib:array_windowing.sapp");
fn check(ok,label){if not ok {throw "FAIL array-windowing: "+label;}}
fn rejected(f){let result=try map{ok:true,value:f()} catch map{ok:false};check(not result.ok,"invalid input rejected");}
// Safe baseline regression: fractional step on empty input must reject.
rejected(fn(){return A.windows([],1,0.5);});
for value in [nil,0,0.5,parse_number("NaN"),parse_number("inf")] {
    rejected(fn(){return W.chunk([],value);});
    rejected(fn(){return W.windows([],1,value);});
}
check(W.chunk([1,2,3],2)==[[1,2],[3]] and W.windows([1,2,3],2,1)==[[1,2],[2,3]],"direct helper");
for input in [[],[1,2,3]] {
    for value in [0,-1,0.5,1.5,nil,true,"2",[],map{secret:"array-private-marker"},fn(x){return x;},
        parse_number("NaN"),parse_number("inf"),parse_number("-inf"),bigint(2),rational("2/1"),decimal("2")] {
        rejected(fn(){return A.chunk(input,value);});
        rejected(fn(){return A.windows(input,value,1);});
        rejected(fn(){return A.windows(input,1,value);});
    }
}
for input in [nil,true,1,"abc",map{},fn(x){return x;}] {
    rejected(fn(){return A.chunk(input,1);});
    rejected(fn(){return A.windows(input,1);});
}
// Independent shape/slot checks, including overlapping and nonoverlapping windows.
let n=0;
while n<=8 {
    let input=[];let i=0;while i<n {push(input,i);i=i+1;}
    let size=1;
    while size<=10 {
        let chunks=A.chunk(input,size);
        check(len(chunks)==num_floor((n+size-1)/size),"chunk count");
        i=0;let group=0;
        while group<len(chunks) {
            let expected=size;if expected>n-i {expected=n-i;}
            check(len(chunks[group])==expected,"chunk size");
            for item in chunks[group] {check(item==i,"chunk slot");i=i+1;}
            group=group+1;
        }
        check(i==n,"every element once");
        let step=1;
        while step<=10 {
            let windows=A.windows(input,size,step);
            let count=0;if size<=n {count=num_floor((n-size)/step)+1;}
            check(len(windows)==count,"window count");
            i=0;
            while i<count {
                check(len(windows[i])==size,"window size");
                let j=0;while j<size {check(windows[i][j]==i*step+j,"window slot");j=j+1;}
                i=i+1;
            }
            step=step+1;
        }
        check(A.windows(input,size)==A.windows(input,size,1),"default step");
        size=size+1;
    }
    n=n+1;
}
let huge=parse_number("1e308");
check(A.chunk([1,2,3],huge)==[[1,2,3]],"huge chunk clamped before arithmetic/conversion");
check(A.windows([1,2,3],huge,1)==[],"huge size returns empty");
check(A.windows([1,2,3],2,huge)==[[1,2]],"huge step finishes after first window");
check(A.chunk([],huge)==[] and A.windows([],1,huge)==[],"huge empty input");
let item=map{value:1};let input=[item,2,3];
let chunks=A.chunk(input,2);let windows=A.windows(input,2);
let first=chunks[0];push(first,9);let w=windows[0];w[1]=88;
check(len(input)==3 and input[1]==2 and windows[1]==[2,3],"independent slots");
item.value=7;check(chunks[0][0].value==7 and windows[0][0].value==7,"borrowed payload");
print "array_windowing_contract_pass";
