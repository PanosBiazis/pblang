// tests/semantics/pbai_tune_weights_test.sapp — auto-weight tuning. tune_weights(examples) bakes
// each model's measured accuracy into its STATIC vote weight (native included), so even with
// adaptive OFF the accurate models dominate. A heavy-but-wrong voter is tuned down to ~0.

let ens = import("stdlib/pbai_ensemble.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let scores = fn(p) { return map{ intent: "bugs", scores: [0.05, 0.9, 0.05, 0.05, 0.05] }; };
ens.configure(scores, ["explain", "bugs", "improve", "comment", "general"]);
ens.clear_voters();
ens.reset_stats();
ens.set_adaptive(false);

let examples = [ map{ prompt: "a", intent: "bugs" }, map{ prompt: "b", intent: "bugs" },
                 map{ prompt: "c", intent: "bugs" }, map{ prompt: "d", intent: "bugs" } ];

ens.register_voter_weighted("good", fn(x) { return "bugs"; }, 1);
ens.register_voter_weighted("bad", fn(x) { return "explain"; }, 3);   // heavy but wrong

// before tuning the heavy wrong voter wins
eq(ens.ensemble("x"), "explain", "heavy wrong voter wins before tuning");

// tune weights from measured accuracy
let w = ens.tune_weights(examples);
approx(w["good"], 1.0, "accurate voter tuned to weight ~1");
approx(w["bad"], 0.0, "wrong voter tuned to weight ~0");
approx(w["native"], 1.0, "accurate native tuned to weight ~1");

// now the accurate models win even with adaptive OFF (weights are baked in)
eq(ens.ensemble("x"), "bugs", "after auto-weight tuning the accurate models win");

// set_voter_weight adjusts a single voter
eq(ens.set_voter_weight("bad", 9), true, "set_voter_weight found the voter");
eq(ens.ensemble("x"), "explain", "manually re-weighting the bad voter flips it back");
eq(ens.set_voter_weight("nope", 1), false, "unknown voter -> false");

ens.clear_voters();
ens.reset_stats();
print "pbai_tune_weights_pass";
