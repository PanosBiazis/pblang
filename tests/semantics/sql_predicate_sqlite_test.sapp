let P=import("stdlib:sql_predicate.sapp");
let O=import("stdlib:orm.sapp");
let Owned=import("stdlib:db_owned.sapp");
fn require(ok,message){if not ok {throw "FAIL: "+message;}}
let result=Owned.with_sqlite(":memory:",fn(c){
 c.exec("create table items(\"select\" text, age real, enabled integer, note text)",[]);
 let payload="x' OR 1=1 --";
 c.exec("insert into items values (?,?,?,?)",["alpha",21,true,nil]);
 c.exec("insert into items values (?,?,?,?)",["beta",17,false,"present"]);
 c.exec("insert into items values (?,?,?,?)",[payload,22,true,""]);
 for pair in [[[["enabled","eq",true]],2],[[["enabled","ne",true]],1],[[["age","lt",18]],1],[[["age","le",21]],2],[[["age","gt",21]],1],[[["age","ge",21]],2],[[["select","like","a%"]],1],[[["note","eq",nil]],1],[[["note","ne",nil]],2],[[["age","ge",18],["enabled","eq",true]],2],[[["select","eq",payload]],1]] {
  let p=P.compile_all(pair[0]);
  let rows=O.find(c,"items",map{where:p.sql,params:p.params});
  require(len(rows)==pair[1],"SQLite predicate semantics");
 }
 let missing=P.compile_all([["missing_column","eq","missing_column"]]);
 require((try O.find(c,"items",map{where:missing.sql,params:missing.params}) catch "rejected")=="rejected","missing column cannot become constant true");
 for pair in [[[["age","in",[21,22]]],2],[[["age","not_in",[21,22]]],1],[[["select","in",[payload]]],1],[[["note","in",[]]],0],[[["note","not_in",[]]],3],[[["note","in",[nil]]],0],[[["note","not_in",[nil]]],0],[[["note","in",["present",nil]]],1],[[["note","not_in",["present",nil]]],0],[[["note","not_in",["present"]]],1],[[["note","in",["present"]]],1]] {
  let p=P.compile_all(pair[0]);
  require(len(O.find(c,"items",map{where:p.sql,params:p.params}))==pair[1],"SQLite membership and NULL matrix");
 }
 for op in ["in","not_in"] {
  let missing=P.compile_all([["missing_column",op,[]]]);
  require((try O.find(c,"items",map{where:missing.sql,params:missing.params}) catch "rejected")=="rejected","empty membership still resolves column");
 }
 require(O.count(c,"items")==3,"bound payload left table intact");
 return true;
});
require(result,"callback succeeded");
let calls=0;
fn query(terms){let p=P.compile_all(terms);calls=calls+1;return p;}
require((try query([["a","eq",1],["bad;","eq",2]]) catch "rejected")=="rejected" and calls==0,"late invalid term does not dispatch");
require((try query([["a","in",[1,2]],["b","not_in",[3,map{}]]]) catch "rejected")=="rejected" and calls==0,"late invalid member does not dispatch");
print "sql_predicate_sqlite_pass";
