// tests/semantics/topology_test.sapp — geometric & topological form generators
// (diamond, mobius, klein bottle, galaxy orbits/spiral, trefoil knot, pentagon/n-gon,
// tesseract/hypercube, optical-illusion perturbations). Pure + deterministic.

let T = import("stdlib/topology.sapp");
let M = import("stdlib/math.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── diamond: symmetric expand→peak→contract width profile ─────────────────────────
let dia = T.diamond_widths(2, 6, 2);
eq(len(dia), 5, "diamond profile length");
eq(dia[0], 2, "diamond starts at min"); eq(dia[len(dia) - 1], 2, "diamond ends at min");
eq(dia[2], 6, "diamond peaks in the middle");

// ── mobius: 2 laps to return, orientation (side) flips on the second lap ───────────
let mw = T.mobius_walk(3);
eq(len(mw), 6, "mobius walk is 2n");
eq(mw[0].cell, 0, "mobius start cell"); eq(mw[0].side, 0, "mobius start side");
eq(mw[3].cell, 0, "mobius revisits cell 0 ..."); eq(mw[3].side, 1, "... on the flipped side");

// ── klein bottle grid: x wraps normally; an x-wrap FLIPS y (non-orientable) ────────
let k0 = T.klein_wrap(2, 1, 5, 5);
eq(k0.x, 2, "no wrap x"); eq(k0.y, 1, "no wrap y");
let kx = T.klein_wrap(5, 1, 5, 5);                 // one x-wrap -> y flips
eq(kx.x, 0, "x wrapped"); eq(kx.y, 3, "y flipped on x-wrap (5-1-1)");
let ky = T.klein_wrap(2, 5, 5, 5);                 // y wraps normally (no flip)
eq(ky.x, 2, "x unchanged"); eq(ky.y, 0, "y wraps like a torus dimension");

// ── galaxy: orbit preserves radius; full turn returns to start; spiral has n stars ─
let o = T.orbit_step(1, 0, 0, 0, M.PI / 2);
approx(o.x, 0, "quarter orbit x"); approx(o.y, 1, "quarter orbit y");
let full = T.orbit_step(1, 0, 0, 0, 2 * M.PI);
approx(full.x, 1, "full orbit returns x"); approx(full.y, 0, "full orbit returns y");
eq(len(T.galaxy_spiral(50, 2, 3, 1)), 50, "galaxy has n stars");

// ── trefoil knot: n points, and it is CLOSED (t=0 == t=2π) ────────────────────────
let tc = T.trefoil_curve(24);
eq(len(tc), 24, "trefoil sample count");
let p0 = T.trefoil_point(0);
let p2 = T.trefoil_point(2 * M.PI);
approx(p0.x, p2.x, "trefoil closed x"); approx(p0.y, p2.y, "trefoil closed y"); approx(p0.z, p2.z, "trefoil closed z");

// ── pentagon: 5 vertices, each at radius r, evenly spaced ──────────────────────────
let pent = T.pentagon(0, 0, 10);
eq(len(pent), 5, "pentagon has 5 vertices");
let i = 0;
while i < 5 { approx(num_sqrt(pent[i].x * pent[i].x + pent[i].y * pent[i].y), 10, "vertex on radius"); i = i + 1; }

// ── tesseract: 16 vertices, 32 edges, every vertex has degree 4 ───────────────────
let tv = T.tesseract_vertices();
eq(len(tv), 16, "tesseract has 16 vertices");
let te = T.tesseract_edges();
eq(len(te), 32, "tesseract has 32 edges (4 * 2^3)");
eq(len(T.hypercube_vertices(3)), 8, "3-cube has 8 vertices");

// ── illusions: bounded perceptual jitter; bistable ambiguous toggle ───────────────
let base = [0.5, 0.5, 0.5];
let j = T.illusion_jitter(base, 0.1, 42);
let q = 0;
while q < len(j) { let d = j[q] - base[q]; if d < 0 { d = 0 - d; } if d > 0.1 + 0.000001 { fail("jitter within amount"); } q = q + 1; }
eq(T.bistable("rabbit", "duck", 0), "rabbit", "bistable phase 0");
eq(T.bistable("rabbit", "duck", 1), "duck", "bistable phase 1 flips");

// ── network topologies (edge lists of index pairs) ────────────────────────────────
eq(len(T.ring_topology(4)), 4, "ring has n edges");
eq(len(T.line_topology(4)), 3, "line/bus has n-1 edges");
eq(len(T.star_topology(5)), 4, "star has n-1 spokes");
eq(len(T.fully_connected(4)), 6, "K4 (mesh) has n(n-1)/2 edges");
eq(len(T.tree_topology(7)), 6, "binary tree has n-1 edges");
eq(len(T.grid_topology(2, 2)), 4, "2x2 grid edges");
eq(len(T.torus_topology(3, 3)), 18, "3x3 torus: 2 edges per cell with wrap");

print "topology_pass";
