let T=import("stdlib:security_taint.sapp");
let D=import("stdlib:security_dependency_analysis.sapp");
fn expect(ok,label) {if not ok {throw "FAIL taint-class-reuse: "+label;}}
fn spec(label) {return map{severity:"high",class:label,args:[0],control_flow:false};}
fn policy(labels) {
    let sinks=map{};let i=0;
    for label in labels {sinks["sink"+str(i)]=spec(label);i=i+1;}
    return map{taint_sinks:sinks};
}
fn rejected(options) {
    let checked=T.validate_policy(options);
    expect(json_stringify(checked)==json_stringify(map{ok:false,error:"invalid taint sink policy"}),"exact private preflight rejection");
    let result=T.analyze("/*","private-class-marker",options);
    expect(not result.ok and not result.passed and result.error==checked.error,"policy rejection precedes tokenization");
    expect(not str_contains(json_stringify(result),"private-class-marker"),"rejection privacy");
}
let full=str_repeat("α",128);
for suffix in ["\x00tail","\ntail","\x7ftail"] {rejected(policy(["x","x"+suffix]));}
for label in ["class",str_repeat("a",256),full,str_repeat("😀",64),strfromcharcode(128),"é"] {
    let labels=[];for i 128 {push(labels,label);}
    let options=policy(labels);let before=json_stringify(options);
    expect(T.validate_policy(options).ok,"all repeated valid labels admitted");
    expect(T.analyze("","fixture.sapp",options).passed,"same complete analysis");
    expect(json_stringify(options)==before,"caller input unchanged");
}
for bad in [nil,true,1,[],map{},"",str_repeat("α",129),str_repeat("😀",65),"private-class-marker\n","bad\x00","bad\x7f"] {
    for labels in [[bad],[bad,bad],[full,bad],[bad,full],[full,bad,full]] {rejected(policy(labels));}
}
// Every C0 byte and DEL must reject, including after a repeated valid label.
for code 32 {rejected(policy([full,full,"x"+strfromcharcode(code)]));}
rejected(policy([full,full,"x"+strfromcharcode(127)]));
// Reusing a class never admits another malformed field of that rule.
for field in ["severity","args","control_flow"] {
    let options=policy([full,full]);
    let keys=map_keys(options.taint_sinks);
    let broken=options.taint_sinks[keys[1]];
    if field=="severity" {broken.severity="HIGH";}
    elif field=="args" {broken.args=[0.5];}
    else {broken.control_flow="false";}
    rejected(options);
}
let missing=policy([full,full]);map_remove(missing.taint_sinks.sink1,"class");rejected(missing);
let bad_key=policy([full,full]);bad_key.taint_sinks["bad\nkey"]=spec(full);rejected(bad_key);
let values=["class-a","class-b","class-a",full,str_repeat("α",128),"class-b"];
expect(T.validate_policy(policy(values)).ok,"alternating values and independently built equal text");
let options=policy([full,full]);expect(T.validate_policy(options).ok,"initial valid call");
options.taint_sinks.sink1.class="bad\n";rejected(options);
options.taint_sinks.sink1.class=full;expect(T.validate_policy(options).ok,"restored call after failure");
// An overloaded map must not be compared as if it were an ordinary string.
let equality_calls=0;
let forged=map{__eq__:fn(a,b){equality_calls=equality_calls+1;return true;},__ne__:fn(a,b){equality_calls=equality_calls+1;return false;}};
rejected(policy([full,forged]));expect(equality_calls==0,"non-string comparison overload not invoked");
for mode in ["protect","strict","audit"] {
    let bad=policy([full,full,"bad\n"]);
    let result=D.analyze_entry("unused.sapp",map{entry_source:42,security_mode:mode,security:bad});
    expect(not result.ok and not result.passed and result.error=="invalid taint sink policy","dependency pre-I/O rejection retained");
}
print "security_taint_class_reuse_pass";
