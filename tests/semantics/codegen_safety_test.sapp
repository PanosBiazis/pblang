// tests/semantics/codegen_safety_test.sapp — the codegen is safe by construction: a shared IR
// validator rejects malformed/out-of-range IR before any machine code is emitted, and native
// mode manages its temp files cleanly (unique names, always removed).

let IR = import("stdlib/codegen_ir.sapp");
let NA = import("stdlib/native.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── validator accepts well-formed IR ────────────────────────────────────────────────
eq(IR.validate([["seti", 0, 1], ["addi", 0, 2], ["loop", 0, [["add", 1, 2]]]]).ok, true, "valid IR ok");

// ── and rejects every malformed shape (no silent miscompile) ────────────────────────
eq(IR.validate([["bogus", 0]]).ok, false, "unknown op rejected");
eq(IR.validate([["seti", 9, 1]]).ok, false, "register out of range rejected");
eq(IR.validate([["seti", 0, 9999999999]]).ok, false, "immediate over 32-bit rejected");
eq(IR.validate([["add", 0]]).ok, false, "missing operand rejected");
eq(IR.validate([["loop", 0, [["seti", 7, 1]]]]).ok, false, "bad loop body rejected (recursive)");
eq(IR.validate([["syscall", 60, [0, 1, 9]]]).ok, false, "bad syscall arg register rejected");
eq(IR.validate([["syscall", 60, [0, 1, 2, 3, 0, 1, 2]]]).ok, false, "too many syscall args rejected");

// assert_valid throws on bad input, returns the IR on good
let threw = false;
let r = try IR.assert_valid([["seti", 5, 1]]) catch nil;
if r == nil { threw = true; }
if not threw { fail("assert_valid must throw on bad IR"); }
eq(len(IR.assert_valid([["seti", 0, 1]])), 1, "assert_valid returns good IR");

// ── native compile path validates too (defense in depth) ────────────────────────────
let nthrew = false;
let nr = try NA.compile([["seti", 0, 9999999999]]) catch nil;
if nr == nil { nthrew = true; }
if not nthrew { fail("native.compile must reject invalid IR"); }

// ── resource management: native run leaves no temp files behind ──────────────────────
if NA.host_arch() == "x86_64" {
    NA.run_value([["seti", 0, 5], ["addi", 0, 10]]);   // 15
    // Match only native.sapp's UUID-shaped private artifacts. Other parallel
    // distribution tests intentionally use a broader pbnat_* prefix.
    let r2 = proc_spawn_wait("bash", ["-c",
        "find /tmp -maxdepth 1 -type f -name 'pbnat_????????-????-????-????-????????????.bin' -print | wc -l"]);
    eq(parse_number(str_trim(try r2.stdout catch "0")), 0, "no leftover native temp files in /tmp");
}

print "codegen_safety_pass";
