// Extra modeled checks for the shared implementation; no production test hooks.
let T=import("semantic.sapp");
fn run(D,C,B,R) {
 let checks=0;let rows=[];
 // Preserve the original 40-case facade suite, then run all 36 direct modes
 // through the exact same core entrypoints without the full facade aliases.
 let direct_api=map{read_bytes:C.read_bytes,read_bytes_relative:C.read_bytes_relative,_test_reset:C._test_reset,close:D.close};
 let direct=T.run(direct_api,B,R,false);assert(len(direct.rows)==40,"shared core complete mode coverage");
 checks=checks+direct.checks;push(rows,map{case:"direct-core",checks:direct.checks});
 for mode in ["copy-fail","create-fail"] {
  B.configure(mode);C._test_reset();let r=C.read_bytes_relative(B.root(),"synthetic",4);
  assert(not r.ok and not C.cleanup_poisoned() and D.scan_mount_admission_status().ready,"ordinary operation failure does not poison");checks=checks+1;
 }
 B.configure("source-fail");C._test_reset();let r=C.read_bytes_relative(B.root(),"synthetic",4);
 assert(r.cleanup_failed and D.scan_mount_admission_status().process_admission_poisoned,"core cleanup poisons full owner");checks=checks+1;
 B.configure("normal");let again=D.read_bytes_relative(B.root(),"synthetic",4);
 assert(not again.ok and B.state.parents==0 and len(B.state.calls)==0,"core poison blocks full read before effects");checks=checks+1;
 C._test_reset();B.configure("normal");D._test_poison_full();
 let back=C.read_bytes_relative(B.root(),"synthetic",4);
 assert(not back.ok and C.cleanup_poisoned() and B.state.parents==0 and len(B.state.calls)==0,"full cleanup poisons core admission");checks=checks+1;
 for mode in ["library-fail","library-throw"] {
  C._test_reset();B.configure(mode);let fs=C.open_readonly(".");
  assert(not C.close_readonly(fs) and C.cleanup_poisoned() and D.scan_mount_admission_status().process_admission_poisoned,"library cleanup shared poison");checks=checks+1;
  assert(B.state.closes==[1] and fs.closed,"root consumed once after library ambiguity");checks=checks+1;
  assert(not C.close_readonly(fs) and B.state.closes==[1],"readonly repeated close no effects");checks=checks+1;
 }
 for kind in ["full","children","locks","enumeration","operation","malformed"] {
  C._test_reset();B.configure("normal");let fs=C.open_readonly(".");
  if kind=="full" {fs=D.open(".",false,false);}
  elif kind=="children" {fs.child_fds=map{"7":true};}
  elif kind=="locks" {fs.lock_fds=map{"7":true};}
  elif kind=="enumeration" {fs.enumeration_context_id="";}
  elif kind=="operation" {fs.strict_enum_operation_id="";}
  else {fs.child_fds=nil;}
  assert(not C.close_readonly(fs) and len(B.state.closes)==0 and not fs.closed,"readonly refuses foreign registry: "+kind);checks=checks+1;
 }
 C._test_reset();B.configure("normal");let full=D.open(".",false,false);
 full.child_fds=map{"7":true};full.lock_fds=map{"8":true};
 // The model deliberately exposes unexpected native selectors: extend only
 // flock's fixed selector to verify full cleanup still owns unlock/children.
 assert(D.close(full) and B.state.closes==[7,8,1],"full close retains child/lock/root ordering");checks=checks+1;
 return map{checks:checks,rows:rows,real_kernel_close_fault:false};
}
export run;
