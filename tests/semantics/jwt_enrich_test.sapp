// tests/semantics/jwt_enrich_test.sapp — fixes + enrichment for stdlib/jwt.sapp
//
// SECURITY FIXES:
//  - removes the sha256(input+secret) fallback (length-extension vulnerable);
//    HS256 is now always real HMAC.
//  - the signature segment is now RFC 7515 base64url of the RAW HMAC bytes
//    (was base64url of the hex string -> non-interoperable). Proven against the
//    well-known jwt.io reference token below.
//  - verify() now enforces an algorithm allowlist (default ["HS256"]), defeating
//    the "alg: none" / algorithm-confusion attack.
// ENRICH: iat auto-claim on sign; verify opts {algs, leeway, aud, iss};
//    try_verify (non-throwing) and is_expired helpers.

let jwt = import("stdlib/jwt.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let secret = "test-secret-key";

// ── base round-trip still works ──────────────────────────────────────────────────
let tok = jwt.sign(map{ sub: "u1", role: "admin" }, secret);
let v = jwt.verify(tok, secret);
eq(v.sub, "u1", "sub round-trip"); eq(v.role, "admin", "role round-trip");

// ── ENRICH: sign auto-adds an iat (issued-at) claim ──────────────────────────────
if v.iat == nil { fail("iat should be auto-added by sign"); }

// ── FIX/INTEROP: signatures are RFC 7515 compliant (verify a real jwt.io token) ──
let ext = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c";
let xv = jwt.verify(ext, "your-256-bit-secret");
eq(xv.sub, "1234567890", "interop: verify external HS256 token"); eq(xv.name, "John Doe", "interop name");

// ── SECURITY: alg:none / algorithm-confusion token is rejected ───────────────────
let none_tok = "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJhZG1pbiJ9.";
let none_res = try jwt.verify(none_tok, secret) catch "REJECTED";
eq(none_res, "REJECTED", "alg:none token must be rejected");

// ── SECURITY: algorithm allowlist enforced ───────────────────────────────────────
let alg_res = try jwt.verify(tok, secret, map{ algs: ["HS384"] }) catch "REJECTED";
eq(alg_res, "REJECTED", "HS256 token rejected when only HS384 allowed");

// ── wrong secret still throws ─────────────────────────────────────────────────────
let bad = try jwt.verify(tok, "nope") catch "BAD";
eq(bad, "BAD", "wrong secret rejected");

// ── ENRICH: try_verify is non-throwing ───────────────────────────────────────────
let good = jwt.try_verify(tok, secret);
eq(good.valid, true, "try_verify ok -> valid:true"); eq(good.payload.sub, "u1", "try_verify payload");
let nope = jwt.try_verify(tok, "wrong");
eq(nope.valid, false, "try_verify bad -> valid:false");
if not map_has(nope, "error") { fail("try_verify failure carries an error message"); }

// ── ENRICH: leeway tolerates small clock skew on exp ─────────────────────────────
let just_exp = jwt.sign(map{ sub: "u", exp: num_floor(clock()) - 5 }, secret);  // expired 5s ago
let strict = try jwt.verify(just_exp, secret) catch "EXPIRED";
eq(strict, "EXPIRED", "expired token fails with no leeway");
let lenient = jwt.verify(just_exp, secret, map{ leeway: 30 });
eq(lenient.sub, "u", "leeway 30s tolerates a 5s-expired token");

// ── ENRICH: audience + issuer verification ───────────────────────────────────────
let at = jwt.sign(map{ sub: "u", aud: "api", iss: "auth-svc" }, secret);
eq(jwt.verify(at, secret, map{ aud: "api", iss: "auth-svc" }).sub, "u", "aud+iss match");
let aud_bad = try jwt.verify(at, secret, map{ aud: "other" }) catch "AUD";
eq(aud_bad, "AUD", "wrong audience rejected");
let iss_bad = try jwt.verify(at, secret, map{ iss: "evil" }) catch "ISS";
eq(iss_bad, "ISS", "wrong issuer rejected");

// ── ENRICH: is_expired helper ─────────────────────────────────────────────────────
eq(jwt.is_expired(jwt.sign(map{ sub: "u", exp: 1 }, secret)), true, "is_expired true for past exp");
eq(jwt.is_expired(jwt.sign(map{ sub: "u", exp: jwt.expiry(3600) }, secret)), false, "is_expired false for future exp");

// ── decode without verification still works ──────────────────────────────────────
let d = jwt.decode(tok);
eq(d.payload.sub, "u1", "decode sub"); eq(d.header.alg, "HS256", "decode alg");

print "jwt_enrich_pass";
