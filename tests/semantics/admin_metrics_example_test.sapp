let Dashboard=import("../../examples/admin_metrics/dashboard.sapp");
let report=Dashboard.build();
assert(report.sessions==75 and report.requests==7800 and report.failures==140,"aggregate totals");
assert(len(report.rows)==6 and report.rows[0][0]=="Tenant A","synthetic tenant table");
assert(num_abs(report.spatial[0][0]-1.2)<0.000001 and num_abs(report.spatial[0][1]-0.6)<0.000001 and num_abs(report.spatial[0][2]-1.8)<0.000001,"normalized 3D values");
assert(num_abs(report.display[0][0]-1.83)<0.000001 and num_abs(report.display[0][1]-1.05)<0.000001,"3D to 2D projection");
assert(len(str_split(report.html,"<svg"))==3 and len(str_split(report.html,"<table>"))==4,"two charts and three value tables");
assert(str_contains(report.html,"implements no login, SSO or tenant access control"),"authorization boundary explicit");
assert(not str_contains(report.html,"<script") and not str_contains(report.html,"https://"),"passive offline dashboard");
report.rows[0][1]=999;assert(Dashboard.build().sessions==75,"fresh synthetic snapshots");
print "admin_metrics_example_pass";
