// tests/semantics/timeseries_enrich_test.sapp — enrichment for stdlib/timeseries.sapp

let T = import("stdlib/timeseries.sapp");

fn fail(m) { throw "FAIL " + m; }
fn approx(a, b, m) { if (a - b) > 0.001 or (b - a) > 0.001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── pct_change ──────────────────────────────────────────────────────────────────────
let pc = T.pct_change([100, 110, 99]);
eq(len(pc), 2, "pct_change length n-1");
approx(pc[0], 0.1, "+10%"); approx(pc[1], -0.1, "-10%");

// ── lag ───────────────────────────────────────────────────────────────────────────
let lg = T.lag([1, 2, 3], 1);
eq(lg[0], nil, "lag front nil"); eq(lg[1], 1, "lag shifts"); eq(lg[2], 2, "lag shifts");

// ── zscore (mean 2, pop std sqrt(2/3) ~= 0.8165) ──────────────────────────────────
let z = T.zscore([1, 2, 3]);
approx(z[0], -1.2247, "z lo"); approx(z[1], 0, "z mid"); approx(z[2], 1.2247, "z hi");
let zflat = T.zscore([5, 5, 5]);
eq(zflat[0], 0, "flat -> 0");

// ── normalize (min-max) ──────────────────────────────────────────────────────────
let nm = T.normalize([0, 5, 10]);
approx(nm[0], 0, "min->0"); approx(nm[1], 0.5, "mid"); approx(nm[2], 1, "max->1");

// ── rolling_sum ─────────────────────────────────────────────────────────────────────
let rs = T.rolling_sum([1, 2, 3, 4], 2);
eq(len(rs), 3, "rolling_sum length");
approx(rs[0], 3, "1+2"); approx(rs[1], 5, "2+3"); approx(rs[2], 7, "3+4");

print "timeseries_enrich_pass";
