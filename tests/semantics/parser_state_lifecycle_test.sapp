let P = import("stdlib:compiler/parser.sapp");
let T = import("stdlib:compiler/tokenizer.sapp");
let A = import("stdlib:compiler/source_analysis.sapp");
let F = import("stdlib:compiler/selfhost_frontend.sapp");
fn idle() {
    let state = P.retained_state();
    assert(state.tokens == 0 and state.errors == 0, "parser drops its retained buffers");
}
for source in ["print 1;", "let s=\"λ😀\"; print s;", "let = ;", "let n=0x;", "", "// comment"] {
    let tokens = T.tokenize(source); let snapshot = json_stringify(tokens);
    let ast = P.parse(tokens); let saved = json_stringify(ast);
    idle();
    P.discard_state(); P.discard_state();
    assert(json_stringify(ast) == saved, "cleanup preserves returned AST and errors");
    assert(json_stringify(tokens) == snapshot, "cleanup preserves caller tokens");
    P.parse(T.tokenize("print 2;"));
    assert(json_stringify(ast) == saved, "later parse does not alter prior results");
}
// Missing number text throws only after the parser owns its filtered buffer.
let broken = [map{kind:"number",line:1,col:1}];
assert(try { P.parse(broken); false } catch true, "direct parser exception remains an exception");
assert(P.retained_state().tokens > 0, "direct exception retains state until reset");
P.discard_state(); idle();
assert(len(broken) == 1, "manual reset preserves caller ownership");
// Safe-entry empty input also releases abandoned direct-parser state.
for safe in [A.parse_safe, F.frontend_parse_safe] {
    try P.parse(broken) catch nil;
    assert(not safe(nil).ok, "safe empty-source failure"); idle();
    try P.parse(broken) catch nil;
    assert(safe(12).reason == "parser_exception", "safe exception contract preserved"); idle();
    try P.parse(broken) catch nil;
    assert(not safe("let n=0x;").ok, "lexical rejection releases abandoned state"); idle();
    try P.parse(broken) catch nil;
    let next = safe("print 3;"); assert(next.ok, "recovery after direct failure"); idle();
}
for analyze in [A.analyze, F.frontend_analyze] {
    for source in [nil, " ", "let n=0x;"] {
        try P.parse(broken) catch nil;
        assert(not analyze(source).ok, "analysis rejects source"); idle();
    }
}
let bad = P.parse(T.tokenize("let = ;"));
assert(len(bad.errors) > 0, "returned diagnostics retained");
array_push(bad.errors, "caller-owned"); idle();
assert(A.parse_safe("print 4;").ok, "caller diagnostic mutation does not leak");
print "parser_state_lifecycle_pass";
