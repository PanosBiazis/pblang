let TOK = import("stdlib/compiler/tokenizer.sapp");
let PAR = import("stdlib/compiler/parser.sapp");
let CG = import("stdlib/compiler/codegen.sapp");
let VM = import("stdlib/compiler/vm.sapp");

fn run(source) {
    let ast = PAR.parse(TOK.tokenize(source));
    if len(ast.errors) != 0 { throw "VM two-arg closure parse failed"; }
    return VM.run(CG.compile_stmts(ast.stmts));
}

let direct = run("fn add(a, b) { return a + b; } print add(20, 22);");
if len(direct.output) != 1 or direct.output[0] != 42 {
    throw "VM direct two-arg closure failed";
}

let captured = run(
    "fn make(base) { return fn(a, b) { return base + a + b; }; } "
    + "let sum = make(10); print sum(12, 20);"
);
if len(captured.output) != 1 or captured.output[0] != 42 {
    throw "VM captured two-arg closure failed";
}

let repeated = run(
    "fn add(a, b) { return a + b; } let i = 0; let total = 0; "
    + "while i < 100 { total = add(total, i); i = i + 1; } print total;"
);
if len(repeated.output) != 1 or repeated.output[0] != 4950 {
    throw "VM repeated two-arg closure failed";
}

print "selfhost_vm_two_arg_closure_pass";
