let S=import("stdlib:subtitles.sapp");let T=import("stdlib:subtitle_timing.sapp");
let doc=S.parse_srt("1\n00:00:00,000 --> 00:00:10,000\nOuter\n\n2\n00:00:01,000 --> 00:00:02,000\nInner\n\n3\n00:00:02,000 --> 00:00:03,000\nAdjacent\n\n4\n00:00:11,000 --> 00:00:12,000\nLast\n");
let before=S.to_srt(doc);let r=T.analyze(doc);assert(r.overlap_pairs==2 and r.overlaps_by_index==[2,1,1,0],"nested subtitle timing");
assert(T.next_overlap(doc,0)==1 and T.next_overlap(doc,2)==0 and T.next_overlap(doc,3)==0,"next overlap wraps");
assert(S.statistics(doc).overlapping_cues==2,"legacy contract preserved");assert(S.to_srt(doc)==before,"source unchanged");
let one=S.parse_srt("1\n00:00:00,000 --> 00:00:01,000\nOne\n");assert(T.next_overlap(one,0)==nil,"no overlap result");
assert((try T.next_overlap(doc,-1) catch "invalid")=="invalid","invalid cursor");print "subtitle_timing_pass";
