let AI=import("stdlib/pbai.sapp");
let B=import("stdlib:pbai_specialist_binding.sapp");
let IO=import("stdlib:pbai_student_checkpoint_io.sapp");
let wrong=import("stdlib:pbai_sensor.sapp");
let inert=import("tests/fixtures/pbai_checkpoint_bind_no_calls.sapp");
let incomplete=import("tests/fixtures/pbai_checkpoint_noncallable.sapp");
fn rejects(f) {return try {f();false} catch true;}
assert(rejects(fn(){throw "expected";}) and not rejects(fn(){return 1;}),"calibrate rejection helper");
let called=false;let callback=fn(){called=true;return IO;};let fake=map{save_new:callback,load_file:callback};
let cycle=[];push(cycle,cycle);let refused=0;
for bind in [B.bind_checkpoint,AI.neural_specialist_checkpoint_bind] {
 for bad in [nil,true,7,"synthetic-private-provider",[],cycle,map{},fake,callback,wrong,incomplete] {
  assert(rejects(fn(){bind(bad);}),"reject incompatible binding before any provider call");refused=refused+1;
 }
 let no_calls=bind(inert);assert(len(no_calls)==3,"compatible module is bound without invocation");
 let store=bind(IO);let report=store.report();let encoded=json_stringify(report);
 assert(len(store)==3 and json_stringify(report.operations)=="[\"save_new\",\"load_file\"]","only explicit storage surface");
 assert(report.exports_checked and not report.provider_authenticated and not report.storage_guarantees_verified
  and not report.provider_called_during_bind and not report.automatic_persistence and not report.automatic_training
  and not report.globally_activated and not report.authorizes_action,"structural report grants no authority");
 report.operations[0]="forged";report.provider_authenticated=true;
 assert(json_stringify(store.report())==encoded,"report mutation cannot change later report");
 assert(rejects(fn(){store.save_new(nil,map{});}) and rejects(fn(){store.load_file(nil);}),"original validation remains active");
}
assert(refused==22 and not called,"all refusals without callbacks");
print "pbai_checkpoint_binding_pass:22";
