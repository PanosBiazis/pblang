// tests/semantics/nn_curiosity_test.sapp — curiosity-driven + developmental learning:
// surprise = prediction error; focus learning on what's surprising; curriculum easy→hard;
// grow capacity when learning plateaus.

let nn = import("stdlib/nn.sapp");
let cur = import("stdlib/nn_curiosity.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let data = [ nn.sample([0, 0], [0]), nn.sample([0, 1], [1]), nn.sample([1, 0], [1]), nn.sample([1, 1], [0]) ];
let net = nn.mlp_new(2, 4, 1, 7);

// ── curiosity = surprise (prediction error) >= 0 ──────────────────────────────────
if cur.curiosity(net, data[0]) < 0 { fail("curiosity is non-negative"); }
let sc = cur.surprise_scores(net, data);
eq(len(sc), 4, "one surprise score per sample");

// ── most_curious picks the highest-surprise samples ───────────────────────────────
let mc = cur.most_curious(net, data, 2);
eq(len(mc), 2, "most_curious returns k indices");
let i = 0; let amax = 0;
while i < len(sc) { if sc[i] > sc[amax] { amax = i; } i = i + 1; }
eq(mc[0], amax, "most_curious[0] is the most surprising sample");

// ── curriculum_order sorts easy → hard ────────────────────────────────────────────
let order = cur.curriculum_order(net, data);
eq(len(order), 4, "curriculum keeps all samples");
if cur.curiosity(net, order[0]) > cur.curiosity(net, order[3]) { fail("curriculum is easy-first"); }

// ── curious_train: focusing on surprises drives the loss DOWN ──────────────────────
let learner = nn.mlp_new(2, 4, 1, 7);
let before = nn.loss(learner, data);
cur.curious_train(learner, data, 300, 0.5, 2);
let after = nn.loss(learner, data);
if after >= before { fail("curious_train should reduce loss (" + str(before) + " -> " + str(after) + ")"); }

// ── develop: learn, and GROW capacity when curiosity/loss plateaus ────────────────
let d = cur.develop(nn.mlp_new(2, 3, 1, 7), data, 4, 60, 0.5, 0.0005);
if d.net.l1.n_out < 3 { fail("develop never shrinks capacity"); }
if d.grew < 0 { fail("develop reports how many times it grew"); }
if nn.loss(d.net, data) > nn.loss(nn.mlp_new(2, 3, 1, 7), data) { fail("develop improves over the untrained baseline"); }

print "nn_curiosity_pass";
