let Doc=import("stdlib:ui_document.sapp");
let Web=import("stdlib:ui_form_web.sapp");
let doc=Doc.from_design(map{form:map{title:"Test",w:300,h:200},widgets:[],model:map{}});
fn req(path="/",host="127.0.0.1:8766") {return map{method:"GET",path:path,body:"",headers:map{host:host}};}
let app=Web.create(doc,map{});
for i 7 {assert(app.handle(req("/.env")).status==404,"unknown route rejected");}
assert(app.handle(req()).status==200,"below failure budget");
assert(app.handle(req("/.git/config")).status==404,"threshold rejection");
let blocked=app.handle(req());assert(blocked.status==429 and parse_number(blocked.headers["Retry-After"])>=1,"default cooldown");
app.close();assert(app.handle(req()).status==503,"close overrides cooldown");
let disabled=Web.create(doc,map{},8766,map{throttle_rejected_requests:false});
for i 10 {assert(disabled.handle(req("/unknown")).status==404,"optional throttle off");}
assert(disabled.handle(req()).status==200,"no failure cooldown when disabled");
assert(disabled.handle(req("/","foreign.invalid")).status==403,"Host remains protected");disabled.close();
let independent=Web.create(doc,map{},8766,map{discourage_scraping:false});
for i 8 {assert(independent.handle(req("/unknown")).status==404,"independent rejection count");}
assert(independent.handle(req()).status==429,"probe throttle independent of crawler policy");independent.close();
let bad=false;try Web.create(doc,map{},8766,map{throttle_rejected_requests:"off"}) catch {bad=true;};assert(bad,"boolean policy only");
let timed=Web.create(doc,map{},8766,map{discourage_scraping:false});
for i 8 {timed.handle(req("/unknown"));}
assert(timed.handle(req()).status==429,"cooldown starts");
sleep_ms(30100);
assert(timed.handle(req()).status==200,"cooldown expires without restart");timed.close();
print "ui_form_probe_budget_pass";
