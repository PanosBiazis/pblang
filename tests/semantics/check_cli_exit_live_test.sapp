// Exercise actual process status, not a matching diagnostic string alone.
if platform() != "linux" { print "check_cli_exit_live_skip_linux_required"; os_exit(0); }
let compiler = env_get("PBLANG_BIN") ?? path_join(cwd(), "target/release/pblang");
fn child(args) {
    let bounded = ["-k", "1s", "12s", compiler];
    for arg in args { array_push(bounded, arg); }
    return proc_spawn_wait("/usr/bin/timeout", bounded);
}
let good = "tests/fixtures/check_cli/valid.sapp";
let result = child(["check", good]);
assert(result.exit_code == 0 and str_contains(result.stdout, "0 error(s)"), "public check valid source");
for bad in ["arity", "operand", "syntax"] {
    let file = "tests/fixtures/check_cli/" + bad + ".sapp.txt";
    result = child(["check", file]);
    assert(result.exit_code == 1 and str_contains(result.stdout, "error"), "public check rejects " + bad);
    result = child(["run", "stdlib/check_cli.sapp", "--allow-all", "--", file]);
    assert(result.exit_code == 1, "direct driver rejects " + bad);
    result = child(["check", good, file]);
    assert(result.exit_code == 1, "mixed file batch rejects " + bad);
}
result = child(["check", "tests/fixtures/check_cli/does-not-exist.sapp"]);
assert(result.exit_code == 1, "missing file rejects");
result = child(["run", "stdlib/check_cli.sapp", "--allow-all"]);
assert(result.exit_code == 1, "empty direct invocation rejects");
result = child(["run", "tools/pbcheck.sapp", "--allow-fs", "--allow-env", "--", good]);
assert(result.exit_code == 0, "standalone checker remains available");
print "check_cli_exit_live_pass";
