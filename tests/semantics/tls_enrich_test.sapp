// tests/semantics/tls_enrich_test.sapp — fixes + enrichment for stdlib/tls.sapp
//
// FIXES:
//  * Compiled TLS symbols are not sufficient for safe availability: a runtime
//    with conflicting Rustls providers can panic before returning an error.
//  * connect_tls returned the raw builtin result (or {error}), but the documented
//    usage reads conn.handle / conn.error — now normalized to {handle, error}.
// ENRICHMENT: a real HTTPS client (get_https / request_https) and serve_app_tls
//    (serve an http_server app over TLS), all degrading gracefully (never throwing).

let tls = import("stdlib/tls.sapp");

fn fail(m) { throw "FAIL " + m; }

// ── FIX: TLS 1.3 works out-of-the-box via default ring CryptoProvider ───────────
if not tls.is_available() { fail("is_available() must be true out-of-the-box"); }
let provider = tls.provider_status();
if not provider.available or provider.selected != "ring" {
    fail("provider status must report default ring provider available: " + json_stringify(provider));
}

// ── FIX: connect_tls / connect return a {handle, error} map (documented shape) ──
let c = try tls.connect_tls("127.0.0.1", 1) catch "THREW";
if c == "THREW" { fail("connect_tls must not throw"); }
if type(c) != "map" { fail("connect_tls returns a map"); }
if not map_has(c, "handle") or not map_has(c, "error") {
    fail("connect_tls must return {handle, error}: " + str(map_keys(c)));
}
if c.error == nil or c.handle != nil { fail("failed connect must have handle:nil and non-nil error"); }

let c_alias = try tls.connect("127.0.0.1", 1) catch "THREW";
if c_alias == "THREW" or type(c_alias) != "map" or c_alias.handle != nil or c_alias.error == nil {
    fail("connect alias must behave identically to connect_tls");
}

// ── ENRICH: get_https rejects a non-https URL cleanly ───────────────────────────
let g = tls.get_https("http://example.com/");
if g.ok != false { fail("non-https URL -> ok:false"); }
if str_index_of(str(g.error), "https") < 0 { fail("error should mention https: " + str(g.error)); }

// ── ENRICH: get_https to an unreachable host degrades gracefully (no throw) ──────
let g2 = try tls.get_https("https://127.0.0.1:1/") catch "THREW";
if g2 == "THREW" { fail("get_https must not throw on a connection failure"); }
if g2.ok != false { fail("unreachable host -> ok:false"); }
if not map_has(g2, "error") { fail("unreachable host -> error map"); }

// ── ENRICH: request_https (method/headers/body) also degrades gracefully ────────
let r = try tls.request_https("POST", "https://127.0.0.1:1/x", map{ "X-A": "1" }, "body") catch "THREW";
if r == "THREW" { fail("request_https must not throw"); }
if r.ok != false { fail("request_https unreachable -> ok:false"); }

// ── ENRICH: serve_app_tls fails gracefully on a bad cert (no throw) ──────────────
let s = try tls.serve_app_tls("127.0.0.1:0", "/no/such.crt", "/no/such.key", map{ routes: [], middleware: [] }) catch "THREW";
if s == "THREW" { fail("serve_app_tls must not throw on a listen failure"); }
if not map_has(s, "error") { fail("serve_app_tls bad cert -> error map"); }

// ── existing exports + listen alias present ──────────────────────────────────────
let l = tls.listen_tls("127.0.0.1:0", "/no/such.crt", "/no/such.key");
if type(l) != "map" or not map_has(l, "error") { fail("listen_tls bad cert -> error map"); }
let l2 = tls.listen("127.0.0.1:0", "/no/such.crt", "/no/such.key");
if type(l2) != "map" or not map_has(l2, "error") { fail("listen alias bad cert -> error map"); }

print "tls_enrich_pass";
