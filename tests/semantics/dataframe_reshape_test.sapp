// tests/semantics/dataframe_reshape_test.sapp
//
// New data-science reshape/window library items on dataframe.sapp:
// pivot, melt, cumsum, pct_change, rolling_mean. None existed before.

let df = import("stdlib:dataframe.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=[" + str(a) + "] want=[" + str(b) + "]"); } }
fn approx(a, b, m) { let d = a - b; if d < 0 { d = 0 - d; } if d > 0.0001 { fail(m + " got=[" + str(a) + "] want~[" + str(b) + "]"); } }

fn find_row(rows, keycol, keyval) {
    let i = 0;
    while i < len(rows) {
        if str(try rows[i][keycol] catch nil) == str(keyval) { return rows[i]; }
        i = i + 1;
    }
    return nil;
}

// ── pivot ─────────────────────────────────────────────────────────────────────
let sales = df.from_rows([
    map{ region: "east", quarter: "Q1", amount: 10 },
    map{ region: "east", quarter: "Q2", amount: 20 },
    map{ region: "east", quarter: "Q1", amount: 5  },
    map{ region: "west", quarter: "Q1", amount: 7  }
]);
let p = df.pivot(sales, "region", "quarter", "amount", "sum");
eq(df.nrows(p), 2, "one row per distinct index value");
let east = find_row(p.rows, "region", "east");
eq(east.Q1, 15, "east Q1 summed (10+5)");
eq(east.Q2, 20, "east Q2");
let west = find_row(p.rows, "region", "west");
eq(west.Q1, 7, "west Q1");
eq(try west.Q2 catch nil, nil, "west has no Q2 cell");

// ── melt (unpivot) ────────────────────────────────────────────────────────────
let wide = df.from_rows([ map{ id: 1, math: 90, art: 80 } ]);
let long = df.melt(wide, ["id"], ["math", "art"]);
eq(df.nrows(long), 2, "one row per (id, value column)");
let mrow = find_row(long.rows, "variable", "math");
eq(mrow.id, 1, "id carried through");
eq(mrow.value, 90, "math value");
eq(find_row(long.rows, "variable", "art").value, 80, "art value");

// ── cumsum ────────────────────────────────────────────────────────────────────
let seq = df.from_rows([map{v:1},map{v:2},map{v:3},map{v:4}]);
eq(df.cumsum(seq, "v"), [1, 3, 6, 10], "running total");

// ── pct_change ────────────────────────────────────────────────────────────────
let pc = df.pct_change(df.from_rows([map{v:100},map{v:110},map{v:99}]), "v");
eq(pc[0], nil, "first period has no prior -> nil");
approx(pc[1], 0.1, "up 10%");
approx(pc[2], 0 - 0.1, "down 10%");

// ── rolling_mean ──────────────────────────────────────────────────────────────
let rm = df.rolling_mean(df.from_rows([map{v:1},map{v:2},map{v:3},map{v:4}]), "v", 2);
eq(rm[0], nil, "window not yet filled -> nil");
approx(rm[1], 1.5, "mean(1,2)");
approx(rm[2], 2.5, "mean(2,3)");
approx(rm[3], 3.5, "mean(3,4)");

print "dataframe_reshape_pass";
