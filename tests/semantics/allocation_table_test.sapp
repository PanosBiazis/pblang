let A=import("stdlib:allocation_table.sapp");let S=import("stdlib:sheet_document.sapp");let CSV=import("stdlib:sheet_csv.sapp");
fn rejects(f){assert((try f() catch nil)==nil,"unsupported allocation rejected");}
let input=CSV.decode("Label,Weight\nα, 01 \nα,1\nZero,0");let before=S.encode(input);let r=A.from_sheet(input,3);assert(r.document.cells==[["Label","Weight","Units"],["α","1","2"],["α","1","1"],["Zero","0","0"]],"ties, canonical weight text, duplicate labels and zero weight");assert(A.from_sheet(input,0).document.cells[1][2]=="0","zero total allowed");r.document.cells[1][0]="changed";assert(S.encode(input)==before,"source detached");assert(A.weights(" 1,2,0 ")==[1,2,0] and A.integer("0000001")==1,"strict integer parsing");for text in ["1e2","1.0","+1","-1","1,2","","1000001",nil,str_repeat("0",65)]{rejects(fn(){A.integer(text);});}for text in ["1,","0,,1",str_repeat("1,",32),nil]{rejects(fn(){A.weights(text);});}
for f in [fn(){A.create(["x"],[0],1);},fn(){A.create(["x"],[1],1.5);},fn(){A.create(["x"],[],1);},fn(){A.create([" "],[1],1);},fn(){A.create([str_repeat("α",129)],[1],1);},fn(){A.create(["x"],[1],1,"\n");},fn(){A.from_sheet(CSV.decode("label,Weight\nx,1"),1);},fn(){A.from_sheet(CSV.decode("Label,Weight"),1);}] {rejects(f);}
let large=S.create(32,2);large.cells[0]=["Label","Weight"];for i in range(1,32){large.cells[i]=["row "+str(i),"1000000"];}assert(len(A.from_sheet(large,1000000).document.cells)==32,"maximum rows and total");for i in range(1,32){large.cells[i][0]=str_repeat("α",128);}S.validate(large);rejects(fn(){A.from_sheet(large,1000000);});print "allocation_table_pass";
