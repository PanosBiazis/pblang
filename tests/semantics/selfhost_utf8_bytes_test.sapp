let FE=import("stdlib:compiler/selfhost_frontend.sapp");
let VM=import("stdlib:compiler/vm.sapp");
fn require(value,note) { if not value { throw "selfhost UTF8: "+note; } }
fn chunk(source) { let compiled=FE.frontend_compile(source);require(compiled.ok,"source compiles");return compiled.chunk; }
for text in ["","ASCII","Ελληνικά","é","中","😀","\u0000",str_repeat("aβ中😀",150)] {
    let code=chunk("print str_to_bytes("+json_stringify(text)+");");
    let expected=str_to_bytes(text);
    require(VM.run(code).output[0]==expected,"host byte parity");
    let cap=num_max(1,len(expected));
    require(VM.run_bounded(code,map{max_value_items:cap,max_steps:100000}).output[0]==expected,"exact inclusive byte budget");
    if len(expected)>1 {
        require((try VM.run_bounded(code,map{max_value_items:len(expected)-1}) catch nil)==nil,"one byte over budget refused");
    }
}
let alias=chunk("let encode=str_to_bytes;print encode(\"α😀\");");
require(VM.run(alias).output[0]==[206,177,240,159,152,128],"first-class builtin alias");
let shadow=chunk("fn str_to_bytes(value) { return [7]; } print str_to_bytes(\"x\");");
require(VM.run(shadow).output[0]==[7],"user shadowing preserved");
for expr in ["str_to_bytes()","str_to_bytes(\"x\",\"y\")","str_to_bytes(nil)","str_to_bytes(true)","str_to_bytes(42)","str_to_bytes([])","str_to_bytes(map{})"] {
    // Inspect raw bytecode so static argument diagnostics cannot hide runtime
    // arity/type failures. Direct and generic builtin dispatch both reject.
    let compiled=FE.frontend_compile("print "+expr+";");
    require((try VM.run(compiled.chunk) catch nil)==nil,"invalid runtime call refused");
}
let caught=chunk("let x=try str_to_bytes(\"😀😀\") catch []; print 1;");
require((try VM.run_bounded(caught,map{max_value_items:7}) catch nil)==nil,"allocation failure stays sticky through guest catch");
let scan=chunk("print len(str_to_bytes("+json_stringify(str_repeat("a",1000))+"));");
require(VM.run_bounded(scan,map{max_value_items:1000,max_steps:10000}).output[0]==1000,"ASCII exact bound never rejected by four-byte estimate");
require((try VM.run_bounded(scan,map{max_value_items:1000,max_steps:50}) catch nil)==nil,"exact preflight charges shared work budget");
let large=chunk("print len(str_to_bytes(str_repeat(\"a\",1048577)));");
require(VM.run(large).output[0]==1048577,"ordinary run has no new size cap");
print "selfhost_utf8_bytes_pass";
