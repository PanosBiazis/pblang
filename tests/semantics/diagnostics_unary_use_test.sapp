// Smart PBLang diagnostics: unary reads must retain real binding references.
// This does not certify the retained native `lint` implementation.
let D=import("stdlib:diagnostics.sapp");
let cases=[
    ["direct","let value=true; print value;",0],
    ["not","let value=true; print not value;",0],
    ["double-not","let value=true; print not not value;",0],
    ["negative","let value=3; print -value;",0],
    ["member","let value=map{ok:true}; if not value.ok {print 1;}",0],
    ["logical","let value=true; print not (value or false);",0],
    ["array-index","let value=[true]; print not value[0];",0],
    ["call-argument","fn predicate(x){return x;} let value=true; print not predicate(value);",0],
    ["closure","fn test(){let value=true;fn read(){return not value;}return read();} print test();",0],
    ["catch-read","let value=true; print (try false catch not value);",0],
    ["if-condition","let value=true; print if value {7} else {0};",0],
    ["if-then","let value=7; print if true {value} else {0};",0],
    ["if-else","let value=7; print if false {0} else {value};",0],
    ["if-member","let value=map{ok:true}; print if value.ok {7} else {0};",0],
    ["if-not-nested","let value=map{ok:true}; print if not value.ok {0} else {7};",0],
    ["assigned-then-read","let value=true; value=false; print not value;",0],
    ["assignment-only","let value=true; value=false; print 1;",1],
    ["unused","let value=true; print 1;",1],
    ["shadow","let value=true; if true {let value=false; print not value;} print 1;",1],
    ["string-not-read","let value=true; print \"not value\";",1],
    ["comment-not-read","let value=true; // not value\nprint 1;",1],
    ["exported","let value=true; export value;",0]
];
let passed=0;
for entry in cases {
    for checked in [false,true] {
        let result=if checked {D.diagnose_checked(entry[1])} else {D.diagnose(entry[1])};
        assert(result.ok,"parse/name/type errors: "+entry[0]+" checked="+str(checked)+": "+str(result.errors));
        let unused=0;
        for diagnostic in result.diagnostics {
            if diagnostic.code=="unused-variable" and diagnostic.name=="value" {unused=unused+1;}
        }
        assert(unused==entry[2],"unused binding count: "+entry[0]);
        passed=passed+1;
    }
}
for source in ["print not unknown;","print not missing.ok;",
    "print if unknown {7} else {0};","print if true {unknown} else {0};",
    "print if false {0} else {unknown};"] {
    let result=D.diagnose_checked(source);
    assert(not result.ok,"nested missing-name error must survive");
    let found=false;
    for diagnostic in result.errors {if diagnostic.code=="undefined-name" {found=true;}}
    assert(found,"specific missing-name diagnostic");
    passed=passed+1;
}
print "diagnostics_unary_use_pass:"+str(passed);
