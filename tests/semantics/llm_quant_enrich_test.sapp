// tests/semantics/llm_quant_enrich_test.sapp — enrichment for stdlib/llm_quant.sapp
// Adds qvec roundtrip + error metric + compression_ratio.

let q = import("stdlib/llm_quant.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

let v = [1.0, 0.5, 0 - 0.25, 0.75];

// ── base quantize/dequantize still works ─────────────────────────────────────────
let qv = q.quantize_vec(v, 8);
let dq = q.dequantize_vec(qv);
if num_abs(dq[0] - 1.0) > 0.02 { fail("dequantize ~ original"); }

// ── ENRICH: roundtrip + qvec_mse (8-bit is low error) ────────────────────────────
let rt = q.roundtrip(v, 8);
if len(rt) != 4 { fail("roundtrip length"); }
let mse8 = q.qvec_mse(v, 8);
if mse8 < 0 or mse8 > 0.001 { fail("8-bit mse should be small, got " + str(mse8)); }
// 4-bit should be noisier than 8-bit
if q.qvec_mse(v, 4) <= mse8 { fail("4-bit mse should exceed 8-bit mse"); }

// ── ENRICH: compression_ratio ────────────────────────────────────────────────────
near(q.compression_ratio(8), 4, "fp32->int8 = 4x");
near(q.compression_ratio(4), 8, "fp32->int4 = 8x");

print "llm_quant_enrich_pass";
