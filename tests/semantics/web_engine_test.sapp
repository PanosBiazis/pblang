// tests/semantics/web_engine_test.sapp — pblang-native web engine (fetch→parse→layout→paint).

let WE = import("stdlib/web_engine.sapp");
let TH = import("stdlib/theme.sapp");

fn fail(m) { throw "FAIL " + m; }
fn eq(a, b, m) { if a != b { fail(m + " got=" + str(a) + " want=" + str(b)); } }
fn has(s, sub, m) { if str_index_of(s, sub) < 0 { fail(m + " : <<" + s + ">>"); } }

// build a page without the network
let html = "<html><head><title>Demo</title></head><body>"
    + "<h1>Welcome</h1><p>the quick brown fox jumps over the lazy dog repeatedly here</p>"
    + "<a href='http://example.com/next'>next page</a></body></html>";
let page = WE.page_from_html("http://site", html);
eq(page.title, "Demo", "title parsed");

// ── render: laid-out boxes + links ─────────────────────────────────────────────────
let doc = WE.render(page, map{ width: 200 });
if len(doc.boxes) < 2 { fail("rendered blocks: " + str(len(doc.boxes))); }
if doc.height <= 0 { fail("positive height"); }
// links extracted from the page
let lk = false; let i = 0;
while i < len(doc.links) { if str_index_of(doc.links[i].href, "example.com") >= 0 { lk = true; } i = i + 1; }
if not lk { fail("link extracted: " + str(doc.links)); }

// ── paint: a canvas of draw commands (themed) ─────────────────────────────────────
let cv = WE.paint(page, TH.dark(), map{ width: 200 });
if WE.command_count(cv) < 2 { fail("paint emits commands"); }
// first command is the themed background fill
let cmds = WE.commands(cv);
eq(cmds[0].op, "fill_rect", "background painted first");

// ── hit_test: a point inside a box returns that box ───────────────────────────────
let b0 = doc.boxes[0];
let hit = WE.hit_test(doc, b0.x + 1, b0.y + 1);
if hit == nil { fail("hit_test finds the first box"); }

print "web_engine_pass";
