// Pure PBLang whole-ZIP verification precedes output effects test (including unselected members)
// (replaces tests/semantics/archive_extraction_cli_test.py).

let OS = import("stdlib:os.sapp");
let F = import("stdlib:flate.sapp");

fn _resolve_runtime(cli) {
    let rt = "./pblang";
    if len(cli) > 0 and cli[0] != "" { rt = cli[0]; }
    if str_starts_with(rt, "/") { return rt; }
    if str_starts_with(rt, "./") { rt = str_slice(rt, 2, len(rt)); }
    return OS.cwd() + "/" + rt;
}

fn _push_u16(out, v) {
    array_push(out, bit_and(v, 255));
    array_push(out, bit_and(bit_shr(v, 8), 255));
}

fn _push_u32(out, v) {
    array_push(out, bit_and(v, 255));
    array_push(out, bit_and(bit_shr(v, 8), 255));
    array_push(out, bit_and(bit_shr(v, 16), 255));
    array_push(out, bit_and(bit_shr(v, 24), 255));
}

fn _push_all(out, arr) {
    let i = 0;
    while i < len(arr) { array_push(out, arr[i]); i = i + 1; }
}

fn _wbits(w, val, nbits) {
    let i = 0;
    while i < nbits {
        let bit = bit_and(bit_shr(val, i), 1);
        w.acc = bit_or(w.acc, bit_shl(bit, w.nb));
        w.nb = w.nb + 1;
        if w.nb == 8 {
            array_push(w.out, w.acc);
            w.acc = 0;
            w.nb = 0;
        }
        i = i + 1;
    }
}

fn _whuff_msb(w, code, nbits) {
    let i = nbits - 1;
    while i >= 0 {
        let bit = bit_and(bit_shr(code, i), 1);
        w.acc = bit_or(w.acc, bit_shl(bit, w.nb));
        w.nb = w.nb + 1;
        if w.nb == 8 {
            array_push(w.out, w.acc);
            w.acc = 0;
            w.nb = 0;
        }
        i = i - 1;
    }
}

fn _deflate_repeat_x(total_len) {
    let w = map{out: [], acc: 0, nb: 0};
    _wbits(w, 1, 1);
    _wbits(w, 1, 2);
    if total_len > 0 {
        _whuff_msb(w, 48 + 120, 8);
        let rem = total_len - 1;
        while rem >= 258 {
            _whuff_msb(w, 192 + 5, 8);
            _whuff_msb(w, 0, 5);
            rem = rem - 258;
        }
        while rem > 0 {
            _whuff_msb(w, 48 + 120, 8);
            rem = rem - 1;
        }
    }
    _whuff_msb(w, 0, 7);
    if w.nb > 0 { array_push(w.out, w.acc); }
    return w.out;
}

fn _crc32_repeat_x(total_len) {
    let tbl = [];
    let n = 0;
    while n < 256 {
        let c = n;
        let k = 0;
        while k < 8 {
            if bit_and(c, 1) == 1 { c = bit_xor(bit_shr(c, 1), 3988292384); }
            else { c = bit_shr(c, 1); }
            k = k + 1;
        }
        array_push(tbl, c);
        n = n + 1;
    }
    let crc = 4294967295;
    let i = 0;
    while i < total_len {
        crc = bit_xor(bit_shr(crc, 8), tbl[bit_and(bit_xor(crc, 120), 255)]);
        i = i + 1;
    }
    return bit_xor(crc, 4294967295);
}

fn _raw_zip(rows) {
    let out = [];
    let centrals = [];
    let offsets = [];
    let cd_offsets = [];
    let i = 0;
    while i < len(rows) {
        let r = rows[i];
        let name = r.name;
        let nameb = str_to_bytes(name);
        let data = [];
        if map_has(r, "data") {
            if type(r.data) == "string" { data = str_to_bytes(r.data); }
            else { data = r.data; }
        }
        let method = try r.method catch 0;
        let payload = data;
        let orig_size = len(data);
        let crc = 0;
        if map_has(r, "payload_override") {
            payload = r.payload_override;
            orig_size = r.size_override;
            crc = r.crc_override;
        } else {
            crc = F.crc32(data);
            if method == 8 {
                if len(data) == 0 {
                    payload = [3, 0];
                } else {
                    payload = F.deflate_fast(data);
                }
            }
        }
        let mode = try r.mode catch (if str_ends_with(name, "/") { 16877 } else { 33188 });
        let offset = len(out);
        array_push(offsets, offset);
        _push_all(out, [80, 75, 3, 4, 20, 0, 0, 0]);
        _push_u16(out, method);
        _push_u32(out, 0);
        _push_u32(out, crc);
        _push_u32(out, len(payload));
        _push_u32(out, orig_size);
        _push_u16(out, len(nameb));
        _push_u16(out, 0);
        _push_all(out, nameb);
        _push_all(out, payload);

        let c = [80, 75, 1, 2, 20, 3, 20, 0, 0, 0];
        _push_u16(c, method);
        _push_u32(c, 0);
        _push_u32(c, crc);
        _push_u32(c, len(payload));
        _push_u32(c, orig_size);
        _push_u16(c, len(nameb));
        _push_u16(c, 0);
        _push_u16(c, 0);
        _push_u16(c, 0);
        _push_u16(c, 0);
        _push_u32(c, mode * 65536);
        _push_u32(c, offset);
        _push_all(c, nameb);
        array_push(centrals, c);
        i = i + 1;
    }
    let cd_off = len(out);
    i = 0;
    while i < len(centrals) {
        array_push(cd_offsets, len(out));
        _push_all(out, centrals[i]);
        i = i + 1;
    }
    let cd_size = len(out) - cd_off;
    _push_all(out, [80, 75, 5, 6, 0, 0, 0, 0]);
    _push_u16(out, len(rows));
    _push_u16(out, len(rows));
    _push_u32(out, cd_size);
    _push_u32(out, cd_off);
    _push_u16(out, 0);
    return map{bytes: out, offsets: offsets, cd_offsets: cd_offsets, cd_off: cd_off};
}

fn main() {
    let cli = OS.script_args();
    let runtime = _resolve_runtime(cli);
    let repo = OS.cwd();

    let mk = proc_spawn_wait("/usr/bin/mktemp", ["-d", "/tmp/archive-selection-XXXXXX"]);
    assert(mk.exit_code == 0, "mktemp failed: " + mk.stderr);
    let root = str_trim(mk.stdout);
    let checks = [];

    let run_case = fn(label, data_bytes, name, ok) {
        let src = root + "/input.zip";
        let dst = root + "/" + label;
        fs_write_bytes(src, data_bytes);
        let p = proc_spawn_wait(runtime, ["run", repo + "/tools/archive_extract.sapp", "--allow-all", "--", "--extract", src, name, dst]);
        let want_ec = if ok { 0 } else { 1 };
        if p.exit_code != want_ec {
            proc_spawn_wait("/bin/rm", ["-rf", "--", root]);
            error("case " + label + " unexpected exit_code=" + str(p.exit_code) + " out=" + p.stdout + " err=" + p.stderr);
        }
        let r = json_parse(p.stdout);
        assert(r["ok"] == ok and not str_contains(p.stdout, root) and not str_contains(p.stdout, "chosen"), "redaction check: " + label);
        if not ok {
            assert(not fs_exists(dst) and r["publication_attempted"] == false, "no dst on rejection: " + label);
        }
        array_push(checks, label);
        return dst;
    };

    // Build 256 * 274 = 70144 byte pattern
    let pattern = [];
    let rep = 0;
    while rep < 274 {
        let b = 0;
        while b < 256 {
            array_push(pattern, b);
            b = b + 1;
        }
        rep = rep + 1;
    }

    let methods = [0, 8];
    let mi = 0;
    while mi < len(methods) {
        let m = methods[mi];
        let z = _raw_zip([
            map{name: "chosen", data: pattern, method: m},
            map{name: "later", data: "valid", method: m}
        ]);
        let dst = run_case("full-" + str(m), z.bytes, "chosen", true);
        let got = fs_read_bytes(dst);
        assert(got == pattern and len(got) > 65536, "full-" + str(m) + " exact payload > 64 KiB");
        mi = mi + 1;
    }

    let good_info = _raw_zip([
        map{name: "chosen", data: "first", method: 0},
        map{name: "later", data: "secret", method: 0}
    ]);
    let good = good_info.bytes;
    let corrupt = slice(good, 0, len(good));
    let later_off = good_info.offsets[1];
    corrupt[later_off + 30 + len("later")] = bit_xor(corrupt[later_off + 30 + len("later")], 1);
    run_case("unselected-crc", corrupt, "chosen", false);

    let bad_names = [
        map{label: "traversal", name: "../escape"},
        map{label: "absolute", name: "/escape"},
        map{label: "backslash", name: "a\\b"},
        map{label: "case-collision", name: "CHOSEN"},
        map{label: "file-ancestor", name: "chosen/child"}
    ];
    let bi = 0;
    while bi < len(bad_names) {
        let item = bad_names[bi];
        let z = _raw_zip([
            map{name: "chosen", data: "first", method: 0},
            map{name: item.name, data: "bad", method: 0}
        ]);
        run_case(item.label, z.bytes, "chosen", false);
        bi = bi + 1;
    }

    let sym_zip = _raw_zip([
        map{name: "chosen", data: "first", method: 0},
        map{name: "link", data: "target", method: 0, mode: 41471}
    ]);
    run_case("symlink-member", sym_zip.bytes, "chosen", false);

    let encrypted = slice(good, 0, len(good));
    let ei = 0;
    while ei < len(good_info.offsets) {
        let loff = good_info.offsets[ei];
        let coff = good_info.cd_offsets[ei];
        encrypted[loff + 6] = bit_or(encrypted[loff + 6], 1);
        encrypted[coff + 8] = bit_or(encrypted[coff + 8], 1);
        ei = ei + 1;
    }
    run_case("encryption-flags", encrypted, "chosen", false);

    run_case("missing", good, "absent", false);

    let emp_store = _raw_zip([map{name: "chosen", data: "", method: 0}]);
    let dst_emp = run_case("empty", emp_store.bytes, "chosen", true);
    assert(len(fs_read_bytes(dst_emp)) == 0, "empty extracted 0 bytes");

    let emp_def = _raw_zip([map{name: "chosen", data: "", method: 8}]);
    run_case("empty-deflate", emp_def.bytes, "chosen", false);

    let dir_z = _raw_zip([map{name: "chosen/", data: "", method: 0}]);
    run_case("directory", dir_z.bytes, "chosen/", false);

    let big_payload = _deflate_repeat_x(1048577);
    let big_crc = _crc32_repeat_x(1048577);
    let exp_z = _raw_zip([
        map{name: "chosen", data: "", method: 8, payload_override: big_payload, size_override: 1048577, crc_override: big_crc}
    ]);
    run_case("expanded-limit", exp_z.bytes, "chosen", false);

    let many_rows = [map{name: "chosen", data: "x", method: 0}];
    let fi = 0;
    while fi < 256 {
        array_push(many_rows, map{name: "f" + str(fi), data: "", method: 0});
        fi = fi + 1;
    }
    let many_z = _raw_zip(many_rows);
    run_case("entry-limit", many_z.bytes, "chosen", false);

    proc_spawn_wait("/bin/rm", ["-rf", "--", root]);
    print(json_stringify(map{passed: checks, count: len(checks)}));
}

main();
