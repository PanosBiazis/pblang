let CP = import("stdlib:compute.sapp");
let A = import("stdlib:accelerator.sapp");
A.clear_runtimes();
let calls = map{ count: 0 };
let kinds = ["gpu", "npu", "simd", "distributed"];
let devices = [];
for kind in kinds {
    A.register_runtime(kind, fn(payload) { calls.count = calls.count + 1; return payload; });
    array_push(devices, map{ kind: kind, usable: true });
}
let cases = [
    ["auto", "generic"], ["auto", "custom-workload"], ["gpu", "numeric"],
    ["npu", "tensor"], ["distributed", "inference"], ["simd", "image"],
    ["gpu", "batch"], ["npu", "training"],
];
let values = []; let i = 0;
while i < 256 { array_push(values, i); i = i + 1; }
for entry in cases {
    let options = map{ preferred_device: entry[0], workload: entry[1], max_workers: 1 };
    let cfg = CP.policy(options);
    let result = CP.run_controlled(values, fn(x) { return x; }, options);
    assert(result.route == CP.select_device(256, devices, cfg) and result.results == values,
        "incompatible workloads preserve complete routes despite registered devices");
    options.fallback_to_cpu = false;
    let strict = CP.run_controlled(values, fn(x) { return x; }, options);
    assert(strict.ok == (entry[0] == "auto"), "strict incompatible requests remain blocked");
}
assert(calls.count == 0, "incompatible workloads never dispatch a registered executor");
let compatible = [["gpu", "tensor"], ["npu", "inference"], ["simd", "numeric"], ["distributed", "batch"]];
for entry in compatible {
    let options = map{ preferred_device: entry[0], workload: entry[1], max_workers: 1,
        min_accelerator_items: 1, work_units_per_item: 10000, transfer_bytes_per_item: 0,
        fallback_to_cpu: false };
    let result = CP.run_controlled([2,3], fn(x) { return x; }, options);
    assert(result.ok and result.route.device == entry[0] and result.results == [2,3],
        "compatible registered executors retain fresh discovery");
}
assert(calls.count == 4, "every eligible executor invoked exactly once");
A.clear_runtimes();
let removed = CP.run_controlled([2,3], fn(x) { return x; }, map{
    preferred_device: "gpu", workload: "tensor", max_workers: 1,
    min_accelerator_items: 1, fallback_to_cpu: false,
});
assert(not removed.ok and calls.count == 4, "unregistration takes effect immediately");
print "compute_workload_discovery_pass";
