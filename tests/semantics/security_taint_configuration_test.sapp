let T=import("stdlib:security_taint.sapp");
fn expect(ok,label) {if not ok {throw "FAIL taint-configuration: "+label;}}
let source="fs_write(env_get(\"INPUT\"),\"fixed\");";
fn rejected(options) {
    let result=T.analyze(source,"private-policy-marker",options);
    expect(not result.ok and not result.passed,"malformed policy rejects");
    expect(not str_contains(json_stringify(result),"private-policy-marker"),"invalid policy does not echo input");
}
rejected(map{taint_sinks:map{fs_write:map{severity:"HIGH",class:"fixture",args:[0]}}});
rejected(map{taint_sinks:map{fs_write:map{severity:"high",class:"fixture"}}});
for field in ["taint_sources","taint_sanitizers"] {
    for value in [nil,1,true,[],map{},"",str_repeat("a",257),str_repeat("α",129),"bad\nname","bad\x00name","bad\x7fname"] {
        let options=map{};options[field]=[value];rejected(options);
    }
    let too_many=[];for i 129 {push(too_many,"name");}
    let options=map{};options[field]=too_many;rejected(options);
    for value in [str_repeat("a",256),str_repeat("α",128)] {
        let names=[];for i 128 {push(names,value);}
        let options=map{};options[field]=names;
        expect(T.analyze("","fixture.sapp",options).passed,"name byte and count exact boundaries");
    }
}
for spec in [nil,1,true,[],map{},map{args:[],class:"fixture"},
    map{args:[],severity:"high"},map{args:nil,class:"fixture",severity:"high"}] {
    rejected(map{taint_sinks:map{unused:spec}});
}
for field in ["severity","class","args","control_flow"] {
    let invalid=[];
    if field=="severity" {invalid=[nil,1,true,"HIGH","critical","private-policy-marker"];}
    elif field=="class" {invalid=[nil,1,"",str_repeat("a",257),"private-policy-marker\n"];}
    elif field=="args" {invalid=[nil,1,true,"private-policy-marker",map{}];}
    else {invalid=[nil,1,"false",[],map{}];}
    for value in invalid {
        let spec=map{severity:"high",class:"fixture",args:[0]};spec[field]=value;
        rejected(map{taint_sinks:map{unused:spec}});
    }
}
let indexes=[];for i 33 {push(indexes,0);}
rejected(map{taint_sinks:map{unused:map{severity:"high",class:"fixture",args:indexes}}});
for value in [nil,true,"0",0.5,-1,256,parse_number("NaN"),parse_number("inf"),parse_number("-inf"),bigint(0),rational("0/1"),decimal("0")] {
    rejected(map{taint_sinks:map{unused:map{severity:"high",class:"fixture",args:[value]}}});
}
let sinks=map{};for i 129 {sinks["sink"+str(i)]=map{severity:"high",class:"fixture",args:[0]};}
rejected(map{taint_sinks:sinks});
for key in ["",str_repeat("a",257),"bad\nname"] {
    let sinks=map{};sinks[key]=map{severity:"high",class:"fixture",args:[0]};rejected(map{taint_sinks:sinks});
}
let many=map{};let exact=[];for i 32 {push(exact,255);}
for i 128 {many["sink"+str(i)]=map{severity:"medium",class:str_repeat("α",128),args:exact,control_flow:false};}
expect(T.analyze("","fixture.sapp",map{taint_sinks:many}).passed,"sink count args index and class exact caps");
let first=json_stringify(T.analyze(source,"fixture.sapp"));
let options=map{taint_sources:["env_get"],taint_sanitizers:[],taint_sinks:map{fs_write:map{severity:"high",class:"fixture",args:[0]}}};
let original=json_stringify(options);let custom=T.analyze(source,"fixture.sapp",options);
expect(not custom.passed and custom.finding_count==1,"custom valid sink still blocks");
expect(json_stringify(options)==original,"caller configuration not mutated");
custom.findings[0].severity="low";
options.taint_sinks.fs_write.severity="low";
expect(T.analyze(source,"fixture.sapp",options).passed,"explicit low severity preserved");
expect(json_stringify(T.analyze(source,"fixture.sapp"))==first,"custom and report mutation do not contaminate defaults");
expect((try T._DEFAULT_CONFIG catch nil)==nil,"defaults are private");
expect(T.analyze(source,"fixture.sapp",map{taint_sources:[],taint_sanitizers:[],taint_sinks:map{}}).passed,"intentional empty replacement preserved");
let precedence=T.analyze("/*", "private-policy-marker",map{taint_sources:[nil],max_taint_tokens:0});
expect(not precedence.ok and precedence.error=="taint_sources must contain bounded names","policy rejected before numeric and lexical work");
let D=import("stdlib:security_dependency_analysis.sapp");
for mode in ["protect","strict","audit"] {
    for policy in [map{taint_sources:[nil]},map{taint_sinks:map{fs_write:map{severity:"HIGH",class:"fixture",args:[0]}}},
        map{taint_sinks:map{fs_write:map{severity:"high",class:"fixture"}}}] {
        let report=D.analyze_entry("configuration-fixture.sapp",map{entry_source:source,security_mode:mode,security:policy});
        expect(not report.passed,"dependency mode rejects malformed nested policy");
    }
}
print "security_taint_configuration_pass";
