// tests/semantics/graphics_enrich_test.sapp — enrichment for stdlib/graphics.sapp
// Adds pure geometry/collision helpers: distance, point_in_rect, point_in_circle,
// rect_intersect, lerp_point.

let g = import("stdlib/graphics.sapp");

fn fail(m) { throw "FAIL " + m; }
fn near(a, b, m) { if num_abs(a - b) > 0.0001 { fail(m + " got=" + str(a) + " want=" + str(b)); } }

// ── base color helper still works ────────────────────────────────────────────────
let c = g.rgb(255, 0, 0);
if len(c) < 3 { fail("rgb returns a color"); }

// ── ENRICH: distance ─────────────────────────────────────────────────────────────
near(g.distance([0, 0], [3, 4]), 5, "distance");

// ── ENRICH: point_in_rect ────────────────────────────────────────────────────────
if not g.point_in_rect(5, 5, 0, 0, 10, 10) { fail("point inside rect"); }
if g.point_in_rect(15, 5, 0, 0, 10, 10) { fail("point outside rect"); }

// ── ENRICH: point_in_circle ──────────────────────────────────────────────────────
if not g.point_in_circle(1, 1, 0, 0, 5) { fail("point inside circle"); }
if g.point_in_circle(4, 4, 0, 0, 5) { fail("point outside circle (dist>5)"); }

// ── ENRICH: rect_intersect (AABB) ────────────────────────────────────────────────
if not g.rect_intersect(0, 0, 10, 10, 5, 5, 10, 10) { fail("overlapping rects"); }
if g.rect_intersect(0, 0, 2, 2, 5, 5, 2, 2) { fail("disjoint rects"); }

// ── ENRICH: lerp_point ───────────────────────────────────────────────────────────
let p = g.lerp_point([0, 0], [10, 20], 0.5);
near(p[0], 5, "lerp x"); near(p[1], 10, "lerp y");

print "graphics_enrich_pass";
