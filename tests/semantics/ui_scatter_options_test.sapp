let Plot=import("stdlib:ui_scatter_plot.sapp");let Doc=import("stdlib:ui_document.sapp");let Web=import("stdlib:ui_form_web_document.sapp");
fn reject(options){let failed=false;try Plot.render([[1,2],[3,4]],"Plot","X","Y",options) catch {failed=true;};assert(failed,"invalid plot option rejected");}
let options=map{x_domain:[0,4],y_domain:[0,8],point_labels:["A <one>","B & two"],description:"Compare <safely>",table_open:true};
let points=[[1,2],[3,4]];
let svg=Plot.render(points,"Named","X","Y",options);
assert(str_contains(svg,"cx=\"189\" cy=\"240\"") and str_contains(svg,"cx=\"471\" cy=\"168\""),"fixed domains preserve actual scale");
assert(str_contains(svg,"<details open>") and str_contains(svg,"2 points. X: 0 to 4; Y: 0 to 8."),"open values and visible scale");
assert(str_contains(svg,"A &lt;one&gt;: 1, 2") and str_contains(svg,"<td>A &lt;one&gt;</td>"),"names in SVG and table escaped once");
assert(str_contains(svg,"Compare &lt;safely&gt;") and not str_contains(svg,"<safely>"),"description is passive text");
assert(options.x_domain[0]==0 and options.point_labels[0]=="A <one>" and points[0][0]==1,"caller inputs unchanged");
let flat=Plot.render([[2,2]],"Fixed","X","Y",map{x_domain:[0,8],y_domain:[0,8]});
assert(str_contains(flat,"cx=\"189\" cy=\"240\""),"constant points honor explicit scale instead of centering");
for invalid in [true,[],map{script:"bad"},map{x_domain:[]},map{x_domain:[0]},map{x_domain:[0,2,4]},map{x_domain:[2,4]},map{x_domain:[0,2]},map{x_domain:[3,3]},map{x_domain:[4,0]},map{x_domain:[false,4]},map{x_domain:[0,parse_number("1e13")]},map{y_domain:[0,3]},map{point_labels:[]},map{point_labels:["one"]},map{point_labels:["", "two"]},map{point_labels:[false,"two"]},map{point_labels:[str_repeat("x",257),"two"]},map{description:5},map{description:str_repeat("x",4097)},map{table_open:1}] {reject(invalid);}
let labels=[];let many=[];for i 17 {push(labels,str_repeat("x",256));push(many,[i,i]);}
let failed=false;try Plot.render(many,"Budget","X","Y",map{point_labels:labels}) catch {failed=true;};assert(failed,"aggregate label bytes bounded");
let doc=Doc.from_design(map{form:map{title:"Named projection",w:640,h:400},model:map{},widgets:[map{name:"Plot",kind:"scatter",x:0,y:0,w:600,h:360,props:map{points:points,plot_options:options}}]});
let prepared=Web.prepare(doc,map{});
doc.widgets[0].props.plot_options.point_labels[0]="MUTATED";
let page=Web.page(map{schema:prepared.schema,csrf:str_repeat("0",64),revision:0});
assert(str_contains(page,"A &lt;one&gt;") and not str_contains(page,"MUTATED"),"prepared plot detached from option mutations");
doc.widgets[0].props.visible=false;
let hidden=Web.prepare(doc,map{});assert(not str_contains(Web.page(map{schema:hidden.schema,csrf:str_repeat("0",64),revision:0}),"MUTATED"),"hidden named plot does not disclose labels");
doc.widgets[0].props.plot_options.script="bad";assert(not Web.inspect(doc).ok,"unknown nested option rejected by preflight");
let unicode=Plot.render([[1,2]],"Greek","X","Y",map{point_labels:["Σημείο"],description:"Δεδομένα"});
assert(str_contains(unicode,"Σημείο") and str_contains(unicode,"Δεδομένα"),"Unicode names retained");
print "ui_scatter_options_pass";
