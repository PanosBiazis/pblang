// tests/semantics/websocket_parse_frame_test.sapp — W3/W4 websocket parse test
import "stdlib:websocket.sapp";

// A minimal unmasked text frame: FIN=1, opcode=1 (text), payload "Hi"
// Frame bytes: 0x81 0x02 0x48 0x69
let frame_bytes = [0x81, 0x02, 0x48, 0x69];
let parsed = websocket.parse_frame(frame_bytes);
if parsed == nil { print "parse_frame nil FAIL"; }

print "websocket_parse_frame_pass";
