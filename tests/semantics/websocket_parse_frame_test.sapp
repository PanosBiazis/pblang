// tests/semantics/websocket_parse_frame_test.sapp — W3-epsilon: parse_frame unmasked text frame
// Minimal unmasked text frame: FIN=1, opcode=1 (text), payload len=2, payload "Hi"
let ws = import("stdlib:websocket.sapp");

// Frame as Array<u8>: header bytes + ASCII payload.
let frame_data = [129, 2, 72, 105];

let result = ws.parse_frame(frame_data);

if result["opcode"] != 1 { throw "fail"; }
if result["fin"] != 1 { throw "fail"; }
if result["masked"] != 0 { throw "fail"; }
if result["payload"] != "Hi" { throw "fail"; }

print "websocket_parse_frame_pass";
