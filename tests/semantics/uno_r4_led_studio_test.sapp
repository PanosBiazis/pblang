let M=import("../../examples/uno_r4_led_studio/model.sapp");let L=import("stdlib:uno_r4_led_matrix.sapp");
fn denied(f) {return try {f();false;} catch true;}
let s=M.create();M.apply(s,"preset","clear");M.apply(s,"pixel",0);assert(M.current(s)[0]==1,"pixel edit");
let copy=M.current(s);copy[0]=0;assert(M.current(s)[0]==1,"snapshot detached");
M.apply(s,"add");M.apply(s,"pixel",95);assert(s.index==1 and s.document.frames[0].pixels[95]==0,"duplicate independent");
M.apply(s,"duration",100);M.apply(s,"previous");M.apply(s,"duration",50);
let original=M.export_document(s);assert(denied(fn(){M.apply(s,"duration",99999);}) and M.export_document(s)==original,"invalid action is atomic");
M.apply(s,"play",nil,1000);assert(s.playing and s.index==0,"play restarts from first frame");
assert(not M.tick(s,1049) and s.index==0,"before boundary stable");assert(M.tick(s,1050) and s.index==1,"advance at boundary");
assert(M.tick(s,1150) and not s.playing and s.index==1,"one pass stops exactly");
M.apply(s,"play",nil,2000);M.apply(s,"stop");assert(not M.tick(s,3000) and s.index==0,"stop cancels playback");
M.apply(s,"play",nil,4000);assert(M.tick(s,3999) and not s.playing,"backward clock stops");
M.apply(s,"text","PB");assert(len(s.document.frames)==25 and s.index==0,"text creates editable timeline");
M.apply(s,"next");M.apply(s,"pixel",1);assert(not s.playing,"editing stops playback");
let exported=json_parse(M.export_document(s));assert(exported.arduino_frames==L.arduino_sequence(exported.document),"export shared model parity");
M.apply(s,"export");assert(s.export_requested,"explicit export request");
let one=M.create();assert(denied(fn(){M.apply(one,"delete");}) and len(one.document.frames)==1,"last frame retained");
print "uno_r4_led_studio_pass";
