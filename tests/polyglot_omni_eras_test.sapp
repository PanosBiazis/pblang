// tests/polyglot_omni_eras_test.sapp — PBLang v2.2.0 Sovereign Omni-Polyglot Verification Suite
// Verifies @<lang> extraction & execution across Programming and Non-Programming languages
// from 1945 (Plankalkül) to Modern Systems/Scripting, Non-Programming Notations, and Futuristic Paradigms.

let POLY = import("stdlib:polyglot.sapp");
let REG  = import("stdlib:polyglot_registry.sapp");

fn fail(msg) { throw "FAIL [polyglot_omni_eras]: " + msg; }
fn demand(cond, msg) { if not cond { fail(msg); } }

// ── Embedded @<lang> Polyglot Blocks (Testing +, -, #, . tags & string braces) ──

@plankalkul [name="zuse_sum10"] {
    V0 => Z0
    0 => R0
    W [Z0 > 0] {
        R0 + Z0 => R0
        Z0 - 1 => Z0
    }
}

@fortran [name="fortran57_fact"] {
      N = 5
      FACT = 1
      DO 10 I = 1, N
      FACT = FACT * I
10    CONTINUE
      PRINT *, FACT
}

@lisp [name="lisp58_fact"] {
    (define (fact n) (if (<= n 1) 1 (* n (fact (- n 1)))))
    (fact 6)
}

@cobol [name="cobol59_ledger"] {
    01 QTY PIC 9(4) VALUE 12.
    01 PRICE PIC 9(4) VALUE 25.
    01 TAX PIC 9(4) VALUE 72.
    01 TOTAL PIC 9(6) VALUE 0.
    MULTIPLY QTY BY PRICE GIVING TOTAL.
    ADD TAX TO TOTAL.
    DISPLAY TOTAL.
}

@algol-60 [name="algol60_sqsum"] {
    begin
    s := 0;
    for i := 1 step 1 until 6 do s := s + i * i;
    outinteger(1, s)
    end
}

@apl [name="apl62_vec"] {
    +/ 2 * iota 5
}

@basic [name="basic64_loop"] {
    10 LET S = 0
    20 FOR I = 1 TO 5
    30 LET S = S + I
    40 NEXT I
    50 PRINT S
    60 END
}

@logo [name="logo67_square"] {
    REPEAT 4 [ FD 50 RT 90 ]
}

@forth [name="forth70_sqr"] {
    : SQR DUP * ;
    9 SQR .
}

@pascal [name="pascal70_sum"] {
    s := 0;
    for i := 1 to 10 do s := s + i;
    writeln(s);
}

@prolog [name="prolog72_kb"] {
    parent(kronos, zeus).
    parent(zeus, athena).
    ancestor(X, Y) :- parent(X, Y).
    ancestor(X, Z) :- parent(X, Y), parent(Y, Z).
    ?- ancestor(kronos, athena).
}

@c++ [name="cpp_braces_in_str", standard="c++17"] {
    #include <stdio.h>
    int main() {
        const char* msg = "braces { inside } string";
        printf("%s=%d\n", msg, 6 * 7);
        return 0;
    }
}

@g-code [name="cnc_toolpath"] {
    G21
    G90
    G0 X0 Y0 Z5
    G1 X30 Y40 Z0.2 E2.5 F1500
}

@verilog [name="half_adder_rtl"] {
    module half_adder(input a, input b, output sum, output carry);
        assign sum = a ^ b;
        assign carry = a & b;
    endmodule
}

@spice [name="divider_dc"] {
    * Voltage divider netlist
    V1 n1 0 DC 12
    R1 n1 n2 1000
    R2 n2 0 3000
    .END
}

@abc-music [name="concert_a4"] {
    X:1
    T:Concert Pitch Check
    Q:120
    K:C
    A2 C1
}

@postscript [name="ps_vector"] {
    10 20 moveto
    110 70 lineto
    stroke
}

@openqasm [name="bell_phi_plus"] {
    OPENQASM 3.0;
    qubit[2] q;
    h q[0];
    cx q[0], q[1];
}

@fasta [name="crispr_gene"] {
    >synthetic_orf_1
    ATGGCCCTGTGGATGCGCCTCCTGCCCCTGCTGGCGCTGCTGGCCCTCTGGGGACCTGACCCAGCCGCAGCCTTTTAA
}

@dna-dsd [name="strand_kinetics"] {
    species A = 1.0
    species B = 1.0
    reaction A + B -> C rate 0.8
    steps 50 dt 0.05
}

@smiles [name="aspirin_mol"] {
    CC(=O)Oc1ccccc1C(=O)O
}

@snn [name="lif_network"] {
    neuron N0 v_th=1.0 leak=0.9
    neuron N1 v_th=1.0 leak=0.9
    synapse N0 -> N1 weight=0.7
    stim N0 current=0.45
    run 16
}

@photonic [name="mzi_interferometer"] {
    modes 2
    inject 0 1.0
    bs 0 1 0.78539816339
    ps 0 1.57079632679
    bs 0 1 0.78539816339
}

@janus [name="reversible_bijection"] {
    init x = 5
    init y = 3
    x += y
    y += x
    x -= 2
}

@zk-r1cs [name="cubic_proof_mod97"] {
    {
        "prime": 97,
        "witness": [1, 3, 9, 27, 35],
        "constraints": [
            { "A": [[1, 1]], "B": [[1, 1]], "C": [[2, 1]] },
            { "A": [[2, 1]], "B": [[1, 1]], "C": [[3, 1]] },
            { "A": [[3, 1], [1, 1], [0, 5]], "B": [[0, 1]], "C": [[4, 1]] }
        ]
    }
}

@cellular [name="wolfram_rule110"] {
    rule 110 width 8 steps 4 init 00000001
}

print "=== PBLang v2.2.0 Omni-Polyglot Verification Suite ===";

// 1. Verify Universal Catalog Coverage (1945..2026, Programming + Non-Programming)
let summary = POLY.catalog_summary();
demand(summary.canonical_languages >= 120, "expected >= 120 canonical language families, got " + str(summary.canonical_languages));
demand(summary.total_identifiers_and_aliases >= 300, "expected >= 300 aliases/IDs");
demand(summary.programming_count >= 80, "programming count");
demand(summary.non_programming_count >= 25, "non-programming count");
demand(summary.native_in_engine_count >= 38, "native in-engine count");
demand(summary.year_span[0] == 1945 and summary.year_span[1] >= 2024, "timeline 1945..2024+");

demand(POLY.is_supported("plankalkul") and POLY.is_supported("plankalkuel"), "Plankalkul supported");
demand(POLY.is_supported("c++") and POLY.is_supported("c#") and POLY.is_supported("f#") and POLY.is_supported("q#"), "+/# tags supported");
demand(POLY.is_supported("g-code") and POLY.is_supported("openqasm3") and POLY.is_supported("zk-r1cs"), "non-prog & futuristic aliases");
demand(not POLY.is_supported("notalang_xyz"), "unknown language rejected");
demand(REG.lang_for_ext("rs") == "rust" and REG.lang_for_ext("py") == "python", "registry extension compatibility");
print "  [PASS] 1. Master timeline catalog (" + str(summary.canonical_languages) + " families / " + str(summary.total_identifiers_and_aliases) + " IDs, 1945.." + str(summary.year_span[1]) + ")";

// 2. Verify Era I–II Oldest & Classical Programming Languages
let pk = POLY.eval_block(__polyglot.by_name["zuse_sum10"], [10]);
demand(pk.ok and pk.executed_in_engine and pk.result == 55, "1945 Plankalkul sum(1..10) == 55, got " + str(pk.result));

let mhex = POLY.eval_native("machine_hex", "7F 45 4C 46 B8 2A 00 00 00 C3");
demand(mhex.ok and mhex.byte_count == 10 and mhex.detected_format == "ELF", "1947 Machine Hex inspector");

let dos16 = POLY.eval_native("asm_8086", "fn main() { print(6 * 7); }");
demand(dos16.ok and str_trim(dos16.stdout) == "42", "1978 8086 DOS .COM compile+emulate");

let z80 = POLY.eval_native("asm_z80", "fn main() { print(9 * 9); }");
demand(z80.ok and str_trim(z80.stdout) == "81", "1974 Z80 CP/M .COM compile+emulate");

let c64 = POLY.eval_native("asm_6502", "let a = 12;\nlet b = 30;\nprint a + b;\n");
demand(c64.ok and str_trim(c64.stdout) == "42", "1975 MOS 6502 C64 .PRG compile+emulate");

let ft = POLY.eval_block(__polyglot.by_name["fortran57_fact"]);
demand(ft.ok and str_trim(ft.stdout) == "120", "1957 FORTRAN 5! == 120, got " + ft.stdout);

let lp = POLY.eval_block(__polyglot.by_name["lisp58_fact"]);
demand(lp.ok and lp.result == 720, "1958 LISP (fact 6) == 720, got " + str(lp.result));

let cb = POLY.eval_block(__polyglot.by_name["cobol59_ledger"]);
demand(cb.ok and str_trim(cb.stdout) == "372", "1959 COBOL 12*25+72 == 372, got " + cb.stdout);

let ag = POLY.eval_block(__polyglot.by_name["algol60_sqsum"]);
demand(ag.ok and str_trim(ag.stdout) == "91", "1960 ALGOL-60 sum(i^2, 1..6) == 91, got " + ag.stdout);

let ap = POLY.eval_block(__polyglot.by_name["apl62_vec"]);
demand(ap.ok and ap.result == 30, "1962 APL +/ 2 * iota 5 == 30, got " + str(ap.result));

let bs = POLY.eval_block(__polyglot.by_name["basic64_loop"]);
demand(bs.ok and str_trim(bs.stdout) == "15", "1964 BASIC FOR..NEXT == 15, got " + bs.stdout);

let lg = POLY.eval_block(__polyglot.by_name["logo67_square"]);
demand(lg.ok and len(lg.segments) == 4 and num_abs(lg.final_x) < 0.01 and num_abs(lg.final_y) < 0.01, "1967 Logo closed square");

let fh = POLY.eval_block(__polyglot.by_name["forth70_sqr"]);
demand(fh.ok and str_trim(fh.stdout) == "81", "1970 Forth : SQR DUP * ; 9 SQR == 81, got " + fh.stdout);

let pa = POLY.eval_block(__polyglot.by_name["pascal70_sum"]);
demand(pa.ok and str_trim(pa.stdout) == "55", "1970 Pascal sum(1..10) == 55, got " + pa.stdout);

let pr = POLY.eval_block(__polyglot.by_name["prolog72_kb"]);
demand(pr.ok and len(pr.results) == 1 and pr.results[0].satisfiable == true, "1972 Prolog transitive Horn resolution");

let bf = POLY.eval_native("brainfuck", "++++++++[>+++++++++<-]>.+.!");
demand(bf.ok and str_starts_with(bf.stdout, "HI"), "1993 Brainfuck tape execution: " + bf.stdout);
print "  [PASS] 2. Oldest & Classical Programming Languages (Plankalkul, Hex, 8086, Z80, 6502, FORTRAN, LISP, COBOL, ALGOL-60, APL, BASIC, Logo, Forth, Pascal, Prolog, Brainfuck)";

// 3. Verify Era V Non-Programming Languages
let ym = POLY.eval_native("yaml", "service: pblang\nport: 8080\ntls: true\n");
demand(ym.ok and ym.value.service == "pblang" and ym.value.port == 8080 and ym.value.tls == true, "YAML parser");

let tm = POLY.eval_native("toml", "[package]\nname = \"demo\"\ncount = 4\n");
demand(tm.ok and tm.value.package.name == "demo" and tm.value.package.count == 4, "TOML parser");

let cv = POLY.eval_native("csv", "item,qty\ncpu,2\nnpu,4\n");
demand(cv.ok and cv.count == 2 and cv.rows[1].item == "npu", "CSV parser");

let md = POLY.eval_native("markdown", "# Omni Title\nHello **World**");
demand(md.ok and str_contains(md.html, "<h1>Omni Title</h1>") and str_contains(md.html, "<strong>World</strong>"), "Markdown -> HTML");

let lx = POLY.eval_native("latex", "\\alpha + \\beta \\le \\pi");
demand(lx.ok and str_contains(lx.rendered, "≤") and str_contains(lx.rendered, "π"), "LaTeX math Unicode");

let ps = POLY.eval_block(__polyglot.by_name["ps_vector"]);
demand(ps.ok and str_contains(ps.svg, "<svg") and str_contains(ps.svg, "M 10 20 L 110 70"), "PostScript -> SVG vector renderer");

let sq = POLY.eval_native("sql", "CREATE TABLE t(v INT); INSERT INTO t VALUES (10), (32); SELECT SUM(v) AS total FROM t;");
demand(sq.ok, "In-memory SQL execution");

let gc = POLY.eval_block(__polyglot.by_name["cnc_toolpath"]);
demand(gc.ok and gc.extruded_mm == 2.5 and gc.travel_mm > 50.0, "RS-274 G-code CNC/3D-printer kinematics");

let vg = POLY.eval_block(__polyglot.by_name["half_adder_rtl"]);
demand(vg.ok and len(vg.truth_table) == 4, "Verilog HDL gate truth-table synthesis");
demand(vg.truth_table[3].sum == 0 and vg.truth_table[3].carry == 1, "Verilog 1+1 -> sum=0, carry=1");

let sp = POLY.eval_block(__polyglot.by_name["divider_dc"]);
demand(sp.ok and sp.total_ohms == 4000 and num_abs(sp.node_voltages["n2"] - 9.0) < 0.001, "SPICE DC Kirchhoff solver (9.0V divider)");

let ab = POLY.eval_block(__polyglot.by_name["concert_a4"]);
demand(ab.ok and ab.note_count == 2 and num_abs(ab.notes[0].hz - 440.0) < 0.05, "ABC Music A4 == 440.0 Hz");
print "  [PASS] 3. Non-Programming Languages (YAML, TOML, CSV, Markdown, LaTeX, PostScript->SVG, SQL, RS-274 G-code, Verilog HDL, SPICE Analog, ABC Music)";

// 4. Verify Era VI Futuristic & Post-Classic Paradigms
let qm = POLY.eval_block(__polyglot.by_name["bell_phi_plus"]);
demand(qm.ok and num_abs(qm.probabilities["00"] - 0.5) < 0.001 and num_abs(qm.probabilities["11"] - 0.5) < 0.001, "OpenQASM 3.0 Bell |Phi+> statevector");

let dna = POLY.eval_block(__polyglot.by_name["crispr_gene"]);
demand(dna.ok and str_starts_with(dna.protein, "MALWMR") and len(dna.crispr_ngg_sites) >= 4, "FASTA/CRISPR proinsulin translation & SpCas9 NGG PAM finder");

let dsd = POLY.eval_block(__polyglot.by_name["strand_kinetics"]);
demand(dsd.ok and dsd.concentrations.C > 0.6 and dsd.concentrations.A < 0.4, "DNA Strand Displacement kinetics");

let smi = POLY.eval_block(__polyglot.by_name["aspirin_mol"]);
demand(smi.ok and smi.formula == "C9H8O4" and smi.rings >= 1 and num_abs(smi.molar_mass_g_mol - 180.159) < 0.05, "SMILES Aspirin C9H8O4 molar mass=" + str(smi.molar_mass_g_mol) + " formula=" + smi.formula);

let snn = POLY.eval_block(__polyglot.by_name["lif_network"]);
demand(snn.ok and snn.total_spikes >= 3, "Neuromorphic LIF Spiking Neural Network spikes=" + str(snn.total_spikes));

let pho = POLY.eval_block(__polyglot.by_name["mzi_interferometer"]);
demand(pho.ok and pho.unitary_conserved == true, "Photonic MZI optical waveguide mesh unitary conservation");

let jan = POLY.eval_block(__polyglot.by_name["reversible_bijection"]);
demand(jan.ok and jan.bijective_reversibility_verified == true and jan.bits_erased == 0 and jan.forward_state.x == 6 and jan.forward_state.y == 11, "Janus bijective time-reversible execution");

let zk = POLY.eval_block(__polyglot.by_name["cubic_proof_mod97"]);
demand(zk.ok and zk.satisfied == true and zk.constraint_count == 3, "Zero-Knowledge R1CS proof satisfied over F_97");
let zk_bad = POLY.eval_native("zk-r1cs", "{\"prime\":97,\"witness\":[1,3,9,27,36],\"constraints\":[{\"A\":[[3,1],[1,1],[0,5]],\"B\":[[0,1]],\"C\":[[4,1]]}]}");
demand(zk_bad.ok == false and zk_bad.satisfied == false, "Zero-Knowledge R1CS rejects forged witness");

let ca = POLY.eval_block(__polyglot.by_name["wolfram_rule110"]);
demand(ca.ok and len(ca.generations) == 5 and ca.generations[3] == "00001101" and ca.stdout == "00011111", "Wolfram Rule 110 cellular automaton: " + ca.stdout);
print "  [PASS] 4. Futuristic Paradigms (OpenQASM 3.0, FASTA/CRISPR, DNA-DSD, SMILES, Neuromorphic SNN, Photonic MZI, Reversible Janus, ZK-R1CS, Cellular Rule 110)";

// 5. Verify Fail-Closed Host Subprocess Contract + Extended @c++ Block Extraction & Compilation
let blocked = POLY.run_block("python", "print(1)", nil);
demand(not blocked.ok and not blocked.executed and blocked.unsafe_polyglot_required == true, "Host subprocess remains fail-closed without unsafe_polyglot");

let cpp_blk = __polyglot.by_name["cpp_braces_in_str"];
demand(cpp_blk.lang == "c++" and cpp_blk.attrs.standard == "c++17", "@c++ tag & attribute extraction");
let cpp_run = json_parse(polyglot_exec_compiled("c++", cpp_blk.code));
demand(cpp_run.success and str_trim(cpp_run.stdout) == "braces { inside } string=42", "@c++ string-brace block compiled & executed via g++: " + str(cpp_run));

let awk_raw = polyglot_exec_with_input("awk", "{ print $1 + $2 }", "19 23\n");
let awk_out = if str_starts_with(str_trim(str(awk_raw)), "{") { json_parse(awk_raw).stdout } else { str(awk_raw) };
demand(str_trim(awk_out) == "42", "Host AWK bridge stdin->stdout filter: " + str(awk_raw));
print "  [PASS] 5. Fail-closed host boundary + @c++ string-brace compile & AWK stdin filter verified";

print "ALL OMNI-POLYGLOT ERA CHECKS PASSED (1945 -> FUTURISTIC)";
