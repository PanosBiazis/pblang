// PBLang Sovereign Mathematics v2.7.0 — Universal Interactive Concept Cards,
// Symbolic 9D SI Algebra & Exact Buckingham Pi Verification Suite
// Verifies:
// 1. Unified MATH v2.7.0 catalog (25 macro-branches) & lazy cards() module
// 2. Symbolic 9D SI + Currency + Information Algebra ([L, M, T, I, Theta, N, J, EUR, BIT]),
//    130+ units, prefixes, affine degC/degF/K conversions, and incompatible-unit rejection
// 3. AST Dimensional Consistency & Independent Multi-Unit Rescaling Proof:
//    - Dimensionless Reynolds number Re = (rho * v * L) / mu (kg->g, m->cm, s->ms => invariant!)
//    - Kinetic Energy 0.5 * m * v^2 -> J ([L^2 M^1 T^-2], J->erg 10^-7 scaling)
//    - Simple Pendulum 2 * pi * sqrt(L / g) -> s ([T^1], fractional Q exponents!)
//    - Dimensional Violation Diagnostics: x + v*t + a*t ([L^1] vs [L^1 T^-1]) & sin(L)
// 4. Exact Rational Nullspace Buckingham Pi Solver:
//    - Fluid Drag (F_D, rho, v, D, mu) -> rank 3, 2 dimensionless Pi groups
//    - Simple Pendulum (T, L, m, g) -> rank 3, 1 Pi group with mass m dropping out!
// 5. Universal 10-Domain Interactive Concept Card Analyzer & SVG/BMP Dashboard Generator:
//    statistics, physics_si, linear_algebra, calculus, ode_control, equation_inequality,
//    multivariate_nd, geometry, finance, and function_1d (custom user functions)
// 6. 7-Tab Native gfx* Math Studio (Tab 7: Universal Cards & SI) & PBIDE CLI fast-paths

let MATH = import("stdlib:mathematics.sapp");
let PBIDE_PROD = import("stdlib:pbide_product.sapp");

let passed = 0;
fn check(cond, msg) {
    if not cond {
        throw "ASSERTION FAILED: " + msg;
    }
    passed = passed + 1;
}

fn approx(a, b, tol = 1e-6) {
    return num_abs((a * 1.0) - (b * 1.0)) <= tol;
}

print "=== PBLang v2.7.0 Universal Interactive Concept Cards, Symbolic SI & Buckingham Pi Suite ===";

// ── 0. Catalog & Module Version ───────────────────────────────────────────────
let cat = MATH.catalog();
check(cat.ok and cat.version == "2.7.0", "MATH.catalog() version == 2.7.0");
check(cat.categories_count == 29, "MATH.catalog() has 29 macro-branches");
check(MATH.cards().UCC_VERSION == "2.7.0", "UCC_VERSION == 2.7.0");
print "  [PASS] 0. Catalog v2.7.0 (29 macro-branches) & UCC_VERSION verified";

// ── 1. Symbolic 9D SI + Currency + Information Unit Parsing & Conversion ─────
let units_list = MATH.list_supported_units();
check(len(units_list) >= 130, "130+ supported SI/engineering/finance/info units");

let u_force = MATH.parse_unit("kg*m/s^2");
let u_newton = MATH.parse_unit("N");
check(u_force.ok and u_newton.ok and MATH.cards().dim_eq(u_force.dim, u_newton.dim), "kg*m/s^2 == N dimensionally");
check(u_newton.canonical_si_unit == "N" or str_contains(u_newton.named_quantity, "Force") or str_contains(u_newton.named_quantity, "Δύναμη"), "Newton recognized as Force");

let c_kmh = MATH.convert_si(36.0, "km/h", "m/s");
check(approx(c_kmh, 10.0, 1e-9), "36 km/h == 10 m/s");

let c_temp_k = MATH.convert_si(100.0, "degC", "K");
let c_temp_f = MATH.convert_si(100.0, "degC", "degF");
check(approx(c_temp_k, 373.15, 1e-9), "affine 100 degC == 373.15 K");
check(approx(c_temp_f, 212.0, 1e-9), "affine 100 degC == 212 degF");

let c_bad = MATH.convert_si_report(5.0, "kg", "m/s");
check(not c_bad.ok and str_contains(str(c_bad.error), "Incompatible"), "incompatible conversion kg -> m/s rejected cleanly");

let c_eur = MATH.convert_si(12.5, "EUR", "EUR_cent");
let c_mib = MATH.convert_si(1.0, "MiB", "bit");
check(approx(c_eur, 1250.0, 1e-9) and approx(c_mib, 8388608.0, 1e-6), "EUR -> cents and MiB -> bit conversions exact");
print "  [PASS] 1. Symbolic 9D SI + Currency + Information unit algebra & affine conversions";

// ── 2. Symbolic AST Dimensional Analysis & Multi-Unit Rescaling Proof ─────────
// 2a. Dimensionless Reynolds Number: Re = (rho * v * L) / mu
let dim_re = MATH.analyze_dimensions("(rho * v * L) / mu", map{
    rho: "kg/m^3",
    v: "m/s",
    L: "m",
    mu: "Pa*s"
}, map{
    m: "cm",
    kg: "g",
    s: "ms"
});
check(dim_re.ok and dim_re.consistent and dim_re.is_dimensionless, "Reynolds (rho*v*L)/mu is dimensionless [1]");
check(str_contains(dim_re.badge_el, "Αδιάστατο"), "Reynolds Greek badge says Αδιάστατο");
check(approx(dim_re.before_val, dim_re.after_val, 1e-9) and dim_re.is_numerically_unit_invariant == true, "Reynolds invariant under independent kg->g, m->cm, s->ms rescaling");

// 2b. Kinetic Energy: 0.5 * m * v^2 -> J ([L^2 M^1 T^-2])
let dim_ke = MATH.analyze_dimensions("0.5 * m * v^2", map{ m: "kg", v: "m/s" }, map{ m: "cm", kg: "g", s: "s" });
check(dim_ke.ok and dim_ke.consistent and not dim_ke.is_dimensionless, "Kinetic energy is unit-dependent");
check(dim_ke.si_unit == "J", "0.5 * m * v^2 canonical SI unit == J");
check(not dim_ke.is_numerically_unit_invariant and approx(dim_ke.theoretical_unit_multiplier, 1.0e-7, 1e-14), "Kinetic energy unit multiplier J -> erg == 1e-7");

// 2c. Simple Pendulum Period with Fractional Rational Q Exponents: 2 * pi * sqrt(L / g) -> s
let dim_pend = MATH.analyze_dimensions("2 * pi * sqrt(L / g)", map{ L: "m", g: "m/s^2" });
check(dim_pend.ok and dim_pend.consistent and dim_pend.si_unit == "s", "2*pi*sqrt(L/g) simplifies exact Q^(1/2) exponents to seconds [T^1]");

// 2d. Dimensional Violations: x + v*t + a*t and sin(L)
let dim_bad_sum = MATH.analyze_dimensions("x + v*t + a*t", map{ x: "m", v: "m/s", t: "s", a: "m/s^2" });
check(dim_bad_sum.ok and not dim_bad_sum.consistent and len(dim_bad_sum.violations) >= 1, "x + v*t + a*t catches [L] vs [L T^-1] mismatch");
let dim_bad_trig = MATH.analyze_dimensions("sin(L)", map{ L: "m" });
check(dim_bad_trig.ok and not dim_bad_trig.consistent and len(dim_bad_trig.violations) >= 1, "sin(L) catches non-dimensionless transcendental argument");
print "  [PASS] 2. Symbolic AST dimensional consistency, multi-unit rescaling proof & violation diagnostics";

// ── 3. Exact Rational Nullspace Buckingham Pi Solver ──────────────────────────
// 3a. Fluid Sphere Drag: F_D, rho, v, D, mu -> 5 vars, dimensional_rank 3 -> 2 Pi groups (Drag Coeff + Reynolds)
let b_drag = MATH.buckingham_pi([
    map{ name: "F_D", unit: "N" },
    map{ name: "rho", unit: "kg/m^3" },
    map{ name: "v", unit: "m/s" },
    map{ name: "D", unit: "m" },
    map{ name: "mu", unit: "Pa*s" }
]);
check(b_drag.ok and b_drag.num_variables == 5 and b_drag.dimensional_rank == 3 and b_drag.num_pi_groups == 2, "Fluid Drag has 5 vars, dimensional_rank 3, 2 Pi groups");
check(b_drag.pi_groups[0].verified_dimensionless and b_drag.pi_groups[1].verified_dimensionless, "Both Drag Pi groups verified dimensionless");

// 3b. Simple Pendulum: T, L, m, g -> mass m has unique [M^1] dimension and MUST drop out!
let b_pend = MATH.solve("buckingham(T:s, L:m, m:kg, g:m/s^2)");
check(b_pend.ok and b_pend.num_variables == 4 and b_pend.dimensional_rank == 3 and b_pend.num_pi_groups == 1, "Pendulum has 4 vars, dimensional_rank 3, 1 Pi group");
let m_dropped = false;
let di = 0;
while di < len(b_pend.dropped_variables) {
    if b_pend.dropped_variables[di] == "m" { m_dropped = true; }
    di = di + 1;
}
check(m_dropped and b_pend.pi_groups[0].exponents_map.m == 0, "Pendulum mass m drops out with exponent 0 by exact dimensional algebra");
print "  [PASS] 3. Exact Q Buckingham Pi solver (Fluid Drag 2 groups & Pendulum mass drop-out)";

// ── 4. All 10 Universal Mathematical Concept Card Domains + SVG & BMP ─────────
MATH.clear_functions();
MATH.define_function("my_hill(x) = x^2 / (1 + x^2)");

let domain_cases = [
    map{ expected: "statistics", input: [4.0, 7.0, 8.0, 9.0, 12.0], opts: nil },
    map{ expected: "physics_si", input: "(rho * v * L) / mu", opts: map{ units: map{ rho: "kg/m^3", v: "m/s", L: "m", mu: "Pa*s" } } },
    map{ expected: "linear_algebra", input: [[4.0, 1.0], [1.0, 3.0]], opts: nil },
    map{ expected: "calculus", input: "integrate(exp(-x^2), x)", opts: nil },
    map{ expected: "ode_control", input: "y'' + 2*y' + 5*y = 0", opts: nil },
    map{ expected: "equation_inequality", input: "(x^2 - 4)/(x - 1) <= 0", opts: nil },
    map{ expected: "multivariate_nd", input: "sin(sqrt(x^2 + y^2))", opts: map{ space: "3d" } },
    map{ expected: "geometry", input: "x^2/9 + y^2/4 = 1", opts: nil },
    map{ expected: "finance", input: map{ cashflows: [-1000.0, 400.0, 450.0, 500.0], rate: 0.08 }, opts: map{ domain: "finance" } },
    map{ expected: "function_1d", input: "my_hill(x)", opts: nil }
];

let ci = 0;
while ci < len(domain_cases) {
    let tc = domain_cases[ci];
    let det = MATH.detect_concept_domain(tc.input, tc.opts);
    check(det == tc.expected, "detect_concept_domain matched " + tc.expected + " (got " + str(det) + ")");
    let card = MATH.analyze_universal_concept(tc.input, tc.opts);
    check(card.ok and card.domain == tc.expected, "analyze_universal_concept ok for " + tc.expected);
    check(len(card.kpis) == 5, "5 KPIs generated for " + tc.expected);
    check(len(card.steps) == 4 and str_contains(card.steps[0].title_el, "Βήμα 1"), "4 Greek pedagogical Βήμα 1..4 cards for " + tc.expected);
    check(len(card.invariance.rows) >= 2, "Before vs After scale/unit invariance rows for " + tc.expected);

    let svg_str = MATH.render_universal_concept_card_svg(card, tc.opts);
    check(str_starts_with(svg_str, "<svg") and str_contains(svg_str, "</svg>"), "valid SVG rendered for " + tc.expected);
    check(str_contains(svg_str, "Βήμα 1") and str_contains(svg_str, "Βήμα 4"), "SVG contains Βήμα 1..4 for " + tc.expected);
    ci = ci + 1;
}

// Verify Light Mode, XSS Escaping, render_any_concept_svg & 24-bit BMP output
let xss_svg = MATH.render_universal_concept_card_svg("x^2 - 4 = 0", map{
    light_mode: true,
    title_el: "Δοκιμή <script>alert(1)</script> & Ασφάλεια"
});
check(not str_contains(xss_svg, "<script>") and str_contains(xss_svg, "&lt;script&gt;"), "XSS <script> safely escaped in Universal Concept Card SVG");
check(str_contains(xss_svg, "#F8FAFC"), "Alabaster Light palette applied in SVG");

let any_stat_svg = MATH.render_any_concept_svg([4.0, 7.0, 8.0, 9.0, 12.0]);
let any_phys_svg = MATH.render_any_concept_svg("0.5 * m * v^2", map{ units: map{ m: "kg", v: "m/s" } });
check(str_contains(any_stat_svg, "<svg") and str_contains(any_phys_svg, "<svg"), "render_any_concept_svg works seamlessly across statistics and SI physics");

let bmp_bytes = MATH.render_universal_concept_card_bmp([[4.0, 1.0], [1.0, 3.0]], 320, 220);
check(len(bmp_bytes) > 200000 and bmp_bytes[0] == 66 and bmp_bytes[1] == 77, "24-bit 'BM' BMP raster rendered for Linear Algebra concept card");

let solve_card = MATH.solve(map{ kind: "concept_card", input: "x^3 - 3*x", svg: true });
check(solve_card.ok and str_contains(solve_card.svg, "<svg"), "MATH.solve({ kind: 'concept_card', svg: true }) dispatches cleanly");
print "  [PASS] 4. All 10 Universal Concept Card domains + Light/Dark XSS-safe SVG + 24-bit BMP verified";

// ── 5. 8-Tab Native gfx* Math Studio & PBIDE Math Inspector Contract ──────────
let tabs = MATH.studio().math_studio_tabs();
check(len(tabs) == 8 and str_contains(tabs[6].label, "7.") and str_contains(tabs[7].label, "8."), "Native Math Studio upgraded to 8 tabs including Tab 7 & Tab 8");

let st_run = MATH.run_native_math_studio(map{
    virtual: true,
    cycle_tabs: true,
    max_frames: 8,
    max_ticks: 16
});
check(st_run.ok and st_run.rendered_frames == 8 and len(st_run.tabs_visited) == 8, "Virtual framebuffer rendered all 8 tabs cleanly");

let ide_contract = PBIDE_PROD.math_inspector_contract();
check(ide_contract.engine_version == "2.7.0" and ide_contract.studio_tabs == 8 and ide_contract.headless_cli_supported, "PBIDE math_inspector_contract v2.7.0 active");

let pb_bin = "pblang";
let env_bin = env_get("PBLANG_BIN");
if env_bin != nil and env_bin != "" and fs_exists(env_bin) { pb_bin = env_bin; }
elif fs_exists("./pblang.exe") { pb_bin = "./pblang.exe"; }
elif fs_exists("./pblang") { pb_bin = "./pblang"; }
let cli_si = proc_spawn_wait(pb_bin, ["run", "editors/ide/pbide.sapp", "--allow-all", "--", "--si-check", "(rho*v*L)/mu", "rho:kg/m^3,v:m/s,L:m,mu:Pa*s"]);
check(cli_si.exit_code == 0 and (str_contains(cli_si.stdout, "dimensionless") or str_contains(cli_si.stdout, "Αδιάστατο") or str_contains(cli_si.stdout, "true")), "pbide.sapp --si-check CLI fast-path verified");
print "  [PASS] 5. 8-Tab Native Math Studio & PBIDE --si-check CLI fast-path verified";

print "=== ALL UNIVERSAL CONCEPT CARDS, SYMBOLIC SI & BUCKINGHAM PI CHECKS PASSED (" + str(passed) + " assertions) ===";
