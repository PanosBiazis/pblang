// Pure PBLang parity comparator for native PBLang vs transpiled C replies
// (replaces tests/graphics/uno_r4_device_compare.py).

fn _script_args() {
    let raw = os_args();
    let out = [];
    let i = 0;
    let skip_self = true;
    while i < len(raw) {
        let a = raw[i];
        if a == "run" or a == "--allow-all" or str_starts_with(a, "--allow-") or str_starts_with(a, "--deny-") {
            i = i + 1;
        } elif a == "--" {
            i = i + 1;
            while i < len(raw) {
                array_push(out, raw[i]);
                i = i + 1;
            }
        } elif skip_self and str_ends_with(a, ".sapp") {
            skip_self = false;
            i = i + 1;
        } else {
            array_push(out, a);
            i = i + 1;
        }
    }
    return out;
}

fn _deep_eq(a, b) {
    if type(a) != type(b) { return false; }
    if type(a) == "map" {
        let ka = map_keys(a);
        let kb = map_keys(b);
        if len(ka) != len(kb) { return false; }
        let i = 0;
        while i < len(ka) {
            let k = ka[i];
            if not map_has(b, k) { return false; }
            if not _deep_eq(a[k], b[k]) { return false; }
            i = i + 1;
        }
        return true;
    }
    if type(a) == "array" {
        if len(a) != len(b) { return false; }
        let i = 0;
        while i < len(a) {
            if not _deep_eq(a[i], b[i]) { return false; }
            i = i + 1;
        }
        return true;
    }
    return a == b;
}

fn main() {
    let cli = _script_args();
    if len(cli) < 2 {
        error("usage: pblang run tests/graphics/uno_r4_device_compare.sapp --allow-all -- <c_responses.tsv> <oracle_responses.tsv>");
    }
    let c_map = map{};
    let c_lines = str_split(fs_read(cli[0]), "\n");
    let i = 0;
    while i < len(c_lines) {
        let line = c_lines[i];
        if str_ends_with(line, "\r") { line = str_slice(line, 0, len(line) - 1); }
        let tab = str_index_of(line, "\t");
        if tab >= 0 {
            let key = str_slice(line, 0, tab);
            let val = str_slice(line, tab + 1, len(line));
            c_map[key] = json_parse(val);
        }
        i = i + 1;
    }

    let count = 0;
    let o_lines = str_split(fs_read(cli[1]), "\n");
    i = 0;
    while i < len(o_lines) {
        let line = o_lines[i];
        if str_ends_with(line, "\r") { line = str_slice(line, 0, len(line) - 1); }
        let tab = str_index_of(line, "\t");
        if tab >= 0 {
            let key = str_slice(line, 0, tab);
            let val = str_slice(line, tab + 1, len(line));
            if not map_has(c_map, key) {
                error("missing key in C responses: " + key);
            }
            let parsed = json_parse(val);
            assert(_deep_eq(parsed, c_map[key]), "parity mismatch on key: " + key);
            count = count + 1;
        }
        i = i + 1;
    }
    assert(count == 10, "expected 10 parity replies, got " + str(count));
    print("uno_r4_device_native_c_parity_pass replies=" + str(count));
}

main();
