// Pure PBLang synthetic protocol record validator (replaces uno_r4_device_assert.py).
// Validates captured synthetic protocol records with zero device I/O.

fn _script_args() {
    let raw = os_args();
    let out = [];
    let i = 0;
    let skip_self = true;
    while i < len(raw) {
        let a = raw[i];
        if a == "run" or a == "--allow-all" or str_starts_with(a, "--allow-") or str_starts_with(a, "--deny-") {
            i = i + 1;
        } elif a == "--" {
            i = i + 1;
            while i < len(raw) {
                array_push(out, raw[i]);
                i = i + 1;
            }
        } elif skip_self and str_ends_with(a, ".sapp") {
            skip_self = false;
            i = i + 1;
        } else {
            array_push(out, a);
            i = i + 1;
        }
    }
    return out;
}

fn _last(records, label) {
    if not map_has(records, label) { error("missing protocol record label: " + label); }
    let arr = records[label];
    if len(arr) == 0 { error("empty protocol record list: " + label); }
    return arr[len(arr) - 1];
}

fn main() {
    let cli = _script_args();
    if len(cli) < 1 {
        error("usage: pblang run tests/graphics/uno_r4_device_assert.sapp --allow-all -- <responses.tsv>");
    }
    let text = fs_read(cli[0]);
    let lines = str_split(text, "\n");
    let records = map{};
    let total = 0;
    let label = "";
    let i = 0;
    while i < len(lines) {
        let line = lines[i];
        if str_ends_with(line, "\r") {
            line = str_slice(line, 0, len(line) - 1);
        }
        if len(str_trim(line)) > 0 {
            let raw = line;
            let tab = str_index_of(line, "\t");
            if tab >= 0 {
                label = str_slice(line, 0, tab);
                raw = str_slice(line, tab + 1, len(line));
            }
            let raw_with_nl = raw + "\n";
            assert(len(str_to_bytes(raw_with_nl)) <= 512, "reply under 512 bytes: " + label);
            let value = json_parse(raw);
            assert(len(map_keys(value)) == 13 and value["protocol"] == "PBLED1", "13 fields + PBLED1: " + label);
            assert(value["board"] == "UNO_R4_WIFI" and len(value["digest"]) == 64, "UNO_R4_WIFI + 64-hex digest: " + label);
            if not map_has(records, label) {
                records[label] = [];
            }
            array_push(records[label], value);
            total = total + 1;
        }
        i = i + 1;
    }

    assert(_last(records, "hello")["state"] == "idle", "hello idle");
    assert(_last(records, "play")["remaining_ms"] == 4000, "play remaining_ms");
    assert(_last(records, "frame2")["frame"] == 2 and _last(records, "frame2")["remaining_ms"] == 3000, "frame2");
    assert(_last(records, "duplicate")["remaining_ms"] == 3700, "duplicate remaining_ms");
    assert(_last(records, "reused")["error"] == "request-reused", "reused error");
    assert(_last(records, "prefix")["error"] == "command", "prefix error");

    let recover_labels = ["overflow", "partial", "floodstop"];
    let j = 0;
    while j < len(recover_labels) {
        let lbl = recover_labels[j];
        assert(records[lbl][0]["error"] == "input", lbl + " initial input error");
        assert(_last(records, lbl)["command"] == "STOP" and _last(records, lbl)["state"] == "idle", lbl + " recovery STOP");
        j = j + 1;
    }

    let bad_inputs = ["uppercase", "control"];
    j = 0;
    while j < len(bad_inputs) {
        let lbl2 = bad_inputs[j];
        assert(_last(records, lbl2)["error"] == "input", lbl2 + " input error");
        j = j + 1;
    }

    assert(_last(records, "wrapframe")["remaining_ms"] == 3000, "wrapframe remaining_ms");
    assert(_last(records, "wrapdone")["state"] == "done" and _last(records, "wrapdone")["frame"] == 0, "wrapdone");
    assert(_last(records, "backpressure_stop")["state"] == "idle", "backpressure_stop");
    assert(_last(records, "matrix_failure")["error"] == "matrix", "matrix_failure");
    assert(records["synchronize"][0]["error"] == "input", "synchronize initial input");
    assert(_last(records, "synchronize")["command"] == "HELLO" and _last(records, "synchronize")["ok"] == true, "synchronize HELLO");
    assert(_last(records, "write_retry")["command"] == "PLAY" and _last(records, "write_retry")["ok"] == true, "write_retry PLAY");

    print("uno_r4_device_protocol_pass records=" + str(total));
}

main();
