// ══════════════════════════════════════════════════════════════════════════════
// SECTION 7: Protected WASM32 Web-PWA & Mobile Android DEX/APK + iOS ARM64 Mach-O
// ══════════════════════════════════════════════════════════════════════════════

let pwa_src_path = tmp_dir + "/shield_canvas.sapp";
fs_write(pwa_src_path, "fn render_frame(t, mx, my, md) { gfxclear(10, 20, 30); gfxrect(2, 2, 12, 12, 80, 180, 250); return 1; }\n");

let pwa_prop_dir = tmp_dir + "/pwa_prop";
let pwa_prop = WASM_PWA.build_web_pwa(pwa_src_path, pwa_prop_dir, map{ width: 32, height: 32, temporal_weave: true });
check(pwa_prop.ok == true and pwa_prop.capture_shield == true, "build_web_pwa enables capture_shield by default");
let pwa_prop_html = fs_read(pwa_prop_dir + "/index.html");
check(str_contains(pwa_prop_html, "SEALED_WASM_B64") and not str_contains(pwa_prop_html, "FALLBACK_WASM_B64"), "shielded PWA XOR-seals inline WASM fallback");
check(str_contains(pwa_prop_html, "#pb-privacy-veil") and str_contains(pwa_prop_html, "@media print") and str_contains(pwa_prop_html, "__pbSetTemporalWeave"), "shielded PWA includes <4ms veil, @media print blocker, and 60Hz temporal weave");

let pwa_open_dir = tmp_dir + "/pwa_free";
let pwa_open = WASM_PWA.build_web_pwa(pwa_src_path, pwa_open_dir, map{ width: 32, height: 32, mode: "free" });
check(pwa_open.ok == true and pwa_open.capture_shield == false, "build_web_pwa mode='free' disables capture_shield");
let pwa_open_html = fs_read(pwa_open_dir + "/index.html");
check(str_contains(pwa_open_html, "FALLBACK_WASM_B64") and not str_contains(pwa_open_html, "SEALED_WASM_B64"), "free PWA emits unsealed open WASM fallback");

// Android Dalvik DEX + APK: default FLAG_SECURE (0x2000) vs free opt-out
let dex_sec = MOBILE.build_android_dex(map{ app_name: "VaultMob", package_name: "org.pblang.vaultmob" });
check(MOBILE.verify_android_dex(dex_sec).ok == true, "shielded Android DEX passes SHA-1 + Adler32 + header verification");
check(MOBILE.dex_has_flag_secure(dex_sec) == true, "default Android DEX embeds Window.setFlags(0x2000, 0x2000) FLAG_SECURE");
let apk_sec = MOBILE.build_android_apk(map{ app_name: "VaultMob", package_name: "org.pblang.vaultmob" }, nil);
check(MOBILE.verify_android_apk(apk_sec.apk_bytes).ok == true, "shielded Android APK passes ZIP + AXML + ARSC + DEX verification");

let dex_free = MOBILE.build_android_dex(map{ app_name: "OpenMob", package_name: "org.pblang.openmob", mode: "free" });
check(MOBILE.verify_android_dex(dex_free).ok == true and MOBILE.dex_has_flag_secure(dex_free) == false, "Android DEX mode='free' omits FLAG_SECURE cleanly");

// Apple iOS ARM64 Mach-O + .app bundle: default capture shield vs free opt-out
let ios_sec = MOBILE.build_ios_arm64_macho(map{ app_name: "VaultIOS", bundle_id: "org.pblang.vaultios" });
check(MOBILE.verify_ios_arm64_macho(ios_sec).ok == true, "shielded iOS ARM64 Mach-O passes structural verification");
check(MOBILE.ios_macho_has_capture_shield(ios_sec) == true, "default iOS ARM64 Mach-O embeds UIScreen/UITextField secure capture shield");
let ios_bun_sec = MOBILE.build_ios_app_bundle(map{ app_name: "VaultIOS", bundle_id: "org.pblang.vaultios" }, nil);
check(ios_bun_sec.capture_shield == true and str_contains(ios_bun_sec.info_plist, "PBLangCaptureShield"), "default iOS .app Info.plist declares PBLangCaptureShield");

let ios_free = MOBILE.build_ios_arm64_macho(map{ app_name: "OpenIOS", bundle_id: "org.pblang.openios", mode: "free" });
check(MOBILE.verify_ios_arm64_macho(ios_free).ok == true and MOBILE.ios_macho_has_capture_shield(ios_free) == false, "iOS ARM64 Mach-O mode='free' omits capture shield cleanly");

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 8: Native x86-64 AOT Symbol Stripping & `.rodata` String Sealing + `pbc` CLI
// ══════════════════════════════════════════════════════════════════════════════

let aot_secret_src = "
fn alpha_proprietary_kernel_v41(limit: i64) -> i64 {
    let i: i64 = 0;
    let acc: i64 = 0;
    while i < limit {
        acc = acc + i;
        i = i + 1;
    }
    return acc;
}

fn main() -> i64 {
    let tag = \"VAULT_TOKEN_998877_TOP_SECRET\";
    let total: i64 = alpha_proprietary_kernel_v41(50000000);
    println(tag + \"|\" + str(total));
    return 0;
}
";

let elf_rep = AOT_NAT.compile_aot_elf64(aot_secret_src);
check(elf_rep.ok == true and elf_rep.strip_symbols == true and elf_rep.obfuscate_strings == true, "compile_aot_elf64 strips symbols and XOR-seals .rodata strings by default");
check(not bytes_contains_ascii(elf_rep.binary, "alpha_proprietary_kernel_v41"), "ELF64 binary leaks ZERO internal function symbol names");
check(not bytes_contains_ascii(elf_rep.binary, "VAULT_TOKEN_998877_TOP_SECRET"), "ELF64 binary leaks ZERO plaintext string literals in .rodata");

let pe_rep = AOT_NAT.compile_aot_pe64(aot_secret_src);
check(pe_rep.ok == true and pe_rep.strip_symbols == true and pe_rep.obfuscate_strings == true, "compile_aot_pe64 strips symbols and XOR-seals .rodata strings by default");
check(not bytes_contains_ascii(pe_rep.binary, "alpha_proprietary_kernel_v41"), "Windows PE32+ binary leaks ZERO internal function symbol names");
check(not bytes_contains_ascii(pe_rep.binary, "VAULT_TOKEN_998877_TOP_SECRET"), "Windows PE32+ binary leaks ZERO plaintext string literals in .rodata");

// Live native x86-64 execution + speed verification of stripped & string-sealed AOT binary (PE32+ on Windows, ELF64 on Unix)
let is_win_host = str_contains(str_lower(pblang_bin), ".exe") or fs_exists("C:\\Windows\\System32\\kernel32.dll");
let aot_bin_path = if is_win_host { tmp_dir + "/aot_shield_bench.exe" } else { tmp_dir + "/aot_shield_bench" };
if is_win_host {
    fs_write_bytes(aot_bin_path, pe_rep.binary);
} else {
    fs_write_bytes(aot_bin_path, elf_rep.binary);
    let _chmod = proc_spawn_wait("chmod", ["+x", aot_bin_path]);
}
let t0_aot = now_ms();
let aot_run = proc_spawn_wait(aot_bin_path, []);
let elapsed_aot = now_ms() - t0_aot;
check(aot_run.exit_code == 0, "stripped + string-sealed native AOT binary executes with exit_code 0");
check(str_trim(aot_run.stdout) == "VAULT_TOKEN_998877_TOP_SECRET|1249999975000000", "runtime register unsealer recovers exact string + 50M loop sum");
check(elapsed_aot < 500, "native AOT 50M loop + string unseal runs at native speed (" + str(round(elapsed_aot * 100.0) / 100.0) + " ms)");

// Open-source AOT opt-out (`mode: "free"`) preserves plaintext strings & symbols
let elf_open = AOT_NAT.compile_aot_elf64(aot_secret_src, map{ mode: "free" });
check(elf_open.strip_symbols == false and elf_open.obfuscate_strings == false, "compile_aot_elf64 mode='free' disables stripping and string sealing");
check(bytes_contains_ascii(elf_open.binary, "VAULT_TOKEN_998877_TOP_SECRET"), "compile_aot_elf64 mode='free' preserves plaintext .rodata strings");

// End-to-End `tools/pbc.sapp` CLI flags (`--split-out`, `--obfuscate`, `--capture-shield`, `--no-capture-shield`, `--open-symbols`)
let cli_split_in = tmp_dir + "/cli_split_in.sapp";
let cli_split_client = tmp_dir + "/cli_client.sapp";
let cli_split_vault = tmp_dir + "/cli_vault.sapp";
fs_write(cli_split_in, split_input_src);
let pbc_split = proc_spawn_wait(pblang_bin, ["run", "tools/pbc.sapp", cli_split_in, "--out", cli_split_client, "--split-out", cli_split_vault]);
check(pbc_split.exit_code == 0 and fs_exists(cli_split_client) and fs_exists(cli_split_vault), "pbc --split-out emits client stub and server vault .sapp files");
check(not str_contains(fs_read(cli_split_client), "89173") and str_contains(fs_read(cli_split_vault), "89173"), "pbc --split-out keeps secret constant exclusively in server vault");

let cli_obf_out = tmp_dir + "/cli_obf_out.sapp";
let pbc_obf = proc_spawn_wait(pblang_bin, ["run", "tools/pbc.sapp", obf_run_path, "--obfuscate", "--out", cli_obf_out]);
check(pbc_obf.exit_code == 0 and fs_exists(cli_obf_out), "pbc --obfuscate emits obfuscated .sapp file");

let cli_dex_sec = tmp_dir + "/cli_sec.dex";
let cli_dex_open = tmp_dir + "/cli_open.dex";
let pbc_dex1 = proc_spawn_wait(pblang_bin, ["run", "tools/pbc.sapp", pwa_src_path, "--target", "android-dex", "--capture-shield", "--out", cli_dex_sec]);
let pbc_dex2 = proc_spawn_wait(pblang_bin, ["run", "tools/pbc.sapp", pwa_src_path, "--target", "android-dex", "--no-capture-shield", "--out", cli_dex_open]);
check(pbc_dex1.exit_code == 0 and MOBILE.dex_has_flag_secure(fs_read_bytes(cli_dex_sec)) == true, "pbc --target android-dex --capture-shield embeds FLAG_SECURE");
check(pbc_dex2.exit_code == 0 and MOBILE.dex_has_flag_secure(fs_read_bytes(cli_dex_open)) == false, "pbc --target android-dex --no-capture-shield omits FLAG_SECURE");

let cli_aot_in = tmp_dir + "/cli_aot_in.sapp";
let cli_aot_sec = tmp_dir + "/cli_aot_sec";
let cli_aot_open = tmp_dir + "/cli_aot_open";
fs_write(cli_aot_in, aot_secret_src);
let pbc_aot1 = proc_spawn_wait(pblang_bin, ["run", "tools/pbc.sapp", cli_aot_in, "--aot-native", "--out", cli_aot_sec]);
let pbc_aot2 = proc_spawn_wait(pblang_bin, ["run", "tools/pbc.sapp", cli_aot_in, "--aot-native", "--open-symbols", "--free", "--out", cli_aot_open]);
check(pbc_aot1.exit_code == 0 and not bytes_contains_ascii(fs_read_bytes(cli_aot_sec), "VAULT_TOKEN_998877_TOP_SECRET"), "pbc --aot-native seals strings & strips symbols by default");
check(pbc_aot2.exit_code == 0 and bytes_contains_ascii(fs_read_bytes(cli_aot_open), "VAULT_TOKEN_998877_TOP_SECRET"), "pbc --aot-native --open-symbols --free preserves open strings & symbols");

// Clean up all temporary test files and directories
let cleanup_files = [
    obf_mod_path, obf_run_path, sv_path, cl_path, split_test_runner,
    pwa_src_path,
    pwa_prop_dir + "/app.wasm", pwa_prop_dir + "/index.html", pwa_prop_dir + "/manifest.webmanifest", pwa_prop_dir + "/sw.js", pwa_prop_dir,
    pwa_open_dir + "/app.wasm", pwa_open_dir + "/index.html", pwa_open_dir + "/manifest.webmanifest", pwa_open_dir + "/sw.js", pwa_open_dir,
    aot_bin_path, cli_split_in, cli_split_client, cli_split_vault, cli_obf_out,
    cli_dex_sec, cli_dex_open, cli_aot_in, cli_aot_sec, cli_aot_open,
    tmp_dir
];
let ci = 0;
while ci < len(cleanup_files) {
    if fs_exists(cleanup_files[ci]) {
        fs_remove(cleanup_files[ci]);
    }
    ci = ci + 1;
}

print "ALL " + str(assert_count) + " V4.1 CLOSED-SHIELD / ANTI-SCRAPE / CAPTURE-VAULT / SPLIT-EXECUTION TESTS PASSED!";
