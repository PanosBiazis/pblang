// tests/v41_closed_shield_antiscrape_capture_test.sapp
// Comprehensive end-to-end verification suite for PBLang v4.1.0 Closed-Source IP Shield,
// Anti-REA, Anti-LLM, Anti-WebScraping, Anti-Capture Confidential Visual Vault & Split-Execution:
//   1. stdlib/security/closed_source_shield.sapp   (ChaCha20, LSB Canary, Temporal Weave, Zero-DOM Vault, AST Obfuscator, Split RPC)
//   2. stdlib/enterprise_ui_framework.sapp         (Component #69 ConfidentialReportVault, Web + Desktop Hardware Capture Affinity)
//   3. stdlib/native/wasm_web_pwa.sapp             (Sealed WASM32 Fallback, <4ms Privacy Veil, @media print Blocker, Temporal Weave)
//   4. stdlib/native/mobile_native_ios_android.sapp(Android Dalvik FLAG_SECURE 0x2000 + iOS ARM64 UIScreen/SecureLayer Capture Shield)
//   5. stdlib/native/aot_unboxed_native.sapp       (Default Symbol Stripping + Rolling-XOR .rodata String Unsealing on ELF64 & PE32+)
//   6. tools/pbc.sapp                              (--capture-shield, --no-capture-shield, --open-symbols, --obfuscate, --split-out)

let SHIELD = import("stdlib:security/closed_source_shield.sapp");
let UI = import("stdlib:enterprise_ui_framework.sapp");
let WASM_PWA = import("stdlib:native/wasm_web_pwa.sapp");
let MOBILE = import("stdlib:native/mobile_native_ios_android.sapp");
let AOT_NAT = import("stdlib:native/aot_unboxed_native.sapp");

let assert_count = 0;

fn check(cond, msg) {
    assert(cond, msg);
    assert_count = assert_count + 1;
}

fn bytes_contains_ascii(hay_bytes, needle_str) {
    let nb = str_to_bytes(needle_str);
    let nlen = len(nb);
    let hlen = len(hay_bytes);
    if nlen == 0 or hlen < nlen { return false; }
    let limit = hlen - nlen;
    let i = 0;
    while i <= limit {
        if hay_bytes[i] == nb[0] {
            let ok = true;
            let j = 1;
            while j < nlen {
                if hay_bytes[i + j] != nb[j] {
                    ok = false;
                    break;
                }
                j = j + 1;
            }
            if ok { return true; }
        }
        i = i + 1;
    }
    return false;
}

fn resolve_pblang_bin() {
    let env_bin = env_get("PBLANG_BIN");
    if env_bin != nil and len(str(env_bin)) > 0 and fs_exists(str(env_bin)) {
        return str(env_bin);
    }
    if fs_exists("./pblang") { return "./pblang"; }
    if fs_exists("./pblang.exe") { return "./pblang.exe"; }
    let home_dir = env_get("HOME");
    if home_dir != nil and len(str(home_dir)) > 0 {
        let local_bin = str(home_dir) + "/.local/bin/pblang";
        if fs_exists(local_bin) { return local_bin; }
    }
    if fs_exists("./target/release/pblang") { return "./target/release/pblang"; }
    return "pblang";
}

let pblang_bin = resolve_pblang_bin();
let tmp_dir = "./.tmp_v41_shield_suite_" + str(num_floor(now_ms()));
fs_mkdirs(tmp_dir);

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 1: Cryptographic Primitives & Protection Policy (`closed_source_shield.sapp`)
// ══════════════════════════════════════════════════════════════════════════════

check(SHIELD.SHIELD_VERSION == "4.1.0", "SHIELD_VERSION == 4.1.0");
check(SHIELD.CANARY_MAGIC == "PBCN", "CANARY_MAGIC == PBCN");
check(SHIELD.WIN32_WDA_EXCLUDEFROMCAPTURE == 17, "WIN32_WDA_EXCLUDEFROMCAPTURE == 0x11 (17)");
check(SHIELD.ANDROID_FLAG_SECURE == 8192, "ANDROID_FLAG_SECURE == 0x2000 (8192)");

// RFC 8439 Section 2.3.2 Test Vector: key = 00..1f, counter = 1, nonce = 000000090000004a00000000
let rfc_key = [];
let ki = 0;
while ki < 32 {
    array_push(rfc_key, ki);
    ki = ki + 1;
}
let rfc_nonce = [0, 0, 0, 9, 0, 0, 0, 74, 0, 0, 0, 0];
let rfc_blk = SHIELD.chacha20_block_bytes(rfc_key, 1, rfc_nonce);
check(len(rfc_blk) == 64, "RFC 8439 ChaCha20 block is 64 bytes");
check(rfc_blk[0] == 16 and rfc_blk[1] == 241 and rfc_blk[2] == 231 and rfc_blk[3] == 228, "RFC 8439 ChaCha20 word 0 == 10 f1 e7 e4");
check(rfc_blk[4] == 209 and rfc_blk[5] == 59 and rfc_blk[6] == 89 and rfc_blk[7] == 21, "RFC 8439 ChaCha20 word 1 == d1 3b 59 15");
check(rfc_blk[12] == 163 and rfc_blk[13] == 32 and rfc_blk[14] == 113 and rfc_blk[15] == 196, "RFC 8439 ChaCha20 word 3 == a3 20 71 c4");

// Multi-block (>64B) ChaCha20 stream encryption + decryption roundtrip
let secret_msg = "CONFIDENTIAL_ALGO_WEIGHTS=[0.918273, -1.442910, 3.1415926535, 42.00071]|ALL_RIGHTS_RESERVED_V41";
let msg_bytes = str_to_bytes(secret_msg);
let ctext = SHIELD.chacha20_xor_bytes(msg_bytes, rfc_key, rfc_nonce, 1);
check(len(ctext) == len(msg_bytes) and len(ctext) > 64, "ChaCha20 multi-block ciphertext length preserved");
check(not bytes_contains_ascii(ctext, "CONFIDENTIAL"), "ChaCha20 ciphertext hides plaintext header");
let ptext = SHIELD.chacha20_xor_bytes(ctext, rfc_key, rfc_nonce, 1);
check(bytes_to_str(ptext) == secret_msg, "ChaCha20 symmetric roundtrip exact match");

// CRC16-CCITT standard check ("123456789" -> 0x29B1 = 10673) & raw HMAC-SHA256
let crc_std = SHIELD.crc16_ccitt(str_to_bytes("123456789"));
check(crc_std == 10673, "CRC16-CCITT('123456789') == 0x29B1 (10673)");
let mac_a = SHIELD.hmac_sha256_raw(msg_bytes, "vault-key-alpha");
let mac_b = SHIELD.hmac_sha256_raw(msg_bytes, "vault-key-beta");
check(len(mac_a) == 32 and mac_a[0] != mac_b[0], "HMAC-SHA256 raw 32-byte key separation");

// Policy defaults: closed/proprietary by default vs explicit `mode: "free"`
let pol_def = SHIELD.create_protection_policy(nil);
check(pol_def.mode == "proprietary" and pol_def.open_source == false, "default policy is proprietary closed-source");
check(pol_def.rights_statement == "All Rights Reserved", "default policy enforces All Rights Reserved");
check(pol_def.prevent_screenshots == true and pol_def.obfuscate_binary == true and pol_def.strip_symbols == true, "default policy enables capture & binary shields");
check(pol_def.blur_SLA_ms == 4 and pol_def.os_affinity_targets.win32_display_affinity == 17 and pol_def.os_affinity_targets.android_window_flags == 8192, "default policy sets OS hardware capture flags");

let pol_free = SHIELD.create_protection_policy(map{ mode: "free" });
check(pol_free.mode == "free" and pol_free.open_source == true, "free policy sets open_source == true");
check(pol_free.prevent_screenshots == false and pol_free.obfuscate_binary == false and pol_free.strip_symbols == false, "free policy disables proprietary shields cleanly");

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 2: Invisible Forensic LSB Canary (`PSNR > 51 dB`) & 60Hz Temporal Weave
// ══════════════════════════════════════════════════════════════════════════════

let img_w = 48;
let img_h = 48;
let orig_rgba = [];
let py = 0;
while py < img_h {
    let px = 0;
    while px < img_w {
        array_push(orig_rgba, (px * 5 + 20) % 240);
        array_push(orig_rgba, (py * 4 + 30) % 240);
        array_push(orig_rgba, ((px + py) * 3 + 40) % 240);
        array_push(orig_rgba, 255);
        px = px + 1;
    }
    py = py + 1;
}

let canary_text = "viewer=exec_board_07|doc=Q4_TREASURY_VAULT|epoch_min=29911340";
let canary_key = "sovereign-forensic-key-v41";
let stego = SHIELD.embed_invisible_canary_rgba(orig_rgba, img_w, img_h, canary_text, canary_key);
check(stego.ok == true, "embed_invisible_canary_rgba ok");
check(stego.max_channel_delta <= 1, "LSB canary max_channel_delta <= 1 (imperceptible)");
check(stego.alpha_channels_modified == 0, "LSB canary leaves alpha channel 100% untouched");
check(stego.psnr_db > 51.0, "LSB canary PSNR > 51 dB lossless-look quality (" + str(stego.psnr_db) + " dB)");

let extracted = SHIELD.extract_invisible_canary_rgba(stego.rgba_bytes, img_w, img_h, canary_key);
check(extracted.ok == true and extracted.valid_magic == true and extracted.hmac_verified == true, "extract_invisible_canary_rgba cryptographic verification ok");
check(extracted.canary_payload == canary_text, "extract_invisible_canary_rgba exact payload recovery");

let wrong_key_ext = SHIELD.extract_invisible_canary_rgba(stego.rgba_bytes, img_w, img_h, "wrong-forensic-key");
check(wrong_key_ext.ok == false, "extract_invisible_canary_rgba rejects wrong key");

// Flip all RGB LSBs across buffer -> must fail magic/HMAC integrity check
let tampered_rgba = [];
let ti = 0;
while ti < len(stego.rgba_bytes) {
    if (ti % 4) < 3 {
        array_push(tampered_rgba, bit_xor(stego.rgba_bytes[ti], 1));
    } else {
        array_push(tampered_rgba, stego.rgba_bytes[ti]);
    }
    ti = ti + 1;
}
let tampered_ext = SHIELD.extract_invisible_canary_rgba(tampered_rgba, img_w, img_h, canary_key);
check(tampered_ext.ok == false, "extract_invisible_canary_rgba detects tampered LSB frame");

// 60/120Hz Temporal Sub-Frame Weave Talbot-Plateau Human Persistence-of-Vision Invariant
let weave = SHIELD.generate_temporal_subframe_pair(orig_rgba, img_w, img_h, 2);
check(len(weave.even_rgba) == len(orig_rgba) and len(weave.odd_rgba) == len(orig_rgba), "temporal subframe buffers match RGBA size");
let diff_subframes = 0;
let max_avg_err = 0.0;
let wi = 0;
while wi < len(orig_rgba) {
    if weave.even_rgba[wi] != weave.odd_rgba[wi] {
        diff_subframes = diff_subframes + 1;
    }
    let avg_v = (weave.even_rgba[wi] + weave.odd_rgba[wi]) / 2.0;
    let err_v = num_abs(avg_v - orig_rgba[wi]);
    if err_v > max_avg_err { max_avg_err = err_v; }
    wi = wi + 1;
}
check(diff_subframes > 1000, "temporal weave modulates individual camera-captured subframes");
check(max_avg_err == 0.0, "temporal weave preserves exact 0.0 time-averaged error for human vision");

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 3: Zero-DOM Encrypted `<canvas>` Confidential Report Vault
