// ══════════════════════════════════════════════════════════════════════════════
// SECTION 4: Pure-PBLang AST Source Obfuscator (`obfuscate_sapp_source`)
// ══════════════════════════════════════════════════════════════════════════════

let raw_algo_src = "
// TOP_SECRET_INTERNAL_COMMENT_DO_NOT_LEAK
fn compute_proprietary_alpha_signal(spot_px, vol_bps) {
    let secret_hurdle_rate = 137;
    let desk_tag = \"CONFIDENTIAL_DESK_FEE_V4\";
    return map{
        score: spot_px * 3 + vol_bps - secret_hurdle_rate,
        tag_len: len(desk_tag),
        badge: desk_tag
    };
}

fn compute_public_quote(x, y) {
    let r = compute_proprietary_alpha_signal(x, y);
    return str(r.score) + \"|\" + r.badge;
}

export compute_public_quote;
";

let obf = SHIELD.obfuscate_sapp_source(raw_algo_src);
check(obf.ok == true, "obfuscate_sapp_source ok");
check(obf.renamed_count >= 4 and obf.encrypted_strings >= 1, "obfuscator renames internal symbols and encrypts string literals");
check(not str_contains(obf.code, "TOP_SECRET_INTERNAL_COMMENT_DO_NOT_LEAK"), "obfuscator strips source comments");
check(not str_contains(obf.code, "compute_proprietary_alpha_signal"), "obfuscator renames internal function identifier");
check(not str_contains(obf.code, "secret_hurdle_rate"), "obfuscator renames internal local variable");
check(not str_contains(obf.code, "CONFIDENTIAL_DESK_FEE_V4"), "obfuscator rolling-XOR encrypts string literal");
check(str_contains(obf.code, "compute_public_quote"), "obfuscator preserves exported public API symbol");

let obf_mod_path = tmp_dir + "/obf_mod.sapp";
let obf_run_path = tmp_dir + "/obf_runner.sapp";
fs_write(obf_mod_path, obf.code);
fs_write(obf_run_path, "let M = import(\"./obf_mod.sapp\");\nprint M.compute_public_quote(100, 50);\n");
let obf_exec = proc_spawn_wait(pblang_bin, ["run", obf_run_path]);
check(obf_exec.exit_code == 0, "obfuscated .sapp module executes cleanly");
check(str_trim(obf_exec.stdout) == "213|CONFIDENTIAL_DESK_FEE_V4", "obfuscated .sapp module produces 100% identical runtime output");

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 5: Hybrid `@server_only` Split-Execution Compiler (`compile_split_application`)
// ══════════════════════════════════════════════════════════════════════════════

let split_input_src = "
@server_only
fn score_proprietary_credit_risk(income, debt, tier_bias) {
    let secret_weight = 89173;
    let golden_factor = 618;
    return (income * 4 - debt * 7) + secret_weight + tier_bias * golden_factor;
}

fn format_decision_banner(income, debt) {
    let sc = score_proprietary_credit_risk(income, debt, 5);
    return \"RISK_SCORE=\" + str(sc);
}

export score_proprietary_credit_risk, format_decision_banner;
";

let split_out = SHIELD.compile_split_application(split_input_src);
check(split_out.ok == true and split_out.server_function_count == 1, "compile_split_application extracted 1 @server_only function");
check(split_out.server_functions[0] == "score_proprietary_credit_risk", "compile_split_application identified score_proprietary_credit_risk");
check(not str_contains(split_out.client_stub_code, "89173") and not str_contains(split_out.client_stub_code, "secret_weight") and not str_contains(split_out.client_stub_code, "618"), "ZERO bytes of @server_only secret formula present in client_stub_code");
check(str_contains(split_out.server_vault_code, "89173") and str_contains(split_out.server_vault_code, "handle_vault_rpc"), "server_vault_code retains formula and HMAC RPC gate");

let sv_path = tmp_dir + "/server_vault.sapp";
let cl_path = tmp_dir + "/client_stub.sapp";
let split_test_runner = tmp_dir + "/split_rpc_verify.sapp";
fs_write(sv_path, split_out.server_vault_code);
fs_write(cl_path, split_out.client_stub_code);
fs_write(split_test_runner, "
let SV = import(\"./server_vault.sapp\");
let CL = import(\"./client_stub.sapp\");
let shared_key = \"vault-rpc-hmac-secret-2026\";
CL.configure_vault_rpc(fn(req_json) {
    return SV.handle_vault_rpc(req_json, shared_key);
}, shared_key);
let banner = CL.format_decision_banner(1000, 200);
// Expected: (1000*4 - 200*7) + 89173 + 5*618 = 2600 + 89173 + 3090 = 94863
assert(banner == \"RISK_SCORE=94863\", \"authenticated split RPC result mismatch: \" + banner);

// 1. Tampered HMAC check -> 401
let valid_req = CL.build_signed_vault_request(\"score_proprietary_credit_risk\", [1000, 200, 5], \"wrong-attacker-secret\", \"nonce_tamper_1\", 1700001);
let r_tamper = json_parse(SV.handle_vault_rpc(valid_req, shared_key));
assert(r_tamper.ok == false and r_tamper.code == 401, \"tampered HMAC must return 401\");

// 2. Replay attack check -> first succeeds, second with identical nonce returns 403
let replay_req = CL.build_signed_vault_request(\"score_proprietary_credit_risk\", [500, 100, 2], shared_key, \"nonce_fixed_99\", 1700002);
let r_first = json_parse(SV.handle_vault_rpc(replay_req, shared_key));
let r_second = json_parse(SV.handle_vault_rpc(replay_req, shared_key));
assert(r_first.ok == true and r_first.result == 91709, \"first signed request succeeds\");
assert(r_second.ok == false and r_second.code == 403, \"replayed nonce must return 403\");
print \"SPLIT_RPC_ALL_OK\";
");
let split_exec = proc_spawn_wait(pblang_bin, ["run", split_test_runner]);
check(split_exec.exit_code == 0 and str_trim(split_exec.stdout) == "SPLIT_RPC_ALL_OK", "live client<->server split-execution HMAC + 401 tamper + 403 anti-replay verified");

