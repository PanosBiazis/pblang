// for ALL 24 Sovereign Pure-PBLang (.sapp) Pillars & Minimal VM Microkernel of PBLang v5.0.0.

let SSA   = import("stdlib:compiler/ssa_simd_stage4_selfhost.sapp");
let TLS   = import("stdlib:net/zero_openssl_tls13_pqc_quic.sapp");
let GPU   = import("stdlib:ai/gpu_spirv_wgsl_ptx_npu_compiler.sapp");
let CT    = import("stdlib:security/ct_zeroize_stdlib_index.sapp");
let UI    = import("stdlib:ui/opentype_wayland_a11y_signals.sapp");
let COMP  = import("stdlib:compression/deflate_gzip_zstd_lz4_archive.sapp");
let UNI   = import("stdlib:text/unicode16_greek_sovereign.sapp");
let RE    = import("stdlib:text/pikevm_linear_regex.sapp");
let FIB   = import("stdlib:concurrency/green_fibers_doh_sandbox.sapp");
let DEL   = import("stdlib:polyglot/delphi_dotnet_com_bridge.sapp");
let PBDB  = import("stdlib:db/pbdb_sovereign_acid_engine.sapp");
let MEDIA = import("stdlib:desktop_media/audio_image_pdfa3_engine.sapp");
let DBG   = import("stdlib:devtools/debugger_timetravel_dap.sapp");
let DIAG  = import("stdlib:compiler/rich_diagnostics_bilingual.sapp");
let REPL  = import("stdlib:devtools/repl_and_ast_formatter.sapp");
let PKG   = import("stdlib:devtools/pkg_init_bench_sbom.sapp");
let HW    = import("stdlib:sys/hardware_serial_bus_hsm.sapp");
let BND   = import("stdlib:compiler/hermetic_cross_bundler.sapp");
let VMLAB = import("tools/vm_lab_hosted_report.sapp");

let passed = 0;

fn check(cond, msg) {
    if not cond {
        throw "V5.0.0 PILLAR ASSERTION FAILED: " + str(msg);
    }
    passed = passed + 1;
}

println("=== PBLang v5.0.0 Sovereign 24-Pillar Pure-PBLang Suite ===");

// ── Pillar #1: Exact 64-Bit Integer Tag (VAL_I64, 9007199254740993i64, Bitwise, Indexing) ──
let big_a = 9007199254740992i64 + 1i64;
let big_b = 9007199254740992i64 + 2i64;
check(is_i64(big_a) and is_i64(big_b), "#1 VAL_I64 predicate");
check(big_a != big_b, "#1 exact 2^53+1 != 2^53+2 without IEEE-754 rounding");
check(str(big_a) == "9007199254740993" and str(big_b - big_a) == "1", "#1 exact i64 decimal formatting & subtraction");
check(bit_xor(0x123456789ABCDEF0i64, 0x0F0F0F0F0F0F0F0Fi64) == 0x1D3B597795B3D1FFi64, "#1 64-bit bitwise XOR");
let arr_i64 = [10, 20, 30, 40];
check(arr_i64[2i64] == 30, "#1 array indexing with VAL_I64");
println("  [PASS] #1 Exact 64-Bit VAL_I64 Arithmetic, Bitwise & Indexing");

// ── Pillar #2: 64 KiB OS-Page Slab Reclamation, @region Arenas & Short-String Interning ──
let before_intern = intern_stats();
check(before_intern.intern_cap == 1024, "#2 1024-slot short-string intern table active");
@region {
    let scratch = [];
    let ri = 0;
    while ri < 64 {
        array_push(scratch, "k_" + str(ri));
        ri = ri + 1;
    }
    check(len(scratch) == 64, "#2 @region lexical block allocation");
}
let reclaim_res = gc_reclaim_os_pages();
check(type(reclaim_res) == "map" or is_number(reclaim_res), "#2 gc_reclaim_os_pages executes cleanly");
println("  [PASS] #2 64 KiB OS-Page Slab Reclamation, @region Arenas & Interning");

// ── Pillar #3: Cooperative M:N Green Fibers, Work-Stealing Deques & Async Mux ──
let mux_info = async_mux_backend();
check(len(str(mux_info.active_backend)) > 0, "#3 OS async multiplexer backend probe");
let sched = FIB.fiber_scheduler_new(4);
let fch = FIB.fiber_chan_new(256, sched);
let fi = 0;
while fi < 120 {
    FIB.fiber_spawn_task(sched, fn(ctx) {
        let st = ctx.state;
        if st.phase == 0 {
            return FIB.fiber_yield_step(map{ phase: 1, v: st.v * 2 }, 0);
        }
        FIB.fiber_chan_send(fch, st.v);
        return st.v;
    }, map{ phase: 0, v: fi + 1 });
    fi = fi + 1;
}
let fib_run = FIB.fiber_run_until_complete(sched, 50000);
let fib_done = if map_has(fib_run, "completed_count") { fib_run.completed_count } else { sched.completed_count };
check(fib_done >= 120, "#3 120 cooperative green fibers completed across 4 workers");
let recv1 = FIB.fiber_chan_recv(fch);
check(recv1.ok and recv1.value >= 2, "#3 fiber channel message delivery");
println("  [PASS] #3 Cooperative M:N Green Fibers, Work-Stealing Deques & Channels");

// ── Pillar #4: Stage-4 SSA IR (SCCP/CSE/LICM/BCE/SROA), SIMD Vectorizer, RISC-V 64 & DWARF v5 ──
let s4_src = "fn compute() { let a = 6 * 7; let b = a + 8; return b; }";
let s4_ast = SSA.parse_stage4_program(s4_src);
let s4_ir  = SSA.build_ssa_ir(s4_ast);
let s4_opt = SSA.optimize_ssa_ir(s4_ir);
check(s4_opt.ok, "#4 SSA multi-pass optimizer (SCCP + CSE + LICM + SROA)");
let vec_avx = SSA.auto_vectorize_loop(map{ kernel: "add_f64", a: [1.0, 2.0], b: [3.0, 4.0] }, "avx512f");
let vec_neon = SSA.auto_vectorize_loop(map{ kernel: "fma_f64", a: [2.0, 3.0], b: [4.0, 5.0], d: [1.0, 1.0] }, "neon");
check(vec_avx.ok and vec_avx.lanes == 8 and vec_neon.ok and vec_neon.lanes == 2, "#4 AVX-512 & ARM64 NEON loop vectorizer");
let dwarf_res = SSA.build_dwarf_v5_debug_line("demo.sapp", [map{ address: 0x1000, line: 1, column: 1 }, map{ address: 0x1010, line: 4, column: 5 }]);
let dwarf_parsed = SSA.parse_dwarf_v5_debug_line(dwarf_res.bytes);
check(dwarf_parsed.ok and dwarf_parsed.version == 5, "#4 DWARF v5 .debug_line encode & decode");
let rv_elf = SSA.compile_riscv64_elf(s4_opt.ir);
check(rv_elf.ok and rv_elf.e_machine == 243, "#4 RISC-V 64 (EM_RISCV=243) native ELF64 emitter");
let rv_sim = SSA.simulate_riscv64_elf(rv_elf.elf_bytes);
check(rv_sim.ok and rv_sim.exit_code == 50, "#4 RISC-V 64 ELF64 execution returns 50");
let s4_x64 = SSA.compile_stage4_selfhost_bundle("fn main() { return 42; }", "x86_64");
check(s4_x64.ok and not s4_x64.external_toolchain and s4_x64.expected_exit == 42, "#4 Stage-4 Zero-C self-hosting bundle");
println("  [PASS] #4 Stage-4 SSA Optimizer, AVX-512/NEON Vectorizer, DWARF v5 & RISC-V 64");

// ── Pillar #5: Zero-OpenSSL Constant-Time TLS 1.3, Hybrid PQC X25519MLKEM768 & QUIC ──
let hs = TLS.run_tls13_pqc_handshake("db.pblang.example");
check(hs.ok and hs.group == TLS.GROUP_X25519_MLKEM768 and hs.negotiated_version == 0x0304 and is_map(hs.keys), "#5 TLS 1.3 hybrid X25519MLKEM768 handshake");
let app_msg = str_to_bytes("SELECT 1;");
let enc_rec = TLS.tls13_send_app_data(hs, true, app_msg);
let dec_rec = TLS.tls13_recv_app_data(hs, true, enc_rec, 0);
check(dec_rec.ok and bytes_to_str(dec_rec.plaintext) == "SELECT 1;", "#5 TLS 1.3 record AEAD round-trip");
let q_keys = TLS.quic_derive_initial_secrets([0x83, 0x94, 0xc8, 0xf0, 0x3e, 0x51, 0x57, 0x08]);
let q_pkt = TLS.quic_protect_packet(q_keys.client, [0xC1, 0x00, 0x00, 0x00, 0x01], 1, 2, str_to_bytes("QUIC_PING_V5"));
let q_open = TLS.quic_unprotect_packet(q_keys.client, q_pkt.packet, q_pkt.pn_offset);
check(q_open.ok and bytes_to_str(q_open.payload) == "QUIC_PING_V5", "#5 RFC 9001 QUIC Initial packet protection");
let pg_tls = TLS.postgres_tls13_scram_plus_handshake("app_user", "synth_pw_v5");
check(pg_tls.ok and len(pg_tls.ssl_request_bytes) == 8, "#5 PostgreSQL SSLRequest + TLS 1.3 channel binding");
println("  [PASS] #5 Zero-OpenSSL TLS 1.3 + Hybrid PQC X25519MLKEM768 + QUIC + DB TLS");

// ── Pillar #6: Unified @gpu Compiler (Vulkan SPIR-V 1.5, WebGPU WGSL, CUDA PTX 8.0) & INT4/FP8 FlashAttention-3 ──
let gpu_lib = GPU.standard_gpu_kernel_library();
let gpu_compiled = GPU.compile_gpu_kernel(gpu_lib.saxpy);
check(gpu_compiled.ok and GPU.validate_spirv_binary(gpu_compiled.spirv_bytes).ok, "#6 Vulkan SPIR-V 1.5 binary validation");
check(str_contains(gpu_compiled.wgsl, "@compute") and str_contains(gpu_compiled.ptx, ".version 8.0"), "#6 WebGPU WGSL & CUDA PTX 8.0 emission");
let q4 = GPU.quantize_int4_grouped([0.5, -0.25, 1.0, -1.0, 0.125, 0.75, -0.5, 0.0], 8);
let dq4 = GPU.dequantize_int4_grouped(q4);
check(len(dq4) == 8, "#6 grouped INT4 quantization round-trip");
let fa_q = [1.0, 0.0, 0.0, 1.0];
let fa_out = GPU.flash_attention3_tiled_online_softmax(fa_q, fa_q, [2.0, 4.0, 6.0, 8.0], 2, 2);
check(len(fa_out.output) == 4, "#6 tiled FlashAttention-3 online softmax");
println("  [PASS] #6 Unified @gpu SPIR-V/WGSL/PTX Compiler & INT4/FP8 FlashAttention-3");

// ── Pillar #7: @constant_time / @zeroize Verifier & < 0.2 ms PBIDXv01 Stdlib Indexer ──
let bad_ct = CT.audit_constant_time_and_zeroize("@constant_time fn leak(@secret secret_k) { if secret_k == 1 { return 10; } return 20; }");
let good_ct = CT.audit_constant_time_and_zeroize("@constant_time fn safe_op(@secret secret_k) { @zeroize let buf = [1, 2]; zeroize_buf(buf); return bit_xor(secret_k, 3); }");
check(not bad_ct.ok and bad_ct.violation_count >= 1 and good_ct.ok, "#7 @constant_time rejects secret branch & accepts branchless @zeroize");
let pbidx = CT.build_stdlib_pbidx("stdlib/security");
let q_hit = CT.query_stdlib_symbol(pbidx, "audit_constant_time_and_zeroize");
check(q_hit.count >= 1, "#7 PBIDXv01 binary stdlib index query");
println("  [PASS] #7 @constant_time/@zeroize Verifier & Sub-Millisecond PBIDXv01 Indexer");

// ── Pillar #8: OpenType GSUB/GPOS Shaping, SDF Atlas, Wayland Wire, AT-SPI2/UIA & Reactive Signals ──
let otf_bytes = UI.build_minimal_opentype_bytes();
let otf_parsed = UI.parse_opentype_sfnt(otf_bytes);
let shaped = UI.shape_opentype_text("Καλημέρα fi", map{ font_bytes: otf_bytes });
check(otf_parsed.ok and shaped.ok and len(shaped.glyphs) > 0, "#8 OpenType SFNT & GSUB/GPOS Greek+ligature shaping");
let sig_x = UI.create_signal(5);
let sig_dbl = UI.create_computed(fn() { return sig_x.get() * 3; });
sig_x.set(9);
check(sig_dbl.get() == 27, "#8 fine-grained reactive signal & computed graph");
let a11y = UI.build_a11y_tree(map{ role: "window", name: "Κύριο Παράθυρο", children: [map{ role: "button", name: "Αποθήκευση" }] });
let atspi_res = UI.export_atspi2_dbus_introspection(a11y);
check(atspi_res.ok and str_contains(atspi_res.xml, "org.a11y.atspi") and UI.export_win32_uia_tree(a11y).ok, "#8 AT-SPI2 D-Bus & Win32 UIA accessibility trees");
println("  [PASS] #8 OpenType Shaping, Reactive Signals & AT-SPI2 / Win32 UIA Accessibility");

// ── Pillar #9: CSPRNG-Keyed SipHash-1-3 Anti-HashDoS Maps & Adversarial Collision Immunity ──
let adv_map = map{};
let mi = 0;
while mi < 500 {
    adv_map["collision_probe_" + str(mi * 1099511628211i64)] = mi;
    mi = mi + 1;
}
check(len(map_keys(adv_map)) == 500 and adv_map["collision_probe_0"] == 0, "#9 CSPRNG SipHash-1-3 map resists adversarial FNV collisions");
println("  [PASS] #9 CSPRNG-Seeded SipHash-1-3 Anti-HashDoS Hash Maps");

// ── Pillar #10: Linear-Time O(M*N) Zero-ReDoS Thompson NFA / PikeVM Regex Engine ──
let redos_t0 = now_ms();
let redos_match = RE.pikevm_is_match("(a+)+b", str_repeat("a", 1500) + "!");
let redos_dt = now_ms() - redos_t0;
check(redos_match == false and redos_dt < 250, "#10 PikeVM handles pathological (a+)+b x 1500 without exponential backtracking");
let gr_hits = RE.pikevm_find_all("\\p{Greek}+", "Hello Αθήνα 2026 Θεσσαλονίκη!");
check(len(gr_hits) == 2 and gr_hits[0].text == "Αθήνα" and gr_hits[1].text == "Θεσσαλονίκη", "#10 PikeVM \\p{Greek} Unicode property matching");
println("  [PASS] #10 Linear-Time O(M*N) Zero-ReDoS PikeVM Regex (\\p{Greek} + Anti-ReDoS)");

// ── Pillar #11: Unprivileged OS Sandbox (Landlock / Seccomp-BPF / JobObject) ──
let sb_os = sandbox_lock_os(map{ dry_run: true });
check(len(str(sb_os.backend)) > 0, "#11 OS sandbox dry-run capability probe");
let sb_pol = FIB.create_sandbox_policy(map{ allow_read: ["/usr", "/lib"], allow_write: ["/tmp/work"], allow_net_tcp: false });
let ll_rules = FIB.compile_landlock_rules(sb_pol);
let bpf_prog = FIB.compile_seccomp_bpf_filter(sb_pol);
check(ll_rules.ok and bpf_prog.ok and len(bpf_prog.instructions) >= 4, "#11 Landlock & Seccomp-BPF policy compilation");
check(not FIB.verify_path_against_sandbox(sb_pol, "/tmp/work/../../etc/shadow", "read").allowed, "#11 Sandbox blocks ../ traversal");
println("  [PASS] #11 Unprivileged Landlock / Seccomp-BPF / JobObject Sandbox Compiler");

// ── Pillar #12: RFC 8484 Binary DNS-over-HTTPS (DoH), IPv6 & AF_UNIX / Framed IPC ──
let dns_q = FIB.encode_dns_wire_query("pblang.org", "AAAA", 0x4242);
check(len(dns_q) > 16, "#12 RFC 1035/8484 DNS wire query encoding");
let v6 = FIB.parse_ipv6_literal("[2001:db8::ff00:42:8329]:8443");
check(v6.ok and v6.port == 8443, "#12 Compressed IPv6 + port literal parser");
let ipc_f = FIB.encode_ipc_frame(7, str_to_bytes("sovereign-ipc"), 99);
let ipc_d = FIB.decode_ipc_frame(ipc_f);
check(ipc_d.ok and ipc_d.seq_id == 99 and bytes_to_str(ipc_d.payload) == "sovereign-ipc", "#12 CRC32-verified PBIP IPC framing");
if platform() == "linux" {
    let sock_p = "/tmp/pblang_v50_u_" + str(bit_or(now_ms(), 0i64)) + ".sock";
    try fs_remove(sock_p) catch nil;
    let srv = unix_listen(sock_p);
    let cli = unix_connect(sock_p);
    let acc = tcp_accept(srv);
    let cred = unix_peer_cred(acc);
    tcp_write(cli, "PING_UNIX");
    let got_u = tcp_read(acc, 9);
    tcp_close(cli);
    tcp_close(acc);
    tcp_close(srv);
    try fs_remove(sock_p) catch nil;
    check(got_u == "PING_UNIX" and cred.pid > 0, "#12 Live Linux AF_UNIX socket + SO_PEERCRED");
}
println("  [PASS] #12 RFC 8484 Binary DoH Wire Codec, IPv6 & AF_UNIX IPC");

// ── Pillar #13: Full Unicode Filesystem Paths (Greek / CJK / Emoji) on Linux & Windows UTF-16LE ──
let uni_dir = ".tmp_v50_unicode_Δοκιμή_Αθήνα_" + str(bit_or(now_ms(), 0i64));
fs_mkdirs(uni_dir);
let uni_file = uni_dir + "/αρχείο_Ελλάδα.txt";
fs_write(uni_file, "Πλήρης υποστήριξη UTF-8 / UTF-16LE!");
let uni_read = fs_read(uni_file);
let uni_list = fs_listdir(uni_dir);
fs_remove(uni_file);
fs_remove(uni_dir);
check(uni_read == "Πλήρης υποστήριξη UTF-8 / UTF-16LE!" and len(uni_list) == 1, "#13 Greek Unicode filesystem path I/O & listdir");
println("  [PASS] #13 Full Unicode Filesystem Paths (UTF-8 & Win32 Wide UTF-16LE)");

// ── Pillar #14: Unicode 16.0 NFC/NFD/NFKC, UAX #29 Graphemes, Sovereign Greek & UTS #39 Audit ──
check(str_lower("ΟΔΥΣΣΕΑΣ ΣΤΗΝ ΑΘΗΝΑ") == "οδυσσεας στην αθηνα", "#14 VM str_lower Greek word-final Sigma");
check(UNI.greek_to_lower("ΟΔΥΣΣΕΑΣ ΣΤΗΝ ΑΘΗΝΑ") == "οδυσσεας στην αθηνα", "#14 Pure Greek word-final Sigma");
check(UNI.greek_to_upper_tonos_free("Αθήνα Μαΐου") == "ΑΘΗΝΑ ΜΑΪΟΥ", "#14 Greek uppercase tonos-stripping with hiatus dialytika");
check(UNI.greek_strip_accents("ἀνθρώπῳ") == "ανθρωπω", "#14 Greek polytonic accent & breathing stripper");
check(UNI.unicode_normalize_pure("α\u0301", "NFC") == "ά", "#14 Unicode 16.0 NFC canonical composition");
check(UNI.unicode_grapheme_count("🇬🇷👨‍👩‍👧ά") == 3, "#14 UAX #29 grapheme clusters (flag + ZWJ family + Greek)");
let spoof = UNI.audit_unicode_security("p\u0430ypal.com");
check(not spoof.safe and spoof.has_mixed_script_homoglyph, "#14 UTS #39 Cyrillic/Latin homoglyph spoof detection");
println("  [PASS] #14 Unicode 16.0 Normalization, UAX #29, Sovereign Greek & UTS #39 Security");

// ── Pillar #15: First-Class OBJ_PTR FFI + Corporate Delphi / Object Pascal / .NET / COM Bridge ──
let ptr_h = ffi_ptr_new(32, "DelphiRecord");
check(type(ptr_h) == "ptr" and not ffi_ptr_is_null(ptr_h) and ffi_ptr_addr(ptr_h) > 0, "#15a OBJ_PTR typed pointer handle");
let dus = DEL.build_delphi_unicode_string_record("Καλημέρα Enterprise/PBLang");
let dus_back = DEL.parse_delphi_unicode_string_record(dus.bytes);
check(dus_back.ok and dus_back.text == "Καλημέρα Enterprise/PBLang", "#15b Delphi UnicodeString UTF-16LE header & payload round-trip");
let cy_b = DEL.encode_delphi_currency(1234.5678);
check(abs(DEL.decode_delphi_currency(cy_b.bytes) - 1234.5678) < 0.0001, "#15b Delphi Currency fixed-point 10000x codec");
let c_abi = DEL.parse_c_header_abi("int32_t calc_vat(double net_eur, int32_t rate_pct);");
let pas_unit = DEL.generate_delphi_pas_unit("PBLangBridge", c_abi, "pblang.dll");
let pas_txt = if type(pas_unit) == "map" { pas_unit.source } else { str(pas_unit) };
check(str_contains(pas_txt, "unit PBLangBridge;") and DEL.build_dotnet_hostfxr_config().ok, "#15b Delphi .pas unit generator & .NET hostfxr config");
println("  [PASS] #15 First-Class OBJ_PTR FFI + Delphi / .NET / COM Binary Interop");

// ── Pillar #16: Sovereign ACID B+Tree / WAL / MVCC / FTS / Vector / Parquet / Arrow Engine (PBDB) ──
let db = PBDB.pbdb_open(map{ in_memory: true });
PBDB.pbdb_exec(db, "CREATE TABLE invoices (id INT PRIMARY KEY, customer TEXT, total FLOAT)");
PBDB.pbdb_begin(db);
PBDB.pbdb_exec(db, "INSERT INTO invoices VALUES (1, 'Αθήνα ΑΕ', 1240.50)");
PBDB.pbdb_exec(db, "INSERT INTO invoices VALUES (2, 'Θεσσαλονίκη ΕΠΕ', 860.00)");
PBDB.pbdb_commit(db);
let q_rows = PBDB.pbdb_query(db, "SELECT customer, total FROM invoices WHERE total > 1000");
check(len(q_rows) == 1 and q_rows[0].customer == "Αθήνα ΑΕ", "#16 PBDB ACID SQL transaction & predicate query");
PBDB.pbdb_fts_index(db, "docs_idx", "d1", "Κυρίαρχη βάση δεδομένων PBLang στην Αθήνα");
let fts_r = PBDB.pbdb_fts_search(db, "docs_idx", "Αθήνα", 5);
check(len(fts_r) == 1 and fts_r[0].doc_id == "d1", "#16 PBDB Greek BM25 Full-Text Search");
let pq_bytes = PBDB.pbdb_export_parquet_bytes(db, "invoices");
let pq_in = PBDB.pbdb_import_parquet_bytes(pq_bytes);
check(pq_in.ok and len(pq_in.rows) == 2, "#16 PBDB Parquet columnar round-trip");
println("  [PASS] #16 Sovereign ACID B+Tree / WAL / MVCC / BM25 FTS / Parquet PBDB");

// ── Pillar #17: Pure-PBLang Bomb-Proof DEFLATE, gzip, zlib, LZ4, Zstd, ZIP & TAR ──
let sample_bytes = str_to_bytes(str_repeat("PBLang-v5-Sovereign-Compression-Αθήνα! ", 80));
let gz_c = COMP.gzip_compress(sample_bytes, 6);
let gz_d = COMP.gzip_decompress(gz_c, 1048576);
check(gz_d.ok and bytes_to_str(gz_d.data) == bytes_to_str(sample_bytes), "#17 RFC 1952 gzip compress/decompress + CRC32");
let zs_c = COMP.zstd_compress(sample_bytes, 3);
let zs_d = COMP.zstd_decompress(zs_c, 1048576);
check(zs_d.ok and len(zs_d.data) == len(sample_bytes), "#17 RFC 8878 Zstandard frame round-trip");
let lz_c = COMP.lz4_compress(sample_bytes);
let lz_d = COMP.lz4_decompress(lz_c, 1048576);
check(lz_d.ok and len(lz_d.data) == len(sample_bytes), "#17 LZ4 frame + xxHash32 round-trip");
let bomb_guard = COMP.zstd_decompress(zs_c, 128);
check(not bomb_guard.ok and bomb_guard.error == "decompression_bomb_limit_exceeded", "#17 Decompression bomb cap strictly enforced");
let zip_ok = COMP.zip_pack_entries([map{ name: "hello.txt", data: str_to_bytes("Γεια σου!") }]);
let zip_un = COMP.zip_unpack_bytes(zip_ok, 65536);
check(zip_un.ok and len(zip_un.entries) == 1, "#17 PKWARE ZIP pack & unpack");
let zip_evil_blocked = false;
try {
    let ze = COMP.zip_pack_entries([map{ name: "../escape.txt", data: str_to_bytes("x") }]);
    if type(ze) == "map" and not ze.ok { zip_evil_blocked = true; }
} catch _e {
    zip_evil_blocked = true;
}
check(zip_evil_blocked, "#17 Zip-Slip ../ traversal blocked");
println("  [PASS] #17 Pure-PBLang Bomb-Proof DEFLATE, gzip, Zstd, LZ4, ZIP & TAR");

// ── Pillar #18: Native Audio/DSP, PNG/QOI/BMP/WebP & PDF 1.7 / PDF/A-3b + myDATA + PAdES ──
let wav_b = MEDIA.encode_wav_pcm16([0.0, 0.5, -0.5, 0.25], 48000, 1);
let wav_d = MEDIA.decode_wav_pcm16(wav_b);
check(wav_d.ok and len(wav_d.samples) == 4, "#18 WAV PCM16 RIFF codec");
let rgba_2x2 = [255, 0, 0, 255,  0, 255, 0, 255,  0, 0, 255, 255,  255, 255, 255, 255];
let png_b = MEDIA.encode_png_rgba(2, 2, rgba_2x2);
let png_d = MEDIA.decode_png_rgba(png_b);
let qoi_b = MEDIA.encode_qoi_rgba(2, 2, rgba_2x2);
let qoi_d = MEDIA.decode_qoi_rgba(qoi_b);
check(png_d.ok and qoi_d.ok and png_d.width == 2 and qoi_d.height == 2, "#18 PNG & QOI lossless RGBA round-trip");
let pdf_doc = MEDIA.build_pdfa3_document(map{
    title: "Τιμολόγιο Παροχής Υπηρεσιών #500",
    lines: ["Πελάτης: Αθήνα ΤΕΧ ΑΕ", "Καθαρή Αξία: 1.000,00 EUR", "ΦΠΑ 24%: 240,00 EUR"],
    mydata_xml: "<InvoicesDoc><invoice><mark>400001234567890</mark></invoice></InvoicesDoc>"
});
let pdf_ver = MEDIA.verify_pdfa3_document(pdf_doc.bytes);
check(pdf_doc.ok and pdf_ver.ok and pdf_ver.pdfa3b_xmp and pdf_ver.embedded_xml_af and pdf_ver.pades_signature_valid, "#18 PDF/A-3b + Greek UTF-16BE + AADE myDATA XML + PAdES");
println("  [PASS] #18 WAV/DSP, PNG/QOI/BMP/WebP & PDF/A-3b + myDATA + PAdES");

// ── Pillar #19: Interactive Step-Debugger, Deterministic Time-Travel (step-back) & DAP Server ──
let hook_events = 0;
debug_set_hook(fn(ev) { hook_events = hook_events + 1; });
let dbg_probe_sum = 10 + 32;
debug_set_hook(nil);
check(hook_events >= 1 and dbg_probe_sum == 42, "#19 Live VM debug_set_hook line-trap callback");
let dsess = DBG.debugger_session_new();
DBG.debugger_add_breakpoint(dsess, "app.sapp", 3, "x > 5");
DBG.debugger_load_trace_script(dsess, [
    map{ file: "app.sapp", func: "main", line: 1, depth: 1, locals: map{ x: 2 } },
    map{ file: "app.sapp", func: "main", line: 2, depth: 1, locals: map{ x: 10 } },
    map{ file: "app.sapp", func: "main", line: 3, depth: 1, locals: map{ x: 10 } }
]);
let stop_r = DBG.debugger_advance_until_stop(dsess);
check(stop_r.stopped and stop_r.snapshot.line == 3, "#19 Conditional breakpoint x > 5 triggered at line 3");
let sb_r = DBG.debugger_step_back(dsess, 1);
check(sb_r.ok and sb_r.snapshot.line == 2, "#19 Deterministic Time-Travel step-back restored line 2");
let dap_init = DBG.dap_handle_request(dsess, map{ seq: 1, type: "request", command: "initialize", arguments: map{} });
check(dap_init.response.success and dap_init.response.body.supportsStepBack == true, "#19 VS Code DAP initialize advertises supportsStepBack");
println("  [PASS] #19 Step-Debugger, Conditional Breakpoints, Time-Travel & DAP Server");

// ── Pillar #20: Bilingual (Greek + English) Multi-Span Caret Diagnostics & Levenshtein Fix-Its ──
let sug = DIAG.suggest_closest_symbol("prnitln", ["println", "print", "len"], 2);
let sug_str = if type(sug) == "map" { sug.best } else { str(sug) };
check(sug_str == "println", "#20 Damerau-Levenshtein transposition prnitln -> println");
let rich_el = DIAG.parse_vm_error_to_rich_diagnostic(
    "Runtime error: undefined variable 'prnitln' (at demo.sapp:2 in <script>)",
    "let α = 1;\nprnitln(α);\n",
    "demo.sapp",
    "el",
    map{ color: false }
);
let rich_en = DIAG.explain_diagnostic_code("E0001", "en");
check(str_contains(rich_el.rendered, "println") and len(rich_en.title) > 0, "#20 Bilingual Greek/English multi-span caret diagnostic");
println("  [PASS] #20 Bilingual (Ελληνικά + English) Caret Diagnostics & Fix-It Suggester");

// ── Pillar #21: Interactive ANSI REPL & Lossless Comment-Preserving AST Formatter ──
let unfmt_sapp = "// Κύριο σχόλιο κεφαλίδας\n@constant_time\nfn add(a,b){\n/* εσωτερικό σχόλιο */\nreturn a+b;\n}\n";
let fmt1 = REPL.format_sapp_source(unfmt_sapp);
let fmt1_txt = if type(fmt1) == "map" { fmt1["formatted"] } else { str(fmt1) };
let fmt2 = REPL.format_sapp_source(fmt1_txt);
let fmt2_txt = if type(fmt2) == "map" { fmt2["formatted"] } else { str(fmt2) };
check(fmt1_txt == fmt2_txt and str_contains(fmt1_txt, "// Κύριο σχόλιο κεφαλίδας") and str_contains(fmt1_txt, "/* εσωτερικό σχόλιο */"), "#21 Lossless comment-preserving idempotent .sapp formatter");
let rsess = REPL.repl_session_new();
let re1 = REPL.repl_eval_line(rsess, "let τιμή = 21;");
let re2 = REPL.repl_eval_line(rsess, "τιμή * 2");
check(re1.ok and re2.ok and str_contains(str(re2.value), "42"), "#21 Interactive REPL Greek variable binding & evaluation");
println("  [PASS] #21 Interactive VT100 REPL & Comment-Preserving Idempotent Formatter");

// ── Pillar #22: pblang init, Signed Package Lockfile, CycloneDX 1.5 / SPDX 2.3 SBOM & Statistical Bench ──
let cdx = PKG.generate_cyclonedx_sbom(map{ name: "demo-svc", version: "5.0.0", license: "Apache-2.0" }, [map{ name: "stdlib-crypto", version: "5.0.0", sha256: sha256("x") }]);
let spdx = PKG.generate_spdx_sbom(map{ name: "demo-svc", version: "5.0.0", license: "Apache-2.0" }, [map{ name: "stdlib-crypto", version: "5.0.0", sha256: sha256("x") }]);
check(cdx.ok and cdx.spec == "CycloneDX-1.5" and spdx.ok and spdx.spec == "SPDX-2.3", "#22 CycloneDX 1.5 & SPDX 2.3 SBOM generation");
let bstat = PKG.run_statistical_bench("i64_xor", fn() { return bit_xor(12345i64, 67890i64); }, 8, map{ synthetic_samples_ms: [0.10, 0.11, 0.10, 0.12, 0.11, 0.10, 0.11, 0.95] });
check(bstat.ok and bstat.outlier_count >= 1 and bstat.median_ms > 0.0, "#22 Statistical microbenchmark p50/p95/p99 + IQR outlier detection");
println("  [PASS] #22 Signed Package Lockfile, CycloneDX/SPDX SBOM & Statistical Bench");

// ── Pillar #23: Hardware Serial / Modbus / SocketCAN / I2C / SPI / GPIO / USB HID / FIDO2 / PKCS#11 ──
let mb_frame = HW.modbus_rtu_build_frame(1, 3, [0x00, 0x00, 0x00, 0x0A]);
let mb_parsed = HW.modbus_rtu_parse_frame(mb_frame);
check(mb_parsed.ok and not mb_parsed.is_exception and mb_parsed.function_code == 3, "#23 Modbus RTU CRC-16 frame round-trip");
let can_f = HW.socketcan_encode_frame(0x123, [0xDE, 0xAD, 0xBE, 0xEF]);
let can_d = HW.socketcan_decode_frame(can_f);
check(can_d.ok and can_d.can_id == 0x123, "#23 Linux SocketCAN frame codec");
let fido_assertion = HW.build_fido2_webauthn_assertion("pblang.org", "challenge-2026-v5", 7);
let fido_ver = HW.verify_fido2_webauthn_assertion(fido_assertion, "pblang.org", "challenge-2026-v5", fido_assertion.trusted_credential);
check(fido_ver.ok and HW.pkcs11_build_mechanism_session(0, "CKM_EDDSA").ok, "#23 FIDO2/WebAuthn assertion verifier & PKCS#11 HSM session");
println("  [PASS] #23 Industrial UART/Modbus/SocketCAN/I2C/SPI/USB-HID & FIDO2/PKCS#11");

// ── Pillar #24: Pure-PBLang CI Reporter (Zero Python in tools/) & 7-Target Hermetic Cross-Bundler ──
check(not fs_exists("tools/vm_lab_hosted_report.py") and fs_exists("tools/vm_lab_hosted_report.sapp"), "#24a Zero Python scripts in tools/");
check(VMLAB.is_safe_relative_path("vm-lab-results/native.json") and not VMLAB.is_safe_relative_path("../escape.json"), "#24a Pure-PBLang hosted VM lab reporter path safety");
let bundle_mat = BND.cross_bundle_matrix(str_to_bytes("print 500;"));
check(bundle_mat.ok and bundle_mat.target_count == 7, "#24b Hermetic 7-target cross-bundler (ELF64 x64/arm64/riscv64, PE32+, Mach-O+CodeSign, WASM32, DOS16)");
let mac_inspect = BND.inspect_bundled_binary(bundle_mat.by_target["macos-arm64"].bytes);
let rv_inspect  = BND.inspect_bundled_binary(bundle_mat.by_target["linux-riscv64"].bytes);
let win_inspect = BND.inspect_bundled_binary(bundle_mat.by_target["windows-x64"].bytes);
check(mac_inspect.valid and mac_inspect.header_valid and mac_inspect.trailer_valid and rv_inspect.valid and win_inspect.valid, "#24b Verified Mach-O Apple Silicon CodeDirectory, RISC-V 64 ELF64, and Windows PE32+");
println("  [PASS] #24 Pure-PBLang Hosted Lab Reporter & 7-Target Hermetic Cross-Bundler");

println("ALL 24 PBLANG V5.0.0 PURE-PBLANG PILLARS PASSED (" + str(passed) + " assertions)!");
