let DEVICE = import("stdlib:linux_device_handle.sapp");
let SERIAL = import("stdlib:linux_serial.sapp");

fn expect(value,message){if not value{throw "linux_device_handle: "+message;}}

let pair=SERIAL.test_pty_pair();expect(pair.ok,"PTY fixture");
let keeper=SERIAL.open_port(pair.path,115200);expect(keeper.ok,"raw PTY keeper");
let handle=DEVICE.open_device(pair.path,"test","read-write");expect(handle.ok,"descriptor-bound open");
expect(not DEVICE.open_device(pair.path,"i2c","read").ok,"class/path mismatch rejected");
expect(not DEVICE.ioctl_scalar(handle,"I2C_SLAVE",32).ok,"cross-class ioctl rejected");
expect(not DEVICE.i2c_probe(handle,32,"receive-byte").ok,"cross-class SMBus probe rejected");
let incoming=[0,65,128,255];expect(SERIAL.test_write_master(pair,incoming,500).ok,"fixture write");
let available=DEVICE.ioctl_u64(handle,"FIONREAD");
expect(available.ok and available.allowlisted and available.value>=0,
    "allowlisted pointer ioctl: "+json_stringify(available));
let read=DEVICE.read_bytes(handle,16,500);
expect(read.ok and read.bytes==incoming and read.descriptor_bound,"bounded binary read");
let outgoing=[7,0,200,10];expect(DEVICE.write_bytes(handle,outgoing,500).ok,"bounded binary write");
let received=SERIAL.test_read_master(pair,16,500);
expect(received.ok and received.bytes==outgoing,"fixture receives exact bytes");
expect(not DEVICE.read_bytes(handle,65537,1).ok,"read ceiling");
expect(DEVICE.close(handle).ok and not DEVICE.read_bytes(handle,1,1).ok,"close is final");
SERIAL.close(keeper);SERIAL.close_test_pty(pair);
print "linux_device_handle_pass";
