// tests/algorithms_quantum_pqc_bio_test.sapp — Comprehensive Verification Suite for v1.5.0
// Deliverable 4 Stdlib Modules:
//   1. stdlib/algorithms_24.sapp (24+2 real first-principles algorithms)
//   2. stdlib/quantum_computing.sapp (1..20q statevector, Grover, VQE, OpenQASM3, Cirq, IBM & Google QPU)
//   3. stdlib/bioinformatics_dna.sapp (Needleman-Wunsch, Smith-Waterman, GC/ORFs, De Bruijn assembly)
//   4. stdlib/pqc_mlkem768.sapp (FIPS 202 SHA3/SHAKE + FIPS 203 ML-KEM-768 KEM)

let Alg = import("stdlib:algorithms_24.sapp");
let QC = import("stdlib:quantum_computing.sapp");
let Bio = import("stdlib:bioinformatics_dna.sapp");
let PQC = import("stdlib:pqc_mlkem768.sapp");

let total_checks = 0;
let passed_checks = 0;

fn check(cond, label) {
    total_checks = total_checks + 1;
    if not cond {
        throw "FAIL [" + label + "]";
    }
    passed_checks = passed_checks + 1;
}

// ── Section 1: All 24+2 Real Algorithms (`stdlib/algorithms_24.sapp`) ───────
let suite24 = Alg.run_all_24_verified();
check(suite24.ok, "run_all_24_verified passed all 26 canonical invariants: failed=" + json_stringify(suite24.failed));
check(suite24.total_algorithms == 26 and suite24.verified_count == 26, "26/26 algorithms verified");

let ms = Alg.divide_and_conquer_mergesort([9, 3, 7, 1, 5, 8, 2, 6, 4, 0]);
check(ms.ok and ms.sorted[0] == 0 and ms.sorted[9] == 9 and ms.comparisons > 10, "mergesort exact order & comparison count");

let fft_res = Alg.cooley_tukey_fft([1, 0, -1, 0], false);
check(num_abs(fft_res.spectrum[1][0] - 2.0) < 0.000000001 and num_abs(fft_res.spectrum[0][0]) < 0.000000001, "cooley_tukey_fft frequency bin peak");
let ifft_res = Alg.cooley_tukey_fft(fft_res.spectrum, true);
check(num_abs(ifft_res.spectrum[0][0] - 1.0) < 0.000000001 and num_abs(ifft_res.spectrum[2][0] + 1.0) < 0.000000001, "cooley_tukey_fft inverse reconstruction");

let big_a = "999999999999999999999999999999999999";
let big_b = "888888888888888888888888888888888888";
let kmul = Alg.karatsuba_bigint_mul(big_a, big_b);
check(kmul.product == str(bigint(big_a) * bigint(big_b)), "karatsuba_bigint_mul matches 36x36 digit exact bigint");

let qsel = Alg.quickselect_kth([50, 10, 40, 20, 30], 2);
check(qsel.value == 30, "quickselect_kth median");

let bf_neg = Alg.dp_bellman_ford(3, [[0, 1, 1], [1, 2, -3], [2, 0, 1]], 0);
check(bf_neg.has_negative_cycle, "dp_bellman_ford detects negative weight cycle");

let knap = Alg.dp_knapsack_01([10, 20, 30], [60, 100, 120], 50);
check(knap.optimal_value == 220 and knap.total_weight == 50, "dp_knapsack_01 classic 220 optimal");

let unsat = Alg.dpll_sat_solver(2, [[1, 2], [1, -2], [-1, 2], [-1, -2]]);
check(not unsat.satisfiable, "dpll_sat_solver proves UNSAT on contradictory 2-CNF");

let gc_csp = Alg.backtracking_csp(map{
    kind: "graph_coloring",
    n_vertices: 4,
    n_colors: 3,
    edges: [[0, 1], [1, 2], [2, 0], [2, 3]]
});
check(gc_csp.solved and gc_csp.assignment[0] != gc_csp.assignment[1] and gc_csp.assignment[1] != gc_csp.assignment[2], "backtracking_csp 3-coloring");

let disp_res = Alg.run_algorithm("topological_betti_graph", map{ n_vertices: 4, edges: [[0, 1], [1, 2], [2, 3], [3, 0], [0, 2]] });
check(disp_res.beta0 == 1 and disp_res.beta1 == 2, "run_algorithm topological_betti_graph b0=1, b1=2");

// ── Section 2: Quantum Computing & IBM/Google QPU Clients ───────────────────
let bell = QC.new_circuit(2);
QC.h(bell, 0);
QC.cnot(bell, 0, 1);
let bell_p = QC.probabilities(bell);
check(num_abs(bell_p.by_bitstring["00"] - 0.5) < 0.000000001, "Bell state P(00) == 0.5");
check(num_abs(bell_p.by_bitstring["11"] - 0.5) < 0.000000001, "Bell state P(11) == 0.5");
check(num_abs(bell_p.by_bitstring["01"]) < 0.000000001 and num_abs(bell_p.by_bitstring["10"]) < 0.000000001, "Bell state P(01)==P(10)==0");

let ghz = QC.new_circuit(3);
QC.h(ghz, 0);
QC.cnot(ghz, 0, 1);
QC.cnot(ghz, 1, 2);
let ghz_p = QC.probabilities(ghz);
check(num_abs(ghz_p.by_bitstring["000"] - 0.5) < 0.000000001 and num_abs(ghz_p.by_bitstring["111"] - 0.5) < 0.000000001, "3-qubit GHZ state exact");

// Toffoli & phase gate identities (T^2 = S, S^2 = Z)
let phase_qc = QC.new_circuit(1);
QC.h(phase_qc, 0);
QC.t(phase_qc, 0);
QC.t(phase_qc, 0);
QC.s(phase_qc, 0);
QC.h(phase_qc, 0);
let phase_p = QC.probabilities(phase_qc);
check(num_abs(phase_p.by_bitstring["1"] - 1.0) < 0.000000001, "H * T * T * S * H == H * Z * H == X => |1>");

let tof_qc = QC.new_circuit(3);
QC.x(tof_qc, 0);
QC.x(tof_qc, 1);
QC.toffoli(tof_qc, 0, 1, 2);
check(num_abs(QC.probabilities(tof_qc).by_bitstring["111"] - 1.0) < 0.000000001, "Toffoli |110> -> |111>");

// Grover's Search on 3 qubits (N=8) & 4 qubits (N=16)
let grover3 = QC.grover_search(3, 5);
check(grover3.ok and grover3.measured_argmax == 5 and grover3.marked_bitstring == "101", "Grover 3q finds marked state 5 (101)");
check(grover3.target_probability > 0.94, "Grover 3q target probability > 0.94 (exact 121/128 = 0.9453)");

let grover4 = QC.grover_search(4, 11);
check(grover4.ok and grover4.measured_argmax == 11 and grover4.marked_bitstring == "1011", "Grover 4q finds marked state 11 (1011)");
check(grover4.target_probability > 0.96, "Grover 4q target probability > 0.96");

// 1D Transverse-Field Ising VQE
let vqe = QC.vqe_ising_1d(3, 1.0, 0.5, 70);
check(vqe.ok and vqe.ground_energy_estimate < -2.25 and vqe.ket0_energy == -2.0, "1D Ising VQE lowers energy strictly below |000> (-2.0) to ground state (~-2.34)");

// OpenQASM 3.0 & Google Cirq JSON Serialization + IBM/Google QPU Honest Fallback
let qasm3 = QC.to_openqasm3(bell);
check(str_starts_with(qasm3, "OPENQASM 3.0;") and str_contains(qasm3, "cx q[0], q[1];") and str_contains(qasm3, "c = measure q;"), "OpenQASM 3.0 export");

let cirq_json = QC.to_google_cirq_json(bell);
let cirq_parsed = json_parse(cirq_json);
check(cirq_parsed.cirq_type == "Circuit" and len(cirq_parsed.moments) == 3, "Google Cirq v2 JSON export");

// Verify honest QPU fallback when hardware cloud tokens are unset in environment
let ibm_res = QC.submit_ibm_quantum_qpu(bell, "ibm_brisbane", 512);
check(ibm_res.ok and (not ibm_res.qpu_submitted) and ibm_res.mode == "local_statevector_fallback_missing_ibm_token", "IBM QPU client honest fallback when token unset");
check(num_abs(ibm_res.local_exact_probs["00"] - 0.5) < 0.000000001 and len(ibm_res.openqasm3) > 30, "IBM QPU fallback includes exact local probs & OpenQASM3");

let ibm_job = QC.get_ibm_quantum_job("job-test-001");
check((not ibm_job.ok) and (not ibm_job.qpu_queried) and ibm_job.mode == "missing_ibm_token", "get_ibm_quantum_job honest status when token unset");

let goog_res = QC.submit_google_quantum_qpu(bell, "rainbow", 500);
check(goog_res.ok and (not goog_res.qpu_submitted) and goog_res.mode == "local_statevector_fallback_missing_google_token", "Google QPU client honest fallback when token unset");
check(goog_res.cirq_program.cirq_type == "Circuit" and num_abs(goog_res.local_exact_probs["11"] - 0.5) < 0.000000001, "Google QPU fallback includes Cirq program & exact probs");

// ── Section 3: Bioinformatics & DNA Assembly (`stdlib/bioinformatics_dna.sapp`) ──
let nw1 = Bio.needleman_wunsch("GATTACA", "GCATGCU", 1, -1, -1);
check(nw1.ok and nw1.score == 0 and len(nw1.aligned_a) == len(nw1.aligned_b), "Needleman-Wunsch classic GATTACA/GCATGCU score == 0");

let nw2 = Bio.needleman_wunsch("ACGTACGT", "ACGTCGT", 2, -1, -2);
check(nw2.ok and nw2.score == 12 and nw2.matches == 7, "Needleman-Wunsch single deletion optimal score 12");

let sw = Bio.smith_waterman("TTTTACGTACGTTTTT", "GGGGACGTACGTCCCC", 2, -2, -2);
check(sw.ok and sw.score == 16 and sw.aligned_a == "ACGTACGT" and sw.aligned_b == "ACGTACGT", "Smith-Waterman extracts exact conserved local motif ACGTACGT");

// Synthetic gene: GG + ATG (M) + GCT (A) + TTC (F) + AAA (K) + TAA (Stop) + CC => length 19, GC = 9
let gene_res = Bio.gc_content_and_orfs("GGATGGCTTTCAAATAACC", 3);
check(gene_res.ok and gene_res.length == 19 and gene_res.gc_count == 8, "GC count exact (8/19)");
check(gene_res.orf_count == 1 and gene_res.orfs[0].protein == "MAFK" and gene_res.orfs[0].frame == 2, "ORF finder detects frame-2 MAFK peptide");
check(Bio.reverse_complement("ATGC") == "GCAT", "reverse_complement ATGC -> GCAT");

// 1) Overlapping shotgun 6-bp reads -> "ATGCGTACCTG"
let shotgun_reads = ["ATGCGT", "GCGTAC", "GTACCTG"];
let asm_shotgun = Bio.debruijn_assemble(shotgun_reads, 4);
check(asm_shotgun.ok and asm_shotgun.contig == "ATGCGTACCTG", "De Bruijn k=4 shotgun assembler reconstructs ATGCGTACCTG: got " + asm_shotgun.contig);

// 2) Exact k=4 multiset spectrum with repeated 4-mer "ACGT" -> "ACGTACGTGCA"
let spectrum_kmers = ["ACGT", "CGTA", "GTAC", "TACG", "ACGT", "CGTG", "GTGC", "TGCA"];
let asm_spec = Bio.debruijn_assemble(spectrum_kmers, 4);
check(asm_spec.ok and asm_spec.contig == "ACGTACGTGCA", "De Bruijn k=4 multigraph assembler reconstructs repeat-containing ACGTACGTGCA: got " + asm_spec.contig);

// ── Section 4: Post-Quantum Cryptography FIPS 203 ML-KEM-768 & FIPS 202 ─────
// Verify exact NIST FIPS 202 vectors first!
check(PQC.bytes_to_hex(PQC.sha3_256([])) == "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a", "NIST FIPS 202 SHA3-256 empty vector");
check(PQC.bytes_to_hex(PQC.sha3_256("abc")) == "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532", "NIST FIPS 202 SHA3-256('abc') vector");
check(PQC.bytes_to_hex(PQC.sha3_512([])) == "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26", "NIST FIPS 202 SHA3-512 empty vector");
check(PQC.bytes_to_hex(PQC.shake128([], 16)) == "7f9c2ba4e88f827d616045507605853e", "NIST FIPS 202 SHAKE128('', 16) vector");
check(PQC.bytes_to_hex(PQC.shake256([], 32)) == "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762f", "NIST FIPS 202 SHAKE256('', 32) vector");

// Verify FIPS 203 ZETAS & NTT ring isomorphism mod (X^256 + 1, 3329)
check(PQC.ZETAS[0] == 1 and PQC.ZETAS[1] == 1729 and PQC.ZETAS[2] == 2580 and PQC.ZETAS[3] == 3289, "FIPS 203 Appendix A ZETAS[0..3]");

let poly_a = [];
let poly_b = [];
let pi = 0;
while pi < 256 {
    push(poly_a, num_mod(17 * pi + 5, 3329));
    push(poly_b, num_mod(31 * pi + 9, 3329));
    pi = pi + 1;
}
let rt_a = PQC.inv_ntt(PQC.ntt(poly_a));
check(rt_a[0] == poly_a[0] and rt_a[127] == poly_a[127] and rt_a[255] == poly_a[255], "inv_ntt(ntt(a)) == a");

// Schoolbook negacyclic reference product at coefficient 0 & coefficient 73
let prod_ntt = PQC.inv_ntt(PQC.ntt_mul(PQC.ntt(poly_a), PQC.ntt(poly_b)));
let ref_c0 = 0;
let ref_c73 = 0;
let idx_a = 0;
while idx_a < 256 {
    let idx_b = num_mod(256 - idx_a, 256);
    let term0 = num_mod(poly_a[idx_a] * poly_b[idx_b], 3329);
    if idx_a + idx_b >= 256 {
        ref_c0 = num_mod(ref_c0 + 3329 - term0, 3329);
    } else {
        ref_c0 = num_mod(ref_c0 + term0, 3329);
    }

    let jb = num_mod(73 + 256 - idx_a, 256);
    let term73 = num_mod(poly_a[idx_a] * poly_b[jb], 3329);
    if idx_a + jb >= 256 {
        ref_c73 = num_mod(ref_c73 + 3329 - term73, 3329);
    } else {
        ref_c73 = num_mod(ref_c73 + term73, 3329);
    }
    idx_a = idx_a + 1;
}
check(prod_ntt[0] == ref_c0 and prod_ntt[73] == ref_c73, "ntt_mul matches negacyclic schoolbook product mod (X^256 + 1, 3329)");

// ML-KEM-768 KeyGen, Encaps, Decaps & Tampered-Ciphertext Implicit Rejection
let seed64 = [];
let si = 0;
while si < 64 { push(seed64, bit_and(si * 7 + 13, 255)); si = si + 1; }
let coin32 = [];
si = 0;
while si < 32 { push(coin32, bit_and(si * 11 + 29, 255)); si = si + 1; }

let kp = PQC.mlkem768_keygen(seed64);
check(kp.ok and len(kp.ek) == 1184 and len(kp.dk) == 2400, "ML-KEM-768 keygen sizes (ek=1184, dk=2400)");

let enc = PQC.mlkem768_encaps(kp.ek, coin32);
check(enc.ok and len(enc.ct) == 1088 and len(enc.shared_secret) == 32, "ML-KEM-768 encaps sizes (ct=1088, ss=32)");

let dec_ss = PQC.mlkem768_decaps(kp.dk, enc.ct);
check(len(dec_ss) == 32 and PQC.bytes_to_hex(dec_ss) == PQC.bytes_to_hex(enc.shared_secret), "ML-KEM-768 decaps recovers exact 32-byte shared secret");

// Second independent keypair + coin
let seed64_b = PQC.shake256("pblang-mlkem768-second-vector", 64);
let coin32_b = PQC.sha3_256("pblang-mlkem768-coin-b");
let kp_b = PQC.mlkem768_keygen(seed64_b);
let enc_b = PQC.mlkem768_encaps(kp_b.ek, coin32_b);
let dec_b = PQC.mlkem768_decaps(kp_b.dk, enc_b.ct);
check(PQC.bytes_to_hex(dec_b) == PQC.bytes_to_hex(enc_b.shared_secret), "ML-KEM-768 second keypair/coin roundtrip exact");
check(PQC.bytes_to_hex(dec_b) != PQC.bytes_to_hex(dec_ss), "Distinct ML-KEM-768 sessions produce distinct shared secrets");

// Tamper 1 bit of ciphertext -> Fujisaki-Okamoto implicit rejection MUST yield deterministic K_bar != shared_secret
let tampered_ct = [];
si = 0;
while si < len(enc.ct) { push(tampered_ct, enc.ct[si]); si = si + 1; }
tampered_ct[42] = bit_xor(tampered_ct[42], 1);

let rej_ss1 = PQC.mlkem768_decaps(kp.dk, tampered_ct);
let rej_ss2 = PQC.mlkem768_decaps(kp.dk, tampered_ct);
let z_and_ct = slice(seed64, 32, 64);
si = 0;
while si < len(tampered_ct) { push(z_and_ct, tampered_ct[si]); si = si + 1; }
let expected_kbar = PQC.shake256(z_and_ct, 32);
check(len(rej_ss1) == 32 and PQC.bytes_to_hex(rej_ss1) != PQC.bytes_to_hex(enc.shared_secret), "ML-KEM-768 tampered ciphertext rejected (does not leak valid shared secret)");
check(PQC.bytes_to_hex(rej_ss1) == PQC.bytes_to_hex(rej_ss2) and PQC.bytes_to_hex(rej_ss1) == PQC.bytes_to_hex(expected_kbar), "ML-KEM-768 implicit rejection matches FIPS 203 J(z || ct)");

print "ALGORITHMS_QUANTUM_PQC_BIO_TEST_PASS checks=" + str(passed_checks) + "/" + str(total_checks);
