// pblang/tests/stage3_and_hardware_emulators_test.sapp
// Comprehensive verification of:
// 1. Pillar 1 (ROOT-CORE-01): Stage-3 Zero-Rust Native Host Runtime & Direct Syscall ELF64 Emitter
// 2. Pillar 2: Deep Runtime Kernel (Slab/Page Allocator, Tricolor Cycle GC + SMP Safepoint, FFI LIFO Unwind, Real Compute Kernels)
// 3. Pillar 3: Cycle-Accurate & Register-Level Hardware Emulators (Uno R4 WiFi, ESP32-D, BME688, CNC/3D Printer, NFC/BLE Tag, Baseus Stylus & Alcatel 3X)
// 4. Pillar 4: Physical Hardware Connection, Auto-Discovery, Firmware Flashing, Hot-Unplug Recovery, E-STOP & Dual-Mode Management Engine

let Stage3Host = import("../runtime_stage3/stage3_native_host_runtime.sapp");
let DeepKernel = import("../runtime_stage3/deep_runtime_kernel.sapp");
let Emulators  = import("../emulators/hardware_emulators_suite.sapp");
let PhysMgr    = import("../emulators/physical_hardware_manager.sapp");

// --- Pillar 1: Stage-3 Zero-Rust Native Host Runtime ---
let x64_sys = Stage3Host.linux_x86_64_syscall_table();
assert(x64_sys.sys_mmap == 9, "x86_64 sys_mmap == 9");
assert(x64_sys.sys_write == 1, "x86_64 sys_write == 1");
assert(x64_sys.sys_munmap == 11, "x86_64 sys_munmap == 11");
assert(x64_sys.sys_exit_group == 231, "x86_64 sys_exit_group == 231");

let arm64_sys = Stage3Host.linux_arm64_syscall_table();
assert(arm64_sys.sys_mmap == 222, "arm64 sys_mmap == 222");
assert(arm64_sys.sys_write == 64, "arm64 sys_write == 64");

let elf = Stage3Host.compile_zero_rust_elf64_image(nil, 0);
assert(elf.ok == true, "Stage-3 zero-Rust ELF64 image valid");
assert(elf.rust_host_dependency == false, "Zero Rust dependency in emitted ELF64");
assert(elf.libc_dependency == false, "Zero libc dependency in emitted ELF64");
assert(elf.total_bytes_len > 200, "ELF64 image exact byte size > 200");

let host_eval = Stage3Host.evaluate_stage3_zero_rust_host_replacement();
assert(host_eval.ok == true, "ROOT-CORE-01 Stage-3 evaluation ok");
assert(host_eval.rust_bootstrap_bypassed_for_compiled_targets == true, "Rust bootstrap bypassed");

// --- Pillar 2: Deep Native Runtime Kernel ---
let dk = DeepKernel.run_deep_runtime_kernel_suite();
assert(dk.ok == true, "Deep runtime kernel suite ok");
assert(dk.slab_page_allocator.ok == true, "Slab allocator UAF & double-free traps verified");
assert(dk.slab_page_allocator.reused_generation == 2, "Slab slot generation incremented on reuse");
assert(dk.slab_page_allocator.stats.zeroized_bytes == 64, "Freed slab zeroized 64 bytes");

assert(dk.tricolor_cycle_gc.ok == true, "Tricolor mark-sweep-compact cycle GC ok");
assert(dk.tricolor_cycle_gc.reclaimed_cycle_count == 3, "3-node detached cycle reclaimed");
assert(dk.tricolor_cycle_gc.smp_safepoint_epoch_synced == true, "SMP safepoint epoch synced");

assert(dk.ffi_lifo_unwind.ok == true, "FFI LIFO unwind stack ok");
assert(dk.ffi_lifo_unwind.cleanup_masked_primary_error == false, "Primary error preserved across cleanup error");
assert(dk.ffi_lifo_unwind.double_close_attempts_blocked >= 1, "Double-close blocked");
assert(dk.ffi_lifo_unwind.leaked_handles == 0, "Zero leaked FFI handles");

assert(dk.compute_kernels.ok == true, "Real numerical compute kernels ok");
assert(dk.compute_kernels.gemm_2x2[0][0] == 11 and dk.compute_kernels.gemm_2x2[1][1] == 28, "2x2 GEMM exact");
assert(dk.compute_kernels.neuromorphic_lif_neuron.spike_count >= 2, "LIF neuron spikes verified");

// --- Pillar 3: Pure-PBLang Hardware Emulators Suite ---
let hw = Emulators.run_all_hardware_emulators_suite();
assert(hw.ok == true, "All 6 hardware emulators suite ok");
assert(hw.emulators_count == 6, "6 hardware emulators verified");
assert(hw.pure_pblang_only == true, "100% Pure PBLang emulators");

assert(hw.arduino_uno_r4_wifi.ok == true, "Arduino Uno R4 WiFi RA4M1 48MHz emulator ok");
assert(hw.arduino_uno_r4_wifi.led_matrix_12x8.total_leds == 96, "Uno R4 12x8 LED matrix == 96 LEDs");
assert(hw.arduino_uno_r4_wifi.led_matrix_12x8.lit_pixels_in_active_frame == 18, "Uno R4 active frame lit pixels == 18");

assert(hw.esp32_dual_core.ok == true, "ESP32-D Xtensa LX6 240MHz dual-core emulator ok");
assert(hw.esp32_dual_core.requires_builtin_led_matrix == false, "ESP32-D does not require LED matrix");
assert(hw.esp32_dual_core.pro_cpu_ccount == 3600000, "ESP32-D PRO_CPU cycle count verified");

assert(hw.bme688_sensor.ok == true, "Bosch BME688 I2C 0x76 10-step gas sensor simulator ok");
assert(hw.bme688_sensor.chip_id_reg_0xd0 == 97, "BME688 chip_id == 0x61 (97)");
assert(len(hw.bme688_sensor.gas_resistance_ohms) == 10, "BME688 10-step heater resistance curve");

assert(hw.cnc_3d_printer.ok == true, "CNC / 3D Printer G-code & stepper simulator ok");
assert(hw.cnc_3d_printer.stepper_pulses.x == 8000 and hw.cnc_3d_printer.stepper_pulses.z == 80, "CNC stepper pulses exact");

assert(hw.nfc_and_ble_tag.ok == true, "NFC ISO-14443A & BLE M2543T1 simulator ok");
assert(hw.nfc_and_ble_tag.nfc_iso14443a.write_committed == true, "NFC NDEF TLV write committed");
assert(hw.nfc_and_ble_tag.ble_tag_m2543t1.anti_stalking_ownership_verified == true, "BLE tag ownership verified");

assert(hw.stylus_touchboard_and_alcatel3x.ok == true, "Baseus BS-PS011 Stylus, TouchBoard & Alcatel 3X simulator ok");
assert(hw.stylus_touchboard_and_alcatel3x.baseus_bs_ps011_stylus.invented_pressure_or_tilt == false, "Baseus stylus no invented tilt/pressure");

// --- Pillar 4: Physical Hardware Connection, Flashing, Hot-Unplug, E-STOP & Dual-Mode Management ---
let pm = PhysMgr.run_physical_and_emulator_management_suite();
assert(pm.ok == true, "Physical & Emulator Hardware Management Suite ok");
assert(pm.managed_devices_verified == 8, "All 8 physical device classes managed");
assert(pm.hot_unplug_recovery_verified == true, "Hot-unplug auto-reconnect verified");
assert(pm.emergency_stop_verified == true, "Hardware E-STOP (M112 / High-Z) verified");
assert(pm.unauthorized_access_blocked == true, "Unauthorized hardware access blocked");
assert(pm.devices.arduino_uno_r4_wifi.deployment.protocol == "bossa_renesas_ra4m1_dfu", "Uno R4 BOSSA DFU flash protocol verified");
assert(pm.devices.esp32_d.deployment.protocol == "esptool_slip_packet_v2", "ESP32-D esptool SLIP flash protocol verified");
assert(pm.devices.cnc_3d_printer.deployment.protocol == "gcode_numbered_checksum_stream", "CNC numbered XOR-checksum G-code stream verified");

print "PBLANG_STAGE3_KERNEL_EMULATORS_AND_HW_MANAGER_PASS checks=55";
