// tests/zero_rust_vm_test.sapp — End-to-End Verification of the Stage-3 Zero-Rust
// C99 `.pbck` v1 Bytecode VM (`runtime_stage3/pblang_zero_rust_vm.c`).
//
// Compiles non-trivial `.sapp` programs with the 100% pure-PBLang `.pbck` compiler
// (`stdlib:compiler/native_pbck.sapp::compile_source`), executes them on the
// zero-Rust C99 VM (`pblang-zero-rust`), verifies `0` Rust symbols in `nm`, and
// checks byte-for-byte identical stdout against the reference PBLang VM.

let NativePbck = import("stdlib:compiler/native_pbck.sapp");
let Stage3 = import("runtime_stage3/stage3_native_host_runtime.sapp");
let UUID = import("stdlib:uuid.sapp");

let passed = 0;
let total = 0;

fn check(cond, msg) {
    total = total + 1;
    if not cond {
        throw "ZERO_RUST_VM_TEST FAIL: " + msg;
    }
    passed = passed + 1;
}

let run_id = UUID.v4();
let tmp_dir = "/tmp/pblang_zero_rust_test_" + run_id;
fs_mkdirs(tmp_dir);
let vm_bin = tmp_dir + "/pblang-zero-rust";

// 1. Build C99 zero-Rust VM from source & verify 0 Rust symbols
let build_res = Stage3.build_zero_rust_pbck_vm(vm_bin);
check(build_res.ok, "build_zero_rust_pbck_vm succeeded: " + json_stringify(build_res));
check(build_res.rust_symbols == 0, "pblang-zero-rust binary contains 0 Rust symbols");
check(build_res.is_full_pbck_bytecode_vm == true, "artifact marked as full .pbck bytecode VM");
check(str_contains(build_res.version_output, "1.5.0"), "--version reports 1.5.0");

// Resolve reference pblang CLI for differential stdout comparison without hardcoding user paths
fn resolve_ref_pblang() {
    if fs_exists("target/release/pblang") { return "./target/release/pblang"; }
    if fs_exists("target/debug/pblang") { return "./target/debug/pblang"; }
    return "pblang";
}
let ref_pblang = resolve_ref_pblang();

fn verify_differential_program(label, sapp_source, cli_args) {
    let src_path = tmp_dir + "/" + label + ".sapp";
    let pbck_path = tmp_dir + "/" + label + ".pbck";
    fs_write(src_path, sapp_source);

    // Pure-PBLang compilation: .sapp -> .pbck v1 bytes
    let pbck_bytes = NativePbck.compile_source(sapp_source);
    check(type(pbck_bytes) == "array" and len(pbck_bytes) > 5 and pbck_bytes[0] == 80 and pbck_bytes[1] == 66, label + ": pure-PBLang compile_source succeeded");
    fs_write_bytes(pbck_path, pbck_bytes);

    // Execute on Zero-Rust C99 VM
    let zr = Stage3.run_pbck_on_zero_rust_vm(pbck_path, cli_args, vm_bin);
    check(zr.ok and zr.exit_code == 0, label + ": zero-rust VM exited 0 (stderr=" + str(zr.stderr) + ")");

    // Execute on reference Rust VM
    let ref_argv = ["run", src_path, "--allow-all"];
    if type(cli_args) == "array" and len(cli_args) > 0 {
        array_push(ref_argv, "--");
        let k = 0;
        while k < len(cli_args) {
            array_push(ref_argv, str(cli_args[k]));
            k = k + 1;
        }
    }
    let rr = proc_spawn_wait(ref_pblang, ref_argv);
    check(rr.exit_code == 0, label + ": reference VM exited 0");
    check(zr.stdout == rr.stdout, label + ": stdout matches byte-for-byte\n  zero-rust: " + zr.stdout + "\n  ref-vm:    " + rr.stdout);
}

// Case 1: Recursive Fibonacci + arithmetic + string formatting
verify_differential_program("fib_recursive", "
fn fib(n) {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}
print \"fib(0)=\" + str(fib(0));
print \"fib(10)=\" + str(fib(10));
print \"fib(16)=\" + str(fib(16));
", []);

// Case 2: Lexical closures with shared mutable upvalues
verify_differential_program("closures_upvalues", "
fn make_account(initial) {
    let balance = initial;
    let deposit = fn(amount) {
        balance = balance + amount;
        return balance;
    };
    let withdraw = fn(amount) {
        balance = balance - amount;
        return balance;
    };
    return map{ dep: deposit, wd: withdraw };
}
let acc = make_account(100);
print acc.dep(50);
print acc.wd(35);
print acc.dep(10);
", []);

// Case 3: In-place Array Quicksort
verify_differential_program("quicksort_array", "
fn partition(arr, low, high) {
    let pivot = arr[high];
    let i = low - 1;
    let j = low;
    while j < high {
        if arr[j] <= pivot {
            i = i + 1;
            let tmp = arr[i];
            arr[i] = arr[j];
            arr[j] = tmp;
        }
        j = j + 1;
    }
    let tmp2 = arr[i + 1];
    arr[i + 1] = arr[high];
    arr[high] = tmp2;
    return i + 1;
}
fn quicksort(arr, low, high) {
    if low < high {
        let p = partition(arr, low, high);
        quicksort(arr, low, p - 1);
        quicksort(arr, p + 1, high);
    }
}
let data = [42, 7, 19, 3, 99, 1, 19, 25, 8, 14];
quicksort(data, 0, len(data) - 1);
print data;
", []);

// Case 4: Map word-frequency counter + SHA-256 + JSON serialization
verify_differential_program("map_word_counter", "
let text = \"alpha beta gamma alpha delta beta alpha gamma alpha\";
let words = str_split(text, \" \");
let counts = map{};
let i = 0;
while i < len(words) {
    let w = words[i];
    if map_has(counts, w) {
        counts[w] = counts[w] + 1;
    } else {
        counts[w] = 1;
    }
    i = i + 1;
}
print \"alpha=\" + str(counts[\"alpha\"]) + \" beta=\" + str(counts[\"beta\"]) + \" gamma=\" + str(counts[\"gamma\"]) + \" delta=\" + str(counts[\"delta\"]);
print sha256(\"pblang-zero-rust-1.5.0\");
", []);

// Case 5: Nested try/catch error recovery + bitwise + math + GC allocation loop
verify_differential_program("try_catch_and_gc", "
let a = [10, 20, 30];
let r1 = try a[99] catch -7;
let m = map{ x: 5 };
let r2 = try m[\"missing\"] catch (try a[50] catch 42);
let r3 = try error(\"custom_boom\") catch 123;
print str(r1) + \":\" + str(r2) + \":\" + str(r3);
print str(bit_xor(bit_shl(3, 4), 10)) + \":\" + str(num_floor(num_sqrt(144)));

// Allocate 20,000 temporary strings/arrays/maps to exercise mark-and-sweep GC
let acc = 0;
let idx = 0;
while idx < 5000 {
    let tmp_arr = [idx, idx + 1, \"item_\" + str(idx)];
    let tmp_map = map{ v: tmp_arr[0] + tmp_arr[1] };
    acc = acc + tmp_map.v;
    idx = idx + 1;
}
let freed = gc_collect();
let st = gc_stats();
if not str_contains(st, \"collections=\") or not str_contains(freed, \"gc_collect:\") { throw \"expected gc_stats string\"; }
print \"acc=\" + str(acc);
", []);

// Cleanup temporary artifacts
let rm = try proc_spawn_wait("rm", ["-rf", tmp_dir]) catch nil;

print "ZERO_RUST_VM_TEST_PASS checks=" + str(passed) + "/" + str(total);
