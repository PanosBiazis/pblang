// tests/quantum_algorithms_heavyhex_test.sapp — Verification Suite for Canonical Quantum
// Algorithms (QFT, QPE, Shor Factoring, QAOA MaxCut, 2x2 HHL), Molecular Quantum Chemistry
// (H2 STO-3G VQE + Analytic Parameter-Shift Gradients), and 156-Qubit IBM Heron r2 Heavy-Hex
// Calibration-Aware Dijkstra Router & EstimatorV2 Client (v3.0.0).

let QC = try import("stdlib:quantum_computing.sapp") catch import("../stdlib/quantum_computing.sapp");
let QA = try import("stdlib:quantum/algorithms_chemistry_heavyhex.sapp") catch import("../stdlib/quantum/algorithms_chemistry_heavyhex.sapp");

let _PI = 3.14159265358979323846;
let _TWO_PI = 6.28318530717958647692;

let total_checks = 0;
let passed_checks = 0;

fn check(cond, label) {
    total_checks = total_checks + 1;
    if not cond {
        throw "FAIL [" + label + "]";
    }
    passed_checks = passed_checks + 1;
}

fn sv_fidelity(sv_a, sv_b) {
    let re = 0.0;
    let im = 0.0;
    let i = 0;
    while i < len(sv_a) {
        let ar = sv_a[i][0];
        let ai = sv_a[i][1];
        let br = sv_b[i][0];
        let bi = sv_b[i][1];
        re = re + (ar * br + ai * bi);
        im = im + (ar * bi - ai * br);
        i = i + 1;
    }
    return re * re + im * im;
}

// ── 1. Controlled-Phase cp() & Exact QFT / Inverse QFT Verification ──────────

// 1A. Verify cp(qc, 0, 1, pi/2) applies exact relative phase diag(1, 1, 1, i)
let cp_qc = QC.new_circuit(2);
QC.h(cp_qc, 0);
QC.h(cp_qc, 1);
QA.cp(cp_qc, 0, 1, _PI * 0.5);
let sv_cp = QC.run_statevector(cp_qc).amplitudes;
// Relative ratio amp[3] / amp[0] must equal +i = (0 + 1i)
let a0_re = sv_cp[0][0];
let a0_im = sv_cp[0][1];
let a3_re = sv_cp[3][0];
let a3_im = sv_cp[3][1];
let norm0 = a0_re * a0_re + a0_im * a0_im;
let ratio_re = (a3_re * a0_re + a3_im * a0_im) / norm0;
let ratio_im = (a3_im * a0_re - a3_re * a0_im) / norm0;
check(num_abs(ratio_re) < 0.000000000001 and num_abs(ratio_im - 1.0) < 0.000000000001,
    "cp(pi/2) applies exact relative phase +i on |11> vs |00>");
check(num_abs(sv_cp[0][0] - sv_cp[1][0]) < 0.000000000001 and
      num_abs(sv_cp[0][0] - sv_cp[2][0]) < 0.000000000001 and
      num_abs(sv_cp[0][1] - sv_cp[1][1]) < 0.000000000001 and
      num_abs(sv_cp[0][1] - sv_cp[2][1]) < 0.000000000001,
    "cp(pi/2) leaves |00>, |01>, |10> identically phase-aligned");

// 1B. QFT(|0000>) produces uniform equal-phase superposition 1/4 sum_y |y>
let qft4 = QA.qft_circuit(4, false);
let p_qft4 = QC.probabilities(qft4);
check(num_abs(p_qft4.by_bitstring["0000"] - 0.0625) < 0.000000000001 and
      num_abs(p_qft4.by_bitstring["1010"] - 0.0625) < 0.000000000001 and
      num_abs(p_qft4.by_bitstring["1111"] - 0.0625) < 0.000000000001,
    "qft_circuit(4) maps |0000> to uniform 1/16 probability distribution");

// 1C. Verify exact DFT matrix entries of QFT on basis state |x = 3> = |011> (n = 3, N = 8)
let dft_in = QC.new_circuit(3);
QC.x(dft_in, 1);
QC.x(dft_in, 2);
QA.apply_qft(dft_in, [0, 1, 2], false);
let sv_dft = QC.run_statevector(dft_in).amplitudes;
// Check relative phase between y=1 and y=0: exp(2*pi*i * 3 * 1 / 8) = exp(i * 3*pi/4) = (-1 + i)/sqrt(2)
let d0_re = sv_dft[0][0];
let d0_im = sv_dft[0][1];
let d1_re = sv_dft[1][0];
let d1_im = sv_dft[1][1];
let d0_n2 = d0_re * d0_re + d0_im * d0_im;
let rel10_re = (d1_re * d0_re + d1_im * d0_im) / d0_n2;
let rel10_im = (d1_im * d0_re - d1_re * d0_im) / d0_n2;
let inv_rt2 = 0.70710678118654752440;
check(num_abs(rel10_re + inv_rt2) < 0.000000000001 and num_abs(rel10_im - inv_rt2) < 0.000000000001,
    "QFT|011> relative phase amp[1]/amp[0] == exp(+i*3*pi/4) exact");

// 1D. Verify QFT^{-1}(QFT|psi>) == |psi> with fidelity > 0.9999999999 on entangled 4-qubit state
let psi4_ref = QC.new_circuit(4);
QC.ry(psi4_ref, 0, 0.83);
QC.rx(psi4_ref, 1, -1.27);
QC.cnot(psi4_ref, 0, 1);
QC.rz(psi4_ref, 2, 0.59);
QC.h(psi4_ref, 3);
QC.cnot(psi4_ref, 1, 2);
QC.cnot(psi4_ref, 2, 3);
QC.ry(psi4_ref, 3, -0.44);

let psi4_rt = QC.new_circuit(4);
let g_i = 0;
while g_i < len(psi4_ref.gates) {
    push(psi4_rt.gates, psi4_ref.gates[g_i]);
    g_i = g_i + 1;
}
QA.apply_qft(psi4_rt, [0, 1, 2, 3], false);
QA.apply_qft(psi4_rt, [0, 1, 2, 3], true);
let qft_rt_fid = sv_fidelity(QC.run_statevector(psi4_ref).amplitudes, QC.run_statevector(psi4_rt).amplitudes);
check(qft_rt_fid > 0.999999999999,
    "QFT^{-1}(QFT|psi>) == |psi> on entangled 4-qubit state with fidelity > 0.999999999999");

// 1E. Verify QFT^{-1} standalone circuit via qft_circuit(3, true)
let qft3_fwd = QA.qft_circuit(3, false);
let qft3_inv = QA.qft_circuit(3, true);
let qft3_comb = QC.new_circuit(3);
QC.x(qft3_comb, 0);
QC.x(qft3_comb, 2);
g_i = 0;
while g_i < len(qft3_fwd.gates) { push(qft3_comb.gates, qft3_fwd.gates[g_i]); g_i = g_i + 1; }
g_i = 0;
while g_i < len(qft3_inv.gates) { push(qft3_comb.gates, qft3_inv.gates[g_i]); g_i = g_i + 1; }
check(num_abs(QC.probabilities(qft3_comb).by_bitstring["101"] - 1.0) < 0.000000000001,
    "qft_circuit(3, true) * qft_circuit(3, false) |101> -> |101> with P == 1.0");

// 1F. Period & frequency detection on periodic 4-qubit statevector:
// Prepare shifted periodic state 1/2 (|1> + |5> + |9> + |13>) with period r = 4 on N = 16:
// H(0), H(1), X(3) prepares |q0 q1 0 1> = {|0001>, |0101>, |1001>, |1101>} = {1, 5, 9, 13}!
let per_qc = QC.new_circuit(4);
QC.h(per_qc, 0);
QC.h(per_qc, 1);
QC.x(per_qc, 3);
QA.apply_qft(per_qc, [0, 1, 2, 3], false);
let per_probs = QC.probabilities(per_qc).by_bitstring;
// Peaks must appear ONLY at multiples of N/r = 16/4 = 4 -> indices 0, 4, 8, 12 ("0000", "0100", "1000", "1100")!
check(num_abs(per_probs["0000"] - 0.25) < 0.000000000001 and
      num_abs(per_probs["0100"] - 0.25) < 0.000000000001 and
      num_abs(per_probs["1000"] - 0.25) < 0.000000000001 and
      num_abs(per_probs["1100"] - 0.25) < 0.000000000001,
    "QFT period detection concentrates 100% probability at k*(16/4) = {0, 4, 8, 12} (P == 0.25 each)");
check(per_probs["0001"] < 0.000000000001 and per_probs["0010"] < 0.000000000001 and per_probs["0111"] < 0.000000000001,
    "QFT destructive interference cancels all non-harmonic frequencies to < 1e-12");

// ── 2. Quantum Phase Estimation (QPE) Verification ───────────────────────────

// 2A. Exact dyadic eigenphase phi = 3/16 = 0.1875 on 4 counting qubits
let qpe_3_16 = QA.quantum_phase_estimation(0.1875, 4);
check(qpe_3_16.ok and qpe_3_16.total_qubits == 5, "QPE(3/16, 4) builds 5-qubit circuit and succeeds");
check(qpe_3_16.best_bitstring == "0011" and qpe_3_16.best_index == 3,
    "QPE(3/16, 4) identifies exact binary phase bitstring '0011'");
check(num_abs(qpe_3_16.counting_probabilities["0011"] - 1.0) < 0.000000000001,
    "QPE(3/16, 4) achieves P('0011') == 1.000000000000");
check(num_abs(qpe_3_16.estimated_phase - 0.1875) < 0.000000000001 and qpe_3_16.phase_error < 0.000000000001,
    "QPE(3/16, 4) recovers exact phase 0.1875 with zero error");

// 2B. Exact dyadic eigenphase phi = 11/16 = 0.6875 -> "1011" & phi = 5/32 = 0.15625 -> "00101"
let qpe_11_16 = QA.quantum_phase_estimation(0.6875, 4);
check(qpe_11_16.best_bitstring == "1011" and num_abs(qpe_11_16.counting_probabilities["1011"] - 1.0) < 0.000000000001,
    "QPE(11/16, 4) achieves P('1011') == 1.000000000000");

let qpe_5_32 = QA.quantum_phase_estimation(5.0 / 32.0, 5);
check(qpe_5_32.best_bitstring == "00101" and num_abs(qpe_5_32.peak_probability - 1.0) < 0.000000000001,
    "QPE(5/32, 5) achieves P('00101') == 1.000000000000");

// 2C. Non-dyadic eigenphase phi = 1/3 recovered within 1/2^n across n = 4, 6
let qpe_third_4 = QA.quantum_phase_estimation(1.0 / 3.0, 4);
check(qpe_third_4.ok and qpe_third_4.phase_error <= (1.0 / 16.0) and qpe_third_4.peak_probability > 0.65,
    "QPE(1/3, 4) estimates 1/3 within 1/16 with Fejer peak > 0.65");

let qpe_third_6 = QA.quantum_phase_estimation(1.0 / 3.0, 6);
check(qpe_third_6.ok and qpe_third_6.best_index == 21 and
      num_abs(qpe_third_6.estimated_phase - (21.0 / 64.0)) < 0.000000000001 and
      qpe_third_6.phase_error <= (1.0 / 64.0),
    "QPE(1/3, 6) resolves 21/64 = 0.328125 within 1/64 of 1/3");

// ── 3. Shor's Factoring Algorithm Verification (N = 15, 21, 35) ──────────────

// 3A. Factor N = 15 -> [3, 5] via genuine quantum QFT order-finding + continued fractions
let shor_15 = QA.shor_factor(15, 42);
check(shor_15.ok and shor_15.quantum_order_finding_used == true and
      shor_15.method == "quantum_qft_continued_fractions",
    "shor_factor(15) uses genuine quantum QFT order-finding + continued fractions");
check(shor_15.factors[0] == 3 and shor_15.factors[1] == 5 and
      shor_15.factors[0] * shor_15.factors[1] == 15,
    "shor_factor(15) recovers exact prime factors [3, 5]");
check(shor_15.order_r > 0 and num_mod(shor_15.order_r, 2) == 0 and len(shor_15.top_peaks) >= 1 and
      shor_15.circuit.n_qubits == shor_15.total_qubits,
    "shor_factor(15) extracts valid even multiplicative order r from quantum circuit QFT peaks");

// Verify alternate seed on N = 15 also factors into [3, 5]
let shor_15_s1 = QA.shor_factor(15, 1);
check(shor_15_s1.ok and shor_15_s1.factors[0] == 3 and shor_15_s1.factors[1] == 5,
    "shor_factor(15, seed=1) recovers [3, 5]");

// 3B. Factor N = 21 -> [3, 7]
let shor_21 = QA.shor_factor(21, 42);
check(shor_21.ok and shor_21.quantum_order_finding_used == true and
      shor_21.method == "quantum_qft_continued_fractions",
    "shor_factor(21) uses genuine quantum QFT order-finding + continued fractions");
check(shor_21.factors[0] == 3 and shor_21.factors[1] == 7 and
      shor_21.factors[0] * shor_21.factors[1] == 21,
    "shor_factor(21) recovers exact prime factors [3, 7]");
check(shor_21.order_r > 0 and num_mod(shor_21.order_r, 2) == 0 and shor_21.winning_peak.probability > 0.05,
    "shor_factor(21) extracts even order r from high-probability QFT peak");

// 3C. Factor N = 35 -> [5, 7]
let shor_35 = QA.shor_factor(35, 3);
check(shor_35.ok and shor_35.quantum_order_finding_used == true and
      shor_35.method == "quantum_qft_continued_fractions",
    "shor_factor(35) uses genuine quantum QFT order-finding + continued fractions");
check(shor_35.factors[0] == 5 and shor_35.factors[1] == 7 and
      shor_35.factors[0] * shor_35.factors[1] == 35,
    "shor_factor(35) recovers exact prime factors [5, 7]");
check(shor_35.order_r > 0 and num_mod(shor_35.order_r, 2) == 0 and len(shor_35.circuit.gates) > 20,
    "shor_factor(35) executes multi-qubit modular exponentiation + QFT circuit");

// ── 4. QAOA MaxCut Verification (C4 Cycle, 5-Node Butterfly & House Graphs) ──

// 4A. 4-node cycle C4: maxcut == 4, p = 2 QAOA achieves approximation ratio > 0.88 (in fact ~1.0!)
let c4_edges = [[0, 1], [1, 2], [2, 3], [3, 0]];
let qaoa_c4 = QA.qaoa_maxcut(4, c4_edges, 2);
check(qaoa_c4.ok and num_abs(qaoa_c4.optimal_cut_value - 4.0) < 0.000000001,
    "qaoa_maxcut(C4) identifies optimal_cut_value == 4.0");
check(qaoa_c4.approximation_ratio > 0.88 and qaoa_c4.expected_cut_value > 3.52,
    "qaoa_maxcut(C4, p=2) achieves approximation_ratio > 0.88");
check((qaoa_c4.best_cut_bitstring == "0101" or qaoa_c4.best_cut_bitstring == "1010") and
      num_abs(qaoa_c4.best_cut_value - 4.0) < 0.000000001,
    "qaoa_maxcut(C4, p=2) peaks on exact alternating MaxCut bitstring ('0101' or '1010')");
check(len(qaoa_c4.optimal_gammas) == 2 and len(qaoa_c4.optimal_betas) == 2,
    "qaoa_maxcut(C4, p=2) returns optimal_gammas and optimal_betas of length 2");

// 4B. 5-node butterfly (bowtie) graph: two triangles sharing vertex 2 (6 edges, maxcut == 4)
let butterfly_edges = [[0, 1], [1, 2], [2, 0], [2, 3], [3, 4], [4, 2]];
let qaoa_bfly = QA.qaoa_maxcut(5, butterfly_edges, 2);
check(qaoa_bfly.ok and num_abs(qaoa_bfly.optimal_cut_value - 4.0) < 0.000000001,
    "qaoa_maxcut(butterfly-5) optimal_cut_value == 4.0");
check(qaoa_bfly.approximation_ratio > 0.88 and num_abs(qaoa_bfly.best_cut_value - 4.0) < 0.000000001,
    "qaoa_maxcut(butterfly-5, p=2) achieves approximation_ratio > 0.88 and optimal cut 4.0");

// 4C. 5-node house graph: 4-cycle (0-1-2-3) + roof triangle (2-4-3) (6 edges, maxcut == 5)
let house_edges = [[0, 1], [1, 2], [2, 3], [3, 0], [2, 4], [3, 4]];
let qaoa_house = QA.qaoa_maxcut(5, house_edges, 2);
check(qaoa_house.ok and num_abs(qaoa_house.optimal_cut_value - 5.0) < 0.000000001,
    "qaoa_maxcut(house-5) optimal_cut_value == 5.0");
check(qaoa_house.approximation_ratio > 0.88 and num_abs(qaoa_house.best_cut_value - 5.0) < 0.000000001,
    "qaoa_maxcut(house-5, p=2) achieves approximation_ratio > 0.88 and optimal cut 5.0");

// 4D. Weighted triangle MaxCut verification ([u, v, weight])
let weighted_tri = [[0, 1, 2.5], [1, 2, 3.5], [0, 2, 1.0]];
let qaoa_wt = QA.qaoa_maxcut(3, weighted_tri, 2);
check(qaoa_wt.ok and num_abs(qaoa_wt.optimal_cut_value - 6.0) < 0.000000001 and qaoa_wt.approximation_ratio > 0.90,
    "qaoa_maxcut weighted triangle achieves > 0.90 approximation ratio on optimal cut 6.0");

// ── 5. HHL 2x2 Linear Solver Verification (Spectral QPE + Ancilla Rotation) ──

// 5A. Canonical HPD matrix A = [[1.5, 0.5], [0.5, 1.5]], b = [1.0, 0.0] -> x = [0.75, -0.25]
let hhl_canon = QA.hhl_linear_solver_2x2([[1.5, 0.5], [0.5, 1.5]], [1.0, 0.0]);
check(hhl_canon.ok and hhl_canon.fidelity > 0.9999,
    "hhl_linear_solver_2x2([[1.5,0.5],[0.5,1.5]], [1,0]) state fidelity > 0.9999");
check(num_abs(hhl_canon.classical_solution[0] - 0.75) < 0.000000001 and
      num_abs(hhl_canon.classical_solution[1] + 0.25) < 0.000000001,
    "hhl_linear_solver_2x2 classical reference == [0.75, -0.25]");
check(num_abs(hhl_canon.eigenvalues[0] - 1.0) < 0.000000001 and
      num_abs(hhl_canon.eigenvalues[1] - 2.0) < 0.000000001 and
      hhl_canon.ancilla_success_probability > 0.15,
    "hhl_linear_solver_2x2 spectrum [1.0, 2.0] and non-trivial ancilla post-selection probability");
check(num_abs(hhl_canon.quantum_solution_estimate[0] - 0.75) < 0.01 and
      num_abs(hhl_canon.quantum_solution_estimate[1] + 0.25) < 0.01,
    "hhl_linear_solver_2x2 recovers unnormalized solution [0.75, -0.25] from ancilla probability");

// 5B. General non-dyadic HPD matrix A = [[3.0, 0.8], [0.8, 2.0]], b = [0.6, 0.8]
let hhl_gen1 = QA.hhl_linear_solver_2x2([[3.0, 0.8], [0.8, 2.0]], [0.6, 0.8]);
check(hhl_gen1.ok and hhl_gen1.fidelity > 0.999,
    "hhl_linear_solver_2x2 non-dyadic [[3.0,0.8],[0.8,2.0]] state fidelity > 0.999");

// 5C. Negative off-diagonal HPD matrix A = [[2.5, -0.9], [-0.9, 1.8]], b = [1.0, -0.5]
let hhl_gen2 = QA.hhl_linear_solver_2x2([[2.5, -0.9], [-0.9, 1.8]], [1.0, -0.5]);
check(hhl_gen2.ok and hhl_gen2.fidelity > 0.999,
    "hhl_linear_solver_2x2 coupled [[2.5,-0.9],[-0.9,1.8]] state fidelity > 0.999");

// ── 6. Molecular Quantum Chemistry: Pauli Expectation, Parameter-Shift & H2 VQE ─

// 6A. Exact Pauli expectation on singlet state (|01> - |10>)/sqrt(2): <XX> = <YY> = <ZZ> = -1
let singlet = QC.new_circuit(2);
QC.x(singlet, 0);
QC.h(singlet, 0);
QC.x(singlet, 1);
QC.cnot(singlet, 0, 1);
check(num_abs(QA.pauli_expectation_exact(singlet, [map{ coeff: 1.0, ops: [] }]) - 1.0) < 0.000000000001,
    "pauli_expectation_exact <singlet|II|singlet> == +1.0");
check(num_abs(QA.pauli_expectation_exact(singlet, [map{ coeff: 1.0, ops: [["X", 0], ["X", 1]] }]) + 1.0) < 0.000000000001,
    "pauli_expectation_exact <singlet|XX|singlet> == -1.0");
check(num_abs(QA.pauli_expectation_exact(singlet, [map{ coeff: 1.0, ops: [["Y", 0], ["Y", 1]] }]) + 1.0) < 0.000000000001,
    "pauli_expectation_exact <singlet|YY|singlet> == -1.0");
check(num_abs(QA.pauli_expectation_exact(singlet, [map{ coeff: 1.0, ops: [["Z", 0], ["Z", 1]] }]) + 1.0) < 0.000000000001,
    "pauli_expectation_exact <singlet|ZZ|singlet> == -1.0");

// Verify linear combination with prompt's coefficients
let sample_h_terms = [
    map{ coeff: -1.0523732, ops: [] },
    map{ coeff: 0.1809312, ops: [["X", 0], ["X", 1]] }
];
check(num_abs(QA.pauli_expectation_exact(singlet, sample_h_terms) - (-1.0523732 - 0.1809312)) < 0.000000000001,
    "pauli_expectation_exact evaluates multi-term Pauli Hamiltonian accurately");

// 6B. Parameter-Shift Gradient vs Central Finite Differences (< 1e-9 agreement!)
let h2_eq_ham = QA.h2_hamiltonian_sto3g(0.735);
let test_theta = [0.41, 2.73, -0.29];
let ps_grad = QA.parameter_shift_gradient(QA.build_h2_uccsd_ansatz, test_theta, h2_eq_ham.pauli_terms);
let fd_grad = QA.central_difference_gradient(QA.build_h2_uccsd_ansatz, test_theta, h2_eq_ham.pauli_terms, 0.00001);
check(len(ps_grad) == 3 and
      num_abs(ps_grad[0] - fd_grad[0]) < 0.000000001 and
      num_abs(ps_grad[1] - fd_grad[1]) < 0.000000001 and
      num_abs(ps_grad[2] - fd_grad[2]) < 0.000000001,
    "parameter_shift_gradient agrees with central finite differences to < 1e-9 on H2 ansatz");

// Verify parameter_shift_gradient on a 3-qubit Ry-Rz-CNOT circuit with X, Y, Z Pauli strings
let build_3q = fn(th) {
    let qc = QC.new_circuit(3);
    QC.ry(qc, 0, th[0]);
    QC.rz(qc, 0, th[1]);
    QC.rx(qc, 1, th[2]);
    QC.cnot(qc, 0, 1);
    QC.ry(qc, 2, th[3]);
    QC.cnot(qc, 1, 2);
    return qc;
};
let terms_3q = [
    map{ coeff: 0.75, ops: [["X", 0], ["Y", 1]] },
    map{ coeff: -0.42, ops: [["Z", 1], ["Z", 2]] },
    map{ coeff: 0.31, ops: [["Y", 0], ["X", 2]] }
];
let th3 = [0.62, -0.88, 1.15, -0.37];
let ps3 = QA.parameter_shift_gradient(build_3q, th3, terms_3q);
let fd3 = QA.central_difference_gradient(build_3q, th3, terms_3q, 0.00001);
check(num_abs(ps3[0] - fd3[0]) < 0.000000001 and
      num_abs(ps3[1] - fd3[1]) < 0.000000001 and
      num_abs(ps3[2] - fd3[2]) < 0.000000001 and
      num_abs(ps3[3] - fd3[3]) < 0.000000001,
    "parameter_shift_gradient agrees with central differences to < 1e-9 on 3q Ry-Rz-Rx-CNOT circuit");

// 6C. STO-3G H2 Hamiltonian at Equilibrium R = 0.735 Angstrom
let expected_enuc = 1.0 / (0.735 / 0.529177210903);
check(num_abs(h2_eq_ham.nuclear_repulsion - expected_enuc) < 0.00000001,
    "h2_hamiltonian_sto3g(0.735) exact nuclear repulsion 1 / (R / 0.5291772109)");
check(num_abs(h2_eq_ham.electronic_identity - (-1.0523732458)) < 0.000001 and
      num_abs(h2_eq_ham.coefficients.XX - 0.1809311998) < 0.000001,
    "h2_hamiltonian_sto3g(0.735) matches authentic STO-3G parity coefficients");
check(num_abs(h2_eq_ham.hartree_fock_energy - (-1.116999)) < 0.0001 and
      num_abs(h2_eq_ham.fci_energy - (-1.137306)) < 0.0001,
    "h2_hamiltonian_sto3g(0.735) HF (-1.1170 Ha) and FCI (-1.1373 Ha) reference energies");

// 6D. VQE Optimization of H2 at Equilibrium R = 0.735 A to Chemical Accuracy (< 0.0016 Ha)
let vqe_eq = QA.vqe_h2_molecule(0.735, 80);
check(vqe_eq.ok and vqe_eq.chemical_accuracy_achieved == true,
    "vqe_h2_molecule(0.735) converges to chemical accuracy");
check(vqe_eq.energy_error_hartree < 0.0016 and num_abs(vqe_eq.vqe_energy - (-1.137306)) < 0.0016,
    "vqe_h2_molecule(0.735) |E_vqe - E_fci| < 0.0016 Ha (E_0 ~ -1.1373 Ha)");
check(vqe_eq.vqe_energy < vqe_eq.hartree_fock_energy - 0.018 and vqe_eq.vqe_energy < vqe_eq.initial_energy,
    "vqe_h2_molecule(0.735) recovers ~20.3 mHa electron correlation energy below Hartree-Fock");
check(vqe_eq.gradient_norm < 0.001,
    "vqe_h2_molecule(0.735) converges to stationary point with gradient_norm < 1e-3");

// 6E. H2 Potential Energy Surface / Dissociation Curve (R = 0.40, 0.735, 1.20, 2.00 A)
let vqe_r040 = QA.vqe_h2_molecule(0.40, 80);
let vqe_r120 = QA.vqe_h2_molecule(1.20, 80);
let vqe_r200 = QA.vqe_h2_molecule(2.00, 80);
check(vqe_r040.ok and vqe_r120.ok and vqe_r200.ok,
    "vqe_h2_molecule achieves chemical accuracy across repulsive, stretched, and dissociated R");
check(vqe_eq.vqe_energy < vqe_r040.vqe_energy and vqe_eq.vqe_energy < vqe_r200.vqe_energy,
    "H2 dissociation curve: E(0.735) < E(0.40) and E(0.735) < E(2.00)");
check(vqe_eq.vqe_energy < vqe_r120.vqe_energy and vqe_r120.vqe_energy < vqe_r200.vqe_energy,
    "H2 dissociation curve monotonically rises from equilibrium 0.735 -> 1.20 -> 2.00 A");

// ── 7. 156-Qubit IBM Heron r2 Heavy-Hex Topology, Calibration Router & EstimatorV2 ─

// 7A. Verify canonical 156-qubit Heavy-Hex graph of IBM Heron r2 (ibm_fez / ibm_kingston / ibm_marrakesh)
let hh_graph = QA.heron_r2_156q_heavy_hex_graph();
check(hh_graph.ok and hh_graph.n_qubits == 156,
    "heron_r2_156q_heavy_hex_graph has exactly 156 physical qubits (0..155)");
check(hh_graph.n_undirected_edges == 176 and hh_graph.n_directed_edges == 352,
    "heron_r2_156q_heavy_hex_graph has 176 undirected (352 directed) Heavy-Hex couplers");
check(hh_graph.max_degree == 3 and not map_has(hh_graph.degree_histogram, "4"),
    "heron_r2_156q_heavy_hex_graph is strictly Heavy-Hex (max vertex degree == 3)");

// Check real Heron r2 coupler edges [0,1],[1,2],[2,3],[3,4],[3,16],[16,23],[7,17],[21,36]
let has_edge = fn(g_obj, u, v) {
    let nbrs = g_obj.adjacency[u];
    let i = 0;
    while i < len(nbrs) {
        if nbrs[i] == v { return true; }
        i = i + 1;
    }
    return false;
};
check(has_edge(hh_graph, 0, 1) and has_edge(hh_graph, 1, 2) and
      has_edge(hh_graph, 2, 3) and has_edge(hh_graph, 3, 4) and
      has_edge(hh_graph, 3, 16) and has_edge(hh_graph, 16, 23),
    "heron_r2_156q_heavy_hex_graph includes real [0,1],[1,2],[2,3],[3,4],[3,16],[16,23] bridge edges");
check(has_edge(hh_graph, 7, 17) and has_edge(hh_graph, 17, 27) and
      has_edge(hh_graph, 21, 36) and has_edge(hh_graph, 36, 41) and
      has_edge(hh_graph, 154, 155),
    "heron_r2_156q_heavy_hex_graph alternates even [3,7,11,15] and odd [1,5,9,13] bridge columns to q155");

// Verify full 156-qubit connectivity via BFS from qubit 0
let bfs_vis = map{ "0": true };
let bfs_q = [0];
let head_i = 0;
while head_i < len(bfs_q) {
    let curr = bfs_q[head_i];
    let nbrs = hh_graph.adjacency[curr];
    let ni = 0;
    while ni < len(nbrs) {
        let nb = nbrs[ni];
        if not map_has(bfs_vis, str(nb)) {
            bfs_vis[str(nb)] = true;
            push(bfs_q, nb);
        }
        ni = ni + 1;
    }
    head_i = head_i + 1;
}
check(len(bfs_q) == 156, "heron_r2_156q_heavy_hex_graph forms a single 156-qubit connected component");

// 7B. Calibration-aware subgraph selection + zero-SWAP star circuit on Heavy-Hex T-junction
let cal_map = map{
    "23-22": 0.0007,
    "23-24": 0.0008,
    "16-23": 0.0009,
    "0-1": 0.0950,
    "1-2": 0.0950,
    "2-3": 0.0950,
    "3-4": 0.0950
};
let star4 = QC.new_circuit(4);
QC.h(star4, 0);
QC.ry(star4, 0, 0.57);
QC.cnot(star4, 0, 1);
QC.cnot(star4, 0, 2);
QC.cnot(star4, 0, 3);
QC.rz(star4, 3, -0.33);

let routed_star = QA.route_on_heavy_hex_156q(star4, hh_graph, cal_map);
check(routed_star.ok and routed_star.heavy_hex_edge_compliant and routed_star.basis_compliant,
    "route_on_heavy_hex_156q star4 complies 100% with Heavy-Hex edges and {rz,sx,x,cz} basis");
check(routed_star.fidelity > 0.999999999999,
    "route_on_heavy_hex_156q star4 achieves exact unitary statevector fidelity == 1.0");
check(routed_star.physical_qubits[0] == 23 and routed_star.swap_gates_inserted == 0,
    "route_on_heavy_hex_156q places hub qubit on low-noise T-junction $23 ([23,22,24,16]) with 0 SWAPs");

// 7C. Noise-weighted Dijkstra SWAP routing of non-adjacent 4-qubit QFT + Toffoli circuit
let nonadj_qc = QA.qft_circuit(4, false);
QC.toffoli(nonadj_qc, 0, 2, 3);
QC.cnot(nonadj_qc, 0, 3);
let routed_qft4 = QA.route_on_heavy_hex_156q(nonadj_qc, hh_graph, cal_map);
check(routed_qft4.ok and routed_qft4.heavy_hex_edge_compliant and routed_qft4.basis_compliant,
    "route_on_heavy_hex_156q routes all-to-all QFT4 + Toffoli strictly onto Heavy-Hex couplers");
check(routed_qft4.swap_chains_inserted >= 1 and routed_qft4.swap_gates_inserted >= 2,
    "route_on_heavy_hex_156q inserts Dijkstra SWAP chains for non-adjacent 2-qubit gates");
check(routed_qft4.fidelity > 0.999999999999,
    "route_on_heavy_hex_156q QFT4 + Toffoli achieves exact unitary equivalence F == 1.0");
check(str_contains(routed_qft4.openqasm3_isa, "OPENQASM 3.0;") and
      str_contains(routed_qft4.openqasm3_isa, "cz $") and
      not str_contains(routed_qft4.openqasm3_isa, "\ncx "),
    "route_on_heavy_hex_156q emits valid physical-qubit ($q) Heron r2 ISA OpenQASM 3.0");

// 7D. Scale test: route 30-qubit GHZ/ladder circuit on 156-qubit Heavy-Hex topology
let large30 = QC.new_circuit(30);
QC.h(large30, 0);
let lq = 0;
while lq < 29 {
    QC.cnot(large30, lq, lq + 1);
    lq = lq + 1;
}
let routed_30 = QA.route_on_heavy_hex_156q(large30, hh_graph, nil);
check(routed_30.ok and routed_30.heavy_hex_edge_compliant and routed_30.basis_compliant and
      len(routed_30.physical_qubits) == 30,
    "route_on_heavy_hex_156q scales cleanly to 30-qubit circuit on 156q Heavy-Hex chip");

// 7E. IBM Runtime EstimatorV2 Client Formatting, Local Exact Fallback & Parser Verification
let est_terms = [
    map{ coeff: -1.05, ops: [] },
    map{ coeff: 0.39, ops: [["X", 0], ["Z", 1]] },
    map{ coeff: -0.22, ops: [["Z", 0], ["Z", 1]] }
];
let est_res = QA.run_ibm_estimator_v2(vqe_eq.circuit, est_terms, "ibm_fez", nil);
check(est_res.ok and est_res.qpu_submitted == false and
      est_res.mode == "local_statevector_estimator_fallback",
    "run_ibm_estimator_v2 uses local_statevector_estimator_fallback when no live token is passed");
check(est_res.program_id == "estimator" and est_res.version == 2 and est_res.backend == "ibm_fez",
    "run_ibm_estimator_v2 formats program_id='estimator', version=2 for ibm_fez");
check(num_abs(est_res.observables["II"] - (-1.05)) < 0.000000000001 and
      num_abs(est_res.observables["XZ"] - 0.39) < 0.000000000001 and
      num_abs(est_res.observables["ZZ"] - (-0.22)) < 0.000000000001,
    "run_ibm_estimator_v2 formats EstimatorV2 observables map ('II', 'XZ', 'ZZ')");
check(len(est_res.pubs) == 1 and len(est_res.pubs[0]) == 2 and
      str_starts_with(est_res.pubs[0][0], "OPENQASM 3.0;") and
      not str_contains(est_res.pubs[0][0], "measure") and
      is_map(est_res.pubs[0][1]),
    "run_ibm_estimator_v2 builds pubs=[[isa_qasm, obs_map]] without mid/final classical measure");

// Verify EstimatorV2 local fallback on full H2 VQE optimal circuit matches FCI energy to < 1e-12
let est_h2 = QA.run_ibm_estimator_v2(vqe_eq.circuit, h2_eq_ham.pauli_terms, "ibm_kingston", nil);
check(num_abs(est_h2.expectation_value - vqe_eq.vqe_energy) < 0.000000000001 and
      num_abs(est_h2.expectation_value - h2_eq_ham.fci_energy) < 0.0016,
    "run_ibm_estimator_v2 exact fallback matches H2 STO-3G VQE ground energy (-1.1373 Ha)");

// Verify parse_estimator_v2_results on canonical IBM Runtime REST v1 EstimatorV2 JSON payload
let mock_est_json = json_stringify(map{
    results: [
        map{
            data: map{
                evs: [-1.1373060364],
                stds: [0.000412]
            }
        }
    ]
});
let parsed_est = QA.parse_estimator_v2_results(mock_est_json);
check(parsed_est.ok and
      num_abs(parsed_est.expectation_value - (-1.1373060364)) < 0.0000000001 and
      num_abs(parsed_est.std_error - 0.000412) < 0.0000000001,
    "parse_estimator_v2_results extracts evs and stds from IBM Runtime EstimatorV2 response");

// Verify all 7 tabulated STO-3G H2 bond distances & physical asymptotics
let h2_035 = QA.h2_hamiltonian_sto3g(0.35);
let h2_050 = QA.h2_hamiltonian_sto3g(0.50);
let h2_100 = QA.h2_hamiltonian_sto3g(1.00);
let h2_150 = QA.h2_hamiltonian_sto3g(1.50);
let h2_200 = QA.h2_hamiltonian_sto3g(2.00);
let h2_250 = QA.h2_hamiltonian_sto3g(2.50);
check(h2_035.fci_energy > h2_050.fci_energy and h2_050.fci_energy > h2_eq_ham.fci_energy,
    "STO-3G H2 FCI energy decreases monotonically along repulsive wall 0.35 -> 0.50 -> 0.735 A");
check(h2_eq_ham.fci_energy < h2_100.fci_energy and h2_100.fci_energy < h2_150.fci_energy and
      h2_150.fci_energy < h2_200.fci_energy and h2_200.fci_energy < h2_250.fci_energy,
    "STO-3G H2 FCI energy increases monotonically toward dissociation 0.735 -> 1.0 -> 1.5 -> 2.0 -> 2.5 A");
check(num_abs(h2_250.fci_energy - (-0.936056)) < 0.001,
    "STO-3G H2 at R=2.50 A approaches isolated 2*H(1s) STO-3G dissociation limit (-0.936 Ha)");

// Verify 156-qubit physical observable mapping & OPSEC secret isolation when live == false
let phys_obs_keys = map_keys(est_res.physical_observables);
check(len(phys_obs_keys) == 3 and len(phys_obs_keys[0]) == 156,
    "format_estimator_v2_observables maps logical Paulis onto 156-qubit Heron r2 register");

let synth_secret = "SYNTH_OFFLINE_CRED_994411";
let est_opsec = QA.run_ibm_estimator_v2(vqe_eq.circuit, est_terms, "ibm_marrakesh", map{
    live: false,
    api_key: synth_secret
});
let est_opsec_dump = json_stringify(est_opsec);
check(est_opsec.ok and est_opsec.qpu_submitted == false and
      not str_contains(est_opsec_dump, synth_secret),
    "run_ibm_estimator_v2 never leaks passed credentials in returned EstimatorV2 map");

print "QUANTUM_ALGORITHMS_HEAVYHEX_TEST_PASS checks=" + str(passed_checks) + "/" + str(total_checks) +
      " vqe_e0=" + str(vqe_eq.vqe_energy) + " fci_e0=" + str(vqe_eq.fci_energy) +
      " c4_ratio=" + str(qaoa_c4.approximation_ratio) + " hhl_fid=" + str(hhl_canon.fidelity);

