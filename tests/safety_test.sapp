// tests/safety_test.sapp
let SAFETY = import("../stdlib/safety_guard.sapp");

let checks = 0;
fn check(cond, msg) {
    if not cond {
        throw "FAIL [" + msg + "]";
    }
    checks = checks + 1;
}

let res = SAFETY.verify_full_memory_and_general_safety();
check(res.ok == true, "verify_full_memory_and_general_safety overall ok");

// 1. Spatial memory safety checks
let sp = res.spatial_memory_safety;
check(sp.ok == true, "spatial memory safety ok");
check(sp.elf64_valid == true, "ELF64 header valid");
check(sp.pe32plus_wx_split == true, "PE32+ W^X split enforced");
check(sp.pe32plus_nx_compatible == true, "PE32+ NX_COMPAT enforced");
check(sp.rwx_segments_count == 0, "zero RWX segments");
check(sp.bounds_checked_oob_trapped == 3, "OOB indices [-1, 4, 999] trapped");

// 2. Temporal memory safety checks
let tm = res.temporal_memory_safety;
check(tm.ok == true, "temporal memory safety ok");
check(tm.uaf_attempts_trapped == 1, "Use-After-Free trapped");
check(tm.double_free_attempts_trapped == 1, "Double-Free trapped");
check(tm.untrapped_uaf_escapes == 0, "zero UAF escapes");
check(tm.leaked_fds_or_handles == 0, "zero leaked FDs or handles");

// 3. Initialization & type safety checks
let it = res.initialization_and_type_safety;
check(it.ok == true, "initialization and type safety ok");
check(it.x64_prologue_registers_zero_initialized == true, "x64 prologue zero-initializes r13/r12/r14");
check(it.c99_undeclared_read_rejected == true, "C99 undeclared variable read rejected");
check(it.c99_undeclared_assign_rejected == true, "C99 undeclared variable assignment rejected");
check(it.nan_fail_closed_guard_active == true, "IEEE-754 NaN fail-closed guard active");

// 4. Arithmetic & generalized Barrett modulo safety checks
let ar = res.arithmetic_and_generalized_modulo_safety;
check(ar.ok == true, "arithmetic and generalized modulo safety ok");
check(ar.c99_compile_time_div_zero_caught == true, "C99 compile-time div by zero rejected");
check(ar.c99_compile_time_mod_zero_caught == true, "C99 compile-time mod by zero rejected");
check(ar.c99_runtime_div_mod_ub_guards == true, "C99 runtime LONG_MIN/-1 & div-by-zero guards present");
check(ar.x64_hardware_ud2_trap_emitted == true, "x64 hardware ud2 trap emitted for division");
check(ar.live_x64_exact_match == true, "live x64 Barrett reciprocal exact match across [7, 37, 251, 997, 4093, 65521, 1000003]");

// 5. Supply-Chain & Toolchain Attack Defense checks
let sc = res.supply_chain_and_toolchain_security;
check(sc.ok == true, "supply-chain and toolchain security overall ok");
check(sc.install_hook_section_blocked == true, "forbidden [scripts] / [postinstall] manifest section blocked");
check(sc.install_hook_key_blocked == true, "forbidden preinstall/postinstall manifest key blocked");
check(sc.unencrypted_http_dep_blocked == true, "unencrypted http:// dependency source blocked");
check(sc.trojan_source_bidi_blocked == true, "Trojan Source CVE-2021-42574 Unicode Bidi override blocked");
check(sc.typosquats_blocked == 2, "Levenshtein distance-1 typosquats ('crpto', 'stdlb') blocked");
check(sc.dependency_confusion_blocked == 1, "private-scope dependency confusion ('internal-billing' on public registry) blocked");
check(sc.transitive_capability_escalations_blocked == 2, "transitive capability escalations (net_connect, proc_spawn) blocked");
check(sc.ddc_x64_bit_for_bit_reproducible == true, "Diverse Double-Compiling x64 bit-for-bit reproducible");
check(sc.ddc_c99_bit_for_bit_reproducible == true, "Diverse Double-Compiling C99 bit-for-bit reproducible");
check(sc.xz_binary_blobs_blocked == 2, "XZ-style smuggled .so/.dll binary test blobs blocked");
check(sc.zip_slip_traversal_blocked == 1, "Zip-Slip '../' path traversal blocked");
check(sc.toctou_source_tamper_rejected == true, "TOCTOU source tamper & lockfile SHA-256 mismatch rejected");

print "MEMORY_GENERAL_AND_SUPPLY_CHAIN_SAFETY_PASS checks=" + str(checks);

