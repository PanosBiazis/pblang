// tests/v3_static_si_contracts_lsp_test.sapp
// PBLang v3.0.0 Comprehensive Verification Suite:
//   1. 4-Pass Static Checker (Undefined Symbol Levenshtein Suggestions, Arity, Const, Unreachable, Enum Match, Strict Types)
//   2. Zero-Cost Compile-Time 9D SI & EUR/USD Currency Dimensional Type System (`num[unit]`)
//   3. Compile-Time Proof-Carrying Contracts (`requires`/`ensures` & Division Safety) via Tarski CAD & Cooper-Presburger
//   4. JSON-RPC 2.0 LSP 3.17 Language Server (`initialize`, `didOpen`, `publishDiagnostics`, `hover`, `completion`, `definition`, `documentSymbol`, `codeAction`, `formatting`, `shutdown`/`exit`)
//   5. Stateful Interactive REPL (`eval_repl_line`, multi-line SI state, `:type`, `:si`, `:prove`, `:vars`, `:check`, `:reset`, `:quit`)
//   6. AST-Instrumented Deterministic Time-Travel Debugger (`step_forward`, `step_backward`, `set_breakpoint`, `inspect_locals`) & Dark-Mode SVG Flamegraph Profiler
//   7. Markdown Documentation Generator, v3.0 Code Formatter & VS Code v3.0.0 Extension Integration

let SC = import("stdlib:static_checker.sapp");
let LSP = import("stdlib:lsp_server.sapp");
let REPL = import("stdlib:repl_interactive.sapp");
let PD = import("stdlib:profiler_debugger.sapp");
let DG = import("stdlib:docgen_cli.sapp");

let assertions_passed = 0;

fn check(cond, msg) {
    assert(cond, msg);
    if not cond {
        throw "ASSERTION FAILED: " + msg;
    }
    assertions_passed = assertions_passed + 1;
}

fn has_diag_code(rep, target_code) {
    let diags = rep["diagnostics"];
    let i = 0;
    while i < len(diags) {
        if diags[i]["code"] == target_code { return true; }
        i = i + 1;
    }
    return false;
}

fn find_diag_by_code(rep, target_code) {
    let diags = rep["diagnostics"];
    let i = 0;
    while i < len(diags) {
        if diags[i]["code"] == target_code { return diags[i]; }
        i = i + 1;
    }
    return nil;
}

println("=== PBLang v3.0.0 Static Checker, 9D SI/EUR Units, CAD/Presburger Contracts, LSP, REPL, Time-Travel Debugger & Docgen Suite ===");

// ── 0. Module Versions ────────────────────────────────────────────────────────
check(SC.STATIC_CHECKER_VERSION == "3.0.0", "STATIC_CHECKER_VERSION == 3.0.0");
check(LSP.LSP_SERVER_VERSION == "3.0.0", "LSP_SERVER_VERSION == 3.0.0");
check(REPL.REPL_VERSION == "3.0.0", "REPL_VERSION == 3.0.0");
check(PD.PROFILER_DEBUGGER_VERSION == "3.0.0", "PROFILER_DEBUGGER_VERSION == 3.0.0");
check(DG.DOCGEN_VERSION == "3.0.0", "DOCGEN_VERSION == 3.0.0");
println("  [PASS] 0. All 5 v3.0.0 modules loaded with version 3.0.0");

// ── 1. Pass 1: Lexical, Scope, Undefined Symbol Levenshtein, Arity, Const, Unreachable, Enum Match & Exports ──
check(SC.levenshtein_distance("prntln", "println") == 1, "Levenshtein('prntln', 'println') == 1");
check(SC.suggest_symbol("to_string", ["str", "len", "println"]) == "str", "suggest_symbol maps 'to_string' -> 'str'");

let p1_undef = SC.check_source("let x = 42;\nlet s = to_string(x);\n");
check(not p1_undef["ok"] and p1_undef["error_count"] == 1, "to_string(x) produces 1 static error");
let d_undef = find_diag_by_code(p1_undef, "UNDEFINED_SYMBOL");
check(d_undef != nil, "UNDEFINED_SYMBOL diagnostic emitted");
check(d_undef["line"] == 2 and d_undef["col"] == 9, "Exact {line: 2, col: 9} span for to_string");
check(d_undef["suggestion"] == "str", "Suggestion field is 'str'");
check(str_contains(d_undef["message"], "Undefined symbol 'to_string' — did you mean 'str'?"), "Exact Levenshtein/idiom diagnostic text");

let p1_typo = SC.check_source("prntln(\"hi\");\n");
let d_typo = find_diag_by_code(p1_typo, "UNDEFINED_SYMBOL");
check(d_typo != nil and d_typo["suggestion"] == "println", "Levenshtein suggests 'println' for 'prntln'");

let p1_arity = SC.check_source("
fn greet(name: string, punctuation: string = \"!\") -> string {
    return \"Hello \" + name + punctuation;
}
fn sum_all(first: num, ...rest) -> num {
    return first + len(rest);
}
let ok1 = greet(\"Ada\");
let ok2 = greet(\"Ada\", \"?\");
let ok3 = sum_all(1, 2, 3, 4);
let bad1 = greet();
let bad2 = greet(\"a\", \"b\", \"c\");
");
check(p1_arity["error_count"] == 2 and has_diag_code(p1_arity, "ARITY_MISMATCH"), "Arity check respects defaults & ...rest while catching too-few and too-many args");

let p1_const = SC.check_source("const MAX_ITEMS = 100;\nMAX_ITEMS = 200;\n");
check(has_diag_code(p1_const, "CONST_REASSIGNMENT"), "Reassigning const variable emits CONST_REASSIGNMENT");

let p1_unreach = SC.check_source("fn demo() {\n    return 1;\n    let dead = 2;\n}\n");
check(has_diag_code(p1_unreach, "UNREACHABLE_CODE"), "Statement after return emits UNREACHABLE_CODE");

let p1_enum_bad = SC.check_source("
enum Light { Red, Yellow, Green }
let st: Light = Light.Red;
match st {
    Light.Red => 1,
    Light.Yellow => 2
}
");
check(has_diag_code(p1_enum_bad, "NON_EXHAUSTIVE_MATCH"), "Missing enum variant 'Green' without '_'/'else' emits NON_EXHAUSTIVE_MATCH");

let p1_enum_ok = SC.check_source("
enum Light { Red, Yellow, Green }
let st: Light = Light.Red;
match st {
    Light.Red => 1,
    Light.Yellow => 2,
    Light.Green => 3
}
");
check(p1_enum_ok["ok"], "Exhaustive enum match passes with 0 errors");

let p1_imp = SC.check_source("
let DG_MOD = import(\"stdlib:docgen_cli.sapp\");
let s = DG_MOD.format_source(\"let a=1;\");
let bad = DG_MOD.non_existent_export();
");
check(has_diag_code(p1_imp, "UNKNOWN_MODULE_EXPORT"), "Imported module export resolution flags missing export while accepting valid export");
println("  [PASS] 1. Pass 1 (Levenshtein suggestions, arity, const, unreachable, enum exhaustiveness & module exports)");

// ── 2. Pass 2: Gradual Type Inference & Strict Type Checking (`--strict`) ─────
let p2_ops = SC.check_source("let bad_sub = \"hello\" - 5;\nlet bad_mul = true * 3;\n", map{ strict: true });
check(p2_ops["error_count"] == 2 and has_diag_code(p2_ops, "TYPE_MISMATCH"), "Flags 'hello' - 5 and true * 3");

let p2_call = SC.check_source("let x = 42;\nlet y = x(10);\n", map{ strict: true });
check(has_diag_code(p2_call, "NOT_CALLABLE"), "Calling a numeric variable emits NOT_CALLABLE");

let p2_ret = SC.check_source("fn compute_score() -> num {\n    return \"not a number\";\n}\n", map{ strict: true });
check(has_diag_code(p2_ret, "RETURN_TYPE_MISMATCH"), "Returning string from fn() -> num emits RETURN_TYPE_MISMATCH");

let p2_opt = SC.check_source("
fn maybe_num(flag: bool) -> Option<num> {
    if flag { return nil; }
    return 3.14;
}
let res_ok: Option<num> = maybe_num(false);
", map{ strict: true });
check(p2_opt["ok"], "Option<num> accepts both nil and num under --strict");
println("  [PASS] 2. Pass 2 (Gradual type inference & --strict checking)");

// ── 3. Pass 3: Compile-Time 9D SI Units & EUR/USD Currency Algebra ────────────
let p3_valid = SC.check_source("
fn kinetic_energy(m: num[kg], v: num[m/s]) -> num[J] {
    return 0.5 * m * v^2;
}
let v: num[m/s] = 12.0;
let t: num[s] = 5.0;
let d = v * t;
let m: num[kg] = 4.0;
let ke = 0.5 * m * v^2;
let ke2: num[J] = kinetic_energy(m, v);
let side: num[m] = sqrt(d * d);
let phase = sin(d / side);
let net_eur: num[EUR] = 100.0;
let tax_usd: num[USD] = 25.0;
let fx: num[EUR/USD] = 0.92;
let gross_eur: num[EUR] = net_eur + tax_usd * fx;
", map{ strict: true });

check(p3_valid["ok"] and p3_valid["error_count"] == 0, "Valid SI mechanics & EUR/USD FX algebra has 0 errors");
check(p3_valid["units_inferred"]["d"]["type_str"] == "num[m]", "v (m/s) * t (s) infers exact type num[m]");
check(p3_valid["units_inferred"]["d"]["dim_unicode"] == "[L¹]", "d has 9D dimension [L¹]");
check(p3_valid["units_inferred"]["ke"]["type_str"] == "num[J]", "0.5 * m * v^2 infers exact type num[J]");
check(p3_valid["units_inferred"]["ke"]["dim_unicode"] == "[M·L²·T⁻²]", "ke has 9D dimension [M·L²·T⁻²]");
check(p3_valid["units_inferred"]["gross_eur"]["type_str"] == "num[EUR]", "net_eur + tax_usd * fx infers num[EUR]");

let p3_mismatch_si = SC.check_source("
let v: num[m/s] = 12.0;
let d: num[m] = 60.0;
let bad1 = v + d;
let f: num[N] = 10.0;
let e: num[J] = 20.0;
let bad2 = f + e;
", map{ strict: true });
check(p3_mismatch_si["error_count"] == 2 and has_diag_code(p3_mismatch_si, "DIMENSIONAL_MISMATCH"), "m/s + m and N + J both emit DIMENSIONAL_MISMATCH");
let d_si = find_diag_by_code(p3_mismatch_si, "DIMENSIONAL_MISMATCH");
check(str_contains(d_si["message"], "Ασυμβατότητα διαστάσεων"), "DIMENSIONAL_MISMATCH includes bilingual EN + EL explanation");

let p3_mismatch_ccy = SC.check_source("
let net_eur: num[EUR] = 100.0;
let tax_usd: num[USD] = 20.0;
let bad_total = net_eur + tax_usd;
", map{ strict: true });
check(not p3_mismatch_ccy["ok"] and has_diag_code(p3_mismatch_ccy, "DIMENSIONAL_MISMATCH"), "EUR + USD without FX rate emits DIMENSIONAL_MISMATCH");
check(str_contains(p3_mismatch_ccy["diagnostics"][0]["message"], "num[EUR/USD]"), "Currency mismatch suggests explicit num[EUR/USD] exchange rate");

let p3_trig = SC.check_source("
let t: num[s] = 3.0;
let a = sin(t);
let b = exp(t);
", map{ strict: true });
check(p3_trig["error_count"] == 2 and has_diag_code(p3_trig, "TRANSCENDENTAL_NON_DIMENSIONLESS"), "sin(t) and exp(t) on num[s] emit TRANSCENDENTAL_NON_DIMENSIONLESS");
println("  [PASS] 3. Pass 3 (Zero-cost 9D SI units, Joule inference, EUR/USD FX algebra & transcendental checks)");

// ── 4. Pass 4: Proof-Carrying Contracts (`CAD` & `Presburger`) ────────────────
let p4_vat_ok = SC.check_source("
fn apply_vat(net: num[EUR], rate: num) -> num[EUR]
  requires net >= 0 and rate >= 0 and rate <= 1
  ensures result >= net
{
    return net * (1 + rate);
}
", map{ strict: true });
check(p4_vat_ok["ok"] and len(p4_vat_ok["contracts"]) == 1, "apply_vat compiles with 0 errors and 1 contract proof");
check(p4_vat_ok["contracts"][0]["status"] == "PROVED_MATHEMATICALLY" and p4_vat_ok["contracts"][0]["engine"] == "CAD", "apply_vat is PROVED_MATHEMATICALLY by Tarski CAD");

let p4_disc_bad = SC.check_source("
fn buggy_discount(price: num[EUR], pct: num) -> num[EUR]
  requires price >= 0 and pct >= 0 and pct <= 150
  ensures result >= 0
{
    return price * (1 - pct / 100);
}
", map{ strict: true });
check(not p4_disc_bad["ok"] and has_diag_code(p4_disc_bad, "CONTRACT_REFUTED"), "buggy_discount refuted at compile time");
check(p4_disc_bad["contracts"][0]["status"] == "REFUTED_COUNTEREXAMPLE", "buggy_discount status == REFUTED_COUNTEREXAMPLE");
check(p4_disc_bad["contracts"][0]["counterexample"] != nil and p4_disc_bad["contracts"][0]["witness_summary"] != "", "buggy_discount provides concrete counterexample witness");

let p4_div_bad = SC.check_source("
fn safe_div_bug(a: num, b: num) -> num requires b >= 0 {
    return a / b;
}
", map{ strict: true });
check(not p4_div_bad["ok"] and has_diag_code(p4_div_bad, "DIVISION_BY_ZERO_REFUTED"), "safe_div_bug (b >= 0) refuted by CAD for division by zero");
check(str_contains(p4_div_bad["contracts"][0]["witness_summary"], "b = 0"), "safe_div_bug counterexample witnesses b = 0");

let p4_div_ok = SC.check_source("
fn safe_div_ok(a: num, b: num) -> num requires b > 0 {
    return a / b;
}
", map{ strict: true });
check(p4_div_ok["ok"] and p4_div_ok["contracts"][0]["status"] == "PROVED_MATHEMATICALLY", "safe_div_ok (b > 0) proved division-safe by CAD");

let p4_pres_ok = SC.check_source("
fn step_even(k: int) -> int requires k >= 0 ensures divides(2, result) {
    return 2 * k + 6;
}
", map{ strict: true });
check(p4_pres_ok["ok"] and p4_pres_ok["contracts"][0]["engine"] == "Presburger" and p4_pres_ok["contracts"][0]["proved"] == true, "Presburger proves divides(2, 2*k + 6)");

let p4_pres_bad = SC.check_source("
fn bad_odd(k: int) -> int requires k >= 0 ensures divides(2, result) {
    return 2 * k + 1;
}
", map{ strict: true });
check(not p4_pres_bad["ok"] and p4_pres_bad["contracts"][0]["engine"] == "Presburger" and p4_pres_bad["contracts"][0]["status"] == "REFUTED_COUNTEREXAMPLE", "Presburger refutes divides(2, 2*k + 1)");

let cli_chk = SC.cli_check_entry(["--no-exit", "--json", "stdlib/docgen_cli.sapp"]);
check(cli_chk["ok"] and cli_chk["total_errors"] == 0, "cli_check_entry checks stdlib/docgen_cli.sapp with 0 errors");
println("  [PASS] 4. Pass 4 (Tarski CAD & Cooper-Presburger proof-carrying contracts + division safety)");

// ── 5. LSP 3.17 Full Lifecycle & UTF-8 Wire Framing (`stdlib/lsp_server.sapp`) ─
let lsp_st = LSP.create_lsp_state();
let init_r = LSP.handle_lsp_message(lsp_st, map{
    jsonrpc: "2.0",
    id: 1,
    method: "initialize",
    params: map{ rootUri: "file:///workspace/demo" }
});
let caps = init_r["result"]["capabilities"];
check(caps["textDocumentSync"] == 1 and caps["hoverProvider"] == true, "LSP initialize advertises textDocumentSync=1 and hoverProvider=true");
check(caps["definitionProvider"] == true and caps["documentSymbolProvider"] == true and caps["documentFormattingProvider"] == true and caps["codeActionProvider"] == true, "LSP initialize advertises definition, documentSymbol, formatting, and codeAction");

LSP.handle_lsp_message(lsp_st, map{ jsonrpc: "2.0", method: "initialized", params: map{} });

let doc_uri = "file:///workspace/demo/billing.sapp";
let doc_txt = "/// Computes VAT-inclusive EUR gross total.\nfn apply_vat(net: num[EUR], rate: num) -> num[EUR] requires net >= 0 and rate >= 0 and rate <= 1 ensures result >= net {\nreturn net*(1+rate);\n}\nlet m: num[kg] = 2.0;\nlet v: num[m/s] = 3.0;\nlet ke = 0.5 * m * v^2;\nlet bad_str = to_string(ke);\n";

let pub_diag = LSP.handle_lsp_message(lsp_st, map{
    jsonrpc: "2.0",
    method: "textDocument/didOpen",
    params: map{
        textDocument: map{ uri: doc_uri, languageId: "pblang", version: 1, text: doc_txt }
    }
});
check(pub_diag["method"] == "textDocument/publishDiagnostics", "didOpen emits textDocument/publishDiagnostics");
check(len(pub_diag["params"]["diagnostics"]) == 1 and pub_diag["params"]["diagnostics"][0]["code"] == "UNDEFINED_SYMBOL", "LSP diagnostics pinpoints UNDEFINED_SYMBOL for to_string");

let hov_ke = LSP.handle_lsp_message(lsp_st, map{
    jsonrpc: "2.0",
    id: 2,
    method: "textDocument/hover",
    params: map{ textDocument: map{ uri: doc_uri }, position: map{ line: 6, character: 5 } }
});
let hov_ke_md = hov_ke["result"]["contents"]["value"];
check(str_contains(hov_ke_md, "num[J]") and str_contains(hov_ke_md, "[M·L²·T⁻²] = J"), "Hover on ke displays num[J] and [M·L²·T⁻²] = J");

let hov_fn = LSP.handle_lsp_message(lsp_st, map{
    jsonrpc: "2.0",
    id: 3,
    method: "textDocument/hover",
    params: map{ textDocument: map{ uri: doc_uri }, position: map{ line: 1, character: 6 } }
});
let hov_fn_md = hov_fn["result"]["contents"]["value"];
check(str_contains(hov_fn_md, "✓ Proved by Tarski CAD") and str_contains(hov_fn_md, "Computes VAT-inclusive EUR gross total."), "Hover on apply_vat displays Tarski CAD proof badge and docstring");

let comp_r = LSP.handle_lsp_message(lsp_st, map{
    jsonrpc: "2.0",
    id: 4,
    method: "textDocument/completion",
    params: map{ textDocument: map{ uri: doc_uri }, position: map{ line: 6, character: 1 } }
});
check(len(comp_r["result"]["items"]) > 100, "LSP completion returns builtins, stdlib modules, keywords, and in-scope symbols");

let comp_unit = LSP.handle_lsp_message(lsp_st, map{
    jsonrpc: "2.0",
    id: 41,
    method: "textDocument/completion",
    params: map{ textDocument: map{ uri: doc_uri }, position: map{ line: 4, character: 12 } }
});
check(len(comp_unit["result"]["items"]) >= 20 and comp_unit["result"]["items"][0]["label"] == "m", "LSP completion inside num[...] offers SI & Currency units");

let def_r = LSP.handle_lsp_message(lsp_st, map{
    jsonrpc: "2.0",
    id: 5,
    method: "textDocument/definition",
    params: map{ textDocument: map{ uri: doc_uri }, position: map{ line: 6, character: 15 } }
});
check(def_r["result"]["uri"] == doc_uri and def_r["result"]["range"]["start"]["line"] == 4, "LSP go-to-definition resolves m to line 4");

let dsym_r = LSP.handle_lsp_message(lsp_st, map{
    jsonrpc: "2.0",
    id: 6,
    method: "textDocument/documentSymbol",
    params: map{ textDocument: map{ uri: doc_uri } }
});
check(len(dsym_r["result"]) >= 4, "LSP documentSymbol returns top-level function and variable symbols");

let ca_r = LSP.handle_lsp_message(lsp_st, map{
    jsonrpc: "2.0",
    id: 7,
    method: "textDocument/codeAction",
    params: map{
        textDocument: map{ uri: doc_uri },
        range: map{ start: map{ line: 7, character: 14 }, end: map{ line: 7, character: 23 } },
        context: map{ diagnostics: pub_diag["params"]["diagnostics"] }
    }
});
check(len(ca_r["result"]) >= 1 and ca_r["result"][0]["title"] == "Replace with 'str'", "LSP codeAction offers quick-fix replacement 'str' for 'to_string'");

let fmt_r = LSP.handle_lsp_message(lsp_st, map{
    jsonrpc: "2.0",
    id: 8,
    method: "textDocument/formatting",
    params: map{ textDocument: map{ uri: doc_uri }, options: map{ tabSize: 4, insertSpaces: true } }
});
check(len(fmt_r["result"]) == 1 and str_contains(fmt_r["result"][0]["newText"], "-> num[EUR]") and str_contains(fmt_r["result"][0]["newText"], "    return net * (1 + rate);"), "LSP formatting indents body and preserves -> num[EUR]");

// Wire framing with multi-byte Greek/math UTF-8
let frame1 = LSP.encode_lsp_frame(hov_ke);
let frame2 = LSP.encode_lsp_frame(hov_fn);
let decoded = LSP.decode_lsp_frames(frame1 + frame2);
check(len(decoded["messages"]) == 2 and decoded["messages"][0]["id"] == 2 and decoded["messages"][1]["id"] == 3 and decoded["remainder_str"] == "", "UTF-8 Content-Length LSP framing roundtrips multi-byte Unicode symbols cleanly");

let sd_r = LSP.handle_lsp_message(lsp_st, map{ jsonrpc: "2.0", id: 9, method: "shutdown", params: map{} });
check(sd_r["id"] == 9 and lsp_st["shutdown_requested"] == true, "LSP shutdown acknowledged");
LSP.handle_lsp_message(lsp_st, map{ jsonrpc: "2.0", method: "exit", params: map{} });
check(lsp_st["exited"] == true and lsp_st["exit_code"] == 0, "LSP exit sets exit_code=0 after shutdown");
println("  [PASS] 5. LSP 3.17 (initialize -> didOpen -> publishDiagnostics -> hover -> completion -> definition -> documentSymbol -> codeAction -> formatting -> wire framing -> shutdown)");

// ── 6. Stateful Interactive REPL (`stdlib/repl_interactive.sapp`) ─────────────
let repl = REPL.create_repl_session();
let rl1 = REPL.eval_repl_line(repl, "let v: num[m/s] = 15.0;");
check(rl1["ok"] and rl1["value"] == 15, "REPL binds v: num[m/s] = 15.0");
let rl2 = REPL.eval_repl_line(repl, "let t: num[s] = 4.0;");
check(rl2["ok"] and rl2["value"] == 4, "REPL binds t: num[s] = 4.0");
let rl3 = REPL.eval_repl_line(repl, "let d = v * t;");
check(rl3["ok"] and rl3["value"] == 60 and str_contains(rl3["formatted"], "num[m]"), "REPL evaluates d = 60 and infers persistent unit num[m]");

let rl_fn = REPL.eval_repl_line(repl, "fn fact(n) { if n <= 1 { return 1; } return n * fact(n - 1); }");
check(rl_fn["ok"], "REPL defines recursive function fact(n)");
let rl_f5 = REPL.eval_repl_line(repl, "fact(5) + d");
check(rl_f5["ok"] and rl_f5["value"] == 180, "REPL preserves functions and variables across lines (fact(5) + d == 180)");

let rl_bad_si = REPL.eval_repl_line(repl, "v + d");
check(not rl_bad_si["ok"] and str_contains(rl_bad_si["formatted"], "DIMENSIONAL_MISMATCH"), "REPL blocks v + d dimensional mismatch");

let rl_type = REPL.eval_repl_line(repl, ":type d");
check(rl_type["ok"] and rl_type["formatted"] == "num[m]", "REPL :type d -> num[m]");

let rl_si = REPL.eval_repl_line(repl, ":si d / t");
check(rl_si["ok"] and str_contains(rl_si["formatted"], "num[m/s]") and str_contains(rl_si["formatted"], "[L·T⁻¹]"), "REPL :si d / t -> num[m/s] [L·T⁻¹]");

let rl_vars = REPL.eval_repl_line(repl, ":vars");
check(rl_vars["ok"] and str_contains(rl_vars["formatted"], "d: num[m] = 60") and str_contains(rl_vars["formatted"], "fact = <fn fact>"), "REPL :vars displays all bound values, functions, and SI units");

let rl_prv_ok = REPL.eval_repl_line(repl, ":prove forall x, y: x^2 + y^2 >= 2*x*y");
check(rl_prv_ok["ok"] and rl_prv_ok["proof"]["proved"] == true, "REPL :prove proves AM-GM inequality via Tarski CAD");

let rl_prv_bad = REPL.eval_repl_line(repl, ":prove forall x: x^2 >= x");
check(rl_prv_bad["ok"] and rl_prv_bad["proof"]["proved"] == false and rl_prv_bad["proof"]["witness_summary"] != "", "REPL :prove refutes false inequality with counterexample");

let rl_chk = REPL.eval_repl_line(repl, ":check let bad_e = sin(t);");
check(not rl_chk["ok"] and str_contains(rl_chk["formatted"], "TRANSCENDENTAL_NON_DIMENSIONLESS"), "REPL :check runs 4-pass checker against session bindings");

let rl_help = REPL.eval_repl_line(repl, ":help");
check(rl_help["ok"] and str_contains(rl_help["formatted"], ":prove"), "REPL :help lists meta-commands");

REPL.eval_repl_line(repl, ":reset");
check(REPL.eval_repl_line(repl, ":vars")["formatted"] == "(no bindings)", "REPL :reset clears session bindings");
check(REPL.eval_repl_line(repl, ":quit")["quit"] == true, "REPL :quit closes session");
println("  [PASS] 6. Interactive REPL (stateful SI bindings, recursion, :type, :si, :prove, :vars, :check, :reset, :quit)");

// ── 7. Time-Travel Debugger & Dark-Mode SVG Flamegraph (`stdlib/profiler_debugger.sapp`) ─
let dbg_src = "let acc = 1;\nlet trace = [10];\nacc = acc + 4;\npush(trace, 20);\nacc = acc * 3;\n";
let dbg = PD.create_debugger(dbg_src);

check(not map_has(dbg.inspect_locals(), "acc"), "Debugger starts at pre-execution cursor 0");
dbg.set_breakpoint(4);
let bp_hit = dbg.continue_run();
check(bp_hit["paused_at_breakpoint"] == true and bp_hit["line"] == 4, "continue_run pauses at breakpoint line 4");
check(dbg.inspect_locals()["acc"] == 5 and len(dbg.inspect_locals()["trace"]) == 1, "At line 4 before push, acc == 5 and trace == [10]");

dbg.step_forward(); // executes push(trace, 20)
check(len(dbg.inspect_locals()["trace"]) == 2 and dbg.inspect_locals()["trace"][1] == 20, "step_forward executes push(trace, 20)");

let end_st = dbg.step_forward(); // executes acc = acc * 3
check(end_st["finished"] == true and dbg.inspect_locals()["acc"] == 15, "step_forward reaches final state acc == 15");

let back1 = dbg.step_backward();
check(back1["finished"] == false and dbg.inspect_locals()["acc"] == 5 and len(dbg.inspect_locals()["trace"]) == 2, "First step_backward restores acc == 5 while trace == [10, 20]");

let back2 = dbg.step_backward();
check(dbg.inspect_locals()["acc"] == 5 and len(dbg.inspect_locals()["trace"]) == 1, "Second step_backward restores mutated array trace == [10]");

let back3 = dbg.step_backward();
check(dbg.inspect_locals()["acc"] == 1, "Third step_backward restores initial acc == 1");

dbg.step_forward();
check(dbg.inspect_locals()["acc"] == 5, "Re-stepping forward deterministically reproduces acc == 5");

let prof_code = "
fn inner_work(x) {
    return x * x + 1;
}
fn outer_pipeline(n) {
    let total = 0;
    let i = 0;
    while i < n {
        total = total + inner_work(i);
        i = i + 1;
    }
    return total;
}
let out = outer_pipeline(8);
";
let prof_rep = PD.profile_source(prof_code);
check(prof_rep["ok"] and len(prof_rep["entries"]) >= 3, "profile_source captures main, outer_pipeline, and inner_work stacks");

let svg_fg = PD.render_flamegraph_svg(prof_rep["entries"], "CPU Profile <SI & CAD>");
check(str_starts_with(svg_fg, "<svg") and str_ends_with(str_trim(svg_fg), "</svg>"), "render_flamegraph_svg produces complete <svg>...</svg> document");
check(str_contains(svg_fg, "#0b1020") and str_contains(svg_fg, "outer_pipeline") and str_contains(svg_fg, "inner_work"), "Flamegraph SVG uses dark-mode background and renders call-stack frames");
check(str_contains(svg_fg, "&lt;SI &amp; CAD&gt;"), "Flamegraph SVG strictly escapes XML special characters");
println("  [PASS] 7. Time-Travel Debugger (breakpoints + deep-cloned forward/backward state rewind) & SVG Flamegraph");

// ── 8. Markdown Docgen, Formatter & VS Code v3.0.0 Extension (`stdlib/docgen_cli.sapp` & `editors/vscode/`) ─
let doc_input = "//! Sovereign Financial & Physics Module\n\n/// Applies proved VAT rate to EUR net amount.\nfn apply_vat(net: num[EUR], rate: num = 0.24) -> num[EUR] requires net >= 0 and rate >= 0 and rate <= 1 ensures result >= net {\nreturn net*(1+rate);\n}\n\n/// Standard gravity.\nconst GRAVITY: num[m/s^2] = 9.80665;\nexport apply_vat, GRAVITY;\n";
let md_out = DG.generate_markdown_docs(doc_input, map{ title: "Sovereign Billing Docs" });
check(str_contains(md_out, "# Sovereign Billing Docs"), "Docgen renders Markdown title");
check(str_contains(md_out, "fn apply_vat(net: num[EUR], rate: num = 0.24) -> num[EUR]"), "Docgen extracts full SI-typed signature");
check(str_contains(md_out, "✓ PROVED_MATHEMATICALLY") and str_contains(md_out, "CAD"), "Docgen embeds live Tarski CAD proof badge");
check(str_contains(md_out, "[L·T⁻²]") and str_contains(md_out, "Standard gravity."), "Docgen renders 9D SI dimension table and constant doc comment");

let fmt_once = DG.format_source(doc_input);
let fmt_twice = DG.format_source(fmt_once);
check(fmt_once == fmt_twice, "DG.format_source is idempotent");
check(str_contains(fmt_once, "-> num[EUR]") and str_contains(fmt_once, "num[m/s^2]"), "DG.format_source preserves -> and compact SI unit brackets");

let vsc_pkg = json_parse(fs_read("editors/vscode/package.json"));
check(vsc_pkg["version"] == "3.0.0", "VS Code extension package.json bumped to 3.0.0");
check(map_has(vsc_pkg["contributes"]["configuration"]["properties"], "pblang.verifyContracts"), "VS Code package.json contributes pblang.verifyContracts setting");

let vsc_ext = fs_read("editors/vscode/src/extension.ts");
check(str_contains(vsc_ext, "provideHover") and str_contains(vsc_ext, "provideCodeActions") and str_contains(vsc_ext, "provideDocumentFormattingEdits"), "VS Code extension.ts wires hover, codeAction, and formatting LSP middleware");
println("  [PASS] 8. Markdown Docgen, Idempotent v3.0 Formatter & VS Code 3.0.0 Extension");

println("=== ALL PBLANG v3.0.0 STATIC, 9D SI/EUR, CAD/PRESBURGER CONTRACTS, LSP, REPL, DEBUGGER & DOCGEN TESTS PASSED (" + str(assertions_passed) + " assertions) ===");
