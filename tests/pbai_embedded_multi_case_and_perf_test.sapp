// ──────────────────────────────────────────────────────────────────────────────
// CATEGORY 15: CUSTOM CODEBASE FLOW ANALYZER, ZERO-PROMPT AUTO-HEALER & SURGICAL CODE/UI/DB EDITOR (10 Cases)
// ──────────────────────────────────────────────────────────────────────────────

let sample_custom_app = "// FILE: pelates_db.sapp\n"
    + "function fetch_pelates_from_db(rows) {\n"
    + "    var q = \"SELECT * FROM pelates_2026 WHERE active = 1\";\n"
    + "    var i = 0;\n"
    + "    while i <= len(rows) { i = i + 1; }\n"
    + "    return map{ table: \"pelates_2026\", query: q, count: i };\n"
    + "}\n\n"
    + "// FILE: timologisi_ui.sapp\n"
    + "function old_legacy_tax_calc(a, b) {\n"
    + "    return a / b;\n"
    + "}\n\n"
    + "function render_timologisi_screen(state) {\n"
    + "    let db_info = fetch_pelates_from_db([]);\n"
    + "    return map{\n"
    + "        theme: \"legacy_gray\",\n"
    + "        widgets: [\n"
    + "            map{ id: \"panel_customer_card\", visible: true },\n"
    + "            map{ id: \"btn_save_invoice\", label: \"Save\" },\n"
    + "            map{ id: \"btn_danger_delete\", label: \"Delete All\" }\n"
    + "        ],\n"
    + "        db_linked: db_info.table\n"
    + "    };\n"
    + "}\n";

// 15.1 Zero-Prompt Autonomous Scan, Flow Recognition & Auto-Fix (Embedded `pblang ai` — prompt == "")
let c15_1 = run_case("15.1_zero_prompt_custom_app_flow_and_autofix_en", map{
    prompt: "",
    code: sample_custom_app,
    edition: "embedded_pblang", persist_turn: false
}, "code_refactoring_and_idiom_repair", "fn fetch_pelates_from_db");
assert(str_contains(c15_1.res.generated_pblang_code, "< len(rows)"));
assert(str_contains(c15_1.res.generated_pblang_code, "if b == 0 { return nil; }"));
assert(len(c15_1.res.custom_app_analysis.custom_db_tables) >= 1);
assert(c15_1.res.custom_app_analysis.custom_db_tables[0] == "pelates_2026");

// 15.2 Zero-Prompt Autonomous Scan & Auto-Fix in Greek Standalone Mode (`prompt == ""`)
let sample_greek_app = "// Εφαρμογή Αποθήκης & Παραγγελιών Πελατών\n"
    + "function fortosi_paraggelion(lista) {\n"
    + "    var sql = \"SELECT * FROM paraggelies_apothikis\";\n"
    + "    return map{ db_table: \"paraggelies_apothikis\", ok: true };\n"
    + "}\n"
    + "function emfanisi_kentrikou_ui() {\n"
    + "    let d = fortosi_paraggelion([]);\n"
    + "    return map{ theme: \"classic_blue\", button: \"btn_ektyposi_deltiou\", panel: \"panel_apothiki\" };\n"
    + "}\n";
let c15_2 = run_case("15.2_zero_prompt_custom_app_flow_and_autofix_el", map{
    prompt: "",
    code: sample_greek_app,
    edition: "standalone_pbai", persist_turn: false
}, "code_refactoring_and_idiom_repair", "fn fortosi_paraggelion");
assert(c15_2.res.active_response_language == "el");
assert(str_contains(c15_2.res.natural_answer, "paraggelies_apothikis"));

// 15.3 Surgical Function Removal (English — remove `old_legacy_tax_calc`)
let c15_3 = run_case("15.3_surgical_remove_custom_function_en", map{
    prompt: "Remove function old_legacy_tax_calc from my application",
    code: sample_custom_app,
    edition: "embedded_pblang", persist_turn: false
}, "code_refactoring_and_idiom_repair", "fn render_timologisi_screen");
assert(not str_contains(c15_3.res.generated_pblang_code, "fn old_legacy_tax_calc"));
