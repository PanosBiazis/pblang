    file_path: "../unsafe_outside.sapp"
});
assert(bad_insp.ok == false and bad_insp.error == "blocked_unsafe_path_traversal");
let tmp_custom_file = "checkpoints/_test_custom_user_app.sapp";
try fs_mkdirs("checkpoints") catch nil;
try fs_write(tmp_custom_file, sample_custom_app) catch nil;
let live_edit = Engine.inspect_and_transform_custom_pblang_app(map{
    file_path: tmp_custom_file,
    remove_target: "old_legacy_tax_calc",
    prompt: "Also remove btn_danger_delete and change UI theme to sapphire_dark",
    in_place: true,
    verify_live_run: true
});
assert(live_edit.ok == true and live_edit.live_execution_verified == true and live_edit.live_test_verified == true);
let disk_after = try fs_read(tmp_custom_file) catch "";
assert(not str_contains(disk_after, "fn old_legacy_tax_calc"));
assert(not str_contains(disk_after, "btn_danger_delete"));
assert(str_contains(disk_after, "sapphire_dark"));
try fs_remove(tmp_custom_file) catch nil;
passed_cases = passed_cases + 1;

