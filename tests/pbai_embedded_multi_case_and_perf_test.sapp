    prompt: "Audit and fix all functions in this multi-function file",
    code: "// FILE: math_ops.sapp\nfunction sum_all(arr) { let s = 0; return null; }\nfunction mul_all(arr) { let prod = 0; return prod; }\nfunction div_vals(a, b) { return a / b; }",
    edition: "embedded_pblang", persist_turn: false
}, "code_refactoring_and_idiom_repair", "export sum_all, mul_all, div_vals;");

