    prompt: "Explain how thermodynamic free-energy minimization and Shannon channel capacity govern adaptive systems",
    edition: "embedded_pblang", persist_turn: false
}, "open_world_epistemic_and_pblang_synthesis", "fn simulate_open_world_trajectory");
assert(str_contains(c7_14.res.natural_answer, "3) Deep Architectural & Mathematical Formalism"));
assert(str_contains(c7_14.res.natural_answer, "4) Native Pure-PBLang Realization"));

// ============================================================================
// CATEGORY 8: UNIVERSAL ANALYTICAL SOLVERS, COMPILER ENCYCLOPEDIA & EPISODIC MEMORY (12 Subcases)
// ============================================================================

// 8.1 Quantitative Percentage & Ratio Solver (English)
let c8_1 = run_case("8.1_percentage_and_ratio_solver", map{
    prompt: "What is 15% of 240?",
    edition: "embedded_pblang", persist_turn: false
}, "quantitative_percentage_and_ratio_solver", "fn solve_percentage_query");
assert(str_contains(c8_1.res.natural_answer, "36"));
assert(c8_1.res.analytical_verification_dossier.formally_verified == true);

// 8.2 Linear Equation Step-by-Step Solver (ax + b = c)
let c8_2 = run_case("8.2_linear_equation_step_by_step", map{
    prompt: "Solve the linear equation 3x + 7 = 22 for x",
    edition: "embedded_pblang", persist_turn: false
}, "linear_equation_step_by_step_solver", "fn solve_linear_equation");
assert(str_contains(c8_2.res.natural_answer, "x = 5"));

// 8.3 Quadratic Equation & Vieta Root Solver (ax^2 + bx + c = 0)
let c8_3 = run_case("8.3_quadratic_vieta_solver", map{
    prompt: "Find the quadratic roots of 1x^2 - 5x + 6 = 0",
    edition: "embedded_pblang", persist_turn: false
}, "quadratic_roots_and_vieta_solver", "fn solve_quadratic_roots");
assert(str_contains(c8_3.res.natural_answer, "r1 = 2") and str_contains(c8_3.res.natural_answer, "r2 = 3"));

// 8.4 Physics Temperature Scale Converter (Celsius -> Fahrenheit & Kelvin)
let c8_4 = run_case("8.4_temperature_converter", map{
    prompt: "Convert 100 Celsius to Fahrenheit and Kelvin",
    edition: "embedded_pblang", persist_turn: false
}, "physics_kinematics_and_unit_converter", "fn convert_temperature_scales");
assert(str_contains(c8_4.res.natural_answer, "212") and str_contains(c8_4.res.natural_answer, "373.15"));

// 8.5 Physics Kinematics Velocity & Unit Converter (km/h & m/s)
let c8_5 = run_case("8.5_kinematic_speed_solver", map{
    prompt: "A car travels 150 km in 2 hours. What is its velocity in km/h and m/s?",
    edition: "embedded_pblang", persist_turn: false
}, "physics_kinematics_and_unit_converter", "fn compute_kinematic_velocity");
assert(str_contains(c8_5.res.natural_answer, "75 km/h") and str_contains(c8_5.res.natural_answer, "20.83 m/s"));

// 8.6 Bayesian Posterior Inference & Combinatorics (nCr)
let c8_6 = run_case("8.6_bayesian_and_combinatorics", map{
    prompt: "Explain Bayes theorem posterior probability and nCr combinations",
    edition: "embedded_pblang", persist_turn: false
}, "bayesian_and_combinatorial_inference_solver", "fn bayesian_posterior_pct");
assert(str_contains(c8_6.res.generated_pblang_code, "fn combinations_ncr"));

// 8.7 PBLang Compiler & Language Semantics Encyclopedia
let c8_7 = run_case("8.7_pblang_compiler_encyclopedia", map{
    prompt: "How does PBLang handle closures, map vs array, elif, and undefined global errors?",
    edition: "embedded_pblang", persist_turn: false
}, "pblang_compiler_and_language_encyclopedia", "fn make_multiplier_closure");
assert(str_contains(c8_7.res.generated_pblang_code, "fn verify_pblang_language_semantics"));

// 8.8 Distributed Consensus (Raft/Paxos CFT & BFT) & Vector Clocks
let c8_8 = run_case("8.8_distributed_consensus_raft", map{
    prompt: "How do Raft consensus quorum and vector clock causal ordering work?",
    edition: "embedded_pblang", persist_turn: false
}, "distributed_consensus_and_vector_clocks", "fn evaluate_consensus_quorum");
assert(str_contains(c8_8.res.generated_pblang_code, "fn vector_clock_happens_before"));

// 8.9 Control Systems: Discrete PID Controller & 1D Kalman Filter
let c8_9 = run_case("8.9_control_pid_and_kalman", map{
    prompt: "Implement a discrete PID controller and 1D Kalman filter sensor fusion in PBLang",
    edition: "embedded_pblang", persist_turn: false
}, "control_pid_and_kalman_filter", "fn pid_control_step");
assert(str_contains(c8_9.res.generated_pblang_code, "fn kalman_1d_update"));

// 8.10 Standalone Polyglot Greek Quantitative Percentage Solver
let c8_10 = run_case("8.10_standalone_greek_percentage", map{
    prompt: "Πόσο είναι το 20% του 350;",
    edition: "standalone_polyglot", persist_turn: false
}, "quantitative_percentage_and_ratio_solver", "fn solve_percentage_query");
assert(str_contains(c8_10.res.natural_answer, "70"));
assert(c8_10.res.active_response_language == "el");

// 8.11 Embedded English Episodic Q&A Memory Recall & Lesson Verification
let c8_11 = run_case("8.11_embedded_episodic_memory_recall", map{
    prompt: "Do you remember my previous questions and answers in memory?",
    edition: "embedded_pblang", persist_turn: false
}, "episodic_qa_memory_and_lesson_recall", "fn inspect_episodic_qa_memory");
assert(c8_11.res.episodic_memory_recall.stored_turns_count >= 1);
assert(str_contains(c8_11.res.natural_answer, "[ANALYTICAL RECALL OF PREVIOUS Q&A]"));

// 8.12 Standalone Greek Episodic Q&A Memory Recall & Repeat Question Recognition
let c8_12 = run_case("8.12_standalone_greek_episodic_memory_recall", map{
    prompt: "Θυμάσαι τις προηγούμενες ερωτήσεις και απαντήσεις μας στη μνήμη;",
    edition: "standalone_polyglot", persist_turn: false
}, "episodic_qa_memory_and_lesson_recall", "fn inspect_episodic_qa_memory");
assert(c8_12.res.active_response_language == "el");
assert(str_contains(c8_12.res.natural_answer, "[ΑΝΑΛΥΤΙΚΗ ΑΝΑΚΛΗΣΗ ΠΡΟΗΓΟΥΜΕΝΩΝ ΑΠΑΝΤΗΣΕΩΝ]"));

let total_suite_ms = now_ms() - t_suite0;
assert(passed_cases == total_cases and total_cases == 80);

print json_stringify(map{
    test_suite: "pbai_embedded_multi_case_and_perf_test",
    status: "PASS",
    cases_passed: passed_cases,
    cases_total: total_cases,
    import_latency_ms: import_latency_ms,
    total_80_cases_elapsed_ms: total_suite_ms,
    avg_latency_per_case_ms: num_floor((total_suite_ms / total_cases) * 100.0) / 100.0,
    full_status_call_ms: dt_st
});
