// 12.4 Direct Engine Execution: Multi-Format Folder (JXL, AVIF, WebP, PNG, RAW, WAV, MP3, MP4, 7z, RAR, ZIP, LOG, SAPP)
let MatEngine = import("../tools/pbmatryoshka_origami_engine.sapp");
total_cases = total_cases + 1;
let pkg_all = MatEngine.fold_matryoshka_package(map{
    package_name: "omni_formats_bundle.pbmo",
    max_shells: 4,
    password_protected: false,
    hidden_in_view: false,
    files: [
        map{ path: "img/photo.jxl", content: "JXL_XYB_ANS_STREAM_11111111111111111111111111111111" },
        map{ path: "img/hdr.avif", content: "AVIF_OBU_CDEF_STREAM_222222222222222222222222222222" },
        map{ path: "img/sprite.webp", content: "WEBP_VP8L_PRED_STREAM_33333333333333333333333333333" },
        map{ path: "img/icon.png", content: "PNG_PAETH_IDAT_STREAM_44444444444444444444444444444" },
        map{ path: "cam/sensor.raw", content: "BAYER_RGGB_16BIT_STREAM_55555555555555555555555555" },
        map{ path: "audio/track.wav", content: "RIFF_WAV_PCM24_MID_SIDE_66666666666666666666666666" },
        map{ path: "audio/voice.mp3", content: "MP3_MDCT_HUFFMAN_SIDEINFO_7777777777777777777777777" },
        map{ path: "video/clip.mp4", content: "ISOBMFF_MOOV_MDAT_NAL_88888888888888888888888888888" },
        map{ path: "arch/pack.7z", content: "7Z_LZMA2_BCJ2_SOLID_9999999999999999999999999999999" },
        map{ path: "arch/legacy.rar", content: "RAR5_PPMD_FILTER_0000000000000000000000000000000000" },
        map{ path: "arch/bundle.zip", content: "PKZIP_DEFLATE64_CENTRAL_DIR_AAAAAAAAAAAAAAAAAAAAAAA" },
        map{ path: "sys/audit.log", content: "2026-11-01T16:30:00Z INFO Matryoshka fold OK OK OK OK" },
        map{ path: "src/kernel.sapp", content: "fn main() { return 42; } // Pure PBLang AST source" }
    ]
});
let unfolded_all = MatEngine.unfold_matryoshka_package(pkg_all);
assert(pkg_all.ok == true and pkg_all.lossless_bit_exact == true);
assert(pkg_all.file_count == 13 and len(pkg_all.o1_jump_pointer_index) == 13);
assert(pkg_all.compression_ratio_x > 1.0);
assert(unfolded_all.ok == true and unfolded_all.lossless_verified_files == 13);
passed_cases = passed_cases + 1;

// 12.5 Direct Engine Execution: Password-Protected & Hidden-in-View Zero-Knowledge Blind Safety Audit
total_cases = total_cases + 1;
let pkg_secret = MatEngine.fold_matryoshka_package(map{
    package_name: "classified_vault.pbmo",
    max_shells: 4,
    password_protected: true,
    hidden_in_view: true,
    files: [
        map{ path: "vault/keys.7z", content: "TOP_SECRET_QUANTUM_KEYS_1234567890_1234567890", hidden: true },
        map{ path: "vault/scan.jxl", content: "CLASSIFIED_BIOMETRIC_JXL_9876543210_9876543210", hidden: true }
    ]
});
let blind_view = MatEngine.inspect_and_safe_view_matryoshka(pkg_secret, map{
    reveal_hidden: false,
    password_provided: false
});
let bench_all = MatEngine.benchmark_matryoshka_vs_world();
assert(blind_view.ok == true and blind_view.safe == true);
assert(blind_view.security_verdict == "SAFE_VERIFIED_ZERO_VULNERABILITIES");
assert(blind_view.password_protected == true and blind_view.hidden_in_view == true);
assert(blind_view.entries[0].path_display == "[REDACTED · HIDDEN/ENCRYPTED IN VIEW]");
assert(blind_view.entries[0].entry_safe_verified == true);
assert(bench_all.ok == true and bench_all.brain_density_amplification.effective_density_multiplier == 14.8);
passed_cases = passed_cases + 1;

