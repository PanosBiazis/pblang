// 15.4 Surgical Function Removal (Greek — "Αφαίρεσε τη συνάρτηση old_legacy_tax_calc")
let c15_4 = run_case("15.4_surgical_remove_custom_function_el", map{
    prompt: "Αφαίρεσε τη συνάρτηση old_legacy_tax_calc από τον κώδικα",
