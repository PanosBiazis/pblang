// tests/auto_tls_gateway_test.sapp
// Verification for 100% PBLang Caddy/Nginx Gateway & Automatic TLS Certificate Renewal

let AutoTLS = import("../stdlib/auto_tls_gateway.sapp");

let checks = map{ count: 0 };
fn check(cond, msg) {
    assert(cond, msg);
    checks.count = checks.count + 1;
}

// 1. Missing certificate triggers initial ACME issuance
let r_init = AutoTLS.evaluate_cert_renewal(nil, 500000, 720);
check(r_init.needs_renewal and r_init.action == "INITIAL_ACME_ISSUANCE", "missing cert triggers initial issuance");

// 2. Fresh 90-day (2160h) certificate does NOT need renewal at +100h
let cert = AutoTLS.rotate_certificate_state("sovereign.pblang.local", 500000, 2160);
check(cert.ok and cert.validity_days == 90 and cert.auto_renew_enabled, "90-day certificate issued");
let r_healthy = AutoTLS.evaluate_cert_renewal(cert, 500100, 720);
check(r_healthy.ok and not r_healthy.needs_renewal and r_healthy.reason == "CERTIFICATE_HEALTHY", "healthy cert kept active");

// 3. Within 30-day (720h) window triggers automatic zero-downtime renewal
let r_window = AutoTLS.evaluate_cert_renewal(cert, 501500, 720);
check(r_window.ok and r_window.needs_renewal and r_window.reason == "WITHIN_AUTO_RENEWAL_WINDOW_30D", "30-day window triggers auto-renewal");

// 4. Revoked certificate triggers immediate reissuance
cert.revoked = true;
let r_rev = AutoTLS.evaluate_cert_renewal(cert, 500100, 720);
check(r_rev.needs_renewal and r_rev.reason == "CERTIFICATE_REVOKED", "revoked cert triggers immediate reissuance");

// 5. ACME HTTP-01 challenge responder & Base64URL sanitization
let acme_ok = AutoTLS.compute_acme_key_authorization("validToken_123-ABC", "THUMB123");
check(acme_ok.ok and acme_ok.http01_response_body == "validToken_123-ABC.THUMB123", "valid ACME HTTP-01 key authorization");
check(not AutoTLS.compute_acme_key_authorization("../etc/passwd", "THUMB123").ok, "path traversal token rejected in ACME challenge");

// 6. Native Caddy/Nginx path-prefix routing & handle_path stripping
let routes = [
    map{ prefix: "/v1/telemetry", type: "reverse_proxy", upstream: "127.0.0.1:5181" },
    map{ prefix: "/v1/connector-sync", type: "reverse_proxy", upstream: "127.0.0.1:5182" },
    map{ prefix: "/demo", type: "static_files", static_root: "/srv/www/presentation-demo" }
];
let m_acme = AutoTLS.match_gateway_route("/.well-known/acme-challenge/tok99", routes);
check(m_acme.matched and m_acme.route_type == "acme_http01_challenge", "ACME challenge intercepted automatically");

let m_tel = AutoTLS.match_gateway_route("/v1/telemetry/heartbeat?x=1", routes);
check(m_tel.matched and m_tel.upstream == "127.0.0.1:5181" and m_tel.rewritten_path == "/heartbeat", "telemetry route matched and stripped");

let m_sync = AutoTLS.match_gateway_route("/v1/connector-sync/status", routes);
check(m_sync.matched and m_sync.upstream == "127.0.0.1:5182" and m_sync.rewritten_path == "/status", "connector-sync route matched to upstream node");

let tmp_cert = "/tmp/pblang_auto_tls_test_cert.json";
try fs_remove(tmp_cert) catch nil;
let maint1 = AutoTLS.auto_maintain_certificate(tmp_cert, "auth.pblang.local", 500000, 720);
check(maint1.ok and maint1.renewed, "auto_maintain_certificate issues initial cert");
let maint2 = AutoTLS.auto_maintain_certificate(tmp_cert, "auth.pblang.local", 500100, 720);
check(maint2.ok and not maint2.renewed, "auto_maintain_certificate reuses healthy cert");
let maint3 = AutoTLS.auto_maintain_certificate(tmp_cert, "auth.pblang.local", 501600, 720);
check(maint3.ok and maint3.renewed, "auto_maintain_certificate auto-renews when entering 30d window");
try fs_remove(tmp_cert) catch nil;

let redir = AutoTLS.build_https_redirect_response("gateway.example.com", "/demo/index.html");
check(redir.status == 301 and redir.headers["Location"] == "https://gateway.example.com/demo/index.html", "HTTP to HTTPS 301 redirect constructed");
check(str_contains(redir.headers["Strict-Transport-Security"], "max-age=63072000") and redir.headers["Cross-Origin-Opener-Policy"] == "same-origin", "A+ security headers present on gateway");

let Http = import("../stdlib/http_server.sapp");
let wire = Http.to_http_response(map{ status: 200, content_type: "text/html; charset=utf-8", body: "<main>ok</main>" });
check(str_contains(wire, "Content-Security-Policy:") and str_contains(wire, "Strict-Transport-Security:") and str_contains(wire, "X-Content-Type-Options: nosniff") and str_contains(wire, "Cross-Origin-Opener-Policy: same-origin"), "stdlib/http_server.sapp injects A+ security headers by default");

print json_stringify(map{ ok: true, checks: checks.count });
