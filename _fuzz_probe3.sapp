// Fuzz probe round 3 — structured/binary parsers. TEMP FILE, delete after use.
let F = import("stdlib:fuzz.sapp");
let SER = import("stdlib:serialization.sapp");
let MP = import("stdlib:multipart.sapp");
let WS = import("stdlib:websocket.sapp");
let SV = import("stdlib:semver.sapp");
let DUR = import("stdlib:duration.sapp");
let MON = import("stdlib:money.sapp");

// 1. toml_parse never throws (doc: lenient)
fn t_toml(s) { SER.toml_parse(s); return true; }
let toml_dict = ["[", "]", "[[", "]]", "=", "\"", "'", "#", "\n", ".", "\\", "true", "1.5"];
let r1 = F.fuzz(t_toml, map{ seed: 201, runs: 500, max_len: 32, dict: toml_dict });
print "1 toml_parse crashes=" + str(r1["crash_count"]) + " shrunk=" + str(r1["shrunk"]);

// 2. yaml_parse never throws
fn t_yaml(s) { SER.yaml_parse(s); return true; }
let yaml_dict = [":", "-", "#", "\n", "  ", "\"", "'", "|", ">", "&", "*", "- x", ": y"];
let r2 = F.fuzz(t_yaml, map{ seed: 202, runs: 500, max_len: 32, dict: yaml_dict });
print "2 yaml_parse crashes=" + str(r2["crash_count"]) + " shrunk=" + str(r2["shrunk"]);

// 3. toml value round trip: stringify {K:s} then parse back
fn tenc(s) { return SER.toml_stringify(map{ K: s }); }
fn tdec(text) { return SER.toml_parse(text)["K"]; }
let r3 = F.round_trip(tenc, tdec, map{ seed: 203, runs: 400, max_len: 16, dict: ["\"", "'", "\\", "\n", "#", "=", "[", "]"] });
print "3 toml rt ok=" + str(r3["ok"]) + " shrunk=" + str(r3["shrunk"]);

// 4. yaml value round trip
fn yenc(s) { return SER.yaml_stringify(map{ K: s }); }
fn ydec(text) { return SER.yaml_parse(text)["K"]; }
let r4 = F.round_trip(yenc, ydec, map{ seed: 204, runs: 400, max_len: 16, dict: ["\"", "'", ":", "-", "#", "\n", "|", "&"] });
print "4 yaml rt ok=" + str(r4["ok"]) + " shrunk=" + str(r4["shrunk"]);

// 5. multipart.parse never throws (untrusted HTTP body)
fn t_mp(s) { MP.parse(s, "B"); return true; }
let mp_dict = ["--B", "--B--", "\r\n", "\r\n\r\n", "Content-Disposition: form-data; name=\"", "filename=\"", "\"", ";", "Content-Type: "];
let r5 = F.fuzz(t_mp, map{ seed: 205, runs: 500, max_len: 48, dict: mp_dict });
print "5 multipart crashes=" + str(r5["crash_count"]) + " shrunk=" + str(r5["shrunk"]);

// 6. websocket stream_decode + parse-all never throw on arbitrary bytes
fn t_ws(b) { WS.stream_decode(b); return true; }
let r6 = F.fuzz(t_ws, map{ seed: 206, runs: 500, max_len: 32, mode: "bytes" });
print "6 ws stream_decode crashes=" + str(r6["crash_count"]) + " shrunk=" + str(r6["shrunk"]);

// 7. semver parse + satisfies never throw
fn t_sv(s) { SV.parse(s); SV.satisfies("1.2.3", s); return true; }
let sv_dict = ["^", "~", ">=", "<=", ">", "<", "||", " - ", "*", "x", ".", "1.2.3", "-rc.1", "+b"];
let r7 = F.fuzz(t_sv, map{ seed: 207, runs: 500, max_len: 24, dict: sv_dict });
print "7 semver crashes=" + str(r7["crash_count"]) + " shrunk=" + str(r7["shrunk"]);

// 8. duration.parse never throws
fn t_dur(s) { DUR.parse(s); return true; }
let r8 = F.fuzz(t_dur, map{ seed: 208, runs: 500, max_len: 16, dict: ["ms", "s", "m", "h", "d", "w", ".", "-", " ", "1"] });
print "8 duration crashes=" + str(r8["crash_count"]) + " shrunk=" + str(r8["shrunk"]);

// 9. money.parse crash behavior (observe)
fn t_mon(s) { MON.parse(s); return true; }
let r9 = F.fuzz(t_mon, map{ seed: 209, runs: 500, max_len: 16, dict: ["$", ",", ".", "-", "0", "9", "€"] });
print "9 money crashes=" + str(r9["crash_count"]) + " shrunk=" + str(r9["shrunk"]);

print "probe3 done";
