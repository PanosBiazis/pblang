* text=auto eol=lf

# GitHub Linguist language classification — spotlight Sovereign PBLang (.sapp)
# while preserving 100% of historical/compatibility Rust crates & Stage-3 C sources.
*.sapp linguist-language=PBLang linguist-detectable=true
stdlib/**/*.sapp linguist-language=PBLang linguist-detectable=true
examples/**/*.sapp linguist-language=PBLang linguist-detectable=true
tests/**/*.sapp linguist-language=PBLang linguist-detectable=true
runtime_stage3/** linguist-language=C
crates/** linguist-vendored
Cargo.lock linguist-generated=true
docs/** linguist-documentation=true

# These Windows-native launchers require CRLF for maximum compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never apply newline conversion to generated or media artifacts.
*.apk binary
*.bin binary
*.dll binary
*.exe binary
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.pbck binary
*.pdf binary
*.png binary
*.so binary
*.wasm binary
*.zip binary
