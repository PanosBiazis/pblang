* text=auto eol=lf

# These Windows-native launchers require CRLF for maximum compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never apply newline conversion to generated or media artifacts.
*.apk binary
*.bin binary
*.dll binary
*.exe binary
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.png binary
*.so binary
*.wasm binary
*.zip binary
